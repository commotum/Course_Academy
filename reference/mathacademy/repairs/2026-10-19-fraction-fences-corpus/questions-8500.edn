/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1-\\frac{1}{{3}^{k}})+\\frac{1}{{3}^{k+1}}" :db/id #edb/ref 17592186593936} :answer-field/id #uuid "d5e53ea0-1a08-5ea6-b579-e0a5f3e0e395" :answer-field/key "field-7" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186594111} {:answer-field/choices [{:answer/id #uuid "3c7d642f-1b16-56bf-9811-858cfcb56b98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3-\\frac{2}{{3}^{k}})" :db/id #edb/ref 17592186593514} {:answer/id #uuid "780f4bd6-16f6-55c6-9aa5-54a47af71410" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1+\\frac{2}{{3}^{k+1}})" :db/id #edb/ref 17592186593660} {:answer/id #uuid "7f9709de-996e-528a-b1bf-1c5b904c543c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3+\\frac{1}{{3}^{k}})" :db/id #edb/ref 17592186593678} {:answer/id #uuid "abda9f72-a7da-5b49-af94-dda0c85e4cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1-\\frac{1}{{3}^{k+1}})" :db/id #edb/ref 17592186593792}] :answer-field/correct {:answer/id #uuid "abda9f72-a7da-5b49-af94-dda0c85e4cc8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}(1-\\frac{1}{{3}^{k+1}})" :db/id #edb/ref 17592186593792} :answer-field/id #uuid "ea636b2d-227b-5176-bec3-691a0c728302" :answer-field/key "field-8" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186594132} {:answer-field/choices [{:answer/id #uuid "36f9df97-4759-5133-8c09-4267da5ed0d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n\\ge 1" :db/id #edb/ref 17592186593503} {:answer/id #uuid "3a619600-0237-5b6f-8929-e5a26991f4a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=0" :db/id #edb/ref 17592186593509} {:answer/id #uuid "4676d615-1a3a-5385-b7bb-73db48c0e4ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n\\ge 0" :db/id #edb/ref 17592186593551} {:answer/id #uuid "64745676-c9d8-5f79-af8d-e4d64dfec544" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n=1" :db/id #edb/ref 17592186593611}] :answer-field/correct {:answer/id #uuid "36f9df97-4759-5133-8c09-4267da5ed0d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n\\ge 1" :db/id #edb/ref 17592186593503} :answer-field/id #uuid "ebcdb723-c03a-50cf-bcc9-6f9e8675afc0" :answer-field/key "field-9" :answer-field/type {:db/id #edb/ref 17592186045494 :db/ident :answer-field.type/select} :db/id #edb/ref 17592186594133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "31c21376-e36c-5785-bc6d-5e25ffc9085f" :question/math-academy-id "q-182666" :question/problem "Prove that ${\\sum }_{i=1}^{n}\\frac{1}{{3}^{i}}=\\frac{1}{2}(1-\\frac{1}{{3}^{n}})$ using mathematical induction.\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove that our statement is true for the base case $n=\\,${{field-1}}.\n\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{1}\\frac{1}{{3}^{i}} &={{field-2}}\\end{aligned}\n$$\n\nwhich equals the right-hand side. Thus, our statement is {{field-3}} for $n=1.$\n\n**Inductive Hypothesis**: We assume that for some $n=$ {{field-4}}, we have\n\n$$\n{\\sum }_{i=1}^{k}\\frac{1}{{3}^{i}}=\\frac{1}{2}\\cdot \\,{{field-5}}.\n$$\n\n**Inductive Step**: To prove $P(k+1),$ we write\n\n$$\n{\\sum }_{i=1}^{k+1}\\frac{1}{{3}^{i}}=({\\sum }_{i=1}^{k}\\frac{1}{{3}^{i}})+{{field-6}}.\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{k}\\frac{1}{{3}^{i}})+\\frac{1}{{3}^{k+1}} & ={{field-7}} \\\\  & ={{field-8}},\\end{aligned}\n$$\n\nas required.\n\nTherefore, by the principle of induction, ${\\sum }_{i=1}^{n}\\frac{1}{{3}^{i}}=\\frac{1}{2}(1-\\frac{1}{{3}^{n}})$ is true for all {{field-9}}." :question/worked-solution "The principle of induction states the following: Suppose we have a sequence of mathematical statements $P(1),P(2),P(3),…,$ where\n\n- $P(1)$ is true, and\n\n- $P(k)⇒P(k+1)$ for every $k\\in N.$\n\nThen, $P(n)$ is true for every $n\\in N.$\n\nIn this case, the general statement $P(n)$ we're required to prove is the following:\n\n$$\n{\\sum }_{i=1}^{n}\\frac{1}{{3}^{i}}=\\frac{1}{2}(1-\\frac{1}{{3}^{n}})\n$$\n\nWe start by proving the so-called base case, $P(1).$ To do this, we substitute $n=1$ into both the left-hand side and right-hand side and show that they're equal:\n\nWe proceed using induction on $n.$\n\n**Base Case**: We first prove our statement is true for the base case $n=1.$\nFor the left-hand side, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{1}\\frac{1}{{3}^{i}} &=\\frac{1}{3},\\end{aligned}\n$$\n\nand for the right-hand side,  we have\n\n$$\n\\begin{aligned}\\frac{1}{2}(1-\\frac{1}{{3}^{1}}) &=\\frac{1}{2}(\\frac{2}{3})=\\frac{1}{3}.\\end{aligned}\n$$\n\nThus, our statement is true for $n=1.$\n\nNext, we state our inductive hypothesis. Here, we assume that the given statement is true for some $n=k\\ge 1.$ \n\nDue to the base case, we already *know* that the statement is true for *some* value of $k,$ namely $k=1,$ so this assumption is valid.\n\n**Inductive Hypothesis**: We assume that for some $n=k\\ge 1,$ we have\n\n$$\n{\\sum }_{i=1}^{k}\\frac{1}{{3}^{i}}=\\frac{1}{2}(1-\\frac{1}{{3}^{k}}).\n$$\n\nWe must show that $P(k)⇒P(k+1).$ Let's start by writing down $P(k+1).$ This is the first part of the so-called **inductive step**, so let's write that, too.\n\n**Inductive Step**: We're required to prove that\n\n$$\n{\\sum }_{i=1}^{k+1}\\frac{1}{{3}^{i}}=\\frac{1}{2}(1-\\frac{1}{{3}^{k+1}}).\\,\\,(∗)\n$$\n\nThe idea is to rewrite the left-hand side of $(∗)$ *using the inductive hypothesis* and apply algebraic techniques to show that this equals the right-hand side.\n\nWhen proving sums of finite series using induction, the key to unlocking the proof is to write the last term on its own, as follows: \n\n$$\n{\\sum }_{i=1}^{k+1}{a}_{i}=({\\sum }_{i=1}^{k}{a}_{i})+{a}_{k+1}\n$$\n\nLet's apply this technique in this case:\n\nWe write\n\n$$\n{\\sum }_{i=1}^{k+1}\\frac{1}{{3}^{i}}=({\\sum }_{i=1}^{k}\\frac{1}{{3}^{i}})+\\frac{1}{{3}^{k+1}}.\n$$\n\nBy the inductive hypothesis, we have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{k}\\frac{1}{{3}^{i}})+\\frac{1}{{3}^{k+1}} & =\\frac{1}{2}(1-\\frac{1}{{3}^{k}})+\\frac{1}{{3}^{k+1}} \\\\  & =\\frac{1}{2}-\\frac{1}{2}\\cdot \\frac{1}{{3}^{k}}+\\frac{1}{{3}^{k+1}} \\\\  & =\\frac{1}{2}-\\frac{1}{{3}^{k}}(\\frac{1}{2}-\\frac{1}{3}) \\\\  & =\\frac{1}{2}-\\frac{1}{{3}^{k}}(\\frac{1}{6}) \\\\  & =\\frac{1}{2}-\\frac{1}{{3}^{k}}(\\frac{1}{2\\cdot 3}) \\\\  & =\\frac{1}{2}(1-\\frac{1}{{3}^{k+1}}),\\end{aligned}\n$$\n\nas required.\n\nSince we've shown that the left-hand side of $(∗)$ equals the right-hand side, our proof is complete. So let's write down our conclusion. \n\nTherefore, by the principle of induction, ${\\sum }_{i=1}^{n}\\frac{1}{{3}^{i}}=\\frac{1}{2}(1-\\frac{1}{{3}^{n}})$ is true for all $n\\ge 1.$"} {:db/id #edb/ref 17592186594155 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "421233ee-c5e3-544a-8479-a4ffeb0830e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-y}" :db/id #edb/ref 17592186593536} {:answer/id #uuid "5dcdf948-d921-5d2f-941a-24cb93e94df7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-y}}{2}" :db/id #edb/ref 17592186593598} {:answer/id #uuid "817b8276-9838-522a-8c14-f181a8c53c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-2x}" :db/id #edb/ref 17592186593685} {:answer/id #uuid "8a975a63-ab05-5763-8427-541b7236f61d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-2x}}{2}" :db/id #edb/ref 17592186593712} {:answer/id #uuid "f1fd7459-9620-52ab-a5d1-09d4175f500b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{e}^{-2x-y}}{2}" :db/id #edb/ref 17592186593951}] :answer-field/correct {:answer/id #uuid "817b8276-9838-522a-8c14-f181a8c53c7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{e}^{-2x}" :db/id #edb/ref 17592186593685} :answer-field/id #uuid "f7f60ca5-c9bf-5ef4-ac33-d1a0842269a9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594137}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "32e245f7-b140-5c0a-bd45-81f7042158f5" :question/math-academy-id "q-143632" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}2{e}^{-2x-y}, & \\,x\\ge 0,\\,y\\ge 0 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $x\\ge 0,\\,y\\ge 0.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\infty }2{e}^{-2x-y}\\,\\text{d}x \\\\  & =2{e}^{-y}{lim}_{b\\to \\infty }{\\int }_{0}^{b}{e}^{-2x}\\,\\text{d}x \\\\  & =2{e}^{-y}{lim}_{b\\to \\infty }(-\\frac{{e}^{-2x}}{2}){|}_{0}^{b} \\\\  & ={e}^{-y}{lim}_{b\\to \\infty }(1-{e}^{-2b}) \\\\  & ={e}^{-y}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}{e}^{-y}, & \\,y\\ge 0 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $x\\ge 0,\\,y\\ge 0,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{2{e}^{-2x-y}}{{e}^{-y}} \\\\  & =2{e}^{-2x}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}2{e}^{-2x}, & \\,x\\ge 0,\\,y\\ge 0 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594156 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7e0066-612a-5bfa-ab72-f97cf982828b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{e}^{t}" :db/id #edb/ref 17592186593416} {:answer/id #uuid "6a685156-b2fe-5532-afb8-5a71d55424dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186593624} {:answer/id #uuid "9b0f5e3e-7c91-5b1a-b93b-1e0b7ae32c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{e}^{3t}" :db/id #edb/ref 17592186593755} {:answer/id #uuid "ba3bfca6-bb64-51f5-b5cf-2c0ccc35402d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{6{e}^{t}}" :db/id #edb/ref 17592186593821} {:answer/id #uuid "dea3e19f-ac6f-5751-9048-625362adfdb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{{e}^{t}}" :db/id #edb/ref 17592186593906}] :answer-field/correct {:answer/id #uuid "0e7e0066-612a-5bfa-ab72-f97cf982828b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6{e}^{t}" :db/id #edb/ref 17592186593416} :answer-field/id #uuid "b76988e4-df44-5e63-a91a-e8186ea8b227" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594093}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3f210a40-45c1-5a4b-853b-9f7e926c1fd0" :question/math-academy-id "q-54160" :question/problem "A curve is defined by the parametric equations $x={e}^{t}-3,\\,y={e}^{3t}-{e}^{t}.$ Given that  $\\frac{dy}{dx}=3{e}^{2t}-1,$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=3{e}^{2t}-1,$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}({e}^{t}-3)={e}^{t}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(3{e}^{2t}-1)}{{e}^{t}} \\\\  & =\\frac{6{e}^{2t}}{{e}^{t}} \\\\  & =6{e}^{t}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594164 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d264558-e46c-5e25-862e-d378733b12f7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{65}{72}" :db/id #edb/ref 17592186593409} {:answer/id #uuid "6d89f0fb-6019-5d93-b25d-a61f33ad879c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{55}{64}" :db/id #edb/ref 17592186593633} {:answer/id #uuid "7d59a7d7-5b61-506a-abac-1d1301608dd1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{48}{72}" :db/id #edb/ref 17592186593675} {:answer/id #uuid "c20d28e3-c682-51b0-8361-a8a3c7b9c4ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{71}{72}" :db/id #edb/ref 17592186593846} {:answer/id #uuid "fd4feb9e-5305-50cb-9b3c-dfe22564f74e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{64}" :db/id #edb/ref 17592186593977}] :answer-field/correct {:answer/id #uuid "c20d28e3-c682-51b0-8361-a8a3c7b9c4ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{71}{72}" :db/id #edb/ref 17592186593846} :answer-field/id #uuid "d80d9b05-3b0e-5d84-82c0-e1b4164f07e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594113}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "49c1fa94-41fa-54ea-b43b-1640e0c576cc" :question/math-academy-id "q-145109" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{y}{{x}^{2}} & \\,0<x\\le 2,\\,0\\le y\\le \\sqrt{2}\\,x \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(\\frac{1}{4}<Y\\,|\\,X=\\frac{3}{2}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{Y\\,|\\,X}(y\\,|\\,x)\\,\\text{d}x,\n$$\n\nwhere ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ is the conditional probability density function of $Y$ given $X=x.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(\\frac{1}{4}<Y\\,|\\,X=\\frac{3}{2}) & ={\\int }_{1/4}^{3\\sqrt{2}/2}{f}_{Y\\,|\\,X}(y\\,|\\,x=\\frac{3}{2})\\text{d}y \\\\  & ={\\int }_{1/4}^{3\\sqrt{2}/2}\\frac{y}{{(\\frac{3}{2})}^{2}}\\,\\text{d}y \\\\  & =\\frac{4}{9}{\\int }_{1/4}^{3\\sqrt{2}/2}y\\,\\text{d}y \\\\  & =\\frac{4}{9}{[\\frac{{y}^{2}}{2}]}_{1/4}^{3\\sqrt{2}/2} \\\\  & =\\frac{2}{9}({(\\frac{3\\sqrt{2}}{2})}^{2}-{(\\frac{1}{4})}^{2}) \\\\  & =\\frac{2}{9}(\\frac{9}{2}-\\frac{1}{16}) \\\\  & =\\frac{2}{9}\\cdot \\frac{71}{16} \\\\  & =\\frac{71}{72}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594182 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "570925b3-8f8e-5cfc-be3c-d11210838de1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3x(-{x}^{2}+2)}{8}" :db/id #edb/ref 17592186593587} {:answer/id #uuid "85e50e3b-a3bf-510f-93ad-4f3b74f6e5b2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{2}+x" :db/id #edb/ref 17592186593700} {:answer/id #uuid "c1f96c07-df9e-5631-a1ab-5b08985ba963" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8x}{-{x}^{2}+x+2}" :db/id #edb/ref 17592186593845} {:answer/id #uuid "e81823df-fe9a-5209-8d9a-f0d037ea3367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{-{x}^{2}+x+2}" :db/id #edb/ref 17592186593926} {:answer/id #uuid "fc87f1c1-2bd7-5292-b412-77b27fcb26c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8(-{x}^{2}+2)}{3x}" :db/id #edb/ref 17592186593974}] :answer-field/correct {:answer/id #uuid "e81823df-fe9a-5209-8d9a-f0d037ea3367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{-{x}^{2}+x+2}" :db/id #edb/ref 17592186593926} :answer-field/id #uuid "2b48f238-da66-5ee8-a342-90bced86a287" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594014}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7e6e5bd8-8a05-549b-9cb9-4a44448da5e8" :question/math-academy-id "q-143640" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3x}{8}, & \\,0\\le x<2,\\,{x}^{2}\\le y\\le x+2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ for $0\\le x<2,\\,{x}^{2}\\le y\\le x+2.$" :question/worked-solution "Using the formula for the marginal density function for $X,$ we have \n\n$$\n\\begin{aligned}{f}_{X}(x) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}y \\\\  & ={\\int }_{{x}^{2}}^{x+2}\\frac{3x}{8}\\,\\text{d}y \\\\  & =\\frac{3x}{8}\\cdot y\\,{|}_{{x}^{2}}^{x+2} \\\\  & =\\frac{3x}{8}\\cdot (x+2-{x}^{2}) \\\\  & =\\frac{3x(-{x}^{2}+x+2)}{8}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{X}(x)$ is the following:\n\n$$\n{f}_{X}(x)=\\{\\begin{aligned}\\frac{3x(-{x}^{2}+x+2)}{8}, & \\,0\\le x<2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $Y$ given $X=x$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\frac{f(x,y)}{{f}_{X}(x)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{X}(x)$ is the marginal density function for $X.$\n\nNow, for $0\\le x<2,\\,{x}^{2}\\le y\\le x+2,$ we have \n\n$$\n\\begin{aligned}{f}_{Y\\,|\\,X}(y\\,|\\,x) & =\\frac{f(x,y)}{{f}_{X}(x)} \\\\  & =\\frac{(\\frac{3x}{8})}{(\\frac{3x(-{x}^{2}+x+2)}{8})} \\\\  & =\\frac{1}{-{x}^{2}+x+2}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{Y\\,|\\,X}(y\\,|\\,x)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{Y\\,|\\,X}(y\\,|\\,x)=\\{\\begin{aligned}\\frac{1}{-{x}^{2}+x+2}, & \\,0\\le x<2,\\,{x}^{2}\\le y\\le x+2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594186 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11135011-d004-54bd-8443-1e916ad1ef85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186593421}] :answer-field/correct {:answer/id #uuid "11135011-d004-54bd-8443-1e916ad1ef85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186593421} :answer-field/id #uuid "0b0af385-e8ce-57ed-80ac-b9245d466f96" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186593990}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "88c5a614-63c6-55f1-887c-292d2526f48f" :question/math-academy-id "q-352402" :question/problem "A curve has parametric equations $x=4\\operatorname{cos}⁡(2t)+1,\\,y=4\\operatorname{sin}⁡(2t)+3.$ Given that $\\frac{\\text{d}y}{\\text{d}x}=-\\operatorname{cot}⁡(2t),$ determine $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at the point where $t=\\frac{\\pi }{4}.$ Do not round the answer.\n\n$\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,{|}_{t\\,=\\,\\frac{\\pi }{4}}=$\n{{field-1}}" :question/worked-solution "To compute $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}},$ we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=-\\operatorname{cot}⁡(2t),$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}(4\\operatorname{cos}⁡(2t)+1)=-8\\operatorname{sin}⁡(2t)\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(-\\operatorname{cot}⁡(2t))}{-8\\operatorname{sin}⁡(2t)} \\\\  & =\\frac{(2{csc}^{2}⁡(2t))}{-8\\operatorname{sin}⁡(2t)} \\\\  & =-\\frac{1}{4}{csc}^{3}⁡(2t).\\end{aligned}\n$$\n\nFinally, we evaluate at $t=\\frac{\\pi }{4},$ and we get\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,{|}_{t\\,=\\,\\frac{\\pi }{4}}=-\\frac{1}{4}{csc}^{3}⁡(2\\cdot \\frac{\\pi }{4})=-\\frac{1}{4}.\n$$"} {:db/id #edb/ref 17592186594191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18903c8d-5af3-519e-ad20-4a7cefb6f46b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xy}{y+1}" :db/id #edb/ref 17592186593436} {:answer/id #uuid "94f09c21-753a-58f6-af25-017332b8bc61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2(xy+1)}{y+1}" :db/id #edb/ref 17592186593736} {:answer/id #uuid "aa2a6ea1-c5cb-533f-8f0d-080814ac2153" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xy+1}{2(y+1)}" :db/id #edb/ref 17592186593785} {:answer/id #uuid "c128e7b2-ce09-5b01-84a0-a50607ef5b6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x+y}{2(y+1)}" :db/id #edb/ref 17592186593841} {:answer/id #uuid "cec16073-4f00-5b15-9764-b1607114d278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{y+1}{xy+2}" :db/id #edb/ref 17592186593869}] :answer-field/correct {:answer/id #uuid "aa2a6ea1-c5cb-533f-8f0d-080814ac2153" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{xy+1}{2(y+1)}" :db/id #edb/ref 17592186593785} :answer-field/id #uuid "45ae3fb8-74fc-52d6-a846-bf0aaf975b50" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594034}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "93b3b076-040f-57da-a9b0-481b207ab196" :question/math-academy-id "q-145095" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{xy+1}{3}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind the expression of the conditional probability density function ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ for $0\\le x\\le 2,\\,0\\le y\\le 1.$" :question/worked-solution "Using the formula for the marginal density function for $Y,$ we have \n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{xy+1}{3}\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{0}^{2}(xy+1)\\,\\text{d}x \\\\  & =\\frac{1}{3}{[\\frac{{x}^{2}y}{2}+x]}_{x=0}^{x=2} \\\\  & =\\frac{1}{3}\\cdot [2y+2-0] \\\\  & =\\frac{2(y+1)}{3}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{2(y+1)}{3}, & \\,0\\le x\\le 2 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)},\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le x\\le 2,\\,0\\le y\\le 1,$ we have \n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{xy+1}{3})}{(\\frac{2(y+1)}{3})} \\\\  & =\\frac{xy+1}{2(y+1)}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{xy+1}{2(y+1)}, & \\,0\\le x\\le 2,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77dcfd72-a999-5182-815b-0d498ce235b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186593658} {:answer/id #uuid "bd9fd000-97f6-5d67-aa0f-cc2c3d137b04" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186593830} {:answer/id #uuid "e5b5d8bd-52ad-5007-b5f1-2fdb1dfde537" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186593923} {:answer/id #uuid "efd798bc-3308-50e4-9947-cea0a70620f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186593942} {:answer/id #uuid "f834a522-90f1-5f9e-b11b-146e1544e832" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186593965}] :answer-field/correct {:answer/id #uuid "efd798bc-3308-50e4-9947-cea0a70620f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186593942} :answer-field/id #uuid "896800bb-bda0-56fe-bf6c-5adb62c1d3dc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594069}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a4560bae-8d12-5ad1-a3d8-c1d5cc49a7cc" :question/math-academy-id "q-67618" :question/problem "Evaluate ${lim}_{x\\to -\\infty }\\frac{1}{3{x}^{4}-2{x}^{3}-2}.$" :question/worked-solution "For any non-constant polynomial $P(x),$ we have\n\n$$\n{lim}_{x\\to \\pm \\infty }(\\frac{1}{P(x)})=0.\n$$\n\nTherefore, since $3{x}^{4}-2{x}^{3}-2$ is a non-constant polynomial, we have\n\n$$\n{lim}_{x\\to -\\infty }\\frac{1}{3{x}^{4}-2{x}^{3}-2}=0.\n$$"} {:db/id #edb/ref 17592186594202 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3693820a-1870-5848-9030-438ce9172e9a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{16}{21}" :db/id #edb/ref 17592186593501} {:answer/id #uuid "78acea98-d856-506b-97db-a44a12229297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{32}" :db/id #edb/ref 17592186593662} {:answer/id #uuid "9ae90186-9131-57b6-8399-82183c7ae35f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{24}" :db/id #edb/ref 17592186593753} {:answer/id #uuid "bba38901-beba-5400-9447-3315323caf6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{24}" :db/id #edb/ref 17592186593826} {:answer/id #uuid "fa257460-0d27-5b77-b2fe-d268692bba91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186593968}] :answer-field/correct {:answer/id #uuid "78acea98-d856-506b-97db-a44a12229297" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{21}{32}" :db/id #edb/ref 17592186593662} :answer-field/id #uuid "52b233f1-7196-540f-9aaf-964ccf28135d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594041}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "aeede78e-94df-54ad-9afa-3cff3ecafc80" :question/math-academy-id "q-145041" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following conditional probability density function:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2x+2y}{2y+1}, & \\,0<x<1,\\,0<y<1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFind $P(X<\\frac{3}{4}\\,|\\,Y=\\frac{1}{2}).$" :question/worked-solution "Recall that \n\n$$\nP(X\\in A\\,|\\,Y=y)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}x,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nIn our case, we have \n\n$$\n\\begin{aligned}P(X<\\frac{3}{4}\\,|\\,Y=\\frac{1}{2}) & ={\\int }_{0}^{3/4}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{1}{2})\\text{d}x \\\\  & ={\\int }_{0}^{3/4}\\frac{(2x+2\\cdot \\frac{1}{2})}{(2\\cdot \\frac{1}{2}+1)}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{3/4}(2x+1)\\,\\text{d}x \\\\  & =\\frac{1}{2}[{x}^{2}+x]_{0}^{3/4} \\\\  & =\\frac{1}{2}({(\\frac{3}{4})}^{2}+\\frac{3}{4}-0) \\\\  & =\\frac{1}{2}(\\frac{9}{16}+\\frac{3}{4}) \\\\  & =\\frac{1}{2}\\cdot \\frac{21}{16} \\\\  & =\\frac{21}{32}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594203 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "421d3258-0992-5690-86a7-24925be3e5f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{cos}^{2}⁡(3t)" :db/id #edb/ref 17592186593537} {:answer/id #uuid "5678a13e-e254-5805-85ea-2836ef7d454a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{sec}^{2}⁡(3t)" :db/id #edb/ref 17592186593586} {:answer/id #uuid "7a0741a7-6145-5265-889c-c85a81f26078" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{tan}⁡(3t)\\operatorname{sec}⁡(3t)" :db/id #edb/ref 17592186593666} {:answer/id #uuid "931876c4-7498-52cb-aad7-5184738ccfdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{3}⁡(3t)" :db/id #edb/ref 17592186593731} {:answer/id #uuid "ffcabd99-4a72-534d-bfd8-5aba2125ca3f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{cos}^{3}⁡(3t)" :db/id #edb/ref 17592186593983}] :answer-field/correct {:answer/id #uuid "931876c4-7498-52cb-aad7-5184738ccfdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{sec}^{3}⁡(3t)" :db/id #edb/ref 17592186593731} :answer-field/id #uuid "bf8d76bb-c4ae-5298-b35c-40788500a1ed" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594101}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "b00897f7-a949-5b05-8c12-cb2a23d0fc30" :question/math-academy-id "q-50323" :question/problem "A curve is defined by the parametric equations $x=\\operatorname{sin}⁡(3t),\\,y=-2\\operatorname{cos}⁡(3t)-2.$ Given that $\\frac{dy}{dx}=2\\operatorname{tan}⁡(3t),$ calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nWe're given that $\\frac{dy}{dx}=2\\operatorname{tan}⁡(3t),$ and we can calculate $\\frac{dx}{dt}$ as follows:\n\n$$\n\\frac{dx}{dt}=\\frac{d}{dt}(\\operatorname{sin}⁡(3t))=3\\operatorname{cos}⁡(3t)\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(2\\operatorname{tan}⁡(3t))}{3\\operatorname{cos}⁡(3t)} \\\\  & =\\frac{6{sec}^{2}⁡(3t)}{3\\operatorname{cos}⁡(3t)} \\\\  & =2{sec}^{3}⁡(3t).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1572b57a-dff2-5ebd-8871-f0e3a47e3677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186593430} {:answer/id #uuid "4750a9d7-5626-52ae-b638-7bcd5c7c0cfc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{20}" :db/id #edb/ref 17592186593553} {:answer/id #uuid "9fb8933e-b886-5556-b4bb-aabbd9801367" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186593765} {:answer/id #uuid "f1c40c99-1fc1-5e4b-bc92-e97e3142de3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{40}" :db/id #edb/ref 17592186593949} {:answer/id #uuid "f44e224b-a122-56f4-9ab4-0388bd861372" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186593956}] :answer-field/correct {:answer/id #uuid "f1c40c99-1fc1-5e4b-bc92-e97e3142de3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{40}" :db/id #edb/ref 17592186593949} :answer-field/id #uuid "be261ba0-d614-5a73-b85e-4435b032bf31" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594098}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "d1413b7f-f919-5052-8fef-4e7307d9f409" :question/math-academy-id "q-145127" :question/problem "Let $X$ and $Y$ be two continuous random variables with the following joint probability density function:\n\n$$\nf(x,y)=\\{\\begin{aligned}\\frac{3(x+2y)}{2}, & \\,0\\le y\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\n \n\nFind $P(X<\\frac{2}{5}\\,|\\,Y=\\frac{1}{5}).$" :question/worked-solution "Recall that \n\n$$\nP(Y\\in A\\,|\\,X=x)={\\int }_{A}{f}_{X\\,|\\,Y}(x\\,|\\,y)\\,\\text{d}y,\n$$\n\nwhere ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ is the conditional probability density function of $X$ given $Y=y.$ \n\nUsing the formula for the marginal density function for $Y,$ we have\n\n$$\n\\begin{aligned}{f}_{Y}(y) & ={\\int }_{-\\infty }^{\\infty }f(x,y)\\,\\text{d}x \\\\  & ={\\int }_{y}^{1}\\frac{3(x+2y)}{2}\\,\\text{d}x \\\\  & =\\frac{3}{2}{\\int }_{y}^{1}(x+2y)\\,\\text{d}x \\\\  & =\\frac{3}{2}{[\\frac{1}{2}{x}^{2}+2xy]}_{x=y}^{x=1} \\\\  & =\\frac{3}{2}(\\frac{1}{2}+2y-\\frac{1}{2}{y}^{2}-2{y}^{2}) \\\\  & =\\frac{3}{2}[\\frac{1+4y-5{y}^{2}}{2}] \\\\  & =\\frac{3(1+4y-5{y}^{2})}{4}.\\end{aligned}\n$$\n\nSo, the full expression for ${f}_{Y}(y)$ is the following:\n\n$$\n{f}_{Y}(y)=\\{\\begin{aligned}\\frac{3(1+4y-5{y}^{2})}{4}, & \\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nNow recall that the conditional probability density function of $X$ given $Y=y$ for two continuous random variables $X$ and $Y$ is given by\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\frac{f(x,y)}{{f}_{Y}(y)}.\n$$\n\nwhere\n\n- $f(x,y)$ is the joint probability density function for $X$ and $Y,$ and\n\n- ${f}_{Y}(y)$ is the marginal density function for $Y.$\n\nNow, for $0\\le y\\le x\\le 1,$ we have\n\n$$\n\\begin{aligned}{f}_{X\\,|\\,Y}(x\\,|\\,y) & =\\frac{f(x,y)}{{f}_{Y}(y)} \\\\  & =\\frac{(\\frac{3(x+2y)}{2})}{(\\frac{3(1+4y-5{y}^{2})}{4})} \\\\  & =\\frac{2(x+2y)}{1+4y-5{y}^{2}}.\\end{aligned}\n$$\n\nFor other values of $x$ and $y,$ the function $f(x,y)$ equals $0.$ As a result, ${f}_{X\\,|\\,Y}(x\\,|\\,y)$ will be equal to $0$ too.\n\nTherefore, the conditional probability density function is the following:\n\n$$\n{f}_{X\\,|\\,Y}(x\\,|\\,y)=\\{\\begin{aligned}\\frac{2(x+2y)}{1+4y-5{y}^{2}}, & \\,0\\le y\\le x\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nFinally, we compute our probability:\n\n$$\n\\begin{aligned}P(X<\\frac{2}{5}\\,|\\,Y=\\frac{1}{5}) & ={\\int }_{y}^{2/5}{f}_{X\\,|\\,Y}(x\\,|\\,y=\\frac{1}{5})\\text{d}x \\\\  & ={\\int }_{1/5}^{2/5}\\frac{2(x+2(\\frac{1}{5}))}{(1+4(\\frac{1}{5})-5{(\\frac{1}{5})}^{2})}\\,\\text{d}x \\\\  & ={\\int }_{1/5}^{2/5}\\frac{2(x+\\frac{2}{5})}{(\\frac{8}{5})}\\,\\text{d}x \\\\  & =\\frac{1}{4}{\\int }_{1/5}^{2/5}(5x+2)\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{5{x}^{2}}{2}+2x]}_{1/5}^{2/5} \\\\  & =\\frac{1}{4}(\\frac{2}{5}+\\frac{4}{5}-\\frac{1}{10}-\\frac{2}{5}) \\\\  & =\\frac{1}{4}(\\frac{7}{10}) \\\\  & =\\frac{7}{40}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186594224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a2c0631-0bd4-5d71-9836-be598891083b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.12" :db/id #edb/ref 17592186593439} {:answer/id #uuid "2606abf0-8418-5f2c-ba74-449c818c1e05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.11" :db/id #edb/ref 17592186593470} {:answer/id #uuid "a2873844-44cc-5aa7-bbd2-59778cdbb622" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.09" :db/id #edb/ref 17592186593770} {:answer/id #uuid "b9e952be-961b-57b8-9c32-60b303de06eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.04" :db/id #edb/ref 17592186593819} {:answer/id #uuid "e9f815f9-bbd5-5fec-a212-23cc136e306d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.06" :db/id #edb/ref 17592186593930}] :answer-field/correct {:answer/id #uuid "b9e952be-961b-57b8-9c32-60b303de06eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-0.04" :db/id #edb/ref 17592186593819} :answer-field/id #uuid "358713e9-f69b-5d1e-aa48-49a9e0be9a90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186594025}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d96a62c4-445f-5a0f-be6a-6a822a55817d" :question/math-academy-id "q-148355" :question/problem "$$\nf(x,y)=\\{\\begin{aligned}\\frac{2x+{e}^{y}}{e}, & \\,0\\le x\\le 1,\\,0\\le y\\le 1 \\\\ 0, & \\,\\text{otherwise}\\end{aligned}\n$$\n\nThe joint probability density function $f(x,y)$ for the continuous random variables $X$ and $Y$ is shown above. Given that \n\n$$\n\\text{E}[X]=\\frac{3e+1}{6e},\\,\\text{E}[Y]=\\frac{3}{2e},\\,\\text{SD}[X]≈0.2821,\\,\\text{SD}[Y]≈0.2870,\n$$\n\n \nfind the correlation coefficient of $X$ and $Y.$ Round your answer to $2$ decimal places." :question/worked-solution "Recall that the correlation coefficient of the random variables $X$ and $Y$ is defined as\n\n$$\n\\rho =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]},\n$$\n\nwhere\n\n- $\\text{Cov}[X,Y]$ is the covariance, and\n\n- $\\text{SD}[X]$ and $\\text{SD}[Y]$ are the standard deviations of $X$ and $Y.$\n\nFirst, by applying the rule of the lazy statistician, we have\n\n$$\n\\begin{aligned}\\text{E}[XY] & ={∬}_{{R}^{2}}xy\\,f(x,y)\\,\\text{d}x\\text{d}y \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{1}xy\\cdot (\\frac{2x+{e}^{y}}{e})\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{1}{e}{\\int }_{0}^{1}[{\\int }_{0}^{1}(2{x}^{2}y+xy{e}^{y})\\,\\text{d}x]\\text{d}y \\\\  & =\\frac{1}{e}{\\int }_{0}^{1}{[\\frac{2}{3}{x}^{3}y+\\frac{1}{2}{x}^{2}y{e}^{y}]}_{x=0}^{x=1}\\text{d}y \\\\  & =\\frac{1}{e}{\\int }_{0}^{1}(\\frac{2}{3}y+\\frac{1}{2}y{e}^{y})\\,\\text{d}y \\\\  & =\\frac{1}{e}{[\\frac{1}{3}{y}^{2}+\\frac{1}{2}y{e}^{y}-\\frac{1}{2}{e}^{y}]}_{0}^{1} \\\\  & =\\frac{1}{e}(\\frac{1}{3}+\\frac{e}{2}-\\frac{e}{2}+\\frac{1}{2}) \\\\  & =\\frac{5}{6e}.\\end{aligned}\n$$\n\nThen, we compute the covariance and get\n\n$$\n\\begin{aligned}\\text{Cov}[X,Y] & =\\text{E}[XY]-\\text{E}[X]\\cdot \\text{E}[Y] \\\\  & =\\frac{5}{6e}-(\\frac{3e+1}{6e})(\\frac{3}{2e}) \\\\  & =\\frac{e-3}{12{e}^{2}}.\\end{aligned}\n$$\n\nTherefore, the correlation coefficient is \n\n$$\n\\begin{aligned}\\rho  & =\\frac{\\text{Cov}[X,Y]}{\\text{SD}[X]\\cdot \\text{SD}[Y]} \\\\  & ≈\\frac{(\\frac{e-3}{12{e}^{2}})}{(0.2821)\\cdot (0.2870)} \\\\  & ≈-0.04,\\end{aligned}\n$$\n\nrounded to $2$ decimal places."} {:db/id #edb/ref 17592186594227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2376757d-a62d-51e9-ac20-65b410312a29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "n\\ge 0" :db/id #edb/ref 17592186593461} {:answer/id #uuid "3ff26939-c58d-5d2f-ae9b-abbe8cd26b6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :an