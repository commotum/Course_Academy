dent :answer.type/math} :answer/value "-\\frac{8}{b}" :db/id #edb/ref 17592186067718} {:answer/id #uuid "6c911733-8c6b-5b54-b28b-ffba8ec043c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{b}" :db/id #edb/ref 17592186067719} {:answer/id #uuid "b1595b53-a21f-533f-948c-76530eaa78e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{{b}^{2}}" :db/id #edb/ref 17592186549648}] :answer-field/correct {:answer/id #uuid "8db7862b-5783-5ab9-a17c-fc752181c249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{b}" :db/id #edb/ref 17592186067715} :answer-field/id #uuid "d0a19cef-79e8-55b0-b52d-817fbf5bad48" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067714}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c88910e9-93dc-5fa8-9def-79b320b71eb9" :question/math-academy-id "q-52492" :question/problem "Simplify $\\sqrt[3]{-\\frac{64}{{b}^{3}}}.$" :question/worked-solution "To simplify the expression, we write the term under the radical as a perfect cube, and simplify:\n\n$$\n\\begin{aligned}\\sqrt[3]{-\\frac{64}{{b}^{3}}} &= \\sqrt[3]{(-\\frac{4}{b})\\cdot (-\\frac{4}{b})\\cdot (-\\frac{4}{b})} \\\\ &= \\sqrt[3]{{(-\\frac{4}{b})}^{3}} \\\\ &= -\\frac{4}{b}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069433 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a1d061e-1095-5778-a202-03ac3003ee94" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4t}" :db/id #edb/ref 17592186330178} {:answer/id #uuid "44be33f5-4337-5bc6-94f8-7c5e371b8369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186330570} {:answer/id #uuid "671f461d-02ec-553d-b247-625889adedef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4t" :db/id #edb/ref 17592186330874} {:answer/id #uuid "6c7f9c14-7b4b-530d-b6f3-d9ad39cee6d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t}{4}" :db/id #edb/ref 17592186330920} {:answer/id #uuid "bb9a3047-da02-5e85-b56b-576037ad1575" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{t}" :db/id #edb/ref 17592186331605}] :answer-field/correct {:answer/id #uuid "44be33f5-4337-5bc6-94f8-7c5e371b8369" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186330570} :answer-field/id #uuid "3627e7f9-6399-5261-91fb-d163d148cd05" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332293}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f0ede589-ff31-5064-b18d-333b3fc8143f" :question/math-academy-id "q-54155" :question/problem "A curve is defined by the parametric equations $x={t}^{2}-2,\\,y=2{t}^{4}+5$ where $t$ is a real number. Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}.$" :question/worked-solution "To find the first derivative, we will use the formula\n\n$$\n\\frac{dy}{dx}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nDifferentiating $x$ and $y,$ we get\n\n$$\n{x}^{′}(t)=2t,\\,{y}^{′}(t)=8{t}^{3}.\n$$\n\n \n\nTherefore,\n\n$$\n\\frac{dy}{dx}=\\frac{8{t}^{3}}{2t}=4{t}^{2}.\n$$\n\nTo compute the second derivative, we can use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(\\frac{dy}{dx})}{(\\frac{dx}{dt})}.\\end{aligned}\n$$\n\nSubstituting into the formula, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{dt}(4{t}^{2})}{2t} \\\\  & =\\frac{8t}{2t} \\\\  & =4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069442 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c2372a5-c162-57c4-a329-37384487f936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186330200} {:answer/id #uuid "4a3fdda3-cf41-56fa-a7e8-dc1a22427501" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186330620} {:answer/id #uuid "57d52bec-741b-5807-8d5b-7c50bd5ed638" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186330734} {:answer/id #uuid "5af3ffd2-5e90-549e-bd4a-c2ecd739c057" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186330764} {:answer/id #uuid "99aaff48-07c0-5e1b-a1de-64a55ccae635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186331324}] :answer-field/correct {:answer/id #uuid "1c2372a5-c162-57c4-a329-37384487f936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186330200} :answer-field/id #uuid "79fa7732-36c7-5c7f-ad6f-0f4f92fea8a4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332422}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "71d513de-a58e-50a7-b4d2-f05bb9e08ea8" :question/math-academy-id "q-55433" :question/problem "![](images/2d/2d0b1cdb3ff99abaab113c5b0beaf0e1a3ad8738cbd84b1f95da5b7c1139582b.png)\n\nThe graph above shows $y=k{(\\frac{1}{3})}^{x}+c.$  Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{3})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-3,$ hence $c=-3.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,3),$ so we substitute $x=0$ and $y=3$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}-3 & =y \\\\ k{(\\frac{1}{2})}^{0}-3 & =3 \\\\ k-3 & =3 \\\\ k & =6\\end{aligned}\n$$\n\nTherefore, \n\n$$\nk-c=6-(-3)=9.\n$$\n\nThe equation of the curve is $y=6{(\\frac{1}{2})}^{x}-3.$"} {:db/id #edb/ref 17592186069473 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "85931bd9-7b3e-5a76-8e10-5884c207be8e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "∞" :db/id #edb/ref 17592186068009} {:answer/id #uuid "8d1ab448-8539-553b-83cd-8d85ad8df62d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186068010} {:answer/id #uuid "98ef79bc-879c-5d65-b914-5c7641af7f4c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- ∞" :db/id #edb/ref 17592186068011} {:answer/id #uuid "c6c5a153-758f-50b0-b5f6-d0539842714f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186068012} {:answer/id #uuid "f308f877-58fd-5ae9-bb94-9dca45934bf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186068013}] :answer-field/id #uuid "94652401-da00-50e5-8445-e541c73aeb19" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186068008}] :question/id #uuid "65e021e0-0b86-524d-98db-8ce5e19dbd28" :question/math-academy-id "q-65731" :question/problem "Evaluate $lim_(x → 0^{+})(\\ln x)/((\\frac{1}{x^{2}}))$."} {:db/id #edb/ref 17592186069480 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "962a5392-afa7-5c51-965e-d9cc0eaa542c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.ty