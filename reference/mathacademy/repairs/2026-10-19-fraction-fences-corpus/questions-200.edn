sqrt{4 - (2x + 1)^{2}})dx$?"} {:db/id #edb/ref 17592186069379 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24ae7afd-8576-5602-9501-9c611ec3ed70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186330263} {:answer/id #uuid "4201b9e5-4180-5325-b8c7-2805b2c0f988" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186330537} {:answer/id #uuid "7739fe2a-f91d-523e-b519-5eba915ac6ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331016} {:answer/id #uuid "acecead2-9843-5d76-95c9-05999fbf5f2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331483} {:answer/id #uuid "eb610479-69f3-5893-b5aa-5c24f871f951" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186332017}] :answer-field/correct {:answer/id #uuid "24ae7afd-8576-5602-9501-9c611ec3ed70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186330263} :answer-field/id #uuid "a49e43bf-f0bc-5e97-9fad-8508bb19da5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332489}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1f6ebcba-4e39-5954-8ee8-c37c592d0f6b" :question/math-academy-id "q-49604" :question/problem "Given that\n\n$$\n\\int \\frac{13}{(3x+2)(2x-3)}\\,\\text{d}x=a\\operatorname{ln}⁡|2x-3|+b\\operatorname{ln}⁡|3x+2|+C,\n$$\n\nfind the value of $a+b.$" :question/worked-solution "First, we convert the integrand into a sum of partial fractions:\n\n$$\n\\begin{aligned}\\frac{13}{(3x+2)(2x-3)} & =\\frac{A}{3x+2}+\\frac{B}{2x-3},\\end{aligned}\n$$\n\nwhich gives\n\n$$\n13=A(2x-3)+B(3x+2).\n$$\n\nPlugging in $x=\\frac{3}{2},$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}13 & =A(2(\\frac{3}{2})-3)+B(3(\\frac{3}{2})+2) \\\\ 13 & =\\frac{13}{2}B \\\\ B & =2\\end{aligned}\n$$\n\nOn the other hand, plugging in $x=-\\frac{2}{3},$ we can eliminate $B$ and solve for $A:$\n\n$$\n\\begin{aligned}13 & =A(2(-\\frac{2}{3})-3)+B(3(-\\frac{2}{3})+2) \\\\ 13 & =-\\frac{13}{3}A \\\\ A & =-3\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{13}{(3x+2)(2x-3)}=-\\frac{3}{3x+2}+\\frac{2}{2x-3}.\\end{aligned}\n$$\n\nFinally, we integrate, and we get\n\n$$\n\\begin{aligned}\\int \\frac{13}{(3x+2)(2x-3)}\\,\\text{d}x & =\\int (-\\frac{3}{3x+2}+\\frac{2}{2x-3})\\text{d}x \\\\  & =-\\int \\frac{3}{3x+2}\\,\\text{d}x+\\int \\frac{2}{2x-3}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|2x-3|-\\operatorname{ln}⁡|3x+2|+C.\\end{aligned}\n$$\n\nFinally, $a=1,b=-1,$ and $a+b=1-1=0.$"} {:db/id #edb/ref 17592186069381 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00709870-7f4c-5356-80cf-211ddd517d75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arcsec(\\frac{x + 5}{4}) + C" :db/id #edb/ref 17592186067457} {:answer/id #uuid "08706584-6769-5f22-b6e5-308bfc2b331f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}arcsec(x + 1) + C" :db/id #edb/ref 17592186067458} {:answer/id #uuid "10539117-6887-5312-98eb-ea55255b06d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4arcsec(x + 5) + C" :db/id #edb/ref 17592186067459} {:answer/id #uuid "4e582638-1a45-5e4d-9977-3694cc0bc819" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4arcsec(\\frac{x}{5}) + C" :db/id #edb/ref 17592186067460} {:answer/id #uuid "7dc24e3b-ad25-5d1c-bb6c-6e85ec57a5ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5arcsec(x + 4) + C" :db/id #edb/ref 17592186067461}] :answer-field/id #uuid "d07946d2-98e2-53f4-87c9-6cfc63e7857f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067456}] :question/id #uuid "e6adfbad-2a10-5697-8e74-528e81a4c55a" :question/math-academy-id "q-49686" :question/problem "What is $\\displaystyle \\int(4)/(\\mid x + 5 \\mid \\sqrt{(x + 5)^{2} - 1})dx$?"} {:db/id #edb/ref 17592186069382 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "35cdedaa-2971-5cd3-b239-0423a71c6b73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{7}{36})" :db/id #edb/ref 17592186330429} {:answer/id #uuid "6bc8531b-20c3-5c50-9e7c-90adbbc4c609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{7}{24})" :db/id #edb/ref 17592186330919} {:answer/id #uuid "7731bb28-1882-5e20-a675-fbdb1096d84c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(168)" :db/id #edb/ref 17592186331015} {:answer/id #uuid "859367df-628b-54a6-9551-215ec16a1e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(17)" :db/id #edb/ref 17592186331135} {:answer/id #uuid "dcc56717-5b83-578f-a99a-4c6c6035ec8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{7}{32})" :db/id #edb/ref 17592186331907}] :answer-field/correct {:answer/id #uuid "6bc8531b-20c3-5c50-9e7c-90adbbc4c609" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{7}{24})" :db/id #edb/ref 17592186330919} :answer-field/id #uuid "f092496f-4167-57cc-ad3a-f1e3a758daf3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332624}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1b7a0d53-d8cd-5e6c-b6e9-1877172e8d87" :question/math-academy-id "q-49761" :question/problem "Evaluate\n${\\int }_{2}^{3}\\frac{3x+4}{{x}^{2}-16}\\,\\text{d}x.$" :question/worked-solution "We'll work out the indefinite integral first and then proceed with the definite integral.\n\nFirst, we note that a denominator of the integrand can be factored as\n\n$$\n{x}^{2}-16=(x+4)(x-4).\n$$\n\nSo the integrand can be converted into a sum of partial fractions,\n\n$$\n\\begin{aligned}\\frac{3x+4}{{x}^{2}-16} & =\\frac{3x+4}{(x+4)(x-4)}=\\frac{A}{(x+4)}+\\frac{B}{(x-4)},\\end{aligned}\n$$\n\nwhich gives\n\n$$\n3x+4=A(x-4)+B(x+4).\n$$\n\nPlugging in $x=4,$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}3(4)+4 & =A(4-4)+B(4+4) \\\\ 16 & =8B \\\\ B & =2\\end{aligned}\n$$\n\nOn the other hand, plugging in $x=-4,$ we can eliminate $B$ and solve for $A:$\n\n$$\n\\begin{aligned}3(-4)+4 & =A(-4-4)+B(-4+4) \\\\ -8 & =-8A \\\\ A & =1\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3x+4}{{x}^{2}-16}=\\frac{1}{(x+4)}+\\frac{2}{(x-4)}.\n$$\n\nNow, we integrate, and we get\n\n$$\n\\begin{aligned}\\int \\frac{3x+4}{{x}^{2}-16}\\,\\text{d}x & =\\int (\\frac{1}{(x+4)}+\\frac{2}{(x-4)})\\,\\text{d}x \\\\  & =\\int \\frac{1}{x+4}\\,\\text{d}x+2{\\int }_{2}^{3}\\frac{1}{x-4}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x+4|+2\\operatorname{ln}⁡|x-4|+C.\\end{aligned}\n$$\n\nWe can simplify the result using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3x+4}{{x}^{2}-16}\\,\\text{d}x & =\\operatorname{ln}⁡|x+4|+2\\operatorname{ln}⁡|x-4|+C \\\\  & =\\operatorname{ln}⁡|x+4|+\\operatorname{ln}⁡|(x-4)^{2}|+C \\\\  & =\\operatorname{ln}⁡|(x+4)(x-4)^{2}|+C\\end{aligned}\n$$\n\nFinally, the definite integral is\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}\\frac{3x+4}{{x}^{2}-16}\\,\\text{d}x & =\\operatorname{ln}⁡|(x+4)(x-4)^{2}|{|}_{2}^{3} \\\\  & =\\operatorname{ln}⁡(7)-\\operatorname{ln}⁡(24) \\\\  & =\\operatorname{ln}⁡(\\frac{7}{24}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069383 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8acf67b3-93bf-549d-9c50-26f933c82ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{3}{4})" :db/id #edb/ref 17592186067469} {:answer/id #uuid "8c45cb13-4e05-5bff-a7a0-561fd848029d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{20}{3})" :db/id #edb/ref 17592186067470} {:answer/id #uuid "bf27595e-98fb-50de-940d-997dd079e3bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{1}{4})" :db/id #edb/ref 17592186067471} {:answer/id #uuid "f715cd54-b9c2-5d74-88de-1757cf436473" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{32}{3})" :db/id #edb/ref 17592186067472} {:answer/id #uuid "114a2306-66da-5c82-ab19-ae946b637713" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (\\frac{16}{3})" :db/id #edb/ref 17592186067473}] :answer-field/id #uuid "64c419c7-a91a-581a-b296-3a8356a41f2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067468}] :question/id #uuid "25dcfa81-6d0a-5f2d-9d07-6a9bf3dcb175" :question/math-academy-id "q-49766" :question/problem "What is $\\displaystyle \\int_{4}^{7}(2x + 2)/((x - 3)(x + 5))dx$?"} {:db/id #edb/ref 17592186069386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5daeff0-4906-5f6e-add4-4303ab444e53" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\ln (x^{2} + 5) + \\frac{1}{3}\\arctan (\\frac{x}{\\sqrt{5}}) + \\frac{1}{4}\\ln \\mid x + 3 \\mid + K" :db/id #edb/ref 17592186067487} {:answer/id #uuid "dac84914-a661-5c9c-8c42-da5f70900812" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\ln (x^{2} + 5) + \\frac{7}{10}\\arctan (\\frac{x}{\\sqrt{5}}) + \\frac{1}{2}\\ln \\mid x + 5 \\mid + K" :db/id #edb/ref 17592186067488} {:answer/id #uuid "e74a34df-905b-5a22-a760-cfdf1f309ea2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\ln (x^{2} + 5) + \\frac{4}{5}\\arctan (\\frac{x}{\\sqrt{4}}) + 2\\ln \\mid x + 3 \\mid + K" :db/id #edb/ref 17592186067489} {:answer/id #uuid "6765f279-6a3d-5710-85eb-3621ba543870" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\ln (x^{2} + 5) + \\frac{7}{2\\sqrt{5}}\\arctan (\\frac{x}{\\sqrt{5}}) + \\frac{1}{2}\\ln \\mid x + 3 \\mid + K" :db/id #edb/ref 17592186067490} {:answer/id #uuid "6f759274-3709-5f3c-befa-1d66800c1c6e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5\\ln (x^{2} + 5) + 13\\arctan (\\frac{x}{\\sqrt{7}}) - \\ln \\mid x + 3 \\mid + K" :db/id #edb/ref 17592186067491}] :answer-field/id #uuid "22d5f934-97db-54a6-9511-a2e2e9626ae2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067486}] :question/id #uuid "80c31499-272a-5dfb-961b-7f389a6a7b8e" :question/math-academy-id "q-49789" :question/problem "Evaluate $\\displaystyle \\int(x^{2} + 5x + 13)/((x^{2} + 5)(x + 3))dx$.\n\n> A calculator is required to answer this question." :question/requires-calculator true} {:db/id #edb/ref 17592186069397 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18cf8091-e95f-5a3e-91c9-637550a5d656" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|x-1|-\\frac{1}{4}\\operatorname{ln}⁡({x}^{2}+1)+\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186330160} {:answer/id #uuid "307c0655-7046-513b-9027-a26e8a039b85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|-\\operatorname{ln}⁡({x}^{2}+1)+K" :db/id #edb/ref 17592186330376} {:answer/id #uuid "7ed5de4a-6322-595e-96d5-d08a99d6bcb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|x-1|+\\operatorname{ln}⁡({x}^{2}+1)+\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186331068} {:answer/id #uuid "819a7980-eb5f-5144-bd32-35450b9696a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{ln}⁡|x-1|+2\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186331097} {:answer/id #uuid "f00ee12b-a02d-5cce-975e-e9d0c11771ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186332061}] :answer-field/correct {:answer/id #uuid "f00ee12b-a02d-5cce-975e-e9d0c11771ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|x-1|-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K" :db/id #edb/ref 17592186332061} :answer-field/id #uuid "ab9021bd-ffa0-5426-993e-de80eba89205" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186332499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d605be2d-ae71-5e50-9bf1-07465ceead87" :question/math-academy-id "q-49919" :question/problem "Evaluate $\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x.$" :question/requires-calculator true :question/worked-solution "The quadratic factor ${x}^{2}+1$ is irreducible, so we proceed with the following partial fraction decomposition:\n\n$$\n\\frac{2}{(x-1)({x}^{2}+1)}=\\frac{A}{x-1}+\\frac{Bx+C}{{x}^{2}+1}.\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $(x-1)({x}^{2}+1),$ and we get\n\n$$\n2=A({x}^{2}+1)+(Bx+C)(x-1).\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=1,B=-1,$ and $C=-1.$ Therefore,\n\n$$\n\\frac{2}{(x-1)({x}^{2}+1)}=\\frac{1}{x-1}+\\frac{-x-1}{{x}^{2}+1}.\n$$\n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x & =\\int (\\frac{1}{x-1}+\\frac{-x-1}{{x}^{2}+1})\\,\\text{d}x \\\\  & =\\int \\frac{1}{x-1}\\,\\text{d}x-\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x\\end{aligned}\n$$\n\nFor the first integral, we have\n\n$$\n\\int \\frac{1}{x-1}\\,\\text{d}x=\\operatorname{ln}⁡|x-1|.\n$$\n\nFor the second integral, we use the substitution $u={x}^{2}+1.$ Then $\\text{d}u=2x\\,\\text{d}x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x & =\\int (\\frac{1}{u})\\frac{\\text{d}u}{2} \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|{x}^{2}+1| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)\\,.\\end{aligned}\n$$\n\nFinally, for the third integral, we use the fact that $\\int \\frac{1}{{x}^{2}+{a}^{2}}\\,\\text{d}x=\\frac{1}{a}\\operatorname{arctan}⁡(\\frac{x}{a}),$ which results in\n\n$$\n\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x=\\operatorname{arctan}⁡x.\n$$\n\nSo, we get the following result:\n\n$$\n\\begin{aligned}\\int \\frac{2}{(x-1)({x}^{2}+1)}\\,\\text{d}x & =\\int \\frac{1}{x-1}\\,\\text{d}x-\\int \\frac{x}{{x}^{2}+1}\\,\\text{d}x-\\int \\frac{1}{{x}^{2}+1}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡|x-1|-\\frac{1}{2}\\operatorname{ln}⁡({x}^{2}+1)-\\operatorname{arctan}⁡x+K\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069399 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e43000d-d261-55a5-a180-481002f03d85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) + 2\\intx\\cos (2x)dx" :db/id #edb/ref 17592186067565} {:answer/id #uuid "90d63a70-4815-58be-9c3d-baa0abafe498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}\\cos (2x) - 2\\intx\\sin (2x)dx" :db/id #edb/ref 17592186067566} {:answer/id #uuid "9cd2a0e1-16c6-58ee-8c30-0ba6e9a6fce2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) + \\intx\\sin (2x)dx" :db/id #edb/ref 17592186067567} {:answer/id #uuid "59d49b1a-803b-53d8-83fa-db70c7789e5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x^{2}\\cos (2x) + \\intx\\cos (2x)dx" :db/id #edb/ref 17592186067568} {:answer/id #uuid "7f31ebbc-a68d-5c7a-8fdb-dfb85730e139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) - 2\\intx\\cos (2x)dx" :db/id #edb/ref 17592186067569}] :answer-field/id #uuid "bdc0a1cc-0786-5dc8-94ce-95c2c8213374" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067564} {:answer-field/choices [{:answer/id #uuid "f7c7c20d-accc-5eb4-b6a3-26340cccb5ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{cos}⁡(2x)+\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186392697} {:answer/id #uuid "c3276c38-5029-5b87-95b1-8d3ff7480e62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{2}\\operatorname{cos}⁡(2x)-2\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186392698} {:answer/id #uuid "480dbe0b-2a18-5a64-b727-eb87c66b398a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{2}\\operatorname{cos}⁡(2x)-2\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186392699} {:answer/id #uuid "e1f5ea9a-9bd8-57df-8e18-cd426e2756d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{2}\\operatorname{cos}⁡(2x)+2\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186392700} {:answer/id #uuid "06683fb1-99e0-5343-bb53-9df88afcdcfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{2}\\operatorname{cos}⁡(2x)+\\int x\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186392701}] :answer-field/correct {:answer/id #uuid "e1f5ea9a-9bd8-57df-8e18-cd426e2756d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-{x}^{2}\\operatorname{cos}⁡(2x)+2\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186392700} :answer-field/id #uuid "1441513b-5340-5a67-a076-58e34736665d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186392696}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7db8d1cc-8a1b-5f0d-8178-c39bb5e755e0" :question/math-academy-id "q-49931" :question/problem "$\\int 2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "We need to use integration by parts. \n\nIn this case, we define\n\n$$\n\\begin{aligned}u=2{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=4x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(2x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(2x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 2{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(2{x}^{2})(-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})(4x)\\,\\text{d}x \\\\  & =-{x}^{2}\\operatorname{cos}⁡(2x)+2\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069401 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8493e63b-e686-55a1-be24-8c7387ac529a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186067577} {:answer/id #uuid "b510294a-158b-59cf-9325-faaa6db5c999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186067579} {:answer/id #uuid "b70392a5-b997-5c61-a383-809b3402a781" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186067580} {:answer/id #uuid "547cd2d2-426a-5ed4-ba68-b0d437d86899" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186067581} {:answer/id #uuid "1c227681-1e75-580c-a1f0-afa6524eba89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186547373}] :answer-field/correct {:answer/id #uuid "b510294a-158b-59cf-9325-faaa6db5c999" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186067579} :answer-field/id #uuid "2656a382-672f-58cb-ac31-49e3432a71cf" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067576}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d20f7fe1-3115-57de-8eab-3a56c473cbe5" :question/math-academy-id "q-49976" :question/problem "Evaluate ${\\int }_{1}^{e}\\frac{{ln}^{3}⁡z}{z}\\,\\text{d}z$ using integration by parts." :question/worked-solution "Let's denote the indefinite integral by $I=\\int \\frac{{ln}^{3}⁡z}{z}\\,\\text{d}z.$\n\nTo use integration by parts, let's suppose that\n\n$$\n\\begin{aligned}u={ln}^{3}⁡z\\, & ⇒\\,\\frac{\\text{d}u}{\\text{d}z}=\\frac{3{ln}^{2}⁡z}{z}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}z}=\\frac{1}{z}\\, & ⇒\\,v=\\int \\frac{1}{z}\\,\\text{d}z=\\operatorname{ln}⁡z.\\end{aligned}\n$$\n\nUsing the integration by parts formula, we get\n\n$$\n\\begin{aligned}I & =\\int \\frac{{ln}^{3}⁡z}{z}\\,\\text{d}z \\\\  & =\\int u\\frac{\\text{d}v}{\\text{d}z}\\,\\text{d}z \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}z}\\,\\text{d}z \\\\  & ={ln}^{3}⁡z(\\operatorname{ln}⁡z)-\\int (\\operatorname{ln}⁡z)(\\frac{3{ln}^{2}⁡z}{z})\\,\\text{d}z \\\\  & ={ln}^{4}⁡z-3\\int \\frac{{ln}^{3}⁡z}{z}\\,\\text{d}x \\\\  & ={ln}^{4}⁡z-3I.\\end{aligned}\n$$\n\nNow, we solve for $I.$ We can ignore the constant of integration in this case, because it is insignificant for further evaluation of the definite integral.\n\n$$\n\\begin{aligned}I & ={ln}^{4}⁡z-3I \\\\ 4I & ={ln}^{4}⁡z \\\\ I & =\\frac{{ln}^{4}⁡z}{4}\\end{aligned}\n$$\n\nFinally, we evaluate our definite integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{{ln}^{3}⁡z}{z}\\,\\text{d}z & =\\frac{1}{4}({ln}^{4}⁡z){|}_{1}^{e} \\\\  & =\\frac{1}{4}({ln}^{4}⁡(e)-{ln}^{4}⁡(1)) \\\\  & =\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069412 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ded48646-180c-5b0b-a6e9-fca073f5a695" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186067645} {:answer/id #uuid "0f6a5f44-7c10-57f2-8e95-6bb68e1b82b1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427576} {:answer/id #uuid "2331cd21-2ed1-5625-a66c-71e5cb90700e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,2⟩" :db/id #edb/ref 17592186427578} {:answer/id #uuid "4ac18ed6-58a3-5417-b730-cedc5302f322" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨2,\\,2⟩" :db/id #edb/ref 17592186427580} {:answer/id #uuid "a96be7b9-8d6b-519e-93fb-b0e6acf1e4a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427584}] :answer-field/correct {:answer/id #uuid "a96be7b9-8d6b-519e-93fb-b0e6acf1e4a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨\\frac{1}{2},\\,\\frac{1}{2}⟩" :db/id #edb/ref 17592186427584} :answer-field/id #uuid "2aea7a53-b7bf-5584-8696-8766da29f419" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067642}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2dc454b1-c8a7-57a0-a955-d54808121033" :question/math-academy-id "q-50359" :question/problem "Given that $r(t)=⟨{cos}^{2}⁡t,\\,{sin}^{2}⁡t⟩,$ calculate $r(\\frac{\\pi }{4}).$" :question/worked-solution "We substitute $t=\\frac{\\pi }{4}$ into our function, and we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{4}) & =⟨{cos}^{2}⁡(\\frac{\\pi }{4}),\\,{sin}^{2}⁡(\\frac{\\pi }{4})⟩ \\\\  & =⟨{(\\frac{\\sqrt{2}}{2})}^{2},\\,{(\\frac{\\sqrt{2}}{2})}^{2}⟩ \\\\  & =⟨\\frac{1}{2},\\,\\frac{1}{2}⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069416 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c5037b-f218-5960-aaca-c6d6ba733614" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\ln (x^{2} + 2) - \\arctan (\\frac{\\sqrt{2}x}{2}) + \\ln \\mid x - 1 \\mid + C" :db/id #edb/ref 17592186067667} {:answer/id #uuid "b242685f-1140-50d5-955c-a68fcfe03b69" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\ln (x^{2} + 2) - \\frac{1}{2}\\arctan (\\frac{x}{2}) + 2\\ln \\mid x - 1 \\mid + C" :db/id #edb/ref 17592186067668} {:answer/id #uu