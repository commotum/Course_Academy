[{:db/id #edb/ref 17592186069248 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "036c4578-ebc3-5c03-be82-fc2cf13c041f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186295280} {:answer/id #uuid "27f34864-5c9e-5eb5-8992-c34773d4112d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186295486} {:answer/id #uuid "2c836a4b-213b-58ef-a1e7-bc8b5b6d517e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186295526} {:answer/id #uuid "4d26d007-7d75-5f54-a632-8037f9942831" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186295708} {:answer/id #uuid "aa5aafd4-f2b3-5db9-8c5a-19fce554b67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296160}] :answer-field/correct {:answer/id #uuid "aa5aafd4-f2b3-5db9-8c5a-19fce554b67e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296160} :answer-field/id #uuid "04ac6f86-dabc-53c9-a399-e02e12a351c8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296648}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "71ad4f56-be44-5504-8dcb-a974b170b18f" :question/math-academy-id "q-31597" :question/problem "${lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x}{{e}^{x}}=$" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{{[2\\operatorname{ln}⁡x]}^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{x})}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069262 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb84938b-4e85-52ad-bd29-6493a85415ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2x^{2}}(\\ln (x) + \\ln (x) + 2) + C" :db/id #edb/ref 17592186066743} {:answer/id #uuid "4c631bea-6fbf-571f-a223-68b06cf6efd5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2x^{2}}(2\\ln (x) + 2x + 1) + C" :db/id #edb/ref 17592186066744} {:answer/id #uuid "7121bd29-f8e0-5390-af8a-61942f7f1d9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4x^{2}}(2\\ln^{2} (x) + 2\\ln (x) + 1) + C" :db/id #edb/ref 17592186066745} {:answer/id #uuid "783b8264-0c1f-5b95-a989-efc67d9cee3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4x^{2}}(2\\ln^{2} (x) - 2x\\ln (x) - 1) + C" :db/id #edb/ref 17592186066746} {:answer/id #uuid "7c175ddc-5a30-554c-a959-fd0d2ab57583" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\ln (x))/(4x^{2})(4\\ln (x) + 2x - 1) + C" :db/id #edb/ref 17592186066747}] :answer-field/id #uuid "524578ee-6e6e-58c9-9a66-2e748e474ad2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066742} {:answer-field/choices [{:answer/id #uuid "f93bb800-dc42-5668-91b5-920a928aa57c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2{x}^{2}}(\\operatorname{ln}⁡(x)+\\operatorname{ln}⁡(x)+2)+C" :db/id #edb/ref 17592186377322} {:answer/id #uuid "11358afa-0e6f-5a2c-ac00-bac5ee0d2324" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4{x}^{2}}(2{ln}^{2}⁡(x)-2x\\operatorname{ln}⁡(x)-1)+C" :db/id #edb/ref 17592186377323} {:answer/id #uuid "8700b438-ddae-5f4f-9b2f-8578bc8c450e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2{x}^{2}}(2\\operatorname{ln}⁡(x)+2x+1)+C" :db/id #edb/ref 17592186377324} {:answer/id #uuid "06a6cfac-e003-591c-93ea-d82ce1a4d5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4{x}^{2}}(2{ln}^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C" :db/id #edb/ref 17592186377325} {:answer/id #uuid "3f20800c-2e9e-54bc-b586-4b25aa538d0f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(x)}{4{x}^{2}}(4\\operatorname{ln}⁡(x)+2x-1)+C" :db/id #edb/ref 17592186377326}] :answer-field/correct {:answer/id #uuid "06a6cfac-e003-591c-93ea-d82ce1a4d5dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4{x}^{2}}(2{ln}^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C" :db/id #edb/ref 17592186377325} :answer-field/id #uuid "4f4ccc09-3130-56b3-a2bb-f52755a0fe14" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186377321}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6c2769dd-8773-5498-9a3b-b2fed58e581f" :question/math-academy-id "q-3400" :question/problem "$\\int \\frac{{ln}^{2}⁡x}{{x}^{3}}\\,\\text{d}x=$" :question/worked-solution "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={ln}^{2}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(x)}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{ln}^{2}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({ln}^{2}⁡(x))(-\\frac{1}{2{x}^{2}})-\\int (-\\frac{1}{2{x}^{2}})(\\frac{2\\operatorname{ln}⁡(x)}{x})\\,\\text{d}x \\\\  & =-\\frac{{ln}^{2}⁡(x)}{2{x}^{2}}+\\int \\frac{\\operatorname{ln}⁡(x)}{{x}^{3}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int \\frac{\\operatorname{ln}⁡(x)}{{x}^{3}}\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x} \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\frac{1}{{x}^{3}}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\frac{1}{{x}^{3}}\\,\\text{d}x=-\\frac{1}{2{x}^{2}}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{{x}^{3}}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡(x))(-\\frac{1}{2{x}^{2}})-\\int (-\\frac{1}{2{x}^{2}})(\\frac{1}{x})\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}+\\frac{1}{2}\\int \\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & =-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int \\frac{{ln}^{2}⁡x}{{x}^{3}}\\,\\text{d}x & =-\\frac{{ln}^{2}⁡(x)}{2{x}^{2}}+(-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C) \\\\  & =-\\frac{{ln}^{2}⁡(x)}{2{x}^{2}}-\\frac{\\operatorname{ln}⁡(x)}{2{x}^{2}}-\\frac{1}{4{x}^{2}}+C \\\\  & =-\\frac{1}{4{x}^{2}}(2{ln}^{2}⁡(x)+2\\operatorname{ln}⁡(x)+1)+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069272 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39f8e453-5b4e-5424-8df3-89ef36cde644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186317752} {:answer/id #uuid "3b9175b7-617f-57a3-af8d-919ed2b0db92" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{3}" :db/id #edb/ref 17592186317756} {:answer/id #uuid "8e503817-bf60-566b-9a9f-488b451dfc84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186318048} {:answer/id #uuid "d442f1af-21b6-52b3-b5fa-b7866251aa30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186318271} {:answer/id #uuid "e402728a-9968-5173-84f1-7ebaf6de023f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186318325}] :answer-field/correct {:answer/id #uuid "39f8e453-5b4e-5424-8df3-89ef36cde644" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186317752} :answer-field/id #uuid "8e636a51-398f-568c-9040-f35409919a73" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318739}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a9bdc8c8-a628-5a28-9c53-49f974293c50" :question/math-academy-id "q-3471" :question/problem "The curve $y=\\frac{1}{x}$ intersects the line $4y-5x=8$ at the points $(p,q)$ and $(r,s).$ What is $p+q+r+s?$" :question/worked-solution "First, we solve for $y$ in the second curve:\n\n$$\n\\begin{aligned}4y-5x & =8 \\\\ 4y & =5x+8 \\\\ y & =\\frac{5x+8}{4}\\end{aligned}\n$$\n\nNow, we need to solve the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}y &=\\frac{1}{x} \\\\ y &=\\frac{5x+8}{4}\\end{aligned}\\right.\n$$\n\nSetting the equations equal to one another and solving, we get:\n\n$$\n\\begin{aligned}\\frac{1}{x} & =\\frac{5x+8}{4} \\\\ 4 & =5{x}^{2}+8x \\\\ 5{x}^{2}+8x-4 & =0 \\\\ (x+2)(5x-2) & =0 \\\\ x & =-2,\\frac{2}{5}\\end{aligned}\n$$\n\nSo, the $x$-coordinates of the intersection points are $x=-2$ and $x=\\frac{2}{5}.$ To find the $y$-coordinates of the intersection points, we plug these values into either curve. Let's choose the first equation.\n\n- Substituting $x=-2,$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{x} \\\\  & =\\frac{1}{(-2)} \\\\  & =-\\frac{1}{2},\\end{aligned}\n$$\n\nso one point of intersection is $(-2,-\\frac{1}{2}).$\n\n- Substituting $x=\\frac{2}{5},$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{x} \\\\  & =\\frac{1}{(\\frac{2}{5})} \\\\  & =\\frac{5}{2},\\end{aligned}\n$$\n\nso the other point of intersection is $(\\frac{2}{5},\\frac{5}{2}).$\n\nTherefore, the points of intersection are $(-2,-\\frac{1}{2})$ and $(\\frac{2}{5},\\frac{5}{2}).$\n\nFinally, if we let $p=-2,q=-\\frac{1}{2},r=\\frac{2}{5}$ and $s=\\frac{5}{2},$ then\n\n$$\np+q+r+s=-2-\\frac{1}{2}+\\frac{2}{5}+\\frac{5}{2}=\\frac{2}{5}.\n$$\n\nA sketch of the situation is shown below.\n\n![](images/d9/d995288e573a22db67c7d4c82c1a12bcbb41fd880f706b9fb62062aa90e2d5ba.png)"} {:db/id #edb/ref 17592186069280 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "007b91fd-0208-5679-b5fe-fa22c342e75f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186321153} {:answer/id #uuid "3368f1e3-98c0-5261-aa21-48d166e11a19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186321538} {:answer/id #uuid "761f6596-b597-5361-bb0b-33d58b1def52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186322069} {:answer/id #uuid "781eea9a-f451-5fca-a57e-50cf1742191a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186322089} {:answer/id #uuid "b79ea02d-ceff-5db7-a3cb-33138c13e411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186322576}] :answer-field/correct {:answer/id #uuid "b79ea02d-ceff-5db7-a3cb-33138c13e411" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186322576} :answer-field/id #uuid "2be73838-0ceb-51ce-826e-d583ed8f7816" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323262}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "058124fc-5b28-578d-8127-f08cc51043ef" :question/math-academy-id "q-3547" :question/problem "Solve for $b$ where $\\frac{5b+8}{12{b}^{2}}=-\\frac{12}{36b}+\\frac{4b+8}{12{b}^{2}}.$" :question/worked-solution "We note that $b=0$ cannot be a solution since division by $0$ is undefined.\n\nThe equation has the denominators $36b$ and $12{b}^{2}.$ So first, we find the least common multiple (or $\\text{LCM}$) of the denominators. We find that\n\n$$\n\\text{LCM}(36b,12{b}^{2})=36{b}^{2}.\n$$\n\nSo, we multiply both sides of the equation by $36{b}^{2},$ and simplify:\n\n$$\n\\begin{aligned}\\frac{5b+8}{12{b}^{2}} & =-\\frac{12}{36b}+\\frac{4b+8}{12{b}^{2}} \\\\ 36{b}^{2}\\cdot (\\frac{5b+8}{12{b}^{2}}) & =36{b}^{2}\\cdot (-\\frac{12}{36b}+\\frac{4b+8}{12{b}^{2}}) \\\\ 36{b}^{2}\\cdot (\\frac{5b+8}{12{b}^{2}}) & =36{b}^{2}\\cdot (-\\frac{12}{36b})+36{b}^{2}\\cdot (\\frac{4b+8}{12{b}^{2}}) \\\\ 3\\cdot 12{b}^{2}\\cdot (\\frac{5b+8}{12{b}^{2}}) & =b\\cdot 36b\\cdot (-\\frac{12}{36b})+3\\cdot 12{b}^{2}\\cdot (\\frac{4b+8}{12{b}^{2}}) \\\\ 3\\cdot \\cancel{12{b}^{2}}\\cdot (\\frac{5b+8}{\\cancel{12{b}^{2}}}) & =b\\cdot \\cancel{36b}\\cdot (-\\frac{12}{\\cancel{36b}})+3\\cdot \\cancel{12{b}^{2}}\\cdot (\\frac{4b+8}{\\cancel{12{b}^{2}}}) \\\\ 3(5b+8) & =-12b+3(4b+8)\\end{aligned}\n$$\n\nWe now have a linear equation in $b,$ and we can solve this using the addition and multiplication principles:\n\n$$\n\\begin{aligned}3(5b+8) & =-12b+3(4b+8) \\\\ 15b+24 & =-12b+12b+24 \\\\ 15b+24 & =24 \\\\ 15b & =24-24 \\\\ 15b & =0 \\\\ b & =0\\end{aligned}\n$$\n\nFinally, we recall that we cannot allow $b=0$ as a solution. Since $b=0,$ we conclude that there is no solution."} {:db/id #edb/ref 17592186069281 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cf60cc0-0176-5d63-a5ad-319ac2ffdc3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\arccos (\\frac{x - 3}{2}) + C" :db/id #edb/ref 17592186066857} {:answer/id #uuid "c2591fd8-b4ad-5d49-a54d-d43929caa1e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\arcsin (x - 3) + C" :db/id #edb/ref 17592186066858} {:answer/id #uuid "3f3b3048-1124-5408-9ff7-320533431cc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\arcsin (\\frac{x + 3}{3}) + C" :db/id #edb/ref 17592186066859} {:answer/id #uuid "4f9cdc08-13d8-59d4-8bac-3a3fb9f2ea8c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\arcsin (x + 3) + C" :db/id #edb/ref 17592186066860} {:answer/id #uuid "7d6e9b82-e96d-5952-ae17-b152a68e5fc3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\arccos (x + 3) + C" :db/id #edb/ref 17592186066861}] :answer-field/id #uuid "55e38742-513f-52eb-bbd2-eb1d8093f1c9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066856}] :question/id #uuid "567f832d-7383-5daa-9fd7-bc7519727ba1" :question/math-academy-id "q-3591" :question/problem "What is $\\displaystyle \\int\\frac{1}{\\sqrt{-8 + 6x - x^{2}}}dx$?"} {:db/id #edb/ref 17592186069282 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "67c3a1db-119e-5acf-9a09-e1b123cb6a89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(x+2)+C" :db/id #edb/ref 17592186321958} {:answer/id #uuid "6ae0275c-cc30-50ee-b708-ba1496f49e5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡(\\frac{x-2}{3})+C" :db/id #edb/ref 17592186321982} {:answer/id #uuid "8a37ad44-5363-5c8a-9452-384bf55bfec2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x+2}{\\sqrt{3}})+C" :db/id #edb/ref 17592186322250} {:answer/id #uuid "c0b212eb-1b6b-52f4-856b-b6d2907bae74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(x-2)+C" :db/id #edb/ref 17592186322646} {:answer/id #uuid "fbe4dd98-fdc8-542c-8023-a647e8bbcf6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x-2}{\\sqrt{3}})+C" :db/id #edb/ref 17592186323136}] :answer-field/correct {:answer/id #uuid "fbe4dd98-fdc8-542c-8023-a647e8bbcf6a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x-2}{\\sqrt{3}})+C" :db/id #edb/ref 17592186323136} :answer-field/id #uuid "26cc15b6-f5cf-5aac-b6f5-1e3c4c37f90f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323243}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "87d8f51d-ee05-5977-8eb0-8be27f9cb800" :question/math-academy-id "q-3596" :question/problem "$\\int \\frac{1}{{x}^{2}-4x+7}\\text{d}x=$" :question/worked-solution "First, we complete the square in the denominator:\n\n$$\n\\begin{aligned}{x}^{2}-4x+7 & ={x}^{2}-2\\cdot 2x+({2}^{2}-{2}^{2})+7 \\\\  & =({x}^{2}-2\\cdot 2x+{2}^{2})-4+7 \\\\  & =(x-2)^{2}+3\\end{aligned}\n$$\n\nSubstituting the above into the denominator, we get\n\n$$\n\\begin{aligned}\\int \\frac{1}{{x}^{2}-4x+7}\\,\\text{d}x & =\\int \\frac{1}{(x-2)^{2}+3}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{1+((x-2)/\\sqrt{3})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nThis resembles the basic integral for inverse tangent:\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $(\\frac{x-2}{\\sqrt{3}}).$\n\nSo, let's perform the substitution\n\n$$\nu=\\frac{x-2}{\\sqrt{3}}.\n$$\n\nDifferentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nFinally, we write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{{x}^{2}-4x+7}\\,\\text{d}x & =\\frac{1}{3}\\int \\frac{1}{1+((x-2)/\\sqrt{3})^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{1}{1+{u}^{2}}\\cdot \\sqrt{3}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\frac{x-2}{\\sqrt{3}})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069283 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c8edcdc-8f1c-51c2-bbb5-0e9493ab87c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}arcsec(x + 3) + C" :db/id #edb/ref 17592186066869} {:answer/id #uuid "b6844ac0-a966-53fc-be83-d306677a8eb4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arcsec(x - 2) + C" :db/id #edb/ref 17592186066870} {:answer/id #uuid "fa2b0b46-a229-5aff-94f5-75873e2dcacb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arcsec(x + 2) + C" :db/id #edb/ref 17592186066871} {:answer/id #uuid "1f2b6cc8-ec18-57b5-b67e-f5bf938fc06b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}arcsec(2x - 4) + C" :db/id #edb/ref 17592186066872} {:answer/id #uuid "30330287-bf74-50f2-bc68-0fbb07832428" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "arcsec(\\frac{x - 2}{2}) + C" :db/id #edb/ref 17592186066873}] :answer-field/id #uuid "6d426217-2e59-5f50-b1e1-d35750ae76fd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186066868}] :question/id #uuid "86c8cc54-dfe9-514c-942f-b0ac5d0ada71" :question/math-academy-id "q-3597" :question/problem "What is $\\displaystyle \\int\\frac{1}{\\mid x - 2 \\mid \\sqrt{x^{2} - 4x + 3}}dx$?"} {:db/id #edb/ref 17592186069288 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "152b9b90-2369-58a8-81aa-4d8afdc8db6d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡(2{x}^{2}-6x+9)-5\\operatorname{ln}⁡|x-4|+K" :db/id #edb/ref 17592186321319} {:answer/id #uuid "4d157c35-4de2-5ea9-ac5a-0dc538c67393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|x-4|+\\frac{2}{5}\\operatorname{ln}⁡(2{x}^{2}-6x+9)+K" :db/id #edb/ref 17592186321756} {:answer/id #uuid "58b14230-2948-5c88-9c68-1caa5b9a5b1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "25\\operatorname{ln}⁡(2{x}^{2}-6x+9)-10\\operatorname{ln}⁡|x-4|+K" :db/id #edb/ref 17592186321844} {:answer/id #uuid "5b160e16-6f6c-54d6-abb8-f7a49ab67f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡(2{x}^{2}-6x+9)-5\\operatorname{ln}⁡|x-4|+K" :db/id #edb/ref 17592186321865} {:answer/id #uuid "bea1fd27-c40f-5dbb-a78f-1c5fa4e8ae12" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\operatorname{ln}⁡|x-4|-\\frac{2}{5}\\operatorname{ln}⁡(2{x}^{2}-6x+9)+K" :db/id #edb/ref 17592186322630}] :answer-field/correct {:answer/id #uuid "5b160e16-6f6c-54d6-abb8-f7a49ab67f1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡(2{x}^{2}-6x+9)-5\\operatorname{ln}⁡|x-4|+K" :db/id #edb/ref 17592186321865} :answer-field/id #uuid "5dcf6ee9-5e88-5b9b-aa22-7d6ea3f8eae6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323355}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "731b8f94-fb6c-56e8-9abe-5ac794eb1b1e" :question/math-academy-id "q-3638" :question/problem "Evaluate $\\int \\frac{15-25x}{(2{x}^{2}-6x+9)(x-4)}\\,\\text{d}x.$" :question/requires-calculator true :question/worked-solution "Notice that the quadratic factor in the denominator has a negative discriminant:\n\n$$\nD=(-6)^{2}-4(2)(9)=-36<0\n$$\n\nSo, we proceed with the following partial fraction decomposition:\n\n$$\n\\frac{15-25x}{(2{x}^{2}-6x+9)(x-4)}=\\frac{Ax+B}{2{x}^{2}-6x+9}+\\frac{C}{x-4}\n$$\n\nTo determine the coefficients $A,B,$ and $C,$ we first multiply both sides of the above equation by $(2{x}^{2}-6x+9)(x-4),$ and we get\n\n$$\n15-25x=(Ax+B)(x-4)+C(2{x}^{2}-6x+9).\n$$\n\nSolving for the unknown constants using the usual methods, we get $A=10,B=-15$ and $C=-5.$ Therefore,\n\n$$\n\\frac{15-25x}{(2{x}^{2}-6x+9)(x-4)}=\\frac{10x-15}{2{x}^{2}-6x+9}+\\frac{-5}{x-4}.\n$$\n\nWe now integrate this function term by term, adding the constant of integration at the very end.\n\n$$\n\\begin{aligned}\\int \\frac{15-25x}{(2{x}^{2}-6x+9)(x-4)}\\,\\text{d}x & =\\int (\\frac{10x-15}{2{x}^{2}-6x+9}+\\frac{-5}{x-4})\\,\\text{d}x \\\\  & =5\\int \\frac{2x-3}{2{x}^{2}-6x+9}\\,\\text{d}x-5\\int \\frac{1}{x-4}\\,\\text{d}x\\end{aligned}\n$$\n\nFor the first integral, we use the substitution $u=2{x}^{2}-6x+9.$ Then $\\text{d}u=(4x-6)\\,\\text{d}x,$ and we get\n\n$$\n\\begin{aligned}\\int \\frac{2x-3}{2{x}^{2}-6x+9}\\,\\text{d}x & =\\int (\\frac{1}{u})\\frac{\\text{d}u}{2} \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|u| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡|2{x}^{2}-6x+9| \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(2{x}^{2}-6x+9).\\end{aligned}\n$$\n\nFor the second integral, we have\n\n$$\n\\int \\frac{1}{x-4}\\,\\text{d}x=\\operatorname{ln}⁡|x-4|.\n$$\n\nSo, we get the following result:\n\n$$\n\\begin{aligned}\\int \\frac{15-25x}{(2{x}^{2}-6x+9)(x-4)}\\,\\text{d}x & =5\\int \\frac{2x-3}{2{x}^{2}-6x+9}\\,\\text{d}x-5\\int \\frac{1}{x-4}\\,\\text{d}x \\\\  & =5(\\frac{1}{2}\\operatorname{ln}⁡(2{x}^{2}-6x+9))-5\\operatorname{ln}⁡|x-4|+K \\\\  & =\\frac{5}{2}\\operatorname{ln}⁡(2{x}^{2}-6x+9)-5\\operatorname{ln}⁡|x-4|+K\\end{aligned}\n$$"} {:db/id #edb/ref 17592186069359 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91cc6bff-bd18-5280-83a4-e7dbf9ad8a74" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186067325} {:answer/id #uuid "a560cedf-65a1-57de-a798-66fc0b24aa41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186067326} {:answer/id #uuid "ad0201e7-5344-5214-9314-c50d4bd8991f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186067327} {:answer/id #uuid "3d17f21a-7d9d-58cb-ba42-b3e18af5a3ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186067328} {:answer/id #uuid "6804ddcd-4e86-5fab-82fb-154503af9046" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186067329}] :answer-field/id #uui