swer/value "6" :db/id #edb/ref 17592186336512} {:answer/id #uuid "46863dc5-85a6-5f74-b07a-395c884b21c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186336686} {:answer/id #uuid "cc073af2-ce94-51b6-9620-4721296451cd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186337822} {:answer/id #uuid "e0bd5231-b4ba-55f8-840d-4883556a842d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337994}] :answer-field/correct {:answer/id #uuid "e0bd5231-b4ba-55f8-840d-4883556a842d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337994} :answer-field/id #uuid "dbc5ca9d-1270-51e9-8a5b-a7cb066ec78d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338664}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c0a3ab5c-4820-575a-9c45-dc5563c40e29" :question/math-academy-id "q-71530" :question/problem "Suppose $|\\,p\\,|=3\\sqrt{2}$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{\\pi }{4}.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =3\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =3\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2af732f3-b0dc-5793-a81b-2631dc11f520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\text{ arcsec }x+C" :db/id #edb/ref 17592186336435} {:answer/id #uuid "733c5a21-c647-52ab-a919-8a80bbbead81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\text{ arcsin }x+C" :db/id #edb/ref 17592186337069} {:answer/id #uuid "75c8a2d2-a396-596b-8050-fe63de4a5851" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\text{ arctan }x+C" :db/id #edb/ref 17592186337091} {:answer/id #uuid "95948138-a8a6-5445-b9c9-fdd287efee17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\text{ arctan }x+C" :db/id #edb/ref 17592186337398} {:answer/id #uuid "e59b54b8-9fef-5db5-8ace-2e476c52cf06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\text{ arcsec }x+C" :db/id #edb/ref 17592186338036}] :answer-field/correct {:answer/id #uuid "e59b54b8-9fef-5db5-8ace-2e476c52cf06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9\\text{ arcsec }x+C" :db/id #edb/ref 17592186338036} :answer-field/id #uuid "9f257272-2f12-50ae-a6fd-7184a295f711" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338567}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c37f5da7-d3e9-5087-b956-7bcf82e01ec3" :question/math-academy-id "q-71775" :question/problem "If ${f}^{′}(x)=\\frac{9}{|x|\\sqrt{{x}^{2}-1}},$ then $f(x)=$" :question/worked-solution "Recall that\n\n$$\n\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\text{arcsec}\\,x.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x)=\\int {f}^{′}(x)\\,\\text{d}x & =\\int (\\frac{9}{|x|\\sqrt{{x}^{2}-1}})\\text{d}x \\\\  & =\\int \\frac{9}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =9\\int \\frac{1}{|x|\\sqrt{{x}^{2}-1}}\\,\\text{d}x \\\\  & =9\\text{ arcsec }x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339000 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0b97a6b-e1ff-50f5-ab1f-37b3ab282c83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}q" :db/id #edb/ref 17592186337742} {:answer/id #uuid "c2e7480f-dbd5-5885-8503-7a72787be86f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2q" :db/id #edb/ref 17592186337763} {:answer/id #uuid "d0bdf6fc-3892-5112-a046-b04e54d7df85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}q" :db/id #edb/ref 17592186337858} {:answer/id #uuid "d0d3c6c7-ecd4-50be-8fef-f7432eaa4b10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}q" :db/id #edb/ref 17592186337860} {:answer/id #uuid "d629248a-72f1-5ef2-a0a0-24852eab0c8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}q" :db/id #edb/ref 17592186337897}] :answer-field/correct {:answer/id #uuid "d629248a-72f1-5ef2-a0a0-24852eab0c8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}q" :db/id #edb/ref 17592186337897} :answer-field/id #uuid "d281a134-374b-5aef-8d0d-6fbd0b5e1009" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338649}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47b269c9-2c28-5ab1-9f15-6a708a836ca9" :question/math-academy-id "q-71835" :question/problem "Suppose that $|\\,p\\,|=8$, $|\\,q\\,|=4$ and that the angle between the vectors is $\\theta =\\frac{\\pi }{4}.$ Find the vector projection of $p$ onto $q$ in terms of the vector $q.$" :question/worked-solution "First, we find the scalar projection as follows:\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =8\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =4\\sqrt{2}\\end{aligned}\n$$\n\nNow, we find the unit vector that is parallel to $q:$\n\n$$\nu=\\frac{q}{|\\,q\\,|}=\\frac{q}{4}=\\frac{1}{4}q\n$$\n\nFinally, we compute the vector projection as follows:\n\n$$\n\\begin{aligned}{\\text{proj}}_{b}\\,p & ={\\text{comp}}_{q}\\,p\\cdot u \\\\  & =4\\sqrt{2}\\cdot \\frac{1}{4}q \\\\  & =\\sqrt{2}q\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18b1a026-0c8e-5be6-adb1-b801d9462350" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{\\pi \\text{i}/4}" :db/id #edb/ref 17592186336261} {:answer/id #uuid "6b815872-9150-5fbc-857f-7f8878fc0406" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/2}" :db/id #edb/ref 17592186336982} {:answer/id #uuid "ae2f5c7d-8fc0-5b07-9d5b-195b41b0ea1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/2}" :db/id #edb/ref 17592186337595} {:answer/id #uuid "ae59604e-758d-5ce6-92bf-5957adffda25" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/4}" :db/id #edb/ref 17592186337597} {:answer/id #uuid "e45cdb94-229c-56a8-9e36-06a47e7f880e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/4}" :db/id #edb/ref 17592186338022}] :answer-field/correct {:answer/id #uuid "e45cdb94-229c-56a8-9e36-06a47e7f880e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/4}" :db/id #edb/ref 17592186338022} :answer-field/id #uuid "2cc68346-3208-5592-a11e-7e16cd3cadd8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338358}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44f829a5-c105-55cc-8692-b54dc70c107f" :question/math-academy-id "q-71972" :question/problem "![](images/a0/a0d3f6646cb3a1faa99ba07e76956faf9be1c6f117191c539aae63e3fc1a2ee1.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." :question/worked-solution "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =2+2\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+{2}^{2}} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $z$ lies in the first quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(1) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{2}$ and $\\theta =\\frac{\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=2\\sqrt{2}\\,{\\text{e}}^{\\pi \\text{i}/4}.\n$$"} {:db/id #edb/ref 17592186339033 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68df4ce4-7b4c-5e9c-8971-c2ebb0327320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{4\\pi \\text{i}/3}" :db/id #edb/ref 17592186336966} {:answer/id #uuid "81c90edc-c237-58b1-99e4-32f3439329d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186337212} {:answer/id #uuid "954ed73e-542a-5e76-a0d5-ab5936848fc1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\,{\\text{e}}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186337396} {:answer/id #uuid "d3200542-63c9-542a-b4fa-3a305e3f0daa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}" :db/id #edb/ref 17592186337877} {:answer/id #uuid "f89bb0ec-5438-5500-941a-c85a89ff1e15" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{4\\pi \\text{i}/3}" :db/id #edb/ref 17592186338210}] :answer-field/correct {:answer/id #uuid "81c90edc-c237-58b1-99e4-32f3439329d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186337212} :answer-field/id #uuid "f557b58a-3824-50b5-98d1-b94b8a347248" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338708}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "44bd86e8-5f62-5bc0-b074-fc3bcd405c3c" :question/math-academy-id "q-71977" :question/problem "![](images/a0/a02f84856db56412060d6f376f3d926e3fb05581ee36ef9b5e4d2cc570e8438d.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." :question/worked-solution "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-\\sqrt{3}-\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-\\sqrt{3})}^{2}+(-1)^{2}} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $z$ lies in the third quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi +|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{-1}{-\\sqrt{3}})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}})| \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$\n\nFinally, substituting $r=2$ and $\\theta =\\frac{7\\pi }{6}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=2\\,{\\text{e}}^{7\\pi \\text{i}/6}.\n$$"} {:db/id #edb/ref 17592186339034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "104e3006-d3a6-5943-b960-4fc26ccc0775" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\sqrt{3}\\,{\\text{e}}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186336185} {:answer/id #uuid "48e092bf-cba4-5a3c-8a77-c83349f80761" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186336709} {:answer/id #uuid "925512aa-b662-5d52-a43e-43e72f39de57" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{7\\pi \\text{i}/4}" :db/id #edb/ref 17592186337361} {:answer/id #uuid "bcae6fb2-56b5-5b2d-9294-f949c5b05c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186337711} {:answer/id #uuid "fbeb787b-6f45-55c2-9d88-54fe66eb199b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{5\\pi \\text{i}/3}" :db/id #edb/ref 17592186338244}] :answer-field/correct {:answer/id #uuid "bcae6fb2-56b5-5b2d-9294-f949c5b05c85" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}" :db/id #edb/ref 17592186337711} :answer-field/id #uuid "6008bb85-5b57-5579-9250-2b4fcfa665b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338443}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "8bd2c718-1e1f-5805-84c5-97c49ff95cca" :question/math-academy-id "q-71979" :question/problem "Write the complex number $z=3-\\text{i}\\sqrt{3}$ in exponential form." :question/requires-calculator true :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{3}^{2}+{(-\\sqrt{3})}^{2}} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})| \\\\  & =2\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{11\\pi }{6}.\\end{aligned}\n$$\n\nFinally, substituting $r=2\\sqrt{3}$ and $\\theta =\\frac{11\\pi }{6}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\sqrt{3}\\,{\\text{e}}^{11\\pi \\text{i}/6}.\n$$"} {:db/id #edb/ref 17592186339035 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07fbe631-b6ca-5a02-9887-621761e1d977" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186336098} {:answer/id #uuid "21429edd-1977-51a1-bcfd-f43edb6488b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186336341} {:answer/id #uuid "6702c7dc-5c67-5f1c-800b-a01eb18a4c95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\sqrt{2}\\,{\\text{e}}^{4\\pi \\text{i}/3}" :db/id #edb/ref 17592186336951} {:answer/id #uuid "9d76044f-ef19-533b-b862-ccd1b90bfdca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{4\\pi \\text{i}/3}" :db/id #edb/ref 17592186337456} {:answer/id #uuid "f5353090-574e-5ac6-a153-11a0a199d745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{3\\pi \\text{i}/2}" :db/id #edb/ref 17592186338179}] :answer-field/correct {:answer/id #uuid "21429edd-1977-51a1-bcfd-f43edb6488b8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{7\\pi \\text{i}/6}" :db/id #edb/ref 17592186336341} :answer-field/id #uuid "3a8d5a57-b7eb-58b3-8451-9d9034857290" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338382}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fd4f08ef-f217-5a8d-81c9-9cd07c79c277" :question/math-academy-id "q-71981" :question/problem "Write the complex number $z=-\\sqrt{3}-\\text{i}$ in exponential form." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-\\sqrt{3})}^{2}+(-1)^{2}} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $z$ lies in the third quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi +|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{-1}{-\\sqrt{3}})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}})| \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$\n\nFinally, substituting $r=2$ and $\\theta =\\frac{7\\pi }{6}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=2\\,{\\text{e}}^{7\\pi \\text{i}/6}.\n$$"} {:db/id #edb/ref 17592186339036 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19ba13a7-a8af-592d-b200-b237e09d7313" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=3\\,{\\text{e}}^{3\\pi \\text{i}/4}" :db/id #edb/ref 17592186336269} {:answer/id #uuid "3f18755a-6590-52bf-825a-3181c701a71d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186336625} {:answer/id #uuid "74eb7548-5b21-5ab1-b315-9aba5080f6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337086} {:answer/id #uuid "a7fb877f-dfa1-5ad1-a96d-bc31e563bd26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{5\\pi \\text{i}/6}" :db/id #edb/ref 17592186337551} {:answer/id #uuid "ce965180-c460-5735-ba71-a16c78ddb8a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337839}] :answer-field/correct {:answer/id #uuid "74eb7548-5b21-5ab1-b315-9aba5080f6e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "z=4\\,{\\text{e}}^{2\\pi \\text{i}/3}" :db/id #edb/ref 17592186337086} :answer-field/id #uuid "2137d245-5e38-588c-bf3d-27b3cfc9ed11" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338340}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a3bc38ff-6706-540c-bfc8-3a2f9e0a0e13" :question/math-academy-id "q-71982" :question/problem "Write the complex number $z=-2+2\\sqrt{3}\\,\\text{i}$ in exponential form." :question/worked-solution "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+{(2\\sqrt{3})}^{2}} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $z$ lies in the second quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\frac{2\\sqrt{3}}{2})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\sqrt{3})| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nFinally, substituting $r=4$ and $\\theta =\\frac{2\\pi }{3}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=4\\,{\\text{e}}^{2\\pi \\text{i}/3}.\n$$"} {:db/id #edb/ref 17592186339084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3906178d-d2b9-5c1e-8874-62464ff4587d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1+\\sqrt{2}" :db/id #edb/ref 17592186336568} {:answer/id #uuid "485ed612-6290-5d86-b376-ce0eb70b3fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\sqrt{2}" :db/id #edb/ref 17592186336705} {:answer/id #uuid "51a463d3-0093-55d7-a2ee-8312594e1a86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186336780} {:answer/id #uuid "87045c5e-f1ca-5e3e-850f-ac86db303947" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186337253} {:answer/id #uuid "9ea3d299-fb71-5298-b534-c642be602e95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186337466}] :answer-field/correct {:answer/id #uuid "485ed612-6290-5d86-b376-ce0eb70b3fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\sqrt{2}" :db/id #edb/ref 17592186336705} :answer-field/id #uuid "1eab19eb-a5c0-56fa-880c-7541dcfdcaf1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338334}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "2290a5a5-423d-532e-a1cb-06c374bf7c6e" :question/math-academy-id "q-72268" :question/problem "Evaluate the double integral ${∬}_{D}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}A,$ where \n$D=\\{(x,y)\\,:\\,0\\le x\\le \\frac{\\pi }{2},\\,0\\le y\\le \\frac{\\pi }{4}\\}.$" :question/worked-solution "First, we express our double integral as a repeated integral:    \n\n$$\n\\begin{aligned}{∬}_{D}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}A & ={\\int }_{0}^{\\pi /4}[{\\int }_{0}^{\\pi /2}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}x]\\text{d}y\\end{aligned}\n$$\n\nNow, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}[{\\int }_{0}^{\\pi /2}2\\operatorname{sin}⁡y\\operatorname{cos}⁡x\\,\\text{d}x]\\text{d}y & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y\\,[\\operatorname{sin}⁡x]_{0}^{\\pi /2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y(\\operatorname{sin}⁡(\\frac{\\pi }{2})-\\operatorname{sin}⁡(0))\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y(1-0)\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y\\,\\text{d}y\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}2\\operatorname{sin}⁡y\\,\\text{d}y & =-2[\\operatorname{cos}⁡y]_{0}^{\\pi /4} \\\\  & =-2(\\operatorname{cos}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(0)) \\\\  & =-2\\cdot \\frac{\\sqrt{2}}{2}-2\\cdot (-1) \\\\  & =2-\\sqrt{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2905b3c7-5120-5928-8659-ab7cf49215cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336415} {:answer/id #uuid "9c9f02de-6945-5986-9bd6-77c4fda53a38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337447} {:answer/id #uuid "c4c17bce-f321-5a5a-b8a2-e2f57aa0f0a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337781} {:answer/id #uuid "d1424795-2c4b-569b-984c-33e713fb9a2d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337866} {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162}] :answer-field/correct {:answer/id #uuid "f3baaf2a-856c-5b97-ba7e-56d8806079c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186338162} :answer-field/id #uuid "1d342821-bbce-5fd1-b3bb-822b8446cf81" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338330}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "83ace1c9-0a10-59aa-bb99-7a86a6dbfa17" :question/math-academy-id "q-72333" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡x=-\\infty $ and ${lim}_{x\\to {0}^{+}}{e}^{1/x}=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡x]^{′}}{[{e}^{1/x}]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{{e}^{1/x}(-\\frac{1}{{x}^{2}})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{{e}^{1/x}\\cdot {x}^{-2}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{x}{{e}^{1/x}} \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339091 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21d77a93-af57-5abb-8f97-29ac2ca5d216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336348} {:answer/id #uuid "67912699-7231-5c85-81fc-c774efe21db8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186336956} {:answer/id #uuid "a24a093a-4a10-53da-8a31-41da6e3952e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186337505} {:answer/id #uuid "d20fbb17-4105-57b9-9e4e-afbf7bfe0c89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337872} {:answer/id #uuid "e3ffad50-443d-59eb-ad44-76721b0d692c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186338021}] :answer-field/correct {:answer/id #uuid "a24a093a-4a10-53da-8a31-41da6e3952e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186337505} :answer-field/id #uuid "5a96e9e3-c5a2-5aed-87c1-a11f5fde3b60" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338433}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "32f3c869-0ed2-55fc-8f3f-7b188384b842" :question/math-academy-id "q-72335" :question/problem "${lim}_{x\\to 0}\\frac{{e}^{2/{x}^{2}}}{(\\frac{1}{2{x}^{2}})}=$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}{e}^{2/{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}\\frac{1}{2{x}^{2}}=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{2/{x}^{2}}}{(\\frac{1}{2{x}^{2}})} & ={lim}_{x\\to 0}\\frac{{[{e}^{2/{x}^{2}}]}^{′}}{{[\\frac{1}{2{x}^{2}}]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{e}^{2/{x}^{2}}(-\\frac{4}{{x}^{3}})}{(-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to 0}\\frac{4{e}^{2/{x}^{2}}\\cancel{(-\\frac{1}{{x}^{3}})}}{\\cancel{(-\\frac{1}{{x}^{3}})}} \\\\  & =4{lim}_{x\\to 0}{e}^{2/{x}^{2}} \\\\  & =\\infty .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339092 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dd6dd70-5f78-54b6-ac97-950f2f384aef" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336473} {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} {:answer/id #uuid "5b538add-4209-5721-8b56-652729cc391f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186336862} {:answer/id #uuid "7d7564a4-f738-5faf-a2c3-bdd625a0ef99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186337163} {:answer/id #uuid "bb83b45c-700e-5a49-955e-7ea35708e865" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186337697}] :answer-field/correct {:answer/id #uuid "4e08260e-b4f6-5c7a-ad2d-8294f523a3ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186336757} :answer-field/id #uuid "64250102-7382-5959-9fea-4e5f4501809d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338454}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d0dae206-0030-50d7-a470-3e9d541986a9" :question/math-academy-id "q-72336" :question/problem "Evaluate ${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}-1)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{2}}]}^{′}}{{[\\frac{1}{{x}^{4}}-1]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{2}{{x}^{3}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{-3}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{2} \\\\  & =0.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339093 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d068af1-5717-50f9-98dd-688a202e224e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336300} {:answer/id #uuid "9776818d-6d25-54e4-a20d-e79199cc2aad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186337414} {:answer/id #uuid "ab2a4700-b08b-5628-83cf-d16c711a2e5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337578} {:answer/id #uuid "c44a2cc7-2ec0-5efa-8bda-75dbe3460520" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186337777} {:answer/id #uuid "c6c6f9fc-2923-5efc-a066-acf8386c9d66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186337794}] :answer-field/correct {:answer/id #uuid "1d068af1-5717-50f9-98dd-688a202e224e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186336300} :answer-field/id #uuid "5219204f-5acb-519a-b83e-7a3a43278127" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338418}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8c9a1b2b-318e-5496-aa9a-d554d802f8d1" :question/math-academy-id "q-72338" :question/problem "${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{6}})}{(\\frac{1}{{x}^{4}}+8)}=$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{6}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}+8)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{6}})}{(\\frac{1}{{x}^{4}}+8)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{6}}]}^{′}}{{[\\frac{1}{{x}^{4}}+8]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{6}{{x}^{7}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{6{x}^{-7}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{3}{2{x}^{2}} \\\\  & =\\infty .\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339100 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "181818f9-ee5d-570b-8805-3453bec6da26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{(1+{x}^{5})^{3}}+C" :db/id #edb/ref 17592186336257} {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} {:answer/id #uuid "601c5f25-3385-59f3-b9ec-6f4783410687" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{1+{x}^{5}}}{2}+C" :db/id #edb/ref 17592186336901} {:answer/id #uuid "d13e9d9a-a682-5a93-b274-9657dd12c702" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186337864} {:answer/id #uuid "e2d6ab9a-d942-55d2-8674-766bbfa15318" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{(1+{x}^{5})^{3}}}{2}+C" :db/id #edb/ref 17592186338008}] :answer-field/correct {:answer/id #uuid "324b72d3-41e0-5026-af58-5b34dc0551ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{1+{x}^{5}}+C" :db/id #edb/ref 17592186336509} :answer-field/id #uuid "1287170e-aae1-5d7e-9ef3-ec229bb6713f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338307}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "94a2c36c-7f20-5b89-950f-742f856d9127" :question/math-academy-id "q-72382" :question/problem "Calculate $\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x.$" :question/worked-solution "We note that $5{x}^{4}$ is the derivative of the quantity in the radical. So we make a substitution\n\n$$\nu=1+{x}^{5}.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\,\\text{d}x,\\end{aligned}\n$$\n\nand rewriting our integral, we get\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{1+{x}^{5}}}\\,5{x}^{4}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\int \\frac{1}{{u}^{1/2}}\\,\\text{d}u \\\\  & =\\int {u}^{-1/2}\\,\\text{d}u.\\end{aligned}\n$$\n\nWe can now solve the integral using the power rule:\n\n$$\n\\begin{aligned}\\int {u}^{-1/2}\\,\\text{d}u & =\\frac{{u}^{1/2}}{(\\frac{1}{2})}+C \\\\  & =2{u}^{1/2}+C \\\\  & =2\\sqrt{u}+C\\end{aligned}\n$$\n\nLastly, we substitute $u=1+{x}^{5}$ back in the expression. So the final result is\n\n$$\n\\begin{aligned}\\int \\frac{5{x}^{4}}{\\sqrt{1+{x}^{5}}}\\,\\text{d}x & =2\\sqrt{1+{x}^{5}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339111 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a0d85b8-3324-57f7-a467-f401be804083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(5x-7)^{3}}+C" :db/id #edb/ref 17592186336578} {:answer/id #uuid "75e6122b-2104-52f4-b814-dae601247c06" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{(5x-7)^{3}}+C" :db/id #edb/ref 17592186337093} {:answer/id #uuid "8b91db05-c595-568e-b4ad-f97b5c3c6882" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{(5x-7)^{3}}+C" :db/id #edb/ref 17592186337295} {:answer/id #uuid "aaed332c-7186-53b8-802e-6557581b75af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{(5x-7)^{3}}+C" :db/id #edb/ref 17592186337573} {:answer/id #uuid "d9ae619c-f25b-53f5-8b0f-30595a2ff518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{15}{(5x-7)^{3}}+C" :db/id #edb/ref 17592186337926}] :answer-field/correct {:answer/id #uuid "3a0d85b8-3324-57f7-a467-f401be804083" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(5x-7)^{3}}+C" :db/id #edb/ref 17592186336578} :answer-field/id #uuid "eda4e982-7475-54c5-abfe-c6e946514b7a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338692}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "b5692ce6-f75c-5a26-9487-0e066184decc" :question/math-academy-id "q-72429" :question/problem "$\\int -\\frac{15}{(5x-7)^{4}}\\,\\text{d}x=$" :question/worked-solution "First, we rewrite the integral as\n\n$$\n\\int -15(5x-7)^{-4}\\,\\text{d}x.\n$$\n\nLet $u=5x-7.$Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nWe now write our integral in terms of $u,$ calculate the integral as normal, and write the final answer in terms of $x$ at the very end:\n\n$$\n\\begin{aligned}\\int -15(5x-7)^{-4}\\,\\text{d}x & =\\int -15{u}^{-4}\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =-3\\int {u}^{-4}\\,\\text{d}u \\\\  & =-3\\cdot (-\\frac{1}{3}){u}^{-3}+C \\\\  & ={u}^{-3}+C \\\\  & =\\frac{1}{{u}^{3}}+C \\\\  & =\\frac{1}{(5x-7)^{3}}+C\\end{aligned}\n$$\n\nLet's double-check that our result is correct. If we differentiate the result, then it should come out to the original integrand:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{(5x-7)^{3}}+C] & =\\frac{\\text{d}}{\\text{d}x}[\\frac{1}{(5x-7)^{3}}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =\\frac{\\text{d}}{\\text{d}x}[(5x-7)^{-3}]+\\frac{\\text{d}}{\\text{d}x}(C) \\\\  & =-3\\cdot (5x-7)^{-4}\\cdot \\frac{\\text{d}}{\\text{d}x}(5x-7)+0 \\\\  & =-3\\cdot (5x-7)^{-4}\\cdot 5 \\\\  & =-\\frac{15}{(5x-7)^{4}}\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339114 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38d2d1aa-0997-5cb2-b300-dfa2f96f8aec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186336562} {:answer/id #uuid "59994cc9-84e6-5694-98fc-4ad89531a594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336850} {:answer/id #uuid "6dc5aa96-1f1c-55d1-b39a-b58513aa41ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337005} {:answer/id #uuid "bb7279db-0a2f-53c8-96ac-73280efb6211" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337695} {:answer/id #uuid "c1a55623-531d-5deb-9228-f91988939757" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186337753}] :answer-field/correct {:answer/id #uuid "59994cc9-84e6-5694-98fc-4ad89531a594" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186336850} :answer-field/id #uuid "89e15c6a-7b48-57d6-82fa-4853612f7217" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338530}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de671a41-8eec-5f15-a765-d0b4005272ba" :question/math-academy-id "q-7244" :question/problem "![](images/8b/8bde9a87a568654933ce9996f23605ea1219e2ff8416d9d5097971d9b6ef6087.png)\n\nThe graph above shows the curve $y=k{(\\frac{1}{2})}^{x}+c.$ Find the value of $k-c.$" :question/worked-solution "The horizontal asymptote of the curve $y=k{(\\frac{1}{2})}^{x}+c$ is $y=c.$ In the graph above, the horizontal asymptote is $y=-1.$ Hence, $c=-1.$\n\nWe can solve for $k$ by finding a point on the graph and substituting for $x$ and $y.$ The labeled point on the graph is $(0,4),$ so we substitute $x=0$ and $y=4$ into the function and solve for $k:$\n\n$$\n\\begin{aligned}k{(\\frac{1}{2})}^{x}+c & =y \\\\ k{(\\frac{1}{2})}^{x}-1 & =y \\\\ k{(\\frac{1}{2})}^{0}-1 & =4 \\\\ k-1 & =4 \\\\ k & =5\\end{aligned}\n$$\n\nTherefore,\n\n$$\nk-c=5-(-1)=6.\n$$\n\nThe equation of the curve is $y=5{(\\frac{1}{2})}^{x}-1.$"} {:db/id #edb/ref 17592186339117 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07b76063-8fda-596f-8106-cbb57f2ef69a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186336093} {:answer/id #uuid "86f6a2e9-4d29-5e23-9617-09660280aaa3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337252} {:answer/id #uuid "b4ead48b-c59a-570e-a7de-39bcbc22b8fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337638} {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} {:answer/id #uuid "f6322442-f9d7-5f7c-ac2d-896d214f1436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186338188}] :answer-field/correct {:answer/id #uuid "bec88b66-0b15-559a-8f7c-3341c51c2ee0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)" :db/id #edb/ref 17592186337729} :answer-field/id #uuid "209f233a-25a9-55a5-ab33-40122ec3bf02" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338337}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2d475585-492e-5142-bfa4-12e97136e061" :question/math-academy-id "q-72446" :question/problem "Calculate $\\int \\frac{1}{5-2x}\\,\\text{d}x.$ Assume that $K$ is an arbitrary positive constant." :question/worked-solution "First, let $u=5-2x.$ Then differentiating with respect to $x$ gives\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-2\\,⟹\\,\\text{d}x=-\\frac{1}{2}\\text{d}u.\n$$\n\nWe can now rewrite the integral in terms of $u,$ solve it, and write the final answer in terms of $x$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{5-2x}\\,\\text{d}x & =\\int \\frac{1}{u}\\cdot (-\\frac{1}{2})\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C\\end{aligned}\n$$\n\nWe can further simplify the above by writing $C=-\\frac{1}{2}\\operatorname{ln}⁡K$ for another arbitrary constant $K,$ and then we can combine the two terms using the laws of logarithms, as follows:\n\n$$\n\\begin{aligned}-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|+C & =-\\frac{1}{2}\\operatorname{ln}⁡|5-2x|-\\frac{1}{2}\\operatorname{ln}⁡K \\\\  & =-\\frac{1}{2}(\\operatorname{ln}⁡|5-2x|+\\operatorname{ln}⁡K) \\\\  & =-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|)\\end{aligned}\n$$\n\nSo, we finally conclude that\n\n$$\n\\int \\frac{1}{5-2x}\\text{d}x=-\\frac{1}{2}\\operatorname{ln}⁡(K|5-2x|).\n$$"} {:db/id #edb/ref 17592186339121 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2f1c83-8e64-5c5d-a7c8-61fec0e2b212" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186336438} {:answer/id #uuid "5ae8a4ab-e8dd-5c9e-8034-034f85b09221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186336858} {:answer/id #uuid "7d9b1b13-e0bb-5ca4-9acc-1057a08b5578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337167} {:answer/id #uuid "c3d09915-1432-5fb6-8119-db2c86b226d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186337770} {:answer/id #uuid "ded27ff2-fbdc-54ae-a21b-ad7fdc344c0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186337975}] :answer-field/correct {:answer/id #uuid "5ae8a4ab-e8dd-5c9e-8034-034f85b09221" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.5" :db/id #edb/ref 17592186336858} :answer-field/id #uuid "303db511-661b-5dcd-ac91-ae15b1d84c40" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338367}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7bd82a27-9501-5619-90c8-a56e5e1d1b92" :question/math-academy-id "q-7246" :question/problem "![](images/f9/f960cca1134d756cded381a2236dd427efb928b1081254173e4c6903b6de150e.png)\n\nThe graph above shows $y=k{(\\frac{1}{5})}^{x}.$ What is the value of $k?$" :question/worked-solution "To plot the graph of $y=k{(\\frac{1}{5})}^{x},$ we take the graph of $y={(\\frac{1}{5})}^{x}$ and stretch it vertically by a scale factor of  $k.$ Under the action of this transformation, the $y$-intercept is mapped from $(0,1)$ to $(0,k).$\n\nComparing the point $(0,1.5)$ on the graph to $(0,k),$ we see that we must have $k=1.5.$"} {:db/id #edb/ref 17592186339123 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e59935f-f93b-599b-9816-d15f61104595" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336167} {:answer/id #uuid "1ccce204-ca7a-5eee-bc02-3fcc7e16e632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336299} {:answer/id #uuid "4b5b5f53-8881-5e03-8cde-ddfcc41895a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186336732} {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} {:answer/id #uuid "7bc5cfb0-4b70-528a-a0e4-e88e561188b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337152}] :answer-field/correct {:answer/id #uuid "75e7362c-a6a5-5145-bf5d-1527db0f317d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C" :db/id #edb/ref 17592186337095} :answer-field/id #uuid "80b5679a-f4f7-56bb-9b5b-253ee5665aec" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338504}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "de70203f-dd05-5f0d-9800-283717012618" :question/math-academy-id "q-72467" :question/problem "Calculate $\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x.$" :question/worked-solution "In this case, the $x$ that's outside the square root isn't quite the derivative of $({x}^{2}-5).$ But the derivative is $2x,$ so we're only out by a constant factor.\n\nSo we make the substitution\n\n$$\nu={x}^{2}-5.\n$$\n\nIts derivative is given by\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & =2x\\,⟹\\,\\frac{1}{2}\\text{d}u=x\\,\\text{d}x,\\end{aligned}\n$$\n\nand we can now write our integral in terms of $u,$ as follows:\n\n$$\n\\begin{aligned}\\int x\\sqrt{{x}^{2}-5}\\,\\text{d}x & =\\int \\sqrt{{x}^{2}-5}\\cdot x\\,\\text{d}x \\\\  & =\\int \\sqrt{u}\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u\\end{aligned}\n$$\n\nFinally, we can solve the integral in terms of $u$ and then write the final result in terms of $x.$ We get\n\n$$\n\\begin{aligned}\\frac{1}{2}\\int {u}^{1/2}\\,\\text{d}u & =\\frac{1}{2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{1}{2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2}+C \\\\  & =\\frac{1}{3}{u}^{3/2}+C \\\\  & =\\frac{1}{3}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{1}{3}\\sqrt{({x}^{2}-5)^{3}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186339128 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "52c654bc-04c8-5012-92ba-be6dc4f3b157" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{4})}^{x}-2" :db/id #edb/ref 17592186336794} {:answer/id #uuid "618b5b65-bb8a-509b-8c37-05d672d232ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{4})}^{x}+3" :db/id #edb/ref 17592186336910} {:answer/id #uuid "badd5577-56d9-588f-8ff5-f790b17df424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{4})}^{x}+1" :db/id #edb/ref 17592186337690} {:answer/id #uuid "c6475fa7-8b43-572a-bb99-293059034eed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{4})}^{x}" :db/id #edb/ref 17592186337790} {:answer/id #uuid "ee1c4b7a-65db-5fce-84b6-561dd4ce2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{4})}^{x}+2" :db/id #edb/ref 17592186338114}] :answer-field/correct {:answer/id #uuid "ee1c4b7a-65db-5fce-84b6-561dd4ce2a2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{4})}^{x}+2" :db/id #edb/ref 17592186338114} :answer-field/id #uuid "e131a286-e66c-5d05-8d91-ddad9003ccc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338673}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8bad530c-24c4-5ec2-8bc0-ed7cad8940a0" :question/math-academy-id "q-7252" :question/problem "![](images/f7/f7cb93e2aa4cede2739d43fc33fc01755b5848465d46fed764eef87a1f9d3df9.png)\n\nThe graph above shows the curve $y={(\\frac{1}{4})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{4})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{4})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=2.$ Therefore, $c=2.$"} {:db/id #edb/ref 17592186339133 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "278a2661-eb4a-5ccf-94a9-e3323a7179af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+2" :db/id #edb/ref 17592186336401} {:answer/id #uuid "48626940-2e9b-50a8-b80b-89ae33b65bee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}" :db/id #edb/ref 17592186336706} {:answer/id #uuid "58330d9f-0dc5-5caf-af58-b2492b03a77b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}+1" :db/id #edb/ref 17592186336841} {:answer/id #uuid "5cf00bf3-2ab1-5fa1-9270-4bbc6255086b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-2" :db/id #edb/ref 17592186336873} {:answer/id #uuid "da7de62a-9590-5e45-a089-249538a33439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-1" :db/id #edb/ref 17592186337933}] :answer-field/correct {:answer/id #uuid "da7de62a-9590-5e45-a089-249538a33439" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "y={(\\frac{1}{3})}^{x}-1" :db/id #edb/ref 17592186337933} :answer-field/id #uuid "8c0ecdcc-f4de-5d40-9f9e-b7dcad3e1074" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338534}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "52a28619-4fbc-5936-812f-159a07cf7366" :question/math-academy-id "q-7255" :question/problem "![](images/df/df745423b3c91cddbfeb4a6414b17d69ee075ed2d02908f1e97aaecdbbf74679.png)\n\nThe graph above shows the curve $y={(\\frac{1}{3})}^{x}+c.$ Determine the value of $c$ and find the equation of the curve." :question/worked-solution "The horizontal asymptote of $y={(\\frac{1}{3})}^{x}$ is $y=0.$\n\nThe vertical translation $y={(\\frac{1}{3})}^{x}+c$ shifts the asymptote to $y=c.$\n\nIn the graph above, the horizontal asymptote is $y=-1.$ Therefore, $c=-1.$"} {:db/id #edb/ref 17592186341836 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e1988b7-4bc8-5bda-86c5-639e0552dedd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=7" :db/id #edb/ref 17592186339683} {:answer/id #uuid "51dac7ff-2d97-5661-b543-ad769758a707" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x+y=6" :db/id #edb/ref 17592186339880} {:answer/id #uuid "6d11b816-6f21-575c-a776-01785873cb84" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-3y=5" :db/id #edb/ref 17592186340089} {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} {:answer/id #uuid "af6755f9-b09b-562d-a589-5067ac2ec549" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=7" :db/id #edb/ref 17592186340728}] :answer-field/correct {:answer/id #uuid "803a7a88-7553-50e1-862d-0b786cfc737c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x+3y=13" :db/id #edb/ref 17592186340279} :answer-field/id #uuid "58e7ea68-a247-56ce-a08d-252af6a5df70" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341536}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ad191a02-5856-5306-8980-ab9514c55d3b" :question/math-academy-id "q-72571" :question/problem "Find the equation of the line that passes through the point $(5,1)$ and is perpendicular to the line passing through the points $(1,5)$ and $(-3,-1).$" :question/worked-solution "Perpendicular lines have slopes which are negative reciprocals of each other.\n\nFirst, let's find the slope ${m}_{1}$ of the line passing through the points $(1,5)$ and $(-3,-1):$\n\n$$\n\\begin{aligned}{m}_{1} & =\\frac{{y}_{2}-{y}_{1}}{{x}_{2}-{x}_{1}} \\\\  & =\\frac{-1-5}{-3-1} \\\\  & =\\frac{-6}{-4} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nSince we want a perpendicular line, the slope $m$ of the line we're trying to find must satisfy\n\n$$\nm\\cdot (\\frac{3}{2})=-1\\,⇒\\,m=-\\frac{2}{3}.\n$$\n\nWe know that the line passes through the point $(5,1).$ Using point-slope form and simplifying, we obtain the equation of the line:\n\n$$\n\\begin{aligned}y-{y}_{1} & =m(x-{x}_{1}) \\\\ y-1 & =-\\frac{2}{3}(x-5) \\\\ y-1 & =-\\frac{2}{3}x+\\frac{10}{3} \\\\ y & =-\\frac{2}{3}x+\\frac{13}{3}\\end{aligned}\n$$\n\nHowever, we want to write the equation in standard form. So, we will bring the $x$ term to the left-hand side and multiply both sides of the equation by $3:$\n\n$$\n\\begin{aligned}y & =-\\frac{2}{3}x+\\frac{13}{3} \\\\ \\frac{2}{3}x+y & =\\frac{13}{3} \\\\ 3\\cdot (\\frac{2}{3}x+y) & =3\\cdot \\frac{13}{3} \\\\ 2x+3y & =13\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341840 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "424f1750-2255-5cd3-97f1-bff8ae1f779e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186339710} {:answer/id #uuid "64a24bd8-02d1-5da1-875a-ff8313d79449" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{5(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340018} {:answer/id #uuid "cd66158f-066f-573b-a023-86fcc42573cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2(2-5{x}^{5})^{2}}+C" :db/id #edb/ref 17592186340950} {:answer/id #uuid "d40a6f74-0d5f-5192-b1f2-24adfd672a83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341003} {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259}] :answer-field/correct {:answer/id #uuid "f1c87e78-2256-558f-a463-3af7ee7e05a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C" :db/id #edb/ref 17592186341259} :answer-field/id #uuid "c4f33047-2f0b-50bf-84ac-e403b1fabf2c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341723}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "958efc2b-d91b-53e5-b712-1690bc1b7068" :question/math-academy-id "q-72605" :question/problem "$\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x=$" :question/worked-solution "Let $u=2-5{x}^{5}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-25{x}^{4}\\,⟹\\,(-\\frac{1}{25})\\text{d}u={x}^{4}\\,\\text{d}x,\n$$\n\nand we can solve the resulting integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{10{x}^{4}}{2-5{x}^{5}}\\,\\text{d}x & =10\\int \\frac{1}{2-5{x}^{5}}\\cdot {x}^{4}\\,\\text{d}x \\\\  & =10\\int \\frac{1}{u}\\cdot (-\\frac{1}{25})\\text{d}u \\\\  & =-\\frac{10}{25}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{2}{5}\\operatorname{ln}⁡|2-5{x}^{5}|+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341860 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0132169e-f42a-5220-a69a-7c30d86438b6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2{\\pi }^{2}}{9}" :db/id #edb/ref 17592186339140} {:answer/id #uuid "498cc57f-bffc-5f3f-9c58-3e208410fcbd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{\\pi }^{2}}{16}" :db/id #edb/ref 17592186339789} {:answer/id #uuid "636b5362-e589-54d7-8f67-2e414ac6b803" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{18}" :db/id #edb/ref 17592186340012} {:answer/id #uuid "9aa8860b-a34f-5f23-92ee-cc1252701150" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{\\pi }^{2}}{4}" :db/id #edb/ref 17592186340524} {:answer/id #uuid "b9fdf63e-5df8-585b-b8a4-157f959f9d5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186340794}] :answer-field/correct {:answer/id #uuid "b9fdf63e-5df8-585b-b8a4-157f959f9d5f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{\\pi }^{2}}{36}" :db/id #edb/ref 17592186340794} :answer-field/id #uuid "9d871a90-bd12-59f5-a9f9-fc4adc47aeff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341658}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "47c4e34b-d3a4-5786-b909-c2df73d6cb32" :question/math-academy-id "q-72773" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $\\operatorname{sin}⁡x=\\frac{1}{2}$ for $0\\le x<2\\pi ,$  what is the value of ${x}_{1}\\cdot {x}_{2}?$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{1}{2})=\\frac{\\pi }{6}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the required domain, our first solution is ${x}_{1}=\\frac{\\pi }{6}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{6}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6}.$\n\n![](images/00/00d540b1f6412e4af2617452fbf0c58750d01e844d89d0d92cfacc0cb3e45e32.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi -{\\theta }_{R} \\\\  & =\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$\n\nSo, the solutions are $x=\\frac{\\pi }{6},\\frac{5\\pi }{6}.$\n\nFinally, \n\n$$\n{x}_{1}{x}_{2}=\\frac{\\pi }{6}\\cdot \\frac{5\\pi }{6}=\\frac{5{\\pi }^{2}}{36}.\n$$"} {:db/id #edb/ref 17592186341861 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "058faef1-3b46-5838-ad00-2a1c1929a8c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={48.6}^{∘},{135.7}^{∘}" :db/id #edb/ref 17592186339171} {:answer/id #uuid "0d168ebd-5cd5-5402-9c4a-cadebb5eaac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={48.6}^{∘},{131.4}^{∘}" :db/id #edb/ref 17592186339248} {:answer/id #uuid "432e19aa-9f5a-54b6-9308-f292c773c731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={50.1}^{∘},{131.4}^{∘}" :db/id #edb/ref 17592186339718} {:answer/id #uuid "ba53e46c-4638-5d2b-b081-5cddd5d6e00a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={45.9}^{∘},{131.4}^{∘}" :db/id #edb/ref 17592186340798} {:answer/id #uuid "dfafa5d1-da3c-5e0a-87fa-2782023d8901" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={48.6}^{∘},{139.1}^{∘}" :db/id #edb/ref 17592186341116}] :answer-field/correct {:answer/id #uuid "0d168ebd-5cd5-5402-9c4a-cadebb5eaac9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x={48.6}^{∘},{131.4}^{∘}" :db/id #edb/ref 17592186339248} :answer-field/id #uuid "161f2d52-b604-57f6-a5d1-a33c34ad324b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341419}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e26e2e63-b096-5a84-a4a3-bdfd754248d4" :question/math-academy-id "q-72779" :question/problem "Calculate, in degrees, rounded to $1$ decimal place, the solutions to the equation $\\operatorname{sin}⁡x=\\frac{3}{4}$ for ${0}^{∘}\\le x<{360}^{∘}.$" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arcsin}⁡(\\frac{3}{4})=48.590\\,377{…}^{∘}≈48.590\\,{4}^{∘}\\end{aligned}\n$$\n\nSince $48.590\\,{4}^{∘}$ lies inside the range, our first solution is ${x}_{1}=48.590\\,{4}^{∘}.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=48.590\\,{4}^{∘}.$ Since $\\operatorname{sin}⁡x>0,$ the second solution must lie in the second quadrant, and it also has a reference angle ${\\theta }_{R}=48.590\\,{4}^{∘}.$\n\n![](images/48/4864e26ba05324041220dff99d1929b4c280b77456295d00d13d246279b4e628.png)\n\nSince the second solution ${x}_{2}$ lies in the $2$nd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & ={180}^{∘}-{\\theta }_{R} \\\\  & ={180}^{∘}-48.590\\,{4}^{∘} \\\\  & =131.409\\,{6}^{∘}\\end{aligned}\n$$\n\nSo, the solutions (rounded to one decimal place) are $x={48.6}^{∘},{131.4}^{∘}.$"} {:db/id #edb/ref 17592186341867 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0728ac5b-7e79-576b-adec-4d30f1c3aaba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{3}" :db/id #edb/ref 17592186339190} {:answer/id #uuid "0a3b29d2-4a94-5fb1-b9d2-b53c7ee28b83" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\pi }{5}" :db/id #edb/ref 17592186339213} {:answer/id #uuid "1c3f8e9c-6c9b-5885-bf56-6669a8495109" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6\\pi }{7}" :db/id #edb/ref 17592186339369} {:answer/id #uuid "2c898d7f-7e81-5d2c-919e-d2c6184e87a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186339514} {:answer/id #uuid "a084c4f1-65d6-5e7e-b06d-9f2e60c82d99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{7}" :db/id #edb/ref 17592186340582}] :answer-field/correct {:answer/id #uuid "2c898d7f-7e81-5d2c-919e-d2c6184e87a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\pi }{6}" :db/id #edb/ref 17592186339514} :answer-field/id #uuid "4100e90b-9d4e-566a-8305-372a98604ef5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341496}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fa1432b6-ebd7-517d-b079-d328cbf0fa84" :question/math-academy-id "q-72831" :question/problem "![](images/23/23b4f6296c9e840ad90b8235fa66f17e767c61a6cfeac5bc9566fd1fbd35b004.png)\n\nThe graph above shows the curve $y=\\operatorname{tan}⁡x$ and the line $y=-\\frac{\\sqrt{3}}{3}.$ Find, in radians, the $x$-coordinate of the point $A.$\n\n$$\n\n$$" :question/worked-solution "The $y$-values of both functions are the same at the intersection point. Equating the two equations gives:\n\n$$\n\\operatorname{tan}⁡x=-\\frac{\\sqrt{3}}{3}\n$$\n\n Now, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nThis value lies outside $\\frac{\\pi }{2}\\le x\\le \\frac{3\\pi }{2}.$ To get a value that's inside the required domain, we add $\\pi $ to the principal value. Thus,\n\n$$\n\\begin{aligned}{x}_{1} & =\\pi +{x}_{1}=\\pi -\\frac{\\pi }{6}=\\frac{5\\pi }{6}.\\end{aligned}\n$$\n\nSo, the $x$-coordinate of $A$ is $\\frac{5\\pi }{6}$ ."} {:db/id #edb/ref 17592186341868 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49ec8ef0-a2aa-59d0-b586-aee4023d0aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186339793} {:answer/id #uuid "8134019b-88f5-51c3-bcd5-4a61594e691e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186340289} {:answer/id #uuid "ac36a2b3-d852-50d8-89c7-cf913a281e3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186340699} {:answer/id #uuid "f6bf8e09-84a2-5c1e-885f-53546e4df408" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{8}" :db/id #edb/ref 17592186341311} {:answer/id #uuid "fa4cc8a3-5728-5583-82c6-0f49623ab642" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{8}" :db/id #edb/ref 17592186341339}] :answer-field/correct {:answer/id #uuid "ac36a2b3-d852-50d8-89c7-cf913a281e3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186340699} :answer-field/id #uuid "d37cc0bf-e7ca-5908-bdb0-a8516539f248" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341754}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22367997-0344-5325-8db1-e55756e2e128" :question/math-academy-id "q-72833" :question/problem "![](images/aa/aae559883c97bbd19321d9baeb26fe15e47cced5b072e12100c42aa579c9d02d.png)\n\nThe graph above shows the curve $y=\\operatorname{tan}⁡x$ and the line $y=\\frac{\\sqrt{3}}{3}.$ Find, in radians, the $x$-coordinate of the point $A.$" :question/worked-solution "The $y$-values of both functions are the same at the intersection point. Equating the two functions gives:\n\n$$\n\\operatorname{tan}⁡x=\\frac{\\sqrt{3}}{3}\n$$\n\n Now, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})=\\frac{\\pi }{6}\\end{aligned}\n$$\n\nSince $\\frac{\\pi }{6}$ lies inside the required domain, and there is only one point of intersection, we conclude that the $x$-coordinate of the intersection point $A$ is $x=\\frac{\\pi }{6}.$"} {:db/id #edb/ref 17592186341869 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00d5e468-bffd-5584-a784-ecfb449532a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186339136} {:answer/id #uuid "1d9fde13-58db-5370-bd76-bbe16a84773a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186339388} {:answer/id #uuid "8d60791b-0a87-5cc9-ba85-a275aea14130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186340397} {:answer/id #uuid "c37561d1-0002-57fd-b8ac-e023317c6504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186340866} {:answer/id #uuid "c4148f61-7aa1-5439-b757-b2b6cfede3f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186340872}] :answer-field/correct {:answer/id #uuid "c37561d1-0002-57fd-b8ac-e023317c6504" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186340866} :answer-field/id #uuid "f6880e55-2f26-507b-b040-ba6b2bd724bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341820}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0c47beb4-7d28-5eec-96a0-29c080da4a45" :question/math-academy-id "q-72835" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $\\operatorname{cos}⁡x=-\\frac{2}{3}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}$ to the nearest integer?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{2}{3}) & =2.300\\,523…≈2.301\\end{aligned}\n$$\n\nSince $2.301$ lies inside the required domain, our first solution is ${x}_{1}=2.301.$\n\nOur first solution lies in the second quadrant and has a reference angle of \n\n$$\n\\begin{aligned}{\\theta }_{R}=\\pi -2.301 & ≈0.841.\\end{aligned}\n$$\n\nSince $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=0.841.$\n\n![](images/d0/d02a0250df0f0e6c389594ea0e1b119d9f4c63c353553d56c0e865f487862284.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +0.841 \\\\  & ≈3.983\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}≈2.301\\cdot 3.983≈9\n$$\n\nto the nearest integer."} {:db/id #edb/ref 17592186341870 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "416a58ae-ce76-5e02-96f0-d7597149753a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.5" :db/id #edb/ref 17592186339708} {:answer/id #uuid "6db8cad2-a957-58f3-ad26-db45b399e754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.8" :db/id #edb/ref 17592186340098} {:answer/id #uuid "a1cd8970-9cb3-5318-9504-b8c8a617dc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.1" :db/id #edb/ref 17592186340596} {:answer/id #uuid "b6c00063-961c-57de-9996-aa7c34c1b08f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.9" :db/id #edb/ref 17592186340780} {:answer/id #uuid "ff350533-a65b-5d8c-9636-be091780422d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.1" :db/id #edb/ref 17592186341376}] :answer-field/correct {:answer/id #uuid "ff350533-a65b-5d8c-9636-be091780422d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5.1" :db/id #edb/ref 17592186341376} :answer-field/id #uuid "90108bbe-e3f9-552f-9a17-4a20b275ed27" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341634}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "40af3b43-8968-5b55-af69-0a7608e19327" :question/math-academy-id "q-72838" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡x=\\frac{4}{7}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{4}{7})=0.962\\,550…≈0.962\\,6\\end{aligned}\n$$\n\nSince $0.962\\,6$ lies inside the specified domain, our first solution is ${x}_{1}=0.962\\,6.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=0.962\\,6.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=0.962\\,6.$\n\n![](images/b2/b2cd7e76526632d8507ba484246a560829882e7f10d9814f01593f7a48d9a2ac.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -0.962\\,6 \\\\  & =5.320\\,6\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}≈0.962\\,6\\cdot 5.320\\,6≈5.1\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186341872 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55edaa2a-1154-52d8-9530-260261395249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186339915} {:answer/id #uuid "68873d2d-aa7a-5baf-8be5-8fba31e19518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340059} {:answer/id #uuid "83293cdb-be49-5f68-8bac-1c64d296a1a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186340308} {:answer/id #uuid "d896e395-515a-5bc0-bbe7-fc3b0614ef52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186341052} {:answer/id #uuid "e1777609-516c-552a-bb28-eaa56e9eb7af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186341126}] :answer-field/correct {:answer/id #uuid "55edaa2a-1154-52d8-9530-260261395249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186339915} :answer-field/id #uuid "5a113223-08c8-5467-aa70-c9c96110b9bd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341541}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3b3398cc-8758-5d62-8796-0ec13a13ea7d" :question/math-academy-id "q-72840" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions of the equation $\\operatorname{cos}⁡x=\\frac{1}{4}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2}$ to the nearest integer?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(\\frac{1}{4})=1.318\\,116…≈1.318\\end{aligned}\n$$\n\nSince $1.318$ lies inside the specified domain, our first solution is ${x}_{1}=1.318.$\n\nOur first solution lies in the first quadrant and has a reference angle of ${\\theta }_{R}=1.318.$ Since $\\operatorname{cos}⁡x>0,$ the second solution must lie in the fourth quadrant, and it also has a reference angle ${\\theta }_{R}=1.318.$\n\n![](images/87/8797bd2b1558e094b72d891fd344b356e5d579e4549b788bdd0507de23f171c7.png)\n\nSince the second solution ${x}_{2}$ lies in the $4$th quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -1.318 \\\\  & =4.965\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}≈1.318\\cdot 4.965≈7\n$$\n\nto the nearest integer."} {:db/id #edb/ref 17592186341873 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "145badac-b27b-5e69-a317-ede02a7c4f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9.2" :db/id #edb/ref 17592186339310} {:answer/id #uuid "4f6baa6f-2d68-5d47-8c11-d30883e928ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.9" :db/id #edb/ref 17592186339851} {:answer/id #uuid "567145f7-185d-5f68-84f3-337783ccf578" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186339918} {:answer/id #uuid "7b781b9d-9ba3-5c98-a2bf-5dffb62b656f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6.3" :db/id #edb/ref 17592186340234} {:answer/id #uuid "86616c3c-5567-54ea-aeed-808f226c030c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186340334}] :answer-field/correct {:answer/id #uuid "86616c3c-5567-54ea-aeed-808f226c030c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8.5" :db/id #edb/ref 17592186340334} :answer-field/id #uuid "c4071a95-7784-5e52-b3d6-d1995e73002a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341720}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9975124e-84e0-58f3-a162-bfccabebefd9" :question/math-academy-id "q-72841" :question/problem "Given that ${x}_{1}$ and ${x}_{2}$ are the solutions to the equation $\\operatorname{cos}⁡x=-\\frac{2}{5}$ for $0\\le x<2\\pi ,$ what is the value of ${x}_{1}\\cdot {x}_{2},$ rounded to one decimal place?" :question/worked-solution "First, we find the principal value:\n\n$$\n\\begin{aligned}x=\\operatorname{arccos}⁡(-\\frac{2}{5}) & =1.982\\,313…≈1.982\\,3\\end{aligned}\n$$\n\nSince $1.982\\,3$ lies inside the required domain, our first solution is ${x}_{1}=1.982\\,3.$\n\nOur first solution lies in the second quadrant and has a reference angle of \n\n$$\n\\begin{aligned}{\\theta }_{R}=\\pi -1.982\\,3 & ≈1.159\\,3.\\end{aligned}\n$$\n\nSince $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has a reference angle ${\\theta }_{R}=1.159\\,3.$\n\n![](images/25/250adbaae0378e3f42ab4340479bb4590aa7f39a1094ea39010de3d5758b4e3e.png)\n\nSince the second solution ${x}_{2}$ lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +1.159\\,3 \\\\  & ≈4.300\\,9\\end{aligned}\n$$\n\nFinally,\n\n$$\n{x}_{1}{x}_{2}≈1.982\\,3\\cdot 4.300\\,9≈8.5\n$$\n\nrounded to one decimal place."} {:db/id #edb/ref 17592186341882 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5b996720-fe76-527e-b639-dd4409e18034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{2}t-\\frac{1}{4}" :db/id #edb/ref 17592186339960} {:answer/id #uuid "a98de0a0-9fd5-5afa-9d38-9aabd800ddfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{12}{t}^{3}-\\frac{1}{8}{t}^{2}-\\frac{1}{3}" :db/id #edb/ref 17592186340672} {:answer/id #uuid "ccc2c008-aa1a-527d-8c07-3caeedf8eaae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{12}{t}^{3}-\\frac{1}{8}{t}^{2}" :db/id #edb/ref 17592186340940} {:answer/id #uuid "eaef0bad-552a-5d4e-85b6-f49a9ab354a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{12}{t}^{3}-\\frac{1}{8}{t}^{2}-\\frac{1}{6}" :db/id #edb/ref 17592186341203} {:answer/id #uuid "fd027a0e-52e6-59da-a871-423b0692b4d6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{12}{t}^{3}-\\frac{1}{8}{t}^{2}-\\frac{5}{36}" :db/id #edb/ref 17592186341363}] :answer-field/correct {:answer/id #uuid "a98de0a0-9fd5-5afa-9d38-9aabd800ddfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x(t)=\\frac{1}{12}{t}^{3}-\\frac{1}{8}{t}^{2}-\\frac{1}{3}" :db/id #edb/ref 17592186340672} :answer-field/id #uuid "3644f722-09d5-5e49-bbfd-14847dd6a5d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341478}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f823e7c2-6ed4-59db-a566-84d27827d618" :question/math-academy-id "q-7287" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with velocity $v(t)=\\frac{{t}^{2}-t}{4},$ where $t>0$ is the time. If the particle is at the position $x=-\\frac{1}{6}$ when $t=2,$ calculate the position $x$ of the particle at time $t.$" :question/worked-solution "We start by integrating the velocity to get $x(t):$\n\n$$\n\\begin{aligned}x(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int (\\frac{{t}^{2}-t}{4})\\text{d}t \\\\  & =\\frac{1}{12}{t}^{3}-\\frac{1}{8}{t}^{2}+C\\end{aligned}\n$$\n\nTo determine $C,$ we use the fact that $x(2)=-\\frac{1}{6}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}-\\frac{1}{6} & =\\frac{1}{12}(2)^{3}-\\frac{1}{8}(2)^{2}+C \\\\ -\\frac{1}{6} & =\\frac{1}{6}+C \\\\ C & =-\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the position $x$ of the particle at time $t$ is \n\n$$\nx(t)=\\frac{1}{12}{t}^{3}-\\frac{1}{8}{t}^{2}-\\frac{1}{3}.\n$$"} {:db/id #edb/ref 17592186341893 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "368d6f09-f86f-5a1f-934f-edb2ada2ecdb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,\\frac{1}{2},1⟩" :db/id #edb/ref 17592186339616} {:answer/id #uuid "4016e3b4-303c-5e7d-bc9c-f626ddc0e67a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,-1,\\frac{1}{2}⟩" :db/id #edb/ref 17592186339702} {:answer/id #uuid "5a087a29-e907-5bbd-8024-d1c0e3d6066a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\frac{1}{2},\\frac{1}{2}⟩" :db/id #edb/ref 17592186339946} {:answer/id #uuid "7f49b16e-bca9-5992-802b-f9800e9b025a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186340272} {:answer/id #uuid "b28c83dc-7bea-5c71-a4cc-8b4d73503adb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-\\frac{1}{2},\\frac{1}{2},-1⟩" :db/id #edb/ref 17592186340752}] :answer-field/correct {:answer/id #uuid "5a087a29-e907-5bbd-8024-d1c0e3d6066a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\frac{1}{2},\\frac{1}{2}⟩" :db/id #edb/ref 17592186339946} :answer-field/id #uuid "7d72ac37-7d4a-57f8-a026-426aa0ba98f8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341600}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6577a967-44f3-50e6-9603-cd6d17cab94e" :question/math-academy-id "q-72983" :question/problem "Solve the system of equations represented by the augmented matrix\n\n$$\n\\begin{bmatrix}2 & 1 & 1 & -1 \\\\ 0 & 1 & 1 & 1 \\\\ 0 & 0 & 2 & 1\\end{bmatrix}.\n$$" :question/worked-solution "The matrix represents a system of three linear equations in three variables, say, $x$, $y$, and $z.$ We obtain the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}2x+y+z &=-1 \\\\ y+z &=1 \\\\ 2z &=1\\end{aligned}\\right.\n$$\n\nThe third equation states that\n \n\n$$\n2z=1\\,⟹\\,z=\\frac{1}{2}.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\ny+(\\frac{1}{2})=1\\,⟹\\,y=1-\\frac{1}{2}=\\frac{1}{2}.\n$$\n\nNow, we substitute $z=y=\\frac{1}{2}$  into the first equation to get\n\n$$\n2x+(\\frac{1}{2})+(\\frac{1}{2})=-1\\,⟹\\,x=\\frac{1}{2}(-1-\\frac{1}{2}-\\frac{1}{2})=-1.\n$$\n\nTherefore, the solution is $x=-1$, $y=\\frac{1}{2}$, and $z=\\frac{1}{2}.$ In vector form, the solution can be written as $⟨-1,\\frac{1}{2},\\frac{1}{2}⟩.$"} {:db/id #edb/ref 17592186341901 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d39e1d2-809f-5155-a07c-2be82fe6f5c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186339382} {:answer/id #uuid "40729786-50b6-5ff5-b256-a96bf88930f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186339704} {:answer/id #uuid "ab3fcfc4-5970-535a-9851-ae25c946b062" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{3\\pi }{14})" :db/id #edb/ref 17592186340688} {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} {:answer/id #uuid "f54d10f1-3bdb-508e-83f2-6340ec8fe28b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡(\\frac{3\\pi }{7})" :db/id #edb/ref 17592186341292}] :answer-field/correct {:answer/id #uuid "dc526537-6440-5beb-89ba-a669341bd361" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(\\frac{6\\pi }{7})" :db/id #edb/ref 17592186341086} :answer-field/id #uuid "6bdfe7ee-6a1b-5a6c-8716-9c970e741c65" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341565}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "188c3216-6730-58aa-bfa7-8985bab845cd" :question/math-academy-id "q-7305" :question/problem "Express $2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7})$ as a single trigonometric ratio." :question/worked-solution "First, let's recall the double-angle formula for sine: \n\n$$\n2\\operatorname{sin}⁡x\\operatorname{cos}⁡x=\\operatorname{sin}⁡2x\n$$\n\nSubstituting $x=\\frac{3\\pi }{7}$ into the above, we get\n\n$$\n\\begin{aligned}2\\operatorname{sin}⁡(\\frac{3\\pi }{7})\\operatorname{cos}⁡(\\frac{3\\pi }{7}) & =\\operatorname{sin}⁡(2\\cdot \\frac{3\\pi }{7})=\\operatorname{sin}⁡(\\frac{6\\pi }{7}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341918 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2c11bc78-d2c8-508a-b8fb-990c82485b01" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(\\frac{4j}{n})}^{-4}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186339511} {:answer/id #uuid "672f2c27-138f-5c55-aef5-0b2361a5154e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-2+\\frac{4j}{n})}^{-2}\\cdot \\frac{4}{n}]" :db/id #edb/ref 17592186340041} {:answer/id #uuid "ab869e72-931c-52bc-97fc-2e5c42e4486e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186340692} {:answer/id #uuid "ee951d44-ea61-556b-94d7-e1dd4325b6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186341232} {:answer/id #uuid "eee0bce5-f344-5783-ba0f-f51aa7490a07" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(\\frac{j}{n})}^{-2}\\cdot \\frac{1}{n}]" :db/id #edb/ref 17592186341237}] :answer-field/correct {:answer/id #uuid "ee951d44-ea61-556b-94d7-e1dd4325b6f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}]" :db/id #edb/ref 17592186341232} :answer-field/id #uuid "a983d74d-4019-5c4d-aa85-405465fd5a9a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341675}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f9a39ce-97fb-5b82-8335-1f0d956000c1" :question/math-academy-id "q-73160" :question/problem "What is ${\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx,\n$$\n\n    \n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{j}=a+jΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=-5{x}^{-2},$ the lower bound is $a=-4,$ and the upper bound is $b=-2.$ So, we have\n\n$$\nΔx=\\frac{-2-(-4)}{n}=\\frac{2}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{-4}^{-2}-5{x}^{-2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(-4+j\\cdot \\frac{2}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[f(-4+\\frac{2j}{n})\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=0}^{n-1}[-5{(-4+\\frac{2j}{n})}^{-2}\\cdot \\frac{2}{n}].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341921 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "331c20ed-c9a8-5ebf-bb07-3fd9c7d6644e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{n}{\\sum }_{j=1}^{n}\\operatorname{ln}⁡(4j)" :db/id #edb/ref 17592186339581} {:answer/id #uuid "4a710490-742e-5db0-89ff-943d4738e568" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{n}{\\sum }_{j=1}^{n}\\operatorname{ln}⁡(n+4j)" :db/id #edb/ref 17592186339798} {:answer/id #uuid "7cc24dec-2575-5162-950f-37eb4515063e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4n}{\\sum }_{j=1}^{n}\\operatorname{ln}⁡(4j)" :db/id #edb/ref 17592186340252} {:answer/id #uuid "7e805222-a218-5e1b-a01f-94c7dbe62184" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4n}{\\sum }_{j=1}^{n}\\operatorname{ln}⁡(1+4j)" :db/id #edb/ref 17592186340269} {:answer/id #uuid "cdddff64-4e91-5e54-8e48-28c9f91c2f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{n}{\\sum }_{j=1}^{n}[\\operatorname{ln}⁡(n+4j)-\\operatorname{ln}⁡(n)]" :db/id #edb/ref 17592186340957}] :answer-field/correct {:answer/id #uuid "cdddff64-4e91-5e54-8e48-28c9f91c2f14" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{n}{\\sum }_{j=1}^{n}[\\operatorname{ln}⁡(n+4j)-\\operatorname{ln}⁡(n)]" :db/id #edb/ref 17592186340957} :answer-field/id #uuid "006a7b5c-6ec0-5b8c-8b5a-b754a7de6392" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341384}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "6144fe4d-1170-577e-833f-34f148107f4b" :question/math-academy-id "q-73192" :question/problem "The area under the curve $y=\\operatorname{ln}⁡x$ between $x=1$ and $x=5$ and the $x$-axis is approximated by a right Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{j=1}^{n}f({x}_{j})Δx,\n$$\n\nwhere ${x}_{j}=a+jΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nWe're told that there are $n$ subintervals. The endpoints indicate that $a=1$ and $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-1}{n}=\\frac{4}{n}.\n$$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as \n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}f({x}_{j})Δx & ={\\sum }_{j=1}^{n}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=1}^{n}f(1+j\\cdot \\frac{4}{n})\\cdot \\frac{4}{n} \\\\  & =\\frac{4}{n}{\\sum }_{j=1}^{n}f(\\frac{n+4j}{n}) \\\\  & =\\frac{4}{n}{\\sum }_{j=1}^{n}\\,\\operatorname{ln}⁡(\\frac{n+4j}{n}) \\\\  & =\\frac{4}{n}{\\sum }_{j=1}^{n}[\\operatorname{ln}⁡(n+4j)-\\operatorname{ln}⁡(n)].\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341937 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1beaf82b-ca6d-5426-aa13-fd5815d423b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186339368} {:answer/id #uuid "82061933-a612-5dfb-af1d-c4e789553102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340298} {:answer/id #uuid "8d319e2e-bf9d-56aa-8999-7345e8362465" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186340395} {:answer/id #uuid "c7389d59-06bc-5dbe-9262-9447a8c813ed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186340894} {:answer/id #uuid "f480be00-0128-5082-93a6-d17b5a45580c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186341284}] :answer-field/correct {:answer/id #uuid "82061933-a612-5dfb-af1d-c4e789553102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340298} :answer-field/id #uuid "6548d467-5048-50dd-98ac-f013e5313bb6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341557}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "41bab868-1060-5798-adf0-32f97366917b" :question/math-academy-id "q-73286" :question/problem "${\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x & =-\\operatorname{cos}⁡x\\,{|}_{0}^{\\pi /3} \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{3})-(-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{2}-(-1) \\\\  & =-\\frac{1}{2}+1 \\\\  & =\\frac{1}{2}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341938 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "090a45ae-4a14-53bd-bff9-96bc2c7a0d8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1-\\sqrt{3}}{3}" :db/id #edb/ref 17592186339206} {:answer/id #uuid "4c52d9ff-6ce1-5908-b527-e5d1742ab70a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3-\\sqrt{3}}{3}" :db/id #edb/ref 17592186339819} {:answer/id #uuid "5588d6f2-8c6f-5a01-b89a-7b7a17265739" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186339912} {:answer/id #uuid "d3238de0-22ee-5721-a21d-7e7f9b4dbeca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+1}{3}" :db/id #edb/ref 17592186340998} {:answer/id #uuid "e96c033c-24e5-59d6-9c28-291c33500939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186341187}] :answer-field/correct {:answer/id #uuid "e96c033c-24e5-59d6-9c28-291c33500939" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}+3}{3}" :db/id #edb/ref 17592186341187} :answer-field/id #uuid "1da3650a-fb35-5fa8-b4ff-0230c249cc80" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341433}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "98dd252e-cda8-57e3-b4c8-968d1e2d356e" :question/math-academy-id "q-73289" :question/problem "${\\int }_{\\pi /3}^{3\\pi /4}(-{csc}^{2}⁡x)\\,\\text{d}x=$" :question/worked-solution "Taking the antiderivative and evaluating the difference at the bounds, we get\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /3}^{3\\pi /4}(-{csc}^{2}⁡x)\\,\\text{d}x & =\\operatorname{cot}⁡x\\,{|}_{\\pi /3}^{3\\pi /4} \\\\  & =\\operatorname{cot}⁡(\\frac{3\\pi }{4})-\\operatorname{cot}⁡(\\frac{\\pi }{3}) \\\\  & =-1-\\frac{\\sqrt{3}}{3} \\\\  & =-\\frac{\\sqrt{3}+3}{3}.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341940 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25da2f97-1233-53a9-916d-a71898b3df50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339455} {:answer/id #uuid "72f61544-e2c8-53c1-8a4e-3af5ff8bdb60" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2.8" :db/id #edb/ref 17592186340148} {:answer/id #uuid "adab89e2-8e27-5382-8960-921d0ee9c4dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340709} {:answer/id #uuid "c4d86727-c7e5-55c4-bf76-09b8a18150e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1.4" :db/id #edb/ref 17592186340879} {:answer/id #uuid "ece5f479-65eb-52bf-9ade-027e7bebf59f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186341216}] :answer-field/correct {:answer/id #uuid "25da2f97-1233-53a9-916d-a71898b3df50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339455} :answer-field/id #uuid "979df9b1-6818-520d-9541-8aa235a34437" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341647}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9cc7964b-3169-5f22-8d75-6a7a05d33c9b" :question/math-academy-id "q-73324" :question/problem "![](images/33/333a99cd7b1f4aa0c3017c2b5aa42cb04acad842b19345a1176d57a71c5fd120.png)\n\nA region is bounded by the curve $y=-{sec}^{2}⁡x$, the $x$-axis and the lines $x=-\\frac{\\pi }{4}$ and $x=\\frac{\\pi }{4}$, as shown above. Find the area of the region." :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi /4}^{\\pi /4}(-{sec}^{2}⁡x)\\,\\text{d}x \\\\  & =-\\operatorname{tan}⁡x{|}_{-\\pi /4}^{\\pi /4} \\\\  & =-(\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡(-\\frac{\\pi }{4})) \\\\  & =-(1-(-1)) \\\\  & =-2.\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we obtained a negative number. So the area that we want is $2.$"} {:db/id #edb/ref 17592186341941 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b55e79a-993d-5794-b926-9f61e9280aba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339227} {:answer/id #uuid "35e5d8c3-75ae-5d03-b09d-fb7d42c61c45" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186339609} {:answer/id #uuid "74268e37-1f62-5484-8e2e-289685ee280c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186340160} {:answer/id #uuid "7c2ae093-3817-5408-b776-763e241cdd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186340245} {:answer/id #uuid "e0d79b4f-4909-5ade-98af-aa79d6111bcd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186341124}] :answer-field/correct {:answer/id #uuid "7c2ae093-3817-5408-b776-763e241cdd77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186340245} :answer-field/id #uuid "8d782e86-1ff4-5e18-8864-3196f9c2c47d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341629}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5a57d1c4-bb4c-5c4c-98eb-5c77a7edaff8" :question/math-academy-id "q-73327" :question/problem "![](images/70/70a4f7ef7589f303924f1c48e7b0c26cd2173960847ac660199d11ae144c0afc.png)\n\nA region is bounded by the curve $y=-\\operatorname{sec}⁡x\\operatorname{tan}⁡x$, the $x$-axis and the lines $x=0$ and $x=\\frac{\\pi }{4}$, as shown above. Find the area of the region." :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}(-\\operatorname{sec}⁡x\\operatorname{tan}⁡x)\\,\\text{d}x \\\\  & =-\\operatorname{sec}⁡x{|}_{0}^{\\pi /4} \\\\  & =-(\\operatorname{sec}⁡(\\frac{\\pi }{4})-\\operatorname{sec}⁡0) \\\\  & =-(\\sqrt{2}-1) \\\\  & =1-\\sqrt{2}\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we obtained a negative number. So the area that we want is $\\sqrt{2}-1.$"} {:db/id #edb/ref 17592186341943 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30abb31d-0cea-5c7a-831e-96f5de788129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186339554} {:answer/id #uuid "6c6421ba-9fc4-5b06-b42e-97b8e9630769" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186340085} {:answer/id #uuid "8323ac06-5123-5d38-a2e5-414f42c84379" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186340307} {:answer/id #uuid "e6899588-5e41-526e-95e9-1b4de17de58f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186341168} {:answer/id #uuid "ead28d9d-44e7-5693-be9e-8e7172b9ab41" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186341201}] :answer-field/correct {:answer/id #uuid "30abb31d-0cea-5c7a-831e-96f5de788129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186339554} :answer-field/id #uuid "05af01ca-4de3-5a04-b54e-282cded90f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341394}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "091e393b-fab2-5cbe-beb6-54d3099ab9eb" :question/math-academy-id "q-73333" :question/problem "![](images/18/1819bad0219f1709a01100daad00beb25a8bbc3688f9fe7c41be53bad8010455.png)\n\nA region is bounded by the curve $y=-\\frac{1}{\\sqrt{1-{x}^{2}}}$, the $x$-axis, and the lines $x=-0.5$ and $x=0.5$, as shown above. What is the area of the region?" :question/worked-solution "To find the area, we just need to compute the corresponding definite integral:\n\n$$\n\\begin{aligned}\\begin{aligned}A & ={\\int }_{a}^{b}y(x)\\,\\text{d}x \\\\  & ={\\int }_{-0.5}^{0.5}-\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-{\\int }_{-0.5}^{0.5}\\frac{1}{\\sqrt{1-{x}^{2}}}\\,\\text{d}x \\\\  & =-\\operatorname{arcsin}⁡x{|}_{-0.5}^{0.5} \\\\  & =-(\\operatorname{arcsin}⁡(0.5)-\\operatorname{arcsin}⁡(-0.5)) \\\\  & =-\\frac{\\pi }{6}+(-\\frac{\\pi }{6}) \\\\  & =-\\frac{\\pi }{3}.\\end{aligned}\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis, we obtained a negative number. So the area that we want is $\\frac{\\pi }{3}.$"} {:db/id #edb/ref 17592186341951 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e98f9ac-4a01-5bbe-b14d-e0136dc8a635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186340108} {:answer/id #uuid "7b102e44-8332-50cb-9a36-832b649d80e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186340230} {:answer/id #uuid "7c07685a-ec3b-5beb-ad8e-cf3840f22cab" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "33" :db/id #edb/ref 17592186340242} {:answer/id #uuid "c219ca7c-507f-51c9-802a-7d85664a4eca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "30" :db/id #edb/ref 17592186340855} {:answer/id #uuid "ca1a4e53-010a-5a77-b8eb-5a63c727d93e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186340916}] :answer-field/correct {:answer/id #uuid "6e98f9ac-4a01-5bbe-b14d-e0136dc8a635" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186340108} :answer-field/id #uuid "791ab147-ce9e-50e4-86c0-e83adc1db7f9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341593}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "894941c4-4ec1-5dfe-8658-9b67ea8938f5" :question/math-academy-id "q-73350" :question/problem "Given that ${\\int }_{0}^{3}f(x)\\,\\text{d}x=5$ and ${\\int }_{3}^{6}f(x)\\,\\text{d}x=\\frac{1}{3}$ then what is ${\\int }_{0}^{6}(3f(x)+3)\\,\\text{d}x?$" :question/worked-solution "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{6}f(x)\\,\\text{d}x={\\int }_{0}^{6}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}5+\\frac{1}{3}={\\int }_{0}^{6}f(x)\\,\\text{d}x \\\\ \\frac{16}{3}={\\int }_{0}^{6}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}(3f(x)+3)\\,\\text{d}x & =3{\\int }_{0}^{6}f(x)\\,\\text{d}x+3{\\int }_{0}^{6}\\,\\text{d}x \\\\  & =3(\\frac{16}{3})+3\\cdot x\\,{|}_{0}^{6} \\\\  & =16+3(6-0) \\\\  & =34.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e77e606-3fbe-52e7-aab0-b4caa65a952e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-2" :db/id #edb/ref 17592186339394} {:answer/id #uuid "1f1abc9f-f1fd-5412-8a4f-d3cc8ce84141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339400} {:answer/id #uuid "4b46d088-8900-59df-a294-e9c5fdb831c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339803} {:answer/id #uuid "caf8e344-d78b-5248-b740-b9b631236223" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340926} {:answer/id #uuid "dbec64d1-1c16-522f-a4e9-422136eadbca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186341080}] :answer-field/correct {:answer/id #uuid "1f1abc9f-f1fd-5412-8a4f-d3cc8ce84141" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186339400} :answer-field/id #uuid "934751e0-e49e-590a-9aa0-5f8c7d1fc3cb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341639}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "47640681-1f63-58a5-b2bd-140af66b43bb" :question/math-academy-id "q-73361" :question/problem "Evaluate ${\\int }_{0}^{\\pi /4}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /4}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\text{d}x={\\int }_{0}^{\\pi /4}\\frac{1}{\\operatorname{sec}⁡x}\\cdot (1+\\operatorname{tan}⁡x)\\,\\text{d}x\n$$\n\nWe then use the fact that $\\frac{1}{\\operatorname{cos}⁡x}=\\operatorname{sec}⁡x$ and $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}.$ Therefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{1}{\\operatorname{sec}⁡x}\\cdot (1+\\operatorname{tan}⁡x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\operatorname{cos}⁡x\\cdot (1+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡x+\\operatorname{cos}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)\\,\\text{d}x \\\\  & =(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x){|}_{0}^{\\pi /4} \\\\  & (\\operatorname{sin}⁡(\\frac{\\pi }{4})-\\operatorname{cos}⁡(\\frac{\\pi }{4}))-(\\operatorname{sin}⁡(0)-\\operatorname{cos}⁡(0)) \\\\  & =(\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2})-(0-1) \\\\  & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48658c86-5fff-5d1e-ad97-ca9615485d8d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-9\\operatorname{ln}⁡|3x-2|+C" :db/id #edb/ref 17592186339773} {:answer/id #uuid "8d8c23eb-6ff2-5bd1-ab4a-f009409818c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x+9\\operatorname{ln}⁡|3x-2|+C" :db/id #edb/ref 17592186340399} {:answer/id #uuid "a839708e-6d86-5a57-b693-6f0e21e650eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}+\\frac{1}{3}\\operatorname{ln}⁡|3x-2|+C" :db/id #edb/ref 17592186340655} {:answer/id #uuid "ced86a89-239e-50b2-894e-628af504a0d4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C" :db/id #edb/ref 17592186340966} {:answer/id #uuid "daa4acb0-2d88-582f-a718-be7e56ba1265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C" :db/id #edb/ref 17592186341071}] :answer-field/correct {:answer/id #uuid "daa4acb0-2d88-582f-a718-be7e56ba1265" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{3}-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C" :db/id #edb/ref 17592186341071} :answer-field/id #uuid "ea2bfd72-4857-53aa-b6a7-f5d94cbdaa7f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341797}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "40d2e0b8-4256-5b72-ae20-79f2c7d72c06" :question/math-academy-id "q-73391" :question/problem "Calculate $\\int \\frac{x-1}{3x-2}\\,\\text{d}x.$" :question/worked-solution "First, we pull out the factor of $3$ from the denominator:\n\n$$\n\\begin{aligned}\\int \\frac{x-1}{3x-2}\\,\\text{d}x & =\\int \\frac{x-1}{3(x-\\frac{2}{3})}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{x-1}{(x-\\frac{2}{3})}\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ \\frac{2}{3} & 1 & -1 \\\\  & ↓ & \\frac{2}{3} \\\\  & 1 & -\\frac{1}{3}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{x-1}{(x-\\frac{2}{3})} & =1+\\frac{(-\\frac{1}{3})}{(x-\\frac{2}{3})} \\\\  & =1-\\frac{1}{3(x-\\frac{2}{3})} \\\\  & =1-\\frac{1}{3x-2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{x-1}{3x-2}\\,\\text{d}x & =\\frac{1}{3}\\int (1-\\frac{1}{3x-2})\\text{d}x \\\\  & =\\frac{1}{3}[\\int \\text{d}x-\\int \\frac{1}{3x-2}\\,\\text{d}x] \\\\  & =\\frac{1}{3}[x-\\frac{1}{3}\\operatorname{ln}⁡|3x-2|]+C \\\\  & =\\frac{x}{3}-\\frac{1}{9}\\operatorname{ln}⁡|3x-2|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341963 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a00f442-fb57-50c5-bbd9-1fee169237ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{7}-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C" :db/id #edb/ref 17592186339210} {:answer/id #uuid "9e692c9d-8c77-5bad-bb2c-ce6b0b04b196" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{49}-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|+C" :db/id #edb/ref 17592186340557} {:answer/id #uuid "d83cb14a-5586-599e-b0e7-7d4efca60710" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{7}-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|+C" :db/id #edb/ref 17592186341048} {:answer/id #uuid "ecf38642-bc7b-5a13-80f5-5fb4cb506698" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C" :db/id #edb/ref 17592186341218} {:answer/id #uuid "fcc80829-1f8f-594c-9696-243eccca8ac1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7x-\\operatorname{ln}⁡|7x+1|+C" :db/id #edb/ref 17592186341361}] :answer-field/correct {:answer/id #uuid "0a00f442-fb57-50c5-bbd9-1fee169237ee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{x}{7}-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C" :db/id #edb/ref 17592186339210} :answer-field/id #uuid "3b01ee45-8bb0-54ab-ae6b-948698750e8a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341486}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d49e40b2-2af2-5eab-a104-5eba2983ae5e" :question/math-academy-id "q-73393" :question/problem "Calculate $\\int \\frac{x}{7x+1}\\,\\text{d}x.$" :question/worked-solution "First, we pull out the factor of $7$ from the denominator:\n\n$$\n\\begin{aligned}\\int \\frac{x}{7x+1}\\,\\text{d}x & =\\int \\frac{x}{7(x+\\frac{1}{7})}\\,\\text{d}x \\\\  & =\\frac{1}{7}\\int \\frac{x}{(x+\\frac{1}{7})}\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ -\\frac{1}{7} & 1 & 0 \\\\  & ↓ & -\\frac{1}{7} \\\\  & 1 & -\\frac{1}{7}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{x}{(x+\\frac{1}{7})} & =1+\\frac{(-\\frac{1}{7})}{(x+\\frac{1}{7})} \\\\  & =1-\\frac{1}{7(x+\\frac{1}{7})} \\\\  & =1-\\frac{1}{7x+1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{x}{7x+1}\\,\\text{d}x & =\\frac{1}{7}\\int (1-\\frac{1}{7x+1})\\text{d}x \\\\  & =\\frac{1}{7}[\\int \\text{d}x-\\int \\frac{1}{7x+1}\\,\\text{d}x] \\\\  & =\\frac{1}{7}[x-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|]+C \\\\  & =\\frac{x}{7}-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341969 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1fd377a2-95d6-5fde-b6fb-edd9f6c82895" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339404} {:answer/id #uuid "3886b9bb-57fc-5b04-9e14-43198654677d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339636} {:answer/id #uuid "a97ece83-bf8e-5d12-9343-39690fdb4170" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(2)" :db/id #edb/ref 17592186340671} {:answer/id #uuid "ba478bc4-e72f-56ec-9e2c-5aa0ce4151f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186340796} {:answer/id #uuid "ea3a1f4f-8538-5b6c-a02c-9ceb12a2d036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186341196}] :answer-field/correct {:answer/id #uuid "ea3a1f4f-8538-5b6c-a02c-9ceb12a2d036" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3})" :db/id #edb/ref 17592186341196} :answer-field/id #uuid "1d077c61-6966-5590-ac4c-55b42acccc9c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341432}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "76b52539-5773-539b-aa13-33f834965a19" :question/math-academy-id "q-73432" :question/problem "Calculate the definite integral ${\\int }_{0}^{2}\\frac{{x}^{3}}{{x}^{4}+9}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{4}+9 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =4{x}^{3} \\\\ \\text{d}u & =4{x}^{3}\\,\\text{d}x \\\\ \\frac{1}{4}\\text{d}u & ={x}^{3}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{4}+9.$ \n\n$$\n\\begin{aligned}x & 0 & 2 \\\\ u & 9 & 25\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{0}^{2}\\frac{1}{({x}^{4}+9)}\\,{x}^{3}\\,\\text{d}x={\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{9}^{25}\\frac{1}{u}\\cdot \\frac{1}{4}\\text{d}u & =\\frac{1}{4}{\\int }_{9}^{25}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{ln}⁡(u){|}_{9}^{25} \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡(25)-\\operatorname{ln}⁡(9)) \\\\  & =\\frac{1}{4}(\\operatorname{ln}⁡({5}^{2})-\\operatorname{ln}⁡({3}^{2})) \\\\  & =\\frac{1}{4}(2\\operatorname{ln}⁡(5)-2\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{4}\\cdot 2(\\operatorname{ln}⁡(5)-\\operatorname{ln}⁡(3)) \\\\  & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{3}).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341970 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a79382-4e7c-5565-8f8d-651f202629f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186339292} {:answer/id #uuid "5502a3b1-d9e4-5a34-9dd4-491eeed2b23f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186339908} {:answer/id #uuid "7087f43f-c9bf-565d-98ab-1b54c5d110f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(\\frac{3}{2})" :db/id #edb/ref 17592186340127} {:answer/id #uuid "82ee8f5a-e3ab-507f-9c16-8da87f52b8bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186340304} {:answer/id #uuid "edc21a13-792e-5848-97d2-4e2185d5c45b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186341227}] :answer-field/correct {:answer/id #uuid "82ee8f5a-e3ab-507f-9c16-8da87f52b8bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{ln}⁡(3)" :db/id #edb/ref 17592186340304} :answer-field/id #uuid "d1ca444a-b6c3-53c4-8f09-a91cb7eeef34" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "12e14ad3-9d99-5fee-b75f-bd6aa0861881" :question/math-academy-id "q-73434" :question/problem "Calculate the definite integral ${\\int }_{-1}^{1}\\frac{{x}^{2}}{{x}^{3}+2}\\,\\text{d}x.$" :question/worked-solution "We start by changing the variable:\n\n$$\n\\begin{aligned}u & ={x}^{3}+2 \\\\ \\frac{\\text{d}u}{\\text{d}x} & =3{x}^{2} \\\\ \\text{d}u & =3{x}^{2}\\,\\text{d}x \\\\ \\frac{1}{3}\\text{d}u & ={x}^{2}\\,\\text{d}x\\end{aligned}\n$$\n\nNext, we create a table for the limits of integration using the rule $u={x}^{3}+2.$ \n\n$$\n\\begin{aligned}x & -1 & 1 \\\\ u & 1 & 3\\end{aligned}\n$$\n\nSo, the integral in terms of the new variable is\n\n$$\n{\\int }_{-1}^{1}\\frac{1}{({x}^{3}+2)}\\,{x}^{2}\\,\\text{d}x={\\int }_{1}^{3}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u.\n$$\n\nFinally, we can solve it and get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}\\frac{1}{u}\\cdot \\frac{1}{3}\\text{d}u & =\\frac{1}{3}{\\int }_{1}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(u){|}_{1}^{3} \\\\  & =\\frac{1}{3}(\\operatorname{ln}⁡(3)-\\operatorname{ln}⁡(1)) \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡(3).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "574af7f2-928a-5a00-b135-4916a6dec950" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186339926} {:answer/id #uuid "987816d8-ddea-5472-bfa6-60df165674be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}-\\frac{1}{2|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340500} {:answer/id #uuid "a07504e1-78da-53c1-a071-bf6d07bb482a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{x}}+\\frac{2}{x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340581} {:answer/id #uuid "c71ac88f-b329-53fd-a776-c30ee71c20b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{1}{2x\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340893} {:answer/id #uuid "c94af7b5-9c00-52e6-891e-6dbf2ca55530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340913}] :answer-field/correct {:answer/id #uuid "c94af7b5-9c00-52e6-891e-6dbf2ca55530" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}" :db/id #edb/ref 17592186340913} :answer-field/id #uuid "47d65433-3d6d-5565-a566-451d9ef6b0e8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341504}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "077baa93-9f9f-5780-986d-77a93ca959f7" :question/math-academy-id "q-73437" :question/problem "Calculate ${f}^{′}(x)$ if $f(x)=\\sqrt{x}-2arccscx.$" :question/worked-solution "The formula for the derivative of $arccsc$ is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(arccscx)=-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}.\n$$\n\nUsing the formula above, we obtain\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(\\sqrt{x}-2arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2\\cdot \\frac{\\text{d}}{\\text{d}x}(arccscx) \\\\  & =\\frac{1}{2\\sqrt{x}}-2(-\\frac{1}{|x|\\sqrt{{x}^{2}-1}}) \\\\  & =\\frac{1}{2\\sqrt{x}}+\\frac{2}{|x|\\sqrt{{x}^{2}-1}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "826695b2-7896-554a-b710-615a2ed245c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(1+x)arccotx}{x(1+{x}^{2})}" :db/id #edb/ref 17592186340302} {:answer/id #uuid "93f0db0d-31f3-5683-a714-07d8975da0bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186340458} {:answer/id #uuid "ca1c32a6-bafe-5590-8786-dbaa106a79b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1+{x}^{2}arccotx}{1+{x}^{2}}" :db/id #edb/ref 17592186340917} {:answer/id #uuid "cb871cf7-4c3d-5e61-967e-16852dd2a29f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}+arccotx}{1+{x}^{2}}" :db/id #edb/ref 17592186340931} {:answer/id #uuid "f5c4d346-27c8-58ed-bcdb-42b65dcb2294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{arccotx}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186341297}] :answer-field/correct {:answer/id #uuid "93f0db0d-31f3-5683-a714-07d8975da0bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}" :db/id #edb/ref 17592186340458} :answer-field/id #uuid "4c91fda9-15a2-5689-ae97-5f52a67803da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341514}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fde98232-ad33-5093-b3ee-9574c7c7e230" :question/math-academy-id "q-73447" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\frac{arccotx}{x}.$" :question/worked-solution "Here, we let $u(x)=arccotx$ and $v(x)=x$, and apply the quotient rule.\n\nWe use the formulae\n\n$$\n{u}^{′}(x)=-\\frac{1}{1+{x}^{2}}\\,\\text{and}\\,{v}^{′}(x)=1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{-\\frac{1}{1+{x}^{2}}\\cdot x-arccotx\\cdot 1}{{x}^{2}} \\\\  & =\\frac{-\\frac{x}{1+{x}^{2}}-arccotx}{{x}^{2}} \\\\  & =-\\frac{(\\frac{x+(1+{x}^{2})arccotx}{1+{x}^{2}})}{{x}^{2}} \\\\  & =-\\frac{x+(1+{x}^{2})arccotx}{{x}^{2}(1+{x}^{2})}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ba67c5c0-96ba-5252-813f-4cd1114b1c90" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468028} {:answer/id #uuid "13ba8213-a2f7-566e-b980-36df26232e53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468029}] :answer-field/correct {:answer/id #uuid "13ba8213-a2f7-566e-b980-36df26232e53" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468029} :answer-field/id #uuid "ae902587-9446-5ee5-a8a7-4011193f99b5" :answer-field/key "$[\\frac{1}{2},1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468735} {:answer-field/choices [{:answer/id #uuid "d08d9480-93aa-548c-b362-0d3f72fe027e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468030} {:answer/id #uuid "824165aa-6ef3-50f6-ac4f-7298a713ae60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468031}] :answer-field/correct {:answer/id #uuid "d08d9480-93aa-548c-b362-0d3f72fe027e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468030} :answer-field/id #uuid "454cc1b0-9c8b-546c-8b12-f617acd8c694" :answer-field/key "$[0,\\frac{1}{4})$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468736} {:answer-field/choices [{:answer/id #uuid "fec715a9-1922-5be7-9528-532f2fa723ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468032} {:answer/id #uuid "1a30d8c0-d20a-5ca4-8699-68e7f2c7d1a4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468033}] :answer-field/correct {:answer/id #uuid "fec715a9-1922-5be7-9528-532f2fa723ce" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468032} :answer-field/id #uuid "7770570e-24c3-51a1-8910-85b4d1c8c7d9" :answer-field/key "$[0,1]$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468737}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e05c6d3d-29e1-53ab-9c70-1ad2b27199a4" :question/math-academy-id "q-73486" :question/problem "On which of the following intervals can the extreme value theorem be applied to the function $y=\\operatorname{sin}⁡(\\frac{\\pi }{x})?$   \n\nSelect all that apply." :question/worked-solution "Remember that the extreme value theorem is only applicable to closed intervals on which the function is continuous. \n\nWith that in mind, let's take a look at each interval.\n\n- The interval $[\\frac{1}{2},1]$   is closed, and the function is continuous on $[\\frac{1}{2},1].$   Therefore, the extreme value theorem is applicable.\n\n- The interval $[0,\\frac{1}{4})$  is not closed, so the extreme value theorem is not applicable.\n\n- The interval $[0,1]$ is closed, but the function is not continuous on it because it is not defined at $x=0.$  Therefore, the extreme value theorem is not applicable.\n\nIn conclusion, the correct answer is $[\\frac{1}{2},1]$ only."} {:db/id #edb/ref 17592186341989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "04a7e63a-5e34-5d00-a029-7b7d1dae266f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186339163} {:answer/id #uuid "3d5f036e-ae00-5bec-a798-541577f1a585" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186339673} {:answer/id #uuid "ac79c25c-624e-5c03-b40d-f27d28728e90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186340702} {:answer/id #uuid "d5d66d24-d042-5488-9135-c0056b1b4edb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186341021} {:answer/id #uuid "d6fbd17a-7cce-55c3-8770-0555c5585b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186341034}] :answer-field/correct {:answer/id #uuid "d6fbd17a-7cce-55c3-8770-0555c5585b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186341034} :answer-field/id #uuid "137c1cfe-1762-59a5-bc01-704b012cbeca" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341413}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "95a2f566-eee4-598f-a09c-af5424f126be" :question/math-academy-id "q-73488" :question/problem "Calculate ${f}^{′}(x)$  for $f(x)=5-2\\operatorname{arccos}⁡x.$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(5-2\\operatorname{arccos}⁡x) \\\\  & =0-2\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x) \\\\  & =-2(-\\frac{1}{\\sqrt{1-{x}^{2}}}) \\\\  & =\\frac{2}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341992 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e8d0cfd-3ff7-53b6-a6fd-bb619fdf50f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{5}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186339261} {:answer/id #uuid "697a7597-286e-53a9-bc0b-bbff0b1352e5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{1}{5\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186340066} {:answer/id #uuid "8ac9957c-dca0-55c3-89cf-b033a094b6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{5}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186340370} {:answer/id #uuid "8c78568b-4e62-5fcd-91c1-dd4422bd167c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{5}{\\sqrt{1+{x}^{2}}}" :db/id #edb/ref 17592186340388} {:answer/id #uuid "f19faf0f-9d18-5173-950b-c15b38fd2b4f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2-\\frac{5}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186341256}] :answer-field/correct {:answer/id #uuid "8ac9957c-dca0-55c3-89cf-b033a094b6d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2+\\frac{5}{\\sqrt{1-{x}^{2}}}" :db/id #edb/ref 17592186340370} :answer-field/id #uuid "9b8c01fe-919d-5c86-bd39-b1e88ade5460" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341653}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12591823-d567-5fce-84b2-fe3d2ba9ebd9" :question/math-academy-id "q-73500" :question/problem "Calculate ${f}^{′}(x)$  for $f(x)=2x-5\\operatorname{arccos}⁡x.$" :question/worked-solution "The formula for the derivative of arccosine is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x)=-\\frac{1}{\\sqrt{1-{x}^{2}}}.\n$$\n\nUsing the formula above, we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{\\text{d}}{\\text{d}x}(2x-5\\operatorname{arccos}⁡x) \\\\  & =2-5\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡x) \\\\  & =2-5(-\\frac{1}{\\sqrt{1-{x}^{2}}}) \\\\  & =2+\\frac{5}{\\sqrt{1-{x}^{2}}}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341997 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5107a3c4-3fbf-5337-9f89-e57141f452ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{(5-x)\\operatorname{cos}⁡x}{\\sqrt{1+{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186339868} {:answer/id #uuid "949a3a25-4ea0-5db8-ac33-f429809b9743" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arcsin}⁡(5-x)" :db/id #edb/ref 17592186340462} {:answer/id #uuid "c813050e-2154-5157-bdbf-7a6cc5929db3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1+{(5-x)}^{2}}}+\\operatorname{sin}⁡x\\operatorname{arcsin}⁡(5-x)" :db/id #edb/ref 17592186340900} {:answer/id #uuid "da23eb94-e92b-5196-90af-b3e6e60c86f0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}+\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186341063} {:answer/id #uuid "ec969a7a-a331-5b85-ae7e-0cf433062a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186341213}] :answer-field/correct {:answer/id #uuid "ec969a7a-a331-5b85-ae7e-0cf433062a98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)" :db/id #edb/ref 17592186341213} :answer-field/id #uuid "96dc5de0-fcff-5a01-9b87-28b3beb33641" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341646}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "25fdd6ba-691e-5f6c-ab57-fe0cafbab12e" :question/math-academy-id "q-73510" :question/problem "Calculate $\\frac{\\text{d}y}{\\text{d}x}$ for $y=\\operatorname{cos}⁡x\\operatorname{arccos}⁡(5-x).$" :question/worked-solution "Applying the product rule, using the formula for the derivative of $\\operatorname{arccos}⁡x$ and applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x\\operatorname{arccos}⁡(5-x)) & =\\operatorname{arccos}⁡(5-x)\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)+\\operatorname{cos}⁡x\\cdot \\frac{\\text{d}}{\\text{d}x}(\\operatorname{arccos}⁡(5-x)) \\\\  & =\\operatorname{arccos}⁡(5-x)\\cdot (-\\operatorname{sin}⁡x)+\\operatorname{cos}⁡x\\cdot (-\\frac{1}{\\sqrt{1-{(5-x)}^{2}}})\\cdot \\frac{\\text{d}}{\\text{d}x}(5-x) \\\\  & =-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x)-\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}\\cdot (-1) \\\\  & =\\frac{\\operatorname{cos}⁡x}{\\sqrt{1-{(5-x)}^{2}}}-\\operatorname{sin}⁡x\\operatorname{arccos}⁡(5-x).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186341998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0abf4c72-fdb0-5af9-b5fd-ae0fef31f40e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}-2" :db/id #edb/ref 17592186339218} {:answer/id #uuid "3006d583-f16e-5d0e-b844-fb9f46126f3a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}-3" :db/id #edb/ref 17592186339547} {:answer/id #uuid "58ac14b0-18e4-5654-8906-1f8fbd918eda" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}+2" :db/id #edb/ref 17592186339935} {:answer/id #uuid "790e0574-3d28-597c-9244-19f4d13a9da3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{3}+1" :db/id #edb/ref 17592186340206} {:answer/id #uuid "e92f8177-dba9-5a06-8301-1ec125054798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}-2\\sqrt{3}" :db/id #edb/ref 17592186341183}] :answer-field/correct {:answer/id #uuid "e92f8177-dba9-5a06-8301-1ec125054798" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}-2\\sqrt{3}" :db/id #edb/ref 17592186341183} :answer-field/id #uuid "2f35a480-d276-5dfc-a868-82f4e34bed3f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341461}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "00a7e7d3-20f3-5e6c-9ee5-254f2e2cf50c" :question/math-academy-id "q-73513" :question/problem "Evaluate ${\\int }_{\\pi /4}^{\\pi /3}\\frac{3({cot}^{2}⁡x+1)}{\\operatorname{tan}⁡x\\operatorname{csc}⁡x}\\,\\text{d}x.$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Substituting this into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /3}\\frac{3({cot}^{2}⁡x+1)}{\\operatorname{tan}⁡x\\operatorname{csc}⁡x}\\,\\text{d}x & =3{\\int }_{\\pi /4}^{\\pi /3}\\frac{{cot}^{2}⁡x+1}{\\operatorname{tan}⁡x\\operatorname{csc}⁡x}\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /4}^{\\pi /3}\\frac{{csc}^{2}⁡x}{\\operatorname{tan}⁡x\\operatorname{csc}⁡x}\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /4}^{\\pi /3}\\frac{\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /4}^{\\pi /3}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =-3\\operatorname{csc}⁡x\\,{|}_{\\pi /4}^{\\pi /3} \\\\  & =-3\\operatorname{csc}⁡(\\frac{\\pi }{3})+3\\operatorname{csc}⁡(\\frac{\\pi }{4}) \\\\  & =-3\\cdot \\frac{2}{\\sqrt{3}}+3\\cdot \\sqrt{2} \\\\  & =3\\sqrt{2}-2\\sqrt{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "37ed3ec8-3905-5f6f-9a2f-2ab7735300df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}-1" :db/id #edb/ref 17592186339631} {:answer/id #uuid "39a3f0e3-caa9-547e-af78-d5299cb72d29" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186339648} {:answer/id #uuid "74fac45e-7687-567e-92e4-c173b3b7bbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{192}" :db/id #edb/ref 17592186340175} {:answer/id #uuid "a9b65dd6-83c1-553c-b33b-ed750172fcaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186340673} {:answer/id #uuid "ab841e54-a3a9-54bf-8504-9fbb5b804b16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{3}-1" :db/id #edb/ref 17592186340691}] :answer-field/correct {:answer/id #uuid "74fac45e-7687-567e-92e4-c173b3b7bbed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{192}" :db/id #edb/ref 17592186340175} :answer-field/id #uuid "fe1bbcec-fcbd-576d-8667-2c78a327af54" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341833}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "229fa8ac-a324-584e-838d-1dd2b70fd89a" :question/math-academy-id "q-73525" :question/problem "Evaluate ${\\int }_{0}^{\\pi /4}({x}^{2}{sec}^{2}⁡x-{x}^{2}{tan}^{2}⁡x)\\,\\text{d}x.$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n{tan}^{2}⁡x+1={sec}^{2}⁡x\\,⟹\\,{sec}^{2}⁡x-{tan}^{2}⁡x=1.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}({x}^{2}{sec}^{2}⁡x-{x}^{2}{tan}^{2}⁡x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}{x}^{2}({sec}^{2}⁡x-{tan}^{2}⁡x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{1}{3}{x}^{3}\\,{|}_{0}^{\\pi /4} \\\\  & =\\frac{1}{3}[{(\\frac{\\pi }{4})}^{3}-{0}^{3}] \\\\  & =\\frac{1}{3}\\cdot \\frac{{\\pi }^{3}}{64} \\\\  & =\\frac{{\\pi }^{3}}{192}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342007 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f092e91-4f61-5603-80d5-8a93282c6a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186339399} {:answer/id #uuid "5d2c2bab-1eca-5488-9001-c674cb08e279" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339967} {:answer/id #uuid "896af8fb-37f5-589c-b238-bbb774191209" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186340354} {:answer/id #uuid "9f3d592d-784d-5142-ab34-93f237937bc6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186340566} {:answer/id #uuid "c8d18828-18be-5809-990c-92d134b043c3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340907}] :answer-field/correct {:answer/id #uuid "1f092e91-4f61-5603-80d5-8a93282c6a99" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186339399} :answer-field/id #uuid "6d3c55f3-ba0b-5134-9af5-27dd30e3aab6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341570}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "661506d6-91ed-5312-9a5a-a709acc23a76" :question/math-academy-id "q-73539" :question/problem "Evaluate ${lim}_{x\\to 0}(-\\frac{\\operatorname{sin}⁡x}{4x}).$" :question/worked-solution "Notice that as $x\\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{x\\to 0}(-\\frac{\\operatorname{sin}⁡x}{4x})=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{x}=1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}(-\\frac{\\operatorname{sin}⁡x}{4x}) & ={lim}_{x\\to 0}(-\\frac{1}{4}\\cdot \\frac{\\operatorname{sin}⁡x}{x}) \\\\  & =-\\frac{1}{4}\\cdot {lim}_{x\\to 0}\\,\\frac{\\operatorname{sin}⁡x}{x} \\\\  & =-\\frac{1}{4}\\cdot 1 \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342010 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38ccfea7-fed5-5b7e-bc09-bcd69091da1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339639} {:answer/id #uuid "60022a80-d927-5a41-9b20-e5576e6438cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186339983} {:answer/id #uuid "89a04548-acfb-5947-b2ac-4e7dff064d97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340356} {:answer/id #uuid "afb751a0-88c2-502a-8157-5752b308f317" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186340732} {:answer/id #uuid "b36db622-271e-564e-927d-d6a6763d261f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340759}] :answer-field/correct {:answer/id #uuid "b36db622-271e-564e-927d-d6a6763d261f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340759} :answer-field/id #uuid "c3b2bee7-ee63-5f93-be18-3bd951bd1c77" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341719}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b53097b6-0795-598d-9c41-894871fbb1f5" :question/math-academy-id "q-73546" :question/problem "Find the value of ${lim}_{\\theta \\to 0}\\,\\frac{{sec}^{2}⁡\\theta -1}{{\\theta }^{2}}.$" :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{{sec}^{2}⁡\\theta -1}{{\\theta }^{2}} & ={lim}_{\\theta \\to 0}\\,\\frac{{tan}^{2}⁡\\theta }{{\\theta }^{2}} \\\\  & ={lim}_{\\theta \\to 0}\\,\\frac{(\\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta })}{{\\theta }^{2}} \\\\  & ={lim}_{\\theta \\to 0}(\\frac{1}{{\\theta }^{2}}\\cdot \\frac{{sin}^{2}⁡\\theta }{{cos}^{2}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}}\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{{cos}^{2}⁡\\theta }\\end{aligned}\n$$\n\nLet's now evaluate the limits separately:\n\n- Consider the first limit. Notice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$ \n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}}=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form. \n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}} & ={lim}_{\\theta \\to 0}{(\\frac{\\operatorname{sin}⁡\\theta }{\\theta })}^{2} \\\\  & ={[{lim}_{\\theta \\to 0}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }]}^{2} \\\\  & ={1}^{2} \\\\  & =1\\end{aligned}\n$$\n\n- Consider the second limit. Evaluating it directly, we get\n\n$$\n{lim}_{\\theta \\to 0}\\,\\frac{1}{{cos}^{2}⁡\\theta }=\\frac{1}{{cos}^{2}⁡0}=1.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{{sin}^{2}⁡\\theta }{{\\theta }^{2}}\\cdot {lim}_{\\theta \\to 0}\\,\\frac{1}{{cos}^{2}⁡\\theta } & =1\\cdot 1=1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342011 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d345055-9b62-57cb-a650-376c71bdaf48" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186339250} {:answer/id #uuid "1a355ba7-59df-5715-839b-894a85f6b5a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186339362} {:answer/id #uuid "7fa857a9-298e-5270-9039-2f08d9b01bb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186340276} {:answer/id #uuid "8640ec44-7aa5-5d0f-99c0-6c9e79dd9b4a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186340331} {:answer/id #uuid "b9cf22d6-469a-5111-9eda-634188852461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340793}] :answer-field/correct {:answer/id #uuid "b9cf22d6-469a-5111-9eda-634188852461" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186340793} :answer-field/id #uuid "84f28dba-00cd-5409-8f84-135559291063" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341613}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "68873e64-d445-55f6-917a-87964a442029" :question/math-academy-id "q-73548" :question/problem "Find the value of ${lim}_{\\theta \\to 0}\\,\\frac{\\theta \\operatorname{sec}⁡\\theta }{\\operatorname{tan}⁡\\theta }.$" :question/worked-solution "First, we can simplify the limit using trigonometric identities, as follows:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{\\theta \\operatorname{sec}⁡\\theta }{\\operatorname{tan}⁡\\theta } & ={lim}_{\\theta \\to 0}(\\theta \\operatorname{sec}⁡\\theta ÷\\operatorname{tan}⁡\\theta ) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{\\theta }{\\operatorname{cos}⁡\\theta }÷\\frac{\\operatorname{sin}⁡\\theta }{\\operatorname{cos}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 0}(\\frac{\\theta }{\\operatorname{cos}⁡\\theta }\\cdot \\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }) \\\\  & ={lim}_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nNotice that as $\\theta \\to 0,$ both numerator and denominator approach $0.$\n\nSo, if we attempt to evaluate the limit directly, we get\n\n$$\n{lim}_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta }=\\frac{0}{0},\n$$\n\nwhich is an indeterminate form.\n\nInstead, let's recall the following special limit:\n\n$$\n{lim}_{\\theta \\to 0}\\frac{\\operatorname{sin}⁡\\theta }{\\theta }=1\n$$\n\nRewriting the given limit using the algebra of limits and applying our special limit, we get the following:\n\n$$\n\\begin{aligned}{lim}_{\\theta \\to 0}\\,\\frac{\\theta }{\\operatorname{sin}⁡\\theta } & ={lim}_{\\theta \\to 0}{(\\frac{\\operatorname{sin}⁡\\theta }{\\theta })}^{-1} \\\\  & ={[{lim}_{\\theta \\to 0}\\,\\frac{\\operatorname{sin}⁡\\theta }{\\theta }]}^{-1} \\\\  & ={1}^{-1} \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342019 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27e36dff-223f-5b4e-b1b4-209444ae4750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186339475} {:answer/id #uuid "295c3085-d512-5a69-92dc-71d06b0bdf20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186339493} {:answer/id #uuid "83e36855-c02f-53e9-947d-e5e2682c194d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{6}" :db/id #edb/ref 17592186340315} {:answer/id #uuid "9b3f0e3a-443b-558d-9213-98e89a32d936" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186340527} {:answer/id #uuid "daea0c65-3b56-5a21-bd69-1ef30a29e1c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2\\pi }{3}" :db/id #edb/ref 17592186341072}] :answer-field/correct {:answer/id #uuid "27e36dff-223f-5b4e-b1b4-209444ae4750" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{12}" :db/id #edb/ref 17592186339475} :answer-field/id #uuid "b0dec351-1e40-54db-9221-0fdc8d5c0c71" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341691}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f9ea65f-55fc-5861-a64a-a45dd398be77" :question/math-academy-id "q-73578" :question/problem "Evaluate the repeated integral\n${\\int }_{0}^{1/2}{\\int }_{1}^{2}\\frac{1}{{x}^{2}\\sqrt{1-{y}^{2}}}\\,\\text{d}x\\,\\text{d}y.$" :question/worked-solution "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}[{\\int }_{1}^{2}\\frac{1}{{x}^{2}\\sqrt{1-{y}^{2}}}\\,\\text{d}x]\\text{d}y & ={\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{y}^{2}}}[{\\int }_{1}^{2}\\frac{1}{{x}^{2}}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{y}^{2}}}{[-\\frac{1}{x}]}_{1}^{2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{y}^{2}}}(-\\frac{1}{2}-(-1))\\text{d}y \\\\  & ={\\int }_{0}^{1/2}\\frac{1}{2\\sqrt{1-{y}^{2}}}\\text{d}y\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/2}\\frac{1}{2\\sqrt{1-{y}^{2}}}\\text{d}y & =\\frac{1}{2}[\\operatorname{arcsin}⁡y]_{0}^{1/2} \\\\  & =\\frac{1}{2}(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡0) \\\\  & =\\frac{1}{2}(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi }{12}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342027 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16c0dc97-1bfa-5226-9e8a-83188a4da218" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3" :db/id #edb/ref 17592186339328} {:answer/id #uuid "3785646e-da4d-5ce4-884b-7241e989b715" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186339627} {:answer/id #uuid "6b813e4f-15f3-5ca2-a873-e38985156d55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡3" :db/id #edb/ref 17592186340080} {:answer/id #uuid "7c522d09-2793-56be-8f5f-51c906dc7f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186340247} {:answer/id #uuid "7ce6c823-b30e-5a3f-ac0b-98f3964eefdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186340254}] :answer-field/correct {:answer/id #uuid "7c522d09-2793-56be-8f5f-51c906dc7f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{\\operatorname{ln}⁡3}" :db/id #edb/ref 17592186340247} :answer-field/id #uuid "dc74d58b-4531-5b1b-ba07-fd90641c83fa" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341768}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69cbca99-1555-5b49-9e0d-f5bfd292b88d" :question/math-academy-id "q-73601" :question/problem "Evaluate the repeated integral ${\\int }_{0}^{1}{\\int }_{{e}^{-1}}^{{e}^{3}}\\frac{{3}^{x}}{y}\\,\\text{d}y\\,\\text{d}x.$" :question/worked-solution "First, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:    \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{{e}^{-1}}^{{e}^{3}}\\frac{{3}^{x}}{y}\\,\\text{d}y]\\text{d}x & ={\\int }_{0}^{1}{3}^{x}[{\\int }_{{e}^{-1}}^{{e}^{3}}\\frac{1}{y}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{1}{3}^{x}[\\operatorname{ln}⁡y]_{{e}^{-1}}^{{e}^{3}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{3}^{x}(\\operatorname{ln}⁡{e}^{3}-\\operatorname{ln}⁡{e}^{-1})\\text{d}x \\\\  & ={\\int }_{0}^{1}{3}^{x}(3+1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4\\cdot {3}^{x}\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}4\\cdot {3}^{x}\\,\\text{d}x & =4{[\\frac{{3}^{x}}{\\operatorname{ln}⁡3}]}_{0}^{1} \\\\  & =4(\\frac{{3}^{1}-{3}^{0}}{\\operatorname{ln}⁡3}) \\\\  & =\\frac{8}{\\operatorname{ln}⁡3}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342034 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01a99ac4-61b4-5a56-b3ac-d93de9f9dd89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{9{y}^{2}}{4}=1" :db/id #edb/ref 17592186339144} {:answer/id #uuid "4904f1fc-dc77-524c-af2d-813ee70dcc8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186339783} {:answer/id #uuid "a8efa69b-78be-5a02-81b6-baa9e8fedd59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186340664} {:answer/id #uuid "cdd060fa-0631-5438-80c1-f6c14e340129" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{9}=1" :db/id #edb/ref 17592186340956} {:answer/id #uuid "d6c989e2-03ee-581f-83f6-e95b613b2103" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{4}+\\frac{9{y}^{2}}{4}=1" :db/id #edb/ref 17592186341033}] :answer-field/correct {:answer/id #uuid "4904f1fc-dc77-524c-af2d-813ee70dcc8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9}=1" :db/id #edb/ref 17592186339783} :answer-field/id #uuid "013f1fb3-558e-5ad1-b4b7-34a42443c53c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341385}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "65bcf244-fd2b-540c-b6fb-6b4c12786b6a" :question/math-academy-id "q-73619" :question/problem "![](images/86/8637901efc126236b190e7012cf65a06be078cb21c3093eff39b927493000138.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the equation of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the horizontal radius has length $a=3$ and the vertical radius has length $b=1.5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{1.5}^{2}} & =1 \\\\ \\frac{{x}^{2}}{{3}^{2}}+\\frac{{y}^{2}}{{(\\frac{3}{2})}^{2}} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{(\\frac{{3}^{2}}{{2}^{2}})} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{{y}^{2}}{(\\frac{9}{4})} & =1 \\\\ \\frac{{x}^{2}}{9}+\\frac{4{y}^{2}}{9} & =1.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ba9b513-fd9e-5532-ac97-f39096b6d80d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡7" :db/id #edb/ref 17592186339229} {:answer/id #uuid "5146b66f-c081-5a5d-8a49-9465f6a29017" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}" :db/id #edb/ref 17592186339874} {:answer/id #uuid "6f33def5-e388-5e0c-8e27-ef1debc47437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186340114} {:answer/id #uuid "f3b7ff34-6e45-5d0f-881a-f864fd3aefad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7" :db/id #edb/ref 17592186341276} {:answer/id #uuid "fc039a6e-3ced-5554-821f-11c2bfcbf96a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡7" :db/id #edb/ref 17592186341355}] :answer-field/correct {:answer/id #uuid "6f33def5-e388-5e0c-8e27-ef1debc47437" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186340114} :answer-field/id #uuid "71a8e5ea-7823-5b4d-bd7c-7ee99e3470da" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341575}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f9fa12f0-8b86-59fd-acb9-b45aae5f88d9" :question/math-academy-id "q-73658" :question/problem "What is the value of ${\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{7}⁡(\\frac{x}{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡7}\\cdot \\frac{1}{3}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $21$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x & ={\\int }_{3}^{21}{log}_{7}⁡(\\frac{x}{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot (1-0) \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342057 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c85fd39-fb12-5fd0-84ca-1f9410fd86c2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186339238} {:answer/id #uuid "35d01e19-8df6-5a98-9a4e-a13ff45e59c6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{6}{\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186339607} {:answer/id #uuid "ba62682b-6375-50c8-ab0e-ae65ecff8935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186340799} {:answer/id #uuid "f040dd33-55b8-577d-b65c-882719ad8257" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3\\operatorname{ln}⁡2}\\sqrt{{2}^{x}-5}+C" :db/id #edb/ref 17592186341244} {:answer/id #uuid "fbec05e7-3328-5ebb-a6b8-92e98b6e67b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186341354}] :answer-field/correct {:answer/id #uuid "ba62682b-6375-50c8-ab0e-ae65ecff8935" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C" :db/id #edb/ref 17592186340799} :answer-field/id #uuid "9475f005-9702-55df-8eb5-e3d9087d1fde" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341643}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4d8e2bdb-04c0-5bb8-8174-6e672a971ff9" :question/math-academy-id "q-73669" :question/problem "Calculate the integral $\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x.$" :question/worked-solution "Let's introduce the new variable $u={2}^{x}-5.$ Differentiating gives\n\n$$\n\\begin{aligned}\\frac{\\text{d}u}{\\text{d}x} & ={2}^{x}\\operatorname{ln}⁡2\\,⟹\\,\\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u={2}^{x}\\,\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int {2}^{x+1}\\sqrt{{2}^{x}-5}\\,\\text{d}x & =\\int 2\\cdot {2}^{x}\\sqrt{{2}^{x}-5}\\,\\text{d}x \\\\  & =2\\int \\sqrt{{2}^{x}-5}\\cdot {2}^{x}\\,\\text{d}x \\\\  & =2\\int \\sqrt{u}\\cdot \\frac{1}{\\operatorname{ln}⁡2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{{u}^{3/2}}{(\\frac{3}{2})}+C \\\\  & =\\frac{2}{\\operatorname{ln}⁡2}\\cdot \\frac{2}{3}\\cdot {u}^{3/2} \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{{u}^{3}}+C \\\\  & =\\frac{4}{3\\operatorname{ln}⁡2}\\sqrt{({2}^{x}-5)^{3}}+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2383613a-52a1-5d64-8c26-ecd04de30f0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186339435} {:answer/id #uuid "4c648079-c85a-5f5e-8976-d0479a4da8f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{arcsin}⁡(2x)+C" :db/id #edb/ref 17592186339821} {:answer/id #uuid "6b5550ab-a530-5982-a558-83f8aec51f26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186340078} {:answer/id #uuid "7c200317-7a2d-5a1a-9a82-89183fc7851c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186340244} {:answer/id #uuid "ec37b5d7-c2b9-52a3-ad41-1f64c1e8cd40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186341210}] :answer-field/correct {:answer/id #uuid "ec37b5d7-c2b9-52a3-ad41-1f64c1e8cd40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186341210} :answer-field/id #uuid "ba24916a-286f-51a8-ad99-99bcf753abe6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341703}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "279b83c3-9e48-526a-b453-9a5fa23b12aa" :question/math-academy-id "q-73712" :question/problem "$\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:   \n\n$$\n\\begin{aligned}\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =\\frac{8}{3}\\int \\frac{1}{\\sqrt{4\\cdot (1-{x}^{2}/4)}}\\,\\text{d}x \\\\  & =\\frac{8}{3}\\cdot \\frac{1}{2}\\int \\frac{1}{\\sqrt{1-{x}^{2}/4}}\\,\\text{d}x \\\\  & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2})}^{2}.$ \n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\n \n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{3\\sqrt{4-{x}^{2}}}\\,\\text{d}x & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-(x/2)^{2}}}\\,\\text{d}x \\\\  & =\\frac{4}{3}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (2\\,\\text{d}u) \\\\  & =\\frac{8}{3}\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{8}{3}\\operatorname{arcsin}⁡u+C \\\\  & =\\frac{8}{3}\\operatorname{arcsin}⁡(\\frac{x}{2})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342065 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26b8753a-d28b-5470-8f73-93050c06c08a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(6x)+C" :db/id #edb/ref 17592186339465} {:answer/id #uuid "6b85678e-6139-5d36-af17-0b94102122cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186340081} {:answer/id #uuid "a2fa1f1a-bb6b-520e-bae1-d824104a01c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186340605} {:answer/id #uuid "ab8d3b36-56c7-55f4-abd1-ab704350e9ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(6x)+C" :db/id #edb/ref 17592186340693} {:answer/id #uuid "fb91a9c0-e0c4-502a-ae2f-5e69dfe1bc66" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{arctan}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186341351}] :answer-field/correct {:answer/id #uuid "6b85678e-6139-5d36-af17-0b94102122cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{6})+C" :db/id #edb/ref 17592186340081} :answer-field/id #uuid "1611e707-c42e-5085-bbf5-4935f8f58d88" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341418}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "93802a48-b09b-52e0-870e-185ec5edc9c1" :question/math-academy-id "q-73714" :question/problem "$\\int \\frac{3}{36+{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{3}{36+{x}^{2}}\\,\\text{d}x & =\\int \\frac{3}{36\\cdot (1+{x}^{2}/36)}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\int \\frac{1}{1+{x}^{2}/36}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\int \\frac{1}{1+(x/6)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{6})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{6}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{6}\\,⟹\\,\\text{d}x=6\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{36+{x}^{2}}\\,\\text{d}x & =\\frac{1}{12}\\int \\frac{1}{1+(x/6)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{12}\\int \\frac{1}{1+{u}^{2}}\\cdot (6\\,\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{6})+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342107 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24393bc5-cc65-5e3e-98d5-bdf42d918ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -4 & 2 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339443} {:answer/id #uuid "30b246de-242f-5409-a5b0-f469ba1027d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -4 & 2 & -8 \\\\ 0 & 1 & 3 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339555} {:answer/id #uuid "35d2bc95-71a2-5fc7-a101-f077b2a9529a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 4 & -2 & 8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339608} {:answer/id #uuid "96c93863-ac3c-584e-9322-9f6459bd4e26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -4 & 2 & -8 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & 2\\end{bmatrix}" :db/id #edb/ref 17592186340488} {:answer/id #uuid "dd7d4bb5-9f5b-5845-81de-98e1414b3d21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & 2 & -4 & 8 \\\\ 0 & 0 & 1 & 0 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}" :db/id #edb/ref 17592186341096}] :answer-field/correct {:answer/id #uuid "24393bc5-cc65-5e3e-98d5-bdf42d918ab8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "M∼\\begin{bmatrix}1 & -4 & 2 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186339443} :answer-field/id #uuid "13d054be-a958-5c0b-b082-28a19f6e300f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341415}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5afdcd66-6368-5354-bd74-a259df30653f" :question/math-academy-id "q-73918" :question/problem "Consider the system\n\n$$\n\\left\\{\\begin{aligned}-{x}_{1}+4{x}_{2}-2{x}_{3} &=8 \\\\ -5{x}_{1}+20{x}_{2}-10{x}_{3} &=40 \\\\ \\frac{1}{2}{x}_{1}-2{x}_{2}+{x}_{3} &=-4.\\end{aligned}\\right.\n$$\n\nUse the standard method of Gaussian elimination to reduce the augmented matrix $M$ of the system to row echelon form." :question/worked-solution "The augmented matrix for the system is\n\n$$\nM=\\begin{bmatrix}-1 & 4 & -2 & 8 \\\\ -5 & 20 & -10 & 40 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{bmatrix}.\n$$\n\nReducing $M$ to echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}-1 & 4 & -2 & 8 \\\\ -5 & 20 & -10 & 40 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{bmatrix} & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & 2 & -8 \\\\ -5 & 20 & -10 & 40 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}+5{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & 2 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ \\frac{1}{2} & -2 & 1 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -4 & 2 & -8 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342191 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c99a152a-4432-58e7-8095-7a6594ae2e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468088} {:answer/id #uuid "ed1282bf-bb72-590a-82cb-57afddffd291" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468089}] :answer-field/correct {:answer/id #uuid "c99a152a-4432-58e7-8095-7a6594ae2e82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468088} :answer-field/id #uuid "1bf27b0a-4178-50bb-a563-2416eaa07855" :answer-field/key "$\\begin{gathered}A=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}<\\frac{1}{2}\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468765} {:answer-field/choices [{:answer/id #uuid "75291599-266c-544e-b704-be929998cc4a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468090} {:answer/id #uuid "cf437d27-edd1-584d-be5b-b58d1bf9be5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468091}] :answer-field/correct {:answer/id #uuid "cf437d27-edd1-584d-be5b-b58d1bf9be5f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468091} :answer-field/id #uuid "11bc94d4-2ccf-5ec6-bfea-1ec2f439dda1" :answer-field/key "$\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5x-y-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468766} {:answer-field/choices [{:answer/id #uuid "90497ddb-e287-5539-b1a1-cd58a7c31e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468092} {:answer/id #uuid "80442660-0495-5466-89ce-25cccd762bbb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186468093}] :answer-field/correct {:answer/id #uuid "90497ddb-e287-5539-b1a1-cd58a7c31e1d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186468092} :answer-field/id #uuid "dc40e59a-282b-5ffd-8ff6-51c6739169ba" :answer-field/key "$\\begin{gathered}C=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5-x-z=0\\end{gathered}\\right\\}\\end{gathered}$" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186468767}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb81e4a8-c5a7-59da-b168-b278b747b24a" :question/math-academy-id "q-74255" :question/problem "Which of the following sets is a subspace of ${R}^{3}?$\n\nSelect all that apply." :question/worked-solution "Let's analyze each of the subsets.\n\n- The set $A$ is not a subspace. Indeed, the vector $u=⟨\\frac{1}{4},0,0⟩$ is in $A$, since\n\n$$\n\\sqrt{{(\\frac{1}{4})}^{2}+{0}^{2}+{0}^{2}}=\\frac{1}{4}<\\frac{1}{2},\n$$\n\nbut, $4u=⟨1,0,0⟩$ is not in $B$, since \n\n$$\n\\sqrt{{1}^{2}+{0}^{2}+{0}^{2}}>\\frac{1}{2}.\n$$\n\nSo, $A$ is not closed under scalar multiplication.\n\n- The set $B$ is a subspace. It represents a plane, and a plane is a subspace if and only if it passes through the origin. Here, the components of the zero vector $0=⟨0,0,0⟩$ satisfy the equation $5x-y-z=0$ since $5\\cdot 0-0-0=0.$ So $0$ lies in $B.$\n\n- The set $C$ is not a subspace because it does not contain the zero vector. Indeed, $0=⟨0,0,0⟩$ does not satisfy the equation $5-x-z=0$ since $5-0-0\\ne 0.$\n\nIn conclusion, the correct answer is $\\begin{gathered}B=\\left\\{\\begin{gathered}⟨x,y,z⟩\\in {R}^{3}:\\\\5x-y-z=0\\end{gathered}\\right\\}\\end{gathered}$ only."} {:db/id #edb/ref 17592186342193 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c30e3f-d29e-5013-9514-d17c3eee3460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186339466} {:answer/id #uuid "376779f8-ab66-595c-9bd0-478fd63c0239" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{csc}^{2}⁡x+C" :db/id #edb/ref 17592186339625} {:answer/id #uuid "447b1d64-6d6b-508d-818e-c81c4fc983e8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186339733} {:answer/id #uuid "744da144-5af4-5254-8514-317a1d8d743d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{csc}⁡x\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186340164} {:answer/id #uuid "cf6a59f6-df8c-5517-879f-5849fb7de659" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡x+C" :db/id #edb/ref 17592186340974}] :answer-field/correct {:answer/id #uuid "26c30e3f-d29e-5013-9514-d17c3eee3460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186339466} :answer-field/id #uuid "ede24e4d-4785-5cd1-8533-d9afadca7785" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341806}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "504ab9d3-58bf-5555-aee6-cd8fa47fea51" :question/math-academy-id "q-74281" :question/problem "Calculate $\\int \\frac{1-{cot}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{1-{cot}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x=\\int (1-{cot}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}$ as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1-{cot}^{2}⁡x}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x & =\\int (1-{cot}^{2}⁡x)\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int (1-\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int (\\frac{{sin}^{2}⁡x-{cos}^{2}⁡x}{{sin}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =-\\int (\\frac{{cos}^{2}⁡x-{sin}^{2}⁡x}{{sin}^{2}⁡x})\\cdot \\frac{1}{{cos}^{2}⁡x-{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =-\\int \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x\\end{aligned}\n$$\n\nNow we use the fact that $\\frac{1}{\\operatorname{sin}⁡x}=\\operatorname{csc}⁡x$ to express this as\n\n$$\n-\\int {csc}^{2}⁡x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}-\\int {csc}^{2}⁡x\\,\\text{d}x & =-(-\\operatorname{cot}⁡x)+C \\\\  & =\\operatorname{cot}⁡x+C.\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342207 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cc56d0d-1fc1-55b0-a858-0f72c1814fa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186339244} {:answer/id #uuid "222afa10-e65e-535c-b778-59ff5f57e53e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186339420} {:answer/id #uuid "3ab24c23-c3cd-5916-8d10-f8f9cd41df90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186339654} {:answer/id #uuid "5240e2fd-ff1b-54d0-9ace-5be02e2c6a9e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186339885} {:answer/id #uuid "839765cf-3921-5bbd-be4f-c72628e60a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186340311}] :answer-field/correct {:answer/id #uuid "839765cf-3921-5bbd-be4f-c72628e60a10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186340311} :answer-field/id #uuid "19e95e6b-57c0-5f5a-83f7-9b72881b2c92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341426}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ded7813f-7862-5c34-8d67-a2dd0cf18a45" :question/math-academy-id "q-74412" :question/problem "$\\int (1-2{sin}^{2}⁡(\\frac{x}{2}))\\text{d}x=$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta \n$$\n\nLetting $\\theta =\\frac{x}{2}$, we have\n\n$$\n1-2{sin}^{2}⁡(\\frac{x}{2})=\\operatorname{cos}⁡x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (1-2{sin}^{2}⁡(\\frac{x}{2}))\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+C.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342215 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ef63a0-c750-5bc2-8bd8-46d803ce1c58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7+\\sqrt{2}}{10}" :db/id #edb/ref 17592186339194} {:answer/id #uuid "2149715e-055c-5838-a5fd-c4ec5e2a6fd7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2+7\\sqrt{2}}{10}" :db/id #edb/ref 17592186339415} {:answer/id #uuid "672d1893-2807-5343-bed6-48541cf459e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3+7\\sqrt{2}}{10}" :db/id #edb/ref 17592186340040} {:answer/id #uuid "b6017d08-881d-53ad-b2d3-3b6991a45f72" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{3}}{10}" :db/id #edb/ref 17592186340778} {:answer/id #uuid "d1f3a2af-4efe-52a0-be5d-8a4f036b53dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7\\sqrt{2}}{10}" :db/id #edb/ref 17592186340990}] :answer-field/correct {:answer/id #uuid "d1f3a2af-4efe-52a0-be5d-8a4f036b53dc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7\\sqrt{2}}{10}" :db/id #edb/ref 17592186340990} :answer-field/id #uuid "50a982e9-7945-5d9b-ade9-b65001a1ecd5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341523}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8517f4c3-6d9b-58e0-ad68-ee37cb097540" :question/math-academy-id "q-74458" :question/problem "Suppose that for the angles $u$ and $v,$ we have\n\n$$\n\\operatorname{sin}⁡u=\\frac{\\sqrt{2}}{2},\\,\\operatorname{cos}⁡v=\\frac{12}{15},\\,\\operatorname{sin}⁡v=\\frac{9}{15}.\n$$\n\nGiven that $u$ lies in the second quadrant, find the value of $\\operatorname{cos}⁡(u+v).$" :question/worked-solution "First, we recall the sum formula for cosine:\n\n$$\n\\operatorname{cos}⁡(u+v)=\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v\n$$\n\nWe know the values of $\\operatorname{sin}⁡u,$ $\\operatorname{cos}⁡v,$ and $\\operatorname{sin}⁡v.$ To find the missing value of $\\operatorname{cos}⁡u,$ we can use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡u+{cos}^{2}⁡u=1\\,⟹\\,{cos}^{2}⁡u=1-{sin}^{2}⁡u\n$$\n\nSubstituting our values into the Pythagorean identity, we get\n\n$$\n\\begin{aligned}{cos}^{2}⁡u & =1-{sin}^{2}⁡u \\\\  & =1-{(\\frac{\\sqrt{2}}{2})}^{2} \\\\  & =1-\\frac{(\\sqrt{2})^{2}}{{2}^{2}} \\\\  & =1-\\frac{2}{4} \\\\  & =\\frac{4}{4}-\\frac{2}{4} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡u & =\\pm \\sqrt{\\frac{1}{2}} \\\\  & =\\pm \\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nWe're given that $u$ lies in the second quadrant, where cosine is negative. So, we disregard the positive value, and we have\n\n$$\n\\operatorname{cos}⁡u=-\\frac{\\sqrt{2}}{2}.\n$$\n\nWe can now apply the sum formula:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(u+v) & =\\operatorname{cos}⁡u\\operatorname{cos}⁡v-\\operatorname{sin}⁡u\\operatorname{sin}⁡v \\\\  & =(-\\frac{\\sqrt{2}}{2})(\\frac{12}{15})-(\\frac{\\sqrt{2}}{2})(\\frac{9}{15}) \\\\  & =-\\frac{12\\sqrt{2}}{30}-\\frac{9\\sqrt{2}}{30} \\\\  & =-\\frac{21\\sqrt{2}}{30} \\\\  & =-\\frac{7\\sqrt{2}}{10}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186342217 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4eeab515-ce1c-5d67-a33d-e6018d4875fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{2},1,-1)" :db/id #edb/ref 17592186339844} {:answer/id #uuid "68fe57fc-6cbb-5a54-9f6d-ded078ab77bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\frac{\\sqrt{2}}{2},-1)" :db/id #edb/ref 17592186340062} {:answer/id #uuid "dd6d474c-d3b2-546f-a966-35128e233e68" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{2}}{2},1,-1)" :db/id #edb/ref 17592186341095} {:answer/id #uuid "e2487570-b2b9-5673-8895-70f4ade4852e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1,-1)" :db/id #edb/ref 17592186341132} {:answer/id #uuid "ed0a12c9-9f72-58f6-8668-5bf0ef7965b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,\\sqrt{2},-1)" :db/id #edb/ref 17592186341219}] :answer-field/correct {:answer/id #uuid "e2487570-b2b9-5673-8895-70f4ade4852e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,1,-1)" :db/id #edb/ref 17592186341132} :answer-field/id #uuid "a07b5d66-0e2c-5644-9f1a-a864af5c30fc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341666}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "a02eea4e-b04c-5c03-8b84-ddc1ee505059" :question/math-academy-id "q-74469" :question/problem "The point $P$ has cylindrical polar coordinates $(\\sqrt{2},\\frac{\\pi }{4},-1).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "If $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =1.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt{2}\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(1,1,-1).$"} {:db/id #edb/ref 17592186342218 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1311ed6e-e83e-5330-b7f0-d636f6a5b2f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,2,-3)" :db/id #edb/ref 17592186339297} {:answer/id #uuid "4dcf36fa-2d55-592c-ad8b-78c41d03e9bf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\sqrt{2},-3)" :db/id #edb/ref 17592186339838} {:answer/id #uuid "8c284179-af66-5d8a-8667-9b186f818fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2\\sqrt{2},-2,-3)" :db/id #edb/ref 17592186340385} {:answer/id #uuid "c8580996-a9fa-571e-8115-0012666076f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2,-3)" :db/id #edb/ref 17592186340903} {:answer/id #uuid "dc0c0df3-2853-5f2f-bfd2-8f0456b1bf08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,-2\\sqrt{2},-3)" :db/id #edb/ref 17592186341083}] :answer-field/correct {:answer/id #uuid "c8580996-a9fa-571e-8115-0012666076f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2,-3)" :db/id #edb/ref 17592186340903} :answer-field/id #uuid "8bd4ec4f-2ca7-5bcb-a4ae-66b212822a52" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341628}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c21a9421-0e4c-50cb-88ca-b6a37d78a9d4" :question/math-academy-id "q-74474" :question/problem "The point $Q$ has cylindrical coordinates $(2\\sqrt{2},\\frac{3\\pi }{4},-3).$ Find the Cartesian coordinates of $Q.$" :question/worked-solution "If $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =2\\sqrt{2}\\cdot (\\frac{-\\sqrt{2}}{2}) \\\\  & =-2.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =2\\sqrt{2}\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $Q$ are $(-2,2,-3).$"} {:db/id #edb/ref 17592186342220 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0698bb77-dfe7-5e73-bad8-5c473928b63e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{5},1.571,-1)" :db/id #edb/ref 17592186339182} {:answer/id #uuid "0ca737a7-1cbd-5f99-aacc-902531ef6b24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{5},3.141,-1)" :db/id #edb/ref 17592186339242} {:answer/id #uuid "17845463-35df-5f43-9968-6200646df155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,2.214,-1)" :db/id #edb/ref 17592186339338} {:answer/id #uuid "50d1cbc0-8fe2-5f41-aed9-77260041cb1b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{10},3.141,-1)" :db/id #edb/ref 17592186339864} {:answer/id #uuid "b625a22d-40cb-54f7-b4bb-a50df0d9511b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0.785,-1)" :db/id #edb/ref 17592186340779}] :answer-field/correct {:answer/id #uuid "17845463-35df-5f43-9968-6200646df155" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,2.214,-1)" :db/id #edb/ref 17592186339338} :answer-field/id #uuid "0efa825e-403e-5f8a-ae13-36698e846a4c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341407}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "276bbd82-06db-5cb5-9a75-92624054e2f0" :question/math-academy-id "q-74479" :question/problem "The point $C$ has Cartesian coordinates $(-3,4,-1).$ What are the cylindrical polar coordinates $(r,\\theta ,z)$ of $C?$ Express $\\theta $ in radians rounded to three decimal places." :question/worked-solution "We write the position of a point in cylindrical coordinates as $(r,\\theta ,z),$ where $r\\ge 0$ and $0\\le \\theta <2\\pi .$ \n\nConsider the point $(x,y)=(-3,4)$ that represents the projection of $(x,y,z)=(-3,4,-1)$ onto the $xy$-plane. We need to find the plane polar coordinates $(r,\\theta )$ of $(-3,4).$ Then, the cylindrical coordinates of the point $C$ will be $(r,\\theta ,z).$\n\nFirst, we find $r$, as follows:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+{4}^{2}} \\\\  & =\\sqrt{9+16} \\\\  & =\\sqrt{25} \\\\  & =5\\end{aligned}\n$$\n\nNow, since $(-3,4)$ lies in the second quadrant, we first need to find  the reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{4}{-3}| \\\\  & =\\operatorname{arctan}⁡(\\frac{4}{3}) \\\\  & ≈0.927\\,295\\end{aligned}\n$$\n\nFinally, we subtract the reference angle from $\\pi :$\n\n$$\n\\begin{aligned}\\theta  & =\\pi -{\\theta }_{R} \\\\  & ≈\\pi -0.927\\,295 \\\\  & =2.214\\end{aligned}\n$$\n\nTherefore, the cylindrical coordinates of $C$ are $(5,2.214,-1).$"} {:db/id #edb/ref 17592186342221 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3726b4ca-1bbe-5c6b-9e7a-23004ada8de4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},\\frac{\\pi }{6},-3)." :db/id #edb/ref 17592186339623} {:answer/id #uuid "60277a26-dbc5-5fc9-bad4-720a706a6a9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},\\frac{5\\pi }{6},-3)." :db/id #edb/ref 17592186339986} {:answer/id #uuid "cc67ee9b-7111-5c33-b0fe-80dfccde79db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3\\sqrt{3},\\frac{5\\pi }{6},-3)." :db/id #edb/ref 17592186340936} {:answer/id #uuid "f359639f-8beb-5f7f-b0c3-7f3ee26c0e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},\\frac{11\\pi }{6},-3)" :db/id #edb/ref 17592186341272} {:answer/id #uuid "f7f68ce8-a6d2-514f-bfbd-8b8110a1161c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},\\frac{7\\pi }{6},-3)." :db/id #edb/ref 17592186341319}] :answer-field/correct {:answer/id #uuid "f359639f-8beb-5f7f-b0c3-7f3ee26c0e52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},\\frac{11\\pi }{6},-3)" :db/id #edb/ref 17592186341272} :answer-field/id #uuid "05d63345-e7b2-55a5-a2ae-48c0e36fa06f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341395}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "79dcf1b7-6a5b-5991-a94b-2a63325fcdf9" :question/math-academy-id "q-74482" :question/problem "The point $P$ has Cartesian coordinates $(3,-\\sqrt{3},-3).$ What are the cylindrical polar coordinates of $P?$" :question/worked-solution "We write the position of a point in cylindrical coordinates as $(r,\\theta ,z),$ where $r\\ge 0$ and $0\\le \\theta <2\\pi .$ \n\nConsider the point $(x,y)=(3,-\\sqrt{3})$ that represents the projection of $(x,y,z)=(3,-\\sqrt{3},-3)$ onto the $xy$-plane. We need to find the plane polar coordinates $(r,\\theta )$ of $(3,-\\sqrt{3}).$ Then, the cylindrical coordinates of the point $P$ will be $(r,\\theta ,z).$\n\nFirst, we find $r$, as follows:\n\n$$\n\\begin{aligned}r & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{3}^{2}+{(-\\sqrt{3})}^{2}} \\\\  & =\\sqrt{9+3} \\\\  & =\\sqrt{12} \\\\  & =2\\sqrt{3}\\end{aligned}\n$$\n\nNow, since $(3,-\\sqrt{3})$ lies in the fourth  quadrant, we first need to find  the reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\sqrt{3}}{3}| \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we subtract the reference angle from $2\\pi :$\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{6} \\\\  & =\\frac{11\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the cylindrical coordinates of $P$ are $(2\\sqrt{3},\\frac{11\\pi }{6},-3).$"} {:db/id #edb/ref 17592186342224 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15d84828-816d-58ba-b0e1-a59783e286bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,0,-1)" :db/id #edb/ref 17592186339321} {:answer/id #uuid "58572345-012a-59c7-8cd5-681da81fb4f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1,1)" :db/id #edb/ref 17592186339933} {:answer/id #uuid "8f0b6220-6641-5efe-9ee6-d7d6cb37f50d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,1,0)" :db/id #edb/ref 17592186340414} {:answer/id #uuid "94b551ba-c95a-53b7-b718-acf3bc05e883" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,-1,-1)" :db/id #edb/ref 17592186340464} {:answer/id #uuid "a0b3d572-0f3d-5a33-a807-006c49f04637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0,1)" :db/id #edb/ref 17592186340586}] :answer-field/correct {:answer/id #uuid "a0b3d572-0f3d-5a33-a807-006c49f04637" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-1,0,1)" :db/id #edb/ref 17592186340586} :answer-field/id #uuid "4b8ecf9f-6708-5e94-a6dd-d1dd642fcf7e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341511}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "15e1b03e-f124-5d2e-b837-d378c1598893" :question/math-academy-id "q-74550" :question/problem "The point $D$ has spherical coordinates $(\\sqrt{2},\\pi ,\\frac{\\pi }{4}).$ Find the Cartesian coordinates of $D.$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =\\sqrt{2}\\operatorname{cos}⁡(\\pi )\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot (-1)\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-1.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =\\sqrt{2}\\operatorname{sin}⁡(\\pi )\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot 0\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =0.\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $D$ are $(-1,0,1).$"} {:db/id #edb/ref 17592186342225 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25a39b4d-5781-5124-945a-d3c283bf0061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},0,\\sqrt{3})" :db/id #edb/ref 17592186339448} {:answer/id #uuid "33070bd4-0eec-5638-a89d-8df6aac20c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\sqrt{3},3)" :db/id #edb/ref 17592186339580} {:answer/id #uuid "3cec3300-9879-5705-92e0-50fb389c1885" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},0,-\\sqrt{3})" :db/id #edb/ref 17592186339671} {:answer/id #uuid "4ba6e68a-236f-596e-b655-67dae8f3c560" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\sqrt{3},\\sqrt{3})" :db/id #edb/ref 17592186339809} {:answer/id #uuid "b355585e-7922-5937-94df-e81164bde0a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{3},3,\\sqrt{3})" :db/id #edb/ref 17592186340756}] :answer-field/correct {:answer/id #uuid "33070bd4-0eec-5638-a89d-8df6aac20c5a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,\\sqrt{3},3)" :db/id #edb/ref 17592186339580} :answer-field/id #uuid "077b429d-58fb-5dfd-8dd8-9a4b431b6b0d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341397}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9904226e-02ba-53bf-837a-e256f030e7c7" :question/math-academy-id "q-74551" :question/problem "The point $B$ has spherical coordinates $(2\\sqrt{3},\\frac{\\pi }{2},\\frac{\\pi }{6}).$ Find the Cartesian coordinates of $B.$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =2\\sqrt{3}\\operatorname{cos}⁡(\\frac{\\pi }{2})\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =2\\sqrt{3}\\cdot 0\\cdot \\frac{1}{2} \\\\  & =0.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =2\\sqrt{3}\\operatorname{sin}⁡(\\frac{\\pi }{2})\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =2\\sqrt{3}\\cdot 1\\cdot \\frac{1}{2} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =2\\sqrt{3}\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =2\\sqrt{3}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $B$ are $(0,\\sqrt{3},3).$"} {:db/id #edb/ref 17592186342226 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01ec83dc-cb98-54f1-928c-ab31ea02f4e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\sqrt{3},-2\\sqrt{3})" :db/id #edb/ref 17592186339146} {:answer/id #uuid "0a3a4aeb-fb9e-5fb8-b5ce-ad2dea28f059" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\sqrt{3},2\\sqrt{3},\\sqrt{3})" :db/id #edb/ref 17592186339212} {:answer/id #uuid "0d78bb3a-d489-50a0-b7da-d53016953412" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-3,\\sqrt{3},\\sqrt{3})" :db/id #edb/ref 17592186339253} {:answer/id #uuid "7d8c8e00-6267-5987-9ff6-c554d30b5c56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(3,-2\\sqrt{3},\\sqrt{3})" :db/id #edb/ref 17592186340260} {:answer/id #uuid "b56cf612-e708-53a8-b406-02a953105541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\sqrt{3},\\sqrt{3})" :db/id #edb/ref 17592186340774}] :answer-field/correct {:answer/id #uuid "01ec83dc-cb98-54f1-928c-ab31ea02f4e4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(1,\\sqrt{3},-2\\sqrt{3})" :db/id #edb/ref 17592186339146} :answer-field/id #uuid "a821f4dc-0d73-525f-91a0-3f3dd95b396c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341673}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52031823-5a5b-5a93-b5b4-e1f6b24e67f3" :question/math-academy-id "q-74554" :question/problem "The point $H$ has spherical polar coordinates $(4,\\frac{\\pi }{3},\\frac{5\\pi }{6}).$ Find the Cartesian coordinates of $H.$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =4\\operatorname{cos}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =4\\cdot \\frac{1}{2}\\cdot \\frac{1}{2} \\\\  & =1.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =4\\operatorname{sin}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =4\\cdot \\frac{\\sqrt{3}}{2}\\cdot \\frac{1}{2} \\\\  & =\\sqrt{3}.\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =4\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =4\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-2\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $H$ are $(1,\\sqrt{3},-2\\sqrt{3}).$"} {:db/id #edb/ref 17592186342227 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "697be6e0-358e-5c8f-ba3b-a7a6c27cf563" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\sqrt{3},-2)" :db/id #edb/ref 17592186340067} {:answer/id #uuid "89e24342-7b5d-502f-86fe-2b058ccfa5a1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,2\\sqrt{3},-2)" :db/id #edb/ref 17592186340359} {:answer/id #uuid "c2778d39-22b4-5b4f-a4d6-39afae3eb47c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-4,\\sqrt{3},-4)" :db/id #edb/ref 17592186340858} {:answer/id #uuid "e9709d59-a915-536a-afbe-5fc80b8f4cac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\sqrt{3},-1)" :db/id #edb/ref 17592186341188} {:answer/id #uuid "fb29fa58-f60d-568d-b1ba-c1ac224bb641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2\\sqrt{3},-4)" :db/id #edb/ref 17592186341347}] :answer-field/correct {:answer/id #uuid "fb29fa58-f60d-568d-b1ba-c1ac224bb641" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-2,2\\sqrt{3},-4)" :db/id #edb/ref 17592186341347} :answer-field/id #uuid "71f807fb-df3a-54a9-be7e-64b490aa4336" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341577}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2274a373-0a7f-5722-8de2-da35efc5accf" :question/math-academy-id "q-74555" :question/problem "The point $P$ has spherical polar coordinates $(4\\sqrt{2},\\frac{2\\pi }{3},\\frac{3\\pi }{4}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =4\\sqrt{2}\\operatorname{cos}⁡(\\frac{2\\pi }{3})\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =4\\sqrt{2}\\cdot (-\\frac{1}{2})\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =4\\sqrt{2}\\operatorname{sin}⁡(\\frac{2\\pi }{3})\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =4\\sqrt{2}\\cdot \\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =4\\sqrt{2}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =4\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2,2\\sqrt{3},-4).$"} {:db/id #edb/ref 17592186342243 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06b3b852-a49c-5eeb-92f6-f26e6d188a47" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$u$ does not lie on $Π$" :db/id #edb/ref 17592186339184} {:answer/id #uuid "191397de-4f1f-5ce1-a2c1-b8de6e1df5ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{8}" :db/id #edb/ref 17592186339350} {:answer/id #uuid "459245c0-1823-5440-b561-9af08e968b96" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186339745} {:answer/id #uuid "6e7685b0-ef1b-58de-ad96-cbeee1b70636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}" :db/id #edb/ref 17592186340105} {:answer/id #uuid "9fd09f6d-fcdf-5876-9523-8e01ec65ed87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{4}" :db/id #edb/ref 17592186340574}] :answer-field/correct {:answer/id #uuid "6e7685b0-ef1b-58de-ad96-cbeee1b70636" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{8}" :db/id #edb/ref 17592186340105} :answer-field/id #uuid "9bebdfbe-9cbd-5971-9a6a-74e16cc92f99" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341655}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dcb29558-7233-531f-8a7f-7d0b5b7173b6" :question/math-academy-id "q-74602" :question/problem "Determine if the vector $u$ lies on the plane $Π:r=sb+tc$, $t,s\\in R$, where  $b=⟨1,7,-6⟩$, $c=⟨-2,-10,12⟩$, and  $u=⟨2,11,-12⟩.$ In the affirmative case, find the value of $s\\cdot t$ from the decomposition $u=sb+tc.$" :question/worked-solution "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s\\begin{bmatrix}1 \\\\ 7 \\\\ -6\\end{bmatrix}+t\\begin{bmatrix}-2 \\\\ -10 \\\\ 12\\end{bmatrix} & =\\begin{bmatrix}2 \\\\ 11 \\\\ -12\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\left\\{\\begin{aligned}s-2t &=2 \\\\ 7s-10t &=11 \\\\ -6s+12t &=-12\\end{aligned}\\right.\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & -2 & 2 \\\\ 7 & -10 & 11 \\\\ -6 & 12 & -12\\end{bmatrix} & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 4 & -3 \\\\ -6 & 12 & -12\\end{bmatrix} & {R}_{3} & :={R}_{3}+6{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 2 \\\\ 0 & 4 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\left\\{\\begin{aligned}s-2t &=2 \\\\ 4t &=-3 \\\\ 0 &=0.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get\n\n$$\n4t=-3\\,⟹\\,t=-\\frac{3}{4}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-2t & =2 \\\\ s-2(-\\frac{3}{4}) & =2 \\\\ s+\\frac{3}{2} & =2 \\\\ s & =2-\\frac{3}{2} \\\\ s & =\\frac{1}{2}.\\end{aligned}\n$$\n\nSince we found a solution $s=\\frac{1}{2},\\,t=-\\frac{3}{4},$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=\\frac{1}{2}b-\\frac{3}{4}c.\n$$\n\nFinally, $s\\cdot t=\\frac{1}{2}\\cdot (-\\frac{3}{4})=-\\frac{3}{8}.$"} {:db/id #edb/ref 17592186344949 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "124d51bd-2aae-5ea7-a2b0-cf4311da38dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-2y+5z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186342400} {:answer/id #uuid "62486216-48d3-5ef2-81a2-192428d9fc91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1+2y-5z \\\\ 2y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343072} {:answer/id #uuid "904e183a-7b57-556c-a5d2-101c5bd11a5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1+2y+z \\\\ y \\\\ -6z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343498} {:answer/id #uuid "ac7ea094-25ff-5a40-9f07-fa1d148d8cee" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-2y-5z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343757} {:answer/id #uuid "c474aa3b-f7ce-508a-8ed6-38110b5498a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1+2y+z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343965}] :answer-field/correct {:answer/id #uuid "124d51bd-2aae-5ea7-a2b0-cf4311da38dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1-2y+5z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186342400} :answer-field/id #uuid "ebb4acd0-8375-525d-8189-262b00544043" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "78ef528f-61bb-5594-b0fa-7d95e275c2ae" :question/math-academy-id "q-74613" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}-3x-6y+15z &=-3 \\\\ 6x+12y-30z &=6 \\\\ -6x-12y+30z &=-6\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-3 & -6 & 15 & -3 \\\\ 6 & 12 & -30 & 6 \\\\ -6 & -12 & 30 & -6\\end{bmatrix}.\n$$\n\nTransforming $M$ to reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}-3 & -6 & 15 & -3 \\\\ 6 & 12 & -30 & 6 \\\\ -6 & -12 & 30 & -6\\end{bmatrix} & {R}_{1} & :=(-\\frac{1}{3}){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -5 & 1 \\\\ 6 & 12 & -30 & 6 \\\\ -6 & -12 & 30 & -6\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-6){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -5 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ -6 & -12 & 30 & -6\\end{bmatrix} & {R}_{3} & :={R}_{3}+6{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 2 & -5 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x+2y-5z &=1 \\\\ 0x+0y+0z &=0 \\\\ 0x+0y+0z &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final two equations, we can remove these equations from the system. \n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variable is $x$, and we have two free variables, $y,$ and $z.$ That means we need to find $x$ in terms of $y$ and $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=1-2y+5z \\\\ y &=y \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $y$ and $z$ (the free variables) are arbitrary numbers.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}1-2y+5z \\\\ y \\\\ z\\end{bmatrix},\\,y,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186344953 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3986dfe0-78b8-5298-9c0e-64a7188e7711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21z+4 \\\\ -6z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186342712} {:answer/id #uuid "5e8c052d-b190-5419-b219-90c5040a3dbb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21z+4 \\\\ 6z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343035} {:answer/id #uuid "7d7528ee-1567-5556-81a5-1c2496450e8b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21z-4 \\\\ 6z+1 \\\\ 2-z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343320} {:answer/id #uuid "9543e1f3-a111-5298-aa95-b9cc07e2fbf8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21z+4 \\\\ 6z-1 \\\\ z-2\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186343542} {:answer/id #uuid "ec48f840-399c-5e84-a62f-187f5ed0f785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21z-4 \\\\ 6z+1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186344312}] :answer-field/correct {:answer/id #uuid "3986dfe0-78b8-5298-9c0e-64a7188e7711" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}21z+4 \\\\ -6z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty )" :db/id #edb/ref 17592186342712} :answer-field/id #uuid "4a6d968f-8481-567c-9e4d-8dab2310ec5a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344617}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "920a4776-0058-5c9a-a43b-cd0f1925df4a" :question/math-academy-id "q-74629" :question/problem "Consider the following system of linear equations:\n\n$$\n\\left\\{\\begin{aligned}-4x-12y+12z &=-4 \\\\ 5x+16y-9z &=4 \\\\ 2x+6y-6z &=2\\end{aligned}\\right.\n$$\n\nUse the standard Gauss-Jordan method to reduce the augmented matrix $M$ of the system to reduced row echelon form, and then solve the linear system." :question/worked-solution "The augmented matrix for this system is\n\n$$\nM=\\begin{bmatrix}-4 & -12 & 12 & -4 \\\\ 5 & 16 & -9 & 4 \\\\ 2 & 6 & -6 & 2\\end{bmatrix}.\n$$\n\nTransforming $M$ into reduced row echelon form, we have\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}-4 & -12 & 12 & -4 \\\\ 5 & 16 & -9 & 4 \\\\ 2 & 6 & -6 & 2\\end{bmatrix} & {R}_{1} & :=(-\\frac{1}{4}){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -3 & 1 \\\\ 5 & 16 & -9 & 4 \\\\ 2 & 6 & -6 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-5){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -3 & 1 \\\\ 0 & 1 & 6 & -1 \\\\ 2 & 6 & -6 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 3 & -3 & 1 \\\\ 0 & 1 & 6 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nIn the row echelon form above, we have only two pivots (in the $1$st and $2$nd columns). To transform the matrix to reduced row echelon form, we need to create zeros above the pivots only. This gives,\n\n$$\n\\begin{aligned}M & ∼\\begin{bmatrix}1 & 3 & -3 & 1 \\\\ 0 & 1 & 6 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix} & {R}_{1} & :={R}_{1}+(-3){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -21 & 4 \\\\ 0 & 1 & 6 & -1 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThe corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-21z &=4 \\\\ y+6z &=-1 \\\\ 0 &=0.\\end{aligned}\\right.\n$$\n\nSince any numbers $x,y,z$ form a solution of the final equation, we can remove this equation from the system. \n\nThe basic variables are the variables whose coefficients are pivots. In this case, the basic variables are $x$ and $y,$ and we have one free variable, $z.$ That means we need to find $x$ and $y$ in terms of $z.$ \n\nTherefore, the general solution is\n\n$$\n\\left\\{\\begin{aligned}x &=21z+4 \\\\ y &=-6z-1 \\\\ z &=z,\\end{aligned}\\right.\n$$\n\nwhere $z$ (the free variable) is an arbitrary number.\n\nIn vector form, the solution can be written as\n\n$$\n\\begin{aligned}\\begin{bmatrix}x \\\\ y \\\\ z\\end{bmatrix}=\\begin{bmatrix}21z+4 \\\\ -6z-1 \\\\ z\\end{bmatrix},\\,z\\in (-\\infty ,\\infty ).\\end{aligned}\n$$"} {:db/id #edb/ref 17592186344955 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a61c80e-2bd7-5903-be6c-7547219b8c3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x\\le 4" :db/id #edb/ref 17592186342324} {:answer/id #uuid "31020c78-3c9e-5550-a047-8794a779797c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 4" :db/id #edb/ref 17592186342648} {:answer/id #uuid "bd48ea9f-0ff2-577f-bfb5-2c6be5933f52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0<x<2" :db/id #edb/ref 17592186343903} {:answer/id #uuid "c66637ec-aae0-50da-b862-c86a04d64b58" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x>2" :db/id #edb/ref 17592186343979} {:answer/id #uuid "ee2bfbd5-a799-5932-95be-864ad71fddf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 2" :db/id #edb/ref 17592186344332}] :answer-field/correct {:answer/id #uuid "ee2bfbd5-a799-5932-95be-864ad71fddf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x\\ge 2" :db/id #edb/ref 17592186344332} :answer-field/id #uuid "20c0d173-6536-55d0-aefd-9951de44df01" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344551}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9da9be74-20cf-54df-89a0-bc02d03f9903" :question/math-academy-id "q-74633" :question/problem "Consider the sequence ${a}_{n}=\\frac{{2}^{n+4}}{{x}^{n}},$ where $x$ is a positive real number and $n\\ge 1.$ What are the values of $x$ for which the sequence converges?" :question/worked-solution "Suppose we have a geometric sequence with the first term ${a}_{1}$ and common ratio $r.$ Then, we have the following convergence properties:\n\n- if $|r|<1,$ the sequence is convergent and converges to $0$\n\n- if $|r|>1,$ the sequence is divergent\n\nMoreover, we have the following edge cases:\n\n- if $r=1,$ the sequence is convergent and converges to ${a}_{1}$\n\n- if $r=-1,$ the sequence is divergent\n\nFirst, we rewrite the sequence in the form ${a}_{n}=a\\cdot {r}^{n},$ as follows:\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{{2}^{n+4}}{{x}^{n}} \\\\  & =\\frac{{2}^{n}\\cdot {2}^{4}}{{x}^{n}} \\\\  & ={2}^{4}\\cdot \\frac{{2}^{n}}{{x}^{n}} \\\\  & =16{(\\frac{2}{x})}^{n}\\end{aligned}\n$$\n\n \n\nWe see that this is a geometric sequence with the common ratio $r=\\frac{2}{x}.$ Since $x$ is positive,  $r$ is also positive. So, the convergence condition is $0<r\\le 1.$ \n\nTherefore, the  sequence converges for \n\n$$\n0<\\frac{2}{x}\\le 1\\,⟹\\,x\\ge 2.\n$$"} {:db/id #edb/ref 17592186344957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d964555-6f83-5191-89db-fd72ffdf14c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438526} {:answer/id #uuid "ad751ae7-e25b-5406-b9e3-27ea4cbed2f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438527}] :answer-field/correct {:answer/id #uuid "0d964555-6f83-5191-89db-fd72ffdf14c4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438526} :answer-field/id #uuid "ae1a0230-4005-55bc-8174-e0944a31dd3e" :answer-field/key "The system has no solution" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439292} {:answer-field/choices [{:answer/id #uuid "3be3c581-4293-5cdb-b090-f3c480d1c024" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438528} {:answer/id #uuid "89e07487-bb39-5368-bf53-e4b20abb5d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438529}] :answer-field/correct {:answer/id #uuid "89e07487-bb39-5368-bf53-e4b20abb5d72" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438529} :answer-field/id #uuid "d62a54fe-bb91-5a39-8c45-d4f5ab79b9a1" :answer-field/key "The system is consistent independent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439293} {:answer-field/choices [{:answer/id #uuid "4d848cbc-71b2-5e07-ad3c-93e27231b7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438530} {:answer/id #uuid "82fdc104-5ebd-5054-99d2-64d287c3ea35" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186438531}] :answer-field/correct {:answer/id #uuid "4d848cbc-71b2-5e07-ad3c-93e27231b7c0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186438530} :answer-field/id #uuid "a883d2db-1de6-5620-afb1-bd3d06ab629d" :answer-field/key "The system is consistent dependent" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186439294}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "b0089d19-a4b5-5ec4-beaa-917a294458ba" :question/math-academy-id "q-74637" :question/problem "Consider the following system of equations\n\n$$\n\\left\\{\\begin{aligned}2x+3y &=-1 \\\\ x-2y &=1 \\\\ -x-5y &=2.\\end{aligned}\\right.\n$$\n\nWhich of the following statements are true?\n\nSelect all that apply." :question/worked-solution "To classify the system, we first try to find its solution. The augmented matrix for this system is \n\n$$\nM=\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix}.\n$$\n\nUsing the method of Gaussian elimination, we can reduce this matrix to row echelon form as follows:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}2 & 3 & -1 \\\\ 1 & -2 & 1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{1} & ↔{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 2 & 3 & -1 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ -1 & -5 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & -7 & 3\\end{bmatrix} & {R}_{3} & :={R}_{3}+{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 \\\\ 0 & 7 & -3 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\n \n\nSince any numbers $x$ and $y$ are solutions to the third equation $0x+0y=0$, we can remove this equation from the system. So, the corresponding system is now\n\n$$\n\\left\\{\\begin{aligned}x-2y &=1 \\\\ 7y &=-3.\\end{aligned}\\right.\n$$\n\nFrom the second equation, we get $y=-\\frac{3}{7}.$ Substituting this into the first equation, we get\n\n$$\nx-2(-\\frac{3}{7})=1\\,⟹\\,x=\\frac{1}{7}.\n$$\n\n \nSo, we conclude that the system is consistent independent. \n\nAs a result, only statement “The system is consistent independent” is true."} {:db/id #edb/ref 17592186344973 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1469b54d-ec23-5506-9427-e98021750719" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.53" :db/id #edb/ref 17592186342419} {:answer/id #uuid "927398b8-4695-53ea-8fcb-0952e83514d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.37" :db/id #edb/ref 17592186343517} {:answer/id #uuid "a8777c97-52fc-5894-b595-71dafedeb50c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7.33" :db/id #edb/ref 17592186343719} {:answer/id #uuid "e6549ab5-9ac9-5a3c-930e-da7406fae50b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.73" :db/id #edb/ref 17592186344260} {:answer/id #uuid "ec013d9b-6c06-5d0e-a904-81462767365f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.35" :db/id #edb/ref 17592186344308}] :answer-field/correct {:answer/id #uuid "e6549ab5-9ac9-5a3c-930e-da7406fae50b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3.73" :db/id #edb/ref 17592186344260} :answer-field/id #uuid "668cf6f0-df85-5110-9881-263e6247ddc4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344666}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "353be5b6-f62d-5474-a5e8-6fa7ab3f0134" :question/math-academy-id "q-74715" :question/problem "Find, in radians to two decimal places, the argument of $z=-3-2\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/requires-calculator true :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/0c/0c6548a95b2a81c7dcde33ead78ee0be8d5cee936edc1e2a98c2d59d259404b7.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Therefore $\\pi <\\operatorname{arg}⁡(z)<\\frac{3\\pi }{2}.$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\alpha  & =\\operatorname{arctan}⁡(\\frac{2}{3})≈0.588\\,00.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arg}⁡(z)≈\\pi +0.588\\,00≈3.73\n$$\n\nto two decimal places."} {:db/id #edb/ref 17592186344974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c5a3449-51c7-5e41-af7b-1a13fddb3095" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.37" :db/id #edb/ref 17592186343163} {:answer/id #uuid "7a3ec4ff-a90e-52ee-9e8e-00d008072460" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.40" :db/id #edb/ref 17592186343291} {:answer/id #uuid "7f46bb77-3e6d-5ad5-95d4-4ae5403aa042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.07" :db/id #edb/ref 17592186343331} {:answer/id #uuid "ab7f0a23-f446-57b3-8a4a-dce9a0081064" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.73" :db/id #edb/ref 17592186343746} {:answer/id #uuid "febb989e-89ce-5841-b742-8292380ade3e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.21" :db/id #edb/ref 17592186344480}] :answer-field/correct {:answer/id #uuid "7f46bb77-3e6d-5ad5-95d4-4ae5403aa042" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4.07" :db/id #edb/ref 17592186343331} :answer-field/id #uuid "f7b7b234-47df-5611-a686-25c71891a117" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344927}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "50de5bf4-f172-5683-bb63-c927e8858eff" :question/math-academy-id "q-74716" :question/problem "Find, in radians to two decimal places, the argument of $z=-3-4\\text{i}.$ \n\n**Hint**: The argument of a complex number is in the range $[0,2\\pi ).$" :question/worked-solution "Let's plot $z$ in the complex plane.\n\n![](images/7e/7eff12ed4bca73dc27f834b0740b5b2235440250e11427f911c8fc29c99fa1d7.png)\n\nThe complex number $z$ lies in the third quadrant of the complex plane. Therefore $\\pi <arg⁡(z)<\\frac{3\\pi }{2}.$ If $\\alpha $ is the angle that $z$ makes with the negative real axis, then\n\n$$\n\\begin{aligned}\\alpha  & =arctan⁡(\\frac{4}{3})≈0.927\\,30.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =arg⁡(z)≈\\pi +0.927\\,30≈4.07\n$$\n\nto two decimal places."} {:db/id #edb/ref 17592186344975 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f6d6767-1146-5a58-a3ee-9b876310ebed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},\\frac{7\\pi }{6},\\frac{3\\pi }{4})" :db/id #edb/ref 17592186343045} {:answer/id #uuid "7c9d5d2f-6bd9-5ff8-8331-4f01157a7195" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{3},\\frac{\\pi }{3},\\frac{3\\pi }{4})" :db/id #edb/ref 17592186343314} {:answer/id #uuid "c58fa24c-d4dc-5219-b20d-4ee437fb29e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},\\frac{5\\pi }{3},\\frac{\\pi }{4})" :db/id #edb/ref 17592186343973} {:answer/id #uuid "e2159453-cf0d-55e3-93a7-4a03b01ff975" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},\\frac{5\\pi }{6},\\frac{\\pi }{4})" :db/id #edb/ref 17592186344229} {:answer/id #uuid "f48dd510-8468-5895-a87e-be32fb03d256" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2,\\frac{5\\pi }{6},\\frac{\\pi }{8})" :db/id #edb/ref 17592186344394}] :answer-field/correct {:answer/id #uuid "c58fa24c-d4dc-5219-b20d-4ee437fb29e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(2\\sqrt{2},\\frac{5\\pi }{3},\\frac{\\pi }{4})" :db/id #edb/ref 17592186343973} :answer-field/id #uuid "951dc7a2-95ba-5074-8bed-1f1f40a6ebd1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344749}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cba0666a-04f8-5761-91d5-608acf1e745f" :question/math-academy-id "q-74720" :question/problem "The point $U$ has Cartesian coordinates $(1,-\\sqrt{3},2).$ What are the spherical polar coordinates of $U?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-\\sqrt{3})^{2}+{2}^{2}} \\\\  & =\\sqrt{1+3+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$\n\nNow, $(x,y)=(1,-\\sqrt{3})$ lies in the fourth quadrant. So to find $\\theta ,$ we first need to find the reference angle ${\\theta }_{R}:$ \n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\sqrt{3}}{1}| \\\\  & =\\operatorname{arctan}⁡(\\sqrt{3}) \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nNext, we subtract the reference angle from $2\\pi $ to get $\\theta :$\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{5\\pi }{3}\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(\\frac{2}{2\\sqrt{2}}) \\\\  & =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $U$ are $(2\\sqrt{2},\\frac{5\\pi }{3},\\frac{\\pi }{4}).$"} {:db/id #edb/ref 17592186344976 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3dccd09c-ad01-5ee8-8083-d1a54808ef20" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0.991,6,0.975)" :db/id #edb/ref 17592186342749} {:answer/id #uuid "516dd9c3-1448-5db0-a4d6-d6ae946815d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,0.199,0.795)" :db/id #edb/ref 17592186342912} {:answer/id #uuid "bab9c1e7-8cd7-5401-ab1e-554a21dbabde" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4,0.991,0.957)" :db/id #edb/ref 17592186343878} {:answer/id #uuid "d0df20fa-ae9c-516f-a079-a1866a55bc16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(5,0.919,0.975)" :db/id #edb/ref 17592186344074} {:answer/id #uuid "d7fc8e7a-aba9-5a54-ac8a-3c7712d0cc97" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\sqrt{10},0.199,0.759)" :db/id #edb/ref 17592186344138}] :answer-field/correct {:answer/id #uuid "516dd9c3-1448-5db0-a4d6-d6ae946815d9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(10,0.199,0.795)" :db/id #edb/ref 17592186342912} :answer-field/id #uuid "b398c983-2da0-5518-9ccc-8aee7df3c2d2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344809}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "da345849-4daa-55eb-8df7-62d01de63486" :question/math-academy-id "q-74725" :question/problem "The point $S$ has Cartesian coordinates $(7,\\sqrt{2},7).$ What are the spherical polar coordinates $(\\rho ,\\theta ,ϕ)$ of $S?$ Express $\\theta $ and $ϕ$ in radians rounded to three decimal places." :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{{7}^{2}+(\\sqrt{2})^{2}+{7}^{2}} \\\\  & =\\sqrt{49+2+49} \\\\  & =\\sqrt{100} \\\\  & =10\\end{aligned}\n$$\n\nNow, since $(x,y)=(7,\\sqrt{2})$ lies in the first quadrant,  we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{2}}{7}) \\\\  & ≈0.199\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(\\frac{7}{10}) \\\\  & ≈0.795.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $S$ are $(10,0.199,0.795).$"} {:db/id #edb/ref 17592186344986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0cf412ba-cb44-5810-90eb-470d798d6591" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,0⟩" :db/id #edb/ref 17592186342351} {:answer/id #uuid "38066b67-952e-5aaa-89e3-87ed3e2d7e87" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨1,-1⟩" :db/id #edb/ref 17592186342700} {:answer/id #uuid "9e480808-eca1-5207-ab76-299e8586efe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨-1,1⟩" :db/id #edb/ref 17592186343632} {:answer/id #uuid "d306b071-4ab7-5ed5-b27f-e66587823105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨1,1⟩" :db/id #edb/ref 17592186344089} {:answer/id #uuid "d6a03b41-a1b1-5998-84af-ee854f6b5424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0⟩" :db/id #edb/ref 17592186344121}] :answer-field/correct {:answer/id #uuid "d6a03b41-a1b1-5998-84af-ee854f6b5424" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0⟩" :db/id #edb/ref 17592186344121} :answer-field/id #uuid "195ce2b3-5781-555d-8433-34219cc57723" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344535}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bcc4a25a-4ff4-59f4-a945-c409687d5f70" :question/math-academy-id "q-74851" :question/problem "The unit tangent vector to a curve at an arbitrary point is given by\n\n$$\nT(t)=\\frac{1}{\\sqrt{{t}^{2}+16}}\\cdot ⟨t,4⟩.\n$$\n\nFind the principal normal vector at the point where $t=0.$" :question/worked-solution "First, we calculate ${T}^{′}(t)$ and evaluate it at $t=0:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+16}}\\cdot ⟨t,4⟩) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+16}})\\cdot ⟨t,4⟩+\\frac{1}{\\sqrt{{t}^{2}+16}}\\cdot \\frac{\\text{d}}{\\text{d}t}(⟨t,4⟩) \\\\  & =-\\frac{t}{({t}^{2}+16)\\sqrt{{t}^{2}+16}}\\cdot ⟨t,4⟩+\\frac{1}{\\sqrt{{t}^{2}+16}}\\cdot ⟨1,0⟩ \\\\  \\\\ {T}^{′}(0) & =-\\frac{0}{({0}^{2}+16)\\sqrt{{0}^{2}+16}}\\cdot ⟨0,4⟩+\\frac{1}{\\sqrt{{0}^{2}+16}}\\cdot ⟨1,0⟩ \\\\  & =\\frac{1}{4}⟨1,0⟩\\end{aligned}\n$$\n\n  \n\nNext, we find the magnitude of ${T}^{′}(0):$\n\n$$\n\\begin{aligned}‖{T}^{′}(0)‖ & =\\frac{1}{4}‖⟨1,0⟩‖ \\\\  & =\\frac{1}{4}\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(0)$ and obtain the principal normal vector to the curve at the point where $t=0:$\n\n$$\n\\begin{aligned}N(0) & =\\frac{{T}^{′}(0)}{‖{T}^{′}(0)‖} \\\\  & =\\frac{\\frac{1}{4}⟨1,0⟩}{(\\frac{1}{4})} \\\\  & =⟨1,0⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=0,$ we get\n\n$$\n\\begin{aligned}T(0)\\cdot N(0) & =\\frac{1}{4}⟨0,4⟩\\cdot ⟨1,0⟩ \\\\  & =\\frac{1}{4}(0+0) \\\\  & =0.\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186344991 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03c21a3b-7659-540a-8cd1-66aacfac328f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({t}^{2}+4)}(4t\\,i+({t}^{2}-4)\\,j)" :db/id #edb/ref 17592186342284} {:answer/id #uuid "1e203976-b8c7-5646-819e-ddf7361f2e7b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({t}^{2}-4)}(4t\\,i+({t}^{2}+4)\\,j)" :db/id #edb/ref 17592186342488} {:answer/id #uuid "7bbc2bda-1b99-5a77-8a53-8fccd2025bf2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({t}^{2}+4)}(4t\\operatorname{ln}⁡t\\,i+({t}^{2}-\\frac{4}{{t}^{2}})\\,j)" :db/id #edb/ref 17592186343302} {:answer/id #uuid "a3a97ea5-ed25-5946-9bd2-34a05a289191" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{t}{({t}^{2}+4)}({t}^{2}\\,i+(2t-4)\\,j)" :db/id #edb/ref 17592186343677} {:answer/id #uuid "c4bf5f87-91b3-5c17-8100-93ff3894c418" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{(\\sqrt{4{t}^{2}+1})}(t\\,i+(2{t}^{2}-4)\\,j)" :db/id #edb/ref 17592186343970}] :answer-field/correct {:answer/id #uuid "03c21a3b-7659-540a-8cd1-66aacfac328f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{({t}^{2}+4)}(4t\\,i+({t}^{2}-4)\\,j)" :db/id #edb/ref 17592186342284} :answer-field/id #uuid "d9fc4721-2af1-5eb5-9bdd-94522083e786" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344867}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f3f7825a-5227-5372-94e9-fc80317d8e2a" :question/math-academy-id "q-74893" :question/problem "Find the unit tangent vector to the curve $r(t)=4\\operatorname{ln}⁡t\\,i+(t+\\frac{4}{t})\\,j$ at an arbitrary point where $t\\in (0,\\infty ).$" :question/worked-solution "For a curve $r(t)=x(t)i+y(t)j$, the unit tangent vector $T(t)$ at the point $P(x(t),y(t))$ is given by\n\n$$\nT(t)=\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖}.\n$$\n\nFirst, we find the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{ln}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t+\\frac{4}{t})\\,j \\\\  & =\\frac{4}{t}\\,i+(1-\\frac{4}{{t}^{2}})\\,j\\end{aligned}\n$$\n\nNext, we calculate the magnitude of ${r}^{′}(t):$\n\n$$\n\\begin{aligned}‖{r}^{′}(t)‖ & =\\sqrt{{(\\frac{4}{t})}^{2}+{(1-\\frac{4}{{t}^{2}})}^{2}} \\\\  & =\\sqrt{\\frac{16}{{t}^{2}}+{(1-\\frac{8}{{t}^{2}}+\\frac{16}{{t}^{4}})}^{2}} \\\\  & =\\sqrt{1+\\frac{8}{{t}^{2}}+\\frac{16}{{t}^{4}}} \\\\  & =\\sqrt{\\frac{1}{{t}^{4}}({t}^{4}+8{t}^{2}+16)} \\\\  & =\\sqrt{\\frac{1}{{t}^{4}}{({t}^{2}+4)}^{2}} \\\\  & =\\frac{({t}^{2}+4)}{{t}^{2}}\\end{aligned}\n$$\n\nFinally, we normalize ${r}^{′}(t)$ and obtain the unit tangent vector to the curve:\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{{t}^{2}}{({t}^{2}+4)}(\\frac{4}{t}\\,i+(1-\\frac{4}{{t}^{2}})\\,j) \\\\  & =\\frac{1}{({t}^{2}+4)}(4t\\,i+({t}^{2}-4)\\,j)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186345025 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09edbcaf-e507-56c2-9601-97a969f32090" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ -6 \\\\ 8\\end{bmatrix}\\}" :db/id #edb/ref 17592186442767} {:answer/id #uuid "0c61635a-16c4-5875-a03d-2914bf2b487b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ -6 \\\\ 8\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 9 \\\\ -12\\end{bmatrix},\\begin{bmatrix}2 \\\\ -2 \\\\ 10\\end{bmatrix}\\}" :db/id #edb/ref 17592186442768} {:answer/id #uuid "2decce7e-2100-5b81-a206-46546723c381" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}-3 \\\\ 9 \\\\ -12\\end{bmatrix}\\}" :db/id #edb/ref 17592186442771} {:answer/id #uuid "4143e3f3-49a8-557d-b984-d646890798bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ -6 \\\\ 8\\end{bmatrix},\\begin{bmatrix}2 \\\\ -2 \\\\ 10\\end{bmatrix}\\}" :db/id #edb/ref 17592186442773} {:answer/id #uuid "a5fbafaa-f05c-5762-8d2f-0ad19854c541" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ -2 \\\\ 10\\end{bmatrix}\\}" :db/id #edb/ref 17592186442781}] :answer-field/correct {:answer/id #uuid "4143e3f3-49a8-557d-b984-d646890798bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}2 \\\\ -6 \\\\ 8\\end{bmatrix},\\begin{bmatrix}2 \\\\ -2 \\\\ 10\\end{bmatrix}\\}" :db/id #edb/ref 17592186442773} :answer-field/id #uuid "c7cace19-2ac2-5d38-9b8e-8da19509dd92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8e44b5dc-345c-58d4-a170-3fddfd0702d5" :question/math-academy-id "q-75073" :question/problem "Consider the matrix \n$W=\\begin{bmatrix}2 & -3 & 2 \\\\ -6 & 9 & -2 \\\\ 8 & -12 & 10\\end{bmatrix}.$ \nFind a basis $B$ of  $\\text{Col}(W).$" :question/worked-solution "In order to find a basis of $\\text{Col}(W),$ we reduce the matrix $W$ to row echelon form:\n\n$$\n\\begin{aligned}W & =\\begin{bmatrix}2 & -3 & 2 \\\\ -6 & 9 & -2 \\\\ 8 & -12 & 10\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -3 & 2 \\\\ 0 & 0 & 4 \\\\ 8 & -12 & 10\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}2 & -3 & 2 \\\\ 0 & 0 & 4 \\\\ 0 & 0 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{1}{2}){R}_{2} \\\\  & ∼\\begin{bmatrix}2 & -3 & 2 \\\\ 0 & 0 & 4 \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st and $3$rd columns are pivot columns, while the $2$nd column is a non-pivot column.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st and $3$rd columns from the original matrix are ${w}_{1}$ and ${w}_{3}.$ So, a basis of $\\text{Col}(W)$ is $\\{{w}_{1},{w}_{3}\\},$ that is to say, \n\n$$\nB=\\{\\begin{bmatrix}2 \\\\ -6 \\\\ 8\\end{bmatrix},\\begin{bmatrix}2 \\\\ -2 \\\\ 10\\end{bmatrix}\\}.\n$$"} {:db/id #edb/ref 17592186345026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f71b28a-eef0-50b5-b4b5-85ae1a337b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186342499} {:answer/id #uuid "28b83eaa-9f9a-5888-a2aa-1155dad0a14b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$\\text{{}{u}_{1},{u}_{3}\\text{}}$ is not a basis of $\\text{Col}(U)$" :db/id #edb/ref 17592186342579} {:answer/id #uuid "35d6e4cc-ad73-5db8-bcdb-9c95d86e599c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186342681} {:answer/id #uuid "5a8dc9f5-497a-5697-aed3-a18f39d92052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186342995} {:answer/id #uuid "cbb60c97-7060-599d-a7c0-7dc790f9f8b9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186344031}] :answer-field/correct {:answer/id #uuid "1f71b28a-eef0-50b5-b4b5-85ae1a337b71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186342499} :answer-field/id #uuid "d5c1f721-ec7c-5bf5-b0ff-1e3f5a8737f1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344862}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0c9d82d6-6531-5354-9b3b-01e8f3d44990" :question/math-academy-id "q-75083" :question/problem "The matrix $U$ is given below. Let ${u}_{1}$, ${u}_{2}$, and ${u}_{3}$ be the respective columns of $U.$\nDetermine if $B=\\text{{}{u}_{1},{u}_{3}\\text{}}$ is a basis of $\\text{Col}(U).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{3}$, where ${u}_{2}={x}_{1}{u}_{1}+{x}_{3}{u}_{3}.$\n\n$$\nU=\\begin{bmatrix}1 & -2 & -3 \\\\ -4 & 8 & 8\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $U$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}U & =\\begin{bmatrix}1 & -2 & -3 \\\\ -4 & 8 & 8\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & -3 \\\\ 0 & 0 & -4\\end{bmatrix} & {R}_{2} & :=(-\\frac{1}{4}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & -3 \\\\ 0 & 0 & 1\\end{bmatrix} & {R}_{1} & :={R}_{1}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 0 \\\\ 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st and $3$rd columns. So, a basis of $\\text{Col}(U)$ is ${{u}_{1},{u}_{3}},$ that is to say,\n\n$$\nB={\\begin{bmatrix}1 \\\\ -4\\end{bmatrix},\\begin{bmatrix}-3 \\\\ 8\\end{bmatrix}}.\n$$\n\nNow, since the $2$nd column of the reduced matrix is a non-pivot column, then the entries in that column tell us the coefficients needed to express ${u}_{2}$ as a linear combination of all the other columns in the original matrix. So, we have\n\n$$\n\\underbrace{\\begin{bmatrix}-2 \\\\ 8\\end{bmatrix}}_{{u}_{2}}=\\underbrace{(-2)}_{{x}_{1}}\\cdot \\underbrace{\\begin{bmatrix}1 \\\\ -4\\end{bmatrix}}_{{u}_{1}}+\\underbrace{(0)}_{{x}_{3}}\\cdot \\underbrace{\\begin{bmatrix}-3 \\\\ 8\\end{bmatrix}}_{{u}_{3}}.\n$$\n\nThis gives us ${x}_{1}\\cdot {x}_{3}=(-2)\\cdot 0=0.$"} {:db/id #edb/ref 17592186345044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38d0a784-5fd9-5dda-99ca-883f51f6abc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+\\,j+\\,k" :db/id #edb/ref 17592186342706} {:answer/id #uuid "4933b0e6-8fdb-5bb1-8870-15d7f9408f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,i+2\\,j+\\,k" :db/id #edb/ref 17592186342840} {:answer/id #uuid "6e0cb831-d862-599e-8e7e-32ee3a3b5666" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i+\\sqrt{2}\\,j+\\,k" :db/id #edb/ref 17592186343184} {:answer/id #uuid "9a57d9c1-5236-5f0d-9b61-6285b27fe930" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,i-2\\,j+\\,k" :db/id #edb/ref 17592186343596} {:answer/id #uuid "b7bdd1ba-65a0-5e2f-abe2-f90a4069f498" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,i+\\sqrt{2}\\,j+\\,k" :db/id #edb/ref 17592186343850}] :answer-field/correct {:answer/id #uuid "4933b0e6-8fdb-5bb1-8870-15d7f9408f36" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}\\,i+2\\,j+\\,k" :db/id #edb/ref 17592186342840} :answer-field/id #uuid "ea8a09a2-53d5-50df-85c4-266c0287b22d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344901}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "52e03100-7b68-59b1-97e7-23738a101a16" :question/math-academy-id "q-75198" :question/problem "Find a tangent vector to the curve $r(t)=\\operatorname{sec}⁡t\\,i+\\operatorname{tan}⁡t\\,j+t\\,k$ at the point where $t=\\frac{\\pi }{4}.$" :question/worked-solution "At the point where $t=\\frac{\\pi }{4}$,  the vector ${r}^{′}(\\frac{\\pi }{4})$ is tangent to the curve.\n\nLet's calculate ${r}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{4}:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sec}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =\\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,i+{sec}^{2}⁡t\\,j+\\,k \\\\ {r}^{′}(\\frac{\\pi }{4}) & =\\operatorname{sec}⁡\\frac{\\pi }{4}\\operatorname{tan}⁡\\frac{\\pi }{4}\\,i+{sec}^{2}⁡\\frac{\\pi }{4}\\,j+\\,k \\\\  & =\\sqrt{2}\\,i+2\\,j+\\,k\\end{aligned}\n$$\n\nTherefore, a tangent vector to the given curve at the point where $t=\\frac{\\pi }{4}$  is  $\\sqrt{2}\\,i+2\\,j+\\,k.$"} {:db/id #edb/ref 17592186345047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a06e174-b40e-542a-aaa8-c20f58478d60" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(3,-7)$ and $(\\frac{7}{9}\\,,\\,-\\frac{37}{27})$" :db/id #edb/ref 17592186342590} {:answer/id #uuid "773cfdb0-6207-5826-94df-13c1f2047faa" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$(0,0)$ and $(\\frac{4}{3}\\,,\\,\\frac{16}{9})$" :db/id #edb/ref 17592186343273} {:answer/id #uuid "7e0c09ae-372e-5ebb-89f3-5d156de42796" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{4}{3}\\,,\\,\\frac{16}{9})" :db/id #edb/ref 17592186343326} {:answer/id #uuid "bad4b9d3-b637-5250-85a3-4ea2d991b3f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186343880} {:answer/id #uuid "d05ebe96-be0f-540c-960e-86bd11c13d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{7}{9}\\,,\\,-\\frac{37}{27})" :db/id #edb/ref 17592186344068}] :answer-field/correct {:answer/id #uuid "d05ebe96-be0f-540c-960e-86bd11c13d79" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{7}{9}\\,,\\,-\\frac{37}{27})" :db/id #edb/ref 17592186344068} :answer-field/id #uuid "6e9e1595-3b42-5743-84aa-8d4592ec3993" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344691}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f1ab1abc-1cc2-5ae2-8881-b425aa0a15ee" :question/math-academy-id "q-75205" :question/problem "Given the curve $r(t)=⟨{t}^{2}-1\\,,\\,{t}^{3}+1⟩,t\\in (-\\infty ,0)$ find all of the points at which the tangent to the curve is perpendicular to the vector $⟨2\\,,\\,1⟩.$" :question/worked-solution "First, we calculate the derivative of $r(t):$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\,,\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}+1)⟩ \\\\  & =⟨2t\\,,\\,3{t}^{2}⟩\\end{aligned}\n$$\n\nThe vectors  $⟨2\\,,\\,1⟩$ and ${r}^{′}(t)$ are perpendicular for some value of the parameter $t$ if and only if $⟨2\\,,\\,1⟩\\cdot {r}^{′}(t)=0.$ So, we have\n\n$$\n\\begin{aligned}⟨2\\,,\\,1⟩\\cdot {r}^{′}(t) & =0 \\\\ ⟨2\\,,\\,1⟩\\cdot ⟨2t\\,,\\,3{t}^{2}⟩ & =0 \\\\ 2\\cdot 2t+1\\cdot 3{t}^{2} & =0 \\\\ 4t+3{t}^{2} & =0 \\\\ t(4+3t) & =0.\\end{aligned}\n$$\n\nSince $t\\in (-\\infty ,0)$, the only solution is $t=-\\frac{4}{3}$\n\nFinally, since\n\n$$\n\\begin{aligned}r(-\\frac{4}{3}) & =⟨{(-\\frac{4}{3})}^{2}-1\\,,\\,{(-\\frac{4}{3})}^{3}+1⟩=⟨\\frac{7}{9}\\,,\\,-\\frac{37}{27}⟩,\\end{aligned}\n$$\n\n we conclude that $⟨2\\,,\\,-1⟩$ and ${r}^{′}(t)$ are perpendicular at the point $(\\frac{7}{9}\\,,\\,-\\frac{37}{27}).$"} {:db/id #edb/ref 17592186345062 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "33866f64-1510-59e1-bc70-4f67d31cce9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}{csc}^{3}⁡(\\theta )" :db/id #edb/ref 17592186342673} {:answer/id #uuid "d04bf2fb-fce7-5faa-ae83-6b24753b85f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3{csc}^{2}⁡(\\theta )" :db/id #edb/ref 17592186344067} {:answer/id #uuid "f0ca02f7-e657-5790-8ecc-cc7960736bc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{csc}^{3}⁡(\\theta )" :db/id #edb/ref 17592186344353} {:answer/id #uuid "f39296c6-cbb8-58da-954a-e372ded44acc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}{csc}^{3}⁡(\\theta )" :db/id #edb/ref 17592186344381} {:answer/id #uuid "f5e9ec94-68ca-508d-a569-9bbd35ef59f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{csc}^{3}⁡(\\theta )" :db/id #edb/ref 17592186344403}] :answer-field/correct {:answer/id #uuid "33866f64-1510-59e1-bc70-4f67d31cce9c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}{csc}^{3}⁡(\\theta )" :db/id #edb/ref 17592186342673} :answer-field/id #uuid "41f27771-372d-52a9-ab4c-cf748b229432" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344599}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0508c3c2-abfc-50ef-9ddd-8886bbc66cc6" :question/math-academy-id "q-75295" :question/problem "Calculate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ for the polar curve $r=2,$ given that $\\frac{\\text{d}y}{\\text{d}x}=-\\operatorname{cot}⁡(\\theta ).$" :question/worked-solution "We will use the formula\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=\\frac{\\frac{d}{d\\theta }(\\frac{dy}{dx})}{(\\frac{dx}{d\\theta })}.\\end{aligned}\n$$\n\nWe're told that $\\,\\frac{\\text{d}y}{\\text{d}x}=-\\operatorname{cot}⁡(\\theta ).$ Also, since $r=2,$ we have\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta =2\\operatorname{cos}⁡\\theta .\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{dx}{d\\theta } & =-2\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nSubstituting into our formula for the second derivative, we get\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\frac{d}{d\\theta }(-\\operatorname{cot}⁡(\\theta ))}{-2\\operatorname{sin}⁡\\theta } \\\\  & =\\frac{{csc}^{2}⁡(\\theta )}{-2\\operatorname{sin}⁡(\\theta )} \\\\  & =-\\frac{1}{2}{csc}^{3}⁡(\\theta ).\\end{aligned}\n$$"}]
