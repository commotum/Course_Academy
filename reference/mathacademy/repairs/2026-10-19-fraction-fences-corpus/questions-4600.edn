{2}(\\frac{{z}^{3+1}}{3+1})+C \\\\  & =\\frac{1}{2}\\cdot \\frac{{z}^{4}}{4}+C \\\\  & =\\frac{{z}^{4}}{8}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338907 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09b6ff67-4138-58ea-94dd-6bb8c9ebd100" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{6}+C" :db/id #edb/ref 17592186336118} {:answer/id #uuid "828a543e-18e7-558b-9b8a-5619826dd00a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{12}+C" :db/id #edb/ref 17592186337219} {:answer/id #uuid "b563b75d-32af-5225-9bcc-e72ef5253840" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5{x}^{6}}{12}+C" :db/id #edb/ref 17592186337648} {:answer/id #uuid "ee0ea1f9-08f7-5950-8c1a-c412188e036f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{4}+C" :db/id #edb/ref 17592186338113} {:answer/id #uuid "f5d3daa8-503d-543b-91dd-745b2a60d6b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12{x}^{6}+C" :db/id #edb/ref 17592186338183}] :answer-field/correct {:answer/id #uuid "ee0ea1f9-08f7-5950-8c1a-c412188e036f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{x}^{6}}{4}+C" :db/id #edb/ref 17592186338113} :answer-field/id #uuid "a4f2b542-6f34-56ff-ab94-00255931de9b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338584}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83815382-7a50-585c-99ac-149a3085c008" :question/math-academy-id "q-71164" :question/problem "Calculate $\\int \\frac{3}{2}{x}^{5}\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{3}{2}{x}^{5}\\,\\text{d}x & =\\frac{3}{2}\\int {x}^{5}\\,\\text{d}x \\\\  & =\\frac{3}{2}(\\frac{{x}^{5+1}}{5+1})+C \\\\  & =\\frac{3}{2}\\cdot \\frac{{x}^{6}}{6}+C \\\\  & =\\frac{{x}^{6}}{4}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338908 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1d8d8472-3abf-5397-bb1e-f42c4b1ae7cf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4{x}^{5}+C" :db/id #edb/ref 17592186336307} {:answer/id #uuid "37ed7c0a-79f6-5272-bd35-2662e9c03587" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8{x}^{4}+C" :db/id #edb/ref 17592186336551} {:answer/id #uuid "543a3a68-ee3b-56cc-9d55-b7fe4b24b74a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{4}+C" :db/id #edb/ref 17592186336810} {:answer/id #uuid "895d314a-f1f0-5387-b5b7-a9e0d9a5a268" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{5}+C" :db/id #edb/ref 17592186337270} {:answer/id #uuid "d0002111-f915-5c84-8ac7-a2e9f9ed6fe1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4{x}^{4}+C" :db/id #edb/ref 17592186337852}] :answer-field/correct {:answer/id #uuid "543a3a68-ee3b-56cc-9d55-b7fe4b24b74a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2{x}^{4}+C" :db/id #edb/ref 17592186336810} :answer-field/id #uuid "092a56d4-2594-5382-a5b9-d778520c9056" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338292}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1f9197c9-6545-5b05-9e0e-dc89f6ab104f" :question/math-academy-id "q-71165" :question/problem "Calculate $\\int (-8{x}^{3})\\,\\text{d}x.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int (-8{x}^{3})\\,\\text{d}x & =-8\\int {x}^{3}\\,\\text{d}x \\\\  & =-8(\\frac{{x}^{3+1}}{3+1})+C \\\\  & =-8\\cdot \\frac{{x}^{4}}{4}+C \\\\  & =-2{x}^{4}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338929 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157bc3da-2d1c-5137-b516-d8ff7c42bad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}(i+j)" :db/id #edb/ref 17592186336235} {:answer/id #uuid "3cfe7ebf-3262-597f-b2fd-edf534fd618c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i" :db/id #edb/ref 17592186336607} {:answer/id #uuid "4baa559e-cde4-5072-9145-09ac20cb641a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186336735} {:answer/id #uuid "829583d7-8e78-579d-9221-64ce8b48dc24" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}(i-j)" :db/id #edb/ref 17592186337220} {:answer/id #uuid "e26af925-4997-53e5-8b3d-7425b92d8e93" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186338003}] :answer-field/correct {:answer/id #uuid "4baa559e-cde4-5072-9145-09ac20cb641a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}(i-j)" :db/id #edb/ref 17592186336735} :answer-field/id #uuid "e48649d2-bf76-55fc-aef9-b0aff8e82c8d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338680}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "22cfc584-e8e6-55e0-a1d3-35d71c5742a0" :question/math-academy-id "q-71370" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)={x}^{2}+{y}^{2}$ that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2}).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2})$, can be found by computing $∇f(-\\frac{1}{2},\\frac{1}{2}).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\text{ }i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\text{ }j \\\\  & =2x\\text{ }i+2y\\text{ }j \\\\ ∇f(-\\frac{1}{2},\\frac{1}{2}) & =2(-\\frac{1}{2})\\text{ }i+2(\\frac{1}{2})\\text{ }j \\\\  & =-i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∇f(-\\frac{1}{2},\\frac{1}{2})}{‖∇f(-\\frac{1}{2},\\frac{1}{2})‖} & =\\frac{-i+j}{\\sqrt{(-1)^{2}+(1)^{2}}} \\\\  & =\\frac{-i+j}{\\sqrt{2}} \\\\  & =-\\frac{\\sqrt{2}}{2}(i-j)\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338930 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049b7f23-d6a7-5be3-a6ca-ac19b8a84234" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-j" :db/id #edb/ref 17592186336070} {:answer/id #uuid "123c36c6-7310-581c-8de4-b675e090dc56" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i+i" :db/id #edb/ref 17592186336203} {:answer/id #uuid "4b49d759-d015-5843-b6e9-3497dc09edfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "i-i" :db/id #edb/ref 17592186336730} {:answer/id #uuid "6e16ffd6-406d-50b5-9b6a-0f4b899fc6bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i" :db/id #edb/ref 17592186337009} {:answer/id #uuid "ccd3f738-ef19-5d09-afcb-04a5b6bdd7fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}(-2i+i)" :db/id #edb/ref 17592186337828}] :answer-field/correct {:answer/id #uuid "6e16ffd6-406d-50b5-9b6a-0f4b899fc6bd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-i" :db/id #edb/ref 17592186337009} :answer-field/id #uuid "60184a90-8959-560b-aa4a-378830d13dbb" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338445}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "436e814d-020d-5b28-b909-495bbb1c431a" :question/math-academy-id "q-71374" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=x+3y-2xy$ that passes through the point where $(x,y)=(\\frac{3}{2},1).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(\\frac{3}{2},1)$, can be found by computing $∇f(\\frac{3}{2},1).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x+3y-2xy)\\text{ }i+\\frac{∂}{∂y}(x+3y-2xy)\\text{ }j \\\\  & =(1-2y)\\text{ }i+(3-2x)\\text{ }j \\\\ ∇f(\\frac{3}{2},1) & =(1-2(1))\\text{ }i+(3-2(\\frac{3}{2}))\\text{ }j \\\\  & =-i\\end{aligned}\n$$\n\nFinally, we normalize $∇f(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}\\frac{∇f(\\frac{3}{2},1)}{‖∇f(\\frac{3}{2},1)‖} & =\\frac{-i}{1}=-i\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338958 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "095f0794-39e0-5248-a897-200aa365fb49" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336115} {:answer/id #uuid "3b3334b6-e096-5561-85b8-d0e63cefc06f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186336589} {:answer/id #uuid "67a09e4b-a7d7-5075-9742-255d4d1d82c1" :answer/type {:db/id #edb/ref 1759