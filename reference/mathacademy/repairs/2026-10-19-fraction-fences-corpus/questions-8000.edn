s}⁡({120}^{∘}) \\\\  & =1(-\\frac{1}{2}) \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =1\\operatorname{sin}⁡({120}^{∘}) \\\\  & =1\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{1}{2},\\frac{\\sqrt{3}}{2}).$"} {:db/id #edb/ref 17592186564606 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29381743-bc0a-58b7-b7c6-16932dd9f9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186564607}] :answer-field/correct {:answer/id #uuid "29381743-bc0a-58b7-b7c6-16932dd9f9e3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186564607} :answer-field/id #uuid "66f7196b-f145-51aa-93ef-8dcbc705481c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564616} {:answer-field/choices [{:answer/id #uuid "248e1098-29d9-543b-83d4-0b32e84165eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186564605}] :answer-field/correct {:answer/id #uuid "248e1098-29d9-543b-83d4-0b32e84165eb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186564605} :answer-field/id #uuid "d519eb60-a305-58da-aa54-032b41b18629" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186564643}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "26aee229-9b71-5508-be41-0115539b71ac" :question/problem "If the distance from a point $P$ to the origin is $1,$ and that $