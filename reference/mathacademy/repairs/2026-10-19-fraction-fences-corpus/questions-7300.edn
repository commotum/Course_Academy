 \\frac{2}{t - 1}),\\,\\frac{\\text{d}}{\\text{d}t}(\\cos{\\left(4 t \\right)})⟩ \\\\ &=6 t^{2}\\,i+\\frac{2}{\\left(t - 1\\right)^{2}}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k \\\\ g'(t)&=⟨\\frac{\\text{d}}{\\text{d}t}(4 t - 2),\\,\\frac{\\text{d}}{\\text{d}t}(e^{4 t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\cos{\\left(4 t \\right)})⟩ \\\\ &=4\\,i+4 e^{4 t}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(2f(t)+2g(t))'&=2f'(\\!t)+2g'(\\!t) \\\\ &=2\\left(6 t^{2}\\,i+\\frac{2}{\\left(t - 1\\right)^{2}}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\right)+2\\left(4\\,i+4 e^{4 t}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\right) \\\\ &=\\left(12 t^{2}\\,i+\\frac{4}{\\left(t - 1\\right)^{2}}\\,j- 8 \\sin{\\left(4 t \\right)}\\,k\\right)+\\left(8\\,i+8 e^{4 t}\\,j- 8 \\sin{\\left(4 t \\right)}\\,k\\right) \\\\ &=(12 t^{2} + 8)\\,i+(8 e^{4 t} + \\frac{4}{\\left(t - 1\\right)^{2}})\\,j- 16 \\sin{\\left(4 t \\right)}\\,k.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186532888 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05042b03-df4c-5ccd-a964-8eaf6131a969" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8\\,i+4 e^{2 t}\\,j- 8 \\sin{\\left(4 t \\right)}\\,k" :db/id #edb/ref 17592186532861} {:answer/id #uuid "1c3aff9f-c826-5930-ba16-3983961fdd31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8 - 18 t^{2})\\,i+(4 e^{2 t} - \\frac{6}{\\left(t + 3\\right)^{2}})\\,j" :db/id #edb/ref 17592186532869} {:answer/id #uuid "838a64ec-997e-5f8b-96bd-2d63e5eac034" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 18 t^{2}\\,i- \\frac{6}{\\left(t + 3\\right)^{2}}\\,j+8 \\sin{\\left(4 t \\right)}\\,k" :db/id #edb/ref 17592186532885} {:answer/id #uuid "9de0d38a-bfd3-57c3-907f-f60c0eb825dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 6 t^{3} + 8 t - 14)\\,i+\\frac{2 \\left(\\left(t + 3\\right) e^{2 t} + 3\\right)}{t + 3}\\,j" :db/id #edb/ref 17592186532890} {:answer/id #uuid "bf993974-3b0c-5c9f-886d-1d6ca421c69c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(18 t^{2} + 8)\\,i+(4 e^{2 t} + \\frac{6}{\\left(t + 3\\right)^{2}})\\,j- 16 \\sin{\\left(4 t \\right)}\\,k" :db/id #edb/ref 17592186532899}] :answer-field/correct {:answer/id #uuid "1c3aff9f-c826-5930-ba16-3983961fdd31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(8 - 18 t^{2})\\,i+(4 e^{2 t} - \\frac{6}{\\left(t + 3\\right)^{2}})\\,j" :db/id #edb/ref 17592186532869} :answer-field/id #uuid "f573ff47-df7f-5224-8ed0-621e1426dd66" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532908}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8facb5d0-2042-58b2-9944-895664b71392" :question/problem "Find the derivative of $-2f(t)+2g(t)$ with respect to $t$, where\n\n$$\n\\begin{aligned}f(t)&=(3 t^{3} + 4)\\,i- \\frac{3}{t + 3}\\,j+\\cos{\\left(4 t \\right)}\\,k \\\\ g(t)&=(4 t - 3)\\,i+e^{2 t}\\,j+\\cos{\\left(4 t \\right)}\\,k\\end{aligned}\n$$" :question/worked-solution "Using the constant multiple rule and the sum rule, we have\n\n$$\n(-2f(t)+2g(t))'=-2f'(\\!t)+2g'(\\!t).\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}f'(t)&=⟨\\frac{\\text{d}}{\\text{d}t}(3 t^{3} + 4),\\,\\frac{\\text{d}}{\\text{d}t}(- \\frac{3}{t + 3}),\\,\\frac{\\text{d}}{\\text{d}t}(\\cos{\\left(4 t \\right)})⟩ \\\\ &=9 t^{2}\\,i+\\frac{3}{\\left(t + 3\\right)^{2}}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k \\\\ g'(t)&=⟨\\frac{\\text{d}}{\\text{d}t}(4 t - 3),\\,\\frac{\\text{d}}{\\text{d}t}(e^{2 t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\cos{\\left(4 t \\right)})⟩ \\\\ &=4\\,i+2 e^{2 t}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(-2f(t)+2g(t))'&=-2f'(\\!t)+2g'(\\!t) \\\\ &=-2\\left(9 t^{2}\\,i+\\frac{3}{\\left(t + 3\\right)^{2}}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\right)+2\\left(4\\,i+2 e^{2 t}\\,j- 4 \\sin{\\left(4 t \\right)}\\,k\\right) \\\\ &=\\left(- 18 t^{2}\\,i- \\frac{6}{\\left(t + 3\\right)^{2}}\\,j+8 \\sin{\\left(4 t \\right)}\\,k\\right)+\\left(8\\,i+4 e^{2 t}\\,j- 8 \\sin{\\left(4 t \\right)}\\,k\\right) \\\\ &=(8 - 18 t^{2})\\,i+(4 e^{2 t} - \\frac{6}{\\left(t + 3\\right)^{2}})\\,j.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186532891 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "777522b1-6939-5b66-8d41-4c0af7a31559" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,i+4 e^{2 t}\\,j- 6 \\sin{\\left(3 t \\right)}\\,k" :db/id #edb/ref 17592186532884} {:answer/id #uuid "8631399e-befe-5fda-89cf-04216c222ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4 - 16 t)\\,i+(4 e^{2 t} - \\frac{8}{\\left(t + 3\\right)^{2}})\\,j" :db/id #edb/ref 17592186532886} {:answer/id #uuid "b2ccd2c1-ee5e-53ce-8fa5-271cd400ba26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(- 8 t^{2} + 4 t - 12)\\,i+\\frac{2 \\left(\\left(t + 3\\right) e^{2 t} + 4\\right)}{t + 3}\\,j" :db/id #edb/ref 17592186532896} {:answer/id #uuid "bd9aa792-0b2d-537e-877a-bee6cb6606f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(16 t + 4)\\,i+(4 e^{2 t} + \\frac{8}{\\left(t + 3\\right)^{2}})\\,j- 12 \\sin{\\left(3 t \\right)}\\,k" :db/id #edb/ref 17592186532898} {:answer/id #uuid "dd248600-23aa-53ba-92c5-dd1baf90dce8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 16 t\\,i- \\frac{8}{\\left(t + 3\\right)^{2}}\\,j+6 \\sin{\\left(3 t \\right)}\\,k" :db/id #edb/ref 17592186532903}] :answer-field/correct {:answer/id #uuid "8631399e-befe-5fda-89cf-04216c222ee4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(4 - 16 t)\\,i+(4 e^{2 t} - \\frac{8}{\\left(t + 3\\right)^{2}})\\,j" :db/id #edb/ref 17592186532886} :answer-field/id #uuid "3e314097-0298-520f-9c83-0f0fe71e1ac1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186532873}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "a2b09545-4d92-5fd4-a34e-ae79048ac39c" :question/problem "Find the derivative of $-2f(t)+2g(t)$ with respect to $t$, where\n\n$$\n\\begin{aligned}f(t)&=(4 t^{2} + 2)\\,i- \\frac{4}{t + 3}\\,j+\\cos{\\left(3 t \\right)}\\,k \\\\ g(t)&=(2 t - 4)\\,i+e^{2 t}\\,j+\\cos{\\left(3 t \\right)}\\,k\\end{aligned}\n$$" :question/worked-solution "Using the constant multiple rule and the sum rule, we have\n\n$$\n(-2f(t)+2g(t))'=-2f'(\\!t)+2g'(\\!t).\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}f'(t)&=⟨\\frac{\\text{d}}{\\text{d}t}(4 t^{2} + 2),\\,\\frac{\\text{d}}{\\text{d}t}(- \\frac{4}{t + 3}),\\,\\frac{\\text{d}}{\\text{d}t}(\\cos{\\left(3 t \\right)})⟩ \\\\ &=8 t\\,i+\\frac{4}{\\left(t + 3\\right)^{2}}\\,j- 3 \\sin{\\left(3 t \\right)}\\,k \\\\ g'(t)&=⟨\\frac{\\text{d}}{\\text{d}t}(2 t - 4),\\,\\frac{\\text{d}}{\\text{d}t}(e^{2 t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\cos{\\left(3 t \\right)})⟩ \\\\ &=2\\,i+2 e^{2 t}\\,j- 3 \\sin{\\left(3 t \\right)}\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(-2f(t)+2g(t))'&=-2f'(\\!t)+2g'(\\!t) \\\\ &=-2\\left(8 t\\,i+\\frac{4}{\\left(t + 3\\right)^{2}}\\,j- 3 \\sin{\\left(3 t \\right)}\\,k\\right)+2\\left(2\\,i+2 e^{2 t}\\,j- 3 \\sin{\\left(3 t \\right)}\\,k\\right) \\\\ &=\\left(- 16 t\\,i- \\frac{8}{\\left(t + 3\\right)^{2}}\\,j+6 \\sin{\\left(3 t \\right)}\\,k\\right)+\\left(4\\,i+4 e^{2 t}\\,j- 6 \\sin{\\left(3 t \\right)}\\,k\\right) \\\\ &=(4 - 16 t)\\,i+(4 e^{2 t} - \\frac{8}{\\left(t + 3\\right)^{2}})\\,j.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534026 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fd76159-2140-5346-98a1-4afe816c2e3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186533332} {:answer/id #uuid "a62ca124-9da6-5b38-bae4-21401dc99670" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{8}" :db/id #edb/ref 17592186533540} {:answer/id #uuid "df606574-cd00-549e-b533-e130e89eaadb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186533691} {:answer/id #uuid "e8be0511-cfcd-558e-ab87-0f2fcf576a90" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186533711} {:answer/id #uuid "eb0bdda5-9a04-5aae-a0c0-3728d75cd1ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186533720}] :answer-field/correct {:answer/id #uuid "4fd76159-2140-5346-98a1-4afe816c2e3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186533332} :answer-field/id #uuid "406ab344-f9fd-5033-9ed9-b2f83ded5ae0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533832}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7fc0fee8-5d8f-576c-8b1d-3594d43c9abb" :question/math-academy-id "q-44083" :question/problem "$\\sqrt[3]{\\frac{125}{64}}=$" :question/worked-solution "First, notice that the numbers $125$ and $64$ are both perfect cubes. \n\nSo, to determine the value of $\\sqrt[3]{\\frac{125}{64}},$ we express $\\frac{125}{64}$ as a perfect cube:\n\n$$\n\\begin{aligned}\\sqrt[3]{\\frac{125}{64}} &= \\sqrt[3]{\\frac{{5}^{3}}{{4}^{3}}} \\\\ &= \\sqrt[3]{\\frac{5\\cdot 5\\cdot 5}{4\\cdot 4\\cdot 4}} \\\\ &= \\sqrt[3]{\\frac{5}{4}\\cdot \\frac{5}{4}\\cdot \\frac{5}{4}} \\\\ &= \\sqrt[3]{{(\\frac{5}{4})}^{3}} \\\\ &= \\frac{5}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534031 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c406db1-ac6c-5309-b97f-14fd566c17b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{2}+x+11" :db/id #edb/ref 17592186533391}] :answer-field/correct {:answer/id #uuid "6c406db1-ac6c-5309-b97f-14fd566c17b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2x^{2}+x+11" :db/id #edb/ref 17592186533391} :answer-field/id #uuid "8d713dab-487c-57b4-848a-8f859a772276" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533887}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "88fe2774-53cf-5c90-a007-5fb6a5d78b33" :question/math-academy-id "q-343529" :question/problem "Given that $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}},$ find ${y}^{′}.$\n\n${y}^{′}=\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[$\n{{field-1}}$]$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡((x-2)^{5})-\\operatorname{ln}⁡({e}^{{x}^{2}+3x}) \\\\ \\operatorname{ln}⁡y & =5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(5\\operatorname{ln}⁡(x-2)-({x}^{2}+3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =5\\cdot \\frac{1}{x-2}-(2x+3) \\\\ \\frac{{y}^{′}}{y} & =\\frac{5}{x-2}-(2x+3)\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y[\\frac{5}{x-2}-(2x+3)]\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5}{x-2}-(2x+3)] \\\\  & =\\frac{(x-2)^{5}}{{e}^{{x}^{2}+3x}}[\\frac{5-(x-2)(2x+3)}{x-2}] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(x-2)(2x+3)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[5-(2{x}^{2}-x-6)] \\\\  & =\\frac{(x-2)^{4}}{{e}^{{x}^{2}+3x}}[11+x-2{x}^{2}]\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534050 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05799cd7-f400-5c7b-836e-13b13f3082f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186533145} {:answer/id #uuid "a2e0bf37-f531-5fed-886f-ab4f49a72c76" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186533533} {:answer/id #uuid "ca79e18a-6b59-5bc2-bd82-0ef35898556b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186533626} {:answer/id #uuid "d42674cd-c7f0-5ed1-8d79-1792bb1647cc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186533656} {:answer/id #uuid "d7f175b0-f502-5c71-87d2-cf99b4d09788" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186533667}] :answer-field/correct {:answer/id #uuid "05799cd7-f400-5c7b-836e-13b13f3082f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186533145} :answer-field/id #uuid "c5ad5d54-7dab-5f4d-91cd-7fa772695521" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533920}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af89df79-e52d-58d8-85da-a2767435fe32" :question/math-academy-id "q-161145" :question/problem "Find the surface area of the portion of the cylinder $z=\\sqrt{1-{y}^{2}}$ whose projection onto the $xy$-plane is bounded by $y=\\operatorname{sin}⁡x,$ $x=1,$ and the $x$-axis." :question/worked-solution "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz=\\sqrt{1-{y}^{2}},\\,(x,y)\\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le \\operatorname{sin}⁡x\\},\n$$\n\nas shown in the diagram below.\n\n![](images/03/03b9d0f5ae212262bc82e2e2986dfeb6cd3b85f5c8217aba1c7c3c39c97db3d7.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(\\sqrt{1-{y}^{2}})=0, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(\\sqrt{1-{y}^{2}})=-\\frac{y}{\\sqrt{1-{y}^{2}}},\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+(0)^{2}+{(-\\frac{y}{\\sqrt{1-{y}^{2}}})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+\\frac{{y}^{2}}{1-{y}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{\\frac{1}{1-{y}^{2}}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{\\operatorname{sin}⁡x}\\frac{1}{\\sqrt{1-{y}^{2}}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\operatorname{arcsin}⁡y\\,{|}_{0}^{\\operatorname{sin}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}x\\,\\text{d}x \\\\  & ={\\frac{{x}^{2}}{2}\\,|}_{0}^{1} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534067 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c61cfcf-a787-550b-810a-38a9ae04f7fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x-6" :db/id #edb/ref 17592186533208} {:answer/id #uuid "9411358e-dbc0-567a-a1c3-e8fae0dff5ca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x" :db/id #edb/ref 17592186533497} {:answer/id #uuid "96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x" :db/id #edb/ref 17592186533508} {:answer/id #uuid "c744d1de-7757-5a26-ac48-bc584e98ec52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x+6" :db/id #edb/ref 17592186533617} {:answer/id #uuid "d6c60272-837e-5905-b5bf-1a14841fc162" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3x-3" :db/id #edb/ref 17592186533662}] :answer-field/correct {:answer/id #uuid "96e9100a-3748-5dd5-ad4e-9a90375f9d8f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6x" :db/id #edb/ref 17592186533508} :answer-field/id #uuid "52f2bc75-08e1-5592-986f-bf5ac47ce09a" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533847}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cc13fb5c-5303-5c81-bafe-333779ced9ca" :question/math-academy-id "q-138854" :question/problem "Consider the function $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{1}{2}(g(x)-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "Our function can be written as\n\n$$\n\\begin{aligned}y & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}} \\\\  & =\\frac{\\sqrt{({x}^{2}+4)^{3}}}{\\sqrt{\\operatorname{sin}⁡x}} \\\\  & =\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}.\\end{aligned}\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+4)^{3/2}}{(\\operatorname{sin}⁡x)^{1/2}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+4)^{3/2})-\\operatorname{ln}⁡((\\operatorname{sin}⁡x)^{1/2}) \\\\ \\operatorname{ln}⁡y & =\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(\\frac{3}{2}\\operatorname{ln}⁡({x}^{2}+4)-\\frac{1}{2}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\frac{3}{2}\\cdot \\frac{1}{{x}^{2}+4}\\cdot 2x-\\frac{1}{2}\\cdot \\frac{1}{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\ \\frac{{y}^{′}}{y} & =\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}\\end{aligned}\n$$\n\n \n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{3x}{{x}^{2}+4}-\\frac{\\operatorname{cot}⁡x}{2}) \\\\  & =\\sqrt{\\frac{({x}^{2}+4)^{3}}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2({x}^{2}+4)}) \\\\  & =\\sqrt{\\frac{{x}^{2}+4}{\\operatorname{sin}⁡x}}(\\frac{6x-({x}^{2}+4)\\operatorname{cot}⁡x}{2}) \\\\  & =\\frac{1}{2}(6x-({x}^{2}+4)\\operatorname{cot}⁡x)\\sqrt{({x}^{2}+4)\\operatorname{csc}⁡x}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=6x.\n$$"} {:db/id #edb/ref 17592186534070 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3171f3f1-b42e-5b23-bf4a-d4abdcfda312" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.92+12\\theta -3{\\theta }^{2}" :db/id #edb/ref 17592186533260} {:answer/id #uuid "36743fa8-d11f-5277-bb11-6800921de937" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10.04+6\\theta -{\\theta }^{2}" :db/id #edb/ref 17592186533267} {:answer/id #uuid "44588364-77e7-5293-9871-f77f9b19a264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10.54+11\\theta -3{\\theta }^{2}" :db/id #edb/ref 17592186533298} {:answer/id #uuid "63fa5ce6-de9e-5d28-b5ef-e762a11c1eb6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-9.88+12\\theta -3{\\theta }^{2}" :db/id #edb/ref 17592186533368} {:answer/id #uuid "a04280ae-ca06-57f0-95b1-5cb9b2387e89" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8.12+11\\theta -3{\\theta }^{2}" :db/id #edb/ref 17592186533527}] :answer-field/correct {:answer/id #uuid "44588364-77e7-5293-9871-f77f9b19a264" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-10.54+11\\theta -3{\\theta }^{2}" :db/id #edb/ref 17592186533298} :answer-field/id #uuid "13f209dd-c051-5b5e-8018-eed49751c9a8" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533793}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cf2980b5-8d36-5df9-841e-821c9785b285" :question/math-academy-id "q-159956" :question/problem "Suppose ${X}_{1},{X}_{2},{X}_{3},{X}_{4},{X}_{5},{X}_{6}$ is an I.I.D random sample with ${X}_{i}∼N(\\theta ,1),$  where $\\theta $ is an unknown mean.  Given that the likelihood function of the sample $1.7,\\,2.3,\\,2.2,\\,1.1,\\,1.9,\\,1.8$ is\n\n$$\nL(\\theta )=\\frac{1}{8{\\pi }^{3}}\\,{e}^{\\,g(\\theta )},\n$$\n\nwhat is the expression for $g(\\theta )?$" :question/worked-solution "Recall that if ${X}_{1},{X}_{2},…,{X}_{n}$ are independent and identically distributed continuous random variables with probability density function $f(x;\\theta ),$ where $\\theta $ is an unknown parameter, then the likelihood function of a random sample ${x}_{1},{x}_{2},…,{x}_{n}$ is\n\n$$\nL(\\theta )=P({X}_{1}={x}_{1},{X}_{2}={x}_{2},…,{X}_{n}={x}_{n})={\\prod }_{i=1}^{n}f({x}_{i};\\,\\theta ).\n$$\n\nIn our case, we are given a sample of $n=6$ independent normal random variables with unknown mean $\\theta $ and variance ${\\sigma }^{2}=1,$ for which the probability density function is\n\n$$\nf(x;\\theta )=\\frac{1}{\\sigma \\sqrt{2\\pi }}{e}^{-\\frac{1}{2}{(\\frac{x-\\theta }{\\sigma })}^{2}}=\\frac{1}{\\sqrt{2\\pi }}{e}^{-(x-\\theta )^{2}/2},\\,x\\in (-\\infty ,\\infty ).\n$$\n\nWe can calculate the likelihood function as follows:\n\n$$\n\\begin{aligned}L(\\theta ) & ={\\prod }_{i=1}^{n}(\\frac{1}{\\sqrt{2\\pi }}{e}^{-({x}_{i}-\\theta )^{2}/2}) \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-\\sum ({x}_{i}-\\theta )^{2}/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(\\sum {x}_{i}^{2}-2\\theta \\sum {x}_{i}+n{\\theta }^{2})/2} \\\\  & =(2\\pi )^{-n/2}\\,{e}^{-(C-2S\\theta +n{\\theta }^{2})/2}\\end{aligned}\n$$\n\nwhere $S={\\sum }_{i=1}^{n}{x}_{i}$ and $C={\\sum }_{i=1}^{n}{x}_{i}^{2}.$\n\nFor our sample, we have that\n\n$$\n\\begin{aligned}S & ={\\sum }_{i=1}^{n}{x}_{i} \\\\  & =1.7+2.3+2.2+1.1+1.9+1.8 \\\\  & =11 \\\\ C & ={\\sum }_{i=1}^{n}{x}_{i}^{2} \\\\  & =(1.7)^{2}+(2.3)^{2}+(2.2)^{2}+(1.1)^{2}+(1.9)^{2}+(1.8)^{2} \\\\  & =21.08\\end{aligned}\n$$\n\nand $n=6.$ Therefore, \n\n$$\n\\begin{aligned}L(\\theta ) & =(2\\pi )^{-6/2}\\,{e}^{-(21.08-2(11)\\theta +6{\\theta }^{2})/2} \\\\  & =\\frac{1}{8{\\pi }^{3}}\\,{e}^{\\,-10.54\\,+\\,11\\theta \\,-\\,3{\\theta }^{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(\\theta )=-10.54+11\\theta -3{\\theta }^{2}.\n$$"} {:db/id #edb/ref 17592186534074 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30ec5fc0-ee34-584e-9d88-01e89c37816f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡2+4" :db/id #edb/ref 17592186533256}] :answer-field/correct {:answer/id #uuid "30ec5fc0-ee34-584e-9d88-01e89c37816f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡2+4" :db/id #edb/ref 17592186533256} :answer-field/id #uuid "782cb243-75dd-5b8b-940c-de9dd816a45d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d58d6a00-0092-54a9-834c-43383db09b35" :question/math-academy-id "q-348615" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-3}^{-2}\\frac{5-3x}{{x}^{2}+2x+1}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's first factor the denominator of the integrand:\n\n$$\n\\frac{5-3x}{{x}^{2}+2x+1}=\\frac{5-3x}{(x+1)^{2}}\n$$\n\nWe must convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{5-3x}{(x+1)^{2}}=\\frac{A}{x+1}+\\frac{B}{(x+1)^{2}}\n$$\n\nTo determine the coefficients $A$ and $B,$ we first multiply both sides of the above equation by $(x+1)^{2}$ and get\n\n$$\n5-3x=A(x+1)+B.\n$$\n\nPlugging in $x=-1,$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}5-3(-1) & =A(-1+1)+B \\\\ B & =8\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $B,$ we can solve for $A:$\n\n$$\n\\begin{aligned}5-3(0) & =A(0+1)+8 \\\\ 5 & =A+8 \\\\ A & =-3\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum:\n\n$$\n\\frac{5-3x}{(x+1)^{2}}=-\\frac{3}{x+1}+\\frac{8}{(x+1)^{2}}\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{-2}\\frac{5-3x}{(x+1)^{2}}\\,\\text{d}x & ={\\int }_{-3}^{-2}(-\\frac{3}{x+1}+\\frac{8}{(x+1)^{2}})\\text{d}x \\\\  & =-3{\\int }_{-3}^{-2}\\frac{1}{x+1}\\,\\text{d}x+8{\\int }_{-3}^{-2}\\frac{1}{(x+1)^{2}}\\,\\text{d}x \\\\  & =-3\\operatorname{ln}⁡|x+1|\\,{|}_{-3}^{-2}-8\\cdot \\frac{1}{x+1}\\,{|}_{-3}^{-2} \\\\  & =-3(\\operatorname{ln}⁡1-\\operatorname{ln}⁡2)-8(-1-(-\\frac{1}{2})) \\\\  & =-3\\operatorname{ln}⁡(\\frac{1}{2})-8(-\\frac{1}{2}) \\\\  & =3\\operatorname{ln}⁡2+4.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534079 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2f947482-c2c6-568d-82f0-29af6bfba254" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+8{x}^{3}+x+5" :db/id #edb/ref 17592186533253} {:answer/id #uuid "3e350aae-2cd2-5f81-8e5d-74dec200744b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+8{x}^{3}+x+5" :db/id #edb/ref 17592186533284} {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id #edb/ref 17592186533382} {:answer/id #uuid "89588797-26b1-5b42-8b21-2029da27dbba" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{x}^{4}+16{x}^{3}+2x+8" :db/id #edb/ref 17592186533468} {:answer/id #uuid "b35826d5-c07d-51fb-931e-4b0d6ab4dd47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+2x+8" :db/id #edb/ref 17592186533574}] :answer-field/correct {:answer/id #uuid "67b07a11-17f0-5c4c-a4ca-8e59d532b7ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2{x}^{4}+16{x}^{3}+x+5" :db/id #edb/ref 17592186533382} :answer-field/id #uuid "0d94c7c1-de0e-5fb5-af87-71126c21e380" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533784}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "deb7ada4-14d9-5457-acd5-ef77477a4e36" :question/math-academy-id "q-138832" :question/problem "Consider the function $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.$  The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{2{e}^{{x}^{4}+2x}g(x)}{(x+8)^{7}}.\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}.\n$$\n\nFirst, we take the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡({e}^{{x}^{4}+2x})-\\operatorname{ln}⁡((x+8)^{6}) \\\\ \\operatorname{ln}⁡y & ={x}^{4}+2x-6\\operatorname{ln}⁡(x+8)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}({x}^{4}+2x-6\\operatorname{ln}⁡(x+8)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =4{x}^{3}+2-6\\cdot \\frac{1}{x+8} \\\\ \\frac{{y}^{′}}{y} & =4{x}^{3}+2-\\frac{6}{x+8}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$\n\n$$\n\\begin{aligned}{y}^{′} & =y(4{x}^{3}+2-\\frac{6}{x+8})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(4{x}^{3}+2-\\frac{6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{6}}(\\frac{(4{x}^{3}+2)(x+8)-6}{x+8}) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}((4{x}^{3}+2)(x+8)-6) \\\\  & =\\frac{{e}^{{x}^{4}+2x}}{(x+8)^{7}}(4{x}^{4}+32{x}^{3}+2x+16-6) \\\\  & =\\frac{2{e}^{{x}^{4}+2x}(2{x}^{4}+16{x}^{3}+x+5)}{(x+8)^{7}}\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\ng(x)=2{x}^{4}+16{x}^{3}+x+5.\n$$"} {:db/id #edb/ref 17592186534089 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "560ca343-84cc-5cc4-a3c5-9effcec6587f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186533342} {:answer/id #uuid "640be951-359a-5d8f-b29c-cb91c69924db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186533369} {:answer/id #uuid "879b45bc-63cc-5a3c-b562-58a33893a1f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186533462} {:answer/id #uuid "8b778cb7-5c32-5c17-945f-34ef52db3347" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186533476} {:answer/id #uuid "b6f9dda4-22fb-5cd2-80f7-a6caa1b47139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186533587}] :answer-field/correct {:answer/id #uuid "b6f9dda4-22fb-5cd2-80f7-a6caa1b47139" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186533587} :answer-field/id #uuid "2bd71a52-a185-5c1e-b969-4b07e4cce454" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533817}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f3502cd8-8f26-545b-a53a-aaefaf7bd37e" :question/math-academy-id "q-161148" :question/problem "Find the surface area of the portion of the plane $z=3y-\\sqrt{6}x$ whose projection onto the $xy$-plane is bounded by $y={x}^{3},$ $y=1,$ and the $y$-axis." :question/worked-solution "For a surface $S$ defined by $z=f(x,y)$ with $(x,y)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nIn this case, our surface is given by\n\n$$\nz=3y-\\sqrt{6}x,\\,(x,y)\\in D\n$$\n\nwhere the region $D$ is given by\n\n$$\nD=\\{(x,y)\\,:\\,0\\le x\\le 1,\\,{x}^{3}\\le y\\le 1\\},\n$$\n\nas shown in the diagram below.\n\n![](images/9f/9f6192b3c3c61fc0abfd6c4ec46d127431265c870bc38d7deac79353b6923fdd.png)\n\nNow, since\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x} & =\\frac{∂}{∂x}(3y-\\sqrt{6}x)=-\\sqrt{6}, \\\\ \\frac{∂z}{∂y} & =\\frac{∂}{∂y}(3y-\\sqrt{6}x)=3,\\end{aligned}\n$$\n\nthe surface area is given by\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{1+{(-\\sqrt{6})}^{2}+(3)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{16}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{{x}^{3}}^{1}4\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4\\cdot y\\,{|}_{{x}^{3}}^{1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}4-4{x}^{3}\\,\\text{d}x \\\\  & =(4x-{x}^{4}){|}_{0}^{1} \\\\  & =(4-1)-0 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534090 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}-6{x}^{3}+15" :db/id #edb/ref 17592186533296} {:answer/id #uuid "84e65e07-d407-5744-b09c-1d7419c5f733" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{x}^{2}-3{x}^{3}+15" :db/id #edb/ref 17592186533452} {:answer/id #uuid "949b2307-7470-54c1-a231-4a7923ae08c1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "15{x}^{2}+3{x}^{3}+15" :db/id #edb/ref 17592186533499} {:answer/id #uuid "9f5538e4-cb5c-53d2-8282-324285197339" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}+3{x}^{3}+15" :db/id #edb/ref 17592186533525} {:answer/id #uuid "cffa59f6-f8b3-5069-84a6-83cd2e84beae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5{x}^{2}-6{x}^{3}+15" :db/id #edb/ref 17592186533646}] :answer-field/correct {:answer/id #uuid "42e00fa1-2d53-53c2-91c2-dbaf97414222" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17{x}^{2}-6{x}^{3}+15" :db/id #edb/ref 17592186533296} :answer-field/id #uuid "f81d8766-b273-5742-81e1-135f6f4971d0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186533963}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "f3859b1c-a23b-517a-bfe5-a836f749be10" :question/math-academy-id "q-138834" :question/problem "Consider the function $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.$ The derivative of this function is given by\n\n$$\n{y}^{′}=\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}g(x)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1).\n$$\n\nFind the function $g(x).$" :question/worked-solution "We have the function \n\n$$\ny=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}.\n$$\n\nFirst, we find the natural logarithm of both sides and use the quotient and power rules for logarithms:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡y & =\\operatorname{ln}⁡(\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}) \\\\ \\operatorname{ln}⁡y & =\\operatorname{ln}⁡(({x}^{2}+1)^{x})-\\operatorname{ln}⁡((1-3x)^{5}) \\\\ \\operatorname{ln}⁡y & =x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)\\end{aligned}\n$$\n\nNext, we differentiate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{ln}⁡y) & =\\frac{\\text{d}}{\\text{d}x}(x\\operatorname{ln}⁡({x}^{2}+1)-5\\operatorname{ln}⁡(1-3x)) \\\\ \\frac{1}{y}\\cdot {y}^{′} & =\\operatorname{ln}⁡({x}^{2}+1)+x\\cdot \\frac{1}{{x}^{2}+1}\\cdot (2x)-5\\cdot \\frac{1}{1-3x}\\cdot (-3) \\\\ \\frac{{y}^{′}}{y} & =\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}\\end{aligned}\n$$\n\nNow, we solve for ${y}^{′}:$ \n\n$$\n\\begin{aligned}{y}^{′} & =y(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})\\end{aligned}\n$$\n\nFinally, we substitute $y=\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}:$\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\operatorname{ln}⁡({x}^{2}+1)+\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x}) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}}{{x}^{2}+1}+\\frac{15}{1-3x})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{2{x}^{2}(1-3x)+15({x}^{2}+1)}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}(\\frac{17{x}^{2}-6{x}^{3}+15}{({x}^{2}+1)(1-3x)})+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1) \\\\  & =\\frac{({x}^{2}+1)^{x-1}}{(1-3x)^{6}}(17{x}^{2}-6{x}^{3}+15)+\\frac{({x}^{2}+1)^{x}}{(1-3x)^{5}}\\operatorname{ln}⁡({x}^{2}+1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\ng(x)=17{x}^{2}-6{x}^{3}+15.\n$$"} {:db/id #edb/ref 17592186534098 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21e9484e-2a02-53c8-af78-26814c64e2b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\ln 2+\\frac{3}{2}" :db/id #edb/ref 17592186533219}] :answer-field/correct {:answer/id #uuid "21e9484e-2a02-53c8-af78-26814c64e2b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\ln 2+\\frac{3}{2}" :db/id #edb/ref 17592186533219} :answer-field/id #uuid "dfd3ac59-843e-571d-b47f-bc7b711b8324" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186533938}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "fd717c83-b2bc-5cde-b553-20c9ad00a74f" :question/math-academy-id "q-348616" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{3}^{4}\\frac{2x-1}{{x}^{2}-4x+4}\\,\\text{d}x=$\n\n{{field-1}}" :question/worked-solution "Let's first factor the denominator of the integrand:\n\n$$\n\\frac{2x-1}{{x}^{2}-4x+4}=\\frac{2x-1}{(x-2)^{2}}\n$$\n\nWe must convert the integrand into a sum of partial fractions:\n\n$$\n\\frac{2x-1}{(x-2)^{2}}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}}\n$$\n\nTo determine the coefficients $A$ and $B,$ we first multiply both sides of the above equation by $(x-2)^{2}$ and get\n\n$$\n2x-1=A(x-2)+B.\n$$\n\nPlugging in $x=2,$ we can eliminate $A$ and solve for $B:$\n\n$$\n\\begin{aligned}2(2)-1 & =A(2-2)+B \\\\ B & =3\\end{aligned}\n$$\n\nNow, plugging in $x=0$ and substituting the known value of $B,$ we can solve for $A:$\n\n$$\n\\begin{aligned}2(0)-1 & =A(0-2)+3 \\\\ -1 & =-2A+3 \\\\ A & =2\\end{aligned}\n$$\n\nTherefore, we can write the integrand as the partial sum:\n\n$$\n\\frac{2x-1}{(x-2)^{2}}=\\frac{2}{x-2}+\\frac{3}{(x-2)^{2}}\n$$\n\nFinally, we integrate this expression term by term to get\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}\\frac{2x-1}{(x-2)^{2}}\\,\\text{d}x & ={\\int }_{3}^{4}(\\frac{2}{x-2}+\\frac{3}{(x-2)^{2}})\\text{d}x \\\\  & =2{\\int }_{3}^{4}\\frac{1}{x-2}\\,\\text{d}x+3{\\int }_{3}^{4}\\frac{1}{(x-2)^{2}}\\,\\text{d}x \\\\  & =2\\operatorname{ln}⁡|x-2|\\,{|}_{3}^{4}-3\\cdot \\frac{1}{x-2}\\,{|}_{3}^{4} \\\\  & =2(\\operatorname{ln}⁡2-\\operatorname{ln}⁡1)-3(\\frac{1}{2}-1) \\\\  & =2\\operatorname{ln}⁡(\\frac{2}{1})-3(-\\frac{1}{2}) \\\\  & =2\\operatorname{ln}⁡2+\\frac{3}{2}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534971 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc2fd04-1bfc-5280-a69c-4ed2cd156d0a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{7}}{7}" :db/id #edb/ref 17592186534292} {:answer/id #uuid "68b38f75-3590-5f6c-b34f-83c73c9fd836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{7}}{7}" :db/id #edb/ref 17592186534479} {:answer/id #uuid "6be28734-ccd4-54e1-836e-45a57ad99216" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{3}}{7}" :db/id #edb/ref 17592186534488} {:answer/id #uuid "6c50d7fa-7bb2-54b7-b910-ec04e9ed7eb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{7}}{3}" :db/id #edb/ref 17592186534491} {:answer/id #uuid "b5b1adc9-c4cd-505a-b89f-57bdded59b80" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{7}}{4}" :db/id #edb/ref 17592186534674}] :answer-field/correct {:answer/id #uuid "68b38f75-3590-5f6c-b34f-83c73c9fd836" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{7}}{7}" :db/id #edb/ref 17592186534479} :answer-field/id #uuid "1872fb4f-820b-5e4c-a4ea-11325b8f3aa5" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534845}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01f21d28-bd9a-5f49-bee9-224def342dbf" :question/math-academy-id "q-84641" :question/problem "![](images/11/11b00ddb6eb89e6acf79a8d5dc32e07a90850b97d8802df293e1240f6cfe444a.png)\n\nThe point $P(\\frac{3}{4},\\frac{\\sqrt{7}}{4})$ lies on the unit circle, as shown. What is $\\operatorname{csc}⁡\\theta ?$" :question/worked-solution "![](images/cd/cd63145c6f0513fe78da148b07064eb725c2de88ded4993dabccc0da173d6583.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $y=\\frac{\\sqrt{7}}{4}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{\\sqrt{7}}{4}.\n$$\n\nKnowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we can calculate $\\operatorname{csc}⁡\\theta :$\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(\\frac{\\sqrt{7}}{4})}=\\frac{4}{\\sqrt{7}}=\\frac{4\\sqrt{7}}{7}.\n$$"} {:db/id #edb/ref 17592186534979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09a5894b-ca93-559e-9241-c70e09cfcc05" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534279} {:answer/id #uuid "0b0efef7-ea22-56c7-ac43-7422add3b46d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The series is divergent." :db/id #edb/ref 17592186534287} {:answer/id #uuid "4f4a5642-c9e9-5168-8482-b21e873612c5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{9}.$ The series is convergent." :db/id #edb/ref 17592186534420} {:answer/id #uuid "7c46e210-d2d6-55e4-892f-4ca85507253f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534533} {:answer/id #uuid "a5779aa3-3102-5b67-aa38-f2aff312d456" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=5.$ The series is divergent." :db/id #edb/ref 17592186534636}] :answer-field/correct {:answer/id #uuid "7c46e210-d2d6-55e4-892f-4ca85507253f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534533} :answer-field/id #uuid "f5cf7d5d-3952-5581-beaf-679fd852cabd" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534965}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "0f1fd02c-d7d8-5411-85bd-473d05c64e92" :question/math-academy-id "q-14951" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{5}^{n}{n}^{n+1}}{(9+5n)^{n}}.$ According to the root test, does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{5}^{n}{n}^{n+1}}{(9+5n)^{n}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{5}^{n}{n}^{n+1}}{(9+5n)^{n}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{5}^{n}{n}^{n}\\cdot n}{(9+5n)^{n}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }\\frac{5n\\sqrt[n]{n}}{9+5n} \\\\  & ={lim}_{n\\to \\infty }\\frac{(\\sqrt[n]{n}\\cdot \\frac{5n}{n})}{(\\frac{9}{n}+\\frac{5n}{n})} \\\\  & ={lim}_{n\\to \\infty }\\frac{5\\sqrt[n]{n}}{(\\frac{9}{n}+5)} \\\\  & =\\frac{5\\cdot 1}{0+5} \\\\  & =\\frac{5}{5} \\\\  & =1\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{n}=1.\n$$\n\nSince $L=1,$ the root test gives no conclusion."} {:db/id #edb/ref 17592186534980 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a65c10e-2ee7-5335-8ef2-65ee05b05946" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{81.46}^{∘}" :db/id #edb/ref 17592186534527} {:answer/id #uuid "7b011649-9a23-53a3-90b7-1f25d2c60a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{80.41}^{∘}" :db/id #edb/ref 17592186534529} {:answer/id #uuid "83e6ddaf-77b4-5a0e-949f-91b022125de9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{78.45}^{∘}" :db/id #edb/ref 17592186534551} {:answer/id #uuid "8f8402ff-e7d0-5cd5-a863-849e76e4cb95" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{79.24}^{∘}" :db/id #edb/ref 17592186534583} {:answer/id #uuid "b159daeb-e124-57f2-997e-d4b7b1075560" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{83.15}^{∘}" :db/id #edb/ref 17592186534661}] :answer-field/correct {:answer/id #uuid "7b011649-9a23-53a3-90b7-1f25d2c60a71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "{80.41}^{∘}" :db/id #edb/ref 17592186534529} :answer-field/id #uuid "8015e10c-af0f-5b56-a09c-f0c2ba72879d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534900}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "132171d1-1085-585d-b8f2-7700ff87a0d2" :question/math-academy-id "q-64521" :question/problem "![](images/2b/2b7a0fe3a80bfa6a0e0d82ab46a94740ce4b73007ae9d17ceb83170bce4559ff.png)\n\nThe diagram above shows the unit circle. The $x$-coordinate of the point $P$ is $\\frac{1}{6}.$ Rounded to two decimal places, what is the measure of the angle $\\theta ?$" :question/worked-solution "![](images/ea/eaf0e0a6434b454b58a8f53de0445bff8bae14d8bd1ec9e8e9598f0bd80323d9.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{1}{6}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{1}{6}.\n$$\n\nWe compute the angle $\\theta $ using the inverse cosine:\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{6})=(80.405\\,93…)^{∘}≈{80.41}^{∘}\n$$"} {:db/id #edb/ref 17592186534982 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "667b63c5-fe72-5337-ad38-8eb1ffe5a17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{12}" :db/id #edb/ref 17592186534473}] :answer-field/correct {:answer/id #uuid "667b63c5-fe72-5337-ad38-8eb1ffe5a17b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{6}}{12}" :db/id #edb/ref 17592186534473} :answer-field/id #uuid "98724bad-e3c1-526b-a661-1f3e637be2df" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1ba23b8d-4b13-599f-bc74-567006cafd11" :question/math-academy-id "q-267390" :question/problem "![](images/8f/8feb78ada73af4c97e7ce60555cf22acf5e24da38e30424c4c5c430e6456c06d.png)\n\nThe point $P(\\frac{1}{5},\\frac{2\\sqrt{6}}{5})$ lies on the unit circle, as shown. What is $\\operatorname{csc}⁡\\theta ?$ Do not round your answer.\n\n$\\operatorname{csc}⁡\\theta =$\n{{field-1}}" :question/worked-solution "![](images/41/41c6badfbcafe7bafdddca30606511d2d6c3c8bdbbcd5ec2e29ff9c4c2dd310f.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $y=\\frac{2\\sqrt{6}}{5}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{sin}⁡\\theta =\\frac{2\\sqrt{6}}{5}.\n$$\n\nKnowing that $\\operatorname{csc}⁡\\theta =\\frac{1}{\\operatorname{sin}⁡\\theta },$ we can calculate $\\operatorname{csc}⁡\\theta :$\n\n$$\n\\operatorname{csc}⁡\\theta =\\frac{1}{(\\frac{2\\sqrt{6}}{5})}=\\frac{5}{2\\sqrt{6}}=\\frac{5\\sqrt{6}}{12}\n$$"} {:db/id #edb/ref 17592186534983 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4933e24f-9535-56e6-8bd8-463ca459b1f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186534404} {:answer/id #uuid "54ae8c91-054f-56c1-8736-87af40558e09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\pi }{3}" :db/id #edb/ref 17592186534433} {:answer/id #uuid "5efef0b8-d72d-5a49-aec0-94be999fd7a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\pi " :db/id #edb/ref 17592186534457} {:answer/id #uuid "9c9b1563-417d-535e-abf6-54a7aa2af98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80\\pi }{3}" :db/id #edb/ref 17592186534614} {:answer/id #uuid "c7c386ae-4bfc-514a-a465-86fbebbe089e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186534716}] :answer-field/correct {:answer/id #uuid "9c9b1563-417d-535e-abf6-54a7aa2af98c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{80\\pi }{3}" :db/id #edb/ref 17592186534614} :answer-field/id #uuid "a911c19c-a198-57f8-8ad5-1e251d33cc93" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534923}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "1bae08c0-8385-58de-b3f9-2f81e17da99b" :question/math-academy-id "q-161328" :question/problem "![](images/78/7836860694ae6246dee36a70b86bc7fcd8cf7358d47a10586ea6880759fb1588.png)\n\nEvaluate the surface integral \n\n$$\n{∬}_{S}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}S,\n$$\n\nwhere $S$ is defined by $z=4x+\\sqrt{8}y$ and whose domain is the circle of radius $2$ centered at $O,$ as shown above." :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(4x+\\sqrt{8}y)=4,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(4x+\\sqrt{8}y)=\\sqrt{8}.\n$$\n\nTherefore, the surface integral can be expressed as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\cdot \\sqrt{1+{4}^{2}+(\\sqrt{8})^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\cdot 5\\,\\text{d}A \\\\  & =5{∬}_{D}\\,\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nNotice that in polar coordinates $(r,\\theta ),$ our domain can be expressed as \n\n$$\nΔ=\\{(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le 2\\pi \\}.\n$$\n\nTherefore, using the change of variables formula for polar coordinates, where $x=r\\operatorname{cos}⁡\\theta $ and $y=r\\operatorname{sin}⁡\\theta ,$ we obtain \n\n$$\n\\begin{aligned}5{∬}_{D}\\,\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & =5{∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta  \\\\  & =5{∬}_{Δ}\\sqrt{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }\\cdot r\\text{d}r\\text{d}\\theta  \\\\  & =5{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =5{\\int }_{0}^{2\\pi }{[\\frac{{r}^{3}}{3}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & =5{\\int }_{0}^{2\\pi }\\frac{8}{3}\\,\\text{d}\\theta  \\\\  & =\\frac{40}{3}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{40}{3}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{80\\pi }{3}.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534986 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "887bb682-847d-5497-b082-069e31b4ca18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1/2}^{2}(\\frac{1}{{x}^{2}}-\\frac{1}{x}+\\frac{1}{4})\\,\\text{d}x" :db/id #edb/ref 17592186534562} {:answer/id #uuid "8f35e7c9-23db-5d10-9546-2d16da17d83e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1}^{2}(-\\frac{1}{x}+\\frac{1}{4})\\,\\text{d}x" :db/id #edb/ref 17592186534579} {:answer/id #uuid "9e084eaf-fd07-5c31-9a44-9d16ecb72243" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1/2}^{2}(\\frac{1}{{x}^{2}}+\\frac{1}{x}-\\frac{1}{4})\\,\\text{d}x" :db/id #edb/ref 17592186534618} {:answer/id #uuid "aa69c2e1-351a-5624-8415-3234bb23b87e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1/2}^{2}(\\frac{1}{{x}^{2}}+\\frac{1}{4})\\,\\text{d}x" :db/id #edb/ref 17592186534649} {:answer/id #uuid "eeaa6543-a7cf-5a69-8ac8-dcbdbdc1fd1a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1}^{2}(\\frac{1}{{x}^{2}}-\\frac{1}{4})\\,\\text{d}x" :db/id #edb/ref 17592186534795}] :answer-field/correct {:answer/id #uuid "887bb682-847d-5497-b082-069e31b4ca18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1/2}^{2}(\\frac{1}{{x}^{2}}-\\frac{1}{x}+\\frac{1}{4})\\,\\text{d}x" :db/id #edb/ref 17592186534562} :answer-field/id #uuid "01397a07-f9d3-51fc-adc8-145fbda696db" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534828}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "236b0649-a813-5e30-b589-a9199c88af15" :question/math-academy-id "q-50022" :question/problem "![](images/10/1066e10a5a9860e371ca2895ec39f7cdce4e000d5cca9f3b478f57cd890d647a.png)\n\nThe region enclosed by the curve $y=\\frac{1}{x},$ for $x\\in [\\frac{1}{2},2],$ and the horizontal line $y=\\frac{1}{2}$ is rotated $2\\pi $ radians about the line $y=\\frac{1}{2},$ as shown above. Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, notice that we are given that the limits of integration are from $x=\\frac{1}{2}$ to $x=2$ along the $x$-axis. \n\nTo determine which is the lower function and which is the upper, let's draw our vertical arrow.\n\n![](images/6d/6d4c086c9a3a99609728bc7c53f5a28ac86431e5c37e2b87bcfd3031a32aa470.png)\n\nThe vertical arrow \n\n- *enters* the region through the lower function $y=\\frac{1}{2},$ and\n\n- *leaves* through the upper function $y=\\frac{1}{x}.$\n\nTherefore, the integral that gives our volume is\n\n$$\n\\begin{aligned}V & =\\pi {\\int }_{1/2}^{2}[\\,(\\text{upper function})-(\\text{lower function})\\,]^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\,(\\frac{1}{x})-(\\frac{1}{2})\\,]}^{2}\\,\\text{d}x \\\\  & =\\pi {\\int }_{1/2}^{2}{(\\frac{1}{x}-\\frac{1}{2})}^{2}\\text{d}x \\\\  & =\\pi {\\int }_{1/2}^{2}(\\frac{1}{{x}^{2}}-\\frac{1}{x}+\\frac{1}{4})\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186534990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50518fe9-0b2d-5dcc-89cd-eefab837bf7d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186534422} {:answer/id #uuid "5091e3af-a0e1-5296-ba59-d8a3f4c4675f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186534424} {:answer/id #uuid "b9c28105-c9bd-57cf-88ff-3460736a6d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186534680} {:answer/id #uuid "f980b97a-e2c0-55f1-af77-7659b8749bf0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186534817} {:answer/id #uuid "ff578584-d99e-5654-8c41-d355a3df44de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186534825}] :answer-field/correct {:answer/id #uuid "b9c28105-c9bd-57cf-88ff-3460736a6d61" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186534680} :answer-field/id #uuid "cd0b2e2a-2447-58b4-9753-a6af8b018534" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534944}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "288e585e-09b6-54a4-9e8e-a55aaefc8005" :question/math-academy-id "q-64981" :question/problem "![](images/cb/cbff0c974c790ec4287be1dcff8aa62d0da0aa5e77fa5ec577633f5f2cad6a5d.png)\n\nThe point $P(\\frac{\\sqrt{3}}{2},\\frac{1}{2})$ lies on the unit circle, as shown. What is $\\operatorname{cot}⁡\\theta ?$" :question/worked-solution "![](images/1f/1ffb0a83abf7e736c47035f4f337c36a6bb129fd0d64fe0ac3bfe8e46c194a11.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{\\sqrt{3}}{2}$ and $y=\\frac{1}{2}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{3}}{2},\\,\\operatorname{sin}⁡\\theta =\\frac{1}{2}.\n$$\n\nKnowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ we can calculate $\\operatorname{cot}⁡\\theta :$\n\n$$\n\\operatorname{cot}⁡\\theta =\\frac{(\\frac{\\sqrt{3}}{2})}{(\\frac{1}{2})}=\\sqrt{3}.\n$$"} {:db/id #edb/ref 17592186534994 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47795a6f-f09c-5ce0-8648-0dda3b3866d2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{11}{7}.$ The series is divergent." :db/id #edb/ref 17592186534400} {:answer/id #uuid "59da41e9-24a6-5453-ad33-2fd47886a1f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{49}.$ The series is convergent." :db/id #edb/ref 17592186534446} {:answer/id #uuid "a9c65a76-4ede-5228-964c-67fc95c51b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534643} {:answer/id #uuid "d58740e8-ed0f-5cea-b77a-0df6635012b7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534745} {:answer/id #uuid "db748b8f-576e-5783-80b0-1618e62a128d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{7}.$ The series is convergent." :db/id #edb/ref 17592186534759}] :answer-field/correct {:answer/id #uuid "a9c65a76-4ede-5228-964c-67fc95c51b32" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534643} :answer-field/id #uuid "d64a5913-6f1a-5c6e-88a9-5daa0337d7b6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534951}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "30cdb164-81fa-5575-aede-39cb02771ca3" :question/math-academy-id "q-6027" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{11}^{n}}{{7}^{n}\\cdot n!}.$ Does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{11}^{n}}{{7}^{n}\\cdot n!}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{11}^{n}}{{7}^{n}\\cdot n!})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }(\\frac{11}{7\\cdot \\sqrt[n]{n!}}) \\\\  & =\\frac{11}{7}{lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{n!}} \\\\  & =\\frac{11}{7}\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{n!}}=0.\n$$\n\nSince $L=0<1,$ the series converges by the root test."} {:db/id #edb/ref 17592186534998 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3fe33770-f073-58ae-98ff-6550e980a4f5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{3}.$ The series is convergent." :db/id #edb/ref 17592186534386} {:answer/id #uuid "4c4501bf-5593-532c-b1be-a42d350ce985" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{9}.$ The series is convergent." :db/id #edb/ref 17592186534413} {:answer/id #uuid "b18e1a27-a6d5-5ac9-936a-fb892b199757" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534662} {:answer/id #uuid "ce352136-40a5-50fe-a545-036a2a82efb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=3.$ The series is divergent." :db/id #edb/ref 17592186534727} {:answer/id #uuid "e0b64790-21c2-5f37-b2cc-33801393cf8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534765}] :answer-field/correct {:answer/id #uuid "e0b64790-21c2-5f37-b2cc-33801393cf8c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=0.$ The series is convergent." :db/id #edb/ref 17592186534765} :answer-field/id #uuid "d3052d66-0697-5930-85f9-c584087760e2" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534948}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "3a25fcb4-6a85-5416-8ab8-d6107a3d8b17" :question/math-academy-id "q-6022" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{n}^{n/2}}{3{n}^{{n}^{2}}}.$ Does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{n}^{n/2}}{3{n}^{{n}^{2}}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{n}^{n/2}}{3{n}^{{n}^{2}}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }\\frac{\\sqrt{n}}{\\sqrt[n]{3}\\cdot {n}^{n}} \\\\  & ={lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{3}}\\cdot \\frac{1}{{n}^{n-1/2}} \\\\  & =1\\cdot 0 \\\\  & =0\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{\\frac{1}{3}}=1.\n$$\n\nSince $L=0<1,$ the series converges by the root test."} {:db/id #edb/ref 17592186535032 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "28ffe4fa-4124-53f3-9455-23c7dc4b1e77" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186534350} {:answer/id #uuid "5ef16aa2-7f00-5a11-a5ae-b254c9e3ddaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186534456} {:answer/id #uuid "60dc99e9-55cf-552a-875b-3cbcf9519dc0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186534462} {:answer/id #uuid "825e3c73-ea77-5644-9cd3-b6091c4271ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186534548} {:answer/id #uuid "e7192383-05fe-5f9e-add2-9b0b63f45acd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186534776}] :answer-field/correct {:answer/id #uuid "825e3c73-ea77-5644-9cd3-b6091c4271ea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186534548} :answer-field/id #uuid "4fb4d622-2cfe-5123-b12c-76f30da29551" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534879}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7df7ee25-2f51-5474-8055-7ad2776c92c8" :question/math-academy-id "q-20953" :question/problem "Find the global minimum value of the function $f(x)=2{x}^{3}+3{x}^{2}+1$ on the interval $[-2,\\frac{1}{2}].$" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=2{x}^{3}+3{x}^{2}+1,$ we get\n\n$$\n6{x}^{2}+6x,\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n\\begin{aligned}6{x}^{2}+6x & =0 \\\\ 6x(x+1) & =0 \\\\ x & =-1,0.\\end{aligned}\n$$\n\nSo, the critical points are $x=-1,0,$ and the endpoints $x=-2,\\frac{1}{2}$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(-2) & =2(-2)^{3}+3(-2)^{2}+1=-3 \\\\ f(-1) & =2(-1)^{3}+3(-1)^{2}+1=2 \\\\ f(0) & =2(0)^{3}+3(0)^{2}+1=1 \\\\ f(\\frac{1}{2}) & =2{(\\frac{1}{2})}^{3}+3{(\\frac{1}{2})}^{2}+1=2\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(-1)=f(\\frac{1}{2})=2,$ so the global maximum is $2.$\n\n- The smallest value is $f(-2)=-3,$ so the global minimum is $-3.$\n\n![](images/b7/b7741f6f67f6070d6050ebaf792598593f98a406bdab91f73356e2c27085b7a0.png)"} {:db/id #edb/ref 17592186535039 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a676b7a-83f4-580e-bc68-198c1d310014" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{10{z}^{5}}+C" :db/id #edb/ref 17592186534376} {:answer/id #uuid "524c97c6-03f8-598a-8c7c-ea2d3d324912" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{12{z}^{3}}+C" :db/id #edb/ref 17592186534428} {:answer/id #uuid "763e5a13-a335-5cdf-a259-7426bf657fec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{{z}^{3}}+C" :db/id #edb/ref 17592186534519} {:answer/id #uuid "c1384251-11ce-53fe-90e4-87749a27be70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5{z}^{5}}+C" :db/id #edb/ref 17592186534696} {:answer/id #uuid "ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3{z}^{3}}+C" :db/id #edb/ref 17592186534760}] :answer-field/correct {:answer/id #uuid "ddebe549-4054-5e6e-aaa8-0ecca6bb1cbc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3{z}^{3}}+C" :db/id #edb/ref 17592186534760} :answer-field/id #uuid "986e5def-75c9-5fb2-b0cd-ce6e4f5db7e6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534914}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "8a064553-8bcb-586c-b022-5e4a307bf7cb" :question/math-academy-id "q-113732" :question/problem "Calculate $\\int \\frac{4}{{z}^{4}}\\,\\text{d}z.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{4}{{z}^{4}}\\,\\text{d}z & =4\\int {z}^{-4}\\,\\text{d}z \\\\  & =4\\cdot (\\frac{{z}^{-4+1}}{-4+1})+C \\\\  & =4\\cdot (\\frac{{z}^{-3}}{-3})+C \\\\  & =-\\frac{4}{3}\\cdot {z}^{-3}+C \\\\  & =-\\frac{4}{3{z}^{3}}+C\\end{aligned}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535044 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4c630aef-e5a0-5435-bc55-02515d7f328e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186534414}] :answer-field/correct {:answer/id #uuid "4c630aef-e5a0-5435-bc55-02515d7f328e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186534414} :answer-field/id #uuid "35fe18d9-346e-5613-a2e9-e0356df52875" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534863} {:answer-field/choices [{:answer/id #uuid "96145c9c-17f6-5fc5-8bc3-7eda2b993795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{\\pi/2}-2" :db/id #edb/ref 17592186534595}] :answer-field/correct {:answer/id #uuid "96145c9c-17f6-5fc5-8bc3-7eda2b993795" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2e^{\\pi/2}-2" :db/id #edb/ref 17592186534595} :answer-field/id #uuid "f16ea21d-f232-5a8c-ae03-fff1dd1ddc4f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186534961}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "990e6c9c-e46f-5a33-8086-74712d90c327" :question/math-academy-id "q-351160" :question/problem "The velocity $v$ at time $t$ of a particle $P$ moving in the $xy$-plane is given by\n\n$$\nv(t)=⟨\\operatorname{cos}⁡t,\\,2{e}^{t}⟩.\n$$\n\nGiven that the particle is at the position $r=⟨0,0⟩$ when $t=0,$ calculate the position of $P$ at time $t=\\frac{\\pi }{2}.$ Do not round the answers.\n\n$r\\,(\\frac{\\pi }{2})=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the position vector, we need to integrate the velocity vector:\n\n$$\n\\begin{aligned}r(t) & =\\int v(t)\\,\\text{d}t \\\\  & =\\int ⟨\\operatorname{cos}⁡t,\\,2{e}^{t}⟩\\,\\text{d}t \\\\  & =⟨\\int \\operatorname{cos}⁡t\\,\\text{d}t,\\,\\int 2{e}^{t}\\,\\text{d}t⟩ \\\\  & =⟨\\operatorname{sin}⁡t+{C}_{1},\\,2{e}^{t}+{C}_{2}⟩\\end{aligned}\n$$\n\nNow, we can solve for the constants of integration using the fact that $r(0)=⟨0,0⟩.$ Substituting $t=0,$ we get\n\n$$\n\\begin{aligned}r(0) & =⟨\\operatorname{sin}⁡0+{C}_{1},\\,2{e}^{0}+{C}_{2}⟩ \\\\ ⟨0,0⟩ & =⟨{C}_{1},\\,2+{C}_{2}⟩,\\end{aligned}\n$$\n\nso we must have ${C}_{1}=0$ and ${C}_{2}=-2.$ Therefore, the position vector at time $t$ is given by\n\n$$\nr(t)=⟨\\operatorname{sin}⁡t,\\,2{e}^{t}-2⟩.\n$$\n\nTo find the position vector at time $t=\\frac{\\pi }{2},$ we substitute $t=\\frac{\\pi }{2}$ into the above, and we get\n\n$$\n\\begin{aligned}r\\,(\\frac{\\pi }{2}) & =⟨sin\\,(\\frac{\\pi }{2}),\\,2{e}^{\\pi /2}-2⟩ \\\\  & =⟨1,\\,2{e}^{\\pi /2}-2⟩ \\\\  & =⟨1,\\,2{e}^{\\pi /2}-2⟩.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535047 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8726e024-292d-59b4-8013-fd7bf0f67e0d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}((1+e)^{3/2}-{3}^{3/2})" :db/id #edb/ref 17592186534558} {:answer/id #uuid "c5558c16-5207-5627-b751-3fcb910575e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}((2+e)^{3/2}-{2}^{3/2})" :db/id #edb/ref 17592186534707} {:answer/id #uuid "c66cb474-bc45-59be-8448-dccc9423f5ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}((2+{e}^{2})^{3/2}-{2}^{3/2})" :db/id #edb/ref 17592186534710} {:answer/id #uuid "ce0a3efb-4ed4-5af7-8085-fc0e737a543c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}((1+{e}^{2})^{3/2}-{2}^{3/2})" :db/id #edb/ref 17592186534726} {:answer/id #uuid "d59e1bf3-fe94-540a-b645-1d3ca9e31091" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}((1+e)^{3/2}-{2}^{3/2})" :db/id #edb/ref 17592186534746}] :answer-field/correct {:answer/id #uuid "ce0a3efb-4ed4-5af7-8085-fc0e737a543c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}((1+{e}^{2})^{3/2}-{2}^{3/2})" :db/id #edb/ref 17592186534726} :answer-field/id #uuid "de37fba6-41ca-540b-a8fd-47ec845611d6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534955}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9f471502-6ac3-5895-874a-d7c88c5897e2" :question/math-academy-id "q-161354" :question/problem "Evaluate the surface integral \n\n$$\n{∬}_{S}{z}^{2}\\,\\text{d}S\n$$\n\nwhere $S$ is defined by $z={e}^{x}$ for $0\\le x\\le 1$ and $x\\le y\\le x+1.$" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}({e}^{x})={e}^{x},\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}({e}^{x})=0.\n$$\n\nTherefore, the surface integral can be evaluated as follows:\n\n$$\n\\begin{aligned}{∬}_{S}{z}^{2}\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,{z}^{2}\\sqrt{1+{e}^{2x}+{0}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,{e}^{2x}\\sqrt{1+{e}^{2x}}\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{x}^{x+1}{e}^{2x}\\sqrt{1+{e}^{2x}}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[{e}^{2x}\\sqrt{1+{e}^{2x}}y]}_{y=x}^{y=x+1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{e}^{2x}\\sqrt{1+{e}^{2x}}\\,\\text{d}x \\\\  & ={[\\frac{1}{3}(1+{e}^{2x})^{3/2}]}_{0}^{1} \\\\  & =\\frac{1}{3}((1+{e}^{2})^{3/2}-{2}^{3/2})\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535053 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bd6a7c3-ca56-5d00-ad2a-bfa5230fbbcb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186534289} {:answer/id #uuid "5dc5c2dd-7531-574c-aa4e-5aa3dc593b78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186534453} {:answer/id #uuid "a9e86a30-6dd7-5faa-ac75-5295942c7076" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186534645} {:answer/id #uuid "bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186534684} {:answer/id #uuid "c476cec3-a40b-571d-9dfd-321c34be4974" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186534705}] :answer-field/correct {:answer/id #uuid "bb9b8243-3292-5c0c-9ec7-4d1fa55e8d23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186534684} :answer-field/id #uuid "4da91bd3-52bf-5e6a-a679-993bbe509e49" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534875}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "aa173a50-134e-5fe9-8151-0ed518869f1b" :question/math-academy-id "q-2750" :question/problem "Find the global minimum value of the function $f(x)=-\\operatorname{cos}⁡x$ on the closed interval $\\frac{\\pi }{2}\\le x\\le \\frac{3\\pi }{2}.$" :question/worked-solution "Let's apply the candidates test step by step.\n\n**Step 1**: We find the critical points. Taking the derivative of $f(x)=-\\operatorname{cos}⁡x,$ we get\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\operatorname{sin}⁡x,\\end{aligned}\n$$\n\nand solving ${f}^{′}(x)=0,$ we get \n\n$$\n\\operatorname{sin}⁡x=0\\,⟹\\,x=\\pi n,\n$$\n\nwhere $n$ is an integer. We discard all solutions except $x=\\pi ,$ since it is the only value that belongs to the given interval.\n\nSo, the critical points are $x=\\pi $ and the endpoints $x=\\frac{\\pi }{2},\\,\\frac{3\\pi }{2}$ (since the derivative is not defined at the endpoints).\n\n**Step 2**: We evaluate $f(x)$ at the critical points.\n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{\\pi }{2})=0 \\\\ f(\\pi ) & =-\\operatorname{cos}⁡(\\pi )=1 \\\\ f(\\frac{3\\pi }{2}) & =-\\operatorname{cos}⁡(\\frac{3\\pi }{2})=0\\end{aligned}\n$$\n\n**Step 3**: We compare all of the values found in step $2.$\n\n- The greatest value is $f(\\pi )=1,$ so the global maximum is $1.$\n\n- The least value is $f(\\frac{\\pi }{2})=f(\\frac{3\\pi }{2})=0,$ so the global minimum is $0.$\n\n![](images/7e/7e0008d35355afebc392a4bc508bd2cf2de5dc32a108f9f9c030d75a24ece076.png)"} {:db/id #edb/ref 17592186535055 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6199dc51-e96e-5636-83f2-2579cabce364" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{1}{8}.$ The series is convergent." :db/id #edb/ref 17592186534464} {:answer/id #uuid "6c253c48-5507-56d5-9451-af7ca3386fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{5}{4}.$ The series is divergent." :db/id #edb/ref 17592186534490} {:answer/id #uuid "73785847-2f06-56d2-b76c-2efa341aaff5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534512} {:answer/id #uuid "9c49c143-d35a-594e-8e97-d80bb0c9ac82" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534612} {:answer/id #uuid "c5e371ec-a315-5c84-89a5-b0df5f32e35f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=10.$ The series is divergent." :db/id #edb/ref 17592186534708}] :answer-field/correct {:answer/id #uuid "6c253c48-5507-56d5-9451-af7ca3386fc0" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{5}{4}.$ The series is divergent." :db/id #edb/ref 17592186534490} :answer-field/id #uuid "5ff32e85-d602-5a3e-9ef1-a2d2944e6ae0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534888}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af92a5d6-20ee-53fa-be9c-28e2a23392fd" :question/math-academy-id "q-139038" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{(10n)^{n}n}{(8n+1)^{n}}.$ According to the root test, does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{(10n)^{n}n}{(8n+1)^{n}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{(10n)^{n}n}{(8n+1)^{n}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }(\\frac{10n\\sqrt[n]{n}}{8n+1}) \\\\  & ={lim}_{n\\to \\infty }\\frac{10n\\sqrt[n]{n}}{n(8+\\frac{1}{n})} \\\\  & ={lim}_{n\\to \\infty }\\frac{10\\sqrt[n]{n}}{(8+\\frac{1}{n})} \\\\  & =\\frac{10\\cdot 1}{8+0} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{n}=1.\n$$\n\nSince $L=\\frac{5}{4}>1,$ the series diverges by the root test."} {:db/id #edb/ref 17592186535064 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f8a243e-b4f0-5412-8987-90fb7ae767aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186534385} {:answer/id #uuid "43c32df9-34ff-54be-aa25-f9bd5b25645e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6\\sqrt{2}" :db/id #edb/ref 17592186534392} {:answer/id #uuid "53aa5f4f-ff96-5d4f-b815-838e91c9c3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186534431} {:answer/id #uuid "7e14b85b-2e42-5d8b-88e9-156a24dbe1a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{4}" :db/id #edb/ref 17592186534537} {:answer/id #uuid "a31109d2-e5c2-5154-823a-edd90f36b36c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186534634}] :answer-field/correct {:answer/id #uuid "53aa5f4f-ff96-5d4f-b815-838e91c9c3a5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186534431} :answer-field/id #uuid "c7654d5f-ce50-5f5a-bb2d-57f8b6d0f4f3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534941}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "be261196-18fe-5211-8ddf-c96cd6bddf72" :question/math-academy-id "q-124387" :question/problem "![](images/c5/c5b92e2126df555db5f639bc9063586b6afc3bb2896b14edadedf183ec152ac5.png)\n\nThe point $P(\\frac{2\\sqrt{2}}{3},\\frac{1}{3})$ lies on the unit circle, as shown. What is $\\operatorname{cot}⁡\\theta ?$" :question/worked-solution "![](images/df/df5d54940a136a53c1e1c00f8cc9d71d7b064f6e0895a029da2738cf21998a56.png)\n\nAny point $(x,y)$ on the unit circle is related to the central angle $\\theta $ as follows:\n\n$$\nx=\\operatorname{cos}⁡\\theta ,\\,y=\\operatorname{sin}⁡\\theta \n$$\n\nWe're given that $x=\\frac{2\\sqrt{2}}{3}$ and $y=\\frac{1}{3}$ at the point $P.$ Therefore, we have\n\n$$\n\\operatorname{cos}⁡\\theta =\\frac{2\\sqrt{2}}{3},\\,\\operatorname{sin}⁡\\theta =\\frac{1}{3}.\n$$\n\nKnowing that $\\operatorname{cot}⁡\\theta =\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta },$ we can calculate $\\operatorname{cot}⁡\\theta :$\n\n$$\n\\operatorname{cot}⁡\\theta =\\frac{(\\frac{2\\sqrt{2}}{3})}{(\\frac{1}{3})}=2\\sqrt{2}.\n$$"} {:db/id #edb/ref 17592186535069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a6ce84e-109c-502d-ae75-00961ce9ff86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{6}{5}.$ The series is divergent." :db/id #edb/ref 17592186534283} {:answer/id #uuid "50b57e3f-e86f-5664-a7b4-68a0717a38e2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\infty .$ The series is divergent." :db/id #edb/ref 17592186534425} {:answer/id #uuid "667a0c54-51d8-5adb-87dd-0040efd8d40d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=6.$ The series is divergent." :db/id #edb/ref 17592186534472} {:answer/id #uuid "a01506fd-1477-5630-b72b-044bad1929cb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=1.$ The root test gives no conclusion." :db/id #edb/ref 17592186534627} {:answer/id #uuid "c8f6e974-a325-5bc8-805b-63f27f6b2359" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{5}{6}.$ The series is convergent." :db/id #edb/ref 17592186534719}] :answer-field/correct {:answer/id #uuid "0a6ce84e-109c-502d-ae75-00961ce9ff86" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$L=\\frac{6}{5}.$ The series is divergent." :db/id #edb/ref 17592186534283} :answer-field/id #uuid "88aae151-d533-504a-94e6-0bbe62cec52b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534903}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d497f3f8-01e4-568d-82c0-af0842ace04d" :question/math-academy-id "q-14954" :question/problem "Calculate $L={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}$ for the sequence ${a}_{n}=\\frac{{6}^{n}}{{5}^{n}{n}^{6}}.$ According to the root test, does ${\\sum }_{n=1}^{\\infty }{a}_{n}$ converge or diverge?" :question/worked-solution "Suppose we have the series ${\\sum }_{n=1}^{\\infty }{a}_{n}$ such that ${a}_{n}\\ge 0$ for all $n\\ge 1,$ and that $L$ is defined as  \n\n$$\nL={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}}={lim}_{n\\to \\infty }{({a}_{n})}^{1/n}.\n$$\n\n \n\nThen, the root test states the following:\n\n- If $L<1$, the series converges.\n\n- If $L>1$ or $L=\\infty $, the series diverges.\n\n- If $L=1$, the root test is inconclusive.\n\nWe have the sequence ${a}_{n},$ defined as\n\n$$\n{a}_{n}=\\frac{{6}^{n}}{{5}^{n}{n}^{6}}.\n$$\n\nTo apply the root test, we find the limit of $\\sqrt[n]{{a}_{n}}$ as $n\\to \\infty :$\n\n$$\n\\begin{aligned}L & ={lim}_{n\\to \\infty }\\sqrt[n]{{a}_{n}} \\\\  & ={lim}_{n\\to \\infty }{({a}_{n})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }{(\\frac{{6}^{n}}{{5}^{n}{n}^{6}})}^{1/n} \\\\  & ={lim}_{n\\to \\infty }(\\frac{6}{5\\cdot \\sqrt[n]{{n}^{6}}}) \\\\  & =\\frac{6}{5}{lim}_{n\\to \\infty }{(\\frac{1}{\\sqrt[n]{n}})}^{6} \\\\  & =\\frac{6}{5}\\cdot {1}^{6} \\\\  & =\\frac{6}{5}\\end{aligned}\n$$\n\nNote that we used the fact that\n\n$$\n{lim}_{n\\to \\infty }\\sqrt[n]{n}=1.\n$$\n\nSince $L=\\frac{6}{5}>1,$ the series diverges by the root test."} {:db/id #edb/ref 17592186535075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f64d453-abc2-52b8-9d32-f5007c10820a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{11}}{5}(2+\\sqrt{2})" :db/id #edb/ref 17592186534329} {:answer/id #uuid "22931441-e80d-5d69-b5da-e45afb70211d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{5}" :db/id #edb/ref 17592186534340} {:answer/id #uuid "2aa47af8-9c69-50d1-901d-f11e4c5ee62b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{33}}{5}" :db/id #edb/ref 17592186534353} {:answer/id #uuid "3809e723-7c0b-5a79-a57f-42ba07e98577" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2\\sqrt{3}}{3}" :db/id #edb/ref 17592186534373} {:answer/id #uuid "90b9897e-bd16-5166-a704-48996320daaf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{11}}{2}(2-\\sqrt{2})" :db/id #edb/ref 17592186534587}] :answer-field/correct {:answer/id #uuid "2aa47af8-9c69-50d1-901d-f11e4c5ee62b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4\\sqrt{33}}{5}" :db/id #edb/ref 17592186534353} :answer-field/id #uuid "0d007d0a-e619-522c-9617-4f4a41fec80b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534836}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e16a799c-84bb-5d3d-b669-6d70bdf08db4" :question/math-academy-id "q-161350" :question/problem "Evaluate the surface integral \n\n$$\n{∬}_{S}\\sqrt{z}\\,\\text{d}S\n$$\n\nwhere $S$ is defined by $z=y-3x$ for $0\\le x\\le 1$ and $3x\\le y\\le 3.$" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(y-3x)=-3,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(y-3x)=1.\n$$\n\nTherefore, the surface integral can be evaluated as follows:\n\n$$\n\\begin{aligned}{∬}_{S}\\sqrt{z}\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\sqrt{y-3x}\\sqrt{1+(-3)^{2}+{1}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,\\sqrt{y-3x}\\sqrt{11}\\,\\text{d}A \\\\  & =\\sqrt{11}{∬}_{D}\\,\\sqrt{y-3x}\\,\\text{d}A \\\\  & =\\sqrt{11}{\\int }_{0}^{1}{\\int }_{3x}^{3}\\sqrt{y-3x}\\,\\text{d}y\\,\\text{d}x \\\\  & =\\sqrt{11}{\\int }_{0}^{1}{[\\frac{2}{3}(y-3x)^{3/2}]}_{y=3x}^{y=3}\\,\\text{d}x \\\\  & =\\frac{2\\sqrt{11}}{3}{\\int }_{0}^{1}(3-3x)^{3/2}\\,\\text{d}x \\\\  & =\\frac{2\\sqrt{11}}{3}\\,{[\\frac{2}{5}\\cdot (-\\frac{1}{3})(3-3x)^{5/2}]}_{0}^{1} \\\\  & =-\\frac{4\\sqrt{11}}{45}(0-{3}^{5/2}) \\\\  & =\\frac{4\\sqrt{11}}{45}(9\\sqrt{3}) \\\\  & =\\frac{4\\sqrt{33}}{5}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535084 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "228ec946-8873-5f8b-8a2a-49f36370152e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}-4{y}^{2}+2\\sqrt{2}xy)" :db/id #edb/ref 17592186534338} {:answer/id #uuid "9877fc34-f311-559c-8cc0-f65810b60958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}+2{y}^{2}+2\\sqrt{2}xy)" :db/id #edb/ref 17592186534605} {:answer/id #uuid "a1ff7c33-ae77-5848-9080-a0accbff86b7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}+2y+2\\sqrt{2}xy)" :db/id #edb/ref 17592186534631} {:answer/id #uuid "c20f1d54-0fa6-57df-9370-78329241cb08" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}y+4{y}^{2}+\\sqrt{2}x)" :db/id #edb/ref 17592186534699} {:answer/id #uuid "ea232514-d5a5-5e3b-af1e-b89e96005805" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}+2{y}^{2}-\\sqrt{2}xy)" :db/id #edb/ref 17592186534786}] :answer-field/correct {:answer/id #uuid "9877fc34-f311-559c-8cc0-f65810b60958" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2({x}^{2}+2{y}^{2}+2\\sqrt{2}xy)" :db/id #edb/ref 17592186534605} :answer-field/id #uuid "1808b286-0193-5bc8-a2c6-690d66c8a263" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534844}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "f409435d-6032-5802-bf1f-c20613731f7b" :question/math-academy-id "q-161327" :question/problem "Consider the surface integral of the function $f(x,y,z)={z}^{2},$ where the surface $S$ is defined by $z=x+\\sqrt{2}y$ for $-1\\le x\\le 2$ and $-1\\le y\\le 2.$\nThis surface integral can be written as a repeated integral, as shown below. \n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={\\int }_{-1}^{2}{\\int }_{-1}^{2}\\boxed{}\\,\\,\\text{d}y\\,\\text{d}x\n$$\n\nWhat is the missing expression?" :question/worked-solution "For a surface $S$ defined by $z=g(x,y)$ with $(x,y)\\in D,$ the surface integral of a scalar function $f(x,y,z)$ over $S$ is given by\n\n$$\n{∬}_{S}f(x,y,z)\\,\\text{d}S={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A.\n$$\n\nFor the partial derivatives, we have\n\n$$\n\\frac{∂z}{∂x}=\\frac{∂}{∂x}(x+\\sqrt{2}y)=1,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(x+\\sqrt{2}y)=\\sqrt{2}.\n$$\n\nTherefore, the surface integral can be written as \n\n$$\n\\begin{aligned}{∬}_{S}f(x,y,z)\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(1)}^{2}+{(\\sqrt{2})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,2(x+\\sqrt{2}y)^{2}\\,\\text{d}A \\\\  & ={\\int }_{-1}^{2}{\\int }_{-1}^{2}\\,2({x}^{2}+2{y}^{2}+2\\sqrt{2}xy)\\,\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535088 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0aa7dce6-df1a-5088-806d-df25a6f8ac37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{8}}{6}+C" :db/id #edb/ref 17592186534284} {:answer/id #uuid "8cd65e72-3b80-534f-8810-88f5e53d25aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3{y}^{8}}{8}+C" :db/id #edb/ref 17592186534570} {:answer/id #uuid "bbaf516e-8b25-5de2-a3f1-8ece4f6fd9ae" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{6}}{8}+C" :db/id #edb/ref 17592186534685} {:answer/id #uuid "ce3c6810-8d96-5dbe-8d24-a6ff93cac7f1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{8}}{2}+C" :db/id #edb/ref 17592186534728} {:answer/id #uuid "fabcfbb7-87ed-59c3-875b-7c9ddc058fe8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{6}}{3}+C" :db/id #edb/ref 17592186534820}] :answer-field/correct {:answer/id #uuid "0aa7dce6-df1a-5088-806d-df25a6f8ac37" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{{y}^{8}}{6}+C" :db/id #edb/ref 17592186534284} :answer-field/id #uuid "3c95a3e3-069c-5ec3-b88e-edd9bad2a80d" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186534865}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "fc2dfa06-fbfe-5d00-98fd-cc43b27c052d" :question/math-academy-id "q-113731" :question/problem "Calculate $\\int \\frac{4}{3}{y}^{7}\\,\\text{d}y.$" :question/worked-solution "We can just take the constant factor out of the integral, and then apply the power rule:\n\n$$\n\\begin{aligned}\\int \\frac{4}{3}{y}^{7}\\,\\text{d}y & =\\frac{4}{3}\\int {y}^{7}\\,\\text{d}y \\\\  & =\\frac{4}{3}(\\frac{{y}^{7+1}}{7+1})+C \\\\  & =\\frac{4}{3}\\cdot \\frac{{y}^{8}}{8}+C \\\\  & =\\frac{{y}^{8}}{6}+C\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535355 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6d380b4d-cbdb-5c3d-b4f5-79f4d3f30612" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186535371}] :answer-field/correct {:answer/id #uuid "6d380b4d-cbdb-5c3d-b4f5-79f4d3f30612" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186535371} :answer-field/id #uuid "1b1e34e9-281e-5525-a988-3e0183aed79a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535351} {:answer-field/choices [{:answer/id #uuid "ebc38c67-0f2c-55bc-8ac3-870b4de8cdd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186535404}] :answer-field/correct {:answer/id #uuid "ebc38c67-0f2c-55bc-8ac3-870b4de8cdd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186535404} :answer-field/id #uuid "bea479f5-d845-5aa8-b705-4f5af19666e5" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535390}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "2462470c-e83a-5180-8ba7-14b12cb93548" :question/problem "If the point $P$ has polar coordinates $(\\sqrt{3},\\frac{2\\pi }{3}),$ then its Cartesian coordinates are\n\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{3}\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =\\sqrt{3}\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt{3}\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =\\sqrt{3}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{\\sqrt{3}}{2},\\frac{3}{2}).$"} {:db/id #edb/ref 17592186535357 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dce29a06-7231-510c-baeb-785f5b642ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186535397}] :answer-field/correct {:answer/id #uuid "dce29a06-7231-510c-baeb-785f5b642ab7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186535397} :answer-field/id #uuid "4225cd29-e5b1-5839-878d-fa15454c1675" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535362} {:answer-field/choices [{:answer/id #uuid "e458f5bb-6420-507b-930f-7f2eace6e18d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9\\sqrt{3}}{2}" :db/id #edb/ref 17592186535401}] :answer-field/correct {:answer/id #uuid "e458f5bb-6420-507b-930f-7f2eace6e18d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9\\sqrt{3}}{2}" :db/id #edb/ref 17592186535401} :answer-field/id #uuid "97e5e22b-d1c5-582e-9bce-ccd30bea3b75" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535383}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "30f46f93-e276-5865-a2a5-45fb2da8cc26" :question/problem "If the point $P$ has polar coordinates $(9,{300}^{∘}),$ then its Cartesian coordinates are\n\n$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =9\\operatorname{cos}⁡({300}^{∘}) \\\\  & =9(\\frac{1}{2}) \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =9\\operatorname{sin}⁡({300}^{∘}) \\\\  & =9(-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{9\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(\\frac{9}{2},-\\frac{9\\sqrt{3}}{2}).$"} {:db/id #edb/ref 17592186535370 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81c82063-75a5-5bd6-b794-c348a37d60f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7\\sqrt{3}}{2}" :db/id #edb/ref 17592186535376}] :answer-field/correct {:answer/id #uuid "81c82063-75a5-5bd6-b794-c348a37d60f5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7\\sqrt{3}}{2}" :db/id #edb/ref 17592186535376} :answer-field/id #uuid "55467257-59a7-53f1-a8c5-ec0d5614c04d" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535369} {:answer-field/choices [{:answer/id #uuid "8d29f31c-5296-5187-8910-d4fbc75802dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186535380}] :answer-field/correct {:answer/id #uuid "8d29f31c-5296-5187-8910-d4fbc75802dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{7}{2}" :db/id #edb/ref 17592186535380} :answer-field/id #uuid "fc10bd8f-ae0a-501f-ac01-582338025af9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535408}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5c92d408-2136-542c-859f-b5a835f86a64" :question/problem "If the point $P$ has polar coordinates $(7,\\frac{4\\pi }{3}),$ then its Cartesian coordinates are\n\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =7\\operatorname{cos}⁡(\\frac{4\\pi }{3}) \\\\  & =7\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{7}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =7\\operatorname{sin}⁡(\\frac{4\\pi }{3}) \\\\  & =7\\cdot -\\frac{\\sqrt{3}}{2} \\\\  & =-\\frac{7\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{7}{2},-\\frac{7\\sqrt{3}}{2}).$"} {:db/id #edb/ref 17592186535386 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f1ce0e10-a914-55d7-828c-95787df764e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186535407}] :answer-field/correct {:answer/id #uuid "f1ce0e10-a914-55d7-828c-95787df764e0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186535407} :answer-field/id #uuid "16ee75b0-3d1d-53bc-bb02-8f1d4ed4a78a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535350} {:answer-field/choices [{:answer/id #uuid "1feddc4a-f369-516e-bbd5-46b6fc21adca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186535352}] :answer-field/correct {:answer/id #uuid "1feddc4a-f369-516e-bbd5-46b6fc21adca" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3\\sqrt{2}}{2}" :db/id #edb/ref 17592186535352} :answer-field/id #uuid "31144477-3b6f-549b-b737-e399729aa04b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535358}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "ac2fde5d-a37f-5387-93cb-e84570f83953" :question/problem "If the point $P$ has polar coordinates $(3,\\frac{7\\pi }{4}),$ then its Cartesian coordinates are\n\n$(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{cos}⁡(\\frac{7\\pi }{4}) \\\\  & =3\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{3\\sqrt{2}}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡(\\frac{7\\pi }{4}) \\\\  & =3\\cdot -\\frac{\\sqrt{2}}{2} \\\\  & =-\\frac{3\\sqrt{2}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(\\frac{3\\sqrt{2}}{2},-\\frac{3\\sqrt{2}}{2}).$"} {:db/id #edb/ref 17592186535395 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "49ba955d-0687-5313-8a94-1e8d43146764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{2},\\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186535363} {:answer/id #uuid "5383f70f-b2db-58bf-be9a-991190a79f5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{1}{2},\\frac{\\sqrt{3}}{2})" :db/id #edb/ref 17592186535368} {:answer/id #uuid "95b14a76-aada-5d75-9c60-9bc381e42b1c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{2},-\\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186535382} {:answer/id #uuid "b4221dca-faf4-5364-b247-a200dbba83c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{2},\\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186535388} {:answer/id #uuid "ebad5aa5-4ceb-50fd-960a-5ea2aeef6720" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(\\frac{3}{2},-\\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186535403}] :answer-field/correct {:answer/id #uuid "49ba955d-0687-5313-8a94-1e8d43146764" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "(-\\frac{3}{2},\\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186535363} :answer-field/id #uuid "51ea380c-f23e-5e51-bd1d-f8d38228dbb9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535367}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "d7f1330f-7c93-5695-838c-983c4cfdaa3e" :question/problem "The point $P$ has polar coordinates $(3,{120}^{∘}).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "To convert from polar coordinates to Cartesian coordinates, we use\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta .\n$$\n\nFirst, we calculate the $x$-coordinate of $P:$\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =3\\operatorname{cos}⁡({120}^{∘}) \\\\  & =3(-\\frac{1}{2}) \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$\n\nThen, we calculate the $y$-coordinate of $P:$\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =3\\operatorname{sin}⁡({120}^{∘}) \\\\  & =3(\\frac{\\sqrt{3}}{2}) \\\\  & =\\frac{3\\sqrt{3}}{2}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-\\frac{3}{2},\\frac{3\\sqrt{3}}{2}).$"} {:db/id #edb/ref 17592186535926 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f1ee210-e8c3-5b0b-b961-e2ea6bb04afc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1/2}^{2}{[\\frac{7}{2}-y]}^{2}\\,\\,\\text{d}y" :db/id #edb/ref 17592186535464} {:answer/id #uuid "378a3f70-b83c-543f-8230-8a9c470b7cdc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1}^{2}({[\\frac{5}{2}-y]}^{2}-{[\\frac{1}{y}]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186535519} {:answer/id #uuid "60fcac8a-9636-51dd-b16e-559340914a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1/2}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186535586} {:answer/id #uuid "7e880303-2fe8-5c05-b664-1056f270eb21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186535634} {:answer/id #uuid "9907a464-6ae3-5500-b762-ac9746b04080" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186535676}] :answer-field/correct {:answer/id #uuid "60fcac8a-9636-51dd-b16e-559340914a75" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{1/2}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\,\\,\\text{d}y" :db/id #edb/ref 17592186535586} :answer-field/id #uuid "7988a85f-c1d9-5415-bd21-c53e94524cdc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535873}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "0ad0e9c9-a63e-55c4-a91b-b9b32de9ed5c" :question/math-academy-id "q-50324" :question/problem "![](images/b0/b0e8cbe1a26b5a012f6098b67320070e882fa38783d8eda07dd0b76011a47b21.png)\n\nThe region enclosed by the curves $x=\\frac{1}{y}$ and $x=\\frac{5}{2}-y$ is rotated ${360}^{∘}$ about the line $x=-1.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\\frac{1}{y} & =\\frac{5}{2}-y \\\\ 1 & =\\frac{5}{2}y-{y}^{2} \\\\ {y}^{2}-\\frac{5}{2}y+1 & =0 \\\\ 2{y}^{2}-5y+2 & =0 \\\\ (y-2)(2y-1) & =0 \\\\ y & =\\frac{1}{2},2\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=\\frac{1}{2}$ to $y=2.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/d5/d5067706f9ff1abbdfd9dfce94711cb854f79c1156ddc0d81c1c35a5ed555f7a.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\frac{1}{y},$ and\n\n- *leaves* through the outer curve $x=\\frac{5}{2}-y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=\\frac{5}{2}-y.$\n\n![](images/a9/a944979bc352b0e40afea73836b22c1fb1513fabbc727fb60d4c96793ee6fbb5.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{1/2}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\,(\\frac{5}{2}-y)-(-1)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\frac{7}{2}-y]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\frac{1}{y}.$\n\n![](images/1e/1eb04cf2f3ae0669dd82106b064dd822da618e9ca31bb3b96e4e30c71b7c3193.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{1/2}^{2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\,(\\frac{1}{y})-(-1)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\frac{1}{y}+1]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{1/2}^{2}{[\\frac{7}{2}-y]}^{2}\\,\\text{d}y-\\pi {\\int }_{1/2}^{2}{[\\frac{1}{y}+1]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{1/2}^{2}({[\\frac{7}{2}-y]}^{2}-{[\\frac{1}{y}+1]}^{2})\\text{d}y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535946 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b7ddbe0-edeb-5af4-acdc-0e8bdedd7785" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2}t,\\,\\,y=-\\frac{3}{4}{t}^{2}" :db/id #edb/ref 17592186535455} {:answer/id #uuid "2637c6d9-f699-5e24-af7a-329870be2fe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2}t,\\,\\,y=\\frac{3}{4}{t}^{2}" :db/id #edb/ref 17592186535495} {:answer/id #uuid "369283f1-0003-5dfd-b8bf-780c8fe3b4e7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{4}t,\\,\\,y=\\frac{3}{2}{t}^{2}" :db/id #edb/ref 17592186535518} {:answer/id #uuid "512a7ed1-b0bf-5dd9-9978-7ed2decafc3b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2}t,\\,\\,y=-\\frac{3}{2}{t}^{2}" :db/id #edb/ref 17592186535559} {:answer/id #uuid "82e84ea1-476d-5fa4-8ca5-a30056317436" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{3}{2}t,\\,\\,y=\\frac{3}{8}{t}^{2}" :db/id #edb/ref 17592186535642}] :answer-field/correct {:answer/id #uuid "2637c6d9-f699-5e24-af7a-329870be2fe3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=\\frac{3}{2}t,\\,\\,y=\\frac{3}{4}{t}^{2}" :db/id #edb/ref 17592186535495} :answer-field/id #uuid "709bb002-42ed-5076-9f07-4d7555384dbe" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "476be737-90ba-5bfe-8a20-c650319e8b3b" :question/math-academy-id "q-106414" :question/problem "![](images/89/8934e5b6135b97b845dad9a6b87056d2c228fd2424d3a72141df694d46ccf7c0.png)\n\nWhich of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the parabola shown above?" :question/worked-solution "The diagram shows that the parabola is vertical, has its vertex at $(0,0),$ and passes through the point $(-6,12).$\n\nThe parametric equations of a vertical parabola  that has its vertex at $(0,0)$ are\n\n$$\nx=2pt,\\,y=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(-6,12),$ we can substitute $x=-6$ and $y=12$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}-6=2pt \\\\ 12=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}-6 & =2pt \\\\ -3 & =pt \\\\ t & =-\\frac{3}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}12 & =p{(-\\frac{3}{p})}^{2} \\\\ 12 & =p\\cdot \\frac{9}{{p}^{2}} \\\\ 12 & =\\frac{9}{p} \\\\ p & =\\frac{3}{4}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=2(\\frac{3}{4})t,\\,y=(\\frac{3}{4}){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx=\\frac{3}{2}t,\\,y=\\frac{3}{4}{t}^{2}.\n$$"} {:db/id #edb/ref 17592186535952 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34dc9e34-88b2-585e-b8f0-9828d32d21e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4t" :db/id #edb/ref 17592186535515}] :answer-field/correct {:answer/id #uuid "34dc9e34-88b2-585e-b8f0-9828d32d21e1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4t" :db/id #edb/ref 17592186535515} :answer-field/id #uuid "852f5335-7100-5af8-83e3-1bcac38ee757" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535879} {:answer-field/choices [{:answer/id #uuid "792a7020-748e-5273-a5c8-4d48fd7db315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t^{2}" :db/id #edb/ref 17592186535622}] :answer-field/correct {:answer/id #uuid "792a7020-748e-5273-a5c8-4d48fd7db315" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2t^{2}" :db/id #edb/ref 17592186535622} :answer-field/id #uuid "f288405a-29b1-5b71-8025-b48b0179b10a" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535920}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "5daa6476-7e34-5e5c-afc2-27c877b6a525" :question/math-academy-id "q-280220" :question/problem "Determine a set of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ that generate a vertical parabola that has its vertex at $(0,0)$ and which passes through the point $(-8,8).$ Express your answer in the form $x=2pt,y=p{t}^{2},$ where $p$ is a constant.\n\n$x=$\n{{field-1}},\n$\\,y=$\n{{field-2}}" :question/worked-solution "The parametric equations of a vertical parabola  that has its vertex at $(0,0)$ are\n\n$$\nx=2pt,\\,y=p{t}^{2},\n$$\n\nwhere $p$ is constant.\n\nSince the parabola passes through $(-8,8),$ we can substitute $x=-8$ and $y=8$ into the standard parametric equations to obtain a system of equations. This gives\n\n$$\n\\{\\begin{aligned}-8=2pt \\\\ 8=p{t}^{2}.\\end{aligned}\n$$\n\nSolving the first equation for $t,$ we have\n\n$$\n\\begin{aligned}-8 & =2pt \\\\ t & =-\\frac{4}{p}.\\end{aligned}\n$$\n\nSubstituting this into the second equation and solving for $p,$ we get\n\n$$\n\\begin{aligned}8 & =p{(-\\frac{4}{p})}^{2} \\\\ 8 & =p\\cdot \\frac{16}{{p}^{2}} \\\\ 8 & =\\frac{16}{p} \\\\ p & =2.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=2(2)t,\\,y=(2){t}^{2},\n$$\n\nwhich simplify to\n\n$$\nx=4t,\\,y=2{t}^{2}.\n$$"} {:db/id #edb/ref 17592186535956 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "31117d05-b1e6-5e36-823b-ec47b7ae9d4c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c2/c24b3426db4bc40675424ef027b63dddc9c8267ad04ab2fe68268d3f4a5cf9b9.png" :db/id #edb/ref 17592186535507} {:answer/id #uuid "5c61c2dd-9c01-5dd3-93fe-6a61c2875558" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/c9/c912ae9561fd31e47c69e142da4482e55a6286d4d46bd07fdd9576385369bb09.png" :db/id #edb/ref 17592186535581} {:answer/id #uuid "848aac6b-1d0b-58d7-b376-664ddf304010" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/cb/cbd070919bb20b512a40b88724c1f988d65e5d12c9476b76c3317dc5b1421f81.png" :db/id #edb/ref 17592186535643} {:answer/id #uuid "a903eff5-3997-5040-8fe1-b7e324eca023" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/42/42c03656382d8caa36fc7937d47d31d2932e139a5282afb5e0787ea518130691.png" :db/id #edb/ref 17592186535699} {:answer/id #uuid "ffb9e1e5-4499-5254-8d2a-c04b3956786c" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/36/36c9eb5f43331ab289da58d53df6a0c2ad420f061619f3d2f8132c01c73b772e.png" :db/id #edb/ref 17592186535830}] :answer-field/correct {:answer/id #uuid "a903eff5-3997-5040-8fe1-b7e324eca023" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/42/42c03656382d8caa36fc7937d47d31d2932e139a5282afb5e0787ea518130691.png" :db/id #edb/ref 17592186535699} :answer-field/id #uuid "9b2c9cfc-876b-5ffb-a336-42f6524f0579" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535887}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "69f2d31b-6c6d-5d78-bb33-d5bfc1d325a7" :question/math-academy-id "q-124416" :question/problem "How is the angle $-\\frac{13\\pi }{18}$ normally represented in the coordinate plane?" :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n-(\\frac{13\\pi }{18})\\cdot (\\frac{{180}^{∘}}{\\pi })=-{130}^{∘}.\n$$\n\nSo, the angle $-\\frac{13\\pi }{18}$ is equivalent to $-{130}^{∘}.$ \n\nNow, we recall that:\n\n- An angle in the standard position has its initial side on the positive $x$-axis, and a vertex that lies at the origin.\n\n- It rotates such that a positive angle is measured counter-clockwise, and a negative angle is measured clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/42/42c03656382d8caa36fc7937d47d31d2932e139a5282afb5e0787ea518130691.png)"} {:db/id #edb/ref 17592186535957 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0538fe89-8dc3-52a1-ae06-27b01e1b4965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{2\\pi y}{3})-4{y}^{4})\\,\\text{d}y" :db/id #edb/ref 17592186535445} {:answer/id #uuid "55d1530f-3fa2-5a08-8bcc-98aa2c0fd192" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1/2}^{1/2}({sin}^{2}⁡(\\frac{2\\pi y}{3})-4{y}^{4})\\,\\text{d}y" :db/id #edb/ref 17592186535569} {:answer/id #uuid "972bf55d-1dab-510d-9213-5a9e7ecde914" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1/2}^{1/2}({sin}^{2}⁡(\\frac{\\pi y}{3})-4{y}^{4})\\,\\text{d}y" :db/id #edb/ref 17592186535672} {:answer/id #uuid "e2aca940-e7f6-56a7-a52f-f3fc13aea2b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{\\pi y}{3})-(1-2{y}^{2})^{2})\\,\\text{d}y" :db/id #edb/ref 17592186535784} {:answer/id #uuid "fc85b5f0-dcd6-58f0-b09d-4cc19f8fcf5d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{2\\pi y}{3})-(1-2{y}^{2})^{2})\\,\\text{d}y" :db/id #edb/ref 17592186535826}] :answer-field/correct {:answer/id #uuid "0538fe89-8dc3-52a1-ae06-27b01e1b4965" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{2\\pi y}{3})-4{y}^{4})\\,\\text{d}y" :db/id #edb/ref 17592186535445} :answer-field/id #uuid "58834ca7-0094-5902-ba0d-d4e72392d1de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535863}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6be7f528-8a2e-5e94-a08f-bb7c33bc8c26" :question/math-academy-id "q-125400" :question/problem "![](images/90/90980bb04eb7dd9906ec9a99ea3a1b7cfd9c00969bbd9b12c60fe0f80eb88840.png)\n\nThe region enclosed by the curves $x+2{y}^{2}=1$ and $x=2{sin}^{2}⁡(\\frac{\\pi y}{3})$ for $y\\in [-\\frac{1}{2},\\frac{1}{2}]$ is rotated $2\\pi $ radians about the line $x=1.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, since we are rotating about a vertical line, we need to solve the equation of our first curve for $x:$ \n\n$$\n\\begin{aligned}x+2{y}^{2} & =1\\,⟹\\,x=1-2{y}^{2}\\end{aligned}\n$$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/16/16ca1c96786eb8e7ef12608f70d03b34b679e63d34ef41135b4fd6801bcccc27.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=1-2{y}^{2},$ and\n\n- *leaves* through the outer curve $x=2{sin}^{2}⁡(\\frac{\\pi y}{3}).$\n\nNext, we can find the volume of our solid as a difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=2{sin}^{2}⁡(\\frac{\\pi y}{3}).$\n\n![](images/27/276dea7b2d9f50e3fe171cceb64c1c7a12f84cfb18bdbe242102802ad9790f49.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{-1/2}^{1/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[\\,(1)-(2{sin}^{2}⁡(\\frac{\\pi y}{3}))\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[1-2{sin}^{2}⁡(\\frac{\\pi y}{3})]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[\\operatorname{cos}⁡(\\frac{2\\pi y}{3})]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=1-2{y}^{2}.$\n\n![](images/b6/b6c6fb140bb3eaf4c49cba76af157fb46a568bc2dc24e4763facede62720f844.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{-1/2}^{1/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[\\,(1)-(1-2{y}^{2})\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}{[2{y}^{2}]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{-1/2}^{1/2}({(\\operatorname{cos}⁡(\\frac{2\\pi y}{3}))}^{2}-{(2{y}^{2})}^{2})\\,\\text{d}y \\\\  & =\\pi {\\int }_{-1/2}^{1/2}({cos}^{2}⁡(\\frac{2\\pi y}{3})-4{y}^{4})\\,\\text{d}y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186535961 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ae87006-12e8-5ce8-b74c-a345ed296b95" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/99/99d898f557dddfbc28359f705170cfcdedbee9a18dc4d26fd960a6747a79ab7f.png" :db/id #edb/ref 17592186535578} {:answer/id #uuid "72c4de8d-b6cf-5dde-bc6c-7dcded79efe7" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/fa/fa3ed2c1d0b882ec193db83df166b0e27990d9fb8e7e23ede8634b660fd6c53d.png" :db/id #edb/ref 17592186535613} {:answer/id #uuid "8ea4aaed-66ce-5922-998e-3232609aab0f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a82ca9d59a88071320c95a78d10900c73c32e4c156dddb32a57603121923b8c5.png" :db/id #edb/ref 17592186535663} {:answer/id #uuid "aad8519d-75b0-5101-8c2f-f3cf9bfa42fe" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/7c/7c8c0b85a8c06e4f92a7bcf558a6de7c409e4dbbec25b46780d67a8324488250.png" :db/id #edb/ref 17592186535701} {:answer/id #uuid "b2a921c8-951d-5b17-91a6-3d9c69e8bf13" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/8b/8b22828130202b99c388fdb3b57ad4e311fa67182ca7ffa303ccac2687d45e9c.png" :db/id #edb/ref 17592186535709}] :answer-field/correct {:answer/id #uuid "8ea4aaed-66ce-5922-998e-3232609aab0f" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/a8/a82ca9d59a88071320c95a78d10900c73c32e4c156dddb32a57603121923b8c5.png" :db/id #edb/ref 17592186535663} :answer-field/id #uuid "bac22063-b3ae-514c-8d0f-7f5b7583523c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535902}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "799cf069-368d-5fad-8ff3-f06fd1cc93a6" :question/math-academy-id "q-34483" :question/problem "How is the angle $-\\frac{17\\pi }{9}$ normally represented in the coordinate plane?" :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n-(\\frac{17\\pi }{9})\\cdot (\\frac{{180}^{∘}}{\\pi })=-{340}^{∘}.\n$$\n\nSo, the angle $-\\frac{17\\pi }{9}$ is equivalent to $-{340}^{∘}.$ \n\nNow, we recall that:\n\n- An angle in the standard position has its initial side on the positive $x$-axis, and a vertex that lies at the origin.\n\n- It rotates such that a positive angle is measured counter-clockwise, and a negative angle is measured clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/a8/a82ca9d59a88071320c95a78d10900c73c32e4c156dddb32a57603121923b8c5.png)"} {:db/id #edb/ref 17592186535972 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5859ef23-64ea-5f95-8062-f7664d1b6145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186535576}] :answer-field/correct {:answer/id #uuid "5859ef23-64ea-5f95-8062-f7664d1b6145" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{14}{9}" :db/id #edb/ref 17592186535576} :answer-field/id #uuid "2ab3c0e2-4bdc-50da-b2cf-5a837a9baa2c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535847}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "948c8637-9616-53cf-93bb-0432892cbe59" :question/math-academy-id "q-354500" :question/problem "A particle’s acceleration in ${\\text{m/s}}^{2}$ is given by the function $a(t)=\\sqrt{t},$ where $t$ is the time in seconds.  \n\nFind the average acceleration ${a}_{\\text{avg}}$ of the particle on the interval $[1,4].$ Do not round your answer.\n\n${a}_{\\text{avg}}=$ \n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "To calculate the average value of the acceleration on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{a}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}a(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{a}_{\\text{avg}} & =\\frac{1}{4-1}{\\int }_{1}^{4}\\sqrt{t}\\,\\text{d}t \\\\  & =\\frac{1}{3}{(\\frac{2}{3}{t}^{3/2})|}_{1}^{4} \\\\  & =\\frac{1}{3}[(\\frac{2}{3}\\cdot 8)-(\\frac{2}{3}\\cdot 1)] \\\\  & =\\frac{1}{3}(\\frac{16}{3}-\\frac{2}{3}) \\\\  & =\\frac{1}{3}(\\frac{14}{3}) \\\\  & =\\frac{14}{9}\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$\n\nTherefore, the average acceleration is $\\frac{14}{9}\\,{\\text{m/s}}^{2}.$"} {:db/id #edb/ref 17592186535974 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ca4cfd4-07ce-53b0-ac05-7ef895c2e528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{2}}" :db/id #edb/ref 17592186535582} {:answer/id #uuid "85d4c3b1-bd0d-5ede-ab88-6b4e89d39b8a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=K{s}^{2}" :db/id #edb/ref 17592186535648} {:answer/id #uuid "c0dfbcc4-c509-5a61-956d-8bd3f7248123" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{s}" :db/id #edb/ref 17592186535729} {:answer/id #uuid "c85ccc6a-9e93-5f3b-a97f-d6c05f64a53d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=K" :db/id #edb/ref 17592186535736} {:answer/id #uuid "de7decf8-37f7-5b67-adfa-4152ced74e30" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=Ks" :db/id #edb/ref 17592186535777}] :answer-field/correct {:answer/id #uuid "5ca4cfd4-07ce-53b0-ac05-7ef895c2e528" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{2}}" :db/id #edb/ref 17592186535582} :answer-field/id #uuid "ddc65ecf-2fc0-57a8-93c3-d6c4c4e692c3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535914}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "9d65b7da-354a-5fe6-8886-5852de4be621" :question/math-academy-id "q-80488" :question/problem "The area of a square increases at a rate that's inversely proportional to its perimeter. Write down a differential equation describing the rate of change of the side length, $s(t),$ in this process. Assume that $K>0.$" :question/worked-solution "Let's highlight the important words in the given statement:\n\n*The **area** of a square **increases** at a **rate** that's **inversely proportional** to its **perimeter**.*\n\nWe note the following:\n\n- The question describes the *rate* at which the *area $A$ of a square* varies. Therefore, this is a statement about the quantity \n\n$$\n\\frac{\\text{d}A}{\\text{d}t}.\n$$\n\n- We're told that $\\frac{\\text{d}A}{\\text{d}t}$ *increases* at a rate that's *inversely proportional* to its *perimeter.* In other words,\n\n$$\n\\frac{\\text{d}A}{\\text{d}t}=\\frac{k}{4s}\n$$\n\nwhere $k>0.$\n\nWe wish to use this information to find an expression for $\\frac{\\text{d}s}{\\text{d}t}.$\n\nThe area of a square is given by \n\n$$\nA={s}^{2}.\n$$\n\n \n\nDifferentiating this equation with respect to $t,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({s}^{2}) \\\\ \\frac{\\text{d}A}{\\text{d}t} & =2s\\frac{\\text{d}s}{\\text{d}t}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{\\text{d}A}{\\text{d}t}=\\frac{k}{4s} \\\\ 2s\\frac{\\text{d}s}{\\text{d}t}=\\frac{k}{4s} \\\\ \\frac{\\text{d}s}{\\text{d}t}=\\frac{(\\frac{k}{4s})}{2s} \\\\ \\frac{\\text{d}s}{\\text{d}t}=\\frac{k}{8{s}^{2}}.\\end{aligned}\n$$\n\nWe now introduce a new constant:\n\n$$\nK=\\frac{k}{8}>0\n$$\n\n \n\nTherefore, our equation becomes\n\n$$\n\\frac{\\text{d}s}{\\text{d}t}=\\frac{K}{{s}^{2}}.\n$$"} {:db/id #edb/ref 17592186535987 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2771000a-6db8-5877-b7c6-5b7844a78fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{5}{2}{t}^{2},\\,\\,y=-5t" :db/id #edb/ref 17592186535497} {:answer/id #uuid "616c0775-e808-578f-831f-06059bc472d8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-5{t}^{2},\\,\\,y=-5t" :db/id #edb/ref 17592186535587} {:answer/id #uuid "b2849469-2ae6-5d77-81c9-093078f83f91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{5}{2}{t}^{2},\\,\\,y=-\\frac{5}{2}t" :db/id #edb/ref 17592186535708} {:answer/id #uuid "bed7ea9b-4c8f-5ee5-8da5-9881fef75d67" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{2}{5}{t}^{2},\\,\\,y=-\\frac{4}{5}t" :db/id #edb/ref 17592186535727} {:answer/id #uuid "cf409848-806c-52aa-b07d-5b0b88efdbdf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-{t}^{2},\\,\\,y=-\\frac{5}{2}t" :db/id #edb/ref 17592186535748}] :answer-field/correct {:answer/id #uuid "2771000a-6db8-5877-b7c6-5b7844a78fa4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "x=-\\frac{5}{2}{t}^{2},\\,\\,y=-5t" :db/id #edb/ref 17592186535497} :answer-field/id #uuid "3f25c337-6e13-59ee-b2b3-9226f27c88ac" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535853}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bf998376-0b5d-5f0e-ac72-6bbc0864becd" :question/math-academy-id "q-84714" :question/problem "Which of the following sets of parametric equations, defined for $t\\in (-\\infty ,\\infty ),$ generate the horizontal parabola given by the Cartesian equation ${y}^{2}=-10x?$" :question/worked-solution "The parametric equations of a horizontal parabola ${y}^{2}=4px$ that has its vertex at $(0,0)$ are\n\n$$\nx=p{t}^{2},\\,y=2pt,\n$$\n\nwhere $p$ is constant.\n\nComparing the given Cartesian equation with the general case ${y}^{2}=4px$ and solving for $p,$ we get\n\n$$\n\\begin{aligned}4px & =-10x \\\\ 4p & =-10 \\\\ p & =-\\frac{5}{2}.\\end{aligned}\n$$\n\nTherefore, the parametric equations of the parabola are\n\n$$\nx=(-\\frac{5}{2}){t}^{2},\\,y=2(-\\frac{5}{2})t,\n$$\n\nwhich simplify to\n\n$$\nx=-\\frac{5}{2}{t}^{2},\\,y=-5t.\n$$"} {:db/id #edb/ref 17592186535989 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "561dec26-edfd-5f06-be74-04ce011e37e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{9}" :db/id #edb/ref 17592186535571}] :answer-field/correct {:answer/id #uuid "561dec26-edfd-5f06-be74-04ce011e37e6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{32}{9}" :db/id #edb/ref 17592186535571} :answer-field/id #uuid "8d89cc03-11cb-5a33-a4d3-defd63d2cbf9" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186535883}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c00bebe5-d517-59a2-a7ee-fce25fbbc516" :question/math-academy-id "q-354478" :question/problem "A small rover moves along a straight track with velocity \n$v(t)=\\sqrt{t}+2,$ where $t$ is measured in seconds and $v$ is measured in meters per second.\n\nFind the average velocity ${v}_{\\text{avg}}$ on the interval $[1,4].$ Do not round your answer.\n\n${v}_{\\text{avg}}=$ \n{{field-1}}\n$\\text{m/s}$" :question/worked-solution "To calculate the average value of the velocity on $[{t}_{1},{t}_{2}],$ we use the average value formula\n\n$$\n{v}_{\\text{avg}}=\\frac{1}{{t}_{2}-{t}_{1}}{\\int }_{{t}_{1}}^{{t}_{2}}v(t)\\,\\text{d}t.\n$$\n\nSo, we get\n\n$$\n\\begin{aligned}{v}_{\\text{avg}} & =\\frac{1}{4-1}{\\int }_{1}^{4}(\\sqrt{t}+2)\\,\\text{d}t \\\\  & =\\frac{1}{3}{(\\frac{2}{3}{t}^{3/2}+2t)|}_{1}^{4} \\\\  & =\\frac{1}{3}[(\\frac{2}{3}\\cdot 8+8)-(\\frac{2}{3}\\cdot 1+2)] \\\\  & =\\frac{1}{3}[(\\frac{16}{3}+8)-(\\frac{2}{3}+2)] \\\\  & =\\frac{1}{3}[\\frac{40}{3}-\\frac{8}{3}] \\\\  & =\\frac{1}{3}(\\frac{32}{3}) \\\\  & =\\frac{32}{9}\\,\\text{m/s}.\\end{aligned}\n$$\n\nTherefore, the average velocity is $\\frac{32}{9}\\,\\text{m/s}.$"} {:db/id #edb/ref 17592186535990 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02866002-853c-51e0-a7ac-7be22a7aef3d" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/48/482f5888d17dd884472c99649214eb1be412eebcb5453b2be378905b865e8506.png" :db/id #edb/ref 17592186535440} {:answer/id #uuid "05bf3cbb-25e8-5551-bad9-b18213b07d54" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10e0ca8ea02ea6daefa4ebcd91cb1fc6d9264e065a7db26eee9a8bfdeb38e4f3.png" :db/id #edb/ref 17592186535447} {:answer/id #uuid "32b62ada-439d-5560-a4b1-47079f2d1828" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/62/6277f3bbf39df1480e6a930b83f9aa988506223a4afdba0048668c26bedf83e5.png" :db/id #edb/ref 17592186535508} {:answer/id #uuid "b408afd6-832e-5ef5-8355-c7a55dd3cec9" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/ed/ed61d0e56c234bd38e640086c3913c095cc7aba7fcfa0204ed95709ca011d0da.png" :db/id #edb/ref 17592186535710} {:answer/id #uuid "df8e772c-1241-5bb8-88cd-ad0d7d429fd4" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/e3/e3461e98410fa5c4ff996181cbcbe32bdd3400a9970dc24c75ca8bacce5fa365.png" :db/id #edb/ref 17592186535778}] :answer-field/correct {:answer/id #uuid "05bf3cbb-25e8-5551-bad9-b18213b07d54" :answer/type {:db/id #edb/ref 17592186045497 :db/ident :answer.type/image} :answer/value "images/10/10e0ca8ea02ea6daefa4ebcd91cb1fc6d9264e065a7db26eee9a8bfdeb38e4f3.png" :db/id #edb/ref 17592186535447} :answer-field/id #uuid "e3f8a739-ad21-5e4d-a0fc-6e28f7d33d12" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535916}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c3b96603-bf9c-5b42-9877-9f4fe08d9aee" :question/math-academy-id "q-124391" :question/problem "Which of the following diagrams shows the unit circle in the coordinate plane with a central angle of $-\\frac{5\\pi }{9}$ in the standard position?" :question/worked-solution "To help us to visualize the angle, we first convert the measure of the angle into degrees. \n\nTo convert the measure of an angle in radians to an equivalent measure in degrees, we multiply the measure in radians by $\\frac{{180}^{∘}}{\\pi }.$ This gives\n\n$$\n(-\\frac{5\\pi }{9})\\cdot (\\frac{{180}^{∘}}{\\pi })=-{100}^{∘}.\n$$\n\nTherefore,  $-\\frac{5\\pi }{9}$ is equivalent to $-{100}^{∘}.$\n\nThen, recall that:\n\n- A unit circle has a radius of $1$ and is centered at the origin in the coordinate plane.\n\n- An angle in the standard position has its initial side on the positive $x$-axis and its vertex is at the origin.\n\n- A positive angle has a rotation that is measured counter-clockwise, and a negative angle is measured clockwise.\n\nTherefore, the correct diagram is as follows:\n\n![](images/10/10e0ca8ea02ea6daefa4ebcd91cb1fc6d9264e065a7db26eee9a8bfdeb38e4f3.png)"} {:db/id #edb/ref 17592186536001 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13772a60-d9e6-519e-81ff-a87b69705c5c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{2}^{5}({[\\frac{5y}{8}+2]}^{2}-{[\\frac{{y}^{2}}{4}+2]}^{2})\\text{d}y" :db/id #edb/ref 17592186535468} {:answer/id #uuid "1b1973fe-fa48-5311-9b7e-e2acae1001af" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{5}({[\\frac{5y}{8}]}^{2}-{[\\frac{{y}^{2}}{4}]}^{2})\\text{d}y" :db/id #edb/ref 17592186535477} {:answer/id #uuid "4f48cd37-a024-5a0c-b78d-161e36a73060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{5/2}({[\\frac{5y}{8}+2]}^{2}-{[\\frac{{y}^{2}}{4}+2]}^{2})\\text{d}y" :db/id #edb/ref 17592186535553} {:answer/id #uuid "9a0443d6-5de1-5cf6-a9fa-57df36d5b4d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{5/2}{[\\frac{5y}{8}+2]}^{2}\\text{d}y" :db/id #edb/ref 17592186535678} {:answer/id #uuid "c18caf2a-05e8-5f0e-acf6-74e8d8e57477" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{5}([\\frac{5y}{8}+2]-[\\frac{{y}^{2}}{4}+2])\\text{d}y" :db/id #edb/ref 17592186535731}] :answer-field/correct {:answer/id #uuid "4f48cd37-a024-5a0c-b78d-161e36a73060" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\pi {\\int }_{0}^{5/2}({[\\frac{5y}{8}+2]}^{2}-{[\\frac{{y}^{2}}{4}+2]}^{2})\\text{d}y" :db/id #edb/ref 17592186535553} :answer-field/id #uuid "a538906d-e42b-5de1-87a1-cf764b3258be" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186535891}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "dd731e5d-ee05-5b06-811e-7a9b6ae9709a" :question/math-academy-id "q-49945" :question/problem "![](images/1c/1c22369a6f1abc89437de1977135208ef5d0e762a4971df1c9ace14b6af932cd.png)\n\nThe region enclosed by the curves $x=\\frac{5y}{8}$ and $x=\\frac{{y}^{2}}{4}$ is rotated ${360}^{∘}$ about the line $x=-2.$ Which of the following gives the volume of the resulting solid?" :question/worked-solution "First, we want to determine the limits of integration. We find the intersections of the curves by solving the following equation:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{4} & =\\frac{5y}{8} \\\\ 2{y}^{2} & =5y \\\\ 2{y}^{2}-5y & =0 \\\\ y(2y-5) & =0 \\\\ y & =0,\\frac{5}{2}\\end{aligned}\n$$\n\nHence, our limits of integration are from $y=0$ to $y=\\frac{5}{2}.$\n\nNow, let's draw a horizontal arrow through the given region. The arrow should be pointing away from the axis of rotation.\n\n![](images/50/504e204d73a1f87d72a321e7c0f58eadf01840ff3b8dbc5214f08e50fcbdcf9b.png)\n\nThe horizontal arrow \n\n- *enters* the region through the inner curve $x=\\frac{{y}^{2}}{4},$ and\n\n- *leaves* through the outer curve $x=\\frac{5}{8}y.$\n\nNext, we can find the volume of our solid as the difference between the volumes of the solids generated by the outer and inner curves.\n\n- **Step I.** Figure out the volume generated by the outer curve $x=\\frac{5}{8}y.$\n\n![](images/0c/0c43a01a8548112d8dc1f30f9059c560ac7bec1e679a6c76394d83e4bfbea668.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{outer}} & =\\pi {\\int }_{0}^{5/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\,(\\frac{5}{8}y)-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\frac{5}{8}y+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step II.** Figure out the volume generated by the inner curve $x=\\frac{{y}^{2}}{4}.$\n\n![](images/d8/d8478ef13983e6529fa10147f9659171e31a5555cb799ec1fad13d1fe8b25191.png)\n\nThe corresponding volume is given by\n\n$$\n\\begin{aligned}{V}_{\\text{inner}} & =\\pi {\\int }_{0}^{5/2}[\\,(\\text{right})-(\\text{left})\\,]^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\,(\\frac{{y}^{2}}{4})-(-2)\\,]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\frac{{y}^{2}}{4}+2]}^{2}\\,\\text{d}y.\\end{aligned}\n$$\n\n- **Step III.** Find the difference.\n\nFinally, we can write the volume of the original solid as\n\n$$\n\\begin{aligned}V & ={V}_{\\text{outer}}-{V}_{\\text{inner}} \\\\  & =\\pi {\\int }_{0}^{5/2}{[\\frac{5}{8}y+2]}^{2}\\,\\text{d}y-\\pi {\\int }_{0}^{5/2}{[\\frac{{y}^{2}}{4}+2]}^{2}\\,\\text{d}y \\\\  & =\\pi {\\int }_{0}^{5/2}({[\\frac{5}{8}y+2]}^{2}-{[\\frac{{y}^{2}}{4}+2]}^{2})\\text{d}y.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536059 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "055f7f68-8860-5fcd-ba89-65573245d570" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3x}{y}" :db/id #edb/ref 17592186536053} {:answer/id #uuid "2a5b1be4-7c6e-5722-a2f4-2aa1b2aae130" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9x}{y}" :db/id #edb/ref 17592186536054} {:answer/id #uuid "6675c608-2d79-51da-8ce1-3d915d6d59c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{y}{9x}" :db/id #edb/ref 17592186536055} {:answer/id #uuid "6e160412-70c4-5898-9627-1e775d2346d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{x}{9y}" :db/id #edb/ref 17592186536056} {:answer/id #uuid "8c584b97-62a0-5d84-bf7d-5b2abde11f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{y}" :db/id #edb/ref 17592186536057}] :answer-field/correct {:answer/id #uuid "8c584b97-62a0-5d84-bf7d-5b2abde11f40" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{9x}{y}" :db/id #edb/ref 17592186536057} :answer-field/id #uuid "cc377f79-c91d-5163-84d3-cf26a1ed63ab" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536058}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d7a2ead7-a103-561d-ae19-16273e0e5510" :question/problem "![](images/4e/4efe76bd06d22c5735b427c150f5a09b7288f8281b90921aeb11902c864176e5.png)\n\nFind $\\frac{\\text{d}y}{\\text{d}x}$ for the ellipse shown above." :question/worked-solution "Since our ellipse is centered at the origin and has semiaxes $1$ and $3,$ its equation is given by\n\n$$\n\\frac{{x}^{2}}{{1}^{2}}+\\frac{{y}^{2}}{{3}^{2}}=1\\,⟹\\,{x}^{2}+\\frac{{y}^{2}}{9}=1.\n$$\n\nNow, to calculate $\\frac{\\text{d}y}{\\text{d}x},$ we use implicit differentiation:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}({x}^{2}+\\frac{{y}^{2}}{9}) & =\\frac{\\text{d}}{\\text{d}x}(1) \\\\ \\frac{\\text{d}}{\\text{d}x}({x}^{2})+\\frac{\\text{d}}{\\text{d}x}(\\frac{{y}^{2}}{9}) & =0 \\\\ 2x+\\frac{2y}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =0 \\\\ \\frac{2y}{9}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-2x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-\\frac{9x}{y}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186536061 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086}] :answer-field/correct {:answer/id #uuid "86ab35d2-ac66-5423-ad34-ecb833f08102" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{1}{e^{2}} + 3 + 15 e^{2}" :db/id #edb/ref 17592186536086} :answer-field/id #uuid "1461180d-25fe-52b1-abad-c2120615be94" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536066}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "025970ae-87f8-5c12-8836-70b62439e2c5" :question/problem "If a curve $C$ is given by $y=(3 x^{2} + x - 1)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=3 x^{2} + x - 1$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=6 x + 1,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(3 x^{2} + x - 1)\\cdot (\\frac{1}{x})+(\\ln{\\left(x \\right)})\\cdot (6 x + 1) \\\\ &=\\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} + x \\ln{\\left(x \\right)} + x - 1}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(3 (e^{2})^{2} + (e^{2}) - 1)\\cdot (\\frac{1}{(e^{2})})+(\\ln{\\left((e^{2}) \\right)})\\cdot (6 (e^{2}) + 1) \\\\ &=(-1 + e^{2} + 3 e^{4})\\cdot (e^{-2})+(2)\\cdot (1 + 6 e^{2}) \\\\ &=- \\frac{1}{e^{2}} + 3 + 15 e^{2}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- \\frac{1}{e^{2}} + 3 + 15 e^{2}.$"} {:db/id #edb/ref 17592186536069 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068}] :answer-field/correct {:answer/id #uuid "27c49a10-bf3d-5b30-aa62-004fc1530f0b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}" :db/id #edb/ref 17592186536068} :answer-field/id #uuid "a3c99e80-1859-5501-94e2-065df60ee30c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536092}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "33ab5b35-dd61-5afa-9e50-76ac2177002e" :question/problem "If a curve $C$ is given by $y=(- x^{2} - x - 1)\\cdot (\\sin{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{\\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - x - 1$ and $v(x)=\\sin{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 1,\\quad v'(x)=\\cos{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - x - 1)\\cdot (\\cos{\\left(x \\right)})+(\\sin{\\left(x \\right)})\\cdot (- 2 x - 1) \\\\ &=- x^{2} \\cos{\\left(x \\right)} - 2 x \\sin{\\left(x \\right)} - x \\cos{\\left(x \\right)} - \\sin{\\left(x \\right)} - \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{\\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{\\pi}{4}} &=(- (\\frac{\\pi}{4})^{2} - (\\frac{\\pi}{4}) - 1)\\cdot (\\cos{\\left((\\frac{\\pi}{4}) \\right)})+(\\sin{\\left((\\frac{\\pi}{4}) \\right)})\\cdot (- 2 (\\frac{\\pi}{4}) - 1) \\\\ &=(-1 - \\frac{\\pi}{4} - \\frac{\\pi^{2}}{16})\\cdot (\\frac{\\sqrt{2}}{2})+(\\frac{\\sqrt{2}}{2})\\cdot (- \\frac{\\pi}{2} - 1) \\\\ &=\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(- 12 \\pi - 32 - \\pi^{2}\\right)}{32}.$"} {:db/id #edb/ref 17592186536075 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081}] :answer-field/correct {:answer/id #uuid "6e94ebae-2119-5150-a4b2-e2e54f3ec65a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 5 e^{2} - 6 + \\frac{2}{e^{2}}" :db/id #edb/ref 17592186536081} :answer-field/id #uuid "718082e0-417d-5acb-ab28-41d32f8d52ce" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536082}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "3cc06495-0e47-5717-9700-118ad0cf690b" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 2 x + 2)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e^{2}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 2 x + 2$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 2,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 2 x + 2)\\cdot (\\frac{1}{x})+(\\ln{\\left(x \\right)})\\cdot (- 2 x - 2) \\\\ &=- \\frac{2 x^{2} \\ln{\\left(x \\right)} + x^{2} + 2 x \\ln{\\left(x \\right)} + 2 x - 2}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e^{2}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e^{2}} &=(- (e^{2})^{2} - 2 (e^{2}) + 2)\\cdot (\\frac{1}{(e^{2})})+(\\ln{\\left((e^{2}) \\right)})\\cdot (- 2 (e^{2}) - 2) \\\\ &=(- e^{4} - 2 e^{2} + 2)\\cdot (e^{-2})+(2)\\cdot (- 2 e^{2} - 2) \\\\ &=- 5 e^{2} - 6 + \\frac{2}{e^{2}}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 5 e^{2} - 6 + \\frac{2}{e^{2}}.$"} {:db/id #edb/ref 17592186536077 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091}] :answer-field/correct {:answer/id #uuid "9a73445c-456a-5d66-84cd-e02fe84f715a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 9 e - \\frac{4}{e} + 6" :db/id #edb/ref 17592186536091} :answer-field/id #uuid "354f12c4-c49c-5ce8-9d56-4a6bfbb09230" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536070}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "45e8eff6-7be8-5e2f-8927-eac30ddd0bc6" :question/problem "If a curve $C$ is given by $y=(- 3 x^{2} + 3 x - 4)\\cdot (\\ln{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=e$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- 3 x^{2} + 3 x - 4$ and $v(x)=\\ln{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=3 - 6 x,\\quad v'(x)=\\frac{1}{x}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- 3 x^{2} + 3 x - 4)\\cdot (\\frac{1}{x})+(\\ln{\\left(x \\right)})\\cdot (3 - 6 x) \\\\ &=- \\frac{6 x^{2} \\ln{\\left(x \\right)} + 3 x^{2} - 3 x \\ln{\\left(x \\right)} - 3 x + 4}{x}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=e$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=e} &=(- 3 (e)^{2} + 3 (e) - 4)\\cdot (\\frac{1}{(e)})+(\\ln{\\left((e) \\right)})\\cdot (3 - 6 (e)) \\\\ &=(- 3 e^{2} - 4 + 3 e)\\cdot (e^{-1})+(1)\\cdot (3 - 6 e) \\\\ &=- 9 e - \\frac{4}{e} + 6.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $- 9 e - \\frac{4}{e} + 6.$"} {:db/id #edb/ref 17592186536087 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063}] :answer-field/correct {:answer/id #uuid "0e717ad5-c501-5b39-af7e-8878ba6ee6f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}" :db/id #edb/ref 17592186536063} :answer-field/id #uuid "1d6f8461-59dd-570a-8790-4ee15ed4552d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186536067}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "89a63571-dce9-5ef0-8359-7d12fffc0179" :question/problem "If a curve $C$ is given by $y=(- x^{2} - 3 x - 4)\\cdot (\\cos{\\left(x \\right)})$, calculate the slope of the tangent line to the curve at the point where $x=\\frac{3 \\pi}{4}$.\n\nSlope $=$ {{field-1}}" :question/worked-solution "We differentiate using the product rule. Let $u(x)=- x^{2} - 3 x - 4$ and $v(x)=\\cos{\\left(x \\right)}.$ Then, we have\n\n$$\nu'(x)=- 2 x - 3,\\quad v'(x)=- \\sin{\\left(x \\right)}.\n$$\n\nApplying the product rule gives\n\n$$\n\\begin{aligned}\\frac{\\mathrm dy}{\\mathrm dx} &=uv'(x)+vu'(x) \\\\ &=(- x^{2} - 3 x - 4)\\cdot (- \\sin{\\left(x \\right)})+(\\cos{\\left(x \\right)})\\cdot (- 2 x - 3) \\\\ &=x^{2} \\sin{\\left(x \\right)} + 3 x \\sin{\\left(x \\right)} - 2 x \\cos{\\left(x \\right)} + 4 \\sin{\\left(x \\right)} - 3 \\cos{\\left(x \\right)}.\\end{aligned}\n$$\n\nTo find the slope of the tangent line, we now substitute $x=\\frac{3 \\pi}{4}$ into the formula and get\n\n$$\n\\begin{aligned}\\left.\\frac{\\mathrm dy}{\\mathrm dx}\\right|_{x=\\frac{3 \\pi}{4}} &=(- (\\frac{3 \\pi}{4})^{2} - 3 (\\frac{3 \\pi}{4}) - 4)\\cdot (- \\sin{\\left((\\frac{3 \\pi}{4}) \\right)})+(\\cos{\\left((\\frac{3 \\pi}{4}) \\right)})\\cdot (- 2 (\\frac{3 \\pi}{4}) - 3) \\\\ &=(- \\frac{9 \\pi}{4} - \\frac{9 \\pi^{2}}{16} - 4)\\cdot (- \\frac{\\sqrt{2}}{2})+(- \\frac{\\sqrt{2}}{2})\\cdot (- \\frac{3 \\pi}{2} - 3) \\\\ &=\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.\\end{aligned}\n$$\n\nTherefore, the slope of the tangent line is $\\frac{\\sqrt{2} \\left(9 \\pi^{2} + 112 + 60 \\pi\\right)}{32}.$"} {:db/id #edb/ref 17592186536134 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ad3c34-7920-5a0f-aa67-8bf1dce8f6d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- \\frac{18 t e^{2 t} \\ln{\\left(t \\right)} - 9 e^{2 t} - 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536107} {:answer/id #uuid "42690b01-2e49-5771-869f-15c475b0958c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18 t e^{2 t} \\ln{\\left(t \\right)} + 9 e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536118} {:answer/id #uuid "4609bfb4-e0ca-56b1-8aa9-80620eea6074" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "9 e^{2 t} + 6 e^{t} \\ln{\\left(t \\right)} + 2 \\ln{\\left(t \\right)}" :db/id #edb/ref 17592186536120} {:answer/id #uuid "52f917e4-2460-586b-a26e-61222e1b7ec4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3 \\left(9 t e^{2 t} + 2 t \\ln{\\left(t \\right)} + 2 \\ln{\\left(t \\right)}\\right) e^{t}}{t}" :db/id #edb/ref 17592186536126} {:answer/id #uuid "b7d46d3a-bccb-523d-885d-4d3c7e6255a9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{9 e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536157}] :answer-field/correct {:answer/id #uuid "42690b01-2e49-5771-869f-15c475b0958c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{18 t e^{2 t} \\ln{\\left(t \\right)} + 9 e^{2 t} + 2 \\ln{\\left(t \\right)}}{t}" :db/id #edb/ref 17592186536118} :answer-field/id #uuid "66b25e82-59b6-5991-9378-8d3bf44fdfe9" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186536133}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "699d81bf-486b-5fcd-891b-b8329a36d705" :question/problem "If $f(x,y)=x^{2} + x y^{2}$ and $r(t)=\\ln{\\left(t \\right)}\\,i+3 e^{t}\\,j,$ compute $\\frac{\\text{d}}{\\text{d}t}[f(r(t))].$" :question/worked-solution "The chain rule in vector form states that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}[f(r(t))]=∇f(r(t))\\cdot {r}^{′}(t).\n$$\n\nFirst, we need to compute $∇f(x,y):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x^{2} + x y^{2})\\,i+\\frac{∂}{∂y}(x^{2} + x y^{2})\\,j \\\\  & =(2 x + y^{2})\\,i+2 x y\\,j\\end{aligned}\n$$\n\nNext, we substitute $x=\\ln{\\left(t \\right)}$ and $y=3 e^{t}$ into the above to find $∇f(r(t)):$\n\n$$\n\\begin{aligned}∇f(r(t)) & =(2(\\ln{\\left(t \\right)})+(3 e^{t})^{2})\\,i+2(\\ln{\\left(t \\right)})(3 e^{t})\\,j \\\\  & =(9 e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+6 e^{t} \\ln{\\left(t \\right)}\\,j\\end{aligned}\n$$\n\nNow, we calculate the derivative of $r(t),$ which is\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\ln{\\left(t \\right)})\\,i+\\frac{\\text{d}}{\\text{d}t}(3 e^{t})\\,j \\\\  & =\\frac{1}{t}\\,i+3 e^{t}\\,j.\\end{aligned}\n$$\n\nFinally, applying the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}[f(r(t))] & =∇f(r(t))\\cdot {r}^{′}(t) \\\\  & =((9 e^{2 t} + 2 \\ln{\\left(t \\right)})\\,i+6 e^{t} \\ln{\\left(t \\right)}\\,j)\\cdot (\\frac{1}{t}\\,i+3 e^{t}\\,j) \\\\  & =((9 e^{2 t} + 2 \\ln{\\left(t \\right)}))(\\frac{1}{t})+(6 e^{t} \\ln{\\left(t \\right)})(3 e^{t}) \\\\  & =\\frac{2 \\ln{\\left(t \\right)}}{t}+\\frac{9 e^{2 t}}{t}+18 e^{2 t} \\ln{\\left(t \\right)} \\\\  & =18 e^{2 t} \\ln{\\left(t \\right)} + \\frac{9 e^{2 t}}{t} + \\frac{2 \\ln{\\left(t \\right)}}{t}.\\end{aligned}\n$$"}]
