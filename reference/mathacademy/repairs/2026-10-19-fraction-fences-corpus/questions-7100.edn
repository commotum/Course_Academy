a \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}) \\\\  & =r^{2} \\sin^{2}{\\left(\\theta \\right)} - 14 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526197 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "282f6b6d-7109-520e-aba8-fa9ab8b0a7a3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526170} {:answer/id #uuid "3391d5eb-68ff-5f47-8cb4-841e008f9b13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}}{r}" :db/id #edb/ref 17592186526173} {:answer/id #uuid "a4d504c1-fe78-5a56-8d10-4e6193ffaa1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 r \\sin^{2}{\\left(\\theta \\right)} + 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526202} {:answer/id #uuid "e346e4b3-24c9-5ab1-b792-11794c240dfa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8 r \\sin^{2}{\\left(\\theta \\right)} + 3 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526218} {:answer/id #uuid "e860279b-77dd-57ba-a0d7-ecb00ace3f78" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 8 r \\sin^{2}{\\left(\\theta \\right)} - 6 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 4 r \\cos^{2}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526222}] :answer-field/correct {:answer/id #uuid "a4d504c1-fe78-5a56-8d10-4e6193ffaa1e" 