} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)}.\\end{aligned}\n$$\n\nFinally, substituting these into our chain rule formula, we get\n\n$$\n\\begin{aligned}\\frac{∂g}{∂\\theta} & =(- r^{2} \\sin^{2}{\\left(\\theta \\right)} - 2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})(- r \\sin{\\left(\\theta \\right)})+(- 2 r^{2} \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - r^{2} \\cos^{2}{\\left(\\theta \\right)})(r \\cos{\\left(\\theta \\right)}) \\\\  & =(r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)})+(- 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - r^{3} \\cos^{3}{\\left(\\theta \\right)}) \\\\  & =r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - r^{3} \\cos^{3}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526190 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0280772c-4d86-54c4-9ab1-42cbec9f9517" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526157} {:answer/id #uuid "9306357a-dd3a-55a8-86f4-13d69d861185" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 3 r^{3} \\sin^{3}{\\left(\\theta \\right)} + 4 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 6 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - 2 r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526195} {:answer/id #uuid "9c1045dc-ae7b-53d6-a201-09fd8a333326" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/v