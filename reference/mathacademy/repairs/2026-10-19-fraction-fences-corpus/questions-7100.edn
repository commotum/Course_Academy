\\\\  & =4 r \\sin^{2}{\\left(\\theta \\right)} - 2 r \\sin{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r \\cos^{2}{\\left(\\theta \\right)}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186526176 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b3c018-edde-524b-b06c-f153e53c6290" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526171} {:answer/id #uuid "5fe3c20f-e840-5440-be2a-f5c1a1149fa0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526179} {:answer/id #uuid "8d818a12-395f-5c83-b461-dd04476ca3f4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} - r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526194} {:answer/id #uuid "97dc724b-fd0c-5de0-a119-9a708a167c7a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "- r^{3} \\sin^{3}{\\left(\\theta \\right)} - 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} + 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos^{2}{\\left(\\theta \\right)} + r^{3} \\cos^{3}{\\left(\\theta \\right)}" :db/id #edb/ref 17592186526196} {:answer/id #uuid "fd87050e-7f2f-5d31-83ca-382f859c360b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{r^{3} \\sin^{3}{\\left(\\theta \\right)} + 2 r^{3} \\sin^{2}{\\left(\\theta \\right)} \\cos{\\left(\\theta \\right)} - 2 r^{3} \\sin{\\left(\\theta \\right)} \\cos