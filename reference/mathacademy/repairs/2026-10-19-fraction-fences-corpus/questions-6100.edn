[{:db/id #edb/ref 17592186442426 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e11fc4-d12c-5cf0-80e5-6daf4cf4a726" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{5}" :db/id #edb/ref 17592186442349} {:answer/id #uuid "391380df-0922-5ead-949f-fcac7c10c0bc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{5}{4}" :db/id #edb/ref 17592186442353} {:answer/id #uuid "40cee691-844c-55f0-80f2-f3687fcfd5fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186442355} {:answer/id #uuid "45643fb8-5981-57f8-a565-74c4497b7282" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186442356} {:answer/id #uuid "6bbd766b-35ac-5531-abbe-97f4cd30fe7f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186442369}] :answer-field/correct {:answer/id #uuid "40cee691-844c-55f0-80f2-f3687fcfd5fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{4}" :db/id #edb/ref 17592186442355} :answer-field/id #uuid "1db1209a-a7a4-5bc6-ad0b-b36bc9c2e40e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442409}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3cfaf2ea-e7d3-519a-880f-3892d2b32646" :question/math-academy-id "q-43042" :question/problem "$(-\\frac{5}{3})\\cdot (-\\frac{3}{4})=$" :question/worked-solution "We have a product of two negative numbers, so the product will be positive, and we can drop the minus signs as follows:\n\n$$\n(-\\frac{5}{3})\\cdot (-\\frac{3}{4})=\\frac{5}{3}\\cdot \\frac{3}{4}\n$$\n\nNow, we multiply the fractions by multiplying the numerators and denominators separately:\n\n$$\n\\begin{aligned}\\frac{5}{3}\\cdot \\frac{3}{4} & =\\frac{5\\cdot 3}{3\\cdot 4} \\\\  & =\\frac{5\\cdot \\cancel{3}}{\\cancel{3}\\cdot 4} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442428 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "81324ec4-a2d1-5649-b3ff-74009143c42b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186442375}] :answer-field/correct {:answer/id #uuid "81324ec4-a2d1-5649-b3ff-74009143c42b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186442375} :answer-field/id #uuid "0367452d-3fb5-5cfe-b7ee-467659278ae0" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186442405}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "4c3a1d41-b0b4-56cb-9c22-249c40340608" :question/math-academy-id "q-180905" :question/problem "$(-\\frac{4}{7})\\cdot \\frac{1}{2}=${{field-1}}" :question/worked-solution "We have a product of a negative number and a positive number, so the product will be negative:\n\n$$\n\\begin{aligned}(-\\frac{4}{7})\\cdot (\\frac{1}{2}) & =-(\\frac{4}{7}\\cdot \\frac{1}{2})\\end{aligned}\n$$\n\nNow, we multiply the fractions by multiplying the numerators and denominators separately:\n\n$$\n\\begin{aligned}-(\\frac{4}{7}\\cdot \\frac{1}{2}) & =-(\\frac{4\\cdot 1}{7\\cdot 2}) \\\\  & =-(\\frac{2\\cdot 2\\cdot 1}{7\\cdot 2}) \\\\  & =-(\\frac{2\\cdot \\cancel{2}\\cdot 1}{7\\cdot \\cancel{2}}) \\\\  & =-(\\frac{2}{7}) \\\\  & =-\\frac{2}{7}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442435 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21d706c2-3988-50fc-b1c6-a770497d92fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{28}{15}" :db/id #edb/ref 17592186442348} {:answer/id #uuid "5e95f5b1-b4a5-579f-998b-9d5b23bd331b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{24}" :db/id #edb/ref 17592186442366} {:answer/id #uuid "7b245d68-aba9-5195-8e36-cc227126fee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{12}" :db/id #edb/ref 17592186442373} {:answer/id #uuid "9b487510-ff34-5b5c-9fa0-b7433775f1ac" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{35}{24}" :db/id #edb/ref 17592186442379} {:answer/id #uuid "db017e05-a943-5ca7-b8b6-a2de5063e487" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{7}{4}" :db/id #edb/ref 17592186442397}] :answer-field/correct {:answer/id #uuid "7b245d68-aba9-5195-8e36-cc227126fee5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{35}{12}" :db/id #edb/ref 17592186442373} :answer-field/id #uuid "1d373760-5a89-5b26-bc5e-1afb0e01c86e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442408}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "c193a4aa-2a3b-50a7-9351-eac6230e1fa9" :question/math-academy-id "q-42994" :question/problem "$(-\\frac{7}{3})\\cdot \\frac{5}{4}=$" :question/worked-solution "We have a product of a negative number and a positive number, so the product will be negative:\n\n$$\n(-\\frac{7}{3})\\cdot \\frac{5}{4}=-(\\frac{7}{3}\\cdot \\frac{5}{4})\n$$\n\nNow, we multiply the fractions by multiplying the numerators and denominators separately:\n\n$$\n\\begin{aligned}-(\\frac{7}{3}\\cdot \\frac{5}{4}) & =-(\\frac{7\\cdot 5}{3\\cdot 4}) \\\\  & =-(\\frac{35}{12}) \\\\  & =-\\frac{35}{12}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442479 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "812b461a-180e-543d-b8c3-60aec2c44810" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186442454} {:answer/id #uuid "99e7e82f-77a2-5e4c-b50f-29924bf0f0fb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186442456} {:answer/id #uuid "9c03be65-b878-58d4-b8c0-c80d0b51e294" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186442459} {:answer/id #uuid "bece9adc-021f-5779-a2a6-dc4757a9f75c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186442465} {:answer/id #uuid "f7b8ce6c-3373-5ebe-bc16-7d2a05cfc3b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "e-1" :db/id #edb/ref 17592186442470}] :answer-field/correct {:answer/id #uuid "bece9adc-021f-5779-a2a6-dc4757a9f75c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186442465} :answer-field/id #uuid "1c915c1b-8d9a-5d22-96f6-4f765b2be4a6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442471}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "537e39b9-c554-5e1b-a6dd-8e198218680c" :question/math-academy-id "q-129548" :question/problem "${\\int }_{1}^{e}{\\int }_{0}^{\\pi /4}\\frac{1}{y{cos}^{2}⁡x}\\,\\text{d}x\\,\\text{d}y=$" :question/worked-solution "First, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{1}^{e}[{\\int }_{0}^{\\pi /4}\\frac{1}{y{cos}^{2}⁡x}\\,\\text{d}x]\\text{d}y & ={\\int }_{1}^{e}\\frac{1}{y}[{\\int }_{0}^{\\pi /4}\\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}[{\\int }_{0}^{\\pi /4}{sec}^{2}⁡x\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}[\\operatorname{tan}⁡x]_{0}^{\\pi /4}\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}(\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡0)\\,\\text{d}y \\\\  & ={\\int }_{1}^{e}\\frac{1}{y}\\,\\text{d}y\\end{aligned}\n$$\n\n \n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{1}{y}\\,\\text{d}y & =\\operatorname{ln}⁡|y|{|}_{1}^{e} \\\\  & =\\operatorname{ln}⁡e-\\operatorname{ln}⁡1 \\\\  & =1-0 \\\\  & =1\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442608 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18b10125-03d9-569f-b489-2af1cd51651f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}⟨2,1,-2⟩" :db/id #edb/ref 17592186442566} {:answer/id #uuid "625e5e39-ae98-52ef-bfcc-de3e0bace052" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}⟨\\sqrt{2},1,-1⟩" :db/id #edb/ref 17592186442579} {:answer/id #uuid "e0ec4419-91f6-5d58-9711-3de15ef93020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}⟨0,1,-1⟩" :db/id #edb/ref 17592186442596} {:answer/id #uuid "f33db979-e5fc-564b-9e72-04e2ed505855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}⟨-1,0,-1⟩" :db/id #edb/ref 17592186442598} {:answer/id #uuid "f911a805-3f13-582e-9b9e-8ec61aec91fe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}⟨0,1,\\sqrt{2}⟩" :db/id #edb/ref 17592186442599}] :answer-field/correct {:answer/id #uuid "e0ec4419-91f6-5d58-9711-3de15ef93020" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}⟨0,1,-1⟩" :db/id #edb/ref 17592186442596} :answer-field/id #uuid "be28023f-b4e1-527a-9fd6-a55af9912450" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442607}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "35b2b5dc-be5b-531e-92b7-e1931e890d8a" :question/math-academy-id "q-127596" :question/problem "The unit tangent vector to a curve at an arbitrary point is given by\n\n$$\nT(t)=\\frac{1}{\\sqrt{{e}^{2t}+1}}\\cdot q(t).\n$$\n\nFind the principal normal vector at the point where $t=0,$ if \n\n$$\n\\begin{aligned}q(0)=⟨0,1,1⟩,\\,{q}^{′}(0)=⟨0,1,0⟩.\\end{aligned}\n$$" :question/worked-solution "First, we calculate ${T}^{′}(t)$ and evaluate it at $t=0:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{e}^{2t}+1}}\\cdot q(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{e}^{2t}+1}})\\cdot q(t)+\\frac{1}{\\sqrt{{e}^{2t}+1}}\\cdot \\frac{\\text{d}}{\\text{d}t}(q(t)) \\\\  & =-\\frac{{e}^{2t}}{({e}^{2t}+1)^{3/2}}\\cdot q(t)+\\frac{1}{\\sqrt{{e}^{2t}+1}}\\cdot {q}^{′}(t) \\\\  \\\\ {T}^{′}(0) & =-\\frac{{e}^{0}}{({e}^{0}+1)^{3/2}}\\cdot q(0)+\\frac{1}{\\sqrt{{e}^{0}+1}}\\cdot {q}^{′}(0) \\\\  & =-\\frac{1}{{2}^{3/2}}⟨0,1,1⟩+\\frac{1}{\\sqrt{2}}⟨0,1,0⟩ \\\\  & =\\frac{1}{{2}^{3/2}}(-⟨0,1,1⟩+2⟨0,1,0⟩) \\\\  & =\\frac{1}{{2}^{3/2}}⟨0,1,-1⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(0):$\n\n$$\n\\begin{aligned}‖{T}^{′}(0)‖ & =\\frac{1}{{2}^{3/2}}\\sqrt{{0}^{2}+{1}^{2}+(-1)^{2}} \\\\  & =\\frac{1}{{2}^{3/2}}\\cdot \\sqrt{2} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(0)$ and obtain the principal normal to the curve at the point where $t=0:$\n\n$$\n\\begin{aligned}N(0) & =\\frac{{T}^{′}(0)}{‖{T}^{′}(0)‖} \\\\  & =\\frac{\\frac{1}{{2}^{3/2}}⟨0,1,-1⟩}{(\\frac{1}{2})} \\\\  & =\\frac{1}{\\sqrt{2}}⟨0,1,-1⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=0,$ we get\n\n$$\n\\begin{aligned}T(0)\\cdot N(0) & =\\frac{1}{\\sqrt{2}}q(0)\\cdot \\frac{1}{\\sqrt{2}}⟨0,1,-1⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨0,1,1⟩\\cdot \\frac{1}{\\sqrt{2}}⟨0,1,-1⟩ \\\\  & =\\frac{1}{2}(0(0)+1(1)+1(-1)) \\\\  & =\\frac{1}{2}(1-1) \\\\  & =0.\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442610 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b50b45b-e31f-500e-9496-cc48c7886b21" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨-1,\\,0⟩" :db/id #edb/ref 17592186442574} {:answer/id #uuid "63b699bf-e6d8-5ef0-9f70-0ede7e9e9edb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨1,\\,-1⟩" :db/id #edb/ref 17592186442580} {:answer/id #uuid "a7b0f6c4-1c16-5380-8c5e-e758a32ebbc5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{5}}{5}⟨-2,\\,1⟩" :db/id #edb/ref 17592186442587} {:answer/id #uuid "b10046fc-c183-59e3-ae38-7e794395db17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨-1,\\,1⟩" :db/id #edb/ref 17592186442591} {:answer/id #uuid "f08e5f05-4e3e-5da4-b635-cb93796cbc71" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,\\,1⟩" :db/id #edb/ref 17592186442597}] :answer-field/correct {:answer/id #uuid "63b699bf-e6d8-5ef0-9f70-0ede7e9e9edb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨1,\\,-1⟩" :db/id #edb/ref 17592186442580} :answer-field/id #uuid "9023e46d-1d99-5286-baf3-0582b7f8b0a3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442605}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "7057aab9-4ddf-5b3b-9e59-0a11a291512b" :question/math-academy-id "q-74850" :question/problem "The equations of a curve $r(t)$ and its corresponding unit tangent vector $T(t)$ at an arbitrary point are given below. Find the principal normal vector to that curve at the point $P(\\sqrt{2}\\,,\\,\\operatorname{ln}⁡(\\sqrt{2}+1)).$\n\n$$\n\\begin{aligned}r(t) & =⟨\\sqrt{{t}^{2}+1}\\,,\\,\\operatorname{ln}⁡(\\sqrt{{t}^{2}+1}+t)⟩,\\,t\\ge 0 \\\\ T(t) & =\\frac{1}{\\sqrt{{t}^{2}+1}}⟨t,\\,1⟩,\\,t\\ge 0\\end{aligned}\n$$" :question/worked-solution "First, we find the value of $t$ that corresponds to the point $P(\\sqrt{2}\\,,\\,\\operatorname{ln}⁡(\\sqrt{2}+1))$ on the given curve. We know that:\n\n$$\n\\begin{aligned}r(t) & =⟨\\sqrt{2}\\,,\\,\\operatorname{ln}⁡(\\sqrt{2}+1)⟩ \\\\ ⟨\\sqrt{{t}^{2}+1}\\,,\\,\\operatorname{ln}⁡(\\sqrt{{t}^{2}+1}+t)⟩ & =⟨\\sqrt{2}\\,,\\,\\operatorname{ln}⁡(\\sqrt{2}+1)⟩\\end{aligned}\n$$\n\nEquating the coefficients gives:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}\\sqrt{{t}^{2}+1} &=\\sqrt{2} \\\\ \\operatorname{ln}⁡(\\sqrt{{t}^{2}+1}+t) &=\\operatorname{ln}⁡(\\sqrt{2}+1)\\end{aligned}\\right.\\end{aligned}\n$$\n\nFrom the first equality, $t=1.$ This value also satisfies the other equation. Therefore, $P(\\sqrt{2}\\,,\\,\\operatorname{ln}⁡(\\sqrt{2}+1))$ is at the tip of the vector $r(1).$ \n\nNow, we calculate ${T}^{′}(t)$ and evaluate it at $t=1:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+1}}⟨t,\\,1⟩) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+1}})⟨t,\\,1⟩+\\frac{1}{\\sqrt{{t}^{2}+1}}⟨\\frac{\\text{d}}{\\text{d}t}(t),\\frac{\\text{d}}{\\text{d}t}(1)⟩ \\\\  & =-\\frac{t}{({t}^{2}+1)^{3/2}}⟨t,\\,1⟩+\\frac{1}{\\sqrt{{t}^{2}+1}}⟨1,\\,0⟩ \\\\  & =\\frac{1}{({t}^{2}+1)^{3/2}}[-⟨{t}^{2},\\,t⟩+({t}^{2}+1)\\cdot ⟨1,\\,0⟩] \\\\  & =\\frac{1}{({t}^{2}+1)^{3/2}}⟨1,\\,-t⟩ \\\\  \\\\ {T}^{′}(1) & =\\frac{1}{({1}^{2}+1)^{3/2}}⟨1,\\,-1⟩ \\\\  & =\\frac{1}{2\\sqrt{2}}⟨1,\\,-1⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(1):$\n\n$$\n\\begin{aligned}‖{T}^{′}(1)‖ & =\\frac{1}{2\\sqrt{2}}‖⟨1,\\,-1⟩‖ \\\\  & =\\frac{1}{2\\sqrt{2}}\\sqrt{{1}^{2}+(-1)^{2}} \\\\  & =\\frac{\\sqrt{2}}{2\\sqrt{2}} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(1)$ and obtain the principal normal vector to the curve at the point where $t=1:$\n\n$$\n\\begin{aligned}N(1) & =\\frac{{T}^{′}(1)}{‖{T}^{′}(1)‖} \\\\  & =\\frac{\\frac{1}{2\\sqrt{2}}⟨1,\\,-1⟩}{(\\frac{1}{2})} \\\\  & =\\frac{1}{\\sqrt{2}}⟨1,\\,-1⟩ \\\\  & =\\frac{\\sqrt{2}}{2}⟨1,\\,-1⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=1,$ we get\n\n$$\n\\begin{aligned}T(1)\\cdot N(1) & =\\frac{1}{\\sqrt{2}}⟨1,\\,1⟩\\cdot \\frac{\\sqrt{2}}{2}⟨1,\\,-1⟩ \\\\  & =\\frac{1}{2}⟨1,\\,1⟩\\cdot ⟨1,\\,-1⟩ \\\\  & =\\frac{1}{2}(1-1) \\\\  & =0.\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442611 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00435226-3a19-5eb9-bdc3-0cc889991ef8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}⟨-2,-1,1⟩" :db/id #edb/ref 17592186442563} {:answer/id #uuid "496f3c19-e7a7-5744-b55a-b824329dc81c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}⟨-2,-1,2⟩" :db/id #edb/ref 17592186442573} {:answer/id #uuid "6f1effa6-46d0-5a74-afd6-d9566c6fab86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{6}}⟨-3,-\\sqrt{6},3⟩" :db/id #edb/ref 17592186442581} {:answer/id #uuid "a7c6b0e9-05cf-5400-9c8e-e91ea5905657" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{10}}⟨-3,0,1⟩" :db/id #edb/ref 17592186442588} {:answer/id #uuid "a9a90765-83c0-5ed9-bd70-667b33af249d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{7}}⟨-\\sqrt{6},1,0⟩" :db/id #edb/ref 17592186442590}] :answer-field/correct {:answer/id #uuid "6f1effa6-46d0-5a74-afd6-d9566c6fab86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{6}}⟨-3,-\\sqrt{6},3⟩" :db/id #edb/ref 17592186442581} :answer-field/id #uuid "2dcaf563-74bd-51e5-bbaf-671c2387e005" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "86bd8ee0-d1c5-5e4f-9534-8a4e93bb860c" :question/math-academy-id "q-127597" :question/problem "The unit tangent vector to a curve at an arbitrary point is given by\n\n$$\nT(t)=\\frac{1}{1+3{t}^{2}}\\cdot q(t).\n$$\n\nFind the principal normal vector at the point where $t=1,$ if \n\n$$\n\\begin{aligned}q(1)=⟨1,\\sqrt{6},3⟩,\\,{q}^{′}(1)=⟨0,\\sqrt{6},6⟩.\\end{aligned}\n$$" :question/worked-solution "First, we calculate ${T}^{′}(t)$ and evaluate it at $t=1:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{1+3{t}^{2}}\\cdot q(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{1+3{t}^{2}})\\cdot q(t)+\\frac{1}{1+3{t}^{2}}\\cdot \\frac{\\text{d}}{\\text{d}t}(q(t)) \\\\  & =-\\frac{6t}{{(1+3{t}^{2})}^{2}}\\cdot q(t)+\\frac{1}{1+3{t}^{2}}\\cdot {q}^{′}(t) \\\\  \\\\ {T}^{′}(1) & =-\\frac{6(1)}{{(1+3(1)^{2})}^{2}}\\cdot q(1)+\\frac{1}{1+3(1)^{2}}\\cdot {q}^{′}(1) \\\\  & =-\\frac{3}{8}⟨1,\\sqrt{6},3⟩+\\frac{1}{4}⟨0,\\sqrt{6},6⟩ \\\\  & =\\frac{1}{8}(-3⟨1,\\sqrt{6},3⟩+2⟨0,\\sqrt{6},6⟩) \\\\  & =\\frac{1}{8}⟨-3,-\\sqrt{6},3⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(1):$\n\n$$\n\\begin{aligned}‖{T}^{′}(1)‖ & =\\frac{1}{8}\\sqrt{(-3)^{2}+(-\\sqrt{6})^{2}+{3}^{2}} \\\\  & =\\frac{1}{8}\\sqrt{24} \\\\  & =\\frac{\\sqrt{6}}{4}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(1)$ and obtain the principal normal to the curve at the point where $t=1:$\n\n$$\n\\begin{aligned}N(0) & =\\frac{{T}^{′}(1)}{‖{T}^{′}(1)‖} \\\\  & =\\frac{\\frac{1}{8}⟨-3,-\\sqrt{6},3⟩}{(\\frac{\\sqrt{6}}{4})} \\\\  & =\\frac{1}{2\\sqrt{6}}⟨-3,-\\sqrt{6},3⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=1,$ we get\n\n$$\n\\begin{aligned}T(1)\\cdot N(1) & =\\frac{1}{4}q(1)\\cdot \\frac{1}{2\\sqrt{6}}⟨-3,-\\sqrt{6},3⟩ \\\\  & =\\frac{1}{4}⟨1,\\sqrt{6},3⟩\\cdot \\frac{1}{2\\sqrt{6}}⟨-3,-\\sqrt{6},3⟩ \\\\  & =\\frac{1}{8\\sqrt{6}}(1\\cdot (-3)+\\sqrt{6}\\cdot (-\\sqrt{6})+3\\cdot 3) \\\\  & =\\frac{1}{8\\sqrt{6}}(-3-6+9) \\\\  & =0.\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442612 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "09429f0b-5a31-576e-b53c-7a9c9089a259" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨1,1⟩" :db/id #edb/ref 17592186442565} {:answer/id #uuid "4df4322e-2ca8-59b0-b25f-d74e9d345855" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨0,-1⟩" :db/id #edb/ref 17592186442575} {:answer/id #uuid "512116d3-97dd-54be-bc16-10567d150eb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{10}⟨1,3⟩" :db/id #edb/ref 17592186442576} {:answer/id #uuid "54e8dd13-f4d3-59cf-aea8-647ea53c3240" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}⟨1,-1⟩" :db/id #edb/ref 17592186442578} {:answer/id #uuid "9b75c8af-bc89-5538-be8b-284dd95d1b81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0⟩" :db/id #edb/ref 17592186442586}] :answer-field/correct {:answer/id #uuid "9b75c8af-bc89-5538-be8b-284dd95d1b81" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "⟨1,0⟩" :db/id #edb/ref 17592186442586} :answer-field/id #uuid "6e89c597-7b48-520a-9aa5-d249aa23a780" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442604}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bc713dbc-3c1f-5a9c-8a2b-b4377300bc92" :question/math-academy-id "q-75410" :question/problem "The unit tangent vector to a curve at an arbitrary point is given by\n\n$$\nT(t)=\\frac{1}{\\sqrt{{t}^{2}+9}}\\cdot q(t).\n$$\n\nFind the principal normal vector at the point where $t=0,$ if \n\n$$\n\\begin{aligned}q(0)=⟨0,3⟩,\\,{q}^{′}(0)=⟨1,0⟩.\\end{aligned}\n$$" :question/worked-solution "First, we calculate ${T}^{′}(t)$ and evaluate it at $t=0:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+9}}\\cdot q(t)) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+9}})\\cdot q(t)+\\frac{1}{\\sqrt{{t}^{2}+9}}\\cdot \\frac{\\text{d}}{\\text{d}t}(q(t)) \\\\  & =-\\frac{t}{({t}^{2}+9)\\sqrt{{t}^{2}+9}}\\cdot q(t)+\\frac{1}{\\sqrt{{t}^{2}+9}}\\cdot {q}^{′}(t) \\\\  \\\\ {T}^{′}(0) & =-\\frac{0}{({0}^{2}+9)\\sqrt{{0}^{2}+9}}\\cdot q(0)+\\frac{1}{\\sqrt{{0}^{2}+9}}\\cdot {q}^{′}(0) \\\\  & =\\frac{1}{3}⟨1,0⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(0):$\n\n$$\n\\begin{aligned}‖{T}^{′}(0)‖ & =\\frac{1}{3}\\sqrt{{1}^{2}+{0}^{2}}=\\frac{1}{3}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(0)$ and obtain the principal normal to the curve at the point where $t=0:$\n\n$$\n\\begin{aligned}N(0) & =\\frac{{T}^{′}(0)}{‖{T}^{′}(0)‖} \\\\  & =\\frac{\\frac{1}{3}⟨1,0⟩}{(\\frac{1}{3})} \\\\  & =⟨1,0⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=0,$ we get\n\n$$\n\\begin{aligned}T(0)\\cdot N(0) & =\\frac{1}{3}q(0)\\cdot ⟨1,0⟩ \\\\  & =\\frac{1}{3}⟨0,3⟩\\cdot ⟨1,0⟩ \\\\  & =\\frac{1}{3}(0\\cdot 1+3\\cdot 0) \\\\  & =\\frac{1}{3}(0+0) \\\\  & =0.\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442613 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02e39ea1-4cba-57a5-ab90-7a89782cb8d0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}⟨-1,\\sqrt{2}⟩" :db/id #edb/ref 17592186442564} {:answer/id #uuid "34323a95-3364-5d8b-ae6b-9b380e0bf2c9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}⟨-1,1⟩" :db/id #edb/ref 17592186442569} {:answer/id #uuid "37ad2308-55f9-592a-86af-f156397fae09" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{3}}⟨-\\sqrt{2},-1⟩" :db/id #edb/ref 17592186442570} {:answer/id #uuid "77fd4f80-1bca-57c5-b06d-9f6931a1ae23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}⟨2,1⟩" :db/id #edb/ref 17592186442582} {:answer/id #uuid "b691e5f8-bc54-56bd-ba8e-fb29b5a7d2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}⟨-1,2⟩" :db/id #edb/ref 17592186442593}] :answer-field/correct {:answer/id #uuid "b691e5f8-bc54-56bd-ba8e-fb29b5a7d2f8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{5}}⟨-1,2⟩" :db/id #edb/ref 17592186442593} :answer-field/id #uuid "1b8a9865-39bf-545e-aeef-35a531125f5f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442602}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "f08885d9-557e-5e55-b967-a7cb452a9e2a" :question/math-academy-id "q-127379" :question/problem "The equations of a curve $r(t)$ and its corresponding unit tangent vector $T(t)$ at an arbitrary point are given below. Find the principal normal vector to that curve at the point $P(2,\\frac{1}{2}).$\n\n$$\n\\begin{aligned}r(t) & =⟨2t,\\,\\frac{{t}^{2}}{2}⟩,\\,t\\in (-\\infty ,\\infty ) \\\\ T(t) & =\\frac{1}{\\sqrt{{t}^{2}+4}}⟨2,\\,t⟩,\\,t\\in (-\\infty ,\\infty )\\end{aligned}\n$$" :question/worked-solution "First, we find the value of $t$ that corresponds to the point $P(2,\\frac{1}{2})$ on the given curve. We know that:\n\n$$\n\\begin{aligned}r(t) & =⟨2,\\frac{1}{2}⟩ \\\\ ⟨2t,\\,\\frac{{t}^{2}}{2}⟩ & =⟨2,\\frac{1}{2}⟩\\end{aligned}\n$$\n\nEquating the coefficients gives:\n\n$$\n\\begin{aligned}\\left\\{\\begin{aligned}2t &=2 \\\\ \\frac{{t}^{2}}{2} &=\\frac{1}{2}\\end{aligned}\\right.\\end{aligned}\n$$\n\nFrom the first equality, $t=1.$ This value also satisfies the other equation. Therefore, $P(2,\\frac{1}{2})$ is at the tip of the vector $r(1).$ \n\nNow, we calculate ${T}^{′}(t)$ and evaluate it at $t=1:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+4}}⟨2,\\,t⟩) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{{t}^{2}+4}})⟨2,\\,t⟩+\\frac{1}{\\sqrt{{t}^{2}+4}}\\frac{\\text{d}}{\\text{d}t}(⟨2,\\,t⟩) \\\\  & =-\\frac{t}{{({t}^{2}+4)}^{3/2}}⟨2,\\,t⟩+\\frac{1}{\\sqrt{{t}^{2}+4}}⟨0,1⟩ \\\\  & =\\frac{1}{{({t}^{2}+4)}^{3/2}}(-t⟨2,t⟩+({t}^{2}+4)⟨0,1⟩) \\\\  & =\\frac{1}{{({t}^{2}+4)}^{3/2}}⟨-2t,\\,4⟩ \\\\  \\\\ {T}^{′}(1) & =\\frac{1}{{((1)^{2}+4)}^{3/2}}⟨-2(1),\\,4⟩ \\\\  & =\\frac{1}{{5}^{3/2}}⟨-2,\\,4⟩ \\\\  & =\\frac{2}{5\\sqrt{5}}⟨-1,2⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(1):$\n\n$$\n\\begin{aligned}‖{T}^{′}(1)‖ & =\\frac{2}{5\\sqrt{5}}‖⟨-1,2⟩‖ \\\\  & =\\frac{2}{5\\sqrt{5}}\\sqrt{(-1)^{2}+(2)^{2}} \\\\  & =\\frac{2}{5}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(1)$ and obtain the principal normal vector to the curve at the point where $t=1:$\n\n$$\n\\begin{aligned}N(1) & =\\frac{{T}^{′}(1)}{‖{T}^{′}(1)‖} \\\\  & =\\frac{\\frac{2}{5\\sqrt{5}}⟨-1,2⟩}{(\\frac{2}{5})} \\\\  & =\\frac{1}{\\sqrt{5}}⟨-1,2⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where $t=1,$ we get\n\n$$\n\\begin{aligned}T(1)\\cdot N(1) & =\\frac{1}{\\sqrt{5}}⟨2,1⟩\\cdot \\frac{1}{\\sqrt{5}}⟨-1,2⟩ \\\\  & =\\frac{1}{5}(⟨2,1⟩\\cdot ⟨-1,2⟩) \\\\  & =\\frac{1}{5}(2(-1)+1(2)) \\\\  & =0.\\,✓\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442760 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d20667f-50b2-55b0-95fa-20f52b560b36" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "None of the statements are true" :db/id #edb/ref 17592186442747} {:answer/id #uuid "9d738677-4b48-5272-ba62-6f070fe8babb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186442751} {:answer/id #uuid "a8188bf8-8b54-575b-933a-aa859ce24d7c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186442752} {:answer/id #uuid "d5079a63-2c21-5532-8a24-134a5b4af955" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186442753} {:answer/id #uuid "de7d22b9-d57c-5d7b-88cb-f0b4ca5f4a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186442755}] :answer-field/correct {:answer/id #uuid "de7d22b9-d57c-5d7b-88cb-f0b4ca5f4a5d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186442755} :answer-field/id #uuid "8cd74140-69a0-5af3-8672-f40c3db56533" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442757}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "6caf644a-b965-5b35-b048-eee4060c43c4" :question/math-academy-id "q-161034" :question/problem "![](images/b3/b3bef2dbb84cfe3a2881abf8f61761f98ea0d9cf4a07ea582355c57d375f975d.png)\n\nConsider the square region $Δ$ in the $uv$-plane, given by\n\n$$\nΔ=\\{(u,v)\\,:\\,3\\le u\\le 6,\\,\\,\\frac{3\\pi }{2}\\le v\\le \\frac{7\\pi }{4}\\},\n$$\n\nand the transformation $T,$ given by\n\n$$\nT:(u,v)\\to (u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v).\n$$\n\nThe image of the top side of $Δ$ under the action of $T$ is a line segment. Which of the following statements are true regarding the image?\n\nI. The image makes the angle of $\\frac{3\\pi }{2}$ with the positive $x$-axis.\n\nII. The image makes the angle of $\\frac{7\\pi }{4}$ with the positive $x$-axis.\n\nIII. The endpoints of the image lie on the circles of radii $3$ and $6$ centered at $O.$" :question/worked-solution "To map the entire region $Δ$ onto the $xy$-plane, we consider the transformation of each side. However, in this case, we consider only the top side.\n\nFor the top side, we have $v=\\frac{7\\pi }{4}$ and $3\\le u\\le 6.$ \n\nSubstituting $v=\\frac{7\\pi }{4}$ into our transformation equations, we obtain\n\n$$\n\\begin{aligned}(x,y) & =T(u,v) \\\\  & =(u\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v) \\\\  & =(u\\operatorname{cos}⁡(\\frac{7\\pi }{4}),\\,u\\operatorname{sin}⁡(\\frac{7\\pi }{4})),\\,3\\le u\\le 6.\\end{aligned}\n$$\n\nThis is a parametric equation of the line segment shown below.\n\n![](images/b9/b976e62862ba82dfd89ff28627239dd5b5d1be1144e257223c091f29a5729f89.png)\n\n \n\nNote that the line that this segment lies on passes through the origin. \n\nWith that in mind, let's examine our statements.\n\n- Statement I is false, while statement II is true. The slope of the line is\n\n$$\nk=\\frac{\\operatorname{sin}⁡(\\frac{7\\pi }{4})}{\\operatorname{cos}⁡(\\frac{7\\pi }{4})}=\\operatorname{tan}⁡(\\frac{7\\pi }{4}).\n$$\n\nAs a result, our line makes an angle of $\\frac{7\\pi }{4}$ radians with the positive $x$-axis.\n\n- Statement III is true.\n\n- When $u=3,$ we obtain the point \n$(3\\operatorname{cos}⁡(\\frac{7\\pi }{4}),\\,3\\operatorname{sin}⁡(\\frac{7\\pi }{4})),$\nwhose distance to the origin is $3.$\n\n- When $u=6,$ we obtain the point \n$(6\\operatorname{cos}⁡(\\frac{7\\pi }{4}),\\,6\\operatorname{sin}⁡(\\frac{7\\pi }{4})),$\nwhose distance to the origin is $6.$\n\nSo, the endpoints of the line segment lie on the circles of radii $3$ and $6.$\n\nTherefore, the correct answer is \"II and III only.\""} {:db/id #edb/ref 17592186442800 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "572e0214-e8cf-5d31-97a8-af4af5bb7ef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}-3 \\\\ -1 \\\\ -10\\end{bmatrix},\\begin{bmatrix}0 \\\\ 10 \\\\ 2\\end{bmatrix}\\}" :db/id #edb/ref 17592186442775} {:answer/id #uuid "caf351c8-dc27-5048-8439-3fd32f3cb562" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}0 \\\\ 10 \\\\ 2\\end{bmatrix}\\}" :db/id #edb/ref 17592186442785} {:answer/id #uuid "cee0af27-d726-504b-bcd1-86fab0b3c8e9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}-3 \\\\ -1 \\\\ -10\\end{bmatrix}\\}" :db/id #edb/ref 17592186442786} {:answer/id #uuid "f9852838-fe42-569f-8030-232d78549153" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ 4\\end{bmatrix}\\}" :db/id #edb/ref 17592186442793} {:answer/id #uuid "fa6885be-0814-5964-ae0d-0adf9dc4e3fc" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}0 \\\\ 10 \\\\ 2\\end{bmatrix}\\}" :db/id #edb/ref 17592186442794}] :answer-field/correct {:answer/id #uuid "572e0214-e8cf-5d31-97a8-af4af5bb7ef5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "B=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}-3 \\\\ -1 \\\\ -10\\end{bmatrix},\\begin{bmatrix}0 \\\\ 10 \\\\ 2\\end{bmatrix}\\}" :db/id #edb/ref 17592186442775} :answer-field/id #uuid "8e69b668-22c4-51e6-b6db-1d75a53a9f3c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442796}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "826a5640-8f36-5e06-a060-8061b74d91af" :question/math-academy-id "q-75072" :question/problem "Consider the matrix \n$T=\\begin{bmatrix}1 & -3 & 0 \\\\ 2 & -1 & 10 \\\\ 4 & -10 & 2\\end{bmatrix}.$ Find a basis $B$ of $\\text{Col}(T).$" :question/worked-solution "In order to find a basis of $\\text{Col}(T),$ we reduce the matrix $T$ to row echelon form:\n\n$$\n\\begin{aligned}T & =\\begin{bmatrix}1 & -3 & 0 \\\\ 2 & -1 & 10 \\\\ 4 & -10 & 2\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 4 & -10 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 0 & 2 & 2\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-\\frac{2}{5}){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -3 & 0 \\\\ 0 & 5 & 10 \\\\ 0 & 0 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nThe pivot columns correspond to linearly independent vectors, while the non-pivot columns correspond to linearly dependent vectors that can be removed. Here, the $1$st, $2$nd and $3$rd columns are pivot columns.\n\nRemember that we need to pick the pivot columns from the *original matrix*, not from the reduced one. \n\nThe $1$st, $2$nd and $3$rd columns from the original matrix are ${t}_{1},$ ${t}_{2}$ and ${t}_{3}.$ So, a basis of $\\text{Col}(T)$ is $\\{{t}_{1},{t}_{2},{t}_{3}\\},$ that is to say, \n\n$$\nB=\\{\\begin{bmatrix}1 \\\\ 2 \\\\ 4\\end{bmatrix},\\begin{bmatrix}-3 \\\\ -1 \\\\ -10\\end{bmatrix},\\begin{bmatrix}0 \\\\ 10 \\\\ 2\\end{bmatrix}\\}.\n$$"} {:db/id #edb/ref 17592186442802 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e9cd8e0-a7ea-505f-a45a-9be34d920212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B=\\{{h}_{1},{h}_{3}\\}$ is not a basis of $\\text{Col}(H)$" :db/id #edb/ref 17592186442770} {:answer/id #uuid "71e6a5d4-18a8-5568-b05a-36719e527e28" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186442778} {:answer/id #uuid "b9c9eafc-4807-5e80-867d-9b5b4c2e0cfe" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186442783} {:answer/id #uuid "c0d8a778-cf1d-59df-817d-a34a0002be31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186442784} {:answer/id #uuid "f686acfa-9746-5a20-bf3e-023e43864c6c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186442792}] :answer-field/correct {:answer/id #uuid "1e9cd8e0-a7ea-505f-a45a-9be34d920212" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$B=\\{{h}_{1},{h}_{3}\\}$ is not a basis of $\\text{Col}(H)$" :db/id #edb/ref 17592186442770} :answer-field/id #uuid "76a55157-0914-5ee2-a4a2-75a5bb2d9bc0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442795}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "fb8ab0b6-52ad-56fe-b865-4fa731f7308c" :question/math-academy-id "q-111511" :question/problem "The matrix $H$ is given below. Let ${h}_{1}$, ${h}_{2}$,  ${h}_{3}$ and ${h}_{4}$ be the respective columns of $H.$\nDetermine if $B=\\text{{}{h}_{1},{h}_{3}\\text{}}$ is a basis of $\\text{Col}(H).$ \nIf that is the case, find ${x}_{1}\\cdot {x}_{3}$, where ${h}_{4}={x}_{1}{h}_{1}+{x}_{3}{h}_{3}.$ \n\n$$\nH=\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 2 & -6 & 0 & -6 \\\\ -7 & 18 & -3 & 13\\end{bmatrix}\n$$" :question/worked-solution "First, we reduce the matrix $H$ to reduced row echelon form (RREF):\n\n$$\n\\begin{aligned}H & =\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 2 & -6 & 0 & -6 \\\\ -7 & 18 & -3 & 13\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & -2 & -2 & -6 \\\\ -7 & 18 & -3 & 13\\end{bmatrix} & {R}_{3} & :={R}_{3}+7{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & -2 & -2 & -6 \\\\ 0 & 4 & 4 & 13\\end{bmatrix} & {R}_{3} & :=(-\\frac{1}{2}){R}_{3} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 4 & 4 & 13\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-4){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 1 & 0 \\\\ 0 & 1 & 1 & 3 \\\\ 0 & 0 & 0 & 1\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we see that the pivot columns are the $1$st, $2$nd, and $4$th columns. So, a basis of $\\text{Col}(H)$ is $\\{{h}_{1},{h}_{2},{h}_{4}\\}.$ \n\nTherefore, we conclude that $B=\\{{h}_{1},{h}_{3}\\}$ is not a basis of $\\text{Col}(H).$"} {:db/id #edb/ref 17592186442810 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3529dcc2-d908-58eb-8e99-7d1d828d18b3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186442804} {:answer/id #uuid "387b9ac5-2487-5c7a-a0c7-85adba10d944" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186442805} {:answer/id #uuid "af55c525-fcb4-5409-9a04-32dc1d2a0e2e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186442806} {:answer/id #uuid "bf0166a7-27f9-57f1-b2b0-ed7ed1491514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186442807} {:answer/id #uuid "c403d147-73fe-5fb4-8186-c08fd069f494" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}" :db/id #edb/ref 17592186442808}] :answer-field/correct {:answer/id #uuid "bf0166a7-27f9-57f1-b2b0-ed7ed1491514" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186442807} :answer-field/id #uuid "b927eac4-98a6-5bd4-97b1-9da46ea6a1a1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442809}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "71405c00-ca6f-5d4e-8940-325d2e48014e" :question/math-academy-id "q-40841" :question/problem "$$\n\\overbrace{\\begin{bmatrix}1 & 3 \\\\ 1 & 0 \\\\ 1 & 3\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}{q}_{11} & {q}_{12} \\\\ {q}_{21} & {q}_{22} \\\\ {q}_{31} & {q}_{32}\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}{r}_{11} & {r}_{12} \\\\ 0 & {r}_{22}\\end{bmatrix}}^{R}.\n$$\n\nConsider the QR factorization of the matrix $A$ shown above. Given that the columns ${q}_{1},{q}_{2}$ of $Q$ were obtained from the columns of $A$ using the Gram-Schmidt process, find  the value of ${q}_{32}\\cdot {r}_{12}.$" :question/worked-solution "Let ${a}_{1},{a}_{2}$ be the columns of $A.$\n\nFirst, we find an orthonormal basis of $\\text{Col}(A)=\\text{Span}\\{{a}_{1},{a}_{2}\\}$ using the Gram-Schmidt process.\n\n**Step 1**. We set ${v}_{1}={a}_{1}=\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix}.$\n\n**Step 2**. We find the vector ${v}_{2}$ orthogonal to $\\text{Span}\\{{v}_{1}\\}$ using the formula\n\n$$\n\\begin{aligned}{v}_{2} & ={a}_{2}-{\\text{proj}}_{{v}_{1}}{a}_{2} \\\\  & ={a}_{2}-\\frac{{a}_{2}\\cdot {v}_{1}}{{v}_{1}\\cdot {v}_{1}}{v}_{1} \\\\  & =\\begin{bmatrix}3 \\\\ 0 \\\\ 3\\end{bmatrix}-\\frac{6}{3}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 \\\\ 0 \\\\ 3\\end{bmatrix}-2\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nNext, we normalize ${v}_{1}$ and ${v}_{2}:$\n\n$$\n\\begin{aligned}{q}_{1} & =\\frac{{v}_{1}}{‖{v}_{1}‖}=\\frac{1}{\\sqrt{3}}\\begin{bmatrix}1 \\\\ 1 \\\\ 1\\end{bmatrix} \\\\ {q}_{2} & =\\frac{{v}_{2}}{‖{v}_{2}‖}=\\frac{1}{\\sqrt{6}}\\begin{bmatrix}1 \\\\ -2 \\\\ 1\\end{bmatrix}\\end{aligned}\n$$\n\nNext, we compute $R:$\n\n$$\n\\begin{aligned}R & ={Q}^{T}A \\\\  & =\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{3}} \\\\ \\frac{1}{\\sqrt{6}} & -\\frac{2}{\\sqrt{6}} & \\frac{1}{\\sqrt{6}}\\end{bmatrix}\\begin{bmatrix}1 & 3 \\\\ 1 & 0 \\\\ 1 & 3\\end{bmatrix} \\\\  & =\\begin{bmatrix}\\sqrt{3} & 2\\sqrt{3} \\\\ 0 & \\sqrt{6}\\end{bmatrix}.\\end{aligned}\n$$\n\nTherefore, we obtain the following QR factorization of $A:$\n\n$$\n\\overbrace{\\begin{bmatrix}1 & 3 \\\\ 1 & 0 \\\\ 1 & 3\\end{bmatrix}}^{A}=\\overbrace{\\begin{bmatrix}\\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & -\\frac{2}{\\sqrt{6}} \\\\ \\frac{1}{\\sqrt{3}} & \\frac{1}{\\sqrt{6}}\\end{bmatrix}}^{Q}\\overbrace{\\begin{bmatrix}\\sqrt{3} & 2\\sqrt{3} \\\\ 0 & \\sqrt{6}\\end{bmatrix}}^{R}.\n$$\n\nFinally, ${q}_{32}\\cdot {r}_{12}=(\\frac{1}{\\sqrt{6}})\\cdot (2\\sqrt{3})=\\sqrt{2}.$"} {:db/id #edb/ref 17592186442841 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08fdcd7a-935f-5b89-954e-94cfe53551b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186442818} {:answer/id #uuid "4ec31d2e-690a-53af-8152-9fa7d7a9b34e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186442823} {:answer/id #uuid "6af5ae31-0114-5767-80ce-a1faf0e59131" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186442826} {:answer/id #uuid "d09b5346-0b32-599f-8cfd-4d40bae72ade" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186442835} {:answer/id #uuid "f43ab765-767d-579c-9eae-df2ab5f23f1f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186442836}] :answer-field/correct {:answer/id #uuid "08fdcd7a-935f-5b89-954e-94cfe53551b5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186442818} :answer-field/id #uuid "381abdbc-0501-57da-9b23-4cb39840288c" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442837}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc4b9d8-5da7-5586-a518-10322d637373" :question/math-academy-id "q-132362" :question/problem "Given that $X∼\\text{Exp}(\\frac{\\sqrt{2}}{2}),$ what is $\\text{Var}[X]?$" :question/worked-solution "If $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{Var}[X]=\\frac{1}{{\\lambda }^{2}}.\n$$\n\nTherefore, for our random variable $X∼\\text{Exp}(\\frac{\\sqrt{2}}{2}),$ we have the following variance:\n\n$$\n\\begin{aligned}\\text{Var}[X] & =\\frac{1}{{(\\frac{\\sqrt{2}}{2})}^{2}} \\\\  & =\\frac{1}{(\\frac{1}{2})} \\\\  & =2\\end{aligned}\n$$"} {:db/id #edb/ref 17592186442844 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13aa5558-5072-53e7-bd58-cf7c7ba5a133" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$15$ seconds" :db/id #edb/ref 17592186442819} {:answer/id #uuid "33219482-ef34-597b-b10a-a5cf5d960dda" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$1$ minute" :db/id #edb/ref 17592186442822} {:answer/id #uuid "530f6bf8-4fcb-5c94-9cee-6007d643f0f6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$4$ minutes" :db/id #edb/ref 17592186442824} {:answer/id #uuid "8acfbc95-a05b-5d37-8140-8a62e5da7a2a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$30$ seconds" :db/id #edb/ref 17592186442828} {:answer/id #uuid "d06dab70-fbd9-57eb-9947-fb23ab39c34e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ minutes" :db/id #edb/ref 17592186442834}] :answer-field/correct {:answer/id #uuid "d06dab70-fbd9-57eb-9947-fb23ab39c34e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$2$ minutes" :db/id #edb/ref 17592186442834} :answer-field/id #uuid "e7049d2d-fc9f-5f20-8e5c-02896d997034" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186442840}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "bbd9b202-0edb-5252-b84c-96bc38834bd7" :question/math-academy-id "q-132627" :question/problem "The time $X,$ in minutes, between two visitors entering a restaurant can be modeled as an exponential random variable $X∼\\text{Exp}(\\frac{1}{2}).$ If a visitor has just entered the restaurant, what is the average time until the next visitor enters?" :question/worked-solution "Recall that if $X∼\\text{Exp}(\\lambda )$ is an exponential random variable, then\n\n$$\n\\text{E}[X]=\\frac{1}{\\lambda }.\n$$\n\nWe're given that $X∼\\text{Exp}(\\frac{1}{2}).$ Therefore, $\\lambda =\\frac{1}{2},$ and\n\n$$\n\\text{E}[X]=\\frac{1}{(\\frac{1}{2})}\\,\\text{min}=2\\,\\text{min}.\n$$\n\nTherefore, the average time until the next visitor is $2$ minutes."} {:db/id #edb/ref 17592186443072 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b76b398-afd9-5b3e-bcd8-3169a6052f1e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186442997} {:answer/id #uui