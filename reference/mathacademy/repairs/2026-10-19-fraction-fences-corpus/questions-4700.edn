ype/math} :answer/value "\\frac{2x\\,\\text{d}x}{{x}^{2}+y+{z}^{3}}+\\frac{\\text{d}y}{{x}^{2}+y+{z}^{3}}+\\frac{3{z}^{2}\\,\\text{d}z}{{x}^{2}+y+{z}^{3}}" :db/id #edb/ref 17592186347454}] :answer-field/correct {:answer/id #uuid "ee21595b-210e-5e7b-884a-9841287cbccd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2x\\,\\text{d}x}{{x}^{2}+y+{z}^{3}}+\\frac{\\text{d}y}{{x}^{2}+y+{z}^{3}}+\\frac{3{z}^{2}\\,\\text{d}z}{{x}^{2}+y+{z}^{3}}" :db/id #edb/ref 17592186347454} :answer-field/id #uuid "dd8b4074-6941-5cda-be03-7a1459620be4" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347994}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "a08547f7-2388-51c6-b26c-7a79df9eb29f" :question/math-academy-id "q-79742" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)=\\operatorname{ln}⁡({x}^{2}+y+{z}^{3}).$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =\\frac{2x\\,\\text{d}x}{{x}^{2}+y+{z}^{3}}+\\frac{\\text{d}y}{{x}^{2}+y+{z}^{3}}+\\frac{3{z}^{2}\\,\\text{d}z}{{x}^{2}+y+{z}^{3}}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348269 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1815abc5-f4cd-5414-aa7a-85f30d755b91" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "yz\\operatorname{sin}⁡(yz)\\,\\text{d}x+{x}^{2}z\\operatorname{cos}⁡(yz)\\,\\text{d}y+{x}^{2}y\\operatorname{cos}⁡(yz)\\,\\text{d}z" :db/id #edb/ref 17592186345564} {:answer/id #uuid "373f3389-d4cf-50de-84f8-73ae702a0dbf" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2x\\operatorname{cos}⁡(yz)\\,\\text{d}x+{x}^{2}\\ope