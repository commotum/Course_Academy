,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =2x\\operatorname{sin}⁡(yz)\\,\\text{d}x+{x}^{2}z\\operatorname{cos}⁡(yz)\\,\\text{d}y+{x}^{2}y\\operatorname{cos}⁡(yz)\\,\\text{d}z\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348270 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "393a2da4-2037-5f88-af20-25566e93ee10" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{d}a+10\\,\\text{d}b+2\\,\\text{d}c" :db/id #edb/ref 17592186345839} {:answer/id #uuid "5f766058-5345-504f-969f-c6f41943d337" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\,\\text{d}a+5\\,\\text{d}b+10\\,\\text{d}c" :db/id #edb/ref 17592186346176} {:answer/id #uuid "8c626268-e771-514e-9e16-2f37c28e6a23" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\,\\text{d}a+5\\,\\text{d}b+4\\,\\text{d}c" :db/id #edb/ref 17592186346570} {:answer/id #uuid "bd042560-3b82-573a-bb03-933f8a2d73a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c" :db/id #edb/ref 17592186346994} {:answer/id #uuid "dbe3e38f-3a94-535d-a8d4-214ff917e54f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+25\\,\\text{d}b+4\\,\\text{d}c" :db/id #edb/ref 17592186347278}] :answer-field/correct {:answer/id #uuid "bd042560-3b82-573a-bb03-933f8a2d73a4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c" :db/id #edb/ref 17592186346994} :answer-field/id #uuid "001e58e4-393c-54c0-893b-8d317963f75b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347603}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "eb226681-0351-549f-b81b-c5875e8a6018" :question/math-academy-id "q-79746" :question/problem "Given a rectangular solid, find the differential $\\text{d}V$ for the volume $V$ of the rectangular solid if the lengths of the sides are $a=2,$ $b=5,$ and $c=1.$" :question/worked-solution "The volume of the rectangular solid is $V=abc.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,b,c) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂b})\\,\\text{d}b+(\\frac{∂V}{∂c})\\,\\text{d}c \\\\  & =bc\\,\\text{d}a+ac\\,\\text{d}b+ab\\,\\text{d}c\\end{aligned}\n$$\n\nFor $a=2,$ $b=5,$ and $c=1,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(2,5,1) & =5\\cdot 1\\,\\text{d}a+2\\cdot 1\\,\\text{d}b+5\\cdot 2\\,\\text{d}c \\\\  & =5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186348271 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "009c9900-f889-52f9-b00b-40100c9397c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345359} {:answer/id #uuid "33de2cd4-781a-5e11-9d06-401da624c0ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345803} {:answer/id #uuid "6c775b28-e659-58c3-afb4-970c5a4d0320" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "12\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186346292} {:answer/id #uuid "80dabf23-d4b2-59f9-93af-a8e0472606a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+48\\,\\text{d}h" :db/id #edb/ref 17592186346477} {:answer/id #uuid "ef0dac21-38b0-572f-851b-fdb97e5e86a0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186347461}] :answer-field/correct {:answer/id #uuid "009c9900-f889-52f9-b00b-40100c9397c7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186345359} :answer-field/id #uuid "c0653cbc-f79b-58c9-bc1b-48709188cc90" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186347942}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "6f0e792d-8d7d-5fba-9784-ec8ac9d90e29" :question/math-academy-id "q-79747" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the base is a square with the side of $a=3$ and the height is $h=7.$" :question/worked-solution "The surface area of the given rectangular solid is $S=2{a}^{2}+4ah.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,h) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂h})\\,\\text{d}h \\\\  & =(4a+4h)\\,\\text{d}a+4a\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=3$ and $h=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(3,7) & =(4\\cdot 3+4\\cdot 7)\\,\\text{d}a+4\\cdot 3\\,\\text{d}h \\\\  & =40\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$"}]
