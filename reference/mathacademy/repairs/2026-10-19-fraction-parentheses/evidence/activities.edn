steps [{:db/id #edb/ref 17592186553609 :step/content {:db/id #edb/ref 17592186110979 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39117031-8bd7-5923-9276-cdc1948c942c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8{x}^{3}}{25}" :db/id #edb/ref 17592186552982} {:answer/id #uuid "9b9949b5-30a6-5762-a953-b694484a6125" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8{x}^{3}}{125}" :db/id #edb/ref 17592186553184} {:answer/id #uuid "c046ba94-1c02-5a90-b029-ab253fc5fbdb" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{8{x}^{3}}{125}" :db/id #edb/ref 17592186553249} {:answer/id #uuid "d1256010-75cd-58d3-853b-29ed436d57c3" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "-\\frac{4{x}^{3}}{125}" :db/id #edb/ref 17592186553287} {:answer/id #uuid "d90f2379-cc17-529b-b846-0f95dcc8aa0b" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{8{x}^{3}}{25}" :db/id #edb/ref 17592186553303}] :answer-field/correct {:db/id #edb/ref 17592186553249} :answer-field/id #uuid "048eb519-af72-550a-859f-c10d6f6d508f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186107607}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "3a3cc9e5-78e6-5bc2-8b9d-45b94201e0b1" :question/math-academy-id "q-22467" :question/problem "${(\\frac{-2x}{5})}^{3}=$" :question/worked-solution "First, we apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{-2x}{5})}^{3}=\\frac{(-2x)^{3}}{{5}^{3}}\\end{aligned}\n$$\n\nThen, we apply the power of product rule and simplify:\n\n$$\n\\begin{aligned}\\frac{(-2x)^{3}}{{5}^{3}} &= \\frac{(-2)^{3}{x}^{3}}{125} \\\\ &= -\\frac{8{x}^{3}}{125}\\end{aligned}\n$$"} :step/id #uuid "28fd1bcd-2fe9-55e9-85ea-0661511252c1" :step/next {:db/id #edb/ref 17592186553672}} {:db/id #edb/ref 17592186553624 :step/content {:db/id #edb/ref 17592186553590 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1723e9e6-e3d4-5c92-884a-480d4b3096da" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{3}^{4}}{{2}^{4}}" :db/id #edb/ref 17592186552908} {:answer/id #uuid "31d7b2f4-f18a-559c-ace0-d916afe65784" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186552965} {:answer/id #uuid "3e978287-ff14-526a-8959-0da6c17344b9" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{3}^{4}" :db/id #edb/ref 17592186552992} {:answer/id #uuid "7fc4dfa5-2ae6-59d3-b3af-d745124b5bd1" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{{2}^{4}}{{3}^{4}}" :db/id #edb/ref 17592186553127} {:answer/id #uuid "b2772045-ea3b-5d01-b1ee-fe20dc09c641" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "{2}^{4}" :db/id #edb/ref 17592186553227}] :answer-field/correct {:db/id #edb/ref 17592186552908} :answer-field/id #uuid "6f62a198-63f6-5ace-982e-2254c7cebad3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553427}] :question/difficulty {:db/id #edb/ref 17592186045485} :question/id #uuid "fc247476-de74-5773-8d25-47f3b046cb55" :question/math-academy-id "q-299" :question/problem "${(\\frac{3}{2})}^{4}=$" :question/worked-solution "We apply the power of quotient rule:\n\n$$\n\\begin{aligned}{(\\frac{3}{2})}^{4}=\\frac{{3}^{4}}{{2}^{4}}\\end{aligned}\n$$"} :step/id #uuid "5a36885b-76aa-5356-b939-a179350d8158" :step/next {:db/id #edb/ref 17592186553609}} {:db/id #edb/ref 17592186553672 :step/content {:db/id #edb/ref 17592186553503 :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "100858d8-fbb8-53d1-94ff-c723fb8181a4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186552890} {:answer/id #uuid "1012a099-490e-55a1-91fe-96513e31d553" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{6}{{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186552891} {:answer/id #uuid "b785f732-b7a8-5013-8b45-005925d7b461" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3vu}" :db/id #edb/ref 17592186553234} {:answer/id #uuid "f1e2a5a9-241f-5141-b300-982a2112367c" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{3}{2{v}^{2}{u}^{3}}" :db/id #edb/ref 17592186553344} {:answer/id #uuid "ff2dc043-19d6-5231-9ee1-3d43616eb3b4" :answer/type {:db/id #edb/ref 17592186045498} :answer/value "\\frac{2}{3{v}^{2}{u}^{2}}" :db/id #edb/ref 17592186553375}] :answer-field/correct {:db/id #edb/ref 17592186552891} :answer-field/id #uuid "68afb3d3-4f53-59cf-a56f-7809a2483d3e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493} :db/id #edb/ref 17592186553425}] :question/difficulty {:db/id #edb/ref 17592186045487} :question/id #uuid "22efbe5c-dc42-517a-9c47-dc7951665162" :question/math-academy-id "q-22530" :question/problem "$\\frac{2}{3}{(\\frac{3}{v})}^{2}{(\\frac{1}{u})}^{3}=$" :question/worked-solution "We apply the power of quotient rule and simplify:\n\n$$\n\\begin{aligned}\\frac{2}{3}{(\\frac{3}{v})}^{2}{(\\frac{1}{u})}^{3} &= \\frac{2}{3}\\cdot \\frac{{3}^{2}}{{v}^{2}}\\cdot \\frac{{1}^{3}}{{u}^{3}} \\\\ &= \\frac{2}{3}\\cdot \\frac{9}{{v}^{2}}\\cdot \\frac{1}{{u}^{3}} \\\\ &= \\frac{18}{3{v}^{2}{u}^{3}} \\\\ &= \\frac{6}{{v}^{2}{u}^{3}}\\end{aligned}\n$$"} :step/id #uuid "cdb37125-773c-5ee6-8809-c4e84ef5e493"}] :activity/title "The Power of Quotient Rule With Algebraic Expressions" :activity/type {:db/id #edb/ref 17592186045464 :db/ident :activity.type/review} :db/id #edb/ref 17592186552864}]}
