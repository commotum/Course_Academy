#{[{:db/id #edb/ref 17592186670458 :knowledge-point/_questions [{:db/id #edb/ref 17592186059706 :knowledge-point/id #uuid "4af25d77-e2aa-585a-971f-693c44f34e48" :knowledge-point/title "Solving Rational Equations with a Variable in One Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a892c61-4f79-54af-b709-acd39c2aec62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186670396} {:answer/id #uuid "642a1d35-9969-5aab-aa7b-17ece55cc2fd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186670409} {:answer/id #uuid "cacfc459-0129-548d-b30c-8572a68d8d52" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186670430} {:answer/id #uuid "d2014d78-0172-5bf0-a874-4c36d842905a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186670431} {:answer/id #uuid "f71b448e-c54f-5b5b-8deb-0cb850d4f2ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186670440}] :answer-field/correct {:answer/id #uuid "f71b448e-c54f-5b5b-8deb-0cb850d4f2ff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186670440} :answer-field/id #uuid "2b3d2617-e9dc-5524-9ebf-d810c3ed7f04" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670445}] :question/id #uuid "9691bd1b-5514-58d9-8dcd-30ee08809ee9" :question/math-academy-id "q-67410" :question/problem "Solve the equation $-\\frac{5}{3x}=\\frac{5}{6}.$" :question/worked-solution "First, we note that $x=0$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{3x}{5}=\\frac{6}{5}\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}-\\frac{3x}{5} & =\\frac{6}{5} \\\\ (-5)\\cdot \\left(\\frac{3x}{-5}\\right) & =(-5)\\cdot \\frac{6}{5} \\\\ (\\cancel{-5})\\cdot \\left(\\frac{3x}{\\cancel{-5}}\\right) & =(\\cancel{5})\\cdot \\frac{-6}{\\cancel{5}} \\\\ 3x & =-6 \\\\ \\left(\\frac{1}{3}\\right)\\cdot (3x) & =\\left(\\frac{1}{3}\\right)\\cdot (-6) \\\\ (\\cancel{\\frac{1}{3}})\\cdot (\\cancel{3}x) & =-\\frac{6}{3} \\\\ x & =-2\\end{aligned}\n$$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670460 :knowledge-point/_questions [{:db/id #edb/ref 17592186059706 :knowledge-point/id #uuid "4af25d77-e2aa-585a-971f-693c44f34e48" :knowledge-point/title "Solving Rational Equations with a Variable in One Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07077571-ccfa-55c8-b056-9eadc235f88a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186670390} {:answer/id #uuid "13a9c806-db29-54a1-9acb-eb652ed5bda7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186670393} {:answer/id #uuid "67d51d27-80e7-57c7-9e05-09bbbcbfdd05" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186670410} {:answer/id #uuid "6f0f86d5-45cf-5956-9b36-1b1a2b6c7cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186670411} {:answer/id #uuid "e665d509-094d-5efe-a8f8-5eec68cbb061" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186670434}] :answer-field/correct {:answer/id #uuid "6f0f86d5-45cf-5956-9b36-1b1a2b6c7cb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186670411} :answer-field/id #uuid "0eb74dc9-f9e4-508a-9d25-51c3d03237f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670442}] :question/id #uuid "b88ef01b-7c41-5a6e-8aa7-443a1edbe511" :question/math-academy-id "q-67405" :question/problem "Solve the equation $-\\frac{2}{3x}=\\frac{2}{9}.$" :question/worked-solution "First, we note that $x=0$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{3x}{2}=\\frac{9}{2}\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}-\\frac{3x}{2} & =\\frac{9}{2} \\\\ (-2)\\cdot \\left(\\frac{3x}{-2}\\right) & =(-2)\\cdot \\frac{9}{2} \\\\ \\cancel{(-2)}\\cdot \\left(\\frac{3x}{\\cancel{-2}}\\right) & =\\cancel{2}\\cdot \\frac{-9}{\\cancel{2}} \\\\ 3x & =-9 \\\\ \\left(\\frac{1}{3}\\right)\\cdot (3x) & =\\left(\\frac{1}{3}\\right)(-9) \\\\ \\cancel{\\left(\\frac{1}{3}\\right)}\\cdot (\\cancel{3}x) & =-\\frac{9}{3} \\\\ x & =-3\\end{aligned}\n$$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670461 :knowledge-point/_questions [{:db/id #edb/ref 17592186059706 :knowledge-point/id #uuid "4af25d77-e2aa-585a-971f-693c44f34e48" :knowledge-point/title "Solving Rational Equations with a Variable in One Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17967871-892e-54d8-8996-0c75074927db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{10}" :db/id #edb/ref 17592186670394} {:answer/id #uuid "2bd1339c-78ce-5ee3-8f74-f53c0bcbc2a2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186670397} {:answer/id #uuid "40ba6c76-9a3f-5ef2-9896-7d65d8074f38" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186670404} {:answer/id #uuid "a753380d-b5f3-5c93-aee1-5e8ad3488486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186670423} {:answer/id #uuid "f42c1b0b-b25d-52c2-91a2-615fa34bd380" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186670438}] :answer-field/correct {:answer/id #uuid "a753380d-b5f3-5c93-aee1-5e8ad3488486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186670423} :answer-field/id #uuid "903ad0ec-920e-53b7-bf64-52c2cd5fad4f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670449}] :question/id #uuid "c2a9d9f4-d0de-5d14-970c-e25e6928e45c" :question/math-academy-id "q-67406" :question/problem "Solve the equation $\\frac{2}{5}=\\frac{4}{x}.$" :question/worked-solution "First, we note that $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{5}{2}=\\frac{x}{4}\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}\\frac{5}{2} & =\\frac{x}{4} \\\\ 4\\cdot \\frac{5}{2} & =4\\cdot \\frac{x}{4} \\\\ \\frac{20}{2} & =\\cancel{4}\\cdot \\frac{x}{\\cancel{4}} \\\\ 10 & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=10.$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670453 :knowledge-point/_questions [{:db/id #edb/ref 17592186059707 :knowledge-point/id #uuid "93665eb6-5d3e-52d2-afc6-bc27488190e1" :knowledge-point/title "Solving Rational Equations with a Binomial in One Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "76caab9b-0240-534e-af0e-2cdf2d4653da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186670412} {:answer/id #uuid "781b91a3-3b19-5b60-985e-d16b045ce80f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186670413} {:answer/id #uuid "921d2a5e-8350-597a-ad03-6c5e7df2d745" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186670420} {:answer/id #uuid "b4eb3827-e3c7-53d9-a7d4-dbd47e1d70fa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{3}{2}" :db/id #edb/ref 17592186670425} {:answer/id #uuid "c42e5e30-8e73-5876-901b-fc95ac997a1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186670428}] :answer-field/correct {:answer/id #uuid "76caab9b-0240-534e-af0e-2cdf2d4653da" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186670412} :answer-field/id #uuid "17ad2725-54e9-5e8e-9e65-216f8922f0e7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670444}] :question/id #uuid "1592a32d-005d-5261-a0e4-09fc6b72ccf5" :question/math-academy-id "q-106322" :question/problem "Solve the equation $2=\\frac{7}{x+3}.$" :question/worked-solution "First, we note that $x=-3$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{1}{2}=\\frac{x+3}{7}\n$$\n\nWe can now solve this equation using the addition and the multiplication principle:\n\n$$\n\\begin{aligned}\\frac{1}{2} & =\\frac{x+3}{7} \\\\ 7\\cdot \\left(\\frac{1}{2}\\right) & =7\\cdot \\left(\\frac{x+3}{7}\\right) \\\\ \\frac{7}{2} & =\\cancel{7}\\cdot \\left(\\frac{x+3}{\\cancel{7}}\\right) \\\\ \\frac{7}{2} & =x+3 \\\\ \\frac{7}{2}-3 & =x+3-3 \\\\ \\frac{1}{2} & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=\\frac{1}{2}.$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670454 :knowledge-point/_questions [{:db/id #edb/ref 17592186059707 :knowledge-point/id #uuid "93665eb6-5d3e-52d2-afc6-bc27488190e1" :knowledge-point/title "Solving Rational Equations with a Binomial in One Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "019bbc5c-24ab-5bb5-b14d-a699d32aaf18" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186670387} {:answer/id #uuid "36ada7f6-3acb-5ed8-854e-16dfc1570278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186670402} {:answer/id #uuid "61f2c8da-5821-5a73-a9dd-a060e8a03802" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186670408} {:answer/id #uuid "b2901323-534c-5ab7-b861-47e3c05e86d7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186670424} {:answer/id #uuid "ba977e39-5aa4-530f-bd63-3166457cb280" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186670426}] :answer-field/correct {:answer/id #uuid "36ada7f6-3acb-5ed8-854e-16dfc1570278" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186670402} :answer-field/id #uuid "4ac62122-9a87-592f-8c40-d2cc5cd0d361" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670447}] :question/id #uuid "4d4080c2-4f5b-58b8-ad8e-0c4cd273e19f" :question/math-academy-id "q-67421" :question/problem "Solve the equation $-\\frac{1}{6}=\\frac{1}{x-7}.$" :question/worked-solution "First, we note that $x=7$ cannot be a solution since this would make the denominator on the right-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{6}{1}=\\frac{x-7}{1}\n$$\n\nThe above equation simplifies to\n\n$$\n-6=x-7\n$$\n\nWe can now solve this equation using the addition principle:\n\n$$\n\\begin{aligned}-6 & =x-7 \\\\ -6+7 & =x-7+7 \\\\ 1 & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=1.$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670456 :knowledge-point/_questions [{:db/id #edb/ref 17592186059707 :knowledge-point/id #uuid "93665eb6-5d3e-52d2-afc6-bc27488190e1" :knowledge-point/title "Solving Rational Equations with a Binomial in One Denominator"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c09cb2e-792c-5b50-9ddb-61b4ad09d949" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186670392} {:answer/id #uuid "590c1066-c2b3-5f96-ae20-75e02640b2e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186670407} {:answer/id #uuid "8d01fb2b-91b3-5128-be1a-d928008aa632" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186670416} {:answer/id #uuid "eb5f206d-9010-556a-98c3-a48c71b9e1ce" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186670435} {:answer/id #uuid "f2f8fc4b-e975-5087-9d1f-ddd9534cddff" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186670437}] :answer-field/correct {:answer/id #uuid "590c1066-c2b3-5f96-ae20-75e02640b2e2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186670407} :answer-field/id #uuid "ce4cf6fe-52ce-57e9-b242-0bd13032b5ff" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670452}] :question/id #uuid "7c6b4a66-c5e9-5822-b5d3-41ccbed0cc84" :question/math-academy-id "q-106324" :question/problem "Solve the equation $\\frac{2}{x+5}=\\frac{1}{4}.$" :question/worked-solution "First, we note that $x=-5$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{x+5}{2}=\\frac{4}{1}\n$$\n\nThe above equation simplifies to\n\n$$\n\\frac{x+5}{2}=4\n$$\n\nWe can now solve this equation using the multiplication and the addition principles:\n\n$$\n\\begin{aligned}2\\cdot \\left(\\frac{x+5}{2}\\right) & =2\\cdot 4 \\\\ \\cancel{2}\\cdot \\left(\\frac{x+5}{\\cancel{2}}\\right) & =8 \\\\ x+5 & =8 \\\\ x+5-5 & =8-5 \\\\ x & =3\\end{aligned}\n$$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670459 :knowledge-point/_questions [{:db/id #edb/ref 17592186059708 :knowledge-point/id #uuid "c2c24d70-3bde-5277-bc92-ae081065deee" :knowledge-point/title "Solving Rational Equations with a Binomial and a Monomial in Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0846c466-61cd-5359-8ea4-e12984fd5153" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186670391} {:answer/id #uuid "1eb090e7-b1fa-569e-a88c-88009df2442e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186670395} {:answer/id #uuid "2ee2b8c6-b052-5be6-aad0-5d83cf554aed" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186670399} {:answer/id #uuid "7f2a2b8c-7fc2-5164-bd7c-8939dda9fe34" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186670415} {:answer/id #uuid "fe6e5e61-3cdc-568d-bbcf-d767dfaf6770" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186670441}] :answer-field/correct {:answer/id #uuid "0846c466-61cd-5359-8ea4-e12984fd5153" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186670391} :answer-field/id #uuid "b2033eef-36dd-539d-9289-20b6ea9c55f6" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670450}] :question/id #uuid "af124b69-d0c1-5851-8687-aa12571f64c4" :question/math-academy-id "q-67424" :question/problem "Solve the equation  $\\frac{1}{2x+1}=\\frac{3}{5x}.$" :question/worked-solution "First, we note that\n\n- $x=-\\frac{1}{2}$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{2x+1}{1}=\\frac{5x}{3}\n$$\n\nNext, we write both fractions using the least common denominator $3.$ The above equation becomes\n\n$$\n\\frac{6x+3}{3}=\\frac{5x}{3}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}3\\cdot \\frac{6x+3}{3} & =3\\cdot \\frac{5x}{3} \\\\ 6x+3 & =5x \\\\ 6x+3-3 & =5x-3 \\\\ 6x & =5x-3 \\\\ 6x-5x & =5x-3-5x \\\\ x & =-3\\end{aligned}\n$$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670462 :knowledge-point/_questions [{:db/id #edb/ref 17592186059709 :knowledge-point/id #uuid "387a794f-17ea-5ea9-86a1-656a495f62cb" :knowledge-point/title "Solving Rational Equations with Binomials in Both Denominators"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03fb6247-b859-5d61-b518-790cfca6cb50" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186670388} {:answer/id #uuid "2f58ab42-b2b4-57a7-879c-22999c2cbd3d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186670400} {:answer/id #uuid "305d2d20-219b-50fa-9e4a-abb139156c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186670401} {:answer/id #uuid "9179637f-1c4b-575f-87a9-f66b0e1ed283" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186670418} {:answer/id #uuid "efd6b795-0b9d-5161-940a-359aa2c330a6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186670436}] :answer-field/correct {:answer/id #uuid "305d2d20-219b-50fa-9e4a-abb139156c55" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186670401} :answer-field/id #uuid "c08dc095-4a06-5102-a53c-3507e8db203b" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670451}] :question/id #uuid "e5e7057b-4215-507e-8d16-5466bad05ab6" :question/math-academy-id "q-67441" :question/problem "Solve the equation $\\frac{5}{2x+1}=\\frac{1}{x+1}.$" :question/worked-solution "First, we note that\n\n- $x=-\\frac{1}{2}$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=-1$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{2x+1}{5}=\\frac{x+1}{1}\n$$\n\nNext, we write both fractions using the least common denominator, $5.$ The equation becomes\n\n$$\n\\frac{2x+1}{5}=\\frac{5x+5}{5}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(5)\\cdot \\frac{2x+1}{5} & =(5)\\cdot \\frac{5x+5}{5} \\\\ 2x+1 & =5x+5 \\\\ 1-5 & =5x-2x \\\\ -4 & =3x \\\\ \\left(\\frac{1}{3}\\right)\\cdot (-4) & =\\left(\\frac{1}{3}\\right)\\cdot (3x) \\\\ \\left(\\frac{1}{3}\\right)\\cdot (-4) & =(\\cancel{\\frac{1}{3}})\\cdot (\\cancel{3}x) \\\\ -\\frac{4}{3} & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=-\\frac{4}{3}.$"} #edb/ref 17592186050953] [{:db/id #edb/ref 17592186670455 :knowledge-point/_questions [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06fd9c41-d3be-5ccf-8e93-a9c09b12180a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1755" :db/id #edb/ref 17592186670389} {:answer/id #uuid "4bf60cfb-234c-5681-a9cc-69fccc778e70" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1340" :db/id #edb/ref 17592186670406} {:answer/id #uuid "98aee249-615e-5aef-9c42-bac22058a161" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1022" :db/id #edb/ref 17592186670422} {:answer/id #uuid "cac8a4fd-3333-548a-b362-3f6432d42f19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1404" :db/id #edb/ref 17592186670429} {:answer/id #uuid "f5ac2d04-d1f7-52b3-82d6-496a5e6809d2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1008" :db/id #edb/ref 17592186670439}] :answer-field/correct {:answer/id #uuid "cac8a4fd-3333-548a-b362-3f6432d42f19" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1404" :db/id #edb/ref 17592186670429} :answer-field/id #uuid "4a0ab215-5ef6-5a4c-a729-1789edb119bc" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670446}] :question/id #uuid "615e1fed-a4a8-59b3-8748-a44e86a3ce62" :question/math-academy-id "q-130050" :question/problem "Given $X∼\\text{Po}(5),$ compute $P(X=3),$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Po}(\\lambda ),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nHere, $X∼\\text{Po}(5),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\frac{{5}^{x}{e}^{-5}}{x!}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=3) & =f(3) \\\\  & =\\frac{{5}^{3}{e}^{-5}}{3!} \\\\  & ≈0.1404.\\end{aligned}\n$$"} #edb/ref 17592186049358] [{:db/id #edb/ref 17592186670457 :knowledge-point/_questions [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4266e4f5-01a4-59c0-9d1a-6a59858398c5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0842" :db/id #edb/ref 17592186670405} {:answer/id #uuid "78b3c30e-bbe9-50c9-a378-76cb62a0a57a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0361" :db/id #edb/ref 17592186670414} {:answer/id #uuid "8d665c00-37aa-5b15-bca3-222341cd0fb8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1014" :db/id #edb/ref 17592186670417} {:answer/id #uuid "92fa4d3d-3196-543c-b2e9-3de9e87a5486" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0802" :db/id #edb/ref 17592186670421} {:answer/id #uuid "d62cc53f-5c2d-54bf-8c03-97c83dc95c5b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1115" :db/id #edb/ref 17592186670433}] :answer-field/correct {:answer/id #uuid "78b3c30e-bbe9-50c9-a378-76cb62a0a57a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0361" :db/id #edb/ref 17592186670414} :answer-field/id #uuid "11838f10-dc22-5f3b-ba56-0d91440185de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670443}] :question/id #uuid "967d2e95-57ac-5662-bd22-c0decd75429c" :question/math-academy-id "q-96847" :question/problem "Given $X∼\\text{Po}(2),$ compute $P(X=5),$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Po}(\\lambda ),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nHere, $X∼\\text{Po}(2),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\frac{{2}^{x}{e}^{-2}}{x!}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=5) & =f(5) \\\\  & =\\frac{{2}^{5}{e}^{-2}}{5!} \\\\  & ≈0.0361.\\end{aligned}\n$$"} #edb/ref 17592186049358] [{:db/id #edb/ref 17592186670463 :knowledge-point/_questions [{:db/id #edb/ref 17592186166816 :knowledge-point/id #uuid "74510348-04f1-570b-b3f7-5fcb1ed1beef" :knowledge-point/title "Computing a Probability at a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2df4c844-fa64-5ffb-bf2f-20d32f4045de" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0501" :db/id #edb/ref 17592186670398} {:answer/id #uuid "3f12f7fe-2842-59fd-9972-d7eaaa457c98" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0223" :db/id #edb/ref 17592186670403} {:answer/id #uuid "92041c52-6d1a-5884-a530-db5bd12d1433" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0216" :db/id #edb/ref 17592186670419} {:answer/id #uuid "c2063ee0-43c6-5e6e-814c-3d83f702e518" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.1321" :db/id #edb/ref 17592186670427} {:answer/id #uuid "d51f2e3b-5862-59df-a943-5e2f59625754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0521" :db/id #edb/ref 17592186670432}] :answer-field/correct {:answer/id #uuid "d51f2e3b-5862-59df-a943-5e2f59625754" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0.0521" :db/id #edb/ref 17592186670432} :answer-field/id #uuid "4c9c4cbf-7c12-5198-9194-ef060c21ad92" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186670448}] :question/id #uuid "e8cab3f8-2d4f-5187-b7bf-4e4ac59dbfe4" :question/math-academy-id "q-130048" :question/problem "Given $X∼\\text{Po}(7),$ compute $P(X=3),$ rounded to $4$ decimal places." :question/worked-solution "If $X∼\\text{Po}(\\lambda ),$ then $X$ has the following probability mass function:\n\n$$\nf(x)=\\frac{{\\lambda }^{x}{e}^{-\\lambda }}{x!}\n$$\n\nHere, $X∼\\text{Po}(7),$ so the distribution of $X$ in this case is\n\n$$\nf(x)=\\frac{{7}^{x}{e}^{-7}}{x!}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}P(X=3) & =f(3) \\\\  & =\\frac{{7}^{3}{e}^{-7}}{3!} \\\\  & ≈0.0521.\\end{aligned}\n$$"} #edb/ref 17592186049358]}
