ution is $x=-\\frac{5}{2}.$" #edb/ref 17592186576411] [17592186579669 #edb/ref 1043 #edb/ref 17592186580332 #edb/ref 17592186045417] [17592186579669 #edb/ref 1043 #edb/ref 17592186580344 #edb/ref 17592186045417] [17592186579669 #edb/ref 1043 #edb/ref 17592186580347 #edb/ref 17592186045417] [17592186579669 #edb/ref 1043 #edb/ref 17592186580361 #edb/ref 17592186045417] [17592186579669 #edb/ref 1043 #edb/ref 17592186580371 #edb/ref 17592186045417] [17592186579669 #edb/ref 1044 #edb/ref 17592186045464 #edb/ref 17592186045417] [17592186579669 #edb/ref 1045 "Optimizing Multivariable Functions Using Lagrange Multipliers" #edb/ref 17592186045417] [17592186579669 #edb/ref 1046 #edb/ref 17592186580344 #edb/ref 17592186045417] [17592186579669 #edb/ref 1048 #edb/ref 17592186046673 #edb/ref 17592186045417] [17592186579669 #edb/ref 1049 #edb/ref 17592186050688 #edb/ref 17592186045417] [17592186579669 #edb/ref 1053 #uuid "30ace273-630b-5110-b8d8-ef18d6018f35" #edb/ref 17592186045417] [17592186580332 #edb/ref 1058 #edb/ref 17592186580361 #edb/ref 17592186045417] [17592186580332 #edb/ref 1062 #uuid "43f9abfe-835b-57a3-a40a-e05dda3e5a84" #edb/ref 17592186045417] [17592186580332 #edb/ref 1063 #edb/ref 17592186496295 #edb/ref 17592186045417] [17592186580344 #edb/ref 1058 #edb/ref 17592186580347 #edb/ref 17592186045417] [17592186580344 #edb/ref 1062 #uuid "6aabbbcb-7bab-5819-997c-0fe293e0f792" #edb/ref 17592186045417] [17592186580344 #edb/ref 1063 #edb/ref 17592186199016 #edb/ref 17592186045417] [17592186580347 #edb/ref 1058 #edb/ref 17592186580371 #edb/ref 17592186045417] [17592186580347 #edb/ref 1062 #uuid "8075bb6c-56c7-5a23-bc58-470ac22fc76e" #edb/ref 17592186045417] [17592186580347 #edb/ref 1063 #edb/ref 17592186362346 #edb/ref 17592186045417] [17592186580361 #edb/ref 1062 #uuid "b688d1a0-ca62-52cb-9676-d18b65239a76" #edb/ref 17592186045417] [17592186580361 #edb/ref 1063 #edb/ref 17592186446813 #edb/ref 17592186045417] [17592186580371 #edb/ref 1058 #edb/ref 17592186580332 #edb/ref 