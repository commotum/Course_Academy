\n-6=x-7\n$$\n\nWe can now solve this equation using the addition principle:\n\n$$\n\\begin{aligned}-6 & =x-7 \\\\ -6+7 & =x-7+7 \\\\ 1 & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=1.$" :question/answer-fields ["answer-field-4ac62122-9a87-592f-8c40-d2cc5cd0d361"] :db/ensure [:question/validate]} {:db/id "answer-field-4ac62122-9a87-592f-8c40-d2cc5cd0d361" :answer-field/id #uuid "4ac62122-9a87-592f-8c40-d2cc5cd0d361" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-36ada7f6-3acb-5ed8-854e-16dfc1570278" :answer-field/choices ["answer-019bbc5c-24ab-5bb5-b14d-a699d32aaf18" "answer-ba977e39-5aa4-530f-bd63-3166457cb280" "answer-61f2c8da-5821-5a73-a9dd-a060e8a03802" "answer-36ada7f6-3acb-5ed8-854e-16dfc1570278" "answer-b2901323-534c-5ab7-b861-47e3c05e86d7"] :db/ensure [:answer-field/validate]} {:db/id "answer-019bbc5c-24ab-5bb5-b14d-a699d32aaf18" :answer/id #uuid "019bbc5c-24ab-5bb5-b14d-a699d32aaf18" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "answer-ba977e39-5aa4-530f-bd63-3166457cb280" :answer/id #uuid "ba977e39-5aa4-530f-bd63-3166457cb280" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-61f2c8da-5821-5a73-a9dd-a060e8a03802" :answer/id #uuid "61f2c8da-5821-5a73-a9dd-a060e8a03802" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "answer-36ada7f6-3acb-5ed8-854e-16dfc1570278" :answer/id #uuid "36ada7f6-3acb-5ed8-854e-16dfc1570278" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "answer-b2901323-534c-5ab7-b861-47e3c05e86d7" :answer/id #uuid "b2901323-534c-5ab7-b861-47e3c05e86d7" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186059708 :knowledge-point/questions ["question-af124b69-d0c1-5851-8687-aa12571f64c4"] :db/ensure [:knowledge-point/validate]} {:db/id "question-af124b69-d0c1-5851-8687-aa12571f64c4" :question/id #uuid "af124b69-d0c1-5851-8687-aa12571f64c4" :question/math-academy-id "q-67424" :question/problem "Solve the equation  $\\frac{1}{2x+1}=\\frac{3}{5x}.$" :question/worked-solution "First, we note that\n\n- $x=-\\frac{1}{2}$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=0$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{2x+1}{1}=\\frac{5x}{3}\n$$\n\nNext, we write both fractions using the least common denominator $3.$ The above equation becomes\n\n$$\n\\frac{6x+3}{3}=\\frac{5x}{3}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}3\\cdot \\frac{6x+3}{3} & =3\\cdot \\frac{5x}{3} \\\\ 6x+3 & =5x \\\\ 6x+3-3 & =5x-3 \\\\ 6x & =5x-3 \\\\ 6x-5x & =5x-3-5x \\\\ x & =-3\\end{aligned}\n$$" :question/answer-fields ["answer-field-b2033eef-36dd-539d-9289-20b6ea9c55f6"] :db/ensure [:question/validate]} {:db/id "answer-field-b2033eef-36dd-539d-9289-20b6ea9c55f6" :answer-field/id #uuid "b2033eef-36dd-539d-9289-20b6ea9c55f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-0846c466-61cd-5359-8ea4-e12984fd5153" :answer-field/choices ["answer-1eb090e7-b1fa-569e-a88c-88009df2442e" "answer-0846c466-61cd-5359-8ea4-e12984fd5153" "answer-2ee2b8c6-b052-5be6-aad0-5d83cf554aed" "answer-fe6e5e61-3cdc-568d-bbcf-d767dfaf6770" "answer-7f2a2b8c-7fc2-5164-bd7c-8939dda9fe34"] :db/ensure [:answer-field/validate]} {:db/id "answer-1eb090e7-b1fa-569e-a88c-88009df2442e" :answer/id #uuid "1eb090e7-b1fa-569e-a88c-88009df2442e" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-0846c466-61cd-5359-8ea4-e12984fd5153" :answer/id #uuid "0846c466-61cd-5359-8ea4-e12984fd5153" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-2ee2b8c6-b052-5be6-aad0-5d83cf554aed" :answer/id #uuid "2ee2b8c6-b052-5be6-aad0-5d83cf554aed" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "answer-fe6e5e61-3cdc-568d-bbcf-d767dfaf6770" :answer/id #uuid "fe6e5e61-3cdc-568d-bbcf-d767dfaf6770" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-7f2a2b8c-7fc2-5164-bd7c-8939dda9fe34" :answer/id #uuid "7f2a2b8c-7fc2-5164-bd7c-8939dda9fe34" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id 17592186059709 :knowledge-point/questions ["question-e5e7057b-4215-507e-8d16-5466bad05ab6"] :db/ensure [:knowledge-point/validate]} {:db/id "question-e5e7057b-4215-507e-8d16-5466bad05ab6" :question/id #uuid "e5e7057b-4215-507e-8d16-5466bad05ab6" :question/math-academy-id "q-67441" :question/problem "Solve the equation $\\frac{5}{2x+1}=\\frac{1}{x+1}.$" :question/worked-solution "First, we note that\n\n- $x=-\\frac{1}{2}$ cannot be a solution since this would make the denominator on the left-hand side zero\n\n- $x=-1$ cannot be a solution since this would make the denominator on the right-hand side zero\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n\\frac{2x+1}{5}=\\frac{x+1}{1}\n$$\n\nNext, we write both fractions using the least common denominator, $5.$ The equation becomes\n\n$$\n\\frac{2x+1}{5}=\\frac{5x+5}{5}.\n$$\n\nWe can now solve this equation with the addition and the multiplication principles:\n\n$$\n\\begin{aligned}(5)\\cdot \\frac{2x+1}{5} & =(5)\\cdot \\frac{5x+5}{5} \\\\ 2x+1 & =5x+5 \\\\ 1-5 & =5x-2x \\\\ -4 & =3x \\\\ \\left(\\frac{1}{3}\\right)\\cdot (-4) & =\\left(\\frac{1}{3}\\right)\\cdot (3x) \\\\ \\left(\\frac{1}{3}\\right)\\cdot (-4) & =(\\cancel{\\frac{1}{3}})\\cdot (\\cancel{3}x) \\\\ -\\frac{4}{3} & =x\\end{aligned}\n$$\n\nWe conclude that the solution is $x=-\\frac{4}{3}.$" :question/answer-fields ["answer-field-c08dc095-4a06-5102-a53c-3507e8db203b"] :db/ensure [:question/validate]} {:db/id "answer-field-c08dc095-4a06-5102-a53c-3507e8db203b" :answer-field/id #uuid "c08dc095-4a06-5102-a53c-3507e8db203b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-305d2d20-219b-50fa-9e4a-abb139156c55" :answer-field/choices ["answer-efd6b795-0b9d-5161-940a-359aa2c330a6" "answer-03fb6247-b859-5d61-b518-790cfca6cb50" "answer-305d2d20-219b-50fa-9e4a-abb139156c55" "answer-9179637f-1c4b-575f-87a9-f66b0e1ed283" "answer-2f58ab42-b2b4-57a7-879c-22999c2cbd3d"] :db/ensure [:answer-field/validate]} {:db/id "answer-efd6b795-0b9d-5161-940a-359aa2c330a6" :answer/id #uuid "efd6b795-0b9d-5161-940a-359aa2c330a6" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-03fb6247-b859-5d61-b518-790cfca6cb50" :answer/id #uuid "03fb6247-b859-5d61-b518-790cfca6cb50" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "answer-305d2d20-219b-50fa-9e4a-abb139156c55" :answer/id #uuid "305d2d20-219b-50fa-9e4a-abb139156c55" :answer/type :answer.type/math :answer/value "-\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "answer-9179637f-1c4b-575f-87a9-f66b0e1ed283" :answer/id #uuid "9179637f-1c4b-575f-87a9-f66b0e1ed283" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "answer-2f58ab42-b2b4-57a7-879c-22999c2cbd3d" :answer/id #uuid "2f58ab42-b2b4-57a7-879c-22999c2cbd3d" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/vali