-5ffb-bf2f-20d32f4045de" "answer-d51f2e3b-5862-59df-a943-5e2f59625754" "answer-c2063ee0-43c6-5e6e-814c-3d83f702e518"] :db/ensure [:answer-field/validate]} {:db/id "answer-92041c52-6d1a-5884-a530-db5bd12d1433" :answer/id #uuid "92041c52-6d1a-5884-a530-db5bd12d1433" :answer/type :answer.type/math :answer/value "0.0216" :db/ensure [:answer/validate]} {:db/id "answer-3f12f7fe-2842-59fd-9972-d7eaaa457c98" :answer/id #uuid "3f12f7fe-2842-59fd-9972-d7eaaa457c98" :answer/type :answer.type/math :answer/value "0.0223" :db/ensure [:answer/validate]} {:db/id "answer-2df4c844-fa64-5ffb-bf2f-20d32f4045de" :answer/id #uuid "2df4c844-fa64-5ffb-bf2f-20d32f4045de" :answer/type :answer.type/math :answer/value "0.0501" :db/ensure [:answer/validate]} {:db/id "answer-d51f2e3b-5862-59df-a943-5e2f59625754" :answer/id #uuid "d51f2e3b-5862-59df-a943-5e2f59625754" :answer/type :answer.type/math :answer/value "0.0521" :db/ensure [:answer/validate]} {:db/id "answer-c2063ee0-43c6-5e6e-814c-3d83f702e518" :answer/id #uuid "c2063ee0-43c6-5e6e-814c-3d83f702e518" :answer/type :answer.type/math :answer/value "0.1321" :db/ensure [:answer/validate]} {:db/id 17592186059706 :knowledge-point/questions ["question-9691bd1b-5514-58d9-8dcd-30ee08809ee9" "question-b88ef01b-7c41-5a6e-8aa7-443a1edbe511" "question-c2a9d9f4-d0de-5d14-970c-e25e6928e45c"] :db/ensure [:knowledge-point/validate]} {:db/id "question-9691bd1b-5514-58d9-8dcd-30ee08809ee9" :question/id #uuid "9691bd1b-5514-58d9-8dcd-30ee08809ee9" :question/math-academy-id "q-67410" :question/problem "Solve the equation $-\\frac{5}{3x}=\\frac{5}{6}.$" :question/worked-solution "First, we note that $x=0$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{3x}{5}=\\frac{6}{5}\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}-\\frac{3x}{5} & =\\frac{6}{5} \\\\ (-5)\\cdot \\left(\\frac{3x}{-5}\\right) & =(-5)\\cdot \\frac{6}{5} \\\\ (\\cancel{-5})\\cdot \\left(\\frac{3x}{\\cancel{-5}}\\right) & =(\\cancel{5})\\cdot \\frac{-6}{\\cancel{5}} \\\\ 3x & =-6 \\\\ \\left(\\frac{1}{3}\\right)\\cdot (3x) & =\\left(\\frac{1}{3}\\right)\\cdot (-6) \\\\ (\\cancel{\\frac{1}{3}})\\cdot (\\cancel{3}x) & =-\\frac{6}{3} \\\\ x & =-2\\end{aligned}\n$$" :question/answer-fields ["answer-field-2b3d2617-e9dc-5524-9ebf-d810c3ed7f04"] :db/ensure [:question/validate]} {:db/id "answer-field-2b3d2617-e9dc-5524-9ebf-d810c3ed7f04" :answer-field/id #uuid "2b3d2617-e9dc-5524-9ebf-d810c3ed7f04" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-f71b448e-c54f-5b5b-8deb-0cb850d4f2ff" :answer-field/choices ["answer-f71b448e-c54f-5b5b-8deb-0cb850d4f2ff" "answer-d2014d78-0172-5bf0-a874-4c36d842905a" "answer-cacfc459-0129-548d-b30c-8572a68d8d52" "answer-2a892c61-4f79-54af-b709-acd39c2aec62" "answer-642a1d35-9969-5aab-aa7b-17ece55cc2fd"] :db/ensure [:answer-field/validate]} {:db/id "answer-f71b448e-c54f-5b5b-8deb-0cb850d4f2ff" :answer/id #uuid "f71b448e-c54f-5b5b-8deb-0cb850d4f2ff" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "answer-d2014d78-0172-5bf0-a874-4c36d842905a" :answer/id #uuid "d2014d78-0172-5bf0-a874-4c36d842905a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "answer-cacfc459-0129-548d-b30c-8572a68d8d52" :answer/id #uuid "cacfc459-0129-548d-b30c-8572a68d8d52" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "answer-2a892c61-4f79-54af-b709-acd39c2aec62" :answer/id #uuid "2a892c61-4f79-54af-b709-acd39c2aec62" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "answer-642a1d35-9969-5aab-aa7b-17ece55cc2fd" :answer/id #uuid "642a1d35-9969-5aab-aa7b-17ece55cc2fd" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "question-b88ef01b-7c41-5a6e-8aa7-443a1edbe511" :question/id #uuid "b88ef01b-7c41-5a6e-8aa7-443a1edbe511" :question/math-academy-id "q-67405" :question/problem "Solve the equation $-\\frac{2}{3x}=\\frac{2}{9}.$" :question/worked-solution "First, we note that $x=0$ cannot be a solution since this would make the denominator on the left-hand side zero.\n\nWe can flip an equation involving two fractions as follows:\n\n$$\n\\frac{a}{b}=\\frac{c}{d}\\,⟹\\,\\frac{b}{a}=\\frac{d}{c}\n$$\n\nThe above technique works whenever $a$ and $c$ are both different from zero.\n\nTherefore, we can flip the given equation as follows:\n\n$$\n-\\frac{3x}{2}=\\frac{9}{2}\n$$\n\nWe can now solve this equation using the multiplication principle:\n\n$$\n\\begin{aligned}-\\frac{3x}{2} & =\\frac{9}{2} \\\\ (-2)\\cdot \\left(\\frac{3x}{-2}\\right) & =(-2)\\cdot \\frac{9}{2} \\\\ \\cancel{(-2)}\\cdot \\left(\\frac{3x}{\\cancel{-2}}\\right) & =\\cancel{2}\\cdot \\frac{-9}{\\cancel{2}} \\\\ 3x & =-9 \\\\ \\left(\\frac{1}{3}\\right)\\cdot (3x) & =\\left(\\frac{1}{3}\\right)(-9) \\\\ \\cancel{\\left(\\frac{1}{3}\\right)}\\cdot (\\cancel{3}x) & =-\\frac{9}{3} \\\\ x & =-3\\end{aligned}\n$$" :question/answer-fields ["answer-field-0eb74dc9-f9e4-508a-9d25-51c3d03237f6"] :db/ensure [:question/validate]} {:db/id "answer-field-0eb74dc9-f9e4-508a-9d25-51c3d03237f6" :answer-field/id #uuid "0eb74dc9-f9e4-508a-9d25-51c3d03237f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "answer-6f0f86d5-45cf-5956-9b36-1b1a2b6c7cb3" :answer-field/choices ["answer-67d51d27-80e7-57c7-9e05-09bbbcbfdd05" "answer-6f0f86d5-45cf-5956-9b36-1b1a2b6c7cb3" "answer-13a9c806-db29-54a1-9acb-eb652ed5bda7" "answer-07077571-ccfa-55c8-b056-9eadc235f88a" "answer-e665d509-094d-5efe-a8f8-5eec68cbb