wer-fields ["field-07db33e0-b0dd-5245-b557-eccb279f2990"] :db/ensure :question/validate} [:db/add 17592186087689 :knowledge-point/questions "question-b66dc0f1-9274-5d77-a711-f240345b2e75"] {:db/id "answer-fbaa3225-0cca-5ef7-bce2-368d41fb809d" :answer/id #uuid "fbaa3225-0cca-5ef7-bce2-368d41fb809d" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{2}+\\frac{1}{16}\\ln\\left(3\\right)" :db/ensure :answer/validate} {:db/id "answer-75871ce1-4ccb-55ab-8429-132ef5f31680" :answer/id #uuid "75871ce1-4ccb-55ab-8429-132ef5f31680" :answer/type :answer.type/math :answer/value "x=1-\\frac{1}{8}\\ln\\left(3\\right)" :db/ensure :answer/validate} {:db/id "answer-7c8bde16-7ddf-5499-93b1-3f1a204cfcd9" :answer/id #uuid "7c8bde16-7ddf-5499-93b1-3f1a204cfcd9" :answer/type :answer.type/math :answer/value "x=-\\frac{2}{3}+\\frac{1}{12}\\ln\\left(3\\right)" :db/ensure :answer/validate} {:db/id "answer-818a37f9-b1b0-5713-93ff-e0d5e01b0b2b" :answer/id #uuid "818a37f9-b1b0-5713-93ff-e0d5e01b0b2b" :answer/type :answer.type/math :answer/value "x=\\frac{9}{4}-\\frac{1}{16}\\ln\\left(3\\right)" :db/ensure :answer/validate} {:db/id "answer-4a05d8dc-983b-5cb1-9189-1b1426d0b35b" :answer/id #uuid "4a05d8dc-983b-5cb1-9189-1b1426d0b35b" :answer/type :answer.type/math :answer/value "x=-\\frac{3}{4}-\\frac{1}{16}\\ln\\left(3\\right)" :db/ensure :answer/validate} {:db/id "field-a8dc82ad-18fe-5690-b6ed-a8d82b960763" :answer-field/id #uuid "a8dc82ad-18fe-5690-b6ed-a8d82b960763" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["answer-fbaa3225-0cca-5ef7-bce2-368d41fb809d" "answer-75871ce1-4ccb-55ab-8429-132ef5f31680" "answer-7c8bde16-7ddf-5499-93b1-3f1a204cfcd9" "answer-818a37f9-b1b0-5713-93ff-e0d5e01b0b2b" "answer-4a05d8dc-983b-5cb1-9189-1b1426d0b35b"] :answer-field/correct "answer-7c8bde16-7ddf-5499-93b1-3f1a204cfcd9" :db/ensure :answer-field/validate} {:db/id "question-03336653-e440-5096-bde7-e341c97151c0" :question/id #uuid "03336653-e440-5096-bde7-e341c97151c0" :question/problem "What is the exact value of $x$ if $e^{2+3x}=\\sqrt[4]{3}$?" :question/worked-solution "Take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\ln\\left(e^{2+3x}\\right)&=\\ln\\left(\\sqrt[4]{3}\\right)\\end{aligned}\n$$\n\nUse $\\ln(e^u)=u$ and write the root as a fractional power:\n\n$$\n\\begin{aligned}2+3x&=\\ln\\left(3^{1/4}\\right)\\end{aligned}\n$$\n\nApply the power rule for logarithms:\n\n$$\n\\begin{aligned}2+3x&=\\frac{1}{4}\\ln\\left(3\\right)\\end{aligned}\n$$\n\nSubtract the constant term, then divide by the signed coefficient of $x$:\n\n$$\n\\begin{aligned}3x&=\\frac{1}{4}\\ln\\left(3\\right)-2 \\\\ x&=-\\frac{2}{3}+\\frac{1}{12}\\ln\\left(3\\right)\\end{aligned}\n$$\n\nTherefore, $x=-\\frac{2}{3}+\\frac{1}{12}\\ln\\left(3\\right)$." :question/difficulty :question.difficulty/hard :question/answer-fields ["field-a8dc82ad-18fe-5690-b6ed-a8d82b960763"] :db/ensure :question/validate} [:db/add 17592186087689 :knowledge-point/questions "question-03336653-e440-5096-bde7-e341c97151c0"] {:db/id "answer-3097ac63-e009-5610-a61c-d8a7542e060a" :answer/id #uuid "3097ac63-e009-5610-a61c-d8a7542e060a" :answer/type :answer.type/math :answer/value "y=-\\frac{8}{5}+\\frac{1}{15}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-359ae1ce-c856-5e93-ac6a-796372be26cb" :answer/id #uuid "359ae1ce-c856-5e93-ac6a-796372be26cb" :answer/type :answer.type/math :answer/value "y=\\frac{6}{5}-\\frac{1}{15}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-ae855d83-5f5c-558a-a24a-6ff86ccf2617" :answer/id #uuid "ae855d83-5f5c-558a-a24a-6ff86ccf2617" :answer/type :answer.type/math :answer/value "y=\\frac{8}{3}-\\frac{1}{9}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-1ae5e4bd-f0a1-5d66-abd6-b032c8e85f7c" :answer/id #uuid "1ae5e4bd-f0a1-5d66-abd6-b032c8e85f7c" :answer/type :answer.type/math :answer/value "y=-\\frac{3}{5}+\\frac{1}{15}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-3b0a8239-bff3-5571-b4a8-72ae075840b9" :answer/id #uuid "3b0a8239-bff3-5571-b4a8-72ae075840b9" :answer/type :answer.type/math :answer/value "y=-\\frac{2}{5}+\\frac{1}{15}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "field-42fe1cbe-91d7-56dd-a61a-3070c09bb85c" :answer-field/id #uuid "42fe1cbe-91d7-56dd-a61a-3070c09bb85c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["answer-3097ac63-e009-5610-a61c-d8a7542e060a" "answer-359ae1ce-c856-5e93-ac6a-796372be26cb" "answer-ae855d83-5f5c-558a-a24a-6ff86ccf2617" "answer-1ae5e4bd-f0a1-5d66-abd6-b032c8e85f7c" "answer-3b0a8239-bff3-5571-b4a8-72ae075840b9"] :answer-field/correct "answer-3b0a8239-bff3-5571-b4a8-72ae075840b9" :db/ensure :answer-field/validate} {:db/id "question-423ce376-d2e6-569d-9e56-c5374022d4b7" :question/id #uuid "423ce376-d2e6-569d-9e56-c5374022d4b7" :question/problem "What is the exact value of $y$ if $e^{5y+2}=\\sqrt[3]{13}$?" :question/worked-solution "Take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\ln\\left(e^{5y+2}\\right)&=\\ln\\left(\\sqrt[3]{13}\\right)\\end{aligned}\n$$\n\nUse $\\ln(e^u)=u$ and write the root as a fractional power:\n\n$$\n\\begin{aligned}5y+2&=\\ln\\left(13^{1/3}\\right)\\end{aligned}\n$$\n\nApply the power rule for logarithms:\n\n$$\n\\begin{aligned}5y+2&=\\frac{1}{3}\\ln\\left(13\\right)\\end{aligned}\n$$\n\nSubtract the constant term, then divide by the signed coefficient of $y$:\n\n$$\n\\begin{aligned}5y&=\\frac{1}{3}\\ln\\left(13\\right)-2 \\\\ y&=-\\frac{2}{5}+\\frac{1}{15}\\ln\\left(13\\right)\\end{aligned}\n$$\n\nTherefore, $y=-\\frac{2}{5}+\\frac{1}{15}\\ln\\left(13\\right)$." :question/difficulty :question.difficulty/hard :question/answer-fields ["field-42fe1cbe-91d7-56dd-a61a-3070c09bb85c"] :db/ensure :question/validate} [:db/add 17592186087689 :knowledge-point/questions "question-423ce376-d2e6-569d-9e56-c5374022d4b7"] {:db/id "answer-8f374aec-c009-5b3f-b6aa-4e2d30d7e16d" :answer/id #uuid "8f374aec-c009-5b3f-b6aa-4e2d30d7e16d" :answer/type :answer.type/math :answer/value "t=-1-\\frac{1}{12}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-7b4d4b94-be9b-5809-be6d-3f1fb2744e42" :answer/id #uuid "7b4d4b94-be9b-5809-be6d-3f1fb2744e42" :answer/type :answer.type/math :answer/value "t=\\frac{4}{5}-\\frac{1}{30}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-102bb8ec-be40-5433-93ad-980e0683ac58" :answer/id #uuid "102bb8ec-be40-5433-93ad-980e0683ac58" :answer/type :answer.type/math :answer/value "t=-3+\\frac{1}{12}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-1cd54d15-d7bc-5ca7-a753-505e3450bf6f" :answer/id #uuid "1cd54d15-d7bc-5ca7-a753-505e3450bf6f" :answer/type :answer.type/math :answer/value "t=-3-\\frac{1}{6}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "answer-2c3e5b2f-1c23-5cfd-9804-25708875534a" :answer/id #uuid "2c3e5b2f-1c23-5cfd-9804-25708875534a" :answer/type :answer.type/math :answer/value "t=\\frac{3}{4}-\\frac{1}{24}\\ln\\left(13\\right)" :db/ensure :answer/validate} {:db/id "field-619d7d91-7101-5d7e-9c43-436e24c3064e" :answer-field/id #uuid "619d7d91-7101-5d7e-9c43-436e24c3064e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/choices ["answer-8f374aec-c009-5b3f-b6aa-4e2d30d7e16d" "answer-7b4d4b94-be9b-5809-be6d-3f1fb2744e42" "answer-102bb8ec-be40-5433-93ad-980e0683ac58" "answer-1cd54d15-d7bc-5ca7-a753-505e3450bf6f" "answer-2c3e5b2f-1c23-5cfd-9804-25708875534a"] :answer-field/correct "answer-102bb8ec-be40-5433-93ad-980e0683ac58" :db/ensure :answer-field/validate} {:db/id "question-02bcdb10-1ef3-5e22-87e6-3e00fa28ea06" :question/id #uuid "02bcdb10-1ef3-5e22-87e6-3e00fa28ea06" :question/problem "What is the exact value of $t$ if $e^{6+2t}=\\sqrt[6]{13}$?" :question/worked-solution "Take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\ln\\left(e^{6+2t}\\right)&=\\ln\\left(\\sqrt[6]{13}\\right)\\end{aligned}\n$$\n\nUse $\\ln(e^u)=u$ and write the root as a fractional power:\n\n$$\n\\begin{aligned}6+2t&=\\ln\\left(13^{1/6}\\right)\\end{aligned}\n$$\n\nApply the power rule for logarithms:\n\n$$\n\\begin{aligned}6+2t&=\\frac{1}{6}\\ln\\left(13\\right)\\end{aligned}\n$$\n\nSubtract the constant term, then divide by the signed coefficient of $t$:\n\n$$\n\\begin{aligned}2t&=\\frac{1}{6}\\ln\\left(13\\right)-6 \\\\ t&=-3+\\frac{1}{12}\\ln\\left(13\\right)\\end{aligned}\n$$\n\nTherefore, $t=-3+\\frac{1}{12}\\ln\\left(13\\right)$." :question/difficulty :question.difficulty/hard :question/answer-fields ["field-619d7d91-7101-5d7e-9c43-436e24c3064e"] :db/ensure :question/validate} [:db/add 17592186087689 :knowledge-point/questions "question-02bcdb10-1ef3-5e22-87e6-3e00fa28ea06"] [:db/ensure 17592186087689 :knowledge-point/validate]]
