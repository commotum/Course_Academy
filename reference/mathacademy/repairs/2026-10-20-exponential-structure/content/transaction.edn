e^{-2y+4}\\right)&=\\ln\\left(\\sqrt[8]{7}\\right)\\end{aligned}\n$$\n\nUse $\\ln(e^u)=u$ and write the root as a fractional power:\n\n$$\n\\begin{aligned}-2y+4&=\\ln\\left(7^{1/8}\\right)\\end{aligned}\n$$\n\nApply the power rule for logarithms:\n\n$$\n\\begin{aligned}-2y+4&=\\frac{1}{8}\\ln\\left(7\\right)\\end{aligned}\n$$\n\nSubtract the constant term, then divide by the signed coefficient of $y$:\n\n$$\n\\begin{aligned}-2y&=\\frac{1}{8}\\ln\\left(7\\right)-4 \\\\ y&=2-\\frac{1}{16}\\ln\\left(7\\right)\\end{aligned}\n$$\n\nTherefore, $y=2-\\frac{1}{16}\\ln\\left(7\\right)$." :question/difficulty :question.difficulty/hard :question/answer-fields ["field-6462ca6e-48ad-5bbf-9bdb-10b8c1627914"] :db/ensure :question/validate} [:db/add 17592186087689 :knowledge-point/questions "question-0436fc15-97ed-51ee-a080-b464763a569c"] {:db/id "answer-7b015e19-02a8-53f3-89e7-6860d97381f3" :answer/id #uuid "7b015e19-02a8-53f3-89e7-6860d97381f3" :answer/type :answer.type/math :answer/value "t=3+\\frac{1}{10}\\ln\\left(7\\right)" :db/ensure :answer/validate} {:db/id "answer-02c43eec-b9f3-5c97-a5a3-0b808cefec6e" :answer/id #uuid "02c43eec-b9f3-5c97-a5a3-0b808cefec6e" :answer/type :answer.type/math :answer/value "t=\\frac{8}{3}-\\frac{1}{15}\\ln\\left(7\\right)" :db/ensure :answer/validate} {:db/id "answer-d042504b-d066-59cf-8452-bcc86d1652c6" :answer/id #uuid "d042504b-d066-59cf-8452-bcc86d1652c6" :answer/type :answer.type/math :answer/value "t=\\frac{8}{5}+\\frac{1}{25}\\ln\\left(7\\right)" :db/ensure :answer/validate} {:db/id "answer-3f16b8bd-a8e6-5fdf-b53f-c2844572c2ee" :answer/id #uuid "3f16b8bd-a8e6-5fdf-b53f-c2844572c2ee" :answer/type :answer.type/math :answer/value "t=-1-\\frac{1}{5}\\ln\\left(7\\right)" :db/ensure :answer/validate} {:db/id "answer-d78df905-2457-5cc7-a17f-016184a0d00c" :answer/id #uuid "d78df905-2457-5cc7-a17f-016184a0d00c" :answer/type :answer.type/math :answer/value "t=-1+\\frac{1}{20}\\ln\\left(7\\right)" :db/ensure :answer/validate} {:db/id "field-440f61f