b-1769f44615cb" "answer-3ff940d6-50f6-5c22-8529-93f0b7eacee0" "answer-57846694-b419-5de7-ae92-38a255d30bdb" "answer-12269985-fefb-5c23-968a-7d8718788ad1"] :answer-field/correct "answer-57846694-b419-5de7-ae92-38a255d30bdb" :db/ensure :answer-field/validate} {:db/id "question-79c8ea34-1bd6-588f-b5d4-02fab3b990c4" :question/id #uuid "79c8ea34-1bd6-588f-b5d4-02fab3b990c4" :question/problem "What is the exact value of $x$ if $e^{-7-2x}=\\sqrt[8]{7}$?" :question/worked-solution "Take the natural logarithm of both sides:\n\n$$\n\\begin{aligned}\\ln\\left(e^{-7-2x}\\right)&=\\ln\\left(\\sqrt[8]{7}\\right)\\end{aligned}\n$$\n\nUse $\\ln(e^u)=u$ and write the root as a fractional power:\n\n$$\n\\begin{aligned}-7-2x&=\\ln\\left(7^{1/8}\\right)\\end{aligned}\n$$\n\nApply the power rule for logarithms:\n\n$$\n\\begin{aligned}-7-2x&=\\frac{1}{8}\\ln\\left(7\\right)\\end{aligned}\n$$\n\nSubtract the constant term, then divide by the signed coefficient of $x$:\n\n$$\n\\begin{aligned}-2x&=\\frac{1}{8}\\ln\\left(7\\right)+7 \\\\ x&=-\\frac{7}{2}-\\frac{1}{16}\\ln\\left(7\\right)\\end{aligned}\n$$\n\nTherefore, $x=-\\frac{7}{2}-\\frac{1}{16}\\ln\\left(7\\right)$." :question/difficulty :question.difficulty/hard :question/answer-fields ["field-b8fac67c-2fcd-5ae0-8d10-b485f4328221"] :db/ensure :question/validate} [:db/add 17592186087689 :knowledge-point/questions "question-79c8ea34-1bd6-588f-b5d4-02fab3b990c4"] {:db/id "answer-234e8194-2d8d-5cde-a1e2-b640f6460d98" :answer/id #uuid "234e8194-2d8d-5cde-a1e2-b640f6460d98" :answer/type :answer.type/math :answer/value "y=-\\frac{3}{4}+\\frac{1}{12}\\ln\\left(7\\right)" :db/ensure :answer/validate} {:db/id "answer-f000568b-461e-59ad-b93c-55f0dbef50dc" :answer/id #uuid "f000568b-461e-59ad-b93c-55f0dbef50dc" :answer/type :answer.type/math :answer/value "y=-\\frac{9}{5}+\\frac{1}{15}\\ln\\left(7\\right)" :db/ensure :answer/validate} {:db/id "answer-1a96f707-81e6-5a62-afa7-7bc86ef0ae84" :answer/id #uuid "1a96f707-81e6-5a62-afa7-7bc86ef0ae84" :ans