#{[{:db/id #edb/ref 17592186105601 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186105744 :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"}] :question/id #uuid "80cde83c-b7fb-5ad7-bc3e-528e47151da4" :question/math-academy-id "e-4673" :question/problem "Evaluate $\\left(-\\dfrac{3}{2}\\right)^3.$" :question/worked-solution "First, notice that $-\\dfrac{3}{2}=\\dfrac{(-3)}{2}.$\n\nTo raise the fraction to the power of $3$, we must raise both the numerator and the denominator to the power of $3\\mathbin{:}$\n\n$$\n\\left(-\\dfrac{3}{2}\\right)^3=\\left(\\dfrac{(-3)}{2}\\right)^3=\\dfrac{(-3)^3}{2^3}\n$$\n\nNow, computing $(-3)^3=-27$ and $2^3=8,$ we get\n\n$$\n\\dfrac{(-3)^3}{2^3}= \\dfrac{-27}{8}=-\\dfrac{27}{8} .\n$$"}] [{:db/id #edb/ref 17592186606806 :knowledge-point/_questions [{:db/id #edb/ref 17592186105744 :knowledge-point/id #uuid "46cd136a-cc20-51e1-ac90-f8d9b787c5b3" :knowledge-point/title "Evaluating Powers of Negative Fractions Using the Power of Quotient Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42cd65bc-d9e3-575c-880e-5f547042de59" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{2}{25}" :db/id #edb/ref 17592186606286} {:answer/id #uuid "63c1ee52-f5a1-5ab0-a2c4-bc90cf56b6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{25}" :db/id #edb/ref 17592186606348 :task-item/_responses [{:db/id #edb/ref 17592186617973}]} {:answer/id #uuid "69d077d7-d3e5-5fb3-99a0-0d29cd211df4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186606363} {:answer/id #uuid "6d5c08a8-7083-57d3-a10d-cc8d9689fcc2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{5}" :db/id #edb/ref 17592186606372} {:answer/id #uuid "79803a46-0cff-5d82-8f58-37e89f86018c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-\\frac{4}{25}" :db/id #edb/ref 17592186606395}] :answer-field/correct {:answer/id #uuid "63c1ee52-f5a1-5ab0-a2c4-bc90cf56b6dd" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\frac{4}{25}" :db/id #edb/ref 17592186606348} :answer-field/id #uuid "58a10ff0-630f-59b7-82dd-95aa0fdce2c1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186606710}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "1f281aba-5807-5add-afd7-ec83d61c5b06" :question/math-academy-id "q-100748" :question/problem "${(-\\frac{2}{5})}^{2}=$" :question/worked-solution "First, notice that $-\\frac{2}{5}=\\frac{(-2)}{5}.$\n\nTo raise the fraction to the power of $2$, we must raise both the numerator and the denominator to the power of $2:$\n\n$$\n{(-\\frac{2}{5})}^{2}={(\\frac{(-2)}{5})}^{2}=\\frac{(-2)^{2}}{{5}^{2}}\n$$\n\nNow, using $(-2)^{2}=4$ and ${5}^{2}=25,$ we get\n\n$$\n\\frac{(-2)^{2}}{{5}^{2}}=\\frac{4}{25}.\n$$"}]}
