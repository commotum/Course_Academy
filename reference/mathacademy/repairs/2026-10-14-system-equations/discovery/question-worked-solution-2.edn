s+1/4}-\\frac{1}{s+1/4}\\cdot {lim}_{a\\to \\infty }{e}^{(-1/4-s)a}\\end{aligned}\n$$\n\nLet's evaluate the limit. We have\n\n$$\n\\begin{aligned}{lim}_{a\\to \\infty }{e}^{(-1/4-s)a}={\\begin{aligned}0,\\, & s>-\\frac{1}{4}, \\\\ \\infty ,\\, & s<-\\frac{1}{4}.\\end{aligned}\\end{aligned}\n$$\n\n- If $s=-\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F(-\\frac{1}{4}) & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-1/4-(-1/4))t}\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{0t}\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\text{d}t \\\\  & ={lim}_{a\\to \\infty }t\\,{|}_{0}^{a} \\\\  & ={lim}_{a\\to \\infty }(a-0) \\\\  & ={lim}_{a\\to \\infty }a \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore:\n\n- For $s\\le -\\frac{1}{4}$ the integral is divergent.\n\n- For $s>-\\frac{1}{4}$ the integral is convergent.\n\nEvaluating for $s>-\\frac{1}{4},$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot {lim}_{a\\to \\infty }{e}^{(-1/4-s)a} \\\\  & =\\frac{1}{s+1/4}-\\frac{1}{s+1/4}\\cdot 0 \\\\  & =\\frac{1}{s+1/4} \\\\  & =\\frac{4}{4s+1}.\\end{aligned}\n$$\n\nSo, the Laplace transform of $f(t)={e}^{-t/4}$ is $F(s)=\\frac{4}{4s+1},$ defined for $s>-\\frac{1}{4}.$"] [#edb/ref 17592186315028 "If $F(x)$ is defined on $x\\in [0,5),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)=\\{\\begin{aligned}F(x), & x\\in [0,5), \\\\ -F(-x), & x\\in (-5,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-5,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(3(-x)^{2}-2(-x)) \\\\  & =-(3{x}^{2}+2x) \\\\  & =-3{x}^{2}-2x.\\end{aligned}\n$$"] [#edb/ref 17592186315029 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-4(-x)^{2}-3(-x)) \\\\  & =-(-4{x}^{2}+3x) \\\\  & =4{x}^{2}-3x.\\end{aligned}\n$$"] [#edb/ref 17592186315030 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-2(-x)^{3}+3(-x)) \\\\  & =-(2{x}^{3}-3x) \\\\  & =-2{x}^{3}+3x.\\end{aligned}\n$$"] [#edb/ref 17592186315031 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)={\\begin{aligned}0,\\, & t<0 \\\\ 1,\\, & t\\ge 0.\\end{aligned}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(5-t)={\\begin{aligned}1,\\, & t\\le 5 \\\\ 0,\\, & t>5\\end{aligned}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(5-t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}1\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }0\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe compute this integral for $s>0$ as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{5}{e}^{-st}\\,\\text{d}t \\\\  & ={[-\\frac{{e}^{-st}}{s}]}_{0}^{5} \\\\  & =-\\frac{{e}^{-5s}}{s}+\\frac{1}{s} \\\\  & =\\frac{1}{s}(1-{e}^{-5s})\\end{aligned}\n$$"] [#edb/ref 17592186315035 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}-1,\\, & x\\le 4 \\\\ 1\\, & x>4\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}(-1)\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & =-{\\int }_{0}^{4}{e}^{-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }{e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & =-{\\int }_{0}^{4}{e}^{-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{s}{[{e}^{-st}]}_{0}^{4}+{\\int }_{4}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{-4s}}{s}-\\frac{1}{s}+{lim}_{a\\to \\infty }{\\int }_{4}^{a}{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{-4s}}{s}-\\frac{1}{s}+{lim}_{a\\to \\infty }{(-\\frac{{e}^{-st}}{s})|}_{4}^{a} \\\\  & =\\frac{{e}^{-4s}}{s}-\\frac{1}{s}-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-sa}-{e}^{-4s}) \\\\  & =\\frac{{e}^{-4s}}{s}-\\frac{1}{s}-\\frac{1}{s}(0-{e}^{-4s}) \\\\  & =\\frac{{e}^{-4s}}{s}-\\frac{1}{s}+\\frac{{e}^{-4s}}{s} \\\\  & =\\frac{2{e}^{-4s}}{s}-\\frac{1}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"] [#edb/ref 17592186315058 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2}}$ if there exist ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b \\\\ {x}_{1}\\begin{bmatrix}-1 \\\\ -4 \\\\ 3\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix} & =\\begin{bmatrix}-2 \\\\ 4 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}-{x}_{1}=-2 \\\\ -4{x}_{1}+{x}_{2}=4 \\\\ 3{x}_{1}-3{x}_{2}=1\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-1 & 0 & -2 \\\\ -4 & 1 & 4 \\\\ 3 & -3 & 1\\end{bmatrix} & {R}_{1} & :=-{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ -4 & 1 & 4 \\\\ 3 & -3 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+4{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 12 \\\\ 3 & -3 & 1\\end{bmatrix} & {R}_{3} & :={R}_{3}-3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 12 \\\\ 0 & -3 & -5\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & 2 \\\\ 0 & 1 & 12 \\\\ 0 & 0 & 31\\end{bmatrix}\\end{aligned}\n$$\n\nThe third row of the augmented matrix now corresponds to the equation $0{x}_{1}+0{x}_{2}=31,$ which has no solution.\n\nSo, there are no values of ${x}_{1}$ and ${x}_{2}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2} & =b.\\end{aligned}\n$$\n\nTherefore, we conclude that $b$ does *not* lie in $\\text{Span}{{a}_{1},{a}_{2}}.$"] [#edb/ref 17592186315059 "We know that $b\\in \\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+{x}_{3}\\begin{bmatrix}6 \\\\ 0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ -9 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n{\\begin{aligned}{x}_{1}+6{x}_{3}=-4 \\\\ -3{x}_{1}+{x}_{2}=-9 \\\\ {x}_{3}=-1\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 0 & 6 & -4 \\\\ -3 & 1 & 0 & -9 \\\\ 0 & 0 & 1 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & 6 & -4 \\\\ 0 & 1 & 18 & -21 \\\\ 0 & 0 & 1 & -1\\end{bmatrix} & {R}_{2} & :={R}_{2}-18{R}_{3} \\\\  & ∼\\begin{bmatrix}1 & 0 & 6 & -4 \\\\ 0 & 1 & 0 & -3 \\\\ 0 & 0 & 1 & -1\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}{x}_{1}+6{x}_{3}=-4 \\\\ {x}_{2}=-3 \\\\ {x}_{3}=-1.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-1.$ Substituting into the first equation gives \n\n$$\n{x}_{1}+6(-1)=-4\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}{{a}_{1},{a}_{2},{a}_{3}}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}2{a}_{1}+(-3){a}_{2}+(-1){a}_{3} & =b \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+(-3)\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ 0\\end{bmatrix}+(-1)\\cdot \\begin{bmatrix}6 \\\\ 0 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}-4 \\\\ -9 \\\\ -1\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot (-3)\\cdot (-1)=6.$"] [#edb/ref 17592186315064 "If $F(x)$ is defined on $x\\in [0,8),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,8), \\\\ -F(-x), & x\\in (-8,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-8,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-(-x)^{2}+5(-x)) \\\\  & =-(-{x}^{2}-5x) \\\\  & ={x}^{2}+5x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-3) & =(-3)^{2}+5(-3)=-6.\\end{aligned}\n$$"] [#edb/ref 17592186315070 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn this case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}-(-x) \\\\  & =-{x}^{3}+x.\\end{aligned}\n$$"] [#edb/ref 17592186315071 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}+2\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}+2\\operatorname{cos}⁡x.\\end{aligned}\n$$"] [#edb/ref 17592186315072 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(2(-x)+1){e}^{2(-x)} \\\\  & =(-2x+1){e}^{-2x}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-2) & =(-2(-2)+1){e}^{-2(-2)}=5{e}^{4}.\\end{aligned}\n$$"] [#edb/ref 17592186315073 "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{2}+2(-x)+3 \\\\  & ={x}^{2}-2x+3.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-3) & =(-3)^{2}-2(-3)+3=18.\\end{aligned}\n$$"] [#edb/ref 17592186315090 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)={\\begin{aligned}0,\\, & t<0 \\\\ 1,\\, & t\\ge 0.\\end{aligned}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(t-3)={\\begin{aligned}0,\\, & t<3 \\\\ 1,\\, & t\\ge 3\\end{aligned}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(t-3){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}0\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that this improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate this integral as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}{e}^{-st}\\,\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{(-\\frac{{e}^{-st}}{s})|}_{3}^{a} \\\\  & =-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-sa}-{e}^{-3s}) \\\\  & =-\\frac{1}{s}(0-{e}^{-3s}) \\\\  & =\\frac{{e}^{-3s}}{s}\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\nL{f(t)}=\\frac{{e}^{-3s}}{s},\\,s>0.\n$$"] [#edb/ref 17592186315092 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)={\\begin{aligned}0,\\, & t<0 \\\\ 1,\\, & t\\ge 0.\\end{aligned}\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\n\\begin{aligned}u(8-t)={\\begin{aligned}1,\\, & t\\le 8 \\\\ 0,\\, & t>8\\end{aligned}\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }u(8-t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{8}1\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{8}^{\\infty }0\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{8}{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe compute this integral for $s>0$ as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{8}{e}^{-st}\\,\\text{d}t \\\\  & ={[-\\frac{{e}^{-st}}{s}]}_{0}^{8} \\\\  & =-\\frac{{e}^{-8s}}{s}+\\frac{1}{s} \\\\  & =\\frac{1}{s}(1-{e}^{-8s})\\end{aligned}\n$$"] [#edb/ref 17592186315093 "If $F(x)$ is defined on $x\\in [0,10),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,10), \\\\ -F(-x), & x\\in (-10,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-10,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-((-x)^{2}-2(-x)) \\\\  & =-({x}^{2}+2x) \\\\  & =-{x}^{2}-2x.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-6) & =-(-6)^{2}-2(-6)=-24.\\end{aligned}\n$$"] [#edb/ref 17592186315100 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}3,\\, & t\\le 5 \\\\ {e}^{3t}\\, & t>5\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{