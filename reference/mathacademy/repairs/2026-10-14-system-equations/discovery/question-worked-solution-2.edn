{2}{e}^{(3-s)t}\\,\\text{d}t+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{3-s}{[{e}^{(3-s)t}]}_{0}^{2}+{\\int }_{2}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+{lim}_{a\\to \\infty }{\\int }_{2}^{a}2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+{lim}_{a\\to \\infty }{(\\frac{-2{e}^{-st}}{s})|}_{2}^{a} \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-2s}) \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}-\\frac{2}{s}\\cdot (0-{e}^{-2s}) \\\\  & =\\frac{{e}^{2(3-s)}-1}{3-s}+\\frac{2{e}^{-2s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"] [#edb/ref 17592186315102 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{5t},\\, & t\\le 1 \\\\ 1\\, & t>1\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{5t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{5t-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{(5-s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{1}{e}^{(5-s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{5-s}{[{e}^{(5-s)t}]}_{0}^{1}+{\\int }_{1}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+{lim}_{a\\to \\infty }{\\int }_{1}^{a}{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+{lim}_{a\\to \\infty }{(\\frac{-{e}^{-st}}{s})|}_{1}^{a} \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-s}) \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}-\\frac{1}{s}\\cdot (0-{e}^{-s}) \\\\  & =\\frac{{e}^{(5-s)}-1}{5-s}+\\frac{{e}^{-s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"] [#edb/ref 17592186315103 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{t},\\, & t\\le 4 \\\\ 2\\, & t>4\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{1-s}{[{e}^{(1-s)t}]}_{0}^{4}+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{\\int }_{4}^{a}2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{(\\frac{-2{e}^{-st}}{s})|}_{4}^{a} \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot (0-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"] [#edb/ref 17592186315105 "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{-3t},\\, & t\\le 1 \\\\ 4\\, & t>1\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{-(3+s)}{[{e}^{-(3+s)t}]}_{0}^{1}+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{\\int }_{1}^{a}4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{(\\frac{-4{e}^{-st}}{s})|}_{1}^{a} \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot (0-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$"] [#edb/ref 17592186317208 "By definition, $u\\in Π$ if there exist $t$ and $s$ such that\n\n$$\n\\begin{aligned}sb+tc & =u \\\\ s\\begin{bmatrix}1 \\\\ 7 \\\\ -3\\end{bmatrix}+t\\begin{bmatrix}-8 \\\\ 10 \\\\ -4\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ 9 \\\\ -4\\end{bmatrix}.\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}s-8t=6 \\\\ 7s+10t=9 \\\\ -3s-4t=-4\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & -8 & 6 \\\\ 7 & 10 & 9 \\\\ -3 & -4 & -4\\end{bmatrix} & {R}_{2} & :={R}_{2}-7{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ -3 & -4 & -4\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 66 & -33 \\\\ 0 & -28 & 14\\end{bmatrix} & {R}_{2} & :=\\frac{1}{66}{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & -28 & 14\\end{bmatrix} & {R}_{3} & :={R}_{3}+28{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -8 & 6 \\\\ 0 & 1 & -\\frac{1}{2} \\\\ 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}s-8t=6 \\\\ t=-\\frac{1}{2} \\\\ 0=0.\\end{aligned}\n$$\n\nFrom the second equation, we get\n\n$$\nt=-\\frac{1}{2}.\n$$\n\nSubstituting into the first equation, we get\n\n$$\n\\begin{aligned}s-8t & =6 \\\\ s-8(-\\frac{1}{2}) & =6 \\\\ s+4 & =6 \\\\ s & =2.\\end{aligned}\n$$\n\nSince we found a solution $s=2,\\,t=-\\frac{1}{2},$ we conclude that $u$ does indeed lie on the plane $Π.$ In fact, we have\n\n$$\nu=2b-\\frac{1}{2}c.\n$$\n\nFinally, $s\\cdot t=2\\cdot (-\\frac{1}{2})=-1.$"] [#edb/ref 17592186317213 "We know that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}$ if there exist ${x}_{1}$, ${x}_{2}$ and ${x}_{3}$ such that \n\n$$\n\\begin{aligned}{x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3} & =b \\\\ {x}_{1}\\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix}+{x}_{3}\\begin{bmatrix}-2 \\\\ 6 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -14 \\\\ -14\\end{bmatrix}\\end{aligned}\n$$\n\nSo, we have the following system of equations:\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=6 \\\\ -3{x}_{1}+{x}_{2}+6{x}_{3}=-14 \\\\ -3{x}_{2}+{x}_{3}=-14\\end{aligned}\n$$\n\nTo solve the system above, we set up and row reduce an augmented matrix:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 0 & -2 & 6 \\\\ -3 & 1 & 6 & -14 \\\\ 0 & -3 & 1 & -14\\end{bmatrix} & {R}_{2} & :={R}_{2}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & -3 & 1 & -14\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & 0 & -2 & 6 \\\\ 0 & 1 & 0 & 4 \\\\ 0 & 0 & 1 & -2\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{3}=6 \\\\ {x}_{2}=4 \\\\ {x}_{3}=-2.\\end{aligned}\n$$\n\nFrom the third equation, we get ${x}_{3}=-2.$ Substituting into the first equation gives \n\n$$\n{x}_{1}-2(-2)=6\\,⟹\\,{x}_{1}=2.\n$$\n\nSince the system has a solution, we can conclude that $b\\in \\text{Span}\\{{a}_{1},{a}_{2},{a}_{3}\\}.$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${a}_{1}$, ${a}_{2}$ and ${a}_{3}:$\n\n$$\n\\begin{aligned}2{a}_{1}+4{a}_{2}+(-2){a}_{3} & =b \\\\ 2\\cdot \\begin{bmatrix}1 \\\\ -3 \\\\ 0\\end{bmatrix}+4\\cdot \\begin{bmatrix}0 \\\\ 1 \\\\ -3\\end{bmatrix}+(-2)\\cdot \\begin{bmatrix}-2 \\\\ 6 \\\\ 1\\end{bmatrix} & =\\begin{bmatrix}6 \\\\ -14 \\\\ -14\\end{bmatrix}\\end{aligned}\n$$\n\nFinally, ${x}_{1}\\cdot {x}_{2}\\cdot {x}_{3}=2\\cdot 4\\cdot (-2)=-16.$"] [#edb/ref 17592186317259 "If ${x}_{1}{c}_{1}+{x}_{2}{c}_{2}=d,$ then we have\n\n$$\n\\begin{aligned}{x}_{1}\\begin{bmatrix}0 \\\\ 2 \\\\ 1\\end{bmatrix}+{x}_{2}\\begin{bmatrix}0 \\\\ -1 \\\\ -1\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}0 \\\\ 2{x}_{1} \\\\ {x}_{1}\\end{bmatrix}+\\begin{bmatrix}0 \\\\ -{x}_{2} \\\\ -{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 5 \\\\ 1\\end{bmatrix} \\\\ \\begin{bmatrix}0 \\\\ 2{x}_{1}-{x}_{2} \\\\ {x}_{1}-{x}_{2}\\end{bmatrix} & =\\begin{bmatrix}4 \\\\ 5 \\\\ 1\\end{bmatrix}.\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}0=4 \\\\ 2{x}_{1}-{x}_{2}=5 \\\\ {x}_{1}-{x}_{2}=1\\end{aligned}\n$$\n\nThe first equation is a false statement. Hence,the system has no solution."] [#edb/ref 17592186317320 "We say that three vectors ${v}_{1},{v}_{2},$ and ${v}_{3}$ are *linearly independent* if the only solution to the equation\n\n$$\n{x}_{1}{v}_{1}+{x}_{2}{v}_{2}+{x}_{3}{v}_{3}=0\n$$\n\nis ${x}_{1}={x}_{2}={x}_{3}=0.$ Otherwise, the vectors are *linearly dependent*.\n\nWith that in mind, let's examine our statements.\n\nThe equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ corresponds to the system\n\n$$\n\\{\\begin{aligned}{x}_{1}-2{x}_{2}+3{x}_{3}=0 \\\\ {x}_{2}-{x}_{3}=0 \\\\ -3{x}_{1}+{x}_{2}-4{x}_{3}=0.\\end{aligned}\n$$\n\nTo solve the system, we create its augmented matrix and reduce it using Gaussian elimination:\n\n$$\n\\begin{aligned}M & =\\begin{bmatrix}1 & -2 & 3 & 0 \\\\ 0 & 1 & -1 & 0 \\\\ -3 & 1 & -4 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+3{R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 0 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & -5 & 5 & 0\\end{bmatrix} & {R}_{3} & :={R}_{3}+5{R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -2 & 3 & 0 \\\\ 0 & 1 & -1 & 0 \\\\ 0 & 0 & 0 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nFrom the matrix above, we conclude that the basic variables are ${x}_{1}$ and ${x}_{2}$, while ${x}_{3}$ is the free variable. \n\nSince there is one free variable, the equation ${x}_{1}{a}_{1}+{x}_{2}{a}_{2}+{x}_{3}{a}_{3}=0$ has an infinite number of nonzero solutions, which means that the vectors are linearly dependent. \n\nTherefore, statements I and II are false, while statement III is true."] [#edb/ref 17592186317387 "If $b\\in \\text{Null}(A),$ then we must have $Ab=0.$ Substituting the given information, we get\n\n$$\n\\begin{aligned}Ab & =0 \\\\ \\begin{bmatrix}1 & 3 \\\\ 2 & 6\\end{bmatrix}\\begin{bmatrix}k \\\\ 3\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix} \\\\ \\begin{bmatrix}k+9 \\\\ 2k+18\\end{bmatrix} & =\\begin{bmatrix}0 \\\\ 0\\end{bmatrix}.\\end{aligned}\n$$\n\nThis corresponds to the system\n\n$$\n{\\begin{aligned}k+9=0 \\\\ 2k+18=0\\end{aligned}\n$$\n\nand for each of these equations, we obtain $k=-9.$"] [#edb/ref 17592186317403 "In order to determine whether $b$ lies in $\\text{Col}(D),$ we need to check if the equation $Dx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[D\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[D\\,|\\,b] & =\\begin{bmatrix}1 & -1 & 4 & 7 & 11 \\\\ 2 & 0 & 3 & -1 & -2 \\\\ 4 & 0 & 6 & -2 & 5 \\\\ 1 & 0 & 3 & -1 & 7\\end{bmatrix} & {R}_{3} & :={R}_{3}+(-2){R}_{2} \\\\  & ∼\\begin{bmatrix}1 & -1 & 4 & 7 & 11 \\\\ 2 & 0 & 3 & -1 & -2 \\\\ 0 & 0 & 0 & 0 & 9 \\\\ 1 & 0 & 3 & -1 & 7\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}{x}_{1}-{x}_{2}+4{x}_{3}+7{x}_{4}=11 \\\\ 2{x}_{1}+3{x}_{3}-{x}_{4}=-2 \\\\ 0=9 \\\\ {x}_{1}+3{x}_{3}-{x}_{4}=7.\\end{aligned}\n$$\n\nFrom the third equation, we get a false statement $0=9.$ Therefore, the system is inconsistent, and we conclude that $b\\notin \\text{Col}(D).$"] [#edb/ref 17592186317416 "In order to determine whether $b$ lies in $\\text{Col}(E),$ we need to check if the equation $Ex=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[E\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[E\\,|\\,b] & =\\begin{bmatrix}8 & -2 & 5 & 1 & 4 \\\\ 16 & -4 & 10 & 2 & -1 \\\\ 11 & -3 & 0 & -1 & 0\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-2){R}_{1} \\\\  & ∼\\begin{bmatrix}8 & -2 & 5 & 1 & 4 \\\\ 0 & 0 & 0 & 0 & -9 \\\\ 11 & -3 & 0 & -1 & 0\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n\\{\\begin{aligned}8{x}_{1}-2{x}_{2}+5{x}_{3}+{x}_{4}=4 \\\\ 0=-9 \\\\ 11{x}_{1}-3{x}_{2}-{x}_{4}=0.\\end{aligned}\n$$\n\nFrom the second equation, we get a false statement $0=-9.$ Therefore, the system is inconsistent, and we conclude that $b\\notin \\text{Col}(E).$"] [#edb/ref 17592186317417 "In order to determine whether $b$ lies in $\\text{Col}(F),$ we need to check if the equation $Fx=b$ is consistent. So, let's find the row echelon form of the augmented matrix $[F\\,|\\,b]$ as follows:\n\n$$\n\\begin{aligned}[F\\,|\\,b] & =\\begin{bmatrix}1 & -2 & 5 \\\\ 3 & 1 & 1\\end{bmatrix} & {R}_{2} & :={R}_{2}+(-3){R}_{1} \\\\  & ∼\\begin{bmatrix}1 & -2 & 5 \\\\ 0 & 7 & -14\\end{bmatrix}\\end{aligned}\n$$\n\nNow, we have the system\n\n$$\n{\\begin{aligned}{x}_{1}-2{x}_{2}=5 \\\\ 7{x}_{2}=-14.\\end{aligned}\n$$\n\nFrom the second equation we get ${x}_{2}=-2.$ Substituting into the first equation gives  ${x}_{1}=1.$ \n\nSince we have a solution, the equation $Fx=b$ is consistent, which implies that $b\\in \\text{Col}(F).$\n\nMoreover, there is exactly one solution, so we have exactly one way to write $b$ as a linear combination of ${f}_{1}$ and ${f}_{2}:$\n\n$$\n{{\\begin{bmatrix}5 \\\\ 1\\end{bmatrix}}_{⏟}}_{b}=1\\cdot {{\\begin{bmatrix}1 \\\\ 3\\end{bmatrix}}_{⏟}}_{{f}_{1}}+(-2)\\cdot {{\\begin{bmatrix}-2 \\\\ 1\\end{bmatrix}}_{⏟}}_{{f}_{2}}\n$$\n\nFinally, we get ${x}_{1}\\cdot {x}_{2}=1\\cdot (-2)=-2.$"] [#edb/ref 17592186317443 "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\n$$\n\nNow, we compute the derivative:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & ∼0+{\\sum }_{n=1}^{\\infty }{a}_{n}\\cdot (-\\frac{n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3}))+{b}_{n}\\cdot \\frac{n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & ∼{\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{′}$ and ${y}_{p}$ into the equation:\n\n$$\n\\begin{aligned} & ({\\sum }_{n=1}^{\\infty }-\\frac{{a}_{n}n\\pi }{3}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})+\\frac{{b}_{n}n\\pi }{3}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,-2(\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{3})+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{3})) \\\\  & \\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3})\\end{aligned}\n$$\n\nRearranging the terms, we get \n\n$$\n\\begin{aligned} & -2\\cdot \\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }(\\frac{{b}_{n}n\\pi }{3}-2{a}_{n})\\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,+{\\sum }_{n=1}^{\\infty }(-\\frac{{a}_{n}n\\pi }{3}-2{b}_{n})\\operatorname{sin}⁡(\\frac{n\\pi x}{3}) \\\\  & \\,\\,\\,\\,=-2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}\\pi }\\operatorname{cos}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$\n\nNow, equating the free terms and the coefficients next to sines and cosines, we obtain the following system:\n\n$$\n\\{\\begin{aligned}-2\\cdot \\frac{{a}_{0}}{2}=-2 \\\\ \\frac{{b}_{n}n\\pi }{3}-2{a}_{n}=\\frac{4}{{n}^{2}\\pi } \\\\ -\\frac{{a}_{n}n\\pi }{3}-2{b}_{n}=0\\end{aligned}\n$$\n\nFrom the first equation, ${a}_{0}=2,$ which means the constant term is given by\n\n$$\n\\frac{{a}_{0}}{2}=1.\n$$\n\nNext, from the third equation, ${b}_{n}=-\\frac{{a}_{n}n\\pi }{6}.$ Substituting this into the third equation, gives\n\n$$\n(-\\frac{{a}_{n}n\\pi }{6})\\frac{n\\pi }{3}-2{a}_{n}=\\frac{4}{{n}^{2}\\pi }\\,⇒\\,{a}_{n}=-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}.\n$$\n\nTherefore, for ${a}_{n}$ with $n\\ge 1,$ we have\n\n$$\n\\begin{aligned}{b}_{n} & =-\\frac{{a}_{n}n\\pi }{6} \\\\  & =-\\frac{n\\pi }{6}\\cdot (-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}) \\\\  & =\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}.\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{y}_{p}∼1 & +{\\sum }_{n=1}^{\\infty }\\,-\\frac{72}{{n}^{2}\\pi ({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{cos}⁡(\\frac{n\\pi x}{3}) \\\\  & +{\\sum }_{n=1}^{\\infty }\\,\\frac{12}{n({n}^{2}{\\pi }^{2}+36)}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{3}).\\end{aligned}\n$$"] [#edb/ref 17592186317448 "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\