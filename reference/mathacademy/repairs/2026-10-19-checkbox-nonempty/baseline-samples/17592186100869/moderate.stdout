              ":answer/value": "false"
            },
            {
              ":answer/id": "ffb1a197-0fcc-5422-9857-cc1625951a96",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
