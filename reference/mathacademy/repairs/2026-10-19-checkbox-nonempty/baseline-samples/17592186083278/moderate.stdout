    "question": {
      ":question/problem": "A curve is defined by the parametric equations\n\n$$\nx=2\\operatorname{sin}⁡t+5,\\,y=5\\operatorname{cos}⁡t-2,\\,3\\pi \\le t<5\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is vertical.",
      ":question/answer-fields": [
        {
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
