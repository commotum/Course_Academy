        {
          ":answer-field/id": "dee6063a-ddce-52a8-86a7-f5e0d850c4d5",
          ":answer-field/key": "VI",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "1b0fcc2f-e79a-53cd-94ba-19c374993156",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "5bb26662-eec4-5532-b2af-772b585f772c",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
