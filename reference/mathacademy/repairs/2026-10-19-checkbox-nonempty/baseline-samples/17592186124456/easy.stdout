            {
              ":answer/id": "10af4780-a4c0-55af-ab44-884fd110a4d5",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(-6,6)$ only"
            },
            {
              ":answer/id": "96119427-8ec6-5aaf-874c-ae7607374fd1",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(30,-30)$ only"
            },
            {
              ":answer/id": "25599aea-1b89-54dc-a602-dc829d2f1b94",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(6,6)$ only"
