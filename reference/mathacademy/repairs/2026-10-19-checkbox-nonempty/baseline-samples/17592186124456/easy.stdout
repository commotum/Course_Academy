    "question": {
      ":question/id": "ecd3c644-9946-5cc4-bee3-630d8a5d4c98",
      ":question/problem": "At which point on the curve $2 x y + y^{2}=- x^{2} + 2 y + 6$ is the tangent vector to the curve perpendicular to the vector $j$?",
      ":question/answer-fields": [
        {
          ":answer-field/id": "aec7ba67-6e0c-5958-8ff3-5e72ac3866e2",
