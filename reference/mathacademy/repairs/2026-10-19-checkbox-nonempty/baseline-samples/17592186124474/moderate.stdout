            "c5612ce8-549b-50fa-9234-02e69252a57e"
          ]
        },
        {
          ":answer-field/id": "8b2efbf5-9640-501b-9913-54bc78138ff9",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "21f66973-5cb9-5716-9cf3-7cfdab1ceafb",
