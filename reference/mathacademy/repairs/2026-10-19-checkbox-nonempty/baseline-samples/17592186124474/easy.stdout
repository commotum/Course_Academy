  {
    "knowledge_point": {
      "db_id": 17592186124474,
      "id": "149fa184-850f-52d8-a309-4b79a371a74d",
      "title": "Identifying the Intervals on Which a Function is Invertible Given a Description"
    },
    "question": {
      ":question/id": "075fd5bb-a918-5f7c-88eb-b8dd7fe04e00",
      ":question/difficulty": ":question.difficulty/easy",
      ":question/problem": "Given that $f(x)=0,$ on which of the following intervals is $f(x)$ invertible?\n\nSelect all that apply.\n\n- **I.** $x\\in (-\\infty,\\infty)$\n- **II.** $x\\in [0,\\infty)$\n- **III.** $x\\in (-2,2]$",
      ":question/worked-solution": "A function is invertible on a particular interval if and only if it is one-to-one on that interval.\n\nThe function is constant: distinct inputs in each listed interval have the same output $0$. Thus it is not one-to-one on any of the three intervals.\n\nTherefore, the correct answer is \"None of these intervals\".",
      ":question/answer-fields": [
        {
          ":answer-field/id": "f9696f51-dac2-55d2-92a4-a44c6e4282f3",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "15927e2f-d87a-5b38-9789-0bff4e212c37",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "9956f95d-4244-51f7-a00c-b381920412fc",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
