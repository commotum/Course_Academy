            },
            {
              ":answer/id": "0ea2ee24-017e-5749-93b9-6832577703a1",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{58}{5}"
            },
            {
              ":answer/id": "1716a342-c04c-5ebf-a868-be3e24191aeb",
              ":answer/type": ":answer.type/math",
              ":answer/value": "-\\frac{58}{5}"
            },
            {
              ":answer/id": "8ffa3548-1f08-5282-a587-ed388ffcfcaa",
