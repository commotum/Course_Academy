    "question": {
      ":question/id": "572e7f6b-0130-50e8-8cd4-189805162aed",
      ":question/problem": "Find $k$ given that the vectors $a=\u27e80,2,-3\u27e9$, $b=\u27e8-1,k,0\u27e9$, and $c=\u27e82,-3,1\u27e9$ are coplanar.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "bf29d8f3-c88d-5900-845a-15a6253d2a42",
          ":answer-field/key": "selection",
