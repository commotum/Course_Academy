            },
            {
              ":answer/id": "761e36db-f381-517d-950c-51915ff6fb25",
              ":answer/type": ":answer.type/math",
              ":answer/value": "B=\\begin{bmatrix}-6 & 0 & -8 \\\\ 0 & 9 & 0 \\\\ 0 & 0 & 0\\end{bmatrix}"
            },
            {
              ":answer/id": "9d0ad82b-0641-52ef-9d1d-0dee51a0c1de",
              ":answer/type": ":answer.type/math",
              ":answer/value": "D=\\begin{bmatrix}-1 & 0 & 0 \\\\ 0 & 8 & 0 \\\\ -6 & 7 & 10\\end{bmatrix}"
            },
            {
              ":answer/id": "82662c28-50b2-5936-b1c2-fce18995b21a",
              ":answer/type": ":answer.type/math",
              ":answer/value": "C=\\begin{bmatrix}-9 & -4 \\\\ -3 & -10\\end{bmatrix}"
            },
            {
              ":answer/id": "8af09085-143e-515a-ad85-d51a23cc3e47",
              ":answer/type": ":answer.type/math",
