    "question": {
      ":question/id": "ae6dd462-2818-55c7-9848-a3f8453805ae",
      ":question/problem": "Which of the following statements are true regarding the function $y = \\csc x$? Assume $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The domain of the function is all real numbers except $x = nπ$.\n- **II.** The function has a zero at $x = \\frac{-13π}{2}$.\n- **III.** The function takes the value $-1$ at $x =-\\frac{π}{2} + 2nπ$.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "2beabb32-5ec4-51d4-b5ec-414cd09b07db",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "c2bc3f2e-5f98-5aca-9c13-c8f46cc7498d",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "23fa6863-9368-58a0-b161-4295a383effe",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "23fa6863-9368-58a0-b161-4295a383effe"
          ]
        },
        {
          ":answer-field/id": "021b788a-8d74-5f3e-be64-a27894311404",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "e44ee648-4a48-5d02-8f34-41ea5856c87b",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "d0a22361-259f-5760-8e54-c16ba0f81937",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "e44ee648-4a48-5d02-8f34-41ea5856c87b"
          ]
        },
        {
          ":answer-field/id": "1c8f766b-7685-52bd-a391-71625e3364de",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "7e90d3f5-d08c-5cca-9399-0359438a7b20",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "f6be1e45-deeb-5a14-9fc1-f8e97af86797",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "f6be1e45-deeb-5a14-9fc1-f8e97af86797"
          ]
        }
      ],
      ":question/worked-solution": "Cosecant is defined exactly when x is not n*pi, never equals zero, and equals -1 at -pi/2+2n*pi.",
      ":question/difficulty": ":question.difficulty/moderate"
    },
