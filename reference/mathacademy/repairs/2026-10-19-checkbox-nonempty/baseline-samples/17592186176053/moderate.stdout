          ]
        },
        {
          ":answer-field/id": "99b98542-e45f-5303-ad20-0022363b261d",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "d7aadd7b-c79d-53c6-8510-2c6d241742b9",
