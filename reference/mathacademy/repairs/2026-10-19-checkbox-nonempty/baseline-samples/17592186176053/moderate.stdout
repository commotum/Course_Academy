    "question": {
      ":question/id": "e4d9c92d-4414-5d66-808b-864ac72d8f6f",
      ":question/problem": "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The range of the function is $(-\\infty ,-1].$\n- **II.** $y=-1$ is the maximum value of the function.\n- **III.** $x=-6\\pi $ is in the domain.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "cb1f9be3-eac1-5213-aa77-5b1d3d81cea6",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "488ed80e-080d-5bae-a061-8ae7e2365970",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "933a97b0-b199-51d4-8dde-304c3b1d4e37",
