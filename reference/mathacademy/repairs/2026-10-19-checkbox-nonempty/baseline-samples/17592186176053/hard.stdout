    "question": {
      ":question/id": "ac84cf64-f56d-578d-a621-4fbaa0edfe0b",
      ":question/problem": "Which of the following statements are true regarding the function $y=\\csc x$?\n\nSelect all that apply.\n\n- **I.** The point $(\\frac{-7\\pi }{2},-1)$ is on the graph.\n- **II.** $x=-15\\pi $ is a vertical asymptote.\n- **III.** $x=\\frac{7\\pi }{2}$ is in the domain.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "c348adbb-df92-5850-8082-fa9e2c9eb143",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "5672246d-e510-5c6c-9a14-023550de3c6d",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "d0741495-0e13-5fb2-8532-da277657ee1d",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "5672246d-e510-5c6c-9a14-023550de3c6d"
          ]
        },
        {
          ":answer-field/id": "f3cc67f9-5abb-5575-bee5-6cb3a92fa0db",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "c4382fd1-823f-5d2d-baf5-50c0226410bc",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "24d019d4-32e9-53d5-a4b2-cae47d27f315",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "24d019d4-32e9-53d5-a4b2-cae47d27f315"
          ]
        },
        {
          ":answer-field/id": "20584201-d31d-56e3-992e-3166bae360dc",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "20e387a4-62b7-51b1-8f46-4cc84b444c65",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "f6b359b0-6c8b-504c-92b8-3f1771f942cc",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
