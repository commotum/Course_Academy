          ]
        },
        {
          ":answer-field/id": "44607fc5-0492-53d7-9974-ccf7bd8110b8",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "2b344324-2d86-5228-9fb0-4111eb6bbf4a",
