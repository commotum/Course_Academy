          ":answer-field/choices": [
            {
              ":answer/id": "39372057-5930-5bb1-97e9-15cf8c50555d",
              ":answer/type": ":answer.type/math",
              ":answer/value": "t=\\frac{1}{2}"
            },
            {
              ":answer/id": "9b41d2ee-82ad-5528-8e24-7a1fa5cbd35a",
              ":answer/type": ":answer.type/math",
              ":answer/value": "t=\\frac{1}{2\\pi}"
            },
            {
              ":answer/id": "6585bbd5-2366-5209-9f88-d674566c0a56",
              ":answer/type": ":answer.type/math",
              ":answer/value": "t=2"
            },
            {
              ":answer/id": "f4881ac8-141d-53e3-bc7c-5b6ca84fae44",
              ":answer/type": ":answer.type/math",
              ":answer/value": "t=\\frac{\\pi}{2}"
            },
            {
