        {
          ":answer-field/id": "903b0f12-3f0f-5186-9ccf-2d1e6c173acf",
          ":answer-field/key": "The product $PR$ is well defined.",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
