          ":answer-field/key": "$A=\\begin{bmatrix}5 & -11 & -8 & -6 & -8 & 10 \\\\ 5 & 5 & 9 & -6 & -2 & 5 \\\\ -9 & 10 & 8 & -10 & -3 & 1 \\\\ -10 & 4 & 3 & 8 & 7 & -8\\end{bmatrix}$",
