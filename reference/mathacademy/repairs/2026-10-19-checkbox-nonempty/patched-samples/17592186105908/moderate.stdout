    "question": {
      ":question/id": "7a6c8c36-21b7-599c-a7e0-7dc1dac5afcf",
      ":question/problem": "Find $k$ given that the vectors $a=\u27e85,-5,-6\u27e9$, $b=\u27e83,k,k\u27e9$, and $c=\u27e8-7,-3,3\u27e9$ are coplanar.\n\n$k=${{field-1}}",
      ":question/answer-fields": [
        {
          ":answer-field/id": "26b45f58-8ca5-5992-801c-029bb4265419",
          ":answer-field/key": "field-1",
          ":answer-field/type": ":answer-field.type/blank",
          ":answer-field/choices": [
            {
              ":answer/id": "be3844f3-ddd0-587d-83e8-fccefb80325b",
