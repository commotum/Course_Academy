      ":question/problem": "Find $k$ given that the vectors $a=\u27e8-3,-2,-3\u27e9$, $b=\u27e8-2,k,-6\u27e9$, and $c=\u27e8-4,1,-8\u27e9$ are coplanar.\n\n$k=${{field-1}}",
      ":question/answer-fields": [
        {
          ":answer-field/id": "f8e4952a-f2af-53f8-9bbf-de8e22ae59ff",
          ":answer-field/key": "field-1",
          ":answer-field/type": ":answer-field.type/blank",
          ":answer-field/choices": [
            {
              ":answer/id": "8fca529c-d1d5-525b-b872-db33fe3fb7a5",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{7}{3}"
