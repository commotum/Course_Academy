              ":answer/value": "-3\\sqrt{2}"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "93f9d2d4-23c2-57f8-ab65-7091537f89d2"
          ]
        },
        {
          ":answer-field/id": "8a149873-28d1-577d-9733-3cd0ebc25099",
          ":answer-field/key": "field-2",
          ":answer-field/type": ":answer-field.type/blank",
          ":answer-field/choices": [
            {
              ":answer/id": "9f6b9d79-1c96-5e9d-aa4b-5983d6a4c981",
              ":answer/type": ":answer.type/math",
              ":answer/value": "3\\sqrt{2}"
            }
