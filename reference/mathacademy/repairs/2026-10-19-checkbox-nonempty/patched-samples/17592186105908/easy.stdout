            {
              ":answer/id": "283c07b0-9f57-535b-8263-0d2b30c20cc7",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{3}{8}"
            },
            {
              ":answer/id": "b19290e5-9509-5baa-9026-ed103767b157",
