            },
            {
              ":answer/id": "d3b3881d-eb77-59b2-9d98-2c09591b38c2",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{15}{2}"
            },
            {
              ":answer/id": "977304af-4e06-5378-88d5-5c8dba273dfa",
              ":answer/type": ":answer.type/math",
              ":answer/value": "-\\frac{3}{2}"
