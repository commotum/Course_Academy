    "question": {
      ":question/id": "bf6f31d3-c743-5fd4-ac88-fec0a1ee5187",
      ":question/problem": "Find $k$ given that the vectors $a=\u27e82,-1,1\u27e9$, $b=\u27e8-3,0,-3\u27e9$, and $c=\u27e80,k,1\u27e9$ are coplanar.\n\n$k=${{field-1}}",
      ":question/answer-fields": [
        {
          ":answer-field/id": "a9a1eac9-fbee-505b-bbe8-e07d8fdc8490",
          ":answer-field/key": "field-1",
