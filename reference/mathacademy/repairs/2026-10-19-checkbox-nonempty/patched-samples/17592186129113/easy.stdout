              ":answer/value": "$A$ only"
            },
            {
              ":answer/id": "c6eae625-d3d9-5881-8039-7b84a5725632",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$B$ only"
            },
            {
              ":answer/id": "64f07972-bdf3-55b1-8f87-ba2d992f02d8",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$B$ and $C$ only"
            },
            {
              ":answer/id": "fbec7dd5-0be5-5f82-9b04-0949b1fc08b5",
