  {
    "knowledge_point": {
      "db_id": 17592186176049,
      "id": "4241c7bd-4a2b-556f-be9f-8a884addebb9",
      "title": "Describing Properties of the Tangent Function"
    },
    "question": {
      ":question/id": "a5787660-79db-5b83-898e-c541d1c8944b",
      ":question/problem": "Which of the following statements are true regarding the function $y=\\tan x?$ Assume that $n$ is an integer.\n\nSelect all that apply.\n\n- **I.** The zeros of the function are exactly $x=\\frac{\\pi}{4}+n\\pi.$\n- **II.** The vertical asymptotes are exactly $x=\\frac{\\pi}{2}+n\\pi.$\n- **III.** The range of the function is $(-\\infty,\\infty).$",
      ":question/answer-fields": [
        {
          ":answer-field/id": "5e978545-04b6-5902-800c-42a7fbac71f3",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "1a3ccd7e-2f35-5e2d-8146-20f04675e947",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "8ec80a25-effd-5fbe-a7d7-98ce3b124bdc",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "1a3ccd7e-2f35-5e2d-8146-20f04675e947"
          ]
        },
        {
          ":answer-field/id": "112866f0-a5b4-5126-a4e4-912715fe1f4f",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "41903149-2501-5838-87c8-8b3ca0402416",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "76820ad1-f33e-5fe6-afba-b2bc1de21597",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "76820ad1-f33e-5fe6-afba-b2bc1de21597"
          ]
        },
        {
          ":answer-field/id": "5eab7e97-593b-5727-bf65-a70743da0ea2",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "160d97ae-123b-59dd-b13c-f07bb095227a",
              ":answer/type": ":answer.type/text",
