        {
          ":answer-field/id": "0bcb62be-62ee-51f6-8fad-83dd840127db",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "d64c419a-efa6-5644-9838-6c0a0847837b",
              ":answer/type": ":answer.type/text",
