            "3f06a416-b72f-5f11-8774-d85f31db31c5"
          ]
        },
        {
          ":answer-field/id": "01d45222-63c5-5568-9d02-a6395577d009",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "59eb69f1-f565-5dcc-8430-818974174b7f",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "c51e1bab-9379-5b1d-a553-84227ed0ab25",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "c51e1bab-9379-5b1d-a553-84227ed0ab25"
          ]
        },
        {
          ":answer-field/id": "52b07c0c-9362-5c85-9f36-8845f1c4c0da",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "725818c2-4db8-54ac-94ae-cb1b0885b803",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "7e1590b9-beae-55fb-84b6-b4fec3d1a7db",
              ":answer/type": ":answer.type/text",
