          ]
        },
        {
          ":answer-field/id": "d697e52a-2ada-5c2c-9341-4480fad3a5c8",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "19204017-e2e8-5768-84da-7f5c48c9d88b",
