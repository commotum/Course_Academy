          ]
        },
        {
          ":answer-field/id": "423e8510-0d9f-5814-a5fd-bddf9d7d2528",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
