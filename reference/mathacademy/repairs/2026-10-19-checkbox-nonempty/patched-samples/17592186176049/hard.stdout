        {
          ":answer-field/id": "036cfd31-ddae-582e-a725-0000f63347b1",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "f0030e02-8b59-5bfe-899a-60976d18c631",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "5f77ca50-1fe4-5059-a486-d8ad270a5743",
