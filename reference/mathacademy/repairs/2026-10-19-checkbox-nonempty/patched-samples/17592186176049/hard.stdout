          ]
        },
        {
          ":answer-field/id": "4a7c348c-4a4c-5eda-ab19-a295fd079d40",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "7d11225a-74ac-5002-b9cf-a70dc5973fd7",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "ff5a6726-d38f-50aa-bb9d-dc5f82425596",
