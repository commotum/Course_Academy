            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "dfac4a12-d99f-5f96-8877-4055f9b68b99"
          ]
        },
        {
          ":answer-field/id": "da63d32d-93a7-5986-9bba-8ad7eb8fba1f",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "de5b9214-e1fa-5742-8ecd-42bdc894151b",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "3465b318-9330-5f28-9504-159458c59c37",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
