    "question": {
      ":question/problem": "A curve is defined by the parametric equations \n\n$$\nx=2(t+1)^{7},\\,y=2t,\\,-\\infty <t<\\infty .\n$$\n\nDetermine the value of $t$ at which the tangent to the curve is vertical.",
      ":question/answer-fields": [
        {
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
