    "question": {
      ":question/problem": "A curve is defined by the parametric equations\n\n$$\nx=-5\\operatorname{sin}⁡t+7,\\,y=-5\\operatorname{cos}⁡t+4,\\,-3\\pi \\le t\\le -2\\pi .\n$$\n\nDetermine the values of $t$ at which the tangent to the curve is horizontal.",
      ":question/answer-fields": [
        {
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/value": "$t=-3\\pi $ and $t=-2\\pi $",
              ":answer/type": ":answer.type/text",
              ":answer/id": "1dc8a03e-7bac-5eb4-9658-bc74b800f4b0"
            },
            {
              ":answer/value": "$t=-\\frac{11\\pi }{4}$ and $t=-2\\pi $",
              ":answer/type": ":answer.type/text",
              ":answer/id": "e79aa198-ec67-573d-a4a9-d1d85368a423"
            },
            {
              ":answer/value": "$t=-\\frac{5\\pi }{2}$ and $t=-2\\pi $",
              ":answer/type": ":answer.type/text",
              ":answer/id": "8926bb7b-f917-5cc0-97ba-aa7d718d27f8"
            },
            {
              ":answer/value": "$t=-\\frac{11\\pi }{4}$ and $t=-\\frac{5\\pi }{2}$",
              ":answer/type": ":answer.type/text",
              ":answer/id": "a0bea62a-87fb-5db1-b8be-c173af72efa2"
            },
            {
              ":answer/value": "$t=-3\\pi $ and $t=-\\frac{5\\pi }{2}$",
              ":answer/type": ":answer.type/text",
              ":answer/id": "eddd0e14-6c88-57ad-88d6-42dc2563a9a8"
            }
          ],
          ":answer-field/id": "9d8dc755-59cb-51ec-88cd-1ffcaa1f678e",
          ":answer-field/correct": [
            ":answer/id",
