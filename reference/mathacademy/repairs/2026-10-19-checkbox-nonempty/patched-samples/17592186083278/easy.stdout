            ":answer/id",
            "8ace483f-fa9c-57f4-998f-c05f61c2313f"
          ]
        },
        {
          ":answer-field/key": "field-1",
          ":answer-field/type": ":answer-field.type/blank",
          ":answer-field/choices": [
            {
              ":answer/value": "\\frac{3\\pi }{4}",
              ":answer/type": ":answer.type/math",
              ":answer/id": "922f4bab-9bec-555f-9df5-0d5493f40377"
            }
          ],
          ":answer-field/id": "2f309ffd-3105-5928-847e-9baf3ad1bca4",
          ":answer-field/correct": [
            ":answer/id",
            "922f4bab-9bec-555f-9df5-0d5493f40377"
          ]
        }
      ],
      ":question/worked-solution": "The slope $m$ of a tangent line to a curve defined parametrically is given by\n\n$$\nm=\\frac{{y}^{′}(t)}{{x}^{′}(t)}.\n$$\n\nThe tangent line is horizontal if ${y}^{′}(t)=0$ while ${x}^{′}(t)\\ne 0.$\n\nSo, we first find the derivatives of $x$ and $y:$\n\n$$\n{x}^{′}(t)=-2{e}^{t}(\\operatorname{sin}⁡(t+\\frac{\\pi}{2})+\\operatorname{cos}⁡(t+\\frac{\\pi}{2})),\\,{y}^{′}(t)=3{e}^{t}(\\operatorname{cos}⁡(t+\\frac{\\pi}{2})-\\operatorname{sin}⁡(t+\\frac{\\pi}{2}))\n$$\n\nSolving ${y}^{′}(t)=0$ gives\n\n$$\n\\begin{aligned}3{e}^{t}(\\operatorname{cos}⁡(t+\\frac{\\pi}{2})-\\operatorname{sin}⁡(t+\\frac{\\pi}{2})) & =0 \\\\ \\operatorname{cos}⁡(t+\\frac{\\pi}{2})-\\operatorname{sin}⁡(t+\\frac{\\pi}{2}) & =0 \\\\ \\operatorname{sin}⁡(t+\\frac{\\pi}{2}) & =\\operatorname{cos}⁡(t+\\frac{\\pi}{2}) \\\\ \\frac{\\operatorname{sin}⁡(t+\\frac{\\pi}{2})}{\\operatorname{cos}⁡(t+\\frac{\\pi}{2})} & =1 \\\\ \\operatorname{tan}⁡(t+\\frac{\\pi}{2}) & =1 \\\\ t & =\\frac{3\\pi }{4},\\frac{7\\pi }{4}.\\end{aligned}\n$$\n\nNow, we note that \n\n$$\n\\begin{aligned}{x}^{′}(\\frac{3\\pi }{4}) & =-2{e}^{\\frac{3\\pi }{4}}[\\operatorname{sin}⁡(\\frac{5\\pi }{4})+\\operatorname{cos}⁡(\\frac{5\\pi }{4})]=2\\sqrt{2}{e}^{\\frac{3\\pi }{4}}\\ne 0, \\\\ {x}^{′}(\\frac{7\\pi }{4}) & =-2{e}^{\\frac{7\\pi }{4}}[\\operatorname{sin}⁡(\\frac{9\\pi }{4})+\\operatorname{cos}⁡(\\frac{9\\pi }{4})]=-2\\sqrt{2}{e}^{\\frac{7\\pi }{4}}\\ne 0,\\end{aligned}\n$$\n\nwhich confirms that the tangent to the curve is indeed horizontal at $t=\\frac{3\\pi }{4}$ and $t=\\frac{7\\pi }{4}.$",
      ":question/difficulty": ":question.difficulty/easy",
      ":question/id": "c280b212-0559-54d7-bca4-b433802e3f88"
    },
