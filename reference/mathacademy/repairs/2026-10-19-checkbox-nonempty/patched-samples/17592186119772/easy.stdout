            },
            {
              ":answer/id": "166ae125-144e-509b-90c1-3378bfd27bed",
              ":answer/type": ":answer.type/math",
              ":answer/value": "A=\\begin{bmatrix}10 & 0 \\\\ 4 & -1\\end{bmatrix}"
            },
            {
              ":answer/id": "7ae865cb-009d-5178-b09c-9672dd1ba574",
              ":answer/type": ":answer.type/math",
              ":answer/value": "B=\\begin{bmatrix}-4 & 0 & 0 \\\\ 0 & -5 & 0 \\\\ 5 & 0 & 9\\end{bmatrix}"
            },
