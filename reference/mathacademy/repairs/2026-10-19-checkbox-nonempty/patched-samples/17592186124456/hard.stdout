        {
          ":answer-field/id": "8e67cddf-24e7-51d4-85c4-97975a0d7097",
          ":answer-field/key": "VII",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "25499f5d-9de6-5aaa-b356-57771f21df0b",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "8689cf56-197b-5393-b686-f32d80ec9845",
              ":answer/type": ":answer.type/text",
