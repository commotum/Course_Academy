          ":answer-field/id": "51c4541d-19f5-5e6d-a7d7-cf58fe8ea002",
          ":answer-field/key": "VII",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "cca96e63-b39a-5741-93fc-8e06b1229a47",
              ":answer/type": ":answer.type/text",
