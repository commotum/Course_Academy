          ]
        },
        {
          ":answer-field/id": "c94f3b82-e12a-522f-a336-d709ddb15afe",
          ":answer-field/key": "VI",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "bd0c84a4-924a-598a-bfb0-8a4721753a9d",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "84181adc-4740-56bf-b67a-fc18fb3282ca",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "84181adc-4740-56bf-b67a-fc18fb3282ca"
