        {
          ":answer-field/id": "adf04e4a-52f5-50e9-9dd0-88694e6ccaab",
          ":answer-field/key": "VI",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "23db7258-c719-5efd-9561-3bf9186d8c52",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "1bf2c733-6ba4-5291-b0ef-e49000cef52a",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
