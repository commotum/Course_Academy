    "question": {
      ":question/id": "f2ce0e69-bc50-5874-8dd6-025ce2208386",
      ":question/problem": "At which point on the curve $8 x y + 4 y^{2}=- 4 x^{2} + 5 y + 30$ is the tangent vector to the curve perpendicular to the vector $j$?",
      ":question/answer-fields": [
        {
          ":answer-field/id": "e6efd047-1908-598f-b85c-7e048d9a199a",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "07694c6e-d2d9-5e2e-8237-e8d059cddaf8",
