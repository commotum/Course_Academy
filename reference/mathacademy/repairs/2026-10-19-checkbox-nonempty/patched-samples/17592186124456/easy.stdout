    "question": {
      ":question/id": "296c7f53-be57-59ca-bfc8-76157f8000e6",
      ":question/problem": "At which point on the curve $4 x y + 2 y^{2}=- 2 x^{2} + 2 y + 10$ is the tangent vector to the curve perpendicular to the vector $j$?",
      ":question/answer-fields": [
        {
          ":answer-field/id": "bed4a2bc-d23a-5212-aee7-e88c90457ec5",
          ":answer-field/key": "selection",
          ":answer-field/type": ":answer-field.type/radio",
          ":answer-field/choices": [
            {
              ":answer/id": "dd0526f2-3bc1-5cc4-8951-f5dacfc58f52",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(10,-10)$ only"
            },
            {
              ":answer/id": "1f514db3-4174-5b28-9708-47c437f583af",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(5,0)$ only"
            },
            {
              ":answer/id": "9c6806e5-6079-52a4-ad8e-5a087b9866bd",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(-5,5)$ only"
            },
            {
              ":answer/id": "e0c98019-04ca-52bc-a9a5-0d384f249f6a",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(5,-5)$ only"
            },
            {
              ":answer/id": "88bb8ca7-d7e7-59de-810e-3385b28fdaad",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(5,5)$ only"
