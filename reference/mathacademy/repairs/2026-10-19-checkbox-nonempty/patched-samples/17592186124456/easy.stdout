    "question": {
      ":question/id": "498607eb-388a-5804-b5a5-eee0d02ce2cb",
      ":question/problem": "At which point on the curve $6 x y + 3 y^{2}=- 3 x^{2} + 2 y + 8$ is the tangent vector to the curve perpendicular to the vector $j$?",
      ":question/answer-fields": [
        {
          ":answer-field/id": "dfe896bf-31c5-5e42-8c80-14f741b6e79b",
