            },
            {
              ":answer/id": "ea96ccc3-2256-51c8-8725-de44e5435195",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(-6,6)$ only"
            },
            {
              ":answer/id": "4d082da2-fa07-590d-9645-e66b57cb89e1",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(6,0)$ only"
            },
            {
              ":answer/id": "1f57034d-cfeb-5649-8fbb-36950448f414",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(30,-30)$ only"
