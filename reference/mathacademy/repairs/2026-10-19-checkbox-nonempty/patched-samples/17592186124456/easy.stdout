    "question": {
      ":question/id": "886ef305-878b-582b-8cb3-eb33c115b05e",
      ":question/problem": "At which point on the curve $4 x y + 2 y^{2}=- 2 x^{2} + 4 y + 4$ is the tangent vector to the curve perpendicular to the vector $j$?",
      ":question/answer-fields": [
        {
          ":answer-field/id": "528ddbbd-d189-55ce-887a-a12f92ad189b",
