      ":question/problem": "At which point on the curve $6 x y + 3 y^{2}=- 3 x^{2} + 2 y - 12$ is the tangent vector to the curve perpendicular to the vector $j$?",
      ":question/answer-fields": [
        {
          ":answer-field/id": "5cc1c934-4041-5b06-86b8-f7daabd4148e",
