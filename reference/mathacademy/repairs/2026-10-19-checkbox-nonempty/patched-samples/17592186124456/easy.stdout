    "question": {
      ":question/id": "2776e610-05a2-5a71-beb0-caf2cfec44dd",
      ":question/problem": "At which point on the curve $4 x y + 2 y^{2}=- 2 x^{2} + 3 y + 3$ is the tangent vector to the curve perpendicular to the vector $j$?",
      ":question/answer-fields": [
        {
          ":answer-field/id": "73f69e7f-1c26-562a-8666-24d67ab668f8",
          ":answer-field/key": "selection",
