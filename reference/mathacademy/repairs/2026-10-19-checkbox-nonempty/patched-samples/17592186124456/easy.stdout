              ":answer/id": "247ad23d-f2f3-5db5-932c-6710f0f971f1",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(3,-3)$ only"
            },
            {
              ":answer/id": "900a005f-e123-581c-a24e-304c61721a89",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(1,0)$ only"
            },
            {
              ":answer/id": "e27b2387-e7ce-5c83-9a23-728f1d653624",
              ":answer/type": ":answer.type/text",
              ":answer/value": "$(1,1)$ only"
