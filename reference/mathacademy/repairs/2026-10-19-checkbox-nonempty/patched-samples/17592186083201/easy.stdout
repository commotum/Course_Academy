              ":answer/value": "e^{27}"
            },
            {
              ":answer/id": "6362c8c3-9cb3-5a5b-bb1b-14ee9219a1b7",
              ":answer/type": ":answer.type/math",
              ":answer/value": "\\frac{1}{\\operatorname{ln}{\\left(27 \\right)}}"
            },
