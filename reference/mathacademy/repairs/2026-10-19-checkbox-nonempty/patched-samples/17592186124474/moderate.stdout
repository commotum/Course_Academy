              ":answer/value": "false"
            },
            {
              ":answer/id": "15fde68c-f0d2-5cef-990e-ffa8ee053a89",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "042d6e8e-8aca-5392-8869-e1619e5d2e71"
          ]
        },
        {
