              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "c0bf0825-9971-50a5-b419-beb039c65219"
          ]
        },
        {
          ":answer-field/id": "d6d1f2f6-e045-518b-96cb-bb23f2aea13e",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "bdc1b5f9-7882-5cfa-ad9e-13de78f6b9e8",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "2364e83d-ca3d-505e-97c7-7bea337fdc4c",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "bdc1b5f9-7882-5cfa-ad9e-13de78f6b9e8"
          ]
        }
      ],
      ":question/worked-solution": "Let's plot the graph of $y=\\csc x.$\n\n![](images/f1/f1b80c29b8f9f4d33aae94fc287d95b97cc5865b36ecc98f4f41e625dfc842e1.png)\n\nNow, let's go through each statement.\n\n- The cosecant graph does not intersect the $x$-axis. Hence, statement I is false.\n\n- The graph does not intersect the $y$-axis, as $x=0$ is not in the domain. Hence, statement II is true.\n\n- The range is unbounded above and below, so the function has no global minimum or maximum. Hence, statement III is false.",
      ":question/difficulty": ":question.difficulty/easy"
    },
