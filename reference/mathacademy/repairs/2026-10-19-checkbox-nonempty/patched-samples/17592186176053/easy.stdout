    "question": {
      ":question/id": "31125bdd-5b67-56d0-a42e-bd1d070464c7",
      ":question/problem": "Which of the following statements are true regarding the function $y=\\csc x$?\n\nSelect all that apply.\n\n- **I.** The graph has a zero at $x=0$.\n- **II.** The graph does not intersect the $y$-axis.\n- **III.** $y=1$ is the global minimum.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "e346a21c-6243-59de-940c-e8fd5734c5e6",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "40984c75-90a2-52e9-ba53-ff9c39c469c8",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "5589ce7c-c2cd-5619-8c21-1cbae16d516b",
              ":answer/type": ":answer.type/text",
