            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "40984c75-90a2-52e9-ba53-ff9c39c469c8"
          ]
        },
        {
          ":answer-field/id": "7a8f474c-5839-58f5-8f00-517f34a85f0c",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "bd4a4c57-3c44-5054-8f35-8e3640ab34c0",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "c0bf0825-9971-50a5-b419-beb039c65219",
