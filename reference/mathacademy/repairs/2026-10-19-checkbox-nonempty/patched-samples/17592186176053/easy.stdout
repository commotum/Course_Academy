    "question": {
      ":question/id": "b743b3b2-89bf-5910-8292-e33c0a13ccc3",
      ":question/problem": "Which of the following statements are true regarding the function $y=\\csc x$?\n\nSelect all that apply.\n\n- **I.** The domain is all real numbers except integer multiples of $\\pi$.\n- **II.** The range is $(-\\infty,-1]\\cup[1,\\infty)$.\n- **III.** $y=1$ is the global minimum.",
      ":question/answer-fields": [
        {
          ":answer-field/id": "845496e1-c9f4-5e66-aeb9-506a7c80b9fb",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "44dfe8e3-e8fa-5a53-9aa8-af5dfb5f1da0",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "40f190f9-a23d-5a49-8ed2-8471342cab37",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "40f190f9-a23d-5a49-8ed2-8471342cab37"
          ]
        },
        {
          ":answer-field/id": "44607fc5-0492-53d7-9974-ccf7bd8110b8",
          ":answer-field/key": "II",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "2b344324-2d86-5228-9fb0-4111eb6bbf4a",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "58d61fbc-6197-5e78-8f89-b54164c87e00",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
