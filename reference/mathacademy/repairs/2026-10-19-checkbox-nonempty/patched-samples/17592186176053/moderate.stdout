        {
          ":answer-field/id": "fe1ede3b-5478-5572-9a45-35f58842ee87",
          ":answer-field/key": "III",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "2c7bef5f-61b8-502c-8206-7e7006629a84",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "78330ca6-6eb7-52a2-b7aa-cafdc61a1b02",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
