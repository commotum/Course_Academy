            {
              ":answer/id": "f6be1e45-deeb-5a14-9fc1-f8e97af86797",
              ":answer/type": ":answer.type/text",
              ":answer/value": "true"
            }
          ],
          ":answer-field/correct": [
            ":answer/id",
            "f6be1e45-deeb-5a14-9fc1-f8e97af86797"
          ]
        }
      ],
      ":question/worked-solution": "Cosecant is defined exactly when x is not n*pi, never equals zero, and equals -1 at -pi/2+2n*pi.",
      ":question/difficulty": ":question.difficulty/moderate"
    },
