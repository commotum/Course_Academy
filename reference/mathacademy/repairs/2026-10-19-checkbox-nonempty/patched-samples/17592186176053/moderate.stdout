  {
    "knowledge_point": {
      "db_id": 17592186176053,
      "id": "92d6129b-a5c5-597a-86ee-3f19af20f326",
      "title": "Describing the General Properties of the Cosecant Function"
    },
    "question": {
      ":question/id": "e7f27c68-269c-5d40-8b40-873d16c64693",
      ":question/problem": "Which of the following statements are true regarding the function $y=\\operatorname{csc}⁡x?$\n\nSelect all that apply.\n\n- **I.** The domain of the function is all positive real numbers.\n- **II.** $x=\\frac{-17\\pi }{2}$ is a vertical asymptote of the function.\n- **III.** $\\operatorname{csc}⁡(x-12\\pi )=\\operatorname{csc}⁡(x-4\\pi ).$",
      ":question/answer-fields": [
        {
          ":answer-field/id": "5115635f-683c-5b7b-8d84-d7df4c9addfd",
          ":answer-field/key": "I",
          ":answer-field/type": ":answer-field.type/checkbox",
          ":answer-field/choices": [
            {
              ":answer/id": "046665d5-231a-5a19-945a-dc6ff9d435d9",
              ":answer/type": ":answer.type/text",
              ":answer/value": "false"
            },
            {
              ":answer/id": "11ffc8c5-56e0-52b4-bfc6-8e1a5f35f088",
              ":answer/type": ":answer.type/text",
