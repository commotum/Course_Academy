              ":answer/value": "I and III only"
            },
            {
              ":answer/id": "5ab45481-7953-5e03-adfa-b1b9401933b5",
              ":answer/type": ":answer.type/text",
              ":answer/value": "I only"
            },
            {
              ":answer/id": "e9e17dae-bbd4-500e-8b3e-310babb01797",
              ":answer/type": ":answer.type/text",
              ":answer/value": "I and II only"
            },
            {
              ":answer/id": "b34aeb25-a993-591e-af87-8a2c80faa52c",
