wer/id #uuid "4eb17f79-016a-5e9c-b6d6-e46c3b822d7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186297880} :answer-field/id #uuid "96cea0dd-cf80-5acf-9892-8cd8aa4d611a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299136}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "2eb6f27b-270d-54d9-87be-3557d2c76515" :question/math-academy-id "q-318588" :question/problem "Find $PQ,$ if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$P=\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}$</div>\n<div>$Q=\\begin{bmatrix}-4 & 2\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$PQ=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n<tr><td>{{field-5}}</td><td>{{field-6}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $P$ is a $3\\times 1$ matrix and $Q$ is a $1\\times 2$ matrix.  \n\nThere is $1$ column in matrix $P$ and $1$ row in matrix $Q$, so the product is well defined:\n\n$$\n{P}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{Q}_{\\boxed{\\text{1}}\\times 2}={PQ}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}PQ & =\\begin{bmatrix}0 \\\\ 3 \\\\ -1\\end{bmatrix}\\begin{bmatrix}-4 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot (-4) & 0\\cdot 2 \\\\ 3\\cdot (-4) & 3\\cdot 2 \\\\ (-1)\\cdot (-4) & (-1)\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -12 & 6 \\\\ 4 & -2\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338850 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a636472-3eda-542f-b7c3-23ae232bc2c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 14\\end{bmatrix}" :db/id #edb/ref 17592186336582} {:answer/id #uuid "b4de6dcb-4fe1-5185-b370-367b3c5e23aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & -1\\end{bmatrix}" :db/id #edb/ref 17592186337637} {:answer/id #uuid "de21dbdb-0d9a-5740-aec5-151cfe330af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186337964} {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} {:answer/id #uuid "f3f6c67a-5a58-56b5-8c25-9be2881adeb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 14\\end{bmatrix}" :db/id #edb/ref 17592186338163}] :answer-field/correct {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} :answer-field/id #uuid "89241c64-36b6-57dc-ba88-dc9eb9dc5ea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338528}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfec97ba-ccad-5e4f-97b5-a14f90d0cefb" :question/math-academy-id "q-70928" :question/problem "Find $BC$,  if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$B=\\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}$</div>\n<div>$C=\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}.$</div>\n</div>" :question/worked-solution "Here, $B$ is a $1\\times 3$ matrix and $C$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $B$ and $3$ rows in $C,$ so $B$ and $C$ are conformable for multiplication:\n\n$$\n{B}_{1\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{C}_{\\boxed{\\text{3}}\\times 2}={BC}_{1\\times 2}\n$$\n\nLet's compute $BC,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}=\\begin{bmatrix}-10 & ∗\\end{bmatrix}, &  & \\,-10=(-3)\\cdot 1+1\\cdot 3+(-2)\\cdot 5 \\\\  & \\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}=\\begin{bmatrix}-10 & -14\\end{bmatrix}, &  & \\,-14=(-3)\\cdot 2+1\\cdot 4+(-2)\\cdot 6\\end{aligned}\n$$\n\nTherefore, \n$BC=\\begin{bmatrix}-10 & -14\\end{bmatrix}.$"}] [{:db/id #edb/ref 17592186338852 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ab14835-d162-5a27-a085-b4b919a36b42" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186336132} {:answer/id #uuid "3315575e-eba2-51bc-a342-692c1283d7cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186336516} {:answer/id #uuid "618bb264-210a-53cf-ab61-500e5973c2f3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186336911} {:answer/id #uuid "9eb3cc5f-cfd1-5a82-9250-0d6ceda1e462" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186337467} {:answer/id #uuid "a0ed2cb6-42a7-55b4-8605-06dfe00b3780" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186337488}] :answer-field/correct {:answer/id #uuid "a0ed2cb6-42a7-55b4-8605-06dfe00b3780" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186337488} :answer-field/id #uuid "a63e7de0-266f-539b-8fee-e35ab81173de" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338586}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "44992928-91b6-50f2-9197-4b5da9dd00f2" :question/math-academy-id "q-70946" :question/problem "Let $D=EF.$ What is the value of ${d}_{23}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$E=\\begin{bmatrix}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{bmatrix}$</div>\n<div>$F=\\begin{bmatrix}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nD=\\begin{bmatrix}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{bmatrix}\\begin{bmatrix}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $E$ by the $3$rd column in $F$, we get\n\n$$\n\\begin{aligned}{d}_{23} & =\\begin{bmatrix}-4 & 3\\end{bmatrix}\\begin{bmatrix}-5 \\\\ -2\\end{bmatrix} \\\\  & =(-4)\\cdot (-5)+3\\cdot (-2) \\\\  & =20-6 \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338853 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07e95cad-860e-538a-8b99-9f0c70f261c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186336097} {:answer/id #uuid "57fc8d0d-2b20-52ee-b810-0e17521266a7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186336838} {:answer/id #uuid "75fb84e1-2b12-52e8-8a05-57918b78d168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337096} {:answer/id #uuid "a99efaa4-b49e-5cdd-af2c-d3ba9219b384" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186337563} {:answer/id #uuid "ad8fdf84-56c3-5819-a6bb-de4f89a6b352" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186337589}] :answer-field/correct {:answer/id #uuid "75fb84e1-2b12-52e8-8a05-57918b78d168" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186337096} :answer-field/id #uuid "7d3b9a44-3753-5606-8ec0-132a1ef649d1" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338499}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "bb301367-989b-59c3-9a3a-157e756a6cf8" :question/math-academy-id "q-70949" :question/problem "Let $K=MN.$ What is the value of ${k}_{12}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$M=\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix}$</div>\n<div>$N=\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nK=\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{12} & =\\begin{bmatrix}5 & -4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix} \\\\  & =5\\cdot (-1)+(-4)\\cdot (-2) \\\\  & =-5+8 \\\\  & =3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338855 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} {:answer/id #uuid "3b70ccb4-c16c-5cf5-b11e-8aafc5f11705" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186336590} {:answer/id #uuid "baedc752-7f92-5818-8e49-7eadefb98f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186337692} {:answer/id #uuid "d7a7677a-b2a4-59f0-ac24-ee44c46d1a26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186337904} {:answer/id #uuid "f431b48c-3499-5e6b-9764-458010a3f0be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186338165}] :answer-field/correct {:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} :answer-field/id #uuid "618939f6-04ba-5ea6-a01f-f04923f31488" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338449}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ed5dbc7-d94a-5c52-80fe-8e1e3e8256f9" :question/math-academy-id "q-70956" :question/problem "Let $T=UV.$ What is the value of ${t}_{41}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$U=\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix}$</div>\n<div>$V=\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nT=\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix}\n$$\n\nMultiplying the $4$th row of $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{41} & =\\begin{bmatrix}-5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =(-5)\\cdot (-2)+3\\cdot (-1)+10\\cdot (-1) \\\\  & =10-3-10 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186338856 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$P=\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix}$</div>\n<div>$Q=\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix}?$</div>\n</div>" :question/worked-solution "The full matrix product is\n\n$$\nR=\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix}\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =\\begin{bmatrix}3 & -4\\end{bmatrix}\\begin{bmatrix}10 \\\\ 7\\end{bmatrix} \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186396025 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396027} {:answer/id #uuid "17ab5397-bb38-59f6-9330-b062d867cf08" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396028} {:answer/id #uuid "bbc3f4eb-2bd2-548e-adb8-c1548530611b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396029} {:answer/id #uuid "cd31fdfe-ca0b-590b-9300-ed3e228812d5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186396030} {:answer/id #uuid "abaf4c24-a433-5f0e-9fa5-6f62768c563e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396031}] :answer-field/correct {:answer/id #uuid "c534267d-c67a-576d-a7c7-8f05a39d217f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "$$\n\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\n$$" :db/id #edb/ref 17592186396027} :answer-field/id #uuid "cb12cf5d-8771-503b-99b4-cf0f73c56ea7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186396026}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}0 \\\\ -2 \\\\ -3\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 2\\end{bmatrix}.$</div>\n</div>" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}0 \\\\ -2 \\\\ -3\\end{bmatrix}\\begin{bmatrix}1 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{bmatrix}\\end{aligned}\n$$"}]}
