#{[{:db/id #edb/ref 17592186299651 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582}] :answer-field/correct {:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582} :answer-field/id #uuid "7f84dc72-92a1-5353-b591-bdf85d6a4d27" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299069} {:answer-field/choices [{:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036}] :answer-field/correct {:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036} :answer-field/id #uuid "c6007ff8-9e9f-5fb3-89f5-bb5c4da4bf33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6b8e49d-bc16-5e49-870a-d27907495843" :question/math-academy-id "q-317846" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$3$</td></tr>\n<tr><td>$9$</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}=\\begin{bmatrix}-3 & ∗ \\\\ ∗ & -8\\end{bmatrix}, &  & \\,-3=1\\cdot 2+2\\cdot (-1)+(-1)\\cdot 3 \\\\  & \\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}=\\begin{bmatrix}-3 & 3 \\\\ 9 & -8\\end{bmatrix}, &  & \\,-8=0\\cdot 1+3\\cdot 0+4\\cdot (-2)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-3 & 3 \\\\ 9 & -8\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299652 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280013db-e870-5183-9372-d816ad98f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723}] :answer-field/correct {:answer/id #uuid "280013db-e870-5183-9372-d816ad98f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723} :answer-field/id #uuid "33eaef6a-e5d9-5210-b63a-9e30983de20d" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298815} {:answer-field/choices [{:answer/id #uuid "75360412-a790-5f78-ba8d-9d3583d9e3ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298060}] :answer-field/correct {:answer/id #uuid "75360412-a790-5f78-ba8d-9d3583d9e3ec" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186298060} :answer-field/id #uuid "4497312c-b639-5838-b4a9-f27d6e46fda8" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298871}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "4dabe113-4cf7-5192-92c8-d6891215d7d9" :question/math-academy-id "q-317847" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$4$</td></tr>\n<tr><td>$0$</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{bmatrix}=\\begin{bmatrix}5 & 4 \\\\ 0 & ∗\\end{bmatrix}, &  & \\,5=2\\cdot 1+(-1)\\cdot (-3)+0\\cdot 5 \\\\  & \\begin{bmatrix}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{bmatrix}=\\begin{bmatrix}5 & 4 \\\\ 0 & 7\\end{bmatrix}, &  & \\,7=4\\cdot 2+3\\cdot 0+1\\cdot (-1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}5 & 4 \\\\ 0 & 7\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299653 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813}] :answer-field/correct {:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813} :answer-field/id #uuid "4541560b-538b-5f05-b59c-8a9bf0f5a2d9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298874} {:answer-field/choices [{:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844}] :answer-field/correct {:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844} :answer-field/id #uuid "50d12860-4dc8-5d98-b731-8fe82a2cacc7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "630b6f29-5fc9-5ea7-9ec7-b34bacfad40e" :question/math-academy-id "q-317848" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>$-6$</td></tr>\n<tr><td>$11$</td><td>{{field-2}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 4$ matrix and $B$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $A$ and $4$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{4}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & ∗\\end{bmatrix}, &  & \\,-4=1\\cdot 2+0\\cdot 1+(-2)\\cdot 0+3\\cdot (-2) \\\\  & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}, &  & \\,-2=4\\cdot (-1)+1\\cdot 3+0\\cdot 4+(-1)\\cdot 1\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}.\n$$"}] [{:db/id #edb/ref 17592186299685 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d67c225-ea5d-5fbe-a116-cd581c4a82c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297872}] :answer-field/correct {:answer/id #uuid "4d67c225-ea5d-5fbe-a116-cd581c4a82c4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297872} :answer-field/id #uuid "0b459b10-8619-5f0d-afdd-56b9910358fb" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298672}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "0cf7bab6-9aaa-53a5-ad4b-30e1807bc5dc" :question/math-academy-id "q-318462" :question/problem "Let $P=QR.$ What is the value of ${p}_{31}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$Q=\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{bmatrix}?$</div>\n</div>\n\n${p}_{31}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nP=\\begin{bmatrix}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{bmatrix}\n$$\n\nMultiplying the $3$rd row in $Q$ by the $1$st column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{31} & =\\begin{bmatrix}2 & 1 & -2\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =2(5)+1(-3)+(-2)(1) \\\\  & =10-3-2 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299686 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "189eb742-90fe-54bc-83b7-cb1cb45420df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186297660}] :answer-field/correct {:answer/id #uuid "189eb742-90fe-54bc-83b7-cb1cb45420df" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-19" :db/id #edb/ref 17592186297660} :answer-field/id #uuid "cd3d9a0e-8498-5cbb-884b-c40fde8b221a" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299323}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "941171d1-f178-5deb-90c4-b1a669882e6a" :question/math-academy-id "q-318463" :question/problem "Let $X=YZ.$ What is the value of ${x}_{12}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$Y=\\begin{bmatrix}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{bmatrix}$</div>\n<div>$Z=\\begin{bmatrix}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{bmatrix}?$</div>\n</div>\n\n${x}_{12}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nX=\\begin{bmatrix}-2 & 3 & 0 \\\\ 1 & 4 & -1\\end{bmatrix}\\begin{bmatrix}0 & 5 & -1 \\\\ 2 & -3 & 4 \\\\ 1 & 1 & 0\\end{bmatrix}\n$$\n\nMultiplying the $1$st row in $Y$ by the $2$nd column in $Z$, we get\n\n$$\n\\begin{aligned}{x}_{12} & =\\begin{bmatrix}-2 & 3 & 0\\end{bmatrix}\\begin{bmatrix}5 \\\\ -3 \\\\ 1\\end{bmatrix} \\\\  & =(-2)(5)+3(-3)+0(1) \\\\  & =-10-9+0 \\\\  & =-19.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299687 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be3633fb-f7cb-5d0e-b147-f2113ff02e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298385}] :answer-field/correct {:answer/id #uuid "be3633fb-f7cb-5d0e-b147-f2113ff02e47" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186298385} :answer-field/id #uuid "04b1a5a5-69b5-54cc-9927-afbe16de429c" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298654}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d709c6eb-9e1b-5062-85d4-7521181b0638" :question/math-academy-id "q-318470" :question/problem "Let $Z=XY.$ What is the value of ${z}_{24}$, if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$X=\\begin{bmatrix}1 & -1 \\\\ 3 & 2\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{bmatrix}?$</div>\n</div>\n\n${z}_{24}=$\n{{field-1}}" :question/worked-solution "The full matrix product is\n\n$$\nZ=\\begin{bmatrix}1 & -1 \\\\ 3 & 2\\end{bmatrix}\\begin{bmatrix}2 & 0 & 5 & -3 \\\\ -4 & 1 & -1 & 2\\end{bmatrix}\n$$\n\nMultiplying the $2$nd row in $X$ by the $4$th column in $Y,$ we get\n\n$$\n\\begin{aligned}{z}_{24} & =\\begin{bmatrix}3 & 2\\end{bmatrix}\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix} \\\\  & =3(-3)+2(2) \\\\  & =-9+4 \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299688 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90d5156d-1d4d-58d0-b3db-f06dc3110af2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186298182}] :answer-field/correct {:answer/id #uuid "90d5156d-1d4d-58d0-b3db-f06dc3110af2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-15" :db/id #edb/ref 17592186298182} :answer-field/id #uuid "60ee3141-5ab6-5a49-864a-59e094c19044" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298967} {:answer-field/choices [{:answer/id #uuid "cdcbaa46-9cac-5426-ab3d-927a136593d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298450}] :answer-field/correct {:answer/id #uuid "cdcbaa46-9cac-5426-ab3d-927a136593d5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186298450} :answer-field/id #uuid "777110cd-e150-534d-a2cc-8ff44e91e456" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299040} {:answer-field/choices [{:answer/id #uuid "11781e0e-cbc8-5673-b303-fddb5dd204cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297630}] :answer-field/correct {:answer/id #uuid "11781e0e-cbc8-5673-b303-fddb5dd204cb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186297630} :answer-field/id #uuid "eb00e7e1-8810-52ee-a695-867da382934b" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299431} {:answer-field/choices [{:answer/id #uuid "6bcc1e4f-a4bf-5a59-8f24-9a6a1ab50a16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298016}] :answer-field/correct {:answer/id #uuid "6bcc1e4f-a4bf-5a59-8f24-9a6a1ab50a16" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298016} :answer-field/id #uuid "eb0feda7-eeae-5b52-8b25-7199991e023a" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299432}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "1050bc77-12b5-5216-85bc-cb476e852617" :question/math-academy-id "q-318484" :question/problem "If\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}5 \\\\ -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & -3\\end{bmatrix},$</div>\n</div>\n\nfind $AB.$\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,5=5\\cdot 1 \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-15=5\\cdot (-3) \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ -2 & ∗\\end{bmatrix}, &  & \\,-2=-2\\cdot 1 \\\\  & \\begin{bmatrix}5 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -3\\end{bmatrix}=\\begin{bmatrix}5 & -15 \\\\ -2 & 6\\end{bmatrix}, &  & \\,6=-2\\cdot (-3)\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}5 & -15 \\\\ -2 & 6\\end{bmatrix}.$"}] [{:db/id #edb/ref 17592186299689 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fcdd0ac-c4d8-5dd7-8ce4-29a07e65c610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298029}] :answer-field/correct {:answer/id #uuid "6fcdd0ac-c4d8-5dd7-8ce4-29a07e65c610" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298029} :answer-field/id #uuid "3d3ccc6b-89ba-5ba8-8a64-d1dd15121053" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298846} {:answer-field/choices [{:answer/id #uuid "874c93ff-44ad-5c2e-8a4f-77019c4f2b86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298140}] :answer-field/correct {:answer/id #uuid "874c93ff-44ad-5c2e-8a4f-77019c4f2b86" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186298140} :answer-field/id #uuid "4de9dcd3-c548-55ae-96de-6e52cab045c0" :answer-field/key "field-6" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298897} {:answer-field/choices [{:answer/id #uuid "2ae40015-4fcb-586e-8a84-7d4f6a259e22" :answer/ty