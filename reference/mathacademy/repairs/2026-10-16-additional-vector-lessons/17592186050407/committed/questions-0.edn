2186291281} :answer-field/id #uuid "abe38b73-0e74-5167-9521-8f2884b60365" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292271} {:answer-field/choices [{:answer/id #uuid "f0c345c6-6295-5859-bb04-8abe34723bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291640}] :answer-field/correct {:answer/id #uuid "f0c345c6-6295-5859-bb04-8abe34723bf3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291640} :answer-field/id #uuid "e469f8ff-a383-5164-893f-961b9fa40f93" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292448}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9fed3a53-838e-5362-83b9-fbd6582bdbcb" :question/math-academy-id "q-275548" :question/problem "Find $AB,$ if\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & -2\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>{{field-4}}</td></tr>\n<tr><td>{{field-5}}</td><td>{{field-6}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix.  \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have\n\n$$\n\\begin{aligned}AB & =\\begin{bmatrix}1 \\\\ 2 \\\\ -2\\end{bmatrix}\\begin{bmatrix}1 & -2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1\\cdot 1 & 1\\cdot (-2) \\\\ 2\\cdot 1 & 2\\cdot (-2) \\\\ (-2)\\cdot 1 & (-2)\\cdot (-2)\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & -2 \\\\ 2 & -4 \\\\ -2 & 4\\end{bmatrix}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186299650 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8b4b7ed-ec16-5051-9f0e-eb339152d483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298612}] :answer-field/correct {:answer/id #uuid "f8b4b7ed-ec16-5051-9f0e-eb339152d483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298612} :answer-field/id #uuid "15ffdd5d-cba0-5c32-87d9-4839958abffd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298718} {:answer-field/choices [{:answer/id #uuid "3fa46adc-8027-5641-a584-e1425ce04dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297804}] :answer-field/correct {:answer/id #uuid "3fa46adc-8027-5641-a584-e1425ce04dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297804} :answer-field/id #uuid "8e119f09-47a5-5dec-ac9c-c82dedbeca32" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299110} {:answer-field/choices [{:answer/id #uuid "88726dca-a737-55cf-95d1-988140183f17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298144}] :answer-field/correct {:answer/id #uuid "88726dca-a737-55cf-95d1-988140183f17" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298144} :answer-field/id #uuid "a1fce966-93a7-54f8-95d2-3d3409a72b26" :answer-field/key "field-4" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299177} {:answer-field/choices [{:answer/id #uuid "b0321b13-a295-53cb-a371-3e8e5bcf85c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298321}] :answer-field/correct {:answer/id #uuid "b0321b13-a295-53cb-a371-3e8e5bcf85c0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298321} :answer-field/id #uuid "a70b6697-328c-5680-9885-0831c3f71d33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299202} {:answer-field/choices [{:answer/id #uuid "6d65f162-8e57-5988-ae37-7fc0a3a81a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298023}] :answer-field/correct {:answer/id #uuid "6d65f162-8e57-5988-ae37-7fc0a3a81a62" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186298023} :answer-field/id #uuid "e077f806-8c76-58d7-8656-a1a6651077bf" :answer-field/key "field-3" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299399}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "9fa531ce-0734-5931-947d-bd011cbc557d" :question/math-academy-id "q-317844" :question/problem "Determine $AB$ given that\n\n<div class=\"matrix-operands matrix-operands-stacked\">\n<div>$A=\\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}.$</div>\n</div>\n\n<div class=\"matrix-answer\">\n<span class=\"matrix-answer-label\">$AB=$</span>\n<div class=\"matrix-answer-brackets\">\n<table aria-label=\"Answer matrix\"><tbody>\n<tr><td>{{field-1}}</td><td>{{field-2}}</td></tr>\n<tr><td>{{field-3}}</td><td>$9$</td></tr>\n<tr><td>{{field-4}}</td><td>$14$</td></tr>\n<tr><td>$5$</td><td>{{field-5}}</td></tr>\n</tbody></table>\n</div>\n</div>" :question/worked-solution "Here, $A$ is a $4\\times 2$ matrix and $B$ is a $2\\times 2$ matrix. \n\nThere are $2$ columns in $A$ and $2$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{4\\times \\boxed{\\text{2}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{2}}\\times 2}={AB}_{4\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & ∗ \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,2=2\\cdot 1+1\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,-1=2\\cdot (-2)+1\\cdot 3 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,0=0\\cdot 1+3\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,-1=(-1)\\cdot 1+4\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}, &  & \\,-4=5\\cdot (-2)+2\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}.$"}]}
