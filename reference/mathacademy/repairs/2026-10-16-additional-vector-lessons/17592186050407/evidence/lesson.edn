&  & \\,7=4\\cdot 2+3\\cdot 0+1\\cdot (-1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}5 & 4 \\\\ 0 & 7\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299653 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813}] :answer-field/correct {:answer/id #uuid "40db654b-b0b0-5e57-99bb-9ec1e8b2cc13" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186297813} :answer-field/id #uuid "4541560b-538b-5f05-b59c-8a9bf0f5a2d9" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298874} {:answer-field/choices [{:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844}] :answer-field/correct {:answer/id #uuid "475c78d9-adc8-54df-a099-d10b7fda3096" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297844} :answer-field/id #uuid "50d12860-4dc8-5d98-b731-8fe82a2cacc7" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298910}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "630b6f29-5fc9-5ea7-9ec7-b34bacfad40e" :question/math-academy-id "q-317848" :question/problem "Determine $AB$ given that \n$A=\\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $-6$ |  |\n| --- | --- | --- | --- | --- |\n|  | $11$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 4$ matrix and $B$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $A$ and $4$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{4}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & ∗\\end{bmatrix}, &  & \\,-4=1\\cdot 2+0\\cdot 1+(-2)\\cdot 0+3\\cdot (-2) \\\\  & \\begin{bmatrix}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{bmatrix}\\begin{bmatrix}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{bmatrix}=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}, &  & \\,-2=4\\cdot (-1)+1\\cdot 3+0\\cdot 4+(-1)\\cdot 1\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-4 & -6 \\\\ 11 & -2\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186338850 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a636472-3eda-542f-b7c3-23ae232bc2c8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & 14\\end{bmatrix}" :db/id #edb/ref 17592186336582} {:answer/id #uuid "b4de6dcb-4fe1-5185-b370-367b3c5e23aa" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 & -1\\end{bmatrix}" :db/id #edb/ref 17592186337637} {:answer/id #uuid "de21dbdb-0d9a-5740-aec5-151cfe330af1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 & -7\\end{bmatrix}" :db/id #edb/ref 17592186337964} {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} {:answer/id #uuid "f3f6c67a-5a58-56b5-8c25-9be2881adeb5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}5 & 14\\end{bmatrix}" :db/id #edb/ref 17592186338163}] :answer-field/correct {:answer/id #uuid "e685a16c-8e3b-5c1a-b2cb-d9f49b5dd990" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -14\\end{bmatrix}" :db/id #edb/ref 17592186338044} :answer-field/id #uuid "89241c64-36b6-57dc-ba88-dc9eb9dc5ea3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338528}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "cfec97ba-ccad-5e4f-97b5-a14f90d0cefb" :question/math-academy-id "q-70928" :question/problem "Find $BC$,  if  $B=\\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}$ and $C=\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}.$" :question/worked-solution "Here, $B$ is a $1\\times 3$ matrix and $C$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $B$ and $3$ rows in $C,$ so $B$ and $C$ are conformable for multiplication:\n\n$$\n{B}_{1\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{C}_{\\boxed{\\text{3}}\\times 2}={BC}_{1\\times 2}\n$$\n\nLet's compute $BC,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}=\\begin{bmatrix}-10 & ∗\\end{bmatrix}, &  & \\,-10=(-3)\\cdot 1+1\\cdot 3+(-2)\\cdot 5 \\\\  & \\begin{bmatrix}-3 & 1 & -2\\end{bmatrix}\\begin{bmatrix}1 & 2 \\\\ 3 & 4 \\\\ 5 & 6\\end{bmatrix}=\\begin{bmatrix}-10 & -14\\end{bmatrix}, &  & \\,-14=(-3)\\cdot 2+1\\cdot 4+(-2)\\cdot 6\\end{aligned}\n$$\n\nTherefore, \n$BC=\\begin{bmatrix}-10 & -14\\end{bmatrix}.$"}] :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"} {:db/id #edb/ref 17592186100873 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100695 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"}] :question/id #uuid "3a696ed3-e341-5ea6-bf17-681ba8e386c7" :question/math-academy-id "e-4407" :question/problem "Let $C=AB.$ What is the value of $c_{32}$, if\n\n\n$$\nA=\\begin{bmatrix}1 & 2 \\\\ -2 & 0 \\\\ 1 & 2\\end{bmatrix},\\qquad B=\\begin{bmatrix}3 & 4 & -1 \\\\ 1 & -2 & 2\\end{bmatrix}?\n$$\n\n" :question/worked-solution "Multiplying the $3$rd row in $A$ by the $2$nd column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{32} & =\\begin{bmatrix}1 & 2 \\\\ -2 & 0 \\\\ 1 & 2\\end{bmatrix}\\begin{bmatrix}3 & 4 & -1 \\\\ 1 & -2 & 2\\end{bmatrix} \\\\  & =\\begin{bmatrix}1 & 2\\end{bmatrix}\\begin{bmatrix}4 \\\\ -2\\end{bmatrix} \\\\  & =1\\cdot 4+2\\cdot (-2) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$"} :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/question-generator {:db/id #edb/ref 17592186521964} :knowledge-point/questions [{:db/id #edb/ref 17592186101529 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da11c7dd-d121-5ec6-a851-0550acc8383c" :answer/type {:db/id #edb/ref 17592186045498 