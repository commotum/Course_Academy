d #uuid "8ce9cddf-2413-5e15-89c7-45b259cab3b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 18 \\\\ 15 & 9\\end{bmatrix}" :db/id #edb/ref 17592186236707}] :answer-field/correct {:answer/id #uuid "8ce9cddf-2413-5e15-89c7-45b259cab3b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 & 18 \\\\ 15 & 9\\end{bmatrix}" :db/id #edb/ref 17592186236707} :answer-field/id #uuid "a44f4bb4-30a2-5a30-959a-18587874cdc3" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237655}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "53274149-3160-5be4-b6eb-415d49f449f3" :question/math-academy-id "q-1033" :question/problem "If\n$E=\\begin{bmatrix}1 & -2 & 4 & 5 \\\\ 3 & -1 & 0 & 1\\end{bmatrix}$\nand\n$F=\\begin{bmatrix}4 & 2 \\\\ -3 & -1 \\\\ -2 & 1 \\\\ 0 & 2\\end{bmatrix}$\nthen $EF=$" :question/worked-solution "Here, $E$ is a $2\\times 4$ matrix and $F$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $E$ and $4$ rows in $F,$ so $E$ and $F$ are conformable for multiplication:\n\n$$\n{E}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{F}_{\\boxed{\\text{4}}\\times 2}={EF}_{2\\times 2}\n$$\n\nLet's compute $EF,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & -2 & 4 & 5 \\\\ 3 & -1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ -3 & -1 \\\\ -2 & 1 \\\\ 0 & 2\\end{bmatrix}=\\begin{bmatrix}2 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,2=1\\cdot 4+(-2)\\cdot (-3)+4\\cdot (-2)+5\\cdot 0 \\\\  & \\begin{bmatrix}1 & -2 & 4 & 5 \\\\ 3 & -1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ -3 & -1 \\\\ -2 & 1 \\\\ 0 & 2\\end{bmatrix}=\\begin{bmatrix}2 & 18 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,18=1\\cdot 2+(-2)\\cdot (-1)+4\\cdot 1+5\\cdot 2 \\\\  & \\begin{bmatrix}1 & -2 & 4 & 5 \\\\ 3 & -1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ -3 & -1 \\\\ -2 & 1 \\\\ 0 & 2\\end{bmatrix}=\\begin{bmatrix}2 & 18 \\\\ 15 & ∗\\end{bmatrix}, &  & \\,15=3\\cdot 4+(-1)\\cdot (-3)+0\\cdot (-2)+1\\cdot 0 \\\\  & \\begin{bmatrix}1 & -2 & 4 & 5 \\\\ 3 & -1 & 0 & 1\\end{bmatrix}\\begin{bmatrix}4 & 2 \\\\ -3 & -1 \\\\ -2 & 1 \\\\ 0 & 2\\end{bmatrix}=\\begin{bmatrix}2 & 18 \\\\ 15 & 9\\end{bmatrix}, &  & \\,9=3\\cdot 2+(-1)\\cdot (-1)+0\\cdot 1+1\\cdot 2\\end{aligned}\n$$\n\nTherefore, \n$EF=\\begin{bmatrix}2 & 18 \\\\ 15 & 9\\end{bmatrix}.$"} {:db/id #edb/ref 17592186238011 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f7a62ec-13b8-543d-9616-121868053523" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}20 \\\\ 4\\end{bmatrix}" :db/id #edb/ref 17592186236016} {:answer/id #uuid "22e57d49-7fd7-563f-abb5-64190ff4aa02" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}20 & 24 \\\\ 4 & 1\\end{bmatrix}" :db/id #edb/ref 17592186236039} {:answer/id #uuid "24e7f5a9-a414-5f74-91fa-736878205105" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & -24\\end{bmatrix}" :db/id #edb/ref 17592186236055} {:answer/id #uuid "6b9d6d90-f170-5014-9e02-b7a17b19bb73" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-20 \\\\ -4\\end{bmatrix}" :db/id #edb/ref 17592186236497} {:answer/id #uuid "bf7d5586-3d96-5a03-86a4-ba2ed71c39b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}24 & 1\\end{bmatrix}" :db/id #edb/ref 17592186237034}] :answer-field/correct {:answer/id #uuid "bf7d5586-3d96-5a03-86a4-ba2ed71c39b0" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}24 & 1\\end{bmatrix}" :db/id #edb/ref 17592186237034} :answer-field/id #uuid "c96651e8-d8ed-5375-92a8-7fde59b35ca0" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237698}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "83b01661-23af-5f73-bcb3-22f2f416f38b" :question/math-academy-id "q-1035" :question/problem "Find $ST$,  if  $S=\\begin{bmatrix}2 & -3 & 1 & 4\\end{bmatrix}$ and $T=\\begin{bmatrix}1 & -2 \\\\ 0 & 4 \\\\ -2 & 1 \\\\ 6 & 4\\end{bmatrix}.$" :question/worked-solution "Here, $S$ is a $1\\times 4$ matrix and $T$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $S$ and $4$ rows in $T,$ so $S$ and $T$ are conformable for multiplication:\n\n$$\n{S}_{1\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{T}_{\\boxed{\\text{4}}\\times 2}={ST}_{1\\times 2}\n$$\n\nLet's compute $ST,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -3 & 1 & 4\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 4 \\\\ -2 & 1 \\\\ 6 & 4\\end{bmatrix}=\\begin{bmatrix}24 & ∗\\end{bmatrix}, &  & \\,24=2\\cdot 1+(-3)\\cdot 0+1\\cdot (-2)+4\\cdot 6 \\\\  & \\begin{bmatrix}2 & -3 & 1 & 4\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 4 \\\\ -2 & 1 \\\\ 6 & 4\\end{bmatrix}=\\begin{bmatrix}24 & 1\\end{bmatrix}, &  & \\,1=2\\cdot (-2)+(-3)\\cdot 4+1\\cdot 1+4\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$ST=\\begin{bmatrix}24 & 1\\end{bmatrix}.$"} {:db/id #edb/ref 17592186265743 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24d545a5-b2e6-5053-b8b6-37194c5c9aa5" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-5 & 6 \\\\ -3 & 10\\end{bmatrix}" :db/id #edb/ref 17592186263315} {:answer/id #uuid "338b8f0e-6e8c-5003-a20f-65d3696dd73a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}" :db/id #edb/ref 17592186263448} {:answer/id #uuid "40cea55b-6167-57c5-a2d6-7f87677038d1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-9 & 10 \\\\ -5 & 3\\end{bmatrix}" :db/id #edb/ref 17592186263572} {:answer/id #uuid "53864c34-56a3-5553-afb8-033b263dcdea" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & 10 \\\\ -6 & 5\\end{bmatrix}" :db/id #edb/ref 17592186263719} {:answer/id #uuid "d6bc1bd7-12d4-51d7-8d46-edc046b147b4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 & 10 \\\\ -2 & -3\\end{bmatrix}" :db/id #edb/ref 17592186264868}] :answer-field/correct {:answer/id #uuid "338b8f0e-6e8c-5003-a20f-65d3696dd73a" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}" :db/id #edb/ref 17592186263448} :answer-field/id #uuid "7f084fe2-5f6e-5af3-b0dc-03f636f5e40e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265467}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "78f7d23e-60ed-507c-b4f6-6101bce65778" :question/math-academy-id "q-129495" :question/problem "Find $AB$, if\n$A=\\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}$\nand \n$B=\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}$" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-15=2\\cdot (-3)+(-1)\\cdot 6+1\\cdot (-3) \\\\  & \\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & 3 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,3=2\\cdot 2+(-1)\\cdot 5+1\\cdot 4 \\\\  & \\begin{bmatrix}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & 3 \\\\ -9 & ∗\\end{bmatrix}, &  & \\,-9=1\\cdot (-3)+0\\cdot 6+2\\cdot (-3) \\\\  & \\begin{bmatrix}-2 & 1 & 1 \\\\ 1 & 0 & 2\\end{bmatrix}\\begin{bmatrix}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{bmatrix}=\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}, &  & \\,10=1\\cdot 2+0\\cdot 5+2\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}-15 & 3 \\\\ -9 & 10\\end{bmatrix}.$"} {:db/id #edb/ref 17592186265744 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30980b36-8778-5a51-89b8-a81fc027883f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}22 & 9\\end{bmatrix}" :db/id #edb/ref 17592186263413} {:answer/id #uuid "3bd13396-77b3-54fa-8ae9-6c7200fc84bb" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-6 & 12\\end{bmatrix}" :db/id #edb/ref 17592186263533} {:answer/id #uuid "7e0eeffe-95e5-570e-9c36-aea6b4fd89db" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}15 & 9\\end{bmatrix}" :db/id #edb/ref 17592186264086} {:answer/id #uuid "975b44bb-df10-5292-a437-e855bf7bd551" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}10 \\\\ -4 \\\\ 8\\end{bmatrix}" :db/id #edb/ref 17592186264299} {:answer/id #uuid "aee8c241-2555-5612-b6c3-afa60e199249" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & 6\\end{bmatrix}" :db/id #edb/ref 17592186264506}] :answer-field/correct {:answer/id #uuid "30980b36-8778-5a51-89b8-a81fc027883f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}22 & 9\\end{bmatrix}" :db/id #edb/ref 17592186263413} :answer-field/id #uuid "8f5a069b-5bd2-5270-9936-a86902646679" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265502}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "910b9da2-b0da-578c-b6de-5df3df9fdc3f" :question/math-academy-id "q-129496" :question/problem "Find $XY$,  if  $X=\\begin{bmatrix}5 & -2 & 4\\end{bmatrix}$ and $Y=\\begin{bmatrix}2 & 3 \\\\ -2 & 1 \\\\ 2 & -1\\end{bmatrix}.$" :question/worked-solution "Here, $X$ is a $1\\times 3$ matrix and $Y$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $X$ and $3$ rows in $Y,$ so $X$ and $Y$ are conformable for multiplication:\n\n$$\n{X}_{1\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{Y}_{\\boxed{\\text{3}}\\times 2}={XY}_{1\\times 2}\n$$\n\nLet's compute $XY,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}5 & -2 & 4\\end{bmatrix}\\begin{bmatrix}2 & 3 \\\\ -2 & 1 \\\\ 2 & -1\\end{bmatrix}=\\begin{bmatrix}22 & ∗\\end{bmatrix}, &  & \\,22=5\\cdot 2+(-2)\\cdot (-2)+4\\cdot 2 \\\\  & \\begin{bmatrix}5 & -2 & 4\\end{bmatrix}\\begin{bmatrix}2 & 3 \\\\ -2 & 1 \\\\ 2 & -1\\end{bmatrix}=\\begin{bmatrix}22 & 9\\end{bmatrix}, &  & \\,9=5\\cdot 3+(-2)\\cdot 1+4\\cdot (-1)\\end{aligned}\n$$\n\nTherefore, \n$XY=\\begin{bmatrix}22 & 9\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299650 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8b4b7ed-ec16-5051-9f0e-eb339152d483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298612}] :answer-field/correct {:answer/id #uuid "f8b4b7ed-ec16-5051-9f0e-eb339152d483" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186298612} :answer-field/id #uuid "15ffdd5d-cba0-5c32-87d9-4839958abffd" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298718} {:answer-field/choices [{:answer/id #uuid "3fa46adc-8027-5641-a584-e1425ce04dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297804}] :answer-field/correct {:answer/id #uuid "3fa46adc-8027-5641-a584-e1425ce04dd6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186297804} :answer-field/id #uuid "8e119f09-47a5-5dec-ac9c-c82dedbeca32" :answer-field/key "field-5" :answer-field/type {:db/id #edb/ref 1759218604