emy-id "q-70949" :question/problem "Let $K=MN.$ What is the value of ${k}_{12}$, if\n\n$$\nM=\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix},\\,N=\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $1$st row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{12} & =\\begin{bmatrix}5 & -4 \\\\ -3 & 2\\end{bmatrix}\\begin{bmatrix}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{bmatrix} \\\\  & =\\begin{bmatrix}5 & -4\\end{bmatrix}\\begin{bmatrix}-1 \\\\ -2\\end{bmatrix} \\\\  & =5\\cdot (-1)+(-4)\\cdot (-2) \\\\  & =-5+8 \\\\  & =3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338855 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} {:answer/id #uuid "3b70ccb4-c16c-5cf5-b11e-8aafc5f11705" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186336590} {:answer/id #uuid "baedc752-7f92-5818-8e49-7eadefb98f9f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-23" :db/id #edb/ref 17592186337692} {:answer/id #uuid "d7a7677a-b2a4-59f0-ac24-ee44c46d1a26" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186337904} {:answer/id #uuid "f431b48c-3499-5e6b-9764-458010a3f0be" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186338165}] :answer-field/correct {:answer/id #uuid "0b325045-e90f-5ff8-bfde-45fd4bf81b9b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186336137} :answer-field/id #uuid "618939f6-04ba-5ea6-a01f-f04923f31488" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338449}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "3ed5dbc7-d94a-5c52-80fe-8e1e3e8256f9" :question/math-academy-id "q-70956" :question/problem "Let $T=UV.$ What is the value of ${t}_{41}$, if\n\n$$\nU=\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix},\\,V=\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $4$th row of $U$ by the $1$st column in $V$, we get\n\n$$\n\\begin{aligned}{t}_{41} & =\\begin{bmatrix}-1 & 4 & -1 \\\\ -2 & 2 & 10 \\\\ -3 & 1 & -1 \\\\ -5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 & -3 & -2 \\\\ -1 & 10 & -1 \\\\ -1 & 20 & -1\\end{bmatrix} \\\\  & =\\begin{bmatrix}-5 & 3 & 10\\end{bmatrix}\\begin{bmatrix}-2 \\\\ -1 \\\\ -1\\end{bmatrix} \\\\  & =(-5)\\cdot (-2)+3\\cdot (-1)+10\\cdot (-1) \\\\  & =10-3-10 \\\\  & =-3.\\end{aligned}\n$$"} {:db/id #edb/ref 17592186338856 :knowledge-point/_questions [{:db/id #edb/ref 17592186100873 :knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "108d6bbd-0580-5e01-b5da-7d66c9de2677" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "58" :db/id #edb/ref 17592186336189} {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} {:answer/id #uuid "473ce54b-c3d5-51fb-9d6b-a1bfee206728" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186336693} {:answer/id #uuid "6503e9be-0e27-5e84-8fd2-9a826704f72c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186336935} {:answer/id #uuid "ffcf5573-0517-5ba5-b572-8c6b996ce926" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186338275}] :answer-field/correct {:answer/id #uuid "23395dc3-a44d-5e00-8ded-065282a293f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186336360} :answer-field/id #uuid "5d203bbd-ae08-54f5-b289-51a54374a681" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338438}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "01084ebc-a27f-547f-baec-04fae1ac84bf" :question/math-academy-id "q-70958" :question/problem "Let $R=PQ.$ What is the value of ${r}_{25}$, if\n\n$$\nP=\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix},\\,Q=\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix}?\n$$" :question/worked-solution "Multiplying the $2$nd row of $P$ by the $5$th column of $Q$, we get\n\n$$\n\\begin{aligned}{r}_{25} & =\\begin{bmatrix}1 & -2 \\\\ 3 & -4 \\\\ 4 & -6 \\\\ 1 & -8 \\\\ 3 & -9\\end{bmatrix}\\begin{bmatrix}0 & 1 & 2 & -1 & 10 \\\\ 2 & 0 & 5 & -2 & 7\\end{bmatrix} \\\\  & =\\begin{bmatrix}3 & -4\\end{bmatrix}\\begin{bmatrix}10 \\\\ 7\\end{bmatrix} \\\\  & =3\\cdot 10+(-4)\\cdot 7 \\\\  & =30-28 \\\\  & =2.\\end{aligned}\n$$"}] :knowledge-point/title "Finding an Entry of the Product of Two Matrices"} {:db/id #edb/ref 17592186100913 :knowledge-point/canonical-example {:db/id #edb/ref 17592186100741 :knowledge-point/_canonical-example [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd"}] :question/id #uuid "c3ed8d05-758d-5ae0-bf57-3779fde6020b" :question/math-academy-id "e-5885" :question/problem "Compute the product \n $\\begin{bmatrix}\n       -1  \\\\\n \t0  \\\\\n        -2\n \t\n    \\end{bmatrix}\n\n    \\begin{bmatrix}\n        2 & -5\n    \\end{bmatrix}.$" :question/worked-solution "Here, the first factor is a $3 \\times 1$ matrix and the second factor is a $1 \\times 2$ matrix. \n\nThere is $1$ column in the first matrix and $1$ row in the second matrix, so the product is well defined:\n\n$$\n\\bbox[lightgray, 2pt]{3} \\times {\\color{green}\\fbox{1}} {\\color{green}\\checkmark} {\\color{green}\\fbox{1}} \\times \\bbox[lightgray, 2pt]{2} = \n\t\\bbox[lightgray, 2pt]{3} \\times \\bbox[lightgray, 2pt]{2}\n$$\n\nComputing the product, we have\n\n$$\n\\begin{aligned}\n    \\begin{bmatrix}\n       -1  \\\\\n \t0  \\\\\n        -2\n    \\end{bmatrix}\n\n    \\begin{bmatrix}\n        2 & -5\n    \\end{bmatrix}\n\n\t&= \n\n    \\begin{bmatrix}\n        (-1)\\cdot 2 & (-1)\\cdot (-5)  \\\\\n        0\\cdot 2 & 0\\cdot (-5) \\\\\n        (-2)\\cdot 2 & (-2)\\cdot (-5)\n    \\end{bmatrix} \\\\[5pt]\n\n\t&=\n\n    \\begin{bmatrix}\n       -2 & 5  \\\\\n       0 &  0  \\\\\n       -4 &  10 \n    \\end{bmatrix} \n\\end{aligned}\n$$"} :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/questions [{:db/id #edb/ref 17592186101103 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5a5ca78-5b9d-5490-ae12-9046b71fcf71" :answer/type {:db/id #edb/ref 17592186045499 :