on.difficulty/easy} :question/id #uuid "9fa531ce-0734-5931-947d-bd011cbc557d" :question/math-academy-id "q-317844" :question/problem "Determine $AB$ given that \n$A=\\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n|  | {{field-3}} | $9$ |  |  |\n|  | {{field-4}} | $14$ |  |  |\n|  | $5$ | {{field-5}} |  |  |" :question/worked-solution "Here, $A$ is a $4\\times 2$ matrix and $B$ is a $2\\times 2$ matrix. \n\nThere are $2$ columns in $A$ and $2$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{4\\times \\boxed{\\text{2}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{2}}\\times 2}={AB}_{4\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & ∗ \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,2=2\\cdot 1+1\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ ∗ & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,-1=2\\cdot (-2)+1\\cdot 3 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ ∗ & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,0=0\\cdot 1+3\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & ∗\\end{bmatrix}, &  & \\,-1=(-1)\\cdot 1+4\\cdot 0 \\\\  & \\begin{bmatrix}2 & 1 \\\\ 0 & 3 \\\\ -1 & 4 \\\\ 5 & 2\\end{bmatrix}\\begin{bmatrix}1 & -2 \\\\ 0 & 3\\end{bmatrix}=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}, &  & \\,-4=5\\cdot (-2)+2\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}2 & -1 \\\\ 0 & 9 \\\\ -1 & 14 \\\\ 5 & -4\\end{bmatrix}.$"} {:db/id #edb/ref 17592186299651 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582}] :answer-field/correct {:answer/id #uuid "06632315-20e1-5a40-b99b-5b1bbb8afa31" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-8" :db/id #edb/ref 17592186297582} :answer-field/id #uuid "7f84dc72-92a1-5353-b591-bdf85d6a4d27" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299069} {:answer-field/choices [{:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036}] :answer-field/correct {:answer/id #uuid "70c0bb1a-a11d-5b2a-bcd8-9f28cebb7e6f" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298036} :answer-field/id #uuid "c6007ff8-9e9f-5fb3-89f5-bb5c4da4bf33" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299300}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "d6b8e49d-bc16-5e49-870a-d27907495843" :question/math-academy-id "q-317846" :question/problem "Determine $AB$ given that \n$A=\\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}.$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $3$ |  |\n| --- | --- | --- | --- | --- |\n|  | $9$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}=\\begin{bmatrix}-3 & ∗ \\\\ ∗ & -8\\end{bmatrix}, &  & \\,-3=1\\cdot 2+2\\cdot (-1)+(-1)\\cdot 3 \\\\  & \\begin{bmatrix}1 & 2 & -1 \\\\ 0 & 3 & 4\\end{bmatrix}\\begin{bmatrix}2 & 1 \\\\ -1 & 0 \\\\ 3 & -2\\end{bmatrix}=\\begin{bmatrix}-3 & 3 \\\\ 9 & -8\\end{bmatrix}, &  & \\,-8=0\\cdot 1+3\\cdot 0+4\\cdot (-2)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=\\begin{bmatrix}-3 & 3 \\\\ 9 & -8\\end{bmatrix}.\n$$"} {:db/id #edb/ref 17592186299652 :knowledge-point/_questions [{:db/id #edb/ref 17592186100872 :knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "280013db-e870-5183-9372-d816ad98f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723}] :answer-field/correct {:answer/id #uuid "280013db-e870-5183-9372-d816ad98f224" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186297723} :answer-field/id #uuid "33eaef6a-e5d9-5210-b63a-9e30983de20d" :answer-field/key "field-1