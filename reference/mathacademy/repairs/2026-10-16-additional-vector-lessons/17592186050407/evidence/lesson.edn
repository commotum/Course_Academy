86045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 50 & 10 \\\\ 6 & -30 & -6 \\\\ 0 & 0 & 0\\end{bmatrix}" :db/id #edb/ref 17592186236253} {:answer/id #uuid "67b500c4-3c08-5c55-a91d-f14b3fb90af4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186236472} {:answer/id #uuid "7315c044-2f4b-51a4-b2ff-d8bff4fa99f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 50 & 10 \\\\ 6 & -30 & -6 \\\\ 0 & 0 & 0 \\\\ 8 & -40 & -8\\end{bmatrix}" :db/id #edb/ref 17592186236546} {:answer/id #uuid "9569ea85-ee3c-57f6-8cc7-7c783b778fd8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & -50 & -10 \\\\ 6 & -30 & -6 \\\\ 0 & 0 & 0 \\\\ 8 & -40 & -8\\end{bmatrix}" :db/id #edb/ref 17592186236764}] :answer-field/correct {:answer/id #uuid "7315c044-2f4b-51a4-b2ff-d8bff4fa99f6" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-10 & 50 & 10 \\\\ 6 & -30 & -6 \\\\ 0 & 0 & 0 \\\\ 8 & -40 & -8\\end{bmatrix}" :db/id #edb/ref 17592186236546} :answer-field/id #uuid "bb8b408d-c2ca-511c-b127-d031e6c0f14e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186237680}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "dc228162-bbed-5edc-ac18-77311da73b13" :question/math-academy-id "q-1038" :question/problem "$\\begin{bmatrix}-10 \\\\ 6 \\\\ 0 \\\\ 8\\end{bmatrix}\\begin{bmatrix}1 & -5 & -1\\end{bmatrix}=$" :question/worked-solution "Here, the first factor is $4\\times 1$ matrix and the second factor is a $1\\times 3$ matrix. \n\nThere is $1$ column in the first matrix and $1$ row in the second matrix, so the product is well defined:\n\n$$\n4\\times \\boxed{\\text{1}}✓\\boxed{\\text{1}}\\times 3=4\\times 3\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}\\begin{bmatrix}-10 \\\\ 6 \\\\ 0 \\\\ 8\\end{bmatrix}\\begin{bmatrix}1 & -5 & -1\\end{bmatrix} & =\\begin{bmatrix}-10\\cdot 1 & -10\\cdot (-5) & -10\\cdot (-1) \\\\ 6\\cdot 1 & 6\\cdot (-5) & 6\\cdot (-1) \\\\ 0\\cdot 1 & 0\\cdot (-5) & 0\\cdot (-1) \\\\ 8\\cdot 1 & 8\\cdot (-5) & 8\\cdot (-1)\\end{bmatrix} \\\\  & =\\begin{bmatrix}-10 & 50 & 10 \\\\ 6 & -30 & -6 \\\\ 0 & 0 & 0 \\\\ 8 & -40 & -8\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265792 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e376d53d-27f0-5be2-b35f-f4d91876ada1" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 \\\\ -1\\end{bmatrix}" :db/id #edb/ref 17592186264977} {:answer/id #uuid "eb678b62-e5ac-5a34-a142-98bf42189475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 \\\\ -9 & 3\\end{bmatrix}" :db/id #edb/ref 17592186265054} {:answer/id #uuid "f85d4f26-7a1c-53cb-bb4f-7d6a715d2393" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}3 & -1 \\\\ -9 & 3\\end{bmatrix}" :db/id #edb/ref 17592186265174} {:answer/id #uuid "fbcf0048-3a05-5c6a-a8a8-728a7671810b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 9\\end{bmatrix}" :db/id #edb/ref 17592186265204} {:answer/id #uuid "fd313f4f-a74a-5051-a216-9b54910390f2" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-1 \\\\ -9\\end{bmatrix}" :db/id #edb/ref 17592186265223}] :answer-field/correct {:answer/id #uuid "eb678b62-e5ac-5a34-a142-98bf42189475" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-3 & 1 \\\\ -9 & 3\\end{bmatrix}" :db/id #edb/ref 17592186265054} :answer-field/id #uuid "8ad6ed81-a246-516c-a457-e881158c431f" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265493}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "c109d94f-badb-560f-816a-dc72e0193e2a" :question/math-academy-id "q-129961" :question/problem "If\n$A=\\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}$\nand\n$B=\\begin{bmatrix}3 & -1\\end{bmatrix}$\nthen $AB=$" :question/worked-solution "Here, $A$ is a $2\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in $A$ and $1$ row in $B,$ so $A$ and $B$ are conformable for multiplication: \n\n$$\n{A}_{2\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & ∗ \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,-3=-1\\cdot 3 \\\\  & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & 1 \\\\ ∗ & ∗\\end{bmatrix}, &  & \\,1=(-1)\\cdot (-1) \\\\  & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & 1 \\\\ -9 & ∗\\end{bmatrix}, &  & \\,-9=(-3)\\cdot 3 \\\\  & \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}\\begin{bmatrix}3 & -1\\end{bmatrix}=\\begin{bmatrix}-3 & 1 \\\\ -9 & 3\\end{bmatrix}, &  & \\,3=(-3)\\cdot (-1)\\end{aligned}\n$$\n\nTherefore, \n$AB=\\begin{bmatrix}-3 & 1 \\\\ -9 & 3\\end{bmatrix}.$"} {:db/id #edb/ref 17592186265838 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1731f4d0-2e00-51db-8ba8-df32c1c91bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & 16 \\\\ 2 & 0 & 8 \\\\ 1 & 0 & 4 \\\\ 1 & 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186263220} {:answer/id #uuid "35d5240f-4de5-5ab2-a31d-42037cfc6435" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 & 16 & 1 \\\\ 0 & 0 & 0 & 0 \\\\ 2 & -1 & 8 & 2 \\\\ 1 & 0 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186263475} {:answer/id #uuid "8bd1c6fb-594a-5b00-aa29-c8f0422c862c" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 & 16 & 1 \\\\ 2 & -1 & 8 & 2 \\\\ 0 & 0 & 0 & 0 \\\\ 1 & 0 & 4 & 3\\end{bmatrix}" :db/id #edb/ref 17592186264196} {:answer/id #uuid "a4b6c187-e4d1-55f9-ab48-a635363b3fb3" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 1 & 16 \\\\ 2 & -1 & 8 \\\\ 1 & 0 & 4 \\\\ 0 & 4 & 0\\end{bmatrix}" :db/id #edb/ref 17592186264403} {:answer/id #uuid "a59536c8-b0af-533f-8581-64006b7db377" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186264419}] :answer-field/correct {:answer/id #uuid "1731f4d0-2e00-51db-8ba8-df32c1c91bc4" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}4 & 0 & 16 \\\\ 2 & 0 & 8 \\\\ 1 & 0 & 4 \\\\ 1 & 0 & 4\\end{bmatrix}" :db/id #edb/ref 17592186263220} :answer-field/id #uuid "dd10dcce-5af6-5c25-bba5-38fc7025e371" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265637}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12adb9aa-d0f5-5652-8be9-e0603eaa1767" :question/math-academy-id "q-130136" :question/problem "$\\begin{bmatrix}4 \\\\ 2 \\\\ 1 \\\\ 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 4\\end{bmatrix}=$" :question/worked-solution "Here, the first factor is $4\\times 1$ matrix and the second factor is a $1\\times 3$ matrix. \n\nThere is $1$ column in the first matrix and $1$ row in the second matrix, so the product is well defined:\n\n$$\n4\\times \\boxed{\\text{1}}✓\\boxed{\\text{1}}\\times 3=4\\times 3\n$$\n\nComputing the product, we have\n\n$$\n\\begin{aligned}\\begin{bmatrix}4 \\\\ 2 \\\\ 1 \\\\ 1\\end{bmatrix}\\begin{bmatrix}1 & 0 & 4\\end{bmatrix} & =\\begin{bmatrix}4\\cdot 1 & 4\\cdot 0 & 4\\cdot 4 \\\\ 2\\cdot 1 & 2\\cdot 0 & 2\\cdot 4 \\\\ 1\\cdot 1 & 1\\cdot 0 & 1\\cdot 4 \\\\ 1\\cdot 1 & 1\\cdot 0 & 1\\cdot 4\\end{bmatrix} \\\\  & =\\begin{bmatrix}4 & 0 & 16 \\\\ 2 & 0 & 8 \\\\ 1 & 0 & 4 \\\\ 1 & 0 & 4\\end{bmatrix}\\end{aligned}\n$$"} {:db/id #edb/ref 17592186265857 :knowledge-point/_questions [{:db/id #edb/ref 17592186100913 :knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector" :topic/_knowledge-points [{:db/id #edb/ref 17592186050407 :topic/title "Multiplying Matrices"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1297b425-ab85-5bba-90d9-0aa321868ad7" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}24\\end{bmatrix}" :db/id #edb/ref 17592186263175} {:answer/id #uuid "3c0c371e-e1b3-52d8-84c6-a9a17f03d267" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "\\begin{bmatrix}12 & -15 \\\\ -16 & 20 \\\\ 8 & -10\\end{bmatrix}" :db/id #edb/ref 17592186263534} {:answer/id #uuid "b6e8ab17-e45c-523a-a19c-a71e31ef33d7" :answer/type {:db/id #