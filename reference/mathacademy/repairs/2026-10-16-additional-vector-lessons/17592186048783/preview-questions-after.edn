{BA}_{2\\times 2}\n$$"} {:db/id #edb/ref 17592186101409 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7ac97073-f2e4-57fa-bc98-21619911b032" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477307} {:answer/id #uuid "fed5ba5b-9655-57ac-bf85-e26d4ca80ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477308}] :answer-field/correct {:answer/id #uuid "fed5ba5b-9655-57ac-bf85-e26d4ca80ab6" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477308} :answer-field/id #uuid "a9a32b98-4ce8-5ab9-ba0f-52336fc8a891" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186477623} {:answer-field/choices [{:answer/id #uuid "ab354b54-184d-5e28-ab49-c725761e84d3" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186477309} {:answer/id #uuid "5f7c4fb6-9856-5e08-8e95-baf50093e535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477310}] :answer-field/correct {:answer/id #uuid "5f7c4fb6-9856-5e08-8e95-baf50093e535" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186477310} :answer-field/id #uuid "579c28da-6262-519a-b610-6fec803beaf2" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :