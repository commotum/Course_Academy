9 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562897}] :answer-field/correct {:answer/id #uuid "b095e79b-a819-586b-ab09-7239d584f9f2" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562897} :answer-field/id #uuid "5e7a67a5-a17a-53dc-81ea-712acf4793d9" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562874}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "8c1748bb-90d6-5563-8ef1-b046b936907d" :question/problem "<div class=\"matrix-operands\">\n<div>$O=\\begin{bmatrix}-6 & -9 & -4 & -6 & -4\\end{bmatrix}$</div>\n<div>$P=\\begin{bmatrix}9 & -4 & -2 \\\\ -5 & 8 & -9 \\\\ -2 & 0 & 2 \\\\ 1 & -3 & 2\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}-5 \\\\ 0 \\\\ 8\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $O,P,$ and $R?$\n\nSelect all that apply.\n\n- **I.** The product $OR$ is well defined\n\n- **II.** The product $OP$ is well defined\n\n- **III.** The product $RO$ is well defined" :question/worked-solution "Notice that $O$ is a $1\\times 5$ row vector, $P$ is a $4\\times 3$ matrix, and $R$ is a $3\\times 1$ column vector.\n\nThere are $5$ columns in $O$ and $3$ rows in $R.$ Since the number of columns in $O$ does **not** equal the number of rows in $R,$ the matrices $O$ and $R$ are **not** conformable for multiplication:\n\n$$\n{O}_{1\\times 5}{\\times }_{\\ne }{R}_{3\\times 1}=\\text{undefined}\n$$\n\nOn the other hand, there are $5$ columns in $O$ and $4$ rows in $P.$ Since the number of columns in $O$ does **not** equal the number of rows in $P,$ the matrices $O$ and $P$ are **not** conformable for multiplication:\n\n$$\n{O}_{1\\times 5}{\\times }_{\\ne }{P}_{4\\times 3}=\\text{undefined}\n$$\n\nFinally, there is $1$ column in $R$ and $1$ row in $O.$ Since the number of columns in $R$ equals the number of rows in $O,$ the matrices $R$ and $O$ are conformable for multiplication:\n\n$$\n{R}_{3\\times \\boxed{\\text{1}}}{\\times }_{✓}{O}_{\\boxed{\\text{1}}\\times 5}=\\text{well defined}\n$$\n\nTherefore, statement III is true, while statements I and II are false."}] [{:db/id #edb/ref 17592186562889 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c6a813dd-19f7-54e1-a2c7-bd667d5aed30" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562903} {:answer/id #uuid "e19500d1-8755-5dc6-ac50-746ede9424ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562915}] :answer-field/correct {:answer/id #uuid "e19500d1-8755-5dc6-ac50-746ede9424ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562915} :answer-field/id #uuid "4d51da39-0b01-536b-bfb2-eec56fd78de6" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562870} {:answer-field/choices [{:answer/id #uuid "d8d70d25-2c3a-51bc-ba52-e7054852cfb5" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562911} {:answer/id #uuid "f069bd38-0367-5fd7-9bc6-9d965655353a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562917}] :answer-field/correct {:answer/id #uuid "f069bd38-0367-5fd7-9bc6-9d965655353a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562917} :answer-field/id #uuid "9c7e2a8e-c431-5d07-a1c8-050d821fbc8f" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562891} {:answer-field/choices [{:answer/id #uuid "2ef90c50-c0ed-5d96-9665-4922437d58f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562859} {:answer/id #uuid "bd996ffd-f797-5509-9bbe-b47b6aeefa46" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562901}] :answer-field/correct {:answer/id #uuid "2ef90c50-c0ed-5d96-9665-4922437d58f4" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562859} :answer-field/id #uuid "a3c54a46-9187-506d-a306-7298aa00b5a1" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562895}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "93240880-0a92-5ff3-9e93-67e683dcedec" :question/problem "<div class=\"matrix-operands\">\n<div>$O=\\begin{bmatrix}-5 & -5 & -8 & -8 \\\\ -5 & -2 & 8 & 5\\end{bmatrix}$</div>\n<div>$P=\\begin{bmatrix}7 & 4\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}-3 \\\\ 9 \\\\ -7\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $O,P,$ and $R?$\n\nSelect all that apply.\n\n- **I.** The product $RP$ is well defined\n\n- **II.** The product $PR$ is well defined\n\n- **III.** The product $OP$ is well defined" :question/worked-solution "Notice that $O$ is a $2\\times 4$ matrix, $P$ is a $1\\times 2$ row vector, and $R$ is a $3\\times 1$ column vector.\n\nThere is $1$ column in $R$ and $1$ row in $P.$ Since the number of columns in $R$ equals the number of rows in $P,$ the matrices $R$ and $P$ are conformable for multiplication:\n\n$$\n{R}_{3\\times \\boxed{\\text{1}}}{\\times }_{✓}{P}_{\\boxed{\\text{1}}\\times 2}=\\text{well defined}\n$$\n\nOn the other hand, there are $2$ columns in $P$ and $3$ rows in $R.$ Since the number of columns in $P$ does **not** equal the number of rows in $R,$ the matrices $P$ and $R$ are **not** conformable for multiplication:\n\n$$\n{P}_{1\\times 2}{\\times }_{\\ne }{R}_{3\\times 1}=\\text{undefined}\n$$\n\nFinally, there are $4$ columns in $O$ and $1$ row in $P.$ Since the number of columns in $O$ does **not** equal the number of rows in $P,$ the matrices $O$ and $P$ are **not** conformable for multiplication:\n\n$$\n{O}_{2\\times 4}{\\times }_{\\ne }{P}_{1\\times 2}=\\text{undefined}\n$$\n\nTherefore, statement I is true, while statements II and III are false."}] [{:db/id #edb/ref 17592186562892 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3edafb7e-5a8e-568e-93a2-d9776a6084b1" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562864} {:answer/id #uuid "f014b7fd-ab32-5bb4-a516-8d9a267ee4fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562916}] :answer-field/correct {:answer/id #uuid "f014b7fd-ab32-5bb4-a516-8d9a267ee4fb" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562916} :answer-field/id #uuid "b19a20c5-afb7-5dc2-9fc1-9c594316a164" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562898} {:answer-field/choices [{:answer/id #uuid "d5bd226a-d5ac-511a-968f-be677f0cb766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562910} {:answer/id #uuid "f32f88d7-1c04-5ee9-8f63-bdecfc1ed874" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562918}] :answer-field/correct {:answer/id #uuid "d5bd226a-d5ac-511a-968f-be677f0cb766" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562910} :answer-field/id #uuid "be555373-045c-506a-8a35-eea9aaaa8935" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562902} {:answer-field/choices [{:answer/id #uuid "731763ab-ecfa-5d9f-b97e-e57ab7f3ac3e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562879} {:answer/id #uuid "809c9224-decc-5959-8d36-bdbe575f61bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562883}] :answer-field/correct {:answer/id #uuid "809c9224-decc-5959-8d36-bdbe575f61bd" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562883} :answer-field/id #uuid "c974abcf-7262-5f9f-bd6b-6da19ef7805f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562905}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "9fe7d2e4-659c-5b6e-9c9b-6d0a9162b9e8" :question/problem "<div class=\"matrix-operands\">\n<div>$P=\\begin{bmatrix}-5 & -6 \\\\ 8 & -2\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}-5 & -5 & -8 & -8 & -5\\end{bmatrix}$</div>\n<div>$S=\\begin{bmatrix}-2 & 8\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $P,R,$ and $S?$\n\nSelect all that apply.\n\n- **I.** The product $RS$ is well defined\n- **II.** The product $PS$ is well defined\n- **III.** The product $PR$ is well defined" :question/worked-solution "Notice that $P$ is a $2\\times 2$ matrix, $R$ is a $1\\times 5$ row vector, and $S$ is a $1\\times 2$ row vector. \n\nThere are $5$ columns in $R$ and $1$ row in $S.$ Since the number of columns in $R$ does **not** equal the number of rows in $S,$ the matrices $R$ and $S$ are **not** conformable for multiplication:\n\n$$\n{R}_{1\\times 5}{\\times }_{\\ne }{S}_{1\\times 2}=\\text{undefined}\n$$\n\nOn the other hand, there are $2$ columns in $P$ and $1$ row in $S.$ Since the number of columns in $P$ does **not** equal the number of rows in $S,$ the matrices $P$ and $S$ are **not** conformable for multiplication:\n\n$$\n{P}_{2\\times 2}{\\times }_{\\ne }{S}_{1\\times 2}=\\text{undefined}\n$$\n\nFinally, there are $2$ columns in $P$ and $1$ row in $R.$ Since the number of columns in $P$ does **not** equal the number of rows in $R,$ the matrices $P$ and $R$ are **not** conformable for multiplication:\n\n$$\n{P}_{2\\times 2}{\\times }_{\\ne }{R}_{1\\times 5}=\\text{undefined}\n$$\n\nWe conclude that all three statements are false."}] [{:db/id #edb/ref 17592186562914 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "634eda15-ac4c-58ee-8987-5a03c7951b6f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562876} {:answer/id #uuid "fab3f125-4732-5852-8a3b-74a036577c22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562919}] :answer-field/correct {:answer/id #uuid "fab3f125-4732-5852-8a3b-74a036577c22" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562919} :answer-field/id #uuid "002a391d-196d-5e6e-a5ad-c8c4da7a9101" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562852} {:answer-field/choices [{:answer/id #uuid "07fe8f3f-cc9a-59da-b696-08b8234d657b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562855} {:answer/id #uuid "bd7178d2-bc56-574e-b59d-1437513c672c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562900}] :answer-field/correct {:answer/id #uuid "bd7178d2-bc56-574e-b59d-1437513c672c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562900} :answer-field/id #uuid "c81cfd27-3d9f-55aa-bdd4-33c537434f5d" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562904} {:answer-field/choices [{:answer/id #uuid "8b523942-a4cc-52af-ac57-78219e1b3443" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562886} {:answer/id #uuid "dc8f128a-f61f-5456-8848-2ff32e232e5e" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186562913}] :answer-field/correct {:answer/id #uuid "8b523942-a4cc-52af-ac57-78219e1b3443" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186562886} :answer-field/id #uuid "d17b4073-f034-57d1-9612-84b24201e0f5" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186562908}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "e01af3ae-fb4a-5e38-8b42-8320c8e0b105" :question/problem "<div class=\"matrix-operands\">\n<div>$P=\\begin{bmatrix}0 & 9 \\\\ -7 & 6 \\\\ 3 & 7\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}7 & -3\\end{bmatrix}$</div>\n<div>$S=\\begin{bmatrix}5 & -6 & -9 & -1 & 4\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $P,R,$ and $S?$\n\nSelect all that apply.\n\n- **I.** The product $SP$ is well defined\n- **II.** The product $PS$ is well defined\n- **III.** The product $RS$ is well defined" :question/worked-solution "Notice that $P$ is a $3\\times 2$ matrix, $R$ is a $1\\times 2$ row vector, and $S$ is a $1\\times 5$ row vector. \n\nThere are $5$ columns in $S$ and $3$ rows in $P.$ Since the number of columns in $S$ does **not** equal the number of rows in $P,$ the matrices $S$ and $P$ are **not** conformable for multiplication:\n\n$$\n{S}_{1\\times 5}{\\times }_{\\ne }{P}_{3\\times 2}=\\text{undefined}\n$$\n\nOn the other hand, there are $2$ columns in $P$ and $1$ row in $S.$ Since the number of columns in $P$ does **not** equal the number of rows in $S,$ the matrices $P$ and $S$ are **not** conformable for multiplication:\n\n$$\n{P}_{3\\times 2}{\\times }_{\\ne }{S}_{1\\times 5}=\\text{undefined}\n$$\n\nFinally, there are $2$ columns in $R$ and $1$ row in $S.$ Since the number of columns in $R$ does **not** equal the number of rows in $S,$ the matrices $R$ and $S$ are **not** conformable for multiplication:\n\n$$\n{R}_{1\\times 2}{\\times }_{\\ne }{S}_{1\\times 5}=\\text{undefined}\n$$\n\nWe conclude that all three statements are false."}]}
