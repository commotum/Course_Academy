ns [{:db/id #edb/ref 17592186100871 :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7bed4ba0-143c-55e4-8b94-cc1adbfedf1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298089}] :answer-field/correct {:answer/id #uuid "7bed4ba0-143c-55e4-8b94-cc1adbfedf1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298089} :answer-field/id #uuid "3cd67c8a-ac92-5c47-a537-dcfda01bbe7f" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298843} {:answer-field/choices [{:answer/id #uuid "a80034ba-1744-5a46-b6b5-2ed8aaaa8697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298286}] :answer-field/correct {:answer/id #uuid "a80034ba-1744-5a46-b6b5-2ed8aaaa8697" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298286} :answer-field/id #uuid "abd4db80-2ac5-562f-8418-30c4cf225d25" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299217}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "cbad9be4-81c3-5d76-a5dd-452794f75baa" :question/math-academy-id "q-320351" :question/problem "Let\n\n<div class=\"matrix-operands\">\n<div>$C=\\begin{bmatrix}-3 \\\\ 2 \\\\ 0 \\\\ -2\\end{bmatrix}$</div>\n<div>$D=\\begin{bmatrix}7 & -1 & 5\\end{bmatrix}$</div>\n</div>\n\nThen, the dimensions of $CD$ are <span style=\"display: inline-flex; align-items: center; gap: .35em; white-space: nowrap;\">{{field-1}} $\\times$ {{field-2}}</span>." :question/worked-solution "We notice that $C$ is a $4\\times 1$ matrix and $D$ is a $1\\times 3$ matrix. \n\nThere is $1$ column in $C$ and $1$ row in $D.$ Since the number of columns in $C$ equals the number of rows in $D,$ the matrices $C$ and $D$ are conformable for multiplication. \n\nThe product $CD$ has dimensions $4\\times 3:$\n\n$$\n{C}_{4\\times \\boxed{\\text{1}}}{\\times }_{✓}{D}_{\\boxed{\\text{1}}\\times 3}={CD}_{4\\times 3}\n$$"}] [{:db/id #edb/ref 17592186299841 :knowledge-point/_questions [{:db/id #edb/ref 17592186100871 :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2ac3c5c-f6cd-5fd5-b2a0-6cb8e37b78ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298329}] :answer-field/correct {:answer/id #uuid "b2ac3c5c-f6cd-5fd5-b2a0-6cb8e37b78ad" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298329} :answer-field/id #uuid "5ce7fe03-ed70-594f-8d42-ac888b8e9609" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298955} {:answer-field/choices [{:answer/id #uuid "2266199c-ddd0-5fc1-8ad7-a0c747f7e74d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297699}] :answer-field/correct {:answer/id #uuid "2266199c-ddd0-5fc1-8ad7-a0c747f7e74d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186297699} :answer-field/id #uuid "cfce6c8e-4282-53ef-a878-8e11c69a3c7c" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299338}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "cef63f89-6766-5942-a14a-b8ab45d7b4ca" :question/math-academy-id "q-320371" :question/problem "Let\n\n<div class=\"matrix-operands\">\n<div>$E=\\begin{bmatrix}-1 & 2 \\\\ 4 & 0 \\\\ 3 & 5 \\\\ 7 & -6\\end{bmatrix}$</div>\n<div>$F=\\begin{bmatrix}9 & -2 & 8 & 1 \\\\ -4 & 6 & 0 & -3\\end{bmatrix}$</div>\n</div>\n\nThen, the dimensions of $FE$ are <span style=\"display: inline-flex; align-items: center; gap: .35em; white-space: nowrap;\">{{field-1}} $\\times$ {{field-2}}</span>." :question/worked-solution "We notice that $E$ is a $4\\times 2$ matrix and $F$ is a $2\\times 4$ matrix. \n\nThere are $4$ columns in $F$ and $4$ rows in $E.$ Since the number of columns in $F$ equals the number of rows in $E,$ the matrices $F$ and $E$ are conformable for multiplication. \n\nThe product $FE$ has dimensions $2\\times 2:$\n\n$$\n{F}_{2\\times \\boxed{\\text{4}}}{\\times }_{✓}{E}_{\\boxed{\\text{4}}\\times 2}={FE}_{2\\times 2}\n$$"}] [{:db/id #edb/ref 17592186299843 :knowledge-point/_questions [{:db/id #edb/ref 17592186100871 :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b531995-3719-5c05-9a3c-e478fed52731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297861}] :answer-field/correct {:answer/id #uuid "4b531995-3719-5c05-9a3c-e478fed52731" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186297861} :answer-field/id #uuid "354c79d4-07d9-5b3b-a3ee-14567f83010b" :answer-field/key "field-1" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298822} {:answer-field/choices [{:answer/id #uuid "e0db2944-4924-5aea-9ee1-3438dd657d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298515}] :answer-field/correct {:answer/id #uuid "e0db2944-4924-5aea-9ee1-3438dd657d1d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298515} :answer-field/id #uuid "77c35a34-4f54-59b4-9538-e689eff39b82" :answer-field/key "field-2" :answer-field/type {:db/id #edb/ref 17592186045492 :db/ident :answer-field.type/blank} :db/id #edb/ref 17592186299042}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "283919b2-9c02-5df9-b56d-dbcf89785d7c" :question/math-academy-id "q-320389" :question/problem "Let\n\n<div class=\"matrix-operands\">\n<div>$E=\\begin{bmatrix}2 & -1 \\\\ 0 & 5 \\\\ -3 & 4\\end{bmatrix}$</div>\n<div>$F=\\begin{bmatrix}6 \\\\ -2\\end{bmatrix}$</div>\n</div>\n\nThen, the dimensions of $EF$ are <span style=\"display: inline-flex; align-items: center; gap: .35em; white-space: nowrap;\">{{field-1}} $\\times$ {{field-2}}</span>." :question/worked-solution "We notice that $E$ is a $3\\times 2$ matrix and $F$ is a $2\\times 1$ matrix. \n\nThere are $2$ columns in $E$ and $2$ rows in $F.$ Since the number of columns in $E$ equals the number of rows in $F,$ the matrices $E$ and $F$ are conformable for multiplication. \n\nThe product $EF$ has dimensions $3\\times 1:$ \n\n$$\n{E}_{3\\times \\boxed{\\text{2}}}{\\times }_{✓}{F}_{\\boxed{\\text{2}}\\times 1}={EF}_{3\\times 1}\n$$"}]}
