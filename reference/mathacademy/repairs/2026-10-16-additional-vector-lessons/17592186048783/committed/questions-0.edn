20-512b-93a8-4b9f3c962c38" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448370} :answer-field/id #uuid "c2774138-c2fc-5876-84c5-93da8a175e9f" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449225} {:answer-field/choices [{:answer/id #uuid "cb2b2b09-edcc-581e-920d-e47a8346fc6c" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186448372} {:answer/id #uuid "c8393209-b177-529e-b28b-4beba3d7980d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448373}] :answer-field/correct {:answer/id #uuid "c8393209-b177-529e-b28b-4beba3d7980d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186448373} :answer-field/id #uuid "887210a3-979a-5046-a639-10af689a9ba1" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186449226}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "22b7c2e7-9621-5013-a411-a722a7ceea01" :question/math-academy-id "q-129437" :question/problem "<div class=\"matrix-operands\">\n<div>$P=\\begin{bmatrix}1 & 0 & 0 \\\\ 0 & 2 & 0 \\\\ 3 & 0 & 0 \\\\ 0 & 4 & 0 \\\\ 5 & 0 & 0\\end{bmatrix}$</div>\n<div>$R=\\begin{bmatrix}1 & 2 & 3\\end{bmatrix}$</div>\n<div>$S=\\begin{bmatrix}1 & 2 & 3 & 4 & 5\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $P,R,$ and $S?$\n\nSelect all that apply.\n\n- **I.** The product $RS$ is well defined\n- **II.** The product $RP$ is well defined\n- **III.** The product $SP$ is well defined" :question/worked-solution "Notice that $P$ is a $5\\times 3$ matrix, $R$ is a $1\\times 3$ row vector, and $S$ is a $1\\times 5$ row vector. \n\nThere are $3$ columns in $R$ and $1$ row in $S.$ Since the number of columns in $R$ does **not** equal the number of rows in $S,$ the matrices $R$ and $S$ are **not** conformable for multiplication:\n\n$$\n{R}_{1\\times 3}{\\times }_{\\ne }{S}_{1\\times 5}=\\text{undefined}\n$$\n\nOn the other hand, there are $3$ columns in $R$ and $5$ rows in $P.$ Since the number of columns in $R$ does **not** equal the number of rows in $P,$ the matrices $R$ and $P$ are **not** conformable for multiplication:\n\n$$\n{R}_{1\\times 3}{\\times }_{\\ne }{P}_{5\\times 3}=\\text{undefined}\n$$\n\nFinally, there are $5$ columns in $S$ and $5$ rows in $P.$ Since the number of columns in $S$ equals the number of rows in $P,$ the matrices $S$ and $P$ are conformable for multiplication:\n\n$$\n{S}_{1\\times \\boxed{\\text{5}}}{\\times }_{✓}{P}_{\\boxed{\\text{5}}\\times 3}=\\text{well defined}\n$$\n\nTherefore, statement III is true, while statements I and II are false."}] [{:db/id #edb/ref 17592186265741 :knowledge-point/_questions [{:db/id #edb/ref 17592186100871 :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "41f2ba8f-39a4-580c-ad74-ddae65c3bc2b" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 4" :db/id #edb/ref 17592186263584} {:answer/id #uuid "4cdc1dda-985c-531a-8198-2e27932a7782" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times 2" :db/id #edb/ref 17592186263665} {:answer/id #uuid "5bf479a9-e9bb-5032-8ddc-7c1d3f7834d7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186263793} {:answer/id #uuid "c5405d8a-672b-5d09-add2-c80683011f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\times 4" :db/id #edb/ref 17592186264729} {:answer/id #uuid "e5c61767-151e-587f-88e5-2671dc04c89d" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "4\\times 4" :db/id #edb/ref 17592186265003}] :answer-field/correct {:answer/id #uuid "c5405d8a-672b-5d09-add2-c80683011f7e" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\times 4" :db/id #edb/ref 17592186264729} :answer-field/id #uuid "64117ea8-fc6f-5546-9e96-d9551685168e" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265420}] :question/difficulty {:db/id #edb/ref 17592186045486 :db/ident :question.difficulty/hard} :question/id #uuid "7f2cfa96-3e65-501e-ab18-cce696d48042" :question/math-academy-id "q-129489" :question/problem "Let\n\n<div class=\"matrix-operands\">\n<div>$A=\\begin{bmatrix}1 & 0 & 7 & 7 \\\\ 0 & -1 & 8 & -4 \\\\ -3 & 5 & -1 & 5\\end{bmatrix}$</div>\n<div>$B=\\begin{bmatrix}-1 & 5 & 1 \\\\ 1 & 0 & 8\\end{bmatrix}$</div>\n</div>\n\nWhat are the dimensions of $BA?$" :question/worked-solution "We notice that $A$ is a $3\\times 4$ matrix and $B$ is a $2\\times 3$ matrix. \n\nThere are $3$ columns in $B$ and $3$ rows in $A.$ Since the number of columns in $B$ equals the number of rows in $A,$ the matrices $B$ and $A$ are conformable for multiplication. \n\nThe product $BA$ has dimensions $2\\times 4:$\n\n$$\n{B}_{2\\times \\boxed{\\text{3}}}{\\times }_{✓}{A}_{\\boxed{\\text{3}}\\times 4}={BA}_{2\\times 4}\n$$"}] [{:db/id #edb/ref 17592186265742 :knowledge-point/_questions [{:db/id #edb/ref 17592186100871 :knowledge-point/id #uuid "a0a4fa3d-fc1a-5e95-a632-f3a25c9bc4b1" :knowledge-point/title "Determining the Dimension of the Product of Two Matrices" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "038693ea-ced3-550f-8158-f94e715193f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 2" :db/id #edb/ref 17592186263029} {:answer/id #uuid "160c2f4f-3e94-53de-9278-63504271a093" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\times 3" :db/id #edb/ref 17592186263208} {:answer/id #uuid "40266833-e558-56cc-b811-1131e9344f6d" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "The product is undefined" :db/id #edb/ref 17592186263568} {:answer/id #uuid "6555256e-a4f4-5c89-9c78-4618d73c70a8" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "2\\times 2" :db/id #edb/ref 17592186263876} {:answer/id #uuid "d85382d0-5089-55bd-aa20-471cd51c9c54" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 3" :db/id #edb/ref 17592186264885}] :answer-field/correct {:answer/id #uuid "038693ea-ced3-550f-8158-f94e715193f9" :answer/type {:db/id #edb/ref 17592186045498 :db/ident :answer.type/math} :answer/value "3\\times 2" :db/id #edb/ref 17592186263029} :answer-field/id #uuid "604ee846-f9d6-5422-bb16-f4a3d31225b7" :answer-field/key "selection" :answer-field/type {:db/id #edb/ref 17592186045493 :db/ident :answer-field.type/radio} :db/id #edb/ref 17592186265411}] :question/difficulty {:db/id #edb/ref 17592186045487 :db/ident :question.difficulty/moderate} :question/id #uuid "af3c60eb-8137-5aff-ac44-7e1785bdc22b" :question/math-academy-id "q-129492" :question/problem "Let\n\n<div class=\"matrix-operands\">\n<div>$C=\\begin{bmatrix}1 & -\\sqrt{2} & 2 \\\\ -1 & 0 & -3 \\\\ 2 & -5 & -7\\end{bmatrix}$</div>\n<div>$D=\\begin{bmatrix}1 & 3 \\\\ 0 & -5 \\\\ -3 & \\sqrt{3}\\end{bmatrix}$</div>\n</div>\n\nWhat are the dimensions of $CD?$" :question/worked-solution "We notice that $C$ is a $3\\times 3$ matrix and $D$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $C$ and $3$ rows in $D.$ Since the number of columns in $C$ equals the number of rows in $D,$ the matrices $C$ and $D$ are conformable for multiplication. \n\nThe product $CD$ has dimensions $3\\times 2:$ \n\n$$\n{C}_{3\\times \\boxed{\\text{3}}}{\\times }_{✓}{D}_{\\boxed{\\text{3}}\\times 2}={CD}_{3\\times 2}\n$$"}] [{:db/id #edb/ref 17592186290369 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4a93ef54-75a7-58b3-aefb-23905447fd8f" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450250} {:answer/id #uuid "4b995925-934b-5fd2-877f-aa3cf84a5166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450251}] :answer-field/correct {:answer/id #uuid "4b995925-934b-5fd2-877f-aa3cf84a5166" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450251} :answer-field/id #uuid "399ae7fe-01e2-5382-b1a9-4e47af718b72" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451079} {:answer-field/choices [{:answer/id #uuid "44ff3d40-849a-5db8-9cf6-5fac0ac794ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450252} {:answer/id #uuid "3ef26044-c1a2-592a-854e-9764c570b332" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450253}] :answer-field/correct {:answer/id #uuid "44ff3d40-849a-5db8-9cf6-5fac0ac794ef" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450252} :answer-field/id #uuid "e8966769-d214-5dda-9b5c-f23fef8c54ed" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451080} {:answer-field/choices [{:answer/id #uuid "0e376649-41c7-5d9c-81ec-516f8c48228b" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450254} {:answer/id #uuid "e18e340e-63df-594f-ab82-c85ec74e7f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450255}] :answer-field/correct {:answer/id #uuid "e18e340e-63df-594f-ab82-c85ec74e7f75" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450255} :answer-field/id #uuid "5b7bc0c6-04f7-5fcb-9611-2c846635a049" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451081}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "7f63e1f3-652b-58b6-9207-73ea266277c9" :question/math-academy-id "q-22055" :question/problem "<div class=\"matrix-operands\">\n<div>$X=\\begin{bmatrix}1 & 2 \\\\ 0 & 7\\end{bmatrix}$</div>\n<div>$Y=\\begin{bmatrix}1 & 0 & -1 \\\\ -1 & 0 & 1\\end{bmatrix}$</div>\n<div>$Z=\\begin{bmatrix}1 & 0 & -1 \\\\ -1 & 0 & 1 \\\\ 1 & 0 & 1\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $X,Y,$ and $Z?$\n\nSelect all that apply.\n\n- **I.** The product $XY$ is well defined\n\n- **II.** The product $YX$ is well defined\n\n- **III.** The product $YZ$ is well defined" :question/worked-solution "Notice that $X$ is a $2\\times 2$ matrix, $Y$ is a $2\\times 3$ matrix, and $Z$ is a $3\\times 3$ matrix.\n\nThere are $2$ columns in $X$ and $2$ rows in $Y.$ Since the number of columns in $X$ equals the number of rows in $Y,$ the matrices $X$ and $Y$ are conformable for multiplication:\n\n$$\n{X}_{2\\times \\boxed{\\text{2}}}{\\times }_{✓}{Y}_{\\boxed{\\text{2}}\\times 3}=\\text{well defined}\n$$\n\nOn the other hand, there are $3$ columns in $Y$ and $2$ rows in $X.$ Since the number of columns in $Y$ does **not** equal the number of rows in $X,$ the matrices $Y$ and $X$ are **not** conformable for multiplication:\n\n$$\n{Y}_{2\\times 3}{\\times }_{\\ne }{X}_{2\\times 2}=\\text{undefined}\n$$\n\nFinally, there are $3$ columns in $Y$ and $3$ rows in $Z.$ Since the number of columns in $Y$ equals the number of rows in $Z,$ the matrices $Y$ and $Z$ are conformable for multiplication:\n\n$$\n{Y}_{2\\times \\boxed{\\text{3}}}{\\times }_{✓}{Z}_{\\boxed{\\text{3}}\\times 3}=\\text{well defined}\n$$\n\nTherefore, statements I and III are true, while statement II is false."}] [{:db/id #edb/ref 17592186290370 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplication" :topic/_knowledge-points [{:db/id #edb/ref 17592186048783 :topic/title "Conformability for Matrix Multiplication"}]}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fbf7dde-3a5a-5e3a-98c4-330f2d78c1ca" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450256} {:answer/id #uuid "f4fc9501-54e2-5baa-bf12-feec5fed6f1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450257}] :answer-field/correct {:answer/id #uuid "f4fc9501-54e2-5baa-bf12-feec5fed6f1a" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450257} :answer-field/id #uuid "e46d5a65-585d-5246-84b9-60b6c53ced38" :answer-field/key "I" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451082} {:answer-field/choices [{:answer/id #uuid "eac938a0-2f02-528b-aa1f-cd4c2533f774" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450258} {:answer/id #uuid "586a9018-9f0f-556a-b600-1b488eba0901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450259}] :answer-field/correct {:answer/id #uuid "586a9018-9f0f-556a-b600-1b488eba0901" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450259} :answer-field/id #uuid "3fd1e1d7-90e4-552d-8b7f-5890e83db150" :answer-field/key "II" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451083} {:answer-field/choices [{:answer/id #uuid "03abe8a4-3038-556f-860c-4cb48b3a36e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450260} {:answer/id #uuid "036047f5-2b55-5f28-bb20-54fcffca67ad" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "true" :db/id #edb/ref 17592186450261}] :answer-field/correct {:answer/id #uuid "03abe8a4-3038-556f-860c-4cb48b3a36e7" :answer/type {:db/id #edb/ref 17592186045499 :db/ident :answer.type/text} :answer/value "false" :db/id #edb/ref 17592186450260} :answer-field/id #uuid "826fe441-a593-565f-921b-b7f4ca80e395" :answer-field/key "III" :answer-field/type {:db/id #edb/ref 17592186408166 :db/ident :answer-field.type/checkbox} :db/id #edb/ref 17592186451084}] :question/difficulty {:db/id #edb/ref 17592186045485 :db/ident :question.difficulty/easy} :question/id #uuid "12577a38-9f6c-5807-b07b-3944030b826c" :question/math-academy-id "q-22056" :question/problem "<div class=\"matrix-operands\">\n<div>$R=\\begin{bmatrix}0 & 0 \\\\ 0 & 0 \\\\ 0 & 0 \\\\ 0 & 0\\end{bmatrix}$</div>\n<div>$S=\\begin{bmatrix}1 & 0 & -1 & 0 \\\\ -1 & 0 & 1 & 8\\end{bmatrix}$</div>\n<div>$T=\\begin{bmatrix}1 & 0 \\\\ 0 & 1 \\\\ 0 & -1\\end{bmatrix}$</div>\n</div>\n\nWhich of the following statements are true regarding the matrices $R,S,$ and $T?$\n\nSelect all that apply.\n\n- **I.** The product $SR$ is well defined\n- **II.** The product $RS$ is well defined\n- **III.** The product $ST$ is well defined" :question/worked-solution "Notice that $R$ is a $4\\times 2$ matrix, $S$ is a $2\\times 4$ matrix, and $T$ is a $3\\times 2$ matrix.\n\nThere are $4$ columns in $S$ and $4$ rows in $R.$ Since the number of columns in $S$ equals the number of rows in $R,$ the matrices $S$ and $R$ are conformable for multiplication:\n\n$$\n{S}_{2\\times \\boxed{\\text{4}}}{\\times }_{✓}{R}_{\\boxed{\\text{4}}\\times 2}=\\text{well defined}\n$$\n\nOn the other hand, there are $2$ columns in $R$ and $2$ rows in $S.$ Since the number of columns in $R$ equals the number of rows in $S,$ the matrices $R$ and $S$ are conformable for multiplication:\n\n$$\n{R}_{4\\times \\boxed{\\text{2}}}{\\times }_{✓}{S}_{\\boxed{\\text{2}}\\times 4}=\\text{well defined}\n$$\n\nFinally, there are $4$ columns in $S$ and $3$ rows in $T.$ Since the number of columns in $S$ does **not** equal the number of rows in $T,$ the matrices $S$ and $T$ are **not** conformable for multiplication:\n\n$$\n{S}_{2\\times 4}{\\times }_{\\ne }{T}_{3\\times 2}=\\text{undefined}\n$$\n\nTherefore, statements I and II are true, while statement III is false."}] [{:db/id #edb/ref 17592186290371 :knowledge-point/_questions [{:db/id #edb/ref 17592186100869 :knowledge-point/id #uuid "b494140f-206a-5317-8079-ff719a253140" :knowledge-point/title "Determining Whether Two Matrices Are Conformable for Multiplica