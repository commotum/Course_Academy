"q-49415/selection/7979590e9f413feafd4003e4845ff33d5cd8f32c51c1c7797cf45d4ee0e59124"] :db/ensure [:answer-field/validate]} {:db/id "q-49415" :question/id #uuid "91d9290d-0194-58f2-86f3-0cadf7eccc60" :question/math-academy-id "q-49415" :question/problem "$\\int \\frac{{x}^{2}+5x+1}{x+3}\\,\\text{d}x=$" :question/worked-solution "We first need to decompose the integrand into its quotient and remainder parts, which we can do using synthetic division.\n\nWe draw up a synthetic division table:\n\n$$\n\\begin{aligned} & {x}^{2} & {x}^{1} & {x}^{0} \\\\ -3 & 1 & 5 & 1 \\\\  & ↓ & -3 & -6 \\\\  & 1 & 2 & -5\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\frac{{x}^{2}+5x+1}{x+3}=x+2-\\frac{5}{x+3}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{x}^{2}+5x+1}{x+3}\\,\\text{d}x & =\\int (x+2-\\frac{5}{x+3})\\text{d}x \\\\  & =\\int x\\,\\text{d}x+2\\int \\text{d}x-5\\int \\frac{1}{x+3}\\,\\text{d}x \\\\  & =\\frac{1}{2}{x}^{2}+2x-5\\operatorname{ln}⁡|x+3|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49415/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f110daa3-fd31-5e34-8a88-0e002c2e418a"] :knowledge-point/questions ["q-49415"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49463/selection/c3afc1e6005611316de58dd49b34d6a5c5500573f303e726765eb3f85862af86" :answer/id #uuid "e166d08f-fedf-5624-a398-67be8ab29086" :answer/type :answer.type/math :answer/value "\\frac{x}{2}-4\\operatorname{ln}⁡|2x-3|+C" :db/ensure [:answer/validate]} {:db/id "q-49463/selection/50bc0a1c365cc7daaff69de887782c7816b60749cbddb7f982651f6b1baf71b2" :answer/id #uuid "72010525-d447-51a5-97f4-5ac28e6d9839" :answer/type :answer.type/math :answer/value "x-\\frac{3}{2}\\operatorname{ln}⁡|2x-3|+C" :db/ensure [:answer/validate]} {:db/id "q-49463/selection/112a86460672c8a602f0845d6b95e8a6e8a417ffc48fb411f8af6994e17583f6" :answer/id #uuid "21d7072b-9dc3-53f7-bf21-3c2bd3af1fe1" :answer/type :answer.type/math :answer/value "x+\\frac{2}{3}\\operatorname{ln}⁡|2x-3|+C" :db/ensure [:answer/validate]} {:db/id "q-49463/selection/996cec58de456da8895587447dbfdca4ef62f05547ae214f8622de23a36d869a" :answer/id #uuid "5f40ebb6-e412-57f4-a537-9532a5f39f12" :answer/type :answer.type/math :answer/value "2x-3\\operatorname{ln}⁡|2x-3|+C" :db/ensure [:answer/validate]} {:db/id "q-49463/selection/77a1d2fad69e2b599fc838234c10b761dbed1b56f81fbcf462839b7e79135d07" :answer/id #uuid "9d917623-494a-5a44-93bb-1002e8dab193" :answer/type :answer.type/math :answer/value "\\frac{x}{2}+\\frac{7}{4}\\operatorname{ln}⁡|2x-3|+C" :db/ensure [:answer/validate]} {:db/id "q-49463/selection" :answer-field/id #uuid "ddd0705c-c1cc-51fb-92b4-f58d5f5d3b1c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49463/selection/77a1d2fad69e2b599fc838234c10b761dbed1b56f81fbcf462839b7e79135d07" :answer-field/choices ["q-49463/selection/c3afc1e6005611316de58dd49b34d6a5c5500573f303e726765eb3f85862af86" "q-49463/selection/50bc0a1c365cc7daaff69de887782c7816b60749cbddb7f982651f6b1baf71b2" "q-49463/selection/112a86460672c8a602f0845d6b95e8a6e8a417ffc48fb411f8af6994e17583f6" "q-49463/selection/996cec58de456da8895587447dbfdca4ef62f05547ae214f8622de23a36d869a" "q-49463/selection/77a1d2fad69e2b599fc838234c10b761dbed1b56f81fbcf462839b7e79135d07"] :db/ensure [:answer-field/validate]} {:db/id "q-49463" :question/id #uuid "fe19f1ff-58de-5fa5-b5fd-cb354b85476e" :question/math-academy-id "q-49463" :question/problem "Calculate $\\int \\frac{x+2}{2x-3}\\,\\text{d}x.$" :question/worked-solution "First, we pull out the factor of $2$ from the denominator:\n\n$$\n\\begin{aligned}\\int \\frac{x+2}{2x-3}\\,\\text{d}x & =\\int \\frac{x+2}{2(x-\\frac{3}{2})}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{x+2}{(x-\\frac{3}{2})}\\,\\text{d}x.\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ \\frac{3}{2} & 1 & 2 \\\\  & ↓ & \\frac{3}{2} \\\\  & 1 & \\frac{7}{2}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{x+2}{(x-\\frac{3}{2})} & =1+\\frac{(\\frac{7}{2})}{(x-\\frac{3}{2})} \\\\  & =1+\\frac{7}{2(x-\\frac{3}{2})} \\\\  & =1+\\frac{7}{2x-3}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{x+2}{2x-3}\\,\\text{d}x & =\\frac{1}{2}\\int (1+\\frac{7}{2x-3})\\text{d}x \\\\  & =\\frac{1}{2}[\\int \\text{d}x+7\\int \\frac{1}{2x-3}\\,\\text{d}x] \\\\  & =\\frac{1}{2}[x+\\frac{7}{2}\\operatorname{ln}⁡|2x-3|]+C \\\\  & =\\frac{x}{2}+\\frac{7}{4}\\operatorname{ln}⁡|2x-3|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49463/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7d71bc2-c0f0-5504-9f79-a5f5cdb8cd92"] :knowledge-point/questions ["q-49463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49465/selection/230d80a7a42f23f3ed3aac67e11623fea6f9c8641382b121a644844631c986f2" :answer/id #uuid "fdb60a1f-7513-5043-8f63-0c5ba4b33c71" :answer/type :answer.type/math :answer/value "\\frac{x}{3}-9\\operatorname{ln}⁡|3x+2|+C" :db/ensure [:answer/validate]} {:db/id "q-49465/selection/d62305060cfeb0024f349c5f94f3e5e69c4f81bf6bd7041aec2a2751110b10f3" :answer/id #uuid "c9ad5a4a-1327-561c-a70d-370887c3af3e" :answer/type :answer.type/math :answer/value "x-\\frac{1}{2}\\operatorname{ln}⁡|3x+2|+C" :db/ensure [:answer/validate]} {:db/id "q-49465/selection/37b8ccf19e46fa6f04c04934379763c07b5360822d2563c539b604a3a3489809" :answer/id #uuid "2e744238-8d9d-595e-9f6d-900f3a9c1be8" :answer/type :answer.type/math :answer/value "x+\\frac{2}{3}\\operatorname{ln}⁡|3x+2|+C" :db/ensure [:answer/validate]} {:db/id "q-49465/selection/4bcf4eedbc4b2163bf979e438d33523a107c6ad67bf3b5917539064e7d422501" :answer/id #uuid "fef03a04-4736-52b4-9036-385819d5c960" :answer/type :answer.type/math :answer/value "\\frac{x}{3}+\\frac{1}{9}\\operatorname{ln}⁡|3x+2|+C" :db/ensure [:answer/validate]} {:db/id "q-49465/selection/1cc39c674e6ac5448a79715f458f7a497a86522f864a4d9c1a8b391f9ec0646b" :answer/id #uuid "14a0d934-927d-5e77-bc4f-12c282fe59d9" :answer/type :answer.type/math :answer/value "3x-9\\operatorname{ln}⁡|3x+2|+C" :db/ensure [:answer/validate]} {:db/id "q-49465/selection" :answer-field/id #uuid "0fe1e80d-2ebc-5303-a8a0-68e8484f67e3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49465/selection/4bcf4eedbc4b2163bf979e438d33523a107c6ad67bf3b5917539064e7d422501" :answer-field/choices ["q-49465/selection/230d80a7a42f23f3ed3aac67e11623fea6f9c8641382b121a644844631c986f2" "q-49465/selection/d62305060cfeb0024f349c5f94f3e5e69c4f81bf6bd7041aec2a2751110b10f3" "q-49465/selection/37b8ccf19e46fa6f04c04934379763c07b5360822d2563c539b604a3a3489809" "q-49465/selection/4bcf4eedbc4b2163bf979e438d33523a107c6ad67bf3b5917539064e7d422501" "q-49465/selection/1cc39c674e6ac5448a79715f458f7a497a86522f864a4d9c1a8b391f9ec0646b"] :db/ensure [:answer-field/validate]} {:db/id "q-49465" :question/id #uuid "1fd799ff-202c-5050-9c9c-9e1ee127439a" :question/math-academy-id "q-49465" :question/problem "$\\int \\frac{x+1}{3x+2}\\,\\text{d}x=$" :question/worked-solution "First, we pull out the factor of $3$ from the denominator:\n\n$$\n\\begin{aligned}\\int \\frac{x+1}{3x+2}\\,\\text{d}x & =\\int \\frac{x+1}{3(x+\\frac{2}{3})}\\,\\text{d}x \\\\  & =\\frac{1}{3}\\int \\frac{x+1}{(x+\\frac{2}{3})}\\,\\text{d}x.\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ -\\frac{2}{3} & 1 & 1 \\\\  & ↓ & -\\frac{2}{3} \\\\  & 1 & \\frac{1}{3}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{x+1}{(x+\\frac{2}{3})} & =1+\\frac{(\\frac{1}{3})}{(x+\\frac{2}{3})} \\\\  & =1+\\frac{1}{3(x+\\frac{2}{3})} \\\\  & =1+\\frac{1}{3x+2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{x+1}{3x+2}\\,\\text{d}x & =\\frac{1}{3}\\int (1+\\frac{1}{3x+2})\\text{d}x \\\\  & =\\frac{1}{3}[\\int \\text{d}x+\\int \\frac{1}{3x+2}\\,\\text{d}x] \\\\  & =\\frac{1}{3}[x+\\frac{1}{3}\\operatorname{ln}⁡|3x+2|]+C \\\\  & =\\frac{x}{3}+\\frac{1}{9}\\operatorname{ln}⁡|3x+2|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49465/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7d71bc2-c0f0-5504-9f79-a5f5cdb8cd92"] :knowledge-point/questions ["q-49465"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73393/selection/864218a79c43cb180ca282d3e73d146fb119ffd49a082cf55adf6e1525b91101" :answer/id #uuid "fce04df6-a790-5ded-8370-30f5c0f145ff" :answer/type :answer.type/math :answer/value "x-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C" :db/ensure [:answer/validate]} {:db/id "q-73393/selection/0360e533b6a46a92c59ab39f4d9b7a94eb96496873f7b1cd0546a1bc201bb250" :answer/id #uuid "3e6ad204-2a0c-594a-8f10-8eed60dfcdef" :answer/type :answer.type/math :answer/value "\\frac{x}{7}-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|+C" :db/ensure [:answer/validate]} {:db/id "q-73393/selection/0ea526b60aaf15491b243ee8d14a0ef5bb5b6981b3e09f88d4b85842b53e1f3f" :answer/id #uuid "4bfc6fec-aa1b-5994-ba79-7790c1b46e9f" :answer/type :answer.type/math :answer/value "\\frac{x}{49}-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|+C" :db/ensure [:answer/validate]} {:db/id "q-73393/selection/00dada1fcb003a1cf34518b58856fa688ce2aed147ff19bfb80858179ba65857" :answer/id #uuid "d0a2dcbf-19c9-5453-83d3-844d435226cf" :answer/type :answer.type/math :answer/value "7x-\\operatorname{ln}⁡|7x+1|+C" :db/ensure [:answer/validate]} {:db/id "q-73393/selection/06ae2823fafcd9ec5b1494bd67a17d5cfee1c9b5d9aafd645e659644bfba8777" :answer/id #uuid "de77d7ff-d77c-5a1f-b4ce-7bdb619f5810" :answer/type :answer.type/math :answer/value "\\frac{x}{7}-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C" :db/ensure [:answer/validate]} {:db/id "q-73393/selection" :answer-field/id #uuid "535225d1-230e-5053-bad0-f77a3a089e77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73393/selection/06ae2823fafcd9ec5b1494bd67a17d5cfee1c9b5d9aafd645e659644bfba8777" :answer-field/choices ["q-73393/selection/864218a79c43cb180ca282d3e73d146fb119ffd49a082cf55adf6e1525b91101" "q-73393/selection/0360e533b6a46a92c59ab39f4d9b7a94eb96496873f7b1cd0546a1bc201bb250" "q-73393/selection/0ea526b60aaf15491b243ee8d14a0ef5bb5b6981b3e09f88d4b85842b53e1f3f" "q-73393/selection/00dada1fcb003a1cf34518b58856fa688ce2aed147ff19bfb80858179ba65857" "q-73393/selection/06ae2823fafcd9ec5b1494bd67a17d5cfee1c9b5d9aafd645e659644bfba8777"] :db/ensure [:answer-field/validate]} {:db/id "q-73393" :question/id #uuid "aa76429b-e060-5148-832a-3f506b654f9b" :question/math-academy-id "q-73393" :question/problem "Calculate $\\int \\frac{x}{7x+1}\\,\\text{d}x.$" :question/worked-solution "First, we pull out the factor of $7$ from the denominator:\n\n$$\n\\begin{aligned}\\int \\frac{x}{7x+1}\\,\\text{d}x & =\\int \\frac{x}{7(x+\\frac{1}{7})}\\,\\text{d}x \\\\  & =\\frac{1}{7}\\int \\frac{x}{(x+\\frac{1}{7})}\\,\\text{d}x\\end{aligned}\n$$\n\nThen, we draw up our synthetic division table to decompose the integrand into its quotient and remainder.\n\n$$\n\\begin{aligned} & x & {x}^{0} \\\\ -\\frac{1}{7} & 1 & 0 \\\\  & ↓ & -\\frac{1}{7} \\\\  & 1 & -\\frac{1}{7}\\end{aligned}\n$$\n\nSo from the synthetic division, we get that\n\n$$\n\\begin{aligned}\\frac{x}{(x+\\frac{1}{7})} & =1+\\frac{(-\\frac{1}{7})}{(x+\\frac{1}{7})} \\\\  & =1-\\frac{1}{7(x+\\frac{1}{7})} \\\\  & =1-\\frac{1}{7x+1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{x}{7x+1}\\,\\text{d}x & =\\frac{1}{7}\\int (1-\\frac{1}{7x+1})\\text{d}x \\\\  & =\\frac{1}{7}[\\int \\text{d}x-\\int \\frac{1}{7x+1}\\,\\text{d}x] \\\\  & =\\frac{1}{7}[x-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|]+C \\\\  & =\\frac{x}{7}-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73393/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a7d71bc2-c0f0-5504-9f79-a5f5cdb8cd92"] :knowledge-point/questions ["q-73393"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352248/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "2feece16-a794-537c-ab0e-3ea2d33aae10" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-352248/field-1" :answer-field/id #uuid "a60bc9ba-3203-5719-bb3f-6e744554fe41" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352248/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer-field/choices ["q-352248/field-1/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-352248/field-2/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "8dc12e0a-46c9-5ea2-afa2-66efff04e2f8" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-352248/field-2" :answer-field/id #uuid "adb7ccbc-e175-525a-8d7d-0c5567347034" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352248/field-2/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer-field/choices ["q-352248/field-2/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :db/ensure [:answer-field/validate]} {:db/id "q-352248" :question/id #uuid "d7caa7d8-8e68-5e80-a607-cfcc74dea056" :question/math-academy-id "q-352248" :question/problem "Evaluate the following integral:\n\n${\\int }_{0}^{1}\\frac{{x}^{3}+4{x}^{2}+3x+1}{x+2}\\,\\text{d}x=$ \n{{field-1}}\n$+\\,\\,3\\operatorname{ln}⁡(${{field-2}}$)$" :question/worked-solution "The denominator of the integrand doesn't divide the numerator exactly, so we need to decompose it into its quotient and remainder parts, which we can do using synthetic division.\n\nWe start by drawing up our synthetic division table:\n\n|  | ${x}^{3}$ | ${x}^{2}$ | ${x}^{1}$ | ${x}^{0}$ |\n| --- | --- | --- | --- | --- |\n| $-2$ | $1$ | $4$ | $3$ | $1$ |\n|  | $↓$ | $-2$ | $-4$ | $2$ |\n|  | $1$ | $2$ | $-1$ | $3$ |\n\nSo, from the synthetic division, we get that\n\n$$\n\\frac{{x}^{3}+4{x}^{2}+3x+1}{x+2}={x}^{2}+2x-1+\\frac{3}{x+2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{{x}^{3}+4{x}^{2}+3x+1}{x+2}\\,\\text{d}x & ={\\int }_{0}^{1}({x}^{2}+2x-1+\\frac{3}{x+2})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}\\,\\text{d}x+2{\\int }_{0}^{1}x\\,\\text{d}x-{\\int }_{0}^{1}\\text{d}x+3{\\int }_{0}^{1}\\frac{1}{x+2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}}{3}{|}_{0}^{1}+{x}^{2}{|}_{0}^{1}-x{|}_{0}^{1}+3\\operatorname{ln}⁡|x+2|{|}_{0}^{1} \\\\  & =\\frac{1}{3}({1}^{3}-{0}^{3})+({1}^{2}-{0}^{2})-(1-0)+3(\\operatorname{ln}⁡|1+2|-\\operatorname{ln}⁡|0+2|) \\\\  & =\\frac{1}{3}+1-1+3(\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{3}+3\\operatorname{ln}⁡(\\,\\frac{3}{2}\\,).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-352248/field-1" "q-352248/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f110daa3-fd31-5e34-8a88-0e002c2e418a"] :knowledge-point/questions ["q-352248"] :db/ensure [:knowledge-point/validate]}]
