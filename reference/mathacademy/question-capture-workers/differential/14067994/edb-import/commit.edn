)}{(x+\\frac{1}{7})} \\\\  & =1-\\frac{1}{7(x+\\frac{1}{7})} \\\\  & =1-\\frac{1}{7x+1}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{x}{7x+1}\\,\\text{d}x & =\\frac{1}{7}\\int (1-\\frac{1}{7x+1})\\text{d}x \\\\  & =\\frac{1}{7}[\\int \\text{d}x-\\int \\frac{1}{7x+1}\\,\\text{d}x] \\\\  & =\\frac{1}{7}[x-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|]+C \\\\  & =\\frac{x}{7}-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C.\\end{aligned}\n$$" 13194139535606 true] [17592186357306 1000 #edb/ref 17592186357307 13194139535606 true] [17592186357306 1000 #edb/ref 17592186357308 13194139535606 true] [17592186357306 1000 #edb/ref 17592186357309 13194139535606 true] [17592186357306 1000 #edb/ref 17592186357310 13194139535606 true] [17592186357306 1000 #edb/ref 17592186357311 13194139535606 true] [17592186357306 1040 #edb/ref 17592186045450 13194139535606 true] [17592186357306 1041 "selection" 13194139535606 true] [17592186357306 1104 #edb/ref 17592186357309 13194139535606 true] [17592186357306 1110 #uuid "535225d1-230e-5053-bad0-f77a3a089e77" 13194139535606 true] [17592186357307 1034 "7x-\\operatorname{ln}⁡|7x+1|+C" 13194139535606 true] [17592186357307 1103 #edb/ref 17592186045453 13194139535606 true] [17592186357307 1111 #uuid "d0a2dcbf-19c9-5453-83d3-844d435226cf" 13194139535606 true] [17592186357308 1034 "\\frac{x}{7}-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|+C" 13194139535606 true] [17592186357308 1103 #edb/ref 17592186045453 13194139535606 true] [17592186357308 1111 #uuid "3e6ad204-2a0c-594a-8f10-8eed60dfcdef" 13194139535606 true] [17592186357309 1034 "\\frac{x}{7}-\\frac{1}{49}\\operatorname{ln}⁡|7x+1|+C" 13194139535606 true] [17592186357309 1103 #edb/ref 17592186045453 13194139535606 true] [17592186357309 1111 #uuid "de77d7ff-d77c-5a1f-b4ce-7bdb619f5810" 13194139535606 true] [17592186357310 1034 "\\frac{x}{49}-\\frac{1}{7}\\operatorname{ln}⁡|7x+1|+C" 13194139535606 true] [17592186357310 1103 #edb/ref 17592186045453 13194139535606 true] [17592186357310 1111 #uuid "4b