lows from line $L1$ by the {{field-3}}."}] [{:db/id #edb/ref 17592186221935 :knowledge-point/_questions [{:knowledge-point/id #uuid "af871f3d-da9e-5fd3-a61f-94e155ccf2b3" :knowledge-point/title "Constructing a Fundamental Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8768dd56-c0fc-583e-822c-6575903b9078" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 & -2 \\\\ 2 & 1\\end{bmatrix}" :db/id #edb/ref 17592186220587} {:answer/id #uuid "89daedea-da9e-59f9-ad22-509d3847c15f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}e^{t}\\cos 2t & -e^{t}\\sin 2t \\\\ e^{t}\\sin 2t & e^{t}\\cos 2t\\end{bmatrix}" :db/id #edb/ref 17592186220588} {:answer/id #uuid "d66f2830-46a6-5121-889a-63b107df6397" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}\\cos 2t & -\\sin 2t \\\\ \\sin 2t & \\cos 2t\\end{bmatrix}" :db/id #edb/ref 17592186220589} {:answer/id #uuid "5ed2e693-a120-58c3-95fc-d17cb9ff7c55" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}e^{t}\\cos t & e^{t}\\sin t \\\\ -e^{t}\\sin t & e^{t}\\cos t\\end{bmatrix}" :db/id #edb/ref 17592186220590} {:answer/id #uuid "7aebd347-1fac-5f4a-88d1-5def198f349e" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}e\\cos 2 & -e\\sin 2 \\\\ e\\sin 2 & e\\cos 2\\end{bmatrix}" :db/id #edb/ref 17592186220591}] :answer-field/correct {:answer/id #uuid "89daedea-da9e-59f9-ad22-509d3847c15f" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}e^{t}\\cos 2t & -e^{t}\\sin 2t \\\\ e^{t}\\sin 2t & e^{t}\\cos 2t\\end{bmatrix}" :db/id #edb/ref 17592186220588} :answer-field/id #uuid "7634ac73-0ede-5218-abe9-859f177734ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186220586}] :question/id #uuid "ecd4b4f8-b1ae-5164-9bed-1e7df536d7e1" :question/math-academy-id "q-334329" :question/problem "$x^{′} = \\begin{bmatrix}1 & 