}⁡5t & {e}^{2t}\\operatorname{cos}⁡5t\\end{aligned}].\n$$\n\n**Note:** The columns of $Φ$ can be written in any order." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-334331" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/activity-metadata.json" "file_sha256" "9108dced82c6cb3acf6ef30d87531244a88a01288772cefc5d4d3f20b5e123ab"} {"question" "q-334331" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-334331" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}2 & -5 \\\\ 5 & 2\\end{aligned}]"] ["math" "[\\begin{aligned}\\operatorname{cos}⁡5t & -\\operatorname{sin}⁡5t \\\\ \\operatorname{sin}⁡5t & \\operatorname{cos}⁡5t\\end{aligned}]"] ["math" "[\\begin{aligned}{e}^{2t}\\operatorname{cos}⁡5t & -{e}^{2t}\\operatorname{sin}⁡5t \\\\ {e}^{2t}\\operatorname{sin}⁡5t & {e}^{2t}\\operatorname{cos}⁡5t\\end{aligned}]"] ["math" "[\\begin{aligned}{e}^{2t}\\operatorname{cos}⁡5t & {e}^{2t}\\operatorname{sin}⁡5t \\\\ -{e}^{2t}\\operatorname{sin}⁡5t & {e}^{2t}\\operatorname{cos}⁡5t\\end{aligned}]"] ["math" "[\\begin{aligned}{e}^{2}\\operatorname{cos}⁡5 & -{e}^{2}\\operatorname{sin}⁡5 \\\\ {e}^{2}\\operatorname{sin}⁡5 & {e}^{2}\\operatorname{cos}⁡5\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-334331" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}{e}^{2t}\\operatorname{cos}⁡5t & -{e}^{2t}\\operatorname{sin}⁡5t \\\\ {e}^{2t}\\operatorname{sin}⁡5t & {e}^{2t}\\operatorname{cos}⁡5t\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" nil "attribute" "question/problem" "value" "Consider the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant $2\\times 2$ matrix. Let $Φ(t)$ be a fundamental matrix for this system. A derivation showing that $Φ(t)$ satisfies the matrix differential equation ${Φ}^{′}(t)=A\\,Φ(t)$ is given below.\n\n*Hint: $[a,\\,b]$ denotes a matrix whose columns are vectors $a$ and $b.$*\n\n$\\text{L1}:\\,$ Let $Φ(t)=[{x}_{1}(t),\\,{x}_{2}(t)]$\n\n$\\text{L2}:\\,$ ${x}_{1}^{′}(t)=A{x}_{1}(t)$\n\n$\\text{L3}:\\,$ ${x}_{2}^{′}(t)=A{x}_{2}(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}(t)=[{x}_{1}^{′}(t),\\,{x}_{2}^{′}(t)]$\n\n$\\text{L5}:\\,$ ${Φ}^{′}(t)=[A{x}_{1}(t),\\,A{x}_{2}(t)]$\n\n$\\text{L6}:\\,$ ${Φ}^{′}(t)=A[{x}_{1}(t),\\,{x}_{2}(t)]$\n\n$\\text{L7}:\\,$ ${Φ}^{′}(t)=AΦ(t)$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L3}$ follows from the fact that $Φ(t)$ is a fundamental matrix and line $\\text{L1}$ by the {{field-1}}.\n\n$\\,$ Line $\\text{L4}$ follows from line $\\text{L1}$ by {{field-2}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L5}$ by {{field-3}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" nil "attribute" "question/worked-solution" "value" "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L3}.$ Since $Φ(t)$ is a fundamental matrix, its columns are solutions of the homogeneous system ${x}^{′}(t)=Ax(t).$ Line $\\text{L1}$ identifies ${x}_{2}(t)$ as a column of $Φ(t),$ so ${x}_{2}(t)$ must satisfy the differential equation. In particular,\n\n$$\n{x}_{2}^{′}(t)=A{x}_{2}(t).\n$$\n\nTherefore, $\\text{L3}$ follows from the fact that $Φ(t)$ is a fundamental matrix and line $\\text{L1}$ by the $\\text{definition of a fundamental matrix}.$\n\n- Next, we consider lines $\\text{L1}$ and $\\text{L4}.$ Since $Φ(t)=[{x}_{1}(t),\\,{x}_{2}(t)],$ the derivative of $Φ(t)$ is obtained by differentiating each column:\n\n$$\n{Φ}^{′}(t)=[{x}_{1}^{′}(t),\\,{x}_{2}^{′}(t)].\n$$\n\nThus, $\\text{L4}$ follows from $\\text{L1}$ by $\\text{differentiating each column}.$\n\n- Finally, we consider lines $\\text{L5}$ and $\\text{L6}.$ We now factor the matrix $A$ on the left:\n\n$$\n{Φ}^{′}(t)=[A{x}_{1}(t),\\,A{x}_{2}(t)]=A[{x}_{1}(t),\\,{x}_{2}(t)].\n$$\n\nTherefore, $\\text{L6}$ follows from $\\text{L5}$ by $\\text{factoring out }A\\text{ on the left}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/activity-metadata.json" "file_sha256" "9108dced82c6cb3acf6ef30d87531244a88a01288772cefc5d4d3f20b5e123ab"} {"question" "q-336309" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-1" "attribute" "answer-field/choices" "value" [["text" "$A$ is diagonalizable"] ["text" "$Φ(t)$ is invertible for all $t$"] ["text" "definition of a fundamental matrix"] ["text" "definition of matrix multiplication"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/text "definition of a fundamental matrix"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-2" "attribute" "answer-field/choices" "value" [["text" "differentiating each column"] ["text" "factoring out $A$ on the left"] ["text" "multiplying both sides by $A$"] ["text" "transposing the matrix"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/text "differentiating each column"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-3" "attribute" "answer-field/choices" "value" [["text" "adding $Φ(t)$ to both sides"] ["text" "differentiating again"] ["text" "factoring out $A$ on the left"] ["text" "transposing the matrix"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336309" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/text "factoring out $A$ on the left"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336107" "field" nil "attribute" "question/problem" "value" "Consider the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant $2\\times 2$ matrix. Let $Φ(t)$ be a fundamental matrix for this system. A derivation showing that every solution $x(t)$ can be written in the form $x(t)=Φ(t)\\,c$ for some constant vector $c=[{c}_{1},\\,{c}_{2}]^{T}$ is given below.\n\n$\\text{L1}:\\,$ Let ${x}_{1}(t)$ and ${x}_{2}(t)$ be the columns of $Φ(t)$\n\n$\\text{L2}:\\,$ ${x}_{1}(t)$ and ${x}_{2}(t)$ form a basis of solutions\n\n$\\text{L3}:\\,$ $x(t)$ can be written as $x(t)={c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)$\n\n$\\text{L4}:\\,$ $Φ(t)\\,c={c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)$\n\n$\\text{L5}:\\,$ $x(t)=Φ(t)\\,c$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L2}$ follows from {{field-1}} by the definition of a fundamental matrix.\n\n$\\,$ Line $\\text{L4}$ follows from line $\\text{L1}$ by the {{field-2}}.\n\n$\\,$ Line $\\text{L5}$ follows from lines {{field-3}} by {{field-4}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336107" "field" nil "attribute" "question/worked-solution" "value" "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L2}.$ Since $Φ(t)$ is a fundamental matrix, its columns ${x}_{1}(t)$ and ${x}_{2}(t)$ form a basis of the solution space for our system. Thus, $\\text{L2}$ follows from $\\text{L1}$ by the definition of a fundamental matrix.\n\n- Next, we consider lines $\\text{L1}$ and $\\text{L4}.$ Since ${x}_{1}(t)$ and ${x}_{2}(t)$ are the columns of $Φ(t),$ we can write\n\n$$\nΦ(t)=[\\begin{aligned}\\,| & | \\\\ {x}_{1}(t) & {x}_{2}(t) \\\\ \\,| & |\\end{aligned}].\n$$\n\nThen by the definition of matrix multiplication,\n\n$$\nΦ(t)\\,c=[\\begin{aligned}\\,| & | \\\\ {x}_{1}(t) & {x}_{2}(t) \\\\ \\,| & |\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}]={c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t).\n$$\n\nThus, $\\text{L4}$ follows from $\\text{L1}$ by the $\\text{definition of matrix multiplication}.$\n\n- Finally, we consider lines $\\text{L3}$ and $\\text{L4}.$ In $\\text{L3}$ we have $x(t)={c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t),$ and in $\\text{L4}$ we have $Φ(t)c={c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t).$ Since both expressions are equal to the same quantity, the transitive property of equality gives $x(t)=Φ(t)c.$ Thus, $\\text{L5}$ follows from $\\text{L3 and L4}$ by the $\\text{the transitive property of equality}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336107" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/activity-metadata.json" "file_sha256" "9108dced82c6cb3acf6ef30d87531244a88a01288772cefc5d4d3f20b5e123ab"} {"question" "q-336107" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336107" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "\\text{L1}"] ["math" "\\text{L3}"] ["math" "\\text{L4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336107" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\text{L1}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c33616a29253eb6ae6b40b8702e80bd1963e0"} {"question" "q-336107" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070844/state.json" "file_sha256" "cae41375d9854e678f9299c1588c3