{e}^{2t}\\operatorname{sin}⁡5t \\\\ {e}^{2t}\\operatorname{cos}⁡5t\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, our fundamental could be written as\n\n$$\nΦ(t)=[\\begin{aligned}{e}^{2t}\\operatorname{cos}⁡5t & -{e}^{2t}\\operatorname{sin}⁡5t \\\\ {e}^{2t}\\operatorname{sin}⁡5t & {e}^{2t}\\operatorname{cos}⁡5t\\end{aligned}].\n$$\n\n**Note:** The columns of $Φ$ can be written in any order." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334331/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "af871f3d-da9e-5fd3-a61f-94e155ccf2b3"] :knowledge-point/questions ["q-334331"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336309/field-1/ed638285b2b39b62ade902fa60b790fb68a87a79b2b1ac91eb5ea9897f39ed8f" :answer/id #uuid "3aa66913-49ff-59fc-8b02-77149d7119c1" :answer/type :answer.type/text :answer/value "definition of matrix multiplication" :db/ensure [:answer/validate]} {:db/id "q-336309/field-1/c8a64c4b4dd31a8f49b1a6d0f62ddcbc9421b30c69b2ba7584fbb56ce1a35d48" :answer/id #uuid "cadb21b9-a54a-5353-bc21-3a56069a7fcf" :answer/type :answer.type/text :answer/value "$A$ is diagonalizable" :db/ensure [:answer/validate]} {:db/id "q-336309/field-1/1c61c573cf7ae6cac5f1f6aacce1afbc39bb4525f01739c00ce9089c715b3655" :answer/id #uuid "b162326b-1782-5055-a1e9-4d6dc7515a21" :answer/type :answer.type/text :answer/value "$Φ(t)$ is invertible for all $t$" :db/ensure [:answer/validate]} {:db/id "q-336309/field-1/c9fcc813d07eaabb5860e77a9cdd1ff7f681d7c81093ed4851ee4d3510ffde85" :answer/id #uuid "a57245f2-8594-5d66-9e55-22be0fd3ab70" :answer/type :answer.type/text :answer/value "definition of a fundamental matrix" :db/ensure [:answer/validate]} {:db/id "q-336309/field-1" :answer-field/id #uuid "cb26a78f-ec86-57df-a4f6-824ccb1c2e96" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-336309/field-1/c9fcc813d07eaabb5860e77a9cdd1ff7f681d7c81093ed4851ee4d3510ffde85" :answer-field/choices ["q-336309/field-1/ed638285b2b39b62ade902fa60b790fb68a87a79b2b1ac91eb5ea9897f39ed8f" "q-336309/field-1/c8a64c4b4dd31a8f49b1a6d0f62ddcbc9421b30c69b2ba7584fbb56ce1a35d48" "q-336309/field-1/1c61c573cf7ae6cac5f1f6aacce1afbc39bb4525f01739c00ce9089c715b3655" "q-336309/field-1/c9fcc813d07eaabb5860e77a9cdd1ff7f681d7c81093ed4851ee4d3510ffde85"] :db/ensure [:answer-field/validate]} {:db/id "q-336309/field-2/cb0a92e5eff4498d185a15a07cad66d2bc262b232f4e313e14da69f64d8881c3" :answer/id #uuid "fada221d-18f9-5740-8505-e330e8db3179" :answer/type :answer.type/text :answer/value "differentiating each column" :db/ensure [:answer/validate]} {:db/id "q-336309/field-2/24d21b0d639047c3244caa63873095bafe258ba06ccc39da9198b295f7d5f6d0" :answer/id #uuid "4b92f2e1-4048-54c9-91b6-75fa55751d74" :answer/type :answer.type/text :answer/value "multiplying both sides by $A$" :db/ensure [:answer/validate]} {:db/id "q-336309/field-2/d5668059631d1826dc438c5e08df911b7db22d677a287df55f89894e9cd4645f" :answer/id #uuid "a3d0f926-cad4-5dd7-b07e-7dd0e5277b9b" :answer/type :answer.type/text :answer/value "transposing the matrix" :db/ensure [:answer/validate]} {:db/id "q-336309/field-2/1312b864e8a71b0fb8c8ff97e69337e9448f828f4c635fa3893fb62df18554ab" :answer/id #uuid "c57b44ce-9bdf-5a6e-a64d-d731d1a0512a" :answer/type :answer.type/text :answer/value "factoring out $A$ on the left" :db/ensure [:answer/validate]} {:db/id "q-336309/field-2" :answer-field/id #uuid "ab76daf2-5635-56e5-be3a-8a61f05ebd8d" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-336309/field-2/cb0a92e5eff4498d185a15a07cad66d2bc262b232f4e313e14da69f64d8881c3" :answer-field/choices ["q-336309/field-2/cb0a92e5eff4498d185a15a07cad66d2bc262b232f4e313e14da69f64d8881c3" "q-336309/field-2/24d21b0d639047c3244caa63873095bafe258ba06ccc39da9198b295f7d5f6d0" "q-336309/field-2/d5668059631d1826dc438c5e08df911b7db22d677a287df55f89894e9cd4645f" "q-336309/field-2/1312b864e8a71b0fb8c8ff97e69337e9448f828f4c635fa3893fb62df18554ab"] :db/ensure [:answer-field/validate]} {:db/id "q-336309/field-3/d5668059631d1826dc438c5e08df911b7db22d677a287df55f89894e9cd4645f" :answer/id #uuid "810c3167-f378-54b5-a21c-c25271b44561" :answer/type :answer.type/text :answer/value "transposing the matrix" :db/ensure [:answer/validate]} {:db/id "q-336309/field-3/1312b864e8a71b0fb8c8ff97e69337e9448f828f4c635fa3893fb62df18554ab" :answer/id #uuid "fb880c89-a496-5b76-9021-946b18b50257" :answer/type :answer.type/text :answer/value "factoring out $A$ on the left" :db/ensure [:answer/validate]} {:db/id "q-336309/field-3/eb09a9b372ce1dd8f273bfb534a23ab2315fb3889256901de6da6220ed393e4f" :answer/id #uuid "7020615f-70fd-5981-b089-619da9914eed" :answer/type :answer.type/text :answer/value "differentiating again" :db/ensure [:answer/validate]} {:db/id "q-336309/field-3/ec4853b3921019d5244ff4728b011f929b731719e7770407ed693533d55267ad" :answer/id #uuid "b5149be5-f576-577e-b8a0-7c031368552f" :answer/type :answer.type/text :answer/value "adding $Φ(t)$ to both sides" :db/ensure [:answer/validate]} {:db/id "q-336309/field-3" :answer-field/id #uuid "66999d0e-3d88-58b0-a324-fbb375a9dfcc" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-336309/field-3/1312b864e8a71b0fb8c8ff97e69337e9448f828f4c635fa3893fb62df18554ab" :answer-field/choices ["q-336309/field-3/d5668059631d1826dc438c5e08df911b7db22d677a287df55f89894e9cd4645f" "q-336309/field-3/1312b864e8a71b0fb8c8ff97e69337e9448f828f4c635fa3893fb62df18554ab" "q-336309/field-3/eb09a9b372ce1dd8f273bfb534a23ab2315fb3889256901de6da6220ed393e4f" "q-336309/field-3/ec4853b3921019d5244ff4728b011f929b731719e7770407ed693533d55267ad"] :db/ensure [:answer-field/validate]} {:db/id "q-336309" :question/id #uuid "a12cf1e0-8187-51a8-afd1-8c77d727f77f" :question/math-academy-id "q-336309" :question/problem "Consider the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant $2\\times 2$ matrix. Let $Φ(t)$ be a fundamental matrix for this system. A derivation showing that $Φ(t)$ satisfies the matrix differential equation ${Φ}^{′}(t)=A\\,Φ(t)$ is given below.\n\n*Hint: $[a,\\,b]$ denotes a matrix whose columns are vectors $a$ and $b.$*\n\n$\\text{L1}:\\,$ Let $Φ(t)=[{x}_{1}(t),\\,{x}_{2}(t)]$\n\n$\\text{L2}:\\,$ ${x}_{1}^{′}(t)=A{x}_{1}(t)$\n\n$\\text{L3}:\\,$ ${x}_{2}^{′}(t)=A{x}_{2}(t)$\n\n$\\text{L4}:\\,$ ${Φ}^{′}(t)=[{x}_{1}^{′}(t),\\,{x}_{2}^{′}(t)]$\n\n$\\text{L5}:\\,$ ${Φ}^{′}(t)=[A{x}_{1}(t),\\,A{x}_{2}(t)]$\n\n$\\text{L6}:\\,$ ${Φ}^{′}(t)=A[{x}_{1}(t),\\,{x}_{2}(t)]$\n\n$\\text{L7}:\\,$ ${Φ}^{′}(t)=AΦ(t)$\n\nSelect the correct options in the following reasoning.\n\n$\\,$ Line $\\text{L3}$ follows from the fact that $Φ(t)$ is a fundamental matrix and line $\\text{L1}$ by the {{field-1}}.\n\n$\\,$ Line $\\text{L4}$ follows from line $\\text{L1}$ by {{field-2}}.\n\n$\\,$ Line $\\text{L6}$ follows from line $\\text{L5}$ by {{field-3}}." :question/worked-solution "Let's justify each of the selected steps.\n\n- We first consider lines $\\text{L1}$ and $\\text{L3}.$ Since $Φ(t)$ is a fundamental matrix, its columns are solutions of the homogeneous system ${x}^{′}(t)=Ax(t).$ Line $\\text{L1}$ identifies ${x}_{2}(t)$ as a column of $Φ(t),$ so ${x}_{2}(t)$ must satisfy the differential equation. In particular,\n\n$$\n{x}_{2}^{′}(t)=A{x}_{2}(t).\n$$\n\nTherefore, $\\text{L3}$ follows from the fact that $Φ(t)$ is a fundamental matrix and line $\\text{L1}$ by the $\\text{definition of a fundamental matrix}.$\n\n- Next, we consider lines $\\text{L1}$ and $\\text{L4}.$ Since $Φ(t)=[{x}_{1}(t),\\,{x}_{2}(t)],$ the derivative of $Φ(t)$ is obtained by differentiating each column:\n\n$$\n{Φ}^{′}(t)=[{x}_{1}^{′}(t),\\,{x}_{2}^{′}(t)].\n$$\n\nThus, $\\text{L4}$ follows from $\\text{L1}$ by $\\text{differentiating each column}.$\n\n- Finally, we consider lines $\\text{L5}$ and $\\text{L6}.$ We now factor the matrix $A$ on the left:\n\n$$\n{Φ}^{′}(t)=[A{x}_{1}(t),\\,A{x}_{2}(t)]=A[{x}_{1}(t),\\,{x}_{2}(t)].\n$$\n\nTherefore, $\\text{L6}$ follows from $\\text{L5}$ by $\\text{factoring out }A\\text{ on the left}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-336309/field-1" "q-336309/field-2" "q-336309/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0aea7503-74d6-5ba4-9411-ee53e59512d0"] :knowledge-point/questions ["q-336309"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336107/field-1/042168976629a933b0d0ef460bdad0013cb33b8a34cdbca393ce80067da1046d" :answer/id #uuid "62054700-d24d-5d67-8f7e-e60a1a15e65f" :answer/type :answer.type/math :answer/value "\\text{L1}" :db/ensure [:answer/validate]} {:db/id "q-336107/field-1/124b0c2eb11420d91f7684989e46375a3c1c904a04910b2d823439550b297bf2" :answer/id #uuid "36698872-b453-5037-910c-a8e0982ddc53" :answer/type :answer.type/math :answer/value "\\text{L4}" :db/ensure [:answer/validate]} {:db/id "q-336107/field-1/e04811e52d1b108844992320b02362618b439dac20ffc031cd3e9eda4c7aaa2b" :answer/id #uuid "e263670a-abdd-5e7e-8183-50800969020d" :answer/type :answer.type/math :answer/value "\\text{L3}" :db/ensure [:answer/validate]} {:db/id "q-336107/field-1" :answer-field/id #uuid "13cf202b-91a6-5232-a463-b56b190ca724" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-336107/field-1/042168976629a933b0d0ef460bdad0013cb33b8a34cdbca393ce80067da1046d" :answer-field/choices ["q-336107/field-1/042168976629a933b0d0ef460bdad0013cb33b8a34cdbca393ce80067da1046d" "q-336107/field-1/124b0c2eb11420d91f7684989e46375a3c1c904a04910b2d823439550b297bf2" "q-336107/field-1/e04811e52d1b108844992320b02362618b439dac20ffc031cd3e9eda4c7aaa2b"] :db/ensure [:answer-field/validate]} {:db/id "q-336107/field-2/3e766754e1f76965949e819dc5824cd0034b9c80ec30ec9339435e7997ed35bf" :answer/id #uuid "3cc5454a-a5f1-52c1-8182-610adbb87eaf" :answer/type :answer.type/text :answer/value "integrating the given system" :db/ensure [:answer/validate]} {:db/id "q-336107/field-2/dc8611bde8eda73d4