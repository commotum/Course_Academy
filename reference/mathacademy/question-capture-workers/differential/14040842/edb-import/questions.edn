57fd1" :answer/type {:db/ident :answer.type/math} :answer/value "x = 2\\cos \\theta  + 3, y = 3\\sin \\theta  - 1" :db/id #edb/ref 17592186151217} :answer-field/id #uuid "85479bab-2698-5739-baf8-d6800ff00faa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186151212}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5c09e84a-e7d0-5c50-95f2-01ada1064320" :question/math-academy-id "q-78680" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14032117/assets/14d1fc5a92c28cc7f84c1ec23929701f1aca67b1a15d6113fa83f1428354fc11.png)\n\nConsider the ellipse centered at $(3,-1)$ with horizontal radius $2$ and vertical radius $3,$ as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the ellipse once in the counterclockwise direction starting at the point $A(5,-1)?$" :question/worked-solution "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the ellipse is traversed once in the counterclockwise direction, starting from $(h+a,k).$\n\nIn our case, the ellipse is centered at the point $(3,-1),$ $a=2$ and $b=3.$ Therefore, the parametric equations of the ellipse are \n\n$$\nx=2\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -1,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186287382 :knowledge-point/_questions [{:knowledge-point/id #uuid "db20f4a5-27a4-5fbc-aae2-2febf8f99cb1" :knowledge-point/title "The Parametric Equations of an Ellipse Centered at the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95eae759-7706-57f4-88d2-511815ad1f0d" :answer/type {:db/ident :a