answer/id #uuid "bc4b52f4-4953-5c88-bd2d-1636592e7089" :answer/type {:db/ident :answer.type/math} :answer/value "x=5\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186287287} {:answer/id #uuid "b2d3a771-a99f-5f99-8677-9f9f7ab0151c" :answer/type {:db/ident :answer.type/math} :answer/value "x=10\\operatorname{sin}⁡\\theta -2,\\,y=6\\operatorname{cos}⁡\\theta -3" :db/id #edb/ref 17592186287288}] :answer-field/correct {:answer/id #uuid "ecdefb26-6f9c-59e6-a300-b9ba36b0662e" :answer/type {:db/ident :answer.type/math} :answer/value "x=5\\operatorname{cos}⁡\\theta -2,\\,y=3\\operatorname{sin}⁡\\theta -3" :db/id #edb/ref 17592186287285} :answer-field/id #uuid "5c5d9901-45ec-5a82-b5ff-6ae652bb348e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287283}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "fe4502b9-4c15-5777-ace8-7177e53571cf" :question/math-academy-id "q-106398" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040842/assets/7b9f67594871385ccf7ac02c3af9e47a585116c162a08cdc1795d452a09912fe.png)\n\nConsider the ellipse centered at $(-2,-3)$ with horizontal radius $5$ and vertical radius $3,$ as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the ellipse once in the counterclockwise direction starting at the point $A(3,-3)?$" :question/worked-solution "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the ellipse is traversed once in the counterclockwise direction, starting from $(h+a,k).$\n\nIn our case, the ellipse is centered at the point $(-2,-3),$ $a=5$ and $b=3.$ Therefore, the parametric equations of the ellipse are \n\n$$\nx=5\\operatorname{cos}⁡\\theta -2,\\,y=3\\operatorname{sin}⁡\\theta -3,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186287289 :knowledge-point/_questions [{:knowledge-point/id #uuid "9b51a7bc-7701-539f-9e20-dfc7f2574559" :knowledge-point/title "Parametrizing Part of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "861da652-f677-5fa7-a40e-7ee0a493bbb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186287291} {:answer/id #uuid "1f83c84e-621b-5000-b60c-556777725315" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186287292} {:answer/id #uuid "df45a23e-d530-5666-a794-d534c05bcf4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,2\\pi ]" :db/id #edb/ref 17592186287293} {:answer/id #uuid "ba900f3f-81f4-5508-8e8f-09127ffabd6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186287294} {:answer/id #uuid "cb7df34a-a9ab-5f79-95ae-9b8e42fb067d" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186287295}] :answer-field/correct {:answer/id #uuid "1f83c84e-621b-5000-b60c-556777725315" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186287292} :answer-field/id #uuid "9fc3cf9b-cb13-50c7-b8c9-940fb76a2b2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287290}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7003b4fc-eeae-5c86-9a52-755b32646d64" :question/math-academy-id "q-106400" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/q