34550 true] [17592186294788 1145 "The Cartesian equation of the tangent plane to the surface $z=f(x,y)$ at the point $({x}_{0},{y}_{0},{z}_{0})$ on the surface can be written as\n\n$$\nz-{z}_{0}=(x-{x}_{0})\\frac{∂f}{∂x}({x}_{0},{y}_{0})+(y-{y}_{0})\\frac{∂f}{∂y}({x}_{0},{y}_{0}).\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x{y}^{2}+{x}^{2}y) \\\\  & ={y}^{2}+2xy \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x{y}^{2}+{x}^{2}y) \\\\  & =2xy+{x}^{2}\\end{aligned}\n$$\n\nNext, we evaluate the partial derivatives at $(x,y)=(1,1):$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}(1,1) & ={1}^{2}+2(1)(1)=3 \\\\ \\frac{∂f}{∂y}(1,1) & =2(1)(1)+{1}^{2}=3\\end{aligned}\n$$\n\nFinally, we write down the equation of the tangent plane:\n\n$$\n\\begin{aligned}z-2 & =(x-1)\\frac{∂f}{∂x}(1,1)+(y-1)\\frac{∂f}{∂y}(1,1) \\\\ z-2 & =3(x-1)+3(y-1) \\\\ z-2 & =3x+3y-6 \\\\ -3x-3y+z+4 & =0 \\\\ 3x+3y-z-4 & =0\\end{aligned}\n$$" 13194139534550 true] [17592186294789 1000 #edb/ref 17592186294790 13194139534550 true] [17592186294789 1000 #edb/ref 17592186294791 13194139534550 true] [17592186294789 1000 #edb/ref 17592186294792 13194139534550 true] [17592186294789 1000 #edb/ref 17592186294793 13194139534550 true] [17592186294789 1000 #edb/ref 17592186294794 13194139534550 true] [17592186294789 1040 #edb/ref 17592186045450 13194139534550 true] [17592186294789 1041 "selection" 13194139534550 true] [17592186294789 1104 #edb/ref 17592186294792 13194139534550 true] [17592186294789 1110 #uuid "e4621697-46d1-557d-9a6a-4bd45dcd2aa9" 13194139534550 true] [17592186294790 1034 "2x+2y-z-2=0" 13194139534550 true] [17592186294790 1103 #edb/ref 17592186045453 13194139534550 true] [17592186294790 1111 #uuid "0cc2bed5-6f11-52fc-af4f-9d21abdfe62c" 13194139534550 true] [17592186294791 1034 "2x-2y-z+2=0" 13194139534550 true] [17592186294791 1103 #edb/ref 17592186045453 13194139534550 true] [17592186294791 1111 #uuid "d6e815d3-79c7-5424-a671-26cc6f649466" 13194139534550 true] 