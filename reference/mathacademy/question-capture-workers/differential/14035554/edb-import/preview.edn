{1}{6}(x-1)^{3}+⋯\\end{aligned}\n$$" 13194139534550 true] [17592186294776 1000 #edb/ref 17592186294777 13194139534550 true] [17592186294776 1000 #edb/ref 17592186294778 13194139534550 true] [17592186294776 1000 #edb/ref 17592186294779 13194139534550 true] [17592186294776 1000 #edb/ref 17592186294780 13194139534550 true] [17592186294776 1000 #edb/ref 17592186294781 13194139534550 true] [17592186294776 1040 #edb/ref 17592186045450 13194139534550 true] [17592186294776 1041 "selection" 13194139534550 true] [17592186294776 1104 #edb/ref 17592186294778 13194139534550 true] [17592186294776 1110 #uuid "87327c81-0fcb-5aa5-9cae-a3f073a1479f" 13194139534550 true] [17592186294777 1034 "y(x)=-1-\\frac{1}{2}(x-1)^{2}+\\frac{1}{3}(x-1)^{3}+⋯" 13194139534550 true] [17592186294777 1103 #edb/ref 17592186045453 13194139534550 true] [17592186294777 1111 #uuid "37c22a21-5a67-53b8-a167-08077e456093" 13194139534550 true] [17592186294778 1034 "y(x)=-1-\\frac{1}{2}(x-1)^{2}+\\frac{1}{6}(x-1)^{3}+⋯" 13194139534550 true] [17592186294778 1103 #edb/ref 17592186045453 13194139534550 true] [17592186294778 1111 #uuid "0232aaf2-7880-5dae-b00a-375ce5810236" 13194139534550 true] [17592186294779 1034 "y(x)=-1-\\frac{1}{2}(x-1)^{2}+2(x-1)^{3}+⋯" 13194139534550 true] [17592186294779 1103 #edb/ref 17592186045453 13194139534550 true] [17592186294779 1111 #uuid "81cc16aa-22f5-597b-a47e-c7d38f4f98b2" 13194139534550 true] [17592186294780 1034 "y(x)=-1+\\frac{3}{2}(x-1)^{2}-2(x-1)^{3}+⋯" 13194139534550 true] [17592186294780 1103 #edb/ref 17592186045453 13194139534550 true] [17592186294780 1111 #uuid "27784cc3-92df-51fd-b159-60ba7605386d" 13194139534550 true] [17592186294781 1034 "y(x)=-1+\\frac{3}{2}(x-1)^{2}-\\frac{1}{3}(x-1)^{3}+⋯" 13194139534550 true] [17592186294781 1103 #edb/ref 17592186045453 13194139534550 true] [17592186294781 1111 #uuid "06b08205-987a-53d9-b2e3-e8419489fd79" 13194139534550 true] [17592186294782 1000 #edb/ref 17592186294783 13194139534550 true] [17592186294782 1000 #edb/ref 1759218629