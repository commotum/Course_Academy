\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-141281" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{3}\\operatorname{cos}⁡x-\\operatorname{sin}⁡x}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-76209" "field" nil "attribute" "question/problem" "value" "If $\\,A=[\\begin{aligned}\\text{i} & 2-\\text{i} \\\\ 1-2\\text{i} & 2\\end{aligned}]\\,$ and $\\,x=[\\begin{aligned}1+2\\text{i} \\\\ 1-\\text{i}\\end{aligned}]\\,$, then $\\,Ax=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-76209" "field" nil "attribute" "question/worked-solution" "value" "Multiplying the matrix by the vector using the usual method, we get\n\n$$\n\\begin{aligned}Ax & =[\\begin{aligned}\\text{i} & 2-\\text{i} \\\\ 1-2\\text{i} & 2\\end{aligned}]\\cdot [\\begin{aligned}1+2\\text{i} \\\\ 1-\\text{i}\\end{aligned}] \\\\  & =[\\begin{aligned}\\text{i}(1+2\\text{i})+(2-\\text{i})(1-\\text{i}) \\\\ (1-2\\text{i})(1+2\\text{i})+2(1-\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}(\\text{i}-2)+(1-3\\text{i}) \\\\ 5+(2-2\\text{i})\\end{aligned}] \\\\  & =[\\begin{aligned}-1-2\\text{i} \\\\ 7-2\\text{i}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-76209" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/activity-metadata.json" "file_sha256" "d8e941685c2fbed9e57620ad4338bcc7ffd9b578b42c995784607c9dcd16532a" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-76209" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-76209" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-1+2\\text{i} \\\\ 7+2\\text{i}\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6