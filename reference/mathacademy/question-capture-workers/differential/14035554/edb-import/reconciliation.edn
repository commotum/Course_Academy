\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" nil "attribute" "question/problem" "value" "Find the product $AB$, if\n$A=[\\begin{aligned}0 & 1 & 0\\end{aligned}]$\nand \n$B=[\\begin{aligned}\\sqrt{5} & 4 & 1 \\\\ -3 & 2\\sqrt{2} & -3.2 \\\\ 0 & 1 & -\\sqrt{3}\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" nil "attribute" "question/worked-solution" "value" "Notice that $A$ is the $2$nd *row* of the identity matrix ${I}_{3}.$\n\nSince we're multiplying the $3\\times 3$ matrix $B$ by the $2$nd *row* of the identity matrix ${I}_{3}$ on the *left*, the result must be the $2$nd *row* of $B.$ Therefore,\n\n$$\nAB=[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}].\n$$\n\nLet's check the long way:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 & 1 & 0\\end{aligned}][\\begin{aligned}\\sqrt{5} & 4 & 1 \\\\ -3 & 2\\sqrt{2} & -3.2 \\\\ 0 & 1 & -\\sqrt{3}\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/activity-metadata.json" "file_sha256" "d8e941685c2fbed9e57620ad4338bcc7ffd9b578b42c995784607c9dcd16532a" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}0 & 1 & -\\sqrt{3}\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}4 \\\\ 2\\sqrt{2} \\\\ 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}\\sqrt{5} & 4 & 1\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "[\\begin{aligned}\\sqrt{5} \\\\ -3 \\\\ 0\\end{aligned}]"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-41944" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}-3 & 2\\sqrt{2} & -3.2\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-120789" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/assets/8197d1111bbd4c3b8908bc12cbc58561ffd23fe06d9f9fa99f9ab815ed78733f.png)\n\nThe graph shows a portion of the curve $y=\\operatorname{cos}⁡x$ and $y=-\\frac{1}{2}.$ Which of the following generates the $x$-values of all of their points of intersection? Assume that $n$ is an integer." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-120789" "field" nil "attribute" "question/worked-solution" "value" "At the intersection points, the $y$-values are the same for both graphs. This gives the equation $\\operatorname{cos}⁡x=-\\frac{1}{2}.$ \n\nFirst, we find the principal value:\n\n$$\n{x}_{1}=\\operatorname{arccos}⁡(-\\frac{1}{2})=\\frac{2\\pi }{3}\n$$\n\nOur first solution lies in the $2$nd quadrant and has a reference angle of ${\\theta }_{R}=\\frac{\\pi }{3}.$ Since $\\operatorname{cos}⁡x<0,$ the second solution must lie in the third quadrant, and it also has ${\\theta }_{R}=\\frac{\\pi }{3}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/assets/ba34bf96662682ec433c3ade0bf3f118638212101a0729fe95bbae05aee8bf1e.png)\n\nSince the second solution ${x}_{2}$  lies in the $3$rd quadrant, we can find it using the reference angle as follows:\n\n$$\n\\begin{aligned}{x}_{2} & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{3} \\\\  & =\\frac{4\\pi }{3}\\end{aligned}\n$$\n\nHence, the general solution for the given equation is \n\n$$\nx=\\frac{2\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi .\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-120789" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/activity-metadata.json" "file_sha256" "d8e941685c2fbed9e57620ad4338bcc7ffd9b578b42c995784607c9dcd16532a" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-120789" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.json" "file_sha256" "36a375ee6ee6aed3cd4a02d9a41385a1beb1356ae26e4b0633f09eef4476b2e5" "basis" 1237 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/edb-import/verification.json"} {"question" "q-120789" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=\\frac{2\\pi }{3}+2n\\pi ,\\,x=\\frac{4\\pi }{3}+2n\\pi "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14035241/state.j