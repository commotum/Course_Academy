)y(2)+x(3)y(3) \\\\  & =(-1)\\cdot 2+2\\cdot 6+7\\cdot 12 \\\\  & =-2+12+84 \\\\  & =94.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42249/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "efed2bff-625e-556d-99a3-9b51f9d68937"] :knowledge-point/questions ["q-42249"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105668/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "28d7e6ed-54b5-5aa5-a4c8-6f7f98fdecd3" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-105668/selection/d4f9a7f24ccd33aa8f286915c31bed879f85b7366dbcdea87ed7b2e517748a25" :answer/id #uuid "c775e906-d35f-59ca-adb9-303e359d87d1" :answer/type :answer.type/math :answer/value "6z\\,j" :db/ensure [:answer/validate]} {:db/id "q-105668/selection/5f07b1c1a72c7182de8bbae9718bc3a62f2d7a6bd72921b7d8d073ced25ecadd" :answer/id #uuid "5d283f95-54bf-5543-a3e0-0b16ed1817c8" :answer/type :answer.type/math :answer/value "-6z\\,j+2\\,\\text{k}" :db/ensure [:answer/validate]} {:db/id "q-105668/selection/6efefb40df8d6d72de9c8bf5e20151467ac5ff6c92dced2053a9aa94e7f1365c" :answer/id #uuid "3e7270e5-fb82-52ce-8533-fca2f9a580dd" :answer/type :answer.type/math :answer/value "2\\,i" :db/ensure [:answer/validate]} {:db/id "q-105668/selection/fc348115f8a0769e3670152540a70a5f5d7479c55bee995f770252177bba19ea" :answer/id #uuid "f26d3808-820d-5590-9bfd-c4b888b3180b" :answer/type :answer.type/math :answer/value "-6z\\,k" :db/ensure [:answer/validate]} {:db/id "q-105668/selection" :answer-field/id #uuid "a1b48c20-cda5-5a3d-88b9-877ca4dcbec0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105668/selection/d4f9a7f24ccd33aa8f286915c31bed879f85b7366dbcdea87ed7b2e517748a25" :answer-field/choices ["q-105668/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-105668/selection/d4f9a7f24ccd33aa8f286915c31bed879f85b7366dbcdea87ed7b2e517748a25" "q-105668/selection/5f07b1c1a72c7182de8bbae9718bc3a62f2d7a6bd72921b7d8d073ced25ecadd" "q-105668/selection/6efefb40df8d6d72de9c8bf5e20151467ac5ff6c92dced2053a9aa94e7f1365c" "q-105668/selection/fc348115f8a0769e3670152540a70a5f5d7479c55bee995f770252177bba19ea"] :db/ensure [:answer-field/validate]} {:db/id "q-105668" :question/id #uuid "bb2dffd2-9038-550e-ac80-acf29b387b94" :question/math-academy-id "q-105668" :question/problem "Given that $F(x,y,z)=3{z}^{2}\\,i+2y\\,j+k,$ what is $\\text{curl}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ 3{z}^{2} & 2y & 1\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}(1)-\\frac{∂}{∂z}(2y)]i-[\\frac{∂}{∂x}(1)-\\frac{∂}{∂z}(3{z}^{2})]j+[\\frac{∂}{∂x}(2y)-\\frac{∂}{∂y}(3{z}^{2})]k \\\\  & =(0-0)i-(0-6z)j+(0-0)k \\\\  & =6z\\,j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105668/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593"] :knowledge-point/questions ["q-105668"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345281/selection/bb3267a86845864baf956adb09573e6bc560cdc77b9246f11c6b586beb2f38e6" :answer/id #uuid "b50657bf-178f-5cc9-9895-91c3fbcee1b4" :answer/type :answer.type/math :answer/value "y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+3/4}" :db/ensure [:answer/validate]} {:db/id "q-345281/selection/a37875ad10da204984eed04510a252cc4c4128dcac40d5773a22cef45623fe79" :answer/id #uuid "8dfc6306-9f63-5860-aab3-fe71326b28b5" :answer/type :answer.type/math :answer/value "y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n-1/8}" :db/ensure [:answer/validate]} {:db/id "q-345281/selection/4a0902bce002e70c766eaf1c48ee6d3f287c1e3f4b85936b7ca306286aaf107a" :answer/id #uuid "1cbcce0e-1454-5d89-9350-b17436e034d4" :answer/type :answer.type/math :answer/value "y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n-3/4}" :db/ensure [:answer/validate]} {:db/id "q-345281/selection/d6b28a9e054df424ae18885871bb9cbdf14dfc2fd013a5657195a6720c792ace" :answer/id #uuid "6bb9c97c-09f1-5af2-b11a-05d43c6dc34b" :answer/type :answer.type/math :answer/value "y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1/4}" :db/ensure [:answer/validate]} {:db/id "q-345281/selection/8c5dbfb2b6925f1b1f5016c7c3c1d682de352150e6ca68aa3b010735e2af77ce" :answer/id #uuid "4c588564-4afe-5a5d-9f80-ea7d37b59d0f" :answer/type :answer.type/math :answer/value "y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1/2}" :db/ensure [:answer/validate]} {:db/id "q-345281/selection" :answer-field/id #uuid "ff76c0e3-6a2d-5899-9b89-f3e5c6c7a034" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-345281/selection/bb3267a86845864baf956adb09573e6bc560cdc77b9246f11c6b586beb2f38e6" :answer-field/choices ["q-345281/selection/bb3267a86845864baf956adb09573e6bc560cdc77b9246f11c6b586beb2f38e6" "q-345281/selection/a37875ad10da204984eed04510a252cc4c4128dcac40d5773a22cef45623fe79" "q-345281/selection/4a0902bce002e70c766eaf1c48ee6d3f287c1e3f4b85936b7ca306286aaf107a" "q-345281/selection/d6b28a9e054df424ae18885871bb9cbdf14dfc2fd013a5657195a6720c792ace" "q-345281/selection/8c5dbfb2b6925f1b1f5016c7c3c1d682de352150e6ca68aa3b010735e2af77ce"] :db/ensure [:answer-field/validate]} {:db/id "q-345281" :question/id #uuid "65e9e479-9d60-5680-98f9-c749980f26f5" :question/math-academy-id "q-345281" :question/problem "Consider the following differential equation.\n\n$$\n8{x}^{2}{y}^{″}+6x{y}^{′}+(8x-3)y=0\n$$\n\nWhich of the following is a Frobenius series solution to the differential equation, where ${a}_{n}$ for $n=0,1,2,…$ are constants determined by substitution?\n\n*Hint: Substituting a trial Frobenius series solution into each term of the ODE, we obtain*\n\n$$\n\\begin{aligned}8{x}^{2}{y}^{″} & =8({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }8((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ 6x{y}^{′} & =6\\lambda {a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }6(\\lambda +n){a}_{n}{x}^{\\lambda +n}, \\\\ (8x-3)y & =-3{a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }(8{a}_{n-1}-3{a}_{n}){x}^{\\lambda +n}.\\end{aligned}\n$$" :question/worked-solution "If $x=0$ is a regular singular point of a second-order homogeneous linear differential equation, then the method of Frobenius states that there is at least one solution of the form\n\n$$\ny={x}^{\\lambda }{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n},\n$$\n\nwhere $\\lambda $ and ${a}_{n}$ for $n=0,1,2,…$ are constants.\n\nSubstituting this solution and its derivatives into the ODE, collecting like terms, and setting coefficients equal to zero, we obtain:\n\n- the indicial equation from the coefficients of the $n=0$ term for arbitrary ${a}_{0},$ and\n\n- a recurrence formula from the coefficients of the $n\\ge 1$ terms.\n\nWe are given the three terms of the ODE as power series with the $n=0$ term isolated in each.\n\n$$\n\\begin{aligned}8{x}^{2}{y}^{″} & =8({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }8((\\lambda +n)^{2}-(\\lambda +n)){a}_{n}{x}^{\\lambda +n}, \\\\ 6x{y}^{′} & =6\\lambda {a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }6(\\lambda +n){a}_{n}{x}^{\\lambda +n} \\\\ (8x-3)y & =-3{a}_{0}{x}^{\\lambda }+{\\sum }_{n=1}^{\\infty }(8{a}_{n-1}-3{a}_{n}){x}^{\\lambda +n}.\\end{aligned}\n$$\n\nNow, we continue from this point.\n\n**Step 1**: Consolidate all the series into a single series that is equal to $0.$\n\nCollecting the terms for $n=0,$ we have\n\n$$\n\\begin{aligned}8({\\lambda }^{2}-\\lambda ){a}_{0}{x}^{\\lambda }+6\\lambda {a}_{0}{x}^{\\lambda }-3{a}_{0}{x}^{\\lambda } & = \\\\ (8{\\lambda }^{2}-8\\lambda +6\\lambda -3){a}_{0}{x}^{\\lambda } & = \\\\ (8{\\lambda }^{2}-2\\lambda -3){a}_{0}{x}^{\\lambda } & .\\end{aligned}\n$$\n\nSimilarly, collecting terms for $n\\ge 1,$ we obtain an infinite series of the form\n${x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n},$\nfor some ${b}_{n}(\\lambda ),$ $n\\ge 1.$\nTherefore, substituting into the homogeneous ODE, we have\n\n$$\n\\begin{aligned}(8{\\lambda }^{2}-2\\lambda -3){a}_{0}{x}^{\\lambda }+{x}^{\\lambda }{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0 \\\\ (8{\\lambda }^{2}-2\\lambda -3){a}_{0}+{\\sum }_{n=1}^{\\infty }{b}_{n}(\\lambda ){x}^{n} & =0.\\end{aligned}\n$$\n\n**Step 2**:  Set the coefficients of the series equal to $0.$\n\nSetting the coefficient of the $n=0$ term equal to $0$ with arbitrary ${a}_{0}\\ne 0,$ we obtain the indicial equation:\n\n$$\n\\begin{aligned}(8{\\lambda }^{2}-2\\lambda -3){a}_{0} & =0 \\\\ 8{\\lambda }^{2}-2\\lambda -3 & =0\\end{aligned}\n$$\n\nNow, we can determine a solution. Solving the indicial equation for the roots, we get\n\n$$\n\\begin{aligned}8{\\lambda }^{2}-2\\lambda -3 & =0 \\\\ (4\\lambda -3)(2\\lambda +1) & =0 \\\\ \\lambda  & =-\\frac{1}{2},\\frac{3}{4}\\end{aligned}\n$$\n\nTherefore, the two Frobenius series solutions are\n\n$$\n\\begin{aligned}y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n-1/2}\\,\\text{and}\\,y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+3/4},\\end{aligned}\n$$\n\nwhere the constants ${a}_{n}$ are to be determined separately in each of the two cases.\n\nOf the given options, the correct answer is\n$y(x)={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+3/4}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-345281/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "12a5d6ee-cc3b-5473-8cfc-0ccecd631449"] :knowledge-point/questions ["q-345281"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343061/field-1/8c78feef909882b710096de4171fd3c5aec81f7c3b1b7e8387eb4681b7a12922" :answer/id #uuid "3173edb5-e11f-5376-b320-95858e990a08" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}+s+6}{(s+3)({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-1/5b20070fc0a91c73c8adb7f7e39e1f1a6d911386b8584e08b2533175659887eb" :answer/id #uuid "42a3de76-9369-5abb-951f-26bc0746a254" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}+6}{(s+3)({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-1/5b7ba541e88de65b0fe88e3e51d89d58522daa98f1984d1adb6002145f1eb480" :answer/id #uuid "ddb6ab72-1a9b-5de5-ac36-51dc7d88950c" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}+s+5}{(s+3)({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-1/8a448ba6f692410604b2c487927a9ac480b7a943de0617f6c21df0c9563fc592" :answer/id #uuid "2fb0ac16-9076-53b9-b4b3-f5e100237fca" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}-s+6}{(s+3)({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-1/75954eaa2f4c66767133519bf9b80139a7127e29e7619f2b6a9e5136a34f41bf" :answer/id #uuid "c3a419df-9965-5794-8f7f-f096b9266986" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}+s+4}{(s+3)({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-1" :answer-field/id #uuid "fb8368e9-bcb9-576b-a165-e904b0789fc7" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-343061/field-1/8c78feef909882b710096de4171fd3c5aec81f7c3b1b7e8387eb4681b7a12922" :answer-field/choices ["q-343061/field-1/8c78feef909882b710096de4171fd3c5aec81f7c3b1b7e8387eb4681b7a12922" "q-343061/field-1/5b20070fc0a91c73c8adb7f7e39e1f1a6d911386b8584e08b2533175659887eb" "q-343061/field-1/5b7ba541e88de65b0fe88e3e51d89d58522daa98f1984d1adb6002145f1eb480" "q-343061/field-1/8a448ba6f692410604b2c487927a9ac480b7a943de0617f6c21df0c9563fc592" "q-343061/field-1/75954eaa2f4c66767133519bf9b80139a7127e29e7619f2b6a9e5136a34f41bf"] :db/ensure [:answer-field/validate]} {:db/id "q-343061/field-2/ee8a789a733dd1ef070356fa4c501c98b757bb9f1d247cede0e66456d64f3ac8" :answer/id #uuid "8387658e-d429-5075-8d85-00953edf5b87" :answer/type :answer.type/math :answer/value "\\frac{12}{13(s+3)}+\\frac{s-10}{13({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-2/0d6bc7144a1305ffaaf90678ada2637f1de6e4ce789d3b003f233ab6553af8fa" :answer/id #uuid "206865c9-24bd-5c4a-b299-097cca4ce8d1" :answer/type :answer.type/math :answer/value "\\frac{12}{13(s+3)}-\\frac{s+10}{13({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-2/619fc5742a2aae4f00cc88c14e05de08aa7fea97f6c2bc4c0917d9dcbd9c0665" :answer/id #uuid "d446d6ca-d93a-5744-9121-f3aed8a39324" :answer/type :answer.type/math :answer/value "\\frac{1}{s+3}+\\frac{s}{{s}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-2/ae569f4f29973cd9d6611c8dfe3b1a8f82c1d4e1b34c163898004deef4023646" :answer/id #uuid "90aadfe7-b322-5254-a32a-d5c2bc6268e2" :answer/type :answer.type/math :answer/value "\\frac{12}{13(s+3)}+\\frac{s+10}{13({s}^{2}+4)}" :db/ensure [:answer/validate]} {:db/id "q-343061/field-2" :answer-field/id #uuid "96584e19-8e9b-5fe9-89e6-f721d9c74a19" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-343061/field-2/ae569f4f29973cd9d6611c8dfe3b1a8f82c1d4e1b34c163898004deef4023646" :answer-field/choices ["q-343061/field-2/ee8a789a733dd1ef070356fa4c501c98b757bb9f1d247cede0e66456d64f3ac8" "q-343061/field-2/0d6bc7144a1305ffaaf90678ada2637f1de6e4ce789d3b003f233ab6553af8fa" "q-343061/field-2/619fc5742a2aae4f00cc88c14e05de08aa7fea97f6c2bc4c0917d9dcbd9c0665" "q-343061/field-2/ae569f4f29973cd9d6611c8dfe3b1a8f82c1d4e1b34c163898004deef4023646"] :db/ensure [:answer-field/validate]} {:db/id "q-343061/field-3/459c3d11995f02f1132dfb59570e40228509728b979734449c67999405df56eb" :answer/id #uuid "9bfcb067-8dd4-5ef2-8b2c-67fe661cec41" :answer/type :answer.type/math :answer/value "\\frac{12}{13}{e}^{-3t}+\\frac{1}{13}\\operatorname{sin}⁡2t+\\frac{5}{13}\\operatorname{cos}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-343061/field-3/b87356ce5b431941b893f5cccfc8ce469b1f0c78a06e2300a1cd2cfa09c95a87" :answer/id #uuid "9b72c5e3-6b29-597a-9c43-d49671290a20" :answer/type :answer.type/math :answer/value "\\frac{12}{13}{e}^{-3t}+\\frac{5}{13}\\operatorname{sin}⁡2t+\\frac{1}{13}\\operatorname{cos}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-343061/field-3/0ce891ba1e7b65fa23bad5b95d18f990108c5ad67a2b66b80071ba30dc57cc7e" :answer/id #uuid "0657ba37-c00f-5e17-8b21-d41e58293590" :answer/type :answer.type/math :answer/value "\\frac{12}{13}{e}^{-3t}+\\frac{5}{13}\\operatorname{sin}⁡2t-\\frac{1}{13}\\operatorname{cos}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-343061/field-3/939739d604b26abbef6ff9dcc775c22a22ede8c25a8814084d78a7a27a4819a6" :answer/id #uuid "f0e15a90-4603-5777-a1be-f5bd679c0f07" :answer/type :answer.type/math :answer/value "\\frac{12}{13}{e}^{-3t}-\\frac{5}{13}\\operatorname{sin}⁡2t+\\frac{1}{13}\\operatorname{cos}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-343061/field-3" :answer-field/id #uuid "3002c4a7-5e48-5f80-a73c-741520232a77" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-343061/field-3/b87356ce5b431941b893f5cccfc8ce469b1f0c78a06e2300a1cd2cfa09c95a87" :answer-field/choices ["q-343061/field-3/459c3d11995f02f1132dfb59570e40228509728b979734449c67999405df56eb" "q-343061/field-3/b87356ce5b431941b893f5cccfc8ce469b1f0c78a06e2300a1cd2cfa09c95a87" "q-343061/field-3/0ce891ba1e7b65fa23bad5b95d18f990108c5ad67a2b66b80071ba30dc57cc7e" "q-343061/field-3/939739d604b26abbef6ff9dcc775c22a22ede8c25a8814084d78a7a27a4819a6"] :db/ensure [:answer-field/validate]} {:db/id "q-343061" :question/id #uuid "5716f5b5-2e23-5cd2-a381-388287b59e4d" :question/math-academy-id "q-343061" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+3y=\\operatorname{sin}⁡2t+\\operatorname{cos}⁡2t,\\,y(0)=1\n$$\n\nSelect the correct options in the reasoning below to find the solution using Laplace transforms. You may make use of the following results:\n\n$$\nL{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\,s>0.\n$$\n\nLet $Y(s)=L{y(t)}.$ Taking the Laplace transform of both sides of the equation and solving for $Y,$ we have\n\n$$\n\\frac{{s}^{2}+s+6}{(s+3)({s}^{2}+4)}\n$$\n\nThe partial fraction decomposition of $Y$ is\n\n$$\n\\frac{12}{13(s+3)}+\\frac{s-10}{13({s}^{2}+4)}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\frac{12}{13}{e}^{-3t}+\\frac{1}{13}\\operatorname{sin}⁡2t+\\frac{5}{13}\\operatorname{cos}⁡2t\n$$" :question/worked-solution "First, we take the Laplace transform of both sides of the differential equation. Using the linearity property, we have\n\n$$\nL{{y}^{′}}+3L{y}=L{\\operatorname{sin}⁡2t}+L{\\operatorname{cos}⁡2t}.\n$$\n\nUsing the formula for the transform of a derivative $L{{y}^{′}}=sY(s)-y(0)$ and the standard trigonometric transforms\n\n$$\nL{\\operatorname{sin}⁡2t}=\\frac{2}{{s}^{2}+4},\\,L{\\operatorname{cos}⁡2t}=\\frac{s}{{s}^{2}+4},\n$$\n\nwe substitute the known values. Note that $y(0)=1:$\n\n$$\n\\begin{aligned}(sY(s)-1)+3Y(s) & =\\frac{2}{{s}^{2}+4}+\\frac{s}{{s}^{2}+4} \\\\ (s+3)Y(s)-1 & =\\frac{s+2}{{s}^{2}+4}\\end{aligned}\n$$\n\nWe rearrange to solve for $Y(s).$ First, add $1$ to the right-hand side and find a common denominator:\n\n$$\n\\begin{aligned}(s+3)Y(s) & =1+\\frac{s+2}{{s}^{2}+4} \\\\ (s+3)Y(s) & =\\frac{{s}^{2}+4}{{s}^{2}+4}+\\frac{s+2}{{s}^{2}+4} \\\\ (s+3)Y(s) & =\\frac{{s}^{2}+s+6}{{s}^{2}+4}\\end{aligned}\n$$\n\nDividing by $(s+3),$ we obtain\n\n$$\nY(s)=\\frac{{s}^{2}+s+6}{(s+3)({s}^{2}+4)}.\n$$\n\nNext, we perform a partial fraction decomposition. Since the denominator has a linear factor $(s+3)$ and an irreducible quadratic factor $({s}^{2}+4),$ we write\n\n$$\n\\frac{{s}^{2}+s+6}{(s+3)({s}^{2}+4)}=\\frac{A}{s+3}+\\frac{Bs+C}{{s}^{2}+4}.\n$$\n\nTo find the constants, we clear the denominators:\n\n$$\n{s}^{2}+s+6=A({s}^{2}+4)+(Bs+C)(s+3)\n$$\n\n- Setting $s=-3,$ we have\n \n\n$$\n(-3)^{2}+(-3)+6=A((-3)^{2}+4)+0\\,⟹\\,12=13A\\,⟹\\,A=\\frac{12}{13}.\n$$\n\n- Comparing the coefficients of ${s}^{2},$ we have\n  \n\n$$\n1=A+B\\,⟹\\,1=\\frac{12}{13}+B\\,⟹\\,B=\\frac{1}{13}.\n$$\n\n- Comparing the constant terms, we have\n \n\n$$\n6=4A+3C\\,⟹\\,6=4(\\frac{12}{13})+3C\\,⟹\\,C=\\frac{10}{13}.\n$$\n\nThus, the decomposition is\n\n$$\nY(s)=\\frac{(\\frac{12}{13})}{13(s+3)}+\\frac{(\\frac{1}{13}s+\\frac{10}{13})}{{s}^{2}+4}=\\frac{12}{13(s+3)}+\\frac{s+10}{13({s}^{2}+4)}.\n$$\n\nFrom the table of Laplace transforms, we have:\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s+3}} & ={e}^{-3t} \\\\ {L}^{-1}{\\frac{s}{{s}^{2}+4}} & =\\operatorname{cos}⁡2t \\\\ {L}^{-1}{\\frac{2}{{s}^{2}+4}} & =\\operatorname{sin}⁡2t\\end{aligned}\n$$\n\nFinally, taking the inverse Laplace transform of $Y(s),$ we get\n\n$$\n\\begin{aligned}y(t) & =\\frac{12}{13}{L}^{-1}{\\frac{1}{s+3}}+\\frac{1}{13}{L}^{-1}{\\frac{s}{{s}^{2}+4}}+\\frac{5}{13}{L}^{-1}{\\frac{2}{{s}^{2}+4}} \\\\ y(t) & =\\frac{12}{13}{e}^{-3t}+\\frac{5}{13}\\operatorname{sin}⁡2t+\\frac{1}{13}\\operatorname{cos}⁡2t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-343061/field-1" "q-343061/field-2" "q-343061/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "06fedec8-5aed-52f9-bd4f-aa81b9180ad4"] :knowledge-point/questions ["q-343061"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64564/selection/bbcb8969ce669cd19ebb759a79c487dd6b047a46446ca76c146c25957ebe7a37" :answer/id #uuid "27784cc3-92df-51fd-b159-60ba7605386d" :answer/type :answer.type/math :answer/value "y(x)=-1+\\frac{3}{2}(x-1)^{2}-2(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-64564/selection/ea668c33692beec7384c52c426445ecdd1aa67dcecf6c0e8e85f427252a2f409" :answer/id #uuid "06b08205-987a-53d9-b2e3-e8419489fd79" :answer/type :answer.type/math :answer/value "y(x)=-1+\\frac{3}{2}(x-1)^{2}-\\frac{1}{3}(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-64564/selection/91ecc060e68f4b46de96cf852c1a38dda79e4fee0ade04382839dff8d8996d88" :answer/id #uuid "81cc16aa-22f5-597b-a47e-c7d38f4f98b2" :answer/type :answer.type/math :answer/value "y(x)=-1-\\frac{1}{2}(x-1)^{2}+2(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-64564/selection/3ca0c1403901f97ca2e5ec254a3320ef2f6d86e84342882d673a29ec269a1a34" :answer/id #uuid "37c22a21-5a67-53b8-a167-08077e456093" :answer/type :answer.type/math :answer/value "y(x)=-1-\\frac{1}{2}(x-1)^{2}+\\frac{1}{3}(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-64564/selection/7fc6c622139db96d53aa6bd1f37f3f8177edfc8d496f886654f797246944fb9b" :answer/id #uuid "0232aaf2-7880-5dae-b00a-375ce5810236" :answer/type :answer.type/math :answer/value "y(x)=-1-\\frac{1}{2}(x-1)^{2}+\\frac{1}{6}(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-64564/selection" :answer-field/id #uuid "87327c81-0fcb-5aa5-9cae-a3f073a1479f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64564/selection/7fc6c622139db96d53aa6bd1f37f3f8177edfc8d496f886654f797246944fb9b" :answer-field/choices ["q-64564/selection/bbcb8969ce669cd19ebb759a79c487dd6b047a46446ca76c146c25957ebe7a37" "q-64564/selection/ea668c33692beec7384c52c426445ecdd1aa67dcecf6c0e8e85f427252a2f409" "q-64564/selection/91ecc060e68f4b46de96cf852c1a38dda79e4fee0ade04382839dff8d8996d88" "q-64564/selection/3ca0c1403901f97ca2e5ec254a3320ef2f6d86e84342882d673a29ec269a1a34" "q-64564/selection/7fc6c622139db96d53aa6bd1f37f3f8177edfc8d496f886654f797246944fb9b"] :db/ensure [:answer-field/validate]} {:db/id "q-64564" :question/id #uuid "9b925fd6-63c4-512c-989c-41491a7f83b1" :question/math-academy-id "q-64564" :question/problem "Use the Taylor series method to find a series solution about $x=1$, in ascending powers of $(x-1)$ up to and including the term in $(x-1)^{3},$  of the initial value problem\n\n$$\n{y}^{″}=y{e}^{1-x},\\,y(1)=-1,\\,{y}^{′}(1)=0.\n$$" :question/worked-solution "We wish to express $y(x)$ as a Taylor series about $x=1$:\n\n$$\ny(x)=y(1)+(x-1){y}^{′}(1)+\\frac{(x-1)^{2}}{2!}{y}^{″}(1)+\\frac{(x-1)^{3}}{3!}{y}^{(3)}(1)+⋯\n$$\n\nWe're given $y(1)$ and ${y}^{′}(1),$ so we need to calculate ${y}^{″}(1)$ and ${y}^{(3)}(1).$\n\nWe substitute $y(1)=-1$ and ${y}^{′}(1)=0$ into the given equation to find ${y}^{″}(1):$\n\n$$\n\\begin{aligned}{y}^{″}(1) & =y(1){e}^{1-1} \\\\  & =(-1){e}^{0} \\\\  & =-1\\end{aligned}\n$$\n\nNext, to find an expression for ${y}^{(3)}(x),$ we differentiate both sides on the given equation with respect to $x:$ \n\n$$\n{y}^{(3)}(x)={y}^{′}{e}^{1-x}-y{e}^{1-x}\n$$\n\nWe can now find  ${y}^{(3)}(1)$ by substituting in the known values:\n\n$$\n\\begin{aligned}{y}^{(3)}(1) & ={y}^{′}(1){e}^{1-1}-y(1){e}^{1-1} \\\\  & =(0\\cdot {e}^{0})-(-1\\cdot {e}^{0}) \\\\  & =0+1 \\\\  & =1\\end{aligned}\n$$\n\nFinally, we  substitute  the obtained values in  the Taylor series:\n\n$$\n\\begin{aligned}y(x) & =y(1)+(x-1){y}^{′}(1)+\\frac{(x-1)^{2}}{2!}{y}^{″}(1)+\\frac{(x-1)^{3}}{3!}{y}^{(3)}(1)+⋯ \\\\  & =-1+(x-1)\\cdot 0+\\frac{(x-1)^{2}}{2}\\cdot (-1)+\\frac{(x-1)^{3}}{6}\\cdot 1+… \\\\  & =-1-\\frac{1}{2}(x-1)^{2}+\\frac{1}{6}(x-1)^{3}+⋯\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64564/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7aa5350-6bfc-5057-ad4a-3bd97a31da5e"] :knowledge-point/questions ["q-64564"] :db/ensure [:knowledge-point/validate]} {:db/id "q-112252/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "fb0f1c49-d752-53e4-99da-257de78e6d9e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-112252/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "780008b7-4262-5c2b-8907-e55c7e080134" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-112252/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "51d15693-4da4-5be8-8a82-15ed0cb1c2b7" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-112252/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "b42846b3-8857-5ac1-90a4-c71828a6257f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-112252/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "dd30fd1b-e3dd-5a7a-b271-ecd122804ec3" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-112252/selection" :answer-field/id #uuid "a60d3865-87cf-5dc9-9908-b7a238940560" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-112252/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-112252/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-112252/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-112252/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-112252/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-112252/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-112252" :question/id #uuid "bfeef447-2f4a-59d5-bfbe-61062af1db4b" :question/math-academy-id "q-112252" :question/problem "$$\nA=[\\begin{aligned}3 & 1 & 1 \\\\ 2 & 6 & -2 \\\\ -1 & 1 & 5\\end{aligned}],\\,v=[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\n$$\n\nConsider the matrix $A$ and vector $v$ shown above. Which of the following statements are true?\n\n- $v$ is an eigenvector corresponding to the eigenvalue $\\lambda =4$ of $A$\n- $v$ is a generalized eigenvector of rank $3$ corresponding to the eigenvalue $\\lambda =4$ of $A$\n- $v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =4$ of $A$" :question/worked-solution "A *generalized eigenvector* ${v}_{n}$ of rank $n$ corresponding to the eigenvalue $\\lambda $ of a matrix $A$ is a nonzero vector such that\n\n$$\n{v}_{n}\\overset{A-\\lambda I\\,}{\\to }{v}_{n-1}\\overset{A-\\lambda I\\,}{\\to }…\\overset{A-\\lambda I\\,}{\\to }{v}_{1}\\overset{A-\\lambda I\\,}{\\to }0,\n$$\n\nwhere ${v}_{n-1},{v}_{n-2},…,{v}_{1}\\ne 0.$ An *eigenvector* is simply a generalized eigenvector of rank $1.$\n\nFirst, we compute $A-4I:$\n\n$$\nA-4I=[\\begin{aligned}3 & 1 & 1 \\\\ 2 & 6 & -2 \\\\ -1 & 1 & 5\\end{aligned}]-4[\\begin{aligned}1 & 0 & 0 \\\\ 0 & 1 & 0 \\\\ 0 & 0 & 1\\end{aligned}]=[\\begin{aligned}-1 & 1 & 1 \\\\ 2 & 2 & -2 \\\\ -1 & 1 & 1\\end{aligned}]\n$$\n\n- Next, we find the image of $v$ under the action of $A-4I:$\n\n$$\n(A-4I)v=[\\begin{aligned}-1 & 1 & 1 \\\\ 2 & 2 & -2 \\\\ -1 & 1 & 1\\end{aligned}][\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]={{[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\ne 0\n$$\n\n- Since we got a nonzero vector in the last step, we now compute the image of $w$ under the action of $A-4I:$\n\n$$\n(A-4I)w=[\\begin{aligned}-1 & 1 & 1 \\\\ 2 & 2 & -2 \\\\ -1 & 1 & 1\\end{aligned}][\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}]=[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]=0\n$$\n\nSo, we obtain the following chain of maps:\n\n$$\n{{[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]}_{⏟}}_{v}\\overset{A-4I\\,}{\\to }{{[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}]}_{⏟}}_{w}\\overset{A-4I\\,}{\\to }{{[\\begin{aligned}0 \\\\ 0 \\\\ 0\\end{aligned}]}_{⏟}}_{0}\n$$\n\nHere, we see that $A-4I$ maps $v$ to $0$ in $2$ steps.\n\nTherefore:\n\n$\\,$ *$v$ is a generalized eigenvector of rank $2$ corresponding to the eigenvalue $\\lambda =4$ of $A.$*\n\nSo, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-112252/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76e60bc4-ae61-5c39-ad80-14e0cdab14da"] :knowledge-point/questions ["q-112252"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130028/selection/86e9cbfa58c191550ac0b6111279607aff2bce6c71d644e1cb4f25f615f51ffb" :answer/id #uuid "a15a1460-52f7-5c3f-b701-5b6c73be739f" :answer/type :answer.type/math :answer/value "y=At+Bt\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-130028/selection/c9aa454ac8a280ad7cc531305beaa3cbc6f341e4afa0b5a80a1b8cdfe59235b8" :answer/id #uuid "e8978f56-c025-53fa-81ac-cc7fde2e58ba" :answer/type :answer.type/math :answer/value "y=At+B{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-130028/selection/fe30a0b42c7e3eebad2e4190d52d450fcea24880d3c3918a4a4e16d3b64901f6" :answer/id #uuid "aa7bed6a-a68e-5f67-b408-d28b14e41d23" :answer/type :answer.type/math :answer/value "y=At+\\frac{B}{t}" :db/ensure [:answer/validate]} {:db/id "q-130028/selection/a5e4a8f170461240096b4c57d13c726ff26f55202a4956dad2fbffe23650b2a1" :answer/id #uuid "70347255-560b-5f37-b361-1bcb445e7cc8" :answer/type :answer.type/math :answer/value "y=At+B{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-130028/selection/e8a9603cdadfa99fd984608a1ca22676ee60fda4bde3c63af1434e00aa57973c" :answer/id #uuid "f3968577-34f4-5ff6-bbcd-0900aaee61a3" :answer/type :answer.type/math :answer/value "y=At+\\frac{B}{{t}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-130028/selection" :answer-field/id #uuid "976562f6-d0ed-5662-9721-26a47e2feeed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130028/selection/e8a9603cdadfa99fd984608a1ca22676ee60fda4bde3c63af1434e00aa57973c" :answer-field/choices ["q-130028/selection/86e9cbfa58c191550ac0b6111279607aff2bce6c71d644e1cb4f25f615f51ffb" "q-130028/selection/c9aa454ac8a280ad7cc531305beaa3cbc6f341e4afa0b5a80a1b8cdfe59235b8" "q-130028/selection/fe30a0b42c7e3eebad2e4190d52d450fcea24880d3c3918a4a4e16d3b64901f6" "q-130028/selection/a5e4a8f170461240096b4c57d13c726ff26f55202a4956dad2fbffe23650b2a1" "q-130028/selection/e8a9603cdadfa99fd984608a1ca22676ee60fda4bde3c63af1434e00aa57973c"] :db/ensure [:answer-field/validate]} {:db/id "q-130028" :question/id #uuid "f1042b05-8c5c-50c6-a46b-43d40627651c" :question/math-academy-id "q-130028" :question/problem "Given that ${y}_{1}(t)=t$ is a solution to the equation ${t}^{2}{y}^{″}+2t{y}^{′}-2y=0$ for $t>0,$ use reduction of order to find a second solution ${y}_{2}(t)$ to the equation, and write down the general solution." :question/worked-solution "According to the reduction of order method, we let ${y}_{2}=u(t)t.$ \n\nDifferentiating the above with respect to $t$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}t+u \\\\ {y}_{2}^{″} & ={u}^{″}t+2{u}^{′}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}({u}^{″}t+2{u}^{′})+2t({u}^{′}t+u)-2ut & =0 \\\\ {u}^{″}{t}^{3}+2{u}^{′}{t}^{2}+2{u}^{′}{t}^{2}+2ut-2ut & =0 \\\\ {u}^{″}{t}^{3}+4{u}^{′}{t}^{2} & =0 \\\\ {t}^{2}({u}^{″}t+4{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince $t>0,$ we must have\n\n$$\n{u}^{″}t+4{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n{w}^{′}t+4w=0.\n$$\n\nThe solution is\n\n$$\nw=\\frac{{c}_{1}}{{t}^{4}}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}=\\frac{{c}_{1}}{{t}^{4}}\\,⟹\\,u=-\\frac{{c}_{1}}{3{t}^{3}}+{c}_{2}.\n$$\n\nTherefore, our expression for ${y}_{2}(t)=ut$ becomes\n\n$$\n{y}_{2}(t)=(-\\frac{{c}_{1}}{3{t}^{3}}+{c}_{2})t.\n$$\n\nSetting ${c}_{1}=-3$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(t)=\\frac{1}{{t}^{3}}\\cdot t=\\frac{1}{{t}^{2}}.\n$$\n\nFinally, because $W({y}_{1},{y}_{2})=-\\frac{3}{{t}^{2}}\\ne 0,$ we know that ${y}_{1}$ and ${y}_{2}$ are independent (you should verify this calculation yourself).\n\nTherefore, the general solution is\n\n$$\ny=At+\\frac{B}{{t}^{2}}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130028/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ef8a6ef-3e77-5e3e-ac75-c3dece0af96e"] :knowledge-point/questions ["q-130028"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331263/selection/0740002e6dd32be292369d2073cdb3b10001f09e62fab6969da323795777f30f" :answer/id #uuid "c6fe95c1-d553-5b34-8f36-da65baaf654b" :answer/type :answer.type/math :answer/value "u(2-t)" :db/ensure [:answer/validate]} {:db/id "q-331263/selection/a75ec584caab4f91a0157b3c7dafab6e35036d801c110f7d6e7353315f7408c1" :answer/id #uuid "a79e0c5b-de9f-53eb-8b18-c83d3b59c1f4" :answer/type :answer.type/math :answer/value "2u(t-2)" :db/ensure [:answer/validate]} {:db/id "q-331263/selection/cfed2861e58b14bd32791afe9b695f6e171131d07ad8f792380dafa1ca75782d" :answer/id #uuid "749b99ba-8968-5374-85dd-cbed1b1e9f91" :answer/type :answer.type/math :answer/value "2u(2-t)+1" :db/ensure [:answer/validate]} {:db/id "q-331263/selection/9884b3d4561f984b9f74d4dfbc46d638d6d0d2526a39089343db9a03d7b278d1" :answer/id #uuid "9fa3bb70-d273-5e43-ac34-cd953118bf2f" :answer/type :answer.type/math :answer/value "2u(2-t)" :db/ensure [:answer/validate]} {:db/id "q-331263/selection/61f94b67bc91750d7c00b039f3d84e88f5916c7df06f013dee4301afe2d44620" :answer/id #uuid "fb2953aa-0138-5f3e-830b-aebdd9565b1f" :answer/type :answer.type/math :answer/value "2u(-2-t)" :db/ensure [:answer/validate]} {:db/id "q-331263/selection" :answer-field/id #uuid "894f6516-6630-5a0b-ad6a-d1eb445a7a2b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-331263/selection/9884b3d4561f984b9f74d4dfbc46d638d6d0d2526a39089343db9a03d7b278d1" :answer-field/choices ["q-331263/selection/0740002e6dd32be292369d2073cdb3b10001f09e62fab6969da323795777f30f" "q-331263/selection/a75ec584caab4f91a0157b3c7dafab6e35036d801c110f7d6e7353315f7408c1" "q-331263/selection/cfed2861e58b14bd32791afe9b695f6e171131d07ad8f792380dafa1ca75782d" "q-331263/selection/9884b3d4561f984b9f74d4dfbc46d638d6d0d2526a39089343db9a03d7b278d1" "q-331263/selection/61f94b67bc91750d7c00b039f3d84e88f5916c7df06f013dee4301afe2d44620"] :db/ensure [:answer-field/validate]} {:db/id "q-331263" :question/id #uuid "bd84d2d8-6305-5ac3-8cd6-a34b4f857553" :question/math-academy-id "q-331263" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/26f5b15d20d9f57ee9b1d396683dd4dbad06a656b579ac0fd81241d362a28569.png)\n\nThe graph of $y=f(t)$ is shown above. Which of the following could be $f(t),$ where $u$ denotes the unit step function?" :question/worked-solution "The unit step function $u(t)$ is defined as\n\n$$\nu(t)={\\begin{aligned}1,\\,t\\ge 0, \\\\ 0,\\,t<0.\\end{aligned}\n$$\n\nThe graph of $y=u(t)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/9fb8c20672705e9d68e69d32e7ff3499ec71560e10aa85136b3f3ad75c5fb5ed.png)\n\nNotice that to transform the function $y=u(t)$ to the given function $y=f(t),$ we perform the following transformations:\n\n- First, we reflect $y=u(t)$ in the $y$-axis, which gives $y=u(-t).$\n\n- Next, we shift by two units to the right, giving $y=u(-(t-2))=u(2-t).$\n\n- Finally, we scale by a scale factor of $2$ parallel to the $y$-axis, giving $y=2u(2-t).$\n\nTherefore, we conclude that $f(t)=2u(2-t).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-331263/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "253b1011-a313-5004-8cbe-61133586e6b1"] :knowledge-point/questions ["q-331263"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81106/selection/b8704f26a25d980dfdce9eedfdd69e558bcab8ea6ec8da53638f479fabdf97f2" :answer/id #uuid "35cf3d11-b2c5-5e9f-acba-db3eb0fbcd21" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{11}{\\sqrt{5}} \\\\ \\frac{1}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81106/selection/636b47d0dce84739dec7900733ab0b23e2a75bff0949e1a90ad16f74ba73c5db" :answer/id #uuid "dfbe921f-67d0-5706-a5c6-36b025c7070d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{10}{\\sqrt{5}} \\\\ -\\frac{2}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81106/selection/fd50cb49d873d53384f499cd76edd2ec871673557718860b81c60383beb5aed2" :answer/id #uuid "93dc7b26-4f82-599a-a051-8216bdcf5712" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{11}{\\sqrt{5}} \\\\ \\frac{7}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81106/selection/ea890e2dfe067ad8d30fc5256c28ca70e8c79a46f279e7d10ad669015dbf8e11" :answer/id #uuid "0c319097-9c82-5855-844a-1c3b6a816381" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{11}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81106/selection/2f41a3096dbbd578205959b3cfaf5b1e805d3da2039aa5bdebcb9cacd4bcbda6" :answer/id #uuid "65a1ba53-d9ca-5ff1-9f3d-9c4fc0989396" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{1}{\\sqrt{5}} \\\\ -\\frac{11}{\\sqrt{5}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81106/selection" :answer-field/id #uuid "3b1e9640-f0e5-54fd-a3ed-9808ca7fd7ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81106/selection/fd50cb49d873d53384f499cd76edd2ec871673557718860b81c60383beb5aed2" :answer-field/choices ["q-81106/selection/b8704f26a25d980dfdce9eedfdd69e558bcab8ea6ec8da53638f479fabdf97f2" "q-81106/selection/636b47d0dce84739dec7900733ab0b23e2a75bff0949e1a90ad16f74ba73c5db" "q-81106/selection/fd50cb49d873d53384f499cd76edd2ec871673557718860b81c60383beb5aed2" "q-81106/selection/ea890e2dfe067ad8d30fc5256c28ca70e8c79a46f279e7d10ad669015dbf8e11" "q-81106/selection/2f41a3096dbbd578205959b3cfaf5b1e805d3da2039aa5bdebcb9cacd4bcbda6"] :db/ensure [:answer-field/validate]} {:db/id "q-81106" :question/id #uuid "694ae25e-76dc-5254-b28a-52858f45659d" :question/math-academy-id "q-81106" :question/problem "Given the **orthonormal** basis $B={[\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}],[\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]}$ of ${R}^{2},$ find $[x]_{B}$ if $x=[\\begin{aligned}-3 \\\\ 5\\end{aligned}].$" :question/worked-solution "Let's denote the vectors of $B$ as ${q}_{1},\\,{q}_{2}.$ \n\nSince $B$ is an orthonormal basis, we have that $[x]_{B}=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}]$, where ${x}_{i}=x\\cdot {q}_{i}.$ Computing the components of $x,$ we get the following: \n\n$$\n\\begin{aligned}{x}_{1} & =[\\begin{aligned}-3 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}\\frac{2}{\\sqrt{5}} \\\\ -\\frac{1}{\\sqrt{5}}\\end{aligned}]=-\\frac{6}{\\sqrt{10}}-\\frac{5}{\\sqrt{5}}=-\\frac{11}{\\sqrt{5}} \\\\ {x}_{2} & =[\\begin{aligned}-3 \\\\ 5\\end{aligned}]\\cdot [\\begin{aligned}\\frac{1}{\\sqrt{5}} \\\\ \\frac{2}{\\sqrt{5}}\\end{aligned}]=-\\frac{3}{\\sqrt{5}}+\\frac{10}{\\sqrt{10}}=\\frac{7}{\\sqrt{5}}\\end{aligned}\n$$\n\nTherefore, we have \n\n$$\n[x]_{B}=[\\begin{aligned}-\\frac{11}{\\sqrt{5}} \\\\ \\frac{7}{\\sqrt{5}}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81106/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39b12711-22c8-5cb7-bd61-e128734e7e6f"] :knowledge-point/questions ["q-81106"] :db/ensure [:knowledge-point/validate]} {:db/id "q-88041/selection/c6b19a2c46f5188c2c19fc28203596ec3ad8586a871d24541bda7a5fa6dbf644" :answer/id #uuid "d51e9349-8b90-547d-b6c3-7e0a0cc80672" :answer/type :answer.type/math :answer/value "1<x\\le \\frac{{e}^{5}}{{e}^{5}-3}" :db/ensure [:answer/validate]} {:db/id "q-88041/selection/f8178294d0c43ff73a6d5ffd448f7a6c203b03cc6fdb059d2adc7a25d5fdb0ca" :answer/id #uuid "6fecbb4c-e7dc-56ce-aff0-eb5bc102029b" :answer/type :answer.type/math :answer/value "x\\ge \\frac{{e}^{5}}{{e}^{5}-3}" :db/ensure [:answer/validate]} {:db/id "q-88041/selection/2b3123e9a92d8120ebaca09ad8ad75de8b9e1105197fa090c1a5afeae80151ab" :answer/id #uuid "2284eb37-4384-578f-a5ef-47f0d8f8908c" :answer/type :answer.type/text :answer/value "no solution" :db/ensure [:answer/validate]} {:db/id "q-88041/selection/d8a167b2f86a18fa284aefe264ef0c35a0b3166154d86d12836cbd880463df6c" :answer/id #uuid "83498a57-74aa-53b0-9ba0-2fcac0574304" :answer/type :answer.type/math :answer/value "x>1" :db/ensure [:answer/validate]} {:db/id "q-88041/selection/924ebb08bdd337fce32721f39c5f37637e81401ae2ef8b560e955d7dfff890f1" :answer/id #uuid "56977187-a825-5d8e-90ef-5fd961c3163b" :answer/type :answer.type/math :answer/value "0\\le x\\le \\frac{{e}^{5}}{{e}^{5}-3}" :db/ensure [:answer/validate]} {:db/id "q-88041/selection" :answer-field/id #uuid "a1f9e131-40c3-5990-bae0-dd5db678e4d9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-88041/selection/f8178294d0c43ff73a6d5ffd448f7a6c203b03cc6fdb059d2adc7a25d5fdb0ca" :answer-field/choices ["q-88041/selection/c6b19a2c46f5188c2c19fc28203596ec3ad8586a871d24541bda7a5fa6dbf644" "q-88041/selection/f8178294d0c43ff73a6d5ffd448f7a6c203b03cc6fdb059d2adc7a25d5fdb0ca" "q-88041/selection/2b3123e9a92d8120ebaca09ad8ad75de8b9e1105197fa090c1a5afeae80151ab" "q-88041/selection/d8a167b2f86a18fa284aefe264ef0c35a0b3166154d86d12836cbd880463df6c" "q-88041/selection/924ebb08bdd337fce32721f39c5f37637e81401ae2ef8b560e955d7dfff890f1"] :db/ensure [:answer-field/validate]} {:db/id "q-88041" :question/id #uuid "f8b94d42-fdad-56dc-8ffb-85fae3ce76d9" :question/math-academy-id "q-88041" :question/problem "Solve the inequality $\\operatorname{ln}⁡(3x)\\le \\operatorname{ln}⁡(x-1)+5.$" :question/worked-solution "We use each side of the inequality as an exponent of $e.$ This gives the following:\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡(3x)} & \\le {e}^{\\operatorname{ln}⁡(x-1)+5} \\\\ {e}^{\\operatorname{ln}⁡(3x)} & \\le {e}^{\\operatorname{ln}⁡(x-1)}\\cdot {e}^{5} \\\\ 3x & \\le (x-1){e}^{5} \\\\ 3x & \\le {e}^{5}x-{e}^{5} \\\\ {e}^{5} & \\le ({e}^{5}-3)x \\\\ x & \\ge \\frac{{e}^{5}}{{e}^{5}-3}\\end{aligned}\n$$\n\nNow, we must only keep the solutions that are in the domain of the logarithms in the original inequality. To find the domain of the logarithms, we recall that the argument of the logarithm must be positive:\n\n$$\n\\begin{aligned}3x & >0 & ⇒ &  & x & >0 \\\\ x-1 & >0 & ⇒ &  & x & >1\\end{aligned}\n$$\n\nOur solution is $x\\ge \\frac{{e}^{5}}{{e}^{5}-3},$ which can be expressed as $[\\frac{{e}^{5}}{{e}^{5}-3},\\infty ).$ Additionally, the domains of the logarithms are $x>0$ and $x>1,$ which can be expressed as $(0,\\infty )$ and $(1,\\infty )$ respectively. To find the solutions that are in the domains of the logarithms, we take the intersection:\n\n$$\n[\\frac{{e}^{5}}{{e}^{5}-3},\\infty )\\cap (0,\\infty )\\cap (1,\\infty )=[\\frac{{e}^{5}}{{e}^{5}-3},\\infty )\n$$\n\nTherefore, the solution is $x\\in [\\frac{{e}^{5}}{{e}^{5}-3},\\infty ),$ which can also be written as $x\\ge \\frac{{e}^{5}}{{e}^{5}-3}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-88041/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "106dce79-251c-52b2-adc7-9fd2b59b9b83"] :knowledge-point/questions ["q-88041"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89885/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "69f32dbb-5860-546d-951c-b71903cf942b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-89885/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c63c6329-411c-5ee5-a6fb-c199983b9670" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-89885/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "84fccc02-cfba-59ba-965b-cf1df9b5fdd0" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-89885/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "772c5e5c-a173-5bff-9c9f-6280a74d301e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-89885/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "517f550c-47fc-55d5-aaff-7f19a5e4f9a8" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-89885/selection" :answer-field/id #uuid "482c157c-a744-5559-9cdf-215aac443a0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89885/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-89885/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-89885/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-89885/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-89885/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-89885/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-89885" :question/id #uuid "a38e97ba-c156-5496-ad06-15f48100971c" :question/math-academy-id "q-89885" :question/problem "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=x+y.\n$$\n\nGiven that the point $(-1,1)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\n- $(-1,1)$ is a stationary point of the function $f$\n- $(-1,1)$ is a local minimum point of the function $f$\n- $(-1,1)$ is an inflection point of the function $f$" :question/worked-solution "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(-1,1),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,1)} & ={(x+y)|}_{(-1,1)} \\\\  & =-1+1 \\\\  & =0\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(x+y) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(x)+\\frac{\\text{d}}{\\text{d}x}(y) \\\\  & =1+\\frac{\\text{d}y}{\\text{d}x} \\\\  & =1+(x+y) \\\\  & =x+y+1 \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1,1)} & ={(x+y+1)|}_{(-1,1)} \\\\  & =-1+1+1 \\\\  & =1 \\\\  & >0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is true. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,1)}=0,\n$$\n\nwe obtain that $(-1,1)$ is a stationary point of the function $f.$\n\n- Statement II is true. There is a critical point at $(-1,1).$ So, according to the second derivative test, since\n\n$$\n{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1,1)}>0,\n$$\n\nwe have a local minimum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(-1,1).$\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-89885/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f901a3ab-3b58-51a1-b653-f88ac4b09060"] :knowledge-point/questions ["q-89885"] :db/ensure [:knowledge-point/validate]} {:db/id "q-109693/selection/e4acb2f8af93ecfc40854e67794be8757018cb7380bea59977a889dba912a541" :answer/id #uuid "f9489b65-16a1-5a34-8576-4b38bc1a20f5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ \\frac{3}{2} & -\\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109693/selection/2b7bd24a4852d9ea968587a7235758a63b286e376ab2e83038cdbae418633774" :answer/id #uuid "d1d646d5-85b9-536c-b336-eafaf91775d9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ -\\frac{1}{2} & \\frac{3}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109693/selection/3cf0d25fd173139201a0df967a247c9065c1dd9e49ae5ab41a9cbde89fbb0491" :answer/id #uuid "921e4fd5-c92d-5ad4-900f-c21751184697" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & \\frac{3}{2} \\\\ 1 & -\\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109693/selection/bd19c4b2181b8e8cb2160563518bf79638d99c1e8a07bd56d8e492a7b48a5783" :answer/id #uuid "7fc1c354-b8af-5711-a9ac-717a3743db85" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 1 \\\\ \\frac{3}{2} & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109693/selection/088c880c4f3ba7c4d48fc50c19f17d2ca876a517ad7289bf3d279ac011e386f9" :answer/id #uuid "a8b54efa-3e3a-5412-90b6-6e5914044640" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 0 \\\\ \\frac{3}{2} & -\\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-109693/selection" :answer-field/id #uuid "cedfb63c-47b8-5191-8c0c-989b4150708f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-109693/selection/e4acb2f8af93ecfc40854e67794be8757018cb7380bea59977a889dba912a541" :answer-field/choices ["q-109693/selection/e4acb2f8af93ecfc40854e67794be8757018cb7380bea59977a889dba912a541" "q-109693/selection/2b7bd24a4852d9ea968587a7235758a63b286e376ab2e83038cdbae418633774" "q-109693/selection/3cf0d25fd173139201a0df967a247c9065c1dd9e49ae5ab41a9cbde89fbb0491" "q-109693/selection/bd19c4b2181b8e8cb2160563518bf79638d99c1e8a07bd56d8e492a7b48a5783" "q-109693/selection/088c880c4f3ba7c4d48fc50c19f17d2ca876a517ad7289bf3d279ac011e386f9"] :db/ensure [:answer-field/validate]} {:db/id "q-109693" :question/id #uuid "c344a893-9b6e-5aef-b629-9ed9f81985a3" :question/math-academy-id "q-109693" :question/problem "The second-order differential equation $2{y}^{″}+{y}^{′}-3y=0$\ncan be expressed as the matrix equation ${x}^{′}(t)=Ax(t),$ where \n\n$$\nx(t)=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}],\\,A=[\\begin{aligned}a & b \\\\ c & d\\end{aligned}],\\,y(t)={x}_{1}(t),\\,{y}^{′}(t)={x}_{2}(t).\n$$\n\nFind the matrix $A.$" :question/worked-solution "We first need to express the given differential equation as a system of first-order differential equations. Then, we write the system as a matrix equation.\n\nWe start by making the following change of variables:\n\n$$\n\\begin{aligned}{x}_{1} & =y \\\\ {x}_{2} & ={y}^{′}\\end{aligned}\n$$\n\nDifferentiating the above equations with respect to $t,$ we get\n\n$$\n\\begin{aligned}{x}_{1}^{′} & ={y}^{′} \\\\ {x}_{2}^{′} & ={y}^{″}\\end{aligned}\n$$\n\nwhich we can rewrite as \n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2}, \\\\ {x}_{2}^{′}={y}^{″}.\\end{aligned}\n$$\n\nWe must now write the right-hand side of the last equation in terms of ${x}_{1}$ and ${x}_{2}.$\n\nSolving our original differential equation for the highest-order derivative $({y}^{″}),$ we obtain\n\n$$\n{y}^{″}=-\\frac{1}{2}{y}^{′}+\\frac{3}{2}y.\n$$\n\nThen, we substitute our new variables into the right-hand side of the above equation. This gives\n\n$$\n{y}^{″}=-\\frac{1}{2}{x}_{2}+\\frac{3}{2}{x}_{1}.\n$$\n\nNotice that we do not include any derivative terms on the right-hand side. \n\nTherefore, our complete system of equations is as follows:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}={x}_{2} \\\\ {x}_{2}^{′}=\\frac{3}{2}{x}_{1}-\\frac{1}{2}{x}_{2}\\end{aligned}\n$$\n\nWe can represent this system as the matrix differential equation ${x}^{′}(t)=Ax(t)$ as follows:\n\n$$\n[\\begin{aligned}{x}_{1}^{′} \\\\ {x}_{2}^{′}\\end{aligned}]=[\\begin{aligned}0 & 1 \\\\ \\frac{3}{2} & -\\frac{1}{2}\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}].\n$$\n\nHence, $A=[\\begin{aligned}0 & 1 \\\\ \\frac{3}{2} & -\\frac{1}{2}\\end{aligned}].$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-109693/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7657ff9-3918-5080-b9a2-8f6a6d8b4fd9"] :knowledge-point/questions ["q-109693"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337287/field-1/3ce97719c85181cc1d92b0f65e7e0a3a9921e17e353605f7233dceb3a43220d1" :answer/id #uuid "30f6671d-6686-51cf-9fd2-69e21ded16da" :answer/type :answer.type/math :answer/value "36t-24" :db/ensure [:answer/validate]} {:db/id "q-337287/field-1" :answer-field/id #uuid "339b992a-3d29-58ca-bd8e-a724ad5e6549" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-337287/field-1/3ce97719c85181cc1d92b0f65e7e0a3a9921e17e353605f7233dceb3a43220d1" :answer-field/choices ["q-337287/field-1/3ce97719c85181cc1d92b0f65e7e0a3a9921e17e353605f7233dceb3a43220d1"] :db/ensure [:answer-field/validate]} {:db/id "q-337287" :question/id #uuid "ea828402-747f-5569-b98b-87a511fbc72e" :question/math-academy-id "q-337287" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}-3 & 2 \\\\ -6 & 5\\end{aligned}]x(t)+[\\begin{aligned}2t \\\\ 0\\end{aligned}]\n$$\n\nConsider the system of differential equations. Using the method of variation of parameters, the general solution of the equation can be written in the form\n\n| $x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{3t}+\\,\\,\\frac{1}{9}$ |  | $30t-26$ |  | . |\n| --- | --- | --- | --- | --- |\n|  | {{field-1}} |  |  |  |" :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\nx(t)={x}_{c}(t)+{x}_{p}(t)\n$$\n\nwhere ${x}_{c}(t)$ is the complementary solution (solution of the corresponding homogeneous system) and ${x}_{p}(t)$ is a particular solution.\n\nNotice that we are given that\n\n$$\n{x}_{c}(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{3t}.\n$$\n\nWe'll look for a particular solution in the form\n\n$$\n{x}_{p}(t)=Φ\\,u(t)\n$$\n\nwhere $Φ$ is a fundamental matrix for the corresponding homogeneous system, $f(t)$ is the forcing column vector and\n\n$$\nu(t)=\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t.\n$$\n\nIn our case,\n\n$$\nΦ=[\\begin{aligned}{e}^{-t} & {e}^{3t} \\\\ {e}^{-t} & 3{e}^{3t}\\end{aligned}],\\,f(t)=[\\begin{aligned}2t \\\\ 0\\end{aligned}].\n$$\n\nSince $Φ$ is a fundamental matrix, it must be invertible. Using the formula for the inverse of a $2\\times 2$ matrix, we get the following:\n\n$$\n\\begin{aligned}{Φ}^{-1} & =\\frac{1}{{e}^{-t}\\cdot 3{e}^{3t}-{e}^{3t}\\cdot {e}^{-t}}[\\begin{aligned}3{e}^{3t} & -{e}^{3t} \\\\ -{e}^{-t} & {e}^{-t}\\end{aligned}] \\\\  & =\\frac{1}{2{e}^{2t}}[\\begin{aligned}3{e}^{3t} & -{e}^{3t} \\\\ -{e}^{-t} & {e}^{-t}\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}3{e}^{t} & -{e}^{t} \\\\ -{e}^{-3t} & {e}^{-3t}\\end{aligned}].\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{Φ}^{-1}\\,f(t) & =\\frac{1}{2}[\\begin{aligned}3{e}^{t} & -{e}^{t} \\\\ -{e}^{-3t} & {e}^{-3t}\\end{aligned}][\\begin{aligned}2t \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}3t{e}^{t} \\\\ -t{e}^{-3t}\\end{aligned}].\\end{aligned}\n$$\n\nNow, using our formula for $u(t),$ we obtain\n\n$$\n\\begin{aligned}u(t) & =\\int {Φ}^{-1}\\,f(t)\\,\\text{d}t \\\\  & =\\int [\\begin{aligned}3t{e}^{t} \\\\ -t{e}^{-3t}\\end{aligned}]\\,\\text{d}t \\\\  & =[\\begin{aligned}\\int 3t{e}^{t}\\,\\text{d}t \\\\ \\int -t{e}^{-3t}\\,\\text{d}t\\end{aligned}].\\end{aligned}\n$$\n\nIntegrating the components by parts, we get the following:\n\n- For the first component, let $u=3t$ and $\\text{d}v={e}^{t}\\,\\text{d}t.$ Then, $\\text{d}u=3\\,\\text{d}t$ and $v={e}^{t}.$ So,\n\n$$\n\\begin{aligned}\\int 3t{e}^{t}\\,\\text{d}t & =(3t)\\cdot {e}^{t}-\\int {e}^{t}\\cdot (3\\,\\text{d}t) \\\\  & =3t{e}^{t}-3{e}^{t} \\\\  & =3{e}^{t}(t-1).\\end{aligned}\n$$\n\n- For the second component, let $u=-t$ and $\\text{d}v={e}^{-3t}\\,\\text{d}t.$ Then, $\\text{d}u=-\\,\\text{d}t$ and $v=-\\frac{1}{3}{e}^{-3t}.$ So,\n\n$$\n\\begin{aligned}\\int -t{e}^{-3t}\\,\\text{d}t & =(-t)\\cdot (-\\frac{1}{3}{e}^{-3t})-\\int (-\\frac{1}{3}{e}^{-3t})\\cdot (-\\,\\text{d}t) \\\\  & =\\frac{t}{3}{e}^{-3t}-\\frac{1}{3}\\int {e}^{-3t}\\,\\text{d}t \\\\  & =\\frac{t}{3}{e}^{-3t}+\\frac{1}{9}{e}^{-3t} \\\\  & =\\frac{1}{9}{e}^{-3t}(3t+1).\\end{aligned}\n$$\n\nTherefore, our particular solution is\n\n$$\n\\begin{aligned}{x}_{p}(t) & =Φ\\,u(t) \\\\  & =[\\begin{aligned}{e}^{-t} & {e}^{3t} \\\\ {e}^{-t} & 3{e}^{3t}\\end{aligned}][\\begin{aligned}3{e}^{t}(t-1) \\\\ \\frac{1}{9}{e}^{-3t}(3t+1)\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}27(t-1)+(3t+1) \\\\ 27(t-1)+3(3t+1)\\end{aligned}] \\\\  & =\\frac{1}{9}[\\begin{aligned}30t-26 \\\\ 36t-24\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337287/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74dbd777-f24e-5d23-b495-a56710d71f5a"] :knowledge-point/questions ["q-337287"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186257281 :question/answer-fields 17592186257282] {:db/id "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "d4384449-e97e-50b5-b015-95f2f8b5633b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "f2b25a9c-a983-580c-878e-4224b7548f09" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "9b46aa2b-5494-54c2-99b8-f73a9e9492ca" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "5a40dba0-67d5-58e4-8b61-71b97c14184d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "232133c4-05bd-5487-b748-93227ab76cd3" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41" :answer-field/id #uuid "0e606b0d-c1e8-5e4e-ac94-039518580d98" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-118786"] :question/problem "Which of the following systems is a first-order initial value problem?\n\n- $(1+{x}^{2}){y}^{′}=8y,\\,y(-1)=3$\n- $8{y}^{′}-xy=3$\n- $3{y}^{″}=4y,\\,y(-1)=0,\\,{y}^{′}(-1)=1$" :question/worked-solution "A first-order initial value problem (or IVP) is a first-order ordinary differential equation together with an initial condition that specifies a value of the unknown function at a point in its domain. A first-order initial value problem typically takes the form\n\n$$\n{y}^{′}=f(x,y),\\,y({x}_{0})={y}_{0},\n$$\n\nwhere ${x}_{0}$ and ${y}_{0}$ are constants.\n\nWith that in mind, let's check each option.\n\n- System I is a first-order initial value problem. It consists of a first-order differential equation $(1+{x}^{2}){y}^{′}=8y$ together with the initial condition $y(-1)=3.$\n\n- System II is not a first-order initial value problem. We have a first-order ordinary differential equation, but there is no initial condition.\n\n- System III is not a first-order initial value problem. It consists of a *second*-order differential equation $3{y}^{″}=4y$ together with *two* initial conditions $y(-1)=0,\\,{y}^{′}(-1)=1.$ This is a second-order initial value problem.\n\nTherefore, the correct answer is \"I only.\"" :question/answer-fields ["q-118786/selection/ma-v1/d713d75e6483f03b1f946c9971dcc0b503df845c3233c29170b72a7bee22bd41"] :db/ensure [:question/validate]} {:db/id "q-116178/selection/c6b3a2dba2766fa45e6efbc49457cf65c12dcffbedef478f230df69a5fdc9014" :answer/id #uuid "ea0256ec-6c23-5640-80c5-b53a8d01669c" :answer/type :answer.type/math :answer/value "{y}^{′}=\\frac{{y}^{2}}{y+2}" :db/ensure [:answer/validate]} {:db/id "q-116178/selection/9352a8cdb99037cb2d9edf1e8cb55ae717016ef1222c45ade0dc0ca0630e67b9" :answer/id #uuid "82e16ecb-3983-57f5-b0af-3c11ebb54296" :answer/type :answer.type/math :answer/value "{y}^{′}=\\frac{1}{{y}^{2}+2y}" :db/ensure [:answer/validate]} {:db/id "q-116178/selection/fbe841ea9346f0510a370c42784d58462091c37ce293f6fe5ff6812ed7425f8c" :answer/id #uuid "6ca7be40-b3bb-538d-a554-a9b54ae5aa4c" :answer/type :answer.type/math :answer/value "{y}^{′}=-\\frac{2}{{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-116178/selection/9589ee6530e49fcc4836250fc26240c2a5a3d862d49d37ced29a704670add8c6" :answer/id #uuid "c0cc1459-8dc9-5f18-abe5-a74af07940f8" :answer/type :answer.type/math :answer/value "{y}^{′}=\\frac{1}{(y+2)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-116178/selection/b66f2a9a1301f4ed0104b47d132081a5d32ac2495116db2838de0004d617f106" :answer/id #uuid "cd8da905-93b4-5607-aeb1-bf36bce35e8d" :answer/type :answer.type/math :answer/value "{y}^{′}=-\\frac{3}{y+2}" :db/ensure [:answer/validate]} {:db/id "q-116178/selection" :answer-field/id #uuid "31a70359-6998-50b9-ac15-ef4f505b8f65" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-116178/selection/9589ee6530e49fcc4836250fc26240c2a5a3d862d49d37ced29a704670add8c6" :answer-field/choices ["q-116178/selection/c6b3a2dba2766fa45e6efbc49457cf65c12dcffbedef478f230df69a5fdc9014" "q-116178/selection/9352a8cdb99037cb2d9edf1e8cb55ae717016ef1222c45ade0dc0ca0630e67b9" "q-116178/selection/fbe841ea9346f0510a370c42784d58462091c37ce293f6fe5ff6812ed7425f8c" "q-116178/selection/9589ee6530e49fcc4836250fc26240c2a5a3d862d49d37ced29a704670add8c6" "q-116178/selection/b66f2a9a1301f4ed0104b47d132081a5d32ac2495116db2838de0004d617f106"] :db/ensure [:answer-field/validate]} {:db/id "q-116178" :question/id #uuid "62d0d964-c6e2-513f-84cf-88714bdfdf7a" :question/math-academy-id "q-116178" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/9e368467f35af6f9f8c13dcfb2d8edc2547e2ab123b4bd2bfd68e6878cea9907.png)\n\nIdentify the differential equation that generated the slope field above." :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/632d27d8354cdde40f59894fc017c49a49d47003d2f914ed0deef8c6751d7c1d.png)\n\nNotice the following properties of the given slope field:\n\n- First, the slopes become vertical as $y\\to -2$ only. \n\nOf the given equations, the only equations that satisfy this condition are the following:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{(y+2)^{2}} \\\\ {y}^{′} & =\\frac{{y}^{2}}{y+2} \\\\ {y}^{′} & =-\\frac{3}{y+2}\\end{aligned}\n$$\n\n- Second, the slopes become horizontal as $y\\to \\infty .$\n\nOf the remaining options, the only two that give this behavior are\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{1}{(y+2)^{2}} \\\\ {y}^{′} & =-\\frac{3}{y+2}\\end{aligned}\n$$\n\n- Finally, the slopes of the slope field are positive for all $y\\ne -2.$ \n\nTherefore, the equation ${y}^{′}=-\\frac{3}{y+2}$ does *not* give the required behavior. The slopes of the slope field for this differential equation are negative for $y>-2.$\n\nOn the other hand, the equation ${y}^{′}=\\frac{1}{(y+2)^{2}}$ gives the required behavior. Notice that the right-hand side of this equation is positive for all $y\\ne -2.$\n\nSo, the correct answer is ${y}^{′}=\\frac{1}{(y+2)^{2}}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-116178/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fba5f68e-15da-5804-b6d9-d72ce6acae59"] :knowledge-point/questions ["q-116178"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95886/selection/312d11530afb7816d5bf361f9e73f0f776bcd91ac2fc26f2c6192cc137594af9" :answer/id #uuid "21453fc6-0510-5b03-87c8-f1ff0d5fdc73" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{sech}⁡3x+3x{tanh}^{2}⁡3x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-95886/selection/ac7ef1acec07a3f5262e32f95ec78bffcd2430318c6c5f7e2b57d6189eee19dc" :answer/id #uuid "934861dc-e057-5a5e-b92c-a33b770666a3" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{sech}⁡3x(3x\\operatorname{tanh}⁡3x+1)}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-95886/selection/8052ec1358b7a25c93d2158e0fd09710bbd8012882006781104a8f603bdf9e43" :answer/id #uuid "4a3c11d6-eeb5-5f59-af69-d594c86ba101" :answer/type :answer.type/math :answer/value "-\\frac{\\operatorname{sech}⁡3x+3{tanh}^{2}⁡3x}{x}" :db/ensure [:answer/validate]} {:db/id "q-95886/selection/24fdb390aaebcf3491c56bc36cd858bb3f904675651e157d5602f289989de376" :answer/id #uuid "6138b865-5a2f-5dc5-8095-92a91ca47a44" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sech}⁡3x-3x{tanh}^{2}⁡3x}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-95886/selection/91baf78d85b0e7a862b9316ce654848d91d18c162f2c605c40e0c77b0da9bd2c" :answer/id #uuid "b4726568-f69c-511f-8bf3-524eb0214c80" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sech}⁡3x(1-3x\\operatorname{tanh}⁡3x)}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-95886/selection" :answer-field/id #uuid "94958318-5505-50ea-9f90-8a4ebed90666" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95886/selection/ac7ef1acec07a3f5262e32f95ec78bffcd2430318c6c5f7e2b57d6189eee19dc" :answer-field/choices ["q-95886/selection/312d11530afb7816d5bf361f9e73f0f776bcd91ac2fc26f2c6192cc137594af9" "q-95886/selection/ac7ef1acec07a3f5262e32f95ec78bffcd2430318c6c5f7e2b57d6189eee19dc" "q-95886/selection/8052ec1358b7a25c93d2158e0fd09710bbd8012882006781104a8f603bdf9e43" "q-95886/selection/24fdb390aaebcf3491c56bc36cd858bb3f904675651e157d5602f289989de376" "q-95886/selection/91baf78d85b0e7a862b9316ce654848d91d18c162f2c605c40e0c77b0da9bd2c"] :db/ensure [:answer-field/validate]} {:db/id "q-95886" :question/id #uuid "e0ecf117-583a-5b98-885c-e1c875a74a19" :question/math-academy-id "q-95886" :question/problem "$$\n\nFind the derivative of $f(x)=\\frac{\\operatorname{sech}⁡3x}{x}.$" :question/worked-solution "In this case, the expression for $f(x)$ is a quotient $\\frac{u(x)}{v(x)}$ with $u(x)=\\operatorname{sech}⁡3x$ and $v(x)=x.$ \n\nTherefore, we apply the quotient rule as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}{f}^{′}(x) & =\\frac{{u}^{′}(x)\\cdot v(x)-u(x)\\cdot {v}^{′}(x)}{[v(x)]^{2}} \\\\  & =\\frac{{(\\operatorname{sech}⁡3x)}^{′}\\cdot x-\\operatorname{sech}⁡3x\\cdot {(x)}^{′}}{(x)^{2}} \\\\  & =\\frac{-3x\\operatorname{sech}⁡3x\\operatorname{tanh}⁡3x-\\operatorname{sech}⁡3x}{{x}^{2}} \\\\  & =-\\frac{\\operatorname{sech}⁡3x(3x\\operatorname{tanh}⁡3x+1)}{{x}^{2}}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-95886/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "08d9798e-a4bb-5f04-9d49-494990c52bff"] :knowledge-point/questions ["q-95886"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95505/selection/db2829e98707e6a916107ed86d4588d9920acea5cf4bdd387769e2d104a6f1f3" :answer/id #uuid "7f9c5272-40a5-58cd-912a-33a4cd05f646" :answer/type :answer.type/math :answer/value "\\frac{x}{{e}^{2x}+1}" :db/ensure [:answer/validate]} {:db/id "q-95505/selection/b5b10b94f2c59eb91b3e735b301915365daa1c082e876f9353efbcdd0296b584" :answer/id #uuid "2a0eb8f8-92ae-5019-9d5c-faa2978588e9" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2x}}{1-{e}^{x}}" :db/ensure [:answer/validate]} {:db/id "q-95505/selection/e2a597af8e58e89d121023cd067d1f4d418e77a7d338ed9f783dd04bdbcafa59" :answer/id #uuid "a2f14128-a178-5bb3-afd9-439f540096b7" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}}{1+{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "q-95505/selection/7fdd4a8914aa86c63cebf0b2bff36d558d2fc38f9b0aba64c7b2d0c76480b055" :answer/id #uuid "08412b52-4cfb-5412-8537-58ef35295219" :answer/type :answer.type/math :answer/value "\\frac{{e}^{x}}{1-{e}^{2x}}" :db/ensure [:answer/validate]} {:db/id "q-95505/selection/93380f2680e7e5dd6bd7e47a29ceb593f155cdf02231952535b8fbeaf156066d" :answer/id #uuid "1be660e5-4491-5cc2-a883-603f1c398d43" :answer/type :answer.type/math :answer/value "\\frac{x}{{e}^{2x}-1}" :db/ensure [:answer/validate]} {:db/id "q-95505/selection" :answer-field/id #uuid "7d1a91e0-b7d1-5713-8e41-61b2622139c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95505/selection/7fdd4a8914aa86c63cebf0b2bff36d558d2fc38f9b0aba64c7b2d0c76480b055" :answer-field/choices ["q-95505/selection/db2829e98707e6a916107ed86d4588d9920acea5cf4bdd387769e2d104a6f1f3" "q-95505/selection/b5b10b94f2c59eb91b3e735b301915365daa1c082e876f9353efbcdd0296b584" "q-95505/selection/e2a597af8e58e89d121023cd067d1f4d418e77a7d338ed9f783dd04bdbcafa59" "q-95505/selection/7fdd4a8914aa86c63cebf0b2bff36d558d2fc38f9b0aba64c7b2d0c76480b055" "q-95505/selection/93380f2680e7e5dd6bd7e47a29ceb593f155cdf02231952535b8fbeaf156066d"] :db/ensure [:answer-field/validate]} {:db/id "q-95505" :question/id #uuid "7bc13545-d6a0-5612-9a84-04aec6ad0b6d" :question/math-academy-id "q-95505" :question/problem "$$\n\nIf $y=\\operatorname{artanh}⁡{e}^{x},$ then $\\frac{\\text{d}y}{\\text{d}x}=$" :question/worked-solution "The formula for the derivative of the inverse hyperbolic tangent function is\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nUsing the formula above with the chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡{e}^{x}) \\\\  & =\\frac{1}{1-{({e}^{x})}^{2}}\\cdot {({e}^{x})}^{′} \\\\  & =\\frac{1}{1-{e}^{2x}}\\cdot {e}^{x} \\\\  & =\\frac{{e}^{x}}{1-{e}^{2x}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95505/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1979b91d-2ac0-5d35-b4cc-1c9c9505b503"] :knowledge-point/questions ["q-95505"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120282/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "3ae722b7-c22c-5887-8ba1-a32b85df0708" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-120282/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "78150e77-3179-5c3c-8312-f346b1214791" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-120282/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "95a9aafb-743a-5db9-a4bd-e3e99aa48114" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-120282/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "b4dce26d-b6cf-5177-9052-cbb5ea452dbc" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-120282/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "24a34f04-31e0-595b-9d73-92639de96b49" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-120282/selection" :answer-field/id #uuid "04f941ec-0a4d-5561-963d-72dcef1e090f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120282/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-120282/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-120282/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-120282/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-120282/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-120282/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-120282" :question/id #uuid "756c6ce9-69a9-5b19-a782-28029712ec85" :question/math-academy-id "q-120282" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/e90d9a160db2c75091253eaa8a8c815e92c45f988841683f5a4d18ca6a6ea7db.png)\n\nWhich of the following equations could have generated the slope field shown above?\n\n- ${y}^{′}=-x{y}^{2}$\n- ${y}^{′}=-\\frac{y}{x}$\n- ${y}^{′}=\\frac{x}{y}$" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/54932bcffbbe793d6e1f730e65570b19cfc3603ddb62eaf0a63ef2e5b0705979.png)\n\nNotice the following properties of the given slope field:\n\n- For $y\\ne 0,$ the slopes of the slope field become horizontal at $x=0$ only.\n\n- For $x\\ne 0,$ the slopes of the slope field become vertical as $y\\to 0.$\n\nWith that in mind, let's consider each equation.\n\n- Equation I does *not* give the required behavior. The right-hand side of ${y}^{′}=-x{y}^{2}$ evaluates to zero both on $x=0$ and $y=0.$\n\n- Equation II does *not* give the required behavior. The right-hand side of ${y}^{′}=-\\frac{y}{x}$ does not evaluate to zero on $x=0.$\n\n- Equation III gives the required behavior. For $y\\ne 0,$ the right-hand side of ${y}^{′}=\\frac{x}{y}$ evaluates to zero on $x=0$ only, and for $x\\ne 0,$ we have \n\n$$\n|{y}^{′}|=|\\frac{x}{y}|\\to \\infty \\,\\text{as}\\,y\\to 0.\n$$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120282/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3e3fdc8-67d0-5b46-9c6b-c1ec8d4ea24f"] :knowledge-point/questions ["q-120282"] :db/ensure [:knowledge-point/validate]} {:db/id "q-108854/selection/1a9b08e3cfe651d7580c57fec49baa7ff2d33ecc347b1030c376d714c70950e2" :answer/id #uuid "bf699cd1-bfd0-5245-9ea8-888ffc96b530" :answer/type :answer.type/math :answer/value "2x+y" :db/ensure [:answer/validate]} {:db/id "q-108854/selection/1c38ca06e29222ff5b21d9677df817c3bb0dde77ee9df39bc61ef3912d8b3119" :answer/id #uuid "27d00506-2c0f-5038-aac9-80cf9df1396d" :answer/type :answer.type/math :answer/value "4x+2y-1" :db/ensure [:answer/validate]} {:db/id "q-108854/selection/6cf7d03a4bbaadbf33c6f94fcb81489141040ec6fee7dc5f454436fea9ce3726" :answer/id #uuid "34c38378-410c-51e9-95c5-b83c4b50b95e" :answer/type :answer.type/math :answer/value "8x+4y+1" :db/ensure [:answer/validate]} {:db/id "q-108854/selection/f5e04f2e4c1e7ffb270f9c91e079908142225ecc97985909408025faef493adb" :answer/id #uuid "3b3265c5-f5e4-5646-8b71-f7d726decf73" :answer/type :answer.type/math :answer/value "8x+4y" :db/ensure [:answer/validate]} {:db/id "q-108854/selection/7f19fdb7ddfc597e7d40af566ac9548875dacaf21417b0ae59c0f3ebb59a459b" :answer/id #uuid "6ba6ab6b-9f31-5a3d-862c-c80e5fbf2428" :answer/type :answer.type/math :answer/value "2x+y+3" :db/ensure [:answer/validate]} {:db/id "q-108854/selection" :answer-field/id #uuid "e7286209-167d-5b5a-ad65-074a786bb7ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-108854/selection/6cf7d03a4bbaadbf33c6f94fcb81489141040ec6fee7dc5f454436fea9ce3726" :answer-field/choices ["q-108854/selection/1a9b08e3cfe651d7580c57fec49baa7ff2d33ecc347b1030c376d714c70950e2" "q-108854/selection/1c38ca06e29222ff5b21d9677df817c3bb0dde77ee9df39bc61ef3912d8b3119" "q-108854/selection/6cf7d03a4bbaadbf33c6f94fcb81489141040ec6fee7dc5f454436fea9ce3726" "q-108854/selection/f5e04f2e4c1e7ffb270f9c91e079908142225ecc97985909408025faef493adb" "q-108854/selection/7f19fdb7ddfc597e7d40af566ac9548875dacaf21417b0ae59c0f3ebb59a459b"] :db/ensure [:answer-field/validate]} {:db/id "q-108854" :question/id #uuid "8958083b-a553-5f14-95dd-a92020e3a321" :question/math-academy-id "q-108854" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{4x+2y}.\n$$\n\nThe general solution to this equation can be expressed in the form\n\n$$\n\\operatorname{ln}⁡|g(x,y)|=4y-C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we factor the right-hand side of the given equation.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{2(2x+y)}\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=2x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-2.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-2 & =\\frac{1}{2z}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{4z+1}{2z}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{2z}{4z+1}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\int \\frac{2z}{4z+1}\\,\\text{d}z & =\\int \\text{d}x \\\\ \\frac{1}{2}\\int (1-\\frac{1}{4z+1})\\text{d}z & =\\int \\text{d}x \\\\ \\frac{1}{2}(z-\\frac{1}{4}\\operatorname{ln}⁡|4z+1|) & =x+K \\\\ 4z-\\operatorname{ln}⁡|4z+1| & =8x+C\\end{aligned}\n$$\n\nwhere $C=8K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\begin{aligned}8x+4y-\\operatorname{ln}⁡|8x+4y+1| & =8x+C \\\\ \\operatorname{ln}⁡|8x+4y+1| & =4y-C\\end{aligned}\n$$\n\nTherefore, \n\n$$\ng(x,y)=8x+4y+1.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-108854/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6655eb29-8410-5a5c-be86-457affcfb4c3"] :knowledge-point/questions ["q-108854"] :db/ensure [:knowledge-point/validate]} {:db/id "q-118729/selection/2b4264cdbdffefa367e877d8644059752c1f54d73db8dba8a6434d958320c5ee" :answer/id #uuid "9d2938e3-1e1d-5b64-beae-464b0efc1584" :answer/type :answer.type/text :answer/value "$236$ thousand years" :db/ensure [:answer/validate]} {:db/id "q-118729/selection/0a488023da53f458a9e8c49cd84a2efa523908a35cbfc4609af4f0b7c4284484" :answer/id #uuid "d6170a18-056a-5b22-ac1e-c87a12d1ff36" :answer/type :answer.type/text :answer/value "$112$ thousand years" :db/ensure [:answer/validate]} {:db/id "q-118729/selection/6f6924d46d6dd62f32f08a29fcde5138e91a67ca1e0569deeb24e3e7d9f7583f" :answer/id #uuid "371ddcc0-6122-5ea8-a2cc-d808214fb04a" :answer/type :answer.type/text :answer/value "$92$ thousand years" :db/ensure [:answer/validate]} {:db/id "q-118729/selection/d95bc5738974aad78a114687f67ca6506ad0d4034c4962b3315345afaf58d609" :answer/id #uuid "36d64eeb-d3e2-56ac-b3d6-4961be2b9db7" :answer/type :answer.type/text :answer/value "$125$ thousand years" :db/ensure [:answer/validate]} {:db/id "q-118729/selection/db854e80b9f28d79ea2b87382e9a5e1afcc30ed8076db0176b8aa03c4b5a7fb5" :answer/id #uuid "3cad6e2b-87f7-52ac-96ab-ddeb95a369ed" :answer/type :answer.type/text :answer/value "$143$ thousand years" :db/ensure [:answer/validate]} {:db/id "q-118729/selection" :answer-field/id #uuid "1608a816-a3bc-5ccc-8af8-315b9d2d5d6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-118729/selection/d95bc5738974aad78a114687f67ca6506ad0d4034c4962b3315345afaf58d609" :answer-field/choices ["q-118729/selection/2b4264cdbdffefa367e877d8644059752c1f54d73db8dba8a6434d958320c5ee" "q-118729/selection/0a488023da53f458a9e8c49cd84a2efa523908a35cbfc4609af4f0b7c4284484" "q-118729/selection/6f6924d46d6dd62f32f08a29fcde5138e91a67ca1e0569deeb24e3e7d9f7583f" "q-118729/selection/d95bc5738974aad78a114687f67ca6506ad0d4034c4962b3315345afaf58d609" "q-118729/selection/db854e80b9f28d79ea2b87382e9a5e1afcc30ed8076db0176b8aa03c4b5a7fb5"] :db/ensure [:answer-field/validate]} {:db/id "q-118729" :question/id #uuid "4f07a813-bdba-5d8c-bec2-0b9ab0451832" :question/math-academy-id "q-118729" :question/problem "At a geological site, an object is found with $75%$ of its original chlorine-36 content. Given that the half-life of chlorine-36 is $301$ thousand years, approximately how old is the object?" :question/worked-solution "The mass $M(t)$ of a radioactive substance at time $t$ can be modeled by the differential equation\n\n$$\n{M}^{′}(t)=-kM(t),\\,M(0)={M}_{0}.\n$$\n\nThe general solution to this equation is\n\n$$\nM(t)={M}_{0}{e}^{-kt}.\n$$\n\nThe half-life ${t}_{1/2}$ is the time taken for the mass of the substance to reduce by one half and is given by\n\n$$\n{t}_{1/2}=\\frac{\\operatorname{ln}⁡2}{k}.\n$$\n\nSince we know that ${t}_{1/2}=301$ thousand years, we have\n\n$$\n301=\\frac{\\operatorname{ln}⁡2}{k}\\,⇒\\,k=\\frac{\\operatorname{ln}⁡2}{301}.\n$$\n\nSo, we have\n\n$$\nM(t)={M}_{0}{e}^{-t\\operatorname{ln}⁡2/301}.\n$$\n\nWe wish to calculate the time $t$ such that $M(t)=0.75{M}_{0}.$ So, we set up our equation as follows:\n\n$$\n0.75{M}_{0}={M}_{0}{e}^{-t\\operatorname{ln}⁡2/301}\n$$\n\nSolving this equation for $t,$ we get\n\n$$\n\\begin{aligned}0.75{M}_{0} & ={M}_{0}{e}^{-t\\operatorname{ln}⁡2/301} \\\\ 0.75\\cancel{{M}_{0}} & =\\cancel{{M}_{0}}{e}^{-t\\operatorname{ln}⁡2/301} \\\\ 0.75 & ={e}^{-t\\operatorname{ln}⁡2/301} \\\\ \\operatorname{ln}⁡(0.75) & =\\operatorname{ln}⁡({e}^{-t\\operatorname{ln}⁡2/301}) \\\\ \\operatorname{ln}⁡(0.75) & =-\\frac{t\\operatorname{ln}⁡2}{301} \\\\ t & =-\\frac{301\\cdot \\operatorname{ln}⁡(0.75)}{\\operatorname{ln}⁡2} \\\\ t & ≈125.\\end{aligned}\n$$\n\nTherefore, we conclude that the object is approximately $125$ thousand years old." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-118729/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a8fdf766-dca6-5dcc-ada6-c24a50c95716"] :knowledge-point/questions ["q-118729"] :db/ensure [:knowledge-point/validate]} {:db/id "q-122810/selection/92c59eaaba1959853a9e499622fa9c1dc211f4602b6716ae2d28456509009271" :answer/id #uuid "d91904b6-4e94-53aa-9d73-a0a410023af8" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/8bd5b7575d1693935df0d25a259767f0dd267fc1153139cd55cebad75e3988fd.png" :db/ensure [:answer/validate]} {:db/id "q-122810/selection/4d5207f42a84d34580a363d3bdcc5d501670283cc42ac6be20bcdfb3c52594cc" :answer/id #uuid "85b3378a-1c80-5319-b95e-21aaf3be71ed" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/4c1a0035b37bc0137dc2ac164c980d538f9362feb3b439e663885f8aa7178124.png" :db/ensure [:answer/validate]} {:db/id "q-122810/selection/8eeb98eaa29fc41b57e60e50d520a5eb4bcef6cdaff182f50ab09c3bbc24bdf8" :answer/id #uuid "8306560b-5712-57a0-bc8e-355a201c7a15" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/f9d6304bc9cc6b6e74235c66a7d70b96dbea2db44e9ed82606f6025075b76336.png" :db/ensure [:answer/validate]} {:db/id "q-122810/selection/b4d6f73b64d9c6fed9faeb7c8626a0ed58d36969bdaa15913ae8dac9bc460da3" :answer/id #uuid "deaf1551-6443-5133-86f0-aaa0a8f5acda" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/704a1e0712c0c2512e16ac03f1eeb7ecd55996c822eced54ac510f4719485c42.png" :db/ensure [:answer/validate]} {:db/id "q-122810/selection/978b401a07d6d274c45e0a3f66d7140cd857c7b37567325c17e0f3ddbc47fd73" :answer/id #uuid "af0fa02d-0dcb-5724-9762-a821c7ad0380" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/fa8bf282264f1647644cc15b6aece745718bd17617afad2c2530292bfed10b15.png" :db/ensure [:answer/validate]} {:db/id "q-122810/selection" :answer-field/id #uuid "cd703c1e-63b2-52c8-a661-5fd74717d952" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-122810/selection/92c59eaaba1959853a9e499622fa9c1dc211f4602b6716ae2d28456509009271" :answer-field/choices ["q-122810/selection/92c59eaaba1959853a9e499622fa9c1dc211f4602b6716ae2d28456509009271" "q-122810/selection/4d5207f42a84d34580a363d3bdcc5d501670283cc42ac6be20bcdfb3c52594cc" "q-122810/selection/8eeb98eaa29fc41b57e60e50d520a5eb4bcef6cdaff182f50ab09c3bbc24bdf8" "q-122810/selection/b4d6f73b64d9c6fed9faeb7c8626a0ed58d36969bdaa15913ae8dac9bc460da3" "q-122810/selection/978b401a07d6d274c45e0a3f66d7140cd857c7b37567325c17e0f3ddbc47fd73"] :db/ensure [:answer-field/validate]} {:db/id "q-122810" :question/id #uuid "0a69704c-1c6e-5b5d-ae42-82a5a6cd1452" :question/math-academy-id "q-122810" :question/problem "Which of the following could be the gradient vector field of the function $f(x,y)={x}^{2}-y?$" :question/worked-solution "We start by plotting some level curves of the function:\n\n- Setting $f(x,y)=-1,$ we get ${x}^{2}-y=-1,$ which gives the parabola $y={x}^{2}+1$\n\n- Setting $f(x,y)=0,$ we get ${x}^{2}-y=0,$ that is, the parabola $y={x}^{2}$\n\n- Setting $f(x,y)=2,$ we get ${x}^{2}-y=2,$ that is, the parabola $y={x}^{2}-2$\n\n- $⋯$\n\nContinuing in this way, we get the following contour plot:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/77a54ef31c41e0246e3d337a69c7faa161194058e6a5c672ef24d86866a83faf.png)\n\nNote that $f(x,y)$ increases as we move downward and away from the origin $O.$ \n\nNow, we recall the following facts:\n\n- The gradient field vectors of a function $f(x,y)$ always lie perpendicular to its level curves.\n\n- Moreover, the vectors point in the direction where $f(x,y)$ increases.\n\nWith this in mind, we can add the vector field to the contour plot, giving the following picture.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/4e124d5e77ef9a28002aba9aac40f0b7eff1232dd1c08b6bca10b166469675c7.png)\n\nSo, the corresponding gradient field is as follows:\n\n \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/8bd5b7575d1693935df0d25a259767f0dd267fc1153139cd55cebad75e3988fd.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-122810/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "364d2c9a-6e9a-57f8-aa57-c10ee223061b"] :knowledge-point/questions ["q-122810"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163548/selection/b35c633f881ff48622a275fefda89c9f408477c4c48d3ff27a1dbd8dbc1aa709" :answer/id #uuid "cc59692d-8e56-544e-8518-ed211520a029" :answer/type :answer.type/math :answer/value "3\\sqrt{6}\\,m/s" :db/ensure [:answer/validate]} {:db/id "q-163548/selection/76fecd61fe10080d2ec25fc87caa6c7fc13c436b31341cb0170ae1bbdf3a86e1" :answer/id #uuid "99bea051-55e3-5f06-9ebe-be38839b0a5a" :answer/type :answer.type/math :answer/value "4\\sqrt{3}\\,m/s" :db/ensure [:answer/validate]} {:db/id "q-163548/selection/3ee8486a0630768bbd20061576a72f8b9f3213b8c29b30f493fedf927485fb25" :answer/id #uuid "0fd70fd7-4169-593d-b17d-6524c8aa73d3" :answer/type :answer.type/math :answer/value "6\\,m/s" :db/ensure [:answer/validate]} {:db/id "q-163548/selection/21e85611efe70c486805e069c9b9d0b7f88a3c1616681df42691a3333e7c5043" :answer/id #uuid "8af1a7f0-21ea-599e-8ae4-8c70b697fdc3" :answer/type :answer.type/math :answer/value "8\\,m/s" :db/ensure [:answer/validate]} {:db/id "q-163548/selection/939b08c0b8cace754001a17f8073b1a8790d29a243aa29c54d0055d97b5ae815" :answer/id #uuid "97e80f02-5fc0-5dbe-8691-00ee2ab26405" :answer/type :answer.type/math :answer/value "2\\sqrt{13}\\,m/s" :db/ensure [:answer/validate]} {:db/id "q-163548/selection" :answer-field/id #uuid "9bfa03b0-59e8-5335-aa32-e5c6bb8083d8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163548/selection/939b08c0b8cace754001a17f8073b1a8790d29a243aa29c54d0055d97b5ae815" :answer-field/choices ["q-163548/selection/b35c633f881ff48622a275fefda89c9f408477c4c48d3ff27a1dbd8dbc1aa709" "q-163548/selection/76fecd61fe10080d2ec25fc87caa6c7fc13c436b31341cb0170ae1bbdf3a86e1" "q-163548/selection/3ee8486a0630768bbd20061576a72f8b9f3213b8c29b30f493fedf927485fb25" "q-163548/selection/21e85611efe70c486805e069c9b9d0b7f88a3c1616681df42691a3333e7c5043" "q-163548/selection/939b08c0b8cace754001a17f8073b1a8790d29a243aa29c54d0055d97b5ae815"] :db/ensure [:answer-field/validate]} {:db/id "q-163548" :question/id #uuid "c0d1d1a5-d9cb-5570-acc7-da72657b9a2b" :question/math-academy-id "q-163548" :question/problem "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin is $x\\,m,$ the velocity is $v\\,m/s,$ and the acceleration is $(4-x)\\,{m/s}^{2}.$ If $P$ has velocity $v=6\\,m/s$ at the origin, find the maximum velocity of the particle." :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/d4e5b78932f8ff6155ac81e12538eb31ac211c9d27d6a2b0c67542527ccd3b2a.png)\n\nThe extrema of the velocity occur at the critical points of $v.$ Since the acceleration of the particle $P$ is $(4-x)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=4-x.\n$$\n\nTo find the moments where $v$ is a maximum, we need to solve $\\frac{\\text{d}v}{\\text{d}t}=0$ and test each solution using the first or second derivative test.\n\nSolving $\\frac{\\text{d}v}{\\text{d}t}=0$ gives\n\n$$\n\\begin{aligned}4-x & =0 \\\\ x & =4.\\end{aligned}\n$$\n\nHence, the extremum of the velocity function occurs when $x=4\\,m.$\n\nWe now test the extreme value using the first derivative test. We summarize the necessary information in a table, shown below.\n\n| $x$ | $(0,4)$ | $4$ | $(4,\\infty )$ |\n| --- | --- | --- | --- |\n| Test Point | $2$ |  | $6$ |\n| $\\frac{\\text{d}v}{\\text{d}t}$ | $2>0$ | $0$ | $-2<0$ |\n| $v$ | $↗$ | max | $↘$ |\n\nWe conclude that the velocity is maximized when $x=4\\,m.$\n\nNext, using the fact that\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our initial equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=4-x.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int (4-x)\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}=4x-\\frac{1}{2}{x}^{2}+C.\n$$\n\nNow, since $v=6\\,m/s$ when $x=0\\,m,$ we can find the value of the constant $C,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+C \\\\ \\frac{1}{2}(6)^{2} & =4(0)-\\frac{1}{2}(0)^{2}+C \\\\ C & =18\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =4x-\\frac{1}{2}{x}^{2}+18 \\\\ {v}^{2} & =8x-{x}^{2}+36 \\\\ v & =\\pm \\sqrt{-{x}^{2}+8x+36}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x)>0,$ so we can disregard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{-{x}^{2}+8x+36}.\n$$\n\nFinally, we calculate the maximum velocity:\n\n$$\n{v}_{max}=v(4)=\\sqrt{-(4)^{2}+8(4)+36}=2\\sqrt{13}\\,m/s\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163548/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8c812adc-7418-5a76-9c7f-96c726c7ca0e"] :knowledge-point/questions ["q-163548"] :db/ensure [:knowledge-point/validate]} {:db/id "q-162223/selection/a46b9d9cb098f30c2bfb1712d5eac34a9a6a7683788497e7234aec27f048077a" :answer/id #uuid "ba6e294f-2347-5a76-90fc-963742329f08" :answer/type :answer.type/text :answer/value "A pentagon" :db/ensure [:answer/validate]} {:db/id "q-162223/selection/c2d1a5ac4ed1170ec4ba684e8dd01cdba007525d6370ddfd38066ec585122318" :answer/id #uuid "84b28194-810b-5a70-9cae-bbb852e20df8" :answer/type :answer.type/text :answer/value "A line segment" :db/ensure [:answer/validate]} {:db/id "q-162223/selection/efff15d31c09e1f108daa7793309521088dfa694bb5914dcf15d35cd6340a394" :answer/id #uuid "15b1a78d-8d09-5f27-9ba1-8c2d0c952eca" :answer/type :answer.type/text :answer/value "A quadrilateral" :db/ensure [:answer/validate]} {:db/id "q-162223/selection/4e58580515bb45c045fd2f14cf2873f6efa6f0e2170ad5b45d216042e4ee999a" :answer/id #uuid "3d386f2a-8c52-5e5d-a1b8-7e1028c08127" :answer/type :answer.type/text :answer/value "A point" :db/ensure [:answer/validate]} {:db/id "q-162223/selection/99d5aeb2f87bf6ef13f130429773b8288f79a42bed11813730ac0875b5e7a025" :answer/id #uuid "0ee19810-b146-58cb-aa9c-2847b646aba0" :answer/type :answer.type/text :answer/value "A triangle" :db/ensure [:answer/validate]} {:db/id "q-162223/selection" :answer-field/id #uuid "3ec07334-4d1d-5995-a619-1a60f74ed33b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-162223/selection/c2d1a5ac4ed1170ec4ba684e8dd01cdba007525d6370ddfd38066ec585122318" :answer-field/choices ["q-162223/selection/a46b9d9cb098f30c2bfb1712d5eac34a9a6a7683788497e7234aec27f048077a" "q-162223/selection/c2d1a5ac4ed1170ec4ba684e8dd01cdba007525d6370ddfd38066ec585122318" "q-162223/selection/efff15d31c09e1f108daa7793309521088dfa694bb5914dcf15d35cd6340a394" "q-162223/selection/4e58580515bb45c045fd2f14cf2873f6efa6f0e2170ad5b45d216042e4ee999a" "q-162223/selection/99d5aeb2f87bf6ef13f130429773b8288f79a42bed11813730ac0875b5e7a025"] :db/ensure [:answer-field/validate]} {:db/id "q-162223" :question/id #uuid "1262209b-34c5-5b8f-bcf5-cc7e6c173b69" :question/math-academy-id "q-162223" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14035554/assets/522a51527563645261a3b4c5a1472510bcb3e890fc82d3b4c1b2ccdae59b9dbd.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}9 & -3 \\\\ 3 & -1\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\n \nWhat would be the image of the rectangle shown above under the action of $T?$" :question/worked-solution "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}9 & -3 \\\\ 3 & -1\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}9 & -3 \\\\ 3 & -1\\end{aligned}| \\\\  & =9\\cdot (-1)-3\\cdot (-3) \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible and the image of the rectangle under the action of $T$ is a line segment." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-162223/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4e551b65-4116-58bc-b2bc-e536930c69b4"] :knowledge-point/questions ["q-162223"] :db/ensure [:knowledge-point/validate]} {:db/id "q-336300/field-1/36c86a5bcf9beeeaec3978e98b724ea28b9fbaff9a10cfd6086e887cd6746e57" :answer/id #uuid "ece31cc5-4493-571f-be4f-43a27342195e" :answer/type :answer.type/math :answer/value "4.8" :db/ensure [:answer/validate]} {:db/id "q-336300/field-1" :answer-field/id #uuid "cfb1e79f-7789-5ee9-8707-8979eaf696ae" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336300/field-1/36c86a5bcf9beeeaec3978e98b724ea28b9fbaff9a10cfd6086e887cd6746e57" :answer-field/choices ["q-336300/field-1/36c86a5bcf9beeeaec3978e98b724ea28b9fbaff9a10cfd6086e887cd6746e57"] :db/ensure [:answer-field/validate]} {:db/id "q-336300/field-2/452cd59aeb557c36eafdedf983973c8f307e0d1f9b7245417393dc531d0271c8" :answer/id #uuid "0c18ce72-f6b8-5ce2-bf10-d7edc42cee9c" :answer/type :answer.type/math :answer/value "10^{2}" :db/ensure [:answer/validate]} {:db/id "q-336300/field-2" :answer-field/id #uuid "7c91fc5c-380e-5e71-92bf-b258b18e1dfa" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336300/field-2/452cd59aeb557c36eafdedf983973c8f307e0d1f9b7245417393dc531d0271c8" :answer-field/choices ["q-336300/field-2/452cd59aeb557c36eafdedf983973c8f307e0d1f9b7245417393dc531d0271c8"] :db/ensure [:answer-field/validate]} {:db/id "q-336300" :question/id #uuid "386b24bd-3eff-5335-834a-d78cada3240c" :question/math-academy-id "q-336300" :question/problem "The gravitational force between two objects, of masses $(4.5\\times {10}^{6})\\,\\text{kg}$ and $(2.8\\times {10}^{6})\\,\\text{kg},$ has a magnitude of $(3.6\\times {10}^{-3})\\,\\text{N}.$\nAccording to Newton's law of universal gravitation, what is the distance between the centers of mass of the two objects? Write your answer in scientific notation, rounding to **two significant figures** where appropriate. Assume the Newtonian constant of gravitation is $G=(6.67\\times {10}^{-11})\\,{\\text{m}}^{3}/(\\text{kg}\\cdot {\\text{s}}^{2}).$\n\nThe distance between the two objects is\n$(${{field-1}}\n$\\times $\n{{field-2}}$)\\,\\text{m}.$" :question/worked-solution "Newton's law of universal gravitation states that the gravitational force attracting two objects is proportional to the product of the two masses and inversely proportional to the square of the distance between their centers of mass:\n\n$$\nF=G\\frac{{m}_{1}{m}_{2}}{{r}^{2}}\n$$\n\nwhere\n\n- $F$ is the gravitational force between the objects, measured in Newtons $(\\text{N}),$\n\n- $G=(6.67\\times {10}^{-11})\\,{\\text{m}}^{3}/(\\text{kg}\\cdot {\\text{s}}^{2})$ is the Newtonian constant of gravitation,\n\n- ${m}_{1}$ and ${m}_{2}$ are the masses of the objects, measured in $\\text{kg},$ and\n\n- $r$ is the distance between their centers of mass, measured in $\\text{m}.$\n\nFirst, let's rearrange the formula to make $r$ the subject:\n\n$$\n\\begin{aligned}F & =G\\frac{{m}_{1}{m}_{2}}{{r}^{2}} \\\\ {r}^{2} & =G\\frac{{m}_{1}{m}_{2}}{F} \\\\ r & =\\sqrt{G\\frac{{m}_{1}{m}_{2}}{F}}\\end{aligned}\n$$\n\nChoosing ${m}_{1}=(4.5\\times {10}^{6})\\,\\text{kg}$ and ${m}_{2}=(2.8\\times {10}^{6})\\,\\text{kg}$ and substituting in the other known values, we have\n\n$$\n\\begin{aligned}{r}^{2} & =(6.67\\times {10}^{-11})\\cdot \\frac{(4.5\\times {10}^{6})\\cdot (2.8\\times {10}^{6})}{3.6\\times {10}^{-3}} \\\\  & =\\frac{6.67\\cdot 4.5\\cdot 2.8}{3.6}\\times \\frac{{10}^{-11}\\cdot {10}^{6}\\cdot {10}^{6}}{{10}^{-3}} \\\\  & =23.345\\times {10}^{4}.\\end{aligned}\n$$\n\nFinally, taking the square root, we get\n\n$$\n\\begin{aligned}r & =\\sqrt{23.345\\times {10}^{4}} \\\\  & =\\sqrt{23.345}\\times \\sqrt{{10}^{4}} \\\\  & =(4.8316…)\\times {10}^{2}.\\end{aligned}\n$$\n\nTherefore, rounded to two significant figures, the distance between the two objects is\n$(\\,4.8\\times {10}^{2}\\,)\\,\\text{m}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-336300/field-1" "q-336300/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "11810d4b-610c-5dac-8fe7-abf9391c2aa7"] :knowledge-point/questions ["q-336300"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343302/field-1/8069dd8dde5e157ca57d82efea5470b7d4261fc7c1202310953e955269c854f6" :answer/id #uuid "e91d7c62-251e-57d9-8ed3-113e72949674" :answer/type :answer.type/math :answer/value "-\\frac{1}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-343302/field-1/3a21324200f4e6920fc9e81d9dc5e195f1bebbfe43854e23b317b831799abee2" :answer/id #uuid "df881ed4-b6ec-5b5a-89cf-5b98f3e117ba" :answer/type :answer.type/math :answer/value "-\\frac{Q(x)}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-343302/field-1/7c82a0761f224b4c41e0ec8e7f5222926905eb48df26ce6a32d93035762f0565" :answer/id #uuid "f5b052f0-e079-5c09-bd11-7e534e01b874" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}+1}{Q(x)}" :db/ensure [:answer/validate]} {:db/id "q-343302/field-1/1f8fa38f9b846fd29be52593a87754a642f229d0f5f64ceb82af56632b44a97e" :answer/id #uuid "d6e05566-95b8-564c-9cfc-913d0f6fa03b" :answer/type :answer.type/math :answer/value "\\frac{1}{{x}^{2}+1}" :db/ensure [:answer/validate]} {:db/id "q-343302/field-1" :answer-field/id #uuid "31d63072-94ae-5b91-9e6e-8feb402b4ae9" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-343302/field-1/8069dd8dde5e157ca57d82efea5470b7d4261fc7c1202310953e955269c854f6" :answer-field/choices ["q-343302/field-1/8069dd8dde5e157ca57d82efea5470b7d4261fc7c1202310953e955269c854f6" "q-343302/field-1/3a21324200f4e6920fc9e81d9dc5e195f1bebbfe43854e23b317b831799abee2" "q-343302/field-1/7c82a0761f224b4c41e0ec8e7f5222926905eb48df26ce6a32d93035762f0565" "q-343302/field-1/1f8fa38f9b846fd29be52593a87754a642f229d0f5f64ceb82af56632b44a97e"] :db/ensure [:answer-field/validate]} {:db/id "q-343302/field-2/9a100643f80ebd4bbba43a03f04122377ff7f3168646521810f419a5d221b34d" :answer/id #uuid "a30010e8-ab17-5838-a398-d794b51a0505" :answer/type :answer.type