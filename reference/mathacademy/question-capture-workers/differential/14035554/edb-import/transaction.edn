0c9becce05bd2a64eb8bf8dbe1e5771cddf2cdd12cc197336ec805cd80005" "q-39705/selection/241308430f7393f26a9d811824d27fb4cb0fe8956189d40b1741657f6986a57b" "q-39705/selection/735ab8cc4286f2c00166dbabfe3661448f40e2a9b3470a0c59ce6c9fde7517b2" "q-39705/selection/62f9053312fbb14d678e75fd93a586966642a2e8f4691e2c9633f1cecb731b6d" "q-39705/selection/aa42a77b5d873a73c62a1e804cffc7ffae1aa35e7792736682ba8b4a2d834b1f"] :db/ensure [:answer-field/validate]} {:db/id "q-39705" :question/id #uuid "8820e364-7215-527a-af4b-9358606a911f" :question/math-academy-id "q-39705" :question/problem "Let ${v}_{1}=[\\begin{aligned}2 \\\\ 5\\end{aligned}]$ and ${v}_{2}=[\\begin{aligned}1 \\\\ 3\\end{aligned}]$ be eigenvectors of a matrix $A.$ Find the decoupling matrix of the differential equation ${x}^{′}(t)=Ax(t).$" :question/worked-solution "First, we construct the matrix $E$, whose columns are the eigenvectors ${v}_{1}$ and ${v}_{2}:$\n\n$$\nE=[\\begin{aligned}2 & 1 \\\\ 5 & 3\\end{aligned}]\n$$\n\nNow, the decoupling matrix can be found as follows:\n\n$$\n\\begin{aligned}D & ={E}^{-1} \\\\  & ={[\\begin{aligned}2 & 1 \\\\ 5 & 3\\end{aligned}]}^{-1} \\\\  & =\\frac{1}{2\\cdot 3-5\\cdot 1}[\\begin{aligned}3 & -1 \\\\ -5 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -1 \\\\ -5 & 2\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39705/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2a962d5e-5cc9-530e-9f95-85c399af7e4b"] :knowledge-point/questions ["q-39705"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42249/selection/09269df15e3fb141cceebb0588aab82a40ef42df1a8a11f4146bedfe71482238" :answer/id #uuid "8d7d7a1c-b55d-5247-8e8e-97aef855613c" :answer/type :answer.type/math :answer/value "94" :db/ensure [:answer/validate]} {:db/id "q-42249/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326" :answer/id #uuid "46686adf-d76e-5f52-971d-08083196b440" :answer/type :answer.type/math :answer