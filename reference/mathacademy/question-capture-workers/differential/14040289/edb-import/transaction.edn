\ 1 & 1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}].\n$$" :question/worked-solution "First, notice that\n\n$$\n{[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}].\n$$\n\nSo, we have been given the following diagonalization of $G:$\n\n$$\nG={{[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSince $G=PD{P}^{-1}$, we can compute ${G}^{k}$ by using the formula \n\n$$\n{G}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n \n\n$$\n\\begin{aligned}{G}^{10} & =P{D}^{10}{P}^{-1} \\\\  & =[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}]{[\\begin{aligned}2 & 0 \\\\ 0 & -2\\end{aligned}]}^{10}[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}{2}^{10} & 0 \\\\ 0 & (-2)^{10}\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1024 & 0 \\\\ 0 & 1024\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-1024 & 0 \\\\ 1024 & 1024\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1024 & 0 \\\\ 0 & 1024\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37358/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "634729e9-7633-52d8-99fa-b00fc9cbe96a"] :knowledge-point/questions ["q-37358"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37257"] :question/problem "Find ${A}^{101},$ where\n\n$$\nA=[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}\\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 1\\end{aligned}].\n$$" :question/worked-solution "First, notice that\n\n$$\n{[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}]}^{-1}=[\\begin{aligned}\\frac{1}{2} & -\\frac{1}{2} \\\\ 0 & 1\\end{aligned}]=\\frac{1}{2}[\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}].\n$$\n\nSo, we have been given the following diagonalization of $A:$\n\n$$\nA={{[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSince $A=PD{P}^{-1}$, we can compute ${A}^{k}$ by using the formula \n\n$$\n{A}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{A}^{101} & =P{D}^{101}{P}^{-1} \\\\  & =[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}]{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}^{101}(\\frac{1}{2}[\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}]) \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}{1}^{101} & 0 \\\\ 0 & (-1)^{101}\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & 1 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -1 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ 0 & -1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-86694/selection/4aae16fa24716fb8dacd52045b79e787e493ef6aada6d0d379717a95a04144e7" :answer/id #uuid "0a34dcf4-3d33-5cf6-99d0-8d38732150d5" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-4 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86694/selection/9c3312d08da4463d361156ad26d0c5031c5f6696ad6a8bf9cf9c86844539f89c" :answer/id #uuid "9047b396-f04f-59d8-a461-eeb54ce85b34" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-2 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ -7\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86694/selection/a429d8e14f9f169ad277b7de300d2952cdf0fac045acc1d47bfb07113f04dcaf" :answer/id #uuid "0bc0935f-4830-501a-9899-68828e4eb6e1" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-3 \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ -5\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86694/selection/4b1c06cfa0d17c89d165629e7fa8527681ae7800d993b63282432e07c1049a8d" :answer/id #uuid "c7e75822-f6c7-57f3-99bb-2d9e03a5b79d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-4 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}6 \\\\ -7\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86694/selection/a3b86ad19cf4f80167f76b1267ea34981dfdbb9469bb59119baa6e51b0b4cab8" :answer/id #uuid "7f425780-7b2d-5b9b-9420-c7a5dc80e64f" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-2 \\\\ 8\\end{aligned}]$ and $[\\begin{aligned}7 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86694/selection" :answer-field/id #uuid "5ee2e222-e23f-5d55-af5f-ac55f758a6c5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86694/selection/9c3312d08da4463d361156ad26d0c5031c5f6696ad6a8bf9cf9c86844539f89c" :answer-field/choices ["q-86694/selection/4aae16fa24716fb8dacd52045b79e787e493ef6aada6d0d379717a95a04144e7" "q-86694/selection/9c3312d08da4463d361156ad26d0c5031c5f6696ad6a8bf9cf9c86844539f89c" "q-86694/selection/a429d8e14f9f169ad277b7de300d2952cdf0fac045acc1d47bfb07113f04dcaf" "q-86694/selection/4b1c06cfa0d17c89d165629e7fa8527681ae7800d993b63282432e07c1049a8d" "q-86694/selection/a3b86ad19cf4f80167f76b1267ea34981dfdbb9469bb59119baa6e51b0b4cab8"] :db/ensure [:answer-field/validate]} {:db/id "q-86694" :question/id #uuid "fa57c68c-4d50-562c-8052-052523362c27" :question/math-academy-id "q-86694" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $T$ given that \n\n$$\n[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]T=[\\begin{aligned}5 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $T:$\n\n$$\nT={{{[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]}^{-1}}_{⏟}}_{P}{{[\\begin{aligned}5 & 0 \\\\ 0 & -4\\end{aligned}]}_{⏟}}_{D}{{[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $T$ is diagonalizable. The eigenvalues of $T$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-4$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}7 & 5 \\\\ 3 & 2\\end{aligned}]}^{-1}=\\frac{1}{-1}[\\begin{aligned}2 & -5 \\\\ -3 & 7\\end{aligned}]=[\\begin{aligned}-2 & 5 \\\\ 3 & -7\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}5 \\\\ -7\\end{aligned}]$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86694/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5"] :knowledge-point/questions ["q-86694"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86691/selection/956395732fc285cf8c1544ecd5b38abc601c5e2799d0bd70507c5c6f8ea55ebe" :answer/id #uuid "9f50342e-c33f-5ed6-af50-69ae97a9b769" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-4 \\\\ 5\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86691/selection/40021863188e08dfdc17cff017efa3eee8a04c8676718e02d9da9abe5de4480d" :answer/id #uuid "412bff98-3ac8-50cb-81e9-8c7013d07151" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-5 \\\\ 4\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86691/selection/734c2e6816a7b1e65b9fb2a2c050128b2ae5588f1a92d29a12e8c0b616eb78d9" :answer/id #uuid "09c0069f-db49-5fc7-98f7-ebac210c797a" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}4 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86691/selection/dd905d3982155a7200dc63db5da8636dc79e8d85f9425f26f5dbee9181123df2" :answer/id #uuid "ca2821a2-5d15-5287-9113-bceca7ea6c64" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ 5\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86691/selection/6c732e1460a44e4dbff91fb22537db88219af39928bfbbf88f6e110cab69c70b" :answer/id #uuid "de9dfa26-ac2d-5aff-ba6a-a3c457318c4f" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-4 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ -4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-86691/selection" :answer-field/id #uuid "07daf116-1bb1-55cf-9b1d-00d40c74951c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86691/selection/956395732fc285cf8c1544ecd5b38abc601c5e2799d0bd70507c5c6f8ea55ebe" :answer-field/choices ["q-86691/selection/956395732fc285cf8c1544ecd5b38abc601c5e2799d0bd70507c5c6f8ea55ebe" "q-86691/selection/40021863188e08dfdc17cff017efa3eee8a04c8676718e02d9da9abe5de4480d" "q-86691/selection/734c2e6816a7b1e65b9fb2a2c050128b2ae5588f1a92d29a12e8c0b616eb78d9" "q-86691/selection/dd905d3982155a7200dc63db5da8636dc79e8d85f9425f26f5dbee9181123df2" "q-86691/selection/6c732e1460a44e4dbff91fb22537db88219af39928bfbbf88f6e110cab69c70b"] :db/ensure [:answer-field/validate]} {:db/id "q-86691" :question/id #uuid "ce43285b-7223-5171-8e80-52749669a7a1" :question/math-academy-id "q-86691" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $E$ given that \n\n$$\n[\\begin{aligned}1 & 1 \\\\ 5 & 4\\end{aligned}]E=[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 5 & 4\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}1 & 1 \\\\ 5 & 4\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $E:$\n\n$$\nE={{{[\\begin{aligned}1 & 1 \\\\ 5 & 4\\end{aligned}]}^{-1}}_{⏟}}_{P}{{[\\begin{aligned}3 & 0 \\\\ 0 & 2\\end{aligned}]}_{⏟}}_{D}{{[\\begin{aligned}1 & 1 \\\\ 5 & 4\\end{aligned}]}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $E$ is diagonalizable. The eigenvalues of $E$ are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=2$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}1 & 1 \\\\ 5 & 4\\end{aligned}]}^{-1}=\\frac{1}{-1}[\\begin{aligned}4 & -1 \\\\ -5 & 1\\end{aligned}]=[\\begin{aligned}-4 & 1 \\\\ 5 & -1\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}-4 \\\\ 5\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86691/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5"] :knowledge-point/questions ["q-86691"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37363/selection/d125ce47300feb816bec3fc32882232e3af235d844494a6b8f127c75c0651e66" :answer/id #uuid "5eea1f06-512d-58bd-9701-80b684e18e6c" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-4 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 4\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37363/selection/a9168e7697985ca551fc04b8e492c356da7ba991d61ff49f2a9f457bd225a7b5" :answer/id #uuid "251bcc1e-ec1b-597d-a1ab-166e78dfcca6" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ -3\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37363/selection/f3ff058171c0656f429baefe9f54df8b6a43cef1f29d33a92c80eec949d8e67c" :answer/id #uuid "9637dba8-bbcb-5c06-aa7a-a8937ffb55fa" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ -3\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37363/selection/eaaa3b0e24ac60d60df48545549a8f0fe52c1f3ac63a7031c9cf818ac9381fc4" :answer/id #uuid "45a6c498-0337-5ab2-a1db-a52e45bd06b1" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37363/selection/106638ccd47f534c515e700a96ae4c10cf572efc8c0c7576650bb5132ac1463b" :answer/id #uuid "4d724b57-5449-5940-a718-c7c4cb2b3732" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}3 \\\\ -2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ 3\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37363/selection" :answer-field/id #uuid "a2c17535-17aa-57e0-b939-1ea12ada9105" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37363/selection/f3ff058171c0656f429baefe9f54df8b6a43cef1f29d33a92c80eec949d8e67c" :answer-field/choices ["q-37363/selection/d125ce47300feb816bec3fc32882232e3af235d844494a6b8f127c75c0651e66" "q-37363/selection/a9168e7697985ca551fc04b8e492c356da7ba991d61ff49f2a9f457bd225a7b5" "q-37363/selection/f3ff058171c0656f429baefe9f54df8b6a43cef1f29d33a92c80eec949d8e67c" "q-37363/selection/eaaa3b0e24ac60d60df48545549a8f0fe52c1f3ac63a7031c9cf818ac9381fc4" "q-37363/selection/106638ccd47f534c515e700a96ae4c10cf572efc8c0c7576650bb5132ac1463b"] :db/ensure [:answer-field/validate]} {:db/id "q-37363" :question/id #uuid "be975a26-f633-5f30-9bfe-65c4d99c8d4b" :question/math-academy-id "q-37363" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $L$ given that \n\n$$\nL[\\begin{aligned}3 & 2 \\\\ 2 & -3\\end{aligned}]=[\\begin{aligned}3 & 2 \\\\ 2 & -3\\end{aligned}][\\begin{aligned}-4 & 0 \\\\ 0 & 4\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}3 & 2 \\\\ 2 & -3\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $L:$\n\n$$\nL={{[\\begin{aligned}3 & 2 \\\\ 2 & -3\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}-4 & 0 \\\\ 0 & 4\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}3 & 2 \\\\ 2 & -3\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $L$ is diagonalizable. The eigenvalues of $L$ are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=4$ and the corresponding eigenvectors are the columns of the matrix $P:$\n$\\,$ ${v}_{1}=[\\begin{aligned}3 \\\\ 2\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}2 \\\\ -3\\end{aligned}]$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37363/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5"] :knowledge-point/questions ["q-37363"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81236/selection/9e4a0e7e0b64b710b2f4ba12f8e45203fca2ff1f0c9a7053b7e1ff61a5643d26" :answer/id #uuid "25787eae-9e41-5fde-9844-363aa4432844" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-\\sqrt{2} \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}5 \\\\ \\sqrt{2}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-81236/selection/b0dad5b8e662156915bad8f8040789e47e5485d2306775f399bb1caa31d6c1c6" :answer/id #uuid "41926a6a-ae20-5014-bfc5-ba6435b404c4" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-\\sqrt{2} \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ \\sqrt{2}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-81236/selection/02dd0c20de086271f43157c386634d02248252ff9f3f2bfeefac2b2b7d46aad8" :answer/id #uuid "bf1915ba-604d-5294-b5dc-d191cc4ef669" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-\\sqrt{2} \\\\ 4\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ \\sqrt{6}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-81236/selection/5f52f2c2a176b7b0ffedd8aa342a64834f34d7a13efd1bf62631c157b20398ee" :answer/id #uuid "e9af0d92-c085-5d7f-9738-a45b8070d04d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-\\sqrt{2} \\\\ 3\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ \\sqrt{3}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-81236/selection/76b6283124110e6abf6b91b81af515b911ce9858cfa45f51232acfd8b74c82cf" :answer/id #uuid "bc65cb7d-465a-5b73-8d9d-0d72827f1571" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-\\sqrt{2} \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ \\sqrt{2}\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-81236/selection" :answer-field/id #uuid "547e4226-1d32-5af9-b01b-7afd320c1134" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81236/selection/b0dad5b8e662156915bad8f8040789e47e5485d2306775f399bb1caa31d6c1c6" :answer-field/choices ["q-81236/selection/9e4a0e7e0b64b710b2f4ba12f8e45203fca2ff1f0c9a7053b7e1ff61a5643d26" "q-81236/selection/b0dad5b8e662156915bad8f8040789e47e5485d2306775f399bb1caa31d6c1c6" "q-81236/selection/02dd0c20de086271f43157c386634d02248252ff9f3f2bfeefac2b2b7d46aad8" "q-81236/selection/5f52f2c2a176b7b0ffedd8aa342a64834f34d7a13efd1bf62631c157b20398ee" "q-81236/selection/76b6283124110e6abf6b91b81af515b911ce9858cfa45f51232acfd8b74c82cf"] :db/ensure [:answer-field/validate]} {:db/id "q-81236" :question/id #uuid "811972db-6534-593a-aa1e-100258f3cf1f" :question/math-academy-id "q-81236" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $T$ given that \n\n$$\nT[\\begin{aligned}-\\sqrt{2} & 2 \\\\ 2 & \\sqrt{2}\\end{aligned}]=[\\begin{aligned}-\\sqrt{2} & 2 \\\\ 2 & \\sqrt{2}\\end{aligned}][\\begin{aligned}\\frac{1}{2} & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}-\\sqrt{2} & 2 \\\\ 2 & \\sqrt{2}\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $T:$\n\n$$\nT={{[\\begin{aligned}-\\sqrt{2} & 2 \\\\ 2 & \\sqrt{2}\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}\\frac{1}{2} & 0 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}-\\sqrt{2} & 2 \\\\ 2 & \\sqrt{2}\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $T$ is diagonalizable. The eigenvalues of $T$ are ${\\lambda }_{1}=\\frac{1}{2}$ and ${\\lambda }_{2}=-1$ and the corresponding eigenvectors are the columns of the matrix $P:$\n\n$\\,$ ${v}_{1}=[\\begin{aligned}-\\sqrt{2} \\\\ 2\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}2 \\\\ \\sqrt{2}\\end{aligned}]$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81236/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5"] :knowledge-point/questions ["q-81236"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37362/selection/f59e087eec0b2575883acf5284fe289f5ca5852cd9432fe959a1062a18f5f934" :answer/id #uuid "75d71b7a-85b3-515f-8ff9-f8415953f187" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37362/selection/9be533740b2cc7082870cf218da4cd51fd91d86d9f03436750f56a10a13f4df9" :answer/id #uuid "29d4effd-0ff3-59ae-9e45-b14b22ffc070" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}5 \\\\ 0\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37362/selection/518af5df9b08af75f5a37717829d3d0cf8a84b92f48e13ca5f13b80a0ff40cd1" :answer/id #uuid "1ea77758-35fa-5d1a-93fd-3e88e2d58ca7" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37362/selection/0d0a010130ad61f8577d1183bfdbf0ccfc1140ce3a420463c83f45ed4dd18ce7" :answer/id #uuid "a3458a6f-9c67-5e9e-bdae-7d70f0a69fe2" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37362/selection/150252746f1f5397433a49b44040f71daece1365213a9a0e5bd26b6f71e8e2c0" :answer/id #uuid "a1f2d51f-b847-5d55-b18a-a42942fcc046" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}2 \\\\ 2\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37362/selection" :answer-field/id #uuid "b2003b6f-0454-5988-8299-6a6315503fa4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37362/selection/0d0a010130ad61f8577d1183bfdbf0ccfc1140ce3a420463c83f45ed4dd18ce7" :answer-field/choices ["q-37362/selection/f59e087eec0b2575883acf5284fe289f5ca5852cd9432fe959a1062a18f5f934" "q-37362/selection/9be533740b2cc7082870cf218da4cd51fd91d86d9f03436750f56a10a13f4df9" "q-37362/selection/518af5df9b08af75f5a37717829d3d0cf8a84b92f48e13ca5f13b80a0ff40cd1" "q-37362/selection/0d0a010130ad61f8577d1183bfdbf0ccfc1140ce3a420463c83f45ed4dd18ce7" "q-37362/selection/150252746f1f5397433a49b44040f71daece1365213a9a0e5bd26b6f71e8e2c0"] :db/ensure [:answer-field/validate]} {:db/id "q-37362" :question/id #uuid "5b1eed05-d07c-590e-b279-39088f439f63" :question/math-academy-id "q-37362" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $N$ given that \n\n$$\nN[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]=[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}5 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $N:$\n\n$$\nN={{[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}5 & 0 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}2 & 1 \\\\ 1 & 2\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $N$ is diagonalizable. The eigenvalues of $N$ are ${\\lambda }_{1}=5$ and ${\\lambda }_{2}=-1$ and the corresponding eigenvectors are the columns of the matrix $P:$\n\n$\\,$ ${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37362/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5"] :knowledge-point/questions ["q-37362"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7133"] :question/problem "Find a $2 \\times 2$ matrix $C$ that has eigenvalues $\\lambda_1=1$ and $\\lambda_2=-4,$ and corresponding eigenvectors\n\n$$\n[\\begin{aligned}2 \\\\ -2\\end{aligned}]\n$$" :question/worked-solution "Since $\\mathcal{B}= \\{ \\mathbf{v}_1,\\mathbf{v}_2\\}$ is a basis of $\\mathbb{R}^2$ consisting of the eigenvectors of $C,$ then $C$ must be diagonalizable.\n\nSo, we can write $C=PDP^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $C,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order: \n\n$$\n[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]\n$$\n\nLet $[\\begin{aligned}2 & 1 \\\\ -2 & 1\\end{aligned}]$ Then\n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}2 & 1 \\\\ -2 & 1\\end{aligned}]}^{-1}=\\frac{1}{4}[\\begin{aligned}1 & -1 \\\\ 2 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}C & =\\frac{1}{4}[\\begin{aligned}2 & 1 \\\\ -2 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -4\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 2 & 2\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}2 & -4 \\\\ -2 & -4\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-\\frac{3}{2} & -\\frac{5}{2} \\\\ -\\frac{5}{2} & -\\frac{3}{2}\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5502"] :question/problem "Find $A^{100},$ where \n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$" :question/worked-solution "First,  notice that\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$\n\nSo, we have been given the following diagonalization of $A\\mathbin{:}$\n\n$$\n[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]\n$$\n\nSince $A=PDP^{-1},$ we can compute $A^k$ by using the formula \n\n$$\nA^{k} = PD^{k}P^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{A}^{100} & =P{D}^{100}{P}^{-1} \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}]{[\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}]}^{100}[\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}{1}^{100} & 0 \\\\ 0 & {0}^{100}\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 0 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}1 & 1 \\\\ 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 2 \\\\ -1 & -1\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5503"] :question/problem "Find the eigenvectors of the $2 \\times 2$ matrix $E,$ given that \n\n$$\n[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $E\\mathbin{:}$ \n\n$$\n[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]\n$$\n\nTherefore, $E$ is diagonalizable. The eigenvalues of $E$ are $\\lambda_1=3$ and $\\lambda_2=6$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}3 & 6 \\\\ 1 & 1\\end{aligned}]}^{-1}=\\frac{1}{-3}[\\begin{aligned}1 & -6 \\\\ -1 & 3\\end{aligned}]=[\\begin{aligned}-\\frac{1}{3} & 2 \\\\ \\frac{1}{3} & -1\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are\n\n$$\n[\\begin{aligned}-\\frac{1}{3} \\\\ \\frac{1}{3}\\end{aligned}]\n$$" :db/ensure [:question/validate]}]
