3eb94b43e3580e0fb7d70ba97970ad336" "q-86676/selection/6f07fc700eaedc86f3101ed22563f21789fd17925f4770abd61693a3e6449cb3"] :db/ensure [:answer-field/validate]} {:db/id "q-86676" :question/id #uuid "3f76ba1b-7ea5-5d91-91ae-a14e891b8be6" :question/math-academy-id "q-86676" :question/problem "Find a $2\\times 2$ matrix $G$ that has eigenvalues ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=2,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}3 \\\\ 5\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $G,$ then $G$ must be diagonalizable.\n\nSo, we can write $G=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $G,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nG={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}3 & 1 \\\\ 5 & 2\\end{aligned}].$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}3 & 1 \\\\ 5 & 2\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}]=[\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}].\\end{aligned}\n$$\n\n \n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}G & =[\\begin{aligned}3 & 1 \\\\ 5 & 2\\end{aligned}][\\begin{aligned}-1 & 0 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & 2 \\\\ -5 & 4\\end{aligned}][\\begin{aligned}2 & -1 \\\\ -5 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-16 & 9 \\\\ -30 & 17\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-86676/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e"] :knowledge-point/questions ["q-86676"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81210/selection/77665a0ee2b5aa375a776b10db2bcefe3b93197d6a43f558f60e39d6564e449a" :answer/id #uuid "54e8f14a-3a88-53d9-81b6-a823513c8955" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 3 \\\\ -8 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81210/selection/36daf255e8437d2e6233935690231eb541ed1a92404ade2884a9ff92b0ed8340" :answer/id #uuid "299bd6e2-a3bf-5ac8-9ff2-db442233cb35" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 & 2 \\\\ 4 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81210/selection/1de32204aa693764b8d591ada5ff326130fedc0116f2d97b19237b140687ab75" :answer/id #uuid "9d2c70d0-5558-5dc3-91f3-50938b0af1e8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & -2 \\\\ -4 & 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81210/selection/9e56f90747c128361fe7a17054f4760712e5ed71d8d9c21f37a7b57faf16861f" :answer/id #uuid "7cfe717e-f4c6-50ab-b810-ad2b79f27f9d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 0 \\\\ 0 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81210/selection/aeb6f38b2d0ac1f9836b16e9cb6ccaf1515b1d9d3ff79c84ac72de85fc0fef58" :answer/id #uuid "df575f48-2895-5f8d-b20a-3b0964b6e2d8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & 3 \\\\ 0 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81210/selection" :answer-field/id #uuid "c84b9105-d873-55e8-adf4-ca7492432404" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81210/selection/77665a0ee2b5aa375a776b10db2bcefe3b93197d6a43f558f60e39d6564e449a" :answer-field/choices ["q-81210/selection/77665a0ee2b5aa375a776b10db2bcefe3b93197d6a43f558f60e39d6564e449a" "q-81210/selection/36daf255e8437d2e6233935690231eb541ed1a92404ade2884a9ff92b0ed8340" "q-81210/selection/1de32204aa693764b8d591ada5ff326130fedc0116f2d97b19237b140687ab75" "q-81210/selection/9e56f90747c128361fe7a17054f4760712e5ed71d8d9c21f37a7b57faf16861f" "q-81210/selection/aeb6f38b2d0ac1f9836b16e9cb6ccaf1515b1d9d3ff79c84ac72de85fc0fef58"] :db/ensure [:answer-field/validate]} {:db/id "q-81210" :question/id #uuid "ed6cad5f-0721-57d9-b366-6ace4eed9438" :question/math-academy-id "q-81210" :question/problem "Find a $2\\times 2$ matrix $E$ that has eigenvalues ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=6,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}3 \\\\ 4\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}2 \\\\ 4\\end{aligned}].\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $E,$ then $E$ must be diagonalizable.\n\nSo, we can write $E=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $E,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nE={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}3 & 2 \\\\ 4 & 4\\end{aligned}].$ Then,\n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}3 & 2 \\\\ 4 & 4\\end{aligned}]}^{-1}=\\frac{1}{4}[\\begin{aligned}4 & -2 \\\\ -4 & 3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}E & =[\\begin{aligned}3 & 2 \\\\ 4 & 4\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & 6\\end{aligned}](\\frac{1}{4}[\\begin{aligned}4 & -2 \\\\ -4 & 3\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}12 & 12 \\\\ 16 & 24\\end{aligned}][\\begin{aligned}4 & -2 \\\\ -4 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 \\\\ -8 & 10\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81210/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e"] :knowledge-point/questions ["q-81210"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86680/selection/644b73f0eb63f98ce21fc72f01f5780c3a63220ec03433cd6cef17762a0f8f41" :answer/id #uuid "3eff7883-f932-5304-8e0f-f9232684000f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & -19 \\\\ 32 & -21\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86680/selection/12d2650cc8e8084f5789dd14428726dbc9e989fbd80ecfb96aa321a996fad66c" :answer/id #uuid "1d1b4959-c583-529a-9211-97adf3516fdc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & -1 \\\\ 3 & -21\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86680/selection/55e152a110b73f0704d00eb48bb346f36a1e24fcf8cd9d6085cfb044a590d72f" :answer/id #uuid "b64d0d91-39ef-53eb-87da-9a4c32ae929d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & -12 \\\\ 21 & -32\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86680/selection/fbde65173a31e2331fd8eaafd30471603243648c673a64eaaaabf97c9e1846bd" :answer/id #uuid "7af6bc2f-a185-5b7e-8bc5-db58066c2754" :answer/type :answer.type/math :answer/value "[\\begin{aligned}9 & -12 \\\\ 32 & -2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86680/selection/7ee2129f7b9e00267d5494619c8be7ee509c4c4869974132930f741542e27d03" :answer/id #uuid "2dba43ca-55b6-5a37-9f55-4b93cfee110c" :answer/type :answer.type/math :answer/value "[\\begin{aligned}19 & -12 \\\\ 32 & -21\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-86680/selection" :answer-field/id #uuid "4879d6ea-de0e-5b4a-a1fa-d6809380822a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86680/selection/7ee2129f7b9e00267d5494619c8be7ee509c4c4869974132930f741542e27d03" :answer-field/choice