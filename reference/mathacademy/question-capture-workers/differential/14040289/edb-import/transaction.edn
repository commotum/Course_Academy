ligned}9 & -15 \\\\ 12 & -30\\end{aligned}][\\begin{aligned}6 & -3 \\\\ -4 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}19 & -12 \\\\ 32 & -21\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-86680/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e"] :knowledge-point/questions ["q-86680"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37314"] :question/problem "Find a $2\\times 2$ matrix $F$ that has eigenvalues ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-2,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}5 \\\\ -4\\end{aligned}]\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $F,$ then $F$ must be diagonalizable.\n\nSo, we can write $F=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $F,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nF={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}-1 & 5 \\\\ 1 & -4\\end{aligned}].$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}-1 & 5 \\\\ 1 & -4\\end{aligned}]}^{-1}=\\frac{1}{-1}[\\begin{aligned}-4 & -5 \\\\ -1 & -1\\end{aligned}]=[\\begin{aligned}4 & 5 \\\\ 1 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}F & =[\\begin{aligned}-1 & 5 \\\\ 1 & -4\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}4 & 5 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -10 \\\\ 4 & 8\\end{aligned}][\\begin{aligned}4 & 5 \\\\ 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-26 & -30 \\\\ 24 & 28\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-81215/selection/46ace8b69ae12acc20ee0f3ba150dc42adc9e218bdf14d60f8a0b265aa99bd67" :answer/id #uuid "a53f5e02-540f-5c3a-80f3-64c3ee565714" :answer/type :answer.type/math :answer/value "[\\begin{aligned}13 & -12 \\\\ 10 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81215/selection/1f1b094ef228f19dda424a8031bc8857a6b5e637aaddff63d21b666787ec785d" :answer/id #uuid "3c6d8c26-44b3-5e4f-ad6d-e6633a6be5c2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 4 \\\\ 5 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81215/selection/f23714efed2635fbdb3e9b089dca3b9833bcb89045a050d549a9eae11c20f17f" :answer/id #uuid "4cb42baf-1488-57ad-92e7-f80031b92f30" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18 & 4 \\\\ 15 & 4\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81215/selection/43d35dccae75278d19faf364260b1ba3059e563378fda0ced14dbdeaf7ff7447" :answer/id #uuid "de0b2e39-08ed-5540-bf1c-48f2d1210f61" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & -13 \\\\ 9 & 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81215/selection/c9726a8738228481a7f9ce9034bdc64ee7e2c794e8bb695566de884cf82257d2" :answer/id #uuid "8a5ec694-89a2-55cf-abf7-6061dd86b269" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & -4 \\\\ -5 & 6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81215/selection" :answer-field/id #uuid "8f06b6d9-2515-534f-8422-8ee5a96cb474" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81215/selection/46ace8b69ae12acc20ee0f3ba150dc42adc9e218bdf14d60f8a0b265aa99bd67" :answer-field/choices ["q-81215/selection/46ace8b69ae12acc20ee0f3ba150dc42adc9e218bdf14d60f8a0b265aa99bd67" "q-81215/selection/1f1b094ef228f19dda424a8031bc8857a6b5e637aaddff63d21b666787ec785d" "q-81215/selection/f23714efed2635fbdb3e9b089dca3b9833bcb89045a050d549a9eae11c20f17f" "q-81215/selection/43d35dccae75278d19faf364260b1ba3059e563378fda0ced14dbdeaf7ff7447" "q-81215/selection/c9726a8738228481a7f9ce9034bdc64ee7e2c794e8bb695566de884cf82257d2"] :db/ensure [:answer-field/validate]} {:db/id "q-81215" :question/id #uuid "364858a4-93e6-583e-af87-93429d43e74e" :question/math-academy-id "q-81215" :question/problem "Find a $2\\times 2$ matrix $S$ that has eigenvalues ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=1,$ and corresponding eigenvectors\n\n$$\n{v}_{1}=[\\begin{aligned}6 \\\\ 5\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "Since $B={{v}_{1},{v}_{2}}$ is a basis of ${R}^{2}$ consisting of the eigenvectors of $S,$ then $S$ must be diagonalizable.\n\nSo, we can write $S=PD{P}^{-1},$ where $P$ is a matrix whose columns are the eigenvectors of $S,$ and $D$ is a diagonal matrix whose entries are the eigenvalues in the corresponding order:\n\n$$\nS={{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}| & | \\\\ {v}_{1} & {v}_{2} \\\\ | & |\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nLet $P=[\\begin{aligned}6 & 1 \\\\ 5 & 1\\end{aligned}].$ Then, \n\n$$\n\\begin{aligned}{P}^{-1} & ={[\\begin{aligned}6 & 1 \\\\ 5 & 1\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}1 & -1 \\\\ -5 & 6\\end{aligned}]=[\\begin{aligned}1 & -1 \\\\ -5 & 6\\end{aligned}].\\end{aligned}\n$$\n\n \n\nTherefore, carrying out the necessary matrix multiplication, we obtain\n\n$$\n\\begin{aligned}S & =[\\begin{aligned}6 & 1 \\\\ 5 & 1\\end{aligned}][\\begin{aligned}3 & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ -5 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}18 & 1 \\\\ 15 & 1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ -5 & 6\\end{aligned}] \\\\  & =[\\begin{aligned}13 & -12 \\\\ 10 & -9\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81215/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "50afb9e4-b28b-5394-bc2b-eff9549e4a9e"] :knowledge-point/questions ["q-81215"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37601/selection/bd623194cf25b3702ecb5e875f6ca1e7870b7a8503aae740f8f8e419d75e4bee" :answer/id #uuid "465bf360-d9fd-5977-9449-6bdf5d4ebfd3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}24 & -3 \\\\ -1 & 12\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37601/selection/cadbbad35bf09f1b9fe5137b9430d01afebffecf5d3c98dcfeb284f42238ac68" :answer/id #uuid "2cd6e85d-f4fc-549e-acfc-69f07c6a19c7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-32 & 72 \\\\ -24 & 52\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37601/selection/e748693ec0be9eac5351c624c2a97db27e8413e53315a4cd57ada990f83d7a9a" :answer/id #uuid "41560e0d-2e1f-5429-8b60-a3c0fcfc96c5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 48 \\\\ 12 & 32\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37601/selection/8625bd858d077e75667ab07afa79eccb8932c4ea7151fe068aa5f00751b722fb" :answer/id #uuid "08dc70a3-a710-5069-a3e9-0688a52c1e5e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 0 \\\\ 0 & 16\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37601/selection/f5e8baf4f66220df378ee733da8a27d7109c19b2d32405f5cc78406ea4f620f7" :answer/id #uuid "cb75ef29-4aff-5885-8af1-79121620c59b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-32 & -12 \\\\ 12 & -13\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-37601/selection" :answer-field/id #uuid "7285363a-7065-5a51-ae2e-7335e88d4dfa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37601/selection/cadbbad35bf09