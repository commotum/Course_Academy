igned}][\\begin{aligned}2 & -3 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}{2}^{2} & 0 \\\\ 0 & {2}^{4}\\end{aligned}][\\begin{aligned}2 & -3 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & 16\\end{aligned}][\\begin{aligned}2 & -3 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}8 & 48 \\\\ 4 & 32\\end{aligned}][\\begin{aligned}2 & -3 \\\\ -1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-32 & 72 \\\\ -24 & 52\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-37601/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "634729e9-7633-52d8-99fa-b00fc9cbe96a"] :knowledge-point/questions ["q-37601"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140132/selection/79fa998fe81bffad438815828d71cdc824661a2e2ac28cd251ef895048d27912" :answer/id #uuid "62899d69-def9-514f-9db2-dea6f520dc99" :answer/type :answer.type/math :answer/value "[\\begin{aligned}15 & 6 \\\\ -12 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140132/selection/fc716e2c7d7bf1ca6a872ae2d6bbac9c0787257960a448144578f41deee4dd2a" :answer/id #uuid "33b3d3a2-eae4-500e-92a2-bf89207c501f" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 9 \\\\ -24 & -3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140132/selection/0651104505630216ab8defa0fcf280d82b1fd91f3f1e7131620d6a3198d12fa6" :answer/id #uuid "ee2e3afd-7fde-5290-8795-e227ca576911" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6 & 3 \\\\ -12 & -9\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140132/selection/8f3784518d39be71c3feda3bd24185066cecd62a7663dd5a9f45774073d42c2e" :answer/id #uuid "79f61a17-ced2-5943-9d14-49c1cc1b5ea6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}12 & 6 \\\\ -18 & -21\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-140132/se