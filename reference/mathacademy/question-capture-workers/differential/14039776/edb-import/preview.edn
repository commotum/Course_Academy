\\text{d}t}(-t) \\\\ \\frac{\\text{d}}{\\text{d}t}{e}^{2t}\\end{aligned}]=[\\begin{aligned}\\frac{1}{t} \\\\ -1 \\\\ 2{e}^{2t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)g(t))^{′} & ={u}^{′}(t)g(t)+u(t){g}^{′}(t) \\\\  & =1\\cdot [\\begin{aligned}\\operatorname{ln}⁡t \\\\ -t \\\\ {e}^{2t}\\end{aligned}]+t\\cdot [\\begin{aligned}\\frac{1}{t} \\\\ -1 \\\\ 2{e}^{2t}\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{ln}⁡t \\\\ -t \\\\ {e}^{2t}\\end{aligned}]+[\\begin{aligned}1 \\\\ -t \\\\ 2t{e}^{2t}\\end{aligned}] \\\\  & =[\\begin{aligned}1+\\operatorname{ln}⁡t \\\\ -2t \\\\ (2t+1){e}^{2t}\\end{aligned}].\\end{aligned}\n$$" 13194139534722 true] [17592186114885 1145 "Using the scalar function multiple rule, we have\n\n$$\n\\big(u(t) \\mathbf g(t) \\big)' = u'(t) \\mathbf{g}(t) + u(t) \\mathbf{g}'(t)\n$$\n\nLet's find $\\mathbf g'(t)$ and $u'(t)$, as follows:\n\n$$\n\\begin{aligned}\ng^{\\prime }(t) &= \\begin{bmatrix}\\frac{d}{dt}(\\ln t) \\\\ \\frac{d}{dt}(-t) \\\\ \\frac{d}{dt}e^{2t}\\end{bmatrix} = \\begin{bmatrix}\\frac{1}{t} \\\\ -1 \\\\ 2e^{2t}\\end{bmatrix} \\\\\nu^{\\prime }(t) &= \\frac{d}{dt}(t) = 1\n\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}\n(u(t)g(t))^{\\prime } &= u^{\\prime }(t)g(t) + u(t)g^{\\prime }(t) \\\\\n&= 1 \\cdot \\begin{bmatrix}\\ln t \\\\ -t \\\\ e^{2t}\\end{bmatrix} + t \\cdot \\begin{bmatrix}\\frac{1}{t} \\\\ -1 \\\\ 2e^{2t}\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\ln t \\\\ -t \\\\ e^{2t}\\end{bmatrix} + \\begin{bmatrix}1 \\\\ -t \\\\ 2te^{2t}\\end{bmatrix} \\\\\n&= \\begin{bmatrix}1 + \\ln t \\\\ -2t \\\\ (2t + 1)e^{2t}\\end{bmatrix}\n\\end{aligned}\n$$" 13194139534722 false] [17592186114886 1100 "Find $(\\mathbf f \\circ u)'(t)$, if $\\mathbf f(u) = \\ln u \\, \\mathbf i + (u^2+5) \\, \\mathbf j + 4u \\, \\mathbf k$ and $u(t) =2t^3$." 13194139534722 false] [17592186114886 1100 "Find $(\\mathbf f \\circ u)'(t),$ if 