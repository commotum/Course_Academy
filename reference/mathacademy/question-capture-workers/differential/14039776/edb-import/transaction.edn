986dafdf53a89e99c5dd6ec23dc1da9" "q-128458/selection/ec9618ca1c0e488182c179700e3a594e1448afa4b855e48bbc3dc38c485d697a"] :db/ensure [:answer-field/validate]} {:db/id "q-128458" :question/id #uuid "d53a4971-40a3-5d73-9c6b-7c763e59097b" :question/math-academy-id "q-128458" :question/problem "Find the value of $(2f(t)+5g(t))^{′}$ at $t=1,$ where\n\n$$\n\\begin{aligned}f(t)=[\\begin{aligned}2\\sqrt{3+t} \\\\ \\operatorname{cos}⁡(t-1) \\\\ 1\\end{aligned}],\\,g(t)=[\\begin{aligned}2t-3 \\\\ {t}^{2} \\\\ (t+1)^{2}\\end{aligned}]\\end{aligned}\n$$" :question/worked-solution "By the sum rule, we have \n \n\n$$\n(2f(t)+5g(t))^{′}=2{f}^{′}(t)+5{g}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}\\,(2\\sqrt{3+t}) \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(t-1)) \\\\ \\frac{\\text{d}}{\\text{d}t}(1)\\end{aligned}]=[\\begin{aligned}\\frac{1}{\\sqrt{3+t}} \\\\ -\\operatorname{sin}⁡(t-1) \\\\ 0\\end{aligned}] \\\\ {g}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(2t-3) \\\\ \\frac{\\text{d}}{\\text{d}t}({t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}((t+1)^{2})\\end{aligned}]=[\\begin{aligned}2 \\\\ 2t \\\\ 2(t+1)\\end{aligned}]\\end{aligned}\n$$\n\nHence , we get\n\n$$\n\\begin{aligned}(2f(1)+5g(1))^{′} & =2{f}^{′}(1)+5{g}^{′}(1) \\\\  & =2[\\begin{aligned}\\frac{1}{\\sqrt{3+1}} \\\\ -\\operatorname{sin}⁡(1-1) \\\\ 0\\end{aligned}]+5[\\begin{aligned}2 \\\\ 2(1) \\\\ 2(1+1)\\end{aligned}] \\\\  & =2[\\begin{aligned}\\frac{1}{2} \\\\ 0 \\\\ 0\\end{aligned}]+5[\\begin{aligned}2 \\\\ 2 \\\\ 4\\end{aligned}] \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 0\\end{aligned}]+[\\begin{aligned}10 \\\\ 10 \\\\ 20\\end{aligned}] \\\\  & =[\\begin{aligned}11 \\\\ 10 \\\\ 20\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128458/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656"] :knowledge-point/questions ["q-128458"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70681/selection/7ab987fafd3e535b880deb02259430d13b26bb41a4a149d940480df8c7037faf" :answer/id #uuid "a6d5b0f9-2539-56b6-9648-0c55489f2f55" :answer/type :answer.type/math :answer/value "⟨\\frac{1+\\sqrt{t}}{\\sqrt{t}},\\,\\frac{1}{t},\\,16{t}^{4}⟩" :db/ensure [:answer/validate]} {:db/id "q-70681/selection/b1aa2463fdd589ec449663ad6a43234ee150f69e320e62579f27d5766210cf5a" :answer/id #uuid "248144a4-5195-507c-8ead-000ee1a6fcf7" :answer/type :answer.type/math :answer/value "⟨\\frac{4}{\\sqrt{t}},\\,\\frac{t-4}{{t}^{2}},\\,4{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-70681/selection/a97a44ed064c6460cadf235c8eae72ada8c9193efb6f3a72509372552961a499" :answer/id #uuid "470c60d0-d3cc-5b8c-a4e2-3b13f679e832" :answer/type :answer.type/math :answer/value "⟨2\\sqrt{t},\\,\\frac{{t}^{2}+1}{t},\\,2{t}^{4}⟩" :db/ensure [:answer/validate]} {:db/id "q-70681/selection/efeb8379c681f5d3dc1a49aa4c6a193bf359e2ccbca931d5ea4edf447efd8969" :answer/id #uuid "b3341c7a-9b22-5378-a166-37514edd7b41" :answer/type :answer.type/math :answer/value "⟨\\frac{1+8\\sqrt{t}}{2\\sqrt{t}},\\,\\frac{t-4}{{t}^{2}},\\,16{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-70681/selection/2f019330a4e9dc72e89c7edbc548ac2caa5c03fce0629f81d76dc92b8ba4e3f3" :answer/id #uuid "05484b82-e643-5284-8e00-d4814d2288e3" :answer/type :answer.type/math :answer/value "⟨4\\sqrt{t},\\,\\frac{1}{{t}^{2}},\\,8t⟩" :db/ensure [:answer/validate]} {:db/id "q-70681/selection" :answer-field/id #uuid "83f07d3e-2650-56d7-8ae3-434d0181b857" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70681/selection/efeb8379c681f5d3dc1a49aa4c6a193bf359e2ccbca931d5ea4edf447efd8969" :answer-field/choices ["q-70681/selection/7ab987fafd3e535b880deb02259430d13b26bb41a4a149d940480df8c7037faf" "q-70681/selection/b1aa2463fdd589ec449663ad6a43234ee150f69e320e62579f27d5766210cf5a" "q-70681/selection/a97a44ed064c6460cadf235c8eae72ada8c9193efb6f3a72509372552961a499" "q-70681/selection/efeb8379c681f5d3dc1a49aa4c6a193bf359e2ccbca931d5ea4edf447efd8969" "q-70681/selection/2f019330a4e9dc72e89c7edbc548ac2caa5c03fce0629f81d76dc92b8ba4e3f3"] :db/ensure [:answer-field/validate]} {:db/id "q-70681" :question/id #uuid "6942209a-90ad-5fb0-92e6-b66937204d70" :question/math-academy-id "q-70681" :question/problem "Differentiate $f(t)+4g(t)$ with respect to $t$, given that \n\n$$\n\\begin{aligned}f(t) & =⟨\\sqrt{t},\\,\\operatorname{ln}⁡t,\\,2⟩ \\\\ g(t) & =⟨t,\\,\\frac{1}{t},\\,{t}^{4}⟩\\end{aligned}\n$$" :question/worked-solution "Using the constant multiple rule and the sum rule, we have\n\n$$\n(f(t)+4g(t))^{′}={f}^{′}(t)+4{g}^{′}(t).\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2)⟩ \\\\  & =⟨\\frac{1}{2\\sqrt{t}},\\,\\frac{1}{t},\\,0⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{4})⟩ \\\\  & =⟨1,\\,-\\frac{1}{{t}^{2}},\\,4{t}^{3}⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f(t)+4g(t))^{′} & ={f}^{′}(t)+4{g}^{′}(t) \\\\  & =⟨\\frac{1}{2\\sqrt{t}},\\,\\frac{1}{t},\\,0⟩+4⟨1,\\,-\\frac{1}{{t}^{2}},\\,4{t}^{3}⟩ \\\\  & =⟨\\frac{1}{2\\sqrt{t}},\\,\\frac{1}{t},\\,0⟩+⟨4,\\,-\\frac{4}{{t}^{2}},\\,16{t}^{3}⟩ \\\\  & =⟨\\frac{1}{2\\sqrt{t}}+4,\\,\\frac{1}{t}-\\frac{4}{{t}^{2}},\\,0+16{t}^{3}⟩ \\\\  & =⟨\\frac{1+8\\sqrt{t}}{2\\sqrt{t}},\\,\\frac{t-4}{{t}^{2}},\\,16{t}^{3}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70681/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656"] :knowledge-point/questions ["q-70681"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128452/selection/b363533732ad6f742000dbacde91bd4f37ad6a0c6808173196b0007e9d9fe2a0" :answer/id #uuid "a6ef94a1-7bb3-5151-9fa4-219556ec4305" :answer/type :answer.type/math :answer/value "⟨-1,4\\pi ,1⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/selection/735e89ca11bab9490dcf1bbe15aa652f079c458af811b78e1c4a08b0420cd773" :answer/id #uuid "7b6bb984-cc93-594c-a50a-8758d6705134" :answer/type :answer.type/math :answer/value "⟨-1,\\pi ,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/selection/f38bc1bd8fe6047e612df82b12c3c5f97b1053a5d8df8b27cf73bb397efae4ab" :answer/id #uuid "d287f358-b8b4-5b30-b0cf-4ec44342fb4d" :answer/type :answer.type/math :answer/value "⟨1,1,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/selection/af25ba77ea789dce1fafb2d1c669ff97a6b4984c75dcd56885ebdb0fdb3ce5bb" :answer/id #uuid "9eaf2a1d-32c6-53c2-a02e-71ffd3d34809" :answer/type :answer.type/math :answer/value "⟨-1,0,-2⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/selection/798ff538b6b54a74e478ad381cb573c97d85526617170f7a1c84e49fc32bb8af" :answer/id #uuid "7363486d-b4cc-5260-9758-a74e6f12f2e9" :answer/type :answer.type/math :answer/value "⟨-1,0,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-128452/selection" :answer-field/id #uuid "bdd9714f-d529-5a8e-9a9e-6f07a2c5dc7d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128452/selection/798ff538b6b54a74e478ad381cb573c97d85526617170f7a1c84e49fc32bb8af" :answer-field/choices ["q-128452/selection/b363533732ad6f742000dbacde91bd4f37ad6a0c6808173196b0007e9d9fe2a0" "q-128452/selection/735e89ca11bab9490dcf1bbe15aa652f079c458af811b78e1c4a08b0420cd773" "q-128452/selection/f38bc1bd8fe6047e612df82b12c3c5f97b1053a5d8df8b27cf73bb397efae4ab" "q-128452/selection/af25ba77ea789dce1fafb2d1c669ff97a6b4984c75dcd56885ebdb0fdb3ce5bb" "q-128452/selection/798ff538b6b54a74e478ad381cb573c97d85526617170f7a1c84e49fc32bb8af"] :db/ensure [:answer-field/validate]} {:db/id "q-128452" :question/id #uuid "0cef1288-682b-5449-bd6c-f4cbfcbde18f" :question/math-academy-id "q-128452" :question/problem "Find the value of $(2f(t)-g(t))^{′}$ at $t=-1,$ if \n\n$$\n\\begin{aligned}f(t) & =⟨8\\sqrt{3-t},\\,\\operatorname{sin}⁡(\\pi t),\\,\\operatorname{ln}⁡(2t)⟩, \\\\ g(t) & =⟨{t}^{2}-t,\\,\\pi {t}^{2},\\,1-{t}^{2}⟩.\\end{aligned}\n$$" :question/worked-solution "First, notice that\n\n$$\n(2f(t)-g(t))^{′}=2{f}^{′}(t)-{g}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(8\\sqrt{3-t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(\\pi t)),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(2t))⟩ \\\\  & =⟨-\\frac{4}{\\sqrt{3-t}},\\,\\pi \\operatorname{cos}⁡(\\pi t),\\,\\frac{1}{t}⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t),\\,\\frac{\\text{d}}{\\text{d}t}(\\pi {t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})⟩ \\\\  & =⟨2t-1,\\,2\\pi t,\\,-2t⟩\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(2f(-1)-g(-1))^{′} & =2{f}^{′}(-1)-{g}^{′}(-1) \\\\  & =2⟨-\\frac{4}{\\sqrt{3-(-1)}},\\,\\pi \\operatorname{cos}⁡(-\\pi ),\\,\\frac{1}{(-1)}⟩-⟨2(-1)-1,\\,2\\pi (-1),\\,-2(-1)⟩ \\\\  & =2⟨-2,-\\pi ,-1⟩-⟨-3,-2\\pi ,2⟩ \\\\  & =⟨-4,-2\\pi ,-2⟩-⟨-3,-2\\pi ,2⟩ \\\\  & =⟨-1,0,-4⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128452/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656"] :knowledge-point/questions ["q-128452"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127998/selection/b91760f9338a1d2e8839e9ddff53d71a8b795178637a3c833b1a035728d6af09" :answer/id #uuid "12a7c4c0-521d-5b22-8f03-585838f052b3" :answer/type :answer.type/math :answer/value "⟨-1,\\,2t-2,\\,3{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-127998/selection/a5bce40d093ccdeecc8f463277466377d7d99ee9b07ba8576c4d4d080461bda9" :answer/id #uuid "41c31433-12c8-5113-bb33-8079400d618f" :answer/type :answer.type/math :answer/value "⟨-3,\\,2t+1,\\,3{t}^{2}+2t⟩" :db/ensure [:answer/validate]} {:db/id "q-127998/selection/1df1d64c3e7092f93522ebc7a80203244a270fe3801ba68461cf926b24463a9d" :answer/id #uuid "6272e646-6faf-5cbf-9aa8-bfa1c9a1a5a8" :answer/type :answer.type/math :answer/value "⟨-2,\\,-2t,\\,2t-2⟩" :db/ensure [:answer/validate]} {:db/id "q-127998/selection/e420439f4c2b4721d85d92b77a645affc90677ddbe1770b78427a7ee610bc123" :answer/id #uuid "2fc264b1-b837-534c-ae0b-bb800191e149" :answer/type :answer.type/math :answer/value "⟨-1,\\,2t-2,\\,3{t}^{2}+2t-2⟩" :db/ensure [:answer/validate]} {:db/id "q-127998/selection/6d707d16a309862acae621006c5d45d271d53ccfc6c530b0aeac8cf50dfb0982" :answer/id #uuid "61492250-b27b-5c47-b317-b118914c4bd0" :answer/type :answer.type/math :answer/value "⟨-1,\\,2t,\\,{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-127998/selection" :answer-field/id #uuid "41aec396-46ce-51ab-bf41-4cb56972babe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127998/selection/e420439f4c2b4721d85d92b77a645affc90677ddbe1770b78427a7ee610bc123" :answer-field/choices ["q-127998/selection/b91760f9338a1d2e8839e9ddff53d71a8b795178637a3c833b1a035728d6af09" "q-127998/selection/a5bce40d093ccdeecc8f463277466377d7d99ee9b07ba8576c4d4d080461bda9" "q-127998/selection/1df1d64c3e7092f93522ebc7a80203244a270fe3801ba68461cf926b24463a9d" "q-127998/selection/e420439f4c2b4721d85d92b77a645affc90677ddbe1770b78427a7ee610bc123" "q-127998/selection/6d707d16a309862acae621006c5d45d271d53ccfc6c530b0aeac8cf50dfb0982"] :db/ensure [:answer-field/validate]} {:db/id "q-127998" :question/id #uuid "1e49dfe3-04a3-591e-9ea0-48737f115840" :question/math-academy-id "q-127998" :question/problem "Differentiate $f(t)+g(t)$ with respect to $t$, given that \n\n$$\n\\begin{aligned}f(t) & =⟨1-2t,\\,{t}^{2},\\,(t-1)^{2}⟩, \\\\ g(t) & =⟨t+1,\\,1-2t,\\,{t}^{3}⟩\\end{aligned}\n$$" :question/worked-solution "By the sum rule, we have\n\n$$\n(f(t)+g(t))^{′}={f}^{′}(t)+{g}^{′}(t).\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1-2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}((t-1)^{2})⟩ \\\\  & =⟨-2,\\,2t,\\,2(t-1)⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(t+1),\\,\\frac{\\text{d}}{\\text{d}t}(1-2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3})⟩ \\\\  & =⟨1,\\,-2,\\,3{t}^{2}⟩\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(f(t)+g(t))^{′} & ={f}^{′}(t)+{g}^{′}(t) \\\\  & =⟨-2,\\,2t,\\,2t-2⟩+⟨1,\\,-2,\\,3{t}^{2}⟩ \\\\  & =⟨-1,\\,2t-2,\\,3{t}^{2}+2t-2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656"] :knowledge-point/questions ["q-127998"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32503/selection/e227a2e2c34a54a6095994551be89237d59f79fa0ea31959ea1b1588c2c07655" :answer/id #uuid "33425daf-de81-52c8-a41e-ea1040b0a9d8" :answer/type :answer.type/math :answer/value "⟨t-1,0,t+1⟩" :db/ensure [:answer/validate]} {:db/id "q-32503/selection/d1927dd8f2c05c02673da81e86db8a6bc9303a450ff810a343f9d65837258578" :answer/id #uuid "95fe6746-9e7e-5186-8569-90337a4cf20b" :answer/type :answer.type/math :answer/value "⟨-1,0,1⟩" :db/ensure [:answer/validate]} {:db/id "q-32503/selection/b36ceda6ac3e6f00781480e0f67a77e44f4b57e90760a455081b4691e2f9d293" :answer/id #uuid "86b9e636-95ff-5f96-96da-479f305b5e98" :answer/type :answer.type/math :answer/value "⟨-2t-1,0,2t+1⟩" :db/ensure [:answer/validate]} {:db/id "q-32503/selection/153733e722ae83c4743addbd38313bab4aaad36e5c38f15f209157a080b42585" :answer/id #uuid "cebd29e4-87cb-572b-af0f-e2f507cdff45" :answer/type :answer.type/math :answer/value "⟨-2t,0,2t⟩" :db/ensure [:answer/validate]} {:db/id "q-32503/selection/fdb4cc2a51d29bb1bf9b91e7bb1a4e3bf670d119afb93784c7facefbe2d9d07e" :answer/id #uuid "aa876634-6b62-