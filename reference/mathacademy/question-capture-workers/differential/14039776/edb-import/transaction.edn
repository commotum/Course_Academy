2t⟩ \\\\  & =⟨-2t-1,\\,0,\\,2t+1⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32503/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656"] :knowledge-point/questions ["q-32503"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71230/selection/d1f7c243a422227b0559165f69f34d84d2da71d6d28308853ed533ae87daa34b" :answer/id #uuid "f83193ff-79e3-5957-8133-1271d5f93bc7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1-{t}^{2}){e}^{t} \\\\ 8t \\\\ (t+{t}^{2}){e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71230/selection/d46a5e60b6626f80a9fd378cbac57329ffe62ef2a5f4435ddaf555c172c56d2b" :answer/id #uuid "b5cf90ca-8fb4-531d-84f4-9a72ecd5ecd0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3t{e}^{t} \\\\ -8t \\\\ -3t{e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71230/selection/786c3c0229843f0b81d80ddb75a67d73fad2c44b3e3fad58668aae1aeb47d769" :answer/id #uuid "832905e6-89d2-51f6-bbcf-7292d3c655a5" :answer/type :answer.type/math :answer/value "[\\begin{aligned}({t}^{2}+{t}^{3}){e}^{t} \\\\ 4t \\\\ {t}^{3}{e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71230/selection/6adbcf8b7b8255db015ca522d37139517d950f7e21cf6833c544f6d8d91a5b2a" :answer/id #uuid "c09beb1e-6b5c-56d7-b309-e875013fcead" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71230/selection/4e3b34616d33c7e67625f8334f9c034577b83c3356f29ec1fe608a8fa58dab00" :answer/id #uuid "6aeeda8b-f3e7-50f2-a525-f9cb1e45a466" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3{t}^{3}{e}^{t} \\\\ -16t \\\\ -{t}^{3}{e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71230/selection" :answer-field/id #uuid "e1767873-42c2-57e8-b756-71d928f53399" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71230/selection/6adbcf8b7b8255db015ca522d37139517d950f7e21cf6833c544f6d8d91a5b2a" :answer-field/choices ["q-71230/selection/d1f7c243a422227b0559165f69f34d84d2da71d6d28308853ed533ae87daa34b" "q-71230/selection/d46a5e60b6626f80a9fd378cbac57329ffe62ef2a5f4435ddaf555c172c56d2b" "q-71230/selection/786c3c0229843f0b81d80ddb75a67d73fad2c44b3e3fad58668aae1aeb47d769" "q-71230/selection/6adbcf8b7b8255db015ca522d37139517d950f7e21cf6833c544f6d8d91a5b2a" "q-71230/selection/4e3b34616d33c7e67625f8334f9c034577b83c3356f29ec1fe608a8fa58dab00"] :db/ensure [:answer-field/validate]} {:db/id "q-71230" :question/id #uuid "9d3825fa-4a39-5efb-9247-5f4f19ce4d38" :question/math-academy-id "q-71230" :question/problem "Find ${(u(t)f(t))}^{′}$ where $f(t)=[\\begin{aligned}{e}^{t} \\\\ 8 \\\\ {e}^{-t}\\end{aligned}]$ and $u(t)={t}^{2}.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n{(u(t)f(t))}^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({e}^{t}) \\\\ \\frac{\\text{d}}{\\text{d}t}(8) \\\\ \\frac{\\text{d}}{\\text{d}t}({e}^{-t})\\end{aligned}]=[\\begin{aligned}{e}^{t} \\\\ 0 \\\\ -{e}^{-t}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{(u(t)f(t))}^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =2t[\\begin{aligned}{e}^{t} \\\\ 8 \\\\ {e}^{-t}\\end{aligned}]+{t}^{2}[\\begin{aligned}{e}^{t} \\\\ 0 \\\\ -{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{aligned}2t{e}^{t} \\\\ 16t \\\\ 2t{e}^{-t}\\end{aligned}]+[\\begin{aligned}{t}^{2}{e}^{t} \\\\ 0 \\\\ -{t}^{2}{e}^{-t}\\end{aligned}] \\\\  & =[\\begin{aligned}(2t+{t}^{2}){e}^{t} \\\\ 16t \\\\ (2t-{t}^{2}){e}^{-t}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71230/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc"] :knowledge-point/questions ["q-71230"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128477/selection/0e70e297d6e06f2a33a5314fb4b5c9e342f285b1261d946e8c88e76fca40812c" :answer/id #uuid "810eba93-bafe-55fa-946a-f1cd36da1086" :answer/type :answer.type/math :answer/value "⟨{t}^{2},\\,5\\sqrt{t},\\,3{t}^{2}\\sqrt{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128477/selection/a97d410fc05d1088a756f4377d987c5d283101865f5ee4376ed9305aef3b9d47" :answer/id #uuid "a2f00692-91aa-5bed-a81d-6aa2758406e9" :answer/type :answer.type/math :answer/value "⟨1,\\,2t\\sqrt{t},\\,\\sqrt{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128477/selection/72b0d5b823b967c18b8bdb822101616511e5f00c84a43b7defe01c684e225f4a" :answer/id #uuid "992afb58-96db-50ba-a119-ed5b31ddfea7" :answer/type :answer.type/math :answer/value "⟨2,\\,5t\\sqrt{t},\\,3\\sqrt{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128477/selection/0018aa7340ca940ff467402698829e6d7d779a1788888e6703f9907d89e6dde8" :answer/id #uuid "c44db689-2e72-5d37-a789-ef9aaf267cde" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{\\sqrt{t}},\\,5t\\sqrt{t},\\,3\\sqrt{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128477/selection/0ae6dfe9af0d029f416eb79cd88759ed673927b37d24ced82006e90571b8c1f2" :answer/id #uuid "e86dbad6-c367-5b18-b949-a66a00630e64" :answer/type :answer.type/math :answer/value "⟨2t,\\,\\sqrt{t},\\,\\sqrt{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128477/selection" :answer-field/id #uuid "7f44686b-d66f-52c3-85fa-0a4c59229667" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128477/selection/72b0d5b823b967c18b8bdb822101616511e5f00c84a43b7defe01c684e225f4a" :answer-field/choices ["q-128477/selection/0e70e297d6e06f2a33a5314fb4b5c9e342f285b1261d946e8c88e76fca40812c" "q-128477/selection/a97d410fc05d1088a756f4377d987c5d283101865f5ee4376ed9305aef3b9d47" "q-128477/selection/72b0d5b823b967c18b8bdb822101616511e5f00c84a43b7defe01c684e225f4a" "q-128477/selection/0018aa7340ca940ff467402698829e6d7d779a1788888e6703f9907d89e6dde8" "q-128477/selection/0ae6dfe9af0d029f416eb79cd88759ed673927b37d24ced82006e90571b8c1f2"] :db/ensure [:answer-field/validate]} {:db/id "q-128477" :question/id #uuid "2f602a22-c320-5e1b-8210-46c053005f25" :question/math-academy-id "q-128477" :question/problem "Find  $(u(t)g(t))^{′}$ where $g(t)=⟨\\sqrt{t},\\,{t}^{2},\\,t⟩$ and $u(t)=2\\sqrt{t}.$" :question/worked-solution "By the scalar function multiple rule, we have\n \n\n$$\n(u(t)g(t))^{′}=u(t){g}^{′}(t)+{u}^{′}(t)g(t).\n$$\n\nLet's find ${u}^{′}(t)$ and ${g}^{′}(t).$ \n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨\\frac{1}{2\\sqrt{t}},\\,2t,\\,1⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{t}) \\\\  & =\\frac{1}{\\sqrt{t}}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)g(t))^{′} & =u(t){g}^{′}(t)+{u}^{′}(t)g(t) \\\\  & =2\\sqrt{t}⟨\\frac{1}{2\\sqrt{t}},\\,2t,\\,1⟩+\\frac{1}{\\sqrt{t}}⟨\\sqrt{t},\\,{t}^{2},\\,t⟩ \\\\  & =⟨1,\\,4t\\sqrt{t},\\,2\\sqrt{t}⟩+⟨1,\\,t\\sqrt{t},\\,\\sqrt{t}⟩ \\\\  & =⟨2,\\,5t\\sqrt{t},\\,3\\sqrt{t}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128477/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc"] :knowledge-point/questions ["q-128477"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71227/selection/5654161497cf7a41e3c19ac3b8b1298cde61aba13656142bc2669272b23ce28c" :answer/id #uuid "27660b59-ff99-575e-8ae7-fc60725e2abe" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3t{e}^{3t} \\\\ 4t{e}^{4t} \\\\ 5t{e}^{5t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-71227/selection/1f64803382457080ec68ddad3d3457d846e8569d11b626ca091fba335de370b1" :