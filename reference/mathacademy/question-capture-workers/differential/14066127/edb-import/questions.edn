#{[{:db/id #edb/ref 17592186078662 :knowledge-point/_questions [{:knowledge-point/id #uuid "bfe4679b-9724-5502-89d4-05e7661a1b5f" :knowledge-point/title "Solving an Inhibited Decay Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a46df3c0-fa1b-5b99-85d9-3113025fcdf5" :answer/type {:db/ident :answer.type/math} :answer/value "13\\,\\mathrm{min}" :db/id #edb/ref 17592186075282} {:answer/id #uuid "2183fae8-7e1c-53f0-ae6f-fe74064627ee" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\mathrm{min}" :db/id #edb/ref 17592186075283} {:answer/id #uuid "26bc257c-8668-5575-b189-f8907154496a" :answer/type {:db/ident :answer.type/math} :answer/value "14\\,\\mathrm{min}" :db/id #edb/ref 17592186075284} {:answer/id #uuid "4b2f5d4a-867a-554f-97f8-737bce32f42b" :answer/type {:db/ident :answer.type/math} :answer/value "15\\,\\mathrm{min}" :db/id #edb/ref 17592186075285} {:answer/id #uuid "57a6e665-098b-511b-bb38-52284e1ac66e" :answer/type {:db/ident :answer.type/math} :answer/value "10\\,\\mathrm{min}" :db/id #edb/ref 17592186075286}] :answer-field/correct {:answer/id #uuid "2183fae8-7e1c-53f0-ae6f-fe74064627ee" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\mathrm{min}" :db/id #edb/ref 17592186075283} :answer-field/id #uuid "d4238ab8-3d21-5159-b63a-92d299dc858c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186075281}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8b0ed3c5-b3aa-5668-ae2c-48b159839332" :question/math-academy-id "q-15384" :question/problem "A thermometer is placed into a water bath and displays a reading of $50\\,^{\\circ}\\mathrm{C}$. The thermometer is then transferred to a $10\\,^{\\circ}\\mathrm{C}$ water bath, and its reading begins to decrease. After $5$ minutes, the thermometer reading is $40\\,^{\\circ}\\mathrm{C}$. To the nearest minute, how long does it take for the thermometer to register a reading of $30\\,^{\\circ}\\mathrm{C}$?\n\n*Hint: You may assume that the temperature reading $T(t)$ of the thermometer decreases at a rate that obeys Newton's law of cooling, where $T$ is measured in degrees Celsius and $t > 0$ is the time, in minutes, since the thermometer was transferred into the $10\\,^{\\circ}\\mathrm{C}$ water bath.*" :question/requires-calculator true :question/worked-solution "Newton's law gives $T(t)=10+Ce^{-kt}$. From $T(0)=50$, $C=40$. Then $T(5)=40$ gives $e^{-5k}=30/40=3/4$, so $k=\\ln(4/3)/5$. To reach $30\\,^{\\circ}\\mathrm{C}$, solve $30=10+40e^{-kt}$, hence $e^{-kt}=1/2$. Thus\n\n$$t=\\frac{5\\ln 2}{\\ln(4/3)}\\approx12.047\\text{ minutes}.$$\n\nThe total time since transfer is $12$ minutes to the nearest minute."}] [{:db/id #edb/ref 17592186078663 :knowledge-point/_questions [{:knowledge-point/id #uuid "bfe4679b-9724-5502-89d4-05e7661a1b5f" :knowledge-point/title "Solving an Inhibited Decay Model"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e310791-fc1a-5220-b9e9-e6d06d946dd7" :answer/type {:db/ident :answer.type/math} :answer/value "81\\,^{\\circ}\\mathrm{C}" :db/id #edb/ref 17592186075288} {:answer/id #uuid "e403bf3f-eb08-54d2-9c70-dcabb6d17f13" :answer/type {:db/ident :answer.type/math} :answer/value "83\\,^{\\circ}\\mathrm{C}" :db/id #edb/ref 17592186075289} {:answer/id #uuid "227e4055-29da-58cf-93ec-5360a2dc3868" :answer/type {:db/ident :answer.type/math} :answer/value "85\\,^{\\circ}\\mathrm{C}" :db/id #edb/ref 17592186075290} {:answer/id #uuid "2cda4b0f-35f5-5eb4-999d-ab0114bf9bdc" :answer/type {:db/ident :answer.type/math} :answer/value "77\\,^{\\circ}\\mathrm{C}" :db/id #edb/ref 17592186075291} {:answer/id #uuid "55fa1563-ef36-5491-8e69-d0cdea0864fc" :answer/type {:db/ident :answer.type/math} :answer/value "79\\,^{\\circ}\\mathrm{C}" :db/id #edb/ref 17592186075292}] :answer-field/correct {:answer/id #uuid "8e310791-fc1a-5220-b9e9-e6d06d946dd7" :answer/type {:db/ident :answer.type/math} :answer/value "81\\,^{\\circ}\\mathrm{C}" :db/id #edb/ref 17592186075288} :answer-field/id #uuid "d8cfac56-5a02-5cd8-ad2c-86650f89e1b3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186075287}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "daa15db5-c1a1-535c-9031-79b2bb1e03e9" :question/math-academy-id "q-15595" :question/problem "The temperature $T(t)$, in degrees Celsius, of a cup of coffee can be modeled by the differential equation\n\n$\\frac{dT}{dt} =-0.05(T - 25)$\nwhere $t > 0$ is the time, measured in minutes. If the initial temperature of the coffee is $100\\,^{\\circ}\\mathrm{C}$, calculate the temperature of the coffee after $6$ minutes. Round your answer to the nearest integer." :question/requires-calculator true :question/worked-solution "Separating variables gives $\\ln|T-25|=-0.05t+C$, so $T(t)=25+Ae^{-0.05t}$. The initial condition $T(0)=100$ gives $A=75$. Therefore\n\n$$T(6)=25+75e^{-0.3}\\approx80.56\\,^{\\circ}\\mathrm{C},$$\n\nwhich rounds to $81\\,^{\\circ}\\mathrm{C}$."}]}
