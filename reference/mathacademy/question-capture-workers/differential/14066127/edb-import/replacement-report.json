        {
          "question": "q-15595",
          "field": null,
          "attribute": "question/problem",
          "value": "The temperature $T(t),$ in degrees Celsius, of a cup of coffee can be modeled by the differential equation\n\n$$\n\\frac{dT}{dt}=-0.05(T-25)\n$$\n\nwhere $t>0$ is the time, measured in minutes. If the initial temperature of the coffee is ${100}^{\u2218}C,$ calculate the temperature of the coffee after $6$ minutes. Round your answer to the nearest integer.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066127/state.json",
          "file_sha256": "67b4c4d78355bc6c4c4559e1f2703de5e813d430e2fd09822daf409e9474acf3"
