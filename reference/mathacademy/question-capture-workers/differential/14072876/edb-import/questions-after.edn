ld-1}},\n\n{{field-2}}$)$" :question/worked-solution "If the particle moves in the direction of increasing $x,$ then its velocity is positive. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}((4t-7){e}^{t}) \\\\  & =4{e}^{t}+(4t-7){e}^{t} \\\\  & =(4t-3){e}^{t}\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of increasing $x$, we solve $v(t)>0:$\n\n$$\n\\begin{aligned}v(t) & >0 \\\\ (4t-3){e}^{t} & >0 \\\\ 4t-3 & >0 \\\\ t & >\\frac{3}{4}\\end{aligned}\n$$\n\nTherefore, the time interval in which the particle is moving to the direction of increasing $x$ is \n\n$$\nt\\in (\\frac{3}{4},\\infty ).\n$$"}] [{:db/id #edb/ref 17592186378130 :knowledge-point/_questions [{:knowledge-point/id #uuid "f8f3989e-bde0-5b3a-8d45-08f34d330c3f" :knowledge-point/title "Determining Intervals of Increasing or Decreasing Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24e0216c-9d85-53ec-842c-438829e5f665" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186378132}] :answer-field/correct {:answer/id #uuid "24e0216c-9d85-53ec-842c-438829e5f665" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186378132} :answer-field/id #uuid "0185a6b0-7069-562a-902a-0b5a963f1b2c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378131} {:answer-field/choices [{:answer/id #uuid "b7b74b36-88b4-5148-950f-f6c71fdb0c1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186378134}] :answer-field/correct {:answer/id #uuid "b7b74b36-88b4-5148-950f-f6c71fdb0c1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186378134} :answer-field/id #uuid "af780eb8-15d3-5e12-8877-f969496e14a6" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378133}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ba3fe1a8-417c-575a-af4e-f05aefe98151" :question/math-academy-id "q-335899" :question/problem "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t)=\\sqrt{t}\\,(\\operatorname{ln}⁡t-2),$ where $t>0$ is the time measured in seconds. Determine the time intervals in which the particle is moving in the direction of increasing $x.$\n\n$t\\in (${{field-1}},\n\n{{field-2}}$)$" :question/worked-solution "If the particle moves in the direction of increasing $x,$ then its velocity is positive. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(\\sqrt{t}\\,(\\operatorname{ln}⁡t-2)) \\\\  & =\\frac{\\operatorname{ln}⁡t-2}{2\\sqrt{t}}+\\sqrt{t}\\cdot \\frac{1}{t} \\\\  & =\\frac{\\operatorname{ln}⁡t-2}{2\\sqrt{t}}+\\frac{1}{\\sqrt{t}} \\\\  & =\\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}}-\\frac{2}{2\\sqrt{t}}+\\frac{1}{\\sqrt{t}} \\\\  & =\\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}}-\\frac{1}{\\sqrt{t}}+\\frac{1}{\\sqrt{t}} \\\\  & =\\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}}\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of increasing $x$, we solve the inequality $v(t)>0:$\n\n$$\n\\begin{aligned}v(t) & >0 \\\\ \\frac{\\operatorname{ln}⁡t}{2\\sqrt{t}} & >0 \\\\ \\operatorname{ln}⁡t & >0 \\\\ t & >{e}^{0} \\\\ t & >1\\end{aligned}\n$$\n\nTherefore, the time interval in which the particle is moving in the direction of increasing $x$ is \n\n$$\nt\\in (1,\\infty ).\n$$"}] [{:db/id #edb/ref 17592186378135 :knowledge-point/_questions [{:knowledge-point/id #uuid "f8f3989e-bde0-5b3a-8d45-08f34d330c3f" :knowledge-point/title "Determining Intervals of Increasing or Decreasing Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc82e13f-8350-5567-8ed4-78673411281a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186378137} {:answer/id #uuid "48cff5cf-d7bf-5985-8fb9-0c89c8061a62" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186378138}] :answer-field/correct {:answer/id #uuid "48cff5cf-d7bf-5985-8fb9-0c89c8061a62" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186378138} :answer-field/id #uuid "7d103569-a870-56b3-9514-c4f56a7b37eb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378136} {:answer-field/choices [{:answer/id #uuid "8a705404-ea0c-560f-97d8-ab9760438fa4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186378140}] :answer-field/correct {:answer/id #uuid "8a705404-ea0c-560f-97d8-ab9760438fa4" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186378140} :answer-field/id #uuid "1e5a32a8-9463-550c-9993-5dd9ca848442" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378139}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "91dc8f99-5321-572b-ae30-69b08a6cd471" :question/math-academy-id "q-335904" :question/problem "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by \n$s(t)=(4t-12)^{2},$\nwhere $t\\ge 0$ is the time measured in seconds. Determine the time intervals in which the particle is moving in the direction of decreasing $x.$\n\n$t\\in [${{field-1}},\n\n{{field-2}}$)$" :question/worked-solution "If the particle moves in the direction of decreasing $x,$ then its velocity is negative.\n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,((4t-12)^{2}) \\\\  & =8(4t-12) \\\\  & =32(t-3)\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of decreasing $x,$ we solve the inequality $v(t)<0:$\n\n$$\n\\begin{aligned}v(t) & <0 \\\\ 32(t-3) & <0 \\\\ t-3 & <0 \\\\ t & <3\\end{aligned}\n$$\n\nTherefore, the time interval in which the particle is moving in the direction of decreasing $x$ is\n\n$$\nt\\in [0,\\,3).\n$$"}] [{:db/id #edb/ref 17592186378141 :knowledge-point/_questions [{:knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20008dbc-eda9-5408-87a2-e2c62f972573" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-3/2}" :db/id #edb/ref 17592186378143}] :answer-field/correct {:answer/id #uuid "20008dbc-eda9-5408-87a2-e2c62f972573" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-3/2}" :db/id #edb/ref 17592186378143} :answer-field/id #uuid "39b5f636-31a1-540b-938c-5c6f76f457d6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378142} {:answer-field/choices [{:answer/id #uuid "38eb2b5a-f6d2-5dfd-9508-5a2ed16af9e7" :answer/type {:db/ident :answer.type/math} :answer/value "-4e^{-3/2}" :db/id #edb/ref 17592186378145}] :answer-field/correct {:answer/id #uuid "38eb2b5a-f6d2-5dfd-9508-5a2ed16af9e7" :answer/type {:db/ident :answer.type/math} :answer/value "-4e^{-3/2}" :db/id #edb/ref 17592186378145} :answer-field/id #uuid "27220f10-dab9-5647-9caa-38641007c326" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378144}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4e9f49e9-6a26-5990-8bb0-3a162ad2d69e" :question/math-academy-id "q-335917" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)={t}^{2}ln\\,({t}^{2}),\\,t>0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment.\n\nThe acceleration is zero at $t=$\n{{field-1}}, and the velocity at this moment is\n$v=$\n{{field-2}}." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\ns(t)={t}^{2}ln\\,({t}^{2})=2{t}^{2}\\operatorname{ln}⁡(t)\n$$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}\\,(2{t}^{2}\\operatorname{ln}⁡(t)) \\\\  & =2(2t)\\operatorname{ln}⁡(t)+2{t}^{2}\\cdot \\frac{1}{t} \\\\  & =4t\\operatorname{ln}⁡(t)+2t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4t\\operatorname{ln}⁡(t)+2t) \\\\  & =4\\operatorname{ln}⁡(t)+4t\\cdot \\frac{1}{t}+2 \\\\  & =4\\operatorname{ln}⁡(t)+6\\end{aligned}\n$$\n\nNext, we put $a(t)=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}4\\operatorname{ln}⁡(t)+6 & =0 \\\\ 4\\operatorname{ln}⁡(t) & =-6 \\\\ \\operatorname{ln}⁡(t) & =-\\frac{3}{2} \\\\ t & ={e}^{-3/2}\\end{aligned}\n$$\n\nSo the acceleration is zero when $t={e}^{-3/2}.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\n\\begin{aligned}v\\,({e}^{-3/2}) & ={e}^{-3/2}(4ln\\,({e}^{-3/2})+2) \\\\  & ={e}^{-3/2}(4\\cdot (-\\frac{3}{2})+2) \\\\  & ={e}^{-3/2}(-6+2) \\\\  & =-4{e}^{-3/2}\\end{aligned}\n$$\n\nTherefore, the acceleration is zero at $t={e}^{-3/2},$ and the velocity at this moment is $v=-4{e}^{-3/2}.$"}] [{:db/id #edb/ref 17592186176478 :knowledge-point/_questions [{:knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92cbf261-0544-5c40-a71b-20fd16a58a89" :answer/type {:db/ident :answer.type/math} :answer/value "t = 3, v = 12" :db/id #edb/ref 17592186175411} {:answer/id #uuid "bbb7efb2-f34a-59eb-b99a-50d420f9eda8" :answer/type {:db/ident :answer.type/math} :answer/value "t = 1, v =-5" :db/id #edb/ref 17592186175412} {:answer/id #uuid "c25d1671-5fa4-5093-b672-95a3cd87c79b" :answer/type {:db/ident :answer.type/math} :answer/value "t = 2, v =-6" :db/id #edb/ref 17592186175413} {:answer/id #uuid "180a0478-15fa-5723-8bd8-1bd46b34b076" :answer/type {:db/ident :answer.type/math} :answer/value "t = 0, v = 0" :db/id #edb/ref 17592186175414} {:answer/id #uuid "6d86d48f-1ff3-5b4c-97a7-5e5cf2865553" :answer/type {:db/ident :answer.type/math} :answer/value "t = 2, v =-12" :db/id #edb/ref 17592186175415}] :answer-field/correct {:answer/id #uuid "6d86d48f-1ff3-5b4c-97a7-5e5cf2865553" :answer/type {:db/ident :answer.type/math} :answer/value "t = 2, v =-12" :db/id #edb/ref 17592186175415} :answer-field/id #uuid "3b25002f-25a7-580c-b7d6-ed61888beceb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175410}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "96a50be4-cdc7-51a8-ab48-0bb14c9847ab" :question/math-academy-id "q-7109" :question/problem "A particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n\n$$\ns(t)={t}^{3}-6{t}^{2},\\,t\\ge 0.\n$$\n\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/requires-calculator true :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-6{t}^{2}) \\\\  & =3{t}^{2}-12t\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-12t) \\\\  & =6t-12\\end{aligned}\n$$\n\nNext, we put $a=0$ to find the time when the acceleration is zero:\n\n$$\n\\begin{aligned}0 & =6t-12 \\\\ 6t & =12 \\\\ t & =2\\end{aligned}\n$$\n\nSo the acceleration is zero when $t=2.$ To find the velocity at this moment, we substitute this back into $v(t)$ to get\n\n$$\nv(2)=3(2)^{2}-12(2)=-12.\n$$"}]}
