#{[{:db/id #edb/ref 17592186293147 :knowledge-point/_questions [{:knowledge-point/id #uuid "f8f3989e-bde0-5b3a-8d45-08f34d330c3f" :knowledge-point/title "Determining Intervals of Increasing or Decreasing Displacement"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd79ef94-fcdf-58f6-aa30-5aa511cb311b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186293149}] :answer-field/correct {:answer/id #uuid "dd79ef94-fcdf-58f6-aa30-5aa511cb311b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186293149} :answer-field/id #uuid "21660576-1240-5665-a5f3-e25ef9579462" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293148} {:answer-field/choices [{:answer/id #uuid "2110c1da-b1a4-56c2-839d-ec6245598cd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186293151}] :answer-field/correct {:answer/id #uuid "2110c1da-b1a4-56c2-839d-ec6245598cd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty" :db/id #edb/ref 17592186293151} :answer-field/id #uuid "45b0bf94-741a-59b3-b780-9aa3ef6a0c61" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186293150}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c26d8c3c-e107-52ba-89a9-ccc2af1eaed1" :question/math-academy-id "q-315550" :question/problem "The displacement $s,$ in meters, relative to a fixed origin $O$ of a particle moving in a straight line along the $x$-axis is given by $s(t)=(4t-7){e}^{t},$ where $t>0$ is the time, measured in seconds. Find the time intervals in which the particle is moving in the direction of increasing $x.$\n\n$t\\in (${{field-1}},\n\n{{field-2}}$)$" :question/worked-solution "If the particle moves in the direction of increasing $x,$ then its velocity is positive. \n\nFirst, we calculate the velocity function by differentiating the position function:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}((4t-7){e}^{t}) \\\\  & =4{e}^{t}+(4t-7){e}^{t} \\\\  & =(4t-3){e}^{t}\\end{aligned}\n$$\n\nTo calculate time intervals in which the particle is moving in the direction of increasing $x$, we solve $v(t)>0:$\n\n$$\n\\begin{aligned}v(t) & >0 \\\\ (4t-3){e}^{t} & >0 \\\\ 4t-3 & >0 \\\\ t & >\\frac{3}{4}\\end{aligned}\n$$\n\nTherefore, the time interval in which the particle is moving to the direction of increasing $x$ is \n\n$$\nt\\in (\\frac{3}{4},\\infty ).\n$$"}] [{:db/id #edb/ref 17592186176478 :knowledge-point/_questions [{:knowledge-point/id #uuid "bee6d4bf-79da-5eb3-a214-8c045dbce5bd" :knowledge-point/title "Calculating the Velocity of a Particle at the Moment When Its Acceleration is Zero"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92cbf261-0544-5c40-a71b-20fd16a58a89" :answer/type {:db/ident :answer.type/math} :answer/value "t = 3, v = 12" :db/id #edb/ref 17592186175411} {:answer/id #uuid "bbb7efb2-f34a-59eb-b99a-50d420f9eda8" :answer/type {:db/ident :answer.type/math} :answer/value "t = 1, v =-5" :db/id #edb/ref 17592186175412} {:answer/id #uuid "c25d1671-5fa4-5093-b672-95a3cd87c79b" :answer/type {:db/ident :answer.type/math} :answer/value "t = 2, v =-6" :db/id #edb/ref 17592186175413} {:answer/id #uuid "180a0478-15fa-5723-8bd8-1bd46b34b076" :answer/type {:db/ident :answer.type/math} :answer/value "t = 0, v = 0" :db/id #edb/ref 17592186175414} {:answer/id #uuid "6d86d48f-1ff3-5b4c-97a7-5e5cf2865553" :answer/type {:db/ident :answer.type/math} :answer/value "t = 2, v =-12" :db/id #edb/ref 17592186175415}] :answer-field/correct {:answer/id #uuid "6d86d48f-1ff3-5b4c-97a7-5e5cf2865553" :answer/type {:db/ident :answer.type/math} :answer/value "t = 2, v =-12" :db/id #edb/ref 17592186175415} :answer-field/id #uuid "3b25002f-25a7-580c-b7d6-ed61888beceb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175410}] :question/id #uuid "96a50be4-cdc7-51a8-ab48-0bb14c9847ab" :question/math-academy-id "q-7109" :question/problem "> A scientific calculator is required to answer this question.\n\nA particle $P$ is traveling along the $x$-axis with displacement $s(t)$ from a fixed origin $O$ given by\n$s(t) = t^{3} - 6t^{2}, t \\ge 0$.\nFind the time at which the acceleration is zero, and find the value of the velocity at this moment." :question/requires-calculator true}]}
