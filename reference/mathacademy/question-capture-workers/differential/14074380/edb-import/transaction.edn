0f4e1040eb4f521ba9f2fe9c2a2ca558e759afb0a1" :answer/id #uuid "08b73e01-5fff-5ad1-a2f6-84cabcdf3bf1" :answer/type :answer.type/math :answer/value "0.00" :db/ensure [:answer/validate]} {:db/id "q-333602/field-8" :answer-field/id #uuid "5b64d2fe-4432-5d0f-a405-36e144b536fe" :answer-field/key "field-8" :answer-field/type :answer-field.type/select :answer-field/correct "q-333602/field-8/fba140740a7209ad5dd4b50f4e1040eb4f521ba9f2fe9c2a2ca558e759afb0a1" :answer-field/choices ["q-333602/field-8/ac3e8af78a9560986ef279aa38cb137db384915ed1153cb95afa9c2da9aa4790" "q-333602/field-8/52f58d698c3527f04a44f9fbd7cb494e895b61af73c0cbede8d00a7440b05cea" "q-333602/field-8/be484ff172b5b11e5f672ae6edb2be353b6661c137baa65b25cbde188f737a8e" "q-333602/field-8/fba140740a7209ad5dd4b50f4e1040eb4f521ba9f2fe9c2a2ca558e759afb0a1"] :db/ensure [:answer-field/validate]} {:db/id "q-333602" :question/id #uuid "6663394a-d271-5f09-bd80-f481874766bb" :question/math-academy-id "q-333602" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-5x(t)+y(t) \\\\ {y}^{′}(t)=-4x(t)-y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvector $v=[1,\\text{ }2]^{T}$ corresponds to the repeated eigenvalue $\\lambda =-3$ of the system's matrix $A.$ The vector $w=[0,\\text{ }1]^{T}$ is such that $(A-\\lambda I)w=v.$ Select the correct options in the reasoning below.The general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-3t}+{c}_{2}([\\begin{aligned}1 \\\\ 2\\end{aligned}]t{e}^{-3t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{{field-1}}) \\\\  & ={c}_{1}{e}^{-3t}{{field-2}}+{c}_{2}{e}^{-3t}[\\begin{aligned}t \\\\ 2t+1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $v=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ has the equation \n\n$$\ny={{field-3}}\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-3t}\\to $ \n{{field-4}} \nas $t\\to \\infty ,$ these solutions approach \n{{field-5}}  \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/558ff2994d715139bde11747fdffddbbbd20f17f80c8deb3b90f4ae76078bdba.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}t \\\\ 2t+1\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n{\\begin{aligned}x={{field-6}} \\\\ y=(2t+1){e}^{-3t}\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | {{field-7}} | $0$ | $0.11$ |\n| $y$ | {{field-8}} | $1$ | $0.45$ |\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/10050fff096c999bdd1d845a247dac87a3135458313338f62018612639a011b0.png)\n\nThe phase portrait of our system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/c227e135e04b76f093d8c2ad6e2a4365e206c19b281f1a3df7a4b65dd479f411.png)" :question/worked-solution "Since we have a repeated eigenvalue $\\lambda =-3$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =-3,\\,v=[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,w=[\\begin{aligned}0 \\\\ 1\\end{aligned}].\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-3t}+{c}_{2}([\\begin{aligned}1 \\\\ 2\\end{aligned}]t{e}^{-3t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-3t}) \\\\  & ={c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]+{c}_{2}{e}^{-3t}[\\begin{aligned}t \\\\ 2t+1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $v=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ has the equation \n\n$$\ny=2x\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-3t}[\\begin{aligned}1 \\\\ 2\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-3t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/558ff2994d715139bde11747fdffddbbbd20f17f80c8deb3b90f4ae76078bdba.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}t \\\\ 2t+1\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n{\\begin{aligned}x=t{e}^{-3t} \\\\ y=(2t+1){e}^{-3t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.5$ |\n| --- | --- | --- | --- |\n| $x$ | $-2.24$ | $0$ | $0.11$ |\n| $y$ | $0.00$ | $1$ | $0.45$ |\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/10050fff096c999bdd1d845a247dac87a3135458313338f62018612639a011b0.png)\n\nThe phase portrait of our system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/c227e135e04b76f093d8c2ad6e2a4365e206c19b281f1a3df7a4b65dd479f411.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-333602/field-1" 