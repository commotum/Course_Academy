8/cba1cafe21a2bb8c527687249b30cdd97b0c5a7a61ff8674283ed0a49efb88b8" :answer/id #uuid "24dbb588-fefc-5fa5-8204-90f6ad1d0acb" :answer/type :answer.type/math :answer/value "3.58" :db/ensure [:answer/validate]} {:db/id "q-333589/field-8/ad0364dcc99d42229f6e2a60f5334f760d018ec942404cf40f77f1ced1d561c7" :answer/id #uuid "f39700ae-39d9-52a2-b5f8-83e0d79ec1d2" :answer/type :answer.type/math :answer/value "0.20" :db/ensure [:answer/validate]} {:db/id "q-333589/field-8" :answer-field/id #uuid "817a224e-d1d2-5a53-a896-499e48c5e570" :answer-field/key "field-8" :answer-field/type :answer-field.type/select :answer-field/correct "q-333589/field-8/2b32a066da55d5252b340f3d6d5cbe8b06a858c3bec31801b5583e8582e16ad3" :answer-field/choices ["q-333589/field-8/1194182f705738de3c267aa6204f0475d93ccbfa48af1f5090b5efcd2ca0d62c" "q-333589/field-8/2b32a066da55d5252b340f3d6d5cbe8b06a858c3bec31801b5583e8582e16ad3" "q-333589/field-8/cba1cafe21a2bb8c527687249b30cdd97b0c5a7a61ff8674283ed0a49efb88b8" "q-333589/field-8/ad0364dcc99d42229f6e2a60f5334f760d018ec942404cf40f77f1ced1d561c7"] :db/ensure [:answer-field/validate]} {:db/id "q-333589" :question/id #uuid "cf13071c-d3b1-5868-a0cc-3bf7e1adbfaa" :question/math-academy-id "q-333589" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=3x(t)+y(t) \\\\ {y}^{′}(t)=-x(t)+5y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvector $v=[3,\\text{ }3]^{T}$ corresponds to the repeated eigenvalue $\\lambda =4$ of the system's matrix $A.$ The vector $w=[0,\\text{ }3]^{T}$ is such that $(A-\\lambda I)w=v.$ Select the correct options in the reasoning below.The general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}3 \\\\ 3\\end{aligned}]{e}^{4t}+{c}_{2}([\\begin{aligned}3 \\\\ 3\\end{aligned}]t{e}^{4t}+[\\begin{aligned}0 \\\\ 3\\end{aligned}]{{field-1}}) \\\\  & ={c}_{1}{e}^{4t}{{field-2}}+{c}_{2}{e}^{4t}[\\begin{aligned}3t \\\\ 3t+3\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $v=[\\begin{aligned}3 \\\\ 3\\end{aligned}]$ has the equation \n\n$$\ny={{field-3}}\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{4t}[\\begin{aligned}3 \\\\ 3\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{4t}\\to $ \n{{field-4}} \nas $t\\to \\infty ,$ these solutions approach \n{{field-5}}  \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/6ec9eac46644188b8b41a1a7ea28ca0542ee7e5c69d713028481904e90dd557a.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{4t}[\\begin{aligned}3t \\\\ 3t+3\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n{\\begin{aligned}x={{field-6}} \\\\ y=3(t+1){e}^{4t}\\end{aligned}\n$$\n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.1$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.20$ | $0$ | {{field-7}} |\n| $y$ | $0.20$ | $3$ | {{field-8}} |\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/b0be26a1544bbb3117afab15d004bafee70d831fffab4b1f6921870871ac4768.png)\n\nThe phase portrait of our system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/64e685f4ea06a8f497ddfbe50a092a0362b8c92a9d2f78f9da2a8164113a785a.png)" :question/worked-solution "Since we have a repeated eigenvalue $\\lambda =4$ (of multiplicity two) and only one corresponding eigenvector $v,$ the solution of the system is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nIn our case, \n\n$$\n\\lambda =4,\\,v=[\\begin{aligned}3 \\\\ 3\\end{aligned}],\\,w=[\\begin{aligned}0 \\\\ 3\\end{aligned}].\n$$\n\n \nThus, the general solution of the system is\n\n$$\n\\begin{aligned}[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}] & ={c}_{1}[\\begin{aligned}3 \\\\ 3\\end{aligned}]{e}^{4t}+{c}_{2}([\\begin{aligned}3 \\\\ 3\\end{aligned}]t{e}^{4t}+[\\begin{aligned}0 \\\\ 3\\end{aligned}]{e}^{4t}) \\\\  & ={c}_{1}{e}^{4t}[\\begin{aligned}3 \\\\ 3\\end{aligned}]+{c}_{2}{e}^{4t}[\\begin{aligned}3t \\\\ 3t+3\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nThe line that passes through the origin and is parallel to $v=[\\begin{aligned}3 \\\\ 3\\end{aligned}]$ has the equation \n\n$$\ny=x\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{4t}[\\begin{aligned}3 \\\\ 3\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{4t}\\to \\infty $ as $t\\to \\infty ,$ these solutions approach $\\text{infinity}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/6ec9eac46644188b8b41a1a7ea28ca0542ee7e5c69d713028481904e90dd557a.png)\n\nNow, consider solutions of the form\n${c}_{2}{e}^{4t}[\\begin{aligned}3t \\\\ 3t+3\\end{aligned}].$\nWhen ${c}_{2}=1,$ we get the following curve:\n\n$$\n{\\begin{aligned}x=3t{e}^{4t} \\\\ y=3(t+1){e}^{4t}\\end{aligned}\n$$\n\n \n\nComputing the coordinates (rounded to two decimal places) of several points on the curve, we get the table below.\n\n| $t$ | $-0.5$ | $0$ | $0.1$ |\n| --- | --- | --- | --- |\n| $x$ | $-0.20$ | $0$ | $0.45$ |\n| $y$ | $0.20$ | $3$ | $4.92$ |\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/b0be26a1544bbb3117afab15d004bafee70d831fffab4b1f6921870871ac4768.png)\n\nThe phase portrait of our system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074380/assets/64e685f4ea06a8f497ddfbe50a092a0362b8c92a9d2f78f9da2a8164113a785a.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-333589/field-1" "q-333589/field-2" "q-333589/field-3" "q-333589/field-4" "q-333589/field-5" "q-333589/field-6" "q-333589/field-7" "q-333589/field-8"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a2c335ee-467a-5114-a7d9-4c2692562d9e"] :knowledge-point/questions ["q-333589"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333602/field-1/056e179f78ccfcc3e573146fcc7c182f8abc46e128ecf97df2624ccd64163ef9" :answer/id #uuid "3df03b28-58fd-5bda-88e5-bf2dce7eba1f" :answer/type :answer.type/math :answer/value "t{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-333602/field-1/ac225e037427ea7fdc6f7e879ac709452f853ca3432bb046292aaaf20fbd5565" :answer/id #uuid "7c055298-a974-57d1-9d69-0c3be9ed2717" :answer/type :answer.type/math :answer/value "{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-333602/field-1/74fcf99af759e31fac89d6eb8f56f394b7f994a3bb47960227b868893fc6021d" :answer/id #uuid "d4552c42-cd23-5dcb-905e-4b0101152bf0" :answer/type :answer.type/math :answer/value "t{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-333602/field-1/0b4fc2c65192b2cc173c4e8ad58547377955072334ed0e3f1143e195e81e3110" :answer/id #uuid "ad164a18-b7fd-51bb-9cf6-859f915c1257" :answer/type :answer.type/math :answer/value "{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-333602/field-1" :answer-field/id #uuid "c0808640-b442-5a9a-a263-40fabec6ef61" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-333602/field-1/ac225e037427ea7fdc6f7e879ac709452f853ca3432bb046292aaaf20fbd5565" :answer-field/choices ["q-333602/field-1/056e179f78ccfcc3e573146fcc7c182f8abc46e128ecf97df2624ccd64163ef9" "q-333602/field-1/ac225e037427ea7fdc6f7e879ac709452f853ca3432bb046292aaaf20fbd5565" "q-333602/field-1/74fcf99af759e3