71a-b8ab-6bf67dc652e8" 13194139535092 true] [17592186330769 1145 "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)=\\frac{1}{2}(\\operatorname{sin}⁡(7x)-\\operatorname{sin}⁡(3x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(5x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{sin}⁡(7x)-\\frac{1}{2}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{14}\\operatorname{cos}⁡(7x)+\\frac{1}{6}\\operatorname{cos}⁡(3x)]}_{0}^{2\\pi } \\\\  & =-\\frac{1}{14}(\\operatorname{cos}⁡(14\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{6}(\\operatorname{cos}⁡(6\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{14}(1-1)+\\frac{1}{6}(1-1) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{sin}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(5x)$ $\\text{are orthogonal}$ with respect to the inner product." 13194139535092 true] [17592186330770 1000 #edb/ref 17592186330771 13194139535092 true] [17592186330770 1000 #edb/ref 17592186330772 13194139535092 true] [17592186330770 1000 #edb/ref 17592186330773 13194139535092 true] [17592186330770 1000 #edb/ref 17592186330774 13194139535092 true] [17592186330770 1040 #edb/ref 17592186045451 13194139535092 true] [17592186330770 1041 "field-1" 13194139535092 true] [17592186330770 1104 #edb/ref 17592186330773 13194139535092 true] [17592186330770 1110 #uuid "d8e2a251-46b0-5cf8-a475-6272bb2966ca" 13194139535092 true] [17592186330771 1034 "\\pi " 13194139535092 true] [17592186330771 1103 #edb/ref 17592186045453 13194139535092 true] [17592186330771 1111 #uuid "bbd0ffc2-c8e3-529d-8049-5d3638620b0d" 13194139535092 true] [17592186330772 1034 "1" 13194139535092 true] [17592186330772 1103 #edb/ref 17592186045453 13194139535092 true] [17592186330772 1111 #uuid "d26ac4fd-1ffd-578f-a9d4-5c909f48ae1b" 13194139535092 true] [1759218633077