db/id "q-340647/field-2" :answer-field/id #uuid "3aca8833-c3f8-5c4e-9487-fa6538a847c7" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-340647/field-2/b70aae751b2c8b3e9e8a13d794a4d2996d95172e6176a2e8db9c2f456750b489" :answer-field/choices ["q-340647/field-2/167ebf11c001034e2cbb5c82fd03c6c789b33fae94a34649b1567e72676329e0" "q-340647/field-2/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-340647/field-2/a319e2074b264fdb964c2b6eb43d32d763280e23b0599a55d545f0a58e6fea9e" "q-340647/field-2/b70aae751b2c8b3e9e8a13d794a4d2996d95172e6176a2e8db9c2f456750b489" "q-340647/field-2/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a"] :db/ensure [:answer-field/validate]} {:db/id "q-340647/field-3/04fdd7ec3c4b572c72fbe1a90adf60fc1ba2dd1a755f902146ca1be1dff61932" :answer/id #uuid "23b450e6-2ad1-598c-b98f-3d104b02117f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340647/field-3/cd217f54f8cb97cf20021aea9d95ab3ede80412dfa5371a235a5e846e3de982b" :answer/id #uuid "e1ad476b-415b-5551-a674-36128788df55" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340647/field-3/1f46a508dfbffaa12f0536ed3f1d88b0fb843a2e79c67ce02407bcc9272c3994" :answer/id #uuid "e0194121-c133-5c87-82b2-71c65276b91f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340647/field-3/dbba98b6fc233f09be666129a19de2c011570afb9779e5f8420ede383684036b" :answer/id #uuid "a5b7bcdf-6f73-515b-a674-06f62a2dc0b6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }{x}^{2}\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340647/field-3/f922dfbfc1c508c59618d0686033714b761d40bb7fa3669ab43650045f492b5d" :answer/id #uuid "cda21ba6-4e9a-59ff-a560-bae38fb214c6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340647/field-3/58fb79084150cdb05b8c6b217ee415679895888b33743ba2497adb6572754cf1" :answer/id #uuid "01c37305-f58b-5f0e-8f01-c62256ef6546" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340647/field-3" :answer-field/id #uuid "19020950-662c-5f62-8f87-944f3110f05a" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-340647/field-3/58fb79084150cdb05b8c6b217ee415679895888b33743ba2497adb6572754cf1" :answer-field/choices ["q-340647/field-3/04fdd7ec3c4b572c72fbe1a90adf60fc1ba2dd1a755f902146ca1be1dff61932" "q-340647/field-3/cd217f54f8cb97cf20021aea9d95ab3ede80412dfa5371a235a5e846e3de982b" "q-340647/field-3/1f46a508dfbffaa12f0536ed3f1d88b0fb843a2e79c67ce02407bcc9272c3994" "q-340647/field-3/dbba98b6fc233f09be666129a19de2c011570afb9779e5f8420ede383684036b" "q-340647/field-3/f922dfbfc1c508c59618d0686033714b761d40bb7fa3669ab43650045f492b5d" "q-340647/field-3/58fb79084150cdb05b8c6b217ee415679895888b33743ba2497adb6572754cf1"] :db/ensure [:answer-field/validate]} {:db/id "q-340647" :question/id #uuid "8113289a-3226-5746-b1f3-c6dca42761fe" :question/math-academy-id "q-340647" :question/problem "Let $F(x)={x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${b}_{2}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{b}_{2} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that is piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{sin}⁡(2x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(2x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{sin}⁡(2x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(2x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{sin}⁡(2x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{sin}⁡(2x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{b}_{2}⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩ & ={\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡(2x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}-\\frac{1}{2}\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x-\\frac{1}{8}\\operatorname{sin}⁡(4x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))-\\frac{1}{8}(\\operatorname{sin}⁡(4\\pi )-(\\operatorname{sin}⁡(-4\\pi ))) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{sin}⁡(2x)⟩ & ={b}_{2}⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩ \\\\ {b}_{2} & =\\frac{⟨f(x),\\operatorname{sin}⁡(2x)⟩}{⟨\\operatorname{sin}⁡(2x),\\operatorname{sin}⁡(2x)⟩} \\\\ {b}_{2} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }{x}^{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340647/field-1" "q-340647/field-2" "q-340647/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604"] :knowledge-point/questions ["q-340647"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340662/field-1/56b8c5a4f3b3b608a37ad5345f86a6a0df8c1a1bd909e63a8f7389fe2cbde4c1" :answer/id #uuid "4117ec21-c98e-5ec0-b36a-8dd5607c1f1e" :answer/type :answer.type/math :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(4x)⟩}{⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩}" :db/ensure [:answer/validate]} {:db/id "q-340662/field-1/bbb8d0dabdc2a1f1d35bdb897b9fa80b625ec8ecbafa4e5d2166bad93d0cd87b" :answer/id #uuid "63f3b34b-8410-592b-b08d-1883d0f24568" :answer/type :answer.type/math :answer/value "\\frac{⟨\\operatorname{sin}⁡(4x),\\operatorname{sin}⁡(4x)⟩}{⟨f(x),\\operatorname{sin}⁡(4x)⟩}" :db/ensure [:answer/validate]} {:db/id "q-340662/field-1/43ec4b9678829bdd74bafb5391df9bced31c783b25e3bedd7298b41f833c5aa2" :answer/id #uuid "f0cd75e5-88f5-50f5-89c8-b5a937eb2863" :answer/type :answer.type/math :answer/value "\\frac{⟨\\operatorname{cos}⁡(4x),\\operatorname{cos}⁡(4x)⟩}{⟨f(x),\\operatorname{sin}⁡(4x)⟩}" :db/ensure [:answer/validate]} {:db/id "q-340662/field-1/568b7c5d1252798b7395e64aa944781d29d5a43fec9ba4e16024c4fc30e3a638" :answer/id #uuid "