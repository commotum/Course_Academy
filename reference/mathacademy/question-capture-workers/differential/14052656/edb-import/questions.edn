/(⟨\\sin (5x), \\sin (5x)⟩)" :db/id #edb/ref 17592186164869} {:answer/id #uuid "c67cd987-6ec5-57a7-9c7c-effb0b0eca94" :answer/type {:db/ident :answer.type/math} :answer/value "(⟨f(x), \\cos (5x)⟩)/(⟨\\cos (5x), \\cos (5x)⟩)" :db/id #edb/ref 17592186164870} {:answer/id #uuid "55adcd35-c626-5f20-b50a-cf74b96126f4" :answer/type {:db/ident :answer.type/math} :answer/value "(⟨f(x), \\sin (5x)⟩)/(⟨\\sin (5x), \\sin (5x)⟩)" :db/id #edb/ref 17592186164871} {:answer/id #uuid "6561e55b-1285-52d8-97de-2927a802d5a2" :answer/type {:db/ident :answer.type/math} :answer/value "(⟨\\sin (5x), \\sin (5x)⟩)/(⟨f(x), \\cos (5x)⟩)" :db/id #edb/ref 17592186164872} {:answer/id #uuid "674d6ba9-cecb-5505-ae5e-615d1b2906c1" :answer/type {:db/ident :answer.type/math} :answer/value "(⟨\\cos (5x), \\cos (5x)⟩)/(⟨f(x), \\cos (5x)⟩)" :db/id #edb/ref 17592186164873}] :answer-field/correct {:answer/id #uuid "c67cd987-6ec5-57a7-9c7c-effb0b0eca94" :answer/type {:db/ident :answer.type/math} :answer/value "(⟨f(x), \\cos (5x)⟩)/(⟨\\cos (5x), \\cos (5x)⟩)" :db/id #edb/ref 17592186164870} :answer-field/id #uuid "9c7846c0-b2b6-5038-9ca3-dc4dfc0646cf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164868} {:answer-field/choices [{:answer/id #uuid "9dc7ec21-5577-5a65-9979-79200f1a6b75" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{∞}x^{2}\\cos (5x)dx" :db/id #edb/ref 17592186164875} {:answer/id #uuid "e1bad02e-e232-53fc-8690-ea138de9d8ad" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{∞}x^{2}\\sin (5x)dx" :db/id #edb/ref 17592186164876} {:answer/id #uuid "e4298d08-8ab3-57c9-bc2a-6a66b95cd618" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{2π}x^{2}\\sin (5x)dx" :db/id #edb/ref 17592186164877} {:answer/id #uuid "e76aa029-6c75-563f-a800-3515bb7cd888" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{2π}x^{2}\\cos (5x)dx" :db/id #edb/ref 17592186164878} {:answer/id #uuid "ed57003e-41b