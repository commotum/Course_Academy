swer-field/type :answer-field.type/radio :answer-field/correct "q-332941/selection/51ae41c3b62e92a66bb5b888977c8ece99879e860ba12fd127914683056015f4" :answer-field/choices ["q-332941/selection/8904b22ebee4d4f3d9d27e7d6d790b69c1fbef7496bb10a94482628271b55ec6" "q-332941/selection/0a36b41363f2ab105db618a493ad7ae788ad7076d953c51d8c2b709f1399aa4f" "q-332941/selection/50b8c26711beddf87995b246cb243b0a39ee49710e4ebcb50c41b5721039886d" "q-332941/selection/0b41b5ee31f781f59ed5f2a7cd13eca32d4d9ac210a086809de9f3cc9ca5325e" "q-332941/selection/51ae41c3b62e92a66bb5b888977c8ece99879e860ba12fd127914683056015f4"] :db/ensure [:answer-field/validate]} {:db/id "q-332941" :question/id #uuid "6851a9f5-d945-540b-94e8-2f205003c003" :question/math-academy-id "q-332941" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14073694/assets/7ad36c695bc150b580caa81f71fa358163a51ca3ed788dbd60e9cef980d9a75b.png)\n\nA sketch of the phase space with nullclines and the corresponding direction field of tangents to the solutions of a system of differential equations is shown above (the tangents are not drawn to scale). Which of the following could represent the trajectory starting at the point marked on the graph?" :question/worked-solution "Let's sketch the trajectory.\n\n- We start at the given point and go along with the flow (downward and slightly to the left) until the trajectory intersects the $y$-nullcline, where the tangents are horizontal.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14073694/assets/38cdd84fa7383122a41e287efe71822acc0ea6ffc7beb6567fe31e461e7b2bc2.png)\n\n- Next, the flow continues going to the left but then starts turning upward.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14073694/assets/8861a2e90a1bf87651157b0eba1e38363f646c2305724a254498173fd47c554c.png)\n\n- After that, the trajectory continues slightly to the left and upward, suggesting that it may converge to the origin.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14073694/assets/a7c5a4702b6add4085b594d6e6cebd85b4746ef8138f22089679c5277266aa59.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332941/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "129bee33-7c18-5450-affe-dd710a3a75dd"] :knowledge-point/questions ["q-332941"] :db/ensure [:knowledge-point/validate]}]
