52b28d10f24a07205a374bdf0fd1f741c2a1c01.png)"}] [{:db/id #edb/ref 17592186356641 :knowledge-point/_questions [{:knowledge-point/id #uuid "129bee33-7c18-5450-affe-dd710a3a75dd" :knowledge-point/title "Identifying a Trajectory Given a Starting Point and the Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "144e07eb-ce0a-5d53-b342-3c0dbbe89653" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/9213923ffccce206fd161352cbc9ee209763018e00565c6fa948dcad27d50f35.png" :db/id #edb/ref 17592186356643} {:answer/id #uuid "8a9b26f1-0394-539c-8ed4-5d62243c8189" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/abcaeea2568c1f5f9969e855d2394bbb16fbc5a3589430f562ae3ba745ede675.png" :db/id #edb/ref 17592186356644} {:answer/id #uuid "bec33e51-3b40-5860-93ad-31665b10e246" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/f038e336ebc3dd016ffcd2a56318e0474976335e4295f1ed3260dcf55ea23f53.png" :db/id #edb/ref 17592186356645} {:answer/id #uuid "3cd14957-2822-58de-ab4c-91ece2ba12da" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/bea7fb72b9847f4862be6f7b17f1bbba6e6ea3891861cadf1dea79521ed80ec0.png" :db/id #edb/ref 17592186356646} {:answer/id #uuid "50b9e43c-92ef-55da-bff7-60afc76f2d90" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/b12e7c37f388f69649997e2f0ea520c99c30e6d5b996aee408570e03792d1d0a.png" :db/id #edb/ref 17592186356647}] :answer-field/correct {:answ