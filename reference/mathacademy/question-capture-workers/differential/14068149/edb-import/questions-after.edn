5dd" :knowledge-point/title "Identifying a Trajectory Given a Starting Point and the Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b986728-89eb-5a8e-b44c-d38113cab5a4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/215aa3b3d52072a4c0a7e90606f19fbbd697fac2d1b1130ffdbf37aee7c6bc46.png" :db/id #edb/ref 17592186356650} {:answer/id #uuid "680c5695-6553-5216-b3d3-31d4dc3cd44a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/33362c92cf128a95644e23ea5571040307975c305aea1a7136b3a0aca6d74afa.png" :db/id #edb/ref 17592186356651} {:answer/id #uuid "a62d9185-6589-582e-8795-9948b995fdbb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/fb97fe6d2c8ede229a7123caa02062c5095120d0a9b15793dd55456975be3e02.png" :db/id #edb/ref 17592186356652} {:answer/id #uuid "a744aa19-8bd0-503d-811d-b29739f6a6c8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/ff7cd68fc97c5fe09038055a1e7f7a00d0f2b7756f8f33f6880b3ade40ab677f.png" :db/id #edb/ref 17592186356653} {:answer/id #uuid "bf2dcd7b-9205-5b02-bc75-163c5608246b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/3c771573470c8914a3222ca363ae90b2603118961bd1fb3e36bd38235a70f348.png" :db/id #edb/ref 17592186356654}] :answer-field/correct {:answer/id #uuid "2b986728-89eb-5a8e-b44c-d38113cab5a4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/215aa3b3d52072a4c0a7e90606f19fbbd697fac2d1b1130ffdbf37aee7c6bc46.png" :db/id #edb/ref 17592186356650} :answer-field/id #uuid "9859b242-cb81-526d-bc1e-5ebe9ba68b20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186356649}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8249c0d9-20d2-50d9-b555-56e33d4e5e5d" :question/math-academy-id "q-332919" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/f346ab4bb4f2c84c7cdc3812dd4028af9e175b0aab06fb1a76ea43e234278a42.png)\n\nA sketch of the phase space with nullclines and the corresponding direction field of tangents to the solutions of a system of differential equations is shown above (the tangents are not drawn to scale). Which of the following could represent the trajectory starting at the point marked on the graph?" :question/worked-solution "Let's sketch the trajectory.\n\n- We start at the given point and go along with the flow (upward and slightly to the right) until the trajectory intersects the $x$-nullcline, where the tangents are vertical.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/0b10b27b37589dc59c39f74cd800b06aab1e5d8f9087ea75465c701099dc51d4.png)\n\n- Next, the flow continues going upward but then turns to the left. At some point, our trajectory intersects the $y$-nullcline where the  tangents are horizontal.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/0ef35edaa4bc4306be91e7730be651951987e4b49706a59f3a1245281f58f0fc.png)\n\n- After that, the trajectory proceeds almost horizontally to the left, going to infinity.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/48d82dd8338c251969e29c2bfb238c6ab0ded096434abacb3ebc47954635cd9e.png)"}] [{:db/id #edb/ref 17592186167166 :knowledge-point/_questions [{:knowledge-point/id #uuid "129bee33-7c18-5450-affe-dd710a3a75dd" :knowledge-point/title "Identifying a Trajectory Given a Starting Point and the Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9604b112-9c0b-5661-99bc-a927725a3aa7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3188/Source/Images/q-332920-a-4.png" :db/id #edb/ref 17592186164396} {:answer/id #uuid "ac43db8f-eb72-5379-ad90-7444b20614bc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3188/Source/Images/q-332920-a-1.png" :db/id #edb/ref 17592186164397} {:answer/id #uuid "0028624f-4d5e-54f6-adb4-21cf50012c7e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3188/Source/Images/q-332920-a-2.png" :db/id #edb/ref 17592186164398} {:answer/id #uuid "7604128f-2e78-5d31-a4e5-14d621b093e9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3188/Source/Images/q-332920-a-3.png" :db/id #edb/ref 17592186164399} {:answer/id #uuid "7a6f23f6-3aee-588d-a3b5-a87eb757b9de" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3188/Source/Images/q-332920-a-5.png" :db/id #edb/ref 17592186164400}] :answer-field/correct {:answer/id #uuid "ac43db8f-eb72-5379-ad90-7444b20614bc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3188/Source/Images/q-332920-a-1.png" :db/id #edb/ref 17592186164397} :answer-field/id #uuid "e4e9489f-6e99-5682-ae80-2e8eb0cd2e22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186164395}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c356d0ae-4461-596b-a446-f5773fdb52cc" :question/math-academy-id "q-332920" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/14ed16cc149ae777e195aa59e39cf809e939032a925e7acbd88cd685af99dd0e.png)\n\nA sketch of the phase space with nullclines and the corresponding direction field of tangents to the solutions of a system of differential equations is shown above (the tangents are not drawn to scale). Which of the following could represent the trajectory starting at the point marked on the graph?" :question/worked-solution "Let's sketch the trajectory.\n\n- We start at the given point and go along with the flow (straight to the right) until the trajectory intersects the $y$-nullcline, where the tangents are horizontal.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/0d010be8bad72bf4ebac4dbe2d325f1a1f194d78c676e2a62306b5c7d2af3c66.png)\n\n- Next, the flow continues going to the right  but then starts turning downward.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/5118424696b9602f10bf116c3a292e2fb58ed2f9acd2a9507888ab92a9b8986b.png)\n\n- After that, the trajectory continues to move rightward and bend downward, converging to the origin.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068149/assets/92a58573efafd7155cf02faf52e27ab968d9161ad448530b45673fd83a61fde1.png)"}]}
