#{[{:db/id #edb/ref 17592186351603 :knowledge-point/_questions [{:knowledge-point/id #uuid "634729e9-7633-52d8-99fa-b00fc9cbe96a" :knowledge-point/title "Raising a Matrix to a Large Power Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a82a6427-5f0c-5ad4-b6b6-8c6ad6a1715d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}32 & 24 \\\\ -20 & -44\\end{aligned}]" :db/id #edb/ref 17592186351605} {:answer/id #uuid "4c7a1cbe-47f8-5f2a-ad67-03c898ce4d42" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}36 & 20 \\\\ -44 & -28\\end{aligned}]" :db/id #edb/ref 17592186351606} {:answer/id #uuid "1d831391-a764-5275-9da6-af685e997707" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}40 & 24 \\\\ -48 & -28\\end{aligned}]" :db/id #edb/ref 17592186351607} {:answer/id #uuid "226c020b-96d7-5b65-92f4-12960d29bdb6" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}48 & 16 \\\\ -48 & -32\\end{aligned}]" :db/id #edb/ref 17592186351608} {:answer/id #uuid "189bb149-c13a-5813-9a9c-831eebb31939" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}40 & 36 \\\\ -32 & -24\\end{aligned}]" :db/id #edb/ref 17592186351609}] :answer-field/correct {:answer/id #uuid "1d831391-a764-5275-9da6-af685e997707" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}40 & 24 \\\\ -48 & -28\\end{aligned}]" :db/id #edb/ref 17592186351607} :answer-field/id #uuid "8e5399a4-d8e2-5590-ae53-e40c8018d40e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351604}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8edabc41-ebbe-529c-bd32-126001e5080e" :question/math-academy-id "q-140131" :question/problem "Find ${B}^{120},$ where\n\n$$\nB=[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}\\sqrt[60]{2} & 0 \\\\ 0 & \\sqrt[40]{2}\\end{aligned}][\\begin{aligned}4 & 3 \\\\ -3 & -2\\end{aligned}].\n$$" :question/worked-solution "First, notice that\n\n$$\n{[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}]}^{-1}=[\\begin{aligned}4 & 3 \\\\ -3 & -2\\end{aligned}].\n$$\n\nSo, we have been given the following diagonalization of $B:$\n\n$$\nB={{[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}\\sqrt[60]{2} & 0 \\\\ 0 & \\sqrt[40]{2}\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSince $B=PD{P}^{-1}$, we can compute ${B}^{k}$ by using the formula \n\n$$\n{B}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n$$\n\\begin{aligned}{B}^{120} & =P{D}^{120}{P}^{-1} \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}]{[\\begin{aligned}\\sqrt[60]{2} & 0 \\\\ 0 & \\sqrt[40]{2}\\end{aligned}]}^{120}[\\begin{aligned}4 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}(\\sqrt[60]{2})^{120} & 0 \\\\ 0 & (\\sqrt[40]{2})^{120}\\end{aligned}][\\begin{aligned}4 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}{2}^{2} & 0 \\\\ 0 & {2}^{3}\\end{aligned}][\\begin{aligned}4 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 3 & 4\\end{aligned}][\\begin{aligned}4 & 0 \\\\ 0 & 8\\end{aligned}][\\begin{aligned}4 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}-8 & -24 \\\\ 12 & 32\\end{aligned}][\\begin{aligned}4 & 3 \\\\ -3 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}40 & 24 \\\\ -48 & -28\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351610 :knowledge-point/_questions [{:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5" :knowledge-point/title "Finding the Eigenvalues and Eigenvectors of a Matrix Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23fb1ed3-a2dc-5c73-99e8-9f2fed3c6d7c" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}-5 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ -4\\end{aligned}]$" :db/id #edb/ref 17592186351612} {:answer/id #uuid "3be73b33-61a7-5671-bb2a-57845e335312" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}-3 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}-4 \\\\ 1\\end{aligned}]$" :db/id #edb/ref 17592186351613} {:answer/id #uuid "4719c52f-87a4-5a37-a13c-36ddd8099e87" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ and $[\\begin{aligned}4 \\\\ -3\\end{aligned}]$" :db/id #edb/ref 17592186351614} {:answer/id #uuid "487f9203-aef4-5aba-a054-e61d56749e84" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}-3 \\\\ -4\\end{aligned}]$ and $[\\begin{aligned}1 \\\\ 1\\end{aligned}]$" :db/id #edb/ref 17592186351615} {:answer/id #uuid "9da37729-24a6-5a71-b46a-a69fa1246c8e" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}4 \\\\ -3\\end{aligned}]$ and $[\\begin{aligned}-1 \\\\ -5\\end{aligned}]$" :db/id #edb/ref 17592186351616}] :answer-field/correct {:answer/id #uuid "4719c52f-87a4-5a37-a13c-36ddd8099e87" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ and $[\\begin{aligned}4 \\\\ -3\\end{aligned}]$" :db/id #edb/ref 17592186351614} :answer-field/id #uuid "fe0a94c5-b93e-56be-ab4a-2169283d3f8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351611}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "14bcb6ae-4402-5ddf-a38f-4702645af15f" :question/math-academy-id "q-140134" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $S$ given that \n\n$$\nS[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}]=[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}][\\begin{aligned}-5 & 0 \\\\ 0 & -3\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $B:$\n\n$$\nS={{[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}-5 & 0 \\\\ 0 & -3\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $S$ is diagonalizable. The eigenvalues of $S$ are ${\\lambda }_{1}=-5$ and ${\\lambda }_{2}=-3$ and the corresponding eigenvectors are the columns of the matrix $P:$\n\n$\\,$ ${v}_{1}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}4 \\\\ -3\\end{aligned}]$"}] [{:db/id #edb/ref 17592186124962 :knowledge-point/_questions [{:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5" :knowledge-point/title "Finding the Eigenvalues and Eigenvectors of a Matrix Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a2cfbdf5-7a12-50c7-8aeb-12200c63215d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$" :db/id #edb/ref 17592186122795} {:answer/id #uuid "ac79bc48-f741-58e5-a934-70d76f745277" :answer/type {:db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}2 \\\\ 0\\end{bmatrix}$ and $\\begin{bmatrix}0 \\\\ 3\\end{bmatrix}$" :db/id #edb/ref 17592186122796} {:answer/id #uuid "ee578321-16f6-590e-9916-36b7f8c167ff" :answer/type {:db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ -1\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ -2\\end{bmatrix}$" :db/id #edb/ref 17592186122797} {:answer/id #uuid "3a2722a5-497c-559c-a53f-aa17cc466294" :answer/type {:db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 1\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ 2\\end{bmatrix}$" :db/id #edb/ref 17592186122798} {:answer/id #uuid "4fd378c3-b003-5741-a6e9-3e2b15d6191b" :answer/type {:db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ 1\\end{bmatrix}$" :db/id #edb/ref 17592186122799}] :answer-field/correct {:answer/id #uuid "a2cfbdf5-7a12-50c7-8aeb-12200c63215d" :answer/type {:db/ident :answer.type/text} :answer/value "$\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}$ and $\\begin{bmatrix}2 \\\\ -1\\end{bmatrix}$" :db/id #edb/ref 17592186122795} :answer-field/id #uuid "8a9b4e15-e51f-5af1-83c5-1301e70ae602" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122794}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3186ab9d-e1b7-5f08-9515-496d883e1032" :question/math-academy-id "q-37270" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $B$ given that \n\n$$\nB[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]=[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}][\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), right-multiplying the equation by the inverse gives the following expression for $B:$\n\n$$\nB={{[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}2 & 0 \\\\ 0 & 3\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $B$ is diagonalizable. The eigenvalues of $B$ are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=3$ and the corresponding eigenvectors are the columns of the matrix $P:$\n\n$\\,$ ${v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}2 \\\\ -1\\end{aligned}]$"}] [{:db/id #edb/ref 17592186351617 :knowledge-point/_questions [{:knowledge-point/id #uuid "634729e9-7633-52d8-99fa-b00fc9cbe96a" :knowledge-point/title "Raising a Matrix to a Large Power Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff814f1f-861a-53df-8eab-c7d7c9933124" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & \\frac{3}{2} \\\\ 0 & 1\\end{aligned}]" :db/id #edb/ref 17592186351619} {:answer/id #uuid "00741376-4eeb-58cf-a42c-c862621f7b90" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{3} & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186351620} {:answer/id #uuid "9819ff40-49cf-5bf4-b9a0-6a1a026ef323" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}\\frac{2}{3} & 0 \\\\ 0 & -\\frac{2}{3}\\end{aligned}]" :db/id #edb/ref 17592186351621} {:answer/id #uuid "0d171951-79ba-52c1-834d-3c8a9583174d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & \\frac{2}{3} \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186351622} {:answer/id #uuid "39699e75-5337-509f-81fc-8edf04e08698" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186351623}] :answer-field/correct {:answer/id #uuid "0d171951-79ba-52c1-834d-3c8a9583174d" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}1 & \\frac{2}{3} \\\\ 0 & -1\\end{aligned}]" :db/id #edb/ref 17592186351622} :answer-field/id #uuid "eb1a21af-91d7-592e-8dd1-00a6de64dd10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351618}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "37a50d07-181f-50e1-b1a0-fc697fe75537" :question/math-academy-id "q-37625" :question/problem "Find ${A}^{69}$ where\n\n$$\nA=[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1}.\n$$" :question/worked-solution "We have been given the following diagonalization of $A.$\n\n$$\nA={{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}_{⏟}}_{P}{{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}_{⏟}}_{D}{{{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1}}_{⏟}}_{{P}^{-1}}\n$$\n\nSo, since $A=PD{P}^{-1}$, we can compute ${A}^{k}$ by using the formula \n\n$$\n{A}^{k}=P{D}^{k}{P}^{-1}.\n$$\n\nFirst, we find the inverse of the matrix $P.$ We get\n\n$$\n{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1}=\\frac{1}{12}[\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}].\n$$\n\nCarrying out the necessary multiplication, we obtain the following:\n\n \n\n$$\n\\begin{aligned}{A}^{69} & =P{D}^{69}{P}^{-1} \\\\  & =[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]{[\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}]}^{69}{[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}]}^{-1} \\\\  & =[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}{1}^{69} & 0 \\\\ 0 & (-1)^{69}\\end{aligned}](\\frac{1}{12}[\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}]) \\\\  & =\\frac{1}{12}[\\begin{aligned}-2 & 2 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}] \\\\  & =\\frac{1}{12}[\\begin{aligned}-2 & -2 \\\\ 0 & 6\\end{aligned}][\\begin{aligned}-6 & -2 \\\\ 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & \\frac{2}{3} \\\\ 0 & -1\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186351624 :knowledge-point/_questions [{:knowledge-point/id #uuid "237e9db9-a621-5abe-be24-d11ec63840d5" :knowledge-point/title "Finding the Eigenvalues and Eigenvectors of a Matrix Using the Properties of Diagonalization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "659cd68d-f5dd-5b66-ac34-b5466c67131d" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}2 \\\\ -3\\end{aligned}]$ and $[\\begin{aligned}-3 \\\\ 6\\end{aligned}]$" :db/id #edb/ref 17592186351626} {:answer/id #uuid "112ef994-5951-503c-b981-b847bee05629" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}2 \\\\ -6\\end{aligned}]$ and $[\\begin{aligned}-3 \\\\ 0\\end{aligned}]$" :db/id #edb/ref 17592186351627} {:answer/id #uuid "e8712716-eb93-5e81-9bb9-a32374876573" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}1 \\\\ -3\\end{aligned}]$ and $[\\begin{aligned}0 \\\\ 4\\end{aligned}]$" :db/id #edb/ref 17592186351628} {:answer/id #uuid "dfbe4327-d426-51eb-9566-12b46c2f2888" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}3 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-2 \\\\ 8\\end{aligned}]$" :db/id #edb/ref 17592186351629} {:answer/id #uuid "22832ab1-f59c-5ff5-ad21-6a9bbd92a87b" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}2 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-3 \\\\ 8\\end{aligned}]$" :db/id #edb/ref 17592186351630}] :answer-field/correct {:answer/id #uuid "22832ab1-f59c-5ff5-ad21-6a9bbd92a87b" :answer/type {:db/ident :answer.type/text} :answer/value "$[\\begin{aligned}2 \\\\ -5\\end{aligned}]$ and $[\\begin{aligned}-3 \\\\ 8\\end{aligned}]$" :db/id #edb/ref 17592186351630} :answer-field/id #uuid "ba40485b-f8f4-5729-9939-f38872ecda36" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186351625}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d7c42c03-63a2-5e8d-a07f-3d0a144353b5" :question/math-academy-id "q-86693" :question/problem "Find the eigenvectors of the $2\\times 2$ matrix $B$ given that \n\n$$\n[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]B=[\\begin{aligned}-2 & 0 \\\\ 0 & 7\\end{aligned}][\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}].\n$$" :question/worked-solution "Notice that the matrix $[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]$ appears on both sides of the equation. Since this matrix is invertible (its determinant is not zero), left-multiplying the equation by the inverse gives the following expression for $B:$ \n\n$$\nB={{{[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]}^{-1}}_{⏟}}_{P}{{[\\begin{aligned}-2 & 0 \\\\ 0 & 7\\end{aligned}]}_{⏟}}_{D}{{[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]}_{⏟}}_{{P}^{-1}}\n$$\n\nTherefore, $B$ is diagonalizable. The eigenvalues of $B$ are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=7$ and the corresponding eigenvectors are the columns of the matrix $P.$ Computing $P,$ we obtain\n\n$$\n\\begin{aligned}P={[\\begin{aligned}8 & 3 \\\\ 5 & 2\\end{aligned}]}^{-1}=\\frac{1}{1}[\\begin{aligned}2 & -3 \\\\ -5 & 8\\end{aligned}]=[\\begin{aligned}2 & -3 \\\\ -5 & 8\\end{aligned}].\\end{aligned}\n$$\n\nIn conclusion, the corresponding eigenvectors are: \n\n$\\,$ ${v}_{1}=[\\begin{aligned}2 \\\\ -5\\end{aligned}]\\,$ and $\\,{v}_{2}=[\\begin{aligned}-3 \\\\ 8\\end{aligned}]$"}]}
