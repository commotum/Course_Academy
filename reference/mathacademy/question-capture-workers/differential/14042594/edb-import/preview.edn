2594/assets/412e3e48aabdabf0dbdfce8e5b8e6e24c7558d50640bfb31ad4b642d9de39ff3.png) So, we take out the term ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/63890006ecc80706f3bce27717772762e7fb252410047a230519f4d926b5b988.png) from the left-hand side:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/9111081928de5b15aeca089185c43c60a70d9ca2f0eb96c9872ab04204b16297.png)\n\nWe now combine the series as follows:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/bc7ab05dbf97481578fcc8352d76608b3cfe2b7b4301af51eadd810c160a247b.png)\n\nFinally, by equating coefficients of ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/977bbc80efee8cdaf6667c4ced8e836d3fb77c53e232065541b1ed72594cada3.png) to zero, we obtain\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/04082d8431a1c86db2282e85065a089bd3cb18082ae278d03831bcde599e56f0.png)\n\nSolving for ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/fc1f5e662d05224ca25f4893c62389cc5d8b11acbae73f269a7921e097374b85.png) gives\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/683610152cf39c63fcf62ccdeadf1beed4ff8ef1cfb6a28452420974901cdd0c.png)\n\nTherefore, the recurrence relation is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/7ce940ebe652683318187b453d18127a4334b5c0dfef68da5e9a74e937f2d734.png)\n\nNote that every coefficient with an odd index equals ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/0021ff77f0c4565f235da704e0b4d45d1145486e46d721ea834cba941061b020.png) since ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042594/assets/ea7eeb2aa3909170b1ed83f408f8b17ec17d5012db54fd49910e85034899dbb8.png)" 13194139534875 true] [17592186147312 1145 "First, we find $y'(x)$:\n\n$$\n\\begin{aligned}\ny^{′}(x) &= (∑_(n = 0)^(∞)a_{n}x^{n})^{′} \\\\\n&= (a_{0} + ∑_(n = 1)^(∞)a_{n}x^{n})^{′} \\\\\n&= ∑_(n = 1)^(∞)na_{n}x^{n - 1}\n\\end{aligned}\n$$\n\nNow, we substitute the expressions for $y(x)$ and $y'(x)$ into the given differential equation:\n\n$$\n\\begin{aligned}\n∑_(n = 1)^(∞)na_{n}x^{n - 1} + 4x∑_(n = 0)^(∞)a_{n}x^{n} &= 0 \\\\\n∑_(n = 1)^(∞)na_{n}x^{n - 1} + ∑_(n = 0)^(∞)4a_{n}x^{n + 1} &= 0\n\\end{aligned}\n$$\n\nWe want to make the powers of $x$ the same. Therefore, in the first sum, we change the index of the summation by writing $m = n-1$. This gives\n\n$$\n\\sum_{m=0}^\\infty (m+1) a_{m+1} x^{m} + \\sum_{n=0}^\\infty 4a_n x^{n+1} =0\n$$\n\nNow, in the second series, we change the index of the summation by writing\n\n$$\nm = n+1\n$$\n\nThis gives\n\n$$\n\\sum_{m=0}^\\infty (m+1) a_{m+1} x^{m} + \\sum_{m=1}^\\infty 4a_{m-1} x^{m} =0\n$$\n\nReplacing $m$ with $n$ in both summations (since it does not matter which letter we use) gives\n\n$$\n\\sum_{n=0}^\\infty (n+1) a_{n+1} x^{n} + \\sum_{n=1}^\\infty 4 a_{n-1} x^{n} =0\n$$\n\nNext, we need to get two series starting with the same value of $n$. So, we take out the term $n = 0$ from the left-hand side:\n\n$$\na_1 + \\sum_{n=1}^\\infty (n+1) a_{n+1} x^{n} + \\sum_{n=1}^\\infty 4a_{n-1} x^{n} = 0\n$$\n\nWe now combine the series as follows:\n\n$$\n\\begin{aligned}\na_{1} + ∑_(n = 1)^(∞)[(n + 1)a_{n + 1}x^{n} + 4a_{n - 1}x^{n}] &= 0 \\\\\na_{1} + ∑_(n = 1)^(∞)[(n + 1)a_{n + 1} + 4a_{n - 1}]x^{n} &= 0\n\\end{aligned}\n$$\n\nFinally, by equating coefficients of $x^n$, we obtain\n\n$$\na_1 = 0, \\qquad (n+1) a_{n+1} = -4a_{n-1}\n$$\n\nSolving for $a_{n+1}$ gives\n\n$$\na_{n+1} = -\\dfrac{4a_{n-1}}{n+1}, \\quad n=1,2,3 \\ldots\n$$\n\nTherefore, the recurrence relation is\n\n$$\na_{n+1} = -\\dfrac{4a_{n-1}}{n+1}, \\quad a_1=0, \\quad n=1,2,3 \\ldots\n$$\n\nNote that every coefficient with an odd index equals to $0$, since $a_1=0$." 13194139534875 false] [17592186147380 1020 #edb/ref 17592186316662 13194139534875 true] [17592186147380 1020 #edb/ref 17592186316683 13194139534875 true] [17592186147380 1020 #edb/ref 17592186316718 13194139534875 true] [17592186147380 1020 #edb/ref 17592186316732 13194139534875 true] [17592186147380 1020 #edb/ref 17592186316739 13194139534875 true] [17592186147381 1020 #edb/ref 17592186316669 13194139534875 true] [17592186147381 1020 #edb/ref 17592186316690 13194139534875 true] [17592186147381 1020 #edb/ref 17592186316697 13194139534875 true] [17592186147381 1020 #edb/ref 17592186316725 13194139534875 true] [17592186147381 1020 #edb/ref 17592186316746 13194139534875 true] [17592186147382 1020 #edb/ref 17592186316676 13194139534875 true] [17592186147382 1020 #edb/ref 17592186316704 13194139534875 true] [17592186147382 1020 #edb/ref 17592186316711 13194139534875 true] [17592186147382 1020 #edb/ref 17592186316753 13194139534875 true] [17592186148115 1091 #edb/ref 17592186045464 13194139534875 true] [17592186148115 1100 "Let $y = ∑_(n = 0)^(∞)a_{n}x^{n}$ be a series solution to the equation $4y^{′} + xy = 0$.\n\nWhat is the recurrence relation for the coefficients $a_{n}$, where $n = 1, 2, 3, …$" 13194139534875 false] [17592186148115 1100 "Let $y={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}$ be a series solution to the equation $4{y}^{′}+xy=0.$\n\nWhat is the recurrence relation for the coefficients ${a}_{n},$ where $n=1,2,3,…$" 13194139534875 true] [17592186148115 1145 "First, we find ${y}^{′}(x):$\n\n$$\n\\begin{aligned}{y}^{′}(x) & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={({a}_{0}+{\\sum }_{n=1}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}\\end{aligned}\n$$\n\nNow we substitute the expressions for $y(x)$ and ${y}^{′}(x)$ into the given differential equation:\n\n$$\n\\begin{aligned}4{\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}+x{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n} & =0 \\\\ {\\sum }_{n=1}^{\\infty }4n{a}_{n}{x}^{n-1}+{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1} & =0\\end{aligned}\n$$\n\nWe want to make the powers of $x$ the same. Therefore, in the first sum, we change the index of the summation by writing $m=n-1.$ This gives\n\n$$\n{\\sum }_{m=0}^{\\infty }4(m+1){a}_{m+1}{x}^{m}+{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1}=0.\n$$\n\nNow, in the second series, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n{\\sum }_{m=0}^{\\infty }4(m+1){a}_{m+1}{x}^{m}+{\\sum }_{m=1}^{\\infty }{a}_{m-1}{x}^{m}=0.\n$$\n\nReplacing $m$ with $n$ in both summations (since it does not matter which letter we use) gives\n\n$$\n{\\sum }_{n=0}^{\\infty }4(n+1){a}_{n+1}{x}^{n}+{\\sum }_{n=1}^{\\infty }{a}_{n-1}{x}^{n}=0.\n$$\n\nNext, we need to get two series starting with the same value of $n.$ So, we take out the term $n=0$ from the left-hand side:\n\n$$\n4{a}_{1}+{\\sum }_{n=1}^{\\infty }4(n+1){a}_{n+1}{x}^{n}+{\\sum }_{n=1}^{\\infty }{a}_{n-1}{x}^{n}=0\n$$\n\nWe now combine the series, as follows:\n\n$$\n4{a}_{1}+{\\sum }_{n=1}^{\\infty }[4(n+1){a}_{n+1}+{a}_{n-1}]{x}^{n}=0\n$$\n\nFinally, by equating coefficients of ${x}^{n},$ we obtain\n\n$$\n{a}_{1}=0,\\,4(n+1){a}_{n+1}=-{a}_{n-1}.\n$$\n\nSolving for ${a}_{n+1}$ gives\n\n$$\n{a}_{n+1}=-\\frac{{a}_{n-1}}{4(n+1)},\\,n=1,2,3,….\n$$\n\nNote that every coefficient with an odd index is equal to $0,$ since ${a}_{1}=0.$" 13194139534875 true] [17592186316662 1017 #edb/ref 17592186316663 13194139534875 true] [17592186316662 1089 "q-101381" 13194139534875 true] [17592186316662 1091 #edb/ref 17592186045463 13194139534875 true] [17592186316662 1100 "Let $y={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}$ be a series solution to the equation $3{y}^{′}-4y=0.$ \n\nWhat is the recurrence relation for the coefficients ${a}_{n},$ where $n=0,1,2,…?$" 13194139534875 true] [17592186316662 1113 #uuid "ac34c253-b1a1-583e-93d2-70299030c461" 13194139534875 true] [17592186316662 1145 "First, we find ${y}^{′}(x):$\n\n$$\n\\begin{aligned}{y}^{′}(x) & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={({a}_{0}+{\\sum }_{n=1}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & =0+{\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}\\end{aligned}\n$$\n\nNow we substitute expressions for $y(x)$ and ${y}^{′}(x)$ into the given differential equation:\n\n$$\n\\begin{aligned}3{\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}-4{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n} & =0\\end{aligned}\n$$\n\nWe want to make the powers of $x$ the same. Therefore, in the first sum, we change the index of the summation by writing $m=n-1.$ This gives\n\n$$\n\\begin{aligned}3{\\sum }_{m=0}^{\\infty }(m+1){a}_{m+1}{x}^{m}-4{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n} & =0.\\end{aligned}\n$$\n\nReplacing $m$ with $n$ in the first summation (since it does not matter which letter we use) gives\n\n$$\n\\begin{aligned}3{\\sum }_{n=0}^{\\infty }(n+1){a}_{n+1}{x}^{n}-4{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n} & =0.\\end{aligned}\n$$\n\nSince both sums now start with $n=0,$ we can combine them as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=0}^{\\infty }[3(n+1){a}_{n+1}-4{a}_{n}]{x}^{n} & =0\\end{aligned}\n$$\n\nSetting each coefficient of $x$ equal to zero, we obtain\n\n$$\n3(n+1){a}_{n+1}-4{a}_{n}=0.\n$$\n\nFinally, the recursion formula is\n\n$$\n{a}_{n+1}=\\frac{4{a}_{n}}{3(n+1)},\\,n=0,1,2,….\n$$" 13194139534875 true] [17592186316663 1000 #edb/ref 17592186316664 13194139534875 true] [17592186316663 1000 #edb/ref 17592186316665 13194139534875 true] [17592186316663 1000 #edb/ref 17592186316666 13194139534875 true] [17592186316663 1000 #edb/ref 17592186316667 13194139534875 true] [17592186316663 1000 #edb/ref 17592186316668 13194139534875 true] [17592186316663 1040 #edb/ref 17592186045450 13194139534875 tru