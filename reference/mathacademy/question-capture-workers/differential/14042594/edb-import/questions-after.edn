=0}^{\\infty }{a}_{n}{x}^{n} & =0.\\end{aligned}\n$$\n\nSince both sums now start with $n=0,$ we can combine them as follows:\n\n$$\n\\begin{aligned}{\\sum }_{n=0}^{\\infty }[3(n+1){a}_{n+1}-{a}_{n}]{x}^{n} & =0\\end{aligned}\n$$\n\nSetting each coefficient of $x$ equal to zero, we obtain\n\n$$\n3(n+1){a}_{n+1}-{a}_{n}=0.\n$$\n\nFinally, the recursion formula is\n\n$$\n{a}_{n+1}=\\frac{{a}_{n}}{3(n+1)},\\,n=0,1,2,….\n$$"}] [{:db/id #edb/ref 17592186316746 :knowledge-point/_questions [{:knowledge-point/id #uuid "1980ddeb-37bf-5234-8888-f8292e2c9405" :knowledge-point/title "Calculating the Recurrence Relation For a Second-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "38613dba-7e75-52bc-8e63-ae8a21f22187" :answer/type {:db/ident :answer.type/math} :answer/value "f(n)=-3(n+1)(n+2)" :db/id #edb/ref 17592186316748} {:answer/id #uuid "d2a78034-d04d-5bf2-92de-eacbf4e23d5f" :answer/type {:db/ident :answer.type/math} :answer/value "f(n)=-n(n+3)" :db/id #edb/ref 17592186316749} {:answer/id #uuid "324aa07a-a79a-50ca-a282-6966c9a15158" :answer/type {:db/ident :answer.type/math} :answer/value "f(n)=-3n(3n+1)" :db/id #edb/ref 17592186316750} {:answer/id #uuid "045588b0-7288-5a91-9d78-5fcbcfc05ed8" :answer/type {:db/ident :answer.type/math} :answer/value "f(n)=3(n+2)(n+3)" :db/id #edb/ref 17592186316751} {:answer/id #uuid "8acd55b2-407f-5637-810e-b977ac1dd1a6" :answer/type {:db/ident :answer.type/math} :answer/value "f(n)=n(2n+3)" :db/id #edb/ref 17592186316752}] :answer-field/correct {:answer/id #uuid "38613dba-7e75-52bc-8e63-ae8a21f22187" :answer/type {:db/ident :answer.type/math} :answer/value "f(n)=-3(n+1)(n+2)" :db/id #edb/ref 17592186316748} :answer-field/id #uuid "86b841a0-6081-523b-8721-72c7e84cda0b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316747}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bb00de42-236c-5869-bf37-8a4664305356" :question/math-academy-id "q-64531" :question/problem "Let $y={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}$ be a series solution to the equation $3{y}^{″}+y=0.$  Find $f(n),$ given that the recurrence relation for ${a}_{n}$ can be written as\n\n$$\n{a}_{n+2}=\\frac{{a}_{n}}{f(n)},\\,n=0,1,2,…\n$$" :question/worked-solution "First, we find ${y}^{′}(x):$\n\n$$\n\\begin{aligned}{y}^{′}(x) & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={({a}_{0}+{\\sum }_{n=1}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & =0+{\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1} \\\\  & ={\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}\\end{aligned}\n$$\n\nSimilarly, we find ${y}^{″}(x):$\n\n$$\n\\begin{aligned}{y}^{″}(x) & ={({\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1})}^{′} \\\\  & ={({a}_{1}+{\\sum }_{n=2}^{\\infty }n{a}_{n}{x}^{n-1})}^{′} \\\\  & =0+{\\sum }_{n=2}^{\\infty }n(n-1){a}_{n}{x}^{n-2} \\\\  & ={\\sum }_{n=2}^{\\infty }n(n-1){a}_{n}{x}^{n-2}\\end{aligned}\n$$\n\nNow we substitute the expressions for $y(x)$ and ${y}^{″}(x)$ into the given differential equation:\n\n$$\n3{\\sum }_{n=2}^{\\infty }n(n-1){a}_{n}{x}^{n-2}+{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}=0\n$$\n\nWe want to make the powers of $x$ the same. Therefore, in the first sum, we change the index of the summation by writing $m=n-2.$ This gives\n\n$$\n3{\\sum }_{m=0}^{\\infty }(m+2)(m+1){a}_{m+2}{x}^{m}+{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}=0.\n$$\n\nReplacing $m$ with $n$ in the first summation (since it does not matter which letter we use) gives\n\n$$\n3{\\sum }_{n=0}^{\\infty }(n+2)(n+1){a}_{n+2}{x}^{n}+{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}=0.\n$$\n\nSince both sums now start with $n=0,$ we can combine them as follows:\n\n$$\n{\\sum }_{n=0}^{\\infty }[3(n+2)(n+1){a}_{n+2}+{a}_{n}]{x}^{n}=0\n$$\n\nSetting each coefficient of $x$ equal to zero, we obtain\n\n$$\n3(n+2)(n+1){a}_{n+2}+{a}_{n}=0.\n$$\n\nFinally, the recursion formula is\n\n$$\n{a}_{n+2}=-\\frac{{a}_{n}}{3(n+1)(n+2)},\\,n=0,1,2,…\n$$\n\nTherefore, $f(n)=-3(n+1)(n+2).$"}] [{:db/id #edb/ref 17592186316753 :knowledge-point/_questions [{:knowledge-point/id #uuid "37ab3f10-aca4-5094-98d2-0de9c11fd711" :knowledge-point/title "Calculating the Recurrence Relation For a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71dad90f-280e-5dee-9ce4-e5faaa1ff6e9" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{n+1}=7n{a}_{n}" :db/id #edb/ref 17592186316755} {:answer/id #uuid "0c618fa7-b080-5c03-970f-00f749c6aaf7" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{n+1}=-7n{a}_{n-1}" :db/id #edb/ref 17592186316756} {:answer/id #uuid "804642e8-626d-5770-9537-9d0a993fdd90" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{n+1}=-7(n+1){a}_{n-1}" :db/id #edb/ref 17592186316757} {:answer/id #uuid "5a1dbfcf-f094-5db6-a78f-8d2e204ab2bf" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{n+1}=\\frac{{a}_{n-1}}{7(n+1)}" :db/id #edb/ref 17592186316758} {:answer/id #uuid "320295b1-f16a-58cc-a443-623b6e5bf185" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{n+1}=-\\frac{7{a}_{n-1}}{n+1}" :db/id #edb/ref 17592186316759}] :answer-field/correct {:answer/id #uuid "320295b1-f16a-58cc-a443-623b6e5bf185" :answer/type {:db/ident :answer.type/math} :answer/value "{a}_{n+1}=-\\frac{7{a}_{n-1}}{n+1}" :db/id #edb/ref 17592186316759} :answer-field/id #uuid "cdcc0029-6c41-5f3d-87ce-0cfdf54aaf58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316754}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "410df22e-fae0-5291-8e4b-8ae39b283772" :question/math-academy-id "q-64536" :question/problem "Let $y={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}$ be a series solution to the equation ${y}^{′}+7xy=0.$\n\nWhat is the recurrence relation for the coefficients ${a}_{n},$ where $n=1,2,3,…$" :question/worked-solution "First, we find ${y}^{′}(x):$\n\n$$\n\\begin{aligned}{y}^{′}(x) & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={({a}_{0}+{\\sum }_{n=1}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}\\end{aligned}\n$$\n\nNow we substitute the expressions for $y(x)$ and ${y}^{′}(x)$ into the given differential equation:\n\n$$\n\\begin{aligned}{\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}+7x{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n} & =0 \\\\ {\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}+7{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1} & =0\\end{aligned}\n$$\n\nWe want to make the powers of $x$ the same. Therefore, in the first sum, we change the index of the summation by writing $m=n-1.$ This gives\n\n$$\n{\\sum }_{m=0}^{\\infty }(m+1){a}_{m+1}{x}^{m}+7{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1}=0.\n$$\n\nNow, in the second series, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n{\\sum }_{m=0}^{\\infty }(m+1){a}_{m+1}{x}^{m}+7{\\sum }_{m=1}^{\\infty }{a}_{m-1}{x}^{m}=0.\n$$\n\nReplacing $m$ with $n$ in both summations (since it does not matter which letter we use) gives\n\n$$\n{\\sum }_{n=0}^{\\infty }(n+1){a}_{n+1}{x}^{n}+7{\\sum }_{n=1}^{\\infty }{a}_{n-1}{x}^{n}=0.\n$$\n\nNext, we need to get two series starting with the same value of $n.$ So, we take out the term $n=0$ from the left-hand side:\n\n$$\n{a}_{1}+{\\sum }_{n=1}^{\\infty }(n+1){a}_{n+1}{x}^{n}+7{\\sum }_{n=1}^{\\infty }{a}_{n-1}{x}^{n}=0\n$$\n\nWe now combine the series, as follows:\n\n$$\n{a}_{1}+{\\sum }_{n=1}^{\\infty }[(n+1){a}_{n+1}+7{a}_{n-1}]{x}^{n}=0\n$$\n\nFinally, by equating coefficients of ${x}^{n},$ we obtain\n\n$$\n{a}_{1}=0,\\,(n+1){a}_{n+1}=-7{a}_{n-1}.\n$$\n\nSolving for ${a}_{n+1}$ gives\n\n$$\n{a}_{n+1}=-\\frac{7{a}_{n-1}}{n+1},\\,n=1,2,3,….\n$$\n\nNote that every coefficient with an odd index is equal to $0,$ since ${a}_{1}=0.$"}] [{:db/id #edb/ref 17592186148115 :knowledge-point/_questions [{:knowledge-point/id #uuid "37ab3f10-aca4-5094-98d2-0de9c11fd711" :knowledge-point/title "Calculating the Recurrence Relation For a First-Order Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97c58615-eabe-56a5-8d57-5232a34e01a7" :answer/type {:db/ident :answer.type/math} :answer/value "a_{n + 1} = 4(n + 1)a_{n - 1}" :db/id #edb/ref 17592186146702} {:answer/id #uuid "b86755ee-c3fd-5fb0-a0df-07ffdc9d6979" :answer/type {:db/ident :answer.type/math} :answer/value "a_{n + 1} =-\\frac{a_{n - 1}}{4n + 1}" :db/id #edb/ref 17592186146703} {:answer/id #uuid "06510bc2-4240-594e-89af-34233914a4e6" :answer/type {:db/ident :answer.type/math} :answer/value "a_{n + 1} = \\frac{4a_{n - 1}}{n + 1}" :db/id #edb/ref 17592186146704} {:answer/id #uuid "20e015e5-d612-53cb-a6f7-bb7752c9afa4" :answer/type {:db/ident :answer.type/math} :answer/value "a_{n + 1} = - (a_{n - 1})/(4(n + 1))" :db/id #edb/ref 17592186146705} {:answer/id #uuid "6f3d3cce-09b1-5dc1-9cf4-5962f7619d0e" :answer/type {:db/ident :answer.type/math} :answer/value "a_{n + 1} =-4na_{n - 1}" :db/id #edb/ref 17592186146706}] :answer-field/correct {:answer/id #uuid "20e015e5-d612-53cb-a6f7-bb7752c9afa4" :answer/type {:db/ident :answer.type/math} :answer/value "a_{n + 1} = - (a_{n - 1})/(4(n + 1))" :db/id #edb/ref 17592186146705} :answer-field/id #uuid "026d0872-6d45-5b59-bf44-af1b00d0735a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146701}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "13a532bd-febd-559f-9c5a-ce92173249b3" :question/math-academy-id "q-64541" :question/problem "Let $y={\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n}$ be a series solution to the equation $4{y}^{′}+xy=0.$\n\nWhat is the recurrence relation for the coefficients ${a}_{n},$ where $n=1,2,3,…$" :question/worked-solution "First, we find ${y}^{′}(x):$\n\n$$\n\\begin{aligned}{y}^{′}(x) & ={({\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={({a}_{0}+{\\sum }_{n=1}^{\\infty }{a}_{n}{x}^{n})}^{′} \\\\  & ={\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}\\end{aligned}\n$$\n\nNow we substitute the expressions for $y(x)$ and ${y}^{′}(x)$ into the given differential equation:\n\n$$\n\\begin{aligned}4{\\sum }_{n=1}^{\\infty }n{a}_{n}{x}^{n-1}+x{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n} & =0 \\\\ {\\sum }_{n=1}^{\\infty }4n{a}_{n}{x}^{n-1}+{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1} & =0\\end{aligned}\n$$\n\nWe want to make the powers of $x$ the same. Therefore, in the first sum, we change the index of the summation by writing $m=n-1.$ This gives\n\n$$\n{\\sum }_{m=0}^{\\infty }4(m+1){a}_{m+1}{x}^{m}+{\\sum }_{n=0}^{\\infty }{a}_{n}{x}^{n+1}=0.\n$$\n\nNow, in the second series, we change the index of the summation by writing $m=n+1.$ This gives\n\n$$\n{\\sum }_{m=0}^{\\infty }4(m+1){a}_{m+1}{x}^{m}+{\\sum }_{m=1}^{\\infty }{a}_{m-1}{x}^{m}=0.\n$$\n\nReplacing $m$ with $n$ in both summations (since it does not matter which letter we use) gives\n\n$$\n{\\sum }_{n=0}^{\\infty }4(n+1){a}_{n+1}{x}^{n}+{\\sum }_{n=1}^{\\infty }{a}_{n-1}{x}^{n}=0.\n$$\n\nNext, we need to get two series starting with the same value of $n.$ So, we take out the term $n=0$ from the left-hand side:\n\n$$\n4{a}_{1}+{\\sum }_{n=1}^{\\infty }4(n+1){a}_{n+1}{x}^{n}+{\\sum }_{n=1}^{\\infty }{a}_{n-1}{x}^{n}=0\n$$\n\nWe now combine the series, as follows:\n\n$$\n4{a}_{1}+{\\sum }_{n=1}^{\\infty }[4(n+1){a}_{n+1}+{a}_{n-1}]{x}^{n}=0\n$$\n\nFinally, by equating coefficients of ${x}^{n},$ we obtain\n\n$$\n{a}_{1}=0,\\,4(n+1){a}_{n+1}=-{a}_{n-1}.\n$$\n\nSolving for ${a}_{n+1}$ gives\n\n$$\n{a}_{n+1}=-\\frac{{a}_{n-1}}{4(n+1)},\\,n=1,2,3,….\n$$\n\nNote that every coefficient with an odd index is equal to $0,$ since ${a}_{1}=0.$"}]}
