c{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =2xy\\,\\text{d}x+({x}^{2}+\\frac{1}{2\\sqrt{y}})\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(0,4),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,4) & =2\\cdot 0\\cdot 4\\,\\text{d}x+({0}^{2}+\\frac{1}{2\\sqrt{4}})\\,\\text{d}y \\\\  & =0\\,\\text{d}x+\\frac{1}{4}\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,4+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+\\frac{1}{4}\\,Δy.\n$$\n\nMoving from $(0,4)$ to $(-1,5),$ we have\n\n$$\n\\begin{aligned}Δx & =-1-0=-1, \\\\ Δy & =5-4=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\,Δx+\\frac{1}{4}\\,Δy \\\\  & ≈0\\cdot (-1)+\\frac{1}{4}\\cdot (1) \\\\  & ≈0.25.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $0.25.$" 13194139535223 true] [17592186338462 1000 #edb/ref 17592186338463 13194139535223 true] [17592186338462 1000 #edb/ref 17592186338464 13194139535223 true] [17592186338462 1000 #edb/ref 17592186338465 13194139535223 true] [17592186338462 1000 #edb/ref 17592186338466 13194139535223 true] [17592186338462 1000 #edb/ref 17592186338467 13194139535223 true] [17592186338462 1040 #edb/ref 17592186045450 13194139535223 true] [17592186338462 1041 "selection" 13194139535223 true] [17592186338462 1104 #edb/ref 17592186338463 13194139535223 true] [17592186338462 1110 #uuid "45ff3702-d8e8-5826-912c-9b84a056c099" 13194139535223 true] [17592186338463 1034 "0.25" 13194139535223 true] [17592186338463 1103 #edb/ref 17592186045453 13194139535223 true] [17592186338463 1111 #uuid "dd8a7e49-44a5-5eb2-aa5f-e188de230361" 13194139535223 true] [17592186338464 1034 "-0.25" 13194139535223 true] [17592186338464 1103 #edb/ref 17592186045453 13194139535223 true] [17592186338464 1111 #uuid "b63ddff9-84da-5e06-acd2-bd26bff884c6" 13194139535223 true] [17592186338465 1034 "1.25" 13194139535223 true] [17592186338465 1103 #edb/ref 17592186045453 13194139535223 true] [17592186338465 1111 #uuid "4ec500fb-9d6b-535f-885b-c3e6cea4a712" 13194139535223 true] [17592186338466 1034 "0.5" 13194139535223 true] [17592186338466 1103 #edb/ref 17592186045453 13194139535223 true] [17592186338466 1111 #uuid "4c9f1a93-50dc-520d-b3f6-034e4c8f70a9" 13194139535223 true] [17592186338467 1034 "-0.5" 13194139535223 true] [17592186338467 1103 #edb/ref 17592186045453 13194139535223 true] [17592186338467 1111 #uuid "a5ad2ee9-88ff-5e3c-bf97-74242a23b602" 13194139535223 true] [17592186338468 1017 #edb/ref 17592186338469 13194139535223 true] [17592186338468 1089 "q-79813" 13194139535223 true] [17592186338468 1091 #edb/ref 17592186045463 13194139535223 true] [17592186338468 1100 "If $f(x,y)=xy+x{e}^{y},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(2,0)$ to $(1,-0.5).$" 13194139535223 true] [17592186338468 1113 #uuid "15304540-cd8c-5704-ac94-52aa9f0b8729" 13194139535223 true] [17592186338468 1145 "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(y+{e}^{y})\\,\\text{d}x+(x+x{e}^{y})\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,0) & =(0+{e}^{0})\\,\\text{d}x+(2+2\\cdot {e}^{0})\\,\\text{d}y \\\\  & =1\\,\\text{d}x+4\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+4\\,Δy.\n$$\n\nMoving from $(2,0)$ to $(1,-0.5),$ we have\n\n$$\n\\begin{aligned}Δx & =1-2=-1, \\\\ Δy & =-0.5-0=-0.5.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+4\\,Δy \\\\  & ≈1\\cdot (-1)+4\\cdot (-0.5) \\\\  & ≈-3.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ decreases by approximately $3.$" 13194139535223 true] [17592186338469 1000 #edb/ref 17592186338470 13194139535223 true] [17592186338469 1000 #edb/ref 17592186338471 13194139535223 true] [17592186338469 1000 #edb/ref 1759