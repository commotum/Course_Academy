38661d985b56a883058df0c3f"] :db/ensure [:answer-field/validate]} {:db/id "q-79742" :question/id #uuid "e5e954b3-7b19-5111-a9b1-97da95bb6c84" :question/math-academy-id "q-79742" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)=\\operatorname{ln}⁡({x}^{2}+y+{z}^{3}).$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =\\frac{2x\\,\\text{d}x}{{x}^{2}+y+{z}^{3}}+\\frac{\\text{d}y}{{x}^{2}+y+{z}^{3}}+\\frac{3{z}^{2}\\,\\text{d}z}{{x}^{2}+y+{z}^{3}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79742/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667"] :knowledge-point/questions ["q-79742"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79739/selection/0a3b02005247ec2bbaaa106ac25a3f9eda8c288f21b2991f27afe6555b7700fb" :answer/id #uuid "6f7d7b48-d777-5bde-a527-4096206df7af" :answer/type :answer.type/math :answer/value "({x}^{3}-3{y}^{2})\\text{d}x+(2x+3{x}^{2}y)\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79739/selection/85facba8637ae9c37485e7bf7841584814be2a6428a9bcdcdc20ef6e6bd1bd6d" :answer/id #uuid "c8904ec3-049b-5e77-b477-9b4a5375ee4d" :answer/type :answer.type/math :answer/value "(2x+3{x}^{2})\\text{d}x+({x}^{3}-{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79739/selection/3d9f1ed70440b0cfac1f05c7dfe366d43779250d41f18d65110b254b825b684d" :answer/id #uuid "1d6e71fe-a320-54fb-8bf9-a4c2dd064d5b" :answer/type :answer.type/math :answer/value "(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79739/selection/2f63528d696d6942d3fd969a0ce2700307a27cf2de5ef12583efcf7bc4634530" :answer/id #uuid "2e210cd7-3f99-5169-88f7-0dbc6f4eb71b" :answer/type :answer.type/math :answer/value "(2x+3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{2}+{x}^{3}-3{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79739/selection/7970b7b2ebaee0259b43b6e98937577dde41a786abe093c63b06e3264f1df967" :answer/id #uuid "e0c3a8be-af34-5c06-844e-80ebeed48651" :answer/type :answer.type/math :answer/value "(3{x}^{2}y-{y}^{3})\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79739/selection" :answer-field/id #uuid "a57af259-1b0e-5aa1-b2e3-3cb083ce5a75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79739/selection/3d9f1ed70440b0cfac1f05c7dfe366d43779250d41f18d65110b254b825b684d" :answer-field/choices ["q-79739/selection/0a3b02005247ec2bbaaa106ac25a3f9eda8c288f21b2991f27afe6555b7700fb" "q-79739/selection/85facba8637ae9c37485e7bf7841584814be2a6428a9bcdcdc20ef6e6bd1bd6d" "q-79739/selection/3d9f1ed70440b0cfac1f05c7dfe366d43779250d41f18d65110b254b825b684d" "q-79739/selection/2f63528d696d6942d3fd969a0ce2700307a27cf2de5ef12583efcf7bc4634530" "q-79739/selection/7970b7b2ebaee0259b43b6e98937577dde41a786abe093c63b06e3264f1df967"] :db/ensure [:answer-field/validate]} {:db/id "q-79739" :question/id #uuid "b322579f-6a5d-5a60-9e95-cf23bfdd0f6f" :question/math-academy-id "q-79739" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)={x}^{2}+{x}^{3}y-{y}^{3}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79739/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667"] :knowledge-point/questions ["q-79739"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37307"] :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y)=\\operatorname{ln}⁡(x+{y}^{2}).$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\text{d}x}{x+{y}^{2}}+\\frac{2y\\,\\text{d}y}{x+{y}^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-37308"] :question/problem "Given a cylinder, find the differential $\\text{d}V$ for the volume $V$ of the cylinder if the radius is $r=2$ and the height is $h=4.$" :question/worked-solution "The volume of the cylinder is $V=\\pi {r}^{2}h.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(r,h) & =(\\frac{∂V}{∂r})\\,\\text{d}r+(\\frac{∂V}{∂h})\\,\\text{d}h \\\\  & =2\\pi rh\\,\\text{d}r+\\pi {r}^{2}\\,\\text{d}h\\end{aligned}\n$$\n\nFor $r=2$ and $h=4,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(2,4) & =2\\pi \\cdot 2\\cdot 4\\,\\text{d}r+\\pi \\cdot {2}^{2}\\,\\text{d}h \\\\  & =16\\pi \\,\\text{d}r+4\\pi \\,\\text{d}h.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-79746/selection/3df8de385ea37f81d6213c42160ad637180030c2fbd2ccd46ff7b572410606f4" :answer/id #uuid "d5cac7a4-46af-555c-9c0c-2c2e740a76b6" :answer/type :answer.type/math :answer/value "4\\,\\text{d}a+5\\,\\text{d}b+10\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "q-79746/selection/c294eca78368771556766d95f8bb760b47747051c177ce7a4dfee33c62752e4e" :answer/id #uuid "c538e2cd-8d1b-5596-aa21-b9ed6fa6490b" :answer/type :answer.type/math :answer/value "2\\,\\text{d}a+5\\,\\text{d}b+4\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "q-79746/selection/a1398a2d330be57fcd3bdd4f1bf4bb7c4dd207a07bb8b4a322742d6513260e5f" :answer/id #uuid "e6a9cbb7-dd32-556b-9a6f-cad565b447d9" :answer/type :answer.type/math :answer/value "4\\,\\text{d}a+10\\,\\text{d}b+2\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "q-79746/selection/c56449c9aa47d872d5654b98688a8546f89e4dcb80a8a35162690ecb6ecd8a7e" :answer/id #uuid "65b26759-b0a8-503d-9815-8be3f6b0f7ee" :answer/type :answer.type/math :answer/value "5\\,\\text{d}a+25\\,\\text{d}b+4\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "q-79746/selection/8e15f15dcb224901b05e59a0fc99cdf9b55b5bfa8de61a0d71283ca1fcbab2c6" :answer/id #uuid "b8ed600a-5be6-506b-b39e-adaa571f4ba8" :answer/type :answer.type/math :answer/value "5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c" :db/ensure [:answer/validate]} {:db/id "q-79746/selection" :answer-field/id #uuid "1d50eb7a-d236-5781-928f-7c8bc422f0e7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79746/selection/8e15f15dcb224901b05e59a0fc99cdf9b55b5bfa8de61a0d71283ca1fcbab2c6" :answer-field/choices ["q-79746/selection/3df8de385ea37f81d6213c42160ad637180030c2fbd2ccd46ff7b572410606f4" "q-79746/selection/c294eca78368771556766d95f8bb760b47747051c177ce7a4dfee33c62752e4e" "q-79746/selection/a1398a2d330be57fcd3bdd4f1bf4bb7c4dd207a07bb8b4a322742d6513260e5f" "q-79746/selection/c56449c9aa47d872d5654b98688a8546f89e4dcb80a8a35162690ecb6ecd8a7e" "q-79746/selection/8e15f15dcb224901b05e59a0fc99cdf9b55b5bfa8de61a0d71283ca1fcbab2c6"] :db/ensure [:answer-field/validate]} {:db/id "q-79746" :question/id #uuid "480ed0ae-75be-53e3-a415-b9cdb724ffd4" :question/math-academy-id "q-79746" :question/problem "Given a rectangular solid, find the differential $\\text{d}V$ for the volume $V$ of the rectangular solid if the lengths of the sides are $a=2,$ $b=5,$ and $c=1.$" :question/worked-solution "The volume of the rectangular solid is $V=abc.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,b,c) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂b})\\,\\text{d}b+(\\frac{∂V}{∂c})\\,\\text{d}c \\\\  & =bc\\,\\text{d}a+ac\\,\\text{d}b+ab\\,\\text{d}c\\end{aligned}\n$$\n\nFor $a=2,$ $b=5,$ and $c=1,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(2,5,1) & =5\\cdot 1\\,\\text{d}a+2\\cdot 1\\,\\text{d}b+5\\cdot 2\\,\\text{d}c \\\\  & =5\\,\\text{d}a+2\\,\\text{d}b+10\\,\\text{d}c.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79746/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb"] :knowledge-point/questions ["q-79746"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79745/selection/7c1ecb73e3f816982f466a1b5e077f7ca17d154cf1e70cb38e976fb6302d6c03" :answer/id #uuid "93d7973b-8d49-51e6-a99f-10b66315aff5" :answer/type :answer.type/math :answer/value "20\\,\\text{d}a+12\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79745/selection/82278f7f4f9acda0a7b55cea16fc07512f1f94c14bfc73b42ee7811e4fcab1e0" :answer/id #uuid "8c03b9b3-8c0a-599c-ac7a-98c129752ca4" :answer/type :answer.type/math :answer/value "20\\,\\text{d}a+10\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79745/selection/d0d1799d18a7a588350180a78156265490df1355191479a9abe66b96ff34c2fd" :answer/id #uuid "4b735f67-8cba-5668-8676-0ea01106840e" :answer/type :answer.type/math :answer/value "30\\,\\text{d}a+15\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79745/selection/fde7ac51eb4748e289679fa9424d15e0225fec62f6c913b0227b81b609cb2c4c" :answer/id #uuid "980da7f4-cc2b-580b-8c32-040f308090ff" :answer/type :answer.type/math :answer/value "10\\,\\text{d}a+15\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79745/selection/1ff857f7884853dd0af8be99041d0eab71e5cebd1858e4770259d6910035beb5" :answer/id #uuid "42f9271d-eae0-56e7-9ee6-5c5504d56e35" :answer/type :answer.type/math :answer/value "30\\,\\text{d}a+12\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79745/selection" :answer-field/id #uuid "fd52fd15-55cf-59b6-a257-dcb70f56f994" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79745/selection/7c1ecb73e3f816982f466a1b5e077f7ca17d154cf1e70cb38e976fb6302d6c03" :answer-field/choices ["q-79745/selection/7c1ecb73e3f816982f466a1b5e077f7ca17d154cf1e70cb38e976fb6302d6c03" "q-79745/selection/82278f7f4f9acda0a7b55cea16fc07512f1f94c14bfc73b42ee7811e4fcab1e0" "q-79745/selection/d0d1799d18a7a588350180a78156265490df1355191479a9abe66b96ff34c2fd" "q-79745/selection/fde7ac51eb4748e289679fa9424d15e0225fec62f6c913b0227b81b609cb2c4c" "q-79745/selection/1ff857f7884853dd0af8be99041d0eab71e5cebd1858e4770259d6910035beb5"] :db/ensure [:answer-field/validate]} {:db/id "q-79745" :question/id #uuid "385e16b4-f8da-593a-b039-318c70552c9e" :question/math-academy-id "q-79745" :question/problem "Given a rectangular pyramid, find the differential $\\text{d}V$ for the volume $V$ of the rectangular pyramid if the base is a square with the side of $a=6$ and the height is $h=5.$" :question/worked-solution "The volume of the rectangular pyramid is $V=\\frac{1}{3}{a}^{2}h.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,h) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂h})\\,\\text{d}h \\\\  & =\\frac{2ah}{3}\\,\\text{d}a+\\frac{{a}^{2}}{3}\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=6$ and $h=5,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(6,5) & =\\frac{2\\cdot 6\\cdot 5}{3}\\,\\text{d}a+\\frac{{6}^{2}}{3}\\,\\text{d}h \\\\  & =20\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79745/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb"] :knowledge-point/questions ["q-79745"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79958/selection/5dfb90a19bf3417a362bf876a7fa097a215000885598e66ffcb13a70187b57bd" :answer/id #uuid "fa44f3c6-8769-51eb-805e-e8f137d31288" :answer/type :answer.type/math :answer/value "\\frac{3}{10}\\,\\text{d}r+\\frac{2}{5}\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79958/selection/6d8368f816eaf00c7085cf88e5cb9b61236c6cd926238a192aeb0bcc79e7c4be" :answer/id #uuid "c4f626ac-ae43-552c-8347-f73795ee47b9" :answer/type :answer.type/math :answer/value "\\frac{4}{5}\\,\\text{d}r+\\frac{3}{5}\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79958/selection/c0a3b4f64be00b7e1d68097ab93f24bb702e2138050ec280a868c1a8378d0367" :answer/id #uuid "4f6abe86-fa8f-581b-a002-e257642411a8" :answer/type :answer.type/math :answer/value "3\\,\\text{d}r+4\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79958/selection/f61a4cec10df4fe60f9761abddc2e481cf39f6c12bbec8904bfbc9f136b27959" :answer/id #uuid "2faef51e-33d2-5208-8d1d-de99b9d98016" :answer/type :answer.type/math :answer/value "\\frac{2}{5}\\,\\text{d}r+\\frac{3}{10}\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79958/selection/894d05271e70a2e445a5d25376ea295212e0a22a32d14bee02ff0d69821588c2" :answer/id #uuid "a4ac7499-57a6-5bc2-9378-221f1148e78b" :answer/type :answer.type/math :answer/value "\\frac{3}{5}\\,\\text{d}r+\\frac{4}{5}\\,\\text{d}h" :db/ensure [:answer/validate]} {:db/id "q-79958/selection" :answer-field/id #uuid "2f3551fa-725a-54f5-856a-ec21465a741b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79958/selection/894d05271e70a2e445a5d25376ea295212e0a22a32d14bee02ff0d69821588c2" :answer-field/choices ["q-79958/selection/5dfb90a19bf3417a362bf876a7fa097a215000885598e66ffcb13a70187b57bd" "q-79958/selection/6d8368f816eaf00c7085cf88e5cb9b61236c6cd926238a192aeb0bcc79e7c4be" "q-79958/selection/c0a3b4f64be00b7e1d68097ab93f24bb702e2138050ec280a868c1a8378d0367" "q-79958/selection/f61a4cec10df4fe60f9761abddc2e481cf39f6c12bbec8904bfbc9f136b27959" "q-79958/selection/894d05271e70a2e445a5d25376ea295212e0a22a32d14bee02ff0d69821588c2"] :db/ensure [:answer-field/validate]} {:db/id "q-79958" :question/id #uuid "74293020-87b8-5b53-8917-b5f49fa422c2" :question/math-academy-id "q-79958" :question/problem "Given a right cone, find the differential $\\text{d}l$ for the slant height $l$ of the right cone if its base radius is $r=3$ and height $h=4.$" :question/worked-solution "The slant height of the right cone is $l=\\sqrt{{r}^{2}+{h}^{2}}.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}l(r,h) & =(\\frac{∂l}{∂r})\\,\\text{d}r+(\\frac{∂l}{∂h})\\,\\text{d}h \\\\  & =\\frac{r}{\\sqrt{{r}^{2}+{h}^{2}}}\\,\\text{d}r+\\frac{h}{\\sqrt{{r}^{2}+{h}^{2}}}\\,\\text{d}h\\end{aligned}\n$$\n\nFor $r=3$  and $h=4$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(3,4) & =\\frac{3}{\\sqrt{{3}^{2}+{4}^{2}}}\\,\\text{d}r+\\frac{4}{\\sqrt{{3}^{2}+{4}^{2}}}\\,\\text{d}h \\\\  & =\\frac{3}{5}\\,\\text{d}r+\\frac{4}{5}\\,\\text{d}h.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79958/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb"] :knowledge-point/questions ["q-79958"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37295"] :question/problem "Given a sector of a circle, find the differential $\\text{d}S$ for the surface area $S$ if the radius is $r=4$ and the central angle is $\\theta =\\frac{\\pi }{8}.$" :question/worked-solution "The area of the sector is $S=\\frac{\\theta }{2}{r}^{2}.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(r,\\theta ) & =(\\frac{∂S}{∂r})\\,\\text{d}r+(\\frac{∂S}{∂\\theta })\\,\\text{d}\\theta  \\\\  & =r\\theta \\,\\text{d}r+\\frac{{r}^{2}}{2}\\,\\text{d}\\theta \\end{aligned}\n$$\n\nFor $r=4$ and $\\theta =\\frac{\\pi }{8},$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(4,\\frac{\\pi }{8}) & =4\\cdot \\frac{\\pi }{8}\\,\\text{d}r+\\frac{{4}^{2}}{2}\\,\\text{d}\\theta  \\\\  & =\\frac{\\pi }{2}\\,\\text{d}r+8\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-167168/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "156375a1-0669-562c-a408-c68017992149" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-167168/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "4e766824-14a1-54ae-83db-edb1298a01bd" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-167168/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "a0f86c21-683d-512c-ba8d-273c5a8702b1" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-167168/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b62aa180-1842-5f79-8c9c-8c5b96ebb575" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-167168/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "dd2369fe-b318-5409-be82-df859c61de9c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-167168/selection" :answer-field/id #uuid "e9b71b3b-fc7a-58ab-a94a-6a95f0453e8b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-167168/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-167168/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-167168/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-167168/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-167168/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-167168/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-167168" :question/id #uuid "dd59d308-6e41-5fd0-8b0f-1ea88730848b" :question/math-academy-id "q-167168" :question/problem "If $f(x,y,z)=\\operatorname{ln}⁡(xyz),$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(1,1,1)$ to $(2,3,4).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =\\frac{1}{x}\\,\\text{d}x+\\frac{1}{y}\\,\\text{d}y+\\frac{1}{z}\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(1,1,1),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(1,1,1) & =1\\,\\text{d}x+1\\,\\text{d}y+1\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(1+Δx,1+Δy,1+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈Δx+Δy+Δz.\n$$\n\nMoving from $(1,1,1)$ to $(2,3,4),$ we have\n\n$$\n\\begin{aligned}Δx & =2-1=1, \\\\ Δy & =3-1=2 \\\\ Δz & =4-1=3.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈Δx+Δy+Δz \\\\  & ≈1+2+3 \\\\  & ≈6.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ increases by approximately $6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-167168/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-167168"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79813/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "cc980bd8-76e4-56aa-b098-dda0efd7cf1e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-79813/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "6e069f8d-fcb8-5999-9c7a-542c943da00d" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-79813/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "b3cf4b78-1acf-5e7e-acc0-0a4c1a06fad6" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-79813/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "f8e5382f-cb04-50cd-9a05-357a6a71400b" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-79813/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "e61cf5ba-8012-5ed1-927e-cbfb7e293016" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-79813/selection" :answer-field/id #uuid "4195aeda-3179-5193-a7c1-1a1a96af71bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79813/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-79813/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-79813/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-79813/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-79813/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-79813/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-79813" :question/id #uuid "15304540-cd8c-5704-ac94-52aa9f0b8729" :question/math-academy-id "q-79813" :question/problem "If $f(x,y)=xy+x{e}^{y},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(2,0)$ to $(1,-0.5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(y+{e}^{y})\\,\\text{d}x+(x+x{e}^{y})\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,0) & =(0+{e}^{0})\\,\\text{d}x+(2+2\\cdot {e}^{0})\\,\\text{d}y \\\\  & =1\\,\\text{d}x+4\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+4\\,Δy.\n$$\n\nMoving from $(2,0)$ to $(1,-0.5),$ we have\n\n$$\n\\begin{aligned}Δx & =1-2=-1, \\\\ Δy & =-0.5-0=-0.5.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+4\\,Δy \\\\  & ≈1\\cdot (-1)+4\\cdot (-0.5) \\\\  & ≈-3.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ decreases by approximately $3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79813/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-79813"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79810/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f" :answer/id #uuid "4ec500fb-9d6b-535f-885b-c3e6cea4a712" :answer/type :answer.type/math :answer/value "1.25" :db/ensure [:answer/validate]} {:db/id "q-79810/selection/a39e4c3855e119cc134cd501616b2d4242dd33fe6134da1d7da0776d673411f7" :answer/id #uuid "a5ad2ee9-88ff-5e3c-bf97-74242a23b602" :answer/type :answer.type/math :answer/value "-0.5" :db/ensure [:answer/validate]} {:db/id "q-79810/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "4c9f1a93-50dc-520d-b3f6-034e4c8f70a9" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-79810/selection/68d660245faa6640cb843d3998464f4b779fab9f99ac71d5091750d84d3b0b6d" :answer/id #uuid "b63ddff9-84da-5e06-acd2-bd26bff884c6" :answer/type :answer.type/math :answer/value "-0.25" :db/ensure [:answer/validate]} {:db/id "q-79810/selection/5d227958e8e2ab9feb7a492bded665cf59dfa9121f7d82334971c99adf799e26" :answer/id #uuid "dd8a7e49-44a5-5eb2-aa5f-e188de230361" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "q-79810/selection" :answer-field/id #uuid "45ff3702-d8e8-5826-912c-9b84a056c099" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79810/selection/5d227958e8e2ab9feb7a492bded665cf59dfa9121f7d82334971c99adf799e26" :answer-field/choices ["q-79810/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f" "q-79810/selection/a39e4c3855e119cc134cd501616b2d4242dd33fe6134da1d7da0776d673411f7" "q-79810/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" "q-79810/selection/68d660245faa6640cb843d3998464f4b779fab9f99ac71d5091750d84d3b0b6d" "q-79810/selection/5d227958e8e2ab9feb7a492bded665cf59dfa9121f7d82334971c99adf799e26"] :db/ensure [:answer-field/validate]} {:db/id "q-79810" :question/id #uuid "e4c7b68c-e2a2-583a-bdbf-0d748565e794" :question/math-academy-id "q-79810" :question/problem "If $f(x,y)={x}^{2}y+\\sqrt{y},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(0,4)$ to $(-1,5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =2xy\\,\\text{d}x+({x}^{2}+\\frac{1}{2\\sqrt{y}})\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(0,4),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,4) & =2\\cdot 0\\cdot 4\\,\\text{d}x+({0}^{2}+\\frac{1}{2\\sqrt{4}})\\,\\text{d}y \\\\  & =0\\,\\text{d}x+\\frac{1}{4}\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,4+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+\\frac{1}{4}\\,Δy.\n$$\n\nMoving from $(0,4)$ to $(-1,5),$ we have\n\n$$\n\\begin{aligned}Δx & =-1-0=-1, \\\\ Δy & =5-4=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\,Δx+\\frac{1}{4}\\,Δy \\\\  & ≈0\\cdot (-1)+\\frac{1}{4}\\cdot (1) \\\\  & ≈0.25.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $0.25.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79810/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-79810"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79815/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "835f9062-a830-5600-9799-531779ef052f" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-79815/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "1cea4b98-3707-5124-bdb8-96ae4bfb9f37" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-79815/selection/a35ede6ec6e48ccb90434c701b214a4130c697b9dcccfc110e1ef0284e549844" :answer/id #uuid "51eb6df5-a9c5-5682-85e2-ff6354f038f0" :answer/type :answer.type/math :answer/value "1-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-79815/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "98679f0f-81fb-568d-a7e3-812f76f7c74e" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-79815/selection/25896a72f5d013c50bb7cb627bf4b333dd1dedb6f0f4e897db2f1ea33bb9ec65" :answer/id #uuid "ec23fb49-327d-57eb-89f6-6928cecdd1c5" :answer/type :answer.type/math :answer/value "\\pi -2" :db/ensure [:answer/validate]} {:db/id "q-79815/selection" :answer-field/id #uuid "aa644c6e-aeab-5c7b-84d4-59838b44f193" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79815/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-79815/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-79815/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-79815/selection/a35ede6ec6e48ccb90434c701b214a4130c697b9dcccfc110e1ef0284e549844" "q-79815/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-79815/selection/25896a72f5d013c50bb7cb627bf4b333dd1dedb6f0f4e897db2f1ea33bb9ec65"] :db/ensure [:answer-field/validate]} {:db/id "q-79815" :question/id #uuid "ae0f6dae-8b10-584d-b0c4-229329da28f1" :question/math-academy-id "q-79815" :question/problem "If $f(x,y,z)=x\\operatorname{sin}⁡y+y\\operatorname{cos}⁡z,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(1,0,\\frac{\\pi }{2})$ to $(0,1,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡y\\,\\text{d}x+(x\\operatorname{cos}⁡y+\\operatorname{cos}⁡z)\\,\\text{d}y-y\\operatorname{sin}⁡z\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(1,0,\\frac{\\pi }{2}),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(1,0,\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(0)\\,\\text{d}x+(1\\cdot \\operatorname{cos}⁡(0)+\\operatorname{cos}⁡(\\frac{\\pi }{2}))\\,\\text{d}y-0\\cdot \\operatorname{sin}⁡(\\frac{\\pi }{2})\\,\\text{d}z \\\\  & =0\\,\\text{d}x+1\\,\\text{d}y+0\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(1+Δx,0+Δy,\\frac{\\pi }{2}+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+1\\,Δy+0\\,Δz.\n$$\n\nMoving from $(1,0,\\frac{\\pi }{2})$ to $(0,1,1),$ we have\n\n$$\n\\begin{aligned}Δx & =0-1=-1, \\\\ Δy & =1-0=1 \\\\ Δz & =1-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\,Δx+1\\,Δy+0\\,Δz \\\\  & ≈0\\cdot (-1)+1\\cdot (1)+0\\cdot (1-\\frac{\\pi }{2}) \\\\  & ≈1.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ increases by approximately $1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79815/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-79815"] :db/ensure [:knowledge-point/validate]} {:db/id "q-167166/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "95266bcb-e5cd-5656-a939-75a0967147f9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-167166/selection/a1b2ccfba458a845fd8ee10e6daa31506496a50a50042e082232a7d8cf1de62a" :answer/id #uuid "61409cad-8b9f-597f-b024-4f18482d10ac" :answer/type :answer.type/math :answer/value "4e" :db/ensure [:answer/validate]} {:db/id "q-167166/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "39e40d4c-69e8-5154-be4b-00e6112a28c5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-167166/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" :answer/id #uuid "1622e7f6-1a2d-5346-9162-2c7d1473e6d5" :answer/type :answer.type/math :answer/value "2e" :db/ensure [:answer/validate]} {:db/id "q-167166/selection/74b9878323186062e434675fc3ee407e9e4a746d2cc85ca785d4664ca99bda01" :answer/id #uuid "d0b817de-88ae-5ad0-92ad-2db6100597db" :answer/type :answer.type/math :answer/value "-2e" :db/ensure [:answer/validate]} {:db/id "q-167166/selection" :answer-field/id #uuid "f15be319-2b80-55b8-95ab-a65f4b03e863" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-167166/selection/a1b2ccfba458a845fd8ee10e6daa31506496a50a50042e082232a7d8cf1de62a" :answer-field/choices ["q-167166/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-167166/selection/a1b2ccfba458a845fd8ee10e6daa31506496a50a50042e082232a7d8cf1de62a" "q-167166/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-167166/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" "q-167166/selection/74b9878323186062e434675fc3ee407e9e4a746d2cc85ca785d4664ca99bda01"] :db/ensure [:answer-field/validate]} {:db/id "q-167166" :question/id #uuid "4ee1f88d-3f94-5266-a2de-5d2046b403ae" :question/math-academy-id "q-167166" :question/problem "If $f(x,y,z)=x{e}^{2y-z},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(-1,2,3)$ to $(1,0,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂x})\\,\\text{d}z \\\\  & ={e}^{2y-z}\\,\\text{d}x+2x{e}^{2y-z}\\,\\text{d}y-x{e}^{2y-z}\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(-1,2,3),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(-1,2,3) & ={e}^{2(2)-3}\\,\\text{d}x+2\\cdot (-1)\\cdot {e}^{2(2)-3}\\,\\text{d}y-(-1)\\cdot {e}^{2(2)-3}\\,\\text{d}z \\\\  & =e\\,\\text{d}x-2e\\,\\text{d}y+e\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(-1+Δx,2+Δy,3+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈e\\,Δx-2e\\,Δy+e\\,Δz.\n$$\n\nMoving from $(-1,2,3)$ to $(1,0,1),$ we have\n\n$$\n\\begin{aligned}Δx & =1-(-1)=2, \\\\ Δy & =0-2=-2 \\\\ Δz & =1-3=-2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈e\\,Δx-2e\\,Δy+e\\,Δz \\\\  & ≈e\\cdot (2)-2e\\cdot (-2)+e\\cdot (-2) \\\\  & ≈4e.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ increases by approximately $4e.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-167166/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-167166"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37281"] :question/problem "Estimate $\\sqrt[3]{10}+\\sqrt{150}$ using a differential $\\text{d}f$ of the function $f(x,y)=\\sqrt[3]{x}+\\sqrt{y}$ at the point $(8,144).$ Round your answer to $3$ decimal places." :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{1}{3{x}^{2/3}}\\,\\text{d}x+\\frac{1}{2\\sqrt{y}}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(8,144),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{1}{3\\cdot {8}^{2/3}}\\,\\text{d}x+\\frac{1}{2\\sqrt{144}}\\,\\text{d}y \\\\  & =\\frac{1}{12}\\,\\text{d}x+\\frac{1}{24}\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(8+Δx,144+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈\\frac{1}{12}\\,Δx+\\frac{1}{24}\\,Δy\n$$\n\nNote that \n\n$$\n\\sqrt[3]{10}+\\sqrt{150}=f(10,150),\n$$\n\nso we want to move to the point $(10,150).$\n\nMoving from $(8,144)$ to $(10,150),$ we have\n\n$$\n\\begin{aligned}Δx & =10-8=2, \\\\ Δy & =150-144=6.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈\\frac{1}{12}(2)+\\frac{1}{24}(6) \\\\  & ≈\\frac{1}{6}+\\frac{1}{4} \\\\  & ≈\\frac{5}{12} \\\\  & ≈0.417.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.417.$ Consequently, we have\n\n$$\n\\begin{aligned}f(10,150) & ≈f(8,144)+0.417 \\\\ \\sqrt[3]{10}+\\sqrt{150} & ≈\\sqrt[3]{8}+\\sqrt{144}+0.417 \\\\  & ≈2+12+0.417 \\\\  & ≈14.417.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-167170/selection/20cc814bba9f694ce63c4dc871416ae66609e00d328039e45011002e7ef0e279" :answer/id #uuid "c03f28f0-525d-5df5-9356-5befa19004c9" :answer/type :answer.type/math :answer/value "1.18" :db/ensure [:answer/validate]} {:db/id "q-167170/selection/5d227958e8e2ab9feb7a492bded665cf59dfa9121f7d82334971c99adf799e26" :answer/id #uuid "5149d8f4-b99e-5867-88cd-a23d8632b5f5" :answer/type :answer.type/math :answer/value "0.25" :db/ensure [:answer/validate]} {:db/id "q-167170/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f" :answer/id #uuid "93f81494-6c98-5aeb-86db-dfe93ec432ab" :answer/type :answer.type/math :answer/value "1.25" :db/ensure [:answer/validate]} {:db/id "q-167170/selection/1429fa6c8ea2460ff4e95956555326814a94d00a66bfbde0268929e24d0f9512" :answer/id #uuid "d359091b-d471-567a-83c2-07c7d3c45991" :answer/type :answer.type/math :answer/value "1.15" :db/ensure [:answer/validate]} {:db/id "q-167170/selection/625896633137e0044aec1ec040d8233380e151c0f7ffbedd051e7544cbdce1c4" :answer/id #uuid "06a01ca9-3dc0-55f9-8a85-7a220c7c8be5" :answer/type :answer.type/math :answer/value "0.15" :db/ensure [:answer/validate]} {:db/id "q-167170/selection" :answer-field/id #uuid "0c7f1e05-fc03-519c-9816-58a27106844d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-167170/selection/1429fa6c8ea2460ff4e95956555326814a94d00a66bfbde0268929e24d0f9512" :answer-field/choices ["q-167170/selection/20cc814bba9f694ce63c4dc871416ae66609e00d328039e45011002e7ef0e279" "q-167170/selection/5d227958e8e2ab9feb7a492bded665cf59dfa9121f7d82334971c99adf799e26" "q-167170/selection/7c2fec16fd7ae02af1a8818a9096a676afc42249e7e68d108c3f64859048a45f" "q-167170/selection/1429fa6c8ea2460ff4e95956555326814a94d00a66bfbde0268929e24d0f9512" "q-167170/selection/625896633137e0044aec1ec040d8233380e151c0f7ffbedd051e7544cbdce1c4"] :db/ensure [:answer-field/validate]} {:db/id "q-167170" :question/id #uuid "da6bb9d5-5b64-5e69-823c-947a664f9346" :question/math-academy-id "q-167170" :question/problem "Estimate $\\sqrt{{e}^{0.2}+0.1}$ using a differential $\\text{d}f$ of the function $f(x,y)=\\sqrt{{e}^{x}+y}$ at the point $(0,0).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{{e}^{x}}{2\\sqrt{{e}^{x}+y}}\\,\\text{d}x+\\frac{1}{2\\sqrt{{e}^{x}+y}}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(0,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{{e}^{0}}{2\\sqrt{{e}^{0}+0}}\\,\\text{d}x+\\frac{1}{2\\sqrt{{e}^{0}+0}}\\,\\text{d}y \\\\  & =\\frac{1}{2}\\,\\text{d}x+\\frac{1}{2}\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈\\frac{1}{2}\\,Δx+\\frac{1}{2}\\,Δy\n$$\n\nNote that \n\n$$\n\\sqrt{{e}^{0.2}+0.1}=f(0.2,0.1),\n$$\n\nso we want to move to the point $(0.2,0.1).$\n\nMoving from $(0,0)$ to $(0.2,0.1),$ we have\n\n$$\n\\begin{aligned}Δx & =0.2-0=0.2, \\\\ Δy & =0.1-0=0.1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈\\frac{1}{2}(0.2)+\\frac{1}{2}(0.1) \\\\  & =0.1+0.05 \\\\  & =0.15.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.15.$ Consequently, we have\n\n$$\n\\begin{aligned}f(0.2,0.1) & ≈f(0,0)+0.15 \\\\ \\sqrt{{e}^{0.2}+0.1} & ≈\\sqrt{{e}^{0}+0}+0.15 \\\\  & =1+0.15 \\\\  & =1.15.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-167170/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9"] :knowledge-point/questions ["q-167170"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-79837"] :question/problem "Estimate $(1.81)\\cdot \\operatorname{ln}⁡(0.91)$ using a differential $\\text{d}f$ of the function $f(x,y)=x\\operatorname{ln}⁡y$ at the point $(2,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{ln}⁡y\\,\\text{d}x+\\frac{x}{y}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(2,1),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\operatorname{ln}⁡(1)\\,\\text{d}x+\\frac{2}{1}\\,\\text{d}y \\\\  & =0\\,\\text{d}x+2\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,1+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+2\\,Δy\n$$\n\nNote that \n\n$$\n(1.81)\\cdot \\operatorname{ln}⁡(0.91)=f(1.81,0.91),\n$$\n\nso we want to move to the point $(1.81,0.91).$\n\nMoving from $(2,1)$ to $(1.81,0.91),$ we have\n\n$$\n\\begin{aligned}Δx & =1.81-2=-0.19, \\\\ Δy & =0.91-1=-0.09.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\cdot (-0.19)+2\\cdot (-0.09) \\\\  & ≈0-0.18 \\\\  & ≈-0.18.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $0.18.$ Consequently, we have\n\n$$\n\\begin{aligned}f(1.81,0.91) & ≈f(2,1)-0.18 \\\\ (1.81)\\cdot \\operatorname{ln}⁡(0.91) & ≈2\\operatorname{ln}⁡1-0.18 \\\\  & ≈0-0.18 \\\\  & ≈-0.18.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-79840/selection/1c1ca7ff7dd640f776a1c4debcf904ea6e6eb554ec91f2c988090c1616d841dd" :answer/id #uuid "e57e6c52-c828-5c7c-b563-65377c9f2d87" :answer/type :answer.type/math :answer/value "1.920" :db/ensure [:answer/validate]} {:db/id "q-79840/selection/55814ee79e3b2f7bd397372df59417d077363bf62e8a6e9f7847b520178ca40d" :answer/id #uuid "a1eba0d9-7e20-5ca0-8446-59e8494f2862" :answer/type :answer.type/math :answer/value "1.930" :db/ensure [:answer/validate]} {:db/id "q-79840/selection/3a23f28b62a40d42522adb5279b50e7936f99d4844f147bdd2bea4e0415f5acf" :answer/id #uuid "e218bd7e-ff26-5214-8942-ab669e441e20" :answer/type :answer.type/math :answer/value "1.915" :db/ensure [:answer/validate]} {:db/id "q-79840/selection/412be00c83860971d4e319f20682dfef12aef151ae2dc7d27cf15cbf6e4d0f7e" :answer/id #uuid "daa6e67f-0752-5b9e-aa6c-be0c42951aac" :answer/type :answer.type/math :answer/value "1.925" :db/ensure [:answer/validate]} {:db/id "q-79840/selection/7487fd0dcfd59ccff3c1cf07f0c929e4d9049268ff085affbbcce2ba625e2af3" :answer/id #uuid "40365a43-4300-50a3-ab28-5794d774974e" :answer/type :answer.type/math :answer/value "1.910" :db/ensure [:answer/validate]} {:db/id "q-79840/selection" :answer-field/id #uuid "c608a199-01ac-52ae-ba30-2f6c53784491" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79840/selection/412be00c83860971d4e319f20682dfef12aef151ae2dc7d27cf15cbf6e4d0f7e" :answer-field/choices ["q-79840/selection/1c1ca7ff7dd640f776a1c4debcf904ea6e6eb554ec91f2c988090c1616d841dd" "q-79840/selection/55814ee79e3b2f7bd397372df59417d077363bf62e8a6e9f7847b520178ca40d" "q-79840/selection/3a23f28b62a40d42522adb5279b50e7936f99d4844f147bdd2bea4e0415f5acf" "q-79840/selection/412be00c83860971d4e319f20682dfef12aef151ae2dc7d27cf15cbf6e4d0f7e" "q-79840/selection/7487fd0dcfd59ccff3c1cf07f0c929e4d9049268ff085affbbcce2ba625e2af3"] :db/ensure [:answer-field/validate]} {:db/id "q-79840" :question/id #uuid "a7a466ad-861f-5b55-a550-74aad2ec19b3" :question/math-academy-id "q-79840" :question/problem "Estimate $\\sqrt{4.1}+\\operatorname{ln}⁡(0.9)$ using a differential $\\text{d}f$ of the function $f(x,y)=\\sqrt{x}+\\operatorname{ln}⁡y$ at the point $(4,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{1}{2\\sqrt{x}}\\,\\text{d}x+\\frac{1}{y}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(4,1),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{1}{2\\sqrt{4}}\\,\\text{d}x+\\frac{1}{1}\\,\\text{d}y \\\\  & =\\frac{1}{4}\\,\\text{d}x+1\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(4+Δx,1+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈\\frac{1}{4}\\,Δx+1\\,Δy\n$$\n\nNote that \n\n$$\n\\sqrt{4.1}+\\operatorname{ln}⁡(0.9)=f(4.1,0.9),\n$$\n\nso we want to move to the point $(4.1,0.9).$\n\nMoving from $(4,1)$ to $(4.1,0.9),$ we have\n\n$$\n\\begin{aligned}Δx & =4.1-4=0.1, \\\\ Δy & =0.9-1=-0.1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈\\frac{1}{4}\\cdot (0.1)+1(-0.1) \\\\  & ≈0.025-0.1 \\\\  & ≈-0.075.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $0.075.$ Consequently, we have\n\n$$\n\\begin{aligned}f(4.1,0.9) & ≈f(4,1)-0.075 \\\\ \\sqrt{4.1}+\\operatorname{ln}⁡(0.9) & ≈\\sqrt{4}+\\operatorname{ln}⁡(1)-0.075 \\\\  & ≈2-0.075 \\\\  & ≈1.925.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79840/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9"] :knowledge-point/questions ["q-79840"] :db/ensure [:knowledge-point/validate]} {:db/id "q-167171/selection/475febc87b176ffd4c03480bafb576384c98c02c34583714113ff3106e52e6c8" :answer/id #uuid "16cadda8-e28e-5db4-8ef7-e6850c66d716" :answer/type :answer.type/math :answer/value "-0.482" :db/ensure [:answer/validate]} {:db/id "q-167171/selection/699b9e6f0cc884149358acd9f96184ea3b4d19ddeefa1141150a578f4ea5022d" :answer/id #uuid "636f7633-040f-53b2-9ce8-f99518ce5881" :answer/type :answer.type/math :answer/value "-0.359" :db/ensure [:answer/validate]} {:db/id "q-167171/selection/60bd0aea468fba6f7a2707b0dfa6aaebe9576358b47a3a47fce59449a3cdb773" :answer/id #uuid "e267b74c-b376-55c6-8f03-ac16d0bfa2a4" :answer/type :answer.type/math :answer/value "-0.652" :db/ensure [:answer/validate]} {:db/id "q-167171/selection/f967fda41f0ec48c397c5bcde930805f80db4ce905ed8bb976ed9c75b67f9f4d" :answer/id #uuid "7b524090-0612-5634-bad0-3ee845f687ae" :answer/type :answer.type/math :answer/value "-0.274" :db/ensure [:answer/validate]} {:db/id "q-167171/selection/11d7c6e8512d10d8ad5fc7de4cacfca8334567df08310053332ecd9302b398fe" :answer/id #uuid "ad66c4fa-3e3f-5ca7-87c6-d4664253161c" :answer/type :answer.type/math :answer/value "-0.521" :db/ensure [:answer/validate]} {:db/id "q-167171/selection" :answer-field/id #uuid "5f4f1d83-1e8d-5aa6-8ba2-7b3962fc1a49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-167171/selection/699b9e6f0cc884149358acd9f96184ea3b4d19ddeefa1141150a578f4ea5022d" :answer-field/choices ["q-167171/selection/475febc87b176ffd4c03480bafb576384c98c02c34583714113ff3106e52e6c8" "q-167171/selection/699b9e6f0cc884149358acd9f96184ea3b4d19ddeefa1141150a578f4ea5022d" "q-167171/selection/60bd0aea468fba6f7a2707b0dfa6aaebe9576358b47a3a47fce59449a3cdb773" "q-167171/selection/f967fda41f0ec48c397c5bcde930805f80db4ce905ed8bb976ed9c75b67f9f4d" "q-167171/selection/11d7c6e8512d10d8ad5fc7de4cacfca8334567df08310053332ecd9302b398fe"] :db/ensure [:answer-field/validate]} {:db/id "q-167171" :question/id #uuid "240dd5e9-7623-5d41-a562-b45731698fa6" :question/math-academy-id "q-167171" :question/problem "Estimate $\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2)$ using a differential $\\text{d}f$ of the function $f(x,y)=\\operatorname{sin}⁡(\\sqrt{x}+y)$ at the point $({\\pi }^{2},0).$ Round your answer to $3$ decimal places." :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{\\operatorname{cos}⁡(\\sqrt{x}+y)}{2\\sqrt{x}}\\,\\text{d}x+\\operatorname{cos}⁡(\\sqrt{x}+y)\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $({\\pi }^{2},0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{\\operatorname{cos}⁡(\\pi )}{2\\pi }\\,\\text{d}x+\\operatorname{cos}⁡(\\pi )\\,\\text{d}y \\\\  & =-\\frac{1}{2\\pi }\\,\\text{d}x-\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $({\\pi }^{2}+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈-\\frac{1}{2\\pi }\\,Δx-\\,Δy\n$$\n\nNote that \n\n$$\n\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2)=f({\\pi }^{2}+1,0.2),\n$$\n\nso we want to move to the point $({\\pi }^{2}+1,0.2).$\n\nMoving from $({\\pi }^{2},0)$ to $({\\pi }^{2}+1,0.2),$ we have\n\n$$\n\\begin{aligned}Δx & =({\\pi }^{2}+1)-{\\pi }^{2}=1, \\\\ Δy & =0.2-0=0.2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈(-\\frac{1}{2\\pi })\\cdot (1)-1\\cdot (0.2) \\\\  & =-\\frac{1}{2\\pi }-0.2 \\\\  & ≈-0.359.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $-0.359.$ Consequently, we have\n\n$$\n\\begin{aligned}f({\\pi }^{2}+1,0.2) & ≈f({\\pi }^{2},0)-0.359 \\\\ \\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}+1}+0.2) & ≈\\operatorname{sin}⁡(\\sqrt{{\\pi }^{2}}+0)-0.359 \\\\  & =0-0.359 \\\\  & =-0.359.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-167171/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9"] :knowledge-point/questions ["q-167171"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6852"] :question/problem "Find the differential for $f(x,y) = x^2 \\sin y.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x\\operatorname{sin}⁡y)\\,\\text{d}x+({x}^{2}\\operatorname{cos}⁡y)\\,\\text{d}y \\\\  & =2x\\operatorname{sin}⁡y\\,\\text{d}x+{x}^{2}\\operatorname{cos}⁡y\\,\\text{d}y\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6854"] :question/problem "Given a cone, find the differential $\\textrm d V$ for the volume $V$ of the cone if the radius is $r=6$ and the height is $h = 3.$" :question/worked-solution "The volume of the cone is $V = \\dfrac{1}{3} \\pi r^2h.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(r,h) & =(\\frac{∂V}{∂r})\\,\\text{d}r+(\\frac{∂V}{∂h})\\,\\text{d}h \\\\  & =\\frac{2}{3}\\pi rh\\,\\text{d}r+\\frac{1}{3}\\pi {r}^{2}\\,\\text{d}h.\\end{aligned}\n$$\n\nFor $r=6$ and $h=3,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(6,3) & =\\frac{2}{3}\\pi \\cdot 6\\cdot 3\\,\\text{d}r+\\frac{1}{3}\\pi \\cdot {6}^{2}\\,\\text{d}h \\\\  & =12\\pi \\,\\text{d}r+12\\pi \\,\\text{d}h.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6875"] :question/problem "If $f (x, y) = xe^y ,$ use the differential $\\textrm d f$ to estimate the change $\\Delta f$ in the value of $f(x, y)$ from $(5,0)$ to $(2,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & ={e}^{y}\\,\\text{d}x+x{e}^{y}\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(5,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(5,0) & ={e}^{0}\\,\\text{d}x+5{e}^{0}\\,\\text{d}y \\\\  & =1\\,\\text{d}x+5\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(5 + \\Delta x, 0 + \\Delta y),$ then we can approximate the change in $f$ as\n\n$$\n\\Delta f \\approx 1 \\, \\Delta x + 5 \\, \\Delta y.\n$$\n\nMoving from $(5,0)$ to $(2,1),$ we have\n\n$$\n\\begin{aligned}Δx & =2-5=-3, \\\\ Δy & =1-0=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+5\\,Δy \\\\  & ≈1\\cdot (-3)+5\\cdot (1) \\\\  & ≈2.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $2.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6876"] :question/problem "Estimate $\\sin (3) + \\cos (0.2)$ using a differential of the function $f(x,y) = \\sin x + \\cos y$ at the point $\\left( \\pi, 0 \\right).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{cos}⁡x\\,\\text{d}x-\\operatorname{sin}⁡y\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $\\left( \\pi, 0 \\right),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\operatorname{cos}⁡\\pi \\,\\text{d}x-\\operatorname{sin}⁡0\\,\\text{d}y \\\\  & =-1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(\\pi + \\Delta x, 0 + \\Delta y),$ then we can approximate the change in $f$ as\n\n$$\n\\Delta f \\approx  -1  \\,  \\Delta x + 0  \\,  \\Delta y\n$$\n\nNote that \n\n$$\n\\sin (3) + \\cos (0.2)= f(3,0.2),\n$$\n\nso we want to move to the point $(3,0.2).$\n\nMoving from $(\\pi, 0)$ to $(3,0.2),$ we have\n\n$$\n\\begin{aligned}Δx & =3-\\pi ≈-0.141, \\\\ Δy & =0.2-0=0.2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈-1(-0.141)+0(0.2) \\\\  & ≈0.141.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.141.$ Consequently, we have\n\n$$\n\\begin{aligned}f(3,0.2) & ≈f(\\pi ,0)+0.141 \\\\ \\operatorname{sin}⁡(3)+\\operatorname{cos}⁡(0.2) & ≈\\operatorname{sin}⁡(\\pi )+\\operatorname{cos}⁡(0)+0.141 \\\\  & ≈0+1+0.141 \\\\  & ≈1.141.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
