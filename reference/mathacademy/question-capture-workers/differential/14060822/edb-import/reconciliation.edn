tion-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6b766"} {"question" "q-318601" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/activity-metadata.json" "file_sha256" "dfa5a7d6d2e77768c478abe539fc58306bc51fed071501abb91a792ed69a2496"} {"question" "q-318601" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6b766"} {"question" "q-318601" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "\\frac{{∂}^{2}P}{∂{s}^{2}}=\\frac{{∂}^{2}Q}{∂{r}^{2}}"] ["math" "\\frac{∂P}{∂r}=-\\frac{∂Q}{∂s}"] ["math" "\\frac{∂P}{∂r}=\\frac{∂Q}{∂s}"] ["math" "\\frac{∂P}{∂s}=\\frac{∂Q}{∂r}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6b766"} {"question" "q-318601" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{∂P}{∂s}=\\frac{∂Q}{∂r}"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6b766"} {"question" "q-318601" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919d