e}^{xy}+xy{e}^{xy}.\\end{aligned}\n$$\n\nNow, since\n\n$$\n\\frac{∂P}{∂y}\\ne \\frac{∂Q}{∂x},\n$$\n\nso the exactness condition fails. Therefore, the given differential equation $\\text{is not exact}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6b766"} {"question" "q-320450" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/activity-metadata.json" "file_sha256" "dfa5a7d6d2e77768c478abe539fc58306bc51fed071501abb91a792ed69a2496"} {"question" "q-320450" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6b766"} {"question" "q-320450" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "\\frac{{∂}^{2}P}{∂{y}^{2}}=\\frac{{∂}^{2}Q}{∂{x}^{2}}"] ["math" "\\frac{∂P}{∂x}=-\\frac{∂Q}{∂y}"] ["math" "\\frac{∂P}{∂x}=\\frac{∂Q}{∂y}"] ["math" "\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6b766"} {"question" "q-320450" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060822/state.json" "file_sha256" "62c4ca07eeb95147919dec6599f1114ae8f26ecb4dd704bf91f33c94f5f6