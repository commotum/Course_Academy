b6-5f87-b6b3-a2d9cf135c68" :answer/type {:db/ident :answer.type/text} :answer/value "is exact" :db/id #edb/ref 17592186340298} {:answer/id #uuid "43618a44-a4ff-5282-a1be-3d7d90e380ca" :answer/type {:db/ident :answer.type/text} :answer/value "is not  exact" :db/id #edb/ref 17592186340299}] :answer-field/correct {:answer/id #uuid "43618a44-a4ff-5282-a1be-3d7d90e380ca" :answer/type {:db/ident :answer.type/text} :answer/value "is not  exact" :db/id #edb/ref 17592186340299} :answer-field/id #uuid "1d9d8467-9a00-59d0-b0e4-8465758081a0" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186340297}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "846b7b32-8c59-58bd-a480-321017b6d1b5" :question/math-academy-id "q-320450" :question/problem "Determine whether the following differential equation is exact:\n\n$$\n(4+{y}^{2}{e}^{xy})\\,\\text{d}x+(x{e}^{xy}+3y)\\,\\text{d}y=0\n$$\n\nA differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0\n$$\n\nis exact if it satisfies the condition\n\n$$\n\\,{{field-1}},\n$$\n\nFor the equation $(4+{y}^{2}{e}^{xy})\\,\\text{d}x+(x{e}^{xy}+3y)\\,\\text{d}y=0$, we have  \n\n$$\nP=\\,{{field-2}},\n$$\n\n$$\nQ=\\,{{field-3}}.\n$$\n\nTherefore,  \n\n$$\n\\frac{∂P}{∂y}=\\,{{field-4}},\n$$\n\n$$\n\\frac{∂Q}{∂x}=\\,{{field-5}}.\n$$\n\nNow, since \n\n$$\n\\,{{field-6}},\n$$\n\n the equation {{field-7}}." :question/worked-solution "A differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor the equation $(4+{y}^{2}{e}^{xy})\\,\\text{d}x+(x{e}^{xy}+3y)\\,\\text{d}y=0$, we have\n\n$$\nP(x,y)=4+{y}^{2}{e}^{xy},\\,Q(x,y)=x{e}^{xy}+3y.\n$$\n\nNow, compute the partial derivatives carefully:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}\\,(4+{y}^{2}{e}^{xy}) \\\\  & =2y{e}^{xy}+x{y}^{2}{e}^{xy}.\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}\\,(x{e}^{xy}+3y) \\\\  & ={e}^{xy}+xy{e}^{xy}.\\end{aligned}\n$$\n\nNow, since\n\n$$\n\\frac{∂P}{∂y}\\ne \\frac{∂Q}{∂x},\n$$\n\nso the exactness condition fails. Therefore, the given differential equation $\\text{is not exact}.$"}] [{:db/id #edb/ref 17592186340300 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bb08d6e-ae86-50f5-8cb4-d7fe50595849" :knowledge-point/title "Rearranging an ODE Into Exact Form and Then Solving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6560f956-6faf-516d-b75d-a14cdbe43d27" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-\\operatorname{cos}⁡(xy)-3x=0" :db/id #edb/ref 17592186340302} {:answer/id #uuid "e07b09e6-b87d-59e2-8453-ca81ba6f50ee" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-\\operatorname{sin}⁡(x+y)-3x+\\operatorname{sin}⁡(1)-1=0" :db/id #edb/ref 17592186340303} {:answer/id #uuid "fa9b6e15-8e9f-5d90-aeef-26c7440e3b03" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)-{y}^{2}+3x=-2" :db/id #edb/ref 17592186340304} {:answer/id #uuid "ee45b6a8-a835-5881-961e-c9080ac2450c" :answer/type {:db/ident :answer.type/math} :answer/value "({y}^{2}-3x)\\,\\operatorname{cos}⁡(xy)=1" :db/id #edb/ref 17592186340305} {:answer/id #uuid "df38a237-9f28-5661-b80e-89ca574e2115" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(xy)+{y}^{2}-3x=2" :db/id #edb/ref 17592186340306}] :answer-field/correct {:answer/id #uuid "fa9b6e15-8e9f-5d90-aeef-26c7440e3b03" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡(xy)-{y}^{2}+3x=-2" :db/id #edb/ref 17592186340304} :answer-field/id #uuid "871a2ced-dbfb-578c-849e-d5a1208fba1e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340301}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "806a537b-2d39-5ccf-b479-d935eaaf7929" :question/math-academy-id "q-320585" :question/problem "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{y\\operatorname{sin}⁡(xy)+3}{\\,2y-x\\operatorname{sin}⁡(xy)\\,},\n$$\n\nwith the initial condition $y(0)=1.$" :question/worked-solution "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{sin}⁡(xy)+3}{\\,2y-x\\operatorname{sin}⁡(xy)\\,},\\end{aligned}\n$$\n\nwe first multiply through by$(2y-x\\operatorname{sin}⁡(xy))\\,\\text{d}x$:\n\n$$\n(2y-x\\operatorname{sin}⁡(xy))\\,\\text{d}y=(y\\operatorname{sin}⁡(xy)+3)\\,\\text{d}x\n$$\n\nThen, we rearrange the terms:\n\n$$\n(y\\operatorname{sin}⁡(xy)+3)\\,\\text{d}x+(x\\operatorname{sin}⁡(xy)-2y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=y\\operatorname{sin}⁡(xy)+3,\\,Q(x,y)=x\\operatorname{sin}⁡(xy)-2y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(y\\operatorname{sin}⁡(xy)+3) \\\\  & =\\operatorname{sin}⁡(xy)+xy\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(xy)-2y) \\\\  & =\\operatorname{sin}⁡(xy)+xy\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (y\\operatorname{sin}⁡(xy)+3)\\,\\text{d}x+f(y) \\\\  & =-\\operatorname{cos}⁡(xy)+3x+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x\\operatorname{sin}⁡(xy)-2y)\\,\\text{d}y+g(x) \\\\  & =-\\operatorname{cos}⁡(xy)-{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=3x,\\,f(y)=-{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n-\\operatorname{cos}⁡(xy)-{y}^{2}+3x=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=1$  when $x=0.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}-\\operatorname{cos}⁡(xy)-{y}^{2}+3x & =c \\\\ -\\operatorname{cos}⁡(0\\cdot 1)-(1)^{2}+3\\cdot 0 & =c \\\\ c & =-1-1 \\\\ c & =-2\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n-\\operatorname{cos}⁡(xy)-{y}^{2}+3x=-2.\n$$"}] [{:db/id #edb/ref 17592186340307 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bb08d6e-ae86-50f5-8cb4-d7fe50595849" :knowledge-point/title "Rearranging an ODE Into Exact Form and Then Solving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c058c67f-ecc8-5cec-94de-69359cf44a72" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(xy)-2{y}^{2}+5x=-8" :db/id #edb/ref 17592186340309} {:answer/id #uuid "018801e3-a35a-5324-a90b-6a16702969ce" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{sin}⁡(xy)+2{y}^{2}+5x=8" :db/id #edb/ref 17592186340310} {:answer/id #uuid "4e4036dd-e83a-5933-9347-609b6797dfd4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-\\operatorname{sin}⁡(xy)-5x=4" :db/id #edb/ref 17592186340311} {:answer/id #uuid "56bd45c9-197a-5393-b0f1-568ee4ba8e3f" :answer/type {:db/ident :answer.type/math} :answer/value "({y}^{2}-5x)\\,\\operatorname{sin}⁡(xy)=0" :db/id #edb/ref 17592186340312} {:answer/id #uuid "59c486a6-fba5-5c52-bec5-7c31927e2617" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-\\operatorname{cos}⁡(xy)-5x=3" :db/id #edb/ref 17592186340313}] :answer-field/correct {:answer/id #uuid "c058c67f-ecc8-5cec-94de-69359cf44a72" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(xy)-2{y}^{2}+5x=-8" :db/id #edb/ref 17592186340309} :answer-field/id #uuid "cf00bbf6-0040-55ba-ad7c-dcdb06503f06" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340308}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c1a886d5-cc15-576c-812c-a1301ce1d5ab" :question/math-academy-id "q-320586" :question/problem "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{y\\operatorname{cos}⁡(xy)+5}{\\,4y-x\\operatorname{cos}⁡(xy)\\,},\n$$\n\nwith the initial condition $y(0)=-2.$" :question/worked-solution "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y\\operatorname{cos}⁡(xy)+5}{4y-x\\operatorname{cos}⁡(xy)},\\end{aligned}\n$$\n\nwe first multiply through by $(4y-x\\operatorname{cos}⁡(xy))\\,\\text{d}x$:\n\n$$\n(4y-x\\operatorname{cos}⁡(xy))\\,\\text{d}y=(y\\operatorname{cos}⁡(xy)+5)\\,\\text{d}x\n$$\n\nThen, we rearrange the terms:\n\n$$\n(y\\operatorname{cos}⁡(xy)+5)\\,\\text{d}x+(x\\operatorname{cos}⁡(xy)-4y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=y\\operatorname{cos}⁡(xy)+5,\\,Q(x,y)=x\\operatorname{cos}⁡(xy)-4y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(xy)+5) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡(xy)-4y) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (y\\operatorname{cos}⁡(xy)+5)\\,\\text{d}x+f(y) \\\\  & =\\operatorname{sin}⁡(xy)+5x+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x\\operatorname{cos}⁡(xy)-4y)\\,\\text{d}y+g(x) \\\\  & =\\operatorname{sin}⁡(xy)-2{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=5x,\\,f(y)=-2{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n\\operatorname{sin}⁡(xy)-2{y}^{2}+5x=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=-2$ when $x=0.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(xy)-2{y}^{2}+5x & =c \\\\ \\operatorname{sin}⁡(0\\cdot (-2))-2(-2)^{2}+5\\cdot 0 & =c \\\\ c & =0-8 \\\\ c & =-8\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n\\operatorname{sin}⁡(xy)-2{y}^{2}+5x=-8.\n$$"}] [{:db/id #edb/ref 17592186340314 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bb08d6e-ae86-50f5-8cb4-d7fe50595849" :knowledge-point/title "Rearranging an ODE Into Exact Form and Then Solving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c8b169e8-13f3-5741-9755-7c322bbf6dd6" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{xy}+2{y}^{2}+5x=33" :db/id #edb/ref 17592186340316} {:answer/id #uuid "7aa2716d-21e4-56db-957c-b4811bb40a7d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+{e}^{xy}-5x=17" :db/id #edb/ref 17592186340317} {:answer/id #uuid "b5273aa0-9393-5e2c-acc3-19782d9d7065" :answer/type {:db/ident :answer.type/math} :answer/value "({y}^{2}+5x)\\,{e}^{xy}=16" :db/id #edb/ref 17592186340318} {:answer/id #uuid "3d437b16-2617-5496-bb06-a5e9ad53a03e" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{xy}-2{y}^{2}-5x=-31" :db/id #edb/ref 17592186340319} {:answer/id #uuid "a1ed2965-aa2e-59d6-90f2-9b2866e7fb94" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}-{e}^{xy}+5x=15" :db/id #edb/ref 17592186340320}] :answer-field/correct {:answer/id #uuid "3d437b16-2617-5496-bb06-a5e9ad53a03e" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{xy}-2{y}^{2}-5x=-31" :db/id #edb/ref 17592186340319} :answer-field/id #uuid "3bb5605f-0df2-5ffd-b486-47d82ddb61d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340315}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "817973e7-579b-5512-9e78-4ff1bd0baf95" :question/math-academy-id "q-320589" :question/problem "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{y{e}^{xy}-5}{\\,4y-x{e}^{xy}\\,},\n$$\n\nwith the initial condition $y(0)=4.$" :question/worked-solution "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y{e}^{xy}-5}{4y-x{e}^{xy}},\\end{aligned}\n$$\n\nwe first multiply through by $(4y-x{e}^{xy})\\,\\text{d}x$:\n\n$$\n(4y-x{e}^{xy})\\,\\text{d}y=(y{e}^{xy}-5)\\,\\text{d}x\n$$\n\nThen, we rearrange the terms:\n\n$$\n(y{e}^{xy}-5)\\,\\text{d}x+(x{e}^{xy}-4y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=y{e}^{xy}-5,\\,Q(x,y)=x{e}^{xy}-4y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(y{e}^{xy}-5) \\\\  & ={e}^{xy}+xy{e}^{xy}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(x{e}^{xy}-4y) \\\\  & ={e}^{xy}+xy{e}^{xy}\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (y{e}^{xy}-5)\\,\\text{d}x+f(y) \\\\  & ={e}^{xy}-5x+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x{e}^{xy}-4y)\\,\\text{d}y+g(x) \\\\  & ={e}^{xy}-2{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=-5x,\\,f(y)=-2{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n{e}^{xy}-2{y}^{2}-5x=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=4$ when $x=0.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}{e}^{xy}-2{y}^{2}-5x & =c \\\\ {e}^{0\\cdot 4}-2(4)^{2}-5\\cdot 0 & =c \\\\ c & =1-32 \\\\ c & =-31\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n{e}^{xy}-2{y}^{2}-5x=-31.\n$$"}] [{:db/id #edb/ref 17592186340321 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bb08d6e-ae86-50f5-8cb4-d7fe50595849" :knowledge-point/title "Rearranging an ODE Into Exact Form and Then Solving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61a072ef-0085-5927-aee8-4471ee4d89d3" :answer/type {:db/ident :answer.type/math} :answer/value "({y}^{2}+3x){e}^{xy}=1" :db/id #edb/ref 17592186340323} {:answer/id #uuid "c4b2f705-448f-5d3c-98bb-64132e7e4487" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+{e}^{xy}+3x=2" :db/id #edb/ref 17592186340324} {:answer/id #uuid "d7e295a6-c219-5315-8799-df81d3e3d181" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{xy}-\\frac{1}{2}{y}^{2}+3x=\\frac{1}{2}" :db/id #edb/ref 17592186340325} {:answer/id #uuid "48a270fb-0aa0-51af-a02d-c388ceda65c9" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{xy}+\\frac{3}{2}{y}^{2}+3x=\\frac{11}{2}" :db/id #edb/ref 17592186340326} {:answer/id #uuid "8315fe9a-0653-5303-ba33-a2a9362383ee" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x=\\frac{5}{2}" :db/id #edb/ref 17592186340327}] :answer-field/correct {:answer/id #uuid "8315fe9a-0653-5303-ba33-a2a9362383ee" :answer/type {:db/ident :answer.type/math} :answer/value "4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x=\\frac{5}{2}" :db/id #edb/ref 17592186340327} :answer-field/id #uuid "1c38c8f6-ed44-5451-a1f4-d420d3162da7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340322}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fb0676b3-5de0-51bf-9a0b-81cfc80be52a" :question/math-academy-id "q-321147" :question/problem "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{3+4y\\,{e}^{xy}}{3y-4x\\,{e}^{xy}},\n$$\n\nwith the initial condition $y(0)=1.$" :question/worked-solution "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{3+4y\\,{e}^{xy}}{3y-4x\\,{e}^{xy}},\\end{aligned}\n$$\n\nwe first multiply through by $(3y-4x\\,{e}^{xy})\\,\\text{d}x$:\n\n$$\n(3y-4x\\,{e}^{xy})\\,\\text{d}y=(3+4y\\,{e}^{xy})\\,\\text{d}x\n$$\n\nThen, we rearrange the terms:\n\n$$\n(3+4y\\,{e}^{xy})\\,\\text{d}x+(4x\\,{e}^{xy}-3y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=3+4y\\,{e}^{xy},\\,Q(x,y)=4x\\,{e}^{xy}-3y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(3+4y\\,{e}^{xy}) \\\\  & =4{e}^{xy}+4xy\\,{e}^{xy}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(4x\\,{e}^{xy}-3y) \\\\  & =4{e}^{xy}+4xy\\,{e}^{xy}\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\n \nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (3+4y\\,{e}^{xy})\\,\\text{d}x+f(y) \\\\  & =3x+4{e}^{xy}+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (4x\\,{e}^{xy}-3y)\\,\\text{d}y+g(x) \\\\  & =4{e}^{xy}-\\frac{3}{2}{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=3x,\\,f(y)=-\\frac{3}{2}{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=1$ when $x=0.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x & =c \\\\ 4{e}^{0\\cdot 1}-\\frac{3}{2}(1)^{2}+3\\cdot 0 & =c \\\\ c & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n4{e}^{xy}-\\frac{3}{2}{y}^{2}+3x=\\frac{5}{2}.\n$$"}] [{:db/id #edb/ref 17592186340328 :knowledge-point/_questions [{:knowledge-point/id #uuid "7bb08d6e-ae86-50f5-8cb4-d7fe50595849" :knowledge-point/title "Rearranging an ODE Into Exact Form and Then Solving"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4de7c67-e8fa-5a25-9166-7d12b340ee48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}{y}^{5}}{5}-{y}^{2}+2x=c" :db/id #edb/ref 17592186340330} {:answer/id #uuid "bef42a54-156f-5a7e-8d09-0a38ab07daff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}{y}^{5}}{5}-x+2y=c" :db/id #edb/ref 17592186340331} {:answer/id #uuid "190998d1-3d98-5c20-a456-40ddfec83ffa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}{y}^{5}}{5}-{x}^{2}+2y=c" :db/id #edb/ref 17592186340332} {:answer/id #uuid "304ea185-b4be-5d00-a2df-75147084b4dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}{y}^{5}}{5}-{x}^{2}+2x=c" :db/id #edb/ref 17592186340333} {:answer/id #uuid "d3d2cfc6-d096-5cdd-825d-4ada79a91e21" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}{y}^{5}}{5}-2x+2y=c" :db/id #edb/ref 17592186340334}] :answer-field/correct {:answer/id #uuid "b4de7c67-e8fa-5a25-9166-7d12b340ee48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}{y}^{5}}{5}-{y}^{2}+2x=c" :db/id #edb/ref 17592186340330} :answer-field/id #uuid "e761f5a2-3489-576e-9320-c6d1c49120de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340329}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fbbaa42a-3568-545a-bdcc-23f3e75863ee" :question/math-academy-id "q-321203" :question/problem "Find the general solution of the differential equation\n\n$$\n{y}^{′}=\\frac{2+{x}^{4}{y}^{5}}{2y-{x}^{5}{y}^{4}}.\n$$" :question/worked-solution "We start by rewriting this equation in differential form.\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nStarting from \n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{\\text{d}y}{\\text{d}x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{2+{x}^{4}{y}^{5}}{2y-{x}^{5}{y}^{4}},\\end{aligned}\n$$\n\nwe first multiply through by $(2y-{x}^{5}{y}^{4})\\,\\text{d}x$:\n\n$$\n(2y-{x}^{5}{y}^{4})\\,\\text{d}y=(2+{x}^{4}{y}^{5})\\,\\text{d}x\n$$\n\nThen, we  rearrange the terms:\n\n$$\n(2+{x}^{4}{y}^{5})\\,\\text{d}x+({x}^{5}{y}^{4}-2y)\\,\\text{d}y=0\n$$\n\nNow, we should check for exactness. A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFor our differential equation, we have\n\n$$\nP(x,y)=2+{x}^{4}{y}^{5},\\,Q(x,y)={x}^{5}{y}^{4}-2y.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}(2+{x}^{4}{y}^{5}) \\\\  & =5{x}^{4}{y}^{4}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x} & =\\frac{∂}{∂x}({x}^{5}{y}^{4}-2y) \\\\  & =5{x}^{4}{y}^{4}\\end{aligned}\n$$\n\nSo,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\\,✓\n$$\n\nThus, our equation is exact.\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (2+{x}^{4}{y}^{5})\\,\\text{d}x+f(y) \\\\  & =2x+\\frac{{x}^{5}{y}^{5}}{5}+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int ({x}^{5}{y}^{4}-2y)\\,\\text{d}y+g(x) \\\\  & =\\frac{{x}^{5}{y}^{5}}{5}-{y}^{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=2x,\\,f(y)=-{y}^{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n\\frac{{x}^{5}{y}^{5}}{5}-{y}^{2}+2x=c.\n$$"}] [{:db/id #edb/ref 17592186148075 :knowledge-point/_questions [{:knowledge-point/id #uuid "6ed6eeb5-a646-5f47-b6d8-f1078f550376" :knowledge-point/title "Identifying Factors Giving an Exact ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "987105b6-6efc-548a-92a2-82bd1f6712c3" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186146462} {:answer/id #uuid "a8d86731-7aed-5f2b-96a0-f421bf69d7d3" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186146463} {:answer/id #uuid "b1e4213a-c93e-5899-bc48-e492bfbcbf17" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186146464} {:answer/id #uuid "376cc1ab-793a-5c84-81c4-714df491f3c6" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186146465} {:answer/id #uuid "54f9aa97-dc86-50c1-8691-697c9bb46a2f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186146466}] :answer-field/correct {:answer/id #uuid "987105b6-6efc-548a-92a2-82bd1f6712c3" :answer/type {:db/ident :answer.type/text} :answer/value "I, II and III" :db/id #edb/ref 17592186146462} :answer-field/id #uuid "f83f97ce-cbc9-58c2-bc53-a272b5b0ea58" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146461}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3c92b66b-ccec-5e6d-8f75-9e3b9cdb1f7e" :question/math-academy-id "q-64207" :question/problem "Consider the following differential equation:\n\n$$\nP(x,y)\\,\\text{d}x+4{y}^{3}\\,\\text{d}y=0\n$$\n\nGiven that the differential equation is exact, which of the following functions could be $P(x,y)?$\n\n- $\\operatorname{cos}⁡(x)+8$\n- $\\operatorname{ln}⁡(x+1)-2$\n- $2x+7$" :question/worked-solution "A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}\n$$\n\nIn our case, we're given $Q(x,y)=4{y}^{3}.$ \n\nFirst, let's differentiate $Q(x,y)$ with respect to $x:$\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(4{y}^{3})=0\n$$\n\nNow, let's apply $\\frac{∂}{∂y}$ to each of the given options:\n\n- First, we check $P(x,y)=\\operatorname{cos}⁡(x)+8.$ This gives:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{cos}⁡(x)+8)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{cos}⁡(x)+8$ gives an exact equation.\n\n- Next, we check $P(x,y)=\\operatorname{ln}⁡(x+1)-3:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+1)-3)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=\\operatorname{ln}⁡(x+1)-3$ gives an exact equation.\n\n- Finally, we check $P(x,y)=2x+7:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2x+7)=0=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=2x+7$ gives an exact equation."}] [{:db/id #edb/ref 17592186340335 :knowledge-point/_questions [{:knowledge-point/id #uuid "4cbd51b4-cbd1-5e18-8c49-44be7967cd38" :knowledge-point/title "Solving an Exact Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6fdcdf7-c9c8-5ed5-bc50-1fa6445d36b3" :answer/type {:db/ident :answer.type/math} :answer/value "y\\operatorname{ln}⁡({x}^{3}+2)+{y}^{3}=c" :db/id #edb/ref 17592186340337} {:answer/id #uuid "43b63bc5-7955-57e0-88b2-75609347df18" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+xy+{y}^{2}=c" :db/id #edb/ref 17592186340338} {:answer/id #uuid "31ce7042-533e-5557-b52c-ecc0575d8cfb" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}y-6xy+x{y}^{3}=c" :db/id #edb/ref 17592186340339} {:answer/id #uuid "7e0369cd-3132-58eb-afc0-2f91772d385c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡({x}^{3}y+1)}{4}+xy=c" :db/id #edb/ref 17592186340340} {:answer/id #uuid "70654121-6936-5fa5-9c45-aed55859b838" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}y+\\frac{{y}^{4}}{2}=c" :db/id #edb/ref 17592186340341}] :answer-field/correct {:answer/id #uuid "70654121-6936-5fa5-9c45-aed55859b838" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}y+\\frac{{y}^{4}}{2}=c" :db/id #edb/ref 17592186340341} :answer-field/id #uuid "ad2b93b4-a690-57da-93b4-e32a0707e738" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340336}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "da33770a-9c81-5d44-ae0b-5a300064b2f3" :question/math-academy-id "q-64211" :question/problem "Find the general solution of the exact differential equation\n\n$$\n3{x}^{2}y\\,\\text{d}x+({x}^{3}+2{y}^{3})\\text{d}y=0.\n$$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=3{x}^{2}y$ and $Q(x,y)={x}^{3}+2{y}^{3}.$\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int 3{x}^{2}y\\,\\text{d}x+f(y) \\\\  & ={x}^{3}y+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int ({x}^{3}+2{y}^{3})\\,\\text{d}y+g(x) \\\\  & ={x}^{3}y+\\frac{{y}^{4}}{2}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=0,\\,f(y)=\\frac{{y}^{4}}{2}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n{x}^{3}y+\\frac{{y}^{4}}{2}=c.\n$$"}] [{:db/id #edb/ref 17592186148076 :knowledge-point/_questions [{:knowledge-point/id #uuid "4cbd51b4-cbd1-5e18-8c49-44be7967cd38" :knowledge-point/title "Solving an Exact Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9966ebf8-0f5f-51a6-9dc3-149517057acf" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} - y^{2} =-1" :db/id #edb/ref 17592186146468} {:answer/id #uuid "b5a17b25-4ef2-58b9-879a-fde82be35538" :answer/type {:db/ident :answer.type/math} :answer/value "xy + e^{xy} = 1" :db/id #edb/ref 17592186146469} {:answer/id #uuid "48583d79-14b8-5ccf-87a3-80d948b8bed8" :answer/type {:db/ident :answer.type/math} :answer/value "y^{2} + e^{xy} = 2" :db/id #edb/ref 17592186146470} {:answer/id #uuid "655eb48e-cc75-5f2e-b8b3-0309d188e190" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2} + e^{xy} = 1" :db/id #edb/ref 17592186146471} {:answer/id #uuid "7e1cc4a5-4fe4-5d2d-87f9-ba991a15cc19" :answer/type {:db/ident :answer.type/math} :answer/value "4x + xy + e^{y} = e" :db/id #edb/ref 17592186146472}] :answer-field/correct {:answer/id #uuid "7e1cc4a5-4fe4-5d2d-87f9-ba991a15cc19" :answer/type {:db/ident :answer.type/math} :answer/value "4x + xy + e^{y} = e" :db/id #edb/ref 17592186146472} :answer-field/id #uuid "1c52da4a-6e18-5c3b-b8f6-6eda4428aaba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146467}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9efa7792-8965-523c-b567-7789ca6c3aa3" :question/math-academy-id "q-64215" :question/problem "Find the solution of the exact differential equation\n\n$$\n(4+y)\\text{d}x+(x+{e}^{y})\\text{d}y=0\n$$\n\nthat satisfies the initial condition $y(0)=1.$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=4+y$ and $Q(x,y)=x+{e}^{y}.$\n\nSince the equation is exact, our solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (4+y)\\text{d}x+f(y) \\\\  & =4x+xy+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (x+{e}^{y})\\text{d}y+g(x) \\\\  & =xy+{e}^{y}+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=4x,\\,f(y)={e}^{y}.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n4x+xy+{e}^{y}=c.\n$$\n\nThe particular solution specified by the initial condition must have $y=1$ when $x=0.$ These values determine the value of the constant $c.$ Substituting this into the equation gives:\n\n$$\n\\begin{aligned}4x+xy+{e}^{y} & =c \\\\ 4(0)+(0)(1)+{e}^{1} & =c \\\\ c & =e\\end{aligned}\n$$\n\nTherefore, the solution is\n\n$$\n4x+xy+{e}^{y}=e.\n$$"}] [{:db/id #edb/ref 17592186340342 :knowledge-point/_questions [{:knowledge-point/id #uuid "4cbd51b4-cbd1-5e18-8c49-44be7967cd38" :knowledge-point/title "Solving an Exact Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c0828ce7-df15-517a-b61e-125f134075d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x+y}{2}+xy=c" :db/id #edb/ref 17592186340344} {:answer/id #uuid "242114e4-4c79-5d2c-9526-c2eb4c3c39db" :answer/type {:db/ident :answer.type/math} :answer/value "x{y}^{3}+{x}^{3}y+xy=c" :db/id #edb/ref 17592186340345} {:answer/id #uuid "cfc4bf10-6ef9-58a4-8f6d-b4ed6346599a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}{y}^{2}-\\frac{y}{x}=c" :db/id #edb/ref 17592186340346} {:answer/id #uuid "63ab6ad1-6d6f-5d59-8eb6-f3fe657f6ac5" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-4xy+{y}^{3}=c" :db/id #edb/ref 17592186340347} {:answer/id #uuid "ad7375cd-4277-5ccf-8ed0-75ceb660e33c" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+3x{y}^{2}-{x}^{3}y=c" :db/id #edb/ref 17592186340348}] :answer-field/correct {:answer/id #uuid "ad7375cd-4277-5ccf-8ed0-75ceb660e33c" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}+3x{y}^{2}-{x}^{3}y=c" :db/id #edb/ref 17592186340348} :answer-field/id #uuid "607ee7d2-e666-5db6-a456-72bc2f3083f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340343}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a52d91e-ac3b-5e2e-8961-60194ab9ab09" :question/math-academy-id "q-64219" :question/problem "Find the general solution of the differential equation\n\n$$\n(4x+3{y}^{2}-3{x}^{2}y)\\text{d}x+(6xy-{x}^{3})\\text{d}y=0.\n$$" :question/worked-solution "Note that the differential equation is of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nwhere $P(x,y)=4x+3{y}^{2}-3{x}^{2}y$ and $Q(x,y)=6xy-{x}^{3}.$\n\nLet's check if the equation is exact. To do this, we check to see if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nFirst, let's differentiate $P(x,y)$ with respect to $y:$\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂}{∂y}(4x+3{y}^{2}-3{x}^{2}y)=6y-3{x}^{2}\n$$\n\nNow, let's differentiate $Q(x,y)$ with respect to $x:$\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(6xy-{x}^{3})=6y-3{x}^{2}=\\frac{∂P}{∂y}\\,✓\n$$\n\nSo, the given equation is exact and its solution $u(x,y)$ must satisfy the following system:\n\n$$\n\\frac{∂u}{∂x}=P(x,y),\\,\\frac{∂u}{∂y}=Q(x,y)\n$$\n\nFirst, we integrate $P(x,y)$ with respect to $x.$ Note that the solution should contain an arbitrary function of $y:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int P(x,y)\\,\\text{d}x+f(y) \\\\  & =\\int (4x+3{y}^{2}-3{x}^{2}y)\\text{d}x+f(y) \\\\  & =2{x}^{2}+3x{y}^{2}-{x}^{3}y+f(y)\\end{aligned}\n$$\n\nNext, we integrate $Q(x,y)$ with respect to $y.$  Note that the solution should contain an arbitrary function of $x:$\n\n$$\n\\begin{aligned}u(x,y) & =\\int Q(x,y)\\,\\text{d}y+g(x) \\\\  & =\\int (6xy-{x}^{3})\\text{d}y+g(x) \\\\  & =3x{y}^{2}-{x}^{3}y+g(x)\\end{aligned}\n$$\n\nComparing the two solutions, we see that we must have\n\n$$\ng(x)=2{x}^{2},\\,f(y)=0.\n$$\n\nTherefore, the general solution $u(x,y)=c$ is\n\n$$\n2{x}^{2}+3x{y}^{2}-{x}^{3}y=c.\n$$"}] [{:db/id #edb/ref 17592186340349 :knowledge-point/_questions [{:knowledge-point/id #uuid "6ed6eeb5-a646-5f47-b6d8-f1078f550376" :knowledge-point/title "Identifying Factors Giving an Exact ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6788963-2536-54dd-a248-42342d8e26d3" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186340351} {:answer/id #uuid "05f7d98a-ecdf-5517-a50c-7d92e8c3f799" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186340352} {:answer/id #uuid "01c7cef0-dd72-5f38-a26d-3d93a2e2af71" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340353} {:answer/id #uuid "c6a231f1-fa72-5f22-8309-d138e41d4c0c" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186340354} {:answer/id #uuid "8ff21e5d-19ce-5a3e-afec-3832a5acf685" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186340355}] :answer-field/correct {:answer/id #uuid "01c7cef0-dd72-5f38-a26d-3d93a2e2af71" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186340353} :answer-field/id #uuid "a6d64997-7ece-5ca0-b47d-4e64db5be222" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340350}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8fa44e0d-f47d-55dc-9787-703e1dcaa8bd" :question/math-academy-id "q-90493" :question/problem "Consider the following differential equation:\n\n$$\nP(x,y)\\text{d}x+5{y}^{4}{e}^{2x}\\,\\text{d}y=0\n$$\n\nGiven that the differential equation is exact, which of the following functions could be $P(x,y)?$\n\n- $10{y}^{5}{e}^{x}+4$\n- $2{y}^{5}{e}^{2x}-y$\n- $2{y}^{5}{e}^{2x}+{e}^{-x}$" :question/worked-solution "A differential equation of the form\n\n$$\nP(x,y)\\text{d}x+Q(x,y)\\text{d}y=0\n$$\n\nis exact if it passes the exactness test, i.e.,\n\n$$\n\\frac{∂P}{∂y}=\\frac{∂Q}{∂x}.\n$$\n\nIn our case, we're given $Q(x,y)=5{y}^{4}{e}^{2x}.$ \n\nFirst, let's differentiate $Q(x,y)$ with respect to $x$:\n\n$$\n\\frac{∂Q}{∂x}=\\frac{∂}{∂x}(5{y}^{4}{e}^{2x})=10{y}^{4}{e}^{2x}\n$$\n\nNow, let's apply $\\frac{∂}{∂y}$ to each of the given options:\n\n- First, we check $P(x,y)=10{y}^{5}{e}^{x}+4.$ This gives:\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(10{y}^{5}{e}^{x}+4)=50{y}^{4}{e}^{x}\\ne \\frac{∂Q}{∂x}\\,\\times \\end{aligned}\n$$\n\nTherefore, $P(x,y)=10{y}^{5}{e}^{x}+4$ does *not* give an exact equation.\n\n- Next, we check $P(x,y)=2{y}^{5}{e}^{2x}-y:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2{y}^{5}{e}^{2x}-y)=10{y}^{4}{e}^{2x}-1\\ne \\frac{∂Q}{∂x}\\,\\times \\end{aligned}\n$$\n\nTherefore, $P(x,y)=2{y}^{5}{e}^{2x}-y$ does *not* give an exact equation.\n\n- Finally, we check $P(x,y)=2{y}^{5}{e}^{2x}+{e}^{-x}:$\n\n$$\n\\begin{aligned}\\frac{∂}{∂y}(2{y}^{5}{e}^{2x}+{e}^{-x})=10{y}^{4}{e}^{2x}=\\frac{∂Q}{∂x}\\,✓\\end{aligned}\n$$\n\nTherefore, $P(x,y)=2{y}^{5}{e}^{2x}+{e}^{-x}$ gives an exact equation."}]}
