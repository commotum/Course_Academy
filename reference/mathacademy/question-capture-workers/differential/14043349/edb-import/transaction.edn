451/field-2/619b81cb1e10d64e3031268fbdcd0788831828a8749a0c18fe0c45867dd31ec5" "q-341451/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c"] :db/ensure [:answer-field/validate]} {:db/id "q-341451" :question/id #uuid "83e320ec-a2b6-5adc-99bf-a554f2f85706" :question/math-academy-id "q-341451" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}3,\\, & t\\le 5 \\\\ {e}^{3t}\\, & t>5.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}3,\\, & t\\le 5 \\\\ {e}^{3t}\\, & t>5\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{3t}\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{3t-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{5}3{e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 3.$\n\nFor $s>3,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{5}3{e}^{-st}\\,\\text{d}t+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t \\\\  & =-\\frac{3}{s}{[{e}^{-st}]}_{0}^{5}+{\\int }_{5}^{\\infty }{e}^{(3-s)t}\\,\\text{d}t \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+{lim}_{a\\to \\infty }{\\int }_{5}^{a}{e}^{(3-s)t}\\,\\text{d}t \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+{lim}_{a\\to \\infty }{(\\frac{{e}^{(3-s)t}}{3-s})|}_{5}^{a} \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{1}{3-s}\\cdot {lim}_{a\\to \\infty }({e}^{(3-s)a}-{e}^{5(3-s)}) \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{1}{3-s}\\cdot (0-{e}^{5(3-s)}) \\\\  & =\\frac{3}{s}-\\frac{3{e}^{-5s}}{s}+\\frac{{e}^{5(3-s)}}{s-3}\\end{aligned}\n$$\n\nvalid for $s>3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341451/field-1" "q-341451/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "424fc261-d1ca-5bf0-b085-7af1de6cc7cc"] :knowledge-point/questions ["q-341451"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341466/field-1/468fb25ed015341de072df176c44f8a0ff16b919334a0beb8b7463cb08756df9" :answer/id #uuid "fa01c01b-ea70-5ed7-bf48-8b8d2386c492" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4(1-s)}}{s-1}+\\frac{2{e}^{-4s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341466/field-1/735761d5c810be7e9d33c0f290a33dd9cb8a8536047ac45fba604a57d2655011" :answer/id #uuid "470b7550-067e-5a9a-8211-5290fa6bd6ee" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4(1-s)}-1}{s-1}-\\frac{2{e}^{-4s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341466/field-1/02ad76ce055b67a3f281e358d2fdfdce3fe1522de387bb746a3a1a0daa3af320" :answer/id #uuid "470eba5b-2b04-5798-9b88-6dafaa927aba" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4(s-1)}}{s-1}+\\frac{2{e}^{-4s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341466/field-1/2c6170744d8620621257dc36a49ef98cd3656a6f488004ad6b2235d35f97d0b7" :answer/id #uuid "336b128c-7996-512e-b124-c18e9364d65c" :answer/type :answer.type/math :answer/value "\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341466/field-1" :answer-field/id #uuid "67217846-8af4-5f74-bc86-d2a95b2cf262" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-341466/field-1/2c6170744d8620621257dc36a49ef98cd3656a6f488004ad6b2235d35f97d0b7" :answer-field/choices ["q-341466/field-1/468fb25ed015341de072df176c44f8a0ff16b919334a0beb8b7463cb08756df9" "q-341466/field-1/735761d5c810be7e9d33c0f290a33dd9cb8a8536047ac45fba604a57d2655011" "q-341466/field-1/02ad76ce055b67a3f281e358d2fdfdce3fe1522de387bb746a3a1a0daa3af320" "q-341466/field-1/2c6170744d8620621257dc36a49ef98cd3656a6f488004ad6b2235d35f97d0b7"] :db/ensure [:answer-field/validate]} {:db/id "q-341466/field-2/9aa9dfbc88f5063553a847c368b29cb8dda581610b843fa8c8f6be915eb97944" :answer/id #uuid "ceabe3b2-b149-5d4d-b23f-037e6227a268" :answer/type :answer.type/math :answer/value "s\\ge 1" :db/ensure [:answer/validate]} {:db/id "q-341466/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" :answer/id #uuid "8f8c891c-d214-52b6-9067-cc0dfaa105ba" :answer/type :answer.type/math :answer/value "s>0" :db/ensure [:answer/validate]} {:db/id "q-341466/field-2/23424e5dffaca1bffc81dd2cc015a958b04177158815d98fdd41149314b3d874" :answer/id #uuid "bbe10f32-6bd2-51f4-9181-8a35117f5dde" :answer/type :answer.type/math :answer/value "s>4" :db/ensure [:answer/validate]} {:db/id "q-341466/field-2/34021d3854d8d25832b91720cc624a8e35c2f6fd4d7bab524d021edef59e6673" :answer/id #uuid "48f1c7f7-05f6-547b-b846-ede14161c2b2" :answer/type :answer.type/math :answer/value "s\\ge 4" :db/ensure [:answer/validate]} {:db/id "q-341466/field-2/ccd37af225235e99e0c0beacf5c114a7061b025eb104267b602d298657c10927" :answer/id #uuid "aa12e72c-64f8-5a61-915c-648b5fe9222e" :answer/type :answer.type/math :answer/value "s>1" :db/ensure [:answer/validate]} {:db/id "q-341466/field-2/9d34e85dabb5082358af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5" :answer/id #uuid "7b1129ff-af75-58d5-ab16-a7e136fbd038" :answer/type :answer.type/math :answer/value "s\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-341466/field-2" :answer-field/id #uuid "de5d7212-5b3c-5ba4-8232-f73f72534e2b" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-341466/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" :answer-field/choices ["q-341466/field-2/9aa9dfbc88f5063553a847c368b29cb8dda581610b843fa8c8f6be915eb97944" "q-341466/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" "q-341466/field-2/23424e5dffaca1bffc81dd2cc015a958b04177158815d98fdd41149314b3d874" "q-341466/field-2/34021d3854d8d25832b91720cc624a8e35c2f6fd4d7bab524d021edef59e6673" "q-341466/field-2/ccd37af225235e99e0c0beacf5c114a7061b025eb104267b602d298657c10927" "q-341466/field-2/9d34e85dabb5082358af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5"] :db/ensure [:answer-field/validate]} {:db/id "q-341466" :question/id #uuid "e29c720d-2e98-5ba0-939c-6a32ce63eeb4" :question/math-academy-id "q-341466" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{t},\\, & t\\le 4 \\\\ 2\\, & t>4.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{t},\\, & t\\le 4 \\\\ 2\\, & t>4\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{t-st}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{4}{e}^{(1-s)t}\\,\\text{d}t+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{1-s}{[{e}^{(1-s)t}]}_{0}^{4}+{\\int }_{4}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{\\int }_{4}^{a}2{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+{lim}_{a\\to \\infty }{(\\frac{-2{e}^{-st}}{s})|}_{4}^{a} \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}-\\frac{2}{s}\\cdot (0-{e}^{-4s}) \\\\  & =\\frac{{e}^{4(1-s)}-1}{1-s}+\\frac{2{e}^{-4s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341466/field-1" "q-341466/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "424fc261-d1ca-5bf0-b085-7af1de6cc7cc"] :knowledge-point/questions ["q-341466"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341481/field-1/a3e38918d878be6192794e923a32eb2ada7f9dcb09a141580f68c157784f899a" :answer/id #uuid "0a1d200d-2e09-5362-884c-7a4c528b8b13" :answer/type :answer.type/math :answer/value "\\frac{{e}^{-(3+s)}}{s+3}+\\frac{4{e}^{-s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341481/field-1/87a6e95ce75d0898c273cda41fe3df8a7fae21382854f605086614d119d8907c" :answer/id #uuid "29141fda-93f4-5320-b937-46ef6d25bbdf" :answer/type :answer.type/math :answer/value "\\frac{{e}^{-(3+s)}-1}{s+3}-\\frac{4{e}^{-s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341481/field-1/ea0961b95d794d1a780571355b516d29e3821923f259bee261fbfb8321c72ba2" :answer/id #uuid "3346567b-1a26-5214-812b-53d765768bcd" :answer/type :answer.type/math :answer/value "\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341481/field-1/eb4afb294e32462f985785d38f1ae84322419a8d6945999b9215c51a6ae941f1" :answer/id #uuid "8b9850bf-160a-528a-b7c1-2ab99eae6ce8" :answer/type :answer.type/math :answer/value "\\frac{{e}^{(3+s)}}{s+3}+\\frac{4{e}^{-s}}{s}" :db/ensure [:answer/validate]} {:db/id "q-341481/field-1" :answer-field/id #uuid "196bb3ae-ca9f-5fe1-8813-5a3d4db085e5" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-341481/field-1/ea0961b95d794d1a780571355b516d29e3821923f259bee261fbfb8321c72ba2" :answer-field/choices ["q-341481/field-1/a3e38918d878be6192794e923a32eb2ada7f9dcb09a141580f68c157784f899a" "q-341481/field-1/87a6e95ce75d0898c273cda41fe3df8a7fae21382854f605086614d119d8907c" "q-341481/field-1/ea0961b95d794d1a780571355b516d29e3821923f259bee261fbfb8321c72ba2" "q-341481/field-1/eb4afb294e32462f985785d38f1ae84322419a8d6945999b9215c51a6ae941f1"] :db/ensure [:answer-field/validate]} {:db/id "q-341481/field-2/9aa9dfbc88f5063553a847c368b29cb8dda581610b843fa8c8f6be915eb97944" :answer/id #uuid "044af014-4734-5c55-8e47-caaec0f9c498" :answer/type :answer.type/math :answer/value "s\\ge 1" :db/ensure [:answer/validate]} {:db/id "q-341481/field-2/b27c6ad4a150fc011c27e3de8a868bb278dc631337236c8a9c6591cd14787776" :answer/id #uuid "ea02b155-e202-550b-996b-370952eabe36" :answer/type :answer.type/math :answer/value "s>-3" :db/ensure [:answer/validate]} {:db/id "q-341481/field-2/9d34e85dabb5082358af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5" :answer/id #uuid "f9450133-089b-5237-b8d2-5b0f6c1833be" :answer/type :answer.type/math :answer/value "s\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-341481/field-2/ccd37af225235e99e0c0beacf5c114a7061b025eb104267b602d298657c10927" :answer/id #uuid "016a2796-8cfc-5c14-8333-c840d955f174" :answer/type :answer.type/math :answer/value "s>1" :db/ensure [:answer/validate]} {:db/id "q-341481/field-2/ff981c9b3e3b95e88575beb18f99ca8331554eb38f7abc2c17b08a20ed020d6c" :answer/id #uuid "66a1a33d-20d9-5244-96e0-77e092475b99" :answer/type :answer.type/math :answer/value "s\\ge -3" :db/ensure [:answer/validate]} {:db/id "q-341481/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" :answer/id #uuid "d58d4808-2379-5442-9651-792872929ab6" :answer/type :answer.type/math :answer/value "s>0" :db/ensure [:answer/validate]} {:db/id "q-341481/field-2" :answer-field/id #uuid "1eb756d5-9c0e-5bf5-9b3f-ad6f77920e72" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-341481/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" :answer-field/choices ["q-341481/field-2/9aa9dfbc88f5063553a847c368b29cb8dda581610b843fa8c8f6be915eb97944" "q-341481/field-2/b27c6ad4a150fc011c27e3de8a868bb278dc631337236c8a9c6591cd14787776" "q-341481/field-2/9d34e85dabb5082358af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5" "q-341481/field-2/ccd37af225235e99e0c0beacf5c114a7061b025eb104267b602d298657c10927" "q-341481/field-2/ff981c9b3e3b95e88575beb18f99ca8331554eb38f7abc2c17b08a20ed020d6c" "q-341481/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c"] :db/ensure [:answer-field/validate]} {:db/id "q-341481" :question/id #uuid "472a84d4-71fc-53d1-84b9-c9c734ba9c9f" :question/math-academy-id "q-341481" :question/problem "Use the definition of Laplace transforms to calculate $F(s)=L{f(t)},$ where $f(t)$ is given by \n\n$$\nf(t)={\\begin{aligned}{e}^{-3t},\\, & t\\le 1 \\\\ 4\\, & t>1.\\end{aligned}\n$$\n\n$\\,F(s)=L{f(t)}=$ {{field-1}},\nvalid for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n\n$$\nf(t)={\\begin{aligned}{e}^{-3t},\\, & t\\le 1 \\\\ 4\\, & t>1\\end{aligned}\n$$\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-3t-st}\\,\\text{d}t+{\\int }_{1}^{\\infty }4\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s\\le 0.$\n\nFor $s>0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{1}{e}^{-(3+s)t}\\,\\text{d}t+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{-(3+s)}{[{e}^{-(3+s)t}]}_{0}^{1}+{\\int }_{1}^{\\infty }4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{\\int }_{1}^{a}4{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+{lim}_{a\\to \\infty }{(\\frac{-4{e}^{-st}}{s})|}_{1}^{a} \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}-\\frac{4}{s}\\cdot (0-{e}^{-s}) \\\\  & =\\frac{1-{e}^{-(3+s)}}{3+s}+\\frac{4{e}^{-s}}{s}\\end{aligned}\n$$\n\nvalid for $s>0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341481/field-1" "q-341481/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "424fc261-d1ca-5bf0-b085-7af1de6cc7cc"] :knowledge-point/questions ["q-341481"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6641"] :question/problem "Use the definition of Laplace transforms to calculate $F(s) = \\mathcal L\\{f(t)\\}$ for $f(t) = u(t - 2) + u(t-6),$ where $u$ is the unit step function." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nRecall that the unit step function is defined as\n\n$$\n\\begin{aligned}u(t)={\\begin{aligned}0,\\, & t<0 \\\\ 1,\\, & t\\ge 0.\\end{aligned}\\end{aligned}\n$$\n\nSo, for the piecewise functions $u(t-2)$ and $u(t-6),$ we have \n\n$$\n\\begin{aligned}u(t-2) & ={\\begin{aligned}0,\\, & t<2 \\\\ 1,\\, & t\\ge 2\\end{aligned} \\\\ u(t-6) & ={\\begin{aligned}0,\\, & t<6 \\\\ 1,\\, & t\\ge 6.\\end{aligned}\\end{aligned}\n$$\n\nTherefore,\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043349/assets/6ddb2983dec1f3221778a336bb6ef3cce3138476b67d64334ab6660184a79f95.png)\n\nSo, for our Laplace transform, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}0\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{2}^{6}1\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{6}^{\\infty }2\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{2}^{6}{e}^{-st}\\,\\text{d}t+{\\int }_{6}^{\\infty }2{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the second integral diverges for $s \\leq 0.$\n\nFor $s > 0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{2}^{6}{e}^{-st}\\,\\text{d}t+{\\int }_{6}^{\\infty }2{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{2}^{6}{e}^{-st}\\,\\text{d}t+2{lim}_{a\\to \\infty }{\\int }_{6}^{a}{e}^{-st}\\,\\text{d}t \\\\  & ={[-\\frac{{e}^{-st}}{s}]}_{2}^{6}+2{lim}_{a\\to \\infty }{(-\\frac{{e}^{-st}}{s})|}_{6}^{a} \\\\  & =-\\frac{{e}^{-6s}}{s}+\\frac{{e}^{-2s}}{s}-\\frac{2}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-sa}-{e}^{-6s}) \\\\  & =\\frac{{e}^{-2s}}{s}-\\frac{{e}^{-6s}}{s}-\\frac{2}{s}(0-{e}^{-6s}) \\\\  & =\\frac{{e}^{-2s}}{s}-\\frac{{e}^{-6s}}{s}+\\frac{2{e}^{-6s}}{s} \\\\  & =\\frac{{e}^{-2s}}{s}+\\frac{{e}^{-6s}}{s}\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\mathcal{L}\\left\\{f(t)\\right\\} =\\dfrac{e^{-2s}}{s} +\\dfrac{e^{-6s}}{s}, \n\\qquad \ns > 0.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21842"] :question/problem "Use the definition of Laplace transforms to calculate $F(s) = \\mathcal L\\{f(t)\\},$ where $f(t)$ is given by \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043349/assets/e70e54b6a70cebd480b86baf9d0e1d90bde0b3d9277c982d5d5e77218d0d2f5d.png)" :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t\\end{aligned}\n$$\n\nSo, for the piecewise function \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043349/assets/48965cee8a09df4f637b4d997fdb9c90673e69a90ea1320434f9b471a2fed280.png)\n\nwe have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }f(t){e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}{e}^{2t}\\cdot {e}^{-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }1\\cdot {e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}{e}^{2t-st}\\,\\text{d}t+{\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & ={\\int }_{0}^{3}{e}^{(2-s)t}\\,\\text{d}t+{\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t.\\end{aligned}\n$$\n\nNote that the improper integral diverges if $s \\leq 0.$\n\nFor $s > 0,$ we calculate our Laplace transform as follows:\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{3}{e}^{(2-s)t}\\,\\text{d}t+{\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{1}{2-s}{[{e}^{(2-s)t}]}_{0}^{3}+{\\int }_{3}^{\\infty }{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{3(2-s)}-1}{2-s}+{lim}_{a\\to \\infty }{\\int }_{3}^{a}{e}^{-st}\\,\\text{d}t \\\\  & =\\frac{{e}^{3(2-s)}-1}{2-s}+{lim}_{a\\to \\infty }{(\\frac{-{e}^{-st}}{s})|}_{3}^{a} \\\\  & =\\frac{{e}^{3(2-s)}-1}{2-s}-\\frac{1}{s}\\cdot {lim}_{a\\to \\infty }({e}^{-as}-{e}^{-3s}) \\\\  & =\\frac{{e}^{3(2-s)}-1}{2-s}-\\frac{1}{s}\\cdot (0-{e}^{-3s}) \\\\  & =\\frac{{e}^{3(2-s)}-1}{2-s}+\\frac{{e}^{-3s}}{s}\\end{aligned}\n$$\n\nvalid for $s > 0.$" :db/ensure [:question/validate]}]
