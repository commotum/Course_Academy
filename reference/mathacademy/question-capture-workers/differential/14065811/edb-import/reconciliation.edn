724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-79285" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=5\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-79285" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=5\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-79285" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=5\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-327835" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/assets/6f983fda4328227558e46aaaec454db2ccc0611331495c923ad1d90c7cb3df8a.png)\n\nThe semi-ellipse above is defined by the parametric equations \n\n$$\nx=8\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$ Assume $\\theta $ is between $0$ and $2\\pi .$\n\n$\\theta \\in [${{field-1}},\n{{field-2}}$]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-327835" "field" nil "attribute" "question/worked-solution" "value" "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=8$ and $b=3.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=8\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a semi-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the ellipse and the $x$-axis. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/assets/101d9b26027bc5667009b0c7af69fa190c987c362122402fce62daec5833092f.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\pi ]$, we get the semi-ellipse.\n\nTherefore, the parametric equations of the semi-ellipse are \n\n$$\nx=8\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\pi ].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-327835" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/activity-metadata.json" "file_sha256" "4be40ac811c9a7849b7e9caf70e564b541ed013e8fe8332c47f598abf0a761c5" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-327835" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-327835" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-327835" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"} {"question" "q-327835" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\pi"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/state.json" "file_sha256" "6c50ccf2eb6eb588c96a6d1d04405f10aed49d9823dabb788d7410487869bfc6" "basis" 1471 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040724/edb-import/verification.json"}] "sources" [{"question" "q-79282" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/assets/1617a8efd9110fa435dc396d90450c7fe17d18105e2358ab5610135e32a385ad.png)\n\nThe half-ellipse above is defined by the parametric equations \n\n$$\nx=4\\operatorname{cos}⁡\\theta -3,\\,y=2\\operatorname{sin}⁡\\theta -1.\n$$\n\nWhat is the domain of the parameter $\\theta ?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-79282" "field" nil "attribute" "question/worked-solution" "value" "The parametric equations of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the ellipse is centered at the point $(-3,-1),$ $a=4$ and $b=2.$  Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=4\\operatorname{cos}⁡\\theta -3,\\,y=2\\operatorname{sin}⁡\\theta -1,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a half-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the ellipse and the line parallel to the $x$-axis and crossing the center of the ellipse.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/assets/4659fda20ed9a2b5e5c10d60f504e4db378efb0bfe9ae037f4998511e75300cb.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\pi ]$, we get the half-ellipse.\n\nTherefore, the parametric equations of the half-ellipse are \n\n$$\nx=4\\operatorname{cos}⁡\\theta -3,\\,y=2\\operatorname{sin}⁡\\theta -1,\\,\\theta \\in [0,\\pi ].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-79282" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/activity-metadata.json" "file_sha256" "13897f30db4fe65d410e9e4e28bbbc9218f3c6e4f6c91195c507e85c9416a173"} {"question" "q-79282" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-79282" "field" "selection" "attribute" "answer-field/choices" "value" [[