⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-79285" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/activity-metadata.json" "file_sha256" "13897f30db4fe65d410e9e4e28bbbc9218f3c6e4f6c91195c507e85c9416a173"} {"question" "q-79285" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-79285" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=10\\operatorname{cos}⁡\\theta +2,\\,y=6\\operatorname{sin}⁡\\theta -3"] ["math" "x=10\\operatorname{cos}⁡\\theta -3,\\,y=6\\operatorname{sin}⁡\\theta +2"] ["math" "x=25\\operatorname{cos}⁡\\theta -2,\\,y=9\\operatorname{sin}⁡\\theta +3"] ["math" "x=5\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -2"] ["math" "x=5\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-79285" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=5\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-106704" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/assets/5bd3bf7cecf806ab0fc89db59afc5d385064080f47076d13d2ef25650ce39a23.png)\n\nWhich of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate the ellipse shown above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-106704" "field" nil "attribute" "question/worked-solution" "value" "The parametric equations of an ellipse centered at the point $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta +h,\\,y=b\\operatorname{sin}⁡\\theta +k,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the ellipse is centered at the point $(3,-2),$ $a=3$ and $b=8.$ Therefore, the parametric equations of the ellipse are\n\n$$\nx=3\\operatorname{cos}⁡\\theta +3,\\,y=8\\operatorname{sin}⁡\\theta -2,\\,\\theta \\in [0,2\\pi ).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-106704" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/activity-metadata.json" "file_sha256" "13897f30db4fe65d410e9e4e28bbbc9218f3c6e4f6c91195c507e85c9416a173"} {"question" "q-106704" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-106704" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x=3\\operatorname{cos}⁡\\theta +3,\\,y=8\\operatorname{sin}⁡\\theta -2"] ["math" "x=3\\operatorname{cos}⁡\\theta -3,\\,y=8\\operatorname{sin}⁡\\theta +2"] ["math" "x=64\\operatorname{cos}⁡\\theta +3,\\,y=9\\operatorname{sin}⁡\\theta -2"] ["math" "x=8\\operatorname{cos}⁡\\theta +3,\\,y=3\\operatorname{sin}⁡\\theta -2"] ["math" "x=8\\operatorname{cos}⁡\\theta -3,\\,y=3\\operatorname{sin}⁡\\theta +2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-106704" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x=3\\operatorname{cos}⁡\\theta +3,\\,y=8\\operatorname{sin}⁡\\theta -2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327809" "field" nil "attribute" "question/problem" "value" "The Cartesian equation of the ellipse defined by the parametric equations\n\n$$\nx=9\\operatorname{cos}⁡\\theta ,\\,y=4\\sqrt{3}\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta <2\\pi .\n$$\n\nis given by\n\n{{field-1}}\n$=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327809" "field" nil "attribute" "question/worked-solution" "value" "To find the Cartesian equation of the ellipse, we need to eliminate the parameter $\\theta .$ We can do this using the Pythagorean theorem.\n\nBy isolating the $\\operatorname{cos}⁡\\theta $ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =9\\operatorname{cos}⁡\\theta  \\\\ \\frac{x}{9} & =\\operatorname{cos}⁡\\theta  \\\\ \\frac{{x}^{2}}{{9}^{2}} & ={cos}^{2}⁡\\theta  \\\\ \\frac{{x}^{2}}{81} & ={cos}^{2}⁡\\theta .\\end{aligned}\n$$\n\nBy isolating the $\\operatorname{sin}⁡\\theta $ term in the $y$-equation and squaring, we obtain\n\n$$\n\\begin{aligned}y & =4\\sqrt{3}\\operatorname{sin}⁡\\theta  \\\\ \\frac{y}{4\\sqrt{3}} & =\\operatorname{sin}⁡\\theta  \\\\ \\frac{{y}^{2}}{(4\\sqrt{3})^{2}} & ={sin}^{2}⁡\\theta  \\\\ \\frac{{y}^{2}}{48} & ={sin}^{2}⁡\\theta .\\end{aligned}\n$$\n\nAdding the two equations and using ${cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1,$ we get\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{48}={cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta =1.\n$$\n\nSo, the Cartesian equation of the ellipse is\n\n$$\n\\frac{{x}^{2}}{81}+\\frac{{y}^{2}}{48}=1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327809" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/activity-metadata.json" "file_sha256" "13897f30db4fe65d410e9e4e28bbbc9218f3c6e4f6c91195c507e85c9416a173"} {"question" "q-327809" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327809" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x^2}{81}+\\frac{y^2}{48}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327835" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/assets/6f983fda4328227558e46aaaec454db2ccc0611331495c923ad1d90c7cb3df8a.png)\n\nThe semi-ellipse above is defined by the parametric equations \n\n$$\nx=8\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$ Assume $\\theta $ is between $0$ and $2\\pi .$\n\n$\\theta \\in [${{field-1}},\n{{field-2}}$]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327835" "field" nil "attribute" "question/worked-solution" "value" "The parametric equations of an ellipse centered at the origin with a horizontal radius of length $a$ and a vertical radius of length $b$ are\n\n$$\nx=a\\operatorname{cos}⁡\\theta ,\\,y=b\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, $a=8$ and $b=3.$ Therefore, the parametric equations of the *full* ellipse are\n\n$$\nx=8\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a semi-ellipse, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the ellipse and the $x$-axis. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/assets/101d9b26027bc5667009b0c7af69fa190c987c362122402fce62daec5833092f.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\pi ]$, we get the semi-ellipse.\n\nTherefore, the parametric equations of the semi-ellipse are \n\n$$\nx=8\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\pi ].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327835" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/activity-metadata.json" "file_sha256" "13897f30db4fe65d410e9e4e28bbbc9218f3c6e4f6c91195c507e85c9416a173"} {"question" "q-327835" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327835" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327835" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065811/state.json" "file_sha256" "b3b8820b660b1350d33a209fdf26cda90f7f97c4431fc5468150a7e41acf483f"} {"question" "q-327835" "field" "field-2" "attribute