#{[{:db/id #edb/ref 17592186355891 :knowledge-point/_questions [{:knowledge-point/id #uuid "cb9cfe3a-6341-5a25-a513-8ef20b5a7f7c" :knowledge-point/title "Reducing a First-Order ODE to a Separable Form by Factoring and Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9caef134-8e25-5ad3-8e66-d460e11bb037" :answer/type {:db/ident :answer.type/math} :answer/value "3z+2" :db/id #edb/ref 17592186355893} {:answer/id #uuid "8c883cd1-5b5c-524e-b9f4-9000a0c1b275" :answer/type {:db/ident :answer.type/math} :answer/value "6z+1" :db/id #edb/ref 17592186355894} {:answer/id #uuid "c900d75d-232a-524b-9d9d-e837268a025d" :answer/type {:db/ident :answer.type/math} :answer/value "6z" :db/id #edb/ref 17592186355895} {:answer/id #uuid "f7b1784e-8c9d-5ece-84a8-1400710cb6c7" :answer/type {:db/ident :answer.type/math} :answer/value "3z" :db/id #edb/ref 17592186355896} {:answer/id #uuid "2a81759d-01ee-54d5-8623-e698f6ed80a0" :answer/type {:db/ident :answer.type/math} :answer/value "2z+1" :db/id #edb/ref 17592186355897}] :answer-field/correct {:answer/id #uuid "8c883cd1-5b5c-524e-b9f4-9000a0c1b275" :answer/type {:db/ident :answer.type/math} :answer/value "6z+1" :db/id #edb/ref 17592186355894} :answer-field/id #uuid "8bbe70c9-2bb7-5514-b02f-3f7e4dd51a30" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355892}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f3db89b1-1677-58e1-bc7f-a28efef6c8ab" :question/math-academy-id "q-108735" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=3x+6y.\n$$\n\nUsing a substitution of the form $z=x+2y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we factor the right-hand side of the given equation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =3(x+2y).\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=x+2y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+2\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2}(\\frac{\\text{d}z}{\\text{d}x}-1).\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}(\\frac{\\text{d}z}{\\text{d}x}-1) & =3z\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=6z+1.\n$$\n\nTherefore, $f(z)=6z+1.$"}] [{:db/id #edb/ref 17592186355898 :knowledge-point/_questions [{:knowledge-point/id #uuid "cb9cfe3a-6341-5a25-a513-8ef20b5a7f7c" :knowledge-point/title "Reducing a First-Order ODE to a Separable Form by Factoring and Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51612dac-eda1-5ccc-b7d8-6cd0310d07fb" :answer/type {:db/ident :answer.type/math} :answer/value "2z" :db/id #edb/ref 17592186355900} {:answer/id #uuid "d81f953d-07ad-56aa-8ae3-a57b427fb1f4" :answer/type {:db/ident :answer.type/math} :answer/value "3-2z" :db/id #edb/ref 17592186355901} {:answer/id #uuid "4eada411-719d-5529-a53c-a219eb07561f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{z+2}{2}" :db/id #edb/ref 17592186355902} {:answer/id #uuid "87f7fedc-9cb3-53ef-b585-0159f878b516" :answer/type {:db/ident :answer.type/math} :answer/value "6-z" :db/id #edb/ref 17592186355903} {:answer/id #uuid "37af3e1d-35f4-5288-9d03-489f08189fcb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2z-1}{4}" :db/id #edb/ref 17592186355904}] :answer-field/correct {:answer/id #uuid "51612dac-eda1-5ccc-b7d8-6cd0310d07fb" :answer/type {:db/ident :answer.type/math} :answer/value "2z" :db/id #edb/ref 17592186355900} :answer-field/id #uuid "922b6933-dba3-587c-9670-45e3901e8f12" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355899}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6cab1a85-35c1-5dc8-a717-af6a11e616be" :question/math-academy-id "q-108750" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{2x+8y-1}{4}.\n$$\n\nUsing a substitution of the form $z=x+4y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we factor the right-hand side of the given equation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2(x+4y)-1}{4}.\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=x+4y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+4\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{4}(\\frac{\\text{d}z}{\\text{d}x}-1).\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{4}(\\frac{\\text{d}z}{\\text{d}x}-1) & =\\frac{2z-1}{4}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2z.\n$$\n\nTherefore, $f(z)=2z.$"}] [{:db/id #edb/ref 17592186355905 :knowledge-point/_questions [{:knowledge-point/id #uuid "6655eb29-8410-5a5c-be86-457affcfb4c3" :knowledge-point/title "Solving a First-Order ODE by Factoring and Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c20c8d35-033b-5ff5-86e7-e038af428d6b" :answer/type {:db/ident :answer.type/math} :answer/value "3x+3y" :db/id #edb/ref 17592186355907} {:answer/id #uuid "97e8845f-8758-5144-9527-a7c31c2b94e7" :answer/type {:db/ident :answer.type/math} :answer/value "3x+3y-1" :db/id #edb/ref 17592186355908} {:answer/id #uuid "73380151-d5fd-583b-bb58-46a0787ca09e" :answer/type {:db/ident :answer.type/math} :answer/value "x+y" :db/id #edb/ref 17592186355909} {:answer/id #uuid "91ec4203-e15e-5428-9db4-993948a8fda2" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+{y}^{2}" :db/id #edb/ref 17592186355910} {:answer/id #uuid "be66a95b-c1c9-57ac-925a-f56a550b3b13" :answer/type {:db/ident :answer.type/math} :answer/value "3-{x}^{2}+{y}^{2}" :db/id #edb/ref 17592186355911}] :answer-field/correct {:answer/id #uuid "c20c8d35-033b-5ff5-86e7-e038af428d6b" :answer/type {:db/ident :answer.type/math} :answer/value "3x+3y" :db/id #edb/ref 17592186355907} :answer-field/id #uuid "9fe21f47-1ebc-507f-aacc-b133d33bf32a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355906}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "7a64bfa3-c0ef-53da-9e38-b194f0c2decf" :question/math-academy-id "q-108780" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=2{sin}^{2}⁡(3x+3y)-1.\n$$\n\nThe general solution to this equation can be expressed in the form\n\n$$\n\\operatorname{cot}⁡(g(x,y))=-6x+C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we factor the right-hand side of the given equation.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2{sin}^{2}⁡(3(x+y))-1\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =2{sin}^{2}⁡(3z)-1\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2{sin}^{2}⁡(3z).\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}{csc}^{2}⁡(3z)\\,\\frac{\\text{d}z}{\\text{d}x} & =2 \\\\ \\int {csc}^{2}⁡(3z)\\,\\text{d}z & =\\int 2\\,\\text{d}x \\\\ -\\frac{1}{3}\\operatorname{cot}⁡(3z) & =2x+K \\\\ \\operatorname{cot}⁡(3z) & =-6x+C\\end{aligned}\n$$\n\nwhere $C=-3K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\operatorname{cot}⁡(3x+3y)=-6x+C\n$$\n\nTherefore, \n\n$$\ng(x,y)=3x+3y.\n$$"}] [{:db/id #edb/ref 17592186355912 :knowledge-point/_questions [{:knowledge-point/id #uuid "6655eb29-8410-5a5c-be86-457affcfb4c3" :knowledge-point/title "Solving a First-Order ODE by Factoring and Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13f461a0-2479-552e-b87d-58e400a3eb5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cot}⁡(2x-2y)" :db/id #edb/ref 17592186355914} {:answer/id #uuid "7b44eaa0-97f9-5b5e-961e-28ced49419d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x-2y)" :db/id #edb/ref 17592186355915} {:answer/id #uuid "cc58c8ab-1c38-5678-be04-b460d02f196a" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡(2x-2y)" :db/id #edb/ref 17592186355916} {:answer/id #uuid "43beb5a9-92aa-566d-a573-b1a395ab936f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡(2x-2y)" :db/id #edb/ref 17592186355917} {:answer/id #uuid "ee6b4f30-d9c6-5511-960e-6bb6d54f7e76" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡(2x-2y)" :db/id #edb/ref 17592186355918}] :answer-field/correct {:answer/id #uuid "7b44eaa0-97f9-5b5e-961e-28ced49419d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡(2x-2y)" :db/id #edb/ref 17592186355915} :answer-field/id #uuid "eead8314-3740-5c28-bddb-cc252bc74799" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355913}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0b284936-a6fa-5551-8450-4970d6b1619b" :question/math-academy-id "q-108849" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=1-3\\operatorname{sec}⁡(2x-2y).\n$$\n\nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=6x+C,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we factor the right-hand side of the given equation.\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =1-3\\operatorname{sec}⁡(2(x-y))\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=x-y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1-\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=1-\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}1-\\frac{\\text{d}z}{\\text{d}x} & =1-3\\operatorname{sec}⁡(2z)\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=3\\operatorname{sec}⁡(2z).\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2z)\\,\\frac{\\text{d}z}{\\text{d}x} & =3 \\\\ \\int \\operatorname{cos}⁡(2z)\\,\\text{d}z & =\\int 3\\,\\text{d}x \\\\ \\frac{1}{2}\\operatorname{sin}⁡(2z) & =3x+K \\\\ \\operatorname{sin}⁡(2z) & =6x+C\\end{aligned}\n$$\n\nwhere $C=2K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\operatorname{sin}⁡(2x-2y)=6x+C\n$$\n\nTherefore, \n\n$$\ng(x,y)=\\operatorname{sin}⁡(2x-2y).\n$$"}] [{:db/id #edb/ref 17592186355919 :knowledge-point/_questions [{:knowledge-point/id #uuid "cb9cfe3a-6341-5a25-a513-8ef20b5a7f7c" :knowledge-point/title "Reducing a First-Order ODE to a Separable Form by Factoring and Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a03db04-63f8-50bf-8a45-c8130f553bc0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-5z}{z+1}" :db/id #edb/ref 17592186355921} {:answer/id #uuid "f9403b26-4081-56f3-ae13-ab487968b44c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2z}{z+1}" :db/id #edb/ref 17592186355922} {:answer/id #uuid "7c447109-66ac-5eea-958b-9e6eccbf61a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2z+1}{z+1}" :db/id #edb/ref 17592186355923} {:answer/id #uuid "583ad102-a3ad-53d9-9267-f0f7aa0e90a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4z+5}{z+1}" :db/id #edb/ref 17592186355924} {:answer/id #uuid "104b2288-2db7-5024-a67c-2de85dcc7948" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7z+5}{z+1}" :db/id #edb/ref 17592186355925}] :answer-field/correct {:answer/id #uuid "104b2288-2db7-5024-a67c-2de85dcc7948" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7z+5}{z+1}" :db/id #edb/ref 17592186355925} :answer-field/id #uuid "933c1c0d-edf0-5bb3-bb4b-33cda388d169" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355920}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fd506b7c-591c-5881-937e-94db4a95aca3" :question/math-academy-id "q-149744" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{10x+2y}{5x+y+1}.\n$$\n\nUsing a substitution of the form $z=5x+y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we factor the right-hand side of the given equation, and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2(5x+y)}{(5x+y)+1}.\\end{aligned}\n$$\n\nThen, we make the substitution\n\n$$\nz=5x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=5+\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-5.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-5 & =\\frac{2z}{z+1}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{7z+5}{z+1}.\n$$\n\nTherefore, $f(z)=\\frac{7z+5}{z+1}.$"}]}
