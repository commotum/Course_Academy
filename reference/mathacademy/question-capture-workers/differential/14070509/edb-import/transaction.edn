4/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "2220ba90-39ac-52a8-a37b-8630a9b6d4d2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-343421/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" :answer/id #uuid "c2b7d564-2fdd-5f16-ba21-641cde0d5b63" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{8}" :db/ensure [:answer/validate]} {:db/id "q-343421/field-4/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "c815383a-26c5-506e-a8fd-dd53e1f07b59" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-343421/field-4/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "fbc40c98-99d0-52fe-9d23-4f9783460f09" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-343421/field-4" :answer-field/id #uuid "0d4b4835-5486-5381-a3f9-55eabb003ddc" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-343421/field-4/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-343421/field-4/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-343421/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" "q-343421/field-4/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-343421/field-4/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5"] :db/ensure [:answer-field/validate]} {:db/id "q-343421" :question/id #uuid "2c46e673-8911-5991-b17e-9211e1d2e00c" :question/math-academy-id "q-343421" :question/problem "Consider the function $F(x)=|\\operatorname{sin}⁡(\\frac{x}{2})|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{2}{\\pi }-{\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (4{n}^{2}-1)}\\operatorname{cos}⁡(nx).\n$$\n\nSelect the correct options in the reasoning below.At $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(nx).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=|\\operatorname{sin}⁡(\\frac{0}{2})|=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(n\\cdot 0) \\\\ 0 & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot 1 \\\\ -\\frac{2}{\\pi } & =-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1} & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-343421/field-1" "q-343421/field-2" "q-343421/field-3" "q-343421/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f"] :knowledge-point/questions ["q-343421"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343395/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "8f0d6f86-8b89-5685-8a4f-dae064535e92" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-343395/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "85463ebb-9449-53ab-8cfe-02522ba843d9" :answer