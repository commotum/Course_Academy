1b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "991133f8-dc75-58d3-9eee-b20ea3d8eb5f" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-343395/field-4/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc" :answer/id #uuid "24b1cdda-9e2b-5ea3-b69e-38473863b974" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-343395/field-4" :answer-field/id #uuid "d35f2b07-814d-5bfd-92b3-19855616a5cd" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-343395/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" :answer-field/choices ["q-343395/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" "q-343395/field-4/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-343395/field-4/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-343395/field-4/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc"] :db/ensure [:answer-field/validate]} {:db/id "q-343395" :question/id #uuid "e361d1a0-a782-5eed-a0dc-4cde0324cd70" :question/math-academy-id "q-343395" :question/problem "Consider the function $F(x)=|x|$ defined on $x\\in [-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼1-{\\sum }_{n=1}^{\\infty }\\frac{8}{{\\pi }^{2}(2n-1)^{2}}\\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}x).\n$$\n\nSelect the correct options in the reasoning below.At $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼1-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}x).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =1-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡(\\frac{(2n-1)\\pi }{2}\\cdot 0) \\\\ 0 & =1-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot 1 \\\\ -1 & =-\\frac{8}{{\\pi }^{2}}{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} & =\\frac{{\\pi }^{2}}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-343395/field-1" "q-343395/field-2" "q-343395/field-3" "q-343395/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f"] :knowledge-point/questions ["q-343395"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186164948 :answer-field/correct 17592186164951 :db/ensure [:answer-field/validate]} {:db/id "q-342571/field-2/f97aa1dab6b91b65fe50561f5e5db64857823d9990715ee59138c66d2b73c7cd" :answer/id #uuid "c904d7de-87a5-5502-8b63-c4ff10ac24b2" :answer/type :answer.type/text :answer/value "discontinuous" :db/ensure [:answer/validate]} {:db/id "q-342571/field-2/f6827777da56db4bd58931c1c2eeb6c100de3d85bc42415c024f44e98b718fe9" :answer/id #uuid "31fe869d-3da5-5f76-b1ee-1f4c7a960d7e" :answer/type :answer.type/text :answer/value "continuous" :db/ensure [:answer/validate]} {:db/id "q-342571/field-2" :answer-field/id #uuid "7753cf13-4998-5a8a-ae84-89951527d374" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-342571/field-2/f6827777da56db4bd58931c1c2eeb6c100de3d85bc42415c024f44e98b718fe9" :answer-field/choices ["q-342571/field-2/f97aa1dab6b91b6