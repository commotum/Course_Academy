31fab4d9f58426a7f011e5" :answer/id #uuid "a2bf7080-e41f-535c-aaf2-3d32cd1ba745" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-342571/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" :answer/id #uuid "3067c4a2-27f7-5938-82ec-00ad09e88b9f" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{8}" :db/ensure [:answer/validate]} {:db/id "q-342571/field-4" :answer-field/id #uuid "b8f110ab-4657-54fd-a450-84cb464111b1" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-342571/field-4/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer-field/choices ["q-342571/field-4/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-342571/field-4/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc" "q-342571/field-4/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-342571/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-342571"] :question/problem "$$\nF(x)={\\begin{aligned}0, & x\\in [-\\pi ,0] \\\\ 1, & x\\in (0,\\pi )\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{1}{2}+{\\sum }_{n=1}^{\\infty }\\frac{2}{\\pi (2n-1)}\\operatorname{sin}⁡((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.At $x=\\frac{\\pi }{2},$ we have\n\n$$\n\\operatorname{sin}⁡((2n-1)\\cdot \\frac{\\pi }{2})={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(\\frac{\\pi }{2})={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{1}{2}+\\frac{2}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot \\operatorname{sin}⁡((2n-1)x).\n$$\n\nNow, notice that at $x=\\frac{\\pi }{2},$ we have\n\n$$\n\\operatorname{sin}⁡((2n-1)\\cdot \\frac{\\pi }{2})=\\operatorname{sin}⁡(-\\frac{\\pi }{2}+n\\pi )=(-1)^{n+1}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=\\frac{\\pi }{2},$ the corresponding Fourier series converges to \n\n$$\nf(\\frac{\\pi }{2})=1.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(\\frac{\\pi }{2}) & =\\frac{1}{2}+\\frac{2}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot \\operatorname{sin}⁡((2n-1)\\cdot \\frac{\\pi }{2}) \\\\ 1 & =\\frac{1}{2}+\\frac{2}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n+1} \\\\ \\frac{1}{2} & =\\frac{2}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342571/field-2" "q-342571/field-3" "q-342571/field-4"] :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21865"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070509/assets/73b3d7951ab2c2a355763f71d2dd97dc4c9c5921bc087ae83af3936b0daf5d8a.png)\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $\\pi$-periodic extension $f(x)$ of $F(x)$ converges when $x=\\dfrac{\\pi}{2}.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x) = \\dfrac{a_0}{2} + \\sum_{n=1}^{\\infty} a_n\\cos\\bigg(\\dfrac{n\\pi}{L}x\\bigg)+b_n\\sin\\bigg(\\dfrac{n\\pi}{L}x\\bigg).\n$$\n\nThen, the series converges for all $x \\in \\mathbb{R}.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x) = f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x) = \\dfrac{f^-(x)+f^+(x)}{2}\n$$\n\nwhere $f^-(x)$ and $f^-(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $\\pi$-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=\\dfrac{\\pi}{2}.$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}(\\frac{\\pi }{2}) & ={lim}_{x\\to {(\\pi /2)}^{-}}f(x)=2 \\\\ {f}^{+}(\\frac{\\pi }{2}) & ={lim}_{x\\to {(\\pi /2)}^{+}}f(x)=-1\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\dfrac{f^-\\left(\\dfrac{\\pi}{2}\\right)+f^+\\left(\\dfrac{\\pi}{2}\\right)}{2} = \\dfrac{2+(-1)}{2} = \\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{1}{2}}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21866"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070509/assets/1da7fe97b22b7a72b4253abfb180ce5f294fa945450879d8cb857ee1470edbf3.png)\nConsider the function $F(x)$ shown above. The Fourier series of the $2\\pi$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x) \\sim \\sum_{n=1}^\\infty \\dfrac{4}{\\pi(2n-1)} \\sin((2n-1)x).\n$$\n\nUse this Fourier series to find the sum of the series\n\n$$\n\\sum_{n=1}^\\infty \\dfrac{(-1)^{n+1}}{2n-1}.\n$$" :question/worked-solution "First, we notice that at $x=\\dfrac{\\pi}{2},$ we have\n\n$$\n\\sin\\left((2n-1)\\cdot\\dfrac{\\pi}{2}\\right) = \\sin\\left(-\\dfrac{\\pi}{2}+n\\pi\\right) = (-1)^{n+1}.\n$$\n\nSo, substituting $x=\\dfrac{\\pi}{2}$ into the given Fourier series gives\n\n$$\nf\\left(\\dfrac{\\pi}{2}\\right) \\sim \\sum_{n=1}^\\infty \\dfrac{4}{\\pi(2n-1)} \\sin\\left((2n-1)\\cdot\\dfrac{\\pi}{2}\\right)\n= \\sum_{n=1}^\\infty \\dfrac{4}{\\pi(2n-1)}(-1)^{n+1}.\n$$\n\nNext, since $f(x)$ is continuous at $x=\\dfrac{\\pi}{2},$ the Fourier series converges to $f\\left(\\dfrac{\\pi}{2}\\right).$\n\nSince $\\dfrac{\\pi}{2} \\in [0,\\pi),$ we have\n\n$$\nf\\left(\\dfrac{\\pi}{2}\\right) = 1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}1 & ={\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (2n-1)}(-1)^{n+1} \\\\ \\frac{\\pi }{4} & ={\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\sum_{n=1}^\\infty \\dfrac{(-1)^{n+1}}{2n-1} = \\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{\\pi}{4}}.\n$$" :db/ensure [:question/validate]}]
