5710c0fb34b50ac855d8d5af09e7a6a44a50dd853"} {"question" "q-343445" "field" "field-4" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "reference/mathacademy/question-capture-workers/differential/14070509/state.json" "file_sha256" "8911c50d090842de3ae01755710c0fb34b50ac855d8d5af09e7a6a44a50dd853"} {"question" "q-343445" "field" "field-4" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\pi }{2}"] ["math" "\\frac{\\pi }{4}"] ["math" "\\frac{{\\pi }^{2}}{4}"] ["math" "\\frac{{\\pi }^{2}}{8}"]] "category" "ma_complete_choices" "file" "reference/mathacademy/question-capture-workers/differential/14070509/state.json" "file_sha256" "8911c50d090842de3ae01755710c0fb34b50ac855d8d5af09e7a6a44a50dd853"} {"question" "q-343445" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\pi }{4}"] "category" "model_interpretation" "file" "reference/mathacademy/question-capture-workers/differential/14070509/state.json" "file_sha256" "8911c50d090842de3ae01755710c0fb34b50ac855d8d5af09e7a6a44a50dd853"} {"question" "q-343421" "field" nil "attribute" "question/problem" "value" "Consider the function $F(x)=|\\operatorname{sin}⁡(\\frac{x}{2})|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{2}{\\pi }-{\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (4{n}^{2}-1)}\\operatorname{cos}⁡(nx).\n$$\n\nSelect the correct options in the reasoning below.At $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}={{field-4}}.\n$$" "category" "ma_capture" "file" "reference/mathacademy/question-capture-workers/differential/14070509/state.json" "file_sha256" "8911c50d090842de3ae01755710c0fb34b50ac855d8d5af09e7a6a44a50dd853"} {"question" "q-343421" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(nx).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡(n\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=|\\operatorname{sin}⁡(\\frac{0}{2})|=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot \\operatorname{cos}⁡(n\\cdot 0) \\\\ 0 & =\\frac{2}{\\pi }-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1}\\cdot 1 \\\\ -\\frac{2}{\\pi } & =-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{1}{4{n}^{2}-1} & =\\frac{1}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "reference/mathacademy/question-capture-workers/differential/14070509/state.json" "file_sha256" "8911c50d090842de3ae01755710c0fb34b50ac855d8d5af09e7a6a44a50dd853"} {"question" "q-343421" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "reference/mathacademy/question-capture-workers/differential/14070509/activity-metadata.json" "file_sha256" "9c27f888db73e9218f13f2a0fd95417ea6166039b0f201dbe1e72e822dea2850"} {"question" "q-343421" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "reference/mathacademy/question-capture-workers/differential/14070509/state.json" "file_sha256" "8911c50d090842de3ae01755710c0fb34b50ac855d8d5af09e7a6a44a50dd853"} {"question" "q-343421" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "(-1)^{n+1}"] ["math" "(-1)^{n}"] ["math" "0"] ["math" "1"]] "category" "ma_complete_choices" "file" "reference/mathacademy/question-capture-