}(\\operatorname{sin}⁡(7x+x)+\\operatorname{sin}⁡(7x-x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(8x)+\\operatorname{sin}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\pi /4}\\operatorname{sin}⁡(7x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{0}^{3\\pi /4}\\frac{1}{2}\\operatorname{sin}⁡(8x)+\\frac{1}{2}\\operatorname{sin}⁡(6x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{16}\\operatorname{cos}⁡(8x)-\\frac{1}{12}\\operatorname{cos}⁡(6x)]}_{0}^{3\\pi /4} \\\\  & =-\\frac{1}{16}(\\operatorname{cos}⁡(6\\pi )-\\operatorname{cos}⁡(0))-\\frac{1}{12}(\\operatorname{cos}⁡(\\frac{9\\pi }{2})-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{16}(1-1)-\\frac{1}{12}(0-1) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041565/state.json" "file_sha256" "b422e6c25d857cba3f1563e24159525c37b401d48daf938c44580c831d11c2db"} {"question" "q-340492" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041565/activity-metadata.json" "file_sha256" "842a4ec8e97ef573d7221338d86e9678c6c0e6579f5198d2c1d23a3f341a37d7"} {"question" "q-340492" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041565/state.json" "file_sha256" "b422e6c25d857cba3f1563e24159525c37b401d48daf938c44580c831d11c2db"} {"question" "q-340492" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{12}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041565/state.json" "file_sha256" "b422e6c25d857cba3f1563