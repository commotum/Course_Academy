me{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(11x)\\operatorname{cos}⁡(5x) & =\\frac{1}{2}(\\operatorname{cos}⁡(11x-5x)+\\operatorname{cos}⁡(11x+5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(6x)+\\operatorname{cos}⁡(16x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{cos}⁡(11x)\\operatorname{cos}⁡(5x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(6x)+\\frac{1}{2}\\operatorname{cos}⁡(16x)\\,\\text{d}x \\\\  & =\\frac{1}{12}\\operatorname{sin}⁡(6x)+\\frac{1}{32}\\operatorname{sin}⁡(16x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186312703 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3cb2fcb-3457-5a89-8968-6c0f2c2cfa83" :knowledge-point/title "Integrating a Product of Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "39796a71-7437-5c27-a726-e9b09342737b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{38}\\operatorname{sin}⁡(19x)+C" :db/id #edb/ref 17592186312705} {:answer/id #uuid "43f213e4-d8c8-5d3d-b900-43c63d63e6e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{sin}⁡(5x)+\\frac{1}{19}\\operatorname{sin}⁡(19x)+C" :db/id #edb/ref 17592186312706} {:answer/id #uuid "154bce7a-7bf3-545b-ae5c-d3426cfcddbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{10}\\operatorname{cos}⁡(5x)-\\frac{1}{38}\\operatorname{cos}⁡(19x)+C" :db/id #edb/ref 17592186312707} {:answer/id #uuid "c1d99ab6-8118-5c0b-9179-b783818e9107" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{sin}⁡(5x)+\\frac{1}{12}\\operatorname{sin}⁡(12x)+C" :db/id #edb/ref 17592186312708} {:answer/id #uuid "29ca6cad-0b9a-5d5d-923f-b930f8206149" :a