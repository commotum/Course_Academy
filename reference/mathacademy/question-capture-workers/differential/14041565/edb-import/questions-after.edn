in}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(9x)\\operatorname{sin}⁡(2x) & =\\frac{1}{2}(\\operatorname{cos}⁡(9x-2x)-\\operatorname{cos}⁡(9x+2x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(7x)-\\operatorname{cos}⁡(11x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(9x)\\operatorname{sin}⁡(2x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(7x)-\\frac{1}{2}\\operatorname{cos}⁡(11x)\\,\\text{d}x \\\\  & =\\frac{1}{14}\\operatorname{sin}⁡(7x)-\\frac{1}{22}\\operatorname{sin}⁡(11x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186312731 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3cb2fcb-3457-5a89-8968-6c0f2c2cfa83" :knowledge-point/title "Integrating a Product of Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c81d56e5-0350-5377-afba-2325b9e2fac8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{15}" :db/id #edb/ref 17592186312733} {:answer/id #uuid "352ca981-1a0f-5ad3-a45c-0f1f1e1d7ce8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{15}" :db/id #edb/ref 17592186312734}] :answer-field/correct {:answer/id #uuid "c81d56e5-0350-5377-afba-2325b9e2fac8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{15}" :db/id #edb/ref 17592186312733} :answer-field/id #uuid "dd5b1d4b-f203-5eff-8281-f6a7d2901745" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186312732}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8e0ba3f4-6529-5624-ad59-b0145e98c9e4" :question/math-academy-id "q-340471" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡(x)\\operatorname{cos}⁡(4x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(x)\\operatorname{cos}⁡(4x) & =\\frac{1}{2}(\\operatorname{cos}⁡(x-4x)+\\operatorname{cos}⁡(x+4x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(-3x)+\\operatorname{cos}⁡(5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(3x)+\\operatorname{cos}⁡(5x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡(x)\\operatorname{cos}⁡(4x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(3x)+\\frac{1}{2}\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)+\\frac{1}{10}\\operatorname{sin}⁡(5x)]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0))+\\frac{1}{10}(\\operatorname{sin}⁡(\\frac{5\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{6}(-1-0)+\\frac{1}{10}(1-0) \\\\  & =-\\frac{1}{15}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186312735 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce" :knowledge-point/title "Integrating a Product of Sines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20906915-892d-5346-9c77-c0c024138f5b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{21}" :db/id #edb/ref 17592186312737}] :answer-field/correct {:answer/id #uuid "20906915-892d-5346-9c77-c0c024138f5b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{21}" :db/id #edb/ref 17592186312737} :answer-field/id #uuid "1c247532-80c0-5f7b-b809-80edc671f682" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186312736}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "09f8ecde-26ba-561b-a4dd-4c9b53298669" :question/math-academy-id "q-340472" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\operatorname{sin}⁡(5x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x)\\operatorname{sin}⁡(5x) & =\\frac{1}{2}(\\operatorname{cos}⁡(2x-5x)-\\operatorname{cos}⁡(2x+5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(-3x)-\\operatorname{cos}⁡(7x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(3x)-\\operatorname{cos}⁡(7x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\operatorname{sin}⁡(5x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(3x)-\\frac{1}{2}\\operatorname{cos}⁡(7x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)-\\frac{1}{14}\\operatorname{sin}⁡(7x)]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0))-\\frac{1}{14}(\\operatorname{sin}⁡(\\frac{7\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{6}(-1-0)-\\frac{1}{14}(-1-0) \\\\  & =-\\frac{2}{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186312738 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce" :knowledge-point/title "Integrating a Product of Sines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd2701b2-0251-53dd-b393-c479818feb86" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{20}" :db/id #edb/ref 17592186312740}] :answer-field/correct {:answer/id #uuid "fd2701b2-0251-53dd-b393-c479818feb86" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{20}" :db/id #edb/ref 17592186312740} :answer-field/id #uuid "c9e2b4f9-6257-59dc-b0a2-74818df9ecbf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186312739}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b5544c7c-d4d3-583d-a4bf-b5627cabeed4" :question/math-academy-id "q-340474" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(3x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(3x) & =\\frac{1}{2}(\\operatorname{cos}⁡(7x-3x)-\\operatorname{cos}⁡(7x+3x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(4x)-\\operatorname{cos}⁡(10x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\operatorname{sin}⁡(7x)\\operatorname{sin}⁡(3x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\frac{1}{2}\\operatorname{cos}⁡(4x)-\\frac{1}{2}\\operatorname{cos}⁡(10x)\\,\\text{d}x \\\\  & ={[\\frac{1}{8}\\operatorname{sin}⁡(4x)-\\frac{1}{20}\\operatorname{sin}⁡(10x)]}_{0}^{\\pi /4} \\\\  & =\\frac{1}{8}(\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(0))-\\frac{1}{20}(\\operatorname{sin}⁡(\\frac{5\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{8}(0-0)-\\frac{1}{20}(1-0) \\\\  & =-\\frac{1}{20}.\\end{aligned}\n$$"}] [{:db/id #