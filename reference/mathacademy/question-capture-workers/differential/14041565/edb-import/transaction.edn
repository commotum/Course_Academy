sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(13x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{sin}⁡(13x+x)+\\operatorname{sin}⁡(13x-x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(14x)+\\operatorname{sin}⁡(12x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(13x)\\operatorname{cos}⁡(x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{sin}⁡(14x)+\\frac{1}{2}\\operatorname{sin}⁡(12x)\\,\\text{d}x \\\\  & =-\\frac{1}{28}\\operatorname{cos}⁡(14x)-\\frac{1}{24}\\operatorname{cos}⁡(12x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340484/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d3b7f35-fcd1-5443-b0ea-0b06e016e0c3"] :knowledge-point/questions ["q-340484"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340487/field-1/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" :answer/id #uuid "95609534-6f10-504f-bbf3-e28ac5c61b47" :answer/type :answer.type/math :answer/value "-\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-340487/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "b430673b-3b70-58ba-8d7f-7497d1d25af4" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-340487/field-1" :answer-field/id #uuid "ba37d4ac-273e-50ce-85b6-b7a71cfa9479" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340487/field-1/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" :answer-field/choices ["q-340487/field-1/edc901e84f0cdd5174afd49105ac3883566ea0e1e057217fb66083a56cc119ba" "q-340487/field-1/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda"] :db/ensure [:answer-field/validate]} {:db/id "q-340487" :question/id #uuid "f97448ae-4c76-572e-8898-f4ded27886ae" :question/math-academy-id "q-340487" :question/problem "Evaluate the following integral.\n\n${\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡(7x)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(7x)\\operatorname{cos}⁡(3x) & =\\frac{1}{2}(\\operatorname{sin}⁡(7x+3x)+\\operatorname{sin}⁡(7x-3x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(10x)+\\operatorname{sin}⁡(4x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{sin}⁡(7x)\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{2}\\operatorname{sin}⁡(10x)+\\frac{1}{2}\\operatorname{sin}⁡(4x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{20}\\operatorname{cos}⁡(10x)-\\frac{1}{8}\\operatorname{cos}⁡(4x)]}_{\\pi /4}^{\\pi /2} \\\\  & =-\\frac{1}{20}(\\operatorname{cos}⁡(5\\pi )-\\operatorname{cos}⁡(\\frac{5\\pi }{2}))-\\frac{1}{8}(\\operatorname{cos}⁡(2\\pi )-\\operatorname{cos}⁡(\\pi )) \\\\  & =-\\frac{1}{20}(-1-0)-\\frac{1}{8}(1-(-1)) \\\\  & =-\\frac{1}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340487/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d3b7f35-fcd1-5443-b0ea-0b06e016e0c3"] :knowledge-point/questions ["q-340487"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340491/field-1/067f8394ee42d8135073fd0c196cd07b15b62bf00b668a6dd30a825b7176ad3f" :answer/id #uuid "2db3928d-20ea-53fd-936a-f78657b52158" :answer/type :answer.type/math :answer/value "-\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "q-340491/field-1" :answer-field/id #uuid "c7a9d597-8dc0-56bf-ac1e-fc99d062081b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340491/field-1/067f8394ee42d8135073fd0c196cd07b15b62bf00b668a6dd30a825b7176ad3f" :answer-field/choices ["q-340491/field-1/067f8394ee42d8135073fd0c196cd07b15b62bf00b668a6dd30a825b7176ad3f"] :db/ensure [:answer-field/validate]} {:db/id "q-340491" :question/id #uuid "937defff-0b54-5d84-8761-8f24a2d3bda2" :question/math-academy-id "q-340491" :question/problem "Evaluate the following integral.\n\n${\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{sin}⁡(9x+x)+\\operatorname{sin}⁡(9x-x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(10x)+\\operatorname{sin}⁡(8x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /2}^{\\pi }\\operatorname{sin}⁡(9x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{\\pi /2}^{\\pi }\\frac{1}{2}\\operatorname{sin}⁡(10x)+\\frac{1}{2}\\operatorname{sin}⁡(8x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{20}\\operatorname{cos}⁡(10x)-\\frac{1}{16}\\operatorname{cos}⁡(8x)]}_{\\pi /2}^{\\pi } \\\\  & =-\\frac{1}{20}(\\operatorname{cos}⁡(10\\pi )-\\operatorname{cos}⁡(5\\pi ))-\\frac{1}{16}(\\operatorname{cos}⁡(8\\pi )-\\operatorname{cos}⁡(4\\pi )) \\\\  & =-\\frac{1}{20}(1-(-1))-\\frac{1}{16}(1-1) \\\\  & =-\\frac{1}{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340491/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d3b7f35-fcd1-5443-b0ea-0b06e016e0c3"] :knowledge-point/questions ["q-340491"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-21823"] :question/problem "Evaluate the integral $\\displaystyle \\int_{\\pi/4}^{\\pi/2} \\cos(9x)\\cos(x)\\,\\text{d}x.$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )+\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(9x)\\operatorname{cos}⁡(x) & =\\frac{1}{2}(\\operatorname{cos}⁡(9x-x)+\\operatorname{cos}⁡(9x+x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(8x)+\\operatorname{cos}⁡(10x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{cos}⁡(9x)\\operatorname{cos}⁡(x)\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(8x)+\\frac{1}{2}\\operatorname{cos}⁡(10x)\\,\\text{d}x \\\\  & ={[\\frac{1}{16}\\operatorname{sin}⁡(8x)+\\frac{1}{20}\\operatorname{sin}⁡(10x)]}_{\\pi /4}^{\\pi /2} \\\\  & =\\frac{1}{16}(\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(2\\pi ))+\\frac{1}{20}(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(\\frac{5\\pi }{2})) \\\\  & =\\frac{1}{16}(0-0)+\\frac{1}{20}(0-1) \\\\  & =-\\frac{1}{20}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21824"] :question/problem "Evaluate the integral $\\displaystyle \\int \\sin(12x)\\sin(5x)\\,\\text{d}x .$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(12x)\\operatorname{sin}⁡(5x) & =\\frac{1}{2}(\\operatorname{cos}⁡(12x-5x)-\\operatorname{cos}⁡(12x+5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(7x)-\\operatorname{cos}⁡(17x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(12x)\\operatorname{sin}⁡(5x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(7x)-\\frac{1}{2}\\operatorname{cos}⁡(17x)\\,\\text{d}x \\\\  & =\\frac{1}{14}\\operatorname{sin}⁡(7x)-\\frac{1}{34}\\operatorname{sin}⁡(17x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21825"] :question/problem "Evaluate the integral $\\displaystyle \\int_{0}^{\\pi/2} \\sin(2x)\\cos(4x)\\,\\text{d}x.$" :question/worked-solution "First, let's recall the sum and difference formulas for sine:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡(\\alpha -\\beta ) & =\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{cos}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nAdding these equations, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{cos}⁡\\beta  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\alpha +\\beta )+\\operatorname{sin}⁡(\\alpha -\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(4x) & =\\frac{1}{2}(\\operatorname{sin}⁡(2x+4x)+\\operatorname{sin}⁡(2x-4x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(6x)+\\operatorname{sin}⁡(-2x)) \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(6x)-\\operatorname{sin}⁡(2x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\operatorname{cos}⁡(4x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{sin}⁡(6x)-\\frac{1}{2}\\operatorname{sin}⁡(2x)\\,\\text{d}x \\\\  & ={[-\\frac{1}{12}\\operatorname{cos}⁡(6x)+\\frac{1}{4}\\operatorname{cos}⁡(2x)]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{12}(\\operatorname{cos}⁡(3\\pi )-\\operatorname{cos}⁡(0))+\\frac{1}{4}(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{12}(-1-1)+\\frac{1}{4}(-1-1) \\\\  & =-\\frac{1}{3}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
