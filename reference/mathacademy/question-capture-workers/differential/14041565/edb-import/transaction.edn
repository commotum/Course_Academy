\\  & =\\frac{1}{10}\\operatorname{sin}⁡(5x)+\\frac{1}{42}\\operatorname{sin}⁡(21x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340457/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3cb2fcb-3457-5a89-8968-6c0f2c2cfa83"] :knowledge-point/questions ["q-340457"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340467/selection/0d39186ae1edc76796c9c4fdf7cb071e966da5a7e95af7a60ddf8991021ef78e" :answer/id #uuid "15ae7e32-874f-52b6-bbed-8118ff8b9834" :answer/type :answer.type/math :answer/value "\\frac{1}{14}\\operatorname{sin}⁡(7x)+\\frac{1}{34}\\operatorname{sin}⁡(17x)+C" :db/ensure [:answer/validate]} {:db/id "q-340467/selection/19544c2b6f005d31e6f4016c952b27e78f8336eb8c0c71377eb8e4fe72b21fea" :answer/id #uuid "df26fc10-c5b1-5c3b-ac1c-b098224e1dcd" :answer/type :answer.type/math :answer/value "\\frac{1}{14}\\operatorname{sin}⁡(7x)-\\frac{1}{34}\\operatorname{sin}⁡(17x)+C" :db/ensure [:answer/validate]} {:db/id "q-340467/selection/5d52b617e8a0351d29e83d062244f04145c6d54d887662503b12a2ca7b8955cf" :answer/id #uuid "94348d70-470f-5697-b975-cba2b6ce215a" :answer/type :answer.type/math :answer/value "\\frac{1}{14}\\operatorname{sin}⁡(17x)-\\frac{1}{34}\\operatorname{sin}⁡(7x)+C" :db/ensure [:answer/validate]} {:db/id "q-340467/selection/a3b997a08f9a135991449f81797ca50187cd3e1efdde7388447618a663b9e05b" :answer/id #uuid "4e2630da-d963-5afd-9ef2-db64607661ed" :answer/type :answer.type/math :answer/value "\\frac{1}{14}\\operatorname{cos}⁡(7x)-\\frac{1}{34}\\operatorname{cos}⁡(17x)+C" :db/ensure [:answer/validate]} {:db/id "q-340467/selection/ffb0892aadd42c4037bb773439fb79dc593430460884e115583fcc31745e62e8" :answer/id #uuid "9aff09b0-8c29-553c-8681-69907af41934" :answer/type :answer.type/math :answer/value "\\frac{1}{7}\\operatorname{sin}⁡(7x)-\\frac{1}{17}\\operatorname{sin}⁡(17x)+C" :db/ensure [:answer/validate]} {:db/id "q-340467/selection" :answer-field/id #uuid "d2848f03-d35a-5ac5-baac-dcdc8966fba9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-340467/selection/19544c2b6f005d31e6f4016c952b27e78f8336eb8c0c71377eb8e4fe72b21fea" :answer-field/choices ["q-340467/selection/0d39186ae1edc76796c9c4fdf7cb071e966da5a7e95af7a60ddf8991021ef78e" "q-340467/selection/19544c2b6f005d31e6f4016c952b27e78f8336eb8c0c71377eb8e4fe72b21fea" "q-340467/selection/5d52b617e8a0351d29e83d062244f04145c6d54d887662503b12a2ca7b8955cf" "q-340467/selection/a3b997a08f9a135991449f81797ca50187cd3e1efdde7388447618a663b9e05b" "q-340467/selection/ffb0892aadd42c4037bb773439fb79dc593430460884e115583fcc31745e62e8"] :db/ensure [:answer-field/validate]} {:db/id "q-340467" :question/id #uuid "0cd87067-a8bd-536b-ba64-51e9b9f09ff9" :question/math-academy-id "q-340467" :question/problem "$\\int \\operatorname{sin}⁡(12x)\\operatorname{sin}⁡(5x)\\,\\text{d}x=$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(12x)\\operatorname{sin}⁡(5x) & =\\frac{1}{2}(\\operatorname{cos}⁡(12x-5x)-\\operatorname{cos}⁡(12x+5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(7x)-\\operatorname{cos}⁡(17x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(12x)\\operatorname{sin}⁡(5x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(7x)-\\frac{1}{2}\\operatorname{cos}⁡(17x)\\,\\text{d}x \\\\  & =\\frac{1}{14}\\operatorname{sin}⁡(7x)-\\frac{1}{34}\\operatorname{sin}⁡(17x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce"] :knowledge-point/questions ["q-340467"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340472/field-1/a640fd970f856372f41cdfc4b4fd3aaa7c9c94bf875c8dedb1b2f6c82a3ad98f" :answer/id #uuid "20906915-892d-5346-9c77-c0c024138f5b" :answer/type :answer.type/math :answer/value "-\\frac{2}{21}" :db/ensure [:answer/validate]} {:db/id "q-340472/field-1" :answer-field/id #uuid "1c247532-80c0-5f7b-b809-80edc671f682" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-340472/field-1/a640fd970f856372f41cdfc4b4fd3aaa7c9c94bf875c8dedb1b2f6c82a3ad98f" :answer-field/choices ["q-340472/field-1/a640fd970f856372f41cdfc4b4fd3aaa7c9c94bf875c8dedb1b2f6c82a3ad98f"] :db/ensure [:answer-field/validate]} {:db/id "q-340472" :question/id #uuid "09f8ecde-26ba-561b-a4dd-4c9b53298669" :question/math-academy-id "q-340472" :question/problem "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\operatorname{sin}⁡(5x)\\,\\text{d}x=$ {{field-1}}" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(2x)\\operatorname{sin}⁡(5x) & =\\frac{1}{2}(\\operatorname{cos}⁡(2x-5x)-\\operatorname{cos}⁡(2x+5x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(-3x)-\\operatorname{cos}⁡(7x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(3x)-\\operatorname{cos}⁡(7x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2x)\\operatorname{sin}⁡(5x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(3x)-\\frac{1}{2}\\operatorname{cos}⁡(7x)\\,\\text{d}x \\\\  & ={[\\frac{1}{6}\\operatorname{sin}⁡(3x)-\\frac{1}{14}\\operatorname{sin}⁡(7x)]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{6}(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0))-\\frac{1}{14}(\\operatorname{sin}⁡(\\frac{7\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{6}(-1-0)-\\frac{1}{14}(-1-0) \\\\  & =-\\frac{2}{21}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340472/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce"] :knowledge-point/questions ["q-340472"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-340384"] :question/problem "$\\int \\operatorname{sin}⁡(5x)\\operatorname{sin}⁡(x)\\,\\text{d}x=$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(5x)\\operatorname{sin}⁡(x) & =\\frac{1}{2}(\\operatorname{cos}⁡(5x-x)-\\operatorname{cos}⁡(5x+x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(4x)-\\operatorname{cos}⁡(6x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(5x)\\operatorname{sin}⁡(x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(4x)-\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & =\\frac{1}{8}\\operatorname{sin}⁡(4x)-\\frac{1}{12}\\operatorname{sin}⁡(6x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-340468/selection/741ceb52a8c6a9fb1c2d8b37215e455ccb360576a37e316c81749ebc4a21bb5c" :answer/id #uuid "03a79538-63b2-56d3-a4ba-31b0bf9cd2ef" :answer/type :answer.type/math :answer/value "\\frac{1}{7}\\operatorname{sin}⁡(7x)-\\frac{1}{11}\\operatorname{sin}⁡(11x)+C" :db/ensure [:answer/validate]} {:db/id "q-340468/selection/0ddecb5dc2c2d1a7c96ec5b707d50d4b492e553e2bfe8c4affdc576dcd0f44de" :answer/id #uuid "08d3331f-15ca-56f9-97c7-91713eda5a8f" :answer/type :answer.type/math :answer/value "\\frac{1}{14}