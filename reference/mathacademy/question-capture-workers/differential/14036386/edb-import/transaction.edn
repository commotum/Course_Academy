frac{\\text{d}}{\\text{d}x}(2{e}^{2x})+3\\cdot (2{e}^{2x})-2{e}^{2x} \\\\  & =4{e}^{2x}+6{e}^{2x}-2{e}^{2x} \\\\  & =8{e}^{2x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337830/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec3823db-6df8-502a-a050-b5aa169d2e9d"] :knowledge-point/questions ["q-337830"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337835/selection/731a950784702c8a98b50d3b92fc94af978975c58f94414b363df498cf31beda" :answer/id #uuid "9c1a547d-aa5c-5b41-b636-0ba239e82476" :answer/type :answer.type/math :answer/value "{x}^{3}-9{x}^{2}+6x" :db/ensure [:answer/validate]} {:db/id "q-337835/selection/fd9abc7d94b49bd603ff239182cd3b7f56ccc259aaf37f63ea535ab5fc738324" :answer/id #uuid "017c802e-3cd3-5b1a-8aa1-b9d338250c6f" :answer/type :answer.type/math :answer/value "4{x}^{3}-9{x}^{2}-6x" :db/ensure [:answer/validate]} {:db/id "q-337835/selection/3e77ed1c7fb4d3fcc2e423cde800af9f08287bee77c9d2ec3d4eda5e7520f4a6" :answer/id #uuid "8563bc4b-2ab8-5fc1-8162-fdb0f1bf1666" :answer/type :answer.type/math :answer/value "6x-9{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-337835/selection/3595ca00d0ed1cd4247b3982b5df03f75a58d833161c6c03f2665f501be62d78" :answer/id #uuid "3d6f7a39-32da-5684-ab63-42651a0b5717" :answer/type :answer.type/math :answer/value "4{x}^{3}+9{x}^{2}+6x" :db/ensure [:answer/validate]} {:db/id "q-337835/selection/cd3d3b9e38f1e22b51e5bceced0665aa9a64f00ddbee1ec59b19bc0f06a6d04f" :answer/id #uuid "91d39ed7-6c0e-55f7-a851-414d323affca" :answer/type :answer.type/math :answer/value "4{x}^{3}-9{x}^{2}+6x" :db/ensure [:answer/validate]} {:db/id "q-337835/selection" :answer-field/id #uuid "4054844e-d875-5394-9109-c9938be5f883" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-337835/selection/cd3d3b9e38f1e22b51e5bceced0665aa9a64f00ddbee1ec59b19bc0f06a6d04f" :answer-field/choices ["q-337835/selection/731a950784702c8a98b50d3b92fc94af978975c58f94414b363df498cf31beda" "q-337835/selection/fd9abc7d94b49bd603ff239182cd3b7f56ccc259aaf37f63ea535ab5fc738324" "q-337835/selection/3e77ed1c7fb4d3fcc2e423cde800af9f08287bee77c9d2ec3d4eda5e7520f4a6" "q-337835/selection/3595ca00d0ed1cd4247b3982b5df03f75a58d833161c6c03f2665f501be62d78" "q-337835/selection/cd3d3b9e38f1e22b51e5bceced0665aa9a64f00ddbee1ec59b19bc0f06a6d04f"] :db/ensure [:answer-field/validate]} {:db/id "q-337835" :question/id #uuid "56348ca5-95a9-5367-bd7f-5d20654a2a14" :question/math-academy-id "q-337835" :question/problem "Given that $D=\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}-3\\frac{\\text{d}}{\\text{d}x}+4,$ what is $D(y)$ for $y={x}^{3}?$" :question/worked-solution "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={a}_{2}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{a}_{1}\\frac{\\text{d}y}{\\text{d}x}+{a}_{0}y\n$$\n\nwith constant coefficients  ${a}_{2}=1,{a}_{1}=-3,$ and ${a}_{0}=4.$ \n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y:$\n\n$$\n\\begin{aligned}D(y) & =D({x}^{3}) \\\\  & =(\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}-3\\frac{\\text{d}}{\\text{d}x}+4){x}^{3} \\\\  & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}({x}^{3})-3\\frac{\\text{d}}{\\text{d}x}({x}^{3})+4\\cdot {x}^{3} \\\\  & =\\frac{\\text{d}}{\\text{d}x}(3{x}^{2})-3\\cdot (3{x}^{2})+4{x}^{3} \\\\  & =6x-9{x}^{2}+4{x}^{3} \\\\  & =4{x}^{3}-9{x}^{2}+6x\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337835/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ec3823db-6df8-502a-a050-b5aa169d2e9d"] :knowledge-point/questions ["q-337835"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65055/selection/d6037a37986356e74d76b1ebbc4f62b6bd47d9229ec35d91d3d99aa4247acc0c" :answer/id #uuid "34b84bfb-baaf-50dc-823f-874c9988d8a2" :answer/type :answer.type/math :answer/value "12{e}^{-2x}" :db/ensure [:answer/validate]} {:db/id "q-65055/