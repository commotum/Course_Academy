}⁡x \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\operatorname{cos}⁡x)-x\\operatorname{sin}⁡x\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x \\\\  & =\\operatorname{sin}⁡x(2-(x+1)\\operatorname{cos}⁡x)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-338253" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/activity-metadata.json" "file_sha256" "6477498f472159f5747d570aac6faa791ca10b4dbb98a45ae4f566f3ce2a9d48"} {"question" "q-338253" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-338253" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{sin}⁡x"] ["math" "\\operatorname{sin}⁡x(-2+(x+1)\\operatorname{cos}⁡x)"] ["math" "\\operatorname{sin}⁡x(2+(x+1)\\operatorname{cos}⁡x)"] ["math" "\\operatorname{sin}⁡x(2-(x+1)\\operatorname{cos}⁡x)"] ["math" "\\operatorname{sin}⁡x(2-(x-1)\\operatorname{cos}⁡x)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-338253" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\operatorname{sin}⁡x(2-(x+1)\\operatorname{cos}⁡x)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337559" "field" nil "attribute" "question/problem" "value" "If $D(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-xy\\frac{\\text{d}y}{\\text{d}x}+2{y}^{2},$ then $D({e}^{2x})=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337559" "field" nil "attribute" "question/worked-solution" "value" "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={f}_{2}(x,y)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x,y)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x,y)y\n$$\n\nwith ${f}_{2}=y,{f}_{1}=-xy,$ and ${f}_{0}=2y.$\n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y={e}^{2x}:$\n\n$$\n\\begin{aligned}D({e}^{2x}) & ={e}^{2x}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}({e}^{2x})-x({e}^{2x})\\frac{\\text{d}}{\\text{d}x}({e}^{2x})+2({e}^{2x})^{2} \\\\  & ={e}^{2x}\\frac{\\text{d}}{\\text{d}x}(2{e}^{2x})-x{e}^{2x}\\cdot 2{e}^{2x}+2{e}^{4x} \\\\  & ={e}^{2x}\\cdot 4{e}^{2x}-2x{e}^{4x}+2{e}^{4x} \\\\  & =4{e}^{4x}-2x{e}^{4x}+2{e}^{4x} \\\\  & =6{e}^{4x}-2x{e}^{4x} \\\\  & =2{e}^{4x}(3-x)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337559" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/activity-metadata.json" "file_sha256" "6477498f472159f5747d570aac6faa791ca10b4dbb98a45ae4f566f3ce2a9d4