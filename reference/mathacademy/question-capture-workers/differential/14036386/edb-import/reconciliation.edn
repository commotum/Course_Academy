\text{d}}^{3}}{\\text{d}{x}^{3}}-3\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+4\\frac{\\text{d}}{\\text{d}x})(\\operatorname{sin}⁡x) \\\\  & =\\frac{{\\text{d}}^{3}}{\\text{d}{x}^{3}}(\\operatorname{sin}⁡x)-3\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(\\operatorname{sin}⁡x)+4\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sin}⁡x) \\\\  & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(\\operatorname{cos}⁡x)-3\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cos}⁡x)+4(\\operatorname{cos}⁡x) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(-\\operatorname{sin}⁡x)-3(-\\operatorname{sin}⁡x)+4\\operatorname{cos}⁡x \\\\  & =-\\operatorname{cos}⁡x+3\\operatorname{sin}⁡x+4\\operatorname{cos}⁡x \\\\  & =3\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-91043" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/activity-metadata.json" "file_sha256" "6477498f472159f5747d570aac6faa791ca10b4dbb98a45ae4f566f3ce2a9d48"} {"question" "q-91043" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-91043" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-6\\operatorname{sin}⁡x"] ["math" "2\\operatorname{sin}⁡x-2\\operatorname{cos}⁡x"] ["math" "3\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x"] ["math" "4\\operatorname{cos}⁡x"] ["math" "\\operatorname{cos}⁡x-\\operatorname{sin}⁡x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-91043" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\operatorname{sin}⁡x+3\\operatorname{cos}⁡x"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337830" "field" nil "attribute" "question/problem" "value" "Given that $D=\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+3\\frac{\\text{d}}{\\text{d}x}-2,$ what is $D(y)$ for $y={e}^{2x}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337830" "field" nil "attribute" "question/worked-solution" "value" "The given operator is a second-order differential operator of the form\n\n$$\nD(y)={a}_{2}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{a}_{1}\\frac{\\text{d}y}{\\text{d}x}+{a}_{0}y\n$$\n\nwith constant coefficients  ${a}_{2}=1,{a}_{1}=3,$ and ${a}_{0}=-2.$ \n\nTo compute $D(y),$ we apply the definition of the operator $D$ to the function $y:$\n\n$$\n\\begin{aligned}D(y) & =D({e}^{2x}) \\\\  & =(\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}+3\\frac{\\text{d}}{\\text{d}x}-2){e}^{2x} \\\\  & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}({e}^{2x})+3\\frac{\\text{d}}{\\text{d}x}({e}^{2x})-2\\cdot {e}^{2x} \\\\  & =\\frac{\\text{d}}{\\text{d}x}(2{e}^{2x})+3\\cdot (2{e}^{2x})-2{e}^{2x} \\\\  & =4{e}^{2x}+6{e}^{2x}-2{e}^{2x} \\\\  & =8{e}^{2x}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337830" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/activity-metadata.json" "file_sha256" "6477498f472159f5747d570aac6faa791ca10b4dbb98a45ae4f566f3ce2a9d48"} {"question" "q-337830" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337830" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-8{e}^{2x}"] ["math" "0"] ["math" "10{e}^{2x}"] ["math" "6{e}^{2x}"] ["math" "8{e}^{2x}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337830" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8{e}^{2x}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7ba3ec2d7f367dbb3a"} {"question" "q-337835" "field" nil "attribute" "question/problem" "value" "Given that $D=\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}-3\\frac{\\text{d}}{\\text{d}x}+4,$ what is $D(y)$ for $y={x}^{3}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036386/state.json" "file_sha256" "446c24c9b2761f4e6db752c185f73e628109b555dcbadb7b