#{[{:db/id #edb/ref 17592186306064 :knowledge-point/_questions [{:knowledge-point/id #uuid "a363f215-ed40-504a-bcae-620b7d585678" :knowledge-point/title "Finding Points of Inflection Using Differentiation When Some Points Must Be Discarded"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d95b1835-d1ea-5052-bef1-441518bc6883" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186306066} {:answer/id #uuid "1c08b0ac-5955-5700-8bf2-c879f2200913" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186306067} {:answer/id #uuid "a252231e-cfa1-5bea-8219-390f4b756b2b" :answer/type {:db/ident :answer.type/math} :answer/value "x=0" :db/id #edb/ref 17592186306068} {:answer/id #uuid "57599abf-0cb2-5d02-9350-ef70e4d42ff2" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of inflection" :db/id #edb/ref 17592186306069} {:answer/id #uuid "9cf3001a-c60d-550a-a637-820b1ba811a0" :answer/type {:db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186306070}] :answer-field/correct {:answer/id #uuid "57599abf-0cb2-5d02-9350-ef70e4d42ff2" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of inflection" :db/id #edb/ref 17592186306069} :answer-field/id #uuid "398896fc-e61f-58b1-9a4a-7cc22e7db73b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306065}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "013aa5fa-d294-56b4-a075-76d80070e739" :question/math-academy-id "q-2464" :question/problem "Find the $x$-coordinate of the point of inflection for $f(x)=2{x}^{2}+4x+4.$" :question/worked-solution "For continuous, twice-differentiable functions, we can determine possible points of inflection by solving the equation ${f}^{″}(x)=0.$ However, we must be sure to check that the concavity does indeed change at whatever points we find.\n\nFirst, we calculate the second derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =4x+4 \\\\ {f}^{″}(x) & =4\\end{aligned}\n$$\n\nThe equation ${f}^{″}(x)=0$ has no real solutions, and so there are no points of inflection."}]}
