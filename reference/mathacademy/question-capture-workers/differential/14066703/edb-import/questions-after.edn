order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(8{e}^{-t})^{′} \\\\ (7{e}^{t})^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}-8{e}^{-t} \\\\ 7{e}^{t}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353319 :knowledge-point/_questions [{:knowledge-point/id #uuid "318f129c-066d-50bd-934a-90722ba4fc93" :knowledge-point/title "Finding the Image of a Vector Under a Matrix Given Solutions to a Matrix ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d21da6f-baa0-5a9c-8d15-bbe8a2b5eb60" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-10{e}^{5t} \\\\ 21{e}^{3t}\\end{aligned}]" :db/id #edb/ref 17592186353321} {:answer/id #uuid "acfc6821-07d2-54ab-952c-25ade8d10905" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-6{e}^{3t} \\\\ 35{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186353322} {:answer/id #uuid "787b0169-ea56-50ed-acee-5b96108ef149" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-2{e}^{3t} \\\\ 7{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186353323} {:answer/id #uuid "0f545d23-d2bd-5ce3-99e6-6d37382f3253" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-10{e}^{3t} \\\\ 21{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186353324} {:answer/id #uuid "72a6e986-58c9-54f8-bff5-3b2cc3b087c9" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-6{e}^{5t} \\\\ 35{e}^{3t}\\end{aligned}]" :db/id #edb/ref 17592186353325}] :answer-field/correct {:answer/id #uuid "acfc6821-07d2-54ab-952c-25ade8d10905" :answer/type {:db/ident :answer.type/math} :answer/value "Aw=[\\begin{aligned}-6{e}^{3t} \\\\ 35{e}^{5t}\\end{aligned}]" :db/id #edb/ref 17592186353322} :answer-field/id #uuid "67201bfa-8437-510e-879a-e4b66ab2eeba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/re