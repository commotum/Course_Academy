    {
      "question": "e-21110",
      "field": null,
      "attribute": "question/problem",
      "old_sha256": "a7af88d685010e01ffd027a14d5758a5326f856e87e71a9b906fb8e8951c715c",
      "new_sha256": "e24aa3e2f6cb43cb7314dad7ab94c42cfd94812bd51862f94edf9b16c39f6a2d",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-21110",
          "field": null,
          "attribute": "question/problem",
          "value": "Suppose $\\mathbf{x}_1(t)$ and $\\mathbf{x}_2(t)$ are both solutions of the homogeneous system\n$\\mathbf{x}'(t) = A \\ \\mathbf{x}(t).$\nWhich of the following is **always** a solution of the same system?\n\n- $\\mathbf{x}(t) = 6 \\cdot \\mathbf{x}_1(t) - \\mathbf{x}_2(t)$\n\n- $\\mathbf{x}(t) = -3 \\cdot \\mathbf{x}_1(t) + 4 \\cdot \\mathbf{x}_2(t)$\n\n- $\\mathbf{x}(t) = (1+t^2)\\cdot \\mathbf{x}_1(t) + e^{t}\\cdot \\mathbf{x}_2(t)$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066703/example-21110.json",
          "file_sha256": "e1862497f5f8f3265314df44fa75c1b3fee9f73fcc42d47710de5270b3d80b06"
        }
      ],
      "basis": 2204,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066703/edb-import/commit.edn",
      "basis_after": 2205
