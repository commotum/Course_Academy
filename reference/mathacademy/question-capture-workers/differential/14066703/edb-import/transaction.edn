a-v1/f8a26110263278293c9e5ae5d44ed2df7f788b5181153ad3819684d601d34218/f87650942f715e11bbf0eea28188efe73135b8daf2b5110f1e5245595eda23eb" "q-168100/selection/ma-v1/f8a26110263278293c9e5ae5d44ed2df7f788b5181153ad3819684d601d34218/cf8078f2fd587ffe1011d1e3c79bb611b731970c0751fd4342ad4110241a5a06" "q-168100/selection/ma-v1/f8a26110263278293c9e5ae5d44ed2df7f788b5181153ad3819684d601d34218/94917f3c7a16c682f0370eb421705aff14a9683595f8ca46e23da05df44c98a1" "q-168100/selection/ma-v1/f8a26110263278293c9e5ae5d44ed2df7f788b5181153ad3819684d601d34218/ead3757e6e8659a1aa7a0bc5aa16aa946db139c985c7253a699806e7561f787c" "q-168100/selection/ma-v1/f8a26110263278293c9e5ae5d44ed2df7f788b5181153ad3819684d601d34218/21672f6f902fa553e66b01d8477e30f257b5728e647aec9d9e757e9a9ff39188"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-168100"] :question/problem "If\n$u(t)=[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]$\nand\n$v(t)=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ -\\operatorname{sin}⁡t\\end{aligned}]$\nare solutions to ${x}^{′}(t)=Ax(t),$ find $Aw(t)$ where\n$w(t)=[\\begin{aligned}\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ \\operatorname{cos}⁡t+\\operatorname{sin}⁡t\\end{aligned}].$" :question/worked-solution "Since $u(t)$ and $v(t)$ are solutions to ${x}^{′}(t)=Ax(t),$ the superposition principle guarantees that \n\n$$\ncu(t)+dv(t)\n$$\n\n is also a solution to ${x}^{′}(t)=Ax(t)$ for all $c,d\\in R.$\n\nNotice that\n\n$$\nw(t)=u(t)-v(t).\n$$\n\n \n\nTherefore, $w$ is a solution to ${x}^{′}(t)=Ax(t).$ So, in order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)^{′} \\\\ (\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ -\\operatorname{sin}⁡t+\\operatorname{cos}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-168100/selection/ma-v1/f8a26110263278293c9e5ae5d44ed2df7f788b5181153ad3819684d601d34218"] :db/ensure [:question/validate]} {:db/id "q-39726/selection/279bd06523d466817fd7df2c8c10bbee059d3eaff4eb9287a40022187db4e296" :answer/id #uuid "2484cd86-5eea-5ae3-92b1-ce843e049eb0" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}-2{e}^{-t} \\\\ -{e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39726/selection/ee80a9bcc3ce2e01584af1e38922bb4cef83e084fc083837565038fee7aaeaab" :answer/id #uuid "1ee3f2c3-efbe-5f8e-a1f9-20441e148f33" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}-{e}^{-t} \\\\ -2{e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39726/selection/5be4c362c1a4e2e2ff081c2db51687e9ad9dd286d81a5000c444f35d22878523" :answer/id #uuid "eae769c4-b816-5ce6-aa39-5642f6eb2c09" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}{e}^{t} \\\\ -2{e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39726/selection/5c04d016723e794dbd27a2afc01c461e5351783359131a4ad68ed9373f5ad2d1" :answer/id #uuid "597dc9f1-d269-5e9c-8825-1be9e1dc610d" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}2{e}^{-t} \\\\ {e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39726/selection/585f3aec6ba7f4eb562dc678b8a1ad15653aee6651b5c45add900ce6c7488093" :answer/id #uuid "6db395aa-a393-5a34-a962-b945c05d6d2f" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}2{e}^{-t} \\\\ -{e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39726/selection" :answer-field/id #uuid "0a5d6ee4-0bb6-503c-b92d-610e4e446b41" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39726/selection/585f3aec6ba7f4eb562dc678b8a1ad15653aee6651b5c45add900ce6c7488093" :answer-field/choices ["q-39726/selection/279bd06523d466817fd7df2c8c10bbee059d3eaff4eb9287a40022187db4e296" "q-39726/selection/ee80a9bcc3ce2e01584af1e38922bb4cef83e084fc083837565038fee7aaeaab" "q-39726/selection/5be4c362c1a4e2e2ff081c2db51687e9ad9dd286d81a5000c444f35d22878523" "q-39726/selection/5c04d016723e794dbd27a2afc01c461e5351783359131a4ad68ed9373f5ad2d1" "q-39726/selection/585f3aec6ba7f4eb562dc678b8a1ad15653aee6651b5c45add900ce6c7488093"] :db/ensure [:answer-field/validate]} {:db/id "q-39726" :question/id #uuid "c904dbc3-34a9-5c4f-87ab-adf9b54f3ee2" :question/math-academy-id "q-39726" :question/problem "If $\\,u(t)=[\\begin{aligned}{e}^{-t} \\\\ 0\\end{aligned}]\\,$ and $\\,v(t)=[\\begin{aligned}0 \\\\ {e}^{t}\\end{aligned}]\\,$ are solutions to ${x}^{′}(t)=Ax(t)$, find $Aw(t)$ where $w(t)=[\\begin{aligned}-2{e}^{-t} \\\\ -{e}^{t}\\end{aligned}].$" :question/worked-solution "Since $u(t)$ and $v(t)$ are solutions to ${x}^{′}(t)=Ax(t),$ the superposition principle guarantees that \n\n$$\ncu(t)+dv(t)\n$$\n\n is also a solution to ${x}^{′}(t)=Ax(t)$ for all $c,d\\in R.$\n\nNotice that \n\n$$\nw(t)=-2u(t)-v(t).\n$$\n\n \n\nTherefore, $w$ is a solution to ${x}^{′}(t)=Ax(t).$ So, in order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(-2{e}^{-t})^{′} \\\\ (-{e}^{t})^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}2{e}^{-t} \\\\ -{e}^{t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39726/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318f129c-066d-50bd-934a-90722ba4fc93"] :knowledge-point/questions ["q-39726"] :db/ensure [:knowledge-point/validate]} {:db/id "q-76601/selection/e234eda09b0650f3f2a051b63dfbd5627c60abd75339d6a5e4e8cf1e02507981" :answer/id #uuid "23f03b5b-f183-5325-a951-2070165748d7" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}2{e}^{7t} \\\\ 3{e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76601/selection/320b4da97b3a5927bb9382d2fc0d1c6dbec93642fd5e90509a1f39e67fc9a841" :answer/id #uuid "0c1ad413-0506-5ef8-99f3-e14ebc762328" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}14{e}^{-2t} \\\\ -6{e}^{7t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76601/selection/b19e5edf35920d0c3435f417050ea0f86193d881d81d7a7d39932cbe954de385" :answer/id #uuid "a34a5e2d-0b05-5d62-9f8e-2495d8a654f4" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}-4{e}^{-2t} \\\\ 21{e}^{7t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76601/selection/0dbec9ef6a93c968ebb0cfc809513374a6349cba8f68647ba839d01a612f4846" :answer/id #uuid "1eba9f99-4de0-59a5-9746-ca57677fba48" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}-6{e}^{7t} \\\\ 14{e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76601/selection/611a25fafa7becedfec1f64b3c1ecf07717b70bce192379ac3069bd0ca58dd8f" :answer/id #uuid "55ba4f90-eafb-557c-bc33-92717c1f5296" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}14{e}^{7t} \\\\ -6{e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-76601/selection" :answer-field/id #uuid "b42657d6-5115-52d2-8eb9-86931bba54f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76601/selection/611a25fafa7becedfec1f64b3c1ecf07717b70bce192379ac3069bd0ca58dd8f" :answer-field/choices ["q-76601/selection/e234eda09b0650f3f2a051b63dfbd5627c60abd75339d6a5e4e8cf1e02507981" "q-76601/selection/320b4da97b3a5927bb9382d2fc0d1c6dbec93642fd5e90509a1f39e67fc9a841" "q-76601/selection/b19e5edf35920d0c3435f417050ea0f86193d881d81d7a7d39932cbe954de385" "q-76601/selection/0dbec9ef6a93c968ebb0cfc809513374a6349cba8f68647ba839d01a612f4846" "q-76601/selection/611a25fafa7becedfec1f64b3c1ecf07717b70bce192379ac3069bd0ca58dd8f"] :db/ensure [:answer-field/validate]} {:db/id "q-76601" :question/id #uuid "d420d3c3-d380-50f5-9f6f-53081b1eb14d" :question/math-academy-id "q-76601" :question/problem "If $\\,u(t)=[\\begin{aligned}{e}^{7t} \\\\ 0\\end{aligned}]\\,$ and $\\,v(t)=[\\begin{aligned}0 \\\\ {e}^{-2t}\\end{aligned}]\\,$ are solutions to ${x}^{′}(t)=Ax(t)$, find $Aw(t)$ where $w(t)=[\\begin{aligned}2{e}^{7t} \\\\ 3{e}^{-2t}\\end{aligned}].$" :question/worked-solution "Since $u(t)$ and $v(t)$ are solutions to ${x}^{′}(t)=Ax(t),$ the superposition principle guarantees that \n\n$$\ncu(t)+dv(t)\n$$\n\n is also a solution to ${x}^{′}(t)=Ax(t)$ for all $c,d\\in R.$\n\nNotice that \n\n$$\nw(t)=2u(t)+3v(t).\n$$\n\n \n\nTherefore, $w$ is a solution to ${x}^{′}(t)=Ax(t).$ So, in order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(2{e}^{7t})^{′} \\\\ (3{e}^{-2t})^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}14{e}^{7t} \\\\ -6{e}^{-2t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-76601/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318f129c-066d-50bd-934a-90722ba4fc93"] :knowledge-point/questions ["q-76601"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330300/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "3b1f2c33-e714-53b2-8815-42d514133561" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-330300/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "b63ca0a0-28e5-5d31-99c7-ca82e0c6b244" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-330300/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "61a6fc3e-485f-563c-9520-eb58ca4d5fad" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-330300/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "9b42ab26-b79b-5948-bb7e-989212da2aff" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-330300/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "1e4b7e97-c045-5308-a98b-4a71d9de71cd" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-330300/selection" :answer-field/id #uuid "215cbd70-8106-508f-9f8c-1f924c910939" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-330300/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer-field/choices ["q-330300/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-330300/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-330300/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-330300/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-330300/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-330300" :question/id #uuid "96b2276b-2ede-5f9f-8421-253f775eebdd" :question/math-academy-id "q-330300" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\n- ${x}_{1}(t)-{x}_{2}(t)$\n- $5\\cdot {x}_{p}(t)$\n- $-3\\cdot {x}_{2}(t)-{x}_{p}(t)$" :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)-{x}_{2}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because it lacks the particular solution term ${x}_{p}(t).$\n\n- Option II might be *not* a solution to the inhomogeneous system. Notice that $5\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $5$ next to the particular solution ${x}_{p}(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that $-3\\cdot {x}_{2}(t)-{x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $-1$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"None\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-330300/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36"] :knowledge-point/questions ["q-330300"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330305/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "63444c23-0b8c-5966-96b0-7a07a2f10e57" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-330305/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "e5c0785d-d0c0-5c02-a7a0-67a0755b0cc2" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-330305/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "19a9ef31-d81a-5d29-94f1-639717ba5bd6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-330305/selection/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" :answer/id #uuid "db9f390c-5a1a-5689-ac63-39a4546e4408" :answer/type :answer.type/text :answer/value "I, II and III" :db/ensure [:answer/validate]} {:db/id "q-330305/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "3ef3ab3a-cf20-5864-b36a-8c436bd77919" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-330305/selection" :answer-field/id #uuid "33834c01-1af2-5a8b-9328-7e6557e6a592" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-330305/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-330305/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-330305/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-330305/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-330305/selection/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" "q-330305/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-330305" :question/id #uuid "612c7011-a3d0-59fc-9cb6-1ca04190ddc0" :question/math-academy-id "q-330305" :question/problem "Let ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfy the homogeneous system ${x}^{′}(t)=A\\text{ }x(t)$ and ${x}_{p}(t)$ satisfy the inhomogeneous system\n${x}^{′}(t)=A\\text{ }x(t)+f(t).$\nWhich of the following is **always** a solution of the same inhomogeneous system?\n\n- $4\\cdot {x}_{1}(t)+{x}_{p}(t)$\n- $-2\\cdot {x}_{2}(t)+{x}_{p}(t)$\n- ${x}_{1}(t)+3\\cdot {x}_{p}(t)$" :question/worked-solution "Recall that if ${x}_{h}(t)$ satisfies a homogeneous linear system ${x}^{′}(t)=Ax(t)$ and ${x}_{p}(t)$ is a particular solution to an inhomogeneous linear system ${x}^{′}(t)=Ax(t)+f(t),$ then ${x}_{h}(t)+{x}_{p}(t)$ is also a solution to the same inhomogeneous system.\n\nAdditonally, the *linearity principle* for systems of linear ordinary differential equations (ODEs) states that if ${x}_{1}(t),$ ${x}_{2}(t),…,{x}_{k}(t)$ are solutions to a homogeneous linear system ${x}^{′}(t)=Ax(t),$ then any linear combination \n\n$$\n{c}_{1}{x}_{1}(t)+{c}_{2}{x}_{2}(t)+⋯+{c}_{k}{x}_{k}(t)\n$$\n\nwith ${c}_{1},{c}_{2},…,{c}_{k}\\in R$ is also a solution of the same homogeneous system. \n\nWith that in mind, let's examine the given expression.\n\n- Option I is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=4\\cdot {x}_{1}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{4\\cdot {x}_{1}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option II is a solution to the inhomogeneous system. Indeed, notice that the linear combination \n\n$$\n{x}_{h}(t)=-2\\cdot {x}_{2}(t)\n$$\n\nis a solution to the homogeneous system ${x}^{′}(t)=Ax(t)$ according to the linearity principle. Thus, \n\n$$\n{{-2\\cdot {x}_{2}(t)}_{⏟}}_{{x}_{h}(t)}+{x}_{p}(t)\n$$\n\nis a solution to our inhomogeneous system ${x}^{′}(t)=Ax(t)+f(t).$\n\n- Option III might be *not* a solution to the inhomogeneous system. Notice that ${x}_{1}(t)+3\\cdot {x}_{p}(t)$ can't be written as \n\n$$\n{x}_{h}(t)+{x}_{p}(t),\n$$\n\nwhere ${x}_{h}(t)$ is a solution of the homogeneous system, because of the multiplier $3$ next to the particular solution ${x}_{p}(t).$\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-330305/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f6920b1-2a94-5a47-840f-c823c9f70e36"] :knowledge-point/questions ["q-330305"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330308/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "ea2f5609-2ad7-5e08-a249-f1063d66ff02" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-330308/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "d6988c80-4e7c-5bfe-af41-a040089d83fa" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-330308/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "a1012c61-9f43-5b54-aab5-cc3dd7ac1d52" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-330308/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "225e6222-df8e-5510-965c-d962ace35920" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-330308/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "db3c7141-ac60-51bf-bc2e-c3833e8549fb" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-330308/selection" :answer-field/id #uuid "38dc0315-b69b-5667-acf8-bed6950cc9f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-330308/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-330308/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-330308/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-330308/selection/6a87