d9db5f1ab6d5e49c8af0b7c1a21bd33d30240c42af7d75c941aad846bb8c5" "q-76600/selection/ed60cc0d2a55c0b3b91ccf856891c1a5540d629d40ce734b569076bf667db49b"] :db/ensure [:answer-field/validate]} {:db/id "q-76600" :question/id #uuid "d6650d15-f7ed-544a-bfb1-4e769ffb9a89" :question/math-academy-id "q-76600" :question/problem "If $\\,u(t)=[\\begin{aligned}{e}^{3t} \\\\ 0\\end{aligned}]\\,$ and $\\,v(t)=[\\begin{aligned}0 \\\\ {e}^{5t}\\end{aligned}]\\,$ are solutions to ${x}^{′}(t)=Ax(t)$, find $Aw(t)$ where $w(t)=[\\begin{aligned}-2{e}^{3t} \\\\ 7{e}^{5t}\\end{aligned}].$" :question/worked-solution "Since $u(t)$ and $v(t)$ are solutions to ${x}^{′}(t)=Ax(t),$ the superposition principle guarantees that \n\n$$\ncu(t)+dv(t)\n$$\n\n is also a solution to ${x}^{′}(t)=Ax(t)$ for all $c,d\\in R.$\n\nNotice that \n\n$$\nw(t)=-2u(t)+7v(t).\n$$\n\n \n\nTherefore, $w$ is a solution to ${x}^{′}(t)=Ax(t).$ So, in order to find $Aw(t)$ we just need to find ${w}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}Aw & ={w}^{′}(t) \\\\  & =[\\begin{aligned}(-2{e}^{3t})^{′} \\\\ (7{e}^{5t})^{′}\\end{aligned}] \\\\  & =[\\begin{aligned}-6{e}^{3t} \\\\ 35{e}^{5t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-76600/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318f129c-066d-50bd-934a-90722ba4fc93"] :knowledge-point/questions ["q-76600"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186167077 :question/answer-fields 17592186163880] {:db/id "q-168100/selection/ma-v1/f8a26110263278293c9e5ae5d44ed2df7f788b5181153ad3819684d601d34218/f87650942f715e11bbf0eea28188efe73135b8daf2b5110f1e5245595eda23eb" :answer/id #uuid "cff8eef0-5791-5a12-97a6-d7830fe6b12e" :answer/type :answer.type/math :answer/value "Aw=[\\begin{aligned}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-168100/selection/ma-v1/f8a26110