c096629bd9d28a09c13b0b15a7" "q-10984/selection/ed629748342b2aa5542ec2de4772e4265791d30d7a0cd649aa171bf6cec03e2f"] :db/ensure [:answer-field/validate]} {:db/id "q-10984" :question/id #uuid "bd9c2844-6bdc-5c2f-9221-29ae8c00fdef" :question/math-academy-id "q-10984" :question/problem "Express $\\frac{44x+48}{(x+6)(x-3)(x+2)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{44x+48}{(x+6)(x-3)(x+2)} & =\\frac{A}{(x+6)}+\\frac{B}{(x-3)}+\\frac{C}{(x+2)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+6)(x-3)(x+2)$ gives\n\n$$\n44x+48=A(x-3)(x+2)+B(x+6)(x+2)+C(x+6)(x-3).\n$$\n\nFor $x=-6$, we get \n\n$$\n\\begin{aligned}44(-6)+48 & =A(-6-3)(-6+2) \\\\  & \\,+B(-6+6)(-6+2) \\\\  & \\,+C(-6+6)(-6-3) \\\\ -264+48 & =A(36) \\\\ A & =\\frac{-216}{36} \\\\ A & =-6.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}44(3)+48 & =A(3-3)(3+2) \\\\  & \\,+B(3+6)(3+2) \\\\  & \\,+C(3+6)(3-3) \\\\ 132+48 & =B(45) \\\\ B & =\\frac{180}{45} \\\\ B & =4.\\end{aligned}\n$$\n\nFor $x=-2$, we get \n\n$$\n\\begin{aligned}44(-2)+48 & =A(-2-3)(-2+2) \\\\  & \\,+B(-2+6)(-2+2) \\\\  & \\,+C(-2+6)(-2-3) \\\\ -88+48 & =C(-20) \\\\ C & =\\frac{-40}{-20} \\\\ C & =2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{44x+48}{(x+6)(x-3)(x+2)}=-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10984/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df"] :knowledge-point/questions ["q-10984"] :db/ensure [:knowledge-point/validate]} {:db/id "q-51137/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "b56a9c95-6e47-5f3d-9453-f95367e95e84" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-51137/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uu