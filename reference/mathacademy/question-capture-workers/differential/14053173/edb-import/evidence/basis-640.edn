#{[{:db/id #edb/ref 17592186268264 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d35241f7-ff4e-5a5c-a70a-4814b8a2cf65" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186268266} {:answer/id #uuid "44b036d6-9543-5dc2-aa00-23ddc1e5fa51" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268267} {:answer/id #uuid "cc332e1d-6b71-55c3-8b76-f45afba89c51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268268} {:answer/id #uuid "a5a9c20a-f23a-5323-8e0e-1eb1770845dc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186268269} {:answer/id #uuid "720624f1-f5f2-52ce-b943-d05472e788df" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268270}] :answer-field/correct {:answer/id #uuid "cc332e1d-6b71-55c3-8b76-f45afba89c51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268268} :answer-field/id #uuid "6ade377a-7056-50ca-aa06-b10947c90d74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268265}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9a0c48a9-fea3-5370-b735-9bdfb2ee74c7" :question/math-academy-id "q-10955" :question/problem "Given that\n\n$$\n\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x+3)$ gives\n\n$$\nx-15=A(x+3)+B(x-3).\n$$\n\nFor $x=-3$, we get \n\n$$\n\\begin{aligned}(-3)-15 & =A(-3+3)+B(-3-3) \\\\ -18 & =-6B \\\\ B & =3.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}3-15 & =A(3+3)+B(3-3) \\\\ -12 & =A(6) \\\\ A & =-2.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-2+3=1.\n$$"}]}
