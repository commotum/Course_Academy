-5-1)(-5+5) \\\\  & \\,+B(3(-5)+2)(-5+5) \\\\  & \\,+C(3(-5)+2)(-5-1) \\\\ 175-100+3 & =C(78) \\\\ C & =\\frac{78}{78} \\\\ C & =1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C=1+1+1=3.\\end{aligned}\n$$" 13194139535096 true] [17592186331002 1000 #edb/ref 17592186331003 13194139535096 true] [17592186331002 1000 #edb/ref 17592186331004 13194139535096 true] [17592186331002 1000 #edb/ref 17592186331005 13194139535096 true] [17592186331002 1000 #edb/ref 17592186331006 13194139535096 true] [17592186331002 1000 #edb/ref 17592186331007 13194139535096 true] [17592186331002 1040 #edb/ref 17592186045450 13194139535096 true] [17592186331002 1041 "selection" 13194139535096 true] [17592186331002 1104 #edb/ref 17592186331004 13194139535096 true] [17592186331002 1110 #uuid "342537e0-ef62-5329-82aa-ad262afbc3c4" 13194139535096 true] [17592186331003 1034 "-5" 13194139535096 true] [17592186331003 1103 #edb/ref 17592186045453 13194139535096 true] [17592186331003 1111 #uuid "02c831ce-1028-5bbf-abe4-3fff97f72a0b" 13194139535096 true] [17592186331004 1034 "3" 13194139535096 true] [17592186331004 1103 #edb/ref 17592186045453 13194139535096 true] [17592186331004 1111 #uuid "6e03682f-d33a-5732-b219-286670bd466e" 13194139535096 true] [17592186331005 1034 "6" 13194139535096 true] [17592186331005 1103 #edb/ref 17592186045453 13194139535096 true] [17592186331005 1111 #uuid "0a466f58-d174-54fe-bb28-71e982bac178" 13194139535096 true] [17592186331006 1034 "1" 13194139535096 true] [17592186331006 1103 #edb/ref 17592186045453 13194139535096 true] [17592186331006 1111 #uuid "a58b6499-9218-52c6-9238-1ddf6c6212e8" 13194139535096 true] [17592186331007 1034 "-4" 13194139535096 true] [17592186331007 1103 #edb/ref 17592186045453 13194139535096 true] [17592186331007 1111 #uuid "60e4f329-ec97-5c6e-a5b6-6c7db3afad5c" 13194139535096 true] [17592186331008 1017 #edb/ref 17592186331009 13194139535096 true] [17592186331008 1089 "q-10984" 13194139535096 true] [17592186331008 1091 #edb/ref 17592186045465