) \\\\ -18 & =-6B \\\\ B & =3.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}3-15 & =A(3+3)+B(3-3) \\\\ -12 & =A(6) \\\\ A & =-2.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-2+3=1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10955" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/activity-metadata.json" "file_sha256" "7a36b8fd4243c03cb53aba1e50e23529af8527c23df7cab3af5f9f60db2b6dc7"} {"question" "q-10955" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10955" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-5"] ["math" "0"] ["math" "1"] ["math" "3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10955" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10984" "field" nil "attribute" "question/problem" "value" "Express $\\frac{44x+48}{(x+6)(x-3)(x+2)}$ as a sum of partial fractions." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10984" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{44x+48}{(x+6)(x-3)(x+2)} & =\\frac{A}{(x+6)}+\\frac{B}{(x-3)}+\\frac{C}{(x+2)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+6)(x-3)(x+2)$ gives\n\n$$\n44x+48=A(x-3)(x+2)+B(x+6)(x+2)+C(x+6)(x-3).\n$$\n\nFor $x=-6$, we get \n\n$$\n\\begin{aligned}44(-6)+48 & =A(-6-3)(-6+2) \\\\  & \\,+B(-6+6)(-6+2) \\\\  & \\,+C(-6+6)(-6-3) \\\\ -264+48 & =A(36) \\\\ A & =\\frac{-216}{36} \\\\ A & =-6.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}44(3)+48 & =A(3-3)(3+2) \\\\  & \\,+B(3+6)(3+2) \\\\  & \\,+C(3+6)(3-3) \\\\ 132+48 & =B(45) \\\\ B & =\\frac{180}{45} \\\\ B & =4.\\end{aligned}\n$$\n\nFor $x=-2$, we get \n\n$$\n\\begin{aligned}44(-2)+48 & =A(-2-3)(-2+2) \\\\  & \\,+B(-2+6)(-2+2) \\\\  & \\,+C(-2+6)(-2-3) \\\\ -88+48 & =C(-20) \\\\ C & =\\frac{-40}{-20} \\\\ C & =2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{44x+48}{(x+6)(x-3)(x+2)}=-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10984" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/activity-metadata.json" "file_sha256" "7a36b8fd4243c03cb53aba1e50e23529af8527c23df7cab3af5f9f60db2b6dc7"} {"question" "q-10984" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10984" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{(x+6)}+\\frac{5}{(x-3)}+\\frac{3}{(x+2)}"] ["math" "-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}"] ["math" "\\frac{10}{(x+6)}+\\frac{2}{(x-3)}+\\frac{3}{(x+2)}"] ["math" "\\frac{3}{(x+6)}-\\frac{9}{(x-3)}-\\frac{5}{(x+2)}"] ["math" "\\frac{7}{(x+6)}+\\frac{1}{(x-3)}-\\frac{2}{(x+2)}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-10984" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-51137" "field" nil "attribute" "question/problem" "value" "Given that\n\n$$\n\\frac{-9x+36}{(x-3)(x-6)}=-\\frac{3}{(x-3)}+\\frac{B}{(x-6)},\n$$\n\nwhat is the value of $B?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-51137" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{-9x+36}{(x-3)(x-6)}=-\\frac{3}{(x-3)}+\\frac{B}{(x-6)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x-6)$ gives\n\n$$\n-9x+36=-3(x-6)+B(x-3).\n$$\n\nFor $x=6$, we get \n\n$$\n\\begin{aligned}-9(6)+36 & =-3(6-6)+B(6-3) \\\\ -18 & =3B \\\\ B & =-6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-51137" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/activity-metadata.json" "file_sha256" "7a36b8fd4243c03cb53aba1e50e23529af8527c23df7cab3af5f9f60db2b6dc7"} {"question" "q-51137" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-51137" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "-6"] ["math" "-9"] ["math" "6"] ["math" "9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-51137" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-102552" "field" nil "attribute" "question/problem" "value" "Given that\n\n$$\n\\frac{7{x}^{2}+20x+3}{(3x+2)(x-1)(x+5)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, calculate $A+B+C.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-102552" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{7{x}^{2}+20x+3}{(3x+2)(x-1)(x+5)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3x+2)(x-1)(x+5)$ gives\n\n$$\n7{x}^{2}+20x+3=A(x-1)(x+5)+B(3x+2)(x+5)+C(3x+2)(x-1).\n$$\n\nFor $x=-\\frac{2}{3}$, we get \n\n$$\n\\begin{aligned}7{(-\\frac{2}{3})}^{2}+20(-\\frac{2}{3})+3 & =A(-\\frac{2}{3}-1)(-\\frac{2}{3}+5) \\\\  & \\,+B(3(-\\frac{2}{3})+2)(-\\frac{2}{3}+5) \\\\  & \\,+C(3(-\\frac{2}{3})+2)(-\\frac{2}{3}-1) \\\\ \\frac{28}{9}-\\frac{40}{3}+3 & =A(-\\frac{65}{9}) \\\\ -\\frac{65}{9} & =A(-\\frac{65}{9}) \\\\ A & =1.\\end{aligned}\n$$\n\nFor $x=1$, we get \n\n$$\n\\begin{aligned}7(1)^{2}+20(1)+3 & =A(1-1)(1+5) \\\\  & \\,+B(3(1)+2)(1+5) \\\\  & \\,+C(3(1)+2)(1-1) \\\\ 7+20+3 & =B(30) \\\\ B & =\\frac{30}{30} \\\\ B & =1.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}7(-5)^{2}+20(-5)+3 & =A(-5-1)(-5+5) \\\\  & \\,+B(3(-5)+2)(-5+5) \\\\  & \\,+C(3(-5)+2)(-5-1) \\\\ 175-100+3 & =C(78) \\\\ C & =\\frac{78}{78} \\\\ C & =1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C=1+1+1=3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/state.json" "file_sha256" "d1a388a53aa2d5e73f8158b4c2d70005b2b5e51d888be8458fa774f894a88683"} {"question" "q-102552" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14053173/activity-metadata.json"