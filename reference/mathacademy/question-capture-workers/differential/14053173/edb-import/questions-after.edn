#{[{:db/id #edb/ref 17592186331001 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02c831ce-1028-5bbf-abe4-3fff97f72a0b" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186331003} {:answer/id #uuid "6e03682f-d33a-5732-b219-286670bd466e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186331004} {:answer/id #uuid "0a466f58-d174-54fe-bb28-71e982bac178" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186331005} {:answer/id #uuid "a58b6499-9218-52c6-9238-1ddf6c6212e8" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186331006} {:answer/id #uuid "60e4f329-ec97-5c6e-a5b6-6c7db3afad5c" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186331007}] :answer-field/correct {:answer/id #uuid "6e03682f-d33a-5732-b219-286670bd466e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186331004} :answer-field/id #uuid "342537e0-ef62-5329-82aa-ad262afbc3c4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331002}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "30de06a3-978b-5217-b85e-0103eb7e6b72" :question/math-academy-id "q-102552" :question/problem "Given that\n\n$$\n\\frac{7{x}^{2}+20x+3}{(3x+2)(x-1)(x+5)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, calculate $A+B+C.$" :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{7{x}^{2}+20x+3}{(3x+2)(x-1)(x+5)}=\\frac{A}{(3x+2)}+\\frac{B}{(x-1)}+\\frac{C}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(3x+2)(x-1)(x+5)$ gives\n\n$$\n7{x}^{2}+20x+3=A(x-1)(x+5)+B(3x+2)(x+5)+C(3x+2)(x-1).\n$$\n\nFor $x=-\\frac{2}{3}$, we get \n\n$$\n\\begin{aligned}7{(-\\frac{2}{3})}^{2}+20(-\\frac{2}{3})+3 & =A(-\\frac{2}{3}-1)(-\\frac{2}{3}+5) \\\\  & \\,+B(3(-\\frac{2}{3})+2)(-\\frac{2}{3}+5) \\\\  & \\,+C(3(-\\frac{2}{3})+2)(-\\frac{2}{3}-1) \\\\ \\frac{28}{9}-\\frac{40}{3}+3 & =A(-\\frac{65}{9}) \\\\ -\\frac{65}{9} & =A(-\\frac{65}{9}) \\\\ A & =1.\\end{aligned}\n$$\n\nFor $x=1$, we get \n\n$$\n\\begin{aligned}7(1)^{2}+20(1)+3 & =A(1-1)(1+5) \\\\  & \\,+B(3(1)+2)(1+5) \\\\  & \\,+C(3(1)+2)(1-1) \\\\ 7+20+3 & =B(30) \\\\ B & =\\frac{30}{30} \\\\ B & =1.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}7(-5)^{2}+20(-5)+3 & =A(-5-1)(-5+5) \\\\  & \\,+B(3(-5)+2)(-5+5) \\\\  & \\,+C(3(-5)+2)(-5-1) \\\\ 175-100+3 & =C(78) \\\\ C & =\\frac{78}{78} \\\\ C & =1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}A+B+C=1+1+1=3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268264 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d35241f7-ff4e-5a5c-a70a-4814b8a2cf65" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186268266} {:answer/id #uuid "44b036d6-9543-5dc2-aa00-23ddc1e5fa51" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268267} {:answer/id #uuid "cc332e1d-6b71-55c3-8b76-f45afba89c51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268268} {:answer/id #uuid "a5a9c20a-f23a-5323-8e0e-1eb1770845dc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186268269} {:answer/id #uuid "720624f1-f5f2-52ce-b943-d05472e788df" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186268270}] :answer-field/correct {:answer/id #uuid "cc332e1d-6b71-55c3-8b76-f45afba89c51" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186268268} :answer-field/id #uuid "6ade377a-7056-50ca-aa06-b10947c90d74" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268265}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9a0c48a9-fea3-5370-b735-9bdfb2ee74c7" :question/math-academy-id "q-10955" :question/problem "Given that\n\n$$\n\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{x-15}{(x-3)(x+3)}=\\frac{A}{(x-3)}+\\frac{B}{(x+3)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x+3)$ gives\n\n$$\nx-15=A(x+3)+B(x-3).\n$$\n\nFor $x=-3$, we get \n\n$$\n\\begin{aligned}(-3)-15 & =A(-3+3)+B(-3-3) \\\\ -18 & =-6B \\\\ B & =3.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}3-15 & =A(3+3)+B(3-3) \\\\ -12 & =A(6) \\\\ A & =-2.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-2+3=1.\n$$"}] [{:db/id #edb/ref 17592186331008 :knowledge-point/_questions [{:knowledge-point/id #uuid "7e66d7cf-1a4b-51e6-9c78-f70a8c0555df" :knowledge-point/title "Expressing a Rational Function With Three Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fdb3c4e7-feb7-5fed-8a06-e0ab4ce1988f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{(x+6)}+\\frac{1}{(x-3)}-\\frac{2}{(x+2)}" :db/id #edb/ref 17592186331010} {:answer/id #uuid "90404313-b917-5a3b-814c-003d8aab728b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(x+6)}+\\frac{5}{(x-3)}+\\frac{3}{(x+2)}" :db/id #edb/ref 17592186331011} {:answer/id #uuid "217c9724-2050-5863-ad60-00c27b27710f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{(x+6)}+\\frac{2}{(x-3)}+\\frac{3}{(x+2)}" :db/id #edb/ref 17592186331012} {:answer/id #uuid "044bea13-3ea8-5323-9de2-d2ad7b6f7bfb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{(x+6)}-\\frac{9}{(x-3)}-\\frac{5}{(x+2)}" :db/id #edb/ref 17592186331013} {:answer/id #uuid "05c06458-b5bf-5bc8-b701-db61d12ad3c5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}" :db/id #edb/ref 17592186331014}] :answer-field/correct {:answer/id #uuid "05c06458-b5bf-5bc8-b701-db61d12ad3c5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}" :db/id #edb/ref 17592186331014} :answer-field/id #uuid "3a6c04cc-08a6-556f-8c2a-654b5f1a16a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331009}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bd9c2844-6bdc-5c2f-9221-29ae8c00fdef" :question/math-academy-id "q-10984" :question/problem "Express $\\frac{44x+48}{(x+6)(x-3)(x+2)}$ as a sum of partial fractions." :question/worked-solution "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{44x+48}{(x+6)(x-3)(x+2)} & =\\frac{A}{(x+6)}+\\frac{B}{(x-3)}+\\frac{C}{(x+2)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+6)(x-3)(x+2)$ gives\n\n$$\n44x+48=A(x-3)(x+2)+B(x+6)(x+2)+C(x+6)(x-3).\n$$\n\nFor $x=-6$, we get \n\n$$\n\\begin{aligned}44(-6)+48 & =A(-6-3)(-6+2) \\\\  & \\,+B(-6+6)(-6+2) \\\\  & \\,+C(-6+6)(-6-3) \\\\ -264+48 & =A(36) \\\\ A & =\\frac{-216}{36} \\\\ A & =-6.\\end{aligned}\n$$\n\nFor $x=3$, we get \n\n$$\n\\begin{aligned}44(3)+48 & =A(3-3)(3+2) \\\\  & \\,+B(3+6)(3+2) \\\\  & \\,+C(3+6)(3-3) \\\\ 132+48 & =B(45) \\\\ B & =\\frac{180}{45} \\\\ B & =4.\\end{aligned}\n$$\n\nFor $x=-2$, we get \n\n$$\n\\begin{aligned}44(-2)+48 & =A(-2-3)(-2+2) \\\\  & \\,+B(-2+6)(-2+2) \\\\  & \\,+C(-2+6)(-2-3) \\\\ -88+48 & =C(-20) \\\\ C & =\\frac{-40}{-20} \\\\ C & =2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{44x+48}{(x+6)(x-3)(x+2)}=-\\frac{6}{(x+6)}+\\frac{4}{(x-3)}+\\frac{2}{(x+2)}.\n$$"}] [{:db/id #edb/ref 17592186331015 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb4849f8-8f6d-557b-9afc-a67466c0fefb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331017}] :answer-field/correct {:answer/id #uuid "fb4849f8-8f6d-557b-9afc-a67466c0fefb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186331017} :answer-field/id #uuid "1731aff4-e4c9-567f-b57c-8a4be0fbe240" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186331016}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a1b9c442-5b9b-599f-8823-37e850775cca" :question/math-academy-id "q-350932" :question/problem "Express $\\frac{3x}{(x-1)(x+2)}$ as a sum of partial fractions.\n\n| $\\frac{3x}{(x-1)(x+2)}=\\,$ | $1$ | $+$ | {{field-1}} |\n| --- | --- | --- | --- |\n|  | $x-1$ |  | $x+2$ |" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\frac{3x}{(x-1)(x+2)}=\\frac{1}{x-1}+\\frac{B}{x+2}.\n$$\n\nMultiplying both sides by $(x-1)(x+2)$ gives\n\n$$\n3x=(x+2)+B(x-1).\n$$\n\nFor $x=-2$, we get\n\n$$\n\\begin{aligned}3(-2) & =(-2+2)+B(-2-1) \\\\ -6 & =-3B \\\\ B & =2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3x}{(x-1)(x+2)}=\\frac{1}{x-1}+\\frac{2}{x+2}.\n$$"}] [{:db/id #edb/ref 17592186331018 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "487f101b-3680-566a-81ed-351ea40cc887" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186331020} {:answer/id #uuid "3d7e2fc5-1e2e-59b9-85a2-d0f05e6f5b50" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186331021} {:answer/id #uuid "f0ad9c7e-2ffc-59a9-8bbf-459a83cc5de7" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186331022} {:answer/id #uuid "b56a9c95-6e47-5f3d-9453-f95367e95e84" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186331023} {:answer/id #uuid "0d0ab330-61b7-5822-aa98-6c946c434f9e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186331024}] :answer-field/correct {:answer/id #uuid "0d0ab330-61b7-5822-aa98-6c946c434f9e" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186331024} :answer-field/id #uuid "b145dc14-36e8-503c-b59a-c5ab92aa35f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186331019}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5400117b-e86f-5ef4-b4c4-c5a2da2b4a30" :question/math-academy-id "q-51137" :question/problem "Given that\n\n$$\n\\frac{-9x+36}{(x-3)(x-6)}=-\\frac{3}{(x-3)}+\\frac{B}{(x-6)},\n$$\n\nwhat is the value of $B?$" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\begin{aligned}\\frac{-9x+36}{(x-3)(x-6)}=-\\frac{3}{(x-3)}+\\frac{B}{(x-6)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x-3)(x-6)$ gives\n\n$$\n-9x+36=-3(x-6)+B(x-3).\n$$\n\nFor $x=6$, we get \n\n$$\n\\begin{aligned}-9(6)+36 & =-3(6-6)+B(6-3) \\\\ -18 & =3B \\\\ B & =-6.\\end{aligned}\n$$"}]}
