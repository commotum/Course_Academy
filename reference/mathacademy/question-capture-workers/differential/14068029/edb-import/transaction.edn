\\operatorname{sin}⁡(3t) \\\\ \\operatorname{cos}⁡(3t)\\end{aligned}]{e}^{6t}+{c}_{2}[\\begin{aligned}f(t) \\\\ \\operatorname{sin}⁡(3t)\\end{aligned}]{e}^{6t}\n$$\n\n*Hint: The matrix has the eigenvalue ${\\lambda }_{1}=6+3\\text{i}$ with the corresponding eigenvector ${v}_{1}=[\\begin{aligned}1+3\\text{i} \\\\ 1\\end{aligned}].$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}7 & -10 \\\\ 1 & 5\\end{aligned}].$ \n\nWe are given the eigenvalue ${\\lambda }_{1}=6+3\\text{i}$ and the corresponding eigenvector ${v}_{1}=[\\begin{aligned}1+3\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=6+3\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}1+3\\text{i} \\\\ 1\\end{aligned}]{e}^{(6+3\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}1+3\\text{i} \\\\ 1\\end{aligned}]{e}^{(6+3\\text{i})t} \\\\  & =[\\begin{aligned}1+3\\text{i} \\\\ 1\\end{aligned}]{e}^{6t}(\\operatorname{cos}⁡(3t)+\\text{i}\\operatorname{sin}⁡(3t)) \\\\  & =[\\begin{aligned}{e}^{6t}\\operatorname{cos}⁡(3t)+\\text{i}{e}^{6t}\\operatorname{sin}⁡(3t)+3\\text{i}{e}^{6t}\\operatorname{cos}⁡(3t)-3{e}^{6t}\\operatorname{sin}⁡(3t) \\\\ {e}^{6t}\\operatorname{cos}⁡(3t)+\\text{i}{e}^{6t}\\operatorname{sin}⁡(3t)\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{6t}(\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t))+\\text{i}{e}^{6t}(3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)) \\\\ {e}^{6t}\\operatorname{cos}⁡(3t)+\\text{i}{e}^{6t}\\operatorname{sin}⁡(3t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t) \\\\ \\operatorname{cos}⁡(3t)\\end{aligned}]{e}^{6t}+\\text{i}[\\begin{aligned}3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t) \\\\ \\operatorname{sin}⁡(3t)\\end{aligned}]{e}^{6t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(3t)-3\\operatorname{sin}⁡(3t) \\\\ \\operatorname{cos}⁡(3t)\\end{aligned}]{e}^{6t}+{c}_{2}[\\begin{aligned}3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t) \\\\ \\operatorname{sin}⁡(3t)\\end{aligned}]{e}^{6t}.\\end{aligned}\n$$\n\nFinally, $f(t)=3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-334132/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3692fa3-14c5-5db9-8fee-e99ae35e386f"] :knowledge-point/questions ["q-334132"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334104/selection/727c0055fc7bbdd410e09cec01032600862a2cc49c470fc6e4c86991c57c7909" :answer/id #uuid "f1193d21-e9d0-55cb-9004-9bd9728dde45" :answer/type :answer.type/math :answer/value "-4\\operatorname{cos}⁡(2t)" :db/ensure [:answer/validate]} {:db/id "q-334104/selection/24f5d131e97c1627fc29aa2ae02206f640cc05051a9d0015ebf90a30c2452c14" :answer/id #uuid "475f9169-0a25-53c6-ad09-23813f5c3aeb" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(2t)" :db/ensure [:answer/validate]} {:db/id "q-334104/selection/24c2ae87de258b2ee47a2a8591df70f23609ab0f58619c91bc2b33947138e800" :answer/id #uuid "7a055744-d194-50cf-88db-4c0a8291afcf" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡(2t)" :db/ensure [:answer/validate]} {:db/id "q-334104/selection/b0aa572fe51917bed6e20be8fd51257dbbf020fab7b4337f0575541808ba4a1c" :answer/id #uuid "0e757361-d7c8-5315-bc9a-d223eb5207e8" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡(2t)" :db/ensure [:answer/validate]} {:db/id "q-334104/selection/299d3be99236b7db38ace4addc91138cdfd1469aa3f9983bf1b98976db253f55" :answer/id #uuid "d8b72144-ce21-559a-abf9-c196404e06f3" :answer/type :answer.type/math :answer/value "-2\\operatorname{cos}⁡(2t)" :db/ensure [:answer/validate]} {:db/id "q-334104/selection" :answer-field/id #uuid "3ef3c711-2aee-58dd-81a4-13a2a02d97fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334104/selection/24f5d131e97c1627fc29aa2ae02206f640cc05051a9d0015ebf90a30c2452c14" :answer-field/choices ["q-334104/selection/727c0055fc7bbdd410e09cec01032600862a2cc49c470fc6e4c86991c57c7909" "q-334104/selection/24f5d131e97c1627fc29aa2ae02206f640cc05051a9d0015ebf90a30c2452c14" "q-334104/selection/24c2ae87de258b2ee47a2a8591df70f23609ab0f58619c91bc2b33947138e800" "q-334104/selection/b0aa572fe51917bed6e20be8fd51257dbbf020fab7b4337f0575541808ba4a1c" "q-334104/selection/299d3be99236b7db38ace4addc91138cdfd1469aa3f9983bf1b98976db253f55"] :db/ensure [:answer-field/validate]} {:db/id "q-334104" :question/id #uuid "24bfb8fa-479a-5ccb-9005-78c61251c83b" :question/math-academy-id "q-334104" :question/problem "$$\n{x}^{′}(t)=[\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}]x(t)\n$$\n\nConsider the system of linear differential equations above.\nFind the unknown function $f(t)$ in the general solution to the system, shown below.\n\n$$\n\\text{x}(t)={c}_{1}[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}f(t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{t}\n$$\n\n*Hint: One of the eigenvalues of the matrix is ${\\lambda }_{1}=1+2\\text{i}.$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}1 & -2 \\\\ 2 & 1\\end{aligned}].$ \n\nWe are given that the eigenvalue is ${\\lambda }_{1}=1+2\\text{i}.$ \n\nLet's go through the process of finding the eigenvectors. For ${\\lambda }_{1}=1+2\\text{i},$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-2\\text{i} & -2 \\\\ 2 & -2\\text{i}\\end{aligned}]∼[\\begin{aligned}1 & -\\text{i} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=1+2\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{(1+2\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{(1+2\\text{i})t} \\\\  & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{t}(\\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)) \\\\  & =[\\begin{aligned}-{e}^{t}\\operatorname{sin}⁡(2t)+\\text{i}({e}^{t}\\operatorname{cos}⁡(2t)) \\\\ {e}^{t}\\operatorname{cos}⁡(2t)+\\text{i}({e}^{t}\\operatorname{sin}⁡(2t))\\end{aligned}] \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{t}+\\text{i}[\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{t}.\\end{aligned}\n$$\n\nFinally, $f(t)=\\operatorname{cos}⁡(2t).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334104/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3692fa3-14c5-5db9-8fee-e99ae35e386f"] :knowledge-point/questions ["q-334104"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334223/selection/fb4f6a4e24d39c91722b09e895a1d0b62e2d6983fccdeb19a03c430dc6707137" :answer/id #uuid "9a2a1beb-a321-54dc-9cbc-3e56674ecd1e" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t+25\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-334223/selection/7ab92f35796e4bc5413998f25c566b47e9946272b4400b54d31f219df1ed1542" :answer/id #uuid "3e3a89c4-cf37-5b83-a180-a9bc0a442dbb" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t-7\\operatorname{sin}⁡t\\end{aligned}]{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-334223/selection/9a886b6c387cc1b9030a4e262786b330bfcfc27abea8505a7d3c9450c2bdbc09" :answer/id #uuid "d359fdcc-bd98-51e3-9a01-ad1eb3cf877c" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t-7\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t\\end{aligned}]{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-334223/selection/c013dabb7b8639af7796be54ae888c8e00f7a7d00e2a9aab5053ddbcfc12e149" :answer/id #uuid "cf71447c-f4ed-5b04-b2d4-96afbb5084fd" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t-5\\operatorname{sin}⁡t\\end{aligned}]{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-334223/selection/829c1746de3d726b845ea2b85df8cceaa55908aff0f504bfa0590e5bdd0a2dbc" :answer/id #uuid "6bbf160e-0ede-5834-b08d-58ed51469228" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-334223/selection" :answer-field/id #uuid "aca6858e-fbdc-5231-b205-54cdd5604b33" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334223/selection/9a886b6c387cc1b9030a4e262786b330bfcfc27abea8505a7d3c9450c2bdbc09" :answer-field/choices ["q-334223/selection/fb4f6a4e24d39c91722b09e895a1d0b62e2d6983fccdeb19a03c430dc6707137" "q-334223/selection/7ab92f35796e4bc5413998f25c566b47e9946272b4400b54d31f219df1ed1542" "q-334223/selection/9a886b6c387cc1b9030a4e262786b330bfcfc27abea8505a7d3c9450c2bdbc09" "q-334223/selection/c013dabb7b8639af7796be54ae888c8e00f7a7d00e2a9aab5053ddbcfc12e149" "q-334223/selection/829c1746de3d726b845ea2b85df8cceaa55908aff0f504bfa0590e5bdd0a2dbc"] :db/ensure [:answer-field/validate]} {:db/id "q-334223" :question/id #uuid "5fc6ee3c-e10e-57cd-92e7-361a4aae8ac6" :question/math-academy-id "q-334223" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 5 \\\\ -1 & 5\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}].\n$$\n\n*Hint: The matrix has the eigenvalue ${\\lambda }_{1}=3+\\text{i}$ with the corresponding eigenvector ${v}_{1}=[\\begin{aligned}2-\\text{i} \\\\ 1\\end{aligned}].$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}1 & 5 \\\\ -1 & 5\\end{aligned}].$ \n\nWe are given the eigenvalue ${\\lambda }_{1}=3+\\text{i}$ and the corresponding eigenvector ${v}_{1}=[\\begin{aligned}2-\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=3+\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}2-\\text{i} \\\\ 1\\end{aligned}]{e}^{(3+\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}2-\\text{i} \\\\ 1\\end{aligned}]{e}^{(3+\\text{i})t} \\\\  & =[\\begin{aligned}2-\\text{i} \\\\ 1\\end{aligned}]{e}^{3t}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}2{e}^{3t}\\operatorname{cos}⁡t+2\\text{i}{e}^{3t}\\operatorname{sin}⁡t-\\text{i}{e}^{3t}\\operatorname{cos}⁡t+{e}^{3t}\\operatorname{sin}⁡t \\\\ {e}^{3t}\\operatorname{cos}⁡t+\\text{i}{e}^{3t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}+\\text{i}[\\begin{aligned}2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{3t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}2\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{3t}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}-1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}2{c}_{1}-{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}-1 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =-[\\begin{aligned}2\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}-3[\\begin{aligned}2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{3t} \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡t-7\\operatorname{sin}⁡t \\\\ -\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t\\end{aligned}]{e}^{3t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-334223/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b1633293-c176-5bfe-8fa9-cfd872ceca26"] :knowledge-point/questions ["q-334223"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334214/selection/e875b8b013ad15219888935f92955e24eadab2954b4215b9bde7509cc0dd5693" :answer/id #uuid "2033906c-167a-589b-b889-a26025f05879" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t\\end{aligned}]{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-334214/selection/b1f2aeda8f2fa8ab404d91e7df38cb3561b747fa46cd9db031255a576c5c7f4e" :answer/id #uuid "468e9a8d-c1cd-5822-bc51-466e75a50bb9" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ 2\\operatorname{cos}⁡t+2\\operatorname{sin}⁡t\\end{aligned}]{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-334214/selection/5e5f5fd1b7c2d7e029aa0f3851494e70f86ea02e9f8bf71aa883a6e2aeab3d5d" :answer/id #uuid "95c7ee83-4b45-5999-a533-f27188af044d" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{sin}⁡t-\\operatorname{cos}⁡t \\\\ 2\\operatorname{cos}⁡t+\\operatorname{sin}⁡t\\end{aligned}]{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-334214/selection/cf1b2002f92cd838b1628504677a720a8bfc16cfae7ee51e52f4fb7e0abf1f09" :answer/id #uuid "90875bc6-8fb2-58dd-94f2-de019f8b96b4" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{aligned}]{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-334214/selection/39adf08bf199c6dd2897d2b271bae0248a9ac39b6b4e15c9aa945be67e83d4bb" :answer/id #uuid "d957078c-a9e9-5506-8ace-7ab5a7c99459" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{aligned}]{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-334214/selection" :answer-field/id #uuid "dc881e51-c33d-5f34-815a-c92f267de55e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334214/selection/e875b8b013ad15219888935f92955e24eadab2954b4215b9bde7509cc0dd5693" :answer-field/choices ["q-334214/selection/e875b8b013ad15219888935f92955e24eadab2954b4215b9bde7509cc0dd5693" "q-334214/selection/b1f2aeda8f2fa8ab404d91e7df38cb3561b747fa46cd9db031255a576c5c7f4e" "q-334214/selection/5e5f5fd1b7c2d7e029aa0f3851494e70f86ea02e9f8bf71aa883a6e2aeab3d5d" "q-334214/selection/cf1b2002f92cd838b1628504677a720a8bfc16cfae7ee51e52f4fb7e0abf1f09" "q-334214/selection/39adf08bf199c6dd2897d2b271bae0248a9ac39b6b4e15c9aa945be67e83d4bb"] :db/ensure [:answer-field/validate]} {:db/id "q-334214" :question/id #uuid "64c852b4-5cf9-5308-a3bf-3d121c7ebf57" :question/math-academy-id "q-334214" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-2 & -1 \\\\ 1 & -2\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].\n$$\n\n*Hint: One of the eigenvalues of the matrix is ${\\lambda }_{1}=-2+\\text{i}.$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}-2 & -1 \\\\ 1 & -2\\end{aligned}].$ \n\nWe are given that the eigenvalue is ${\\lambda }_{1}=-2+\\text{i}.$ \n\nLet's go through the process of finding the eigenvectors. For ${\\lambda }_{1}=-2+\\text{i},$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-\\text{i} & -1 \\\\ 1 & -\\text{i}\\end{aligned}]∼[\\begin{aligned}1 & -\\text{i} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=-2+\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{(-2+\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{(-2+\\text{i})t} \\\\  & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{-2t}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}\\text{i}{e}^{-2t}\\operatorname{cos}⁡t-{e}^{-2t}\\operatorname{sin}⁡t \\\\ {e}^{-2t}\\operatorname{cos}⁡t+\\text{i}{e}^{-2t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{-2t}+\\text{i}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{-2t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{-2t}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}-1 \\\\ 2\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-1 \\\\ 2\\end{aligned}] & =[\\begin{aligned}{c}_{2} \\\\ {c}_{1}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =2[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{-2t}-[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{-2t} \\\\  & =[\\begin{aligned}-\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t\\end{aligned}]{e}^{-2t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334214/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b1633293-c176-5bfe-8fa9-cfd872ceca26"] :knowledge-point/questions ["q-334214"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334226/selection/1f117e2071b2f2b441b9c70cc0612eb0f93a6eb198610606474594d1574d753b" :answer/id #uuid "1387da82-63aa-5399-bb0e-f3b38c6277fe" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t)-10\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-3\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-334226/selection/c4160fc85b7f7368e7773d418126744986157284911198c333c57146f58ade30" :answer/id #uuid "14be500f-2827-5b4c-b9ad-2c81336f0202" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-5\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-334226/selection/4dd2f69138cabc10d01859cc825ee682fab7606c1432e702e5f54e7c5949a655" :answer/id #uuid "9e9f50ad-404f-59a6-b175-265488098e20" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)+8\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-334226/selection/d91fc8f1486cbc6122660977f69b9bfff0eece5e8186e4bb51393cf47e5605d9" :answer/id #uuid "7b6b1397-0803-59ae-a01f-821c9f2c4698" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t)-8\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-334226/selection/64a1d21c8a505467630c169fb50c97c8d54f0ebf80d1c46ebabb2fb985ba2b38" :answer/id #uuid "e9095dfa-c9d5-5aad-b15a-477d3ac1bc34" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-334226/selection" :answer-field/id #uuid "43fb31b0-1b04-50a5-a349-6e93da362218" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334226/selection/1f117e2071b2f2b441b9c70cc0612eb0f93a6eb198610606474594d1574d753b" :answer-field/choices ["q-334226/selection/1f117e2071b2f2b441b9c70cc0612eb0f93a6eb198610606474594d1574d753b" "q-334226/selection/c4160fc85b7f7368e7773d418126744986157284911198c333c57146f58ade30" "q-334226/selection/4dd2f69138cabc10d01859cc825ee682fab7606c1432e702e5f54e7c5949a655" "q-334226/selection/d91fc8f1486cbc6122660977f69b9bfff0eece5e8186e4bb51393cf47e5605d9" "q-334226/selection/64a1d21c8a505467630c169fb50c97c8d54f0ebf80d1c46ebabb2fb985ba2b38"] :db/ensure [:answer-field/validate]} {:db/id "q-334226" :question/id #uuid "ee07f5ea-042a-564e-aed4-ca57bb778d81" :question/math-academy-id "q-334226" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & -8 \\\\ 1 & -5\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].\n$$\n\n*Hint: The matrix has the eigenvalue ${\\lambda }_{1}=-3+2\\text{i}$ with the corresponding eigenvector ${v}_{1}=[\\begin{aligned}2+2\\text{i} \\\\ 1\\end{aligned}].$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}-1 & -8 \\\\ 1 & -5\\end{aligned}].$ \n\nWe are given the eigenvalue ${\\lambda }_{1}=-3+2\\text{i}$ and the corresponding eigenvector ${v}_{1}=[\\begin{aligned}2+2\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=-3+2\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}2+2\\text{i} \\\\ 1\\end{aligned}]{e}^{(-3+2\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}2+2\\text{i} \\\\ 1\\end{aligned}]{e}^{(-3+2\\text{i})t} \\\\  & =[\\begin{aligned}2+2\\text{i} \\\\ 1\\end{aligned}]{e}^{-3t}(\\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)) \\\\  & =[\\begin{aligned}2{e}^{-3t}\\operatorname{cos}⁡(2t)+2\\text{i}{e}^{-3t}\\operatorname{sin}⁡(2t)+2\\text{i}{e}^{-3t}\\operatorname{cos}⁡(2t)-2{e}^{-3t}\\operatorname{sin}⁡(2t) \\\\ {e}^{-3t}\\operatorname{cos}⁡(2t)+\\text{i}{e}^{-3t}\\operatorname{sin}⁡(2t)\\end{aligned}] \\\\  & =[\\begin{aligned}{e}^{-3t}(2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t))+\\text{i}{e}^{-3t}(2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t)) \\\\ {e}^{-3t}\\operatorname{cos}⁡(2t)+\\text{i}{e}^{-3t}\\operatorname{sin}⁡(2t)\\end{aligned}] \\\\  & =[\\begin{aligned}2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{-3t}+\\text{i}[\\begin{aligned}2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}-2 \\\\ 2\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}2 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-2 \\\\ 2\\end{aligned}] & =[\\begin{aligned}2{c}_{1}+2{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}2 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =2[\\begin{aligned}2\\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{-3t}-3[\\begin{aligned}2\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t} \\\\  & =[\\begin{aligned}-2\\operatorname{cos}⁡(2t)-10\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-3\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-334226/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b1633293-c176-5bfe-8fa9-cfd872ceca26"] :knowledge-point/questions ["q-334226"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334224/selection/02c605b99a7dd3848c7acee9f18688792ea98b176434f48eff37a24b357fb8c4" :answer/id #uuid "b7b64d48-d290-5a18-9dbf-c9813f57cca9" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-6\\operatorname{cos}⁡t \\\\ -5\\operatorname{sin}⁡t-2\\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-334224/selection/d85d42142f1c5db7fdb316a9fd02ff19e51427564033dcbe426a998a8649cf0d" :answer/id #uuid "631f1e1a-f969-5eff-88c2-88ae07b11a3f" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}3\\operatorname{sin}⁡t-6\\operatorname{cos}⁡t \\\\ 2\\operatorname{sin}⁡t-2\\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-334224/selection/040845a0389299c73b67f1d834e647a0e012de2001c2eec913c47a2779e3ba45" :answer/id #uuid "1792d260-a87f-54bb-b7fc-37cbaf1905ed" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}2\\operatorname{sin}⁡t-6\\operatorname{cos}⁡t \\\\ -2\\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-334224/selection/06671e7398f676042e4ef1ae16e9147f8c2ac1e93b152f75d0df82b38b0ca0be" :answer/id #uuid "b124e3bf-f629-524b-80fc-9edbcf48b54f" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-\\operatorname{sin}⁡t-6\\operatorname{cos}⁡t \\\\ -2\\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-334224/selection/bb59bf469d8a391b624014cde22b2c0752b47e87469813dd34f34e4e8a5dd0a5" :answer/id #uuid "a258ba24-a26c-5959-8879-f10880f53826" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-6\\operatorname{cos}⁡t \\\\ 10\\operatorname{sin}⁡t-2\\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-334224/selection" :answer-field/id #uuid "788d4082-a56e-581f-a987-56b7770c403d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334224/selection/040845a0389299c73b67f1d834e647a0e012de2001c2eec913c47a2779e3ba45" :answer-field/choices ["q-334224/selection/02c605b99a7dd3848c7acee9f18688792ea98b176434f48eff37a24b357fb8c4" "q-334224/selection/d85d42142f1c5db7fdb316a9fd02ff19e51427564033dcbe426a998a8649cf0d" "q-334224/selection/040845a0389299c73b67f1d834e647a0e012de2001c2eec913c47a2779e3ba45" "q-334224/selection/06671e7398f676042e4ef1ae16e9147f8c2ac1e93b152f75d0df82b38b0ca0be" "q-334224/selection/bb59bf469d8a391b624014cde22b2c0752b47e87469813dd34f34e4e8a5dd0a5"] :db/ensure [:answer-field/validate]} {:db/id "q-334224" :question/id #uuid "eb5e5230-b38a-5e0c-a077-5495818362fb" :question/math-academy-id "q-334224" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}5 & -10 \\\\ 1 & -1\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}-6 \\\\ -2\\end{aligned}].\n$$\n\n*Hint: The matrix has the eigenvalue ${\\lambda }_{1}=2+\\text{i}$ with the corresponding eigenvector ${v}_{1}=[\\begin{aligned}3+\\text{i} \\\\ 1\\end{aligned}].$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}5 & -10 \\\\ 1 & -1\\end{aligned}].$ \n\nWe are given the eigenvalue ${\\lambda }_{1}=2+\\text{i}$ and the corresponding eigenvector ${v}_{1}=[\\begin{aligned}3+\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=2+\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}3+\\text{i} \\\\ 1\\end{aligned}]{e}^{(2+\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}3+\\text{i} \\\\ 1\\end{aligned}]{e}^{(2+\\text{i})t} \\\\  & =[\\begin{aligned}3+\\text{i} \\\\ 1\\end{aligned}]{e}^{2t}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}3{e}^{2t}\\operatorname{cos}⁡t+\\text{i}(3{e}^{2t}\\operatorname{sin}⁡t)+\\text{i}({e}^{2t}\\operatorname{cos}⁡t)-{e}^{2t}\\operatorname{sin}⁡t \\\\ {e}^{2t}\\operatorname{cos}⁡t+\\text{i}({e}^{2t}\\operatorname{sin}⁡t)\\end{aligned}] \\\\  & =[\\begin{aligned}3{e}^{2t}\\operatorname{cos}⁡t-{e}^{2t}\\operatorname{sin}⁡t+\\text{i}(3{e}^{2t}\\operatorname{sin}⁡t+{e}^{2t}\\operatorname{cos}⁡t) \\\\ {e}^{2t}\\operatorname{cos}⁡t+\\text{i}({e}^{2t}\\operatorname{sin}⁡t)\\end{aligned}] \\\\  & =[\\begin{aligned}3\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}+\\text{i}[\\begin{aligned}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{2t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}3\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{2t}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}-6 \\\\ -2\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}3 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-6 \\\\ -2\\end{aligned}] & =[\\begin{aligned}3{c}_{1}+{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =-2[\\begin{aligned}3\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}+0[\\begin{aligned}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{2t} \\\\  & =[\\begin{aligned}2\\operatorname{sin}⁡t-6\\operatorname{cos}⁡t \\\\ -2\\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-334224/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b1633293-c176-5bfe-8fa9-cfd872ceca26"] :knowledge-point/questions ["q-334224"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334225/selection/065573db8b84c250ca56015f5ba9073000234e66ed8f51dc8be6099c719d5f6f" :answer/id #uuid "89fb594f-b3cf-5efa-b89e-97c9e8673d8d" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t-2\\operatorname{sin}⁡t\\end{aligned}]{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-334225/selection/aa8adcb43ecd657d80e3db3ce0852321eb1756a8fe0dc990851aaae74e2c2117" :answer/id #uuid "2513c26c-b1f6-55a9-a9c1-99829a57e2c5" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-334225/selection/31e070299bb223a4c3de0f640a9b93c4230ce771f81453e6bd0fdef5249580c7" :answer/id #uuid "cc99503e-5c86-51a9-8ff3-16af132b6c5b" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}3\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t\\end{aligned}]{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-334225/selection/f3179e9da34babf02a2f9fb6915127a492c740da08b56d42cdcc9e1ca701da6a" :answer/id #uuid "0fe966e8-92a2-507f-8bc2-60de21bdaeb0" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{sin}⁡t+\\operatorname{cos}⁡t\\end{aligned}]{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-334225/selection/69acfb2278d443898527a4d98f0437cc7b3dd374bc5a6512a96f4739f3aae40c" :answer/id #uuid "d0b49a0f-b7fe-51c2-8979-98b6d41875a3" :answer/type :answer.type/math :answer/value "\\text{x}(t)=[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}" :db/ensure [:answer/validate]} {:db/id "q-334225/selection" :answer-field/id #uuid "43068ed1-c078-540f-bf2d-dbb42d7d8e64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334225/selection/aa8adcb43ecd657d80e3db3ce0852321eb1756a8fe0dc990851aaae74e2c2117" :answer-field/choices ["q-334225/selection/065573db8b84c250ca56015f5ba9073000234e66ed8f51dc8be6099c719d5f6f" "q-334225/selection/aa8adcb43ecd657d80e3db3ce0852321eb1756a8fe0dc990851aaae74e2c2117" "q-334225/selection/31e070299bb223a4c3de0f640a9b93c4230ce771f81453e6bd0fdef5249580c7" "q-334225/selection/f3179e9da34babf02a2f9fb6915127a492c740da08b56d42cdcc9e1ca701da6a" "q-334225/selection/69acfb2278d443898527a4d98f0437cc7b3dd374bc5a6512a96f4739f3aae40c"] :db/ensure [:answer-field/validate]} {:db/id "q-334225" :question/id #uuid "49fdff55-2b59-5c9d-8ddb-e7f7a199ced4" :question/math-academy-id "q-334225" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}0 \\\\ 1\\end{aligned}]\n$$\n\n*Hint: One of the eigenvalues of the matrix is ${\\lambda }_{1}=1+\\text{i}.$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix $A=[\\begin{aligned}1 & 1 \\\\ -1 & 1\\end{aligned}].$ \n\nWe are given that the eigenvalue is ${\\lambda }_{1}=1+\\text{i}.$ \n\nLet's go through the process of finding the eigenvectors. For ${\\lambda }_{1}=1+\\text{i},$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-\\text{i} & 1 \\\\ -1 & -\\text{i}\\end{aligned}]∼[\\begin{aligned}1 & \\text{i} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}].$\n\n**Note:** The eigenvector corresponding to the second eigenvalue ${\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}$ is \n${v}_{2}={\\overset{―}{v}}_{1}.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue ${\\lambda }_{1}=1+\\text{i}$ and its associated eigenvector is\n\n$$\n{x}_{1}(t)=[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}]{e}^{(1+\\text{i})t}.\n$$\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}]{e}^{(1+\\text{i})t} \\\\  & =[\\begin{aligned}-\\text{i} \\\\ 1\\end{aligned}]{e}^{t}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}-\\text{i}{e}^{t}\\operatorname{cos}⁡t+{e}^{t}\\operatorname{sin}⁡t \\\\ {e}^{t}\\operatorname{cos}⁡t+\\text{i}{e}^{t}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}+\\text{i}[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors ${w}_{1}$ and ${w}_{2}$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{t}.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}-1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 1\\end{aligned}] & =[\\begin{aligned}-{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =1[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}+0[\\begin{aligned}-\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{t} \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334225/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b1633293-c176-5bfe-8fa9-cfd872ceca26"] :knowledge-point/questions ["q-334225"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7043"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/1ee7ef0a95e618121f4e0653c6beaa64248682ab524ecee8903acec89827e77d.png)\nConsider the system of linear differential equations above.\nFind the unknown function $f(t)$ in the general solution to the system, shown below.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/031dd658d772ef4184ceb173311102f64bd0ff3ff5e34321ad4648e0d5026383.png)\n\n*Hint: The matrix has the eigenvalue $\\lambda_1 = \\textrm{i}$ with the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/d82f994f6426a091fb6fc46b2b2b6fbc66d0b94e7ed1ead3e67257292f4c985b.png)*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/b1ba76ba62019524549b4bcf4c36ec2440b2db8f585150a9456218972363a215.png) \n\nWe are given the eigenvalue $\\lambda_1 = \\textrm{i}$ and the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/f86bdf3e241a51548f8c58fe739e11071197944f5fe2361f83bb34408333211c.png)\n\n**Note:** The eigenvector corresponding to the second eigenvalue $\\lambda_2 = \\overline{\\lambda}_1$ is \n$\\mathbf{v}_2 = \\overline{\\mathbf{v}}_1.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue $\\lambda_1 = \\textrm{i}$ and its associated eigenvector is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/9b2628d7d3c88303bdd7ed2a8aadcdcfe751a01d910f64972a60cc080d039181.png)\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}1+\\text{i} \\\\ 2\\end{aligned}]{e}^{\\text{i}t} \\\\  & =[\\begin{aligned}1+\\text{i} \\\\ 2\\end{aligned}]\\cdot (\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t+\\text{i}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t+2\\text{i}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)+\\text{i}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t) \\\\ 2\\operatorname{cos}⁡t+2\\text{i}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{aligned}]+\\text{i}[\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ 2\\operatorname{sin}⁡t\\end{aligned}] \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors $\\mathbf w_1$ and $\\mathbf w_2$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ 2\\operatorname{cos}⁡t\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t \\\\ 2\\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$\n\nFinally, $f(t) = \\cos{t} + \\sin{t}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7044"] :question/problem "Solve the initial value problem\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/4d932848b1d30448dd0135bc75ded935f2065037d4964423899013a47c7a526a.png)\n*Hint: The matrix has the eigenvalue $\\lambda_1 = 2\\textrm{i}$ with the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/a474b7882cfa32e343d1781a731a4eb540994f72730320d7b8a61639e7e86a14.png)*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/60dd7b0b483c745b0ffda2c89d3216ab463cab5870f91b58b54c7f8e4e446cfd.png)\n\nWe are given the eigenvalue $\\lambda_1 = 2\\textrm{i}$ and the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/9e4e860107360ac18ce72e7f4f07dbf9106de041dea3b6c9228cc30bc45c714e.png)\n\n**Note:** The eigenvector corresponding to the second eigenvalue $\\lambda_2 = \\overline{\\lambda}_1$ is \n$\\mathbf{v}_2 = \\overline{\\mathbf{v}}_1.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue $\\lambda_1 = 2\\textrm{i}$ and its associated eigenvector is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/175d9bde8dda1bfb3a653521add06d23944d72019c0718eed6407abe97f2e87c.png)\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}1+\\text{i} \\\\ 1\\end{aligned}]{e}^{2\\text{i}t} \\\\  & =[\\begin{aligned}1+\\text{i} \\\\ 1\\end{aligned}](\\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)+\\text{i}\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)\\end{aligned}] \\\\  & =[\\begin{aligned}(\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t))+\\text{i}(\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t)) \\\\ \\operatorname{cos}⁡(2t)+\\text{i}\\operatorname{sin}⁡(2t)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]+\\text{i}[\\begin{aligned}\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}] \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors $\\mathbf w_1$ and $\\mathbf w_2$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}].\\end{aligned}\n$$\n\nNow, we need to find the values of $c_1$ and $c_2$ using the initial condition ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/12f33df5f036901c6069ee03a9ba8ccb05cde1071b7add3d1b310da12bb8298d.png) Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-1 \\\\ 1\\end{aligned}] & =[\\begin{aligned}{c}_{1}+{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =1[\\begin{aligned}\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]-2[\\begin{aligned}\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}] \\\\  & =[\\begin{aligned}-\\operatorname{cos}⁡(2t)-3\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)-2\\operatorname{sin}⁡(2t)\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7045"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/ae6acacc8b2c54be234e536c373c40f4b5b53646fe6091181672c06e437f5366.png)\n\nConsider the system of linear differential equations above.\nFind the unknown function $f(t)$ in the general solution to the system, shown below.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/14c8e142a4fc541b8da91c6bcd1c8517451b436b7f8c677bfb239ca4bfa79588.png)\n\n*Hint: One of the eigenvalues of the matrix is $\\lambda_1=1+\\textrm{i}.$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/471ff0aa856363c49a494f0e711dec8558b429261ddd99685bd0a19416264d05.png) \n\nWe are given that the eigenvalue is $\\lambda_1=1+\\textrm{i}.$ \n\nLet's go through the process of finding the eigenvectors. For $\\lambda_1 =1+\\textrm{i},$ we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/9fbccda402b330b568828c47040f1867c0b075ff434f6d94c2d5d5bcea85f4a8.png)\nSo, we get an eigenvector \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/91e10c00aed02305fdb5afd421aad57fe52143e3305d84da00819e62f2b30a14.png)\n\n**Note:** The eigenvector corresponding to the second eigenvalue $\\lambda_2 = \\overline{\\lambda}_1$ is \n$\\mathbf{v}_2 = \\overline{\\mathbf{v}}_1.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue $\\lambda_1 = 1+\\textrm{i}$ and its associated eigenvector is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/2ccc9c4cb7dd95e168690c017e8fca6f92315d1759b3e3ec6bb3a82551b39e3c.png)\n\nWe now separate this solution into its real and imaginary parts. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{(1+\\text{i})t} \\\\  & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{t}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}\\text{i}({e}^{t}\\operatorname{cos}⁡t)-{e}^{t}\\operatorname{sin}⁡t\\text{ } \\\\ {e}^{t}\\operatorname{cos}⁡t+\\text{i}({e}^{t}\\operatorname{sin}⁡t)\\end{aligned}] \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}+\\text{i}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors $\\mathbf w_1$ and $\\mathbf w_2$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{t}.\\end{aligned}\n$$\n\nFinally, $f(t) = \\cos{t}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7046"] :question/problem "Solve the initial value problem\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/082bb18706b8bae20dbc5b8531829f3b8523d9262c2fd0f7c4be78a3b2ef4ebb.png)\n\n*Hint: One of the eigenvalues of the matrix is $\\lambda_1=3+\\textrm{i}.$*" :question/worked-solution "We need to find the eigenvalues and associated eigenvectors of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/657dced55da3afc2c15487267793aaf282e8c258ca5e7556bacecff58a496d82.png) \n\nWe are given that the eigenvalue is $\\lambda_1=3+\\textrm{i}.$ \n\nLet's go through the process of finding the eigenvectors. For $\\lambda_1 =3+\\textrm{i},$ we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/9fbccda402b330b568828c47040f1867c0b075ff434f6d94c2d5d5bcea85f4a8.png)\nSo, we get an eigenvector \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/5d9c13b213c1e44a755000997c61f5ba5a3c91159eb7a5e6a574acf34019efab.png)\n\n**Note:** The eigenvector corresponding to the second eigenvalue $\\lambda_2 = \\overline{\\lambda}_1$ is \n$\\mathbf{v}_2 = \\overline{\\mathbf{v}}_1.$ But we do not require this eigenvector for solving our system.\n\nThe solution that we obtain for the eigenvalue $\\lambda_1 = 3 + \\textrm{i}$ and its associated eigenvector is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/38fd775722fd8ce56abb0f09499bb0a268ae73b9483a182d4564381557d190cf.png)\n\nWe now express this as a real function. Using Euler's formula, we obtain\n\n$$\n\\begin{aligned}{x}_{1}(t) & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{(3+\\text{i})t} \\\\  & =[\\begin{aligned}\\text{i} \\\\ 1\\end{aligned}]{e}^{3t}(\\operatorname{cos}⁡t+\\text{i}\\operatorname{sin}⁡t) \\\\  & =[\\begin{aligned}\\text{i}({e}^{3t}\\operatorname{cos}⁡t)-{e}^{3t}\\operatorname{sin}⁡t \\\\ {e}^{3t}\\operatorname{cos}⁡t+\\text{i}({e}^{3t}\\operatorname{sin}⁡t)\\end{aligned}] \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}+\\text{i}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{3t} \\\\  & ={\\text{w}}_{1}(t)+\\text{i}{\\text{w}}_{2}(t).\\end{aligned}\n$$\n\nThe vectors $\\mathbf w_1$ and $\\mathbf w_2$ are linearly independent. Therefore, the general solution of the system is\n\n$$\n\\begin{aligned}\\text{x}(t) & ={c}_{1}{\\text{w}}_{1}(t)+{c}_{2}{\\text{w}}_{2}(t) \\\\  & ={c}_{1}[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{3t}.\\end{aligned}\n$$\n\nNow, we need to find the values of $c_1$ and $c_2$ using the initial condition ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068029/assets/f2282999a9f221bd9a14118c116c573f82521e6140d24b008b6fea04c5a61fcf.png) Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & ={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-3 \\\\ 1\\end{aligned}] & =[\\begin{aligned}{c}_{2} \\\\ {c}_{1}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =1[\\begin{aligned}-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]{e}^{3t}-3[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]{e}^{3t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡t-3\\operatorname{cos}⁡t \\\\ \\operatorname{cos}⁡t-3\\operatorname{sin}⁡t\\end{aligned}]{e}^{3t}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
