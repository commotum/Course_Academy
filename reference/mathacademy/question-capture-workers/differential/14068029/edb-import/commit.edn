operatorname{cos}⁡(2t)-10\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-3\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}.\\end{aligned}\n$$" 13194139535586 true] [17592186356322 1000 #edb/ref 17592186356323 13194139535586 true] [17592186356322 1000 #edb/ref 17592186356324 13194139535586 true] [17592186356322 1000 #edb/ref 17592186356325 13194139535586 true] [17592186356322 1000 #edb/ref 17592186356326 13194139535586 true] [17592186356322 1000 #edb/ref 17592186356327 13194139535586 true] [17592186356322 1040 #edb/ref 17592186045450 13194139535586 true] [17592186356322 1041 "selection" 13194139535586 true] [17592186356322 1104 #edb/ref 17592186356323 13194139535586 true] [17592186356322 1110 #uuid "43fb31b0-1b04-50a5-a349-6e93da362218" 13194139535586 true] [17592186356323 1034 "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t)-10\\operatorname{sin}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-3\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}" 13194139535586 true] [17592186356323 1103 #edb/ref 17592186045453 13194139535586 true] [17592186356323 1111 #uuid "1387da82-63aa-5399-bb0e-f3b38c6277fe" 13194139535586 true] [17592186356324 1034 "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)+8\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}" 13194139535586 true] [17592186356324 1103 #edb/ref 17592186045453 13194139535586 true] [17592186356324 1111 #uuid "9e9f50ad-404f-59a6-b175-265488098e20" 13194139535586 true] [17592186356325 1034 "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)\\end{aligned}]{e}^{-3t}" 13194139535586 true] [17592186356325 1103 #edb/ref 17592186045453 13194139535586 true] [17592186356325 1111 #uuid "e9095dfa-c9d5-5aad-b15a-477d3ac1bc34" 13194139535586 true] [17592186356326 1034 "\\text{x}(t)=[\\begin{aligned}-2\\operatorname{cos}⁡(2t) \\\\ 2\\operatorname{cos}⁡(2t)-5\\operatorname{sin}⁡(2t)\\end{aligned}]{e}^{-3t}" 13194139535586 true] [17592186356326 1103 #edb/ref 1759218