^{0}+C \\\\ 2 & =3+C \\\\ C & =-1.\\end{aligned}\n$$\n\nFinally, the velocity $v$ of the particle at time $t$ is $v(t)=3{e}^{-2t}-1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81707/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1"] :knowledge-point/questions ["q-81707"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351059/field-1/671723d87f1a67d9aa6a1f954b934e271d81eedfb75a65037fca3403ebebfd96" :answer/id #uuid "53889ee7-a32d-5434-9ef1-9d07b54f4176" :answer/type :answer.type/math :answer/value "\\frac{13}{2}" :db/ensure [:answer/validate]} {:db/id "q-351059/field-1" :answer-field/id #uuid "ff3c0817-0d8f-5c20-8090-cc58dc2fd62b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351059/field-1/671723d87f1a67d9aa6a1f954b934e271d81eedfb75a65037fca3403ebebfd96" :answer-field/choices ["q-351059/field-1/671723d87f1a67d9aa6a1f954b934e271d81eedfb75a65037fca3403ebebfd96"] :db/ensure [:answer-field/validate]} {:db/id "q-351059" :question/id #uuid "e592dddf-ea83-5434-96c1-24b4d0792215" :question/math-academy-id "q-351059" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration $a(t)=\\frac{3}{\\sqrt{t+1}},$ where $a(t)$ is measured in ${\\text{ft/s}}^{2}$ and $t$ is measured in seconds. Find the speed of the particle at the moment $t=3\\,\\text{s}$ given that the particle has velocity $v=\\frac{1}{2}\\,\\text{ft/s}$ when $t=0\\,\\text{s}.$\n\nThe speed at the moment $t=3\\,\\text{s}$ is\n{{field-1}} $\\,\\text{ft/s}.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\frac{3}{\\sqrt{t+1}}\\,\\text{d}t \\\\  & =6\\sqrt{t+1}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=\\frac{1}{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\frac{1}{2} & =6\\sqrt{0+1}+C \\\\ \\frac{1}{2} & =6+C \\\\ C & =-\\frac{11}{2}.\\end{aligned}\n$$\n\nTherefore, the velocity $v$ of the particle at time $t$ is $v(t)=6\\sqrt{t+1}-\\frac{11}{2}.$\n\nWe evaluate the velocity at time $t=3\\,\\text{s}:$\n\n$$\n\\begin{aligned}v(3) & =6\\sqrt{3+1}-\\frac{11}{2} \\\\  & =6(2)-\\frac{11}{2} \\\\  & =\\frac{24}{2}-\\frac{11}{2} \\\\  & =\\frac{13}{2}\\,\\text{ft/s}\\end{aligned}\n$$\n\nFinally, since the speed is equal to $|v(t)|,$ we conclude that the speed of the particle is $\\frac{13}{2}\\,\\text{ft/s}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351059/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1"] :knowledge-point/questions ["q-351059"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102745/selection/beb9e39a9112594b7e7eebc668d7e76096bbfe0b16880ceb98ea7e606d3f3e30" :answer/id #uuid "7b3875fb-4aaf-56d2-a417-e88de58e0da4" :answer/type :answer.type/math :answer/value "v(t)=-\\frac{1}{t+1}+1" :db/ensure [:answer/validate]} {:db/id "q-102745/selection/20c61b3543c7bcbfc3a68721590b15e5d633be854e0f818ee90d601806404f20" :answer/id #uuid "9faa52b1-9fe4-5577-9249-1fddaeae00cc" :answer/type :answer.type/math :answer/value "v(t)=-\\frac{1}{t+1}+2" :db/ensure [:answer/validate]} {:db/id "q-102745/selection/0a9bdb3a87cb2bb2fa06a82dacfa44d19ceedb0b8376dda3b751ce5470d8c550" :answer/id #uuid "767a7240-b523-5fca-81da-e6c8ec3f76f1" :answer/type :answer.type/math :answer/value "v(t)=\\frac{2}{t+1}" :db/ensure [:answer/validate]} {:db/id "q-102745/selection/4d0a4d4f85d04e3e9aae73cb9f5802294c1e6bba25cc59e52ba582b94b97a562" :answer/id #uuid "6cfb5a46-1fe1-5b68-8709-706ac8fa98c2" :answer/type :answer.type/math :answer/value "v(t)=\\frac{1}{t+1}" :db/ensure [:answer/validate]} {:db/id "q-102745/selection/c8c69ec2d5631044fb9b72b531603f4fc4219f9eb2eb7ded773bbe69228d9a59" :answer/id #uuid "432e462d-e1c1-5eda-91a7-e998943a1692" :answer/type :answer.type/math :answer/value "v(t)=-\\frac{1}{t+1}-2" :db/ensure [:answer/validate]} {:db/id "q-102745/selection" :answer-field/id #uuid "e1d051e3-5483-5035-ad12-b6f17449c8db" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102745/selection/20c61b3543c7bcbfc3a68721590b15e5d633be854e0f818ee90d601806404f20" :answer-field/choices ["q-102745/selection/beb9e39a9112594b7e7eebc668d7e76096bbfe0b16880ceb98ea7e606d3f3e30" "q-102745/selection/20c61b3543c7bcbfc3a68721590b15e5d633be854e0f818ee90d601806404f20" "q-102745/selection/0a9bdb3a87cb2bb2fa06a82dacfa44d19ceedb0b8376dda3b751ce5470d8c550" "q-102745/selection/4d0a4d4f85d04e3e9aae73cb9f5802294c1e6bba25cc59e52ba582b94b97a562" "q-102745/selection/c8c69ec2d5631044fb9b72b531603f4fc4219f9eb2eb7ded773bbe69228d9a59"] :db/ensure [:answer-field/validate]} {:db/id "q-102745" :question/id #uuid "9071dddd-e988-518c-b0c1-0a51bb716b1f" :question/math-academy-id "q-102745" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=\\frac{1}{(t+1)^{2}}$, where $t$ is the time in seconds. If the particle has a velocity $v=1$ when $t=0\\,\\text{s}$, find the velocity (in $\\text{m/s}$)  of the particle at time $t.$" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\frac{1}{(t+1)^{2}}\\,\\text{d}t \\\\  & =-\\frac{1}{t+1}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(0)=1.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}1 & =-\\frac{1}{0+1}+C \\\\ 1 & =-1+C \\\\ C & =2.\\end{aligned}\n$$\n\nFinally, the velocity $v$ of the particle at time $t$ is $v(t)=-\\frac{1}{t+1}+2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102745/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1"] :knowledge-point/questions ["q-102745"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346897/field-1/4a9a134cdddd1a2e576e261995b5d5809aebebf33ee9f8cbc7ef8e1d48f31558" :answer/id #uuid "e940ff3e-9444-56f1-8766-f00d48882745" :answer/type :answer.type/math :answer/value "2\\sqrt{t+1}-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-346897/field-1" :answer-field/id #uuid "9db53bbf-d2a6-53a8-a7ea-d01da555949b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346897/field-1/4a9a134cdddd1a2e576e261995b5d5809aebebf33ee9f8cbc7ef8e1d48f31558" :answer-field/choices ["q-346897/field-1/4a9a134cdddd1a2e576e261995b5d5809aebebf33ee9f8cbc7ef8e1d48f31558"] :db/ensure [:answer-field/validate]} {:db/id "q-346897" :question/id #uuid "a7fc604a-edbe-5f86-a637-ad6fc81aa79c" :question/math-academy-id "q-346897" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in ${\\text{m/s}}^{2},$ given by the function $a(t)=\\frac{1}{\\sqrt{t+1}},$ where $t>0$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{m/s}$) of the particle at time $t$ given that the particle has velocity $v=\\sqrt{2}\\,\\text{m/s}$ when $t=1\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\,\\text{d}t \\\\  & =\\int \\frac{1}{\\sqrt{t+1}}\\,\\text{d}t \\\\  & =\\int (t+1)^{-1/2}\\,\\text{d}t \\\\  & =2(t+1)^{1/2}+C \\\\  & =2\\sqrt{t+1}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(1)=\\sqrt{2}.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}\\sqrt{2} & =2\\sqrt{1+1}+C \\\\ \\sqrt{2} & =2\\sqrt{2}+C \\\\ C & =\\sqrt{2}-2\\sqrt{2} \\\\ C & =-\\sqrt{2}.\\end{aligned}\n$$\n\nFinally, the velocity $v$ of the particle at time $t$ is $v(t)=2\\sqrt{t+1}-\\sqrt{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-346897/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f20159e8-8f86-5bf8-b87e-3eb990b819f1"] :knowledge-point/questions ["q-346897"] :db/ensure [:knowledge-point/validate]}]
