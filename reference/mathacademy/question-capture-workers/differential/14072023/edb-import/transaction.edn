9c2f456750b489" "q-340628/field-2/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" "q-340628/field-2/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-340628/field-2/167ebf11c001034e2cbb5c82fd03c6c789b33fae94a34649b1567e72676329e0"] :db/ensure [:answer-field/validate]} {:db/id "q-340628/field-3/fad6a10c400af7c9fed59967193a238671e388be6bbbc6a736f3e007b44f97f3" :answer/id #uuid "62662e92-d5bd-5319-9c3c-2bad4d39f6bc" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340628/field-3/b5a1dd28dd28a04f0a5953d900fb524f7434271c4699dfc0f8943d43816d9780" :answer/id #uuid "e7b6a18d-9a88-560e-af38-201dbd3a4b0f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340628/field-3/3752d4aecdbd91754b9e2c8c0e15fde1a301b78c8b8b44b09c639d41fd9a4748" :answer/id #uuid "76def3ee-e247-54b4-8ab4-92195747dc16" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\infty }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340628/field-3/660f82d13ccecc1e82d88dc40a10c0eb11868e15f7dd1d417ace1302e18f2506" :answer/id #uuid "d709efcf-827b-5b9d-8799-840d782550e8" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340628/field-3/0d08b911d8fbafd2163420ee691064c866f01707a04e0bc9b1ab19138aa7d38f" :answer/id #uuid "740f092f-ddf7-5649-971c-711b210c2039" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340628/field-3/8f04d4858d62ea93c93b3bedb7af5d699d764537c221572c05d9157f775492bf" :answer/id #uuid "c2cd738f-f4a7-5a05-adbf-a58518371b39" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-340628/field-3" :answer-field/id #uuid "d9ab3e40-1f9a-5c9b-890e-284d207434ab" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-340628/field-3/660f82d13ccecc1e82d88dc40a10c0eb11868e15f7dd1d417ace1302e18f2506" :answer-field/choices ["q-340628/field-3/fad6a10c400af7c9fed59967193a238671e388be6bbbc6a736f3e007b44f97f3" "q-340628/field-3/b5a1dd28dd28a04f0a5953d900fb524f7434271c4699dfc0f8943d43816d9780" "q-340628/field-3/3752d4aecdbd91754b9e2c8c0e15fde1a301b78c8b8b44b09c639d41fd9a4748" "q-340628/field-3/660f82d13ccecc1e82d88dc40a10c0eb11868e15f7dd1d417ace1302e18f2506" "q-340628/field-3/0d08b911d8fbafd2163420ee691064c866f01707a04e0bc9b1ab19138aa7d38f" "q-340628/field-3/8f04d4858d62ea93c93b3bedb7af5d699d764537c221572c05d9157f775492bf"] :db/ensure [:answer-field/validate]} {:db/id "q-340628" :question/id #uuid "343a6182-7115-5e27-a302-023217925f51" :question/math-academy-id "q-340628" :question/problem "Let $F(x)={x}^{2}+3$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{3}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{a}_{3} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that is piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(3x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(3x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(3x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(3x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(3x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{3}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩ & ={\\int }_{-\\pi }^{\\pi }{cos}^{2}⁡(3x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))+\\frac{1}{12}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(-6\\pi )) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(3x)⟩ & ={a}_{3}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩ \\\\ {a}_{3} & =\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩} \\\\ {a}_{3} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340628/field-1" "q-340628/field-2" "q-340628/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604"] :knowledge-point/questions ["q-340628"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340675/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "b2f46f60-5dbc-54eb-ba17-e874341cb2c7" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-340675/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "bb60d679-5e93-5d4a-b979-452580cc6902" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-340675/field-1/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "e9f48fe2-32be-5a3c-a2d0-795aeb02815b" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-340675/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6fe65e15-602e-50ae-a84a-9cda693f598e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-340675/field-1/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "6d0bc23c-30ea-51e0-b44e-6c3a1e48e5ba" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-340675/field-1" :answer-field/id #uuid "a3398d44-7dbe-50cb-8b6e-4854309c2f62" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-340675/field-1/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer-field/choices ["q-340675/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-340675/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-340675/field-1/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" "q-340675/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-340675/field-1/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b"] :db/ensure [:answer-field/validate]} {:db/id "q-340675/field-2/61bbf40bf0728127bc167767b5af83361c3acbddac67f4a51d278c010c10af58" :answer/id #uuid "8c0dea37-0fae-5871-b6ad-6d7d701a6997" :answer/type :answer.type/text :answer/value "are not orthogonal" :db/ensure [:answer/validate]} {:db/id "q-340675/field-2/45748e934ef4660a4b62ead5bf1f91dfb438725115d7289eb41fe950d2ed803d" :answer/id #uuid "209f1a48-3dee-56cd-a02f-304c0d703886" :answer/type :answer.type/text :answer/value "are orthogonal" :db/ensure [:answer/validate]} {:db/id "q-340675/field-2" :answer-field/id #uuid "9d057021-c20a-5d29-aee9-62eb2bc64717" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-340675/field-2/61bbf40bf0728127bc167767b5af83361c3acbddac67f4a51d278c010c10af58" :answer-field/choices ["q-340675/field-2/61bbf40bf0728127bc167767b5af83361c3acbddac67f4a51d278c010c10af58" "q-340675/field-2/45748e934ef4660a4b62ead5bf1f91dfb438725115d7289eb41fe950d2ed803d"] :db/ensure [:answer-field/validate]} {:db/id "q-340675" :question/id #uuid "29f219e9-01ff-5c63-a4b3-4b540c752b19" :question/math-academy-id "q-340675" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.$\\,$\n$⟨\\operatorname{cos}⁡(6x),\\operatorname{cos}⁡(6x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(6x)$ and $g(x)=\\operatorname{cos}⁡(6x)$ \n{{field-2}}." :question/worked-solution "We begin by using the half-angle identity\n\n$$\n{cos}^{2}⁡(6x)=\\frac{1}{2}(1+\\operatorname{cos}⁡(12x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(6x),\\operatorname{cos}⁡(6x)⟩ & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡(6x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(12x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{24}\\operatorname{sin}⁡(12x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)+\\frac{1}{24}(\\operatorname{sin}⁡(24\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(6x)$ and $g(x)=\\operatorname{cos}⁡(6x)$ $\\text{are not orthogonal}$ with respect to the inner product." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-340675/field-1" "q-340675/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fadf4f64-3569-56b2-98e1-f6681892054a"] :knowledge-point/questions ["q-340675"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340678/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "f87f4d5d-1103-52ef-ac9e-827695b4bc09" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-340678/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "eaa0fa93-eace-57d5-bb3a-8c6016477efc" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-340678/field-1/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "858c3215-6df4-5cc4-8f10-e45440ed086d" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-340678/field-1/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "d3f00b40-cacf-53e4-9e3a-7ad74c2730d7" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-340678/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "4459f6d4-ea45-586b-87c3-19ac0642347d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-340678/field-1" :answer-field/id #uuid "deaa6c49-64d7-58c0-b03b-ccfa30ccb1e4" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-340678/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-340678/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-340678/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-340678/field-1/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-340678/field-1/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" "q-340678/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-340678/field-2/45748e934ef4660a4b62ead5bf1f91dfb438725115d7289eb41fe950d2ed803d" :answer/id #uuid "bf5089e5-8ab5-5a24-b671-8e677aed42ac" :answer/type :answer.type/text :answer/value "are orthogonal" :db/ensure [:answer/validate]} {:db/id "q-340678/field-2/61bbf40bf0728127bc167767b5af83361c3acbddac67f4a51d278c010c10af58" :answer/id #uuid "b2179c06-47e9-593a-8236-1088b4a503f4" :answer/type :answer.type/text :answer/value "are not orthogonal" :db/ensure [:answer/validate]} {:db/id "q-340678/field-2" :answer-field/id #uuid "01b6ffba-434f-59db-8616-65b078cd7d45" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-340678/field-2/45748e934ef4660a4b62ead5bf1f91dfb438725115d7289eb41fe950d2ed803d" :answer-field/choices ["q-340678/field-2/45748e934ef4660a4b62ead5bf1f91dfb438725115d7289eb41fe950d2ed803d" "q-340678/field-2/61bbf40bf0728127bc167767b5af83361c3acbddac67f4a51d278c010c10af58"] :db/ensure [:answer-field/validate]} {:db/id "q-340678" :question/id #uuid "ee385592-804f-5fa3-87ef-fe7a852ef8fd" :question/math-academy-id "q-340678" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.$\\,$\n$⟨\\operatorname{cos}⁡(2x),\\operatorname{cos}⁡(7x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(7x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{cos}⁡(2x)\\operatorname{cos}⁡(7x)=\\frac{1}{2}(\\operatorname{cos}⁡(5x)+\\operatorname{cos}⁡(9x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(2x),\\operatorname{cos}⁡(7x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2x)\\operatorname{cos}⁡(7x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{cos}⁡(5x)+\\frac{1}{2}\\operatorname{cos}⁡(9x)\\,\\text{d}x \\\\  & ={[\\frac{1}{10}\\operatorname{sin}⁡(5x)+\\frac{1}{18}\\operatorname{sin}⁡(9x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{10}(\\operatorname{sin}⁡(10\\pi )-\\operatorname{sin}⁡(0))+\\frac{1}{18}(\\operatorname{sin}⁡(18\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{10}(0-0)+\\frac{1}{18}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(7x)$ $\\text{are orthogonal}$ with respect to the inner product." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-340678/field-1" "q-340678/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fadf4f64-3569-56b2-98e1-f6681892054a"] :knowledge-point/questions ["q-340678"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341308/field-1/ee8f51f8de97c712111243f989ef2929bd14a15753480d316a98ef9da4ecc1ca" :answer/id #uuid "49053cdc-ee48-50a3-8c76-1cf23e7af8a6" :answer/type :answer.type/math :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/ensure [:answer/validate]} {:db/id "q-341308/field-1/f7403f6eb802785afdec6495efd96521e1f3f038e252c23af16c3565311efdc0" :answer/id #uuid "e6921394-812f-586d-9385-592971481a65" :answer/type :answer.type/math :answer/value "\\frac{⟨1,1⟩}{⟨f(x),1⟩}" :db/ensure [:answer/validate]} {:db/id "q-341308/field-1/3f4ac37971f00eead06694aa71f9cbcfaf9065005c7cf75ed97a13a90356ff24" :answer/id #uuid "6b8a6c1e-2c19-5e22-baa8-6e93dfa4821f" :answer/type :answer.type/math :answer/value "\\frac{⟨f(x),1⟩}{⟨1,1⟩}" :db/ensure [:answer/validate]} {:db/id "q-341308/field-1/01ead8253f26db744369c0ee0a10ccde3064b560f7d8dbf95f0e2151f8586fd1" :answer/id #uuid "4b00fe12-7db4-561b-be4d-049b1e4a891a" :answer/type :answer.type/math :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/ensure [:answer/validate]} {:db/id "q-341308/field-1/808fa46739c1202a0150843e269951816b496dece9704c17e07f1f61b9a5f26f" :answer/id #uuid "f9bca7f6-a15c-5c88-a6ee-f75587a795bf" :answer/type :answer.type/math :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/ensure [:answer/validate]} {:db/id "q-341308/field-1" :answer-field/id #uuid "6d8144bd-9813-5415-ba48-56c93fbe2d11" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-341308/field-1/808fa46739c1202a0150843e269951816b496dece9704c17e07f1f61b9a5f26f" :answer-field/choices ["q-341308/field-1/ee8f51f8de97c712111243f989ef2929bd14a15753480d316a98ef9da4ecc1ca" "q-341308/field-1/f7403f6eb802785afdec6495efd96521e1f3f038e252c23af16c3565311efdc0" "q-341308/field-1/3f4ac37971f00eead06694aa71f9cbcfaf9065005c7cf75ed97a13a90356ff24" "q-341308/field-1/01ead8253f26db744369c0ee0a10ccde3064b560f7d8dbf95f0e2151f8586fd1" "q-341308/field-1/808fa46739c1202a0150843e269951816b496dece9704c17e07f1f61b9a5f26f"] :db/ensure [:answer-field/validate]} {:db/id "q-341308/field-2/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "a542600d-1886-531b-a0df-2209bcb29d1b" :answer/type :answer.type/math :answer/value "\\fra