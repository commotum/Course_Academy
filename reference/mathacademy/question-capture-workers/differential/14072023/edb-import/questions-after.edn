#{[{:db/id #edb/ref 17592186374093 :knowledge-point/_questions [{:knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c7d8b42-e19d-5039-84bf-5898a99158f0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩}" :db/id #edb/ref 17592186374095} {:answer/id #uuid "8357f3b7-1498-5605-8849-2106401fe69e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(3x)⟩}{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩}" :db/id #edb/ref 17592186374096} {:answer/id #uuid "8fc361f5-7214-5f98-9680-d777eef3109f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩}" :db/id #edb/ref 17592186374097} {:answer/id #uuid "7e2d6348-6bd4-5940-b5e2-94ecbe8182bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩}{⟨f(x),\\operatorname{cos}⁡(3x)⟩}" :db/id #edb/ref 17592186374098} {:answer/id #uuid "e082e3b6-0d8d-5b05-a459-e60181a60ddd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨\\operatorname{sin}⁡(3x),\\operatorname{sin}⁡(3x)⟩}{⟨f(x),\\operatorname{cos}⁡(3x)⟩}" :db/id #edb/ref 17592186374099}] :answer-field/correct {:answer/id #uuid "8fc361f5-7214-5f98-9680-d777eef3109f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩}" :db/id #edb/ref 17592186374097} :answer-field/id #uuid "e002da2f-d308-571c-8ca0-8f8495b1def5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374094} {:answer-field/choices [{:answer/id #uuid "4dcde97f-67ab-5921-baa4-cdfa19b3f09a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186374101} {:answer/id #uuid "6a4e41d9-0a90-5d7d-8814-e2c889b21253" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186374102} {:answer/id #uuid "c99298fe-d5fc-5826-93e8-f8608944a87d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186374103} {:answer/id #uuid "4c09e3a0-1797-54bd-a00d-566fc28d6696" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186374104} {:answer/id #uuid "8f0e23dd-e5fd-5897-bce1-98db8bfe3437" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186374105}] :answer-field/correct {:answer/id #uuid "4c09e3a0-1797-54bd-a00d-566fc28d6696" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186374104} :answer-field/id #uuid "10bd3885-79ee-58af-9614-059772165a6c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374100} {:answer-field/choices [{:answer/id #uuid "740f092f-ddf7-5649-971c-711b210c2039" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186374107} {:answer/id #uuid "76def3ee-e247-54b4-8ab4-92195747dc16" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186374108} {:answer/id #uuid "d709efcf-827b-5b9d-8799-840d782550e8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186374109} {:answer/id #uuid "c2cd738f-f4a7-5a05-adbf-a58518371b39" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186374110} {:answer/id #uuid "e7b6a18d-9a88-560e-af38-201dbd3a4b0f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186374111} {:answer/id #uuid "62662e92-d5bd-5319-9c3c-2bad4d39f6bc" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{2}+3)\\operatorname{sin}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186374112}] :answer-field/correct {:answer/id #uuid "d709efcf-827b-5b9d-8799-840d782550e8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x" :db/id #edb/ref 17592186374109} :answer-field/id #uuid "d9ab3e40-1f9a-5c9b-890e-284d207434ab" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374106}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "343a6182-7115-5e27-a302-023217925f51" :question/math-academy-id "q-340628" :question/problem "Let $F(x)={x}^{2}+3$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [-\\pi ,\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{3}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[-\\pi ,\\pi ).$\n\n$$\n\\begin{aligned}{a}_{3} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [-\\pi ,\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{-\\pi }^{\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that is piecewise continuous over $x\\in [-\\pi ,\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $\\operatorname{cos}⁡(3x):$\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(3x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\\operatorname{cos}⁡(3x)⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(3x)⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),\\operatorname{cos}⁡(3x)⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),\\operatorname{cos}⁡(3x)⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n{a}_{3}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩ & ={\\int }_{-\\pi }^{\\pi }{cos}^{2}⁡(3x)\\,\\text{d}x \\\\  & ={\\int }_{-\\pi }^{\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(6x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{12}\\operatorname{sin}⁡(6x)]}_{-\\pi }^{\\pi } \\\\  & =\\frac{1}{2}(\\pi -(-\\pi ))+\\frac{1}{12}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(-6\\pi )) \\\\  & =\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),\\operatorname{cos}⁡(3x)⟩ & ={a}_{3}⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩ \\\\ {a}_{3} & =\\frac{⟨f(x),\\operatorname{cos}⁡(3x)⟩}{⟨\\operatorname{cos}⁡(3x),\\operatorname{cos}⁡(3x)⟩} \\\\ {a}_{3} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{-\\pi }^{\\pi }({x}^{2}+3)\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374113 :knowledge-point/_questions [{:knowledge-point/id #uuid "fadf4f64-3569-56b2-98e1-f6681892054a" :knowledge-point/title "Checking Orthogonality of Sines and Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9f48fe2-32be-5a3c-a2d0-795aeb02815b" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186374115} {:answer/id #uuid "bb60d679-5e93-5d4a-b979-452580cc6902" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186374116} {:answer/id #uuid "6d0bc23c-30ea-51e0-b44e-6c3a1e48e5ba" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186374117} {:answer/id #uuid "6fe65e15-602e-50ae-a84a-9cda693f598e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186374118} {:answer/id #uuid "b2f46f60-5dbc-54eb-ba17-e874341cb2c7" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186374119}] :answer-field/correct {:answer/id #uuid "e9f48fe2-32be-5a3c-a2d0-795aeb02815b" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186374115} :answer-field/id #uuid "a3398d44-7dbe-50cb-8b6e-4854309c2f62" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374114} {:answer-field/choices [{:answer/id #uuid "209f1a48-3dee-56cd-a02f-304c0d703886" :answer/type {:db/ident :answer.type/text} :answer/value "are orthogonal" :db/id #edb/ref 17592186374121} {:answer/id #uuid "8c0dea37-0fae-5871-b6ad-6d7d701a6997" :answer/type {:db/ident :answer.type/text} :answer/value "are not orthogonal" :db/id #edb/ref 17592186374122}] :answer-field/correct {:answer/id #uuid "8c0dea37-0fae-5871-b6ad-6d7d701a6997" :answer/type {:db/ident :answer.type/text} :answer/value "are not orthogonal" :db/id #edb/ref 17592186374122} :answer-field/id #uuid "9d057021-c20a-5d29-aee9-62eb2bc64717" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374120}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "29f219e9-01ff-5c63-a4b3-4b540c752b19" :question/math-academy-id "q-340675" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.$\\,$\n$⟨\\operatorname{cos}⁡(6x),\\operatorname{cos}⁡(6x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(6x)$ and $g(x)=\\operatorname{cos}⁡(6x)$ \n{{field-2}}." :question/worked-solution "We begin by using the half-angle identity\n\n$$\n{cos}^{2}⁡(6x)=\\frac{1}{2}(1+\\operatorname{cos}⁡(12x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(6x),\\operatorname{cos}⁡(6x)⟩ & ={\\int }_{0}^{2\\pi }{cos}^{2}⁡(6x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}+\\frac{1}{2}\\operatorname{cos}⁡(12x)\\,\\text{d}x \\\\  & ={[\\frac{1}{2}x+\\frac{1}{24}\\operatorname{sin}⁡(12x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{2}(2\\pi -0)+\\frac{1}{24}(\\operatorname{sin}⁡(24\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\pi .\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(6x)$ and $g(x)=\\operatorname{cos}⁡(6x)$ $\\text{are not orthogonal}$ with respect to the inner product."}] [{:db/id #edb/ref 17592186374123 :knowledge-point/_questions [{:knowledge-point/id #uuid "fadf4f64-3569-56b2-98e1-f6681892054a" :knowledge-point/title "Checking Orthogonality of Sines and Cosines"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3f00b40-cacf-53e4-9e3a-7ad74c2730d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186374125} {:answer/id #uuid "f87f4d5d-1103-52ef-ac9e-827695b4bc09" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186374126} {:answer/id #uuid "858c3215-6df4-5cc4-8f10-e45440ed086d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186374127} {:answer/id #uuid "4459f6d4-ea45-586b-87c3-19ac0642347d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186374128} {:answer/id #uuid "eaa0fa93-eace-57d5-bb3a-8c6016477efc" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186374129}] :answer-field/correct {:answer/id #uuid "4459f6d4-ea45-586b-87c3-19ac0642347d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186374128} :answer-field/id #uuid "deaa6c49-64d7-58c0-b03b-ccfa30ccb1e4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374124} {:answer-field/choices [{:answer/id #uuid "bf5089e5-8ab5-5a24-b671-8e677aed42ac" :answer/type {:db/ident :answer.type/text} :answer/value "are orthogonal" :db/id #edb/ref 17592186374131} {:answer/id #uuid "b2179c06-47e9-593a-8236-1088b4a503f4" :answer/type {:db/ident :answer.type/text} :answer/value "are not orthogonal" :db/id #edb/ref 17592186374132}] :answer-field/correct {:answer/id #uuid "bf5089e5-8ab5-5a24-b671-8e677aed42ac" :answer/type {:db/ident :answer.type/text} :answer/value "are orthogonal" :db/id #edb/ref 17592186374131} :answer-field/id #uuid "01b6ffba-434f-59db-8616-65b078cd7d45" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374130}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ee385592-804f-5fa3-87ef-fe7a852ef8fd" :question/math-academy-id "q-340678" :question/problem "$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x\n$$\n\nGiven the inner product on the set of continuous functions over $x\\in [0,2\\pi )$ defined above, select the correct options below.$\\,$\n$⟨\\operatorname{cos}⁡(2x),\\operatorname{cos}⁡(7x)⟩=$\n{{field-1}}\n\n$\\,$\nThe functions $f(x)=\\operatorname{cos}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(7x)$ \n{{field-2}}." :question/worked-solution "We begin by using the product-to-sum identity\n\n$$\n\\operatorname{cos}⁡(2x)\\operatorname{cos}⁡(7x)=\\frac{1}{2}(\\operatorname{cos}⁡(5x)+\\operatorname{cos}⁡(9x)).\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}⟨\\operatorname{cos}⁡(2x),\\operatorname{cos}⁡(7x)⟩ & ={\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(2x)\\operatorname{cos}⁡(7x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}\\operatorname{cos}⁡(5x)+\\frac{1}{2}\\operatorname{cos}⁡(9x)\\,\\text{d}x \\\\  & ={[\\frac{1}{10}\\operatorname{sin}⁡(5x)+\\frac{1}{18}\\operatorname{sin}⁡(9x)]}_{0}^{2\\pi } \\\\  & =\\frac{1}{10}(\\operatorname{sin}⁡(10\\pi )-\\operatorname{sin}⁡(0))+\\frac{1}{18}(\\operatorname{sin}⁡(18\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{10}(0-0)+\\frac{1}{18}(0-0) \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, $f(x)=\\operatorname{cos}⁡(2x)$ and $g(x)=\\operatorname{cos}⁡(7x)$ $\\text{are orthogonal}$ with respect to the inner product."}] [{:db/id #edb/ref 17592186374133 :knowledge-point/_questions [{:knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b00fe12-7db4-561b-be4d-049b1e4a891a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/id #edb/ref 17592186374135} {:answer/id #uuid "6b8a6c1e-2c19-5e22-baa8-6e93dfa4821f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186374136} {:answer/id #uuid "f9bca7f6-a15c-5c88-a6ee-f75587a795bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186374137} {:answer/id #uuid "49053cdc-ee48-50a3-8c76-1cf23e7af8a6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186374138} {:answer/id #uuid "e6921394-812f-586d-9385-592971481a65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨1,1⟩}{⟨f(x),1⟩}" :db/id #edb/ref 17592186374139}] :answer-field/correct {:answer/id #uuid "f9bca7f6-a15c-5c88-a6ee-f75587a795bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186374137} :answer-field/id #uuid "6d8144bd-9813-5415-ba48-56c93fbe2d11" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374134} {:answer-field/choices [{:answer/id #uuid "34894fa4-2173-50cf-a368-ca853e4a3185" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186374141} {:answer/id #uuid "bc874a17-0747-5c61-a0b2-669aa06c550a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186374142} {:answer/id #uuid "a542600d-1886-531b-a0df-2209bcb29d1b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186374143} {:answer/id #uuid "40c56d2d-7758-5e2c-b287-f52a90786ed5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186374144} {:answer/id #uuid "c42d5b7a-1ec1-5eda-9c2b-0ebedaab7bfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186374145}] :answer-field/correct {:answer/id #uuid "c42d5b7a-1ec1-5eda-9c2b-0ebedaab7bfc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186374145} :answer-field/id #uuid "ff12bcc3-c42f-5d74-bee6-d27f33e30e37" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374140} {:answer-field/choices [{:answer/id #uuid "9b980876-cfc5-575a-8d21-f2589457115b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186374147} {:answer/id #uuid "00391d0c-d34d-5ed7-9c0a-5b394566a335" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186374148} {:answer/id #uuid "cbb694a7-a617-506d-9ab1-ca50bd0c2025" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186374149} {:answer/id #uuid "c6d6a061-82e9-5419-b645-6416c417ab5a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186374150} {:answer/id #uuid "15574010-dde5-541c-8696-8092880f5861" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186374151}] :answer-field/correct {:answer/id #uuid "15574010-dde5-541c-8696-8092880f5861" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }(3x+1)\\,\\text{d}x" :db/id #edb/ref 17592186374151} :answer-field/id #uuid "9b9948c1-dc39-5af2-a50a-28c98d07a5c5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374146}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "73b220ad-78ed-5227-b775-ed2065f7b0fd" :question/math-academy-id "q-341308" :question/problem "Let $F(x)=3x+1$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{0}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{a}_{0} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $1:$\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},1⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),1⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,1⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),1⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n\\frac{{a}_{0}}{2}⟨1,1⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{2\\pi }1\\,\\text{d}x \\\\  & ={[x]}_{-0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & =\\frac{{a}_{0}}{2}⟨1,1⟩ \\\\ {a}_{0} & =\\frac{2⟨f(x),1⟩}{⟨1,1⟩} \\\\ {a}_{0} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }(3x+1)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374152 :knowledge-point/_questions [{:knowledge-point/id #uuid "304c015d-cbb6-5989-a102-d6f0f5f38604" :knowledge-point/title "Determining Expressions For Fourier Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d11c1c1e-183e-5ad8-8fc5-6f85b3edff0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{cos}⁡(x)⟩}{⟨\\operatorname{cos}⁡(x),\\operatorname{cos}⁡(x)⟩}" :db/id #edb/ref 17592186374154} {:answer/id #uuid "20d89d5f-2371-5a24-9f90-495096655254" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186374155} {:answer/id #uuid "024863c6-206f-53d2-a893-328f932cfd4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186374156} {:answer/id #uuid "deedd464-fc68-5869-9666-3733a67c2d38" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨f(x),\\operatorname{sin}⁡(x)⟩}{⟨\\operatorname{sin}⁡(x),\\operatorname{sin}⁡(x)⟩}" :db/id #edb/ref 17592186374157} {:answer/id #uuid "a3124ac3-caa5-5098-a316-a30d9e731003" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{⟨1,1⟩}{⟨f(x),1⟩}" :db/id #edb/ref 17592186374158}] :answer-field/correct {:answer/id #uuid "024863c6-206f-53d2-a893-328f932cfd4e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2⟨f(x),1⟩}{⟨1,1⟩}" :db/id #edb/ref 17592186374156} :answer-field/id #uuid "f7ad64a1-5478-54da-8008-3f795baad089" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374153} {:answer-field/choices [{:answer/id #uuid "772a7d48-f8e9-525e-8f44-66c8cf4d57cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\pi }" :db/id #edb/ref 17592186374160} {:answer/id #uuid "2aad49d1-09b9-57a4-b0e0-5692bd68b13e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186374161} {:answer/id #uuid "26e1dc03-5bfc-58a0-9f12-14b1741d7be6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186374162} {:answer/id #uuid "2b566418-ad2e-55c5-9e58-ae1a5a9e75e8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\pi }" :db/id #edb/ref 17592186374163} {:answer/id #uuid "c83b90c9-408f-5a5e-a57e-ef1aeaa866db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186374164}] :answer-field/correct {:answer/id #uuid "c83b90c9-408f-5a5e-a57e-ef1aeaa866db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186374164} :answer-field/id #uuid "36dcd912-bde9-56f4-aa8d-64e92b01a1e4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374159} {:answer-field/choices [{:answer/id #uuid "b9b05ed7-99f2-5fe1-8b6a-eff8132536b9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\operatorname{cos}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186374166} {:answer/id #uuid "0f0f8bf5-16cf-5f6d-90d8-bb48905065b9" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186374167} {:answer/id #uuid "6025c190-b387-58a1-bdef-2bb2d224904c" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{\\infty }({x}^{3}-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186374168} {:answer/id #uuid "f9db71a0-01bd-56f9-92f8-fad491d7eff1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186374169} {:answer/id #uuid "30c62446-e043-509e-9841-e65d9d81b96d" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\operatorname{sin}⁡(x)\\,\\text{d}x" :db/id #edb/ref 17592186374170}] :answer-field/correct {:answer/id #uuid "f9db71a0-01bd-56f9-92f8-fad491d7eff1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x" :db/id #edb/ref 17592186374169} :answer-field/id #uuid "e9e59ffb-76e1-57e9-a613-63f711dd7840" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374165}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6dd6bd1a-c741-5e2c-88f0-b51905cb07d9" :question/math-academy-id "q-341309" :question/problem "Let $F(x)={x}^{3}-2{x}^{2}$ for $x\\in R,$ and let $f(x)$ be the $2\\pi $-periodic extension of $F$ from $x\\in [0,2\\pi )$ to $x\\in R.$ The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)).\n$$\n\nSelect the correct options in the expression for the coefficient ${a}_{0}$ below, where $⟨\\,,⟩$ denotes the usual inner product on functions over $[0,2\\pi ).$\n\n$$\n\\begin{aligned}{a}_{0} & ={{field-1}} \\\\  & ={{field-2}}\\,\\cdot \\,{{field-3}}\\end{aligned}\n$$" :question/worked-solution "The usual inner product of functions $f$ and $g$ over $x\\in [0,2\\pi )$ is given by\n\n$$\n⟨f(x),g(x)⟩={\\int }_{0}^{2\\pi }f(x)g(x)\\,\\text{d}x.\n$$\n\nFor a $2\\pi $-periodic function $f(x)$ that's piecewise continuous over $x\\in [0,2\\pi ),$ the Fourier series of $f$ is given by \n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),\n$$\n\nwhere ${a}_{0},$ ${a}_{n},$ and ${b}_{n}$ are constants to be determined. \n\nNow, we find the inner product of $f(x)$ with $1:$\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }({a}_{n}\\operatorname{cos}⁡(nx)+{b}_{n}\\operatorname{sin}⁡(nx)),1⟩ & = \\\\ ⟨\\frac{{a}_{0}}{2},1⟩+{\\sum }_{n=1}^{\\infty }⟨{a}_{n}\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }⟨{b}_{n}\\operatorname{sin}⁡(nx),1⟩ & = \\\\ \\frac{{a}_{0}}{2}⟨1,1⟩+{\\sum }_{n=1}^{\\infty }{a}_{n}⟨\\operatorname{cos}⁡(nx),1⟩+{\\sum }_{n=1}^{\\infty }{b}_{n}⟨\\operatorname{sin}⁡(nx),1⟩\\end{aligned}\n$$\n\nSince the functions\n$1,\\operatorname{sin}⁡(x),\\operatorname{cos}⁡(x),\\operatorname{sin}⁡(2x),\\operatorname{cos}⁡(2x),…$\nare orthogonal with respect to the defined inner product, the only nonzero term in the final expression above is\n\n$$\n\\frac{{a}_{0}}{2}⟨1,1⟩.\n$$\n\nComputing the inner product, we have\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{2\\pi }1\\,\\text{d}x \\\\  & ={[x]}_{0}^{2\\pi } \\\\  & =2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain that\n\n$$\n\\begin{aligned}⟨f(x),1⟩ & =\\frac{{a}_{0}}{2}⟨1,1⟩ \\\\ {a}_{0} & =\\frac{2⟨f(x),1⟩}{⟨1,1⟩} \\\\ {a}_{0} & =\\frac{1}{\\pi }{\\int }_{0}^{2\\pi }f(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }\\cdot {\\int }_{0}^{2\\pi }({x}^{3}-2{x}^{2})\\,\\text{d}x.\\end{aligned}\n$$"}]}
