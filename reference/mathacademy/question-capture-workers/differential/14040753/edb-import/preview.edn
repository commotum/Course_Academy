ince the norm can't be negative.\n\nTherefore, the minimum possible value of $‖v‖$ is $\\sqrt{2}.$" 13194139534779 true] [17592186309782 1000 #edb/ref 17592186309783 13194139534779 true] [17592186309782 1000 #edb/ref 17592186309784 13194139534779 true] [17592186309782 1000 #edb/ref 17592186309785 13194139534779 true] [17592186309782 1000 #edb/ref 17592186309786 13194139534779 true] [17592186309782 1000 #edb/ref 17592186309787 13194139534779 true] [17592186309782 1040 #edb/ref 17592186045450 13194139534779 true] [17592186309782 1041 "selection" 13194139534779 true] [17592186309782 1104 #edb/ref 17592186309783 13194139534779 true] [17592186309782 1110 #uuid "82fbf3b5-a6c7-5638-a0ea-2990e64c070d" 13194139534779 true] [17592186309783 1034 "\\sqrt{2}" 13194139534779 true] [17592186309783 1103 #edb/ref 17592186045453 13194139534779 true] [17592186309783 1111 #uuid "d37c882f-e260-5a29-8c97-9a35b7408443" 13194139534779 true] [17592186309784 1034 "\\sqrt{3}" 13194139534779 true] [17592186309784 1103 #edb/ref 17592186045453 13194139534779 true] [17592186309784 1111 #uuid "d05d7d9c-3ce0-5045-8952-1c3c67011f39" 13194139534779 true] [17592186309785 1034 "2" 13194139534779 true] [17592186309785 1103 #edb/ref 17592186045453 13194139534779 true] [17592186309785 1111 #uuid "1f6dfc9f-ef8f-54bb-8608-2c5733692844" 13194139534779 true] [17592186309786 1034 "2\\sqrt{2}" 13194139534779 true] [17592186309786 1103 #edb/ref 17592186045453 13194139534779 true] [17592186309786 1111 #uuid "04d8a5c1-d829-542e-9206-9951103bfa62" 13194139534779 true] [17592186309787 1034 "4" 13194139534779 true] [17592186309787 1103 #edb/ref 17592186045453 13194139534779 true] [17592186309787 1111 #uuid "6e07238e-ae6f-51bf-8644-94ef27697c95" 13194139534779 true]] :edb/tempids {"q-140459" 17592186309704 "q-140459/selection" 17592186309705 "q-140459/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" 17592186309706 "q-140459/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575