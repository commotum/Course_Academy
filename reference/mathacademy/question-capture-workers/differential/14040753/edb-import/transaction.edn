8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-140460" :question/id #uuid "3ebf76a0-eec1-5d1b-be4c-48f860555f1b" :question/math-academy-id "q-140460" :question/problem "Given that $‖8u-v‖=35$ and $‖v‖=11$, find the smallest possible value of $‖u‖.$" :question/worked-solution "Using the triangle inequality, we have that\n\n$$\n\\begin{aligned}‖8u-v‖ & \\le ‖8u‖+‖-v‖.\\end{aligned}\n$$\n\nSimplifying and substituting in the given information, we get\n\n$$\n\\begin{aligned}‖8u-v‖ & \\le 8‖u‖+‖v‖ \\\\ 35 & \\le 8‖u‖+11 \\\\ 24 & \\le 8‖u‖ \\\\ 3 & \\le ‖u‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖u‖$ is $3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140460/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ae3aec8-4d20-5467-9ced-2a9c1bda3afd"] :knowledge-point/questions ["q-140460"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-39610"] :question/problem "Let the vectors $v$ and $w$ be orthogonal. \nIf $|u\\cdot v{|}^{2}+‖v+w{‖}^{2}=50$ and $‖u‖=‖w‖=4$, then what is the minimum possible value of $‖v‖?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}50 & =|u\\cdot v{|}^{2}+‖v+w{‖}^{2} \\\\  & \\le {‖u{‖}^{2}\\cdot ‖v‖}^{2}+‖v+w{‖}^{2} \\\\  & ={4}^{2}\\cdot ‖v{‖}^{2}+‖v+w{‖}^{2} \\\\  & =16‖v{‖}^{2}+‖v+w{‖}^{2}.\\end{aligned}\n$$\n\nSince $v⊥w$, using the Pythagorean theorem, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}16‖v{‖}^{2}+‖v+w{‖}^{2} & =16‖v{‖}^{2}+‖v{‖}^{2}+‖w{‖}^{2} \\\\  & =16‖v{‖}^{2}+‖v{‖}^{2}+{4}^{2} \\\\  & =17‖v{‖}^{2}+16.\\end{aligned}\n$$\n\nCombining the two steps above, we get \n\n$$\n\\begin{aligned}50 & \\le 17‖v‖+16 \\\\ 34 & \\le 17‖v{‖}^{2} \\\\ 2 & \\le ‖v{‖}^{2}.\\end{aligned}\n$$\n\nFinally, $2\\le ‖v{‖}^{2}$ implies that $\\sqrt{2}\\le ‖v‖.$ Notice that we disregard the negative solutions since the norm can't be negative.\n\nTherefore, the minimum possible value of $‖v‖$ is $\\sqrt{2}.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-40243/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "2aa53caf-fe66-5ffe-9d17-2e552d6995c8" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-40243/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "c321f81d-98f4-54ba-83a4-ff4ce0b89455" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-40243/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "acc98e97-cd60-54e8-a31f-9e57b454e8a3" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-40243/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "1fe8a947-6153-58fe-b65f-ad4219945521" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-40243/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "38da9464-c2aa-510f-bfc5-ce507c75360a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-40243/selection" :answer-field/id #uuid "81c4c843-e8e8-5f58-ab16-fd3ed9cb0715" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40243/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-40243/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-40243/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-40243/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-40243/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-40243/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-40243" :question/id #uuid "47488a47-14a3-5678-954b-f24ebcdf0f1e" :question/math-academy-id "q-40243" :question/problem "If $|u\\cdot v|+‖u+v‖=19$ and $‖v‖=9$, then what is the smallest possible value of $‖u‖?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}19 & =|u\\cdot v|+‖u+v‖ \\\\  & \\le ‖u‖\\cdot ‖v‖+‖u+v‖ \\\\  & =‖u‖\\cdot (9)+‖u+v‖ \\\\  & =9‖u‖+‖u+v‖.\\end{aligned}\n$$\n\nNext, using the triangle inequality, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}9‖u‖+‖u+v‖ & \\le 9‖u‖+(‖u‖+‖v‖) \\\\  & =9‖u‖+(‖u‖+9) \\\\  & =10‖u‖+9.\\end{aligned}\n$$\n\nCombining the two inequalities, we get \n\n$$\n\\begin{aligned}19 & \\le 10‖u‖+9 \\\\ 10 & \\le 10‖u‖ \\\\ 1 & \\le ‖u‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖u‖$ is $1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40243/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2391612a-ee27-5cb2-a194-9b51e6fec1e1"] :knowledge-point/questions ["q-40243"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140461/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "e868f26a-188e-5190-b027-255826c602b3" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-140461/selection/9d68b9c7596db1608236297066f3136147e04a88d0cb94a9b31690f214e407f7" :answer/id #uuid "fa9d0280-7968-5d3b-afc6-cac297e17077" :answer/type :answer.type/math :answer/value "\\frac{39}{7}" :db/ensure [:answer/validate]} {:db/id "q-140461/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "d2b45db1-5e23-5430-b71a-305288456649" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-140461/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "e6020dc3-7d16-5e91-b61f-e9a7eb272f61" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-140461/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "cce29948-b4f6-5b02-bcf6-ab21aa28cae4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-140461/selection" :answer-field/id #uuid "0b7a29b2-35c0-5506-93cc-dab35bc0f59a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140461/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-140461/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-140461/selection/9d68b9c7596db1608236297066f3136147e04a88d0cb94a9b31690f214e407f7" "q-140461/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-140461/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-140461/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-140461" :question/id #uuid "4ccc53bc-857f-503f-8921-535a0b5ce1cf" :question/math-academy-id "q-140461" :question/problem "If $|u\\cdot v|+‖u+v‖=39$ and $‖v‖=7$, then what is the smallest possible value of $‖u‖?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}39 & =|u\\cdot v|+‖u+v‖ \\\\  & \\le ‖u‖\\cdot ‖v‖+‖u+v‖ \\\\  & =‖u‖\\cdot (7)+‖u+v‖ \\\\  & =7‖u‖+‖u+v‖.\\end{aligned}\n$$\n\nNext, using the triangle inequality, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}7‖u‖+‖u+v‖ & \\le 7‖u‖+(‖u‖+‖v‖) \\\\  & =7‖u‖+(‖u‖+7) \\\\  & =8‖u‖+7.\\end{aligned}\n$$\n\nCombining the two inequalities, we get \n\n$$\n\\begin{aligned}39 & \\le 8‖u‖+7 \\\\ 32 & \\le 8‖u‖ \\\\ 4 & \\le ‖u‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖u‖$ is $4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-140461/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2391612a-ee27-5cb2-a194-9b51e6fec1e1"] :knowledge-point/questions ["q-140461"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39608/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9c6df9e1-b24b-5691-b671-ba53374460f9" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-39608/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "d1590ba7-c219-5ad9-8fab-b1cda1d515d9" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-39608/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "290ad22d-0376-59fb-9e5b-f653f01d558c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-39608/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "5f4d1931-6c52-538c-8023-d0ede89415aa" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-39608/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" :answer/id #uuid "ad0b60a4-08fa-552b-baa7-d6379986f121" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "q-39608/selection" :answer-field/id #uuid "9a40b6ea-2245-512f-ba22-45998bc16202" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39608/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-39608/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-39608/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-39608/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-39608/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-39608/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01"] :db/ensure [:answer-field/validate]} {:db/id "q-39608" :question/id #uuid "2c491862-6cc2-5142-91ba-7a0b72655537" :question/math-academy-id "q-39608" :question/problem "If $|u\\cdot v|+‖u+v‖=34$ and $‖v‖=6$, then what is the smallest possible value of $‖u‖?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}34 & =|u\\cdot v|+‖u+v‖ \\\\  & \\le ‖u‖\\cdot ‖v‖+‖u+v‖ \\\\  & =‖u‖\\cdot (6)+‖u+v‖ \\\\  & =6‖u‖+‖u+v‖.\\end{aligned}\n$$\n\nNext, using the triangle inequality, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}6‖u‖+‖u+v‖ & \\le 6‖u‖+(‖u‖+‖v‖) \\\\  & =6‖u‖+(‖u‖+6) \\\\  & =7‖u‖+6.\\end{aligned}\n$$\n\nCombining the two inequalities, we get \n\n$$\n\\begin{aligned}34 & \\le 7‖u‖+6 \\\\ 28 & \\le 7‖u‖ \\\\ 4 & \\le ‖u‖.\\end{aligned}\n$$\n\nTherefore, the smallest possible value of $‖u‖$ is $4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39608/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2391612a-ee27-5cb2-a194-9b51e6fec1e1"] :knowledge-point/questions ["q-39608"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74191/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "d37c882f-e260-5a29-8c97-9a35b7408443" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-74191/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "6e07238e-ae6f-51bf-8644-94ef27697c95" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-74191/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "d05d7d9c-3ce0-5045-8952-1c3c67011f39" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-74191/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "04d8a5c1-d829-542e-9206-9951103bfa62" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-74191/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "1f6dfc9f-ef8f-54bb-8608-2c5733692844" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74191/selection" :answer-field/id #uuid "82fbf3b5-a6c7-5638-a0ea-2990e64c070d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74191/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer-field/choices ["q-74191/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-74191/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-74191/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-74191/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" "q-74191/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-74191" :question/id #uuid "bd88faa5-6854-51de-a79d-d62db631781d" :question/math-academy-id "q-74191" :question/problem "Let the vectors $v$ and $w$ be orthogonal. \nIf $|u\\cdot v{|}^{2}+4‖v+w{‖}^{2}=62$ and $‖u‖=‖w‖=3$, then what is the minimum possible value of $‖v‖?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}62 & ={|u\\cdot v|}^{2}+4‖v+w{‖}^{2} \\\\  & \\le {‖u{‖}^{2}\\cdot ‖v‖}^{2}+4‖v+w{‖}^{2} \\\\  & ={3}^{2}\\cdot ‖v{‖}^{2}+4‖v+w{‖}^{2} \\\\  & =9‖v{‖}^{2}+4‖v+w{‖}^{2}.\\end{aligned}\n$$\n\nSince $v⊥w$, using the Pythagorean theorem, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}9‖v{‖}^{2}+4‖v+w{‖}^{2} & =9‖v{‖}^{2}+4(‖v{‖}^{2}+‖w{‖}^{2}) \\\\  & =9‖v{‖}^{2}+4(‖v{‖}^{2}+{3}^{2}) \\\\  & =13‖v{‖}^{2}+36.\\end{aligned}\n$$\n\nCombining the two steps above, we get \n\n$$\n\\begin{aligned}62 & \\le 13‖v{‖}^{2}+36 \\\\ 26 & \\le 13‖v{‖}^{2} \\\\ 2 & \\le ‖v{‖}^{2}.\\end{aligned}\n$$\n\nFinally, $2\\le ‖v{‖}^{2}$ implies that $\\sqrt{2}\\le ‖v‖.$ Notice that we disregard the negative solutions since the norm can't be negative.\n\nTherefore, the minimum possible value of $‖v‖$ is $\\sqrt{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74191/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2391612a-ee27-5cb2-a194-9b51e6fec1e1"] :knowledge-point/questions ["q-74191"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5557"] :question/problem "Let $\\mathbf{u}$ and $\\mathbf{v}$ be vectors such that $\\Vert \\mathbf{v} \\Vert = 6$ and $\\Vert \\mathbf{u}+4\\mathbf{v} \\Vert = 25.$  If $\\mathbf{u}$ is orthogonal to $\\mathbf{v},$ find $\\mathbf{u}\\cdot\\mathbf{u}.$" :question/worked-solution "Since $\\mathbf{u}$ is orthogonal to $\\mathbf{v},$ we also have that $\\mathbf{u}$ is orthogonal to $4\\mathbf{v}.$ So, the Pythagorean theorem states that\n\n$$\n\\begin{aligned}‖u+4v{‖}^{2} & =‖u{‖}^{2}+‖4v{‖}^{2}.\\end{aligned}\n$$\n\nSimplifying and substituting in the given information, we get\n\n$$\n\\begin{aligned}‖u+4v{‖}^{2} & =‖u{‖}^{2}+(4‖v‖)^{2} \\\\ ‖u+4v{‖}^{2} & =‖u{‖}^{2}+16‖v{‖}^{2} \\\\ (25)^{2} & =‖u{‖}^{2}+16(6)^{2} \\\\ 625 & =‖u{‖}^{2}+576 \\\\ ‖u{‖}^{2} & =625-576 \\\\ ‖u{‖}^{2} & =49.\\end{aligned}\n$$\n\nTherefore, $\\mathbf{u}\\cdot\\mathbf{u}=\\Vert\\mathbf{u}\\Vert^2=49.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5558"] :question/problem "Given that $\\Vert \\mathbf{u} +3\\mathbf{v} \\Vert=14$ and $\\Vert \\mathbf{v} \\Vert=2,$ find the smallest possible value of $\\Vert \\mathbf{u}\\Vert.$" :question/worked-solution "Using the triangle inequality, we have that\n\n$$\n\\begin{aligned}‖u+3v‖ & \\le ‖u‖+‖3v‖.\\end{aligned}\n$$\n\nSimplifying and substituting in the given information, we get\n\n$$\n\\begin{aligned}‖u+3v‖ & \\le ‖u‖+3‖v‖ \\\\ 14 & \\le ‖u‖+3(2) \\\\ 14 & \\le ‖u‖+6 \\\\ 8 & \\le ‖u‖.\\end{aligned}\n$$\n\nTherefore, the minimum possible value of $\\Vert \\mathbf{u} \\Vert$ is $8.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5559"] :question/problem "Let the vectors $\\mathbf{v}$ and $\\mathbf{w}$ be orthogonal. \nIf $|\\mathbf{u}\\cdot \\mathbf{v}|^2+5\\Vert\\mathbf{v}+\\mathbf{w}\\Vert^2=29$ and $\\| \\mathbf{u} \\|  = \\| \\mathbf{w} \\| = 2$, then what is the minimum possible value of $\\Vert\\mathbf{v}\\Vert?$" :question/worked-solution "First, using the Cauchy-Schwarz inequality, simplifying, and substituting in the given information, we obtain\n\n$$\n\\begin{aligned}29 & =|u\\cdot v{|}^{2}+5‖v+w{‖}^{2} \\\\  & \\le {‖u{‖}^{2}\\cdot ‖v‖}^{2}+5‖v+w{‖}^{2} \\\\  & ={2}^{2}\\cdot ‖v{‖}^{2}+5‖v+w{‖}^{2} \\\\  & =4‖v{‖}^{2}+5‖v+w{‖}^{2}.\\end{aligned}\n$$\n\nSince $\\mathbf{v} \\perp \\mathbf{w}$, using the Pythagorean theorem, simplifying, and substituting in the given information, we have \n\n$$\n\\begin{aligned}4‖v{‖}^{2}+5‖v+w{‖}^{2} & =4‖v{‖}^{2}+5(‖v{‖}^{2}+‖w{‖}^{2}) \\\\  & \\le 4‖v{‖}^{2}+5(‖v{‖}^{2}+{2}^{2}) \\\\  & =9‖v{‖}^{2}+20.\\end{aligned}\n$$\n\nCombining the two steps above, we get \n\n$$\n\\begin{aligned}29 & \\le 9‖v{‖}^{2}+20 \\\\ 9 & \\le 9‖v{‖}^{2} \\\\ 1 & \\le ‖v{‖}^{2}.\\end{aligned}\n$$\n\nFinally, $1 \\leq \\Vert\\mathbf{v}\\Vert^2$ implies that $1 \\leq \\Vert\\mathbf{v}\\Vert$. Notice that we disregard the negative solutions since the norm can't be negative.\n\nTherefore, the minimum possible value of $\\Vert\\mathbf{v}\\Vert$ is $1.$" :db/ensure [:question/validate]}]
