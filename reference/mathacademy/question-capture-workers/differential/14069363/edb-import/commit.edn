76 true] [17592186360655 1111 #uuid "f094967c-6783-5e4f-98ab-4cb60e9a3b0e" 13194139535676 true] [17592186360656 1000 #edb/ref 17592186360657 13194139535676 true] [17592186360656 1000 #edb/ref 17592186360658 13194139535676 true] [17592186360656 1000 #edb/ref 17592186360659 13194139535676 true] [17592186360656 1000 #edb/ref 17592186360660 13194139535676 true] [17592186360656 1040 #edb/ref 17592186045451 13194139535676 true] [17592186360656 1041 "field-4" 13194139535676 true] [17592186360656 1104 #edb/ref 17592186360660 13194139535676 true] [17592186360656 1110 #uuid "7ea77bb7-3c11-52c5-96cc-93ae987cb1aa" 13194139535676 true] [17592186360657 1034 "C{e}^{-2x}" 13194139535676 true] [17592186360657 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360657 1111 #uuid "9cb27e9c-f6e5-5ef1-959c-817d158468b2" 13194139535676 true] [17592186360658 1034 "Cx{e}^{-2x}" 13194139535676 true] [17592186360658 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360658 1111 #uuid "4387d001-bc7d-5553-a0b3-d3ce8346c924" 13194139535676 true] [17592186360659 1034 "x{e}^{-2x}" 13194139535676 true] [17592186360659 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360659 1111 #uuid "1b1ef7db-63dd-5c60-900e-b6cedecc1059" 13194139535676 true] [17592186360660 1034 "{e}^{-2x}" 13194139535676 true] [17592186360660 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360660 1111 #uuid "42d1c719-f552-5d23-9165-8017325be45d" 13194139535676 true] [17592186360661 1000 #edb/ref 17592186360662 13194139535676 true] [17592186360661 1000 #edb/ref 17592186360663 13194139535676 true] [17592186360661 1040 #edb/ref 17592186045451 13194139535676 true] [17592186360661 1041 "field-5" 13194139535676 true] [17592186360661 1104 #edb/ref 17592186360662 13194139535676 true] [17592186360661 1110 #uuid "52d2d7b7-680e-5cb0-9558-6f38383fab21" 13194139535676 true] [17592186360662 1034 "$A$ and $B$" 13194139535676 true] [17592186360662 1103 #edb/ref 17592186045454 13194139535676 true] [17592186360662 1111 #uuid "1f003350-cf55-5f01-8845-98a1c5fc423f" 13194139535676 true] [17592186360663 1034 "$A,$ $B,$ and $C$" 13194139535676 true] [17592186360663 1103 #edb/ref 17592186045454 13194139535676 true] [17592186360663 1111 #uuid "b521df7b-d913-5aec-8a35-fceae06c08d1" 13194139535676 true] [17592186360664 1017 #edb/ref 17592186360665 13194139535676 true] [17592186360664 1089 "q-79932" 13194139535676 true] [17592186360664 1091 #edb/ref 17592186045463 13194139535676 true] [17592186360664 1100 "Given that ${y}_{1}(x)={e}^{x/2}$ is a solution to the equation $4{y}^{″}-4{y}^{′}+y=0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation, and write down the general solution." 13194139535676 true] [17592186360664 1113 #uuid "25f76d61-f5bd-5300-a8bb-fba17cb3162f" 13194139535676 true] [17592186360664 1145 "According to the reduction of order method, we let ${y}_{2}=u(x){e}^{x/2}.$ \n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{e}^{x/2}+\\frac{u}{2}{e}^{x/2} \\\\ {y}_{2}^{″} & ={u}^{″}{e}^{x/2}+{u}^{′}{e}^{x/2}+\\frac{u}{4}{e}^{x/2}.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}4({u}^{″}{e}^{x/2}+{u}^{′}{e}^{x/2}+\\frac{u}{4}{e}^{x/2})-4({u}^{′}{e}^{x/2}+\\frac{u}{2}{e}^{x/2})+u{e}^{x/2} & =0 \\\\ 4{u}^{″}{e}^{x/2}+4{u}^{′}{e}^{x/2}+u{e}^{x/2}-4{u}^{′}{e}^{x/2}-2u{e}^{x/2}+u{e}^{x/2} & =0 \\\\ 4{u}^{″}{e}^{x/2} & =0.\\end{aligned}\n$$\n\nSince $4{e}^{x/2}\\ne 0$ we must have\n\n$$\n{u}^{″}=0.\n$$\n\nIntegrating the equation twice gives\n\n$$\nu={c}_{1}x+{c}_{2}.\n$$\n\nThus, our expression for ${y}_{2}(x)=u{e}^{x/2}$ becomes\n\n$$\n{y}_{2}(x)={e}^{x/2}({c}_{1}x+{c}_{2}).\n$$\n\nSetting ${c}_{1}=1$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)={e}^{x/2}\\cdot x=x{e}^{x/2}.\n$$\n\nFinally, because $W({y}_{1},{y}_{2})={e}^{x}\\ne 0,$ we know that ${y}_{1}$ and ${y}_{2}$ are independent (you should verify this calculation yourself).\n\nTherefore, the general solution is\n\n$$\ny=A{e}^{x/2}+Bx{e}^{x/2}.\n$$" 13194139535676 true] [17592186360665 1000 #edb/ref 17592186360666 13194139535676 true] [17592186360665 1000 #edb/ref 17592186360667 13194139535676 true] [17592186360665 1000 #edb/ref 17592186360668 13194139535676 true] [17592186360665 1000 #edb/ref 17592186360669 13194139535676 true] [17592186360665 1000 #edb/ref 17592186360670 13194139535676 true] [17592186360665 1040 #edb/ref 17592186045450 13194139535676 true] [17592186360665 1041 "selection" 13194139535676 true] [17592186360665 1104 #edb/ref 17592186360668 13194139535676 true] [17592186360665 1110 #uuid "89eec56d-e3c9-5f1f-9751-f0df759ff987" 13194139535676 true] [17592186360666 1034 "y=A{e}^{x/2}+Bx{e}^{x/4}" 13194139535676 true] [17592186360666 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360666 1111 #uuid "c8d93e63-ee9f-5c7d-bd77-ae65ac577d3b" 13194139535676 true] [17592186360667 1034 "y=A{e}^{x/2}+B{e}^{-x/2}" 13194139535676 true] [17592186360667 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360667 1111 #uuid "ad907199-f13a-5f57-b5e6-e24f4579d028" 13194139535676 true] [17592186360668 1034 "y=A{e}^{x/2}+Bx{e}^{x/2}" 13194139535676 true] [17592186360668 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360668 1111 #uuid "4c72ef9b-4587-5060-bed7-8b3b781c9a4c" 13194139535676 true] [17592186360669 1034 "y=A{e}^{x/2}+B{e}^{x/4}" 13194139535676 true] [17592186360669 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360669 1111 #uuid "f33e58a8-d0f4-54fa-9af7-2068f0cbcbf1" 13194139535676 true] [17592186360670 1034 "y=A{e}^{x/2}+Bx{e}^{-x/2}" 13194139535676 true] [17592186360670 1103 #edb/ref 17592186045453 13194139535676 true] [17592186360670 1111 #uuid "c34b8e6f-3b2d-5272-a328-1794ea50aaab" 13194139535676 true] [17592186360671 1017 #edb/ref 17592186360672 13194139535676 true] [17592186360671 1089 "q-79935" 13194139535676 true] [17592186360671 1091 #edb/ref 17592186045464 13194139535676 true] [17592186360671 1100 "Given that ${y}_{1}(x)={x}^{2}$ is a solution to the equation $2{x}^{2}{y}^{″}-3x{y}^{′}+2y=0$ for $x>0,$ use reduction of order to find a second solution ${y}_{2}(x)$ to the equation, and write down the general solution." 13194139535676 true] [17592186360671 1113 #uuid "3624b381-ff5b-5c61-a5d8-e12407af8abd" 13194139535676 true] [17592186360671 1145 "According to the reduction of order method, we let ${y}_{2}=u(x){x}^{2}.$\n\nDifferentiating the above with respect to $x$ gives\n\n$$\n\\begin{aligned}{y}_{2}^{′} & ={u}^{′}{x}^{2}+2ux \\\\ {y}_{2}^{″} & ={u}^{″}{x}^{2}+4{u}^{′}x+2u.\\end{aligned}\n$$\n\nSubstituting the above into the differential equation gives\n\n$$\n\\begin{aligned}2{x}^{2}({u}^{″}{x}^{2}+4{u}^{′}x+2u)-3x({u}^{′}{x}^{2}+2ux)+2(u{x}^{2}) & =0 \\\\ 2{u}^{″}{x}^{4}+8{u}^{′}{x}^{3}+4u{x}^{2}-3{u}^{′}{x}^{3}-6u{x}^{2}+2u{x}^{2} & =0 \\\\ 2{u}^{″}{x}^{4}+5{u}^{′}{x}^{3} & =0 \\\\ {x}^{3}(2x{u}^{″}+5{u}^{′}) & =0.\\end{aligned}\n$$\n\nSince ${x}^{3}\\ne 0$ for $x>0,$ we must have\n\n$$\n2x{u}^{″}+5{u}^{′}=0.\n$$\n\nLet $w={u}^{′}.$ Then our equation becomes\n\n$$\n2x{w}^{′}+5w=0.\n$$\n\nThis is a separable equation that has the solution\n\n$$\nw={c}_{1}{x}^{-5/2}.\n$$\n\nBut since $w={u}^{′},$ we have\n\n$$\n{u}^{′}={c}_{1}{x}^{-5/2}\\,⟹\\,u=-\\frac{2{c}_{1}}{3}{x}^{-3/2}+{c}_{2}.\n$$\n\nHence, our expression for ${y}_{2}(x)=u{x}^{2}$ becomes\n\n$$\n{y}_{2}(x)=(-\\frac{2{c}_{1}}{3}{x}^{-3/2}+{c}_{2}){x}^{2}.\n$$\n\nSetting ${c}_{1}=-\\frac{3}{2}$ and ${c}_{2}=0,$ we get\n\n$$\n{y}_{2}(x)=({x}^{-3/2}){x}^{2}={x}^{1/2}.\n$$\n\nFinally, because $W({y}_{1},{y}_{2})=-\\frac{3}{2}{x}^{3/2}\\ne 0,$ we know that ${y}_{1}$ and ${y}_{2}$ are independent (you should verify this calculation yourself).\n\nTherefore, the general solution is\n\n$$\ny=A{x}^{2}+B{x}^{1/2}.\n$$" 13194139535676 true] [17592186360672 1000 #edb/ref 17592186360673 13194139535676 true] [17592186360672 1000 #edb/ref 17592186360674 13194139535676 true] [17592186360672 1000 #edb/ref 17592186360675