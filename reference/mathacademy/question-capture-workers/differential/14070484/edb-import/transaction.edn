63bab0bf96202f6959f21a/0308ff2215ecf8a9aaf663604ddd81c7caa526dadffd61a6755daaf333d63593" :answer-field/choices ["q-64288/selection/ma-v1/e816260fc7c271ea604accb9b03465622ffec5d26b63bab0bf96202f6959f21a/72b141717ec54aa8c05845cdcd0a2e6c087cdd222473c9423d57e6468ec616fe" "q-64288/selection/ma-v1/e816260fc7c271ea604accb9b03465622ffec5d26b63bab0bf96202f6959f21a/10ca565779db9c380894a73b492c2aa448a55263e8c8919521ff244db5d1e048" "q-64288/selection/ma-v1/e816260fc7c271ea604accb9b03465622ffec5d26b63bab0bf96202f6959f21a/0308ff2215ecf8a9aaf663604ddd81c7caa526dadffd61a6755daaf333d63593" "q-64288/selection/ma-v1/e816260fc7c271ea604accb9b03465622ffec5d26b63bab0bf96202f6959f21a/6d532e23d1ee77f531c7b90fbb69b5c0ffec25ab77611216fc6557bc11b5308a" "q-64288/selection/ma-v1/e816260fc7c271ea604accb9b03465622ffec5d26b63bab0bf96202f6959f21a/803c571ae8b66d01298e82f02d2fb0eb4102e72412e0b26d5dd047e5bb198add"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-64288"] :question/problem "Find the Laplace transform $L{{f}^{″}(t)}$ for $s>0,$ given that the function $f(t)$ is continuous on $[0,\\infty ),$ ${f}^{′}(0)=-1,$ $f(0)=1,$ and\n\n$$\nL{f(t)}=\\frac{s-1}{{s}^{2}+1},\\,s>0.\n$$\n\nAssume that ${f}^{′}$ is continuous and ${f}^{″}$ piecewise continuous on $[0,\\infty ).$" :question/worked-solution "Suppose $F(s)=L{f(t)}$ where $f(t)$ is a continuous function of exponential order $a$ on $[0,\\infty ).$ If ${f}^{′}(t)$ is continuous and ${f}^{″}(t)$ is piecewise continuous on $[0,\\infty ),$ then\n\n$$\n\\begin{aligned}L{{f}^{″}(t)} & ={s}^{2}L{f(t)}-sf(0)-{f}^{′}(0).\\end{aligned}\n$$\n\nTherefore, we can calculate the Laplace transform of ${f}^{″}(t)$ as follows:\n\n$$\n\\begin{aligned}L{{f}^{″}(t)} & ={s}^{2}\\cdot \\frac{s-1}{{s}^{2}+1}-s\\cdot 1-(-1) \\\\  & =\\frac{{s}^{2}(s-1)}{{s}^{2}+1}-s+1 \\\\  & =\\frac{{s}^{2}(s-1)}{{s}^{2}+1}-(s-1) \\\\  & =(s-1)(\\frac{{s}^{2}}{{s}^{2}+1}-1) \\\\  & =(s-1)(-\\frac{1}{{s}^{2}+1}) \\\\  & =\\frac{1-s}{{s}^{2}+1}\\end{aligned}\n$$\n\nvalid for $s>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64288/selection/ma-v1/e816260fc7c271ea604accb9b03465622ffec5d26b63bab0bf96202f6959f21a"] :db/ensure [:question/validate]} {:db/id "q-64325/selection/c620d9e895b93b27c755092376ef6e0ff907625021bbc4eb4497d2cd3a3a5c04" :answer/id #uuid "3fee8776-43dc-5fee-891c-52c92eb13ac4" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}+s+16}{{s}^{2}-8s+20}" :db/ensure [:answer/validate]} {:db/id "q-64325/selection/015fb221702218b21a5b0b5d827b0f1d0ea607b46c868f078bc5f8ad6e3b177f" :answer/id #uuid "b8a31e6e-9f1c-5b36-8b8f-93caa43c20c9" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}-20}{{s}^{2}-8s+20}" :db/ensure [:answer/validate]} {:db/id "q-64325/selection/29fcd146f627d5e3c6aa14d89449f586b22f8a67ce21c3bc29fb185376a29dca" :answer/id #uuid "336c3b33-a108-5161-88f5-99b1c801118a" :answer/type :answer.type/math :answer/value "\\frac{s-4}{{s}^{2}-8s+20}" :db/ensure [:answer/validate]} {:db/id "q-64325/selection/18fa78916bfa05b139a1b86da0ecf2b56c0ea25e13e2b9b752080a5968e8dab9" :answer/id #uuid "e175291d-8aa8-5ff6-a7d2-ba62ffdd5dd6" :answer/type :answer.type/math :answer/value "\\frac{2s-16}{{s}^{2}-8s+20}" :db/ensure [:answer/validate]} {:db/id "q-64325/selection/c46868b2b39739f20736cda97417501995e8fe5e04f0c7d5f92790631fe4d97c" :answer/id #uuid "6fb57e96-2232-553c-8a0c-e797f44f5745" :answer/type :answer.type/math :answer/value "\\frac{4s-20}{{s}^{2}-8s+20}" :db/ensure [:answer/validate]} {:db/id "q-64325/selection" :answer-field/id #uuid "99d0217d-6642-58de-9d8a-5565584cb829" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64325/selection/c46868b2b39739f20736cda97417501995e8fe5e04f0c7d5f92790631fe4d97c" :answer-field/choices ["q-64325/selection/c620d9e895b93b27c755092376ef6e0ff907625021bbc4eb4497d2cd3a3a5c04" "q-64325/selection/015fb221702218b21a5b0b5d827b0f1d0ea607b46c868f078bc5f8ad6e3b177f" "q-64325/selection/29fcd146f627d5e3c6aa14d89449f586b22f8a67ce21c3bc29fb185376a29dca" "q-64325/selection/18fa78916bfa05b139a1b86da0ecf2b56c0ea25e13e2b9b752080a5968e8dab9" "q-64325/selection/c46868b2b39739f20736cda97417501995e8fe5e04f0c7d5f92790631fe4d97c"] :db/ensure [:answer-field/validate]} {:db/id "q-64325" :question/id #uuid "a000a85b-79f6-52ec-96f7-264e3b78d9d6" :question/math-academy-id "q-64325" :question/problem "Find the Laplace transform of ${f}^{′}(t)$ for $s>4$ given that the function $f(t)$ is continuous over $[0,\\infty ),$ $f(0)=1,$ and\n\n$$\nL{f(t)}=\\frac{s-4}{{s}^{2}-8s+20},\\,s>4.\n$$\n\nAssume that ${f}^{′}$ is piecewise continuous on $[0,\\infty ).$" :question/worked-solution "Suppose $F(s)=L{f(t)}$ where $f(t)$ is a continuous function of exponential order $a$ on $[0,\\infty ).$ If ${f}^{′}(t)$ is piecewise continuous on $[0,\\infty ),$ then\n\n$$\nL{{f}^{′}(t)}=sL{f(t)}-f(0).\n$$\n\nTherefore, we can calculate the Laplace transform of ${f}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}L{{f}^{′}(t)} & =sL{f(t)}-f(0) \\\\  & =s\\cdot \\frac{s-4}{{s}^{2}-8s+20}-1 \\\\  & =\\frac{s(s-4)-({s}^{2}-8s+20)}{{s}^{2}-8s+20} \\\\  & =\\frac{4s-20}{{s}^{2}-8s+20}\\end{aligned}\n$$\n\nvalid for $s>4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64325/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "51f6b682-ce7e-5068-8679-06a452eed647"] :knowledge-point/questions ["q-64325"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89450/selection/406260959c5a9d314d8baf5396d59ad36db65dbd3154ab06401e70c19d472f72" :answer/id #uuid "eea32fec-b425-529e-b4f5-78c25aa94f9d" :answer/type :answer.type/math :answer/value "\\frac{s}{s-3}" :db/ensure [:answer/validate]} {:db/id "q-89450/selection/13071d4092e82b58391e3ae576c71936068cfcd5d0714733745098714d44bde7" :answer/id #uuid "9d731b9e-7188-533f-a112-5fe83215b427" :answer/type :answer.type/math :answer/value "\\frac{3s}{s-3}" :db/ensure [:answer/validate]} {:db/id "q-89450/selection/1e789df0e2977de3beb1aec627db84bbc23f96dda546bf9c74f3852ea2505722" :answer/id #uuid "cf9fbbef-b92b-54aa-b45a-969024658849" :answer/type :answer.type/math :answer/value "\\frac{2s-1}{s-3}" :db/ensure [:answer/validate]} {:db/id "q-89450/selection/32d6f55448760e2619c74b906fcfc0915940830b513e75e34f92954c420a26bc" :answer/id #uuid "d471baaf-ac60-59d4-9563-f350c8124770" :answer/type :answer.type/math :answer/value "\\frac{5}{s-3}" :db/ensure [:answer/validate]} {:db/id "q-89450/selection/a51fa0785c27b0523aa0fdd4f3496d80eb85bf91d14ad9e38af4b2235ebf15f7" :answer/id #uuid "5b964a16-b1db-511d-b493-65f1cdd60354" :answer/type :answer.type/math :answer/value "\\frac{9}{s-3}" :db/ensure [:answer/validate]} {:db/id "q-89450/selection" :answer-field/id #uuid "331305fd-979a-540f-a550-653099d05f50" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89450/selection/a51fa0785c27b0523aa0fdd4f3496d80eb85bf91d14ad9e38af4b2235ebf15f7" :answer-field/choices ["q-89450/selection/406260959c5a9d314d8baf5396d59ad36db65dbd3154ab06401e70c19d472f72" "q-89450/selection/13071d4092e82b58391e3ae576c71936068cfcd5d0714733745098714d44bde7" "q-89450/selection/1e789df0e2977de3beb1aec627db84bbc23f96dda546bf9c74f3852ea2505722" "q-89450/selection/32d6f55448760e2619c74b906fcfc0915940830b513e75e34f92954c420a26bc" "q-89450/selection/a51fa0785c27b0523aa0fdd4f3496d80eb85bf91d14ad9e38af4b2235ebf15f7"] :db/ensure [:answer-field/validate]} {:db/id "q-89450" :question/id #uuid "c4985c23-8707-5fc4-a1b4-2454ba8776c6" :question/math-academy-id "q-89450" :question/problem "Find the Laplace transform of ${f}^{′}(t)$ for $s>3$ given that the function $f(t)$ is continuous over $[0,\\infty ),$ $f(0)=5,$ and\n\n$$\nL{f(t)}=\\frac{5s-6}{{s}^{2}-3s},\\,s>3.\n$$\n\nAssume that ${f}^{′}$ is piecewise continuous on $[0,\\infty ).$" :question/worked-solution "Suppose $F(s)=L{f(t)}$ where $f(t)$ is a continuous function of exponential order $a$ on $[0,\\infty ).$ If ${f}^{′}(t)$ is piecewise continuous on $[0,\\infty ),$ then\n\n$$\nL{{f}^{′}(t)}=sL{f(t)}-f(0).\n$$\n\nTherefore, we can calculate the Laplace transform of ${f}^{′}(t)$ as follows:\n\n$$\n\\begin{aligned}L{{f}^{′}(t)} & =sL{f(t)}-f(0) \\\\  & =s\\cdot \\frac{5s-6}{{s}^{2}-3s}-5 \\\\  & =\\frac{5{s}^{2}-6s}{{s}^{2}-3s}-5 \\\\  & =\\frac{9s}{{s}^{2}-3s} \\\\  & =\\frac{9s}{s(s-3)} \\\\  & =\\frac{9}{s-3}\\end{aligned}\n$$\n\nvalid for $s>3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-89450/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "51f6b682-ce7e-5068-8679-06a452eed647"] :knowledge-point/questions ["q-89450"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89462/selection/ed8ae08c69978320f2b76d3b15f415020dfc76258ad50a510b9a891716fcb5e9" :answer/id #uuid "3aeae217-0db7-582a-87c2-a319e7114eb3" :answer/type :answer.type/math :answer/value "\\frac{9s-27}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-89462/selection/231b91dfcfeb4f4d1d9ae88b8ab96c3bb63df6f29d99fb761a75e23dc293edfb" :answer/id #uuid "b724f2f8-bd90-5f74-94b9-520e9fbb3291" :answer/type :answer.type/math :answer/value "\\frac{3s}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-89462/selection/016129f4f5185f484cd46a8eb23ff335467f33a69d308e09cfe5ace829a96c89" :answer/id #uuid "ca08e936-0308-5b26-9672-1d8fbac17be6" :answer/type :answer.type/math :answer/value "\\frac{27}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-89462/selection/390fd106402fb653d1596869e3f546e5d2084beeb0d34a92e99b2937c8baf04a" :answer/id #uuid "a90ea407-4fbe-59a0-9986-3054e0a81f8c" :answer/type :answer.type/math :answer/value "\\frac{9s}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-89462/selection/dcc5ec0bb1dfc46223f79b00df144a222c3b54fecaa0cc4d134ae18f5c45eb44" :answer/id #uuid "de53bfa7-79a4-5795-9873-280158c56079" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}-3}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-89462/selection" :answer-field/id #uuid "ce41c28a-b999-5475-8ed5-cb2bc41d4c07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89462/selection/ed8ae08c69978320f2b76d3b15f415020dfc76258ad50a510b9a891716fcb5e9" :answer-field/choices ["q-89462/selection/ed8ae08c69978320f2b76d3b15f415020dfc76258ad50a510b9a891716fcb5e9" "q-89462/selection/231b91dfcfeb4f4d1d9ae88b8ab96c3bb63df6f29d99fb761a75e23dc293edfb" "q-89462/selection/016129f4f5185f484cd46a8eb23ff335467f33a69d308e09cfe5ace829a96c89" "q-89462/selection/390fd106402fb653d1596869e3f546e5d2084beeb0d34a92e99b2937c8baf04a" "q-89462/selection/dcc5ec0bb1dfc46223f79b00df144a222c3b54fecaa0cc4d134ae18f5c45eb44"] :db/ensure [:answer-field/validate]} {:db/id "q-89462" :question/id #uuid "1ce7a8a3-0f7b-5c46-a780-a90f46c2a7ce" :question/math-academy-id "q-89462" :question/problem "Find the Laplace transform $L{{f}^{″}(t)}$ for $s>0,$ given that the function $f(t)$ is continuous on $[0,\\infty ),$ ${f}^{′}(0)=3,$ $f(0)=-1,$ and\n\n$$\nL{f(t)}=\\frac{3-s}{{s}^{2}+9},\\,s>0.\n$$\n\nAssume that ${f}^{′}$ is continuous and ${f}^{″}$ piecewise continuous on $[0,\\infty ).$" :question/worked-solution "Suppose $F(s)=L{f(t)}$ where $f(t)$ is a continuous function of exponential order $a$ on $[0,\\infty ).$ If ${f}^{′}(t)$ is continuous and ${f}^{″}(t)$ is piecewise continuous on $[0,\\infty ),$ then\n\n$$\n\\begin{aligned}L{{f}^{″}(t)} & ={s}^{2}L{f(t)}-sf(0)-{f}^{′}(0).\\end{aligned}\n$$\n\nTherefore, we can calculate the Laplace transform of ${f}^{″}(t)$ as follows:\n\n$$\n\\begin{aligned}L{{f}^{″}(t)} & ={s}^{2}\\cdot \\frac{3-s}{{s}^{2}+9}-s\\cdot (-1)-3 \\\\  & =\\frac{{s}^{2}(3-s)}{{s}^{2}+9}+s-3 \\\\  & =\\frac{(s-3)({s}^{2}+9-{s}^{2})}{{s}^{2}+9} \\\\  & =\\frac{9s-27}{{s}^{2}+9}\\end{aligned}\n$$\n\nvalid for $s>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-89462/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e59d43c-f723-521e-b7cf-676719