{:db/ident :answer.type/math} :answer/value "y^{′} = (x - 2)(y + 2)" :db/id #edb/ref 17592186170939} {:answer/id #uuid "643a7854-0193-5241-9111-336c307c71af" :answer/type {:db/ident :answer.type/math} :answer/value "y^{′} = (x - 2)(y - 2)" :db/id #edb/ref 17592186170940}] :answer-field/correct {:answer/id #uuid "10b4bbd6-4311-50c9-9586-ad4d315a4aa1" :answer/type {:db/ident :answer.type/math} :answer/value "y^{′} = (x - 2)(y - 2)^{2}" :db/id #edb/ref 17592186170938} :answer-field/id #uuid "0f7440b5-30c6-570c-9ad5-1aa323e029ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186170935}] :question/id #uuid "4cb5a8df-a5e4-5c99-96b2-ca3bba93068e" :question/math-academy-id "q-50160" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/3350/Source/Images/q-50160.png)\n\nThe diagram shown above is the slope field for which of the following differential equations?"}] [{:db/id #edb/ref 17592186172497 :knowledge-point/_questions [{:knowledge-point/id #uuid "244419de-9b13-5923-b0a5-1bdc6f9b03b2" :knowledge-point/title "Identifying an Equation That Generates a Slope Field Using the Sign of the Slopes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93ab0417-4704-568b-9373-31611d88f941" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186170948} {:answer/id #uuid "b5fc65ef-8502-5176-a4aa-5eee83d077fb" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186170949} {:answer/id #uuid "cf968c17-0048-51a7-9509-52e1324dd379" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186170950} {:answer/id #uuid "2e2dc7d0-b315-514a-9e91-15259c0eff56" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186170951} {:answer/id #uuid "2e57cd97-0e91-58fc-83ed-b4c1f4706dd6" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17