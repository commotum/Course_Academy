22aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158117" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=\\operatorname{cos}⁡x+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158117" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\operatorname{ln}⁡|y|=-\\operatorname{cos}⁡x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158014" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation ${y}^{′}=y\\operatorname{cos}⁡x$ for $y\\ne 0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158014" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =y\\operatorname{cos}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{cos}⁡x \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{sin}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{sin}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{sin}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{\\operatorname{sin}⁡x}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158014" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/activity-metadata.json" "file_sha256" "46dbe064e7d548bc283b07a09958fc59b77b8700062f68f20f01d2ba9a3bc5eb" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14