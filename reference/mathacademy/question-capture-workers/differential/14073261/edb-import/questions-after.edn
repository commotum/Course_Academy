 :answer.type/math} :answer/value "{e}^{-st}{A}^{′}(t)" :db/id #edb/ref 17592186379405} :answer-field/id #uuid "b05e9e38-7d91-5d9b-83e2-c8090284dda6" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186379403} {:answer-field/choices [{:answer/id #uuid "86bf101c-5aa7-5dfd-82d8-e3609b574b8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{F(s)}{s}" :db/id #edb/ref 17592186379409} {:answer/id #uuid "1af2acbc-4948-52da-8505-68dbf563524b" :answer/type {:db/ident :answer.type/math} :answer/value "F(s)" :db/id #edb/ref 17592186379410} {:answer/id #uuid "fe1b3bde-d4b2-5cac-938b-fbd19c60a602" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s}{F(s)}" :db/id #edb/ref 17592186379411} {:answer/id #uuid "618e2f4d-2a6a-5579-92b4-b91d16524fac" :answer/type {:db/ident :answer.type/math} :answer/value "sF(s)" :db/id #edb/ref 17592186379412}] :answer-field/correct {:answer/id #uuid "86bf101c-5aa7-5dfd-82d8-e3609b574b8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{F(s)}{s}" :db/id #edb/ref 17592186379409} :answer-field/id #uuid "1873f4fc-83c7-584b-8ba2-f12e18527e88" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186379408}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8bfadb68-c634-5617-a1c3-ca1ddae49650" :question/math-academy-id "q-331084" :question/problem "Suppose we wish to find $L{{\\int }_{0}^{t}f(τ)\\,dτ}$ given $L{f(t)}=F(s)$ for $s>{s}_{0}.$ Select the correct options in the reasoning below.Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ={{field-1}}\\,{|}_{0}^{t}=A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L{{\\int }_{0}^{t}f(τ)\\,dτ}=L{A(t)}={\\int }_{0}^{\\infty }{{field-2}}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & ⇒ & du={A}^{′}(t)\\text{ }dt \\\\ dv={{field-3}} & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }({{field-4}}){A}^{′}(t)\\,dt\\end{aligned}\n$$\n\nSince $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=$ $0$, we have\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{{field-5}}\\,\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & ={{field-6}}.\\end{aligned}\n$$" :question/worked-solution "Let $A(t)$ be the anti-derivative of $f(t)$ such that ${A}^{′}(t)=f(t)$ and $A(0)=0.$ Then,\n\n$$\n\\begin{aligned}{\\int }_{0}^{t}f(τ)\\,dτ & =A(τ)\\,{|}_{0}^{t} \\\\  & =A(t)-A(0) \\\\  & =A(t).\\end{aligned}\n$$\n\nBy definition of the Laplace transform, we can write\n\n$$\n\\begin{aligned}L{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ} & =L{A(t)}={\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, let's use integration by parts:\n\n$$\n\\begin{aligned}u=A(t) & \\,⇒\\, & du={A}^{′}(t)\\,dt \\\\ dv={e}^{-st}\\,dt & ⇒ & v=-\\frac{1}{s}{e}^{-st}\\end{aligned}\n$$\n\nSubstituting into the integration by parts formula, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt & =A(t)(-\\frac{1}{s}{e}^{-st})\\,{|}_{0}^{\\infty }-{\\int }_{0}^{\\infty }(-\\frac{1}{s}{e}^{-st}){A}^{′}(t)\\,dt.\\end{aligned}\n$$\n\nSince $A(0)=0$ and $\\frac{1}{s}{e}^{-st}\\to 0$ as $t\\to \\infty ,$ we have $-\\frac{1}{s}A(t){e}^{-st}{|}_{0}^{\\infty }=0$ and\n\n$$\n{\\int }_{0}^{\\infty }{e}^{-st}A(t)\\,dt=\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt.\n$$\n\nFinally, using that ${A}^{′}(t)=f(t),$ we obtain\n\n$$\n\\begin{aligned}\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}{A}^{′}(t)\\,dt & =\\frac{1}{s}{\\int }_{0}^{\\infty }{e}^{-st}f(t)\\,dt \\\\  & =\\frac{1}{s}\\cdot F(s) \\\\  & =\\frac{F(s)}{s}.\\end{aligned}\n$$"}]}
