ext{d}τ} \\\\  & =\\frac{F(s)}{s} \\\\  & =\\frac{1}{s(s+3)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-330826/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4241972f-4023-5638-aa7a-9e4a75167c3d"] :knowledge-point/questions ["q-330826"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330834/selection/497df57bfa05156bdd61180254df57923521e8dc2b0b43a0c34f57d67a0960fd" :answer/id #uuid "7d5b40c3-6bb8-53c0-ba65-b650e8c3b4f8" :answer/type :answer.type/math :answer/value "\\frac{s}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-330834/selection/3daf8f916039cdf7a19ecae46a3714a4436a1152b7ddfad354b3123da1741a86" :answer/id #uuid "d55888b8-e3f1-5f48-a556-6ce46e7bc95f" :answer/type :answer.type/math :answer/value "\\frac{3}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-330834/selection/f7fe0bba9ed4f469e4a8e434126237f452a659063b938d7d0e7eabbfcead67c8" :answer/id #uuid "c7658c56-01de-5952-87d3-95530f751fad" :answer/type :answer.type/math :answer/value "\\frac{9}{{s}^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-330834/selection/cd15cc235fc211fc3154a9274683caa7ad9aef6b16e78055152077be6f43448c" :answer/id #uuid "1c126a11-c24e-5907-a06e-39c9e3bf62da" :answer/type :answer.type/math :answer/value "\\frac{9}{s}" :db/ensure [:answer/validate]} {:db/id "q-330834/selection/fd1a9e872361f6edd34eb38a79da4d787635d9164856e9dc648899fef84ba1fe" :answer/id #uuid "6042d970-55f4-547c-9fab-c02aca569b08" :answer/type :answer.type/math :answer/value "\\frac{3}{s({s}^{2}+9)}" :db/ensure [:answer/validate]} {:db/id "q-330834/selection" :answer-field/id #uuid "31db30ac-c995-5373-ac95-912b2869a939" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-330834/selection/fd1a9e872361f6edd34eb38a79da4d787635d9164856e9dc648899fef84ba1fe" :answer-field/choices ["q-330834/selection/497df57bfa05156bdd61180254df57923521e8dc2b0b43a0c34f57d67a0960fd" "q-330834/selection/3daf8f916039cdf7a19ecae46a3714a4436a1152b7ddfad354b3123da1741a86" "q-330834/selection/f7fe0bba9ed4f469e4a8e434126237f452a659063b938d7d0e7eabbfcead67c8" "q-330834/selection/cd15cc235fc211fc3154a9274683caa7ad9aef6b16e78055152077be6f43448c" "q-330834/selection/fd1a9e872361f6edd34eb38a79da4d787635d9164856e9dc648899fef84ba1fe"] :db/ensure [:answer-field/validate]} {:db/id "q-330834" :question/id #uuid "fbe76a17-debc-55e3-a3e3-b3e4019267d5" :question/math-academy-id "q-330834" :question/problem "Given that $L{\\operatorname{sin}⁡(\\omega t)}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}$ for $s>0$, find the Laplace transform of\n$g(t)={\\int }_{0}^{t}\\operatorname{sin}⁡(3τ)\\,\\text{d}τ$\nfor $s>0.$" :question/worked-solution "We know that if $L{f(t)}=F(s)$, then\n\n$$\nL{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ}=\\frac{F(s)}{s}.\n$$\n\nIn our case, $f(t)=\\operatorname{sin}⁡(3t).$ Thus, for $s>0,$\n\n$$\n\\begin{aligned}F(s) & =L{f(t)} \\\\  & =L{\\operatorname{sin}⁡(3t)} \\\\  & =\\frac{3}{{s}^{2}+9}.\\end{aligned}\n$$\n\nTherefore, applying the integral identity above, we have that for $s>0,$\n\n$$\n\\begin{aligned}L{g(t)} & =L{{\\int }_{0}^{t}\\operatorname{sin}⁡(3τ)\\,\\text{d}τ} \\\\  & =\\frac{F(s)}{s} \\\\  & =\\frac{3}{s({s}^{2}+9)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-330834/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4241972f-4023-5638-aa7a-9e4a75167c3d"] :knowledge-point/questions ["q-330834"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330843/selection/00688841e92fda97b128be81e2d18a5e2f052433ea9ec91cec46a6a551a19983" :answer/id #uuid "7a7f4e7e-7357-50a0-9909-30b738690cbb" :answer/type :answer.type/math :answer/value "\\frac{{t}^{5}}{5}" :db/ensure [:answer/validate]} {:db/id "q-330843/selection/7c6052459ababaa1b93c9e56bbb0c866fb8a1036cc62ad3f0f93bc86cc5397ad" :answer/id #uuid "1d4af458-8e8f-5ded-88cc-5e78f74c4079" :answer/type :answer.type/math :answer/value "\\frac{{t}^{4}}{4}" :db/ensure [:answer/validate]} {:db/id "q-330843/selection/c0777e2fe8a5f09e6320e0f8f43689e48a062049a289577be8b263ce77cb8d80" :answer/id #uuid "089b5ce5-70f8-5899-aff6-f007db63b4c5" :answer/type :answer.type/math :answer/value "{t}^{4}" :db/ensure [:answer/validate]} {:db/id "q-330843/selection/1ec2d83049af2ba4052e00ce5274b78f5c3a99f98899609aabf59103b3951c56" :answer/id #uuid "df4aa97d-76a5-5529-a9b4-c3c6623d09fd" :answer/type :answer.type/math :answer/value "\\frac{{t}^{6}}{30}" :db/ensure [:answer/validate]} {:db/id "q-330843/selection/3d517b104936b9dfad520b6232b95a68dd3cd600a2b632e3475643413b919742" :answer/id #uuid "ade2c17e-1ff2-5ab5-937f-d45c8a27fc85" :answer/type :answer.type/math :answer/value "\\frac{24}{{t}^{5}}" :db/ensure [:answer/validate]} {:db/id "q-330843/selection" :answer-field/id #uuid "b228cf5f-18a3-567c-b410-b04cf395b6fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-330843/selection/00688841e92fda97b128be81e2d18a5e2f052433ea9ec91cec46a6a551a19983" :answer-field/choices ["q-330843/selection/00688841e92fda97b128be81e2d18a5e2f052433ea9ec91cec46a6a551a19983" "q-330843/selection/7c6052459ababaa1b93c9e56bbb0c866fb8a1036cc62ad3f0f93bc86cc5397ad" "q-330843/selection/c0777e2fe8a5f09e6320e0f8f43689e48a062049a289577be8b263ce77cb8d80" "q-330843/selection/1ec2d83049af2ba4052e00ce5274b78f5c3a99f98899609aabf59103b3951c56" "q-330843/selection/3d517b104936b9dfad520b6232b95a68dd3cd600a2b632e3475643413b919742"] :db/ensure [:answer-field/validate]} {:db/id "q-330843" :question/id #uuid "01465358-c6b8-5ae6-b779-bb5cbb3136fb" :question/math-academy-id "q-330843" :question/problem "For the function\n\n$$\nG(s)=\\frac{24}{{s}^{6}},\\,s>0\n$$\n\nfind the inverse Laplace transform of $G(s),$ given that\n$L{{t}^{n}}=\\frac{n!}{{s}^{n+1}}.$" :question/worked-solution "Notice that we can write $G(s)$ as \n\n$$\nG(s)=\\frac{24}{{s}^{6}}=\\frac{F(s)}{s},\n$$\n\nwhere $F(s)=\\frac{24}{{s}^{5}}.$\nAlso, we know that\n\n$$\nL{{t}^{n}}=\\frac{n!}{{s}^{n+1}}.\n$$\n\nThus, we get\n\n$$\n\\begin{aligned}{L}^{-1}{F(s)} & ={L}^{-1}{\\frac{24}{{s}^{5}}} \\\\  & ={L}^{-1}{\\frac{4!}{{s}^{4+1}}} \\\\  & ={t}^{4}.\\end{aligned}\n$$\n\nAdditionally, we know that if $L{f(t)}=F(s)$, then\n\n$$\nL{{\\int }_{0}^{t}f(τ)\\,\\text{d}τ}=\\frac{F(s)}{s}.\n$$\n\nUsing the property above in reverse, we obtain\n\n$$\n\\begin{aligned}{L}^{-1}{G(s)} & ={L}^{-1}{\\frac{F(s)}{s}} \\\\  & ={\\int }_{0}^{t}f(τ)\\,\\text{d}τ \\\\  & ={\\int }_{0}^{t}{τ}^{4}\\,\\text{d}τ \\\\  & =\\frac{{t}^{5}}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-330843/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a65eeb21-bcd5-542d-8277-04dab7fa9b53"] :knowledge-point/questions ["q-330843"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330845/selection/3759f318ca79e7f0264d8cf7f61a250a5d94b9f40891445614030011fa9478d6" :answer/id #uuid "dafe35c1-d10d-538b-a04a-99d6625f0305" :answer/type :answer.type/math :answer/value "\\frac{{t}^{7}}{7}" :db/ensure [:answer/validate]} {:db/id "q-330845/selection/45f49139ac6144cba1b0605c45da09c0e57ffb48f62f112d31a6fdd330cb8c19" :answer/id #uuid "950c95cd-a26c-58c0-b4a0-e6645f55d248" :answer/type :answer.type/math :answer/value "\\frac{{t}^{6}}{6}" :db/ensure [:answer/validate]} {:db/id "q-330845/selection/170d285d7701bc1c618d88f807e16c9dfedf6bf5f9a1c1a86c063d636d8aef19" :answer/id #uuid "74f8333e-c013-5004-a153-a044d6e5f54b" :answer/type :answer.type/math :answer/value "\\frac{{t}^{8}}{56}" :db/ensure [:answer/validate]} {:db/id "q-330845/selection/928073ef6261ebc69b0fbe48a36a663778d044474edef6a45358f1b13d865d3b" :answer/id #uuid "c3642f6c-90d4-5f1a-a4e8-de424396c6a6" :answer/type :answer.type/math :answer/value "\\frac{720}{{t}^{7}}" :db/ensure [:answer/validate]} {:db/id "q-330845/selection/8fcadbfc88b86a43812522477e70e876bf59fcfefcd771b8ef6072b39eda1440" :answer/id #uuid "8fbf830f-a49b-51ee-bbc8-861