db/id #edb/ref 17592186319008}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7ceb1bbf-3e69-5a87-a7c8-dd18f74e73dc" :question/math-academy-id "q-340737" :question/problem "What is the Laplace transform of $f(t)={e}^{7\\text{i}t},$ where $t,s\\in R?$$\\,L(f(t))=$\n{{field-1}},\ndefined for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{7\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{7\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(7\\text{i}-s)t}\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{(\\frac{1}{7\\text{i}-s}{e}^{(7\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{7\\text{i}-s}({lim}_{a\\to \\infty }{e}^{(7\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s-7\\text{i}}(1-{lim}_{a\\to \\infty }{e}^{(7\\text{i}-s)a}) \\\\  & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}({lim}_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{7\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[{lim}_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s-7\\text{i}}-\\frac{1}{s-7\\text{i}}[{lim}_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(7a)+\\text{i}\\operatorname{sin}⁡(7a))] \\\\  & =\\frac{1}{s-7\\text{i}}-0 \\\\  & =\\frac{1}{s-7\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{7\\text{i}t}$ is $F(s)=\\frac{1}{s-7\\text{i}},$ defined for $s>0.$"}] [{:db/id #edb/ref 17592186319013 :knowledge-point/_questions [{:knowledge-point/id #uuid "a90a0c43-d87f-5639-826d-854b90876a27" :knowledge-point/title "Evaluating Laplace Transforms of Complex Exponentials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a3f7b281-3b1f-584c-b958-0b1bbbcafc55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{s-2\\text{i}}" :db/id #edb/ref 17592186319015} {:answer/id #uuid "4ca84e21-cf26-55f6-b772-9ae298488565" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s}{s-2\\text{i}}" :db/id #edb/ref 17592186319016} {:answer/id #uuid "06e79bfb-5f79-56e8-931f-ce977176e3b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{s+2\\text{i}}" :db/id #edb/ref 17592186319017} {:answer/id #uuid "552c1574-daad-507e-8dd1-2cc5e30a61b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s}{s+2\\text{i}}" :db/id #edb/ref 17592186319018}] :answer-field/correct {:answer/id #uuid "06e79bfb-5f79-56e8-931f-ce977176e3b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{s+2\\text{i}}" :db/id #edb/ref 17592186319017} :answer-field/id #uuid "4cf5c7d7-a0a0-59e8-b7b3-2d5f615034d8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186319014} {:answer-field/choices [{:answer/id #uuid "7dea6f64-253f-5569-a2f3-7aed35b3c679" :answer/type {:db/ident :answer.type/math} :answer/value "s>2" :db/id #edb/ref 17592186319020} {:answer/id #uuid "057ec61c-57f3-581e-86fb-09ce7ea405f5" :answer/type {:db/ident :answer.type/math} :answer/value "s<0" :db/id #edb/ref 17592186319021} {:answer/id #uuid "fb8a15dd-ac8d-5d71-bd54-b98793cb98d2" :answer/type {:db/ident :answer.type/math} :answer/value "s>-2" :db/id #edb/ref 17592186319022} {:answer/id #uuid "bc001ba4-870d-561c-ad7a-ce57c50c6a53" :answer/type {:db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186319023}] :answer-field/correct {:answer/id #uuid "bc001ba4-870d-561c-ad7a-ce57c50c6a53" :answer/type {:db/ident :answer.type/math} :answer/value "s>0" :db/id #edb/ref 17592186319023} :answer-field/id #uuid "4fb7cfe1-3f49-5dc4-98c8-df27a28d9bc4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186319019}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6d496131-eb76-5d80-badb-663fceb92c31" :question/math-academy-id "q-340739" :question/problem "What is the Laplace transform of $f(t)={e}^{-2\\text{i}t},$ where $t,s\\in R?$$\\,L(f(t))=$\n{{field-1}},\ndefined for {{field-2}}." :question/worked-solution "We apply the definition of the Laplace transform:\n\n$$\n\\begin{aligned}L{f(t)} & =F(s)={\\int }_{0}^{\\infty }{e}^{-st}f(t)\\text{d}t\\end{aligned}\n$$\n\nFor the function $f(t)={e}^{-2\\text{i}t},$ we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{-st}{e}^{-2\\text{i}t}\\text{d}t={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t.\\end{aligned}\n$$\n\nEvaluating in the usual way, we have\n\n$$\n\\begin{aligned}F(s) & ={\\int }_{0}^{\\infty }{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}{e}^{(-2\\text{i}-s)t}\\text{d}t \\\\  & ={lim}_{a\\to \\infty }{(\\frac{1}{-2\\text{i}-s}{e}^{(-2\\text{i}-s)t})|}_{0}^{a} \\\\  & =\\frac{1}{-2\\text{i}-s}({lim}_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}-1) \\\\  & =\\frac{1}{s+2\\text{i}}(1-{lim}_{a\\to \\infty }{e}^{(-2\\text{i}-s)a}) \\\\  & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}({lim}_{a\\to \\infty }{e}^{-sa}\\cdot {e}^{-2\\text{i}a}).\\end{aligned}\n$$\n\nNow, we recall Euler's formula:\n\n$$\n{e}^{\\text{i}\\theta }=\\operatorname{cos}⁡\\theta +\\text{i}\\operatorname{sin}⁡\\theta \n$$\n\nTherefore, we have\n\n$$\nF(s)=\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[{lim}_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))].\n$$\n\nNow, we have the following cases:\n\n- For $s<0,$ the term ${e}^{-sa}$ increases without bound while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s<0.$\n\n- For $s=0,$ we have simply $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a),$ which oscillates rapidly as $a\\to \\infty .$ Therefore, the limit does not exist for $s=0.$\n\n- For $s>0,$ the term ${e}^{-sa}$ decays to zero while $\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a)$ oscillates rapidly as $a\\to \\infty .$ Therefore, the limit of their product equals zero.\n\nTherefore, for $s>0,$ we have\n\n$$\n\\begin{aligned}F(s) & =\\frac{1}{s+2\\text{i}}-\\frac{1}{s+2\\text{i}}[{lim}_{a\\to \\infty }{e}^{-sa}\\cdot (\\operatorname{cos}⁡(-2a)+\\text{i}\\operatorname{sin}⁡(-2a))] \\\\  & =\\frac{1}{s+2\\text{i}}-0 \\\\  & =\\frac{1}{s+2\\text{i}}.\\end{aligned}\n$$\n\nSo, the Laplace transform of ${e}^{-2\\text{i}t}$ is $F(s)=\\frac{1}{s+2\\text{i}},$ defined for $s>0.$"}] [{:db/id #edb/ref 17592186319024 :knowledge-point/_questions [{:knowledge-point/id #uuid "a90a0c43-d87f-5639-826d-854b90876a27" :knowledge-point/title "Evaluating Laplace Transforms of Complex Exponentials"}] :question/answer-field