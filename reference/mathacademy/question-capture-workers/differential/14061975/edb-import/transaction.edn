ac{x-3}{(x+2)(x-1)}{y}^{′}+\\frac{1}{(x+2)(x-1)}y & =0\\end{aligned}\n$$\n\nSo, we have\n\n$$\nP(x)=\\frac{x-3}{(x+2)(x-1)}\\,\\text{and}\\,Q(x)=\\frac{1}{(x+2)(x-1)}.\n$$\n\nLet's now check the analyticity of these functions at the given points.\n\n- *Both* functions are analytic about $x=0.$ So, $x=0$ is an ordinary point of the differential equation.\n\n- *Neither* function is analytic about $x=-2,$ since both denominators at $x=-2$ equal zero. So, $x=-2$ is a singular point of the differential equation.\n\n- *Neither* function is analytic about $x=1,$ since both denominators at $x=1$ equal zero. So, $x=1$ is a singular point of the differential equation.\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342296/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "12a9f9cf-06f6-51b8-ba41-a8b6300a5c2b"] :knowledge-point/questions ["q-342296"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342275/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "05eb6030-2e71-51ed-ae10-204baff663d4" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-342275/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "fae7bd40-83c2-5785-921a-2dc6c471e78c" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-342275/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "d9385934-3ecd-5d2c-8c47-55b0d029753d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-342275/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "ecdb6aa8-2229-5c15-8a52-4f28fcaad68d" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-342275/selection/431472f1dab61ef54de0