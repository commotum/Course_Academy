ef 17592186311867} :answer-field/id #uuid "2edc6663-528b-5117-a993-c28663e2976d" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311866} {:answer-field/choices [{:answer/id #uuid "8da9a210-a581-530d-a1a8-80b6e0a92b9d" :answer/type {:db/ident :answer.type/math} :answer/value "K=1" :db/id #edb/ref 17592186311872} {:answer/id #uuid "108fc7d1-f96f-552b-a6fa-c937815357b2" :answer/type {:db/ident :answer.type/math} :answer/value "K=4" :db/id #edb/ref 17592186311873} {:answer/id #uuid "a4060fa3-f00e-558e-9af6-e70e7b246f93" :answer/type {:db/ident :answer.type/math} :answer/value "K=3" :db/id #edb/ref 17592186311874}] :answer-field/correct {:answer/id #uuid "108fc7d1-f96f-552b-a6fa-c937815357b2" :answer/type {:db/ident :answer.type/math} :answer/value "K=4" :db/id #edb/ref 17592186311873} :answer-field/id #uuid "d023ca66-b001-5597-8119-6fde1567fdc7" :answer-field/key "field-8" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311871} {:answer-field/choices [{:answer/id #uuid "4e8e6874-45df-53e8-bd8c-10073c9f46aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =4" :db/id #edb/ref 17592186311876} {:answer/id #uuid "1ed46dca-1423-5cf9-873e-42e35e31e488" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =\\frac{1}{2}" :db/id #edb/ref 17592186311877} {:answer/id #uuid "5938ad42-5e9a-5fc5-9773-473f20843394" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =1" :db/id #edb/ref 17592186311878}] :answer-field/correct {:answer/id #uuid "5938ad42-5e9a-5fc5-9773-473f20843394" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =1" :db/id #edb/ref 17592186311878} :answer-field/id #uuid "58cb3e3d-20c1-5306-9a25-98921adba7e1" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311875}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b8c0eabe-c032-59c7-8dc3-d9808369162b" :question/math-academy-id "q-334064" :question/problem "For the polynomial $f(x)=3{x}^{2}+x,$ show that $f=O(x)$ as $x\\to 0.$We say $f(x)$ is of order $g(x)$ as $x\\to a,$ and we write \n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nif there exist {{field-1}} constants $K$ and $\\delta $ such that\n\n$$\n{{field-2}}\\,\\text{for all}\\,0<|x-a|<\\delta .\n$$\n\nSo, in our case, we need to show that\n\n$$\n{{field-3}}\\,\\text{for}\\,{{field-4}}.\n$$\n\nBy the triangle inequality,\n\n$$\n\\begin{aligned}|f(x)| & \\le {{field-5}}.\\end{aligned}\n$$\n\nNow, let $|x|<1.$ Then, we have {{field-6}}, and the best upper bound we can form is\n\n$$\n\\begin{aligned}|f(x)| & \\le {{field-7}}.\\end{aligned}\n$$\n\nTherefore, $|f(x)|\\le 4|x|$ whenever $|x|<1.$ Thus, taking \n\n$$\n{{field-8}},\\,{{field-9}}\n$$\n\n satisfies the definition, and we conclude that $f(x)=O(x)$ as $x\\to 0.$" :question/worked-solution "We say $f(x)$ is of order $g(x)$ as $x\\to a,$ and we write \n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nif there exist $\\text{positive}$ constants $K$ and $\\delta $ such that\n\n$$\n|f(x)|\\le K|g(x)|\\,\\text{for all}\\,0<|x-a|<\\delta .\n$$\n\n \n\nSo, in our case, we need to show that\n\n$$\n|f(x)|\\le K|x|\\,\\text{for}\\,0<|x|<\\delta .\n$$\n\nBy the triangle inequality, we have\n\n$$\n\\begin{aligned}|f(x)| & =|3{x}^{2}+x| \\\\  & \\le |3{x}^{2}|+|x| \\\\  & =3|x{|}^{2}+|x|.\\end{aligned}\n$$\n\nIf $|x|<1,$ then we have $|x{|}^{2}<|x|.$ Therefore,\n\n$$\n3|x{|}^{2}\\le 3|x|.\n$$\n\nHence\n\n$$\n\\begin{aligned}|f(x)| & \\le 3|x{|}^{2}+|x| \\\\  & \\le 3|x|+|x| \\\\  & =4|x|.\\end{aligned}\n$$\n\nTherefore, $|f(x)|\\le 4|x|$ whenever $|x|<1.$ Thus, taking $K=4$ and $\\delta =1$ satisfies the definition, and we conclude that $f=O(x)$ as $x\\to 0.$"}] [{:db/id #edb/ref 17592186157692 :knowledge-point/_questions [{:knowledge-point/id #uuid "b841cdab-5473-5eeb-a02a-1d1acbae2984" :knowledge-point/title "Applying the Limit Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b326f7d-4b2c-5d3e-a4a2-86e3c9f76e84" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186155341} {:answer/id #uuid "bfdd90db-c0a9-5e9c-80cf-bf2f97247385" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186155342} {:answer/id #uuid "c94bd940-f361-5973-ba21-380107c0f4b1" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186155343} {:answer/id #uuid "39702b3c-c244-524d-8ac1-c4fe87ac4b9c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186155344} {:answer/id #uuid "3d53d82f-c35e-52c6-8873-f6d52c2e56af" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186155345}] :answer-field/correct {:answer/id #uuid "bfdd90db-c0a9-5e9c-80cf-bf2f97247385" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186155342} :answer-field/id #uuid "31db3fd7-9e37-53bf-8ed3-31e1cc5933df" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186155340}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c0a1373b-0f2f-546e-8300-5cb2dc8f926e" :question/math-academy-id "q-334693" :question/problem "Suppose $f(x)=x+2{e}^{2x}.$ Which of the following statements are true?\n\n- $f=O(x)$ as $x\\to \\infty $\n- $f=O({e}^{2x})$ as $x\\to \\infty $\n- $f=O({e}^{3x})$ as $x\\to \\infty $" :question/worked-solution "Suppose we wish to test whether the following statement is true:\n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nwhere $a$ is either finite or $+\\infty .$ To do this, we can examine the following limit:\n\n$$\n{lim}_{x\\to a}\\frac{f(x)}{g(x)}\n$$\n\nWe have the following:\n\n- If the limit is *finite*, the statement is true.\n\n- If the limit is *infinite*, the statement is false.\n\n- If the limit does not exist, the test is inconclusive.\n\nHere, we must consider the function\n\n$$\nf(x)=x+2{e}^{2x}.\n$$\n\nNow, let's consider each statement in turn.\n\n- Statement I is false. Let $g(x)=x.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{g(x)} & ={lim}_{x\\to \\infty }\\frac{x+2{e}^{2x}}{x}.\\end{aligned}\n$$\n\nSince direct evaluation leads to the indeterminate form $\\frac{\\infty }{\\infty },$ we can evaluate the limit using L'Hopital's rule:\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{g(x)} & ={lim}_{x\\to \\infty }\\frac{x+2{e}^{2x}}{x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(x+2{e}^{2x})^{′}}{(x)^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{1+4{e}^{2x}}{1} \\\\  & ={lim}_{x\\to \\infty }(1+4{e}^{2x}) \\\\  & =\\infty \\end{aligned}\n$$\n\nHence, $f\\ne O(x)$ as $x\\to \\infty .$\n\n- Statement II is true. Let $g(x)={e}^{2x}.$ Then, using L'Hopital's rule where needed, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{g(x)} & ={lim}_{x\\to \\infty }\\frac{x+2{e}^{2x}}{{e}^{2x}} \\\\  & ={lim}_{x\\to \\infty }(\\frac{x}{{e}^{2x}}+\\frac{2{e}^{2x}}{{e}^{2x}}) \\\\  & ={lim}_{x\\to \\infty }\\frac{x}{{e}^{2x}}+2 \\\\  & ={lim}_{x\\to \\infty }\\frac{(x)^{′}}{({e}^{2x})^{′}}+2 \\\\  & ={lim}_{x\\to \\infty }\\frac{1}{2{e}^{2x}}+2 \\\\  & =0+2 \\\\  & =2.\\end{aligned}\n$$\n\nHence, $f=O({e}^{2x})$ as $x\\to \\infty .$\n\n- Statement III is true. Let $g(x)={e}^{3x}.$ Then, using L'Hopital's rule where needed, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{f(x)}{g(x)} & ={lim}_{x\\to \\infty }\\frac{x+2{e}^{2x}}{{e}^{3x}} \\\\  & ={lim}_{x\\to \\infty }(\\frac{x}{{e}^{3x}}+\\frac{2{e}^{2x}}{{e}^{3x}}) \\\\  & ={lim}_{x\\to \\infty }\\frac{x}{{e}^{3x}}+{lim}_{x\\to \\infty }2{e}^{-x} \\\\  & ={lim}_{x\\to \\infty }\\frac{(x)^{′}}{({e}^{3x})^{′}}+0 \\\\  & ={lim}_{x\\to \\infty }\\frac{1}{3{e}^{3x}} \\\\  & =0.\\end{aligned}\n$$\n\nHence, $f=O({e}^{3x})$ as $x\\to \\infty .$\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186311879 :knowledge-point/_questions [{:knowledge-point/id #uuid "b841cdab-5473-5eeb-a02a-1d1acbae2984" :knowledge-point/title "Applying the Limit Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b3805f0-7b98-5525-9db0-9d344a28cccd" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186311881} {:answer/id #uuid "5b963d7f-263b-5cbd-8398-a97be9147a41" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186311882} {:answer/id #uuid "a82f3661-9ac3-5dfa-b057-345c37c6608a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186311883} {:answer/id #uuid "13cc66a7-248e-544d-8e52-5db234c642d5" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186311884} {:answer/id #uuid "2e82a7ba-5ac2-51de-aae0-302de9d656ff" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186311885}] :answer-field/correct {:answer/id #uuid "a82f3661-9ac3-5dfa-b057-345c37c6608a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186311883} :answer-field/id #uuid "104ad863-c700-55ff-8085-06fe59b9d4f9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311880}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4532dbb6-e08c-509a-be1c-9f1169938166" :question/math-academy-id "q-334844" :question/problem "Suppose $f(x)={x}^{2}+3{x}^{4}.$ Which of the following statements are true?\n\n- $f=O({x}^{2})$ as $x\\to 0$\n- $f=O({x}^{3})$ as $x\\to 0$\n- $f=O({x}^{4})$ as $x\\to 0$" :question/worked-solution "Suppose we wish to test whether the following statement is true:\n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nwhere $a$ is either finite or $+\\infty .$ To do this, we can examine the following limit:\n\n$$\n{lim}_{x\\to a}\\frac{f(x)}{g(x)}\n$$\n\nWe have the following:\n\n- If the limit is *finite*, the statement is true.\n\n- If the limit is *infinite*, the statement is false.\n\n- If the limit does not exist, the test is inconclusive.\n\nHere, we must consider the function\n\n$$\nf(x)={x}^{2}+3{x}^{3}.\n$$\n\nNow, let's consider each statement in turn.\n\n- Statement I is true. Let $g(x)={x}^{2}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{{x}^{2}+3{x}^{4}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}(1+3{x}^{2}) \\\\  & =1+0 \\\\  & =1.\\end{aligned}\n$$\n\nHence, the limit is finite, and $f=O({x}^{2})$ as $x\\to 0.$\n\n- Statement II is false. Let $g(x)={x}^{3}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{{x}^{2}+3{x}^{4}}{{x}^{3}} \\\\  & ={lim}_{x\\to 0}(\\frac{1}{x}+3x)\\end{aligned}\n$$\n\nAs $x\\to 0,$ the term $\\frac{1}{x}$ becomes arbitrarily large in magnitude, while $3x\\to 0.$\nSo\n\n$$\n{lim}_{x\\to 0}(\\frac{1}{x}+3x)=\\infty .\n$$\n\nHence, the limit is infinite, and $f\\ne O({x}^{3})$ as $x\\to 0.$\n\n- Statement III is false. Let $g(x)={x}^{4}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{{x}^{2}+3{x}^{3}}{{x}^{4}} \\\\  & ={lim}_{x\\to 0}(\\frac{1}{{x}^{2}}+3).\\end{aligned}\n$$\n\nAs $x\\to 0,$ the term $\\frac{1}{{x}^{2}}$ becomes arbitrarily large in magnitude, so\n\n$$\n{lim}_{x\\to 0}(\\frac{1}{{x}^{2}}+3)=\\infty .\n$$\n\nHence, the limit is infinite, and $f\\ne O({x}^{4})$ as $x\\to 0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186311886 :knowledge-point/_questions [{:knowledge-point/id #uuid "b841cdab-5473-5eeb-a02a-1d1acbae2984" :knowledge-point/title "Applying the Limit Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "172ea192-78a5-5e49-b744-6a8baa08acda" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186311888} {:answer/id #uuid "42111e02-9371-5e63-ab44-b7c1ae8dae16" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186311889} {:answer/id #uuid "86e14de0-68c8-5086-89e6-b33a478042bb" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186311890} {:answer/id #uuid "32f40265-783a-56ac-ba3e-500fb4a814d5" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186311891} {:answer/id #uuid "21bbff0b-9973-5b8f-b256-c1f85e851ccb" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186311892}] :answer-field/correct {:answer/id #uuid "86e14de0-68c8-5086-89e6-b33a478042bb" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186311890} :answer-field/id #uuid "c48d73f6-47d5-5c39-8ba8-ed88a36f22a3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311887}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6baf355b-78cd-5398-be00-248e1b50b7c3" :question/math-academy-id "q-334851" :question/problem "Suppose $f(x)=3{x}^{5}-2x.$ Which of the following statements are true?\n\n- $f=O(1)$ as $x\\to 0$\n- $f=O({x}^{2})$ as $x\\to 0$\n- $f=O({x}^{3})$ as $x\\to 0$" :question/worked-solution "Suppose we wish to test whether the following statement is true:\n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nTo do this, we can examine the following limit:\n\n$$\n{lim}_{x\\to a}\\frac{f(x)}{g(x)}.\n$$\n\nWe have the following:\n\n- If the limit is *finite*, the statement is true.\n\n- If the limit is *infinite*, the statement is false.\n\n- If the limit does not exist, the test is inconclusive.\n\nHere, we must consider the polynomial\n\n$$\nf(x)=3{x}^{5}-2x+1.\n$$\n\nNow, let's consider each statement in turn.\n\n- Statement I is true. Let $g(x)=1.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{3{x}^{5}-2x}{1} \\\\  & ={lim}_{x\\to 0}(3{x}^{5}-2x) \\\\  & =0.\\end{aligned}\n$$\n\nHence, $f=O(1)$ as $x\\to 0.$\n\n- Statement II is true. Let $g(x)={x}^{2}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{3{x}^{5}-2x}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}(3{x}^{3}-\\frac{2}{x}) \\\\  & =\\infty .\\end{aligned}\n$$\n\nHence, $f\\ne O({x}^{2})$ as $x\\to 0.$\n\n- Statement III is false. Let $g(x)={x}^{3}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{3{x}^{5}-2x}{{x}^{3}} \\\\  & ={lim}_{x\\to 0}(3{x}^{2}-\\frac{2}{{x}^{2}}) \\\\  & =\\infty .\\end{aligned}\n$$\n\nHence, $f\\ne O({x}^{3})$ as $x\\to 0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186311893 :knowledge-point/_questions [{:knowledge-point/id #uuid "b841cdab-5473-5eeb-a02a-1d1acbae2984" :knowledge-point/title "Applying the Limit Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29b1e509-a55b-544c-8fa1-df3d44ab4707" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186311895} {:answer/id #uuid "f17b6434-33b6-5ae3-9d2a-a41a11f85914" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186311896} {:answer/id #uuid "07621f03-b279-591e-8c1c-f11d8cd53620" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186311897} {:answer/id #uuid "abbf90be-89e4-52f6-b57b-8be0c66e7fdc" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186311898} {:answer/id #uuid "4721e388-171d-5491-8348-35fc45afc4b8" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186311899}] :answer-field/correct {:answer/id #uuid "abbf90be-89e4-52f6-b57b-8be0c66e7fdc" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186311898} :answer-field/id #uuid "b1fdabeb-c6b0-5c19-a3de-3239cb4a7475" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311894}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cc4e3317-664d-5f74-b98c-64774bbc76e5" :question/math-academy-id "q-334854" :question/problem "Suppose $f(x)=2{x}^{2}+\\operatorname{sin}⁡x.$ Which of the following statements are true?\n\n- $f=O(1)$ as $x\\to 0$\n- $f=O(x)$ as $x\\to 0$\n- $f=O({x}^{2})$ as $x\\to 0$" :question/worked-solution "Suppose we wish to test whether the following statement is true:\n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nTo do this, we can examine the following limit:\n\n$$\n{lim}_{x\\to a}\\frac{f(x)}{g(x)}.\n$$\n\nWe have the following:\n\n- If the limit is *finite*, the statement is true.\n\n- If the limit is *infinite*, the statement is false.\n\n- If the limit does not exist, the test is inconclusive.\n\nHere, we must consider the function\n\n$$\nf(x)=2{x}^{2}+\\operatorname{sin}⁡x.\n$$\n\nNow, let's consider each statement in turn.\n\n- Statement I is true. Let $g(x)=1.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{2{x}^{2}+\\operatorname{sin}⁡x}{1} \\\\  & ={lim}_{x\\to 0}(2{x}^{2}+\\operatorname{sin}⁡x) \\\\  & =0.\\end{aligned}\n$$\n\nHence, $f=O(1)$ as $x\\to 0.$\n\n- Statement II is true. Let $g(x)=x.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{2{x}^{2}+\\operatorname{sin}⁡x}{x} \\\\  & ={lim}_{x\\to 0}(2x+\\frac{\\operatorname{sin}⁡x}{x}) \\\\  & =0+1 \\\\  & =1.\\end{aligned}\n$$\n\nHere we used the fact that ${lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{x}=1.$ Hence, $f=O(x)$ as $x\\to 0.$\n\n- Statement III is false. Let $g(x)={x}^{2}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{2{x}^{2}+\\operatorname{sin}⁡x}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}(2+\\frac{\\operatorname{sin}⁡x}{{x}^{2}}).\\end{aligned}\n$$\n\nNow, near $x=0$ we know that $\\operatorname{sin}⁡x≈x,$ so $\\frac{\\operatorname{sin}⁡x}{{x}^{2}}$ behaves like $\\frac{1}{x},$ which becomes arbitrarily large in magnitude as $x\\to 0.$ Thus,\n\n$$\n{lim}_{x\\to 0}(2+\\frac{\\operatorname{sin}⁡x}{{x}^{2}})=\\infty .\n$$\n\nHence, $f\\ne O({x}^{2})$ as $x\\to 0.$\n\nTherefore, the correct answer is \"I and II only.\""}] [{:db/id #edb/ref 17592186311900 :knowledge-point/_questions [{:knowledge-point/id #uuid "b841cdab-5473-5eeb-a02a-1d1acbae2984" :knowledge-point/title "Applying the Limit Test"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "70b12f43-bd26-5796-a7c6-e09990d05be7" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186311902} {:answer/id #uuid "818f01f0-2a8a-5b22-a7f5-03c8d1f423ce" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186311903} {:answer/id #uuid "179a72d1-710b-5833-a086-2a6dac61d974" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186311904} {:answer/id #uuid "63f92c9d-925b-5fef-bbc9-e4a3397fec3a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186311905} {:answer/id #uuid "123cc168-5ca7-5c6d-82b9-996db527bf9e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186311906}] :answer-field/correct {:answer/id #uuid "179a72d1-710b-5833-a086-2a6dac61d974" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186311904} :answer-field/id #uuid "24d2ffa4-6c2c-548b-805c-72c2d67d9a1f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186311901}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f7095015-907c-5c04-8fc8-1aaf159138a3" :question/math-academy-id "q-334861" :question/problem "Suppose $f(x)=-3{x}^{3}+\\operatorname{cos}⁡x.$ Which of the following statements are true?\n\n- $f=O(1)$ as $x\\to 0$\n- $f=O(x)$ as $x\\to 0$\n- $f=O({x}^{2})$ as $x\\to 0$" :question/worked-solution "Suppose we wish to test whether the following statement is true:\n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nTo do this, we can examine the following limit:\n\n$$\n{lim}_{x\\to a}\\frac{f(x)}{g(x)}.\n$$\n\nWe have the following:\n\n- If the limit is *finite*, the statement is true.\n\n- If the limit is *infinite*, the statement is false.\n\n- If the limit does not exist, the test is inconclusive.\n\nHere, we must consider the function\n\n$$\nf(x)=-3{x}^{3}+\\operatorname{cos}⁡x.\n$$\n\nNow, let's consider each statement in turn.\n\n- Statement I is true. Let $g(x)=1.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{-3{x}^{3}+\\operatorname{cos}⁡x}{1} \\\\  & ={lim}_{x\\to 0}(-3{x}^{3}+\\operatorname{cos}⁡x) \\\\  & =1.\\end{aligned}\n$$\n\nHence, $f=O(1)$ as $x\\to 0.$\n\n- Statement II is false. Let $g(x)=x.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{-3{x}^{3}+\\operatorname{cos}⁡x}{x} \\\\  & ={lim}_{x\\to 0}(-3{x}^{2}+\\frac{\\operatorname{cos}⁡x}{x}).\\end{aligned}\n$$\n\nNear $x=0,$ we have $\\operatorname{cos}⁡x≈1.$ Therefore,\n\n$$\n\\frac{\\operatorname{cos}⁡x}{x}≈\\frac{1}{x},\n$$\n\nwhich becomes arbitrarily large in magnitude as $x\\to 0.$ Thus,\n\n$$\n{lim}_{x\\to 0}(-3{x}^{2}+\\frac{\\operatorname{cos}⁡x}{x})=\\infty .\n$$\n\nHence, $f\\ne O(x)$ as $x\\to 0.$\n\n- Statement III is false. Let $g(x)={x}^{2}.$ Then, we have\n\n$$\n\\begin{aligned}{lim}_{x\\to a}\\frac{f(x)}{g(x)} & ={lim}_{x\\to 0}\\frac{-3{x}^{3}+\\operatorname{cos}⁡x}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}(-3x+\\frac{\\operatorname{cos}⁡x}{{x}^{2}}).\\end{aligned}\n$$\n\nSince $\\operatorname{cos}⁡x≈1$ near $x=0,$\n\n$$\n\\frac{\\operatorname{cos}⁡x}{{x}^{2}}≈\\frac{1}{{x}^{2}},\n$$\n\nwhich becomes arbitrarily large in magnitude as $x\\to 0.$ Hence,\n\n$$\n{lim}_{x\\to 0}(-3x+\\frac{\\operatorname{cos}⁡x}{{x}^{2}})=\\infty .\n$$\n\nThus, $f\\ne O({x}^{2})$ as $x\\to 0.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186311907 :knowledge-point/_questions [{:knowledge-point/id #uuid "ffe4292f-7653-5486-975e-c206acae734e" :knowledge-point/title "Applying Properties of Big-O"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f69450f5-3826-5ec4-9395-3addde505008" :answer/type {:db/ident :answer.type/text} :answer/value "the absorption property" :db/id #edb/ref 17592186311909} {:answer/id #uuid "9732a179-e270-5883-a7d0-c1e6023b7a53" :answer/type {:db/ident :answer.type/text} :answer/value "the constant multiple property" :db/id #edb/ref 17592186311910} {:answer/id #uuid "042e5e5f-9163-5450-b60f-e571b964ef32" :answer/type {:db/ident :answer.type/text} :answer/value "the sum property" :db/id #edb/ref 17592186311911} {:answer/id #uuid "3a7753e5-8f9d-5303-a33a-6ce60c4b1d20" :answer/type {:db/ident :answer.type/text} :answer/value "the transitive property" :db/id #edb/ref 17592186311912} {:answer/id #uuid "9b6535e3-9b3a-5763-925c-6ff919ad41d6" :answer/type {:db/ident :answer.type/text} :answer/value "the reflexive property" :db/id #edb/ref 17592186311913}] :answer-field/correct {:answer/id #uuid "9b6535e3-9b3a-5763-925c-6ff919ad41d6" :answer/type {:db/ident :answer.type/text} :answer/value "the reflexive property" :db/id #edb/ref 17592186311913} :answer-field/id #uuid "089540ee-6911-5a87-8b20-930cfe6299aa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311908} {:answer-field/choices [{:answer/id #uuid "d97d58ad-02fe-553b-ab4a-71b152c