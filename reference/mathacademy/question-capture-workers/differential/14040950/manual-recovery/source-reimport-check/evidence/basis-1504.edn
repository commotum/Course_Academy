"0<|x|<\\delta " :db/id #edb/ref 17592186311824} :answer-field/id #uuid "f8551d8d-003b-5f75-bafb-faba5a148ee7" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311822} {:answer-field/choices [{:answer/id #uuid "4e039665-148b-5949-b873-00cfd9f6de58" :answer/type {:db/ident :answer.type/math} :answer/value "|x{|}^{4}+2|x|+1" :db/id #edb/ref 17592186311826} {:answer/id #uuid "6ed64dc7-b57d-58bb-a4d6-fb9a98282a67" :answer/type {:db/ident :answer.type/math} :answer/value "8|x{|}^{4}+2|x|+1" :db/id #edb/ref 17592186311827} {:answer/id #uuid "0d38aa10-145c-5f0a-aa38-ae5e20c5f9c4" :answer/type {:db/ident :answer.type/math} :answer/value "8|x{|}^{4}-2|x|" :db/id #edb/ref 17592186311828}] :answer-field/correct {:answer/id #uuid "6ed64dc7-b57d-58bb-a4d6-fb9a98282a67" :answer/type {:db/ident :answer.type/math} :answer/value "8|x{|}^{4}+2|x|+1" :db/id #edb/ref 17592186311827} :answer-field/id #uuid "450e20f7-b2f1-5976-a14b-1312fc9d8b21" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311825} {:answer-field/choices [{:answer/id #uuid "04214b34-6e71-519f-9339-0019c6a207f5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186311830} {:answer/id #uuid "afc6595e-ce37-59fb-857e-b58449683022" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186311831} {:answer/id #uuid "2f0db417-05ed-5185-8b5b-9c4762620d15" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186311832} {:answer/id #uuid "7ca26f71-0cc9-5232-83fa-4e99ab075c82" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186311833} {:answer/id #uuid "69f271f7-2c52-55ac-8762-016a3b3f8837" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186311834}] :answer-field/correct {:answer/id #uuid "04214b34-6e71-519f-9339-0019c6a207f5" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186311830} :answer-field/id #uuid "8c007486-db34-5d39-b002-402c7d0ec1f1" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311829} {:answer-field/choices [{:answer/id #uuid "1b59b404-3523-5683-8426-e03f779b3a9c" :answer/type {:db/ident :answer.type/math} :answer/value "K=\\frac{1}{2}" :db/id #edb/ref 17592186311836} {:answer/id #uuid "2a171b34-8999-5b54-a77c-89b78cd78e5a" :answer/type {:db/ident :answer.type/math} :answer/value "K=1" :db/id #edb/ref 17592186311837} {:answer/id #uuid "1cec6337-5ea4-58d7-b663-6920e56db758" :answer/type {:db/ident :answer.type/math} :answer/value "K=3" :db/id #edb/ref 17592186311838}] :answer-field/correct {:answer/id #uuid "1cec6337-5ea4-58d7-b663-6920e56db758" :answer/type {:db/ident :answer.type/math} :answer/value "K=3" :db/id #edb/ref 17592186311838} :answer-field/id #uuid "c02f74dc-35bc-57ee-8b73-bf527f6bc2d9" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311835} {:answer-field/choices [{:answer/id #uuid "4a22771c-bdd9-57e4-b83b-48a94c2e5b39" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =3" :db/id #edb/ref 17592186311840} {:answer/id #uuid "efb5c9f3-5126-57a5-b4a3-7ae9eb3c9d66" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =\\frac{1}{2}" :db/id #edb/ref 17592186311841} {:answer/id #uuid "1c3702a5-2687-5790-8509-b4d1870d610b" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =1" :db/id #edb/ref 17592186311842}] :answer-field/correct {:answer/id #uuid "efb5c9f3-5126-57a5-b4a3-7ae9eb3c9d66" :answer/type {:db/ident :answer.type/math} :answer/value "\\delta =\\frac{1}{2}" :db/id #edb/ref 17592186311841} :answer-field/id #uuid "6e3f67c3-86c8-5538-af07-93dfffca9376" :answer-field/key "field-8" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311839}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "58ead12e-e4e3-55bb-ac14-4fbcc74984c5" :question/math-academy-id "q-334055" :question/problem "For the polynomial $f(x)=8{x}^{4}-2x+1,$ show that $f=O(1)$ as $x\\to 0.$We say $f(x)$ is of order $g(x)$ as $x\\to a,$ and we write \n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nif there exist {{field-1}} constants $K$ and $\\delta $ such that\n\n$$\n{{field-2}}\\,\\text{for all}\\,0<|x-a|<\\delta .\n$$\n\nSo, in our case, we need to show that\n\n$$\n{{field-3}}\\,\\text{for}\\,{{field-4}}.\n$$\n\nBy the triangle inequality,\n\n$$\n\\begin{aligned}|f(x)| & \\le {{field-5}}.\\end{aligned}\n$$\n\nNow, let $|x|<\\frac{1}{2}.$ Then, the best upper bound we can form is\n\n$$\n\\begin{aligned}|f(x)| & <{{field-6}}.\\end{aligned}\n$$\n\nTherefore, $|f(x)|\\le 3$ whenever $|x|<\\frac{1}{2}.$ Thus, taking {{field-7}} and {{field-8}} satisfies the definition, and we conclude that $f(x)=O(1)$ as $x\\to 0.$" :question/worked-solution "We say $f(x)$ is of order $g(x)$ as $x\\to a,$ and we write \n\n$$\nf(x)=O(g(x))\\,\\text{as}\\,x\\to a\n$$\n\nif there exist $\\text{positive}$ constants $K$ and $\\delta $ such that\n\n$$\n|f(x)|\\le K|g(x)|\\,\\text{for all}\\,0<|x-a|<\\delta .\n$$\n\n \n\nSo, in our case, we need to show that\n\n$$\n|f|\\le K\\cdot 1\\,\\text{for}\\,0<|x|<\\delta \n$$\n\ni.e.,\n\n$$\n|f|\\le K\\,\\text{for}\\,0<|x|<\\delta .\n$$\n\nBy the triangle inequality, we have\n\n$$\n\\begin{aligned}|f(x)| & =|8{x}^{4}-2x+1| \\\\  & \\le |8{x}^{4}|+|2x|+|1| \\\\  & =8|x{|}^{4}+2|x|+1.\\end{aligned}\n$$\n\nNow, let $|x|<\\frac{1}{2}.$ Then, we have\n\n$$\n\\begin{aligned}|f(x)| & =|8{x}^{4}-2x+1| \\\\  & \\le 8|x{|}^{4}+2|x|+1 \\\\  & <8{|\\frac{1}{2}|}^{4}+2|\\frac{1}{2}|+1 \\\\  & =\\frac{1}{2}+1+1 \\\\  & =\\frac{5}{2} \\\\  & <3.\\end{aligned}\n$$\n\nTherefore, $|f(x)|\\le 3$ whenever $|x|<\\frac{1}{2}.$ Thus, taking $K=3$ and $\\delta =\\frac{1}{2}$ satisfies the definition, and we conclude that $f(x)=O(1)$ as $x\\to 0.$"}] [{:db/id #edb/ref 17592186311843 :knowledge-point/_questions [{:knowledge-point/id #uuid "00e4f805-bb4c-51d9-be19-acc3021667c1" :knowledge-point/title "Proving the Order of a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d71ee32-f941-5ebc-80ce-2ead4743a65d" :answer/type {:db/ident :answer.type/text} :answer/value "positive" :db/id #edb/ref 17592186311845} {:answer/id #uuid "1d224f08-f1e5-5fb9-9f0a-80aadc6f920a" :answer/type {:db/ident :answer.type/text} :answer/value "real" :db/id #edb/ref 17592186311846}] :answer-field/correct {:answer/id #uuid "3d71ee32-f941-5ebc-80ce-2ead4743a65d" :answer/type {:db/ident :answer.type/text} :answer/value "positive" :db/id #edb/ref 17592186311845} :answer-field/id #uuid "0892dc2b-fbf8-5ee3-b23d-5b639e9a88de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186311844} {:answer-field/choices [{:answer/id #uuid "a335f7d0-7fe0-5492-b4ab-f3a1ad3c00a6" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\ge Kg(x)" :db/id #edb/ref 17592186311848} {:answer/id #uuid "fb9334d2-693a-52d1-8d1e-75af8b924a8d" :answer/type {:db/ident :answer.type/math} :answer/value "|f(x)|\\ge K|g(x)|" :db/id #edb/ref 17592186311849} {:answer/id #uuid "e5cf6e81-fc8e-5a4d-a090-2cd6f420d0c3" :answer/type {:db/ident :answer.type/math} :answer/value "f(x)\\le Kg(x)" :db/id #edb/ref 17592186311850} {:answer/id #uuid "8f750d0c-c6ad-57ba-8026-50cb21301c62" :answer/type {:db/ident :answer.type/math} :answer/value "|f(x)|\\le K|g(x)|" :db/id #edb/ref 17592186311851}] :answer-field/correct {:answer/id #uuid "8f750d0c-c6ad-57ba-8026-50cb21301c62" :answer/type {:db/ident :answer.type/math} :answer/value "|f(x)|\\le K|g(x)|" :db/id #edb/ref 17592186311851} :answer-field/id #uuid "91508a9e-2d13-5def-acb0-0a308fd92537" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/r