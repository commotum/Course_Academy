#{[{:db/id #edb/ref 17592186370570 :knowledge-point/_questions [{:knowledge-point/id #uuid "42c41150-5104-58cc-927b-f55b94529cb2" :knowledge-point/title "Determining the Order of a Numerical Method By Comparing LTE for Different Step Sizes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0487951-0215-5ba5-aaae-47f271b10528" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186370572} {:answer/id #uuid "304e1c61-b18a-5cc8-bbde-10cb0e711781" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370573} {:answer/id #uuid "173db8f7-a715-5a70-a359-ff61ba75d31a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186370574} {:answer/id #uuid "32c0d0ef-8149-5f2a-bb97-be3f1037476c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186370575} {:answer/id #uuid "7f9bfed9-6016-5ea2-bff0-f2d0a363d5db" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186370576}] :answer-field/correct {:answer/id #uuid "304e1c61-b18a-5cc8-bbde-10cb0e711781" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370573} :answer-field/id #uuid "e1eb6629-9439-5577-b4ff-137e6f6c8e2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370571}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "792e1f89-f2c3-5839-895c-6eb10fc13178" :question/math-academy-id "q-334645" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.16,$ the observed local truncation error is $τ(0.16)=0.40.$\n\n- With step size $Δx=0.04,$ the observed local truncation error is $τ(0.04)=0.005.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.16$ to $0.04.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.16}{0.04}=4.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={4}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.40$ to $0.005.$ So, it reduces by a factor of\n\n$$\n\\frac{0.40}{0.005}=80.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{4}^{p+1} & ≈80 \\\\ p+1 & ≈{log}_{4}⁡(80) \\\\ p+1 & ≈3.161… \\\\ p & ≈2.161….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $2.$"}] [{:db/id #edb/ref 17592186370577 :knowledge-point/_questions [{:knowledge-point/id #uuid "42c41150-5104-58cc-927b-f55b94529cb2" :knowledge-point/title "Determining the Order of a Numerical Method By Comparing LTE for Different Step Sizes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8953ec9f-5675-5bc4-95c3-3798aef841f3" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186370579} {:answer/id #uuid "131c99ee-42c2-5fd2-a654-1742675953d6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186370580} {:answer/id #uuid "54489bf9-5fc9-58a6-80ba-096dff2ab70a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186370581} {:answer/id #uuid "6e6aba09-ca9c-54bf-970a-5772b1b3dcbd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186370582} {:answer/id #uuid "ebde9b7c-9901-5cdf-9732-773857fc0167" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186370583}] :answer-field/correct {:answer/id #uuid "6e6aba09-ca9c-54bf-970a-5772b1b3dcbd" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186370582} :answer-field/id #uuid "7eebf7f8-1795-5cfe-ae23-6bcc181442dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370578}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a2ce911a-8124-5a66-812b-ed79e2f51c04" :question/math-academy-id "q-334647" :question/problem "A numerical method is used to approximate the solution to an initial value problem.\n\n- With step size $Δx=0.15,$ the observed local truncation error is $τ(0.15)=0.54.$\n\n- With step size $Δx=0.05,$ the observed local truncation error is $τ(0.05)=0.003.$\n\nEstimate the order of the numerical method." :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.15$ to $0.05.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.15}{0.05}=3.\n$$\n\nAs a result, for a numerical method of order $p,$ the LTE should decrease by a factor of approximately\n\n$$\n{k}^{p+1}={3}^{p+1}.\n$$\n\nOn the other hand, the LTE actually decreases from $0.54$ to $0.003.$ So, it reduces by a factor of\n\n$$\n\\frac{0.54}{0.003}=180.\n$$\n\nComparing the two scale factors for the LTE, we get\n\n$$\n\\begin{aligned}{3}^{p+1} & ≈180 \\\\ p+1 & ≈{log}_{3}⁡(180) \\\\ p+1 & ≈4.726… \\\\ p & ≈3.726….\\end{aligned}\n$$\n\nTherefore, rounding to the nearest integer, the estimated order of the method is $4.$"}] [{:db/id #edb/ref 17592186370584 :knowledge-point/_questions [{:knowledge-point/id #uuid "11217aba-7942-5c3a-84cf-37f22aa209e3" :knowledge-point/title "Determining the Order of a Numerical Method Given the GTE or LTE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2eafb80-10b8-5c87-8b44-1dc304f7126c" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186370586} {:answer/id #uuid "9f4f43f4-400d-5ca2-8008-3681f9b38f15" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186370587} {:answer/id #uuid "fba7862b-16e7-5d45-ace7-46229633ea7f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186370588} {:answer/id #uuid "3d538766-072c-5796-ac87-dab54b04e164" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186370589} {:answer/id #uuid "52ca5300-a24a-51d9-ae3d-fba9fbf488bf" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186370590}] :answer-field/correct {:answer/id #uuid "52ca5300-a24a-51d9-ae3d-fba9fbf488bf" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186370590} :answer-field/id #uuid "92178e62-4839-510e-bdbb-8210fc101bc4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370585}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f0bdeb7f-c72e-54d6-b6ac-05f132bb2bb4" :question/math-academy-id "q-334753" :question/problem "Which of the following local truncation error expressions represent a second-order numerical method?\n\n- $τ(Δx)=5(Δx)^{4}+4(Δx)^{5}$\n- $τ(Δx)=0.3(Δx)^{3}+7(Δx)^{6}$\n- $τ(Δx)=9(Δx)^{5}+2(Δx)^{6}$" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nWith that in mind, let's check each option in turn:\n\n- For $τ(Δx)=5(Δx)^{4}+4(Δx)^{5},$ the dominant term as $Δx\\to 0$ is $5(Δx)^{4}=5(Δx)^{3+1}.$\nSo, statement I corresponds to an order $3$ method.\n\n- For $τ(Δx)=0.3(Δx)^{3}+7(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $0.3(Δx)^{3}=0.3(Δx)^{2+1}.$\nSo, statement II corresponds to an order $2$ method.\n\n- For $τ(Δx)=9(Δx)^{5}+2(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $9(Δx)^{5}=9(Δx)^{4+1}.$\nSo, statement III corresponds to an order $4$ method.\n\nTherefore, the correct answer is \"II only\"."}] [{:db/id #edb/ref 17592186370591 :knowledge-point/_questions [{:knowledge-point/id #uuid "11217aba-7942-5c3a-84cf-37f22aa209e3" :knowledge-point/title "Determining the Order of a Numerical Method Given the GTE or LTE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4930550-2c52-5b12-9884-97e54135e4ce" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186370593} {:answer/id #uuid "1c5dc261-951f-58e4-ac81-9cfc8e8e0563" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186370594} {:answer/id #uuid "77bf41e8-3f2f-5c35-85fb-e8c0ff8298b9" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186370595} {:answer/id #uuid "4b1dce58-ba5e-5ecd-9da7-1f506c957a29" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186370596} {:answer/id #uuid "a2ccfa72-c444-53c8-8489-a6f5ff529e4c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186370597}] :answer-field/correct {:answer/id #uuid "4b1dce58-ba5e-5ecd-9da7-1f506c957a29" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186370596} :answer-field/id #uuid "22df5fc2-30a5-5903-88d4-35266894a4aa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186370592}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c07fc2d9-cd40-5751-8c9f-7d5d62132eff" :question/math-academy-id "q-334756" :question/problem "Which of the following expressions for the global truncation error ($e$) or local truncation error ($τ$) represent a third-order numerical method?\n\n- $τ(Δx)=5(Δx)^{4}+2(Δx)^{6}$\n- $e(Δx)=4(Δx)^{3}+7(Δx)^{4}$\n- $τ(Δx)=0.3(Δx)^{2}+6(Δx)^{3}$" :question/worked-solution "For a given numerical method, if $p$ is the largest positive integer such that\n\n- the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0,\n$$\n\n- the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0,\n$$\n\nthen the method is of order $p.$\n\nWith that in mind, let's check each option in turn:\n\n- For the LTE expression $τ(Δx)=5(Δx)^{4}+2(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $5(Δx)^{4}=5(Δx)^{3+1}.$\nSo, statement I corresponds to an order $3$ method.\n\n- For the GTE expression $e(Δx)=4(Δx)^{3}+7(Δx)^{4},$ the dominant term as $Δx\\to 0$ is $4(Δx)^{3}=4(Δx)^{3}.$\nSo, statement II corresponds to an order $3$ method.\n\n- For the LTE expression $τ(Δx)=0.3(Δx)^{2}+6(Δx)^{3},$ the dominant term as $Δx\\to 0$ is $0.3(Δx)^{2}=0.3(Δx)^{1+1}.$\nSo, statement III corresponds to an order $1$ method.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186370598 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4c7f962-87af-53af-8167-d24ade127366" :knowledge-point/title "Making Inferences Given the Order of a Numerical Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ad43846-bee9-5c21-b5fe-83afbabe445d" :answer/type {:db/ident :answer.type/math} :answer/value "0.02" :db/id #edb/ref 17592186370600}] :answer-field/correct {:answer/id #uuid "6ad43846-bee9-5c21-b5fe-83afbabe445d" :answer/type {:db/ident :answer.type/math} :answer/value "0.02" :db/id #edb/ref 17592186370600} :answer-field/id #uuid "54f51b0b-b0a6-5a71-8620-163ab26d94f5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186370599}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7cc8c4d7-f786-5b1c-a1c0-7482e91fbcb2" :question/math-academy-id "q-334951" :question/problem "A numerical method for approximating a solution to an initial value problem is known to be order $3.$  Suppose that using step size $Δx=0.24$ produces a local truncation error (LTE) of $τ(0.24)≈0.32.$  If we instead use a step size $Δx=0.12,$ what LTE should we expect?\n\n$τ(0.12)≈$\n{{field-1}}" :question/worked-solution "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.24$ to $0.12.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.24}{0.12}=2.\n$$\n\nNow, since the numerical method is of order $3,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{3+1}={2}^{4}=16.\n$$\n\nTherefore, using a step size of $Δx=0.12,$ the expected LTE is\n\n$$\nτ(0.12)≈\\frac{0.32}{16}=0.02.\n$$"}]}
