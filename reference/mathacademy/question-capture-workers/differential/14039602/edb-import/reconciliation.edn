ategory" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/state.json" "file_sha256" "76ff91c362bc69ed73552b3800976ced33256fa2cc8363dcf93b3d2ad10af222" "basis" 1312 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/edb-import/verification.json"} {"question" "q-106051" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/activity-metadata.json" "file_sha256" "ccd7a0f2d57c81c1dc0363a8272635f80aac3c295707002e36256f69d52c8ab9" "basis" 1312 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/edb-import/verification.json"} {"question" "q-106051" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/state.json" "file_sha256" "76ff91c362bc69ed73552b3800976ced33256fa2cc8363dcf93b3d2ad10af222" "basis" 1312 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/edb-import/verification.json"} {"question" "q-106051" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=2\\operatorname{cos}⁡\\theta -3,\\,y=2\\operatorname{sin}⁡\\theta +3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/state.json" "file_sha256" "76ff91c362bc69ed73552b3800976ced33256fa2cc8363dcf93b3d2ad10af222" "basis" 1312 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/edb-import/verification.json"} {"question" "q-106051