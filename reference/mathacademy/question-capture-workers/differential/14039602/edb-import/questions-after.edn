2c0bd2" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +3,\\,y=2\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186285499} {:answer/id #uuid "362dbb24-f838-5556-96e5-ae67b7c32dc8" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\sqrt{2}\\operatorname{cos}⁡\\theta +3,\\,y=\\sqrt{2}\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186285500} {:answer/id #uuid "aa01087f-a623-5734-b3b0-13fcc9befc5f" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{sin}⁡\\theta +3,\\,y=2\\operatorname{cos}⁡\\theta +2" :db/id #edb/ref 17592186285501} {:answer/id #uuid "9d4d4060-d2a9-5f59-9430-8b417435d1b6" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{sin}⁡\\theta -2,\\,y=2\\operatorname{cos}⁡\\theta -3" :db/id #edb/ref 17592186285502} {:answer/id #uuid "5538ccdb-55e4-58a5-8eed-8869e00e93af" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\sqrt{2}\\operatorname{cos}⁡\\theta -3,\\,y=\\sqrt{2}\\operatorname{sin}⁡\\theta -2" :db/id #edb/ref 17592186285503}] :answer-field/correct {:answer/id #uuid "86d4789d-0d1f-5075-889a-bbc9aa2c0bd2" :answer/type {:db/ident :answer.type/math} :answer/value "x=2\\operatorname{cos}⁡\\theta +3,\\,y=2\\operatorname{sin}⁡\\theta +2" :db/id #edb/ref 17592186285499} :answer-field/id #uuid "64a60757-8edf-5e5f-8e4f-57266d8bafd3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186285498}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "415c2174-2f13-595b-9668-7709d9fcceb8" :question/math-academy-id "q-79170" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/1407fa82fd00d07311cb34c6a3d5f0d0c79808d321d049d74114a6f4f2e5f6a6.png)\n\nConsider the circle of radius $2$ centered at $(3,2)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(5,2)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $2$ centered at the point $(3,2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=2\\operatorname{cos}⁡\\theta +3,\\,y=2\\operatorname{sin}⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$"}] [{:db/id #edb/ref 17592186303425 :knowledge-point/_questions [{:knowledge-point/id #uuid "1d81c7ff-8459-5559-bfae-c2a9c3bc739e" :knowledge-point/title "Parametrizing Part of a Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "681daaa6-728e-5099-bf18-d16f20859975" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/id #edb/ref 17592186303427} {:answer/id #uuid "e873bfd5-57af-5bd1-a5d7-cfba60552483" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\pi ]" :db/id #edb/ref 17592186303428} {:answer/id #uuid "b6194942-dba9-5c6b-9ce6-1d39c5941cc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [\\pi ,2\\pi ]" :db/id #edb/ref 17592186303429} {:answer/id #uuid "a0bf226b-b429-5d3e-8956-1e7170470c7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186303430} {:answer/id #uuid "7dcab389-4d1b-5817-8e53-79ef906b83d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta \\in [0,\\frac{3\\pi }{2}]" :db/id #edb/ref 17592186303431}] :answer-field/correct {:answer/id #uuid "e873bfd5-57af-5bd1-a5d7-cfba60552483" :answer/type {:db/ident :answer.typ