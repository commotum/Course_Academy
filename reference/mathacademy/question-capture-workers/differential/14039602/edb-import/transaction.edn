s}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r,0).$\n\nIn our case, the radius $r=5.$ Therefore, the parametric equations of the circle are \n\n$$\nx=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106040/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7703063b-658d-50a5-8ac3-747b7f029bb3"] :knowledge-point/questions ["q-106040"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15802/selection/a65ffb480b3dce96b73224d096c8f3f566f1650f7a2fc7c97c38b47b19e77764" :answer/id #uuid "45deac2f-9ae7-5d09-86ad-fd452ade04db" :answer/type :answer.type/math :answer/value "x=2.5\\operatorname{sin}⁡\\theta ,\\,y=2.5\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-15802/selection/f8a3f2b2b0f4f9b4656d64d85f1b4ddc412433ca4ef47d50645bc31acea77f30" :answer/id #uuid "58da1099-75d7-5fa0-8647-6636293f3d0c" :answer/type :answer.type/math :answer/value "x=10\\operatorname{sin}⁡\\theta ,\\,y=10\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-15802/selection/0786bb4ad945c61ece5ea81eae08435b323036331de899928d0c2cabfc0c0736" :answer/id #uuid "dbb13dd8-eff9-52f6-969a-6409e4f8cfdc" :answer/type :answer.type/math :answer/value "x=25\\operatorname{sin}⁡\\theta ,\\,y=25\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-15802/selection/b3226cc26b28e7e9eb98d769b9172b5bab1341f97d47692d366331179ad050d6" :answer/id #uuid "75263724-f2b8-5247-99b7-94bcd72f8dc5" :answer/type :answer.type/math :answer/value "x=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-15802/selection/2988025a0de519b57110198d0684756ca1d688630a3101f75a8a7e4eccb747b4" :answer/id #uuid "75308438-87c3-5cb2-9bc7-86063f55b7ea" :answer/type :answer.type/math :answer/value "x=\\sqrt{5}\\operatorname{sin}⁡\\theta ,\\,y=\\sqrt{5}\\operatorname{cos}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-15802/selection" :answer-field/id #uuid "cee44b01-6cd4-5df0-a7a4-def647797914" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15802/selection/b3226cc26b28e7e9eb98d769b9172b5bab1341f97d47692d366331179ad050d6" :answer-field/choices ["q-15802/selection/a65ffb480b3dce96b73224d096c8f3f566f1650f7a2fc7c97c38b47b19e77764" "q-15802/selection/f8a3f2b2b0f4f9b4656d64d85f1b4ddc412433ca4ef47d50645bc31acea77f30" "q-15802/selection/0786bb4ad945c61ece5ea81eae08435b323036331de899928d0c2cabfc0c0736" "q-15802/selection/b3226cc26b28e7e9eb98d769b9172b5bab1341f97d47692d366331179ad050d6" "q-15802/selection/2988025a0de519b57110198d0684756ca1d688630a3101f75a8a7e4eccb747b4"] :db/ensure [:answer-field/validate]} {:db/id "q-15802" :question/id #uuid "12c61f36-cadf-5c27-8401-bbee517fdc13" :question/math-academy-id "q-15802" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $5$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=5.$ Therefore, the parametric equations of the circle are \n\n$$\nx=5\\operatorname{cos}⁡\\theta ,\\,y=5\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15802/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7703063b-658d-50a5-8ac3-747b7f029bb3"] :knowledge-point/questions ["q-15802"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-6878"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/de2b66f976dc204566516a1724fa19cc03bf8b8f4da1fa4f4a198fd656ad10ca.png)\n\nConsider the circle of radius $9$ centered at the origin, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(9,0)?$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-78204"] :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $1$ centered at the point $(3,2)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, we have a circle of radius $1$ centered at the point $(3,2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=\\operatorname{cos}⁡\\theta +3,\\,y=\\operatorname{sin}⁡\\theta +2,\\,\\theta \\in [0,2\\pi ).\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-106291"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/3c07f3e732084327f02849cee9355a46ce7a1c5f905d509b1e1404915612c85c.png)\n\nConsider the circle of radius $3$ centered at $(3,-2)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(6,-2)?$" :db/ensure [:question/validate]} {:db/id "q-321942/field-1/d9ecb8370b499959a191e576efba328f0a5ea2600caf1b454b4642a045f41cbb" :answer/id #uuid "659e564d-1f0e-55ea-a92d-07a5da294ed8" :answer/type :answer.type/math :answer/value "6\\cos(\\theta)-5" :db/ensure [:answer/validate]} {:db/id "q-321942/field-1/90ebf78f6bfa00c99b4b227f84c5da9b55700af201f092453bbd4936bc835c36" :answer/id #uuid "fd457ab8-0181-5b5e-ad2f-f482e00b683b" :answer/type :answer.type/math :answer/value "6\\cos(\\theta)+5" :db/ensure [:answer/validate]} {:db/id "q-321942/field-1" :answer-field/id #uuid "e719faf4-002d-516d-a797-2de8c8a4a279" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321942/field-1/d9ecb8370b499959a191e576efba328f0a5ea2600caf1b454b4642a045f41cbb" :answer-field/choices ["q-321942/field-1/d9ecb8370b499959a191e576efba328f0a5ea2600caf1b454b4642a045f41cbb" "q-321942/field-1/90ebf78f6bfa00c99b4b227f84c5da9b55700af201f092453bbd4936bc835c36"] :db/ensure [:answer-field/validate]} {:db/id "q-321942/field-2/55c7bc0bde2bb7c9111ce2c2b9a634d4455a6846808fd01fe26298c9beeb1287" :answer/id #uuid "8b706664-71e1-5342-a88b-1e6072f8a3e3" :answer/type :answer.type/math :answer/value "6\\sin(\\theta)-2" :db/ensure [:answer/validate]} {:db/id "q-321942/field-2" :answer-field/id #uuid "c021c6cd-24a7-5256-b792-7421352b6137" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321942/field-2/55c7bc0bde2bb7c9111ce2c2b9a634d4455a6846808fd01fe26298c9beeb1287" :answer-field/choices ["q-321942/field-2/55c7bc0bde2bb7c9111ce2c2b9a634d4455a6846808fd01fe26298c9beeb1287"] :db/ensure [:answer-field/validate]} {:db/id "q-321942" :question/id #uuid "67c0d567-0a98-5b60-aa47-f735cc300b15" :question/math-academy-id "q-321942" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/59cef258a1ad0e6a0f56c37e0b7020e5341c329d5655c41f49e6e78eafca8b3f.png)\n\nConsider the circle of radius $6$ centered at $(-5,-2)$, as shown above. Construct a set of parametric equations, defined for $\\theta \\in [0,2\\pi ),$ that traverse the circle once in the counterclockwise direction starting at the point $A(1,-2).$\n\n$x=$\n{{field-1}}$,\\,y=$\n{{field-2}}$,\\,\\theta \\in [0,2\\pi )$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nUnder this parametrization, the circle is traversed once in the counterclockwise direction, starting from $(r+a,b).$\n\nIn our case, we have a circle of radius $6$ centered at the point $(-5,-2).$ Therefore, the parametric equations of the circle are\n\n$$\nx=6\\operatorname{cos}⁡\\theta -5,\\,y=6\\operatorname{sin}⁡\\theta -2,\\,\\theta \\in [0,2\\pi ).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321942/field-1" "q-321942/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0346056c-cf8e-51bf-92f3-052a0948a6fa"] :knowledge-point/questions ["q-321942"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-79170"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/1407fa82fd00d07311cb34c6a3d5f0d0c79808d321d049d74114a6f4f2e5f6a6.png)\n\nConsider the circle of radius $2$ centered at $(3,2)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(5,2)?$" :db/ensure [:question/validate]} {:db/id "q-79270/selection/254f7dc7c93945f5d800c08002268b921573aada24b982a69940059f541d28cc" :answer/id #uuid "681daaa6-728e-5099-bf18-d16f20859975" :answer/type :answer.type/math :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/ensure [:answer/validate]} {:db/id "q-79270/selection/42113895f4a3b82bea25716b9e3a345a8aece1d1f1e571b15045782992436230" :answer/id #uuid "b6194942-dba9-5c6b-9ce6-1d39c5941cc1" :answer/type :answer.type/math :answer/value "\\theta \\in [\\pi ,2\\pi ]" :db/ensure [:answer/validate]} {:db/id "q-79270/selection/bc3e76ff6c2251409d67bd4d44714df545c2e1406f35c243db21f791e2a3cb52" :answer/id #uuid "7dcab389-4d1b-5817-8e53-79ef906b83d7" :answer/type :answer.type/math :answer/value "\\theta \\in [0,\\frac{3\\pi }{2}]" :db/ensure [:answer/validate]} {:db/id "q-79270/selection/5bda35dc7fabc5f84da2118d36bbe7c90786c71810c1d882ae9f6c6935b490ae" :answer/id #uuid "a0bf226b-b429-5d3e-8956-1e7170470c7f" :answer/type :answer.type/math :answer/value "\\theta \\in [\\frac{\\pi }{2},\\frac{3\\pi }{2}]" :db/ensure [:answer/validate]} {:db/id "q-79270/selection/4205b99be199dc7950356b855ff4a5477c48c73878a7b026d25c035dbf46acb5" :answer/id #uuid "e873bfd5-57af-5bd1-a5d7-cfba60552483" :answer/type :answer.type/math :answer/value "\\theta \\in [0,\\pi ]" :db/ensure [:answer/validate]} {:db/id "q-79270/selection" :answer-field/id #uuid "de353e93-8d1f-534b-9fa7-930db9419ad7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79270/selection/4205b99be199dc7950356b855ff4a5477c48c73878a7b026d25c035dbf46acb5" :answer-field/choices ["q-79270/selection/254f7dc7c93945f5d800c08002268b921573aada24b982a69940059f541d28cc" "q-79270/selection/42113895f4a3b82bea25716b9e3a345a8aece1d1f1e571b15045782992436230" "q-79270/selection/bc3e76ff6c2251409d67bd4d44714df545c2e1406f35c243db21f791e2a3cb52" "q-79270/selection/5bda35dc7fabc5f84da2118d36bbe7c90786c71810c1d882ae9f6c6935b490ae" "q-79270/selection/4205b99be199dc7950356b855ff4a5477c48c73878a7b026d25c035dbf46acb5"] :db/ensure [:answer-field/validate]} {:db/id "q-79270" :question/id #uuid "2b941b6a-26ac-5171-ac04-42b453f12f28" :question/math-academy-id "q-79270" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/d50e70570bbf054d8ab0bda89ce09e3bec855af2a0ef94d2fcf1a8aea103b53c.png)\n\nThe semi-circle above is defined by the parametric equations \n\n$$\nx=6\\operatorname{cos}⁡\\theta ,\\,y=6\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=6.$ So, the parametric equations of the *full* circle are \n\n$$\nx=6\\operatorname{cos}⁡\\theta ,\\,y=6\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to a semi-circle, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/9f515c8b70ee6902df4c694f7d7b50efb4ff54d24b0cb25b9173d439fea84210.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\pi ]$, we get the required semi-circle.\n\nTherefore, the parametric equations of the semi-circle are \n\n$$\nx=6\\operatorname{cos}⁡\\theta ,\\,y=6\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\pi ].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79270/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d81c7ff-8459-5559-bfae-c2a9c3bc739e"] :knowledge-point/questions ["q-79270"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-79166"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039602/assets/5ac5a6ba5e7c041adfe2a36f9e7d835e8090a296cb72adffa5123f67cbed8aa3.png)\n\nThe three-quarter-circle above is defined by the parametric equations \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in 