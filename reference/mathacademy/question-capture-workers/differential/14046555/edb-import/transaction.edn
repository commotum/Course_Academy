[{:db/id "q-333415/selection/0cf84fd04b12c47d29a59ca41574b87dff90623470665af276ca25179756dcd0" :answer/id #uuid "c8814e1d-cedb-5ab5-8535-05c4d45aff43" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=y+\\frac{2}{3}{x}_{\\text{new}}+{x}_{\\text{new}}y" :db/ensure [:answer/validate]} {:db/id "q-333415/selection/e1ff1782fc981d598674d2d615e29daa9f9b8f62826d35bcaa55894a6c1caed4" :answer/id #uuid "85b0a200-1b6e-5c66-93cc-955f97c43619" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{3y+2{x}_{\\text{new}}}{3+3{x}_{\\text{new}}}" :db/ensure [:answer/validate]} {:db/id "q-333415/selection/1c60d9c79fd0858f7a21822b672ee4695ae4deae71158862c53462baa70b4028" :answer/id #uuid "ddafc311-f418-5cdc-b862-2f594ea958c6" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=y+\\frac{2}{3}{x}_{\\text{new}}-y" :db/ensure [:answer/validate]} {:db/id "q-333415/selection/f633fa2e3902b7225d5cf4348bdff82e0b3f1b9f26ba4ae00664cc8359c4d930" :answer/id #uuid "7b77a2ad-405c-580b-a1b3-cdfecc7d228a" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{3y+2{x}_{\\text{new}}}{3-3y}" :db/ensure [:answer/validate]} {:db/id "q-333415/selection/d6d185e3e1419087eb4a3cc1d211203fb0df364b062730b36cf7f4add81b951a" :answer/id #uuid "13d197e6-f8c4-5b3e-8f1b-00a396a179c2" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{3y+2{x}_{\\text{new}}}{3-3{x}_{\\text{new}}}" :db/ensure [:answer/validate]} {:db/id "q-333415/selection" :answer-field/id #uuid "aa6ffff4-9879-50b4-9c71-2e681bccda98" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-333415/selection/d6d185e3e1419087eb4a3cc1d211203fb0df364b062730b36cf7f4add81b951a" :answer-field/choices ["q-333415/selection/0cf84fd04b12c47d29a59ca41574b87dff90623470665af276ca25179756dcd0" "q-333415/selection/e1ff1782fc981d598674d2d615e29daa9f9b8f62826d35bcaa55894a6c1caed4" "q-333415/selection/1c60d9c79fd0858f7a21822b672ee4695ae4deae71158862c53462baa70b4028" "q-333415/selection/f633fa2e3902b7225d5cf4348bdff82e0b3f1b9f26ba4ae00664cc8359c4d930" "q-333415/selection/d6d185e3e1419087eb4a3cc1d211203fb0df364b062730b36cf7f4add81b951a"] :db/ensure [:answer-field/validate]} {:db/id "q-333415" :question/id #uuid "02d633b4-d0e7-5727-8c57-6d89916e94a1" :question/math-academy-id "q-333415" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x+3xy,\\,y(-2)=-1\n$$\n\nThe **implicit** Euler method is applied with step size $Δx=\\frac{1}{3}.$ \nFind the general formula for the new $y$ value, ${y}_{\\text{new}},$ in terms of the new value ${x}_{\\text{new}}$ and the current value $y.$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(2{x}_{\\text{new}}+3{x}_{\\text{new}}{y}_{\\text{new}})\\cdot \\frac{1}{3} \\\\  & =\\frac{2}{3}{x}_{\\text{new}}+{x}_{\\text{new}}{y}_{\\text{new}}\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{2}{3}{x}_{\\text{new}}+{x}_{\\text{new}}{y}_{\\text{new}} \\\\ {y}_{\\text{new}}-{x}_{\\text{new}}{y}_{\\text{new}} & =y+\\frac{2}{3}{x}_{\\text{new}} \\\\ {y}_{\\text{new}}(1-{x}_{\\text{new}}) & =y+\\frac{2}{3}{x}_{\\text{new}} \\\\ 3{y}_{\\text{new}}(1-{x}_{\\text{new}}) & =3y+2{x}_{\\text{new}} \\\\ {y}_{\\text{new}}(3-3{x}_{\\text{new}}) & =3y+2{x}_{\\text{new}} \\\\ {y}_{\\text{new}} & =\\frac{3y+2{x}_{\\text{new}}}{3-3{x}_{\\text{new}}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-333415/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b7095c46-33cf-5407-be83-70a49cf6eadd"] :knowledge-point/questions ["q-333415"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333421/selection/fd7c5f0d84382bf6b0b088b404b1815c8bc7ab8ea350b8180341d8bc03dd2590" :answer/id #uuid "4f9dac7a-139d-5cbf-adc5-2eaef1ef6f3d" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}}{1-3{x}_{\\text{new}}}" :db/ensure [:answer/validate]} {:db/id "q-333421/selection/8836885195963867898d82400c3bf3f9d41412cc3d8a942c94f16060d044e136" :answer/id #uuid "432cc776-9925-5bb9-a7b1-bcea0a1e1b4b" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}-3y" :db/ensure [:answer/validate]} {:db/id "q-333421/selection/bc2106a3941fa234819f911ddfc8981c4aef439a8223b51ca993f71cbfd2b753" :answer/id #uuid "0af547b3-23ee-5937-987a-bd196d265bd7" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}+3{x}_{\\text{new}}y" :db/ensure [:answer/validate]} {:db/id "q-333421/selection/cc37e2b2ac79a8698300ac6e0f32173ad69c1ce1e469bfb3a7e4f5f911c40e50" :answer/id #uuid "8d1dce6f-e534-5ab1-9bcb-887c05e26b08" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}}{1-3y}" :db/ensure [:answer/validate]} {:db/id "q-333421/selection/2dd87a33cada578b9cf5265168b0565bcb21b5b378efe9d2120842e38f7b9128" :answer/id #uuid "7d3be92e-155c-5e65-97d2-407c37bb2364" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}}{1+3{x}_{\\text{new}}}" :db/ensure [:answer/validate]} {:db/id "q-333421/selection" :answer-field/id #uuid "d6a0fb07-3134-5d50-b6a9-925e19b51712" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-333421/selection/fd7c5f0d84382bf6b0b088b404b1815c8bc7ab8ea350b8180341d8bc03dd2590" :answer-field/choices ["q-333421/selection/fd7c5f0d84382bf6b0b088b404b1815c8bc7ab8ea350b8180341d8bc03dd2590" "q-333421/selection/8836885195963867898d82400c3bf3f9d41412cc3d8a942c94f16060d044e136" "q-333421/selection/bc2106a3941fa234819f911ddfc8981c4aef439a8223b51ca993f71cbfd2b753" "q-333421/selection/cc37e2b2ac79a8698300ac6e0f32173ad69c1ce1e469bfb3a7e4f5f911c40e50" "q-333421/selection/2dd87a33cada578b9cf5265168b0565bcb21b5b378efe9d2120842e38f7b9128"] :db/ensure [:answer-field/validate]} {:db/id "q-333421" :question/id #uuid "5cc11f9d-82da-5dac-84c7-cca1eb3fc1cf" :question/math-academy-id "q-333421" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x-{x}^{2}+3xy,\\,y(0)=2\n$$\n\nThe **implicit** Euler method is applied with step size $Δx=1.$ \nFind the general formula for the new $y$ value, ${y}_{\\text{new}},$ in terms of the new value ${x}_{\\text{new}}$ and the current value $y.$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}+3{x}_{\\text{new}}{y}_{\\text{new}})\\cdot 1 \\\\  & =2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}+3{x}_{\\text{new}}{y}_{\\text{new}}\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}+3{x}_{\\text{new}}{y}_{\\text{new}} \\\\ {y}_{\\text{new}}-3{x}_{\\text{new}}{y}_{\\text{new}} & =y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2} \\\\ {y}_{\\text{new}}(1-3{x}_{\\text{new}}) & =y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2} \\\\ {y}_{\\text{new}} & =\\frac{y+2{x}_{\\text{new}}-{x}_{\\text{new}}^{2}}{1-3{x}_{\\text{new}}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333421/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b7095c46-33cf-5407-be83-70a49cf6eadd"] :knowledge-point/questions ["q-333421"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333423/selection/ad69796730baa3fc9e53c88ca545d3a2453aed5be5917c6b9702cf672d61822b" :answer/id #uuid "d362d310-b87f-5547-bf91-4472d5f8596e" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{5y+4{x}_{\\text{new}}^{2}}{5+5{x}_{\\text{new}}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-333423/selection/36b372383a401d547b628f706ec21acfd65eeb0ec3a0ba4ed8dabc2922a04279" :answer/id #uuid "090c9f28-41b1-5e05-a4bd-65ea9e0b1f1a" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=y+\\frac{4}{5}{x}_{\\text{new}}^{2}-{x}_{\\text{new}}^{2}y" :db/ensure [:answer/validate]} {:db/id "q-333423/selection/250c34d8655f8f4aeba4aa9a1924b9a5c9014c017cbdfc628f039fc5d6b7efbb" :answer/id #uuid "dc321a2d-0eed-559d-ab24-e279cb2c6f05" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{5y+4{x}_{\\text{new}}^{2}}{5-5{x}_{\\text{new}}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-333423/selection/9fa0cba0183694f11799b01ffb505d740ddbdc9aa10c5051b728602107494fb2" :answer/id #uuid "74b48867-4d20-5f72-9ddd-c038a6eb8396" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{5y+4{x}_{\\text{new}}^{2}}{5+5y}" :db/ensure [:answer/validate]} {:db/id "q-333423/selection/ee6f0213bf15dedf4c316eae49949ba61d13e14e9524596b80b0515456c4089b" :answer/id #uuid "c4442265-2300-5935-b841-07951fb9b637" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=y+\\frac{4}{5}{x}_{\\text{new}}^{2}-5y" :db/ensure [:answer/validate]} {:db/id "q-333423/selection" :answer-field/id #uuid "140f1fdf-81d1-57aa-bb5f-3d078050dcef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-333423/selection/ad69796730baa3fc9e53c88ca545d3a2453aed5be5917c6b9702cf672d61822b" :answer-field/choices ["q-333423/selection/ad69796730baa3fc9e53c88ca545d3a2453aed5be5917c6b9702cf672d61822b" "q-333423/selection/36b372383a401d547b628f706ec21acfd65eeb0ec3a0ba4ed8dabc2922a04279" "q-333423/selection/250c34d8655f8f4aeba4aa9a1924b9a5c9014c017cbdfc628f039fc5d6b7efbb" "q-333423/selection/9fa0cba0183694f11799b01ffb505d740ddbdc9aa10c5051b728602107494fb2" "q-333423/selection/ee6f0213bf15dedf4c316eae49949ba61d13e14e9524596b80b0515456c4089b"] :db/ensure [:answer-field/validate]} {:db/id "q-333423" :question/id #uuid "ec64d979-a2b7-5216-964e-636ae65433ba" :question/math-academy-id "q-333423" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=4{x}^{2}-5{x}^{2}y,\\,y(1)=0\n$$\n\nThe **implicit** Euler method is applied with step size $Δx=\\frac{1}{5}.$ \nFind the general formula for the new $y$ value, ${y}_{\\text{new}},$ in terms of the new value ${x}_{\\text{new}}$ and the current value $y.$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,{y}_{0}=y({x}_{0}),\n$$\n\nthe implicit Euler method with step size $Δx$ is given by\n\n$$\nΔy={y}_{\\text{new}}^{′}\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & ={y}_{\\text{new}}^{′}\\cdot Δx \\\\  & =(4{x}_{\\text{new}}^{2}-5{x}_{\\text{new}}^{2}{y}_{\\text{new}})\\cdot \\frac{1}{5} \\\\  & =\\frac{4}{5}{x}_{\\text{new}}^{2}-{x}_{\\text{new}}^{2}{y}_{\\text{new}}\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{4}{5}{x}_{\\text{new}}^{2}-{x}_{\\text{new}}^{2}{y}_{\\text{new}} \\\\ {y}_{\\text{new}}+{x}_{\\text{new}}^{2}{y}_{\\text{new}} & =y+\\frac{4}{5}{x}_{\\text{new}}^{2} \\\\ {y}_{\\text{new}}(1+{x}_{\\text{new}}^{2}) & =y+\\frac{4}{5}{x}_{\\text{new}}^{2} \\\\ 5{y}_{\\text{new}}(1+{x}_{\\text{new}}^{2}) & =5y+4{x}_{\\text{new}}^{2} \\\\ {y}_{\\text{new}}(5+5{x}_{\\text{new}}^{2}) & =5y+4{x}_{\\text{new}}^{2} \\\\ {y}_{\\text{new}} & =\\frac{5y+4{x}_{\\text{new}}^{2}}{5+5{x}_{\\text{new}}^{2}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-333423/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b7095c46-33cf-5407-be83-70a49cf6eadd"] :knowledge-point/questions ["q-333423"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186221862 :question/answer-fields 17592186220078] {:db/id "q-325169/selection/ma-v1/aa2ad8608cc2ceabe56e69cb977752c971139e3efe06b71dc1ea0453bc6bd8ed/8d385368e07019620d1e1bab567721752649846f377f15cd6ffadc64154bd594" :answer/id #uuid "c366c38a-ffcd-5bb4-b2a0-e080c13b9488" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{y+{e}^{{x}_{\\text{new}}}}{1+3{x}_{\\text{new}}}" :db/ensure [:answer/validate]} {:db/id "q-325169/selection/ma-v1/aa2ad8608cc2ceabe56e69cb977752c971139e3efe06b71dc1ea0453bc6bd8ed/188df5a465ec11dbe6e5df2f65893651a3069af7846d6b8de20cff5f4bb23a0a" :answer/id #uuid "3d0d76d4-fdf0-5c58-8640-57094a8e0d3f" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=\\frac{y+{e}^{{x}_{\\text{new}}}}{1+3y}" :db/ensure [:answer/validate]} {:db/id "q-325169/selection/ma-v1/aa2ad8608cc2ceabe56e69cb977752c971139e3efe06b71dc1ea0453bc6bd8ed/eb3038fd248d678413cb1e10e5b2479459140364b1a1f8e88cf14f2e158797e4" :answer/id #uuid "4ea4dcd4-044b-50bf-b26a-691a8ab0548e" :answer/type :answer.type/math :answer/value "{y}_{\\text{new}}=y+{e}^{{x}_{\\text{new}}}-3{x}_{\\text{new}}y" :db/ensure [:answer/validate]} {:db/id "q-325169/selection/ma-v1/aa2ad8608cc2ceabe56e69cb977752c971139e3efe06b71dc1ea0453bc6bd8ed/17a14f52f4c