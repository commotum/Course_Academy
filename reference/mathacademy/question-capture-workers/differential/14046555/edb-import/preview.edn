}_{\\text{new}}\\cdot (4{e}^{{x}_{\\text{new}}}-2)\\cdot 1 \\\\  & ={y}_{\\text{new}}(4{e}^{{x}_{\\text{new}}}-2).\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and solve for the general formula for ${y}_{\\text{new}}:$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+{y}_{\\text{new}}(4{e}^{{x}_{\\text{new}}}-2),\\end{aligned}\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}{y}_{\\text{new}}-{y}_{\\text{new}}(4{e}^{{x}_{\\text{new}}}-2) & =y \\\\ (1-(4{e}^{{x}_{\\text{new}}}-2)){y}_{\\text{new}} & =y \\\\ {y}_{\\text{new}} & =\\frac{y}{1-(4{e}^{{x}_{\\text{new}}}-2)} \\\\ {y}_{\\text{new}} & =\\frac{y}{3-4{e}^{{x}_{\\text{new}}}}.\\end{aligned}\n$$\n\nNow, in the first step, the new $x$ value is ${x}_{\\text{new}}=x+Δx=0+1=1.$ Hence, the new $y$ value is\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =\\frac{y}{3-4{e}^{{x}_{\\text{new}}}} \\\\  & =\\frac{2}{3-4{e}^{1}} \\\\  & =\\frac{2}{3-4e} \\\\  & ≈-0.25,\\end{aligned}\n$$\n\nrounded to $2$ decimal places.\n\nTherefore, we conclude that $y(1)≈-0.25.$" 13194139535003 true] [17592186326040 1000 #edb/ref 17592186326041 13194139535003 true] [17592186326040 1000 #edb/ref 17592186326042 13194139535003 true] [17592186326040 1000 #edb/ref 17592186326043 13194139535003 true] [17592186326040 1000 #edb/ref 17592186326044 13194139535003 true] [17592186326040 1040 #edb/ref 17592186045451 13194139535003 true] [17592186326040 1041 "field-1" 13194139535003 true] [17592186326040 1104 #edb/ref 17592186326042 13194139535003 true] [17592186326040 1110 #uuid "2032e6b7-15c6-5a51-9c0a-d0f3e7e39672" 13194139535003 true] [17592186326041 1034 "0.39" 13194139535003 true] [17592186326041 1103 #edb/ref 17592186045453 13194139535003 true] [17592186326041 1111 #uuid "0ca38e60-6b45-5e65-8da7-9dcae8d7417b" 13194139535003 true] [17592186326042 1034 "-0.25" 13194139535003 true] [17592186326042 1103 #edb/ref 17592186045453 13194139535003 true] [17592186326042 1111 #uuid "15be0de3-a3a7-541e-9f80-88d1acad21