ential equation is\n\n$$\n\\begin{aligned}y & ={e}^{-3x}(P\\operatorname{cos}⁡10x+Q\\operatorname{sin}⁡10x).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064047/state.json" "file_sha256" "3f2c955db89ff2206ed531f593a149661417e293b1cffba8bae7ce025cdce38d"} {"question" "q-130327" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064047/activity-metadata.json" "file_sha256" "0482831521116e3467a76cdb107108638d7d5531b5dd69b53e1c1b2caa227465"} {"question" "q-130327" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064047/state.json" "file_sha256" "3f2c955db89ff2206ed531f593a149661417e293b1cffba8bae7ce025cdce38d"} {"question" "q-130327" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y={e}^{-10x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)"] ["math" "y={e}^{-3x}(P\\operatorname{cos}⁡10x+Q\\operatorname{sin}⁡10x)"] ["math" "y={e}^{10x}(P\\operatorname{cos}⁡3x+Q\\operatorname{sin}⁡3x)"] ["math" "y={e}^{10x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)"] ["math" "y={e}^{3x}(P\\operatorname{cos}⁡10x+Q\\operatorname{sin}⁡10x)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064047/state.json" "file_sha256" "3f2c955db89ff2206ed531f593a149661417e293b1cffba8bae7ce025cdce38d"} {"question" "q-130327" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y={e}^{-3x}(P\\operatorname{cos}⁡10x+Q\\operatorname{sin}⁡10x)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacade