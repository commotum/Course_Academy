}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-168497/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16d1e71b-6eda-5c91-81a0-15a1aa979932"] :knowledge-point/questions ["q-168497"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327976/selection/78de957e8699b7f5183607bbc580e4adcb4b99679dba79303b2883d73be32495" :answer/id #uuid "066d6b1d-f829-5c2f-bc02-f3aa6ec10551" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327976/selection/9ccebc82ed6980dde7d16b81d9762af73f0143be4cbeaffa6679196fd08aa949" :answer/id #uuid "16854fc8-c904-5469-9d2f-65a5a12dd4cd" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327976/selection/e12d4983fbd6654994e391d24a2d5ddb7b86eecc46b8e498b844d5de49c724f2" :answer/id #uuid "0f262b13-84e4-5f54-b919-b57b8d34599c" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327976/selection/05f2e3b3482e0273ff233a0ae36e6c5917861913316a6ae9d6241ff929f42760" :answer/id #uuid "90ddbc97-0d86-5239-a23e-5c92e7fd0797" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327976/selection/9debc3986150df614d069dfd9536711c6675ff30fa5b5231dff409349f1bec5d" :answer/id #uuid "d4232619-6640-5341-b035-fbd46ad23231" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327976/selection" :answer-field/id #uuid "336e4e68-63a9-5046-b892-0e49408445dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-327976/selection/78de957e8699b7f5183607bbc580e4adcb4b99679dba79303b2883d73be32495" :answer-field/choices ["q-327976/selection/78de957e8699b7f5183607bbc580e4adcb4b99679dba79303b2883d73be32495" "q-327976/selection/9ccebc82ed6980dde7d16b81d9762af73f0143be4cbeaffa6679196fd08aa949" "q-327976/selection/e12d4983fbd6654994e391d24a2d5ddb7b86eecc46b8e498b844d5de49c724f2" "q-327976/selection/05f2e3b3482e0273ff233a0ae36e6c5917861913316a6ae9d6241ff929f42760" "q-327976/selection/9debc3986150df614d069dfd9536711c6675ff30fa5b5231dff409349f1bec5d"] :db/ensure [:answer-field/validate]} {:db/id "q-327976" :question/id #uuid "cca77f3c-b8b3-5463-80d6-aae528e0d55f" :question/math-academy-id "q-327976" :question/problem "Find the general solution to the system of differential equations \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-3{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-4{x}_{1}(t)+3{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=1.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-3 & 2 \\\\ -4 & 3\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=-1\\,\\text{and}\\,{\\lambda }_{2}=1.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=-1,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-2 & 2 \\\\ -4 & 4\\end{aligned}]∼[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=1,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-4 & 2 \\\\ -4 & 2\\end{aligned}]∼[\\begin{aligned}1 & -\\frac{1}{2} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-327976/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39"] :knowledge-point/questions ["q-327976"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327974/selection/d836f733ea83a0a75266c465f0950872aca110384c4f7dd9b3ff96044c65aae2" :answer/id #uuid "3d11e13a-720d-5cf7-aafc-53593259766a" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}5 \\\\ -6\\end{aligned}]{e}^{-3t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327974/selection/7582bf02e63a06262daa9b6e63f7869cf08adb01bc36059ac9c556549339e8b1" :answer/id #uuid "7a1c855d-dd94-5797-b190-03418fa5e5e4" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}0 \\\\ 5\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}1 \\\\ -6\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327974/selection/649c667926114f1f685a378ca09f43fc0742d3937262964140eff47261848be1" :answer/id #uuid "6b32bb3e-8dcb-5ce0-95ef-015b69550ef3" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}5 \\\\ -6\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2