bd889927e0990cafba18266f7b85c030d55a5d5dbf46c2bd19461" "q-324453/selection/ma-v1/2b830b818b7c8c122c889f4df99bebc494520819e3d5b3be7f072591fc9b8d82/4765682070e348c2e5d1d7ac0fe123ce639ac7eda4d5dbd4bc9cae3d8202007b" "q-324453/selection/ma-v1/2b830b818b7c8c122c889f4df99bebc494520819e3d5b3be7f072591fc9b8d82/81f3613eeddff7c649cf7bff7c825fcefd1e5ef6f9eb2c0a830ab06c51d02ca5" "q-324453/selection/ma-v1/2b830b818b7c8c122c889f4df99bebc494520819e3d5b3be7f072591fc9b8d82/74bb06cfc8e1113aa7e9be189036ae37b3a9ba0ba3d0b2503988fd7520b258e0" "q-324453/selection/ma-v1/2b830b818b7c8c122c889f4df99bebc494520819e3d5b3be7f072591fc9b8d82/3f3772de5db8c8b129a68c1a194ade1b6e5fb046bcccc4069b278f5a85a46ea0"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-324453"] :question/problem "Find the general solution to the system of differential equations \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=2.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}1 & 3 \\\\ 1 & -1\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=-2\\,\\text{and}\\,{\\lambda }_{2}=2.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=-2,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}3 & 3 \\\\ 1 & 1\\end{aligned}]∼[\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=2,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-1 & 3 \\\\ 1 & -3\\end{aligned}]∼[\\begin{aligned}1 & -3 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}3 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-324453/selection/ma-v1/2b830b818b7c8c122c889f4df99bebc494520819e3d5b3be7f072591fc9b8d82"] :db/ensure [:question/validate]} {:db/id "q-327985/selection/7db174aea5526f0891b9f919f9897a610491a0a9583bd5af5dad96509bdcee45" :answer/id #uuid "00225779-6c9f-5938-8c4f-3f14462996f7" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-4t}+{c}_{2}[\\begin{aligned}7 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327985/selection/6221f4a30ef1c45e8b4dc09cf0610526576abd1e1213b5904a2d486f378a2629" :answer/id #uuid "1f136251-509a-5d15-b3e3-6af4ec55c9af" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}7 \\\\ 2\\end{aligned}]{e}^{-4t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327985/selection/45c00a3017862735e071edce687acf83001d8317dd41ba74d8bc6f5d166070fc" :answer/id #uuid "cc3606a9-95ff-58d5-9789-c9b610c2a313" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 7\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-4t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327985/selection/88af28b5ea7fa95dbb26ed27ff30f2177708459433e9aa7c58a3884ca67c9428" :answer/id #uuid "57ba8929-1c57-5498-8d89-9928620e9629" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327985/selection/660b1fa1eff6beed8f5f545360781a768de6bccf8a995a5338d8c33774915bab" :answer/id #uuid "d57deb49-8c5d-56d6-80b1-e010699ea5d5" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}7 \\\\ 2\\end{aligned}]{e}^{-4t},\\,{c}_{1},\\in R" :db/ensure [:answer/validate]} {:db/id "q-327985/selection" :answer-field/id #uuid "26bf890f-4ff0-5244-b0db-b307672b514d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-327985/selection/6221f4a30ef1c45e8b4dc09cf0610526576abd1e1213b5904a2d486f378a2629" :answer-field/choices ["q-327985/selection/7db174aea5526f0891b9f919f9897a610491a0a9583bd5af5dad96509bdcee45" "q-327985/selection/6221f4a30ef1c45e8b4dc09cf0610526576abd1e1213b5904a2d486f378a2629" "q-327985/selection/45c00a3017862735e071edce687acf83001d8317dd41ba74d8bc6f5d166070fc" "q-327985/selection/88af28b5ea7fa95dbb26ed27ff30f2177708459433e9aa7c58a3884ca67c9428" "q-327985/selection/660b1fa1eff6beed8f5f545360781a768de6bccf8a995a5338d8c33774915bab"] :db/ensure [:answer-field/validate]} {:db/id "q-327985" :question/id #uuid "802d5442-1f0e-583f-84f8-0e38794c6ba9" :question/math-academy-id "q-327985" :question/problem "Find the general solution to the system of differential equations \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-6{x}_{1}(t)+7{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+3{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=1.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-6 & 7 \\\\ -2 & 3\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=-4\\,\\text{and}\\,{\\lambda }_{2}=1.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=-4,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-2 & 7 \\\\ -2 & 7\\end{aligned}]∼[\\begin{aligned}1 & -\\frac{7}{2} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}7 \\\\ 2\\end{aligned}].$\n\n- For ${\\lambda }_{2}=1,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-7 & 7 \\\\ -2 & 2\\end{aligned}]∼[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}7 \\\\ 2\\end{aligned}]{e}^{-4t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-327985/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39"] :knowledge-point/questions ["q-327985"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327972/selection/afa89685010a258b84a4999f9d013db6668df639b236716e39f56c3d9fee68e8" :answer/id #uuid "0fee2209-3715-52a0-8549-04880d36d07e" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}5 \\\\ 2\\end{aligned}]{e}^{-3t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327972/selection/aa3d179578563cb17c2565ad333e5f8026dc0b29381e57828b54714f5a4f7749" :answer/id #uuid "c8caa4cd-9082-5d3e-9037-a0445f7f4175" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}5 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327972/selection/9c1db5d2f1ee7e78dab926b901cd179afb13dc8273f49856ea19c104dffc7d31" :answer/id #uuid "b3b334e2-f5f5-53c6-8706-bc52f2582c1b" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}5 \\\\ 1\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327972/selection/1383e377675c2b626ea738a22e0590b6a9ed9