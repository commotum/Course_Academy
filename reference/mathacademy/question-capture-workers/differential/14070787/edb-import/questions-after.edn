#{[{:db/id #edb/ref 17592186368175 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd428707-bb32-58b2-8a51-09e330af0bb1" :knowledge-point/title "Identifying Pairs of Linearly Independent Functions Using the Wronskian"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79c8d9af-82c6-5ecf-b9f7-0bdfbc22d681" :answer/type {:db/ident :answer.type/math} :answer/value "-1+\\operatorname{cos}⁡x" :db/id #edb/ref 17592186368177} {:answer/id #uuid "090180d9-9124-56a0-9cf5-99a7cf970b26" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x" :db/id #edb/ref 17592186368178} {:answer/id #uuid "1f04b67e-0d70-58d4-ba0f-2bd381d9e75a" :answer/type {:db/ident :answer.type/math} :answer/value "-1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186368179} {:answer/id #uuid "c9cee825-29d8-5ad3-97ff-776f8a679d8c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368180}] :answer-field/correct {:answer/id #uuid "1f04b67e-0d70-58d4-ba0f-2bd381d9e75a" :answer/type {:db/ident :answer.type/math} :answer/value "-1-\\operatorname{cos}⁡x" :db/id #edb/ref 17592186368179} :answer-field/id #uuid "e8587786-ae81-59b0-988e-39a832083828" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368176} {:answer-field/choices [{:answer/id #uuid "f6a92a1a-0d75-589d-a2b0-4641bcab817d" :answer/type {:db/ident :answer.type/text} :answer/value "zero for all $x\\in R$" :db/id #edb/ref 17592186368182} {:answer/id #uuid "d9f597c3-6f1d-506f-8c29-f697963475b2" :answer/type {:db/ident :answer.type/text} :answer/value "nonzero for at least one $x\\in R$" :db/id #edb/ref 17592186368183}] :answer-field/correct {:answer/id #uuid "d9f597c3-6f1d-506f-8c29-f697963475b2" :answer/type {:db/ident :answer.type/text} :answer/value "nonzero for at least one $x\\in R$" :db/id #edb/ref 17592186368183} :answer-field/id #uuid "1774efb2-0a52-5325-a666-bcf0d3645685" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368181} {:answer-field/choices [{:answer/id #uuid "882ad46b-accf-5f41-8b52-a2272f166240" :answer/type {:db/ident :answer.type/text} :answer/value "dependent" :db/id #edb/ref 17592186368185} {:answer/id #uuid "c4383592-63fe-566f-8f01-b00301d125c4" :answer/type {:db/ident :answer.type/text} :answer/value "independent" :db/id #edb/ref 17592186368186}] :answer-field/correct {:answer/id #uuid "c4383592-63fe-566f-8f01-b00301d125c4" :answer/type {:db/ident :answer.type/text} :answer/value "independent" :db/id #edb/ref 17592186368186} :answer-field/id #uuid "184fbb94-3b47-5cd0-958b-de31165a48b5" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368184}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0932b3bc-4ddc-5e49-8937-50f983b26a90" :question/math-academy-id "q-334114" :question/problem "$$\n{y}_{1}(x)=\\operatorname{sin}⁡x,\\,{y}_{2}(x)=\\operatorname{cos}⁡x+1,\\,x\\in R\n$$\n\nConsider the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ above. Given that ${y}_{1}$ and ${y}_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({y}_{1},{y}_{2})=$ \n{{field-1}},\nwhich is\n{{field-2}}.\n\n$\\,$ Therefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly \n{{field-3}} \non $R.$" :question/worked-solution "Suppose the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are defined on some interval $I.$\nThe Wronskian $W({y}_{1},{y}_{2})$ of these functions is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nRecall the following:\n\n- If $W\\ne 0$ for at least one $x\\in I,$ then ${y}_{1}$ and ${y}_{2}$ are linearly independent.\n\n- If $W=0$ and it’s known that ${y}_{1}$ and ${y}_{2}$ are solutions to the same second-order linear differential equation, then ${y}_{1}$ and ${y}_{2}$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}\\operatorname{sin}⁡x & \\operatorname{cos}⁡x+1 \\\\ {(\\operatorname{sin}⁡x)}^{′} & {(\\operatorname{cos}⁡x+1)}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{sin}⁡x & \\operatorname{cos}⁡x+1 \\\\ \\operatorname{cos}⁡x & -\\operatorname{sin}⁡x\\end{aligned}| \\\\  & =\\operatorname{sin}⁡x\\cdot (-\\operatorname{sin}⁡x)-(\\operatorname{cos}⁡x+1)\\cdot \\operatorname{cos}⁡x \\\\  & =-{sin}^{2}⁡x-({cos}^{2}⁡x+\\operatorname{cos}⁡x) \\\\  & =-({sin}^{2}⁡x+{cos}^{2}⁡x)-\\operatorname{cos}⁡x \\\\  & =-1-\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }x\\in R.$\n\nTherefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly $\\text{independent}$ on $R.$"}] [{:db/id #edb/ref 17592186368187 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd428707-bb32-58b2-8a51-09e330af0bb1" :knowledge-point/title "Identifying Pairs of Linearly Independent Functions Using the Wronskian"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55ed9799-3877-5b9f-9b04-4b3c6f1d6103" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{3}-x" :db/id #edb/ref 17592186368189} {:answer/id #uuid "9229e6b5-1304-5e5c-84ae-c85da7c394a5" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{3}-1" :db/id #edb/ref 17592186368190} {:answer/id #uuid "2a75cf0f-8afc-5ae0-b547-505a4aa6f37d" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}+1" :db/id #edb/ref 17592186368191} {:answer/id #uuid "3c62095a-95a8-5108-9dc8-d89110ace09f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368192}] :answer-field/correct {:answer/id #uuid "9229e6b5-1304-5e5c-84ae-c85da7c394a5" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{3}-1" :db/id #edb/ref 17592186368190} :answer-field/id #uuid "7280a9c3-8e09-568f-a4f0-61d0b3a6c7f3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368188} {:answer-field/choices [{:answer/id #uuid "611b5e18-a429-570a-a443-c4435e5b9415" :answer/type {:db/ident :answer.type/text} :answer/value "zero for all $x\\in R$" :db/id #edb/ref 17592186368194} {:answer/id #uuid "123797b3-47e8-509c-98a9-cec833ce5553" :answer/type {:db/ident :answer.type/text} :answer/value "nonzero for at least one $x\\in R$" :db/id #edb/ref 17592186368195}] :answer-field/correct {:answer/id #uuid "123797b3-47e8-509c-98a9-cec833ce5553" :answer/type {:db/ident :answer.type/text} :answer/value "nonzero for at least one $x\\in R$" :db/id #edb/ref 17592186368195} :answer-field/id #uuid "09cef95f-da8e-5609-81ec-4c8a7e980ddb" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368193} {:answer-field/choices [{:answer/id #uuid "a7ffce77-52d5-54df-bb83-73d19e6ffa8c" :answer/type {:db/ident :answer.type/text} :answer/value "dependent" :db/id #edb/ref 17592186368197} {:answer/id #uuid "61462246-c168-51f4-813e-9db55f2425d1" :answer/type {:db/ident :answer.type/text} :answer/value "independent" :db/id #edb/ref 17592186368198}] :answer-field/correct {:answer/id #uuid "61462246-c168-51f4-813e-9db55f2425d1" :answer/type {:db/ident :answer.type/text} :answer/value "independent" :db/id #edb/ref 17592186368198} :answer-field/id #uuid "55779daa-c3c2-5448-8197-159ddfb6239c" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186368196}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "33c7e127-d81f-5cec-b0b0-ddcb001acc95" :question/math-academy-id "q-334120" :question/problem "$$\n{y}_{1}(x)=x,\\,{y}_{2}(x)={x}^{3}+1,\\,x\\in R\n$$\n\nConsider the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ above. Given that ${y}_{1}$ and ${y}_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({y}_{1},{y}_{2})=$ \n{{field-1}},  \nwhich is\n{{field-2}}.\n\n$\\,$ Therefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly \n{{field-3}} \non $R.$" :question/worked-solution "Suppose the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are defined on some interval $I.$\nThe Wronskian $W({y}_{1},{y}_{2})$ of these functions is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nRecall the following:\n\n- If $W\\ne 0$ for at least one $x\\in I,$ then ${y}_{1}$ and ${y}_{2}$ are linearly independent.\n\n- If $W=0$ and it’s known that ${y}_{1}$ and ${y}_{2}$ are solutions to the same second-order linear differential equation, then ${y}_{1}$ and ${y}_{2}$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}x & {x}^{3}+1 \\\\ (x)^{′} & ({x}^{3}+1)^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}x & {x}^{3}+1 \\\\ 1 & 3{x}^{2}\\end{aligned}| \\\\  & =x\\cdot (3{x}^{2})-({x}^{3}+1)\\cdot 1 \\\\  & =3{x}^{3}-{x}^{3}-1 \\\\  & =2{x}^{3}-1\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }x\\in R.$\n\nTherefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly $\\text{independent}$ on $R.$"}] [{:db/id #edb/ref 17592186368199 :knowledge-point/_questions [{:knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b17b0b91-cc18-5e30-8a24-a2e200472dab" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186368201} {:answer/id #uuid "bc046aaa-de2e-5335-8a8d-cf4dac702f7d" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186368202} {:answer/id #uuid "91732f5a-9ce2-538e-bb65-5e994b64a0a9" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186368203} {:answer/id #uuid "e768bee1-8a7b-5a5f-bf2a-ebd37224e2ed" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186368204} {:answer/id #uuid "947fd302-9ab8-5c1e-95cc-a28929c9bd7b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186368205}] :answer-field/correct {:answer/id #uuid "b17b0b91-cc18-5e30-8a24-a2e200472dab" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186368201} :answer-field/id #uuid "dc61a57e-3344-51ec-9204-18f598921f20" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368200}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a5e7a1fb-5172-520d-b15a-ca0c65b53d2a" :question/math-academy-id "q-334266" :question/problem "$$\n{x}^{2}{y}^{″}-3x{y}^{′}+4y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={x}^{2}$ is a solution to the equation.\n- ${y}_{2}(x)={x}^{2}\\operatorname{ln}⁡(x)$ is a solution to the equation for $x>0.$\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$" :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =2x \\\\ {y}_{1}^{″}(x) & =2\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot 2-3x\\cdot 2x+4{x}^{2} & =0 \\\\ 2{x}^{2}-6{x}^{2}+4{x}^{2} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =2x\\operatorname{ln}⁡(x)+x \\\\ {y}_{2}^{″}(x) & =2\\operatorname{ln}⁡(x)+3\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(2\\operatorname{ln}⁡(x)+3)-3x(2x\\operatorname{ln}⁡(x)+x)+4{x}^{2}\\operatorname{ln}⁡(x) & =0 \\\\ 2{x}^{2}\\operatorname{ln}⁡(x)+3{x}^{2}-6{x}^{2}\\operatorname{ln}⁡(x)-3{x}^{2}+4{x}^{2}\\operatorname{ln}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is true. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{2} & {x}^{2}\\operatorname{ln}⁡(x) \\\\ 2x & 2x\\operatorname{ln}⁡(x)+x\\end{aligned}| \\\\  & ={x}^{2}(2x\\operatorname{ln}⁡(x)+x)-{x}^{2}\\operatorname{ln}⁡(x)\\cdot 2x \\\\  & =2{x}^{3}\\operatorname{ln}⁡(x)+{x}^{3}-2{x}^{3}\\operatorname{ln}⁡(x) \\\\  & ={x}^{3}\\end{aligned}\n$$\n\nSince the  Wronskian is not identically $0$ on $(0,\\infty ),$ the functions are linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation on $(0,\\infty ).$\n\nTherefore, the correct answer is \"I, II, and III\"."}] [{:db/id #edb/ref 17592186368206 :knowledge-point/_questions [{:knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8890d62-0152-5bac-9882-38e908e64b5a" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186368208} {:answer/id #uuid "975d659c-b43b-5336-854a-84d35d30628b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186368209} {:answer/id #uuid "14cf47e7-f952-5a03-bfeb-8cd8c8ca6e18" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186368210} {:answer/id #uuid "c25cbc44-908b-5a5a-8c35-894e8c8f6398" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186368211} {:answer/id #uuid "ca187e84-a661-58a3-9890-774b8e9d5a9d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186368212}] :answer-field/correct {:answer/id #uuid "c25cbc44-908b-5a5a-8c35-894e8c8f6398" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186368211} :answer-field/id #uuid "9b182d26-d370-5812-a41e-320a46e74f2f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368207}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e5ef7138-6ef1-5117-966e-d0b3724a9ae1" :question/math-academy-id "q-334278" :question/problem "$$\n{y}^{″}+4y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)=\\operatorname{cos}⁡(2x)$ is a solution to the equation.\n- ${y}_{2}(x)=4\\operatorname{cos}⁡(2x)$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-2\\operatorname{sin}⁡(2x) \\\\ {y}_{1}^{″}(x) & =-4\\operatorname{cos}⁡(2x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-4\\operatorname{cos}⁡(2x)+4\\operatorname{cos}⁡(2x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =-8\\operatorname{sin}⁡(2x) \\\\ {y}_{2}^{″}(x) & =-16\\operatorname{cos}⁡(2x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-16\\operatorname{cos}⁡(2x)+16\\operatorname{cos}⁡(2x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{cos}⁡(2x) & 4\\operatorname{cos}⁡(2x) \\\\ -2\\operatorname{sin}⁡(2x) & -8\\operatorname{sin}⁡(2x)\\end{aligned}| \\\\  & =\\operatorname{cos}⁡(2x)\\cdot (-8\\operatorname{sin}⁡(2x))-4\\operatorname{cos}⁡(2x)\\cdot (-2\\operatorname{sin}⁡(2x)) \\\\  & =-8\\operatorname{cos}⁡(2x)\\operatorname{sin}⁡(2x)+8\\operatorname{cos}⁡(2x)\\operatorname{sin}⁡(2x) \\\\  & =0\\end{aligned}\n$$\n\nSince the  Wronskian equals $0$ for all $x\\in R,$ the functions are not linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I and II only\"."}] [{:db/id #edb/ref 17592186368213 :knowledge-point/_questions [{:knowledge-point/id #uuid "4ca68460-f3fe-5ae8-b5f4-85742c0ef46b" :knowledge-point/title "Calculating the Wronskian of Two Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ca1b06c-f889-5ffa-a045-40ded7f868a9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186368215} {:answer/id #uuid "585a1ec7-702e-5e36-98bd-9f3449db55cc" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186368216} {:answer/id #uuid "13e37701-cc75-53f8-94d3-660d8d40adb1" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{x}" :db/id #edb/ref 17592186368217} {:answer/id #uuid "806e9f53-26b8-5a7f-8785-627d89b910f8" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{x}" :db/id #edb/ref 17592186368218} {:answer/id #uuid "ea76f466-76d8-5597-80e7-473563cd7f55" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186368219}] :answer-field/correct {:answer/id #uuid "2ca1b06c-f889-5ffa-a045-40ded7f868a9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2x}" :db/id #edb/ref 17592186368215} :answer-field/id #uuid "569512a0-403c-541f-b2e6-367c987dcfc0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186368214}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2d6d6775-8a16-53f5-823c-f560d775f277" :question/math-academy-id "q-64747" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)=x{e}^{x}.$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as:\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}\n$$\n\nIn our case, we have ${y}_{1}(x)={e}^{x}$ and ${y}_{2}(x)=x{e}^{x}.$ Therefore:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =({e}^{x}){(x{e}^{x})}^{′}-(x{e}^{x}){({e}^{x})}^{′} \\\\  & =({e}^{x})({e}^{x}+x{e}^{x})-(x{e}^{x})({e}^{x}) \\\\  & ={e}^{x}({e}^{x}+x{e}^{x}-x{e}^{x}) \\\\  & ={e}^{x}({e}^{x}) \\\\  & ={e}^{2x}\\end{aligned}\n$$"}]}
