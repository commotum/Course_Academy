#{[{:db/id #edb/ref 17592186366656 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe7e5c4f-6ac0-58e8-8b95-fe5a2230341c" :knowledge-point/title "Finding General Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd0e14a7-1831-52de-b97d-f9bbca01cb51" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+B{e}^{x}" :db/id #edb/ref 17592186366658} {:answer/id #uuid "03b8a4eb-5926-5b39-838c-eb42edb068fe" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-x}+B{e}^{5x}" :db/id #edb/ref 17592186366659} {:answer/id #uuid "95106564-a137-582a-b583-d1be407d85f3" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+B{e}^{5x}" :db/id #edb/ref 17592186366660} {:answer/id #uuid "866058ed-b3a2-5418-ac4f-ca1999de2e8b" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{x}+B{e}^{4x}" :db/id #edb/ref 17592186366661} {:answer/id #uuid "0e0556aa-9b10-5ae0-8448-b3a93b10d052" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-5x}+B{e}^{4x}" :db/id #edb/ref 17592186366662}] :answer-field/correct {:answer/id #uuid "866058ed-b3a2-5418-ac4f-ca1999de2e8b" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{x}+B{e}^{4x}" :db/id #edb/ref 17592186366661} :answer-field/id #uuid "d3fb6eb3-577e-5782-86b5-8fbd4c870479" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366657}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "423c3716-190e-5b6f-9635-03a5ec2b0925" :question/math-academy-id "q-130118" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-5\\frac{\\text{d}y}{\\text{d}x}+4y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-5\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-5\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-5\\lambda +4=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda -4)(\\lambda -1)=0,\n$$\n\nand so $\\lambda =1$ or $\\lambda =4.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{x}+B{e}^{4x}.\n$$"}] [{:db/id #edb/ref 17592186366663 :knowledge-point/_questions [{:knowledge-point/id #uuid "fcb5d818-acb0-53c7-90f9-328256600175" :knowledge-point/title "Identifying Non-Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "395157eb-0911-5cc6-85be-7308cf221148" :answer/type {:db/ident :answer.type/math} :answer/value "2{e}^{-x}+4{e}^{3x}" :db/id #edb/ref 17592186366665} {:answer/id #uuid "6dbb3384-88ba-545c-9acc-559b3912a797" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3x}-3{e}^{-x}" :db/id #edb/ref 17592186366666} {:answer/id #uuid "ba979d18-04bc-5dd9-846f-a5d37c06ed9d" :answer/type {:db/ident :answer.type/math} :answer/value "-5{e}^{-3x}" :db/id #edb/ref 17592186366667} {:answer/id #uuid "26d3360f-43e6-53d0-bd68-d037f76ae20f" :answer/type {:db/ident :answer.type/math} :answer/value "8{e}^{3x}" :db/id #edb/ref 17592186366668} {:answer/id #uuid "831f0e6d-724e-516f-9e29-25f0172e95dc" :answer/type {:db/ident :answer.type/math} :answer/value "-4{e}^{-x}" :db/id #edb/ref 17592186366669}] :answer-field/correct {:answer/id #uuid "ba979d18-04bc-5dd9-846f-a5d37c06ed9d" :answer/type {:db/ident :answer.type/math} :answer/value "-5{e}^{-3x}" :db/id #edb/ref 17592186366667} :answer-field/id #uuid "b48aa4a7-b1fc-5bff-9c8a-c84ab1e6c7ba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366664}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "670e5717-fad8-5791-a10e-1498d79849c5" :question/math-academy-id "q-64706" :question/problem "Given that $y=y(x)$ satisfies the equation ${y}^{″}-2{y}^{′}-3y=0,$ which of the following **cannot** be $y(x)?$" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-2\\lambda {e}^{\\lambda x}-3{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-2\\lambda -3) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-2\\lambda -3 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +1)(\\lambda -3)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-1$ or $\\lambda =3.$\n\nTherefore, any linear combination of the functions ${e}^{-x}$ and ${e}^{3x}$ is a solution to the original differential equation. \n\nAmong the given options, only $-5{e}^{-3x}$ is not a solution."}] [{:db/id #edb/ref 17592186079077 :knowledge-point/_questions [{:knowledge-point/id #uuid "fcb5d818-acb0-53c7-90f9-328256600175" :knowledge-point/title "Identifying Non-Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e69d9bd-a3f3-5761-bb54-6d96ea8a6789" :answer/type {:db/ident :answer.type/math} :answer/value "4e^{-4t} + e^{t}" :db/id #edb/ref 17592186077674} {:answer/id #uuid "b7487824-a937-571a-a1ff-7fe19cefde8e" :answer/type {:db/ident :answer.type/math} :answer/value "-5e^{-4t}" :db/id #edb/ref 17592186077675} {:answer/id #uuid "caca511d-1178-54c6-96c1-bc1e440eba5a" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-4t} - e^{t}" :db/id #edb/ref 17592186077676} {:answer/id #uuid "e9b63642-7b55-5b9c-8afe-4781b33c4414" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{-4t} + e^{-t}" :db/id #edb/ref 17592186077677} {:answer/id #uuid "11490f70-2020-5d20-8878-2288fc5b91e3" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{t}" :db/id #edb/ref 17592186077678}] :answer-field/correct {:answer/id #uuid "e9b63642-7b55-5b9c-8afe-4781b33c4414" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{-4t} + e^{-t}" :db/id #edb/ref 17592186077677} :answer-field/id #uuid "63499b46-fd9c-5c55-94d2-6de3f44669f1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077673}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9f5e7eb7-af07-5752-88d0-e6c5860716ec" :question/math-academy-id "q-64707" :question/problem "Given that $y=y(t)$ satisfies the equation ${y}^{″}+3{y}^{′}-4y=0,$ which of the following **cannot** be $y(t)?$" :question/worked-solution "Assuming $y={e}^{\\lambda t}$ and differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda t},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda t}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda t}+3\\lambda {e}^{\\lambda t}-4{e}^{\\lambda t} & =0 \\\\ {e}^{\\lambda t}({\\lambda }^{2}+3\\lambda -4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+3\\lambda -4 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +4)(\\lambda -1)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-4$ or $\\lambda =1.$\n\nTherefore, any linear combination of the functions ${e}^{-4t}$ and ${e}^{t}$ is a solution to the original differential equation. \n\nAmong the given options, only $-{e}^{-4t}+{e}^{-t}$ is not a solution."}] [{:db/id #edb/ref 17592186079121 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe7e5c4f-6ac0-58e8-8b95-fe5a2230341c" :knowledge-point/title "Finding General Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "832101e0-8572-5580-9553-fc173c783721" :answer/type {:db/ident :answer.type/math} :answer/value "y = Ae^{-2x} + Be^{-4x}" :db/id #edb/ref 17592186077938} {:answer/id #uuid "c9c912c4-f898-5e69-a5d3-cd4e2fd5d35e" :answer/type {:db/ident :answer.type/math} :answer/value "y = Ae^{2x} + Be^{4x}" :db/id #edb/ref 17592186077939} {:answer/id #uuid "ce12609c-e9f6-50f8-a994-52fd24872e2a" :answer/type {:db/ident :answer.type/math} :answer/value "y = Ae^{6x} + Be^{8x}" :db/id #edb/ref 17592186077940} {:answer/id #uuid "d5856173-7b5f-55b1-9304-0fc7d57752f1" :answer/type {:db/ident :answer.type/math} :answer/value "y = Ae^{2x} + Be^{-4x}" :db/id #edb/ref 17592186077941} {:answer/id #uuid "07a00f1f-5825-53b3-a5ab-01cd8a2bdd60" :answer/type {:db/ident :answer.type/math} :answer/value "y = Ae^{-2x} + Be^{3x}" :db/id #edb/ref 17592186077942}] :answer-field/correct {:answer/id #uuid "832101e0-8572-5580-9553-fc173c783721" :answer/type {:db/ident :answer.type/math} :answer/value "y = Ae^{-2x} + Be^{-4x}" :db/id #edb/ref 17592186077938} :answer-field/id #uuid "bddacb00-387b-5e8f-8b22-d001e476be9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186077937}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b4af7b02-aa3b-5c89-83b9-f0034ff7803a" :question/math-academy-id "q-7781" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+6\\frac{\\text{d}y}{\\text{d}x}+8y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+6\\lambda {e}^{\\lambda x}+8{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+6\\lambda +8) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+6\\lambda +8=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda +2)(\\lambda +4)=0,\n$$\n\nand so $\\lambda =-2$ or $\\lambda =-4.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+B{e}^{-4x}.\n$$"}] [{:db/id #edb/ref 17592186366670 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe7e5c4f-6ac0-58e8-8b95-fe5a2230341c" :knowledge-point/title "Finding General Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8a0adeb8-9c4b-5724-92e0-ec3082fd6eb4" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-14x}+B{e}^{-2x}" :db/id #edb/ref 17592186366672} {:answer/id #uuid "a0ecf1d4-d1b0-5e0d-8f7d-9b31486c5c35" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-5x}+B{e}^{-4x}" :db/id #edb/ref 17592186366673} {:answer/id #uuid "92569b16-e86c-5066-9520-43a7f8ad905c" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-7x}+B{e}^{-4x}" :db/id #edb/ref 17592186366674} {:answer/id #uuid "63223857-37d1-541d-804a-9730f96f10ef" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{2x}+B{e}^{14x}" :db/id #edb/ref 17592186366675} {:answer/id #uuid "25916f0c-ecda-5e3b-9987-65b843b2c208" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{4x}+B{e}^{7x}" :db/id #edb/ref 17592186366676}] :answer-field/correct {:answer/id #uuid "25916f0c-ecda-5e3b-9987-65b843b2c208" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{4x}+B{e}^{7x}" :db/id #edb/ref 17592186366676} :answer-field/id #uuid "2325434b-54bf-56df-8473-6d06e13de0cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186366671}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "206538c4-544c-533a-b6a8-2e2938267cac" :question/math-academy-id "q-90722" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-11\\frac{\\text{d}y}{\\text{d}x}+28y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-11\\lambda {e}^{\\lambda x}+28{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-11\\lambda +28) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-11\\lambda +28=0.\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n(\\lambda -4)(\\lambda -7)=0,\n$$\n\nand so $\\lambda =4$ or $\\lambda =7.$ \n\nTherefore, the general solution to the differential equation is\n\n$$\ny=A{e}^{4x}+B{e}^{7x}.\n$$"}]}
