}{\\text{d}t}(x(t-1)^{2}) & =\\frac{2-t}{t}(1-t) \\\\ \\int \\frac{\\text{d}}{\\text{d}t}(x(t-1)^{2})\\,\\text{d}t & =\\int \\frac{2-t}{t}(1-t)\\,\\text{d}t \\\\ x(t-1)^{2} & =\\int (\\frac{2}{t}-3+t)\\,\\text{d}t \\\\ x(t-1)^{2} & =2\\operatorname{ln}⁡|t|-3t+\\frac{{t}^{2}}{2}+C \\\\ x & =\\frac{4\\operatorname{ln}⁡|t|-6t+{t}^{2}+C}{2(t-1)^{2}}\\end{aligned}\n$$\n\nTherefore, we have that \n\n$$\nx(t)=\\frac{4\\operatorname{ln}⁡|t|-6t+{t}^{2}+C}{2(t-1)^{2}}.\n$$\n\nTo recover $y$, we substitute $x$ into\n\n$$\ny=x{t}^{2}-2t,\n$$\n\nwhich gives\n\n$$\n\\begin{aligned}y(t) & =(\\frac{4\\operatorname{ln}⁡|t|-6t+{t}^{2}+C}{2(t-1)^{2}}){t}^{2}-2t.\\end{aligned}\n$$\n\nFinally, we conclude that $f(t)={t}^{2},\\text{ }g(t)=-2t,$ and\n\n$$\nf(t)+g(t)={t}^{2}-2t.\n$$" 13194139535236 true] [17592186339079 1000 #edb/ref 17592186339080 13194139535236 true] [17592186339079 1000 #edb/ref 17592186339081 13194139535236 true] [17592186339079 1000 #edb/ref 17592186339082 13194139535236 true] [17592186339079 1000 #edb/ref 17592186339083 13194139535236 true] [17592186339079 1000 #edb/ref 17592186339084 13194139535236 true] [17592186339079 1040 #edb/ref 17592186045450 13194139535236 true] [17592186339079 1041 "selection" 13194139535236 true] [17592186339079 1104 #edb/ref 17592186339083 13194139535236 true] [17592186339079 1110 #uuid "dcd69973-65c9-51e4-97b5-0155ee907745" 13194139535236 true] [17592186339080 1034 "2-{t}^{2}" 13194139535236 true] [17592186339080 1103 #edb/ref 17592186045453 13194139535236 true] [17592186339080 1111 #uuid "1b555bf5-8563-5912-b8aa-5092cc5c2456" 13194139535236 true] [17592186339081 1034 "{t}^{2}+2t" 13194139535236 true] [17592186339081 1103 #edb/ref 17592186045453 13194139535236 true] [17592186339081 1111 #uuid "957726a9-5399-5e2d-93c2-57d65d3a747c" 13194139535236 true] [17592186339082 1034 "3{t}^{2}-t" 13194139535236 true] [17592186339082 1103 #edb/ref 17592186045453 13194139535236 true] [17592186339082 1111 #uuid "96f62f42-15f4-507d-acec-0be367977493" 131