\,{e}^{At} \\\\  & =[\\begin{aligned}0 & -7 \\\\ 7 & 0\\end{aligned}][\\begin{aligned}\\operatorname{cos}⁡(7t) & -\\operatorname{sin}⁡(7t) \\\\ \\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}] \\\\  & =[\\begin{aligned}-7\\operatorname{sin}⁡(7t) & -7\\operatorname{cos}⁡(7t) \\\\ 7\\operatorname{cos}⁡(7t) & -7\\operatorname{sin}⁡(7t)\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-335107/field-1" "q-335107/field-2" "q-335107/field-3" "q-335107/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d4fc3ba4-d488-5156-88dc-837369269cef"] :knowledge-point/questions ["q-335107"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335092/field-1/ff8f42846e5f83239b74dcba4496553c2569361f4a6709efd5e437946cdec0f6" :answer/id #uuid "8f199740-845c-515a-b21b-8d951918bd79" :answer/type :answer.type/math :answer/value "5e^{5t}" :db/ensure [:answer/validate]} {:db/id "q-335092/field-1/4549aae17f8c8103684e051f55b2d30deee83a112b49d939d0eea2f5c809b2be" :answer/id #uuid "36ce22ae-3828-5f35-be25-7cc431bae928" :answer/type :answer.type/math :answer/value "e^{5t}" :db/ensure [:answer/validate]} {:db/id "q-335092/field-1" :answer-field/id #uuid "9ff9c5c9-2296-5a8d-b4b8-9bd591066c38" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335092/field-1/ff8f42846e5f83239b74dcba4496553c2569361f4a6709efd5e437946cdec0f6" :answer-field/choices ["q-335092/field-1/ff8f42846e5f83239b74dcba4496553c2569361f4a6709efd5e437946cdec0f6" "q-335092/field-1/4549aae17f8c8103684e051f55b2d30deee83a112b49d939d0eea2f5c809b2be"] :db/ensure [:answer-field/validate]} {:db/id "q-335092/field-2/57a3f1047b0c143f9758dd38c4a825888725938b8901ac3fdd4aa050e32b3dc7" :answer/id #uuid "6a2cddaf-1d9d-57f6-9698-382db86f84f3" :answer/type :answer.type/math :answer/value "(1+5t)e^{5t}" :db/ensure [:answer/validate]} {:db/id "q-335092/field-2" :answer-field/id #uuid "4c883c63-dc1e-57dd