begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{et}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R.\n$$"}] [{:db/id #edb/ref 17592186369007 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce35e5a9-2444-5e5f-9463-5a4d54496d9d" :knowledge-point/title "Finding the General Solution to a Decoupled Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9f647e25-a216-50e4-af50-c39229f7e908" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186369009} {:answer/id #uuid "3a90b931-16bf-5500-aaa9-b6630475149c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]2{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186369010} {:answer/id #uuid "2be69479-299b-5d46-9f64-96791c9a66a7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186369011} {:answer/id #uuid "f1758fe1-e009-524e-ba30-6bcb0e7699c2" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186369012} {:answer/id #uuid "ef2eb8f6-2d0b-5aab-bece-c05d602373d5" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186369013}] :answer-field/correct {:answer/id #uuid "2be69479-299b-5d46-9f64-96791c9a66a7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186369011} :answer-field/id #uuid "3a18114e-ec4e-5ddf-9612-9edc543156d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369008}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a463e0f7-cd91-5e9d-9b27-b3ae47a71964" :question/math-academy-id "q-79671" :question/problem "Find the general solution to the system of differential equations\n${\\begin{aligned}{x}_{1}^{′}(t)=0 \\\\ {x}_{2}^{′}(t)=\\operatorname{ln}⁡(2){x}_{2}(t).\\end{aligned}$" :question/worked-solution "Given a decoupled system of first-order linear ODEs in the form\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\n$$\n\nthe formula for the general solution is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{{\\lambda }_{1}t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFirst, we write our differential equation in matrix form:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}0 & 0 \\\\ 0 & \\operatorname{ln}⁡(2)\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nSince the matrix of the differential system is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\operatorname{ln}⁡(2)t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$"}]}
