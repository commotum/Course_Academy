0 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}-1 \\\\ 1\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =-1\\cdot [\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{t}+1\\cdot [\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t} \\\\  & =[\\begin{aligned}-1 \\\\ 0\\end{aligned}]{e}^{t}+[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39239/selection/ma-v1/54f66d359fb819ca3b04f50b3882e54bb3fa0f0bbb4e9b9876328f6c96c4dda7"] :db/ensure [:question/validate]} {:db/id "q-39703/selection/774ac30af3212a697f76b2d93e22319a21ebbc6b0a62c4f13aaf6c1d66cf2488" :answer/id #uuid "2c3cdb8e-fd03-57e6-87c7-7b576f58f5da" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3\\pi t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-39703/selection/bd8cd36ad1f2b9cc82bbbed0e3ee8de46bae942dd1360113806e04f79327e0b2" :answer/id #uuid "323741c4-b32f-599e-adf2-02c25e38c5c6" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\pi t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-39703/selection/7595f37d42292802f93e412dc4e60959c2e7017ed77802cfe4389b9543d2fe40" :answer/id #uuid "2f224680-ef8d-5b70-935b-88353ea92b94" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-\\pi t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-39703/selection/adf66bb86139cf1c51b676b2db5ec4b5ec73da4e84b7b80c82ee86c340482c7d" :answer/id #uuid "09c13599-1cd2-5401-95a0-2254141a6810" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3\\pi t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-39703/selection/3b1af9cf8a8d90ae414800e4fdacb19f65cfd2a62cc519b70977c130d83aeeef" :answer/id #uuid "885be0a2-3978-5a25-9895-cc1204770ea6" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{3\\pi t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-\\pi t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-39703/selection" :answer-field/id #uuid "75aecd08-3203-57dd-962d-39e719c426fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39703/selection/bd8cd36ad1f2b9cc82bbbed0e3ee8de46bae942dd1360113806e04f79327e0b2" :answer-field/choices ["q-39703/selection/774ac30af3212a697f76b2d93e22319a21ebbc6b0a62c4f13aaf6c1d66cf2488" "q-39703/selection/bd8cd36ad1f2b9cc82bbbed0e3ee8de46bae942dd1360113806e04f79327e0b2" "q-39703/selection/7595f37d42292802f93e412dc4e60959c2e7017ed77802cfe4389b9543d2fe40" "q-39703/selection/adf66bb86139cf1c51b676b2db5ec4b5ec73da4e84b7b80c82ee86c340482c7d" "q-39703/selection/3b1af9cf8a8d90ae414800e4fdacb19f65cfd2a62cc519b70977c130d83aeeef"] :db/ensure [:answer-field/validate]} {:db/id "q-39703" :question/id #uuid "bcd1cc12-d6f9-5379-af7f-a875b90aaa40" :question/math-academy-id "q-39703" :question/problem "Find the general solution to the system of differential equations\n${\\begin{aligned}{x}_{1}^{′}(t)=-3{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=\\pi {x}_{2}(t).\\end{aligned}$" :question/worked-solution "Given a decoupled system of first-order linear ODEs in the form\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\n$$\n\nthe formula for the general solution is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{{\\lambda }_{1}t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFirst, we write our differential equation in matrix form:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}-3 & 0 \\\\ 0 & \\pi \\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nSince the matrix of the differential system is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\pi t},\\,{c}_{1},{c}_{2}\\in R.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39703/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ce35e5a9-2444-5e5f-9463-5a4d54496d9d"] :knowledge-point/questions ["q-39703"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79670/selection/ecfdeab52a73f19ece4e2a7b12cc8875d0de48be79e2a36de06dc04544f6dc63" :answer/id #uuid "e278da2f-c598-5824-9df6-71b8f5e48586" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{et}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-79670/selection/9a6f0f90df3d325ee72d6495ec64509e696bd7df5005bc139b7ce73f744b8005" :answer/id #uuid "db34ab3e-a262-5b78-903c-758fcd6072bd" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-79670/selection/fd500898bfcc328c8b2b64cb628509212050dd4710bd8f4599e72b3cc01d72c5" :answer/id #uuid "0228f297-9639-5895-be34-da7d75d89a4a" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-79670/selection/80f893bff3b83813a6d0bd95da0d2f0a1908d56ffd112ffbbf20440007443616" :answer/id #uuid "891b28cb-d4f5-596d-b1e2-38fb8645eafa" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{et}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-79670/selection/2cf56a37381d7c49874632c4994a235b5a0c1774c74b93a13d475fb886ebfdbf" :answer/id #uuid "fcab45ec-6fc0-515e-b077-0059094c10e6" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-et},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-79670/selection" :answer-field/id #uuid "c10cae22-38aa-509b-866f-2aed2298fbbd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79670/selection/ecfdeab52a73f19ece4e2a7b12cc8875d0de48be79e2a36de06dc04544f6dc63" :answer-field/choices ["q-79670/selection/ecfdeab52a73f19ece4e2a7b12cc8875d0de48be79e2a36de06dc04544f6dc63" "q-79670/selection/9a6f0f90df3d325ee72d6495ec64509e696bd7df5005bc139b7ce73f744b8005" "q-79670/selection/fd500898bfcc328c8b2b64cb628509212050dd4710bd8f4599e72b3cc01d72c5" "q-79670/selection/80f893bff3b83813a6d0bd95da0d2f0a1908d56ffd112ffbbf20440007443616" "q-79670/selection/2cf56a37381d7c49874632c4994a235b5a0c1774c74b93a13d475fb886ebfdbf"] :db/ensure [:answer-field/validate]} {:db/id "q-79670" :question/id #uuid "e7dd0472-f84b-5f41-ae18-d406d55b0bc9" :question/math-academy-id "q-79670" :question/problem "Find the general solution to the system of differential equations\n${\\begin{aligned}{x}_{1}^{′}(t)=e{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{2}(t).\\end{aligned}$" :question/worked-solution "Given a decoupled system of first-order linear ODEs in the form\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\n$$\n\nthe formula for the general solution is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{{\\lambda }_{1}t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFirst, we write our differential equation in matrix form:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}e & 0 \\\\ 0 & -2\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nSince the matrix of the differential system is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{et}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t},\\,{c}_{1},{c}_{2}\\in R.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79670/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ce35e5a9-2444-5e5f-9463-5a4d54496d9d"] :knowledge-point/questions ["q-79670"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79671/selection/377d0fffcde2a02b3b2ba7311c3eb94d7d7831f5fdaab03eae5d70acb243cf28" :answer/id #uuid "3a90b931-16bf-5500-aaa9-b6630475149c" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]2{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-79671/selection/d2df3fa7fef03710c3ff71e1e691cb26be4001a17ba199303c46723a12fd4da6" :answer/id #uuid "ef2eb8f6-2d0b-5aab-bece-c05d602373d5" :answer/type :answer.type/math :answer/value "x(t)={c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-79671/selection/bab086188648963200f2a7c5ef6c954a31b114d57dc2a14e8848291b4500f3dd" :answer/id #uuid "f1758fe1-e009-524e-ba30-6bcb0e7699c2" :answer/type :answer.type/math :answer/value "x(t)={c}_{2}[\\begin{aligned}0 \\\\ 1\\end