}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\n$$\n\nthe formula for the general solution is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{{\\lambda }_{1}t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFirst, we write our differential equation in matrix form:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}0 & 0 \\\\ 0 & \\operatorname{ln}⁡(2)\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nSince the matrix of the differential system is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\operatorname{ln}⁡(2)t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79671/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ce35e5a9-2444-5e5f-9463-5a4d54496d9d"] :knowledge-point/questions ["q-79671"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332716/selection/f0017305df294b4ac445b577dac82f866c2747bde79f2d2ea20721d0174a52e1" :answer/id #uuid "e434fe7d-a529-5830-ab6a-da9d8215ba4b" :answer/type :answer.type/math :answer/value "x(t)=[\\begin{aligned}0 \\\\ -5\\end{aligned}]{e}^{\\sqrt{7}t}" :db/ensure [:answer/validate]} {:db/id "q-332716/selection/f21bda2f064e620a3fa3f1e6440a00dab6346281b7909d83a65f7da1b70280db" :answer/id #uuid "76a6a07f-0247-5980-a494-e450296786dd" :answer/type :answer.type/math :answer/value "x(t)=[\\begin{aligned}-9 \\\\ 0\\end{aligned}]{2}^{-t}+[\\begin{aligned}0 \\\\ 5\\end{aligned}]{7}^{t/2}" :db/ensure [:answer/validate]} {:db/id "q-332716/selection/0603dd84df512461979f0f92edac2235ec6db315a2449094d9d2e5acb7dcdf89" :answer/id #uuid "4fc921c2-7d6d-5630-b287-3b5944fe1d44" :answer/type :answer.type/math :answer/value "x(t)=[\\begin{aligned}9 \\\\ 0\\end{aligned}]{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-332716/selection/f565b0962988483fcdb1219deb8809d6c2cccb4c5bfbfd151876dc179135f569" :answer/id #uuid "45841a2c-8a62-555c-9a04-0c7f4d369a82" :answer/type :answer.type/math :answer/value "x(t)=[\\begin{aligned}0 \\\\ -5\\end{aligned}]{e}^{-2t}+[\\begin{aligned}9 \\\\ 0\\end{aligned}]{e}^{\\sqrt{7}t}" :db/ensure [:answer/validate]} {:db/id "q-332716/selection/53f25f11857b632d88ca355a617e2a3ed54b2020f3a1c792876b35fcca4cf875" :answer/id #uuid "ee7f3b8f-7089-56b8-bdc2-7d5345a7bfd0" :answer/type :answer.type/math :answer/value "x(t)=[\\begin{aligned}9 \\\\ 0\\end{aligned}]{2}^{-t}+[\\begin{aligned}0 \\\\ -5\\end{aligned}]{e}^{\\sqrt{7}t}" :db/ensure [:answer/validate]} {:db/id "q-332716/selection" :answer-field/id #uuid "9c018f2c-e2bb-5b45-8cfe-2c4088ad8b80" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-332716/selection/53f25f11857b632d88ca355a617e2a3ed54b2020f3a1c792876b35fcca4cf875" :answer-field/choices ["q-332716/selection/f0017305df294b4ac445b577dac82f866c2747bde79f2d2ea20721d0174a52e1" "q-332716/selection/f21bda2f064e620a3fa3f1e6440a00dab6346281b7909d83a65f7da1b70280db" "q-332716/selection/0603dd84df512461979f0f92edac2235ec6db315a2449094d9d2e5acb7dcdf89" "q-332716/selection/f565b0962988483fcdb1219deb8809d6c2cccb4c5bfbfd151876dc179135f569" "q-332716/selection/53f25f11857b632d88ca355a617e2a3ed54b2020f3a1c792876b35fcca4cf875"] :db/ensure [:answer-field/validate]} {:db/id "q-332716" :question/id #uuid "8a203314-ffdc-5f7d-a0f6-f9522124d05e" :question/math-academy-id "q-332716" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-\\operatorname{ln}⁡2 & 0 \\\\ 0 & \\sqrt{7}\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}9 \\\\ -5\\end{aligned}].\n$$" :question/worked-solution "We have a decoupled system. Therefore, the general solution is given by\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-\\operatorname{ln}⁡2t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\sqrt{7}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{2}^{-t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\sqrt{7}t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}9 \\\\ -5\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}x(0) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}9 \\\\ -5\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =9\\cdot [\\begin{aligned}1 \\\\ 0\\end{aligned}]{2}^{-t}+(-5)\\cdot [\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\sqrt{7}t} \\\\  & =[\\begin{aligned}9 \\\\ 0\\end{aligned}]{2}^{-t}+[\\begin{aligned}0 \\\\ -5\\end{aligned}]{e}^{\\sqrt{7}t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332716/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cec0e48f-9fbb-5ada-b7fd-0d389d1b7438"] :knowledge-point/questions ["q-332716"] :db/ensure [:knowledge-point/validate]}]
