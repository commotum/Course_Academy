os}⁡(2x)\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n4\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)=R\\operatorname{sin}⁡(2x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n4\\operatorname{sin}⁡(2x)+3\\operatorname{cos}⁡(2x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡(2x)+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡(2x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(2x)$ and $\\operatorname{cos}⁡(2x),$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=4 \\\\ R\\operatorname{sin}⁡ϕ=3\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & ={4}^{2}+{3}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =16+9 \\\\ {R}^{2} & =25 \\\\ R & =5.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-327702" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/activity-metadata.json" "file_sha256" "cab1d110fad91a5454cc07913f68c920bed3a02a2543671beb0be3c79578ed7e"} {"question" "q-327702" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-327702" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-107555" "field" nil "attribute" "question/problem" "value" "Given that the expression $\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x$ can be written as $R\\operatorname{sin}⁡(x+ϕ)$ with $R>0,$ what is the value of $R?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-107555" "field" nil "attribute" "question/worked-solution" "value" "The sum formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(x+ϕ) & =R(\\operatorname{sin}⁡x\\operatorname{cos}⁡ϕ+\\operatorname{cos}⁡x\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡x+R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=R\\operatorname{sin}⁡(x+ϕ),\n$$\n\nwe get the following identity:\n\n$$\n\\sqrt{5}\\operatorname{sin}⁡x+2\\operatorname{cos}⁡x=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡x+(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡x\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡x$ and $\\operatorname{cos}⁡x,$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=\\sqrt{5} \\\\ R\\operatorname{sin}⁡ϕ=2\\end{aligned}\n$$\n\nSquaring the first and the second equations of the system and adding the results together, we get\n\n$$\n\\begin{aligned}{(R\\operatorname{cos}⁡ϕ)}^{2}+{(R\\operatorname{sin}⁡ϕ)}^{2} & =(\\sqrt{5})^{2}+{2}^{2} \\\\ {R}^{2}({cos}^{2}⁡ϕ+{sin}^{2}⁡ϕ) & =5+4 \\\\ {R}^{2} & =9 \\\\ R & =3.\\end{aligned}\n$$\n\nNote that we only consider the positive root since $R>0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-107555" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/activity-metadata.json" "file_sha256" "cab1d110fad91a5454cc07913f68c920bed3a02a2543671beb0be3c79578ed7e"} {"question" "q-107555" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-107555" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "9"] ["math" "\\frac{\\sqrt{5}}{2}"] ["math" "\\sqrt{10}"] ["math" "\\sqrt{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-107555" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-327979" "field" nil "attribute" "question/problem" "value" "Given that the expression $2\\operatorname{sin}⁡(3x)-5\\operatorname{cos}⁡(3x)$ can be written as $R\\operatorname{sin}⁡(3x-ϕ)$ with ${0}^{∘}<ϕ<{90}^{∘}$ and $R>0,$ what is the **exact** value of $ϕ?$\n\n$ϕ=\\operatorname{arctan}⁡($ \n{{field-1}} $)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-327979" "field" nil "attribute" "question/worked-solution" "value" "The difference formula for sine gives\n\n$$\n\\begin{aligned}R\\operatorname{sin}⁡(3x-ϕ) & =R(\\operatorname{sin}⁡(3x)\\operatorname{cos}⁡ϕ-\\operatorname{cos}⁡(3x)\\operatorname{sin}⁡ϕ) \\\\  & =R\\operatorname{cos}⁡ϕ\\operatorname{sin}⁡(3x)-R\\operatorname{sin}⁡ϕ\\operatorname{cos}⁡(3x)\\end{aligned}\n$$\n\nTherefore, by writing the given expression in the amplitude-phase form\n\n$$\n2\\operatorname{sin}⁡(3x)-5\\operatorname{cos}⁡(3x)=R\\operatorname{sin}⁡(3x-ϕ),\n$$\n\nwe get the following identity:\n\n$$\n2\\operatorname{sin}⁡(3x)-5\\operatorname{cos}⁡(3x)=(R\\operatorname{cos}⁡ϕ)\\operatorname{sin}⁡(3x)-(R\\operatorname{sin}⁡ϕ)\\operatorname{cos}⁡(3x)\n$$\n\nEquating the coefficients of $\\operatorname{sin}⁡(3x)$ and $\\operatorname{cos}⁡(3x),$ we get the following system of equations:\n\n$$\n{\\begin{aligned}R\\operatorname{cos}⁡ϕ=2 \\\\ R\\operatorname{sin}⁡ϕ=5\\end{aligned}\n$$\n\nDividing the second equation by the first, we get\n\n$$\n\\begin{aligned}\\frac{R\\operatorname{sin}⁡ϕ}{R\\operatorname{cos}⁡ϕ} & =\\frac{5}{2} \\\\ \\operatorname{tan}⁡ϕ & =\\frac{5}{2} \\\\ ϕ & =\\operatorname{arctan}⁡(\\frac{5}{2}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038530/state.json" "file_sha256" "b268fa94565c1db9deea58ee11f8fdf2750b0acf594557f8dfa6a48f0b6a47b2"} {"question" "q-327979" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differentia