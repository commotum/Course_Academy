egin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{3\\cdot 1+0\\cdot 3+(-3)\\cdot 0}{{1}^{2}+{3}^{2}+{0}^{2}}{a}_{2}=\\frac{3}{10}[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{9}{10}[\\begin{aligned}3 \\\\ -1 \\\\ 0\\end{aligned}]+\\frac{3}{10}[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}] \\\\  & =\\frac{3}{10}([\\begin{aligned}9 \\\\ -3 \\\\ 0\\end{aligned}]+[\\begin{aligned}1 \\\\ 3 \\\\ 0\\end{aligned}]) \\\\  & =[\\begin{aligned}3 \\\\ 0 \\\\ 0\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{(3-3)^{2}+(0-0)^{2}+(-3-0)^{2}} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40605/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8eb07a32-45bd-5975-9f61-de6294d4895d"] :knowledge-point/questions ["q-40605"] :db/ensure [:knowledge-point/validate]} {:db/id "q-140451/selection/f2bf222dd56e6f1adb7f88a2deb59dfa2e9462dc0b612e69e4116512673699b1" :answer/id #uuid "d941431a-d217-59e5-b268-e77b23af5124" :answer/type :answer.type/math :answer/value "{44.92}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-140451/selection/9dbe1bd857c123ca845051329ad5480a190390747a37295d30c4758cb0412b26" :answer/id #uuid "23a797f4-caec-5782-962a-29d0b880207f" :answer/type :answer.type/math :answer/value "{48.32}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-140451/selection/b0786c3fc1a183a52dd6207071c8ad7d9d0d7d0b5c971b130de4e4c7f3541c5d" :answer/id #uuid "951c7659-80e6-5d3a-8a35-d3a66f6a03e6" :answer/type :answer.type/math :answer/value "{42.29}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-140451/selection/ed9228e7c419ccecd7f1a3136d0ef82dd2e2f8f811c3fe3040a4af3dad5daafa" :answer/id #uuid "a172fce5-781c-52a7-b0a0-1ec3570fa3bd" :answer/type :answer.type/math :answer/value "{45.23}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-140451/selection/38155055aec4c8ed97c8f0daf48ac2e2099b838704ee379c180ee2d7bbb9931f" :answer/id #uuid "c3fcad1f-bae1-565b-a80f-2ebc8f80b415" :answer/type :answer.type/math :answer/value "{41.39}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-140451/selection" :answer-field/id #uuid "e1f3fbaa-468c-5d47-b722-06597f0b0c58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-140451/selection/b0786c3fc1a183a52dd6207071c8ad7d9d0d7d0b5c971b130de4e4c7f3541c5d" :answer-field/choices ["q-140451/selection/f2bf222dd56e6f1adb7f88a2deb59dfa2e9462dc0b612e69e4116512673699b1" "q-140451/selection/9dbe1bd857c123ca845051329ad5480a190390747a37295d30c4758cb0412b26" "q-140451/selection/b0786c3fc1a183a52dd6207071c8ad7d9d0d7d0b5c971b130de4e4c7f3541c5d" "q-140451/selection/ed9228e7c419ccecd7f1a3136d0ef82dd2e2f8f811c3fe3040a4af3dad5daafa" "q-140451/selection/38155055aec4c8ed97c8f0daf48ac2e2099b838704ee379c180ee2d7bbb9931f"] :db/ensure [:answer-field/validate]} {:db/id "q-140451" :question/id #uuid "180e6dff-0b43-5239-b883-c2a6466ae49f" :question/math-academy-id "q-140451" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}},$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}],\\,\\,x=[\\begin{aligned}6 \\\\ -1 \\\\ -4\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal.   Round the answer to $2$ decimal places." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{6\\cdot 2+(-1)\\cdot 0+(-4)\\cdot 2}{{2}^{2}+{0}^{2}+{2}^{2}}{a}_{1}=\\frac{1}{2}[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{6\\cdot 1+(-1)\\cdot 1+(-4)\\cdot (-1)}{{1}^{2}+{1}^{2}+(-1)^{2}}{a}_{2}=3[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{1}{2}[\\begin{aligned}2 \\\\ 0 \\\\ 2\\end{aligned}]+3[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 3 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{6\\cdot 4+(-1)\\cdot 3+(-4)\\cdot (-2)}{\\sqrt{{6}^{2}+(-1)^{2}+(-4)^{2}}\\sqrt{{4}^{2}+{3}^{2}+(-2)^{2}}} \\\\  & =\\frac{29}{\\sqrt{53}\\sqrt{29}} \\\\  & =\\sqrt{\\frac{29}{53}}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\sqrt{\\frac{29}{53}})≈{42.29}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-140451/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c93bf305-85ff-5455-91ba-ae60f3c1989d"] :knowledge-point/questions ["q-140451"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82950/selection/d62732e72e17b0393290bd9e548ef368f6b7424bded817d038b07db5bf5fcb98" :answer/id #uuid "afcf965c-e3e6-56a6-a1a5-556324362cbf" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "q-82950/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "4b7673a1-7656-52e5-b18e-02ccad4619f9" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-82950/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "13ea00ec-9fae-5abe-a8a0-d727df109e6c" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-82950/selection/0dbec4870e57573286a3b337231517a95e48a6378854240cef143d28f877d639" :answer/id #uuid "7f808610-b7e8-56f4-af93-cc794fb8f85f" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{5}" :db/ensure [:answer/validate]} {:db/id "q-82950/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "940ef9bc-57fc-5858-a0d8-37f54a7c839c" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-82950/selection" :answer-field/id #uuid "3d6bea67-d5f4-5664-859b-bd9e4a8a8d97" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82950/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer-field/choices ["q-82950/selection/d62732e72e17b0393290bd9e548ef368f6b7424bded817d038b07db5bf5fcb98" "q-82950/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-82950/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" "q-82950/selection/0dbec4870e57573286a3b337231517a95e48a6378854240cef143d28f877d639" "q-82950/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198"] :db/ensure [:answer-field/validate]} {:db/id "q-82950" :question/id #uuid "0d727048-e0d7-5a77-995e-bf03ee0a89fb" :question/math-academy-id "q-82950" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ -2\\end{aligned}],\\,\\,x=[\\begin{aligned}5 \\\\ 1 \\\\ 3 \\\\ 1\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{5\\cdot 2+1\\cdot (-2)+3\\cdot 0+1\\cdot 1}{{2}^{2}+(-2)^{2}+{0}^{2}+{1}^{2}}{a}_{1}=[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{5\\cdot 3+1\\cdot 2+3\\cdot 1+1\\cdot (-2)}{{3}^{2}+{2}^{2}+{1}^{2}+(-2)^{2}}{a}_{2}=[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ -2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}2 \\\\ -2 \\\\ 0 \\\\ 1\\end{aligned}]+[\\begin{aligned}3 \\\\ 2 \\\\ 1 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}5 \\\\ 0 \\\\ 1 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{5\\cdot 5+1\\cdot 0+3\\cdot 1+1\\cdot (-1)}{\\sqrt{{5}^{2}+{1}^{2}+{3}^{2}+{1}^{2}}\\sqrt{{5}^{2}+{0}^{2}+{1}^{2}+(-1)^{2}}} \\\\  & =\\frac{27}{\\sqrt{36}\\sqrt{27}} \\\\  & =\\frac{27}{6\\cdot 3\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{3}}{2})=\\frac{\\pi }{6},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-82950/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c93bf305-85ff-5455-91ba-ae60f3c1989d"] :knowledge-point/questions ["q-82950"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82978/selection/7a1454376aed8668989fe8e50bb541e377c159afa2c46a2eef7e308a35233c2c" :answer/id #uuid "a671535e-89de-550b-9fc8-7c0daf746afe" :answer/type :answer.type/math :answer/value "{48.59}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82978/selection/22bf8e145af12b34505d1ef439aac05fcf601ac2c920468a802ecca6975800dc" :answer/id #uuid "84231ab7-3deb-56ca-9b02-7524cf5f2438" :answer/type :answer.type/math :answer/value "{28.13}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82978/selection/c52d58e537cd2bf9d59516322a403446d72d1639fd83b16c03bb29f64cc50547" :answer/id #uuid "dedd7b54-2e2b-57f4-abb5-e501bfdd0fe3" :answer/type :answer.type/math :answer/value "{36.32}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82978/selection/f0fecc2b21a0f84fd7dacdaefdb86d227b985df73c31216fdeabd7d90b3dbf8f" :answer/id #uuid "dc4ec700-ce94-540c-9c34-3f1a5de9a83e" :answer/type :answer.type/math :answer/value "{7.18}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82978/selection/dfb1911523a17018108f359f3b6fcc1e317967a2eb5d55af08fb83754faf6124" :answer/id #uuid "5de29845-916b-50af-82aa-d5deed981db8" :answer/type :answer.type/math :answer/value "{29.91}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82978/selection" :answer-field/id #uuid "2b989f56-c98e-5541-8090-aafb254c5786" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82978/selection/22bf8e145af12b34505d1ef439aac05fcf601ac2c920468a802ecca6975800dc" :answer-field/choices ["q-82978/selection/7a1454376aed8668989fe8e50bb541e377c159afa2c46a2eef7e308a35233c2c" "q-82978/selection/22bf8e145af12b34505d1ef439aac05fcf601ac2c920468a802ecca6975800dc" "q-82978/selection/c52d58e537cd2bf9d59516322a403446d72d1639fd83b16c03bb29f64cc50547" "q-82978/selection/f0fecc2b21a0f84fd7dacdaefdb86d227b985df73c31216fdeabd7d90b3dbf8f" "q-82978/selection/dfb1911523a17018108f359f3b6fcc1e317967a2eb5d55af08fb83754faf6124"] :db/ensure [:answer-field/validate]} {:db/id "q-82978" :question/id #uuid "a040e083-d81c-5acb-84bf-c293088be346" :question/math-academy-id "q-82978" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2},{a}_{3}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3 \\\\ -2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}],\\,{a}_{3}=[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}],\\,\\,x=[\\begin{aligned}1 \\\\ 7 \\\\ 3 \\\\ -2\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2},{a}_{3}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}},$ $\\text{Span}{{a}_{2}}$ and $\\text{Span}{{a}_{3}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot 1+7\\cdot 0+3\\cdot 3+(-2)\\cdot (-2)}{{1}^{2}+{0}^{2}+{3}^{2}+(-2)^{2}}{a}_{1}=[\\begin{aligned}1 \\\\ 0 \\\\ 3 \\\\ -2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 2+7\\cdot 3+3\\cdot 0+(-2)\\cdot 1}{{2}^{2}+{3}^{2}+{0}^{2}+{1}^{2}}{a}_{2}=\\frac{3}{2}[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{3}}x & =\\frac{x\\cdot {a}_{3}}{{a}_{3}\\cdot {a}_{3}}{a}_{3}=\\frac{1\\cdot 0+7\\cdot (-1)+3\\cdot 2+(-2)\\cdot 3}{{0}^{2}+(-1)^{2}+{2}^{2}+{3}^{2}}{a}_{3}=(-\\frac{1}{2})[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x+{\\text{proj}}_{{a}_{3}}x \\\\  & =[\\begin{aligned}1 \\\\ 0 \\\\ 3 \\\\ -2\\end{aligned}]+\\frac{3}{2}[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}]+(-\\frac{1}{2})[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}] \\\\  & =\\frac{1}{2}([\\begin{aligned}2 \\\\ 0 \\\\ 6 \\\\ -4\\end{aligned}]+3[\\begin{aligned}2 \\\\ 3 \\\\ 0 \\\\ 1\\end{aligned}]+(-1)[\\begin{aligned}0 \\\\ -1 \\\\ 2 \\\\ 3\\end{aligned}]) \\\\  & =\\frac{1}{2}[\\begin{aligned}8 \\\\ 10 \\\\ 4 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}4 \\\\ 5 \\\\ 2 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{1\\cdot 4+7\\cdot 5+3\\cdot 2+(-2)\\cdot (-2)}{\\sqrt{{1}^{2}+{7}^{2}+{3}^{2}+(-2)^{2}}\\sqrt{{4}^{2}+{5}^{2}+{2}^{2}+(-2)^{2}}} \\\\  & =\\frac{49}{\\sqrt{63}\\sqrt{49}} \\\\  & =\\frac{49}{3\\sqrt{7}\\cdot 7} \\\\  & =\\frac{\\sqrt{7}}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{7}}{3})≈{28.13}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-82978/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c93bf305-85ff-5455-91ba-ae60f3c1989d"] :knowledge-point/questions ["q-82978"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82948/selection/cf1355ac8fe0761c7e026a4cb08fa65fa267773df42c20b9a3545b338f496b4f" :answer/id #uuid "d668d40c-9a28-5184-8d6e-aaabf53684c1" :answer/type :answer.type/math :answer/value "{11.12}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82948/selection/0b3c71c264a520f97ce63230ffc6ea7c34373b6b581a4c7b48ff4a1c22c85d47" :answer/id #uuid "e2f792ae-b8e3-5c21-b8bc-334dafbcd4b5" :answer/type :answer.type/math :answer/value "{12.11}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82948/selection/f1e8bf2bb04fad1f54f90d68616b825726530b37f0b62a2d5c611673fe95689c" :answer/id #uuid "98d71906-8c05-5a15-9ec9-e20a94433d39" :answer/type :answer.type/math :answer/value "{18.25}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82948/selection/6e8b3ba477fb0095d07d5e5b61644850d05c2dacf5524d4e955027ee21e1d4a1" :answer/id #uuid "0cdd4fb5-01e2-5e6b-ba98-a4c8714c3db3" :answer/type :answer.type/math :answer/value "{29.21}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82948/selection/523f964886de4de363556968d99411dda99bad1df43c30a29853614f88f4c5a0" :answer/id #uuid "3b89cb54-e767-5c5d-a3b1-305b7020c9fc" :answer/type :answer.type/math :answer/value "{25.24}^{∘}" :db/ensure [:answer/validate]} {:db/id "q-82948/selection" :answer-field/id #uuid "a8bd3fd2-e289-5311-9140-b6f71db70b14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82948/selection/523f964886de4de363556968d99411dda99bad1df43c30a29853614f88f4c5a0" :answer-field/choices ["q-82948/selection/cf1355ac8fe0761c7e026a4cb08fa65fa267773df42c20b9a3545b338f496b4f" "q-82948/selection/0b3c71c264a520f97ce63230ffc6ea7c34373b6b581a4c7b48ff4a1c22c85d47" "q-82948/selection/f1e8bf2bb04fad1f54f90d68616b825726530b37f0b62a2d5c611673fe95689c" "q-82948/selection/6e8b3ba477fb0095d07d5e5b61644850d05c2dacf5524d4e955027ee21e1d4a1" "q-82948/selection/523f964886de4de363556968d99411dda99bad1df43c30a29853614f88f4c5a0"] :db/ensure [:answer-field/validate]} {:db/id "q-82948" :question/id #uuid "4417e099-8677-544d-a57a-1a6fa347aa4b" :question/math-academy-id "q-82948" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}2 \\\\ 6 \\\\ -2\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal.   Round the answer to $2$ decimal places." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot 1+6\\cdot (-1)+(-2)\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}{a}_{1}=(-2)[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]=[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot 1+6\\cdot 2+(-2)\\cdot 1}{{1}^{2}+{2}^{2}+{1}^{2}}{a}_{2}=2[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]=[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}-2 \\\\ 2 \\\\ -2\\end{aligned}]+[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 6 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ \n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{2\\cdot 0+6\\cdot 6+(-2)\\cdot 0}{\\sqrt{{2}^{2}+{6}^{2}+(-2)^{2}}\\sqrt{{0}^{2}+{6}^{2}+{0}^{2}}} \\\\  & =\\frac{36}{\\sqrt{44}\\sqrt{36}} \\\\  & =\\frac{36}{2\\sqrt{11}\\cdot 6} \\\\  & =\\frac{3\\sqrt{11}}{11}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{3\\sqrt{11}}{11})≈{25.24}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-82948/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c93bf305-85ff-5455-91ba-ae60f3c1989d"] :knowledge-point/questions ["q-82948"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40223"] :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}].\n$$\n\nFind the acute angle between $x$ and the subspace $S$ given that the set ${{a}_{1},{a}_{2}}$ is orthogonal.   Round the answer to $2$ decimal places." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot 0+1\\cdot 1+(-1)\\cdot (-1)}{{0}^{2}+{1}^{2}+{(-1)}^{2}}{a}_{1}=[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 1+1\\cdot 2+(-1)\\cdot 2}{{1}^{2}+{2}^{2}+{2}^{2}}{a}_{2}=\\frac{1}{9}[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]+\\frac{1}{9}[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}] \\\\  & =\\frac{1}{9}([\\begin{aligned}0 \\\\ 9 \\\\ -9\\end{aligned}]+[\\begin{aligned}1 \\\\ 2 \\\\ 2\\end{aligned}]) \\\\  & =\\frac{1}{9}[\\begin{aligned}1 \\\\ 11 \\\\ -7\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}1 \\\\ 1 \\\\ -1\\end{aligned}]\\,$ and $\\,9\\,{\\text{proj}}_{S}x=[\\begin{aligned}1 \\\\ 11 \\\\ -7\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{1\\cdot 1+1\\cdot 11+(-1)\\cdot (-7)}{\\sqrt{{1}^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{1}^{2}+{11}^{2}+(-7)^{2}}} \\\\  & =\\frac{19}{\\sqrt{3}\\sqrt{171}} \\\\  & =\\frac{19}{\\sqrt{3}\\cdot 3\\sqrt{19}} \\\\  & =\\frac{\\sqrt{57}}{9}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{57}}{9})≈{32.98}^{∘},\n$$\n\nwhich is already an acute angle." :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5573"] :question/problem "Consider the vector $\\mathbf{x}$ and the subspace $S=\\textrm{Span}\\{ \\mathbf{a}_1,\\mathbf{a}_2 \\},$ where\n\n$$\n[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]\n$$\n\nFind the orthogonal projection of $\\mathbf{x}$ onto the subspace $S$ given that the set $\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ is orthogonal." :question/worked-solution "Since the set $\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ is orthogonal, the orthogonal projection of $\\mathbf{x}$ onto the subspace $S$ is given by\n\n$$\n\\textrm{proj}_{S}\\,\\mathbf{x} \n= \\textrm{proj}_{\\mathbf{a}_1}\\mathbf{x} + \\textrm{proj}_{\\mathbf{a}_2}\\mathbf{x}.\n$$\n\nSo, we first find the orthogonal projections of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{a}_1\\}$ and $\\textrm{Span}\\{\\mathbf{a}_2\\}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{2\\cdot 1+3\\cdot 1+(-2)\\cdot 1}{{1}^{2}+{1}^{2}+{1}^{2}}{a}_{1}=1[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{2\\cdot (-2)+3\\cdot 1+(-2)\\cdot 1}{(-2)^{2}+{1}^{2}+{1}^{2}}{a}_{2}=-\\frac{1}{2}[\\begin{aligned}-2 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =[\\begin{aligned}1 \\\\ 1 \\\\ 1\\end{aligned}]+(-\\frac{1}{2})[\\begin{aligned}-2 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 \\\\ \\frac{1}{2} \\\\ \\frac{1}{2}\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7173"] :question/problem "Consider the vector $\\mathbf{x}$ and the plane $\\mathbf{r}=s\\mathbf{v}+t\\mathbf{w},$ where $s,t\\in\\mathbb R,$ and\n\n$$\n[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]\n$$\n\n \nFind the orthogonal projection of $\\mathbf{x}$ onto the plane given that $\\mathbf{v} \\perp \\mathbf{w}.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}\\{\\mathbf{v}, \\mathbf{w}\\}$ in $\\mathbb{R}^3.$ \nAnd, since the set $\\{\\mathbf{v},\\mathbf{w}\\}$ is orthogonal, the orthogonal projection of $\\mathbf{x}$ onto the subspace $S$ is given by   \n\n$$\n\\textrm{proj}_{S}\\,\\mathbf{x} = \\textrm{proj}_{\\mathbf{v}}\\,\\mathbf{x} + \\textrm{proj}_{\\mathbf{w}}\\,\\mathbf{x}.\n$$\n\nSo, we first find the orthogonal projections of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{v}\\}$ and $\\textrm{Span}\\{\\mathbf{w}\\}\\mathbin{:}$ \n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{13\\cdot 2+(-2)\\cdot 3+(-1)\\cdot (-1)}{{2}^{2}+{3}^{2}+(-1)^{2}}v=\\frac{3}{2}[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{13\\cdot 5+(-2)\\cdot (-3)+(-1)\\cdot 1}{{5}^{2}+(-3)^{2}+{1}^{2}}w=2[\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{3}{2}[\\begin{aligned}2 \\\\ 3 \\\\ -1\\end{aligned}]+2[\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =[\\begin{aligned}3 \\\\ \\frac{9}{2} \\\\ -\\frac{3}{2}\\end{aligned}]+[\\begin{aligned}10 \\\\ -6 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}13 \\\\ -\\frac{3}{2} \\\\ \\frac{1}{2}\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5574"] :question/problem "Consider the vector $\\mathbf{x}$ and the subspace $S=\\textrm{Span}\\{ \\mathbf{a}_1,\\mathbf{a}_2 \\},$ where\n\n$$\n[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]\n$$\n\nFind the distance between $\\mathbf{x}$ and the subspace $S$ given that the set $\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ is orthogonal." :question/worked-solution "Since the set $\\{\\mathbf{a}_1,\\mathbf{a}_2\\}$ is orthogonal, the orthogonal projection of $\\mathbf{x}$ onto the subspace $S$ is given by\n\n$$\n\\textrm{proj}_{S}\\,\\mathbf{x} \n= \\textrm{proj}_{\\mathbf{a}_1}\\mathbf{x} + \\textrm{proj}_{\\mathbf{a}_2}\\mathbf{x}.\n$$\n\nSo, we first find the orthogonal projections of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{a}_1\\}$ and $\\textrm{Span}\\{\\mathbf{a}_2\\}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{3\\cdot 1+2\\cdot 2+1\\cdot 1}{{1}^{2}+{2}^{2}+{1}^{2}}{a}_{1}=\\frac{4}{3}[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{3\\cdot 1+2\\cdot (-1)+1\\cdot 1}{{1}^{2}+(-1)^{2}+{1}^{2}}{a}_{2}=\\frac{2}{3}[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{4}{3}[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]+\\frac{2}{3}[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{2}{3}(2[\\begin{aligned}1 \\\\ 2 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}2 \\\\ 2 \\\\ 2\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nFinally, the distance between $\\mathbf{x}$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}} \\\\  & =\\sqrt{{(3-2)}^{2}+{(2-2)}^{2}+{(1-2)}^{2}} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7309"] :question/problem "Consider the vector $\\mathbf{x}$ and the subspace $S=\\textrm{Span}\\{ \\mathbf v,\\mathbf w\\}$ where\n\n$$\n[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]\n$$\n\nFind the acute angle between $\\mathbf{x}$ and the subspace $S$ given that the set $\\{\\mathbf{v},\\mathbf{w}\\}$ is orthogonal." :question/worked-solution "Since the set $\\{\\mathbf{v},\\mathbf{w}\\}$ is orthogonal, the orthogonal projection of $\\mathbf{x}$ onto the subspace $S$ is given by\n\n$$\n\\textrm{proj}_{S}\\,\\mathbf{x} \n= \\textrm{proj}_{\\mathbf{v}}\\mathbf{x} + \\textrm{proj}_{\\mathbf{w}}\\mathbf{x}.\n$$\n\nSo, we first find the orthogonal projections of $\\mathbf{x}$ onto $\\textrm{Span}\\{\\mathbf{v}\\}$ and $\\textrm{Span}\\{\\mathbf{w}\\}\\mathbin{:}$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{\\sqrt{10}\\cdot 0+3\\cdot 1+1\\cdot 1}{{0}^{2}+(-1)^{2}+{1}^{2}}v=2[\\begin{aligned}0 \\\\ 1 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{\\sqrt{10}\\cdot 0+3\\cdot (-1)+1\\cdot 1}{{0}^{2}+(-1)^{2}+(-1)^{2}}w=(-1)[\\begin{aligned}0 \\\\ -1 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =[\\begin{aligned}0 \\\\ 2 \\\\ 2\\end{aligned}]+[\\begin{aligned}0 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 3 \\\\ 1\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $\\mathbf{x}$ and $S$ is the acute angle between $\\mathbf{x}$ and $\\textrm{proj}_S \\mathbf{x}$ or any other non-zero vector that is parallel to $\\textrm{proj}_S \\mathbf{x}.$ So, computing the cosine using the dot product, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{x\\cdot {\\text{proj}}_{S}\\,x}{‖x‖\\,‖{\\text{proj}}_{S}\\,x‖} \\\\  & =\\frac{\\sqrt{10}\\cdot 0+3\\cdot 3+1\\cdot 1}{\\sqrt{{(\\sqrt{10})}^{2}+{3}^{2}+{1}^{2}}\\,\\sqrt{{0}^{2}+{3}^{2}+{1}^{2}}} \\\\  & =\\frac{10}{\\sqrt{20}\\,\\sqrt{10}} \\\\  & =\\frac{10}{10\\,\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\theta = \\arccos\\left( \\dfrac{{\\sqrt2}}{2}\\right) = \\dfrac{\\pi}{4},\n$$\n\nwhich is already an acute angle." :db/ensure [:question/validate]}]
