bc91624083323e8f54f079e73a5" "q-39992/selection/7894546b3903677da13bdeaf9d7d2b29dd1b9c4bd056c1fb4a4b4fec38ca0754" "q-39992/selection/7a87a99a8d1277c92a7b9ae5f343ea9cbe64913aec3c836499f8c16b4014c9fb"] :db/ensure [:answer-field/validate]} {:db/id "q-39992" :question/id #uuid "8fa47428-4db5-5247-a146-29b4cebc836f" :question/math-academy-id "q-39992" :question/problem "Consider the vector $x$ and the subspace $S=\\text{Span}{{a}_{1},{a}_{2}}$ where\n\n$$\n{a}_{1}=[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}],\\,{a}_{2}=[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}1 \\\\ 4 \\\\ 3\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the subspace $S$ given that the set \n${{a}_{1},{a}_{2}}$ is orthogonal." :question/worked-solution "Since the set ${{a}_{1},{a}_{2}}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{{a}_{1}}x & =\\frac{x\\cdot {a}_{1}}{{a}_{1}\\cdot {a}_{1}}{a}_{1}=\\frac{1\\cdot 2+4\\cdot 1+3\\cdot 2}{{2}^{2}+{1}^{2}+{2}^{2}}{a}_{1}=\\frac{4}{3}[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{1\\cdot 1+4\\cdot (-4)+3\\cdot 1}{{1}^{2}+(-4)^{2}+{1}^{2}}{a}_{2}=-\\frac{2}{3}[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{4}{3}[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]-\\frac{2}{3}[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{3}(4[\\begin{aligned}2 \\\\ 1 \\\\ 2\\end{aligned}]-2[\\begin{aligned}1 \\\\ -4 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}2 \\\\ 4 \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-39992/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1cae73a3-842e-5a1a-8774-35bba342845c"] :knowledge-point/questions ["q-39992"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81591/selection/d5265175bfa835d404a63269c9d5a29facee3168c3c7ea1ad07418855b2207a4" :answer/id #uuid "6d26669b-e75c-506f-af97-69586c350a0a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 2 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81591/selection/25a5670b3166200a0b35e15d34961835faecd7c4a79cb80b7a6ceefcfca274d6" :answer/id #uuid "f0c2a2b3-b19b-50cc-a272-87100636bc44" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-3 \\\\ 2 \\\\ 3\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81591/selection/71e3a11df119f825e2c69188960e83dd2a49ff457380df13f1a1ead3d6874950" :answer/id #uuid "7d56cdac-99b0-57ba-b8bc-32cfcd3f97d4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} \\\\ \\frac{1}{2} \\\\ \\frac{1}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81591/selection/e2ede29d846a7a351c59d727724365427bc271d80e57130c91d0c243e6c9196f" :answer/id #uuid "fc3e4556-8a8b-5d84-af81-06bfa3d41891" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\frac{5}{2} \\\\ -\\frac{3}{2} \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81591/selection/00b7b3512880ffd2190b437057f7e62bf69263980a6fea56b5864e100283ec80" :answer/id #uuid "c903674e-4c5e-5eee-8c3a-985872b670f0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{1}{2} \\\\ -\\frac{1}{2} \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81591/selection" :answer-field/id #uuid "c44d0dd1-cce6-50e2-8924-dd49a012d838" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81591/selection/e2ede29d846a7a351c59d727724365427bc271d80e57130c91d0c243e6c9196f" :answer-field/choices ["q-81591/selection/d5265175bfa835d404a63269c9d5a29facee3168c3c7ea1ad07418855b2207a4" "q-81591/selection/25a5670b3166200a0b35e15d34961835faecd7c4a79cb80b7a6ceefcfca274d6" "q-81591/selection/71e3a11df119f825e2c69188960e83dd2a49ff457380df13f1a1ead3d6874950" "q-81591/selection/e2ede29d846a7a351c59d727724365427bc271d80e57130c91d0c243e6c9196f" "q-81591/selection/00b7b3512880ffd2190b437057f7e62bf69263980a6fea56b5864e100283ec80"] :db/ensure [:answer-field/validate]} {:db/id "q-81591" :question/id #uuid "4f8ae67f-2056-5306-a388-43fea1c795b2" :question/math-academy-id "q-81591" :question/problem "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}3 \\\\ 1 \\\\ -1\\end{aligned}],\\,w=[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}],\\,\\,x=[\\begin{aligned}-3 \\\\ 2 \\\\ 4\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{(-3)\\cdot 3+2\\cdot 1+4\\cdot (-1)}{{3}^{2}+{1}^{2}+(-1)^{2}}v=-1[\\begin{aligned}3 \\\\ 1 \\\\ -1\\end{aligned}]=[\\begin{aligned}-3 \\\\ -1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{(-3)\\cdot 1+2\\cdot (-1)+4\\cdot 2}{{1}^{2}+(-1)^{2}+{2}^{2}}w=\\frac{1}{2}[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =[\\begin{aligned}-3 \\\\ -1 \\\\ 1\\end{aligned}]+\\frac{1}{2}[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}] \\\\  & =\\frac{1}{2}([\\begin{aligned}-6 \\\\ -2 \\\\ 2\\end{aligned}]+[\\begin{aligned}1 \\\\ -1 \\\\ 2\\end{aligned}]) \\\\  & =[\\begin{aligned}-\\frac{5}{2} \\\\ -\\frac{3}{2} \\\\ 2\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81591/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e"] :knowledge-point/questions ["q-81591"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40192/selection/0505a32a9a8427fa65b67724caf04cd2fcb2cb193849cf78ad86fad41c485eda" :answer/id #uuid "075be246-5690-5600-83f3-b96410a0318b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ 5 \\\\ 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40192/selection/e89c399709c9b0c2ddbba61c6c4d275338a8a276c4bdb7787b9264ba32450773" :answer/id #uuid "7af44923-7c70-53fd-b44e-cff335edfcab" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 \\\\ \\frac{5}{4} \\\\ \\frac{5}{4}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40192/selection/eb2728b6e052b4fadda0520b53999875e6f91c5c87af6734cb127999c6a8e6c0" :answer/id #uuid "15ba719e-fad7-53c1-8697-1e50e2d39c06" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ \\frac{2}{5} \\\\ \\frac{2}{5}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40192/selection/ddb1cefb59967b3ec7761db77258bbf981ecc88b22de116ed90099e6b28731cc" :answer/id #uuid "c1eee616-86f4-5dd8-b88f-7e0f6ce3035b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\frac{5}{2} \\\\ 3 \\\\ \\frac{5}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40192/selection/33dca87a6ac318b49cb8d420507744d03c8ba1a8a141e61a93df1a680135687d" :answer/id #uuid "43b8d445-4681-56ba-84a7-849ee344c769" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3 \\\\ \\frac{5}{2} \\\\ \\frac{5}{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-40192/selection" :answer-field/id #uuid "6eaa3455-cc89-537e-846b-9cdaca615870" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40192/selection/33dca87a6ac318b49cb8d420507744d03c8ba1a8a141e61a93df1a680135687d" :answer-field/choices ["q-40192/selection/0505a32a9a8427fa65b67724caf04cd2fcb2cb193849cf78ad86fad41c485eda" "q-40192/selection/e89c399709c9b0c2ddbba61c6c4d275338a8a276c4bdb7787b9264ba32450773" "q-40192/selection/eb2728b6e052b4fadda0520b53999875e6f91c5c87af6734cb127999c6a8e6c0" "q-40192/selection/ddb1cefb59967b3ec7761db77258bbf981ecc88b22de116ed90099e6b28731cc" "q-40192/selection/33dca87a6ac318b49cb8d420507744d03c8ba1a8a141e61a93df1a680135687d"] :db/ensure [:answer-field/validate]} {:db/id "q-40192" :question/id #uuid "b8a18aba-5bf5-5598-9a5a-e92c825d1e00" :question/math-academy-id "q-40192" :question/problem "Consider the vector $x$ and the plane $r=sv+tw,$ where $s,t\\in R,$ and\n\n$$\nv=[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}],\\,w=[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}],\\,\\,x=[\\begin{aligned}3 \\\\ 1 \\\\ 4\\end{aligned}].\n$$\n\nFind the orthogonal projection of $x$ onto the plane given that $v⊥w.$" :question/worked-solution "Since our plane passes through the origin, it defines the subspace $S=\\text{Span}{v,w}$ in ${R}^{3}.$ \nAnd, since the set ${v,w}$ is orthogonal, the orthogonal projection of $x$ onto the subspace $S$ is given by \n\n$$\n{\\text{proj}}_{S}\\,x={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x.\n$$\n\nSo, we first find the orthogonal projections of $x$ onto $\\text{Span}{{a}_{1}}$ and $\\text{Span}{{a}_{2}}:$\n\n$$\n\\begin{aligned}{\\text{proj}}_{v}\\,x & =\\frac{x\\cdot v}{v\\cdot v}v=\\frac{3\\cdot (-1)+1\\cdot 1+4\\cdot 1}{(-1)^{2}+{1}^{2}+{1}^{2}}v=\\frac{2}{3}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{w}\\,x & =\\frac{x\\cdot w}{w\\cdot w}w=\\frac{3\\cdot 2+1\\cdot 1+4\\cdot 1}{{2}^{2}+{1}^{2}+{1}^{2}}w=\\frac{11}{6}[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{2}{3}[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]+\\frac{11}{6}[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{6}(4[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]+11[\\begin{aligned}2 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}3 \\\\ \\frac{5}{2} \\\\ \\frac{5}{2}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-40192/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e"] :knowledge-point/questions ["q-40192"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81593/selection/e63a86fce18b02cb956b86aebfeeb45b4e4479eb071ca92a51126d5c69f8fa56" :answer/id #uuid "0e5f1bca-6083-5b56-b7c2-c4fec7155deb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-13 \\\\ -14 \\\\ 15\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81593/selection/c87604353b43c54ec7798207516b558b5adc7fd27b1fd2dc77509538a8b9b6da" :answer/id #uuid "32d0f948-46b4-5cc2-aec4-c62b11ab3bd9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-12 \\\\ -11 \\\\ 10\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81593/selection/88fbc372b7b9e60bf5b233cd3111b89c01ea05440c92cddb7b45523ca7e05083" :answer/id #uuid "75c6f8ae-0cc3-5e3b-94f7-e26b3a503329" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-13 \\\\ -12 \\\\ 11\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81593/selection/49cca4a89fe0c02012b4042077a604e5437f62c3fb1503b4868503350efe2908" :answer/id #uuid "02a5c59a-7294-5e50-a808-8270f997a1dd" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-10 \\\\ -11 \\\\ 12\\end{aligned}]" :db/ensure 