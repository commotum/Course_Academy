d{aligned}]+[\\begin{aligned}8 \\\\ -4 \\\\ -8 \\\\ 4\\end{aligned}]) \\\\  & =\\frac{1}{4}[\\begin{aligned}9 \\\\ -3 \\\\ -7 \\\\ 5\\end{aligned}]=\\overset{^}{x}.\\end{aligned}\n$$\n\nFinally, the distance between $x$ and the subspace $S$ is given by\n\n$$\n\\begin{aligned}d(x,\\overset{^}{x}) & =‖x-\\overset{^}{x}‖ \\\\  & =\\sqrt{({x}_{1}-{\\overset{^}{x}}_{1})^{2}+({x}_{2}-{\\overset{^}{x}}_{2})^{2}+({x}_{3}-{\\overset{^}{x}}_{3})^{2}+({x}_{4}-{\\overset{^}{x}}_{4})^{2}} \\\\  & =\\sqrt{{(2-\\frac{9}{4})}^{2}+{(1-(-\\frac{3}{4}))}^{2}+{(-3-(-\\frac{7}{4}))}^{2}+{(1-\\frac{5}{4})}^{2}} \\\\  & =\\sqrt{\\frac{1}{16}+\\frac{49}{16}+\\frac{25}{16}+\\frac{1}{16}} \\\\  & =\\sqrt{\\frac{76}{16}} \\\\  & =\\frac{\\sqrt{19}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-82914/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8eb07a32-45bd-5975-9f61-de6294d4895d"] :knowledge-point/questions ["q-82914"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40605/selection/a1718737dbd495fb450a9cad74f457749b10e8bf5f8306a2293022758aa6513c" :answer/id #uuid "41ed7f1c-9bfd-58cd-9dcc-d1e5f2a4a9dd" :answer/type :answer.type/math :answer/value "9\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-40605/selection/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer/id #uuid "a80b0efd-b15a-52dc-93bb-c977e521ec06" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "q-40605/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "112969a0-33d8-58a1-9802-8f2b6471ac9e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-40605/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "85ca9509-047a-504b-9974-fed193ebd32d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-40605/selection/303632d9