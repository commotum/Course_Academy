/type {:db/ident :answer.type/math} :answer/value "38.29^{∘}" :db/id #edb/ref 17592186131634} {:answer/id #uuid "4185edc9-b740-5617-b2c9-553d2d4b215b" :answer/type {:db/ident :answer.type/math} :answer/value "29.38^{∘}" :db/id #edb/ref 17592186131635}] :answer-field/correct {:answer/id #uuid "9b2d3eae-bddf-5eff-8893-81f28ac8d3b8" :answer/type {:db/ident :answer.type/math} :answer/value "32.98^{∘}" :db/id #edb/ref 17592186131632} :answer-field/id #uuid "307fd06c-e4cf-5e21-8b47-682acf46ca81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131630}] :question/id #uuid "961a93f3-4659-59c1-955c-0c479788bf13" :question/math-academy-id "q-40223" :question/problem "> A scientific calculator is required to answer this question.\n\nConsider the vector $x$ and the subspace $S = Span{a_{1}, a_{2}}$ where\n$a_{1} = \\begin{bmatrix}0 \\\\ 1 \\\\ -1\\end{bmatrix}, a_{2} = \\begin{bmatrix}1 \\\\ 2 \\\\ 2\\end{bmatrix}, x = \\begin{bmatrix}1 \\\\ 1 \\\\ -1\\end{bmatrix}$.\nFind the acute angle between $x$ and the subspace $S$ given that the set ${a_{1}, a_{2}}$ is orthogonal. Round the answer to $2$ decimal places." :question/requires-calculator true}] [{:db/id #edb/ref 17592186134230 :knowledge-point/_questions [{:knowledge-point/id #uuid "acb4bd03-9b89-5775-a700-e1f3ea9fa62e" :knowledge-point/title "Finding the Orthogonal Projection of a Vector Onto a Plane"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fb0a5a2-2274-5cfb-8f2d-602cbbd79f52" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2 \\\\ 2 \\\\ 2\\end{bmatrix}" :db/id #edb/ref 17592186131823} {:answer/id #uuid "9e0a7f55-45e5-5f46-8b53-b50859450b08" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}1 \\\\ -\\frac{1}{2} \\\\ -\\frac{1}{2}\\end{bmatrix}" :db/id #edb/ref 17592186131824} {:answer/id #uuid "af8a0ed9-a5be-54da-9f9b-3bb41e112687" :answer/type {:db/ident :answer.type/math} :answer/va