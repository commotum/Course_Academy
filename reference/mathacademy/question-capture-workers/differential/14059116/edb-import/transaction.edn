5(1-{x}^{2})})\\text{d}x$  for $|x|<1.$" :question/worked-solution "The derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{artanh}⁡x)=\\frac{1}{1-{x}^{2}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({e}^{x}-\\frac{6}{\\operatorname{ln}⁡5(1-{x}^{2})})\\text{d}x & =\\int {e}^{x}\\,\\text{d}x-\\frac{6}{\\operatorname{ln}⁡5}\\int \\frac{1}{1-{x}^{2}}\\,\\text{d}x \\\\  & ={e}^{x}-\\frac{6}{\\operatorname{ln}⁡5}\\operatorname{artanh}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-95662/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "607b412e-f875-584f-87b3-627801f20b5c"] :knowledge-point/questions ["q-95662"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186167278 :question/answer-fields 17592186165217] {:db/id "q-95265/selection/ma-v1/bf58238c69aa941031ba0a2f2b7d68078041dfe6f07d71d50f6453f97a359884/b1486dbaed1c00808c2224c199bea04c681a9ef2e1447ee66ba65c0f501a49f5" :answer/id #uuid "af4b28fc-cc6c-5978-9017-64d5d3568ad7" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{3}\\operatorname{artanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-95265/selection/ma-v1/bf58238c69aa941031ba0a2f2b7d68078041dfe6f07d71d50f6453f97a359884/f860deeddc683bfabc1c85a015ca19ed3e1b88ad4ff2bd3da41921f0e5111ecc" :answer/id #uuid "5c2a4917-b95b-5007-966f-8939aa9e33cc" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{3}\\operatorname{arcosh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-95265/selection/ma-v1/bf58238c69aa941031ba0a2f2b7d68078041dfe6f07d71d50f6453f97a359884/aefd343edb8296faebad8bf14d37174273d07016e081ffb916a00ba717f3e932" :answer/id #uuid "d47e32fe-7fbd-5073-b37a-f5875bb35c3b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{3}\\operatorname{arcoth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-95265/selection/ma-v1/bf58238c69aa941031ba0a2f2b7d68078041dfe6f07d7