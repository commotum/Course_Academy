#{[{:db/id #edb/ref 17592186166528 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "f360178a-5c2b-56d5-b12d-622e1aedf6ef" :knowledge-point/title "Integrating Using Arcsinh"}] :question/id #uuid "fb41f298-ad49-5dce-819b-5ed8fab7f962" :question/math-academy-id "e-8345" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\dfrac{-3}{\\sqrt{x^2+1}}\\,\\textrm d x=$" :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe derivative of the inverse hyperbolic sine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arsinh x) = \\dfrac{1}{\\sqrt{x^2+1}}\n$$\n\nTherefore, we have\n\n$$\n∫\\frac{-3}{\\sqrt{x^{2} + 1}}dx =-3∫\\frac{1}{\\sqrt{x^{2} + 1}}dx =-3arsinh x + C\n$$"}] [{:db/id #edb/ref 17592186166529 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c03f53c6-d1e5-5c54-a43f-df2fbbfb7774" :knowledge-point/title "Integrating Using Arcosh"}] :question/id #uuid "43e9b2da-1e6d-52b5-9312-c07d2d7a682b" :question/math-academy-id "e-8346" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\dfrac{\\ln{\\pi}}{\\sqrt{x^2-1}}\\,\\textrm d x=$" :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe derivative of the inverse hyperbolic cosine function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\arcosh x) = \\dfrac{1}{\\sqrt{x^2-1}}\n$$\n\nTherefore, we have\n\n$$\n∫\\frac{\\ln π}{\\sqrt{x^{2} - 1}}dx = \\ln π∫\\frac{1}{\\sqrt{x^{2} - 1}}dx = \\ln πarcosh x + C\n$$"}] [{:db/id #edb/ref 17592186166530 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "607b412e-f875-584f-87b3-627801f20b5c" :knowledge-point/title "Integrating Using Artanh"}] :question/id #uuid "528e7b19-3de0-5c93-8b7f-82383486eafc" :question/math-academy-id "e-8347" :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $\\displaystyle \\int \\dfrac{1}{2(1-x^2)}\\,\\textrm d x$ for $\\mid x \\mid < 1$." :question/worked-solution "$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits} \\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits} \\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits} \\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits} \\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits} \\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits} \\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits} \\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits} \\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n$$\n\nThe derivative of the inverse hyperbolic tangent function is given by\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}(\\artanh x) = \\dfrac{1}{1-x^2}\n$$\n\nTherefore, we have\n\n$$\n∫(1)/(2(1 - x^{2}))dx = \\frac{1}{2}∫\\frac{1}{1 - x^{2}}dx = \\frac{1}{2}artanh x + C\n$$"}] [{:db/id #edb/ref 17592186167276 :knowledge-point/_questions [{:knowledge-point/id #uuid "f360178a-5c2b-56d5-b12d-622e1aedf6ef" :knowledge-point/title "Integrating Using Arcsinh"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2dceb85a-495b-5d41-bafe-8ec60f19fd20" :answer/type {:db/ident :answer.type/math} :answer/value "-9arsinh x + C" :db/id #edb/ref 17592186165206} {:answer/id #uuid "53749856-37bb-59b4-9ecc-0b8995cccd45" :answer/type {:db/ident :answer.type/math} :answer/value "9arcosh x + C" :db/id #edb/ref 17592186165207} {:answer/id #uuid "559296b4-ea2b-5167-843f-c95dc92bf932" :answer/type {:db/ident :answer.type/math} :answer/value "9\\arcsin x + C" :db/id #edb/ref 17592186165208} {:answer/id #uuid "66a29375-f4d5-507e-a341-489f89b77b63" :answer/type {:db/ident :answer.type/math} :answer/value "9arsinh x + C" :db/id #edb/ref 17592186165209} {:answer/id #uuid "6ddefe72-e88b-5428-ba8c-eaa2979df447" :answer/