-workers/differential/14059116/state.json" "file_sha256" "173c65ee1544e8465459a6ad0c96c47d0481f2dafc64cc35a88c6c1fa1297b3a"} {"question" "q-95639" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059116/activity-metadata.json" "file_sha256" "b14af541fb82842c08862ddd45d86e0fad3bb4e03f920f993917723662ded291"} {"question" "q-95639" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059116/state.json" "file_sha256" "173c65ee1544e8465459a6ad0c96c47d0481f2dafc64cc35a88c6c1fa1297b3a"} {"question" "q-95639" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(1-\\sqrt{2})\\operatorname{arcosh}⁡x+C"] ["math" "(\\sqrt{2}+1)\\operatorname{arcosh}⁡x+C"] ["math" "(\\sqrt{2}+1)\\operatorname{arsinh}⁡x+C"] ["math" "\\sqrt{2}+\\operatorname{arsinh}⁡x+C"] ["math" "\\sqrt{2}\\operatorname{arsinh}⁡x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059116/state.json" "file_sha256" "173c65ee1544e8465459a6ad0c96c47d0481f2dafc64cc35a88c6c1fa1297b3a"} {"question" "q-95639" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\sqrt{2}+1)\\operatorname{arsinh}⁡x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059116/state.json" "file_sha256" "173c65ee1544e8465459a6ad0c96c47d0481f2dafc64cc35a88c6c1fa1297b3a"} {"question" "q-95645" "field" nil "attribute" "question/problem" "value" "$$\n\n$\\int (\\frac{4}{\\sqrt{{x}^{2}-1}}+\\operatorname{sinh}⁡x)\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference