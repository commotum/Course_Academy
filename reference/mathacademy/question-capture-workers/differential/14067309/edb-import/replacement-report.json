      "source": [
        {
          "question": "e-21799",
          "field": null,
          "attribute": "question/problem",
          "value": "Consider the following boundary value problem.\n\n$$\ny'' = 0, \\qquad y(4) = 0, \\quad y(3) + y'(3) = 0,\\quad 3\\leq x \\leq 4\n$$\n\nFind the solution to this boundary value problem in terms of an arbitrary constant $A.$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067309/example-21799.json",
          "file_sha256": "47960b1ecbe0c9074d8f6bcbb7de669434ccc5da82221a89219dc20982ff708a"
        }
      ],
      "basis": 2584,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067309/edb-import/commit.edn",
      "basis_after": 2585
