5394-bcbb-fbfb7a5b6c7b" :knowledge-point/title "Constructing a Logistic Growth Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8bd86e4-3bb4-572a-b3c1-e11a9f1a4ae6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=-0.25P(10\\,000-P)" :db/id #edb/ref 17592186319788} {:answer/id #uuid "20501cc3-5b04-5b55-b590-aa8982405194" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=10\\,000P(0.25-P)" :db/id #edb/ref 17592186319789} {:answer/id #uuid "8772fd04-20c4-5824-bad7-3daa709f8bda" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.25P(10\\,000+P)" :db/id #edb/ref 17592186319790} {:answer/id #uuid "8fa3ee2c-6813-51b4-81e7-f83ea7cc6aee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=10\\,000P(0.25+P)" :db/id #edb/ref 17592186319791} {:answer/id #uuid "aeed1748-1e49-568d-91c5-4c1909be7cc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.25P(10\\,000-P)" :db/id #edb/ref 17592186319792}] :answer-field/correct {:answer/id #uuid "aeed1748-1e49-568d-91c5-4c1909be7cc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.25P(10\\,000-P)" :db/id #edb/ref 17592186319792} :answer-field/id #uuid "b642474b-5adc-504b-8833-166d38ffef28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319787}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "dc359308-3103-59f4-9a99-1fa80e3c85f2" :question/math-academy-id "q-83856" :question/problem "A viral disease starts spreading through a community of $10\\,000$ people. The rate of growth in the number of people $P(t)$ infected with the virus is jointly proportional to the number of people $P(t)$ who have been infected at time $t,$ measured in days,  and the number who have not been infected. If the constant of proportionality is $0.25,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the growth rate of infected people is *jointly* proportional to the number of people who have been infected people at time $t,$ and the number who have not, the number of infected people follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.25,$ and the carrying capacity is $a=10\\,000.$ Therefore,  the number of infected people is given by the equation\n\n$$\n\\frac{dP}{dt}=0.25P(10\\,000-P).\n$$"}] [{:db/id #edb/ref 17592186319793 :knowledge-point/_questions [{:knowledge-point/id #uuid "a46e688b-117f-5394-bcbb-fbfb7a5b6c7b" :knowledge-point/title "Constructing a Logistic Growth Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b6b595e0-3ce7-5cbb-bb5d-301f68a3e3cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.000\\,002P(50\\,000-P)" :db/id #edb/ref 17592186319795} {:answer/id #uuid "23c08294-74e9-5011-9fae-737310e29406" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=50\\,000P(0.000\\,002-P)" :db/id #edb/ref 17592186319796} {:answer/id #uuid "181a4f49-5ed3-5b96-b578-91454a3963fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.000\\,002P(50\\,000+P)" :db/id #edb/ref 17592186319797} {:answer/id #uuid "12313b7d-472f-51cd-94d0-ddfe98b61b63" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=-0.000\\,002P(50\\,000+P)" :db/id #edb/ref 17592186319798} {:answer/id #uuid "2c4512ff-9d05-58aa-abef-50205f5e01dd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=50\\,000P(0.000\\,002+P)" :db/id #edb/ref 17592186319799}] :answer-field/correct {:answer/id #uuid "b6b595e0-3ce7-5cbb-bb5d-301f68a3e3cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dP}{dt}=0.000\\,002P(50\\,000-P)" :db/id #edb/ref 17592186319795} :answer-field/id #uuid "9f988fba-2bbb-58a2-8269-05c4ec5c1d33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186319794}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ae33e0d1-653d-5d0e-b8da-6b9dd53943e5" :question/math-academy-id "q-83857" :question/problem "The growth rate of the seal population $P(t)$ on a certain South African island is jointly proportional to the seal population at time $t,$ measured in years, and the difference between the island's carrying capacity and the seal population. If the constant of proportionality is $0.000\\,002$ and the maximum possible seal population is $50\\,000,$ which differential equation could be used to model $P(t)?$" :question/worked-solution "Since the seal population's growth rate is *jointly* proportional to the seal population at time $t$ and the difference between the carrying capacity and the seal population, the seal population follows a logistic growth model.\n\nA logistic growth equation has the form\n\n$$\n\\frac{dP}{dt}=kP(a-P),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $a>P$ is the carrying capacity.\n\nIn this case, the constant of proportionality is $k=0.000\\,002,$ and the carrying capacity is $a=50\\,000.$ Therefore, the seal population is given by the equation\n\n$$\n\\frac{dP}{dt}=0.000\\,002P(50\\,000-P).\n$$"}]}
