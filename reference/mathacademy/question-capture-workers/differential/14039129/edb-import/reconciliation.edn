x)\\,\\text{d}x"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/state.json" "file_sha256" "b5ffccc056d43c528012bcb9c43d0684d0799657c1a2679280b6a6fed57beb94" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "q-50222" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}+\\frac{1}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/state.json" "file_sha256" "b5ffccc056d43c528012bcb9c43d0684d0799657c1a2679280b6a6fed57beb94" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "q-50222" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}-\\frac{2}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/state.json" "file_sha256" "b5ffccc056d43c528012bcb9c43d0684d0799657c1a2679280b6a6fed57beb94" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "q-352049" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/3}^{e/3}243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/state.json" "file_sha256" "b5ffccc056d43c528012bcb9c43d0684d0799657c1a2679280b6a6fed57beb94" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "q-352049" "field" nil "attribute" "question/worked-solution" "value" "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡(3x))^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(3x)}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=243{x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 243{x}^{2}\\,\\text{d}x=81{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡(3x))}^{2}(81{x}^{3})-\\int (81{x}^{3})(\\frac{2\\operatorname{ln}⁡(3x)}{x})\\,\\text{d}x \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{1}{3}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{{x}^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162(\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{{x}^{3}}{9}+D) \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-54{x}^{3}\\operatorname{ln}⁡(3x)+18{x}^{3}-162D \\\\  & ={x}^{3}(81{(\\operatorname{ln}⁡(3x))}^{2}-54\\operatorname{ln}⁡(3x)+18)+C,\\end{aligned}\n$$\n\nwhere $C=-162D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e/3}243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\text{d}x & ={[{x}^{3}(81{(\\operatorname{ln}⁡(3x))}^{2}-54\\operatorname{ln}⁡(3x)+18)]}_{1/3}^{e/3} \\\\  & =[{(\\frac{e}{3})}^{3}(81{(\\operatorname{ln}⁡(3\\cdot \\frac{e}{3}))}^{2}-54\\operatorname{ln}⁡(3\\cdot \\frac{e}{3})+18)] \\\\  & \\,-[{(\\frac{1}{3})}^{3}(81{(\\operatorname{ln}⁡(3\\cdot \\frac{1}{3}))}^{2}-54\\operatorname{ln}⁡(3\\cdot \\frac{1}{3})+18)] \\\\  & =[\\frac{{e}^{3}}{27}(81{(\\operatorname{ln}⁡e)}^{2}-54\\operatorname{ln}⁡e+18)]-[\\frac{1}{27}(81{(\\operatorname{ln}⁡1)}^{2}-54\\operatorname{ln}⁡1+18)] \\\\  & =[\\frac{{e}^{3}}{27}(81-54+18)]-\\frac{1}{27}\\cdot 18 \\\\  & =\\frac{5{e}^{3}-2}{3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/state.json" "file_sha256" "b5ffccc056d43c528012bcb9c43d0684d0799657c1a2679280b6a6fed57beb94" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "q-352049" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/activity-metadata.json" "file_sha256" "73e2e5d6ad4967d7751ef0e1dbef63ab5f4bc0743b1a19fe41d4aaf281d1bc56" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "q-352049" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/state.json" "file_sha256" "b5ffccc056d43c528012bcb9c43d0684d0799657c1a2679280b6a6fed57beb94" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "q-352049" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5e^3-2}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/state.json" "file_sha256" "b5ffccc056d43c528012bcb9c43d0684d0799657c1a2679280b6a6fed57beb94" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "e-7053" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle \\int_0^1 (t^2+1)e^{2t+1} \\, \\textrm{d} t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/example-7053.json" "file_sha256" "fe38e0123e0de33f6eb8e4b1b99e4f444e4212906e0b71f21ee73167a8c9a9c8" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "e-7053" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+1}\\,\\text{d}t=\\frac{{e}^{2t+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2}+1)(\\frac{{e}^{2t+1}}{2})-\\int (\\frac{{e}^{2t+1}}{2})(2t)\\,\\text{d}t \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\int t\\,{e}^{2t+1}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int t\\,e^{2t+1}\\,\\textrm{d}t.$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1 \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+1}\\,\\text{d}t=\\frac{{e}^{2t+1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t\\,{e}^{2t+1}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{{e}^{2t+1}}{2})-\\int (\\frac{{e}^{2t+1}}{2})(1)\\,\\text{d}t \\\\  & =\\frac{t\\,{e}^{2t+1}}{2}-\\frac{1}{2}\\int {e}^{2t+1}\\,\\text{d}t \\\\  & =\\frac{t\\,{e}^{2t+1}}{2}-\\frac{{e}^{2t+1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\int t\\,{e}^{2t+1}\\,\\text{d}t \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-(\\frac{t\\,{e}^{2t+1}}{2}-\\frac{{e}^{2t+1}}{4}+D) \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\frac{t\\,{e}^{2t+1}}{2}+\\frac{{e}^{2t+1}}{4}-D \\\\  & =\\frac{{e}^{2t+1}}{4}(2{t}^{2}-2t+3)+C,\\end{aligned}\n$$\n\nwhere $C = -{D}.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & ={[\\frac{{e}^{2t+1}}{4}(2{t}^{2}-2t+3)]}_{0}^{1} \\\\  & =(\\frac{{e}^{2(1)+1}}{4}(2(1)^{2}-2(1)+3))-(\\frac{{e}^{2(0)+1}}{4}(2(0)^{2}-2(0)+3)) \\\\  & =\\frac{{e}^{3}}{4}(2-2+3)-\\frac{e}{4}(0-0+3) \\\\  & =\\frac{3{e}^{3}}{4}-\\frac{3e}{4} \\\\  & =\\frac{3{e}^{3}-3e}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/example-7053.json" "file_sha256" "fe38e0123e0de33f6eb8e4b1b99e4f444e4212906e0b71f21ee73167a8c9a9c8" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "e-495" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle \\int x^2\\cos(3x) \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/example-495.json" "file_sha256" "c2560714d737412ad6c32ca7148380ba79fd8de1a0a5d6db76e4616f4f726585" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "e-495" "field" nil "attribute" "question/worked-solution" "value" "In this case, we define\n\n$$\n\\begin{aligned}u={x}^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{cos}⁡(3x)\\text{d}x=\\frac{1}{3}\\,\\operatorname{sin}⁡(3x)\\,.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(3x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =({x}^{2})(\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))-\\int (\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))2x\\,\\text{d}x \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\displaystyle \\int x\\sin(3x) \\textrm{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(3x)\\text{d}x=-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x)\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(3x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =x(-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x))-\\int (-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x))\\cdot 1\\,\\text{d}x \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{3}\\int \\operatorname{cos}⁡(3x)\\text{d}x \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{3}(\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))+{C}_{1} \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}\\,\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(3x)\\text{d}x & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\text{d}x \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}(-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}) \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2}{9}x\\operatorname{cos}⁡(3x)-\\frac{2}{27}\\operatorname{sin}⁡(3x)-\\frac{2{C}_{1}}{3} \\\\  & =\\frac{1}{27}((9{x}^{2}-2)\\operatorname{sin}⁡(3x)+6x\\operatorname{cos}⁡(3x))+C,\\end{aligned}\n$$\n\nwhere $C = -\\dfrac{2C_1}{3}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/example-495.json" "file_sha256" "c2560714d737412ad6c32ca7148380ba79fd8de1a0a5d6db76e4616f4f726585" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "e-496" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle \\int_1^e 32x^3(\\ln x)^2 \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/example-496.json" "file_sha256" "9e543c7bb30ddfd20cf829e256641be203761b075cd6ed45507374baebd7ae55" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"} {"question" "e-496" "field" nil "attribute" "question/worked-solution" "value" "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡x)^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=32{x}^{3} & \\,⟹\\,v=\\int 32{x}^{3}\\text{d}x=8{x}^{4}\\,.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & ={(\\operatorname{ln}⁡x)}^{2}(8{x}^{4})-\\int (8{x}^{4})(\\frac{2\\operatorname{ln}⁡x}{x})\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int {x^3\\ln(x)} \\textrm{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{3} & \\,⟹\\,v=\\int {x}^{3}\\text{d}x=\\frac{{x}^{4}}{4}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =\\operatorname{ln}⁡(x)(\\frac{{x}^{4}}{4})-\\int (\\frac{{x}^{4}}{4})(\\frac{1}{x})\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{1}{4}\\int {x}^{3}\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}\\end{aligned}\n$$\n\nwhere $C_1$ is an integral constant. So, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16(\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}) \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-4{x}^{4}\\operatorname{ln}⁡(x)+{x}^{4}-16{C}_{1} \\\\  & ={x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)+C\\,\\end{aligned}\n$$\n\nwhere $C = -4C_1.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}32{x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & ={{x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)|}_{1}^{e} \\\\  & =[(e)^{4}(8{(\\operatorname{ln}⁡(e))}^{2}-4\\operatorname{ln}⁡(e)+1)]-[(1)^{4}(8{(\\operatorname{ln}⁡(1))}^{2}-4\\operatorname{ln}⁡(1)+1)] \\\\  & =[{e}^{4}(8-4+1)]-1 \\\\  & =5{e}^{4}-1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/example-496.json" "file_sha256" "9e543c7bb30ddfd20cf829e256641be203761b075cd6ed45507374baebd7ae55" "basis" 1160 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012723/edb-import/verification.json"}] "sources" [{"question" "q-351994" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351994" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+4\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+4)(\\frac{{e}^{2y+1}}{2})-\\int (\\frac{{e}^{2y+1}}{2})(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int y\\,{e}^{2y+1}\\,\\text{d}y.$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y+1}\\,\\text{d}y=\\frac{{e}^{2y+1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y+1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)(\\frac{{e}^{2y+1}}{2})-\\int (\\frac{{e}^{2y+1}}{2})(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{1}{2}\\int {e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\int y\\,{e}^{2y+1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-(\\frac{y\\,{e}^{2y+1}}{2}-\\frac{{e}^{2y+1}}{4}+D) \\\\  & =\\frac{({y}^{2}+4){e}^{2y+1}}{2}-\\frac{y\\,{e}^{2y+1}}{2}+\\frac{{e}^{2y+1}}{4}-D \\\\  & =\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}({y}^{2}+4){e}^{2y+1}\\,\\text{d}y & ={[\\frac{{e}^{2y+1}}{4}(2{y}^{2}-2y+9)]}_{0}^{2} \\\\  & =(\\frac{{e}^{2(2)+1}}{4}(2(2)^{2}-2(2)+9))-(\\frac{{e}^{2(0)+1}}{4}(2(0)^{2}-2(0)+9)) \\\\  & =\\frac{{e}^{5}}{4}(8-4+9)-\\frac{e}{4}(0-0+9) \\\\  & =\\frac{13{e}^{5}}{4}-\\frac{9e}{4} \\\\  & =\\frac{13{e}^{5}-9e}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351994" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-351994" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351994" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{13e^5-9e}{4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351991" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351991" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={y}^{2}+3\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=2y, \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =({y}^{2}+3)(\\frac{{e}^{2y-1}}{2})-\\int (\\frac{{e}^{2y-1}}{2})(2y)\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int y\\,{e}^{2y-1}\\,\\text{d}y.$ We take\n\n$$\n\\begin{aligned}u=y\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}y}=1 \\\\ \\frac{\\text{d}v}{\\text{d}y}={e}^{2y-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y=\\int {e}^{2y-1}\\,\\text{d}y=\\frac{{e}^{2y-1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int y\\,{e}^{2y-1}\\,\\text{d}y & =\\int u\\frac{\\text{d}v}{\\text{d}y}\\,\\text{d}y \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}y}\\,\\text{d}y \\\\  & =(y)(\\frac{{e}^{2y-1}}{2})-\\int (\\frac{{e}^{2y-1}}{2})(1)\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{1}{2}\\int {e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\int y\\,{e}^{2y-1}\\,\\text{d}y \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-(\\frac{y\\,{e}^{2y-1}}{2}-\\frac{{e}^{2y-1}}{4}+D) \\\\  & =\\frac{({y}^{2}+3){e}^{2y-1}}{2}-\\frac{y\\,{e}^{2y-1}}{2}+\\frac{{e}^{2y-1}}{4}-D \\\\  & =\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}({y}^{2}+3){e}^{2y-1}\\,\\text{d}y & ={[\\frac{{e}^{2y-1}}{4}(2{y}^{2}-2y+7)]}_{1}^{2} \\\\  & =(\\frac{{e}^{2(2)-1}}{4}(2(2)^{2}-2(2)+7))-(\\frac{{e}^{2(1)-1}}{4}(2(1)^{2}-2(1)+7)) \\\\  & =\\frac{{e}^{3}}{4}(8-4+7)-\\frac{e}{4}(2-2+7) \\\\  & =\\frac{11{e}^{3}}{4}-\\frac{7e}{4} \\\\  & =\\frac{11{e}^{3}-7e}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351991" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-351991" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351991" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{11e^3-7e}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352111" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}({x}^{2}+6){e}^{2x-1}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352111" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={x}^{2}+6\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x, \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{2x-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{2x-1}\\,\\text{d}x=\\frac{{e}^{2x-1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({x}^{2}+6){e}^{2x-1}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2}+6)(\\frac{{e}^{2x-1}}{2})-\\int (\\frac{{e}^{2x-1}}{2})(2x)\\,\\text{d}x \\\\  & =\\frac{({x}^{2}+6){e}^{2x-1}}{2}-\\int x\\,{e}^{2x-1}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x\\,{e}^{2x-1}\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{2x-1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{2x-1}\\,\\text{d}x=\\frac{{e}^{2x-1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\,{e}^{2x-1}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(x)(\\frac{{e}^{2x-1}}{2})-\\int (\\frac{{e}^{2x-1}}{2})(1)\\,\\text{d}x \\\\  & =\\frac{x\\,{e}^{2x-1}}{2}-\\frac{1}{2}\\int {e}^{2x-1}\\,\\text{d}x \\\\  & =\\frac{x\\,{e}^{2x-1}}{2}-\\frac{{e}^{2x-1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({x}^{2}+6){e}^{2x-1}\\,\\text{d}x & =\\frac{({x}^{2}+6){e}^{2x-1}}{2}-\\int x\\,{e}^{2x-1}\\,\\text{d}x \\\\  & =\\frac{({x}^{2}+6){e}^{2x-1}}{2}-(\\frac{x\\,{e}^{2x-1}}{2}-\\frac{{e}^{2x-1}}{4}+D) \\\\  & =\\frac{({x}^{2}+6){e}^{2x-1}}{2}-\\frac{x\\,{e}^{2x-1}}{2}+\\frac{{e}^{2x-1}}{4}-D \\\\  & =\\frac{{e}^{2x-1}}{4}(2{x}^{2}-2x+13)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({x}^{2}+6){e}^{2x-1}\\,\\text{d}x & ={[\\frac{{e}^{2x-1}}{4}(2{x}^{2}-2x+13)]}_{0}^{1} \\\\  & =(\\frac{{e}^{2(1)-1}}{4}(2(1)^{2}-2(1)+13))-(\\frac{{e}^{2(0)-1}}{4}(2(0)^{2}-2(0)+13)) \\\\  & =\\frac{e}{4}(2-2+13)-\\frac{1}{4e}(0-0+13) \\\\  & =\\frac{13e}{4}-\\frac{13}{4e} \\\\  & =\\frac{13{e}^{2}-13}{4e}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352111" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-352111" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352111" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{13e^2-13}{4e}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351983" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}3{t}^{2}{e}^{2t+2}\\,\\text{d}t=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351983" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}=3{e}^{2t+2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int 3{e}^{2t+2}\\,\\text{d}t=\\frac{3}{2}{e}^{2t+2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2})(\\frac{3}{2}{e}^{2t+2})-\\int (\\frac{3}{2}{e}^{2t+2})(2t)\\,\\text{d}t \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3\\int t{e}^{2t+2}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int t{e}^{2t+2}\\,\\text{d}t.$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+2}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+2}\\,\\text{d}t=\\frac{1}{2}{e}^{2t+2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t{e}^{2t+2}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{1}{2}{e}^{2t+2})-\\int (\\frac{1}{2}{e}^{2t+2})(1)\\,\\text{d}t \\\\  & =\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{2}\\int {e}^{2t+2}\\,\\text{d}t \\\\  & =\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{4}{e}^{2t+2}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3\\int t{e}^{2t+2}\\,\\text{d}t \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-3(\\frac{1}{2}t{e}^{2t+2}-\\frac{1}{4}{e}^{2t+2}+D) \\\\  & =\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2}+C,\\end{aligned}\n$$\n\nwhere $C=-3D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}3{t}^{2}{e}^{2t+2}\\,\\text{d}t & =(\\frac{3}{2}{t}^{2}{e}^{2t+2}-\\frac{3}{2}t{e}^{2t+2}+\\frac{3}{4}{e}^{2t+2})\\,{|}_{0}^{1} \\\\  & =(\\frac{3}{2}({1}^{2}){e}^{2(1)+2}-\\frac{3}{2}(1){e}^{2(1)+2}+\\frac{3}{4}{e}^{2(1)+2})-(\\frac{3}{2}({0}^{2}){e}^{2(0)+2}-\\frac{3}{2}(0){e}^{2(0)+2}+\\frac{3}{4}{e}^{2(0)+2}) \\\\  & =\\frac{3}{4}{e}^{4}-\\frac{3}{4}{e}^{2} \\\\  & =\\frac{3{e}^{4}-3{e}^{2}}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351983" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-351983" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-351983" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3e^4-3e^2}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114693" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int (4{x}^{2}+1){e}^{2x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114693" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=4{x}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=8x \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{2x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{2x}\\,\\text{d}x=\\frac{{e}^{2x}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int (4{x}^{2}+1){e}^{2x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(4{x}^{2}+1)(\\frac{{e}^{2x}}{2})-\\int (\\frac{{e}^{2x}}{2})(8x)\\,\\text{d}x \\\\  & =\\frac{(4{x}^{2}+1){e}^{2x}}{2}-4\\int x{e}^{2x}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x{e}^{2x}\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{2x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{2x}\\,\\text{d}x=\\frac{{e}^{2x}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{e}^{2x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(\\frac{{e}^{2x}}{2})-\\int (\\frac{{e}^{2x}}{2})(1)\\,\\text{d}x \\\\  & =\\frac{x{e}^{2x}}{2}-\\frac{1}{2}\\int {e}^{2x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{2x}}{2}-\\frac{{e}^{2x}}{4}+D \\\\  & =\\frac{{e}^{2x}}{4}(2x-1)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int (4{x}^{2}+1){e}^{2x}\\,\\text{d}x & =\\frac{(4{x}^{2}+1){e}^{2x}}{2}-4(\\frac{{e}^{2x}}{4}(2x-1)+D) \\\\  & =\\frac{(4{x}^{2}+1){e}^{2x}}{2}-{e}^{2x}(2x-1)-4D \\\\  & =\\frac{{e}^{2x}}{2}(4{x}^{2}-4x+3)+C,\\end{aligned}\n$$\n\nwhere $C=-4D.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114693" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-114693" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114693" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{{e}^{2x}}{2}(2{x}^{2}+4x+1)+C"] ["math" "\\frac{{e}^{2x}}{2}(2{x}^{2}-2x+1)+C"] ["math" "\\frac{{e}^{2x}}{2}(4{x}^{2}-2x-3)+C"] ["math" "\\frac{{e}^{2x}}{2}(4{x}^{2}-4x+3)+C"] ["math" "\\frac{{e}^{2x}}{2}({x}^{2}-2x+3)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114693" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{{e}^{2x}}{2}(4{x}^{2}-4x+3)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352117" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}4{t}^{2}\\operatorname{sin}⁡t\\,\\text{d}t=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352117" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=4{t}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=8t \\\\ \\frac{\\text{d}v}{\\text{d}t}=\\operatorname{sin}⁡t\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int \\operatorname{sin}⁡t\\,\\text{d}t=-\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 4{t}^{2}\\operatorname{sin}⁡t\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(4{t}^{2})(-\\operatorname{cos}⁡t)-\\int (-\\operatorname{cos}⁡t)(8t)\\,\\text{d}t \\\\  & =-4{t}^{2}\\operatorname{cos}⁡t+8\\int t\\operatorname{cos}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int t\\operatorname{cos}⁡t\\,\\text{d}t.$ We take\n\n$$\n\\begin{aligned}u=t & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}t}=\\operatorname{cos}⁡t & \\,⟹\\,v=\\int \\operatorname{cos}⁡t\\text{d}t=\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t\\operatorname{cos}⁡t\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =t\\operatorname{sin}⁡t-\\int \\operatorname{sin}⁡t\\,dt \\\\  & =t\\operatorname{sin}⁡t+\\operatorname{cos}⁡t+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 4{t}^{2}\\operatorname{sin}⁡t\\,\\text{d}t & =-4{t}^{2}\\operatorname{cos}⁡t+8\\int t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =-4{t}^{2}\\operatorname{cos}⁡t+8(t\\operatorname{sin}⁡t+\\operatorname{cos}⁡t+D) \\\\  & =-4{t}^{2}\\operatorname{cos}⁡t+8t\\operatorname{sin}⁡t+8\\operatorname{cos}⁡t+C,\\end{aligned}\n$$\n\nwhere $C=8D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}4{t}^{2}\\operatorname{sin}⁡t\\,\\text{d}t & ={[-4{t}^{2}\\operatorname{cos}⁡t+8t\\operatorname{sin}⁡t+8\\operatorname{cos}⁡t]}_{0}^{\\pi /2} \\\\  & =(0+8(\\frac{\\pi }{2})(1)+0)-(0+0+8) \\\\  & =4\\pi -8 \\\\  & =4\\pi -8\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352117" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-352117" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352117" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "4\\pi-8"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352026" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352026" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=3{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=6x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(3x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(3{x}^{2})(\\frac{\\operatorname{sin}⁡(3x)}{3})-\\int (\\frac{\\operatorname{sin}⁡(3x)}{3})(6x)\\,\\text{d}x \\\\  & ={x}^{2}\\operatorname{sin}⁡(3x)-2\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(3x)\\text{d}x=-\\frac{\\operatorname{cos}⁡(3x)}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\frac{\\operatorname{cos}⁡(3x)}{3})-\\int (-\\frac{\\operatorname{cos}⁡(3x)}{3})\\cdot 1\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(3x)}{3}+\\frac{1}{3}\\int \\operatorname{cos}⁡(3x)\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(3x)}{3}+\\frac{\\operatorname{sin}⁡(3x)}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={x}^{2}\\operatorname{sin}⁡(3x)-2\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={x}^{2}\\operatorname{sin}⁡(3x)-2(-\\frac{x\\operatorname{cos}⁡(3x)}{3}+\\frac{\\operatorname{sin}⁡(3x)}{9}+D) \\\\  & ={x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2x\\operatorname{cos}⁡(3x)}{3}-\\frac{2\\operatorname{sin}⁡(3x)}{9}+C,\\end{aligned}\n$$\n\nwhere $C=-2D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={[{x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2x\\operatorname{cos}⁡(3x)}{3}-\\frac{2\\operatorname{sin}⁡(3x)}{9}]}_{0}^{\\pi /2} \\\\  & ={(\\frac{\\pi }{2})}^{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2})+\\frac{2(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{3\\pi }{2})}{3}-\\frac{2\\operatorname{sin}⁡(\\frac{3\\pi }{2})}{9} \\\\  & \\,-((0)^{2}\\operatorname{sin}⁡(0)+\\frac{2(0)\\operatorname{cos}⁡(0)}{3}-\\frac{2\\operatorname{sin}⁡(0)}{9}) \\\\  & =-\\frac{{\\pi }^{2}}{4}+0+\\frac{2}{9}-0 \\\\  & =\\frac{8-9{\\pi }^{2}}{36} \\\\  & =\\frac{8-9{\\pi }^{2}}{36}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352026" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-352026" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352026" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{9}-\\frac{\\pi^2}{4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352011" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}(4{x}^{2}+2)\\operatorname{cos}⁡x\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352011" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=4{x}^{2}+2\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=8x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int (4{x}^{2}+2)\\operatorname{cos}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(4{x}^{2}+2)(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(8x)\\,\\text{d}x \\\\  & =(4{x}^{2}+2)\\operatorname{sin}⁡x-8\\int x\\operatorname{sin}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x & \\,⟹\\,v=\\int \\operatorname{sin}⁡x\\,\\text{d}x=-\\operatorname{cos}⁡x\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =-x\\operatorname{cos}⁡x-\\int (-\\operatorname{cos}⁡x)\\,dx \\\\  & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int (4{x}^{2}+2)\\operatorname{cos}⁡x\\,\\text{d}x & =(4{x}^{2}+2)\\operatorname{sin}⁡x-8\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =(4{x}^{2}+2)\\operatorname{sin}⁡x-8(-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D) \\\\  & =(4{x}^{2}+2)\\operatorname{sin}⁡x+8x\\operatorname{cos}⁡x-8\\operatorname{sin}⁡x+C,\\end{aligned}\n$$\n\nwhere $C=-8D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}(4{x}^{2}+2)\\operatorname{cos}⁡x\\,\\text{d}x & ={[(4{x}^{2}+2)\\operatorname{sin}⁡x+8x\\operatorname{cos}⁡x-8\\operatorname{sin}⁡x]}_{0}^{\\pi /2} \\\\  & =((4{(\\frac{\\pi }{2})}^{2}+2)\\operatorname{sin}⁡\\frac{\\pi }{2}+8(\\frac{\\pi }{2})\\operatorname{cos}⁡\\frac{\\pi }{2}-8\\operatorname{sin}⁡\\frac{\\pi }{2})-(2\\operatorname{sin}⁡0+8(0)\\operatorname{cos}⁡0-8\\operatorname{sin}⁡0) \\\\  & =({\\pi }^{2}+2+0-8)-0 \\\\  & ={\\pi }^{2}-6 \\\\  & ={\\pi }^{2}-6\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352011" "field" nil "attribute" "questi