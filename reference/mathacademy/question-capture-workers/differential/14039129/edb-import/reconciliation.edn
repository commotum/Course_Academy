t{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({x}^{2})(-\\frac{\\operatorname{cos}⁡(3x)}{3})-\\int (-\\frac{\\operatorname{cos}⁡(3x)}{3})(2x)\\,\\text{d}x \\\\  & =-\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}+\\frac{2}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50222" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-50222" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50222" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}+\\frac{2}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] ["math" "-\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}+\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x"] ["math" "-\\frac{{x}^{2}\\operatorname{sin}⁡(3x)}{2}+\\frac{3}{2}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] ["math" "\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}+\\frac{1}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] ["math" "\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}-\\frac{2}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50222" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{{x}^{2}\\operatorname{cos}⁡(3x)}{3}+\\frac{2}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50226" "field" nil "attribute" "question/problem" "value" "$\\int (4{x}^{2}+1)\\operatorname{sin}⁡(3x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50226" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. \n\nIn this case, we define\n\n$$\n\\begin{aligned}u=4{x}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=8x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{sin}⁡(3x)\\,\\text{d}x=-\\frac{\\operatorname{cos}⁡(3x)}{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int (4{x}^{2}+1)\\operatorname{sin}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(4{x}^{2}+1)(-\\frac{\\operatorname{cos}⁡(3x)}{3})-\\int (-\\frac{\\operatorname{cos}⁡(3x)}{3})(8x)\\,\\text{d}x \\\\  & =-\\frac{(4{x}^{2}+1)\\operatorname{cos}⁡(3x)}{3}+\\frac{8}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50226" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-50226" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50226" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{(4{x}^{2}+1)\\operatorname{cos}⁡(3x)}{3}+\\frac{3}{8}\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x"] ["math" "-\\frac{(4{x}^{2}+1)\\operatorname{cos}⁡(3x)}{3}+\\frac{8}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] ["math" "-\\frac{(4{x}^{2}+1)}{3}+\\frac{8}{3}\\int x\\operatorname{cos}⁡(2x)\\,\\text{d}x"] ["math" "\\frac{(4{x}^{2}+1)\\operatorname{cos}⁡(3x)}{3}-\\frac{1}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] ["math" "\\frac{\\operatorname{cos}⁡(4x)}{3}+\\frac{5}{3}\\int x\\operatorname{cos}⁡(5x)\\,\\text{d}x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-50226" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{(4{x}^{2}+1)\\operatorname{cos}⁡(3x)}{3}+\\frac{8}{3}\\int x\\operatorname{cos}⁡(3x)\\,\\text{d}x"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114900" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{1}^{e}4x({log}_{3}⁡x)^{2}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114900" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{3}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=4x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 4x\\,\\text{d}x=2{x}^{2}.\\end{aligned}\n$$\n\nThis gives\n\n$$\n\\begin{aligned}\\int 4x({log}_{3}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{3}⁡x)}^{2}(2{x}^{2})-\\int (2{x}^{2})(\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{4}{\\operatorname{ln}⁡3}\\int x{log}_{3}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x{log}_{3}⁡(x)\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int x\\,\\text{d}x=\\frac{{x}^{2}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{log}_{3}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{3}⁡x)(\\frac{{x}^{2}}{2})-\\int (\\frac{{x}^{2}}{2})(\\frac{1}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{1}{2\\operatorname{ln}⁡3}\\int x\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡3}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int 4x({log}_{3}⁡x)^{2}\\,\\text{d}x & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{4}{\\operatorname{ln}⁡3}(\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡3}+D) \\\\  & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{2{x}^{2}{log}_{3}⁡x}{\\operatorname{ln}⁡3}+\\frac{{x}^{2}}{{ln}^{2}⁡3}+C \\\\  & =\\frac{2{x}^{2}{ln}^{2}⁡x}{{ln}^{2}⁡3}-\\frac{2{x}^{2}\\operatorname{ln}⁡x}{{ln}^{2}⁡3}+\\frac{{x}^{2}}{{ln}^{2}⁡3}+C \\\\  & =\\frac{{x}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡x-2\\operatorname{ln}⁡x+1)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{4D}{\\operatorname{ln}⁡3}.$ \n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$\n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}4x({log}_{3}⁡x)^{2}\\,\\text{d}x & ={[\\frac{{x}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡x-2\\operatorname{ln}⁡x+1)]}_{1}^{e} \\\\  & =\\frac{{e}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡e-2\\operatorname{ln}⁡e+1)-\\frac{{1}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡1-2\\operatorname{ln}⁡1+1) \\\\  & =\\frac{{e}^{2}}{{ln}^{2}⁡3}(2-2+1)-\\frac{1}{{ln}^{2}⁡3}(0-0+1) \\\\  & =\\frac{{e}^{2}-1}{{ln}^{2}⁡3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114900" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-114900" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114900" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2{e}^{2}-1"] ["math" "8e"] ["math" "\\frac{1-2e}{{ln}^{2}⁡3}"] ["math" "\\frac{{e}^{2}+2}{{ln}^{2}⁡3}"] ["math" "\\frac{{e}^{2}-1}{{ln}^{2}⁡3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114900" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{{e}^{2}-1}{{ln}^{2}⁡3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352056" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{e-1}27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352056" "field" nil "attribute" "question/worked-solution" "value" "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡(x+1))^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(x+1)}{x+1}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=27(x+1)^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 27(x+1)^{2}\\,\\text{d}x=9(x+1)^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡(x+1))}^{2}(9(x+1)^{3})-\\int (9(x+1)^{3})(\\frac{2\\operatorname{ln}⁡(x+1)}{x+1})\\,\\text{d}x \\\\  & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-18\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x+1) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x+1}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=(x+1)^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int (x+1)^{2}\\,\\text{d}x=\\frac{(x+1)^{3}}{3}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(x+1)(\\frac{(x+1)^{3}}{3})-\\int (\\frac{(x+1)^{3}}{3})(\\frac{1}{x+1})\\,\\text{d}x \\\\  & =\\frac{(x+1)^{3}\\operatorname{ln}⁡(x+1)}{3}-\\frac{1}{3}\\int (x+1)^{2}\\,\\text{d}x \\\\  & =\\frac{(x+1)^{3}\\operatorname{ln}⁡(x+1)}{3}-\\frac{(x+1)^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\,\\text{d}x & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-18\\int (x+1)^{2}\\operatorname{ln}⁡(x+1)\\,\\text{d}x \\\\  & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-18(\\frac{(x+1)^{3}\\operatorname{ln}⁡(x+1)}{3}-\\frac{(x+1)^{3}}{9}+D) \\\\  & =9(x+1)^{3}{(\\operatorname{ln}⁡(x+1))}^{2}-6(x+1)^{3}\\operatorname{ln}⁡(x+1)+2(x+1)^{3}-18D \\\\  & =(x+1)^{3}(9{(\\operatorname{ln}⁡(x+1))}^{2}-6\\operatorname{ln}⁡(x+1)+2)+C,\\end{aligned}\n$$\n\nwhere $C=-18D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{e-1}27(x+1)^{2}(\\operatorname{ln}⁡(x+1))^{2}\\text{d}x & ={[(x+1)^{3}(9{(\\operatorname{ln}⁡(x+1))}^{2}-6\\operatorname{ln}⁡(x+1)+2)]}_{0}^{e-1} \\\\  & =[{e}^{3}(9{(\\operatorname{ln}⁡e)}^{2}-6\\operatorname{ln}⁡e+2)]-[{1}^{3}(9{(\\operatorname{ln}⁡1)}^{2}-6\\operatorname{ln}⁡1+2)] \\\\  & =[{e}^{3}(9-6+2)]-2 \\\\  & =5{e}^{3}-2\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352056" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-352056" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352056" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "5e^3-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352049" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/3}^{e/3}243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352049" "field" nil "attribute" "question/worked-solution" "value" "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡(3x))^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(3x)}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=243{x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 243{x}^{2}\\,\\text{d}x=81{x}^{3}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={(\\operatorname{ln}⁡(3x))}^{2}(81{x}^{3})-\\int (81{x}^{3})(\\frac{2\\operatorname{ln}⁡(3x)}{x})\\,\\text{d}x \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{2} & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{1}{3}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{{x}^{3}}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162\\int {x}^{2}\\operatorname{ln}⁡(3x)\\,\\text{d}x \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-162(\\frac{{x}^{3}\\operatorname{ln}⁡(3x)}{3}-\\frac{{x}^{3}}{9}+D) \\\\  & =81{x}^{3}{(\\operatorname{ln}⁡(3x))}^{2}-54{x}^{3}\\operatorname{ln}⁡(3x)+18{x}^{3}-162D \\\\  & ={x}^{3}(81{(\\operatorname{ln}⁡(3x))}^{2}-54\\operatorname{ln}⁡(3x)+18)+C,\\end{aligned}\n$$\n\nwhere $C=-162D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e/3}243{x}^{2}(\\operatorname{ln}⁡(3x))^{2}\\text{d}x & ={[{x}^{3}(81{(\\operatorname{ln}⁡(3x))}^{2}-54\\operatorname{ln}⁡(3x)+18)]}_{1/3}^{e/3} \\\\  & =[{(\\frac{e}{3})}^{3}(81{(\\operatorname{ln}⁡(3\\cdot \\frac{e}{3}))}^{2}-54\\operatorname{ln}⁡(3\\cdot \\frac{e}{3})+18)] \\\\  & \\,-[{(\\frac{1}{3})}^{3}(81{(\\operatorname{ln}⁡(3\\cdot \\frac{1}{3}))}^{2}-54\\operatorname{ln}⁡(3\\cdot \\frac{1}{3})+18)] \\\\  & =[\\frac{{e}^{3}}{27}(81{(\\operatorname{ln}⁡e)}^{2}-54\\operatorname{ln}⁡e+18)]-[\\frac{1}{27}(81{(\\operatorname{ln}⁡1)}^{2}-54\\operatorname{ln}⁡1+18)] \\\\  & =[\\frac{{e}^{3}}{27}(81-54+18)]-\\frac{1}{27}\\cdot 18 \\\\  & =\\frac{5{e}^{3}-2}{3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352049" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-352049" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352049" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5e^3-2}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352040" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/3}^{e/3}3(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352040" "field" nil "attribute" "question/worked-solution" "value" "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡(3x))^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡(3x)}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=3 & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 3\\,\\text{d}x=3x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(\\operatorname{ln}⁡(3x))^{2}(3x)-\\int (3x)(\\frac{2\\operatorname{ln}⁡(3x)}{x})\\,\\text{d}x \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=6 & \\,⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 6\\,\\text{d}x=6x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡(3x)(6x)-\\int (6x)(\\frac{1}{x})\\,\\text{d}x \\\\  & =6x\\operatorname{ln}⁡(3x)-\\int 6\\,\\text{d}x \\\\  & =6x\\operatorname{ln}⁡(3x)-6x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =3x(\\operatorname{ln}⁡(3x))^{2}-\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-(6x\\operatorname{ln}⁡(3x)-6x+D) \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-6x\\operatorname{ln}⁡(3x)+6x-D \\\\  & =3x((\\operatorname{ln}⁡(3x))^{2}-2\\operatorname{ln}⁡(3x)+2)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e/3}3(\\operatorname{ln}⁡(3x))^{2}\\text{d}x & ={[3x((\\operatorname{ln}⁡(3x))^{2}-2\\operatorname{ln}⁡(3x)+2)]}_{1/3}^{e/3} \\\\  & =[3(\\frac{e}{3})({(\\operatorname{ln}⁡(3\\cdot \\frac{e}{3}))}^{2}-2\\operatorname{ln}⁡(3\\cdot \\frac{e}{3})+2)]-[3(\\frac{1}{3})({(\\operatorname{ln}⁡(3\\cdot \\frac{1}{3}))}^{2}-2\\operatorname{ln}⁡(3\\cdot \\frac{1}{3})+2)] \\\\  & =[e((\\operatorname{ln}⁡e)^{2}-2\\operatorname{ln}⁡e+2)]-[1((\\operatorname{ln}⁡1)^{2}-2\\operatorname{ln}⁡1+2)] \\\\  & =[e(1-2+2)]-[1(0-0+2)] \\\\  & =e-2\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352040" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-352040" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-352040" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "e-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114880" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114880" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{4}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{4}⁡x)}^{2}(x)-\\int (x)(\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =x{({log}_{4}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡4}\\int {log}_{4}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {log}_{4}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{4}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{4}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{4}⁡(x))(x)-\\int (x)(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =x{log}_{4}⁡(x)-\\frac{1}{\\operatorname{ln}⁡4}\\int \\,\\text{d}x \\\\  & =x{log}_{4}⁡(x)-\\frac{x}{\\operatorname{ln}⁡4}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x & =x{({log}_{4}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡4}(x{log}_{4}⁡(x)-\\frac{x}{\\operatorname{ln}⁡4}+D) \\\\  & =x{({log}_{4}⁡x)}^{2}-\\frac{2x{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{2x}{{ln}^{2}⁡4}-\\frac{2D}{\\operatorname{ln}⁡4} \\\\  & =x({({log}_{4}⁡x)}^{2}-\\frac{2{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{2}{{ln}^{2}⁡4})+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{2D}{\\operatorname{ln}⁡4}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114880" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/activity-metadata.json" "file_sha256" "334a6dfe0abaedc359e03822588ccd7dbae6cc1a8b9b1c81c7e0bdd530b040c1"} {"question" "q-114880" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114880" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x({({log}_{4}⁡x)}^{2}+\\frac{{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{1}{{ln}^{2}⁡4})+C"] ["math" "x({({log}_{4}⁡x)}^{2}-\\frac{2{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{2}{{ln}^{2}⁡4})+C"] ["math" "x({log}_{4}⁡(x)+\\frac{2}{{ln}^{2}⁡4})+C"] ["math" "x({log}_{4}⁡(x)-\\frac{1}{{ln}^{2}⁡4})+C"] ["math" "x{({log}_{4}⁡x)}^{2}+2{log}_{4}⁡(x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "q-114880" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x({({log}_{4}⁡x)}^{2}-\\frac{2{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{2}{{ln}^{2}⁡4})+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/state.json" "file_sha256" "890d224ec8e2720bf829a6b92c5e443d30a29b937e02155cab2dc7202df25826"} {"question" "e-7053" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle \\int_0^1 (t^2+1)e^{2t+1} \\, \\textrm{d} t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/example-7053.json" "file_sha256" "fe38e0123e0de33f6eb8e4b1b99e4f444e4212906e0b71f21ee73167a8c9a9c8"} {"question" "e-7053" "field" nil "attribute" "question/worked-solution" "value" "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u={t}^{2}+1\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=2t, \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+1}\\,\\text{d}t=\\frac{{e}^{2t+1}}{2}.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get \n\n$$\n\\begin{aligned}\\int ({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =({t}^{2}+1)(\\frac{{e}^{2t+1}}{2})-\\int (\\frac{{e}^{2t+1}}{2})(2t)\\,\\text{d}t \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\int t\\,{e}^{2t+1}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int t\\,e^{2t+1}\\,\\textrm{d}t.$ We take\n\n$$\n\\begin{aligned}u=t\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}t}=1 \\\\ \\frac{\\text{d}v}{\\text{d}t}={e}^{2t+1}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t=\\int {e}^{2t+1}\\,\\text{d}t=\\frac{{e}^{2t+1}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int t\\,{e}^{2t+1}\\,\\text{d}t & =\\int u\\frac{\\text{d}v}{\\text{d}t}\\,\\text{d}t \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}t}\\,\\text{d}t \\\\  & =(t)(\\frac{{e}^{2t+1}}{2})-\\int (\\frac{{e}^{2t+1}}{2})(1)\\,\\text{d}t \\\\  & =\\frac{t\\,{e}^{2t+1}}{2}-\\frac{1}{2}\\int {e}^{2t+1}\\,\\text{d}t \\\\  & =\\frac{t\\,{e}^{2t+1}}{2}-\\frac{{e}^{2t+1}}{4}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int ({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\int t\\,{e}^{2t+1}\\,\\text{d}t \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-(\\frac{t\\,{e}^{2t+1}}{2}-\\frac{{e}^{2t+1}}{4}+D) \\\\  & =\\frac{({t}^{2}+1){e}^{2t+1}}{2}-\\frac{t\\,{e}^{2t+1}}{2}+\\frac{{e}^{2t+1}}{4}-D \\\\  & =\\frac{{e}^{2t+1}}{4}(2{t}^{2}-2t+3)+C,\\end{aligned}\n$$\n\nwhere $C = -{D}.$ \n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({t}^{2}+1){e}^{2t+1}\\,\\text{d}t & ={[\\frac{{e}^{2t+1}}{4}(2{t}^{2}-2t+3)]}_{0}^{1} \\\\  & =(\\frac{{e}^{2(1)+1}}{4}(2(1)^{2}-2(1)+3))-(\\frac{{e}^{2(0)+1}}{4}(2(0)^{2}-2(0)+3)) \\\\  & =\\frac{{e}^{3}}{4}(2-2+3)-\\frac{e}{4}(0-0+3) \\\\  & =\\frac{3{e}^{3}}{4}-\\frac{3e}{4} \\\\  & =\\frac{3{e}^{3}-3e}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/example-7053.json" "file_sha256" "fe38e0123e0de33f6eb8e4b1b99e4f444e4212906e0b71f21ee73167a8c9a9c8"} {"question" "e-495" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle \\int x^2\\cos(3x) \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/example-495.json" "file_sha256" "c2560714d737412ad6c32ca7148380ba79fd8de1a0a5d6db76e4616f4f726585"} {"question" "e-495" "field" nil "attribute" "question/worked-solution" "value" "In this case, we define\n\n$$\n\\begin{aligned}u={x}^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=2x\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{cos}⁡(3x)\\text{d}x=\\frac{1}{3}\\,\\operatorname{sin}⁡(3x)\\,.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(3x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =({x}^{2})(\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))-\\int (\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))2x\\,\\text{d}x \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\displaystyle \\int x\\sin(3x) \\textrm{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(3x)\\text{d}x=-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x)\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(3x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =x(-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x))-\\int (-\\,\\frac{1}{3}\\,\\operatorname{cos}⁡(3x))\\cdot 1\\,\\text{d}x \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{3}\\int \\operatorname{cos}⁡(3x)\\text{d}x \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{3}(\\frac{1}{3}\\,\\operatorname{sin}⁡(3x))+{C}_{1} \\\\  & =-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}\\,\\end{aligned}\n$$\n\nwhere $C_1$ is a constant of integration.\nSo we have\n\n$$\n\\begin{aligned}\\int {x}^{2}\\operatorname{cos}⁡(3x)\\text{d}x & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}\\int x\\operatorname{sin}⁡(3x)\\text{d}x \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)-\\frac{2}{3}(-\\,\\frac{1}{3}\\,x\\operatorname{cos}⁡(3x)+\\frac{1}{9}\\,\\operatorname{sin}⁡(3x)+{C}_{1}) \\\\  & =\\frac{1}{3}{x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2}{9}x\\operatorname{cos}⁡(3x)-\\frac{2}{27}\\operatorname{sin}⁡(3x)-\\frac{2{C}_{1}}{3} \\\\  & =\\frac{1}{27}((9{x}^{2}-2)\\operatorname{sin}⁡(3x)+6x\\operatorname{cos}⁡(3x))+C,\\end{aligned}\n$$\n\nwhere $C = -\\dfrac{2C_1}{3}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/example-495.json" "file_sha256" "c2560714d737412ad6c32ca7148380ba79fd8de1a0a5d6db76e4616f4f726585"} {"question" "e-496" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle \\int_1^e 32x^3(\\ln x)^2 \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/example-496.json" "file_sha256" "9e543c7bb30ddfd20cf829e256641be203761b075cd6ed45507374baebd7ae55"} {"question" "e-496" "field" nil "attribute" "question/worked-solution" "value" "We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=(\\operatorname{ln}⁡x)^{2} & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2\\operatorname{ln}⁡x}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=32{x}^{3} & \\,⟹\\,v=\\int 32{x}^{3}\\text{d}x=8{x}^{4}\\,.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & ={(\\operatorname{ln}⁡x)}^{2}(8{x}^{4})-\\int (8{x}^{4})(\\frac{2\\operatorname{ln}⁡x}{x})\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\displaystyle\\int {x^3\\ln(x)} \\textrm{d}x.$ We take\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x) & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}={x}^{3} & \\,⟹\\,v=\\int {x}^{3}\\text{d}x=\\frac{{x}^{4}}{4}\\,.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\text{d}x \\\\  & =\\operatorname{ln}⁡(x)(\\frac{{x}^{4}}{4})-\\int (\\frac{{x}^{4}}{4})(\\frac{1}{x})\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{1}{4}\\int {x}^{3}\\text{d}x \\\\  & =\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}\\end{aligned}\n$$\n\nwhere $C_1$ is an integral constant. So, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 32{x}^{3}(\\operatorname{ln}⁡x)^{2}\\text{d}x & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16\\int {x}^{3}\\operatorname{ln}⁡(x)\\text{d}x \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-16(\\frac{{x}^{4}\\operatorname{ln}⁡(x)}{4}-\\frac{{x}^{4}}{16}+{C}_{1}) \\\\  & =8{x}^{4}{(\\operatorname{ln}⁡x)}^{2}-4{x}^{4}\\operatorname{ln}⁡(x)+{x}^{4}-16{C}_{1} \\\\  & ={x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)+C\\,\\end{aligned}\n$$\n\nwhere $C = -4C_1.$ Finally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}32{x}^{3}\\operatorname{ln}⁡(x)\\text{d}x & ={{x}^{4}(8{(\\operatorname{ln}⁡x)}^{2}-4\\operatorname{ln}⁡(x)+1)|}_{1}^{e} \\\\  & =[(e)^{4}(8{(\\operatorname{ln}⁡(e))}^{2}-4\\operatorname{ln}⁡(e)+1)]-[(1)^{4}(8{(\\operatorname{ln}⁡(1))}^{2}-4\\operatorname{ln}⁡(1)+1)] \\\\  & =[{e}^{4}(8-4+1)]-1 \\\\  & =5{e}^{4}-1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039129/example-496.json" "file_sha256" "9e543c7bb30ddfd20cf829e256641be203761b075cd6ed45507374baebd7ae55"}] "usage" {"e-7053" [] "e-496" [] "e-495" [] "q-352049" [] "q-50222" []} "basis" 1357 "retractions" [] "immutable_answers" [17592186290226 17592186290237 17592186290238 17592186290239 17592186290240 17592186290241] "immutable_fields" [[17592186290225 :answer-field/correct] [17592186290225 :answer-field/id] [17592186290225 :answer-field/key] [17592186290225 :answer-field/type] [17592186290236 :answer-field/correct] [17592186290236 :answer-field/id] [17592186290236 :answer-field/key] [17592186290236 :answer-field/type]] "no_history" []}
