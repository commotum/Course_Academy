⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int (4{x}^{2}+2)\\operatorname{cos}⁡x\\,\\text{d}x & =(4{x}^{2}+2)\\operatorname{sin}⁡x-8\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =(4{x}^{2}+2)\\operatorname{sin}⁡x-8(-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D) \\\\  & =(4{x}^{2}+2)\\operatorname{sin}⁡x+8x\\operatorname{cos}⁡x-8\\operatorname{sin}⁡x+C,\\end{aligned}\n$$\n\nwhere $C=-8D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}(4{x}^{2}+2)\\operatorname{cos}⁡x\\,\\text{d}x & ={[(4{x}^{2}+2)\\operatorname{sin}⁡x+8x\\operatorname{cos}⁡x-8\\operatorname{sin}⁡x]}_{0}^{\\pi /2} \\\\  & =((4{(\\frac{\\pi }{2})}^{2}+2)\\operatorname{sin}⁡\\frac{\\pi }{2}+8(\\frac{\\pi }{2})\\operatorname{cos}⁡\\frac{\\pi }{2}-8\\operatorname{sin}⁡\\frac{\\pi }{2})-(2\\operatorname{sin}⁡0+8(0)\\operatorname{cos}⁡0-8\\operatorname{sin}⁡0) \\\\  & =({\\pi }^{2}+2+0-8)-0 \\\\  & ={\\pi }^{2}-6 \\\\  & ={\\pi }^{2}-6\\end{aligned}\n$$" 13194139534670 true] [17592186302503 1000 #edb/ref 17592186302504 13194139534670 true] [17592186302503 1040 #edb/ref 17592186045449 13194139534670 true] [17592186302503 1041 "field-1" 13194139534670 true] [17592186302503 1104 #edb/ref 17592186302504 13194139534670 true] [17592186302503 1110 #uuid "1747833e-00a1-5a08-8b51-d14818791771" 13194139534670 true] [17592186302504 1034 "\\pi^2-6" 13194139534670 true] [17592186302504 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302504 1111 #uuid "669a636b-6611-50b8-84df-2a22afa2af9d" 13194139534670 true] [17592186302505 1017 #edb/ref 17592186302506 13194139534670 true] [17592186302505 1089 "q-352026" 13194139534670 true] [17592186302505 1091 #edb/ref 17592186045464 13194139534670 true] [17592186302505 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" 13194139534670 true] [17592186302505 1113 #uuid "b7fb7e80-d19f-5ebe-bec3-1c2b35c237a8" 13194139534670 true] [17592186302505 1145 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=3{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=6x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡(3x)\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡(3x)\\,\\text{d}x=\\frac{\\operatorname{sin}⁡(3x)}{3}.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(3{x}^{2})(\\frac{\\operatorname{sin}⁡(3x)}{3})-\\int (\\frac{\\operatorname{sin}⁡(3x)}{3})(6x)\\,\\text{d}x \\\\  & ={x}^{2}\\operatorname{sin}⁡(3x)-2\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡(3x) & \\,⟹\\,v=\\int \\operatorname{sin}⁡(3x)\\text{d}x=-\\frac{\\operatorname{cos}⁡(3x)}{3}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\frac{\\operatorname{cos}⁡(3x)}{3})-\\int (-\\frac{\\operatorname{cos}⁡(3x)}{3})\\cdot 1\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(3x)}{3}+\\frac{1}{3}\\int \\operatorname{cos}⁡(3x)\\,dx \\\\  & =-\\frac{x\\operatorname{cos}⁡(3x)}{3}+\\frac{\\operatorname{sin}⁡(3x)}{9}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={x}^{2}\\operatorname{sin}⁡(3x)-2\\int x\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & ={x}^{2}\\operatorname{sin}⁡(3x)-2(-\\frac{x\\operatorname{cos}⁡(3x)}{3}+\\frac{\\operatorname{sin}⁡(3x)}{9}+D) \\\\  & ={x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2x\\operatorname{cos}⁡(3x)}{3}-\\frac{2\\operatorname{sin}⁡(3x)}{9}+C,\\end{aligned}\n$$\n\nwhere $C=-2D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}3{x}^{2}\\operatorname{cos}⁡(3x)\\,\\text{d}x & ={[{x}^{2}\\operatorname{sin}⁡(3x)+\\frac{2x\\operatorname{cos}⁡(3x)}{3}-\\frac{2\\operatorname{sin}⁡(3x)}{9}]}_{0}^{\\pi /2} \\\\  & ={(\\frac{\\pi }{2})}^{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2})+\\frac{2(\\frac{\\pi }{2})\\operatorname{cos}⁡(\\frac{3\\pi }{2})}{3}-\\frac{2\\operatorname{sin}⁡(\\frac{3\\pi }{2})}{9} \\\\  & \\,-((0)^{2}\\operatorname{sin}⁡(0)+\\frac{2(0)\\operatorname{cos}⁡(0)}{3}-\\frac{2\\operatorname{sin}⁡(0)}{9}) \\\\  & =-\\frac{{\\pi }^{2}}{4}+0+\\frac{2}{9}-0 \\\\  & =\\frac{8-9{\\pi }^{2}}{36} \\\\  & =\\frac{8-9{\\pi }^{2}}{36}\\end{aligned}\n$$" 13194139534670 true] [17592186302506 1000 #edb/ref 17592186302507 13194139534670 true] [17592186302506 1000 #edb/ref 17592186302508 13194139534670 true] [17592186302506 1040 #edb/ref 17592186045449 13194139534670 true] [17592186302506 1041 "field-1" 13194139534670 true] [17592186302506 1104 #edb/ref 17592186302507 13194139534670 true] [17592186302506 1110 #uuid "1558dd5c-dd70-57ad-adab-2b2fbc884a12" 13194139534670 true] [17592186302507 1034 "\\frac{2}{9}-\\frac{\\pi^2}{4}" 13194139534670 true] [17592186302507 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302507 1111 #uuid "0a7e3cbc-ab0b-584d-9f78-750a8e82180d" 13194139534670 true] [17592186302508 1034 "0" 13194139534670 true] [17592186302508 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302508 1111 #uuid "47dc2ddb-39d8-56