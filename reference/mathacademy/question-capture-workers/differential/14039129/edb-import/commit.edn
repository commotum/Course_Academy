ln}⁡(3x)(6x)-\\int (6x)(\\frac{1}{x})\\,\\text{d}x \\\\  & =6x\\operatorname{ln}⁡(3x)-\\int 6\\,\\text{d}x \\\\  & =6x\\operatorname{ln}⁡(3x)-6x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 3(\\operatorname{ln}⁡(3x))^{2}\\,\\text{d}x & =3x(\\operatorname{ln}⁡(3x))^{2}-\\int 6\\operatorname{ln}⁡(3x)\\,\\text{d}x \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-(6x\\operatorname{ln}⁡(3x)-6x+D) \\\\  & =3x(\\operatorname{ln}⁡(3x))^{2}-6x\\operatorname{ln}⁡(3x)+6x-D \\\\  & =3x((\\operatorname{ln}⁡(3x))^{2}-2\\operatorname{ln}⁡(3x)+2)+C,\\end{aligned}\n$$\n\nwhere $C=-D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e/3}3(\\operatorname{ln}⁡(3x))^{2}\\text{d}x & ={[3x((\\operatorname{ln}⁡(3x))^{2}-2\\operatorname{ln}⁡(3x)+2)]}_{1/3}^{e/3} \\\\  & =[3(\\frac{e}{3})({(\\operatorname{ln}⁡(3\\cdot \\frac{e}{3}))}^{2}-2\\operatorname{ln}⁡(3\\cdot \\frac{e}{3})+2)]-[3(\\frac{1}{3})({(\\operatorname{ln}⁡(3\\cdot \\frac{1}{3}))}^{2}-2\\operatorname{ln}⁡(3\\cdot \\frac{1}{3})+2)] \\\\  & =[e((\\operatorname{ln}⁡e)^{2}-2\\operatorname{ln}⁡e+2)]-[1((\\operatorname{ln}⁡1)^{2}-2\\operatorname{ln}⁡1+2)] \\\\  & =[e(1-2+2)]-[1(0-0+2)] \\\\  & =e-2\\end{aligned}\n$$" 13194139534670 true] [17592186302510 1000 #edb/ref 17592186302511 13194139534670 true] [17592186302510 1040 #edb/ref 17592186045449 13194139534670 true] [17592186302510 1041 "field-1" 13194139534670 true] [17592186302510 1104 #edb/ref 17592186302511 13194139534670 true] [17592186302510 1110 #uuid "28351b5f-e013-5b3b-aaa4-4ba297ba17fa" 13194139534670 true] [17592186302511 1034 "e-2" 13194139534670 true] [17592186302511 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302511 1111 #uuid "23e51810-23e4-5e52-935a-3629411dd774" 13194139534670 true] [17592186302512 1034 "0" 13194139534670 true] [17592186302512 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302512 1111 #uuid "ea22a52c