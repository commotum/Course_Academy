^{2}+1){e}^{2x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(4{x}^{2}+1)(\\frac{{e}^{2x}}{2})-\\int (\\frac{{e}^{2x}}{2})(8x)\\,\\text{d}x \\\\  & =\\frac{(4{x}^{2}+1){e}^{2x}}{2}-4\\int x{e}^{2x}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x{e}^{2x}\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1 \\\\ \\frac{\\text{d}v}{\\text{d}x}={e}^{2x}\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int {e}^{2x}\\,\\text{d}x=\\frac{{e}^{2x}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{e}^{2x}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(\\frac{{e}^{2x}}{2})-\\int (\\frac{{e}^{2x}}{2})(1)\\,\\text{d}x \\\\  & =\\frac{x{e}^{2x}}{2}-\\frac{1}{2}\\int {e}^{2x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{2x}}{2}-\\frac{{e}^{2x}}{4}+D \\\\  & =\\frac{{e}^{2x}}{4}(2x-1)+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int (4{x}^{2}+1){e}^{2x}\\,\\text{d}x & =\\frac{(4{x}^{2}+1){e}^{2x}}{2}-4(\\frac{{e}^{2x}}{4}(2x-1)+D) \\\\  & =\\frac{(4{x}^{2}+1){e}^{2x}}{2}-{e}^{2x}(2x-1)-4D \\\\  & =\\frac{{e}^{2x}}{2}(4{x}^{2}-4x+3)+C,\\end{aligned}\n$$\n\nwhere $C=-4D.$" 13194139534670 true] [17592186302472 1000 #edb/ref 17592186302473 13194139534670 true] [17592186302472 1000 #edb/ref 17592186302474 13194139534670 true] [17592186302472 1000 #edb/ref 17592186302475 13194139534670 true] [17592186302472 1000 #edb/ref 17592186302476 13194139534670 true] [17592186302472 1000 #edb/ref 17592186302477 13194139534670 true] [17592186302472 1040 #edb/ref 17592186045450 13194139534670 true] [17592186302472 1041 "selection" 13194139534670 true] [17592186302472 1104 #edb/ref 17592186302475 13194139534670 true] [17592186302472 1110 #uuid "7fa2bca9-1d3d-58d9-86bb-02ea3d2d3255" 13194139534670 true] [17592186302473 1034 "\\frac{{e}^{2x}}{2}(2{x}^{2}-2x+1)+C" 13194139534670 true] [17592186302473 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302473 1111 #uuid "1ab0674c-09c8-5240-aedf-c035249acffd" 13194139534670 true] [17592186302474 1034 "\\frac{{e}^{2x}}{2}(2{x}^{2}+4x+1)+C" 13194139534670 true] [17592186302474 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302474 1111 #uuid "a5ba89f8-5588-557a-86cc-689cccf65370" 13194139534670 true] [17592186302475 1034 "\\frac{{e}^{2x}}{2}(4{x}^{2}-4x+3)+C" 13194139534670 true] [17592186302475 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302475 1111 #uuid "7e7bd74f-53ad-5c3e-90fa-51e8ab8d8398" 13194139534670 true] [17592186302476 1034 "\\frac{{e}^{2x}}{2}({x}^{2}-2x+3)+C" 13194139534670 true] [17592186302476 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302476 1111 #uuid "285f891a-bd61-57e3-a6a8-f017ae3233f6" 13194139534670 true] [17592186302477 1034 "\\frac{{e}^{2x}}{2}(4{x}^{2}-2x-3)+C" 13194139534670 true] [17592186302477 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302477 1111 #uuid "07e52578-78ff-5fd8-bdfb-4995a16fe528" 13194139534670 true] [17592186302478 1017 #edb/ref 17592186302479 13194139534670 true] [17592186302478 1089 "q-114880" 13194139534670 true] [17592186302478 1091 #edb/ref 17592186045465 13194139534670 true] [17592186302478 1100 "Calculate the integral $\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x.$" 13194139534670 true] [17592186302478 1113 #uuid "854f6c95-7a5c-5893-a4e7-acee80cffe1e" 13194139534670 true] [17592186302478 1145 "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{4}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{4}⁡x)}^{2}(x)-\\int (x)(\\frac{2{log}_{4}⁡x}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =x{({log}_{4}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡4}\\int {log}_{4}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {log}_{4}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{4}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{4}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{4}⁡(x))(x)-\\int (x)(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =x{log}_{4}⁡(x)-\\frac{1}{\\operatorname{ln}⁡4}\\int \\,\\text{d}x \\\\  & =x{log}_{4}⁡(x)-\\frac{x}{\\operatorname{ln}⁡4}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({log}_{4}⁡x)^{2}\\,\\text{d}x & =x{({log}_{4}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡4}(x{log}_{4}⁡(x)-\\frac{x}{\\operatorname{ln}⁡4}+D) \\\\  & =x{({log}_{4}⁡x)}^{2}-\\frac{2x{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{2x}{{ln}^{2}⁡4}-\\frac{2D}{\\operatorname{ln}⁡4} \\\\  & =x({({log}_{4}⁡x)}^{2}-\\frac{2{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{2}{{ln}^{2}⁡4})+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{2D}{\\operatorname{ln}⁡4}.$" 13194139534670 true] [17592186302479 1000 #edb/ref 17592186302480 13194139534670 true] [17592186302479 1000 #edb/ref 17592186302481 13194139534670 true] [17592186302479 1000 #edb/ref 17592186302482 13194139534670 true] [17592186302479 1000 #edb/ref 17592186302483 13194139534670 true] [17592186302479 1000 #edb/ref 17592186302484 13194139534670 true] [17592186302479 1040 #edb/ref 17592186045450 13194139534670 true] [17592186302479 1041 "selection" 13194139534670 true] [17592186302479 1104 #edb/ref 17592186302481 13194139534670 true] [17592186302479 1110 #uuid "f1ddaba5-abc7-516d-b907-a4dbdb41bb07" 13194139534670 true] [17592186302480 1034 "x({log}_{4}⁡(x)-\\frac{1}{{ln}^{2}⁡4})+C" 13194139534670 true] [17592186302480 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302480 1111 #uuid "c005183d-66c2-596d-8ebf-f8fb107e87d0" 13194139534670 true] [17592186302481 1034 "x({({log}_{4}⁡x)}^{2}-\\frac{2{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{2}{{ln}^{2}⁡4})+C" 13194139534670 true] [17592186302481 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302481 1111 #uuid "6ccced5a-a91e-592e-9d56-8121ee8fb5af" 13194139534670 true] [17592186302482 1034 "x({({log}_{4}⁡x)}^{2}+\\frac{{log}_{4}⁡(x)}{\\operatorname{ln}⁡4}+\\frac{1}{{ln}^{2}⁡4})+C" 13194139534670 true] [17592186302482 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302482 1111 #uuid "9fe92e85-cb8c-5e90-a327-d1625366ba62" 13194139534670 true] [17592186302483 1034 "x({log}_{4}⁡(x)+\\frac{2}{{ln}^{2}⁡4})+C" 13194139534670 true] [17592186302483 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302483 1111 #uuid "7680a0e1-6003-53fb-a04d-ae82b5801d6d" 13194139534670 true] [17592186302484 1034 "x{({log}_{4}⁡x)}^{2}+2{log}_{4}⁡(x)+C" 13194139534670 true] [17592186302484 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302484 1111 #uuid "e262f3e1-fc45-5e32-a420-b98d80d52360" 13194139534670 true] [17592186302485 1017 #edb/ref 17592186302486 13194139534670 true] [17592186302485 1089 "q-114900" 13194139534670 true] [17592186302485 1091 #edb/ref 17592186045464 13194139534670 true] [17592186302485 1100 "Evaluate ${\\int }_{1}^{e}4x({log}_{3}⁡x)^{2}\\,\\text{d}x.$" 13194139534670 true] [17592186302485 1113 #uuid "12877697-16da-579f-9576-412230e02539" 13194139534670 true] [17592186302485 1145 "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{3}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=4x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int 4x\\,\\text{d}x=2{x}^{2}.\\end{aligned}\n$$\n\nThis gives\n\n$$\n\\begin{aligned}\\int 4x({log}_{3}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{3}⁡x)}^{2}(2{x}^{2})-\\int (2{x}^{2})(\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{4}{\\operatorname{ln}⁡3}\\int x{log}_{3}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate $\\int x{log}_{3}⁡(x)\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int x\\,\\text{d}x=\\frac{{x}^{2}}{2}.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x{log}_{3}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{3}⁡x)(\\frac{{x}^{2}}{2})-\\int (\\frac{{x}^{2}}{2})(\\frac{1}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{1}{2\\operatorname{ln}⁡3}\\int x\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡3}+D,\\end{aligned}\n$$\n\nwhere $D$ is a constant. \n\nSo, we get that the indefinite integral is \n\n$$\n\\begin{aligned}\\int 4x({log}_{3}⁡x)^{2}\\,\\text{d}x & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{4}{\\operatorname{ln}⁡3}(\\frac{{x}^{2}{log}_{3}⁡x}{2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡3}+D) \\\\  & =2{x}^{2}({log}_{3}⁡x)^{2}-\\frac{2{x}^{2}{log}_{3}⁡x}{\\operatorname{ln}⁡3}+\\frac{{x}^{2}}{{ln}^{2}⁡3}+C \\\\  & =\\frac{2{x}^{2}{ln}^{2}⁡x}{{ln}^{2}⁡3}-\\frac{2{x}^{2}\\operatorname{ln}⁡x}{{ln}^{2}⁡3}+\\frac{{x}^{2}}{{ln}^{2}⁡3}+C \\\\  & =\\frac{{x}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡x-2\\operatorname{ln}⁡x+1)+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{4D}{\\operatorname{ln}⁡3}.$ \n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$\n\nFinally then, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}4x({log}_{3}⁡x)^{2}\\,\\text{d}x & ={[\\frac{{x}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡x-2\\operatorname{ln}⁡x+1)]}_{1}^{e} \\\\  & =\\frac{{e}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡e-2\\operatorname{ln}⁡e+1)-\\frac{{1}^{2}}{{ln}^{2}⁡3}(2{ln}^{2}⁡1-2\\operatorname{ln}⁡1+1) \\\\  & =\\frac{{e}^{2}}{{ln}^{2}⁡3}(2-2+1)-\\frac{1}{{ln}^{2}⁡3}(0-0+1) \\\\  & =\\frac{{e}^{2}-1}{{ln}^{2}⁡3}.\\end{aligned}\n$$" 13194139534670 true] [17592186302486 1000 #edb/ref 17592186302487 13194139534670 true] [17592186302486 1000 #edb/ref 17592186302488 13194139534670 true] [17592186302486 1000 #edb/ref 17592186302489 13194139534670 true] [17592186302486 1000 #edb/ref 17592186302490 13194139534670 true] [17592186302486 1000 #edb/ref 17592186302491 13194139534670 true] [17592186302486 1040 #edb/ref 17592186045450 13194139534670 true] [17592186302486 1041 "selection" 13194139534670 true] [17592186302486 1104 #edb/ref 17592186302488 13194139534670 true] [17592186302486 1110 #uuid "2081bf06-435f-58de-b4ce-ab2a250a926c" 13194139534670 true] [17592186302487 1034 "2{e}^{2}-1" 13194139534670 true] [17592186302487 1103 #edb/ref 17592186045453 13194139534670 true] [17592186302487 1111 #uuid "ccf920b0-c603-5b4b-9894-b5580bc029dd" 13194139534670 true] [17592186302488 1034 "\\frac{{e}^{2}