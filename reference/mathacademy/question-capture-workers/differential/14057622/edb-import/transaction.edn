49714a7bea4191054b9aca809048b8e9807b9e185a3dd97c48" "q-42970/selection/cef5429f85e8a15b339fceabab809b998e1d4c29d64b5b9ba76fa9351a4575b9"] :db/ensure [:answer-field/validate]} {:db/id "q-42970" :question/id #uuid "69a6ad9d-656e-51bb-9c61-6471ddfbd822" :question/math-academy-id "q-42970" :question/problem "Consider the system of equations\n\n$$\n{\\begin{aligned}4x+7y=13 \\\\ -2x+5y=19.\\end{aligned}\n$$\n\nAccording to Cramer's rule, $y=$" :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}4x+7y=13 \\\\ -2x+5y=19.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}4 & 7 \\\\ -2 & 5\\end{aligned}|.\\end{aligned}\n$$\n\nNow, to construct ${D}_{y}$ we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}4 & 13 \\\\ -2 & 19\\end{aligned}|.\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{|\\begin{aligned}4 & 13 \\\\ -2 & 19\\end{aligned}|}{|\\begin{aligned}4 & 7 \\\\ -2 & 5\\end{aligned}|}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-42970/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4fcf3704-4856-5095-a6f4-7ec20d81f3c4"] :knowledge-point/questions ["q-42970"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77401/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "4c39b7b3-7ac3-5b42-a1f9-647ae49a032c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-77401/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "40547905-338c-5eb2-998a-423d4496c5d6" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-77401/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "b386dfd2-c25f-5723-81a9-60769cc66da9" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-77401/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6b182097-03f6-5ca4-a97c-285a71bba37f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-77401/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "9ee164b0-ad4b-5be9-a49c-b36ee706afd6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-77401/selection" :answer-field/id #uuid "093501fe-892b-586c-b246-d7c365451259" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77401/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-77401/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-77401/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-77401/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-77401/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-77401/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-77401" :question/id #uuid "0eb9ac70-c138-5a1e-a3c5-58f7492a13a3" :question/math-academy-id "q-77401" :question/problem "Let $⟨x,1⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}3x-y=k \\\\ x+4y=3\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=5$\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=-7$\n- $|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|=13$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}3 & -1 \\\\ 1 & 4\\end{aligned}| \\\\  & =12+1 \\\\  & =13.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}1 & =\\frac{{D}_{y}}{D} \\\\ 1 & =\\frac{|\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}|}{13} \\\\ |\\begin{aligned}3 & k \\\\ 1 & 3\\end{aligned}| & =13\\end{aligned}\n$$\n\nSo, the correct answer is \"III only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-77401/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d"] :knowledge-point/questions ["q-77401"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70252/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "4330df1e-c834-580d-9cec-35670e81873f" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-70252/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "744e467e-bda6-53b3-b523-5d32ebad0211" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-70252/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "cbd05303-f84e-5c67-b25f-01fc8466c943" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-70252/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "4fbbbcb1-bc09-5aad-a102-41f1f825662b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-70252/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "3791b02d-ebb5-586f-a80d-c9c0f6c0d972" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-70252/selection" :answer-field/id #uuid "37292bee-6ead-58b3-9354-c6080811ad1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70252/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-70252/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-70252/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-70252/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-70252/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-70252/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-70252" :question/id #uuid "745a2d2f-9203-593c-9a03-87c0afb1d76b" :question/math-academy-id "q-70252" :question/problem "Let $⟨-1,y⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}2x+ky=-4 \\\\ 3x-4y=5.\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|=-2|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|$\n- $|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|=|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|$\n- $|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|=-|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D} \\\\ -1 & =\\frac{|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|}{|\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}|} \\\\ |\\begin{aligned}2 & k \\\\ 3 & -4\\end{aligned}| & =-|\\begin{aligned}-4 & k \\\\ 5 & -4\\end{aligned}|\\end{aligned}\n$$\n\nSo, the correct answer is \"III only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70252/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d"] :knowledge-point/questions ["q-70252"] :db/ensure [:knowledge-point/validate]} {:db/id "q-42613/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "5e40c96e-c9bd-5724-8916-6682b2018ca9" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-42613/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "58786e39-375f-5c88-bf3b-57b71a14ddb8" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-42613/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "7c5cbc82-821d-546d-9470-35ee16eaaa68" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-42613/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "271c346f-48e5-5989-931c-c9f3fb5caab5" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-42613/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "07927c49-daa6-599c-99a3-151ad9664a0e" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-42613/selection" :answer-field/id #uuid "a7c1d2ba-bbf2-5aca-8c0c-7c5e798319ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-42613/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-42613/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-42613/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-42613/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-42613/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-42613/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-42613" :question/id #uuid "ff9ce129-3900-5770-b561-66ce2c4a5268" :question/math-academy-id "q-42613" :question/problem "Let $⟨-4,y⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}9x+11y=-14 \\\\ 6x-ky=-34.\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}-14 & 11 \\\\ -34 & -k\\end{aligned}|=-4|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|$\n- $|\\begin{aligned}-14 & 1 \\\\ -34 & -k\\end{aligned}|=4|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|$\n- $-4|\\begin{aligned}-14 & 11 \\\\ -34 & -k\\end{aligned}|=|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $x$ is given by $x=\\frac{{D}_{x}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}-14 & 11 \\\\ -34 & -k\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}x & =\\frac{{D}_{x}}{D} \\\\ -4 & =\\frac{|\\begin{aligned}-14 & 11 \\\\ -34 & -k\\end{aligned}|}{|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}|} \\\\ -4|\\begin{aligned}9 & 11 \\\\ 6 & -k\\end{aligned}| & =|\\begin{aligned}-14 & 11 \\\\ -34 & -k\\end{aligned}|\\end{aligned}\n$$\n\nSo, the correct answer is \"I only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-42613/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d"] :knowledge-point/questions ["q-42613"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139979/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d79aa8e3-b23a-5203-81a6-94b8ec733c6e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-139979/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "417111e1-6016-5c46-8c9a-7846d8a95b71" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-139979/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "3ee6e819-0557-520a-86da-3d870a6b7273" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-139979/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "7ed5583b-0386-5fb3-8830-4a46323bf10b" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-139979/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "1236127b-6df4-5881-8ce5-125e9236fd9d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-139979/selection" :answer-field/id #uuid "166fcc12-eb28-5326-8320-d665d7ee99de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139979/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-139979/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-139979/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-139979/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-139979/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-139979/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-139979" :question/id #uuid "204d23ff-7341-5b58-855c-7af3e1c0b22b" :question/math-academy-id "q-139979" :question/problem "Let $⟨x,3⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}kx+3y=1 \\\\ 7x-2y=8.\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $-3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$\n- $3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$\n- $|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|=3|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ 3 & =\\frac{|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|}{|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}|} \\\\ 3|\\begin{aligned}k & 3 \\\\ 7 & -2\\end{aligned}| & =|\\begin{aligned}k & 1 \\\\ 7 & 8\\end{aligned}|\\end{aligned}\n$$\n\nSo, the correct answer is \"II only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-139979/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d"] :knowledge-point/questions ["q-139979"] :db/ensure [:knowledge-point/validate]} {:db/id "q-139980/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "f6841765-839b-5b64-ac73-f1d9e8803280" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-139980/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "fac17c79-2646-5688-bc58-6463c17b16e6" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-139980/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "56d69701-aa4f-5ea7-99d1-e3fba7200fea" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-139980/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "18c90e41-ea84-57cb-aa01-4c0185ccd504" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-139980/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "d19da678-8cf3-55cd-b079-680f7875c73b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-139980/selection" :answer-field/id #uuid "625af731-231d-5b32-96bf-a3a4593269a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-139980/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-139980/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-139980/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-139980/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-139980/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-139980/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-139980" :question/id #uuid "1542c2d5-7499-5923-9d1a-47e26ee4c112" :question/math-academy-id "q-139980" :question/problem "Let $⟨x,-2⟩$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}15x+8y=-1 \\\\ kx+13y=-31.\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- $|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=2|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$\n- $|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=-4|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$\n- $-2|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|=|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|$" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\frac{{D}_{y}}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ -2 & =\\frac{|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|}{|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}|} \\\\ -2|\\begin{aligned}15 & 8 \\\\ k & 13\\end{aligned}| & =|\\begin{aligned}15 & -1 \\\\ k & -31\\end{aligned}|\\end{aligned}\n$$\n\nSo, the correct answer is \"III only\"." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-139980/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd9b0f65-d8a3-57c4-88c5-2738b0938c0d"] :knowledge-point/questions ["q-139980"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5230"] :question/problem "Consider the system of linear equations\n\n$$\n{\\begin{aligned}x-y=2 \\\\ 2x+y=1.\\end{aligned}\n$$\n\n \nAccording to Cramer's rule, the unknown $x$ can be written as\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057622/assets/2d3571405367c6d4ce15927a1dbdb50a30af7d13580c7b9cd3c73bada0583c98.png)\nExpress $D_x$ in terms of a $2 \\times 2$ determinant." :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}x-y=2 \\\\ 2x+y=1.\\end{aligned}\n$$\n\n \n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}|.\\end{aligned}\n$$\n\nNow, to construct $D_x$, we replace the first column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{x} & =|\\begin{aligned}2 & -1 \\\\ 1 & 1\\end{aligned}|\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4575"] :question/problem "Consider the system of equations \n\n$$\n{\\begin{aligned}5x+2y=-1 \\\\ -3x+3y=9.\\end{aligned}\n$$\n\nExpress $y$ in terms of $2 \\times 2$ determinants." :question/worked-solution "We are given the system\n\n$$\n{\\begin{aligned}5x+2y=-1 \\\\ -3x+3y=9.\\end{aligned}\n$$\n\nThe determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}5 & 2 \\\\ -3 & 3\\end{aligned}|.\\end{aligned}\n$$\n\nNow, to construct $D_y$, we replace the second column of the coefficient matrix by the right-hand side column of the given system:\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}5 & -1 \\\\ -3 & 9\\end{aligned}|\\end{aligned}\n$$\n\nFinally, according to Cramer's rule, we have\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D}=\\frac{|\\begin{aligned}5 & -1 \\\\ -3 & 9\\end{aligned}|}{|\\begin{aligned}5 & 2 \\\\ -3 & 3\\end{aligned}|}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-4578"] :question/problem "Let $\\langle x,3 \\rangle$ be the solution of the system of equations below. \n\n$$\n{\\begin{aligned}5x-2y=4 \\\\ x+ky=8\\end{aligned}\n$$\n\nWhich of the following equations could be solved to find the value of $k?$\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057622/assets/b82f5c43c9ec788b95e7213bef63eb37e4abf9d0159f92cbeedc0f64c4d35283.png)\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057622/assets/648ce0c1b8b77c1230c6c634c676624f9c79c12ffc3942abc09d24d0fdc424d3.png)\n\n- ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057622/assets/bc7a566778813050611b098cebe221aa77ac27677e922cd282fc8ff9c3670cfd.png)" :question/worked-solution "The determinant of the coefficient matrix is\n\n$$\n\\begin{aligned}D & =|\\begin{aligned}5 & -2 \\\\ 1 & k\\end{aligned}|.\\end{aligned}\n$$\n\nAccording to Cramer's rule, the value of $y$ is given by $y=\\dfrac{D_y}{D},$ where\n\n$$\n\\begin{aligned}{D}_{y} & =|\\begin{aligned}5 & 4 \\\\ 1 & 8\\end{aligned}| \\\\  & =5\\cdot 8-4\\cdot 1 \\\\  & =36.\\end{aligned}\n$$\n\nTherefore:\n\n$$\n\\begin{aligned}y & =\\frac{{D}_{y}}{D} \\\\ 3 & =\\frac{36}{|\\begin{aligned}5 & -2 \\\\ 1 & k\\end{aligned}|} \\\\ |\\begin{aligned}5 & -2 \\\\ 1 & k\\end{aligned}| & =12\\end{aligned}\n$$\n\nSo, the correct answer is \"II only\"." :db/ensure [:question/validate]}]
