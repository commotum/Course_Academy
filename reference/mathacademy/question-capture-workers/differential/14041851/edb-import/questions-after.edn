.$"}] [{:db/id #edb/ref 17592186176357 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f4dd399-17ba-5d5d-a947-9f9d97c58fc6" :answer/type {:db/ident :answer.type/math} :answer/value "148" :db/id #edb/ref 17592186174727} {:answer/id #uuid "91d2df24-cd40-51a6-ad1c-36ace1984565" :answer/type {:db/ident :answer.type/math} :answer/value "88" :db/id #edb/ref 17592186174728} {:answer/id #uuid "078faf97-fccc-5d7d-b441-d5f5a91ba9c8" :answer/type {:db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186174729} {:answer/id #uuid "356c94ec-fbbf-551d-970e-7d05c53a16e7" :answer/type {:db/ident :answer.type/math} :answer/value "111" :db/id #edb/ref 17592186174730} {:answer/id #uuid "79c9c1e4-dc41-55e4-8853-f413f78e314b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186174731}] :answer-field/correct {:answer/id #uuid "356c94ec-fbbf-551d-970e-7d05c53a16e7" :answer/type {:db/ident :answer.type/math} :answer/value "111" :db/id #edb/ref 17592186174730} :answer-field/id #uuid "68f5ca45-0719-56a4-9d9b-0c959b47bdb0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186174726}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c7aa456d-0ee8-5696-8091-d1aa1fc2aa26" :question/math-academy-id "q-2409" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=6{t}^{2}-2t.$ What is the total displacement of the particle between $t=1$ and $t=4?$" :question/requires-calculator true :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{4}(6{t}^{2}-2t)\\,\\text{d}t \\\\  & =(2{t}^{3}-{t}^{2}){|}_{1}^{4} \\\\  & =[2(4)^{3}-(4)^{2}]-[2(1)^{3}-(1)^{2}] \\\\  & =[128-16]-[2-1] \\\\  & =112-1 \\\\  & =111.\\end{aligned}\n$$\n\nSo the total displacement between $t=1$ and $t=4$ is $111.$"}] [{:db/id #edb/ref 17592186313662 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d6da01a2-7096-5398-a354-f0a049a45ca9" :answer/type {:db/ident :answer.type/math} :answer/value "505" :db/id #edb/ref 17592186313664} {:answer/id #uuid "46d0092a-58a8-5ae9-9579-1329976c9a1d" :answer/type {:db/ident :answer.type/math} :answer/value "522" :db/id #edb/ref 17592186313665} {:answer/id #uuid "c0f6b683-fc28-507f-917f-1d2309511b8c" :answer/type {:db/ident :answer.type/math} :answer/value "614" :db/id #edb/ref 17592186313666} {:answer/id #uuid "b4998c88-3576-54e3-96b0-bca5cfe0c6b3" :answer/type {:db/ident :answer.type/math} :answer/value "723" :db/id #edb/ref 17592186313667} {:answer/id #uuid "dda457dc-16e9-506a-8ff3-44789d1dc710" :answer/type {:db/ident :answer.type/math} :answer/value "494" :db/id #edb/ref 17592186313668}] :answer-field/correct {:answer/id #uuid "46d0092a-58a8-5ae9-9579-1329976c9a1d" :answer/type {:db/ident :answer.type/math} :answer/value "522" :db/id #edb/ref 17592186313665} :answer-field/id #uuid "69e392df-83c4-5a56-a1b3-33eba77f2001" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186313663}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b8f621e-5b34-573e-a1a6-210d53671902" :question/math-academy-id "q-2413" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=8{t}^{2}-3t.$ What is the total displacement of the particle between $t=0$ and $t=6?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{0}^{6}(8{t}^{2}-3t)\\,\\text{dt} \\\\  & ={(\\frac{8{t}^{3}}{3}-\\frac{3{t}^{2}}{2})|}_{0}^{6} \\\\  & =[\\frac{8(6)^{3}}{3}-\\frac{3(6)^{2}}{2}]-[\\frac{8(0)^{3}}{3}-\\frac{3(0)^{2}}{2}] \\\\  & =[576-54]-0 \\\\  & =522.\\end{aligned}\n$$\n\nSo the total displacement between $t=0$ and $t=6$ is $522.$"}] [{:db/id #edb/ref 17592186313669 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "254a9d74-38b4-5ebe-8b77-8afcd3ad5b85" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186313671} {:answer/id #uuid "160d4a42-78a6-52b3-af93-d1e22f019900" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186313672}] :answer-field/correct {:answer/id #uuid "160d4a42-78a6-52b3-af93-d1e22f019900" :answer/type {:db/ident :answer.type/math} :answer/value "2+\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186313672} :answer-field/id #uuid "a0c79e40-5b01-55dc-9e84-441be329e4a8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186313670}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ee94a036-61d7-5666-86c5-e1e7634b5926" :question/math-academy-id "q-348283" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{sin}⁡(t-\\frac{\\pi }{4}).$ At time $t=\\frac{\\pi }{4}$ the particle is located at the position $x=1.$ \nFind the position of the particle at time $t=\\pi .$ Do not round the answer.\n\nThe position of the particle at $t=\\pi $ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=\\pi $ is equal to its position at $t=\\frac{\\pi }{4}$ plus the total displacement over $t\\in [\\frac{\\pi }{4},\\pi ].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\pi )=x(\\frac{\\pi }{4})+{\\int }_{\\pi /4}^{\\pi }v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\pi ) & =1+{\\int }_{\\pi /4}^{\\pi }\\operatorname{sin}⁡(t-\\frac{\\pi }{4})\\,\\text{d}t \\\\  & =1+{[-\\operatorname{cos}⁡(t-\\frac{\\pi }{4})]}_{\\pi /4}^{\\pi } \\\\  & =1+([-\\operatorname{cos}⁡(\\pi -\\frac{\\pi }{4})]-[-\\operatorname{cos}⁡(\\frac{\\pi }{4}-\\frac{\\pi }{4})]) \\\\  & =1+(-\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\operatorname{cos}⁡(0)) \\\\  & =1+(-(-\\frac{\\sqrt{2}}{2})+1) \\\\  & =1+\\frac{\\sqrt{2}}{2}+1 \\\\  & =2+\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\pi $ is $x=2+\\frac{\\sqrt{2}}{2}.$"}] [{:db/id #edb/ref 17592186292191 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f41b1b34-f997-5d61-9acc-0574bcd388cf" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186292193}] :answer-field/correct {:answer/id #uuid "f41b1b34-f997-5d61-9acc-0574bcd388cf" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186292193} :answer-field/id #uuid "9d45bbc9-97c0-5571-9e73-7d150a54b469" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292192}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0bc88c45-b00a-5e19-9c3f-9d3e4f3af636" :question/math-academy-id "q-351421" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=6t+2.$ Find the total displacement $d$ of the particle between $t=1$ and $t=2.$\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=1$ and $t=2.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{2}(6t+2)\\,\\text{dt} \\\\  & =(3{t}^{2}+2t){|}_{1}^{2} \\\\  & =[3(2)^{2}+2(2)]-[3(1)^{2}+2(1)] \\\\  & =[12+4]-[3+2] \\\\  & =11.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292198 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5f0c57e2-a924-5441-b0e9-63ee697c5134" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186292200} {:answer/id #uuid "e5aee0df-8a58-552d-8045-3f53a3f9792d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186292201} {:answer/id #uuid "91bfed64-4a4a-51e1-b6b5-5a4fcc6e7970" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186313673}] :answer-field/correct {:answer/id #uuid "5f0c57e2-a924-5441-b0e9-63ee697c5134" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186292200} :answer-field/id #uuid "e7388b20-851e-58e2-85f6-179c4c96a52c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292199}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b821d35a-eba2-5209-a10b-30b5c53aa6ef" :question/math-academy-id "q-351431" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=\\frac{3}{2}\\sqrt{t-1}.$ Find the total displacement $d$ of the particle between $t=1$ and $t=5.$ Do not round the answer.\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=1$ and $t=5.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{5}(\\frac{3}{2}\\sqrt{t-1})\\,\\text{dt} \\\\  & =(t-1)^{3/2}\\,{|}_{1}^{5} \\\\  & =(5-1)^{3/2}-(1-1)^{3/2} \\\\  & =8-0 \\\\  & =8.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186313674 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1adcae9f-211c-544a-9b62-3e2237f7ddbd" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186313676}] :answer-field/correct {:answer/id #uuid "1adcae9f-211c-544a-9b62-3e2237f7ddbd" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186313676} :answer-field/id #uuid "bdff4d62-4486-5bfb-b624-1b8a8ef0f6c8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186313675}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6032fcdd-918e-5031-92ae-a4aba1f32f4c" :question/math-academy-id "q-351445" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)={sec}^{2}⁡(t).$ At time $t=0$ the particle is located at the position $x=-2.$ \nFind the position of the particle at time $t=\\frac{\\pi }{4}.$ Do not round the answer.\n\nThe position of the particle at $t=\\frac{\\pi }{4}$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{4}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{4}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{4})=x(0)+{\\int }_{0}^{\\pi /4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{4}) & =-2+{\\int }_{0}^{\\pi /4}{sec}^{2}⁡(t)\\,\\text{d}t \\\\  & =-2+{[\\operatorname{tan}⁡(t)]}_{0}^{\\pi /4} \\\\  & =-2+\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡(0) \\\\  & =-2+1-0 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\frac{\\pi }{4}$ is $x=-1.$"}] [{:db/id #edb/ref 17592186313677 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a52b41aa-89b5-5ed2-9c75-cbb2732e1af4" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186313679}] :answer-field/correct {:answer/id #uuid "a52b41aa-89b5-5ed2-9c75-cbb2732e1af4" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186313679} :answer-field/id #uuid "6440dcae-32ae-5cfc-bcf2-af7fba314d3e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186313678}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a0fdf1b5-7a2f-532e-9de1-59360bee3559" :question/math-academy-id "q-351463" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)={2}^{2t-1}\\operatorname{ln}⁡(2).$ At time $t=1$ the particle is located at the position $x=-5.$ \nFind the position of the particle at time $t=3.$ Do not round the answer.\n\nThe position of the particle at $t=3$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=3$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,3].$ Therefore, we can calculate it as follows:\n\n$$\nx(3)=x(1)+{\\int }_{1}^{3}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(3) & =-5+{\\int }_{1}^{3}({2}^{2t-1}\\operatorname{ln}⁡(2))\\,\\text{d}t \\\\  & =-5+{[{2}^{2t-2}]}_{1}^{3} \\\\  & =-5+{2}^{2(3)-2}-{2}^{2(1)-2} \\\\  & =-5+{2}^{4}-{2}^{0} \\\\  & =-5+16-1 \\\\  & =-5+15 \\\\  & =10.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=3$ is $x=10.$"}] [{:db/id #edb/ref 17592186313680 :knowledge-point/_questions [{:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23674bc9-cfa0-5690-8670-cdeda8a9fefb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313682}] :answer-field/correct {:answer/id #uuid "23674bc9-cfa0-5690-8670-cdeda8a9fefb" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186313682} :answer-field/id #uuid "46040562-07d6-5906-8961-4bd2336ae6fa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186313681}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8581a11a-e82d-5719-8003-6a34398d3c94" :question/math-academy-id "q-351501" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041851/assets/981252abc3668e62a5c9289c918d1231ec9a83745f70a00f0da4c85f194b8215.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=4,$ the particle is located at the position $x=-3.$ What is the position of the particle at time $t=7?$\n\nThe position of the particle at $t=7$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=4$ plus the total displacement over $t\\in [4,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(4)+{\\int }_{4}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(4)=-3$, and we can compute the integral ${\\int }_{4}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=4$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{4}^{7}v(t)\\,\\text{d}t=3.\n$$\n\nTherefore,\n\n$$\nx(7)=-3+3=0.\n$$\n\nSo the position of the particle at $t=7$ is $x=0.$"}] [{:db/id #edb/ref 17592186176420 :knowledge-point/_questions [{:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c10a7114-4c5c-5ba6-8bf6-fc3547656242" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186175063} {:answer/id #uuid "daa08098-ac00-5538-972f-6b7ba2ef4efd" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186175064} {:answer/id #uuid "dae2b7dc-d7df-5e25-b0c2-0e24ef6658df" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186175065} {:answer/id #uuid "2e9bf632-f90d-5bcc-9f60-de1b0980e1d4" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186175066} {:answer/id #uuid "7031fbf8-174f-5d5a-b871-8522e6511e16" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186175067}] :answer-field/correct {:answer/id #uuid "c10a7114-4c5c-5ba6-8bf6-fc3547656242" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186175063} :answer-field/id #uuid "4dadd49d-d78a-5902-a597-96389d3bb02b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186175062}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c60ee3fd-371a-5976-8618-8837667483d2" :question/math-academy-id "q-49319" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041851/assets/aad42b26d165789da802c0f507e3445976f3269b4c77e8b47201fb043b08f1f6.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0$ the particle is located at the position $x=6.$ What is the position of the particle at time $t=3?$" :question/worked-solution "The position of the particle at $t=3$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,3].$ Therefore, we can calculate it as follows:\n\n$$\nx(3)=x(0)+{\\int }_{0}^{3}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(0)=6$, and we can compute the integral ${\\int }_{0}^{3}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=0$ to $t=3.$ Computing the signed area, we get\n\n$$\n{\\int }_{0}^{3}v(t)\\,\\text{d}t=5.\n$$\n\nTherefore,\n\n$$\nx(3)=6+5=11\n$$\n\nSo the position of the particle at $t=3$ is $x=11.$"}] [{:db/id #edb/ref 17592186292214 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0270f788-1cdb-528c-85e3-c5e8dda56681" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186292216} {:answer/id #uuid "53db8982-8e73-5277-90aa-165c3b52a5d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}" :db/id #edb/ref 17592186292217} {:answer/id #uuid "a0ed76bd-8402-55cd-8079-0e89ab2fe6bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186292218} {:answer/id #uuid "c3f2dd82-6236-5f56-9bce-6792b0bf2373" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186292219} {:answer/id #uuid "237c114d-eacb-5eb4-8963-fe8655d0f624" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186292220}] :answer-field/correct {:answer/id #uuid "0270f788-1cdb-528c-85e3-c5e8dda56681" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{2}" :db/id #edb/ref 17592186292216} :answer-field/id #uuid "8c76b68b-b8cf-58ee-b229-494f9f0c8abc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292215}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "1394edaf-31dd-59b4-a755-2b8323ac548f" :question/math-academy-id "q-81506" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{cos}⁡(t-\\frac{\\pi }{6}).$ At time $t=0$ the particle is located at the position $x=3.$ What is the position of the particle at time $t=\\frac{\\pi }{6}?$" :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{6}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{6}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{6})=x(0)+{\\int }_{0}^{\\pi /6}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{6}) & =\\frac{7}{2}+{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(t-\\frac{\\pi }{6})\\,\\text{d}t \\\\  & =3+{[\\operatorname{sin}⁡(t-\\frac{\\pi }{6})]}_{0}^{\\pi /6} \\\\  & =3+([\\operatorname{sin}⁡(\\frac{\\pi }{6}-\\frac{\\pi }{6})]-[\\operatorname{sin}⁡(0-\\frac{\\pi }{6})]) \\\\  & =3+(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-\\frac{\\pi }{6})) \\\\  & =3+(0-(-\\frac{1}{2})) \\\\  & =3+\\frac{1}{2} \\\\  & =\\frac{7}{2}\\end{aligned}\n$$\n\nSo the position of the particle at $t=\\frac{\\pi }{6}$ is $x=\\frac{7}{2}.$"}] [{:db/id #edb/ref 17592186313683 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fae7284-2cbf-5315-bf4c-4c9799f9f879" :answer/type {:db/ident :answer.type/math} :answer/value "43" :db/id #edb/ref 17592186313685} {:answer/id #uuid "ddfc2c55-05ee-5a1b-998e-10e4eff4ab35" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186313686} {:answer/id #uuid "c4cf4617-8b5a-5043-998c-e851c4574159" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186313687} {:answer/id #uuid "0458457c-ef9b-59b1-818c-a58cd8e4d365" :answer/type {:db/ident :answer.type/math} :answer/value "54" :db/id #edb/ref 17592186313688} {:answer/id #uuid "57520984-6473-52e5-b50f-a8ad293a5cf9" :answer/type {:db/ident :answer.type/math} :answer/value "37" :db/id #edb/ref 17592186313689}] :answer-field/correct {:answer/id #uuid "ddfc2c55-05ee-5a1b-998e-10e4eff4ab35" :answer/type {:db/ident :answer.type/math} :answer/value "38" :db/id #edb/ref 17592186313686} :answer-field/id #uuid "7170c817-ac0b-5c5b-b51c-db14fb759730" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186313684}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2965e29b-870f-587a-8880-405fe07b35b2" :question/math-academy-id "q-84263" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=4\\sqrt[3]{t}-1.$ What is the total displacement of the particle between $t=1$ and $t=8?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{8}(4\\sqrt[3]{t}-1)\\text{d}t \\\\  & =(3{t}^{4/3}-t){|}_{1}^{8} \\\\  & =[3(8)^{4/3}-8]-[3(1)^{4/3}-1] \\\\  & =[48-8]-[3-1] \\\\  & =40-2 \\\\  & =38.\\end{aligned}\n$$\n\nSo the total displacement between $t=1$ and $t=8$ is $38.$"}]}
