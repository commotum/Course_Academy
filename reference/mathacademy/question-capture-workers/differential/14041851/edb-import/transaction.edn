[{:db/id "q-2413/selection/8256a1ce90ed9076f12dfb5cfd2ade552b6cadd03b5434a6336ea8202cc512f8" :answer/id #uuid "c0f6b683-fc28-507f-917f-1d2309511b8c" :answer/type :answer.type/math :answer/value "614" :db/ensure [:answer/validate]} {:db/id "q-2413/selection/daed1261cdad99b2dfafde0113422b1f66d8f17b07c3485bf41724aa74936d67" :answer/id #uuid "dda457dc-16e9-506a-8ff3-44789d1dc710" :answer/type :answer.type/math :answer/value "494" :db/ensure [:answer/validate]} {:db/id "q-2413/selection/355e362bcaada4e8a27915d6d1754af6b8f388b0798b509dc4534816b89cb31c" :answer/id #uuid "46d0092a-58a8-5ae9-9579-1329976c9a1d" :answer/type :answer.type/math :answer/value "522" :db/ensure [:answer/validate]} {:db/id "q-2413/selection/a5eaebfe7efedfe969fd054de629b57743e4da3f259075e46dad134b1b807e52" :answer/id #uuid "b4998c88-3576-54e3-96b0-bca5cfe0c6b3" :answer/type :answer.type/math :answer/value "723" :db/ensure [:answer/validate]} {:db/id "q-2413/selection/0d20dc7182a7cf369f6755616fc727b95e2cb28a5778459b960e0396f83d0312" :answer/id #uuid "d6da01a2-7096-5398-a354-f0a049a45ca9" :answer/type :answer.type/math :answer/value "505" :db/ensure [:answer/validate]} {:db/id "q-2413/selection" :answer-field/id #uuid "69e392df-83c4-5a56-a1b3-33eba77f2001" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2413/selection/355e362bcaada4e8a27915d6d1754af6b8f388b0798b509dc4534816b89cb31c" :answer-field/choices ["q-2413/selection/8256a1ce90ed9076f12dfb5cfd2ade552b6cadd03b5434a6336ea8202cc512f8" "q-2413/selection/daed1261cdad99b2dfafde0113422b1f66d8f17b07c3485bf41724aa74936d67" "q-2413/selection/355e362bcaada4e8a27915d6d1754af6b8f388b0798b509dc4534816b89cb31c" "q-2413/selection/a5eaebfe7efedfe969fd054de629b57743e4da3f259075e46dad134b1b807e52" "q-2413/selection/0d20dc7182a7cf369f6755616fc727b95e2cb28a5778459b960e0396f83d0312"] :db/ensure [:answer-field/validate]} {:db/id "q-2413" :question/id #uuid "6b8f621e-5b34-573e-a1a6-210d53671902" :question/math-academy-id "q-2413" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=8{t}^{2}-3t.$ What is the total displacement of the particle between $t=0$ and $t=6?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{0}^{6}(8{t}^{2}-3t)\\,\\text{dt} \\\\  & ={(\\frac{8{t}^{3}}{3}-\\frac{3{t}^{2}}{2})|}_{0}^{6} \\\\  & =[\\frac{8(6)^{3}}{3}-\\frac{3(6)^{2}}{2}]-[\\frac{8(0)^{3}}{3}-\\frac{3(0)^{2}}{2}] \\\\  & =[576-54]-0 \\\\  & =522.\\end{aligned}\n$$\n\nSo the total displacement between $t=0$ and $t=6$ is $522.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2413/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9"] :knowledge-point/questions ["q-2413"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351431/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "91bfed64-4a4a-51e1-b6b5-5a4fcc6e7970" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id 17592186292199 :answer-field/choices ["q-351431/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-84263/selection/2671fdc3a44bd3421ded09be4e881743067a96eb4e584e442a30f737593eae71" :answer/id #uuid "ddfc2c55-05ee-5a1b-998e-10e4eff4ab35" :answer/type :answer.type/math :answer/value "38" :db/ensure [:answer/validate]} {:db/id "q-84263/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "c4cf4617-8b5a-5043-998c-e851c4574159" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-84263/selection/2341d4beafc19cb7b8396e0b9f21c544ec7f6a786fc846e9361e36afd0b43437" :answer/id #uuid "8fae7284-2cbf-5315-bf4c-4c9799f9f879" :answer/type :answer.type/math :answer/value "43" :db/ensure [:answer/validate]} {:db/id "q-84263/selection/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b" :answer/id #uuid "57520984-6473-52e5-b50f-a8ad293a5cf9" :answer/type :answer.type/math :answer/value "37" :db/ensure [:answer/validate]} {:db/id "q-84263/selection/d6944c4d51ee6e8916d5e2815a8478bad91a2f9e9e9bcd499b503b9fbcb165ab" :answer/id #uuid "0458457c-ef9b-59b1-818c-a58cd8e4d365" :answer/type :answer.type/math :answer/value "54" :db/ensure [:answer/validate]} {:db/id "q-84263/selection" :answer-field/id #uuid "7170c817-ac0b-5c5b-b51c-db14fb759730" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84263/selection/2671fdc3a44bd3421ded09be4e881743067a96eb4e584e442a30f737593eae71" :answer-field/choices ["q-84263/selection/2671fdc3a44bd3421ded09be4e881743067a96eb4e584e442a30f737593eae71" "q-84263/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" "q-84263/selection/2341d4beafc19cb7b8396e0b9f21c544ec7f6a786fc846e9361e36afd0b43437" "q-84263/selection/f796ac21987d4f3153e3b546ba6f05903ec4f97c341f46f25a60fedd8588108b" "q-84263/selection/d6944c4d51ee6e8916d5e2815a8478bad91a2f9e9e9bcd499b503b9fbcb165ab"] :db/ensure [:answer-field/validate]} {:db/id "q-84263" :question/id #uuid "2965e29b-870f-587a-8880-405fe07b35b2" :question/math-academy-id "q-84263" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=4\\sqrt[3]{t}-1.$ What is the total displacement of the particle between $t=1$ and $t=8?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{8}(4\\sqrt[3]{t}-1)\\text{d}t \\\\  & =(3{t}^{4/3}-t){|}_{1}^{8} \\\\  & =[3(8)^{4/3}-8]-[3(1)^{4/3}-1] \\\\  & =[48-8]-[3-1] \\\\  & =40-2 \\\\  & =38.\\end{aligned}\n$$\n\nSo the total displacement between $t=1$ and $t=8$ is $38.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84263/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9"] :knowledge-point/questions ["q-84263"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-2409"] :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=6{t}^{2}-2t.$ What is the total displacement of the particle between $t=1$ and $t=4?$" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{4}(6{t}^{2}-2t)\\,\\text{d}t \\\\  & =(2{t}^{3}-{t}^{2}){|}_{1}^{4} \\\\  & =[2(4)^{3}-(4)^{2}]-[2(1)^{3}-(1)^{2}] \\\\  & =[128-16]-[2-1] \\\\  & =112-1 \\\\  & =111.\\end{aligned}\n$$\n\nSo the total displacement between $t=1$ and $t=4$ is $111.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-351445/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "1adcae9f-211c-544a-9b62-3e2237f7ddbd" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-351445/field-1" :answer-field/id #uuid "bdff4d62-4486-5bfb-b624-1b8a8ef0f6c8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351445/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-351445/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-351445" :question/id #uuid "6032fcdd-918e-5031-92ae-a4aba1f32f4c" :question/math-academy-id "q-351445" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)={sec}^{2}⁡(t).$ At time $t=0$ the particle is located at the position $x=-2.$ \nFind the position of the particle at time $t=\\frac{\\pi }{4}.$ Do not round the answer.\n\nThe position of the particle at $t=\\frac{\\pi }{4}$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{4}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{4}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{4})=x(0)+{\\int }_{0}^{\\pi /4}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{4}) & =-2+{\\int }_{0}^{\\pi /4}{sec}^{2}⁡(t)\\,\\text{d}t \\\\  & =-2+{[\\operatorname{tan}⁡(t)]}_{0}^{\\pi /4} \\\\  & =-2+\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡(0) \\\\  & =-2+1-0 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\frac{\\pi }{4}$ is $x=-1.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351445/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-351445"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348283/field-1/d9292ba94958ded11ff8e7592ec89dfd6320d6785f4fa9ed02c9a20d60fb9c18" :answer/id #uuid "160d4a42-78a6-52b3-af93-d1e22f019900" :answer/type :answer.type/math :answer/value "2+\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-348283/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "254a9d74-38b4-5ebe-8b77-8afcd3ad5b85" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-348283/field-1" :answer-field/id #uuid "a0c79e40-5b01-55dc-9e84-441be329e4a8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348283/field-1/d9292ba94958ded11ff8e7592ec89dfd6320d6785f4fa9ed02c9a20d60fb9c18" :answer-field/choices ["q-348283/field-1/d9292ba94958ded11ff8e7592ec89dfd6320d6785f4fa9ed02c9a20d60fb9c18" "q-348283/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-348283" :question/id #uuid "ee94a036-61d7-5666-86c5-e1e7634b5926" :question/math-academy-id "q-348283" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{sin}⁡(t-\\frac{\\pi }{4}).$ At time $t=\\frac{\\pi }{4}$ the particle is located at the position $x=1.$ \nFind the position of the particle at time $t=\\pi .$ Do not round the answer.\n\nThe position of the particle at $t=\\pi $ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=\\pi $ is equal to its position at $t=\\frac{\\pi }{4}$ plus the total displacement over $t\\in [\\frac{\\pi }{4},\\pi ].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\pi )=x(\\frac{\\pi }{4})+{\\int }_{\\pi /4}^{\\pi }v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\pi ) & =1+{\\int }_{\\pi /4}^{\\pi }\\operatorname{sin}⁡(t-\\frac{\\pi }{4})\\,\\text{d}t \\\\  & =1+{[-\\operatorname{cos}⁡(t-\\frac{\\pi }{4})]}_{\\pi /4}^{\\pi } \\\\  & =1+([-\\operatorname{cos}⁡(\\pi -\\frac{\\pi }{4})]-[-\\operatorname{cos}⁡(\\frac{\\pi }{4}-\\frac{\\pi }{4})]) \\\\  & =1+(-\\operatorname{cos}⁡(\\frac{3\\pi }{4})+\\operatorname{cos}⁡(0)) \\\\  & =1+(-(-\\frac{\\sqrt{2}}{2})+1) \\\\  & =1+\\frac{\\sqrt{2}}{2}+1 \\\\  & =2+\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\pi $ is $x=2+\\frac{\\sqrt{2}}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-348283/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-348283"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351463/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "a52b41aa-89b5-5ed2-9c75-cbb2732e1af4" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-351463/field-1" :answer-field/id #uuid "6440dcae-32ae-5cfc-bcf2-af7fba314d3e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351463/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-351463/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-351463" :question/id #uuid "a0fdf1b5-7a2f-532e-9de1-59360bee3559" :question/math-academy-id "q-351463" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)={2}^{2t-1}\\operatorname{ln}⁡(2).$ At time $t=1$ the particle is located at the position $x=-5.$ \nFind the position of the particle at time $t=3.$ Do not round the answer.\n\nThe position of the particle at $t=3$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=3$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,3].$ Therefore, we can calculate it as follows:\n\n$$\nx(3)=x(1)+{\\int }_{1}^{3}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(3) & =-5+{\\int }_{1}^{3}({2}^{2t-1}\\operatorname{ln}⁡(2))\\,\\text{d}t \\\\  & =-5+{[{2}^{2t-2}]}_{1}^{3} \\\\  & =-5+{2}^{2(3)-2}-{2}^{2(1)-2} \\\\  & =-5+{2}^{4}-{2}^{0} \\\\  & =-5+16-1 \\\\  & =-5+15 \\\\  & =10.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=3$ is $x=10.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351463/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-351463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121021/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "91910ea5-90f3-59cb-9d33