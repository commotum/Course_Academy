[{:db/id "q-130671/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "8d16ec67-6a8f-5dd9-b23a-de08f2f57d14" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-130671/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "f91f34e3-2389-5e61-849e-d29577efef65" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-130671/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "2c12d868-abdc-5533-a8ee-f96e4d1e0359" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-130671/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "72f1d168-88f9-50fc-ab42-d347f60ce5d3" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-130671/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "23ab976c-a6c8-514a-b253-c04885273eb3" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-130671/selection" :answer-field/id #uuid "c8ba8465-316c-534e-95d1-d3398ee9789c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130671/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-130671/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-130671/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-130671/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-130671/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-130671/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-130671" :question/id #uuid "3e02d60f-4fa6-583c-af1a-2b15f3ba4c02" :question/math-academy-id "q-130671" :question/problem "Which of the following second-order differential equations are linear?\n\n- $(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2$\n- ${y}^{3}{y}^{″}+x{y}^{′}-xy=0$\n- $\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n(\\operatorname{ln}⁡x){y}^{″}-x{y}^{′}+y=2\n$$\n\nis a second-order linear ODE with $a(x)=\\operatorname{ln}⁡x,b(x)=-x,c(x)=1,$ and $f(x)=2.$\n\n- The equation\n\n$$\n{y}^{3}{y}^{″}+x{y}^{′}-xy=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${y}^{3}{y}^{″}.$\n\n- The equation\n\n$$\n\\frac{1}{x}{y}^{″}+xy{y}^{′}+{x}^{2}y={e}^{x}\n$$\n\nis **NOT** linear because it contains the nonlinear term $xy{y}^{′}.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130671/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4"] :knowledge-point/questions ["q-130671"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130675/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "d864a1be-7032-5c3a-b185-ee874f9a65b5" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-130675/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "f3a746e8-52d1-5a04-bba5-327b860e9106" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-130675/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "d6c69b78-4c10-56a9-a669-f96e1a554d28" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-130675/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "ca57bdf7-1a3c-57f2-85f2-723c4a9b864a" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-130675/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "3e81ce27-b077-5b33-8b4d-e53f5d7bc5ae" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-130675/selection" :answer-field/id #uuid "d52c0b07-90f8-5624-8c46-8cc2e627366a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130675/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-130675/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-130675/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-130675/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-130675/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-130675/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-130675" :question/id #uuid "da59e353-90f8-5631-b467-4aff835f19bc" :question/math-academy-id "q-130675" :question/problem "Which of the following second-order differential equations are linear?\n\n- ${e}^{2y}{y}^{″}-{x}^{2}{y}^{′}+3=0$\n- ${e}^{x}{y}^{″}+4{y}^{′}-x\\operatorname{sin}⁡x=2$\n- ${y}^{″}-2x{y}^{′}+5y=x$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n{e}^{2y}{y}^{″}-{x}^{2}{y}^{′}+3=0\n$$\n\nis **NOT** linear because it contains the nonlinear term ${e}^{2y}{y}^{″}.$\n\n- The equation\n\n$$\n{e}^{x}{y}^{″}+4{y}^{′}-x\\operatorname{sin}⁡x=2\n$$\n\nis a second-order linear ODE with $a(x)={e}^{x},b(x)=4,c(x)=0,$ and $f(x)=2+x\\operatorname{sin}⁡x.$\n\n- The equation\n\n$$\n{y}^{″}-2x{y}^{′}+5y=x\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=-2x,c(x)=5,$ and $f(x)=x.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130675/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4"] :knowledge-point/questions ["q-130675"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93715/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "71363472-5521-5444-b405-94901448a188" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-93715/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "a55ec0a2-6bbb-5d2a-84f9-f7e48321295f" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-93715/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "d7898511-4336-55dd-af09-f5f8afe6bf87" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-93715/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "b8d1aeee-2739-5c4a-baf5-3b627075fc06" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-93715/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "acee5be6-190f-5ed5-a9ae-b82b3fcdd16e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-93715/selection" :answer-field/id #uuid "c62fa06c-cdaa-5805-9e78-7d3c1e1345a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93715/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-93715/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-93715/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-93715/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-93715/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-93715/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-93715" :question/id #uuid "166fcd62-ada1-5a0c-a703-fe872e3fc63c" :question/math-academy-id "q-93715" :question/problem "Which of the following second-order differential equations are linear?\n\n- ${y}^{″}-x{y}^{′}+y=\\operatorname{cos}⁡x$\n- ${y}^{″}+y{y}^{′}=0$\n- $\\frac{1}{y}{y}^{″}+y=x$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n{y}^{″}-x{y}^{′}+y=\\operatorname{cos}⁡x\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=-x,c(x)=1,$ and $f(x)=\\operatorname{cos}⁡x.$\n\n- The equation\n\n$$\n{y}^{″}+y{y}^{′}=0\n$$\n\nis **NOT** linear because it contains the nonlinear term $y{y}^{′}.$\n\n- The equation\n\n$$\n\\frac{1}{y}{y}^{″}+y=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $\\frac{1}{y}{y}^{″}.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93715/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4"] :knowledge-point/questions ["q-93715"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93721/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "796af2d8-3cb3-5bf0-9137-370ed0d9102b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-93721/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "e65b145a-16e6-5f2a-aaf7-4f776e4acff0" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-93721/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "7d866803-b1f6-5fe1-bbea-38c8c0b7bbcc" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-93721/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "945961fe-2c6d-529c-87e0-7ab2efe873bb" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-93721/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "49d4357e-5d94-57d3-bf28-de364df8aa32" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-93721/selection" :answer-field/id #uuid "6d4ced10-83a3-51c8-9db0-13b6654e303b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93721/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-93721/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-93721/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-93721/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-93721/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-93721/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-93721" :question/id #uuid "01fc92bc-36e8-54db-9a2e-368326538d04" :question/math-academy-id "q-93721" :question/problem "Which of the following second-order differential equations are linear?\n\n- $2{y}^{2}{y}^{″}-{e}^{x}{y}^{′}=x$\n- $\\frac{1}{x}{y}^{″}+{y}^{′}-(\\operatorname{sin}⁡x)y=\\operatorname{cos}⁡x$\n- ${y}^{″}+17y=2x\\operatorname{sin}⁡x$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation\n\n$$\n2{y}^{2}{y}^{″}-{e}^{x}{y}^{′}=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $2{y}^{2}{y}^{″}.$\n\n- The equation\n\n$$\n\\frac{1}{x}{y}^{″}+{y}^{′}-(\\operatorname{sin}⁡x)y=\\operatorname{cos}⁡x\n$$\n\nis a second-order linear ODE with $a(x)=\\frac{1}{x},b(x)=1,c(x)=-\\operatorname{sin}⁡x,$ and $f(x)=\\operatorname{cos}⁡x.$\n\n- The equation\n\n$$\n{y}^{″}+17y=2x\\operatorname{sin}⁡x\n$$\n\nis a second-order linear ODE with $a(x)=1,b(x)=0,c(x)=17,$ and $f(x)=2x\\operatorname{sin}⁡x.$\n\nTherefore, the correct answer is \"II and III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93721/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4"] :knowledge-point/questions ["q-93721"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338102/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "47bad2b8-8d3e-57d6-82b3-2c3439f672a1" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-338102/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "7558911d-9966-59ef-82bc-a27c1567a02c" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-338102/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "35ff67c9-ece9-59f1-8612-b8e2b3c84de4" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-338102/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "7aca29ef-7d33-5dd9-8aa3-21f2f8e57080" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-338102/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6da61333-a591-52aa-9ef7-07f3e1c29e8b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-338102/selection" :answer-field/id #uuid "6626197e-a518-52e5-8075-49de48d89a58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-338102/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-338102/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-338102/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-338102/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-338102/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-338102/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-338102" :question/id #uuid "63a0e75a-e8ed-5555-a126-d694412fb15f" :question/math-academy-id "q-338102" :question/problem "Which of the following second-order differential equations are linear?\n\n- $x{y}^{″}+y={x}^{2}$\n- $y{y}^{″}+{y}^{′}=x$\n- $5{y}^{″}-{x}^{2}{y}^{′}+7{y}^{2}=x$" :question/worked-solution "А second-order linear differential equation has the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nLet's look at each equation in turn.\n\n- The equation \n\n$$\nx{y}^{″}+y={x}^{2}\n$$\n\nis a second-order linear ODE with $a(x)=x,b(x)=0,c(x)=1,$ and $f(x)={x}^{2}.$\n\n- The equation \n\n$$\ny{y}^{″}+{y}^{′}=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $y{y}^{″}.$\n\n- The equation \n\n$$\n5{y}^{″}-{x}^{2}{y}^{′}+7{y}^{2}=x\n$$\n\nis **NOT** linear because it contains the nonlinear term $7{y}^{2}.$\n\nTherefore, the correct answer is \"I only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-338102/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9a926134-0870-5528-985d-2c92e71158f4"] :knowledge-point/questions ["q-338102"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186149794 :answer-field/correct 17592186149795 :db/ensure [:answer-field/validate]} {:db/id 17592186149791 :answer-field/correct 17592186149792 :db/ensure [:answer-field/validate]} {:db/id 17592186149788 :answer-field/correct 17592186149790 :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-337919"] :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.\n$\\,$ The equation $\\,\\operatorname{sin}⁡(x){y}^{″}-x{y}^{′}+y=0$ is {{field-1}}. \n\n$\\,$ The equation $\\,{y}^{″}+2{y}^{′}+y=2$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}+xy-2x=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n\\operatorname{sin}⁡(x){y}^{″}-x{y}^{′}+y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}+2{y}^{′}+y=2\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=2,$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}+xy-2x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}+xy=2x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=2x,$ which is different from zero." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-337996/field-1/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "e16c05fe-b3a8-50d5-ab83-3f44716c3fc8" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-337996/field-1/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "0755616e-8d6f-50ce-82cd-8c3124d45f72" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-337996/field-1" :answer-field/id #uuid "64dfac85-867c-5d93-abdd-a093526fff34" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-337996/field-1/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer-field/choices ["q-337996/field-1/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" "q-337996/field-1/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7"] :db/ensure [:answer-field/validate]} {:db/id "q-337996/field-2/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "42384a7c-cd2c-5e84-97e8-1be0ef4192ab" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-337996/field-2/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "2e727099-ce63-54df-b3c8-6be4852bed67" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-337996/field-2" :answer-field/id #uuid "c2a7bfec-c698-5162-9d1d-70b6585ae610" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-337996/field-2/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer-field/choices ["q-337996/field-2/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-337996/field-2/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :db/ensure [:answer-field/validate]} {:db/id "q-337996/field-3/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "8e407a07-7097-5845-9355-c9ad8823438e" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-337996/field-3/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "c916f550-13d3-5b42-9796-6f02c236fda7" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-337996/field-3" :answer-field/id #uuid "fee27974-b815-5e20-b40c-bd897c398114" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-337996/field-3/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer-field/choices ["q-337996/field-3/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-337996/field-3/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :db/ensure [:answer-field/validate]} {:db/id "q-337996" :question/id #uuid "7fc00c12-63c8-559a-aa45-1b909350bd43" :question/math-academy-id "q-337996" :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.\n\n$\\,$ The equation $\\,{y}^{″}+5{y}^{′}+6y=7$ is {{field-1}}. \n\n$\\,$ The equation $\\,\\operatorname{ln}⁡(x){y}^{″}+(1-x){y}^{′}-4y=0$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}+xy+{x}^{3}=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n{y}^{″}+5{y}^{′}+6y=7\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=7,$ which is different from zero.\n\n- The equation\n\n$$\n\\operatorname{ln}⁡(x){y}^{″}+(1-x){y}^{′}-4y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- Writing the equation\n\n$$\n{y}^{″}+xy+{x}^{3}=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}+xy=-{x}^{3}.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-{x}^{3},$ which is different from zero." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337996/field-1" "q-337996/field-2" "q-337996/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90930e15-0827-5e0b-82cf-98263fc756d6"] :knowledge-point/questions ["q-337996"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186149803 :answer-field/correct 17592186149804 :db/ensure [:answer-field/validate]} {:db/id 17592186149797 :answer-field/correct 17592186149798 :db/ensure [:answer-field/validate]} {:db/id 17592186149800 :answer-field/correct 17592186149801 :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-337990"] :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.$\\,$ The equation $\\,{x}^{2}{y}^{″}+3x{y}^{′}-y=0$ is {{field-1}}. \n\n$\\,$ The equation $\\,{y}^{″}-{y}^{′}+y={e}^{x}$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}+{x}^{2}y+x=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n{x}^{2}{y}^{″}+3x{y}^{′}-y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}-{y}^{′}+y={e}^{x}\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)={e}^{x},$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}+{x}^{2}y+x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}+{x}^{2}y=-x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-x,$ which is different from zero." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-338006/field-1/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "0da2ec0d-7545-5eef-bd82-4770331113cc" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-338006/field-1/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "1f45c620-91e3-5ed3-b3de-eb8a83dbdf6c" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338006/field-1" :answer-field/id #uuid "2a0d79aa-fe53-5b28-9a0a-b22988e07e52" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-338006/field-1/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer-field/choices ["q-338006/field-1/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338006/field-1/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :db/ensure [:answer-field/validate]} {:db/id "q-338006/field-2/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "f3e93038-f923-5254-8c9c-b06ec0b21d0e" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-338006/field-2/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "4da11eb8-a953-5e26-b6de-d746d7ecc41e" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338006/field-2" :answer-field/id #uuid "6be2fc62-3d43-58ab-bbde-3aa171f03137" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-338006/field-2/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer-field/choices ["q-338006/field-2/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" "q-338006/field-2/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9"] :db/ensure [:answer-field/validate]} {:db/id "q-338006/field-3/668dba9073658905cfbd208ef398f