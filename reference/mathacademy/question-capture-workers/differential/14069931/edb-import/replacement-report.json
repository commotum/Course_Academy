    {
      "question": "e-21694",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "fe074666f5b4e9caddbe8400eaff71dc7962739fe16ce01f580a56a430a1b6ae",
      "new_sha256": "87cf975a8fe92ce098b0fbb541294d6658ca63379bad90703b3eed79953cce3a",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-21694",
          "field": null,
          "attribute": "question/worked-solution",
          "value": "After shifting a system, the geometric structure of the vector field is preserved. In particular, each nullcline is translated but retains its orientation, meaning its slope does not change.\n\nBecause the equilibrium is moved to the origin by the shift, the translated nullclines must pass through the origin in the shifted coordinates.\n\nThus, the nullclines of the shifted system pass through the origin and have the same slopes as the corresponding nullclines of the original system.\n\nAmong the given options, the only line that satisfied the above conditions is $y=3x.$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069931/example-21694.json",
          "file_sha256": "eecf132512bc191eaf5afa8330afe7da65a16e1cead6482883817d034eb69706"
        }
