acb590e04858a6bb63f3f2ba9e371dc1673f0601bdb0783a5fa2703" "q-342501/field-2/51505f6b69f25ccca773ba3bd45ef80b5967f483db38098d1706f255180edb2c" "q-342501/field-2/656a365f6dc86522400a89cde0615cee338ff537c856d5577e29d498d362e9c2"] :db/ensure [:answer-field/validate]} {:db/id "q-342501/field-3/f8b558415ee9e1d19bc3a373bfe5de97e8647e000136748706ae3d06d0a63701" :answer/id #uuid "01061cf2-5097-5d05-b4dc-4910c8b171cc" :answer/type :answer.type/math :answer/value "{e}^{t}-{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-3/410bc6f13bb3bd7b9426ed32d54349311ab775e113b905720b2d7c45ab3a98d7" :answer/id #uuid "435e3789-586d-5ba7-9440-d5cd2b83aae7" :answer/type :answer.type/math :answer/value "-{e}^{-t}+{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-3/bffb85f9f5e6aefef4dc534fbe4a40998bd0467a460a66269708d22b287fa088" :answer/id #uuid "a8f73324-b7af-53c5-94b7-0f668e00a131" :answer/type :answer.type/math :answer/value "{e}^{-t}-{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-3/a20169bd3e3a79dade3ba771afe4137158a56223e513142308079af2d50e7bd4" :answer/id #uuid "41adf22a-e739-5846-84a4-1e466d05e62f" :answer/type :answer.type/math :answer/value "-{e}^{t}+{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-3" :answer-field/id #uuid "83094b09-cfcb-5a40-82e0-b98be7510e59" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-342501/field-3/f8b558415ee9e1d19bc3a373bfe5de97e8647e000136748706ae3d06d0a63701" :answer-field/choices ["q-342501/field-3/f8b558415ee9e1d19bc3a373bfe5de97e8647e000136748706ae3d06d0a63701" "q-342501/field-3/410bc6f13bb3bd7b9426ed32d54349311ab775e113b905720b2d7c45ab3a98d7" "q-342501/field-3/bffb85f9f5e6aefef4dc534fbe4a40998bd0467a460a66269708d22b287fa088" "q-342501/field-3/a20169bd3e3a79dade3ba771afe4137158a56223e513142308079af2d50e7bd4"] :db/ensure [:answer-field/validate]} {:db/id "q-342501" :question/id #uuid "fb48c3d2-004e-5e70-aa77-14e4f91382fc" :question/math-academy-id "q-342501" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+3y=4{e}^{t},\\,y(0)=0\n$$\n\nSelect the correct options in the reasoning below to find the solution using Laplace transforms.\n\nLet $Y(s)=L{y(t)}.$ Taking the Laplace transform of both sides of the equation and solving for $Y,$ we have\n\n$$\nY(s)={{field-1}}.\n$$\n\nThe partial fraction decomposition of $Y$ is\n\n$$\nY(s)={{field-2}}.\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)={{field-3}}.\n$$" :question/worked-solution "First, we take the Laplace transform of both sides of the differential equation. Using the linearity property, we have\n\n$$\nL{{y}^{′}}+3L{y}=L{4{e}^{t}}.\n$$\n\nUsing the formula for the transform of a derivative, $L{{y}^{′}}=sY(s)-y(0),$ and the standard transform \n\n$$\nL{{e}^{at}}=\\frac{1}{s-a},\\,s>a,\n$$\n\n \nwe substitute the known values.\n\n$$\n\\begin{aligned}sY(s)-0+3Y(s) & =4\\cdot \\frac{1}{s-1} \\\\ (s+3)Y(s) & =\\frac{4}{s-1}.\\end{aligned}\n$$\n\nSolving for $Y(s),$ we have\n\n$$\nY(s)=\\frac{4}{(s-1)(s+3)}.\n$$\n\nNext, we perform a partial fraction decomposition. We write $Y(s)$ in the form\n\n$$\n\\frac{4}{(s-1)(s+3)}=\\frac{A}{s-1}+\\frac{B}{s+3}.\n$$\n\nTo find the constants $A$ and $B,$ we first clear the denominators:\n\n$$\n4=A(s+3)+B(s-1)\n$$\n\nNow, we find the constants $A$ and $B.$\n\n- Setting $s=1,$ we have\n\n$$\n4=A(1+3)+B(0)\\,⟹\\,4=4A\\,⟹\\,A=1.\n$$\n\n- Setting $s=-3,$ we have\n\n$$\n4=A(0)+B(-3-1)\\,⟹\\,4=-4B\\,⟹\\,B=-1.\n$$\n\nThus, the decomposition is\n\n$$\nY(s)=\\frac{1}{s-1}-\\frac{1}{s+3}.\n$$\n\nFrom the table of Laplace transforms, we have:\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s-1}} & ={e}^{t} \\\\ {L}^{-1}{\\frac{1}{s+3}} & ={e}^{-3t}\\end{aligned}\n$$\n\nFinally, taking the inverse Laplace transform of $Y(s),$ we get\n\n$$\n\\begin{aligned}y(t) & ={L}^{-1}{\\frac{1}{s-1}}-{L}^{-1}{\\frac{1}{s+3}} \\\\ y(t) & ={e}^{t}-{e}^{-3t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342501/field-1" "q-342501/field-2" "q-342501/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5eae6b5d-adff-53b2-970d-f0dcee58365f"] :knowledge-point/questions ["q-342501"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342704/field-1/8ecae7369992bc9205247d11a3c3afa2084e510db25cf688a84acee90ce496ac" :answer/id #uuid "5eb7aa20-fb14-5fc5-aedc-da5bd932c547" :answer/type :answer.type/math :answer/value "\\frac{2s+4}{{s}^{2}(s+1)}" :db/ensure [:answer/validate]} {:db/id "q-342704/field-1/1d7429b948ee0a76ebc9cd5be1c2b95d6b3b1a601f2c94e7f04b701d589108bf" :answer/id #uuid "eda4638b-0eb4-500a-abb3-ffc275469746" :answer/type :answer.type/math :answer/value "\\frac{4s+2}{{s}^{2}(s+1)}" :db/ensure [:answer/validate]} {:db/id "q-342704/field-1/b8ba1a97b73ffba368100d4cec90f2e3600047723a34230fdb9b9d0acbfcea5a" :answer/id #uuid "998d2bcc-ba6a-5458-bc5d-692ff6791ee0" :answer/type :answer.type/math :answer/value "\\frac{4s+2}{s(s+1)}" :db/ensure [:answer/validate]} {:db/id "q-342704/field-1/5dcb17f25ed4c8098cabe7829381220a96e4b1f388aa58cddde50cd6c3dd3704" :answer/id #uuid "2ebfb6d4-a39f-5714-a5c8-e1938b3dbf38" :answer/type :answer.type/math :answer/value "\\frac{4s-2}{{s}^{2}(s+1)}" :db/ensure [:answer/validate]} {:db/id "q-342704/field-1/c2dcf9ac7fa719d1b3ebd27d54a9e1e61100d0f0acf1501fabe964f92fd44231" :answer/id #uuid "66b5116a-464e-5ebb-9cab-4afe1ef827c2" :answer/type :answer.type/math :answer/value "\\frac{4s+2}{{s}^{2}(s-1)}" :db/ensure [:answer/validate]} {:db/id "q-342704/field-1" :answer-field/id #uuid "274fc8d2-782a-5024-983d-e20fde8913f7" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-342704/field-1/1d7429b948ee0a76ebc9cd5be1c2b95d6b3b1a601f2c94e7f04b701d589108bf" :answer-field/choices ["q-342704/field-1/8ecae7369992bc9205247d11a3c3afa2084e510db25cf688a84acee90ce496ac" "q-342704/field-1/1d7429b948ee0a76ebc9cd5