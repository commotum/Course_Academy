1a3b2124584a87ddbbdb3a8b69638f4d606bf2413f3f6457d" "q-342499/field-2/e95ad45d6e0974adad608685f1d74e7915530dac11e37c8db8a556d1b61db9bf" "q-342499/field-2/82a757d6711b9ea079e4de8f839117fddc1e1f87afc0e620fd132198e94ce7e5" "q-342499/field-2/8f8c83d9871634d058e8cd1cdea3c60444a7710f363e7c5b949c0ebc7e9446c3"] :db/ensure [:answer-field/validate]} {:db/id "q-342499/field-3/38e2962f4f38159758e8fd955c774eb27e269c477a05734573da4fe6047055ed" :answer/id #uuid "9246a9de-6158-532d-9e69-302541aa845e" :answer/type :answer.type/math :answer/value "\\frac{9}{8}{e}^{3t}-\\frac{9}{8}{e}^{-5t}" :db/ensure [:answer/validate]} {:db/id "q-342499/field-3/c9398c10d52dbe57c06e532bee3da4a8b2b658d201f3b90c8a7bf4875345dd1e" :answer/id #uuid "d19f32dc-bee3-5872-bf86-62812ad6669a" :answer/type :answer.type/math :answer/value "\\frac{9}{8}{e}^{-3t}-\\frac{9}{8}{e}^{5t}" :db/ensure [:answer/validate]} {:db/id "q-342499/field-3/487c087a5704bed391b13f62f4a5fe9ccbec5423a2337d49b9ca517ced32a6c9" :answer/id #uuid "17621032-b8b2-51bd-a757-861960e83a04" :answer/type :answer.type/math :answer/value "-\\frac{9}{8}{e}^{3t}+\\frac{9}{8}{e}^{-5t}" :db/ensure [:answer/validate]} {:db/id "q-342499/field-3/793a3dbc25947b9df3d4863491f9f3f34b2467dfa552869028bf2b3d61e28a47" :answer/id #uuid "927b4f87-2f3b-5f08-a7fd-79f03026c778" :answer/type :answer.type/math :answer/value "-\\frac{9}{8}{e}^{-3t}+\\frac{9}{8}{e}^{5t}" :db/ensure [:answer/validate]} {:db/id "q-342499/field-3" :answer-field/id #uuid "ce562a5b-66d9-54ee-931c-8a87cff182fc" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-342499/field-3/38e2962f4f38159758e8fd955c774eb27e269c477a05734573da4fe6047055ed" :answer-field/choices ["q-342499/field-3/38e2962f4f38159758e8fd955c774eb27e269c477a05734573da4fe6047055ed" "q-342499/field-3/c9398c10d52dbe57c06e532bee3da4a8b2b658d201f3b90c8a7bf4875345dd1e" "q-342499/field-3/487c087a5704bed391b13f62f4a5fe9ccbec5423a2337d49b9ca517ced32a6c9" "q-342499/field-3/793a3dbc25947b9df3d4863491f9f3f34b2467dfa552869028bf2b3d61e28a47"] :db/ensure [:answer-field/validate]} {:db/id "q-342499" :question/id #uuid "31e8084f-ab1a-5236-ac36-9b6a9937b2ed" :question/math-academy-id "q-342499" :question/problem "Consider the following initial value problem.\n\n$$\n\\frac{\\text{d}y}{\\text{d}t}+5y=9{e}^{3t},\\,y(0)=0\n$$\n\nSelect the correct options in the reasoning below to find the solution using Laplace transforms.\n\nLet $Y(s)=L{y(t)}.$ Taking the Laplace transform of both sides of the equation and solving for $Y,$ we have\n\n$$\nY(s)={{field-1}}.\n$$\n\nThe partial fraction decomposition of $Y$ is\n\n$$\nY(s)={{field-2}}.\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)={{field-3}}.\n$$" :question/worked-solution "First, we take the Laplace transform of both sides of the differential equation. Using the linearity property, we have\n\n$$\nL{{y}^{′}}+5L{y}=L{9{e}^{3t}}.\n$$\n\nUsing the formula for the transform of a derivative, $L{{y}^{′}}=sY(s)-y(0),$ and the standard transform \n\n$$\nL{{e}^{at}}=\\frac{1}{s-a},\\,s>a,\n$$\n\n \nwe substitute the known values.\n\n$$\n\\begin{aligned}sY(s)-0+5Y(s) & =9\\cdot \\frac{1}{s-3} \\\\ (s+5)Y(s) & =\\frac{9}{s-3}.\\end{aligned}\n$$\n\nSolving for $Y(s),$ we have\n\n$$\nY(s)=\\frac{9}{(s-3)(s+5)}.\n$$\n\nNext, we perform a partial fraction decomposition. We write $Y(s)$ in the form\n\n$$\n\\frac{9}{(s-3)(s+5)}=\\frac{A}{s-3}+\\frac{B}{s+5}.\n$$\n\nTo find the constants $A$ and $B,$ we first clear the denominators:\n\n$$\n9=A(s+5)+B(s-3)\n$$\n\nNow, we find the constants $A$ and $B.$\n\n- Setting $s=3,$ we have\n\n$$\n9=A(3+5)+B(0)\\,⟹\\,9=8A\\,⟹\\,A=\\frac{9}{8}.\n$$\n\n- Setting $s=-5,$ we have\n\n$$\n9=A(0)+B(-5-3)\\,⟹\\,9=-8B\\,⟹\\,B=-\\frac{9}{8}.\n$$\n\nThus, the decomposition is\n\n$$\nY(s)=\\frac{9}{8(s-3)}-\\frac{9}{8(s+5)}.\n$$\n\nFrom the table of Laplace transforms, we have:\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s-3}} & ={e}^{3t} \\\\ {L}^{-1}{\\frac{1}{s+5}} & ={e}^{-5t}\\end{aligned}\n$$\n\nFinally, taking the inverse Laplace transform of $Y(s),$ we get\n\n$$\n\\begin{aligned}y(t) & =\\frac{9}{8}{L}^{-1}{\\frac{1}{s-3}}-\\frac{9}{8}{L}^{-1}{\\frac{1}{s+5}} \\\\ y(t) & =\\frac{9}{8}{e}^{3t}-\\frac{9}{8}{e}^{-5t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342499/field-1" "q-342499/field-2" "q-342499/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5eae6b5d-adff-53b2-970d-f0dcee58365f"] :knowledge-point/questions ["q-342499"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342501/field-1/a50513a2bba92349aac5b7baabe09cc6bf77b99b87858dd7fa28c7b7ca96e44a" :answer/id #uuid "f0a9c87e-02fc-5276-8d1c-31c785c54322" :answer/type :answer.type/math :answer/value "\\frac{1}{(s-4)(s+3)}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-1/0bb036e6f9e3ade09811ac7a129d6d153604bcdb525df124b120017cec66a044" :answer/id #uuid "d5a90e27-17a9-5fe4-923d-e2100d8a3b60" :answer/type :answer.type/math :answer/value "\\frac{4}{(s-1)(s+3)}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-1/fe8e7e9d97ee2c82ec4b022a5376bac5592f847974d7c031c043b4432cb41f51" :answer/id #uuid "be9a8979-1ab7-5d49-ace6-6aebed7101f4" :answer/type :answer.type/math :answer/value "\\frac{4}{(s-3)(s+1)}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-1/0ab05f5fb3a29b2eb28c2d36261edd48cbbf83a922e1b754cd20656c7d44e302" :answer/id #uuid "6869da3f-f11d-5bb2-adca-fc09ccd32806" :answer/type :answer.type/math :answer/value "\\frac{3}{(s-1)(s+4)}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-1/c66a4eb844bc59573bf5fe8e89b3c8ed49c28fa029170505a71991366470b040" :answer/id #uuid "a977ae90-62c6-54a1-ae8e-3b10ef153091" :answer/type :answer.type/math :answer/value "\\frac{1}{(s-4)(s+1)}" :db/ensure [:answer/validate]} {:db/id "q-342501/field-1" :answer-field/id #uuid "de72a231-c50c-5cf5-b512-de6e478b009e" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/c