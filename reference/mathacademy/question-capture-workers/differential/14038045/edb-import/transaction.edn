e]} {:db/id [:question/math-academy-id "q-102626"] :question/answer-fields ["q-102626/selection/ma-v1/6054d8253ec5d05085dd4c91baad24517f530798c802799af3f73ab119b263e0"] :db/ensure [:question/validate]} {:db/id "q-336435/field-1/25b1efa9827c30e627752905386f902b1dcfe481e570751b74a6a8c0bcb39d70" :answer/id #uuid "0dc312d1-7ef8-5924-93d2-a4438e5b2ce9" :answer/type :answer.type/math :answer/value "\\ln(2)+1" :db/ensure [:answer/validate]} {:db/id "q-336435/field-1/378ae18ffa1bbdc10ccf5e1c1f0d0c41d0422a940d205297ca383d70d89d3237" :answer/id #uuid "2380d078-7023-5e21-8a3b-b7aec53a3e8f" :answer/type :answer.type/math :answer/value "\\ln(2)" :db/ensure [:answer/validate]} {:db/id "q-336435/field-1" :answer-field/id #uuid "d311f08a-337b-5010-9681-08f771ff0c8f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-336435/field-1/25b1efa9827c30e627752905386f902b1dcfe481e570751b74a6a8c0bcb39d70" :answer-field/choices ["q-336435/field-1/25b1efa9827c30e627752905386f902b1dcfe481e570751b74a6a8c0bcb39d70" "q-336435/field-1/378ae18ffa1bbdc10ccf5e1c1f0d0c41d0422a940d205297ca383d70d89d3237"] :db/ensure [:answer-field/validate]} {:db/id "q-336435" :question/id #uuid "cead7150-5043-535d-bd24-688f2a17b002" :question/math-academy-id "q-336435" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)=\\operatorname{ln}⁡(t+1)+1.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $\\frac{1}{2}\\,{\\text{m/s}}^{2}.$\n\nWhen $a=\\frac{1}{2}\\,{\\text{m/s}}^{2},$ the velocity is $v=$\n{{field-1}}\n$\\text{m/s}.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t+1)+1) \\\\  & =\\frac{1}{t+1}\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=\\frac{1}{2},$ we substitute this into the above:\n\n$$\n\\begin{aligned}\\frac{1}{2} & =\\frac{1}{t+1} \\\\ t+1 & =2 \\\\ t & =1\\end{aligned}\n$$\n\nThen, to calculate the velocity at time $t=1,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(1) & =\\operatorname{ln}⁡(1+1)+1 \\\\  & =(\\operatorname{ln}⁡(2)+1)\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=\\frac{1}{2}\\,{\\text{m/s}}^{2}$ is $v=\\operatorname{ln}⁡(2)+1\\,\\text{m/s}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-336435/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5"] :knowledge-point/questions ["q-336435"] :db/ensure [:knowledge-point/validate]} {:db/id "q-315535/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "ab212f83-eae3-5f6c-b58c-8cfc6067944e" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-315535/field-1" :answer-field/id #uuid "a3389d37-0f27-5e75-82c0-501840e36f9f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-315535/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-315535/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-315535" :question/id #uuid "5aab4b39-f7a2-50ac-a375-2dc93db74438" :question/math-academy-id "q-315535" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ is given by $v(t)={t}^{3}{e}^{3t-3},$ where $t$ is measured in seconds. Calculate the acceleration of the particle at $t=1$ second.\n\n$a(1)=$\n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}{e}^{3t-3}) \\\\  & =3{t}^{2}{e}^{3t-3}+3{t}^{3}{e}^{3t-3} \\\\  & =3{t}^{2}(1+t){e}^{3t-3}\\end{aligned}\n$$\n\nTo calculate the acceleration when $t=1$ second, we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =3(1)^{2}(1+1){e}^{3(1)-3} \\\\  & =3(1)(2){e}^{0} \\\\  & =6\\,{\\text{m/s}}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-315535/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5"] :knowledge-point/questions ["q-315535"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186258955 :question/answer-fields 17592186274576] {:db/id "q-2358/selection/ma-v1/ee4fbd91f9655d833ee16eed1eb1d86999506d3da50f6297d5937c1522bcbbf9/2f13f8b467e58df093872e282262719e7e814eb477c8a93993e6f79cf66cc49f" :answer/id #uuid "b74e2d81-d901-5191-a24d-44a848697912" :answer/type :answer.type/text :answer/value "$3$ seconds" :db/ensure [:answer/validate]} {:db/id "q-2358/selection/ma-v1/ee4fbd91f9655d833ee16eed1eb1d86999506d3da50f6297d5937c1522bcbbf9/4f3d044250b1f74f79a8f436879b1b254c57325d32a9a219d3aec389deb626be" :answer/id #uuid "ed38d178-17cc-51c8-91f8-8f88cbd63ad2" :answer/type :answer.type/text :answer/value "$2$ seconds" :db/ensure [:answer/validate]} {:db/id "q-2358/selection/ma-v1/ee4fbd91f9655d833ee16eed1eb1d86999506d3da50f6297d5937c1522bcbbf9/82a96b3d0b0a22c83448bbb6a66c07b97db8d49bf48c105464b44aabb2903d25" :answer/id #uuid "9940b656-d78c-5145-a6b9-47228368fc1f" :answer/type :answer.type/text :answer/value "$5$ seconds" :db/ensure [:answer/validate]} {:db/id "q-2358/selection/ma-v1/ee4fbd91f9655d833ee16eed1eb1d86999506d3da50f6297d5937c1522bcbbf9/c07782c64222acba89ad9fb7cefe183ae9d2be45e12b59dd7771d076d64cebc9" :answer/id #uuid "70d2aaa9-459c-564e-af77-5e1388dde682" :answer/type :answer.type/text :answer/value "$4.5$ seconds" :db/ensure [:answer/validate]} {:db/id "q-2358/selection/ma-v1/ee4fbd91f9655d833ee16eed1eb1d86999506d3da50f6297d5937c1522bcbbf9/39e9a15f062decafda22bda2aa47e54efdb04e60e27329531ac40cba2415565f" :answer/id #uuid "