#{[{:db/id #edb/ref 17592186087385 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/id #uuid "9efd33d6-c1d7-55ee-947e-0d067461d5c7" :question/math-academy-id "e-215" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t) = -6t-3t^2$. Calculate the acceleration of the particle at time $t$." :question/worked-solution "We differentiate $v(t)$ to calculate $a(t)$:\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(-6t-3{t}^{2}) \\\\  & =-6-6t \\\\  & =-6(1+t).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087386 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/id #uuid "136e4bd1-f9c4-50a0-9d16-54709f0d6d45" :question/math-academy-id "e-216" :question/problem "The position $x$ of a particle at time $t$ is given by $x(t) = 1+2t+3t^2+4t^3$. Calculate the acceleration of the particle at time $t=0$." :question/worked-solution "First, we calculate $v(t)$ by differentiating $x(t)$:\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}x}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(1+2t+3{t}^{2}+4{t}^{3}) \\\\  & =2+6t+12{t}^{2}.\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t)$:\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2+6t+12{t}^{2}) \\\\  & =6+24t.\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=0$, we substitute this into the above:\n\n$$\n\\begin{aligned}a(0) & =6+24(0) \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the acceleration when $t=0$ is $6$."}] [{:db/id #edb/ref 17592186256587 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "90415a77-1f3a-52fb-abe6-7e1d87fb6869" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{3(3t-2)}" :db/id #edb/ref 17592186298224} {:answer/id #uuid "9c0e18ee-690d-55ca-9fa2-42e83d835a27" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{e}^{2-3t}}{3}" :db/id #edb/ref 17592186298225} {:answer/id #uuid "d1ffed71-9484-559d-bfb9-49083b2408be" :answer/type {:db/ident :answer.type/math} :answer/value "3\\cdot {e}^{2-3t}" :db/id #edb/ref 17592186298226} {:answer/id #uuid "8c5482e3-c5b9-5a94-b1c1-d6fc1ea04740" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2-3t}}{3}" :db/id #edb/ref 17592186298227} {:answer/id #uuid "3e8cde9a-7a39-5382-b4c4-22895ce884f8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot {e}^{2-3t}" :db/id #edb/ref 17592186298228}] :answer-field/correct {:answer/id #uuid "3e8cde9a-7a39-5382-b4c4-22895ce884f8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot {e}^{2-3t}" :db/id #edb/ref 17592186298228} :answer-field/id #uuid "9b776eb0-81cd-5f6d-9ffd-b7805c8147cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298223}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ec12c4d-f13a-5615-b8ec-dbfa0807307e" :question/math-academy-id "q-102626" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)={e}^{2-3t}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{2-3t}) \\\\  & =-3\\cdot {e}^{2-3t}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258955 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b74e2d81-d901-5191-a24d-44a848697912" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ seconds" :db/id #edb/ref 17592186298230} {:answer/id #uuid "ba42f95e-02c4-54e0-a601-e222eda6f3d9" :answer/type {:db/ident :answer.type/text} :answer/value "$3.5$ seconds" :db/id #edb/ref 17592186298231} {:answer/id #uuid "ed38d178-17cc-51c8-91f8-8f88cbd63ad2" :answer/type {:db/ident :answer.type/text} :answer/value "$2$ seconds" :db/id #edb/ref 17592186298232} {:answer/id #uuid "9940b656-d78c-5145-a6b9-47228368fc1f" :answer/type {:db/ident :answer.type/text} :answer/value "$5$ seconds" :db/id #edb/ref 17592186298233} {:answer/id #uuid "70d2aaa9-459c-564e-af77-5e1388dde682" :answer/type {:db/ident :answer.type/text} :answer/value "$4.5$ seconds" :db/id #edb/ref 17592186298234}] :answer-field/correct {:answer/id #uuid "b74e2d81-d901-5191-a24d-44a848697912" :answer/type {:db/ident :answer.type/text} :answer/value "$3$ seconds" :db/id #edb/ref 17592186298230} :answer-field/id #uuid "25642df2-b304-51c4-abe8-c65530b17a45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298229}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a37d360-2bb9-53ba-8a4f-830d6a3e6ba2" :question/math-academy-id "q-2358" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)=6{t}^{3}-19{t}^{2}+13,$ where $t$ is measured in seconds. Find the time when the particle's acceleration is equal to $a=70\\,{\\text{m/s}}^{2}.$" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{3}-19{t}^{2}+13) \\\\  & =18{t}^{2}-38t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(18{t}^{2}-38t) \\\\  & =36t-38\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=70,$ we substitute this into the above:\n\n$$\n\\begin{aligned}70 & =36t-38 \\\\ 36t & =108 \\\\ t & =3\\,\\text{s}\\end{aligned}\n$$\n\nTherefore, the time when the acceleration is $a=70\\,{\\text{m/s}}^{2}$ is $3$ seconds."}] [{:db/id #edb/ref 17592186298235 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8bdeff6-0c34-5c2f-a220-ed490c96a88c" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\text{ m/s}" :db/id #edb/ref 17592186298237} {:answer/id #uuid "103d475f-8713-5149-99e7-22e5e39d4ff8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\text{ m/s}" :db/id #edb/ref 17592186298238} {:answer/id #uuid "8c9edb73-e931-5a5b-bac0-079308fe9033" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{ m/s}" :db/id #edb/ref 17592186298239} {:answer/id #uuid "cfb356cd-65a6-5736-8502-fc78c2b3e7fd" :answer/type {:db/ident :answer.type/math} :answer/value "4\\text{ m/s}" :db/id #edb/ref 17592186298240} {:answer/id #uuid "cc6824db-e394-5cab-a218-b28bb1481fd8" :answer/type {:db/ident :answer.type/math} :answer/value "-4\\text{ m/s}" :db/id #edb/ref 17592186298241}] :answer-field/correct {:answer/id #uuid "103d475f-8713-5149-99e7-22e5e39d4ff8" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\text{ m/s}" :db/id #edb/ref 17592186298238} :answer-field/id #uuid "58ae317b-41ad-56c9-9f98-0097d5e134b9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298236}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0a0a13b2-62a8-56b3-bab6-7c4ff9bd30f3" :question/math-academy-id "q-2360" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)=3{t}^{2}-24t+45.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $0\\,{\\text{m/s}}^{2}.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-24t+45) \\\\  & =6t-24\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=0,$ we substitute this into the above:\n\n$$\n\\begin{aligned}0 & =6t-24 \\\\ 6t & =24 \\\\ t & =4\\end{aligned}\n$$\n\nThen, to calculate the velocity at time $t=4,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(4) & =3(4)^{2}-24(4)+45 \\\\  & =48-96+45 \\\\  & =-3\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=0\\,{\\text{m/s}}^{2}$ is $-3\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186298242 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab212f83-eae3-5f6c-b58c-8cfc6067944e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298244}] :answer-field/correct {:answer/id #uuid "ab212f83-eae3-5f6c-b58c-8cfc6067944e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186298244} :answer-field/id #uuid "a3389d37-0f27-5e75-82c0-501840e36f9f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298243}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5aab4b39-f7a2-50ac-a375-2dc93db74438" :question/math-academy-id "q-315535" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ is given by $v(t)={t}^{3}{e}^{3t-3},$ where $t$ is measured in seconds. Calculate the acceleration of the particle at $t=1$ second.\n\n$a(1)=$\n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}{e}^{3t-3}) \\\\  & =3{t}^{2}{e}^{3t-3}+3{t}^{3}{e}^{3t-3} \\\\  & =3{t}^{2}(1+t){e}^{3t-3}\\end{aligned}\n$$\n\nTo calculate the acceleration when $t=1$ second, we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =3(1)^{2}(1+1){e}^{3(1)-3} \\\\  & =3(1)(2){e}^{0} \\\\  & =6\\,{\\text{m/s}}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298245 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a23b053f-ea45-5f9f-a17e-46f4418afe55" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298247}] :answer-field/correct {:answer/id #uuid "a23b053f-ea45-5f9f-a17e-46f4418afe55" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186298247} :answer-field/id #uuid "8a362aad-a64e-5d07-9475-787135c268ea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298246}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e4d0edfc-2709-5869-9dec-98b7e891d29e" :question/math-academy-id "q-315674" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)=6{t}^{3}+3{t}^{2},$ where $t$ is measured in seconds. Find the time when the particle's acceleration is equal to $a=150\\,{\\text{m/s}}^{2}.$\n\nThe acceleration is $150\\,{\\text{m/s}}^{2}$ at\n$t=$\n{{field-1}} seconds." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{3}+3{t}^{2}) \\\\  & =18{t}^{2}+6t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t)$:\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(18{t}^{2}+6t) \\\\  & =36t+6\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=150,$ we substitute this into the above:\n\n$$\n\\begin{aligned}150 & =36t+6 \\\\ 36t & =144 \\\\ t & =4\\text{ }\\text{s}\\end{aligned}\n$$\n\nTherefore, the acceleration is $150\\,{\\text{m/s}}^{2}$ at $t=4$ seconds."}] [{:db/id #edb/ref 17592186298248 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f0a5c361-764b-5a8c-b304-f1074da136cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}" :db/id #edb/ref 17592186298250} {:answer/id #uuid "510fda73-d45a-52f1-95b0-533e0f771ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}+2" :db/id #edb/ref 17592186298251}] :answer-field/correct {:answer/id #uuid "510fda73-d45a-52f1-95b0-533e0f771ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{t+1}+2" :db/id #edb/ref 17592186298251} :answer-field/id #uuid "4bae2bb8-441a-5bb0-b5ae-2f2f77731b65" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298249}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6fa56455-2957-58d5-9aaf-f51a06829b5e" :question/math-academy-id "q-336419" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)=4\\operatorname{ln}⁡(t+1)+2t.$ Calculate the acceleration $a$ of the particle at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{ln}⁡(t+1)+2t) \\\\  & =\\frac{4}{t+1}+2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298252 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0dc312d1-7ef8-5924-93d2-a4438e5b2ce9" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)+1" :db/id #edb/ref 17592186298254} {:answer/id #uuid "2380d078-7023-5e21-8a3b-b7aec53a3e8f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)" :db/id #edb/ref 17592186298255}] :answer-field/correct {:answer/id #uuid "0dc312d1-7ef8-5924-93d2-a4438e5b2ce9" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(2)+1" :db/id #edb/ref 17592186298254} :answer-field/id #uuid "d311f08a-337b-5010-9681-08f771ff0c8f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298253}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cead7150-5043-535d-bd24-688f2a17b002" :question/math-academy-id "q-336435" :question/problem "The velocity $v$ (in $\\text{m/s}$) of a particle at time $t$ (in seconds) is given by $v(t)=\\operatorname{ln}⁡(t+1)+1.$ Calculate the velocity of the particle when the acceleration $a$ is equal to $\\frac{1}{2}\\,{\\text{m/s}}^{2}.$\n\nWhen $a=\\frac{1}{2}\\,{\\text{m/s}}^{2},$ the velocity is $v=$\n{{field-1}}\n$\\text{m/s}.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t+1)+1) \\\\  & =\\frac{1}{t+1}\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=\\frac{1}{2},$ we substitute this into the above:\n\n$$\n\\begin{aligned}\\frac{1}{2} & =\\frac{1}{t+1} \\\\ t+1 & =2 \\\\ t & =1\\end{aligned}\n$$\n\nThen, to calculate the velocity at time $t=1,$ we substitute this into the equation for the velocity:\n\n$$\n\\begin{aligned}v(1) & =\\operatorname{ln}⁡(1+1)+1 \\\\  & =(\\operatorname{ln}⁡(2)+1)\\text{ m/s}\\end{aligned}\n$$\n\nTherefore, the velocity when $a=\\frac{1}{2}\\,{\\text{m/s}}^{2}$ is $v=\\operatorname{ln}⁡(2)+1\\,\\text{m/s}.$"}] [{:db/id #edb/ref 17592186277262 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7e7851bb-80bf-541c-b821-f1c5dd419b2d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277264} {:answer/id #uuid "b3e73221-e6fb-5093-9236-e54c29738da8" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298256}] :answer-field/correct {:answer/id #uuid "7e7851bb-80bf-541c-b821-f1c5dd419b2d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186277264} :answer-field/id #uuid "fdac6615-f739-5a3d-8a79-8fa482126b15" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186277263}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "565b31b4-2cd1-5b24-8e88-4ac0f4ecf026" :question/math-academy-id "q-336441" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)=4{t}^{3}-{t}^{2},$ where $t$ is measured in seconds. Find the time when the particle's acceleration is equal to $a=70\\,{\\text{m/s}}^{2}.$\n\nThe acceleration is $70\\,{\\text{m/s}}^{2}$ at\n$t=$\n{{field-1}} seconds." :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-{t}^{2}) \\\\  & =12{t}^{2}-2t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t)$:\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(12{t}^{2}-2t) \\\\  & =24t-2\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=70,$ we substitute this into the above:\n\n$$\n\\begin{aligned}70 & =24t-2 \\\\ 24t & =72 \\\\ t & =3\\text{ }\\text{s}\\end{aligned}\n$$\n\nTherefore, the acceleration is $70\\,{\\text{m/s}}^{2}$ at $t=3$ seconds."}] [{:db/id #edb/ref 17592186298257 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a8359949-74e7-5244-8765-a1a7351f602f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298259}] :answer-field/correct {:answer/id #uuid "a8359949-74e7-5244-8765-a1a7351f602f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186298259} :answer-field/id #uuid "7896cfb9-12ca-54c3-b080-c16534ef5165" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298258}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "460a60d4-938d-564b-ad20-d6e081fbfa33" :question/math-academy-id "q-336444" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)={t}^{2}+4\\sqrt{t},$ where $t$ is measured in seconds. Find the particle's acceleration at $t=1$ second.\n\n$a(1)=$\n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+4\\sqrt{t}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+4{t}^{1/2}) \\\\  & =2t+2{t}^{-1/2}\\end{aligned}\n$$\n\n \n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t+2{t}^{-1/2}) \\\\  & =2+2(-\\frac{1}{2}){t}^{-3/2} \\\\  & =2-\\frac{1}{\\sqrt{{t}^{3}}}\\end{aligned}\n$$\n\nTo calculate the acceleration at time $t=1$ second, we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =2-\\frac{1}{\\sqrt{(1)^{3}}} \\\\  & =2-1 \\\\  & =1\\,{\\text{m/s}}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186298260 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9c17885-ee45-59e2-bd38-5545d454b7dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{(t+2)^3}+2" :db/id #edb/ref 17592186298262}] :answer-field/correct {:answer/id #uuid "d9c17885-ee45-59e2-bd38-5545d454b7dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{(t+2)^3}+2" :db/id #edb/ref 17592186298262} :answer-field/id #uuid "d5004db6-2a35-593c-b421-2d03983feea5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298261}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f26bf09d-4986-5db0-9fae-1c5b376ec0ef" :question/math-academy-id "q-336455" :question/problem "The displacement $s$ of a particle moving in a straight line is given by $s(t)={t}^{2}+\\frac{6}{t+2}.$ Find the particle's acceleration at time $t.$\n\n$a(t)=$\n{{field-1}}" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+\\frac{6}{t+2}) \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}+6(t+2)^{-1}) \\\\  & =2t-6(t+2)^{-2}\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t-6(t+2)^{-2}) \\\\  & =2+12(t+2)^{-3} \\\\  & =2+\\frac{12}{(t+2)^{3}}\\end{aligned}\n$$"}]}
