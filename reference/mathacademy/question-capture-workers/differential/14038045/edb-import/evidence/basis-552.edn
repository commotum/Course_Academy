#{[{:db/id #edb/ref 17592186256587 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98a89e0a-4efc-593f-a84a-3b33c40032d5" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot {e}^{2-3t}" :db/id #edb/ref 17592186256589}] :answer-field/correct {:answer/id #uuid "98a89e0a-4efc-593f-a84a-3b33c40032d5" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot {e}^{2-3t}" :db/id #edb/ref 17592186256589} :answer-field/id #uuid "43eacefa-8e8f-50c8-8475-f621f03d0c37" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186256588}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ec12c4d-f13a-5615-b8ec-dbfa0807307e" :question/math-academy-id "q-102626" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)={e}^{2-3t}.$ Calculate the acceleration of the particle at time $t.$\n\nAnswer: {{answer}}" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{2-3t}) \\\\  & =-3\\cdot {e}^{2-3t}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258955 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1add7981-398b-563f-aaac-42b2a6611944" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258957}] :answer-field/correct {:answer/id #uuid "1add7981-398b-563f-aaac-42b2a6611944" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186258957} :answer-field/id #uuid "ee2b73d0-b94d-51bd-8d0a-191182b5bec9" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186258956}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a37d360-2bb9-53ba-8a4f-830d6a3e6ba2" :question/math-academy-id "q-2358" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)=6{t}^{3}-19{t}^{2}+13,$ where $t$ is measured in seconds. Find the time when the particle's acceleration is equal to $a=70\\,{\\text{m/s}}^{2}.$\n\nAnswer: {{answer}}" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{3}-19{t}^{2}+13) \\\\  & =18{t}^{2}-38t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(18{t}^{2}-38t) \\\\  & =36t-38\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=70,$ we substitute this into the above:\n\n$$\n\\begin{aligned}70 & =36t-38 \\\\ 36t & =108 \\\\ t & =3\\,\\text{s}\\end{aligned}\n$$\n\nTherefore, the time when the acceleration is $a=70\\,{\\text{m/s}}^{2}$ is $3$ seconds."}]}
