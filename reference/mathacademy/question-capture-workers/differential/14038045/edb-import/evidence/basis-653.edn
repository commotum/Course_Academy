#{[{:db/id #edb/ref 17592186256587 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0cdcbc5-c10b-5dd1-af9a-410d2d44a4c5" :knowledge-point/title "Calculating the Acceleration of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1c943a2e-592b-5f26-ae05-bf5c394e29b0" :answer/type {:db/ident :answer.type/math} :answer/value "3(-3\\cdot {e}^{2-3t})" :db/id #edb/ref 17592186269512} {:answer/id #uuid "55076d03-37b4-5133-8eeb-b36c452b2adc" :answer/type {:db/ident :answer.type/math} :answer/value "2(-3\\cdot {e}^{2-3t})" :db/id #edb/ref 17592186269513} {:answer/id #uuid "7365a605-180c-5bb5-abea-bfe4109cd1d8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-3\\cdot {e}^{2-3t})" :db/id #edb/ref 17592186269514} {:answer/id #uuid "a0d9c0ce-fb61-54eb-9528-b66710176cc0" :answer/type {:db/ident :answer.type/math} :answer/value "-(-3\\cdot {e}^{2-3t})" :db/id #edb/ref 17592186269515} {:answer/id #uuid "c3d57fb5-992a-5791-aa4e-1600a216520c" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot {e}^{2-3t}" :db/id #edb/ref 17592186269516}] :answer-field/correct {:answer/id #uuid "c3d57fb5-992a-5791-aa4e-1600a216520c" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\cdot {e}^{2-3t}" :db/id #edb/ref 17592186269516} :answer-field/id #uuid "ac2b76ae-6c7c-5794-92e5-5a93ac85df73" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274177}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ec12c4d-f13a-5615-b8ec-dbfa0807307e" :question/math-academy-id "q-102626" :question/problem "The velocity $v$ of a particle at time $t$ is given by $v(t)={e}^{2-3t}.$ Calculate the acceleration of the particle at time $t.$" :question/worked-solution "We differentiate $v(t)$ to calculate $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{2-3t}) \\\\  & =-3\\cdot {e}^{2-3t}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186258955 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe05aa67-e29e-5803-980c-e49ecb5db248" :knowledge-point/title "Calculating the Acceleration of a Particle at a Particular Moment Given Its Position"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "630b2520-5350-5957-b7a9-af9bb2527748" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(3)" :db/id #edb/ref 17592186271493} {:answer/id #uuid "53a87d29-28b8-566f-b916-d63b6444d582" :answer/type {:db/ident :answer.type/math} :answer/value "3(3)" :db/id #edb/ref 17592186271494} {:answer/id #uuid "87140a10-f79c-5163-8b5b-10fbf1a63735" :answer/type {:db/ident :answer.type/math} :answer/value "2(3)" :db/id #edb/ref 17592186271495} {:answer/id #uuid "7c84ab5a-9176-5b3b-8608-5e6961f32830" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271496} {:answer/id #uuid "5c8243fa-3b33-53f3-9e41-fc66d4d82a4e" :answer/type {:db/ident :answer.type/math} :answer/value "-(3)" :db/id #edb/ref 17592186271497}] :answer-field/correct {:answer/id #uuid "7c84ab5a-9176-5b3b-8608-5e6961f32830" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186271496} :answer-field/id #uuid "de95a2bb-350d-5138-8bbc-d8e038e0cb49" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274576}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5a37d360-2bb9-53ba-8a4f-830d6a3e6ba2" :question/math-academy-id "q-2358" :question/problem "The displacement (in meters) of a particle moving in a straight line is given by $s(t)=6{t}^{3}-19{t}^{2}+13,$ where $t$ is measured in seconds. Find the time when the particle's acceleration is equal to $a=70\\,{\\text{m/s}}^{2}.$" :question/worked-solution "First, we calculate $v(t)$ by differentiating $s(t):$\n\n$$\n\\begin{aligned}v(t) & =\\frac{\\text{d}s}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{3}-19{t}^{2}+13) \\\\  & =18{t}^{2}-38t\\end{aligned}\n$$\n\nNow, we differentiate $v(t)$ to find $a(t):$\n\n$$\n\\begin{aligned}a(t) & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =\\frac{\\text{d}}{\\text{d}t}(18{t}^{2}-38t) \\\\  & =36t-38\\end{aligned}\n$$\n\nTo calculate the time when the acceleration is $a=70,$ we substitute this into the above:\n\n$$\n\\begin{aligned}70 & =36t-38 \\\\ 36t & =108 \\\\ t & =3\\,\\text{s}\\end{aligned}\n$$\n\nTherefore, the time when the acceleration is $a=70\\,{\\text{m/s}}^{2}$ is $3$ seconds."}]}
