ef 17592186220836} {:answer/id #uuid "d62fee15-3bf9-57c0-8128-f008610aa956" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos ((nπx)/(4))" :db/id #edb/ref 17592186220837} {:answer/id #uuid "15997c6c-66a6-59c4-b68b-94125650f15d" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos ((nπx)/(2))" :db/id #edb/ref 17592186220838} {:answer/id #uuid "6886af66-8dde-5442-8b37-70cae88d2d94" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin ((nπx)/(4))" :db/id #edb/ref 17592186220839}] :answer-field/correct {:answer/id #uuid "15997c6c-66a6-59c4-b68b-94125650f15d" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos ((nπx)/(2))" :db/id #edb/ref 17592186220838} :answer-field/id #uuid "d744c883-6921-5db7-8067-f37aa8ebe190" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220835}] :question/id #uuid "b7403504-1eb6-58c7-80a7-8e8d0a72b009" :question/math-academy-id "q-343380" :question/problem "Let $f(x)$ be the $4$-periodic extension of the function $F(x) =-\\frac{3}{2}x^{2}$ defined on $[MATH: [- 2, 2).]$ Select the correct options in the reasoning below, showing the derivation of a series converging to the $4$-periodic extension of\n$G(x) =-\\frac{1}{2}x^{3} = \\displaystyle \\int_{0}^{x}f(t)dt$\nfrom the corresponding Fourier series of $f(x)$.The Fourier series of $f(x)$ is given by\n$\\sin (\\frac{nπx}{4})$ {{field-1}}"}]}
