9b-e389-5658-b7e7-d637d0053de2" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374934} {:answer-field/choices [{:answer/id #uuid "23193936-b447-52e3-8dc0-1b2a4373e21b" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{s}^{2}+49}{({s}^{2}-49)^{2}}" :db/id #edb/ref 17592186374940} {:answer/id #uuid "1d22b154-8356-5e2e-ab3e-5a5b7c6cab58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{s}^{2}+49}{({s}^{2}-49)^{2}}" :db/id #edb/ref 17592186374941} {:answer/id #uuid "929819de-b3f2-5093-92ee-2de6599a29ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7{s}^{2}}{({s}^{2}-49)^{2}}" :db/id #edb/ref 17592186374942} {:answer/id #uuid "ff6aae4f-be60-5f3f-8306-dd24631703ae" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{7{s}^{2}}{({s}^{2}-49)^{2}}" :db/id #edb/ref 17592186374943}] :answer-field/correct {:answer/id #uuid "1d22b154-8356-5e2e-ab3e-5a5b7c6cab58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{s}^{2}+49}{({s}^{2}-49)^{2}}" :db/id #edb/ref 17592186374941} :answer-field/id #uuid "30765562-abc1-5e23-bb12-16d2e1a87709" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374939}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7dd9ae26-4cf6-5427-9203-99ec6f8fdc27" :question/math-academy-id "q-341050" :question/problem "Suppose we wish to calculate the Laplace transform \n\n$$\nL{t\\operatorname{cosh}⁡7t}.\n$$\n\n \nSelect the correct options in the reasoning below. You may make use of the following result:\n\n$$\nL{\\operatorname{cosh}⁡\\omega t}=\\frac{s}{{s}^{2}-{\\omega }^{2}},\\,s>\\omega .\n$$\n\nLet $f(t)=\\operatorname{cosh}⁡7t$ and $L{f(t)}=F(s).$ By the smoothness property of Laplace transforms,\n\n$$\nL{tf(t)}={{field-1}}.\n$$\n\nThe Laplace transform of $f(t)$ is\n\n$$\nF(s)=L{f(t)}={{field-2}},\\,s>7.\n$$\n\nWe have that\n\n$$\n{F}^{′}(s)={{field-3}}.\n$$\n\nTherefore,\n\n$$\nL{t\\operatorname{cosh}⁡7t}={{field-4}},\\,s>7.\n$$" :question/worked-solution "If a function $f(t)$ is piecewise continuous on $[0,\\infty )$ and has exponential order $a,$ then its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for every real $s>a,$ and $F$ is infinitely differentiable in this region of convergence. Moreover, for each integer $n\\ge 0$ and every such $s,$ we have\n\n$$\nL{{t}^{n}f(t)}=(-1)^{n}{F}^{(n)}(s).\n$$\n\nIn particular, for $n=1,$ we have\n\n$$\nL{tf(t)}=-{F}^{′}(s).\n$$\n\nWe have that $f(t)=\\operatorname{cosh}⁡7t.$ Using the given result with $\\omega =7,$ the Laplace transform of $f(t)$ is \n\n$$\nF(s)=\\frac{s}{{s}^{2}-49},\\,s>7.\n$$\n\nDifferentiating with respect to $s,$ we have\n\n$$\n\\begin{aligned}{F}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{s}{{s}^{2}-49}) \\\\  & =\\frac{\\text{d}}{\\text{d}s}(s({s}^{2}-49)^{-1}) \\\\  & =({s}^{2}-49)^{-1}+s(-({s}^{2}-49)^{-2}\\cdot 2s) \\\\  & =\\frac{{s}^{2}-49}{({s}^{2}-49)^{2}}-\\frac{2{s}^{2}}{({s}^{2}-49)^{2}} \\\\  & =\\frac{-49-{s}^{2}}{({s}^{2}-49)^{2}} \\\\  & =-\\frac{{s}^{2}+49}{({s}^{2}-49)^{2}}.\\end{aligned}\n$$\n\nTherefore, by the smoothness property,\n\n$$\n\\begin{aligned}L{t\\operatorname{cosh}⁡7t}=-{F}^{′}(s)=\\frac{{s}^{2}+49}{({s}^{2}-49)^{2}},\\,s>7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374944 :knowledge-point/_questions [{:knowledge-point/id #uuid "6373d849-f5c6-50d2-ad4f-72f77a1a8c92" :knowledge-point/title "Finding Laplace Transforms Using the Smoothness Property (2nd Derivative)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "109496d4-895d-5991-bd16-39e790794415" :answer/type {:db/ident :answer.type/math} :answer/value "{F}^{″}(s)" :db/id #edb/ref 17592186374946} {:answer/id #uuid "c0d32bf2-ccee-5230-97f0-05de753f8f10" :answer/type {:db/ident :answer.type/math} :answer/value "-{s}^{2}{F}^{′}(s)" :db/id #edb/ref 17592186374947} {:answer/id #uuid "6a508ee5-d964-57b2-a537-b4a3a8dd6757" :answer/type {:db/ident :answer.type/math} :answer/value "-{F}^{″}(s)" :db/id #edb/ref 17592186374948} {:answer/id #uuid "69eebe9d-c973-5895-bde5-667fe9181a12" :answer/type {:db/ident :answer.type/math} :answer/value "{s}^{2}{F}^{″}(s)" :db/id #edb/ref 17592186374949} {:answer/id #uuid "f4024aa5-92b4-5115-bbcc-c2bfd66e57ce" :answer/type {:db/ident :answer.type/math} :answer/value "-{s}^{2}{F}^{″}(s)" :db/id #edb/ref 17592186374950}] :answer-field/correct {:answer/id #uuid "109496d4-895d-5991-bd16-39e790794415" :answer/type {:db/ident :answer.type/math} :answer/value "{F}^{″}(s)" :db/id #edb/ref 17592186374946} :answer-field/id #uuid "f1506f13-6459-51ce-9bdd-6357455ed427" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374945} {:answer-field/choices [{:answer/id #uuid "4036c847-bcbd-5a57-abb1-a88e289ad876" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{s}^{2}+16}" :db/id #edb/ref 17592186374952} {:answer/id #uuid "ff6ce9d8-6ada-59f6-94ca-37dd2eff10ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s}{{s}^{2}-16}" :db/id #edb/ref 17592186374953} {:answer/id #uuid "ba6ef470-94ac-50c2-9b67-1bc79c16e689" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{{s}^{2}-16}" :db/id #edb/ref 17592186374954} {:answer/id #uuid "4ea40fed-a51a-5356-bd37-ec21eed19a30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s}{{s}^{2}+16}" :db/id #edb/ref 17592186374955}] :answer-field/correct {:answer/id #uuid "ff6ce9d8-6ada-59f6-94ca-37dd2eff10ac" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s}{{s}^{2}-16}" :db/id #edb/ref 17592186374953} :answer-field/id #uuid "aa6474b4-cd6f-5cce-b84c-1bb43a92dcfa" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374951} {:answer-field/choices [{:answer/id #uuid "a9ea366f-4e17-58a1-ae9e-41063a0386e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374957} {:answer/id #uuid "7715148e-59fd-5c48-987d-3509507647b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{s}^{3}+32s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374958} {:answer/id #uuid "ea268879-5c63-5da6-abd8-b085b06373d7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374959} {:answer/id #uuid "a3e7372a-909b-53c2-8962-760ce061dad7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2{s}^{3}+32s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374960}] :answer-field/correct {:answer/id #uuid "a9ea366f-4e17-58a1-ae9e-41063a0386e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374957} :answer-field/id #uuid "9fa066a7-3c82-5b0f-9b74-6093d20aaf12" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374956} {:answer-field/choices [{:answer/id #uuid "37f7eceb-a928-5bfe-91a5-ad4620d0f3bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374962} {:answer/id #uuid "8d0c880b-1ef1-5b37-a906-c98752fffbd6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2{s}^{2}+96}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374963} {:answer/id #uuid "e09b6ce5-e1ed-59b6-b961-d654c633b56e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{s}^{2}+96}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374964} {:answer/id #uuid "561f4610-32b9-5e0f-88b6-f6d21b52a53f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374965}] :answer-field/correct {:answer/id #uuid "37f7eceb-a928-5bfe-91a5-ad4620d0f3bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}}" :db/id #edb/ref 17592186374962} :answer-field/id #uuid "6971261d-ba3f-5278-8276-f10681ed7a57" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186374961}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b699a70d-a85c-595c-974a-6cd2b9c90763" :question/math-academy-id "q-341216" :question/problem "Suppose we wish to calculate the Laplace transform \n\n$$\nL{{t}^{2}\\operatorname{cosh}⁡4t}.\n$$\n\nSelect the correct options in the reasoning below. You may make use of the following result:\n\n$$\nL{\\operatorname{cosh}⁡\\omega t}=\\frac{s}{{s}^{2}-{\\omega }^{2}},\\,s>\\omega .\n$$\n\nLet $f(t)=\\operatorname{cosh}⁡4t$ and $F(s)=L{f(t)}.$ By the smoothness property of Laplace transforms, we have\n\n$$\nL{{t}^{2}f(t)}={{field-1}}.\n$$\n\nThe Laplace transform of $f(t)$ is\n\n$$\nF(s)=L{f(t)}={{field-2}},\\,s>4.\n$$\n\nWe have that\n\n$$\n{F}^{″}(s)={{field-3}}.\n$$\n\nTherefore,\n\n$$\nL{{t}^{2}\\operatorname{cosh}⁡4t}={{field-4}},\\,s>4.\n$$" :question/worked-solution "If a function $f(t)$ is piecewise continuous on $[0,\\infty )$ and has exponential order $a,$ then its Laplace transform\n\n$$\nF(s)=L{f(t)}\n$$\n\nexists for every real $s>a,$ and $F$ is infinitely differentiable in this region of convergence. Moreover, for each integer $n\\ge 0$ and every such $s,$ we have\n\n$$\nL{{t}^{n}f(t)}=(-1)^{n}{F}^{(n)}(s).\n$$\n\nIn particular, for $n=2,$ we have\n\n$$\nL{{t}^{2}f(t)}={F}^{″}(s).\n$$\n\nWe have that $f(t)=\\operatorname{cosh}⁡4t.$ Using the given result with $\\omega =4,$ the Laplace transform of $f(t)$ is \n\n$$\nF(s)=\\frac{s}{{s}^{2}-16},\\,s>4.\n$$\n\nDifferentiating with respect to $s,$ we have\n\n$$\n\\begin{aligned}{F}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(\\frac{s}{{s}^{2}-16}) \\\\  & =\\frac{\\text{d}}{\\text{d}s}(s({s}^{2}-16)^{-1}) \\\\  & =({s}^{2}-16)^{-1}+s(-({s}^{2}-16)^{-2}\\cdot 2s) \\\\  & =\\frac{{s}^{2}-16}{({s}^{2}-16)^{2}}-\\frac{2{s}^{2}}{({s}^{2}-16)^{2}} \\\\  & =-\\frac{{s}^{2}+16}{({s}^{2}-16)^{2}} \\\\ {F}^{″}(s) & =\\frac{\\text{d}}{\\text{d}s}(-\\frac{{s}^{2}+16}{({s}^{2}-16)^{2}}) \\\\  & =-\\frac{\\text{d}}{\\text{d}s}(\\frac{{s}^{2}+16}{({s}^{2}-16)^{2}}) \\\\  & =-(\\frac{({s}^{2}+16)^{′}\\cdot ({s}^{2}-16)^{2}-({s}^{2}+16)\\cdot {(({s}^{2}-16)^{2})}^{′}}{({s}^{2}-16)^{4}}) \\\\  & =-(\\frac{(2s)({s}^{2}-16)^{2}-({s}^{2}+16)\\cdot 2({s}^{2}-16)\\cdot 2s}{({s}^{2}-16)^{4}}) \\\\  & =-(\\frac{2s({s}^{2}-16)^{2}-4s({s}^{2}+16)({s}^{2}-16)}{({s}^{2}-16)^{4}}) \\\\  & =-(\\frac{2s({s}^{2}-16)-4s({s}^{2}+16)}{({s}^{2}-16)^{3}}) \\\\  & =-(\\frac{2{s}^{3}-32s-4{s}^{3}-64s}{({s}^{2}-16)^{3}}) \\\\  & =\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}}.\\end{aligned}\n$$\n\nNote that we used the quotient rule to find ${F}^{″}(s).$\n\nTherefore, by the smoothness property,\n\n$$\n\\begin{aligned}L{{t}^{2}\\operatorname{cosh}⁡4t}={F}^{″}(s)=\\frac{2{s}^{3}+96s}{({s}^{2}-16)^{3}},\\,s>4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374966 :knowledge-point/_questions [{:knowledge-point/id #uuid "6373d849-f5c6-50d2-ad4f-72f77a1a8c92" :knowledge-point/title "Finding Laplace Transforms Using the Smoothness Property (2nd Derivative)"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e82960bb-7a25-5a06-bfd2-26c9ab215291" :answer/type {:db/ident :answer.type/math} :answer/value "{F}^{″}(s)" :db/id #edb/ref 17592186374968} {:answer/id #uuid "b6e6d389-0f39-5907-8040-8a6efb58b11d" :answer/type {:db/ident :answer.type/math} :answer/value "-{s}^{2}{F}^{′}(s)" :db/id #edb/ref 17592186374969} {:answer/id #uuid "8d3742dd-63ca-5b1d-86d9-da602667d034" :answer/type {:db/ident :answer.type/math} :answer/value "-{F}^{″}(s)" :db/id #edb/ref 17592186374970} {:answer/id #uuid "d4fc5798-ccfc-5b4a-9684-965056691364" :answer/type {:db/ident :answer.type/math} :answer/value "{s}^{2}{F}^{″}(s)" :db/id #edb/ref 17592186374971} {:answer/id #uuid "7d41eb02-d352-5