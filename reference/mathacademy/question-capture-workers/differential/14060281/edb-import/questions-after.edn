frac{2{e}^{2x}}{\\sqrt{{({e}^{2x})}^{2}+1}}\\,\\text{d}x \\\\  & =\\int \\frac{2u}{\\sqrt{{u}^{2}+1}}\\,\\cdot (\\frac{1}{2u}\\,\\text{d}u) \\\\  & =\\int \\frac{1}{\\sqrt{{u}^{2}+1}}\\,\\text{d}u \\\\  & =\\operatorname{arsinh}⁡u+C \\\\  & =\\operatorname{arsinh}⁡{e}^{2x}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339430 :knowledge-point/_questions [{:knowledge-point/id #uuid "20b69474-34f6-5539-accf-5ebfc4f6eb0a" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ee39f1-049e-5443-a26d-3302481977fd" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arcosh}⁡(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186339432} {:answer/id #uuid "5b8352c5-9223-59b0-bab5-b0844868832b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}\\operatorname{arsinh}⁡(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186339433} {:answer/id #uuid "51076604-30df-586f-a69e-549f9e0ff4dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arsinh}⁡(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186339434} {:answer/id #uuid "d0053b67-0c2d-5239-8500-894b7b256948" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{3}-1)\\operatorname{arsinh}⁡(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186339435} {:answer/id #uuid "8caf5c8f-20c8-5ffb-8330-1599bb574933" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186339436}] :answer-field/correct {:answer/id #uuid "51076604-30df-586f-a69e-549f9e0ff4dc" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arsinh}⁡(\\frac{x}{\\sqrt{3}})+C" :db/id #edb/ref 17592186339434} :answer-field/id #uuid "9b146f34-d376-53d9-9b6c-66d1e8a0d4e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339431}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a85f9c7b-82b5-5b0f-a187-ebfce33fc3b7" :question/math-academy-id "q-95738" :question/problem "$\\int \\frac{1}{\\sqrt{{x}^{2}+3}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{1}{\\sqrt{{x}^{2}+3}}\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{{(\\frac{x}{\\sqrt{3}})}^{2}+1}}\\,\\text{d}x\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic sine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}+1}}\\,\\text{d}u=\\operatorname{arsinh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{\\sqrt{3}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{3}}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{2}+3}}\\,\\text{d}x & =\\frac{1}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{{(\\frac{x}{\\sqrt{3}})}^{2}+1}}\\,\\text{d}x \\\\  & =\\frac{1}{\\sqrt{3}}\\int \\frac{1}{\\sqrt{{u}^{2}+1}}\\cdot \\sqrt{3}\\,\\text{d}u \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}+1}} \\\\  & =\\operatorname{arsinh}⁡u+C \\\\  & =\\operatorname{arsinh}⁡(\\frac{x}{\\sqrt{3}})+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339437 :knowledge-point/_questions [{:knowledge-point/id #uuid "25d92a33-95e8-5860-b461-8291dac502d6" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "747b8a74-f7e2-5907-a0f5-5ade5c1f1c09" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arsinh}⁡3x+C" :db/id #edb/ref 17592186339439} {:answer/id #uuid "0c34f64d-bd8d-50fc-8567-bc541f1a4649" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcosh}⁡3x+C" :db/id #edb/ref 17592186339440} {:answer/id #uuid "f7fdacdd-4727-5f84-9371-08e495ea53e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡3x+C" :db/id #edb/ref 17592186339441} {:answer/id #uuid "12e6fe83-8aa2-53c0-8e3b-5c4579e6198c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arsinh}⁡3x+C" :db/id #edb/ref 17592186339442} {:answer/id #uuid "dc4ea9da-f95a-53c9-be74-f645572840a4" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arcosh}⁡3x+C" :db/id #edb/ref 17592186339443}] :answer-field/correct {:answer/id #uuid "f7fdacdd-4727-5f84-9371-08e495ea53e9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡3x+C" :db/id #edb/ref 17592186339441} :answer-field/id #uuid "b9b28e2c-70ab-53a7-a766-c887a7508eb0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339438}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c2b64b0d-0000-5979-8de5-6e569bc1ff99" :question/math-academy-id "q-95850" :question/problem "$\\int \\frac{3}{\\sqrt{9{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $9{x}^{2}=(3x)^{2}.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{\\sqrt{9{x}^{2}-1}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{(3x)^{2}-1}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\cdot \\frac{1}{3}\\,\\text{d}u \\\\  & =\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u \\\\  & =\\operatorname{arcosh}⁡u+C \\\\  & =\\operatorname{arcosh}⁡3x+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339444 :knowledge-point/_questions [{:knowledge-point/id #uuid "25d92a33-95e8-5860-b461-8291dac502d6" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b30ac5e1-a3e1-548c-b7db-0bc3c0e032d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186339446} {:answer/id #uuid "5a1e0e7d-47b7-55e5-bacf-2a07443ef8ed" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{arcosh}⁡5x+C" :db/id #edb/ref 17592186339447} {:answer/id #uuid "dbfc8333-0e12-5c84-b2cb-08052dfbae08" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arsinh}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186339448} {:answer/id #uuid "7d229d73-b366-5748-94cc-a8ef51229354" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{arsinh}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186339449} {:answer/id #uuid "299cf7e6-edb1-5451-9bbb-66b9b2236093" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡5x+C" :db/id #edb/ref 17592186339450}] :answer-field/correct {:answer/id #uuid "b30ac5e1-a3e1-548c-b7db-0bc3c0e032d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡(\\frac{x}{5})+C" :db/id #edb/ref 17592186339446} :answer-field/id #uuid "00059c98-6ba0-55d6-9c75-92838d244464" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339445}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b73c27f0-6c57-5652-a89b-fec017279303" :question/math-academy-id "q-95853" :question/problem "$\\int \\frac{1}{\\sqrt{{x}^{2}-25}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{1}{\\sqrt{{x}^{2}-25}}\\,\\text{d}x=\\frac{1}{5}\\int \\frac{1}{\\sqrt{{(\\frac{x}{5})}^{2}-1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{5})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{\\sqrt{{x}^{2}-25}}\\,\\text{d}x & =\\frac{1}{5}\\int \\frac{1}{\\sqrt{{(\\frac{x}{5})}^{2}-1}}\\,\\text{d}x \\\\  & =\\frac{1}{5}\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 5\\,\\text{d}u \\\\  & =\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =\\operatorname{arcosh}⁡u+C \\\\  & =\\operatorname{arcosh}⁡(\\frac{x}{5})+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339451 :knowledge-point/_questions [{:knowledge-point/id #uuid "25d92a33-95e8-5860-b461-8291dac502d6" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd0f1e61-1993-5e93-8511-d244d96d7d2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arsinh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/id #edb/ref 17592186339453} {:answer/id #uuid "30fbcadc-67a9-53a1-ae8e-fe36d9925a98" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/id #edb/ref 17592186339454} {:answer/id #uuid "ac4c96fb-fd7e-50c9-97b9-5a18c9ad29f9" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{2}\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/id #edb/ref 17592186339455} {:answer/id #uuid "e526b12e-5146-524b-bf34-731bf30f6e50" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{arsinh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/id #edb/ref 17592186339456} {:answer/id #uuid "2caae60e-37dd-5b4e-a422-5fcb70e994d5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/id #edb/ref 17592186339457}] :answer-field/correct {:answer/id #uuid "30fbcadc-67a9-53a1-ae8e-fe36d9925a98" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/id #edb/ref 17592186339454} :answer-field/id #uuid "a063d804-1d14-594f-b063-6f194261337e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339452}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "85a483cf-9805-58d2-b4df-21f3076f4ef3" :question/math-academy-id "q-95854" :question/problem "$\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x=\\frac{\\sqrt{2}}{\\sqrt{8}}\\int \\frac{1}{\\sqrt{{(\\frac{x}{\\sqrt{8}})}^{2}-1}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{\\sqrt{{(\\frac{x}{2\\sqrt{2}})}^{2}-1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2\\sqrt{2}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2\\sqrt{2}}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{2}}\\,⟹\\,\\text{d}x=2\\sqrt{2}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{{(\\frac{x}{2\\sqrt{2}})}^{2}-1}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 2\\sqrt{2}\\,\\text{d}u \\\\  & =\\sqrt{2}\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =\\sqrt{2}\\operatorname{arcosh}⁡u+C \\\\  & =\\sqrt{2}\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339458 :knowledge-point/_questions [{:knowledge-point/id #uuid "25d92a33-95e8-5860-b461-8291dac502d6" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3410c07a-9fd5-5a34-a131-2ef10206d2fd" :answer/type {:db/ident :answer.type/math} :answer/value "49\\operatorname{arsinh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339460} {:answer/id #uuid "541959be-7673-51f9-8af9-b828a3d2235d" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arsinh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339461} {:answer/id #uuid "254ff030-a1c6-5e81-bb54-cfc1d937efd3" :answer/type {:db/ident :answer.type/math} :answer/value "7\\operatorname{arcosh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339462} {:answer/id #uuid "e7ec53c4-c1b0-557f-98e4-d85f0d64d734" :answer/type {:db/ident :answer.type/math} :answer/value "49\\operatorname{arcosh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339463} {:answer/id #uuid "502cb510-2f8e-50c5-adbe-8fa621516a2f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arcosh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339464}] :answer-field/correct {:answer/id #uuid "254ff030-a1c6-5e81-bb54-cfc1d937efd3" :answer/type {:db/ident :answer.type/math} :answer/value "7\\operatorname{arcosh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339462} :answer-field/id #uuid "a6f72499-13de-523d-b447-bd766b4bac3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339459}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c062078b-bbdb-5c49-a729-2f13634ee383" :question/math-academy-id "q-95855" :question/problem "$\\int \\frac{7}{\\sqrt{{x}^{2}-49}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{7}{\\sqrt{{x}^{2}-49}}\\,\\text{d}x=\\int \\frac{1}{\\sqrt{{(\\frac{x}{7})}^{2}-1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{7})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{7}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{7}\\,⟹\\,\\text{d}x=7\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{7}{\\sqrt{{x}^{2}-49}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{{(\\frac{x}{7})}^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 7\\,\\text{d}u \\\\  & =7\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =7\\operatorname{arcosh}⁡u+C \\\\  & =7\\operatorname{arcosh}⁡(\\frac{x}{7})+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339465 :knowledge-point/_questions [{:knowledge-point/id #uuid "5aabe1c9-7a37-5b34-893f-9338f5c7c69a" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3eb13989-b580-5ceb-9b34-952783341e86" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/id #edb/ref 17592186339467} {:answer/id #uuid "c1e083c5-ad15-5b43-b462-87a5df5db6b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186339468} {:answer/id #uuid "16aad334-daaf-5153-9d31-97f7a98baa77" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186339469} {:answer/id #uuid "ad6018b4-68f5-5ed9-97eb-8226cb26ac66" :answer/type {:db/ident :answer.type/math} :answer/value "12\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186339470} {:answer/id #uuid "a2ea3755-6328-5188-aa27-cd07e9b833aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186339471}] :answer-field/correct {:answer/id #uuid "16aad334-daaf-5153-9d31-97f7a98baa77" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186339469} :answer-field/id #uuid "08d2dcf8-dc2b-5a59-a779-289e4186a4de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339466}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e8e55ec-821d-58af-9dc6-39f20d66e28f" :question/math-academy-id "q-95858" :question/problem "$\\int \\frac{12}{1-16{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $16{x}^{2}=(4x)^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\frac{1}{4}\\,\\text{d}u=\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{12}{1-16{x}^{2}}\\,\\text{d}x & =12\\int \\frac{1}{1-(4x)^{2}}\\,\\text{d}x \\\\  & =12\\int \\frac{1}{1-{u}^{2}}\\,\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =3\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u \\\\  & =3\\operatorname{artanh}⁡u+C \\\\  & =3\\operatorname{artanh}⁡4x+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|4x|<1.$"}] [{:db/id #edb/ref 17592186339472 :knowledge-point/_questions [{:knowledge-point/id #uuid "5aabe1c9-7a37-5b34-893f-9338f5c7c69a" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e978acd-288b-5b05-af8d-a7b6b6ed6185" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186339474} {:answer/id #uuid "779e7af1-747c-59a6-87b5-5835ed429120" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{artanh}⁡(\\frac{x}{9})+C" :db/id #edb/ref 17592186339475} {:answer/id #uuid "3bc5602f-d677-551b-bb82-0d873864ceed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186339476} {:answer/id #uuid "9174023a-a0c8-5a3d-88fe-b23ed83dd206" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186339477} {:answer/id #uuid "dca34719-245c-55ea-8c80-f09402600d49" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡(\\frac{x}{9})+C" :db/id #edb/ref 17592186339478}] :answer-field/correct {:answer/id #uuid "9174023a-a0c8-5a3d-88fe-b23ed83dd206" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186339477} :answer-field/id #uuid "7394353d-8173-54ea-9739-4ddfdba37312" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339473}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5b5165ca-4771-5864-bc67-438e95d970c2" :question/math-academy-id "q-95863" :question/problem "$\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x=\\frac{5}{9}\\int \\frac{1}{1-{(\\frac{x}{3})}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{3})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x & =\\frac{5}{9}\\int \\frac{1}{1-{(\\frac{x}{3})}^{2}}\\,\\text{d}x \\\\  & =\\frac{5}{9}\\int \\frac{1}{1-{u}^{2}}\\cdot 3\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =\\frac{5}{3}\\operatorname{artanh}⁡u+C \\\\  & =\\frac{5}{3}\\operatorname{artanh}⁡(\\frac{x}{3})+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{3}|<1.$"}] [{:db/id #edb/ref 17592186339479 :knowledge-point/_questions [{:knowledge-point/id #uuid "5aabe1c9-7a37-5b34-893f-9338f5c7c69a" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7085d358-6b90-5706-96be-8f39972123a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{artanh}⁡4x+C" :db/id #edb/ref 17592186339481} {:answer/id #uuid "4fb05fc4-6bee-592a-ab69-a5da5be82b89" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}\\operatorname{artanh}⁡3x+C" :db/id #edb/ref 17592186339482} {:answer/id #uuid "9a79dc7a-cf5a-5a5d-bdfc-6af53ae05ce3" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/id #edb/ref 17592186339483} {:answer/id #uuid "c7235a27-7b9f-5b0b-a04b-9fca5abd82f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/id #edb/ref 17592186339484} {:answer/id #uuid "4200ea3e-a8e6-51f1-9c6f-0196065aff50" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/id #edb/ref 17592186339485}] :answer-field/correct {:answer/id #uuid "4200ea3e-a8e6-51f1-9c6f-0196065aff50" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/id #edb/ref 17592186339485} :answer-field/id #uuid "240ecd8c-2754-5396-bb93-ee35f07cc0d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339480}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fa82baaa-7364-5489-bf98-1f37bf871495" :question/math-academy-id "q-95864" :question/problem "$\\int \\frac{12}{16-{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{12}{16-{x}^{2}}\\,\\text{d}x=\\frac{3}{4}\\int \\frac{1}{1-{(\\frac{x}{4})}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{4})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{12}{16-{x}^{2}}\\,\\text{d}x & =\\frac{3}{4}\\int \\frac{1}{1-{(\\frac{x}{4})}^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 4\\,\\text{d}u \\\\  & =3\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =3\\operatorname{artanh}⁡u+C \\\\  & =3\\operatorname{artanh}⁡(\\frac{x}{4})+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{4}|<1.$"}] [{:db/id #edb/ref 17592186339486 :knowledge-point/_questions [{:knowledge-point/id #uuid "5aabe1c9-7a37-5b34-893f-9338f5c7c69a" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1959cc2f-b6e3-562d-92c9-3c73cddc9719" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\sqrt{7}}\\operatorname{artanh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339488} {:answer/id #uuid "603aa8ca-e92e-569a-a0d8-325560fdca22" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{7}\\operatorname{artanh}⁡(\\frac{x}{\\sqrt{7}})+C" :db/id #edb/ref 17592186339489} {:answer/id #uuid "0f97e385-ce09-5214-b6d7-f33e7506c033" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}\\operatorname{artanh}⁡(\\frac{x}{\\sqrt{7}})+C" :db/id #edb/ref 17592186339490} {:answer/id #uuid "4a300a4e-5d98-53e2-a1bf-7a81608fc6bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{artanh}⁡(\\frac{x}{7})+C" :db/id #edb/ref 17592186339491} {:answer/id #uuid "bedebc53-e495-5548-9390-d170904112f3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{artanh}⁡(\\frac{x}{\\sqrt{7}})+C" :db/id #edb/ref 17592186339492}] :answer-field/correct {:answer/id #uuid "603aa8ca-e92e-569a-a0d8-325560fdca22" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{7}\\operatorname{artanh}⁡(\\frac{x}{\\sqrt{7}})+C" :db/id #edb/ref 17592186339489} :answer-field/id #uuid "ba397297-6aab-59f7-bafb-e4e82d9c667d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339487}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "63f88d2d-e0a5-58aa-8d4f-7feb7d35904b" :question/math-academy-id "q-95865" :question/problem "$\\int \\frac{21}{7-{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{21}{7-{x}^{2}}\\,\\text{d}x=3\\int \\frac{1}{1-{(\\frac{x}{\\sqrt{7}})}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{\\sqrt{7}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{7}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{7}}\\,⟹\\,\\text{d}x=\\sqrt{7}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\int \\frac{21}{7-{x}^{2}}\\,\\text{d}x & =3\\int \\frac{1}{1-{(\\frac{x}{\\sqrt{7}})}^{2}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{1-{u}^{2}}\\cdot \\sqrt{7}\\,\\text{d}u \\\\  & =3\\sqrt{7}\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =3\\sqrt{7}\\operatorname{artanh}⁡u+C \\\\  & =3\\sqrt{7}\\operatorname{artanh}⁡(\\frac{x}{\\sqrt{7}})+C\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{\\sqrt{7}}|<1.$"}] [{:db/id #edb/ref 17592186339493 :knowledge-point/_questions [{:knowledge-point/id #uuid "5aabe1c9-7a37-5b34-893f-9338f5c7c69a" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8e7f6a1-d6ce-5cea-81d4-b07c604eb64b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/id #edb/ref 17592186339495} {:answer/id #uuid "f14506bf-f683-51c7-ab02-e6ef3da1193e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{artanh}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186339496} {:answer/id #uuid "93f6378e-c665-55c4-a3c2-c610d5d4709c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/id #edb/ref 17592186339497} {:answer/id #uuid "066cd1ea-3c9f-564e-b4c2-3d2e14f94bdf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{artanh}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186339498} {:answer/id #uuid "9f5541fd-fe5a-54d5-b4e8-5db88dba990a" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/id #edb/ref 17592186339499}] :answer-field/correct {:answer/id #uuid "f14506bf-f683-51c7-ab02-e6ef3da1193e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{artanh}⁡(\\frac{x}{2})+C" :db/id #edb/ref 17592186339496} :answer-field/id #uuid "e32ebdff-d5ea-5762-937b-2fc2a5d1977c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339494}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "12a5c105-0a97-59bc-b4b6-006716adb140" :question/math-academy-id "q-95866" :question/problem "$\\int \\frac{2}{4-{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{2}{4-{x}^{2}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{1-{(\\frac{x}{2})}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{4-{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{1-{(\\frac{x}{2})}^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1-{u}^{2}}\\cdot 2\\,\\text{d}u \\\\  & =\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =\\operatorname{artanh}⁡u+C \\\\  & =\\operatorname{artanh}⁡(\\frac{x}{2})+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{2}|<1.$"}] [{:db/id #edb/ref 17592186339500 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd13fafc-d765-5e44-aa5a-79c2fff71212" :knowledge-point/title "Calculating Definite Integrals Using Substitution With Inverse Hyperbolic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d295de2a-f151-50d6-9c3c-d1d8cc95e2f1" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡(5+\\sqrt{2})" :db/id #edb/ref 17592186339502} {:answer/id #uuid "26403460-332c-53ce-b62d-a6604876997b" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡(2+\\sqrt{2})" :db/id #edb/ref 17592186339503} {:answer/id #uuid "5888cbbf-5764-541d-8aeb-53a61dd72a87" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡(2+\\sqrt{5})" :db/id #edb/ref 17592186339504} {:answer/id #uuid "7ff2d026-ff65-5507-ae35-5cbad9f96d5a" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡(3+\\sqrt{5})" :db/id #edb/ref 17592186339505} {:answer/id #uuid "2d905c41-9b7e-5b57-95fe-2b2d0a6d890a" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡(5+\\sqrt{3})" :db/id #edb/ref 17592186339506}] :answer-field/correct {:answer/id #uuid "5888cbbf-5764-541d-8aeb-53a61dd72a87" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡(2+\\sqrt{5})" :db/id #edb/ref 17592186339504} :answer-field/id #uuid "e07e4bd8-efdc-5500-8eb2-b0e64edd79f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339501}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d152ec8f-5780-567c-ae16-c5ae13de3aed" :question/math-academy-id "q-95899" :question/problem "Evaluate the integral ${\\int }_{0}^{4}\\frac{8}{\\sqrt{{x}^{2}+4}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{4}\\frac{8}{\\sqrt{{x}^{2}+4}}\\,\\text{d}x=4{\\int }_{0}^{4}\\frac{1}{\\sqrt{{(\\frac{x}{2})}^{2}+1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse hyperbolic sine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}+1}}\\,\\text{d}u=\\operatorname{arsinh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $4$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}\\frac{8}{\\sqrt{{x}^{2}+4}}\\,\\text{d}x & =4{\\int }_{0}^{4}\\frac{1}{\\sqrt{{(\\frac{x}{2})}^{2}+1}}\\,\\text{d}x \\\\  & =4{\\int }_{0}^{2}\\frac{1}{\\sqrt{{u}^{2}+1}}\\cdot (2\\,\\text{d}u) \\\\  & =8{\\int }_{0}^{2}\\frac{\\text{d}u}{\\sqrt{{u}^{2}+1}} \\\\  & =8\\operatorname{arsinh}⁡u{|}_{0}^{2} \\\\  & =8\\operatorname{arsinh}⁡2-8\\operatorname{arsinh}⁡0 \\\\  & =8\\operatorname{arsinh}⁡2 \\\\  & =8\\operatorname{ln}⁡(2+\\sqrt{{2}^{2}+1}) \\\\  & =8\\operatorname{ln}⁡(2+\\sqrt{5})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339507 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd13fafc-d765-5e44-aa5a-79c2fff71212" :knowledge-point/title "Calculating Definite Integrals Using Substitution With Inverse Hyperbolic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8138c0c3-616d-5658-b990-19605f10eed4" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡(\\frac{\\sqrt{3}+11}{2})" :db/id #edb/ref 17592186339509} {:answer/id #uuid "55ac6216-a96c-5343-8301-cc21053a58bd" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(\\frac{\\sqrt{3}+\\sqrt{11}}{2\\sqrt{3}+\\sqrt{2}})" :db/id #edb/ref 17592186339510} {:answer/id #uuid "6a0d136a-059b-5695-919f-7ff2916d45cc" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡(\\frac{2\\sqrt{3}+\\sqrt{11}}{\\sqrt{3}+\\sqrt{2}})" :db/id #edb/ref 17592186339511} {:answer/id #uuid "c950bb2e-560a-50d3-9817-15b83bc9d20e" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡(\\frac{\\sqrt{3}+\\sqrt{11}}{2})" :db/id #edb/ref 17592186339512} {:answer/id #uuid "44aefa4d-4618-548d-9153-75c833f17991" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡(\\frac{\\sqrt{3}+\\sqrt{11}}{4})" :db/id #edb/ref 17592186339513}] :answer-field/correct {:answer/id #uuid "6a0d136a-059b-5695-919f-7ff2916d45cc" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{ln}⁡(\\frac{2\\sqrt{3}+\\sqrt{11}}{\\sqrt{3}+\\sqrt{2}})" :db/id #edb/ref 17592186339511} :answer-field/id #uuid "470f8280-d808-502c-9782-4fcc20a4c1fb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339508}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "b76a3529-18ed-5306-b58f-30d89bf12248" :question/math-academy-id "q-95900" :question/problem "Evaluate the integral ${\\int }_{3}^{6}\\frac{9}{\\sqrt{{x}^{2}-3}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{3}^{6}\\frac{9}{\\sqrt{{x}^{2}-3}}\\,\\text{d}x=3\\sqrt{3}{\\int }_{3}^{6}\\frac{1}{\\sqrt{{(\\frac{x}{\\sqrt{3}})}^{2}-1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{\\sqrt{3}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{3}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $3$ | $6$ |\n| --- | --- | --- |\n| $u$ | $\\sqrt{3}$ | $2\\sqrt{3}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{3}^{6}\\frac{9}{\\sqrt{{x}^{2}-3}}\\,\\text{d}x & =3\\sqrt{3}{\\int }_{3}^{6}\\frac{1}{\\sqrt{{(\\frac{x}{\\sqrt{3}})}^{2}-1}}\\,\\text{d}x \\\\  & =3\\sqrt{3}{\\int }_{\\sqrt{3}}^{2\\sqrt{3}}\\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot (\\sqrt{3}\\,\\text{d}u) \\\\  & =9{\\int }_{\\sqrt{3}}^{2\\sqrt{3}}\\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =9\\operatorname{arcosh}⁡u{|}_{\\sqrt{3}}^{2\\sqrt{3}} \\\\  & =9(\\operatorname{arcosh}⁡2\\sqrt{3}-\\operatorname{arcosh}⁡\\sqrt{3}) \\\\  & =9(\\operatorname{ln}⁡(2\\sqrt{3}+\\sqrt{{(2\\sqrt{3})}^{2}-1})-\\operatorname{ln}⁡(\\sqrt{3}+\\sqrt{{(\\sqrt{3})}^{2}-1})) \\\\  & =9(\\operatorname{ln}⁡(2\\sqrt{3}+\\sqrt{11})-\\operatorname{ln}⁡(\\sqrt{3}+\\sqrt{2})) \\\\  & =9\\operatorname{ln}⁡(\\frac{2\\sqrt{3}+\\sqrt{11}}{\\sqrt{3}+\\sqrt{2}})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339514 :knowledge-point/_questions [{:knowledge-point/id #uuid "20b69474-34f6-5539-accf-5ebfc4f6eb0a" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution With Inverse Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "443fa514-7bbb-591a-af19-1e89a638d9c7" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{arsinh}⁡6x+C" :db/id #edb/ref 17592186339516} {:answer/id #uuid "089c9899-5f33-58a3-81f7-4e6fbc35e5be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arsinh}⁡6x+C" :db/id #edb/ref 17592186339517} {:answer/id #uuid "dd6ea4fe-3aaf-59d5-9e3b-f666ab947ed7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arcosh}⁡6x+C" :db/id #edb/ref 17592186339518} {:answer/id #uuid "d4230a49-7a8c-5bd6-aed3-3af3bd062151" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\operatorname{arcosh}⁡6x+C" :db/id #edb/ref 17592186339519} {:answer/id #uuid "ad31fe89-d1a3-5778-9e80-9861035a9bc9" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{arsinh}⁡6x+C" :db/id #edb/ref 17592186339520}] :answer-field/correct {:answer/id #uuid "089c9899-5f33-58a3-81f7-4e6fbc35e5be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{arsinh}⁡6x+C" :db/id #edb/ref 17592186339517} :answer-field/id #uuid "5fa3d2d1-1e52-57f2-ab28-2cdfbd0662e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339515}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c09a1aa7-52df-5b5a-9698-4d7d1276c73c" :question/math-academy-id "q-96964" :question/problem "$\\int \\frac{3}{\\sqrt{36{x}^{2}+1}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for the inverse hyperbolic sine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}+1}}\\,\\text{d}u=\\operatorname{arsinh}⁡u+C.\n$$\n\n \n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $36{x}^{2}=(6x)^{2}.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{\\sqrt{36{x}^{2}+1}}\\,\\text{d}x & =\\int \\frac{3}{\\sqrt{(6x)^{2}+1}}\\,\\text{d}x \\\\  & =\\int \\frac{3}{\\sqrt{{u}^{2}+1}}\\,\\cdot (\\frac{1}{6}\\,\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{{u}^{2}+1}}\\,\\text{d}u \\\\  & =\\frac{1}{2}\\operatorname{arsinh}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arsinh}⁡6x+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339521 :knowledge-point/_questions [{:knowledge-point/id #uuid "dd13fafc-d765-5e44-aa5a-79c2fff71212" :knowledge-point/title "Calculating Definite Integrals Using Substitution With Inverse Hyperbolic Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af760edd-6aa7-586b-99fc-58da2500efe0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(6+\\sqrt{3})" :db/id #edb/ref 17592186339523} {:answer/id #uuid "84810f5f-bec8-5489-b25b-8cc1ab7b4340" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2+\\sqrt{6})" :db/id #edb/ref 17592186339524} {:answer/id #uuid "47e03339-bcfc-5551-b012-e0bf849db2fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(2+\\sqrt{3})" :db/id #edb/ref 17592186339525} {:answer/id #uuid "b04a35ab-9efe-5627-ba2e-8b3584673ee8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1+\\sqrt{6})" :db/id #edb/ref 17592186339526} {:answer/id #uuid "4bb7b8ad-0b1a-5170-adec-ddfeceaa7ec8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1+\\sqrt{2})" :db/id #edb/ref 17592186339527}] :answer-field/correct {:answer/id #uuid "4bb7b8ad-0b1a-5170-adec-ddfeceaa7ec8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(1+\\sqrt{2})" :db/id #edb/ref 17592186339527} :answer-field/id #uuid "75c7f5cf-d06e-5906-8467-fe75c4149778" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339522}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5b3f91e3-21ba-5093-99c3-24c8174787f1" :question/math-academy-id "q-96968" :question/problem "Evaluate the integral ${\\int }_{0}^{6}\\frac{1}{\\sqrt{{x}^{2}+36}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{6}\\frac{1}{\\sqrt{{x}^{2}+36}}\\,\\text{d}x=\\frac{1}{6}{\\int }_{0}^{6}\\frac{1}{\\sqrt{{(\\frac{x}{6})}^{2}+1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse hyperbolic sine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}+1}}\\,\\text{d}u=\\operatorname{arsinh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{6})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{6}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{6}\\,⟹\\,\\text{d}x=6\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $6$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}\\frac{1}{\\sqrt{{x}^{2}+36}}\\,\\text{d}x & =\\frac{1}{6}{\\int }_{0}^{6}\\frac{1}{\\sqrt{{(\\frac{x}{6})}^{2}+1}}\\,\\text{d}x \\\\  & =\\frac{1}{6}{\\int }_{0}^{1}\\frac{1}{\\sqrt{{u}^{2}+1}}\\cdot (6\\,\\text{d}u) \\\\  & ={\\int }_{0}^{1}\\frac{\\text{d}u}{\\sqrt{{u}^{2}+1}} \\\\  & =\\operatorname{arsinh}⁡u{|}_{0}^{1} \\\\  & =\\operatorname{arsinh}⁡1-\\operatorname{arsinh}⁡0 \\\\  & =\\operatorname{arsinh}⁡1 \\\\  & =\\operatorname{ln}⁡(1+\\sqrt{{1}^{2}+1}) \\\\  & =\\operatorname{ln}⁡(1+\\sqrt{2})\\end{aligned}\n$$"}]}
