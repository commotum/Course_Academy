rac{7}{\\sqrt{{x}^{2}-49}}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{{(\\frac{x}{7})}^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 7\\,\\text{d}u \\\\  & =7\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =7\\operatorname{arcosh}⁡u+C \\\\  & =7\\operatorname{arcosh}⁡(\\frac{x}{7})+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95855/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "25d92a33-95e8-5860-b461-8291dac502d6"] :knowledge-point/questions ["q-95855"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95854/selection/b9f4e7be342b6cd37c8308aae60535d8eeecf8f35e437a5f85ec7a9c5aaa122c" :answer/id #uuid "2caae60e-37dd-5b4e-a422-5fcb70e994d5" :answer/type :answer.type/math :answer/value "2\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "q-95854/selection/76b06842f999962dcf1a12ad42b0347a2eb89b9f4c9e2a585a72ebe4491694ee" :answer/id #uuid "30fbcadc-67a9-53a1-ae8e-fe36d9925a98" :answer/type :answer.type/math :answer/value "\\sqrt{2}\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "q-95854/selection/6a17b9c361ec22099cc1469ce14b88340e9f77f00d782cb442d1e6d0416d9119" :answer/id #uuid "dd0f1e61-1993-5e93-8511-d244d96d7d2c" :answer/type :answer.type/math :answer/value "\\sqrt{2}\\operatorname{arsinh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "q-95854/selection/804b0c24f717e511a45b5ef59ae925f378928eec0c08fa4e37fca7e3d99bb787" :answer/id #uuid "ac4c96fb-fd7e-50c9-97b9-5a18c9ad29f9" :answer/type :answer.type/math :answer/value "-\\sqrt{2}\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "q-95854/selection/853f50f55b6425c76ad19e5ef2e81fcdb4cc6e2239b1876a8650ffad81d23b09" :answer/id #uuid "e526b12e-5146-524b-bf34-731bf30f6e50" :answer/type :answer.type/math :answer/value "-2\\operatorname{arsinh}⁡(\\frac{x}{2\\sqrt{2}})+C" :db/ensure [:answer/validate]} {:db/id "q-95854/selection" :answer-field/id #uuid "a063d804-1d14-594f-b063-6f194261337e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95854/selection/76b06842f999962dcf1a12ad42b0347a2eb89b9f4c9e2a585a72ebe4491694ee" :answer-field/choices ["q-95854/selection/b9f4e7be342b6cd37c8308aae60535d8eeecf8f35e437a5f85ec7a9c5aaa122c" "q-95854/selection/76b06842f999962dcf1a12ad42b0347a2eb89b9f4c9e2a585a72ebe4491694ee" "q-95854/selection/6a17b9c361ec22099cc1469ce14b88340e9f77f00d782cb442d1e6d0416d9119" "q-95854/selection/804b0c24f717e511a45b5ef59ae925f378928eec0c08fa4e37fca7e3d99bb787" "q-95854/selection/853f50f55b6425c76ad19e5ef2e81fcdb4cc6e2239b1876a8650ffad81d23b09"] :db/ensure [:answer-field/validate]} {:db/id "q-95854" :question/id #uuid "85a483cf-9805-58d2-b4df-21f3076f4ef3" :question/math-academy-id "q-95854" :question/problem "$\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x=\\frac{\\sqrt{2}}{\\sqrt{8}}\\int \\frac{1}{\\sqrt{{(\\frac{x}{\\sqrt{8}})}^{2}-1}}\\,\\text{d}x=\\frac{1}{2}\\int \\frac{1}{\\sqrt{{(\\frac{x}{2\\sqrt{2}})}^{2}-1}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic cosine,\n\n$$\n\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\,\\text{d}u=\\operatorname{arcosh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{2\\sqrt{2}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{2\\sqrt{2}}.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{2}}\\,⟹\\,\\text{d}x=2\\sqrt{2}\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\sqrt{2}}{\\sqrt{{x}^{2}-8}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{{(\\frac{x}{2\\sqrt{2}})}^{2}-1}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{\\sqrt{{u}^{2}-1}}\\cdot 2\\sqrt{2}\\,\\text{d}u \\\\  & =\\sqrt{2}\\int \\frac{\\text{d}u}{\\sqrt{{u}^{2}-1}} \\\\  & =\\sqrt{2}\\operatorname{arcosh}⁡u+C \\\\  & =\\sqrt{2}\\operatorname{arcosh}⁡(\\frac{x}{2\\sqrt{2}})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95854/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "25d92a33-95e8-5860-b461-8291dac502d6"] :knowledge-point/questions ["q-95854"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186167295 :question/answer-fields 17592186165318] {:db/id "q-95432/selection/ma-v1/e1d002a9ebb0209c07d86823bb9c288fe660dfefae199672f9733cf5516d2005/63b360654918c2c242d718047e35587eb754c8df060b6f85cdedadf390c370d2" :answer/id #uuid "6d199c02-d18e-57db-9851-63dbd1a166bc" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arcosh}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-95432/selection/ma-v1/e1d002a9ebb0209c07d86823bb9c288fe660dfefae199672f9733cf5516d2005/d3f83bcd8479f8882def795af4f1b85aae9272fcb8fd18efe447f921f0af4b3f" :answer/id #uuid "4e76b3e6-93f6-5187-a538-b2844161d7d2" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arsinh}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-95432/selection/ma-v1/e1d002a9ebb0209c07d86823bb9c288fe660dfefae199672f9733cf5516d2005/d5c9f011e6af098ee3bf4f6847fd705010f434f08d2655d3a6f24c849e735685" :answer/id #uuid "d511bc7d-00b3-5dd0-8e53-44b381f00a25" :answer/type :answer.type/math :answer/value "4\\operatorname{arsinh}⁡(\\frac{x}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-95432/selection/ma-v1/e1d002a9ebb0209c07d86823bb9c288fe660dfefae199672f9733cf5516d2005/347ddb4fb7ec002469e97beb00f37696de371464e169db6572c3d9e59218098c" :answer/id #uuid "6f953e3a-f202-578a-90a7-7e4516afb7f7" :answer/type :answer.type/math :answer/value "\\frac{1}{16}\\operatorname{arcosh}⁡4x+C" :db/ensure [:answer/valid