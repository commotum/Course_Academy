qrt{7}})}^{2}}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{1-{u}^{2}}\\cdot \\sqrt{7}\\,\\text{d}u \\\\  & =3\\sqrt{7}\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =3\\sqrt{7}\\operatorname{artanh}⁡u+C \\\\  & =3\\sqrt{7}\\operatorname{artanh}⁡(\\frac{x}{\\sqrt{7}})+C\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{\\sqrt{7}}|<1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95865/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5aabe1c9-7a37-5b34-893f-9338f5c7c69a"] :knowledge-point/questions ["q-95865"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95864/selection/50746e19db653521239b91415175e5b800e6eb47ac893b99bc378002a8214be4" :answer/id #uuid "4fb05fc4-6bee-592a-ab69-a5da5be82b89" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\operatorname{artanh}⁡3x+C" :db/ensure [:answer/validate]} {:db/id "q-95864/selection/801410b1d32ca5faf2affc7a83563e533659c0a49ed16b0292f469ef57508197" :answer/id #uuid "9a79dc7a-cf5a-5a5d-bdfc-6af53ae05ce3" :answer/type :answer.type/math :answer/value "4\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-95864/selection/e46fe9cbb8761f960b2a77060082e7c5b6d52df18fe9710c61bf2c2e81c99fe4" :answer/id #uuid "4200ea3e-a8e6-51f1-9c6f-0196065aff50" :answer/type :answer.type/math :answer/value "3\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-95864/selection/130356be0489025978c81edfab682d47e1333bdd1049871d4ffec1541e220599" :answer/id #uuid "7085d358-6b90-5706-96be-8f39972123a9" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{artanh}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-95864/selection/a88b8d42b12655a8964c15195e6e15266cddbfd7ded799c9304bd89ff4b5040b" :answer/id #uuid "c7235a27-7b9f-5b0b-a04b-9fca5abd82f6" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\operatorname{artanh}⁡(\\frac{x}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-95864/selection" :answer-field/id #uuid "240ecd8c-2754-5396-bb93-ee35f07cc0d7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95864/selection/e46fe9cbb8761f960b2a77060082e7c5b6d52df18fe9710c61bf2c2e81c99fe4" :answer-field/choices ["q-95864/selection/50746e19db653521239b91415175e5b800e6eb47ac893b99bc378002a8214be4" "q-95864/selection/801410b1d32ca5faf2affc7a83563e533659c0a49ed16b0292f469ef57508197" "q-95864/selection/e46fe9cbb8761f960b2a77060082e7c5b6d52df18fe9710c61bf2c2e81c99fe4" "q-95864/selection/130356be0489025978c81edfab682d47e1333bdd1049871d4ffec1541e220599" "q-95864/selection/a88b8d42b12655a8964c15195e6e15266cddbfd7ded799c9304bd89ff4b5040b"] :db/ensure [:answer-field/validate]} {:db/id "q-95864" :question/id #uuid "fa82baaa-7364-5489-bf98-1f37bf871495" :question/math-academy-id "q-95864" :question/problem "$\\int \\frac{12}{16-{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{12}{16-{x}^{2}}\\,\\text{d}x=\\frac{3}{4}\\int \\frac{1}{1-{(\\frac{x}{4})}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{4})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{12}{16-{x}^{2}}\\,\\text{d}x & =\\frac{3}{4}\\int \\frac{1}{1-{(\\frac{x}{4})}^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{4}\\int \\frac{1}{1-{u}^{2}}\\cdot 4\\,\\text{d}u \\\\  & =3\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =3\\operatorname{artanh}⁡u+C \\\\  & =3\\operatorname{artanh}⁡(\\frac{x}{4})+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{4}|<1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95864/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5aabe1c9-7a37-5b34-893f-9338f5c7c69a"] :knowledge-point/questions ["q-95864"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95863/selection/aa709e3a4d06bad4896c13c2bd62ee5422d2e2a6fc7d496e28feab1c7c70fe36" :answer/id #uuid "dca34719-245c-55ea-8c80-f09402600d49" :answer/type :answer.type/math :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡(\\frac{x}{9})+C" :db/ensure [:answer/validate]} {:db/id "q-95863/selection/33e46cc75012da4dc185c165efd5d5206785455bb82c40952733d72948213e3b" :answer/id #uuid "8e978acd-288b-5b05-af8d-a7b6b6ed6185" :answer/type :answer.type/math :answer/value "5\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-95863/selection/87f030f1bd7b5b64e7524a449e2489870c6a8d3a42f1820ee10063a6d74a343e" :answer/id #uuid "3bc5602f-d677-551b-bb82-0d873864ceed" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-95863/selection/8c3a1bd5f08ed7ba0a82cf402ac445ba727a63dbe3af20d4b2c1e192aae13154" :answer/id #uuid "9174023a-a0c8-5a3d-88fe-b23ed83dd206" :answer/type :answer.type/math :answer/value "\\frac{5}{3}\\operatorname{artanh}⁡(\\frac{x}{3})+C" :db/ensure [:answer/validate]} {:db/id "q-95863/selection/4fa0b1985b4f3a5a8ad02dea6c17de5afd4bf4a99299d596e9d275e56507642f" :answer/id #uuid "779e7af1-747c-59a6-87b5-5835ed429120" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{artanh}⁡(\\frac{x}{9})+C" :db/ensure [:answer/validate]} {:db/id "q-95863/selection" :answer-field/id #uuid "7394353d-8173-54ea-9739-4ddfdba37312" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95863/selection/8c3a1bd5f08ed7ba0a82cf402ac445ba727a63dbe3af20d4b2c1e192aae13154" :answer-field/choices ["q-95863/selection/aa709e3a4d06bad4896c13c2bd62ee5422d2e2a6fc7d496e28feab1c7c70fe36" "q-95863/selection/33e46cc75012da4dc185c165efd5d5206785455bb82c40952733d72948213e3b" "q-95863/selection/87f030f1bd7b5b64e7524a449e2489870c6a8d3a42f1820ee10063a6d74a343e" "q-95863/selection/8c3a1bd5f08ed7ba0a82cf402ac445ba727a63dbe3af20d4b2c1e192aae13154" "q-95863/selection/4fa0b1985b4f3a5a8ad02dea6c17de5afd4bf4a99299d596e9d275e56507642f"] :db/ensure [:answer-field/validate]} {:db/id "q-95863" :question/id #uuid "5b5165ca-4771-5864-bc67-438e95d970c2" :question/math-academy-id "q-95863" :question/problem "$\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x=\\frac{5}{9}\\int \\frac{1}{1-{(\\frac{x}{3})}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for the inverse hyperbolic tangent,\n\n$$\n\\int \\frac{1}{1-{u}^{2}}\\,\\text{d}u=\\operatorname{artanh}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{3})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and compute it, as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{9-{x}^{2}}\\,\\text{d}x & =\\frac{5}{9}\\int \\frac{1}{1-{(\\frac{x}{3})}^{2}}\\,\\text{d}x \\\\  & =\\frac{5}{9}\\int \\frac{1}{1-{u}^{2}}\\cdot 3\\,\\text{d}u \\\\  & =\\frac{5}{3}\\int \\frac{\\text{d}u}{1-{u}^{2}} \\\\  & =\\frac{5}{3}\\operatorname{artanh}⁡u+C \\\\  & =\\frac{5}{3}\\operatorname{artanh}⁡(\\frac{x}{3})+C\\end{aligned}\\end{aligned}\n$$\n\nNote that this result is subject to the condition $|\\frac{x}{3}|<1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95863/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5