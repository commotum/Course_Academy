/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334709" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "25.615"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334709" "field" "field-4" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334709" "field" "field-4" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "3"] ["math" "4"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334709" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334745" "field" nil "attribute" "question/problem" "value" "Which of the following global truncation error expressions represent a fourth-order numerical method?\n\n- $e(Δx)=4(Δx)^{4}+2(Δx)^{7}$\n- $e(Δx)=11(Δx)^{5}+0.5(Δx)^{6}$\n- $e(Δx)=0.2Δx+6(Δx)^{4}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334745" "field" nil "attribute" "question/worked-solution" "value" "A numerical method has order $p$ if $p$ is the largest positive integer such that the global truncation error (GTE) satisfies\n\n$$\ne(Δx)=O\\,((Δx)^{p})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nWith that in mind, let's check each option in turn:\n\n- For $e(Δx)=4(Δx)^{4}+2(Δx)^{7},$ the dominant term as $Δx\\to 0$ is $4(Δx)^{4}.$ So, statement I corresponds to an order $4$ method.\n\n- For $e(Δx)=11(Δx)^{5}+0.5(Δx)^{6},$ the dominant term as $Δx\\to 0$ is $11(Δx)^{5}.$ So, statement II corresponds to an order $5$ method.\n\n- For $e(Δx)=0.2Δx+6(Δx)^{4},$ the dominant term as $Δx\\to 0$ is $0.2Δx.$ So, statement III corresponds to an order $1$ method.\n\nTherefore, the correct answer is \"I only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334745" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/activity-metadata.json" "file_sha256" "7ce08aeeb11d94c29c390cfc34100b4d2ca03b5ef79f07200dad7f4a3990f0c9"} {"question" "q-334745" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334745" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334745" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334947" "field" nil "attribute" "question/problem" "value" "A numerical method for approximating a solution to an initial value problem is known to be order $4.$  Suppose that using step size $Δx=0.4$ produces a local truncation error (LTE) of $τ(0.4)≈1.024.$  If we instead use a step size $Δx=0.1,$ what LTE should we expect?\n\n$τ(0.1)≈$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334947" "field" nil "attribute" "question/worked-solution" "value" "A numerical method has order $p$ if $p$ is the largest positive integer such that the local truncation error (LTE) satisfies\n\n$$\nτ(Δx)=O\\,((Δx)^{p+1})\\,\\text{as}\\,Δx\\to 0.\n$$\n\nThe order describes how fast errors shrink as $Δx$ decreases.\n\nIn other words, a numerical method has order $p$ if, for sufficiently small step sizes, reducing the step size by a factor of $k$ reduces the LTE by a factor of approximately ${k}^{p+1}.$\n\nIn our case, the step size decreases from $0.4$ to $0.1.$ So, it reduces by a factor of\n\n$$\nk=\\frac{0.4}{0.1}=4.\n$$\n\nNow, since the numerical method is of order $4,$ the error is expected to decrease by a factor of\n\n$$\n{k}^{4+1}={4}^{5}=1024.\n$$\n\nTherefore, using a step size of $Δx=0.1,$ the expected LTE is\n\n$$\nτ(0.1)≈\\frac{1.024}{1024}=0.001.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334947" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/activity-metadata.json" "file_sha256" "7ce08aeeb11d94c29c390cfc34100b4d2ca03b5ef79f07200dad7f4a3990f0c9"} {"question" "q-334947" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"} {"question" "q-334947" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0.001"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070331/state.json" "file_sha256" "9f8639307f61ca296a9429a1925cbc7a1ad1f045d38fc20880ff40e8dc2e2056"}] "usage" {} "basis" 2516 "retractions" [] "immutable_answers" [] "immutable_fields" [] "no_history" []}
