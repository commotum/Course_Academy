7" "q-340465/selection/c8e4f988e557da731109ff6c99f8debf88c1c7c73daf641931604ad0812eb750" "q-340465/selection/f7715dddacc54a1b928a32daeeb8f94c5df4274e5050a7a7939440b83c4cb80b" "q-340465/selection/a9026a60299bf38657c76d2df0f509b2fafddaf373645a6ebb4c0d4827aeac35"] :db/ensure [:answer-field/validate]} {:db/id "q-340465" :question/id #uuid "9f0ca935-919b-51f7-aa7b-48465faaebbd" :question/math-academy-id "q-340465" :question/problem "$\\int \\operatorname{sin}⁡(10x)\\operatorname{sin}⁡(x)\\,\\text{d}x=$" :question/worked-solution "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(10x)\\operatorname{sin}⁡(x) & =\\frac{1}{2}(\\operatorname{cos}⁡(10x-x)-\\operatorname{cos}⁡(10x+x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(9x)-\\operatorname{cos}⁡(11x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}\\int \\operatorname{sin}⁡(10x)\\operatorname{sin}⁡(x)\\,\\text{d}x & =\\int \\frac{1}{2}\\operatorname{cos}⁡(9x)-\\frac{1}{2}\\operatorname{cos}⁡(11x)\\,\\text{d}x \\\\  & =\\frac{1}{18}\\operatorname{sin}⁡(9x)-\\frac{1}{22}\\operatorname{sin}⁡(11x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340465/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8a371de4-7c3f-5687-bd3a-d3ab5ab803ce"] :knowledge-point/questions ["q-340465"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340469/selection/4d671e8a2c3b7e22cc2d0880f7294a7aa55ae1f86e5530a60b3c337629ffc46f" :answer/id #uuid "078dd2f5-6d1e-5134-ab23-ed8b80666df8" :answer/type :answer.type/math :answer/value "\\frac{1}{16}\\operatorname{sin}⁡(8x)+\\frac{1}{36}\\operatorname{sin}⁡(18x)+C" :db/ensure [:answer/validate]} {:db/id "q-340469/selection/470f4bcf224141f582c7dab4b99e41bc4667c9b4cc5b708d66ba7f4ff4915680" :answer/id #uuid "c8fde45f-7710-5109-9934-6ec671fe1832" :answer/type :answer.type/math :answer/value "\\frac{1}{8}\\operatorname{sin}⁡(8x)-\\frac{1}{18}\\operatorname{sin}⁡(18x)+C" :db/ensure [:answer/validate]} {:db/id "q-340469/selection/dd93a4168d89dc529336cb669e632ca1f85fd46ce7bb89d8f6e428230e8e4861" :answer/id #uuid "2689ca25-b3e2-51bc-8390-a64123e1a99e" :answer/type :answer.type/math :answer/value "\\frac{1}{16}\\operatorname{cos}⁡(8x)-\\frac{1}{36}\\operatorname{cos}⁡(18x)+C" :db/ensure [:answer/validate]} {:db/id "q-340469/selection/103ab39d2c72990ac423889a380eeb1b537e96c7c7a132c73ded6840a5b64208" :answer/id #uuid "160927bb-68f5-5755-9362-1d2f5420ea1f" :answer/type :answer.type/math :answer/value "\\frac{1}{16}\\operatorname{sin}⁡(18x)-\\frac{1}{36}\\operatorname{sin}⁡(8x)+C" :db/ensure [:answer/validate]} {:db/id "q-340469/selection/897c5ebf4c8e571c39de3909df3efb41b4a8bc68c6f711a56a43add7f09efc3e" :answer/id #uuid "6557a9b2-406d-5c7b-a4ac-73aed9cc88f3" :answer/type :answer.type/math :answer/value "\\frac{1}{16}\\operatorname{sin}⁡(8x)-\\frac{1}{36}\\operatorname{sin}⁡(18x)+C" :db/ensure [:answer/validate]} {:db/id "q-340469/selection" :answer-field/id #uuid "1c9485bf-03c7-57c2-a876-30440191b722" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :an