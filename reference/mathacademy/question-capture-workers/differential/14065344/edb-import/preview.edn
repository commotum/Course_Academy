}⁡(11x)]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{10}(\\operatorname{sin}⁡(\\frac{5\\pi }{2})-\\operatorname{sin}⁡(0))-\\frac{1}{22}(\\operatorname{sin}⁡(\\frac{11\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{10}(1-0)-\\frac{1}{22}(-1-0) \\\\  & =\\frac{8}{55}.\\end{aligned}\n$$" 13194139535465 true] [17592186350628 1000 #edb/ref 17592186350629 13194139535465 true] [17592186350628 1040 #edb/ref 17592186045449 13194139535465 true] [17592186350628 1041 "field-1" 13194139535465 true] [17592186350628 1104 #edb/ref 17592186350629 13194139535465 true] [17592186350628 1110 #uuid "6effd691-5287-5b89-9f0d-92c8725847d1" 13194139535465 true] [17592186350629 1034 "\\frac{8}{55}" 13194139535465 true] [17592186350629 1103 #edb/ref 17592186045453 13194139535465 true] [17592186350629 1111 #uuid "6e2c3ce8-147a-54d0-9b78-d30c68e2288b" 13194139535465 true]] :edb/tempids {"q-340465" 17592186350599 "q-340465/selection" 17592186350600 "q-340465/selection/344a17464f1ef98e7635b7d74f7a40ca74239e61d011cb3266c98ef64c1eeaf2" 17592186350601 "q-340465/selection/7254a33f15f7e925bd8f89e7cebd77afa4c70d8172536702611c9929e4c40927" 17592186350602 "q-340465/selection/a9026a60299bf38657c76d2df0f509b2fafddaf373645a6ebb4c0d4827aeac35" 17592186350603 "q-340465/selection/c8e4f988e557da731109ff6c99f8debf88c1c7c73daf641931604ad0812eb750" 17592186350604 "q-340465/selection/f7715dddacc54a1b928a32daeeb8f94c5df4274e5050a7a7939440b83c4cb80b" 17592186350605 "q-340469" 17592186350606 "q-340469/selection" 17592186350607 "q-340469/selection/103ab39d2c72990ac423889a380eeb1b537e96c7c7a132c73ded6840a5b64208" 17592186350608 "q-340469/selection/470f4bcf224141f582c7dab4b99e41bc4667c9b4cc5b708d66ba7f4ff4915680" 17592186350609 "q-340469/selection/4d671e8a2c3b7e22cc2d0880f7294a7aa55ae1f86e5530a60b3c337629ffc46f" 17592186350610 "q-340469/selection/897c5ebf4c8e571c39de3909df3efb41b4a8bc68c6f711a56a43add7f09efc3e" 17592186350611 "q-340469/selection/dd93a4168d89dc529336cb669e632ca1f85fd46ce7bb89d8f6e428230e8e4861" 17592186350612