\\operatorname{cos}⁡(12x)-\\frac{1}{4}\\operatorname{cos}⁡(2x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340483" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/activity-metadata.json" "file_sha256" "14fb80a47f8bea79a732bb82313bbb3ca7a1899499ce444cd2af452403c52f49"} {"question" "q-340483" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340483" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{10}\\operatorname{cos}⁡(7x)+\\frac{1}{6}\\operatorname{sin}⁡(5x)+C"] ["math" "-\\frac{1}{12}\\operatorname{sin}⁡(12x)-\\frac{1}{2}\\operatorname{sin}⁡(2x)+C"] ["math" "-\\frac{1}{24}\\operatorname{cos}⁡(12x)-\\frac{1}{4}\\operatorname{cos}⁡(2x)+C"] ["math" "-\\frac{1}{24}\\operatorname{cos}⁡(7x)+\\frac{1}{4}\\operatorname{sin}⁡(5x)+C"] ["math" "\\frac{1}{24}\\operatorname{sin}⁡(12x)+\\frac{1}{8}\\operatorname{sin}⁡(2x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340483" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{24}\\operatorname{cos}⁡(12x)-\\frac{1}{4}\\operatorname{cos}⁡(2x)+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340505" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral.\n\n${\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(3x)\\operatorname{sin}⁡(8x)\\,\\text{d}x=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340505" "field" nil "attribute" "question/worked-solution" "value" "First, let's recall the sum and difference formulas for cosine:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta +\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{cos}⁡(\\alpha +\\beta ) & =\\operatorname{cos}⁡\\alpha \\operatorname{cos}⁡\\beta -\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta \\end{aligned}\n$$\n\nSubtracting the second equation from the first, we get the following product-to-sum identity:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ) & =2\\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  \\\\ \\operatorname{sin}⁡\\alpha \\operatorname{sin}⁡\\beta  & =\\frac{1}{2}(\\operatorname{cos}⁡(\\alpha -\\beta )-\\operatorname{cos}⁡(\\alpha +\\beta ))\\end{aligned}\n$$\n\nThus, we have\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡(3x)\\operatorname{sin}⁡(8x) & =\\frac{1}{2}(\\operatorname{cos}⁡(3x-8x)-\\operatorname{cos}⁡(3x+8x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(-5x)-\\operatorname{cos}⁡(11x)) \\\\  & =\\frac{1}{2}(\\operatorname{cos}⁡(5x)-\\operatorname{cos}⁡(11x)).\\end{aligned}\n$$\n\nSubstituting this into the integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(3x)\\operatorname{sin}⁡(8x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}\\frac{1}{2}\\operatorname{cos}⁡(5x)-\\frac{1}{2}\\operatorname{cos}⁡(11x)\\,\\text{d}x \\\\  & ={[\\frac{1}{10}\\operatorname{sin}⁡(5x)-\\frac{1}{22}\\operatorname{sin}⁡(11x)]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{10}(\\operatorname{sin}⁡(\\frac{5\\pi }{2})-\\operatorname{sin}⁡(0))-\\frac{1}{22}(\\operatorname{sin}⁡(\\frac{11\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{10}(1-0)-\\frac{1}{22}(-1-0) \\\\  & =\\frac{8}{55}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340505" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/activity-metadata.json" "file_sha256" "14fb80a47f8bea79a732bb82313bbb3ca7a1899499ce444cd2af452403c52f49"} {"question" "q-340505" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340505" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{8}{55}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"}] "usage" {} "basis" 2152 "retractions" [] "immutable_answers" [] "immutable_fields" [] "no_history" []}
