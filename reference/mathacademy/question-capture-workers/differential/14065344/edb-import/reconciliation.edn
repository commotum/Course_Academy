peratorname{cos}⁡(5x)+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary constant." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340479" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/activity-metadata.json" "file_sha256" "14fb80a47f8bea79a732bb82313bbb3ca7a1899499ce444cd2af452403c52f49"} {"question" "q-340479" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340479" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{11}\\operatorname{sin}⁡(11x)-\\frac{1}{5}\\operatorname{sin}⁡(5x)+C"] ["math" "-\\frac{1}{16}\\operatorname{cos}⁡(8x)+\\frac{1}{6}\\operatorname{sin}⁡(3x)+C"] ["math" "-\\frac{1}{22}\\operatorname{cos}⁡(11x)-\\frac{1}{10}\\operatorname{cos}⁡(5x)+C"] ["math" "-\\frac{1}{22}\\operatorname{cos}⁡(8x)+\\frac{1}{10}\\operatorname{sin}⁡(3x)+C"] ["math" "\\frac{1}{22}\\operatorname{sin}⁡(11x)+\\frac{1}{20}\\operatorname{sin}⁡(5x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065344/state.json" "file_sha256" "ebfd1e54b1499695e8e85754c00dc1125bae74bb342f367e54ebfcb6e246b817"} {"question" "q-340479" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{22}\\operatorname{cos}⁡(11x)-\\frac{1}{10}\\operatorname{cos}⁡(5x)+C"] "category" "ma_successful_grade" "fi