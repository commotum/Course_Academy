mega }^{2}}, &  & s>0, \\\\ L{\\operatorname{cos}⁡\\omega t} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0,\\end{aligned}\n$$\n\nfind $L{u(t-3)\\operatorname{cos}⁡(6\\pi t)},$ where $u(t)$ is the unit step function." :question/worked-solution "The second shifting theorem states that if $a\\ge 0$ and $L{u(t-a)\\,g(t)}$ exists for $s>{s}_{0},$ then\n\n$$\nL{u(t-a)\\,g(t)}={e}^{-as}\\,L{g(t+a)},\\,\\text{for}\\,s>{s}_{0},\n$$\n\nwhere $u(t)$ is the unit step function.\n\nIn our case, we wish to find\n\n$$\nL{u(t-3)\\operatorname{cos}⁡(6\\pi t)}.\n$$\n\nTherefore, $a=3,$ and we have \n\n$$\nL{u(t-3)\\,g(t)}={e}^{-3s}\\,L{g(t+3)},\n$$\n\nwhere $g(t)=\\operatorname{cos}⁡(6\\pi t).$\n\nNotice that\n\n$$\n\\begin{aligned}g(t+3) & =cos\\,(6\\pi (t+3)) \\\\  & =\\operatorname{cos}⁡(6\\pi t+18\\pi ) \\\\  & =cos\\,(6\\pi t+9\\cdot 2\\pi ) \\\\  & =\\operatorname{cos}⁡(6\\pi t).\\end{aligned}\n$$\n\nSince $L{\\operatorname{cos}⁡(\\omega t)}=\\frac{s}{{s}^{2}+{\\omega }^{2}}$ for $s>0,$ we have\n\n$$\n\\begin{aligned}L{g(t+3)} & =L{\\operatorname{cos}⁡(6\\pi t)} \\\\  & =\\frac{s}{{s}^{2}+(6\\pi )^{2}} \\\\  & =\\frac{s}{{s}^{2}+36{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L{u(t-3)\\,g(t)} & ={e}^{-3s}\\,L{g(t+3)} \\\\  & ={e}^{-3s}\\cdot \\frac{s}{{s}^{2}+36{\\pi }^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331032/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "57cca080-3b0b-57b9-a7f8-6b1038ebd686"] :knowledge-point/questions ["q-331032"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331040/selection/5fcd4647406fa750d93288bd909a086e6cc8e6a72fd0357919adc7068076d405" :answer/id #uuid "d7d6f365-5022-5fe7-b4d2-14b228d67f29" :answer/type :answer.type/math :answer/value "{e}^{-2s}\\cdot \\frac{s}{{s}^{2}+{\\pi }^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331040/selection/2132b9bdd5bc9df85e08c648199ee02e4c4bbf07553c