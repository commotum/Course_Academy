)}=\\frac{s}{{s}^{2}+16}.\n$$\n\nFinally, we apply the shifting theorem formula $L{u(t-a)\\,f(t-a)}={e}^{-as}F(s)$ by multiplying $F(s)$ by the exponential delay factor ${e}^{-5s}:$\n\n$$\n\\begin{aligned}L{u(t-5)cos\\,(4(t-5))} & ={e}^{-5s}\\cdot F(s) \\\\  & ={e}^{-5s}\\cdot \\frac{s}{{s}^{2}+16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342631/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d22ba3ca-cf7a-5a77-abf6-8620076552bb"] :knowledge-point/questions ["q-342631"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342638/selection/2bf2dd4c0863ecf0e60be1e0b4bafaf5232a918e554bc0b3b1edac2f8305fe8b" :answer/id #uuid "95b42ef6-d597-5334-b33c-957c6261cde2" :answer/type :answer.type/math :answer/value "{e}^{-2s}\\cdot \\frac{2}{{s}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-342638/selection/7b90b78420b0c8aa384cfad957d6e9c10f3cd9bd9d1a6b1fab3e03cc03ac7d04" :answer/id #uuid "c87683ee-ccf3-5912-a4df-ca5b010935d6" :answer/type :answer.type/math :answer/value "{e}^{-4s}\\cdot \\frac{s}{{s}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-342638/selection/c65318910ea66def2072b39f4334de3865ef299b09301f3f512bc46440606507" :answer/id #uuid "4c47a1e3-71ba-50fe-ad63-98d6c6590ed0" :answer/type :answer.type/math :answer/value "{e}^{4s}\\cdot \\frac{2}{{s}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-342638/selection/f55acd2fa0a486594f3fd6f0045a7c8908d54c8765a75066b4027058e0464217" :answer/id #uuid "bbdf9786-1b6f-52d0-9c87-1c3595975f4b" :answer/type :answer.type/math :answer/value "{e}^{-4s}\\cdot \\frac{2}{{s}^{2}+4}" :db/ensure [:answer/validate]} {:db/id "q-342638/selection/66437b746b9907e5fc705e9eacd7af8b982c9578ccdd13a7af7ff4154c40b3c1" :answer/id #uuid "5e67f589-75f0-57c5-85af-22340fd6610b" :answer/type :answer.type/math :answer/value "{e}^{-4s}\\cdot \\frac{2}{{s}^{2}+16}" :db/ensure [:answer/validate]} {:db/id "q-342638/selection" :answer-field/id #uuid "ecf1de1f-08be-52