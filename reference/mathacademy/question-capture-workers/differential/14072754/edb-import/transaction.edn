omega t} & =\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}, &  & s>0, \\\\ L{\\operatorname{cos}⁡\\omega t} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0,\\end{aligned}\n$$\n\nfind $L{u(t-2)\\,\\operatorname{sin}⁡(\\pi t)},$ where $u(t)$ is the unit step function." :question/worked-solution "The second shifting theorem states that if $a\\ge 0$ and $L{u(t-a)\\,g(t)}$ exists for $s>{s}_{0},$ then\n\n$$\nL{u(t-a)\\,g(t)}={e}^{-as}\\,L{g(t+a)},\\,\\text{for}\\,s>{s}_{0},\n$$\n\nwhere $u(t)$ is the unit step function.\n\nIn our case, we wish to find\n\n$$\nL{u(t-2)\\,\\operatorname{sin}⁡(\\pi t)}.\n$$\n\nTherefore, $a=2,$ and we have \n\n$$\nL{u(t-2)\\,g(t)}={e}^{-2s}\\,L{g(t+2)},\n$$\n\nwhere $g(t)=\\operatorname{sin}⁡(\\pi t).$\n\nNotice that\n\n$$\n\\begin{aligned}g(t+2) & =sin\\,(\\pi (t+2)) \\\\  & =\\operatorname{sin}⁡(\\pi t+2\\pi ) \\\\  & =\\operatorname{sin}⁡\\pi t\\operatorname{cos}⁡2\\pi +\\operatorname{cos}⁡\\pi t\\operatorname{sin}⁡2\\pi  \\\\  & =\\operatorname{sin}⁡\\pi t\\cdot 1+\\operatorname{cos}⁡\\pi t\\cdot 0 \\\\  & =\\operatorname{sin}⁡\\pi t.\\end{aligned}\n$$\n\nSince $L{\\operatorname{sin}⁡(\\omega t)}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}$ for $s>0,$ we have\n\n$$\n\\begin{aligned}L{g(t+2)} & =L{\\operatorname{sin}⁡(\\pi t)} \\\\  & =\\frac{\\pi }{{s}^{2}+{\\pi }^{2}}.\\end{aligned}\n$$\n\nTherefore, applying the second shifting theorem, we get\n\n$$\n\\begin{aligned}L{u(t-2)\\,g(t)} & ={e}^{-2s}\\,L{g(t+2)} \\\\  & ={e}^{-2s}\\cdot \\frac{\\pi }{{s}^{2}+{\\pi }^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-331040/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "57cca080-3b0b-57b9-a7f8-6b1038ebd686"] :knowledge-point/questions ["q-331040"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342637/selection/1d9f2ce0bacaea24a689a116c13474a2949d0f4ca4d53882d5e9a3bec7919977" :answer/id #uuid "078d1928-3fe7-5089-bb2d-bcc0032c3340" :answer/type :answer.type/math :