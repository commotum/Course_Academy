#{[{:db/id #edb/ref 17592186167136 :knowledge-point/_questions [{:knowledge-point/id #uuid "a7cc1e18-810d-54cd-90d7-354a865105a7" :knowledge-point/title "Writing an Expression for the LTE for a Given Numerical Method"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1301bcc-be2b-52ba-9cde-64a578bfaad3" :answer/type {:db/ident :answer.type/math} :answer/value "(x^{3} - 2x^{2})Δx + 3x(Δx)^{2} + (Δx)^{3}" :db/id #edb/ref 17592186164178} {:answer/id #uuid "1cba7303-3ac3-5872-a973-4f12f5db6797" :answer/type {:db/ident :answer.type/math} :answer/value "(2x^{2} - x^{3})Δx + 3x(Δx)^{2} + (Δx)^{3}" :db/id #edb/ref 17592186164179} {:answer/id #uuid "4bef35cd-4ded-5b7c-bc27-71bc037e52f0" :answer/type {:db/ident :answer.type/math} :answer/value "(2x^{3} - x^{2})Δx + x(Δx)^{2} + (Δx)^{3}" :db/id #edb/ref 17592186164180} {:answer/id #uuid "6022b8fa-b215-5c87-8921-5c5f37ca947c" :answer/type {:db/ident :answer.type/math} :answer/value "(x^{2} - x^{3})Δx + 2x(Δx)^{2} + x(Δx)^{3}" :db/id #edb/ref 17592186164181} {:answer/id #uuid "68603171-1ea1-57b3-ad56-f321f917fa8c" :answer/type {:db/ident :answer.type/math} :answer/value "(x^{2} - 2x^{3})Δx + 3x(Δx)^{2} + 4x(Δx)^{3}" :db/id #edb/ref 17592186164182}] :answer-field/correct {:answer/id #uuid "1cba7303-3ac3-5872-a973-4f12f5db6797" :answer/type {:db/ident :answer.type/math} :answer/value "(2x^{2} - x^{3})Δx + 3x(Δx)^{2} + (Δx)^{3}" :db/id #edb/ref 17592186164179} :answer-field/id #uuid "ce506fff-6015-59b1-aad6-be317208e369" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186164177}] :question/id #uuid "884321dd-6d47-5c66-8194-a61c8e2381b3" :question/math-academy-id "q-331510" :question/problem "Suppose we wish to approximate the solution to an initial value problem using the following numerical method:\n\n$Δy|= (x^{2} + y) \\cdot Δx; y_{new}|= y + Δy$\nIf the exact solution is $y_{exact}(x) = x^{3}$, find an expression for the local truncation error for the step from $x$ to $x_{new} = x + Δx$."}] [{:db/id #edb/ref 17592186167172 :knowledge-point/_questions [{:knowledge-point/id #uuid "9477a5ac-7e05-5fa4-9cf3-352cc17f2e1b" :knowledge-point/title "Computing Local Truncation Error Given Numerical Solutions to an Initial Value Problem"}] :question/answer-fields [{:answer-field/id #uuid "fd8265b7-7f1b-5640-835c-16e48338c5c5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164434} {:answer-field/id #uuid "1f6b67ee-28b1-5fa3-8f87-24bf5a07d6db" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164435} {:answer-field/id #uuid "282c5bbf-e1db-5969-8acd-eb9c41a56a69" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164436}] :question/id #uuid "e52dce56-00d6-5df1-9b61-a11ff1e33cf4" :question/math-academy-id "q-333163" :question/problem "> A scientific calculator is required to answer this question.\n\nAn initial value problem has the exact solution $y_{exact}(x) = e^{x}$. A numerical method is used to approximate the solution to the initial value problem, resulting in the table below, where $y$ denotes the approximate solution at each step, and $τ_{n}$ is the local truncation error at each step. At each step, the exact value is used to approximate the new value.\n\nCalculate the local truncation error at each step. Round your answers to three decimal places.\n\n| $n$ | $x$ | $y$ | $τ_{n}$ |\n| --- | ---: | ---: | ---: |\n| $0$ | $0$ | $1.000$ | $0$ |\n| $1$ | $0.25$ | $1.283$ | {{field-1}} |\n| $2$ | $0.5$ | $1.644$ | {{field-2}} |\n| $3$ | $0.75$ | $2.104$ | {{field-3}} |" :question/requires-calculator true}] [{:db/id #edb/ref 17592186167182 :knowledge-point/_questions [{:knowledge-point/id #uuid "c8905c41-cedb-5c7b-81f7-7639c5451174" :knowledge-point/title "Computing Global Truncation Error Given Numerical Solutions to an Initial Value Problem"}] :question/answer-fields [{:answer-field/id #uuid "104ae2a3-f65a-5e06-bca6-4077c900e83d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164510} {:answer-field/id #uuid "1b2a15a8-5536-5563-a9b1-34d4fccaa549" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164511} {:answer-field/id #uuid "50730ef5-8fd0-5222-8d1b-4b60a1b9294e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164512}] :question/id #uuid "3f0aed5a-c308-5168-979c-ef812c012af1" :question/math-academy-id "q-334475" :question/problem "> A scientific calculator is required to answer this question.\n\nA numerical method is used to approximate a solution to an initial value problem, resulting in the table below. If the exact solution is $y(x) = \\cos x$, find, rounded to three decimal places, the global truncation error at each step.\n\n| $n$ | $x_{n}$ | $y_{n}$ | $e_{n}$ |\n| --- | ---: | ---: | ---: |\n| $0$ | $0$ | $1$ | $0$ |\n| $1$ | $0.3$ | $0.943$ | {{field-1}} |\n| $2$ | $0.6$ | $0.793$ | {{field-2}} |\n| $3$ | $0.9$ | $0.595$ | {{field-3}} |" :question/requires-calculator true}]}
