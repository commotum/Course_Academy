d #uuid "85310e37-4930-5dbb-85c2-3e0114b7f99c" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{-1}{e}^{-1/y}" :db/id #edb/ref 17592186363883}] :answer-field/correct {:answer/id #uuid "c616adb8-1a37-50c0-8d98-7f1c5e9cafa4" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{-1/y}" :db/id #edb/ref 17592186363882} :answer-field/id #uuid "15fc6ab0-5ace-5890-93e0-5259b06bd90c" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186363880} {:answer-field/choices [{:answer/id #uuid "251ea101-fbb8-53e0-87ee-c6a8fe877454" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{-1}{e}^{-1/y}\\cdot ({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186363885} {:answer/id #uuid "841d375b-d8ea-5286-8a6e-d2ad87c4e575" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-1/y}\\cdot ({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186363886} {:answer/id #uuid "9823d812-333d-5df6-97d3-7e245fe4bd8a" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{-1/y}\\cdot ({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186363887}] :answer-field/correct {:answer/id #uuid "9823d812-333d-5df6-97d3-7e245fe4bd8a" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{-3}{e}^{-1/y}\\cdot ({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=0" :db/id #edb/ref 17592186363887} :answer-field/id #uuid "40bd2010-6217-5d2d-b657-2927261b465f" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186363884}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "16348fba-4613-56cd-be81-305ba49c72ee" :question/math-academy-id "q-318660" :question/problem "Suppose we would like to find an integrating factor to convert the differential equation\n\n$$\n{y}^{3}\\,\\text{d}x+xy\\,\\text{d}y=0,\\,y>0\n$$\n\ninto an exact equation using an integrating factor. Select the correct options in the reasoning below. For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n{{field-1}}=h(y)\n$$\n\nwhere $h(y)$ is independent of $x,$ then an integrating factor for the equation is\n\n$$\nI(y)={{field-2}}\n$$\n\nwhere $\\operatorname{exp}⁡(y)$ denotes the exponential function ${e}^{y}.$\n\nLet's denote\n\n$$\nP(x,y)={y}^{3},\\,Q(x,y)=xy.\n$$\n\nNow, we compute the partial derivatives:\n\n$$\n\\frac{∂P}{∂y}=\\,{{field-3}}\n$$\n\n$$\n\\frac{∂Q}{∂x}=\\,{{field-4}}\n$$\n\nSince for this equation \n\n$$\n\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})={{field-5}},\n$$\n\nwhich depends on $y$ only, then an integrating factor for our equation is\n\n$$\nI(y)={{field-6}}.\n$$\n\nand we arrive at the exact equation\n\n$$\n{{field-7}}.\n$$" :question/worked-solution "For a differential equation of the form\n\n$$\nP(x,y)\\,\\text{d}x+Q(x,y)\\,\\text{d}y=0,\n$$\n\nwe have that if\n\n$$\n\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})=h(y)\n$$\n\nwhere $h(y)$ is independent of $x,$ then an integrating factor for the equation is\n\n$$\nI(y)=\\operatorname{exp}⁡(-\\int h(y)\\,\\text{d}y)\n$$\n\nwhere $\\operatorname{exp}⁡(y)$ denotes the exponential function ${e}^{y}.$\n\nLet's denote\n\n$$\nP(x,y)={y}^{3},\\,Q(x,y)=xy.\n$$\n\nNow, let's compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂P}{∂y} & =\\frac{∂}{∂y}({y}^{3})=3{y}^{2} \\\\ \\frac{∂Q}{∂x} & =\\frac{∂}{∂x}(xy)=y\\end{aligned}\n$$\n\nSince\n\n$$\n\\begin{aligned}\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x}) & =\\frac{1}{{y}^{3}}(3{y}^{2}-y) \\\\  & =3{y}^{-1}-{y}^{-2},\\end{aligned}\n$$\n\nis a function of $y$ only, we can conclude that an integrating factor for our equation is\n\n$$\n\\begin{aligned}I(y) & =\\operatorname{exp}⁡(\\int -(3{y}^{-1}-{y}^{-2})\\,\\text{d}y) \\\\  & =\\operatorname{exp}⁡(-(3\\operatorname{ln}⁡y+1/y)) \\\\  & =\\operatorname{exp}⁡(\\operatorname{ln}⁡{y}^{-3})\\cdot \\operatorname{exp}⁡(-1/y) \\\\  & ={y}^{-3}\\,{e}^{-1/y}.\\end{aligned}\n$$\n\nand by multiplying our differential equation by the integrating factor, we have\n\n$$\nI(y)\\cdot ({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=I(y)\\cdot 0\n$$\n\nwhich simplifies as\n\n$$\n{y}^{-3}{e}^{-1/y}({y}^{3}\\,\\text{d}x+xy\\,\\text{d}y)=0.\n$$"}] [{:db/id #edb/ref 17592186363888 :knowledge-point/_questions [{:knowledge-point/id #uuid "7cbedeed-6ac6-5ed8-bd25-9a85eda9577b" :knowledge-point/title "Finding an Integrating Factor for an Inexact Equation: Condition on X Satisfied"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29318adf-a14c-51e0-a281-47a04dc85b7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}+\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186363890} {:answer/id #uuid "fe7750c6-388c-5974-94ee-45e2bca12cf1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186363891} {:answer/id #uuid "e4fa0680-b0a7-5829-a459-e2f380912b8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{P}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186363892} {:answer/id #uuid "ae9ac284-1606-542c-97b2-7ad864ab5f6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{∂P}{∂y}+\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186363893}] :answer-field/correct {:answer/id #uuid "fe7750c6-388c-5974-94ee-45e2bca12cf1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{Q}(\\frac{∂P}{∂y}-\\frac{∂Q}{∂x})" :db/id #edb/ref 17592186363891} :answer-field/id #uuid "06dc105d-5c29-5e24-88b4-d2671de6c014" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186363889} {:answer-field/choices [{:answer/id #uuid "8f9396f7-01de-524b-92bb-3033b474ad0f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{exp}⁡(-\\int g(x)\\,\\text{d}x)" :db/id #edb/ref 17592186363895} {:answer/id #uuid "bb985b50-615