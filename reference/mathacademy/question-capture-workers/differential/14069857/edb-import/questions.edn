#{[{:db/id #edb/ref 17592186217721 :knowledge-point/_questions [{:knowledge-point/id #uuid "161b35e2-52bf-5f27-9fc3-bfe34eeb7935" :knowledge-point/title "Finding an Integrating Factor for an Inexact Equation: Condition on Y Satisfied"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b2568400-c5aa-5c3b-a9ee-66784a788175" :answer/type {:db/ident :answer.type/math} :answer/value "\"\\exp (h(y))\", \"\\exp (− h(y))\"" :db/id #edb/ref 17592186216421} {:answer/id #uuid "b856bf3d-9d1d-5af4-97a9-1f0175fcf4d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\exp (∫h(x)dy)" :db/id #edb/ref 17592186216422} {:answer/id #uuid "151e1159-5725-5883-8055-58e79dac960d" :answer/type {:db/ident :answer.type/math} :answer/value "\\exp (− ∫h(y)dy)" :db/id #edb/ref 17592186216423}] :answer-field/id #uuid "b006c991-7fca-592a-86e1-f064c214dc4b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186216420} {:answer-field/choices [{:answer/id #uuid "c7c27149-372c-56cc-b470-c77214fe3f2c" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(P)((∂P)/(∂y) + (∂Q)/(∂x))" :db/id #edb/ref 17592186216425} {:answer/id #uuid "e87891f1-f76f-525d-9a5f-c5181bc2610d" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(Q)((∂P)/(∂y) − (∂Q)/(∂x))" :db/id #edb/ref 17592186216426} {:answer/id #uuid "19e11d0e-9b37-5a9d-847a-810021a5158b" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(P)((∂P)/(∂y) − (∂Q)/(∂x))" :db/id #edb/ref 17592186216427} {:answer/id #uuid "4164788e-f1a4-5851-9516-f1fc0874618c" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/(Q)((∂P)/(∂y) + (∂Q)/(∂x))" :db/id #edb/ref 17592186216428}] :answer-field/id #uuid "939657e5-846d-5a5d-adce-29b121699ac1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186216424}] :question/id #uuid "16348fba-4613-56cd-be81-305ba49c72ee" :question/math-academy-id "q-318660" :question/problem "Suppose we would like to find an integrating factor to convert the differential equation\n$y^{3}dx + xydy = 0, y > 0$\ninto an exact equation using an integrating factor. Select the correct options in the reasoning below. For a differential equation of the form\n$P(x, y)dx + Q(x, y)dy = 0$,\nwe have that if\n\n$\\frac{1}{Q}(\\frac{∂P}{∂y} - \\frac{∂Q}{∂x})$ {{field-1}}\n\nwhere $h(y)$ is independent of $x$, then an integrating factor for the equation is\n$\\exp (∫h(x)dy)$ {{field-2}}\nwhere $\\exp (y)$ denotes the exponential function $e^{y}$."}]}
