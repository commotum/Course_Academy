}_{1}-{y}_{2})?$" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L(3{y}_{1}-{y}_{2}) & =3L({y}_{1})-L({y}_{2}) \\\\  & =3\\cdot (2-{sin}^{2}⁡x)-3{cos}^{2}⁡x \\\\  & =6-3{sin}^{2}⁡x-3{cos}^{2}⁡x \\\\  & =6-3({sin}^{2}⁡x+{cos}^{2}⁡x) \\\\  & =6-3 \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130080/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68148c93-9139-5deb-8a53-a05d63ec5930"] :knowledge-point/questions ["q-130080"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130081/selection/145b4050afa7c5c5b45ce859048b5bd2f55698dae2c03fac05cab50a13438c2e" :answer/id #uuid "232e60fa-8c23-5e48-ab1f-fa6c394a9b86" :answer/type :answer.type/math :answer/value "{x}^{2}+12x-1" :db/ensure [:answer/validate]} {:db/id "q-130081/selection/d5ccc67a0af7ed709899adf357dd9d87e71344eb5b1aa1680a11724ea1238f78" :answer/id #uuid "3b6ab8b1-bb63-5617-8f69-ab77374e7cb9" :answer/type :answer.type/math :answer/value "{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-130081/selection/64e31de725f4b665f033e4ec267152ce8281e971f8d59e112b8daed8b10bb92e" :answer/id #uuid "6d8c5aec-1702-545b-9a58-69f9771b8bf7" :answer/type :answer.type/math :answer/value "{x}^{2}+6x-1" :db/ensure [:answer/validate]} {:db/id "q-130081/selection/44e208f81eb404b814e1484a42763bfc7dcdda05ff8a5240590a0f082f6a382a" :answer/id #uuid "3729e9dd-3307-50fd-a7b4-443ded46aada" :answer/type :answer.type/math :answer/value "{x}^{2}-9" :db/ensure [:answer/validate]} {:db/id "q-130081/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" :answer/id #uuid "a0cce0c3-a091-57d3-89e6-e7b4990d53a5" :answer/type :answer.type/math :answer/value "{x}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-130081/selection" :answer-field/id #uuid "57fb3393-8da0-58db-b8b8-c4543ae2c1aa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130081/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" :answer-field/choices ["q-130081/selection/145b4050afa7c5c5b45ce859048b5bd2f55698dae2c03fac05cab50a13438c2e" "q-130081/selection/d5ccc67a0af7ed709899adf357dd9d87e71344eb5b1aa1680a11724ea1238f78" "q-130081/selection/64e31de725f4b665f033e4ec267152ce8281e971f8d59e112b8daed8b10bb92e" "q-130081/selection/44e208f81eb404b814e1484a42763bfc7dcdda05ff8a5240590a0f082f6a382a" "q-130081/selection/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9"] :db/ensure [:answer-field/validate]} {:db/id "q-130081" :question/id #uuid "4cb7c2e5-f581-57d0-8d98-1a27e90a0a20" :question/math-academy-id "q-130081" :question/problem "Suppose that $L$ is a linear differential operator such that $L({y}_{1})=3x-5$ and $L({y}_{2})=(x-3)^{2}$ for some functions ${y}_{1}(x)$ and ${y}_{2}(x).$ What is $L(2{y}_{1}+{y}_{2})?$" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L(2{y}_{1}+{y}_{2}) & =2L({y}_{1})+L({y}_{2}) \\\\  & =2\\cdot (3x-5)+(x-3)^{2} \\\\  & =6x-10+{x}^{2}-6x+9 \\\\  & ={x}^{2}+(6x-6x)+(-10+9) \\\\  & ={x}^{2}-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130081/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68148c93-9139-5deb-8a53-a05d63ec5930"] :knowledge-point/questions ["q-130081"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65036/selection/6d5aaa1d32a8470dc4f3e2df17f9c7417aa616705e2c8617faf6837f04298d2d" :answer/id #uuid "81411890-18b9-552d-864c-84393a589c56" :answer/type :answer.type/math :answer/value "12x" :db/ensure [:answer/validate]} {:db/id "q-65036/selection/ccbf5a81da4d0c634917fb351282d138642bf5525ae5f2bf82a2a59b20c68798" :answer/id #uuid "3eaccb6a-4bfe-5bb7-b050-bfc0eda6bfbb" :answer/type :answer.type/math :answer/value "6{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-65036/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c39278fa-679b-5bd5-80c4-17833fe1db27" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-65036/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer/id #uuid "8631baaf-4da5-59ba-84ea-e88a9a9e7a53" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "q-65036/selection/fb9dc49192d108728a9cfe5fc2d87fa15f9e2a8325063eb2f2623a5dec1add6d" :answer/id #uuid "cfb5826d-0ce2-5341-9649-84d0f39ea77a" :answer/type :answer.type/math :answer/value "-12x" :db/ensure [:answer/validate]} {:db/id "q-65036/selection" :answer-field/id #uuid "29b72ec7-2bb9-5672-a6e3-42ce2071ee34" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65036/selection/6d5aaa1d32a8470dc4f3e2df17f9c7417aa616705e2c8617faf6837f04298d2d" :answer-field/choices ["q-65036/selection/6d5aaa1d32a8470dc4f3e2df17f9c7417aa616705e2c8617faf6837f04298d2d" "q-65036/selection/ccbf5a81da4d0c634917fb351282d138642bf5525ae5f2bf82a2a59b20c68798" "q-65036/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-65036/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" "q-65036/selection/fb9dc49192d108728a9cfe5fc2d87fa15f9e2a8325063eb2f2623a5dec1add6d"] :db/ensure [:answer-field/validate]} {:db/id "q-65036" :question/id #uuid "c63af792-171b-5ce8-938c-95e39526327b" :question/math-academy-id "q-65036" :question/problem "Suppose that $L$ is a linear differential operator such that $L({y}_{1})={x}^{2}+4$ and $L({y}_{2})=3(x-2)^{2}$ for some functions ${y}_{1}(x)$ and ${y}_{2}(x).$ What is $L(3{y}_{1}-{y}_{2})?$" :question/worked-solution "For any linear differential operator,\n\n$$\nL(a{y}_{1}(x)+b{y}_{2}(x))=aL({y}_{1}(x))+bL({y}_{2}(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L(3{y}_{1}-{y}_{2}) & =3L({y}_{1})-L({y}_{2}) \\\\  & =3\\cdot ({x}^{2}+4)-3(x-2)^{2} \\\\  & =3{x}^{2}+12-3({x}^{2}-4x+4) \\\\  & =3{x}^{2}+12-3{x}^{2}+12x-12 \\\\  & =12x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-65036/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "68148c93-9139-5deb-8a53-a05d63ec5930"] :knowledge-point/questions ["q-65036"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6572"] :question/problem "Show that the differential operator\n\n$$\nD(y) = y\\dfrac{\\textrm d^2 y}{\\textrm d x^2} + \\dfrac{\\textrm d y}{\\textrm d x}\n$$\n\nis nonlinear." :question/worked-solution "For any linear differential operator $L,$ we have the linearity condition\n\n$$\nL(ay_1 + by_2) = aL(y_1) + bL(y_2)\n$$\n\nfor functions $y_1(x), y_2(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}})+a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x} \\\\  & =+{a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+ab{y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}} \\\\  & +a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x} \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x} \\\\  & +ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}).\\end{aligned}\n$$\n\nThis is *not* the same as the right-hand side, because\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a[{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+\\frac{\\text{d}{y}_{1}}{\\text{d}x}]+b[{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+\\frac{\\text{d}{y}_{2}}{\\text{d}x}] \\\\  & =a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x}.\\end{aligned}\n$$\n\nTherefore, since $D(ay_1+by_2)  \\neq aD(y_1) + bD(y_2),$ the operator $D$ is nonlinear." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21786"] :question/problem "Which of the following are linear differential operators?\n\n- $D_1(y)=\\dfrac{\\textrm dy}{\\textrm d x}+x\\cos(y)\\,y$\n\n- $D_2(y)=\\dfrac{1}{1+x^2}\\dfrac{\\textrm d^{2}y}{\\textrm d x^{2}}-\\sin(x)\\dfrac{\\textrm dy}{\\textrm d x}+3y$\n\n- $D_3(y)=\\dfrac{\\textrm d^{3}y}{\\textrm d x^{3}}+e^{x}\\dfrac{\\textrm d^{2}y}{\\textrm d x^{2}}-\\ln(x)\\,y$" :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y) = f_{n}(x)\\dfrac{\\textrm d^{n}y}{\\textrm d x^{n}} + f_{n-1}(x)\\dfrac{\\textrm d^{n-1}y}{\\textrm d x^{n-1}} + \\cdots + f_{1}(x)\\dfrac{\\textrm dy}{\\textrm d x} + f_0(x)y\n$$\n\nwhere each $f_i$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator $D_1$ is *not* linear. The coefficient of the second term is $x\\cos(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator $D_2$ is linear. It is a second-order linear differential operator of the form\n\n$$\nD_2(y) = f_{2}(x)\\dfrac{\\textrm d^{2}y}{\\textrm d x^{2}} + f_{1}(x)\\dfrac{\\textrm dy}{\\textrm d x} + f_0(x)y\n$$\n\nwith $f_2(x) = \\dfrac{1}{1+x^2}, f_1(x) = -\\sin(x),$ and $f_0(x) = 3.$\n\n- Operator $D_3$ is linear. It is a third-order linear differential operator of the form\n\n$$\nD_3(y) = f_{3}(x)\\dfrac{\\textrm d^{3}y}{\\textrm d x^{3}} + f_{2}(x)\\dfrac{\\textrm d^{2}y}{\\textrm d x^{2}} + f_{1}(x)\\dfrac{\\textrm dy}{\\textrm d x} + f_0(x)y\n$$\n\nwith $f_3(x) = 1, f_2(x) = e^{x}, f_1(x) = 0,$ and $f_0(x) = -\\ln(x).$\n\nTherefore, the correct answer is \"II and III only.\"" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6569"] :question/problem "Suppose that $L$ is a linear differential operator such that $L(y_1) = \\tan^2{x}$ and $L(y_2) =2 \\sec^2{x}$ for some functions $y_1(x)$ and $y_2(x).$ What is $L(2y_1 -y_2)?$\n\n*Hint: Use $\\sec^2\\theta = 1+\\tan^2\\theta.$*" :question/worked-solution "For any linear differential operator $L,$ we have\n\n$$\nL(ay_1(x) + by_2(x)) = aL(y_1(x)) + bL(y_2(x))\n$$\n\nwhere $a$ and $b$ are constants. \n\nIn our case, we have\n\n$$\n\\begin{aligned}L(2{y}_{1}-{y}_{2}) & =2L({y}_{1})-L({y}_{2}) \\\\  & =2{tan}^{2}⁡x-2{sec}^{2}⁡x.\\end{aligned}\n$$\n\nUsing the trigonometric identity $1+\\tan^2 x = \\sec^2 x,$ we can simplify this even further, as follows:\n\n$$\n\\begin{aligned}L(2{y}_{1}-{y}_{2}) & =2{tan}^{2}⁡x-2(1+{tan}^{2}⁡x) \\\\  & =-2.\\end{aligned}\n$$\n\nTherefore, \n\n$$\nL(2y_1 -y_2)=-2.\n$$" :db/ensure [:question/validate]}]
