8c37d4758c6270ecd785b57da55f39b3fa2df2006bd3477d242" :answer/id #uuid "1aa9f0f1-cbd6-575b-864f-00ce62d8fbed" :answer/type :answer.type/math :answer/value "D(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-337739/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c" :answer/id #uuid "b61e71d6-87a4-5d34-b9a8-6a426021580e" :answer/type :answer.type/math :answer/value "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-337739/field-5" :answer-field/id #uuid "73cf32e6-f5f7-5d34-ac5c-4dba8521ca1d" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "q-337739/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c" :answer-field/choices ["q-337739/field-5/1801eb49afd418c37d4758c6270ecd785b57da55f39b3fa2df2006bd3477d242" "q-337739/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c"] :db/ensure [:answer-field/validate]} {:db/id "q-337739/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" :answer/id #uuid "2da4177f-baf3-56e4-9e90-fe534f74ab68" :answer/type :answer.type/text :answer/value "nonlinear" :db/ensure [:answer/validate]} {:db/id "q-337739/field-6/12092065ff4e11bb0d25fd69995cf910e9de428f4ac180ad1cb0a43a1ec62103" :answer/id #uuid "f4cae72f-0477-53ac-8fdb-0b2f5b762c05" :answer/type :answer.type/text :answer/value "linear" :db/ensure [:answer/validate]} {:db/id "q-337739/field-6" :answer-field/id #uuid "59ef1d87-7acc-5603-9d7d-2bf5675fd23f" :answer-field/key "field-6" :answer-field/type :answer-field.type/select :answer-field/correct "q-337739/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" :answer-field/choices ["q-337739/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" "q-337739/field-6/12092065ff4e11bb0d25fd69995cf910e9de428f4ac180ad1cb0a43a1ec62103"] :db/ensure [:answer-field/validate]} {:db/id "q-337739" :question/id #uuid "fa9dd2f3-efc6-5afd-a9e5-5871df1e337b" :question/math-academy-id "q-337739" :question/problem "Consider the following differential operator:\n\n$$\nD(y)={(\\frac{\\text{d}y}{\\text{d}x})}^{2}+y\n$$\n\nFill in the steps in the reasoning below.\n\nFor any linear differential operator $L,$ we have the linearity condition\n\n$$\n{{field-1}}\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & ={{field-2}}+{{field-3}} \\\\  & +ab\\cdot {{field-4}}.\\end{aligned}\n$$\n\nWe also have\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2}.\\end{aligned}\n$$\n\nNow, since {{field-5}} \nthe operator $D$ is {{field-6}}." :question/worked-solution "For any linear differential operator $L,$ we have the linearity condition\n\n$$\nL(a{y}_{1}+b{y}_{2})=aL({y}_{1})+bL({y}_{2})\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & ={(\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}))}^{2}+(a{y}_{1}+b{y}_{2}) \\\\  & ={(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2} \\\\  & ={a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+2ab\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & +a{y}_{1}+b{y}_{2} \\\\  & ={a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2} \\\\  & +ab\\cdot (2\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\frac{\\text{d}{y}_{2}}{\\text{d}x}).\\end{aligned}\n$$\n\nThis is *not* the same as the right-hand side, because\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a[{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{y}_{1}]+b[{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+{y}_{2}] \\\\  & =a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2}.\\end{aligned}\n$$\n\nTherefore, since $D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2}),$ the operator $D$ is $\\text{nonlinear}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-337739/field-1" "q-337739/field-2" "q-337739/field-3" "q-337739/field-4" "q-337739/field-5" "q-337739/field-6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0"] :knowledge-point/questions ["q-337739"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337777/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "92d413f1-5023-5279-802c-c08d0e2013b4" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-337777/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "7ae710d1-e402-5fbc-8063-58185b3831b1" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-337777/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "026cf490-5d92-5023-b356-8cb449b1a1f3" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-337777/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "4eaaa7b3-ae57-5d6d-8e27-ee7172a90c86" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-337777/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "24772976-c4b1-5129-a3d4-b08c53202109" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-337777/selection" :answer-field/id #uuid "ca36dd52-f70f-5f3b-b94f-956403d17746" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-337777/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-337777/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-337777/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-337777/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-337777/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-337777/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-337777" :question/id #uuid "346bcac0-1447-50b0-bef6-e6f6a501ffe3" :question/math-academy-id "q-337777" :question/problem "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=xy\\frac{\\text{d}y}{\\text{d}x}+\\frac{\\text{d}y}{\\text{d}x}$\n- ${D}_{2}(y)=\\operatorname{cos}⁡(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{x}^{2}\\frac{\\text{d}y}{\\text{d}x}+{e}^{x}y$\n- ${D}_{3}(y)=\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+\\operatorname{tan}⁡(y)\\,y$" :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the first term is $xy,$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{2}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=\\operatorname{cos}⁡(x),{f}_{1}(x)={x}^{2},$ and ${f}_{0}(x)={e}^{x}.$\n\n- Operator ${D}_{3}$ is *not* linear. The coefficient of the last term is $\\operatorname{tan}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-337777/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397"] :knowledge-point/questions ["q-337777"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338104/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "73b2bb90-c77c-5838-ad26-8497bcaf7d08" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-338104/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "668d26ca-9205-5010-a644-31a644074490" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-338104/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "1292c7b1-f809-555d-a22f-9f83d1c06cfc" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-338104/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "3acd6d67-b727-518e-b03a-c63727d51748" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-338104/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6a49c2fb-acad-5e7d-a7f2-9f5e5c261a7b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-338104/selection" :answer-field/id #uuid "65a203b6-2565-590b-8ce9-8b4e023944f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-338104/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-338104/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-338104/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-338104/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-338104/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-338104/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-338104" :question/id #uuid "b82a08be-c14d-5d29-a634-0558fbfaadff" :question/math-academy-id "q-338104" :question/problem "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=\\frac{\\text{d}y}{\\text{d}x}+\\operatorname{sin}⁡(y)\\frac{\\text{d}y}{\\text{d}x}$\n- ${D}_{2}(y)=x\\operatorname{tan}⁡(y)\\,\\frac{{\\text{d}}^{3}y}{\\text{d}{x}^{3}}+y$\n- ${D}_{3}(y)=(1+{x}^{2})\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+\\operatorname{ln}⁡(1+x)\\frac{\\text{d}y}{\\text{d}x}+\\frac{3}{{x}^{2}}y$" :question/worked-solution "An $n$th-order differential operator $L$ is linear if it is of the following form:\n\n$$\nL(y)={f}_{n}(x)\\frac{{\\text{d}}^{n}y}{\\text{d}{x}^{n}}+{f}_{n-1}(x)\\frac{{\\text{d}}^{n-1}y}{\\text{d}{x}^{n-1}}+⋯+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwhere each ${f}_{i}$ is a function of $x$ only. \n\nWith that in mind, let's check each operator.\n\n- Operator ${D}_{1}$ is *not* linear. The coefficient of the second term is $\\operatorname{sin}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{2}$ is *not* linear. The coefficient of the first term is $x\\operatorname{tan}⁡(y),$ which depends on $y$ and therefore fails linearity.\n\n- Operator ${D}_{3}$ is linear. It is a second-order linear differential operator of the form\n\n$$\n{D}_{3}(y)={f}_{2}(x)\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{f}_{1}(x)\\frac{\\text{d}y}{\\text{d}x}+{f}_{0}(x)y\n$$\n\nwith ${f}_{2}(x)=1+{x}^{2},{f}_{1}(x)=\\operatorname{ln}⁡(1+x),$ and ${f}_{0}(x)=\\frac{3}{{x}^{2}}.$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-338104/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5976004-053f-58ec-9d75-54d43a419397"] :knowledge-point/questions ["q-338104"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337774/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "11a5e11f-338d-5e83-b87a-41aeb096fde7" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-337774/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "4ee567f6-e9d8-52cc-a654-96427b7f9753" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-337774/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "640ca961-4afb-5b7b-9a10-0d3e6d27a4e7" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-337774/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "7f28b1a6-0586-5da0-9655-ced3b94a3a61" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-337774/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "babac767-2c2b-5f88-a4d2-b339a17edf2f" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-337774/selection" :answer-field/id #uuid "52d93a9b-834e-59e5-a570-bee911d26b79" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-337774/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-337774/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-337774/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-337774/select