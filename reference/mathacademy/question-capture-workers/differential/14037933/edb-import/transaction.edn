}_{2}}{\\text{d}{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-337728/field-2" :answer-field/id #uuid "05778374-9485-5934-ab5b-f61a0567858f" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-337728/field-2/a9947e0b7db5ddd8aaf9a10a8eba42b588b6be290103c66d3a75181b6b234361" :answer-field/choices ["q-337728/field-2/a9947e0b7db5ddd8aaf9a10a8eba42b588b6be290103c66d3a75181b6b234361" "q-337728/field-2/1304d896bf70fd2eb55c73f658c6663bec0114737504fb44d221faf3556f2554"] :db/ensure [:answer-field/validate]} {:db/id "q-337728/field-3/9896a51a98ceb5994b59da13f42b9702307e4f24dfe5ecb2f6721e3ad580a05c" :answer/id #uuid "3dad2825-8086-58ff-a468-d302df397153" :answer/type :answer.type/math :answer/value "{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-337728/field-3/099a80b382d94fcac79198ea60cfa2a6dbc4289f540014953c03884011b14c13" :answer/id #uuid "027429b5-06bc-5e79-8ba3-e052a387b9e5" :answer/type :answer.type/math :answer/value "a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-337728/field-3/ce94aca4d6879e68a293ac2c4b15f82977afac5fa0f8e5e9c9d4eb288ff8092f" :answer/id #uuid "6e7b78a4-14b1-5dc7-9652-585647659880" :answer/type :answer.type/math :answer/value "{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}-{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-337728/field-3" :answer-field/id #uuid "cc47255b-c513-5916-b1a0-c2568e81e177" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-337728/field-3/9896a51a98ceb5994b59da13f42b9702307e4f24dfe5ecb2f6721e3ad580a05c" :answer-field/choices ["q-337728/field-3/9896a51a98ceb5994b59da13f42b9702307e4f24dfe5ecb2f6721e3ad580a05c" "q-337728/field-3/099a80b382d94fcac79198ea60cfa2a6dbc4289f540014953c03884011b14c13" "q-337728/field-3/ce94aca4d6879e68a293ac2c4b15f82977afac5fa0f8e5e9c9d4eb288ff8092f"] :db/ensure [:answer-field/validate]} {:db/id "q-337728/field-4/01035cb36093c1b63d1a7a5f28536b2cddd00b60d95b899800563134949d456f" :answer/id #uuid "81cddb1f-17fe-55b8-9ffe-2ace33ea67a9" :answer/type :answer.type/math :answer/value "(\\frac{\\text{d}{y}_{2}}{\\text{d}x}+\\frac{\\text{d}{y}_{1}}{\\text{d}x})" :db/ensure [:answer/validate]} {:db/id "q-337728/field-4/dd1d29cb3845c38c5ba6270db61458109982aac6deb9ceceeedb555c4586d264" :answer/id #uuid "680da6a6-423a-5113-b16e-6a605081bb7a" :answer/type :answer.type/math :answer/value "(\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\cdot \\frac{\\text{d}{y}_{2}}{\\text{d}x})" :db/ensure [:answer/validate]} {:db/id "q-337728/field-4" :answer-field/id #uuid "8efa04f2-e13f-5f23-95e4-521ca4ffc591" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-337728/field-4/dd1d29cb3845c38c5ba6270db61458109982aac6deb9ceceeedb555c4586d264" :answer-field/choices ["q-337728/field-4/01035cb36093c1b63d1a7a5f28536b2cddd00b60d95b899800563134949d456f" "q-337728/field-4/dd1d29cb3845c38c5ba6270db61458109982aac6deb9ceceeedb555c4586d264"] :db/ensure [:answer-field/validate]} {:db/id "q-337728/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c" :answer/id #uuid "26401f57-20a2-525a-97d2-dae744007cc3" :answer/type :answer.type/math :answer/value "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-337728/field-5/1801eb49afd418c37d4758c6270ecd785b57da55f39b3fa2df2006bd3477d242" :answer/id #uuid "8878c6d8-f010-5cc2-ae57-e220015cf21a" :answer/type :answer.type/math :answer/value "D(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-337728/field-5" :answer-field/id #uuid "7bf0fd99-ed7f-512e-9d78-f4942425cd7a" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "q-337728/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c" :answer-field/choices ["q-337728/field-5/e534939b9e197dfca5b5dc09ebd7cb5f3e4a878d46b7929bd0bb8003b901fc3c" "q-337728/field-5/1801eb49afd418c37d4758c6270ecd785b57da55f39b3fa2df2006bd3477d242"] :db/ensure [:answer-field/validate]} {:db/id "q-337728/field-6/12092065ff4e11bb0d25fd69995cf910e9de428f4ac180ad1cb0a43a1ec62103" :answer/id #uuid "bc0890d7-4776-52c7-95d6-0e2a44d1ab6a" :answer/type :answer.type/text :answer/value "linear" :db/ensure [:answer/validate]} {:db/id "q-337728/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" :answer/id #uuid "7d1bc30a-4092-5f24-b647-131c396dcbbf" :answer/type :answer.type/text :answer/value "nonlinear" :db/ensure [:answer/validate]} {:db/id "q-337728/field-6" :answer-field/id #uuid "049f029f-22b5-5205-9f87-6e94a9f62443" :answer-field/key "field-6" :answer-field/type :answer-field.type/select :answer-field/correct "q-337728/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2" :answer-field/choices ["q-337728/field-6/12092065ff4e11bb0d25fd69995cf910e9de428f4ac180ad1cb0a43a1ec62103" "q-337728/field-6/5ebdfae41aad78ca664a4f2f428894195a370b1b616ec6630bdcd9fffe4d31d2"] :db/ensure [:answer-field/validate]} {:db/id "q-337728" :question/id #uuid "0727572c-0559-503c-b0bd-d0aa08280f19" :question/math-academy-id "q-337728" :question/problem "Consider the following differential operator:\n\n$$\nD(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{(\\frac{\\text{d}y}{\\text{d}x})}^{2}\n$$\n\nFill in the steps in the reasoning below.\n\nFor any linear differential operator $L,$ we have the linearity condition\n\n$$\n{{field-1}}\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & ={{field-2}}+{{field-3}} \\\\  & +2ab\\cdot {{field-4}}.\\end{aligned}\n$$\n\nWe also have\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}.\\end{aligned}\n$$\n\nNow, since {{field-5}} \nthe operator $D$ is {{field-6}}." :question/worked-solution "For any linear differential operator $L,$ we have the linearity condition\n\n$$\nL(a{y}_{1}+b{y}_{2})=aL({y}_{1})+bL({y}_{2})\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+{(\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}))}^{2} \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+2ab\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & +2ab\\cdot (\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\cdot \\frac{\\text{d}{y}_{2}}{\\text{d}x}).\\end{aligned}\n$$\n\nThis is *not* the same as the right-hand side, because\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a[\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}]+b[\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}] \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}.\\end{aligned}\n$$\n\nTherefore, since $D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2}),$ the operator $D$ is $\\text{nonlinear}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-337728/field-1" "q-337728/field-2" "q-337728/field-3" "q-337728/field-4" "q-337728/field-5" "q-337728/field-6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0"] :knowledge-point/questions ["q-337728"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130261/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "0fa2ea62-6d54-54aa-a3e9-229771883181" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-130261/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "0f6562f9-4f9c-523f-9e7e-385d5002ec8d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-130261/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "bde60884-f006-5b9d-b9b7-15c2297dedeb" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-130261/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "fb102718-087b-5bc4-81ad-3b86d31838a7" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-130261/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "a53e427b-3abd-51ba-ae03-7545d111f98a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-130261/selection" :answer-field/id #uuid "f546de6c-3e49-5599-a255-b30f098a94a1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130261/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-130261/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-130261/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-130261/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-130261/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-130261/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-130261" :question/id #uuid "3d8c3559-a0d3-57b0-8496-a5eb629e4fde" :question/math-academy-id "q-130261" :question/problem "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-2xy$\n- ${D}_{2}(y)={x}^{3}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$\n- ${D}_{3}(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+xy$" :question/worked-solution "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-2x(a{y}_{1}+b{y}_{2}) \\\\  & =ax\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+bx\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-2ax{y}_{1}-2bx{y}_{2} \\\\  & =a[x\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-2x{y}_{1}]+b[x\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-2x{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & ={x}^{3}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2}) \\\\  & =a{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}} \\\\  & =a[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}]+b[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+x(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}})+ax{y}_{1}+bx{y}_{2} \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}})+ax{y}_{1}+bx{y}_{2}\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\n\\begin{aligned}a{D}_{3}({y}_{1})+b{D}_{3}({y}_{2}) & =a[{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+x{y}_{1}]+b[{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+x{y}_{2}] \\\\  & =a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ax{y}_{1}+bx{y}_{2}.\\,\\times \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130261/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0"] :knowledge-point/questions ["q-130261"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130305/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "b6032e5c-906c-5bf4-bada-bfd53badd310" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-130305/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "95e12035-7a7a-5ba1-8c96-09db65f4ee36" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-130305/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "359614c8-439e-5414-bf7b-4aee41c2cfc3" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-130305/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "f8e5b2bf-3132-5bed-b44c-086901eb8266" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-130305/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "2463731f-fd89-5d11-a2f5-35583b68f7c4" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-130305/selection" :answer-field/id #uuid "ba4cd7ba-432e-5042-a7b9-98d32fcd0885" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130305/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-130305/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-130305/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-130305/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-130305/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-130305/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-130305" :question/id #uuid "4c09232e-7a55-5774-bf66-2b3b23800e12" :question/math-academy-id "q-130305" :question/problem "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)={x}^{3}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{x}^{2}y$\n- ${D}_{2}(y)=y\\frac{\\text{d}y}{\\text{d}x}+2y$\n- ${D}_{3}(y)=\\frac{\\text{d}y}{\\text{d}x}+xy$" :question/worked-solution "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & ={x}^{3}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+{x}^{2}(a{y}_{1}+b{y}_{2}) \\\\  & =a{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{x}^{2}{y}_{1}+a{x}^{2}{y}_{2} \\\\  & =a[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{x}^{2}{y}_{1}]+b[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{x}^{2}{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})+2(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x})+2a{y}_{1}+2b{y}_{2} \\\\  & ={a}^{2}{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+{b}^{2}{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ab({y}_{1}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{y}_{2}\\frac{\\text{d}{y}_{1}}{\\text{d}x})+2a{y}_{1}+2b{y}_{2}\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\n\\begin{aligned}a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2}) & =a[{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+2{y}_{1}]+b[{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+2{y}_{2}] \\\\  & =a{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+2a{y}_{1}+2b{y}_{2}.\\,\\times \\end{aligned}\n$$\n\n- The third operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})+x(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ax{y}_{1}+bx{y}_{2} \\\\  & =a[\\frac{\\text{d}{y}_{1}}{\\text{d}x}+x{y}_{1}]+b[\\frac{\\text{d}{y}_{2}}{\\text{d}x}+x{y}_{2}] \\\\  & =a{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})\\,✓\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-130305/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0"] :knowledge-point/questions ["q-130305"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79609/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "a9ca37dd-f675-58c0-a7cb-25a4ed8d99c9" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-79609/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "90df5ac0-4c38-59aa-8d77-2a24d53e2b8e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-79609/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "811e4d5a-0614-5de5-b253-faf0eecf3eb8" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-79609/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "846ac46d-8fff-5f8c-b26a-5aa8df04b65a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-79609/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e6a0e51d-63f2-5ad9-8ead-d55efbeb09e9" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-79609/selection" :answer-field/id #uuid "f76c28be-4b0a-546d-9193-263aead3144e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79609/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-79609/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-79609/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-79609/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-79609/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-79609/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-79609" :question/id #uuid "25cb2680-651e-5a50-81aa-a03a420f17ff" :question/math-academy-id "q-79609" :question/problem "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+y$\n- ${D}_{2}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-xy$\n- ${D}_{3}(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$" :question/worked-solution "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{y}_{1}+b{y}_{2} \\\\  & =a[\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{y}_{1}]+b[\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-x(a{y}_{1}+b{y}_{2}) \\\\  & =ax\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+bx\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-ax{y}_{1}-bx{y}_{2} \\\\  & =a[x\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-x{y}_{1}]+b[x\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-x{y}_{2}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}) \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}})\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\na{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})=a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}.\\,\\times \n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-79609/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17c792c0-3aec-5e40-8897-2eab9ff2ece0"] :knowledge-point/questions ["q-79609"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337739/field-1/4d2acbd3973371eb6e2f3212aaba712371c370f4795dd192f70e2c224fa981de" :answer/id #uuid "d194bb28-8bbf-5b7b-813e-167aa0f64241" :answer/type :answer.type/math :answer/value "L(a{y}_{1}\\cdot b{y}_{2})=abL({y}_{1})\\cdot L({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-337739/field-1/dbc99311ee86c41244f38f95f4fcdbdc590e3fb3a7aae092e02bca4dbddb2a61" :answer/id #uuid "2d086215-3ee5-5fde-b490-82564ba43c9f" :answer/type :answer.type/math :answer/value "L(a{y}_{1}+b{y}_{2})=L({y}_{1})+L({y}_{2})" :db/ensure [:answer/validate]} {:db/id "q-337739/field-1/eed57234b47a067f377ad0fb0c2a5ad0449cb23356c95b7fa70219a86487d6fc" :answer/id #uuid "569671fa-f39d-59df-b15d