\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-3" "attribute" "answer-field/choices" "value" [["math" "a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}"] ["math" "{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}"] ["math" "{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}-{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "{a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-4" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-4" "attribute" "answer-field/choices" "value" [["math" "(\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\cdot \\frac{\\text{d}{y}_{2}}{\\text{d}x})"] ["math" "(\\frac{\\text{d}{y}_{2}}{\\text{d}x}+\\frac{\\text{d}{y}_{1}}{\\text{d}x})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\cdot \\frac{\\text{d}{y}_{2}}{\\text{d}x})"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-5" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-5" "attribute" "answer-field/choices" "value" [["math" "D(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})"] ["math" "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-5" "attribute" "answer-field/correct" "value" [:answer.type/math "D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2})"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-6" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-6" "attribute" "answer-field/choices" "value" [["text" "linear"] ["text" "nonlinear"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337728" "field" "field-6" "attribute" "answer-field/correct" "value" [:answer.type/text "nonlinear"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130261" "field" nil "attribute" "question/problem" "value" "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-2xy$\n- ${D}_{2}(y)={x}^{3}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$\n- ${D}_{3}(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+xy$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130261" "field" nil "attribute" "question/worked-solution" "value" "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-2x(a{y}_{1}+b{y}_{2}) \\\\  & =ax\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+bx\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-2ax{y}_{1}-2bx{y}_{2} \\\\  & =a[x\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-2x{y}_{1}]+b[x\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-2x{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & ={x}^{3}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2}) \\\\  & =a{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}} \\\\  & =a[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}]+b[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+x(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}})+ax{y}_{1}+bx{y}_{2} \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}})+ax{y}_{1}+bx{y}_{2}\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\n\\begin{aligned}a{D}_{3}({y}_{1})+b{D}_{3}({y}_{2}) & =a[{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+x{y}_{1}]+b[{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+x{y}_{2}] \\\\  & =a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ax{y}_{1}+bx{y}_{2}.\\,\\times \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130261" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/activity-metadata.json" "file_sha256" "daa03b1e971a9bd14d6e1de601a82dccaeff80b6a805a0c9d410d350f02ff85d"} {"question" "q-130261" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130261" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130261" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130305" "field" nil "attribute" "question/problem" "value" "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)={x}^{3}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+{x}^{2}y$\n- ${D}_{2}(y)=y\\frac{\\text{d}y}{\\text{d}x}+2y$\n- ${D}_{3}(y)=\\frac{\\text{d}y}{\\text{d}x}+xy$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130305" "field" nil "attribute" "question/worked-solution" "value" "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & ={x}^{3}\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+{x}^{2}(a{y}_{1}+b{y}_{2}) \\\\  & =a{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{x}^{2}{y}_{1}+a{x}^{2}{y}_{2} \\\\  & =a[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{x}^{2}{y}_{1}]+b[{x}^{3}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{x}^{2}{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})+2(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x})+2a{y}_{1}+2b{y}_{2} \\\\  & ={a}^{2}{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+{b}^{2}{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ab({y}_{1}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{y}_{2}\\frac{\\text{d}{y}_{1}}{\\text{d}x})+2a{y}_{1}+2b{y}_{2}\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\n\\begin{aligned}a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2}) & =a[{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+2{y}_{1}]+b[{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+2{y}_{2}] \\\\  & =a{y}_{1}\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b{y}_{2}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+2a{y}_{1}+2b{y}_{2}.\\,\\times \\end{aligned}\n$$\n\n- The third operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2})+x(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x}+ax{y}_{1}+bx{y}_{2} \\\\  & =a[\\frac{\\text{d}{y}_{1}}{\\text{d}x}+x{y}_{1}]+b[\\frac{\\text{d}{y}_{2}}{\\text{d}x}+x{y}_{2}] \\\\  & =a{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})\\,✓\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130305" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/activity-metadata.json" "file_sha256" "daa03b1e971a9bd14d6e1de601a82dccaeff80b6a805a0c9d410d350f02ff85d"} {"question" "q-130305" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130305" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-130305" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-79609" "field" nil "attribute" "question/problem" "value" "Which of the following are linear differential operators?\n\n- ${D}_{1}(y)=\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+y$\n- ${D}_{2}(y)=x\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-xy$\n- ${D}_{3}(y)=y\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-79609" "field" nil "attribute" "question/worked-solution" "value" "For any linear differential operator,\n\n$$\nD(a{y}_{1}+b{y}_{2})=aD({y}_{1})+bD({y}_{2})\n$$\n\nwhere $a$ and $b$ are constants. \n\nLet's check each case in turn.\n\n- The first operator is indeed linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{1}(a{y}_{1}+b{y}_{2}) & =\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})+(a{y}_{1}+b{y}_{2}) \\\\  & =a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+a{y}_{1}+b{y}_{2} \\\\  & =a[\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{y}_{1}]+b[\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}] \\\\  & =a{D}_{1}({y}_{1})+b{D}_{1}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The second operator is also linear. To see this, we check the above linearity condition:\n\n$$\n\\begin{aligned}{D}_{2}(a{y}_{1}+b{y}_{2}) & =x\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2})-x(a{y}_{1}+b{y}_{2}) \\\\  & =ax\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+bx\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-ax{y}_{1}-bx{y}_{2} \\\\  & =a[x\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}-x{y}_{1}]+b[x\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}-x{y}_{2}] \\\\  & =a{D}_{2}({y}_{1})+b{D}_{2}({y}_{2})\\,✓\\end{aligned}\n$$\n\n- The third operator is **not** linear.\nTo see why, we first evaluate the left-hand side of the linearity condition:\n\n$$\n\\begin{aligned}{D}_{3}(a{y}_{1}+b{y}_{2}) & =(a{y}_{1}+b{y}_{2})\\frac{{\\text{d}}^{2}}{\\text{d}{x}^{2}}(a{y}_{1}+b{y}_{2}) \\\\  & =(a{y}_{1}+b{y}_{2})(a\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}) \\\\  & ={a}^{2}{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+{b}^{2}{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+ab({y}_{1}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}+{y}_{2}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}})\\end{aligned}\n$$\n\nThis is not the same as the right-hand side, because\n\n$$\na{D}_{3}({y}_{1})+b{D}_{3}({y}_{2})=a{y}_{1}\\frac{{\\text{d}}^{2}{y}_{1}}{\\text{d}{x}^{2}}+b{y}_{2}\\frac{{\\text{d}}^{2}{y}_{2}}{\\text{d}{x}^{2}}.\\,\\times \n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-79609" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/activity-metadata.json" "file_sha256" "daa03b1e971a9bd14d6e1de601a82dccaeff80b6a805a0c9d410d350f02ff85d"} {"question" "q-79609" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-79609" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I, II, and III"] ["text" "II and III only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-79609" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337739" "field" nil "attribute" "question/problem" "value" "Consider the following differential operator:\n\n$$\nD(y)={(\\frac{\\text{d}y}{\\text{d}x})}^{2}+y\n$$\n\nFill in the steps in the reasoning below.\n\nFor any linear differential operator $L,$ we have the linearity condition\n\n$$\n{{field-1}}\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & ={{field-2}}+{{field-3}} \\\\  & +ab\\cdot {{field-4}}.\\end{aligned}\n$$\n\nWe also have\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2}.\\end{aligned}\n$$\n\nNow, since {{field-5}} \nthe operator $D$ is {{field-6}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337739" "field" nil "attribute" "question/worked-solution" "value" "For any linear differential operator $L,$ we have the linearity condition\n\n$$\nL(a{y}_{1}+b{y}_{2})=aL({y}_{1})+bL({y}_{2})\n$$\n\nfor functions ${y}_{1}(x),{y}_{2}(x),$ and where $a$ and $b$ are constants. \n\nFor the given differential operator, we have\n\n$$\n\\begin{aligned}D(a{y}_{1}+b{y}_{2}) & ={(\\frac{\\text{d}}{\\text{d}x}(a{y}_{1}+b{y}_{2}))}^{2}+(a{y}_{1}+b{y}_{2}) \\\\  & ={(a\\frac{\\text{d}{y}_{1}}{\\text{d}x}+b\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2} \\\\  & ={a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+2ab\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\frac{\\text{d}{y}_{2}}{\\text{d}x}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2} \\\\  & +a{y}_{1}+b{y}_{2} \\\\  & ={a}^{2}{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{b}^{2}{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2} \\\\  & +ab\\cdot (2\\frac{\\text{d}{y}_{1}}{\\text{d}x}\\frac{\\text{d}{y}_{2}}{\\text{d}x}).\\end{aligned}\n$$\n\nThis is *not* the same as the right-hand side, because\n\n$$\n\\begin{aligned}aD({y}_{1})+bD({y}_{2}) & =a[{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+{y}_{1}]+b[{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+{y}_{2}] \\\\  & =a{(\\frac{\\text{d}{y}_{1}}{\\text{d}x})}^{2}+b{(\\frac{\\text{d}{y}_{2}}{\\text{d}x})}^{2}+a{y}_{1}+b{y}_{2}.\\end{aligned}\n$$\n\nTherefore, since $D(a{y}_{1}+b{y}_{2})\\ne aD({y}_{1})+bD({y}_{2}),$ the operator $D$ is $\\text{nonlinear}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037933/state.json" "file_sha256" "f0e97ba76e38bbb20dfcdf789f98364f30ac6ec71e5218c26a122e4264b7307d"} {"question" "q-337739" "field" 