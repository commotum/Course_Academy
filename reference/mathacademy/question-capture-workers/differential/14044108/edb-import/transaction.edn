ea0d47e4db8b" :answer/id #uuid "9f814402-6c71-53e1-b21e-b86114f0aeac" :answer/type :answer.type/math :answer/value "-{e}^{2x}" :db/ensure [:answer/validate]} {:db/id "q-352890/field-3/bb637b8e3ac0b8970c2c75830759fdb3813757ecd5e61a9d15e263b4610b58e5" :answer/id #uuid "ae5bdf20-d5e0-5db4-9307-2356669ff69a" :answer/type :answer.type/math :answer/value "-{e}^{x}" :db/ensure [:answer/validate]} {:db/id "q-352890/field-3/74521c50c65fc6a52056746481c6d39edacf577250ffbffd7ae5248b235295c6" :answer/id #uuid "48c95440-f966-52f2-a676-1e699b6fa825" :answer/type :answer.type/math :answer/value "{e}^{3x}" :db/ensure [:answer/validate]} {:db/id "q-352890/field-3/c975509865ebe917a276e7d586e7e6792b21fdfdb264ac448a7ca14faf6d2041" :answer/id #uuid "18b29a18-cadc-534e-87a2-98c19e87b76c" :answer/type :answer.type/math :answer/value "{e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-352890/field-3/20290c612f74c25a62a8c6938cf5d22ab000f382757142ddd721cda70773c9ef" :answer/id #uuid "04ae7f96-8a06-5107-b97f-5cc9fab774e0" :answer/type :answer.type/math :answer/value "{e}^{2x}" :db/ensure [:answer/validate]} {:db/id "q-352890/field-3" :answer-field/id #uuid "3cc3eeb4-8fbc-5444-a26c-0bcb52acdb1d" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-352890/field-3/499068f34581ae87e4bc74b85306b53e74df1d3c087391b136b8ea0d47e4db8b" :answer-field/choices ["q-352890/field-3/499068f34581ae87e4bc74b85306b53e74df1d3c087391b136b8ea0d47e4db8b" "q-352890/field-3/bb637b8e3ac0b8970c2c75830759fdb3813757ecd5e61a9d15e263b4610b58e5" "q-352890/field-3/74521c50c65fc6a52056746481c6d39edacf577250ffbffd7ae5248b235295c6" "q-352890/field-3/c975509865ebe917a276e7d586e7e6792b21fdfdb264ac448a7ca14faf6d2041" "q-352890/field-3/20290c612f74c25a62a8c6938cf5d22ab000f382757142ddd721cda70773c9ef"] :db/ensure [:answer-field/validate]} {:db/id "q-352890" :question/id #uuid "efe05efa-2761-5181-aebf-f550bba3f8de" :question/math-academy-id "q-352890" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3y={e}^{2x}.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{3x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{3x})}^{′}-3(u{e}^{3x}) & ={e}^{2x} \\\\ {u}^{′}{e}^{3x}+3u{e}^{3x}-3u{e}^{3x} & ={e}^{2x} \\\\ {u}^{′}{e}^{3x}+\\cancel{3u{e}^{3x}}-\\cancel{3u{e}^{3x}} & ={e}^{2x} \\\\ {u}^{′}{e}^{3x} & ={e}^{2x} \\\\ {u}^{′} & ={e}^{-x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & ={e}^{-x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int {e}^{-x}\\,\\text{d}x \\\\ u & =-{e}^{-x}.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{3x} \\\\  & =-{e}^{-x}\\cdot {e}^{3x} \\\\  & =-{e}^{2x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-352890/field-1" "q-352890/field-2" "q-352890/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ac34a18-053d-5eab-8c2c-bd0f15658186"] :knowledge-point/questions ["q-352890"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186155397 :answer-field/correct 17592186155399 :db/ensure [:answer-field/validate]} [:db/retract 17592186157696 :question/answer-fields 17592186155391] {:db/id "q-337175/field-2/ma-v1/1fad638f8de36dc15961beb409581bb078d58e7626d567725dc1aafd8f400991/d59d4859d6c9925aa1a7ad04c37008838597bda8ec975cff2dbbe57c0b03df39" :answer/id #uuid "21f3913e-8266-54c7-9844-71f0610500eb" :answer/type :answer.type/math :answer/value "\\int {e}^{2x}\\operatorname{sin}⁡4x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337175/field-2/ma-v1/1fad638f8de36dc15961beb409581bb078d58e7626d567725dc1aafd8f400991/775c0af206f1bd0663bc3316afcef690478bcf67e4889b3ee2c41e047e23dfca" :answer/id #uuid "6be492da-4423-5ee0-b031-0265fdc21c45" :answer/type :answer.type/math :answer/value "\\int {e}^{-2x}\\operatorname{cos}⁡4x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337175/field-2/ma-v1/1fad638f8de36dc15961beb409581bb078d58e7626d567725dc1aafd8f400991/1e42c89ab7e1ed2ce0a54b9e7e5d442a034e851f76f98b02cb0d5031741d06e6" :answer/id #uuid "886f45b3-41db-5a5c-9653-b06f1a3dd432" :answer/type :answer.type/math :answer/value "\\int {e}^{-2x}\\operatorname{sin}⁡4x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337175/field-2/ma-v1/1fad638f8de36dc15961beb409581bb078d58e7626d567725dc1aafd8f400991/ec1f38cef25955bc4a65b4d69c50d45b108661d4624ba54c4780c61378de7cb4" :answer/id #uuid "e5cc2058-45a4-5086-9cd1-e0b3d99a688c" :answer/type :answer.type/math :answer/value "\\int {e}^{2x}\\operatorname{cos}⁡4x\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337175/field-2/ma-v1/1fad638f8de36dc15961beb409581bb078d58e76