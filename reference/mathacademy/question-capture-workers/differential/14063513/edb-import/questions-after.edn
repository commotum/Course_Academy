#{[{:db/id #edb/ref 17592186266357 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e0dbd01-f32a-507d-95b3-24e4669d4eb9" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186266359} {:answer/id #uuid "46b5afeb-97e3-546e-9836-a517479ec1df" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266360} {:answer/id #uuid "d484a632-80ce-5061-ab02-ef7c9d2e8ecb" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186266361} {:answer/id #uuid "d854b1a7-d75c-563a-8e95-2c76f8c527e7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266362} {:answer/id #uuid "5b52f966-e10f-533e-b4db-8a3f4efd5c19" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266363}] :answer-field/correct {:answer/id #uuid "d854b1a7-d75c-563a-8e95-2c76f8c527e7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266362} :answer-field/id #uuid "cce54225-585f-5c7c-8a6a-837c9b1c837f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266358}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4b277ff2-a2f0-5aae-ae88-3cd92c483fac" :question/math-academy-id "q-115238" :question/problem "Given that\n\n$$\n\\frac{{x}^{3}+8{x}^{2}+17x+8}{x(x+2)^{3}}=\\frac{A}{x}+\\frac{B}{x+2}+\\frac{C}{(x+2)^{2}}+\\frac{D}{(x+2)^{3}},\n$$\n\nwhere $A$, $B$, $C$ and $D$ are real constants, determine the value of $AB+CD.$" :question/worked-solution "Multiplying both sides of the given equality by $x(x+2)^{3}$ gives\n\n$$\n{x}^{3}+8{x}^{2}+17x+8=A(x+2)^{3}+Bx(x+2)^{2}+Cx(x+2)+Dx.\n$$\n\nLetting $x=-2$  gives\n\n$$\n\\begin{aligned}(-2)^{3}+8(-2)^{2}+17(-2)+8 & =A(-2+2)^{3}+B(-2)(-2+2)^{2}+C(-2)(-2+2)+D(-2) \\\\ -8+32-34+8 & =-2D \\\\ -8+32-34+8 & =-2D \\\\ -2 & =-2D \\\\ D & =1.\\end{aligned}\n$$\n\nLetting $x=0$  gives\n\n$$\n\\begin{aligned}{0}^{3}+8(0)^{2}+17(0)+8 & =A(0+2)^{3}+B(0)(0+2)^{2}+C(0)(0+2)+D(0) \\\\ 8 & =8A \\\\ A & =1.\\end{aligned}\n$$\n\nLetting $x=-1$ and using our values for $A$ and $D$ gives\n\n$$\n\\begin{aligned}(-1)^{3}+8(-1)^{2}+17(-1)+8 & =1(-1+2)^{3}+B(-1)(-1+2)^{2}+C(-1)(-1+2)+1(-1) \\\\ -1+8-17+8 & =1-B-C-1 \\\\ B & =2-C.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=-3$ and using our values for $A$ and $D$ gives\n\n$$\n\\begin{aligned}(-3)^{3}+8(-3)^{2}+17(-3)+8 & =1(-3+2)^{3}+B(-3)(-3+2)^{2}+C(-3)(-3+2)+1(-3) \\\\ -27+72-51+8 & =-1-3B+3C-3 \\\\ 3B & =3C-6 \\\\ B & =C-2.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}2-C & =C-2 \\\\ -2C & =-4 \\\\ C & =2.\\end{aligned}\n$$\n\nNow we substitute the value of $C$ into $(1)$  to get the value of $B:$\n\n$$\nB=2-2=0\n$$\n\nFinally,\n\n$$\nAB+CD=1(0)+2(1)=2.\n$$"}] [{:db/id #edb/ref 17592186266371 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187" :knowledge-point/title "Calculating a Two-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50b216c3-6c77-5f83-a661-2b960439eb1d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266373} {:answer/id #uuid "2cc0f2a4-2113-51e5-b911-2fc4173260db" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266374}] :answer-field/correct {:answer/id #uuid "2cc0f2a4-2113-51e5-b911-2fc4173260db" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266374} :answer-field/id #uuid "2329c874-ee8f-5c9d-83d4-87658af4418f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186266372} {:answer-field/choices [{:answer/id #uuid "5938315a-c866-573c-8a13-1d7be2b6e540" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266376}] :answer-field/correct {:answer/id #uuid "5938315a-c866-573c-8a13-1d7be2b6e540" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266376} :answer-field/id #uuid "c1a45fa8-41ca-5db1-a38c-aa101b14f9ec" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186266375}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "062ba27e-c67f-5832-95a9-6322bb8e3762" :question/math-academy-id "q-346806" :question/problem "Express $\\frac{x+3}{(x+2)^{2}}$ as a sum of partial fractions.\n\n| $\\frac{x+3}{(x+2)^{2}}=$ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x+2$ |  | $(x+2)^{2}$ |" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{x+3}{(x+2)^{2}}=\\frac{A}{x+2}+\\frac{B}{(x+2)^{2}}.\\end{aligned}\n$$\n\nMultiplying both sides of the above equality by $(x+2)^{2}$ gives\n\n$$\nx+3=A(x+2)+B.\n$$\n\nLetting $x=-2$ gives\n\n$$\n\\begin{aligned}-2+3 & =A(-2+2)+B \\\\ B & =1.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}0+3 & =A(0+2)+1 \\\\ 3 & =2A+1 \\\\ A & =1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{x+3}{(x+2)^{2}}=\\frac{1}{x+2}+\\frac{1}{(x+2)^{2}}.\n$$"}] [{:db/id #edb/ref 17592186345890 :knowledge-point/_questions [{:knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221" :knowledge-point/title "Calculating a Three-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "11b93c37-76df-5ccf-a4c5-d4055df7ba79" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186345892} {:answer/id #uuid "3f2bcc8a-a217-5927-b61e-72e75a12f985" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186345893} {:answer/id #uuid "56b65bcd-abe1-5829-975f-6c3db20d722a" :answer/type {:db/ident :answer.type/math} :answer/value "-14" :db/id #edb/ref 17592186345894} {:answer/id #uuid "112ebcdc-103b-501f-812e-ab2d2b331411" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186345895} {:answer/id #uuid "aa6c0042-a7e2-5d47-a46a-1e63553f68c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345896}] :answer-field/correct {:answer/id #uuid "aa6c0042-a7e2-5d47-a46a-1e63553f68c1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345896} :answer-field/id #uuid "dea1edb2-7499-5313-991b-2b9c6fa27d8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345891}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0d4a04d7-f5d4-5485-81b0-edfd00411ffe" :question/math-academy-id "q-50041" :question/problem "Given that \n\n$$\n\\frac{3{x}^{2}+x+1}{{x}^{2}(x+1)}=\\frac{A}{x}+\\frac{B}{{x}^{2}}+\\frac{C}{x+1},\n$$\n\nwhere $A$, $B$, and $C$ are real constants, determine the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by ${x}^{2}(x+1)$ gives\n\n$$\n\\begin{aligned}3{x}^{2}+x+1 & =Ax(x+1)+B(x+1)+C{x}^{2}.\\end{aligned}\n$$\n\nLetting $x=0$  gives\n\n$$\n\\begin{aligned}3(0)^{2}+0+1 & =A(0)(0+1)+B(0+1)+C(0)^{2} \\\\ B & =1.\\end{aligned}\n$$\n\nLetting $x=-1$  gives\n\n$$\n\\begin{aligned}3(-1)^{2}+(-1)+1 & =A(-1)(-1+1)+B(-1+1)+C(-1)^{2} \\\\ C & =3.\\end{aligned}\n$$\n\nFinally, letting $x=1$ and using our values for $B$ and $C$ gives\n\n$$\n\\begin{aligned}3(1)^{2}+1+1 & =A(1)(1+1)+(1)(1+1)+(3)(1)^{2} \\\\ 5 & =2A+2+3 \\\\ 5 & =2A+5 \\\\ A & =0.\\end{aligned}\n$$\n\n  \n\nHence,\n\n$$\nA\\cdot B\\cdot C=0\\cdot 1\\cdot 3=0.\n$$"}] [{:db/id #edb/ref 17592186345897 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf6fd773-17da-5617-b5b6-9b1a1f9ac508" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345899} {:answer/id #uuid "ebe63480-3758-55f1-b6cd-8f28527c0a27" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186345900} {:answer/id #uuid "c30d38ff-08c3-56b9-8ca9-40e322607c25" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186345901} {:answer/id #uuid "a8fc1ad3-ffc0-5e69-a2d2-8bfe294c2b4d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186345902} {:answer/id #uuid "76eafc7c-164d-5ac2-91c8-5ff034d6092e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186345903}] :answer-field/correct {:answer/id #uuid "cf6fd773-17da-5617-b5b6-9b1a1f9ac508" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186345899} :answer-field/id #uuid "2328cd00-6281-5b62-8c32-00dbf60032f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345898}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2ac72bfe-dd66-56f2-82a3-114a24a5422c" :question/math-academy-id "q-70011" :question/problem "Given that\n\n$$\n\\frac{{x}^{2}+x+1}{{x}^{3}(x+1)}=\\frac{A}{x}+\\frac{B}{{x}^{2}}+\\frac{C}{{x}^{3}}+\\frac{D}{x+1},\n$$\n\nwhere $A$, $B$, $C$ and $D$ are real constants, determine the value of $AB-CD.$" :question/worked-solution "Multiplying both sides of the given equality by ${x}^{3}(x+1)$ gives\n\n$$\n{x}^{2}+x+1=A{x}^{2}(x+1)+Bx(x+1)+C(x+1)+D{x}^{3}.\n$$\n\nLetting $x=-1$ gives\n\n$$\n\\begin{aligned}(-1)^{2}+(-1)+1 & =A(-1)^{2}(-1+1)+B(-1)(-1+1)+C(-1+1)+D(-1)^{3} \\\\ 1-1+1 & =-D \\\\ 1 & =-D \\\\ D & =-1.\\end{aligned}\n$$\n\nLetting $x=0$ gives\n\n$$\n\\begin{aligned}{0}^{2}+0+1 & =A(0)^{2}(0+1)+B(0)(0+1)+C(0+1)+D(0)^{3} \\\\ 1 & =C.\\end{aligned}\n$$\n\nLetting $x=1$ and using our values for $C$ and $D$ gives\n\n$$\n\\begin{aligned}{1}^{2}+1+1 & =A(1)^{2}(1+1)+B(1)(1+1)+1(1+1)+(-1)(1)^{3} \\\\ 1+1+1 & =2A+2B+2-1 \\\\ 2B & =2-2A \\\\ B & =1-A.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=2$ and using our values for $C$ and $D$ gives\n\n$$\n\\begin{aligned}{2}^{2}+2+1 & =A(2)^{2}(2+1)+B(2)(2+1)+1(2+1)+(-1)(2)^{3} \\\\ 4+2+1 & =12A+6B+3-8 \\\\ 6B & =12-12A \\\\ B & =2-2A.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}1-A & =2-2A \\\\ A & =1.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(1)$  to get the value of $B:$\n\n$$\nB=1-1=0\n$$\n\nFinally,\n\n$$\nAB-CD=1(0)-1(-1)=1.\n$$"}] [{:db/id #edb/ref 17592186345904 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2b2e5f18-b0ca-53f1-b205-b8b3e0fa2b75" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186345906} {:answer/id #uuid "b91840f3-974c-5f5d-b674-48ea93006ac3" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186345907} {:answer/id #uuid "94728084-791a-53ed-bc6c-bcda1b0b8205" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186345908} {:answer/id #uuid "2fba6fe7-409c-5d6f-9297-733fac14caac" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186345909} {:answer/id #uuid "417051fb-bf5d-5d89-981e-db73d2e3a700" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186345910}] :answer-field/correct {:answer/id #uuid "417051fb-bf5d-5d89-981e-db73d2e3a700" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186345910} :answer-field/id #uuid "bf9c7773-54f1-5c3c-bd8f-b3d8d36bf895" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345905}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "618fd74c-661c-5109-b46a-db4bc3813b3a" :question/math-academy-id "q-73382" :question/problem "Given that \n\n$$\n\\frac{{x}^{2}-x+4}{(x+2)^{3}}=\\frac{A}{x+2}+\\frac{B}{(x+2)^{2}}+\\frac{C}{(x+2)^{3}},\n$$\n\nwhere $A$, $B$ and $C$ are real constants, find the value of $A\\cdot B+C.$" :question/worked-solution "Multiplying both sides of the given equality by $(x+2)^{3}$ gives\n\n$$\n\\begin{aligned}{x}^{2}-x+4 & =A(x+2)^{2}+B(x+2)+C.\\end{aligned}\n$$\n\nLetting $x=-2$  gives\n\n$$\n\\begin{aligned}(-2)^{2}-(-2)+4 & =A(-2+2)^{2}+B(-2+2)+C \\\\ 10 & =A(0)+B(0)+C \\\\ C & =10.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}(0)^{2}-(0)+4 & =A(0+2)^{2}+B(0+2)+10 \\\\ 4 & =4A+2B+10 \\\\ 0 & =4A+2B+6 \\\\ 0 & =2A+B+3 \\\\ B & =-2A-3.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=-1$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}(-1)^{2}-(-1)+4 & =A(-1+2)^{2}+B(-1+2)+10 \\\\ 6 & =A+B+10 \\\\ 0 & =A+B+4 \\\\ B & =-4-A.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}-2A-3 & =-4-A \\\\ -A & =-1 \\\\ A & =1.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(2)$  to get the value of $B:$\n\n$$\n\\begin{aligned}B & =-4-1=-5\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B+C & =1\\cdot (-5)+10 \\\\  & =-5+10 \\\\  & =5.\\end{aligned}\n$$"}]}
