#{[{:db/id #edb/ref 17592186266357 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e9c4ef2-0491-5b42-8679-4fe7dfbd7b00" :knowledge-point/title "Finding a Partial Fraction Decomposition With Higher Order Factors"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e0dbd01-f32a-507d-95b3-24e4669d4eb9" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186266359} {:answer/id #uuid "46b5afeb-97e3-546e-9836-a517479ec1df" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186266360} {:answer/id #uuid "d484a632-80ce-5061-ab02-ef7c9d2e8ecb" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186266361} {:answer/id #uuid "d854b1a7-d75c-563a-8e95-2c76f8c527e7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266362} {:answer/id #uuid "5b52f966-e10f-533e-b4db-8a3f4efd5c19" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186266363}] :answer-field/correct {:answer/id #uuid "d854b1a7-d75c-563a-8e95-2c76f8c527e7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266362} :answer-field/id #uuid "cce54225-585f-5c7c-8a6a-837c9b1c837f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186266358}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "4b277ff2-a2f0-5aae-ae88-3cd92c483fac" :question/math-academy-id "q-115238" :question/problem "Given that\n\n$$\n\\frac{{x}^{3}+8{x}^{2}+17x+8}{x(x+2)^{3}}=\\frac{A}{x}+\\frac{B}{x+2}+\\frac{C}{(x+2)^{2}}+\\frac{D}{(x+2)^{3}},\n$$\n\nwhere $A$, $B$, $C$ and $D$ are real constants, determine the value of $AB+CD.$" :question/worked-solution "Multiplying both sides of the given equality by $x(x+2)^{3}$ gives\n\n$$\n{x}^{3}+8{x}^{2}+17x+8=A(x+2)^{3}+Bx(x+2)^{2}+Cx(x+2)+Dx.\n$$\n\nLetting $x=-2$  gives\n\n$$\n\\begin{aligned}(-2)^{3}+8(-2)^{2}+17(-2)+8 & =A(-2+2)^{3}+B(-2)(-2+2)^{2}+C(-2)(-2+2)+D(-2) \\\\ -8+32-34+8 & =-2D \\\\ -8+32-34+8 & =-2D \\\\ -2 & =-2D \\\\ D & =1.\\end{aligned}\n$$\n\nLetting $x=0$  gives\n\n$$\n\\begin{aligned}{0}^{3}+8(0)^{2}+17(0)+8 & =A(0+2)^{3}+B(0)(0+2)^{2}+C(0)(0+2)+D(0) \\\\ 8 & =8A \\\\ A & =1.\\end{aligned}\n$$\n\nLetting $x=-1$ and using our values for $A$ and $D$ gives\n\n$$\n\\begin{aligned}(-1)^{3}+8(-1)^{2}+17(-1)+8 & =1(-1+2)^{3}+B(-1)(-1+2)^{2}+C(-1)(-1+2)+1(-1) \\\\ -1+8-17+8 & =1-B-C-1 \\\\ B & =2-C.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=-3$ and using our values for $A$ and $D$ gives\n\n$$\n\\begin{aligned}(-3)^{3}+8(-3)^{2}+17(-3)+8 & =1(-3+2)^{3}+B(-3)(-3+2)^{2}+C(-3)(-3+2)+1(-3) \\\\ -27+72-51+8 & =-1-3B+3C-3 \\\\ 3B & =3C-6 \\\\ B & =C-2.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}2-C & =C-2 \\\\ -2C & =-4 \\\\ C & =2.\\end{aligned}\n$$\n\nNow we substitute the value of $C$ into $(1)$  to get the value of $B:$\n\n$$\nB=2-2=0\n$$\n\nFinally,\n\n$$\nAB+CD=1(0)+2(1)=2.\n$$"}] [{:db/id #edb/ref 17592186266371 :knowledge-point/_questions [{:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187" :knowledge-point/title "Calculating a Two-Term Partial Fraction Decomposition"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50b216c3-6c77-5f83-a661-2b960439eb1d" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186266373} {:answer/id #uuid "2cc0f2a4-2113-51e5-b911-2fc4173260db" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266374}] :answer-field/correct {:answer/id #uuid "2cc0f2a4-2113-51e5-b911-2fc4173260db" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266374} :answer-field/id #uuid "2329c874-ee8f-5c9d-83d4-87658af4418f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186266372} {:answer-field/choices [{:answer/id #uuid "5938315a-c866-573c-8a13-1d7be2b6e540" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266376}] :answer-field/correct {:answer/id #uuid "5938315a-c866-573c-8a13-1d7be2b6e540" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186266376} :answer-field/id #uuid "c1a45fa8-41ca-5db1-a38c-aa101b14f9ec" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186266375}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "062ba27e-c67f-5832-95a9-6322bb8e3762" :question/math-academy-id "q-346806" :question/problem "Express $\\frac{x+3}{(x+2)^{2}}$ as a sum of partial fractions.\n\n| $\\frac{x+3}{(x+2)^{2}}=$ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x+2$ |  | $(x+2)^{2}$ |" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{x+3}{(x+2)^{2}}=\\frac{A}{x+2}+\\frac{B}{(x+2)^{2}}.\\end{aligned}\n$$\n\nMultiplying both sides of the above equality by $(x+2)^{2}$ gives\n\n$$\nx+3=A(x+2)+B.\n$$\n\nLetting $x=-2$ gives\n\n$$\n\\begin{aligned}-2+3 & =A(-2+2)+B \\\\ B & =1.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}0+3 & =A(0+2)+1 \\\\ 3 & =2A+1 \\\\ A & =1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{x+3}{(x+2)^{2}}=\\frac{1}{x+2}+\\frac{1}{(x+2)^{2}}.\n$$"}]}
