 the given slope fields, the only one that varies with $x$ for a fixed value of $y$ is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/ebd12a9b01a0eddc75a8e6a638ad68f55f694f980a6bccab91a8e8542a2c9038.png)\n\n  \n\nTo see this more clearly, notice that if we draw a horizontal line, the slopes touching the line vary as we go left and right along the line. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/0aae2e69cf46a7df097a7d34c7e53feb51516e3d7b710e65251fb49c3fc80cb7.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119294/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c9b15835-9882-5758-b5ee-924ba48f7efb"] :knowledge-point/questions ["q-119294"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98018/selection/d16155bd9672326a10e0430bf8f6eaaef3426e89810e98d9bc1e640cdfaccd7e" :answer/id #uuid "08ab3e22-dc8a-5986-8948-3162f057cb24" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/c311b0ac3ddea7b67b424adc87fccebef3e5bce445ccb730eb49e41919cd7bab.png" :db/ensure [:answer/validate]} {:db/id "q-98018/selection/a7339364db7239e7baf168ac01af7a1087824eb9677339e0519477ca964bf59e" :answer/id #uuid "dcfda3f4-524b-5053-aaa7-400a8abc357a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/2d6e60649a74a2962207052bcd6e4af075e3c1a2274459b809e9ddd85401234b.png" :db/ensure [:answer/validate]} {:db/id "q-98018/selection/e1601c5a392f540c0ea98c6693b9c48a61fccad5599753465af3643e5cd48e50" :answer/id #uuid "da047d73-738b-5c0d-9920-1f5bafb1f973" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-