81" :answer/id #uuid "71d3c551-ef78-5361-8015-7a58036a0cfc" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-97292/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e3d7969f-317d-567f-8fbb-37baf68aaca2" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-97292/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "9aff8853-b92a-531c-a0e2-368b68371770" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-97292/selection" :answer-field/id #uuid "733b35b8-eaab-5ef6-85d9-6635605f3f8c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-97292/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-97292/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-97292/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-97292/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-97292/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-97292/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-97292" :question/id #uuid "7a0a3c6e-b7b2-5bdb-b099-81675d5f04cb" :question/math-academy-id "q-97292" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-{y}^{2}$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $y=-1,$ the slope of the slope field does not vary\n- At every point along the line $x=1,$ the slope of the slope field varies\n- At every point along the line $y=0,$ the slope field is horizontal" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThis is an autonomous equation because the right-hand side is a function of $y$ only. This means that, for a fixed value of $y,$ the slope does not vary with $x.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(x,-1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-1)}=-(-1)^{2}=-1,\n$$\n\nand this implies that the slope at the point $(x,-1)$ is equal to $-1$ for any $x.$\n\n- Statement II is true. Consider a point of the form $(1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,y)}=-{y}^{2},\n$$\n\nand this implies that the slope of the slope field at the point $(1,y)$ depends on $y.$\n\n- Statement III is true. Consider a point of the form $(x,0)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,0)}=-(0)^{2}=0,\n$$\n\nand this implies that the slope at the point $(x,0)$ is horizontal for any $x.$\n\nTherefore, the correct answer is \"I, II, and III.\"\n\nWe can use the information given by the true statements to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/272427db87d74e3d4ae09dc69b7add53e8def9ead184a1ab90afc99fc0a7628e.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-97292/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1343e4de-56ee-563c-bdc8-f8c0cdc54f0d"] :knowledge-point/questions ["q-97292"] :db/ensure [:knowledge-point/validate]} {:db/id "q-97289/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "9d85016a-c3df-5e1b-ba4e-a3c946cb9687" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-97289/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "714c6d42-b007-5534-ba37-1d2f035fa285" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-97289/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "266d88fc-c792-5054-820d-c6608780a63e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-97289/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "c0019ca1-f707-5838-9ae8-0bcfe61fada9" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-97289/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "da8fc36f-99b0-52d7-ba19-aa9b5b2290d3" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-97289/selection" :answer-field/id #uuid "e40053a9-3249-5479-b63b-cbf93da09373" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-97289/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-97289/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-97289/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-97289/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-97289/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-97289/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-97289" :question/id #uuid "efea2738-a114-5133-8b72-e6cc8c2d82b4" :question/math-academy-id "q-97289" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2y$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $y=-1,$ the slope field has a negative slope\n- At every point along the line $y=0,$ the slope field is horizontal\n- At every point along the line $y=1,$ the slope field has a positive slope" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThis is an autonomous equation because the right-hand side is a function of $y$ only. This means that, for a fixed value of $y,$ the slope does not vary with $x.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(x,-1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-1)}=2(-1)=-2<0,\n$$\n\nand this implies that the slope at the point $(x,-1)$ is negative for any $x.$ Moreover, the slope at the point $(x,-1)$ is equal to $-2$ for any $x.$\n\n- Statement II is true. Consider a point of the form $(x,0)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,0)}=2(0)=0,\n$$\n\nand this implies that the slope at the point $(x,0)$ is horizontal for any $x.$\n\n- Statement III is true. Consider a point of the form $(x,1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,1)}=2(1)=2>0,\n$$\n\nand this implies that the slope at the point $(x,1)$ is positive for any $x.$ Moreover, the slope at the point $(x,1)$ is equal to $2$ for any $x.$\n\nTherefore, the correct answer is \"I, II, and III.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/69065d8e064b0fd679f059925f5445dcb2c7d037f180d3a144ee527ea408e8db.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-97289/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1343e4de-56ee-563c-bdc8-f8c0cdc54f0d"] :knowledge-point/questions ["q-97289"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119324/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "2794c68c-d4c2-5985-b38c-bb2df7e8afc2" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-119324/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "f573038b-7b03-5250-a324-cfab61187543" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-119324/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "542f567d-e68b-5ecf-ab13-3aaa443c087f" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-119324/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "04e20c23-b680-54df-8155-45408c7f96ce" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-119324/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "073f9176-373d-53c1-abe9-54e0a19d1e96" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-119324/selection" :answer-field/id #uuid "a04f6688-573e-59b4-8ccb-b85a4e68b23d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119324/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-119324/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-119324/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-119324/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-119324/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-119324/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-119324" :question/id #uuid "302c2eb2-363c-5d38-a827-d5d5950356a3" :question/math-academy-id "q-119324" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-y$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $y=2,$ the slope field has a positive slope\n- At every point along the line $y=0,$ the slope field is horizontal\n- At every point along the line $y=-2,$ the slope field has a negative slope" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThis is an autonomous equation because the right-hand side is a function of $y$ only. This means that, for a fixed value of $y,$ the slope does not vary with $x.$ \n\nNow, let's check each statement:\n\n- Statement I is false. Consider a point of the form $(x,2)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,2)}=-2<0,\n$$\n\nand this implies that the slope at the point $(x,2)$ is negative for any $x.$ Moreover, the slope at the point $(x,2)$ is equal to $-2$ for any $x.$\n\n- Statement II is true. Consider a point of the form $(x,0)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,0)}=-0=0,\n$$\n\nand this implies that the slope at the point $(x,0)$ is horizontal for any $x.$\n\n- Statement III is false. Consider a point of the form $(x,-2)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-2)}=-(-2)=2>0,\n$$\n\nand this implies that the slope at the point $(x,-2)$ is positive for any $x.$ Moreover, the slope at the point $(x,-2)$ is equal to $2$ for any $x.$\n\nTherefore, the correct answer is \"II only.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/8fc0b5be5c9147c29410ff7a082316403302f2bce7ec25c665ab7ccc5bf90b0f.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119324/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1343e4de-56ee-563c-bdc8-f8c0cdc54f0d"] :knowledge-point/questions ["q-119324"] :db/ensure [:knowledge-point/validate]} {:db/id "q-97288/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d4a6f56e-b3d3-57ff-8fd6-eeea00962f70" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-97288/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "3813e739-9351-56d3-8720-39efc9b2c25e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-97288/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" :answer/id #uuid "fc19ad3e-8ea9-598b-8501-dd6240083d4a" :answer/type :answer.type/text :answer/value "None of those listed" :db/ensure [:answer/validate]} {:db/id "q-97288/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "510ac373-dd16-5f71-bec0-eb88c7be68f2" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-97288/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "c6c33ef3-a72e-5fca-8b88-7981c7183ba9" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-97288/selection" :answer-field/id #uuid "401e099b-6c93-5cc5-b46b-ae89e91f9358" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-97288/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-97288/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-97288/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-97288/selection/c5361bc7e0ee1fc99d41021ab98e1ca699e408307178f1c31af6bc0071e78ea0" "q-97288/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-97288/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-97288" :question/id #uuid "6902a5bc-1eb1-59d0-83e7-00dc0fb1fa7e" :question/math-academy-id "q-97288" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y+1$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $y=-2,$ the slope field has a positive slope\n- At every point along the line $y=-1,$ the slope field is horizontal\n- At every point along the line $y=1,$ the slope field has a negative slope" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThis is an autonomous equation because the right-hand side is a function of $y$ only. This means that, for a fixed value of $y,$ the slope does not vary with $x.$ \n\nNow, let's check each statement:\n\n- Statement I is false. Consider a point of the form $(x,-2)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-2)}=-2+1=-1<0,\n$$\n\nand this implies that the slope at the point $(x,-2)$ is negative for any $x.$ Moreover, the slope at the point $(x,-2)$ is equal to $-1$ for any $x.$\n\n- Statement II is true. Consider a point of the form $(x,-1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-1)}=-1+1=0,\n$$\n\nand this implies that the slope at the point $(x,-1)$ is horizontal for any $x.$\n\n- Statement III is false. Consider a point of the form $(x,1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,1)}=1+1=2>0,\n$$\n\nand this implies that the slope at the point $(x,1)$ is positive for any $x.$ Moreover, the slope at the point $(x,1)$ is equal to $2$ for any $x.$\n\nTherefore, the correct answer is \"II only.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/caa69f6116eba6462c4fe18f2e535d83db350f0797cf1fcd895ac6df9a4d6fd7.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-97288/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1343e4de-56ee-563c-bdc8-f8c0cdc54f0d"] :knowledge-point/questions ["q-97288"] :db/ensure [:knowledge-point/validate]} {:db/id "q-97291/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "afb4f72b-27e4-5e75-8e43-f8971796cf5f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-97291/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "91b37e25-54fc-50da-a8aa-0a733deca278" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-97291/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "439722bb-d102-546e-862c-957d0394576a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-97291/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "f5ac134f-8b7c-5847-afc2-9c3ec5012a27" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-97291/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "e6f4b3a9-7ad1-52a6-8141-558c25bb5c1a" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-97291/selection" :answer-field/id #uuid "1367ef06-b74c-5d12-b678-36ebf0cba3cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-97291/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-97291/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-97291/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-97291/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-97291/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-97291/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-97291" :question/id #uuid "0b75acef-f7be-592d-8f9a-7508b45941e1" :question/math-academy-id "q-97291" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $y=-2,$ the slope field has a negative slope\n- At every point along the line $y=0,$ the slope field is horizontal\n- At every point along the line $y=1,$ the slope field has a positive slope" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(y).\n$$\n\nThis is an autonomous equation because the right-hand side is a function of $y$ only. This means that, for a fixed value of $y,$ the slope does not vary with $x.$ \n\nNow, let's check each statement:\n\n- Statement I is false. Consider a point of the form $(x,-2)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,-2)}=(-2)^{2}=4>0,\n$$\n\nand this implies that the slope at the point $(x,-2)$ is positive for any $x.$ Moreover, the slope at the point $(x,-2)$ is equal to $4$ for any $x.$\n\n- Statement II is true. Consider a point of the form $(x,0)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,0)}=(0)^{2}=0,\n$$\n\nand this implies that the slope at the point $(x,0)$ is horizontal for any $x.$\n\n- Statement III is true. Consider a point of the form $(x,1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,1)}=(1)^{2}=1>0,\n$$\n\nand this implies that the slope at the point $(x,1)$ is positive for any $x.$ Moreover, the slope at the point $(x,1)$ is equal to $1$ for any $x.$\n\nTherefore, the correct answer is \"II and III only.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/0c6e2e486ae770bc99ef9fe41f02d224de65119ade910d303ad3f57f12e8d84b.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-97291/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1343e4de-56ee-563c-bdc8-f8c0cdc54f0d"] :knowledge-point/questions ["q-97291"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119294/selection/0f048a16738518d7d71cd8438adbddd42584cb4fe93e4b3fe18a22d3e84d88c3" :answer/id #uuid "6830bf11-500e-5634-b03f-aa1d30b3d72a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/f63fd045036507f26e46483012ac6dadd802e790ceaa9233c5378001f9ad25f0.png" :db/ensure [:answer/validate]} {:db/id "q-119294/selection/aaa91bb4c9f0f83cc6cf910fa25c32b7cb757b2866efaf7ea3993a182f6f3735" :answer/id #uuid "c2b40554-6125-5a61-9170-93d52fa33c47" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/770ae7ca54bd59adfc54777ea5d8bcaeeee6931a0da546596160e5df4d3eec42.png" :db/ensure [:answer/validate]} {:db/id "q-119294/selection/d22feb41d2b380cf79fae43277c140b4708ea67ab56f69e16c4547da8753ac32" :answer/id #uuid "cfd26691-5774-5d8a-a0fc-c88d81d798dd" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/c7cef113e227089c501a72c6b323fc79865913d815bd27065271accd855b34f5.png" :db/ensure [:answer/validate]} {:db/id "q-119294/selection/6d27f9cb6f7af1c5e839456295259ddb9996391ac547438a9f787f83a0bfc0ac" :answer/id #uuid "b6d05d51-bc78-5008-8032-