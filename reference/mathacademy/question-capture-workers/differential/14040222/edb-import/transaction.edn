-capture-workers/differential/14040222/assets/0075556b1e97d2c805490deec07f0efa39257ccfc2d99117c7bcbbfc413a0fbb.png" :db/ensure [:answer/validate]} {:db/id "q-119309/selection" :answer-field/id #uuid "9bc412d0-1bf7-5853-ab2f-3a881d420d14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119309/selection/cfa67db00520332ec7d3ffd3a62e124632fb7a7e554398fbffd9e9487ee5f28e" :answer-field/choices ["q-119309/selection/24690fe7ff689b69ffe25520b400358931e3b9ecc8461ab5f36b7ce93c4d2a02" "q-119309/selection/6bc2dcec9b309ab7621b90664533239fd2996354f8cb63816faa478de538fe00" "q-119309/selection/92b977bf62a19a89bb1f4e306c2b7b738499898e3caa3975dce11ff84afe1e55" "q-119309/selection/cfa67db00520332ec7d3ffd3a62e124632fb7a7e554398fbffd9e9487ee5f28e" "q-119309/selection/b9787e5d3bd4fe5d09ba3a737087ace69206761f5f9298fa2692ca711ca6874d"] :db/ensure [:answer-field/validate]} {:db/id "q-119309" :question/id #uuid "2f1478d3-68c0-55da-a754-1a29e774dc96" :question/math-academy-id "q-119309" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2y-{y}^{2}?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,1),(1,1)$ and $(1,2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,1)}=2(1)-{1}^{2}=1, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)}=2(1)-{1}^{2}=1, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,2)}=2(2)-{2}^{2}=0.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/21828e2eb3d107ea12e90d715de9a3c1350e6fd95f03b321be7ab81a8824b065.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119309/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "555ed665-7dd7-5e0b-8c9d-39c0f31376d8"] :knowledge-point/questions ["q-119309"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-97622"] :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}={y}^{2}-y?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,1),(1,1),$ and $(1,-2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,1)}=(1)^{2}-(1)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)}=(1)^{2}-(1)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,-2)}=(-2)^{2}-(-2)=6.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/5f2f99159626fad30330210592c4e36859bfc30d7d3cf2c3f9178e1cb93498aa.png)" :db/ensure [:question/validate]} {:db/id "q-119303/selection/356bef45702085cbe82fb423aa7aea22ce84b880361f9b220db314b5f0e9fe90" :answer/id #uuid "5801b1ca-0ab4-5470-8403-07565f0c25f8" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/b51e287d7e6d20932c70c6a81e565b647230416aa54e25f35546d181e4767689.png" :db/ensure [:answer/validate]} {:db/id "q-119303/selection/24e7f7c4e71593fcbb0559dc5e3d72d6f502f5413bac26b4128485bdb553fb99" :answer/id #uuid "4f1c10e1-0b97-5ee2-9d2d-34c38c61cdc8" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040222/assets/28cea5c0c95e4693ea10aedebf1f361737dff629bc961efb085c0a5f726b2d