m the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{-8t}m(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-8t}\\,m(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s+8)t}\\,m(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $M(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,m(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+8)t}\\,m(t)\\,\\text{d}t=M(s+8),\n$$\n\nwhere \n\n$$\ns+8>{s}_{0}\\,⇒\\,s>{s}_{0}-8.\n$$"}] [{:db/id #edb/ref 17592186377949 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd" :knowledge-point/title "Proving the First Shifting Theorem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84cdb5cf-405a-5967-948e-81e85d0bd494" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{9t}d(t)" :db/id #edb/ref 17592186377951} {:answer/id #uuid "dd5fbb94-42e6-53c0-a143-9ab5f207ab81" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{9t}d(t)" :db/id #edb/ref 17592186377952} {:answer/id #uuid "6d65b5d5-bd3f-50f2-9c1f-1953913ae7f5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{-9t}d(t)" :db/id #edb/ref 17592186377953} {:answer/id #uuid "ebf71537-8470-5ab2-975e-430d59318d0a" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{st}\\cdot {e}^{-9t}d(t)" :db/id #edb/ref 17592186377954}] :answer-field/correct {:answer/id #uuid "6d65b5d5-bd3f-50f2-9c1f-1953913ae7f5" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-st}\\cdot {e}^{-9t}d(t)" :db/id #edb/ref 17592186377953} :answer-field/id #uuid "3bc1686a-2bb2-56ef-9b7e-fc192cad76f0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186377950} {:answer-field/choices [{:answer/id #uuid "aff86ece-c86a-5b99-897d-977b6fb926a2" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-(s-9)t}" :db/id #edb/ref 1759218637795