be05cc4eb5a0f2af09a7a44b491640aa483f92a581e7f9dd4bcc" "q-331798/field-4/48b411620ed377ee9222b817c8ed23aa5c39bdb48880d81d507d29eeec3ddf84" "q-331798/field-4/d2d1786d1fdaea12a8fac298c26577300858ae0cf5adeb565fa43d70a358a8e3"] :db/ensure [:answer-field/validate]} {:db/id "q-331798" :question/id #uuid "e40b15f2-55f9-58e9-9580-e97d03348d9c" :question/math-academy-id "q-331798" :question/problem "Consider a function $m(t)$ such that its Laplace transform is $L{m(t)}=M(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L{{e}^{-8t}m(t)}.$ Select the correct options in the reasoning below.By definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L{{e}^{-8t}m(t)} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,m(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{-8t}m(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-8t}\\,m(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s+8)t}\\,m(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $M(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,m(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+8)t}\\,m(t)\\,\\text{d}t=M(s+8),\n$$\n\nwhere \n\n$$\ns+8>{s}_{0}\\,⇒\\,s>{s}_{0}-8.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331798/field-1" "q-331798/field-2" "q-331798/field-3" "q-331798/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd"] :knowledge-point/questions ["q-331798"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186220113 :answer-field/correct 17592186220115 :db/ensure [:answer-field/validate]} {:db/id 17592186220108 :answer-field/correct 17592186220112 :db/ensure [:answer-field/validate]} {:db/id 17592186220118 :answer-field/correct 17592186220119 :db/ensure [:answer-field/validate]} {:db/id 17592186220122 :answer-field/correct 17592186220124 :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-328705"] :question/problem "Consider a function $f(t)$ such that its Laplace transform is $L{f(t)}=F(s)$ for $s>{s}_{0}.$ Suppose we wish to find $L{{e}^{2t}f(t)}.$ Select the correct options in the reasoning below. By definition of the Laplace transform, we can write \n\n$$\n\\begin{aligned}L{{e}^{2t}f(t)} & ={\\int }_{0}^{\\infty }{{field-1}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{{field-2}}\\,f(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" :question/worked-solution "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{2t}f(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{2t}\\,f(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $F(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,f(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s-2)t}\\,f(t)\\,\\text{d}t=F(s-2),\n$$\n\nwhere \n\n$$\ns-2>{s}_{0}\\,⇒\\,s>{s}_{0}+2.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-331808/field-1/165ba24de83dc6d45f82c392b2aa758e0f6f00affd19109f73b6827f65f2af1e" :answer/id #uuid "84cdb5cf-405a-5967-948e-81e85d0bd494" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{9t}d(t)" :db/ensure [:answer/validate]} {:db/id "q-331808/field-1/be996520b3f97333754bcb46964cfc6e4c81fabd076bef9b260c4508e24d72ff" :answer/id #uuid "6d65b5d5-bd3f-50f2-9c1f-1953913ae7f5" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{-9t}d(t)" :db/ensure [:answer/validate]} {:db/id "q-331808/field-1/e3703a92435fb169507f3c16e412b6e2adfb28a6086524c214d472371e229c7c" :answer/id #uuid "ebf71537-8470-5ab2-975e-430d59318d0a" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{-9t}d(t)" :db/ensure [:answer