}+25)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-331864/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2a921795-a527-5528-afcb-5881f188a665"] :knowledge-point/questions ["q-331864"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331860/selection/c4c11d7f54ff9d2cc77201c9fc384fd6b1fcea36ea6cd1ee79812d955ad35ab3" :answer/id #uuid "cab77f13-6b25-5374-ba39-8e45dc00fce6" :answer/type :answer.type/math :answer/value "\\frac{s+3}{(s+3)^{2}+6}" :db/ensure [:answer/validate]} {:db/id "q-331860/selection/d804434dcbdfafc599c7acfbfb044868f175d7578caaabcaee214070fde2b7cc" :answer/id #uuid "69bab47c-29b4-5e05-ad6c-0b0715462084" :answer/type :answer.type/math :answer/value "\\frac{s}{(s+3)^{2}+36}" :db/ensure [:answer/validate]} {:db/id "q-331860/selection/6218a9e2aaeee4f2f0246514906409b8f52dd664fae0bbb7eb5d66b85cda07c2" :answer/id #uuid "766b78e4-f110-58e0-9552-bb278d446a7e" :answer/type :answer.type/math :answer/value "\\frac{s-3}{(s-3)^{2}+36}" :db/ensure [:answer/validate]} {:db/id "q-331860/selection/f4e75cf25f80c717a2825517776ad4dbca2f8b3a63d4c2744630025ddd8a3d91" :answer/id #uuid "35e01a65-6626-577d-89fb-a919caf9c064" :answer/type :answer.type/math :answer/value "\\frac{s+3}{(s-3)^{2}+36}" :db/ensure [:answer/validate]} {:db/id "q-331860/selection/8a60201b757056dfe2bb4c8281188def2803882607476b1d8949c0c677e769fb" :answer/id #uuid "83ad3a68-b942-5451-a902-12702fcf6a95" :answer/type :answer.type/math :answer/value "\\frac{s+3}{(s+3)^{2}+36}" :db/ensure [:answer/validate]} {:db/id "q-331860/selection" :answer-field/id #uuid "fb9fc2cd-597a-5a7b-a29a-e6ba2e32c454" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-331860/selection/8a60201b757056dfe2bb4c8281188def2803882607476b1d8949c0c677e769fb" :answer-field/choices ["q-331860/selection/c4c11d7f54ff9d2cc77201c9fc384fd6b1fcea36ea6cd1ee79812d955ad35ab3" "q-331860/selection/d804434dcbdfafc599c7acfbfb044868f175d7578caaabcaee214070fde2b7cc" "q-331860/selection/6218a9e2aaeee4f2f0246514906409b8f52dd664fae0bbb7eb5d66b85cda07c2" "q-331860/selection/f4e75cf25f80c717a2825517776ad4dbca2f8b3a63d4c2744630025ddd8a3d91" "q-331860/selection/8a60201b757056dfe2bb4c8281188def2803882607476b1d8949c0c677e769fb"] :db/ensure [:answer-field/validate]} {:db/id "q-331860" :question/id #uuid "6647987c-4f82-5d47-9637-0313d4fe5f69" :question/math-academy-id "q-331860" :question/problem "Given that $L{\\operatorname{cos}⁡(\\omega t)}=\\frac{s}{{s}^{2}+{\\omega }^{2}},$ find the Laplace transform $L{{e}^{-3t}\\cdot \\operatorname{cos}⁡(6t)}.$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nUsing the given result, we have\n\n$$\nL{\\operatorname{cos}⁡(6t)}=\\frac{s}{{s}^{2}+{6}^{2}}.\n$$\n\nTherefore, applying the first shifting theorem, we get\n\n$$\n\\begin{aligned}L{{e}^{-3t}\\cdot \\operatorname{cos}⁡(6t)} & =\\frac{s+3}{(s+3)^{2}+{6}^{2}} \\\\  & =\\frac{s+3}{(s+3)^{2}+36}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-331860/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2a921795-a527-5528-afcb-5881f188a665"] :knowledge-point/questions ["q-331860"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-325858"] :question/problem "Given that $L{{t}^{n}}=\\frac{n!}{{s}^{n+1}},$ find the Laplace transform $L{{e}^{4t}\\cdot {t}^{3}}.$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nUsing the given result, we have\n\n$$\nL{{t}^{3}}=\\frac{3!}{{s}^{4}}.\n$$\n\nTherefore, applying the first shifting theorem, we get\n\n$$\n\\begin{aligned}L{{e}^{4t}\\cdot {t}^{3}} & =\\frac{3!}{(s-4)^{4}} \\\\  & =\\frac{6}{(s-4)^{4}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-331869/selection/056cec92a0bc55f15f8b4d718aa393a8b785a4dbb910d67d3cb09ff0afd9a188" :answer/id #uuid "2c211398-1c03-5d79-bc88-75ce8785ac37" :answer/type :answer.type/math :answer/value "\\frac{(s-3)^{2}-16}{((s-3)^{2}+16)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331869/selection/86b060b61c7c9c8494493c14045464490ca916aa9532dcdf5910b32796f9b3ff" :answer/id #uuid "1d88c06b-337e-5739-8d24-ac93a238915a" :answer/type :answer.type/math :answer/value "\\frac{(s+3)^{2}-16}{((s+3)^{2}+16)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331869/selection/b5a846d12d8ef8a965327f836c23bf56023237dd742a8153aa692fccbfc35eed" :answer/id #uuid "3fb3f9f1-f1b5-5224-a8e2-206a5e5a673b" :answer/type :answer.type/math :answer/value "\\frac{(s-3)^{2}-16}{(s-3)^{2}+16}" :db/ensure [:answer/validate]} {:db/id "q-331869/selection/a6935f347822be1fe52cd477ffef81e8a9f6901c91b20e4c44e4e065b87addad" :answer/id #uuid "c70c0c53-7d48-5b95-a0a5-62ae5b1b2703" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}-16}{((s-3)^{2}+16)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331869/selection/4e9aa96c989285956573557e15cdcc4ede823ed83589d44d867bd11608740ee4" :answer/id #uuid "302eba65-8b01-54a8-85f5-11e0f4898873" :answer/type :answer.type/math :answer/value "\\frac{(s-3)^{2}-4}{((s-3)^{2}+16)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331869/selection" :answer-field/id #uuid "a52abd08-899a-5900-b030-9a02bc0ae94d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-331869/selection/056cec92a0bc55f15f8b4d718aa393a8b785a4dbb910d67d3cb09ff0afd9a188" :answer-field/choices ["q-331869/selection/056cec92a0bc55f15f8b4d718aa393a8b785a4dbb910d67d3cb09ff0afd9a188" "q-331869/selection/86b060b61c7c9c8494493c14045464490ca916aa9532dcdf5910b32796f9b3ff" "q-331869/selection/b5a846d12d8ef8a965327f836c23bf56023237dd742a8153aa692fccbfc35eed" "q-331869/selection/a6935f347822be1fe52cd477ffef81e8a9f6901c91b20e4c44e4e065b87addad" "q-331869/selection/4e9aa96c989285956573557e15cdcc4ede823ed83589d44d867bd11608740ee4"] :db/ensure [:answer-field/validate]} {:db/id "q-331869" :question/id #uuid "601512ec-cb19-56e6-b7c8-01c935f6a50a" :question/math-academy-id "q-331869" :question/problem "Given that $L{t\\operatorname{cos}⁡(\\omega t)}=\\frac{{s}^{2}-{\\omega }^{2}}{({s}^{2}+{\\omega }^{2})^{2}},$ find the Laplace transform $L{{e}^{3t}\\cdot t\\operatorname{cos}⁡(4t)}.$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nUsing the given result, we have\n\n$$\nL{t\\operatorname{cos}⁡(4t)}=\\frac{{s}^{2}-{4}^{2}}{({s}^{2}+{4}^{2})^{2}}.\n$$\n\nTherefore, applying the first shifting theorem, we get\n\n$$\n\\begin{aligned}L{{e}^{3t}\\cdot t\\operatorname{cos}⁡(4t)} & =\\frac{(s-3)^{2}-{4}^{2}}{((s-3)^{2}+{4}^{2})^{2}} \\\\  & =\\frac{(s-3)^{2}-16}{((s-3)^{2}+16)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-331869/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2a921795-a527-5528-afcb-5881f188a665"] :knowledge-point/questions ["q-331869"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332190/selection/90a5991fe7e8afc001cdbf76926095914e7111c94f7f4b0aec7d78d6e2e00bc2" :answer/id #uuid "d5a2ead2-0349-5752-bc22-147593e0d8fa" :answer/type :answer.type/math :answer/value "\\frac{5}{s+1}+\\frac{6}{(s-2)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332190/selection/30ce43c0c1b363055c28e6d1f49c7aded4e4011115a94f1ebb0183d5e0ba06c0" :answer/id #uuid "22da784f-5fbf-5dfd-8501-d123f391ab58" :answer/type :answer.type/math :answer/value "\\frac{5}{s-1}+\\frac{18}{(s+2)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332190/selection/2f0b78788695262591f49c54051f7accded1cc0861a09b541a4f0dbbee8f409f" :answer/id #uuid "728d1bd0-854f-5db8-972a-b2dcf7cb20fd" :answer/type :answer.type/math :answer/value "\\frac{5}{s+1}+\\frac{18}{(s+2)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332190/selection/3671794f71029b3b21c625f56d0e7741378ddb18cb86a3048ae7958b8d44e0fe" :answer/id #uuid "e50fba9a-42ec-5536-998b-8f7ba58a8073" :answer/type :answer.type/math :answer/value "\\frac{5}{s-1}+\\frac{18}{(s-2)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332190/selection/f64df023ba65b218b8db6c6affe9ce02d02e0fc295696b2cbb531cf7474ee49c" :answer/id #uuid "21adcb68-5bfc-5ff6-8479-1f92eebd73d9" :answer/type :answer.type/math :answer/value "\\frac{5}{s+1}+\\frac{18}{(s-2)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332190/selection" :answer-field/id #uuid "3fc1a32e-0c5e-5f80-8d30-a7fe77f30ec0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-332190/selection/f64df023ba65b218b8db6c6affe9ce02d02e0fc295696b2cbb531cf7474ee49c" :answer-field/choices ["q-332190/selection/90a5991fe7e8afc001cdbf76926095914e7111c94f7f4b0aec7d78d6e2e00bc2" "q-332190/selection/30ce43c0c1b363055c28e6d1f49c7aded4e4011115a94f1ebb0183d5e0ba06c0" "q-332190/selection/2f0b78788695262591f49c54051f7accded1cc0861a09b541a4f0dbbee8f409f" "q-332190/selection/3671794f71029b3b21c625f56d0e7741378ddb18cb86a3048ae7958b8d44e0fe" "q-332190/selection/f64df023ba65b218b8db6c6affe9ce02d02e0fc295696b2cbb531cf7474ee49c"] :db/ensure [:answer-field/validate]} {:db/id "q-332190" :question/id #uuid "ea79698b-0d42-5638-aac5-5f80a3d13f95" :question/math-academy-id "q-332190" :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of  $f(t)=5{e}^{-t}+3{t}^{3}{e}^{2t}$ for $s>2.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{5{e}^{-t}+3{t}^{3}{e}^{2t}} \\\\  & =L{5{e}^{-t}}+L{3{t}^{3}{e}^{2t}} \\\\  & =5L{{e}^{-t}}+3L{{t}^{3}{e}^{2t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{t}^{3}} & =\\frac{6}{{s}^{4}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L{{t}^{3}{e}^{2t}} & =\\frac{6}{(s-2)^{4}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =5L{{e}^{-t}}+3L{{t}^{3}{e}^{2t}} \\\\  & =5\\cdot \\frac{1}{s+1}+3\\cdot \\frac{6}{(s-2)^{4}} \\\\  & =\\frac{5}{s+1}+\\frac{18}{(s-2)^{4}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332190/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb"] :knowledge-point/questions ["q-332190"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-89592"] :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)={e}^{-2t}+2t{e}^{2t}$ for $s>2.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{-2t}+2t{e}^{2t}} \\\\  & =L{{e}^{-2t}}+L{2t{e}^{2t}} \\\\  & =L{{e}^{-2t}}+2L{t{e}^{2t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{t} & =\\frac{1}{{s}^{2}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L{t{e}^{2t}} & =\\frac{1}{(s-2)^{2}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{-2t}}+2L{t{e}^{2t}} \\\\  & =\\frac{1}{s+2}+2\\cdot \\frac{1}{(s-2)^{2}} \\\\  & =\\frac{1}{s+2}+\\frac{2}{(s-2)^{2}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>2.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-332133/selection/eb2b87dc98745b8b58a7a524527ff3319ec030088c71fe7416f8dc341876253d" :answer/id #uuid "476a0af2-cc7b-5b38-8b09-ccf3f76f2a3e" :answer/type :answer.type/math :answer/value "\\frac{5}{{s}^{3}}+\\frac{9}{(s-3)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-332133/selection/357e1760ec5e092173e45b73103984e0af50bd4dc11ad0e637ebc93928a795f8" :answer/id #uuid "e9cc487a-56e7-556f-b9e9-5cb13210c5a4" :answer/type :answer.type/math :answer/value "\\frac{10}{{s}^{2}}+\\frac{9}{(s-3)^{3}}" :db/ensure [:answer/validate]} {:db/id "q-332133/selection/34cc6b20c978ba78d17471234e142bcc8c770415f59121a7322d1a3b43d84afe" :answer/id #uuid "bfc05374-8f5e-526e-ac2e-dec8b6bac9d8" :answer/type :answer.type/math :answer/value "\\frac{10}{{s}^{3}}+\\frac{9}{(s-3)^{3}}" :db/ensure [:answer/validate]} {:db/id "q-332133/selection/d5e96ee52f251ef76817f250cfe0d556de9434a844c77ec6f0a5f6ced14191a5" :answer/id #uuid "eaa2cebc-1ee2-5848-836e-c482688489a6" :answer/type :answer.type/math :answer/value "\\frac{10}{{s}^{3}}+\\frac{3}{(s-3)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-332133/selection/cd499cf1b0d2ebe2beabef48b719cd09d56ae3746681c84cc459b0358bec85aa" :answer/id #uuid "5a6a1a56-37ef-548b-92db-53d6dffdef0c" :answer/type :answer.type/math :answer/value "\\frac{10}{{s}^{3}}+\\frac{9}{(s-3)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-332133/selection" :answer-field/id #uuid "cf03c69d-8514-5c63-85ee-d03362b60eae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-332133/selection/cd499cf1b0d2ebe2beabef48b719cd09d56ae3746681c84cc459b0358bec85aa" :answer-field/choices ["q-332133/selection/eb2b87dc98745b8b58a7a524527ff3319ec030088c71fe7416f8dc341876253d" "q-332133/selection/357e1760ec5e092173e45b73103984e0af50bd4dc11ad0e637ebc93928a795f8" "q-332133/selection/34cc6b20c978ba78d17471234e142bcc8c770415f59121a7322d1a3b43d84afe" "q-332133/selection/d5e96ee52f251ef76817f250cfe0d556de9434a844c77ec6f0a5f6ced14191a5" "q-332133/selection/cd499cf1b0d2ebe2beabef48b719cd09d56ae3746681c84cc459b0358bec85aa"] :db/ensure [:answer-field/validate]} {:db/id "q-332133" :question/id #uuid "349d4b15-ca25-58c6-9fd5-8cd3227b330d" :question/math-academy-id "q-332133" :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)=5{t}^{2}+9t{e}^{3t}$ for $s>3.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{5{t}^{2}+9t{e}^{3t}} \\\\  & =L{5{t}^{2}}+L{9t{e}^{3t}} \\\\  & =5L{{t}^{2}}+9L{t{e}^{3t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{t} & =\\frac{1}{{s}^{2}} \\\\ L{{t}^{2}} & =\\frac{2}{{s}^{3}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\nL{t{e}^{3t}}=\\frac{1}{(s-3)^{2}}.\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =5L{{t}^{2}}+9L{t{e}^{3t}} \\\\  & =5\\cdot \\frac{2}{{s}^{3}}+9\\cdot \\frac{1}{(s-3)^{2}} \\\\  & =\\frac{10}{{s}^{3}}+\\frac{9}{(s-3)^{2}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332133/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb"] :knowledge-point/questions ["q-332133"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332199/selection/01c0484102de5d24fd380a6e4914ae7784d419544e809dd5de1cd6c8100bdfe9" :answer/id #uuid "315b5ab2-dc83-547c-bc5b-5ab2c8dc19d5" :answer/type :answer.type/math :answer/value "\\frac{1}{s-2}+\\frac{12}{(s+4)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332199/selection/3848dccc11835e7012eefa2ce097b5b8ff89c97960d3bda60ee5258df6e82c8c" :answer/id #uuid "65916f66-a1ca-5ca6-b9dc-2f67b42e2987" :answer/type :answer.type/math :answer/value "\\frac{6}{s+2}+\\frac{12}{(s+4)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332199/selection/755c4015f37a67858835078145507e92dc2f9e23b75ae9789e2da35e89eaa7ba" :answer/id #uuid "6a28d786-1b70-598e-9b8c-3d5af8c4a59f" :answer/type :answer.type/math :answer/value "\\frac{6}{s-2}+\\frac{12}{(s-4)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332199/selection/8a9db7843e7edaa4808d1c1a66862d7c6fa1ceaa21e33cf425e67fcd5297acf6" :answer/id #uuid "5ecdffee-1d57-5815-ac2d-e5cc99d36fda" :answer/type :answer.type/math :answer/value "\\frac{6}{s-2}+\\frac{6}{(s+4)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332199/selection/b76aa867ed7d1183061a2561f1074ddaf84f14b6b5ec517d25aee508deeee93d" :answer/id #uuid "749ab803-106b-5196-9236-17de17eb721b" :answer/type :answer.type/math :answer/value "\\frac{6}{s-2}+\\frac{12}{(s+4)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332199/selection" :answer-field/id #uuid "52b1ef48-ad2d-5363-a807-789fa07277c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-332199/selection/b76aa867ed7d1183061a2561f1074ddaf84f14b6b5ec517d25aee508deeee93d" :answer-field/choices ["q-332199/selection/01c0484102de5d24fd380a6e4914ae7784d419544e809dd5de1cd6c8100bdfe9" "q-332199/selection/3848dccc11835e7012eefa2ce097b5b8ff89c97960d3bda60ee5258df6e82c8c" "q-332199/selection/755c4015f37a67858835078145507e92dc2f9e23b75ae9789e2da35e89eaa7ba" "q-332199/selection/8a9db7843e7edaa4808d1c1a66862d7c6fa1ceaa21e33cf425e67fcd5297acf6" "q-332199/selection/b76aa867ed7d1183061a2561f1074ddaf84f14b6b5ec517d25aee508deeee93d"] :db/ensure [:answer-field/validate]} {:db/id "q-332199" :question/id #uuid "025143ae-62a8-5506-b379-b3b2619c5b55" :question/math-academy-id "q-332199" :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of  $f(t)=6{e}^{2t}+2{t}^{3}{e}^{-4t}$ for $s>2.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{6{e}^{2t}+2{t}^{3}{e}^{-4t}} \\\\  & =L{6{e}^{2t}}+L{2{t}^{3}{e}^{-4t}} \\\\  & =6L{{e}^{2t}}+2L{{t}^{3}{e}^{-4t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{t}^{3}} & =\\frac{6}{{s}^{4}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L{{t}^{3}{e}^{-4t}} & =\\frac{6}{(s+4)^{4}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =6L{{e}^{2t}}+2L{{t}^{3}{e}^{-4t}} \\\\  & =6\\cdot \\frac{1}{s-2}+2\\cdot \\frac{6}{(s+4)^{4}} \\\\  & =\\frac{6}{s-2}+\\frac{12}{(s+4)^{4}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332199/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb"] :knowledge-point/questions ["q-332199"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332183/selection/e05bfc27fa7f93ca2febeec53e3d9033130109071797ba391185a05570427cf1" :answer/id #uuid "ed9bd43f-3e89-5adc-833e-87c9cb9a2e1d" :answer/type :answer.type/math :answer/value "\\frac{1}{s-4}+\\frac{30}{(s-1)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332183/selection/d80c3dd52dc4688189fb4a0c88c4dd8b7f8624a0c66e63492df5382ca2c1e177" :answer/id #uuid "34eaced7-9b4f-5b9c-ada3-12ccb96a2376" :answer/type :answer.type/math :answer/value "\\frac{1}{s-4}+\\frac{30}{(s+1)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332183/selection/967d56ce15487cb495686afccbb3336a56aba619fb4618c9a84df0916588a9d5" :answer/id #uuid "97f4ca32-717d-5b51-bf34-80479722f184" :answer/type :answer.type/math :answer/value "\\frac{1}{s+4}+\\frac{30}{(s+1)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332183/selection/9c13f5caa2b22112baa4d0d5a6b378e8160ecec243ce0484846ef8c77de028e6" :answer/id #uuid "18167721-48db-5815-b5b3-d5c425ad198f" :answer/type :answer.type/math :answer/value "\\frac{1}{s-4}+\\frac{6}{(s+1)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332183/selection/3e44f2c98e015b2cd082bce0b2656906d0000afeabf21632e8337a110d9b11a2" :answer/id #uuid "01207b56-c7b7-5d71-b917-f9c259b96270" :answer/type :answer.type/math :answer/value "\\frac{4}{s-4}+\\frac{30}{(s+1)^{4}}" :db/ensure [:answer/validate]} {:db/id "q-332183/selection" :answer-field/id #uuid "d4bf1113-7bca-570e-9f5a-2b0d9d7450b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-332183/selection/d80c3dd52dc4688189fb4a0c88c4dd8b7f8624a0c66e63492df5382ca2c1e177" :answer-field/choices ["q-332183/selection/e05bfc27fa7f93ca2febeec53e3d9033130109071797ba391185a05570427cf1" "q-332183/selection/d80c3dd52dc4688189fb4a0c88c4dd8b7f8624a0c66e63492df5382ca2c1e177" "q-332183/selection/967d56ce15487cb495686afccbb3336a56aba619fb4618c9a84df0916588a9d5" "q-332183/selection/9c13f5caa2b22112baa4d0d5a6b378e8160ecec243ce0484846ef8c77de028e6" "q-332183/selection/3e44f2c98e015b2cd082bce0b2656906d0000afeabf21632e8337a110d9b11a2"] :db/ensure [:answer-field/validate]} {:db/id "q-332183" :question/id #uuid "b7eba2fe-279d-5114-9243-1203baad1a5e" :question/math-academy-id "q-332183" :question/problem "Given that\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}, &  & s>0,\\end{aligned}\n$$\n\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t)={e}^{4t}+5{t}^{3}{e}^{-t}$ for $s>4.$" :question/worked-solution "First, we apply the linearity properties of Laplace transforms:\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{4t}+5{t}^{3}{e}^{-t}} \\\\  & =L{{e}^{4t}}+L{5{t}^{3}{e}^{-t}} \\\\  & =L{{e}^{4t}}+5L{{t}^{3}{e}^{-t}}\\end{aligned}\n$$\n\nWe are given that, for $s>0,$\n\n$$\n\\begin{aligned}L{{t}^{n}} & =\\frac{n!}{{s}^{n+1}}.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{t}^{3}} & =\\frac{6}{{s}^{4}}\\end{aligned}\n$$\n\nThe first shifting theorem states that if $L{f(t)}=F(s),$ then $L{{e}^{at}f(t)}=F(s-a).$ Therefore,\n\n$$\n\\begin{aligned}L{{t}^{3}{e}^{-t}} & =\\frac{6}{(s+1)^{4}}.\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{4t}}+5L{{t}^{3}{e}^{-t}} \\\\  & =\\frac{1}{s-4}+5\\cdot \\frac{6}{(s+1)^{4}} \\\\  & =\\frac{1}{s-4}+\\frac{30}{(s+1)^{4}}.\\end{aligned}\n$$\n\nThis transform is valid for $s>4.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332183/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb"] :knowledge-point/questions ["q-332183"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-328557"] :question/problem "Consider a function $f(t)$ for which the Laplace transform is $L{f(t)}=F(s).$ How can we obtain the graph of $L{{e}^{3t}f(t)}$ from the graph of $F(s)?$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nThis implies that multiplying a function $f(t)$ by ${e}^{at}$ shifts the corresponding Laplace transform horizontally along the $s$-axis.\n\n- If $a>0,$ the graph of $F(s)$ shifts to the right.\n\n- If $a<0,$ the graph of $F(s)$ shifts to the left.\n\nIn our case, to get the graph of $L{{e}^{3t}f(t)},$ we must shift the graph of $F(s)$ by $3$ units to the right." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-332059/selection/dc1d74cd030d28a74c069c8374ac643fd3c4cd8c3c5f741e0564841cbf22c9d8" :answer/id #uuid "a1b5ddba-c0e3-5a85-a3ce-b8ff42c343c3" :answer/type :answer.type/text :answer/value "Shift the graph of $F(s)$ by $5$ units to the right." :db/ensure [:answer/validate]} {:db/id "q-332059/selection/407ff7b975389e2be0a04d329511db6d7dd10c668bda1aab47c3f76aed7e146e" :answer/id #uuid "5e4ebccc-3f40-5af4-a8bc-b755cbf85e23" :answer/type :answer.type/text :answer/value "Scale the graph of $F(s)$ by a scale factor of $5$ horizontally." :db/ensure [:answer/validate]} {:db/id "q-332059/selection/e5a229601f4c5f1b42ec06c8de66df0207e333644348e9d070d85a9bf5e6a93f" :answer/id #uuid "0bb52edb-7547-59fb-81be-9c5810559fc7" :answer/type :answer.type/text :answer/value "Shift the graph of $F(s)$ by $5$ units to the left." :db/ensure [:answer/validate]} {:db/id "q-332059/selection/3268e1ebdd0badff51f24a21cc434ae6452b715c7af79c67892cb47a0298b211" :answer/id #uuid "fe67aa0c-b2f6-50d8-baf6-d9d348d58f43" :answer/type :answer.type/text :answer/value "Scale the graph of $F(s)$ by a scale factor of $5$ vertically." :db/ensure [:answer/validate]} {:db/id "q-332059/selection/c8eef055169525a686a79fcb7918c653404a79516d47ed45fbd136c5797faef6" :answer/id #uuid "80901c91-7275-51e0-a013-ed8600020cdf" :answer/type :answer.type/text :answer/value "The Laplace transform is unchanged." :db/ensure [:answer/validate]} {:db/id "q-332059/selection" :answer-field/id #uuid "36f41402-758d-56a1-a894-e1df8c069c08" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-332059/selection/dc1d74cd030d28a74c069c8374ac643fd3c4cd8c3c5f741e0564841cbf22c9d8" :answer-field/choices ["q-332059/selection/dc1d74cd030d28a74c069c8374ac643fd3c4cd8c3c5f741e0564841cbf22c9d8" "q-332059/selection/407ff7b975389e2be0a04d329511db6d7dd10c668bda1aab47c3f76aed7e146e" "q-332059/selection/e5a229601f4c5f1b42ec06c8de66df0207e333644348e9d070d85a9