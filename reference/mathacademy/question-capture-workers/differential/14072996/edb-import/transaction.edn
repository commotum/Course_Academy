igned}\n$$\n\nNow, recall that $D(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,d(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+9)t}\\,d(t)\\,\\text{d}t=D(s+9),\n$$\n\nwhere \n\n$$\ns+9>{s}_{0}\\,⇒\\,s>{s}_{0}-9.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331808/field-1" "q-331808/field-2" "q-331808/field-3" "q-331808/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aeb2589b-0135-5bbb-bc91-ec121ee5defd"] :knowledge-point/questions ["q-331808"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331788/field-1/773edce6b420385ef65fc34f48f4b4b0345a07fec5bb0f2d620ae4b21da718f3" :answer/id #uuid "6f9645ae-d55f-562f-a835-884c71450a02" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{-3t}g(t)" :db/ensure [:answer/validate]} {:db/id "q-331788/field-1/c6053dc111147a76a68971390881e47ba8803956e867a4734bc976f20b3a5e23" :answer/id #uuid "ebc64277-6805-5ed2-b0d7-263cf691384a" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{-3t}g(t)" :db/ensure [:answer/validate]} {:db/id "q-331788/field-1/fcbf344b4279b531beecf67eb7a82a7f267658d1a0766664084e35baf58f44e8" :answer/id #uuid "39902c0c-d18c-51fc-adfe-1dbe09bffacb" :answer/type :answer.type/math :answer/value "{e}^{st}\\cdot {e}^{3t}g(t)" :db/ensure [:answer/validate]} {:db/id "q-331788/field-1/dbd843a3ac972b965a0c4cc55dfae6a18f1d1bca9ecee7df302b4bebbc92639e" :answer/id #uuid "4e9f4243-5c23-5174-bfd5-a7c5030684cb" :answer/type :answer.type/math :answer/value "{e}^{-st}\\cdot {e}^{3t}g(t)" :db/ensure [:answer/validate]} {:db/id "q-331788/field-1" :answer-field/id #uuid "bbc07c37-6856-58c4-8d50-4b1b55c1aae5" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-331788/field-1/c6053dc111147a76a68971390881e47ba8803956e867a4734bc976f20b3a5e23" :answer-field/choices ["q-331788/field-1/773edce6b420385ef65fc34f48f4b4b0345a07fec5bb0f2d620ae4b21da718f3" "q-331788/field-