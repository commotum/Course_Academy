[{:db/id "q-331872/selection/9344b232d13e3570298260b6eef1616a2f72f49d2c1cd8d80b516c1b3c5fb7ea" :answer/id #uuid "ba9eed3c-f51f-5899-87a7-2c0ba715c1ea" :answer/type :answer.type/math :answer/value "\\frac{{s}^{2}-9}{((s-4)^{2}+9)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331872/selection/8673608ff5d7e992726a4e569d199338e2e9fc6f067252fcac2589fc883036e9" :answer/id #uuid "55142dcb-7399-596a-8681-57aad06734f9" :answer/type :answer.type/math :answer/value "\\frac{(s-4)^{2}-9}{(s-4)^{2}+9}" :db/ensure [:answer/validate]} {:db/id "q-331872/selection/f8544a69ad2bfacc77333063c8a7380332e969187b5b9af348d174dec282911b" :answer/id #uuid "a517c7ac-6318-57ec-93ba-07ebc1c85402" :answer/type :answer.type/math :answer/value "\\frac{(s-4)^{2}-4}{((s-4)^{2}+9)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331872/selection/3ce33b80f4a62c9845b382050e689edd5258b23379ae41aae15b91ceaac3af66" :answer/id #uuid "6d7a3734-1dc5-5ee5-8061-9ff27cec1438" :answer/type :answer.type/math :answer/value "\\frac{(s-4)^{2}-9}{((s-4)^{2}+9)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331872/selection/a2be662b573a8ef8eaed82d8ba38d04d8a0dece6a76d584eb1d1cef4cbe64caa" :answer/id #uuid "9964f37e-3584-50ea-82d1-f59d51d38a66" :answer/type :answer.type/math :answer/value "\\frac{(s+4)^{2}-9}{((s+4)^{2}+9)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331872/selection" :answer-field/id #uuid "088e17fb-065d-5075-be80-c3df5393a43c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-331872/selection/3ce33b80f4a62c9845b382050e689edd5258b23379ae41aae15b91ceaac3af66" :answer-field/choices ["q-331872/selection/9344b232d13e3570298260b6eef1616a2f72f49d2c1cd8d80b516c1b3c5fb7ea" "q-331872/selection/8673608ff5d7e992726a4e569d199338e2e9fc6f067252fcac2589fc883036e9" "q-331872/selection/f8544a69ad2bfacc77333063c8a7380332e969187b5b9af348d174dec282911b" "q-331872/selection/3ce33b80f4a62c9845b382050e689edd5258b23379ae41aae15b91ceaac3af66" "q-331872/selection/a2be662b573a8ef8eaed82d8ba38d04d8a0dece6a76d584eb1d1cef4cbe64caa"] :db/ensure [:answer-field/validate]} {:db/id "q-331872" :question/id #uuid "e9ec4f95-ebe0-557a-aaf9-41fafa0a7395" :question/math-academy-id "q-331872" :question/problem "Given that  $L{t\\operatorname{cos}⁡(\\omega t)}=\\frac{{s}^{2}-{\\omega }^{2}}{({s}^{2}+{\\omega }^{2})^{2}},$ find the Laplace transform $L{{e}^{4t}\\cdot t\\operatorname{cos}⁡(3t)}.$" :question/worked-solution "The first shifting theorem states that if\n$L{f(t)}=F(s),$\nthen\n$L{{e}^{at}f(t)}=F(s-a).$\n\nUsing the given result, we have\n\n$$\nL{t\\operatorname{cos}⁡(3t)}=\\frac{{s}^{2}-{3}^{2}}{({s}^{2}+{3}^{2})^{2}}.\n$$\n\nTherefore, applying the first shifting theorem, we get\n\n$$\n\\begin{aligned}L{{e}^{4t}\\cdot t\\operatorname{cos}⁡(3t)} & =\\frac{(s-4)^{2}-{3}^{2}}{((s-4)^{2}+{3}^{2})^{2}} \\\\  & =\\frac{(s-4)^{2}-9}{((s-4)^{2}+9)^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-331872/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2a921795-a527-5528-afcb-5881f188a665"] :knowledge-point/questions ["q-331872"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331864/selection/ec935bf054dbb0572d3726a48cf882722a92d75cddaa11f3a7cc5b475049f9db" :answer/id #uuid "18cf9bb1-4d7f-5d59-8136-a44694313771" :answer/type :answer.type/math :answer/value "\\frac{10(s-3)}{(s-3)^{2}+25}" :db/ensure [:answer/validate]} {:db/id "q-331864/selection/a63a774854f9d81811e0aa83bb9d15007106f8bff44202e13a49cf5b18aeb3ed" :answer/id #uuid "26155025-3f76-5904-8001-8ad7513f3762" :answer/type :answer.type/math :answer/value "\\frac{10(s+3)}{((s+3)^{2}+25)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331864/selection/2ef5083094c77bfafe2a4f78e5a519cc711d4a8fd867dd42c169f513d8836210" :answer/id #uuid "65826f02-f646-5e07-8082-27ac9329abec" :answer/type :answer.type/math :answer/value "\\frac{10s}{((s-3)^{2}+25)^{2}}" :db/ensure [:answer/validate]} {:db/id "q-331864/selection/263df8e