cdot e^{2t}f(t)$ {{field-1}} {{field-2}} {{field-3}} {{field-4}}"}] [{:db/id #edb/ref 17592186221984 :knowledge-point/_questions [{:knowledge-point/id #uuid "1dd5c036-7a05-5ca4-aae9-1cf585839ebb" :knowledge-point/title "Applying the First Shifting Theorem and Linearity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "882e2401-4a01-5cf5-bb9c-e138532e0dd3" :answer/type {:db/ident :answer.type/math} :answer/value "(1)/((s + 2)^{2}) + \\frac{2}{s - 2}" :db/id #edb/ref 17592186220893} {:answer/id #uuid "8ec9e882-7755-5220-be1e-3c0532391c1f" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/((s + 2)^{2}) + \\frac{1}{s - 2}" :db/id #edb/ref 17592186220894} {:answer/id #uuid "fb0770f1-3bc7-5faa-8b6b-3608ed791e4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{s + 2} + (2)/((s - 2)^{2})" :db/id #edb/ref 17592186220895} {:answer/id #uuid "04c6f21a-d149-5481-af6e-b6e5e372daf9" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/((s + 2)(s - 2)^{2})" :db/id #edb/ref 17592186220896} {:answer/id #uuid "32921f3f-bac8-5fb3-8878-0d99ce52fc52" :answer/type {:db/ident :answer.type/math} :answer/value "(2)/((s + 2)^{2}(s - 2))" :db/id #edb/ref 17592186220897}] :answer-field/correct {:answer/id #uuid "fb0770f1-3bc7-5faa-8b6b-3608ed791e4d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{s + 2} + (2)/((s - 2)^{2})" :db/id #edb/ref 17592186220895} :answer-field/id #uuid "4f65477f-53b2-50b5-be29-2c18caaf088a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186220892}] :question/id #uuid "94d7e94a-1d17-5470-a293-1353d69fb49f" :question/math-academy-id "q-89592" :question/problem "Given that\n\n$L{t^{n}}|= \\frac{n!}{s^{n + 1}}, \\mid s > 0$,\nuse linearity of Laplace transforms and the first shifting theorem to find the Laplace transform of $f(t) = e^{-2t} + 2te^{2t}$ for $s > 2$."}]}
