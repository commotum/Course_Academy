-2}}\\,d(t)\\,\\text{d}t \\\\  & ={{field-3}}\\,\\text{for}\\,{{field-4}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072996/state.json" "file_sha256" "1a516a99ebdb67ce5af57eb2ee27b6e39e7c23f318e5ad08f9e363fa48dbe171"} {"question" "q-331808" "field" nil "attribute" "question/worked-solution" "value" "Starting from the definition of the Laplace transform, we have\n\n$$\n\\begin{aligned}L{{e}^{-9t}d(t)} & ={\\int }_{0}^{\\infty }{e}^{-st}\\cdot {e}^{-9t}\\,d(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\infty }{e}^{-(s+9)t}\\,d(t)\\,\\text{d}t\\end{aligned}\n$$\n\nNow, recall that $D(s)={\\int }_{0}^{\\infty }{e}^{-st}\\,d(t)\\,\\text{d}t,$ where $s>{s}_{0}.$ Therefore, \n\n$$\n{\\int }_{0}^{\\infty }{e}^{-(s+9)t}\\,d(t)\\,\\text{d}t=D(s+9),\n$$\n\nwhere \n\n$$\ns+9>{s}_{0}\\,⇒\\,s>{s}_{0}-9.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072996/state.json" "file_sha256" "1a516a99ebdb67ce5af57eb2ee27b6e39e7c23f318e5ad08f9e363fa48dbe171"} {"question" "q-331808" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072996/activity-metadata.json" "file_sha256" "5a00194a376d3e0a6746015e9008f5e5e35581856d7f79571d604fe69cef85a7"} {"question" "q-331808" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072996/state.json" "file_sha256" "1a516a99ebdb67ce5af57eb2ee27b6e39e7c23f318e5ad08f9e363fa48dbe171"} {"question" "q-331808" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "{e}^{-st}\\cdot {e}^{-9t}d(t)"] ["math" "{e}^{-st}\\cdot {e}^{9t}d(t)"] ["math" "{e}