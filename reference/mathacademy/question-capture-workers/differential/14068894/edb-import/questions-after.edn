nswer/id #uuid "59f24e93-2bc9-53f1-8cea-df07958a70a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{sin}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x" :db/id #edb/ref 17592186358690} {:answer/id #uuid "51b0aed7-9409-5ff6-b6c2-351866da87be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(x)\\operatorname{cos}⁡(\\frac{2L}{\\pi }x)\\,\\text{d}x" :db/id #edb/ref 17592186358691} {:answer/id #uuid "bcf972bb-6f1d-5dec-8aad-096a4b5411a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x" :db/id #edb/ref 17592186358692} {:answer/id #uuid "f2c4a8ec-cb67-5e9d-b9ed-dab5ad1b3a30" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x" :db/id #edb/ref 17592186358693} {:answer/id #uuid "535e48be-9d35-5efd-a99a-e0d4ee5fbfea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x" :db/id #edb/ref 17592186358694}] :answer-field/correct {:answer/id #uuid "535e48be-9d35-5efd-a99a-e0d4ee5fbfea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x" :db/id #edb/ref 17592186358694} :answer-field/id #uuid "55337d3d-3db3-5d87-9dec-a8e14be99f1a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186358688} {:answer-field/choices [{:answer/id #uuid "8b4d64da-4f63-595d-b4f2-e1add92d5648" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3\\pi }" :db/id #edb/ref 17592186358696} {:answer/id #uuid "6b45d193-93d6-563e-a88a-44f50ac82c43" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{\\pi }" :db/id #edb/ref 17592186358697} {:answer/id #uuid "92ee347c-8215-5612-bbfd-cd5e87e6fd6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\pi }" :db/id #edb/ref 17592186358698} {:answer/id #uuid "a4d9a61c-a4ff-54de-b50f-690bc75fab7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186358699}] :answer-field/correct {:answer/id #uuid "a4d9a61c-a4ff-54de-b50f-690bc75fab7a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186358699} :answer-field/id #uuid "6cd4b5b5-4350-528b-a0f3-9fe10442c88d" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186358695} {:answer-field/choices [{:answer/id #uuid "83cf184d-0084-52d6-b184-01f8c3a9a4aa" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\operatorname{ln}⁡({x}^{2}+1)\\,\\text{d}x" :db/id #edb/ref 17592186358701} {:answer/id #uuid "0b9c0cec-93c8-5f2b-8da2-132cb07327de" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x" :db/id #edb/ref 17592186358702} {:answer/id #uuid "4d3facb7-e694-581d-a88d-d86c57e5cd68" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186358703} {:answer/id #uuid "622562c5-4c09-5a6b-ab68-268284bbf7d2" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{sin}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x" :db/id #edb/ref 17592186358704} {:answer/id #uuid "5f148406-a7ce-5288-8f5a-fecd5e4fd70f" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-\\pi }^{\\pi }\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡(2x)\\,\\text{d}x" :db/id #edb/ref 17592186358705} {:answer/id #uuid "7d43926c-e191-50da-9b1b-0f890729ea20" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\,\\text{d}x" :db/id #edb/ref 17592186358706}] :answer-field/correct {:answer/id #uuid "0b9c0cec-93c8-5f2b-8da2-132cb07327de" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x" :db/id #edb/ref 17592186358702} :answer-field/id #uuid "5507a2dd-0553-5876-bbfb-f9f556ece7cf" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186358700}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3355d1ae-2d93-5185-9973-5c15cb5e2fb5" :question/math-academy-id "q-341776" :question/problem "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in [-L,L)$ to $x\\in R.$\nSelect the correct options in the reasoning below.The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡({{field-1}})+{b}_{n}\\operatorname{sin}⁡({{field-2}}).\n$$\n\nThe $2$nd cosine coefficient of the series is\n\n$$\n{a}_{2}={{field-3}}.\n$$\n\nGiven that $F(x)=\\operatorname{ln}⁡({x}^{2}+1)$ and $L=3,$ the $2$nd cosine coefficient becomes\n\n$$\n{a}_{2}={{field-4}}\\,\\cdot \\,{{field-5}}.\n$$" :question/worked-solution "Recall that multiplying the argument of a function by $k\\ne 0$ represents the horizontal stretching of the corresponding graph by a factor of $\\frac{1}{k}.$\n\nNow, let $s=\\frac{\\pi }{L}x.$ Then, since $f(x)$ has a period of $2L,$ the function\n\n$$\ng(s)=f(\\frac{L}{\\pi }s)\n$$\n\nmust have a period of $2L\\cdot \\frac{\\pi }{L}=2\\pi .$ \n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(ns)+{b}_{n}\\operatorname{sin}⁡(ns),\n$$\n\nwhere:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,\\text{d}s \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,\\text{d}s,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,\\text{d}s,\\,n\\ge 1\\end{aligned}\n$$\n\nSubstituting $s=\\frac{\\pi }{L}x$ and using the fact that $g(s)=f(\\frac{L}{\\pi }s),$ we get the Fourier series of $f(x):$\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\n$$\n\nTherefore, $2$nd cosine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(2s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(2s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, substituting $L=3$ and $f(x)=F(x)=\\operatorname{ln}⁡({x}^{2}+1),$ we get\n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{3}\\cdot {\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358707 :knowledge-point/_questions [{:knowledge-point/id #uuid "12ff3452-19b6-566a-8b39-ad880dee8858" :knowledge-point/title "Identifying Effects of the Horizontal Scaling on Coefficients"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1de66953-b600-5a0e-9aa2-c440fd42ab4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{n\\pi }{L}x" :db/id #edb/ref 17592186358709} {:answer/id #uuid "d75b8e01-3caf-5bc8-acba-7555ce7fd456" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{L}{n\\pi }x" :db/id #edb/ref 17592186358710} {:answer/