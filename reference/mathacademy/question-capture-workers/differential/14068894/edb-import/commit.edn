rname{cos}⁡(\\frac{4}{3}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+1\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{4}{3}x)\\, & ⇒\\,v=\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }(uv\\,{|}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}{[(-3x+1)\\operatorname{sin}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\cdot (-3)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}[(-9\\pi +1)\\operatorname{sin}⁡(4\\pi )-(9\\pi +1)\\operatorname{sin}⁡(-4\\pi )]+\\frac{9}{4}{\\int }_{-3\\pi }^{3\\pi }\\operatorname{sin}⁡(\\frac{4}{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(\\frac{1}{4}\\cdot 0+\\frac{9}{4}\\cdot (-\\frac{3}{4}){[\\operatorname{cos}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }) \\\\  & =\\frac{1}{\\pi }(-\\frac{27}{16}[\\operatorname{cos}⁡(4\\pi )-\\operatorname{cos}⁡(-4\\pi )]) \\\\  & =-\\frac{27}{16\\pi }(1-1) \\\\  & =0.\\end{aligned}\n$$" 13194139535637 true] [17592186358759 1000 #edb/ref 17592186358760 13194139535637 true] [17592186358759 1040 #edb/ref 17592186045449 13194139535637 true] [17592186358759 1041 "field-1" 13194139535637 true] [17592186358759 1104 #edb/ref 17592186358760 13194139535637 true] [17592186358759 1110 #uuid "21cb079f-1ca9-5a38-a096-629c59cbc630" 13194139535637 true] [17592186358760 1034 "0" 13194139535637 true] [17592186358760 1103 #edb/ref 17592186045453 13194139535637 true] [17592186358760 1111 #uuid "eedaeddd-6b47-5a81-b337-f258907ec804" 13194139535637 true] [17592186358761 1017 #edb/ref 17592186358762 13194139535637 true] [17592186358761 1089 "q-353155" 13194139535637 true] [17592186358761 1091 #edb/ref 17592186045465 13194139535637 true] [17592186358761 1100 "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n