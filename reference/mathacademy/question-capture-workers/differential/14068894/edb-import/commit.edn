,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(-{[5x\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}+5{\\int }_{-2}^{2}\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(-(5(2)\\operatorname{cos}⁡(3\\pi )-5(-2)\\operatorname{cos}⁡(-3\\pi ))+\\frac{10}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}) \\\\  & =\\frac{1}{3\\pi }(20+\\frac{10}{3\\pi }(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(-3\\pi ))) \\\\  & =\\frac{1}{3\\pi }\\cdot 20 \\\\  & =\\frac{20}{3\\pi }.\\end{aligned}\n$$" 13194139535637 true] [17592186358765 1000 #edb/ref 17592186358766 13194139535637 true] [17592186358765 1000 #edb/ref 17592186358767 13194139535637 true] [17592186358765 1040 #edb/ref 17592186045449 13194139535637 true] [17592186358765 1041 "field-1" 13194139535637 true] [17592186358765 1104 #edb/ref 17592186358766 13194139535637 true] [17592186358765 1110 #uuid "a3882c2c-8495-56ac-8725-f3eab45d5fcb" 13194139535637 true] [17592186358766 1034 "\\frac{20}{3\\pi}" 13194139535637 true] [17592186358766 1103 #edb/ref 17592186045453 13194139535637 true] [17592186358766 1111 #uuid "b301d5b4-067a-5578-97c8-1e2a6083ab26" 13194139535637 true] [17592186358767 1034 "-\\frac{20}{3\\pi}" 13194139535637 true] [17592186358767 1103 #edb/ref 17592186045453 13194139535637 true] [17592186358767 1111 #uuid "aaf83b85-c963-5d12-bc99-24536e0f2081" 13194139535637 true]] :edb/tempids {"q-341776" 17592186358677 "q-341776/field-1" 17592186358678 "q-341776/field-1/7784087e23165dffd3b112724e1fa7fce6fac80abd850f7d34d288aa280953a5" 17592186358679 "q-341776/field-1/a92f7ee75851e2263770df8a12763f4813f0228b01859171856ea4c0d4aa61e9" 17592186358680 "q-341776/field-1/a9c0a8e81790f09d250b5e610fd76b20a1c9ad6330f91e2ef47914439c6eaaed" 17592186358681 "q-341776/field-1/cdec8cc80924fdc54544a538540660c85f7b1a62e92a417e4a5e6cfb2daee4b1" 17592186358682 "q-341776/field-2" 17592186358683 "q-341776/field-2/7784087e23165dffd3b112724e1fa7fce6fac80abd850f7d34d288aa280953a5" 17592186358684 "q-341