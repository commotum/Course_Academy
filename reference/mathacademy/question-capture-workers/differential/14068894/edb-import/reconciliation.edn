88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341776" "field" "field-5" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x"] "category" "ma_explicit_answer" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341789" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x)\n$$\n\nLet $F(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ The Fourier series of the $2$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341789" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=1$ and $f(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{1}{\\int }_{-1}^{1}(6{x}^{2}+5x+1)\\,\\text{d}x \\\\  & ={[2{x}^{3}+\\frac{5}{2}{x}^{2}+x]}_{-1}^{1} \\\\  & =(2+\\frac{5}{2}+1)-((-2)+\\frac{5}{2}+(-1)) \\\\  & =\\frac{11}{2}-(-\\frac{1}{2}) \\\\  & =6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341789" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-341789" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341789" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341805" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{8}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{8}x)\n$$\n\nLet $F(x)=-x+5$ for $x\\in [-8,8).$ The Fourier series of the $16$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341805" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=8$ and $f(x)=-x+5$ for $x\\in [-8,8).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{8}{\\int }_{-8}^{8}(-x+5)\\,\\text{d}x \\\\  & =\\frac{1}{8}{[-\\frac{1}{2}{x}^{2}+5x]}_{-8}^{8} \\\\  & =\\frac{1}{8}((-\\frac{1}{2}\\cdot {8}^{2}+5\\cdot 8)-(-\\frac{1}{2}\\cdot (-8)^{2}+5\\cdot (-8))) \\\\  & =\\frac{1}{8}(8-(-72)) \\\\  & =10.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341805" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-341805" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341805" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341791" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{5}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{5}x)\n$$\n\nLet $F(x)=3{x}^{2}-4$ for $x\\in [-5,5).$ The Fourier series of the $10$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341791" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=5$ and $f(x)=3{x}^{2}-4$ for $x\\in [-5,5).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{5}{\\int }_{-5}^{5}(3{x}^{2}-4)\\,\\text{d}x \\\\  & =\\frac{1}{5}{[{x}^{3}-4x]}_{-5}^{5} \\\\  & =\\frac{1}{5}(({5}^{3}-4\\cdot 5)-((-5)^{3}-4\\cdot (-5))) \\\\  & =\\frac{1}{5}(105-(-105)) \\\\  & =42.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341791" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-341791" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341791" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "42"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341793" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{7}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{7}x)\n$$\n\nLet $F(x)=3{x}^{2}-1$ for $x\\in [-7,7).$ The Fourier series of the $14$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341793" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=7$ and $f(x)=3{x}^{2}-1$ for $x\\in [-7,7).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{7}{\\int }_{-7}^{7}(3{x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{7}{[{x}^{3}-x]}_{-7}^{7} \\\\  & =\\frac{1}{7}(({7}^{3}-7)-((-7)^{3}-(-7))) \\\\  & =\\frac{1}{7}(336-(-336)) \\\\  & =96.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341793" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-341793" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341793" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "96"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341790" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{4}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{4}x)\n$$\n\nLet $F(x)=3{x}^{2}-2x$ for $x\\in [-4,4).$ The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341790" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=4$ and $f(x)=3{x}^{2}-2x$ for $x\\in [-4,4).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{4}{\\int }_{-4}^{4}(3{x}^{2}-2x)\\,\\text{d}x \\\\  & =\\frac{1}{4}{[{x}^{3}-{x}^{2}]}_{-4}^{4} \\\\  & =\\frac{1}{4}(({4}^{3}-{4}^{2})-((-4)^{3}-(-4)^{2})) \\\\  & =\\frac{1}{4}(48-(-80)) \\\\  & =32.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341790" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-341790" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341790" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "32"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341870" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n}{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n}{3}x)\n$$\n\nLet $F(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ The Fourier series of the $6\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{4}.$\n\n${a}_{4}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341870" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3\\pi $ and $f(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4\\pi }{3\\pi }x)\\,\\text{d}x \\\\  & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4}{3}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+1\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{4}{3}x)\\, & ⇒\\,v=\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }(uv\\,{|}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}{[(-3x+1)\\operatorname{sin}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\cdot (-3)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}[(-9\\pi +1)\\operatorname{sin}⁡(4\\pi )-(9\\pi +1)\\operatorname{sin}⁡(-4\\pi )]+\\frac{9}{4}{\\int }_{-3\\pi }^{3\\pi }\\operatorname{sin}⁡(\\frac{4}{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(\\frac{1}{4}\\cdot 0+\\frac{9}{4}\\cdot (-\\frac{3}{4}){[\\operatorname{cos}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }) \\\\  & =\\frac{1}{\\pi }(-\\frac{27}{16}[\\operatorname{cos}⁡(4\\pi )-\\operatorname{cos}⁡(-4\\pi )]) \\\\  & =-\\frac{27}{16\\pi }(1-1) \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341870" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-341870" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341870" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341833" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{4}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{4}x)\n$$\n\nLet $F(x)=-5x+2$ for $x\\in [-4,4).$ The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{3}.$\n\n${b}_{3}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341833" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=4$ and $f(x)=-5x+2$ for $x\\in [-4,4).$ So, substituting into the formula, we get\n\n$$\n{b}_{3}=\\frac{1}{4}{\\int }_{-4}^{4}(-5x+2)\\operatorname{sin}⁡(\\frac{3\\pi }{4}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-5x+2\\, & ⇒\\,{u}^{′}=-5 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{3\\pi }{4}x)\\, & ⇒\\,v=-\\frac{4}{3\\pi }\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{3} & =\\frac{1}{4}(uv\\,{|}_{-4}^{4}-{\\int }_{-4}^{4}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }{[(-5x+2)\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)]}_{-4}^{4}-{\\int }_{-4}^{4}(-\\frac{4}{3\\pi }\\operatorname{cos}⁡(\\frac{3\\pi }{4}x))(-5)\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }{[(-5x+2)\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)]}_{-4}^{4}-\\frac{20}{3\\pi }{\\int }_{-4}^{4}\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }((-18)(-1)-(22)(-1))-\\frac{80}{9{\\pi }^{2}}(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(-3\\pi ))) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }\\cdot 40) \\\\  & =-\\frac{40}{3\\pi }.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341833" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-341833" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-341833" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{40}{3\\pi}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353155" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{4}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{4}x)\n$$\n\nLet $F(x)=3x$ for $x\\in [-4,4).$ The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{5}.$\n\n${b}_{5}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353155" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=4$ and $f(x)=3x$ for $x\\in (-4,4).$ So, substituting into the formula, we get\n\n$$\n{b}_{5}=\\frac{1}{4}{\\int }_{-4}^{4}3x\\operatorname{sin}⁡(\\frac{5\\pi }{4}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=3x\\, & ⇒\\,{u}^{′}=3 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{5\\pi }{4}x)\\, & ⇒\\,v=-\\frac{4}{5\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{5} & =\\frac{1}{4}(uv\\,{|}_{-4}^{4}-{\\int }_{-4}^{4}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{5\\pi }{[3x\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)]}_{-4}^{4}+\\frac{12}{5\\pi }{\\int }_{-4}^{4}\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-{[3x\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)]}_{-4}^{4}+3{\\int }_{-4}^{4}\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-((3(4))\\operatorname{cos}⁡(5\\pi )-(3(-4))\\operatorname{cos}⁡(-5\\pi ))+\\frac{12}{5\\pi }{[\\operatorname{sin}⁡(\\frac{5\\pi }{4}x)]}_{-4}^{4}) \\\\  & =\\frac{1}{5\\pi }(24+\\frac{12}{5\\pi }(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(-5\\pi ))) \\\\  & =\\frac{1}{5\\pi }\\cdot 24 \\\\  & =\\frac{24}{5\\pi }.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353155" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-353155" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353155" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{24}{5\\pi}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353158" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nLet $F(x)=5x$ for $x\\in [-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{3}.$\n\n${b}_{3}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353158" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=5x$ for $x\\in (-2,2).$ So, substituting into the formula, we get\n\n$$\n{b}_{3}=\\frac{1}{2}{\\int }_{-2}^{2}(5x)\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=5x\\, & ⇒\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\, & ⇒\\,v=-\\frac{2}{3\\pi }\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{3} & =\\frac{1}{2}(uv\\,{|}_{-2}^{2}-{\\int }_{-2}^{2}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{2}(-\\frac{2}{3\\pi }{[5x\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}+\\frac{10}{3\\pi }{\\int }_{-2}^{2}\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(-{[5x\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}+5{\\int }_{-2}^{2}\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(-(5(2)\\operatorname{cos}⁡(3\\pi )-5(-2)\\operatorname{cos}⁡(-3\\pi ))+\\frac{10}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}) \\\\  & =\\frac{1}{3\\pi }(20+\\frac{10}{3\\pi }(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(-3\\pi ))) \\\\  & =\\frac{1}{3\\pi }\\cdot 20 \\\\  & =\\frac{20}{3\\pi }.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353158" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-353158" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-353158" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{20}{3\\pi}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-340873" "field" nil "attribute" "question/problem" "value" "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nThe Fourier series of the $4$-periodic extension $f(x)$ of the function \n\n$$\nF(x)={\\begin{aligned}2, & x\\in [0,2) \\\\ -1, & x\\in [-2,0)\\end{aligned}\n$$\n\nis shown above. Find the exact value of ${a}_{3}.$\n\n${a}_{3}=$ {{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-340873" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2.$ Also, $f(x)=2$ for $x\\in (0,2)$ and $f(x)=-1$ for $x\\in (-2,0).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{1}{2}{\\int }_{-2}^{2}f(x)\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{0}(-1)\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x+\\frac{1}{2}{\\int }_{0}^{2}2\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x \\\\  & =-\\frac{1}{2}\\cdot \\frac{2}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{0}+\\frac{2}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{0}^{2} \\\\  & =-\\frac{1}{3\\pi }(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-3\\pi ))+\\frac{2}{3\\pi }(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-340873" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/activity-metadata.json" "file_sha256" "97188c44f046ac47f2aeb0650ca4600bc4d2cf9acb58726e1d9f6aefb27d50e6"} {"question" "q-340873" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "q-340873" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/state.json" "file_sha256" "f3f5cb88e443f7d38ccc5568609fdc38a8a921ea01a96d136d5bb4c57e704bcf"} {"question" "e-21835" "field" nil "attribute" "question/problem" "value" "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in [-L,L)$ to $x \\in \\mathbb R.$ \nGiven that $L=2$ and $f(x) = \\cosh{(x+1)}$, find the $4$th cosine and the $4$th sine coefficients." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/example-21835.json" "file_sha256" "56ae8612f9c7df61120048ce86ad902b9e0564e6977f8b549fb404581be5b281"} {"question" "e-21835" "field" nil "attribute" "question/worked-solution" "value" "Recall that multiplying the argument of a function by $k \\neq 0$ represents the horizontal stretching of the corresponding graph by a factor of $\\dfrac{1}{k}.$\n\nNow, let $s=\\dfrac{\\pi}{L}x.$ Then, since $f(x)$ has a period of $2L,$ the function\n\n$$\ng(s) = f\\left(\\dfrac{L}{\\pi}s\\right)\n$$\n\nmust have a period of $2L \\cdot \\dfrac{\\pi}{L} = 2\\pi.$ \n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos(ns)+b_n\\sin(ns),\n$$\n\nwhere:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,\\text{d}s \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,\\text{d}s,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,\\text{d}s,\\,n\\ge 1\\end{aligned}\n$$\n\nSubstituting $s=\\dfrac{\\pi}{L}x$ and using the fact that $g(s) = f\\left(\\dfrac{L}{\\pi}s\\right),$ we get the Fourier series of $f(x){:}$\n\n$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}\na_n\\cos\\bigg(\\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{n\\pi}{L}x}\\bigg)+\nb_n\\sin\\bigg(\\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{n\\pi}{L}x}\\bigg)\n$$\n\nTherefore, $4$th cosine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNext, $4$th sine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{b}_{4} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{sin}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, substituting $L=2$ and $f(x)=\\cosh(x+1),$ we get\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{cos}⁡(\\frac{4\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{cos}⁡(2\\pi x)\\,\\text{d}x, \\\\ {b}_{4} & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{sin}⁡(\\frac{4\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{sin}⁡(2\\pi x)\\,\\text{d}x.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/example-21835.json" "file_sha256" "56ae8612f9c7df61120048ce86ad902b9e0564e6977f8b549fb404581be5b281"} {"question" "e-21836" "field" nil "attribute" "question/problem" "value" "$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos\\left(\\dfrac{n\\pi}{2}x\\right)+b_n\\sin\\left(\\dfrac{n\\pi}{2}x\\right)\n$$\n\nLet $F(x)=3x^2-4x+1$ for $x\\in[-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of $a_0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/example-21836.json" "file_sha256" "68cb79ada7fdb93f7288a65635bc25b3f4ca85ab83057e609828827ba1d65612"} {"question" "e-21836" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\na_0=\\frac{1}{L}\\int_{-L}^{L} f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=3x^2-4x+1$ for $x \\in [-2,2).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{2}{\\int }_{-2}^{2}(3{x}^{2}-4x+1)\\,\\text{d}x \\\\  & =\\frac{1}{2}{[{x}^{3}-2{x}^{2}+x]}_{-2}^{2} \\\\  & =\\frac{1}{2}(({2}^{3}-2\\cdot {2}^{2}+2)-((-2)^{3}-2\\cdot (-2)^{2}+(-2))) \\\\  & =\\frac{1}{2}(2-(-18)) \\\\  & =10.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/example-21836.json" "file_sha256" "68cb79ada7fdb93f7288a65635bc25b3f4ca85ab83057e609828827ba1d65612"} {"question" "e-21837" "field" nil "attribute" "question/problem" "value" "$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos\\left(\\dfrac{n\\pi}{2}x\\right)+b_n\\sin\\left(\\dfrac{n\\pi}{2}x\\right)\n$$\n\nLet $F(x)=-5x+4$ for $x\\in[-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of $a_3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/example-21837.json" "file_sha256" "eb3b505519fc502f8fbca687f0fd8387706732d26b32f5048af16b94613a5552"} {"question" "e-21837" "field" nil "attribute" "question/worked-solution" "value" "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\na_n=\\frac{1}{L}\\int_{-L}^{L} f(x)\\cos\\left(\\dfrac{n\\pi}{L}x\\right)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=-5x+4$ for $x \\in [-2,2).$ So, substituting into the formula, we get\n\n$$\na_3 = \\dfrac{1}{2}\\int_{-2}^{2} (-5x+4)\\cos\\left(\\dfrac{3\\pi}{2}x\\right)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-5x+4\\, & ⇒\\,{u}^{′}=-5 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\, & ⇒\\,v=\\frac{2}{3\\pi }\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{1}{2}(uv\\,{|}_{-2}^{2}-{\\int }_{-2}^{2}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{2}{3\\pi }{[(-5x+4)\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}-{\\int }_{-2}^{2}\\frac{2}{3\\pi }\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\cdot (-5)\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{2}{3\\pi }[(-5(2)+4)\\operatorname{sin}⁡(3\\pi )-(-5(-2)+4)\\operatorname{sin}⁡(-3\\pi )]+\\frac{10}{3\\pi }{\\int }_{-2}^{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{2}{3\\pi }\\cdot 0+\\frac{10}{3\\pi }\\cdot (-\\frac{2}{3\\pi }){[\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}) \\\\  & =\\frac{1}{2}(-\\frac{20}{9{\\pi }^{2}}[\\operatorname{cos}⁡(3\\pi )-\\operatorname{cos}⁡(-3\\pi )]) \\\\  & =-\\frac{10}{9{\\pi }^{2}}(-1-(-1)) \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068894/example-21837.json" "file_sha256" "eb3b505519fc502f8fbca687f0fd8387706732d26b32f5048af16b94613a5552"}] "usage" {"e-21837" [] "e-21836" [] "e-21835" [] "q-340873" []} "basis" 2324 "retractions" [[17592186221960 :question/problem "$f(x)∼\\frac{a_{0}}{2} + ∑_(n = 1)^(∞)a_{n}\\cos (\\frac{nπ}{2}x) + b_{n}\\sin (\\frac{nπ}{2}x)$\nThe Fourier series of the $4$-periodic extension $f(x)$ of the function\n$[MATH: F(x) = {2, \\mid x ∈ [0, 2); - 1, \\mid x ∈ [- 2, 0)]$\nis shown above. Find the exact value of $a_{3}$.$a_{3} =$ {{field-1}}"] [17592186221137 :question/problem "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $[MATH: x\\in [-L,L)]$ to $x \\in \\mathbb R$.\nGiven that $L=2$ and $f(x) = \\cosh{(x+1)}$, find the $4$th cosine and the $4$th sine coefficients."] [17592186221137 :question/worked-solution "Recall that multiplying the argument of a function by\n\n$$\nk \\neq 0\n$$\n\nrepresents the horizontal stretching of the corresponding graph by a factor of\n\n$$\n\\dfrac{1}{k}\n$$\n\nNow, let\n\n$$\ns=\\dfrac{\\pi}{L}x\n$$\n\nThen, since $f(x)$ has a period of $2L$, the function\n\n$$\ng(s) = f\\left(\\dfrac{L}{\\pi}s\\right)\n$$\n\nmust have a period of\n\n$$\n2L \\cdot \\dfrac{\\pi}{L} = 2\\pi\n$$\n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos(ns)+b_n\\sin(ns)\n$$\n\nwhere:\n\n$$\n\\begin{aligned}\na_{0} &= \\frac{1}{π}\\int_{- π}^{π}g(s)ds \\\\\na_{n} &= \\frac{1}{π}\\int_{- π}^{π}g(s)\\cos (ns)ds, n \\ge 1 \\\\\nb_{n} &= \\frac{1}{π}\\int_{- π}^{π}g(s)\\sin (ns)ds, n \\ge 1\n\\end{aligned}\n$$\n\nSubstituting\n\n$$\ns=\\dfrac{\\pi}{L}x\n$$\n\nand using the fact that\n\n$$\ng(s) = f\\left(\\dfrac{L}{\\pi}s\\right)\n$$\n\nwe get the Fourier series of $f(x){:}$\n\n$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty} a_n\\cos\\bigg(\\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{n\\pi}{L}x}\\bigg)+ b_n\\sin\\bigg(\\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{n\\pi}{L}x}\\bigg)\n$$\n\nTherefore, $4$th cosine coefficient of $f(x)$ is\n\n$$\n\\begin{aligned}\na_{4} &= \\frac{1}{π}\\int_{- π}^{π}g(s)\\cos (4s)ds \\\\\n&= \\frac{1}{π}\\int_{- π}^{π}f(\\frac{L}{π}s)\\cos (4s)ds \\\\\n&= \\frac{1}{π}\\int_{-L}^{L}f(\\frac{L}{π} \\cdot \\frac{π}{L}x)\\cos (4 \\cdot \\frac{π}{L}x)d(\\frac{π}{L}x) \\\\\n&= \\frac{1}{π} \\cdot \\frac{π}{L}\\int_{-L}^{L}f(x)\\cos (\\frac{4π}{L}x)dx \\\\\n&= \\frac{1}{L}\\int_{-L}^{L}f(x)\\cos (\\frac{4π}{L}x)dx\n\\end{aligned}\n$$\n\nNext, $4$th sine coefficient of $f(x)$ is\n\n$$\n\\begin{aligned}\nb_{4} &= \\frac{1}{π}\\int_{- π}^{π}g(s)\\sin (4s)ds \\\\\n&= \\frac{1}{π}\\int_{- π}^{π}f(\\frac{L}{π}s)\\sin (4s)ds \\\\\n&= \\frac{1}{π}\\int_{-L}^{L}f(\\frac{L}{π} \\cdot \\frac{π}{L}x)\\sin (4 \\cdot \\frac{π}{L}x)d(\\frac{π}{L}x) \\\\\n&= \\frac{1}{π} \\cdot \\frac{π}{L}\\int_{-L}^{L}f(x)\\sin (\\frac{4π}{L}x)dx \\\\\n&= \\frac{1}{L}\\int_{-L}^{L}f(x)\\sin (\\frac{4π}{L}x)dx\n\\end{aligned}\n$$\n\nFinally, substituting $L=2$ and\n\n$$\nf(x)=\\cosh(x+1)\n$$\n\nwe get\n\n$$\n\\begin{aligned}\na_{4} &= \\frac{1}{2}\\int_{-2}^{2}\\cosh (x + 1)\\cos (\\frac{4π}{2}x)dx \\\\\n&= \\frac{1}{2}\\int_{-2}^{2}\\cosh (x + 1)\\cos (2πx)dx, \\\\\nb_{4} &= \\frac{1}{2}\\int_{-2}^{2}\\cosh (x + 1)\\sin (\\frac{4π}{2}x)dx \\\\\n&= \\frac{1}{2}\\int_{-2}^{2}\\cosh (x + 1)\\sin (2πx)dx\n\\end{aligned}\n$$"] [17592186221138 :question/problem "$f(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos\\left(\\dfrac{n\\pi}{2}x\\right)+b_n\\sin\\left(\\dfrac{n\\pi}{2}x\\right)$\nLet $F(x)=3x^2-4x+1$ for $[MATH: x\\in[-2,2).]$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of $a_0$."] [17592186221138 :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\na_0=\\frac{1}{L}\\int_{-L}^{L} f(x)\\,\\text{d}x\n$$\n\nIn our case, $L=2$ and\n\n$$\nf(x)=3x^2-4x+1\n$$\n\nfor $[MATH: x \\in [-2,2).]$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}\na_{0} &= \\frac{1}{2}\\int_{-2}^{2}(3x^{2} - 4x + 1)dx \\\\\n&= \\frac{1}{2}[x^{3} - 2x^{2} + x]_{-2}^{2} \\\\\n&= \\frac{1}{2}((2^{3} - 2 \\cdot 2^{2} + 2) - ((-2)^{3} - 2 \\cdot (-2)^{2} + (-2))) \\\\\n&= \\frac{1}{2}(2 - (-18)) \\\\\n&= 10\n\\end{aligned}\n$$"] [17592186221139 :question/problem "$f(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos\\left(\\dfrac{n\\pi}{2}x\\right)+b_n\\sin\\left(\\dfrac{n\\pi}{2}x\\right)$\nLet $F(x)=-5x+4$ for $[MATH: x\\in[-2,2).]$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of $a_3$."] [17592186221139 :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\na_n=\\frac{1}{L}\\int_{-L}^{L} f(x)\\cos\\left(\\dfrac{n\\pi}{L}x\\right)\\,\\text{d}x\n$$\n\nIn our case, $L=2$ and\n\n$$\nf(x)=-5x+4\n$$\n\nfor $[MATH: x \\in [-2,2).]$ So, substituting into the formula, we get\n\n$$\na_3 = \\dfrac{1}{2}\\int_{-2}^{2} (-5x+4)\\cos\\left(\\dfrac{3\\pi}{2}x\\right)\\,\\text{d}x\n$$\n\nWe use the integration by parts:\n\n$$\n\\begin{bmatrix}u =-5x + 4 & ⇒u^{′} =-5 \\\\ v^{′} = \\cos (\\frac{3π}{2}x) & ⇒v = \\frac{2}{3π}\\sin (\\frac{3π}{2}x)\\end{bmatrix}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}\na_{3} &= \\left.\\frac{1}{2}(uv\\right|_{-2}^{2} - \\int_{-2}^{2}vu^{′}dx) \\\\\n&= \\frac{1}{2}(\\frac{2}{3π}[(-5x + 4)\\sin (\\frac{3π}{2}x)]_{-2}^{2} - \\int_{-2}^{2}\\frac{2}{3π}\\sin (\\frac{3π}{2}x) \\cdot (-5)dx) \\\\\n&= \\frac{1}{2}(\\frac{2}{3π}[(-5(2) + 4)\\sin (3π) - (-5(-2) + 4)\\sin (-3π)] + \\frac{10}{3π}\\int_{-2}^{2}\\sin (\\frac{3π}{2}x)dx) \\\\\n&= \\frac{1}{2}(\\frac{2}{3π} \\cdot 0 + \\frac{10}{3π} \\cdot (-\\frac{2}{3π})[\\cos (\\frac{3π}{2}x)]_{-2}^{2}) \\\\\n&= \\frac{1}{2}(-\\frac{20}{9π^{2}}[\\cos (3π) - \\cos (-3π)]) \\\\\n&=-\\frac{10}{9π^{2}}(-1 - (-1)) \\\\\n&= 0\n\\end{aligned}\n$$"]] "immutable_answers" [17592186232897] "immutable_fields" [[17592186220737 :answer-field/correct] [17592186220737 :answer-field/id] [17592186220737 :answer-field/key] [17592186220737 :answer-field/type]] "no_history" []}
