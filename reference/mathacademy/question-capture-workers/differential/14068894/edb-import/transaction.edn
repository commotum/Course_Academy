x}^{2}+1)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-341776/field-5/94eb0e8c2aa8be80a799f035bff28dd196164f1c493a8c4154c50e631db2fb61" :answer/id #uuid "4d3facb7-e694-581d-a88d-d86c57e5cd68" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{\\pi }\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{sin}⁡(2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-341776/field-5/ae86e2cf99e503ba8bc88dec323e96786bae049316b79ae14f873923af6eced3" :answer/id #uuid "622562c5-4c09-5a6b-ab68-268284bbf7d2" :answer/type :answer.type/math :answer/value "{\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{sin}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-341776/field-5" :answer-field/id #uuid "5507a2dd-0553-5876-bbfb-f9f556ece7cf" :answer-field/key "field-5" :answer-field/type :answer-field.type/select :answer-field/correct "q-341776/field-5/87fb4187993e60f836ff7021f6822689fca4473a8afcf804eb0cd780f53b9d3b" :answer-field/choices ["q-341776/field-5/c9b7030c660e889e34b596669b5a5d8c65d5d66949ad6830f9936b7ce1c3e1e5" "q-341776/field-5/810d093a17c24bec207d2bb18d24506cbcd13ca93e929623ac3e94fb5fdd04c5" "q-341776/field-5/87fb4187993e60f836ff7021f6822689fca4473a8afcf804eb0cd780f53b9d3b" "q-341776/field-5/eef2785db8c57c11f0c096e6f2049b6db994dc0faade236d7a90c06462b37b16" "q-341776/field-5/94eb0e8c2aa8be80a799f035bff28dd196164f1c493a8c4154c50e631db2fb61" "q-341776/field-5/ae86e2cf99e503ba8bc88dec323e96786bae049316b79ae14f873923af6eced3"] :db/ensure [:answer-field/validate]} {:db/id "q-341776" :question/id #uuid "3355d1ae-2d93-5185-9973-5c15cb5e2fb5" :question/math-academy-id "q-341776" :question/problem "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in [-L,L)$ to $x\\in R.$\nSelect the correct options in the reasoning below.The Fourier series of $f$ is given by\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡({{field-1}})+{b}_{n}\\operatorname{sin}⁡({{field-2}}).\n$$\n\nThe $2$nd cosine coefficient of the series is\n\n$$\n{a}_{2}={{field-3}}.\n$$\n\nGiven that $F(x)=\\operatorname{ln}⁡({x}^{2}+1)$ and $L=3,$ the $2$nd cosine coefficient becomes\n\n$$\n{a}_{2}={{field-4}}\\,\\cdot \\,{{field-5}}.\n$$" :question/worked-solution "Recall that multiplying the argument of a function by $k\\ne 0$ represents the horizontal stretching of the corresponding graph by a factor of $\\frac{1}{k}.$\n\nNow, let $s=\\frac{\\pi }{L}x.$ Then, since $f(x)$ has a period of $2L,$ the function\n\n$$\ng(s)=f(\\frac{L}{\\pi }s)\n$$\n\nmust have a period of $2L\\cdot \\frac{\\pi }{L}=2\\pi .$ \n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(ns)+{b}_{n}\\operatorname{sin}⁡(ns),\n$$\n\nwhere:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,\\text{d}s \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,\\text{d}s,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,\\text{d}s,\\,n\\ge 1\\end{aligned}\n$$\n\nSubstituting $s=\\frac{\\pi }{L}x$ and using the fact that $g(s)=f(\\frac{L}{\\pi }s),$ we get the Fourier series of $f(x):$\n\n$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\n$$\n\nTherefore, $2$nd cosine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(2s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(2s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{cos}⁡(2\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{2\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, substituting $L=3$ and $f(x)=F(x)=\\operatorname{ln}⁡({x}^{2}+1),$ we get\n\n$$\n\\begin{aligned}{a}_{2} & =\\frac{1}{3}\\cdot {\\int }_{-3}^{3}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡(\\frac{2\\pi }{3}x)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341776/field-1" "q-341776/field-2" "q-341776/field-3" "q-341776/field-4" "q-341776/field-5"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "12ff3452-19b6-566a-8b39-ad880dee8858"] :knowledge-point/questions ["q-341776"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341789/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "5fb8ac45-f689-5db6-ae0c-75837ab4dc54" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-341789/field-1" :answer-field/id #uuid "5334c9ba-d828-517d-bbad-c6dbb556a36b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341789/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-341789/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-341789" :question/id #uuid "b34a214a-f7e7-5904-9a83-04cf87e89e74" :question/math-academy-id "q-341789" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(n\\pi x)+{b}_{n}\\operatorname{sin}⁡(n\\pi x)\n$$\n\nLet $F(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ The Fourier series of the $2$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=1$ and $f(x)=6{x}^{2}+5x+1$ for $x\\in [-1,1).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{1}{\\int }_{-1}^{1}(6{x}^{2}+5x+1)\\,\\text{d}x \\\\  & ={[2{x}^{3}+\\frac{5}{2}{x}^{2}+x]}_{-1}^{1} \\\\  & =(2+\\frac{5}{2}+1)-((-2)+\\frac{5}{2}+(-1)) \\\\  & =\\frac{11}{2}-(-\\frac{1}{2}) \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341789/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cb301102-1a82-5a81-bb11-b9fc56cd1dc7"] :knowledge-point/questions ["q-341789"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341805/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "dd47698b-a96d-56c3-8bd4-cf4d8ca059a3" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-341805/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "c9ccb07e-ffd3-5528-9164-1b977124cfb9" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-341805/field-1" :answer-field/id #uuid "b2e35c04-7d4a-5197-8342-a358beec383c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341805/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-341805/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-341805/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-341805" :question/id #uuid "2be132fd-956a-5098-8355-4c774f437389" :question/math-academy-id "q-341805" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{8}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{8}x)\n$$\n\nLet $F(x)=-x+5$ for $x\\in [-8,8).$ The Fourier series of the $16$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=8$ and $f(x)=-x+5$ for $x\\in [-8,8).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{8}{\\int }_{-8}^{8}(-x+5)\\,\\text{d}x \\\\  & =\\frac{1}{8}{[-\\frac{1}{2}{x}^{2}+5x]}_{-8}^{8} \\\\  & =\\frac{1}{8}((-\\frac{1}{2}\\cdot {8}^{2}+5\\cdot 8)-(-\\frac{1}{2}\\cdot (-8)^{2}+5\\cdot (-8))) \\\\  & =\\frac{1}{8}(8-(-72)) \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341805/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cb301102-1a82-5a81-bb11-b9fc56cd1dc7"] :knowledge-point/questions ["q-341805"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341791/field-1/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "e4473263-2837-5cbd-a781-42a9653ea91e" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-341791/field-1" :answer-field/id #uuid "b5b12a3a-c5c7-5923-98d2-92a6d2b0efa5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341791/field-1/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer-field/choices ["q-341791/field-1/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c"] :db/ensure [:answer-field/validate]} {:db/id "q-341791" :question/id #uuid "98cb74ae-67bf-52ee-b990-e6fe54f657bf" :question/math-academy-id "q-341791" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{5}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{5}x)\n$$\n\nLet $F(x)=3{x}^{2}-4$ for $x\\in [-5,5).$ The Fourier series of the $10$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=5$ and $f(x)=3{x}^{2}-4$ for $x\\in [-5,5).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{5}{\\int }_{-5}^{5}(3{x}^{2}-4)\\,\\text{d}x \\\\  & =\\frac{1}{5}{[{x}^{3}-4x]}_{-5}^{5} \\\\  & =\\frac{1}{5}(({5}^{3}-4\\cdot 5)-((-5)^{3}-4\\cdot (-5))) \\\\  & =\\frac{1}{5}(105-(-105)) \\\\  & =42.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341791/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cb301102-1a82-5a81-bb11-b9fc56cd1dc7"] :knowledge-point/questions ["q-341791"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341793/field-1/bc787d823ec953ec5e44b8f7f4a4c7f3b5de4a6a5f1cea9c5a660d6b5e6faac7" :answer/id #uuid "90b420ef-d5ac-59a6-aa85-3c7974f488ab" :answer/type :answer.type/math :answer/value "96" :db/ensure [:answer/validate]} {:db/id "q-341793/field-1/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "55375d09-8c43-5a3d-a577-f27f53e182ae" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-341793/field-1" :answer-field/id #uuid "87626ed0-3a09-5ff3-a06b-688555b55946" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341793/field-1/bc787d823ec953ec5e44b8f7f4a4c7f3b5de4a6a5f1cea9c5a660d6b5e6faac7" :answer-field/choices ["q-341793/field-1/bc787d823ec953ec5e44b8f7f4a4c7f3b5de4a6a5f1cea9c5a660d6b5e6faac7" "q-341793/field-1/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f"] :db/ensure [:answer-field/validate]} {:db/id "q-341793" :question/id #uuid "7f6e7496-b0e9-541a-8866-9ce758eed21b" :question/math-academy-id "q-341793" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{7}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{7}x)\n$$\n\nLet $F(x)=3{x}^{2}-1$ for $x\\in [-7,7).$ The Fourier series of the $14$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=7$ and $f(x)=3{x}^{2}-1$ for $x\\in [-7,7).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{7}{\\int }_{-7}^{7}(3{x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{7}{[{x}^{3}-x]}_{-7}^{7} \\\\  & =\\frac{1}{7}(({7}^{3}-7)-((-7)^{3}-(-7))) \\\\  & =\\frac{1}{7}(336-(-336)) \\\\  & =96.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341793/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cb301102-1a82-5a81-bb11-b9fc56cd1dc7"] :knowledge-point/questions ["q-341793"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341790/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "c7680985-42a9-53ce-80dc-f356191bdaf0" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-341790/field-1" :answer-field/id #uuid "ebfdff60-4d18-57fe-b7c8-dfd9c0ea4b1d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341790/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer-field/choices ["q-341790/field-1/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8"] :db/ensure [:answer-field/validate]} {:db/id "q-341790" :question/id #uuid "d5634356-369e-5e62-a553-8bdad9e5a578" :question/math-academy-id "q-341790" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{4}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{4}x)\n$$\n\nLet $F(x)=3{x}^{2}-2x$ for $x\\in [-4,4).$ The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\n{a}_{0}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=4$ and $f(x)=3{x}^{2}-2x$ for $x\\in [-4,4).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{4}{\\int }_{-4}^{4}(3{x}^{2}-2x)\\,\\text{d}x \\\\  & =\\frac{1}{4}{[{x}^{3}-{x}^{2}]}_{-4}^{4} \\\\  & =\\frac{1}{4}(({4}^{3}-{4}^{2})-((-4)^{3}-(-4)^{2})) \\\\  & =\\frac{1}{4}(48-(-80)) \\\\  & =32.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341790/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cb301102-1a82-5a81-bb11-b9fc56cd1dc7"] :knowledge-point/questions ["q-341790"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341870/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "eedaeddd-6b47-5a81-b337-f258907ec804" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-341870/field-1" :answer-field/id #uuid "21cb079f-1ca9-5a38-a096-629c59cbc630" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341870/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-341870/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-341870" :question/id #uuid "ad392f97-2a6e-5204-b06b-384e8f2815ba" :question/math-academy-id "q-341870" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n}{3}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n}{3}x)\n$$\n\nLet $F(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ The Fourier series of the $6\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${a}_{4}.$\n\n${a}_{4}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=3\\pi $ and $f(x)=-3x+1$ for $x\\in [-3\\pi ,3\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4\\pi }{3\\pi }x)\\,\\text{d}x \\\\  & =\\frac{1}{3\\pi }{\\int }_{-\\pi }^{\\pi }(-3x+1)\\operatorname{cos}⁡(\\frac{4}{3}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-3x+1\\, & ⇒\\,{u}^{′}=-3 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{4}{3}x)\\, & ⇒\\,v=\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{3\\pi }(uv\\,{|}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}{[(-3x+1)\\operatorname{sin}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }-{\\int }_{-3\\pi }^{3\\pi }\\frac{3}{4}\\operatorname{sin}⁡(\\frac{4}{3}x)\\cdot (-3)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(\\frac{3}{4}[(-9\\pi +1)\\operatorname{sin}⁡(4\\pi )-(9\\pi +1)\\operatorname{sin}⁡(-4\\pi )]+\\frac{9}{4}{\\int }_{-3\\pi }^{3\\pi }\\operatorname{sin}⁡(\\frac{4}{3}x)\\,\\text{d}x) \\\\  & =\\frac{1}{\\pi }(\\frac{1}{4}\\cdot 0+\\frac{9}{4}\\cdot (-\\frac{3}{4}){[\\operatorname{cos}⁡(\\frac{4}{3}x)]}_{-3\\pi }^{3\\pi }) \\\\  & =\\frac{1}{\\pi }(-\\frac{27}{16}[\\operatorname{cos}⁡(4\\pi )-\\operatorname{cos}⁡(-4\\pi )]) \\\\  & =-\\frac{27}{16\\pi }(1-1) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341870/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c3315887-ff5c-5fd7-93bd-a58800e378b8"] :knowledge-point/questions ["q-341870"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341833/field-1/bfe3949d4da3dce8c5abc513e51e3979f27037db55157cc693d0d8846674a199" :answer/id #uuid "d546bd6e-b748-52b5-923b-f98cf09c8dc2" :answer/type :answer.type/math :answer/value "-\\frac{40}{3\\pi}" :db/ensure [:answer/validate]} {:db/id "q-341833/field-1/f5aed07a0eb4b146829c580f800ee4d2f42537de2cfde6987c507bdd2367517a" :answer/id #uuid "dd7ae91e-02ac-55e1-b704-5b8b4ac81b7f" :answer/type :answer.type/math :answer/value "\\frac{40}{3\\pi}" :db/ensure [:answer/validate]} {:db/id "q-341833/field-1" :answer-field/id #uuid "54f4ba94-710d-50b5-bc5b-05b66d4091e3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341833/field-1/bfe3949d4da3dce8c5abc513e51e3979f27037db55157cc693d0d8846674a199" :answer-field/choices ["q-341833/field-1/bfe3949d4da3dce8c5abc513e51e3979f27037db55157cc693d0d8846674a199" "q-341833/field-1/f5aed07a0eb4b146829c580f800ee4d2f42537de2cfde6987c507bdd2367517a"] :db/ensure [:answer-field/validate]} {:db/id "q-341833" :question/id #uuid "ed4af0ed-c15a-5c67-9fed-b79a6fae573f" :question/math-academy-id "q-341833" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{4}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{4}x)\n$$\n\nLet $F(x)=-5x+2$ for $x\\in [-4,4).$ The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{3}.$\n\n${b}_{3}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=4$ and $f(x)=-5x+2$ for $x\\in [-4,4).$ So, substituting into the formula, we get\n\n$$\n{b}_{3}=\\frac{1}{4}{\\int }_{-4}^{4}(-5x+2)\\operatorname{sin}⁡(\\frac{3\\pi }{4}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-5x+2\\, & ⇒\\,{u}^{′}=-5 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{3\\pi }{4}x)\\, & ⇒\\,v=-\\frac{4}{3\\pi }\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{3} & =\\frac{1}{4}(uv\\,{|}_{-4}^{4}-{\\int }_{-4}^{4}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }{[(-5x+2)\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)]}_{-4}^{4}-{\\int }_{-4}^{4}(-\\frac{4}{3\\pi }\\operatorname{cos}⁡(\\frac{3\\pi }{4}x))(-5)\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }{[(-5x+2)\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)]}_{-4}^{4}-\\frac{20}{3\\pi }{\\int }_{-4}^{4}\\operatorname{cos}⁡(\\frac{3\\pi }{4}x)\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }((-18)(-1)-(22)(-1))-\\frac{80}{9{\\pi }^{2}}(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(-3\\pi ))) \\\\  & =\\frac{1}{4}(-\\frac{4}{3\\pi }\\cdot 40) \\\\  & =-\\frac{40}{3\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341833/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c3315887-ff5c-5fd7-93bd-a58800e378b8"] :knowledge-point/questions ["q-341833"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353155/field-1/a3fae2a8f6eb5b625360f6c9bb7c3b100fbb8b74bf1402fb2c69cee1ac3260c1" :answer/id #uuid "307adda6-a5ca-5a9e-b737-268c6e14303a" :answer/type :answer.type/math :answer/value "\\frac{24}{5\\pi}" :db/ensure [:answer/validate]} {:db/id "q-353155/field-1" :answer-field/id #uuid "9e3190b7-9f0e-55b3-8ecd-37b4937163ae" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353155/field-1/a3fae2a8f6eb5b625360f6c9bb7c3b100fbb8b74bf1402fb2c69cee1ac3260c1" :answer-field/choices ["q-353155/field-1/a3fae2a8f6eb5b625360f6c9bb7c3b100fbb8b74bf1402fb2c69cee1ac3260c1"] :db/ensure [:answer-field/validate]} {:db/id "q-353155" :question/id #uuid "978541e8-259c-5522-95d7-3305fcd24dca" :question/math-academy-id "q-353155" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{4}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{4}x)\n$$\n\nLet $F(x)=3x$ for $x\\in [-4,4).$ The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{5}.$\n\n${b}_{5}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=4$ and $f(x)=3x$ for $x\\in (-4,4).$ So, substituting into the formula, we get\n\n$$\n{b}_{5}=\\frac{1}{4}{\\int }_{-4}^{4}3x\\operatorname{sin}⁡(\\frac{5\\pi }{4}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=3x\\, & ⇒\\,{u}^{′}=3 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{5\\pi }{4}x)\\, & ⇒\\,v=-\\frac{4}{5\\pi }\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{5} & =\\frac{1}{4}(uv\\,{|}_{-4}^{4}-{\\int }_{-4}^{4}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{4}(-\\frac{4}{5\\pi }{[3x\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)]}_{-4}^{4}+\\frac{12}{5\\pi }{\\int }_{-4}^{4}\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-{[3x\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)]}_{-4}^{4}+3{\\int }_{-4}^{4}\\operatorname{cos}⁡(\\frac{5\\pi }{4}x)\\,\\text{d}x) \\\\  & =\\frac{1}{5\\pi }(-((3(4))\\operatorname{cos}⁡(5\\pi )-(3(-4))\\operatorname{cos}⁡(-5\\pi ))+\\frac{12}{5\\pi }{[\\operatorname{sin}⁡(\\frac{5\\pi }{4}x)]}_{-4}^{4}) \\\\  & =\\frac{1}{5\\pi }(24+\\frac{12}{5\\pi }(\\operatorname{sin}⁡(5\\pi )-\\operatorname{sin}⁡(-5\\pi ))) \\\\  & =\\frac{1}{5\\pi }\\cdot 24 \\\\  & =\\frac{24}{5\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-353155/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c3315887-ff5c-5fd7-93bd-a58800e378b8"] :knowledge-point/questions ["q-353155"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353158/field-1/9f2782b352883290a19cd963dbefdd291688b0d658a3997cec9da4b2ea292d9c" :answer/id #uuid "b301d5b4-067a-5578-97c8-1e2a6083ab26" :answer/type :answer.type/math :answer/value "\\frac{20}{3\\pi}" :db/ensure [:answer/validate]} {:db/id "q-353158/field-1/f12f6be39de890c0fecb55d7d039f9a35a1b0bb2899d375783746603ce83326e" :answer/id #uuid "aaf83b85-c963-5d12-bc99-24536e0f2081" :answer/type :answer.type/math :answer/value "-\\frac{20}{3\\pi}" :db/ensure [:answer/validate]} {:db/id "q-353158/field-1" :answer-field/id #uuid "a3882c2c-8495-56ac-8725-f3eab45d5fcb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353158/field-1/9f2782b352883290a19cd963dbefdd291688b0d658a3997cec9da4b2ea292d9c" :answer-field/choices ["q-353158/field-1/9f2782b352883290a19cd963dbefdd291688b0d658a3997cec9da4b2ea292d9c" "q-353158/field-1/f12f6be39de890c0fecb55d7d039f9a35a1b0bb2899d375783746603ce83326e"] :db/ensure [:answer-field/validate]} {:db/id "q-353158" :question/id #uuid "00d3ef23-720a-5eef-9f85-9623878b3d2f" :question/math-academy-id "q-353158" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nLet $F(x)=5x$ for $x\\in [-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of ${b}_{3}.$\n\n${b}_{3}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the sine coefficients are given by\n\n$$\n{b}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=5x$ for $x\\in (-2,2).$ So, substituting into the formula, we get\n\n$$\n{b}_{3}=\\frac{1}{2}{\\int }_{-2}^{2}(5x)\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=5x\\, & ⇒\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\, & ⇒\\,v=-\\frac{2}{3\\pi }\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{b}_{3} & =\\frac{1}{2}(uv\\,{|}_{-2}^{2}-{\\int }_{-2}^{2}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{2}(-\\frac{2}{3\\pi }{[5x\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}+\\frac{10}{3\\pi }{\\int }_{-2}^{2}\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(-{[5x\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}+5{\\int }_{-2}^{2}\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x) \\\\  & =\\frac{1}{3\\pi }(-(5(2)\\operatorname{cos}⁡(3\\pi )-5(-2)\\operatorname{cos}⁡(-3\\pi ))+\\frac{10}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}) \\\\  & =\\frac{1}{3\\pi }(20+\\frac{10}{3\\pi }(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(-3\\pi ))) \\\\  & =\\frac{1}{3\\pi }\\cdot 20 \\\\  & =\\frac{20}{3\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-353158/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c3315887-ff5c-5fd7-93bd-a58800e378b8"] :knowledge-point/questions ["q-353158"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-340873"] :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{2}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{2}x)\n$$\n\nThe Fourier series of the $4$-periodic extension $f(x)$ of the function \n\n$$\nF(x)={\\begin{aligned}2, & x\\in [0,2) \\\\ -1, & x\\in [-2,0)\\end{aligned}\n$$\n\nis shown above. Find the exact value of ${a}_{3}.$\n\n${a}_{3}=$ {{field-1}}" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\n{a}_{n}=\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2.$ Also, $f(x)=2$ for $x\\in (0,2)$ and $f(x)=-1$ for $x\\in (-2,0).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{1}{2}{\\int }_{-2}^{2}f(x)\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{0}(-1)\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x+\\frac{1}{2}{\\int }_{0}^{2}2\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x \\\\  & =-\\frac{1}{2}\\cdot \\frac{2}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{0}+\\frac{2}{3\\pi }{[\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{0}^{2} \\\\  & =-\\frac{1}{3\\pi }(\\operatorname{sin}⁡(0)-\\operatorname{sin}⁡(-3\\pi ))+\\frac{2}{3\\pi }(\\operatorname{sin}⁡(3\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21835"] :question/problem "Let $f(x)$ be the $2L$-periodic extension of a function $F(x)$ from $x\\in [-L,L)$ to $x \\in \\mathbb R.$ \nGiven that $L=2$ and $f(x) = \\cosh{(x+1)}$, find the $4$th cosine and the $4$th sine coefficients." :question/worked-solution "Recall that multiplying the argument of a function by $k \\neq 0$ represents the horizontal stretching of the corresponding graph by a factor of $\\dfrac{1}{k}.$\n\nNow, let $s=\\dfrac{\\pi}{L}x.$ Then, since $f(x)$ has a period of $2L,$ the function\n\n$$\ng(s) = f\\left(\\dfrac{L}{\\pi}s\\right)\n$$\n\nmust have a period of $2L \\cdot \\dfrac{\\pi}{L} = 2\\pi.$ \n\nThe Fourier series of $g(s)$ is\n\n$$\ng(s) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos(ns)+b_n\\sin(ns),\n$$\n\nwhere:\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\,\\text{d}s \\\\ {a}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(ns)\\,\\text{d}s,\\,n\\ge 1 \\\\ {b}_{n} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(ns)\\,\\text{d}s,\\,n\\ge 1\\end{aligned}\n$$\n\nSubstituting $s=\\dfrac{\\pi}{L}x$ and using the fact that $g(s) = f\\left(\\dfrac{L}{\\pi}s\\right),$ we get the Fourier series of $f(x){:}$\n\n$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}\na_n\\cos\\bigg(\\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{n\\pi}{L}x}\\bigg)+\nb_n\\sin\\bigg(\\bbox[4pt, border: solid 1pt gainsboro]{\\dfrac{n\\pi}{L}x}\\bigg)\n$$\n\nTherefore, $4$th cosine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{cos}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{cos}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{cos}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nNext, $4$th sine coefficient of $f(x)$ is \n\n$$\n\\begin{aligned}{b}_{4} & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }g(s)\\operatorname{sin}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi }^{\\pi }f(\\frac{L}{\\pi }s)\\operatorname{sin}⁡(4s)\\,\\text{d}s \\\\  & =\\frac{1}{\\pi }{\\int }_{-L}^{L}f(\\frac{L}{\\pi }\\cdot \\frac{\\pi }{L}x)\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{L}x)\\,\\text{d}(\\frac{\\pi }{L}x) \\\\  & =\\frac{1}{\\pi }\\cdot \\frac{\\pi }{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x \\\\  & =\\frac{1}{L}{\\int }_{-L}^{L}f(x)\\operatorname{sin}⁡(\\frac{4\\pi }{L}x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, substituting $L=2$ and $f(x)=\\cosh(x+1),$ we get\n\n$$\n\\begin{aligned}{a}_{4} & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{cos}⁡(\\frac{4\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{cos}⁡(2\\pi x)\\,\\text{d}x, \\\\ {b}_{4} & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{sin}⁡(\\frac{4\\pi }{2}x)\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-2}^{2}\\operatorname{cosh}⁡(x+1)\\operatorname{sin}⁡(2\\pi x)\\,\\text{d}x.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21836"] :question/problem "$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos\\left(\\dfrac{n\\pi}{2}x\\right)+b_n\\sin\\left(\\dfrac{n\\pi}{2}x\\right)\n$$\n\nLet $F(x)=3x^2-4x+1$ for $x\\in[-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of $a_0.$" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the constant term is given by\n\n$$\na_0=\\frac{1}{L}\\int_{-L}^{L} f(x)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=3x^2-4x+1$ for $x \\in [-2,2).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{1}{2}{\\int }_{-2}^{2}(3{x}^{2}-4x+1)\\,\\text{d}x \\\\  & =\\frac{1}{2}{[{x}^{3}-2{x}^{2}+x]}_{-2}^{2} \\\\  & =\\frac{1}{2}(({2}^{3}-2\\cdot {2}^{2}+2)-((-2)^{3}-2\\cdot (-2)^{2}+(-2))) \\\\  & =\\frac{1}{2}(2-(-18)) \\\\  & =10.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21837"] :question/problem "$$\nf(x) \\sim \\dfrac{a_0}{2}+\\sum_{n=1}^{\\infty}a_n\\cos\\left(\\dfrac{n\\pi}{2}x\\right)+b_n\\sin\\left(\\dfrac{n\\pi}{2}x\\right)\n$$\n\nLet $F(x)=-5x+4$ for $x\\in[-2,2).$ The Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ is shown above. Find the exact value of $a_3.$" :question/worked-solution "For the Fourier series of a $2L$-periodic function, the cosine coefficients are given by\n\n$$\na_n=\\frac{1}{L}\\int_{-L}^{L} f(x)\\cos\\left(\\dfrac{n\\pi}{L}x\\right)\\,\\text{d}x.\n$$\n\nIn our case, $L=2$ and $f(x)=-5x+4$ for $x \\in [-2,2).$ So, substituting into the formula, we get\n\n$$\na_3 = \\dfrac{1}{2}\\int_{-2}^{2} (-5x+4)\\cos\\left(\\dfrac{3\\pi}{2}x\\right)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-5x+4\\, & ⇒\\,{u}^{′}=-5 \\\\ {v}^{′}=\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)\\, & ⇒\\,v=\\frac{2}{3\\pi }\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{3} & =\\frac{1}{2}(uv\\,{|}_{-2}^{2}-{\\int }_{-2}^{2}v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{2}{3\\pi }{[(-5x+4)\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}-{\\int }_{-2}^{2}\\frac{2}{3\\pi }\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\cdot (-5)\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{2}{3\\pi }[(-5(2)+4)\\operatorname{sin}⁡(3\\pi )-(-5(-2)+4)\\operatorname{sin}⁡(-3\\pi )]+\\frac{10}{3\\pi }{\\int }_{-2}^{2}\\operatorname{sin}⁡(\\frac{3\\pi }{2}x)\\,\\text{d}x) \\\\  & =\\frac{1}{2}(\\frac{2}{3\\pi }\\cdot 0+\\frac{10}{3\\pi }\\cdot (-\\frac{2}{3\\pi }){[\\operatorname{cos}⁡(\\frac{3\\pi }{2}x)]}_{-2}^{2}) \\\\  & =\\frac{1}{2}(-\\frac{20}{9{\\pi }^{2}}[\\operatorname{cos}⁡(3\\pi )-\\operatorname{cos}⁡(-3\\pi )]) \\\\  & =-\\frac{10}{9{\\pi }^{2}}(-1-(-1)) \\\\  & =0.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
