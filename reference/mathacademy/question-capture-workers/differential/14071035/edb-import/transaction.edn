operatorname{cosh}⁡(3t)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e/2bf1710a093bf7d2ef985f83a0a814a8b3a30552e3fe4d6d11fccc85a4cf2676" :answer/id #uuid "ea397856-2d4d-550d-8a79-d484cee4cbf3" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e" :answer-field/id #uuid "75b02911-7089-5e79-b996-092f11944239" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e/06741ce985cb782ee5d071ff3867aa35cec808d9845153ee6435badc47f3724d" :answer-field/choices ["q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e/e39c8540e0eacc2281fd6bd06d57bc6113c622be4a42e4e56342cea89d855e69" "q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e/5cecd904e57cdb500a8c6024e25e794cd00d6d26cc72da2bd06c3238b1a7cdfb" "q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e/8f04a4f4e868c7e1c0334f7dfe8c9b8354072fdbcf7d372c0dc9a93d374b27b2" "q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e/06741ce985cb782ee5d071ff3867aa35cec808d9845153ee6435badc47f3724d" "q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e/2bf1710a093bf7d2ef985f83a0a814a8b3a30552e3fe4d6d11fccc85a4cf2676"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-335023"] :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=3y(t) \\\\ {y}^{′}(t)=3x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-335023/selection/ma-v1/28757b39e433444e3a62a87e4c4889960e5b302d5f4ff604ecce2b272333e77e"] :db/ensure [:question/validate]} [:db/retract 17592186229624 :question/answer-fields 17592186228183] {:db/id "q-334772/selection/ma-v1/c006e3b2d62d51288b