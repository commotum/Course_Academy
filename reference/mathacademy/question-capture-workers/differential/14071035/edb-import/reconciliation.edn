begin{aligned}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}{e}^{-5t} & t{e}^{-5t} \\\\ 0 & {e}^{-5t}\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}{e}^{-5t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}t{e}^{-5t} \\\\ {e}^{-5t}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-5t}+{c}_{2}[\\begin{aligned}t \\\\ 1\\end{aligned}]{e}^{-5t},\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14071035/state.json" "file_sha256" "138f05f1511971e6558c22b2b6acb9a020147b7e3bb50e15f40b2fc8c6e97132"} {"question" "q-334767" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14071035/activity-metadata.json" "file_sha256" "d6d27dde9e4f0f4bbbb77fb9930440ee466a7e9927dac3075f1b781d29f35db3"} {"question" "q-334767" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14071035/state.json" "file_sha256" "138f05f1511971e6558c22b2b6acb9a020147b7e3bb50e15f40b2fc8c6e97132"} {"question" "q-334767" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-5t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-5t}"] ["math" "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-5t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{5t}"] ["math" "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-5t}+{c}_{2}[\\begin{aligned}t \\\\ 1\\end{aligne