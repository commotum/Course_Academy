torname{sin}⁡(4t) & \\operatorname{cos}⁡(4t)\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(4t) \\\\ \\operatorname{sin}⁡(4t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(4t) \\\\ \\operatorname{cos}⁡(4t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"}] [{:db/id #edb/ref 17592186229632 :knowledge-point/_questions [{:knowledge-point/id #uuid "e5bc609b-dc5b-52e9-9f0e-206f32bb829b" :knowledge-point/title "Finding the General Solution of a Homogeneous System Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3116f3b1-c068-5e11-941d-f69855593bd7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186369731} {:answer/id #uuid "ea397856-2d4d-550d-8a79-d484cee4cbf3" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]{e}^{-3t}" :db/id #edb/ref 17592186369732} {:answer/id #uuid "39c2ad02-f284-50be-9b1d-5d3ff5e004ee" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186369733} {:answer/id #uuid "cca0c27b-98e2-549c-a8da-9e6ce606b4ec" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]{e}^{-3t}+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186369734} {:answer/id #uuid "56031d5b-9a7d-58e7-9286-2a10f9d61bf4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186369735}] :answer-field/correct {:answer/id #uuid "3116f3b1-c068-5e11-941d-f69855593bd7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}]" :db/id #edb/ref 17592186369731} :answer-field/id #uuid "75b02911-7089-5e79-b996-092f11944239" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369730}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "56cd9daa-00e7-5df3-81ab-61efadc99e76" :question/math-academy-id "q-335023" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=3y(t) \\\\ {y}^{′}(t)=3x(t)\\end{aligned}\n$$\n\nWhich of the following gives the general solution to the system of ODEs above?\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & 3 \\\\ 3 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the general solution of the system can be written as\n\n$$\nx(t)=Φ(t)\\,c,\n$$\n\nwhere $Φ(t)$ is a fundamental matrix of the system, and $c$ is a constant vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}].\n$$\n\nTherefore, the general solution is\n\n$$\n\\begin{aligned}x(t) & ={Φ}_{0}(t)\\,c \\\\  & ={e}^{At}\\,c \\\\  & =[\\begin{aligned}\\operatorname{cosh}⁡(3t) & \\operatorname{sinh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t) & \\operatorname{cosh}⁡(3t)\\end{aligned}][\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] \\\\  & ={c}_{1}[\\begin{aligned}\\operatorname{cosh}⁡(3t) \\\\ \\operatorname{sinh}⁡(3t)\\end{aligned}]+{c}_{2}[\\begin{aligned}\\operatorname{sinh}⁡(3t) \\\\ \\operatorname{cosh}⁡(3t)\\end{aligned}],\\end{aligned}\n$$\n\nwhere ${c}_{1},{c}_{2}\\in R.$"}] [{:db/id #edb/ref 17592186369736 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d611c75-818f-508f-a7a4-49edb32baa41" :knowledge-point/title "Solving a Homogeneous Initial Value Problem Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "298bd6f2-32b2-50a3-9fca-6f3d5380ae2a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cos(7t)-3\\sin(7t)" :db/id #edb/ref 17592186369738} {:answer/id #uuid "d6eddcc9-5d04-5ea2-b57d-abe4db9609f2" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cos(7t)+3\\sin(7t)" :db/id #edb/ref 17592186369739}] :answer-field/correct {:answer/id #uuid "298bd6f2-32b2-50a3-9fca-6f3d5380ae2a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\cos(7t)-3\\sin(7t)" :db/id #edb/ref 17592186369738} :answer-field/id #uuid "ea89e8e6-c71a-5c5b-8fb1-e6fd04aeb1a8" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186369737} {:answer-field/choices [{:answer/id #uuid "434646a0-fa60-551b-a0fa-2839210f3ed9" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin(7t)+3\\cos(7t)" :db/id #edb/ref 17592186369741}] :answer-field/correct {:answer/id #uuid "434646a0-fa60-551b-a0fa-2839210f3ed9" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\sin(7t)+3\\cos(7t)" :db/id #edb/ref 17592186369741} :answer-field/id #uuid "8c01c5d6-0a63-5009-9428-9400c4c9b5f7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186369740}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "febc488b-f99a-5816-8d0c-d8bdce9601bb" :question/math-academy-id "q-335262" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-7y(t) \\\\ {y}^{′}(t)=7x(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(7t) & -\\operatorname{sin}⁡(7t) \\\\ \\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}],$ where $A=[\\begin{aligned}0 & -7 \\\\ 7 & 0\\end{aligned}].$*\n\n| $[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=\\,\\,$ |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n|  | {{field-2}} |  |  |" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & -7 \\\\ 7 & 0\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}0 & -7 \\\\ 7 & 0\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}\\operatorname{cos}⁡(7t) & -\\operatorname{sin}⁡(7t) \\\\ \\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}].\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(7t) & -\\operatorname{sin}⁡(7t) \\\\ \\operatorname{sin}⁡(7t) & \\operatorname{cos}⁡(7t)\\end{aligned}][\\begin{aligned}-2 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}\\,-2\\operatorname{cos}⁡(7t)-3\\operatorname{sin}⁡(7t)\\, \\\\ \\,-2\\operatorname{sin}⁡(7t)+3\\operatorname{cos}⁡(7t)\\,\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186229637 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d611c75-818f-508f-a7a4-49edb32baa41" :knowledge-point/title "Solving a Homogeneous Initial Value Problem Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ae10838-d331-5fdb-903a-fca19877b066" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}-2te^{-3t} \\\\ 2e^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186228249} {:answer/id #uuid "e7fc49fd-f1a8-52ca-bdf3-9bb225965b86" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2e^{-3t} \\\\ 2te^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186228250} {:answer/id #uuid "ed8071ad-34b8-5a91-97ac-0395680f2065" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2te^{3t} \\\\ 2e^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186228251} {:answer/id #uuid "4b3b14d8-5ed8-5af3-ba25-b0dba6ec8008" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2te^{-3t} \\\\ 2e^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186228252} {:answer/id #uuid "4c5bb738-f10b-53ae-aa70-d15e698cbbc6" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2te^{-3t} \\\\ -2e^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186228253}] :answer-field/correct {:answer/id #uuid "4b3b14d8-5ed8-5af3-ba25-b0dba6ec8008" :answer/type {:db/ident :answer.type/math} :answer/value "\\begin{bmatrix}2te^{-3t} \\\\ 2e^{-3t}\\end{bmatrix}" :db/id #edb/ref 17592186228252} :answer-field/id #uuid "02dd2f8e-dcca-5a57-b83d-af510acff5a2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186228248}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "62010a37-a91d-55bc-8c8e-6361d12d6c44" :question/math-academy-id "q-335267" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-3x(t)+y(t) \\\\ {y}^{′}(t)=-3y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ 2\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{aligned}],$ where $A=[\\begin{aligned}-3 & 1 \\\\ 0 & -3\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-3 & 1 \\\\ 0 & -3\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}-3 & 1 \\\\ 0 & -3\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{aligned}].\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{-3t} & t{e}^{-3t} \\\\ 0 & {e}^{-3t}\\end{aligned}][\\begin{aligned}0 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}2t{e}^{-3t} \\\\ 2{e}^{-3t}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369742 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d611c75-818f-508f-a7a4-49edb32baa41" :knowledge-point/title "Solving a Homogeneous Initial Value Problem Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a15811ee-0ae2-5086-abcd-3ee1bead34ec" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4{e}^{6t} \\\\ -4t{e}^{6t}\\end{aligned}]" :db/id #edb/ref 17592186369744} {:answer/id #uuid "db2b112c-d74a-51cd-875a-f1d81383b2c8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4t{e}^{6t} \\\\ -4{e}^{6t}\\end{aligned}]" :db/id #edb/ref 17592186369745} {:answer/id #uuid "0675f34f-bfa4-54bf-8c36-ea0d5311ffae" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4t{e}^{6t} \\\\ 4{e}^{6t}\\end{aligned}]" :db/id #edb/ref 17592186369746} {:answer/id #uuid "e122a47d-b612-501d-8ee3-df62d31a5379" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}4t{e}^{6t} \\\\ -4{e}^{6t}\\end{aligned}]" :db/id #edb/ref 17592186369747} {:answer/id #uuid "bd9ff616-5029-57a8-acb1-c5a2efc975b7" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4t{e}^{-6t} \\\\ -4{e}^{6t}\\end{aligned}]" :db/id #edb/ref 17592186369748}] :answer-field/correct {:answer/id #uuid "db2b112c-d74a-51cd-875a-f1d81383b2c8" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-4t{e}^{6t} \\\\ -4{e}^{6t}\\end{aligned}]" :db/id #edb/ref 17592186369745} :answer-field/id #uuid "e85a57a0-ef5b-511b-9088-3b1a776a4c05" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186369743}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "10b6ad6d-f99d-5268-b783-3c37f63747e2" :question/math-academy-id "q-335268" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=6x(t)+y(t) \\\\ {y}^{′}(t)=6y(t),\\end{aligned}\\,[\\begin{aligned}x(0) \\\\ y(0)\\end{aligned}]=[\\begin{aligned}0 \\\\ -4\\end{aligned}]\n$$\n\nFind the solution to the initial value problem above.\n\n*Hint: ${e}^{At}=[\\begin{aligned}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{aligned}],$ where $A=[\\begin{aligned}6 & 1 \\\\ 0 & 6\\end{aligned}].$*" :question/worked-solution "Writing our system in matrix form, we get\n\n$$\n{x}^{′}(t)=[\\begin{aligned}6 & 1 \\\\ 0 & 6\\end{aligned}]x(t),\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$ So, the matrix of the system is $A=[\\begin{aligned}6 & 1 \\\\ 0 & 6\\end{aligned}].$\n\nGiven the system ${x}^{′}(t)=Ax(t),$ where $A$ is a constant square matrix, the solution of the initial value problem can be written as\n\n$$\nx(t)={Φ}_{0}(t)\\,x(0),\n$$\n\nwhere ${Φ}_{0}(t)={e}^{At}$ is the standard fundamental matrix of the system, and $x(0)$ is the initial condition vector.\n\nNow, using the given information, the standard fundamental matrix ${Φ}_{0}(t)$ of the system is given by\n\n$$\n{Φ}_{0}(t)={e}^{At}=[\\begin{aligned}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{aligned}].\n$$\n\nTherefore, the solution is\n\n$$\n\\begin{aligned}x(t) & ={e}^{At}\\,x(0) \\\\  & =[\\begin{aligned}{e}^{6t} & t{e}^{6t} \\\\ 0 & {e}^{6t}\\end{aligned}][\\begin{aligned}0 \\\\ -4\\end{aligned}] \\\\  & =[\\begin{aligned}-4t{e}^{6t} \\\\ -4{e}^{6t}\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186369749 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d611c75-818f-508f-a7a4-49edb32baa41" :knowledge-point/title "Solving a Homogeneous Initial Value Problem Using a Given Matrix Exponential"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e64d1992-927d-5e55-aa96-ef41085474da" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-3t{e}^{5t} \\\\ -3{e}^{-5t}\\end{aligned}]" :db/id #edb/ref 17592186369751} {:answer/id #uuid "b8fa5f03-2bbc-5bed-9ab9-ce009a9ade11" :answ