" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186131122} {:answer-field/id #uuid "edb03679-939f-50ad-9fbe-8401c388d541" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186131123} {:answer-field/id #uuid "35e67592-b151-5882-ba6b-a4bfb8feb39a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186131124} {:answer-field/id #uuid "7b42f8d2-a930-5d23-ae8f-6ced6b787d4c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186131125}] :question/id #uuid "c0d346a2-b012-5c0d-b429-60020e32ca6b" :question/math-academy-id "q-326002" :question/problem "Solve the initial value problem\n$x^{′}(t) = Ax(t), x(0) = \\begin{bmatrix}5 \\\\ 3\\end{bmatrix}$\ngiven that the general solution to our differential equation is\n$x(t) = c_{1}\\begin{bmatrix}1 \\\\ 2\\end{bmatrix}e^{t} + c_{2}\\begin{bmatrix}3 \\\\ -1\\end{bmatrix}e^{-t}, c_{1}, c_{2} ∈ R$.\n\nThe solution to the initial value problem is\n\n| $x(t) =$ |  | {{field-1}} |  | $e^{t} +$ |  | {{field-2}} |  | $e^{-t}$. |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |"}] [{:db/id #edb/ref 17592186134130 :knowledge-point/_questions [{:knowledge-point/id #uuid "35a8694d-4fa1-54a6-a492-3025cb627fa1" :knowledge-point/title "Solving an Initial Value Problem Given the Eigenvectors and Eigenvalues of the Corresponding Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8681ef33-b857-5534-8f6c-70b458bd555c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = \\begin{bmatrix}2 \\\\ -4\\end{bmatrix}e^{t}" :db/id #edb/ref 17592186131223} {:answer/id #uuid "99d3064b-accc-52ed-89f7-c421e5466275" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = \\begin{bmatrix}2 \\\\ -5\\end{bmatrix}e^{t} + \\begin{bmatrix}1 \\\\ 2\\end{bmatrix}e^{-t}" :db/id #edb/ref 17592186131224} {:answer/id #uuid "e7f7944a-5d1e-5547-8618-b6e33ae8b5b6" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = \\begin{bmatrix}2 \\\\ -4\\end{bmatrix}e^{t} + \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}e^{-t}" :db/id #edb/ref 17592186131225} {:answer/id #uuid "482542dc-4a75-526b-ab63-2847d6dda0d5" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = \\begin{bmatrix}2 \\\\ -4\\end{bmatrix}e^{-t} + \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}e^{t}" :db/id #edb/ref 17592186131226} {:answer/id #uuid "534d6e73-af82-5ab8-9471-07f5f256587e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = \\begin{bmatrix}2 \\\\ -4\\end{bmatrix}e^{t} + \\begin{bmatrix}2 \\\\ 2\\end{bmatrix}e^{-t}" :db/id #edb/ref 17592186131227}] :answer-field/correct {:answer/id #uuid "e7f7944a-5d1e-5547-8618-b6e33ae8b5b6" :answer/type {:db/ident :answer.type/math} :answer/value "x(t) = \\begin{bmatrix}2 \\\\ -4\\end{bmatrix}e^{t} + \\begin{bmatrix}1 \\\\ 1\\end{bmatrix}e^{-t}" :db/id #edb/ref 17592186131225} :answer-field/id #uuid "1191790e-c313-59f7-8d21-9379b5a7654c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131222}] :question/id #uuid "d9d3d68e-7221-5fb6-8c31-50910c28ab47" :question/math-academy-id "q-39240" :question/problem "Let $A$ be a $2 \\cdot 2$ matrix with eigenvalues $λ_{1} = 1$ and $λ_{2} =-1$ corresponding to the eigenvectors $v_{1}$ and $v_{2}$ respectively, where\n\n$v_{1} = \\begin{bmatrix}1 \\\\ -2\\end{bmatrix}, v_{2} = \\begin{bmatrix}2 \\\\ 2\\end{bmatrix}$.\nSolve the following initial value problem:\n$x^{′}(t) = Ax(t), x(0) = \\begin{bmatrix}3 \\\\ -3\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186134131 :knowledge-point/_questions [{:knowledge-point/id #uuid "35a8694d-4fa1-54a6-a492-3025cb627fa1" :knowledge-point/title "Solving an Initial Value Problem Given the Eigenvectors and Eigenvalues of the Corresponding Matrix"}] :question/answer-fields [{:answer-f