choices ["q-326291/field-3/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-326291/field-4/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "c98e0833-7ba9-5172-8bc9-ae0384314dca" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-326291/field-4" :answer-field/id #uuid "3c45ef76-8638-566d-8183-139eb6fd7e0f" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326291/field-4/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-326291/field-4/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-326291" :question/id #uuid "b965a1be-feff-59c2-b300-635c6df21227" :question/math-academy-id "q-326291" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=[\\begin{aligned}7 \\\\ 1\\end{aligned}]\n$$\n\ngiven that the general solution to our differential equation is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe solution to the initial value problem is\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{-t}.$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{0} & =[\\begin{aligned}7 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}2{c}_{1}+{c}_{2} \\\\ -{c}_{1}+{c}_{2}\\end{aligned}] & =[\\begin{aligned}7 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}2{c}_{1}+{c}_{2}=7 \\\\ -{c}_{1}+{c}_{2}=1.\\end{aligned}\n$$\n\nMultiplying the second equation by $2$ and adding the result to the  first equation, we get\n\n$$\n3{c}_{2}=9\\,⟹\\,{c}_{2}=3.\n$$\n\nSubstituting this into the second equation, we obtain \n\n$$\n-{c}_{1}+3=1\\,⟹\\,{c}_{1}=2.\n$$\n\n \nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =2\\cdot [\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{t}+3\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t} \\\\  & =[\\begin{aligned}4 \\\\ -2\\end{aligned}]{e}^{t}+[\\begin{aligned}3 \\\\ 3\\end{aligned}]{e}^{-t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326291/field-1" "q-326291/field-2" "q-326291/field-3" "q-326291/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83399378-8815-5602-a60a-6901114416f7"] :knowledge-point/questions ["q-326291"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326298/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f818f94e-c19e-55c0-b951-1805856f0866" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-326298/field-1" :answer-field/id #uuid "afead4a6-d911-5551-8bd2-142c6557e9c3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326298/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-326298/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-326298/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c964c8d0-7f1c-5e63-9001-e7e6183c9bd6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-326298/field-2" :answer-field/id #uuid "9391c61f-d19b-5e84-9128-888ea0defe72" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326298/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-326298/field-2/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-326298/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "65a5fb58-eb5d-542b-873c-b8da7a856497" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-326298/field-3" :answer-field/id #uuid "9a1d5139-0880-5277-b703-668a56cd01a2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326298/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-326298/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-326298/field-4/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "0c081379-c37f-54ce-ac8e-b3f53bd9e696" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-326298/field-4" :answer-field/id #uuid "d862e68c-c414-5165-979d-ceb07028a035" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326298/field-4/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-326298/field-4/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-326298" :question/id #uuid "94376933-6ac5-5c91-9bc7-de6f6e3d21f5" :question/math-academy-id "q-326298" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=[\\begin{aligned}4 \\\\ 0\\end{aligned}]\n$$\n\ngiven that the general solution to our differential equation is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe solution to the initial value problem is\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{-t}.$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ in the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{0} & =[\\begin{aligned}4 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+{c}_{2} \\\\ {c}_{1}-{c}_{2}\\end{aligned}] & =[\\begin{aligned}4 \\\\ 0\\end{aligned}].\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}{c}_{1}+{c}_{2}=4 \\\\ {c}_{1}-{c}_{2}=0.\\end{aligned}\n$$\n\nAdding the equations, we get\n\n$$\n2{c}_{1}=4\\,⟹\\,{c}_{1}=2.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n2+{c}_{2}=4\\,⟹\\,{c}_{1}=2.\n$$\n\n \n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =2\\cdot [\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{t}+2\\cdot [\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{-t} \\\\  & =[\\begin{aligned}2 \\\\ 2\\end{aligned}]{e}^{t}+[\\begin{aligned}2 \\\\ -2\\end{aligned}]{e}^{-t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326298/field-1" "q-326298/field-2" "q-326298/field-3" "q-326298/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83399378-8815-5602-a60a-6901114416f7"] :knowledge-point/questions ["q-326298"] :db/ensure [:knowledge-point/validate]} {:db/id "q-39280/selection/cd0bee66d3fe65c80d2274187bebf4884d51668c3f2bdd0ae5b3ac6292cd93bc" :answer/id #uuid "3b2a6b45-fa0f-5be8-a458-7f177a22e497" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-18{e}^{28}+24{e}^{-7} \\\\ -18{e}^{28}+18{e}^{-7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39280/selection/696b28a5eecd6dcfb55ceef3e18cdb94b2892c4e5d25d464f59080e9967e59ac" :answer/id #uuid "0130a953-0236-5275-b236-bbbb30e2c9b4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-18{e}^{7}+24{e}^{-7} \\\\ -18{e}^{7}+18{e}^{-7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39280/selection/437ea305e78a1f60db8592c5348ac48476df21227a724ebc18d176ae0a5cb9e0" :answer/id #uuid "1eb24a4c-0639-529a-bdfb-ab7ba0ddd9f2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6{e}^{28}+18{e}^{-7} \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39280/selection/44f523f920c50446a469b395bc3f01e9868fcdcf8b26dab94b8ccdd71987a065" :answer/id #uuid "13c39644-6f03-5375-8c70-df629c3e745b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}18{e}^{28}+24{e}^{-7} \\\\ -6{e}^{28}+18{e}^{-7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39280/selection/f2cdc739681cd3b358c74559e23029f375530a833e6938e06fe28d13363858e9" :answer/id #uuid "bd0376c0-0c08-550b-8d05-52426e5af069" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-12{e}^{28}+28{e}^{-7} \\\\ -18{e}^{28}+16{e}^{-7}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-39280/selection" :answer-field/id #uuid "b965f82c-b854-52ee-8c41-a50744fb1325" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39280/selection/cd0bee66d3fe65c80d2274187bebf4884d51668c3f2bdd0ae5b3ac6292cd93bc" :answer-field/choices ["q-39280/selection/cd0bee66d3fe65c80d2274187bebf4884d51668c3f2bdd0ae5b3ac6292cd93bc" "q-39280/selection/696b28a5eecd6dcfb55ceef3e18cdb94b2892c4e5d25d464f59080e9967e59ac" "q-39280/selection/437ea305e78a1f60db8592c5348ac48476df21227a724ebc18d176ae0a5cb9e0" "q-39280/selection/44f523f920c50446a469b395bc3f01e9868fcdcf8b26dab94b8ccdd71987a065" "q-39280/selection/f2cdc739681cd3b358c74559e23029f375530a833e6938e06fe28d13363858e9"] :db/ensure [:answer-field/validate]} {:db/id "q-39280" :question/id #uuid "30741167-2bc5-594b-91e9-dac46b63e700" :question/math-academy-id "q-39280" :question/problem "Let $A$ be a $2\\times 2$ matrix with eigenvalues ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=-1$ corresponding to the eigenvectors ${v}_{1}$ and ${v}_{2}$ respectively, where\n\n$$\n{v}_{1}=[\\begin{aligned}-1 \\\\ -1\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}4 \\\\ 3\\end{aligned}].\n$$\n\nGiven that the position of a particle at time $t$ seconds is given by the vector $x(t),$ and that $x(t)$ is the solution to the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=[\\begin{aligned}6 \\\\ 0\\end{aligned}],\n$$\n\nfind the position of the particle at $t=7$ seconds." :question/worked-solution "Given a system of first-order linear ODEs in the form\n\n$$\n{x}^{′}(t)=Ax(t),\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\lambda }_{1},{\\lambda }_{2}$ with corresponding eigenvectors ${v}_{1}$ and ${v}_{2},$ the formula for the general solution is\n\n$$\nx(t)={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nTherefore, the general solution to our matrix differential equation is\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}-1 \\\\ -1\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}4 \\\\ 3\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNow, to find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ into the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}6 \\\\ 0\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}-1 \\\\ -1\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}4 \\\\ 3\\end{aligned}]{e}^{0} & =[\\begin{aligned}6 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}-{c}_{1}+4{c}_{2} \\\\ -{c}_{1}+3{c}_{2}\\end{aligned}] & =[\\begin{aligned}6 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}-{c}_{1}+4{c}_{2}=6 \\\\ -{c}_{1}+3{c}_{2}=0.\\end{aligned}\n$$\n\nMultiplying the second equation by $-1$ and adding the result to the first equation, we get\n\n$$\n{c}_{2}=6.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n-{c}_{1}+4\\cdot 6=6\\,⟹\\,{c}_{1}=18.\n$$\n\n \n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =18\\cdot [\\begin{aligned}-1 \\\\ -1\\end{aligned}]{e}^{4t}+6\\cdot [\\begin{aligned}4 \\\\ 3\\end{aligned}]{e}^{-t} \\\\  & =[\\begin{aligned}-18 \\\\ -18\\end{aligned}]{e}^{4t}+[\\begin{aligned}24 \\\\ 18\\end{aligned}]{e}^{-t}.\\end{aligned}\n$$\n\nFinally, we calculate $x(7)$:\n\n$$\n\\begin{aligned}x(7) & =[\\begin{aligned}-18 \\\\ -18\\end{aligned}]{e}^{4\\cdot 7}+[\\begin{aligned}24 \\\\ 18\\end{aligned}]{e}^{-7} \\\\  & =[\\begin{aligned}-18 \\\\ -18\\end{aligned}]{e}^{28}+[\\begin{aligned}24 \\\\ 18\\end{aligned}]{e}^{-7} \\\\  & =[\\begin{aligned}-18{e}^{28}+24{e}^{-7} \\\\ -18{e}^{28}+18{e}^{-7}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39280/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35a8694d-4fa1-54a6-a492-3025cb627fa1"] :knowledge-point/questions ["q-39280"] :db/ensure [:knowledge-point/validate]} {:db/id "q-168917/selection/d2adb465944056677cc37f1cece36b6b1e0ea6f865d350b6b497b5ab5fff74dd" :answer/id #uuid "01ed4800-cb6d-532b-801e-4e798905c0ad" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3{e}^{-4}+4{e}^{6} \\\\ {e}^{-4}-4{e}^{6}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-168917/selection/292aed5c98b99cb4ef2e243536a5e66a2e81c4ab639edd3c95eca867be17f0f0" :answer/id #uuid "fd823ee5-24d1-5ddf-8fcb-166f0bdddcc0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-{e}^{-4}+4{e}^{6} \\\\ 5{e}^{-4}-4{e}^{6}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-168917/selection/c9b3afbe13d77bf330bdf080f4bbd38e8031b03dba098ae30db6660993adbb0e" :answer/id #uuid "df272c2a-7644-5424-a875-dda4bbbe7d18" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-{e}^{-4} \\\\ 5{e}^{6}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-168917/selection/d32c1e286a84642f0f042a2573c920af0cd4be2d98f46c04d3ebbe227a503ebf" :answer/id #uuid "54094274-b30a-5c0c-9eb6-fe047f22b4b2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}3{e}^{6} \\\\ -4{e}^{-4}+{e}^{6}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-168917/selection/376c05ae462086c2aa3419310675f99af1fb10faeea0b8d9ac79e5531b73a333" :answer/id #uuid "41d7047c-707d-526d-89cc-4bce96113e37" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{-4}+3{e}^{6} \\\\ -{e}^{-4}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-168917/selection" :answer-field/id #uuid "4e47b642-1b03-51e6-a0ef-cf4d69db23c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-168917/selection/292aed5c98b99cb4ef2e243536a5e66a2e81c4ab639edd3c95eca867be17f0f0" :answer-field/choices ["q-168917/selection/d2adb465944056677cc37f1cece36b6b1e0ea6f865d350b6b497b5ab5fff74dd" "q-168917/selection/292aed5c98b99cb4ef2e243536a5e66a2e81c4ab639edd3c95eca867be17f0f0" "q-168917/selection/c9b3afbe13d77bf330bdf080f4bbd38e8031b03dba098ae30db6660993adbb0e" "q-168917/selection/d32c1e286a84642f0f042a2573c920af0cd4be2d98f46c04d3ebbe227a503ebf" "q-168917/selection/376c05ae462086c2aa3419310675f99af1fb10faeea0b8d9ac79e5531b73a333"] :db/ensure [:answer-field/validate]} {:db/id "q-168917" :question/id #uuid "048c4d19-f776-56af-aac6-30cdbc559443" :question/math-academy-id "q-168917" :question/problem "Let $A$ be a $2\\times 2$ matrix with eigenvalues ${\\lambda }_{1}=-2$ and ${\\lambda }_{2}=3$ corresponding to the eigenvectors ${v}_{1}$ and ${v}_{2}$ respectively, where\n\n$$\n{v}_{1}=[\\begin{aligned}-1 \\\\ 5\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}1 \\\\ -1\\end{aligned}].\n$$\n\nGiven that the position of a particle at time $t$ seconds is given by the vector $x(t),$ and that $x(t)$ is the solution to the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=[\\begin{aligned}3 \\\\ 1\\end{aligned}],\n$$\n\nfind the position of the particle at $t=2$ seconds." :question/worked-solution "Given a system of first-order linear ODEs in the form\n\n$$\n{x}^{′}(t)=Ax(t),\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\lambda }_{1},{\\lambda }_{2}$ with corresponding eigenvectors ${v}_{1}$ and ${v}_{2},$ the formula for the general solution is\n\n$$\nx(t)={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nTherefore, the general solution to our matrix differential equation is\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}-1 \\\\ 5\\end{aligned}]{e}^{-2t}+{c}_{2}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNow, to find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ into the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}-1 \\\\ 5\\end{aligned}]{e}^{-2(0)}+{c}_{2}[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{3(0)} & =[\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}-1 \\\\ 5\\end{aligned}]+{c}_{2}[\\begin{aligned}1 \\\\ -1\\end{aligned}] & =[\\begin{aligned}3 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}-{c}_{1}+{c}_{2} \\\\ 5{c}_{1}-{c}_{2}\\end{aligned}] & =[\\begin{aligned}3 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}-{c}_{1}+{c}_{2}=3 \\\\ 5{c}_{1}-{c}_{2}=1.\\end{aligned}\n$$\n\nAdding the equations, we get\n\n$$\n4{c}_{1}=4\\,⟹\\,{c}_{1}=1.\n$$\n\nSubstituting this into the first equation, we obtain\n\n$$\n-1+{c}_{2}=3\\,⟹\\,{c}_{2}=4.\n$$\n\n \n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =1[\\begin{aligned}-1 \\\\ 5\\end{aligned}]{e}^{-2t}+4[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{3t} \\\\  & =[\\begin{aligned}-1 \\\\ 5\\end{aligned}]{e}^{-2t}+[\\begin{aligned}4 \\\\ -4\\end{aligned}]{e}^{3t}.\\end{aligned}\n$$\n\nFinally, we calculate $x(2):$\n\n$$\n\\begin{aligned}x(2) & =[\\begin{aligned}-1 \\\\ 5\\end{aligned}]{e}^{-2(2)}+[\\begin{aligned}4 \\\\ -4\\end{aligned}]{e}^{3(2)} \\\\  & =[\\begin{aligned}-1 \\\\ 5\\end{aligned}]{e}^{-4}+[\\begin{aligned}4 \\\\ -4\\end{aligned}]{e}^{6} \\\\  & =[\\begin{aligned}-{e}^{-4}+4{e}^{6} \\\\ 5{e}^{-4}-4{e}^{6}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-168917/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35a8694d-4fa1-54a6-a492-3025cb627fa1"] :knowledge-point/questions ["q-168917"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-39241"] :question/problem "Let $A$ be a $2\\times 2$ matrix with eigenvalues ${\\lambda }_{1}=0$ and ${\\lambda }_{2}=2$ corresponding to the eigenvectors ${v}_{1}$ and ${v}_{2}$ respectively, where\n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}2 \\\\ 2\\end{aligned}].\n$$\n\nGiven that the position of a particle at time $t$ seconds is given by the vector $x(t),$ and that $x(t)$ is the solution to the initial value problem\n\n$$\n{x}^{′}(t)=Ax(t),\\,x(0)=[\\begin{aligned}5 \\\\ 1\\end{aligned}],\n$$\n\nfind the position of the particle at $t=5$ seconds." :question/worked-solution "Given a system of first-order linear ODEs in the form\n\n$$\n{x}^{′}(t)=Ax(t),\n$$\n\nwhere $A$ has two distinct eigenvalues ${\\lambda }_{1},{\\lambda }_{2}$ with corresponding eigenvectors ${v}_{1}$ and ${v}_{2},$ the formula for the general solution is\n\n$$\nx(t)={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nTherefore, the general solution to our matrix differential equation is\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{0}+{c}_{2}[\\begin{aligned}2 \\\\ 2\\end{aligned}]{e}^{2t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}2 \\\\ 2\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNow, to find the values of ${c}_{1}$ and ${c}_{2}$, we substitute $t=0$ into the general solution:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}5 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}2 \\\\ 2\\end{aligned}]{e}^{0} & =[\\begin{aligned}5 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+2{c}_{2} \\\\ 2{c}_{2}\\end{aligned}] & =[\\begin{aligned}5 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have a system of linear equations\n\n$$\n{\\begin{aligned}{c}_{1}+2{c}_{2}=5 \\\\ 2{c}_{2}=1.\\end{aligned}\n$$\n\nFrom the second equation, we obtain \n\n$$\n{c}_{2}=\\frac{1}{2}.\n$$\n\nSubstituting this into the first equation, we obtain \n\n$$\n{c}_{1}+2\\cdot \\frac{1}{2}=5\\,⟹\\,{c}_{1}=4.\n$$\n\n \n\nTherefore, the solution for the initial value problem is\n\n$$\n\\begin{aligned}x(t) & =4\\cdot [\\begin{aligned}1 \\\\ 0\\end{aligned}]+\\frac{1}{2}\\cdot [\\begin{aligned}2 \\\\ 2\\end{aligned}]{e}^{2t} \\\\  & =[\\begin{aligned}4 \\\\ 0\\end{aligned}]+[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t}.\\end{aligned}\n$$\n\nFinally, we calculate $x(5)$:\n\n$$\n\\begin{aligned}x(5) & =[\\begin{aligned}4 \\\\ 0\\end{aligned}]+[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2\\cdot 5} \\\\  & =[\\begin{aligned}4 \\\\ 0\\end{aligned}]+[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{10} \\\\  & =[\\begin{aligned}4+{e}^{10} \\\\ {e}^{10}\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-79733/selection/dd584eab24ecb173800b54680b3447ba6cdb6263ca01b6625c85aaef5009898e" :answ