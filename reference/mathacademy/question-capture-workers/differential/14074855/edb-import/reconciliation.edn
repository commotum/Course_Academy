librium point (origin) is $\\text{a center}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074855/state.json" "file_sha256" "6adc22ae3dcffbfe6f82f7fadbaa81db5f7151f0edcc1c41881d7857ce24fbb5"} {"question" "q-334318" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074855/activity-metadata.json" "file_sha256" "e10af81c6d18ae6b4c97703723178066d14dbecd11dbb31144a68f1389db02fa"} {"question" "q-334318" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074855/state.json" "file_sha256" "6adc22ae3dcffbfe6f82f7fadbaa81db5f7151f0edcc1c41881d7857ce24fbb5"} {"question" "q-334318" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "\\text{Im}(\\lambda )<0"] ["math" "\\text{Im}(\\lambda )=0"] ["math" "\\text{Im}(\\lambda )>0"] ["math" "\\text{Re}(\\lambda )<0"] ["math" "\\text{Re}(\\lambda )=0"] ["math" "\\text{Re}(\\lambda )>0"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074855/state.json" "file_sha256" "6adc22ae3dcffbfe6f82f7fadbaa81db5f7151f0edcc1c41881d7857ce24fbb5"} {"question" "q-334318" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\text{Re}(\\lambda )=0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074855/state.json" "file_sha256" "6adc22ae3dcffbfe6f82f7fadbaa81db5f7151f0edcc1c41881d7857ce24fbb5"} {"question" "q-334318" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "fi