#{[{:db/id #edb/ref 17592186361655 :knowledge-point/_questions [{:knowledge-point/id #uuid "152243fa-e0a5-551d-92d9-b470789087c7" :knowledge-point/title "Expressing the Inverse of a Matrix as a Linear Combination of Its Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c7b08d2-6aa3-571d-bce0-f9f5b6834e5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{24}I+\\frac{1}{12}A-\\frac{1}{24}{A}^{2}" :db/id #edb/ref 17592186361657} {:answer/id #uuid "e7e22241-9ebb-5abe-926d-904c3d94a437" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{24}I-\\frac{1}{6}A+\\frac{1}{24}{A}^{2}" :db/id #edb/ref 17592186361658} {:answer/id #uuid "16023665-e33b-5d9a-afa5-f419d0d7b5de" :answer/type {:db/ident :answer.type/math} :answer/value "24I+\\frac{1}{12}A+\\frac{1}{6}{A}^{2}" :db/id #edb/ref 17592186361659} {:answer/id #uuid "8b85c38f-37a1-53a0-b59f-11216cdc771e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{24}I+\\frac{1}{12}A+\\frac{1}{12}{A}^{2}" :db/id #edb/ref 17592186361660} {:answer/id #uuid "64c0d39d-9c35-5ced-96c0-3594d2ccc28b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{12}I+\\frac{1}{3}A-\\frac{1}{24}{A}^{2}" :db/id #edb/ref 17592186361661}] :answer-field/correct {:answer/id #uuid "9c7b08d2-6aa3-571d-bce0-f9f5b6834e5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{24}I+\\frac{1}{12}A-\\frac{1}{24}{A}^{2}" :db/id #edb/ref 17592186361657} :answer-field/id #uuid "846946f0-267b-5b49-9625-b464e537521c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361656}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b7a4964c-4a39-54df-8b48-fb778fd1712f" :question/math-academy-id "q-140531" :question/problem "If $A=[\\begin{aligned}3 & -2 & -2 \\\\ 0 & 2 & 1 \\\\ 0 & 2 & -3\\end{aligned}],$ then ${A}^{-1}=$" :question/worked-solution "Let's find the characteristic equation $\\text{det}(A-\\lambda I)=0:$\n\n$$\n\\begin{aligned}\\text{det}(A-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & -2 & -2 \\\\ 0 & 2-\\lambda  & 1 \\\\ 0 & 2 & -3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )|\\begin{aligned}2-\\lambda  & 1 \\\\ 2 & -3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )((2-\\lambda )(-3-\\lambda )-2) & =0 \\\\ (3-\\lambda )({\\lambda }^{2}+\\lambda -8) & =0 \\\\ {\\lambda }^{3}-2{\\lambda }^{2}-11\\lambda +24 & =0\\end{aligned}\n$$\n\nUsing the Cayley-Hamilton theorem, we have that\n\n$$\n\\begin{aligned}{A}^{3}-2{A}^{2}-11A+24I & =O.\\end{aligned}\n$$\n\nSince $A$ is invertible, we can multiply this equation by ${A}^{-1}:$\n\n$$\n\\begin{aligned}{A}^{-1}({A}^{3}-2{A}^{2}-11A+24I) & =O \\\\ {A}^{2}-2A-11I+24{A}^{-1} & =O \\\\ 24{A}^{-1} & =11I+2A-{A}^{2} \\\\ {A}^{-1} & =\\frac{11}{24}I+\\frac{1}{12}A-\\frac{1}{24}{A}^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186125056 :knowledge-point/_questions [{:knowledge-point/id #uuid "b2867571-c1ae-5ea0-b784-22f444c8db38" :knowledge-point/title "Expressing a Power of a Matrix as a Linear Combination of Smaller Powers"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a173e5ae-9eb8-5760-b521-013a149f20bf" :answer/type {:db/ident :answer.type/math} :answer/value "-2A^{2} - A" :db/id #edb/ref 17592186123359} {:answer/id #uuid "bf49fa25-1ee9-52d5-bd11-6ce0f81d247c" :answer/type {:db/ident :answer.type/math} :answer/value "-2A^{2} - I" :db/id #edb/ref 17592186123360} {:answer/id #uuid "c99d75d8-f575-5589-9103-a61e4585d8ed" :answer/type {:db/ident :answer.type/math} :answer/value "2A - I" :db/id #edb/ref 17592186123361} {:answer/id #uuid "db25d64d-a845-56f6-86ae-6bf7780e22e1" :answer/type {:db/ident :answer.type/math} :answer/value "-2A - I" :db/id #edb/ref 17592186123362} {:answer/id #uuid "df6a7377-9668-54d3-a708-c897eeecfbc5" :answer/type {:db/ident :answer.type/math} :answer/value "-2A + A^{2}" :db/id #edb/ref 175921861