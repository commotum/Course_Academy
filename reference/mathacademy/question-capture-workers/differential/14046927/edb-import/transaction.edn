-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-333253/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-333253/field-3/fba3f071a3bf374a14af37c3a2bf03fdd1045070379d4ec39535030fd010d58a" :answer/id #uuid "b7ade2fe-bd58-5fc2-9c0f-308506aeb6d2" :answer/type :answer.type/math :answer/value "\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "q-333253/field-3/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d" :answer/id #uuid "f0bb1ba4-d719-562d-b3d2-c74047a5dab4" :answer/type :answer.type/math :answer/value "\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "q-333253/field-3/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "2c12a732-074b-5e12-af30-ac0e619be245" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-333253/field-3" :answer-field/id #uuid "7f600abe-3dfa-5b61-bc69-677f6f08e1db" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-333253/field-3/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer-field/choices ["q-333253/field-3/fba3f071a3bf374a14af37c3a2bf03fdd1045070379d4ec39535030fd010d58a" "q-333253/field-3/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d" "q-333253/field-3/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf"] :db/ensure [:answer-field/validate]} {:db/id "q-333253/field-4/6273a1ce826479f6324c67b6111789f3a2ae7f61836a9bf7e56848eb8a1214e1" :answer/id #uuid "ef7493e0-9b4f-5189-a353-38ff7b99a70c" :answer/type :answer.type/math :answer/value "\\frac{14}{5}" :db/ensure [:answer/validate]} {:db/id "q-333253/field-4/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" :answer/id #uuid "31546c40-3dab-5446-9482-df29888fcc8d" :answer/type :answer.type/math :answer/value "\\frac{17}{4}" :db/ensure [:answer/validate]} {:db/id "q-333253/field-4/843cac81a39ec420eeda5b659ca0c95fca768adb954c51387f58e06c289a039c" :answer/id #uuid "daed453c-d8b6-5dff-b4aa-9f8240fb6f2f" :answer/type :answer.type/math :answer/value "-\\frac{17}{4}" :db/ensure [:answer/validate]} {:db/id "q-333253/field-4" :answer-field/id #uuid "c9e49bec-e7d1-56d6-b5ff-690c6e50b8b0" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-333253/field-4/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" :answer-field/choices ["q-333253/field-4/6273a1ce826479f6324c67b6111789f3a2ae7f61836a9bf7e56848eb8a1214e1" "q-333253/field-4/c0c9fe5b5e67591ea1a9a278e613c7db3f4b1066f6b217a6dd18b8063d756111" "q-333253/field-4/843cac81a39ec420eeda5b659ca0c95fca768adb954c51387f58e06c289a039c"] :db/ensure [:answer-field/validate]} {:db/id "q-333253" :question/id #uuid "39bcdfb2-be47-54b2-9a32-ca091c822b62" :question/math-academy-id "q-333253" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=3{x}^{2}-2y,\\,y(0)=0\n$$\n\nWe wish to approximate the solution using the $2$-Step Adams-Bashforth-Moulton method. Given that the step size is $Δx=1,$ and that one preliminary step has already been computed using the Runge-Kutta method, complete the next row of the table below.\n\n*Hint: The corrector equation of the two-step Adams-Bashforth-Moulton method is defined as*\n\n$$\nΔy=\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx\n$$\n\n*where ${y}_{p}$ denotes the predictor at the current step, and ${y}_{-1}^{′}$ is the estimated slope at the previous point.* \n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $-$ | $-$ | $-$ | $\\frac{3}{4}$ |\n| $1$ | $\\frac{3}{4}$ | $\\frac{3}{2}$ | $\\frac{9}{4}$ | {{field-1}} | {{field-2}} | {{field-3}} |\n\nTherefore, $y(2)≈$ {{field-4}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe $2$-Step Adams-Bashforth-Moulton (ABM2) Method with step size $Δx$ is given by\n\n$$\n\\begin{aligned}\\text{Predictor} & : & Δ{y}_{p} & =\\frac{1}{2}(3{y}^{′}-{y}_{-1}^{′})\\cdot Δx, \\\\ \\text{Corrector} & : & Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx,\\end{aligned}\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the current point $(x,y),$\n\n- ${y}_{-1}^{′}=f({x}_{-1},{y}_{-1})$ is the estimated slope at the previous point (${x}_{-1},{y}_{-1}),$ and\n\n- ${y}_{p}^{′}=f({x}_{\\text{new}},{y}_{p})$ is the estimated slope at the predicted new point $({x}_{\\text{new}},{y}_{p})=(x+Δx,y+Δ{y}_{p}).$\n\nFrom the second row of the partially filled table, we have that $y(1)≈\\frac{3}{4},$ where the predicted $y$-increment is $Δ{y}_{p}=\\frac{9}{4}.$\n\nSo, the coordinates of the predicted new point given by the predictor equation are\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx=1+1=2, \\\\ {y}_{p} & =y+Δ{y}_{p}=\\frac{3}{4}+\\frac{9}{4}=3.\\end{aligned}\n$$\n\nLet's add the second value to the table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $-$ | $-$ | $-$ | $\\frac{3}{4}$ |\n| $1$ | $\\frac{3}{4}$ | $\\frac{3}{2}$ | $\\frac{9}{4}$ | $3$ |  |  |\n\nHence, the slope at this predicted point is\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =3{x}_{\\text{new}}^{2}-2{y}_{p} \\\\  & =3({2}^{2})-2(3) \\\\  & =6.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $-$ | $-$ | $-$ | $\\frac{3}{4}$ |\n| $1$ | $\\frac{3}{4}$ | $\\frac{3}{2}$ | $\\frac{9}{4}$ | $3$ | $6$ |  |\n\nAlso from the table, we note the following:\n\n- From the second row, the slope at the current point $(x,y)=(1,\\frac{3}{4})$ is ${y}^{′}=\\frac{3}{2}.$\n\n- From the first row, the slope at the previous point $({x}_{-1},{y}_{-1})=(0,0)$ is ${y}_{-1}^{′}=0.$\n\nFinally, we compute $Δy$ using the corrector equation:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx \\\\  & =\\frac{1}{12}(5\\cdot 6+8\\cdot \\frac{3}{2}-0)\\cdot 1 \\\\  & =\\frac{1}{12}\\cdot 42 \\\\  & =\\frac{7}{2}\\end{aligned}\n$$\n\nTherefore, the completed row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $-$ | $-$ | $-$ | $\\frac{3}{4}$ |\n| $1$ | $\\frac{3}{4}$ | $\\frac{3}{2}$ | $\\frac{9}{4}$ | $3$ | $6$ | $\\frac{7}{2}$ |\n\nThe value of $x$ in the next row is ${x}_{\\text{new}}=2.$ To get the value of $y$ in the next row, we add $Δy$ to $y:$\n\n$$\n{y}_{\\text{new}}=y+Δy=\\frac{3}{4}+\\frac{7}{2}=\\frac{17}{4}\n$$\n\nAdding these results to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $-$ | $-$ | $-$ | $\\frac{3}{4}$ |\n| $1$ | $\\frac{3}{4}$ | $\\frac{3}{2}$ | $\\frac{9}{4}$ | $3$ | $6$ | $\\frac{7}{2}$ |\n| $2$ | $\\frac{17}{4}$ |  |  |  |  |  |\n\nTherefore, we conclude that $y(2)≈\\frac{17}{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333253/field-1" "q-333253/field-2" "q-333253/field-3" "q-333253/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f5aefa9-a83c-5203-8b73-c96b5f7df6bf"] :knowledge-point/questions ["q-333253"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333372/field-1/89e34329534b6ee904fc166b9ee2a8f587c79161a7c80fc821ab136e40774c36" :answer/id #uuid "cb656d8c-15f7-5069-9057-a9b493c6840d" :answer/type :answer.type/math :answer/value "-\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "q-333372/field-1/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225" :answer/id #uuid "670