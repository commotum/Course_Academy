3932a" "q-333372/field-5/addfd31cdb9de64534881530c982c7f179868619b602d7d66e6763d763ff460b"] :db/ensure [:answer-field/validate]} {:db/id "q-333372/field-6/ac46572169135c39bc2dc1bfb75349ed12f60a1187a3ef59cacec084b49d12ff" :answer/id #uuid "0decacc4-9769-5894-9af4-132851e83136" :answer/type :answer.type/math :answer/value "-23" :db/ensure [:answer/validate]} {:db/id "q-333372/field-6/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" :answer/id #uuid "ddedd4d2-461e-55a5-b5f9-d99132f65500" :answer/type :answer.type/math :answer/value "-22" :db/ensure [:answer/validate]} {:db/id "q-333372/field-6/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer/id #uuid "257595f4-6b06-5c17-88be-ecf66a41557f" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "q-333372/field-6" :answer-field/id #uuid "67d1fa0d-f6b4-54b7-a9eb-be7688652894" :answer-field/key "field-6" :answer-field/type :answer-field.type/select :answer-field/correct "q-333372/field-6/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer-field/choices ["q-333372/field-6/ac46572169135c39bc2dc1bfb75349ed12f60a1187a3ef59cacec084b49d12ff" "q-333372/field-6/b556bb502f914dc4fab0f40312f13f23b29e033ef49212306202180f04718e6f" "q-333372/field-6/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a"] :db/ensure [:answer-field/validate]} {:db/id "q-333372" :question/id #uuid "f13b4a99-dce9-5580-a41e-0ab6ba4e3ed7" :question/math-academy-id "q-333372" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2xy,\\,y(0)=-1\n$$\n\nWe wish to approximate the solution using the $2$-step Adams-Bashforth-Moulton method. Given that the step size is $Δx=1,$ and that one preliminary step has already been computed using the Runge-Kutta method, complete the next row of the table below.\n\n*Hint: The corrector equation of the two-step Adams-Bashforth-Moulton method is defined as*\n\n$$\nΔy=\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx\n$$\n\n*where ${y}_{p}$ denotes the predictor at the current step, and ${y}_{-1}^{′}$ is the estimated slope at the previous point.* \n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $0$ | $-$ | $-$ | $-$ | $-\\frac{5}{3}$ |\n| $1$ | $-\\frac{8}{3}$ | {{field-1}} | {{field-2}} | {{field-3}} | {{field-4}} | {{field-5}} |\n\nTherefore, $y(2)≈$\n  {{field-6}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe $2$-Step Adams-Bashforth-Moulton (ABM2) method with step size $Δx$ is given by\n\n$$\n\\begin{aligned}\\text{Predictor} & : & Δ{y}_{p} & =\\frac{1}{2}(3{y}^{′}-{y}_{-1}^{′})\\cdot Δx, \\\\ \\text{Corrector} & : & Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx,\\end{aligned}\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the current point $(x,y),$\n\n- ${y}_{-1}^{′}=f({x}_{-1},{y}_{-1})$ is the estimated slope at the previous point (${x}_{-1},{y}_{-1}),$ and\n\n- ${y}_{p}^{′}=f({x}_{\\text{new}},{y}_{p})$ is the estimated slope at the predicted new point $({x}_{\\text{new}},{y}_{p})=(x+Δx,y+Δ{y}_{p}).$\n\nWe're told that the first step is calculated using the Runge-Kutta Method, resulting in \n\n$$\ny(1)≈-\\frac{8}{3}.\n$$\n\nNow, we'll continue from this point, using the $2$-step ABM method.\n\nFirst, we compute the value of ${y}^{′}$ according to the given rule:\n\n$$\n\\begin{aligned}{y}^{′} & =2xy \\\\  & =2\\cdot 1\\cdot (-\\frac{8}{3}) \\\\  & =-\\frac{16}{3}\\end{aligned}\n$$\n\nSo, we add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $0$ | $-$ | $-$ | $-$ | $-\\frac{5}{3}$ |\n| $1$ | $-\\frac{8}{3}$ | $-\\frac{16}{3}$ |  |  |  |  |\n\nFrom the first row of the table, we see that the slope at the previous point $({x}_{-1},{y}_{-1})=(0,-1)$ is ${y}_{-1}^{′}=0.$\n\nNext, we compute $Δ{y}_{p}$ using the predictor equation:\n\n$$\n\\begin{aligned}Δ{y}_{p} & =\\frac{1}{2}(3{y}^{′}-{y}_{-1}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(3\\cdot (-\\frac{16}{3})-0)\\cdot 1 \\\\  & =-8\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $0$ | $-$ | $-$ | $-$ | $-\\frac{5}{3}$ |\n| $1$ | $-\\frac{8}{3}$ | $-\\frac{16}{3}$ | $-8$ |  |  |  |\n\nSo, the coordinates of the predicted new point are\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx=1+1=2, \\\\ {y}_{p} & =y+Δ{y}_{p}=-\\frac{8}{3}+(-8)=-\\frac{32}{3}.\\end{aligned}\n$$\n\nLet's add the second value to the table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $0$ | $-$ | $-$ | $-$ | $-\\frac{5}{3}$ |\n| $1$ | $-\\frac{8}{3}$ | $-\\frac{16}{3}$ | $-8$ | $-\\frac{32}{3}$ |  |  |\n\nHence, the slope at this predicted point is\n\n$$\n\\begin{aligned}{y}_{p}^{′} & =2{x}_{\\text{new}}{y}_{p} \\\\  & =2\\cdot 2\\cdot (-\\frac{32}{3}) \\\\  & =-\\frac{128}{3}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $0$ | $-$ | $-$ | $-$ | $-\\frac{5}{3}$ |\n| $1$ | $-\\frac{8}{3}$ | $-\\frac{16}{3}$ | $-8$ | $-\\frac{32}{3}$ | $-\\frac{128}{3}$ |  |\n\nFinally, we compute $Δy$ using the corrector equation:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{12}(5{y}_{p}^{′}+8{y}^{′}-{y}_{-1}^{′})\\cdot Δx \\\\  & =\\frac{1}{12}(5\\cdot (-\\frac{128}{3})+8\\cdot (-\\frac{16}{3})-0)\\cdot 1 \\\\  & =\\frac{1}{12}\\cdot (-256) \\\\  & =-\\frac{64}{3}\\end{aligned}\n$$\n\nTherefore, the completed row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $0$ | $-$ | $-$ | $-$ | $-\\frac{5}{3}$ |\n| $1$ | $-\\frac{8}{3}$ | $-\\frac{16}{3}$ | $-8$ | $-\\frac{32}{3}$ | $-\\frac{128}{3}$ | $-\\frac{64}{3}$ |\n\nThe value of $x$ in the next row is ${x}_{\\text{new}}=2.$ To get the value of $y$ in the next row, we add $Δy$ to $y:$\n\n$$\n{y}_{\\text{new}}=y+Δy=-\\frac{8}{3}+(-\\frac{64}{3})=-24\n$$\n\nAdding these results to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $Δ{y}_{p}$ | ${y}_{p}$ | ${y}_{p}^{′}$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $-1$ | $0$ | $-$ | $-$ | $-$ | $-\\frac{5}{3}$ |\n| $1$ | $-\\frac{8}{3}$ | $-\\frac{16}{3}$ | $-8$ | $-\\frac{32}{3}$ | $-\\frac{128}{3}$ | $-\\frac{64}{3}$ |\n| $2$ | $-24$ |  |  |  |  |  |\n\nTherefore, we conclude that $y(2)≈-24.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-333372/field-1" "q-333372/field-2" "q-333372/field-3" "q-333372/field-4" "q-333372/field-5" "q-333372/field-6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7f5aefa9-a83c-5203-8b73-c96b5f7df6bf"] :knowledge-point/questions ["q-333372"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333375/field-1/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "18f29e72-a240-5743-a15c-fbf6d9937243" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-333375/field-1/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer/id #uuid "86044bfc-32eb-59dd-a199-fb27d8c225e1" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-333375/field-1/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "192a1c8f-d922-5134-8c3e-4f224e1f4543" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {: