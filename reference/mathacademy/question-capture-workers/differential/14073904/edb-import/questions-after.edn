#{[{:db/id #edb/ref 17592186379839 :knowledge-point/_questions [{:knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec" :knowledge-point/title "Finding General Solutions When the Characteristic Equation Has Repeated Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dacfa8f9-ee01-5716-b46c-38a00fd48b57" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+Bx{e}^{-4x}" :db/id #edb/ref 17592186379841} {:answer/id #uuid "88f41d5d-6895-514b-9a6c-265cfbb4088a" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+Bx{e}^{2x}" :db/id #edb/ref 17592186379842} {:answer/id #uuid "f8802213-390b-5cca-b60f-23a3cf11b0a4" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+B{e}^{4x}" :db/id #edb/ref 17592186379843} {:answer/id #uuid "918066e9-ec8a-5ac5-8b0d-a8981083fe2c" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+Bx{e}^{4x}" :db/id #edb/ref 17592186379844} {:answer/id #uuid "39b2753b-c963-5d15-a0b4-ef612a6b6d8f" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+B{e}^{2x}" :db/id #edb/ref 17592186379845}] :answer-field/correct {:answer/id #uuid "dacfa8f9-ee01-5716-b46c-38a00fd48b57" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-4x}+Bx{e}^{-4x}" :db/id #edb/ref 17592186379841} :answer-field/id #uuid "bb0d73c3-5159-59d1-8fd5-b662d42299ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379840}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "761373ce-d954-5d76-9a67-40f1770a46d8" :question/math-academy-id "q-7793" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+8\\frac{\\text{d}y}{\\text{d}x}+16y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+8\\lambda {e}^{\\lambda x}+16{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+8\\lambda +16) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+8\\lambda +16=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda +4)(\\lambda +4) & =0 \\\\ (\\lambda +4)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =-4$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{-4x}+Bx{e}^{-4x}.\n$$"}] [{:db/id #edb/ref 17592186379846 :knowledge-point/_questions [{:knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec" :knowledge-point/title "Finding General Solutions When the Characteristic Equation Has Repeated Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01d523ef-efb6-5035-a445-cc2a22612fc2" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{5x/2}+Bx{e}^{5x/2}" :db/id #edb/ref 17592186379848} {:answer/id #uuid "091871f7-c8c2-5a08-945d-623e0888b32d" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{3x/2}+Bx{e}^{3x/2}" :db/id #edb/ref 17592186379849} {:answer/id #uuid "dc691259-a0bc-5d29-ae27-250241d9b544" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{5x}+B{e}^{5x/2}" :db/id #edb/ref 17592186379850} {:answer/id #uuid "68f83c05-700d-51c1-9f03-c0955d5c9fe1" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{5x}+B{e}^{x/2}" :db/id #edb/ref 17592186379851} {:answer/id #uuid "d588da2a-5428-5a50-aaeb-9d11c53f82ce" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{5x/2}+Bx{e}^{-5x/2}" :db/id #edb/ref 17592186379852}] :answer-field/correct {:answer/id #uuid "01d523ef-efb6-5035-a445-cc2a22612fc2" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{5x/2}+Bx{e}^{5x/2}" :db/id #edb/ref 17592186379848} :answer-field/id #uuid "c6427230-c196-5de4-8fc6-a8eafec4c3c7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379847}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f3fe741c-cba4-5f31-a5e9-65fb13c5f83f" :question/math-academy-id "q-7796" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-5\\frac{\\text{d}y}{\\text{d}x}+\\frac{25y}{4}=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-5\\lambda {e}^{\\lambda x}+\\frac{25}{4}{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-5\\lambda +\\frac{25}{4}) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-5\\lambda +\\frac{25}{4}=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda -\\frac{5}{2})(\\lambda -\\frac{5}{2}) & =0 \\\\ {(\\lambda -\\frac{5}{2})}^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =\\frac{5}{2}$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{5x/2}+Bx{e}^{5x/2}.\n$$"}] [{:db/id #edb/ref 17592186379853 :knowledge-point/_questions [{:knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec" :knowledge-point/title "Finding General Solutions When the Characteristic Equation Has Repeated Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8eebe685-4a07-5834-a522-c34f90d5e144" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{7x}+Bx{e}^{7x}" :db/id #edb/ref 17592186379855} {:answer/id #uuid "9f2fad6b-8a46-5ad0-a43e-abc1bf01ba13" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{14x}+Bx{e}^{14x}" :db/id #edb/ref 17592186379856} {:answer/id #uuid "e46a9e0d-46a9-57e7-887c-c8b8a2d180ba" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{7x}+B{e}^{-7x}" :db/id #edb/ref 17592186379857} {:answer/id #uuid "e09c0bae-f728-5e8e-aefe-d293386bf0ab" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-7x}+B{e}^{2x}" :db/id #edb/ref 17592186379858} {:answer/id #uuid "ee747339-5773-5dbe-82df-92b150112545" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{-7x}+Bx{e}^{-7x}" :db/id #edb/ref 17592186379859}] :answer-field/correct {:answer/id #uuid "8eebe685-4a07-5834-a522-c34f90d5e144" :answer/type {:db/ident :answer.type/math} :answer/value "y=A{e}^{7x}+Bx{e}^{7x}" :db/id #edb/ref 17592186379855} :answer-field/id #uuid "07b68d39-6e78-57dc-9ba0-56e989bac24e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379854}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "737972f8-5b03-5be4-8576-91a613befa09" :question/math-academy-id "q-90958" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-14\\frac{\\text{d}y}{\\text{d}x}+49y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-14\\lambda {e}^{\\lambda x}+49{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-14\\lambda +49) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-14\\lambda +49=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda -7)(\\lambda -7) & =0 \\\\ (\\lambda -7)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =7$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{7x}+Bx{e}^{7x}.\n$$"}] [{:db/id #edb/ref 17592186379860 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ad20bb-c6a4-5390-a11a-e5277cfd1667" :knowledge-point/title "Identifying Non-Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "01212f94-c28e-551b-b234-15745b2af8a8" :answer/type {:db/ident :answer.type/math} :answer/value "8{e}^{-3x/2}-3x{e}^{-3x/2}" :db/id #edb/ref 17592186379862} {:answer/id #uuid "c53afb34-e362-5f7d-a28c-0e2fe9e7ba74" :answer/type {:db/ident :answer.type/math} :answer/value "2x{e}^{-3x/2}" :db/id #edb/ref 17592186379863} {:answer/id #uuid "9c9f780d-09e0-50fb-953d-191a31331823" :answer/type {:db/ident :answer.type/math} :answer/value "x{e}^{-3x/2}-3{x}^{2}{e}^{-3x/2}" :db/id #edb/ref 17592186379864} {:answer/id #uuid "b724f176-6ecf-5109-abbc-4ede71c24472" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-3x/2}" :db/id #edb/ref 17592186379865} {:answer/id #uuid "ac6e7f21-4497-5431-82cd-4bde85e0f2c1" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{-3x/2}+x{e}^{-3x/2}" :db/id #edb/ref 17592186379866}] :answer-field/correct {:answer/id #uuid "9c9f780d-09e0-50fb-953d-191a31331823" :answer/type {:db/ident :answer.type/math} :answer/value "x{e}^{-3x/2}-3{x}^{2}{e}^{-3x/2}" :db/id #edb/ref 17592186379864} :answer-field/id #uuid "d2d588e1-f81d-529c-8085-6d681afa8b44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379861}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "da67980d-2aed-51d8-92a4-0f5a69c4f7f8" :question/math-academy-id "q-90964" :question/problem "Given the equation ${y}^{″}+3{y}^{′}+\\frac{9}{4}y=0$ for $y=y(x),$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+3\\lambda {e}^{\\lambda x}+\\frac{9}{4}{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+3\\lambda +\\frac{9}{4}) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}+3\\lambda +\\frac{9}{4} & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n\\begin{aligned}{(\\lambda +\\frac{3}{2})}^{2} & =0\\end{aligned}\n$$\n\nand so $\\lambda =-\\frac{3}{2}$ is a repeated root of the auxiliary equation.\n\nTherefore, any linear combination of the functions ${e}^{-3x/2}$ and $x{e}^{-3x/2}$ is a solution to the original differential equation. \n\nAmong the given options, only $x{e}^{-3x/2}-3{x}^{2}{e}^{-3x/2}$ is not a solution."}] [{:db/id #edb/ref 17592186379867 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4ad20bb-c6a4-5390-a11a-e5277cfd1667" :knowledge-point/title "Identifying Non-Solutions of Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c1c1090-259e-5daa-9901-295e9ecedbcb" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{8x}+2x{e}^{8x}" :db/id #edb/ref 17592186379869} {:answer/id #uuid "66c6c3de-1dce-5f5d-bfec-3dca532696ae" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{8x}-x{e}^{8x}" :db/id #edb/ref 17592186379870} {:answer/id #uuid "9c7c1f4c-2a0e-583f-80ca-190f6f9ad206" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{8x}" :db/id #edb/ref 17592186379871} {:answer/id #uuid "f02dd178-08d6-5d24-841b-2fed48d0c76a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}{e}^{8x}" :db/id #edb/ref 17592186379872} {:answer/id #uuid "e3201b11-407a-50f7-8db9-8d155d0dfa03" :answer/type {:db/ident :answer.type/math} :answer/value "-2x{e}^{8x}" :db/id #edb/ref 17592186379873}] :answer-field/correct {:answer/id #uuid "f02dd178-08d6-5d24-841b-2fed48d0c76a" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}{e}^{8x}" :db/id #edb/ref 17592186379872} :answer-field/id #uuid "fe7af11e-c46b-5752-8048-022210ff7b9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379868}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "55caafa4-33d6-5292-85be-7e2f3497a749" :question/math-academy-id "q-90966" :question/problem "Given the equation ${y}^{″}-16{y}^{′}+64y=0$ for $y=y(x),$ which of the following is **not** a solution to this equation?" :question/worked-solution "Assuming $y={e}^{\\lambda x}$ and differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {e}^{\\lambda x},\\,{y}^{″}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-16\\lambda {e}^{\\lambda x}+64{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-16\\lambda +64) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n\\begin{aligned}{\\lambda }^{2}-16\\lambda +64 & =0.\\end{aligned}\n$$\n\nFactoring the auxiliary equation results in\n\n$$\n\\begin{aligned}{(\\lambda -8)}^{2} & =0\\end{aligned}\n$$\n\nand so $\\lambda =8$ is a repeated root of the auxiliary equation.\n\nTherefore, any linear combination of the functions ${e}^{8x}$ and $x{e}^{8x}$ is a solution to the original differential equation. \n\nAmong the given options, only ${x}^{2}{e}^{8x}$ is not a solution."}]}
