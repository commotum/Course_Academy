[{:db/id "q-7793/selection/3c627b9e826a73a3508766253460720c80f2054076e3fef73cf2c9dbc3ec2a1b" :answer/id #uuid "dacfa8f9-ee01-5716-b46c-38a00fd48b57" :answer/type :answer.type/math :answer/value "y=A{e}^{-4x}+Bx{e}^{-4x}" :db/ensure [:answer/validate]} {:db/id "q-7793/selection/a33c5dda0af097ae9102c21e95d88052238584a2ba8de2ba0f51c33ed945f5f6" :answer/id #uuid "88f41d5d-6895-514b-9a6c-265cfbb4088a" :answer/type :answer.type/math :answer/value "y=A{e}^{-4x}+Bx{e}^{2x}" :db/ensure [:answer/validate]} {:db/id "q-7793/selection/c5b828700d9445cabaa30b4fe0c0211c955c5feebd4c4db6bfc189ac934e4571" :answer/id #uuid "f8802213-390b-5cca-b60f-23a3cf11b0a4" :answer/type :answer.type/math :answer/value "y=A{e}^{-4x}+B{e}^{4x}" :db/ensure [:answer/validate]} {:db/id "q-7793/selection/e8aaecad0d823eed103e731e3829ee7db641e503570e37487c9fef27a7850980" :answer/id #uuid "39b2753b-c963-5d15-a0b4-ef612a6b6d8f" :answer/type :answer.type/math :answer/value "y=A{e}^{-4x}+B{e}^{2x}" :db/ensure [:answer/validate]} {:db/id "q-7793/selection/d2787094f1f9078427711ad3d54505801b7f147a360997e16fbe37c53f11614d" :answer/id #uuid "918066e9-ec8a-5ac5-8b0d-a8981083fe2c" :answer/type :answer.type/math :answer/value "y=A{e}^{-4x}+Bx{e}^{4x}" :db/ensure [:answer/validate]} {:db/id "q-7793/selection" :answer-field/id #uuid "bb0d73c3-5159-59d1-8fd5-b662d42299ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7793/selection/3c627b9e826a73a3508766253460720c80f2054076e3fef73cf2c9dbc3ec2a1b" :answer-field/choices ["q-7793/selection/3c627b9e826a73a3508766253460720c80f2054076e3fef73cf2c9dbc3ec2a1b" "q-7793/selection/a33c5dda0af097ae9102c21e95d88052238584a2ba8de2ba0f51c33ed945f5f6" "q-7793/selection/c5b828700d9445cabaa30b4fe0c0211c955c5feebd4c4db6bfc189ac934e4571" "q-7793/selection/e8aaecad0d823eed103e731e3829ee7db641e503570e37487c9fef27a7850980" "q-7793/selection/d2787094f1f9078427711ad3d54505801b7f147a360997e16fbe37c53f11614d"] :db/ensure [:answer-field/validate]} {:db/id "q-7793" :question/id #uuid "761373ce-d954-5d76-9a67-40f1770a46d8" :question/math-academy-id "q-7793" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+8\\frac{\\text{d}y}{\\text{d}x}+16y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+8\\lambda {e}^{\\lambda x}+16{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+8\\lambda +16) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+8\\lambda +16=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda +4)(\\lambda +4) & =0 \\\\ (\\lambda +4)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =-4$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{-4x}+Bx{e}^{-4x}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7793/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec"] :knowledge-point/questions ["q-7793"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7796/selection/ea4016f1daa8cbd0e0bf85e565095f43e930f7402c7022674752ac6152f86a5d" :answer/id #uuid "d588da2a-5428-5a50-aaeb-9d11c53f82ce" :answer/type :answer.type/math :answer/value "y=A{e}^{5x/2}+Bx{e}^{-5x/2}" :db/ensure [:answer/validate]} {:db/id "q-7796/selection/61336faa696cf70a569620157a0b61e86b5cdb41fc5c787090c83c52602d662e" :answer/id #uuid "dc691259-a0bc-5d29-ae27-250241d9b544" :answer/type :answer.type/math :answer/value "y=A{e}^{5x}+B{e}^{5x/2}" :db/ensure [:answer/validate]} {:db/id "q-7796/selection/c2d12f36d80d0ff5446e783c2b50a4c0634404d1beac4779cdda25d064