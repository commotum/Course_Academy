33744/edb-import/verification.json"} {"question" "q-79200" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$x=-3$ and $x=4$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033744/state.json" "file_sha256" "6c2bf8a0e8598354823824dae50583b0644f0ae6afe93a13b3b022abdacc2df8" "basis" 1233 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033744/edb-import/verification.json"} {"question" "q-79200" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$x=-3,$ $x=0,$ and $x=4$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033744/state.json" "file_sha256" "6c2bf8a0e8598354823824dae50583b0644f0ae6afe93a13b3b022abdacc2df8" "basis" 1233 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033744/edb-import/verification.json"} {"question" "q-79200" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$x=-3$ and $x=4$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033744/state.json" "file_sha256" "6c2bf8a0e8598354823824dae50583b0644f0ae6afe93a13b3b022abdacc2df8" "basis" 1233 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033744/edb-import/verification.json"} {"question" "q-21035" "field" nil "attribute" "question/problem" "value" "Find the $x$-coordinate of the point of inflection for $f(x)=12x-7+\\frac{3}{x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" nil "attribute" "question/worked-solution" "value" "For continuous, twice-differentiable functions, we can determine possible points of inflection by solving the equation ${f}^{″}(x)=0.$ However, we must be sure to check that the concavity does indeed change at whatever points we find.\n\nFirst, we calculate the second derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =12-\\frac{3}{{x}^{2}} \\\\ {f}^{″}(x) & =\\frac{6}{{x}^{3}}\\end{aligned}\n$$\n\nNext, we solve ${f}^{″}(x)=0:$ \n\n$$\n\\frac{6}{{x}^{3}}=0\n$$\n\nThe equation above has no real solutions, so there are no points of inflection." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/activity-metadata.json" "file_sha256" "814c19e51d37a9c9f69a55428cd1cb7bf2793818f57cd8d02c50fdbd1af6807e" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=-4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=3"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "x=4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"} {"question" "q-21035" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "There are no points of inflection"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/state.json" "file_sha256" "c879fecd06cffc5b43ab2030f581fd917f356896b4b27d5e796c6255203792a1" "basis" 1417 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040224/edb-import/verification.json"}] "sources" [{"question" "q-21034" "field" nil "attribute" "question/problem" "value" "Find the $x$-coordinate of the point of inflection for $f(x)={x}^{3}+3{x}^{2}-3x-12.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070683/state.json" "file_sha256" "a6e33a44bcbe3259e2679c784c8e9e566efcbd1da06c3ccd0ba85d0cbcdd545d"} {"question" "q-21034" "field" nil "attribute" "question/worked-solution" "value" "For continuous, twice-differentiable functions, we can determine possible points of inflection by solving the equation ${f}^{″}(x)=0.$ However, we must be sure to check that the concavity does indeed change at whatever points we find.\n\nFirst, we calculate the second derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =3{x}^{2}+6x-3 \\\\ {f}^{″}(x) & =6x+6\\end{aligned}\n$$\n\nNext, we solve ${f}^{″}(x)=0,$ and get\n\n$$\n6x+6=0\\,⟹\\,x=-1.\n$$\n\nFinally, we need to check if the concavity changes at $x=-1.$ So, we pick two points around it, say, $x=-2$ and $x=0$, and compute the sign of ${f}^{″}(x):$\n\n$$\n\\begin{aligned}{f}^{″}(-2) & =6(-2)+6=-6<0 \\\\ {f}^{″}(0) & =6(0)+6=6>0\\end{aligned}\n$$\n\n \n\nTherefore, since the concavity changes at $x=-1,$ we conclude that $x=-1$ is indeed a point of inflection." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070683/state.json" "file_sha256" "a6e33a44bcbe3259e2679c784c8e9e566efcbd1da06c3ccd0ba85d0cbcdd545d"} {"question" "q-21034" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070683/activity-metadata.json" "