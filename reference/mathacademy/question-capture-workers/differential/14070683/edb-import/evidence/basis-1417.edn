#{[{:db/id #edb/ref 17592186306050 :knowledge-point/_questions [{:knowledge-point/id #uuid "a363f215-ed40-504a-bcae-620b7d585678" :knowledge-point/title "Finding Points of Inflection Using Differentiation When Some Points Must Be Discarded"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adef789f-225b-5894-a8b9-5e11934c377c" :answer/type {:db/ident :answer.type/math} :answer/value "x=3" :db/id #edb/ref 17592186306052} {:answer/id #uuid "ee1fd109-16af-5879-bcfd-4d1366864d1f" :answer/type {:db/ident :answer.type/math} :answer/value "x=2" :db/id #edb/ref 17592186306053} {:answer/id #uuid "0cd4ab4f-95a1-5b0c-80a0-5c09c687f7aa" :answer/type {:db/ident :answer.type/math} :answer/value "x=4" :db/id #edb/ref 17592186306054} {:answer/id #uuid "abf597b9-e766-597c-b9d7-6faf4a80df03" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of inflection" :db/id #edb/ref 17592186306055} {:answer/id #uuid "6d418e2c-fc04-5c80-b390-b1fd8c7464a9" :answer/type {:db/ident :answer.type/math} :answer/value "x=-4" :db/id #edb/ref 17592186306056}] :answer-field/correct {:answer/id #uuid "abf597b9-e766-597c-b9d7-6faf4a80df03" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of inflection" :db/id #edb/ref 17592186306055} :answer-field/id #uuid "bc031990-69d2-56b3-825b-b891ab692887" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306051}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "80fd1b01-b4c3-5a42-879f-a9a61102a17e" :question/math-academy-id "q-21035" :question/problem "Find the $x$-coordinate of the point of inflection for $f(x)=12x-7+\\frac{3}{x}.$" :question/worked-solution "For continuous, twice-differentiable functions, we can determine possible points of inflection by solving the equation ${f}^{″}(x)=0.$ However, we must be sure to check that the concavity does indeed change at whatever points we find.\n\nFirst, we calculate the second derivative:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =12-\\frac{3}{{x}^{2}} \\\\ {f}^{″}(x) & =\\frac{6}{{x}^{3}}\\end{aligned}\n$$\n\nNext, we solve ${f}^{″}(x)=0:$ \n\n$$\n\\frac{6}{{x}^{3}}=0\n$$\n\nThe equation above has no real solutions, so there are no points of inflection."}]}
