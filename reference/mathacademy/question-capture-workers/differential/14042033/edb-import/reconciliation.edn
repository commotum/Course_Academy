′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nAll four sample slopes are already computed. So, we just need to find the increment on $y.$\n\nWe compute $Δy$ using the Runge-Kutta method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(2+2\\cdot \\frac{1}{2}+2\\cdot \\frac{5}{4}+(-\\frac{1}{4}))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{12}\\cdot \\frac{21}{4} \\\\  & =\\frac{7}{16}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $-1$ | $2$ | $\\frac{1}{2}$ | $\\frac{5}{4}$ | $-\\frac{1}{4}$ | $\\frac{7}{16}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =-1+\\frac{1}{2} \\\\  & =-\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =-1+\\frac{7}{16} \\\\  & =-\\frac{9}{16}.\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $-1$ | $2$ | $\\frac{1}{2}$ | $\\frac{5}{4}$ | $-\\frac{1}{4}$ | $\\frac{7}{16}$ |\n| $-\\frac{1}{2}$ | $-\\frac{9}{16}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y\\,(-\\frac{1}{2})≈-\\frac{9}{16}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-331416" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/activity-metadata.json" "file_sha256" "d91913132f5ad8ddbab789466955116612609a5b8d0d1ce1f7a4da1b009d6a4d"} {"question" "q-331416" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-331416" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{7}{16}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-331416" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-331416" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{9}{16}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330769" "field" nil "attribute" "question/problem" "value" "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x+y,\\,y(0)=2\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) Method. Complete the first row of the table below, given that the step size is $Δx=1.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $2$ | $4$ | $5$ | $9$ | {{field-1}} |\n\nTherefore, $y(1)≈$\n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330769" "field" nil "attribute" "question/worked-solution" "value" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nAll four sample slopes are already computed. So, we just need to find the increment on $y.$\n\nWe compute $Δy$ using the Runge-Kutta method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(2+2\\cdot 4+2\\cdot 5+9)\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot 29 \\\\  & =\\frac{29}{6}\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $2$ | $4$ | $5$ | $9$ | $\\frac{29}{6}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+1 \\\\  & =1 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =2+\\frac{29}{6} \\\\  & =\\frac{41}{6}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $2$ | $4$ | $5$ | $9$ | $\\frac{29}{6}$ |\n| $1$ | $\\frac{41}{6}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y(1)≈\\frac{41}{6}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330769" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/activity-metadata.json" "file_sha256" "d91913132f5ad8ddbab789466955116612609a5b8d0d1ce1f7a4da1b009d6a4d"} {"question" "q-330769" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330769" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{29}{6}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330769" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330769" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{41}{6}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330767" "field" nil "attribute" "question/problem" "value" "Consider the following initial value problem:\n\n$$\n{y}^{′}=x+y,\\,y(0)=1\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) Method. Complete the first row of the table below, given that the step size is $Δx=\\frac{1}{2}.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $1$ | $\\frac{3}{2}$ | $\\frac{13}{8}$ | $\\frac{37}{16}$ | {{field-1}} |\n\nTherefore, $y\\,(\\frac{1}{2})≈$\n{{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330767" "field" nil "attribute" "question/worked-solution" "value" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nAll four sample slopes are already computed. So, we just need to find the increment on $y.$\n\nWe compute $Δy$ using the Runge-Kutta method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(1+2\\cdot \\frac{3}{2}+2\\cdot \\frac{13}{8}+\\frac{37}{16})\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{12}\\cdot \\frac{153}{16} \\\\  & =\\frac{51}{64}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $1$ | $\\frac{3}{2}$ | $\\frac{13}{8}$ | $\\frac{37}{16}$ | $\\frac{51}{64}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+\\frac{1}{2} \\\\  & =\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =1+\\frac{51}{64} \\\\  & =\\frac{115}{64}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $1$ | $\\frac{3}{2}$ | $\\frac{13}{8}$ | $\\frac{37}{16}$ | $\\frac{51}{64}$ |\n| $\\frac{1}{2}$ | $\\frac{115}{64}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y\\,(\\frac{1}{2})≈\\frac{115}{64}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330767" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/activity-metadata.json" "file_sha256" "d91913132f5ad8ddbab789466955116612609a5b8d0d1ce1f7a4da1b009d6a4d"} {"question" "q-330767" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330767" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{51}{64}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330767" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-330767" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{115}{64}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-339800" "field" nil "attribute" "question/problem" "value" "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x+y,\\,y(1)=-1\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) method. Complete the table below, given that the step size is $Δx=1.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | {{field-1}} | {{field-2}} |\n| $2$ | {{field-3}} |  |  |  |  |  |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042033/state.json" "file_sha256" "e91f0265fbb56bac6f3defd32391a6887b7137fe74160344893f525a71cb361b"} {"question" "q-339800" "field" nil "attribute" "question/worked-solution" "value" "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nThe first three sample slopes, evaluated at the initial point and first intermediate points, are already computed. Now let's find the others.\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(1+1,\\,-1+\\frac{13}{4}\\cdot 1) \\\\  & =(2,\\frac{9}{4}).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =2{x}_{3}+{y}_{3} \\\\  & =2\\cdot 2+\\frac{9}{4} \\\\  & =\\frac{25}{4}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ |  |\n\nFinally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(1+2\\cdot \\frac{5}{2}+2\\cdot \\frac{13}{4}+\\frac{25}{4})\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot \\frac{75}{4} \\\\  & =\\frac{25}{8}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ | $\\frac{25}{8}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =1+1 \\\\  & =2 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =-1+\\frac{25}{8} \\\\  & =-\\frac{8}{8}+\\frac{25}{8} \\\\  & =\\frac{17}{8}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $1$ | $\\frac{5}{2}$ | $\\frac{13}{4}$ | $\\frac{25}{4}$ | $\\frac{25}{8}$ |\n| $2$ | $\\frac{17}{8}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y(2)≈\\frac{17}{8}.\\end{aligned}\n$$" "category" "ma_capture" "fi