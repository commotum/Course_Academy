7eea380690757236f1fd5b9e8d959b4cb54a7c77e8dd1b3c7b54c27" :answer/id #uuid "f60bf404-09ea-5a43-a305-166c5fb715ce" :answer/type :answer.type/math :answer/value "Δx" :db/ensure [:answer/validate]} {:db/id "q-330277/field-4/e7f3f847fb158d4d50df48097f16aeaf7f4100dedf0ac6815ac946a068da6e4f" :answer/id #uuid "f1d32829-cb18-5534-91b5-776d77df9df0" :answer/type :answer.type/math :answer/value "x+Δx" :db/ensure [:answer/validate]} {:db/id "q-330277/field-4/c277d97683865e4ef66c9a53190b47dbf1e7b3c8a03752be1f16a9880e8f33be" :answer/id #uuid "7c18ea53-df8c-51e4-bbdb-44472a5488a0" :answer/type :answer.type/math :answer/value "y+Δy" :db/ensure [:answer/validate]} {:db/id "q-330277/field-4" :answer-field/id #uuid "2ed72ccd-dfd7-51a7-860a-e8f4b4ae3620" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-330277/field-4/e7f3f847fb158d4d50df48097f16aeaf7f4100dedf0ac6815ac946a068da6e4f" :answer-field/choices ["q-330277/field-4/1615e6384e6bcb5356295be1ff751b1510d802c0f0018493e82c568baf9cf418" "q-330277/field-4/45753729b7eea380690757236f1fd5b9e8d959b4cb54a7c77e8dd1b3c7b54c27" "q-330277/field-4/e7f3f847fb158d4d50df48097f16aeaf7f4100dedf0ac6815ac946a068da6e4f" "q-330277/field-4/c277d97683865e4ef66c9a53190b47dbf1e7b3c8a03752be1f16a9880e8f33be"] :db/ensure [:answer-field/validate]} {:db/id "q-330277" :question/id #uuid "f7f0fee2-a9a3-5fee-b4d9-2be1474a2a30" :question/math-academy-id "q-330277" :question/problem "Suppose we wish to solve the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nand we take a single step of size $Δx$ using the Runge-Kutta (RK4) method. Fill in the blanks to complete the weighted-average formula for the increment and the stage definitions, starting at the point $(x,y).$\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot {{field-1}} \\\\ {y}^{′} & =f(x,y) \\\\ {y}_{1}^{′} & =f({{field-2}},\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\ {y}_{2}^{′} & =f(x+\\frac{1}{2}Δx,\\,{{field-3}}+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\ {y}_{3}^{′} & =f({{field-4}},\\,y+{y}_{2}^{′}\\cdot Δx)\\end{aligned}\n$$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-330277/field-1" "q-330277/field-2" "q-330277/field-3" "q-330277/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b9740440-bdfb-588e-8f23-2eec9427e449"] :knowledge-point/questions ["q-330277"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331060/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "f7f45da4-8844-5e2c-a205-ab6d7158cb0c" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-331060/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e93f8f04-b54d-52a8-8966-c092bc73cf40" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-331060/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "67d9515c-47da-54fc-b729-b0a0c16d2936" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-331060/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "9a133348-1f16-5f57-9628-c3fcc809899b" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-331060/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "33662233-95d5-572e-8e20-20640c8a454d" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-331060/selection" :answer-field/id #uuid "5e490f46-5d3f-5fef-97e5-b43ae36d4a32" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-331060/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-331060/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-331060/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-331060/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-331060/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-331060/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-331060" :question/id #uuid "c0b0d662-8694-5ef2-8e8d-620e51eeac16" :question/math-academy-id "q-331060" :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(1)=2\n$$\n\nfor some function $f(x,y).$ The table below shows the intermediate quantities computed in the first iteration of the Runge-Kutta (RK4) method.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $2$ | $-2$ | $0$ | $3$ |  |\n\nGiven that the step size is $Δx=\\frac{1}{2},$ at which of the following points is the function $f$ evaluated during this iteration?\n\n- $(\\frac{5}{4},\\frac{5}{2})$\n- $(\\frac{5}{4},\\frac{3}{2})$\n- $(\\frac{3}{2},2)$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nNow, we have the following table of values:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $2$ | $2$ | $-2$ | $0$ | $3$ |  |\n\nWith this in mind, let's find each point at which the slope is evaluated in turn using the values given in the table.\n\n- The slope ${y}^{′}$ is evaluated at the initial point $(x,y)=({x}_{0},{y}_{0})=(1,2).$\n\n- The estimated slope ${y}_{1}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{1},{y}_{1}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2}\\cdot \\frac{1}{2},\\,2+\\frac{1}{2}\\cdot 2\\cdot \\frac{1}{2}) \\\\  & =(\\frac{5}{4},\\frac{5}{2}).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{2}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2}\\cdot \\frac{1}{2},\\,2+\\frac{1}{2}\\cdot (-2)\\cdot \\frac{1}{2}) \\\\  & =(\\frac{5}{4},\\frac{3}{2}).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{3}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2},\\,2+0\\cdot \\frac{1}{2}) \\\\  & =(\\frac{3}{2},2).\\end{aligned}\n$$\n\nTherefore, of the given options, the slope is evaluated at the points \"I, II, and III\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331060/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b9740440-bdfb-588e-8f23-2eec9427e449"] :knowledge-point/questions ["q-331060"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327111/selection/c629aad0301547c51697a3dea4f2a3f8918b23318e05bfbe714fca615db9b076" :answer/id #uuid "25bfb3ef-e515-56c3-a58d-2a47dc61a28a" :answer/type :answer.type/math :answer/value "(\\frac{5}{4},-2)" :db/ensure [:answer/validate]} {:db/id "q-327111/selection/cd8a54af1aae8a849059061ae733f4ad5d85457fba183f86b3944d616e6154fb" :answer/id #uuid "2d722417-893a-5640-a5c7-3af0be60a9e2" :answer/type :answer.type/math :answer/value "(\\frac{3}{2},-\\frac{7}{4})" :db/ensure [:answer/validate]} {:db/id "q-327111/selection/46610eaaeeab5a75165b0070eab8ac326e8c97d465d9c668867fd2271dc386cc" :answer/id #uuid "b7088de4-4a58-50ca-b0d2-a9da24f3ea1b" :answer/type :answer.type/math :answer/value "(\\frac{5}{4},-\\frac{7}{4})" :db/ensure [:answer/validate]} {:db/id "q-327111/selection/a680ef5d7c1b3836e930791c0084ec40513519892edb4eaa0c8a4bcffae2cdbf" :answer/id #uuid "00c89281-9501-5fcb-8999-9a65347640f5" :answer/type :answer.type/math :answer/value "(\\frac{3}{2},-2)" :db/ensure [:answer/validate]} {:db/id "q-327111/selection/265033e705ddbe9f1f30f47188b03a2b28b2a12a3ed7f75cd554e6baee2550bc" :answer/id #uuid "668bd115-bc04-519b-bf48-8c4b1c3ddaf8" :answer/type :answer.type/math :answer/value "(1,-2)" :db/ensure [:answer/validate]} {:db/id "q-327111/selection" :answer-field/id #uuid "e53767a2-d79e-57e4-a3b8-6f63d0b00676" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-327111/selection/a680ef5d7c1b3836e930791c0084ec40513519892edb4eaa0c8a4bcffae2cdbf" :answer-field/choices ["q-327111/selection/c629aad0301547c51697a3dea4f2a3f8918b23318e05bfbe714fca615db9b076" "q-327111/selection/cd8a54af1aae8a849059061ae733f4ad5d85457fba183f86b3944d616e6154fb" "q-327111/selection/46610eaaeeab5a75165b0070eab8ac326e8c97d465d9c668867fd2271dc386cc" "q-327111/selection/a680ef5d7c1b3836e930791c0084ec40513519892edb4eaa0c8a4bcffae2cdbf" "q-327111/selection/265033e705ddbe9f1f30f47188b03a2b28b2a12a3ed7f75cd554e6baee2550bc"] :db/ensure [:answer-field/validate]} {:db/id "q-327111" :question/id #uuid "638ada70-27b3-5d5d-a98a-87e18bc2d803" :question/math-academy-id "q-327111" :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(1)=-2\n$$\n\nfor some function $f(x,y).$ The table below shows the intermediate quantities computed in the first iteration of the Runge-Kutta (RK4) method.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-2$ | $0$ | $1$ | $\\frac{1}{2}$ | $-\\frac{1}{2}$ |  |\n\nGiven that the step size is $Δx=\\frac{1}{2},$ at which of the following points is the function $f$ **NOT** evaluated during this iteration?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nNow, we have the following table of values:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-2$ | $0$ | $1$ | $\\frac{1}{2}$ | $-\\frac{1}{2}$ |  |\n\nWith this in mind, let's find each point at which the slope is evaluated in turn using the values given in the table.\n\n- The slope ${y}^{′}$ is evaluated at the initial point $(x,y)=({x}_{0},{y}_{0})=(1,-2).$\n\n- The estimated slope ${y}_{1}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{1},{y}_{1}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2}\\cdot \\frac{1}{2},\\,-2+\\frac{1}{2}\\cdot 0\\cdot \\frac{1}{2}) \\\\  & =(\\frac{5}{4},-2).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{2}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2}\\cdot \\frac{1}{2},\\,-2+\\frac{1}{2}\\cdot 1\\cdot \\frac{1}{2}) \\\\  & =(\\frac{5}{4},-\\frac{7}{4}).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{3}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(1+\\frac{1}{2},\\,-2+\\frac{1}{2}\\cdot \\frac{1}{2}) \\\\  & =(\\frac{3}{2},-\\frac{7}{4}).\\end{aligned}\n$$\n\nTherefore, of the given options, the only point where the slope is **NOT** evaluated is $(\\frac{3}{2},-2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-327111/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b9740440-bdfb-588e-8f23-2eec9427e449"] :knowledge-point/questions ["q-327111"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331066/selection/3cbe7b9cf1f3b470c4402db6e032d82243436e406937acc36dcd5bcd7d570d8d" :answer/id #uuid "36aac72b-626c-5802-a00b-5fdeae4774b8" :answer/type :answer.type/math :answer/value "(\\frac{1}{8},1)" :db/ensure [:answer/validate]} {:db/id "q-331066/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" :answer/id #uuid "03249d4d-afa2-5ffe-9d3d-9310785b0607" :answer/type :answer.type/math :answer/value "(0,1)" :db/ensure [:answer/validate]} {:db/id "q-331066/selection/fe083d285c77871cb19c5c96fa9e686c7793b843191d786ec7a33dee00fbb9e9" :answer/id #uuid "d88ee124-8875-5261-a3d2-0a0fc8c5dfd9" :answer/type :answer.type/math :answer/value "(\\frac{1}{4},1)" :db/ensure [:answer/validate]} {:db/id "q-331066/selection/41f25b7583fedc4f68e9b717d85d398b24de3b88419195c40fc08de650fbbe4e" :answer/id #uuid "075394ca-8f38-5d2a-b8f5-f800e4e2903a" :answer/type :answer.type/math :answer/value "(\\frac{1}{8},\\frac{5}{4})" :db/ensure [:answer/validate]} {:db/id "q-331066/selection/8f2d9bd2bbd0fe9710d8bfa58864c3bfe0d3509beded878ec044da7d4f3719d6" :answer/id #uuid "d7733a2a-c0fb-56bd-b1ff-4e6c8e129efa" :answer/type :answer.type/math :answer/value "(\\frac{1}{4},\\frac{3}{4})" :db/ensure [:answer/validate]} {:db/id "q-331066/selection" :answer-field/id #uuid "167c0b8a-67c0-5ddc-b4c8-c830b4d525dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-331066/selection/fe083d285c77871cb19c5c96fa9e686c7793b843191d786ec7a33dee00fbb9e9" :answer-field/choices ["q-331066/selection/3cbe7b9cf1f3b470c4402db6e032d82243436e406937acc36dcd5bcd7d570d8d" "q-331066/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" "q-331066/selection/fe083d285c77871cb19c5c96fa9e686c7793b843191d786ec7a33dee00fbb9e9" "q-331066/selection/41f25b7583fedc4f68e9b717d85d398b24de3b88419195c40fc08de650fbbe4e" "q-331066/selection/8f2d9bd2bbd0fe9710d8bfa58864c3bfe0d3509beded878ec044da7d4f3719d6"] :db/ensure [:answer-field/validate]} {:db/id "q-331066" :question/id #uuid "929a3247-0431-5f4c-9a78-668ee45f9c6a" :question/math-academy-id "q-331066" :question/problem "Consider the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(0)=1\n$$\n\nfor some function $f(x,y).$ The table below shows the intermediate quantities computed in the first iteration of the Runge-Kutta (RK4) method.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $2$ | $-1$ | $1$ |  |\n\nGiven that the step size is $Δx=\\frac{1}{4},$ at which of the following points is the function $f$ **NOT** evaluated during this iteration?" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nNow, we have the following table of values:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $0$ | $2$ | $-1$ | $1$ |  |\n\nWith this in mind, let's find each point at which the slope is evaluated in turn using the values given in the table.\n\n- The slope ${y}^{′}$ is evaluated at the initial point $(x,y)=({x}_{0},{y}_{0})=(0,1).$\n\n- The estimated slope ${y}_{1}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{1},{y}_{1}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot \\frac{1}{4},\\,1+\\frac{1}{2}\\cdot 0\\cdot \\frac{1}{4}) \\\\  & =(\\frac{1}{8},1).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{2}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot \\frac{1}{4},\\,1+\\frac{1}{2}\\cdot 2\\cdot \\frac{1}{4}) \\\\  & =(\\frac{1}{8},\\frac{5}{4}).\\end{aligned}\n$$\n\n- The estimated slope ${y}_{3}^{′}$ is evaluated at\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{4},\\,1+(-1)\\cdot \\frac{1}{4}) \\\\  & =(\\frac{1}{4},\\frac{3}{4}).\\end{aligned}\n$$\n\nTherefore, of the given options, the only point where the slope is **NOT** evaluated is $(\\frac{1}{4},1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331066/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b9740440-bdfb-588e-8f23-2eec9427e449"] :knowledge-point/questions ["q-331066"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331396/field-1/a796ac0ba0bcf9078318a72d60ebc6f9a6d236999c5e8ffbbf451d2b041d12da" :answer/id #uuid "6da7f5d2-86ef-56d5-b286-0de47da8e6fb" :answer/type :answer.type/math :answer/value "\\frac{181}{96}" :db/ensure [:answer/validate]} {:db/id "q-331396/field-1" :answer-field/id #uuid "ffd22661-e194-5a52-a195-1dbaba613a1e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331396/field-1/a796ac0ba0bcf9078318a72d60ebc6f9a6d236999c5e8ffbbf451d2b041d12da" :answer-field/choices ["q-331396/field-1/a796ac0ba0bcf9078318a72d60ebc6f9a6d236999c5e8ffbbf451d2b041d12da"] :db/ensure [:answer-field/validate]} {:db/id "q-331396/field-2/2a75f98baa18e39b41dbb4f5da8991dedcba5a4b5b134013d0addd591f02b840" :answer/id #uuid "502ac6b9-2ae0-529b-b72f-d0dec5eefb88" :answer/type :answer.type/math :answer/value "\\frac{277}{96}" :db/ensure [:answer/validate]} {:db/id "q-331396/field-2" :answer-field/id #uuid "ab0a30c2-a79f-514e-a529-54edb8822719" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331396/field-2/2a75f98baa18e39b41dbb4f5da8991dedcba5a4b5b134013d0addd591f02b840" :answer-field/choices ["q-331396/field-2/2a75f98baa18e39b41dbb4f5da8991dedcba5a4b5b134013d0addd591f02b840"] :db/ensure [:answer-field/validate]} {:db/id "q-331396" :question/id #uuid "cb274f8f-2d0b-50f5-a3ce-681fff7de721" :question/math-academy-id "q-331396" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=x+2y,\\,y(0)=1\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) Method. Complete the first row of the table below, given that the step size is $Δx=\\frac{1}{2}.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $2$ | $\\frac{13}{4}$ | $\\frac{31}{8}$ | $\\frac{51}{8}$ | {{field-1}} |\n\nTherefore, $y\\,(\\frac{1}{2})≈$\n{{field-2}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nAll four sample slopes are already computed. So, we just need to find the increment on $y.$\n\nWe compute $Δy$ using the Runge-Kutta method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(2+2\\cdot \\frac{13}{4}+2\\cdot \\frac{31}{8}+\\frac{51}{8})\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{6}\\cdot \\frac{181}{8}\\cdot \\frac{1}{2} \\\\  & =\\frac{181}{96}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $2$ | $\\frac{13}{4}$ | $\\frac{31}{8}$ | $\\frac{51}{8}$ | $\\frac{181}{96}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+\\frac{1}{2} \\\\  & =\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =1+\\frac{181}{96} \\\\  & =\\frac{277}{96}.\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $1$ | $2$ | $\\frac{13}{4}$ | $\\frac{31}{8}$ | $\\frac{51}{8}$ | $\\frac{181}{96}$ |\n| $\\frac{1}{2}$ | $\\frac{277}{96}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y\\,(\\frac{1}{2})≈\\frac{277}{96}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331396/field-1" "q-331396/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "caff9428-bce5-5aca-8e6d-3801a43b486e"] :knowledge-point/questions ["q-331396"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331399/field-1/09974eab12f2ccecd1ac400dc91589328ea8349b6ccc14a58c2a81d1b6d64900" :answer/id #uuid "dc761c9b-dda7-53ee-b4bd-5be759457223" :answer/type :answer.type/math :answer/value "\\frac{41}{48}" :db/ensure [:answer/validate]} {:db/id "q-331399/field-1/d21e25585001c6149b5b6527de96daf54475d57bf270001e88236fe510721fc8" :answer/id #uuid "2bb32e0b-017d-55ef-8563-8c1fc2f1f227" :answer/type :answer.type/math :answer/value "\\frac{41}{8}" :db/ensure [:answer/validate]} {:db/id "q-331399/field-1" :answer-field/id #uuid "d4984c38-e4b0-5ecf-adc8-373520e76beb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331399/field-1/09974eab12f2ccecd1ac400dc91589328ea8349b6ccc14a58c2a81d1b6d64900" :answer-field/choices ["q-331399/field-1/09974eab12f2ccecd1ac400dc91589328ea8349b6ccc14a58c2a81d1b6d64900" "q-331399/field-1/d21e25585001c6149b5b6527de96daf54475d57bf270001e88236fe510721fc8"] :db/ensure [:answer-field/validate]} {:db/id "q-331399/field-2/09974eab12f2ccecd1ac400dc91589328ea8349b6ccc14a58c2a81d1b6d64900" :answer/id #uuid "5cc38bd1-9296-585e-841c-432f17ba18d7" :answer/type :answer.type/math :answer/value "\\frac{41}{48}" :db/ensure [:answer/validate]} {:db/id "q-331399/field-2" :answer-field/id #uuid "def007bb-ae29-5325-a9f8-4d015c59da4a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331399/field-2/09974eab12f2ccecd1ac400dc91589328ea8349b6ccc14a58c2a81d1b6d64900" :answer-field/choices ["q-331399/field-2/09974eab12f2ccecd1ac400dc91589328ea8349b6ccc14a58c2a81d1b6d64900"] :db/ensure [:answer-field/validate]} {:db/id "q-331399" :question/id #uuid "9919f0b9-7482-5dc1-9671-ab46e5e6ccb0" :question/math-academy-id "q-331399" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=xy+1,\\,y(-1)=0\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) Method. Complete the first row of the table below, given that the step size is $Δx=1.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $0$ | $1$ | $\\frac{3}{4}$ | $\\frac{13}{16}$ | $1$ | {{field-1}} |\n\nTherefore, $y(0)≈$\n{{field-2}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nAll four sample slopes are already computed. So, we just need to find the increment on $y.$\n\nWe compute $Δy$ using the Runge-Kutta method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(1+2\\cdot \\frac{3}{4}+2\\cdot \\frac{13}{16}+1)\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot \\frac{41}{8} \\\\  & =\\frac{41}{48}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $0$ | $1$ | $\\frac{3}{4}$ | $\\frac{13}{16}$ | $1$ | $\\frac{41}{48}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =-1+1 \\\\  & =0 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =0+\\frac{41}{48} \\\\  & =\\frac{41}{48}.\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $0$ | $1$ | $\\frac{3}{4}$ | $\\frac{13}{16}$ | $1$ | $\\frac{41}{48}$ |\n| $0$ | $\\frac{41}{48}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y(0)≈\\frac{41}{48}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331399/field-1" "q-331399/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "caff9428-bce5-5aca-8e6d-3801a43b486e"] :knowledge-point/questions ["q-331399"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331416/field-1/fafc7b5d1f3d59ecf30970324c15634804f481d2fafedc45a66f908de8bc8dd9" :answer/id #uuid "5948db66-2dd2-50e1-bb8c-42e8acacd775" :answer/type :answer.type/math :answer/value "\\frac{7}{16}" :db/ensure [:answer/validate]} {:db/id "q-331416/field-1" :answer-field/id #uuid "ab088ca7-2746-5719-af91-6d619da73e96" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331416/field-1/fafc7b5d1f3d59ecf30970324c15634804f481d2fafedc45a66f908de8bc8dd9" :answer-field/choices ["q-331416/field-1/fafc7b5d1f3d59ecf30970324c15634804f481d2fafedc45a66f908de8bc8dd9"] :db/ensure [:answer-field/validate]} {:db/id "q-331416/field-2/ac1dc5cc25848f209894816310d93e82c3987cc6004f4f4670dccfe6da784064" :answer/id #uuid "a7f866d0-8fda-5904-a9b6-75f34d19fcf3" :answer/type :answer.type/math :answer/value "-\\frac{9}{16}" :db/ensure [:answer/validate]} {:db/id "q-331416/field-2" :answer-field/id #uuid "f479f03e-aee8-579d-b74b-f9a4e6be2bc8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331416/field-2/ac1dc5cc25848f209894816310d93e82c3987cc6004f4f4670dccfe6da784064" :answer-field/choices ["q-331416/field-2/ac1dc5cc25848f209894816310d93e82c3987cc6004f4f4670dccfe6da784064"] :db/ensure [:answer-field/validate]} {:db/id "q-331416" :question/id #uuid "69174b8d-d29c-5e72-87c0-49519b9f657b" :question/math-academy-id "q-331416" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=-2x-2y-2,\\,y(-1)=-1\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) Method. Complete the first row of the table below, given that the step size is $Δx=\\frac{1}{2}.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $-1$ | $2$ | $\\frac{1}{2}$ | $\\frac{5}{4}$ | $-\\frac{1}{4}$ | {{field-1}} |\n\nTherefore, $y\\,(-\\frac{1}{2})≈$\n{{field-2}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nAll four sample slopes are already computed. So, we just need to find the increment on $y.$\n\nWe compute $Δy$ using the Runge-Kutta method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(2+2\\cdot \\frac{1}{2}+2\\cdot \\frac{5}{4}+(-\\frac{1}{4}))\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{12}\\cdot \\frac{21}{4} \\\\  & =\\frac{7}{16}.\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $-1$ | $2$ | $\\frac{1}{2}$ | $\\frac{5}{4}$ | $-\\frac{1}{4}$ | $\\frac{7}{16}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =-1+\\frac{1}{2} \\\\  & =-\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =-1+\\frac{7}{16} \\\\  & =-\\frac{9}{16}.\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $-1$ | $2$ | $\\frac{1}{2}$ | $\\frac{5}{4}$ | $-\\frac{1}{4}$ | $\\frac{7}{16}$ |\n| $-\\frac{1}{2}$ | $-\\frac{9}{16}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y\\,(-\\frac{1}{2})≈-\\frac{9}{16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331416/field-1" "q-331416/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "caff9428-bce5-5aca-8e6d-3801a43b486e"] :knowledge-point/questions ["q-331416"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330769/field-1/f7585c526052b2b0eeb2acfeb7d21df68c3af8dc1606ef217965e36267b0951e" :answer/id #uuid "1ef3c9a6-5b1d-5c3f-821c-8580f7f6e4c1" :answer/type :answer.type/math :answer/value "\\frac{29}{6}" :db/ensure [:answer/validate]} {:db/id "q-330769/field-1/ebe3072a1dd0240f82f7c04e06603ef971401ed1aea6a421c38664ef5adb09f3" :answer/id #uuid "7f53d591-860f-57c0-abeb-619bdc7b7b46" :answer/type :answer.type/math :answer/value "29" :db/ensure [:answer/validate]} {:db/id "q-330769/field-1" :answer-field/id #uuid "550575a9-500a-53be-a218-6d55f8b3ed4e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-330769/field-1/f7585c526052b2b0eeb2acfeb7d21df68c3af8dc1606ef217965e36267b0951e" :answer-field/choices ["q-330769/field-1/f7585c526052b2b0eeb2acfeb7d21df68c3af8dc1606ef217965e36267b0951e" "q-330769/field-1/ebe3072a1dd0240f82f7c04e06603ef971401ed1aea6a421c38664ef5adb09f3"] :db/ensure [:answer-field/validate]} {:db/id "q-330769/field-2/c55e2a6a792e6814ed6fa63975035d60fbf5c615ab78effc66c8e958bfb05666" :answer/id #uuid "493042b1-3d6e-5679-9fd6-61e6b2d53d59" :answer/type :answer.type/math :answer/value "\\frac{41}{6}" :db/ensure [:answer/validate]} {:db/id "q-330769/field-2" :answer-field/id #uuid "11ef09c2-134c-537b-82ad-e236e715b3e7" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-330769/field-2/c55e2a6a792e6814ed6fa63975035d60fbf5c615ab78effc66c8e958bfb05666" :answer-field/choices ["q-330769/field-2/c55e2a6a792e6814ed6fa63975035d60fbf5c615ab78effc66c8e958bfb05666"] :db/ensure [:answer-field/validate]} {:db/id "q-330769" :question/id #uuid "67efcf5e-1344-5bc2-aaeb-55e9a14796ef" :question/math-academy-id "q-330769" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x+y,\\,y(0)=2\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) Method. Complete the first row of the table below, given that the step size is $Δx=1.$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $2$ | $4$ | $5$ | $9$ | {{field-1}} |\n\nTherefore, $y(1)≈$\n{{field-2}}." :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nAll four sample slopes are already computed. So, we just need to find the increment on $y.$\n\nWe compute $Δy$ using the Runge-Kutta method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(2+2\\cdot 4+2\\cdot 5+9)\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot 29 \\\\  & =\\frac{29}{6}\\end{aligned}\n$$\n\nTherefore, the completed first row is as given below.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $2$ | $4$ | $5$ | $9$ | $\\frac{29}{6}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+1 \\\\  & =1 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =2+\\frac{29}{6} \\\\  & =\\frac{41}{6}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $2$ | $2$ | $4$ | $5$ | $9$ | $\\frac{29}{6}$ |\n| $1$ | $\\frac{41}{6}$ |  |  |  |  |  |\n\nFinally, we have\n\n$$\n\\begin{aligned}y(1)≈\\frac{41}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-330769/field-1" "q-330769/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "caff9428-bce5-5aca-8e6d-3801a43b486e"] :knowledge-point/questions ["q-330769"] :db/ensure [:knowledge-point/validate]} {:db/id "q-330767/field-1/58f4a982a890cce9a35288844a0013dc9adcb3effa98e1f9d3360fcc35feaa02" :answer/id #uuid "4d1eb0f4-ee40-5d0e-85d0-3a541cd32c2b" :answer/type :answer.type/math :answer/value "\\frac{51}{64}" :db/ensure [:answer/validate]} {:db/id 17592186164083 :answer-field/correct "q-330767/field-1/58f4a982a890cce9a35288844a0013dc9adcb3effa98e1f9d3360fcc35feaa02" :answer-field/choices ["q-