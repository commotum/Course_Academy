8958cf52640fc3516344b71e6cdfca38" "q-64597/selection/ccf834616b843ad99db0ee52189805bf242068749708fd6e8463a143fd2777d5"] :db/ensure [:answer-field/validate]} {:db/id "q-64597" :question/id #uuid "d6d02da1-237a-5cb6-97fe-c0b14d2022bd" :question/math-academy-id "q-64597" :question/problem "A particle of mass $2\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=12\\,{\\text{kg/s}}^{2}.$ \nAn external force $F(t)=10{e}^{2t}\\,\\text{N}$ is applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping, what is the governing equation?" :question/worked-solution "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and  external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m,$ $k$ and $F(t)$ gives\n\n$$\n2{y}^{″}=-12y+10{e}^{2t}.\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+6y=5{e}^{2t}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64597/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76e86899-2abb-5cca-9585-4a97e4630264"] :knowledge-point/questions ["q-64597"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64602/selection/34c3a0d6f9879d8ed0e02e00a8f0000ac7e6bc5b567c4e557d6b4a8c8791d78d" :answer/id #uuid "ee0900e8-c76d-5475-812d-bafc7191b573" :answer/type :answer.type/math :answer/value "{y}^{″}+4{y}^{′}+5y=2{e}^{4t}" :db/ensure [:answer/validate]} {:db/id "q-64602/selection/7af6c3cf1b7e7fb9e0ea92387e27aede2d870ff79782d73ca1db7c5a0f89c4af" :answer/id #uuid "78bb1e57-f4cc-5823-8289-3e76ace19443" :answer/type :answer.type/math :answer/value "{y}^{″}+4{y}^{′}+\\sqrt{5}y=6{e}^{4t}" :db/ensure [:answer/validate]} {:db/id "q-64602/selection/e918bc2d9db9e1bf78e808025799fa48c781c0817b6c2cccea7e4244b248303c" :answer/id #uuid "858e8e3c-1a02-59d2-b99a-7abb2bf2a76f" :answer/type :answer.type/math :answer/value "{y}^{″}+4{y}^{′}+5y={e}^{4t}" :db/ensure [:answer/validate]} {:db/id "q-64602/selection/a9a262041dc48ac61b525390b0ef1198feb2ff4a502799fe592c226a10ae1f5c" :answer/id #uuid "2cc5fbbe-860f-5f2e-8306-50d54d1561a3" :answer/type :answer.type/math :answer/value "{y}^{″}+5{y}^{′}+4y=4{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-64602/selection/833ae32f3520e3b52b704d115e7081ff8706c244fefc5f12545884cff7b13f7c" :answer/id #uuid "14d1d184-b1e5-55b5-af51-3a9a54cc2d0f" :answer/type :answer.type/math :answer/value "{y}^{″}+5{y}^{′}+4y=6{e}^{4t}" :db/ensure [:answer/validate]} {:db/id "q-64602/selection" :answer-field/id #uuid "eeda5ba4-9976-5af5-9dbf-88f31fb3ebcd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64602/selection/34c3a0d6f9879d8ed0e02e00a8f0000ac7e6bc5b567c4e557d6b4a8c8791d78d" :answer-field/choices ["q-64602/selection/34c3a0d6f9879d8ed0e02e00a8f0000ac7e6bc5b567c4e557d6b4a8c8791d78d" "q-64602/selection/7af6c3cf1b7e7fb9e0ea92387e27aede2d870ff79782d73ca1db7c5a0f89c4af" "q-64602/selection/e918bc2d9db9e1bf78e808025799fa48c781c0817b6c2cccea7e4244b248303c" "q-64602/selection/a9a262041dc48ac61b525390b0ef1198feb2ff4a502799fe592c226a10ae1f5c" "q-64602/selection/833ae32f3520e3b52b704d115e7081ff8706c244fefc5f12545884cff7b13f7c"] :db/ensure [:answer-field/validate]} {:db/id "q-64602" :question/id #uuid "4e9a65e3-dfc8-5e26-8b20-c96df0dc09f5" :question/math-academy-id "q-64602" :question/problem "A particle of mass $3\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=15\\,{\\text{kg/s}}^{2}.$  The particle is also subject to the resistive force that's proportional to the particle's velocity with a damping coefficient $c=12\\,\\text{kg/s},$ and an external force given by $F(t)=6{e}^{4t}\\,\\text{N}.$   \n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with forced harmonic motion, what is the governing equation?" :question/worked-solution "The general equation of forced harmonic motion with damping is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky+F(t).\n$$\n\nSubstituting our values for $m,$ $k,$ $c$ and $F(t)$ gives\n\n$$\n3{y}^{″}=-12{y}^{′}-15y+6{e}^{4t}.\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+4{y}^{′}+5y=2{e}^{4t}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64602/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76e86899-2abb-5cca-9585-4a97e4630264"] :knowledge-point/questions ["q-64602"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64555"] :question/problem "A particle of mass $3\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=15\\,{\\text{kg/s}}^{2}.$ \nAn external force $F(t)=9\\operatorname{sin}⁡(t)\\,\\text{N}$ is applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping, what is the governing equation?" :question/worked-solution "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and  external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m,$ $k$ and $F(t)$ gives\n\n$$\n3{y}^{″}=-15y+9\\operatorname{sin}⁡(t).\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+5y=3\\operatorname{sin}⁡t.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-94232/selection/66e5855009718703fd866b0f83d3b276fafb0c11691cfd8135c2461edc2aa938" :answer/id #uuid "c5d9b670-51a3-59e7-968c-a9d29ad38246" :answer/type :answer.type/math :answer/value "{y}^{″}+\\frac{3}{2}y=3{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-94232/selection/b541ee9d9fdd12d0256efb40ee345ed5fcf29870e4b5d107ebbca575b61dba3e" :answer/id #uuid "b678783f-baef-5681-a294-94ec00dd4e89" :answer/type :answer.type/math :answer/value "{y}^{″}+18y=6{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-94232/selection/891724c95446bbab956a73a151093bf9eab538969f104010b16151a0e68925a8" :answer/id #uuid "b828f45a-73ee-53ee-aa6f-b5816c31f99a" :answer/type :answer.type/math :answer/value "{y}^{″}+6y=\\frac{3}{4}{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-94232/selection/e2aa7ee556148fe28b6f9174d0263f65474b9c226a2bce0b6c7bde305e1c16a8" :answer/id #uuid "c69b6023-0dea-510d-a66f-e80a7b1bd329" :answer/type :answer.type/math :answer/value "{y}^{″}+3y=\\frac{3}{2}{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-94232/selection/3d394e65504043d2e37c319000614635e8187d4318cc10adcf2954873d829e4c" :answer/id #uuid "03cb4cfd-a976-5ab6-95da-a1430cd555d0" :answer/type :answer.type/math :answer/value "{y}^{″}+3y={e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-94232/selection" :answer-field/id #uuid "23723f38-f462-5a09-9391-520877e4263c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94232/selection/e2aa7ee556148fe28b6f9174d0263f65474b9c226a2bce0b6c7bde305e1c16a8" :answer-field/choices ["q-94232/selection/66e5855009718703fd866b0f83d3b276fafb0c11691cfd8135c2461edc2aa938" "q-94232/selection/b541ee9d9fdd12d0256efb40ee345ed5fcf29870e4b5d107ebbca575b61dba3e" "q-94232/selection/891724c95446bbab956a73a151093bf9eab538969f104010b16151a0e68925a8" "q-94232/selection/e2aa7ee556148fe28b6f9174d0263f65474b9c226a2bce0b6c7bde305e1c16a8" "q-94232/selection/3d394e65504043d2e37c319000614635e8187d4318cc10adcf2954873d829e4c"] :db/ensure [:answer-field/validate]} {:db/id "q-94232" :question/id #uuid "f5e4644a-64e5-5d50-a7ec-94e744985087" :question/math-academy-id "q-94232" :question/problem "A particle of mass $6\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=18\\,{\\text{kg/s}}^{2}.$ An external force $F(t)=9{e}^{-3t}\\,\\text{N}$ is applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping, what is the governing equation?" :question/worked-solution "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and  external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m,$ $k$ and $F(t)$ gives\n\n$$\n6{y}^{″}=-18y+9{e}^{-3t}.\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+3y=\\frac{3}{2}{e}^{-3t}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94232/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76e86899-2abb-5cca-9585-4a97e4630264"] :knowledge-point/questions ["q-94232"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64599/selection/9d0055615eb6fb8f5430f1d940bed19901a35e96eda79a63cf8640fa8c65913b" :answer/id #uuid "b9e7623c-4ed4-58d3-bc3d-a2516df5ccc2" :answer/type :answer.type/math :answer/value "{y}^{″}+4.5y=3{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-64599/selection/9551ecfe9962e5a49d7de01af0bd5e9da044348933dc4a5900f37f9df6667fc1" :answer/id #uuid "e5f059f6-7204-537a-aabf-3ebcb7ea3f76" :answer/type :answer.type/math :answer/value "{y}^{″}+4.5y=6{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-64599/selection/a1bc9a081972a1dd07ea50dcbdc68a3cc45ad321ab1500c28ec9f91eaab7f778" :answer/id #uuid "28c0080b-f44e-56e1-a0be-8cad184b1415" :answer/type :answer.type/math :answer/value "{y}^{″}+4.5y=12{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-64599/selection/624ab52b7b58b7d4ac96e15a5deea401a6014af97ac1a25605e2123268f4d343" :answer/id #uuid "c3461b2b-1815-598a-951c-8a87c6354f5f" :answer/type :answer.type/math :answer/value "{y}^{″}+9y=12{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-64599/selection/015e2eba1ef8c88e2aec4c19bec07e9ff585e3a21b21df49b694b85e36add2c8" :answer/id #uuid "948711c6-ac1e-54bc-a922-c15ff2567956" :answer/type :answer.type/math :answer/value "{y}^{″}+9y=3{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-64599/selection" :answer-field/id #uuid "991d3c54-3c9d-52dc-820c-4c2f90ed179a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64599/selection/9d0055615eb6fb8f5430f1d940bed19901a35e96eda79a63cf8640fa8c65913b" :answer-field/choices ["q-64599/selection/9d0055615eb6fb8f5430f1d940bed19901a35e96eda79a63cf8640fa8c65913b" "q-64599/selection/9551ecfe9962e5a49d7de01af0bd5e9da044348933dc4a5900f37f9df6667fc1" "q-64599/selection/a1bc9a081972a1dd07ea50dcbdc68a3cc45ad321ab1500c28ec9f91eaab7f778" "q-64599/selection/624ab52b7b58b7d4ac96e15a5deea401a6014af97ac1a25605e2123268f4d343" "q-64599/selection/015e2eba1ef8c88e2aec4c19bec07e9ff585e3a21b21df49b694b85e36add2c8"] :db/ensure [:answer-field/validate]} {:db/id "q-64599" :question/id #uuid "eab14b9e-c62b-5d4b-a956-15ee6a49b1b1" :question/math-academy-id "q-64599" :question/problem "A particle of mass $4\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=18\\,{\\text{kg/s}}^{2}.$ \nAn external force $F(t)=12{t}^{3}\\,\\text{N}$ is applied to the particle.\n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds. If the particle moves with forced harmonic motion without damping, what is the governing equation?" :question/worked-solution "The equation of motion for a particle of mass $m$ moving with forced harmonic motion without damping under the action of a spring with spring constant $k$ and  external force $F(t)$ is given by\n\n$$\nm{y}^{″}=-ky+F(t).\n$$\n\nSubstituting our values for $m,$ $k$ and $F(t)$ gives\n\n$$\n4{y}^{″}=-18y+12{t}^{3}.\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\n{y}^{″}+4.5y=3{t}^{3}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64599/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "76e86899-2abb-5cca-9585-4a97e4630264"] :knowledge-point/questions ["q-64599"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64554"] :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+9y=10{e}^{-t}.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y=R\\operatorname{cos}⁡(3t+ϕ)+{e}^{-t}$\n- $y=R\\operatorname{sin}⁡(t+ϕ)+{e}^{-2t}$\n- $y=A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t+{e}^{-t}$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution to this equation is the sum of the complementary function and a particular solution.\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$\nIt can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=9\\,⟹\\,\\omega =3.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(3t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(3t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha {e}^{-t}.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =1.$ So, the particular solution is\n\n$$\n{y}_{p}(t)={e}^{-t}.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(3t+ϕ)+{e}^{-t}$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(3t+ϕ)+{e}^{-t}$\n\n- ${y}_{c}=A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t+{e}^{-t}$\n\nOnly I and III match the forms above. Therefore, the correct answer is \"I and III only\"." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-94383/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "5d7fd9a1-349b-5b8e-8f71-4b17b56d5d2c" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94383/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "666c985b-a1f1-5bf2-a63c-01e100bf3098" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-94383/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "b2cb348c-0172-5197-961c-11cf29367f62" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-94383/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "f2d59f86-dffc-588b-9b43-ee67ea32cf4f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-94383/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "65dac41c-c0d7-5355-95dd-06cda0199205" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-94383/selection" :answer-field/id #uuid "0b1cae30-f8b9-5ce6-ad58-43e95762085d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94383/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-94383/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-94383/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-94383/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-94383/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-94383/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-94383" :question/id #uuid "e83ef381-2688-5e65-8917-dab31a31675d" :question/math-academy-id "q-94383" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+8{y}^{′}+41y=10{e}^{t}.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)+\\frac{{e}^{t}}{5}$\n- $y=R\\operatorname{sin}⁡(9t+ϕ)+\\frac{{e}^{t}}{5}$\n- $y=R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+10{e}^{t}$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+8{y}^{′}+41y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+8\\lambda +41 & =0 \\\\ ({\\lambda }^{2}+8\\lambda +16)-16+41 & =0 \\\\ (\\lambda +4)^{2}+25 & =0 \\\\ (\\lambda +4)^{2} & =-25 \\\\ \\lambda +4 & =\\pm 5\\text{i} \\\\ \\lambda  & =-4\\pm 5\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha {e}^{t}.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =\\frac{1}{5}.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{{e}^{t}}{5}.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-4t}(A\\operatorname{cos}⁡5t+B\\operatorname{sin}⁡5t)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{sin}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}, \\\\ y(t) & =R{e}^{-4t}\\operatorname{cos}⁡(5t+ϕ)+\\frac{{e}^{t}}{5}.\\end{aligned}\n$$\n\nOnly I matches the forms above. Therefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94383/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927"] :knowledge-point/questions ["q-94383"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94376/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "a20eb1b7-408e-5a95-9e9d-1e4b80954d81" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-94376/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "51f9c8f0-ba85-598e-8cf4-0feac701abfb" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-94376/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "2a653aa8-7afe-5016-add0-e4351110f4f4" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-94376/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "9b5421b9-92f6-5979-b02e-9712eac55210" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94376/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "076b9728-e041-5716-ad89-2cfa6a0462fb" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-94376/selection" :answer-field/id #uuid "bf8bb5ab-f082-597e-a99b-a10d9c4be09a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94376/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-94376/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-94376/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-94376/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-94376/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-94376/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-94376" :question/id #uuid "09973ec5-6a1d-53be-934b-f8b7842cdc72" :question/math-academy-id "q-94376" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+y=2\\operatorname{sin}⁡t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n- $y=R\\operatorname{sin}⁡(t+ϕ)+2t\\operatorname{sin}⁡t$\n- $y=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t-2t\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution to this equation is the sum of the complementary function and a particular solution.\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$\nIt can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=1\\,⟹\\,\\omega =1.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=t(\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t).\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =-1$ and $\\beta =0.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=-t\\operatorname{cos}⁡t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(t+ϕ)-t\\operatorname{cos}⁡t$\n\n- ${y}_{c}=A\\operatorname{cos}⁡t+B\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t$\n\nOnly I matches the forms above. Therefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94376/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927"] :knowledge-point/questions ["q-94376"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79586/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "89707078-bc0f-59da-9154-cacb789e744d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-79586/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "32e90991-ab44-5951-b97d-067da9f7bd8e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-79586/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "2c02ece5-d65e-57fb-a143-1bb692bbdd72" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-79586/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "3fe4a0d6-5f2f-5c3f-92de-abde1786c0d9" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-79586/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "a8b74756-4e38-5830-8a83-57d9fdf53c6a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-79586/selection" :answer-field/id #uuid "35b482fc-ca9a-58ce-9928-38400c619a62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79586/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-79586/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-79586/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-79586/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-79586/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-79586/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-79586" :question/id #uuid "c7cc8d38-ca58-5b02-afb6-75f239ceb9f5" :question/math-academy-id "q-79586" :question/problem "A particle is moving with forced harmonic motion without damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+4y=2.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y=R\\operatorname{cos}⁡(2t+ϕ)+2$\n- $y=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{1}{2}$\n- $y={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)+\\frac{1}{2}$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the simple harmonic motion equation ${y}^{″}+{\\omega }^{2}y=0.$\nIt can be written in three different forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(\\omega t+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t$\n\nIn our case\n\n$$\n{\\omega }^{2}=4\\,⟹\\,\\omega =2.\n$$\n\nThus, we have:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(2t+ϕ)$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(2+ϕ)$\n\n- ${y}_{c}=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t$\n\nNext, we find the particular solution ${y}_{p}(t).$ Since the external force is a constant, we assume that the particular solution is also a constant,\n\n$$\n{y}_{p}(t)=\\alpha .\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =\\frac{1}{2}.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=\\frac{1}{2}.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n- ${y}_{c}=R\\operatorname{cos}⁡(2t+ϕ)+\\frac{1}{2}$\n\n- ${y}_{c}=R\\operatorname{sin}⁡(2t+ϕ)+\\frac{1}{2}$\n\n- ${y}_{c}=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t+\\frac{1}{2}$\n\nOnly II match the forms above. Therefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79586/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927"] :knowledge-point/questions ["q-79586"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79575/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "0e7ed369-7ed2-5158-8a21-2f4b969f48e5" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-79575/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c6b4b27b-5d92-5b2c-9559-e899c58c2f7b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-79575/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "b5c5fce5-e1ee-5ace-97e0-92f5b18b5a61" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-79575/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "19500fa8-65da-5af5-89bc-b8920e5241a1" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-79575/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "7c9a5277-25c6-51c9-9517-ca7df2243bea" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-79575/selection" :answer-field/id #uuid "c0a57854-c16b-524e-a399-5a486e0d322d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79575/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-79575/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-79575/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-79575/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-79575/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-79575/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-79575" :question/id #uuid "5296c56b-6b80-5c29-a2da-85a2d42fa001" :question/math-academy-id "q-79575" :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\n{y}^{″}+4{y}^{′}+20y=40\\operatorname{cos}⁡2t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y={e}^{-2t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t)+10\\operatorname{cos}⁡2t$\n- $y=R{e}^{-4t}\\operatorname{cos}⁡(t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t$\n- $y=R{e}^{-2t}\\operatorname{sin}⁡(4t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t$\n\nNote that $A,$ $B,$ $R$ and $ϕ$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t)={y}_{c}(t)+{y}_{p}(t)\n$$\n\nFirst, we find the complementary solution ${y}_{c}(t),$ which is the solution to the homogeneous equation ${y}^{″}+4{y}^{′}+20y=0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +20 & =0 \\\\ ({\\lambda }^{2}+4\\lambda +4)-4+20 & =0 \\\\ (\\lambda +2)^{2}+16 & =0 \\\\ (\\lambda +2)^{2} & =-16 \\\\ \\lambda +2 & =\\pm 4\\text{i} \\\\ \\lambda  & =-2\\pm 4\\text{i}.\\end{aligned}\n$$\n\nTherefore the complimentary function ${y}_{c}(t)$ can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-2t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t), \\\\ {y}_{c}(t) & =R{e}^{-2t}\\operatorname{cos}⁡(4t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-2t}\\operatorname{sin}⁡(4t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution ${y}_{p}(t).$ The particular solution is of the form\n\n$$\n{y}_{p}(t)=\\alpha \\operatorname{cos}⁡2t+\\beta \\operatorname{sin}⁡2t.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha =2$ and $\\beta =1.$ So, the particular solution is\n\n$$\n{y}_{p}(t)=2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-2t}(A\\operatorname{cos}⁡4t+B\\operatorname{sin}⁡4t)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t, \\\\ y(t) & =R{e}^{-2t}\\operatorname{cos}⁡(4t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t, \\\\ y(t) & =R{e}^{-2t}\\operatorname{sin}⁡(4t+ϕ)+2\\operatorname{cos}⁡2t+\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nOnly III matches the forms above. Therefore, the correct answer is \"III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79575/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "813ec1d4-93ec-5a9e-996f-b2e672714927"] :knowledge-point/questions ["q-79575"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79600/selection/2295f6a15959d67281e35eff514cc88b5caaeee202f7ecdea639490660ebf858" :answer/id #uuid "dd158b15-5a48-5b0a-bbb9-3c2e0f0221a6" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{4})=(2{e}^{-\\pi }+2-\\pi )\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-79600/selection/02c10fece609df604769fa01e92452e80b19e7bf417acfa88beb5c618ae6653e" :answer/id #uuid "3dcdbccc-d160-5d8a-93dd-0576f98c523d" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{4})=(2{e}^{-\\pi /2}-\\frac{\\pi }{2})\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-79600/selection/2b038e473ca8c5a89bad43e37393ec0f1804c762ac02d3f5d9dfdf77e5da2351" :answer/id #uuid "5eb4bd94-2e34-52aa-abb0-32636cb2eece" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{4})=({e}^{-\\pi /2}+2)\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-79600/selection/9759ed7b80ef719071f37c8812e25b830d9c42865b9f59aa016f81b688a5025b" :answer/id #uuid "2c2393cc-b147-54b9-9692-0d6b4099b17e" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{4})=({e}^{-\\pi /2}+2-\\frac{\\pi }{2})\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-79600/selection/d67b72a547b58cdd9fd7639fb2863204629bec0e0ae83958b7d2d6c225133d38" :answer/id #uuid "a683b021-8f0b-5c8b-a820-c427a8a68301" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{4})=(2{e}^{-\\pi }+1-\\pi )\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-79600/selection" :answer-field/id #uuid "76ce6a6b-8469-5056-b7a6-aab2bb0f1311" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79600/selection/9759ed7b80ef719071f37c8812e25b830d9c42865b9f59aa016f81b688a5025b" :answer-field/choices ["q-79600/selection/2295f6a15959d67281e35eff514cc88b5caaeee202f7ecdea639490660ebf858" "q-79600/selection/02c10fece609df604769fa01e92452e80b19e7bf417acfa88beb5c618ae6653e" "q-79600/selection/2b038e473ca8c5a89bad43e37393ec0f1804c762ac02d3f5d9dfdf77e5da2351" "q-79600/selection/9759ed7b80ef719071f37c8812e25b830d9c42865b9f59aa016f81b688a5025b" "q-79600/selection/d67b72a547b58cdd9fd7639fb2863204629bec0e0ae83958b7d2d6c225133d38"] :db/ensure [:answer-field/validate]} {:db/id "q-79600" :question/id #uuid "7f2df5c3-cc6f-5843-b9fd-218a45f8a1c1" :question/math-academy-id "q-79600" :question/problem "The position $y(t),$ measured in meters, of a particle oscillating with forced harmonic motion with light damping is governed by the equation\n\n$$\n{y}^{″}+4{y}^{′}+8y=8-16t,\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at $y=2\\,\\text{m}$ with zero velocity, find the position of the particle after $\\frac{\\pi }{4}$ seconds." :question/worked-solution "The general solution to the equation of forced harmonic motion with light damping is the sum of the complementary function and a particular solution.\n\nThe complementary solution ${y}_{c}$ is the solution to the homogeneous equation\n\n$$\n{y}^{″}+4{y}^{′}+8y=0.\n$$\n\nWriting down and solving the auxiliary equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+4\\lambda +8 & =0 \\\\ (\\lambda +2)^{2}+4 & =0 \\\\ (\\lambda +2)^{2} & =-4 \\\\ \\lambda +2 & =\\pm 2\\text{i} \\\\ \\lambda  & =-2\\pm 2\\text{i}.\\end{aligned}\n$$\n\nThus, we have\n\n$$\n{y}_{c}={e}^{-2t}(P\\operatorname{cos}⁡2t+Q\\operatorname{sin}⁡2t).\n$$\n\nWe now need to find the particular integral ${y}_{p}(t).$\n\nThe external force is a linear polynomial. Therefore, we assume that the particular integral is also a linear polynomial, i.e.\n\n$$\n{y}_{p}=\\alpha +\\beta t,\n$$\n\nwhere $\\alpha ,$ $\\beta $ are constants to be determined. \n\nSubstituting ${y}_{p}$ into the differential equation and equating coefficients gives $\\alpha =2,$ $\\beta =-2.$\n\nTherefore, the particular solution ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=2-2t,\n$$\n\nand the general solution is\n\n$$\ny={e}^{-2t}(P\\operatorname{cos}⁡2t+Q\\operatorname{sin}⁡2t)+2-2t.\n$$\n\nSince the particle is initially at $y=2\\,\\text{m}$ with zero velocity, the initial conditions are $y(0)=2$ and ${y}^{′}(0)=0.$\n\nSolving with these conditions for $P$ and $Q$ gives\n\n$$\nP=0,\\,Q=1.\n$$\n\nSo our solution is\n\n$$\ny(t)={e}^{-2t}\\operatorname{sin}⁡2t+2-2t.\n$$\n\nTo find the position of the particle after $\\frac{\\pi }{4}$ seconds, we substitute into the equation $t=\\frac{\\pi }{4}.$ We get\n\n$$\n\\begin{aligned}y(\\frac{\\pi }{4}) & ={e}^{-2(\\pi /4)}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{4})+2-2(\\frac{\\pi }{4}) \\\\  & =({e}^{-\\pi /2}+2-\\frac{\\pi }{2})\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-79600/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5266e491-2718-56a9-b5a7-f4a86a8a01c7"] :knowledge-point/questions ["q-79600"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64572"] :question/problem "The position $y(t),$ measured in meters, of a particle oscillating with forced harmonic motion without damping is governed by the equation\n\n$$\n{y}^{″}+4y=8{t}^{2},\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at the origin with zero velocity, find the position of the particle after $1$ second." :question/worked-solution "The general solution to the equation of forced harmonic motion without damping is the sum of the complementary function and a particular solution.\n\nThe complementary solution ${y}_{c}$ represents simple harmonic motion and can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration.\n\nIn our case,\n\n$$\n{\\omega }^{2}=4\\,⟹\\,\\omega =2.\n$$\n\nThus, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t.\n$$\n\nWe now need to find the particular integral ${y}_{p}(t).$\n\nThe external force is a polynomial of degree $2.$ Therefore, we assume that the particular integral is also a polynomial of degree $2,$ i.e.,\n\n$$\n{y}_{p}=\\alpha {t}^{2}+\\beta t+\\gamma \n$$\n\nwhere $\\alpha ,$ $\\beta $ and $\\gamma $ are constants that are to be determined. \n\nSubstituting ${y}_{p}$ into the differential equation and equating coefficients gives $\\alpha =2,\\beta =0,\\gamma =-1.$\n\nTherefore, the particular solution ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=2{t}^{2}-1,\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t+2{t}^{2}-1.\n$$\n\nSince the particle is initially at the origin with zero velocity, the initial conditions are $y(0)=0$ and ${y}^{′}(0)=0.$\n\nSolving with these conditions for $A$ and $B$ gives\n\n$$\nA=1,\\,B=0.\n$$\n\nSo our solution is\n\n$$\ny(t)=\\operatorname{cos}⁡2t+2{t}^{2}-1.\n$$\n\nTo find the position of the particle after one second, we substitute into the equation $t=1.$ We get\n\n$$\n\\begin{aligned}y(1) & =\\operatorname{cos}⁡2(1)+2(1)^{2}-1 \\\\  & =(\\operatorname{cos}⁡2+1)\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} [:db/retract 17592186148132 :question/answer-fields 17592186146803] {:db/id "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/05689d41c96c05b93942702c53c4f13c170db85e855193c6071eea75e97b14da" :answer/id #uuid "abbaf714-a325-5016-99d7-47ad695da9ea" :answer/type :answer.type/math :answer/value "y(\\pi )=(4-{e}^{-\\pi })\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/78bf73e3f6e50f0273822614e1c5ada710dd4f831e9501fcfa6e5a86c2a5a9fa" :answer/id #uuid "af081fe5-ed42-511d-a10e-a2a72131c724" :answer/type :answer.type/math :answer/value "y(\\pi )=(1+3{e}^{-\\pi })\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/e1e8bd5970bd8c0b7b65feacdb36c299c99ac7d92c497373d7aea28172935d6e" :answer/id #uuid "11f4617b-0784-5289-8bca-ed5b6ef2bf1e" :answer/type :answer.type/math :answer/value "y(\\pi )=2(1-{e}^{-\\pi })\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/a87629fb70aa7e23275d67051ffcdf8a3ecc397ae35d03ba75fefb5ac5e57549" :answer/id #uuid "e47144bb-9da1-52f6-8cc1-4485a99eb18f" :answer/type :answer.type/math :answer/value "y(\\pi )=(3-{e}^{-2\\pi })\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/1d5dcfbfa393ec15331e296ebd7c23fb8fbbfe5cb9491ed867d52b34fe4369b5" :answer/id #uuid "3ae6c161-10cb-5148-a38f-1edb92c65628" :answer/type :answer.type/math :answer/value "y(\\pi )=2(1+2{e}^{-2\\pi })\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e" :answer-field/id #uuid "88d0b43c-c09c-59bf-8228-cf91325ad82e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/e1e8bd5970bd8c0b7b65feacdb36c299c99ac7d92c497373d7aea28172935d6e" :answer-field/choices ["q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/05689d41c96c05b93942702c53c4f13c170db85e855193c6071eea75e97b14da" "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/78bf73e3f6e50f0273822614e1c5ada710dd4f831e9501fcfa6e5a86c2a5a9fa" "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/e1e8bd5970bd8c0b7b65feacdb36c299c99ac7d92c497373d7aea28172935d6e" "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/a87629fb70aa7e23275d67051ffcdf8a3ecc397ae35d03ba75fefb5ac5e57549" "q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e/1d5dcfbfa393ec15331e296ebd7c23fb8fbbfe5cb9491ed867d52b34fe4369b5"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-64646"] :question/problem "The position $y(t),$ measured in inches, of a particle oscillating with forced harmonic motion with light damping is governed by the equation\n\n$$\n{y}^{″}+2{y}^{′}+5y=34\\operatorname{cos}⁡2t,\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at the origin with zero velocity, find the position of the particle after $\\pi $ seconds." :question/worked-solution "The general solution to the equation of forced harmonic motion with light damping is the sum of the complementary function and a particular solution.\n\nThe complementary solution ${y}_{c}$ is the solution to the homogeneous equation\n\n$$\n{y}^{″}+2{y}^{′}+5y=0.\n$$\n\nWriting down and solving the auxiliary equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +5 & =0 \\\\ (\\lambda +1)^{2}+4 & =0 \\\\ (\\lambda +1)^{2} & =-4 \\\\ \\lambda +1 & =\\pm 2\\text{i} \\\\ \\lambda  & =-1\\pm 2\\text{i}.\\end{aligned}\n$$\n\nThus, we have\n\n$$\n{y}_{c}={e}^{-t}(P\\operatorname{cos}⁡2t+Q\\operatorname{sin}⁡2t).\n$$\n\nwhere $P$ and $Q$ are arbitrary constants of integration.\n\nWe now need to find the particular integral ${y}_{p}(t).$\n\nThe external force is $34\\operatorname{cos}⁡2t.$ Therefore, we assume that the particular integral is\n\n$$\n{y}_{p}=\\alpha \\operatorname{cos}⁡2t+\\beta \\operatorname{sin}⁡2t,\n$$\n\nwhere $\\alpha ,$ $\\beta $ are constants to be determined. \n\nSubstituting ${y}_{p}$ into the differential equation and equating coefficients gives $\\alpha =2,$ $\\beta =8.$\n\nTherefore, the particular solution ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=2\\operatorname{cos}⁡2t+8\\operatorname{sin}⁡2t,\n$$\n\nand the general solution is\n\n$$\ny={e}^{-t}(P\\operatorname{cos}⁡2t+Q\\operatorname{sin}⁡2t)+2\\operatorname{cos}⁡2t+8\\operatorname{sin}⁡2t.\n$$\n\nSince the particle is initially at the origin with zero velocity, the initial conditions are $y(0)=0$ and ${y}^{′}(0)=0.$\n\nSolving with these conditions for $P$ and $Q$ gives\n\n$$\nP=-2,\\,Q=-9.\n$$\n\nSo our solution is\n\n$$\ny(t)=2\\operatorname{cos}⁡2t+8\\operatorname{sin}⁡2t-{e}^{-t}(2\\operatorname{cos}⁡2t+9\\operatorname{sin}⁡2t).\n$$\n\nTo find the position of the particle after $\\pi $ seconds, we substitute into the equation $t=\\pi .$ We get\n\n$$\n\\begin{aligned}y(\\pi ) & =2\\operatorname{cos}⁡(2\\pi )+8\\operatorname{sin}⁡(2\\pi )-{e}^{-\\pi }(2\\operatorname{cos}⁡(2\\pi )+9\\operatorname{sin}⁡(2\\pi )) \\\\  & =2(1-{e}^{-\\pi })\\,\\text{in}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-64646/selection/ma-v1/096361e0fc4c01ac06901277a6d40ffdfc229c39a80c111cf3b0444df43bfd0e"] :db/ensure [:question/validate]} {:db/id "q-94304/selection/0cde7213d1e1ba3c98aefd0b0b3cd2806e45d0ed74e5b8251efd6e11b0b57d5b" :answer/id #uuid "304d1e3b-0149-57d9-8e07-5540441f57a6" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{2})=1\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-94304/selection/a47a7cb242c9c03d85735ac66563c40c4f15c828bdc43334468badfc8f708afa" :answer/id #uuid "653dc78d-776e-54c4-aba3-ad5f75074921" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{2})=\\frac{\\pi }{2}\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-94304/selection/eaac7a2a44d3917ee28944910c9a9c1afaab9b1d631707a5f84fc5b80149328c" :answer/id #uuid "bc64d8c9-7b22-5819-88c0-04031bdad27a" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{2})=0\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-94304/selection/bdb020ee4b4ad82d771e73ed8614590494deb5a5ab3119e61abaabb8986935c7" :answer/id #uuid "9778b203-1c02-5bee-bfb4-ebeece72fcbe" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{2})=\\frac{1}{2}\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-94304/selection/5229d35e6ea963bad83d7a13a9082603ad8608b16ddc393c8758eed7acf155fe" :answer/id #uuid "16fcb282-3ad8-560d-9d3e-a9fdbe2f1b8b" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{2})=2\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-94304/selection" :answer-field/id #uuid "7d7567ff-fa9e-5ccf-ae70-51ecef7ce9fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94304/selection/eaac7a2a44d3917ee28944910c9a9c1afaab9b1d631707a5f84fc5b80149328c" :answer-field/choices ["q-94304/selection/0cde7213d1e1ba3c98aefd0b0b3cd2806e45d0ed74e5b8251efd6e11b0b57d5b" "q-94304/selection/a47a7cb242c9c03d85735ac66563c40c4f15c828bdc43334468badfc8f708afa" "q-94304/selection/eaac7a2a44d3917ee28944910c9a9c1afaab9b1d631707a5f84fc5b80149328c" "q-94304/selection/bdb020ee4b4ad82d771e73ed8614590494deb5a5ab3119e61abaabb8986935c7" "q-94304/selection/5229d35e6ea963bad83d7a13a9082603ad8608b16ddc393c8758eed7acf155fe"] :db/ensure [:answer-field/validate]} {:db/id "q-94304" :question/id #uuid "1f3b61bf-2d9c-5a4f-b827-01f0e0d4bec0" :question/math-academy-id "q-94304" :question/problem "The position $y(t),$ measured in centimeters, of a particle oscillating with forced harmonic motion without damping is governed by the equation\n\n$$\n{y}^{″}+49y=-24\\operatorname{cos}⁡t,\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at the origin with zero velocity, find the position of the particle after $\\frac{\\pi }{2}$ seconds." :question/worked-solution "The general solution to the equation of forced harmonic motion without damping is the sum of the complementary function and a particular solution.\n\nThe complementary solution ${y}_{c}$ represents simple harmonic motion and can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration.\n\nIn our case,\n\n$$\n{\\omega }^{2}=49\\,⟹\\,\\omega =7.\n$$\n\nThus, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡7t+B\\operatorname{sin}⁡7t.\n$$\n\nWe now need to find the particular integral ${y}_{p}(t).$\n\nThe external force is $-24\\operatorname{cos}⁡t.$ Therefore, we assume that the particular integral is\n\n$$\n{y}_{p}=\\alpha \\operatorname{cos}⁡t+\\beta \\operatorname{sin}⁡t,\n$$\n\nwhere $\\alpha ,\\beta $ are constants to be determined.\n\nSubstituting ${y}_{p}$ into the differential equation and equating coefficients gives $\\alpha =-\\frac{1}{2},\\beta =0.$\n\nTherefore, the particular solution ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=-\\frac{1}{2}\\operatorname{cos}⁡t,\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡7t+B\\operatorname{sin}⁡7t-\\frac{1}{2}\\operatorname{cos}⁡t.\n$$\n\nSince the particle is initially at the origin with zero velocity, the initial conditions are $y(0)=0$ and ${y}^{′}(0)=0.$\n\nSolving with these conditions for $A$ and $B$ gives\n\n$$\nA=\\frac{1}{2},\\,B=0.\n$$\n\nSo our solution is\n\n$$\ny(t)=\\frac{1}{2}\\operatorname{cos}⁡7t-\\frac{1}{2}\\operatorname{cos}⁡t.\n$$\n\nTo find the position of the particle after $\\frac{\\pi }{2}$ seconds, we substitute into the equation $t=\\frac{\\pi }{2}.$ We get\n\n$$\n\\begin{aligned}y(\\frac{\\pi }{2}) & =\\frac{1}{2}\\operatorname{cos}⁡(\\frac{7\\pi }{2})-\\frac{1}{2}\\operatorname{cos}⁡(\\frac{\\pi }{2})=0\\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-94304/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5266e491-2718-56a9-b5a7-f4a86a8a01c7"] :knowledge-point/questions ["q-94304"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64643/selection/355e3a545599aa2635aa7c3f1df6cb00875f80c469544330c384dd290e4e371b" :answer/id #uuid "b59beb70-3ecf-5195-8b3c-91c505c0f95c" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{6})=(3+\\pi )\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64643/selection/363b21f6f0b1a0a942f924521d84beb65d58cefc00760aba967d07b617caf1c9" :answer/id #uuid "7e40abca-77c5-5180-ab48-de1fb14c43af" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{6})=\\frac{\\pi }{3}\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64643/selection/99ac0b15cf2f69d82a257ed6bc0a7293246259253e403e93ea9ab9c208f8057d" :answer/id #uuid "bd05c689-dfb8-5d1f-a635-bb0c0cc85d05" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{6})=(1-\\pi )\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64643/selection/808bc471a564c8b195be7c244cc9b59ac323553934e58ac82e26a266030e1bfb" :answer/id #uuid "5eb3f8b5-d423-5a9f-8698-8255f6a2a7b7" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{6})=(2-\\frac{\\pi }{3})\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64643/selection/9864b411f8d59a46133238c4cd83218985cbe284ec1ac7b2419b8440735e6d78" :answer/id #uuid "61d55f15-f9cd-5f97-8517-b8604c46b164" :answer/type :answer.type/math :answer/value "y(\\frac{\\pi }{6})=(1+\\frac{\\pi }{3})\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-64643/selection" :answer-field/id #uuid "80bfdcc7-9bb2-55b4-9b22-eabfa9b1ffbb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64643/selection/9864b411f8d59a46133238c4cd83218985cbe284ec1ac7b2419b8440735e6d78" :answer-field/choices ["q-64643/selection/355e3a545599aa2635aa7c3f1df6cb00875f80c469544330c384dd290e4e371b" "q-64643/selection/363b21f6f0b1a0a942f924521d84beb65d58cefc00760aba967d07b617caf1c9" "q-64643/selection/99ac0b15cf2f69d82a257ed6bc0a7293246259253e403e93ea9ab9c208f8057d" "q-64643/selection/808bc471a564c8b195be7c244cc9b59ac323553934e58ac82e26a266030e1bfb" "q-64643/selection/9864b411f8d59a46133238c4cd83218985cbe284ec1ac7b2419b8440735e6d78"] :db/ensure [:answer-field/validate]} {:db/id "q-64643" :question/id #uuid "77ef26fc-689a-5c81-bebc-1ad78410e558" :question/math-academy-id "q-64643" :question/problem "The position $y(t),$ measured in meters, of a particle oscillating with forced harmonic motion without damping is governed by the equation\n\n$$\n{y}^{″}+9y=12\\operatorname{cos}⁡3t,\n$$\n\nwhere $t>0$ is the time, in seconds. Given that the particle is initially at the origin with velocity $3\\,\\frac{\\text{m}}{\\text{s}}$, find the position of the particle after $\\frac{\\pi }{6}$ seconds." :question/worked-solution "The general solution to the equation of forced harmonic motion without damping is the sum of the complementary function and a particular solution.\n\nThe complementary solution ${y}_{c}$ represents simple harmonic motion and can be written as\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡\\omega t+B\\operatorname{sin}⁡\\omega t,\n$$\n\nwhere $A$ and $B$ are arbitrary constants of integration.\n\nIn our case,\n\n$$\n{\\omega }^{2}=9\\,⟹\\,\\omega =3.\n$$\n\nThus, we have\n\n$$\n{y}_{c}=A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t.\n$$\n\nWe now need to find the particular integral ${y}_{p}(t).$\n\nThe external force is $12\\operatorname{cos}⁡3t.$ The particular solution of the inhomogeneous equation cannot be of the form $\\alpha \\operatorname{cos}⁡3t+\\beta \\operatorname{sin}⁡3t$ because this is already included in the complimentary function. Therefore, we assume that the particular integral is  \n\n$$\n{y}_{p}=t(\\alpha \\operatorname{cos}⁡3t+\\beta \\operatorname{sin}⁡3t),\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants that are to be determined.  \n\nSubstituting ${y}_{p}$ into the differential equation and equating coefficients gives $\\alpha =0,\\beta =2.$\n\nTherefore, the particular solution ${y}_{p}(t)$ is\n\n$$\n{y}_{p}(t)=2t\\operatorname{sin}⁡3t,\n$$\n\nand the general solution is\n\n$$\ny=A\\operatorname{cos}⁡3t+B\\operatorname{sin}⁡3t+2t\\operatorname{sin}⁡3t=A\\operatorname{cos}⁡3t+(B+2t)\\operatorname{sin}⁡3t.\n$$\n\nSince the particle is initially at the origin with velocity $3\\,\\frac{\\text{m}}{\\text{s}}$, the initial conditions are $y(0)=0$ and ${y}^{′}(0)=3.$\n\nSolving with these conditions for $A$ and $B$ gives\n\n$$\nA=0,\\,B=1.\n$$\n\nSo our solution is\n\n$$\ny(t)=(1+2t)\\operatorname{sin}⁡3t.\n$$\n\nTo find the position of the particle after $\\frac{\\pi }{6}$ seconds, we substitute into the equation $t=\\frac{\\pi }{6}.$ We get\n\n$$\n\\begin{aligned}y(\\frac{\\pi }{6}) & =(1+2\\cdot \\frac{\\pi }{6})\\operatorname{sin}⁡\\frac{\\pi }{2} \\\\  & =(1+\\frac{\\pi }{3})\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64643/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5266e491-2718-56a9-b5a7-f4a86a8a01c7"] :knowledge-point/questions ["q-64643"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6731"] :question/problem "The function $y(t)$ gives the position of a particle at time $t > 0.$ Determine whether each equation is forced or free, and whether it is damped.\n\n- $y''+y'+3y = t$\n\n- $y''+ 4y = e^t$\n\n- $y''+y'+3y = 0$" :question/worked-solution "The differential equation\n\n$$\ny'' + b y' + \\omega^2 y = f(t)\n$$\n\nis forced if $f(t)$ is not identical to zero, and damped if $b>0.$\n\nWith that in mind, let's classify each equation.\n\n- Equation I represents forced harmonic motion with damping. The forcing function $f(t)=t$ is not always zero, and there is a damping term with $b=1>0.$\n\n- Equation II represents forced harmonic motion without damping. The forcing function $f(t)=e^t$ is not always zero, but there is no damping term since $b=0.$\n\n- Equation III represents free (non-forced) harmonic motion with damping. The forcing function $f(t)=0$ is always zero, and there is a damping term with $b=1>0.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6732"] :question/problem "A particle of mass $3\\,\\textrm{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k = 6\\, \\textrm{kg/s}^2.$  The particle is also subject to the resistive force that's proportional to the particle's velocity with a damping coefficient $c = 9\\, \\textrm{kg/s},$ and an external force given by $F(t)=3t^2\\,\\textrm{N}.$   \n\nThe position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with forced harmonic motion, what is the governing equation?" :question/worked-solution "The general equation of forced harmonic motion with damping is\n\n$$\nm y'' =-cy' -k y + F(t) .\n$$\n\nSubstituting our values for $m,$ $k,$ $c$ and $F(t)$ gives\n\n$$\n3 y'' =-9y' -6 y+3t^2.\n$$\n\nSimplifying and rearranging the above equation, we get\n\n$$\ny'' + 3y'+2y = t^2.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6733"] :question/problem "A particle is moving with forced harmonic motion with damping. The position of the particle $y(t)$ at time $t$ is governed by the equation\n\n$$\ny''+2y' + 5 y = 50t.\n$$\n\nWhich of the following could be used to represent the general solution for $y(t)?$\n\n- $y =Ae^{-t}+Be^{-2t}+25t+5$\n\n- $y = R e ^ {- t} \\cos \\left( 2t + \\phi \\right) +10t - 4$\n\n- $y =e^{-t}\\left( A\\cos{2t} + B\\sin{2t}\\right)+10 t-4$\n\nNote that $A$ and $B$ are constants." :question/worked-solution "The general solution is the sum of the complementary solution and the particular solution:\n\n$$\ny(t) = y_c(t)+y_p(t)\n$$\n\nFirst, we find the complementary solution $y_c(t),$ which is the solution to the homogeneous equation $y''+2y' + 5 y = 0.$ Writing down and solving the characteristic equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}+2\\lambda +5 & =0 \\\\ ({\\lambda }^{2}+2\\lambda +1)-1+5 & =0 \\\\ (\\lambda +1)^{2}+4 & =0 \\\\ (\\lambda +1)^{2} & =-4 \\\\ \\lambda +1 & =\\pm 2\\text{i} \\\\ \\lambda  & =-1\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore the complementary function $y_c(t)$ is can be expressed in any of the following forms:\n\n$$\n\\begin{aligned}{y}_{c}(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ), \\\\ {y}_{c}(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ).\\end{aligned}\n$$\n\nNext, we find the particular solution $y_p(t).$ Note that the external force $f(t)=50t$ is a linear function. Therefore, we assume that the particular solution is also a linear function,\n\n$$\ny_p(t)=\\alpha t+\\beta.\n$$\n\nBy substituting the particular solution into the differential equation and equating coefficients, we find that $\\alpha = 10$ and $\\beta = -4.$ So, the particular solution is\n\n$$\ny_p(t)= 10 t - 4.\n$$\n\nFinally, then, the general solution is given by the sum of the complementary and particular solutions. So, it can be written in any of the following forms:\n\n$$\n\\begin{aligned}y(t) & ={e}^{-t}(A\\operatorname{cos}⁡2t+B\\operatorname{sin}⁡2t)+10t-4, \\\\ y(t) & =R{e}^{-t}\\operatorname{cos}⁡(2t+ϕ)+10t-4, \\\\ y(t) & =R{e}^{-t}\\operatorname{sin}⁡(2t+ϕ)+10t-4.\\end{aligned}\n$$\n\nOnly II and III match the forms above. Therefore, the correct answer is \"II and III only\"." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6734"] :question/problem "The position $y(t),$ measured in meters, of a particle oscillating with forced harmonic motion without damping is governed by the equation\n\n$$\ny'' + y =2e^{-t},\n$$\n\nwhere $t > 0$ is the time, in seconds. Given that the particle is initially at the origin with zero velocity, find the position of the particle after $\\pi$ seconds." :question/worked-solution "This is an initial value problem. Since the particle is initially at the origin with zero velocity, the initial conditions are $y(0)=0$ and $y'(0)=0.$ So, we want to solve the initial value problem\n\n$$\ny'' + y =2e^{-t}, \\quad y(0)=0, \\quad y'(0)=0.\n$$\n\nFirst, we find the general solution of the differential equation. The complementary solution $y_c(t)$ represents simple harmonic motion and can be written as\n\n$$\ny_c=A\\cos{\\omega t} + B\\sin{\\omega t}.\n$$\n\nIn our case,\n\n$$\n\\omega^2 = 1\\qquad\\Longrightarrow\\qquad \\omega = 1,\n$$\n\nso we have\n\n$$\ny_c=A\\cos{t} + B\\sin{t}.\n$$\n\nNext, we find the particular solution $y_p(t).$ Note that the external force $f(t) = 2e^{-t}$ is an exponential function, and the constant factor in the exponent $(-1)$ is not a root of the auxiliary equation. Therefore, we assume a particular exponential solution of the form \n\n$$\ny_p = \\alpha  e^{-t},\n$$\n\nwhere $\\alpha$ is a constant to be determined. \n\nSubstituting $y_p$ into the differential equation and equating coefficients gives $\\alpha=1.$ Therefore, the particular solution $y_p(t)$ is\n\n$$\ny_p(t) =e^{-t},\n$$\n\nand the general solution is\n\n$$\ny=A\\cos{t} + B\\sin{t} + e^{-t}.\n$$\n\nFinally, we find the constants $A$ and $B$ using the initial conditions. Substituting $y(0)=0$ gives $A=-1,$ and differentiating $y$ and substituting $y'(0)=0$ gives $B=1.$\n\nSo, our solution is\n\n$$\ny(t)=-\\cos t + \\sin{t} +e^{-t}.\n$$\n\nTo find the position of the particle after $\\pi$ seconds, we substitute into the equation $t=\\pi$ and get\n\n$$\n\\begin{aligned}y(\\pi ) & =-\\operatorname{cos}⁡\\pi +\\operatorname{sin}⁡\\pi +{e}^{-\\pi } \\\\  & =(1+{e}^{-\\pi })\\,\\text{m}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
