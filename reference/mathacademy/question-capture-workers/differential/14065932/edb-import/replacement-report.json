    {
      "question": "e-6734",
      "field": null,
      "attribute": "question/problem",
      "old_sha256": "375c6b4780504912dd84e92195cd10fd6fa06958a70b31060a8020ee1148a501",
      "new_sha256": "45ccfd67b30fd1b04c596e230f5662908d00c59f8b3f1f8075967a3b3aaac093",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-6734",
          "field": null,
          "attribute": "question/problem",
          "value": "The position $y(t),$ measured in meters, of a particle oscillating with forced harmonic motion without damping is governed by the equation\n\n$$\ny'' + y =2e^{-t},\n$$\n\nwhere $t > 0$ is the time, in seconds. Given that the particle is initially at the origin with zero velocity, find the position of the particle after $\\pi$ seconds.",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065932/example-6734.json",
          "file_sha256": "5fad38c348143f5404970eff082170b7256f98d50d885a87114a772cec5b046f"
        }
      ],
      "basis": 2165,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14065932/edb-import/commit.edn",
