⁡3t} & =\\frac{3}{{s}^{2}+9},\\,s>0.\\end{aligned}\n$$\n\nTherefore, using the addition and multiplication properties of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{2s}{{s}^{2}+9}+\\frac{15}{{s}^{2}+9}} & =2{L}^{-1}{\\frac{s}{{s}^{2}+9}}+5{L}^{-1}{\\frac{3}{{s}^{2}+9}} \\\\  & =2\\operatorname{cos}⁡3t+5\\operatorname{sin}⁡3t.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{2s+15}{{s}^{2}+9}$ is $f(t)=2\\operatorname{cos}⁡3t+5\\operatorname{sin}⁡3t.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-89816/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc8133f2-cbc7-516f-96e6-1bd135fed5a8"] :knowledge-point/questions ["q-89816"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345614/selection/6279a5ead018118f49928305fbb12e352c1a9d1aa07a22e656f541432a52e396" :answer/id #uuid "fa095400-f791-5c5d-8e55-47251c36bcc6" :answer/type :answer.type/math :answer/value "\\frac{4}{3}\\operatorname{cos}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-345614/selection/e39cff6d76a4cec4b47bb44e81c1f48e37d011e773692153c49a0de2acb88f47" :answer/id #uuid "52a5996a-3c2b-5d47-a8a7-f244c08fc5aa" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\operatorname{cos}⁡4t" :db/ensure [:answer/validate]} {:db/id "q-345614/selection/02e44eed7b5488e13a7b83a297bdabf126eb80184e75d7008fa8550b3220c923" :answer/id #uuid "fab1fb5e-b3b1-5adc-8500-a0b6692f7e5a" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\operatorname{sin}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-345614/selection/2195720f424b58610f43ded8d71b53e686aed74065fb28f19b6bbd5f39ce3875" :answer/id #uuid "98ff6af8-7d0e-5964-9f79-c498ed17c441" :answer/type :answer.type/math :answer/value "\\frac{3}{4}\\operatorname{cos}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-345614/selection/0e20e8a8e6be4b1067ec5120cd4fac2e5fc5b4ef895647621a0b852d9f2bf1f6" :answer/id #uuid "826982d4-a82a-5f79-9294-03fa884333ee" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-345614/selection" :answer-field/id #uuid "8c3698c9-03b4-5de6-ba62-62c524f0f53a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-345614/selection/2195720f424b58610f43ded8d71b53e686aed74065fb28f19b6bbd5f39ce3875" :answer-field/choices ["q-345614/selection/6279a5ead018118f49928305fbb12e352c1a9d1aa07a22e656f541432a52e396" "q-345614/selection/e39cff6d76a4cec4b47bb44e81c1f48e37d011e773692153c49a0de2acb88f47" "q-345614/selection/02e44eed7b5488e13a7b83a297bdabf126eb80184e75d7008fa8550b3220c923" "q-345614/selection/2195720f424b58610f43ded8d71b53e686aed74065fb28f19b6bbd5f39ce3875" "q-345614/selection/0e20e8a8e6be4b1067ec5120cd4fac2e5fc5b4ef895647621a0b852d9f2bf1f6"] :db/ensure [:answer-field/validate]} {:db/id "q-345614" :question/id #uuid "b5397f8a-96ba-5c5b-8e3e-dff1adb6a98e" :question/math-academy-id "q-345614" :question/problem "${L}^{-1}{\\frac{3s}{4{s}^{2}+16}}=$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡2t} & =\\frac{s}{{s}^{2}+{2}^{2}}=\\frac{s}{{s}^{2}+4},\\,s>0.\\end{aligned}\n$$\n\nTherefore, by applying the inverse Laplace transform to the above result, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡2t} & =\\frac{s}{{s}^{2}+4} \\\\ {L}^{-1}{L{\\operatorname{cos}⁡2t}} & ={L}^{-1}{\\frac{s}{{s}^{2}+4}} \\\\ \\operatorname{cos}⁡2t & ={L}^{-1}{\\frac{s}{{s}^{2}+4}} \\\\ {L}^{-1}{\\frac{s}{{s}^{2}+4}} & =\\operatorname{cos}⁡2t.\\end{aligned}\n$$\n\nUsing the multiplicative property of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}\\frac{3}{4}\\cdot {L}^{-1}{\\frac{s}{{s}^{2}+4}}=\\frac{3}{4}\\operatorname{cos}⁡2t \\\\ {L}^{-1}{\\frac{3s}{4{s}^{2}+16}}=\\frac{3}{4}\\operatorname{cos}⁡2t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-345614/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a81eb74c-2bdd-58d3-9e9a-8979bdb86dd3"] :knowledge-point/questions ["q-345614"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64353/selection/0206d1f460c48d0b93f488083b16915fe2c0404ed146601bc5d93e1eb5bb02a6" :answer/id #uuid "827a5320-4f12-55b7-adbf-de7927cc15de" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=\\frac{1}{8}{u}_{2}(t)" :db/ensure [:answer/validate]} {:db/id "q-64353/selection/39341aa65e29365085fc25c31edf4646ff6bd9c07a3feb42d70a99e50890409a" :answer/id #uuid "2be2f533-9260-5d8e-bc74-8bfdfb9892e6" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=\\frac{1}{2}{u}_{8}(t)" :db/ensure [:answer/validate]} {:db/id "q-64353/selection/1f520d159908baae9d57d7287bee4807a9d0c60301ba47c5cb5e919d9be37530" :answer/id #uuid "aec50ed3-dbc9-5272-b77c-934a17db27af" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}={u}_{4}(t)" :db/ensure [:answer/validate]} {:db/id "q-64353/selection/2979a150c7e5315edef548da0b36d1b2e229d0d59f9b969c8772d12d7de4cf83" :answer/id #uuid "2df8fe55-7363-534e-a4b4-b9e33155678f" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=8{u}_{2}(t)" :db/ensure [:answer/validate]} {:db/id "q-64353/selection/00a7d46340a1da88f8e15b37f489f7d5dd87dac0bbb54d69f65562a9b123980c" :answer/id #uuid "e02f30c4-b7c3-58e6-a3b0-3642b52742e5" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=2{u}_{8}(t)" :db/ensure [:answer/validate]} {:db/id "q-64353/selection" :answer-field/id #uuid "6e9824be-1f30-58eb-9518-38df261ade30" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64353/selection/2979a150c7e5315edef548da0b36d1b2e229d0d59f9b969c8772d12d7de4cf83" :answer-field/choices ["q-64353/selection/0206d1f460c48d0b93f488083b16915fe2c0404ed146601bc5d93e1eb5bb02a6" "q-64353/selection/39341aa65e29365085fc25c31edf4646ff6bd9c07a3feb42d70a99e50890409a" "q-64353/selection/1f520d159908baae9d57d7287bee4807a9d0c60301ba47c5cb5e919d9be37530" "q-64353/selection/2979a150c7e5315edef548da0b36d1b2e229d0d59f9b969c8772d12d7de4cf83" "q-64353/selection/00a7d46340a1da88f8e15b37f489f7d5dd87dac0bbb54d69f65562a9b123980c"] :db/ensure [:answer-field/validate]} {:db/id "q-64353" :question/id #uuid "6d6ccce4-370d-593e-a702-26712d10cb51" :question/math-academy-id "q-64353" :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{8{e}^{-2s}}{s}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{u}_{2}(t)} & =\\frac{{e}^{-2s}}{s},\\,s>0,\\end{aligned}\n$$\n\nwhere ${u}_{2}(t)=u(t-2)$ is the unit step function.\n\nTherefore, by applying the inverse Laplace transform to the above result, we have\n\n$$\n\\begin{aligned}L{{u}_{2}(t)} & =\\frac{{e}^{-2s}}{s} \\\\ {L}^{-1}{L{{u}_{2}(t)}} & ={L}^{-1}{\\frac{{e}^{-2s}}{s}} \\\\ {u}_{2}(t) & ={L}^{-1}{\\frac{{e}^{-2s}}{s}} \\\\ {L}^{-1}{\\frac{{e}^{-2s}}{s}} & ={u}_{2}(t).\\end{aligned}\n$$\n\nUsing the multiplicative property of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}8\\cdot {L}^{-1}{\\frac{{e}^{-2s}}{s}}=8\\cdot {u}_{2}(t) \\\\ {L}^{-1}{\\frac{8{e}^{-2s}}{s}}=8{u}_{2}(t).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64353/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a81eb74c-2bdd-58d3-9e9a-8979bdb86dd3"] :knowledge-point/questions ["q-64353"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64348/selection/f573e9365586c701cdeaa6e23b482f7469a609131e98be6021e2b98fcf3ff542" :answer/id #uuid "147d8777-63e4-502d-bd0e-3caf614f088c" :answer/type :answer.type/math :answer/value "\\frac{1}{4}(t-2)" :db/ensure [:answer/validate]} {:db/id "q-64348/selection/a2bdef553d9db72586d0b48be1925c989fce55674b64494c7c88f47477dc6faf" :answer/id #uuid "467f6005-32dd-587c-8e3b-b240ce184186" :answer/type :answer.type/math :answer/value "2{e}^{4t}" :db/ensure [:answer/validate]} {:db/id "q-64348/selection/f1ae6f7a45156