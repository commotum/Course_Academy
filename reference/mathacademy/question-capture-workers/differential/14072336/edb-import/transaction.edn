{\\frac{1}{s-2}} & ={e}^{2t}.\\end{aligned}\n$$\n\nUsing the multiplicative property of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}4\\cdot {L}^{-1}{\\frac{1}{s-2}}=4\\cdot {e}^{2t} \\\\ {L}^{-1}{\\frac{4}{s-2}}=4{e}^{2t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64348/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a81eb74c-2bdd-58d3-9e9a-8979bdb86dd3"] :knowledge-point/questions ["q-64348"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345608/selection/9325c6dc5cb3418f9cb4666d85d5705759363b9edefad99ed8bf44ec233acbd1" :answer/id #uuid "4afde3fd-f9da-506d-b245-72ed2a6116d0" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}{t}^{4}" :db/ensure [:answer/validate]} {:db/id "q-345608/selection/d8a04d1259b50dd5b0560d9c26a3c5b38e833914a6cd0d954b17ecaebab24fbc" :answer/id #uuid "1d72ac8b-d30b-5a13-835c-294d38722ec3" :answer/type :answer.type/math :answer/value "{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-345608/selection/5401662953c8a194e1e5d7192fbec66045417e7e04a5a1c37feb06476706b1ab" :answer/id #uuid "2ff8fc12-c5b8-51c1-a30e-77df32edefe2" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-345608/selection/40b1765c046642720b9027eeaf0fe016b5f77165c1e62c5ea6a002492815067d" :answer/id #uuid "2fa7f66f-115b-5637-ae07-2c0d381f73eb" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-345608/selection/c0777e2fe8a5f09e6320e0f8f43689e48a062049a289577be8b263ce77cb8d80" :answer/id #uuid "f48b1c8f-eb1a-58e3-aadf-07e823f974a1" :answer/type :answer.type/math :answer/value "{t}^{4}" :db/ensure [:answer/validate]} {:db/id "q-345608/selection" :answer-field/id #uuid "6b3f7a55-2add-5c4e-b817-fbc34772eaf2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-345608/selection/5401662953c8a194e1e5d7192fbec66045417e7e04a5a1c37feb06476706b1ab" :answer-field/choices ["q-345608/selection/9325c6dc5cb3418f9cb4666d85d5705759363b9edefad99ed8bf44ec233acbd1" "q-345608/selection/d8a04d1259b50dd5b0560d9c26a3c5b38e833914a6cd0d954b17ecaebab24fbc" "q-345608/selection/5401662953c8a194e1e5d7192fbec66045417e7e04a5a1c37feb06476706b1ab" "q-345608/selection/40b1765c046642720b9027eeaf0fe016b5f77165c1e62c5ea6a002492815067d" "q-345608/selection/c0777e2fe8a5f09e6320e0f8f43689e48a062049a289577be8b263ce77cb8d80"] :db/ensure [:answer-field/validate]} {:db/id "q-345608" :question/id #uuid "eed483fc-3e22-55ec-a3a8-5ece7cf8b869" :question/math-academy-id "q-345608" :question/problem "Find the inverse Laplace transform for $F(s)=-\\frac{3}{2{s}^{4}}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{t}^{3}} & =\\frac{3!}{{s}^{3+1}}=\\frac{6}{{s}^{4}},\\,s>0.\\end{aligned}\n$$\n\nTherefore, by applying the inverse Laplace transform to the above result, we have\n\n$$\n\\begin{aligned}L{{t}^{3}} & =\\frac{6}{{s}^{4}} \\\\ {L}^{-1}{L{{t}^{3}}} & ={L}^{-1}{\\frac{6}{{s}^{4}}} \\\\ {t}^{3} & ={L}^{-1}{\\frac{6}{{s}^{4}}} \\\\ {L}^{-1}{\\frac{6}{{s}^{4}}} & ={t}^{3}.\\end{aligned}\n$$\n\nUsing the multiplicative property of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}-\\frac{1}{4}\\cdot {L}^{-1}{\\frac{6}{{s}^{4}}}={L}^{-1}{-\\frac{3}{2{s}^{4}}} \\\\ {L}^{-1}{-\\frac{3}{2{s}^{4}}}=-\\frac{1}{4}{t}^{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-345608/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a81eb74c-2bdd-58d3-9e9a-8979bdb86dd3"] :knowledge-point/questions ["q-345608"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345606/selection/0fecb953d78d2665a74da93490eb67523a55ad29efda6aab2c04731748d4d18f" :answer/id #uuid "74d5056b-ff99-53e0-9c06-2a5db0200c58" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-345606/selection/c5ad98556b70934f51782e5a9a0d433f934e12cf217e6d147924438567564dc2" :answer/id #uuid "27ba13ba-3156-53b4-b943-0cd2c262bac1" :answer/type :answer.type/math :answer/value "2{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-345606/selection/cb9ad14c4d0189695cf5d02baf58f5eec7ac941edc170f6dffed142cbab880f5" :answer/id #uuid "1241cf87-a48b-522b-bc74-c2de912d5fdc" :answer/type :answer.type/math :answer/value "{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-345606/selection/878f540530c7275537c7ca1e3b6b06a659254aa265d301b171fcf2844b820b57" :answer/id #uuid "32a24aed-a24c-5dbd-8890-ecf7411b3549" :answer/type :answer.type/math :answer/value "2{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-345606/selection/d8a04d1259b50dd5b0560d9c26a3c5b38e833914a6cd0d954b17ecaebab24fbc" :answer/id #uuid "58b25703-3f47-5fa6-8530-11817846330d" :answer/type :answer.type/math :answer/value "{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-345606/selection" :answer-field/id #uuid "7cf548cc-bdef-55a5-88c9-585ff8faa55c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-345606/selection/c5ad98556b70934f51782e5a9a0d433f934e12cf217e6d147924438567564dc2" :answer-field/choices ["q-345606/selection/0fecb953d78d2665a74da93490eb67523a55ad29efda6aab2c04731748d4d18f" "q-345606/selection/c5ad98556b70934f51782e5a9a0d433f934e12cf217e6d147924438567564dc2" "q-345606/selection/cb9ad14c4d0189695cf5d02baf58f5eec7ac941edc170f6dffed142cbab880f5" "q-345606/selection/878f540530c7275537c7ca1e3b6b06a659254aa265d301b171fcf2844b820b57" "q-345606/selection/d8a04d1259b50dd5b0560d9c26a3c5b38e833914a6cd0d954b17ecaebab24fbc"] :db/ensure [:answer-field/validate]} {:db/id "q-345606" :question/id #uuid "d62bb661-1f70-5bd2-a156-a0bc854be402" :question/math-academy-id "q-345606" :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{4}{{s}^{3}}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{t}^{2}} & =\\frac{2!}{{s}^{2+1}}=\\frac{2}{{s}^{3}},\\,s>0.\\end{aligned}\n$$\n\nTherefore, by applying the inverse Laplace transform to the above result, we have\n\n$$\n\\begin{aligned}L{{t}^{2}} & =\\frac{2}{{s}^{3}} \\\\ {L}^{-1}{L{{t}^{2}}} & ={L}^{-1}{\\frac{2}{{s}^{3}}} \\\\ {t}^{2} & ={L}^{-1}{\\frac{2}{{s}^{3}}} \\\\ {L}^{-1}{\\frac{2}{{s}^{3}}} & ={t}^{2}.\\end{aligned}\n$$\n\nUsing the multiplicative property of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}2\\cdot {L}^{-1}{\\frac{2}{{s}^{3}}}={L}^{-1}{\\frac{4}{{s}^{3}}} \\\\ {L}^{-1}{\\frac{4}{{s}^{3}}}=2{t}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-345606/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a81eb74c-2bdd-58d3-9e9a-8979bdb86dd3"] :knowledge-point/questions ["q-345606"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345623/selection/9e871dec9ceae0330d742ca05ff2db9d04275b0f8d339927a6c9544b2e17d567" :answer/id #uuid "1fe53b7d-d536-58f3-8069-2b9656899581" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}={e}^{4t}+{e}^{-5t}" :db/ensure [:answer/validate]} {:db/id "q-345623/selection/1a1d076d82e44bf44daa51f9c1c48ea91113fc3b86eecc4c34742d2fef86f3e5" :answer/id #uuid "ba7444d4-84a9-5a49-9c57-39a45904d7f5" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=-{e}^{-4t}+{e}^{5t}" :db/ensure [:answer/validate]} {:db/id "q-345623/selection/d6bcd361993d84131a1377be7e8d9ab54b4f328b91e09924103a595cce340136" :answer/id #uuid "795e9efa-bd9c-56dd-9899-fdcfbb17aa92" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=-{e}^{4t}+{e}^{-5t}" :db/ensure [:answer/validate]} {:db/id "q-345623/selection/201a5d352eae6b79f316a2cb695df4b3af1308a53336957c5ec6926f1d38a4b7" :answer/id #uuid "3a9f6552-9520-55a9-be6a-b2b785c81991" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=4{e}^{t}-5{e}^{-4t}" :db/ensure [:answer/validate]} {:db/id "q-345623/selection/f5932cd04e3ce9d0fc65a1f18ffd15d571a1fb108cb75834f39dbb86b329e659" :answer/id #uuid "d0647ae0-be36-53d3-bc35-687953969a08" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}={e}^{4t}-{e}^{-5t}" :db/ensure [:answer/validate]} {:db/id "q-345623/selection" :answer-field/id #uuid "e25ae2c3-3514-51e9-82c2-8edf48d3edb3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-345623/selection/f5932cd04e3ce9d0fc65a1f18ffd15d571a1fb108cb75834f39dbb86b329e659" :answer-field/choices ["q-345623/selection/9e871dec9ceae0330d742ca05ff2db9d04275b0f8d339927a6c9544b2e17d567" "q-345623/selection/1a1d076d82e44bf44daa51f9c1c48ea91113fc3b86eecc4c34742d2fef86f3e5" "q-345623/selection/d6bcd361993d84131a1377be7e8d9ab54b4f328b91e09924103a595cce340136" "q-345623/selection/201a5d352eae6b79f316a2cb695df4b3af1308a53336957c5ec6926f1d38a4b7" "q-345623/selection/f5932cd04e3ce9d0fc65a1f18ffd15d571a1fb108cb75834f39dbb86b329e659"] :db/ensure [:answer-field/validate]} {:db/id "q-345623" :question/id #uuid "e8bbfd15-f611-5044-a87b-e28a975cc360" :question/math-academy-id "q-345623" :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{9}{(s-4)(s+5)}.$" :question/worked-solution "First, we write $F(s)$ as a sum of partial fractions, as follows: \n\n$$\n\\frac{9}{(s-4)(s+5)}=\\frac{1}{s-4}-\\frac{1}{s+5}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{e}^{4t}} & =\\frac{1}{s-4},\\,s>4 \\\\ L{{e}^{-5t}} & =\\frac{1}{s+5},\\,s>-5.\\end{aligned}\n$$\n\nTherefore, using the addition property of the Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s-4}-\\frac{1}{s+5}} & ={L}^{-1}{\\frac{1}{s-4}}-{L}^{-1}{\\frac{1}{s+5}} \\\\  & ={e}^{4t}-{e}^{-5t}.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{9}{(s-4)(s+5)}$ is $f(t)={e}^{4t}-{e}^{-5t}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-345623/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb4b6a5f-9aed-5dad-9356-4038bf9c0acf"] :knowledge-point/questions ["q-345623"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89821/selection/d14a7de1ffe536ad06e316566281247f7d6e0c2112b6da7d1070b45512fb17f1" :answer/id #uuid "52957234-b54d-5e52-8eaf-cbd070aa240e" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=10{t}^{2}+{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-89821/selection/ee942ade405838fbb9a48eac484208bd7ddcabcabf3a39e1a5b595a63b7d5012" :answer/id #uuid "0f2f2313-849b-5152-876d-5f9a4a934e91" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=\\operatorname{sin}⁡2t-\\operatorname{cos}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-89821/selection/207ddfaabe790159069c5bb80af6ed48b5f27862e8deea6637117542854104a1" :answer/id #uuid "cf239e99-b16a-5eb1-9580-8400877cd9b7" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=2{e}^{2t}+3{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-89821/selection/a6cfffac6c7b189f0dbf6c99859c9ccfe97f3d05f4c38502c55711db8a826ebb" :answer/id #uuid "eb56e667-8d50-5aff-a8f0-148f0cab145a" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=2\\operatorname{cos}⁡2t-\\operatorname{sin}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-89821/selection/df14f13e85e41dbe61aa30dfc658dfc4f4dc049eb66b26ba8d1749593d02d57e" :answer/id #uuid "b81cdbfb-fffe-506d-897d-036d4628ca66" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=2{e}^{2t}-2{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-89821/selection" :answer-field/id #uuid "8f1ba755-d966-5f19-812a-8fa9e2542266" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89821/selection/df14f13e85e41dbe61aa30dfc658dfc4f4dc049eb66b26ba8d1749593d02d57e" :answer-field/choices ["q-89821/selection/d14a7de1ffe536ad06e316566281247f7d6e0c2112b6da7d1070b45512fb17f1" "q-89821/selection/ee942ade405838fbb9a48eac484208bd7ddcabcabf3a39e1a5b595a63b7d5012" "q-89821/selection/207ddfaabe790159069c5bb80af6ed48b5f27862e8deea6637117542854104a1" "q-89821/selection/a6cfffac6c7b189f0dbf6c99859c9ccfe97f3d05f4c38502c55711db8a826ebb" "q-89821/selection/df14f13e85e41dbe61aa30dfc658dfc4f4dc049eb66b26ba8d1749593d02d57e"] :db/ensure [:answer-field/validate]} {:db/id "q-89821" :question/id #uuid "c32439a8-2f0a-52f2-ba4c-04ee07df7da8" :question/math-academy-id "q-89821" :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{10}{(s-2)(s+3)}.$" :question/worked-solution "First, we write $F(s)$ as a sum of partial fractions, as follows: \n\n$$\n\\frac{10}{(s-2)(s+3)}=\\frac{2}{s-2}-\\frac{2}{s+3}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{e}^{2t}} & =\\frac{1}{s-2},\\,s>2 \\\\ L{{e}^{-3t}} & =\\frac{1}{s+3},\\,s>-3.\\end{aligned}\n$$\n\nTherefore, using the addition property of the Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{2}{s-2}-\\frac{2}{s+3}} & =2{L}^{-1}{\\frac{1}{s-2}}-2{L}^{-1}{\\frac{1}{s+3}} \\\\  & =2{e}^{2t}-2{e}^{-3t}.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{10}{(s-2)(s+3)}$ is $f(t)=2{e}^{2t}-2{e}^{-3t}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-89821/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb4b6a5f-9aed-5dad-9356-4038bf9c0acf"] :knowledge-point/questions ["q-89821"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89824/selection/42bb8ff9be198ded5530db39ac610944d6ecf9bce77f086e40e366f7d452fc10" :answer/id #uuid "64c766d8-4b41-5b55-91c6-dfd9fc095c01" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=\\frac{1}{2}{e}^{9t}-\\frac{1}{2}{e}^{-9t}" :db/ensure [:answer/validate]} {:db/id "q-89824/selection/e3aa936de98ed40b5323cd0b7cd6156556fcede3e8fc50e1519513d255210dd2" :answer/id #uuid "52458cc7-3050-5d9a-88d0-0b78ac7d1d41" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=\\operatorname{cos}⁡3t-\\operatorname{sin}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-89824/selection/c9ffb6d149133ce39a1a70735782c18a6c21a469fc187fc8c30736c0a55a0929" :answer/id #uuid "d39c2be3-e6e4-52b9-a886-7b755abbe118" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}={e}^{3t}-{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-89824/selection/842754d5ba81fb96be75041b377ec929b52628219f975bb676c9c3e9ef8ef399" :answer/id #uuid "e22b7ac3-df5d-5851-b586-85a5c78bc48f" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=\\frac{1}{6}{e}^{3t}-\\frac{1}{6}{e}^{-3t}" :db/ensure [:answer/validate]} {:db/id "q-89824/selection/44cb8da84e7dca58df3fa9bc8fe5667b5d7eca8eb9790a5d10a0450613afbcab" :answer/id #uuid "4eb08989-f226-524c-aacc-4afd55db7d81" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=1-{e}^{3t}" :db/ensure [:answer/validate]} {:db/id "q-89824/selection" :answer-field/id #uuid "9a4a4972-524f-5441-a339-4220201ef38b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89824/selection/842754d5ba81fb96be75041b377ec929b52628219f975bb676c9c3e9ef8ef399" :answer-field/choices ["q-89824/selection/42bb8ff9be198ded5530db39ac610944d6ecf9bce77f086e40e366f7d452fc10" "q-89824/selection/e3aa936de98ed40b5323cd0b7cd6156556fcede3e8fc50e1519513d255210dd2" "q-89824/selection/c9ffb6d149133ce39a1a70735782c18a6c21a469fc187fc8c30736c0a55a0929" "q-89824/selection/842754d5ba81fb96be75041b377ec929b52628219f975bb676c9c3e9ef8ef399" "q-89824/selection/44cb8da84e7dca58df3fa9bc8fe5667b5d7eca8eb9790a5d10a0450613afbcab"] :db/ensure [:answer-field/validate]} {:db/id "q-89824" :question/id #uuid "4eaf773d-1394-5e6f-85c6-d4046ea05b5d" :question/math-academy-id "q-89824" :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{1}{{s}^{2}-9}.$" :question/worked-solution "First, we write $F(s)$ as a sum of partial fractions, as follows: \n\n$$\n\\frac{1}{{s}^{2}-9}=\\frac{1}{(s-3)(s+3)}=\\frac{1}{6(s-3)}-\\frac{1}{6(s+3)}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{e}^{3t}} & =\\frac{1}{s-3},\\,s>3 \\\\ L{{e}^{-3t}} & =\\frac{1}{s+3},\\,s>-3.\\end{aligned}\n$$\n\nTherefore, using the addition property of the Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{6(s-3)}-\\frac{1}{6(s+3)}} & =\\frac{1}{6}{L}^{-1}{\\frac{1}{s-3}}-\\frac{1}{6}{L}^{-1}{\\frac{1}{s+3}} \\\\  & =\\frac{1}{6}{e}^{3t}-\\frac{1}{6}{e}^{-3t}.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{1}{{s}^{2}-9}$ is $f(t)=\\frac{1}{6}{e}^{3t}-\\frac{1}{6}{e}^{-3t}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-89824/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb4b6a5f-9aed-5dad-9356-4038bf9c0acf"] :knowledge-point/questions ["q-89824"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64381"] :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{6}{{s}^{2}-6s}.$" :question/worked-solution "First, we write $F(s)$ as a sum of partial fractions, as follows: \n\n$$\n\\frac{6}{{s}^{2}-6s}=\\frac{6}{s(s-6)}=\\frac{1}{s-6}-\\frac{1}{s}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{e}^{6t}} & =\\frac{1}{s-6},\\,s>6 \\\\ L{1} & =\\frac{1}{s},\\,s>0.\\end{aligned}\n$$\n\nTherefore, using the addition property of the Laplace transform, we get:\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s-6}-\\frac{1}{s}} & ={L}^{-1}{\\frac{1}{s-6}}-{L}^{-1}{\\frac{1}{s}} \\\\  & ={e}^{6t}-1.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{6}{{s}^{2}-6s}$ is $f(t)={e}^{6t}-1.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-89826/selection/1d627806e47c9b429fcf45e258e5b3b6f04eb34e64cbfa3074f7302643f7a775" :answer/id #uuid "5425feea-1e6c-5d83-a4f9-1fe0a5d1c681" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=t+\\operatorname{cos}⁡5t" :db/ensure [:answer/validate]} {:db/id "q-89826/selection/de1ad936cfefd94898f7f6e917403304d57276b340a69f2bf0edf0d6defeeb8b" :answer/id #uuid "f25c7f6e-ef3a-5ae1-a878-2b6dc356b470" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=1-{e}^{-5t}" :db/ensure [:answer/validate]} {:db/id "q-89826/selection/55ab36695927b3b28de2847c95723d60975b2470196ab3e44de543481ddbf837" :answer/id #uuid "42883f00-6d11-5c5b-be38-b23599c5e8e3" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=t-\\operatorname{sin}⁡5t" :db/ensure [:answer/validate]} {:db/id "q-89826/selection/eea9f95615c634e5d31fe38c22189f391acbc1f852e8c85b51602f4625a4188c" :answer/id #uuid "3c3dc4dc-faa3-58ad-9c4f-ff4331d1fed4" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=t+{t}^{2}{e}^{-5t}" :db/ensure [:answer/validate]} {:db/id "q-89826/selection/708309d56e2c2be13991d0b5ffeb90e86df627e1655c58fd290b4511900cc851" :answer/id #uuid "d16f580f-a38b-5632-8f37-8df34a676989" :answer/type :answer.type/math :answer/value "{L}^{-1}{F(s)}=1-5t" :db/ensure [:answer/validate]} {:db/id "q-89826/selection" :answer-field/id #uuid "9e2b3a95-b8eb-56af-a75e-3686864588a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89826/selection/de1ad936cfefd94898f7f6e917403304d57276b340a69f2bf0edf0d6defeeb8b" :answer-field/choices ["q-89826/selection/1d627806e47c9b429fcf45e258e5b3b6f04eb34e64cbfa3074f7302643f7a775" "q-89826/selection/de1ad936cfefd94898f7f6e917403304d57276b340a69f2bf0edf0d6defeeb8b" "q-89826/selection/55ab36695927b3b28de2847c95723d60975b2470196ab3e44de543481ddbf837" "q-89826/selection/eea9f95615c634e5d31fe38c22189f391acbc1f852e8c85b51602f4625a4188c" "q-89826/selection/708309d56e2c2be13991d0b5ffeb90e86df627e1655c58fd290b4511900cc851"] :db/ensure [:answer-field/validate]} {:db/id "q-89826" :question/id #uuid "94214f15-a4b1-50b9-9005-990ab0ea5ce5" :question/math-academy-id "q-89826" :question/problem "Find ${L}^{-1}{F(s)}$ for $F(s)=\\frac{5}{{s}^{2}+5s}.$" :question/worked-solution "First, we write $F(s)$ as a sum of partial fractions, as follows: \n\n$$\n\\frac{5}{{s}^{2}+5s}=\\frac{5}{s(s+5)}=\\frac{1}{s}-\\frac{1}{s+5}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{1} & =\\frac{1}{s},\\,s>0 \\\\ L{{e}^{-5t}} & =\\frac{1}{s+5},\\,s>-5.\\end{aligned}\n$$\n\nTherefore, using the addition property of the Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{1}{s}-\\frac{1}{s+5}} & ={L}^{-1}{\\frac{1}{s}}-{L}^{-1}{\\frac{1}{s+5}} \\\\  & =1-{e}^{-5t}.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{5}{{s}^{2}+5s}$ is $f(t)=1-{e}^{-5t}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-89826/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb4b6a5f-9aed-5dad-9356-4038bf9c0acf"] :knowledge-point/questions ["q-89826"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6653"] :question/problem "Find the inverse Laplace transform for $F(s) = \\dfrac{3}{s^2 + 9}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡3t} & =\\frac{3}{{s}^{2}+{3}^{2}}=\\frac{3}{{s}^{2}+9},\\,s>0.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{3}{{s}^{2}+9}} & ={L}^{-1}{L{\\operatorname{sin}⁡3t}} \\\\  & =\\operatorname{sin}⁡3t.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6655"] :question/problem "Find $\\mathcal{L}^{-1}\\left\\{F(s)\\right\\}$ for $F(s)=\\dfrac{4e^{-s}-2}{s}.$" :question/worked-solution "First, we decompose the fraction into a sum of partial fractions:\n\n$$\n\\dfrac{4e^{-s}-2}{s} =\\dfrac{4e^{-s}}{s} - \\dfrac{2}{s}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{u}_{1}(t)} & =\\frac{{e}^{-s}}{s},\\,s>0, \\\\ L{1} & =\\frac{1}{s},\\,s>0,\\end{aligned}\n$$\n\nwhere $u_1(t)=u(t-1)$ is the unit step function.\n\nTherefore, using the addition and scalar multiplication properties of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{4{e}^{-s}}{s}-\\frac{2}{s}} & =4{L}^{-1}{\\frac{{e}^{-s}}{s}}-2{L}^{-1}{\\frac{1}{s}} \\\\  & =4{u}_{1}(t)-2.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\dfrac{4e^{-s}-2}{s}$ is\n\n$$\n\\mathcal{L}^{-1}\\left\\{F(s)\\right\\} = f(t)= 4 u_1(t) - 2.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6654"] :question/problem "Compute $\\mathcal{L}^{-1}\\left\\{\\dfrac{7}{s - 9}\\right\\}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{e}^{9t}} & =\\frac{1}{s-9},\\,s>9.\\end{aligned}\n$$\n\nTherefore, by applying the inverse Laplace transform to the above result, we have\n\n$$\n\\begin{aligned}L{{e}^{9t}} & =\\frac{1}{s-9} \\\\ {L}^{-1}{L{{e}^{9t}}} & ={L}^{-1}{\\frac{1}{s-9}} \\\\ {e}^{9t} & ={L}^{-1}{\\frac{1}{s-9}} \\\\ {L}^{-1}{\\frac{1}{s-9}} & ={e}^{9t}.\\end{aligned}\n$$\n\nUsing the multiplicative property of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}7\\cdot {L}^{-1}{\\frac{1}{s-9}}=7\\cdot {e}^{9t} \\\\ {L}^{-1}{\\frac{7}{s-9}}=7{e}^{9t}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6656"] :question/problem "Find the inverse Laplace transform for $F(s)=\\dfrac{3s}{(s-4)(s+2)}.$" :question/worked-solution "First, we write $F(s)$ as a sum of partial fractions:\n\n$$\n\\dfrac{3s}{(s-4)(s+2)} = \\dfrac{2}{s-4} + \\dfrac{1}{s+2}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{e}^{4t}} & =\\frac{1}{s-4},\\,s>4, \\\\ L{{e}^{-2t}} & =\\frac{1}{s+2},\\,s>-2.\\end{aligned}\n$$\n\nTherefore, using the addition and scalar multiplication properties of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{2}{s-4}+\\frac{1}{s+2}} & =2{L}^{-1}{\\frac{1}{s-4}}+{L}^{-1}{\\frac{1}{s+2}} \\\\  & =2{e}^{4t}+{e}^{-2t}.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\dfrac{3s}{(s-4)(s+2)}$ is\n\n$$\n\\mathcal{L}^{-1}\\left\\{ F(s) \\right\\} = f(t)=2e^{4t} + e^{-2t}.\n$$" :db/ensure [:question/validate]}]
