\\frac{2}{{s}^{3}},\\,s>0, \\\\ L{1} & =\\frac{1}{s},\\,s>0.\\end{aligned}\n$$\n\nTherefore, using the addition and multiplication properties of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{10}{{s}^{3}}+\\frac{3}{s}} & =5{L}^{-1}{\\frac{2}{{s}^{3}}}+3{L}^{-1}{\\frac{1}{s}} \\\\  & =5{t}^{2}+3.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{10+3{s}^{2}}{{s}^{3}}$ is $f(t)=5{t}^{2}+3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64359/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc8133f2-cbc7-516f-96e6-1bd135fed5a8"] :knowledge-point/questions ["q-64359"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345588/selection/265e9f4f777df961b99b4426050dfe73b108407775b750f260bd4ce830af7c33" :answer/id #uuid "58dbeb80-8913-5555-b0ab-8ea50361dd6e" :answer/type :answer.type/math :answer/value "6\\operatorname{sin}⁡3t-5\\operatorname{cos}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-345588/selection/684bf426c88d9986cabf0bb12a60300ee94d829410b9be61affaf24c1b9d24de" :answer/id #uuid "834082b6-38d6-5380-a05f-cf89f6d4871b" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡3t-5\\operatorname{cos}⁡6t" :db/ensure [:answer/validate]} {:db/id "q-345588/selection/69040cc10085448980f88853783da0d96a81489ae1aa207d89128fca61e5f491" :answer/id #uuid "c9270343-c620-54ca-90ab-dcd8a92f08f7" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡3t+5\\operatorname{cos}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-345588/selection/d4efc348f19482413e76be83e71ec5aa188d6cf41019c966787538adad62a544" :answer/id #uuid "8ea3ac86-055b-52ef-a5a0-e72483805576" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡3t-5\\operatorname{cos}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-345588/selection/2fffd5bd068d025ff5812c1698ff1d558c700764766169ab6b66ef486c734734" :answer/id #uuid "181137cd-5675-5e93-b72c-4253ea916d9d" :answer/type :answer.ty