stion/difficulty :question.difficulty/moderate :question/answer-fields ["q-345587/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9446e200-ba31-55b4-8c83-b512f45e0c92"] :knowledge-point/questions ["q-345587"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89818/selection/cfee8e5d9681c422a243bbbeb4a7420dda4ee8c40baadc5cd9517470580501f5" :answer/id #uuid "1af91930-fb86-5e68-b261-3062ee0ac5a8" :answer/type :answer.type/math :answer/value "{u}_{4}(t)+{u}_{5}(t)" :db/ensure [:answer/validate]} {:db/id "q-89818/selection/df5f02c6ebfb2d7be09c5640b5ca9498ad9551b4263966d96664a3a140405631" :answer/id #uuid "910364db-07b6-5c00-bb95-fa7d825f1b0e" :answer/type :answer.type/math :answer/value "2{u}_{9}(t)" :db/ensure [:answer/validate]} {:db/id "q-89818/selection/a1664ab97723740d026c00e4b8bbe7aa014093149b89f0020d6b02144e4261f6" :answer/id #uuid "15f49464-41e0-5715-8d8f-be2104ddb10d" :answer/type :answer.type/math :answer/value "2{u}_{8}(t)+{e}^{5t}" :db/ensure [:answer/validate]} {:db/id "q-89818/selection/8230e8a85b674f03c7daf3edc54e1d3112ca607654140b429672fdb15ed69816" :answer/id #uuid "a3dfdbd7-8a78-5548-903d-4b7ac4835746" :answer/type :answer.type/math :answer/value "2{u}_{8}(t)+{u}_{5}(t)" :db/ensure [:answer/validate]} {:db/id "q-89818/selection/e1f472f2fccbb06b5be3e23c2a91cadf1596d57f7ace66055b67f04f9ed66b51" :answer/id #uuid "5fbc87fa-e9ef-5664-9f28-8ae1f908e121" :answer/type :answer.type/math :answer/value "t{e}^{8t}+{u}_{5}(t)" :db/ensure [:answer/validate]} {:db/id "q-89818/selection" :answer-field/id #uuid "07183a77-c804-5a34-8ee5-218d04b24d66" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89818/selection/8230e8a85b674f03c7daf3edc54e1d3112ca607654140b429672fdb15ed69816" :answer-field/choices ["q-89818/selection/cfee8e5d9681c422a243bbbeb4a7420dda4ee8c40baadc5cd9517470580501f5" "q-89818/selection/df5f02c6ebfb2d7be09c5640b5ca9498ad9551b4263966d96664a3a140405631" "q-89818/selection/a1664ab97723740d026c00e4b8bbe7aa014093149b89f0020d6b02144e4261f6" "q-89818/selection/8230e8a85b674f03c7daf3edc54e1d3112ca607654140b429672fdb15ed69816" "q-89818/selection/e1f472f2fccbb06b5be3e23c2a91cadf1596d57f7ace66055b67f04f9ed66b51"] :db/ensure [:answer-field/validate]} {:db/id "q-89818" :question/id #uuid "1a9607cc-f122-593a-bac9-a336dbce5bfa" :question/math-academy-id "q-89818" :question/problem "Find ${L}^{-1}{F(s)}$ for $F(s)=\\frac{2{e}^{-8s}+{e}^{-5s}}{s}.$" :question/worked-solution "We decompose the fraction into a sum of fractions, as follows:\n\n$$\n\\frac{2{e}^{-8s}+{e}^{-5s}}{s}=\\frac{2{e}^{-8s}}{s}+\\frac{{e}^{-5s}}{s}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{u}_{8}(t)} & =\\frac{{e}^{-8s}}{s},\\,s>0 \\\\ L{{u}_{5}(t)} & =\\frac{{e}^{-5s}}{s},\\,s>0,\\end{aligned}\n$$\n\nwhere ${u}_{5}(t)=u(t-5)$ and ${u}_{8}(t)=u(t-8)$ are the unit step functions.\n\nTherefore, using the addition and multiplication properties of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{2{e}^{-8s}}{s}+\\frac{{e}^{-5s}}{s}} & =2{L}^{-1}{\\frac{{e}^{-8s}}{s}}+{L}^{-1}{\\frac{{e}^{-5s}}{s}} \\\\  & =2{u}_{8}(t)+{u}_{5}(t).\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{2{e}^{-8s}+{e}^{-5s}}{s}$ is $f(t)=2{u}_{8}(t)+{u}_{5}(t).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-89818/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc8133f2-cbc7-516f-96e6-1bd135fed5a8"] :knowledge-point/questions ["q-89818"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64359/selection/fcab04baf2af8257876d225d72550dec0f31c1c276fba7e8aa4638d7d9b50d19" :answer/id #uuid "717d40fe-4ba0-598c-bff9-f73b25e3e6da" :answer/type :answer.type/math :answer/value "5{t}^{2}+3" :db/ensure [:answer/validate]} {:db/id "q-64359/selection/5821955665fd3cf5be4b192d1f6311e7bb51003e2c765eed8ccfd49acf1fe4d5" :answer/id #uuid "cbd47f9b-11bb-5b4c-a238-d98af68b7d13" :ans