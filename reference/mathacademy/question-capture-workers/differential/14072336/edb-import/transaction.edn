 & ={L}^{-1}{\\frac{4}{3s+6}} \\\\ \\frac{4}{3}{e}^{-2t} & ={L}^{-1}{\\frac{4}{3s+6}} \\\\ {L}^{-1}{\\frac{4}{3s+6}} & =\\frac{4}{3}{e}^{-2t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-345579/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9446e200-ba31-55b4-8c83-b512f45e0c92"] :knowledge-point/questions ["q-345579"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345578/selection/60870beeeaba2fba9075490fab83ba7e285a3a05bc1ded2e88b5038875842245" :answer/id #uuid "949b3644-6168-519c-aabe-36e86d2cc8ec" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-345578/selection/cb9ad14c4d0189695cf5d02baf58f5eec7ac941edc170f6dffed142cbab880f5" :answer/id #uuid "a772f12f-aa38-542e-a9ec-3d93db870aca" :answer/type :answer.type/math :answer/value "{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-345578/selection/bc8f0e3448dcfc9709b227e0f1c0ef0cd4cfa187cc7dc2d94eb35715e73d0f10" :answer/id #uuid "011980ae-e017-58cb-9490-f3f022e2395c" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-345578/selection/50f79e28cae3308a6bb15b96ca99784003062f85877a228e8a5ed7a363914f7b" :answer/id #uuid "ca542323-ab02-53eb-82d4-3468434a6f06" :answer/type :answer.type/math :answer/value "{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-345578/selection/3b1324b6e114e75822b7d4776ebc4b557446616ea199793c086913b62c2790e5" :answer/id #uuid "7964c6fa-f9e1-593a-b63b-91d5cfec3927" :answer/type :answer.type/math :answer/value "\\frac{3}{2}{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-345578/selection" :answer-field/id #uuid "b9466531-ff06-5bed-98cb-c8e7675ac1bb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-345578/selection/3b1324b6e114e75822b7d4776ebc4b557446616ea199793c086913b62c2790e5" :answer-field/choices ["q-345578/selection/60870beeeaba2fba9075490fab83ba7e285a3a05bc1ded2e88b5038875842245" "q-345578/selection/cb9ad14c4d0189695cf5d02baf58f5eec7ac941edc170f6dffed142cbab880f5" "q-345578/selection/bc8f0e3448dcfc9709b227e0f1c0ef0cd4cfa187cc7dc2d94eb35715e73d0f10" "q-345578/selection/50f79e28cae3308a6bb15b96ca99784003062f85877a228e8a5ed7a363914f7b" "q-345578/selection/3b1324b6e114e75822b7d4776ebc4b557446616ea199793c086913b62c2790e5"] :db/ensure [:answer-field/validate]} {:db/id "q-345578" :question/id #uuid "0e670e88-2c44-511f-9351-40c005009907" :question/math-academy-id "q-345578" :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{3}{2s-4}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{\\frac{3}{2}{e}^{2t}} & =\\frac{3}{2}\\cdot \\frac{1}{s-2}=\\frac{3}{2s-4},\\,s>2.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}L{\\frac{3}{2}{e}^{2t}} & =\\frac{3}{2s-4} \\\\ {L}^{-1}{L{\\frac{3}{2}{e}^{2t}}} & ={L}^{-1}{\\frac{3}{2s-4}} \\\\ \\frac{3}{2}{e}^{2t} & ={L}^{-1}{\\frac{3}{2s-4}} \\\\ {L}^{-1}{\\frac{3}{2s-4}} & =\\frac{3}{2}{e}^{2t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-345578/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9446e200-ba31-55b4-8c83-b512f45e0c92"] :knowledge-point/questions ["q-345578"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345587/selection/a2be1aa4960887ad077d0760b402372e0dcf8389b786a3f539484a5a85dd5285" :answer/id #uuid "22a07863-5e7e-584c-82c6-5ba3312aeddc" :answer/type :answer.type/math :answer/value "4{e}^{-t}" :db/ensure [:answer/validate]} {:db/id "q-345587/selection/d86543c46b9c8691cdb0a6e66b4fcdaa08120d5f7372274641d78562261d7874" :answer/id #uuid "b4ae337e-a629-5051-852a-8c6c65015c75" :answer/type :answer.type/math :answer/value "{u}_{1}(t)" :db/ensure [:answer/validate]} {:db/id "q-345587/selection/f2706b83017897a497fbbb2e2c6c613ab36f3ae7c15502bce592ede2da9366ad" :answer/id #uuid "4d50a2d2-2bb5-592