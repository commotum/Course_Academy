928e20aa73bd3cb178dbd" "q-89820/selection/6ec1218680e7194d5a64a410884090412f1d3534db84ffee7c4cdc62a070a3f4"] :db/ensure [:answer-field/validate]} {:db/id "q-89820" :question/id #uuid "ab2c0b19-e441-5d4b-912c-e8299ee580ee" :question/math-academy-id "q-89820" :question/problem "Find ${L}^{-1}{F(s)}$ for $F(s)=\\frac{8{s}^{3}-24}{{s}^{5}}.$" :question/worked-solution "We decompose the fraction into a sum of partial fractions, as follows:\n\n$$\n\\frac{8{s}^{3}-24}{{s}^{5}}=\\frac{8}{{s}^{2}}-\\frac{24}{{s}^{5}}\n$$\n\nFrom the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{t} & =\\frac{1}{{s}^{2}},\\,s>0, \\\\ L{{t}^{4}} & =\\frac{24}{{s}^{5}},\\,s>0.\\end{aligned}\n$$\n\nTherefore, using the addition and multiplication properties of the inverse Laplace transform, we get\n\n$$\n\\begin{aligned}{L}^{-1}{\\frac{8}{{s}^{2}}-\\frac{24}{{s}^{5}}} & =8{L}^{-1}{\\frac{1}{{s}^{2}}}-{L}^{-1}{\\frac{24}{{s}^{5}}} \\\\  & =8t-{t}^{4}.\\end{aligned}\n$$\n\nSo the inverse Laplace transform of $F(s)=\\frac{8{s}^{3}-24}{{s}^{5}}$ is $f(t)=8t-{t}^{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-89820/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc8133f2-cbc7-516f-96e6-1bd135fed5a8"] :knowledge-point/questions ["q-89820"] :db/ensure [:knowledge-point/validate]} {:db/id "q-89816/selection/055272b68ac84b6daeb4490b9d696aa6af2b010e3e2f41f518e3206a49e3cb61" :answer/id #uuid "fbe6b3f2-6554-55a6-a56c-5ffb161ed890" :answer/type :answer.type/math :answer/value "3\\operatorname{cos}⁡2t+3\\operatorname{sin}⁡2t" :db/ensure [:answer/validate]} {:db/id "q-89816/selection/19ebc41b4b4008b4c5a6dfb373477ffbf2a5e3294e895bed9454251b12422628" :answer/id #uuid "69c59d25-4b65-5ab9-9ae6-e600cd200de9" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡3t+5\\operatorname{sin}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-89816/selection/a555f4e5be99aa1832e1e4c567f492c2ab163db0acfdf1538eda763f5696db6a" :answer/id 