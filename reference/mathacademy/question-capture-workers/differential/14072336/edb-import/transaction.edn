[{:db/id [:question/math-academy-id "q-78055"] :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{1}{s-5}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{e}^{5t}} & =\\frac{1}{s-5},\\,s>5.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}L{{e}^{5t}} & =\\frac{1}{s-5} \\\\ {L}^{-1}{L{{e}^{5t}}} & ={L}^{-1}{\\frac{1}{s-5}} \\\\ {e}^{5t} & ={L}^{-1}{\\frac{1}{s-5}} \\\\ {L}^{-1}{\\frac{1}{s-5}} & ={e}^{5t}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-89811/selection/91156a4aa29080099e38ef6c0d49e3e3e0392dbcbfb2a7fcb585a17df3d2acc7" :answer/id #uuid "7faf3124-2b0f-56f0-afb0-a06f8035e1e2" :answer/type :answer.type/math :answer/value "{u}_{4}(t)" :db/ensure [:answer/validate]} {:db/id "q-89811/selection/40e81872a26015a7f11dd042f76916362b9e83d0ab483ba7242a1b67f73b2698" :answer/id #uuid "4027cfe4-ac9a-5143-bb2e-ac69a5e80843" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡4t" :db/ensure [:answer/validate]} {:db/id "q-89811/selection/a1ebd2482f5be58f7e4d544dab368c68ef21eb68b1b06c10c7f2bdd815b52cfb" :answer/id #uuid "d2cde186-20bf-563d-94f6-837d2104868a" :answer/type :answer.type/math :answer/value "{e}^{-4t}" :db/ensure [:answer/validate]} {:db/id "q-89811/selection/b4239d16936048eb391c644be2002b17664289a58c5d9ec2d1e36380c7f05632" :answer/id #uuid "b19b91bc-a02b-5afa-bbc9-9cfcee856b8f" :answer/type :answer.type/math :answer/value "-{u}_{4}(t)" :db/ensure [:answer/validate]} {:db/id "q-89811/selection/f0c615ba9a86378150e643e39f2c70775737cabfa04fd368a0a79fa2ee83eddc" :answer/id #uuid "1e4abe95-c10a-5357-8241-f27d9828491e" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡4t" :db/ensure [:answer/validate]} {:db/id "q-89811/selection" :answer-field/id #uuid "a0bff623-38c7-5662-a2e1-1c0cdb474e00" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-89811/selection/91156a4aa29080099e38ef6c0d49e3e3e0392dbcbfb2a7fcb585a17df3d2acc7" :answer-field/choices ["q-89811/selection/91156a4aa29080099e38ef6c0d49e3e3e0392dbcbfb2a7fcb585a17df3d2acc7" "q-89811/selection/40e81872a26015a7f11dd042f76916362b9e83d0ab483ba7242a1b67f73b2698" "q-89811/selection/a1ebd2482f5be58f7e4d544dab368c68ef21eb68b1b06c10c7f2bdd815b52cfb" "q-89811/selection/b4239d16936048eb391c644be2002b17664289a58c5d9ec2d1e36380c7f05632" "q-89811/selection/f0c615ba9a86378150e643e39f2c70775737cabfa04fd368a0a79fa2ee83eddc"] :db/ensure [:answer-field/validate]} {:db/id "q-89811" :question/id #uuid "fa14a9bb-ea3d-5cf4-8709-0efce10b7ca3" :question/math-academy-id "q-89811" :question/problem "Find the inverse Laplace transform for $F(s)=\\frac{{e}^{-4s}}{s}.$" :question/worked-solution "From the table of Laplace transforms, we have\n\n$$\n\\begin{aligned}L{{u}_{4}(t)} & =\\frac{{e}^{-4s}}{s},\\,s>0.\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}L{{u}_{4}(t)} & =\\frac{{e}^{-4s}}{s} \\\\ {L}^{-1}{L{{u}_{4}(t)}} & ={L}^{-1}{\\frac{{e}^{-4s}}{s}} \\\\ {u}_{4}(t) & ={L}^{-1}{\\frac{{e}^{-4s}}{s}} \\\\ {L}^{-1}{\\frac{{e}^{-4s}}{s}} & ={u}_{4}(t).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-89811/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9446e200-ba31-55b4-8c83-b512f45e0c92"] :knowledge-point/questions ["q-89811"] :db/ensure [:knowledge-point/validate]} {:db/id "q-345579/selection/c58e1c9047259081a2b97e38a59356a329b76699fe9fa5ffb3212f2bed6e8d6c" :answer/id #uuid "b5ae7c73-4e65-55b8-a25d-627c324a04b5" :answer/type :answer.type/math :answer/value "\\frac{4}{3}{e}^{2t}" :db/ensure [:answer/validate]} {:db/id "q-345579/selection/135937094a72376156c720d7c7b03b21c2655ece8b46e1465df53fe778649fd5" :answer/id #uuid "2448cfbf-9b76-5c65-88e6-644249a908c3" :answer/type :answer.type/math :answer/value "-\\frac{4}{3}{e}^{-2t}" :db/ensure [:answer/validate]} {:db/id "q-345579/selectio