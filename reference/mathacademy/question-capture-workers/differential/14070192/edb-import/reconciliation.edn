e/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335463" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335463" "field" "field-3" "attribute" "answer-field/choices" "value" [["text" "always converge to the equilibrium as $t\\to \\infty $"] ["text" "may not converge to the equilibrium as $t\\to \\infty $"] ["text" "never converge to the equilibrium as $t\\to \\infty $"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335463" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/text "always converge to the equilibrium as $t\\to \\infty $"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335647" "field" nil "attribute" "question/problem" "value" "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+y(t)+2 \\\\ {y}^{′}(t)={x}^{2}(t)-2y(t)-4\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of differential equations above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335647" "field" nil "attribute" "question/worked-solution" "value" "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of equations:\n\n$$\n{\\begin{aligned}x+y+2=0 \\\\ {x}^{2}-2y-4=0\\end{aligned}\n$$\n\nNow, we solve the first equation for $y:$\n\n$$\n\\begin{aligned}x+y+2=0\\,⇒\\,y=-x-2\\end{aligned}\n$$\n\nNext, we substitute $y$ into the second equation\n\n$$\n\\begin{aligned}{x}^{2}-2y-4 & =0 \\\\ {x}^{2}-2(-x-2)-4 & =0 \\\\ {x}^{2}+2x+4-4 & =0 \\\\ {x}^{2}+2x & =0 \\\\ x(x+2) & =0 \\\\ x & =-2,\\text{ }0.\\end{aligned}\n$$\n\nNow, we compute $y:$\n\n- For $x=0,$ we get $y=-0-2=-2.$\n\n- For $x=-2,$ we get $y=-(-2)-2=0.$\n\nTherefore, the equilibrium points are\n\n$$\n[\\begin{aligned}0 \\\\ -2\\end{aligned}]\\,\\text{and}\\,[\\begin{aligned}-2 \\\\ 0\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335647" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/activity-metadata.json" "file_sha256" "6f26fb5b462faa6c663403542092214c015f12ea9ea35835f3e87bbeedf15416"} {"question" "q-335647" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335647" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$[\\begin{aligned}-2 \\\\ 0\\end{aligned}]$ only"] ["text" "$[\\begin{aligned}0 \\\\ -2\\end{aligned}]$\nand \n$[\\begin{aligned}-2 \\\\ 0\\end{aligned}]$"] ["text" "$[\\begin{aligned}0 \\\\ -2\\end{aligned}]$\nand \n$[\\begin{aligned}2 \\\\ -2\\end{aligned}]$"] ["text" "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$\nand \n$[\\begin{aligned}2 \\\\ -2\\end{aligned}]$"] ["text" "$[\\begin{aligned}2 \\\\ -4\\end{aligned}]$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335647" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$[\\begin{aligned}0 \\\\ -2\\end{aligned}]$\nand \n$[\\begin{aligned}-2 \\\\ 0\\end{aligned}]$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335657" "field" nil "attribute" "question/problem" "value" "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+y(t)-1 \\\\ {y}^{′}(t)={y}^{3}(t)+x(t)-1\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of differential equations above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335657" "field" nil "attribute" "question/worked-solution" "value" "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of equations:\n\n$$\n{\\begin{aligned}x+y-1=0 \\\\ {y}^{3}+x-1=0\\end{aligned}\n$$\n\nNow, we solve the first equation for $x:$\n\n$$\n\\begin{aligned}x+y-1=0\\,⇒\\,x=1-y\\end{aligned}\n$$\n\nNext, we substitute $x$ into the second equation\n\n$$\n\\begin{aligned}{y}^{3}+x-1 & =0 \\\\ {y}^{3}+(1-y)-1 & =0 \\\\ {y}^{3}-y & =0 \\\\ y({y}^{2}-1) & =0 \\\\ y(y-1)(y+1) & =0 \\\\ y & =-1,\\text{ }0,\\text{ }1.\\end{aligned}\n$$\n\nNow, we compute $x:$\n\n- For $y=0,$ we get $x=1-0=1.$\n\n- For $y=1,$ we get $x=1-1=0.$\n\n- For $y=-1,$ we get $x=1-(-1)=2.$\n\nTherefore, the equilibrium points are\n\n$$\n[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,\\text{and}\\,[\\begin{aligned}2 \\\\ -1\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335657" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/activity-metadata.json" "file_sha256" "6f26fb5b462faa6c663403542092214c015f12ea9ea35835f3e87bbeedf15416"} {"question" "q-335657" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335657" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\text{ }[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\text{ }\\text{and}\\text{ }[\\begin{aligned}2 \\\\ -1\\end{aligned}]"] ["text" "$[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nand\n$[\\begin{aligned}2 \\\\ -1\\end{aligned}]$"] ["text" "$[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nand\n$[\\begin{aligned}0 \\\\ 1\\end{aligned}]$"] ["text" "$[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ only"] ["text" "$[\\begin{aligned}2 \\\\ -1\\end{aligned}]$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"} {"question" "q-335657" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\text{ }[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\text{ }\\text{and}\\text{ }[\\begin{aligned}2 \\\\ -1\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070192/state.json" "file_sha256" "7b442c6c611f62afb6d8b65560db0a16b301b6bbc7998fcca6fb759e27b3b876"}] "usage" {} "basis" 2452 "retractions" [] "immutable_answers" [] "immutable_fields" [] "no_history" []}
