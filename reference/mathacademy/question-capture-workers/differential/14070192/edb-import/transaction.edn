463/field-2" :answer-field/id #uuid "6eba7bbc-7426-56e2-a152-0b1d0f3edbd1" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-335463/field-2/8be2d115fa7b976b4c32465b7251c47b1a3e5672c0a4d8557f26e06f92eb40f8" :answer-field/choices ["q-335463/field-2/1242217e293918536235795934305085bae9f3e2eb3f535db7e74d4abefbe84f" "q-335463/field-2/d3d064377015e2100502a8ca521489d27d4a570be9709cc9238160c7c0343862" "q-335463/field-2/8be2d115fa7b976b4c32465b7251c47b1a3e5672c0a4d8557f26e06f92eb40f8"] :db/ensure [:answer-field/validate]} {:db/id "q-335463/field-3/1e30a0a95310ec876345baeb7f2bc07200edadc7097f0812c97392caa9f0cc71" :answer/id #uuid "eaf5eecc-182b-535b-8acd-0e432c31f5fc" :answer/type :answer.type/text :answer/value "may not converge to the equilibrium as $t\\to \\infty $" :db/ensure [:answer/validate]} {:db/id "q-335463/field-3/ec4778966a91e423e2a6040d6ff3ecaa5973628c453fd78efcc9214ecd5ad832" :answer/id #uuid "6ab58ee0-e242-5617-b1e8-3dadfb4074be" :answer/type :answer.type/text :answer/value "never converge to the equilibrium as $t\\to \\infty $" :db/ensure [:answer/validate]} {:db/id "q-335463/field-3/dffca3ac377a39094d34fb73cc84b82e1b33739383026d032d676f3764090f6c" :answer/id #uuid "4acf0ee1-86d8-5339-ad3d-9a791b184a97" :answer/type :answer.type/text :answer/value "always converge to the equilibrium as $t\\to \\infty $" :db/ensure [:answer/validate]} {:db/id "q-335463/field-3" :answer-field/id #uuid "a087bdc5-b887-593b-bbbe-6bd5d35764d2" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-335463/field-3/dffca3ac377a39094d34fb73cc84b82e1b33739383026d032d676f3764090f6c" :answer-field/choices ["q-335463/field-3/1e30a0a95310ec876345baeb7f2bc07200edadc7097f0812c97392caa9f0cc71" "q-335463/field-3/ec4778966a91e423e2a6040d6ff3ecaa5973628c453fd78efcc9214ecd5ad832" "q-335463/field-3/dffca3ac377a39094d34fb73cc84b82e1b33739383026d032d676f3764090f6c"] :db/ensure [:answer-field/validate]} {:db/id "q-335463" :question/id #uuid "2ab9c96d-932f-5272-8662-18e0a52dc3ed" :question/math-academy-id "q-335463" :question/problem "Select the correct options in the statement below that describe an **asymptotically stable** equilibrium point.The solutions that start sufficiently\n{{field-1}}\nthe equilibrium\n{{field-2}}\nit for all future time, and\n{{field-3}}." :question/worked-solution "Let's recall the definitions of stability:\n\n- An equilibrium point ${x}^{∗}$ is called *stable* if for any neighborhood $O$ of ${x}^{∗},$ there exists a neighborhood ${O}_{1}⊆O$ such that every orbit that begins inside ${O}_{1}$ at some point in time $t={t}_{0}$ remains inside $O$ for all $t>{t}_{0}.$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close, but may not converge to the equilibrium.\n\n- An equilibrium point ${x}^{∗}$ is called *asymptotically stable* if it is stable and there exists a neighborhood $O$ of ${x}^{∗}$ such that every orbit that begins inside $O$ approaches ${x}^{∗}$ as $t\\to \\infty .$\n\nIn plain words, this means that solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t\\to \\infty .$\n\n- An equilibrium point ${x}^{∗}$ is called *unstable* if it is not stable.\n\nIn plain words, this means that solutions eventually move away from the equilibrium for some initial conditions arbitrarily close to it.\n\nTherefore, the correct answer is the following:\n\nThe solutions that start sufficiently $\\text{close to}$ the equilibrium $\\text{remain close to}$ it for all future time, and $\\text{always converge to the equilibrium as }t\\to \\infty .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-335463/field-1" "q-335463/field-2" "q-335463/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e4025650-a2f6-597c-9bba-8008d90aee67"] :knowledge-point/questions ["q-335463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335647/selection/199a4b3fd8ea3936235da474fedb216bb7ccdfa876f7af80cefcfbf1465f0463" :answer/id #uuid "ee5e9183-0aad-523c-af69-eee680ddb6da" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ -2\\end{aligned}]$\nand \n$[\\begin{aligned}2 \\\\ -2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-335647/selection/b6f9c51d21d647e3cf1d391a1bed7a2bb643c49d561bc5bf92e87432320fc2ce" :answer/id #uuid "fd5ef72d-9708-517b-bf8e-9dcd70a3051d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ -2\\end{aligned}]$\nand \n$[\\begin{aligned}-2 \\\\ 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-335647/selection/d69e51e7b8fce90a09fb506ab5eb494f69c6ded8e068ce7cbcdc5e1db8d6fa61" :answer/id #uuid "39a692a8-9a4d-5345-8ca5-cb9e511c8722" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$\nand \n$[\\begin{aligned}2 \\\\ -2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-335647/selection/3a652e01ded964c0b78e0e6013ee5e9a57fcb7d9da6491033ba32f65f1f6f4f8" :answer/id #uuid "c44ef9cc-e4bd-56e2-9433-6e1702a0ce90" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-2 \\\\ 0\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335647/selection/c04cd86cb30862e5998630d9a3daaba341e1360cc631e6f44af1a611ec505a61" :answer/id #uuid "d985bc45-5ffa-5643-938e-e6a3042768e2" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}2 \\\\ -4\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335647/selection" :answer-field/id #uuid "6c00a6fb-3f0f-508f-8224-56362ff2eb1c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-335647/selection/b6f9c51d21d647e3cf1d391a1bed7a2bb643c49d561bc5bf92e87432320fc2ce" :answer-field/choices ["q-335647/selection/199a4b3fd8ea3936235da474fedb216bb7ccdfa876f7af80cefcfbf1465f0463" "q-335647/selection/b6f9c51d21d647e3cf1d391a1bed7a2bb643c49d561bc5bf92e87432320fc2ce" "q-335647/selection/d69e51e7b8fce90a09fb506ab5eb494f69c6ded8e068ce7cbcdc5e1db8d6fa61" "q-335647/selection/3a652e01ded964c0b78e0e6013ee5e9a57fcb7d9da6491033ba32f65f1f6f4f8" "q-335647/selection/c04cd86cb30862e5998630d9a3daaba341e1360cc631e6f44af1a611ec505a61"] :db/ensure [:answer-field/validate]} {:db/id "q-335647" :question/id #uuid "21ab42b7-8f9f-5826-a8e7-e56da9141cf7" :question/math-academy-id "q-335647" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+y(t)+2 \\\\ {y}^{′}(t)={x}^{2}(t)-2y(t)-4\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of differential equations above?" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of equations:\n\n$$\n{\\begin{aligned}x+y+2=0 \\\\ {x}^{2}-2y-4=0\\end{aligned}\n$$\n\nNow, we solve the first equation for $y:$\n\n$$\n\\begin{aligned}x+y+2=0\\,⇒\\,y=-x-2\\end{aligned}\n$$\n\nNext, we substitute $y$ into the second equation\n\n$$\n\\begin{aligned}{x}^{2}-2y-4 & =0 \\\\ {x}^{2}-2(-x-2)-4 & =0 \\\\ {x}^{2}+2x+4-4 & =0 \\\\ {x}^{2}+2x & =0 \\\\ x(x+2) & =0 \\\\ x & =-2,\\text{ }0.\\end{aligned}\n$$\n\nNow, we compute $y:$\n\n- For $x=0,$ we get $y=-0-2=-2.$\n\n- For $x=-2,$ we get $y=-(-2)-2=0.$\n\nTherefore, the equilibrium points are\n\n$$\n[\\begin{aligned}0 \\\\ -2\\end{aligned}]\\,\\text{and}\\,[\\begin{aligned}-2 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-335647/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c508ee9c-0dee-5d37-9f80-d5e7334160b8"] :knowledge-point/questions ["q-335647"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335657/selection/dfd6b04afd9f852f8e0316fe29966570434206c800de19bebe11f2202bb59f10" :answer/id #uuid "0fdcaec4-5b59-52fe-903c-c9cde246ac03" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nand\n$[\\begin{aligned}2 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-335657/selection/e055d317198ba0fc156da48e27fa76687636c0a5bcff80d40206c64bf7a8922c" :answer/id #uuid "bddd13b3-b9d6-54eb-9b5b-6a9d946b9a76" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\text{ }[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\text{ }\\text{and}\\text{ }[\\begin{aligned}2 \\\\ -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-335657/selection/3f13231535e83c570dfedc63d87a20e79e1e2a1d240b4f03873bd3383e10525b" :answer/id #uuid "d9044c8e-6e38-522d-a2b9-c354d0c5bce1" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335657/selection/a4e0e9ca7d25396c435c7dc4ebe511b2ef03b04768c5961a117fa0f766213974" :answer/id #uuid "fe291353-8421-5644-8181-844de499d13d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nand\n$[\\begin{aligned}0 \\\\ 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-335657/selection/598931911f1974c2c8f386f687adebf5864f4d6ad37b961d7fbfec81a963ee2a" :answer/id #uuid "d0a24f4d-d822-5955-baa7-94529b97c46d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}2 \\\\ -1\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335657/selection" :answer-field/id #uuid "3ff634de-92d2-5cbb-baca-e2cdb5489fd3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-335657/selection/e055d317198ba0fc156da48e27fa76687636c0a5bcff80d40206c64bf7a8922c" :answer-field/choices ["q-335657/selection/dfd6b04afd9f852f8e0316fe29966570434206c800de19bebe11f2202bb59f10" "q-335657/selection/e055d317198ba0fc156da48e27fa76687636c0a5bcff80d40206c64bf7a8922c" "q-335657/selection/3f13231535e83c570dfedc63d87a20e79e1e2a1d240b4f03873bd3383e10525b" "q-335657/selection/a4e0e9ca7d25396c435c7dc4ebe511b2ef03b04768c5961a117fa0f766213974" "q-335657/selection/598931911f1974c2c8f386f687adebf5864f4d6ad37b961d7fbfec81a963ee2a"] :db/ensure [:answer-field/validate]} {:db/id "q-335657" :question/id #uuid "5aaeddc8-6572-55ca-bb11-3efda949f182" :question/math-academy-id "q-335657" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=x(t)+y(t)-1 \\\\ {y}^{′}(t)={y}^{3}(t)+x(t)-1\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of differential equations above?" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of equations:\n\n$$\n{\\begin{aligned}x+y-1=0 \\\\ {y}^{3}+x-1=0\\end{aligned}\n$$\n\nNow, we solve the first equation for $x:$\n\n$$\n\\begin{aligned}x+y-1=0\\,⇒\\,x=1-y\\end{aligned}\n$$\n\nNext, we substitute $x$ into the second equation\n\n$$\n\\begin{aligned}{y}^{3}+x-1 & =0 \\\\ {y}^{3}+(1-y)-1 & =0 \\\\ {y}^{3}-y & =0 \\\\ y({y}^{2}-1) & =0 \\\\ y(y-1)(y+1) & =0 \\\\ y & =-1,\\text{ }0,\\text{ }1.\\end{aligned}\n$$\n\nNow, we compute $x:$\n\n- For $y=0,$ we get $x=1-0=1.$\n\n- For $y=1,$ we get $x=1-1=0.$\n\n- For $y=-1,$ we get $x=1-(-1)=2.$\n\nTherefore, the equilibrium points are\n\n$$\n[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,\\text{and}\\,[\\begin{aligned}2 \\\\ -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-335657/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c508ee9c-0dee-5d37-9f80-d5e7334160b8"] :knowledge-point/questions ["q-335657"] :db/ensure [:knowledge-point/validate]}]
