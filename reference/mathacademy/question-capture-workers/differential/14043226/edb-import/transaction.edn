8af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5" :answer/id #uuid "66f1d5b8-87be-5fa5-92c9-7f941c82e89c" :answer/type :answer.type/math :answer/value "s\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-341107/field-2/5ea8eb584cb1e2dea7b2b91c9a2aa22e34d4acebf6c357466a4b807da4e3051a" :answer/id #uuid "96e63ae1-3fcb-52ba-a255-0a71bc609812" :answer/type :answer.type/math :answer/value "s>-2" :db/ensure [:answer/validate]} {:db/id "q-341107/field-2/46513e74f73f6b5122e6163b977152a86165607507e7929403b517346b7b7e68" :answer/id #uuid "e9ee42cd-823a-59bd-81fd-ecb41ff18ea8" :answer/type :answer.type/math :answer/value "s\\ge -2" :db/ensure [:answer/validate]} {:db/id "q-341107/field-2/0effe7e24c5ac375d36624eab032951c53d6e3342a23114dc3ad5c93ba6d6cf8" :answer/id #uuid "614b8e57-7cfc-52e1-87fb-2720166201e8" :answer/type :answer.type/math :answer/value "s>2" :db/ensure [:answer/validate]} {:db/id "q-341107/field-2" :answer-field/id #uuid "56031e02-a48c-5b8c-a484-21e2037b38cc" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-341107/field-2/0effe7e24c5ac375d36624eab032951c53d6e3342a23114dc3ad5c93ba6d6cf8" :answer-field/choices ["q-341107/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" "q-341107/field-2/74fb6aa96c018080ae97ccbae97e7eb1e9c069eee73bb4ee885fc00aa723c00d" "q-341107/field-2/9d34e85dabb5082358af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5" "q-341107/field-2/5ea8eb584cb1e2dea7b2b91c9a2aa22e34d4acebf6c357466a4b807da4e3051a" "q-341107/field-2/46513e74f73f6b5122e6163b977152a86165607507e7929403b517346b7b7e68" "q-341107/field-2/0effe7e24c5ac375d36624eab032951c53d6e3342a23114dc3ad5c93ba6d6cf8"] :db/ensure [:answer-field/validate]} {:db/id "q-341107" :question/id #uuid "76cf24a0-9805-5350-bd6b-b9aff0267017" :question/math-academy-id "q-341107" :question/problem "Use the Laplace transform of $f(t)={e}^{kt}$ to find the Laplace transform of $\\operatorname{cosh}⁡(2t).$$\\,L{\\operatorname{cosh}⁡(2t)}=$ {{field-1}},\ndefined for {{field-2}}." :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\operatorname{cosh}⁡(2t)=\\frac{{e}^{2t}+{e}^{-2t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(2t)} & =L{\\frac{{e}^{2t}+{e}^{-2t}}{2}} \\\\  & =L{\\frac{{e}^{2t}}{2}+\\frac{{e}^{-2t}}{2}} \\\\  & =L{\\frac{{e}^{2t}}{2}}+L{\\frac{{e}^{-2t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{2t}}+\\frac{1}{2}L{{e}^{-2t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{2t}} & =\\frac{1}{s-2},\\,s>2 \\\\ L{{e}^{-2t}} & =\\frac{1}{s+2},\\,s>-2\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{cosh}⁡(2t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(2t)} & =\\frac{1}{2}L{{e}^{2t}}+\\frac{1}{2}L{{e}^{-2t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-2}+\\frac{1}{2}\\cdot \\frac{1}{s+2} \\\\  & =\\frac{1}{2}(\\frac{1}{s-2}+\\frac{1}{s+2}) \\\\  & =\\frac{1}{2}(\\frac{(s+2)+(s-2)}{(s-2)(s+2)}) \\\\  & =\\frac{1}{2}(\\frac{2s}{{s}^{2}-4}) \\\\  & =\\frac{s}{{s}^{2}-4}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{2t}}$ is defined for $s\\in (2,\\infty )$ and $L{{e}^{-2t}}$ is defined for $s\\in (-2,\\infty ),$ we have that $L{\\operatorname{cosh}⁡(2t)}$ is defined for\n\n$$\n(2,\\infty )\\cap (-2,\\infty )=(2,\\infty ),\n$$\n\nthat is, $s>2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341107/field-1" "q-341107/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c086bc97-415d-52c9-b26a-02dc8aebef33"] :knowledge-point/questions ["q-341107"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341190/selection/2b57d0fd50755a1bdab906b2015b5a6f2951816a3e0f9fa161aa157bd518d2c5" :answer/id #uuid "64c23a6c-0168-551c-b44c-df718ccaa597" :answer/type :answer.type/math :answer/value "\\frac{s+24}{{s}^{2}-64}" :db/ensure [:answer/validate]} {:db/id "q-341190/selection/1b2b9cf84703f741b0a133693effe8bac466a9323517da698e7cd49bcf4ff17c" :answer/id #uuid "e00a16aa-f433-5497-b4f7-26543b55ffc4" :answer/type :answer.type/math :answer/value "\\frac{4s-24}{{s}^{2}-64}" :db/ensure [:answer/validate]} {:db/id "q-341190/selection/5bbed6f309389ec80aa6a46c60b2ab958eb5d6bb4ad8fc251c1e06184e0c34f5" :answer/id #uuid "0d738e99-37d3-5108-864e-a21560a85d8a" :answer/type :answer.type/math :answer/value "\\frac{4s+24}{{s}^{2}-64}" :db/ensure [:answer/validate]} {:db/id "q-341190/selection/9b3655efd608120ac6dbf693c163179e43f2024f2e229ee465e1e8c38d2b3acf" :answer/id #uuid "f9946be9-db39-5e3b-9e9c-d14212dfd751" :answer/type :answer.type/math :answer/value "\\frac{4s+3}{{s}^{2}-8}" :db/ensure [:answer/validate]} {:db/id "q-341190/selection/154e137ddf520f5993125c14e61a5e8208aad4d7fcef0fe7e588efcfe00c9f80" :answer/id #uuid "5eff272b-9d2d-583d-8c07-25b0cbb53a4e" :answer/type :answer.type/math :answer/value "\\frac{4s+24}{8({s}^{2}-64)}" :db/ensure [:answer/validate]} {:db/id "q-341190/selection" :answer-field/id #uuid "4b9cd507-9a9a-5e73-9663-7ac5f0bd646e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-341190/selection/5bbed6f309389ec80aa6a46c60b2ab958eb5d6bb4ad8fc251c1e06184e0c34f5" :answer-field/choices ["q-341190/selection/2b57d0fd50755a1bdab906b2015b5a6f2951816a3e0f9fa161aa157bd518d2c5" "q-341190/selection/1b2b9cf84703f741b0a133693effe8bac466a9323517da698e7cd49bcf4ff17c" "q-341190/selection/5bbed6f309389ec80aa6a46c60b2ab958eb5d6bb4ad8fc251c1e06184e0c34f5" "q-341190/selection/9b3655efd608120ac6dbf693c163179e43f2024f2e229ee465e1e8c38d2b3acf" "q-341190/selection/154e137ddf520f5993125c14e61a5e8208aad4d7fcef0fe7e588efcfe00c9f80"] :db/ensure [:answer-field/validate]} {:db/id "q-341190" :question/id #uuid "a9bfd713-c584-51f5-ac13-9683fe57920b" :question/math-academy-id "q-341190" :question/problem "Given that for $s>\\omega ,$\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(\\omega t)}=\\frac{\\omega }{{s}^{2}-{\\omega }^{2}},\\,L{\\operatorname{cosh}⁡(\\omega t)}=\\frac{s}{{s}^{2}-{\\omega }^{2}},\\end{aligned}\n$$\n\nfind the Laplace transform of $f(t)=4\\operatorname{cosh}⁡(8t)+3\\operatorname{sinh}⁡(8t)$ for $s>8.$" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{4\\operatorname{cosh}⁡(8t)+3\\operatorname{sinh}⁡(8t)} & =L{4\\operatorname{cosh}⁡(8t)}+L{3\\operatorname{sinh}⁡(8t)} \\\\  & =4L{\\operatorname{cosh}⁡(8t)}+3L{\\operatorname{sinh}⁡(8t)}.\\end{aligned}\n$$\n\nWe are given that\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(\\omega t)} & =\\frac{\\omega }{{s}^{2}-{\\omega }^{2}}, &  & s>\\omega , \\\\ L{\\operatorname{cosh}⁡(\\omega t)} & =\\frac{s}{{s}^{2}-{\\omega }^{2}}, &  & s>\\omega .\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(8t)} & =\\frac{s}{{s}^{2}-64},\\,s>8 \\\\ L{\\operatorname{sinh}⁡(8t)} & =\\frac{8}{{s}^{2}-64},\\,s>8\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =4L{\\operatorname{cosh}⁡(8t)}+3L{\\operatorname{sinh}⁡(8t)} \\\\  & =4\\cdot \\frac{s}{{s}^{2}-64}+3\\cdot \\frac{8}{{s}^{2}-64} \\\\  & =\\frac{4s}{{s}^{2}-64}+\\frac{24}{{s}^{2}-64} \\\\  & =\\frac{4s+24}{{s}^{2}-64}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341190/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f97501c-2fa0-5b11-84b4-86faae530ce4"] :knowledge-point/questions ["q-341190"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341192/selection/b0e27abd286a5a9e306bcd32b6300a6dfec1af54947510a4f650b3af14ba8798" :answer/id #uuid "3c52c387-2b8a-5096-9259-95fa82781f8f" :answer/type :answer.type/math :answer/value "\\frac{s+60}{{s}^{2}-100}" :db/ensure [:answer/validate]} {:db/id "q-341192/selection/506b9000d1a88d36912bb0d75e85b95fffec7e6311d2e05de7a066b8e29a5df5" :answer/id #uuid "8d0aa100-5196-58f0-9db6-48878e31a3ec" :answer/type :answer.type/math :answer/value "\\frac{6s+10}{{s}^{2}-100}" :db/ensure [:answer/validate]} {:db/id "q-341192/selection/8c0dc38c9400848c30e1ad5d23cef8b4560345d57142d6edab25f5958ac63afb" :answer/id #uuid "15113011-40ae-5dac-ab5d-f5c3ac1dcd84" :answer/type :answer.type/math :answer/value "\\frac{6s+10}{10({s}^{2}-100)}" :db/ensure [:answer/validate]} {:db/id "q-341192/selection/38b7b521a0ce0ce49f1a276889557f7493dd35afb91fb8d5553d1a2edec6e9f4" :answer/id #uuid "b43f4bf9-b7e5-5835-bfa6-bf8c1e7f1ba9" :answer/type :answer.type/math :answer/value "\\frac{s-60}{{s}^{2}-10}" :db/ensure [:answer/validate]} {:db/id "q-341192/selection/de668accd5e4228318512ccb0e6b9b1d6f3c4abf2ec90278be45270e5a8342bc" :answer/id #uuid "b51f65b3-df7d-5d09-b924-e2dcdb0e0de0" :answer/type :answer.type/math :answer/value "\\frac{10s-6}{{s}^{2}-100}" :db/ensure [:answer/validate]} {:db/id "q-341192/selection" :answer-field/id #uuid "44823150-39ec-5719-98f3-e7e2885fa24d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-341192/selection/506b9000d1a88d36912bb0d75e85b95fffec7e6311d2e05de7a066b8e29a5df5" :answer-field/choices ["q-341192/selection/b0e27abd286a5a9e306bcd32b6300a6dfec1af54947510a4f650b3af14ba8798" "q-341192/selection/506b9000d1a88d36912bb0d75e85b95fffec7e6311d2e05de7a066b8e29a5df5" "q-341192/selection/8c0dc38c9400848c30e1ad5d23cef8b4560345d57142d6edab25f5958ac63afb" "q-341192/selection/38b7b521a0ce0ce49f1a276889557f7493dd35afb91fb8d5553d1a2edec6e9f4" "q-341192/selection/de668accd5e4228318512ccb0e6b9b1d6f3c4abf2ec90278be45270e5a8342bc"] :db/ensure [:answer-field/validate]} {:db/id "q-341192" :question/id #uuid "c3db3a05-469c-5a36-89ee-a774cc74a812" :question/math-academy-id "q-341192" :question/problem "Given that for $s>\\omega ,$\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(\\omega t)}=\\frac{\\omega }{{s}^{2}-{\\omega }^{2}},\\,L{\\operatorname{cosh}⁡(\\omega t)}=\\frac{s}{{s}^{2}-{\\omega }^{2}},\\end{aligned}\n$$\n\nfind the Laplace transform of $f(t)=6\\operatorname{cosh}⁡(10t)+\\operatorname{sinh}⁡(10t)$ for $s>10.$" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{6\\operatorname{cosh}⁡(10t)+\\operatorname{sinh}⁡(10t)} & =L{6\\operatorname{cosh}⁡(10t)}+L{\\operatorname{sinh}⁡(10t)} \\\\  & =6L{\\operatorname{cosh}⁡(10t)}+L{\\operatorname{sinh}⁡(10t)}.\\end{aligned}\n$$\n\nWe are given that\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(\\omega t)} & =\\frac{\\omega }{{s}^{2}-{\\omega }^{2}}, &  & s>\\omega , \\\\ L{\\operatorname{cosh}⁡(\\omega t)} & =\\frac{s}{{s}^{2}-{\\omega }^{2}}, &  & s>\\omega .\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(10t)} & =\\frac{s}{{s}^{2}-100},\\,s>10 \\\\ L{\\operatorname{sinh}⁡(10t)} & =\\frac{10}{{s}^{2}-100},\\,s>10\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =6L{\\operatorname{cosh}⁡(10t)}+L{\\operatorname{sinh}⁡(10t)} \\\\  & =6\\cdot \\frac{s}{{s}^{2}-100}+\\frac{10}{{s}^{2}-100} \\\\  & =\\frac{6s}{{s}^{2}-100}+\\frac{10}{{s}^{2}-100} \\\\  & =\\frac{6s+10}{{s}^{2}-100}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341192/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f97501c-2fa0-5b11-84b4-86faae530ce4"] :knowledge-point/questions ["q-341192"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331504/field-1/04632e5a9b3a25b7fc6e6b65a30aa1933608b6556c3ccfd1234e5c7ebaa3e279" :answer/id #uuid "9ea291f3-25c0-51c1-9dfb-d72431da31df" :answer/type :answer.type/math :answer/value "\\frac{7s+12}{s^2+9}" :db/ensure [:answer/validate]} {:db/id "q-331504/field-1" :answer-field/id #uuid "03cdff83-a39d-55d5-857f-05eb3b5260cd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331504/field-1/04632e5a9b3a25b7fc6e6b65a30aa1933608b6556c3ccfd1234e5c7ebaa3e279" :answer-field/choices ["q-331504/field-1/04632e5a9b3a25b7fc6e6b65a30aa1933608b6556c3ccfd1234e5c7ebaa3e279"] :db/ensure [:answer-field/validate]} {:db/id "q-331504" :question/id #uuid "1bce0c66-363d-500f-a770-0628ad5332cd" :question/math-academy-id "q-331504" :question/problem "Given that for $s>0,$\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\end{aligned}\n$$\n\nfind the Laplace transform of $f(t)=7\\operatorname{cos}⁡3t+4\\operatorname{sin}⁡3t$ for $s>0.$\n\n$L{f(t)}=$\n{{field-1}}" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{7\\operatorname{cos}⁡3t+4\\operatorname{sin}⁡3t} & =L{7\\operatorname{cos}⁡3t}+L{4\\operatorname{sin}⁡3t} \\\\  & =7L{\\operatorname{cos}⁡3t}+4L{\\operatorname{sin}⁡3t}.\\end{aligned}\n$$\n\nWe are given that\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡\\omega t} & =\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}, &  & s>0, \\\\ L{\\operatorname{cos}⁡\\omega t} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡3t} & =\\frac{s}{{s}^{2}+9},\\,s>0 \\\\ L{\\operatorname{sin}⁡3t} & =\\frac{3}{{s}^{2}+9},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =7L{\\operatorname{cos}⁡3t}+4L{\\operatorname{sin}⁡3t} \\\\  & =7\\cdot \\frac{s}{{s}^{2}+9}+4\\cdot \\frac{3}{{s}^{2}+9} \\\\  & =\\frac{7s}{{s}^{2}+9}+\\frac{12}{{s}^{2}+9} \\\\  & =\\frac{7s+12}{{s}^{2}+9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331504/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f97501c-2fa0-5b11-84b4-86faae530ce4"] :knowledge-point/questions ["q-331504"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331500/field-1/e15c21ff4094fad30bae688178f8556182ce8c7546da7ae2183e83223e76e048" :answer/id #uuid "cc7ce8b1-69d4-5a5e-a298-51c646117a99" :answer/type :answer.type/math :answer/value "\\frac{5s-8}{s^2+16}" :db/ensure [:answer/validate]} {:db/id "q-331500/field-1/d6594f7cc2eb2b103839ee9709966690390865de04b5dfc75324794fa21c588e" :answer/id #uuid "7e6b398f-1d6d-5cd3-8273-1e732c19abe1" :answer/type :answer.type/math :answer/value "\\frac{5s+8}{s^2+16}" :db/ensure [:answer/validate]} {:db/id "q-331500/field-1" :answer-field/id #uuid "4b91c37c-78fe-5d7c-8d7e-ffd7f7a6e2fa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331500/field-1/e15c21ff4094fad30bae688178f8556182ce8c7546da7ae2183e83223e76e048" :answer-field/choices ["q-331500/field-1/e15c21ff4094fad30bae688178f8556182ce8c7546da7ae2183e83223e76e048" "q-331500/field-1/d6594f7cc2eb2b103839ee9709966690390865de04b5dfc75324794fa21c588e"] :db/ensure [:answer-field/validate]} {:db/id "q-331500" :question/id #uuid "2f6b30aa-5797-5213-a5e2-927d71d7ab28" :question/math-academy-id "q-331500" :question/problem "Given that for $s>0,$\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\end{aligned}\n$$\n\nfind the Laplace transform of $f(t)=5\\operatorname{cos}⁡4t-2\\operatorname{sin}⁡4t$ for $s>0.$\n\n$L{f(t)}=$\n{{field-1}}" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{5\\operatorname{cos}⁡4t-2\\operatorname{sin}⁡4t} & =L{5\\operatorname{cos}⁡4t}+L{-2\\operatorname{sin}⁡4t} \\\\  & =5L{\\operatorname{cos}⁡4t}-2L{\\operatorname{sin}⁡4t}.\\end{aligned}\n$$\n\nWe are given that\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡\\omega t} & =\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}, &  & s>0, \\\\ L{\\operatorname{cos}⁡\\omega t} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡4t} & =\\frac{s}{{s}^{2}+16},\\,s>0 \\\\ L{\\operatorname{sin}⁡4t} & =\\frac{4}{{s}^{2}+16},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =5L{\\operatorname{cos}⁡4t}-2L{\\operatorname{sin}⁡4t} \\\\  & =5\\cdot \\frac{s}{{s}^{2}+16}-2\\cdot \\frac{4}{{s}^{2}+16} \\\\  & =\\frac{5s}{{s}^{2}+16}-\\frac{8}{{s}^{2}+16} \\\\  & =\\frac{5s-8}{{s}^{2}+16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331500/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f97501c-2fa0-5b11-84b4-86faae530ce4"] :knowledge-point/questions ["q-331500"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341191/selection/995706b533e09ded116a09531bb9d77cf256aea6bd641f6762eb0470e9b31059" :answer/id #uuid "bdf74c35-07f4-505a-8448-3614827256b5" :answer/type :answer.type/math :answer/value "\\frac{18s-54}{{s}^{2}-81}" :db/ensure [:answer/validate]} {:db/id "q-341191/selection/b69c84a1c05f67892bbb50e3e4350c15933d010c81552b4d05c8704832baaf65" :answer/id #uuid "a6d08b1c-0cd2-55b0-b431-da033f370f18" :answer/type :answer.type/math :answer/value "\\frac{6s-18}{{s}^{2}-81}" :db/ensure [:answer/validate]} {:db/id "q-341191/selection/abedb4260ec1d98d5e49a17e312f7fba39820c179da4c520d81395210079941e" :answer/id #uuid "1475c026-7370-5671-8d5f-542843681e7e" :answer/type :answer.type/math :answer/value "\\frac{2s+54}{9({s}^{2}-81)}" :db/ensure [:answer/validate]} {:db/id "q-341191/selection/cfde84d950385b5727981cd52eab312808022f0df542cda8701f124b5fc5d15e" :answer/id #uuid "65a91741-a7b4-5b5e-8016-8a06fd4302c9" :answer/type :answer.type/math :answer/value "\\frac{2s+54}{{s}^{2}-81}" :db/ensure [:answer/validate]} {:db/id "q-341191/selection/768001ec6efbe9fe2e2caf1789017b4eeb0afb27e1ebb56dfe4e3ea621725c3a" :answer/id #uuid "75e6f5fa-7d08-5980-a525-5cf8599c28cc" :answer/type :answer.type/math :answer/value "\\frac{s+54}{{s}^{2}-81}" :db/ensure [:answer/validate]} {:db/id "q-341191/selection" :answer-field/id #uuid "5b9e406b-acba-5aa8-92af-42a474bc66e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-341191/selection/cfde84d950385b5727981cd52eab312808022f0df542cda8701f124b5fc5d15e" :answer-field/choices ["q-341191/selection/995706b533e09ded116a09531bb9d77cf256aea6bd641f6762eb0470e9b31059" "q-341191/selection/b69c84a1c05f67892bbb50e3e4350c15933d010c81552b4d05c8704832baaf65" "q-341191/selection/abedb4260ec1d98d5e49a17e312f7fba39820c179da4c520d81395210079941e" "q-341191/selection/cfde84d950385b5727981cd52eab312808022f0df542cda8701f124b5fc5d15e" "q-341191/selection/768001ec6efbe9fe2e2caf1789017b4eeb0afb27e1ebb56dfe4e3ea621725c3a"] :db/ensure [:answer-field/validate]} {:db/id "q-341191" :question/id #uuid "dd36dbb5-36b9-50d8-a3e3-293d0d249fd1" :question/math-academy-id "q-341191" :question/problem "Given that for $s>\\omega ,$\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(\\omega t)}=\\frac{\\omega }{{s}^{2}-{\\omega }^{2}},\\,L{\\operatorname{cosh}⁡(\\omega t)}=\\frac{s}{{s}^{2}-{\\omega }^{2}},\\end{aligned}\n$$\n\nfind the Laplace transform of $f(t)=2\\operatorname{cosh}⁡(9t)+6\\operatorname{sinh}⁡(9t)$ for $s>9.$" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{2\\operatorname{cosh}⁡(9t)+6\\operatorname{sinh}⁡(9t)} & =L{2\\operatorname{cosh}⁡(9t)}+L{6\\operatorname{sinh}⁡(9t)} \\\\  & =2L{\\operatorname{cosh}⁡(9t)}+6L{\\operatorname{sinh}⁡(9t)}.\\end{aligned}\n$$\n\nWe are given that\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(\\omega t)} & =\\frac{\\omega }{{s}^{2}-{\\omega }^{2}}, &  & s>\\omega , \\\\ L{\\operatorname{cosh}⁡(\\omega t)} & =\\frac{s}{{s}^{2}-{\\omega }^{2}}, &  & s>\\omega .\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{\\operatorname{cosh}⁡(9t)} & =\\frac{s}{{s}^{2}-81},\\,s>9 \\\\ L{\\operatorname{sinh}⁡(9t)} & =\\frac{9}{{s}^{2}-81},\\,s>9\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =2L{\\operatorname{cosh}⁡(9t)}+6L{\\operatorname{sinh}⁡(9t)} \\\\  & =2\\cdot \\frac{s}{{s}^{2}-81}+6\\cdot \\frac{9}{{s}^{2}-81} \\\\  & =\\frac{2s}{{s}^{2}-81}+\\frac{54}{{s}^{2}-81} \\\\  & =\\frac{2s+54}{{s}^{2}-81}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341191/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f97501c-2fa0-5b11-84b4-86faae530ce4"] :knowledge-point/questions ["q-341191"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6647"] :question/problem "Find the Laplace transform of $f(t) = e^{-3t}-e^{5t}$ for $s>5.$" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\n\\mathcal L\\{\\alpha f(t) + \\beta g(t)\\} = \\alpha\\cdot \\mathcal L\\{f(t)\\} + \\beta\\cdot \\mathcal L \\{g(t)\\},\n$$\n\nwhere $\\alpha$ and $\\beta$ are constants.\n\nTaking the Laplace transform and applying the linearity properties, we have\n\n$$\n\\begin{aligned}L{{e}^{-3t}-{e}^{5t}} & =L{{e}^{-3t}}+L{-{e}^{5t}} \\\\  & =L{{e}^{-3t}}-L{{e}^{5t}}.\\end{aligned}\n$$\n\nNext, we recall the following result:\n\n$$\n\\mathcal L\\left\\{e^{kt}\\right\\} = \\dfrac{1}{s-k}, \\qquad s > k\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{-3t}} & =\\frac{1}{s+3},\\,s>-3 \\\\ L{{e}^{5t}} & =\\frac{1}{s-5},\\,s>5\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =L{{e}^{-3t}}-L{{e}^{5t}} \\\\  & =\\frac{1}{s+3}-\\frac{1}{s-5} \\\\  & =\\frac{(s-5)-(s+3)}{(s+3)(s-5)} \\\\  & =\\frac{-8}{(s+3)(s-5)} \\\\  & =-\\frac{8}{(s+3)(s-5)}.\\end{aligned}\n$$\n\nFinally, since $\\mathcal L\\{e^{-3t}\\}$ is defined for $s\\in (-3,\\infty)$ and $\\mathcal L \\{e^{5t}\\}$ is defined for $s\\in (5,\\infty),$ we have that $\\mathcal L\\{f(t)\\}$ is defined for\n\n$$\n(-3,\\infty) \\cap (5,\\infty) = (5,\\infty),\n$$\n\nthat is, $s > 5.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21832"] :question/problem "Use the Laplace transform of $f(t) = e^{kt}$ to find the Laplace transform of $\\sinh(3t).$" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\n\\mathcal L\\{\\alpha f(t) + \\beta g(t)\\} = \\alpha\\cdot \\mathcal L\\{f(t)\\} + \\beta\\cdot \\mathcal L \\{g(t)\\},\n$$\n\nwhere $\\alpha$ and $\\beta$ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\sinh(3t) = \\dfrac{e^{3t} - e^{-3t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(3t)} & =L{\\frac{{e}^{3t}-{e}^{-3t}}{2}} \\\\  & =L{\\frac{{e}^{3t}}{2}-\\frac{{e}^{-3t}}{2}} \\\\  & =L{\\frac{{e}^{3t}}{2}}-L{\\frac{{e}^{-3t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{3t}}-\\frac{1}{2}L{{e}^{-3t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\n\\mathcal L\\left\\{e^{kt}\\right\\} = \\dfrac{1}{s-k}, \\qquad s > k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{3t}} & =\\frac{1}{s-3},\\,s>3 \\\\ L{{e}^{-3t}} & =\\frac{1}{s+3},\\,s>-3\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\sinh(3t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(3t)} & =\\frac{1}{2}L{{e}^{3t}}-\\frac{1}{2}L{{e}^{-3t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-3}-\\frac{1}{2}\\cdot \\frac{1}{s+3} \\\\  & =\\frac{1}{2}(\\frac{1}{s-3}-\\frac{1}{s+3}) \\\\  & =\\frac{1}{2}(\\frac{(s+3)-(s-3)}{(s-3)(s+3)}) \\\\  & =\\frac{1}{2}(\\frac{6}{{s}^{2}-9}) \\\\  & =\\frac{3}{{s}^{2}-9}.\\end{aligned}\n$$\n\nFinally, since $\\mathcal L\\{e^{3t}\\}$ is defined for $s\\in (3,\\infty)$ and $\\mathcal L \\{e^{-3t}\\}$ is defined for $s\\in (-3,\\infty),$ we have that $\\mathcal L\\{\\sinh(3t)\\}$ is defined for\n\n$$\n(3,\\infty) \\cap (-3,\\infty) = (3,\\infty),\n$$\n\nthat is, $s > 3.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6736"] :question/problem "Given that for $s > 0,$\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡\\omega t}=\\frac{\\omega }{{s}^{2}+{\\omega }^{2}},\\,L{\\operatorname{cos}⁡\\omega t}=\\frac{s}{{s}^{2}+{\\omega }^{2}},\\end{aligned}\n$$\n\nfind the Laplace transform of $f(t) = 3\\cos{9t} - 2\\sin{9t}$ for $s > 0.$" :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\n\\mathcal L\\{\\alpha f(t) + \\beta g(t)\\} = \\alpha\\cdot \\mathcal L\\{f(t)\\} + \\beta\\cdot \\mathcal L \\{g(t)\\},\n$$\n\nwhere $\\alpha$ and $\\beta$ are constants.\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{3\\operatorname{cos}⁡9t-2\\operatorname{sin}⁡9t} & =L{3\\operatorname{cos}⁡9t}+L{-2\\operatorname{sin}⁡9t} \\\\  & =3L{\\operatorname{cos}⁡9t}-2L{\\operatorname{sin}⁡9t}.\\end{aligned}\n$$\n\nWe are given that\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡\\omega t} & =\\frac{\\omega }{{s}^{2}+{\\omega }^{2}}, &  & s>0, \\\\ L{\\operatorname{cos}⁡\\omega t} & =\\frac{s}{{s}^{2}+{\\omega }^{2}}, &  & s>0.\\end{aligned}\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{\\operatorname{cos}⁡9t} & =\\frac{s}{{s}^{2}+81},\\,s>0 \\\\ L{\\operatorname{sin}⁡9t} & =\\frac{9}{{s}^{2}+81},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $f(t)$ is\n\n$$\n\\begin{aligned}L{f(t)} & =3L{\\operatorname{cos}⁡9t}-2L{\\operatorname{sin}⁡9t} \\\\  & =3\\cdot \\frac{s}{{s}^{2}+81}-2\\cdot \\frac{9}{{s}^{2}+81} \\\\  & =\\frac{3s}{{s}^{2}+81}-\\frac{18}{{s}^{2}+81} \\\\  & =\\frac{3s-18}{{s}^{2}+81}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
