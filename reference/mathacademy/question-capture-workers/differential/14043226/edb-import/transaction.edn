b8eab46db4fc35b5" "q-341127/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" "q-341127/field-2/478e1459b432b0e9b44cea52f6302a1f636ec156ea6f212b4f34bd9ccef3b814" "q-341127/field-2/7c35e8d4c51dc33d64c68743dc7f96675973641c8fc6de1e1ecfda8604266cbd" "q-341127/field-2/d5ac6290bc19951b07e6c6ebc4e980aabea694b60ea0043425710f0a9a526306" "q-341127/field-2/39eab8884777e8088ce9807a4733a29d244428ca66da65d69aa1e340b953f55c"] :db/ensure [:answer-field/validate]} {:db/id "q-341127" :question/id #uuid "8d5b00b2-0711-5fe4-a60e-34aa63f78154" :question/math-academy-id "q-341127" :question/problem "Use the Laplace transform of $f(t)={e}^{\\text{i}\\omega t}$ to find the Laplace transform of $\\operatorname{sin}⁡(12t).$$\\,L{\\operatorname{sin}⁡(12t)}=$ {{field-1}},\ndefined for {{field-2}}." :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that the sine function can be defined in terms of complex exponentials as follows: \n\n$$\n\\operatorname{sin}⁡(12t)=\\frac{{e}^{12\\text{i}t}-{e}^{-12\\text{i}t}}{2\\text{i}}\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡(12t)} & =L{\\frac{{e}^{12\\text{i}t}-{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =L{\\frac{{e}^{12\\text{i}t}}{2\\text{i}}-\\frac{{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =L{\\frac{{e}^{12\\text{i}t}}{2\\text{i}}}-L{\\frac{{e}^{-12\\text{i}t}}{2\\text{i}}} \\\\  & =\\frac{1}{2\\text{i}}L{{e}^{12\\text{i}t}}-\\frac{1}{2\\text{i}}L{{e}^{-12\\text{i}t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{\\text{i}\\omega t}}=\\frac{1}{s-\\text{i}\\omega },\\,s>0.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{12\\text{i}t}} & =\\frac{1}{s-12\\text{i}},\\,s>0 \\\\ L{{e}^{-12\\text{i}t}} & =\\frac{1}{s+12\\text{i}},\\,s>0\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{sin}⁡(12t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{sin}⁡(12t)} & =\\frac{1}{2\\text{i}}L{{e}^{12\\text{i}t}}-\\frac{1}{2\\text{i}}L{{e}^{-12\\text{i}t}} \\\\  & =\\frac{1}{2\\text{i}}\\cdot \\frac{1}{s-12\\text{i}}-\\frac{1}{2\\text{i}}\\cdot \\frac{1}{s+12\\text{i}} \\\\  & =\\frac{1}{2\\text{i}}(\\frac{1}{s-12\\text{i}}-\\frac{1}{s+12\\text{i}}) \\\\  & =\\frac{1}{2\\text{i}}(\\frac{(s+12\\text{i})-(s-12\\text{i})}{(s-12\\text{i})(s+12\\text{i})}) \\\\  & =\\frac{1}{2\\text{i}}(\\frac{24\\text{i}}{{s}^{2}+144}) \\\\  & =\\frac{12}{{s}^{2}+144},\\end{aligned}\n$$\n\ndefined for $s>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341127/field-1" "q-341127/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c086bc97-415d-52c9-b26a-02dc8aebef33"] :knowledge-point/questions ["q-341127"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341140/field-1/05f2db0de7a411ee9ce1640ae2ff457275ecea847785933df35994319739b31b" :answer/id #uuid "7ccb86bb-2fa0-5770-a460-6d0caa5cef24" :answer/type :answer.type/math :answer/value "\\frac{s}{{s}^{2}+64}" :db/ensure [:answer/validate]} {:db/id "q-341140/field-1/6c4f2e6b7533d2ce029d1a368b55cf53b68751e6cec1b2804b6d3ab30739bb75" :answer/id #uuid "eaa9ab1b-4f5e-5c9d-ae54-cc56a6f3f5bd" :answer/type :answer.type/math :answer/value "\\frac{s}{{s}^{2}-64}" :db/ensure [:answer/validate]} {:db/id "q-341140/field-1/1cc8784f8380211e4eb6fb3a26418645eaf6d741e05cef40468443ec290a466a" :answer/id #uuid "c025be3d-c1ce-55be-b410-9c2256e83726" :answer/type :answer.type/math :answer/value "\\frac{8s}{{s}^{2}-64}" :db/ensure [:answer/validate]} {:db/id "q-341140/field-1/3e4483f0b48922b6b8812c06a8dcca44a41faa7a633f781a897af89b146fab99" :answer/id #uuid "f744ebb6-34e0-53b4-a486-8331f054d65f" :answer/type :answer.type/math :answer/value "\\frac{8}{{s}^{2}+64}" :db/ensure [:answer/validate]} {:db/id "q-341140/field-1/9b2c368d2ada17351d64f534f7552d876c6d0bcae87dd2c021f93efe7c43d6d0" :answer/id #uuid "75489219-717c-5d17-aeef-f21f4c739b1e" :answer/type :answer.type/math :answer/value "\\frac{8}{{s}^{2}-64}" :db/ensure [:answer/validate]} {:db/id "q-341140/field-1" :answer-field/id #uuid "da282941-a89a-5c51-ac40-7da982297231" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-341140/field-1/9b2c368d2ada17351d64f534f7552d876c6d0bcae87dd2c021f93efe7c43d6d0" :answer-field/choices ["q-341140/field-1/05f2db0de7a411ee9ce1640ae2ff457275ecea847785933df35994319739b31b" "q-341140/field-1/6c4f2e6b7533d2ce029d1a368b55cf53b68751e6cec1b2804b6d3ab30739bb75" "q-341140/field-1/1cc8784f8380211e4eb6fb3a26418645eaf6d741e05cef40468443ec290a466a" "q-341140/field-1/3e4483f0b48922b6b8812c06a8dcca44a41faa7a633f781a897af89b146fab99" "q-341140/field-1/9b2c368d2ada17351d64f534f7552d876c6d0bcae87dd2c021f93efe7c43d6d0"] :db/ensure [:answer-field/validate]} {:db/id "q-341140/field-2/9d34e85dabb5082358af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5" :answer/id #uuid "c7143e6e-e056-566b-b5d1-2a6ee4eff0de" :answer/type :answer.type/math :answer/value "s\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-341140/field-2/97a23ea6fb635b9f1ee51ed690353d47a20f675209e032e5ed03c67e1d25ac7b" :answer/id #uuid "dc333ece-532d-54c7-ba2b-2f90d757b1e5" :answer/type :answer.type/math :answer/value "s>-8" :db/ensure [:answer/validate]} {:db/id "q-341140/field-2/46af63e5816bfe37d9562c002d5969dd8f5406eadefe6e67411268361eaf7936" :answer/id #uuid "37dcdd00-56a5-5c08-bbf9-c6700f47b443" :answer/type :answer.type/math :answer/value "s\\ge 8" :db/ensure [:answer/validate]} {:db/id "q-341140/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" :answer/id #uuid "0b777078-5e33-5f45-86b0-7285724f6a46" :answer/type :answer.type/math :answer/value "s>0" :db/ensure [:answer/validate]} {:db/id "q-341140/field-2/6d8328509dacdbd6081a140366edb8e7c70691a106f66361e38a49ffe1445dee" :answer/id #uuid "b8c6a511-7ce2-5631-9c23-fe4364e4b85c" :answer/type :answer.type/math :answer/value "s>8" :db/ensure [:answer/validate]} {:db/id "q-341140/field-2/73d2f27a7444698a2a6d45c5f257c48f2948093fe319dc4919ca9d9098731abf" :answer/id #uuid "900f6818-48e4-51d5-8c27-8746eb677d93" :answer/type :answer.type/math :answer/value "s\\ge -8" :db/ensure [:answer/validate]} {:db/id "q-341140/field-2" :answer-field/id #uuid "bd718a3c-97c1-5f12-84f4-66ed25d81385" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-341140/field-2/6d8328509dacdbd6081a140366edb8e7c70691a106f66361e38a49ffe1445dee" :answer-field/choices ["q-341140/field-2/9d34e85dabb5082358af9360d93c7ce717fcea0db3670310b8eab46db4fc35b5" "q-341140/field-2/97a23ea6fb635b9f1ee51ed690353d47a20f675209e032e5ed03c67e1d25ac7b" "q-341140/field-2/46af63e5816bfe37d9562c002d5969dd8f5406eadefe6e67411268361eaf7936" "q-341140/field-2/de63348529d477cd70740ab9581d04b231678372657a4ecc21dd12e21b5d033c" "q-341140/field-2/6d8328509dacdbd6081a140366edb8e7c70691a106f66361e38a49ffe1445dee" "q-341140/field-2/73d2f27a7444698a2a6d45c5f257c48f2948093fe319dc4919ca9d9098731abf"] :db/ensure [:answer-field/validate]} {:db/id "q-341140" :question/id #uuid "f89dc302-60ce-5bd9-b567-660590ce563f" :question/math-academy-id "q-341140" :question/problem "Use the Laplace transform of $f(t)={e}^{kt}$ to find the Laplace transform of $\\operatorname{sinh}⁡(8t).$$\\,L{\\operatorname{sinh}⁡(8t)}=$ {{field-1}},\ndefined for {{field-2}}." :question/worked-solution "The linearity property of the Laplace transform states that for functions $f(t)$ and $g(t),$ we have\n\n$$\nL{\\alpha f(t)+\\beta g(t)}=\\alpha \\cdot L{f(t)}+\\beta \\cdot L{g(t)},\n$$\n\nwhere $\\alpha $ and $\\beta $ are constants.\n\nFirst, recall that, by definition\n\n$$\n\\operatorname{sinh}⁡(8t)=\\frac{{e}^{8t}-{e}^{-8t}}{2}.\n$$\n\nTaking the Laplace transform and applying the linearity property, we have\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(8t)} & =L{\\frac{{e}^{8t}-{e}^{-8t}}{2}} \\\\  & =L{\\frac{{e}^{8t}}{2}-\\frac{{e}^{-8t}}{2}} \\\\  & =L{\\frac{{e}^{8t}}{2}}-L{\\frac{{e}^{-8t}}{2}} \\\\  & =\\frac{1}{2}L{{e}^{8t}}-\\frac{1}{2}L{{e}^{-8t}}.\\end{aligned}\n$$\n\nNow, we recall that \n\n$$\nL{{e}^{kt}}=\\frac{1}{s-k},\\,s>k.\n$$\n\nTherefore, we have the following:\n\n$$\n\\begin{aligned}L{{e}^{8t}} & =\\frac{1}{s-8},\\,s>8 \\\\ L{{e}^{-8t}} & =\\frac{1}{s+8},\\,s>-8\\end{aligned}\n$$\n\nTherefore, the Laplace transform of $\\operatorname{sinh}⁡(8t)$ is\n\n$$\n\\begin{aligned}L{\\operatorname{sinh}⁡(8t)} & =\\frac{1}{2}L{{e}^{8t}}-\\frac{1}{2}L{{e}^{-8t}} \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{s-8}-\\frac{1}{2}\\cdot \\frac{1}{s+8} \\\\  & =\\frac{1}{2}(\\frac{1}{s-8}-\\frac{1}{s+8}) \\\\  & =\\frac{1}{2}(\\frac{(s+8)-(s-8)}{(s-8)(s+8)}) \\\\  & =\\frac{1}{2}(\\frac{16}{{s}^{2}-64}) \\\\  & =\\frac{8}{{s}^{2}-64}.\\end{aligned}\n$$\n\nFinally, since $L{{e}^{8t}}$ is defined for $s\\in (8,\\infty )$ and $L{{e}^{-8t}}$ is defined for $s\\in (-8,\\infty ),$ we have that $L{\\operatorname{sinh}⁡(8t)}$ is defined for\n\n$$\n(8,\\infty )\\cap (-8,\\infty )=(8,\\infty ),\n$$\n\nthat is, $s>8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341140/field-1" "q-341140/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c086bc97-415d-52c9-b26a-02dc8aebef33"] :knowledge-point/questions ["q-341140"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341107/field-1/10554f744483b038c6c9f8a501b720796f02145e8900c0df4adead265784ea32" :answer/id #uuid "674c91be-90d5-5397-b9e8-57b4312eaf74" :answer/type :answer.type/math :answer/value "\\frac{2}{{s}^{2}-4}" :db/ensure [:answer/validate]} {:db/id "q-341107/field-1/aad6966d56b54a11281612d23dd6238ff8a4507ed06e5c9c8e34b17b8a48f64c" :answer/id #uuid "6a6425ad-42a4-50c4-8dbb-e632e407f2bc" :answer/type :answer.type/math :answer/value "\\frac{2s}{{s}^{2}-4}" :db/ensure [:answer/validate