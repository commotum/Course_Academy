db/id #edb/ref 17592186144314}] :question/id #uuid "7a4749b4-7bc7-5f25-b6f4-236f9d3ed717" :question/math-academy-id "q-340665" :question/problem "Use the Laplace transform of $f(t) = e^{\\textrm{i}ωt}$ to find the Laplace transform of $\\sin (3t)$.$L{\\sin (3t)} =$ {{field-1}},\ndefined for {{field-2}}."}] [{:db/id #edb/ref 17592186148154 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ad93e2e-20ab-5179-90b2-f96a357bd94c" :knowledge-point/title "Finding Laplace Transforms of Sums of Exponentials"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b08466b2-6a52-5d2d-854f-41c691eec74b" :answer/type {:db/ident :answer.type/math} :answer/value "(s + 4)/((s - 2)(s + 4))" :db/id #edb/ref 17592186146936} {:answer/id #uuid "0355b8f6-cadd-5a3a-9e2f-02fe0c277166" :answer/type {:db/ident :answer.type/math} :answer/value "- (6)/((s + 2)(s - 4))" :db/id #edb/ref 17592186146937} {:answer/id #uuid "0df6ea69-1bd0-55be-968d-e3dae171da50" :answer/type {:db/ident :answer.type/math} :answer/value "(2s)/((s + 2)(s - 4))" :db/id #edb/ref 17592186146938} {:answer/id #uuid "2cfeca58-6dc8-5979-9085-65e6631ba597" :answer/type {:db/ident :answer.type/math} :answer/value "(2s - 6)/((s + 2)(s - 4))" :db/id #edb/ref 17592186146939} {:answer/id #uuid "507beb4e-935f-5587-ab40-2b033d330c65" :answer/type {:db/ident :answer.type/math} :answer/value "- (2)/((s - 2)(s + 4))" :db/id #edb/ref 17592186146940}] :answer-field/correct {:answer/id #uuid "0355b8f6-cadd-5a3a-9e2f-02fe0c277166" :answer/type {:db/ident :answer.type/math} :answer/value "- (6)/((s + 2)(s - 4))" :db/id #edb/ref 17592186146937} :answer-field/id #uuid "08888f2b-a76a-5e08-8194-aec64b32cdda" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146935}] :question/id #uuid "5620868a-e836-565c-a7cc-7e2d887588f3" :question/math-academy-id "q-89589" :question/problem "Find the Laplace transform of $f(t) = e^{-2t} - e^{4t}$ for $s > 4$."}]}
