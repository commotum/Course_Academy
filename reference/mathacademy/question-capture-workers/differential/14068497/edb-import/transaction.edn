[{:db/id "q-340871/selection/cc9975308b37ddb67da1bd731af101adaea76d42ad25cb4061ba3800c9e2fd0b" :answer/id #uuid "7cec45e8-ee75-5648-b0f5-527249860ff0" :answer/type :answer.type/math :answer/value "-2{x}^{3}-3x" :db/ensure [:answer/validate]} {:db/id "q-340871/selection/324889edf01e46d1542d2b9882b6b19abfd0b0d720a84f4194b11ad06d57134a" :answer/id #uuid "2af78195-7cb7-578a-a365-cd5829587aa5" :answer/type :answer.type/math :answer/value "-2{x}^{3}+3x" :db/ensure [:answer/validate]} {:db/id "q-340871/selection/a085966b8bfe0bbbe9d83a682333b8339c86f2af2566af6511f53a55f6fdc4a7" :answer/id #uuid "4782782c-fe27-5891-8566-e02868c4f366" :answer/type :answer.type/math :answer/value "2{x}^{3}-3x" :db/ensure [:answer/validate]} {:db/id "q-340871/selection/cf5c35d576c8ea09af6f3c7dffd502ef854fc0ee8afec99022153a2fa3471f74" :answer/id #uuid "a277f27a-334b-50fd-a67f-1242de902d89" :answer/type :answer.type/math :answer/value "|2{x}^{3}-3x|" :db/ensure [:answer/validate]} {:db/id "q-340871/selection/a4c99fea42598bee87df48dccd9a807b7ed65329603848ecfbf7ee0b490936b7" :answer/id #uuid "498ec876-9b1c-533e-9485-7fc44b1ef3f7" :answer/type :answer.type/math :answer/value "-2|x{|}^{3}-3|x|" :db/ensure [:answer/validate]} {:db/id "q-340871/selection" :answer-field/id #uuid "2c6c0a61-fe1d-5737-bc46-1bfe1a8c9543" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-340871/selection/324889edf01e46d1542d2b9882b6b19abfd0b0d720a84f4194b11ad06d57134a" :answer-field/choices ["q-340871/selection/cc9975308b37ddb67da1bd731af101adaea76d42ad25cb4061ba3800c9e2fd0b" "q-340871/selection/324889edf01e46d1542d2b9882b6b19abfd0b0d720a84f4194b11ad06d57134a" "q-340871/selection/a085966b8bfe0bbbe9d83a682333b8339c86f2af2566af6511f53a55f6fdc4a7" "q-340871/selection/cf5c35d576c8ea09af6f3c7dffd502ef854fc0ee8afec99022153a2fa3471f74" "q-340871/selection/a4c99fea42598bee87df48dccd9a807b7ed65329603848ecfbf7ee0b490936b7"] :db/ensure [:answer-field/validate]} {:db/id "q-340871" :question/id #uuid "0c9986f6-455d-58dd-ab28-d5ee5bd89b4f" :question/math-academy-id "q-340871" :question/problem "Let $F(x)=-2{x}^{3}+3x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **odd** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the odd extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ -F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =-F(-x) \\\\  & =-(-2(-x)^{3}+3(-x)) \\\\  & =-(2{x}^{3}-3x) \\\\  & =-2{x}^{3}+3x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340871/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f5ee3c3f-4289-5e38-a47a-52e5c2ad3817"] :knowledge-point/questions ["q-340871"] :db/ensure [:knowledge-point/validate]} {:db/id "q-340866/selection/2c9e12a769f4fbc7a35b2cc9e8a38ea637131ec824717330960f2464d0e4e8f2" :answer/id #uuid "e4662f77-7696-5157-9055-476b2d5663d4" :answer/type :answer.type/math :answer/value "3|x{|}^{2}+2|x|" :db/ensure [:answer/validate]} {:db/id "q-340866/selection/1d36649cd1178ce5956f0693f5b4f8fb827fd4279d9b029720e7be629d473956" :answer/id #uuid "7190e045-32f5-5fe2-997f-dbed81c063a1" :answer/type :answer.type/math :answer/value "-3{x}^{2}-2x" :db/ensure [:answer/validate]} {:db/id "q-340866/selection/a764981c08763f073c6bdb0acd7de6549a54350623d2bb91a7766c94b1f2615d" :answer/id #uuid "b16a5a44-102d-5e57-bf96-e713df35f973" :answer/type :answer.type/math :answer/value "|-3{x}^{2}+2x|" :db/ensure [:answer/validate]} {:db/id "q-340866/selection/833ee7593f55d3a3815ee59a0ca0dea6529c4237438711695e5dd1196c973a02" :answer/id #uuid "d823b040-01d5-54da-80a7-3d3839523dde" :answer/type :answer.type/math :answer/value "-3{x}^{2}+2x" :db/ensure [:answer/validate]} {:db/id "q-340866/selection/98205b44ae1c52ccc34101970f0e6869773d8fe0