ch}⁡z\\operatorname{coth}⁡z+3{csch}^{2}⁡z)\\,\\text{d}z \\\\  & =7\\int \\operatorname{csch}⁡z\\operatorname{coth}⁡z\\,\\text{d}z+3\\int {csch}^{2}⁡z\\,\\text{d}z \\\\  & =7(-\\operatorname{csch}⁡z)+3(-\\operatorname{coth}⁡z)+C \\\\  & =-7\\operatorname{csch}⁡z-3\\operatorname{coth}⁡z+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96053/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887"] :knowledge-point/questions ["q-96053"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96055/selection/6355f05c51be3b76d2f25288230465418fea5d398aa3d71499260f4f230a53d2" :answer/id #uuid "ac80e5c1-9497-5654-9017-aebc7b0be494" :answer/type :answer.type/math :answer/value "-2\\operatorname{coth}⁡t-\\operatorname{cosh}⁡t+C" :db/ensure [:answer/validate]} {:db/id "q-96055/selection/fa9ea814a99cba4434208f4380714f2eef3680a40d81fec791c303b474045fcc" :answer/id #uuid "6adc60b9-17a8-5f75-a61a-a023629cf8ba" :answer/type :answer.type/math :answer/value "-2{coth}^{2}⁡t+\\operatorname{cosh}⁡t+C" :db/ensure [:answer/validate]} {:db/id "q-96055/selection/1c9fd3747073004f0411fd40de0122a63d5e7c18ae68ac70f235fb4a2b4516e3" :answer/id #uuid "182d3b2b-1ff8-5162-9803-5cdc14fde36a" :answer/type :answer.type/math :answer/value "2\\operatorname{coth}⁡t-\\operatorname{cosh}⁡t+C" :db/ensure [:answer/validate]} {:db/id "q-96055/selection/3c869cf3d8e9726f6b5365efd6822dd622c6c69d35cec58d116c4060c3094b5e" :answer/id #uuid "9ae7dbf8-9d35-59f4-8fb4-f5967daa274a" :answer/type :answer.type/math :answer/value "-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/ensure [:answer/validate]} {:db/id "q-96055/selection/40a1d3e84cbd71fe2343a7904097a0b504058801906fe3775f9d88be839426d1" :answer/id #uuid "ceaf322b-af0a-5832-9ab1-5005664b314b" :answer/type :answer.type/math :answer/value "2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/ensure [:answer/validate]} {:db/id "q-96055/selection" :answer-field/id #uuid "8d77f60d-e9ec-5547-bf6b-a7c070b2c1dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96055/selection/3c869cf3d8e9726f6b5365efd6822dd622c6c69d35cec58d116c4060c3094b5e" :answer-field/choices ["q-96055/selection/6355f05c51be3b76d2f25288230465418fea5d398aa3d71499260f4f230a53d2" "q-96055/selection/fa9ea814a99cba4434208f4380714f2eef3680a40d81fec791c303b474045fcc" "q-96055/selection/1c9fd3747073004f0411fd40de0122a63d5e7c18ae68ac70f235fb4a2b4516e3" "q-96055/selection/3c869cf3d8e9726f6b5365efd6822dd622c6c69d35cec58d116c4060c3094b5e" "q-96055/selection/40a1d3e84cbd71fe2343a7904097a0b504058801906fe3775f9d88be839426d1"] :db/ensure [:answer-field/validate]} {:db/id "q-96055" :question/id #uuid "59346a59-f274-5f87-97f7-8c14ba6c65f5" :question/math-academy-id "q-96055" :question/problem "$\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cosh}⁡t)=\\operatorname{sinh}⁡t & \\,⇒\\,\\int \\operatorname{sinh}⁡t\\,\\text{d}t=\\operatorname{cosh}⁡t+C, \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{coth}⁡t)=-{csch}^{2}⁡t & \\,⇒\\,\\int {csch}^{2}⁡t\\,\\text{d}t=-\\operatorname{coth}⁡t+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t & =2\\int {csch}^{2}⁡t\\,\\text{d}t+\\int \\operatorname{sinh}⁡t\\,\\text{d}t \\\\  & =2(-\\operatorname{coth}⁡t)+\\operatorname{cosh}⁡t+C \\\\  & =-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96055/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887"] :knowledge-point/questions ["q-96055"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96054/selection/5e5b7b78e05312010bd3d8c4864424418f89d4907695c0be8440623304e3b259" :answer/id #