re [:answer-field/validate]} {:db/id "q-96054" :question/id #uuid "0feed909-e693-5beb-ad60-bfca44e620f8" :question/math-academy-id "q-96054" :question/problem "$\\int (6\\operatorname{cosh}⁡z-9{csch}^{2}⁡z)\\,\\text{d}z=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}z}(\\operatorname{sinh}⁡z)=\\operatorname{cosh}⁡z & \\,⇒\\,\\int \\operatorname{cosh}⁡z\\,\\text{d}z=\\operatorname{sinh}⁡z+C, \\\\ \\frac{\\text{d}}{\\text{d}z}(\\operatorname{coth}⁡z)=-{csch}^{2}⁡z & \\,⇒\\,\\int {csch}^{2}⁡z\\,\\text{d}z=-\\operatorname{coth}⁡z+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (6\\operatorname{cosh}⁡z-9{csch}^{2}⁡z)\\,\\text{d}z & =6\\int \\operatorname{cosh}⁡z\\,\\text{d}z-9\\int {csch}^{2}⁡z\\,\\text{d}z \\\\  & =6\\operatorname{sinh}⁡z-9(-\\operatorname{coth}⁡z)+C \\\\  & =6\\operatorname{sinh}⁡z+9\\operatorname{coth}⁡z+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96054/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887"] :knowledge-point/questions ["q-96054"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8341"] :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nCalculate $\\displaystyle \\int 8\\cosh t \\,\\textrm{d}t.$" :question/worked-solution "Recall that\n\n$$\n\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}\n\\dfrac{\\textrm d}{\\textrm d t}(\\sinh t) = \\cosh{t} \\quad\\Rightarrow\\quad  \\int \\cosh{t} \\, \\textrm dt = \\sinh{t} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 8\\operatorname{cosh}⁡t\\,\\text{d}t=8\\int \\operatorname{cosh}⁡t\\,\\text{d}t=8\\operatorname{sinh}⁡t+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8342"] :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int \\left(-3\\sech x \\tanh x\\right) \\,\\textrm{d}x =$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\sech x) = -\\sech{x}\\tanh x \n\\quad\\Rightarrow\\quad  \n\\int \\sech{x}\\tanh{x} \\, \\textrm dx = -\\sech{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-3\\text{\\sech}x\\operatorname{tanh}⁡x)\\,\\text{d}x & =-3\\int \\text{\\sech}x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =-3(-\\text{\\sech}x)+C \\\\  & =3\\text{\\sech}x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8343"] :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int 6\\sech^2 x \\,\\textrm{d}x =$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\tanh x) = \\sech^2{x} \\quad\\Rightarrow\\quad  \\int \\sech^2{x} \\, \\textrm dx = \\tanh{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 6{\\text{\\sech}}^{2}x\\,\\text{d}x=6\\int {\\text{\\sech}}^{2}x\\,\\text{d}x=6\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8344"] :question/problem "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\n$\\displaystyle \\int (-8\\csch^2 x )\\,\\textrm{d}x =$" :question/worked-solution "$\\newcommand{\\arsinh}{\\mathop{\\rm arsinh}\\nolimits}\n\\newcommand{\\arcosh}{\\mathop{\\rm arcosh}\\nolimits}\n\\newcommand{\\artanh}{\\mathop{\\rm artanh}\\nolimits}\n\\newcommand{\\sech}{\\mathop{\\rm sech}\\nolimits}\n\\newcommand{\\csch}{\\mathop{\\rm csch}\\nolimits}\n\\newcommand{\\coth}{\\mathop{\\rm coth}\\nolimits}\n\\newcommand{\\arsech}{\\mathop{\\rm arsech}\\nolimits}\n\\newcommand{\\arcsch}{\\mathop{\\rm arcsch}\\nolimits}\n\\newcommand{\\arcoth}{\\mathop{\\rm arcoth}\\nolimits}$\n\nRecall that\n\n$$\n\\dfrac{\\textrm d}{\\textrm d x}(\\coth x) = -\\csch^2{x} \\quad\\Rightarrow\\quad  \\int \\csch^2{x} \\, \\textrm dx = -\\coth{x} + C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-8{\\text{\\csch}}^{2}x)\\,\\text{d}x & =-8\\int {\\text{\\csch}}^{2}x\\,\\text{d}x \\\\  & =-(-8\\operatorname{coth}⁡x)+C \\\\  & =8\\operatorname{coth}⁡x+C.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
