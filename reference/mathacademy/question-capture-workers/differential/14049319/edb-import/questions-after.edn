atorname{sinh}⁡\\theta \\,\\text{d}\\theta =\\operatorname{cosh}⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int -\\sqrt{5}\\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta  & =-\\sqrt{5}\\int \\operatorname{sinh}⁡\\theta \\,\\text{d}\\theta  \\\\  & =-\\sqrt{5}\\operatorname{cosh}⁡\\theta +C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327883 :knowledge-point/_questions [{:knowledge-point/id #uuid "f07c0f22-39fe-5576-8aab-e2dfdb3227b8" :knowledge-point/title "Integrating the Hyperbolic Sine and the Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6fdf3793-0333-5471-b295-11eb4f845600" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡t-\\operatorname{sinh}⁡t+C" :db/id #edb/ref 17592186327885} {:answer/id #uuid "de942f23-ecf7-51e7-aad9-0949ad165de0" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cosh}⁡t-\\operatorname{sinh}⁡t+C" :db/id #edb/ref 17592186327886} {:answer/id #uuid "60b94e74-f3bf-5ef6-bb4a-fbf94ba9cedf" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sinh}⁡t-2\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327887} {:answer/id #uuid "7bb9523c-644c-5bf7-a36e-88e714cfc993" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡t+\\operatorname{sinh}⁡t+C" :db/id #edb/ref 17592186327888} {:answer/id #uuid "923fd3ff-3022-50e3-adeb-fc93a22fdb34" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327889}] :answer-field/correct {:answer/id #uuid "7bb9523c-644c-5bf7-a36e-88e714cfc993" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡t+\\operatorname{sinh}⁡t+C" :db/id #edb/ref 17592186327888} :answer-field/id #uuid "ff48efc4-7a07-53b8-9375-bfbf10f5db62" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327884}] :question/difficulty {:db/id #edb/ref 17