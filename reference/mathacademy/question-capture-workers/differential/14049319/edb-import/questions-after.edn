have\n\n$$\n\\begin{aligned}\\int (-\\operatorname{sech}⁡t\\operatorname{tanh}⁡t)\\,\\text{d}t & =-\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t \\\\  & =-(-\\operatorname{sech}⁡t)+C \\\\  & =\\operatorname{sech}⁡t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327904 :knowledge-point/_questions [{:knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d" :knowledge-point/title "Integrating Hyperbolic Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08cddba4-9d92-5518-bf18-93913cd893d2" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cosh}⁡x+\\operatorname{csch}⁡x+C" :db/id #edb/ref 17592186327906} {:answer/id #uuid "75cf19d5-80c7-5713-a2f2-f0c1f85171d7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡x+\\operatorname{csch}⁡x+C" :db/id #edb/ref 17592186327907} {:answer/id #uuid "5f1397a7-7717-5f1a-af25-d07456cfb976" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{cosh}⁡x-\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186327908} {:answer/id #uuid "ce2a04eb-bdd3-5652-9a71-15af58a59ef7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186327909} {:answer/id #uuid "65d0c7ec-5dd3-5f56-b267-588122b3e1e2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡x-\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186327910}] :answer-field/correct {:answer/id #uuid "ce2a04eb-bdd3-5652-9a71-15af58a59ef7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{cosh}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186327909} :answer-field/id #uuid "98e90f26-79aa-50df-9c87-30430da78b28" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327905}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f47cca29-565c-5ad8-917b-be332ffd40a2" :question/math-academy-id "q-96002" :question/problem "$\\int (2\\operatorname{sinh}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{cosh}⁡x)=\\operatorname{sinh}⁡x\\, & ⇒\\,\\int \\operatorname{sinh}⁡x\\,\\text{d}x=\\operatorname{cosh}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\, & ⇒\\,\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x=-\\operatorname{sech}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{sinh}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\text{d}x & =\\int 2\\operatorname{sinh}⁡x\\,\\text{d}x+\\int (-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x \\\\  & =2\\int \\operatorname{sinh}⁡x\\,\\text{d}x-\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =2\\operatorname{cosh}⁡x-(-\\operatorname{sech}⁡x)+C \\\\  & =2\\operatorname{cosh}⁡x+\\operatorname{sech}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327911 :knowledge-point/_questions [{:knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d" :knowledge-point/title "Integrating Hyperbolic Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b160476f-48fb-58c4-ae32-bfa685d302f2" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{sinh}⁡y-5\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186327913} {:answer/id #uuid "3b071cc7-d104-58ac-86ac-79ff35747e04" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{sech}⁡y+3\\operatorname{sinh}⁡y+C" :db/id #edb/ref 17592186327914} {:answer/id #uuid "f1152952-e5d5-5d7e-8430-f682bb2a3ef5" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{csch}⁡y+3\\operatorname{sinh}⁡y+C" :db/id #edb/ref 17592186