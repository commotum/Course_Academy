s [{:answer/id #uuid "c6f34ef7-504d-5bcb-92aa-f7f17f51e9a1" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{sinh}⁡z-9\\operatorname{coth}⁡z+C" :db/id #edb/ref 17592186327976} {:answer/id #uuid "3d62b67a-6d3f-5193-ad83-fd77699681d4" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\operatorname{sinh}⁡z-9\\operatorname{coth}⁡z+C" :db/id #edb/ref 17592186327977} {:answer/id #uuid "6fd7689e-60ea-5c87-ad9a-1743e4f3d416" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{sinh}⁡z+9\\operatorname{coth}⁡z+C" :db/id #edb/ref 17592186327978} {:answer/id #uuid "9ed8dea3-368b-5556-ad06-4e4c11c4b3fe" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{sinh}⁡z+9{tanh}^{2}⁡z+C" :db/id #edb/ref 17592186327979} {:answer/id #uuid "14f10488-956e-5a06-b0d9-dc974c3231d6" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\operatorname{sinh}⁡z+9\\operatorname{coth}⁡z+C" :db/id #edb/ref 17592186327980}] :answer-field/correct {:answer/id #uuid "6fd7689e-60ea-5c87-ad9a-1743e4f3d416" :answer/type {:db/ident :answer.type/math} :answer/value "6\\operatorname{sinh}⁡z+9\\operatorname{coth}⁡z+C" :db/id #edb/ref 17592186327978} :answer-field/id #uuid "2fa951e3-b677-5d9e-bb9e-ad2ad137b3e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327975}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0feed909-e693-5beb-ad60-bfca44e620f8" :question/math-academy-id "q-96054" :question/problem "$\\int (6\\operatorname{cosh}⁡z-9{csch}^{2}⁡z)\\,\\text{d}z=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}z}(\\operatorname{sinh}⁡z)=\\operatorname{cosh}⁡z & \\,⇒\\,\\int \\operatorname{cosh}⁡z\\,\\text{d}z=\\operatorname{sinh}⁡z+C, \\\\ \\frac{\\text{d}}{\\text{d}z}(\\operatorname{coth}⁡z)=-{csch}^{2}⁡z & \\,⇒\\,\\int {csch}^{2}⁡z\\,\\text{d}z=-\\operatorname{coth}⁡z+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (6\\operatorname{cosh}⁡z-9{csch}^{2}⁡z)\\,\\text{d}z & =6\\int \\operatorname{cosh}⁡z\\,\\text{d}z-9\\int {csch}^{2}⁡z\\,\\text{d}z \\\\  & =6\\operatorname{sinh}⁡z-9(-\\operatorname{coth}⁡z)+C \\\\  & =6\\operatorname{sinh}⁡z+9\\operatorname{coth}⁡z+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327981 :knowledge-point/_questions [{:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887" :knowledge-point/title "Integrating the Square of the Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "182d3b2b-1ff8-5162-9803-5cdc14fde36a" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{coth}⁡t-\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327983} {:answer/id #uuid "9ae7dbf8-9d35-59f4-8fb4-f5967daa274a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327984} {:answer/id #uuid "ceaf322b-af0a-5832-9ab1-5005664b314b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327985} {:answer/id #uuid "ac80e5c1-9497-5654-9017-aebc7b0be494" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{coth}⁡t-\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327986} {:answer/id #uuid "6adc60b9-17a8-5f75-a61a-a023629cf8ba" :answer/type {:db/ident :answer.type/math} :answer/value "-2{coth}^{2}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327987}] :answer-field/correct {:answer/id #uuid "9ae7dbf8-9d35-59f4-8fb4-f5967daa274a" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C" :db/id #edb/ref 17592186327984} :answer-field/id #uuid "8d77f60d-e9ec-5547-bf6b-a7c070b2c1dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327982}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "59346a59-f274-5f87-97f7-8c14ba6c65f5" :question/math-academy-id "q-96055" :question/problem "$\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cosh}⁡t)=\\operatorname{sinh}⁡t & \\,⇒\\,\\int \\operatorname{sinh}⁡t\\,\\text{d}t=\\operatorname{cosh}⁡t+C, \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{coth}⁡t)=-{csch}^{2}⁡t & \\,⇒\\,\\int {csch}^{2}⁡t\\,\\text{d}t=-\\operatorname{coth}⁡t+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2{csch}^{2}⁡t+\\operatorname{sinh}⁡t)\\,\\text{d}t & =2\\int {csch}^{2}⁡t\\,\\text{d}t+\\int \\operatorname{sinh}⁡t\\,\\text{d}t \\\\  & =2(-\\operatorname{coth}⁡t)+\\operatorname{cosh}⁡t+C \\\\  & =-2\\operatorname{coth}⁡t+\\operatorname{cosh}⁡t+C.\\end{aligned}\n$$"}]}
