-5\\operatorname{csch}⁡y+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327918 :knowledge-point/_questions [{:knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d" :knowledge-point/title "Integrating Hyperbolic Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "40d4a622-8853-5b28-9f56-83798851e0fb" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{sech}⁡\\theta +C" :db/id #edb/ref 17592186327920} {:answer/id #uuid "2678424f-f46b-5254-8a29-dc995b167bef" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{csch}⁡\\theta +C" :db/id #edb/ref 17592186327921} {:answer/id #uuid "3758da1f-3b18-593d-a61b-3fca1a53daa1" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sech}⁡\\theta +C" :db/id #edb/ref 17592186327922} {:answer/id #uuid "53990cc6-dc5a-53bd-b67c-71ebc15215f4" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{cot}⁡\\theta +C" :db/id #edb/ref 17592186327923} {:answer/id #uuid "20e1e8a2-0221-591a-ae1d-c76019083823" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{csch}⁡\\theta +C" :db/id #edb/ref 17592186327924}] :answer-field/correct {:answer/id #uuid "2678424f-f46b-5254-8a29-dc995b167bef" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{csch}⁡\\theta +C" :db/id #edb/ref 17592186327921} :answer-field/id #uuid "483514d5-999c-5495-954f-5bc0b8e87319" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327919}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "03647155-94db-52b6-8171-fdf21460ff9c" :question/math-academy-id "q-96006" :question/problem "$\\int 5\\operatorname{coth}⁡\\theta \\operatorname{csch}⁡\\theta \\,\\text{d}\\theta =$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}\\theta }(\\operatorname{csch}⁡\\theta )=-\\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta \\,⇒\\,\\int \\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta \\,\\text{d}\\theta =-\\operatorname{csch}⁡\\theta +C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 5\\operatorname{coth}⁡\\theta \\operatorname{csch}⁡\\theta \\,\\text{d}x & =5\\int \\operatorname{csch}⁡\\theta \\operatorname{coth}⁡\\theta \\,\\text{d}x \\\\  & =-5\\operatorname{csch}⁡\\theta +C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327925 :knowledge-point/_questions [{:knowledge-point/id #uuid "e1992086-0858-551d-a6dc-042276c5d7f9" :knowledge-point/title "Integrating the Square of the Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc950ee2-7c99-5dcc-a392-701c31c2ea7b" :answer/type {:db/ident :answer.type/math} :answer/value "{tanh}^{2}⁡t+C" :db/id #edb/ref 17592186327927} {:answer/id #uuid "e381bb9f-9a73-5025-8a66-34329a135671" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{coth}⁡t+C" :db/id #edb/ref 17592186327928} {:answer/id #uuid "38a479c0-9635-5b95-a6b9-d3aeb9ee6ac1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{coth}⁡t+C" :db/id #edb/ref 17592186327929} {:answer/id #uuid "c40603f0-1d80-50d2-b0c8-f04e4e04c641" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tanh}⁡t+C" :db/id #edb/ref 17592186327930} {:answer/id #uuid "2d863820-1b76-5816-830e-38f2a685e57f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tanh}⁡t+C" :db/id #edb/ref 17592186327931}] :answer-field/correct {:answer/id #uuid "c40603f0-1d80-50d2-b0c8-f04e4e04c641" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{tanh}⁡t+C" :db/id #edb/ref 17592186327930} :answer-field/id #uuid "5ab3adfe-6d81-5063-8bba-443866fe22e5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327926}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "81d02411-ed88-5e20-83c5-34c2fccec3e8" :question/math-academy-id "q-96010" :question/problem "$\\int (-{sech}^{2}⁡t)\\,\\text{d}t=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}t}(\\operatorname{tanh}⁡t)={sech}^{2}⁡t\\,⇒\\,\\int {sech}^{2}⁡t\\,\\text{d}t=\\operatorname{tanh}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (-{sech}^{2}⁡t)\\,\\text{d}t & =-\\int {sech}^{2}⁡t\\,\\text{d}t \\\\  & =-\\operatorname{tanh}⁡t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327932 :knowledge-point/_questions [{:knowledge-point/id #uuid "e1992086-0858-551d-a6dc-042276c5d7f9" :knowledge-point/title "Integrating the Square of the Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d7b8c44b-7cf6-5413-9787-6a14ecd4926f" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{sech}⁡y-\\operatorname{tanh}⁡y+C" :db/id #edb/ref 17592186327934} {:answer/id #uuid "1a44f0a6-8c7f-5121-b9ec-f5665e0006ff" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sech}⁡y+\\operatorname{tanh}⁡y+C" :db/id #edb/ref 17592186327935} {:answer/id #uuid "58f283dc-8f63-5af7-86fe-8dabbb602172" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{sech}⁡y-\\operatorname{coth}⁡y+C" :db/id #edb/ref 17592186327936} {:answer/id #uuid "86ad5c92-1c5a-5754-baaf-e75b7af29e2b" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sech}⁡y-\\operatorname{coth}⁡y+C" :db/id #edb/ref 17592186327937} {:answer/id #uuid "d4744f26-3e8c-53e3-b626-4d9e7a06f840" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sech}⁡y-\\operatorname{tanh}⁡y+C" :db/id #edb/ref 17592186327938}] :answer-field/correct {:answer/id #uuid "d4744f26-3e8c-53e3-b626-4d9e7a06f840" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{sech}⁡y-\\operatorname{tanh}⁡y+C" :db/id #edb/re