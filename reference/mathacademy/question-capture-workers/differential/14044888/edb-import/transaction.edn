"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5"] :knowledge-point/questions ["q-49811"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80497/selection/2761957520a7cbe89472768165508e9b81c092fbd9df692de3a16e31f160c2d4" :answer/id #uuid "fd5f329e-3276-5e7d-929b-08b10ee19280" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/2527ad3b4f6d0a1d84a9e907b5e3e9bddee439fbd17c2a1a4c3ca8c418f65293.png" :db/ensure [:answer/validate]} {:db/id "q-80497/selection/3265966de6c49bb7dd40da954dcc5171c9ee74ae96456fa844d2058580518ae0" :answer/id #uuid "e9c73b29-7c30-5a73-9a94-ddf71a0f9486" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/1b8e42e667d2fe4c713e92f879c9894e826fdbe3e6928addb3c4b36ce71991e0.png" :db/ensure [:answer/validate]} {:db/id "q-80497/selection/55fde28b0967dd2237c03901f7e190e63ce91ebd880e6993f5d07fb2fcc69d85" :answer/id #uuid "9e6d8335-509a-5346-b0a7-7db4e2af08ab" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3ddcc5784dc1fd60ba3c95ecda373678d00fc6c45e6b5e5655febcc130c37d95.png" :db/ensure [:answer/validate]} {:db/id "q-80497/selection/fb27a8fb39a732e3d461884712e4282188b32e111564ad88f76b1f2133b8290f" :answer/id #uuid "17de6847-5e71-5f02-b67a-9978b2a76c2c" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e7e267508d68c1d4eeb31509a4a2957e120cecab920481ba6dc2b0fa1f84433b.png" :db/ensure [:answer/validate]} {:db/id "q-80497/selection/f0a1e537df7d4041da32001d6a2406396194066c32a47cda2e33f6f42292c38e" :answer/id #uuid "cf1909e1-91af-5de0-b3f4-2e07b75192fc" :answer/type :answer.type