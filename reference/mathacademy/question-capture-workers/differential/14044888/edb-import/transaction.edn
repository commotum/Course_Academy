erence/mathacademy/question-capture-workers/differential/14044888/assets/1bd04b981c412d771617ffaaa7cedf88b063ae49ab567cd27d665eb381a1b648.png" :db/ensure [:answer/validate]} {:db/id "q-119369/selection" :answer-field/id #uuid "b1c6d7f6-9b65-5167-9aed-5668a3e7a8b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119369/selection/7c743ed1b97562d9fb457eb9e1822d83796581df6f55a095d8832dc36f09c5af" :answer-field/choices ["q-119369/selection/b96b0b9eec2edd84f72bbab2674d34e54692d2efa950b39f7c946f18bda1c16f" "q-119369/selection/b186c0d5edc3e40e270409eea82ce2f8efb2992746c32c1e78457663666ae843" "q-119369/selection/c6e6481893b2625dd7636db3301a1edd996b26b790e562a585834ad8185eab6c" "q-119369/selection/20018a84ab19202174bc13ee0d0b8241668f588c6e55315608070326863eb91f" "q-119369/selection/7c743ed1b97562d9fb457eb9e1822d83796581df6f55a095d8832dc36f09c5af"] :db/ensure [:answer-field/validate]} {:db/id "q-119369" :question/id #uuid "0fdcac11-a7b2-5665-a341-f378b359ea29" :question/math-academy-id "q-119369" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y-{x}^{2}?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/1bd04b981c412d771617ffaaa7cedf88b063ae49ab567cd27d665eb381a1b648.png)\n\n  \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/83f2ac528d0e4bdd7e486284a9f3d5692e0111c5cdc58dcc554e12dd0185f15f.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119369/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a2334101-5266-5853-aedf-04c85746b5cc"] :knowledge-point/questions ["q-119369"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119383/selection/05d2850124209bd01f83b226d2693c67c8f3aff1fae8592e1141fa62301b55f9" :answer/id #uuid "16c46ae3-7c85-5e04-8d9b-847d98efed69" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/c959785ef067b41eba5e5ca5f0759acdd81c9f613c92854ba5937be6bced2c86.png" :db/ensure [:answer/validate]} {:db/id "q-119383/selection/10a379d787175b630822035f4196bd41fe904f371f15086a3bcc7a245b7bc5bc" :answer/id #uuid "5d88b7b6-f8e5-5336-be0b-fde47a0f6ad9" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/fe57c0cc2d75729921eb46408e0e4a6932eba06c00034f2ec4c579c8c5627376.png" :db/ensure [:answer/validate]} {:db/id "q-119383/selection/5679b1228afaac74c6da06c58677b711adc79342f38cb1b223544c10ab820d56" :answer/id #uuid "15141def-f6ab-58e6-9ea1-e7be74fd8a71" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/96817ea42e1d860db97d3ee6bca79e9a8b03a0fd413c87ebc5679f746da3166b.png" :db/ensure [:answer/validate]} {:db/id "q-119383/selection/18e1533f310c96bd58554db7473ffa23dfcf05973ae9a50a4b0a695915c89b74" :answer/id #uuid "f587d4b4-a011-5cef-9b83-486575f7f6cc" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png" :db/ensure [:answer/validate]} {:db/id "q-119383/selection/017698ece2771453696a92fc31fbe775cef8092073fcaf416b79b66ed10b05e5" :answer/id #uuid "522b40b1-df2b-51f0-a855-93f605907700" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/ac12c64fe5282c78ea926eec823cec6b66c8fad9f153c4191d39ba7751e90e25.png" :db/ensure [:answer/validate]} {:db/id "q-119383/selection" :answer-field/id #uuid "e36d4b4f-43bb-51b9-9f31-138ba6348167" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119383/selection/18e1533f310c96bd58554db7473ffa23dfcf05973ae9a50a4b0a695915c89b74" :answer-field/choices ["q-119383/selection/05d2850124209bd01f83b226d2693c67c8f3aff1fae8592e1141fa62301b55f9" "q-119383/selection/10a379d787175b630822035f4196bd41fe904f371f15086a3bcc7a245b7bc5bc" "q-119383/selection/5679b1228afaac74c6da06c58677b711adc79342f38cb1b223544c10ab820d56" "q-119383/selection/18e1533f310c96bd58554db7473ffa23dfcf05973ae9a50a4b0a695915c89b74" "q-119383/selection/017698ece2771453696a92fc31fbe775cef8092073fcaf416b79b66ed10b05e5"] :db/ensure [:answer-field/validate]} {:db/id "q-119383" :question/id #uuid "d1772040-8608-5c67-8243-2a903b40e108" :question/math-academy-id "q-119383" :question/problem "Given that $f(x,y)$ varies with both $x$ and $y,$ which of the following **cannot** be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(x,y)?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope field varies with both $x$ and $y.$\n\nOf the given slope fields, we note the following slope field does not vary with $x$ given a fixed value of $y.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png)\n\n \n\nTo see this more clearly, notice that if we draw a horizontal line, the slopes do not vary.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9d256bd6c44a9abc8489c360722b5c5e8243f0d4a9aa6fee03cad52e5334b385.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-119383/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a2334101-5266-5853-aedf-04c85746b5cc"] :knowledge-point/questions ["q-119383"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-96476"] :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=xy?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/a324b98fc4ec7a38ce6276a357a649751b316c0e61ddb193ce5f34caed608e98.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9d60c65cda12bb6ac800906e7889a8ecc395974dff0379130d647810c1623869.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8505"] :question/problem "For the differential equation\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = 2x^2-y,\n$$\n\nplot the slope field at the points $(1,1),$ $(0,1),$ and $(1,2).$" :question/worked-solution "We have to sketch the slope field at the points $(1,1),$ $(0,1),$ and $(1,2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)} & =2(1)^{2}-1=1 \\\\ {\\frac{\\text{d}y}{\\text{d}x}|}_{(0,1)} & =2(0)^{2}-1=-1 \\\\ {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,2)} & =2(1)^{2}-2=0\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/0c06b4acee1445fea91bcbb7bed5a837a1dd494c9638a4f8945f5ac8dc226c22.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8506"] :question/problem "Consider the differential equation $\\dfrac{\\textrm{d}y}{\\textrm{d}x} = -2xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the second quadrant, the slope of the slope field is negative\n\n- At every point in the third quadrant, the slope of the slope field is negative\n\n- At every point in the fourth quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y) = -2xy.$ Then, our differential equation is $\\dfrac{\\textrm dy}{\\textrm d x} = f(x,y).$ \n\nNotice that $f(x,y) = 0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in the second quadrant.\n\n- Statement II is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} = f(x,y)  \\lt     0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x, y)$ in the third quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} = f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in the fourth quadrant.\n\nTherefore, the correct answer is \"II and III only.\"" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8576"] :question/problem "Consider the differential equation $\\dfrac{\\textrm{d}y}{\\textrm{d}x}=(x+1)(y+1)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x \\gt -1$ and $y \\gt -1,$ the slope of the slope field is positive\n\n- At every point $(x,y)$ where $x \\lt -1$ and $y \\lt -1,$ the slope of the slope field is positive\n\n- At every point $(x,y)$ where $x \\gt -1$ and $y \\lt -1,$ the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y) = (x+1)(y+1).$ Then, our differential equation is $\\dfrac{\\textrm dy}{\\textrm d x} = f(x,y).$ \n\nNotice that $f(x,y) = 0$ when $x = -1$ or $y = -1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e7b398c7ff971e39b15980078232556d23866ab2f65a05b7d8df9a5f67b797dc.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/943ed7c12c71438d567da5ec901435bae1d3c7e576ba9b6c933d9fddc4e42b8f.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x \\gt -1$ and $y \\gt -1,$ then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in this region.\n\n- Statement II is true. If $x \\lt -1$ and $y \\lt -1,$ then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\gt     0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x, y)$ in this region.\n\n- Statement III is true. If $x \\gt -1$ and $y \\lt -1,$ then according to our diagram, we have\n\n$$\n\\left.\\dfrac{\\textrm d y}{\\textrm d x} \\right|_{(x,y)} =f(x,y)  \\lt     0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x, y)$ in this region.\n\nTherefore, the correct answer is \"I, II, and III.\"" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8507"] :question/problem "Which of the following could be the slope field for the differential equation $\\dfrac{\\textrm d y}{\\textrm d x} = x+y?$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3bd19865d2a1bb6bbb40c57112f269b51a3740d01da2c80b81db4eb84c6766f1.png)" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\dfrac{\\textrm d y}{\\textrm d x} = f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/543bb98ff948d1186e05d84db7992f9d5033ba4eaf47a9787b6b5664b88510a2.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/433f0cf3835465e7a0cca195f8b0f0b280984200d84f49533219f08967adc497.png)" :db/ensure [:question/validate]}]
