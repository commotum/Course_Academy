.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/5e6b2df4680cea04cda42312659c76ba713a025150ebcc547dddc2a6501aebf3.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119674/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5"] :knowledge-point/questions ["q-119674"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96089/selection/5574d63551054080a1ba11b2838208991719cb1d5a1a3db36e44674962b5668c" :answer/id #uuid "a0dc2983-6298-533f-b556-bfa8493fe7ef" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/bfd9789a91f680d5105d9081e51103ffba5e986fa4a96331cde06df6d0c42854.png" :db/ensure [:answer/validate]} {:db/id "q-96089/selection/9aa52204b554688db215403ef232c240c3dc4fb6696199357f2240a8a1e31013" :answer/id #uuid "1d4dec99-0602-5cd5-a37e-9582b8d81e57" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/543365359599203eb6f9e8824f6e3b2987a1fec9121568dd7a9098bfc16870f1.png" :db/ensure [:answer/validate]} {:db/id "q-96089/selection/391fa5377c2c0788ca12ae96a528a91655fa4cb3a88edf9a61d1845cb403b3da" :answer/id #uuid "6c3f0144-5323-51e0-bf06-a958a1fda69c" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/7670c9662fec950b45f2f939ed416590d278875b168caea9d7e5b70f7c8c6a9f.png" :db/ensure [:answer/validate]} {:db/id "q-96089/selection/6ba0aa477e9b293c6d3ef964f9aa90a97f73a91eb1bb6eda50b89f084fe34640" :answer/id #uuid "54acd6e4-e0a4-576e-ae22-bdb394baefb5" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/1404488