stion-capture-workers/differential/14044888/assets/7d5df9fe81ebd1e656eefc97380ae646a1a4f64de51e4745bc31d822e022d65d.png" :db/id #edb/ref 17592186324477} :answer-field/id #uuid "ed99fb39-e5b3-5907-a760-b61c49a19b64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324476}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5ca31a32-1c1a-5bad-882d-872d4b1f5188" :question/math-academy-id "q-119372" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{xy}?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/7d5df9fe81ebd1e656eefc97380ae646a1a4f64de51e4745bc31d822e022d65d.png)\n\n  \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/d05d98b24783511dc6ff7518141e49d9cfefe96565f16b9d11b30d0e6fc0a5a4.png)"}] [{:db/id #edb/ref 17592186324482 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2334101-5266-5853-aedf-04c85746b5cc" :knowledge-point/title "Identifying a Possible Slope Field Based on the Type of Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "522b40b1-df2b-51f0-a855-93f605907700" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/ac12c64fe5282c78ea926eec823cec6b66c8fad9f153c4191d39ba7751e90e25.png" :db/id #edb/ref 17592186324484} {:answer/id #uuid "16c46ae3-7c85-5e04-8d9b-847d98efed69" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/c959785ef067b41eba5e5ca5f0759acdd81c9f613c92854ba5937be6bced2c86.png" :db/id #edb/ref 17592186324485} {:answer/id #uuid "5d88b7b6-f8e5-5336-be0b-fde47a0f6ad9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/fe57c0cc2d75729921eb46408e0e4a6932eba06c00034f2ec4c579c8c5627376.png" :db/id #edb/ref 17592186324486} {:answer/id #uuid "f587d4b4-a011-5cef-9b83-486575f7f6cc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png" :db/id #edb/ref 17592186324487} {:answer/id #uuid "15141def-f6ab-58e6-9ea1-e7be74fd8a71" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/96817ea42e1d860db97d3ee6bca79e9a8b03a0fd413c87ebc5679f746da3166b.png" :db/id #edb/ref 17592186324488}] :answer-field/correct {:answer/id #uuid "f587d4b4-a011-5cef-9b83-486575f7f6cc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png" :db/id #edb/ref 17592186324487} :answer-field/id #uuid "e36d4b4f-43bb-51b9-9f31-138ba6348167" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324483}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d1772040-8608-5c67-8243-2a903b40e108" :question/math-academy-id "q-119383" :question/problem "Given that $f(x,y)$ varies with both $x$ and $y,$ which of the following **cannot** be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(x,y)?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope field varies with both $x$ and $y.$\n\nOf the given slope fields, we note the following slope field does not vary with $x$ given a fixed value of $y.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9cb42cde56fcbea0c489742cab1448890728dab584395129b21794115b1e1298.png)\n\n \n\nTo see this more clearly, notice that if we draw a horizontal line, the slopes do not vary.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9d256bd6c44a9abc8489c360722b5c5e8243f0d4a9aa6fee03cad52e5334b385.png)"}] [{:db/id #edb/ref 17592186324489 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5" :knowledge-point/title "Sketching the Slope Field of a Differential Equation at Some Isolated Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d1fc060-2b67-5f50-9bff-a1dc120e2f76" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/d48911eaffd88e249ef115a5511bff979ffa0f848ef8a1e8556db07ad273e41a.png" :db/id #edb/ref 17592186324491} {:answer/id #uuid "6c51bc5f-4a86-5a11-97cc-238d366b7d11" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/5e6b2df4680cea04cda42312659c76ba713a025150ebcc547dddc2a6501aebf3.png" :db/id #edb/ref 17592186324492} {:answer/id #uuid "1cbf9240-79aa-5034-bc20-640be147b835" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/a0f75b52c741eca3322f4fe61009ba3c65e573f588edf9d3785019a1227f9769.png" :db/id #edb/ref 17592186324493} {:answer/id #uuid "eef5024a-78a8-554e-b551-be382194ab74" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/4afe9527d6ff39ce7f5325a4a35ce5095d9bf0b1beb2fcde4de86a977bdac9e8.png" :db/id #edb/ref 17592186324494} {:answer/id #uuid "86b66809-84ea-55f0-b1a9-b56df4bd97f5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/c78c6d760cffb3dfb95233f9fc21dfea5a951371b056827885d1aa35469a458c.png" :db/id #edb/ref 17592186324495}] :answer-field/correct {:answer/id #uuid "6c51bc5f-4a86-5a11-97cc-238d366b7d11" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/5e6b2df4680cea04cda42312659c76ba713a025150ebcc547dddc2a6501aebf3.png" :db/id #edb/ref 17592186324492} :answer-field/id #uuid "a1fef5ae-62dd-5135-82ed-1d4341fba671" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324490}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6fa5ee8e-9f67-5df0-bf90-49308c053565" :question/math-academy-id "q-119674" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-\\frac{{y}^{2}}{x}?$" :question/worked-solution "We have to sketch the slope field at the points $(-1,-2),(2,-2)$ and $(2,2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-2)}=-\\frac{(-2)^{2}}{(-1)}=4, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,-2)}=-\\frac{(-2)^{2}}{2}=-2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,2)}=-\\frac{{2}^{2}}{2}=-2.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/5e6b2df4680cea04cda42312659c76ba713a025150ebcc547dddc2a6501aebf3.png)"}] [{:db/id #edb/ref 17592186324496 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b83e57d-9a69-5959-b220-d0d8155684be" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186324498} {:answer/id #uuid "6287a386-f422-5c2d-b40c-e1447f79bbdd" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324499} {:answer/id #uuid "b89fe567-fefa-5be0-938e-fc3953ff41c2" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324500} {:answer/id #uuid "cf1d1082-7860-54a4-8bdd-a23e6d2a98e6" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324501} {:answer/id #uuid "a8b11a80-d54c-5c20-8ca1-0d5a85923fea" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324502}] :answer-field/correct {:answer/id #uuid "8b83e57d-9a69-5959-b220-d0d8155684be" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186324498} :answer-field/id #uuid "3e44d7e6-fbc8-5549-aeaa-5839f4bffd01" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324497}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "02428a19-79c0-54a0-bd59-933e59271090" :question/math-academy-id "q-119766" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=6xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the second quadrant, the slope of the slope field is negative\n- At every point in the third quadrant, the slope of the slope field is positive\n- At every point in the fourth quadrant, the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=6xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement II is true. If $(x,y)$ is in the third quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the third quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186324503 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b003e80-650e-5a96-863c-187e130a982f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324505} {:answer/id #uuid "0aa231d0-b201-55b9-99d5-595cf3ae5262" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186324506} {:answer/id #uuid "3c50c7a8-f19c-5603-abf0-0800c3ba5b2d" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324507} {:answer/id #uuid "0cdaef1e-ecba-55ec-94b1-0af278746d83" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186324508} {:answer/id #uuid "e86856bc-893c-51f6-b142-158d5018acb0" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324509}] :answer-field/correct {:answer/id #uuid "0aa231d0-b201-55b9-99d5-595cf3ae5262" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186324506} :answer-field/id #uuid "06c74166-797e-51e1-8ab6-8b9bfa7f2935" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324504}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "686d59ed-d90f-5bf3-b657-f82ebc498b64" :question/math-academy-id "q-119769" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-5xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is positive\n- At every point in the second quadrant, the slope of the slope field is negative\n- At every point in the fourth quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=-5xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement II is false. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186324510 :knowledge-point/_questions [{:knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d8b7c89-51ff-52b0-a9ae-f899df6b2cf2" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186324512} {:answer/id #uuid "97aeebcf-69eb-5843-8528-e1509c33e80f" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324513} {:answer/id #uuid "cfd6a72a-c6f5-5445-b37b-a262046aa130" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324514} {:answer/id #uuid "4bc7131d-24d1-5376-b9a9-b6429500c1c7" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324515} {:answer/id #uuid "be16bd2c-17ad-559c-b6c8-11f54ab7412a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324516}] :answer-field/correct {:answer/id #uuid "2d8b7c89-51ff-52b0-a9ae-f899df6b2cf2" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186324512} :answer-field/id #uuid "baea9539-85ef-5cfd-aa31-a54f312f1da3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324511}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3abc4afa-25ba-5703-a666-45b550ee045a" :question/math-academy-id "q-119797" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(2-x)(y+1)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x>2$ and $y<-1,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<2$ and $y<-1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x<2$ and $y>-1,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(2-x)(y+1).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=2$ or $y=-1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/caa61190f1a5565c58838556529715c08f9f00402c6f4b3ccb99a914e748f198.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/01e91ecf01cfc64ed87e29081a6b9f8a3fc5afade1b25be08039b8778d981cf7.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x>2$ and $y<-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is true. If $x<2$ and $y<-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x<2$ and $y>-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186324517 :knowledge-point/_questions [{:knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f4dcfe4-7ec8-5a3b-826f-fc466b7ad717" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324519} {:answer/id #uuid "accbf007-9725-5fc7-ba2c-f6686120129f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186324520} {:answer/id #uuid "c2d3f3bc-8b00-52e8-bb1c-440ea958e9d0" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324521} {:answer/id #uuid "2fa97764-34fd-54c1-84ba-f4ced55fa470" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186324522} {:answer/id #uuid "de1ea38f-e71a-534b-9d98-d521afdb83d9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324523}] :answer-field/correct {:answer/id #uuid "2fa97764-34fd-54c1-84ba-f4ced55fa470" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186324522} :answer-field/id #uuid "022ab180-dbe3-585a-a6ec-ca5497bc5a3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324518}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7d5a91f8-7975-56de-b46e-33d895988c53" :question/math-academy-id "q-119800" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(1-x)(y-2)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<1$ and $y>2,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>1$ and $y<2,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x<1$ and $y<2,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(1-x)(y-2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=1$ or $y=2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/47784a3201e93648e495827b12078073cc9f1a03cd3c11904a875bad10a3bde2.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/73631c178777b4489e35fa87d08474ccf2b8b484b9bf5fe7272b1ce25d45f1b0.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $x<1$ and $y>2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is false. If $x>1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement III is false. If $x<1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\nTherefore, the correct answer is \"None of those listed.\""}] [{:db/id #edb/ref 17592186324524 :knowledge-point/_questions [{:knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d2d8b810-ee16-55d2-9b9b-c421ab2ac297" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324526} {:answer/id #uuid "320cc140-04b0-5fee-90bc-6f47239c594f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186324527} {:answer/id #uuid "b7ceeaa6-8909-50bd-8e0b-b66b881cfcc9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324528} {:answer/id #uuid "cff34d04-2bef-5503-83a8-9e00ad0e5fda" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324529} {:answer/id #uuid "609d26fc-8f06-5de3-832f-9b0a0729c0b6" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324530}] :answer-field/correct {:answer/id #uuid "d2d8b810-ee16-55d2-9b9b-c421ab2ac297" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324526} :answer-field/id #uuid "da5d8795-39a4-5f85-b829-b6ff9dfe89bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324525}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a59de227-7569-5036-a40a-476b213ce2eb" :question/math-academy-id "q-119816" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x-2)^{2}(y+1)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<2$ and $y>-1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x<2$ and $y<-1,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>2$ and $y>-1,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(x-2)^{2}(y+1).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=2$ or $y=-1.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/caa61190f1a5565c58838556529715c08f9f00402c6f4b3ccb99a914e748f198.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/d836463631120853e05b3b5fb9e534822cf5611747a3eb17e22333901bfb8fd3.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $x<2$ and $y>-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is true. If $x<2$ and $y<-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x>2$ and $y>-1,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\nTherefore, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186324531 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5" :knowledge-point/title "Sketching the Slope Field of a Differential Equation at Some Isolated Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "448e3e3d-ce66-5a02-807a-7108d2818dac" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9bba5f86445177b9124813e85bf9294b7b566a029686f163c685663f5b352e30.png" :db/id #edb/ref 17592186324533} {:answer/id #uuid "6b31b9ad-f462-579a-a739-1c34804cf0a9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png" :db/id #edb/ref 17592186324534} {:answer/id #uuid "04ee7a9a-7b10-5229-bba9-9cf7a67611b8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/7a550e346a2b31e09ec2dbfcf8eefe9a80108a74edffa92cb3a617643a810e31.png" :db/id #edb/ref 17592186324535} {:answer/id #uuid "b4ab4ccb-8e79-5e14-82d4-52403ecd2545" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/a87973b958bd7a598da127164fd77365daaf121a601c25d198f1a3256bd84f6d.png" :db/id #edb/ref 17592186324536} {:answer/id #uuid "e38f6125-ad60-5938-b28e-d9b952efc4ec" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e5b20b6b0ae17ca9ee891ec33efa93fd23f684e938b1527e56db01f11a2e53d8.png" :db/id #edb/ref 17592186324537}] :answer-field/correct {:answer/id #uuid "6b31b9ad-f462-579a-a739-1c34804cf0a9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png" :db/id #edb/ref 17592186324534} :answer-field/id #uuid "a214396c-2389-5681-800a-aa66ebb1a006" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324532}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bc230845-92ae-5b4b-bdb5-703586364780" :question/math-academy-id "q-49811" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2{x}^{2}-\\frac{1}{2}{y}^{2}?$" :question/worked-solution "We have to sketch the slope field at the points $(1,2),(1,0),$ and $(-1,-2).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,2)}=2(1)^{2}-\\frac{1}{2}(2)^{2}=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,0)}=2(1)^{2}-\\frac{1}{2}(0)^{2}=2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,-2)}=2(-1)^{2}-\\frac{1}{2}(-2)^{2}=0.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3dcb95f44f53f046c543d281038c0ac03fb14357cecdb7b96d5f41d33e9b0ed6.png)"}] [{:db/id #edb/ref 17592186324538 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5" :knowledge-point/title "Sketching the Slope Field of a Differential Equation at Some Isolated Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fd5f329e-3276-5e7d-929b-08b10ee19280" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/2527ad3b4f6d0a1d84a9e907b5e3e9bddee439fbd17c2a1a4c3ca8c418f65293.png" :db/id #edb/ref 17592186324540} {:answer/id #uuid "e9c73b29-7c30-5a73-9a94-ddf71a0f9486" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/1b8e42e667d2fe4c713e92f879c9894e826fdbe3e6928addb3c4b36ce71991e0.png" :db/id #edb/ref 17592186324541} {:answer/id #uuid "9e6d8335-509a-5346-b0a7-7db4e2af08ab" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3ddcc5784dc1fd60ba3c95ecda373678d00fc6c45e6b5e5655febcc130c37d95.png" :db/id #edb/ref 17592186324542} {:answer/id #uuid "cf1909e1-91af-5de0-b3f4-2e07b75192fc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/327d6ae536cd6d76eff01387b51a4d2cc0522559d6ec6d02e3a86c2a3977f7b2.png" :db/id #edb/ref 17592186324543} {:answer/id #uuid "17de6847-5e71-5f02-b67a-9978b2a76c2c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e7e267508d68c1d4eeb31509a4a2957e120cecab920481ba6dc2b0fa1f84433b.png" :db/id #edb/ref 17592186324544}] :answer-field/correct {:answer/id #uuid "9e6d8335-509a-5346-b0a7-7db4e2af08ab" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3ddcc5784dc1fd60ba3c95ecda373678d00fc6c45e6b5e5655febcc130c37d95.png" :db/id #edb/ref 17592186324542} :answer-field/id #uuid "f33a7a68-bb66-508e-803b-74715aa02d6a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324539}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "be176ed2-61aa-5d12-9259-7d0a7e6c43ee" :question/math-academy-id "q-80497" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=x-2y?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,-1),(2,-1),$ and $(2,1).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation. \n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,-1)}=(-2)-2(-1)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,-1)}=(2)-2(-1)=4, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,1)}=(2)-2(1)=0.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/6a2d6f3812df2844171dacf1675d8e3d90167010cb2ffcf939f88d9cfcafe8a9.png)"}] [{:db/id #edb/ref 17592186324545 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5" :knowledge-point/title "Sketching the Slope Field of a Differential Equation at Some Isolated Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9868f28-de0e-5239-8da3-af4d3175b86b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/8255d8370e49983ff0e37b5068a8a997de5eeadaedf7bd7869cf5dcd3c826ca1.png" :db/id #edb/ref 17592186324547} {:answer/id #uuid "4cccb285-81ea-525d-8139-55f6f09740a7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/5b77994fcd8b675c439a37e1b2049c0c6d266f12b3dc298b3183133b9010c818.png" :db/id #edb/ref 17592186324548} {:answer/id #uuid "ba35b4c9-28e4-50f2-acc6-caa219327178" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/c4f19e6b424610387a8973b037c3f4636c09dba441ab1d6bd36dbe103d779a88.png" :db/id #edb/ref 17592186324549} {:answer/id #uuid "161738d1-4ee8-5b24-9717-d7acb367e108" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/770f3089576cabd68f3c80b597eb4f15df279538c49853526b0ea123bc75af08.png" :db/id #edb/ref 17592186324550} {:answer/id #uuid "b0e7ab6b-46dd-5f70-8278-f2c308e4e503" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e1ca6081e8077bcbc54de6a71e10ef1d278bbbc6b99842f1eee0d3dfcb71ebda.png" :db/id #edb/ref 17592186324551}] :answer-field/correct {:answer/id #uuid "b0e7ab6b-46dd-5f70-8278-f2c308e4e503" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e1ca6081e8077bcbc54de6a71e10ef1d278bbbc6b99842f1eee0d3dfcb71ebda.png" :db/id #edb/ref 17592186324551} :answer-field/id #uuid "b3cd17a1-2a2a-52f2-91a6-65ee28d036f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324546}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a02659d4-1cf7-5679-b691-6c43c4b6a900" :question/math-academy-id "q-80499" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{x+2y}{4}?$" :question/worked-solution "We have to sketch the slope field at the points $(4,-2),(2,1),$ and $(-1,3).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(4,-2)}=\\frac{4+2(-2)}{4}=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,1)}=\\frac{2+2(1)}{4}=1, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,3)}=\\frac{-1+2(3)}{4}=\\frac{5}{4}.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e1ca6081e8077bcbc54de6a71e10ef1d278bbbc6b99842f1eee0d3dfcb71ebda.png)"}] [{:db/id #edb/ref 17592186324552 :knowledge-point/_questions [{:knowledge-point/id #uuid "b0e7e0a0-9388-5346-ab96-f2dec237c9f5" :knowledge-point/title "Sketching the Slope Field of a Differential Equation at Some Isolated Points"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c3f0144-5323-51e0-bf06-a958a1fda69c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/7670c9662fec950b45f2f939ed416590d278875b168caea9d7e5b70f7c8c6a9f.png" :db/id #edb/ref 17592186324554} {:answer/id #uuid "a0dc2983-6298-533f-b556-bfa8493fe7ef" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/bfd9789a91f680d5105d9081e51103ffba5e986fa4a96331cde06df6d0c42854.png" :db/id #edb/ref 17592186324555} {:answer/id #uuid "54acd6e4-e0a4-576e-ae22-bdb394baefb5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/631f9d7772354c6962f98e857371eac65d0fe36116bbae60dacd0db7ba01bc04.png" :db/id #edb/ref 17592186324556} {:answer/id #uuid "c94a90c5-b415-5b4d-94e2-28d5f920132b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/3edf063230f100455638fa25f28a4c5e59e2e54884d9e273724b76ae483aa0bc.png" :db/id #edb/ref 17592186324557} {:answer/id #uuid "1d4dec99-0602-5cd5-a37e-9582b8d81e57" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/543365359599203eb6f9e8824f6e3b2987a1fec9121568dd7a9098bfc16870f1.png" :db/id #edb/ref 17592186324558}] :answer-field/correct {:answer/id #uuid "1d4dec99-0602-5cd5-a37e-9582b8d81e57" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/543365359599203eb6f9e8824f6e3b2987a1fec9121568dd7a9098bfc16870f1.png" :db/id #edb/ref 17592186324558} :answer-field/id #uuid "a9b707c9-e47c-5add-a169-f6eccbcdc564" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324553}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "53548ea4-2b92-5da8-9bc4-e7dc116ebef9" :question/math-academy-id "q-96089" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=x+2y?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,1),(1,1),$ and $(2,1).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,1)}=-2+2(1)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)}=1+2(1)=3, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,1)}=2+2(1)=4.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following diagram.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/cc55a08f71cd75f0dda356149a61e9ab78536ecbb4644b88f840122863b92b88.png)"}] [{:db/id #edb/ref 17592186172566 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2334101-5266-5853-aedf-04c85746b5cc" :knowledge-point/title "Identifying a Possible Slope Field Based on the Type of Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be637cc9-7c15-5846-9b5a-59cd2ded00d7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3352/Source/Images/q-96476-a-4.png" :db/id #edb/ref 17592186171362} {:answer/id #uuid "ed726290-ceb5-5726-8afe-1ea17d16e266" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3352/Source/Images/q-96476-a-1.png" :db/id #edb/ref 17592186171363} {:answer/id #uuid "0fc44594-a71f-5b20-b57b-18092760bac8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3352/Source/Images/q-96476-a-3.png" :db/id #edb/ref 17592186171364} {:answer/id #uuid "1eb644ed-508e-5f2e-8fad-99f9b98ae7d4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3352/Source/Images/q-96476-a-5.png" :db/id #edb/ref 17592186171365} {:answer/id #uuid "5bfe2168-b575-5e41-9930-a21f9258cef8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3352/Source/Images/q-96476-a-2.png" :db/id #edb/ref 17592186171366}] :answer-field/correct {:answer/id #uuid "ed726290-ceb5-5726-8afe-1ea17d16e266" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3352/Source/Images/q-96476-a-1.png" :db/id #edb/ref 17592186171363} :answer-field/id #uuid "cb4db775-85f9-5606-9329-b88efd180f72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171361}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8e4e2c73-61a2-51eb-9aeb-b173fc18ef10" :question/math-academy-id "q-96476" :question/problem "Which of the following could be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=xy?$" :question/requires-calculator false :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope varies with both $x$ and $y.$\n\nOf the given slope fields, the only one that varies with both $x$ and $y$ is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/a324b98fc4ec7a38ce6276a357a649751b316c0e61ddb193ce5f34caed608e98.png)\n\n \n\nTo see this more clearly, notice that if we draw a vertical line and a horizontal line, the slopes vary if we move along either of the two lines.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/9d60c65cda12bb6ac800906e7889a8ecc395974dff0379130d647810c1623869.png)"}] [{:db/id #edb/ref 17592186324559 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5e82298-1404-5124-852f-cdaed09f250d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324561} {:answer/id #uuid "c6be1802-65aa-564a-9b3a-099c23b2398b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324562} {:answer/id #uuid "ec25e4e6-2778-52d3-94e0-cb4de63c8b17" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186324563} {:answer/id #uuid "e2825df1-2696-5fa6-9073-c454074ad8d7" :answer/type {:db/ident :answer.type/text} :answer/value "None of those listed" :db/id #edb/ref 17592186324564} {:answer/id #uuid "90663044-8663-5cc1-a6b9-27621fb7e245" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324565}] :answer-field/correct {:answer/id #uuid "90663044-8663-5cc1-a6b9-27621fb7e245" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324565} :answer-field/id #uuid "f4099eba-f208-5df9-84e3-d9718331e137" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324560}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "69d9aef9-325a-5644-bfec-8ec831c2020d" :question/math-academy-id "q-97477" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is positive\n- At every point in the second quadrant, the slope of the slope field is positive\n- At every point in the fourth quadrant, the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=-xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/2c218c7df2bf4e159b4bffaccb4296beab8e3f44ab82d56b3589050af92ccf8e.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement II is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement III is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the fourth quadrant."}] [{:db/id #edb/ref 17592186324566 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "21b8a7ee-f836-59dc-beba-66b8fb1adf1c" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324568} {:answer/id #uuid "fad19dfe-307a-5d61-8c24-9f539ccf710e" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186324569} {:answer/id #uuid "118904e6-b7a6-5b56-a978-63740c93ec1f" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324570} {:answer/id #uuid "6ca9ac4b-05ec-58f5-b491-cb21959da3e5" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186324571} {:answer/id #uuid "cc9e58d7-6d4c-5ab9-a11d-555e57ec8fb9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324572}] :answer-field/correct {:answer/id #uuid "cc9e58d7-6d4c-5ab9-a11d-555e57ec8fb9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324572} :answer-field/id #uuid "eeebcd87-2d1b-5826-ba9a-116dbe1b768c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324567}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d8725af0-96f6-534d-ac16-7589cb968544" :question/math-academy-id "q-97482" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=9xy$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is negative\n- At every point in the second quadrant, the slope of the slope field is negative\n- At every point in the fourth quadrant, the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=9xy.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/6ef852c9c15dc6f591119906abe479949f929edb6dc26f21588b4de545d02da2.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is false. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the first quadrant.\n\n- Statement II is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the second quadrant.\n\n- Statement III is false. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the fourth quadrant."}] [{:db/id #edb/ref 17592186324573 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd092f29-08bf-5425-88a4-8cba4f0a31c8" :knowledge-point/title "Identifying Quadrants Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f9ac6b4-1eb7-5953-b69f-e0bab75c2bc4" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186324575} {:answer/id #uuid "8db20139-ef29-523c-a82a-f9d854047d68" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324576} {:answer/id #uuid "21c900e3-5727-5d2a-a848-ee7f02b4ccb7" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324577} {:answer/id #uuid "499565f9-007d-5936-bd34-710fa288127a" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186324578} {:answer/id #uuid "64dd550e-4a4a-518b-a8d6-c2fed808d822" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324579}] :answer-field/correct {:answer/id #uuid "3f9ac6b4-1eb7-5953-b69f-e0bab75c2bc4" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186324575} :answer-field/id #uuid "98c30d2d-b036-5c2d-8a6e-4fbcd0750f04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324574}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "2bd68dbe-3df6-5a5a-89ed-3e22835c94e7" :question/math-academy-id "q-97487" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-4x{y}^{2}$ and its slope field. Which of the following statements are true?\n\n- At every point in the first quadrant, the slope of the slope field is negative\n- At every point in the second quadrant, the slope of the slope field is positive\n- At every point in the fourth quadrant, the slope of the slope field is negative" :question/worked-solution "First, we define $f(x,y)=-4x{y}^{2}.$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=0$ or $y=0.$ The lines $x=0$ and $y=0$ divide the plane into the usual four quadrants.\n\nIf we compute the sign of $f(x,y)$ in each quadrant (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/96c937cf10d45d8870a4a56e257d184dcf2e4caf11312c05df9f385f9c5ee7a8.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $(x,y)$ is in the first quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the first quadrant.\n\n- Statement II is true. If $(x,y)$ is in the second quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in the second quadrant.\n\n- Statement III is true. If $(x,y)$ is in the fourth quadrant, then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in the fourth quadrant."}] [{:db/id #edb/ref 17592186324580 :knowledge-point/_questions [{:knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "770864f4-c3d3-5d88-96b5-131ce1bec3a0" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186324582} {:answer/id #uuid "b7265f38-606f-596e-9c26-128f305fcd84" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186324583} {:answer/id #uuid "8b65d57c-7041-5c39-86b4-11038518e3c4" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186324584} {:answer/id #uuid "b04163d6-827b-59c5-a05e-d100ca89fa6a" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186324585} {:answer/id #uuid "c094514f-64b7-5499-9fb1-c2f85d3a561a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186324586}] :answer-field/correct {:answer/id #uuid "b7265f38-606f-596e-9c26-128f305fcd84" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186324583} :answer-field/id #uuid "2bdd2a90-88c4-544c-b468-eb943fd08ab9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324581}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4235049c-7cc2-5176-8c56-91624ea6b2f2" :question/math-academy-id "q-97495" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x+2)(y+2)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x>-2$ and $y>-2,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<-2$ and $y>-2,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<-2$ and $y<-2,$ the slope of the slope field is positive" :question/worked-solution "First, we define $f(x,y)=(x+2)(y+2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=-2$ or $y=-2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/7d225d82eee3043380eda76506b28e81aee06d42a232348b91b0d5ceb04f3318.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/bd9eedd3b8d82415e8f3126236f2e3a3b4e326a7072057bbd21406da92a08139.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x>-2$ and $y>-2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is false. If $x<-2$ and $y>-2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x<-2$ and $y<-2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region."}] [{:db/id #edb/ref 17592186172575 :knowledge-point/_questions [{:knowledge-point/id #uuid "75710e99-e13c-54ba-9401-486bfec15284" :knowledge-point/title "Identifying Rectangular Regions Where a Slope Field Is Positive or Negative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5267c89-53ba-5bbe-ac45-899450d8b526" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186171416} {:answer/id #uuid "f0286959-2694-5759-911d-288e8aa46c26" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186171417} {:answer/id #uuid "04f6f24d-b532-52ec-839a-51883f2f7753" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186171418} {:answer/id #uuid "182bdb06-70d7-5c74-8f7f-5b9dea9bf2e2" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171419} {:answer/id #uuid "43d27ff6-1df6-5e1f-ab4f-006dbaee7b73" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186171420}] :answer-field/correct {:answer/id #uuid "f0286959-2694-5759-911d-288e8aa46c26" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186171417} :answer-field/id #uuid "42a8a9fd-a206-571b-8ba0-8140f258b4d0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171415}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e86fafab-049b-51e4-93da-aada8761c377" :question/math-academy-id "q-97538" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=(x+1)^{2}(y-2)$ and its slope field. Which of the following statements are true?\n\n- At every point $(x,y)$ where $x<-1$ and $y>2,$ the slope of the slope field is positive\n- At every point $(x,y)$ where $x<-1$ and $y<2,$ the slope of the slope field is negative\n- At every point $(x,y)$ where $x>-1$ and $y<2,$ the slope of the slope field is negative" :question/requires-calculator false :question/worked-solution "First, we define $f(x,y)=(x+1)^{2}(y-2).$ Then, our differential equation is $\\frac{\\text{d}y}{\\text{d}x}=f(x,y).$ \n\nNotice that $f(x,y)=0$ when $x=-1$ or $y=2.$ This divides the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/1f4b1b2ca736fb83eff0a4b85a3f479bf99b3b337492d0a77abe739038ed141f.png)\n\nIf we compute the sign of $f(x,y)$ in each of those four regions (by considering some test points, for example), we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/fdafadd1631a75c2998aaed5c6bad62a3ea1dcc0ac57d245a00d167e74aa3bb4.png)\n\nWith that in mind, let's check each statement:\n\n- Statement I is true. If $x<-1$ and $y>2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)>0.\n$$\n\nThis implies that the slope of the slope field is positive for any point $(x,y)$ in this region.\n\n- Statement II is true. If $x<-1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region.\n\n- Statement III is true. If $x>-1$ and $y<2,$ then according to our diagram, we have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,y)}=f(x,y)<0.\n$$\n\nThis implies that the slope of the slope field is negative for any point $(x,y)$ in this region."}] [{:db/id #edb/ref 17592186324587 :knowledge-point/_questions [{:knowledge-point/id #uuid "a2334101-5266-5853-aedf-04c85746b5cc" :knowledge-point/title "Identifying a Possible Slope Field Based on the Type of Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4438b094-9cee-5477-b04c-9ec37ed9b311" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/ae2c8de966219eb473c42fa809bfde49b52c7c88efaf83fc7ab0d602d734e722.png" :db/id #edb/ref 17592186324589} {:answer/id #uuid "b68b8662-70a5-5529-b3e2-cc51c6f2affb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/4e286da41a3a0026ff7ee55649be2f0bdf5209e407a0f6fe96b3bbffa1295fb5.png" :db/id #edb/ref 17592186324590} {:answer/id #uuid "9d5a4483-d21e-50c9-87e3-eb3faa0fb89d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/8b5ff8f702e76cb7108ae458447b38eed4d18e38336f54279f25d1c59c02e3b4.png" :db/id #edb/ref 17592186324591} {:answer/id #uuid "9c8c07c2-15e3-5a2c-a800-406a8c65d4e5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/b433458640a60ab79880fe94549be1071420948c1c809d5c43576d4aeed45510.png" :db/id #edb/ref 17592186324592} {:answer/id #uuid "a320db02-ff43-593a-965b-d0abeb3ae2f6" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/0be25701c9d678977655081af50779401b207cbcd91a4c04cb32e8740180ae45.png" :db/id #edb/ref 17592186324593}] :answer-field/correct {:answer/id #uuid "4438b094-9cee-5477-b04c-9ec37ed9b311" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/ae2c8de966219eb473c42fa809bfde49b52c7c88efaf83fc7ab0d602d734e722.png" :db/id #edb/ref 17592186324589} :answer-field/id #uuid "3f5e91d6-7b03-535a-9b7c-caad50ff324a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186324588}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "69047027-7fd9-581d-a6dd-06bc079f6f80" :question/math-academy-id "q-98233" :question/problem "Given that $f(x,y)$ varies with both $x$ and $y,$ which of the following **cannot** be the slope field for the differential equation $\\frac{\\text{d}y}{\\text{d}x}=f(x,y)?$" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x,y).\n$$\n\nThe right-hand side is a function of $x$ and $y.$ This means that the slope field varies with both $x$ and $y.$\n\nOf the given slope fields, we note the following slope field does not vary with $x$ given a fixed value of $y.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/ae2c8de966219eb473c42fa809bfde49b52c7c88efaf83fc7ab0d602d734e722.png)\n\n \n\nTo see this more clearly, notice that if we draw a horizontal line, the slopes do not vary.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14044888/assets/e243f3fb7515d9858599775ce0391f85f1de237f08380e1ec3b7403b1ecdbf53.png)"}]}
