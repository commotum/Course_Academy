\\ {A}^{2} & =3A-(-7)I \\\\ {A}^{2} & =3A+7I.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-140521/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2867571-c1ae-5ea0-b784-22f444c8db38"] :knowledge-point/questions ["q-140521"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83396/selection/9f71d2fc28e0e90ea24edbd4a38fb29206f9a6528e40c19f3805e44ad25084fe" :answer/id #uuid "ed8106da-ae0e-5950-bf39-b84557225cf4" :answer/type :answer.type/math :answer/value "-7A+17I" :db/ensure [:answer/validate]} {:db/id "q-83396/selection/9009d3d54c926de15febdab6d81e88a5fce307442803eab0da73420c60c6f36a" :answer/id #uuid "314dbd11-698b-59fc-a877-3b8b6cc12187" :answer/type :answer.type/math :answer/value "7A-17I" :db/ensure [:answer/validate]} {:db/id "q-83396/selection/0184e8ad860e8cf5c940fc6388e6539df4af3f53a9baf37c5bb62b4682593bf8" :answer/id #uuid "3c327c4a-e6c3-5406-87de-ac028fbf7d2c" :answer/type :answer.type/math :answer/value "-7A-17I" :db/ensure [:answer/validate]} {:db/id "q-83396/selection/2c423e53ce882a99d40652dd931451781344681266939860c06f69f4a8bc7642" :answer/id #uuid "f6a7b3bc-90a7-5a0a-a700-0da7c401873f" :answer/type :answer.type/math :answer/value "-17A-7I" :db/ensure [:answer/validate]} {:db/id "q-83396/selection/6aa0319aae724709b63644a2a5c1c153d204022c40403afef267f9446a05fad5" :answer/id #uuid "610b94ee-1e37-59f1-8b69-caa28545842a" :answer/type :answer.type/math :answer/value "17A+7I" :db/ensure [:answer/validate]} {:db/id "q-83396/selection" :answer-field/id #uuid "4c979d9b-fd19-50ea-a891-8dd2764138af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83396/selection/0184e8ad860e8cf5c940fc6388e6539df4af3f53a9baf37c5bb62b4682593bf8" :answer-field/choices ["q-83396/selection/9f71d2fc28e0e90ea24edbd4a38fb29206f9a6528e40c19f3805e44ad25084fe" "q-83396/selection/9009d3d54c926de15febdab6d81e88a5fce307442803eab0da73420c60c6f36a" "q-83396/selecti