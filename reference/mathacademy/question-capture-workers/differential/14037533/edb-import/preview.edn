4585 true] [17592186297084 1040 #edb/ref 17592186045449 13194139534585 true] [17592186297084 1041 "field-1" 13194139534585 true] [17592186297084 1104 #edb/ref 17592186297085 13194139534585 true] [17592186297084 1110 #uuid "5666ae7b-ae88-54f7-9bf7-f1ea2f2950fb" 13194139534585 true] [17592186297085 1034 "4803" 13194139534585 true] [17592186297085 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297085 1111 #uuid "9677a68b-ce2c-5b3a-a2fc-2e2c91a81ef8" 13194139534585 true] [17592186297086 1017 #edb/ref 17592186297087 13194139534585 true] [17592186297086 1089 "q-353189" 13194139534585 true] [17592186297086 1091 #edb/ref 17592186045463 13194139534585 true] [17592186297086 1100 "The number of insects in a controlled habitat $H(t)$ after $t$ months can be modeled by the differential equation\n\n$$\n\\frac{\\text{d}H}{\\text{d}t}=2H.\n$$\n\nIf there are currently $120$ insects in the habitat, calculate the number of insects after $2$ months. Round your answer to the nearest integer.\n\nThe number of insects after $2$ months is approximately \n{{field-1}}\ninsects." 13194139534585 true] [17592186297086 1113 #uuid "feef296b-d2d1-5b32-88ba-3108b3f1a18d" 13194139534585 true] [17592186297086 1145 "We model the number of insects using the differential equation\n\n$$\n\\frac{\\text{d}H}{\\text{d}t}=2H.\n$$\n\nThe solution to this equation is\n\n$$\nH(t)={H}_{0}\\,{e}^{2t},\n$$\n\nwhere ${H}_{0}$ is the initial value.\n\nWe're told that there are currently $120$ insects in the habitat, so we have ${H}_{0}=120.$\n\nTherefore, the number of insects $H$ at time $t$ is\n\n$$\nH(t)=120\\,{e}^{2t}.\n$$\n\nFinally, to find the number of insects when $t=2,$ we substitute $t=2$ into the above, as follows:\n\n$$\n\\begin{aligned}H(2) & =120\\,{e}^{2\\cdot 2} \\\\  & =120\\,{e}^{4} \\\\  & ≈6551.78\\end{aligned}\n$$\n\nRounding our answer to the nearest integer, we conclude that the number of insects after $2$ months is approximately $6552$ insects." 13194139534585 true] [17592186297087 1000 #edb/ref 17592186297088 13194139534585 true] [17592186297087 1040 #edb/ref 17592186045449 13194139534585 true] [17592186297087 1041 "field-1" 13194139534585 true] [17592186297087 1104 #edb/ref 17592186297088 13194139534585 true] [17592186297087 1110 #uuid "9189fc2a-319c-5b02-a1f4-4ce9a7148e01" 13194139534585 true] [17592186297088 1034 "6552" 13194139534585 true] [17592186297088 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297088 1111 #uuid "8172599c-825e-576a-8ea4-08060102d028" 13194139534585 true] [17592186297089 1017 #edb/ref 17592186297090 13194139534585 true] [17592186297089 1089 "q-353197" 13194139534585 true] [17592186297089 1091 #edb/ref 17592186045463 13194139534585 true] [17592186297089 1100 "The population of a bacterial culture $P(t)$ after $t$ hours can be modeled by the differential equation\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=-P.\n$$\n\nIf there are currently $30$ bacteria in the culture, calculate the population after $3$ hours. Round your answer to the nearest integer.\n\nThe population after $3$ hours is approximately \n{{field-1}}\nbacteria." 13194139534585 true] [17592186297089 1113 #uuid "4bd3a121-3322-5ea9-bdc3-c2499562a25c" 13194139534585 true] [17592186297089 1145 "We model the population using the differential equation\n\n$$\n\\frac{\\text{d}P}{\\text{d}t}=-P.\n$$\n\nThe solution to this equation is\n\n$$\nP(t)={P}_{0}\\,{e}^{-t},\n$$\n\nwhere ${P}_{0}$ is the initial value.\n\nWe're told that there are currently $30$ bacteria in the culture, so we have ${P}_{0}=30.$\n\nTherefore, the population $P$ at time $t$ is\n\n$$\nP(t)=30\\,{e}^{-t}.\n$$\n\nFinally, to find the population when $t=3,$ we substitute $t=3$ into the above, as follows:\n\n$$\n\\begin{aligned}P(3) & =30\\,{e}^{-1\\cdot 3} \\\\  & =30\\,{e}^{-3} \\\\  & ≈1.49\\end{aligned}\n$$\n\nRounding our answer to the nearest integer, we conclude that the population after $3$ hours is approximately $1$ bacterium." 13194139534585 true] [17592186297090 1000 #edb/ref 17592186297091 13194139534585 true] [17592186297090 1000 #edb/ref 17592186297092 13194139534585 true] [17592186297090 1040 #edb/ref 17592186045449 13194139534585 true] [17592186297090 1041 "field-1" 13194139534585 true] [17592186297090 1104 #edb/ref 17592186297092 13194139534585 true] [17592186297090 1110 #uuid "7a3bfd94-f0c9-586b-86e9-42f31a464767" 13194139534585 true] [17592186297091 1034 "2" 13194139534585 true] [17592186297091 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297091 1111 #uuid "6403680c-f1a9-5852-bc72-d5f361921597" 13194139534585 true] [17592186297092 1034 "1" 13194139534585 true] [17592186297092 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297092 1111 #uuid "6e70b314-7cb4-50fc-9cef-8081bc5c1703" 13194139534585 true] [17592186297093 1017 #edb/ref 17592186297094 13194139534585 true] [17592186297093 1089 "q-353210" 13194139534585 true] [17592186297093 1091 #edb/ref 17592186045465 13194139534585 true] [17592186297093 1100 "The number of bacteria $N=N(t)$ in a laboratory culture $t$ hours after observation can be modeled by the differential equation\n\n$$\n\\frac{\\text{d}N}{\\text{d}t}=kN\n$$\n\nwhere $k>0$ is the growth rate. If there were $500$ bacteria initially, and $N(3)=900$, calculate the value of the growth rate $k$ to the nearest percent.\n\n$k≈$\n{{field-1}}\n$%$" 13194139534585 true] [17592186297093 1113 #uuid "0c08f0b2-a661-5e5b-99bf-b3525675c872" 13194139534585 true] [17592186297093 1145 "We model the number of bacteria using the differential equation\n\n$$\n\\frac{\\text{d}N}{\\text{d}t}=kN.\n$$\n\nThe solution to this equation is\n\n$$\nN(t)={N}_{0}\\,{e}^{kt},\n$$\n\nwhere ${N}_{0}$ is the initial value.\n\nWe're told that there were $500$ bacteria initially, so we have ${N}_{0}=500.$\n\nTherefore, the number of bacteria $N$ at time $t$ is\n\n$$\nN(t)=500\\,{e}^{kt}.\n$$\n\nFinally, to find the value of $k,$ we substitute $N(3)=900$ into the equation above and solve for $k,$ as follows:\n\n$$\n\\begin{aligned}N(3) & =500\\,{e}^{k\\cdot 3} \\\\ 900 & =500\\,{e}^{3k} \\\\ {e}^{3k} & =\\frac{900}{500} \\\\ {e}^{3k} & =\\frac{9}{5} \\\\ \\operatorname{ln}⁡({e}^{3k}) & =\\operatorname{ln}⁡(\\frac{9}{5}) \\\\ 3k & =\\operatorname{ln}⁡(\\frac{9}{5}) \\\\ k & =\\frac{1}{3}\\operatorname{ln}⁡(\\frac{9}{5}) \\\\ k & ≈0.1959\\end{aligned}\n$$\n\nTherefore, $k≈20%,$ rounded to the nearest percent." 13194139534585 true] [17592186297094 1000 #edb/ref 17592186297095 13194139534585 true] [17592186297094 1040 #edb/ref 17592186045449 13194139534585 true] [17592186297094 1041 "field-1" 13194139534585 true] [17592186297094 1104 #edb/ref 17592186297095 13194139534585 true] [17592186297094 1110 #uuid "e3129585-ac30-5a70-88b4-dbe8f87c825d" 13194139534585 true] [17592186297095 1034 "20" 13194139534585 true] [17592186297095 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297095 1111 #uuid "90825270-d1f0-5c68-8f79-8569e4c0ef00" 13194139534585 true] [17592186297096 1017 #edb/ref 17592186297097 13194139534585 true] [17592186297096 1089 "q-353211" 13194139534585 true] [17592186297096 1091 #edb/ref 17592186045465 13194139534585 true] [17592186297096 1100 "The number of subscribers $S=S(t)$ to a website $t$ months after a marketing campaign can be modeled by the differential equation\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=kS\n$$\n\nwhere $k>0$ is the growth rate. If there were $12\\,000$ subscribers initially, and $S(2)=15\\,000$, calculate the value of the growth rate $k$ to the nearest percent.\n\n$k≈$\n{{field-1}}\n$%$" 13194139534585 true] [17592186297096 1113 #uuid "7761cbe4-947b-53e4-a7fb-0a91fd60ca66" 13194139534585 true] [17592186297096 1145 "We model the number of subscribers using the differential equation\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=kS.\n$$\n\nThe solution to this equation is\n\n$$\nS(t)={S}_{0}\\,{e}^{kt},\n$$\n\nwhere ${S}_{0}$ is the initial value.\n\nWe're told that there were $12\\,000$ subscribers initially, so we have ${S}_{0}=12\\,000.$\n\nTherefore, the number of subscribers $S$ at time $t$ is\n\n$$\nS(t)=12\\,000\\,{e}^{kt}.\n$$\n\nFinally, to find the value of $k,$ we substitute $S(2)=15\\,000$ into the equation above and solve for $k,$ as follows:\n\n$$\n\\begin{aligned}S(2) & =12\\,000\\,{e}^{k\\cdot 2} \\\\ 15\\,000 & =12\\,000\\,{e}^{2k} \\\\ {e}^{2k} & =\\frac{15\\,000}{12\\,000} \\\\ {e}^{2k} & =\\frac{5}{4} \\\\ \\operatorname{ln}⁡({e}^{2k}) & =\\operatorname{ln}⁡(\\frac{5}{4}) \\\\ 2k & =\\operatorname{ln}⁡(\\frac{5}{4}) \\\\ k & =\\frac{1}{2}\\operatorname{ln}⁡(\\frac{5}{4}) \\\\ k & ≈0.111\\,6\\end{aligned}\n$$\n\nTherefore, $k≈11%,$ rounded to the nearest percent." 13194139534585 true] [17592186297097 1000 #edb/ref 17592186297098 13194139534585 true] [17592186297097 1040 #edb/ref 17592186045449 13194139534585 true] [17592186297097 1041 "field-1" 13194139534585 true] [17592186297097 1104 #edb/ref 17592186297098 13194139534585 true] [17592186297097 1110 #uuid "d34997d2-ca19-5a30-9dbd-8e2edb24363b" 13194139534585 true] [17592186297098 1034 "11" 13194139534585 true] [17592186297098 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297098 1111 #uuid "491d6765-3d5b-5d12-b6d8-b4cf977d8a21" 13194139534585 true] [17592186297099 1000 #edb/ref 17592186297100 13194139534585 true] [17592186297099 1000 #edb/ref 17592186297101 13194139534585 true] [17592186297099 1000 #edb/ref 17592186297102 13194139534585 true] [17592186297099 1000 #edb/ref 17592186297103 13194139534585 true] [17592186297099 1000 #edb/ref 17592186297104 13194139534585 true] [17592186297099 1040 #edb/ref 17592186045450 13194139534585 true] [17592186297099 1041 "selection" 13194139534585 true] [17592186297099 1104 #edb/ref 17592186297103 13194139534585 true] [17592186297099 1110 #uuid "8908f557-6255-566a-9d74-9fa5f6444d55" 13194139534585 true] [17592186297100 1034 "$$355$" 13194139534585 true] [17592186297100 1103 #edb/ref 17592186045454 13194139534585 true] [17592186297100 1111 #uuid "6e35f9a8-8574-5dac-82f0-64e2238983fc" 13194139534585 true] [175