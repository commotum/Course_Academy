\n\n$$\n\\begin{aligned}S(12) & =15\\,000\\,{e}^{0.05\\cdot 12} \\\\  & =15\\,000\\,{e}^{0.6} \\\\  & ≈27\\,331.78\\end{aligned}\n$$\n\nRounding our answer to the nearest integer, we conclude that the number of subscribers is $27\\,332$ after $12$ weeks." 13194139534585 true] [17592186297106 1000 #edb/ref 17592186297107 13194139534585 true] [17592186297106 1000 #edb/ref 17592186297108 13194139534585 true] [17592186297106 1000 #edb/ref 17592186297109 13194139534585 true] [17592186297106 1000 #edb/ref 17592186297110 13194139534585 true] [17592186297106 1000 #edb/ref 17592186297111 13194139534585 true] [17592186297106 1040 #edb/ref 17592186045450 13194139534585 true] [17592186297106 1041 "selection" 13194139534585 true] [17592186297106 1104 #edb/ref 17592186297108 13194139534585 true] [17592186297106 1110 #uuid "4df97d5d-d1f0-547c-81a9-3414beafde79" 13194139534585 true] [17592186297107 1034 "24\\,731" 13194139534585 true] [17592186297107 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297107 1111 #uuid "9af93ca2-f624-5d72-899e-d7ccdd0e6168" 13194139534585 true] [17592186297108 1034 "27\\,332" 13194139534585 true] [17592186297108 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297108 1111 #uuid "1b6274f1-d015-56f4-9224-742484bafa2b" 13194139534585 true] [17592186297109 1034 "22\\,377" 13194139534585 true] [17592186297109 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297109 1111 #uuid "b307080c-712f-54e2-be70-6e9ea3d7cc2e" 13194139534585 true] [17592186297110 1034 "20\\,248" 13194139534585 true] [17592186297110 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297110 1111 #uuid "e41987f4-94a9-50a0-83b0-9e8eb978238c" 13194139534585 true] [17592186297111 1034 "31\\,755" 13194139534585 true] [17592186297111 1103 #edb/ref 17592186045453 13194139534585 true] [17592186297111 1111 #uuid "d2cb9fc9-2541-533d-b278-2db09abb03d1" 13194139534585 true]] :edb/tempids {"q-119231" 17592186297037 "q-119231/selection" 17592186297038 "q-119231/sel