3ed4ff20808a"] :db/ensure [:answer-field/validate]} {:db/id "q-103557" :question/id #uuid "2e2df44b-885f-5606-befe-9f70e9e645a5" :question/math-academy-id "q-103557" :question/problem "Which of the following is **NOT** a first-order linear ordinary differential equation?" :question/worked-solution "To determine which of the following differential equations is a first-order linear ordinary differential equation, we attempt to write each option in the standard form.\n\nA first-order linear ODE is in standard form if it is written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x).\n$$\n\nNote that the option\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-\\sqrt{xy}={x}^{2}\n$$\n\ncannot be written in standard form since the power of $y$ in the term $\\sqrt{xy}$ is not $1.$ Since the equation cannot be written in standard form, we conclude that it is not a first-order linear ODE.\n\nAll of the other equations can be written in the standard form, and therefore they are first-order linear ODEs." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103557/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bc50a680-dbf8-5d45-a8c3-72c3c15243f6"] :knowledge-point/questions ["q-103557"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79750/selection/c07484c2dcd73468b7217e61373cc17f7187bcb48561853289e58ddbb61aac02" :answer/id #uuid "b82dcafa-ff41-54c0-9644-1d4421403a4c" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}y}{\\text{d}x}+{x}^{2}y=\\operatorname{sec}⁡x" :db/ensure [:answer/validate]} {:db/id "q-79750/selection/f81d7050a08dbeeef464f31faee251f42b1331c5eb29c8ab48af47f5a3d9604c" :answer/id #uuid "aab46c36-3f8d-5731-84e3-381f12536131" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}y}{\\text{d}x}+xy={y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-79750/selection/1a8b54d5847ed4064167448dccc06870e3020688d0f808d795f207c4e7bc4528" :answer/id #uuid "eae848a5-d051-5403-a7bd-4503d2aeec25" :answer/t