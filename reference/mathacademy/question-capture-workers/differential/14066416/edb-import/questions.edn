edge-point/id #uuid "8b4d9d68-59b6-5209-8265-e1e062c422bf" :knowledge-point/title "Calculating the Wronskian of Two Vector-Valued Functions"}] :question/answer-fields [{:answer-field/id #uuid "c0dd91dd-30c0-5789-9f3d-6a0aac1d0583" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186220466}] :question/id #uuid "7bfec16a-0969-50de-9ad7-04282efcdd7c" :question/math-academy-id "q-333695" :question/problem "$x_{1}(t) = \\begin{bmatrix}e^{t} \\\\ 0\\end{bmatrix}, x_{2}(t) = \\begin{bmatrix}0 \\\\ e^{-t}\\end{bmatrix}$\nThe Wronskian of the vector-valued functions given above is $W(x_{1}, x_{2}) =$ {{field-1}}."}] [{:db/id #edb/ref 17592186221932 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee461d3e-3afa-51c6-bddd-355668cac3ec" :knowledge-point/title "Identifying Linearly Independent Vector-Valued Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5c5fda0-a874-5669-be50-630aaf890a76" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186220562} {:answer/id #uuid "46f59fe6-486f-5c5e-8989-4d1fb36fe25f" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186220563} {:answer/id #uuid "733af770-dc3c-5023-81a3-4cfb4245f5cf" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186220564} {:answer/id #uuid "79c3be04-cfbf-52e9-9730-c962ff4a98aa" :answer/type {:db/ident :answer.type/math} :answer/value "\\cos (2t)" :db/id #edb/ref 17592186220565}] :answer-field/id #uuid "698fd7a3-feb4-5cca-8334-9ab6921a31ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220561} {:answer-field/choices [{:answer/id #uuid "274328b2-11b2-577d-8d62-37e787cb69f7" :answer/type {:db/ident :answer.type/text} :answer/value "dependent" :db/id #edb/ref 17592186220567} {:answer/id #uuid "65d1ddc8-d69b-50e2-bd3c-aa1a9c0ed8d5" :answer/type {:db/ident :answer.type/text} :answer/value "independent" :db/id #edb/ref 17592186220568}] :answer-field/id #uuid "0bd310ab-4d6e-532f-b0f9-788b1d9f4db4" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220566} {:answer-field/choices [{:answer/id #uuid "354b6705-8345-5f56-bdbb-90921b2ceed2" :answer/type {:db/ident :answer.type/text} :answer/value "zero for all $t ∈ R$" :db/id #edb/ref 17592186220570} {:answer/id #uuid "630348cd-e8e2-5e5e-bb57-60d7b6f8aa3d" :answer/type {:db/ident :answer.type/text} :answer/value "nonzero for at least one $t ∈ R$" :db/id #edb/ref 17592186220571}] :answer-field/id #uuid "b7257d63-45d7-5159-a609-ae8326614098" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220569}] :question/id #uuid "36b5721c-1260-58ca-a074-b5fdeb826aa7" :question/math-academy-id "q-333862" :question/problem "$x_{1}(t) = \\begin{bmatrix}\\cos t \\\\ \\sin t\\end{bmatrix}, x_{2}(t) = \\begin{bmatrix}-\\sin t \\\\ \\cos t\\end{bmatrix}, t ∈ R$\nConsider the vector-valued functions $x_{1}(t)$ and $x_{2}(t)$ above. Given that $x_{1}$ and $x_{2}$ are solutions of the same system of linear ODEs, select the correct options in the reasoning below. The Wronskian is $W(x_{1}, x_{2}) =$\n{{field-1}},\n\nwhich is\n{{field-2}}.\n\nTherefore, the set ${x_{1}(t), x_{2}(t)}$ is linearly\n{{field-3}}\non $R$."}]}
