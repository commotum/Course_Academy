1}(t)\\end{aligned}],\\,{x}_{2}(t)=[\\begin{aligned}{x}_{12}(t) \\\\ {x}_{22}(t)\\end{aligned}]\n$$\n\nis defined as\n\n$$\nW({x}_{1},{x}_{2})=det({x}_{1},{x}_{2})=|\\begin{aligned}{x}_{11}(t) & {x}_{12}(t) \\\\ {x}_{21}(t) & {x}_{22}(t)\\end{aligned}|.\n$$\n\nNote the following:\n\n- If the Wronskian is not identically zero, then ${x}_{1}$ and ${x}_{2}$ are linearly independent.\n\n- If the Wronskian is identically zero, and it's known that ${x}_{1}$ and ${x}_{2}$ are solutions to the same system of linear ODEs, then ${x}_{1}$ and ${x}_{2}$ are linearly dependent.\n\nIn our case, our Wronskian is given by\n\n$$\n\\begin{aligned}W({x}_{1},{x}_{2}) & =|\\begin{aligned}{e}^{2t} & 0 \\\\ 0 & {e}^{2t}\\end{aligned}| \\\\  & ={e}^{2t}\\cdot {e}^{2t}-0\\cdot 0 \\\\  & ={e}^{4t} \\\\  & ={e}^{4t}\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }t\\in R.$\n\nTherefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{independent}$ on $R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066416/state.json" "file_sha256" "cc3ce6898e8f8dab9f9a179a0f257acf4954c5c5c4592c4f8f474f9ac025e99a"} {"question" "q-333741" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066416/activity-metadata.json" "file_sha256" "6bdd60be2a2b463d1fbf9315ff535bfc3475f1261975508c62b026647a7c851e"} {"question" "q-333741" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066416/state.json" "file_sha256" "cc3ce6898e8f8dab9f9a179a0f257acf4954c5c5c4592c4f8f474f9ac025e99a"} {"question" "q-333741" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "-{e}^{4t}"] ["math" "0"] [