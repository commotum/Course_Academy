f1f8780020e9" :answer/type {:db/ident :answer.type/math} :answer/value "(3(− 1)^{n})/(nπ^{2}(4 + nπ))" :db/id #edb/ref 17592186220832} {:answer/id #uuid "3aabedc3-6770-58b6-af7f-40e9432a6d47" :answer/type {:db/ident :answer.type/math} :answer/value "− (3(− 1)^{n})/(16 + n^{2}π^{2})" :db/id #edb/ref 17592186220833} {:answer/id #uuid "6feaa1e2-98d2-5960-9b1f-94704af30a62" :answer/type {:db/ident :answer.type/math} :answer/value "− (9(− 1)^{n})/(n^{2}π^{2}(16 − n^{2}))" :db/id #edb/ref 17592186220834}] :answer-field/correct {:answer/id #uuid "ff3fbff4-b497-5614-9eb6-7b9a63f1829b" :answer/type {:db/ident :answer.type/math} :answer/value "(9(− 1)^{n})/(n^{2}π(144 − n^{2}π^{2}))" :db/id #edb/ref 17592186220831} :answer-field/id #uuid "8410ec55-d2ac-5404-90ba-cb8ca780851c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186220830}] :question/id #uuid "d2c6150b-3687-5b67-8114-c6babfa1ec19" :question/math-academy-id "q-343373" :question/problem "Select the missing parts in a particular solution of the differential equation $y^{″} + 16y = f(x)$, where the Fourier series of the $6$-periodic forcing function is given by\n$f(x)∼∑_(n = 1)^(∞)((-1)^{n})/(n^{2}π)\\sin (\\frac{nπx}{3})$.\n\n*Hint: You may assume that the free term and all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n$(3(-1)^{n})/(nπ^{2}(4 + nπ))$ {{field-1}}"}]}
