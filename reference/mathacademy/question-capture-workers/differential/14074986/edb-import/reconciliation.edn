{n\\pi x}{2}).\n$$\n\n*Hint: You may assume that the free term and all the cosine coefficients in the Fourier series of the particular solution are equal to zero.*\n\nThe Fourier series of a particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/state.json" "file_sha256" "98cd9a0d00664aad6bd9b61b1f95ba7af238532b160bbb9c07501e577ada2b6a"} {"question" "q-343875" "field" nil "attribute" "question/worked-solution" "value" "We assume that a solution of our equation has the following Fourier series:\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{p}^{′} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}) \\\\ {y}_{p}^{″} & ∼\\frac{\\text{d}}{\\text{d}x}({\\sum }_{n=1}^{\\infty }\\frac{{b}_{n}n\\pi }{2}\\operatorname{cos}⁡(\\frac{n\\pi x}{2}))∼{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{p}^{″}$ and ${y}_{p}$ into the equation:\n\n$$\n{\\sum }_{n=1}^{\\infty }-\\frac{{b}_{n}{n}^{2}{\\pi }^{2}}{4}\\operatorname{sin}⁡(\\frac{n\\pi x}{2})+9({\\sum }_{n=1}^{\\infty }{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}))={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nRearranging the terms to find a common denominator:\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(9-\\frac{{n}^{2}{\\pi }^{2}}{4})\\operatorname{sin}⁡(\\frac{n\\pi x}{2})={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2})\n$$\n\n$$\n{\\sum }_{n=1}^{\\infty }{b}_{n}(\\frac{36-{n}^{2}{\\pi }^{2}}{4})\\operatorname{sin}⁡(\\frac{n\\pi x}{2})={\\sum }_{n=1}^{\\infty }\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nNow, equating the sine coefficients:\n\n$$\n\\frac{{b}_{n}(36-{n}^{2}{\\pi }^{2})}{4}=\\frac{2(-1)^{n}}{{n}^{2}\\pi }\\,⇒\\,{b}_{n}=\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}.\n$$\n\nTherefore, our particular solution is\n\n$$\n{y}_{p}∼{\\sum }_{n=1}^{\\infty }\\,\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}\\cdot \\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/state.json" "file_sha256" "98cd9a0d00664aad6bd9b61b1f95ba7af238532b160bbb9c07501e577ada2b6a"} {"question" "q-343875" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/activity-metadata.json" "file_sha256" "780dcc0827b7cc928c082b0b4b7b45ad18ea474c27524d9603b01ad71c22a1bf"} {"question" "q-343875" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/state.json" "file_sha256" "98cd9a0d00664aad6bd9b61b1f95ba7af238532b160bbb9c07501e577ada2b6a"} {"question" "q-343875" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "-\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}"] ["math" "\\frac{4(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}"] ["math" "\\frac{8(-1)^{n}}{n\\pi (36-{n}^{2}{\\pi }^{2})}"] ["math" "\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/state.json" "file_sha256" "98cd9a0d00664aad6bd9b61b1f95ba7af238532b160bbb9c07501e577ada2b6a"} {"question" "q-343875" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{8(-1)^{n}}{{n}^{2}\\pi (36-{n}^{2}{\\pi }^{2})}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/state.json" "file_sha256" "98cd9a0d00664aad6bd9b61b1f95ba7af238532b160bbb9c07501e577ada2b6a"} {"question" "q-343907" "field" nil "attribute" "question/problem" "value" "Consider the differential equation ${y}^{″}+{\\pi }^{2}y=f(x),$ where the $4$-periodic forcing function is given by \n\n$$\nf(x)∼2+{\\sum }_{n=1}^{\\infty }\\frac{4}{{n}^{2}}\\operatorname{sin}⁡(\\frac{n\\pi x}{2}).\n$$\n\nSelect the correct options in the reasoning below regarding the resonant component of a particular solution of the equation.\n\nThe natural frequency of the system matches the frequency of the {{field-1}} harmonic of the forcing function. \n\nConsequently, the particular solution contains a resonant term of the form\n\n$$\n{y}_{{p}_{2}}={{field-2}}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/state.json" "file_sha256" "98cd9a0d00664aad6bd9b61b1f95ba7af238532b160bbb9c07501e577ada2b6a"} {"question" "q-343907" "field" nil "attribute" "question/worked-solution" "value" "We begin by identifying resonance. The differential equation \n\n$$\n{y}^{″}+{\\pi }^{2}y=f(x)\n$$\n\nhas a natural frequency of \n\n$$\n\\omega =\\sqrt{{\\pi }^{2}}=\\pi .\n$$\n\nThe frequencies of the forcing harmonics for a $4$-periodic function $(L=2)$ are \n\n$$\n{\\omega }_{n}=\\frac{n\\pi }{2}.\n$$\n\nFor $n=2$, we have ${\\omega }_{2}=\\pi .$ Since ${\\omega }_{2}=\\omega ,$ the $n=2$ harmonic of the forcing function causes resonance.\n\nFor the $n=2$ harmonic, the forcing term is \n\n$$\n{f}_{2}(x)=\\operatorname{sin}⁡(\\pi x).\n$$\n\nBecause this frequency matches the natural frequency, we assume a particular solution of the form\n\n$$\n{y}_{{p}_{2}}=x(A\\operatorname{cos}⁡(\\pi x)+B\\operatorname{sin}⁡(\\pi x)).\n$$\n\nNow, we compute the derivatives:\n\n$$\n\\begin{aligned}{y}_{{p}_{2}}^{′} & =(A\\operatorname{cos}⁡(\\pi x)+B\\operatorname{sin}⁡(\\pi x))+x(-\\pi A\\operatorname{sin}⁡(\\pi x)+\\pi B\\operatorname{cos}⁡(\\pi x)) \\\\ {y}_{{p}_{2}}^{″} & =-2\\pi A\\operatorname{sin}⁡(\\pi x)+2\\pi B\\operatorname{cos}⁡(\\pi x)-{\\pi }^{2}x(A\\operatorname{cos}⁡(\\pi x)+B\\operatorname{sin}⁡(\\pi x))\\end{aligned}\n$$\n\nNext, we substitute the expressions for ${y}_{{p}_{2}}^{″}$ and ${y}_{{p}_{2}}$ into the equation ${y}^{″}+{\\pi }^{2}y=\\operatorname{sin}⁡(\\pi x):$\n\n$$\n[-2\\pi A\\operatorname{sin}⁡(\\pi x)+2\\pi B\\operatorname{cos}⁡(\\pi x)-{\\pi }^{2}{y}_{{p}_{2}}]+{\\pi }^{2}{y}_{{p}_{2}}=\\operatorname{sin}⁡(\\pi x)\n$$\n\nThe resonant terms involving $x$ cancel out, leaving\n\n$$\n-2\\pi A\\operatorname{sin}⁡(\\pi x)+2\\pi B\\operatorname{cos}⁡(\\pi x)=\\operatorname{sin}⁡(\\pi x).\n$$\n\nNow, equating the sine and cosine coefficients, we obtain:\n\n$$\n{\\begin{aligned}-2\\pi A=1 \\\\ 2\\pi B=0\\end{aligned}\\,⇒\\,{\\begin{aligned}A=-\\frac{1}{2\\pi } \\\\ B=0\\end{aligned}\n$$\n\nTherefore, the resonant component of a particular solution is\n\n$$\n{y}_{{p}_{2}}=-\\frac{x}{2\\pi }\\operatorname{cos}⁡(\\pi x).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/state.json" "file_sha256" "98cd9a0d00664aad6bd9b61b1f95ba7af238532b160bbb9c07501e577ada2b6a"} {"question" "q-343907" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074986/activity-metadata.json" "file_sha256" "780dcc0827b7cc928c082b0b4b7b45ad18ea474c27524d9603b01ad71c22a1bf"} {