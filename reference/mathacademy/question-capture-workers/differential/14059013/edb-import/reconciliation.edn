egory" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" nil "attribute" "question/problem" "value" "Let $f(x,y)=xy,$ where $x=\\operatorname{cos}⁡t+\\operatorname{sin}⁡s$ and $y=\\operatorname{sin}⁡t.$ Calculate $\\frac{∂f}{∂t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{sin}⁡t, \\\\ \\frac{∂f}{∂y} & =\\operatorname{cos}⁡t+\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =-\\operatorname{sin}⁡t, \\\\ \\frac{∂y}{∂t} & =\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =\\operatorname{sin}⁡t(-\\operatorname{sin}⁡t)+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡s)\\cdot \\operatorname{cos}⁡t \\\\  & =-{sin}^{2}⁡t+{cos}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/activity-metadata.json" "file_sha256" "d8194713c58a546b3a89b58adc8494cb9415333032cb9763dd1edd221da5805b" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+\\operatorname{cos}⁡s\\operatorname{cos}⁡t"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1+\\operatorname{sin}⁡s\\operatorname{sin}⁡t"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{cos}⁡s\\operatorname{cos}⁡t"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{cos}⁡s\\operatorname{sin}⁡t"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170672" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=\\frac{y+z}{x},$ where $x=s+t,$ $y={s}^{2}$ and $z={t}^{2}.$ Given that\n\n$$\n\\frac{∂f}{∂t}=\\frac{{c}_{1}{s}^{2}+{c}_{2}st+{c}_{3}{t}^{2}}{(s+t)^{2}},\n$$\n\nfind the value of ${c}_{1}+{c}_{2}+{c}_{3}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{y+z}{{x}^{2}},\\,\\frac{∂f}{∂y}=\\frac{1}{x},\\,\\frac{∂f}{∂z}=\\frac{1}{x}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{1}{s+t}, \\\\ \\frac{∂f}{∂z} & =\\frac{1}{s+t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =0, \\\\ \\frac{∂z}{∂t} & =2t.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}\\cdot (1)+\\frac{1}{s+t}\\cdot 0+\\frac{1}{s+t}\\cdot 2t \\\\  & =\\frac{-({s}^{2}+{t}^{2})+2t(s+t)}{(s+t)^{2}} \\\\  & =\\frac{{t}^{2}+2ts-{s}^{2}}{(s+t)^{2}}.\\end{aligned}\n$$\n\nFinally, ${c}_{1}=-1,$ ${c}_{2}=2$ and ${c}_{3}=1,$ and therefore\n\n$$\n{c}_{1}+{c}_{2}+{c}_{3}=-1+2+1=2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/activity-metadata.json" "file_sha256" "d8194713c58a546b3a89b58adc8494cb9415333032cb9763dd1edd221da5805b" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "0"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "1"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-170675" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=\\operatorname{ln}⁡x-2{e}^{y}+4z,$ where $x=t{s}^{2},$ $y=\\operatorname{ln}⁡({t}^{2}+{s}^{2})$ and $z={s}^{2}.$ Calculate $\\frac{∂f}{∂s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/be6afcdd0ad9ae0d7ef377c4918442a64e1186c90c25e27ec6c224d816a602fd.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{x},\\,\\frac{∂f}{∂y}=-2{e}^{y},\\,\\frac{∂f}{∂z}=4.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{t{s}^{2}}, \\\\ \\frac{∂f}{∂y} & =-2{e}^{\\operatorname{ln}⁡({t}^{2}+{s}^{2})}=-2({t}^{2}+{s}^{2}), \\\\ \\frac{∂f}{∂z} & =4.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =2ts, \\\\ \\frac{∂y}{∂s} & =\\frac{2s}{{t}^{2}+{s}^{2}}, \\\\ \\frac{∂z}{∂s} & =2s.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =(\\frac{1}{t{s}^{2}})\\cdot 2ts+(-2({t}^{2}+{s}^{2}))\\cdot (\\frac{2s}{{t}^{2}+{s}^{2}})+(4)\\cdot 2s \\\\  & =\\frac{2}{s}-4s+8s \\\\  & =\\frac{2}{s}+4s \\\\  & =\\frac{2(1+2{s}^{2})}{s}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/activity-metadata.json" "file_sha256" "d8194713c58a546b3a89b58adc8494cb9415333032cb9763dd1edd221da5805b" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{1+{t}^{2}}{s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{2(1+2{s}^{2})}{s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{st+1}{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{{t}^{2}-{s}^{2}}{s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94816" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "st({s}^{2}{t}^{2}+1)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=xyz,$ where $x=2,$ $y=s{e}^{t}$ and $z=t{e}^{s}.$ Calculate $\\frac{∂f}{∂t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=yz,\\,\\frac{∂f}{∂y}=xz,\\,\\frac{∂f}{∂z}=xy.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =ts{e}^{t+s}, \\\\ \\frac{∂f}{∂y} & =2t{e}^{s}, \\\\ \\frac{∂f}{∂z} & =2s{e}^{t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =0, \\\\ \\frac{∂y}{∂t} & =s{e}^{t}, \\\\ \\frac{∂z}{∂t} & ={e}^{s}.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(ts{e}^{t+s})\\cdot 0+(2t{e}^{s})\\cdot s{e}^{t}+(2s{e}^{t})\\cdot {e}^{s} \\\\  & =2ts{e}^{t+s}+2s{e}^{t+s} \\\\  & =2s(t+1){e}^{t+s}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/activity-metadata.json" "file_sha256" "d8194713c58a546b3a89b58adc8494cb9415333032cb9763dd1edd221da5805b" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2(t+s){e}^{t+s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2s(t+1){e}^{t+s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "2t(s+1){e}^{t+s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4(t-s){e}^{t+s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "4t(s-1){e}^{t+s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "q-94812" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2s(t+1){e}^{t+s}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/state.json" "file_sha256" "dab043a8fe9b126d8ee518c87a90350ca99ee102333d2a371161375be74ff4b7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8256" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\cos(xy), x=t,$ and $y=e^t,$ compute $\\dfrac{\\textrm{d}f}{\\textrm{d}t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8256.json" "file_sha256" "9121b86850a926106b99475eff5b2db164b76e7b44d5dcf4525f34e436607df7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8256" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x = x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}t} \n= \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\textrm{d}x}{\\textrm{d}t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-y\\operatorname{sin}⁡(xy),\\,\\frac{∂f}{∂y}=-x\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-{e}^{t}\\operatorname{sin}⁡(t{e}^{t}), \\\\ \\frac{∂f}{∂y} & =-t\\operatorname{sin}⁡(t{e}^{t}).\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=1,\\,\\frac{\\text{d}y}{\\text{d}t}={e}^{t}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =[-{e}^{t}\\operatorname{sin}⁡(t{e}^{t})]\\cdot 1+[-t\\operatorname{sin}⁡(t{e}^{t})]\\cdot {e}^{t} \\\\  & =-{e}^{t}\\operatorname{sin}⁡(t{e}^{t})-t{e}^{t}\\operatorname{sin}⁡(t{e}^{t}) \\\\  & =-(1+t){e}^{t}\\operatorname{sin}⁡(t{e}^{t}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8256.json" "file_sha256" "9121b86850a926106b99475eff5b2db164b76e7b44d5dcf4525f34e436607df7" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8257" "field" nil "attribute" "question/problem" "value" "If $f(x,y) = 2\\sqrt{x+y}$ and $y=\\cos x,$ compute $\\dfrac{\\textrm{d}f}{\\textrm{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8257.json" "file_sha256" "5a2b7a4e357ec33a2baad35f9496881450c88efeef1edbaed357cf20ebbc6097" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8257" "field" nil "attribute" "question/worked-solution" "value" "The chain rule for a multivariable function $f(x,y)$ in the case where $y = y(x)$ can be expressed as follows:\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}x} = \\dfrac{\\partial f}{\\partial x} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{\\sqrt{x+y}},\\,\\frac{∂f}{∂y}=\\frac{1}{\\sqrt{x+y}}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂f}{∂y} & =\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}+\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}-\\frac{\\operatorname{sin}⁡x}{\\sqrt{x+\\operatorname{cos}⁡x}} \\\\  & =\\frac{1-\\operatorname{sin}⁡x}{\\sqrt{x+\\operatorname{cos}⁡x}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8257.json" "file_sha256" "5a2b7a4e357ec33a2baad35f9496881450c88efeef1edbaed357cf20ebbc6097" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8258" "field" nil "attribute" "question/problem" "value" "Let $f(x,y) = x^2 + y^2,$ where $x = s\\cos{t}$ and $y = t\\sin{s}.$ Calculate $\\dfrac{\\partial f}{\\partial t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8258.json" "file_sha256" "6293d5810b9aced11768bcd6b2d246c957a3024b36045f5209b4e06728c845f4" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8258" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y = y(s,t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\partial y}{\\partial t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=2y\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2s\\operatorname{cos}⁡t, \\\\ \\frac{∂f}{∂y} & =2t\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =-s\\operatorname{sin}⁡t, \\\\ \\frac{∂y}{∂t} & =\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =(2s\\operatorname{cos}⁡t)(-s\\operatorname{sin}⁡t)+(2t\\operatorname{sin}⁡s)(\\operatorname{sin}⁡s) \\\\  & =-2{s}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2t{sin}^{2}⁡s \\\\  & =2t{sin}^{2}⁡s-2{s}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =2t{sin}^{2}⁡s-{s}^{2}\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nNotice that we used the identity $\\sin 2t = 2\\sin t\\cos t$ in the above simplification." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8258.json" "file_sha256" "6293d5810b9aced11768bcd6b2d246c957a3024b36045f5209b4e06728c845f4" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8259" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z) = e^{xy + z},$ where $x = s + t,$ $y = s-t$ and $z = -s^2.$ Calculate $\\dfrac{\\partial f}{\\partial t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8259.json" "file_sha256" "2e643af06385f8bd467371cec5a863d64289a85b0102dbaa2cc6b662cefaefa1" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"} {"question" "e-8259" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t), y = y(s,t)$ and $z = z(s,t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\partial y}{\\partial t} + \\dfrac{\\partial f}{\\partial z}\\cdot \\dfrac{\\partial z}{\\partial t}.\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x, y$ and $z\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y{e}^{xy+z},\\,\\frac{∂f}{∂y}=x{e}^{xy+z},\\,\\frac{∂f}{∂z}={e}^{xy+z}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =(s-t){e}^{(s+t)(s-t)-{s}^{2}}=(s-t){e}^{-{t}^{2}}, \\\\ \\frac{∂f}{∂y} & =(s+t){e}^{(s+t)(s-t)-{s}^{2}}=(s+t){e}^{-{t}^{2}}, \\\\ \\frac{∂f}{∂z} & ={e}^{(s+t)(s-t)-{s}^{2}}={e}^{-{t}^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =-1, \\\\ \\frac{∂z}{∂t} & =0.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(s-t){e}^{-{t}^{2}}\\cdot 1+(s+t){e}^{-{t}^{2}}\\cdot (-1)+{e}^{-{t}^{2}}\\cdot 0 \\\\  & =(s-t-s-t){e}^{-{t}^{2}} \\\\  & =-2t{e}^{-{t}^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/example-8259.json" "file_sha256" "2e643af06385f8bd467371cec5a863d64289a85b0102dbaa2cc6b662cefaefa1" "basis" 1656 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/edb-import/verification.json"}] "sources" [{"question" "q-95081" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=y+x\\operatorname{ln}⁡y,\\,x=s$ and $y=2s,$ compute $\\frac{\\text{d}f}{\\text{d}s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95081" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\operatorname{ln}⁡y,\\,\\frac{∂f}{∂y}=1+\\frac{x}{y}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{ln}⁡2s, \\\\ \\frac{∂f}{∂y} & =1+\\frac{s}{2s}=\\frac{3}{2}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=1,\\,\\frac{\\text{d}y}{\\text{d}s}=2.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =\\operatorname{ln}⁡2s\\cdot 1+\\frac{3}{2}\\cdot 2 \\\\  & =3+\\operatorname{ln}⁡2s.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95081" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95081" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95081" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3+\\operatorname{ln}⁡2s"] ["math" "3\\operatorname{ln}⁡2s"] ["math" "\\frac{3}{2}+\\operatorname{ln}⁡2s"] ["math" "\\frac{3}{4}+\\operatorname{ln}⁡2s"] ["math" "\\operatorname{ln}⁡2s"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95081" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3+\\operatorname{ln}⁡2s"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170668" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\operatorname{sin}⁡x\\operatorname{cos}⁡y,x={t}^{2},$ and $y=t,$ compute $\\frac{\\text{d}f}{\\text{d}t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170668" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x=x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}t}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\operatorname{cos}⁡x\\operatorname{cos}⁡y,\\,\\frac{∂f}{∂y}=-\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t), \\\\ \\frac{∂f}{∂y} & =-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t).\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=2t,\\,\\frac{\\text{d}y}{\\text{d}t}=1.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)\\cdot 2t+(-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t))\\cdot 1 \\\\  & =2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170668" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-170668" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170668" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)"] ["math" "-2t\\operatorname{sin}⁡({t}^{2})\\operatorname{cos}⁡(t)"] ["math" "2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t)"] ["math" "\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t)"] ["math" "{t}^{2}\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-t\\operatorname{sin}⁡({t}^{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170668" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2t\\operatorname{cos}⁡({t}^{2})\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡({t}^{2})\\operatorname{sin}⁡(t)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95079" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=x\\operatorname{cos}⁡y,x=4t$ and $y=t,$ compute $\\frac{\\text{d}f}{\\text{d}t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95079" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x=x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}t}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\operatorname{cos}⁡y,\\,\\frac{∂f}{∂y}=-x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{cos}⁡t \\\\ \\frac{∂f}{∂y} & =-4t\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=4,\\,\\frac{\\text{d}y}{\\text{d}t}=1.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =\\operatorname{cos}⁡t\\cdot 4+(-4t\\operatorname{sin}⁡t)\\cdot 1 \\\\  & =4(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95079" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95079" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95079" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)"] ["math" "4(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)"] ["math" "4(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)"] ["math" "\\operatorname{sin}⁡t+4t\\operatorname{cos}⁡t"] ["math" "\\operatorname{sin}⁡t-4t\\operatorname{cos}⁡t"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95079" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95085" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\frac{x}{1+y},$ $x={s}^{2}$ and $y=s,$ compute $\\frac{\\text{d}f}{\\text{d}s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95085" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{1+y},\\,\\frac{∂f}{∂y}=-\\frac{x}{(1+y)^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{1+s}, \\\\ \\frac{∂f}{∂y} & =-\\frac{{s}^{2}}{(1+s)^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=2s,\\,\\frac{\\text{d}y}{\\text{d}s}=1.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =\\frac{1}{1+s}\\cdot 2s-\\frac{{s}^{2}}{(1+s)^{2}}\\cdot 1 \\\\  & =\\frac{2s}{1+s}-\\frac{{s}^{2}}{(1+s)^{2}} \\\\  & =\\frac{2s(1+s)-{s}^{2}}{(1+s)^{2}} \\\\  & =\\frac{s(2+s)}{(1+s)^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95085" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95085" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95085" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1+{s}^{2}}{(1+s)^{2}}"] ["math" "\\frac{2+{s}^{2}}{1+s}"] ["math" "\\frac{s(1-s)}{(1+s)^{2}}"] ["math" "\\frac{s(2+s)}{(1+s)^{2}}"] ["math" "\\frac{{s}^{2}(2+s)}{(1+s)}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95085" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{s(2+s)}{(1+s)^{2}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95084" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\frac{x}{y},x=\\operatorname{cos}⁡2s$ and $y=\\operatorname{sin}⁡2s,$ compute $\\frac{\\text{d}f}{\\text{d}s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95084" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{y},\\,\\frac{∂f}{∂y}=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{\\operatorname{sin}⁡2s}, \\\\ \\frac{∂f}{∂y} & =-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=-2\\operatorname{sin}⁡2s,\\,\\frac{\\text{d}y}{\\text{d}s}=2\\operatorname{cos}⁡2s.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =\\frac{1}{\\operatorname{sin}⁡2s}\\cdot (-2\\operatorname{sin}⁡2s)+(-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s})\\cdot 2\\operatorname{cos}⁡2s \\\\  & =-2-2\\cdot \\frac{{cos}^{2}⁡2s}{{sin}^{2}⁡2s} \\\\  & =-2-2{cot}^{2}⁡2s \\\\  & =-2{csc}^{2}⁡2s.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95084" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95084" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95084" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{csc}^{2}⁡2s"] ["math" "2{sec}^{2}⁡2s"] ["math" "\\operatorname{cot}⁡2s"] ["math" "\\operatorname{tan}⁡2s"] ["math" "\\operatorname{tan}⁡2s+{csc}^{2}⁡2s"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95084" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2{csc}^{2}⁡2s"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95121" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=x\\operatorname{ln}⁡(x+y)$ and $y={x}^{2},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95121" "field" nil "attribute" "question/worked-solution" "value" "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\operatorname{ln}⁡(x+y)+\\frac{x}{x+y},\\,\\frac{∂f}{∂y}=\\frac{x}{x+y}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x}{x+{x}^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{x}{x+{x}^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x}{x+{x}^{2}}+\\frac{x}{x+{x}^{2}}\\cdot 2x \\\\  & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x+2{x}^{2}}{x+{x}^{2}} \\\\  & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{x(1+2x)}{x(1+x)} \\\\  & =\\operatorname{ln}⁡(x+{x}^{2})+\\frac{1+2x}{1+x}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95121" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95121" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95121" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1+2x}{1+x}"] ["math" "\\operatorname{ln}⁡(1+x)-\\frac{1+2{x}^{2}}{1+{x}^{2}}"] ["math" "\\operatorname{ln}⁡(1+{x}^{2})-\\frac{1+3{x}^{2}}{1+2x}"] ["math" "\\operatorname{ln}⁡(x+{x}^{2})+\\frac{1+2x}{1+x}"] ["math" "{x}^{2}\\operatorname{ln}⁡(1+x)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95121" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\operatorname{ln}⁡(x+{x}^{2})+\\frac{1+2x}{1+x}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95122" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\frac{y}{x+1}$ and $y={x}^{3},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95122" "field" nil "attribute" "question/worked-solution" "value" "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{y}{(x+1)^{2}},\\,\\frac{∂f}{∂y}=\\frac{1}{x+1}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{{x}^{3}}{(x+1)^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{1}{x+1}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =3{x}^{2}.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-\\frac{{x}^{3}}{(x+1)^{2}}+\\frac{1}{x+1}\\cdot 3{x}^{2} \\\\  & =\\frac{3{x}^{2}}{x+1}-\\frac{{x}^{3}}{(x+1)^{2}} \\\\  & =\\frac{3{x}^{2}(x+1)-{x}^{3}}{(x+1)^{2}} \\\\  & =\\frac{3{x}^{3}+3{x}^{2}-{x}^{3}}{(x+1)^{2}} \\\\  & =\\frac{{x}^{2}(2x+3)}{(x+1)^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95122" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95122" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95122" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{4{x}^{2}(x-6)}{x+1}"] ["math" "\\frac{x(3x+4)}{(x+1)^{2}}"] ["math" "\\frac{x(4x-3)}{x+1}"] ["math" "\\frac{{x}^{2}(2x+3)}{(x+1)^{2}}"] ["math" "\\frac{{x}^{2}(3{x}^{2}-1)}{(x+1)^{2}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95122" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{{x}^{2}(2x+3)}{(x+1)^{2}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95117" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=x{e}^{y}$ and $y=\\operatorname{sin}⁡x,$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95117" "field" nil "attribute" "question/worked-solution" "value" "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}={e}^{y},\\,\\frac{∂f}{∂y}=x{e}^{y}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & ={e}^{\\operatorname{sin}⁡x}, \\\\ \\frac{∂f}{∂y} & =x{e}^{\\operatorname{sin}⁡x}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & ={e}^{\\operatorname{sin}⁡x}+x{e}^{\\operatorname{sin}⁡x}\\cdot \\operatorname{cos}⁡x \\\\  & ={e}^{\\operatorname{sin}⁡x}(1+x\\operatorname{cos}⁡x).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95117" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95117" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95117" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{e}^{\\operatorname{cos}⁡x}(1+\\operatorname{sin}⁡x)"] ["math" "{e}^{\\operatorname{cos}⁡x}(1-x\\operatorname{sin}⁡x)"] ["math" "{e}^{\\operatorname{sin}⁡x}(1+x\\operatorname{cos}⁡x)"] ["math" "{e}^{\\operatorname{sin}⁡x}(1+x\\operatorname{sin}⁡x)"] ["math" "{e}^{\\operatorname{sin}⁡x}(1-\\operatorname{cos}⁡x)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95117" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{\\operatorname{sin}⁡x}(1+x\\operatorname{cos}⁡x)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94588" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\operatorname{sin}⁡({x}^{2}+y)$ and $y={x}^{2},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94588" "field" nil "attribute" "question/worked-solution" "value" "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x\\operatorname{cos}⁡({x}^{2}+y),\\,\\frac{∂f}{∂y}=\\operatorname{cos}⁡({x}^{2}+y)\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2x\\operatorname{cos}⁡({x}^{2}+{x}^{2})=2x\\operatorname{cos}⁡(2{x}^{2}), \\\\ \\frac{∂f}{∂y} & =\\operatorname{cos}⁡({x}^{2}+{x}^{2})=\\operatorname{cos}⁡(2{x}^{2}).\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =2x\\operatorname{cos}⁡(2{x}^{2})+\\operatorname{cos}⁡(2{x}^{2})\\cdot 2x \\\\  & =2x\\operatorname{cos}⁡(2{x}^{2})+2x\\operatorname{cos}⁡(2{x}^{2}) \\\\  & =4x\\operatorname{cos}⁡(2{x}^{2}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94588" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-94588" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94588" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "({x}^{2}+1)\\operatorname{cos}⁡({x}^{2})"] ["math" "2x(x+1)\\operatorname{sin}⁡({x}^{2})"] ["math" "2x{sin}^{2}⁡(2x)"] ["math" "2{x}^{3}\\operatorname{cos}⁡(2{x}^{2})"] ["math" "4x\\operatorname{cos}⁡(2{x}^{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94588" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4x\\operatorname{cos}⁡(2{x}^{2})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95088" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\frac{1}{x+y}$ and $y={e}^{-x},$ compute $\\frac{\\text{d}f}{\\text{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95088" "field" nil "attribute" "question/worked-solution" "value" "The chain rule for a multivariable function $f(x,y)$ in the case where $y=y(x)$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}x}=\\frac{∂f}{∂x}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{1}{(x+y)^{2}},\\,\\frac{∂f}{∂y}=-\\frac{1}{(x+y)^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂f}{∂y}=-\\frac{1}{(x+{e}^{-x})^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-{e}^{-x}.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =-\\frac{1}{(x+{e}^{-x})^{2}}-\\frac{1}{(x+{e}^{-x})^{2}}\\cdot (-{e}^{-x}) \\\\  & =-\\frac{1}{(x+{e}^{-x})^{2}}+\\frac{{e}^{-x}}{(x+{e}^{-x})^{2}} \\\\  & =\\frac{-1+{e}^{-x}}{(x+{e}^{-x})^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95088" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-95088" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95088" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{-1+{e}^{-x}}{(x+{e}^{-x})^{2}}"] ["math" "\\frac{1-2{e}^{-x}}{(x+{e}^{-x})^{2}}"] ["math" "\\frac{1-{e}^{-x}}{1+x{e}^{-x}}"] ["math" "\\frac{2}{(x+{e}^{-x})^{2}}"] ["math" "\\frac{{e}^{-x}}{1+x{e}^{-x}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-95088" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{-1+{e}^{-x}}{(x+{e}^{-x})^{2}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170673" "field" nil "attribute" "question/problem" "value" "Let $f(x,y)=y{e}^{x},$ where $x=t+s$ and $y=ts.$ Calculate $\\frac{∂f}{∂s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170673" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y{e}^{x},\\,\\frac{∂f}{∂y}={e}^{x}\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =ts{e}^{t+s}, \\\\ \\frac{∂f}{∂y} & ={e}^{t+s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =1, \\\\ \\frac{∂y}{∂s} & =t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =(ts{e}^{t+s})(1)+({e}^{t+s})(t) \\\\  & =t{e}^{t+s}(s+1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170673" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-170673" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170673" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "s{e}^{t+s}"] ["math" "s{e}^{t+s}(t+1)"] ["math" "t{e}^{t+s}(s+1)"] ["math" "t{e}^{t+s}(s-t)"] ["math" "{e}^{t+s}(s+t)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170673" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "t{e}^{t+s}(s+1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94747" "field" nil "attribute" "question/problem" "value" "Let $f(x,y)=\\frac{1}{x}+\\frac{1}{y},$ where $x={e}^{st}$ and $y={e}^{-st}.$ Calculate $\\frac{∂f}{∂s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94747" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{1}{{x}^{2}},\\,\\frac{∂f}{∂y}=-\\frac{1}{{y}^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{1}{({e}^{st})^{2}}=-{e}^{-2st}, \\\\ \\frac{∂f}{∂y} & =-\\frac{1}{({e}^{-st})^{2}}=-{e}^{2st}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =t{e}^{st}, \\\\ \\frac{∂y}{∂s} & =-t{e}^{-st}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =(-{e}^{-2st})(t{e}^{st})+(-{e}^{2st})(-t{e}^{-st}) \\\\  & =t{e}^{st}-t{e}^{-st} \\\\  & =t({e}^{st}-{e}^{-st}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94747" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-94747" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94747" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2t"] ["math" "2t{e}^{-st}"] ["math" "2t{e}^{st}"] ["math" "t({e}^{2st}+{e}^{-2st})"] ["math" "t({e}^{st}-{e}^{-st})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94747" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "t({e}^{st}-{e}^{-st})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170672" "field" nil "attribute" "question/problem" "value" "Let $f(x,y)=xy,$ where $x=\\operatorname{cos}⁡t+\\operatorname{sin}⁡s$ and $y=\\operatorname{sin}⁡t.$ Calculate $\\frac{∂f}{∂t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170672" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{sin}⁡t, \\\\ \\frac{∂f}{∂y} & =\\operatorname{cos}⁡t+\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =-\\operatorname{sin}⁡t, \\\\ \\frac{∂y}{∂t} & =\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =\\operatorname{sin}⁡t(-\\operatorname{sin}⁡t)+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡s)\\cdot \\operatorname{cos}⁡t \\\\  & =-{sin}^{2}⁡t+{cos}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170672" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-170672" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170672" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1+\\operatorname{cos}⁡s\\operatorname{cos}⁡t"] ["math" "1+\\operatorname{sin}⁡s\\operatorname{sin}⁡t"] ["math" "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{cos}⁡s\\operatorname{cos}⁡t"] ["math" "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{cos}⁡s\\operatorname{sin}⁡t"] ["math" "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170672" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{cos}^{2}⁡t-{sin}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37138" "field" nil "attribute" "question/problem" "value" "Let $f(x,y)=x{y}^{2}-2y,$ where $x=s{t}^{2}$ and $y={s}^{3}-t.$ Calculate $\\frac{∂f}{∂s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37138" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}={y}^{2},\\,\\frac{∂f}{∂y}=2xy-2\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =({s}^{3}-t)^{2}={s}^{6}-2{s}^{3}t+{t}^{2}, \\\\ \\frac{∂f}{∂y} & =2(s{t}^{2})({s}^{3}-t)-2=2{s}^{4}{t}^{2}-2s{t}^{3}-2.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & ={t}^{2}, \\\\ \\frac{∂y}{∂s} & =3{s}^{2}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =({s}^{6}-2{s}^{3}t+{t}^{2})({t}^{2})+(2{s}^{4}{t}^{2}-2s{t}^{3}-2)(3{s}^{2}) \\\\  & ={s}^{6}{t}^{2}-2{s}^{3}{t}^{3}+{t}^{4}+6{s}^{6}{t}^{2}-6{s}^{3}{t}^{3}-6{s}^{2} \\\\  & =7{s}^{6}{t}^{2}-8{s}^{3}{t}^{3}-6{s}^{2}+{t}^{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37138" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-37138" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37138" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3{s}^{6}{t}^{2}-6{s}^{2}+{t}^{4}"] ["math" "4{s}^{3}{t}^{3}-5{s}^{2}+2{t}^{4}"] ["math" "7{s}^{3}{t}^{2}-4{s}^{3}{t}^{3}-6s"] ["math" "7{s}^{5}{t}^{2}+2{s}^{3}{t}^{3}-6{s}^{2}+4{t}^{2}"] ["math" "7{s}^{6}{t}^{2}-8{s}^{3}{t}^{3}-6{s}^{2}+{t}^{4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37138" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "7{s}^{6}{t}^{2}-8{s}^{3}{t}^{3}-6{s}^{2}+{t}^{4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37205" "field" nil "attribute" "question/problem" "value" "Let $f(x,y)=2x+xy,$ where $x=s{e}^{s}$ and $y=t{e}^{s}.$ Calculate $\\frac{∂f}{∂t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37205" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2+y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2+t{e}^{s}, \\\\ \\frac{∂f}{∂y} & =s{e}^{s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =0, \\\\ \\frac{∂y}{∂t} & ={e}^{s}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =(2+t{e}^{s})(0)+(s{e}^{s})({e}^{s}) \\\\  & =s{e}^{2s}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37205" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-37205" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37205" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "st{e}^{s}"] ["math" "s{e}^{2s}"] ["math" "s{e}^{st}"] ["math" "t{e}^{2s}"] ["math" "t{e}^{st}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-37205" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "s{e}^{2s}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94816" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=\\operatorname{ln}⁡x-2{e}^{y}+4z,$ where $x=t{s}^{2},$ $y=\\operatorname{ln}⁡({t}^{2}+{s}^{2})$ and $z={s}^{2}.$ Calculate $\\frac{∂f}{∂s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94816" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/be6afcdd0ad9ae0d7ef377c4918442a64e1186c90c25e27ec6c224d816a602fd.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{x},\\,\\frac{∂f}{∂y}=-2{e}^{y},\\,\\frac{∂f}{∂z}=4.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{t{s}^{2}}, \\\\ \\frac{∂f}{∂y} & =-2{e}^{\\operatorname{ln}⁡({t}^{2}+{s}^{2})}=-2({t}^{2}+{s}^{2}), \\\\ \\frac{∂f}{∂z} & =4.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =2ts, \\\\ \\frac{∂y}{∂s} & =\\frac{2s}{{t}^{2}+{s}^{2}}, \\\\ \\frac{∂z}{∂s} & =2s.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =(\\frac{1}{t{s}^{2}})\\cdot 2ts+(-2({t}^{2}+{s}^{2}))\\cdot (\\frac{2s}{{t}^{2}+{s}^{2}})+(4)\\cdot 2s \\\\  & =\\frac{2}{s}-4s+8s \\\\  & =\\frac{2}{s}+4s \\\\  & =\\frac{2(1+2{s}^{2})}{s}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94816" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-94816" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94816" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1+{t}^{2}}{s}"] ["math" "\\frac{2(1+2{s}^{2})}{s}"] ["math" "\\frac{st+1}{2}"] ["math" "\\frac{{t}^{2}-{s}^{2}}{s}"] ["math" "st({s}^{2}{t}^{2}+1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94816" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2(1+2{s}^{2})}{s}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94812" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=xyz,$ where $x=2,$ $y=s{e}^{t}$ and $z=t{e}^{s}.$ Calculate $\\frac{∂f}{∂t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94812" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=yz,\\,\\frac{∂f}{∂y}=xz,\\,\\frac{∂f}{∂z}=xy.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =ts{e}^{t+s}, \\\\ \\frac{∂f}{∂y} & =2t{e}^{s}, \\\\ \\frac{∂f}{∂z} & =2s{e}^{t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =0, \\\\ \\frac{∂y}{∂t} & =s{e}^{t}, \\\\ \\frac{∂z}{∂t} & ={e}^{s}.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(ts{e}^{t+s})\\cdot 0+(2t{e}^{s})\\cdot s{e}^{t}+(2s{e}^{t})\\cdot {e}^{s} \\\\  & =2ts{e}^{t+s}+2s{e}^{t+s} \\\\  & =2s(t+1){e}^{t+s}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94812" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-94812" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94812" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2(t+s){e}^{t+s}"] ["math" "2s(t+1){e}^{t+s}"] ["math" "2t(s+1){e}^{t+s}"] ["math" "4(t-s){e}^{t+s}"] ["math" "4t(s-1){e}^{t+s}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94812" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2s(t+1){e}^{t+s}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94811" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=3x-2y+z,$ where $x=s+t,$ $y={s}^{2}-{t}^{2}$ and $z=s.$ Calculate $\\frac{∂f}{∂t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94811" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}.\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=3,\\,\\frac{∂f}{∂y}=-2,\\,\\frac{∂f}{∂z}=1.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =-2t, \\\\ \\frac{∂z}{∂t} & =0.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(3)\\cdot 1+(-2)\\cdot (-2t)+(1)\\cdot 0 \\\\  & =4t+3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94811" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-94811" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94811" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2s-1"] ["math" "2t-s-3"] ["math" "4t+3"] ["math" "5t+4s-1"] ["math" "8t-s"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94811" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4t+3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94814" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=4x+3y-2z,$ where $x=2{s}^{2}-t,$ $y=s+3{t}^{2}$ and $z=4{s}^{2}+{t}^{2}.$ Calculate $\\frac{∂f}{∂s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94814" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/be6afcdd0ad9ae0d7ef377c4918442a64e1186c90c25e27ec6c224d816a602fd.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=4,\\,\\frac{∂f}{∂y}=3,\\,\\frac{∂f}{∂z}=-2.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =4s, \\\\ \\frac{∂y}{∂s} & =1, \\\\ \\frac{∂z}{∂s} & =8s.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =(4)\\cdot 4s+(3)\\cdot 1+(-2)\\cdot 8s \\\\  & =16s+3-16s \\\\  & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94814" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-94814" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94814" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "2t-3s"] ["math" "3"] ["math" "3-8s"] ["math" "t+4s-1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-94814" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170675" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z)=\\frac{y+z}{x},$ where $x=s+t,$ $y={s}^{2}$ and $z={t}^{2}.$ Given that\n\n$$\n\\frac{∂f}{∂t}=\\frac{{c}_{1}{s}^{2}+{c}_{2}st+{c}_{3}{t}^{2}}{(s+t)^{2}},\n$$\n\nfind the value of ${c}_{1}+{c}_{2}+{c}_{3}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170675" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{y+z}{{x}^{2}},\\,\\frac{∂f}{∂y}=\\frac{1}{x},\\,\\frac{∂f}{∂z}=\\frac{1}{x}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{1}{s+t}, \\\\ \\frac{∂f}{∂z} & =\\frac{1}{s+t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =0, \\\\ \\frac{∂z}{∂t} & =2t.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}\\cdot (1)+\\frac{1}{s+t}\\cdot 0+\\frac{1}{s+t}\\cdot 2t \\\\  & =\\frac{-({s}^{2}+{t}^{2})+2t(s+t)}{(s+t)^{2}} \\\\  & =\\frac{{t}^{2}+2ts-{s}^{2}}{(s+t)^{2}}.\\end{aligned}\n$$\n\nFinally, ${c}_{1}=-1,$ ${c}_{2}=2$ and ${c}_{3}=1,$ and therefore\n\n$$\n{c}_{1}+{c}_{2}+{c}_{3}=-1+2+1=2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170675" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/activity-metadata.json" "file_sha256" "98b160c10487cbedb9146458bcd5d5ded1999782677c755a1ecf520a695aa7f5"} {"question" "q-170675" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170675" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "0"] ["math" "1"] ["math" "2"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "q-170675" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/state.json" "file_sha256" "4837d5d5a9fd38e6f44dd3455b627940da966c684a02a06e14434106b7853042"} {"question" "e-8256" "field" nil "attribute" "question/problem" "value" "If $f(x,y)=\\cos(xy), x=t,$ and $y=e^t,$ compute $\\dfrac{\\textrm{d}f}{\\textrm{d}t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8256.json" "file_sha256" "8652182eeb84604e68e9b61b40780d0036620a1c3cb876f02f11d293d5c734df"} {"question" "e-8256" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x = x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}t} \n= \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\textrm{d}x}{\\textrm{d}t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-y\\operatorname{sin}⁡(xy),\\,\\frac{∂f}{∂y}=-x\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-{e}^{t}\\operatorname{sin}⁡(t{e}^{t}), \\\\ \\frac{∂f}{∂y} & =-t\\operatorname{sin}⁡(t{e}^{t}).\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=1,\\,\\frac{\\text{d}y}{\\text{d}t}={e}^{t}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =[-{e}^{t}\\operatorname{sin}⁡(t{e}^{t})]\\cdot 1+[-t\\operatorname{sin}⁡(t{e}^{t})]\\cdot {e}^{t} \\\\  & =-{e}^{t}\\operatorname{sin}⁡(t{e}^{t})-t{e}^{t}\\operatorname{sin}⁡(t{e}^{t}) \\\\  & =-(1+t){e}^{t}\\operatorname{sin}⁡(t{e}^{t}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8256.json" "file_sha256" "8652182eeb84604e68e9b61b40780d0036620a1c3cb876f02f11d293d5c734df"} {"question" "e-8257" "field" nil "attribute" "question/problem" "value" "If $f(x,y) = 2\\sqrt{x+y}$ and $y=\\cos x,$ compute $\\dfrac{\\textrm{d}f}{\\textrm{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8257.json" "file_sha256" "5a2b7a4e357ec33a2baad35f9496881450c88efeef1edbaed357cf20ebbc6097"} {"question" "e-8257" "field" nil "attribute" "question/worked-solution" "value" "The chain rule for a multivariable function $f(x,y)$ in the case where $y = y(x)$ can be expressed as follows:\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}x} = \\dfrac{\\partial f}{\\partial x} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}x}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{\\sqrt{x+y}},\\,\\frac{∂f}{∂y}=\\frac{1}{\\sqrt{x+y}}\\end{aligned}\n$$\n\nWriting the above results in terms of $x,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{∂f}{∂y} & =\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}.\\end{aligned}\n$$\n\nNext, we take the derivative $y$ with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =-\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nFinally, putting the derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}x} & =\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}+\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}\\cdot (-\\operatorname{sin}⁡x) \\\\  & =\\frac{1}{\\sqrt{x+\\operatorname{cos}⁡x}}-\\frac{\\operatorname{sin}⁡x}{\\sqrt{x+\\operatorname{cos}⁡x}} \\\\  & =\\frac{1-\\operatorname{sin}⁡x}{\\sqrt{x+\\operatorname{cos}⁡x}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8257.json" "file_sha256" "5a2b7a4e357ec33a2baad35f9496881450c88efeef1edbaed357cf20ebbc6097"} {"question" "e-8258" "field" nil "attribute" "question/problem" "value" "Let $f(x,y) = x^2 + y^2,$ where $x = s\\cos{t}$ and $y = t\\sin{s}.$ Calculate $\\dfrac{\\partial f}{\\partial t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8258.json" "file_sha256" "a61eedef40821a49ef83c0ee451f3acf21a0b68267778ea1f149f849ec297aaa"} {"question" "e-8258" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y = y(s,t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\partial y}{\\partial t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=2y\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2s\\operatorname{cos}⁡t, \\\\ \\frac{∂f}{∂y} & =2t\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =-s\\operatorname{sin}⁡t, \\\\ \\frac{∂y}{∂t} & =\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =(2s\\operatorname{cos}⁡t)(-s\\operatorname{sin}⁡t)+(2t\\operatorname{sin}⁡s)(\\operatorname{sin}⁡s) \\\\  & =-2{s}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2t{sin}^{2}⁡s \\\\  & =2t{sin}^{2}⁡s-2{s}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =2t{sin}^{2}⁡s-{s}^{2}\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nNotice that we used the identity $\\sin 2t = 2\\sin t\\cos t$ in the above simplification." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8258.json" "file_sha256" "a61eedef40821a49ef83c0ee451f3acf21a0b68267778ea1f149f849ec297aaa"} {"question" "e-8259" "field" nil "attribute" "question/problem" "value" "Let $f(x,y,z) = e^{xy + z},$ where $x = s + t,$ $y = s-t$ and $z = -s^2.$ Calculate $\\dfrac{\\partial f}{\\partial t}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8259.json" "file_sha256" "17b672300cd9afabc81484c58c2c01906d8af0638f750d775a2f6e1758a196ee"} {"question" "e-8259" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t), y = y(s,t)$ and $z = z(s,t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\partial y}{\\partial t} + \\dfrac{\\partial f}{\\partial z}\\cdot \\dfrac{\\partial z}{\\partial t}.\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x, y$ and $z\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y{e}^{xy+z},\\,\\frac{∂f}{∂y}=x{e}^{xy+z},\\,\\frac{∂f}{∂z}={e}^{xy+z}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =(s-t){e}^{(s+t)(s-t)-{s}^{2}}=(s-t){e}^{-{t}^{2}}, \\\\ \\frac{∂f}{∂y} & =(s+t){e}^{(s+t)(s-t)-{s}^{2}}=(s+t){e}^{-{t}^{2}}, \\\\ \\frac{∂f}{∂z} & ={e}^{(s+t)(s-t)-{s}^{2}}={e}^{-{t}^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =-1, \\\\ \\frac{∂z}{∂t} & =0.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(s-t){e}^{-{t}^{2}}\\cdot 1+(s+t){e}^{-{t}^{2}}\\cdot (-1)+{e}^{-{t}^{2}}\\cdot 0 \\\\  & =(s-t-s-t){e}^{-{t}^{2}} \\\\  & =-2t{e}^{-{t}^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14059013/example-8259.json" "file_sha256" "17b672300cd9afabc81484c58c2c01906d8af0638f750d775a2f6e1758a196ee"}] "usage" {"q-170675" [] "q-95088" [] "e-8256" [] "q-95121" [] "q-37205" [] "q-37138" [] "q-94816" [] "q-94588" [] "e-8258" [] "q-170672" [] "q-95122" [] "e-8257" [] "q-94814" [] "e-8259" [] "q-94812" [] "q-95084" [] "q-170673" []} "basis" 1888 "retractions" [[17592186323453 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/7e5b5001794ecdf2c9b9e9102f334a63d2c59bc6f7511c2eb7fa358fc94cb0c5.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $s,$ where $x=x(s)$ and $y=y(s),$ can be expressed as follows:\n\n$$\n\\frac{\\text{d}f}{\\text{d}s}=\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{y},\\,\\frac{∂f}{∂y}=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nWriting the above results in terms of $s,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{\\operatorname{sin}⁡2s}, \\\\ \\frac{∂f}{∂y} & =-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}s}=-2\\operatorname{sin}⁡2s,\\,\\frac{\\text{d}y}{\\text{d}s}=2\\operatorname{cos}⁡2s.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}s} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}s}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}s} \\\\  & =\\frac{1}{\\operatorname{sin}⁡2s}\\cdot (-2\\operatorname{sin}⁡2s)+(-\\frac{\\operatorname{cos}⁡2s}{{sin}^{2}⁡2s})\\cdot 2\\operatorname{cos}⁡2s \\\\  & =-2-2\\cdot \\frac{{cos}^{2}⁡2s}{{sin}^{2}⁡2s} \\\\  & =-2-2{cot}^{2}⁡2s \\\\  & =-2{csc}^{2}⁡2s.\\end{aligned}\n$$"] [17592186167270 :question/problem "If $f(x, y) = x\\ln (x + y)$ and $y = x^{2}$, compute $\\frac{df}{dx}$."] [17592186167270 :question/worked-solution "The partial derivatives are $f_x=\\ln(x+y)+x/(x+y)$ and $f_y=x/(x+y)$. Since $dy/dx=2x$, $$\\frac{df}{dx}=\\ln(x+x^2)+\\frac{x+2x^2}{x+x^2}=\\ln(x+x^2)+\\frac{1+2x}{1+x},$$ on the domain $x+x^2>0$."] [17592186167270 :question/difficulty 17592186045465] [17592186167265 :question/problem "If $f(x, y) = \\sin (x^{2} + y)$ and $y = x^{2}$, compute $\\frac{df}{dx}$."] [17592186167265 :question/worked-solution "Since $y=x^2$, the total derivative is $df/dx=f_x+f_y\\,dy/dx$. Here $f_x=2x\\cos(x^2+y)$, $f_y=\\cos(x^2+y)$, and $dy/dx=2x$. Thus $$\\frac{df}{dx}=2x\\cos(2x^2)+2x\\cos(2x^2)=4x\\cos(2x^2).$$"] [17592186323376 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y{e}^{x},\\,\\frac{∂f}{∂y}={e}^{x}\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =ts{e}^{t+s}, \\\\ \\frac{∂f}{∂y} & ={e}^{t+s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =1, \\\\ \\frac{∂y}{∂s} & =t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =(ts{e}^{t+s})(1)+({e}^{t+s})(t) \\\\  & =t{e}^{t+s}(s+1).\\end{aligned}\n$$"] [17592186323369 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\operatorname{sin}⁡t, \\\\ \\frac{∂f}{∂y} & =\\operatorname{cos}⁡t+\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =-\\operatorname{sin}⁡t, \\\\ \\frac{∂y}{∂t} & =\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =\\operatorname{sin}⁡t(-\\operatorname{sin}⁡t)+(\\operatorname{cos}⁡t+\\operatorname{sin}⁡s)\\cdot \\operatorname{cos}⁡t \\\\  & =-{sin}^{2}⁡t+{cos}^{2}⁡t+\\operatorname{sin}⁡s\\operatorname{cos}⁡t.\\end{aligned}\n$$"] [17592186323397 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/21cec766fe72965697304ef4288ffb2b090ddfca179210165dbcfd42ec490b27.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}={y}^{2},\\,\\frac{∂f}{∂y}=2xy-2\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =({s}^{3}-t)^{2}={s}^{6}-2{s}^{3}t+{t}^{2}, \\\\ \\frac{∂f}{∂y} & =2(s{t}^{2})({s}^{3}-t)-2=2{s}^{4}{t}^{2}-2s{t}^{3}-2.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & ={t}^{2}, \\\\ \\frac{∂y}{∂s} & =3{s}^{2}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =({s}^{6}-2{s}^{3}t+{t}^{2})({t}^{2})+(2{s}^{4}{t}^{2}-2s{t}^{3}-2)(3{s}^{2}) \\\\  & ={s}^{6}{t}^{2}-2{s}^{3}{t}^{3}+{t}^{4}+6{s}^{6}{t}^{2}-6{s}^{3}{t}^{3}-6{s}^{2} \\\\  & =7{s}^{6}{t}^{2}-8{s}^{3}{t}^{3}-6{s}^{2}+{t}^{4}.\\end{aligned}\n$$"] [17592186167249 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y=y(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2+y,\\,\\frac{∂f}{∂y}=x\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2+t{e}^{s}, \\\\ \\frac{∂f}{∂y} & =s{e}^{s}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =0, \\\\ \\frac{∂y}{∂t} & ={e}^{s}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =(2+t{e}^{s})(0)+(s{e}^{s})({e}^{s}) \\\\  & =s{e}^{2s}.\\end{aligned}\n$$"] [17592186323425 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/be6afcdd0ad9ae0d7ef377c4918442a64e1186c90c25e27ec6c224d816a602fd.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂s}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂s}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=\\frac{1}{x},\\,\\frac{∂f}{∂y}=-2{e}^{y},\\,\\frac{∂f}{∂z}=4.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{1}{t{s}^{2}}, \\\\ \\frac{∂f}{∂y} & =-2{e}^{\\operatorname{ln}⁡({t}^{2}+{s}^{2})}=-2({t}^{2}+{s}^{2}), \\\\ \\frac{∂f}{∂z} & =4.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $s,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂s} & =2ts, \\\\ \\frac{∂y}{∂s} & =\\frac{2s}{{t}^{2}+{s}^{2}}, \\\\ \\frac{∂z}{∂s} & =2s.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =(\\frac{1}{t{s}^{2}})\\cdot 2ts+(-2({t}^{2}+{s}^{2}))\\cdot (\\frac{2s}{{t}^{2}+{s}^{2}})+(4)\\cdot 2s \\\\  & =\\frac{2}{s}-4s+8s \\\\  & =\\frac{2}{s}+4s \\\\  & =\\frac{2(1+2{s}^{2})}{s}.\\end{aligned}\n$$"] [17592186323411 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=yz,\\,\\frac{∂f}{∂y}=xz,\\,\\frac{∂f}{∂z}=xy.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =ts{e}^{t+s}, \\\\ \\frac{∂f}{∂y} & =2t{e}^{s}, \\\\ \\frac{∂f}{∂z} & =2s{e}^{t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =0, \\\\ \\frac{∂y}{∂t} & =s{e}^{t}, \\\\ \\frac{∂z}{∂t} & ={e}^{s}.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(ts{e}^{t+s})\\cdot 0+(2t{e}^{s})\\cdot s{e}^{t}+(2s{e}^{t})\\cdot {e}^{s} \\\\  & =2ts{e}^{t+s}+2s{e}^{t+s} \\\\  & =2s(t+1){e}^{t+s}.\\end{aligned}\n$$"] [17592186167267 :question/problem "Let $f(x, y, z) = 4x + 3y - 2z$, where $x = 2s^{2} - t$, $y = s + 3t^{2}$ and $z = 4s^{2} + t^{2}$. Calculate $\\frac{\\partial f}{\\partial s}$."] [17592186167267 :question/worked-solution "The partial derivatives of $f$ are $f_x=4$, $f_y=3$, $f_z=-2$. Holding $t$ fixed gives $x_s=4s$, $y_s=1$, and $z_s=8s$. Therefore $$f_s=4(4s)+3(1)-2(8s)=3.$$"] [17592186167267 :question/difficulty 17592186045463] [17592186323383 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t),y=y(s,t)$ and $z=z(s,t),$ can be expressed as follows:\n\n$$\n\\frac{∂f}{∂t}=\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t}+\\frac{∂f}{∂z}\\cdot \\frac{∂z}{∂t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x,y$ and $z:$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-\\frac{y+z}{{x}^{2}},\\,\\frac{∂f}{∂y}=\\frac{1}{x},\\,\\frac{∂f}{∂z}=\\frac{1}{x}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}, \\\\ \\frac{∂f}{∂y} & =\\frac{1}{s+t}, \\\\ \\frac{∂f}{∂z} & =\\frac{1}{s+t}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =0, \\\\ \\frac{∂z}{∂t} & =2t.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =-\\frac{{s}^{2}+{t}^{2}}{(s+t)^{2}}\\cdot (1)+\\frac{1}{s+t}\\cdot 0+\\frac{1}{s+t}\\cdot 2t \\\\  & =\\frac{-({s}^{2}+{t}^{2})+2t(s+t)}{(s+t)^{2}} \\\\  & =\\frac{{t}^{2}+2ts-{s}^{2}}{(s+t)^{2}}.\\end{aligned}\n$$\n\nFinally, ${c}_{1}=-1,$ ${c}_{2}=2$ and ${c}_{3}=1,$ and therefore\n\n$$\n{c}_{1}+{c}_{2}+{c}_{3}=-1+2+1=2.\n$$"] [17592186166517 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/f01b253f560405a8c0f4be8f8797c652fb0ddf774f4db110b8822313b8ac50f3.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with one independent variable $t,$ where $x = x(t)$ and $y=y(t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\textrm{d}f}{\\textrm{d}t} \n= \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\textrm{d}x}{\\textrm{d}t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=-y\\operatorname{sin}⁡(xy),\\,\\frac{∂f}{∂y}=-x\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nWriting the above results in terms of $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =-{e}^{t}\\operatorname{sin}⁡(t{e}^{t}), \\\\ \\frac{∂f}{∂y} & =-t\\operatorname{sin}⁡(t{e}^{t}).\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t}=1,\\,\\frac{\\text{d}y}{\\text{d}t}={e}^{t}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}f}{\\text{d}t} & =\\frac{∂f}{∂x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{∂f}{∂y}\\cdot \\frac{\\text{d}y}{\\text{d}t} \\\\  & =[-{e}^{t}\\operatorname{sin}⁡(t{e}^{t})]\\cdot 1+[-t\\operatorname{sin}⁡(t{e}^{t})]\\cdot {e}^{t} \\\\  & =-{e}^{t}\\operatorname{sin}⁡(t{e}^{t})-t{e}^{t}\\operatorname{sin}⁡(t{e}^{t}) \\\\  & =-(1+t){e}^{t}\\operatorname{sin}⁡(t{e}^{t}).\\end{aligned}\n$$"] [17592186166519 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/118759b163a4410f66d5855d7b7b1fd9c2ee4be585e778a759997036bd95f765.png)\n\nThe chain rule for a multivariable function $f(x,y)$ with two independent variables $s$ and $t,$ where $x=x(s,t)$ and $y = y(s,t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\partial y}{\\partial t}\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x$ and $y{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=2x,\\,\\frac{∂f}{∂y}=2y\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =2s\\operatorname{cos}⁡t, \\\\ \\frac{∂f}{∂y} & =2t\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x$ and $y$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =-s\\operatorname{sin}⁡t, \\\\ \\frac{∂y}{∂t} & =\\operatorname{sin}⁡s.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂t}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂t} \\\\  & =(2s\\operatorname{cos}⁡t)(-s\\operatorname{sin}⁡t)+(2t\\operatorname{sin}⁡s)(\\operatorname{sin}⁡s) \\\\  & =-2{s}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t+2t{sin}^{2}⁡s \\\\  & =2t{sin}^{2}⁡s-2{s}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =2t{sin}^{2}⁡s-{s}^{2}\\operatorname{sin}⁡2t.\\end{aligned}\n$$\n\nNotice that we used the identity $\\sin 2t = 2\\sin t\\cos t$ in the above simplification."] [17592186166520 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044606/assets/b593a1b60fe8c1aef2c5c229ff426db350e6296b9ecb767494283f0fa3342072.png)\n\nThe chain rule for a multivariable function $f(x,y,z)$ with two independent variables $s$ and $t,$ where $x=x(s,t), y = y(s,t)$ and $z = z(s,t),$ can be expressed as follows:\n\n$$\n\\dfrac{\\partial f}{\\partial t} = \\dfrac{\\partial f}{\\partial x}\\cdot \\dfrac{\\partial x}{\\partial t} + \\dfrac{\\partial f}{\\partial y}\\cdot \\dfrac{\\partial y}{\\partial t} + \\dfrac{\\partial f}{\\partial z}\\cdot \\dfrac{\\partial z}{\\partial t}.\n$$\n\nFirst, we find the partial derivatives of $f$ with respect to $x, y$ and $z\\mathbin{:}$ \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}=y{e}^{xy+z},\\,\\frac{∂f}{∂y}=x{e}^{xy+z},\\,\\frac{∂f}{∂z}={e}^{xy+z}.\\end{aligned}\n$$\n\nWriting the above results in terms of $s$ and $t,$ we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =(s-t){e}^{(s+t)(s-t)-{s}^{2}}=(s-t){e}^{-{t}^{2}}, \\\\ \\frac{∂f}{∂y} & =(s+t){e}^{(s+t)(s-t)-{s}^{2}}=(s+t){e}^{-{t}^{2}}, \\\\ \\frac{∂f}{∂z} & ={e}^{(s+t)(s-t)-{s}^{2}}={e}^{-{t}^{2}}.\\end{aligned}\n$$\n\nNext, we take the derivatives of $x,$ $y,$ and $z$ with respect to $t,$ and we get\n\n$$\n\\begin{aligned}\\frac{∂x}{∂t} & =1, \\\\ \\frac{∂y}{∂t} & =-1, \\\\ \\frac{∂z}{∂t} & =0.\\end{aligned}\n$$\n\nSubstituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂t} & =(s-t){e}^{-{t}^{2}}\\cdot 1+(s+t){e}^{-{t}^{2}}\\cdot (-1)+{e}^{-{t}^{2}}\\cdot 0 \\\\  & =(s-t-s-t){e}^{-{t}^{2}} \\\\  & =-2t{e}^{-{t}^{2}}.\\end{aligned}\n$$"]] "immutable_answers" [17592186165044 17592186165045 17592186165046 17592186165047 17592186165048 17592186165140 17592186165141 17592186165142 17592186165143 17592186165144 17592186165152 17592186165153 17592186165154 17592186165155 17592186165156 17592186165170 17592186165171 17592186165172 17592186165173 17592186165174 17592186323371 17592186323372 17592186323373 17592186323374 17592186323375 17592186323378 17592186323379 17592186323380 17592186323381 17592186323382 17592186323385 17592186323386 17592186323387 17592186323388 17592186323389 17592186323399 17592186323400 17592186323401 17592186323402 17592186323403 17592186323413 17592186323414 17592186323415 17592186323416 17592186323417 17592186323427 17592186323428 17592186323429 17592186323430 17592186323431 17592186323455 17592186323456 17592186323457 17592186323458 17592186323459 17592186323462 17592186323463 17592186323464 17592186323465 17592186323466 17592186323483 17592186323484 17592186323485 17592186323486 17592186323487] "immutable_fields" [[17592186165043 :answer-field/correct] [17592186165043 :answer-field/id] [17592186165043 :answer-field/key] [17592186165043 :answer-field/type] [17592186165139 :answer-field/correct] [17592186165139 :answer-field/id] [17592186165139 :answer-field/key] [17592186165139 :answer-field/type] [17592186165151 :answer-field/correct] [17592186165151 :answer-field/id] [17592186165151 :answer-field/key] [17592186165151 :answer-field/type] [17592186165169 :answer-field/correct] [17592186165169 :answer-field/id] [17592186165169 :answer-field/key] [17592186165169 :answer-field/type] [17592186323370 :answer-field/correct] [17592186323370 :answer-field/id] [17592186323370 :answer-field/key] [17592186323370 :answer-field/type] [17592186323377 :answer-field/correct] [17592186323377 :answer-field/id] [17592186323377 :answer-field/key] [17592186323377 :answer-field/type] [17592186323384 :answer-