\ \\frac{∂y}{∂s} & =-t{e}^{-st}.\\end{aligned}\n$$\n\nFinally, substituting all of our derivatives into the multivariable chain rule, we get\n\n$$\n\\begin{aligned}\\frac{∂f}{∂s} & =\\frac{∂f}{∂x}\\cdot \\frac{∂x}{∂s}+\\frac{∂f}{∂y}\\cdot \\frac{∂y}{∂s} \\\\  & =(-{e}^{-2st})(t{e}^{st})+(-{e}^{2st})(-t{e}^{-st}) \\\\  & =t{e}^{st}-t{e}^{-st} \\\\  & =t({e}^{st}-{e}^{-st}).\\end{aligned}\n$$" 13194139535201 true] [17592186337183 1000 #edb/ref 17592186337184 13194139535201 true] [17592186337183 1000 #edb/ref 17592186337185 13194139535201 true] [17592186337183 1000 #edb/ref 17592186337186 13194139535201 true] [17592186337183 1000 #edb/ref 17592186337187 13194139535201 true] [17592186337183 1000 #edb/ref 17592186337188 13194139535201 true] [17592186337183 1040 #edb/ref 17592186045450 13194139535201 true] [17592186337183 1041 "selection" 13194139535201 true] [17592186337183 1104 #edb/ref 17592186337186 13194139535201 true] [17592186337183 1110 #uuid "97f83934-c065-5d6e-b769-2db25e1663f9" 13194139535201 true] [17592186337184 1034 "2t{e}^{st}" 13194139535201 true] [17592186337184 1103 #edb/ref 17592186045453 13194139535201 true] [17592186337184 1111 #uuid "38252138-248d-5fc1-8988-a3ff2efa765a" 13194139535201 true] [17592186337185 1034 "2t" 13194139535201 true] [17592186337185 1103 #edb/ref 17592186045453 13194139535201 true] [17592186337185 1111 #uuid "2eaefb92-722a-5398-b368-816bb03c8e1d" 13194139535201 true] [17592186337186 1034 "t({e}^{st}-{e}^{-st})" 13194139535201 true] [17592186337186 1103 #edb/ref 17592186045453 13194139535201 true] [17592186337186 1111 #uuid "15f476e0-2b06-5912-9ee4-083657a9e6ac" 13194139535201 true] [17592186337187 1034 "2t{e}^{-st}" 13194139535201 true] [17592186337187 1103 #edb/ref 17592186045453 13194139535201 true] [17592186337187 1111 #uuid "bf607762-cc10-5ab7-8db3-61ffc1f90228" 13194139535201 true] [17592186337188 1034 "t({e}^{2st}+{e}^{-2st})" 13194139535201 true] [17592186337188 1103 #edb/ref 17592186045453 13194139535201 true] [1759218633