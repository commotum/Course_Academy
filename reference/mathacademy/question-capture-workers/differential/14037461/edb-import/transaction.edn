[{:db/id "q-331241/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "1252ce95-fa2e-5429-aa4b-6ab8de56fa9f" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-331241/field-1" :answer-field/id #uuid "59b10ae5-1793-534c-a62e-8f1aa93d25eb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331241/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-331241/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-331241" :question/id #uuid "cc68feee-fb89-5243-affc-7ae2fc3e66f4" :question/math-academy-id "q-331241" :question/problem "Evaluate $f(t)=4u(t-6)$ at $t=6,$ where $u$ is the unit step function.\n\n$f(t)=$\n{{field-1}}" :question/worked-solution "The unit step function $u(t)$ is defined as\n\n$$\nu(t)={\\begin{aligned}1,\\,t\\ge 0, \\\\ 0,\\,t<0.\\end{aligned}\n$$\n\nEvaluating $f(t)$ at $t=6,$ we have\n\n$$\n\\begin{aligned}f(6) & =4u(6-6) \\\\  & =4u(0) \\\\  & =4\\cdot 1 \\\\  & =4.\\end{aligned}\n$$\n\nTherefore, $f(6)=4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331241/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b24db328-4a49-5002-b0af-635d0c0d89b9"] :knowledge-point/questions ["q-331241"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331240/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "00fee0db-80f5-5054-968c-11d6baa890fe" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-331240/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "00ebe170-f194-51c9-9e75-4644f230f4c9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-331240/field-1" :answer-field/id #uuid "a6a03346-10de-50f6-b061-f09d3