899a-5fab-b636-330f30d9b6b3" :answer/type {:db/ident :answer.type/math} :answer/value "u(t)+2" :db/id #edb/ref 17592186305222} {:answer/id #uuid "01c3e480-50fa-5b27-ae2e-79eb7fbb78df" :answer/type {:db/ident :answer.type/math} :answer/value "u(-t)-2" :db/id #edb/ref 17592186305223}] :answer-field/correct {:answer/id #uuid "399df03a-7d3a-50a3-9e4d-7a1550dc5c28" :answer/type {:db/ident :answer.type/math} :answer/value "u(-t)+2" :db/id #edb/ref 17592186305219} :answer-field/id #uuid "5477697a-7e6b-5da9-9c14-686c2cc7fa92" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305218}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2b4630c6-774a-5630-a5a8-e2eb7c645f36" :question/math-academy-id "q-352909" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037461/assets/921338bafb4c56c560502d2ec526703031b0261a5f9c71fcdd0d44058920787e.png)\n\nThe graph of $y=f(t)$ is shown above. Which of the following could be $f(t),$ where $u$ denotes the unit step function?" :question/worked-solution "The unit step function $u(t)$ is defined as\n\n$$\nu(t)={\\begin{aligned}1,\\,t\\ge 0, \\\\ 0,\\,t<0.\\end{aligned}\n$$\n\nThe graph of $y=u(t)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037461/assets/f5b06b3481472b5be7f4d71da1df3192962c383059a1e7fb36f98426058738ae.png)\n\nNotice that to transform $y=u(t)$ to the given function $y=f(t),$ we perform the following transformations:\n\n- First, we reflect $y=u(t)$ in the $y$-axis, which gives $y=u(-t).$\n\n- Next, we shift $y=u(-t)$ vertically upwards by $2$ units, giving $y=u(-t)+2.$\n\n- There is no horizontal shift or vertical scaling.\n\nTherefore, we conclude that $f(t)=u(-t)+2.$"}] [{:db/id #edb/ref 17592186305224 :knowledge-point/_questions [{:knowledge-point/id #uuid "253b1011-a313-5004-8cbe-61133586e6b1" :knowledge-point/title "Graphs of Reflected Step Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7fdc02a9-319f-5569-9179-6b22217cb403" :answer/type {:db/ident :answer.type/math} :answer/value "4u(-t-1)" :db/id #edb/ref 17592186305226} {:answer/id #uuid "7c1ca700-3e92-5abe-bae1-2cbae5f0c114" :answer/type {:db/ident :answer.type/math} :answer/value "4u(1-t)" :db/id #edb/ref 17592186305227} {:answer/id #uuid "f9fc6036-4974-5fa5-85cc-3731147a9069" :answer/type {:db/ident :answer.type/math} :answer/value "u(-t-4)" :db/id #edb/ref 17592186305228} {:answer/id #uuid "6a7a254d-3bc2-5a66-aa4d-2b8d893cfa3e" :answer/type {:db/ident :answer.type/math} :answer/value "4u(t+1)" :db/id #edb/ref 17592186305229} {:answer/id #uuid "1d23c7fd-6b81-5d63-9189-71d07cefec9e" :answer/type {:db/ident :answer.type/math} :answer/value "4u(t-1)" :db/id #edb/ref 17592186305230}] :answer-field/correct {:answer/id #uuid "7fdc02a9-319f-5569-9179-6b22217cb403" :answer/type {:db/ident :answer.type/math} :answer/value "4u(-t-1)" :db/id #edb/ref 17592186305226} :answer-field/id #uuid "90b708d3-5b73-5ce5-9a05-689ca63f57f3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186305225}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "50c59d46-eaed-52e0-aa55-9b3dabc835b1" :question/math-academy-id "q-352913" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037461/assets/fe876b6075fa3e292595976c6d0077fec9c43b0af6a13c165abbd754fa7fcbe7.png)\n\nThe graph of $y=f(t)$ is shown above. Which of the following could be $f(t),$ where $u$ denotes the unit step function?" :question/worked-solution "The unit step function $u(t)$ is defined as\n\n$$\nu(t)={\\begin{aligned}1,\\,t\\ge 0, \\\\ 0,\\,t<0.\\end{aligned}\n$$\n\nThe graph of $y=u(t)$ is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037461/assets/385fe662259d5c933171b68f6b4b7227051921c3327da8f1ca10ff3bd6c5da3f.png)\n\nNotice that to transform the function $y=u(t)$ to the given function $y=f(t),$ we perform the following transformations:\n\n- First, we reflect $y=u(t)$ in the $y$-axis, which gives $y=u(-t).$\n\n- Next, we shift by one unit to the left, giving $y=u(-(t+1))=u(-t-1).$\n\n- Finally, we scale by a scale factor of $4$ parallel to the $y$-axis, giving $y=4u(-t-1).$\n\nTherefore, we conclude that $f(t)=4u(-t-1).$"}]}
