igned}0 \\\\ 1\\end{aligned}]{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFirst, we write our differential equation in matrix form:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}2 & 0 \\\\ 0 & -5\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nSince the matrix of the differential system is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-5t},\\,{c}_{1},{c}_{2}\\in R.\n$$"}] [{:db/id #edb/ref 17592186353967 :knowledge-point/_questions [{:knowledge-point/id #uuid "cec0e48f-9fbb-5ada-b7fd-0d389d1b7438" :knowledge-point/title "Solving an Initial Value Problem for a Decoupled Linear System of First-Order ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e22b9551-1e09-5698-a1cc-2b51e0b62ac4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}-3 \\\\ 0\\end{aligned}]{e}^{-\\sqrt{5}t}+[\\begin{aligned}0 \\\\ 6\\end{aligned}]{e}^{8t}" :db/id #edb/ref 17592186353969} {:answer/id #uuid "6c7c4b9b-c097-5350-8c33-40ed885488a5" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}-3 \\\\ 0\\end{aligned}]{e}^{8t}" :db/id #edb/ref 17592186353970} {:answer/id #uuid "1c03a1ad-0b0b-58e3-996c-3be326961baf" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ 6\\end{aligned}]{e}^{-\\sqrt{5}t}" :db/id #edb/ref 17592186353971} {:answer/id #uuid "62c3e270-cb53-555e-a5ee-40a73df6641c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}-3 \\\\ 0\\end{aligned}]{e}^{8t}+[\\begin{aligned}0 \\\\ 6\\end{aligned}]{e}^{-\\sqrt{5}t}" :db/id #edb/ref 17592186353972} {:answer/id #uuid "b8e72d98-15fa-55f0-9501-32d8088d03e6" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}3 \\\\ 0\\end{aligned}]{e}^{8t}+[\\begin{aligned}0 \\\\ 6\\end{aligned}]{e}^{-\\sqrt{5}t}" :db/id #edb/ref 17592186353973}] :answer-field/correct {:answer/id #uuid "62c3e270-cb53-555e-a5ee-40a73df6641c" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}-3 \\\\ 0\\end{aligned}]{e}^{8t}+[\\begin{aligned}0 \\\\ 6\\end{aligned}]{e}^{-\\sqrt{5}t}" :db/id #edb/ref 17592186353972} :answer-field/id #uuid "b80a2fe0-8080-5d8a-bda5-f8e404f61b63" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353968}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5620c47b-4e97-5ced-9381-5d5cc172acfd" :question/math-academy-id "q-332709" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}8 & 0 \\\\ 0 & -\\sqrt{5}\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}-3 \\\\ 6\\end{aligned}].\n$$" :question/worked-solution "We have a decoupled system. Therefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{8t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-\\sqrt{5}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}-3 \\\\ 6\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}x(0) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}-3 \\\\ 6\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =(-3)\\cdot [\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{8t}+6\\cdot [\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-\\sqrt{5}t} \\\\  & =[\\begin{aligned}-3 \\\\ 0\\end{aligned}]{e}^{8t}+[\\begin{aligned}0 \\\\ 6\\end{aligned}]{e}^{-\\sqrt{5}t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186167254 :knowledge-point/_questions [{:knowledge-point/id #uuid "cec0e48f-9fbb-5ada-b7fd-0d389d1b7438" :knowledge-point/title "Solving an Initial Value Problem for a Decoupled Linear System of First-Order ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30cb1421-5d08-5c47-b480-3fa8b22982fd" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ \\operatorname{ln}⁡(2)\\end{aligned}]+[\\begin{aligned}0 \\\\ 5\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353975} {:answer/id #uuid "d41f5296-e4cc-54d4-bb1d-338ba647fab7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}\\operatorname{ln}⁡(2) \\\\ 5\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353976} {:answer/id #uuid "6609ee33-982e-5188-9aee-abf75cfb9c74" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ 5\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353977} {:answer/id #uuid "b1a2a171-c124-5faf-af43-2b786ec7d8f7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ \\operatorname{ln}⁡(2)\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353978} {:answer/id #uuid "b3f36854-bad1-5cbb-8fda-af1558fd779d" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ 5\\end{aligned}]+[\\begin{aligned}\\operatorname{ln}⁡(2) \\\\ 5\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353979}] :answer-field/correct {:answer/id #uuid "6609ee33-982e-5188-9aee-abf75cfb9c74" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ 5\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353977} :answer-field/id #uuid "45b4ad32-c4dc-57a1-a337-899b51bbacd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353974}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f661d2d1-605b-537c-9525-c7b60f731250" :question/math-academy-id "q-39268" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}0 & 0 \\\\ 0 & \\operatorname{ln}⁡(2)\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}0 \\\\ 5\\end{aligned}].\n$$" :question/worked-solution "We have a decoupled system. Therefore, the general solution is given by\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{0t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\operatorname{ln}⁡(2)t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}0 \\\\ 5\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}x(0) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{0} \\\\ [\\begin{aligned}0 \\\\ 5\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =5[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t} \\\\  & =[\\begin{aligned}0 \\\\ 5\\end{aligned}]{2}^{t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353980 :knowledge-point/_questions [{:knowledge-point/id #uuid "cec0e48f-9fbb-5ada-b7fd-0d389d1b7438" :knowledge-point/title "Solving an Initial Value Problem for a Decoupled Linear System of First-Order ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e9bdb75-752e-5d54-8527-62a39c6d8706" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}e \\\\ 4\\end{aligned}]{2}^{-2t}" :db/id #edb/ref 17592186353982} {:answer/id #uuid "17b65272-8fd6-5e56-b64b-a0371b2b2cf3" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}e \\\\ 0\\end{aligned}]{e}^{5t}+[\\begin{aligned}0 \\\\ 4\\end{aligned}]{2}^{-2t}" :db/id #edb/ref 17592186353983} {:answer/id #uuid "4c02e2ac-4421-5b53-82c0-ad171c07d270" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ e\\end{aligned}]{e}^{5t}+[\\begin{aligned}4 \\\\ 0\\end{aligned}]{2}^{-2t}" :db/id #edb/ref 17592186353984} {:answer/id #uuid "0b199979-074c-5722-ba9c-06f9598c1d2a" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}e \\\\ 4\\end{aligned}]{e}^{5t}" :db/id #edb/ref 17592186353985} {:answer/id #uuid "c86f6434-47d6-51e2-a475-9ff5113a912b" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}e \\\\ 4e\\end{aligned}]5{e}^{2t}" :db/id #edb/ref 17592186353986}] :answer-field/correct {:answer/id #uuid "17b65272-8fd6-5e56-b64b-a0371b2b2cf3" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}e \\\\ 0\\end{aligned}]{e}^{5t}+[\\begin{aligned}0 \\\\ 4\\end{aligned}]{2}^{-2t}" :db/id #edb/ref 17592186353983} :answer-field/id #uuid "13e41a67-cbd9-53ff-a330-15d9bd48f947" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353981}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1d9f0640-7a67-5743-954f-f120eaaa869b" :question/math-academy-id "q-39731" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}5 & 0 \\\\ 0 & -2\\operatorname{ln}⁡(2)\\end{aligned}]x(t),\\,x(1)=[\\begin{aligned}{e}^{6} \\\\ 1\\end{aligned}].\n$$" :question/worked-solution "We have a decoupled system. Therefore, the general solution is given by\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{5t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2\\operatorname{ln}⁡(2)t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{5t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{({e}^{\\operatorname{ln}⁡(2)})}^{-2t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{5t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{-2t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(1)=[\\begin{aligned}{e}^{6} \\\\ 1\\end{aligned}].$ Substituting $t=1$ into the general solution, we get\n\n$$\n\\begin{aligned}x(1) & ={c}_{1}[\\begin{aligned}{e}^{5} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {2}^{-2}\\end{aligned}] \\\\ [\\begin{aligned}{e}^{6} \\\\ 1\\end{aligned}] & =[\\begin{aligned}{c}_{1}{e}^{5} \\\\ \\frac{{c}_{2}}{4}\\end{aligned}] \\\\ [\\begin{aligned}e \\\\ 4\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =e[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{5t}+4[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{-2t} \\\\  & =[\\begin{aligned}e \\\\ 0\\end{aligned}]{e}^{5t}+[\\begin{aligned}0 \\\\ 4\\end{aligned}]{2}^{-2t}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353987 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce35e5a9-2444-5e5f-9463-5a4d54496d9d" :knowledge-point/title "Finding the General Solution to a Decoupled Linear System of Differential Equations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be8ca9c1-e839-5a8a-8369-129f0f157da9" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-7t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186353989} {:answer/id #uuid "64a029c3-313a-5cac-aec3-cd9a8e9c1519" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{7t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186353990} {:answer/id #uuid "b1744cde-ec47-5405-a758-f28ddc201142" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{7t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186353991} {:answer/id #uuid "32172e5b-6d3c-5daa-9632-5a50b40dbf62" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186353992} {:answer/id #uuid "47c23e41-885c-59b5-851a-ecabe4190b3b" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{7t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186353993}] :answer-field/correct {:answer/id #uuid "b1744cde-ec47-5405-a758-f28ddc201142" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{7t},\\,{c}_{1},{c}_{2}\\in R" :db/id #edb/ref 17592186353991} :answer-field/id #uuid "0c6f1b55-8160-58d1-8bc5-7503d571b023" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353988}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5586f2bf-d487-5c34-8679-0141d368b6a9" :question/math-academy-id "q-79669" :question/problem "Find the general solution to the system of differential equations\n${\\begin{aligned}{x}_{1}^{′}(t)=-{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=7{x}_{2}(t).\\end{aligned}$" :question/worked-solution "Given a decoupled system of first-order linear ODEs in the form\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}{\\lambda }_{1} & 0 \\\\ 0 & {\\lambda }_{2}\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\n$$\n\nthe formula for the general solution is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{{\\lambda }_{1}t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{{\\lambda }_{2}t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFirst, we write our differential equation in matrix form:\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}-1 & 0 \\\\ 0 & 7\\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nSince the matrix of the differential system is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{7t},\\,{c}_{1},{c}_{2}\\in R.\n$$"}] [{:db/id #edb/ref 17592186353994 :knowledge-point/_questions [{:knowledge-point/id #uuid "cec0e48f-9fbb-5ada-b7fd-0d389d1b7438" :knowledge-point/title "Solving an Initial Value Problem for a Decoupled Linear System of First-Order ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53e9a019-02c4-5633-acbb-970a0975aba4" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}{e}^{2} \\\\ 0\\end{aligned}]{e}^{-t}+[\\begin{aligned}0 \\\\ 3\\end{aligned}]{4}^{t}" :db/id #edb/ref 17592186353996} {:answer/id #uuid "28b12668-db6e-525c-854d-803423cbac9e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}{e}^{-2} \\\\ 0\\end{aligned}]{e}^{-4t}+[\\begin{aligned}0 \\\\ 3\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353997} {:answer/id #uuid "b8ed83cb-d6a0-5bcb-98d9-fb5a84663ff7" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}{e}^{-2} \\\\ 0\\end{aligned}]{e}^{-4t}" :db/id #edb/ref 17592186353998} {:answer/id #uuid "ae848e9e-1a1a-5fb1-91b1-ac4a02311962" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}{e}^{-4} \\\\ 0\\end{aligned}]{e}^{-2t}+[\\begin{aligned}0 \\\\ 3\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353999} {:answer/id #uuid "669cd908-8e95-51c8-9da3-1ff67c0522e2" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}0 \\\\ 3\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186354000}] :answer-field/correct {:answer/id #uuid "28b12668-db6e-525c-854d-803423cbac9e" :answer/type {:db/ident :answer.type/math} :answer/value "x(t)=[\\begin{aligned}{e}^{-2} \\\\ 0\\end{aligned}]{e}^{-4t}+[\\begin{aligned}0 \\\\ 3\\end{aligned}]{2}^{t}" :db/id #edb/ref 17592186353997} :answer-field/id #uuid "7dcdf61e-07bc-55cf-b199-a8d3207af65d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353995}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ba37457e-b90f-5fc3-b5f4-b2ba1d277f80" :question/math-academy-id "q-79726" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-4 & 0 \\\\ 0 & \\operatorname{ln}⁡(2)\\end{aligned}]x(t),\\,x(2)=[\\begin{aligned}{e}^{-10} \\\\ 12\\end{aligned}].\n$$" :question/worked-solution "We have a decoupled system. Therefore, the general solution is given by\n\n$$\n\\begin{aligned}x(t) & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-4t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\operatorname{ln}⁡(2)t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-4t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t},\\,{c}_{1},{c}_{2}\\in R.\\end{aligned}\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(2)=[\\begin{aligned}{e}^{-2} \\\\ 3\\end{aligned}].$ Substituting $t=2$ into the general solution gives\n\n$$\n\\begin{aligned}x(2) & ={c}_{1}[\\begin{aligned}{e}^{-8} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {2}^{2}\\end{aligned}] \\\\ [\\begin{aligned}{e}^{-10} \\\\ 12\\end{aligned}] & =[\\begin{aligned}{e}^{-8}{c}_{1} \\\\ 4{c}_{2}\\end{aligned}] \\\\ [\\begin{aligned}{e}^{-2} \\\\ 3\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & ={e}^{-2}\\cdot [\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-4t}+3\\cdot [\\begin{aligned}0 \\\\ 1\\end{aligned}]{2}^{t} \\\\  & =[\\begin{aligned}{e}^{-2} \\\\ 0\\end{aligned}]{e}^{-4t}+[\\begin{aligned}0 \\\\ 3\\end{aligned}]{2}^{t}.\\end{aligned}\n$$"}]}
