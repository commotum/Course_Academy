gned}]{e}^{5t}+[\\begin{aligned}0 \\\\ 4\\end{aligned}]{2}^{-2t}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066958/state.json" "file_sha256" "e3bd85c87bb20bbc4cfa554c6005e1c0631132a5230be41e23af4c110fd8c4c4"} {"question" "q-39731" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066958/activity-metadata.json" "file_sha256" "26e90ca44d2d42ab0a5e29ef0cb7fefc6039a42ecf3dfb8754d539973eab6da8"} {"question" "q-39731" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066958/state.json" "file_sha256" "e3bd85c87bb20bbc4cfa554c6005e1c0631132a5230be41e23af4c110fd8c4c4"} {"question" "q-39731" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x(t)=[\\begin{aligned}0 \\\\ e\\end{aligned}]{e}^{5t}+[\\begin{aligned}4 \\\\ 0\\end{aligned}]{2}^{-2t}"] ["math" "x(t)=[\\begin{aligned}e \\\\ 0\\end{aligned}]{e}^{5t}+[\\begin{aligned}0 \\\\ 4\\end{aligned}]{2}^{-2t}"] ["math" "x(t)=[\\begin{aligned}e \\\\ 4\\end{aligned}]{2}^{-2t}"] ["math" "x(t)=[\\begin{aligned}e \\\\ 4\\end{aligned}]{e}^{5t}"] ["math" "x(t)=[\\begin{aligned}e \\\\ 4e\\end{aligned}]5{e}^{2t}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066958/state.json" "file_sha256" "e3bd85c87bb20bbc4cfa554c6005e1c0631132a5230be41e23af4c110fd8c4c4"} {"question" "q-39731" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x(t)=[\\begin{aligned}e \\\\ 0\\end{aligned}]{e}^{5t}+[\\begin{aligned}0 \\\\ 4\\end{aligned}]{2}^{-2t}"] "category" "ma_successful_grade"