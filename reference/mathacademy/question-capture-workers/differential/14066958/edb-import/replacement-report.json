    {
      "question": "e-21120",
      "field": null,
      "attribute": "question/problem",
      "old_sha256": "43d107c755ca137052c38a894a45610d4d63b26182e97142ea87c84476f82fd3",
      "new_sha256": "4e4f9c5756836c6a5cc871667f1fb5416a07aa708d704f30201f33a62f1ca85c",
      "category": "ma_capture",
      "authoring": [],
      "source": [
        {
          "question": "e-21120",
          "field": null,
          "attribute": "question/problem",
          "value": "Which of the following systems of linear ODEs are decoupled?\n\n- ${\\begin{aligned}{x}_{1}^{\u2032}(t)=4{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{\u2032}(t)=-{x}_{1}(t)+6{x}_{2}(t)\\end{aligned}$\n\n- ${\\begin{aligned}{x}_{1}^{\u2032}(t)=-3{x}_{1}(t) \\\\ {x}_{2}^{\u2032}(t)=7{x}_{2}(t)\\end{aligned}$\n\n- ${\\begin{aligned}{x}_{1}^{\u2032}(t)=5{x}_{2}(t) \\\\ {x}_{2}^{\u2032}(t)=2{x}_{1}(t)-{x}_{2}(t)\\end{aligned}$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066958/example-21120.json",
          "file_sha256": "4895b8af5fdad2276b6867d89255426f841cc845a14eee04881d6a1e5d72fc39"
        }
      ],
      "basis": 2219,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14066958/edb-import/commit.edn",
