e/14014138/edb-import/verification.json"} {"question" "q-115259" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{\\int }_{0}^{\\pi /2}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡x\\,\\text{d}x"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-115259" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{\\int }_{0}^{\\pi }\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡x\\,\\text{d}x"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-115259" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2{\\int }_{0}^{\\pi /2}\\operatorname{ln}⁡({x}^{2}+1)\\operatorname{cos}⁡x\\,\\text{d}x"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-88208" "field" nil "attribute" "question/problem" "value" "Which of the following integrals evaluates to zero due to symmetry?\n\n- ${\\int }_{-5}^{5}x\\operatorname{cos}⁡({x}^{2})\\,\\text{d}x$\n- ${\\int }_{-2}^{2}x\\operatorname{sin}⁡(x+1)\\,\\text{d}x$\n- ${\\int }_{-\\pi }^{\\pi }({x}^{3}-2x)\\,\\text{d}x$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-88208" "field" nil "attribute" "question/worked-solution" "value" "Recall the following:\n\n- a function $f(x)$ is *even* if $f(-x)=f(x)$\n\n- a function $f(x)$ is *odd* if $f(-x)=-f(x)$\n\nMoreover, for any odd function $f(x),$ the graph of $y=f(x)$ has rotational symmetry of order $2$ about the origin, so we have\n\n$$\n{\\int }_{-a}^{a}f(x)\\,\\text{d}x=0.\n$$\n\nSo, to determine which integrals evaluate to zero due to symmetry, we have to determine which integrands are odd functions.\n\n- The function $f(x)=x\\operatorname{cos}⁡({x}^{2})$ is an odd function:\n\n$$\n\\begin{aligned}f(-x) & =(-x)\\operatorname{cos}⁡((-x)^{2}) \\\\  & =-x\\operatorname{cos}⁡({x}^{2}) \\\\  & =-f(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-5}^{5}x\\operatorname{cos}⁡({x}^{2})\\,\\text{d}x=0.\n$$\n\n- The function $g(x)=x\\operatorname{sin}⁡(x+1)$ is *not* an odd function:\n\n$$\n\\begin{aligned}g(-x) & =(-x)\\operatorname{sin}⁡(-x+1) \\\\  & =-x\\operatorname{sin}⁡(1-x) \\\\  & \\ne -g(x)\\,\\times \\end{aligned}\n$$\n\n- The function $h(x)={x}^{3}-2x$ is an odd function:\n\n$$\n\\begin{aligned}h(-x) & =(-x)^{3}-2(-x) \\\\  & =-{x}^{3}+2x \\\\  & =-({x}^{3}-2x) \\\\  & =-h(x)\\,✓\\end{aligned}\n$$\n\nTherefore, by symmetry, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }({x}^{3}-2x)\\,\\text{d}x=0.\n$$\n\nTherefore, the correct answer is \"I and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-88208" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/activity-metadata.json" "file_sha256" "719d109e0f263a23944557d97e05a7591b3925e13f943ab431df7e88d5f39d5f" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-88208" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-88208" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification.json"} {"question" "q-88208" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/state.json" "file_sha256" "50459f288de63b68678b5cd50d67e9bef576e2c3c7d1404b817e2765ab1c3bad" "basis" 1182 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14014138/edb-import/verification