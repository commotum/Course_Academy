uestions [{:knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82c75e3b-9013-5765-8885-6156aeb5fa0e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186149777} {:answer/id #uuid "9e85ee5e-e7e7-5447-8d9e-21db9bf4c848" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186149778} {:answer/id #uuid "aec34fa7-7834-5ebd-a013-343b355c47de" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186149779} {:answer/id #uuid "bca88cd9-91f2-5934-9533-709d743c510d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186149780} {:answer/id #uuid "2d2d6cc9-ad49-5fba-b2f6-968887496e6d" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186149781}] :answer-field/correct {:answer/id #uuid "aec34fa7-7834-5ebd-a013-343b355c47de" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186149779} :answer-field/id #uuid "b297f076-9185-5c4e-9976-2565b9a4aa16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186149776}] :question/id #uuid "f5244118-e12b-5ac2-ae1e-3e2ab9060947" :question/math-academy-id "q-333520" :question/problem "$y^{″} + y = 0$\nConsider the differential equation above. Which of the following statements are true?\n\n1. $y_{1}(x) = \\sin (x)$ is a solution to the equation.\n2. $y_{2}(x) = 3\\sin (x)$ is a solution to the equation.\n3. The functions $y_{1}(x)$ and $y_{2}(x)$ form a set of fundamental solutions to the equation."}] [{:db/id #edb/ref 17592186152487 :knowledge-point/_questions [{:knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608" :knowledge-point/title "Identifying Fundamental Sets of Solutions"}] :question/answer-f