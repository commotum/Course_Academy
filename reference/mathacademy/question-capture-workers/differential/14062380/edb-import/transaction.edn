ea423527b72c2d8836642aabb0a"] :db/ensure [:answer-field/validate]} {:db/id "q-334109" :question/id #uuid "d63ca435-f2ea-5659-8898-4d8e163d63c6" :question/math-academy-id "q-334109" :question/problem "$$\n{y}_{1}(x)={x}^{2}+1,\\,{y}_{2}(x)=2+2{x}^{2},\\,x\\in R\n$$\n\nConsider the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ above. Given that ${y}_{1}$ and ${y}_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({y}_{1},{y}_{2})=$ \n{{field-1}},  which is \n{{field-2}}.\n\n$\\,$ Therefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly \n{{field-3}} \non $R.$" :question/worked-solution "Suppose the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are defined on some interval $I.$\nThe Wronskian $W({y}_{1},{y}_{2})$ of these functions is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nRecall the following:\n\n- If $W\\ne 0$ for at least one $x\\in I,$ then ${y}_{1}$ and ${y}_{2}$ are linearly independent.\n\n- If $W=0$ and it’s known that ${y}_{1}$ and ${y}_{2}$ are solutions to the same second-order linear differential equation, then ${y}_{1}$ and ${y}_{2}$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{x}^{2}+1 & 2+2{x}^{2} \\\\ ({x}^{2}+1)^{′} & (2+2{x}^{2})^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{2}+1 & 2+2{x}^{2} \\\\ 2x & 4x\\end{aligned}| \\\\  & =({x}^{2}+1)(4x)-(2+2{x}^{2})(2x) \\\\  & =4x({x}^{2}+1)-4x({x}^{2}+1) \\\\  & =0\\end{aligned}\n$$\n\nwhich is $\\text{zero for all }x\\in R.$\n\nTherefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly $\\text{dependent}$ on $R.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334109/field-1" "q-334109/field-2" "q-334109/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd428707-bb32-58b2-8a51-09e330af0bb1"] :knowledge-point/questions ["q-334109"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334118/field-1/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" :answer/id #uuid "a5aef63b-6540-568e-b040-884cbc87587b" :answer/type :answer.type/math :answer/value "{x}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-334118/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" :answer/id #uuid "e153a4ca-a331-5010-adcd-4214bf2bf1f5" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "q-334118/field-1/b29d9e05fb7f02513cea8fe79c41dde09b8247dbce3071ca74e2cf8cbfd00178" :answer/id #uuid "7a70baf0-28f8-5823-bbb4-86b6bc15b417" :answer/type :answer.type/math :answer/value "x(x+2)" :db/ensure [:answer/validate]} {:db/id "q-334118/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "88b6b85a-dbce-57be-a4f9-6f97d1424680" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-334118/field-1" :answer-field/id #uuid "a482289f-956e-58a7-8f61-a940c79ca11a" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-334118/field-1/b29d9e05fb7f02513cea8fe79c41dde09b8247dbce3071ca74e2cf8cbfd00178" :answer-field/choices ["q-334118/field-1/2ab1b1fa4742e93494e9e627ed3015a60d0bf278c79a693639f4ffe9523586e9" "q-334118/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" "q-334118/field-1/b29d9e05fb7f02513cea8fe79c41dde09b8247dbce3071ca74e2cf8cbfd00178" "q-334118/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-334118/field-2/4a257cff4c408023576c5fb3aed12254698e774f450ffa12b5bdc7f7fb70f200" :answer/id #uuid "d1fa82ec-66d3-5f40-8535-144526beb4fe" :answer/type :answer.type/text :answer/value "zero for all $x\\in R$" :db/ensure [:answer/validate]} {:db/id "q-334118/field-2/578dba6bfd8fb536bf21b6da9c01b7390008f8d7529a4d93c3b20452cf2b19c8" :answer/id #uuid "9e1376e4-5c30-5812-849f-85430bac9bdc" :answer/type :answer.type/text :answer/value "nonzero for at least one $x\\in R$" :db/ensure [:answer/validate]} {:db/id "q-334118/field-2" :answer-field/id #uuid "c29db91e-5d49-5949-8c72-3b515420e0b6" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-334118/field-2/578dba6bfd8fb536bf21b6da9c01b7390008f8d7529a4d93c3b20452cf2b19c8" :answer-field/choices ["q-334118/field-2/4a257cff4c408023576c5fb3aed12254698e774f450ffa12b5bdc7f7fb70f200" "q-334118/field-2/578dba6bfd8fb536bf21b6da9c01b7390008f8d7529a4d93c3b20452cf2b19c8"] :db/ensure [:answer-field/validate]} {:db/id "q-334118/field-3/988842f9ae7a51d1679b23c13893e9f8d3070ea423527b72c2d8836642aabb0a" :answer/id #uuid "7a7801e6-dc44-5043-bdc6-7e04acc5251a" :answer/type :answer.type/text :answer/value "dependent" :db/ensure [:answer/validate]} {:db/id "q-334118/field-3/a8a725fec0b63a3b8d6f4591903bfe81596da23bd6deceff5c00414df35bbd3f" :answer/id #uuid "c2511fbd-02cb-560d-9344-55fcca4e5fe6" :answer/type :answer.type/text :answer/value "independent" :db/ensure [:answer/validate]} {:db/id "q-334118/field-3" :answer-field/id #uuid "1b0be9fd-83d0-5eeb-b4a2-2647b5921b93" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-334118/field-3/a8a725fec0b63a3b8d6f4591903bfe81596da23bd6deceff5c00414df35bbd3f" :answer-field/choices ["q-334118/field-3/988842f9ae7a51d1679b23c13893e9f8d3070ea423527b72c2d8836642aabb0a" "q-334118/field-3/a8a725fec0b63a3b8d6f4591903bfe81596da23bd6deceff5c00414df35bbd3f"] :db/ensure [:answer-field/validate]} {:db/id "q-334118" :question/id #uuid "fa26a1b1-f0cd-5690-840f-01ebdd18aaa0" :question/math-academy-id "q-334118" :question/problem "$$\n{y}_{1}(x)=x+1,\\,{y}_{2}(x)={x}^{2},\\,x\\in R\n$$\n\nConsider the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ above. Given that ${y}_{1}$ and ${y}_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({y}_{1},{y}_{2})=$ \n{{field-1}},  \nwhich is\n{{field-2}}.\n\n$\\,$ Therefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly \n{{field-3}} \non $R.$" :question/worked-solution "Suppose the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are defined on some interval $I.$\nThe Wronskian $W({y}_{1},{y}_{2})$ of these functions is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nRecall the following:\n\n- If $W\\ne 0$ for at least one $x\\in I,$ then ${y}_{1}$ and ${y}_{2}$ are linearly independent.\n\n- If $W=0$ and it’s known that ${y}_{1}$ and ${y}_{2}$ are solutions to the same second-order linear differential equation, then ${y}_{1}$ and ${y}_{2}$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}x+1 & {x}^{2} \\\\ (x+1)^{′} & ({x}^{2})^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}x+1 & {x}^{2} \\\\ 1 & 2x\\end{aligned}| \\\\  & =(x+1)\\cdot (2x)-{x}^{2}\\cdot 1 \\\\  & =2x(x+1)-{x}^{2} \\\\  & =2{x}^{2}+2x-{x}^{2} \\\\  & ={x}^{2}+2x \\\\  & =x(x+2)\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }x\\in R.$\n\nTherefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly $\\text{independent}$ on $R.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334118/field-1" "q-334118/field-2" "q-334118/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd428707-bb32-58b2-8a51-09e330af0bb1"] :knowledge-point/questions ["q-334118"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334199/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "da9b2472-2fad-5f89-930f-bf12760ca4eb" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-334199/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "89b37e36-dd38-5632-8ad6-13d53df31b24" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-334199/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "07006ce1-cba7-510d-a2d5-9489893f4769" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-334199/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "efe80c0c-d301-5e03-ba42-9b9e470a9464" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-334199/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "fdb023e7-d61a-55ce-8f76-b1c533553352" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-334199/selection" :answer-field/id #uuid "bad71d21-e860-59e1-9308-f6f478fba23a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334199/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-334199/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-334199/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-334199/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-334199/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-334199/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25"] :db/ensure [:answer-field/validate]} {:db/id "q-334199" :question/id #uuid "a36d5f27-8f18-50ba-baf2-49398ab8cb91" :question/math-academy-id "q-334199" :question/problem "$$\n{y}^{″}-3{y}^{′}+2y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{3x}$ is a solution to the equation.\n- ${y}_{2}(x)={e}^{2x}$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =3{e}^{3x} \\\\ {y}_{1}^{″}(x) & =9{e}^{3x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}9{e}^{3x}-3(3{e}^{3x})+2({e}^{3x}) & =0 \\\\ 8 & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement II is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =2{e}^{2x} \\\\ {y}_{2}^{″}(x) & =4{e}^{2x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{e}^{2x}-3(2{e}^{2x})+2({e}^{2x}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334199/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608"] :knowledge-point/questions ["q-334199"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-333522"] :question/problem "$$\n{y}^{″}+7{y}^{′}+6y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{-x}$ is a solution to the equation.\n- ${y}_{2}(x)=1+{e}^{-x}$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-{e}^{-x} \\\\ {y}_{1}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6{e}^{-x} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is false. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =-{e}^{-x} \\\\ {y}_{2}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6(1+{e}^{-x}) & =0 \\\\ 6 & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is not a solution to the equation.\n\n- Statement III is false. Since ${y}_{2}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I only\"." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-334258/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "9d2c5a71-9b98-5e1f-ba5a-087ad8a0bb88" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-334258/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "8932d3e2-89cb-58bd-b620-a9817cc955fb" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-334258/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "fd3be4c0-9957-5f42-a960-ba9aeda44e2d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-334258/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "a1814028-198a-5414-912c-1339a72204a9" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-334258/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "be4bf8db-d345-5fbf-8983-e3a074a8e50d" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-334258/selection" :answer-field/id #uuid "1ce792f2-fcbc-5072-85bd-94c340a6f967" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334258/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-334258/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-334258/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-334258/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-334258/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-334258/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23"] :db/ensure [:answer-field/validate]} {:db/id "q-334258" :question/id #uuid "235f526f-aadf-5121-a9ee-0d359f5a7cab" :question/math-academy-id "q-334258" :question/problem "$$\n{y}^{″}-2{y}^{′}+5y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{2x}\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- ${y}_{2}(x)={e}^{x}\\operatorname{sin}⁡(2x)$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & ={e}^{2x}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x) \\\\ {y}_{1}^{″}(x) & ={e}^{2x}(3\\operatorname{sin}⁡x+4\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{2x}(3\\operatorname{sin}⁡x+4\\operatorname{cos}⁡x)-2{e}^{2x}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+5{e}^{2x}\\operatorname{sin}⁡x & =0 \\\\ 2(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x){e}^{2x} & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement II is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & ={e}^{x}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x)) \\\\ {y}_{2}^{″}(x) & ={e}^{x}(-3\\operatorname{sin}⁡(2x)+4\\operatorname{cos}⁡(2x))\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{x}(-3\\operatorname{sin}⁡(2x)+4\\operatorname{cos}⁡(2x))-2{e}^{x}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x))+5{e}^{x}\\operatorname{sin}⁡(2x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"II only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334258/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608"] :knowledge-point/questions ["q-334258"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334260/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "99bc7da0-3b59-5324-b328-8a2625276f13" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-334260/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "0fa7c3ff-3f0e-5c6d-b97e-f14800dde393" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-334260/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "b868a147-196b-5189-b674-28a52b47abd7" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-334260/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "d5f6d0c9-2c64-5fef-9e0e-fa7bd44fd787" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-334260/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "4bdd3b02-03ec-5ea1-a707-2169a57c91a3" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-334260/selection" :answer-field/id #uuid "4010acbf-ef30-53c9-babc-012b17004493" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-334260/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-334260/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-334260/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-334260/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-334260/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-334260/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-334260" :question/id #uuid "848babcd-41d6-58bc-956a-17528aefe249" :question/math-academy-id "q-334260" :question/problem "$$\n{y}^{″}-6{y}^{′}+9y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{3x}$ is a solution to the equation.\n- ${y}_{2}(x)={e}^{3x-1}$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =3{e}^{3x} \\\\ {y}_{1}^{″}(x) & =9{e}^{3x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}9{e}^{3x}-6\\cdot 3{e}^{3x}+9{e}^{3x} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3{e}^{3x-1} \\\\ {y}_{2}^{″}(x) & =9{e}^{3x-1}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}9{e}^{3x-1}-6\\cdot 3{e}^{3x-1}+9{e}^{3x-1} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{3x} & {e}^{3x-1} \\\\ 3{e}^{3x} & 3{e}^{3x-1}\\end{aligned}| \\\\  & ={e}^{3x}\\cdot 3{e}^{3x-1}-3{e}^{3x}\\cdot {e}^{3x-1} \\\\  & =3{e}^{6x-1}-3{e}^{6x-1} \\\\  & =0\\end{aligned}\n$$\n\nSince the  Wronskian equals $0$ for all $x\\in R,$ the functions are not linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-334260/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e66005fe-df33-590a-9d9c-91947cd4a608"] :knowledge-point/questions ["q-334260"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-333520"] :question/problem "$$\n{y}^{″}+y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)=\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- ${y}_{2}(x)=3\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =\\operatorname{cos}⁡(x) \\\\ {y}_{1}^{″}(x) & =-\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡(x)+\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3\\operatorname{cos}⁡(x) \\\\ {y}_{2}^{″}(x) & =-3\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-3\\operatorname{sin}⁡(x)+3\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{sin}⁡(x) & 3\\operatorname{sin}⁡(x) \\\\ \\operatorname{cos}⁡(x) & 3\\operatorname{cos}⁡(x)\\end{aligned}| \\\\  & =\\operatorname{sin}⁡(x)\\cdot 3\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\cdot \\operatorname{cos}⁡(x) \\\\  & =3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x) \\\\  & =0\\end{aligned}\n$$\n\nSince the  Wronskian equals $0$ for all $x\\in R,$ the functions are not linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21683"] :question/problem "Given the set of functions $\\{ e^x, \\, \\sin x \\}$ defined on $x \\in \\mathbb{R},$ explain why they are linearly independent." :question/worked-solution "Recall that the set of functions $\\{ f_1(x), f_2(x), \\ldots, f_n(x) \\},$ which are defined on some interval $I,$ is *linearly dependent* if there exist real scalars $k_1,k_2,\\ldots,k_n$ not all zero such that the linear combination $k_1 \\cdot f_1 + k_2 \\cdot f_2 + \\ldots + k_2 \\cdot f_2$ is identically zero, i.e, \n\n$$\nk_1 \\cdot f_1(x) + k_2 \\cdot f_2(x) + \\ldots + k_2 \\cdot f_2(x) = 0\n$$\n\nfor all $x \\in I.$ Otherwise, if $k_1 = k_2 = \\cdots = k_n = 0$ is the only solution, the set is *linearly independent*.\n\nNow, suppose for all $x \\in \\mathbb{R},$ we have that \n\n$$\nk_1 e^x + k_2 \\sin x = 0.\n$$\n\nFor example:\n\n- If $x=0,$ we get \n\n$$\n\\begin{aligned} & {k}_{1}({e}^{0})+{k}_{2}(\\operatorname{sin}⁡0)=0 \\\\  & {k}_{1}\\cdot 1+{k}_{2}\\cdot 0=0\\,⇒\\,{k}_{1}=0.\\end{aligned}\n$$\n\n- If $x=1,$ we get \n\n$$\n\\begin{aligned} & {k}_{1}({e}^{1})+{k}_{2}(\\operatorname{sin}⁡1)=0 \\\\  & e{k}_{1}+(\\operatorname{sin}⁡1)\\,{k}_{2}=0\\,⇒\\,e{k}_{1}+(\\operatorname{sin}⁡1)\\,{k}_{2}=0.\\end{aligned}\n$$\n\nThus, we obtain the following system of linear equations:\n\n$$\n{\\begin{aligned}{k}_{1}=0 \\\\ e{k}_{1}+(\\operatorname{sin}⁡1)\\,{k}_{2}=0\\end{aligned}\n$$\n\nThe only solution for this system is $\\bbox[4pt, border: solid 1pt gainsboro]{k_1=k_2=0}.$\n\nTherefore, since $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{all}}$ the scalar coefficients in the linear combination must be zero, the given set of functions is linearly $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{independent}}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21680"] :question/problem "Compute the Wronskian $W(y_1, y_2)$ for $y_1(x) =2x$ and $y_2(x) = x^2.$" :question/worked-solution "The Wronskian $W(y_1,y_2)$ of two functions $y_1(x)$ and $y_2(x)$ is defined as\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/assets/8c9f75d71e362ec7207e00f67adecae7193e35972e46a783faa5aa1ea6c00301.png)\n\nIn our case, we have $y_1(x) = 2x$ and $y_2(x) = x^2.$ Therefore,\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =2x{({x}^{2})}^{′}-{x}^{2}{(2x)}^{′} \\\\  & =4{x}^{2}-2{x}^{2} \\\\  & =2{x}^{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21681"] :question/problem "$$\ny_1(x) = x^2 + 1, \\qquad\ny_2(x) = 2x, \\qquad x \\in \\mathbb R\n$$\n\nConsider the functions $y_1(x)$ and $y_2(x)$ above. Given that $y_1$ and $y_2$ are solutions of the same second-order linear differential equation, use the Wronskian to explain why the set $\\{ y_1(x), y_2(x) \\}$ is linearly independent." :question/worked-solution "Suppose the functions $y_1(x)$ and $y_2(x)$ are defined on some interval $I.$\nThe Wronskian $W(y_1,y_2)$ of these functions is defined as\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/assets/19eae90f8f511056865f967ce8bf784261bd0f1b20cec65f478919e4b1c00078.png)\n\nRecall the following:\n\n- If $W \\neq 0$ for at least one $x \\in I,$ then $y_1$ and $y_2$ are linearly independent.\n\n- If $W = 0$ and it’s known that $y_1$ and $y_2$ are solutions to the same second-order linear differential equation, then $y_1$ and $y_2$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{x}^{2}+1 & 2x \\\\ ({x}^{2}+1)^{′} & (2x)^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{2}+1 & 2x \\\\ 2x & 2\\end{aligned}| \\\\  & =({x}^{2}+1)\\cdot 2-(2x)\\cdot (2x) \\\\  & =2({x}^{2}+1)-4{x}^{2} \\\\  & =2{x}^{2}+2-4{x}^{2} \\\\  & =2-2{x}^{2}\\end{aligned}\n$$\n\nwhich is nonzero for at least one $x \\in \\mathbb{R}.$\n\nTherefore, the set $\\left\\{ y_1(x), y_2(x) \\right\\}$ is linearly independent on $\\mathbb R.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21682"] :question/problem "Consider the differential equation $x^2y'' - 5x y' + 9y=0.$ Which of the following statements are true?\n\n- $y_1(x) = x^3$ is a solution to the equation for $x\\in \\mathbb R.$\n\n- $y_2(x) = x^3 \\ln x$ is a solution to the equation for $x > 0.$\n\n- The functions $y_1(x)$ and $y_2(x)$ form a set of fundamental solutions to the equation on $(0, \\infty).$" :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of $y_1(x){:}$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =3{x}^{2} \\\\ {y}_{1}^{″}(x) & =6x\\end{aligned}\n$$\n\nNow, let's substitute $y_1(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot 6x-5x\\cdot 3{x}^{2}+9{x}^{3} & =0 \\\\ 6{x}^{3}-15{x}^{3}+9{x}^{3} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, $y_1(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of $y_2(x){:}$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3{x}^{2}\\operatorname{ln}⁡x+{x}^{2} \\\\ {y}_{2}^{″}(x) & =6x\\operatorname{ln}⁡x+5x\\end{aligned}\n$$\n\nNow, let's substitute $y_2(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(6x\\operatorname{ln}⁡x+5x)-5x(3{x}^{2}\\operatorname{ln}⁡x+{x}^{2})+9{x}^{3}\\operatorname{ln}⁡x & =0 \\\\ (6{x}^{3}\\operatorname{ln}⁡x+5{x}^{3}-15{x}^{3}\\operatorname{ln}⁡x-5{x}^{3}+9{x}^{3}\\operatorname{ln}⁡x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, $y_2(x)$ is a solution to the equation.\n\n- Statement III is true. Both $y_1$ and $y_2$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{3} & {x}^{3}\\operatorname{ln}⁡x \\\\ 3{x}^{2} & 3{x}^{2}\\operatorname{ln}⁡x+{x}^{2}\\end{aligned}| \\\\  & ={x}^{3}(3{x}^{2}\\operatorname{ln}⁡x+{x}^{2})-{x}^{3}\\operatorname{ln}⁡x\\cdot 3{x}^{2} \\\\  & =3{x}^{5}\\operatorname{ln}⁡x+{x}^{5}-3{x}^{5}\\operatorname{ln}⁡x \\\\  & ={x}^{5}\\end{aligned}\n$$\n\nSince the  Wronskian is not identically $0$ on $(0, \\infty),$ the functions are linearly independent. Hence, $y_1(x)$ and $y_2(x)$ form a set of fundamental solutions to the equation on $(0, \\infty)$.\n\nTherefore, the correct answer is \"I, II, and III\"." :db/ensure [:question/validate]}]
