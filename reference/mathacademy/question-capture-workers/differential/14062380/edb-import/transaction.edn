y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nIn our case, we have ${y}_{1}(x)=x$ and ${y}_{2}(x)=\\operatorname{sin}⁡x.$ Therefore\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(x){(\\operatorname{sin}⁡x)}^{′}-(\\operatorname{sin}⁡x){(x)}^{′} \\\\  & =(x)(\\operatorname{cos}⁡x)-(\\operatorname{sin}⁡x)(1) \\\\  & =x\\operatorname{cos}⁡x-\\operatorname{sin}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129797/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ca68460-f3fe-5ae8-b5f4-85742c0ef46b"] :knowledge-point/questions ["q-129797"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79891/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "78741881-e140-5bff-9902-a24fc44eca7f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-79891/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "610d16c1-e401-5f61-ac99-4c2f7a333cd8" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-79891/selection/b3718f7488480efe248ed4c90f27b50c002d76c535882162dbcb397b61cd392d" :answer/id #uuid "70948372-f798-564b-bb5d-e9a4bb9812ee" :answer/type :answer.type/math :answer/value "2{sin}^{2}⁡(2x)" :db/ensure [:answer/validate]} {:db/id "q-79891/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a11bc5f5-b45d-5157-9caa-38c70ed008eb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-79891/selection/ea5ccd62eecbdda4ae854c87ede460986678c923618ef3301da50d0c026c5fcd" :answer/id #uuid "10730ab0-261e-568b-83a9-967035ae2b04" :answer/type :answer.type/math :answer/value "2{cos}^{2}⁡(2x)" :db/ensure [:answer/validate]} {:db/id "q-79891/selection" :answer-field/id #uuid "e207babf-60ad-5433-b75a-388cf8606720" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79891/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-79891/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-79891/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-79891/selection/b3718f7488480efe248ed4c90f27b50c002d76c535882162dbcb397b61cd392d" "q-79891/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-79891/selection/ea5ccd62eecbdda4ae854c87ede460986678c923618ef3301da50d0c026c5fcd"] :db/ensure [:answer-field/validate]} {:db/id "q-79891" :question/id #uuid "24fd59e6-a32f-543d-ab61-01a498474c4d" :question/math-academy-id "q-79891" :question/problem "Compute the Wronskian $W({y}_{1},{y}_{2})$ for ${y}_{1}(x)=\\operatorname{cos}⁡(2x)$ and ${y}_{2}(x)=\\operatorname{sin}⁡(2x).$" :question/worked-solution "The Wronskian $W({y}_{1},{y}_{2})$ of two functions ${y}_{1}(x)$ and ${y}_{2}(x)$ is defined as:\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}\n$$\n\nIn our case, we have ${y}_{1}(x)=\\operatorname{cos}⁡(2x)$ and ${y}_{2}(x)=\\operatorname{sin}⁡(2x).$ Therefore:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =(\\operatorname{cos}⁡(2x)){(\\operatorname{sin}⁡(2x))}^{′}-(\\operatorname{sin}⁡(2x)){(\\operatorname{cos}⁡(2x))}^{′} \\\\  & =(\\operatorname{cos}⁡(2x))(2\\operatorname{cos}⁡(2x))-(\\operatorname{sin}⁡(2x))(-2\\operatorname{sin}⁡(2x)) \\\\  & =2{cos}^{2}⁡(2x)+2{sin}^{2}⁡(2x) \\\\  & =2({cos}^{2}⁡(2x)+{sin}^{2}⁡(2x)) \\\\  & =2(1) \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79891/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4ca68460-f3fe-5ae8-b5f4-85742c0ef46b"] :knowledge-point/questions ["q-79891"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79893/selection/e456