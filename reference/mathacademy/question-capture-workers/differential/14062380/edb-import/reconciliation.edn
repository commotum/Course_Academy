c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334109" "field" "field-3" "attribute" "answer-field/choices" "value" [["text" "dependent"] ["text" "independent"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334109" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/text "dependent"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" nil "attribute" "question/problem" "value" "$$\n{y}_{1}(x)=x+1,\\,{y}_{2}(x)={x}^{2},\\,x\\in R\n$$\n\nConsider the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ above. Given that ${y}_{1}$ and ${y}_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below.$\\,$ The Wronskian is $W({y}_{1},{y}_{2})=$ \n{{field-1}},  \nwhich is\n{{field-2}}.\n\n$\\,$ Therefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly \n{{field-3}} \non $R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" nil "attribute" "question/worked-solution" "value" "Suppose the functions ${y}_{1}(x)$ and ${y}_{2}(x)$ are defined on some interval $I.$\nThe Wronskian $W({y}_{1},{y}_{2})$ of these functions is defined as\n\n$$\nW({y}_{1},{y}_{2})=|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}|={y}_{1}{y}_{2}^{′}-{y}_{2}{y}_{1}^{′}.\n$$\n\nRecall the following:\n\n- If $W\\ne 0$ for at least one $x\\in I,$ then ${y}_{1}$ and ${y}_{2}$ are linearly independent.\n\n- If $W=0$ and it’s known that ${y}_{1}$ and ${y}_{2}$ are solutions to the same second-order linear differential equation, then ${y}_{1}$ and ${y}_{2}$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}x+1 & {x}^{2} \\\\ (x+1)^{′} & ({x}^{2})^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}x+1 & {x}^{2} \\\\ 1 & 2x\\end{aligned}| \\\\  & =(x+1)\\cdot (2x)-{x}^{2}\\cdot 1 \\\\  & =2x(x+1)-{x}^{2} \\\\  & =2{x}^{2}+2x-{x}^{2} \\\\  & ={x}^{2}+2x \\\\  & =x(x+2)\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }x\\in R.$\n\nTherefore, the set ${{y}_{1}(x),{y}_{2}(x)}$ is linearly $\\text{independent}$ on $R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/activity-metadata.json" "file_sha256" "f31a0fbdf99cfda2ea86e857f382e4d5ec78a2be790cf94c511fd56e9942be3e"} {"question" "q-334118" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "2x"] ["math" "x(x+2)"] ["math" "{x}^{2}-1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "x(x+2)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-2" "attribute" "answer-field/choices" "value" [["text" "nonzero for at least one $x\\in R$"] ["text" "zero for all $x\\in R$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/text "nonzero for at least one $x\\in R$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-3" "attribute" "answer-field/choices" "value" [["text" "dependent"] ["text" "independent"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334118" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/text "independent"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334199" "field" nil "attribute" "question/problem" "value" "$$\n{y}^{″}-3{y}^{′}+2y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{3x}$ is a solution to the equation.\n- ${y}_{2}(x)={e}^{2x}$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334199" "field" nil "attribute" "question/worked-solution" "value" "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =3{e}^{3x} \\\\ {y}_{1}^{″}(x) & =9{e}^{3x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}9{e}^{3x}-3(3{e}^{3x})+2({e}^{3x}) & =0 \\\\ 8 & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement II is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =2{e}^{2x} \\\\ {y}_{2}^{″}(x) & =4{e}^{2x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}4{e}^{2x}-3(2{e}^{2x})+2({e}^{2x}) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"II only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334199" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/activity-metadata.json" "file_sha256" "f31a0fbdf99cfda2ea86e857f382e4d5ec78a2be790cf94c511fd56e9942be3e"} {"question" "q-334199" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334199" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "None"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334199" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333522" "field" nil "attribute" "question/problem" "value" "$$\n{y}^{″}+7{y}^{′}+6y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{-x}$ is a solution to the equation.\n- ${y}_{2}(x)=1+{e}^{-x}$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333522" "field" nil "attribute" "question/worked-solution" "value" "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =-{e}^{-x} \\\\ {y}_{1}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6{e}^{-x} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is false. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =-{e}^{-x} \\\\ {y}_{2}^{″}(x) & ={e}^{-x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{-x}+7(-{e}^{-x})+6(1+{e}^{-x}) & =0 \\\\ 6 & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is not a solution to the equation.\n\n- Statement III is false. Since ${y}_{2}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333522" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/activity-metadata.json" "file_sha256" "f31a0fbdf99cfda2ea86e857f382e4d5ec78a2be790cf94c511fd56e9942be3e"} {"question" "q-333522" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333522" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "None"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333522" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334258" "field" nil "attribute" "question/problem" "value" "$$\n{y}^{″}-2{y}^{′}+5y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{2x}\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- ${y}_{2}(x)={e}^{x}\\operatorname{sin}⁡(2x)$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334258" "field" nil "attribute" "question/worked-solution" "value" "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is false. We find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & ={e}^{2x}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x) \\\\ {y}_{1}^{″}(x) & ={e}^{2x}(3\\operatorname{sin}⁡x+4\\operatorname{cos}⁡x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{2x}(3\\operatorname{sin}⁡x+4\\operatorname{cos}⁡x)-2{e}^{2x}(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+5{e}^{2x}\\operatorname{sin}⁡x & =0 \\\\ 2(2\\operatorname{sin}⁡x+\\operatorname{cos}⁡x){e}^{2x} & =0\\,\\times \\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is not a solution to the equation.\n\n- Statement II is true. We find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & ={e}^{x}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x)) \\\\ {y}_{2}^{″}(x) & ={e}^{x}(-3\\operatorname{sin}⁡(2x)+4\\operatorname{cos}⁡(2x))\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{e}^{x}(-3\\operatorname{sin}⁡(2x)+4\\operatorname{cos}⁡(2x))-2{e}^{x}(\\operatorname{sin}⁡(2x)+2\\operatorname{cos}⁡(2x))+5{e}^{x}\\operatorname{sin}⁡(2x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Since ${y}_{1}(x)$ is not a solution of the given differential equation, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"II only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334258" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/activity-metadata.json" "file_sha256" "f31a0fbdf99cfda2ea86e857f382e4d5ec78a2be790cf94c511fd56e9942be3e"} {"question" "q-334258" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334258" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "None"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334258" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334260" "field" nil "attribute" "question/problem" "value" "$$\n{y}^{″}-6{y}^{′}+9y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)={e}^{3x}$ is a solution to the equation.\n- ${y}_{2}(x)={e}^{3x-1}$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334260" "field" nil "attribute" "question/worked-solution" "value" "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =3{e}^{3x} \\\\ {y}_{1}^{″}(x) & =9{e}^{3x}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}9{e}^{3x}-6\\cdot 3{e}^{3x}+9{e}^{3x} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3{e}^{3x-1} \\\\ {y}_{2}^{″}(x) & =9{e}^{3x-1}\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}9{e}^{3x-1}-6\\cdot 3{e}^{3x-1}+9{e}^{3x-1} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{3x} & {e}^{3x-1} \\\\ 3{e}^{3x} & 3{e}^{3x-1}\\end{aligned}| \\\\  & ={e}^{3x}\\cdot 3{e}^{3x-1}-3{e}^{3x}\\cdot {e}^{3x-1} \\\\  & =3{e}^{6x-1}-3{e}^{6x-1} \\\\  & =0\\end{aligned}\n$$\n\nSince the  Wronskian equals $0$ for all $x\\in R,$ the functions are not linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I and II only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334260" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/activity-metadata.json" "file_sha256" "f31a0fbdf99cfda2ea86e857f382e4d5ec78a2be790cf94c511fd56e9942be3e"} {"question" "q-334260" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334260" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "None"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-334260" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333520" "field" nil "attribute" "question/problem" "value" "$$\n{y}^{″}+y=0\n$$\n\nConsider the differential equation above. Which of the following statements are true?\n\n- ${y}_{1}(x)=\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- ${y}_{2}(x)=3\\operatorname{sin}⁡(x)$ is a solution to the equation.\n- The functions ${y}_{1}(x)$ and ${y}_{2}(x)$ form a set of fundamental solutions to the equation." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333520" "field" nil "attribute" "question/worked-solution" "value" "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of ${y}_{1}(x):$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =\\operatorname{cos}⁡(x) \\\\ {y}_{1}^{″}(x) & =-\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{1}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-\\operatorname{sin}⁡(x)+\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{1}(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of ${y}_{2}(x):$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3\\operatorname{cos}⁡(x) \\\\ {y}_{2}^{″}(x) & =-3\\operatorname{sin}⁡(x)\\end{aligned}\n$$\n\nNow, let's substitute ${y}_{2}(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}-3\\operatorname{sin}⁡(x)+3\\operatorname{sin}⁡(x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, ${y}_{2}(x)$ is a solution to the equation.\n\n- Statement III is false. Both ${y}_{1}$ and ${y}_{2}$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{sin}⁡(x) & 3\\operatorname{sin}⁡(x) \\\\ \\operatorname{cos}⁡(x) & 3\\operatorname{cos}⁡(x)\\end{aligned}| \\\\  & =\\operatorname{sin}⁡(x)\\cdot 3\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\cdot \\operatorname{cos}⁡(x) \\\\  & =3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x)-3\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x) \\\\  & =0\\end{aligned}\n$$\n\nSince the  Wronskian equals $0$ for all $x\\in R,$ the functions are not linearly independent. Hence, ${y}_{1}(x)$ and ${y}_{2}(x)$ don't form a set of fundamental solutions to the equation.\n\nTherefore, the correct answer is \"I and II only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333520" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/activity-metadata.json" "file_sha256" "f31a0fbdf99cfda2ea86e857f382e4d5ec78a2be790cf94c511fd56e9942be3e"} {"question" "q-333520" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333520" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "I, II, and III"] ["text" "II only"] ["text" "None"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "q-333520" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/state.json" "file_sha256" "48bc43d5e6530a4043e3df74cd58c559d2e3e3e7db65742ff7d3e5a0365109f0"} {"question" "e-21683" "field" nil "attribute" "question/problem" "value" "Given the set of functions $\\{ e^x, \\, \\sin x \\}$ defined on $x \\in \\mathbb{R},$ explain why they are linearly independent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21683.json" "file_sha256" "09c9e03aafbe1728dab02d369fdd8b7881f021aec7f2146d806cdd5008df4422"} {"question" "e-21683" "field" nil "attribute" "question/worked-solution" "value" "Recall that the set of functions $\\{ f_1(x), f_2(x), \\ldots, f_n(x) \\},$ which are defined on some interval $I,$ is *linearly dependent* if there exist real scalars $k_1,k_2,\\ldots,k_n$ not all zero such that the linear combination $k_1 \\cdot f_1 + k_2 \\cdot f_2 + \\ldots + k_2 \\cdot f_2$ is identically zero, i.e, \n\n$$\nk_1 \\cdot f_1(x) + k_2 \\cdot f_2(x) + \\ldots + k_2 \\cdot f_2(x) = 0\n$$\n\nfor all $x \\in I.$ Otherwise, if $k_1 = k_2 = \\cdots = k_n = 0$ is the only solution, the set is *linearly independent*.\n\nNow, suppose for all $x \\in \\mathbb{R},$ we have that \n\n$$\nk_1 e^x + k_2 \\sin x = 0.\n$$\n\nFor example:\n\n- If $x=0,$ we get \n\n$$\n\\begin{aligned} & {k}_{1}({e}^{0})+{k}_{2}(\\operatorname{sin}⁡0)=0 \\\\  & {k}_{1}\\cdot 1+{k}_{2}\\cdot 0=0\\,⇒\\,{k}_{1}=0.\\end{aligned}\n$$\n\n- If $x=1,$ we get \n\n$$\n\\begin{aligned} & {k}_{1}({e}^{1})+{k}_{2}(\\operatorname{sin}⁡1)=0 \\\\  & e{k}_{1}+(\\operatorname{sin}⁡1)\\,{k}_{2}=0\\,⇒\\,e{k}_{1}+(\\operatorname{sin}⁡1)\\,{k}_{2}=0.\\end{aligned}\n$$\n\nThus, we obtain the following system of linear equations:\n\n$$\n{\\begin{aligned}{k}_{1}=0 \\\\ e{k}_{1}+(\\operatorname{sin}⁡1)\\,{k}_{2}=0\\end{aligned}\n$$\n\nThe only solution for this system is $\\bbox[4pt, border: solid 1pt gainsboro]{k_1=k_2=0}.$\n\nTherefore, since $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{all}}$ the scalar coefficients in the linear combination must be zero, the given set of functions is linearly $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{independent}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21683.json" "file_sha256" "09c9e03aafbe1728dab02d369fdd8b7881f021aec7f2146d806cdd5008df4422"} {"question" "e-21680" "field" nil "attribute" "question/problem" "value" "Compute the Wronskian $W(y_1, y_2)$ for $y_1(x) =2x$ and $y_2(x) = x^2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21680.json" "file_sha256" "9f0a63868f7e25707d89e58fa91019b26db231ac2974998c496d74298574debb"} {"question" "e-21680" "field" nil "attribute" "question/worked-solution" "value" "The Wronskian $W(y_1,y_2)$ of two functions $y_1(x)$ and $y_2(x)$ is defined as\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/assets/8c9f75d71e362ec7207e00f67adecae7193e35972e46a783faa5aa1ea6c00301.png)\n\nIn our case, we have $y_1(x) = 2x$ and $y_2(x) = x^2.$ Therefore,\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =2x{({x}^{2})}^{′}-{x}^{2}{(2x)}^{′} \\\\  & =4{x}^{2}-2{x}^{2} \\\\  & =2{x}^{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21680.json" "file_sha256" "9f0a63868f7e25707d89e58fa91019b26db231ac2974998c496d74298574debb"} {"question" "e-21681" "field" nil "attribute" "question/problem" "value" "$$\ny_1(x) = x^2 + 1, \\qquad\ny_2(x) = 2x, \\qquad x \\in \\mathbb R\n$$\n\nConsider the functions $y_1(x)$ and $y_2(x)$ above. Given that $y_1$ and $y_2$ are solutions of the same second-order linear differential equation, use the Wronskian to explain why the set $\\{ y_1(x), y_2(x) \\}$ is linearly independent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21681.json" "file_sha256" "33688d9af65e3a7bde8c840a9549eba68c23f371baa13d3228581515bdddbcfa"} {"question" "e-21681" "field" nil "attribute" "question/worked-solution" "value" "Suppose the functions $y_1(x)$ and $y_2(x)$ are defined on some interval $I.$\nThe Wronskian $W(y_1,y_2)$ of these functions is defined as\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/assets/19eae90f8f511056865f967ce8bf784261bd0f1b20cec65f478919e4b1c00078.png)\n\nRecall the following:\n\n- If $W \\neq 0$ for at least one $x \\in I,$ then $y_1$ and $y_2$ are linearly independent.\n\n- If $W = 0$ and it’s known that $y_1$ and $y_2$ are solutions to the same second-order linear differential equation, then $y_1$ and $y_2$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{x}^{2}+1 & 2x \\\\ ({x}^{2}+1)^{′} & (2x)^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{2}+1 & 2x \\\\ 2x & 2\\end{aligned}| \\\\  & =({x}^{2}+1)\\cdot 2-(2x)\\cdot (2x) \\\\  & =2({x}^{2}+1)-4{x}^{2} \\\\  & =2{x}^{2}+2-4{x}^{2} \\\\  & =2-2{x}^{2}\\end{aligned}\n$$\n\nwhich is nonzero for at least one $x \\in \\mathbb{R}.$\n\nTherefore, the set $\\left\\{ y_1(x), y_2(x) \\right\\}$ is linearly independent on $\\mathbb R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21681.json" "file_sha256" "33688d9af65e3a7bde8c840a9549eba68c23f371baa13d3228581515bdddbcfa"} {"question" "e-21682" "field" nil "attribute" "question/problem" "value" "Consider the differential equation $x^2y'' - 5x y' + 9y=0.$ Which of the following statements are true?\n\n- $y_1(x) = x^3$ is a solution to the equation for $x\\in \\mathbb R.$\n\n- $y_2(x) = x^3 \\ln x$ is a solution to the equation for $x > 0.$\n\n- The functions $y_1(x)$ and $y_2(x)$ form a set of fundamental solutions to the equation on $(0, \\infty).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21682.json" "file_sha256" "eac81cf48d61524ed621be3bf2998f701cb21420b9f4ded99ad67a3366d6368a"} {"question" "e-21682" "field" nil "attribute" "question/worked-solution" "value" "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation. \n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of $y_1(x){:}$\n\n$$\n\\begin{aligned}{y}_{1}^{′}(x) & =3{x}^{2} \\\\ {y}_{1}^{″}(x) & =6x\\end{aligned}\n$$\n\nNow, let's substitute $y_1(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot 6x-5x\\cdot 3{x}^{2}+9{x}^{3} & =0 \\\\ 6{x}^{3}-15{x}^{3}+9{x}^{3} & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, $y_1(x)$ is a solution to the equation.\n\n- Statement II is true. First, we find the first and second derivatives of $y_2(x){:}$\n\n$$\n\\begin{aligned}{y}_{2}^{′}(x) & =3{x}^{2}\\operatorname{ln}⁡x+{x}^{2} \\\\ {y}_{2}^{″}(x) & =6x\\operatorname{ln}⁡x+5x\\end{aligned}\n$$\n\nNow, let's substitute $y_2(x)$ and its derivatives into the equation:\n\n$$\n\\begin{aligned}{x}^{2}(6x\\operatorname{ln}⁡x+5x)-5x(3{x}^{2}\\operatorname{ln}⁡x+{x}^{2})+9{x}^{3}\\operatorname{ln}⁡x & =0 \\\\ (6{x}^{3}\\operatorname{ln}⁡x+5{x}^{3}-15{x}^{3}\\operatorname{ln}⁡x-5{x}^{3}+9{x}^{3}\\operatorname{ln}⁡x) & =0 \\\\ 0 & =0\\,✓\\end{aligned}\n$$\n\nSo, $y_2(x)$ is a solution to the equation.\n\n- Statement III is true. Both $y_1$ and $y_2$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n\n$$\n\\begin{aligned}W({y}_{1},{y}_{2}) & =|\\begin{aligned}{y}_{1} & {y}_{2} \\\\ {y}_{1}^{′} & {y}_{2}^{′}\\end{aligned}| \\\\  & =|\\begin{aligned}{x}^{3} & {x}^{3}\\operatorname{ln}⁡x \\\\ 3{x}^{2} & 3{x}^{2}\\operatorname{ln}⁡x+{x}^{2}\\end{aligned}| \\\\  & ={x}^{3}(3{x}^{2}\\operatorname{ln}⁡x+{x}^{2})-{x}^{3}\\operatorname{ln}⁡x\\cdot 3{x}^{2} \\\\  & =3{x}^{5}\\operatorname{ln}⁡x+{x}^{5}-3{x}^{5}\\operatorname{ln}⁡x \\\\  & ={x}^{5}\\end{aligned}\n$$\n\nSince the  Wronskian is not identically $0$ on $(0, \\infty),$ the functions are linearly independent. Hence, $y_1(x)$ and $y_2(x)$ form a set of fundamental solutions to the equation on $(0, \\infty)$.\n\nTherefore, the correct answer is \"I, II, and III\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14062380/example-21682.json" "file_sha256" "eac81cf48d61524ed621be3bf2998f701cb21420b9f4ded99ad67a3366d6368a"}] "usage" {"q-333508" [] "q-333522" [] "e-21681" [] "q-333520" [] "e-21682" [] "e-21683" [] "e-21680" [] "q-333517" []} "basis" 2002 "retractions" [[17592186152482 :question/problem "Given the set of functions ${x, e^{x}, 2x}$ defined on $x ∈ R$, select the correct options in the following reasoning.For all $x ∈ R$, we have that\n$2$ {{field-1}} {{field-2}} {{field-3}}"] [17592186152484 :question/problem "$y_{1}(x) = e^{2x + 1}, y_{2}(x) = e^{2x}, x ∈ R$\nConsider the functions $y_{1}(x)$ and $y_{2}(x)$ above. Given that $y_{1}$ and $y_{2}$ are solutions of the same second-order linear differential equation, select the correct options in the reasoning below. The Wronskian is $W(y_{1}, y_{2}) =$\n{{field-1}},\nwhich is\n{{field-2}}.\n\nTherefore, the set ${y_{1}(x), y_{2}(x)}$ is linearly\n{{field-3}}\non $R$."] [17592186152487 :question/problem "$y^{″} + 7y^{′} + 6y = 0$\nConsider the differential equation above. Which of the following statements are true?\n\n1. $y_{1}(x) = e^{-x}$ is a solution to the equation.\n2. $y_{2}(x) = 1 + e^{-x}$ is a solution to the equation.\n3. The functions $y_{1}(x)$ and $y_{2}(x)$ form a set of fundamental solutions to the equation."] [17592186152486 :question/problem "$y^{″} + y = 0$\nConsider the differential equation above. Which of the following statements are true?\n\n1. $y_{1}(x) = \\sin (x)$ is a solution to the equation.\n2. $y_{2}(x) = 3\\sin (x)$ is a solution to the equation.\n3. The functions $y_{1}(x)$ and $y_{2}(x)$ form a set of fundamental solutions to the equation."] [17592186151833 :question/problem "Given the set of functions $\\{e^x, \\, \\sin x \\}$ defined on $x \\in \\mathbb{R}$, explain why they are linearly independent."] [17592186151833 :question/worked-solution "Recall that the set of functions $\\{f_1(x), f_2(x), \\ldots, f_n(x) \\}$, which are defined on some interval $I$, is *linearly dependent* if there exist real scalars $k_1,k_2,\\ldots,k_n$ not all zero such that the linear combination $k_1 \\cdot f_1 + k_2 \\cdot f_2 + \\ldots + k_2 \\cdot f_2$ is identically zero, i.e,\n\n$$\nk_1 \\cdot f_1(x) + k_2 \\cdot f_2(x) + \\ldots + k_2 \\cdot f_2(x) = 0\n$$\n\nfor all $x \\in I$. Otherwise, if\n\n$$\nk_1 = k_2 = \\cdots = k_n = 0\n$$\n\nis the only solution, the set is *linearly independent*.\n\nNow, suppose for all $x \\in \\mathbb{R}$, we have that\n\n$$\nk_1 e^x + k_2 \\sin x = 0\n$$\n\nFor example:\n\n- If $x=0$, we get\n$k_{1}(e^{0}) + k_{2}(\\sin 0) = 0; k_{1} \\cdot 1 + k_{2} \\cdot 0 = 0⇒k_{1} = 0$.\n- If $x=1$, we get\n$k_{1}(e^{1}) + k_{2}(\\sin 1) = 0; ek_{1} + (\\sin 1)k_{2} = 0⇒ek_{1} + (\\sin 1)k_{2} = 0$.\n\nThus, we obtain the following system of linear equations:\n\n$$\n{k_{1} = 0; ek_{1} + (\\sin 1)k_{2} = 0\n$$\n\nThe only solution for this system is\n\n$$\n\\bbox[4pt, border: solid 1pt gainsboro]{k_1=k_2=0}\n$$\n\nTherefore, since $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{all}}$ the scalar coefficients in the linear combination must be zero, the given set of functions is linearly $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{independent}}$."] [17592186151830 :question/problem "Compute the Wronskian $W(y_1, y_2)$ for $y_1(x) =2x$ and $y_2(x) = x^2$."] [17592186151830 :question/worked-solution "The Wronskian $W(y_1,y_2)$ of two functions $y_1(x)$ and $y_2(x)$ is defined as\n\n$$\n\\begin{bmatrix}y_{1} & y_{2} \\\\ y_{1}^{′} & y_{2}^{′}\\end{bmatrix}\n$$\n\nIn our case, we have $y_1(x) = 2x$ and\n\n$$\ny_2(x) = x^2\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nW(y_{1}, y_{2}) &= 2x(x^{2})^{′} - x^{2}(2x)^{′} \\\\\n&= 4x^{2} - 2x^{2} \\\\\n&= 2x^{2}\n\\end{aligned}\n$$"] [17592186151831 :question/problem "$y_1(x) = x^2 + 1, \\qquad y_2(x) = 2x, \\qquad x \\in \\mathbb R$\nConsider the functions $y_1(x)$ and $y_2(x)$ above. Given that $y_1$ and $y_2$ are solutions of the same second-order linear differential equation, use the Wronskian to explain why the set $\\{y_1(x), y_2(x) \\}$ is linearly independent."] [17592186151831 :question/worked-solution "Suppose the functions $y_1(x)$ and $y_2(x)$ are defined on some interval $I$.\nThe Wronskian $W(y_1,y_2)$ of these functions is defined as\n$\\begin{vmatrix}y_{1} & y_{2} \\\\ y_{1}^{′} & y_{2}^{′}\\end{vmatrix}$\n\nRecall the following:\n\n- If $W \\neq 0$ for at least one $x \\in I$, then $y_1$ and $y_2$ are linearly independent.\n- If $W = 0$ and it’s known that $y_1$ and $y_2$ are solutions to the same second-order linear differential equation, then $y_1$ and $y_2$ are linearly dependent.\n\nIn our case, the Wronskian is given by\n\n$$\n\\begin{aligned}\nW(y_{1}, y_{2}) &= \\begin{vmatrix}x^{2} + 1 & 2x \\\\ (x^{2} + 1)^{′} & (2x)^{′}\\end{vmatrix} \\\\\n&=\\begin{vmatrix}x^{2} + 1 & 2x \\\\ 2x & 2\\end{vmatrix} \\\\\n&= (x^{2} + 1) \\cdot 2 - (2x) \\cdot (2x) \\\\\n&= 2(x^{2} + 1) - 4x^{2} \\\\\n&= 2x^{2} + 2 - 4x^{2} \\\\\n&= 2 - 2x^{2}\n\\end{aligned}\n$$\n\nwhich is nonzero for at least one $x \\in \\mathbb{R}$.\n\nTherefore, the set\n\n$$\n\\left\\{y_1(x), y_2(x) \\right\\}\n$$\n\nis linearly independent on $\\mathbb R$."] [17592186151832 :question/problem "Consider the differential equation $x^2y'' - 5x y' + 9y=0$. Which of the following statements are true?\n\n1. $y_1(x) = x^3$ is a solution to the equation for $x\\in \\mathbb R$.\n2. $y_2(x) = x^3 \\ln x$ is a solution to the equation for $x > 0$.\n3. The functions $y_1(x)$ and $y_2(x)$ form a set of fundamental solutions to the equation on $(0, \\infty)$."] [17592186151832 :question/worked-solution "Recall that to determine whether $y(x)$ is a solution to the differential equation, we substitute $y$ and its derivatives into the equation.\n\nLet's check each statement in turn.\n\n- Statement I is true. First, we find the first and second derivatives of $y_1(x){:}$\n$y_{1}^{′}(x)|= 3x^{2}; y_{1}^{″}(x)|= 6x$\nNow, let's substitute $y_1(x)$ and its derivatives into the equation:\n$x^{2} \\cdot 6x - 5x \\cdot 3x^{2} + 9x^{3}|= 0; 6x^{3} - 15x^{3} + 9x^{3}|= 0; 0|= 0✓$\nSo, $y_1(x)$ is a solution to the equation.\n- Statement II is true. First, we find the first and second derivatives of $y_2(x){:}$\n$y_{2}^{′}(x)|= 3x^{2}\\ln x + x^{2}; y_{2}^{″}(x)|= 6x\\ln x + 5x$\nNow, let's substitute $y_2(x)$ and its derivatives into the equation:\n$x^{2}(6x\\ln x + 5x) - 5x(3x^{2}\\ln x + x^{2}) + 9x^{3}\\ln x|= 0; (6x^{3}\\ln x + 5x^{3} - 15x^{3}\\ln x - 5x^{3} + 9x^{3}\\ln x)|= 0; 0|= 0✓$\nSo, $y_2(x)$ is a solution to the equation.\n- Statement III is true. Both $y_1$ and $y_2$ are solutions of the equation. To check if these functions are linearly independent, we compute the Wronskian:\n$W(y_{1}, y_{2})|=\\begin{vmatrix}y_{1} & y_{2} \\\\ y_{1}^{′} & y_{2}^{′}\\end{vmatrix}; =\\begin{vmatrix}x^{3} & x^{3}\\ln x \\\\ 3x^{2} & 3x^{2}\\ln x + x^{2}\\end{vmatrix}; = x^{3}(3x^{2}\\ln x + x^{2}) - x^{3}\\ln x \\cdot 3x^{2}; = 3x^{5}\\ln x + x^{5} - 3x^{5}\\ln x; = x^{5}$\nSince the Wronskian is not identically $0$ on $(0, \\infty)$, the functions are linearly independent. Hence, $y_1(x)$ and $y_2(x)$ form a set of fundamental solutions to the equation on $(0, \\infty)$.\n\nTherefore, the correct answer is \"I, II, and III\"."]] "immutable_answers" [17592186149733 17592186149734 17592186149735 17592186149737 17592186149738 17592186149739 17592186149741 17592186149742 17592186149743 17592186149755 17592186149756 17592186149758 17592186149759 17592186149761 17592186149762 17592186149763 17592186149764 17592186149777 17592186149778 17592186149779 17592186149780 17592186149781 17592186149783 17592186149784 17592186149785 17592186149786 17592186149787] "immutable_fields" [[17592186149732 :answer-field/id] [17592186149732 :answer-field/key] [17592186149732 :answer-field/type] [17592186149736 :answer-field/id] [17592186149736 :answer-field/key] [17592186149736 :answer-field/type] [17592186149740 :answer-field/id] [17592186149740 :answer-field/key] [17592186149740 :answer-field/type] [17592186149754 :answer-field/id] [17592186149754 :answer-field/key] [17592186149754 :answer-field/type] [17592186149757 :answer-field/id] [17592186149757 :answer-field/key] [17592186149757 :answer-field/type] [17592186149760 :answer-field/id] [17592186149760 :answer-field/key] [17592186149760 :answer-field/type] [17592186149776 :answer-field/correct] [17592186149776 :answer-field/id] [17592186149776 :answer-field/key] [1759218614977