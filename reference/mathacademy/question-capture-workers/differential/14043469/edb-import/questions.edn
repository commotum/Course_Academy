#{[{:db/id #edb/ref 17592186147297 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "51f6b682-ce7e-5068-8679-06a452eed647" :knowledge-point/title "Calculating the Laplace Transform of the Derivative of a Function"}] :question/id #uuid "25c2b366-fa9e-538f-9971-d3a47e7a6384" :question/math-academy-id "e-6648" :question/problem "Find the Laplace transform of $f'(t)$ for $s > 3$ given that the function $f(t)$ is continuous over $[MATH: [0,\\infty),]$ $f(0)=0$, and\n$\\mathcal{L}\\left\\{f(t)\\right\\} = \\dfrac{6}{s^2-5s+6}, \\quad s>3$.\nAssume that $f'$ is piecewise continuous on $[MATH: [0,\\infty).]$" :question/worked-solution "Suppose\n\n$$\nF(s) = \\mathcal L \\{f(t)\\}\n$$\n\nwhere $f(t)$ is a continuous function of exponential order $a$ on $[MATH: [0,\\infty).]$ If $f'(t)$ is piecewise continuous on $[MATH: [0,\\infty),]$ then\n\n$$\n\\mathcal{L}\\left\\{f'(t) \\right\\} = s \\mathcal{L}\\left\\{f(t) \\right\\} - f(0)\n$$\n\nTherefore, we can calculate the Laplace transform of $f'(t)$ as follows:\n\n$$\n\\begin{aligned}\nL{f^{′}(t)} &= sL{f(t)} - f(0) \\\\\n&= s \\cdot \\frac{6}{s^{2} - 5s + 6} - 0 \\\\\n&= \\frac{6s}{s^{2} - 5s + 6}\n\\end{aligned}\n$$\n\nvalid for $s > 3$."}] [{:db/id #edb/ref 17592186147298 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9e59d43c-f723-521e-b7cf-6767195483c2" :knowledge-point/title "Calculating the Laplace Transform of the Second Derivative of a Function"}] :question/id #uuid "d058e1e9-5881-568b-bb28-bab5d6299f53" :question/math-academy-id "e-6649" :question/problem "Find the Laplace transform $\\mathcal{L}\\left\\{f''(t) \\right\\}$ for $s > 0$, given that the function $f(t)$ is continuous on $[MATH: [0,\\infty),]$ $f'(0)=2$, $f(0)=-1$, and\n$\\mathcal{L}\\left\\{f(t)\\right\\} = \\dfrac{2 - s}{s^2+4}, \\quad s>0$.\nAssume that $f'$ is continuous and $f''$ piecewise continuous on $[MATH: [0,\\infty).]$" :question/worked-solution "Suppose\n\n$$\nF(s) = \\mathcal L \\{f(t)\\}\n$$\n\nwhere $f(t)$ is a continuous function of exponential order $a$ on $[MATH: [0,\\infty).]$ If $f'(t)$ is continuous and $f''(t)$ is piecewise continuous on $[MATH: [0,\\infty),]$ then\n\n$$\n\\begin{aligned}\nL{f^{″}(t)} &= s^{2}L{f(t)} - sf(0) - f^{′}(0)\n\\end{aligned}\n$$\n\nTherefore, we can calculate the Laplace transform of $f''(t)$ as follows:\n\n$$\n\\begin{aligned}\nL{f^{″}(t)} &= s^{2}L{f(t)} - sf(0) - f^{′}(0) \\\\\n&= s^{2} \\cdot \\frac{2 - s}{s^{2} + 4} - s \\cdot (-1) - 2 \\\\\n&= (s^{2}(2 - s))/(s^{2} + 4) + s - 2 \\\\\n&= - (s^{2}(s - 2))/(s^{2} + 4) + (s - 2) \\\\\n&= (s - 2)(-\\frac{s^{2}}{s^{2} + 4} + 1) \\\\\n&= (s - 2)(\\frac{4}{s^{2} + 4}) \\\\\n&= (4(s - 2))/(s^{2} + 4)\n\\end{aligned}\n$$\n\nvalid for $s > 0$."}] [{:db/id #edb/ref 17592186148091 :knowledge-point/_questions [{:knowledge-point/id #uuid "51f6b682-ce7e-5068-8679-06a452eed647" :knowledge-point/title "Calculating the Laplace Transform of the Derivative of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d33e90cf-07ba-515a-8535-445322fdc5a8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s - 4}{s^{2} - s - 6}" :db/id #edb/ref 17592186146558} {:answer/id #uuid "d64b8332-e097-5be2-be20-076635f75270" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2s^{2} - s}{s^{2} - s - 6}" :db/id #edb/ref 17592186146559} {:answer/id #uuid "eb86d195-0d98-5e9b-95fc-9547c8ea1265" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2s - 6}{s^{2} - s - 6}" :db/id #edb/ref 17592186146560} {:answer/id #uuid "39b8ce07-5403-52c0-8e5a-fc28cf7dbbb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s + 12}{s^{2} - s - 6}" :db/id #edb/ref 17592186146561} {:answer/id #uuid "6c035a1d-6e4b-5f23-ab12-4163763f6107" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s^{2} + 4s}{s^{2} - s - 6}" :db/id #edb/ref 17592186146562}] :answer-field/correct {:answer/id #uuid "39b8ce07-5403-52c0-8e5a-fc28cf7dbbb4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s + 12}{s^{2} - s - 6}" :db/id #edb/ref 17592186146561} :answer-field/id #uuid "15f8574b-f786-5061-88d0-0ef9065ac52c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186146557}] :question/id #uuid "913f679e-4235-5b45-a322-524d851b8bf5" :question/math-academy-id "q-64323" :question/problem "Find the Laplace transform of $f^{′}(t)$ for $s > 3$ given that the function $f(t)$ is continuous over $[MATH: [0, ∞),]$ $f(0) = 2$, and\n\n$L{f(t)} = \\frac{2s - 1}{s^{2} - s - 6}, s > 3$.\nAssume that $f^{′}$ is piecewise continuous on $[MATH: [0, ∞).]$"}]}
