1626cb18cef8b52189ca0dc031174ad28a1"] :db/ensure [:answer-field/validate]} {:db/id "q-80462" :question/id #uuid "4adae4a1-2b74-58fe-abb4-b356d959e36c" :question/math-academy-id "q-80462" :question/problem "If ${F}^{′}(t)=⟨3{t}^{2}-5,\\,\\frac{1}{t}⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨3{t}^{2}-5,\\,\\frac{1}{t}⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨3{t}^{2}-5,\\,\\frac{1}{t}⟩\\text{d}t & =⟨\\int (3{t}^{2}-5)\\,\\text{d}t,\\int \\frac{1}{t}\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}-5t+{c}_{1},\\,\\operatorname{ln}⁡|t|+{c}_{2}⟩ \\\\  & =⟨{t}^{3}-5t,\\,\\operatorname{ln}⁡|t|⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{t}^{3}-5t,\\,\\operatorname{ln}⁡|t|⟩+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary (vector) constant of integration." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80462/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea"] :knowledge-point/questions ["q-80462"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80463/selection/ef5eb4201f4569e7167aadd0da1f1cb4f4404b50f51e88c05d9a0542ff1c028b" :answer/id #uuid "dca9ce97-ee20-5cbe-9fe4-8f2c57858563" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{sin}⁡t,\\,-\\operatorname{cos}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-80463/selection/98e6c5e8e1897865965399c092a7a84957bb5d093970ecfbf2595be209afbc87" :answer/id #uuid "0edd8566-357e-5796-83ba-1da8b62e7650" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{cot}⁡t,\\,\\operatorname{cos}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-80463/selection/47692a1e079b2e1b1840ddfbc42a3e8919e928bcdff93c2fe9e5a54fae1c1128" :answer/id #uuid "14dd103f-69e8-5966-9e39-41a6ca90cf76" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{cot}⁡t,\\,\\operatorname{sin}⁡t⟩+C" :db/ensure 