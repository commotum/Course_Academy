c}_{2}⟩ \\\\  & =⟨-\\operatorname{cot}⁡t,\\,\\operatorname{sin}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨-\\operatorname{cot}⁡t,\\,\\operatorname{sin}⁡t⟩+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary (vector) constant of integration." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80463/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea"] :knowledge-point/questions ["q-80463"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123320/selection/a4a7b73f7c7743bcb9d7ecbbaeb19f75f470df81a03810a2de817c28f52b62b9" :answer/id #uuid "89d996e9-9acc-574a-bbef-ad333b8a2306" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{cot}⁡t,\\,-\\operatorname{cos}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123320/selection/fe5fab0c2fa226f536686d49d322ce67e34e608b3a592d55ec3216660abac817" :answer/id #uuid "f3aa2883-0b9d-5fb5-ba7d-c8f4d81885ce" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{cot}⁡(2t),\\,{sin}^{2}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123320/selection/0134967ade583877fa8c4253ab3b9bcae8d7f6649e9b016fd7221495944fa101" :answer/id #uuid "57f86693-d0c9-5197-a2fa-6957664c987c" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{cot}⁡t,\\,{cos}^{2}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123320/selection/fcceb3c3b238c018d5e9dee442d0cf3e2fa85c45381fbe13530604d76bf2414b" :answer/id #uuid "93c0cbab-c639-5c24-ba08-925b751df106" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{csc}⁡t,\\,-\\operatorname{cos}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123320/selection/44ebf90137f6b58b213758284e9d7562c2405b5ed497f470c7d176d417b1ebc0" :answer/id #uuid "879ffb98-166e-5021-af99-d6f669ca6e00" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{tan}⁡t,\\,-\\operatorname{cos}⁡t⟩+C" :db/ensure [:answer/validate]} {:db/id "q-123320/selection" :answer-field/id #uuid "308e1365-bc5a-5995-8534-adfad73ed0d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123320/selection/a4a7b73f7c7743bcb9d7ecbbaeb19f75f470df81a03810a2de817c28f52b62b9" :answer-field/choices ["q-123320/selection/a4a7b73f7c7743bcb9d7ecbbaeb19f75f470df81a03810a2de817c28f52b62b9" "q-123320/selection/fe5fab0c2fa226f536686d49d322ce67e34e608b3a592d55ec3216660abac817" "q-123320/selection/0134967ade583877fa8c4253ab3b9bcae8d7f6649e9b016fd7221495944fa101" "q-123320/selection/fcceb3c3b238c018d5e9dee442d0cf3e2fa85c45381fbe13530604d76bf2414b" "q-123320/selection/44ebf90137f6b58b213758284e9d7562c2405b5ed497f470c7d176d417b1ebc0"] :db/ensure [:answer-field/validate]} {:db/id "q-123320" :question/id #uuid "83aa510b-e988-5498-be95-547a695eb498" :question/math-academy-id "q-123320" :question/problem "If ${F}^{′}(t)=⟨{csc}^{2}⁡t,\\,\\operatorname{sin}⁡t⟩,$ then $F(t)=$" :question/worked-solution "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨{csc}^{2}⁡t,\\,\\operatorname{sin}⁡t⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨{csc}^{2}⁡t,\\,\\operatorname{sin}⁡t⟩\\text{d}t & =⟨\\int {csc}^{2}⁡t\\,\\text{d}t,\\int (\\operatorname{sin}⁡t)\\,\\text{d}t⟩ \\\\  & =⟨-\\operatorname{cot}⁡t+{c}_{1},\\,-\\operatorname{cos}⁡t+{c}_{2}⟩ \\\\  & =⟨-\\operatorname{cot}⁡t,\\,-\\operatorname{cos}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨-\\operatorname{cot}⁡t,\\,-\\operatorname{cos}⁡t⟩+C,\\end{aligned}\n$$\n\n \n\nwhere $C$ is an arbitrary (vector) constant of integration." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123320/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9688df89-056e-59d7-869e-9841715b2aea"] :knowledge-point/questions ["q-123320"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99263/selection/1128728f8e2f8a3fdb4b403cccf37beea2e302710436f495d552cdd9c222e552" :answer/id #uuid "14ed6fba-faef-52f5-9de1-b72e1bf595c