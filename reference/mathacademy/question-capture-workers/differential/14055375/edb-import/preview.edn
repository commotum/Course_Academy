operatorname{tan}⁡t\\,\\text{d}t,\\,\\int 6t{e}^{({t}^{2}-1)}\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)=\\operatorname{sec}⁡t\\operatorname{tan}⁡t,$ we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t=\\int \\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,\\text{d}t=\\operatorname{sec}⁡t+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)=6t{e}^{({t}^{2}-1)},$ we calculate its integral using substitution. So, we let $u={t}^{2}-1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2t\\,⟹\\,\\text{d}t=\\frac{1}{2t}\\,\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t & =\\int 6t{e}^{({t}^{2}-1)}\\,\\text{d}t \\\\  & =\\int 6t{e}^{u}\\cdot \\frac{1}{2t}\\,\\text{d}u \\\\  & =3\\int {e}^{u}\\,\\text{d}u \\\\  & =3{e}^{u}+{c}_{2} \\\\  & =3{e}^{{t}^{2}-1}+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get \n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,6t{e}^{({t}^{2}-1)}⟩\\,\\text{d}t & =⟨\\operatorname{sec}⁡t+{c}_{1},\\,3{e}^{{t}^{2}-1}+{c}_{2}⟩ \\\\  & =⟨\\operatorname{sec}⁡t,\\,3{e}^{{t}^{2}-1}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨\\operatorname{sec}⁡t,\\,3{e}^{{t}^{2}-1}⟩+C.\\end{aligned}\n$$" 13194139535133 true] [17592186332929 1000 #edb/ref 17592186332930 13194139535133 true] [17592186332929 1000 #edb/ref 17592186332931 13194139535133 true] [17592186332929 1000 #edb/ref 17592186332932 13194139535133 true] [17592186332929 1000 #edb/ref 17592186332933 13194139535133 true] [17592186332929 1000 #edb/ref 17592186332934 13194139535133 true] [17592186332929 1040 #edb/ref 17592186045450 13194139535133 true] [17592186332929 1041 "selection" 13194139535133 true] [17592186332929 1104 #edb/ref 17592186332931 13194139535133 true] [17592186332929 1110 #uuid "c6fe81d9-832d-50de-b858-d79aa164d2fd" 13194139535133 true] [17592186332930 1034 "⟨\\operatorname{sec}⁡t,\\,3t{e}^{{t}^{2}-1}⟩+C" 13194139535133 true] [17592186332930 1103 #edb/ref 17592186045453 13194139535133 true] [17592186332930 1111 #uuid "52ce1447-b0e5-5f2a-987c-362f6d0d46e6" 