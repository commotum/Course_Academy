bf9e6d3c093f93f7686b6d22ff4c580be1dacb" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "q-123224" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "⟨\\operatorname{sec}⁡t,\\,\\operatorname{cos}⁡t⟩+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/state.json" "file_sha256" "7607ec4719b83b778accc6f508bf9e6d3c093f93f7686b6d22ff4c580be1dacb" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "q-123224" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,-\\operatorname{cos}⁡t⟩+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/state.json" "file_sha256" "7607ec4719b83b778accc6f508bf9e6d3c093f93f7686b6d22ff4c580be1dacb" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "q-123224" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨\\operatorname{sec}⁡t,\\,\\operatorname{cos}⁡t⟩+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/state.json" "file_sha256" "7607ec4719b83b778accc6f508bf9e6d3c093f93f7686b6d22ff4c580be1dacb" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-612" "field" nil "attribute" "question/problem" "value" "Find $\\mathbf F(t)$ given that $\\mathbf F'(t)= \\langle 6t^5+2t, \\sec^2 t\\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-612.json" "file_sha256" "ec683e0e44404b80ace907bb8362259b54d74de85f7391fcfcca3993673ae482" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-612" "field" nil "attribute" "question/worked-solution" "value" "Note that \n\n$$\n\\mathbf F(t)=\\int \\mathbf F'(t)\\, \\textrm d t=\\int \\left\\langle 6t^5+2t,\\, \\sec^2 t\\right\\rangle \\, \\textrm d t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨6{t}^{5}+2t,\\,{sec}^{2}⁡t⟩\\,\\text{d}t & =⟨\\int (6{t}^{5}+2t)\\,\\text{d}t,\\,\\int {sec}^{2}⁡t\\,\\text{d}t⟩ \\\\  & =⟨{t}^{6}+{t}^{2}+{c}_{1},\\,\\operatorname{tan}⁡t+{c}_{2}⟩ \\\\  & =⟨{t}^{6}+{t}^{2},\\,\\operatorname{tan}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{t}^{6}+{t}^{2},\\,\\operatorname{tan}⁡t⟩+C,\\end{aligned}\n$$\n\nwhere $\\mathbf C$ is an arbitrary (vector) constant of integration." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-612.json" "file_sha256" "ec683e0e44404b80ace907bb8362259b54d74de85f7391fcfcca3993673ae482" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-613" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\int \\left\\langle\\cos(2t+1), \\, 4\\right\\rangle \\,\\textrm d t\\,.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-613.json" "file_sha256" "63f6e79a69492d8dcdd580a66b619986cee3548f49cd7f536b8ba6b51b68a66c" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-613" "field" nil "attribute" "question/worked-solution" "value" "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{cos}⁡(2t+1),\\,4⟩\\,\\text{d}t=⟨\\int \\operatorname{cos}⁡(2t+1)\\,\\text{d}t,\\,\\int 4\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t) =\\cos(2t+1),$ we calculate its integral using substitution. So, we let $u= 2t +1.$ Then\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d t} = 2\\quad\\Longrightarrow\\quad \\textrm d t = \\dfrac 1 2 \\textrm d u.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t & =\\int \\operatorname{cos}⁡(2t+1)\\,\\text{d}t \\\\  & =\\int \\operatorname{cos}⁡u\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡u)+{c}_{1} \\\\  & =\\frac{1}{2}\\operatorname{sin}⁡(2t+1)+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t) =4,$ we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t=\\int 4\\text{d}t=4t+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{cos}⁡(2t+1),\\,4⟩\\,\\text{d}t & =⟨\\frac{1}{2}\\operatorname{sin}⁡(2t+1)+{c}_{1},\\,4t+{c}_{2}⟩ \\\\  & =⟨\\frac{1}{2}\\operatorname{sin}⁡(2t+1),\\,4t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨\\frac{1}{2}\\operatorname{sin}⁡(2t+1),\\,4t⟩+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-613.json" "file_sha256" "63f6e79a69492d8dcdd580a66b619986cee3548f49cd7f536b8ba6b51b68a66c" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-614" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int_0^{2} \\left\\langle 2e^{t},\\, 6t^2\\right\\rangle\\, \\textrm d t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-614.json" "file_sha256" "e06cc9fbe8326e46624ec2b01d77e0253032f85aecbe56ee77695764d60d3c71" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-614" "field" nil "attribute" "question/worked-solution" "value" "To integrate a vector-valued function, we integrate each component separately: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}⟨2{e}^{t},\\,6{t}^{2}⟩\\,\\text{d}t & =⟨{\\int }_{0}^{2}2{e}^{t}\\,\\text{d}t,\\,{\\int }_{0}^{2}6{t}^{2}\\,\\text{d}t⟩. \\\\  & =⟨2{e}^{t}\\,\\,{|}_{0}^{2},\\,2{t}^{3}\\,\\,{|}_{0}^{2}⟩ \\\\  & =⟨[2{e}^{2}-2{e}^{0}],\\,[2\\cdot {2}^{3}-0]⟩ \\\\  & =⟨2{e}^{2}-2,\\,16⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-614.json" "file_sha256" "e06cc9fbe8326e46624ec2b01d77e0253032f85aecbe56ee77695764d60d3c71" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-615" "field" nil "attribute" "question/problem" "value" "Calculate $\\mathbf F(t)$ given that $\\mathbf F'(t)= \\left\\langle \\sec t \\tan t, \\,  \\sin(2t)\\right\\rangle$ and $\\mathbf F(0)=\\langle 0,\\, 0\\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-615.json" "file_sha256" "6012dbcb57e1484eacbc19e8f20cbb775bab59b29682f455a53c4b90bc903124" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"} {"question" "e-615" "field" nil "attribute" "question/worked-solution" "value" "Note that \n\n$$\n\\mathbf F(t)=\\int \\mathbf F'(t)\\, \\textrm d t=\\int \\left\\langle \\sec t \\tan t,\\,  \\sin(2t)\\right\\rangle \\, \\textrm d t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we have\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,\\operatorname{sin}⁡(2t)⟩\\,\\text{d}t & =⟨\\int \\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,\\text{d}t,\\int \\operatorname{sin}⁡(2t)\\,\\text{d}t⟩ \\\\  & =⟨\\operatorname{sec}⁡t+{c}_{1},\\,-\\frac{1}{2}\\operatorname{cos}⁡(2t)+{c}_{2}⟩.\\end{aligned}\n$$\n\nThe initial condition $\\mathbf F(0)=\\left\\langle 0,\\, 0 \\right\\rangle$ gives\n\n$$\n\\begin{aligned}F(0)=⟨\\operatorname{sec}⁡0+{c}_{1},\\,-\\frac{1}{2}\\operatorname{cos}⁡(2\\cdot 0)+{c}_{2}⟩ & =⟨0,\\,0⟩ \\\\ ⟨1+{c}_{1},\\,-\\frac{1}{2}+{c}_{2}⟩ & =⟨0,\\,0⟩.\\end{aligned}\n$$\n\nTherefore, $c_1=-1$ and $c_2=\\dfrac 12.$ Consequently, \n\n$$\n\\mathbf F(t)=\\left\\langle  \\sec t - 1  , \\,  -\\dfrac 1 2\\cos(2t)+ \\dfrac12\\right\\rangle.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/example-615.json" "file_sha256" "6012dbcb57e1484eacbc19e8f20cbb775bab59b29682f455a53c4b90bc903124" "basis" 1276 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14037744/edb-import/verification.json"}] "sources" [{"question" "q-80462" "field" nil "attribute" "question/problem" "value" "If ${F}^{′}(t)=⟨3{t}^{2}-5,\\,\\frac{1}{t}⟩,$ then $F(t)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-80462" "field" nil "attribute" "question/worked-solution" "value" "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨3{t}^{2}-5,\\,\\frac{1}{t}⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨3{t}^{2}-5,\\,\\frac{1}{t}⟩\\text{d}t & =⟨\\int (3{t}^{2}-5)\\,\\text{d}t,\\int \\frac{1}{t}\\,\\text{d}t⟩ \\\\  & =⟨{t}^{3}-5t+{c}_{1},\\,\\operatorname{ln}⁡|t|+{c}_{2}⟩ \\\\  & =⟨{t}^{3}-5t,\\,\\operatorname{ln}⁡|t|⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{t}^{3}-5t,\\,\\operatorname{ln}⁡|t|⟩+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary (vector) constant of integration." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-80462" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/activity-metadata.json" "file_sha256" "04eca659e09dc9a77301cd7af598024ca582eee954e6337d97e460da43fbcc92"} {"question" "q-80462" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-80462" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨6t,\\,-\\frac{1}{{t}^{2}}⟩+C"] ["math" "⟨6t,\\,\\operatorname{ln}⁡|t|⟩+C"] ["math" "⟨{t}^{3}-5,\\,\\operatorname{ln}⁡|t|⟩+C"] ["math" "⟨{t}^{3}-5t,\\,-\\frac{1}{{t}^{2}}⟩+C"] ["math" "⟨{t}^{3}-5t,\\,\\operatorname{ln}⁡|t|⟩+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-80462" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨{t}^{3}-5t,\\,\\operatorname{ln}⁡|t|⟩+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123224" "field" nil "attribute" "question/problem" "value" "If ${F}^{′}(t)=⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,-\\operatorname{sin}⁡t⟩,$ then $F(t)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123224" "field" nil "attribute" "question/worked-solution" "value" "First, we note that \n\n$$\nF(t)=\\int {F}^{′}(t)\\,\\text{d}t=\\int ⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,-\\operatorname{sin}⁡t⟩\\text{d}t.\n$$\n\nTo integrate a vector-valued function, we integrate each component separately. So, we get\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,-\\operatorname{sin}⁡t⟩\\text{d}t & =⟨\\int \\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,\\text{d}t,-\\int \\operatorname{sin}⁡t\\,\\text{d}t⟩ \\\\  & =⟨\\operatorname{sec}⁡t+{c}_{1},\\,\\operatorname{cos}⁡t+{c}_{2}⟩ \\\\  & =⟨\\operatorname{sec}⁡t,\\,\\operatorname{cos}⁡t⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨\\operatorname{sec}⁡t,\\,\\operatorname{cos}⁡t⟩+C,\\end{aligned}\n$$\n\nwhere $C$ is an arbitrary (vector) constant of integration." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123224" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/activity-metadata.json" "file_sha256" "04eca659e09dc9a77301cd7af598024ca582eee954e6337d97e460da43fbcc92"} {"question" "q-123224" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Develop