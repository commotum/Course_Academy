n}⁡t\\,\\text{d}t,\\,\\int 6t{e}^{({t}^{2}-1)}\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)=\\operatorname{sec}⁡t\\operatorname{tan}⁡t,$ we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t=\\int \\operatorname{sec}⁡t\\operatorname{tan}⁡t\\,\\text{d}t=\\operatorname{sec}⁡t+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)=6t{e}^{({t}^{2}-1)},$ we calculate its integral using substitution. So, we let $u={t}^{2}-1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2t\\,⟹\\,\\text{d}t=\\frac{1}{2t}\\,\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t & =\\int 6t{e}^{({t}^{2}-1)}\\,\\text{d}t \\\\  & =\\int 6t{e}^{u}\\cdot \\frac{1}{2t}\\,\\text{d}u \\\\  & =3\\int {e}^{u}\\,\\text{d}u \\\\  & =3{e}^{u}+{c}_{2} \\\\  & =3{e}^{{t}^{2}-1}+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get \n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{sec}⁡t\\operatorname{tan}⁡t,\\,6t{e}^{({t}^{2}-1)}⟩\\,\\text{d}t & =⟨\\operatorname{sec}⁡t+{c}_{1},\\,3{e}^{{t}^{2}-1}+{c}_{2}⟩ \\\\  & =⟨\\operatorname{sec}⁡t,\\,3{e}^{{t}^{2}-1}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨\\operatorname{sec}⁡t,\\,3{e}^{{t}^{2}-1}⟩+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123450" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/activity-metadata.json" "file_sha256" "04eca659e09dc9a77301cd7af598024ca582eee954e6337d97e460da43fbcc92"} {"question" "q-123450" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123450" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨\\operatorname{sec}⁡t,\\,2t{e}^{{t}^{2}-1}⟩+C"] ["math" "⟨\\operatorname{sec}⁡t,\\,3t{e}^{{t}^{2}-1}⟩+C"] ["math" "⟨\\operatorname{sec}⁡t,\\,3{e}^{{t}^{2}-1}⟩+C"] ["math" "⟨\\operatorname{tan}⁡t,\\,3{e}^{{t}^{2}-1}⟩+C"] ["math" "⟨\\operatorname{tan}⁡t,\\,6t{e}^{{t}^{2}-1}⟩+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123450" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨\\operatorname{sec}⁡t,\\,3{e}^{{t}^{2}-1}⟩+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-99378" "field" nil "attribute" "question/problem" "value" "Find $\\int ⟨\\operatorname{cos}⁡t,\\,3{e}^{(2t+1)}⟩\\,\\text{d}t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-99378" "field" nil "attribute" "question/worked-solution" "value" "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{cos}⁡t,\\,2{e}^{(2t+1)}⟩\\,\\text{d}t=⟨\\int \\operatorname{cos}⁡t\\,\\text{d}t,\\,\\int 2{e}^{(2t+1)}\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)=\\operatorname{cos}⁡t,$ we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t=\\int \\operatorname{cos}⁡t\\,\\text{d}t=\\operatorname{sin}⁡t+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)=2{e}^{(2t+1)},$ we calculate its integral using substitution. So, we let $u=2t+1.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2\\,⟹\\,\\text{d}t=\\frac{1}{2}\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t & =\\int 2{e}^{(2t+1)}\\,\\text{d}t \\\\  & =\\int 3{e}^{u}\\cdot \\frac{1}{2}\\,\\text{d}u \\\\  & =\\frac{3}{2}\\int {e}^{u}\\,\\text{d}u \\\\  & =\\frac{3}{2}{e}^{u}+{c}_{2} \\\\  & =\\frac{3{e}^{(2t+1)}}{2}+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get \n\n$$\n\\begin{aligned}\\int ⟨\\operatorname{cos}⁡t,\\,3{e}^{(2t+1)}⟩\\,\\text{d}t & =⟨\\operatorname{sin}⁡t+{c}_{1},\\,\\frac{3{e}^{(2t+1)}}{2}+{c}_{2}⟩ \\\\  & =⟨\\operatorname{sin}⁡t,\\,\\frac{3{e}^{(2t+1)}}{2}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨\\operatorname{sin}⁡t,\\,\\frac{3{e}^{(2t+1)}}{2}⟩+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-99378" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/activity-metadata.json" "file_sha256" "04eca659e09dc9a77301cd7af598024ca582eee954e6337d97e460da43fbcc92"} {"question" "q-99378" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-99378" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨\\,\\operatorname{cos}⁡t,\\,\\frac{3{e}^{(2t+1)}}{2}⟩+C"] ["math" "⟨\\,\\operatorname{cos}⁡t,\\,{e}^{(2t+1)}⟩+C"] ["math" "⟨\\operatorname{sin}⁡t,\\,\\frac{({e}^{2t}+e)}{2}⟩+C"] ["math" "⟨\\operatorname{sin}⁡t,\\,\\frac{3{e}^{(2t+1)}}{2}⟩+C"] ["math" "⟨\\operatorname{sin}⁡t,\\,{e}^{2t}⟩+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-99378" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨\\operatorname{sin}⁡t,\\,\\frac{3{e}^{(2t+1)}}{2}⟩+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-50201" "field" nil "attribute" "question/problem" "value" "Find $\\int ⟨\\frac{3}{t},\\frac{5}{{t}^{2}}⟩\\text{d}t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-50201" "field" nil "attribute" "question/worked-solution" "value" "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨\\frac{3}{t},\\,\\frac{5}{{t}^{2}}⟩\\,\\text{d}t & =⟨\\int \\frac{3}{t}\\,\\text{d}t,\\,\\int \\frac{5}{{t}^{2}}\\,\\text{d}t⟩ \\\\  & =⟨3\\operatorname{ln}⁡|t|+{c}_{1},\\,-\\frac{5}{t}+{c}_{2}⟩ \\\\  & =⟨3\\operatorname{ln}⁡|t|,\\,-\\frac{5}{t}⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨3\\operatorname{ln}⁡|t|,\\,-\\frac{5}{t}⟩+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-50201" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/activity-metadata.json" "file_sha256" "04eca659e09dc9a77301cd7af598024ca582eee954e6337d97e460da43fbcc92"} {"question" "q-50201" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-50201" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-⟨3\\operatorname{ln}⁡|t|,\\,\\frac{5}{t}⟩+C"] ["math" "⟨3\\operatorname{ln}⁡|t|,\\,-\\frac{5}{t}⟩+C"] ["math" "⟨3\\operatorname{ln}⁡|t|,\\,\\frac{5}{t}⟩+C"] ["math" "⟨\\operatorname{ln}⁡|t|,\\,-\\frac{5}{t}⟩+C"] ["math" "⟨\\operatorname{ln}⁡|t|,\\,\\frac{1}{t}⟩+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-50201" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨3\\operatorname{ln}⁡|t|,\\,-\\frac{5}{t}⟩+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123437" "field" nil "attribute" "question/problem" "value" "Find $\\int ⟨{e}^{t},\\,10\\operatorname{cos}⁡(2t-\\frac{\\pi }{6})⟩\\,\\text{d}t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123437" "field" nil "attribute" "question/worked-solution" "value" "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t},\\,10\\operatorname{cos}⁡(2t-\\frac{\\pi }{6})⟩\\text{d}t=⟨\\int {e}^{t}\\,\\text{d}t,\\,\\int 10\\operatorname{cos}⁡(2t-\\frac{\\pi }{6})\\,\\text{d}t⟩.\\end{aligned}\n$$\n\n- For $x(t)={e}^{t},$ we have\n\n$$\n\\begin{aligned}\\int x(t)\\,\\text{d}t=\\int {e}^{t}\\text{d}t={e}^{t}+{c}_{1}.\\end{aligned}\n$$\n\n- For $y(t)=10\\operatorname{cos}⁡(2t-\\frac{\\pi }{6}),$ we calculate its integral using substitution. So, we let $u=2t-\\frac{\\pi }{6}.$ Then\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=2\\,⟹\\,\\text{d}t=\\frac{1}{2}\\text{d}u.\n$$\n\nTherefore,  we have\n\n$$\n\\begin{aligned}\\int y(t)\\,\\text{d}t & =\\int 10\\operatorname{cos}⁡(2t-\\frac{\\pi }{6})\\,\\text{d}t \\\\  & =\\int 10\\operatorname{cos}⁡u\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{10}{2}\\int \\operatorname{cos}⁡u\\,\\text{d}u \\\\  & =5(\\operatorname{sin}⁡u)+{c}_{2} \\\\  & =5\\operatorname{sin}⁡(2t-\\frac{\\pi }{6})+{c}_{2}.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\int ⟨{e}^{t},\\,10\\operatorname{cos}⁡(2t-\\frac{\\pi }{6})⟩\\text{d}t & =⟨{e}^{t}+{c}_{1},\\,5\\operatorname{sin}⁡(2t-\\frac{\\pi }{6})+{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,5\\operatorname{sin}⁡(2t-\\frac{\\pi }{6})⟩+⟨{c}_{1},\\,{c}_{2}⟩ \\\\  & =⟨{e}^{t},\\,5\\operatorname{sin}⁡(2t-\\frac{\\pi }{6})⟩+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/state.json" "file_sha256" "c3966a8fb4d6c3ed445f7fd047396bd6ce60b6042d11d31c1d3ab32a30163a24"} {"question" "q-123437" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14055375/activity-metadata.json" "file_sha256" "04eca659e09dc9a77301cd7af598024ca582eee954e633