37b83f18ce44633ba8efd1e472d1eccc" :answer/id #uuid "338e341b-b05f-5e50-8677-dd5a18828f10" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{2}+{c}_{2}x" :db/ensure [:answer/validate]} {:db/id "q-64791/selection/828d77ba6987cdbf466148ba7ed372a0b55ca8bddee7d53d5ee77b3724da8360" :answer/id #uuid "2aed8dc2-1b57-525e-b179-1e999fc2db2d" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}+{c}_{2}{x}^{-1}" :db/ensure [:answer/validate]} {:db/id "q-64791/selection/a3bd175b88cfcca0cfc05ee488ca5f4ab483957f585e1a648f540cb8e4c8f1ce" :answer/id #uuid "c14c63e4-1233-5ad5-8300-c6ed0e1f27c6" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{-2}+{c}_{2}{x}^{-1}" :db/ensure [:answer/validate]} {:db/id "q-64791/selection/3db6780ca34df5e482cbf24ea595d7fe0832e6e9c10ed857d33bdc93ec8ab867" :answer/id #uuid "7ecc2869-f9e1-5173-ac74-68b429cfa113" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{2}+{c}_{2}{x}^{-2}" :db/ensure [:answer/validate]} {:db/id "q-64791/selection" :answer-field/id #uuid "a279ecf1-6871-5896-8878-30ba626c6891" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64791/selection/a3bd175b88cfcca0cfc05ee488ca5f4ab483957f585e1a648f540cb8e4c8f1ce" :answer-field/choices ["q-64791/selection/2db14263e4073fcbc9f8de59e7a7cac81c5927bcae929b01f39470d59fa5bbd3" "q-64791/selection/841e9f4865c024d746a58bc4532b305e37b83f18ce44633ba8efd1e472d1eccc" "q-64791/selection/828d77ba6987cdbf466148ba7ed372a0b55ca8bddee7d53d5ee77b3724da8360" "q-64791/selection/a3bd175b88cfcca0cfc05ee488ca5f4ab483957f585e1a648f540cb8e4c8f1ce" "q-64791/selection/3db6780ca34df5e482cbf24ea595d7fe0832e6e9c10ed857d33bdc93ec8ab867"] :db/ensure [:answer-field/validate]} {:db/id "q-64791" :question/id #uuid "73c50c67-0e36-56ac-9c4c-739cefc62453" :question/math-academy-id "q-64791" :question/problem "Find the general solution to the equation\n\n$$\n{x}^{2}{y}^{″}+4x{y}^{′}+2y=0,\\,x>0.\n$$" :question/worked-solution "Note that the given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}+4x\\cdot \\lambda {x}^{\\lambda -1}+2{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }+4\\lambda {x}^{\\lambda }+2{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[\\lambda (\\lambda -1)+4\\lambda +2] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)+4\\lambda +2 & =0 \\\\ {\\lambda }^{2}+3\\lambda +2 & =0 \\\\ (\\lambda +2)(\\lambda +1) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =-2$ and $\\lambda =-1.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{-2}+{c}_{2}{x}^{-1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64791/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2cb1a475-4f73-531d-b14c-37000cfc37ab"] :knowledge-point/questions ["q-64791"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64896/selection/0a0168ce240a8ed0986879e00cca587be2382c79c80045feaa0d044b9b2365c0" :answer/id #uuid "b566ddec-4121-5a50-9701-c083b6fdaa41" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{1/2}+{c}_{2}{x}^{-3/2}" :db/ensure [:answer/validate]} {:db/id "q-64896/selection/3f0b4d2a0cc272cf9ffc7ec47d0d20fa54ef3ad0824d9fd9a540df2294af2775" :answer/id #uuid "4b208c15-8436-5180-a9d9-766f6abab824" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{1/4}+{c}_{2}{x}^{-1/2}" :db/ensure [:answer/validate]} {:db/id "q-64896/selection/6102e10f84f59c2f824f516feabd18c1d412fd030455545022e5c04f10261a5a" :answer/id #uuid "314b6e8d-5696-5acc-8ef0-182bf9dade7e" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{3/2}+{c}_{2}{x}^{-1/4}" :db/ensure [:answer/validate]} {:db/id "q-64896/selection/16a3897776f754e11607b2b68c0f1c74193f0d89a406faabe634c72b67a37e76" :answer/id #uuid "cf1c5eff-a8ec-5f38-ac60-b7adc95d6223" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{3/2}+{c}_{2}{x}^{-3/2}" :db/ensure [:answer/validate]} {:db/id "q-64896/selection/a2c11e0eb52b30e23b26b844d40c319c62a74220d59cb74f3bf36e37d9c71e04" :answer/id #uuid "2b799afd-27ac-5262-9fc4-02ffd078f7c0" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{1/2}+{c}_{2}{x}^{-1/2}" :db/ensure [:answer/validate]} {:db/id "q-64896/selection" :answer-field/id #uuid "8024343a-4866-59ff-b62a-467e99afcb48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64896/selection/a2c11e0eb52b30e23b26b844d40c319c62a74220d59cb74f3bf36e37d9c71e04" :answer-field/choices ["q-64896/selection/0a0168ce240a8ed0986879e00cca587be2382c79c80045feaa0d044b9b2365c0" "q-64896/selection/3f0b4d2a0cc272cf9ffc7ec47d0d20fa54ef3ad0824d9fd9a540df2294af2775" "q-64896/selection/6102e10f84f59c2f824f516feabd18c1d412fd030455545022e5c04f10261a5a" "q-64896/selection/16a3897776f754e11607b2b68c0f1c74193f0d89a406faabe634c72b67a37e76" "q-64896/selection/a2c11e0eb52b30e23b26b844d40c319c62a74220d59cb74f3bf36e37d9c71e04"] :db/ensure [:answer-field/validate]} {:db/id "q-64896" :question/id #uuid "ec268263-da66-51b5-bc9f-102a4e291a98" :question/math-academy-id "q-64896" :question/problem "Find the general solution to the equation\n\n$$\n4{x}^{2}{y}^{″}+4x{y}^{′}-y=0,\\,x>0.\n$$" :question/worked-solution "Note that the given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}4{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}+4x\\cdot \\lambda {x}^{\\lambda -1}-{x}^{\\lambda } & =0 \\\\ 4\\lambda (\\lambda -1){x}^{\\lambda }+4\\lambda {x}^{\\lambda }-{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[4\\lambda (\\lambda -1)+4\\lambda -1] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}4\\lambda (\\lambda -1)+4\\lambda -1 & =0 \\\\ 4{\\lambda }^{2}-1 & =0 \\\\ (2\\lambda +1)(2\\lambda -1) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =\\pm \\frac{1}{2}.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{1/2}+{c}_{2}{x}^{-1/2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64896/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2cb1a475-4f73-531d-b14c-37000cfc37ab"] :knowledge-point/questions ["q-64896"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93849/selection/abae1912a023ebb6f20c0b76b795f7228f4accebe80bcf334054ab9fd3748d36" :answer/id #uuid "05425493-19af-531a-a975-2ba23f79e36b" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{2}+{c}_{2}{t}^{-4}" :db/ensure [:answer/validate]} {:db/id "q-93849/selection/f92033ef15e0b2d4df46013d26267f96cd7283df1f77141450caa6d738abd603" :answer/id #uuid "21e3b0ad-b30a-5857-9c79-2f974266a39c" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}t+{c}_{2}{t}^{-1/4}" :db/ensure [:answer/validate]} {:db/id "q-93849/selection/eef8810bd967eb408bc55df2701e7245b4dadb885fb643bd859c40f29a66956b" :answer/id #uuid "4ace7814-d3a4-57e6-bae3-ccc2a4a7ef67" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{3}+{c}_{2}{t}^{-1/4}" :db/ensure [:answer/validate]} {:db/id "q-93849/selection/f2ba96e9536f269caa1603962886d956fad6d0e5b9975efb11f1da24493ca5a8" :answer/id #uuid "3da17261-70cb-5b91-a364-5bdbb040d169" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{3/4}+{c}_{2}{t}^{-2}" :db/ensure [:answer/validate]} {:db/id "q-93849/selection/35bdcfbe61f489e3f4554cd20b50c13379498b8eb9641f2ea3833fe0a9b23b2a" :answer/id #uuid "bba0fc54-ef76-5bb7-816a-74c4da6d292f" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{2}+{c}_{2}{t}^{1/4}" :db/ensure [:answer/validate]} {:db/id "q-93849/selection" :answer-field/id #uuid "cec47a3c-bd2c-52fb-83f8-25a9197879cd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93849/selection/f92033ef15e0b2d4df46013d26267f96cd7283df1f77141450caa6d738abd603" :answer-field/choices ["q-93849/selection/abae1912a023ebb6f20c0b76b795f7228f4accebe80bcf334054ab9fd3748d36" "q-93849/selection/f92033ef15e0b2d4df46013d26267f96cd7283df1f77141450caa6d738abd603" "q-93849/selection/eef8810bd967eb408bc55df2701e7245b4dadb885fb643bd859c40f29a66956b" "q-93849/selection/f2ba96e9536f269caa1603962886d956fad6d0e5b9975efb11f1da24493ca5a8" "q-93849/selection/35bdcfbe61f489e3f4554cd20b50c13379498b8eb9641f2ea3833fe0a9b23b2a"] :db/ensure [:answer-field/validate]} {:db/id "q-93849" :question/id #uuid "4290ec71-e89b-51ac-aae2-37403c147613" :question/math-academy-id "q-93849" :question/problem "Find the general solution to the equation\n\n$$\n4{t}^{2}{y}^{″}+t{y}^{′}-y=0,\\,t>0.\n$$" :question/worked-solution "Note that the given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}4{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}+t\\cdot \\lambda {t}^{\\lambda -1}-{t}^{\\lambda } & =0 \\\\ 4\\lambda (\\lambda -1){t}^{\\lambda }+\\lambda {t}^{\\lambda }-{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[4\\lambda (\\lambda -1)+\\lambda -1] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}4\\lambda (\\lambda -1)+\\lambda -1 & =0 \\\\ 4{\\lambda }^{2}-3\\lambda -1 & =0 \\\\ (\\lambda -1)(4\\lambda +1) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =1$ and $\\lambda =-\\frac{1}{4}.$\nTherefore, the general solution is\n\n$$\ny(t)={c}_{1}t+{c}_{2}{t}^{-1/4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-93849/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2cb1a475-4f73-531d-b14c-37000cfc37ab"] :knowledge-point/questions ["q-93849"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93850/selection/d44736dc99ebc698e52894d336498904e836e28edd194b91020c8459f8b35f09" :answer/id #uuid "080067d6-fedd-5e63-84e4-12c1404276b2" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{-1/2}+{c}_{2}{x}^{3}" :db/ensure [:answer/validate]} {:db/id "q-93850/selection/cab7e0ae85058f8d119e8badc3e63811dacb6aebcefda0946edf3218c3d2aa77" :answer/id #uuid "fcc6f852-7827-57ff-8c8d-3b0826115c28" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{3}+{c}_{2}{x}^{5/2}" :db/ensure [:answer/validate]} {:db/id "q-93850/selection/737413ab90390580de99a37d1081fb24d0c4d830d6bdedf9da58641232969dc5" :answer/id #uuid "d1310d2f-b63e-512b-952e-343c7ed73af6" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{-2}+{c}_{2}{x}^{1/2}" :db/ensure [:answer/validate]} {:db/id "q-93850/selection/d5f7eac0d923121692dcdb2f16b10234a2d410f972d8cc9178dd96dbd1532df1" :answer/id #uuid "38fdc3b4-92e2-5743-91f2-eb0925394800" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{-3}+{c}_{2}{x}^{1/2}" :db/ensure [:answer/validate]} {:db/id "q-93850/selection/6b59080e84588582ecc55df066a8026e3191a6cd058c3b58ec73c062e0e07109" :answer/id #uuid "01a8d1e0-decb-53ae-84ca-37e6f739cfb6" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{3}+{c}_{2}{x}^{3/2}" :db/ensure [:answer/validate]} {:db/id "q-93850/selection" :answer-field/id #uuid "05875801-4fa0-571b-94ca-d71d0a4ad63c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93850/selection/d5f7eac0d923121692dcdb2f16b10234a2d410f972d8cc9178dd96dbd1532df1" :answer-field/choices ["q-93850/selection/d44736dc99ebc698e52894d336498904e836e28edd194b91020c8459f8b35f09" "q-93850/selection/cab7e0ae85058f8d119e8badc3e63811dacb6aebcefda0946edf3218c3d2aa77" "q-93850/selection/737413ab90390580de99a37d1081fb24d0c4d830d6bdedf9da58641232969dc5" "q-93850/selection/d5f7eac0d923121692dcdb2f16b10234a2d410f972d8cc9178dd96dbd1532df1" "q-93850/selection/6b59080e84588582ecc55df066a8026e3191a6cd058c3b58ec73c062e0e07109"] :db/ensure [:answer-field/validate]} {:db/id "q-93850" :question/id #uuid "a1d233f9-3319-5285-9917-972dd3a72bc8" :question/math-academy-id "q-93850" :question/problem "Find the general solution to the equation\n\n$$\n2{x}^{2}{y}^{″}+7x{y}^{′}-3y=0,\\,x>0.\n$$" :question/worked-solution "Note that the given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}+7x\\cdot \\lambda {x}^{\\lambda -1}-3{x}^{\\lambda } & =0 \\\\ 2\\lambda (\\lambda -1){x}^{\\lambda }+7\\lambda {x}^{\\lambda }-3{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[2\\lambda (\\lambda -1)+7\\lambda -3] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}2\\lambda (\\lambda -1)+7\\lambda -3 & =0 \\\\ 2{\\lambda }^{2}+5\\lambda -3 & =0 \\\\ (\\lambda +3)(2\\lambda -1) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =-3$ and $\\lambda =\\frac{1}{2}.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{-3}+{c}_{2}{x}^{1/2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-93850/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2cb1a475-4f73-531d-b14c-37000cfc37ab"] :knowledge-point/questions ["q-93850"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64803"] :question/problem "Find the general solution to the equation\n\n$$\n{t}^{2}{y}^{″}-2y=0,\\,t>0.\n$$" :question/worked-solution "Note that the given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}-2{t}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){t}^{\\lambda }-2{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[\\lambda (\\lambda -1)-2] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-2 & =0 \\\\ {\\lambda }^{2}-\\lambda -2 & =0 \\\\ (\\lambda -2)(\\lambda +1) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =2$ and $\\lambda =-1.$\nTherefore, the general solution is\n\n$$\ny(t)={c}_{1}{t}^{2}+{c}_{2}{t}^{-1}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-64897/selection/f0cfea8b54f38e828569077f436c8967b61c779d08d81d8795872962026f7eca" :answer/id #uuid "326b2d4f-6ead-51ea-810c-6d6ba62ab987" :answer/type :answer.type/math :answer/value "y(t)=3{t}^{2}+2t" :db/ensure [:answer/validate]} {:db/id "q-64897/selection/90accc721a8b7281b44080d11d4e96bb6c4062535cd10067e36c40e092f9c275" :answer/id #uuid "647b6f1a-44b0-5660-8ef3-c59e7b8dd5c4" :answer/type :answer.type/math :answer/value "y(t)=2{t}^{3}+3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-64897/selection/8ad58257890cc85a2e32b4a56baa0ddeebbad4ff734f7b9d8e766aa252f7cf76" :answer/id #uuid "487c9524-d262-51d6-8ee6-cd997fe38634" :answer/type :answer.type/math :answer/value "y(t)={t}^{2}-4t" :db/ensure [:answer/validate]} {:db/id "q-64897/selection/c04e46a644163a2ebf2b91361f1d534832f5f47a784fdf0779bc5f723f89e21d" :answer/id #uuid "c6f63c55-2126-5b0e-9388-0596c0c7dc4e" :answer/type :answer.type/math :answer/value "y(t)=4{t}^{3}-t" :db/ensure [:answer/validate]} {:db/id "q-64897/selection/c4cc641056e7516a56181fa1193cddd326a81ac745cad0b95af4d6d5e85c332b" :answer/id #uuid "d1a2babe-b8e4-5154-8fdf-f2d1d6d91a82" :answer/type :answer.type/math :answer/value "y(t)={t}^{3}-4t" :db/ensure [:answer/validate]} {:db/id "q-64897/selection" :answer-field/id #uuid "8876d5d6-a93b-54f4-be37-2d4055e34e58" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64897/selection/c4cc641056e7516a56181fa1193cddd326a81ac745cad0b95af4d6d5e85c332b" :answer-field/choices ["q-64897/selection/f0cfea8b54f38e828569077f436c8967b61c779d08d81d8795872962026f7eca" "q-64897/selection/90accc721a8b7281b44080d11d4e96bb6c4062535cd10067e36c40e092f9c275" "q-64897/selection/8ad58257890cc85a2e32b4a56baa0ddeebbad4ff734f7b9d8e766aa252f7cf76" "q-64897/selection/c04e46a644163a2ebf2b91361f1d534832f5f47a784fdf0779bc5f723f89e21d" "q-64897/selection/c4cc641056e7516a56181fa1193cddd326a81ac745cad0b95af4d6d5e85c332b"] :db/ensure [:answer-field/validate]} {:db/id "q-64897" :question/id #uuid "bcdbfd86-d02b-511c-99b2-3cd68a8b17f6" :question/math-academy-id "q-64897" :question/problem "Find the solution to the initial value problem\n\n$$\n{t}^{2}{y}^{″}-3t{y}^{′}+3y=0,\\,y(2)=0,\\,{y}^{′}(2)=8,\\,t>0.\n$$" :question/worked-solution "Note that the given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}-3t\\cdot \\lambda {t}^{\\lambda -1}+3{t}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){t}^{\\lambda }-3\\lambda {t}^{\\lambda }+3{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[\\lambda (\\lambda -1)-3\\lambda +3] & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-3\\lambda +3 & =0 \\\\ {\\lambda }^{2}-4\\lambda +3 & =0 \\\\ (\\lambda -1)(\\lambda -3) & =0.\\end{aligned}\n$$\n\nHence, the roots are $\\lambda =1$ and $\\lambda =3.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}t+{c}_{2}{t}^{3}.\n$$\n\nNow let's find the constants ${c}_{1}$ and ${c}_{2}.$\n\nSubstituting $y(2)=0$ into the general solution gives\n\n$$\n0=2{c}_{1}+8{c}_{2}\\,⇒\\,{c}_{1}=-4{c}_{2}.\n$$\n\nWe now need to apply the condition ${y}^{′}(2)=8.$ First, we differentiate $y$ to find ${y}^{′}$:\n\n$$\n\\begin{aligned}{y}^{′} & ={c}_{1}+3{c}_{2}{t}^{2}\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(2)=8$ into the above gives\n\n$$\n\\begin{aligned}8 & ={c}_{1}+3{c}_{2}(2)^{2} \\\\ 8 & ={c}_{1}+12{c}_{2} \\\\ 8 & =-4{c}_{2}+12{c}_{2} \\\\ 8 & =8{c}_{2} \\\\ {c}_{2} & =1\\,⇒\\,{c}_{1}=-4.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)={t}^{3}-4t.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-64897/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10cb8c3a-0764-5082-b431-7f97b8bc5782"] :knowledge-point/questions ["q-64897"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93855/selection/92a203a9ea84cde9444994a66bef0a85e77cea7ac165b0496abf89c46129d628" :answer/id #uuid "5200e911-f9ec-5cdd-af60-d33cf1ae9f07" :answer/type :answer.type/math :answer/value "y(x)=-{x}^{2}-\\sqrt{x}" :db/ensure [:answer/validate]} {:db/id "q-93855/selection/34de9148db3479416d7b3b681033eb0b380d7ea77ebcaf15eaacd4f69e897028" :answer/id #uuid "b468971e-3c1b-50e0-bf71-985c6d513768" :answer/type :answer.type/math :answer/value "y(x)=\\frac{{x}^{2}}{3}+4\\sqrt{x}" :db/ensure [:answer/validate]} {:db/id "q-93855/selection/752686f9d0bf2bee4ecfc073019191261797986d864f544ef3e1ec0419f9d1d9" :answer/id #uuid "d3c6cf96-5a9a-582b-a84b-ac395bfc1a39" :answer/type :answer.type/math :answer/value "y(x)=-3{x}^{2}+\\frac{\\sqrt{x}}{2}" :db/ensure [:answer/validate]} {:db/id "q-93855/selection/62be0455f9b3655b7f646f3acd7f887202a66c553b9af647f9cf7461d4e98b82" :answer/id #uuid "d3465f90-351a-5962-9a73-85f57682177d" :answer/type :answer.type/math :answer/value "y(x)=3{x}^{2}-2\\sqrt{x}" :db/ensure [:answer/validate]} {:db/id "q-93855/selection/220df57914b1fb314f6de0ee9e0fa3c14dd301d9f2c151ee659d955966587013" :answer/id #uuid "2e39ad00-8c58-5ad7-9192-de7984316ca4" :answer/type :answer.type/math :answer/value "y(x)=2{x}^{2}-2\\sqrt{x}" :db/ensure [:answer/validate]} {:db/id "q-93855/selection" :answer-field/id #uuid "0eec3813-8469-5332-b1ef-01e4593faf51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93855/selection/62be0455f9b3655b7f646f3acd7f887202a66c553b9af647f9cf7461d4e98b82" :answer-field/choices ["q-93855/selection/92a203a9ea84cde9444994a66bef0a85e77cea7ac165b0496abf89c46129d628" "q-93855/selection/34de9148db3479416d7b3b681033eb0b380d7ea77ebcaf15eaacd4f69e897028" "q-93855/selection/752686f9d0bf2bee4ecfc073019191261797986d864f544ef3e1ec0419f9d1d9" "q-93855/selection/62be0455f9b3655b7f646f3acd7f887202a66c553b9af647f9cf7461d4e98b82" "q-93855/selection/220df57914b1fb314f6de0ee9e0fa3c14dd301d9f2c151ee659d955966587013"] :db/ensure [:answer-field/validate]} {:db/id "q-93855" :question/id #uuid "6c979dba-bb29-55c5-b3a4-f9de892fa6e2" :question/math-academy-id "q-93855" :question/problem "Given that the differential equation\n\n$$\n2{x}^{2}{y}^{″}-3x{y}^{′}+2y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{x}^{2}+{c}_{2}\\sqrt{x},\n$$\n\nfind the solution to the initial value problem\n\n$$\n2{x}^{2}{y}^{″}-3x{y}^{′}+2y=0,\\,y(1)=1,\\,{y}^{′}(1)=5,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=1.$ Substituting $y(1)=1$ into the general solution gives\n\n$$\n1={c}_{1}+{c}_{2}\\,⇒\\,{c}_{2}=1-{c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=5.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =2{c}_{1}x+\\frac{{c}_{2}}{2\\sqrt{x}}.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=5$ and ${c}_{2}=1-{c}_{1}$ into the above gives\n\n$$\n\\begin{aligned}5 & =2{c}_{1}+\\frac{{c}_{2}}{2} \\\\ 5 & =2{c}_{1}+\\frac{1-{c}_{1}}{2} \\\\ 5 & =\\frac{3{c}_{1}+1}{2} \\\\ {c}_{1} & =3\\,⇒\\,{c}_{2}=-2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x)=3{x}^{2}-2\\sqrt{x}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-93855/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10cb8c3a-0764-5082-b431-7f97b8bc5782"] :knowledge-point/questions ["q-93855"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93856/selection/bd208e01b353c7ad4912607f92b24c6675a6844dce28159cc8e8a902626b9fc4" :answer/id #uuid "faefa58d-471e-59b4-93e7-f3a02a5497d0" :answer/type :answer.type/math :answer/value "y(t)=2t-3\\sqrt{{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-93856/selection/7ff0c8c6c2afcea72d7943a4a9c436dbd05a1addfd9eda90f3cd0692e0326631" :answer/id #uuid "0aa7e609-86f6-5f82-ac69-31ce6c6bc088" :answer/type :answer.type/math :answer/value "y(t)=6\\sqrt{{t}^{3}}-5t" :db/ensure [:answer/validate]} {:db/id "q-93856/selection/975cff4c59ad529b5e58b53e724cfe62a9123792c736a929bc51167bea9b1719" :answer/id #uuid "cf72b731-614e-5adb-85c6-a989bc16536e" :answer/type :answer.type/math :answer/value "y(t)=2\\sqrt{{t}^{3}}-t" :db/ensure [:answer/validate]} {:db/id "q-93856/selection/d7413737707eabe43e29ceb029b38d144594b5fc41106a877bd011aa18ca4f3d" :answer/id #uuid "2805512d-8ca8-5295-b3b8-1612bf087b24" :answer/type :answer.type/math :answer/value "y(t)=-5t-3\\sqrt{{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-93856/selection/85a245d125b6ae8727f69cb073cc381d8e99bc9e207a62f6ec5213de7460a142" :answer/id #uuid "2458380b-8adc-53ab-8317-5084d0bc922f" :answer/type :answer.type/math :answer/value "y(t)=-4t-2\\sqrt{{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-93856/selection" :answer-field/id #uuid "881f1b5e-a8dc-5d67-a1d6-6fceca9cdd6f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93856/selection/7ff0c8c6c2afcea72d7943a4a9c436dbd05a1addfd9eda90f3cd0692e0326631" :answer-field/choices ["q-93856/selection/bd208e01b353c7ad4912607f92b24c6675a6844dce28159cc8e8a902626b9fc4" "q-93856/selection/7ff0c8c6c2afcea72d7943a4a9c436dbd05a1addfd9eda90f3cd0692e0326631" "q-93856/selection/975cff4c59ad529b5e58b53e724cfe62a9123792c736a929bc51167bea9b1719" "q-93856/selection/d7413737707eabe43e29ceb029b38d144594b5fc41106a877bd011aa18ca4f3d" "q-93856/selection/85a245d125b6ae8727f69cb073cc381d8e99bc9e207a62f6ec5213de7460a142"] :db/ensure [:answer-field/validate]} {:db/id "q-93856" :question/id #uuid "41b0b395-aafa-5a6d-a331-f5a55ec4e31d" :question/math-academy-id "q-93856" :question/problem "Given that the differential equation\n\n$$\n2{t}^{2}{y}^{″}-3t{y}^{′}+3y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}t+{c}_{2}\\sqrt{{t}^{3}},\n$$\n\nfind the solution to the initial value problem\n\n$$\n2{t}^{2}{y}^{″}-3t{y}^{′}+3y=0,\\,y(1)=1,\\,{y}^{′}(1)=4,\\,t>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=1.$ Substituting $y(1)=1$ into the general solution gives\n\n$$\n1={c}_{1}+{c}_{2}\\,⇒\\,{c}_{1}=1-{c}_{2}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=4.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & ={c}_{1}+\\frac{3{c}_{2}\\sqrt{t}}{2}.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=4$ and ${c}_{2}=1-{c}_{1}$ into the above gives\n\n$$\n\\begin{aligned}4 & ={c}_{1}+\\frac{3{c}_{2}}{2} \\\\ 4 & =1-{c}_{2}+\\frac{3{c}_{2}}{2} \\\\ 4 & =\\frac{{c}_{2}+2}{2} \\\\ {c}_{2} & =6\\,⇒\\,{c}_{1}=-5.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(t)=6\\sqrt{{t}^{3}}-5t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-93856/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10cb8c3a-0764-5082-b431-7f97b8bc5782"] :knowledge-point/questions ["q-93856"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93858/selection/7076fa90250014877996099b8f0be3efc473fb55c299a95bad4098e44f99ce99" :answer/id #uuid "57cb1294-7bec-5d0b-8cc3-a949790155cc" :answer/type :answer.type/math :answer/value "y(x)=3x-\\frac{4}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-93858/selection/3bb0ba9ac781307d6735bc1fea58c4b538346ab3f9a568bf9dbf199afd46071c" :answer/id #uuid "eca77ea1-d7dc-5914-80d6-45b512fd7341" :answer/type :answer.type/math :answer/value "y(x)=\\frac{2}{{x}^{2}}-3x" :db/ensure [:answer/validate]} {:db/id "q-93858/selection/47e0ee4fb5670d66a55a0e5e1a3a5d771f22a63fc46bd8f7bd4e02ba38a2ca73" :answer/id #uuid "d0d69e0c-b8b4-5024-b613-427b6c9b068b" :answer/type :answer.type/math :answer/value "y(x)=x-\\frac{4}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-93858/selection/c21712939c6a66076b838072ba6112922d6587855ba8c6a332bfde872502da1f" :answer/id #uuid "af0e531c-5da6-5f96-9dec-e09715f94105" :answer/type :answer.type/math :answer/value "y(x)=2x-\\frac{3}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-93858/selection/626f094d837c598482e12945ee0c3d1515f94bfdb2cc56da21da10f6f1a0cf05" :answer/id #uuid "3bb5c5a9-afc5-5b82-b112-2a1c8ebe89cf" :answer/type :answer.type/math :answer/value "y(x)=4x-\\frac{1}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-93858/selection" :answer-field/id #uuid "783ebf7e-1c97-5153-b435-bf8208034b4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93858/selection/47e0ee4fb5670d66a55a0e5e1a3a5d771f22a63fc46bd8f7bd4e02ba38a2ca73" :answer-field/choices ["q-93858/selection/7076fa90250014877996099b8f0be3efc473fb55c299a95bad4098e44f99ce99" "q-93858/selection/3bb0ba9ac781307d6735bc1fea58c4b538346ab3f9a568bf9dbf199afd46071c" "q-93858/selection/47e0ee4fb5670d66a55a0e5e1a3a5d771f22a63fc46bd8f7bd4e02ba38a2ca73" "q-93858/selection/c21712939c6a66076b838072ba6112922d6587855ba8c6a332bfde872502da1f" "q-93858/selection/626f094d837c598482e12945ee0c3d1515f94bfdb2cc56da21da10f6f1a0cf05"] :db/ensure [:answer-field/validate]} {:db/id "q-93858" :question/id #uuid "bba97e87-cbd7-52ca-b400-b76d84b8e243" :question/math-academy-id "q-93858" :question/problem "Given that the differential equation\n\n$$\n{x}^{2}{y}^{″}+2x{y}^{′}-2y=0\n$$\n\nhas the general solution\n\n$$\ny=\\frac{{c}_{1}}{{x}^{2}}+{c}_{2}x,\n$$\n\nfind the solution to the initial value problem\n\n$$\n{x}^{2}{y}^{″}+2x{y}^{′}-2y=0,\\,y(2)=1,\\,{y}^{′}(2)=2,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(2)=1.$ Substituting $y(2)=1$ into the general solution gives\n\n$$\n1=\\frac{{c}_{1}}{4}+2{c}_{2}\\,⇒\\,{c}_{1}=4-8{c}_{2}.\n$$\n\n- Then, we apply the condition ${y}^{′}(2)=2.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =-\\frac{2{c}_{1}}{{x}^{3}}+{c}_{2}.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(2)=2$ and ${c}_{1}=4-8{c}_{2}$ into the above gives\n\n$$\n\\begin{aligned}2 & =-\\frac{8-16{c}_{2}}{8}+{c}_{2} \\\\ 2 & =3{c}_{2}-1 \\\\ {c}_{2} & =1\\,⇒\\,{c}_{1}=-4.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x)=x-\\frac{4}{{x}^{2}}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-93858/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10cb8c3a-0764-5082-b431-7f97b8bc5782"] :knowledge-point/questions ["q-93858"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93862/selection/f0675713cdd219ec50b31d82885db2a43a07920c1405f77f28024b14adfcf3db" :answer/id #uuid "d3addf56-3e0a-5394-942a-66a5b16c500d" :answer/type :answer.type/math :answer/value "y(x)=\\frac{2{x}^{1/3}}{3}+\\frac{1}{2\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-93862/selection/400afb91e46422f42c63e15d6aa49d02b0bc5b4ea3c7bc47f0295a0a25ccd753" :answer/id #uuid "8d9a0888-1967-537d-966f-af50a4782fcb" :answer/type :answer.type/math :answer/value "y(x)=\\frac{{x}^{1/3}}{2}+\\frac{1}{3\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-93862/selection/8a56e44136cf076962e0ea156a147aa50e95ac0143e82fbc5e070ef273ca4f9e" :answer/id #uuid "8eec7487-9283-523c-8e17-464d042f2bf7" :answer/type :answer.type/math :answer/value "y(x)=3{x}^{1/3}+\\frac{2}{3\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-93862/selection/0b741956f79a29f845ea57a00e952ad6e56cbeaeedfec1daf9b88a1a8435987e" :answer/id #uuid "c1c32e8a-9d38-58c5-8647-9f4894f2f33a" :answer/type :answer.type/math :answer/value "y(x)=\\frac{6{x}^{1/3}}{5}-\\frac{6}{5\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-93862/selection/26acdd89f4fcab6d0aea79a2f179c765efc0b38af4f3f22c02fdfd9e5b0a5d04" :answer/id #uuid "17272277-da18-506f-92e6-9345bcb16c29" :answer/type :answer.type/math :answer/value "y(x)=\\frac{6{x}^{1/3}}{5}+\\frac{3}{5\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-93862/selection" :answer-field/id #uuid "8cff47b4-ce91-51af-b233-f1f51c2c5557" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93862/selection/0b741956f79a29f845ea57a00e952ad6e56cbeaeedfec1daf9b88a1a8435987e" :answer-field/choices ["q-93862/selection/f0675713cdd219ec50b31d82885db2a43a07920c1405f77f28024b14adfcf3db" "q-93862/selection/400afb91e46422f42c63e15d6aa49d02b0bc5b4ea3c7bc47f0295a0a25ccd753" "q-93862/selection/8a56e44136cf076962e0ea156a147aa50e95ac0143e82fbc5e070ef273ca4f9e" "q-93862/selection/0b741956f79a29f845ea57a00e952ad6e56cbeaeedfec1daf9b88a1a8435987e" "q-93862/selection/26acdd89f4fcab6d0aea79a2f179c765efc0b38af4f3f22c02fdfd9e5b0a5d04"] :db/ensure [:answer-field/validate]} {:db/id "q-93862" :question/id #uuid "87887c3a-f4f3-5503-b32a-2d4f279bbcb9" :question/math-academy-id "q-93862" :question/problem "Given that the differential equation\n\n$$\n6{x}^{2}{y}^{″}+7x{y}^{′}-y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{x}^{1/3}+\\frac{{c}_{2}}{\\sqrt{x}},\n$$\n\nfind the solution to the initial value problem\n\n$$\n6{x}^{2}{y}^{″}+7x{y}^{′}-y=0,\\,y(1)=0,\\,{y}^{′}(1)=1,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=0.$ Substituting $y(1)=0$ into the general solution gives\n\n$$\n0={c}_{1}+{c}_{2}\\,⇒\\,{c}_{2}=-{c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=1.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{c}_{1}}{3{x}^{2/3}}-\\frac{{c}_{2}}{2\\sqrt{{x}^{3}}}.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=1$ and ${c}_{2}=-{c}_{1}$ into the above gives\n\n$$\n\\begin{aligned}1 & =\\frac{{c}_{1}}{3}-\\frac{{c}_{2}}{2} \\\\ 1 & =\\frac{{c}_{1}}{3}+\\frac{{c}_{1}}{2} \\\\ 1 & =\\frac{5{c}_{1}}{6} \\\\ {c}_{1} & =\\frac{6}{5}\\,⇒\\,{c}_{2}=-\\frac{6}{5}.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x)=\\frac{6{x}^{1/3}}{5}-\\frac{6}{5\\sqrt{x}}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-93862/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "10cb8c3a-0764-5082-b431-7f97b8bc5782"] :knowledge-point/questions ["q-93862"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6624"] :question/problem "Which of the following equations is an instance of the Cauchy-Euler equation?\n\n- $-2x^2y''+6xy'-5y=0$\n\n- $xy''+2y'-3xy=0$\n\n- $y''-3x^2y=\\sqrt{x}$" :question/worked-solution "The second-order Cauchy-Euler equation has the form\n\n$$\nax^2y''+bxy'+cy=f(x),\n$$\n\nwhere $a,b,$ and $c$ are constants. With that in mind, let's inspect each of the given equations.\n\n- Equation I is a Cauchy-Euler equation with $a=-2,$ $b=6,$ $c=-5,$ and $f(x)=0.$\n\n- Equation II is *not* a Cauchy-Euler equation because the $y''$ is not multiplied by an $x^2.$ Instead, it is multiplied by an $x.$\n\n- Equation III is *not* a Cauchy-Euler equation because the $y''$ term is not multiplied by an $x^2.$\n\nTherefore, the correct answer is \"I only\"." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6625"] :question/problem "Find the general solution to the equation\n\n$$\n3t^2 y''+8ty' -2y = 0, \\quad t\\gt 0.\n$$" :question/worked-solution "This is an instance of the Cauchy-Euler equation. So, we assume the solutions take the form $y=t^\\lambda.$ Differentiating $y$ with respect to $t$ gives\n\n$$\ny' = \\lambda t^{\\lambda -1}, \\qquad y'' = \\lambda(\\lambda-1)t^{\\lambda-2}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}3{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}+8t\\cdot \\lambda {t}^{\\lambda -1}-2{t}^{\\lambda } & =0 \\\\ 3\\lambda (\\lambda -1){t}^{\\lambda }+8\\lambda {t}^{\\lambda }-2{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[3\\lambda (\\lambda -1)+8\\lambda -2] & =0.\\end{aligned}\n$$\n\nSo, we have the following characteristic equation:\n\n$$\n\\begin{aligned}3\\lambda (\\lambda -1)+8\\lambda -2 & =0 \\\\ 3{\\lambda }^{2}+5\\lambda -2 & =0 \\\\ (\\lambda +2)(3\\lambda -1) & =0\\end{aligned}\n$$\n\nThe roots of the characteristic equation are $\\lambda = -2$ and $\\lambda = \\dfrac{1}{3}.$\nTherefore, the general solution is\n\n$$\n\\begin{aligned}y(t) & ={c}_{1}{t}^{-2}+{c}_{2}{t}^{1/3} \\\\  & =\\frac{{c}_{1}}{{t}^{2}}+{c}_{2}{t}^{1/3}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6626"] :question/problem "Given that the differential equation\n\n$$\nx^2 y'' +2 xy' -6 y= 0\n$$\n\nhas the general solution\n\n$$\ny=\\dfrac{c_1}{x^3}+ c_2x^{2},\n$$\n\nfind the solution to the initial value problem\n\n$$\nx^2 y'' +2 xy' -6 y= 0, \\quad y(1)= 0,  \\quad y'(1) = 5, \\quad x \\gt 0.\n$$" :question/worked-solution "We find the constants $c_1$ and $c_2$ using the initial conditions.\n\n- First, we apply the condition $y(1)=0.$ Substituting $y(1)= 0$ into the general solution gives\n\n$$\n0 = c_1+c_2 \\quad \\Rightarrow \\quad  c_2 = -c_1.\n$$\n\n- Then, we apply the condition $y'(1) = 5.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =-3\\frac{{c}_{1}}{{x}^{4}}+2{c}_{2}x.\\end{aligned}\n$$\n\nSubstituting $y'(1)=5$ and $c_2=-c_1$ into the above gives\n\n$$\n\\begin{aligned}5 & =-3{c}_{1}+2{c}_{2} \\\\ 5 & =-3{c}_{1}+2(-{c}_{1}) \\\\ 5 & =-5{c}_{1} \\\\ {c}_{1} & =-1\\,⇒\\,{c}_{2}=1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x)=x^{2}-\\dfrac{1}{x^3}.\n$$" :db/ensure [:question/validate]}]
