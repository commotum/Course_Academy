edb/ref 17592186360920 13194139535682 true] [17592186360916 1000 #edb/ref 17592186360921 13194139535682 true] [17592186360916 1040 #edb/ref 17592186045450 13194139535682 true] [17592186360916 1041 "selection" 13194139535682 true] [17592186360916 1104 #edb/ref 17592186360920 13194139535682 true] [17592186360916 1110 #uuid "d680977c-b9f2-5de1-acbc-e58727962301" 13194139535682 true] [17592186360917 1034 "x{y}^{″}-2y=0" 13194139535682 true] [17592186360917 1103 #edb/ref 17592186045453 13194139535682 true] [17592186360917 1111 #uuid "4a1612b8-0eab-5af5-955c-5f134ecf5102" 13194139535682 true] [17592186360918 1034 "{y}^{″}-x{y}^{′}+2y={e}^{x}" 13194139535682 true] [17592186360918 1103 #edb/ref 17592186045453 13194139535682 true] [17592186360918 1111 #uuid "a2fe40dc-a4b5-5d10-82ac-93aa0a37b6c1" 13194139535682 true] [17592186360919 1034 "{y}^{″}-{y}^{′}+xy=0" 13194139535682 true] [17592186360919 1103 #edb/ref 17592186045453 13194139535682 true] [17592186360919 1111 #uuid "ed3957a0-3032-585d-a5b0-150672218372" 13194139535682 true] [17592186360920 1034 "{x}^{2}{y}^{″}-2y={x}^{3}{e}^{x}" 13194139535682 true] [17592186360920 1103 #edb/ref 17592186045453 13194139535682 true] [17592186360920 1111 #uuid "fbe93780-cc92-5daa-9baa-db7e269f6f29" 13194139535682 true] [17592186360921 1034 "{y}^{″}-x{y}^{′}+4{x}^{2}y=0" 13194139535682 true] [17592186360921 1103 #edb/ref 17592186045453 13194139535682 true] [17592186360921 1111 #uuid "a7d7b750-d02f-5584-9cf8-d9d3175a4767" 13194139535682 true] [17592186360922 1017 #edb/ref 17592186360923 13194139535682 true] [17592186360922 1089 "q-64791" 13194139535682 true] [17592186360922 1091 #edb/ref 17592186045465 13194139535682 true] [17592186360922 1100 "Find the general solution to the equation\n\n$$\n{x}^{2}{y}^{″}+4x{y}^{′}+2y=0,\\,x>0.\n$$" 13194139535682 true] [17592186360922 1113 #uuid "73c50c67-0e36-56ac-9c4c-739cefc62453" 13194139535682 true] [17592186360922 1145 "Note that the given equation is an instance of the Cauchy-Euler equation. So, w