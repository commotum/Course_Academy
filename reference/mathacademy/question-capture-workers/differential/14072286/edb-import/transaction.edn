[{:db/id "q-93778/selection/d5e0a911aabfcdceee02a7ef10f3063d0d8a1edc7bf659eed0b4d71a84c31f74" :answer/id #uuid "0f62ea42-2dcb-5516-af1c-7e27d2b80b01" :answer/type :answer.type/math :answer/value "x{y}^{″}+2{x}^{2}{y}^{′}=0" :db/ensure [:answer/validate]} {:db/id "q-93778/selection/1fe8ead84724a299e5a5549743b2f099d631322a29f667fad1e2461a9f978bad" :answer/id #uuid "0e4354cd-2f8a-5464-8c6f-5abb551be4a2" :answer/type :answer.type/math :answer/value "{y}^{″}+x{y}^{′}=0" :db/ensure [:answer/validate]} {:db/id "q-93778/selection/f04e57bd583ff091be3a989ab1ce40771d96a6df7d5e94f6d3cc6fd53f5ea448" :answer/id #uuid "e7e3d09a-4944-5daf-9557-a649f1a46363" :answer/type :answer.type/math :answer/value "x{y}^{″}+{x}^{2}{y}^{′}=0" :db/ensure [:answer/validate]} {:db/id "q-93778/selection/1c0bb28285f4e0529be7dfab73f2532858427c5857e1b1eb367a83c47a326787" :answer/id #uuid "f157d05d-0537-5c8d-a2e0-73c42642fe1a" :answer/type :answer.type/math :answer/value "{y}^{″}+2x{y}^{′}=\\frac{1}{x}" :db/ensure [:answer/validate]} {:db/id "q-93778/selection/7091f2d2dfde9e68d0be2d7ce56b0d7acefb58542e5de6fd32b7e3a265b4b04b" :answer/id #uuid "ea3fd199-88a0-56b4-b8cb-c240a9d41359" :answer/type :answer.type/math :answer/value "x{y}^{″}+{x}^{2}{y}^{′}=1" :db/ensure [:answer/validate]} {:db/id "q-93778/selection" :answer-field/id #uuid "b4a1719b-22bf-5859-a5ef-043de14d1e2d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93778/selection/d5e0a911aabfcdceee02a7ef10f3063d0d8a1edc7bf659eed0b4d71a84c31f74" :answer-field/choices ["q-93778/selection/d5e0a911aabfcdceee02a7ef10f3063d0d8a1edc7bf659eed0b4d71a84c31f74" "q-93778/selection/1fe8ead84724a299e5a5549743b2f099d631322a29f667fad1e2461a9f978bad" "q-93778/selection/f04e57bd583ff091be3a989ab1ce40771d96a6df7d5e94f6d3cc6fd53f5ea448" "q-93778/selection/1c0bb28285f4e0529be7dfab73f2532858427c5857e1b1eb367a83c47a326787" "q-93778/selection/7091f2d2dfde9e68d0be2d7ce56b0d7acefb58542e5de6fd32b7e3a265b4b04b"] :db/ensure [:answer-field/validate]} {:db/id "q-93778" :question/id #uuid "51b9c41c-687e-5a63-a75b-3d18711c4288" :question/math-academy-id "q-93778" :question/problem "For the differential equation $x{y}^{″}+2{x}^{2}{y}^{′}=1,$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\nx{y}^{″}+2{x}^{2}{y}^{′}=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93778/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66ec8603-ae96-5212-88e1-4571d7face6b"] :knowledge-point/questions ["q-93778"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130995/selection/000ea74b20b7541660b843bc58413b3ed33d1439a5cfca06db09539fdae17ccb" :answer/id #uuid "bd33a110-6141-5473-8404-01e95c1959f6" :answer/type :answer.type/math :answer/value "{y}^{″}-{y}^{′}+y=0" :db/ensure [:answer/validate]} {:db/id "q-130995/selection/42c04ca8aeca8ff4cda6ff6ec7e954d0d35b18dea619b82d27025735feb26f8a" :answer/id #uuid "ceaf2e66-95e6-5976-9536-119f1c276e9b" :answer/type :answer.type/math :answer/value "{y}^{″}-{y}^{′}+y={e}^{2x}" :db/ensure [:answer/validate]} {:db/id "q-130995/selection/0df4bf640ecc5ff12b98a004aafe81aa037dbdf3cb8598881bc167737acca9cb" :answer/id #uuid "71c22840-885d-560d-81ec-fc622a4ef168" :answer/type :answer.type/math :answer/value "{y}^{″}-6{y}^{′}=0" :db/ensure [:answer/validate]} {:db/id "q-130995/selection/47cc29b0d23cc1befbcaa54560065ae37a09962738ab69ddd25d2e3f52972a89" :answer/id #uuid "8daabac5-b80c-508e-8a20-1a9818c8b5cc" :answer/type :answer.type/math :answer/value "{y}^{″}-6{y}^{′}+5y=0" :db/ensure [:answer/validate]} {:db/id "q-130995/selection/1f698020fa736b5ba5ef0d9864f2d5b120bc5e770372550f2722765467fcfba3" :answer/id #uuid "77b5abdd-8c3e-52a9-8062-32ae5f3f4fd9" :answer/type :answer.type/math :answer/value "{e}^{-2x}{y}^{″}-6{y}^{′}+5y=9" :db/ensure [:answer/validate]} {:db/id "q-130995/selection" :answer-field/id #uuid "a3257315-1bda-57b0-99ad-0073be99d007" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130995/selection/47cc29b0d23cc1befbcaa54560065ae37a09962738ab69ddd25d2e3f52972a89" :answer-field/choices ["q-130995/selection/000ea74b20b7541660b843bc58413b3ed33d1439a5cfca06db09539fdae17ccb" "q-130995/selection/42c04ca8aeca8ff4cda6ff6ec7e954d0d35b18dea619b82d27025735feb26f8a" "q-130995/selection/0df4bf640ecc5ff12b98a004aafe81aa037dbdf3cb8598881bc167737acca9cb" "q-130995/selection/47cc29b0d23cc1befbcaa54560065ae37a09962738ab69ddd25d2e3f52972a89" "q-130995/selection/1f698020fa736b5ba5ef0d9864f2d5b120bc5e770372550f2722765467fcfba3"] :db/ensure [:answer-field/validate]} {:db/id "q-130995" :question/id #uuid "b7b08ec7-08b5-5c35-bf90-c1751fde5f4c" :question/math-academy-id "q-130995" :question/problem "For the differential equation ${y}^{″}-6{y}^{′}+5y=9{e}^{2x},$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\n{y}^{″}-6{y}^{′}+5y=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130995/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66ec8603-ae96-5212-88e1-4571d7face6b"] :knowledge-point/questions ["q-130995"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130998/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "95baf817-6def-5390-a1c9-92ecce806127" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-130998/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "e96f3505-6ce8-5fc3-aaff-e01728d9c51c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-130998/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "48e1e1b6-c01c-54ea-ad81-438e60889d9d" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-130998/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "afe1d8d7-01ea-5600-a003-6635599c427b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-130998/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "38292adc-a31d-55af-9402-4c78d96723cf" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-130998/selection" :answer-field/id #uuid "a0155c45-6d81-58c9-bea8-62c94584b455" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130998/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-130998/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-130998/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-130998/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-130998/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-130998/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-130998" :question/id #uuid "30c6fcc7-4b73-56ac-a7b7-837e8d6bcc9e" :question/math-academy-id "q-130998" :question/problem "Which of the following systems is an initial value problem?\n\n- $5{y}^{″}+x{y}^{′}+y=\\operatorname{cos}⁡x,\\,y(0)=0,\\,{y}^{′}(0)=1$\n- ${x}^{2}{y}^{″}-{e}^{x}{y}^{′}=0,\\,y(0)=1,\\,{y}^{′}(1)=0$\n- $\\frac{1}{x}{y}^{″}+{x}^{2}{y}^{′}={e}^{x},\\,y(1)=0,\\,{y}^{′}(1)=2$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=0$).\n\n- The second system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=0$ and $x=1$). This is a **boundary value problem.**\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8"] :knowledge-point/questions ["q-130998"] :db/ensure [:knowledge-point/validate]} {:db/id "q-338004/field-1/0dccd1c0d01f1a6108a63b9727608bbe91e40a553b6f3a4aeaca05919f28c3b7" :answer/id #uuid "8d0fd996-c57e-5139-a4f4-90ca5c65f5c3" :answer/type :answer.type/text :answer/value "homogeneous" :db/ensure [:answer/validate]} {:db/id "q-338004/field-1/668dba9073658905cfbd208ef398f5d3f3cf0216b5f756007174dd24f51b21a9" :answer/id #uuid "a104965a-e982-5d79-81df-5a485c54f2c4" :answer/type :answer.type/text :answer/value "inhomogeneous" :db/ensure [:answer/validate]} {:db/id "q-338004/field-1" :answer-field/id #uuid "c117b3c3-c2d3-5439-811c-aa143241f4fc" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-338004/field-1/0d