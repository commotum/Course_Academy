#{[{:db/id #edb/ref 17592186375468 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ec8603-ae96-5212-88e1-4571d7face6b" :knowledge-point/title "Identifying the Associated Homogeneous Equation of a Second-Order Inhomogeneous ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd33a110-6141-5473-8404-01e95c1959f6" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{″}-{y}^{′}+y=0" :db/id #edb/ref 17592186375470} {:answer/id #uuid "71c22840-885d-560d-81ec-fc622a4ef168" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{″}-6{y}^{′}=0" :db/id #edb/ref 17592186375471} {:answer/id #uuid "77b5abdd-8c3e-52a9-8062-32ae5f3f4fd9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-2x}{y}^{″}-6{y}^{′}+5y=9" :db/id #edb/ref 17592186375472} {:answer/id #uuid "ceaf2e66-95e6-5976-9536-119f1c276e9b" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{″}-{y}^{′}+y={e}^{2x}" :db/id #edb/ref 17592186375473} {:answer/id #uuid "8daabac5-b80c-508e-8a20-1a9818c8b5cc" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{″}-6{y}^{′}+5y=0" :db/id #edb/ref 17592186375474}] :answer-field/correct {:answer/id #uuid "8daabac5-b80c-508e-8a20-1a9818c8b5cc" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{″}-6{y}^{′}+5y=0" :db/id #edb/ref 17592186375474} :answer-field/id #uuid "a3257315-1bda-57b0-99ad-0073be99d007" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375469}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b7b08ec7-08b5-5c35-bf90-c1751fde5f4c" :question/math-academy-id "q-130995" :question/problem "For the differential equation ${y}^{″}-6{y}^{′}+5y=9{e}^{2x},$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\n{y}^{″}-6{y}^{′}+5y=0.\n$$"}] [{:db/id #edb/ref 17592186375475 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "48e1e1b6-c01c-54ea-ad81-438e60889d9d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186375477} {:answer/id #uuid "afe1d8d7-01ea-5600-a003-6635599c427b" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186375478} {:answer/id #uuid "38292adc-a31d-55af-9402-4c78d96723cf" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186375479} {:answer/id #uuid "95baf817-6def-5390-a1c9-92ecce806127" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186375480} {:answer/id #uuid "e96f3505-6ce8-5fc3-aaff-e01728d9c51c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186375481}] :answer-field/correct {:answer/id #uuid "afe1d8d7-01ea-5600-a003-6635599c427b" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186375478} :answer-field/id #uuid "a0155c45-6d81-58c9-bea8-62c94584b455" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375476}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "30c6fcc7-4b73-56ac-a7b7-837e8d6bcc9e" :question/math-academy-id "q-130998" :question/problem "Which of the following systems is an initial value problem?\n\n- $5{y}^{″}+x{y}^{′}+y=\\operatorname{cos}⁡x,\\,y(0)=0,\\,{y}^{′}(0)=1$\n- ${x}^{2}{y}^{″}-{e}^{x}{y}^{′}=0,\\,y(0)=1,\\,{y}^{′}(1)=0$\n- $\\frac{1}{x}{y}^{″}+{x}^{2}{y}^{′}={e}^{x},\\,y(1)=0,\\,{y}^{′}(1)=2$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=0$).\n\n- The second system is not an initial value problem. It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=0$ and $x=1$). This is a **boundary value problem.**\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)."}] [{:db/id #edb/ref 17592186375482 :knowledge-point/_questions [{:knowledge-point/id #uuid "90930e15-0827-5e0b-82cf-98263fc756d6" :knowledge-point/title "Identifying Second-Order Homogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d0fd996-c57e-5139-a4f4-90ca5c65f5c3" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375484} {:answer/id #uuid "a104965a-e982-5d79-81df-5a485c54f2c4" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375485}] :answer-field/correct {:answer/id #uuid "8d0fd996-c57e-5139-a4f4-90ca5c65f5c3" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375484} :answer-field/id #uuid "c117b3c3-c2d3-5439-811c-aa143241f4fc" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186375483} {:answer-field/choices [{:answer/id #uuid "68e19d30-2771-5e78-92d1-42f0e84dc711" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375487} {:answer/id #uuid "78e1f85e-ad80-5a7c-9fa5-a0cd67b8aab7" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375488}] :answer-field/correct {:answer/id #uuid "78e1f85e-ad80-5a7c-9fa5-a0cd67b8aab7" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375488} :answer-field/id #uuid "8829219e-1bf2-5f9f-930a-f33f21ba659f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186375486} {:answer-field/choices [{:answer/id #uuid "2d89d41e-d0de-5fa0-a519-0bbafbf9e73c" :answer/type {:db/ident :answer.type/text} :answer/value "homogeneous" :db/id #edb/ref 17592186375490} {:answer/id #uuid "8eecc096-b03c-5a44-8e32-37a248a69cb6" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375491}] :answer-field/correct {:answer/id #uuid "8eecc096-b03c-5a44-8e32-37a248a69cb6" :answer/type {:db/ident :answer.type/text} :answer/value "inhomogeneous" :db/id #edb/ref 17592186375491} :answer-field/id #uuid "a3566069-abad-563e-a36c-639688c12233" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186375489}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8da06f22-6a38-578e-b590-3e2d4a9025f6" :question/math-academy-id "q-338004" :question/problem "Determine which of the following second-order ODEs are homogeneous, and which are inhomogeneous.$\\,$ The equation $\\,\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0$ is {{field-1}}. \n\n$\\,$ The equation $\\,{y}^{″}+3{y}^{′}=x$ is {{field-2}}. \n\n$\\,$ The equation $\\,{y}^{″}-xy+4x=0$ is {{field-3}}." :question/worked-solution "Suppose we have a second-order linear ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe equation is homogeneous if $f(x)=0$ for all $x.$ If it is not homogeneous, then it is inhomogeneous.\n\nWith that in mind, let's examine each option.\n\n- The equation\n\n$$\n\\sqrt{x}\\,{y}^{″}-2x{y}^{′}+y=0\n$$\n\nis $\\text{homogeneous}$ since, for the right-hand side, we have $f(x)=0$ for all $x.$\n\n- The equation\n\n$$\n{y}^{″}+3{y}^{′}=x\n$$\n\nis $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=x,$ which is different from zero.\n\n- Writing the equation\n\n$$\n{y}^{″}-xy+4x=0\n$$\n\nin the form $a{y}^{″}+b{y}^{′}+cy=f,$ we have\n\n$$\n{y}^{″}-xy=-4x.\n$$\n\nThis equation is $\\text{inhomogeneous}$ since, for the right-hand side, we have $f(x)=-4x,$ which is different from zero."}] [{:db/id #edb/ref 17592186375492 :knowledge-point/_questions [{:knowledge-point/id #uuid "2d0a7ede-b896-56c6-9b60-a6aec8eff9e8" :knowledge-point/title "Identifying Second-Order Initial Value Problems"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3752d86c-7a3b-5c0e-9a51-0507c31bc467" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186375494} {:answer/id #uuid "8feb8a2a-230c-5cf3-bff7-a3994bb049be" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186375495} {:answer/id #uuid "ba04aeca-04dc-5e8f-9ba3-261b61a26a77" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186375496} {:answer/id #uuid "42266fdf-5a26-58dc-89c4-602074a77807" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186375497} {:answer/id #uuid "24d63809-e024-53f3-87cc-61435b10644a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186375498}] :answer-field/correct {:answer/id #uuid "ba04aeca-04dc-5e8f-9ba3-261b61a26a77" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186375496} :answer-field/id #uuid "11078401-779e-5895-a7c6-38aec08aefe4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375493}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d8f4d7ab-4946-517f-88cd-116b43135b3b" :question/math-academy-id "q-339254" :question/problem "Which of the following systems is an initial value problem?\n\n- $x{y}^{″}-4{y}^{′}+4y=\\operatorname{sin}⁡x+2x,\\,y(-1)=2,\\,{y}^{′}(2)=0$\n- ${x}^{2}{y}^{″}-{y}^{′}+y=8$\n- $x{y}^{″}+{y}^{′}-3y={e}^{x},\\,y(1)=0,\\,{y}^{′}(1)=4$" :question/worked-solution "If a second-order differential equation for the function $y(x)$ is given with two conditions specified at the *same* location in the domain of $y,$ then this is an **initial value problem**.\n\nLet's go through each equation in turn.\n\n- The first system is not an initial value problem.  It consists of a differential equation together with two conditions at different points in the domain of $y(x)$ (i.e., at $x=-1$ and $x=2$). This is a **boundary value problem.**\n\n- The second system is not an initial value problem. It contains an equation only. No conditions are specified.\n\n- The third system is an initial value problem. The differential equation is together with two conditions at the same location in the domain of $y(x)$ (i.e., at $x=1$)."}] [{:db/id #edb/ref 17592186375499 :knowledge-point/_questions [{:knowledge-point/id #uuid "66ec8603-ae96-5212-88e1-4571d7face6b" :knowledge-point/title "Identifying the Associated Homogeneous Equation of a Second-Order Inhomogeneous ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f157d05d-0537-5c8d-a2e0-73c42642fe1a" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{″}+2x{y}^{′}=\\frac{1}{x}" :db/id #edb/ref 17592186375501} {:answer/id #uuid "0e4354cd-2f8a-5464-8c6f-5abb551be4a2" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{″}+x{y}^{′}=0" :db/id #edb/ref 17592186375502} {:answer/id #uuid "ea3fd199-88a0-56b4-b8cb-c240a9d41359" :answer/type {:db/ident :answer.type/math} :answer/value "x{y}^{″}+{x}^{2}{y}^{′}=1" :db/id #edb/ref 17592186375503} {:answer/id #uuid "0f62ea42-2dcb-5516-af1c-7e27d2b80b01" :answer/type {:db/ident :answer.type/math} :answer/value "x{y}^{″}+2{x}^{2}{y}^{′}=0" :db/id #edb/ref 17592186375504} {:answer/id #uuid "e7e3d09a-4944-5daf-9557-a649f1a46363" :answer/type {:db/ident :answer.type/math} :answer/value "x{y}^{″}+{x}^{2}{y}^{′}=0" :db/id #edb/ref 17592186375505}] :answer-field/correct {:answer/id #uuid "0f62ea42-2dcb-5516-af1c-7e27d2b80b01" :answer/type {:db/ident :answer.type/math} :answer/value "x{y}^{″}+2{x}^{2}{y}^{′}=0" :db/id #edb/ref 17592186375504} :answer-field/id #uuid "b4a1719b-22bf-5859-a5ef-043de14d1e2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375500}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "51b9c41c-687e-5a63-a75b-3d18711c4288" :question/math-academy-id "q-93778" :question/problem "For the differential equation $x{y}^{″}+2{x}^{2}{y}^{′}=1,$ what is the associated homogeneous equation?" :question/worked-solution "Suppose we have a second-order inhomogeneous ODE given in the form\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=f(x).\n$$\n\nThe associated homogeneous equation is constructed by replacing $f(x)$ with zero:\n\n$$\na(x){y}^{″}+b(x){y}^{′}+c(x)y=0\n$$\n\nTherefore, in our case, the associated homogeneous equation is\n\n$$\nx{y}^{″}+2{x}^{2}{y}^{′}=0.\n$$"}]}
