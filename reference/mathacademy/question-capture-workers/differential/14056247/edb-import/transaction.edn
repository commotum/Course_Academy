64f-23aa-5d91-ba23-723dec63bea4" :answer/type :answer.type/math :answer/value "\\text{ }{y}_{2}^{′}\\cdot Δx" :db/ensure [:answer/validate]} {:db/id "q-331162/field-3/5c743e32be7b897df5ecab21e82a20bb09697532c1f56802111e62cb87274a53" :answer/id #uuid "0f4c26e4-7769-59d1-9f20-06b50ef77819" :answer/type :answer.type/math :answer/value "\\text{ }\\frac{1}{2}{y}_{2}^{′}\\cdot Δx" :db/ensure [:answer/validate]} {:db/id "q-331162/field-3/84446c3b8121efb985918f1a365c43fc58419d9ac4b4c270b2cab0d78fa38cb5" :answer/id #uuid "4eacfb73-49a3-58cb-aee1-1e46f82450ba" :answer/type :answer.type/math :answer/value "\\text{ }y+\\frac{1}{2}{y}_{2}^{′}\\cdot Δx" :db/ensure [:answer/validate]} {:db/id "q-331162/field-3/5a55df1859ac6969120fa9ce7f22c5a71c09efbc4bea9afa65548ad037fa9428" :answer/id #uuid "492a5f4d-5228-58a0-9d02-6f21f43a73c0" :answer/type :answer.type/math :answer/value "y+{y}_{2}^{′}\\cdot Δx" :db/ensure [:answer/validate]} {:db/id "q-331162/field-3" :answer-field/id #uuid "81e47189-3f06-5447-a8f6-6599aea1d6b5" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-331162/field-3/5a55df1859ac6969120fa9ce7f22c5a71c09efbc4bea9afa65548ad037fa9428" :answer-field/choices ["q-331162/field-3/f6c840cafaef6afe83c07cf306aa46c915d7359da18b8a097df56ac6e50f36b5" "q-331162/field-3/5c743e32be7b897df5ecab21e82a20bb09697532c1f56802111e62cb87274a53" "q-331162/field-3/84446c3b8121efb985918f1a365c43fc58419d9ac4b4c270b2cab0d78fa38cb5" "q-331162/field-3/5a55df1859ac6969120fa9ce7f22c5a71c09efbc4bea9afa65548ad037fa9428"] :db/ensure [:answer-field/validate]} {:db/id "q-331162" :question/id #uuid "8a86ccb7-b48d-5d3c-a367-87e75ba45fad" :question/math-academy-id "q-331162" :question/problem "Suppose we wish to solve the initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nand we take a step of size $Δx$ using the Runge-Kutta (RK4) method. Fill in the blanks to complete the weighted-average formula for the increment and the stage definitions, starting at the point $(x,y).$\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\ {y}^{′} & =f(x,y) \\\\ {y}_{1}^{′} & =f({{field-1}},\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\ {y}_{2}^{′} & =f(x+\\frac{1}{2}Δx,\\,{{field-2}}) \\\\ {y}_{3}^{′} & =f(x+Δx,\\,{{field-3}})\\end{aligned}\n$$" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe increment in $y$ using the Runge-Kutta (RK4) method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the estimated slope at the point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the estimated slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the estimated slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the estimated slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-331162/field-1" "q-331162/field-2" "q-331162/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b9740440-bdfb-588e-8f23-2eec9427e449"] :knowledge-point/questions ["q-331162"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331213/selection/b2b2487c52633be6396d294ebadec1265f7827ec4e8b5458042006050873a19a" :answer/id #uuid "e41611fd-0a99-505e-9bf8-fab74df9c1af" :answer/type :answer.type/math :answer/value "\\frac{17}{6}" :db/ensure [:answer/validate]} {:db/id "q-331213/selection/17f3ae231a480cff33798464d47b3bea530a423d5d43da4147067e98e897e6dc" :answer/id #uuid "2a955841-cccc-5acc-ad6f-4b57a08a7817" :answer/type :answer.type/math :answer/value "\\frac{13}{16}" :db/ensure [:answer/validate]} {:db/id "q-331213/selection/17f7a92ecac965d3850a7da98658af322c6b691d4b3336f622586133c927298d" :answer/id #uuid "7578fc10-df38-5805-b3a0-02f00e9e6693" :answer/type :answer.type/math :answer/value "\\frac{11}{4}" :db/ensure [:answer/validate]} {:db/id "q-331213/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer/id #uuid "eea541d4-d839-5eef-b23f-b3f3d37d6b1e" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-331213/selection/f1d045a370e1690dcbe82e8f52ad5869b31f51970c76a68794d315424dead0bd" :answer/id #uuid "db5eea1f-648a-531e-8e05-dc6019ce884c" :answer/type :answer.type/math :answer/value "\\frac{29}{12}" :db/ensure [:answer/validate]} {:db/id "q-331213/selection" :answer-field/id #uuid "5109c124-757d-5ca6-80f0-bb905a690dfc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-331213/selection/17f7a92ecac965d3850a7da98658af322c6b691d4b3336f622586133c927298d" :answer-field/choices ["q-331213/selection/b2b2487c52633be6396d294ebadec1265f7827ec4e8b5458042006050873a19a" "q-331213/selection/17f3ae231a480cff33798464d47b3bea530a423d5d43da4147067e98e897e6dc" "q-331213/selection/17f7a92ecac965d3850a7da98658af322c6b691d4b3336f622586133c927298d" "q-331213/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" "q-331213/selection/f1d045a370e1690dcbe82e8f52ad5869b31f51970c76a68794d315424dead0bd"] :db/ensure [:answer-field/validate]} {:db/id "q-331213" :question/id #uuid "26efb47a-b036-5035-b2b5-b1eebdcc61ea" :question/math-academy-id "q-331213" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}=2x-y+3,\\,y(0)=\\frac{1}{3}\n$$\n\nWe wish to approximate the solution using the Runge-Kutta (RK4) method. What entry should be placed in the cell indicated in the table below, if the step size is $Δx=1?$\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $\\frac{1}{3}$ |  |  |  |  |  |\n| $1$ | $\\,?\\,$ |  |  |  |  |  |" :question/worked-solution "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe increment in $y$ using the Runge-Kutta Method with step size $Δx$ is computed as the weighted average of four sample slopes:\n\n$$\nΔy=\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx,\n$$\n\nwhere\n\n- ${y}^{′}=f(x,y)$ is the slope at the initial point $(x,y),$\n\n- ${y}_{1}^{′}=f({x}_{1},{y}_{1})$ is the slope at $({x}_{1},{y}_{1})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx),$\n\n- ${y}_{2}^{′}=f({x}_{2},{y}_{2})$ is the slope at $({x}_{2},{y}_{2})=(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx),$\n\n- ${y}_{3}^{′}=f({x}_{3},{y}_{3})$ is the slope at $({x}_{3},{y}_{3})=(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx).$\n\nNow let's find the required values.\n\n- First, we compute the value of ${y}^{′}$ according to the given rule:\n\n$$\n\\begin{aligned}{y}^{′} & =2x-y+3 \\\\  & =2\\cdot 0-\\frac{1}{3}+3 \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$\n\nSo, we add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $\\,\\frac{1}{3}\\,$ | $\\,\\frac{8}{3}\\,$ |  |  |  |  |\n\n- The first intermediate point is\n\n$$\n\\begin{aligned}({x}_{1},{y}_{1}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot 1,\\,\\frac{1}{3}+\\frac{1}{2}\\cdot \\frac{8}{3}\\cdot 1) \\\\  & =(\\frac{1}{2},\\frac{5}{3}).\\end{aligned}\n$$\n\nSo, the first intermediate slope is\n\n$$\n\\begin{aligned}{y}_{1}^{′} & =2{x}_{1}-{y}_{1}+3 \\\\  & =2\\cdot \\frac{1}{2}-\\frac{5}{3}+3 \\\\  & =\\frac{7}{3}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $\\,\\frac{1}{3}\\,$ | $\\,\\frac{8}{3}\\,$ | $\\frac{7}{3}$ |  |  |  |\n\n- The second intermediate point is\n\n$$\n\\begin{aligned}({x}_{2},{y}_{2}) & =(x+\\frac{1}{2}Δx,\\,y+\\frac{1}{2}{y}_{1}^{′}\\cdot Δx) \\\\  & =(0+\\frac{1}{2}\\cdot 1,\\,\\frac{1}{3}+\\frac{1}{2}\\cdot \\frac{7}{3}\\cdot 1) \\\\  & =(\\frac{1}{2},\\frac{3}{2}).\\end{aligned}\n$$\n\nSo, the second intermediate slope is\n\n$$\n\\begin{aligned}{y}_{2}^{′} & =2{x}_{2}-{y}_{2}+3 \\\\  & =2\\cdot \\frac{1}{2}-\\frac{3}{2}+3 \\\\  & =\\frac{5}{2}.\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $\\,\\frac{1}{3}\\,$ | $\\,\\frac{8}{3}\\,$ | $\\frac{7}{3}$ | $\\frac{5}{2}$ |  |  |\n\n- The third intermediate point is\n\n$$\n\\begin{aligned}({x}_{3},{y}_{3}) & =(x+Δx,\\,y+{y}_{2}^{′}\\cdot Δx) \\\\  & =(0+1,\\,\\frac{1}{3}+\\frac{5}{2}\\cdot 1) \\\\  & =(1,\\frac{17}{6}).\\end{aligned}\n$$\n\nSo, the third intermediate slope is\n\n$$\n\\begin{aligned}{y}_{3}^{′} & =2{x}_{3}-{y}_{3}+3 \\\\  & =2\\cdot 1-\\frac{17}{6}+3 \\\\  & =\\frac{13}{6}.\\end{aligned}\n$$\n\nWe can add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $\\,\\frac{1}{3}\\,$ | $\\,\\frac{8}{3}\\,$ | $\\frac{7}{3}$ | $\\frac{5}{2}$ | $\\frac{13}{6}$ |  |\n\n- Finally, we compute $Δy$ using the Runge-Kutta Method:\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{6}({y}^{′}+2{y}_{1}^{′}+2{y}_{2}^{′}+{y}_{3}^{′})\\cdot Δx \\\\  & =\\frac{1}{6}(\\frac{8}{3}+2\\cdot \\frac{7}{3}+2\\cdot \\frac{5}{2}+\\frac{13}{6})\\cdot 1 \\\\  & =\\frac{1}{6}(\\frac{16}{6}+\\frac{28}{6}+\\frac{30}{6}+\\frac{13}{6})\\cdot 1 \\\\  & =\\frac{1}{6}\\cdot \\frac{87}{6} \\\\  & =\\frac{29}{12}.\\end{aligned}\n$$\n\nWe add this to our table.\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $\\,\\frac{1}{3}\\,$ | $\\,\\frac{8}{3}\\,$ | $\\frac{7}{3}$ | $\\frac{5}{2}$ | $\\frac{13}{6}$ | $\\frac{29}{12}$ |\n\nTo get the values of $x$ and $y$ in the *next* row, we add $Δx$ to $x$ and $Δy$ to $y,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx \\\\  & =0+1 \\\\  & =1 \\\\ {y}_{\\text{new}} & =y+Δy \\\\  & =\\frac{1}{3}+\\frac{29}{12} \\\\  & =\\frac{11}{4}\\end{aligned}\n$$\n\nAdding these rows to our table gives the following:\n\n| $\\,x\\,$ | $\\,y\\,$ | $\\,{y}^{′}\\,$ | $\\,{y}_{1}^{′}\\,$ | $\\,{y}_{2}^{′}\\,$ | $\\,{y}_{3}^{′}\\,$ | $Δy$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $\\,\\frac{1}{3}\\,$ | $\\,\\frac{8}{3}\\,$ | $\\frac{7}{3}$ | $\\frac{5}{2}$ | $\\frac{13}{6}$ | $\\frac{29}{12}$ |\n| $1$ | $\\,\\frac{11}{4}\\,$ |  |  |  |  |  |\n\nTherefore, we conclude that $y\\,(1)≈\\frac{11}{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331213/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b2b7117f-133f-50df-918d-4ff129a660be"] :knowledge-point/questions ["q-331213"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339819/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "a6ddf5cd-4243-5251-81a9-e7ee3af2e489" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-339819/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "45086742-5628-5d78-bbee-69448dc92c64" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-339819/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4ab66372-7bb9-52e5-9f44-dcc4bae47563" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-339819/field-1" :answer-field/id #uuid "6b