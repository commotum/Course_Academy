peratorname{sech}⁡t+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int 7\\operatorname{tanh}⁡t\\operatorname{sech}⁡t\\,\\text{d}t & =7\\int \\operatorname{sech}⁡t\\operatorname{tanh}⁡t\\,\\text{d}t \\\\  & =7(-\\operatorname{sech}⁡t)+C \\\\  & =-7\\operatorname{sech}⁡t+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186375280 :knowledge-point/_questions [{:knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d" :knowledge-point/title "Integrating Hyperbolic Secant-Tangent and Cosecant-Cotangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1ea6492d-7834-52d3-bd99-a3637d56e58d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{csch}⁡y-9\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186375282} {:answer/id #uuid "a4817170-cf92-5f86-8c45-2378086f9fd7" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sech}⁡y-9\\operatorname{csch}⁡y+C" :db/id #edb/ref 17592186375283} {:answer/id #uuid "4d86beff-18d0-57e8-8cbe-31e5febf96ff" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{csch}⁡y-2\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186375284} {:answer/id #uuid "02db99cd-ae59-5381-a278-cb2d3bf5b90d" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{sech}⁡y-2\\operatorname{csch}⁡y+C" :db/id #edb/ref 17592186375285} {:answer/id #uuid "4394925a-d908-56c6-811c-9849e1785fa3" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{csch}⁡y-9\\operatorname{sech}⁡y+C" :db/id #edb/ref 17592186375286}] :answer-field/correct {:answer/id #uuid "02db99cd-ae59-5381-a278-cb2d3bf5b90d" :answer/type {:db/ident :answer.type/math} :answer/value "9\\operatorname{sech}⁡y-2\\operatorname{csch}⁡y+C" :db/id #edb/ref 17592186375285} :answer-field/id #uuid "4413acf9-4747-57a8-92f4-6cf5e6e12f77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375281}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "92ec900f-0d12-52e8-9692-ce10584c5b50" :question/math-academy-id "q-96004" :question/problem "$\\int (2\\operatorname{csch}⁡y\\operatorname{coth}⁡y-9\\operatorname{sech}⁡y\\operatorname{tanh}⁡y)\\text{d}y=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}y}(\\operatorname{sech}⁡y)=-\\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,⇒\\,\\int \\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,\\text{d}y=-\\operatorname{sech}⁡y+C,\n$$\n\n$$\n\\frac{\\text{d}}{\\text{d}y}(\\operatorname{csch}⁡y)=-\\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,⇒\\,\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y=-\\operatorname{csch}⁡y+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (2\\operatorname{csch}⁡y\\operatorname{coth}⁡y-9\\operatorname{sech}⁡y\\operatorname{tanh}⁡y)\\text{d}y & =\\int 2\\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y+\\int (-9\\operatorname{sech}⁡y\\operatorname{tanh}⁡y)\\,\\text{d}y \\\\  & =2\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y-9\\int \\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,\\text{d}y \\\\  & =2(-\\operatorname{csch}⁡y)-9(-\\operatorname{sech}⁡y)+C \\\\  & =9\\operatorname{sech}⁡y-2\\operatorname{csch}⁡y+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186375287 :knowledge-point/_questions [{:knowledge-point/id #uuid "e1992086-0858-551d-a6dc-042276c5d7f9" :knowledge-point/title "Integrating the Square of the Hyperbolic Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8822c95-ba80-5dd4-bac4-a4b4151eea6e" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{2}\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375289} {:answer/id #uuid "61095817-7629-58ee-a83a-6969fdf1a6e3" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{2}\\operatorname{coth}⁡x+C" :db/id #edb/ref 17592186375290} {:answer/id #uuid "7f23d8db-5b6f-5d6a-a982-1b5545c34492" :answer/type {:db/ident :answer.type/math} :answer/value "-{e}^{2}{coth}^{2}⁡x+C" :db/id #edb/ref 17592186375291} {:answer/id #uuid "7a68e224-7301-560a-bef1-fbe29d982d57" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375292} {:answer/id #uuid "ef61b0f1-b4c9-58e8-a83e-08c038ccab22" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}\\operatorname{coth}⁡x+C" :db/id #edb/ref 17592186375293}] :answer-field/correct {:answer/id #uuid "7a68e224-7301-560a-bef1-fbe29d982d57" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{2}\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375292} :answer-field/id #uuid "4a21a509-d8d2-5388-80ab-418b2f273fa5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375288}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "94c6cb02-3862-5b4e-931b-3f5c5b778dbe" :question/math-academy-id "q-96017" :question/problem "$$\n\n$\\int {e}^{2}{sech}^{2}⁡x\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x\\,⇒\\,\\int {sech}^{2}⁡x\\,\\text{d}x=\\operatorname{tanh}⁡x+C.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int {e}^{2}{sech}^{2}⁡x\\,\\text{d}x & ={e}^{2}\\int {sech}^{2}⁡x\\,\\text{d}x \\\\  & ={e}^{2}\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186375294 :knowledge-point/_questions [{:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887" :knowledge-point/title "Integrating the Square of the Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a090b55f-5200-5010-8b95-46ca1754f71c" :answer/type {:db/ident :answer.type/math} :answer/value "{coth}^{2}⁡x-4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375296} {:answer/id #uuid "d0f1b273-856e-56f4-b52e-4f9d002fbbf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{coth}⁡x-4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375297} {:answer/id #uuid "7795c7d1-91d6-5fdf-b05c-fbf4729a46af" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{coth}⁡x+4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375298} {:answer/id #uuid "f54632a5-16d3-52d2-a8aa-186e12c8073c" :answer/type {:db/ident :answer.type/math} :answer/value "-{coth}^{2}⁡x+4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375299} {:answer/id #uuid "1e5e06f7-dbb8-5526-ae54-82a7edb20bec" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{coth}⁡x-4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375300}] :answer-field/correct {:answer/id #uuid "1e5e06f7-dbb8-5526-ae54-82a7edb20bec" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{coth}⁡x-4\\operatorname{tanh}⁡x+C" :db/id #edb/ref 17592186375300} :answer-field/id #uuid "4015abe6-d78b-51d3-9d47-15cc6c8a1f37" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375295}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2aefc827-299a-5251-a5f0-bd4dd1ca318a" :question/math-academy-id "q-96056" :question/problem "$\\int ({csch}^{2}⁡x-4{sech}^{2}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{tanh}⁡x)={sech}^{2}⁡x & \\,⇒\\,\\int {sech}^{2}⁡x\\,\\text{d}x=\\operatorname{tanh}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{csch}^{2}⁡x & \\,⇒\\,\\int {csch}^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({csch}^{2}⁡x-4{sech}^{2}⁡x)\\,\\text{d}x & =\\int {csch}^{2}⁡x\\,\\text{d}x-4\\int {sech}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡x-4\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064883 :knowledge-point/_questions [{:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887" :knowledge-point/title "Integrating the Square of the Hyperbolic Cosecant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c882ef04-bbee-5605-81ba-4582e746d554" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186375302} {:answer/id #uuid "8abc640d-891a-55c0-b4a5-115fa55c382a" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186375303} {:answer/id #uuid "44d2ba10-76b4-5544-9217-71b5e6009846" :answer/type {:db/ident :answer.type/math} :answer/value "5\\operatorname{coth}⁡x-\\operatorname{csch}⁡x+C" :db/id #edb/ref 17592186375304} {:answer/id #uuid "741d3499-f0ce-5d83-babd-a1d3294dc027" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{csch}⁡x+C" :db/id #edb/ref 17592186375305} {:answer/id #uuid "3f3d7c02-8f0d-575f-b7f8-58950db05756" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{coth}⁡x-\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186375306}] :answer-field/correct {:answer/id #uuid "8abc640d-891a-55c0-b4a5-115fa55c382a" :answer/type {:db/ident :answer.type/math} :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C" :db/id #edb/ref 17592186375303} :answer-field/id #uuid "28d5f6ba-8616-5a37-bfac-3de2edb81a44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186375301}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c3aed1bc-a85e-5da0-b40e-ec9bcf1402df" :question/math-academy-id "q-96057" :question/problem "$\\int (5{csch}^{2}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x=$" :question/worked-solution "Recall that\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\operatorname{sech}⁡x)=-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x & \\,⇒\\,\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x=-\\operatorname{sech}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{csch}^{2}⁡x & \\,⇒\\,\\int {csch}^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int (5{csch}^{2}⁡x-\\operatorname{sech}⁡x\\operatorname{tanh}⁡x)\\,\\text{d}x & =5\\int {csch}^{2}⁡x\\,\\text{d}x-\\int \\operatorname{sech}⁡x\\operatorname{tanh}⁡x\\,\\text{d}x \\\\  & =5(-\\operatorname{coth}⁡x)-(-\\operatorname{sech}⁡x)+C \\\\  & =-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C.\\end{aligned}\n$$"}]}
