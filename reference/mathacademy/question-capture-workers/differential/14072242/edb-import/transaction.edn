)\\text{d}y & =\\int 2\\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y+\\int (-9\\operatorname{sech}⁡y\\operatorname{tanh}⁡y)\\,\\text{d}y \\\\  & =2\\int \\operatorname{csch}⁡y\\operatorname{coth}⁡y\\,\\text{d}y-9\\int \\operatorname{sech}⁡y\\operatorname{tanh}⁡y\\,\\text{d}y \\\\  & =2(-\\operatorname{csch}⁡y)-9(-\\operatorname{sech}⁡y)+C \\\\  & =9\\operatorname{sech}⁡y-2\\operatorname{csch}⁡y+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96004/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4daf1299-2291-5bf0-8267-68efcfe4e27d"] :knowledge-point/questions ["q-96004"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96017/selection/66609dcc8efa0f2a06866b27019fb81d5d507f034d3e6f26ec7ae0a12cf60ecb" :answer/id #uuid "61095817-7629-58ee-a83a-6969fdf1a6e3" :answer/type :answer.type/math :answer/value "-{e}^{2}\\operatorname{coth}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-96017/selection/25999a0346eaf1062e3d2e4b0e30584e5470b51e45c882df4e015959752f84ee" :answer/id #uuid "d8822c95-ba80-5dd4-bac4-a4b4151eea6e" :answer/type :answer.type/math :answer/value "-{e}^{2}\\operatorname{tanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-96017/selection/9114a516a86fb79c486c82aaf742790a8bd927563e4625fb69197fab66186f66" :answer/id #uuid "7a68e224-7301-560a-bef1-fbe29d982d57" :answer/type :answer.type/math :answer/value "{e}^{2}\\operatorname{tanh}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-96017/selection/8c8d046de0eca90b29854fa79c0bcffc1c75958f2e0305793763e376ff8da2ac" :answer/id #uuid "7f23d8db-5b6f-5d6a-a982-1b5545c34492" :answer/type :answer.type/math :answer/value "-{e}^{2}{coth}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-96017/selection/a4ace5fd8d07c8dff0c1acb3c478fe242b058a49ab24257a5ebd8ea4c446b57f" :answer/id #uuid "ef61b0f1-b4c9-58e8-a83e-08c038ccab22" :answer/type :answer.type/math :answer/value "{e}^{2}\\operatorname{coth}⁡x+C" :db/ensure [:answer/validate