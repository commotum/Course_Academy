h}⁡x)={sech}^{2}⁡x & \\,⇒\\,\\int {sech}^{2}⁡x\\,\\text{d}x=\\operatorname{tanh}⁡x+C, \\\\ \\frac{\\text{d}}{\\text{d}x}(\\operatorname{coth}⁡x)=-{csch}^{2}⁡x & \\,⇒\\,\\int {csch}^{2}⁡x\\,\\text{d}x=-\\operatorname{coth}⁡x+C.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int ({csch}^{2}⁡x-4{sech}^{2}⁡x)\\,\\text{d}x & =\\int {csch}^{2}⁡x\\,\\text{d}x-4\\int {sech}^{2}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{coth}⁡x-4\\operatorname{tanh}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-96056/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "273bab01-0930-5580-b073-8bafe7505887"] :knowledge-point/questions ["q-96056"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186064883 :question/answer-fields 17592186063807] {:db/id "q-96057/selection/ma-v1/4a6fbc718c079540a39b23d988e4d0e10723e1fbe9df704ffb3d1db48eabde33/4f4e61009c5b93cd51a4d68f9864e3e1dd181d3e644a3d917efa6f81306260e5" :answer/id #uuid "44d2ba10-76b4-5544-9217-71b5e6009846" :answer/type :answer.type/math :answer/value "5\\operatorname{coth}⁡x-\\operatorname{csch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-96057/selection/ma-v1/4a6fbc718c079540a39b23d988e4d0e10723e1fbe9df704ffb3d1db48eabde33/369a8deac994d1481192bf818f7939cd1235582307e85319d203a2c3cfe3023d" :answer/id #uuid "8abc640d-891a-55c0-b4a5-115fa55c382a" :answer/type :answer.type/math :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{sech}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-96057/selection/ma-v1/4a6fbc718c079540a39b23d988e4d0e10723e1fbe9df704ffb3d1db48eabde33/606035fee3d35f358e7e8f327300186cfe4416c5470026f6ba2e8392807ed2dc" :answer/id #uuid "741d3499-f0ce-5d83-babd-a1d3294dc027" :answer/type :answer.type/math :answer/value "-5\\operatorname{coth}⁡x+\\operatorname{csch}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-96057/selection/ma-v1/4a6fbc718c079540a39b23d988e4d0e10723e1fbe9df704ffb3d1db48eabde33/9bad945d327173c24bece1