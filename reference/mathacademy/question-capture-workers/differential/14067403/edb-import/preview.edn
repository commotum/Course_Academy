\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}.\\end{aligned}\n$$\n\nWe substitute this into ${y}_{\\text{new}}=y+Δy$ and move all terms to the left-hand side to define $g({y}_{\\text{new}}):$\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2} \\\\ {{0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y}_{⏟}}_{g({y}_{\\text{new}})} & =0.\\end{aligned}\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=0.25$ is\n\n$$\ng({y}_{\\text{new}})=0.25({y}_{\\text{new}})^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y.\n$$" 13194139535631 true] [17592186358378 1000 #edb/ref 17592186358379 13194139535631 true] [17592186358378 1000 #edb/ref 17592186358380 13194139535631 true] [17592186358378 1000 #edb/ref 17592186358381 13194139535631 true] [17592186358378 1000 #edb/ref 17592186358382 13194139535631 true] [17592186358378 1000 #edb/ref 17592186358383 13194139535631 true] [17592186358378 1040 #edb/ref 17592186045450 13194139535631 true] [17592186358378 1041 "selection" 13194139535631 true] [17592186358378 1104 #edb/ref 17592186358382 13194139535631 true] [17592186358378 1110 #uuid "8fa36696-176b-5d34-a5ba-f5dacde941ce" 13194139535631 true] [17592186358379 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}-y-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-0.25({y}_{\\text{new}})^{2}" 13194139535631 true] [17592186358379 1103 #edb/ref 17592186045453 13194139535631 true] [17592186358379 1111 #uuid "d409b5f5-fa03-5933-8bbc-fede9019aaa8" 13194139535631 true] [17592186358380 1034 "g({y}_{\\text{new}})=0.25{y}^{2}+{y}_{\\text{new}}-0.25\\,{x}_{\\text{new}}\\,{y}_{\\text{new}}-y" 13194139535631 true] [17592186358380 1103 #edb/ref 17592186045453 13194139535631 true] [17592186358380 1111 #uuid "9b6a3172-acd6-50f0-af59-4f96e0c28f6b" 13194139535631 true] [17592186358381 1034 "g({y}_{\\text{new}})=0.25\\,{x}_{