[{:db/id "q-2429/selection/1c91e71f58abee0dcc24c9e5155355f1f435adc9e697f98c2f2f7f0e1b7d34ec" :answer/id #uuid "7c9d3037-4fbf-5129-8a62-c161025d5a8a" :answer/type :answer.type/math :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-6x\\sqrt{x}-4\\sqrt{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2429/selection/39a36b625eabb46d80d95453d66b0c2e3a0a3ed679f58399836495384b699a38" :answer/id #uuid "91698760-bd12-5999-9fef-4df6573b0163" :answer/type :answer.type/math :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-4\\sqrt{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2429/selection/6096f8aee0be42257506bc23a61c4527953226f5ac3957e88feadd95de935178" :answer/id #uuid "e9728da4-774b-503d-b729-29a92e198f2f" :answer/type :answer.type/math :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-4\\sqrt{x}-6\\sqrt{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2429/selection/f4e0c6b6c83d6c0efe01ae4b5fb182db9b3a02114fd14b4b69d0faae21e1e3de" :answer/id #uuid "0d9a36eb-5254-53fc-bbb1-dfe11f1ec5f8" :answer/type :answer.type/math :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x-4x\\sqrt{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2429/selection/84c318d107c1244da1800844880f544c2130744b85cfb9192c90beacc273aa79" :answer/id #uuid "ad30295d-1136-5e50-b7a0-fda7459d537c" :answer/type :answer.type/math :answer/value "2\\sqrt{x}\\operatorname{ln}⁡x+6x\\sqrt{x}-4\\sqrt{x}+C" :db/ensure [:answer/validate]} {:db/id "q-2429/selection" :answer-field/id #uuid "4fcc91ad-2d4b-5a3b-bbe1-275d7b8a9f1e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2429/selection/39a36b625eabb46d80d95453d66b0c2e3a0a3ed679f58399836495384b699a38" :answer-field/choices ["q-2429/selection/1c91e71f58abee0dcc24c9e5155355f1f435adc9e697f98c2f2f7f0e1b7d34ec" "q-2429/selection/39a36b625eabb46d80d95453d66b0c2e3a0a3ed679f58399836495384b699a38" "q-2429/selection/6096f8aee0be42257506bc23a61c4527953226f5ac3957e88feadd95de935178" "q-2429/selection/f4e0c6b6c83d6c0efe01ae4b5fb182db9b3a02114fd14b4b69d0faae21e1e3de" "q-2429/selection/84c318d107c1244da1800844880f544c2130744b85cfb9192c90beacc273aa79"] :db/ensure [:answer-field/validate]} {:db/id "q-2429" :question/id #uuid "c1cbc4f3-c36a-51f9-819b-9221ea4ff42b" :question/math-academy-id "q-2429" :question/problem "$\\int \\frac{\\operatorname{ln}⁡x}{\\sqrt{x}}\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=\\frac{1}{\\sqrt{x}}\\, & ⟹\\,v=\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x=2\\sqrt{x}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{ln}⁡x}{\\sqrt{x}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(2\\sqrt{x})-\\int (2\\sqrt{x})(\\frac{1}{x})\\,\\text{d}x \\\\  & =2\\sqrt{x}\\operatorname{ln}⁡(x)-2\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\  & =2\\sqrt{x}\\operatorname{ln}⁡(x)-4\\sqrt{x}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-2429/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-2429"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14722/selection/d2c29e7f1d0645b532fd0726e660eeda1012867f4bf92ca41ee9b0a8de7d01ea" :answer/id #uuid "666ecd74-b3c3-5da0-b19b-17cfa47eb155" :answer/type :answer.type/math :answer/value "x(\\operatorname{ln}⁡({x}^{2})-1)+C" :db/ensure [:answer/validate]} {:db/id "q-14722/selection/e04b5ee33ef9b23b5afb615734ed9ef786fcd0db7dd8a51f6153350a72c5fcbe" :answer/id #uuid "4cf15308-86cc-55ce-ada5-5f70383b7ec0" :answer/type :answer.type/math :answer/value "\\frac{x}{2}(\\operatorname{ln}⁡(x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-14722/selection/d3d8cd925edf72b944d0fdad8de9d539d466570b9090d46cddadbb957ce71b74" :answer/id #uuid "8c7634a5-e2ae-58f4-a3b4-b804a8f06673" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}(\\operatorname{ln}⁡(x)+2)+C" :db/ensure [:answer/validate]} {:db/id "q-14722/selection/41ef2e4bd5c830821c43527cab9130c4dc24c2d7a4203375330890ea49f4d7b8" :answer/id #uuid "74057c0f-e278-5c96-b2b6-269573b365d8" :answer/type :answer.type/math :answer/value "{x}^{2}(\\operatorname{ln}⁡({x}^{2})-1)+C" :db/ensure [:answer/validate]} {:db/id "q-14722/selection/7c7137002ec27bf50e4031b846570efa100303447cf5dba7439ffc9a585e971c" :answer/id #uuid "a98dec41-c185-511f-b86f-d11d62686a7e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{2}(\\operatorname{ln}⁡({x}^{2})-1)+C" :db/ensure [:answer/validate]} {:db/id "q-14722/selection" :answer-field/id #uuid "bf19432a-bda6-5cce-bcb9-aa042d58eb7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-14722/selection/41ef2e4bd5c830821c43527cab9130c4dc24c2d7a4203375330890ea49f4d7b8" :answer-field/choices ["q-14722/selection/d2c29e7f1d0645b532fd0726e660eeda1012867f4bf92ca41ee9b0a8de7d01ea" "q-14722/selection/e04b5ee33ef9b23b5afb615734ed9ef786fcd0db7dd8a51f6153350a72c5fcbe" "q-14722/selection/d3d8cd925edf72b944d0fdad8de9d539d466570b9090d46cddadbb957ce71b74" "q-14722/selection/41ef2e4bd5c830821c43527cab9130c4dc24c2d7a4203375330890ea49f4d7b8" "q-14722/selection/7c7137002ec27bf50e4031b846570efa100303447cf5dba7439ffc9a585e971c"] :db/ensure [:answer-field/validate]} {:db/id "q-14722" :question/id #uuid "cc69208e-918d-5ad0-916e-0a8f50777de1" :question/math-academy-id "q-14722" :question/problem "$\\int 2x\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x=$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡({x}^{2})\\, & ⟹\\,{u}^{′}=\\frac{2}{x} \\\\ {v}^{′}=2x\\, & ⟹\\,v=\\int 2x\\,\\text{d}x={x}^{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 2x\\operatorname{ln}⁡({x}^{2})\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({x}^{2})\\cdot {x}^{2}-\\int {x}^{2}(\\frac{2}{x})\\,\\text{d}x \\\\  & ={x}^{2}\\operatorname{ln}⁡({x}^{2})-\\int 2x\\,\\text{d}x \\\\  & ={x}^{2}\\operatorname{ln}⁡({x}^{2})-2\\frac{{x}^{2}}{2}+C \\\\  & ={x}^{2}\\operatorname{ln}⁡({x}^{2})-{x}^{2}+C \\\\  & ={x}^{2}(\\operatorname{ln}⁡({x}^{2})-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-14722/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-14722"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350960/field-1/76eda3aec734a0d7bece591b01aa4589c5ee0a5b7b081201de23a3d822658c25" :answer/id #uuid "239eed72-3016-52bd-9509-b0b5ff978706" :answer/type :answer.type/math :answer/value "\\frac{17e^{18}+1}{9}" :db/ensure [:answer/validate]} {:db/id "q-350960/field-1" :answer-field/id #uuid "5578b927-5d8c-5e1d-9eaa-a72aab5a6f04" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350960/field-1/76eda3aec734a0d7bece591b01aa4589c5ee0a5b7b081201de23a3d822658c25" :answer-field/choices ["q-350960/field-1/76eda3aec734a0d7bece591b01aa4589c5ee0a5b7b081201de23a3d822658c25"] :db/ensure [:answer-field/validate]} {:db/id "q-350960" :question/id #uuid "12fdbac6-b0fe-5529-b377-32ed7d4fe6fd" :question/math-academy-id "q-350960" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{3}}4{x}^{5}\\operatorname{ln}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=4{x}^{5} & \\,⟹\\,v=\\int 4{x}^{5}\\,dx=\\frac{2{x}^{6}}{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{3}}4{x}^{5}\\operatorname{ln}⁡(x)\\,\\text{d}x & ={\\int }_{1}^{{e}^{3}}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{3}}-{\\int }_{1}^{{e}^{3}}v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(\\frac{2{x}^{6}}{3}){|}_{1}^{{e}^{3}}-{\\int }_{1}^{{e}^{3}}(\\frac{2{x}^{6}}{3})(\\frac{1}{x})\\,\\text{d}x \\\\  & =[\\frac{2({e}^{3})^{6}\\operatorname{ln}⁡({e}^{3})}{3}-\\frac{2(1)^{6}\\operatorname{ln}⁡(1)}{3}]-\\frac{2}{3}{\\int }_{1}^{{e}^{3}}{x}^{5}\\,\\text{d}x \\\\  & =\\frac{2{e}^{18}\\operatorname{ln}⁡({e}^{3})}{3}-\\frac{{x}^{6}}{9}{|}_{1}^{{e}^{3}} \\\\  & =2{e}^{18}-(\\frac{{e}^{18}}{9}-\\frac{1}{9}) \\\\  & =\\frac{1}{9}(18{e}^{18}-{e}^{18}+1) \\\\  & =\\frac{1}{9}(17{e}^{18}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350960/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-350960"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350965/field-1/e86ebc1adcb412f755aa0c3c950748810528b0f6e50e2d96e16072df58508a7a" :answer/id #uuid "ad9ad490-8d79-549f-9c25-d17ebabe1e14" :answer/type :answer.type/math :answer/value "\\frac{52e^{14}+4}{49}" :db/ensure [:answer/validate]} {:db/id "q-350965/field-1" :answer-field/id #uuid "836698fc-7f29-5146-8d66-1ef9cfde66fe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350965/field-1/e86ebc1adcb412f755aa0c3c950748810528b0f6e50e2d96e16072df58508a7a" :answer-field/choices ["q-350965/field-1/e86ebc1adcb412f755aa0c3c950748810528b0f6e50e2d96e16072df58508a7a"] :db/ensure [:answer-field/validate]} {:db/id "q-350965" :question/id #uuid "b7a04644-a966-560d-8fe0-a0cecdf92a78" :question/math-academy-id "q-350965" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{{e}^{2}}4{x}^{6}\\operatorname{ln}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x & \\,⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=4{x}^{6} & \\,⟹\\,v=\\int 4{x}^{6}\\,dx=\\frac{4{x}^{7}}{7}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}4{x}^{6}\\operatorname{ln}⁡(x)\\,\\text{d}x & ={\\int }_{1}^{{e}^{2}}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x(\\frac{4{x}^{7}}{7}){|}_{1}^{{e}^{2}}-{\\int }_{1}^{{e}^{2}}(\\frac{4{x}^{7}}{7})(\\frac{1}{x})\\,\\text{d}x \\\\  & =[\\frac{4({e}^{2})^{7}\\operatorname{ln}⁡({e}^{2})}{7}-\\frac{4(1)^{7}\\operatorname{ln}⁡(1)}{7}]-\\frac{4}{7}{\\int }_{1}^{{e}^{2}}{x}^{6}\\,\\text{d}x \\\\  & =\\frac{4{e}^{14}\\operatorname{ln}⁡({e}^{2})}{7}-\\frac{4{x}^{7}}{49}{|}_{1}^{{e}^{2}} \\\\  & =\\frac{8{e}^{14}}{7}-(\\frac{4{e}^{14}}{49}-\\frac{4}{49}) \\\\  & =\\frac{1}{49}(56{e}^{14}-4{e}^{14}+4) \\\\  & =\\frac{4}{49}(13{e}^{14}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350965/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "31a28451-005e-50dc-a7cf-5b666b1d7735"] :knowledge-point/questions ["q-350965"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-12568"] :question/problem "Calculate $\\int x{log}_{2}⁡(3x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(3x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=x\\, & ⟹\\,v=\\int x\\,\\text{d}x=\\frac{{x}^{2}}{2}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int x{log}_{2}⁡(3x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{2}⁡(3x)\\cdot (\\frac{{x}^{2}}{2})-\\int (\\frac{{x}^{2}}{2})(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =\\frac{{x}^{2}{log}_{2}⁡(3x)}{2}-\\frac{1}{2\\operatorname{ln}⁡2}\\int x\\,\\text{d}x \\\\  & =\\frac{{x}^{2}\\operatorname{ln}⁡(3x)}{2\\operatorname{ln}⁡2}-\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{2}}{4\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡(3x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-12566/selection/fc06e5df7eba247d924d100a645f3ad5ef2796eedf5834948be5174c62519fc1" :answer/id #uuid "392bd0fa-9952-5802-bd29-97ab9c658a10" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}(3\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-12566/selection/65ee550fede8227d38cd6e1e1795deb92e1653585d4de3e1366f4db83bd32146" :answer/id #uuid "47263fdf-3252-5758-901c-ebc791afddc1" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{9\\operatorname{ln}⁡2}(3\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-12566/selection/5ff99ec34defc6ef62e0d878ef722cb83cb495e709a66842dd61d5df1024dd4b" :answer/id #uuid "56cfb89d-737e-5b4b-b164-bd69bc88630e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{3\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-3)+C" :db/ensure [:answer/validate]} {:db/id "q-12566/selection/18ad2b5c3d59e1645916f4e978356b10282a584c23d603f61699b1688523cf8f" :answer/id #uuid "13464e63-1657-559d-8a28-699cd51ad462" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{9\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-3)+C" :db/ensure [:answer/validate]} {:db/id "q-12566/selection/3a5b87f8fb9bdc1b20fd222677e890b67b00bdc218c150915f25c7ff19db1bd0" :answer/id #uuid "7edc9cc9-d471-528e-8546-4a59b2f203d0" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{3\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-12566/selection" :answer-field/id #uuid "c7f656bc-8a9e-57c4-9968-b809486d5ebf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-12566/selection/fc06e5df7eba247d924d100a645f3ad5ef2796eedf5834948be5174c62519fc1" :answer-field/choices ["q-12566/selection/fc06e5df7eba247d924d100a645f3ad5ef2796eedf5834948be5174c62519fc1" "q-12566/selection/65ee550fede8227d38cd6e1e1795deb92e1653585d4de3e1366f4db83bd32146" "q-12566/selection/5ff99ec34defc6ef62e0d878ef722cb83cb495e709a66842dd61d5df1024dd4b" "q-12566/selection/18ad2b5c3d59e1645916f4e978356b10282a584c23d603f61699b1688523cf8f" "q-12566/selection/3a5b87f8fb9bdc1b20fd222677e890b67b00bdc218c150915f25c7ff19db1bd0"] :db/ensure [:answer-field/validate]} {:db/id "q-12566" :question/id #uuid "acfabbf7-741d-5b7a-a2d2-0388e3cd4c2f" :question/math-academy-id "q-12566" :question/problem "Calculate $\\int {x}^{2}{log}_{2}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}={x}^{2}\\, & ⟹\\,v=\\int {x}^{2}\\,\\text{d}x=\\frac{{x}^{3}}{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {x}^{2}{log}_{2}⁡(x)\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =({log}_{2}⁡(x))(\\frac{{x}^{3}}{3})-\\int (\\frac{{x}^{3}}{3})(\\frac{1}{x\\operatorname{ln}⁡2})\\,\\text{d}x \\\\  & =\\frac{{x}^{3}{log}_{2}⁡(x)}{3}-\\frac{1}{3\\operatorname{ln}⁡2}\\int {x}^{2}\\,\\text{d}x \\\\  & =\\frac{{x}^{3}\\operatorname{ln}⁡x}{3\\operatorname{ln}⁡2}-\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{3}}{9\\operatorname{ln}⁡2}(3\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-12566/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413"] :knowledge-point/questions ["q-12566"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78963/selection/7f51c22054e03fff098524923e6512893f4ab2806b7460de08d4f06247ce140d" :answer/id #uuid "882702ef-d805-51f1-a920-8e3e9c05415d" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{3}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡(2x)+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78963/selection/57f62b8961ed56def6ed659dae31b09f40d1688d18f492b365fefe431472e87e" :answer/id #uuid "be892953-b28f-5d13-9a66-bc3a59502428" :answer/type :answer.type/math :answer/value "\\frac{3{x}^{3}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡(2x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78963/selection/c9bd73914d85f71181f6d51d8bbcadd6b559d5a8bc5ab1eefb0d613af5d8f3a3" :answer/id #uuid "bb4f4c04-f28d-5a23-9a3e-be8dc893989e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{\\operatorname{ln}⁡3}(3\\operatorname{ln}⁡(2x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78963/selection/0bb57dcc3336f3a0cb691dcd4090eeb2ea460101576addeb0712fb25c3d0841e" :answer/id #uuid "ac331f0a-166a-5ba1-ad0b-005ba063d432" :answer/type :answer.type/math :answer/value "\\frac{9{x}^{3}}{\\operatorname{ln}⁡3}(\\operatorname{ln}⁡(2x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78963/selection/eb3e78f9170f2192e525f328f9e745b8f6d585417c35ba65db2da5413624e5a9" :answer/id #uuid "54c3dacc-1766-5d5d-b7f0-9c564b552007" :answer/type :answer.type/math :answer/value "\\frac{{x}^{3}}{\\operatorname{ln}⁡3}(3\\operatorname{ln}⁡(2x)+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78963/selection" :answer-field/id #uuid "9aa6a480-20a5-52af-bb4a-fe3c74b08122" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78963/selection/c9bd73914d85f71181f6d51d8bbcadd6b559d5a8bc5ab1eefb0d613af5d8f3a3" :answer-field/choices ["q-78963/selection/7f51c22054e03fff098524923e6512893f4ab2806b7460de08d4f06247ce140d" "q-78963/selection/57f62b8961ed56def6ed659dae31b09f40d1688d18f492b365fefe431472e87e" "q-78963/selection/c9bd73914d85f71181f6d51d8bbcadd6b559d5a8bc5ab1eefb0d613af5d8f3a3" "q-78963/selection/0bb57dcc3336f3a0cb691dcd4090eeb2ea460101576addeb0712fb25c3d0841e" "q-78963/selection/eb3e78f9170f2192e525f328f9e745b8f6d585417c35ba65db2da5413624e5a9"] :db/ensure [:answer-field/validate]} {:db/id "q-78963" :question/id #uuid "7b9ed7c7-8416-5dd4-8ed9-af068b0cd0bd" :question/math-academy-id "q-78963" :question/problem "Calculate $\\int 9{x}^{2}{log}_{3}⁡(2x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{3}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ {v}^{′}=9{x}^{2}\\, & ⟹\\,v=\\int 9{x}^{2}\\,\\text{d}x=3{x}^{3}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 9{x}^{2}{log}_{3}⁡(2x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{3}⁡(2x)\\cdot (3{x}^{3})-\\int \\frac{3{x}^{3}}{x\\operatorname{ln}⁡3}\\,\\text{d}x \\\\  & =3{x}^{3}{log}_{3}⁡(2x)-\\frac{1}{\\operatorname{ln}⁡3}\\int 3{x}^{2}\\,\\text{d}x \\\\  & =3{x}^{3}{log}_{3}⁡(2x)-\\frac{1}{\\operatorname{ln}⁡3}\\cdot {x}^{3}+C \\\\  & =\\frac{3{x}^{3}\\operatorname{ln}⁡(2x)}{\\operatorname{ln}⁡3}-\\frac{{x}^{3}}{\\operatorname{ln}⁡3}+C \\\\  & =\\frac{{x}^{3}}{\\operatorname{ln}⁡3}(3\\operatorname{ln}⁡(2x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{3}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78963/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413"] :knowledge-point/questions ["q-78963"] :db/ensure [:knowledge-point/validate]} {:db/id "q-78966/selection/f1bb06c5d08b192ed1e9ac24ae6c3d79a0405248441ca180d815edb1eb009b11" :answer/id #uuid "f3649b73-f7da-5804-a676-ae738e75bb75" :answer/type :answer.type/math :answer/value "\\frac{2x}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78966/selection/a4d3976652d0b5887e1c0c28a1b80e517387a432a1550d65cc7a2510f0080c90" :answer/id #uuid "96ddcca3-5d15-53aa-8370-73a73f650fd9" :answer/type :answer.type/math :answer/value "\\frac{x}{\\operatorname{ln}⁡2}(2\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78966/selection/e745328a115307bb13bdefd438ad8de8d8675486b61355c67fda5e00ccf84946" :answer/id #uuid "1bd447bf-6974-56de-9e1a-45f92ecd766c" :answer/type :answer.type/math :answer/value "\\frac{2x}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78966/selection/2cca8429e36c80d5b34db693e5e203b2c8be4397a719d3521c990fe74ab9282b" :answer/id #uuid "d354ac99-1e1b-53ee-b795-8711beff0f1a" :answer/type :answer.type/math :answer/value "\\frac{x}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78966/selection/9fef3b55fa7ba742f8b9f13a185f6b105c814e179a06c652830bd9ce354fef35" :answer/id #uuid "56c909fb-acbb-567b-abe4-5c75e7690427" :answer/type :answer.type/math :answer/value "\\frac{x}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78966/selection" :answer-field/id #uuid "56fe89b8-1b85-5f44-841a-cf5b2ec294dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78966/selection/2cca8429e36c80d5b34db693e5e203b2c8be4397a719d3521c990fe74ab9282b" :answer-field/choices ["q-78966/selection/f1bb06c5d08b192ed1e9ac24ae6c3d79a0405248441ca180d815edb1eb009b11" "q-78966/selection/a4d3976652d0b5887e1c0c28a1b80e517387a432a1550d65cc7a2510f0080c90" "q-78966/selection/e745328a115307bb13bdefd438ad8de8d8675486b61355c67fda5e00ccf84946" "q-78966/selection/2cca8429e36c80d5b34db693e5e203b2c8be4397a719d3521c990fe74ab9282b" "q-78966/selection/9fef3b55fa7ba742f8b9f13a185f6b105c814e179a06c652830bd9ce354fef35"] :db/ensure [:answer-field/validate]} {:db/id "q-78966" :question/id #uuid "ece8a685-6392-5fbc-8337-860c17b91242" :question/math-academy-id "q-78966" :question/problem "$\\int {log}_{2}⁡(x)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int {log}_{2}⁡(x)\\,\\text{d}x=\\int \\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}\\,\\text{d}x=\\frac{1}{\\operatorname{ln}⁡2}\\int \\operatorname{ln}⁡x\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int {log}_{2}⁡(x)\\,\\text{d}x & =\\frac{1}{\\operatorname{ln}⁡2}\\int \\operatorname{ln}⁡x\\,\\text{d}x \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}[uv-\\int v{u}^{′}\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}[x\\operatorname{ln}⁡x-\\int x\\cdot \\frac{1}{x}\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡2}[x\\operatorname{ln}⁡x-\\int 1\\,\\text{d}x] \\\\  & =\\frac{x\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}-\\frac{x}{\\operatorname{ln}⁡2}+C \\\\  & =\\frac{x}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-78966/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759"] :knowledge-point/questions ["q-78966"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49712/selection/e6cac81151d1a314f1f23c9724413a948c6f42099b7daea3976a908105c1e0dc" :answer/id #uuid "eb88b6a5-3216-59c8-9dbd-dcc8cd9b01fe" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡(4)}{e}" :db/ensure [:answer/validate]} {:db/id "q-49712/selection/fa4f8e01d46aae20b7aba3d7f292c838229738be9dc8caf1235fcbe11e6bff91" :answer/id #uuid "47831ab8-c986-503f-9bc9-e4829f3b72e5" :answer/type :answer.type/math :answer/value "e\\operatorname{ln}⁡(4)" :db/ensure [:answer/validate]} {:db/id "q-49712/selection/cd22dfde0bd5e438f6a147e8eb846ea606a95eda9808691042a0ea939490857c" :answer/id #uuid "af98e46c-fa9d-5313-b126-992f4053f0ee" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡(4)}" :db/ensure [:answer/validate]} {:db/id "q-49712/selection/b7805ccf90968e88122cbc9a478ed999a7ef1dc6d71f89e46b0a447628ab44f5" :answer/id #uuid "7e5e2c14-c39c-5342-aaba-87dcb319f28e" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(4)" :db/ensure [:answer/validate]} {:db/id "q-49712/selection/7bd77c05b6b0c45620416eae06abf87860fa5bc3e0592234b9b905b02108ec2a" :answer/id #uuid "2426fed9-5fc5-557f-b1eb-a34eac694e16" :answer/type :answer.type/math :answer/value "\\frac{e}{\\operatorname{ln}⁡(4)}" :db/ensure [:answer/validate]} {:db/id "q-49712/selection" :answer-field/id #uuid "39cd5324-1290-5fd0-a5e1-c982fa76ad28" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49712/selection/cd22dfde0bd5e438f6a147e8eb846ea606a95eda9808691042a0ea939490857c" :answer-field/choices ["q-49712/selection/e6cac81151d1a314f1f23c9724413a948c6f42099b7daea3976a908105c1e0dc" "q-49712/selection/fa4f8e01d46aae20b7aba3d7f292c838229738be9dc8caf1235fcbe11e6bff91" "q-49712/selection/cd22dfde0bd5e438f6a147e8eb846ea606a95eda9808691042a0ea939490857c" "q-49712/selection/b7805ccf90968e88122cbc9a478ed999a7ef1dc6d71f89e46b0a447628ab44f5" "q-49712/selection/7bd77c05b6b0c45620416eae06abf87860fa5bc3e0592234b9b905b02108ec2a"] :db/ensure [:answer-field/validate]} {:db/id "q-49712" :question/id #uuid "a679d6ab-62b1-5316-b84d-9712f4ecec56" :question/math-academy-id "q-49712" :question/problem "Evaluate ${\\int }_{1}^{e}{log}_{4}⁡(x)\\,\\text{d}x.$" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1}^{e}{log}_{4}⁡(x)\\text{d}x={\\int }_{1}^{e}\\frac{\\operatorname{ln}⁡(x)}{\\operatorname{ln}⁡(4)}\\,\\text{d}x=\\frac{1}{\\operatorname{ln}⁡(4)}{\\int }_{1}^{e}\\operatorname{ln}⁡(x)\\cdot 1\\cdot \\text{d}x.\n$$\n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}{log}_{4}⁡(x)\\text{d}x & =\\frac{1}{\\operatorname{ln}⁡(4)}{\\int }_{1}^{e}\\operatorname{ln}⁡(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}{\\int }_{1}^{e}u{v}^{′}\\,\\text{d}x \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}[uv{|}_{1}^{e}-{\\int }_{1}^{e}v{u}^{′}\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}[\\operatorname{ln}⁡(x)(x){|}_{1}^{e}-{\\int }_{1}^{e}x(\\frac{1}{x})\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}[e\\operatorname{ln}⁡(e)-\\operatorname{ln}⁡(1)-{\\int }_{1}^{e}\\,\\text{d}x] \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}[e-x{|}_{1}^{e}\\,] \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}(e-e+1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49712/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759"] :knowledge-point/questions ["q-49712"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350967/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "1c788a7c-739c-564f-ac07-de204c9ffd36" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-350967/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "1aa99a0c-c5b5-5a52-826d-f3dae4a9214d" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-350967/field-1" :answer-field/id #uuid "a8f8f17b-26a1-5931-9b5e-85d1dfd9ddd3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350967/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-350967/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-350967/field-1/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-350967" :question/id #uuid "01434e96-0acb-5606-b679-13b67a626150" :question/math-academy-id "q-350967" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\,\\text{d}x={\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{e/2}\\operatorname{ln}⁡(2x)\\,\\text{d}x & ={\\int }_{1/2}^{e/2}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{1/2}^{e/2}-{\\int }_{1/2}^{e/2}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡(2x)\\,(x){|}_{1/2}^{e/2}-{\\int }_{1/2}^{e/2}x(\\frac{1}{x})\\,\\text{d}x \\\\  & =[\\operatorname{ln}⁡(2\\cdot \\frac{e}{2})\\,(\\frac{e}{2})-\\operatorname{ln}⁡(2\\cdot \\frac{1}{2})\\,(\\frac{1}{2})]-{\\int }_{1/2}^{e/2}\\text{d}x \\\\  & =\\frac{e}{2}\\operatorname{ln}⁡(e)-\\frac{1}{2}\\operatorname{ln}⁡(1)-x{|}_{1/2}^{e/2} \\\\  & =\\frac{1}{2}e-\\frac{1}{2}e+\\frac{1}{2} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350967/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759"] :knowledge-point/questions ["q-350967"] :db/ensure [:knowledge-point/validate]}]
