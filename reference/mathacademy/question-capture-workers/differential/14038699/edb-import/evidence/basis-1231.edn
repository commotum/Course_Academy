#{[{:db/id #edb/ref 17592186293942 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "03ab38cf-a5af-5384-bdb0-adebedb61c03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293944} {:answer/id #uuid "7f0342b1-2889-533a-b143-2aaa9b3865da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293945} {:answer/id #uuid "ddc97104-c440-566b-8fdd-51084aa09457" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{4}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293946} {:answer/id #uuid "a1ba874e-8dcf-5530-8e52-ba8a0c690296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293947} {:answer/id #uuid "61a7f51c-b809-5293-9060-2e7e447669a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293948}] :answer-field/correct {:answer/id #uuid "61a7f51c-b809-5293-9060-2e7e447669a0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C" :db/id #edb/ref 17592186293948} :answer-field/id #uuid "1e49af5d-d2fe-5544-93ff-5bc43178ebe6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293943}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0002bb48-63e3-5869-82b8-396b34ff4061" :question/math-academy-id "q-78962" :question/problem "Calculate $\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{2}⁡(x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡2} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{2}⁡(x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{2}⁡(x)(5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡2}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{2}⁡(x)-\\frac{1}{\\operatorname{ln}⁡2}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}-\\frac{{x}^{5}}{\\operatorname{ln}⁡2}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡2}(5\\operatorname{ln}⁡x-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{2}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡2}.$"}] [{:db/id #edb/ref 17592186293949 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d8803e90-c191-52d6-8000-b1786a6f2b98" :answer/type {:db/ident :answer.type/math} :answer/value "2x(\\operatorname{ln}⁡(2x)+1)+C" :db/id #edb/ref 17592186293951} {:answer/id #uuid "c33681d6-952b-5538-8d83-59c7b03cbb1f" :answer/type {:db/ident :answer.type/math} :answer/value "4x(\\operatorname{ln}⁡(4x)+1)+C" :db/id #edb/ref 17592186293952} {:answer/id #uuid "93bad77f-fc4c-5151-b61a-1e3552e61d95" :answer/type {:db/ident :answer.type/math} :answer/value "2x(\\operatorname{ln}⁡(4x)-1)+C" :db/id #edb/ref 17592186293953} {:answer/id #uuid "24b67811-2588-5ef9-b110-04869e9d624f" :answer/type {:db/ident :answer.type/math} :answer/value "4x(\\operatorname{ln}⁡(2x)-1)+C" :db/id #edb/ref 17592186293954} {:answer/id #uuid "0b28fab3-cd5e-5936-b51e-8b0a7c76cac7" :answer/type {:db/ident :answer.type/math} :answer/value "x(\\operatorname{ln}⁡(4x)-1)+C" :db/id #edb/ref 17592186293955}] :answer-field/correct {:answer/id #uuid "93bad77f-fc4c-5151-b61a-1e3552e61d95" :answer/type {:db/ident :answer.type/math} :answer/value "2x(\\operatorname{ln}⁡(4x)-1)+C" :db/id #edb/ref 17592186293953} :answer-field/id #uuid "69fc184d-93d8-5619-91bc-9ecb7ce71f48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293950}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8f8b4061-8471-5977-a76a-c60012c56f62" :question/math-academy-id "q-78973" :question/problem "$\\int 2\\operatorname{ln}⁡(4x)\\,\\text{d}x=$" :question/worked-solution "First, we write the integral as\n\n$$\n\\int 2\\operatorname{ln}⁡4x\\,\\text{d}x=2\\int \\operatorname{ln}⁡4x\\cdot 1\\,\\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int \\,\\text{d}x=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}2\\int \\operatorname{ln}⁡(4x)\\,\\text{d}x & =2\\int u\\,{v}^{′}\\,\\text{d}x \\\\  & =2[uv-\\int v{u}^{′}\\,\\text{d}x] \\\\  & =2[\\operatorname{ln}⁡(4x)\\cdot x-\\int x\\cdot \\frac{1}{x}\\,\\text{d}x] \\\\  & =2[x\\operatorname{ln}⁡(4x)-\\int \\,\\text{d}x] \\\\  & =2x\\operatorname{ln}⁡(4x)-2x+C \\\\  & =2x(\\operatorname{ln}⁡(4x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}]}
