\\pi x)" :db/ensure [:answer/validate]} {:db/id "q-341267/field-2/fd0623bef64bcb0a0ce9b59f822de4999c714270edbdc40bbf7ea19c5354d539" :answer/id #uuid "ddf98b43-db4e-56fd-94f3-7058a6e08a1b" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "q-341267/field-2" :answer-field/id #uuid "fb7392ee-bfd4-550c-a433-adaab877cd63" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-341267/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" :answer-field/choices ["q-341267/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" "q-341267/field-2/3a86edc502d0038df0dcd390c378431e5286836bbdd60033424dd2f8510c1df7" "q-341267/field-2/3f6a3aa25491ef321371576cb221342060d043d2422df9923d1f53fc94cde6cd" "q-341267/field-2/fd0623bef64bcb0a0ce9b59f822de4999c714270edbdc40bbf7ea19c5354d539"] :db/ensure [:answer-field/validate]} {:db/id "q-341267" :question/id #uuid "a16f0f8b-2c48-53b0-a87f-d492038e6e5e" :question/math-academy-id "q-341267" :question/problem "Let $F(x)=3x+1$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(1+\\frac{3}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=3x+1$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(3x+1)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=3x+1\\, & ⇒\\,{u}^{′}=3 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(3x+1)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{3}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((3\\pi +1)\\operatorname{sin}⁡(n\\pi )-\\operatorname{sin}⁡(0))+\\frac{3}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{3}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{6(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(1+\\frac{3}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{6((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341267/field-1" "q-341267/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f1e90af1-3fbd-5aa3-ac32-ac54c27c7224"] :knowledge-point/questions ["q-341267"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341266/field-1/5c7fe269e01daa03ed4e2d7885198e02ff2fad04fc163360a8fcb826ef08b431" :answer/id #uuid "6a529e7f-2e08-5d32-86be-26c51241e5e6" :answer/type :answer.type/math :answer/value "\\frac{(-1)^{n}}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341266/field-1/10d01e8a30daa24424d5401272b85f570d3f8d957ab464ad1c7746c1d831a942" :answer/id #uuid "e65f3ed7-09c4-5a34-90f8-47303b407d1a" :answer/type :answer.type/math :answer/value "\\frac{1-(-1)^{n}}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341266/field-1/e1331cd8c2b4199cd760ef444b8670b0dad8a06384f7ce9a9d68bdd7516ed61c" :answer/id #uuid "643ec4f7-c8db-50a5-9ad2-42fae68fea65" :answer/type :answer.type/math :answer/value "\\frac{2(-1)^{n}}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341266/field-1/b3926d4f27cfafd3489c7ba9ba849b1a1258f02aea263f118f936f6a1