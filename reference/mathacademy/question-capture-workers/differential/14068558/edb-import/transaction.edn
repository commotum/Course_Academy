91b791258a459e962b79c70fd1f7cdf61ee074389fa9815ad582e970c"] :db/ensure [:answer-field/validate]} {:db/id "q-341243" :question/id #uuid "f88a83b4-0e18-5fc8-8f06-28f6b0873a88" :question/math-academy-id "q-341243" :question/problem "Let $F(x)={x}^{3}+2\\operatorname{cos}⁡x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}+2\\operatorname{cos}⁡(-x) \\\\  & =-{x}^{3}+2\\operatorname{cos}⁡x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341243/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a32afd19-5779-56f0-ad6d-1d6b541899f8"] :knowledge-point/questions ["q-341243"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341240/selection/fa182068396ec0333367b693c2ca97dd144fca75567baeec6a5c9ec30fe7868e" :answer/id #uuid "9da00bb1-e26d-5682-b059-5e099c4e683e" :answer/type :answer.type/math :answer/value "|x{|}^{3}+|x|" :db/ensure [:answer/validate]} {:db/id "q-341240/selection/2bf16311d5a5a02dab284220a4ac8d5f1c55cf2799631d44f6418aa9214aae14" :answer/id #uuid "c1c37179-f214-594f-8ae6-8608c703868b" :answer/type :answer.type/math :answer/value "-{x}^{3}-x" :db/ensure [:answer/validate]} {:db/id "q-341240/selection/4dee2f2ff6de2671969014b152b57be8cd1543a3db4ec8d03954daf66905a734" :answer/id #uuid "ebbdff3d-d48a-502a-8094-2c4e10972910" :answer/type :answer.type/math :answer/value "{x}^{3}-x" :db/ensure [:answer/validate]} {:db/id "q-341240/selection/43fac142abf5e36b9626fa58e819073304eb70f96b854bcac71891de8bb351d3" :answer/id #uuid "f59fa017-52f1-5a7a-9648-5eedaaf628f2" :answer/type :answer.type/math :answer/value "-{x}^{3}+x" :db/ensure [:answer/validate]} {:db/id "q-341240/selection/b75a9437d6f4f56a7b0311db66ef21ab333dc13495450fe504ea5259933a1e33" :answer/id #uuid "dab6dac3-20f0-5ee3-a15a-6178ad7fb0aa" :answer/type :answer.type/math :answer/value "|-{x}^{3}+x|" :db/ensure [:answer/validate]} {:db/id "q-341240/selection" :answer-field/id #uuid "5fcb1bfb-fc44-5a07-a562-acee7617b6b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-341240/selection/43fac142abf5e36b9626fa58e819073304eb70f96b854bcac71891de8bb351d3" :answer-field/choices ["q-341240/selection/fa182068396ec0333367b693c2ca97dd144fca75567baeec6a5c9ec30fe7868e" "q-341240/selection/2bf16311d5a5a02dab284220a4ac8d5f1c55cf2799631d44f6418aa9214aae14" "q-341240/selection/4dee2f2ff6de2671969014b152b57be8cd1543a3db4ec8d03954daf66905a734" "q-341240/selection/43fac142abf5e36b9626fa58e819073304eb70f96b854bcac71891de8bb351d3" "q-341240/selection/b75a9437d6f4f56a7b0311db66ef21ab333dc13495450fe504ea5259933a1e33"] :db/ensure [:answer-field/validate]} {:db/id "q-341240" :question/id #uuid "8fa2f0b6-b645-57f3-bffa-8b74f5318044" :question/math-academy-id "q-341240" :question/problem "Let $F(x)={x}^{3}-x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn this case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{3}-(-x) \\\\  & =-{x}^{3}+x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341240/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a32afd19-5779-56f0-ad6d-1d6b541899f8"] :knowledge-point/questions ["q-341240"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341251/field-1/b6ce29bdf8ec3d217e5f3ea98c2f9012ae01aa6acb5deaf1021dccf39e1dd263" :answer/id #uuid "1550ff51-2576-5191-a575-99a05d0b6c2f" :answer/type :answer.type/math :answer/value "5e^4" :db/ensure [:answer/validate]} {:db/id "q-341251/field-1" :answer-field/id #uuid "3acf4f31-0516-52d2-b4ba-475e5f46760c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341251/field-1/b6ce29bdf8ec3d217e5f3ea98c2f9012ae01aa6acb5deaf1021dccf39e1dd263" :answer-field/choices ["q-341251/field-1/b6ce29bdf8ec3d217e5f3ea98c2f9012ae01aa6acb5deaf1021dccf39e1dd263"] :db/ensure [:answer-field/validate]} {:db/id "q-341251" :question/id #uuid "45a412fd-5ad8-5ab2-be4e-40cd61e06f60" :question/math-academy-id "q-341251" :question/problem "Let $F(x)=(2x+1){e}^{2x}$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is the value of $f(-2)?$\n\n$f(-2)=$\n{{field-1}}" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(2(-x)+1){e}^{2(-x)} \\\\  & =(-2x+1){e}^{-2x}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-2) & =(-2(-2)+1){e}^{-2(-2)}=5{e}^{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341251/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a32afd19-5779-56f0-ad6d-1d6b541899f8"] :knowledge-point/questions ["q-341251"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186167223 :question/answer-fields 17592186164903] {:db/id "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/266e99d3569f5205fde62fab3dbf149778dde8f7e3c06bd91ffd2f8638367faf" :answer/id #uuid "9caae9bd-2c49-5f48-a7be-388add7e9b5a" :answer/type :answer.type/math :answer/value "|x{|}^{2}+2|x|" :db/ensure [:answer/validate]} {:db/id "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/cde9da7d4d24b920029325d4c5b295c3f3ba595e2ec57fe7448727d13d37a3fc" :answer/id #uuid "c6c04153-37ed-583e-a766-f15e63d5efe2" :answer/type :answer.type/math :answer/value "-{x}^{2}-2x" :db/ensure [:answer/validate]} {:db/id "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/bc360bd66cb6dafb4982db0e03a803e6968b3ee35808a9faf7a39b97c89b5722" :answer/id #uuid "511d5a2c-171c-591b-88a1-3b9de859c8c2" :answer/type :answer.type/math :answer/value "{x}^{2}+2x" :db/ensure [:answer/validate]} {:db/id "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/3e55e9fddd3a2dfbd642e89651c18276c9c358fb7e191ba608c34262d178a05b" :answer/id #uuid "fac0e189-fd8a-5927-88f1-c638cbaafdd5" :answer/type :answer.type/math :answer/value "-{x}^{2}+2x" :db/ensure [:answer/validate]} {:db/id "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/dbf3171ee029e8ddb91ac58a25a7d22b4a91d7c1e859f947f31b1742f829e813" :answer/id #uuid "0b7961b7-4eb1-590b-a8bf-7edf3da68cf7" :answer/type :answer.type/math :answer/value "|-{x}^{2}+2x|" :db/ensure [:answer/validate]} {:db/id "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768" :answer-field/id #uuid "39ad1ac1-6653-57f9-bb67-54f4ef83bd12" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/bc360bd66cb6dafb4982db0e03a803e6968b3ee35808a9faf7a39b97c89b5722" :answer-field/choices ["q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/266e99d3569f5205fde62fab3dbf149778dde8f7e3c06bd91ffd2f8638367faf" "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/cde9da7d4d24b920029325d4c5b295c3f3ba595e2ec57fe7448727d13d37a3fc" "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/bc360bd66cb6dafb4982db0e03a803e6968b3ee35808a9faf7a39b97c89b5722" "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/3e55e9fddd3a2dfbd642e89651c18276c9c358fb7e191ba608c34262d178a05b" "q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768/dbf3171ee029e8ddb91ac58a25a7d22b4a91d7c1e859f947f31b1742f829e813"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-340794"] :question/problem "Let $F(x)={x}^{2}-2x$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is $f(x)$ for $x\\in (-\\pi ,0)?$" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{2}-2(-x) \\\\  & ={x}^{2}+2x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-340794/selection/ma-v1/e51f72cf9798f6afb8a602f991644011bac612cefa9090c4e14729b2d1e9b768"] :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-340814"] :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=3{x}^{2}+2$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=3{x}^{2}+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(3{x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[{x}^{3}+2x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }({\\pi }^{3}+2\\pi )-0 \\\\  & =2({\\pi }^{2}+2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-340815/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "159e41ba-05c9-57ed-8082-c794ef2adfb9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id 17592186164927 :answer-field/choices ["q-340815/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-340815"] :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{3})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{3})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{3})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[3\\operatorname{cos}⁡(\\frac{x}{3})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(3\\operatorname{cos}⁡(\\frac{\\pi }{3})-3\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(\\frac{3}{2}-3) \\\\  & =-\\frac{3}{\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-341283/field-1/5fe32e1c508f70d8ad5dc20528e3ebf5b9555721424f5f33eddee06ab862df07" :answer/id #uuid "c16995a6-9123-56cc-9c39-7e4dd9712b95" :answer/type :answer.type/math :answer/value "\\frac{4}{\\pi}(\\sqrt{2}-2)" :db/ensure [:answer/validate]} {:db/id "q-341283/field-1" :answer-field/id #uuid "bb0ce0d7-449d-59e8-956f-34f9ed7421c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341283/field-1/5fe32e1c508f70d8ad5dc20528e3ebf5b9555721424f5f33eddee06ab862df07" :answer-field/choices ["q-341283/field-1/5fe32e1c508f70d8ad5dc20528e3ebf5b9555721424f5f33eddee06ab862df07"] :db/ensure [:answer-field/validate]} {:db/id "q-341283" :question/id #uuid "b98e7a19-83c6-5116-a206-cf18bc4eba0d" :question/math-academy-id "q-341283" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{4})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{4})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[4\\operatorname{cos}⁡(\\frac{x}{4})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(4\\operatorname{cos}⁡(\\frac{\\pi }{4})-4\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(4\\cdot \\frac{\\sqrt{2}}{2}-4) \\\\  & =\\frac{4}{\\pi }(\\sqrt{2}-2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341283/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "96ac89a1-4179-5afe-8c1b-ebd9d47bde79"] :knowledge-point/questions ["q-341283"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341285/field-1/6decfafd1cfd76ca412d070d3db23710442b6eb4e46a7438da0d3dbeda075db3" :answer/id #uuid "2e6e99d2-e79d-530f-96f4-168eedcbd583" :answer/type :answer.type/math :answer/value "\\frac{6}{\\pi}(\\sqrt{3}-2)" :db/ensure [:answer/validate]} {:db/id "q-341285/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d293d0d2-fd7f-585e-80a7-161f1d6bd91d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-341285/field-1" :answer-field/id #uuid "93f221f8-a204-567e-a49e-90389dfc1efe" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341285/field-1/6decfafd1cfd76ca412d070d3db23710442b6eb4e46a7438da0d3dbeda075db3" :answer-field/choices ["q-341285/field-1/6decfafd1cfd76ca412d070d3db23710442b6eb4e46a7438da0d3dbeda075db3" "q-341285/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-341285" :question/id #uuid "c50dd619-ff30-5a53-b1c0-0b59df435810" :question/math-academy-id "q-341285" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=-\\operatorname{sin}⁡(\\frac{x}{6})$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-\\operatorname{sin}⁡(\\frac{x}{6})$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }-\\operatorname{sin}⁡(\\frac{x}{6})\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[6\\operatorname{cos}⁡(\\frac{x}{6})]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(6\\operatorname{cos}⁡(\\frac{\\pi }{6})-6\\operatorname{cos}⁡(0)) \\\\  & =\\frac{2}{\\pi }(6\\cdot \\frac{\\sqrt{3}}{2}-6) \\\\  & =\\frac{6(\\sqrt{3}-2)}{\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341285/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "96ac89a1-4179-5afe-8c1b-ebd9d47bde79"] :knowledge-point/questions ["q-341285"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341276/field-1/6289610d8dc406f4f5a0eb0fda950e3248c74e2bf47640664c70d93113819f02" :answer/id #uuid "69311e12-d8a1-5d89-8d6d-fdea5625fb23" :answer/type :answer.type/math :answer/value "\\frac{10\\pi^2}{3}+4" :db/ensure [:answer/validate]} {:db/id "q-341276/field-1" :answer-field/id #uuid "18279a36-95ad-512d-a4fe-442dd9f0abee" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341276/field-1/6289610d8dc406f4f5a0eb0fda950e3248c74e2bf47640664c70d93113819f02" :answer-field/choices ["q-341276/field-1/6289610d8dc406f4f5a0eb0fda950e3248c74e2bf47640664c70d93113819f02"] :db/ensure [:answer-field/validate]} {:db/id "q-341276" :question/id #uuid "48fa455a-c17a-5a1a-bbec-c5380e59e04b" :question/math-academy-id "q-341276" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=5{x}^{2}+2$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{0}.$\n\n${a}_{0}=$ {{field-1}}" :question/worked-solution "For our Fourier cosine series, the constant term is given by\n\n$$\n{a}_{0}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5{x}^{2}+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n\\begin{aligned}{a}_{0} & =\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5{x}^{2}+2)\\,\\text{d}x \\\\  & =\\frac{2}{\\pi }{[\\frac{5{x}^{3}}{3}+2x]}_{0}^{\\pi } \\\\  & =\\frac{2}{\\pi }(\\frac{5{\\pi }^{3}}{3}+2\\pi )-0 \\\\  & =2(\\frac{5{\\pi }^{2}}{3}+2).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341276/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "96ac89a1-4179-5afe-8c1b-ebd9d47bde79"] :knowledge-point/questions ["q-341276"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341269/field-1/9ee6010ecfb8a338382d458666e178b1092e10d374d98883e472d64d59ed31b1" :answer/id #uuid "4f7731a6-b074-5341-b367-eb4f4ff6df64" :answer/type :answer.type/math :answer/value "\\frac{4(1-(-1)^{n})}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341269/field-1/89568c74dbaee4fc5377337ed55e3ef969c478ec13b29371a37dacb5714c5bc1" :answer/id #uuid "db3f01a0-0439-5777-afc9-9514983997b5" :answer/type :answer.type/math :answer/value "\\frac{2(-1)^{n}}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341269/field-1/15e125b495febf20f099d345bf9f51316f7c62893de67c42d6ba6c50d456005c" :answer/id #uuid "766c98b8-c1a3-534b-b9cb-af0f93c308b4" :answer/type :answer.type/math :answer/value "\\frac{2(1-(-1)^{n})}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341269/field-1/074a9b86814523bdb3e3e5a86305f6479fa8d838979b70e237d6af0e284b4b84" :answer/id #uuid "aec43d1e-b788-5251-b141-651412a7be3e" :answer/type :answer.type/math :answer/value "\\frac{4(-1)^{n}}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341269/field-1" :answer-field/id #uuid "1ea0d337-1a83-5a20-86cd-d0e8ff50378e" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-341269/field-1/9ee6010ecfb8a338382d458666e178b1092e10d374d98883e472d64d59ed31b1" :answer-field/choices ["q-341269/field-1/9ee6010ecfb8a338382d458666e178b1092e10d374d98883e472d64d59ed31b1" "q-341269/field-1/89568c74dbaee4fc5377337ed55e3ef969c478ec13b29371a37dacb5714c5bc1" "q-341269/field-1/15e125b495febf20f099d345bf9f51316f7c62893de67c42d6ba6c50d456005c" "q-341269/field-1/074a9b86814523bdb3e3e5a86305f6479fa8d838979b70e237d6af0e284b4b84"] :db/ensure [:answer-field/validate]} {:db/id "q-341269/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" :answer/id #uuid "7eb3c9f7-d44c-5b25-9801-c68dc701d260" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "q-341269/field-2/3a86edc502d0038df0dcd390c378431e5286836bbdd60033424dd2f8510c1df7" :answer/id #uuid "4c2887ee-02a6-5d72-972b-b70d8600218e" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "q-341269/field-2/3f6a3aa25491ef321371576cb221342060d043d2422df9923d1f53fc94cde6cd" :answer/id #uuid "76740c7d-6aef-5f9a-98ab-453559ec7d9d" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "q-341269/field-2/fd0623bef64bcb0a0ce9b59f822de4999c714270edbdc40bbf7ea19c5354d539" :answer/id #uuid "4aaaad89-efec-5b51-b69d-ae1a96209b8e" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "q-341269/field-2" :answer-field/id #uuid "476f726c-4945-5377-9515-8ee23e68d8ed" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-341269/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" :answer-field/choices ["q-341269/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" "q-341269/field-2/3a86edc502d0038df0dcd390c378431e5286836bbdd60033424dd2f8510c1df7" "q-341269/field-2/3f6a3aa25491ef321371576cb221342060d043d2422df9923d1f53fc94cde6cd" "q-341269/field-2/fd0623bef64bcb0a0ce9b59f822de4999c714270edbdc40bbf7ea19c5354d539"] :db/ensure [:answer-field/validate]} {:db/id "q-341269" :question/id #uuid "4db222ac-c7bb-54f6-9ac9-8f6851becd78" :question/math-academy-id "q-341269" :question/problem "Let $F(x)=-2x+5$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(5-\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=-2x+5$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(-2x+5)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=-2x+5\\, & ⇒\\,{u}^{′}=-2 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(-2x+5)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }+\\frac{2}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((-2\\pi +5)\\operatorname{sin}⁡(n\\pi )-5\\operatorname{sin}⁡(0))-\\frac{2}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0-\\frac{2}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{4(1-\\operatorname{cos}⁡(n\\pi ))}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{4(1-(-1)^{n})}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(5-\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{4(1-(-1)^{n})}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341269/field-1" "q-341269/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f1e90af1-3fbd-5aa3-ac32-ac54c27c7224"] :knowledge-point/questions ["q-341269"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341259/field-1/22fe00ad437a442f5a7ca4b1788eb42b81b2eabb7eb0b4b8d33a5e7109e89bd5" :answer/id #uuid "992a1001-628b-5d74-ad00-fcd704cfd3dd" :answer/type :answer.type/math :answer/value "\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341259/field-1/3feedeb65ab693f3bc15023419655633c58a843b47a08624a1e3dda5c6413b4c" :answer/id #uuid "ad14f439-3195-5530-8e59-800c39ca0349" :answer/type :answer.type/math :answer/value "-\\frac{20(1+(-1)^{n})}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341259/field-1/0ab418317306b93269a60d6b74533179159dd41521d757797efe1fd93bdb1f23" :answer/id #uuid "11cc98c6-6295-5393-a3de-78fcda678260" :answer/type :answer.type/math :answer/value "\\frac{20((-1)^{n}-1)}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341259/field-1/b56e8f7b21bf89910f8a44ec09c46a137168eb8ca50cbe9b3152895b34525494" :answer/id #uuid "0b689931-ae56-50a8-b29b-4d9e4d912891" :answer/type :answer.type/math :answer/value "\\frac{20((-1)^{n}-1)}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341259/field-1/6542d5c5c8e480d6082c83878e1472cb4bc14513637dd14b6a5a15adbfea8dd1" :answer/id #uuid "db3ce0e6-bc2c-5748-9079-0378d65a36b4" :answer/type :answer.type/math :answer/value "\\frac{20(1-(-1)^{n})}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341259/field-1" :answer-field/id #uuid "0b9b8f79-d0d6-5632-aea8-e858f26c5e30" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-341259/field-1/0ab418317306b93269a60d6b74533179159dd41521d757797efe1fd93bdb1f23" :answer-field/choices ["q-341259/field-1/22fe00ad437a442f5a7ca4b1788eb42b81b2eabb7eb0b4b8d33a5e7109e89bd5" "q-341259/field-1/3feedeb65ab693f3bc15023419655633c58a843b47a08624a1e3dda5c6413b4c" "q-341259/field-1/0ab418317306b93269a60d6b74533179159dd41521d757797efe1fd93bdb1f23" "q-341259/field-1/b56e8f7b21bf89910f8a44ec09c46a137168eb8ca50cbe9b3152895b34525494" "q-341259/field-1/6542d5c5c8e480d6082c83878e1472cb4bc14513637dd14b6a5a15adbfea8dd1"] :db/ensure [:answer-field/validate]} {:db/id "q-341259" :question/id #uuid "a2b04afa-d57d-5dc2-8054-36c00f74d55f" :question/math-academy-id "q-341259" :question/problem "$$\nf(x)∼\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(nx)\n$$\n\nLet $F(x)=10x$ for $x\\in [0,\\pi ).$ The Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of $F(x)$ is shown above. Find the expression for ${a}_{n}.$$\\,{a}_{n}=$ {{field-1}}\nfor $n\\ge 1$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=10x$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{20}{\\pi }{\\int }_{0}^{\\pi }x\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=x\\, & ⇒\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{20}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{20}{\\pi }(\\frac{1}{n}[x\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{1}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{20}{n\\pi }((\\pi \\cdot \\operatorname{sin}⁡(n\\pi )-0\\cdot \\operatorname{sin}⁡(0))+\\frac{1}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{20}{n\\pi }(0+\\frac{1}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{20(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nFinally, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{20((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341259/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f1e90af1-3fbd-5aa3-ac32-ac54c27c7224"] :knowledge-point/questions ["q-341259"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341265/field-1/22fe00ad437a442f5a7ca4b1788eb42b81b2eabb7eb0b4b8d33a5e7109e89bd5" :answer/id #uuid "569ee114-3ff4-5189-a346-598bfc7dbb79" :answer/type :answer.type/math :answer/value "\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341265/field-1/50efd9ca267d8257ffcdf35a1fdd0d698650ea1b506cf935470a6f8e176372d4" :answer/id #uuid "b2258be3-9503-5e6d-a82a-e8311e9f3d80" :answer/type :answer.type/math :answer/value "\\frac{10(-1)^{n}}{\\pi {n}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-341265/field-1/fc8c04950532c3fe60caac020b4588b84c09c81fc75467af6a241cefaeed1187" :answer/id #uuid "23cd940d-a462-574e-9c5d-2384ddb31aff" :answer/type :answer.type/math :answer/value "\\frac{5(1-(-1)^{n})}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341265/field-1/632dd6aafe6e7139a473ea75e20dc370d97faea7d993faca17c4277a25a39f1f" :answer/id #uuid "97046c78-10c7-5ea0-9dad-971c536953a6" :answer/type :answer.type/math :answer/value "\\frac{5(-1)^{n}}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341265/field-1" :answer-field/id #uuid "5206d921-9c01-5156-ba6b-1512de241e2f" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-341265/field-1/22fe00ad437a442f5a7ca4b1788eb42b81b2eabb7eb0b4b8d33a5e7109e89bd5" :answer-field/choices ["q-341265/field-1/22fe00ad437a442f5a7ca4b1788eb42b81b2eabb7eb0b4b8d33a5e7109e89bd5" "q-341265/field-1/50efd9ca267d8257ffcdf35a1fdd0d698650ea1b506cf935470a6f8e176372d4" "q-341265/field-1/fc8c04950532c3fe60caac020b4588b84c09c81fc75467af6a241cefaeed1187" "q-341265/field-1/632dd6aafe6e7139a473ea75e20dc370d97faea7d993faca17c4277a25a39f1f"] :db/ensure [:answer-field/validate]} {:db/id "q-341265/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" :answer/id #uuid "78578f24-b585-570f-aa8d-8c70205a7c81" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "q-341265/field-2/3f6a3aa25491ef321371576cb221342060d043d2422df9923d1f53fc94cde6cd" :answer/id #uuid "26a012c5-b9e6-59ee-b119-5e320e4c57c9" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "q-341265/field-2/3a86edc502d0038df0dcd390c378431e5286836bbdd60033424dd2f8510c1df7" :answer/id #uuid "f37a0aae-8786-5218-a5a4-6ceb25fd3a80" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡(nx)" :db/ensure [:answer/validate]} {:db/id "q-341265/field-2/fd0623bef64bcb0a0ce9b59f822de4999c714270edbdc40bbf7ea19c5354d539" :answer/id #uuid "ed224253-32af-5dac-bd5f-6c132b0dbab0" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡(\\pi x)" :db/ensure [:answer/validate]} {:db/id "q-341265/field-2" :answer-field/id #uuid "ee333deb-1663-5dfe-9276-2f03046ee524" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-341265/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" :answer-field/choices ["q-341265/field-2/454707892878cf2dd9571a67e15af8dfb75023edf431627663fe6dd748702707" "q-341265/field-2/3f6a3aa25491ef321371576cb221342060d043d2422df9923d1f53fc94cde6cd" "q-341265/field-2/3a86edc502d0038df0dcd390c378431e5286836bbdd60033424dd2f8510c1df7" "q-341265/field-2/fd0623bef64bcb0a0ce9b59f822de4999c714270edbdc40bbf7ea19c5354d539"] :db/ensure [:answer-field/validate]} {:db/id "q-341265" :question/id #uuid "3a6c8b4c-d663-5855-bad2-c5ea86bef0a8" :question/math-academy-id "q-341265" :question/problem "Let $F(x)=5x+2$ for $x\\in [0,\\pi ).$ Select the correct missing parts in the Fourier cosine series of the **even** $2\\pi $-periodic extension $f(x)$ of the function $F(x)$ below.\n\n$$\nf(x)∼(2+\\frac{5}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\,{{field-1}}\\cdot {{field-2}}\n$$" :question/worked-solution "For our Fourier cosine series, the coefficients are given by\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }f(x)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=5x+2$ for $x\\in (0,\\pi ).$ So, substituting into the formula, we get\n\n$$\n{a}_{n}=\\frac{2}{\\pi }{\\int }_{0}^{\\pi }(5x+2)\\operatorname{cos}⁡(nx)\\,\\text{d}x.\n$$\n\nWe use the integration by parts: \n\n$$\n\\begin{aligned}u=5x+2\\, & ⇒\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{cos}⁡(nx)\\, & ⇒\\,v=\\frac{1}{n}\\operatorname{sin}⁡(nx)\\end{aligned}\n$$\n\nThus, we obtain\n\n$$\n\\begin{aligned}{a}_{n} & =\\frac{2}{\\pi }(uv\\,{|}_{0}^{\\pi }-{\\int }_{0}^{\\pi }v{u}^{′}\\,\\text{d}x) \\\\  & =\\frac{2}{\\pi }(\\frac{1}{n}[(5x+2)\\operatorname{sin}⁡(nx)]_{0}^{\\pi }-\\frac{5}{n}{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(nx)\\,\\text{d}x) \\\\  & =\\frac{2}{n\\pi }(((5\\pi +2)\\operatorname{sin}⁡(n\\pi )-2\\operatorname{sin}⁡(0))+\\frac{5}{n}[\\operatorname{cos}⁡(nx)]_{0}^{\\pi }) \\\\  & =\\frac{2}{n\\pi }(0+\\frac{5}{n}(\\operatorname{cos}⁡(n\\pi )-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{10(\\operatorname{cos}⁡(n\\pi )-1)}{{n}^{2}\\pi }.\\end{aligned}\n$$\n\nTherefore, since $\\operatorname{cos}⁡(n\\pi )=(-1)^{n},$ we have\n\n$$\n{a}_{n}=\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}.\n$$\n\nFinally, the Fourier cosine series is\n\n$$\nf(x)∼(2+\\frac{5}{2}\\pi )+{\\sum }_{n=1}^{\\infty }\\frac{10((-1)^{n}-1)}{\\pi {n}^{2}}\\cdot \\operatorname{cos}⁡(nx).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341265/field-1" "q-341265/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f1e90af1-3fbd-5aa3-ac32-ac54c27c7224"] :knowledge-point/questions ["q-341265"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341267/field-1/663d534c15851a130874ec021a253cffad4103b1506a5961fc9149ec79e04ad8" :answer/id #uuid "f6004338-463b-588d-967d-295d822a44c7" :answer/type :answer.type/math :answer/value "\\frac{3(1-(-1)^{n})}{\\pi n}" :db/ensure [:answer/validate]} {:db/id "q-341267/field-1/c68a61e134a9f8f4626fd622217a5627843fcb3c79562131910690ab6fc6099b" :answer/id #uuid "3add20d7-d24a-56e9-9292-a3e232fe084f" :answe