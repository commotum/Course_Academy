[{:db/id "q-341255/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "260bdf96-c603-5409-b119-c346fb118d97" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-341255/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "818acf01-a016-5ead-adab-9399400e0bfd" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-341255/field-1" :answer-field/id #uuid "c233d74d-d8e9-5b86-a325-3b8d6847524f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-341255/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer-field/choices ["q-341255/field-1/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" "q-341255/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-341255" :question/id #uuid "28d117cf-c663-562b-8f71-9a6082166c76" :question/math-academy-id "q-341255" :question/problem "Let $F(x)={x}^{2}+2x+3$ for $x\\in [0,\\pi ),$ and let $f(x)$ be the **even** extension of $F(x)$ to $x\\in (-\\pi ,\\pi ).$ What is the value of $f(-3)?$\n\n$f(-3)=$\n{{field-1}}" :question/worked-solution "If $F(x)$ is defined on $x\\in [0,\\pi ),$ the even extension of $F$ is the function $f$ such that\n\n$$\nf(x)={\\begin{aligned}F(x), & x\\in [0,\\pi ), \\\\ F(-x), & x\\in (-\\pi ,0).\\end{aligned}\n$$\n\nIn our case, for $x\\in (-\\pi ,0),$ we get\n\n$$\n\\begin{aligned}f(x) & =F(-x) \\\\  & =(-x)^{2}+2(-x)+3 \\\\  & ={x}^{2}-2x+3.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(-3) & =(-3)^{2}-2(-3)+3=18.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-341255/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a32afd19-5779-56f0-ad6d-1d6b541899f8"] :knowledge-point/questions ["q-341255"] :db/ensure [: