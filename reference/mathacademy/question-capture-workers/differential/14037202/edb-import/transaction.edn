d #uuid "2ff26ed9-98e4-544a-bd82-0fb2c3e9ba4e" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339647/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-339647/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-339647/field-5/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "b1a2a2ed-bcfd-51dc-bb53-e585c16e41d0" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-339647/field-5" :answer-field/id #uuid "0be1f4b5-ddba-5a0b-aa1f-aac77a83f642" :answer-field/key "field-5" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339647/field-5/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-339647/field-5/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-339647/field-6/8a55a1e763e7d118b438f4c707fb4ff57c1696229fbfb038a8c1619ee8ba7e38" :answer/id #uuid "f795b7a2-713b-5bfc-ad0f-628068d5d7c6" :answer/type :answer.type/math :answer/value "e^t" :db/ensure [:answer/validate]} {:db/id "q-339647/field-6" :answer-field/id #uuid "77829eb5-dca1-5d67-ba88-3da182cca1fe" :answer-field/key "field-6" :answer-field/type :answer-field.type/blank :answer-field/correct "q-339647/field-6/8a55a1e763e7d118b438f4c707fb4ff57c1696229fbfb038a8c1619ee8ba7e38" :answer-field/choices ["q-339647/field-6/8a55a1e763e7d118b438f4c707fb4ff57c1696229fbfb038a8c1619ee8ba7e38"] :db/ensure [:answer-field/validate]} {:db/id "q-339647" :question/id #uuid "dfc4f1b6-d6f2-5783-8ca1-666226e37ccf" :question/math-academy-id "q-339647" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)+{x}_{1}(t)-3{x}_{2}(t)=0 \\\\ {x}_{2}^{′}(t)+{x}_{2}(t)={e}^{t}\\end{aligned}\n$$\n\nThe system of linear ODEs above can be written in matrix form as follows:\n\n| ${x}^{′}(t)=\\,\\,$ |  | {{field-1}} | {{field-2}} |  | $\\,\\,x(t)+\\,\\,$ |  | {{field-3}} |  |  |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-4}} | {{field-5}} |  |  | {{field-6}} |  |  |  |  |" :question/worked-solution "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t)=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t)\\end{aligned}\n$$\n\nwhere\n\n- $a(t),$ $b(t),$ $c(t),$ $d(t),$ $f(t),$ and $g(t)$ are known functions, and\n\n- ${x}_{1}(t)$ and ${x}_{2}(t)$ are unknown functions (dependent variables).\n\nSuch a system can always be written in the form\n\n$$\n{x}^{′}(t)=Ax(t)+f(t)\n$$\n\nwhere\n\n$$\nx(t)=[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\\,A=[\\begin{aligned}a(t) & b(t) \\\\ c(t) & d(t)\\end{aligned}],\\,f(t)=[\\begin{aligned}f(t) \\\\ g(t)\\end{aligned}].\n$$\n\nWe have the following system.\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)+{x}_{1}(t)-3{x}_{2}(t)=0 \\\\ {x}_{2}^{′}(t)+{x}_{2}(t)={e}^{t}\\end{aligned}\n$$\n\nWriting our system in standard form, we get the following:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{2}(t)+{e}^{t}\\end{aligned}\n$$\n\nSo, we can rewrite our system in matrix form as follows:\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & 3 \\\\ 0 & -1\\end{aligned}]x(t)+[\\begin{aligned}0 \\\\ {e}^{t}\\end{aligned}]\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339647/field-1" "q-339647/field-2" "q-339647/field-3" "q-339647/field-4" "q-339647/field-5" "q-339647/field-6"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6dfdbdba-247c-5ddd-bb6e-5d9637140264"] :knowledge-point/questions ["q-339647"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339648/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/