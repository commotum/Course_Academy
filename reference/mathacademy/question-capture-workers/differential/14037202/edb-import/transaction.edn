2f99b70378aa1f23"] :db/ensure [:answer-field/validate]} {:db/id "q-339543" :question/id #uuid "d5fa7289-515e-5427-9dab-7c7608567336" :question/math-academy-id "q-339543" :question/problem "Which of the following are first-order linear systems of ODEs?\n\n- ${\\begin{aligned}{x}_{1}^{′}(t)=\\operatorname{cos}⁡(t)\\,{x}_{1}(t)+2 \\\\ {x}_{2}^{′}(t)={x}_{1}(t)-{x}_{2}(t)\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)=t\\,{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{2}(t)+t\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}^{2}(t)+1 \\\\ {x}_{2}^{′}(t)={x}_{2}(t)\\end{aligned}$" :question/worked-solution "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t)=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t)\\end{aligned}\n$$\n\nwhere\n\n- $a(t),$ $b(t),$ $c(t),$ $d(t),$ $f(t),$ and $g(t)$ are known functions, and\n\n- ${x}_{1}(t)$ and ${x}_{2}(t)$ are unknown functions (dependent variables).\n\nWith this in mind, let's inspect each system:\n\n- System I is a first-order linear system of ODEs since it can be written in the standard form, where\n\n$$\n\\begin{aligned}a(t)=\\operatorname{cos}⁡(t), &  & b(t)=0, &  & f(t)=2, \\\\ c(t)=1, &  & d(t)=-1, &  & g(t)=0.\\end{aligned}\n$$\n\n- System II is a first-order linear system of ODEs since it can be written in the standard form, where\n\n$$\n\\begin{aligned}a(t)=t, &  & b(t)=-1, &  & f(t)=0, \\\\ c(t)=0, &  & d(t)=1, &  & g(t)=t.\\end{aligned}\n$$\n\n- System III is not a first-order linear system of ODEs since it contains the term ${x}_{1}^{2}(t).$\n\nTherefore, the correct answer is \"I and II only\"." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-339543/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66d19e98-522f-5db2-b340-0f35ba2ece23"] :knowledge-point/questions ["q-339543"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339548/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "217a4d1e-1bc2-5b3a-9f98-76c6d28bdd70" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-339548/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "26b666a3-32d8-5b11-acdc-aa7c9ad0b737" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-339548/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c119089c-5120-5ba9-9465-96d1ab95deb8" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-339548/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "0052f7df-558e-58af-849f-2403d1a36883" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-339548/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "cf224bf6-6074-5d27-956e-d61e8778fe69" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-339548/selection" :answer-field/id #uuid "d7f1974f-da62-522b-a724-c389f83b8990" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-339548/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-339548/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-339548/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-339548/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-339548/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-339548/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-339548" :question/id #uuid "a764ff31-647c-594b-9d8e-d5b386f46657" :question/math-academy-id "q-339548" :question/problem "Which of the following are first-order linear systems of ODEs?\n\n- ${\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t){x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+{x}_{2}(t)\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=4{x}_{1}^{2}(t)\\end{aligned}$\n- ${\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)-8{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+(\\operatorname{ln}⁡(5))^{2}{x}_{2}(t)\\end{aligned}$" :question/worked-solution "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t)=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t)\\end{aligned}\n$$\n\nwhere\n\n- $a(t),$ $b(t),$ $c(t),$ $d(t),$ $f(t),$ and $g(t)$ are known functions, and\n\n- ${x}_{1}(t)$ and ${x}_{2}(t)$ are unknown functions (dependent variables).\n\nWith this in mind, let's inspect each system:\n\n- System I is not a first-order linear system of ODEs since it contains the term ${x}_{1}(t){x}_{2}(t).$\n\n- System II is not a first-order linear system of ODEs since it contains the term ${x}_{1}^{2}(t).$\n\n- System III is a first-order linear system of ODEs since it can be written in the standard form, where\n\n$$\n\\begin{aligned}a(t)=3, &  & b(t)=-8, &  & f(t)=0, \\\\ c(t)=1, &  & d(t)=(\\operatorname{ln}⁡5)^{2}, &  & g(t)=0.\\end{aligned}\n$$\n\nTherefore, the correct answer is \"III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-339548/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "66d19e98-522f-5db2-b340-0f35ba2ece23"] :knowledge-point/questions ["q-339548"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339539/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :a