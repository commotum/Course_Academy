d}] \\\\ [\\begin{aligned}0 \\\\ 0\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}0 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}0 \\\\ 0\\end{aligned}] & \\ne [\\begin{aligned}0 \\\\ 20\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nNow, for ${x}_{2}(t)$, we get\n\n$$\n\\begin{aligned}[\\begin{aligned}{({e}^{5t})}^{′} \\\\ {({e}^{4t})}^{′}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}{e}^{5t} \\\\ {e}^{4t}\\end{aligned}] \\\\ [\\begin{aligned}5{e}^{5t} \\\\ 4{e}^{4t}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}{e}^{5t} \\\\ {e}^{4t}\\end{aligned}] \\\\ [\\begin{aligned}5{e}^{5t} \\\\ 4{e}^{4t}\\end{aligned}] & =[\\begin{aligned}5{e}^{5t} \\\\ 4{e}^{4t}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nFinally, for ${x}_{3}(t)$, we obtain \n\n$$\n\\begin{aligned}[\\begin{aligned}{({t}^{2})}^{′} \\\\ {(t-4)}^{′}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}{t}^{2} \\\\ t-4\\end{aligned}] \\\\ [\\begin{aligned}2t \\\\ 1\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & 4\\end{aligned}][\\begin{aligned}{t}^{2} \\\\ t-4\\end{aligned}] \\\\ [\\begin{aligned}2t \\\\ 1\\end{aligned}] & \\ne [\\begin{aligned}5{t}^{2} \\\\ 4t-16\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nTherefore, we conclude that the correct answer is \"${x}_{2}(t)$ only\"." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/state.json" "file_sha256" "3692dc8c27171e38a5aeee563b18dab9e64a5dab13547a09267fe8c91df3ac97"} {"question" "q-339353" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/activity-metadata.json" "file_sha256" "c7302b1441d4244cdbaf9460cd6041a68c291e99088dd51245ac0d76f5f0d0c0"} {"question" "q-339353" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/state.json" "file_sha256" "3692dc8c27171e38a5aeee563b18dab9e64a5dab13547a09267fe8c91df3ac97"} {"question" "q-339353" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "${x}_{1}(t)$ and ${x}_{2}(t)$ only"] ["text" "${x}_{1}(t)$ and ${x}_{3}(t)$ only"] ["text" "${x}_{1}(t)$ only"] ["text" "${x}_{2}(t)$ only"] ["text" "None"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/state.json" "file_sha256" "3692dc8c27171e38a5aeee563b18dab9e64a5dab13547a09267fe8c91df3ac97"} {"question" "q-339353" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "${x}_{2}(t)$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/state.json" "file_sha256" "3692dc8c27171e38a5aeee563b18dab9e64a5dab13547a09267fe8c91df3ac97"} {"question" "e-21818" "field" nil "attribute" "question/problem" "value" "Which of the following systems of differential equations are linear?\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=\\frac{1}{2}{x}_{1}^{2}(t)+5{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=\\sqrt{5}{x}_{1}(t)+3\\operatorname{sin}⁡({x}_{2}(t))\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21818.json" "file_sha256" "1d16d7a5d5b348100536f8fa4925493413b341a38607898126e5478dbc93599e"} {"question" "e-21818" "field" nil "attribute" "question/worked-solution" "value" "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t)=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t)\\end{aligned}\n$$\n\nwhere\n\n- $a(t),$ $b(t),$ $c(t),$ $d(t),$ $f(t),$ and $g(t)$ are known functions, and\n\n- $x_1(t)$ and $x_2(t)$ are unknown functions (dependent variables).\n\nWith this in mind, let's inspect each system:\n\n- System I is not a first-order linear system of ODEs since it contains the terms $x_1^2(t)$ and $\\sin(x_2(t)).$\n\n- System II is a first-order linear system of ODEs since it can be written in the standard form, where\n\n$$\n\\begin{aligned}a(t)=8t, &  & b(t)=-1, &  & f(t)=1, \\\\ c(t)=6, &  & d(t)=-2, &  & g(t)={t}^{2}.\\end{aligned}\n$$\n\nTherefore, only the second system is linear." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21818.json" "file_sha256" "1d16d7a5d5b348100536f8fa4925493413b341a38607898126e5478dbc93599e"} {"question" "e-21820" "field" nil "attribute" "question/problem" "value" "If the following system of differential equations is written in the form $\\mathbf{x}'(t)=A\\mathbf{x}(t),$ then what is the matrix $A?$\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)+3{x}_{1}(t)-4{x}_{2}(t)=0 \\\\ {x}_{2}^{′}(t)-\\sqrt{2}{x}_{1}(t)+2{x}_{2}(t)=0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21820.json" "file_sha256" "af40f6ff91d3836ae115a881b58d29b4f17266821d800d6908edffdc256502c9"} {"question" "e-21820" "field" nil "attribute" "question/worked-solution" "value" "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t)=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t)\\end{aligned}\n$$\n\nwhere\n\n- $a(t),$ $b(t),$ $c(t),$ $d(t),$ $f(t),$ and $g(t)$ are known functions, and\n\n- $x_1(t)$ and $x_2(t)$ are unknown functions (dependent variables). \nSuch a system can always be written in the form\n\n$$\n\\mathbf x'(t) = A\\mathbf x(t) + \\mathbf f(t)\n$$\n\nwhere\n\n$$\n[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]\n$$\n\nWe have the following system.\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)+3{x}_{1}(t)-4{x}_{2}(t)=0 \\\\ {x}_{2}^{′}(t)-\\sqrt{2}{x}_{1}(t)+2{x}_{2}(t)=0\\end{aligned}\n$$\n\nWriting our system in standard form, we get the following:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-3{x}_{1}(t)+4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=\\sqrt{2}{x}_{1}(t)-2{x}_{2}(t).\\end{aligned}\n$$\n\nSo, we can rewrite our system in matrix form as follows:\n\n$$\n[\\begin{aligned}-3 & 4 \\\\ \\sqrt{2} & -2\\end{aligned}]\n$$\n\nTherefore, we have\n\n$$\n[\\begin{aligned}-3 & 4 \\\\ \\sqrt{2} & -2\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21820.json" "file_sha256" "af40f6ff91d3836ae115a881b58d29b4f17266821d800d6908edffdc256502c9"} {"question" "e-21821" "field" nil "attribute" "question/problem" "value" "Which of the following systems are homogeneous?\n\n- ${\\begin{aligned}{x}_{1}^{′}(t)=-2{x}_{1}(t)+3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=6{x}_{1}(t)+{x}_{2}(t)\\end{aligned}$\n\n- ${\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+{t}^{3} \\\\ {x}_{2}^{′}(t)=-{x}_{2}(t)+1\\end{aligned}$\n\n- ${\\begin{aligned}{x}_{1}^{′}(t)=5{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-2{x}_{1}(t)+4{x}_{2}(t)\\end{aligned}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21821.json" "file_sha256" "793be2f7042d7b8f76d1105af02631b670ad80462343d82a9ddb4d89f8a84c06"} {"question" "e-21821" "field" nil "attribute" "question/worked-solution" "value" "Recall that a first-order linear system of differential equations with two dependent variables is a system of the form\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=a(t){x}_{1}(t)+b(t){x}_{2}(t)+f(t) \\\\ {x}_{2}^{′}(t)=c(t){x}_{1}(t)+d(t){x}_{2}(t)+g(t).\\end{aligned}\n$$\n\nIf $f \\equiv 0$ and $g \\equiv 0$ (i.e., both $f$ and $g$ are zero functions), then the system is *homogeneous*. Otherwise, if at least one of $f$ or $g$ is not identically zero, the system is *inhomogeneous*.\n\nWith this in mind, let's inspect each system:\n\n- System I is homogeneous since it can be written in the standard form with $f \\equiv 0$ and $g \\equiv 0{:}$\n\n$$\n\\begin{aligned}a(t)=-2, &  & b(t)=3, &  & f(t)=0 \\\\ c(t)=6, &  & d(t)=1, &  & g(t)=0\\end{aligned}\n$$\n\n- System II is inhomogeneous since it can be written in the standard form with $f \\not\\equiv 0$ and $g \\not\\equiv 0{:}$\n\n$$\n\\begin{aligned}a(t)=1, &  & b(t)=0, &  & f(t)={t}^{3} \\\\ c(t)=0, &  & d(t)=-1, &  & g(t)=1\\end{aligned}\n$$\n\n- System III is homogeneous since it can be written in the standard form with $f \\equiv 0$ and $g \\equiv 0{:}$\n\n$$\n\\begin{aligned}a(t)=5, &  & b(t)=-1, &  & f(t)=0 \\\\ c(t)=-2, &  & d(t)=4, &  & g(t)=0\\end{aligned}\n$$\n\nTherefore, only the first and third systems are homogeneous." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21821.json" "file_sha256" "793be2f7042d7b8f76d1105af02631b670ad80462343d82a9ddb4d89f8a84c06"} {"question" "e-21819" "field" nil "attribute" "question/problem" "value" "Consider the matrix differential equation $[\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}]$ Which of the following vectors are solutions to this equation?\n\n$$\n[\\begin{aligned}3{e}^{5t} \\\\ 5{e}^{-3t}\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21819.json" "file_sha256" "f5a8e848126ab701a98ecb2492b27073c61c2fd7b0cac4a533a6eaaa8b107e13"} {"question" "e-21819" "field" nil "attribute" "question/worked-solution" "value" "Here, we need to substitute each vector into the given matrix differential equation and check if it results in a true statement.\n\nFor $\\mathbf{x}_1(t),$ we have\n\n$$\n\\begin{aligned}[\\begin{aligned}{(3{e}^{5t})}^{′} \\\\ {(5{e}^{-3t})}^{′}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}][\\begin{aligned}3{e}^{5t} \\\\ 5{e}^{-3t}\\end{aligned}] \\\\ [\\begin{aligned}15{e}^{5t} \\\\ -15{e}^{-3t}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}][\\begin{aligned}3{e}^{5t} \\\\ 5{e}^{-3t}\\end{aligned}] \\\\ [\\begin{aligned}15{e}^{5t} \\\\ -15{e}^{-3t}\\end{aligned}] & =[\\begin{aligned}15{e}^{5t} \\\\ -15{e}^{-3t}\\end{aligned}].\\,✓\\end{aligned}\n$$\n\nNow, for $\\mathbf{x}_2(t),$ we get\n\n$$\n\\begin{aligned}[\\begin{aligned}{(t+5)}^{′} \\\\ {({t}^{2}-3)}^{′}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}][\\begin{aligned}t+5 \\\\ {t}^{2}-3\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ 2t\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}][\\begin{aligned}t+5 \\\\ {t}^{2}-3\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ 2t\\end{aligned}] & \\ne [\\begin{aligned}5t+25 \\\\ -3{t}^{2}+9\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nFinally, for $\\mathbf{x}_3(t),$ we obtain \n\n$$\n\\begin{aligned}[\\begin{aligned}{(5{e}^{t})}^{′} \\\\ {(-3{e}^{t})}^{′}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}][\\begin{aligned}5{e}^{t} \\\\ -3{e}^{t}\\end{aligned}] \\\\ [\\begin{aligned}5{e}^{t} \\\\ -3{e}^{t}\\end{aligned}] & =[\\begin{aligned}5 & 0 \\\\ 0 & -3\\end{aligned}][\\begin{aligned}5{e}^{t} \\\\ -3{e}^{t}\\end{aligned}] \\\\ [\\begin{aligned}5{e}^{t} \\\\ -3{e}^{t}\\end{aligned}] & =[\\begin{aligned}25{e}^{t} \\\\ 9{e}^{t}\\end{aligned}].\\,\\times \\end{aligned}\n$$\n\nTherefore, we conclude that the correct answer is \"$\\mathbf{x}_1(t)$ only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037202/example-21819.json" "file_sha256" "f5a8e848126ab701a98ecb2492b27073c61c2fd7b0cac4a533a6eaaa8b107e13"}] "usage" {"e-21818" [] "e-21820" [] "e-21819" [] "q-339353" [] "e-21821" []} "basis" 1384 "retractions" [[17592186129524 :question/problem "Consider the matrix differential equation $x^{′}(t) = \\begin{bmatrix}5 & 0 \\\\ 0 & 4\\end{bmatrix}x(t)$. Which of the following vectors are solutions to this equation?\n\n$x_{1}(t) = \\begin{bmatrix}0 \\\\ 5\\end{bmatrix}, x_{2}(t) = \\begin{bmatrix}e^{5t} \\\\ e^{4t}\\end{bmatrix}, x_{3}(t) = \\begin{bmatrix}t^{2} \\\\ t - 4\\end{bmatrix}$"] [17592186128825 :question/problem "Which of the following systems of differential equations are linear?\n\n${x_{1}^{′}(t) = \\frac{1}{2}x_{1}^{2}(t) + 5x_{2}(t); x_{2}^{′}(t) = \\sqrt{5}x_{1}(t) + 3\\sin (x_{2}(t))$"] [17592186128825 :question/worked-solution "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{x_{1}^{′}(t) = a(t)x_{1}(t) + b(t)x_{2}(t) + f(t); x_{2}^{′}(t) = c(t)x_{1}(t) + d(t)x_{2}(t) + g(t)\n$$\n\nwhere\n\n- $a(t)$, $b(t)$, $c(t)$, $d(t)$, $f(t)$, and $g(t)$ are known functions, and\n- $x_1(t)$ and $x_2(t)$ are unknown functions (dependent variables).\n\nWith this in mind, let's inspect each system:\n\n- System I is not a first-order linear system of ODEs since it contains the terms $x_1^2(t)$ and $\\sin(x_2(t))$.\n- System II is a first-order linear system of ODEs since it can be written in the standard form, where\n$\\begin{bmatrix}a(t) = 8t, & b(t) =-1, & f(t) = 1, \\\\ c(t) = 6, & d(t) =-2, & g(t) = t^{2}\\end{bmatrix}$.\n\nTherefore, only the second system is linear."] [17592186128828 :question/problem "If the following system of differential equations is written in the form $\\mathbf{x}'(t)=A\\mathbf{x}(t)$, then what is the matrix $A$?\n${x_{1}^{′}(t) + 3x_{1}(t) - 4x_{2}(t) = 0; x_{2}^{′}(t) - \\sqrt{2}x_{1}(t) + 2x_{2}(t) = 0$"] [17592186128828 :question/worked-solution "A first-order linear system of differential equations with two dependent variables is a system of equations that takes the following standard form:\n\n$$\n{x_{1}^{′}(t) = a(t)x_{1}(t) + b(t)x_{2}(t) + f(t); x_{2}^{′}(t) = c(t)x_{1}(t) + d(t)x_{2}(t) + g(t)\n$$\n\nwhere\n\n- $a(t)$, $b(t)$, $c(t)$, $d(t)$, $f(t)$, and $g(t)$ are known functions, and\n- $x_1(t)$ and $x_2(t)$ are unknown functions (dependent variables).\nSuch a system can always be written in the form\n$\\mathbf x'(t) = A\\mathbf x(t) + \\mathbf f(t)$\n\nwhere\n$\\begin{bmatrix}x_{1}(t) \\\\ x_{2}(t)\\end{bmatrix}$\n\nWe have the following system.\n\n$$\n{x_{1}^{′}(t) + 3x_{1}(t) - 4x_{2}(t) = 0; x_{2}^{′}(t) - \\sqrt{2}x_{1}(t) + 2x_{2}(t) = 0\n$$\n\nWriting our system in standard form, we get the following:\n\n$$\n{x_{1}^{′}(t) =-3x_{1}(t) + 4x_{2}(t); x_{2}^{′}(t) = \\sqrt{2}x_{1}(t) - 2x_{2}(t)\n$$\n\nSo, we can rewrite our system in matrix form as follows:\n\n$$\n\\begin{bmatrix}-3 & 4 \\\\ \\sqrt{2} & -2\\end{bmatrix}\n$$\n\nTherefore, we have\n$\\begin{bmatrix}-3 & 4 \\\\ \\sqrt{2} & -2\\end{bmatrix}$"] [17592186128829 :question/problem "Which of the following systems are homogeneous?\n\n1. ${x_{1}^{′}(t) =-2x_{1}(t) + 3x_{2}(t); x_{2}^{′}(t) = 6x_{1}(t) + x_{2}(t)$\n2. ${x_{1}^{′}(t) = x_{1}(t) + t^{3}; x_{2}^{′}(t) =-x_{2}(t) + 1$\n3. ${x_{1}^{′}(t) = 5x_{1}(t) - x_{2}(t); x_{2}^{′}(t) =-2x_{1}(t) + 4x_{2}(t)$"] [17592186128829 :question/worked-solution "Recall that a first-order linear system of differential equations with two dependent variables is a system of the form\n\n$$\n{x_{1}^{′}(t) = a(t)x_{1}(t) + b(t)x_{2}(t) + f(t); x_{2}^{′}(t) = c(t)x_{1}(t) + d(t)x_{2}(t) + g(t)\n$$\n\nIf $f \\equiv 0$ and $g \\equiv 0$ (i.e., both $f$ and $g$ are zero functions), then the system is *homogeneous*. Otherwise, if at least one of $f$ or $g$ is not identically zero, the system is *inhomogeneous*.\n\nWith this in mind, let's inspect each system:\n\n- System I is homogeneous since it can be written in the standard form with $f \\equiv 0$ and $g \\equiv 0{:}$\n$\\begin{bmatrix}a(t) =-2, & b(t) = 3, & f(t) = 0 \\\\ c(t) = 6, & d(t) = 1, & g(t) = 0\\end{bmatrix}$\n- System II is inhomogeneous since it can be written in the standard form with $f \\not\\equiv 0$ and $g \\not\\equiv 0{:}$\n$\\begin{bmatrix}a(t) = 1, & b(t) = 0, & f(t) = t^{3} \\\\ c(t) = 0, & d(t) =-1, & g(t) = 1\\end{bmatrix}$\n- System III is homogeneous since it can be written in the standard form with $f \\equiv 0$ and $g \\equiv 0{:}$\n$\\begin{bmatrix}a(t) = 5, & b(t) =-1, & f(t) = 0 \\\\ c(t) =-2, & d(t) = 4, & g(t) = 0\\end{bmatrix}$\n\nTherefore, only the first and third systems are homogeneous."] [17592186128826 :question/problem "Consider the matrix differential equation $\\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}$ Which of the following vectors are solutions to this equation?\n$\\begin{bmatrix}3e^{5t} \\\\ 5e^{-3t}\\end{bmatrix}$"] [17592186128826 :question/worked-solution "Here, we need to substitute each vector into the given matrix differential equation and check if it results in a true statement.\n\nFor $\\mathbf{x}_1(t)$, we have\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}(3e^{5t})^{′} \\\\ (5e^{-3t})^{′}\\end{bmatrix} &= \\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}3e^{5t} \\\\ 5e^{-3t}\\end{bmatrix} \\\\\n\\begin{bmatrix}15e^{5t} \\\\ -15e^{-3t}\\end{bmatrix} &= \\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}3e^{5t} \\\\ 5e^{-3t}\\end{bmatrix} \\\\\n\\begin{bmatrix}15e^{5t} \\\\ -15e^{-3t}\\end{bmatrix} &= \\begin{bmatrix}15e^{5t} \\\\ -15e^{-3t}\\end{bmatrix}.✓\n\\end{aligned}\n$$\n\nNow, for $\\mathbf{x}_2(t)$, we get\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}(t + 5)^{′} \\\\ (t^{2} - 3)^{′}\\end{bmatrix} &= \\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}t + 5 \\\\ t^{2} - 3\\end{bmatrix} \\\\\n\\begin{bmatrix}1 \\\\ 2t\\end{bmatrix} &= \\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}t + 5 \\\\ t^{2} - 3\\end{bmatrix} \\\\\n&= \\begin{bmatrix}1 \\\\ 2t\\end{bmatrix} \\mid \\ne \\begin{bmatrix}5t + 25 \\\\ -3t^{2} + 9\\end{bmatrix}.\\cdot\n\\end{aligned}\n$$\n\nFinally, for $\\mathbf{x}_3(t)$, we obtain\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}(5e^{t})^{′} \\\\ (-3e^{t})^{′}\\end{bmatrix} &= \\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}5e^{t} \\\\ -3e^{t}\\end{bmatrix} \\\\\n\\begin{bmatrix}5e^{t} \\\\ -3e^{t}\\end{bmatrix} &= \\begin{bmatrix}5 & 0 \\\\ 0 & -3\\end{bmatrix}\\begin{bmatrix}5e^{t} \\\\ -3e^{t}\\end{bmatrix} \\\\\n\\begin{bmatrix}5e^{t} \\\\ -3e^{t}\\end{bmatrix} &= \\begin{bmatrix}25e^{t} \\\\ 9e^{t}\\end{bmatrix}.\\cdot\n\\end{aligned}\n$$\n\nTherefore, we conclude that the correct answer is \"$\\mathbf{x}_1(t)$ only.\""]] "immutable_answers" [17592186126939 17592186126940 17592186126941 17592186126942 17592186126943] "immutable_fields" [[17592186126938 :answer-field/correct] [17592186126938 :answer-field/id] [17592186126938 :answer-field/key] [17592186126938 :answer-field/type]] "no_history" []}
