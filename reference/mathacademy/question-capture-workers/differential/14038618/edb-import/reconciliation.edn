Academy/reference/mathacademy/question-capture/13953040/state.json" "file_sha256" "ce6fd9130710f6f82288974366e6ed398a205420c8d0ca28f3d611f8be15c012" "basis" 615 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/edb-import/verification.json"} {"question" "q-351243" "field" nil "attribute" "question/problem" "value" "Express $\\frac{7{x}^{2}-32x+42}{(x-2)^{3}}$ as a sum of partial fractions.\n\n| $\\frac{7{x}^{2}-32x+42}{(x-2)^{3}}\\,=$ | {{field-1}} | $-$ | {{field-2}} | $+$ | {{field-3}} |\n| --- | --- | --- | --- | --- | --- |\n|  | $x-2$ |  | $(x-2)^{2}$ |  | $(x-2)^{3}$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/state.json" "file_sha256" "ce6fd9130710f6f82288974366e6ed398a205420c8d0ca28f3d611f8be15c012" "basis" 615 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/edb-import/verification.json"} {"question" "q-351243" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\frac{7{x}^{2}-32x+42}{(x-2)^{3}}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}}+\\frac{C}{(x-2)^{3}}.\n$$\n\nMultiplying both sides by $(x-2)^{3}$ gives\n\n$$\n7{x}^{2}-32x+42=A(x-2)^{2}+B(x-2)+C.\n$$\n\nLetting $x=2$ gives\n\n$$\n\\begin{aligned}7(2)^{2}-32(2)+42 & =A(2-2)^{2}+B(2-2)+C \\\\ 6 & =C.\\end{aligned}\n$$\n\nLetting $x=3$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}7(3)^{2}-32(3)+42 & =A(3-2)^{2}+B(3-2)+6 \\\\ 9 & =A+B+6 \\\\ B & =3-A.\\,\\,(1)\\end{aligned}\n$$\n\nNow, letting $x=0$ and using our value for $C$ gives\n\n$$\n\\begin{aligned}7(0)^{2}-32(0)+42 & =A(0-2)^{2}+B(0-2)+6 \\\\ 42 & =4A-2B+6 \\\\ 36 & =4A-2B \\\\ B & =2A-18.\\,\\,(2)\\end{aligned}\n$$\n\nFrom $(1)$ and $(2)$ we have\n\n$$\n\\begin{aligned}3-A & =2A-18 \\\\ A & =7.\\end{aligned}\n$$\n\nNow we substitute the value of $A$ into $(1)$ to get the value of $B:$\n\n$$\n\\begin{aligned}B & =3-7 \\\\ B & =-4\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{7{x}^{2}-32x+42}{(x-2)^{3}}=\\frac{7}{x-2}-\\frac{4}{(x-2)^{2}}+\\frac{6}{(x-2)^{3}}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/state.json" "file_sha256" "ce6fd9130710f6f82288974366e6ed398a205420c8d0ca28f3d611f8be15c012" "basis" 615 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/edb-import/verification.json"} {"question" "q-351243" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/activity-metadata.json" "file_sha256" "66b1124bc06eaefc8dee48c0246afb3d6799036270ec7eb9de3f06955de9e220" "basis" 615 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/edb-import/verification.json"} {"question" "q-351243" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/state.json" "file_sha256" "ce6fd9130710f6f82288974366e6ed398a205420c8d0ca28f3d611f8be15c012" "basis" 615 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/edb-import/verification.json"} {"question" "q-351243" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "7"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/state.json" "file_sha256" "ce6fd9130710f6f82288974366e6ed398a205420c8d0ca28f3d611f8be15c012" "basis" 615 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13953040/edb-import/verification.json"} {"question" "q-351243" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field