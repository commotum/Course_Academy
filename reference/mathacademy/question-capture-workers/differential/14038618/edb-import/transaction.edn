-5.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{-22{x}^{2}+60x-26}{(x+1)(2x-4)^{2}}=-\\,\\frac{3}{x+1}-\\,\\frac{5}{2x-4}+\\frac{2}{(2x-4)^{2}}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351226/field-1" "q-351226/field-2" "q-351226/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221"] :knowledge-point/questions ["q-351226"] :db/ensure [:knowledge-point/validate]} {:db/id "q-50049/selection/dc720205cb46627479750b73edfe5637c4409daca101b431ac214dc0bb240c64" :answer/id #uuid "4dc3ae36-41a0-531e-9746-a4778d5d6bf6" :answer/type :answer.type/math :answer/value "-\\frac{81}{256}" :db/ensure [:answer/validate]} {:db/id "q-50049/selection/c4a6ba0d47fc046823bbf98f939c9dcb7e29c3b3bbd80e62d33df0b72724b048" :answer/id #uuid "7a39e424-f3d9-5b23-9578-d191f0817359" :answer/type :answer.type/math :answer/value "-\\frac{32}{75}" :db/ensure [:answer/validate]} {:db/id "q-50049/selection/af18b24d75450bce3ebdbed9d486834af7412c01246881430c1cf144d5148f5b" :answer/id #uuid "792e1816-4a9e-5165-b059-518d4e346989" :answer/type :answer.type/math :answer/value "-\\frac{4}{243}" :db/ensure [:answer/validate]} {:db/id "q-50049/selection/0e5d26aee7836ff8161975dfc52fb9ed863c8193e56ab85db71ace8f452c88e2" :answer/id #uuid "8bd9f88c-9199-5bf8-9eda-6505b34a81bc" :answer/type :answer.type/math :answer/value "\\frac{27}{128}" :db/ensure [:answer/validate]} {:db/id "q-50049/selection/f6e9a73916f890e29052b079163fb088efa1ae97f8e609810caf2cbec33a8ca7" :answer/id #uuid "e3df8f68-d3d6-5a92-8ea8-da48c548aeee" :answer/type :answer.type/math :answer/value "\\frac{9}{125}" :db/ensure [:answer/validate]} {:db/id "q-50049/selection" :answer-field/id #uuid "073a7a07-631e-56b2-b18d-d097c35aba86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-50049/selection/af18b24d75450bce3ebdbed9d486834af7412c01246881430c1cf144d5148f5b" :answer-field/choices ["q-50049/selection/dc720205cb46627479750b73edfe5637c4409daca101b431ac214dc0bb240c64" "q-50049/selection/c4a6ba0d47fc046823bbf98f939c9dcb7e29c3b3bbd80e62d33df0b72724b048" "q-50049/selection/af18b24d75450bce3ebdbed9d486834af7412c01246881430c1cf144d5148f5b" "q-50049/selection/0e5d26aee7836ff8161975dfc52fb9ed863c8193e56ab85db71ace8f452c88e2" "q-50049/selection/f6e9a73916f890e29052b079163fb088efa1ae97f8e609810caf2cbec33a8ca7"] :db/ensure [:answer-field/validate]} {:db/id "q-50049" :question/id #uuid "1aa906b5-19d1-55c9-9d92-d3d153220818" :question/math-academy-id "q-50049" :question/problem "Given that \n\n$$\n\\frac{x+2}{{x}^{2}(2x+3)}=\\frac{A}{x}+\\frac{B}{{x}^{2}}+\\frac{C}{2x+3},\n$$\n\nwhere $A$, $B$, and $C$ are real constants, determine the value of $A\\cdot B\\cdot C.$" :question/worked-solution "Multiplying both sides of the given equality by ${x}^{2}(2x+3)$ gives\n\n$$\n\\begin{aligned}x+2 & =Ax(2x+3)+B(2x+3)+C{x}^{2}.\\end{aligned}\n$$\n\nLetting $x=0$  gives\n\n$$\n\\begin{aligned}0+2 & =A(0)(2(0)+3)+B(2(0)+3)+C(0)^{2} \\\\ 2 & =3B \\\\ B & =\\frac{2}{3}.\\end{aligned}\n$$\n\nLetting $x=-\\frac{3}{2}$  gives\n\n$$\n\\begin{aligned}-\\frac{3}{2}+2 & =A(-\\frac{3}{2})(2(-\\frac{3}{2})+3)+B(2(-\\frac{3}{2})+3)+C{(-\\frac{3}{2})}^{2} \\\\ \\frac{1}{2} & =C(\\frac{9}{4}) \\\\ C & =\\frac{4}{18} \\\\ C & =\\frac{2}{9}.\\end{aligned}\n$$\n\nFinally, letting $x=1$ and using our values for $B$ and $C$ gives\n\n$$\n\\begin{aligned}1+2 & =A(1)(2(1)+3)+(\\frac{2}{3})(2(1)+3)+(\\frac{2}{9})(1)^{2} \\\\ 3 & =5A+\\frac{10}{3}+\\frac{2}{9} \\\\ 3 & =5A+\\frac{32}{9} \\\\ 5A & =-\\frac{5}{9} \\\\ A & =-\\frac{1}{9}.\\end{aligned}\n$$\n\n  \n\nFinally,\n\n$$\n\\begin{aligned}A\\cdot B\\cdot C & =-\\frac{1}{9}\\cdot \\frac{2}{3}\\cdot \\frac{2}{9} \\\\  & =-\\frac{4}{243}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-50049/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221"] 