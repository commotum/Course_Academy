5119/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "e88ecf12-05a2-5f58-bf30-700e438f815f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-115119/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "b73eed13-847e-5948-a481-a0081d13929e" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-115119/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "c85d0a78-b6cf-5668-9dfb-a73ec5fe7821" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-115119/selection" :answer-field/id #uuid "c78173bd-6ef2-5df0-8de3-58bbdb624ebc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115119/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-115119/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-115119/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" "q-115119/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-115119/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-115119/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-115119" :question/id #uuid "18e0d488-98da-53b0-9348-253ff450c1b1" :question/math-academy-id "q-115119" :question/problem "Given that \n\n$$\n\\frac{-2x-1}{(x-1)^{2}}=\\frac{A}{x-1}+\\frac{B}{(x-1)^{2}},\n$$\n\nwhere $A$ and $B$ are real constants, what is the value of $A\\cdot B?$" :question/worked-solution "Multiplying both sides of the given equality by $(x-1)^{2}$ gives\n\n$$\n\\begin{aligned}-2x-1 & =A(x-1)+B.\\end{aligned}\n$$\n\nLetting $x=1$ gives\n\n$$\n\\begin{aligned}-2(1)-1 & =A(1-1)+B \\\\ -3 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}-2(0)-1 & =A(0-1)-3 \\\\ -1 & =-A-3 \\\\ -A & =2 \\\\ A & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nA\\cdot B=(-2)\\cdot (-3)=6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115119/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187"] :knowledge-point/questions ["q-115119"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351195/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "4c668cf3-d452-57de-852d-e6734dd433c3" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-351195/field-1" :answer-field/id #uuid "14366be2-468f-55bc-8e7d-e82daf8a22fd" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351195/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-351195/field-1/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe"] :db/ensure [:answer-field/validate]} {:db/id "q-351195/field-2/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer/id #uuid "16da8067-c899-5adf-9dd0-3628a5970bb3" :answer/type :answer.type/math :answer/value "33" :db/ensure [:answer/validate]} {:db/id "q-351195/field-2" :answer-field/id #uuid "6c6fc59f-f440-5c05-b0e5-52c57a6d4910" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351195/field-2/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9" :answer-field/choices ["q-351195/field-2/84ba06c5ef46c5ec9648beb7e3447fc668d456369383b0c063fb4b9a83b2adb9"] :db/ensure [:answer-field/validate]} {:db/id "q-351195" :question/id #uuid "8158e5c3-66af-50a2-91dc-ef9e1ea2f2df" :question/math-academy-id "q-351195" :question/problem "Express $\\frac{7x+2}{(x+5)^{2}}$ as a sum of partial fractions.\n\n| $\\frac{7x+2}{(x+5)^{2}}=$ | {{field-1}} | $-$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x+5$ |  | $(x+5)^{2}$ |" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{7x+2}{(x+5)^{2}}=\\frac{A}{x+5}+\\frac{B}{(x+5)^{2}}.\\end{aligned}\n$$\n\nMultiplying both sides of the above equality by $(x+5)^{2}$ gives\n\n$$\n7x+2=A(x+5)+B.\n$$\n\nLetting $x=-5$ gives\n\n$$\n\\begin{aligned}7(-5)+2 & =A(-5+5)+B \\\\ B & =-33.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}0+2 & =A(0+5)-33 \\\\ 2 & =5A-33 \\\\ A & =7.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{7x+2}{(x+5)^{2}}=\\frac{7}{x+5}-\\frac{33}{(x+5)^{2}}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351195/field-1" "q-351195/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187"] :knowledge-point/questions ["q-351195"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346820/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "24ce0eea-2af9-5d42-99b3-c846c7f811b0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-346820/field-1" :answer-field/id #uuid "e709ea80-e742-5376-b2ec-c1151f814ad5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346820/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-346820/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-346820/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "1abeb8b9-3fd9-525f-af46-36709c0fd57b" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-346820/field-2" :answer-field/id #uuid "14199cb1-73f3-5fe3-bfe5-9cc3b0405d98" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346820/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-346820/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-346820/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "20c1021d-153b-5f02-9a6f-946814fdeb92" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-346820/field-3" :answer-field/id #uuid "af34b159-dbe7-58eb-856f-1030ec4bc45e" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346820/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-346820/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-346820" :question/id #uuid "281bf09b-c5a1-5140-8c85-e96bd712eee0" :question/math-academy-id "q-346820" :question/problem "Express $\\frac{6{x}^{2}+x-3}{{x}^{2}(x-1)}$ as a sum of partial fractions.\n\n| $\\frac{6{x}^{2}+x-3}{{x}^{2}(x-1)}\\,=$ | {{field-1}} | $+$ | {{field-2}} | $+$ | {{field-3}} |\n| --- | --- | --- | --- | --- | --- |\n|  | $x$ |  | ${x}^{2}$ |  | $x-1$ |" :question/worked-solution "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\frac{6{x}^{2}+x-3}{{x}^{2}(x-1)}=\\frac{A}{x}+\\frac{B}{{x}^{2}}+\\frac{C}{x-1}.\n$$\n\nMultiplying both sides by ${x}^{2}(x-1)$ gives\n\n$$\n6{x}^{2}+x-3=Ax(x-1)+B(x-1)+C{x}^{2}.\n$$\n\nLetting $x=0$ gives\n\n$$\n\\begin{aligned}6(0)^{2}+(0)-3 & =A(0)(0-1)+B(0-1)+C(0)^{2} \\\\ -3 & =B(-1) \\\\ B & =3.\\end{aligned}\n$$\n\nLetting $x=1$ gives\n\n$$\n\\begin{aligned}6(1)^{2}+(1)-3 & =A(1)(1-1)+B(1-1)+C(1)^{2} \\\\ 4 & =C(1)^{2} \\\\ 4 & =1C \\\\ C & =4.\\end{aligned}\n$$\n\nFinally, letting $x=2$ and using our values for $B$ and $C$ gives\n\n$$\n\\begin{aligned}6(2)^{2}+(2)-3 & =A(2)(2-1)+3(2-1)+4(2)^{2} \\\\ 23 & =A(2)(1)+3(1)+4(4) \\\\ 23 & =2A+3+16 \\\\ 23 & =2A+19 \\\\ A & =2.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{6{x}^{2}+x-3}{{x}^{2}(x-1)}=\\frac{2}{x}+\\frac{3}{{x}^{2}}+\\frac{4}{x-1}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-346820/field-1" "q-346820/field-2" "q-346820/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c30dc350-d0c9-5a4d-87a0-4e2ebb1bb221"] :knowledge-point/questions ["q-346820"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351226/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "548c5da4-ae35-5650-b788-9a2124e2e5bd" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-351226/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "4c1a846b-5900-5bf9-b2af-793969dbce26" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-351226/field-1" :answer-field/id #uuid "c7a40ee6-fc19-5710-b0de-c80eda4b838a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351226/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-351226/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-351226/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-351226/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "965294a9-5740-5f97-b4dd-1e0cb369e8ca" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-351226/field-2" :answer-field/id #uuid "71a8c04f-15a7-5fd9-a91d-f57212f40815" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351226/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-351226/field-2/eadb4f132857861