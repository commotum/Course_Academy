:answer.type/text :answer/value "$A=7$ and $B=6$" :db/ensure [:answer/validate]} {:db/id "q-115113/selection" :answer-field/id #uuid "b1f14d1b-8b84-538d-8d29-4dc587201fa8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115113/selection/55d35f538ab09c15f4b5dec9490e2d13b42384990a079ac8c129466daee3c526" :answer-field/choices ["q-115113/selection/738ff5f979fbfbaca6f46cf5fde4a20b210bd03f1ddf2a1950721e256db4ec81" "q-115113/selection/7cb5020f636cac599d581b8069c930eeee591a473485ff7cf3cca2c9f28841c1" "q-115113/selection/55d35f538ab09c15f4b5dec9490e2d13b42384990a079ac8c129466daee3c526" "q-115113/selection/4e2de5ffb8d00c464069c98b6f3791b9e0b3d56aaad3da7e59e0b15024816992" "q-115113/selection/9566cebe9c4d7128f4702f2a84d6ff49b0b203cd653955ff9718aa223b2d5aaf"] :db/ensure [:answer-field/validate]} {:db/id "q-115113" :question/id #uuid "944cb6dc-af49-50a6-9958-2b8dfb1c883e" :question/math-academy-id "q-115113" :question/problem "Given that \n\n$$\n\\frac{7x+20}{(x+4)^{2}}=\\frac{A}{x+4}+\\frac{B}{(x+4)^{2}},\n$$\n\nfind the real constants $A$ and $B.$" :question/worked-solution "Multiplying both sides of the given equality by $(x+4)^{2}$ gives\n\n$$\n\\begin{aligned}7x+20 & =A(x+4)+B.\\end{aligned}\n$$\n\nLetting $x=-4$  gives\n\n$$\n\\begin{aligned}7(-4)+20 & =A(-4+4)+B \\\\ -8 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}7(0)+20 & =A(0+4)-8 \\\\ 20 & =4A-8 \\\\ 28 & =4A \\\\ A & =7.\\end{aligned}\n$$\n\nTherefore, $A=7$ and $B=-8.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115113/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0d98b82-24d2-5b2c-b596-0300778bd187"] :knowledge-point/questions ["q-115113"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-73204"] :question/problem "Given that \n\n$$\n\\frac{x+8}{(x-2)^{2}}=\\frac{A}{x-2}+\\frac{B}{(x-2)^{2}},\n$$\n\nwhere $A$ and $B$ are real constants, what is the value of $A\\cdot B?$" :question/worked-solution "Multiplying both sides of the given equality by $(x-2)^{2}$ gives\n\n$$\n\\begin{aligned}x+8 & =A(x-2)+B.\\end{aligned}\n$$\n\nLetting $x=2$  gives\n\n$$\n\\begin{aligned}2+8 & =A(2-2)+B \\\\ 10 & =B.\\end{aligned}\n$$\n\nLetting $x=0$ and using our value for $B$ gives\n\n$$\n\\begin{aligned}0+8 & =A(0-2)+10 \\\\ -2 & =-2A \\\\ A & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\nA\\cdot B=1\\cdot 10=10.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-115117/selection/3343f94c949cd83c4eb449cf2330aa35493f48c4beafa18ca3c658392e631bd3" :answer/id #uuid "921d7cb0-bb0d-53ea-8684-67ebbaa09089" :answer/type :answer.type/text :answer/value "$A=2$ and $B=-6$" :db/ensure [:answer/validate]} {:db/id "q-115117/selection/d8d6a61b64828b402655f2e8a372780d0a327922d58aafd912ba87258f80bac8" :answer/id #uuid "a34afbf8-4c9a-5448-a8aa-68039f31d779" :answer/type :answer.type/text :answer/value "$A=1$ and $B=6$" :db/ensure [:answer/validate]} {:db/id "q-115117/selection/4f6a3d0f99349115e3f5327b55e2fe7751e9b993fc3294ec0f7d42a7582bffee" :answer/id #uuid "53c17aa7-50a2-58bf-aafd-8bbecdbc3600" :answer/type :answer.type/text :answer/value "$A=-2$ and $B=-4$" :db/ensure [:answer/validate]} {:db/id "q-115117/selection/62240b92c60d2f016387f3490d65d47d999a5a58cd13991e98b569f96a3b61bf" :answer/id #uuid "884416e3-8e19-58a9-a460-918decc46e0e" :answer/type :answer.type/text :answer/value "$A=1$ and $B=-4$" :db/ensure [:answer/validate]} {:db/id "q-115117/selection/dbbc8eb980309b69323b20c89cb40e671bf8b8c3d8c3d4057fe1883335f8db5a" :answer/id #uuid "3d4e633d-2d20-583a-be99-76c487b71061" :answer/type :answer.type/text :answer/value "$A=-1$ and $B=2$" :db/ensure [:answer/validate]} {:db/id "q-115117/selection" :answer-field/id #uuid "6f4220d7-2b6a-5a32-9816-976894dd5077" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115117/selection/6