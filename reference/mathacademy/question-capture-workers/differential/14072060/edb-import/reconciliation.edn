frac{\\text{d}}{\\text{d}x}(\\operatorname{arcosh}⁡x)=\\frac{1}{\\sqrt{{x}^{2}-1}}.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\int \\frac{3}{{e}^{2}\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\frac{3}{{e}^{2}}\\int \\frac{1}{\\sqrt{{x}^{2}-1}}\\,\\text{d}x=\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072060/state.json" "file_sha256" "f30dbd6a68732b1420bbb48079b2d2e91c438f46c66a3c3daa9ce1a95ec31047"} {"question" "q-95651" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072060/activity-metadata.json" "file_sha256" "4f022004f134182ec3714c31e47ee6f51fbe316877b7949777fc619b9710b5e9"} {"question" "q-95651" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072060/state.json" "file_sha256" "f30dbd6a68732b1420bbb48079b2d2e91c438f46c66a3c3daa9ce1a95ec31047"} {"question" "q-95651" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3\\operatorname{arcosh}⁡\\frac{x}{{e}^{2}}+C"] ["math" "-\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C"] ["math" "\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C"] ["math" "\\frac{3}{{e}^{2}}\\operatorname{arsinh}⁡x+C"] ["math" "\\operatorname{arcosh}⁡\\frac{3x}{{e}^{2}}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072060/state.json" "file_sha256" "f30dbd6a68732b1420bbb48079b2d2e91c438f46c66a3c3daa9ce1a95ec31047"} {"question" "q-95651" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{{e}^{2}}\\operatorname{arcosh}⁡x+C"] "catego