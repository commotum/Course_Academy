][\\begin{aligned}0 \\\\ 3\\end{aligned}] \\\\  & =[\\begin{aligned}3\\operatorname{sin}⁡(2t) \\\\ 3\\operatorname{cos}⁡(2t)\\end{aligned}].\\end{aligned}\n$$\n\n- Next, we find the particular solution. Notice that \n\n$$\n{e}^{A(t-s)}=[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{aligned}].\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}{e}^{A(t-s)}g(s) & =[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) & \\operatorname{sin}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s)) & \\operatorname{cos}⁡(2(t-s))\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s))\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}3\\operatorname{sin}⁡(2t) \\\\ 3\\operatorname{cos}⁡(2t)\\end{aligned}]+{\\int }_{0}^{t}[\\begin{aligned}\\operatorname{cos}⁡(2(t-s)) \\\\ -\\operatorname{sin}⁡(2(t-s))\\end{aligned}]\\text{d}s.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-334855/field-1" "q-334855/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "95223ee8-46d8-58c2-9e3b-017adb2789e8"] :knowledge-point/questions ["q-334855"] :db/ensure [:knowledge-point/validate]} {:db/id "q-334858/field-1/bdf082e3f8aa0e7eebe390fec52e638aa4a5b864640326861321c52f92aa5b17" :answer/id #uuid "239cbcbd-98d6-59e6-8d4c-d96c59f384f2" :answer/type :answer.type/math :answer/value "\\cos(4(t-s))" :db/ensure [:answer/validate]} {:db/id "q-334858/field-1/235d91734df9a533caf7c08f6ac91f12cd2a66bea1bb251dc745f1c1da4cd1db" :answer/id #uuid "a93f5b88-c681-51cc-8d7e-02a027a58316" :answer/type :answer.type/math :answer/value "\\sin(4(t-s))" :db/ensure [:answer/validate]} {:db/id "q-334858/field-1" :answer-field/id #uuid "3271e08a-e259-5eb8-8c98-ecb767e88996" :answer-field/key "field-1" :answer-field/type :answer-field.type/blan