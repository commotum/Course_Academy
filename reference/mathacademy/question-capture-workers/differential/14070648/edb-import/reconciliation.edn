orname{sin}⁡t \\\\ 3\\operatorname{sin}⁡t & 2\\operatorname{cos}⁡t\\end{aligned}| \\\\  & =(2\\operatorname{cos}⁡t)\\cdot (2\\operatorname{cos}⁡t)-(-3\\operatorname{sin}⁡t)\\cdot (3\\operatorname{sin}⁡t) \\\\  & =4{cos}^{2}⁡t+9{sin}^{2}⁡t \\\\  & =4{cos}^{2}⁡t+9{sin}^{2}⁡t\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }t\\in R.$\n\nTherefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{independent}$ on $R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "file_sha256" "16453f15dc6e978b770a1cf08c037485c2e01bb0d27f6535e75b7cc73edc41d9"} {"question" "q-333869" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/activity-metadata.json" "file_sha256" "87a024714285f995a264000b8d4ee3dead3fef4b34be37c1ece7359b2ed39565"} {"question" "q-333869" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "file_sha256" "16453f15dc6e978b770a1cf08c037485c2e01bb0d27f6535e75b7cc73edc41d9"} {"question" "q-333869" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "-4{cos}^{2}⁡t-9{sin}^{2}⁡t"] ["math" "0"] ["math" "4{cos}^{2}⁡t+9{sin}^{2}⁡t"] ["math" "\\operatorname{cos}⁡(2t)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "file_sha256" "16453f15dc6e978b770a1cf08c037485c2e01bb0d27f6535e75b7cc73edc41d9"} {"question" "q-333869" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "4{cos}^{2}⁡t+9{sin}^{2}⁡t"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Cou