, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{dependent}$ on $R.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "file_sha256" "16453f15dc6e978b770a1cf08c037485c2e01bb0d27f6535e75b7cc73edc41d9"} {"question" "q-333843" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/activity-metadata.json" "file_sha256" "87a024714285f995a264000b8d4ee3dead3fef4b34be37c1ece7359b2ed39565"} {"question" "q-333843" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "file_sha256" "16453f15dc6e978b770a1cf08c037485c2e01bb0d27f6535e75b7cc73edc41d9"} {"question" "q-333843" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "-6{e}^{2t}"] ["math" "0"] ["math" "6{e}^{2t}"] ["math" "{e}^{2t}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "file_sha256" "16453f15dc6e978b770a1cf08c037485c2e01bb0d27f6535e75b7cc73edc41d9"} {"question" "q-333843" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "file_sha256" "16453f15dc6e978b770a1cf08c037485c2e01bb0d27f6535e75b7cc73edc41d9"} {"question" "q-333843" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070648/state.json" "fil