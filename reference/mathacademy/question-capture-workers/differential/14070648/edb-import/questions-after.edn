\\ 3\\operatorname{sin}⁡t & 2\\operatorname{cos}⁡t\\end{aligned}| \\\\  & =(2\\operatorname{cos}⁡t)\\cdot (2\\operatorname{cos}⁡t)-(-3\\operatorname{sin}⁡t)\\cdot (3\\operatorname{sin}⁡t) \\\\  & =4{cos}^{2}⁡t+9{sin}^{2}⁡t \\\\  & =4{cos}^{2}⁡t+9{sin}^{2}⁡t\\end{aligned}\n$$\n\nwhich is $\\text{nonzero for at least one }t\\in R.$\n\nTherefore, the set ${{x}_{1}(t),{x}_{2}(t)}$ is linearly $\\text{independent}$ on $R.$"}] [{:db/id #edb/ref 17592186367789 :knowledge-point/_questions [{:knowledge-point/id #uuid "ac674e3f-ac2b-5512-b4fa-9840c6cbd034" :knowledge-point/title "Identifying Fundamental Sets of Solutions to Systems of Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2513fe3-9e91-506d-a04c-81b03761b53e" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186367791} {:answer/id #uuid "443154a0-cf14-51a0-a272-f1d81143c427" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186367792}] :answer-field/correct {:answer/id #uuid "443154a0-cf14-51a0-a272-f1d81143c427" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186367792} :answer-field/id #uuid "1ed1ccef-3dbf-58dd-86fa-d3cb6fe9c269" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186367790} {:answer-field/choices [{:answer/id #uuid "0fc5332c-f802-5b10-a505-5934dfd35912" :answer/type {:db/ident :answer.type/text} :answer/value "isn't" :db/id #edb/ref 17592186367794} {:answer/id #uuid "32b69cb9-95ec-5bcc-8862-9f4ab46571df" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186367795}] :answer-field/correct {:answer/id #uuid "32b69cb9-95ec-5bcc-8862-9f4ab46571df" :answer/type {:db/ident :answer.type/text} :answer/value "is" :db/id #edb/ref 17592186367795} :answer-field/id #uuid "ba057c02-ffea-52d7-8cb3-3f0e233415b5" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/sel