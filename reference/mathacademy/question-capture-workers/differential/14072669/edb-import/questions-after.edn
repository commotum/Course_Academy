#{[{:db/id #edb/ref 17592186376685 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3adeb21-b90a-59f1-922e-d596b0557e08" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,-9,\\,-6⟩" :db/id #edb/ref 17592186376687} {:answer/id #uuid "131eafa4-c361-5cc5-80f4-4c347f70c18a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,\\,1,\\,2⟩" :db/id #edb/ref 17592186376688} {:answer/id #uuid "254ad42a-e7fd-575b-9c2f-cd77fa19afdd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,\\,0,\\,2⟩" :db/id #edb/ref 17592186376689} {:answer/id #uuid "8340c82c-ed51-5aec-ba60-80c40e9777ec" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,-3,\\,-2⟩" :db/id #edb/ref 17592186376690} {:answer/id #uuid "c4f90bd4-8124-5694-a830-39dc9dfc7542" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,3,\\,-2⟩" :db/id #edb/ref 17592186376691}] :answer-field/correct {:answer/id #uuid "8340c82c-ed51-5aec-ba60-80c40e9777ec" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,-3,\\,-2⟩" :db/id #edb/ref 17592186376690} :answer-field/id #uuid "be34a5cc-beb4-5554-a383-99337c3b7b48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376686}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e9a94a8b-f939-5c94-bb65-9658dde90c4c" :question/math-academy-id "q-129178" :question/problem "Calculate \n${\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨-3,\\,9,\\,6⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(t)\\,\\text{d}t & =-{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-3,\\,9,\\,6⟩ \\\\  & =⟨3,\\,-9,\\,-6⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t & =\\frac{1}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{3}\\cdot ⟨3,\\,-9,\\,-6⟩ \\\\  & =⟨1,\\,-3,\\,-2⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186376692 :knowledge-point/_questions [{:knowledge-point/id #uuid "1c8ee97e-f2b0-587e-9171-8008f1e0c4aa" :knowledge-point/title "Applying the Product Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fb00428e-cf5a-53d7-8a5a-277aa199ba16" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186376694} {:answer/id #uuid "9963c1f5-e819-5ab8-ab1d-b047de2352e6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186376695} {:answer/id #uuid "3ca9c48c-5d97-5858-96dc-b100eaf900b3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186376696} {:answer/id #uuid "2d4e055f-e1e3-5351-b7cd-6246f216995d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186376697} {:answer/id #uuid "3ad9ec80-816a-5022-a511-1052986b2330" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186376698}] :answer-field/correct {:answer/id #uuid "fb00428e-cf5a-53d7-8a5a-277aa199ba16" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186376694} :answer-field/id #uuid "e46f5e07-5aab-5975-8c4b-b5746d86b5ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376693}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2f1d0b88-051d-53e4-abd6-a13160ed1321" :question/math-academy-id "q-129287" :question/problem "Given that \n${\\int }_{0}^{2}f(t)\\,\\text{d}t=4\\,i-2\\,j+k,$ \n$c=u\\,i-2\\,j-2\\,k,$\nand \n${\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t=0,$ what is the value of $u?$" :question/worked-solution "The dot product rule states that\n\n$$\n{\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{0}^{2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =(u\\,i-2\\,j-2\\,k)\\cdot (4\\,i-2\\,j+\\,k) \\\\  & =4u+4-2 \\\\  & =4u+2.\\end{aligned}\n$$\n\nFinally, since ${\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t=0,$ we must have $4u+2=0,$ which means that $u=-\\frac{1}{2}.$"}] [{:db/id #edb/ref 17592186376699 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9fe11060-0fdf-50c3-9d11-b01225e359a1" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8,\\,2,\\,1⟩" :db/id #edb/ref 17592186376701} {:answer/id #uuid "f7d6a85a-52ee-5ea1-8cbd-91797e1b8e28" :answer/type {:db/ident :answer.type/math} :answer/value "⟨8,\\,4,\\,1⟩" :db/id #edb/ref 17592186376702} {:answer/id #uuid "0bb0cd54-317b-56c8-bece-9744a7f9411f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8,\\,4,\\,-1⟩" :db/id #edb/ref 17592186376703} {:answer/id #uuid "34a7cbbb-373c-507a-8844-f68a6dbdadeb" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,2,\\,-1⟩" :db/id #edb/ref 17592186376704} {:answer/id #uuid "893a50d7-70f1-5367-a3cd-b10e2dd0a9a8" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,-2,\\,0⟩" :db/id #edb/ref 17592186376705}] :answer-field/correct {:answer/id #uuid "0bb0cd54-317b-56c8-bece-9744a7f9411f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-8,\\,4,\\,-1⟩" :db/id #edb/ref 17592186376703} :answer-field/id #uuid "f9dd286c-634d-5116-af5c-be584f50c0a9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376700}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f6362c37-2e32-54b3-8aa0-c3cb9e6d3761" :question/math-academy-id "q-98186" :question/problem "Calculate \n${\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t$\ngiven that\n${\\int }_{3}^{0}f(t)\\,\\text{d}t=⟨5,\\,-1,\\,-2⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)\\,\\text{d}t & =-{\\int }_{3}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨5,\\,-1,\\,-2⟩ \\\\  & =⟨-5,\\,1,\\,2⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{0}^{3}⟨-1,\\,1,\\,-1⟩\\,\\text{d}t \\\\  & =⟨-5,\\,1,\\,2⟩+{⟨-t,\\,t,\\,-t⟩|}_{0}^{3} \\\\  & =⟨-5,\\,1,\\,2⟩+⟨-3,\\,3,\\,-3⟩\\text{ } \\\\  & =⟨-8,\\,4,\\,-1⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186376706 :knowledge-point/_questions [{:knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00" :knowledge-point/title "Applying the Adjacent Intervals Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "991facef-63cd-5de9-95a0-4ba0fc3dbeb4" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,\\,3,\\,5⟩" :db/id #edb/ref 17592186376708} {:answer/id #uuid "362c1524-6ffb-5863-848f-7ae4bbf58e30" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,-5,\\,1⟩" :db/id #edb/ref 17592186376709} {:answer/id #uuid "76425cd5-39d4-5c64-b0a5-65f1c772da35" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,\\,-5,\\,-5⟩" :db/id #edb/ref 17592186376710} {:answer/id #uuid "9af6eac0-6e8c-5e98-b070-fc7d8d9b005f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,\\,3,\\,-1⟩" :db/id #edb/ref 17592186376711} {:answer/id #uuid "b76d0b24-8c5d-55a8-9d26-9232ffbac9ab" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,-3,\\,-1⟩" :db/id #edb/ref 17592186376712}] :answer-field/correct {:answer/id #uuid "9af6eac0-6e8c-5e98-b070-fc7d8d9b005f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,\\,3,\\,-1⟩" :db/id #edb/ref 17592186376711} :answer-field/id #uuid "7ee43ac8-8954-5174-aca5-f27f407b9ff3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376707}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d48fbf3d-c5a0-5a45-a9c8-4b0ee27f0213" :question/math-academy-id "q-98211" :question/problem "Calculate \n${\\int }_{2}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{4}f(t)\\,\\text{d}t=⟨5,\\,-1,\\,2⟩$\nand\n${\\int }_{3}^{4}f(t)\\,\\text{d}t=⟨-2,\\,-4,\\,3⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{2}^{4}f(t)\\,\\text{d}t={\\int }_{2}^{3}f(t)\\,\\text{d}t+{\\int }_{3}^{4}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{2}^{3}f(t)\\,\\text{d}t={\\int }_{2}^{4}f(t)\\,\\text{d}t-{\\int }_{3}^{4}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}f(t)\\,\\text{d}t & ={\\int }_{2}^{4}f(t)\\,\\text{d}t-{\\int }_{3}^{4}f(t)\\,\\text{d}t \\\\  & =⟨5,\\,-1,\\,2⟩-⟨-2,\\,-4,\\,3⟩ \\\\  & =⟨7,\\,3,\\,-1⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186376713 :knowledge-point/_questions [{:knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00" :knowledge-point/title "Applying the Adjacent Intervals Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47e173fa-a952-5a1b-83d0-53074c6f6c8d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-10,\\,2,\\,5⟩" :db/id #edb/ref 17592186376715} {:answer/id #uuid "07b38afe-9ba7-50fc-8b9b-f092929b86c7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-10,\\,0,\\,17⟩" :db/id #edb/ref 17592186376716} {:answer/id #uuid "8293fc01-7da9-571e-9259-23d5325dfe15" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,\\,0,\\,5⟩" :db/id #edb/ref 17592186376717} {:answer/id #uuid "4f87b8ca-66f7-5d61-ab35-e94e7844c610" :answer/type {:db/ident :answer.type/math} :answer/value "⟨7,\\,1,\\,17⟩" :db/id #edb/ref 17592186376718} {:answer/id #uuid "cfaad001-6652-588c-8865-9a8a66520d0f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,\\,-7,\\,3⟩" :db/id #edb/ref 17592186376719}] :answer-field/correct {:answer/id #uuid "07b38afe-9ba7-50fc-8b9b-f092929b86c7" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-10,\\,0,\\,17⟩" :db/id #edb/ref 17592186376716} :answer-field/id #uuid "cc09e702-e977-5a9f-88d5-09d75e696c18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376714}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "aa70f714-feb6-5367-be2d-f3376c62dd97" :question/math-academy-id "q-98264" :question/problem "Calculate \n${\\int }_{1}^{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{5}f(t)\\,\\text{d}t=⟨-1,\\,-3,\\,5⟩$\nand\n${\\int }_{2}^{5}f(t)\\,\\text{d}t=⟨9,\\,-3,\\,-12⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{1}^{5}f(t)\\,\\text{d}t={\\int }_{1}^{2}f(t)\\,\\text{d}t+{\\int }_{2}^{5}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{2}f(t)\\,\\text{d}t={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{2}^{5}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}f(t)\\,\\text{d}t & ={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{2}^{5}f(t)\\,\\text{d}t \\\\  & =⟨-1,\\,-3,\\,5⟩-⟨9,\\,-3,\\,-12⟩ \\\\  & =⟨-10,\\,0,\\,17⟩.\\end{aligned}\n$$"}]}
