[{:db/id "q-98186/selection/7fbe6bc1931cfb161b8d134d8c50833bb808f15b1f853e1d587be6999f5f025d" :answer/id #uuid "0bb0cd54-317b-56c8-bece-9744a7f9411f" :answer/type :answer.type/math :answer/value "⟨-8,\\,4,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-98186/selection/975d5ee5d2cac4f0a8b671d29b03ac2c6e97447092a3f2a8a2dd6b8481c0c8fc" :answer/id #uuid "893a50d7-70f1-5367-a3cd-b10e2dd0a9a8" :answer/type :answer.type/math :answer/value "⟨2,\\,-2,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-98186/selection/6412dc90fea527a133fc9483ecbc2dcf5121bf3d49b0d2dbeb14c302b77354cc" :answer/id #uuid "f7d6a85a-52ee-5ea1-8cbd-91797e1b8e28" :answer/type :answer.type/math :answer/value "⟨8,\\,4,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-98186/selection/032ef88432316f2cd94a99d9c4ebd609fbd177a58cde119aba38b2eed57d4943" :answer/id #uuid "9fe11060-0fdf-50c3-9d11-b01225e359a1" :answer/type :answer.type/math :answer/value "⟨-8,\\,2,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-98186/selection/89ae7e944bd99154ad64e161d6a18ca130ee4ada768e569656f1988dec536ac7" :answer/id #uuid "34a7cbbb-373c-507a-8844-f68a6dbdadeb" :answer/type :answer.type/math :answer/value "⟨2,\\,2,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-98186/selection" :answer-field/id #uuid "f9dd286c-634d-5116-af5c-be584f50c0a9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98186/selection/7fbe6bc1931cfb161b8d134d8c50833bb808f15b1f853e1d587be6999f5f025d" :answer-field/choices ["q-98186/selection/7fbe6bc1931cfb161b8d134d8c50833bb808f15b1f853e1d587be6999f5f025d" "q-98186/selection/975d5ee5d2cac4f0a8b671d29b03ac2c6e97447092a3f2a8a2dd6b8481c0c8fc" "q-98186/selection/6412dc90fea527a133fc9483ecbc2dcf5121bf3d49b0d2dbeb14c302b77354cc" "q-98186/selection/032ef88432316f2cd94a99d9c4ebd609fbd177a58cde119aba38b2eed57d4943" "q-98186/selection/89ae7e944bd99154ad64e161d6a18ca130ee4ada768e569656f1988dec536ac7"] :db/ensure [:answer-field/validate]} {:db/id "q-98186" :question/id #uuid "f6362c37-2e32-54b3-8aa0-c3cb9e6d3761" :question/math-academy-id "q-98186" :question/problem "Calculate \n${\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t$\ngiven that\n${\\int }_{3}^{0}f(t)\\,\\text{d}t=⟨5,\\,-1,\\,-2⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)\\,\\text{d}t & =-{\\int }_{3}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨5,\\,-1,\\,-2⟩ \\\\  & =⟨-5,\\,1,\\,2⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(t)+⟨-1,\\,1,\\,-1⟩\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{0}^{3}⟨-1,\\,1,\\,-1⟩\\,\\text{d}t \\\\  & =⟨-5,\\,1,\\,2⟩+{⟨-t,\\,t,\\,-t⟩|}_{0}^{3} \\\\  & =⟨-5,\\,1,\\,2⟩+⟨-3,\\,3,\\,-3⟩\\text{ } \\\\  & =⟨-8,\\,4,\\,-1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-98186/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375"] :knowledge-point/questions ["q-98186"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98211/selection/cad057a622b511b42190dfdd585696ba95a2270e60afc40462cfaeae5d3583b8" :answer/id #uuid "b76d0b24-8c5d-55a8-9d26-9232ffbac9ab" :answer/type :answer.type/math :answer/value "⟨3,\\,-3,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-98211/selection/6c4e3db6f4f9b0963afa4a8acc5698281ad4eebc877f1d4723b227d7a79d89f3" :answer/id #uuid "76425cd5-39d4-5c64-b0a5-65f1c772da35" :answer/type :answer.type/math :answer/value "⟨7,\\,-5,\\,-5⟩" :db/ensure [:answer/validate]} {:db/id "q-98211/selection/204a34cbdb8c7cfb19bcfbd773911116a47b066e7f355c45c8ac6430fc371a76" :answer/id #uuid "991facef-63cd-5de9-95a0-4ba0fc3dbeb4" :answer/type :answer.type/math :answer/value "⟨-3,\\,3,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "q-98211/selection/ba7a3c169999a467a4fdbce5f4e6d041e5e3653389208a9b9fbf3b86cd7e6401" :answer/id #uuid "9af6eac0-6e8c-5e98-b070-fc7d8d9b005f" :answer/type :answer.type/math :answer/value "⟨7,\\,3,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-98211/selection/5a199a2d99e20e46103c4ba8fa90201945983348817443652b61d1d96b7b4e7f" :answer/id #uuid "362c1524-6ffb-5863-848f-7ae4bbf58e30" :answer/type :answer.type/math :answer/value "⟨3,\\,-5,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-98211/selection" :answer-field/id #uuid "7ee43ac8-8954-5174-aca5-f27f407b9ff3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98211/selection/ba7a3c169999a467a4fdbce5f4e6d041e5e3653389208a9b9fbf3b86cd7e6401" :answer-field/choices ["q-98211/selection/cad057a622b511b42190dfdd585696ba95a2270e60afc40462cfaeae5d3583b8" "q-98211/selection/6c4e3db6f4f9b0963afa4a8acc5698281ad4eebc877f1d4723b227d7a79d89f3" "q-98211/selection/204a34cbdb8c7cfb19bcfbd773911116a47b066e7f355c45c8ac6430fc371a76" "q-98211/selection/ba7a3c169999a467a4fdbce5f4e6d041e5e3653389208a9b9fbf3b86cd7e6401" "q-98211/selection/5a199a2d99e20e46103c4ba8fa90201945983348817443652b61d1d96b7b4e7f"] :db/ensure [:answer-field/validate]} {:db/id "q-98211" :question/id #uuid "d48fbf3d-c5a0-5a45-a9c8-4b0ee27f0213" :question/math-academy-id "q-98211" :question/problem "Calculate \n${\\int }_{2}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{4}f(t)\\,\\text{d}t=⟨5,\\,-1,\\,2⟩$\nand\n${\\int }_{3}^{4}f(t)\\,\\text{d}t=⟨-2,\\,-4,\\,3⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{2}^{4}f(t)\\,\\text{d}t={\\int }_{2}^{3}f(t)\\,\\text{d}t+{\\int }_{3}^{4}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{2}^{3}f(t)\\,\\text{d}t={\\int }_{2}^{4}f(t)\\,\\text{d}t-{\\int }_{3}^{4}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}f(t)\\,\\text{d}t & ={\\int }_{2}^{4}f(t)\\,\\text{d}t-{\\int }_{3}^{4}f(t)\\,\\text{d}t \\\\  & =⟨5,\\,-1,\\,2⟩-⟨-2,\\,-4,\\,3⟩ \\\\  & =⟨7,\\,3,\\,-1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98211/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00"] :knowledge-point/questions ["q-98211"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98264/selection/7aa992d8ca960674ebc026bd702c7ab8fa73f670f43020be28d75550eb5f75f9" :answer/id #uuid "cfaad001-6652-588c-8865-9a8a66520d0f" :answer/type :answer.type/math :answer/value "⟨-1,\\,-7,\\,3⟩" :db/ensure [:answer/validate]} {:db/id "q-98264/selection/331775bc16617bbdff0266b62062a069d19e65c4fdc9b3fb4b3e82df0107c5d2" :answer/id #uuid "07b38afe-9ba7-50fc-8b9b-f092929b86c7" :answer/type :answer.type/math :answer/value "⟨-10,\\,0,\\,17⟩" :db/ensure [:answer/validate]} {:db/id "q-98264/selection/68fb975aad86014ed8c3d348b87895cf25cc36154bb9babea660a0ceeac9e854" :answer/id #uuid "4f87b8ca-66f7-5d61-ab35-e94e7844c610" :answer/type :answer.type/math :answer/value "⟨7,\\,1,\\,17⟩" :db/ensure [:answer/validate]} {:db/id "q-98264/selection/2c37c9ebec413745584bd900951592e42add387b35a41aa77c1a22548f936ba7" :answer/id #uuid "47e173fa-a952-5a1b-83d0-53074c6f6c8d" :answer/type :answer.type/math :answer/value "⟨-10,\\,2,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "q-98264/selection/4e513e92f6a215ff1fbb57fa7253a38328410e27b707b4907b4b0dbbfa12d884" :answer/id #uuid "8293fc01-7da9-571e-9259-23d5325dfe15" :answer/type :answer.type/math :answer/value "⟨-1,\\,0,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "q-98264/selection" :answer-field/id #uuid "cc09e702-e977-5a9f-88d5-09d75e696c18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98264/selection/331775bc16617bbdff0266b62062a069d19e65c4fdc9b3fb4b3e82df0107c5d2" :answer-field/choices ["q-98264/selection/7aa992d8ca960674ebc026bd702c7ab8fa73f670f43020be28d75550eb5f75f9" "q-98264/selection/331775bc16617bbdff0266b62062a069d19e65c4fdc9b3fb4b3e82df0107c5d2" "q-98264/selection/68fb975aad86014ed8c3d348b87895cf25cc36154bb9babea660a0ceeac9e854" "q-98264/selection/2c37c9ebec413745584bd900951592e42add387b35a41aa77c1a22548f936ba7" "q-98264/selection/4e513e92f6a215ff1fbb57fa7253a38328410e27b707b4907b4b0dbbfa12d884"] :db/ensure [:answer-field/validate]} {:db/id "q-98264" :question/id #uuid "aa70f714-feb6-5367-be2d-f3376c62dd97" :question/math-academy-id "q-98264" :question/problem "Calculate \n${\\int }_{1}^{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{5}f(t)\\,\\text{d}t=⟨-1,\\,-3,\\,5⟩$\nand\n${\\int }_{2}^{5}f(t)\\,\\text{d}t=⟨9,\\,-3,\\,-12⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{1}^{5}f(t)\\,\\text{d}t={\\int }_{1}^{2}f(t)\\,\\text{d}t+{\\int }_{2}^{5}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{2}f(t)\\,\\text{d}t={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{2}^{5}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}f(t)\\,\\text{d}t & ={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{2}^{5}f(t)\\,\\text{d}t \\\\  & =⟨-1,\\,-3,\\,5⟩-⟨9,\\,-3,\\,-12⟩ \\\\  & =⟨-10,\\,0,\\,17⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98264/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00"] :knowledge-point/questions ["q-98264"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129178/selection/21e671a36d32c6a0a2806863e433f0274cd10a06c356cd55ec02bcb9c9f56c63" :answer/id #uuid "254ad42a-e7fd-575b-9c2f-cd77fa19afdd" :answer/type :answer.type/math :answer/value "⟨-1,\\,0,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "q-129178/selection/1db463a95440685ab4afcffd09142b3246f395e0a09732fe41546db26454212e" :answer/id #uuid "131eafa4-c361-5cc5-80f4-4c347f70c18a" :answer/type :answer.type/math :answer/value "⟨-3,\\,1,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "q-129178/selection/01c89c543492c1aeeddd11d693ee9c21b1487618fd8e6a515cf2b72ec0a1ce41" :answer/id #uuid "b3adeb21-b90a-59f1-922e-d596b0557e08" :answer/type :answer.type/math :answer/value "⟨3,\\,-9,\\,-6⟩" :db/ensure [:answer/validate]} {:db/id "q-129178/selection/d45ecdbe6235f7acf222e09dca1ee223dc5f48974c17fc7e9aac53596fd92d14" :answer/id #uuid "c4f90bd4-8124-5694-a830-39dc9dfc7542" :answer/type :answer.type/math :answer/value "⟨2,\\,3,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "q-129178/selection/35b53d5ecbb87d2f524b775aa40fc8604dae3d9519a8a8d39f0c65de13fda4bc" :answer/id #uuid "8340c82c-ed51-5aec-ba60-80c40e9777ec" :answer/type :answer.type/math :answer/value "⟨1,\\,-3,\\,-2⟩" :db/ensure [:answer/validate]} {:db/id "q-129178/selection" :answer-field/id #uuid "be34a5cc-beb4-5554-a383-99337c3b7b48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129178/selection/35b53d5ecbb87d2f524b775aa40fc8604dae3d9519a8a8d39f0c65de13fda4bc" :answer-field/choices ["q-129178/selection/21e671a36d32c6a0a2806863e433f0274cd10a06c356cd55ec02bcb9c9f56c63" "q-129178/selection/1db463a95440685ab4afcffd09142b3246f395e0a09732fe41546db26454212e" "q-129178/selection/01c89c543492c1aeeddd11d693ee9c21b1487618fd8e6a515cf2b72ec0a1ce41" "q-129178/selection/d45ecdbe6235f7acf222e09dca1ee223dc5f48974c17fc7e9aac53596fd92d14" "q-129178/selection/35b53d5ecbb87d2f524b775aa40fc8604dae3d9519a8a8d39f0c65de13fda4bc"] :db/ensure [:answer-field/validate]} {:db/id "q-129178" :question/id #uuid "e9a94a8b-f939-5c94-bb65-9658dde90c4c" :question/math-academy-id "q-129178" :question/problem "Calculate \n${\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨-3,\\,9,\\,6⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(t)\\,\\text{d}t & =-{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-3,\\,9,\\,6⟩ \\\\  & =⟨3,\\,-9,\\,-6⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t & =\\frac{1}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{3}\\cdot ⟨3,\\,-9,\\,-6⟩ \\\\  & =⟨1,\\,-3,\\,-2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129178/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375"] :knowledge-point/questions ["q-129178"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129287/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "3ad9ec80-816a-5022-a511-1052986b2330" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-129287/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "9963c1f5-e819-5ab8-ab1d-b047de2352e6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129287/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3ca9c48c-5d97-5858-96dc-b100eaf900b3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-129287/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "2d4e055f-e1e3-5351-b7cd-6246f216995d" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-129287/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "fb00428e-cf5a-53d7-8a5a-277aa199ba16" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-129287/selection" :answer-field/id #uuid "e46f5e07-5aab-5975-8c4b-b5746d86b5ed" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129287/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-129287/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-129287/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-129287/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-129287/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-129287/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-129287" :question/id #uuid "2f1d0b88-051d-53e4-abd6-a13160ed1321" :question/math-academy-id "q-129287" :question/problem "Given that \n${\\int }_{0}^{2}f(t)\\,\\text{d}t=4\\,i-2\\,j+k,$ \n$c=u\\,i-2\\,j-2\\,k,$\nand \n${\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t=0,$ what is the value of $u?$" :question/worked-solution "The dot product rule states that\n\n$$\n{\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{0}^{2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =(u\\,i-2\\,j-2\\,k)\\cdot (4\\,i-2\\,j+\\,k) \\\\  & =4u+4-2 \\\\  & =4u+2.\\end{aligned}\n$$\n\nFinally, since ${\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t=0,$ we must have $4u+2=0,$ which means that $u=-\\frac{1}{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129287/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1c8ee97e-f2b0-587e-9171-8008f1e0c4aa"] :knowledge-point/questions ["q-129287"] :db/ensure [:knowledge-point/validate]}]
