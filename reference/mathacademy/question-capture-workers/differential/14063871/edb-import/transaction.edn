ection/a23e1fb8400d4a0eb9fd8a213bc466f6c653c0e24e52047c685a0febb60b9646"] :db/ensure [:answer-field/validate]} {:db/id "q-130138" :question/id #uuid "c2b6a362-ef37-5dff-82af-5c1a25680c3e" :question/math-academy-id "q-130138" :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+4\\frac{\\text{d}y}{\\text{d}x}+4y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}+4\\lambda {e}^{\\lambda x}+4{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}+4\\lambda +4) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}+4\\lambda +4=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda +2)(\\lambda +2)=0 \\\\ (\\lambda +2)^{2}=0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =-2$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{-2x}+Bx{e}^{-2x}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130138/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bebe4460-e57e-546f-99c8-81192aafc1ec"] :knowledge-point/questions ["q-130138"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-7795"] :question/problem "Find the general solution to the equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-3\\frac{\\text{d}y}{\\text{d}x}+\\frac{9}{4}y=0.\n$$" :question/worked-solution "Let $y={e}^{\\lambda x}.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\lambda {e}^{\\lambda x},\\,\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}={\\lambda }^{2}{e}^{\\lambda x}.\n$$\n\nSubstituting the above into our differential equation gives\n\n$$\n\\begin{aligned}{\\lambda }^{2}{e}^{\\lambda x}-3\\lambda {e}^{\\lambda x}+\\frac{9}{4}{e}^{\\lambda x} & =0 \\\\ {e}^{\\lambda x}({\\lambda }^{2}-3\\lambda +\\frac{9}{4}) & =0.\\end{aligned}\n$$\n\nThe auxiliary equation is therefore\n\n$$\n{\\lambda }^{2}-3\\lambda +\\frac{9}{4}=0.\n$$\n\nFactoring the auxiliary equation gives\n\n$$\n\\begin{aligned}(\\lambda -\\frac{3}{2})(\\lambda -\\frac{3}{2}) & =0 \\\\ {(\\lambda -\\frac{3}{2})}^{2} & =0.\\end{aligned}\n$$\n\nTherefore, $\\lambda =\\frac{3}{2}$ is a repeated root.\n\nSo the general solution to the differential equation is\n\n$$\ny=A{e}^{3x/2}+Bx{e}^{3x/2}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-90957/selection/619585a539efbd3ee9376f09ec81444a885346565dc53d37b2a687d91b5f8afd" :answer/id #uuid "84813226-c692-52fb-9004-7f61a6405305" :answer/type :answer.type/math :answer/value "y=A{e}^{-9x}+B{e}^{9x}" :db/ensure [:answer/validate]} {:db/id "q-90957/selection/29dfdb77c71cde375c3c30d4abc625b687744dc937ec4bec6a19f31958c539d4" :answer/id #uuid "c4fb427f-cb02-59d7-959c-192dffd2cd4d" :answer/type :answer.type/math :answer/value "y=A{e}^{9x}+Bx{e}^{9x}" :db/ensure [:answer/validate]} {:db/id "q-90957/selection/512d2d6f8f8f3bc93082815a8cafc7aac1aff0e63aa367bd88f7cea25127377a" :answer/id #uuid "72912b0f-e6b0-51b9-a94e-02bb5e5f3f99" :answer/type :answer.type/math :answer/value "y=A{e}^{-9x}+Bx{e}^{-9x}" :db/ensure [:answer/validate]} {:db/id "q-90957/selection/40cdd77557c347798cf1e6f91ddec72c5fb849aacead9e4c4b8c36a1f75605a5" :answer/id #uuid "693be024-c6cb-50ab-bcbf-ee72a9fb47ad" :answer/type :answer.type/math :answer/value "y=A{e}^{-6x}+B{e}^{6x}" :db/ensure [:answer/validate]} {:db/id "q-90957/selection/a7ee0cb1f82adc26648e727b6b0f2e5d9ba73a97f027aaea13246943232313b3" :answer/id #uuid "cc9c13e6-3c76-555c-a710-693c7ecb6cfd" :answer/type :answer.type/math :answer/value "y=A{e}^{-3x}+Bx{e}^{-3x}" :db/ensure [:answer/