          "value": [
            ":answer.type/math",
            "g({y}_{\\text{new}})={y}_{\\text{new}}-2({y}_{\\text{new}})^{2}-2"
          ],
          "category": "reviewed_ma_solution",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14071464/answer-source-reviews.json",
