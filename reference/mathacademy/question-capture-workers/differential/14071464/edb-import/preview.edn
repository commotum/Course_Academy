})\\cdot 1 \\\\  & =x\\sqrt{y}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+x\\sqrt{y}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n{{{y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}}_{⏟}}_{g({y}_{\\text{new}})}=0.\n$$\n\nTherefore, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}.\n$$" 13194139535865 true] [17592186371161 1000 #edb/ref 17592186371162 13194139535865 true] [17592186371161 1000 #edb/ref 17592186371163 13194139535865 true] [17592186371161 1000 #edb/ref 17592186371164 13194139535865 true] [17592186371161 1000 #edb/ref 17592186371165 13194139535865 true] [17592186371161 1000 #edb/ref 17592186371166 13194139535865 true] [17592186371161 1040 #edb/ref 17592186045450 13194139535865 true] [17592186371161 1041 "selection" 13194139535865 true] [17592186371161 1104 #edb/ref 17592186371163 13194139535865 true] [17592186371161 1110 #uuid "39ab2fe3-fb33-5cae-9585-f54d210f73a7" 13194139535865 true] [17592186371162 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-{x}_{\\text{new}}\\sqrt{y}" 13194139535865 true] [17592186371162 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371162 1111 #uuid "1c4123e1-be0c-5705-b860-30cb58e63d47" 13194139535865 true] [17592186371163 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" 13194139535865 true] [17592186371163 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371163 1111 #uuid "bd6a96b0-69e1-5319-8d67-72cddc7da278" 13194139535865 true] [17592186371164 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}-{x}_{\\text{new}}{y}_{\\text{new}}-y-x\\sqrt{y}" 13194139535865 true] [17592186371164 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371164 1111 #uuid "2ac52f16-54bd-505d-8449-3f902f9e0f00" 13194139535865 true] [17592186371165 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}-2{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-2x\\sqrt{y}" 13194139535865 true] [17592186371165 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371165 1111 #uuid "f94ae7de-b59c-5650-bc70-521b91251c5a" 13194139535865 true] [17592186371166 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}+{x}_{\\text{new}}\\sqrt{{y}_{\\text{new}}}-y-x\\sqrt{y}" 13194139535865 true] [17592186371166 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371166 1111 #uuid "dd24646b-6011-5ee5-8fd9-550fa0ace3ea" 13194139535865 true] [17592186371167 1017 #edb/ref 17592186371168 13194139535865 true] [17592186371167 1089 "q-334151" 13194139535865 true] [17592186371167 1091 #edb/ref 17592186045465 13194139535865 true] [17592186371167 1100 "Consider the following initial value problem:\n\n$$\n{y}^{′}=x-2\\sqrt{y},\\,y(1)=1\n$$\n\nUsing the trapezoidal method with step size $Δx=1,$ the new value ${y}_{\\text{new}}$ is obtained by solving the equation $g({y}_{\\text{new}})=0$ at each step. Which of the following is the **specific function** $g({y}_{\\text{new}})$ used in the first step?" 13194139535865 true] [17592186371167 1113 #uuid "f4261307-0c79-5182-bcee-cbb66ec60810" 13194139535865 true] [17592186371167 1145 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nIn this example, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}(x-2\\sqrt{y}+{x}_{\\text{new}}-2\\sqrt{{y}_{\\text{new}}})\\cdot 1 \\\\  & =\\frac{1}{2}x+\\frac{1}{2}{x}_{\\text{new}}-\\sqrt{y}-\\sqrt{{y}_{\\text{new}}}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+\\frac{1}{2}x+\\frac{1}{2}{x}_{\\text{new}}-\\sqrt{y}-\\sqrt{{y}_{\\text{new}}}.\\end{aligned}\n$$\n\nMoving all terms to the left-hand side gives the equation\n\n$$\n{y}_{\\text{new}}-y-\\frac{1}{2}x-\\frac{1}{2}{x}_{\\text{new}}+\\sqrt{y}+\\sqrt{{y}_{\\text{new}}}=0.\n$$\n\nSo, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})={y}_{\\text{new}}-y-\\frac{1}{2}x-\\frac{1}{2}{x}_{\\text{new}}+\\sqrt{y}+\\sqrt{{y}_{\\text{new}}}.\n$$\n\nNow, in the first step, the new $x$ value is\n\n$$\n{x}_{\\text{new}}=x+Δx=1+1=2.\n$$\n\n Therefore, the function used in the first step is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & ={y}_{\\text{new}}-1-\\frac{1}{2}(1)-\\frac{1}{2}(2)+1+\\sqrt{{y}_{\\text{new}}} \\\\  & ={y}_{\\text{new}}-1-\\frac{1}{2}-1+1+\\sqrt{{y}_{\\text{new}}} \\\\  & ={y}_{\\text{new}}+\\sqrt{{y}_{\\text{new}}}-\\frac{3}{2}.\\end{aligned}\n$$" 13194139535865 true] [17592186371168 1000 #edb/ref 17592186371169 13194139535865 true] [17592186371168 1000 #edb/ref 17592186371170 13194139535865 true] [17592186371168 1000 #edb/ref 17592186371171 13194139535865 true] [17592186371168 1000 #edb/ref 17592186371172 13194139535865 true] [17592186371168 1000 #edb/ref 17592186371173 13194139535865 true] [17592186371168 1040 #edb/ref 17592186045450 13194139535865 true] [17592186371168 1041 "selection" 13194139535865 true] [17592186371168 1104 #edb/ref 17592186371171 13194139535865 true] [17592186371168 1110 #uuid "afd17de6-459c-5f97-8e0f-d03fb36548b8" 13194139535865 true] [17592186371169 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}-\\sqrt{{y}_{\\text{new}}}-\\frac{3}{2}" 13194139535865 true] [17592186371169 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371169 1111 #uuid "be439f3d-147b-592b-abf9-eff4b20f808f" 13194139535865 true] [17592186371170 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}+\\sqrt{{y}_{\\text{new}}}-1" 13194139535865 true] [17592186371170 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371170 1111 #uuid "275713b7-2edf-5614-ac61-6a8ff5eef957" 13194139535865 true] [17592186371171 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}+\\sqrt{{y}_{\\text{new}}}-\\frac{3}{2}" 13194139535865 true] [17592186371171 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371171 1111 #uuid "45f16e9a-dd5e-5661-a0bf-22ed4161d129" 13194139535865 true] [17592186371172 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}+2\\sqrt{{y}_{\\text{new}}}-\\frac{3}{2}" 13194139535865 true] [17592186371172 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371172 1111 #uuid "615d2361-2aa8-543d-b01f-c4d8e0d759ee" 13194139535865 true] [17592186371173 1034 "g({y}_{\\text{new}})={y}_{\\text{new}}+\\sqrt{{y}_{\\text{new}}}-2" 13194139535865 true] [17592186371173 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371173 1111 #uuid "b7dc6508-8de0-5bc0-bd7a-7f178cef544f" 13194139535865 true] [17592186371174 1017 #edb/ref 17592186371175 13194139535865 true] [17592186371174 1089 "q-334450" 13194139535865 true] [17592186371174 1091 #edb/ref 17592186045463 13194139535865 true] [17592186371174 1100 "Consider the following initial value problem:\n\n$$\n{y}^{′}=x-{y}^{3},\\,y(0)=1\n$$\n\nUse the trapezoidal method with one step and Newton's method to approximate $y(1).$ Round your answer to two decimal places.\n\n$y(1)≈$\n{{field-1}}" 13194139535865 true] [17592186371174 1113 #uuid "5c2dc2b4-b07f-50ff-84ba-476c569db1bf" 13194139535865 true] [17592186371174 1145 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nSince we want to find the value of $y$ at $x=1,$ we will use a step size of\n\n$$\nΔx=1-0=1.\n$$\n\nNow, let's proceed with the trapezoidal method. In general, $Δy$ is given by\n\n$$\n\\begin{aligned}Δy & =\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx \\\\  & =\\frac{1}{2}((x-{y}^{3})+({x}_{\\text{new}}-({y}_{\\text{new}})^{3}))\\cdot 1 \\\\  & =0.5x-0.5{y}^{3}+0.5{x}_{\\text{new}}-0.5({y}_{\\text{new}})^{3}.\\end{aligned}\n$$\n\nSubstituting this into ${y}_{\\text{new}}=y+Δy,$ we have\n\n$$\n\\begin{aligned}{y}_{\\text{new}} & =y+Δy \\\\ {y}_{\\text{new}} & =y+0.5x-0.5{y}^{3}+0.5{x}_{\\text{new}}-0.5({y}_{\\text{new}})^{3},\\end{aligned}\n$$\n\nand moving all terms to the left-hand side gives the equation\n\n$$\n0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}+0.5{y}^{3}-y-0.5{x}_{\\text{new}}-0.5x=0.\n$$\n\nSo, the general form of the function $g$ for step size $Δx=1$ is\n\n$$\ng({y}_{\\text{new}})=0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}+0.5{y}^{3}-y-0.5{x}_{\\text{new}}-0.5x.\n$$\n\nNow, in the first step, the new $x$ value is\n\n$$\n{x}_{\\text{new}}=x+Δx=0+1=1.\n$$\n\n Then, the function $g$ is\n\n$$\n\\begin{aligned}g({y}_{\\text{new}}) & =0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}+0.5(1)^{3}-1-0.5\\cdot 1-0.5\\cdot 0 \\\\  & =0.5({y}_{\\text{new}})^{3}+{y}_{\\text{new}}-1.\\end{aligned}\n$$\n\nWe use a root-finding method with starting point $y=1$ to solve $g({y}_{\\text{new}})=0.$ We'll use Newton's method:\n\n$$\n({y}_{\\text{new}})_{n+1}=({y}_{\\text{new}})_{n}-\\frac{g({y}_{\\text{new}})}{{g}^{′}({y}_{\\text{new}})}.\n$$\n\nNote that the derivative of $g$ is\n\n$$\n{g}^{′}({y}_{\\text{new}})=1.5({y}_{\\text{new}})^{2}+1.\n$$\n\nTherefore, our Newton's method iterative scheme is as follows:\n\n$$\n({y}_{\\text{new}})_{n+1}=({y}_{\\text{new}})_{n}-\\frac{0.5(({y}_{\\text{new}})_{n})^{3}+({y}_{\\text{new}})_{n}-1}{1.5(({y}_{\\text{new}})_{n})^{2}+1}.\n$$\n\nApplying several iterations of Newton's method starting with $y(0)=1,$ we get the following:\n\n$$\n\\begin{aligned}({y}_{\\text{new}})_{1} & =1 \\\\ ({y}_{\\text{new}})_{2} & =0.8 \\\\ ({y}_{\\text{new}})_{3} & ≈0.771\\,429 \\\\ ({y}_{\\text{new}})_{4} & ≈0.770\\,917\\end{aligned}\n$$\n\nTherefore, we conclude that $y(1)≈0.77,$ rounded to two decimal places." 13194139535865 true] [17592186371175 1000 #edb/ref 17592186371176 13194139535865 true] [17592186371175 1000 #edb/ref 17592186371177 13194139535865 true] [17592186371175 1040 #edb/ref 17592186045449 13194139535865 true] [17592186371175 1041 "field-1" 13194139535865 true] [17592186371175 1104 #edb/ref 17592186371177 13194139535865 true] [17592186371175 1110 #uuid "46f94d6f-a13c-514f-9a65-8a809db285dc" 13194139535865 true] [17592186371176 1034 "0.80" 13194139535865 true] [17592186371176 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371176 1111 #uuid "32586168-50d0-5006-91db-e33a7e2d6a60" 13194139535865 true] [17592186371177 1034 "0.77" 13194139535865 true] [17592186371177 1103 #edb/ref 17592186045453 13194139535865 true] [17592186371177 1111 #uuid "2a2b4d44-2233-5d53-b955-50f98510173f" 13194139535865 true] [17592186371178 1017 #edb/ref 17592186371179 13194139535865 true] [17592186371178 1089 "q-334470" 13194139535865 true] [17592186371178 1091 #edb/ref 17592186045463 13194139535865 true] [17592186371178 1100 "Consider the following initial value problem:\n\n$$\n{y}^{′}=1-x{y}^{2},\\,y(0)=1\n$$\n\nUse the trapezoidal method with one step and Newton's method to approximate $y(1).$ Round your answer to two decimal places.\n\n$y(1)≈$\n{{field-1}}" 13194139535865 true] [17592186371178 1113 #uuid "44a5a027-2564-5020-9ef7-18a590f676a8" 13194139535865 true] [17592186371178 1145 "For an initial value problem\n\n$$\n{y}^{′}=f(x,y),\\,y(a)=c,\n$$\n\nthe trapezoidal method with step size $Δx$ is given by\n\n$$\nΔy=\\frac{1}{2}({y}^{′}+{y}_{\\text{new}}^{′})\\cdot Δx,\n$$\n\nwith ${y}_{\\text{new}}^{′}=f({x}_{\\text{new}},{y}_{\\text{new}})$ evaluated at the next $x$ and $y$ values.\n\nSince we want to find the value of $y$ at 