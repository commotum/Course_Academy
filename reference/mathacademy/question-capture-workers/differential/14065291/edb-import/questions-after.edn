#{[{:db/id #edb/ref 17592186349903 :knowledge-point/_questions [{:knowledge-point/id #uuid "29a290a2-bc9e-57bc-84f5-a21cba4848de" :knowledge-point/title "Reducing a First-Order ODE to a Simpler Form Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a07e87c5-6d78-5d95-ab76-7ab439e3c810" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2z}{z+2}" :db/id #edb/ref 17592186349905} {:answer/id #uuid "d4a73584-9ad5-5260-b024-c80bd5d892ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2z+1}{2z}" :db/id #edb/ref 17592186349906} {:answer/id #uuid "c84cba65-ba78-5463-a9ec-c4d8c06c6ca6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2z+1}{z+2}" :db/id #edb/ref 17592186349907} {:answer/id #uuid "f0fdc183-3fdc-5d82-abf3-9eb41bafe729" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{z+1}{2z}" :db/id #edb/ref 17592186349908} {:answer/id #uuid "76ead41e-ac69-5800-9731-a04deeafcaf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(z+1)}{z+2}" :db/id #edb/ref 17592186349909}] :answer-field/correct {:answer/id #uuid "76ead41e-ac69-5800-9731-a04deeafcaf9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2(z+1)}{z+2}" :db/id #edb/ref 17592186349909} :answer-field/id #uuid "d68d5635-f5a1-5f1e-b89a-49332bc68dd4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349904}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "837ae1f6-45c4-567e-8eb0-c65e892adee0" :question/math-academy-id "q-108801" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{x+y}{x+y+2}.\n$$\n\nUsing a substitution of the form $z=x+y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =\\frac{z}{z+2}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x} & =\\frac{z}{z+2}+1 \\\\  & =\\frac{2z+2}{z+2} \\\\  & =\\frac{2(z+1)}{z+2}\\end{aligned}\n$$\n\nTherefore, $f(z)=\\frac{2(z+1)}{z+2}.$"}] [{:db/id #edb/ref 17592186349910 :knowledge-point/_questions [{:knowledge-point/id #uuid "29a290a2-bc9e-57bc-84f5-a21cba4848de" :knowledge-point/title "Reducing a First-Order ODE to a Simpler Form Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92df6243-48f8-5cdb-b63a-6359bb49b564" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{z-3}-4" :db/id #edb/ref 17592186349912} {:answer/id #uuid "c80d6a63-78c9-52f1-8d57-1a6e60938d6f" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{z+3}" :db/id #edb/ref 17592186349913} {:answer/id #uuid "ab3e7180-8ff0-5054-8623-c32b5b96de46" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{z+3}-2" :db/id #edb/ref 17592186349914} {:answer/id #uuid "89c8be47-aecf-5fc0-9011-c49113af6f21" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{z+3}" :db/id #edb/ref 17592186349915} {:answer/id #uuid "bd7e5249-f949-5cb0-9a10-f15eb7eda5c7" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{z-3}" :db/id #edb/ref 17592186349916}] :answer-field/correct {:answer/id #uuid "c80d6a63-78c9-52f1-8d57-1a6e60938d6f" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{z+3}" :db/id #edb/ref 17592186349913} :answer-field/id #uuid "b4b9d4a7-e860-5cec-a984-a2c70d4a14ad" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349911}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e6b6480b-803b-5709-bfd6-a415f8a61bdc" :question/math-academy-id "q-108804" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=4-\\sqrt{y-2x+3}.\n$$\n\nUsing a substitution of the form $z=y-2x,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=y-2x.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{\\text{d}y}{\\text{d}x}-2\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}+2.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}+2 & =4-\\sqrt{z+3}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=2-\\sqrt{z+3}.\n$$\n\nTherefore, $f(z)=2-\\sqrt{z+3}.$"}] [{:db/id #edb/ref 17592186349917 :knowledge-point/_questions [{:knowledge-point/id #uuid "a35df900-489d-5f8e-9d9e-075352035790" :knowledge-point/title "Solving a First-Order ODE Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "86939afe-56b6-53f3-a0d5-2d52e6b24cb0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(x+y+2)^{3}}{3}" :db/id #edb/ref 17592186349919} {:answer/id #uuid "3d6b97fc-2ea3-59ef-baed-9571f2781497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(x+y+2)^{2}}" :db/id #edb/ref 17592186349920} {:answer/id #uuid "b24bbd98-668a-502f-812d-e9af3017b6ab" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{(x+y+2)^{2}}" :db/id #edb/ref 17592186349921} {:answer/id #uuid "cfda16f7-23cf-5f60-a16b-b1f024a1afbe" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{(x+y)^{4}}" :db/id #edb/ref 17592186349922} {:answer/id #uuid "2a88c86c-e675-5079-9414-2c99efda24f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(x+y)^{2}}" :db/id #edb/ref 17592186349923}] :answer-field/correct {:answer/id #uuid "3d6b97fc-2ea3-59ef-baed-9571f2781497" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{(x+y+2)^{2}}" :db/id #edb/ref 17592186349920} :answer-field/id #uuid "5b05e9b8-e0c7-5607-aff6-3b8f3ac74bef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349918}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a5960cef-60ff-556a-97c3-b6b4d81204a8" :question/math-academy-id "q-108840" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=(x+y+2)^{3}-1.\n$$\n\n \nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=C-2x,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =(z+2)^{3}-1\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=(z+2)^{3}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{1}{(z+2)^{3}}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\int \\frac{1}{(z+2)^{3}}\\,\\text{d}z & =\\int \\,\\text{d}x \\\\ -\\frac{1}{2(z+2)^{2}} & =x+K \\\\ \\frac{1}{(z+2)^{2}} & =C-2x,\\end{aligned}\n$$\n\nwhere $C=-2K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n\\frac{1}{(x+y+2)^{2}}=C-2x\n$$\n\nTherefore, $g(x,y)=\\frac{1}{(x+y+2)^{2}}.$"}] [{:db/id #edb/ref 17592186349924 :knowledge-point/_questions [{:knowledge-point/id #uuid "a35df900-489d-5f8e-9d9e-075352035790" :knowledge-point/title "Solving a First-Order ODE Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4de35554-39cc-52a6-a103-7b8fadab01e9" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x+y}(x+y)" :db/id #edb/ref 17592186349926} {:answer/id #uuid "cf7372b5-6acf-59c9-8ef1-a23dead09b7c" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-x-y}" :db/id #edb/ref 17592186349927} {:answer/id #uuid "2b92939f-8e01-5592-9b8e-09846d94262d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-x-y}(x+y+1)" :db/id #edb/ref 17592186349928} {:answer/id #uuid "4c0286ca-74ce-56e7-ba06-b9748eaad082" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{x+y}(1-x-y)" :db/id #edb/ref 17592186349929} {:answer/id #uuid "067018ac-0e05-5cd8-9466-485e165735af" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-2x-2y}" :db/id #edb/ref 17592186349930}] :answer-field/correct {:answer/id #uuid "2b92939f-8e01-5592-9b8e-09846d94262d" :answer/type {:db/ident :answer.type/math} :answer/value "{e}^{-x-y}(x+y+1)" :db/id #edb/ref 17592186349928} :answer-field/id #uuid "55b22758-4dde-5137-a81c-ee58cc7f76fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349925}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ae9cc299-d899-5b37-90ea-45ac33d8f95e" :question/math-academy-id "q-108841" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{{e}^{x+y}-x-y}{x+y}.\n$$\n\n \nThe general solution to this equation can be expressed in the form\n\n$$\ng(x,y)=C-x,\n$$\n\nwhere $C$ is a constant. What is $g(x,y)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x+y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1+\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\text{d}z}{\\text{d}x}-1.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}z}{\\text{d}x}-1 & =\\frac{{e}^{z}-z}{z}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z)$ gives\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=\\frac{{e}^{z}}{z}.\n$$\n\nThis differential equation is separable. So, we separate the variables and integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{z}{{e}^{z}}\\,\\frac{\\text{d}z}{\\text{d}x} & =1 \\\\ \\int z{e}^{-z}\\,\\text{d}z & =\\int \\,\\text{d}x\\end{aligned}\n$$\n\nUsing integration by parts on the left side,\n\n$$\n\\begin{aligned}u=z & \\,⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{-z} & \\,⟹\\,v=-{e}^{-z}\\end{aligned}\n$$\n\nwe get\n\n$$\n\\begin{aligned}\\int z{e}^{-z}\\,\\text{d}z & =\\int \\,\\text{d}x \\\\ -z{e}^{-z}+\\int {e}^{-z}\\,\\text{d}z & =\\int \\,\\text{d}x \\\\ -z{e}^{-z}-{e}^{-z} & =x+C \\\\ -{e}^{-z}(z+1) & =x+K \\\\ {e}^{-z}(z+1) & =C-x\\end{aligned}\n$$\n\nwhere $C=-K.$\n\nFinally, we write the equation in terms of $y$ and $x$ using our original substitution, as follows:\n\n$$\n{e}^{-x-y}(x+y+1)=C-x\n$$\n\nTherefore, $g(x,y)={e}^{-x-y}(x+y+1).$"}] [{:db/id #edb/ref 17592186349931 :knowledge-point/_questions [{:knowledge-point/id #uuid "29a290a2-bc9e-57bc-84f5-a21cba4848de" :knowledge-point/title "Reducing a First-Order ODE to a Simpler Form Using a Linear Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3df546c1-9750-581e-be4b-6647608c010c" :answer/type {:db/ident :answer.type/math} :answer/value "1-2\\sqrt[3]{z}" :db/id #edb/ref 17592186349933} {:answer/id #uuid "8ce2788e-81bf-5e9a-ba7a-05f57f3ac4a6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt[3]{z-1}" :db/id #edb/ref 17592186349934} {:answer/id #uuid "61d0f87d-0d10-5b25-91a3-e0b2c4e8ed29" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt[3]{z}" :db/id #edb/ref 17592186349935} {:answer/id #uuid "906fbaa9-32a2-5e02-bad7-9607cd07c834" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt[3]{2z-1}" :db/id #edb/ref 17592186349936} {:answer/id #uuid "c89d5bcb-61b1-5034-80d1-47a1f88e2583" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sqrt[3]{z}" :db/id #edb/ref 17592186349937}] :answer-field/correct {:answer/id #uuid "3df546c1-9750-581e-be4b-6647608c010c" :answer/type {:db/ident :answer.type/math} :answer/value "1-2\\sqrt[3]{z}" :db/id #edb/ref 17592186349933} :answer-field/id #uuid "e81abe91-1c89-5a82-9528-2ac67213c0bc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349932}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d9344499-c126-5c7e-b63b-7034740df4a2" :question/math-academy-id "q-149710" :question/problem "Consider the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\sqrt[3]{x-2y}.\n$$\n\nUsing a substitution of the form $z=x-2y,$ transform the differential equation into an equation of the form ${z}^{′}(x)=f(z).$ What is the function $f(z)?$" :question/worked-solution "First, we make the substitution\n\n$$\nz=x-2y.\n$$\n\nDifferentiating $z(x)$ using the chain rule, we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1-2\\,\\frac{\\text{d}y}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{2}-\\frac{1}{2}\\,\\frac{\\text{d}z}{\\text{d}x}.\n$$\n\nTherefore, the original equation can be written in terms of $z$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}-\\frac{1}{2}\\,\\frac{\\text{d}z}{\\text{d}x} & =\\sqrt[3]{z}\\end{aligned}\n$$\n\nExpressing this equation in the form ${z}^{′}(x)=f(z),$ we get\n\n$$\n\\frac{\\text{d}z}{\\text{d}x}=1-2\\sqrt[3]{z}.\n$$\n\nTherefore, $f(z)=1-2\\sqrt[3]{z}.$"}]}
