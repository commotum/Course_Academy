[{:db/id "q-338878/field-1/f9cb7a922831dd2577ff757d7a44eebca6d18c94d6a8e8d4fb06d98ebaee26a7" :answer/id #uuid "cce30dd0-46b7-5f97-b588-3393a1a351b7" :answer/type :answer.type/math :answer/value "\\frac{{e}^{3}-1}{e}" :db/ensure [:answer/validate]} {:db/id "q-338878/field-1/ffeba10a45a48637eba90b6793acca00a17ca7ef374e72c96214cf6199cae1b9" :answer/id #uuid "221e5c9f-bb04-5c20-858c-53aa5306a8ef" :answer/type :answer.type/math :answer/value "\\frac{{e}^{3}+1}{e}" :db/ensure [:answer/validate]} {:db/id "q-338878/field-1/c566e49c7f569417f780f5a8b73b9caa11d44d869950814cbb72aeefccc73ae4" :answer/id #uuid "4e441a55-8bb8-5f0b-aba9-de8e3d04a76e" :answer/type :answer.type/math :answer/value "\\frac{{e}^{3}-1}{{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-338878/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6825c832-ea02-5e91-ba82-1ee6180e87d8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-338878/field-1/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" :answer/id #uuid "237185f2-c459-5ea6-a1a7-41a0cc32ffcd" :answer/type :answer.type/math :answer/value "{e}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-338878/field-1" :answer-field/id #uuid "ca15f6e0-cf52-5437-b857-d3bc42080ee2" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-338878/field-1/f9cb7a922831dd2577ff757d7a44eebca6d18c94d6a8e8d4fb06d98ebaee26a7" :answer-field/choices ["q-338878/field-1/f9cb7a922831dd2577ff757d7a44eebca6d18c94d6a8e8d4fb06d98ebaee26a7" "q-338878/field-1/ffeba10a45a48637eba90b6793acca00a17ca7ef374e72c96214cf6199cae1b9" "q-338878/field-1/c566e49c7f569417f780f5a8b73b9caa11d44d869950814cbb72aeefccc73ae4" "q-338878/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-338878/field-1/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767"] :db/ensure [:answer-field/validate]} {:db/id "q-338878/field-2/0b7fd52e1c7f4