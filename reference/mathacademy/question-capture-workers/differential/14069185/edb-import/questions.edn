55-5637-bff5-ae47633b0b79" :knowledge-point/title "Identifying the System Given a Phase Portrait"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f170ed91-b9ff-5d9c-8df8-71248bc94fca" :answer/type {:db/ident :answer.type/math} :answer/value "{x^{′}(t) = 2x(t); y^{′}(t) =-5y(t)" :db/id #edb/ref 17592186164318} {:answer/id #uuid "2f88f6cb-e289-5743-82a5-967f503264b6" :answer/type {:db/ident :answer.type/math} :answer/value "{x^{′}(t) =-2x(t); y^{′}(t) = 5y(t)" :db/id #edb/ref 17592186164319} {:answer/id #uuid "350991da-0acc-556a-8d9c-f2dc12de7ded" :answer/type {:db/ident :answer.type/math} :answer/value "{x^{′}(t) =-2x(t); y^{′}(t) =-5y(t)" :db/id #edb/ref 17592186164320} {:answer/id #uuid "3b4cb7c0-2ef1-52d9-bbf8-1ea50c4877c0" :answer/type {:db/ident :answer.type/math} :answer/value "{x^{′}(t) = 5x(t); y^{′}(t) =-2y(t)" :db/id #edb/ref 17592186164321} {:answer/id #uuid "5754158d-bdc6-5e34-b8fe-fcd6d3d6a241" :answer/type {:db/ident :answer.type/math} :answer/value "{x^{′}(t) = 2x(t); y^{′}(t) = 5y(t)" :db/id #edb/ref 17592186164322}] :answer-field/correct {:answer/id #uuid "350991da-0acc-556a-8d9c-f2dc12de7ded" :answer/type {:db/ident :answer.type/math} :answer/value "{x^{′}(t) =-2x(t); y^{′}(t) =-5y(t)" :db/id #edb/ref 17592186164320} :answer-field/id #uuid "625030ea-ebc9-5fc2-808a-c9d38d6f7533" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186164317}] :question/id #uuid "3495d1a5-5d34-547b-9b7d-bfc79add2594" :question/math-academy-id "q-332717" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/3242/Source/Images/q-332717.png)\n\nConsider the phase portrait for a decoupled system above.\nWhich of the following systems could correspond to the given portrait?"}]}
