 following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/897778556ebc80f44cf48e17c4fc085c08c45b93358dec9fb0c958de3105c98d.png)"}] [{:db/id #edb/ref 17592186361259 :knowledge-point/_questions [{:knowledge-point/id #uuid "d5802583-df2c-5f08-bf9f-8b36247e34d4" :knowledge-point/title "Identifying the Phase Portrait of a System"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12a1d0ec-ecb9-5632-a5c8-11774a47fa0c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/6623c5f1563832e5999daafef510551eecc4fd17419f90fa651283fc8de30f1d.png" :db/id #edb/ref 17592186361261} {:answer/id #uuid "cf8b0e26-f4a2-5f98-8dfd-392328b1b620" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/a5d09c1f7b7201f8910e7fe029bb9b1759e266bea84e04eb14079deb803a0255.png" :db/id #edb/ref 17592186361262} {:answer/id #uuid "d153d538-5484-51ac-bea0-9b40cda00ce4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/a8ce97b61b596096070ed52d063c80294d2353be6776cb5658e060d33997c6aa.png" :db/id #edb/ref 17592186361263} {:answer/id #uuid "a771ad67-6118-58aa-8885-949b8c2f4d21" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/3facfdf59a92a9202d834cd77d14e009c4ec69c5f1b7bd5f12bd17ea1bbc338b.png" :db/id #edb/ref 17592186361264} {:answer/id #uuid "660ae998-c52f-549b-a308-31b1f6351237" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/d