}_{1}>0$ and ${\\lambda }_{2}>0$ is the following:\n\n$$\n{\\begin{aligned}{x}^{′}(t)=3x(t) \\\\ {y}^{′}(t)=7y(t)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332713/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d81d981f-ab55-5637-bff5-ae47633b0b79"] :knowledge-point/questions ["q-332713"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332692/selection/35adfed7a99ddf862c50579fc327a521e5e2dc289e66c21f12523972d2c1a260" :answer/id #uuid "556058e0-c209-5ddd-8f75-bd3fd5168102" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}^{′}(t)=-4x(t) \\\\ {y}^{′}(t)=-y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-332692/selection/a45deabf698699dc3f648e56dd036e9b3a8999c43361253b980689588e96b15e" :answer/id #uuid "e59027e3-c272-5545-8c5a-97ef943cdb4f" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}^{′}(t)=4x(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-332692/selection/1b3233ffed87f7f59aa315614012d36eaa2a31e814ea79083b5644e1d8cf1199" :answer/id #uuid "c16ac482-ceb0-54ae-8cc3-cf5efc1a89c6" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}^{′}(t)=-4x(t) \\\\ {y}^{′}(t)=y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-332692/selection/0e1ee5e8000d933778711c048570ac07a370333989212f2b0970a7c69eb93d11" :answer/id #uuid "100b1e97-9643-56fe-a716-3b6c71289202" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}^{′}(t)=4x(t) \\\\ {y}^{′}(t)=-y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-332692/selection/0d1fb512e24dde501c9203fd2d713c94f9e88e980fb57e742ef2313c2a5e0c37" :answer/id #uuid "c9a3cd4d-872c-5dbe-a775-d669a739a4b1" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}^{′}(t)=-y(t) \\\\ {y}^{′}(t)=-4y(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-332692/selection" :answer-field/id #uuid "0c8e1d3c-3117-5622-9513-219fc1a16376" :an