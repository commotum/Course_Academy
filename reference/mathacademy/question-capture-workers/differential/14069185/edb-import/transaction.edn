0f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" "q-333227/field-3/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc"] :db/ensure [:answer-field/validate]} {:db/id "q-333227" :question/id #uuid "7685d561-af7c-5963-8ff0-5f1c98ad02e5" :question/math-academy-id "q-333227" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-4x(t) \\\\ {y}^{′}(t)=-5y(t)\\end{aligned}\n$$\n\nSelect the correct options below regarding the given decoupled system of linear differential equations.$\\,$\nThe $x$-axis is a {{field-1}} line.\n\n$\\,$\nThe $y$-axis is a {{field-2}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-3}}." :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-4 & 0 \\\\ 0 & -5\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=-4$ with the eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{1}{e}^{-4t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis and approach the origin as $t\\to \\infty .$ So, the $x$-axis is the $\\text{stable}$ line.\n\n- Eigenvalue ${\\lambda }_{2}=-5$ with the eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{2}{e}^{-5t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis and also approach the origin as $t\\to \\infty .$ So, the $y$-axis is the $\\text{stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/b406c864e820819c5ae6f548c7a025a1e1d8197fb785ea5689080034e04210cb.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333227/field-1" "q-333227/field-2" "q-333227/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "24bd917d-c4b3-5bf5-9426-a87a579b03c1"] :knowledge-point/questions ["q-333227"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333213/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer/id #uuid "69ffe4b0-5ec6-52ae-a2d5-1b4685e736b2" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "q-333213/field-1/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer/id #uuid "a8942790-19b7-51ff-a688-0ce8d433dc5a" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "q-333213/field-1" :answer-field/id #uuid "33d07e7c-af6d-5f25-b763-cabe93a96e16" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-333213/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer-field/choices ["q-333213/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" "q-333213/field-1/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4"] :db/ensure [:answer-field/validate]} {:db/id "q-333213/field-2/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer/id #uuid "127a76f9-d597-507e-9811-49259a9815fd" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "q-333213/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer/id #uuid "8d6a1f23-7a93-5b6a-89fe-26cbc9493a7e" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "q-333213/field-2" :answer-field/id #uuid "fbef879f-f9c1-5f5e-81e8-b1a18b19f450" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-333213/field-2/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer-field/choices ["q-333213/field-2/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" "q-333213/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb"] :db/ensure [:answer-field/validate]} {:db/id "q-333213/field-3/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" :answer/id #uuid "afad6318-d29f-514e-abae-80a768de4f1b" :answer/type :answer.type/text :answer/value "a stable node (sink)" :db/ensure [:answer/validate]} {:db/id "q-333213/field-3/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" :answer/id #uuid "c1203ee0-0e18-539f-8d9d-c77ff32176d9" :answer/type :answer.type/text :answer/value "an unstable node (source)" :db/ensure [:answer/validate]} {:db/id "q-333213/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" :answer/id #uuid "df5188f4-f05e-5546-bb14-8e5b19419f81" :answer/type :answer.type/text :answer/value "a saddle point" :db/ensure [:answer/validate]} {:db/id "q-333213/field-3" :answer-field/id #uuid "3d5198d6-982d-59d3-b12c-97a4b6897156" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-333213/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" :answer-field/choices ["q-333213/field-3/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" "q-333213/field-3/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" "q-333213/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04"] :db/ensure [:answer-field/validate]} {:db/id "q-333213" :question/id #uuid "d329e132-aa2f-50d8-8bad-87983411294d" :question/math-academy-id "q-333213" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-x(t) \\\\ {y}^{′}(t)=2y(t)\\end{aligned}\n$$\n\nSelect the correct options below regarding the given decoupled system of linear differential equations.$\\,$\nThe $x$-axis is a {{field-1}} line.\n\n$\\,$\nThe $y$-axis is a {{field-2}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-3}}." :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & 0 \\\\ 0 & 2\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=-1$ with the eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{1}{e}^{-t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis and approach the origin as $t\\to \\infty .$ So, the $x$-axis is the $\\text{stable}$ line.\n\n- Eigenvalue ${\\lambda }_{2}=2$ with the eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{2}{e}^{2t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis and move away from the origin as $t\\to \\infty .$ So, the $y$-axis is the $\\text{unstable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a saddle point}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/8c350c21a6206ec73244dd58601b20a816dcb69557a030099870e2c824aba772.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333213/field-1" "q-333213/field-2" "q-333213/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "24bd917d-c4b3-5bf5-9426-a87a579b03c1"] :knowledge-point/questions ["q-333213"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333224/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer/id #uuid "5f2cecd1-3a91-5f0d-84db-f2810446da0b" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "q-333224/field-1/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer/id #uuid "af5f0006-664c-5394-ab72-9b05592a3f7f" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "q-333224/field-1" :answer-field/id #uuid "d41eadf1-9341-5c41-9d6d-383db0795fca" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-333224/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer-field/choices ["q-333224/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" "q-333224/field-1/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4"] :db/ensure [:answer-field/validate]} {:db/id "q-333224/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer/id #uuid "c54c17e7-703b-5f42-948e-4ec9245d7bd4" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "q-333224/field-2/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer/id #uuid "9e40b134-c909-5fe1-b6f6-44940c3a5cdc" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "q-333224/field-2" :answer-field/id #uuid "728820dc-4a14-5457-89f8-cf61da910118" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-333224/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer-field/choices ["q-333224/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" "q-333224/field-2/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4"] :db/ensure [:answer-field/validate]} {:db/id "q-333224/field-3/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" :answer/id #uuid "6fdd2ff0-dba3-59ff-8ccd-2fd725e634f6" :answer/type :answer.type/text :answer/value "an unstable node (source)" :db/ensure [:answer/validate]} {:db/id "q-333224/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" :answer/id #uuid "5ecedba0-c2b1-56d5-b9ca-97565fe130bb" :answer/type :answer.type/text :answer/value "a saddle point" :db/ensure [:answer/validate]} {:db/id "q-333224/field-3/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" :answer/id #uuid "2b4027e8-1bb8-58df-83bf-be804f07a86e" :answer/type :answer.type/text :answer/value "a stable node (sink)" :db/ensure [:answer/validate]} {:db/id "q-333224/field-3" :answer-field/id #uuid "7965e926-4dcb-5db4-ab1c-01caf666dc6b" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-333224/field-3/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" :answer-field/choices ["q-333224/field-3/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" "q-333224/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" "q-333224/field-3/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa"] :db/ensure [:answer-field/validate]} {:db/id "q-333224" :question/id #uuid "d1c82443-160c-5ecb-b7e3-f0a7c6455443" :question/math-academy-id "q-333224" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-2x(t) \\\\ {y}^{′}(t)=-4y(t)\\end{aligned}\n$$\n\nSelect the correct options below regarding the given decoupled system of linear differential equations.$\\,$\nThe $x$-axis is a {{field-1}} line.\n\n$\\,$\nThe $y$-axis is a {{field-2}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-3}}." :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-2 & 0 \\\\ 0 & -4\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=-2$ with the eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{1}{e}^{-2t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis and approach the origin as $t\\to \\infty .$ So, the $x$-axis is the $\\text{stable}$ line.\n\n- Eigenvalue ${\\lambda }_{2}=-4$ with the eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{2}{e}^{-4t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis and also approach the origin as $t\\to \\infty .$ So, the $y$-axis is the $\\text{stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/062b58a307f6d40c7be59d527cc01d7d301bd3f0115a0074ba0f3dca54412425.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333224/field-1" "q-333224/field-2" "q-333224/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "24bd917d-c4b3-5bf5-9426-a87a579b03c1"] :knowledge-point/questions ["q-333224"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333214/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer/id #uuid "60c60b72-2ecd-5243-8552-91ab5818c1d4" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "q-333214/field-1/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer/id #uuid "1938fe30-d429-5d29-8e5a-08d5d6028319" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "q-333214/field-1" :answer-field/id #uuid "0135d4d2-0d50-5b74-ac1e-a4563c03e6da" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-333214/field-1/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer-field/choices ["q-333214/field-1/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" "q-333214/field-1/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4"] :db/ensure [:answer-field/validate]} {:db/id "q-333214/field-2/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" :answer/id #uuid "eb06c7d4-2f2c-52c7-94a8-681b56992ece" :answer/type :answer.type/text :answer/value "unstable" :db/ensure [:answer/validate]} {:db/id "q-333214/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer/id #uuid "185e69a9-d2fc-59aa-868a-86fada81fff4" :answer/type :answer.type/text :answer/value "stable" :db/ensure [:answer/validate]} {:db/id "q-333214/field-2" :answer-field/id #uuid "e932e70e-550f-5e3d-8a53-7bbdc4133d34" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-333214/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb" :answer-field/choices ["q-333214/field-2/7c90f47a8eeece38813c4ffab6b0911f5ec28b3c4ca7b2ab9be1fd0be059a4f4" "q-333214/field-2/13830b2add0d0975c36840daaa2e8e095b7fd681945e647b89b38b31218d8cdb"] :db/ensure [:answer-field/validate]} {:db/id "q-333214/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" :answer/id #uuid "c2469f82-9e4b-583b-911c-a955b6c6974d" :answer/type :answer.type/text :answer/value "a saddle point" :db/ensure [:answer/validate]} {:db/id "q-333214/field-3/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" :answer/id #uuid "408ae78b-d7e4-592a-94a6-51f1329f08a7" :answer/type :answer.type/text :answer/value "an unstable node (source)" :db/ensure [:answer/validate]} {:db/id "q-333214/field-3/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" :answer/id #uuid "b89700c2-6f58-5dc4-b78f-3e21caeb4c30" :answer/type :answer.type/text :answer/value "a stable node (sink)" :db/ensure [:answer/validate]} {:db/id "q-333214/field-3" :answer-field/id #uuid "12663e43-6002-5381-b18b-3a13529433be" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-333214/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" :answer-field/choices ["q-333214/field-3/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" "q-333214/field-3/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" "q-333214/field-3/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa"] :db/ensure [:answer-field/validate]} {:db/id "q-333214" :question/id #uuid "7471bcb3-e317-52aa-b246-f8dc9f5d93a1" :question/math-academy-id "q-333214" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=x(t) \\\\ {y}^{′}(t)=-3y(t)\\end{aligned}\n$$\n\nSelect the correct options below regarding the given decoupled system of linear differential equations.$\\,$\nThe $x$-axis is a {{field-1}} line.\n\n$\\,$\nThe $y$-axis is a {{field-2}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-3}}." :question/worked-solution "Writing our system in matrix form, we have\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 0 \\\\ 0 & -3\\end{aligned}]x(t)\n$$\n\nwhere $x(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}].$\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue ${\\lambda }_{1}=1$ with the eigenvector $[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{1}{e}^{t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on the $x$-axis and move away from the origin as $t\\to \\infty .$ So, the $x$-axis is the $\\text{unstable}$ line.\n\n- Eigenvalue ${\\lambda }_{2}=-3$ with the eigenvector $[\\begin{aligned}0 \\\\ 1\\end{aligned}].$ The corresponding straight-line solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on the $y$-axis and approach the origin as $t\\to \\infty .$ So, the $y$-axis is the $\\text{stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a saddle point}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/6dc8ceb9a1c771f18d6e90d450cd837fe80c6bab7943ab7d397d90eb45754594.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333214/field-1" "q-333214/field-2" "q-333214/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "24bd917d-c4b3-5bf5-9426-a87a579b03c1"] :knowledge-point/questions ["q-333214"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-21596"] :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=4x(t) \\\\ {y}^{′}(t)=-6y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/040ac76a28687db1c99d3379242b726a85aa4baf269a7c6d35d9662af1d3bd78.png)" :question/worked-solution "Writing our system in matrix form, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/2ee58da2733a468406869e43f57deebc6f7924f1d1149c0ca9391ea9995d9f87.png)\nwhere ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/83596c7f3038e585eb35ffafc966810e6891b55fc4d1efb04494bdc4b3755b05.png)\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue $\\lambda_1=4$ with the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/af5b69c599a13a707365e88f6f50939064c7b199a1d8231b32a1c88e425440fa.png)\n\n- Eigenvalue $\\lambda_2=-6$ with the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/833ce06c0c6d5f9beea87a84ef1b286748472c312987e837ca6f47f60225b1fa.png)\n\nThe general solution of the system is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/fb015d0935718dd6ffdfb9eb13b2b8fd0c255c63a2f5cecdb988a3f83df14685.png)\n\nNow, notice that:\n\n- The straight-line solutions of the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/03f2711cb5a80e1e94f879bf8a68c25db27f8280f5e1e344425f9ee2a334a829.png)\nlie on the $x$-axis. Since $e^{4t} \\to \\infty$ as $t \\to \\infty,$ these solutions approach infinity as $t \\to \\infty.$\n\n- The straight-line solutions of the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/bd4d36cd68896e6360317a0c01c92841423020218436d85ae07eb413463fffa8.png)\nlie on the $y$-axis. Since $e^{-6t} \\to 0$ as $t \\to \\infty,$ these solutions approach the origin as $t \\to \\infty.$\n\nAmong the given options, the only phase portrait satisfying these conditions is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/91c074766b92790a0e78b768b0290d7723617d6ed30e51e842501cad63e58a44.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21597"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/25d4f77a3f596202229581e06d88a9e3bdd84dc6b8b7e14b6f46b3b3d2f125d2.png)\n\nConsider the phase portrait for a decoupled system above.\nWhich of the following systems could correspond to the given portrait?\n\n- ${\\begin{aligned}{x}^{′}(t)=-5x(t) \\\\ {y}^{′}(t)=6y(t)\\end{aligned}$\n\n- ${\\begin{aligned}{x}^{′}(t)=5x(t) \\\\ {y}^{′}(t)=6y(t)\\end{aligned}$\n\n- ${\\begin{aligned}{x}^{′}(t)=5x(t) \\\\ {y}^{′}(t)=-6y(t)\\end{aligned}$\n\n- ${\\begin{aligned}{x}^{′}(t)=-5x(t) \\\\ {y}^{′}(t)=-6y(t)\\end{aligned}$" :question/worked-solution "Writing a decoupled system in matrix form, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/343f6f32ac21a1bf06b86174734dd9ebba6ddb7598cbe83b4ade59f70e8e8b26.png)\nwhere ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/cb0f32e55af289452f1429ddfe3214a46501c55f3a61deaf10b4f736e47dca7f.png)\n\nSince our system is decoupled, its eigenvectors are parallel to the axes. These correspond to so-called straight-line solutions of the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/85fdb4fc83a6f2b44178be2e97a0e7985d97350deb4e0fb123e513a80090906a.png)\n\nNow, notice that:\n\n- The tangents along the $x$-axis are pointing toward the origin, meaning that the solutions of the form \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/3f984a493e976bd522455395defcb4c1562d61ca56e19fa27e2272832ce6011c.png)\nmust approach the origin as $t \\to \\infty.$ So, we must have $\\lambda_1 < 0.$\n\n- The tangents along the $y$-axis are also pointing toward the origin, meaning that the solutions of the form \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/44f82894493c95c38039bc1e6a842bb7226571e9818e3c10c50d33627464ea37.png)\nmust also approach the origin as $t \\to \\infty.$ So, we must have $\\lambda_2 < 0.$\n\nAmong the options, the only system that satisfies $\\lambda_1 < 0$ and $\\lambda_2 < 0$ is the following:\n\n$$\n{\\begin{aligned}{x}^{′}(t)=-5x(t) \\\\ {y}^{′}(t)=-6y(t)\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21633"] :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-x(t) \\\\ {y}^{′}(t)=-4y(t)\\end{aligned}\n$$\n\nWhich of the following could represent the phase portrait of the decoupled system above?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/470210fb9509e87c3e51a990bac7483e5862d2f37afdce9823279838e8391592.png)" :question/worked-solution "Writing our system in matrix form, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/703fb7adc0ca076e42aecc781d4d0dc58eb5f4fec03db4d18bf5a36f7055a349.png)\nwhere ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/7210186106fc202e3b9a35ffa32b06b09493ce28c191a89c2824a35a547febff.png)\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue $\\lambda_1=-1$ with the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/f292220b15ff9b0d695cb8b9f2349cc275557fd2b77c32c147e25365ab0f7e47.png)\n\n- Eigenvalue $\\lambda_2=-4$ with the corresponding eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/5671487738e750f488ad61852f17fb4b6b14cf4050fee66338000d4939914ce6.png)\n\nThe general solution of the system is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/651cc55c8b96c402fc00140c06736493e71276666ce4eb1ba74c2294600a1b89.png)\n\nNow, notice that:\n\n- The straight-line solutions of the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/222dcd944fc89cd0f07970cddf5c50aa167c7f2d25b1f7305779c3dbb0a4a6af.png)\nlie on the $x$-axis. Since $e^{-t} \\to 0$ as $t \\to \\infty,$ these solutions approach the origin as $t \\to \\infty.$\n\n- The straight-line solutions of the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/08ad54b92f62513fb88f12f7bd6da358263e46673d686e0982a1e8044b8ab131.png)\nlie on the $y$-axis. Since $e^{-4t} \\to 0$ as $t \\to \\infty,$ these solutions also approach the origin as $t \\to \\infty.$\n\nAmong the given options, there are two phase portraits satisfying these conditions:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/c5b1aa6ccde39c56b503e2d59a56e2ac8058b08495567f4e2cb40f6a056faedd.png)\n\nLet's consider the solutions $x(t) = c_1e^{-t}$ and $y(t)=c_2e^{-4t}$ provided that $c_1,c_2 \\neq 0.$ Then,\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}=\\frac{{y}^{′}(t)}{{x}^{′}(t)}=\\frac{({c}_{2}{e}^{-4t})^{′}}{({c}_{1}{e}^{-t})^{′}}=\\frac{-4{c}_{2}{e}^{-4t}}{-{c}_{1}{e}^{-t}}=\\frac{4{c}_{2}}{{c}_{1}}{e}^{-3t}.\\end{aligned}\n$$\n\nSo, $\\dfrac{\\text{d}y}{\\text{d}x} \\to 0$ as $t \\to \\infty,$ meaning that the tangents to the solution become more and more horizontal as the trajectories approach the origin. This corresponds to the following phase portrait:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/6c3af2fe68c4bcddbbfd9f13eb84e73014511374c0adc570084f9c92773d31e0.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21607"] :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=4y(t)\\end{aligned}\n$$\n\nInterpret the stability of the $x$-axis, the $y$-axis, and the equilibrium point (the origin) for the given decoupled system of linear differential equations." :question/worked-solution "Writing our system in matrix form, we have\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/7f53fdda091242e4fee1edd70a7e96c649eff8bac93fcdc9fed6da38ec5c7523.png)\nwhere ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/3b9909cba711a2394b8dbcda4b9d72ffbd9d37bd24b90506ac22b44c4cd398c4.png)\n\nRecall that a homogeneous system of linear differential equations has a single equilibrium (fixed point) at the origin.\n\nSince our system is decoupled, its eigenvectors are the following:\n\n- Eigenvalue $\\lambda_1=2$ with the eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/1ea46da3e9697ee89d1112dfec53457657271c391a28a6c55267da70d38157c4.png) The corresponding straight-line solutions of the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/9725d696549426d16093b7cd0e9bb188589472ed9ff81520c19a07ab296fb96d.png)\nlie on the $x$-axis and move away from the origin as $t \\to \\infty.$ So, the $x$-axis is the $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{unstable}}$ line.\n\n- Eigenvalue $\\lambda_2=4$ with the eigenvector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/85e8d745e2b504770815bb92ad1a151f422c941874f33840593836e78eeaacde.png) The corresponding straight-line solutions of the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/2f67b02cda725daa0d0b994f3f4952065793e53ddc32260b14310f5158876f4f.png)\nlie on the $y$-axis and also move away from the origin as $t \\to \\infty.$ So, the $y$-axis is the $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{unstable}}$ line.\n\nTherefore, the equilibrium point (origin) is $\\bbox[4pt, border: solid 1pt gainsboro]{\\text{an unstable node (source)}}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069185/assets/2b79201d15fe5d2a9896cdee09c0474b97bb933d75fcf478c6fdb37cb4d16742.png)" :db/ensure [:question/validate]}]
