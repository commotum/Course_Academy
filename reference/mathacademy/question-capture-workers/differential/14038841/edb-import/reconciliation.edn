ademy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102558" "field" nil "attribute" "question/worked-solution" "value" "Multiplying both sides of the given equality by $({x}^{2}+5)(x-2)$ gives\n\n$$\n\\begin{aligned}5{x}^{2}-5x+17 & =(Ax-1)(x-2)+3({x}^{2}+5).\\end{aligned}\n$$\n\nLetting $x=1$  gives\n\n$$\n\\begin{aligned}5(1)^{2}-5(1)+17 & =(A(1)-1)(1-2)+3({1}^{2}+5) \\\\ 17 & =(A-1)(-1)+3(6) \\\\ 17 & =-A+1+18 \\\\ -2 & =-A \\\\ A & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102558" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-102558" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102558" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-4"] ["math" "1"] ["math" "2"] ["math" "3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102558" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102560" "field" nil "attribute" "question/problem" "value" "Given that \n\n$$\n\\frac{5{x}^{2}-5x+12}{(2{x}^{2}+3)(x-3)}=\\frac{x+B}{2{x}^{2}+3}+\\frac{2}{x-3},\n$$\n\nwhat is the value of $B?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102560" "field" nil "attribute" "question/worked-solution" "value" "Multiplying both sides of the given equality by $(2{x}^{2}+3)(x-3)$ gives\n\n$$\n\\begin{aligned}5{x}^{2}-5x+12 & =(x+B)(x-3)+2(2{x}^{2}+3).\\end{aligned}\n$$\n\nLetting $x=0$ gives\n\n$$\n\\begin{aligned}5(0)^{2}-5(0)+12 & =(0+B)(0-3)+2(2(0)^{2}+3) \\\\ 12 & =-3B+6 \\\\ 6 & =-3B \\\\ B & =-2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102560" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-102560" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102560" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-3"] ["math" "-5"] ["math" "1"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102560" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" nil "attribute" "question/problem" "value" "Express $\\frac{5}{({x}^{2}+4)(x+2)}$ as a sum of partial fractions.\n\n| $\\frac{5}{({x}^{2}+4)(x+2)}=\\,$ | {{field-1}}$\\,x\\,+$\n{{field-2}} | $+$ | {{field-3}} |\n| --- | --- | --- | --- |\n|  | $8({x}^{2}+4)$ |  | $8(x+2)$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A$, $B$, and $C$ such that\n\n$$\n\\begin{aligned}\\frac{5}{({x}^{2}+4)(x+2)}=\\frac{Ax+B}{{x}^{2}+4}+\\frac{C}{x+2}.\\end{aligned}\n$$\n\nMultiplying both sides by $({x}^{2}+4)(x+2)$ gives\n\n$$\n5=(Ax+B)(x+2)+C({x}^{2}+4).\n$$\n\nFor $x=-2$, we get\n\n$$\n\\begin{aligned}5 & =C(4+4) \\\\ 5 & =8C \\\\ C & =\\frac{5}{8}.\\end{aligned}\n$$\n\nFor $x=0$, we get\n\n$$\n\\begin{aligned}5 & =(A(0)+B)(0+2)+\\frac{5}{8}((0)^{2}+4) \\\\ 5 & =2B+\\frac{5}{2} \\\\ 2B & =\\frac{5}{2} \\\\ B & =\\frac{5}{4}.\\end{aligned}\n$$\n\nFor $x=1$, we get\n\n$$\n\\begin{aligned}5 & =(A(1)+\\frac{5}{4})(1+2)+\\frac{5}{8}((1)^{2}+4) \\\\ 5 & =3A+\\frac{15}{4}+\\frac{25}{8} \\\\ 3A & =-\\frac{15}{8} \\\\ A & =-\\frac{5}{8}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\frac{5}{({x}^{2}+4)(x+2)} & =\\frac{(-\\frac{5}{8}x+\\frac{5}{4})}{{x}^{2}+4}+\\frac{(\\frac{5}{8})}{x+2} \\\\  & =\\frac{-5\\,x+10}{8({x}^{2}+4)}+\\frac{5}{8(x+2)}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-346957" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-346957" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-49718" "field" nil "attribute" "question/problem" "value" "Given that\n\n$$\n\\frac{5}{({x}^{2}+1)(x+2)}=\\frac{Ax+B}{{x}^{2}+1}+\\frac{C}{x+2},\n$$\n\nwhere $A,$ $B$ and $C$ are real constants, determine the value of $A+B+C.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-49718" "field" nil "attribute" "question/worked-solution" "value" "We multiply both sides of the given equality by $({x}^{2}+1)(x+2)$ and get\n\n$$\n5=(Ax+B)(x+2)+C({x}^{2}+1).\n$$\n\nPlugging in $x=-2$ eliminates the $A$ and $B$ terms and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}5 & =(A(-2)+B)(-2+2)+C((-2)^{2}+1) \\\\ 5 & =5C \\\\ C & =1.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}5 & =(A(0)+B)(0+2)+(1)({0}^{2}+1) \\\\ 5 & =2B+1 \\\\ 2B & =4 \\\\ B & =2.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=1$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}5 & =(A(1)+2)(1+2)+1({1}^{2}+1) \\\\ 5 & =(A+2)(3)+2 \\\\ 3A+6 & =3 \\\\ 3A & =-3 \\\\ A & =-1.\\end{aligned}\n$$\n\nSo we have $A=-1,B=2,$ and $C=1.$ Therefore, our final result is\n\n$$\nA+B+C=-1+2+1=2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-49718" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-49718" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-49718" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-3"] ["math" "0"] ["math" "1"] ["math" "2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-49718" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-51144" "field" nil "attribute" "question/problem" "value" "Given that \n\n$$\n\\frac{5{x}^{2}+x+3}{({x}^{2}+1)x}=\\frac{Ax+1}{{x}^{2}+1}+\\frac{3}{x},\n$$\n\nwhat is the value of $A?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-51144" "field" nil "attribute" "question/worked-solution" "value" "Multiplying both sides of the given equality by $({x}^{2}+1)x$ gives\n\n$$\n\\begin{aligned}5{x}^{2}+x+3 & =(Ax+1)x+3({x}^{2}+1).\\end{aligned}\n$$\n\nLetting $x=1$  gives\n\n$$\n\\begin{aligned}5(1)^{2}+1+3 & =(A(1)+1)(1)+3({1}^{2}+1) \\\\ 9 & =(A+1)+3(2) \\\\ 9 & =A+1+6 \\\\ A & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-51144" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-51144" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-51144" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "3"] ["math" "\\frac{1}{3}"] ["math" "\\frac{9}{7}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-51144" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11015" "field" nil "attribute" "question/problem" "value" "Express $\\frac{7{x}^{2}-28x+17}{({x}^{2}+1)(x-5)}$ as a sum of partial fractions." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11015" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\frac{7{x}^{2}-28x+17}{({x}^{2}+1)(x-5)}=\\frac{Ax+B}{({x}^{2}+1)}+\\frac{C}{(x-5)}.\n$$\n\nNote that since ${x}^{2}+1$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+1)(x-5)$ and get\n\n$$\n7{x}^{2}-28x+17=(Ax+B)(x-5)+C({x}^{2}+1).\n$$\n\nPlugging in $x=5$ eliminates $A$ and $B$ and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}7(5)^{2}-28(5)+17 & =(A(5)+B)(5-5)+C({5}^{2}+1) \\\\ 175-140+17 & =26C \\\\ 52 & =26C \\\\ C & =\\frac{52}{26} \\\\ C & =2.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}7(0)^{2}-28(0)+17 & =(A(0)+B)(0-5)+C({0}^{2}+1) \\\\ 17 & =-5B+C \\\\ 17 & =-5B+2 \\\\ 5B & =2-17 \\\\ B & =-\\frac{15}{5} \\\\ B & =-3.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=1$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}7(1)^{2}-28(1)+17 & =(A(1)+B)(1-5)+C({1}^{2}+1) \\\\ -4 & =-4A-4B+2C \\\\ -4 & =-4A-4(-3)+2(2) \\\\ 4A & =12+4+4 \\\\ A & =\\frac{20}{4} \\\\ A & =5.\\end{aligned}\n$$\n\nSo we have $A=5,$ $B=-3,$ and $C=2.$ Therefore, our final result is\n\n$$\n\\frac{7{x}^{2}-28x+17}{({x}^{2}+1)(x-5)}=\\frac{5x-3}{({x}^{2}+1)}+\\frac{2}{(x-5)}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11015" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-11015" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11015" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{2x+5}{({x}^{2}+1)}-\\frac{3}{(x-5)}"] ["math" "\\frac{3x+5}{({x}^{2}+1)}+\\frac{6}{(x-5)}"] ["math" "\\frac{4x+2}{({x}^{2}+1)}+\\frac{1}{(x-5)}"] ["math" "\\frac{5x-3}{({x}^{2}+1)}+\\frac{2}{(x-5)}"] ["math" "\\frac{x-8}{({x}^{2}+1)}+\\frac{5}{(x-5)}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11015" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5x-3}{({x}^{2}+1)}+\\frac{2}{(x-5)}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11007" "field" nil "attribute" "question/problem" "value" "Express $\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}$ as a sum of partial fractions." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11007" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)} & =\\frac{Ax+B}{({x}^{2}+11)}+\\frac{C}{(x-5)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+11$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+11)(x-5)$ and get\n\n$$\n{x}^{2}-22x-59=(Ax+B)(x-5)+C({x}^{2}+11).\n$$\n\nPlugging in $x=5$ eliminates $A$ and $B$ and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}{5}^{2}-22(5)-59 & =(A(5)+B)(5-5)+C({5}^{2}+11) \\\\ 25-110-59 & =36C \\\\ C & =-\\frac{144}{36} \\\\ C & =-4.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}(0)^{2}-22(0)-59 & =(A(0)+B)(0-5)+C({0}^{2}+11) \\\\ -59 & =-5B+11C \\\\ -59 & =-5B+11(-4) \\\\ 5B & =-44+59 \\\\ B & =\\frac{15}{5} \\\\ B & =3.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=1$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}(1)^{2}-22(1)-59 & =(A(1)+B)(1-5)+C({1}^{2}+11) \\\\ 1-22-59 & =-4A-4B+12C \\\\ -80 & =-4A-4(3)+12(-4) \\\\ 4A & =-12-48+80 \\\\ A & =\\frac{20}{4} \\\\ A & =5.\\end{aligned}\n$$\n\nSo we have $A=5,$ $B=3,$ and $C=-4.$ Therefore, our final result is\n\n$$\n\\frac{{x}^{2}-22x-59}{({x}^{2}+11)(x-5)}=\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11007" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-11007" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11007" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{2x+5}{({x}^{2}+11)}-\\frac{7}{(x-5)}"] ["math" "\\frac{3x+2}{({x}^{2}+11)}+\\frac{2}{(x-5)}"] ["math" "\\frac{4x+1}{({x}^{2}+11)}+\\frac{1}{(x-5)}"] ["math" "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}"] ["math" "\\frac{x+2}{({x}^{2}+11)}-\\frac{3}{(x-5)}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11007" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5x+3}{({x}^{2}+11)}-\\frac{4}{(x-5)}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102561" "field" nil "attribute" "question/problem" "value" "Express $\\frac{3{x}^{2}+2x-3}{({x}^{2}+6)(x+5)}$ as a sum of partial fractions." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102561" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{3{x}^{2}+2x-3}{({x}^{2}+6)(x+5)} & =\\frac{Ax+B}{({x}^{2}+6)}+\\frac{C}{(x+5)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+6$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+6)(x+5)$ and get\n\n$$\n3{x}^{2}+2x-3=(Ax+B)(x+5)+C({x}^{2}+6).\n$$\n\nPlugging in $x=-5$ eliminates $A$ and $B$ and allows us to solve for $C.$ We get\n\n$$\n\\begin{aligned}3(-5)^{2}+2(-5)-3 & =(A(-5)+B)(-5+5)+C((-5)^{2}+6) \\\\ 75-10-3 & =31C \\\\ C & =\\frac{62}{31} \\\\ C & =2.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}3(0)^{2}+2(0)-3 & =(A(0)+B)(0+5)+C((0)^{2}+6) \\\\ -3 & =5B+6C \\\\ -3 & =5B+6(2) \\\\ 5B & =-3-12 \\\\ B & =\\frac{-15}{5} \\\\ B & =-3.\\end{aligned}\n$$\n\nFinally, to solve for $A$ we choose $x=1$, and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}3(1)^{2}+2(1)-3 & =(A(1)+B)(1+5)+C((1)^{2}+6) \\\\ 2 & =6A+6B+7C \\\\ 2 & =6A+6(-3)+7(2) \\\\ 6A & =2+18-14 \\\\ A & =\\frac{6}{6} \\\\ A & =1.\\end{aligned}\n$$\n\nSo we have $A=1,B=-3,$ and $C=2.$ Therefore, our final result is\n\n$$\n\\frac{3{x}^{2}+2x-3}{({x}^{2}+6)(x+5)}=\\frac{x-3}{({x}^{2}+6)}+\\frac{2}{(x+5)}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102561" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/activity-metadata.json" "file_sha256" "ed8fcb99e086b7bf84ce4fbb31e5c955e257fb26c249ca1c04fbe58284e6a0c0"} {"question" "q-102561" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102561" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{2x-3}{({x}^{2}+6)}+\\frac{1}{(x+5)}"] ["math" "\\frac{2x-5}{({x}^{2}+6)}+\\frac{2}{(x+5)}"] ["math" "\\frac{x-2}{({x}^{2}+6)}+\\frac{4}{(x+5)}"] ["math" "\\frac{x-3}{({x}^{2}+6)}+\\frac{2}{(x+5)}"] ["math" "\\frac{x-4}{({x}^{2}+6)}+\\frac{5}{(x+5)}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-102561" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x-3}{({x}^{2}+6)}+\\frac{2}{(x+5)}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11014" "field" nil "attribute" "question/problem" "value" "Express $\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}$ as a sum of partial fractions." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11014" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)} & =\\frac{Ax+B}{({x}^{2}+2x+3)}+\\frac{C}{(x-1)}.\\end{aligned}\n$$\n\nNote that since ${x}^{2}+2x+3$ is an irreducible quadratic factor, we must use a linear term $Ax+B$ in the numerator.\n\nWe multiply both sides by $({x}^{2}+2x+3)(x-1)$ and get\n\n$$\n5{x}^{2}+2x+5=(Ax+B)(x-1)+C({x}^{2}+2x+3).\n$$\n\nPlugging in $x=1$ eliminates the $A$ and $B$ terms and allows us to solve for $C.$ We get \n\n$$\n\\begin{aligned}5(1)^{2}+2(1)+5 & =(A(1)+B)(1-1)+C((1)^{2}+2(1)+3) \\\\ 5+2+5 & =6C \\\\ C & =\\frac{12}{6} \\\\ C & =2.\\end{aligned}\n$$\n\nPlugging in $x=0$ eliminates the $A$ term, and using our result for $C$ allows us to solve for $B.$ We get \n\n$$\n\\begin{aligned}5({0}^{2})+2(0)+5 & =(A(0)+B)(0-1)+C({0}^{2}+2(0)+3) \\\\ 5 & =-B+3C \\\\ 5 & =-B+3(2) \\\\ B & =6-5 \\\\ B & =1.\\end{aligned}\n$$\n\nFinally, to solve for $A,$ we choose $x=2$ and use our results for $B$ and $C.$ We get\n\n$$\n\\begin{aligned}5(2)^{2}+2(2)+5 & =(A(2)+B)(2-1)+C({2}^{2}+2(2)+3) \\\\ 29 & =2A+B+11C \\\\ 29 & =2A+(1)+11(2) \\\\ 2A & =29-23 \\\\ A & =\\frac{6}{2} \\\\ A & =3.\\end{aligned}\n$$\n\nSo we have $A=3,B=1,$ and $C=2.$ Therefore, our final result is\n\n$$\n\\frac{5{x}^{2}+2x+5}{({x}^{2}+2x+3)(x-1)}=\\frac{3x+1}{({x}^{2}+2x+3)}+\\frac{2}{(x-1)}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038841/state.json" "file_sha256" "bf711482421f54e9c818febf4b0afb6df8de8acfcaa9776a38291db587e391ab"} {"question" "q-11014" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_c