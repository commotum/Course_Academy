[{:db/id "q-15654/selection/cb6a17a04ba5eae6e0c794d5ac38f8938677a06c05c39363db1e1c69ac77ae03" :answer/id #uuid "d829b1d0-26ac-537a-a3a8-3c05d90cd30b" :answer/type :answer.type/math :answer/value "y={x}^{2}(3+{x}^{2}),\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-15654/selection/860846f20883d0fc18abc7a5a1c4b5e294e5451da6665bec497454733795b8ee" :answer/id #uuid "3b9917f8-b1cf-5686-be81-1af99efb3395" :answer/type :answer.type/math :answer/value "y={x}^{2}(9-{x}^{2}),\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-15654/selection/12087971a20a2938eda79ec5fe8835e05352c29ce898e7a66b850b3d1fce3574" :answer/id #uuid "71127adc-667e-550b-b248-c0abc924c5b7" :answer/type :answer.type/math :answer/value "y=-x(3+{x}^{2}),\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-15654/selection/4100afb6fb8c4b65c355e7cfc75b500f8d1a92f868dbba1ee31c203de75692ca" :answer/id #uuid "833518fc-37c2-57e9-a716-f07028a9e874" :answer/type :answer.type/math :answer/value "y=2{x}^{2}(9-{x}^{2}),\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-15654/selection/2690498ea7b64b0c03e7e98543d454de4a4a1802acea03c137c9f5572374331b" :answer/id #uuid "639e7aab-4fe3-5266-a8d1-4e35fd7857ed" :answer/type :answer.type/math :answer/value "y=-2x(9-{x}^{2}),\\,x\\ge 0" :db/ensure [:answer/validate]} {:db/id "q-15654/selection" :answer-field/id #uuid "ce80652f-a751-5e0e-90b6-f70e7cd69140" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15654/selection/860846f20883d0fc18abc7a5a1c4b5e294e5451da6665bec497454733795b8ee" :answer-field/choices ["q-15654/selection/cb6a17a04ba5eae6e0c794d5ac38f8938677a06c05c39363db1e1c69ac77ae03" "q-15654/selection/860846f20883d0fc18abc7a5a1c4b5e294e5451da6665bec497454733795b8ee" "q-15654/selection/12087971a20a2938eda79ec5fe8835e05352c29ce898e7a66b850b3d1fce3574" "q-15654/selection/4100afb6fb8c4b65c355e7cfc75b500f8d1a92f868dbba1ee31c203de75692ca" "q-15654/selection/2690498ea7b64b0c03e7e98543d454de4a4a1802acea03c137c9f5572374331b"] :db/ensure [:answer-field/validate]} {:db/id "q-15654" :question/id #uuid "e6f3c3a1-9262-5890-9af4-1c1bf7604cd0" :question/math-academy-id "q-15654" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\sqrt{t},\\,\\,\\,y=t(9-t),\\,t\\ge 0.\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\sqrt{t}\\,⇒\\,t={x}^{2}\\end{aligned}\n$$\n\nNow, substituting $t={x}^{2}$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & ={x}^{2}(9-{x}^{2})\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y={x}^{2}(9-{x}^{2}).$\n\nFinally, since $t\\ge 0$ and $x=\\sqrt{t},$ we must have $x\\ge 0.$\n\nSo, the complete Cartesian equation is\n\n$$\ny={x}^{2}(9-{x}^{2}),\\,x\\ge 0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15654/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a"] :knowledge-point/questions ["q-15654"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15653/selection/fcc7515889837e6b727cae4ac51020fc5c4fb9d5ae0e2c515d2622a7e2395249" :answer/id #uuid "02f8094e-40bf-52a3-81b8-2f3b4a663eaa" :answer/type :answer.type/math :answer/value "y=2{x}^{2}-5x-12,\\,x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-15653/selection/ed3999a34614e46cb480a524506766c439ece73afd78c4396c574dcb2f8facfd" :answer/id #uuid "3bdc3ea1-71e5-528d-97c0-d0c2e57e8a4d" :answer/type :answer.type/math :answer/value "y=5{x}^{2}+x+2,\\,x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-15653/selection/448ece7ff1537bbe75fbf6d06a42be569c0afef6c677ed7f7e101d65493860df" :answer/id #uuid "0fd83642-b933-54a1-bfde-60a80cc4043a" :answer/type :answer.type/math :answer/value "y=-4{x}^{2}-2x+5,\\,x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-15653/selection/ee372d4f1c89b15a010a4d0d9eb37bcdbb0eaa987b622819fef2a2bec9abf89c" :answer/id #uuid "6884b9a6-3e6f-5da3-9301-fd9b18aa627f" :answer/type :answer.type/math :answer/value "y=-{x}^{2}+10x-24,\\,x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-15653/selection/fb72647eaaa8b574615ee5b4c93f1807831d30251a4132cb0e163d69232e6d48" :answer/id #uuid "32a5cbe1-f264-5f8f-8622-a31d47a2d486" :answer/type :answer.type/math :answer/value "y={x}^{2}-10x+24,\\,x\\in (-\\infty ,\\infty )" :db/ensure [:answer/validate]} {:db/id "q-15653/selection" :answer-field/id #uuid "a36a3d15-0cf4-5e08-87fa-99ae2e72c7af" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15653/selection/fb72647eaaa8b574615ee5b4c93f1807831d30251a4132cb0e163d69232e6d48" :answer-field/choices ["q-15653/selection/fcc7515889837e6b727cae4ac51020fc5c4fb9d5ae0e2c515d2622a7e2395249" "q-15653/selection/ed3999a34614e46cb480a524506766c439ece73afd78c4396c574dcb2f8facfd" "q-15653/selection/448ece7ff1537bbe75fbf6d06a42be569c0afef6c677ed7f7e101d65493860df" "q-15653/selection/ee372d4f1c89b15a010a4d0d9eb37bcdbb0eaa987b622819fef2a2bec9abf89c" "q-15653/selection/fb72647eaaa8b574615ee5b4c93f1807831d30251a4132cb0e163d69232e6d48"] :db/ensure [:answer-field/validate]} {:db/id "q-15653" :question/id #uuid "f4b8d660-3a86-5682-af7d-01dd831d3e28" :question/math-academy-id "q-15653" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=5-t,\\,\\,\\,y={t}^{2}-1,\\,t\\in (-\\infty ,\\infty ).\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=5-t\\,⇒\\,t=5-x\\end{aligned}\n$$\n\nNow, substituting $t=5-x$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =(5-x)^{2}-1 \\\\  & =25-10x+{x}^{2}-1 \\\\  & ={x}^{2}-10x+24\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y={x}^{2}-10x+24.$\n\nFinally, since $t\\in (-\\infty ,\\infty )$ and $x=5-t,$ we must have $x\\in (-\\infty ,\\infty ).$\n\nSo, the complete Cartesian equation is\n\n$$\ny={x}^{2}-10x+24,\\,x\\in (-\\infty ,\\infty ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15653/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a"] :knowledge-point/questions ["q-15653"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321075/field-1/0ce7b22818a4e3530feff228a03f3a14d5fc7309188f52269eb723e0a405e86b" :answer/id #uuid "1af3b780-36c3-519d-8257-c8d055f0cf0c" :answer/type :answer.type/math :answer/value "-32x(1-2x)^3" :db/ensure [:answer/validate]} {:db/id "q-321075/field-1" :answer-field/id #uuid "ce15f979-8df4-5af1-afec-e04d8ac4a855" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321075/field-1/0ce7b22818a4e3530feff228a03f3a14d5fc7309188f52269eb723e0a405e86b" :answer-field/choices ["q-321075/field-1/0ce7b22818a4e3530feff228a03f3a14d5fc7309188f52269eb723e0a405e86b"] :db/ensure [:answer-field/validate]} {:db/id "q-321075" :question/id #uuid "c024990d-5c3f-5250-a9bf-94a1cfb26955" :question/math-academy-id "q-321075" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{1-t}{4},\\,\\,\\,y=({t}^{2}-1)(1+t)^{2},\\,t\\in (-\\infty ,\\infty ).\n$$\n\n$y=$\n{{field-1}}." :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{1-t}{4}\\,⇒\\,t=1-4x\\end{aligned}\n$$\n\nNow, substituting $t=1-4x$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((1-4x)^{2}-1)((1+(1-4x))^{2}) \\\\  & =(1-8x+16{x}^{2}-1)((2-4x)^{2}) \\\\  & =(-8x+16{x}^{2})(4)(1-2x)^{2} \\\\  & =8x(2x-1)(2-4x)^{2} \\\\  & =8x(2x-1)\\cdot 4(1-2x)^{2} \\\\  & =32x(2x-1)^{3}.\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=32x(2x-1)^{3}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-321075/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a"] :knowledge-point/questions ["q-321075"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321074/field-1/8f628e2782ab7e2a0c72e106017feab16e0aa92ac1d1ab14a2337421fee25d50" :answer/id #uuid "b77ea1a3-0a9b-5e4c-9285-4d6023de34ac" :answer/type :answer.type/math :answer/value "(3x-3)(3x+1)(2-3x)^3" :db/ensure [:answer/validate]} {:db/id 17592186285381 :answer-field/choices ["q-321074/field-1/8f628e2782ab7e2a0c72e106017feab16e0aa92ac1d1ab14a2337421fee25d50"] :db/ensure [:answer-field/validate]} {:db/id "q-15677/selection/f111faa633cea7a85f15c9daa739b18548df93fd66ca5ea5a79de28bfb3e32a2" :answer/id #uuid "ea597a22-e2fb-508b-972c-2ec95d482354" :answer/type :answer.type/math :answer/value "y=\\frac{x}{1-3x},\\,x\\ne 0,\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-15677/selection/0501d66da41d2be52f93d3f6ae4858bb22ceade85cb84eb7c8ab4a8e54b43eac" :answer/id #uuid "567bd9d4-769a-5520-8bf8-0b8331e1f837" :answer/type :answer.type/math :answer/value "y=\\frac{x}{1-x},\\,\\,x\\ne 0,\\,1" :db/ensure [:answer/validate]} {:db/id "q-15677/selection/4f9af4d0efec132383a12918b572a5d1c3a9d932a71543652002386d5af306ca" :answer/id #uuid "93f17a52-1741-5199-bb8e-083d85ba8c5c" :answer/type :answer.type/math :answer/value "y=\\frac{x}{1+x},\\,\\,x\\ne -1,\\,0" :db/ensure [:answer/validate]} {:db/id "q-15677/selection/ba12924aa7d69c88e53681c4aeb850aa0164eed8a6771b1dad71c6dc1372c3d0" :answer/id #uuid "f0e8f1e6-b2a9-5cb9-80bc-0eaa3b79907d" :answer/type :answer.type/math :answer/value "y=\\frac{3x}{1+2x},\\,x\\ne -\\frac{1}{2},\\,0" :db/ensure [:answer/validate]} {:db/id "q-15677/selection/c689af25c777faf431f3719567ebf3597cee670ec3fc1d8e48e39b245b8de2b1" :answer/id #uuid "8d2e3ece-40a8-535e-81a3-05d4eef9a6ce" :answer/type :answer.type/math :answer/value "y=\\frac{3x}{1-2x},\\,x\\ne 0,\\,\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-15677/selection" :answer-field/id #uuid "b5db3627-143e-50d1-b347-6643f8b22217" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15677/selection/f111faa633cea7a85f15c9daa739b18548df93fd66ca5ea5a79de28bfb3e32a2" :answer-field/choices ["q-15677/selection/f111faa633cea7a85f15c9daa739b18548df93fd66ca5ea5a79de28bfb3e32a2" "q-15677/selection/0501d66da41d2be52f93d3f6ae4858bb22ceade85cb84eb7c8ab4a8e54b43eac" "q-15677/selection/4f9af4d0efec132383a12918b572a5d1c3a9d932a71543652002386d5af306ca" "q-15677/selection/ba12924aa7d69c88e53681c4aeb850aa0164eed8a6771b1dad71c6dc1372c3d0" "q-15677/selection/c689af25c777faf431f3719567ebf3597cee670ec3fc1d8e48e39b245b8de2b1"] :db/ensure [:answer-field/validate]} {:db/id "q-15677" :question/id #uuid "563cbbce-ad5c-5e6f-8f8d-ab3af5a6315e" :question/math-academy-id "q-15677" :question/problem "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{1}{t+1},\\,\\,\\,y=\\frac{1}{t-2},\\,t\\ne -1,\\,2.\n$$" :question/worked-solution "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{1}{t+1}\\,⇒\\,t=\\frac{1}{x}-1\\end{aligned}\n$$\n\nNow substituting $t=\\frac{1}{x}-1$ into our expression for $y$, we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{((\\frac{1}{x}-1)-2)} \\\\ y & =\\frac{1}{(\\frac{1}{x}-3)} \\\\ y & =\\frac{1}{(\\frac{1-3x}{x})} \\\\ y & =\\frac{x}{1-3x}\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=\\frac{x}{1-3x}.$\n\nFinally, since $t\\ne -1,\\,2$ and $x=\\frac{1}{t+1},$ we must have $x\\ne 0,\\,\\frac{1}{3}.$\n\nSo, the complete Cartesian equation is\n\n$$\ny=\\frac{x}{1-3x},\\,x\\ne 0,\\,\\frac{1}{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-15677/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "79107609-77e6-55e9-970d-da63c39daf0a"] :knowledge-point/questions ["q-15677"] :db/ensure [:knowledge-point/validate]} {:db/id "q-24576/selection/6847d31ff447b8962381a426137884542698992c84981d0590fc44f82c05685f" :answer/id #uuid "b806830b-01c1-5815-b667-6de6e14cfc1b" :answer/type :answer.type/math :answer/value "y=\\frac{1}{5}-{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-24576/selection/2e52edbdb120f4c5a0120f227d4c96b6cad4b0030cacf9c60939f725626d9c3e" :answer/id #uuid "3d9325d7-f550-5c59-88d7-8ff8a9233ce3" :answer/type :answer.type/math :answer/value "y=5+{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-24576/selection/caa1669edb6ce00a052d4322a5e201f72886bc9b8a9f6218e52af5ef9ac5549f" :answer/id #uuid "9ce38dcf-0d4f-57ad-abc3-15b67f37213c" :answer/type :answer.type/math :answer/value "y=1+\\frac{5{x}^{2}}{6}" :db/ensure [:answer/validate]} {:db/id "q-24576/selection/407561d211a591531150751b4fa8ce73cdc29d40f50546126262d1fa7fe7713c" :answer/id #uuid "b87282ce-139d-532c-be53-6935258cb3e3" :answer/type :answer.type/math :answer/value "y=-18+\\frac{{x}^{2}}{5}" :db/ensure [:answer/validate]} {:db/id "q-24576/selection/114724711997e07700c218892562a4444c767d9ffd34473bb4fd05ade52004af" :answer/id #uuid "e4c7c790-d016-564e-8f2a-a689ca3b0dd7" :answer/type :answer.type/math :answer/value "y=-5+\\frac{5{x}^{2}}{18}" :db/ensure [:answer/validate]} {:db/id "q-24576/selection" :answer-field/id #uuid "46c96509-f5e7-56e3-8067-f632bbdd7285" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-24576/selection/114724711997e07700c218892562a4444c767d9ffd34473bb4fd05ade52004af" :answer-field/choices ["q-24576/selection/6847d31ff447b8962381a426137884542698992c84981d0590fc44f82c05685f" "q-24576/selection/2e52edbdb120f4c5a0120f227d4c96b6cad4b0030cacf9c60939f725626d9c3e" "q-24576/selection/caa1669edb6ce00a052d4322a5e201f72886bc9b8a9f6218e52af5ef9ac5549f" "q-24576/selection/407561d211a591531150751b4fa8ce73cdc29d40f50546126262d1fa7fe7713c" "q-24576/selection/114724711997e07700c218892562a4444c767d9ffd34473bb4fd05ade52004af"] :db/ensure [:answer-field/validate]} {:db/id "q-24576" :question/id #uuid "f6300777-605f-507f-978f-04a8f9538fa9" :question/math-academy-id "q-24576" :question/problem "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=6\\operatorname{sin}⁡t,\\,\\,\\,y=-5\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=6\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{6} \\\\ y=-5\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=-\\frac{y}{5}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & =(1-{sin}^{2}⁡t)-{sin}^{2}⁡t \\\\  & =1-2{sin}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡t=\\frac{x}{6}$ and $\\operatorname{cos}⁡2t=-\\frac{y}{5}$ into this formula, we get\n\n$$\n\\begin{aligned}-\\frac{y}{5} & =1-2{(\\frac{x}{6})}^{2} \\\\ -\\frac{y}{5} & =1-2(\\frac{{x}^{2}}{36}) \\\\ -\\frac{y}{5} & =1-\\frac{{x}^{2}}{18} \\\\ y & =-5+\\frac{5{x}^{2}}{18}.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=-5+\\frac{5{x}^{2}}{18}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-24576/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896"] :knowledge-point/questions ["q-24576"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102687/selection/0d603bde71e2a9000bf98123bcf56c67a51ca6ca4a5051c973ad9b3e39750c15" :answer/id #uuid "9c9bdda6-72e2-56ab-ad61-6fb1c887a147" :answer/type :answer.type/math :answer/value "y=\\frac{\\sqrt{1-{x}^{2}}}{2x}" :db/ensure [:answer/validate]} {:db/id "q-102687/selection/f3d8ad6cc420430838976157f30364a792175ed452e365a674ee2860455787ac" :answer/id #uuid "cb9f7b51-1cf0-51e9-8432-b994b253edbf" :answer/type :answer.type/math :answer/value "y=\\frac{1-{x}^{2}}{2x}" :db/ensure [:answer/validate]} {:db/id "q-102687/selection/2d4c5218b689f51cc37fdea8a39c2552803a1c2450a96080eccc23db3fcee820" :answer/id #uuid "19f54f1d-e824-51ed-a708-863820445e0c" :answer/type :answer.type/math :answer/value "y=\\sqrt{1-{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-102687/selection/06f794ab8b38cdc5eba00ecbf23f24a7bf5f5e276b426b3312b23bc6f01e639a" :answer/id #uuid "cf1509d9-45c6-55be-96b2-ecd94d43aab8" :answer/type :answer.type/math :answer/value "y=\\frac{1-{x}^{2}}{x}" :db/ensure [:answer/validate]} {:db/id "q-102687/selection/cb15c8fc6daf09c76ff37a426d0bbb8bdc959ef88af70e593cc72258b54d797a" :answer/id #uuid "7d6b90c3-39cf-5897-ac2d-cb9f6b6d52b6" :answer/type :answer.type/math :answer/value "y=\\frac{\\sqrt{1-{x}^{2}}}{x}" :db/ensure [:answer/validate]} {:db/id "q-102687/selection" :answer-field/id #uuid "b903b087-ccd3-56b3-8084-f93deb93fe48" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102687/selection/cb15c8fc6daf09c76ff37a426d0bbb8bdc959ef88af70e593cc72258b54d797a" :answer-field/choices ["q-102687/selection/0d603bde71e2a9000bf98123bcf56c67a51ca6ca4a5051c973ad9b3e39750c15" "q-102687/selection/f3d8ad6cc420430838976157f30364a792175ed452e365a674ee2860455787ac" "q-102687/selection/2d4c5218b689f51cc37fdea8a39c2552803a1c2450a96080eccc23db3fcee820" "q-102687/selection/06f794ab8b38cdc5eba00ecbf23f24a7bf5f5e276b426b3312b23bc6f01e639a" "q-102687/selection/cb15c8fc6daf09c76ff37a426d0bbb8bdc959ef88af70e593cc72258b54d797a"] :db/ensure [:answer-field/validate]} {:db/id "q-102687" :question/id #uuid "b89cfc2a-8e7d-5178-aba5-ef09172b413a" :question/math-academy-id "q-102687" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{cos}⁡t,\\,\\,\\,y=\\operatorname{tan}⁡t,\\,0<t<\\frac{\\pi }{2}.\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=x \\\\ y=\\operatorname{tan}⁡t\\, & ⇒\\,\\operatorname{tan}⁡t=y\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n\\begin{aligned}{sin}^{2}⁡t+{cos}^{2}⁡t & =1 \\\\ {sin}^{2}⁡t & =1-{cos}^{2}⁡t \\\\ \\operatorname{sin}⁡t & =\\sqrt{1-{cos}^{2}⁡t}.\\end{aligned}\n$$\n\nWe used here that $\\operatorname{sin}⁡t>0$ in the range $0<t<\\frac{\\pi }{2}.$\n\nNow, using the definition of a tangent, we obtain\n\n$$\n\\operatorname{tan}⁡t=\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}=\\frac{\\sqrt{1-{cos}^{2}⁡t}}{\\operatorname{cos}⁡t}.\n$$\n\nSubstituting $\\operatorname{cos}⁡t=x$ and $\\operatorname{tan}⁡t=y$ into this formula, we get\n\n$$\ny=\\frac{\\sqrt{1-{x}^{2}}}{x}.\n$$\n\nSo the Cartesian equation of the given curve is $y=\\frac{\\sqrt{1-{x}^{2}}}{x}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102687/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896"] :knowledge-point/questions ["q-102687"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15657/selection/4ee8cb5efa4aec55bac9681490281a71cdc7bc5d921ec8fbd19e3dd0ece0c9e6" :answer/id #uuid "94bb46a3-ebab-5ca7-b8c6-b355e2600d21" :answer/type :answer.type/math :answer/value "{x}^{2}+{y}^{2}=3" :db/ensure [:answer/validate]} {:db/id "q-15657/selection/f95e7191e4c66e8d0e1b28872ade8f7ac8de26a24a171a181e043a9586e6f8df" :answer/id #uuid "e5a1ba09-26f6-53e7-9178-130dbcd2c0cf" :answer/type :answer.type/math :answer/value "(x+3)^{2}+{y}^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-15657/selection/24d604b9d369e49e01e3ed31750eb413e90707e143aab569d7d270d33cc4cf1c" :answer/id #uuid "f87de581-41ff-5ae5-87a1-e327c0722145" :answer/type :answer.type/math :answer/value "(x-3)^{2}+(y-3)^{2}=3" :db/ensure [:answer/validate]} {:db/id "q-15657/selection/0d05a8573caf13c7666889e9271e0a9aa2eca62be29470e2ec0053eb77c0c7c5" :answer/id #uuid "3a19bcd5-75fd-56e9-b93c-1f0f33097874" :answer/type :answer.type/math :answer/value "{x}^{2}+(y-3)^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-15657/selection/9ec41e7c0c15f83005d467aadd696ce65813b3ce091d45246d9bc7a1659955d5" :answer/id #uuid "5eafc569-c09a-5b83-b176-cad75ab16314" :answer/type :answer.type/math :answer/value "3{x}^{2}+{y}^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-15657/selection" :answer-field/id #uuid "d587d9eb-47a2-5b16-9a07-604038e8c3ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15657/selection/f95e7191e4c66e8d0e1b28872ade8f7ac8de26a24a171a181e043a9586e6f8df" :answer-field/choices ["q-15657/selection/4ee8cb5efa4aec55bac9681490281a71cdc7bc5d921ec8fbd19e3dd0ece0c9e6" "q-15657/selection/f95e7191e4c66e8d0e1b28872ade8f7ac8de26a24a171a181e043a9586e6f8df" "q-15657/selection/24d604b9d369e49e01e3ed31750eb413e90707e143aab569d7d270d33cc4cf1c" "q-15657/selection/0d05a8573caf13c7666889e9271e0a9aa2eca62be29470e2ec0053eb77c0c7c5" "q-15657/selection/9ec41e7c0c15f83005d467aadd696ce65813b3ce091d45246d9bc7a1659955d5"] :db/ensure [:answer-field/validate]} {:db/id "q-15657" :question/id #uuid "9d6247c7-93e8-5757-8717-e162c7d262b7" :question/math-academy-id "q-15657" :question/problem "Find the Cartesian equation of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t-3,\\,\\,\\,y=\\operatorname{cos}⁡t,\\,t\\in [0,2\\pi ).\n$$" :question/worked-solution "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{sin}⁡t-3\\, & ⇒\\,\\operatorname{sin}⁡t=x+3 \\\\ y=\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=y.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n(x+3)^{2}+{y}^{2}=1.\n$$\n\nSo the Cartesian equation of the given curve is $(x+3)^{2}+{y}^{2}=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15657/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "78dbecb4-68d4-53b0-b47f-f37ce92da896"] :knowledge-point/questions ["q-15657"] :db/ensure [:knowledge-point/validate]}]
