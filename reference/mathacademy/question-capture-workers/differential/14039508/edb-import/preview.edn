34677 true] [17592186302853 1145 "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=\\operatorname{sin}⁡t-3\\, & ⇒\\,\\operatorname{sin}⁡t=x+3 \\\\ y=\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=y.\\end{aligned}\n$$\n\nUsing the Pythagorean identity ${sin}^{2}⁡t+{cos}^{2}⁡t=1$, we get\n\n$$\n(x+3)^{2}+{y}^{2}=1.\n$$\n\nSo the Cartesian equation of the given curve is $(x+3)^{2}+{y}^{2}=1.$" 13194139534677 true] [17592186302854 1000 #edb/ref 17592186302855 13194139534677 true] [17592186302854 1000 #edb/ref 17592186302856 13194139534677 true] [17592186302854 1000 #edb/ref 17592186302857 13194139534677 true] [17592186302854 1000 #edb/ref 17592186302858 13194139534677 true] [17592186302854 1000 #edb/ref 17592186302859 13194139534677 true] [17592186302854 1040 #edb/ref 17592186045450 13194139534677 true] [17592186302854 1041 "selection" 13194139534677 true] [17592186302854 1104 #edb/ref 17592186302859 13194139534677 true] [17592186302854 1110 #uuid "d587d9eb-47a2-5b16-9a07-604038e8c3ab" 13194139534677 true] [17592186302855 1034 "{x}^{2}+(y-3)^{2}=1" 13194139534677 true] [17592186302855 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302855 1111 #uuid "3a19bcd5-75fd-56e9-b93c-1f0f33097874" 13194139534677 true] [17592186302856 1034 "(x-3)^{2}+(y-3)^{2}=3" 13194139534677 true] [17592186302856 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302856 1111 #uuid "f87de581-41ff-5ae5-87a1-e327c0722145" 13194139534677 true] [17592186302857 1034 "{x}^{2}+{y}^{2}=3" 13194139534677 true] [17592186302857 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302857 1111 #uuid "94bb46a3-ebab-5ca7-b8c6-b355e2600d21" 13194139534677 true] [17592186302858 1034 "3{x}^{2}+{y}^{2}=1" 13194139534677 true] [17592186302858 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302858 1111 #uuid "5eafc569-c09a-5b83-b176-cad75ab16314" 13194139534677 true] [17592186302859 1034 "(x+3)^{2}+{y}^{2}=1" 13194139534677 true] [17592186302859 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302859 1111 #uuid "e5a1ba09-26f6-53e7-9178-130dbcd2c0cf" 13194139534677 true] [17592186302860 1017 #edb/ref 17592186302861 13194139534677 true] [17592186302860 1089 "q-15677" 13194139534677 true] [17592186302860 1091 #edb/ref 17592186045464 13194139534677 true] [17592186302860 1100 "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{1}{t+1},\\,\\,\\,y=\\frac{1}{t-2},\\,t\\ne -1,\\,2.\n$$" 13194139534677 true] [17592186302860 1113 #uuid "563cbbce-ad5c-5e6f-8f8d-ab3af5a6315e" 13194139534677 true] [17592186302860 1145 "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{1}{t+1}\\,⇒\\,t=\\frac{1}{x}-1\\end{aligned}\n$$\n\nNow substituting $t=\\frac{1}{x}-1$ into our expression for $y$, we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{((\\frac{1}{x}-1)-2)} \\\\ y & =\\frac{1}{(\\frac{1}{x}-3)} \\\\ y & =\\frac{1}{(\\frac{1-3x}{x})} \\\\ y & =\\frac{x}{1-3x}\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=\\frac{x}{1-3x}.$\n\nFinally, since $t\\ne -1,\\,2$ and $x=\\frac{1}{t+1},$ we must have $x\\ne 0,\\,\\frac{1}{3}.$\n\nSo, the complete Cartesian equation is\n\n$$\ny=\\frac{x}{1-3x},\\,x\\ne 0,\\,\\frac{1}{3}.\n$$" 13194139534677 true] [17592186302861 1000 #edb/ref 17592186302862 13194139534677 true] [17592186302861 1000 #edb/ref 17592186302863 13194139534677 true] [17592186302861 1000 #edb/ref 17592186302864 13194139534677 true] [17592186302861 1000 #edb/ref 17592186302865 13194139534677 true] [17592186302861 1000 #edb/ref 17592186302866 13194139534677 true] [17592186302861 1040 #edb/ref 17592186045450 13194139534677 true] [17592186302861 1041 "selection" 13194139534677 true] [17592186302861 1104 #edb/ref 17592186302866 13194139534677 true] [17592186302861 1110 #uuid "b5db3627-143e-50d1-b347-6643f8b22217" 13194139534677 true] [17592186302862 1034 "y=\\frac{x}{1-x},\\,\\,x\\ne 0,\\,1" 13194139534677 true] [17592186302862 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302862 1111 #uuid "567bd9d4-769a-5520-8bf8-0b8331e1f837" 13194139534677 true] [17592186302863 1034 "y=\\frac{x}{1+x},\\,\\,x\\ne -1,\\,0" 13194139534677 true] [17592186302863 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302863 1111 #uuid "93f17a52-1741-5199-bb8e-083d85ba8c5c" 13194139534677 true] [17592186302864 1034 "y=\\frac{3x}{1+2x},\\,x\\ne -\\frac{1}{2},\\,0" 13194139534677 true] [17592186302864 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302864 1111 #uuid "f0e8f1e6-b2a9-5cb9-80bc-0eaa3b79907d" 13194139534677 true] [17592186302865 1034 "y=\\frac{3x}{1-2x},\\,x\\ne 0,\\,\\frac{1}{2}" 13194139534677 true] [17592186302865 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302865 1111 #uuid "8d2e3ece-40a8-535e-81a3-05d4eef9a6ce" 13194139534677 true] [17592186302866 1034 "y=\\frac{x}{1-3x},\\,x\\ne 0,\\,\\frac{1}{3}" 13194139534677 true] [17592186302866 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302866 1111 #uuid "ea597a22-e2fb-508b-972c-2ec95d482354" 13194139534677 true] [17592186302867 1017 #edb/ref 17592186302868 13194139534677 true] [17592186302867 1089 "q-24576" 13194139534677 true] [17592186302867 1091 #edb/ref 17592186045464 13194139534677 true] [17592186302867 1100 "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=6\\operatorname{sin}⁡t,\\,\\,\\,y=-5\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" 13194139534677 true] [17592186302867 1113 #uuid "f6300777-605f-507f-978f-04a8f9538fa9" 13194139534677 true] [17592186302867 1145 "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=6\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{6} \\\\ y=-5\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=-\\frac{y}{5}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & =(1-{sin}^{2}⁡t)-{sin}^{2}⁡t \\\\  & =1-2{sin}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡t=\\frac{x}{6}$ and $\\operatorname{cos}⁡2t=-\\frac{y}{5}$ into this formula, we get\n\n$$\n\\begin{aligned}-\\frac{y}{5} & =1-2{(\\frac{x}{6})}^{2} \\\\ -\\frac{y}{5} & =1-2(\\frac{{x}^{2}}{36}) \\\\ -\\frac{y}{5} & =1-\\frac{{x}^{2}}{18} \\\\ y & =-5+\\frac{5{x}^{2}}{18}.\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=-5+\\frac{5{x}^{2}}{18}.$" 13194139534677 true] [17592186302868 1000 #edb/ref 17592186302869 13194139534677 true] [17592186302868 1000 #edb/ref 17592186302870 13194139534677 true] [17592186302868 1000 #edb/ref 17592186302871 13194139534677 true] [17592186302868 1000 #edb/ref 17592186302872 13194139534677 true] [17592186302868 1000 #edb/ref 17592186302873 13194139534677 true] [17592186302868 1040 #edb/ref 17592186045450 13194139534677 true] [17592186302868 1041 "selection" 13194139534677 true] [17592186302868 1104 #edb/ref 17592186302869 13194139534677 true] [17592186302868 1110 #uuid "46c96509-f5e7-56e3-8067-f632bbdd7285" 13194139534677 true] [17592186302869 1034 "y=-5+\\frac{5{x}^{2}}{18}" 13194139534677 true] [17592186302869 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302869 1111 #uuid "e4c7c790-d016-564e-8f2a-a689ca3b0dd7" 13194139534677 true] [17592186302870 1034 "y=5+{x}^{2}" 13194139534677 true] [17592186302870 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302870 1111 #uuid "3d9325d7-f550-5c59-88d7-8ff8a9233ce3" 13194139534677 true] [17592186302871 1034 "y=-18+\\frac{{x}^{2}}{5}" 13194139534677 true] [17592186302871 1103 #edb/ref 17592186045453 13194139534677 true] [17592186302871 1111 #uuid "b87282ce-139d-532c-be53-6935258cb3e3" 13194139534677 true] [17592186302872 1034 "y=\\frac{1}{5}-{x}^{2}" 13194139534677 true] [17592186302872 1103 #edb/ref 17592186045453 13194139534677 true] [1759218630287