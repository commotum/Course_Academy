018c8ac70cb05381442e668" "q-64883/selection/4da39332d301ed239149c1018c7305b4ac44bc24890d3448ef95cb8d90b34f5e"] :db/ensure [:answer-field/validate]} {:db/id "q-64883" :question/id #uuid "5be694f6-babf-5a30-89e1-81d884ac107b" :question/math-academy-id "q-64883" :question/problem "Find the solution of the initial value problem\n\n$$\n{x}^{2}{y}^{″}-9x{y}^{′}+25y=0,\\,y(1)=-2,\\,{y}^{′}(1)=4,\\,x>0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}-9x\\cdot \\lambda {x}^{\\lambda -1}+25{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }-9\\lambda {x}^{\\lambda }+25{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[\\lambda (\\lambda -1)-9\\lambda +25] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-9\\lambda +25 & =0 \\\\ {\\lambda }^{2}-10\\lambda +25 & =0 \\\\ (\\lambda -5)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =5.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{5}+{c}_{2}{x}^{5}\\operatorname{ln}⁡x.\n$$\n\nNow let's find the constants ${c}_{1}$ and ${c}_{2}.$\n\nSubstituting $y(1)=-2$ into the general solution gives\n\n$$\n-2={c}_{1}.\n$$\n\nWe now need to apply the condition ${y}^{′}(1)=4.$ First, we differentiate $y$ to find ${y}^{′}$:\n\n$$\n\\begin{aligned}{y}^{′} & =5{x}^{4}{c}_{1}+{c}_{2}{x}^{4}+5{c}_{2}{x}^{4}\\operatorname{ln}⁡x\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=4$ and ${c}_{1}=-2$ into the above gives\n\n$$\n\\begin{aligned}4 & =5{c}_{1}+{c}_{2} \\\\ 4 & =-10+{c}_{2} \\\\ {c}_{2} & =14.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y(x) & =-2{x}^{5}+14{x}^{5}\\operatorname{ln}⁡x \\\\  & =2{x}^{5}(7\\operatorname{ln}⁡x-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-64883/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0"] :knowledge-point/questions ["q-64883"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93915/selection/31ed98885ee97a48bf79942d61f680f93626e236c076f8451117e110381ea3d7" :answer/id #uuid "43cc94c4-9a4b-5aa4-8644-4f2895fc984f" :answer/type :answer.type/math :answer/value "y(t)=4{t}^{9}-3{t}^{9}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-93915/selection/bc863c6f66e18b89c9d6d7cf4b466f254fb2bf84ffc0870c9c885ac4db20d846" :answer/id #uuid "04f2464e-bb35-5ba4-8f52-7fbf6a8f412e" :answer/type :answer.type/math :answer/value "y(t)={t}^{9}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-93915/selection/06bc1e3d9ae2ba81f59b7472cd18dae79fa2817df0aa1e8284e388f3328c6222" :answer/id #uuid "a4715bb4-d3d7-5695-96ec-bbfb556c0e90" :answer/type :answer.type/math :answer/value "y(t)=2{t}^{9}+3{t}^{9}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-93915/selection/c02d510ae4d7cacf653c1a06f658e71946ad97648744f1115acbac8424a77dc4" :answer/id #uuid "74a6f28f-406f-5236-abcd-5e8917a7eb09" :answer/type :answer.type/math :answer/value "y(t)=-2{t}^{9}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-93915/selection/9837c0a8f91eb2d5e18adb34745c29bf638bc29806dcafb501c28d5b6496cb21" :answer/id #uuid "ec2516f4-c999-5fb4-ab1b-15551e237917" :answer/type :answer.type/math :answer/value "y(t)=3{t}^{9}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-93915/selection" :answer-field/id #uuid "5824c42f-9efc-552b-9a75-6f2151a166c0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93915/selection/9837c0a8f91eb2d5e18adb34745c29bf638bc29806dcafb501c28d5b6496cb21" :answer-field/choices ["q-93915/selection/31ed98885ee97a48bf79942d61f680f93626e236c076f8451117e110381ea3d7" "q-93915/selection/bc863c6f66e18b89c9d6d7cf4b466f254fb2bf84ffc0870c9c885ac4db20d846" "q-93915/selection/06bc1e3d9ae2ba81f59b7472cd18dae79fa2817df0aa1e8284e388f3328c6222" "q-93915/selection/c02d510ae4d7cacf653c1a06f658e71946ad97648744f1115acbac8424a77dc4" "q-93915/selection/9837c0a8f91eb2d5e18adb34745c29bf638bc29806dcafb501c28d5b6496cb21"] :db/ensure [:answer-field/validate]} {:db/id "q-93915" :question/id #uuid "3fbb58a2-add7-53ba-9d6f-0aac95627952" :question/math-academy-id "q-93915" :question/problem "Given that the differential equation\n\n$$\n{t}^{2}{y}^{″}-17t{y}^{′}+81y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{t}^{9}+{c}_{2}{t}^{9}\\operatorname{ln}⁡t,\n$$\n\nsolve the initial value problem\n\n$$\n{t}^{2}{y}^{″}-17t{y}^{′}+81y,\\,y(1)=0,\\,{y}^{′}(1)=3,\\,t>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=0.$ Substituting $y(1)=0$ into the general solution gives\n\n$$\n0={c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=3.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =9{c}_{1}{t}^{8}+{c}_{2}{t}^{8}+9{c}_{2}{t}^{8}\\operatorname{ln}⁡t.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=3$ and ${c}_{1}=0$ into the above gives\n\n$$\n\\begin{aligned}3 & =9{c}_{1}+{c}_{2} \\\\ 3 & =0+{c}_{2} \\\\ {c}_{2} & =3.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y(t) & =3{t}^{9}\\operatorname{ln}⁡t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93915/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0"] :knowledge-point/questions ["q-93915"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102365/selection/63eb261c0aff70991d6a656d572dd88793bc