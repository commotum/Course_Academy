294cea192e61a43cc5f2" "q-64874/selection/254f85ae78dd8780726f50e0ae45ab6ddfc5e502cb18c899ea47008c61bd9fb0"] :db/ensure [:answer-field/validate]} {:db/id "q-64874" :question/id #uuid "1512dbf9-cc16-58e0-aa9b-511e595bd069" :question/math-academy-id "q-64874" :question/problem "Find the general solution to the equation\n\n$$\n2{t}^{2}{y}^{″}+22t{y}^{′}+50y=0,\\,t>0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}2{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}+22t\\cdot \\lambda {t}^{\\lambda -1}+50{t}^{\\lambda } & =0 \\\\ 2\\lambda (\\lambda -1){t}^{\\lambda }+22\\lambda {t}^{\\lambda }+50{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[2\\lambda (\\lambda -1)+22\\lambda +50] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}2\\lambda (\\lambda -1)+22\\lambda +50 & =0 \\\\ 2{\\lambda }^{2}+20\\lambda +50 & =0 \\\\ 2({\\lambda }^{2}+10\\lambda +25) & =0 \\\\ 2(\\lambda +5)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =-5.$\nTherefore, the general solution is\n\n$$\ny(t)={c}_{1}{t}^{-5}+{c}_{2}{t}^{-5}\\operatorname{ln}⁡t.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64874/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3abe724a-6aec-5c11-8a00-d92e616a06d7"] :knowledge-point/questions ["q-64874"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64877/selection/4a7ef763637f0990a061f4ab2659e461dffe293b1d4f949f028c1b091f0af9c6" :answer/id #uuid "95145abd-e539-5675-9975-7b1ff81d0e3c" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{3}+{c}_{2}{t}^{-3}" :db/ensure [:answer/validate]} {:db/id "q-64877/selection/f1c95426ed98adfbac9b2549298aaa6dca1a43564dcae78528155fbf6dba6882" :answer/id #uuid "e44908d8-7632-5a6b-835d-4172610e573d" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{6}+{c}_{2}{t}^{6}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-64877/selection/3d6d89fa1e5134e2166f904be73d2b68cc5bb39d2c5e5b314e597ec59ddcf0b6" :answer/id #uuid "3fec114b-62c2-510c-85a6-8eabda1066f7" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{-6}+{c}_{2}{t}^{-6}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-64877/selection/2276d5e93db2d959cc4f180e262602192e3cb8127634884371092095c454c5e1" :answer/id #uuid "258f4e11-f905-5b62-918b-ad08cbb7fed3" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{-6}+{c}_{2}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-64877/selection/246165fbcca0ef7477cca47f08b36f1b8dc61e970d0b265de853d266d827825b" :answer/id #uuid "9d69675e-bcb0-505a-9812-a30e1cc13c47" :answer/type :answer.type/math :answer/value "y(t)={c}_{1}{t}^{3}+{c}_{2}{t}^{3}\\operatorname{ln}⁡t" :db/ensure [:answer/validate]} {:db/id "q-64877/selection" :answer-field/id #uuid "38e1c982-babe-526e-bb48-4165a7e3f0c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64877/selection/3d6d89fa1e5134e2166f904be73d2b68cc5bb39d2c5e5b314e597ec59ddcf0b6" :answer-field/choices ["q-64877/selection/4a7ef763637f0990a061f4ab2659e461dffe293b1d4f949f028c1b091f0af9c6" "q-64877/selection/f1c95426ed98adfbac9b2549298aaa6dca1a43564dcae78528155fbf6dba6882" "q-64877/selection/3d6d89fa1e5134e2166f904be73d2b68cc5bb39d2c5e5b314e597ec59ddcf0b6" "q-64877/selection/2276d5e93db2d959cc4f180e262602192e3cb8127634884371092095c454c5e1" "q-64877/selection/246165fbcca0ef7477cca47f08b36f1b8dc61e970d0b265de853d266d827825b"] :db/ensure [:answer-field/validate]} {:db/id "q-64877" :question/id #uuid "d15e1269-9485-5413-b829-3a7378223147" :question/math-academy-id "q-64877" :question/problem "Find the general solution to the equation\n\n$$\n{t}^{2}{y}^{″}+13t{y}^{′}+36y=0,\\,t>0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}+13t\\cdot \\lambda {t}^{\\lambda -1}+36{t}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){t}^{\\lambda }+13\\lambda {t}^{\\lambda }+36{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[\\lambda (\\lambda -1)+13\\lambda +36] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)+13\\lambda +36 & =0 \\\\ {\\lambda }^{2}+12\\lambda +36 & =0 \\\\ (\\lambda +6)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =-6.$\nTherefore, the general solution is\n\n$$\ny(t)={c}_{1}{t}^{-6}+{c}_{2}{t}^{-6}\\operatorname{ln}⁡t.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64877/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3abe724a-6aec-5c11-8a00-d92e616a06d7"] :knowledge-point/questions ["q-64877"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64777"] :question/problem "Find the general solution to the equation\n\n$$\n{x}^{2}{y}^{″}-x{y}^{′}+y=0,\\,x>0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}-x\\cdot \\lambda {x}^{\\lambda -1}+{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }-\\lambda {x}^{\\lambda }+{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[\\lambda (\\lambda -1)-\\lambda +1] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-\\lambda +1 & =0 \\\\ {\\lambda }^{2}-2\\lambda +1 & =0 \\\\ (\\lambda -1)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =1.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{1}+{c}_{2}{x}^{1}\\operatorname{ln}⁡x={c}_{1}x+{c}_{2}x\\operatorname{ln}⁡x.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-64785/selection/436151c632922f4961db2293e4aa43f6163c982c62f256b0100d3b158238b534" :answer/id #uuid "7991adfd-124b-5978-a79e-43790f8287f2" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}+{c}_{2}{x}^{9}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-64785/selection/b99779a8e70d836581cfa3d2d4548631c3ca6d51e62da19d93039304451abab0" :answer/id #uuid "7c70529b-554b-55a7-90db-39aa61291536" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{3}+{c}_{2}{x}^{3}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-64785/selection/5a6efda4c38a47113f824283d01a72857c92128273d3e5283cd0e89ba277abae" :answer/id #uuid "da89c0fa-d06d-5d51-b600-a15e2135523b" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{-9}+{c}_{2}{x}^{-9}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-64785/selection/8e2fc22756be7bb31a5b728ba49c19a3f115475b02bbcfba3c5dec6e4ca1a394" :answer/id #uuid "10f4ef86-c373-540f-9cf1-b509789c0307" :answer/type :answer.type/math :answer/value "y(x)={c}_{1}{x}^{-3}+{c}_{2}{x}^{-3}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-64785/selection/65561d9ffe9b86d1303b6a7763f06cb8519c76208f01cffa45fbf881d102a600" :answer/id #uuid "78ec5dbf-c09c-52d5-96b8-081cc129b46b" :answer/type :answer.type/math :answer/value