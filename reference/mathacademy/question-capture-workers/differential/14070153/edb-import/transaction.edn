b5b5037a34b681b7c10b909a1218435"] :db/ensure [:answer-field/validate]} {:db/id "q-102365" :question/id #uuid "b2f1e33b-97ff-5879-aa46-ccc76aa7159d" :question/math-academy-id "q-102365" :question/problem "Given that the differential equation\n\n$$\n{x}^{2}{y}^{″}+15x{y}^{′}+49y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{x}^{-7}+{c}_{2}{x}^{-7}\\operatorname{ln}⁡x,\n$$\n\nsolve the initial value problem\n\n$$\n{x}^{2}{y}^{″}+15x{y}^{′}+49y=0,\\,y(1)=1,\\,{y}^{′}(1)=1,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=1.$ Substituting $y(1)=1$ into the general solution gives\n\n$$\n1={c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=1.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =-7{c}_{1}{x}^{-8}+{c}_{2}{x}^{-8}-7{c}_{2}{x}^{-8}\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=1$ and ${c}_{1}=1$ into the above gives\n\n$$\n\\begin{aligned}1 & =-7(1)+{c}_{2} \\\\ {c}_{2} & =8.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y(x) & ={x}^{-7}+8{x}^{-7}\\operatorname{ln}⁡x \\\\  & =\\frac{1+8\\operatorname{ln}⁡x}{{x}^{7}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-102365/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0"] :knowledge-point/questions ["q-102365"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93910/selection/dddd914b7b5de65270c69bfb81e75d5515ef7e06919ef2452fa82d4ae0d69958" :answer/id #uuid "a21e2e5e-96b1-5b90-a5ed-51d54ba1bc7b" :answer/type :answer.type/math :answer/value "y(x)=2x-5x\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93910/selection/d57d24b7e4290a2939577e74f9c3911829ae748b064c5efbeab646bf6b24c892" :answer/id #uuid "c3122cb3-a808-50ab-947f-03cda206bc14" :answer/type :answer.type/math :answer/value "y(x)=x+3x\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93910/selection/5c52ac1b9dd1129e7fd8cdf130ea81ba564ddfee5ea29fabf3d5ad9c53eb403e" :answer/id #uuid "09e3a1dd-b496-5205-9bf1-1c30247f1631" :answer/type :answer.type/math :answer/value "y(x)=x-x\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93910/selection/5c3f6c1f2f22169c21e0b7ed458abbbac4cfc7d7c4ac3e989bf43324f6159162" :answer/id #uuid "41e04819-c84a-5612-a593-8953cdd33b2a" :answer/type :answer.type/math :answer/value "y(x)=\\frac{x}{2}-2x\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93910/selection/75caaae95a0bf9daaf6520943b189207d7f46cb3189406ef8df9e4bd0737d06a" :answer/id #uuid "28f38cd0-d0b9-5705-8418-a2a0c21a778e" :answer/type :answer.type/math :answer/value "y(x)=x-4x\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93910/selection" :answer-field/id #uuid "b2d9ef70-72e5-5313-9957-9d5f121a4236" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93910/selection/d57d24b7e4290a2939577e74f9c3911829ae748b064c5efbeab646bf6b24c892" :answer-field/choices ["q-93910/selection/dddd914b7b5de65270c69bfb81e75d5515ef7e06919ef2452fa82d4ae0d69958" "q-93910/selection/d57d24b7e4290a2939577e74f9c3911829ae748b064c5efbeab646bf6b24c892" "q-93910/selection/5c52ac1b9dd1129e7fd8cdf130ea81ba564ddfee5ea29fabf3d5ad9c53eb403e" "q-93910/selection/5c3f6c1f2f22169c21e0b7ed458abbbac4cfc7d7c4ac3e989bf43324f6159162" "q-93910/selection/75caaae95a0bf9daaf6520943b189207d7f46cb3189406ef8df9e4bd0737d06a"] :db/ensure [:answer-field/validate]} {:db/id "q-93910" :question/id #uuid "bf5f77ff-83c3-538e-955a-4f394527d982" :question/math-academy-id "q-93910" :question/problem "Given that the differential equation\n\n$$\n{x}^{2}{y}^{″}-x{y}^{′}+y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}x+{c}_{2}x\\operatorname{ln}⁡x,\n$$\n\nsolve the initial value problem\n\n$$\n{x}^{2}{y}^{″}-x{y}^{′}+y=0,\\,y(1)=1,\\,{y}^{′}(1)=4,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=1.$ Substituting $y(1)=1$ into the general solution gives\n\n$$\n1={c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=1.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & ={c}_{1}+{c}_{2}+{c}_{2}\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=1$ and ${c}_{1}=1$ into the above gives\n\n$$\n\\begin{aligned}4 & =1+{c}_{2} \\\\ {c}_{2} & =3.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x)=x+3x\\operatorname{ln}⁡x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93910/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0"] :knowledge-point/questions ["q-93910"] :db/ensure [:knowledge-point/validate]} {:db/id "q-93912/selection/0c5451a1bf30c6073f39888a4410b4ac4e65ce6633166f7819b5dc26cc8450ec" :answer/id #uuid "bab014a1-e1ce-5e73-8d6d-fb4d9bed6db9" :answer/type :answer.type/math :answer/value "y(x)=2{x}^{4}-{x}^{4}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93912/selection/7f524e6ffea6d83e0144676d730e52c0970f78b45f765f5c365f83ad35cdf551" :answer/id #uuid "7d479d69-1f5b-553c-b668-ef3700376216" :answer/type :answer.type/math :answer/value "y(x)=-2{x}^{4}+3{x}^{4}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93912/selection/351187a3a83bb3d5a0b7049650d48de88f0110d3705f0bea5a4a13cb01ec933f" :answer/id #uuid "41c64f8d-f5fc-549d-9778-d8035fa055f2" :answer/type :answer.type/math :answer/value "y(x)=2{x}^{4}-3{x}^{4}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93912/selection/434377fa5cccb9277d8490a46ed244301f41db78a554de0374c09689779fb3be" :answer/id #uuid "463d7dc3-a519-5795-84bf-9fc85f8e98d7" :answer/type :answer.type/math :answer/value "y(x)=2{x}^{4}-2{x}^{4}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93912/selection/46e53498abafc52610bb3e6c8b149349a7806e7caa2331f1f432c2a1759011e8" :answer/id #uuid "e971d41e-0455-50cb-9ba1-d20188ad8617" :answer/type :answer.type/math :answer/value "y(x)=-3{x}^{4}-4{x}^{4}\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-93912/selection" :answer-field/id #uuid "1821bf03-8696-5936-b43d-89ababb52a07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-93912/selection/434377fa5cccb9277d8490a46ed244301f41db78a554de0374c09689779fb3be" :answer-field/choices ["q-93912/selection/0c5451a1bf30c6073f39888a4410b4ac4e65ce6633166f7819b5dc26cc8450ec" "q-93912/selection/7f524e6ffea6d83e0144676d730e52c0970f78b45f765f5c365f83ad35cdf551" "q-93912/selection/351187a3a83bb3d5a0b7049650d48de88f0110d3705f0bea5a4a13cb01ec933f" "q-93912/selection/434377fa5cccb9277d8490a46ed244301f41db78a554de0374c09689779fb3be" "q-93912/selection/46e53498abafc52610bb3e6c8b149349a7806e7caa2331f1f432c2a1759011e8"] :db/ensure [:answer-field/validate]} {:db/id "q-93912" :question/id #uuid "1be3b6b0-b399-521e-9afa-ba8e015a4069" :question/math-academy-id "q-93912" :question/problem "Given that the differential equation\n\n$$\n{x}^{2}{y}^{″}-7x{y}^{′}+16y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{x}^{4}+{c}_{2}{x}^{4}\\operatorname{ln}⁡x,\n$$\n\nsolve the initial value problem\n\n$$\n{x}^{2}{y}^{″}-7x{y}^{′}+16y=0,\\,y(1)=2,\\,{y}^{′}(1)=6,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=2.$ Substituting $y(1)=2$ into the general solution gives\n\n$$\n2={c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=6.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =4{c}_{1}{x}^{3}+{c}_{2}{x}^{3}+4{c}_{2}{x}^{3}\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=6$ and ${c}_{1}=2$ into the above gives\n\n$$\n\\begin{aligned}6 & =4(2)+{c}_{2} \\\\ 6 & =8+{c}_{2} \\\\ {c}_{2} & =-2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x)=2{x}^{4}-2{x}^{4}\\operatorname{ln}⁡x.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-93912/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0"] :knowledge-point/questions ["q-93912"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6627"] :question/problem "Find the general solution to the equation\n\n$$\n2x^2 y'' + 6 xy' + 2y = 0, \\qquad x>0.\n$$" :question/worked-solution "This is an instance of the Cauchy-Euler equation. So, we assume the solutions take the form $y=x^\\lambda.$ Differentiating $y$ with respect to $x$ gives\n\n$$\ny' = \\lambda x^{\\lambda -1}, \\qquad y'' = \\lambda(\\lambda-1)x^{\\lambda-2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}2{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}+6x\\cdot \\lambda {x}^{\\lambda -1}+2{x}^{\\lambda } & =0 \\\\ 2\\lambda (\\lambda -1){x}^{\\lambda }+6\\lambda {x}^{\\lambda }+2{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[2\\lambda (\\lambda -1)+6\\lambda +2] & =0.\\end{aligned}\n$$\n\nSo, we have the following characteristic equation:\n\n$$\n\\begin{aligned}2\\lambda (\\lambda -1)+6\\lambda +2 & =0 \\\\ 2{\\lambda }^{2}+4\\lambda +2 & =0 \\\\ 2({\\lambda }^{2}+2\\lambda +1) & =0 \\\\ 2(\\lambda +1)^{2} & =0\\end{aligned}\n$$\n\nThe characteristic equation has a double root $\\lambda = -1.$ Therefore, the general solution is\n\n$$\n\\begin{aligned}y(x) & ={c}_{1}{x}^{-1}+{c}_{2}{x}^{-1}\\operatorname{ln}⁡x \\\\  & =\\frac{{c}_{1}}{x}+\\frac{{c}_{2}\\operatorname{ln}⁡x}{x}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6628"] :question/problem "Given that the differential equation\n\n$$\nx^2 y'' - 19 xy' + 100y = 0\n$$\n\nhas the general solution\n\n$$\ny =c_1 x^{10}+ c_2x ^{10}\\ln x ,\n$$\n\nsolve the initial value problem\n\n$$\nx^2 y'' - 19 xy' + 100y = 0, \\quad y(1) = 0,\\quad  y'(1)=1, \\quad x>0.\n$$" :question/worked-solution "We find the constants $c_1$ and $c_2$ using the initial conditions.\n\n- First, we apply the condition $y(1)=0.$ Substituting $y(1)= 0$ into the general solution gives\n\n$$\n0= c_1.\n$$\n\n- Then, we apply the condition $y'(1) = 1.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =10{c}_{1}{x}^{9}+{c}_{2}{x}^{9}+10{c}_{2}{x}^{9}\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSubstituting $y'(1)=1$ and $c_1 = 0$ into the above gives\n\n$$\n\\begin{aligned}1 & =10{c}_{1}+{c}_{2} \\\\ 1 & =0+{c}_{2} \\\\ {c}_{2} & =1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny(x) = x ^{10}\\ln x .\n$$" :db/ensure [:question/validate]}]
