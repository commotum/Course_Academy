186045453 13194139535760 true] [17592186365041 1111 #uuid "7991adfd-124b-5978-a79e-43790f8287f2" 13194139535760 true] [17592186365042 1034 "y(x)={c}_{1}{x}^{-9}+{c}_{2}{x}^{-9}\\operatorname{ln}⁡x" 13194139535760 true] [17592186365042 1103 #edb/ref 17592186045453 13194139535760 true] [17592186365042 1111 #uuid "da89c0fa-d06d-5d51-b600-a15e2135523b" 13194139535760 true] [17592186365043 1034 "y(x)={c}_{1}{x}^{9}+{c}_{2}{x}^{-9}" 13194139535760 true] [17592186365043 1103 #edb/ref 17592186045453 13194139535760 true] [17592186365043 1111 #uuid "78ec5dbf-c09c-52d5-96b8-081cc129b46b" 13194139535760 true] [17592186365044 1034 "y(x)={c}_{1}{x}^{-3}+{c}_{2}{x}^{-3}\\operatorname{ln}⁡x" 13194139535760 true] [17592186365044 1103 #edb/ref 17592186045453 13194139535760 true] [17592186365044 1111 #uuid "10f4ef86-c373-540f-9cf1-b509789c0307" 13194139535760 true] [17592186365045 1034 "y(x)={c}_{1}{x}^{3}+{c}_{2}{x}^{3}\\operatorname{ln}⁡x" 13194139535760 true] [17592186365045 1103 #edb/ref 17592186045453 13194139535760 true] [17592186365045 1111 #uuid "7c70529b-554b-55a7-90db-39aa61291536" 13194139535760 true] [17592186365046 1017 #edb/ref 17592186365047 13194139535760 true] [17592186365046 1089 "q-64872" 13194139535760 true] [17592186365046 1091 #edb/ref 17592186045463 13194139535760 true] [17592186365046 1100 "Find the general solution to the equation\n\n$$\n2{t}^{2}{y}^{″}+10t{y}^{′}+8y=0,\\,t>0.\n$$" 13194139535760 true] [17592186365046 1113 #uuid "437b3f00-7c42-52b5-95e9-666d55baf0bf" 13194139535760 true] [17592186365046 1145 "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}2{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}+10t\\cdot \\lambda {t}^{\\lambda -1}+8{t}^{\