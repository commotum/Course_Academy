1}{2}-3) \\\\ \\frac{7}{2} & =-\\frac{7}{2}B \\\\ B & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3x+5}{(x-3)(2x+1)}=\\frac{2}{x-3}+\\frac{-1}{2x+1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/state.json" "file_sha256" "18d08804db0ec8a366cc0642707cede73e72624145564da97a3440a6b9351b3f" "basis" 1140 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/edb-import/verification.json"} {"question" "q-350930" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/activity-metadata.json" "file_sha256" "9b32a3d6ebef79dd0ca7711e1ea66dbf1bb79bf3c2ffae90460b81de65d21987" "basis" 1140 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/edb-import/verification.json"} {"question" "q-350930" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/state.json" "file_sha256" "18d08804db0ec8a366cc0642707cede73e72624145564da97a3440a6b9351b3f" "basis" 1140 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/edb-import/verification.json"} {"question" "q-350930" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/state.json" "file_sha256" "18d08804db0ec8a366cc0642707cede73e72624145564da97a3440a6b9351b3f" "basis" 1140 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14008799/edb-import/verification.json"}] "sources" [{"question" "q-350930" "field" nil "attribute" "question/problem" "value" "Express $\\frac{3x+5}{(x-3)(2x+1)}$ as a sum of partial fractions.\n\n|  | $\\frac{3x+5}{(x-3)(2x+1)}\\,=\\,\\frac{2}{x-3}\\,\\,+$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $2x+1$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350930" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $B$ such that\n\n$$\n\\frac{3x+5}{(x-3)(2x+1)}=\\frac{2}{x-3}+\\frac{B}{2x+1}.\n$$\n\nMultiplying both sides by $(x-3)(2x+1)$ gives\n\n$$\n3x+5=2(2x+1)+B(x-3).\n$$\n\nFor $x=-\\frac{1}{2}$, we get\n\n$$\n\\begin{aligned}3(-\\frac{1}{2})+5 & =2(2(-\\frac{1}{2})+1)+B(-\\frac{1}{2}-3) \\\\ \\frac{7}{2} & =-\\frac{7}{2}B \\\\ B & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3x+5}{(x-3)(2x+1)}=\\frac{2}{x-3}+\\frac{-1}{2x+1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350930" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/activity-metadata.json" "file_sha256" "3e9b16d30bb8a5be10cc9bbaf6c5a3d7b0db2ba26e54c2f941890788bf70d0c5"} {"question" "q-350930" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350930" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350940" "field" nil "attribute" "question/problem" "value" "Express $\\frac{4-5x}{x(x-1)}$ as a sum of partial fractions.\n\n| $\\frac{4-5x}{x(x-1)}=\\,$ | {{field-1}} | $+$ | {{field-2}} |\n| --- | --- | --- | --- |\n|  | $x$ |  | $x-1$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350940" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A$ and $B$ such that\n\n$$\n\\frac{4-5x}{x(x-1)}=\\frac{A}{x}+\\frac{B}{x-1}.\n$$\n\nMultiplying both sides by $x(x-1)$ gives\n\n$$\n4-5x=A(x-1)+Bx.\n$$\n\nFor $x=0$, we get \n\n$$\n\\begin{aligned}4-5(0) & =A(0-1)+B(0) \\\\ 4 & =-A \\\\ A & =-4.\\end{aligned}\n$$\n\nFor $x=1,$ we get \n\n$$\n\\begin{aligned}4-5(1) & =A(1-1)+B(1) \\\\ -1 & =B \\\\ B & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{4-5x}{x(x-1)}=\\frac{-4}{x}+\\frac{-1}{x-1}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350940" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/activity-metadata.json" "file_sha256" "3e9b16d30bb8a5be10cc9bbaf6c5a3d7b0db2ba26e54c2f941890788bf70d0c5"} {"question" "q-350940" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350940" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350940" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350940" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10972" "field" nil "attribute" "question/problem" "value" "Given that\n\n$$\n\\frac{6x-25}{x(x+5)}=\\frac{A}{x}+\\frac{B}{(x+5)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10972" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{6x-25}{x(x+5)}=\\frac{A}{x}+\\frac{B}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $x(x+5)$ gives\n\n$$\n6x-25=A(x+5)+B(x).\n$$\n\nFor $x=0$, we get \n\n$$\n\\begin{aligned}6(0)-25 & =A(0+5)+B(0) \\\\ -25 & =5A \\\\ A & =-\\frac{25}{5} \\\\ A & =-5.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}6(-5)-25 & =A(-5+5)+B(-5) \\\\ -55 & =-5B \\\\ B & =\\frac{-55}{-5} \\\\ B & =11.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-5+11=6.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10972" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/activity-metadata.json" "file_sha256" "3e9b16d30bb8a5be10cc9bbaf6c5a3d7b0db2ba26e54c2f941890788bf70d0c5"} {"question" "q-10972" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10972" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "4"] ["math" "6"] ["math" "7"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10972" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10974" "field" nil "attribute" "question/problem" "value" "Given that\n\n$$\n\\frac{7x-37}{(5-3x)(2x+3)}=\\frac{A}{(5-3x)}+\\frac{B}{(2x+3)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10974" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{7x-37}{(5-3x)(2x+3)}=\\frac{A}{(5-3x)}+\\frac{B}{(2x+3)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(5-3x)(2x+3)$ gives\n\n$$\n7x-37=A(2x+3)+B(5-3x).\n$$\n\nFor $x=-\\frac{3}{2}$, we get \n\n$$\n\\begin{aligned}7(-\\frac{3}{2})-37 & =A(2(-\\frac{3}{2})+3)+B(5-3(-\\frac{3}{2})) \\\\ \\frac{-21-74}{2} & =B(\\frac{10+9}{2}) \\\\ \\frac{-95}{2} & =B(\\frac{19}{2}) \\\\ B & =\\frac{-95}{19} \\\\ B & =-5.\\end{aligned}\n$$\n\nFor $x=\\frac{5}{3}$, we get \n\n$$\n\\begin{aligned}7(\\frac{5}{3})-37 & =A(2(\\frac{5}{3})+3)+B(5-3(\\frac{5}{3})) \\\\ \\frac{35-111}{3} & =A(\\frac{10+9}{3}) \\\\ A & =\\frac{-76}{19} \\\\ A & =-4.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-4+(-5)=-4-5=-9.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10974" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/activity-metadata.json" "file_sha256" "3e9b16d30bb8a5be10cc9bbaf6c5a3d7b0db2ba26e54c2f941890788bf70d0c5"} {"question" "q-10974" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10974" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "-9"] ["math" "0"] ["math" "3"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10974" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-9"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350934" "field" nil "attribute" "question/problem" "value" "Express $\\frac{5x+11}{(x+1)(x+3)}$ as a sum of partial fractions.\n\n| $\\frac{5x+11}{(x+1)(x+3)}=\\,$ | {{field-1}} | $+$ | $2$ |\n| --- | --- | --- | --- |\n|  | $x+1$ |  | $x+3$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350934" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A$ such that\n\n$$\n\\frac{5x+11}{(x+1)(x+3)}=\\frac{A}{x+1}+\\frac{2}{x+3}.\n$$\n\nMultiplying both sides by $(x+1)(x+3)$ gives\n\n$$\n5x+11=A(x+3)+2(x+1).\n$$\n\nFor $x=-1$, we get\n\n$$\n\\begin{aligned}5(-1)+11 & =A(-1+3)+2(-1+1) \\\\ 6 & =2A \\\\ A & =3.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{5x+11}{(x+1)(x+3)}=\\frac{3}{x+1}+\\frac{2}{x+3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "8