2)(3x+4)+C(x-2)(x+1).\n$$\n\nFor $x=2,$ we get\n\n$$\n\\begin{aligned}-2(2)^{2}+19(2)+30 & =A(2+1)(3(2)+4)+B(2-2)(3(2)+4)+C(2-2)(2+1) \\\\ 60 & =30A \\\\ A & =2.\\end{aligned}\n$$\n\nFor $x=-1,$ we get\n\n$$\n\\begin{aligned}-2(-1)^{2}+19(-1)+30 & =A(-1+1)(3(-1)+4)+B(-1-2)(3(-1)+4)+C(-1-2)(-1+1) \\\\ 9 & =-3B \\\\ B & =-3.\\end{aligned}\n$$\n\nFor $x=-\\frac{4}{3}$, we get\n\n$$\n\\begin{aligned}-2{(-\\frac{4}{3})}^{2}+19(-\\frac{4}{3})+30 & =A(-\\frac{4}{3}+1)(3(-\\frac{4}{3})+4) \\\\  & \\,\\,+B(-\\frac{4}{3}-2)(3(-\\frac{4}{3})+4) \\\\  & \\,\\,+C(-\\frac{4}{3}-2)(-\\frac{4}{3}+1) \\\\ \\frac{10}{9} & =\\frac{10}{9}C \\\\ C & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{-2{x}^{2}+19x+30}{(x-2)(x+1)(3x+4)}=\\frac{2}{x-2}-\\frac{3}{x+1}+\\frac{1}{3x+4}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350968" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/activity-metadata.json" "file_sha256" "3e9b16d30bb8a5be10cc9bbaf6c5a3d7b0db2ba26e54c2f941890788bf70d0c5"} {"question" "q-350968" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350968" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350968" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350968" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350968" "field" "field-3" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-350968" "field" "field-3" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10989" "field" nil "attribute" "question/problem" "value" "Express $\\frac{-2{x}^{2}+21x+41}{(x+1)(2-x)(x+3)}$ as a sum of partial fractions." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10989" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B$ and $C$ such that\n\n$$\n\\begin{aligned}\\frac{-2{x}^{2}+21x+41}{(x+1)(2-x)(x+3)} & =\\frac{A}{(x+1)}+\\frac{B}{(2-x)}+\\frac{C}{(x+3)}.\\end{aligned}\n$$\n\nMultiplying both sides by $(x+1)(2-x)(x+3)$ gives\n\n$$\n-2{x}^{2}+21x+41=A(2-x)(x+3)+B(x+1)(x+3)+C(x+1)(2-x).\n$$\n\nFor $x=-1$, we get \n\n$$\n\\begin{aligned}-2(-1)^{2}+21(-1)+41 & =A(2-(-1))(-1+3) \\\\  & \\,+B(-1+1)(-1+3) \\\\  & +C(-1+1)(2-(-1)) \\\\ -2-21+41 & =A(6) \\\\ A & =\\frac{18}{6} \\\\ A & =3.\\end{aligned}\n$$\n\nFor $x=2$, we get \n\n$$\n\\begin{aligned}-2(2)^{2}+21(2)+41 & =A(2-2)(2+3) \\\\  & \\,+B(2+1)(2+3) \\\\  & +C(2+1)(2-2) \\\\ -8+42+41 & =B(15) \\\\ B & =\\frac{75}{15} \\\\ B & =5.\\end{aligned}\n$$\n\nFor $x=-3$, we get \n\n$$\n\\begin{aligned}-2(-3)^{2}+21(-3)+41 & =A(2-(-3))(-3+3) \\\\  & \\,+B(-3+1)(-3+3) \\\\  & +C(-3+1)(2-(-3)) \\\\ -18-63+41 & =C(-10) \\\\ C & =\\frac{-40}{-10} \\\\ C & =4.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\frac{-2{x}^{2}+21x+41}{(x+1)(2-x)(x+3)}=\\frac{3}{(x+1)}+\\frac{5}{(2-x)}+\\frac{4}{(x+3)}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10989" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/activity-metadata.json" "file_sha256" "3e9b16d30bb8a5be10cc9bbaf6c5a3d7b0db2ba26e54c2f941890788bf70d0c5"} {"question" "q-10989" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10989" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{2}{(x+1)}-\\frac{1}{(2-x)}-\\frac{3}{(x+3)}"] ["math" "\\frac{3}{(x+1)}+\\frac{5}{(2-x)}+\\frac{4}{(x+3)}"] ["math" "\\frac{3}{(x+1)}-\\frac{2}{(2-x)}+\\frac{6}{(x+3)}"] ["math" "\\frac{4}{(x+1)}-\\frac{6}{(2-x)}-\\frac{7}{(x+3)}"] ["math" "\\frac{8}{(x+1)}+\\frac{1}{(2-x)}+\\frac{2}{(x+3)}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-10989" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{(x+1)}+\\frac{5}{(2-x)}+\\frac{4}{(x+3)}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-351007" "field" nil "attribute" "question/problem" "value" "Express $\\frac{18-19x}{(2x+1)(3x-4)(x-2)}$ as a sum of partial fractions.\n\n| $\\frac{18-19x}{(2x+1)(3x-4)(x-2)}=\\,$ | {{field-1}} | $+$ | {{field-2}} | $-$ | {{field-3}} |\n| --- | --- | --- | --- | --- | --- |\n|  | $2x+1$ |  | $3x-4$ |  | $x-2$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-351007" "field" nil "attribute" "question/worked-solution" "value" "Our task is to find $A,$ $B,$ and $C$ such that\n\n$$\n\\frac{18-19x}{(2x+1)(3x-4)(x-2)}=\\frac{A}{2x+1}+\\frac{B}{3x-4}+\\frac{C}{x-2}.\n$$\n\nMultiplying both sides by $(2x+1)(3x-4)(x-2)$ gives\n\n$$\n18-19x=A(3x-4)(x-2)+B(2x+1)(x-2)+C(2x+1)(3x-4).\n$$\n\nFor $x=-\\frac{1}{2},$ we get\n\n$$\n\\begin{aligned}18-19(-\\frac{1}{2}) & =A(3(-\\frac{1}{2})-4)(-\\frac{1}{2}-2) \\\\  & \\,+B(2(-\\frac{1}{2})+1)(-\\frac{1}{2}-2) \\\\  & \\,+C(2(-\\frac{1}{2})+1)(3(-\\frac{1}{2})-4) \\\\ \\frac{55}{2} & =\\frac{55}{4}A \\\\ A & =2.\\end{aligned}\n$$\n\nFor $x=\\frac{4}{3},$ we get\n\n$$\n\\begin{aligned}18-19(\\frac{4}{3}) & =A(3(\\frac{4}{3})-4)(\\frac{4}{3}-2) \\\\  & \\,+B(2(\\frac{4}{3})+1)(\\frac{4}{3}-2) \\\\  & \\,+C(2(\\frac{4}{3})+1)(3(\\frac{4}{3})-4) \\\\ -\\frac{22}{3} & =-\\frac{22}{9}B \\\\ B & =3.\\end{aligned}\n$$\n\nFor $x=2$, we get\n\n$$\n\\begin{aligned}18-19(2) & =A(3(2)-4)(2-2)+B(2(2)+1)(2-2)+C(2(2)+1)(3(2)-4) \\\\ -20 & =10C \\\\ C & =-2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{18-19x}{(2x+1)(3x-4)(x-2)}=\\frac{2}{2x+1}+\\frac{3}{3x-4}-\\frac{2}{x-2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-351007" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/activity-metadata.json" "file_sha256" "3e9b16d30bb8a5be10cc9bbaf6c5a3d7b0db2ba26e54c2f941890788bf70d0c5"} {"question" "q-351007" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-351007" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14038435/state.json" "file_sha256" "86471dc7c39eb5dce9ae750fdcefc742cee98557ce3d97cf06e7b933d036aebf"} {"question" "q-351007" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "m