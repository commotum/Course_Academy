#{[{:db/id #edb/ref 17592186289074 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77fa05a0-065f-55e0-8772-10a5bc27239c" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186289076} {:answer/id #uuid "6a91d886-93d0-55d4-8332-e22191fabdbd" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186289077} {:answer/id #uuid "20089555-b2b4-5881-a546-c245548b5d8e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186289078} {:answer/id #uuid "c1f0d6d2-2f1c-5b64-ac9e-f8c29191a81e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289079} {:answer/id #uuid "74990dcd-b63e-5bb8-9b9e-0d439fcabe1d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186289080}] :answer-field/correct {:answer/id #uuid "c1f0d6d2-2f1c-5b64-ac9e-f8c29191a81e" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186289079} :answer-field/id #uuid "6cbf946a-6bde-519f-b590-8ddb36f996c1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289075}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "49eb189d-dbb6-571c-b92b-059f64da6668" :question/math-academy-id "q-10972" :question/problem "Given that\n\n$$\n\\frac{6x-25}{x(x+5)}=\\frac{A}{x}+\\frac{B}{(x+5)},\n$$\n\nwhere $A$ and $B$ are real constants, calculate $A+B.$" :question/worked-solution "Our task is to find $A$ and $B$ such that\n\n$$\n\\begin{aligned}\\frac{6x-25}{x(x+5)}=\\frac{A}{x}+\\frac{B}{(x+5)}.\\end{aligned}\n$$\n\nMultiplying both sides by $x(x+5)$ gives\n\n$$\n6x-25=A(x+5)+B(x).\n$$\n\nFor $x=0$, we get \n\n$$\n\\begin{aligned}6(0)-25 & =A(0+5)+B(0) \\\\ -25 & =5A \\\\ A & =-\\frac{25}{5} \\\\ A & =-5.\\end{aligned}\n$$\n\nFor $x=-5$, we get \n\n$$\n\\begin{aligned}6(-5)-25 & =A(-5+5)+B(-5) \\\\ -55 & =-5B \\\\ B & =\\frac{-55}{-5} \\\\ B & =11.\\end{aligned}\n$$\n\nHence,\n\n$$\nA+B=-5+11=6.\n$$"}] [{:db/id #edb/ref 17592186289089 :knowledge-point/_questions [{:knowledge-point/id #uuid "450aebfe-d896-50bc-a392-e43aee7afabd" :knowledge-point/title "Expressing a Rational Function With Two Linear Factors as a Sum of Partial Fractions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "df797e27-a173-5b04-9f46-8d090078f38e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289091}] :answer-field/correct {:answer/id #uuid "df797e27-a173-5b04-9f46-8d090078f38e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186289091} :answer-field/id #uuid "92430816-e191-55f5-a35c-fd2663b67f23" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289090}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fbf7949e-794d-58c7-ac2f-19452bc80c32" :question/math-academy-id "q-350930" :question/problem "Express $\\frac{3x+5}{(x-3)(2x+1)}$ as a sum of partial fractions.\n\n|  | $\\frac{3x+5}{(x-3)(2x+1)}\\,=\\,\\frac{2}{x-3}\\,\\,+$ | {{field-1}} |\n| --- | --- | --- |\n|  |  | $2x+1$ |" :question/worked-solution "Our task is to find $B$ such that\n\n$$\n\\frac{3x+5}{(x-3)(2x+1)}=\\frac{2}{x-3}+\\frac{B}{2x+1}.\n$$\n\nMultiplying both sides by $(x-3)(2x+1)$ gives\n\n$$\n3x+5=2(2x+1)+B(x-3).\n$$\n\nFor $x=-\\frac{1}{2}$, we get\n\n$$\n\\begin{aligned}3(-\\frac{1}{2})+5 & =2(2(-\\frac{1}{2})+1)+B(-\\frac{1}{2}-3) \\\\ \\frac{7}{2} & =-\\frac{7}{2}B \\\\ B & =-1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\frac{3x+5}{(x-3)(2x+1)}=\\frac{2}{x-3}+\\frac{-1}{2x+1}.\n$$"}]}
