8e8f" "q-129269/selection/ef606e8d81ccc6d79e1ebf11b4aa45400b75bfeb5395e9110e9fd3d9a5e6e8bc"] :db/ensure [:answer-field/validate]} {:db/id "q-129269" :question/id #uuid "cec9543d-3be0-5419-a7dd-c01379498092" :question/math-academy-id "q-129269" :question/problem "Calculate \n${\\int }_{1}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{5}f(t)\\,\\text{d}t=⟨8,\\,-4,\\,4⟩$\nand\n${\\int }_{3}^{5}f(t)\\,\\text{d}t=⟨4,\\,-2,\\,2⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{1}^{5}f(t)\\,\\text{d}t={\\int }_{1}^{3}f(t)\\,\\text{d}t+{\\int }_{3}^{5}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{3}f(t)\\,\\text{d}t={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{3}^{5}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}f(t)\\,\\text{d}t & ={\\int }_{1}^{5}f(t)\\,\\text{d}t-{\\int }_{3}^{5}f(t)\\,\\text{d}t \\\\  & =⟨8,\\,-4,\\,4⟩-⟨4,\\,-2,\\,2⟩ \\\\  & =⟨4,\\,-2,\\,2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129269/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00"] :knowledge-point/questions ["q-129269"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98216/selection/e6d9c1a9cb9594b4ec87ddfa0f0b59df7c4730b6ee22e9e7170b1dde06abae65" :answer/id #uuid "c660023e-80e1-5ae5-9285-67938de68941" :answer/type :answer.type/math :answer/value "⟨10,\\,-9,\\,11⟩" :db/ensure [:answer/validate]} {:db/id "q-98216/selection/9b823edeb3b78ca8453e3b844b1c8c3eeda2b496ea7742c48a240151fbb1010a" :answer/id #uuid "36adf932-fc5c-5141-ad73-55fa5c954a3c" :answer/type :answer.type/math :answer/value "⟨2,\\,-9,\\,3⟩" :db/ensure [:answer/validate]} {:db/id "q-98216/selection/44783a1ad23165ecae9726809cfc384f435168b2a9b43375fcf01d01d3ee82ef" :answer/id #uuid "e1a84646-5287-5ed7-ab41-5461c13eb082" :answer/type :answer.type/math :answer/value "⟨2,\\