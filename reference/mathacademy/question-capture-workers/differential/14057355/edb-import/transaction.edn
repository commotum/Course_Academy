0b5a1383d0fde14734e167597367196514a346a61cd5b"] :db/ensure [:answer-field/validate]} {:db/id "q-129140" :question/id #uuid "3649b2fe-dd3f-5319-9372-b19d8b8dbcb0" :question/math-academy-id "q-129140" :question/problem "Calculate \n${\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{4}f(t)\\,\\text{d}t=⟨-1,\\,-2,\\,1⟩$\nand \n${\\int }_{0}^{4}g(t)\\,\\text{d}t=⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t=3{\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{0}^{4}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t & =3{\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{0}^{4}g(t)\\,\\text{d}t \\\\  & =3⟨-1,\\,-2,\\,1⟩-⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩ \\\\  & =⟨-3,\\,-6,\\,3⟩-⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩ \\\\  & =⟨-3-\\operatorname{ln}⁡2,\\,-10,\\,4⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129140/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0333b70a-2ede-5c8d-b298-4d25ae4d4667"] :knowledge-point/questions ["q-129140"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98170/selection/8a07cc37bd76d2e537e96e3ab371c5a730f96b009a75d3a48996500648e5ac59" :answer/id #uuid "0b9a7a62-7f69-5fad-bfc6-cfe0d984a72c" :answer/type :answer.type/math :answer/value "⟨\\operatorname{ln}⁡3,\\,\\sqrt{3},\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-98170/selection/94295c7023f67052c4666ce553d0620abbb45f42c6643bd4744b405a5793d175" :answer/id #uuid "64646d8b-0bae-58fe-bd81-d9d8f4d3f4f9" :answer/type :answer.type/math :answer/value "⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩" :db/ensure [:answer/validate]} {:db/id "q-98170/selection/5a018a289c467af3a03e674d5686dbdcad8bbe1c19096e61301ebe5bd06b3612" :answer/id #uuid "62ea9f3f-f705-5e6f-a964-89a8dc5c1620" :answer/type :answer.type/math :answer/value "⟨8+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-12⟩" :db/ensure [:answer/validate]} {:db/id "q-98170/selection/77d6828720278972dc516534027104572fffdfab0b9e0ac0ef1b77b27e4ed9ec" :answer/id #uuid "813f5056-0abd-5737-88f8-b50ef5318e7f" :answer/type :answer.type/math :answer/value "⟨-8+\\operatorname{ln}⁡3,\\,1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-98170/selection/24786830df061d6a0127211b5803944adaec2ad672898783ed1db21ba7ae3383" :answer/id #uuid "ef0417a5-f5f4-509c-ab72-c73e948424fb" :answer/type :answer.type/math :answer/value "⟨3-\\operatorname{ln}⁡3,\\,\\sqrt{3}-3,\\,8⟩" :db/ensure [:answer/validate]} {:db/id "q-98170/selection" :answer-field/id #uuid "7e3fde31-8e39-550b-9c55-4c365b91e3f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-98170/selection/94295c7023f67052c4666ce553d0620abbb45f42c6643bd4744b405a5793d175" :answer-field/choices ["q-98170/selection/8a07cc37bd76d2e537e96e3ab371c5a730f96b009a75d3a48996500648e5ac59" "q-98170/selection/94295c7023f67052c4666ce553d0620abbb45f42c6643bd4744b405a5793d175" "q-98170/selection/5a018a289c467af3a03e674d5686dbdcad8bbe1c19096e61301ebe5bd06b3612" "q-98170/selection/77d6828720278972dc516534027104572fffdfab0b9e0ac0ef1b77b27e4ed9ec" "q-98170/selection/24786830df061d6a0127211b5803944adaec2ad672898783ed1db21ba7ae3383"] :db/ensure [:answer-field/validate]} {:db/id "q-98170" :question/id #uuid "4c2ff90f-3df2-5a7a-ae8c-1f49f03b53d3" :question/math-academy-id "q-98170" :question/problem "Calculate ${\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t$ given that ${\\int }_{1}^{3}f(t)\\,\\text{d}t=⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩$ and ${\\int }_{1}^{3}g(t)\\,\\text{d}t=⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}[f(t)+4g(t)]\\,\\text{d}t & ={\\int }_{1}^{3}f(t)\\,\\text{d}t+4{\\int }_{1}^{3}g(t)\\,\\text{d}t \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+4⟨\\frac{3}{4},\\,\\frac{1}{2},\\,-\\frac{5}{2}⟩ \\\\  & =⟨\\operatorname{ln}⁡3,\\,\\sqrt{3}-1,\\,2⟩+⟨3,\\,2,\\,-10⟩ \\\\  & =⟨3+\\operatorname{ln}⁡3,\\,\\sqrt{3}+1,\\,-8⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-98170/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0333b70a-2ede-5c8d-b298-4d25ae4d4667"] :knowledge-point/questions ["q-98170"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129143/selection/338eb1d35d0dc55cbdc5f5d4f63fdb0d2c6ca0949172a8dca4460785d852792b" :answer/id #uuid "e5c612b5-2a78-5b30-9676-d8f252c8d7f9" :answer/type :answer.type/math :answer/value "⟨-2,\\,3,\\,9⟩" :db/ensure [:answer/validate]} {:db/id "q-129143/selection/9ffdc115a4eff7aceda0d912e32b0e4658c3c48587f8b3aef91b705656f7b727" :answer/id #uuid "b37c21ba-1e55-5c32-b4ae-4090a8e95b64" :answer/type :answer.type/math :answer/value "⟨-\\frac{3}{2},\\,5,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "q-129143/selection/d5b977205faba8da66236297d9b49731af49812fe4c8fb12691b0bdb377a1da2" :answer/id #uuid "3628450d-8524-560c-bcc3-69f560cd2bb2" :answer/type :answer.type/math :answer/value "⟨-1,\\,9,\\,8⟩" :db/ensure [:answer/validate]} {:db/id "q-129143/selection/4548f7ee008061cf66cd7caa4625ef70a124c49341e174f2ce6523b4c3e74a8f" :answer/id #uuid "40c6b1fc-043a-51f3-8948-15a1c325c021" :answer/type :answer.type/math :answer/value "⟨2,\\,-4,\\,6⟩" :db/ensure [:answer/validate]} {:db/id "q-129143/selection/ed0390dbfdf752634d67f95c72544288f84e961aa51765b6570c3a4ae70f6bd7" :answer/id #uuid "375eae04-6f3c-590b-8049-91536355e4a4" :answer/type :answer.type/math :answer/value "⟨-\\frac{1}{2},\\,3,\\,5⟩" :db/ensure [:answer/validate]} {:db/id "q-129143/selection" :answer-field/id #uuid "edbee573-214e-55a2-acd7-b88d1dd8cc43" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129143/selection/d5b977205faba8da66236297d9b49731af49812fe4c8fb12691b0bdb377a1da2" :answer-field/choices ["q-129143/selection/338eb1d35d0dc55cbdc5f5d4f63fdb0d2c6ca0949172a8dca4460785d852792b" "q-129143/selection/9ffdc115a4eff7aceda0d912e32b0e4658c3c48587f8b3aef91b705656f7b727" "q-129143/selection/d5b977205faba8da66236297d9b49731af49812fe4c8fb12691b0bdb377a1da2" "q-129143/selection/4548f7ee008061cf66cd7caa4625ef70a124c49341e174f2ce6523b4c3e74a8f" "q-129143/selection/ed0390dbfdf752634d67f95c72544288f84e961aa51765b6570c3a4ae70f6bd7"] :db/ensure [:answer-field/validate]} {:db/id "q-129143" :question/id #uuid "884c105d-2d38-575b-867c-4a537e66762f" :question/math-academy-id "q-129143" :question/problem "Calculate ${\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\text{d}t$ given that ${\\int }_{-1}^{1}f(t)\\,\\text{d}t=⟨\\frac{1}{2},\\,6,\\,-1⟩$ and ${\\int }_{-1}^{1}g(t)\\,\\text{d}t=⟨1,\\,-2,\\,-6⟩.$" :question/worked-solution "From the vector addition and scalar multiplication rules, we have\n \n\n$$\n{\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\text{d}t={\\int }_{-1}^{1}f(t)\\,\\text{d}t-\\frac{3}{2}{\\int }_{-1}^{1}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\,\\text{d}t & ={\\int }_{-1}^{1}f(t)\\,\\text{d}t-\\frac{3}{2}{\\int }_{-1}^{1}g(t)\\,\\text{d}t \\\\  & =⟨\\frac{1}{2},\\,6,\\,-1⟩-\\frac{3}{2}⟨1,\\,-2,\\,-6⟩ \\\\  & =⟨\\frac{1}{2},\\,6,\\,-1⟩-⟨\\frac{3}{2}\\,-3,\\,-9⟩ \\\\  & =⟨-1,\\,9,\\,8⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129143/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0333b70a-2ede-5c8d-b298-4d25ae4d4667"] :knowledge-point/questions ["q-129143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-98158/selection/5e45da8563b93e969c06efc02ff44966c74d1680034f5b936871b6bd68df60be" :answer/id #uuid "459200f5-8c29-51d1-9358-59989cbbb48b" :answer/type :answer.type/math 