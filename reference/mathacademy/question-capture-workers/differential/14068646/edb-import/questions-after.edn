/question-capture-workers/differential/14068646/assets/80f1cb1edcbf35c4a3b87c0954a9302729f066d8dadf6205de7231343ab6e998.png)"}] [{:db/id #edb/ref 17592186358044 :knowledge-point/_questions [{:knowledge-point/id #uuid "129bee33-7c18-5450-affe-dd710a3a75dd" :knowledge-point/title "Identifying a Trajectory Given a Starting Point and the Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3626c7cb-b348-5fe7-a575-8e0aea0e5087" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/80d758f23c0962d0611fca95f5ce5e7654346f133ceb7cf1275aaf3071ed1838.png" :db/id #edb/ref 17592186358046} {:answer/id #uuid "fbc09267-47e9-59df-9d3a-f5dfdf046bb1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/e3b4b7001ce149759e4356b594dace06641e815860d33a6e2a2b3143078b58fa.png" :db/id #edb/ref 17592186358047} {:answer/id #uuid "eee627e0-4f08-5323-a973-d0aa4fe0386e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/c1517d81fb17366779bf77a0608f5f8d691f302d009d0f677a6ca0c6c02cd527.png" :db/id #edb/ref 17592186358048} {:answer/id #uuid "bc292221-1783-548d-af6d-0b5536f2b4b7" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/0f513a1fb254df7d6a6aaaa13632a0312b5483b622bcc83a154b4e80bd392a42.png" :db/id #edb/ref 17592186358049} {:answer/id #uuid "d35b51a5-27e4-547a-969f-8cd374741770" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/f49c17becabf4088e886ddfc8e086c81184d94e6637c4445820