 and slightly to the left, suggesting that it may converge to the origin\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/cc53577a278595e5f0155119aa5eb1a7b27ec01847a6daa1ba6ade6792c5f5e9.png)"}] [{:db/id #edb/ref 17592186358065 :knowledge-point/_questions [{:knowledge-point/id #uuid "129bee33-7c18-5450-affe-dd710a3a75dd" :knowledge-point/title "Identifying a Trajectory Given a Starting Point and the Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "07ee316a-9d33-55ab-b3c5-30557c12eeff" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/cb52d9d9ef4cd24d0c938de72ea03eaefd8c2b1d5599c98c703f3cb47b983be8.png" :db/id #edb/ref 17592186358067} {:answer/id #uuid "02d95112-a4b0-5500-a3bd-476d4e20c13c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/bb68c8ee36c2053ca96e8606e50ce2e349d9c30c615adf111a506d93097fe7ce.png" :db/id #edb/ref 17592186358068} {:answer/id #uuid "8ac8fc72-f86c-518e-8d4f-a8e28bcff687" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/95d3d5e8b9e4b1dcfc5cd8830786810ca32fb3b8ebe7024a5f6e827b6a453d3d.png" :db/id #edb/ref 17592186358069} {:answer/id #uuid "d78dba57-e0b2-56d0-86d1-14a22dd7fdbd" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/1b44cc5bb4a68bdf206e275217f0e78823ce4ebe9f6eb883ac9fa1c90b4785ad.png" :db/id #edb/ref 17592186358070} {:answer/id #uuid "5ef2dd73-1382-5725-9a8a-4c0a8f1ec473" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Cours