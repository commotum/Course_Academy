/validate]} {:db/id "q-332658/field-2/2d6cfdfd554881720879744154242fb5aa6f8fe5d2ee6c2ca18d39657060f0e9" :answer/id #uuid "e2f1b0a5-d7d4-5507-9349-52448b67e418" :answer/type :answer.type/math :answer/value "3x" :db/ensure [:answer/validate]} {:db/id "q-332658/field-2/d6b5570fbaceabe9faf7dbb2ea705a046f89a46da35e1214df46509a1448d523" :answer/id #uuid "80eed389-a444-5e8d-8826-d9ca99dc1d7b" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}x" :db/ensure [:answer/validate]} {:db/id "q-332658/field-2" :answer-field/id #uuid "675deec6-b58c-5c9b-9a0d-b3927c590a60" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-332658/field-2/d7fe01db6a38c7197e125f1477c4e6a65721bcfca0421e4610184e71944e8700" :answer-field/choices ["q-332658/field-2/d7fe01db6a38c7197e125f1477c4e6a65721bcfca0421e4610184e71944e8700" "q-332658/field-2/07c71ea73bb8110bc7a6da95b843ea949731374fc7b33be3dc0291a2b916365d" "q-332658/field-2/2d6cfdfd554881720879744154242fb5aa6f8fe5d2ee6c2ca18d39657060f0e9" "q-332658/field-2/d6b5570fbaceabe9faf7dbb2ea705a046f89a46da35e1214df46509a1448d523"] :db/ensure [:answer-field/validate]} {:db/id "q-332658" :question/id #uuid "b542651b-d070-5a59-859e-b7499927eee6" :question/math-academy-id "q-332658" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-x(t)-y(t) \\\\ {y}^{′}(t)=3x(t)-2y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. Find equations of the $x$- and $y$-nullclines for the corresponding phase space.\n$\\,$\nThe $x$-nullcline is $y=$ {{field-1}}. \n\n$\\,$\nThe $y$-nullcline is $y=$ {{field-2}}." :question/worked-solution "Recall that: \n\n- The $x$-nullcline is a line for which ${x}^{′}=0$ (i.e., the tangents to trajectories are vertical). So, to find it, we set the first equation of the system equal to $0:$\n\n$$\n-x-y=0\\,⇒\\,y=-x\n$$\n\n- The $y$-nullcline is a line for which ${y}^{′}=0$ (i.e., the tangents to trajectories are horizontal). So, to find it, we set the second equation of the system equal to $0:$\n\n$$\n3x-2y=0\\,⇒\\,y=\\frac{3}{2}x\n$$\n\nPlotting these in the phase space, we obtain the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068646/assets/3b064f5f1b2e1a2c8bc3146b4b44a8d2e7b0ab7a83856488bde00ac6ab875efe.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332658/field-1" "q-332658/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d219270-5202-54e6-8cba-dc816155bd7b"] :knowledge-point/questions ["q-332658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332661/field-1/bb788110c1ace150fd159ec9831f6605760ed01de8732dd8da141de601bd9fe8" :answer/id #uuid "1c3bfd49-1470-5bd6-9328-7e747b715478" :answer/type :answer.type/math :answer/value "\\frac{5}{2}x" :db/ensure [:answer/validate]} {:db/id "q-332661/field-1/412793739940b973be2b527fb17aec02d6ca6345201ec8cd477bb75bb5283b50" :answer/id #uuid "9eb1dfa4-7065-568b-a29c-4d75ff1d3916" :answer/type :answer.type/math :answer/value "-2x" :db/ensure [:answer/validate]} {:db/id "q-332661/field-1/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" :answer/id #uuid "1c23f6a3-c66c-5f4b-8ef8-18ed5320a2fe" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "q-332661/field-1/bdd87197c262ddf76769d2d64dfaff5e57d3024b6de5b1092e428f681bc5ff02" :answer/id #uuid "125fcb9f-32f1-583a-8a77-f585c13aa838" :answer/type :answer.type/math :answer/value "-\\frac{5}{2}x" :db/ensure [:answer/validate]} {:db/id "q-332661/field-1" :answer-field/id #uuid "c1cb755d-d7e7-5b57-9eee-a25d8cfc9b9d" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-332661/field-1/bb788110c1ace150fd159ec9831f6605760ed01de8732dd8da141de601bd9fe8" :answer-field/choices ["q-332661/field-1/bb788110c1ace150fd159ec9831f6605760ed01de8732dd8da141de601bd9fe8" "q-332661/field-1/412793739940b973be2b527fb17aec02d6ca63