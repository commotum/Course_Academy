[{:db/id "q-78964/selection/5ad454ee767578853a69bf15b694b58206657c3ca4cc472ba2467cb7ddc143df" :answer/id #uuid "94797d45-9919-5857-a21b-be221721a82e" :answer/type :answer.type/math :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)+1)+C" :db/ensure [:answer/validate]} {:db/id "q-78964/selection/e0c96ab68ddd3326f0bf749b7a718dac208fbeb66ae26c5837aea59dcc566d01" :answer/id #uuid "5e2b0f91-442c-5284-9dbb-9b76dd8b252d" :answer/type :answer.type/math :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78964/selection/80d82674e49075a8ec31bf45aed43f2e3dfb822fd85ce4ddb9dd0b308d5b8a38" :answer/id #uuid "b4532591-3b15-578a-aac5-2d4e61b6f7e6" :answer/type :answer.type/math :answer/value "\\frac{25{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78964/selection/76946cbb06bdb10369482712e867f8e15430470845db4227ce4a8e118021ccb0" :answer/id #uuid "8fea396c-1162-5caa-9480-0fdcd3de192f" :answer/type :answer.type/math :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78964/selection/a25d6da555101f6f10bd416011b4d29edff000eb32b697c1fec1e4e1782d2bcd" :answer/id #uuid "1157d581-7a21-56ea-8ad1-63187734e110" :answer/type :answer.type/math :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" :db/ensure [:answer/validate]} {:db/id "q-78964/selection" :answer-field/id #uuid "9c9749b9-7526-5c01-9741-db41e8608590" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-78964/selection/76946cbb06bdb10369482712e867f8e15430470845db4227ce4a8e118021ccb0" :answer-field/choices ["q-78964/selection/5ad454ee767578853a69bf15b694b58206657c3ca4cc472ba2467cb7ddc143df" "q-78964/selection/e0c96ab68ddd3326f0bf749b7a718dac208fbeb66ae26c5837aea59dcc566d01" "q-78964/selection/80d82674e49075a8ec31bf45aed43f2e3dfb822fd85ce4ddb9dd0b308d5b8a38" "q-78964/selection/76946cbb06bdb10369482712e867f8e15430470845db4227ce4a8e118021ccb0" "q-78964/selection/a25d6da555101f6f10bd416011b4d29edff000eb32b697c1fec1e4e1782d2bcd"] :db/ensure [:answer-field/validate]} {:db/id "q-78964" :question/id #uuid "22c481da-5f59-5a94-b0f0-466987b6a096" :question/math-academy-id "q-78964" :question/problem "Calculate $\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(5x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡5} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{5}⁡(5x)\\cdot (5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡5}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡5}-\\frac{{x}^{5}}{\\operatorname{ln}⁡5}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{5}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-78964/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413"] :knowledge-point/questions ["q-78964"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351049/field-1/ef81cb876dc75f70f5fc4a667407055d5ee69ef0504591cc7261a08a2cd96e6b" :answer/id #uuid "5d9dd781-040d-5b5b-ae86-becc6878db7b" :answer/type :answer.type/math :answer/value "\\frac{e^2+1}{4}" :db/ensure [:answer/validate]} {:db/id "q-351049/field-1" :answer-field/id #uuid "d7c3c7f6-b15a-5392-928f-0dd50b0aa767" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351049/field-1/ef81cb876dc75f70f5fc4a667407055d5ee69ef0504591cc7261a08a2cd96e6b" :answer-field/choices ["q-351049/field-1/ef81cb876dc75f70f5fc4a667407055d5ee69ef0504591cc7261a08a2cd96e6b"] :db/ensure [:answer-field/validate]} {:db/id "q-351049" :question/id #uuid "a03fd2b0-369d-5e9a-a0ba-867654d1e366" :question/math-academy-id "q-351049" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x={\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x+1)\\, & ⟹\\,{u}^{′}=\\frac{4}{4x+1} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x & ={\\int }_{0}^{({e}^{2}-1)/4}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡(4x+1)\\,(x){|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}x(\\frac{4}{4x+1})\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({e}^{2})(\\frac{{e}^{2}-1}{4})-{\\int }_{0}^{({e}^{2}-1)/4}\\frac{4x}{4x+1}\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{4}\\cdot 2-{\\int }_{0}^{({e}^{2}-1)/4}(1-\\frac{1}{4x+1})\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{2}-{[x-\\frac{1}{4}\\operatorname{ln}⁡(4x+1)]}_{0}^{({e}^{2}-1)/4} \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{4}\\operatorname{ln}⁡({e}^{2})) \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{2}) \\\\  & =\\frac{1}{4}({e}^{2}+1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351049/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759"] :knowledge-point/questions ["q-351049"] :db/ensure [:knowledge-point/validate]}]
