5a2eef424da3ef13af3ea5c2025f7c24df111c7a4d1febae3b9" "basis" 1324 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012554/edb-import/verification.json"} {"question" "q-114597" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "e\\operatorname{ln}⁡3+\\frac{1}{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012554/state.json" "file_sha256" "4aa38037df6f95a2eef424da3ef13af3ea5c2025f7c24df111c7a4d1febae3b9" "basis" 1324 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012554/edb-import/verification.json"} {"question" "q-114597" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "e\\operatorname{ln}⁡3-\\frac{1}{6}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012554/state.json" "file_sha256" "4aa38037df6f95a2eef424da3ef13af3ea5c2025f7c24df111c7a4d1febae3b9" "basis" 1324 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012554/edb-import/verification.json"} {"question" "q-114597" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "e\\operatorname{ln}⁡3+\\frac{1}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012554/state.json" "file_sha256" "4aa38037df6f95a2eef424da3ef13af3ea5c2025f7c24df111c7a4d1febae3b9" "basis" 1324 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012554/edb-import/verification.json"}] "sources" [{"question" "q-78964" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-78964" "field" nil "attribute" "question/worked-solution" "value" "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(5x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡5} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{5}⁡(5x)\\cdot (5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡5}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡5}-\\frac{{x}^{5}}{\\operatorname{ln}⁡5}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{5}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-78964" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/activity-metadata.json" "file_sha256" "f20f849c207de2088fe5589ed17973fbb3a929ead45794af41f82cc65bbd9539"} {"question" "q-78964" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-78964" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{25{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C"] ["math" "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C"] ["math" "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)+1)+C"] ["math" "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C"] ["math" "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-78964" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114556" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114556" "field" nil "attribute" "question/worked-solution" "value" "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{4}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ {v}^{′}=\\frac{1}{{x}^{4}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{4}}\\,\\text{d}x=-\\frac{1}{3{x}^{3}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{4}⁡(2x)\\cdot (-\\frac{1}{3{x}^{3}})-\\int (-\\frac{1}{3{x}^{3}})(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}\\int \\frac{1}{{x}^{4}}\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}(-\\frac{1}{3{x}^{3}})+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)}{3{x}^{3}\\operatorname{ln}⁡4}-\\frac{1}{9{x}^{3}\\operatorname{ln}⁡4}+C \\\\  & =-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{4}⁡(2x)=\\frac{\\operatorname{ln}⁡(2x)}{\\operatorname{ln}⁡4}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114556" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/activity-metadata.json" "file_sha256" "f20f849c207de2088fe5589ed17973fbb3a929ead45794af41f82cc65bbd9539"} {"question" "q-114556" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114556" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C"] ["math" "-\\frac{6\\operatorname{ln}⁡(2x)+1}{2{x}^{3}\\operatorname{ln}⁡4}+C"] ["math" "-\\frac{6\\operatorname{ln}⁡(2x)-1}{9{x}^{3}\\operatorname{ln}⁡4}+C"] ["math" "-\\frac{\\operatorname{ln}⁡(2x)+1}{3{x}^{3}\\operatorname{ln}⁡4}+C"] ["math" "-\\frac{\\operatorname{ln}⁡(2x)-1}{9{x}^{3}\\operatorname{ln}⁡4}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114556" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114557" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{8\\operatorname{ln}⁡x}{{x}^{5}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114557" "field" nil "attribute" "question/worked-solution" "value" "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=\\frac{8}{{x}^{5}}\\, & ⟹\\,v=\\int \\frac{8}{{x}^{5}}\\,\\text{d}x=-\\frac{2}{{x}^{4}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{8\\operatorname{ln}⁡x}{{x}^{5}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x\\cdot (-\\frac{2}{{x}^{4}})-\\int (-\\frac{2}{{x}^{4}})(\\frac{1}{x})\\,\\text{d}x \\\\  & =-\\frac{2\\operatorname{ln}⁡x}{{x}^{4}}+2\\int \\frac{1}{{x}^{5}}\\,\\text{d}x \\\\  & =-\\frac{2\\operatorname{ln}⁡x}{{x}^{4}}-\\frac{1}{2{x}^{4}}+C \\\\  & =-\\frac{4\\operatorname{ln}⁡x+1}{2{x}^{4}}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114557" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/activity-metadata.json" "file_sha256" "f20f849c207de2088fe5589ed17973fbb3a929ead45794af41f82cc65bbd9539"} {"question" "q-114557" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114557" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{2\\operatorname{ln}⁡x+1}{4{x}^{4}}+C"] ["math" "-\\frac{2\\operatorname{ln}⁡x-3}{{x}^{4}}+C"] ["math" "-\\frac{4\\operatorname{ln}⁡x+1}{2{x}^{4}}+C"] ["math" "-\\frac{\\operatorname{ln}⁡x+2}{{x}^{4}}+C"] ["math" "-\\frac{\\operatorname{ln}⁡x-1}{4{x}^{4}}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114557" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{4\\operatorname{ln}⁡x+1}{2{x}^{4}}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114597" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{1/3}^{e}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114597" "field" nil "attribute" "question/worked-solution" "value" "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e}\\operatorname{ln}⁡(3x)\\text{d}x & ={\\int }_{1/3}^{e}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1/3}^{e}-{\\int }_{1/3}^{e}v{u}^{′}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(3x){|}_{1/3}^{e}-{\\int }_{1/3}^{e}x(\\frac{1}{x})\\,\\text{d}x \\\\  & =e\\operatorname{ln}⁡(3e)-\\frac{1}{3}\\operatorname{ln}⁡1-{\\int }_{1/3}^{e}\\,\\text{d}x \\\\  & =e\\operatorname{ln}⁡(3e)-x{|}_{1/3}^{e}\\, \\\\  & =e\\operatorname{ln}⁡(3e)-(e-\\frac{1}{3}) \\\\  & =e\\operatorname{ln}⁡3+e-e+\\frac{1}{3} \\\\  & =e\\operatorname{ln}⁡3+\\frac{1}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114597" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/activity-metadata.json" "file_sha256" "f20f849c207de2088fe5589ed17973fbb3a929ead45794af41f82cc65bbd9539"} {"question" "q-114597" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114597" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3e\\operatorname{ln}⁡3+\\frac{2}{3}"] ["math" "\\operatorname{ln}⁡3+3e"] ["math" "e\\operatorname{ln}⁡3+1"] ["math" "e\\operatorname{ln}⁡3+\\frac{1}{3}"] ["math" "e\\operatorname{ln}⁡3-\\frac{1}{6}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-114597" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "e\\operatorname{ln}⁡3+\\frac{1}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-351049" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-351049" "field" nil "attribute" "question/worked-solution" "value" "First, we write the integral as\n\n$$\n{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x={\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x+1)\\, & ⟹\\,{u}^{′}=\\frac{4}{4x+1} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x & ={\\int }_{0}^{({e}^{2}-1)/4}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡(4x+1)\\,(x){|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}x(\\frac{4}{4x+1})\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({e}^{2})(\\frac{{e}^{2}-1}{4})-{\\int }_{0}^{({e}^{2}-1)/4}\\frac{4x}{4x+1}\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{4}\\cdot 2-{\\int }_{0}^{({e}^{2}-1)/4}(1-\\frac{1}{4x+1})\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{2}-{[x-\\frac{1}{4}\\operatorname{ln}⁡(4x+1)]}_{0}^{({e}^{2}-1)/4} \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{4}\\operatorname{ln}⁡({e}^{2})) \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{2}) \\\\  & =\\frac{1}{4}({e}^{2}+1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/state.json" "file_sha256" "5dfae0a02a98b305a9a5fa54ac435ff6bc1020aa466623d06b2f8c1d5c488bad"} {"question" "q-351049" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14060585/activity-metadata.json" "file_sha256" "f20f849c207de2088fe5589ed17973fbb3a929ead45794af41f82cc65bbd9539"