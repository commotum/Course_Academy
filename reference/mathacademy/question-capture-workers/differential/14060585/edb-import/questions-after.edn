#{[{:db/id #edb/ref 17592186300069 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19e32fa8-90ab-5f78-a1da-cf421141cb00" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186300071} {:answer/id #uuid "8193345e-f5e5-5582-9492-3d0696344172" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6\\operatorname{ln}⁡(2x)-1}{9{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186300072} {:answer/id #uuid "4ba52cda-c7be-5591-a551-1a8aca9e19bd" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡(2x)+1}{3{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186300073} {:answer/id #uuid "839ff85f-c34c-5c3c-b037-815079fd6655" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡(2x)-1}{9{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186300074} {:answer/id #uuid "40e0240f-2655-5b8d-956c-6b0ceb344a06" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{6\\operatorname{ln}⁡(2x)+1}{2{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186300075}] :answer-field/correct {:answer/id #uuid "19e32fa8-90ab-5f78-a1da-cf421141cb00" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C" :db/id #edb/ref 17592186300071} :answer-field/id #uuid "eeb504cb-d712-53f5-9c85-be74cc3f59eb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300070}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a4eb688e-c5f1-5e1b-a808-764b83388ee2" :question/math-academy-id "q-114556" :question/problem "Calculate $\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{4}⁡(2x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡4} \\\\ {v}^{′}=\\frac{1}{{x}^{4}}\\, & ⟹\\,v=\\int \\frac{1}{{x}^{4}}\\,\\text{d}x=-\\frac{1}{3{x}^{3}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{4}⁡(2x)}{{x}^{4}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{4}⁡(2x)\\cdot (-\\frac{1}{3{x}^{3}})-\\int (-\\frac{1}{3{x}^{3}})(\\frac{1}{x\\operatorname{ln}⁡4})\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}\\int \\frac{1}{{x}^{4}}\\,\\text{d}x \\\\  & =-\\frac{{log}_{4}⁡(2x)}{3{x}^{3}}+\\frac{1}{3\\operatorname{ln}⁡4}(-\\frac{1}{3{x}^{3}})+C \\\\  & =-\\frac{\\operatorname{ln}⁡(2x)}{3{x}^{3}\\operatorname{ln}⁡4}-\\frac{1}{9{x}^{3}\\operatorname{ln}⁡4}+C \\\\  & =-\\frac{3\\operatorname{ln}⁡(2x)+1}{9{x}^{3}\\operatorname{ln}⁡4}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{4}⁡(2x)=\\frac{\\operatorname{ln}⁡(2x)}{\\operatorname{ln}⁡4}.$"}] [{:db/id #edb/ref 17592186300076 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "285bdb56-5409-582c-800d-189504dbf9ff" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡x-1}{4{x}^{4}}+C" :db/id #edb/ref 17592186300078} {:answer/id #uuid "8f5551ec-5a91-5363-81d0-33b0cb469957" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\operatorname{ln}⁡x+2}{{x}^{4}}+C" :db/id #edb/ref 17592186300079} {:answer/id #uuid "e31068fc-b371-575f-a19f-d589ea2f95f2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2\\operatorname{ln}⁡x+1}{4{x}^{4}}+C" :db/id #edb/ref 17592186300080} {:answer/id #uuid "8a87d984-3417-54ea-becb-78dd91989f84" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4\\operatorname{ln}⁡x+1}{2{x}^{4}}+C" :db/id #edb/ref 17592186300081} {:answer/id #uuid "b165f745-5390-5660-a992-74e8fb8ae3c6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2\\operatorname{ln}⁡x-3}{{x}^{4}}+C" :db/id #edb/ref 17592186300082}] :answer-field/correct {:answer/id #uuid "8a87d984-3417-54ea-becb-78dd91989f84" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4\\operatorname{ln}⁡x+1}{2{x}^{4}}+C" :db/id #edb/ref 17592186300081} :answer-field/id #uuid "f5f211b5-dbbd-5025-9531-2d53fbdf405e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300077}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5bbf57b0-6d8b-508e-9a69-4026c9515f49" :question/math-academy-id "q-114557" :question/problem "Calculate $\\int \\frac{8\\operatorname{ln}⁡x}{{x}^{5}}\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡x\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=\\frac{8}{{x}^{5}}\\, & ⟹\\,v=\\int \\frac{8}{{x}^{5}}\\,\\text{d}x=-\\frac{2}{{x}^{4}}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int \\frac{8\\operatorname{ln}⁡x}{{x}^{5}}\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡x\\cdot (-\\frac{2}{{x}^{4}})-\\int (-\\frac{2}{{x}^{4}})(\\frac{1}{x})\\,\\text{d}x \\\\  & =-\\frac{2\\operatorname{ln}⁡x}{{x}^{4}}+2\\int \\frac{1}{{x}^{5}}\\,\\text{d}x \\\\  & =-\\frac{2\\operatorname{ln}⁡x}{{x}^{4}}-\\frac{1}{2{x}^{4}}+C \\\\  & =-\\frac{4\\operatorname{ln}⁡x+1}{2{x}^{4}}+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant."}] [{:db/id #edb/ref 17592186300097 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7705c3a4-0e35-509d-9808-fa04f351083f" :answer/type {:db/ident :answer.type/math} :answer/value "e\\operatorname{ln}⁡3+1" :db/id #edb/ref 17592186300099} {:answer/id #uuid "2523163f-f6c8-593f-84d3-2cc72115ce70" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3+3e" :db/id #edb/ref 17592186300100} {:answer/id #uuid "b7142bcd-73dd-5cf7-b9e8-132f3589d839" :answer/type {:db/ident :answer.type/math} :answer/value "3e\\operatorname{ln}⁡3+\\frac{2}{3}" :db/id #edb/ref 17592186300101} {:answer/id #uuid "1a2bdbe1-f3b7-5f26-82ea-a5b7f432f8ac" :answer/type {:db/ident :answer.type/math} :answer/value "e\\operatorname{ln}⁡3-\\frac{1}{6}" :db/id #edb/ref 17592186300102} {:answer/id #uuid "8a0193d2-3eaf-54be-ab46-a92ca0576550" :answer/type {:db/ident :answer.type/math} :answer/value "e\\operatorname{ln}⁡3+\\frac{1}{3}" :db/id #edb/ref 17592186300103}] :answer-field/correct {:answer/id #uuid "8a0193d2-3eaf-54be-ab46-a92ca0576550" :answer/type {:db/ident :answer.type/math} :answer/value "e\\operatorname{ln}⁡3+\\frac{1}{3}" :db/id #edb/ref 17592186300103} :answer-field/id #uuid "0ea2e213-fe2f-5dc2-9ef9-784bd287e6a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186300098}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "61e03c45-6b55-5bc8-8f4d-4ef143900018" :question/math-academy-id "q-114597" :question/problem "Evaluate ${\\int }_{1/3}^{e}\\operatorname{ln}⁡(3x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(3x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x} \\\\ {v}^{′}=1\\, & ⟹\\,v=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{1/3}^{e}\\operatorname{ln}⁡(3x)\\text{d}x & ={\\int }_{1/3}^{e}u{v}^{′}\\,\\text{d}x \\\\  & =uv{|}_{1/3}^{e}-{\\int }_{1/3}^{e}v{u}^{′}\\,\\text{d}x \\\\  & =x\\operatorname{ln}⁡(3x){|}_{1/3}^{e}-{\\int }_{1/3}^{e}x(\\frac{1}{x})\\,\\text{d}x \\\\  & =e\\operatorname{ln}⁡(3e)-\\frac{1}{3}\\operatorname{ln}⁡1-{\\int }_{1/3}^{e}\\,\\text{d}x \\\\  & =e\\operatorname{ln}⁡(3e)-x{|}_{1/3}^{e}\\, \\\\  & =e\\operatorname{ln}⁡(3e)-(e-\\frac{1}{3}) \\\\  & =e\\operatorname{ln}⁡3+e-e+\\frac{1}{3} \\\\  & =e\\operatorname{ln}⁡3+\\frac{1}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339709 :knowledge-point/_questions [{:knowledge-point/id #uuid "4435e346-d6ad-58cd-97cb-bbd45e121759" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing a Single Logarithmic Factor"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d9dd781-040d-5b5b-ae86-becc6878db7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^2+1}{4}" :db/id #edb/ref 17592186339711}] :answer-field/correct {:answer/id #uuid "5d9dd781-040d-5b5b-ae86-becc6878db7b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^2+1}{4}" :db/id #edb/ref 17592186339711} :answer-field/id #uuid "d7c3c7f6-b15a-5392-928f-0dd50b0aa767" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186339710}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a03fd2b0-369d-5e9a-a0ba-867654d1e366" :question/math-academy-id "q-351049" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we write the integral as\n\n$$\n{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x={\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\cdot 1\\cdot \\text{d}x.\n$$\n\n \n\nWe will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u=\\operatorname{ln}⁡(4x+1)\\, & ⟹\\,{u}^{′}=\\frac{4}{4x+1} \\\\ {v}^{′}=1\\, & ⟹\\,v=\\int 1\\cdot \\,dx=x\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{({e}^{2}-1)/4}\\operatorname{ln}⁡(4x+1)\\,\\text{d}x & ={\\int }_{0}^{({e}^{2}-1)/4}u{v}^{′}\\text{d}x \\\\  & =uv{|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}v{u}^{′}\\text{d}x \\\\  & =\\operatorname{ln}⁡(4x+1)\\,(x){|}_{0}^{({e}^{2}-1)/4}-{\\int }_{0}^{({e}^{2}-1)/4}x(\\frac{4}{4x+1})\\,\\text{d}x \\\\  & =\\operatorname{ln}⁡({e}^{2})(\\frac{{e}^{2}-1}{4})-{\\int }_{0}^{({e}^{2}-1)/4}\\frac{4x}{4x+1}\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{4}\\cdot 2-{\\int }_{0}^{({e}^{2}-1)/4}(1-\\frac{1}{4x+1})\\,\\text{d}x \\\\  & =\\frac{{e}^{2}-1}{2}-{[x-\\frac{1}{4}\\operatorname{ln}⁡(4x+1)]}_{0}^{({e}^{2}-1)/4} \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{4}\\operatorname{ln}⁡({e}^{2})) \\\\  & =\\frac{{e}^{2}-1}{2}-(\\frac{{e}^{2}-1}{4}-\\frac{1}{2}) \\\\  & =\\frac{1}{4}({e}^{2}+1).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186339712 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c987d6e-0dd9-50fa-85a0-905c93e07413" :knowledge-point/title "Using Integration by Parts to Compute an Integral Containing an Arbitrary Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94797d45-9919-5857-a21b-be221721a82e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)+1)+C" :db/id #edb/ref 17592186339714} {:answer/id #uuid "8fea396c-1162-5caa-9480-0fdcd3de192f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186339715} {:answer/id #uuid "b4532591-3b15-578a-aac5-2d4e61b6f7e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186339716} {:answer/id #uuid "1157d581-7a21-56ea-8ad1-63187734e110" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186339717} {:answer/id #uuid "5e2b0f91-442c-5284-9dbb-9b76dd8b252d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186339718}] :answer-field/correct {:answer/id #uuid "8fea396c-1162-5caa-9480-0fdcd3de192f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C" :db/id #edb/ref 17592186339715} :answer-field/id #uuid "9c9749b9-7526-5c01-9741-db41e8608590" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339713}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "22c481da-5f59-5a94-b0f0-466987b6a096" :question/math-academy-id "q-78964" :question/problem "Calculate $\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x.$" :question/worked-solution "We will solve this problem using integration by parts. We start by defining $u$ and ${v}^{′},$ as follows:\n\n$$\n\\begin{aligned}u={log}_{5}⁡(5x)\\, & ⟹\\,{u}^{′}=\\frac{1}{x\\operatorname{ln}⁡5} \\\\ {v}^{′}=25{x}^{4}\\, & ⟹\\,v=\\int 25{x}^{4}\\,\\text{d}x=5{x}^{5}\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int 25{x}^{4}{log}_{5}⁡(5x)\\,\\text{d}x & =\\int u{v}^{′}\\,\\text{d}x \\\\  & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\  & ={log}_{5}⁡(5x)\\cdot (5{x}^{5})-\\int \\frac{5{x}^{5}}{x\\operatorname{ln}⁡5}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\int 5{x}^{4}\\,\\text{d}x \\\\  & =5{x}^{5}{log}_{5}⁡(5x)-\\frac{1}{\\operatorname{ln}⁡5}\\cdot {x}^{5}+C \\\\  & =\\frac{5{x}^{5}\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡5}-\\frac{{x}^{5}}{\\operatorname{ln}⁡5}+C \\\\  & =\\frac{{x}^{5}}{\\operatorname{ln}⁡5}(5\\operatorname{ln}⁡(5x)-1)+C,\\end{aligned}\n$$\n\nwhere $C$ is an integral constant.\n\nNote that in the above calculation we used the change of base formula ${log}_{5}⁡x=\\frac{\\operatorname{ln}⁡x}{\\operatorname{ln}⁡5}.$"}]}
