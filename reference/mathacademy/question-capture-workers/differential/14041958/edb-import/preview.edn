24-8e36-ab4317ea6b73" 13194139534843 true] [17592186314063 1034 "\\frac{1}{2}v\\frac{\\text{d}v}{\\text{d}x}={cos}^{2}⁡x" 13194139534843 true] [17592186314063 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314063 1111 #uuid "84f5cccb-dc85-552b-8c0e-b6e7e907b4c6" 13194139534843 true] [17592186314064 1034 "\\frac{1}{2}\\frac{\\text{d}v}{\\text{d}x}=-{cos}^{2}⁡x" 13194139534843 true] [17592186314064 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314064 1111 #uuid "83a3e83d-eeb3-5998-a7cc-2e6b2c5041a2" 13194139534843 true] [17592186314065 1034 "4v\\frac{\\text{d}v}{\\text{d}x}=-{cos}^{2}⁡x" 13194139534843 true] [17592186314065 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314065 1111 #uuid "fd9e1f87-83cd-5482-bea8-3f859ac4bdef" 13194139534843 true] [17592186314066 1034 "v\\frac{\\text{d}v}{\\text{d}x}={cos}^{2}⁡x" 13194139534843 true] [17592186314066 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314066 1111 #uuid "56fa7dfb-62ab-5c14-9dd8-28eef246c493" 13194139534843 true] [17592186314067 1017 #edb/ref 17592186314068 13194139534843 true] [17592186314067 1089 "q-122312" 13194139534843 true] [17592186314067 1091 #edb/ref 17592186045463 13194139534843 true] [17592186314067 1100 "A particle $P$ moves along the $x$-axis in the direction of increasing $x.$ When the displacement of $P$ from the origin $O$ is $x$ meters, the velocity is given by $v(x)=(1+4{x}^{2})\\,m/s.$ Initially, $P$ is at the origin $O.$ Find $x$ as a function of time $t$ where $t\\in [0,\\frac{\\pi }{8}].$" 13194139534843 true] [17592186314067 1113 #uuid "1494f900-5c6d-561b-9ba9-7d9115f8d044" 13194139534843 true] [17592186314067 1145 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/59c4a51d419b6e42633579b687cde16a2842895c589f818942c10aa304bc98a7.png)\n\nWe're given that the velocity function $v(x)$ is\n\n$$\nv(x)=1+4{x}^{2}.\n$$\n\nWe know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=1+4{x}^{2}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =1+4{x}^{2} \\\\ \\frac{1}{1+4{x}^{2}}\\frac{\\text{d}x}{\\text{d}t} & =1 \\\\ \\int \\frac{1}{1+4{x}^{2}}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int \\,\\text{d}t \\\\ \\int \\frac{1}{1+(2x)^{2}}\\,\\text{d}x & =\\int \\,\\text{d}t \\\\ \\frac{1}{2}\\operatorname{arctan}⁡2x & =t+K \\\\ 2x & =\\operatorname{tan}⁡(2t+C) \\\\ x & =\\frac{1}{2}\\operatorname{tan}⁡(2t+C)\\end{aligned}\n$$\n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=0,$ and the particular solution is\n\n$$\nx(t)=\\frac{1}{2}\\operatorname{tan}⁡2t.\n$$" 13194139534843 true] [17592186314068 1000 #edb/ref 17592186314069 13194139534843 true] [17592186314068 1000 #edb/ref 17592186314070 13194139534843 true] [17592186314068 1000 #edb/ref 17592186314071 13194139534843 true] [17592186314068 1000 #edb/ref 17592186314072 13194139534843 true] [17592186314068 1000 #edb/ref 17592186314073 13194139534843 true] [17592186314068 1040 #edb/ref 17592186045450 13194139534843 true] [17592186314068 1041 "selection" 13194139534843 true] [17592186314068 1104 #edb/ref 17592186314070 13194139534843 true] [17592186314068 1110 #uuid "01399d4a-955d-5d24-b875-b8a046ac00c8" 13194139534843 true] [17592186314069 1034 "x(t)=\\operatorname{tan}⁡(2t-\\pi )" 13194139534843 true] [17592186314069 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314069 1111 #uuid "2ceb8256-c17a-53e1-ac22-32f6f795df58" 13194139534843 true] [17592186314070 1034 "x(t)=\\frac{1}{2}\\operatorname{tan}⁡2t" 13194139534843 true] [17592186314070 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314070 1111 #uuid "1d18169b-8026-562c-a919-850efef7b461" 13194139534843 true] [17592186314071 1034 "x(t)=2\\operatorname{tan}⁡\\pi t" 13194139534843 true] [17592186314071 1103 #edb/ref 17592186045453 13194139534843 true] [1759218631