}t}=3(x+1)^{2/3}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =3(x+1)^{2/3} \\\\ \\frac{1}{3(x+1)^{2/3}}\\frac{\\text{d}x}{\\text{d}t} & =1 \\\\ \\int \\frac{1}{3(x+1)^{2/3}}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int \\text{d}t \\\\ \\int \\frac{1}{3(x+1)^{2/3}}\\text{d}x & =\\int \\text{d}t \\\\ \\sqrt[3]{x+1} & =t+C.\\end{aligned}\n$$\n\nWe're given that $x=7$ when $t=0.$ Therefore, $C=2,$ and the particular solution is\n\n$$\n\\sqrt[3]{x+1}=t+2.\n$$\n\nFinally, writing $x$ in terms of $t,$ we have\n\n$$\n\\begin{aligned}\\sqrt[3]{x+1} & =t+2 \\\\ x+1 & =(t+2)^{3} \\\\ x & =(t+2)^{3}-1.\\end{aligned}\n$$" 13194139534843 true] [17592186314117 1000 #edb/ref 17592186314118 13194139534843 true] [17592186314117 1000 #edb/ref 17592186314119 13194139534843 true] [17592186314117 1000 #edb/ref 17592186314120 13194139534843 true] [17592186314117 1000 #edb/ref 17592186314121 13194139534843 true] [17592186314117 1000 #edb/ref 17592186314122 13194139534843 true] [17592186314117 1040 #edb/ref 17592186045450 13194139534843 true] [17592186314117 1041 "selection" 13194139534843 true] [17592186314117 1104 #edb/ref 17592186314122 13194139534843 true] [17592186314117 1110 #uuid "c9058f6f-069f-5ad6-86e6-f5d49d5d96c5" 13194139534843 true] [17592186314118 1034 "x(t)=2(t+2)^{3}-9" 13194139534843 true] [17592186314118 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314118 1111 #uuid "acfac3bb-0043-5474-baec-f7d9aad9505b" 13194139534843 true] [17592186314119 1034 "x(t)=\\sqrt[3]{t+8}+5" 13194139534843 true] [17592186314119 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314119 1111 #uuid "1f3a5543-4bab-5985-ac81-4fe61f28822a" 13194139534843 true] [17592186314120 1034 "x(t)=(t+1)^{3}+6" 13194139534843 true] [17592186314120 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314120 1111 #uuid "ddf1bff2-b361-5c1b-9cf1-6ff1b6485139" 13194139534843 true] [17592186314121 1034 "x(t)=9-\\sqrt[3]{t+8}" 13194139534843 true] [17592186314121 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314121 1111 #uuid "83791ddf-ad3a-5a14-a851-64280f33ea6f" 13194139534843 true] [17592186314122 1034 "x(t)=(t+2)^{3}-1" 13194139534843 true] [17592186314122 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314122 1111 #uuid "96855702-d802-5259-a1ca-7f4b6d0a3c6d" 13194139534843 true] [17592186314123 1017 #edb/ref 17592186314124 13194139534843 true] [17592186314123 1089 "q-122347" 13194139534843 true] [17592186314123 1091 #edb/ref 17592186045465 13194139534843 true] [17592186314123 1100 "A particle $P$ moves along the $x$-axis in the direction of decreasing $x$ where $x>0.$ When the displacement of $P$ from $O$ is $x\\,m,$ its velocity is $v\\,m/s,$ the magnitude of its acceleration is ${3}^{1-x}\\operatorname{ln}⁡3\\,{m/s}^{2}$ and the acceleration is directed toward $O.$ If $v=-2\\sqrt{2}\\,m/s$ when $x=2\\,\\text{m},$ find the velocity of $P$ when $x=1\\,\\text{m}.$ Round your answer to one decimal place." 13194139534843 true] [17592186314123 1113 #uuid "468eb29a-5370-5275-b5a4-4d18d8cf18e2" 13194139534843 true] [17592186314123 1145 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/3c5450b18c5dc58b082faadf4086b6a21c0c9b55afb016090147609a2ccfe719.png)\n\nSince the magnitude of the acceleration of the particle $P$ is ${3}^{1-x}\\operatorname{ln}⁡3\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-{3}^{1-x}\\operatorname{ln}⁡3.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-{3}^{1-x}\\operatorname{ln}⁡3.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x & =\\int [-{3}^{1-x}\\operatorname{ln}⁡3]\\,\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}={3}^{1-x}+C.\n$$\n\nNow, since $v=-2\\sqrt{2}\\,m/s$ when $x=2\\,\\text{m},$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}(-2\\sqrt{2})^{2} & ={3}^{1-2}+C \\\\ 4 & =\\frac{1}{3}+C \\\\ C & =\\frac{11}{3}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={3}^{1-x}+\\frac{11}{3} \\\\ {v}^{2} & =2({3}^{1-x}+\\frac{11}{3}) \\\\ v & =\\pm \\sqrt{2({3}^{1-x}+\\frac{11}{3})}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of decreasing $x,$ we have that $v(x)<0,$ so we can discard the positive square root. Therefore,\n\n$$\nv=-\\sqrt{2({3}^{1-x}+\\frac{11}{3})}.\n$$\n\nFinally, the velocity of $P$ at $x=1$ is given by\n\n$$\n\\begin{aligned}v & =-\\sqrt{2({3}^{1-1}+\\frac{11}{3})} \\\\  & =-\\sqrt{\\frac{28}{3}} \\\\  & ≈-3.1\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to one decimal place." 13194139534843 true] [17592186314124 1000 #edb/ref 17592186314125 13194139534843 true] [17592186314124 1000 #edb/ref 17592186314126 13194139534843 true] [17592186314124 1000 #edb/ref 17592186314127 13194139534843 true] [17592186314124 1000 #edb/ref 17592186314128 13194139534843 true] [17592186314124 1000 #edb/ref 17592186314129 13194139534843 true] [17592186314124 1040 #edb/ref 17592186045450 13194139534843 true] [17592186314124 1041 "selection" 13194139534843 true] [17592186314124 1104 #edb/ref 17592186314126 13194139534843 true] [17592186314124 1110 #uuid "18e0157c-d850-5e2a-a393-20dde143490c" 13194139534843 true] [17592186314125 1034 "-3.7\\,\\text{m/s}" 13194139534843 true] [17592186314125 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314125 1111 #uuid "d8582586-2993-58ca-894d-f1b2ef69db0a" 13194139534843 true] [17592186314126 1034 "-3.1\\,\\text{m/s}" 13194139534843 true] [17592186314126 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314126 1111 #uuid "f94514ab-0f3c-54c7-9a2c-d737fdd51916" 13194139534843 true] [17592186314127 1034 "-1.8\\,\\text{m/s}" 13194139534843 true] [17592186314127 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314127 1111 #uuid "9bc76b21-dc60-5a6e-92c7-eb9926209590" 13194139534843 true] [17592186314128 1034 "-2.9\\,\\text{m/s}" 13194139534843 true] [17592186314128 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314128 1111 #uuid "f8f35de8-12c0-5363-aa34-016ba8b66bee" 13194139534843 true] [17592186314129 1034 "-2.3\\,\\text{m/s}" 13194139534843 true] [17592186314129 1103 #edb/ref 17592186045453 13194139534843 true] [17592186314129 1111 #uuid "abff615b-88fa-5e83-979e-bf362569b025" 13194139534843 true] [17592186314130 1017 #edb/ref 17592186314131 13194139534843 true] [17592186314130 1089 "q-122349" 13194139534843 true] [17592186314130 1091 #edb/ref 17592186045464 13194139534843 true] [17592186314130 1100 "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin $O$ is $x\\,\\text{m},$ the magnitude of its acceleration is $\\frac{32}{(x+2)^{5}}\\,{m/s}^{2}$ and is directed toward $O.$ Initially, $P$ is at the origin $O$ and has velocity $v=1\\,m/s.$ Find $x$ as a function of time $t.$" 13194139534843 true] [17592186314130 1113 #uuid "b41d621c-b89a-58ab-8c66-2280c7bf01d3" 13194139534843 true] [17592186314130 1145 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/141c6dd6c91841238298b86fac1063c76faeb7cd103e13d2723f6ac05ed58f50.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\frac{32}{(x+2)^{5}}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-\\frac{32}{(x+2)^{5}}.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-\\frac{32}{(x+2)^{5}}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int -\\frac{32}{(x+2)^{5}}\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}}+K.\\end{aligned}\n$$\n\nNow, since $v=1\\,\\text{m/s}$ when $x=0\\,\\text{m},$ we can find the value of the constant $K,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}}+K \\\\ \\frac{1}{2}(1)^{2} & =\\frac{8}{(0+2)^{4}}+K \\\\ \\frac{1}{2} & =\\frac{1}{2}+K \\\\ K & =0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}} \\\\ {v}^{2} & =\\frac{16}{(x+2)^{4}} \\\\ v & =\\pm \\frac{4}{(x+2)^{2}}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing  $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=\\frac{4}{(x+2)^{2}}.\n$$\n\nNow, we know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=\\frac{4}{(x+2)^{2}}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{4}{(x+2)^{2}} \\\\ (x+2)^{2}\\frac{\\text{d}x}{\\text{d}t} & =4 \\\\ \\int (x+2)^{2}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int 4\\,\\text{d}t \\\\ \\int (x+2)^{2}\\text{d}x & =\\int 4\\,\\text{d}t \\\\ \\frac{1}{3}(x+2)^{3} & =4t+{C}_{1} \\\\ (x+2)^{3} & =12t+C\\end{aligned}\n$$\n\nwhere $C=3{C}_{1}.$ \n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=8,$ and the particular solution is\n\n$$\n(x+2)^{3}=12t+8.\n$$\n\nFinally, writing $x$ in terms of $t,$ we have\n\n$$\n\\begin{aligned}(x+2)^{3} & =12t+8 \\\\ x+2 & =\\sqrt[3]{12t+8} \\\\ x & =\\sqrt[3]{12t+8}-2.\\end{aligned}\n$$" 13194139534843 t