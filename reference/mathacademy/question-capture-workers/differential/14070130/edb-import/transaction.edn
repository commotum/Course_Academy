[{:db/id "q-114057/selection/0e8f95bb911c83467e154cf61037d29c60e8f6179232b9897ceba8bf838f75bf" :answer/id #uuid "99be1b86-835e-5661-b812-7c51eada2625" :answer/type :answer.type/math :answer/value "\\text{arcsec}(50x)+C" :db/ensure [:answer/validate]} {:db/id "q-114057/selection/a357354a891ce57d704b1e309260749008fe1f558fca0f7bc2989c6e8b6f9492" :answer/id #uuid "19f71a9c-1f87-5075-b21b-2d4b2e21592c" :answer/type :answer.type/math :answer/value "5\\,\\text{arcsec}(10x)+C" :db/ensure [:answer/validate]} {:db/id "q-114057/selection/c3563c057cfee082d39a57ec550950d66d3d1da1d183b91ed03f0df99f83c2b1" :answer/id #uuid "7fcdb187-2b0b-5f4b-b40f-c9c86d70fd50" :answer/type :answer.type/math :answer/value "\\text{arcsec}(10x)+C" :db/ensure [:answer/validate]} {:db/id "q-114057/selection/90ee153b82d7c354783d18b1bd3f1ebd604ab8fca8b66f5a72ee43f83f493b28" :answer/id #uuid "54973dfd-f90c-5026-8d70-0a961f0fa969" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\,\\text{arcsec}(10x)+C" :db/ensure [:answer/validate]} {:db/id "q-114057/selection/f6aff9f1397bb7bef4df6680b308df8251573b9ee3aa11225acaf1ccadbbc801" :answer/id #uuid "cec3cb53-2ae0-5e60-90ca-1d3624a6b211" :answer/type :answer.type/math :answer/value "5\\,\\text{arcsec}(x)+C" :db/ensure [:answer/validate]} {:db/id "q-114057/selection" :answer-field/id #uuid "5597e1dc-82cd-543b-80ca-58e11a0d672b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114057/selection/a357354a891ce57d704b1e309260749008fe1f558fca0f7bc2989c6e8b6f9492" :answer-field/choices ["q-114057/selection/0e8f95bb911c83467e154cf61037d29c60e8f6179232b9897ceba8bf838f75bf" "q-114057/selection/a357354a891ce57d704b1e309260749008fe1f558fca0f7bc2989c6e8b6f9492" "q-114057/selection/c3563c057cfee082d39a57ec550950d66d3d1da1d183b91ed03f0df99f83c2b1" "q-114057/selection/90ee153b82d7c354783d18b1bd3f1ebd604ab8fca8b66f5a72ee43f83f493b28" "q-114057/selection/f6aff9f1397bb7bef4df6680b308df8251573b9ee3aa11225acaf1ccadbbc801"] :db/ensure [:answer-field/validate]} {:db/id "q-114057" :question/id #uuid "28b96c5a-8c44-50c1-abfb-4319bd1a0d5b" :question/math-academy-id "q-114057" :question/problem "Calculate $\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\text{d}x=\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $10x.$\n\nSo, let's substitute $u=10x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10\\,⟹\\,\\text{d}x=\\frac{1}{10}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\,\\text{d}x \\\\  & =50\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{10}\\text{d}u) \\\\  & =50\\cdot \\frac{1}{10}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =5\\,\\text{arcsec }u+C \\\\  & =5\\,\\text{arcsec}(10x)+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-114057/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7"] :knowledge-point/questions ["q-114057"] :db/ensure [:knowledge-point/validate]}]
