}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(4x)^{2}}\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{4}\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(4x)}{4}+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-2504" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/activity-metadata.json" "file_sha256" "f3f83d31ee83f1ca04a6e320b749858f9722b2eef55e8a68246d76daab823e95"} {"question" "q-2504" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-2504" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4\\operatorname{arctan}⁡(4x)+C"] ["math" "\\frac{\\operatorname{arctan}⁡(16x)}{16}+C"] ["math" "\\frac{\\operatorname{arctan}⁡(4x)}{16}+C"] ["math" "\\frac{\\operatorname{arctan}⁡(4x)}{4}+C"] ["math" "\\frac{\\operatorname{arctan}⁡(8x)}{8}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-2504" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\operatorname{arctan}⁡(4x)}{4}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-49554" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{1}{3|x|\\sqrt{9{x}^{2}-1}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-49554" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{3|x|\\sqrt{9{x}^{2}-1}}=\\int \\frac{\\text{d}x}{|3x|\\sqrt{(3x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $3x.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{3|x|\\sqrt{9{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{1}{|3x|\\sqrt{(3x)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{3}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(3x)}{3}+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-49554" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/activity-metadata.json" "file_sha256" "f3f83d31ee83f1ca04a6e320b749858f9722b2eef55e8a68246d76daab823e95"} {"question" "q-49554" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-49554" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C"] ["math" "\\frac{\\operatorname{arcsin}⁡(9x)}{3}+C"] ["math" "\\frac{\\text{arcsec}(3x)}{3}+C"] ["math" "\\frac{\\text{arcsec}(9x)}{3}+C"] ["math" "\\frac{\\text{arcsec}(x)}{3}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-49554" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\text{arcsec}(3x)}{3}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114045" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114045" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x & =\\int \\frac{8}{16\\cdot (1+{x}^{2}/16)}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{x}^{2}/16}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+(x/4)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{4})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{1+(x/4)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\cdot (4\\,\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =2\\operatorname{arctan}⁡u+C \\\\  & =2\\operatorname{arctan}⁡(\\frac{x}{4})+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114045" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/activity-metadata.json" "file_sha256" "f3f83d31ee83f1ca04a6e320b749858f9722b2eef55e8a68246d76daab823e95"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{arctan}⁡(4x)+C"] ["math" "2\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\operatorname{arctan}⁡(\\frac{x}{4})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{arctan}⁡(\\frac{x}{4})+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114057" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114057" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\text{d}x=\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $10x.$\n\nSo, let's substitute $u=10x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=10\\,⟹\\,\\text{d}x=\\frac{1}{10}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5}{|x|\\sqrt{100{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{50}{|10x|\\sqrt{(10x)^{2}-1}}\\,\\text{d}x \\\\  & =50\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{10}\\text{d}u) \\\\  & =50\\cdot \\frac{1}{10}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =5\\,\\text{arcsec }u+C \\\\  & =5\\,\\text{arcsec}(10x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114057" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/activity-metadata.json" "file_sha256" "f3f83d31ee83f1ca04a6e320b749858f9722b2eef55e8a68246d76daab823e95"} {"question" "q-114057" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114057" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "5\\,\\text{arcsec}(10x)+C"] ["math" "5\\,\\text{arcsec}(x)+C"] ["math" "\\frac{1}{5}\\,\\text{arcsec}(10x)+C"] ["math" "\\text{arcsec}(10x)+C"] ["math" "\\text{arcsec}(50x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114057" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5\\,\\text{arcsec}(10x)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114084" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114084" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{2}{3\\cdot (1+{x}^{2}/3)}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+{x}^{2}/3}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{\\sqrt{3}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{3}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{3}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{1}{1+{u}^{2}}\\cdot (\\sqrt{3}\\,\\text{d}u) \\\\  & =\\frac{2\\sqrt{3}}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{2\\sqrt{3}}{3}\\operatorname{arctan}⁡u{|}_{0}^{\\sqrt{3}/3} \\\\  & =\\frac{2\\sqrt{3}}{3}(\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{2\\sqrt{3}}{3}\\cdot \\frac{\\pi }{6} \\\\  & =\\frac{\\sqrt{3}\\pi }{9}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114084" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/activity-metadata.json" "file_sha256" "f3f83d31ee83f1ca04a6e320b749858f9722b2eef55e8a68246d76daab823e95"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\pi }{3}"] ["math" "\\frac{\\pi }{9}"] ["math" "\\frac{\\sqrt{3}\\pi }{3}"] ["math" "\\frac{\\sqrt{3}\\pi }{9}"] ["math" "\\sqrt{3}\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14070130/state.json" "file_sha256" "5a24023f8c3a7610ec1f33caa3c28fb2e789255c129cb68a20e5b5faac317254"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{3}\\pi }{9}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academ