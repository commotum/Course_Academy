#{[{:db/id #edb/ref 17592186378951 :knowledge-point/_questions [{:knowledge-point/id #uuid "3abe724a-6aec-5c11-8a00-d92e616a06d7" :knowledge-point/title "Solving a Cauchy-Euler Equation with a Repeated Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "156a20e1-0119-5504-8858-6e427f760ef0" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{6}+{c}_{2}{x}^{6}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378953} {:answer/id #uuid "978299f3-98fd-5ceb-9478-3a94705460cc" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{-6}+{c}_{2}{x}^{6}" :db/id #edb/ref 17592186378954} {:answer/id #uuid "6fbaed4a-bc24-5159-a82e-ad4551e014d5" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{-4}+{c}_{2}{x}^{9}" :db/id #edb/ref 17592186378955} {:answer/id #uuid "9fd1c29e-9e33-5432-b103-9e2f102a342a" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{-6}+{c}_{2}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378956} {:answer/id #uuid "a02a01b0-6d91-5927-b20c-fba219b9cfba" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{6}+{c}_{2}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378957}] :answer-field/correct {:answer/id #uuid "156a20e1-0119-5504-8858-6e427f760ef0" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{6}+{c}_{2}{x}^{6}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378953} :answer-field/id #uuid "e5a456ea-6939-59be-84d2-e001240e8075" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378952}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ca69d341-c61f-5f93-9f1b-40e3f2216758" :question/math-academy-id "q-102348" :question/problem "Find the general solution to the equation\n\n$$\n{x}^{2}{y}^{″}-11x{y}^{′}+36y=0,\\,x>0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}-11x\\cdot \\lambda {x}^{\\lambda -1}+36{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }-11\\lambda {x}^{\\lambda }+36{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[\\lambda (\\lambda -1)-11\\lambda +36] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-11\\lambda +36 & =0 \\\\ {\\lambda }^{2}-12\\lambda +36 & =0 \\\\ (\\lambda -6)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =6.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{6}+{c}_{2}{x}^{6}\\operatorname{ln}⁡x.\n$$"}] [{:db/id #edb/ref 17592186378958 :knowledge-point/_questions [{:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0" :knowledge-point/title "Solving an Initial Value Problem Involving a Cauchy-Euler Equation with a Repeated Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45303927-53e5-5869-85c0-c1272f39a973" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2+14\\operatorname{ln}⁡x}{{x}^{6}}" :db/id #edb/ref 17592186378960} {:answer/id #uuid "be464308-5982-5e9b-a052-482c30b0b47d" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{4+14\\operatorname{ln}⁡x}{{x}^{6}}" :db/id #edb/ref 17592186378961} {:answer/id #uuid "7f4c4e4a-62cf-5080-ad85-ee424cfac5ef" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2-14\\operatorname{ln}⁡x}{{x}^{6}}" :db/id #edb/ref 17592186378962} {:answer/id #uuid "5f1eb4ff-b0c6-5cea-bd13-f607b656d330" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{4-12\\operatorname{ln}⁡x}{{x}^{6}}" :db/id #edb/ref 17592186378963} {:answer/id #uuid "c5b78271-fa31-5ca8-bd22-6e3c0b862bea" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{4-16\\operatorname{ln}⁡x}{{x}^{6}}" :db/id #edb/ref 17592186378964}] :answer-field/correct {:answer/id #uuid "be464308-5982-5e9b-a052-482c30b0b47d" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{4+14\\operatorname{ln}⁡x}{{x}^{6}}" :db/id #edb/ref 17592186378961} :answer-field/id #uuid "e4f58f09-2497-54e5-a40d-8d38bc661685" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378959}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0c34f133-4d9e-5079-b0a7-677deebf6348" :question/math-academy-id "q-102364" :question/problem "Given that the differential equation\n\n$$\n{x}^{2}{y}^{″}+13x{y}^{′}+36y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{x}^{-6}+{c}_{2}{x}^{-6}\\operatorname{ln}⁡x,\n$$\n\nsolve the initial value problem\n\n$$\n{x}^{2}{y}^{″}+13x{y}^{′}+36y=0,\\,y(1)=4,\\,{y}^{′}(1)=-10,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=4.$ Substituting $y(1)=4$ into the general solution gives\n\n$$\n4={c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=-10.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =-6{c}_{1}{x}^{-7}+{c}_{2}{x}^{-7}-6{c}_{2}{x}^{-7}\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=-10$ and ${c}_{1}=4$ into the above gives\n\n$$\n\\begin{aligned}-10 & =-6(4)+{c}_{2} \\\\ {c}_{2} & =14.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y(x) & =4{x}^{-6}+14{x}^{-6}\\operatorname{ln}⁡x \\\\  & =\\frac{4+14\\operatorname{ln}⁡x}{{x}^{6}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378965 :knowledge-point/_questions [{:knowledge-point/id #uuid "3abe724a-6aec-5c11-8a00-d92e616a06d7" :knowledge-point/title "Solving a Cauchy-Euler Equation with a Repeated Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8637855f-d065-554a-b138-fe74f0686faa" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{7}+{c}_{2}{x}^{7}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378967} {:answer/id #uuid "a00494c8-dcfe-5dc3-9211-672dad28337a" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{-7}+{c}_{2}{x}^{-7}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378968} {:answer/id #uuid "564cbc2b-1ac3-5d7e-8b42-defd6a48c05c" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{4}+{c}_{2}{x}^{-4}" :db/id #edb/ref 17592186378969} {:answer/id #uuid "1c64b4f7-2df5-5ee2-b799-3e5365219ec8" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{4}+{c}_{2}{x}^{4}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378970} {:answer/id #uuid "0fb59fa8-96c4-53eb-929a-0590b71d5f3f" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{-7}+{c}_{2}x\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378971}] :answer-field/correct {:answer/id #uuid "a00494c8-dcfe-5dc3-9211-672dad28337a" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)={c}_{1}{x}^{-7}+{c}_{2}{x}^{-7}\\operatorname{ln}⁡x" :db/id #edb/ref 17592186378968} :answer-field/id #uuid "1ecbf818-43f2-5ba6-9380-30094f7fc747" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378966}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "967f7b91-02a9-5b55-b698-cec856feb4fd" :question/math-academy-id "q-64875" :question/problem "Find the general solution to the equation\n\n$$\n{x}^{2}{y}^{″}+15x{y}^{′}+49y=0,\\,x>0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={x}^{\\lambda }.$ Differentiating $y$ with respect to $x$ gives\n\n$$\n{y}^{′}=\\lambda {x}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){x}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{x}^{2}\\cdot \\lambda (\\lambda -1){x}^{\\lambda -2}+15x\\cdot \\lambda {x}^{\\lambda -1}+49{x}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){x}^{\\lambda }+15\\lambda {x}^{\\lambda }+49{x}^{\\lambda } & =0 \\\\ {x}^{\\lambda }[\\lambda (\\lambda -1)+15\\lambda +49] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)+15\\lambda +49 & =0 \\\\ {\\lambda }^{2}+14\\lambda +49 & =0 \\\\ (\\lambda +7)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =-7.$\nTherefore, the general solution is\n\n$$\ny(x)={c}_{1}{x}^{-7}+{c}_{2}{x}^{-7}\\operatorname{ln}⁡x.\n$$"}] [{:db/id #edb/ref 17592186378972 :knowledge-point/_questions [{:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0" :knowledge-point/title "Solving an Initial Value Problem Involving a Cauchy-Euler Equation with a Repeated Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ca6c1d1-1567-55b7-832d-8bd712e03db7" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)={t}^{6}(4-\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186378974} {:answer/id #uuid "147e8823-878b-5498-b950-99730bd477e7" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=4{t}^{6}(2+\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186378975} {:answer/id #uuid "6108fd89-8009-58e0-ae2f-869365c89ce3" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=4{t}^{6}(1-6\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186378976} {:answer/id #uuid "9dd0251d-63ad-5700-b0c8-74d12d7f36b8" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=2{t}^{-6}(1-3\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186378977} {:answer/id #uuid "50b1b33a-57b9-58da-94ea-bc6f19fc5037" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)={t}^{-6}(1+6\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186378978}] :answer-field/correct {:answer/id #uuid "6108fd89-8009-58e0-ae2f-869365c89ce3" :answer/type {:db/ident :answer.type/math} :answer/value "y(t)=4{t}^{6}(1-6\\operatorname{ln}⁡t)" :db/id #edb/ref 17592186378976} :answer-field/id #uuid "652fea83-9d0b-5116-98f7-7888a0cdc8e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378973}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "92580c12-a8bb-5712-ad7a-3fb0808253a4" :question/math-academy-id "q-64886" :question/problem "Find the solution of the initial value problem\n\n$$\n{t}^{2}{y}^{″}-11t{y}^{′}+36y=0,\\,y(1)=4,\\,{y}^{′}(1)=0,\\,t>0.\n$$" :question/worked-solution "The given equation is an instance of the Cauchy-Euler equation. So, we assume that the solutions take the form $y={t}^{\\lambda }.$ Differentiating $y$ with respect to $t$ gives\n\n$$\n{y}^{′}=\\lambda {t}^{\\lambda -1},\\,{y}^{″}=\\lambda (\\lambda -1){t}^{\\lambda -2}.\n$$\n\nSubstituting the above to our differential equation gives\n\n$$\n\\begin{aligned}{t}^{2}\\cdot \\lambda (\\lambda -1){t}^{\\lambda -2}-11t\\cdot \\lambda {t}^{\\lambda -1}+36{t}^{\\lambda } & =0 \\\\ \\lambda (\\lambda -1){t}^{\\lambda }-11\\lambda {t}^{\\lambda }+36{t}^{\\lambda } & =0 \\\\ {t}^{\\lambda }[\\lambda (\\lambda -1)-11\\lambda +36] & =0.\\end{aligned}\n$$\n\nTherefore, the auxiliary equation is\n\n$$\n\\begin{aligned}\\lambda (\\lambda -1)-11\\lambda +36 & =0 \\\\ {\\lambda }^{2}-12\\lambda +36 & =0 \\\\ (\\lambda -6)^{2} & =0.\\end{aligned}\n$$\n\nHence, we have a double root $\\lambda =6.$\nTherefore, the general solution is\n\n$$\ny(t)={c}_{1}{t}^{6}+{c}_{2}{t}^{6}\\operatorname{ln}⁡t.\n$$\n\nNow let's find the constants ${c}_{1}$ and ${c}_{2}.$\n\nSubstituting $y(1)=4$ into the general solution gives\n\n$$\n4={c}_{1}.\n$$\n\nWe now need to apply the condition ${y}^{′}(1)=0.$ First, we differentiate $y$ to find ${y}^{′}$:\n\n$$\n\\begin{aligned}{y}^{′} & =6{c}_{1}{t}^{5}+{c}_{2}{t}^{5}+6{c}_{2}{t}^{5}\\operatorname{ln}⁡t\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=0$ and ${c}_{1}=4$ into the above gives\n\n$$\n\\begin{aligned}0 & =6{c}_{1}+{c}_{2} \\\\ 0 & =24+{c}_{2} \\\\ {c}_{2} & =-24.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y(t) & =4{t}^{6}-24{t}^{6}\\operatorname{ln}⁡t \\\\  & =4{t}^{6}(1-6\\operatorname{ln}⁡t).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378979 :knowledge-point/_questions [{:knowledge-point/id #uuid "6f9ca4b7-157d-56c9-9302-e7ad08c615c0" :knowledge-point/title "Solving an Initial Value Problem Involving a Cauchy-Euler Equation with a Repeated Root"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cea740aa-38c2-55dd-8f38-a537004f03e1" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{3-9\\operatorname{ln}⁡x}{{x}^{5}}" :db/id #edb/ref 17592186378981} {:answer/id #uuid "33a992fd-caf8-5681-a176-e9d0c60f104e" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2+13\\operatorname{ln}⁡x}{{x}^{5}}" :db/id #edb/ref 17592186378982} {:answer/id #uuid "33cdb8fe-d190-5810-9324-df6d81e8a4c7" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{4-3\\operatorname{ln}⁡x}{{x}^{5}}" :db/id #edb/ref 17592186378983} {:answer/id #uuid "3c038974-5a01-5119-b17b-bb8c95208f00" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2+6\\operatorname{ln}⁡x}{{x}^{5}}" :db/id #edb/ref 17592186378984} {:answer/id #uuid "d33c7356-6fc7-5763-af3e-7cb7117f8c99" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2-8\\operatorname{ln}⁡x}{{x}^{5}}" :db/id #edb/ref 17592186378985}] :answer-field/correct {:answer/id #uuid "33a992fd-caf8-5681-a176-e9d0c60f104e" :answer/type {:db/ident :answer.type/math} :answer/value "y(x)=\\frac{2+13\\operatorname{ln}⁡x}{{x}^{5}}" :db/id #edb/ref 17592186378982} :answer-field/id #uuid "d2b87ed6-7c37-5933-b59b-3ae90618d343" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378980}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ef6bcd8c-22fd-5bf6-b6c7-526f4cdd8210" :question/math-academy-id "q-93914" :question/problem "Given that the differential equation\n\n$$\n{x}^{2}{y}^{″}+11x{y}^{′}+25y=0\n$$\n\nhas the general solution\n\n$$\ny={c}_{1}{x}^{-5}+{c}_{2}{x}^{-5}\\operatorname{ln}⁡x,\n$$\n\nsolve the initial value problem\n\n$$\n{x}^{2}{y}^{″}+11x{y}^{′}+25y=0,\\,y(1)=2,\\,{y}^{′}(1)=3,\\,x>0.\n$$" :question/worked-solution "We find the constants ${c}_{1}$ and ${c}_{2}$ using the initial conditions.\n\n- First, we apply the condition $y(1)=2.$ Substituting $y(1)=2$ into the general solution gives\n\n$$\n2={c}_{1}.\n$$\n\n- Then, we apply the condition ${y}^{′}(1)=3.$ Differentiating $y,$ we get\n\n$$\n\\begin{aligned}{y}^{′} & =-5{c}_{1}{x}^{-6}+{c}_{2}{x}^{-6}-5{c}_{2}{x}^{-6}\\operatorname{ln}⁡x.\\end{aligned}\n$$\n\nSubstituting ${y}^{′}(1)=3$ and ${c}_{1}=2$ into the above gives\n\n$$\n\\begin{aligned}3 & =-5(2)+{c}_{2} \\\\ {c}_{2} & =13.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y(x) & =2{x}^{-5}+13{x}^{-5}\\operatorname{ln}⁡x \\\\  & =\\frac{2+13\\operatorname{ln}⁡x}{{x}^{5}}.\\end{aligned}\n$$"}]}
