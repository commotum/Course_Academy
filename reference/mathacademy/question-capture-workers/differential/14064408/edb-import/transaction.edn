[{:db/id [:question/math-academy-id "q-64538"] :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing damped harmonic motion?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\n{y}^{″}+b{y}^{′}+{\\omega }^{2}y=0.\n$$\n\nComparing our equation with the above, we can see that the only equation that represents damped harmonic motion is\n\n$$\n{y}^{″}+2{y}^{′}+2y=0.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-64588/selection/b04182bb2c8788461e4ce8b22eb68222822675ce2fd671b7fde3811f5edaa8eb" :answer/id #uuid "d67337a8-e843-5b4c-b20f-2b947f6afe52" :answer/type :answer.type/math :answer/value "{y}^{″}-16y=t\\operatorname{sin}⁡t" :db/ensure [:answer/validate]} {:db/id "q-64588/selection/e7cc05a6272e8e7bf963a33e17ecde33c7861afce4e6006cf4cdec88665dbcc5" :answer/id #uuid "72fdac93-0bfa-5e20-8163-430c8021b28b" :answer/type :answer.type/math :answer/value "{y}^{″}-25y=0" :db/ensure [:answer/validate]} {:db/id "q-64588/selection/b0f3b2af5ba2a6ece06dc82608118c8e64249bf5217b45498ac3219d467e5e86" :answer/id #uuid "9799c77c-9bfd-5e94-b3b8-367f268cbf48" :answer/type :answer.type/math :answer/value "{y}^{″}+12{y}^{′}-9y=0" :db/ensure [:answer/validate]} {:db/id "q-64588/selection/7fa7dae0fab28c12aadaeed3b3542d4088a601ce3a85cabe4cee5e5d52e3aee3" :answer/id #uuid "1bdf4889-a09a-512d-b9dc-835c29c13b4b" :answer/type :answer.type/math :answer/value "{y}^{″}+18y=5{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-64588/selection/9d63487fc39f01ad93b4245510b991b134a291ba242629902009c68d5bd8236d" :answer/id #uuid "c46993fb-268e-5935-9d2c-4ac8efdec827" :answer/type :answer.type/math :answer/value "{y}^{″}+12{y}^{′}+6y=0" :db/ensure [:answer/validate]} {:db/id "q-64588/selection" :answer-field/id #uuid "80f61d78-9c5c-5056-9862-d7703a0dfb0d" :answer-field/key "selection" :answer-field/type :answer-fiel