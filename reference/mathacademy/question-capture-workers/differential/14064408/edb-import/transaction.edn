d600d313c1c20804f8c8bf244cd39e24cded9dec38cb" :answer/id #uuid "3befb438-27b3-5983-95d6-de399dede742" :answer/type :answer.type/math :answer/value "{y}^{″}+4y=\\operatorname{cos}⁡3t" :db/ensure [:answer/validate]} {:db/id "q-79498/selection/7280ed40995ea65af53857c83fe9339b24339da8769e65c10f02fa747cb126c1" :answer/id #uuid "c14cc2d3-2a61-52b0-99ef-9375858a6112" :answer/type :answer.type/math :answer/value "{y}^{″}+2{y}^{′}=3t" :db/ensure [:answer/validate]} {:db/id "q-79498/selection" :answer-field/id #uuid "ccc725aa-213a-5738-9c22-e72e2b431475" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79498/selection/fa4eaa07200274f30fac14a749869db17c8685c48a1aa0ac060a3e1d1a4c1cdf" :answer-field/choices ["q-79498/selection/fa4eaa07200274f30fac14a749869db17c8685c48a1aa0ac060a3e1d1a4c1cdf" "q-79498/selection/6c855e766513094f7bb5b43d65a105bfdca0c07734d432b088297744b17489eb" "q-79498/selection/677c317203f52798d29b31a0684011f8c7c62cd2d977b8e6cbd3b9cb53aa7c7e" "q-79498/selection/7d56a1e2a901a6f943e1d600d313c1c20804f8c8bf244cd39e24cded9dec38cb" "q-79498/selection/7280ed40995ea65af53857c83fe9339b24339da8769e65c10f02fa747cb126c1"] :db/ensure [:answer-field/validate]} {:db/id "q-79498" :question/id #uuid "1d46e5e1-bf5a-599b-9a5f-cddcbbd94b74" :question/math-academy-id "q-79498" :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing damped harmonic motion?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\n{y}^{″}+b{y}^{′}+{\\omega }^{2}y=0.\n$$\n\nComparing our equation with the above, we can see that the only equation that represents damped harmonic motion is\n\n$$\n{y}^{″}+4{y}^{′}+9y=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79498/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aad85367-37ea-500f-8405-f9464bf4f773"] :knowledge-point/questions ["q-79498"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64576"] :question/problem "Which of the following statements are true?\n\n- ${y}^{″}+2{y}^{′}+2y=0$ represents an oscillator undergoing light damping.\n- ${y}^{″}+10{y}^{′}+25y=0$ represents an oscillator undergoing critical damping.\n- ${y}^{″}+5{y}^{′}+3y=0$ represents an oscillator undergoing heavy damping" :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+2{y}^{′}+2y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+2\\lambda +2=0.\n$$\n\nThe discriminant of this quadratic equation is:\n\n$$\n\\begin{aligned}D={2}^{2}-4(1)(2) & =-4<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement I is correct.\n\n- The differential equation ${y}^{″}+10{y}^{′}+25y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+10\\lambda +25=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={10}^{2}-4(1)(25) & =0\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement II is correct.\n\n- The differential equation ${y}^{″}+5{y}^{′}+3y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+5\\lambda +3=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={5}^{2}-4(1)(3) & =13>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement III is correct.\n\nIn conclusion, the correct answer is \"I, II, and III\"." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-64615/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "bb879104-0d01-5ae3-80a7-05c4b7c4c05d" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-64615/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "123cc7f3-e1b1-5da0-b9b4-1bac44aed79b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-64615/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "4cef4e93-623d-5a37-b1bc-b9606e162994" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-64615/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "0b69f31a-8675-5368-a9c2-d6978f241b58" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-64615/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "42ee4659-76aa-5d40-8c17-7f66ff978701" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-64615/selection" :answer-field/id #uuid "843f15d2-dae7-5145-8dd3-1ca1f3a80ec3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64615/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-64615/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-64615/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-64615/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-64615/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-64615/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-64615" :question/id #uuid "b3bc45b0-6823-5a51-8bde-47d5291bd4b6" :question/math-academy-id "q-64615" :question/problem "Which of the following statements are true?\n\n- ${y}^{″}+4{y}^{′}+8y=0$ represents an oscillator undergoing light damping.\n- ${y}^{″}+6{y}^{′}+9y=0$ represents an oscillator undergoing heavy damping.\n- ${y}^{″}+3{y}^{′}+2y=0$ represents an oscillator undergoing critical damping." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+4{y}^{′}+8y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+4\\lambda +8=0\n$$\n\nThe discriminant of this quadratic equation is:\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(8) & =-16<0\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement I is correct.\n\n- The differential equation ${y}^{″}+6{y}^{′}+9y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+6\\lambda +9=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(9) & =0\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+3{y}^{′}+2y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+3\\lambda +2=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(2) & =1>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"I only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64615/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c"] :knowledge-point/questions ["q-64615"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64616/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "c206a65b-e4d2-5643-b1ca-fc22f849f7de" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-64616/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "d600b204-4097-5140-bff8-9cc5f7e5de00" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-64616/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "38255b87-3b9c-5d04-93c4-2306ca713e97" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-64616/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "9427e006-6b12-5911-95d0-c4f1103301e5" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-64616/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "9cdb8920-8478-5970-8954-cc107f5a65fe" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-64616/selection" :answer-field/id #uuid "905f579c-e17c-5d3c-8636-bb6e705ab18e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64616/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-64616/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-64616/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-64616/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-64616/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-64616/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-64616" :question/id #uuid "b3c2edca-263a-53db-b023-0f659e013834" :question/math-academy-id "q-64616" :question/problem "Which of the following statements are true?\n\n- ${y}^{″}+5{y}^{′}+6y=0$ represents an oscillator undergoing critical damping.\n- ${y}^{″}+2{y}^{′}+y=0$ represents an oscillator undergoing light damping.\n- ${y}^{″}+4{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping." :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+5{y}^{′}+6y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+5\\lambda +6=0\n$$\n\nThe discriminant of this quadratic equation is:\n\n$$\n\\begin{aligned}D={5}^{2}-4(1)(6) & =1>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement I is false.\n\n- The differential equation ${y}^{″}+2{y}^{′}+y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+2\\lambda +1=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={2}^{2}-4(1)(1) & =0\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+4{y}^{′}+2y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is:\n\n$$\n{\\lambda }^{2}+4\\lambda +2=0\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={4}^{2}-4(1)(2) & =8>0\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement III is correct.\n\nIn conclusion, the correct answer is \"III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64616/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c"] :knowledge-point/questions ["q-64616"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94310/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "0ecab809-b4be-5f10-83ea-dcdbac318073" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-94310/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "df86a44a-a8d0-503f-8be3-ddb02af6fed8" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94310/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "7e6a98e5-54ca-5f15-80aa-5244945db197" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-94310/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "718f5686-4ad9-52d5-ac0a-54316f566477" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-94310/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "c7059fb7-b7dc-5c66-9768-5f1f49f22a44" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-94310/selection" :answer-field/id #uuid "5df7941f-142c-59d5-bdd9-c46b468d1bad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94310/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-94310/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-94310/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-94310/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-94310/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-94310/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-94310" :question/id #uuid "2c740c4a-060a-582d-bc23-6130ccbffc30" :question/math-academy-id "q-94310" :question/problem "Which of the following statements are true?\n\n- ${y}^{″}+3{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping\n- ${y}^{″}+6{y}^{′}+9y=0$ represents an oscillator undergoing light damping\n- ${y}^{″}+7{y}^{′}+4y=0$ represents an oscillator undergoing critical  damping" :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+3{y}^{′}+2y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+3\\lambda +2=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={3}^{2}-4(1)(2) & =1>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement I is true.\n\n- The differential equation ${y}^{″}+6{y}^{′}+9y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+6\\lambda +9=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={6}^{2}-4(1)(9) & =0.\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+7{y}^{′}+4y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+7\\lambda +4=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={7}^{2}-4(1)(4) & =33>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement III is false.\n\nIn conclusion, the correct answer is \"I only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94310/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c"] :knowledge-point/questions ["q-94310"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94313/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "80c708b4-3f9f-5b75-a95f-28f50f7e1db0" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-94313/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "55bb50ad-6a9f-5c31-8a8e-c3a1890e3c1f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-94313/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "bb8dd74d-15bf-52eb-99f6-cb5a52f2d98e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-94313/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c60ebaf9-f5ab-55fd-825e-5f3e33a39032" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-94313/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "86223b95-4c68-58cf-8178-e934373c75f6" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-94313/selection" :answer-field/id #uuid "ba46316d-1657-55e6-8433-b9772de5c104" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94313/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-94313/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-94313/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-94313/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-94313/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-94313/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-94313" :question/id #uuid "66e2419b-81b9-577c-8d4a-f28601be4294" :question/math-academy-id "q-94313" :question/problem "Which of the following statements are true?\n\n- ${y}^{″}+2\\sqrt{2}{y}^{′}+2y=0$ represents an oscillator undergoing heavy damping\n- ${y}^{″}+7{y}^{′}+9y=0$ represents an oscillator undergoing critical damping\n- ${y}^{″}+7{y}^{′}+14y=0$ represents an oscillator undergoing light damping" :question/worked-solution "Remember that, given the equation of a damped harmonic oscillator, the type of damping depends on the discriminant of the characteristic equation:\n\n- $D>0$ leads to heavy damping,\n\n- $D=0$ leads to critical damping, and\n\n- $D<0$ leads to light damping.\n\nWith that in mind, let's inspect each equation.\n\n- The differential equation ${y}^{″}+2\\sqrt{2}{y}^{′}+2y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+2\\sqrt{2}\\lambda +2=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D=(2\\sqrt{2})^{2}-4(1)(2) & =0.\\end{aligned}\n$$\n\nThus, the given equation represents critical damping, and so statement I is false.\n\n- The differential equation ${y}^{″}+7{y}^{′}+9y=0$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+7\\lambda +9=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={7}^{2}-4(1)(9) & =13>0.\\end{aligned}\n$$\n\nThus, the given equation represents heavy damping, and so statement II is false.\n\n- The differential equation ${y}^{″}+7{y}^{′}+14y$ represents the equation of damped harmonic motion. \nThe auxiliary equation for $\\lambda $ is\n\n$$\n{\\lambda }^{2}+7\\lambda +14=0.\n$$\n\nThe discriminant of this quadratic equation is\n\n$$\n\\begin{aligned}D={7}^{2}-4(1)(14) & =-7<0.\\end{aligned}\n$$\n\nThus, the given equation represents light damping, and so statement III is true.\n\nIn conclusion, the correct answer is \"III only\"." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94313/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "089c1139-6e3a-5240-be03-fb7e54ecbd7c"] :knowledge-point/questions ["q-94313"] :db/ensure [:knowledge-point/validate]} {:db/id "q-64592/selection/a5d746ce939f30484e95503d9612b4f6305526e2a3057655bfa36b3e136a4b07" :answer/id #uuid "afccdb7d-8f54-5811-a4c7-5b2cbcb7c77e" :answer/type :answer.type/math :answer/value "{y}^{″}+3{y}^{′}+\\sqrt{2}y=0" :db/ensure [:answer/validate]} {:db/id "q-64592/selection/45d77717e7fa8c51ebb80a76ee05915fc80f094e52cccb003c5283dfe4780a0c" :answer/id #uuid "4bed2b41-81b2-5498-93f2-350f6c7c2543" :answer/type :answer.type/math :answer/value "{y}^{″}+1.5{y}^{′}+\\sqrt{2}y=0" :db/ensure [:answer/validate]} {:db/id "q-64592/selection/cae39033e9ba4b81952f22f2dc9afdf411018e8692f97771997cba690fb2d03e" :answer/id #uuid "270c727a-30b9-5a77-b4d9-dbcb663c407c" :answer/type :answer.type/math :answer/value "{y}^{″}+6{y}^{′}+2y=0" :db/ensure [:answer/validate]} {:db/id "q-64592/selection/c7d9793677a8e33cdea498a16bbf12c1ad01b41091f469a85d9c67f44e964182" :answer/id #uuid "62385843-2d0f-5289-94b0-d23d6ad18b5b" :answer/type :answer.type/math :answer/value "{y}^{″}+1.5{y}^{′}+2y=0" :db/ensure [:answer/validate]} {:db/id "q-64592/selection/8db487e9257ec73db1453d83bf4744568868d1e8095c9b8d8ed98ce7e7169789" :answer/id #uuid "8ba0da2f-a66c-5d02-962e-59b3ba1b4d6d" :answer/type :answer.type/math :answer/value "{y}^{″}+3{y}^{′}+2y=0" :db/ensure [:answer/validate]} {:db/id "q-64592/selection" :answer-field/id #uuid "2fe6d592-d490-5f86-96c7-76785bc3fd19" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-64592/selection/c7d9793677a8e33cdea498a16bbf12c1ad01b41091f469a85d9c67f44e964182" :answer-field/choices ["q-64592/selection/a5d746ce939f30484e95503d9612b4f6305526e2a3057655bfa36b3e136a4b07" "q-64592/selection/45d77717e7fa8c51ebb80a76ee05915fc80f094e52cccb003c5283dfe4780a0c" "q-64592/selection/cae39033e9ba4b81952f22f2dc9afdf411018e8692f97771997cba690fb2d03e" "q-64592/selection/c7d9793677a8e33cdea498a16bbf12c1ad01b41091f469a85d9c67f44e964182" "q-64592/selection/8db487e9257ec73db1453d83bf4744568868d1e8095c9b8d8ed98ce7e7169789"] :db/ensure [:answer-field/validate]} {:db/id "q-64592" :question/id #uuid "725a719a-f22a-5836-bd4b-c3c09e81ecee" :question/math-academy-id "q-64592" :question/problem "A particle of mass $4\\,\\text{kg}$ is attached to a massless spring. The spring constant associated with the spring is $k=8\\,{\\text{kg/s}}^{2}.$  The particle is also subject to a resistive force that's proportional to the particle's speed, and has a damping coefficient $c=6\\,\\text{kg/s}.$  The position of the particle is $y(t)$ (measured in meters), and $t>0$ is the time in seconds.  If the particle moves with damped harmonic motion, what is the governing equation?" :question/worked-solution "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n4{y}^{″}=-6{y}^{′}-8y.\n$$\n\nRearranging the above equation, we get:\n\n$$\n{y}^{″}+1.5{y}^{′}+2y=0\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-64592/selection"] :db/ensure [:questi