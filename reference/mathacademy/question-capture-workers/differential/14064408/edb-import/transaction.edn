\n$$\n{y}^{″}+9{y}^{′}+2y=0.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-94295/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aad85367-37ea-500f-8405-f9464bf4f773"] :knowledge-point/questions ["q-94295"] :db/ensure [:knowledge-point/validate]} {:db/id "q-94298/selection/a6cdcb7c85a44d34e7062941efd851544011762625cd7627730d0bd88b28e9eb" :answer/id #uuid "422f59af-b798-5b74-9175-2a90e78f1e8c" :answer/type :answer.type/math :answer/value "{y}^{″}+{y}^{′}+5y=0" :db/ensure [:answer/validate]} {:db/id "q-94298/selection/839e62bed0ef9abeae7f2f2e16d35a3699d3d26a8d452abfd5b525db114e8fa4" :answer/id #uuid "45199ba8-21b0-50f9-817c-1a5fbf26d53d" :answer/type :answer.type/math :answer/value "{y}^{″}-4{y}^{′}=1" :db/ensure [:answer/validate]} {:db/id "q-94298/selection/b1be3bdcef34ed84da9ec82c6c04d70bbbf286fff358d3648f351e1d1d00163e" :answer/id #uuid "b0a6dadb-d4d5-586f-aba8-bb394524a3cf" :answer/type :answer.type/math :answer/value "{y}^{″}+{y}^{′}-5y=2{t}^{3}" :db/ensure [:answer/validate]} {:db/id "q-94298/selection/13ff97b6ff5f2c975e639876265cc002dc54ba4a065af5ec2e00373d2fd875b9" :answer/id #uuid "e2b9c062-9427-5631-9e46-acf289a4d345" :answer/type :answer.type/math :answer/value "{y}^{″}+15y=\\operatorname{cos}⁡t+4\\operatorname{sin}⁡t" :db/ensure [:answer/validate]} {:db/id "q-94298/selection/238dab655cdf611a86d61032f3772325b914cf5b6389e43c95ce8fb35c0b8833" :answer/id #uuid "44eeaf3a-b90e-50d8-a1ad-87870dc9ae42" :answer/type :answer.type/math :answer/value "{y}^{″}+5{y}^{′}-25y=0" :db/ensure [:answer/validate]} {:db/id "q-94298/selection" :answer-field/id #uuid "d2fcc32e-ded6-5718-9d4a-ac06c323d89d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94298/selection/a6cdcb7c85a44d34e7062941efd851544011762625cd7627730d0bd88b28e9eb" :answer-field/choices ["q-94298/selection/a6cdcb7c85a44d34e7062941efd851544011762625cd7627730d0bd88b28e9eb" "q-94298/selection/839e6