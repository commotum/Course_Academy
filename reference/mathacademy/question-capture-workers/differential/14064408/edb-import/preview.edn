418 true] [17592186348294 1113 #uuid "7d271849-ab2b-5594-87c7-ec48335ece54" 13194139535418 true] [17592186348294 1145 "The equation of damped harmonic motion is\n\n$$\nm{y}^{″}=-c{y}^{′}-ky.\n$$\n\nSubstituting our values for $m,$ $k$ and $c$ gives\n\n$$\n4{y}^{″}=-8{y}^{′}-10y.\n$$\n\nRearranging the above equation, we get\n\n$$\n{y}^{″}+2{y}^{′}+\\frac{5}{2}y=0.\n$$" 13194139535418 true] [17592186348295 1000 #edb/ref 17592186348296 13194139535418 true] [17592186348295 1000 #edb/ref 17592186348297 13194139535418 true] [17592186348295 1000 #edb/ref 17592186348298 13194139535418 true] [17592186348295 1000 #edb/ref 17592186348299 13194139535418 true] [17592186348295 1000 #edb/ref 17592186348300 13194139535418 true] [17592186348295 1040 #edb/ref 17592186045450 13194139535418 true] [17592186348295 1041 "selection" 13194139535418 true] [17592186348295 1104 #edb/ref 17592186348300 13194139535418 true] [17592186348295 1110 #uuid "4caaa4a2-fa50-5ffe-a2a7-cd50a5a1602f" 13194139535418 true] [17592186348296 1034 "{y}^{″}+2{y}^{′}+5y=0" 13194139535418 true] [17592186348296 1103 #edb/ref 17592186045453 13194139535418 true] [17592186348296 1111 #uuid "2740634a-c4f3-57b1-9914-d4a698804684" 13194139535418 true] [17592186348297 1034 "{y}^{″}+5{y}^{′}+2y=0" 13194139535418 true] [17592186348297 1103 #edb/ref 17592186045453 13194139535418 true] [17592186348297 1111 #uuid "b01e9ae7-ec14-5609-89b0-8d8d140ac7b5" 13194139535418 true] [17592186348298 1034 "{y}^{″}+\\frac{5}{2}{y}^{′}+2y=0" 13194139535418 true] [17592186348298 1103 #edb/ref 17592186045453 13194139535418 true] [17592186348298 1111 #uuid "8555aad5-fd47-5fe6-a25f-cb342ad2bf78" 13194139535418 true] [17592186348299 1034 "{y}^{″}+2{y}^{′}+\\sqrt{10}\\,y=0" 13194139535418 true] [17592186348299 1103 #edb/ref 17592186045453 13194139535418 true] [17592186348299 1111 #uuid "c96ce911-b8db-5786-85f0-05ff782da121" 13194139535418 true] [17592186348300 1034 "{y}^{″}+2{y}^{′}+\\frac{5}{2}y=0" 13194139535418 true] [17592186348300 1103 #edb/re