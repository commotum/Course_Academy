434fd474f55a9"} {"question" "q-210746" "field" nil "attribute" "question/worked-solution" "value" "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =2\\int \\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210746" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-210746" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210746" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C"] ["math" "4\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C"] ["math" "\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C"] ["math" "\\frac{1}{4}\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C"] ["math" "\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210746" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210742" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int \\frac{6\\operatorname{ln}⁡({x}^{3})}{x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210742" "field" nil "attribute" "question/worked-solution" "value" "Let's set $u=\\operatorname{ln}⁡({x}^{3}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{3}}\\cdot 3{x}^{2}=\\frac{3}{x}\\,⟹\\,\\frac{1}{3}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{6\\operatorname{ln}⁡({x}^{3})}{x}\\,\\text{d}x & =6\\int \\operatorname{ln}⁡({x}^{3})\\cdot \\frac{\\text{d}x}{x}\\cdot  \\\\  & =6\\int u\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{6}{3}\\int u\\,\\text{d}u \\\\  & =2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & ={u}^{2}+C \\\\  & ={ln}^{2}⁡({x}^{3})+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210742" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-210742" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210742" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2{ln}^{3}⁡({x}^{3})+C"] ["math" "3{ln}^{3}⁡({x}^{2})+C"] ["math" "\\frac{1}{2}{ln}^{2}⁡({x}^{3})+C"] ["math" "\\frac{1}{3}{ln}^{2}⁡({x}^{3})+C"] ["math" "{ln}^{2}⁡({x}^{3})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-210742" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{ln}^{2}⁡({x}^{3})+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13814" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13814" "field" nil "attribute" "question/worked-solution" "value" "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x & =5\\int \\frac{1}{(\\operatorname{ln}⁡(3x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{{u}^{2}}\\cdot \\text{d}u \\\\  & =-5\\cdot {u}^{-1}+C \\\\  & =-\\frac{5}{u}+C \\\\  & =-\\frac{5}{\\operatorname{ln}⁡(3x)}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13814" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-13814" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13814" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{15}{{ln}^{3}⁡(3x)}"] ["math" "-\\frac{1}{\\operatorname{ln}⁡(3x)}+C"] ["math" "-\\frac{5}{\\operatorname{ln}⁡(3x)}+C"] ["math" "\\frac{15}{\\operatorname{ln}⁡(3x)}+C"] ["math" "\\frac{5}{{ln}^{2}⁡(3x)}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13814" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{5}{\\operatorname{ln}⁡(3x)}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31398" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31398" "field" nil "attribute" "question/worked-solution" "value" "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\sqrt{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{3}\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{2}{9}{u}^{3/2}+C \\\\  & =\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31398" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-31398" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31398" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{9}{ln}^{2}⁡x+C"] ["math" "\\frac{2}{9}\\sqrt{\\operatorname{ln}⁡x}+C"] ["math" "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C"] ["math" "\\frac{2}{9}{ln}^{3}⁡x+C"] ["math" "\\frac{9}{2}\\sqrt{{ln}^{3}⁡x}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31398" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13809" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13809" "field" nil "attribute" "question/worked-solution" "value" "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x & =\\frac{1}{4}\\int (\\operatorname{ln}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}\\int {u}^{2}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\frac{1}{12}{u}^{3}+C \\\\  & =\\frac{1}{12}{ln}^{3}⁡x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13809" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-13809" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13809" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{12}{ln}^{2}⁡x+C"] ["math" "\\frac{1}{12}{ln}^{3}⁡x+C"] ["math" "\\frac{1}{3}{ln}^{3}⁡x+C"] ["math" "\\frac{1}{4}{ln}^{2}⁡x+C"] ["math" "\\frac{1}{4}{ln}^{3}⁡x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-13809" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{12}{ln}^{3}⁡x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31402" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31402" "field" nil "attribute" "question/worked-solution" "value" "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31402" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-31402" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31402" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C"] ["math" "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C"] ["math" "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C"] ["math" "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C"] ["math" "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31402" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-73659" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-73659" "field" nil "attribute" "question/worked-solution" "value" "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-73659" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-73659" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-73659" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\operatorname{ln}⁡7}{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] ["math" "\\operatorname{ln}⁡4\\operatorname{ln}⁡|{log}_{7}⁡x|+C"] ["math" "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] ["math" "\\operatorname{ln}⁡{x}^{7}\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] ["math" "x\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡({x}^{4})|+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-73659" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31401" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31401" "field" nil "attribute" "question/worked-solution" "value" "Let $u={log}_{3}⁡({x}^{2}).$Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡3}\\,⟹\\,\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{3}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\int u\\cdot \\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31401" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-31401" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31401" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\operatorname{ln}⁡({x}^{2}){log}_{3}^{2}⁡({x}^{2})}{2}+C"] ["math" "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C"] ["math" "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{2}+C"] ["math" "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C"] ["math" "\\frac{\\operatorname{ln}⁡x{log}_{3}^{2}⁡x}{4}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31401" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31399" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31399" "field" nil "attribute" "question/worked-solution" "value" "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x & =3\\int \\frac{1}{{log}_{5}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31399" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/activity-metadata.json" "file_sha256" "88b04a28acd4d8c79e101e9c9e9690d5266f0dc014b1b37dc30f9e50b76e5a87"} {"question" "q-31399" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14039202/state.json" "file_sha256" "09fb5629ced1afa28a441d803c8bf8cd089f79ef936550a076f434fd474f55a9"} {"question" "q-31399" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{2}⁡x|+C"] ["math" "3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C"] ["math" "3\\operatorname{ln}⁡x\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C"] ["math" "\\frac{\\operatorname{ln}⁡(5)}{5}\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C"] ["math" "\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{3}⁡x|+C"]] "category" "ma_complete_choices" "file" "/home/jake/Deve