e]} {:db/id "q-31643/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8e04e95f-6382-51ef-990e-845cffe3ed65" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-31643/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "9ba6330a-e6a0-5a1a-891a-6bdb57f84c8c" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-31643/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "d5b052bf-2595-54b8-bbbf-9ebd2f6585a5" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-31643/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "2ad28eef-c18e-5805-8cf2-25cbdae96808" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-31643/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "e3300233-1715-5059-ab80-2f48bdd18812" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-31643/selection" :answer-field/id #uuid "82bfa861-f5af-5e62-897d-042ae2bad995" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31643/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-31643/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-31643/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-31643/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-31643/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-31643/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-31643" :question/id #uuid "dec84bb9-735a-59dd-b426-ea45b4f1b1f0" :question/math-academy-id "q-31643" :question/problem "What is the value of ${\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/2$ | $1/2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $0$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x & ={\\int }_{1/2}^{e/2}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(2x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}{u}^{-1/2}\\,\\text{d}u \\\\  & ={\\frac{{u}^{1/2}}{1/2}|}_{0}^{1} \\\\  & =2\\cdot {\\sqrt{u}|}_{0}^{1} \\\\  & =2(\\sqrt{1}-\\sqrt{0}) \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31643/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-31643"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73658/selection/5a8b86188a52c7d7429eebc6a5a7070bc01468dca12eb5d182b832a4b986cd9a" :answer/id #uuid "d4d8eb9a-cd2e-5ad6-93a3-027c73e836f7" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡7" :db/ensure [:answer/validate]} {:db/id "q-73658/selection/fbf2a80d1958890c66f60370caf0376b58f83d78a1b2b05aff7bb713d27f940f" :answer/id #uuid "486b58fa-2d1c-5008-8b6d-145ac0d7b877" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡7}{4}" :db/ensure [:answer/validate]} {:db/id "q-73658/selection/b7624a4e9ac6dbf0db7c4bc8585f261c50476a0f04fec02dcd72d1818bc36912" :answer/id #uuid "620cc074-8a4a-5f41-8b51-0c5c620a1ff3" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/ensure [:answer/validate]} {:db/id "q-73658/selection/cf16e32f9fd5435bfaa5da94aacd0ad7ff39f06328ffa615eac39eed408c69ba" :answer/id #uuid "86e05a18-cee5-508b-ace9-3c1af55a2495" :answer/type :answer.type/math :answer/value "4\\operatorname{ln}⁡7" :db/ensure [:answer/validate]} {:db/id "q-73658/selection/94febd0ba27e6c1e0f7c001a7a9751266f363e447e8946ec7f5fcb24b0d582ed" :answer/id #uuid "d0a4c749-4a69-50b8-b52c-85d688ad7e30" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡7" :db/ensure [:answer/validate]} {:db/id "q-73658/selection" :answer-field/id #uuid "8812982f-3e03-532b-ad9e-2bfe17dcc0ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73658/selection/b7624a4e9ac6dbf0db7c4bc8585f261c50476a0f04fec02dcd72d1818bc36912" :answer-field/choices ["q-73658/selection/5a8b86188a52c7d7429eebc6a5a7070bc01468dca12eb5d182b832a4b986cd9a" "q-73658/selection/fbf2a80d1958890c66f60370caf0376b58f83d78a1b2b05aff7bb713d27f940f" "q-73658/selection/b7624a4e9ac6dbf0db7c4bc8585f261c50476a0f04fec02dcd72d1818bc36912" "q-73658/selection/cf16e32f9fd5435bfaa5da94aacd0ad7ff39f06328ffa615eac39eed408c69ba" "q-73658/selection/94febd0ba27e6c1e0f7c001a7a9751266f363e447e8946ec7f5fcb24b0d582ed"] :db/ensure [:answer-field/validate]} {:db/id "q-73658" :question/id #uuid "652a270a-8959-5327-a687-3eb6bee705b0" :question/math-academy-id "q-73658" :question/problem "What is the value of ${\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{7}⁡(\\frac{x}{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡7}\\cdot \\frac{1}{3}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $21$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x & ={\\int }_{3}^{21}{log}_{7}⁡(\\frac{x}{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot (1-0) \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73658/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-73658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-13842/selection/bf8a2b65cf0a4e4321af4384a7e3b192be520488b1b82fb79bb8b0b7c76d8663" :answer/id #uuid "0df931f0-9f89-5626-adec-4fa6a268be62" :answer/type :answer.type/math :answer/value "\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/ensure [:answer/validate]} {:db/id "q-13842/selection/b5ad6bc8f378edb6a6eaa6e585bb8ab6cfcbcc8d404fd51515c3d231afca5ce7" :answer/id #uuid "e4be96a8-361c-5c89-b5d3-56dc08d7427e" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/ensure [:answer/validate]} {:db/id "q-13842/selection/98ac998f707f2f544f4c8d0bcd8e3f7fbb00c8f1aa9466e433ce0880d248b19c" :answer/id #uuid "ff0e2bf6-bcf0-59c4-9c16-4726bbd33932" :answer/type :answer.type/math :answer/value "-\\frac{3}{4}(\\operatorname{ln}⁡4)^{2}" :db/ensure [:answer/validate]} {:db/id "q-13842/selection/068c60cd872f6dd4f5001eb4540803ba3b0e1d99c76a8adaab67a58bd54a48c6" :answer/id #uuid "32cc53cb-027f-55ad-ba96-63a03384f8e2" :answer/type :answer.type/math :answer/value "\\frac{3}{4}(\\operatorname{ln}⁡4e)^{2}" :db/ensure [:answer/validate]} {:db/id "q-13842/selection/a43b9edc866824a41a971acefc67337d0c211581f25e465a617fe0d8188b260c" :answer/id #uuid "f93ad2eb-2ff1-508e-a796-3e79fe0a78b4" :answer/type :answer.type/math :answer/value "\\frac{3}{4}(\\operatorname{ln}⁡4e-\\operatorname{ln}⁡4)" :db/ensure [:answer/validate]} {:db/id "q-13842/selection" :answer-field/id #uuid "996e1de4-6f6a-5d29-8ff8-0316863da4e6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13842/selection/bf8a2b65cf0a4e4321af4384a7e3b192be520488b1b82fb79bb8b0b7c76d8663" :answer-field/choices ["q-13842/selection/bf8a2b65cf0a4e4321af4384a7e3b192be520488b1b82fb79bb8b0b7c76d8663" "q-13842/selection/b5ad6bc8f378edb6a6eaa6e585bb8ab6cfcbcc8d404fd51515c3d231afca5ce7" "q-13842/selection/98ac998f707f2f544f4c8d0bcd8e3f7fbb00c8f1aa9466e433ce0880d248b19c" "q-13842/selection/068c60cd872f6dd4f5001eb4540803ba3b0e1d99c76a8adaab67a58bd54a48c6" "q-13842/selection/a43b9edc866824a41a971acefc67337d0c211581f25e465a617fe0d8188b260c"] :db/ensure [:answer-field/validate]} {:db/id "q-13842" :question/id #uuid "d1e049b7-4abb-5f62-a8e9-5bc06a6e1b18" :question/math-academy-id "q-13842" :question/problem "What is the value of ${\\int }_{1}^{e}\\frac{3\\operatorname{ln}⁡(4x)}{2x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡4e$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{3\\operatorname{ln}⁡(4x)}{2x}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{e}\\operatorname{ln}⁡(4x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e}u\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {\\frac{{u}^{2}}{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & ={\\frac{3}{4}\\cdot {u}^{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & =\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13842/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05"] :knowledge-point/questions ["q-13842"] :db/ensure [:knowledge-point/validate]}]
