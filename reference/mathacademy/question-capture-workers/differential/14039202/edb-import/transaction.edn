bb5f98b114c65a419503a74fff2bb4971d121" "q-210746/selection/d10668d117b68b75e31efa3bcf880bb494d7a85da36ed537cc83fe0d350b2006"] :db/ensure [:answer-field/validate]} {:db/id "q-210746" :question/id #uuid "640d756b-d216-53d7-813b-ffeca4e75575" :question/math-academy-id "q-210746" :question/problem "Calculate the integral $\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =2\\int \\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-210746/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-210746"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-13814"] :question/problem "Calculate the integral $\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x & =5\\int \\frac{1}{(\\operatorname{ln}⁡(3x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{{u}^{2}}\\cdot \\text{d}u \\\\  & =-5\\cdot {u}^{-1}+C \\\\  & =-\\frac{5}{u}+C \\\\  & =-\\frac{5}{\\operatorname{ln}⁡(3x)}+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-13809/selection/caf0d00c700c981c297af34a9999b42314c004b719ac6d108370d686538b6ba5" :answer/id #uuid "744e1275-9c9d-5826-97dc-96d68bfe45f3" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13809/selection/1ccf01ee99e4116947285421bed41f6127f81a00cf5e4d70ef73381f09db0e5a" :answer/id #uuid "4b7d92a4-98ae-5226-8229-84da1668abe5" :answer/type :answer.type/math :answer/value "\\frac{1}{12}{ln}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13809/selection/505bbcc07e84e9c0fd70fce238feafece94820bdde51557aef7e2d98d071a023" :answer/id #uuid "1faa7194-0473-5ac0-ad12-f690fd57e8cc" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{ln}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13809/selection/c681b27ab2083eb7b4cc7e342a6ade910bb0c76716c283136ddcbf480a1aaaf0" :answer/id #uuid "02045d99-16fe-5aad-8f70-f4d35a38e02e" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{ln}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13809/selection/98105d4d0f6b43ab4915269c0fb32dff408e302d95f4eb5401ed792da974b02a" :answer/id #uuid "b97aaa54-4f94-5db2-9322-866057c2601a" :answer/type :answer.type/math :answer/value "\\frac{1}{12}{ln}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-13809/selection" :answer-field/id #uuid "2ea96c54-a4dd-5318-8ba5-88030c659e84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-13809/selection/98105d4d0f6b43ab4915269c0fb32dff408e302d95f4eb5401ed792da974b02a" :answer-field/choices ["q-13809/selection/caf0d00c700c981c297af34a9999b42314c004b719ac6d108370d686538b6ba5" "q-13809/selection/1ccf01ee99e4116947285421bed41f6127f81a00cf5e4d70ef73381f09db0e5a" "q-13809/selection/505bbcc07e84e9c0fd70fce238feafece94820bdde51557aef7e2d98d071a023" "q-13809/selection/c681b27ab2083eb7b4cc7e342a6ade910bb0c76716c283136ddcbf480a1aaaf0" "q-13809/selection/98105d4d0f6b43ab4915269c0fb32dff408e302d95f4eb5401ed792da974b02a"] :db/ensure [:answer-field/validate]} {:db/id "q-13809" :question/id #uuid "78b29f20-4c95-57f8-9809-d3063483c2a6" :question/math-academy-id "q-13809" :question/problem "Calculate the integral $\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x & =\\frac{1}{4}\\int (\\operatorname{ln}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}\\int {u}^{2}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\frac{1}{12}{u}^{3}+C \\\\  & =\\frac{1}{12}{ln}^{3}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-13809/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e"] :knowledge-point/questions ["q-13809"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-73659"] :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-31399/selection/a6a9fa6c428162bab6e29c91dd6fd49f2668ad5a2617d9e0840b93098b74b91d" :answer/id #uuid "5b472e1e-cf62-5d90-9fc0-e2499632555c" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡(5)}{5}\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31399/selection/06acce81259c6e6d0618a18cedec53e15f6d1263389290e384300812ce5fb31f" :answer/id #uuid "0fd6b234-ea6b-5238-81c5-fb5fbde23244" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31399/selection/e57b3a7ced51ed03bf119439de8f08203a39a43b4db1e918faf492ffb152e1bf" :answer/id #uuid "f3013125-b10c-5445-8940-bc2c3ca5be88" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31399/selection/51ff7a5e5477c5cdfeed10a9d0649c9aa30479bfa973195e27df96fa6e3e008d" :answer/id #uuid "3b1a721b-506e-5e01-abf3-931411ff65da" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31399/selection/ef37e20ae9c4386b8b004b7ce759cf0216fc92f252cc238a51d828ae5609903b" :answer/id #uuid "120c4a80-60f0-5d5f-b0d4-5e2d16f0cf35" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡x\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C" :db/ensure [:answer/validate]} {:db/id "q-31399/selection" :answer-field/id #uuid "8a2363f6-b368-5135-ace6-4f1c841371bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31399/selection/06acce81259c6e6d0618a18cedec53e15f6d1263389290e384300812ce5fb31f" :answer-field/choices ["q-31399/selection/a6a9fa6c428162bab6e29c91dd6fd49f2668ad5a2617d9e0840b93098b74b91d" "q-31399/selection/06acce81259c6e6d0618a18cedec53e15f6d1263389290e384300812ce5fb31f" "q-31399/selection/e57b3a7ced51ed03bf119439de8f08203a39a43b4db1e918faf492ffb152e1bf" "q-31399/selection/51ff7a5e5477c5cdfeed10a9d0649c9aa30479bfa973195e27df96fa6e3e008d" "q-31399/selection/ef37e20ae9c4386b8b004b7ce759cf0216fc92f252cc238a51d828ae5609903b"] :db/ensure [:answer-field/validate]} {:db/id "q-31399" :question/id #uuid "11e82c2e-4ccc-5d9d-acf3-7e91aa1b833d" :question/math-academy-id "q-31399" :question/problem "$\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x & =3\\int \\frac{1}{{log}_{5}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-31399/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-31399"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114020/selection/15a7579dea80d6b014a0769b858ab22762a37c08dcbdeaabfd8dc40198130a7b" :answer/id #uuid "10c430ce-b4c9-5ad6-92d3-a2313924c0a1" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{ln}⁡6}{3}\\cdot {log}_{6}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114020/selection/2b83071b005af7c1c92c085e8fa4f93a922926f3b8b046e9b2af8271c4f30ce0" :answer/id #uuid "e33122d2-74e0-56a2-8a6b-f7eaa2f44046" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114020/selection/2f83bd26cbc4c33957d37a22d4bbc073b89fe8efcd48aa5f087b8ce48c7d4