}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114020/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-114020"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31639/selection/77fc60bd413d721052dc4e913930b8cbeb8299776f90de7b928a397dde2afef7" :answer/id #uuid "3a3e6c8e-3f68-5f12-9c8b-7b59702407db" :answer/type :answer.type/math :answer/value "\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-31639/selection/eeca6f26e4ecbcad7c7d06f5c879975775379e79b611cff2416394896bda62fd" :answer/id #uuid "47c6ea26-0247-57f2-aa23-ad80f9ba712e" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-31639/selection/80e7a55f06764d984c322dde47c8ffeb774000601a2e0095662013c9d594da7c" :answer/id #uuid "5a88ffb3-6643-54b0-91d6-604a414a4881" :answer/type :answer.type/math :answer/value "\\frac{3}{5}\\operatorname{ln}⁡\\frac{x}{2}" :db/ensure [:answer/validate]} {:db/id "q-31639/selection/01a48baa6e618230eac8ffdd5c6bec34d81fb5ede906cd8b338992392cb6c2ca" :answer/id #uuid "2d91d908-33e2-564c-94ee-7765e1ad308f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-31639/selection/0a48522d89c83425d9f60bab54ffab8fb30ce791cf570ee958cd7c86ef509e39" :answer/id #uuid "673fcf13-6378-5578-bd01-ba60f8a8ebe8" :answer/type :answer.type/math :answer/value "\\frac{1}{x}\\operatorname{ln}⁡\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-31639/selection" :answer-field/id #uuid "d8da236f-e5c4-531b-a95d-