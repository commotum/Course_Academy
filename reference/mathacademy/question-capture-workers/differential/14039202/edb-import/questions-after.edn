#{[{:db/id #edb/ref 17592186100521 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/id #uuid "8ea17e06-1248-510c-9e71-c57da0cb0d02" :question/math-academy-id "e-14405" :question/problem "Calculate $\\displaystyle{\\int \\dfrac{3}{x \\sqrt{\\ln x}} \\, \\textrm{d}x }.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{x\\sqrt{\\operatorname{ln}⁡x}}\\,\\text{d}x & =3\\int \\frac{1}{\\sqrt{\\operatorname{ln}⁡x}}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =3\\int \\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =3\\int {u}^{-1/2}\\,\\text{d}u \\\\  & =3\\cdot 2{u}^{1/2}+C \\\\  & =6\\sqrt{u}+C \\\\  & =6\\sqrt{\\operatorname{ln}⁡x}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100522 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/id #uuid "1579f932-6e7f-5daa-b001-54a9f6c236ad" :question/math-academy-id "e-14406" :question/problem "Calculate the integral $\\displaystyle \\int \\dfrac{\\log^2_3 x }{x} \\,\\textrm d x.$" :question/worked-solution "Let's rewrite our integral as\n\n$$\n\\int \\dfrac{(\\log_3 x)^2 }{x} \\,\\textrm d x.\n$$\n\nLet $u=\\log_3 x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{x\\ln 3}\\quad\\Longrightarrow\\quad\\ln 3\\,\\textrm d u = \\dfrac 1 x \\textrm d x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{({log}_{3}⁡x)^{2}}{x}\\,\\text{d}x & =\\int ({log}_{3}⁡x)^{2}\\cdot \\frac{1}{x}\\,\\text{d}x \\\\  & =\\int {u}^{2}\\cdot \\operatorname{ln}⁡3\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\int {u}^{2}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡3\\cdot \\frac{1}{3}{u}^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3({log}_{3}⁡x)^{3}+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡3{log}_{3}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100523 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/id #uuid "d2f49acf-ed91-510d-a0f1-41c50eeef9e7" :question/math-academy-id "e-14422" :question/problem "Evaluate $\\displaystyle{\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x}.$" :question/worked-solution "Let's set $u = \\ln x.$ Then, we have\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= \\dfrac 1 x\\quad\\Longrightarrow\\quad \\textrm{d}u=\\dfrac 1 x\\,{\\textrm{d}x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e$ | $e^2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\eqalign{\n\t\\int_{e}^{e^2} \\dfrac{\\ln^2 x}{x}\\,\\textrm{d}x\n&= \\int_{e}^{e^2} (\\ln x)^2\\cdot \\dfrac{\\textrm{d}x}{x}\\[5pt]\n&=\\int_{1}^{2} u^2\\,\\textrm{d}u\\[5pt]\n&=\\left.\\dfrac13u^{3}\\right|_{1}^{2}\\[5pt] \n&=\\dfrac{1}{3}\\left(2^3-1^3 \\right)\\[5pt]\n&=\\dfrac{1}{3}\\left(8-1 \\right)\\[5pt]\n&=\\dfrac{7}{3}\t\t\n\n\t}\n$$"}] [{:db/id #edb/ref 17592186302152 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10c430ce-b4c9-5ad6-92d3-a2313924c0a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡6}{3}\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302154} {:answer/id #uuid "0f3984ae-c6b2-5233-9ae5-32d45bf4dadb" :answer/type {:db/ident :answer.type/math} :answer/value "{log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302155} {:answer/id #uuid "e33122d2-74e0-56a2-8a6b-f7eaa2f44046" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302156} {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} {:answer/id #uuid "3b971759-66f9-5d4a-83c2-d33e420c3e05" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}⁡x+C" :db/id #edb/ref 17592186302158}] :answer-field/correct {:answer/id #uuid "895c6afb-61b9-5702-8402-056efbb6b7e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C" :db/id #edb/ref 17592186302157} :answer-field/id #uuid "0e9fde92-799f-54cb-a163-c8b63400aebb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302153}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "06296c2e-56ff-57f8-948e-fc4b28498e50" :question/math-academy-id "q-114020" :question/problem "$\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{6}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡6}\\,⟹\\,\\operatorname{ln}⁡6\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3{log}_{6}^{2}⁡x}{x}\\,\\text{d}x & =3\\int ({log}_{6}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int {u}^{2}\\cdot \\operatorname{ln}⁡6\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\int {u}^{2}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡6\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\operatorname{ln}⁡6\\cdot {log}_{6}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302159 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4b7d92a4-98ae-5226-8229-84da1668abe5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186302161} {:answer/id #uuid "1faa7194-0473-5ac0-ad12-f690fd57e8cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186302162} {:answer/id #uuid "b97aaa54-4f94-5db2-9322-866057c2601a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186302163} {:answer/id #uuid "02045d99-16fe-5aad-8f70-f4d35a38e02e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186302164} {:answer/id #uuid "744e1275-9c9d-5826-97dc-96d68bfe45f3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186302165}] :answer-field/correct {:answer/id #uuid "b97aaa54-4f94-5db2-9322-866057c2601a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186302163} :answer-field/id #uuid "2ea96c54-a4dd-5318-8ba5-88030c659e84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302160}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "78b29f20-4c95-57f8-9809-d3063483c2a6" :question/math-academy-id "q-13809" :question/problem "Calculate the integral $\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{ln}^{2}⁡x}{4x}\\,\\text{d}x & =\\frac{1}{4}\\int (\\operatorname{ln}⁡x)^{2}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{4}\\int {u}^{2}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\cdot \\frac{{u}^{3}}{3}+C \\\\  & =\\frac{1}{12}{u}^{3}+C \\\\  & =\\frac{1}{12}{ln}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101058 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92ee9113-ca66-5a9f-922f-d15acf812f35" :answer/type {:db/ident :answer.type/math} :answer/value "- (1)/(\\ln (3x)) + C" :db/id #edb/ref 17592186098119} {:answer/id #uuid "a1dd2f66-c124-56a1-bc1b-ff219620a8eb" :answer/type {:db/ident :answer.type/math} :answer/value "- (15)/(\\ln^{3} (3x))" :db/id #edb/ref 17592186098120} {:answer/id #uuid "dfb43b07-5529-5b5a-b6fe-a4ae6ed3c220" :answer/type {:db/ident :answer.type/math} :answer/value "(5)/(\\ln^{2} (3x)) + C" :db/id #edb/ref 17592186098121} {:answer/id #uuid "e8926d71-e2c3-5db1-877a-caba7f2abc27" :answer/type {:db/ident :answer.type/math} :answer/value "- (5)/(\\ln (3x)) + C" :db/id #edb/ref 17592186098122} {:answer/id #uuid "2e197ff3-6e2c-59ab-b3ac-e1a367f64130" :answer/type {:db/ident :answer.type/math} :answer/value "(15)/(\\ln (3x)) + C" :db/id #edb/ref 17592186098123}] :answer-field/correct {:answer/id #uuid "e8926d71-e2c3-5db1-877a-caba7f2abc27" :answer/type {:db/ident :answer.type/math} :answer/value "- (5)/(\\ln (3x)) + C" :db/id #edb/ref 17592186098122} :answer-field/id #uuid "2beaed23-b225-5033-a9af-d82907b57dbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186098118}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6b36b281-88d8-5ece-aa59-a18e57169f2d" :question/math-academy-id "q-13814" :question/problem "Calculate the integral $\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(3x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3x}\\cdot 3=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{5}{x{ln}^{2}⁡(3x)}\\,\\text{d}x & =5\\int \\frac{1}{(\\operatorname{ln}⁡(3x))^{2}}\\cdot \\frac{\\text{d}x}{x} \\\\  & =5\\int \\frac{1}{{u}^{2}}\\cdot \\text{d}u \\\\  & =-5\\cdot {u}^{-1}+C \\\\  & =-\\frac{5}{u}+C \\\\  & =-\\frac{5}{\\operatorname{ln}⁡(3x)}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302166 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "32cc53cb-027f-55ad-ba96-63a03384f8e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}(\\operatorname{ln}⁡4e)^{2}" :db/id #edb/ref 17592186302168} {:answer/id #uuid "ff0e2bf6-bcf0-59c4-9c16-4726bbd33932" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}(\\operatorname{ln}⁡4)^{2}" :db/id #edb/ref 17592186302169} {:answer/id #uuid "f93ad2eb-2ff1-508e-a796-3e79fe0a78b4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}(\\operatorname{ln}⁡4e-\\operatorname{ln}⁡4)" :db/id #edb/ref 17592186302170} {:answer/id #uuid "e4be96a8-361c-5c89-b5d3-56dc08d7427e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/id #edb/ref 17592186302171} {:answer/id #uuid "0df931f0-9f89-5626-adec-4fa6a268be62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/id #edb/ref 17592186302172}] :answer-field/correct {:answer/id #uuid "0df931f0-9f89-5626-adec-4fa6a268be62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})" :db/id #edb/ref 17592186302172} :answer-field/id #uuid "996e1de4-6f6a-5d29-8ff8-0316863da4e6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302167}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d1e049b7-4abb-5f62-a8e9-5bc06a6e1b18" :question/math-academy-id "q-13842" :question/problem "What is the value of ${\\int }_{1}^{e}\\frac{3\\operatorname{ln}⁡(4x)}{2x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then  we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | $e$ |\n| --- | --- | --- |\n| $u$ | $\\operatorname{ln}⁡4$ | $\\operatorname{ln}⁡4e$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{e}\\frac{3\\operatorname{ln}⁡(4x)}{2x}\\,\\text{d}x & =\\frac{3}{2}{\\int }_{1}^{e}\\operatorname{ln}⁡(4x)\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{3}{2}{\\int }_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e}u\\,\\text{d}u \\\\  & =\\frac{3}{2}\\cdot {\\frac{{u}^{2}}{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & ={\\frac{3}{4}\\cdot {u}^{2}|}_{\\operatorname{ln}⁡4}^{\\operatorname{ln}⁡4e} \\\\  & =\\frac{3}{4}((\\operatorname{ln}⁡4e)^{2}-(\\operatorname{ln}⁡4)^{2})\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288910 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0af3f528-1cd9-5154-9953-7c5f5220b388" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186288912} {:answer/id #uuid "0f658357-6ee5-551b-b3fd-38bef5ec88fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186288913} {:answer/id #uuid "cca61265-4745-506b-a432-d69629bfe22d" :answer/type {:db/ident :answer.type/math} :answer/value "3{ln}^{3}⁡({x}^{2})+C" :db/id #edb/ref 17592186288914} {:answer/id #uuid "1b9682a4-d6f2-5bbf-a441-a51971d11256" :answer/type {:db/ident :answer.type/math} :answer/value "2{ln}^{3}⁡({x}^{3})+C" :db/id #edb/ref 17592186288915} {:answer/id #uuid "b9645792-77d0-50d3-a187-14af57110cdc" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186288916}] :answer-field/correct {:answer/id #uuid "b9645792-77d0-50d3-a187-14af57110cdc" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡({x}^{3})+C" :db/id #edb/ref 17592186288916} :answer-field/id #uuid "15151c10-adea-5fb3-952b-343a131260dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288911}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6e134589-c376-59bd-843a-f5bacb6308a9" :question/math-academy-id "q-210742" :question/problem "Calculate the integral $\\int \\frac{6\\operatorname{ln}⁡({x}^{3})}{x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡({x}^{3}).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{{x}^{3}}\\cdot 3{x}^{2}=\\frac{3}{x}\\,⟹\\,\\frac{1}{3}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{6\\operatorname{ln}⁡({x}^{3})}{x}\\,\\text{d}x & =6\\int \\operatorname{ln}⁡({x}^{3})\\cdot \\frac{\\text{d}x}{x}\\cdot  \\\\  & =6\\int u\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{6}{3}\\int u\\,\\text{d}u \\\\  & =2\\cdot \\frac{{u}^{2}}{2}+C \\\\  & ={u}^{2}+C \\\\  & ={ln}^{2}⁡({x}^{3})+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302173 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d2b2e3d-82cd-5211-9fd1-82df01b15fb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186302175} {:answer/id #uuid "c4ed3294-f23b-5a37-812b-3200429d67a0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302176} {:answer/id #uuid "a4ea221c-eb86-54f2-975b-1fe1e977f711" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡|\\operatorname{ln}⁡x|+C" :db/id #edb/ref 17592186302177} {:answer/id #uuid "8cea49ee-13f7-504a-a8de-361c53d4a306" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}\\operatorname{ln}⁡|\\operatorname{ln}⁡(2x)|+C" :db/id #edb/ref 17592186302178} {:answer/id #uuid "b190b52b-d15a-56a3-8ef9-330d4f32c85f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302179}] :answer-field/correct {:answer/id #uuid "c4ed3294-f23b-5a37-812b-3200429d67a0" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C" :db/id #edb/ref 17592186302176} :answer-field/id #uuid "723f76f6-078b-5048-9166-e625436b5904" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302174}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "640d756b-d216-53d7-813b-ffeca4e75575" :question/math-academy-id "q-210746" :question/problem "Calculate the integral $\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(4x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4x}\\cdot 4\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x\\operatorname{ln}⁡(4x)}\\,\\text{d}x & =2\\int \\frac{1}{\\operatorname{ln}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡|\\operatorname{ln}⁡(4x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288931 :knowledge-point/_questions [{:knowledge-point/id #uuid "41b7d83f-3b9b-556c-9e49-13df9c3b597e" :knowledge-point/title "Integrating Functions Containing the Natural Logarithm"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be226d19-d6c8-5673-8d15-e0a5b50957e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}{ln}^{2}⁡x+C" :db/id #edb/ref 17592186288933} {:answer/id #uuid "00ebc433-672a-5713-b1b6-f956bacdc5a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{2}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186288934} {:answer/id #uuid "feb6fcbd-3a3c-5da8-bc3e-f6194d6eac40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186288935} {:answer/id #uuid "c8d00600-d79e-5010-8a77-6cd62efd0f2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{\\operatorname{ln}⁡x}+C" :db/id #edb/ref 17592186288936} {:answer/id #uuid "039b7f02-889f-54bf-b89c-366effd8a329" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}{ln}^{3}⁡x+C" :db/id #edb/ref 17592186288937}] :answer-field/correct {:answer/id #uuid "feb6fcbd-3a3c-5da8-bc3e-f6194d6eac40" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C" :db/id #edb/ref 17592186288935} :answer-field/id #uuid "82c9f2b6-bdfc-5d52-832e-d800c88d82fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288932}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8dd1d32f-b149-5f3f-b3a9-56bf64944e84" :question/math-academy-id "q-31398" :question/problem "Calculate the integral $\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x.$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\sqrt{\\operatorname{ln}⁡x}}{3x}\\,\\text{d}x & =\\frac{1}{3}\\int \\sqrt{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{3}\\int \\sqrt{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\int {u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot \\frac{2{u}^{3/2}}{3}+C \\\\  & =\\frac{2}{9}{u}^{3/2}+C \\\\  & =\\frac{2}{9}\\sqrt{{ln}^{3}⁡x}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302180 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0fd6b234-ea6b-5238-81c5-fb5fbde23244" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186302182} {:answer/id #uuid "3b1a721b-506e-5e01-abf3-931411ff65da" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{3}⁡x|+C" :db/id #edb/ref 17592186302183} {:answer/id #uuid "5b472e1e-cf62-5d90-9fc0-e2499632555c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡(5)}{5}\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C" :db/id #edb/ref 17592186302184} {:answer/id #uuid "f3013125-b10c-5445-8940-bc2c3ca5be88" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186302185} {:answer/id #uuid "120c4a80-60f0-5d5f-b0d4-5e2d16f0cf35" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡x\\operatorname{ln}⁡|\\operatorname{log}⁡x|+C" :db/id #edb/ref 17592186302186}] :answer-field/correct {:answer/id #uuid "0fd6b234-ea6b-5238-81c5-fb5fbde23244" :answer/type {:db/ident :answer.type/math} :answer/value "3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186302182} :answer-field/id #uuid "8a2363f6-b368-5135-ace6-4f1c841371bd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302181}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "11e82c2e-4ccc-5d9d-acf3-7e91aa1b833d" :question/math-academy-id "q-31399" :question/problem "$\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{3}{x{log}_{5}⁡x}\\,\\text{d}x & =3\\int \\frac{1}{{log}_{5}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =3\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =3\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101290 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dd90c1c-26ec-5941-9014-a75801549c55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln x\\log_{3}^{2} x}{4} + C" :db/id #edb/ref 17592186099347} {:answer/id #uuid "a0694e18-a828-5c4b-ba1a-9eb0be4df438" :answer/type {:db/ident :answer.type/math} :answer/value "(\\ln 3\\log_{3}^{2} (x^{2}))/(4) + C" :db/id #edb/ref 17592186099348} {:answer/id #uuid "a418d3da-146c-5dfa-9623-7d22db2c2bb5" :answer/type {:db/ident :answer.type/math} :answer/value "(\\ln 3\\log_{3}^{2} (x^{2}))/(2) + C" :db/id #edb/ref 17592186099349} {:answer/id #uuid "182c11c5-a79d-57e1-a63e-bcd27e737eeb" :answer/type {:db/ident :answer.type/math} :answer/value "(\\ln 2\\log_{2}^{2} (x^{2}))/(4) + C" :db/id #edb/ref 17592186099350} {:answer/id #uuid "64858e3a-933f-5c31-a6dd-383d968fac37" :answer/type {:db/ident :answer.type/math} :answer/value "(\\ln (x^{2})\\log_{3}^{2} (x^{2}))/(2) + C" :db/id #edb/ref 17592186099351}] :answer-field/correct {:answer/id #uuid "a0694e18-a828-5c4b-ba1a-9eb0be4df438" :answer/type {:db/ident :answer.type/math} :answer/value "(\\ln 3\\log_{3}^{2} (x^{2}))/(4) + C" :db/id #edb/ref 17592186099348} :answer-field/id #uuid "29a92435-e746-5ef5-af8a-b64dd53759d1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186099346}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d8e9ea16-ddaf-5f82-ac82-079325b04f6b" :question/math-academy-id "q-31401" :question/problem "$\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{3}⁡({x}^{2}).$Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡3}\\,⟹\\,\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{3}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{3}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡3}{2}\\,\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\int u\\cdot \\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡3}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡3{log}_{3}^{2}⁡({x}^{2})}{4}+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292394 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd965fb2-1789-5964-8ef8-b488cf979b3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186292396} {:answer/id #uuid "11533f68-307b-5bc7-8f46-6fd6b5af0afb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186292397} {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} {:answer/id #uuid "bb7c9319-18ca-5599-ad32-86a9e0eccd17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292399} {:answer/id #uuid "739228e8-510e-564d-8a7a-85f36da92739" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292400}] :answer-field/correct {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} :answer-field/id #uuid "570a9286-b9a9-5ea2-b5a1-4a1b26015b22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292395}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "de056453-dea5-5366-891a-53b77baba193" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302187 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d91d908-33e2-564c-94ee-7765e1ad308f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{5}{2}" :db/id #edb/ref 17592186302189} {:answer/id #uuid "673fcf13-6378-5578-bd01-ba60f8a8ebe8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{x}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186302190} {:answer/id #uuid "3a3e6c8e-3f68-5f12-9c8b-7b59702407db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186302191} {:answer/id #uuid "5a88ffb3-6643-54b0-91d6-604a414a4881" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\operatorname{ln}⁡\\frac{x}{2}" :db/id #edb/ref 17592186302192} {:answer/id #uuid "47c6ea26-0247-57f2-aa23-ad80f9ba712e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡\\frac{2}{3}" :db/id #edb/ref 17592186302193}] :answer-field/correct {:answer/id #uuid "3a3e6c8e-3f68-5f12-9c8b-7b59702407db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}" :db/id #edb/ref 17592186302191} :answer-field/id #uuid "d8da236f-e5c4-531b-a95d-99e0554a7e2d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302188}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "532dc924-05ed-5c84-a54d-3c8b1d5ebaf9" :question/math-academy-id "q-31639" :question/problem "What is the value of ${\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{5x\\operatorname{ln}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | ${e}^{2}$ | ${e}^{3}$ |\n| --- | --- | --- |\n| $u$ | $2$ | $3$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{5x\\operatorname{ln}⁡x}\\,\\text{d}x & =\\frac{1}{5}{\\int }_{{e}^{2}}^{{e}^{3}}\\frac{1}{\\operatorname{ln}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{5}{\\int }_{2}^{3}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡|u|){|}_{2}^{3} \\\\  & =\\frac{1}{5}(\\operatorname{ln}⁡3-\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5}\\operatorname{ln}⁡\\frac{3}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302194 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d5b052bf-2595-54b8-bbbf-9ebd2f6585a5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186302196} {:answer/id #uuid "8e04e95f-6382-51ef-990e-845cffe3ed65" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186302197} {:answer/id #uuid "e3300233-1715-5059-ab80-2f48bdd18812" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186302198} {:answer/id #uuid "2ad28eef-c18e-5805-8cf2-25cbdae96808" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186302199} {:answer/id #uuid "9ba6330a-e6a0-5a1a-891a-6bdb57f84c8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186302200}] :answer-field/correct {:answer/id #uuid "8e04e95f-6382-51ef-990e-845cffe3ed65" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186302197} :answer-field/id #uuid "82bfa861-f5af-5e62-897d-042ae2bad995" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302195}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "dec84bb9-735a-59dd-b426-ea45b4f1b1f0" :question/math-academy-id "q-31643" :question/problem "What is the value of ${\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡(2x).$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2x}\\cdot 2\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $e/2$ | $1/2$ |\n| --- | --- | --- |\n| $u$ | $1$ | $0$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{e/2}\\frac{1}{x\\sqrt{\\operatorname{ln}⁡(2x)}}\\,\\text{d}x & ={\\int }_{1/2}^{e/2}\\frac{1}{\\sqrt{\\operatorname{ln}⁡(2x)}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & ={\\int }_{0}^{1}{u}^{-1/2}\\,\\text{d}u \\\\  & ={\\frac{{u}^{1/2}}{1/2}|}_{0}^{1} \\\\  & =2\\cdot {\\sqrt{u}|}_{0}^{1} \\\\  & =2(\\sqrt{1}-\\sqrt{0}) \\\\  & =2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292408 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45e4bfd9-8771-5c4f-994e-8ad5cc6880c0" :answer/type {:db/ident :answer.type/math} :answer/value "8{ln}^{2}⁡2" :db/id #edb/ref 17592186292410} {:answer/id #uuid "4ad90a5e-2350-5d46-9460-7b2a345dafc9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186292411} {:answer/id #uuid "c3e63f95-ccce-5bbc-bc38-67c44512bce5" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186292412} {:answer/id #uuid "9d5c1fe5-649e-5c9c-bbcb-2f1710de59cb" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186292413} {:answer/id #uuid "c09a8737-ed78-57d3-aa26-bacad5ffa153" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡2" :db/id #edb/ref 17592186292414}] :answer-field/correct {:answer/id #uuid "c3e63f95-ccce-5bbc-bc38-67c44512bce5" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186292412} :answer-field/id #uuid "d4c34f04-67a4-5b53-911d-1aff60d25f14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292409}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "76948c35-6b31-5ab2-9ce4-a6587cc4fbab" :question/math-academy-id "q-73655" :question/problem "What is the value of ${\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $16$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x & =2{\\int }_{2}^{4}\\frac{1}{{log}_{4}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡4\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2\\operatorname{ln}⁡({2}^{2})\\operatorname{ln}⁡2 \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186302201 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4d8eb9a-cd2e-5ad6-93a3-027c73e836f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7" :db/id #edb/ref 17592186302203} {:answer/id #uuid "d0a4c749-4a69-50b8-b52c-85d688ad7e30" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡7" :db/id #edb/ref 17592186302204} {:answer/id #uuid "620cc074-8a4a-5f41-8b51-0c5c620a1ff3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186302205} {:answer/id #uuid "86e05a18-cee5-508b-ace9-3c1af55a2495" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡7" :db/id #edb/ref 17592186302206} {:answer/id #uuid "486b58fa-2d1c-5008-8b6d-145ac0d7b877" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}" :db/id #edb/ref 17592186302207}] :answer-field/correct {:answer/id #uuid "620cc074-8a4a-5f41-8b51-0c5c620a1ff3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}" :db/id #edb/ref 17592186302205} :answer-field/id #uuid "8812982f-3e03-532b-ad9e-2bfe17dcc0ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302202}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "652a270a-8959-5327-a687-3eb6bee705b0" :question/math-academy-id "q-73658" :question/problem "What is the value of ${\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{7}⁡(\\frac{x}{3}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{3}{x\\operatorname{ln}⁡7}\\cdot \\frac{1}{3}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $3$ | $21$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{3}^{21}\\frac{1}{x}{log}_{7}⁡(\\frac{x}{3})\\,\\text{d}x & ={\\int }_{3}^{21}{log}_{7}⁡(\\frac{x}{3})\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{0}^{1}u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7{\\int }_{0}^{1}u\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\cdot \\frac{{u}^{2}}{2}{|}_{0}^{1} \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot (1-0) \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186101444 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} {:answer/id #uuid "d26d1f8b-e0aa-5d92-9ab9-24d9e216087f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln x^{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100262} {:answer/id #uuid "fcdc0d7c-75d9-5a6a-8e71-b2ed1b6d870f" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 4\\ln \\mid \\log_{7} x \\mid + C" :db/id #edb/ref 17592186100263} {:answer/id #uuid "561a7dca-9374-553b-824c-74d78cf70c81" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln 7}{7}\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100264} {:answer/id #uuid "62e4e20e-edf2-5d23-8879-c22c3dd0d4a3" :answer/type {:db/ident :answer.type/math} :answer/value "x\\ln 7\\ln \\mid \\log_{7} (x^{4}) \\mid + C" :db/id #edb/ref 17592186100265}] :answer-field/correct {:answer/id #uuid "8cfd5401-f59b-5d26-9381-903e7a100fe7" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln 7\\ln \\mid \\log_{7} (4x) \\mid + C" :db/id #edb/ref 17592186100261} :answer-field/id #uuid "10d45f02-34c8-55d7-aaa6-ca2883b6ab73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100260}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "15940cb6-48bb-51bb-99eb-a693e64f76c1" :question/math-academy-id "q-73659" :question/problem "$\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡(4x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{7}⁡(4x)}\\,\\text{d}x & =\\int \\frac{1}{{log}_{7}⁡(4x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡7\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡7\\operatorname{ln}⁡|{log}_{7}⁡(4x)|+C\\end{aligned}\n$$"}]}
