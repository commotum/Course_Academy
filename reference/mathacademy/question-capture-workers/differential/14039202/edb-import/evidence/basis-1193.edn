#{[{:db/id #edb/ref 17592186292394 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd965fb2-1789-5964-8ef8-b488cf979b3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\operatorname{ln}⁡|{log}_{5}⁡x|+C" :db/id #edb/ref 17592186292396} {:answer/id #uuid "11533f68-307b-5bc7-8f46-6fd6b5af0afb" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡({x}^{3})|+C" :db/id #edb/ref 17592186292397} {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} {:answer/id #uuid "bb7c9319-18ca-5599-ad32-86a9e0eccd17" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡5}{5}\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292399} {:answer/id #uuid "739228e8-510e-564d-8a7a-85f36da92739" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡({x}^{5})\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292400}] :answer-field/correct {:answer/id #uuid "ca647ce4-4cc7-5a3d-8e6e-97a2835d48b6" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C" :db/id #edb/ref 17592186292398} :answer-field/id #uuid "570a9286-b9a9-5ea2-b5a1-4a1b26015b22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292395}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "de056453-dea5-5366-891a-53b77baba193" :question/math-academy-id "q-31402" :question/problem "$\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{5}⁡(3x).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡5}\\,⟹\\,\\operatorname{ln}⁡5\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{2}{x{log}_{5}⁡(3x)}\\,\\text{d}x & =2\\int \\frac{1}{{log}_{5}⁡(3x)}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡5\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\int \\frac{1}{u}\\cdot \\text{d}u \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|u|+C \\\\  & =2\\operatorname{ln}⁡5\\operatorname{ln}⁡|{log}_{5}⁡(3x)|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292408 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45e4bfd9-8771-5c4f-994e-8ad5cc6880c0" :answer/type {:db/ident :answer.type/math} :answer/value "8{ln}^{2}⁡2" :db/id #edb/ref 17592186292410} {:answer/id #uuid "4ad90a5e-2350-5d46-9460-7b2a345dafc9" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡2" :db/id #edb/ref 17592186292411} {:answer/id #uuid "c3e63f95-ccce-5bbc-bc38-67c44512bce5" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186292412} {:answer/id #uuid "9d5c1fe5-649e-5c9c-bbcb-2f1710de59cb" :answer/type {:db/ident :answer.type/math} :answer/value "4\\operatorname{ln}⁡2" :db/id #edb/ref 17592186292413} {:answer/id #uuid "c09a8737-ed78-57d3-aa26-bacad5ffa153" :answer/type {:db/ident :answer.type/math} :answer/value "8\\operatorname{ln}⁡2" :db/id #edb/ref 17592186292414}] :answer-field/correct {:answer/id #uuid "c3e63f95-ccce-5bbc-bc38-67c44512bce5" :answer/type {:db/ident :answer.type/math} :answer/value "4{ln}^{2}⁡2" :db/id #edb/ref 17592186292412} :answer-field/id #uuid "d4c34f04-67a4-5b53-911d-1aff60d25f14" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292409}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "76948c35-6b31-5ab2-9ce4-a6587cc4fbab" :question/math-academy-id "q-73655" :question/problem "What is the value of ${\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x?$" :question/worked-solution "Let $u={log}_{4}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡4}\\,⟹\\,\\operatorname{ln}⁡4\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $16$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{16}\\frac{2}{x{log}_{4}⁡x}\\,\\text{d}x & =2{\\int }_{2}^{4}\\frac{1}{{log}_{4}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =2{\\int }_{1}^{2}\\frac{1}{u}\\cdot \\operatorname{ln}⁡4\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4{\\int }_{1}^{2}\\frac{1}{u}\\,\\text{d}u \\\\  & =2\\operatorname{ln}⁡4(\\operatorname{ln}⁡|u|){|}_{1}^{2} \\\\  & =2\\operatorname{ln}⁡4\\cdot (\\operatorname{ln}⁡2-\\operatorname{ln}⁡1) \\\\  & =2\\operatorname{ln}⁡({2}^{2})\\operatorname{ln}⁡2 \\\\  & =4{ln}^{2}⁡2\\end{aligned}\n$$"}]}
