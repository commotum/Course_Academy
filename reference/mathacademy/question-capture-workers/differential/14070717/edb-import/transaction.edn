f3ea1cda660cba45adc"] :db/ensure [:answer-field/validate]} {:db/id "q-343294/field-3/def9e284c04ff88f4501b741fdfd679144aa2f6e42b9c1ec7d4a2217819cc46c" :answer/id #uuid "a49c87a8-4ff4-5ad6-9697-1888f4d58fb7" :answer/type :answer.type/text :answer/value "$W(x)=0$ for all $x>0$" :db/ensure [:answer/validate]} {:db/id "q-343294/field-3/4ddf0edc896c1f1ae6c38e2226560fa57e92098045c3c07394f525b12ebbd5f4" :answer/id #uuid "f8207138-73dc-5d06-ab42-cb19b1121cb8" :answer/type :answer.type/text :answer/value "$W(x)=0$ for some but not all $x>0$" :db/ensure [:answer/validate]} {:db/id "q-343294/field-3/a8a92ea07ac7485e9fd6d2e4cc37ff1cfe2285f70b07eaedfdf36fc578c9e108" :answer/id #uuid "d55ecba7-2aa1-5ec1-a61b-93d98626e772" :answer/type :answer.type/text :answer/value "$W(x)\\ne 0$ for all $x>0$" :db/ensure [:answer/validate]} {:db/id "q-343294/field-3" :answer-field/id #uuid "c105fc62-9de6-5f4d-8319-e7146f1f88f0" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-343294/field-3/def9e284c04ff88f4501b741fdfd679144aa2f6e42b9c1ec7d4a2217819cc46c" :answer-field/choices ["q-343294/field-3/def9e284c04ff88f4501b741fdfd679144aa2f6e42b9c1ec7d4a2217819cc46c" "q-343294/field-3/4ddf0edc896c1f1ae6c38e2226560fa57e92098045c3c07394f525b12ebbd5f4" "q-343294/field-3/a8a92ea07ac7485e9fd6d2e4cc37ff1cfe2285f70b07eaedfdf36fc578c9e108"] :db/ensure [:answer-field/validate]} {:db/id "q-343294" :question/id #uuid "a4de0460-3f40-5061-8939-f952314d55b2" :question/math-academy-id "q-343294" :question/problem "$$\n{y}^{″}+\\operatorname{sin}⁡(x){y}^{′}+Q(x)y=0,\\,x>0\n$$\n\nLet ${y}_{1}$ and ${y}_{2}$ be solutions to the second-order homogeneous differential equation above, where $Q(x)$ is continuous on $(0,\\infty ).$ The Wronskian satisfies $W(\\pi )=0.$ Select the correct options in the reasoning below.The Wronskian $W(x)$ satisfies the following first-order differential equation:\n\n$$\n{W}^{′}(x)={{field-1}}W(x)\n$$\n\nSolving this equation, we get\n\n$$\nW={{field-2}}\n$$\n\nwhere $C$ is an arbitrary constant.\n\nNow, using the fact that $W(\\pi )=0,$ we obtain \n{{field-3}}." :question/worked-solution "Abel's identity says that if ${y}_{1}$ and ${y}_{2}$ are solutions of\n\n$$\n{y}^{″}+P(x){y}^{′}+Q(x)y=0,\n$$\n\nthen their Wronskian $W(x)$ satisfies\n\n$$\n{W}^{′}(x)=-P(x)W(x).\n$$\n\nIn our equation, the coefficient of ${y}^{′}$ is \n\n$$\nP(x)=\\operatorname{sin}⁡(x).\n$$\n\nSubstituting into Abel's identity gives\n\n$$\n{W}^{′}(x)=-\\operatorname{sin}⁡(x)W(x).\n$$\n\nNow, we solve the first-order differential equation for $W:$\n\n$$\n\\begin{aligned}{W}^{′} & =-\\operatorname{sin}⁡(x)W \\\\ \\frac{\\text{d}W}{W} & =-\\operatorname{sin}⁡(x)\\text{d}x \\\\ \\int \\frac{\\text{d}W}{W} & =\\int -\\operatorname{sin}⁡(x)\\,\\text{d}x \\\\ \\operatorname{ln}⁡|W| & =\\operatorname{cos}⁡(x)+K \\\\ |W| & ={e}^{K}{e}^{\\operatorname{cos}⁡(x)} \\\\ W & =C{e}^{\\operatorname{cos}⁡(x)}\\end{aligned}\n$$\n\nwhere $C$ is a constant.\n\nNext, we use the given value $W(\\pi )=0$ to find $C:$\n\n$$\n\\begin{aligned}W(\\pi ) & =C{e}^{\\operatorname{cos}⁡(\\pi )} \\\\ 0 & =C{e}^{-1} \\\\ C & =0\\end{aligned}\n$$\n\nTherefore, we have $W(x)=0\\text{ for all }x>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-343294/field-1" "q-343294/field-2" "q-343294/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "734fe467-57d6-5b3f-a61e-1e2e4624b5fc"] :knowledge-point/questions ["q-343294"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343295/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "048973b5-d2ee-5553-9953-7757a1ec567e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-343295/field-1/18318f85a88deafb973a2f7e4185df4f7fbf65900f8806280ad8703c50dc6174" :answer/id #uuid "e1eecf14-1a58-56f1-876b-14ad9f67ec0a" :answer/type :answer.type/math :answer/value "-3Q(x)" :db/ensure [:answer/validate]} {:d