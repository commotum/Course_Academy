[{:db/id "q-106647/selection/145c80724eeb638e80284f6cfd30eb0554c0b008e991f5314299eeb4384a4ba5" :answer/id #uuid "ad4132ea-0437-5fbd-9d1c-ddd3bef30296" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=-5(y-9)" :db/ensure [:answer/validate]} {:db/id "q-106647/selection/27d861cf6cf0c5ed2f110ab36fb3336da195a3eb9295d63299d4e14983f51d83" :answer/id #uuid "3b9f6d46-aa7e-5027-8e60-1470e12c1922" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=-5{y}^{2}(y-9)" :db/ensure [:answer/validate]} {:db/id "q-106647/selection/5907e59518f1f35a4e93036f36da3f98bbd084de5a1118062915017ee3eaf72e" :answer/id #uuid "0078e3b7-1e8d-55ab-ae0d-c398206fd4e8" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=-5y(y+9)" :db/ensure [:answer/validate]} {:db/id "q-106647/selection/46279c23da049e4e84d5ea77c3eefac66a2c2467ee4289cab9ad2c22ddd1d406" :answer/id #uuid "0e0315b9-dbdb-59bd-a0dc-d84f6a8a3222" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=-5({y}^{2}-9)" :db/ensure [:answer/validate]} {:db/id "q-106647/selection/10a1d0a8ef6594df406eb42e98f2dd05ff248b5d0ea355ffc82e353a808c8977" :answer/id #uuid "53a73152-5784-5553-8b38-3c07e4803fdd" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=-5(9-y)" :db/ensure [:answer/validate]} {:db/id "q-106647/selection" :answer-field/id #uuid "894a2987-4984-5afc-a234-5be706772146" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106647/selection/145c80724eeb638e80284f6cfd30eb0554c0b008e991f5314299eeb4384a4ba5" :answer-field/choices ["q-106647/selection/145c80724eeb638e80284f6cfd30eb0554c0b008e991f5314299eeb4384a4ba5" "q-106647/selection/27d861cf6cf0c5ed2f110ab36fb3336da195a3eb9295d63299d4e14983f51d83" "q-106647/selection/5907e59518f1f35a4e93036f36da3f98bbd084de5a1118062915017ee3eaf72e" "q-106647/selection/46279c23da049e4e84d5ea77c3eefac66a2c2467ee4289cab9ad2c22ddd1d406" "q-106647/selection/10a1d0a8ef6594df406eb42e98f2dd05ff248b5d0ea355ffc82e353a808c8977"] :db/ensure [:answer-field/validate]} {:db/id "q-106647" :question/id #uuid "4ab835de-6077-5001-a0a7-4516bf0305aa" :question/math-academy-id "q-106647" :question/problem "Given that $y>9$ and $t>0,$ which of the following is an inhibited decay equation?" :question/worked-solution "An inhibited decay equation has the form\n\n$$\n\\frac{dy}{dt}=-k(y-a),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $y>a$ for all $t>0.$\n\nFrom the given options, the only inhibited decay equation is\n\n$$\n\\frac{dy}{dt}=-5(y-9).\n$$\n\nIn this case, the constant of proportionality is $k=5,$ and $a=9.$ Note that for inhibited decay, we must have $y>9$ for all $t>0.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106647/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0709c667-bc10-5bd5-a383-3fd6ca332361"] :knowledge-point/questions ["q-106647"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106651/selection/ea77742a1db81e171c587da2a9a1946309b1ac1f67c1bbc41dcfbde030fb3ed9" :answer/id #uuid "cec4a4c4-579c-592b-bba7-9bae2d3352e2" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=176y-22{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-106651/selection/46c20d6f88510ed9e2d73d898fa878f35c104820a4657acd881ef1e414789063" :answer/id #uuid "fbd69f58-d216-5fe1-a473-713e92d34eb0" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=176-22y" :db/ensure [:answer/validate]} {:db/id "q-106651/selection/402ef27c90d6a8843ce278b28ec717c58cc0871843dba1cd499fb1d8a56c5f28" :answer/id #uuid "1adcf22b-d4aa-5448-a4f8-41d1692e6986" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=176-22{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-106651/selection/1786a17ef88688e0dbf297bd9a8b39471cf29ec6a354afe86e1a66237c02070d" :answer/id #uuid "9f60b8ad-9042-5d96-9494-00fc2a99d0ab" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=176+22y" :db/ensure [:answer/validate]} {:db/id "q-106651/selection/8478600d120125bde90d3c2961a3639a0edd981e34cea29ac4f18414d257be62" :answer/id #uuid "765a6d12-c1f7-5aa6-bf59-1426da2349d2" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=22{y}^{2}-176" :db/ensure [:answer/validate]} {:db/id "q-106651/selection" :answer-field/id #uuid "388d11f6-f844-5c48-85f2-2e7770c48438" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106651/selection/46c20d6f88510ed9e2d73d898fa878f35c104820a4657acd881ef1e414789063" :answer-field/choices ["q-106651/selection/ea77742a1db81e171c587da2a9a1946309b1ac1f67c1bbc41dcfbde030fb3ed9" "q-106651/selection/46c20d6f88510ed9e2d73d898fa878f35c104820a4657acd881ef1e414789063" "q-106651/selection/402ef27c90d6a8843ce278b28ec717c58cc0871843dba1cd499fb1d8a56c5f28" "q-106651/selection/1786a17ef88688e0dbf297bd9a8b39471cf29ec6a354afe86e1a66237c02070d" "q-106651/selection/8478600d120125bde90d3c2961a3639a0edd981e34cea29ac4f18414d257be62"] :db/ensure [:answer-field/validate]} {:db/id "q-106651" :question/id #uuid "31f331f4-2197-5cc1-8e14-b967466e677c" :question/math-academy-id "q-106651" :question/problem "Given that $y>8$ and $t>0,$ which of the following is an inhibited decay equation?" :question/worked-solution "An inhibited decay equation has the form\n\n$$\n\\frac{dy}{dt}=-k(y-a),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $y>a$ for all $t>0.$\n\nFrom the given options, the only inhibited decay equation is\n\n$$\n\\frac{dy}{dt}=176-22y.\n$$\n\nTo see this, let's factor the right-hand side of the equation. This gives,\n\n$$\n\\frac{dy}{dt}=-22(y-8).\n$$\n\nIn this case, the constant of proportionality is $k=22,$ and $a=8.$ Note that for inhibited decay, we must have $y>8$ for all $t>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106651/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0709c667-bc10-5bd5-a383-3fd6ca332361"] :knowledge-point/questions ["q-106651"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106654/selection/f7afaaf48b6168a153c395ef2b5e50b1f7f8dd019022fc32d4f130b13b08af55" :answer/id #uuid "cfa8f299-e65c-5829-9816-73ac95593958" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=840-28{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-106654/selection/127edc0006185b6c575c49a2eb865b631d7eeae721ad839b10f2cd1e6a486b41" :answer/id #uuid "75c50c6a-85f9-5fc6-a66c-431f9860354e" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=28{y}^{2}-840" :db/ensure [:answer/validate]} {:db/id "q-106654/selection/f0dc8f55811455c7ae189cb0c223a409bbc03654aa5f113d21aeb401e6990e47" :answer/id #uuid "263f5cda-4bff-5ace-aae0-cccf03212642" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=840+28y" :db/ensure [:answer/validate]} {:db/id "q-106654/selection/70a167450540fa0ca5a26cc0b3be79290689c03b699ecdeb0e7f17ef458850db" :answer/id #uuid "a2206494-11d5-5ec6-8fdd-efc01cc18ab3" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=840-28y" :db/ensure [:answer/validate]} {:db/id "q-106654/selection/2a4932299c8a1731b6870c8c4acffba9bd55fc4b3821f36fedf3846d7a8be1d2" :answer/id #uuid "3809d0a6-7a4f-59f3-90c1-7eb586d58bfe" :answer/type :answer.type/math :answer/value "\\frac{dy}{dt}=840y-28{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-106654/selection" :answer-field/id #uuid "887bbde7-4844-5579-8445-8e33a034a40e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106654/selection/70a167450540fa0ca5a26cc0b3be79290689c03b699ecdeb0e7f17ef458850db" :answer-field/choices ["q-106654/selection/f7afaaf48b6168a153c395ef2b5e50b1f7f8dd019022fc32d4f130b13b08af55" "q-106654/selection/127edc0006185b6c575c49a2eb865b631d7eeae721ad839b10f2cd1e6a486b41" "q-106654/selection/f0dc8f55811455c7ae189cb0c223a409bbc03654aa5f113d21aeb401e6990e47" "q-106654/selection/70a167450540fa0ca5a26cc0b3be79290689c03b699ecdeb0e7f17ef458850db" "q-106654/selection/2a4932299c8a1731b6870c8c4acffba9bd55fc4b3821f36fedf3846d7a8be1d2"] :db/ensure [:answer-field/validate]} {:db/id "q-106654" :question/id #uuid "6f61f141-3dc0-53a6-8909-845a088a0525" :question/math-academy-id "q-106654" :question/problem "Given that $y>30$ and $t>0,$ which of the following is an inhibited decay equation?" :question/worked-solution "An inhibited decay equation has the form\n\n$$\n\\frac{dy}{dt}=-k(y-a),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $y>a$ for all $t>0.$\n\nFrom the given options, the only inhibited decay equation is\n\n$$\n\\frac{dy}{dt}=840-28y.\n$$\n\nTo see this, let's factor the right-hand side of the equation. This gives,\n\n$$\n\\frac{dy}{dt}=-28(y-30).\n$$\n\nIn this case, the constant of proportionality is $k=28,$ and $a=30.$ Note that for inhibited decay, we must have $y>30$ for all $t>0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106654/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0709c667-bc10-5bd5-a383-3fd6ca332361"] :knowledge-point/questions ["q-106654"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-105898"] :question/problem "Given that $y>20$ and $t>0,$ which of the following is an inhibited decay equation?" :question/worked-solution "An inhibited decay equation has the form\n\n$$\n\\frac{dy}{dt}=-k(y-a),\n$$\n\nwhere $k>0$ is a constant of proportionality, and $y>a$ for all $t>0.$\n\nFrom the given options, the only inhibited decay equation is\n\n$$\n\\frac{dy}{dt}=-80(y-20).\n$$\n\nIn this case, the constant of proportionality is $k=80,$ and $a=20.$ Note that for inhibited decay, we must have $y>20$ for all $t>0.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-105890"] :question/worked-solution "An inhibited decay initial value problem has the form\n\n$$\n\\frac{dy}{dt}=-k(y-a),\\,y(0)={y}_{0}\n$$\n\nwhere $k>0$ is a constant of proportionality, and $y>a$ for all $t>0.$\n\nFrom the given options, the only inhibited decay problem is\n\n$$\n\\frac{dy}{dt}=-2(y-500),\\,y(0)=600.\n$$\n\nIn this case, $k=2,a=500,$ and ${y}_{0}=600.$ Notice that ${y}_{0}>a,$ which is required for inhibited decay. \n\nThe other options do not represent inhibited decay. In particular, the initial value problem\n\n$$\n\\frac{dy}{dt}=-2(y-500),\\,y(0)=400,\n$$\n\ndoes *not* represent inhibited decay model because ${y}_{0}=400<a=500.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-106935/selection/e90498dad7e025bac9b992640530601fdcce4b1669795c1ff7e7d50b950de0d0" :answer/id #uuid "13652fb1-f84d-590d-8220-90a32d70b95b" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-19k(T-90)" :db/ensure [:answer/validate]} {:db/id "q-106935/selection/fc494ff94cee6fec5d9b0a635270c8b95d10497e49b03ec5dd4799f396e145aa" :answer/id #uuid "cc7520b1-5d34-588d-b6c7-d81d8a574822" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-k(T-19)" :db/ensure [:answer/validate]} {:db/id "q-106935/selection/64540cd15fa5a8f3a435966a24099a0d2b503f0746e74bae73be795c9988113f" :answer/id #uuid "1f510184-ea1e-5a55-9996-200671c6d31f" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-90k(T-19)" :db/ensure [:answer/validate]} {:db/id "q-106935/selection/3ff9ac76e8c209e420aaa04bd32427b8e29ff72fc9aff11113346b7d737db22d" :answer/id #uuid "6191616a-cb79-54d3-83b4-11b1fcf49e21" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-90(T-19)" :db/ensure [:answer/validate]} {:db/id "q-106935/selection/c0c31716bcb61d92ed53c0565cadecf250568088707d3b5c5478f10269e25264" :answer/id #uuid "c0c1a33e-4340-5e63-aa54-83440875ed46" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-k(T-90)" :db/ensure [:answer/validate]} {:db/id "q-106935/selection" :answer-field/id #uuid "5d3c5875-313e-56dc-bd36-dd119157f06e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106935/selection/fc494ff94cee6fec5d9b0a635270c8b95d10497e49b03ec5dd4799f396e145aa" :answer-field/choices ["q-106935/selection/e90498dad7e025bac9b992640530601fdcce4b1669795c1ff7e7d50b950de0d0" "q-106935/selection/fc494ff94cee6fec5d9b0a635270c8b95d10497e49b03ec5dd4799f396e145aa" "q-106935/selection/64540cd15fa5a8f3a435966a24099a0d2b503f0746e74bae73be795c9988113f" "q-106935/selection/3ff9ac76e8c209e420aaa04bd32427b8e29ff72fc9aff11113346b7d737db22d" "q-106935/selection/c0c31716bcb61d92ed53c0565cadecf250568088707d3b5c5478f10269e25264"] :db/ensure [:answer-field/validate]} {:db/id "q-106935" :question/id #uuid "ae2e994f-7344-5287-a621-1bc5f34b7d82" :question/math-academy-id "q-106935" :question/problem "A container of water at a temperature of ${90}^{∘}\\text{C}$ is placed in a room. The temperature $T(t)$ of the water decreases at a rate that obeys Newton's law of cooling. Here, $T$ is measured in degrees Celsius, and $t>0$ is the time in minutes. If the room temperature is ${19}^{∘}\\text{C},$ which differential equation could be used to model the water temperature? Assume that $k>0$ is a constant of proportionality." :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-{T}_{S}),\n$$\n\nwhere ${T}_{S}$ is the temperature of the surroundings, and $k>0$ is a constant of proportionality.\n\nIn our case, ${T}_{S}={19}^{∘}\\text{C},$ and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-19).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106935/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74a902da-f299-54a3-8e93-ad2716d0e887"] :knowledge-point/questions ["q-106935"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-37365"] :question/problem "A medical doctor records the temperature of ${100}^{∘}\\text{F}$ using a thermometer. After the measurement is taken, the temperature reading $T(t)$ of the thermometer decreases at a rate that obeys Newton's law of cooling. Here, $T$ is measured in degrees Fahrenheit, and $t>0$ is the time in minutes. If the room temperature is ${64}^{∘}\\text{F},$ which differential equation could be used to model the thermometer reading? Assume that $k>0$ is a constant of proportionality." :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-{T}_{S}),\n$$\n\nwhere ${T}_{S}$ is the temperature of the surroundings, and $k>0$ is a constant of proportionality.\n\nIn our case, ${T}_{S}={64}^{∘}\\text{F},$ and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-64).\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-106883/selection/43f915cd36f56df8b0dd41020af9b7e7a212cbcae7d66366660cfe5b11e00d71" :answer/id #uuid "a2cf0719-7956-5878-a0a3-2147926ec997" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-kT(T-67)" :db/ensure [:answer/validate]} {:db/id "q-106883/selection/1ac53ecb135875ebbe5e2891150ef713b6581ac2684f3503115f456b8bb79fb4" :answer/id #uuid "0ab9ecb8-1147-57e8-ba45-5d8467837473" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-145(T-67)" :db/ensure [:answer/validate]} {:db/id "q-106883/selection/bae409ff27d17e12f32044e6fb72a5ba27dea642c61465667b59f6c521d8958d" :answer/id #uuid "7ccacb23-d5e4-5e9e-a1d6-012e7812d625" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-67(T-145)" :db/ensure [:answer/validate]} {:db/id "q-106883/selection/234cdbc67c65794d14c6ba7a682552aefd3d80bfe57fc2aa4ad44c3bbdd8b304" :answer/id #uuid "99c3be4b-8a21-5952-aede-bcab6df0f70a" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-k(T-145)" :db/ensure [:answer/validate]} {:db/id "q-106883/selection/91ec7945b37b69ea08955567f2e616ba69c6462eca07ab778b96b7c54615b2c3" :answer/id #uuid "9479a20c-670b-5663-a4ae-883b85314182" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}T}{\\text{d}t}=-k(T-67)" :db/ensure [:answer/validate]} {:db/id "q-106883/selection" :answer-field/id #uuid "81ace175-236e-54be-89b4-4ae677e9abb1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-106883/selection/91ec7945b37b69ea08955567f2e616ba69c6462eca07ab778b96b7c54615b2c3" :answer-field/choices ["q-106883/selection/43f915cd36f56df8b0dd41020af9b7e7a212cbcae7d66366660cfe5b11e00d71" "q-106883/selection/1ac53ecb135875ebbe5e2891150ef713b6581ac2684f3503115f456b8bb79fb4" "q-106883/selection/bae409ff27d17e12f32044e6fb72a5ba27dea642c61465667b59f6c521d8958d" "q-106883/selection/234cdbc67c65794d14c6ba7a682552aefd3d80bfe57fc2aa4ad44c3bbdd8b304" "q-106883/selection/91ec7945b37b69ea08955567f2e616ba69c6462eca07ab778b96b7c54615b2c3"] :db/ensure [:answer-field/validate]} {:db/id "q-106883" :question/id #uuid "998f64be-ba94-50b9-9031-1ab4cbc445c2" :question/math-academy-id "q-106883" :question/problem "A turkey reaches ${145}^{∘}\\text{F}$ in the oven. After removing the turkey from the oven, the turkey's temperature $T(t)$ decreases at a rate that obeys Newton's law of cooling. Here, $T$ is measured in degrees Fahrenheit, and $t>0$ is the time in minutes. If the room temperature is ${67}^{∘}\\text{F},$ which differential equation could be used to model the temperature of the turkey? Assume that $k>0$ is a constant of proportionality." :question/worked-solution "Newton's law of cooling states that the rate at which the temperature $T(t)$ of a body changes is proportional to the difference between its temperature and its surroundings. Therefore, we have the differential equation\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-{T}_{S}),\n$$\n\nwhere ${T}_{S}$ is the temperature of the surroundings, and $k>0$ is a constant of proportionality.\n\nIn our case, ${T}_{S}={67}^{∘}\\text{F},$ and we have\n\n$$\n\\frac{\\text{d}T}{\\text{d}t}=-k(T-67).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-106883/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74a902da-f299-54a3-8e93-ad2716d0e887"] :knowledge-point/questions ["q-106883"] :db/ensure [:knowledge-point/validate]} {:db/id "q-106878/selection/917a8cb19e046c2ebf4ca430eec456b4ff6853bc093144b64366644da41f5800" :answer/id #uuid "87cdb677-a03a-55d2-99f2-3df8718e2fbd" :answer/type :answer.type/math :answer/value "{T}^{′}(t)=k(T+21)" :db/ensure [:answer/validate]} {:db/id "q-106878/selection/1636f64647d484bae05f51486b6f37f826325227fdb70ff7fbee655069b9ed0f" :answer/id #uuid "0a9649ba-4862-587a-bf6e-a2d1ad382097" :answer/type :answer.type/math :answer/value "{T}^{′}(t)=kT(T-21)" :db/ensure [:answer/validate]} {:db/id "q-106878/selection/4fc4b4d638d105712602c6fc74107908f5d5af0f966f64b11244f0ee92dc1c75" :answer/id #uuid "d0823d2d-8ba9-5877-9097-88a6eb26c7fa" :answer/type :answer.type/math :answer/value "{T}^{′}(t)=-k(T-21)" :db/ensure [:answer/validate]} {:db/id "q-106878/selection/4498ef94a7a2b8e27caa08923ae5ad8852e1da8fef51528c00027d6a9920cf23" :answer/id #uuid "4a2dfc7a-9d22-5686-907d-5ee45dc13e62" :answer/type :answer.type/math :answer/value "{T}^{′}(t)=-kT(T-21)" :db/ensure [:answer/validate]} {:db/id "q-106878/selection/c1ca64126299a55c06688caec481a8aa86899099e888ff043fea408269ff25ac" :answer/id #uuid "ccb0c620-d9ba-57be-82c4-03d7cfde7891" :answer/type :answer.type/math :answer/value "{T}^{′}(t)=-k(T+21)" :db/ensure [:answer/validate]} {:db/id "q-106878/selection" :answer-field/id #uuid "b526f018-bed6-5df3-b8fd-2fe84f17f75e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-1