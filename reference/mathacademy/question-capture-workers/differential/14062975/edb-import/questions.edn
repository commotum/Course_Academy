#{[{:db/id #edb/ref 17592186310607 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a35d6ad3-66d5-54b9-ad61-b27832ac743c" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{2}{3}" :db/id #edb/ref 17592186310609} {:answer/id #uuid "1e0b9baf-35f4-5daa-8f82-a3ebda5bbf9d" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{25}{12}" :db/id #edb/ref 17592186310610} {:answer/id #uuid "b924906a-b743-5a33-bf80-b5bb23c8433e" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{4}{3}" :db/id #edb/ref 17592186310611} {:answer/id #uuid "0d19137a-016c-592c-ac06-92e62a799e75" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{3}{4}" :db/id #edb/ref 17592186310612} {:answer/id #uuid "1e62c450-d266-553f-a4e4-c2147c6c79a3" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{23}{12}" :db/id #edb/ref 17592186310613}] :answer-field/correct {:answer/id #uuid "1e62c450-d266-553f-a4e4-c2147c6c79a3" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{23}{12}" :db/id #edb/ref 17592186310613} :answer-field/id #uuid "fb597473-f05d-566a-988a-2db33154b28b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310608}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c2001916-7ed2-504f-9a8e-d02fda09253a" :question/math-academy-id "q-19493" :question/problem "Use the first two non-zero terms of the Taylor expansion of ${x}^{1/3}$ about $x=8$ to approximate the value of ${7}^{1/3}.$" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=8.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & ={x}^{1/3} \\\\ f(8) & ={8}^{1/3}=2 \\\\ {f}^{′}(x) & =\\frac{1}{3}{x}^{-2/3} \\\\ {f}^{′}(8) & =\\frac{1}{3}(8)^{-2/3}=\\frac{1}{3\\cdot 4}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}{x}^{1/3} & =2+\\frac{1}{3\\cdot 4}(x-8)+⋯ \\\\  & =2+\\frac{x-8}{12}+⋯.\\end{aligned}\n$$\n\nWe substitute $x=7$ into the above to approximate ${7}^{1/3}.$ We get\n\n$$\n\\begin{aligned}{7}^{1/3} & ≈2+\\frac{7-8}{12} \\\\  & =2-\\frac{1}{12} \\\\  & =\\frac{23}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330123 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66c0c571-c530-53f8-84be-f381739b9e19" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.792\\,7" :db/id #edb/ref 17592186330125} {:answer/id #uuid "a496d11a-3260-56c7-b8cc-a7b01df5f213" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.764\\,9" :db/id #edb/ref 17592186330126} {:answer/id #uuid "c73e0d91-6e95-53f3-a811-152fe40e0643" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.787\\,7" :db/id #edb/ref 17592186330127} {:answer/id #uuid "8beb57a2-9a93-5617-8158-fbe8681cc374" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.732\\,2" :db/id #edb/ref 17592186330128} {:answer/id #uuid "a3d34c65-1180-532f-bd46-bc08e5eab51b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.773\\,9" :db/id #edb/ref 17592186330129}] :answer-field/correct {:answer/id #uuid "a3d34c65-1180-532f-bd46-bc08e5eab51b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.773\\,9" :db/id #edb/ref 17592186330129} :answer-field/id #uuid "f7cd1b69-97b5-50fb-bf77-12efcb36b6cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330124}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "43923f1d-dfe1-5ab3-936a-6fc1d8791c67" :question/math-academy-id "q-9623" :question/problem "Use the first three non-zero terms of the Taylor expansion of $\\sqrt{x}$ about $x=4$ to approximate the value of $\\sqrt{\\pi }.$ Give your answer to $4$ decimal places." :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=4.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{x}={x}^{1/2} \\\\ f(4) & ={4}^{1/2}=2 \\\\ {f}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {f}^{′}(4) & =\\frac{1}{2}(4)^{-1/2}=\\frac{1}{{2}^{2}} \\\\ {f}^{″}(x) & =\\frac{1}{2}(-\\frac{1}{2}){x}^{-3/2}=-\\frac{1}{4}{x}^{-3/2} \\\\ {f}^{″}(4) & =-\\frac{1}{4}(4)^{-3/2}=-\\frac{1}{{2}^{5}}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\sqrt{x} & =2+\\frac{1}{{2}^{2}}(x-4)-\\frac{1}{2!}(\\frac{1}{{2}^{5}})(x-4)^{2}+⋯ \\\\  & =2+\\frac{x-4}{4}-\\frac{(x-4)^{2}}{64}+⋯\\,.\\end{aligned}\n$$\n\nWe substitute $x=\\pi $ into the above to approximate $\\sqrt{\\pi }.$ We get\n\n$$\n\\begin{aligned}\\sqrt{\\pi } & ≈2+\\frac{\\pi -4}{4}-\\frac{(\\pi -4)^{2}}{64} \\\\  & =1.773\\,9\\,,\\end{aligned}\n$$\n\nto $4$ decimal places."}]}
