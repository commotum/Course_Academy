[{:db/id "q-83193/selection/f8ab74417089733c61e9cbfafdfeec5a60ee0ba10ac87e26d6a30d33de1dc8d3" :answer/id #uuid "5b2522f6-a854-5f1b-a733-6980ccc3359c" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x)=(x-1)-\\frac{(x-1)^{2}}{2}+\\frac{(x-1)^{3}}{6}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83193/selection/3fd0485862c1574f4d3f49d75e340c66c28722a3136b63360fbf5f9a44376320" :answer/id #uuid "4942de3a-e1e6-5f7c-b929-71f526807fd1" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x)=(x-1)+(x-1)^{2}+2(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83193/selection/22f894a76433d021428a4df726c84f81f04cd84fc548a91dca2d6224305c2c76" :answer/id #uuid "a9d5b827-4362-563f-9419-9790b3bd0773" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x)=(x-1)-\\frac{(x-1)^{2}}{2}+\\frac{(x-1)^{3}}{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83193/selection/1fbf02d064614f0dd04f20cc56c367c37e3ceb171b7e11df8e874ea6883a8181" :answer/id #uuid "ff69dc2c-8152-56ff-9e07-a317f96c3e10" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x)=(x-1)+\\frac{(x-1)^{2}}{4}+\\frac{(x-1)^{3}}{6}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83193/selection/b55fe6ec31e5fd137b2f8b132168df1652ac1e16c70df2d89d2d9c640618a312" :answer/id #uuid "7f312b4a-dce0-5d88-a862-e063352c7099" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(x)=(x-1)-(x-1)^{2}+\\frac{(x-1)^{3}}{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83193/selection" :answer-field/id #uuid "6b6ed4c0-a886-5477-9389-01b80cbe009d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83193/selection/22f894a76433d021428a4df726c84f81f04cd84fc548a91dca2d6224305c2c76" :answer-field/choices ["q-83193/selection/f8ab74417089733c61e9cbfafdfeec5a60ee0ba10ac87e26d6a30d33de1dc8d3" "q-83193/selection/3fd0485862c1574f4d3f49d75e340c66c28722a3136b63360fbf5f9a44376320" "q-83193/selection/22f894a76433d021428a4df726c84f81f04cd84fc548a91dca2d6224305c2c76" "q-83193/selection/1fbf02d064614f0dd04f20cc56c367c37e3ceb171b7e11df8e874ea6883a8181" "q-83193/selection/b55fe6ec31e5fd137b2f8b132168df1652ac1e16c70df2d89d2d9c640618a312"] :db/ensure [:answer-field/validate]} {:db/id "q-83193" :question/id #uuid "1eaccba1-63e9-5a04-8dd1-346bfcdb59d9" :question/math-academy-id "q-83193" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{ln}⁡(x)$ about the point $x=1.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{ln}⁡(x)$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(x) \\\\ f(1) & =\\operatorname{ln}⁡1=0 \\\\ {f}^{′}(x) & =\\frac{1}{x}={x}^{-1} \\\\ {f}^{′}(1) & =(1)^{-1}=1 \\\\ {f}^{″}(x) & =-\\frac{1}{{x}^{2}}=-{x}^{-2} \\\\ {f}^{″}(1) & =-(1)^{-2}=-1 \\\\ {f}^{‴}(x) & =\\frac{2}{{x}^{3}}=2{x}^{-3} \\\\ {f}^{‴}(1) & =2(1)^{-3}=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(x) & =0+(1)(x-1)+\\frac{(-1)}{2!}(x-1)^{2}+\\frac{2}{3!}(x-1)^{3}+⋯ \\\\  & =(x-1)-\\frac{(x-1)^{2}}{2}+\\frac{(x-1)^{3}}{3}+⋯\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-83193/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-83193"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126848/selection/5eff5c6ff4f6d365109fa3ab0433f5f3379b56a5132e3cdc677e263c1eee1867" :answer/id #uuid "87b2a516-12cf-5cd8-9cbb-36df4a8918d0" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡\\pi x=-1+\\frac{1}{2}(x-1)-\\frac{{\\pi }^{2}}{3}(x-1)^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126848/selection/9fa817ca70a491649a1f1a3515fe9a7823baaaf5a55672a98a44c1bedd7bd84d" :answer/id #uuid "f38da3f0-9bc1-5b76-b8fa-3540d5e2c97a" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡\\pi x=(x-1)-(x-1)^{2}+\\frac{{\\pi }^{2}}{2}(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126848/selection/aa8217d9c10623b2b495c2d616dc3e56e640eb8a24cce2d9d3dfc708b7194379" :answer/id #uuid "c7bfb532-0097-579d-a089-134bca9ed8e0" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡\\pi x=-1+2(x-1)-\\frac{{\\pi }^{2}}{2}(x-1)^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126848/selection/c6df10efcd6453fb37e795927bc0d3ac8f64cc52607b2dc970eeb6b7af3245d5" :answer/id #uuid "6dfce6fe-56d2-5494-8872-09fc845c9a20" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡\\pi x=(x-1)+\\frac{1}{2}(x-1)^{2}-\\frac{{\\pi }^{2}}{4}(x-1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126848/selection/7fc1e0ad9595fab73aae4c4641e5f81a07dff27f0b781f623f24806fc1446649" :answer/id #uuid "1be55b35-6962-580d-8cd3-56ba75f9b7c5" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡\\pi x=-1-(x-1)+\\frac{{\\pi }^{2}}{2}(x-1)^{2}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126848/selection" :answer-field/id #uuid "8d9c35e8-b273-5402-82c4-1d1d84640c23" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126848/selection/7fc1e0ad9595fab73aae4c4641e5f81a07dff27f0b781f623f24806fc1446649" :answer-field/choices ["q-126848/selection/5eff5c6ff4f6d365109fa3ab0433f5f3379b56a5132e3cdc677e263c1eee1867" "q-126848/selection/9fa817ca70a491649a1f1a3515fe9a7823baaaf5a55672a98a44c1bedd7bd84d" "q-126848/selection/aa8217d9c10623b2b495c2d616dc3e56e640eb8a24cce2d9d3dfc708b7194379" "q-126848/selection/c6df10efcd6453fb37e795927bc0d3ac8f64cc52607b2dc970eeb6b7af3245d5" "q-126848/selection/7fc1e0ad9595fab73aae4c4641e5f81a07dff27f0b781f623f24806fc1446649"] :db/ensure [:answer-field/validate]} {:db/id "q-126848" :question/id #uuid "2e2f5cbd-2433-5f28-86f7-a805d1648c75" :question/math-academy-id "q-126848" :question/problem "Find the first three non-zero terms of the Taylor expansion of $x\\operatorname{cos}⁡\\pi x$ about $x=1.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=x\\operatorname{cos}⁡\\pi x$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =x\\operatorname{cos}⁡\\pi x \\\\ f(1) & =(1)\\operatorname{cos}⁡\\pi =-1 \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡\\pi x-\\pi x\\operatorname{sin}⁡\\pi x \\\\ {f}^{′}(1) & =\\operatorname{cos}⁡\\pi -(1)\\pi \\operatorname{sin}⁡\\pi =-1+0=-1 \\\\ {f}^{″}(x) & =-\\pi \\operatorname{sin}⁡\\pi x-\\pi \\operatorname{sin}⁡\\pi x-{\\pi }^{2}x\\operatorname{cos}⁡\\pi x=-2\\pi \\operatorname{sin}⁡\\pi x-{\\pi }^{2}x\\operatorname{cos}⁡\\pi x \\\\ {f}^{″}(1) & =-2\\pi \\operatorname{sin}⁡\\pi -{\\pi }^{2}(1)\\operatorname{cos}⁡\\pi =0+{\\pi }^{2}={\\pi }^{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡\\pi x & =-1-(x-1)+\\frac{{\\pi }^{2}}{2!}(x-1)^{2}+⋯ \\\\  & =-1-(x-1)+\\frac{{\\pi }^{2}}{2}(x-1)^{2}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126848/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-126848"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353900/field-1/aa0a125d82c0761e00b66b32f85d203a5a418461ff73ca61172a34d6c8136c2a" :answer/id #uuid "b1b8c046-5716-506b-8755-ede87bb061e1" :answer/type :answer.type/math :answer/value "-e^{-2}" :db/ensure [:answer/validate]} {:db/id "q-353900/field-1" :answer-field/id #uuid "9c2e8382-9d00-5eef-81e4-15a14c589031" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353900/field-1/aa0a125d82c0761e00b66b32f85d203a5a418461ff73ca61172a34d6c8136c2a" :answer-field/choices ["q-353900/field-1/aa0a125d82c0761e00b66b32f85d203a5a418461ff73ca61172a34d6c8136c2a"] :db/ensure [:answer-field/validate]} {:db/id "q-353900/field-2/13240d8ffc15eb4201b0bba7d389cc2a937e018401f5e9862d3d6c89f8d05d12" :answer/id #uuid "3a36b2b9-b3cd-5fea-b1f0-acbbb6c7a07b" :answer/type :answer.type/math :answer/value "\\frac{e^{-2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-353900/field-2" :answer-field/id #uuid "44a4cb54-277d-5999-892f-cee2e21df5de" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353900/field-2/13240d8ffc15eb4201b0bba7d389cc2a937e018401f5e9862d3d6c89f8d05d12" :answer-field/choices ["q-353900/field-2/13240d8ffc15eb4201b0bba7d389cc2a937e018401f5e9862d3d6c89f8d05d12"] :db/ensure [:answer-field/validate]} {:db/id "q-353900/field-3/83e981eee6c2e067fdf06b900270e78b1dfe5875ad6bb3f3923d5d098540762c" :answer/id #uuid "0c532c5c-5d48-59ad-b268-fe2329080ec1" :answer/type :answer.type/math :answer/value "\\frac{e^{-2}}{3}" :db/ensure [:answer/validate]} {:db/id "q-353900/field-3" :answer-field/id #uuid "3918c2d7-7a1a-535f-8df1-be345eb9e4c2" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353900/field-3/83e981eee6c2e067fdf06b900270e78b1dfe5875ad6bb3f3923d5d098540762c" :answer-field/choices ["q-353900/field-3/83e981eee6c2e067fdf06b900270e78b1dfe5875ad6bb3f3923d5d098540762c"] :db/ensure [:answer-field/validate]} {:db/id "q-353900" :question/id #uuid "fe0b7cd9-2bfe-51cc-bb6e-863fbdd6fb61" :question/math-academy-id "q-353900" :question/problem "Find the first three non-zero terms of the Taylor expansion of $(x+1){e}^{x}$ about $x=-2.$\n\n$(x+1){e}^{x}=$ {{field-1}} $+\\,$\n{{field-2}}\n$(x+2)^{2}\\,+\\,$\n{{field-3}}\n$(x+2)^{3}+⋯$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=(x+1){e}^{x}$ and $a=-2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =(x+1){e}^{x} \\\\ f(-2) & =(-2+1){e}^{-2}=-{e}^{-2} \\\\ {f}^{′}(x) & ={e}^{x}+(x+1){e}^{x}=(2+x){e}^{x} \\\\ {f}^{′}(-2) & =(2-2){e}^{-2}=0 \\\\ {f}^{″}(x) & ={e}^{x}+(2+x){e}^{x}=(3+x){e}^{x} \\\\ {f}^{″}(-2) & =(3-2){e}^{-2}={e}^{-2} \\\\ {f}^{‴}(x) & ={e}^{x}+(3+x){e}^{x}=(4+x){e}^{x} \\\\ {f}^{‴}(-2) & =(4-2){e}^{-2}=2{e}^{-2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}(x+1){e}^{x} & =-{e}^{-2}+(0)(x+2)+\\frac{{e}^{-2}}{2!}(x+2)^{2}+\\frac{2{e}^{-2}}{3!}(x+2)^{3}⋯ \\\\  & =-\\frac{1}{{e}^{2}}+\\frac{1}{2{e}^{2}}(x+2)^{2}+\\frac{1}{3{e}^{2}}(x+2)^{3}⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-353900/field-1" "q-353900/field-2" "q-353900/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-353900"] :db/ensure [:knowledge-point/validate]}]
