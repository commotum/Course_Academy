#{[{:db/id #edb/ref 17592186344771 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87b2a516-12cf-5cd8-9cbb-36df4a8918d0" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡\\pi x=-1+\\frac{1}{2}(x-1)-\\frac{{\\pi }^{2}}{3}(x-1)^{2}+⋯" :db/id #edb/ref 17592186344773} {:answer/id #uuid "1be55b35-6962-580d-8cd3-56ba75f9b7c5" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡\\pi x=-1-(x-1)+\\frac{{\\pi }^{2}}{2}(x-1)^{2}+⋯" :db/id #edb/ref 17592186344774} {:answer/id #uuid "f38da3f0-9bc1-5b76-b8fa-3540d5e2c97a" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡\\pi x=(x-1)-(x-1)^{2}+\\frac{{\\pi }^{2}}{2}(x-1)^{3}+⋯" :db/id #edb/ref 17592186344775} {:answer/id #uuid "c7bfb532-0097-579d-a089-134bca9ed8e0" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡\\pi x=-1+2(x-1)-\\frac{{\\pi }^{2}}{2}(x-1)^{2}+⋯" :db/id #edb/ref 17592186344776} {:answer/id #uuid "6dfce6fe-56d2-5494-8872-09fc845c9a20" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡\\pi x=(x-1)+\\frac{1}{2}(x-1)^{2}-\\frac{{\\pi }^{2}}{4}(x-1)^{3}+⋯" :db/id #edb/ref 17592186344777}] :answer-field/correct {:answer/id #uuid "1be55b35-6962-580d-8cd3-56ba75f9b7c5" :answer/type {:db/ident :answer.type/math} :answer/value "x\\operatorname{cos}⁡\\pi x=-1-(x-1)+\\frac{{\\pi }^{2}}{2}(x-1)^{2}+⋯" :db/id #edb/ref 17592186344774} :answer-field/id #uuid "8d9c35e8-b273-5402-82c4-1d1d84640c23" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344772}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2e2f5cbd-2433-5f28-86f7-a805d1648c75" :question/math-academy-id "q-126848" :question/problem "Find the first three non-zero terms of the Taylor expansion of $x\\operatorname{cos}⁡\\pi x$ about $x=1.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=x\\operatorname{cos}⁡\\pi x$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =x\\operatorname{cos}⁡\\pi x \\\\ f(1) & =(1)\\operatorname{cos}⁡\\pi =-1 \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡\\pi x-\\pi x\\operatorname{sin}⁡\\pi x \\\\ {f}^{′}(1) & =\\operatorname{cos}⁡\\pi -(1)\\pi \\operatorname{sin}⁡\\pi =-1+0=-1 \\\\ {f}^{″}(x) & =-\\pi \\operatorname{sin}⁡\\pi x-\\pi \\operatorname{sin}⁡\\pi x-{\\pi }^{2}x\\operatorname{cos}⁡\\pi x=-2\\pi \\operatorname{sin}⁡\\pi x-{\\pi }^{2}x\\operatorname{cos}⁡\\pi x \\\\ {f}^{″}(1) & =-2\\pi \\operatorname{sin}⁡\\pi -{\\pi }^{2}(1)\\operatorname{cos}⁡\\pi =0+{\\pi }^{2}={\\pi }^{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}x\\operatorname{cos}⁡\\pi x & =-1-(x-1)+\\frac{{\\pi }^{2}}{2!}(x-1)^{2}+⋯ \\\\  & =-1-(x-1)+\\frac{{\\pi }^{2}}{2}(x-1)^{2}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186310607 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a35d6ad3-66d5-54b9-ad61-b27832ac743c" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{2}{3}" :db/id #edb/ref 17592186310609} {:answer/id #uuid "1e0b9baf-35f4-5daa-8f82-a3ebda5bbf9d" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{25}{12}" :db/id #edb/ref 17592186310610} {:answer/id #uuid "b924906a-b743-5a33-bf80-b5bb23c8433e" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{4}{3}" :db/id #edb/ref 17592186310611} {:answer/id #uuid "0d19137a-016c-592c-ac06-92e62a799e75" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{3}{4}" :db/id #edb/ref 17592186310612} {:answer/id #uuid "1e62c450-d266-553f-a4e4-c2147c6c79a3" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{23}{12}" :db/id #edb/ref 17592186310613}] :answer-field/correct {:answer/id #uuid "1e62c450-d266-553f-a4e4-c2147c6c79a3" :answer/type {:db/ident :answer.type/math} :answer/value "{7}^{1/3}≈\\frac{23}{12}" :db/id #edb/ref 17592186310613} :answer-field/id #uuid "fb597473-f05d-566a-988a-2db33154b28b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186310608}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c2001916-7ed2-504f-9a8e-d02fda09253a" :question/math-academy-id "q-19493" :question/problem "Use the first two non-zero terms of the Taylor expansion of ${x}^{1/3}$ about $x=8$ to approximate the value of ${7}^{1/3}.$" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=8.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & ={x}^{1/3} \\\\ f(8) & ={8}^{1/3}=2 \\\\ {f}^{′}(x) & =\\frac{1}{3}{x}^{-2/3} \\\\ {f}^{′}(8) & =\\frac{1}{3}(8)^{-2/3}=\\frac{1}{3\\cdot 4}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}{x}^{1/3} & =2+\\frac{1}{3\\cdot 4}(x-8)+⋯ \\\\  & =2+\\frac{x-8}{12}+⋯.\\end{aligned}\n$$\n\nWe substitute $x=7$ into the above to approximate ${7}^{1/3}.$ We get\n\n$$\n\\begin{aligned}{7}^{1/3} & ≈2+\\frac{7-8}{12} \\\\  & =2-\\frac{1}{12} \\\\  & =\\frac{23}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344778 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1b8c046-5716-506b-8755-ede87bb061e1" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{-2}" :db/id #edb/ref 17592186344780}] :answer-field/correct {:answer/id #uuid "b1b8c046-5716-506b-8755-ede87bb061e1" :answer/type {:db/ident :answer.type/math} :answer/value "-e^{-2}" :db/id #edb/ref 17592186344780} :answer-field/id #uuid "9c2e8382-9d00-5eef-81e4-15a14c589031" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186344779} {:answer-field/choices [{:answer/id #uuid "3a36b2b9-b3cd-5fea-b1f0-acbbb6c7a07b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{-2}}{2}" :db/id #edb/ref 17592186344782}] :answer-field/correct {:answer/id #uuid "3a36b2b9-b3cd-5fea-b1f0-acbbb6c7a07b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{-2}}{2}" :db/id #edb/ref 17592186344782} :answer-field/id #uuid "44a4cb54-277d-5999-892f-cee2e21df5de" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186344781} {:answer-field/choices [{:answer/id #uuid "0c532c5c-5d48-59ad-b268-fe2329080ec1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{-2}}{3}" :db/id #edb/ref 17592186344784}] :answer-field/correct {:answer/id #uuid "0c532c5c-5d48-59ad-b268-fe2329080ec1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e^{-2}}{3}" :db/id #edb/ref 17592186344784} :answer-field/id #uuid "3918c2d7-7a1a-535f-8df1-be345eb9e4c2" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186344783}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fe0b7cd9-2bfe-51cc-bb6e-863fbdd6fb61" :question/math-academy-id "q-353900" :question/problem "Find the first three non-zero terms of the Taylor expansion of $(x+1){e}^{x}$ about $x=-2.$\n\n$(x+1){e}^{x}=$ {{field-1}} $+\\,$\n{{field-2}}\n$(x+2)^{2}\\,+\\,$\n{{field-3}}\n$(x+2)^{3}+⋯$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=(x+1){e}^{x}$ and $a=-2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =(x+1){e}^{x} \\\\ f(-2) & =(-2+1){e}^{-2}=-{e}^{-2} \\\\ {f}^{′}(x) & ={e}^{x}+(x+1){e}^{x}=(2+x){e}^{x} \\\\ {f}^{′}(-2) & =(2-2){e}^{-2}=0 \\\\ {f}^{″}(x) & ={e}^{x}+(2+x){e}^{x}=(3+x){e}^{x} \\\\ {f}^{″}(-2) & =(3-2){e}^{-2}={e}^{-2} \\\\ {f}^{‴}(x) & ={e}^{x}+(3+x){e}^{x}=(4+x){e}^{x} \\\\ {f}^{‴}(-2) & =(4-2){e}^{-2}=2{e}^{-2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}(x+1){e}^{x} & =-{e}^{-2}+(0)(x+2)+\\frac{{e}^{-2}}{2!}(x+2)^{2}+\\frac{2{e}^{-2}}{3!}(x+2)^{3}⋯ \\\\  & =-\\frac{1}{{e}^{2}}+\\frac{1}{2{e}^{2}}(x+2)^{2}+\\frac{1}{3{e}^{2}}(x+2)^{3}⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186344785 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff69dc2c-8152-56ff-9e07-a317f96c3e10" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x)=(x-1)+\\frac{(x-1)^{2}}{4}+\\frac{(x-1)^{3}}{6}+⋯" :db/id #edb/ref 17592186344787} {:answer/id #uuid "a9d5b827-4362-563f-9419-9790b3bd0773" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x)=(x-1)-\\frac{(x-1)^{2}}{2}+\\frac{(x-1)^{3}}{3}+⋯" :db/id #edb/ref 17592186344788} {:answer/id #uuid "4942de3a-e1e6-5f7c-b929-71f526807fd1" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x)=(x-1)+(x-1)^{2}+2(x-1)^{3}+⋯" :db/id #edb/ref 17592186344789} {:answer/id #uuid "7f312b4a-dce0-5d88-a862-e063352c7099" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x)=(x-1)-(x-1)^{2}+\\frac{(x-1)^{3}}{2}+⋯" :db/id #edb/ref 17592186344790} {:answer/id #uuid "5b2522f6-a854-5f1b-a733-6980ccc3359c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x)=(x-1)-\\frac{(x-1)^{2}}{2}+\\frac{(x-1)^{3}}{6}+⋯" :db/id #edb/ref 17592186344791}] :answer-field/correct {:answer/id #uuid "a9d5b827-4362-563f-9419-9790b3bd0773" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡(x)=(x-1)-\\frac{(x-1)^{2}}{2}+\\frac{(x-1)^{3}}{3}+⋯" :db/id #edb/ref 17592186344788} :answer-field/id #uuid "6b6ed4c0-a886-5477-9389-01b80cbe009d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186344786}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1eaccba1-63e9-5a04-8dd1-346bfcdb59d9" :question/math-academy-id "q-83193" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{ln}⁡(x)$ about the point $x=1.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{ln}⁡(x)$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{ln}⁡(x) \\\\ f(1) & =\\operatorname{ln}⁡1=0 \\\\ {f}^{′}(x) & =\\frac{1}{x}={x}^{-1} \\\\ {f}^{′}(1) & =(1)^{-1}=1 \\\\ {f}^{″}(x) & =-\\frac{1}{{x}^{2}}=-{x}^{-2} \\\\ {f}^{″}(1) & =-(1)^{-2}=-1 \\\\ {f}^{‴}(x) & =\\frac{2}{{x}^{3}}=2{x}^{-3} \\\\ {f}^{‴}(1) & =2(1)^{-3}=2.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(x) & =0+(1)(x-1)+\\frac{(-1)}{2!}(x-1)^{2}+\\frac{2}{3!}(x-1)^{3}+⋯ \\\\  & =(x-1)-\\frac{(x-1)^{2}}{2}+\\frac{(x-1)^{3}}{3}+⋯\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330123 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "66c0c571-c530-53f8-84be-f381739b9e19" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.792\\,7" :db/id #edb/ref 17592186330125} {:answer/id #uuid "a496d11a-3260-56c7-b8cc-a7b01df5f213" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.764\\,9" :db/id #edb/ref 17592186330126} {:answer/id #uuid "c73e0d91-6e95-53f3-a811-152fe40e0643" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.787\\,7" :db/id #edb/ref 17592186330127} {:answer/id #uuid "8beb57a2-9a93-5617-8158-fbe8681cc374" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.732\\,2" :db/id #edb/ref 17592186330128} {:answer/id #uuid "a3d34c65-1180-532f-bd46-bc08e5eab51b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.773\\,9" :db/id #edb/ref 17592186330129}] :answer-field/correct {:answer/id #uuid "a3d34c65-1180-532f-bd46-bc08e5eab51b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\pi }≈1.773\\,9" :db/id #edb/ref 17592186330129} :answer-field/id #uuid "f7cd1b69-97b5-50fb-bf77-12efcb36b6cc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330124}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "43923f1d-dfe1-5ab3-936a-6fc1d8791c67" :question/math-academy-id "q-9623" :question/problem "Use the first three non-zero terms of the Taylor expansion of $\\sqrt{x}$ about $x=4$ to approximate the value of $\\sqrt{\\pi }.$ Give your answer to $4$ decimal places." :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=4.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\sqrt{x}={x}^{1/2} \\\\ f(4) & ={4}^{1/2}=2 \\\\ {f}^{′}(x) & =\\frac{1}{2}{x}^{-1/2} \\\\ {f}^{′}(4) & =\\frac{1}{2}(4)^{-1/2}=\\frac{1}{{2}^{2}} \\\\ {f}^{″}(x) & =\\frac{1}{2}(-\\frac{1}{2}){x}^{-3/2}=-\\frac{1}{4}{x}^{-3/2} \\\\ {f}^{″}(4) & =-\\frac{1}{4}(4)^{-3/2}=-\\frac{1}{{2}^{5}}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\sqrt{x} & =2+\\frac{1}{{2}^{2}}(x-4)-\\frac{1}{2!}(\\frac{1}{{2}^{5}})(x-4)^{2}+⋯ \\\\  & =2+\\frac{x-4}{4}-\\frac{(x-4)^{2}}{64}+⋯\\,.\\end{aligned}\n$$\n\nWe substitute $x=\\pi $ into the above to approximate $\\sqrt{\\pi }.$ We get\n\n$$\n\\begin{aligned}\\sqrt{\\pi } & ≈2+\\frac{\\pi -4}{4}-\\frac{(\\pi -4)^{2}}{64} \\\\  & =1.773\\,9\\,,\\end{aligned}\n$$\n\nto $4$ decimal places."}]}
