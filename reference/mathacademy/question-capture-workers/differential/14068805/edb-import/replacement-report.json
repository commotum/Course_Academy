      "source": [
        {
          "question": "e-21666",
          "field": null,
          "attribute": "question/problem",
          "value": "Which statement correctly describes an **asymptotically stable** equilibrium point?\n\n- Some solutions starting arbitrarily close to the equilibrium eventually move away from it.\n\n- Solutions that start sufficiently close to the equilibrium remain close and converge to the equilibrium as $t \\to \\infty.$\n\n- Solutions that start sufficiently close to the equilibrium remain close but do not necessarily converge to the equilibrium.\n\n- Solutions that start sufficiently close to the equilibrium remain close and sometimes converge to the equilibrium as $t \\to \\infty.$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/example-21666.json",
          "file_sha256": "6c293d74cb2e4a164182899e80e96891dc2f7b0f62079a12532760f37ab808a3"
        }
      ],
      "basis": 2344,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068805/edb-import/commit.edn",
