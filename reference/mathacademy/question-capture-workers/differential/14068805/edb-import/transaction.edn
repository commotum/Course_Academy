[{:db/id "q-335646/selection/f3d401f0f822677ce2392bc11c6237708787899b446bdb5b3d792628ec0077b1" :answer/id #uuid "112090d6-364f-5200-8be1-74b0719229b7" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}2 \\\\ -3\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335646/selection/d6b66fcfc5e444ac4a6bc916d3c5792f7916cd83ee3c02d2fb20a2501d6fa39d" :answer/id #uuid "9517018c-c2e8-5e95-8d60-013c65af69cd" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-335646/selection/5fbf7c05fd104dd52f1915643da493dd882e955f3ad4206c881bc02b8b8e490b" :answer/id #uuid "c29437a1-c9a1-5b80-930f-82c8b92cd15e" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335646/selection/23a1d7025ecf342598ad3e09f648c0c09c833202e4c753ebb43af5ba7b406ff5" :answer/id #uuid "f3678b52-6f52-5320-96b5-d3d645efa19d" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335646/selection/dbac8e3661b883bad890e8eccd87d19c8d501522c1ef01f68e6f0fa184651bbc" :answer/id #uuid "963c966c-8b46-5e69-88de-454c40b1cdac" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}3 \\\\ 2\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-335646/selection" :answer-field/id #uuid "73a08da2-0d7c-561b-a1c9-95024bd0944d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-335646/selection/23a1d7025ecf342598ad3e09f648c0c09c833202e4c753ebb43af5ba7b406ff5" :answer-field/choices ["q-335646/selection/f3d401f0f822677ce2392bc11c6237708787899b446bdb5b3d792628ec0077b1" "q-335646/selection/d6b66fcfc5e444ac4a6bc916d3c5792f7916cd83ee3c02d2fb20a2501d6fa39d" "q-335646/selection/5fbf7c05fd104dd52f1915643da493dd882e955f3ad4206c881bc02b8b8e490b" "q-335646/selection/23a1d7025ecf342598ad3e09f648c0c09c833202e4c753ebb43af5ba7b406ff5" "q-335646/selection/dbac8e3661b883bad890e8eccd87d19c8d501522c1ef01f68e6f0fa184651bbc"] :db/ensure [:answer-field/validate]} {:db/id "q-335646" :question/id #uuid "38dcf5d3-98d5-5fe3-9e27-ff6452649b0c" :question/math-academy-id "q-335646" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t)-3y(t) \\\\ {y}^{′}(t)=x(t)+y(t)\\end{aligned}\n$$\n\nWhich of the following gives all equilibrium points of the system of linear differential equations above?" :question/worked-solution "The equilibrium (fixed) points of a system ${x}^{′}(t)=f(x,y)$ are the points for which $f(x,y)=0.$ So, we get the following system of linear equations:\n\n$$\n{\\begin{aligned}2x-3y=0 \\\\ x+y=0\\end{aligned}\n$$\n\nMultiplying the second equation by $-2$ and adding the result to the first equation, we obtain\n\n$$\n-5y=0\\,⇒\\,y=0.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\nx+0=0\\,⇒\\,x=0.\n$$\n\nTherefore, the equilibrium point is\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}0 \\\\ 0\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-335646/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c508ee9c-0dee-5d37-9f80-d5e7334160b8"] :knowledge-point/questions ["q-335646"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335639/selection/23a1d7025ecf342598ad3e09f648c0c09c833202e4c753ebb43af5ba7b406ff5" :answer/id #uuid "8b2ca989-a425-5592-88a4-4344cd27baa6" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}0 \\\\ 0\\end{aligned}]$ only" :db/ensure [:answer/validate]} {:db/id "q-335639/selection/c72838f5e065f2fca80b6b020e5aaffbe0a12d4dcf6ca0911c94e4f45447bcc7" :answer/id #uuid "9bf3776d-50e7-5d41-9c95-9b45ee960d9e" :answer/type :answer.type/text :answer/value "$[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$\nand\n$[\\begin{aligned}1 \\\\ 3\\end{aligned}]$" :d