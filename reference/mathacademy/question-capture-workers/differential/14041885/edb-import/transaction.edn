[{:db/id "q-126846/selection/5fa470ef4ff3e08f7082b1ee77e6cf1115219ef7c1cada46840df2d922ef543a" :answer/id #uuid "5742a0c4-23ba-5b1f-a23f-5b9e10b074dc" :answer/type :answer.type/math :answer/value "\\frac{1}{x+2}=2+(x+1)+(x+1)^{2}+(x+1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126846/selection/f57db8c7318c9be836077e879df486ef39bcc35b3ca397311d55695b46d35110" :answer/id #uuid "f46eaf94-cc1f-5b2a-bf1a-e3a51c7a0a36" :answer/type :answer.type/math :answer/value "\\frac{1}{x+2}=1-(x+1)+\\frac{(x+1)^{2}}{2}-\\frac{(x+1)^{3}}{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126846/selection/ceef1c8261c712c2a440455b70b1f14599b8ded673b1dc3ee38ab6b909e20281" :answer/id #uuid "51984cf6-87df-5419-bba7-fa0acef73b58" :answer/type :answer.type/math :answer/value "\\frac{1}{x+2}=2-(x+1)^{2}+(x+1)^{4}-(x+1)^{6}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126846/selection/640034ae5c67901e48e050a2955ce1b2c748f8e34831f0e95e156a2201805dd2" :answer/id #uuid "55ea2b50-1604-5d5c-bdbf-c518681a2d3e" :answer/type :answer.type/math :answer/value "\\frac{1}{x+2}=1-(x+1)+(x+1)^{2}-(x+1)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126846/selection/331230f0896a7169419c632c2d51b0abb908a46c1af5396502b1196f46350b36" :answer/id #uuid "4dc20135-5b7b-5eae-bfff-0f0a1960fe20" :answer/type :answer.type/math :answer/value "\\frac{1}{x+2}=1+(x+1)^{2}+\\frac{(x+1)^{4}}{4}+\\frac{(x+1)^{6}}{6}+⋯" :db/ensure [:answer/validate]} {:db/id "q-126846/selection" :answer-field/id #uuid "5e02c16f-1538-5865-b304-ecc4154e5812" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126846/selection/640034ae5c67901e48e050a2955ce1b2c748f8e34831f0e95e156a2201805dd2" :answer-field/choices ["q-126846/selection/5fa470ef4ff3e08f7082b1ee77e6cf1115219ef7c1cada46840df2d922ef543a" "q-126846/selection/f57db8c7318c9be836077e879df486ef39bcc35b3ca397311d55695b46d35110" "q-126846/selection/ceef1c8261c712c2a440455b70b1f14599b8ded673b1dc3ee38ab6b909e20281" "q-126846/selection/640034ae5c67901e48e050a2955ce1b2c748f8e34831f0e95e156a2201805dd2" "q-126846/selection/331230f0896a7169419c632c2d51b0abb908a46c1af5396502b1196f46350b36"] :db/ensure [:answer-field/validate]} {:db/id "q-126846" :question/id #uuid "cb65a227-175b-5c42-aa58-2cfefad23b3f" :question/math-academy-id "q-126846" :question/problem "Find the first four non-zero terms in the Taylor expansion of $\\frac{1}{x+2}$ about the point $x=-1.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\frac{1}{x+2}$ and $a=-1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{x+2}=(x+2)^{-1} \\\\ f(-1) & =(-1+2)^{-1}=1 \\\\ {f}^{′}(x) & =-(x+2)^{-2} \\\\ {f}^{′}(-1) & =-(-1+2)^{-2}=-1 \\\\ {f}^{″}(x) & =2(x+2)^{-3} \\\\ {f}^{″}(-1) & =2(-1+2)^{-3}=2 \\\\ {f}^{‴}(x) & =-6(x+2)^{-4} \\\\ {f}^{‴}(-1) & =-6(-1+2)^{-4}=-6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{x+2} & =1+(-1)(x+1)+\\frac{2}{2!}(x+1)^{2}+\\frac{(-6)}{3!}(x+1)^{3}+⋯ \\\\  & =1-(x+1)+(x+1)^{2}-(x+1)^{3}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-126846/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-126846"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83185/selection/638df15708d58f3bae7349d0d88e689e32f7c850df6fb5777b51f508c38eb7d7" :answer/id #uuid "4769134a-6e2d-5876-ba70-e6374cc2431f" :answer/type :answer.type/math :answer/value "\\frac{1}{x+3}=1-(x+2)+(x+2)^{2}-(x+2)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83185/selection/2200e02a77744adb2aa24b722fa982bc9ebe00d95d83c16fb555e50aa604faff" :answer/id #uuid "00f7733a-e203-5955-a0c4-4651f483748d" :answer/type :answer.type/math :answer/value "\\frac{1}{x+3}=1+2(x+2)+3(x+2)^{2}+6(x+2)^{3}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83185/selection/df18b2b386a6c3f6f982af922a288cc77b44c6fcec20681952277d3fd518f584" :answer/id #uuid "1bb24355-b6fc-5261-a43e-938374eab8b2" :answer/type :answer.type/math :answer/value "\\frac{1}{x+3}=1-\\frac{(x+2)}{2}+\\frac{(x+2)^{2}}{6}-\\frac{(x+2)^{3}}{24}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83185/selection/cd87c2f13ee30485154c5cabecce49bee0f38251b5eeb2ccfc5b860a5ac075b9" :answer/id #uuid "1c1e193b-b2cd-570e-9408-725025ccf94b" :answer/type :answer.type/math :answer/value "\\frac{1}{x+3}=1-(x+2)+\\frac{(x+2)^{2}}{2}-\\frac{(x+2)^{3}}{6}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83185/selection/de8da2b733451488a74ada68c67077cca564ffebf89f26d33e1d96c3aa5afb00" :answer/id #uuid "46a98f0c-90ce-5056-b47d-e43ad80d0bfc" :answer/type :answer.type/math :answer/value "\\frac{1}{x+3}=1-(x+2)+\\frac{(x+2)^{2}}{8}-\\frac{(x+2)^{3}}{24}+⋯" :db/ensure [:answer/validate]} {:db/id "q-83185/selection" :answer-field/id #uuid "4c71e486-aef9-537f-8515-b3787190972b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83185/selection/638df15708d58f3bae7349d0d88e689e32f7c850df6fb5777b51f508c38eb7d7" :answer-field/choices ["q-83185/selection/638df15708d58f3bae7349d0d88e689e32f7c850df6fb5777b51f508c38eb7d7" "q-83185/selection/2200e02a77744adb2aa24b722fa982bc9ebe00d95d83c16fb555e50aa604faff" "q-83185/selection/df18b2b386a6c3f6f982af922a288cc77b44c6fcec20681952277d3fd518f584" "q-83185/selection/cd87c2f13ee30485154c5cabecce49bee0f38251b5eeb2ccfc5b860a5ac075b9" "q-83185/selection/de8da2b733451488a74ada68c67077cca564ffebf89f26d33e1d96c3aa5afb00"] :db/ensure [:answer-field/validate]} {:db/id "q-83185" :question/id #uuid "b7afe118-2a0b-56b6-9c4b-c1f500a7e109" :question/math-academy-id "q-83185" :question/problem "Find the first four non-zero terms in the Taylor expansion of $\\frac{1}{x+3}$ about the point $x=-2.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\frac{1}{x+3}$ and $a=-2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{x+3}=(x+3)^{-1} \\\\ f(-2) & =(-2+3)^{-1}=1 \\\\ {f}^{′}(x) & =-\\frac{1}{(x+3)^{2}}=-(x+3)^{-2} \\\\ {f}^{′}(-2) & =-(-2+3)^{-2}=-1 \\\\ {f}^{″}(x) & =\\frac{2}{(x+3)^{3}}=2(x+3)^{-3} \\\\ {f}^{″}(-2) & =2(-2+3)^{-3}=2 \\\\ {f}^{‴}(x) & =-\\frac{6}{(x+3)^{4}}=-6(x+3)^{-4} \\\\ {f}^{‴}(-2) & =-6(-2+3)^{-4}=-6.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{x+3} & =1+(-1)(x+2)+\\frac{2}{2!}(x+2)^{2}+\\frac{(-6)}{3!}(x+2)^{3}+⋯ \\\\  & =1-(x+2)+(x+2)^{2}-(x+2)^{3}+⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-83185/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-83185"] :db/ensure [:knowledge-point/validate]} {:db/id "q-353748/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "df544f64-1e00-53a5-89db-2ca6d853187a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-353748/field-1" :answer-field/id #uuid "1879832a-7d6c-552b-99ef-a9f7a9e2cf67" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353748/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-353748/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-353748/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "459e56fa-7c62-58b5-b02b-4953cb089f80" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-353748/field-2" :answer-field/id #uuid "942da90c-4c11-5738-994e-55674e808b10" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353748/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-353748/field-2/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-353748/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "31ad8cbf-3b36-545d-a4dd-44bdc8d8ba49" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-353748/field-3" :answer-field/id #uuid "19a200f6-6b83-5ee7-a15a-cb8cd15b2fcd" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353748/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-353748/field-3/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-353748" :question/id #uuid "412cac86-33d7-57b1-9ed4-099cebbff26a" :question/math-academy-id "q-353748" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\frac{1}{{x}^{4}}$ about the point $x=1.$\n\n$\\frac{1}{{x}^{4}}=${{field-1}}\n$-\\,$\n{{field-2}}\n$(x-1)\\,+\\,$\n{{field-3}}\n$(x-1)^{2}-⋯$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\frac{1}{{x}^{4}}$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{{x}^{4}}={x}^{-4} \\\\ f(1) & ={1}^{-4}=1 \\\\ {f}^{′}(x) & =-\\frac{4}{{x}^{5}}=-4{x}^{-5} \\\\ {f}^{′}(1) & =-4(1)^{-5}=-4 \\\\ {f}^{″}(x) & =\\frac{20}{{x}^{6}}=20{x}^{-6} \\\\ {f}^{″}(1) & =20(1)^{-6}=20.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\frac{1}{{x}^{4}} & =1+(-4)(x-1)+\\frac{20}{2!}(x-1)^{2}+\\frac{(-120)}{3!}(x-1)^{3}+⋯ \\\\  & =1-4(x-1)+10(x-1)^{2}-⋯.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-353748/field-1" "q-353748/field-2" "q-353748/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651"] :knowledge-point/questions ["q-353748"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83217/selection/2090a7507318debb52c1ba597b07efc360a06b0d45f14544f205b7f1f431ee2b" :answer/id #uuid "1e6ae820-3a19-590c-8709-2f75d4e37241" :answer/type :answer.type/math :answer/value "{8}^{-1/2}≈\\frac{17}{81}" :db/ensure [:answer/validate]} {:db/id "q-83217/selection/99f838ef9ebe3602f29c32de00011e4bb9894a60dc105256174e68c39ff6a926" :answer/id #uuid "f4bb2de3-dfa7-5cc3-b432-19f9fef8b71c" :answer/type :answer.type/math :answer/value "{8}^{-1/2}≈\\frac{8}{27}" :db/ensure [:answer/validate]} {:db/id "q-83217/selection/cb8754a24d74967cfc293f77d78d076ce1cfee0c0dee7e19eafefdccacb22f3c" :answer/id #uuid "808444ec-1ec7-5d3f-a798-b0a0aee0390d" :answer/type :answer.type/math :answer/value "{8}^{-1/2}≈\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "q-83217/selection/d7871a3e89eef25c34b28e8c19f92c64faa39edcf5065edc2f600d831ba2fb1c" :answer/id #uuid "c83d3f79-7368-58d1-bda0-c3a7bf3a7458" :answer/type :answer.type/math :answer/value "{8}^{-1/2}≈\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-83217/selection/0a674132d74042691d52aecd3d6a949a70bdc7ca10dbafaa440d4a1689ebd5fb" :answer/id #uuid "44f45b9f-8f31-5874-838b-ad7e19edb0ad" :answer/type :answer.type/math :answer/value "{8}^{-1/2}≈\\frac{19}{54}" :db/ensure [:answer/validate]} {:db/id "q-83217/selection" :answer-field/id #uuid "e0192f89-92ee-5f28-a896-029429db6eb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83217/selection/0a674132d74042691d52aecd3d6a949a70bdc7ca10dbafaa440d4a1689ebd5fb" :answer-field/choices ["q-83217/selection/2090a7507318debb52c1ba597b07efc360a06b0d45f14544f205b7f1f431ee2b" "q-83217/selection/99f838ef9ebe3602f29c32de00011e4bb9894a60dc105256174e68c39ff6a926" "q-83217/selection/cb8754a24d74967cfc293f77d78d076ce1cfee0c0dee7e19eafefdccacb22f3c" "q-83217/selection/d7871a3e89eef25c34b28e8c19f92c64faa39edcf5065edc2f600d831ba2fb1c" "q-83217/selection/0a674132d74042691d52aecd3d6a949a70bdc7ca10dbafaa440d4a1689ebd5fb"] :db/ensure [:answer-field/validate]} {:db/id "q-83217" :question/id #uuid "f750b509-3c63-5fc0-8993-9bde234b6a4e" :question/math-academy-id "q-83217" :question/problem "Use the first two non-zero terms of the Taylor expansion of ${x}^{-1/2}$ about $x=9$ to approximate the value of ${8}^{-1/2}.$" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $a=9.$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & ={x}^{-1/2} \\\\ f(9) & ={9}^{-1/2}=\\frac{1}{3} \\\\ {f}^{′}(x) & =-\\frac{1}{2}{x}^{-3/2} \\\\ {f}^{′}(9) & =-\\frac{1}{2}(9)^{-3/2}=-\\frac{1}{2\\cdot 27}.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}{x}^{-1/2} & =\\frac{1}{3}-\\frac{1}{2\\cdot 27}(x-9)+⋯ \\\\  & =\\frac{1}{3}-\\frac{x-9}{54}+⋯.\\end{aligned}\n$$\n\nWe substitute $x=8$ into the above to approximate ${8}^{-1/2}.$ We get\n\n$$\n\\begin{aligned}{8}^{-1/2} & ≈\\frac{1}{3}-\\frac{8-9}{54} \\\\  & =\\frac{1}{3}+\\frac{1}{54} \\\\  & =\\frac{19}{54}\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-83217/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3"] :knowledge-point/questions ["q-83217"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126875/selection/c41b0cf6fc3f8912068aaab9c01902c9106c07278c9d38651339e9e5a164ea51" :answer/id #uuid "9741e3d2-fd7b-5558-b19b-bdf48cbd60cf" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(1.5)≈0.415" :db/ensure [:answer/validate]} {:db/id "q-126875/selection/85ae5ccf31157335b4bfc10e3b3e1294f75e4c857a82452321e56d8a5b95c4d0" :answer/id #uuid "c241ca2c-bbf5-5377-99ef-43