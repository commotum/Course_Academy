}0 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80548/selection/ma-v1/a676bd87a45fff9ce57aa0b2ad13375ca333b535bc92e5af964ada32bc483b75"] :db/ensure [:question/validate]} {:db/id "q-80910/selection/0c39a8d408af69ff6a14d8193dc52e2be38f223aff5d3aa2ef5fbc2d35cf50e8" :answer/id #uuid "fb1237f4-f879-5dd1-900c-fa616c3085b3" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-2t/3}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t/3},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-80910/selection/9d22a5ca92cab29cb74d84a40a19cba7c8342d3d687efe82923a5532f0ae4e95" :answer/id #uuid "8ee19b2e-7bd1-5f99-adee-2e97d56781b4" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{3t/2}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t/2},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-80910/selection/12f332f249e3328a15fcc42f32aa6cefb9675e9c2dbe9cffd4489caae59b8bcd" :answer/id #uuid "442c9958-715b-5413-900b-50347d126a29" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-2t/3}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{2t/3},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-80910/selection/a2a6e56d036864cd3c541a66f659b4497acb2e5e3206dc742a1c7d1e9038b557" :answer/id #uuid "ed19242a-7294-578e-b6e9-e0bf9bedda90" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t/2}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{3t/2},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-80910/selection/591705dfb3c5f8889cb99b41364373d9193a69507fbe22da2ff21b165f5b8c4d" :answer/id #uuid "ee9be16e-8125-5fa4-af4f-5055978019e6" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{2t/3}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{2t/3},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-80910/selection" :answer-field/id #uuid "578925d7-bb42-5dc7-abc8-18ced5053b8b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80910/selection/591705dfb3c5f8889cb99b41364373d9193a69507fbe22da2ff21b165f5b8c4d" :answer-field/choices ["q-80910/selection/0c39a8d408af69ff6a14d8193dc52e2be38f223aff5d3aa2ef5fbc2d35cf50e8" "q-80910/selection/9d22a5ca92cab29cb74d84a40a19cba7c8342d3d687efe82923a5532f0ae4e95" "q-80910/selection/12f332f249e3328a15fcc42f32aa6cefb9675e9c2dbe9cffd4489caae59b8bcd" "q-80910/selection/a2a6e56d036864cd3c541a66f659b4497acb2e5e3206dc742a1c7d1e9038b557" "q-80910/selection/591705dfb3c5f8889cb99b41364373d9193a69507fbe22da2ff21b165f5b8c4d"] :db/ensure [:answer-field/validate]} {:db/id "q-80910" :question/id #uuid "c35a2dcf-409f-52ac-b982-e1b503b77b19" :question/math-academy-id "q-80910" :question/problem "Find the general solution to the matrix differential equation $\\,{x}^{′}(t)=[\\begin{aligned}\\frac{2}{3} & 0 \\\\ 0 & \\frac{2}{3}\\end{aligned}]x(t).$" :question/worked-solution "Given a decoupled system of first-order linear ODEs in the form\n\n$$\n[\\begin{aligned}{x}_{1}^{′}(t) \\\\ {x}_{2}^{′}(t)\\end{aligned}]=[\\begin{aligned}\\lambda  & 0 \\\\ 0 & \\lambda \\end{aligned}][\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}],\n$$\n\nthe formula for the general solution is\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{\\lambda t}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{\\lambda t},\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nSince the matrix of our differential equation is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{2t/3}+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{2t/3},\\,{c}_{1},{c}_{2}\\in R.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80910/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3d04ce85-c364-52ba-aa30-ca47e307496e"] :knowledge-point/questions ["q-80910"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326236/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "aa0b8cde-2308-5684-bc2d-4170ce068ffa" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-326236/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "41e889f0-cf67-56c8-bde3-9d09c0da1700" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-326236/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" :answer/id #uuid "708fbda8-aecd-535b-9d1a-45206ce50ef9" :answer/type :answer.type/math :answer/value "-\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-326236/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "1b9ea115-8728-5121-ba04-3e5a7925691f" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-326236/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "cd760e29-e0d7-5271-8e97-4820c5e20fae" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-326236/selection" :answer-field/id #uuid "cb54014a-0986-526c-b516-fae16665be31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-326236/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer-field/choices ["q-326236/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-326236/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-326236/selection/5ab3573096b30d3c5d3c378e667364cbb062f921e9b1002441e594f0774a669d" "q-326236/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-326236/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277"] :db/ensure [:answer-field/validate]} {:db/id "q-326236" :question/id #uuid "17c5a462-c29c-5b82-b891-ee8c95c1220f" :question/math-academy-id "q-326236" :question/problem "Consider the system of linear differential equations given by\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & 0 \\\\ 3 & -1\\end{aligned}]x(t).\n$$\n\nGiven that the solution to the system can be written as\n\n$$\nx(t)={c}_{1}[\\begin{aligned}a \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}([\\begin{aligned}a \\\\ 1\\end{aligned}]t{e}^{-t}+[\\begin{aligned}b \\\\ 0\\end{aligned}]{e}^{-t}),\\,{c}_{1},{c}_{2}\\in R,\n$$\n\nwhat is the value of $a+b?$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-1 & 0 \\\\ 3 & -1\\end{aligned}].$\n\nSince $A$ is lower-triangular, the repeated eigenvalue is $\\lambda =-1$ (of multiplicity two).\nFor this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}0 & 0 \\\\ 3 & 0\\end{aligned}]∼[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution of the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-1-(-1) & 0 \\\\ 3 & -1-(-1)\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}0 & 0 \\\\ 3 & 0\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}0{w}_{1}+0{w}_{2}=0 \\\\ 3{w}_{1}+0{w}_{2}=1\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n{w}_{1}=\\frac{1}{3}.\n$$\n\nThe variable ${w}_{2}$ is a free variable. Setting ${w}_{2}=0,$ we get \n\n$$\nw=[\\begin{aligned}\\frac{1}{3} \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}([\\begin{aligned}0 \\\\ 1\\end{aligned}]t{e}^{-t}+[\\begin{aligned}\\frac{1}{3} \\\\ 0\\end{aligned}]{e}^{-t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFinally, we see that $a=0,b=\\frac{1}{3},$ and $a+b=\\frac{1}{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326236/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c19f9d9-fa4b-5261-b9a0-99a203aeac30"] :knowledge-point/questions ["q-326236"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80604/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3ddbff16-0ab8-548a-b391-0173fa194350" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-80604/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "17f315b1-aeb4-5689-9bd5-8085507f8038" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-80604/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c7e4ffa9-4805-59d5-887b-04dbcca8e8de" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-80604/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "492847c3-dcfc-554c-bf56-ed40f02b273a" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-80604/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "aa865f13-e07d-58b4-aa92-8898251eed51" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-80604/selection" :answer-field/id #uuid "164061c8-7e18-5b2b-b508-6a3649ea0889" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80604/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-80604/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-80604/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-80604/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-80604/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-80604/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-80604" :question/id #uuid "e333c35f-41be-5fac-830b-452f74b604a5" :question/math-academy-id "q-80604" :question/problem "Consider the system of linear differential equations given by\n\n$$\n{x}^{′}(t)=[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}]x(t).\n$$\n\nGiven that the solution to the system can be written as\n\n$$\nx(t)={c}_{1}[\\begin{aligned}a \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}([\\begin{aligned}a \\\\ 1\\end{aligned}]t{e}^{-t}+[\\begin{aligned}b \\\\ 0\\end{aligned}]{e}^{-t}),\\,{c}_{1},{c}_{2}\\in R,\n$$\n\nwhat is the value of $a+b?$\n\n*Hint: The only eigenvalue of the system's matrix is $\\lambda =-1.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}1 & 4 \\\\ -1 & -3\\end{aligned}].$\n\nWe are given that the eigenvalue is $\\lambda =-1$ (of multiplicity two). For this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}2 & 4 \\\\ -1 & -2\\end{aligned}]∼[\\begin{aligned}2 & 4 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution of the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}1+1 & 4 \\\\ -1 & -3+1\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}2 & 4 \\\\ -1 & -2\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}2{w}_{1}+4{w}_{2}=-2 \\\\ -1{w}_{1}-2{w}_{2}=1\\end{aligned}\n$$\n\nNote that the first equation is a constant multiple of the second. So, we obtain\n\n$$\n{w}_{1}=-1-2{w}_{2}.\n$$\n\nThe variable ${w}_{2}$ is a free variable. Setting ${w}_{2}=0,$ we get ${w}_{1}=-1,$ and therefore\n\n$$\nw=[\\begin{aligned}-1 \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}([\\begin{aligned}-2 \\\\ 1\\end{aligned}]t{e}^{-t}+[\\begin{aligned}-1 \\\\ 0\\end{aligned}]{e}^{-t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFinally, we see that $a=-2,b=-1,$ and $a+b=-3.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80604/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c19f9d9-fa4b-5261-b9a0-99a203aeac30"] :knowledge-point/questions ["q-80604"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80915/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "abe01502-a8e9-532e-99d1-ac6d462ec225" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-80915/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "2459e0e0-6f11-590f-9fbb-bcb31ad40784" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-80915/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" :answer/id #uuid "b1e93ef0-99c8-57b5-ab92-0e800f72f829" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "q-80915/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "39b27585-57bc-5073-b959-116b10048a4a" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-80915/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "ab001922-1dd5-5363-9b1c-28e454d163c9" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-80915/selection" :answer-field/id #uuid "1a73b09b-57ca-506d-bd89-d5407de2d78d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80915/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer-field/choices ["q-80915/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-80915/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" "q-80915/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" "q-80915/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-80915/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-80915" :question/id #uuid "81977095-c899-5440-9ace-acb02a20d076" :question/math-academy-id "q-80915" :question/problem "Consider the system of linear differential equations given by\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-3 & 5 \\\\ 0 & -3\\end{aligned}]x(t).\n$$\n\nGiven that the solution to the system can be written as\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ a\\end{aligned}]{e}^{-3t}+{c}_{2}([\\begin{aligned}1 \\\\ a\\end{aligned}]t{e}^{-3t}+[\\begin{aligned}0 \\\\ b\\end{aligned}]{e}^{-3t}),\\,{c}_{1},{c}_{2}\\in R,\n$$\n\nwhat is the value of $a+b?$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-3 & 5 \\\\ 0 & -3\\end{aligned}].$\n\nSince $A$ is upper-triangular, the repeated eigenvalue is $\\lambda =-3$ (of multiplicity two).\nFor this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}0 & 5 \\\\ 0 & 0\\end{aligned}]∼[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution of the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-3+3 & 5 \\\\ 0 & -3+3\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}0 & 5 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}0{w}_{1}+5{w}_{2}=1 \\\\ 0{w}_{1}+0{w}_{2}=0\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n{w}_{2}=\\frac{1}{5}.\n$$\n\nThe variable ${w}_{1}$ is a free variable. Setting ${w}_{1}=0,$ we get \n\n$$\nw=[\\begin{aligned}0 \\\\ \\frac{1}{5}\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]t{e}^{-3t}+[\\begin{aligned}0 \\\\ \\frac{1}{5}\\end{aligned}]{e}^{-3t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFinally, we see that $a=0,b=\\frac{1}{5},$ and $a+b=\\frac{1}{5}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80915/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c19f9d9-fa4b-5261-b9a0-99a203aeac30"] :knowledge-point/questions ["q-80915"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-325120"] :question/problem "Consider the system of linear differential equations given by\n\n$$\n{x}^{′}(t)=[\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}]x(t).\n$$\n\nGiven that the solution to the system can be written as\n\n$$\nx(t)={c}_{1}[\\begin{aligned}a \\\\ 1\\end{aligned}]{e}^{2t}+{c}_{2}([\\begin{aligned}a \\\\ 1\\end{aligned}]t{e}^{2t}+[\\begin{aligned}b \\\\ 0\\end{aligned}]{e}^{2t}),\\,{c}_{1},{c}_{2}\\in R,\n$$\n\nwhat is the value of $a+b?$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}2 & 0 \\\\ 1 & 2\\end{aligned}].$\n\nSince $A$ is lower-triangular, the repeated eigenvalue is $\\lambda =2$ (of multiplicity two).\nFor this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution of the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}2-2 & 0 \\\\ 1 & 2-2\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}0{w}_{1}+0{w}_{2}=0 \\\\ 1{w}_{1}+0{w}_{2}=1\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n{w}_{1}=1.\n$$\n\nThe variable ${w}_{2}$ is a free variable. Setting ${w}_{2}=0,$ we get \n\n$$\nw=[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{2t}+{c}_{2}([\\begin{aligned}0 \\\\ 1\\end{aligned}]t{e}^{2t}+[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{2t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFinally, we see that $a=0,b=1,$ and $a+b=1.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-80603/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "301a2df2-9c2b-5931-a8b8-4c9ed8cfa30b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-80603/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "28705cca-ef75-51ce-869d-bb8857e86d81" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-80603/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0103f426-58bd-53b1-8f97-80038abf715f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-80603/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "00531d2c-3516-58b1-9ee5-e740fba747cf" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-80603/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3fc722e9-d6cf-508e-8b52-eab0ecfe90c0" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-80603/selection" :answer-field/id #uuid "5362545c-1654-545d-afac-90b1c01533e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80603/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-80603/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-80603/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-80603/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-80603/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-80603/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-80603" :question/id #uuid "a890d7a7-d6a7-598c-b8de-0c6c86cd59af" :question/math-academy-id "q-80603" :question/problem "Consider the system of linear differential equations given by\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-1 & -1 \\\\ 1 & -3\\end{aligned}]x(t).\n$$\n\nGiven that the solution to the system can be written as\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ a\\end{aligned}]{e}^{-2t}+{c}_{2}([\\begin{aligned}1 \\\\ a\\end{aligned}]t{e}^{-2t}+[\\begin{aligned}b \\\\ 0\\end{aligned}]{e}^{-2t}),\\,{c}_{1},{c}_{2}\\in R,\n$$\n\nwhat is the value of $a+b?$\n\n*Hint: The only eigenvalue of the system's matrix is $\\lambda =-2.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-1 & -1 \\\\ 1 & -3\\end{aligned}].$\n\nWe are given that the eigenvalue is $\\lambda =-2$ (of multiplicity two). For this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}1 & -1 \\\\ 1 & -1\\end{aligned}]∼[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution of the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}\\,),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-1+2 & -1 \\\\ 1 & -3+2\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}1 & -1 \\\\ 1 & -1\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}{w}_{1}-{w}_{2}=1 \\\\ {w}_{1}-{w}_{2}=1\\end{aligned}\n$$\n\nNote that the first equation is the same as the second. So, we obtain\n\n$$\n{w}_{1}={w}_{2}+1.\n$$\n\nThe variable ${w}_{2}$ is a free variable. Setting ${w}_{2}=0,$ we get ${w}_{1}=1,$ and therefore\n\n$$\nw=[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}([\\begin{aligned}1 \\\\ 1\\end{aligned}]t{e}^{-2t}+[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-2t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nFinally, we see that $a=1,b=1,$ and $a+b=2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80603/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c19f9d9-fa4b-5261-b9a0-99a203aeac30"] :knowledge-point/questions ["q-80603"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80927/selection/48d385b2a7621f2a9467d1492f9af1fe9209e002182c6866aa5036d5f29179b1" :answer/id #uuid "c5b590e2-00e2-58e0-918a-0094a50af2e4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1+t){e}^{-2t} \\\\ 2{e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80927/selection/3966821b6ac7fd96361528498d4d69797da619fee9c2fa6cda59efa4e8c3c791" :answer/id #uuid "5d02c77c-55c9-55aa-8dd2-06ac710b4330" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{-2t} \\\\ 2{e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80927/selection/d8e9d42c27f490b3950446ffe16267c39f7f75dc17f5bfd01ab1039108869539" :answer/id #uuid "cfd3cde3-91ee-5ee2-89e3-54f96363400d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{-2t} \\\\ (2+5t){e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80927/selection/3a0f5cab180975bf305a8962d681c0ed2d95ba6972e728e2b50214df61f14ecf" :answer/id #uuid "aa1f34d1-61b8-5852-bb1f-fe4a52271ae0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1+t){e}^{-2t} \\\\ (2+5t){e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80927/selection/99fc7a3c866053aeeef76e8723a4f45ee0f5eb9bd379ee5a95146cdd42784af3" :answer/id #uuid "73dbd3b8-e582-504f-94c3-613783472205" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1-t){e}^{-2t} \\\\ 2{e}^{-2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80927/selection" :answer-field/id #uuid "a946fe20-eb34-5f9d-a921-6e03a2e9b62a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80927/selection/d8e9d42c27f490b3950446ffe16267c39f7f75dc17f5bfd01ab1039108869539" :answer-field/choices ["q-80927/selection/48d385b2a7621f2a9467d1492f9af1fe9209e002182c6866aa5036d5f29179b1" "q-80927/selection/3966821b6ac7fd96361528498d4d69797da619fee9c2fa6cda59efa4e8c3c791" "q-80927/selection/d8e9d42c27f490b3950446ffe16267c39f7f75dc17f5bfd01ab1039108869539" "q-80927/selection/3a0f5cab180975bf305a8962d681c0ed2d95ba6972e728e2b50214df61f14ecf" "q-80927/selection/99fc7a3c866053aeeef76e8723a4f45ee0f5eb9bd379ee5a95146cdd42784af3"] :db/ensure [:answer-field/validate]} {:db/id "q-80927" :question/id #uuid "5838657b-dc89-531e-ae47-d32a758d2632" :question/math-academy-id "q-80927" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-2 & 0 \\\\ 5 & -2\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-2 & 0 \\\\ 5 & -2\\end{aligned}].$\n\nSince $A$ is upper-triangular, the repeated eigenvalue is $\\lambda =-2$ (of multiplicity two).\nFor this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}0 & 0 \\\\ 5 & 0\\end{aligned}]∼[\\begin{aligned}0 & 0 \\\\ 1 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}0 \\\\ 1\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution to the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-2+2 & 0 \\\\ 5 & -2+2\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}0 & 0 \\\\ 5 & 0\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}0{w}_{1}+0{w}_{2}=0 \\\\ 5{w}_{1}+0{w}_{2}=1\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n{w}_{1}=\\frac{1}{5}.\n$$\n\nThe variable ${w}_{2}$ is a free variable. Setting ${w}_{2}=0,$  we get\n\n$$\nw=[\\begin{aligned}\\frac{1}{5} \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}0 \\\\ 1\\end{aligned}]{e}^{-2t}+{c}_{2}([\\begin{aligned}0 \\\\ 1\\end{aligned}]t{e}^{-2t}+[\\begin{aligned}\\frac{1}{5} \\\\ 0\\end{aligned}]{e}^{-2t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & =[\\begin{aligned}\\frac{{c}_{2}}{5} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ 2\\end{aligned}] & =[\\begin{aligned}\\frac{{c}_{2}}{5} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}2 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}0 \\\\ 2\\end{aligned}]{e}^{-2t}+[\\begin{aligned}0 \\\\ 5\\end{aligned}]t{e}^{-2t}+[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-2t}. \\\\  & =[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-2t}+[\\begin{aligned}0 \\\\ 5\\end{aligned}]t{e}^{-2t} \\\\  & =[\\begin{aligned}{e}^{-2t} \\\\ (2+5t){e}^{-2t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80927/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "109cc543-253b-5f18-b13b-e54b99e8b12a"] :knowledge-point/questions ["q-80927"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80928/selection/4606950e7f92394bbd41de30a2663a1c82a448ca2665da4c476669ed8512b66e" :answer/id #uuid "59506bab-0a27-59c4-8f73-591c096a3f36" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{-t} \\\\ (1+15t){e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80928/selection/edcbebb92d0367d8376af1e4f9946cc4673c1eeeca5cb1c1bcc32e34ef7c1c79" :answer/id #uuid "fcb8af7d-013e-5804-a11b-663c2abe992b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1-2t){e}^{-t} \\\\ {e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80928/selection/9081c13ad7cd82e0973d3cd306b99854f12b4137f0b62bd1b6c452b01cf8f6f6" :answer/id #uuid "f3e3d8c5-e01f-5fdf-97b9-70fad47119e0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{-t} \\\\ {e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80928/selection/70c78d2b4ebde830359f370c5786e1f5504961dc4ed7a15a11c42ecbf565cbae" :answer/id #uuid "0a1fd842-1648-5066-856a-9582a7ab36b3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1-10t){e}^{-t} \\\\ (1+15t){e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80928/selection/6fce5e809d2d82d8411a5395e3fc7a1c60c8619e7c1f740976954a59c57455ca" :answer/id #uuid "37a0af68-6090-5ecb-a178-860e43900747" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1-2t){e}^{-t} \\\\ (1+3t){e}^{-t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80928/selection" :answer-field/id #uuid "e9b09de5-2286-53e7-9771-e6bd71e7f5ad" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80928/selection/70c78d2b4ebde830359f370c5786e1f5504961dc4ed7a15a11c42ecbf565cbae" :answer-field/choices ["q-80928/selection/4606950e7f92394bbd41de30a2663a1c82a448ca2665da4c476669ed8512b66e" "q-80928/selection/edcbebb92d0367d8376af1e4f9946cc4673c1eeeca5cb1c1bcc32e34ef7c1c79" "q-80928/selection/9081c13ad7cd82e0973d3cd306b99854f12b4137f0b62bd1b6c452b01cf8f6f6" "q-80928/selection/70c78d2b4ebde830359f370c5786e1f5504961dc4ed7a15a11c42ecbf565cbae" "q-80928/selection/6fce5e809d2d82d8411a5395e3fc7a1c60c8619e7c1f740976954a59c57455ca"] :db/ensure [:answer-field/validate]} {:db/id "q-80928" :question/id #uuid "6e25df6c-8786-547c-9562-9085a352e6d2" :question/math-academy-id "q-80928" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-7 & -4 \\\\ 9 & 5\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}1 \\\\ 1\\end{aligned}].\n$$\n\n*Hint: The only eigenvalue of the system's matrix is $\\lambda =-1.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-7 & -4 \\\\ 9 & 5\\end{aligned}].$\n\nWe are given that the eigenvalue is $\\lambda =-1$ (of multiplicity two). For this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}-6 & -4 \\\\ 9 & 6\\end{aligned}]∼[\\begin{aligned}3 & 2 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}-2 \\\\ 3\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution to the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-7+1 & -4 \\\\ 9 & 5+1\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}-6 & -4 \\\\ 9 & 6\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}-6{w}_{1}-4{w}_{2}=-2 \\\\ 9{w}_{1}+6{w}_{2}=3\\end{aligned}\n$$\n\nNote that the first equation is a constant multiple of the second. So, we obtain\n\n$$\n{w}_{1}=\\frac{1}{3}-\\frac{2}{3}{w}_{2}.\n$$\n\nThe variable ${w}_{2}$ is a free variable. Setting ${w}_{2}=0,$  we get ${w}_{1}=\\frac{1}{3},$ and therefore\n\n$$\nw=[\\begin{aligned}\\frac{1}{3} \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}-2 \\\\ 3\\end{aligned}]{e}^{-t}+{c}_{2}([\\begin{aligned}-2 \\\\ 3\\end{aligned}]t{e}^{-t}+[\\begin{aligned}\\frac{1}{3} \\\\ 0\\end{aligned}]{e}^{-t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & =[\\begin{aligned}-2{c}_{1}+\\frac{{c}_{2}}{3} \\\\ 3{c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ 1\\end{aligned}] & =[\\begin{aligned}-2{c}_{1}+\\frac{{c}_{2}}{3} \\\\ 3{c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}\\frac{1}{3} \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =\\frac{1}{3}[\\begin{aligned}-2 \\\\ 3\\end{aligned}]{e}^{-t}+5([\\begin{aligned}-2 \\\\ 3\\end{aligned}]t{e}^{-t}+[\\begin{aligned}\\frac{1}{3} \\\\ 0\\end{aligned}]{e}^{-t}) \\\\  & =[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+[\\begin{aligned}-10 \\\\ 15\\end{aligned}]t{e}^{-t} \\\\  & =[\\begin{aligned}(1-10t){e}^{-t} \\\\ (1+15t){e}^{-t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80928/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "109cc543-253b-5f18-b13b-e54b99e8b12a"] :knowledge-point/questions ["q-80928"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326238/selection/b154d4c7997be3e9f54bb2895450eefbf9d413827b9f928af7176da9bd5de319" :answer/id #uuid "b0a2e68c-e5d3-5cdc-ab13-cceb60956c82" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1-12t){e}^{-3t} \\\\ 2\\,{e}^{-3t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-326238/selection/b7b0732183eac03384b518d7e869bf5c89a7073c149dfb4eee984180e0d42f85" :answer/id #uuid "e330ff9b-0514-50dc-b0d3-ef44315232cb" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1-12t){e}^{-3t} \\\\ (2-12t){e}^{-3t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-326238/selection/03bf29a1c64824ab4095dff896b5c8af9e1281a005dcde367a2fb7d3ac1a9b3f" :answer/id #uuid "0cbfa898-030f-53c4-a770-0688e8877a65" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{-3t} \\\\ (2-12t){e}^{-3t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-326238/selection/5e0f79992c9f0363330521badeb7c30cd17a4b758efc12577145f04c8a4253d9" :answer/id #uuid "7a7e136f-f3b6-5428-9066-57e466c656d8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{-3t} \\\\ 2{e}^{-3t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-326238/selection/1a411c858ba8374c6f7a7d88b1ac9e6a1729171758b5b4f8adcee5a45b3e87bb" :answer/id #uuid "134b4c11-d326-522f-97ce-12148715b3b4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1+t){e}^{-3t} \\\\ (2-12t){e}^{-3t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-326238/selection" :answer-field/id #uuid "47271602-add0-5c44-b23d-e6f1a30f5d9e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-326238/selection/b154d4c7997be3e9f54bb2895450eefbf9d413827b9f928af7176da9bd5de319" :answer-field/choices ["q-326238/selection/b154d4c7997be3e9f54bb2895450eefbf9d413827b9f928af7176da9bd5de319" "q-326238/selection/b7b0732183eac03384b518d7e869bf5c89a7073c149dfb4eee984180e0d42f85" "q-326238/selection/03bf29a1c64824ab4095dff896b5c8af9e1281a005dcde367a2fb7d3ac1a9b3f" "q-326238/selection/5e0f79992c9f0363330521badeb7c30cd17a4b758efc12577145f04c8a4253d9" "q-326238/selection/1a411c858ba8374c6f7a7d88b1ac9e6a1729171758b5b4f8adcee5a45b3e87bb"] :db/ensure [:answer-field/validate]} {:db/id "q-326238" :question/id #uuid "fe888fa9-7251-5c8a-8852-7b62173b34d2" :question/math-academy-id "q-326238" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}-3 & -6 \\\\ 0 & -3\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}1 \\\\ 2\\end{aligned}].\n$$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}-3 & -6 \\\\ 0 & -3\\end{aligned}].$\n\nSince $A$ is upper-triangular, the repeated eigenvalue is $\\lambda =-3$ (of multiplicity two).\nFor this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}0 & -6 \\\\ 0 & 0\\end{aligned}]∼[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution to the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-3-(-3) & -6 \\\\ 0 & -3-(-3)\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}0 & -6 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}0{w}_{1}-6{w}_{2}=1 \\\\ 0{w}_{1}+0{w}_{2}=0\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n{w}_{2}=-\\frac{1}{6}.\n$$\n\nThe variable ${w}_{1}$ is a free variable. Setting ${w}_{1}=0,$  we get\n\n$$\nw=[\\begin{aligned}0 \\\\ -\\frac{1}{6}\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]t{e}^{-3t}+[\\begin{aligned}0 \\\\ -\\frac{1}{6}\\end{aligned}]{e}^{-3t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}1 \\\\ 2\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & =[\\begin{aligned}{c}_{1} \\\\ -\\frac{{c}_{2}}{6}\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ 2\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ -\\frac{{c}_{2}}{6}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ -12\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{-3t}+[\\begin{aligned}-12 \\\\ 0\\end{aligned}]t{e}^{-3t}+[\\begin{aligned}0 \\\\ 2\\end{aligned}]{e}^{-3t} \\\\  & =[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-3t}+[\\begin{aligned}-12 \\\\ 0\\end{aligned}]t{e}^{-3t} \\\\  & =[\\begin{aligned}(1-12t){e}^{-3t} \\\\ 2\\,{e}^{-3t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326238/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "109cc543-253b-5f18-b13b-e54b99e8b12a"] :knowledge-point/questions ["q-326238"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80932/selection/4dd00f0d1bd0685e658946059272a7ba228926b915e00b4e48fc8b38dfa1b715" :answer/id #uuid "57c196c2-cb78-57bf-a36b-425feafc3f0a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1+3t){e}^{7t} \\\\ -9t{e}^{7t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80932/selection/b47b554bd0388a718d678a4f05781cb2c203161ace2eec40d8291b6d4c2ed4e1" :answer/id #uuid "b129411a-ce21-5b50-911b-e734a9855459" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1+3t){e}^{7t} \\\\ -3t{e}^{7t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80932/selection/78a6b3a35e4d7bd858348ab2048bf1df4b94b152be32e1387e3d074c86339a47" :answer/id #uuid "71ad5a35-a67d-5696-a367-cd2054d6b9cc" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(1+3t){e}^{7t} \\\\ -t{e}^{7t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80932/selection/add92203b4fed48e8b4365be491201e544696e1693b58763a909280cdd6a7da4" :answer/id #uuid "1d3faae3-6f6a-50ce-8639-f65fcb12fd6b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{7t} \\\\ -3t{e}^{7t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80932/selection/fccd5a3c67192745169a09d4cb99c723e0de4392a4a884a4eb96e869dce42aac" :answer/id #uuid "e65acff9-5c57-57f1-8f63-35b401255e23" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{7t} \\\\ -9t{e}^{7t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80932/selection" :answer-field/id #uuid "bb09622f-d721-5933-9b4d-388a9d7b17b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80932/selection/4dd00f0d1bd0685e658946059272a7ba228926b915e00b4e48fc8b38dfa1b715" :answer-field/choices ["q-80932/selection/4dd00f0d1bd0685e658946059272a7ba228926b915e00b4e48fc8b38dfa1b715" "q-80932/selection/b47b554bd0388a718d678a4f05781cb2c203161ace2eec40d8291b6d4c2ed4e1" "q-80932/selection/78a6b3a35e4d7bd858348ab2048bf1df4b94b152be32e1387e3d074c86339a47" "q-80932/selection/add92203b4fed48e8b4365be491201e544696e1693b58763a909280cdd6a7da4" "q-80932/selection/fccd5a3c67192745169a09d4cb99c723e0de4392a4a884a4eb96e869dce42aac"] :db/ensure [:answer-field/validate]} {:db/id "q-80932" :question/id #uuid "238c50de-f678-5486-9e97-0de67f7c80f2" :question/math-academy-id "q-80932" :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}10 & 1 \\\\ -9 & 4\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$\n\n*Hint: The only eigenvalue of the system's matrix is $\\lambda =7.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}10 & 1 \\\\ -9 & 4\\end{aligned}].$\n\nWe are given that the eigenvalue is $\\lambda =7$ (of multiplicity two). For this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}3 & 1 \\\\ -9 & -3\\end{aligned}]∼[\\begin{aligned}3 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}-1 \\\\ 3\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution to the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}10-7 & 1 \\\\ -9 & 4-7\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 3\\end{aligned}] \\\\ [\\begin{aligned}3 & 1 \\\\ -9 & -3\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 3\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}3{w}_{1}+{w}_{2}=-1 \\\\ -9{w}_{1}-3{w}_{2}=3\\end{aligned}\n$$\n\nNote that the first equation is a constant multiple of the second. So, we obtain\n\n$$\n{w}_{1}=-\\frac{1}{3}-\\frac{{w}_{2}}{3}.\n$$\n\nThe variable ${w}_{2}$ is a free variable. Setting ${w}_{2}=0,$  we get ${w}_{1}=-\\frac{1}{3},$ and therefore\n\n$$\nw=[\\begin{aligned}-\\frac{1}{3} \\\\ 0\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}-1 \\\\ 3\\end{aligned}]{e}^{7t}+{c}_{2}([\\begin{aligned}-1 \\\\ 3\\end{aligned}]t{e}^{7t}+[\\begin{aligned}-\\frac{1}{3} \\\\ 0\\end{aligned}]{e}^{7t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & =[\\begin{aligned}-{c}_{1}-\\frac{{c}_{2}}{3} \\\\ 3{c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}-{c}_{1}-\\frac{{c}_{2}}{3} \\\\ 3{c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}0 \\\\ -3\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =-3[\\begin{aligned}-1 \\\\ 3\\end{aligned}]t{e}^{7t}-3[\\begin{aligned}-\\frac{1}{3} \\\\ 0\\end{aligned}]{e}^{7t} \\\\  & =[\\begin{aligned}(1+3t){e}^{7t} \\\\ -9t{e}^{7t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80932/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "109cc543-253b-5f18-b13b-e54b99e8b12a"] :knowledge-point/questions ["q-80932"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-325135"] :question/problem "Solve the initial value problem\n\n$$\n{x}^{′}(t)=[\\begin{aligned}4 & 2 \\\\ 0 & 4\\end{aligned}]x(t),\\,x(0)=[\\begin{aligned}2 \\\\ -1\\end{aligned}].\n$$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}4 & 2 \\\\ 0 & 4\\end{aligned}].$\n\nSince $A$ is upper-triangular, the repeated eigenvalue is $\\lambda =4$ (of multiplicity two).\nFor this eigenvalue, we get \n\n$$\nA-\\lambda I=[\\begin{aligned}0 & 2 \\\\ 0 & 0\\end{aligned}]∼[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n$v=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\nSince we have a repeated eigenvalue $\\lambda $ and only one linearly independent eigenvector $v$, the solution to the system of differential equations is given by\n\n$$\nx(t)={c}_{1}v{e}^{\\lambda t}+{c}_{2}(vt{e}^{\\lambda t}+w{e}^{\\lambda t}),\n$$\n\nwhere $w$ is a solution to the equation $(A-\\lambda I)w=v.$\n\nTo find $w,$ we solve the equation $(A-\\lambda I)w=v$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}4-4 & 2 \\\\ 0 & 4-4\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}0 & 2 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n\n$$\n{\\begin{aligned}0{w}_{1}+2{w}_{2}=1 \\\\ 0{w}_{1}+0{w}_{2}=0\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n{w}_{2}=\\frac{1}{2}.\n$$\n\nThe variable ${w}_{1}$ is a free variable. Setting ${w}_{1}=0,$  we get\n\n$$\nw=[\\begin{aligned}0 \\\\ \\frac{1}{2}\\end{aligned}].\n$$\n\nTherefore, the general solution is given by\n\n$$\nx(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{4t}+{c}_{2}([\\begin{aligned}1 \\\\ 0\\end{aligned}]t{e}^{4t}+[\\begin{aligned}0 \\\\ \\frac{1}{2}\\end{aligned}]{e}^{4t}),\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nNow, we need to find the values of ${c}_{1}$ and ${c}_{2}$ using the initial condition $x(0)=[\\begin{aligned}2 \\\\ -1\\end{aligned}].$ Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & =[\\begin{aligned}{c}_{1} \\\\ \\frac{{c}_{2}}{2}\\end{aligned}] \\\\ [\\begin{aligned}2 \\\\ -1\\end{aligned}] & =[\\begin{aligned}{c}_{1} \\\\ \\frac{{c}_{2}}{2}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}2 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}2 \\\\ -1\\end{aligned}]{e}^{4t}+[\\begin{aligned}-2 \\\\ 0\\end{aligned}]t{e}^{4t} \\\\  & =[\\begin{aligned}2(1-t){e}^{4t} \\\\ -{e}^{4t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7048"] :question/problem "Find the general solution to the matrix differential equation ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/31069ee6b2fce087880c8d94ec10bbb724e5f1d07be9adc6040c0a6b3aa2ff8a.png)" :question/worked-solution "Given a decoupled system of first-order linear ODEs in the form\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/8103dd1abfd1ba9488509a0e858113e05e877956d99e6b2d1eb1ac2bd6b85c7e.png)\nthe formula for the general solution is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/6425989fee48f2b78a4f2c8e1cbda9c0f64597600d2b0a054f9dea020d4e0f81.png)\n\nSince the matrix of our differential equation is diagonal, the system is decoupled. \n\nTherefore, the general solution is given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/c20e24c2457c66423fa2ff066a6d34dc1d5e2e044703236310f1a3f1aa48ce65.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7049"] :question/problem "Consider the system of linear differential equations given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/1ead7e2a9fff08d6ec1d8e70c3f9f0c10729a4899227c53eabe7a5212feb1659.png)\n\nGiven that the solution to the system can be written as\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/36b5e6757a7849e9e405883da345dadfbcc3130b517d05e117f4fb6fb4338ae8.png)\n\nwhat is the value of $a+b?$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/f9f940992f15a14e58f7eee0b8171e8e0e437787d6340618fcd1f23b84d333a8.png)\n\nSince $A$ is upper-triangular, the repeated eigenvalue is $\\lambda=-4$ (of multiplicity two).\nFor this eigenvalue, we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/9a7426e0e17bb57e1a8bfb24dca5ca3a579809708af3055184f9cfc2728957bc.png)\nSo, we get an eigenvector \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/f3e3bae74afa48fd689bb48dc317af52e44914f9f35d32375463d3705268b377.png)\n\nSince we have a repeated eigenvalue $\\lambda$ and only one linearly independent eigenvector $\\mathbf v,$ the solution of the system of differential equations is given by\n\n$$\n\\mathbf{x}(t) = c_1\\mathbf{v} e^{\\lambda t}  + c_2 (\\mathbf{v}  te^{\\lambda t}  +  \\mathbf{w}e^{\\lambda t} \\, ),\n$$\n\nwhere $\\mathbf{w}$ is a solution to the equation $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$\n\nTo find $\\mathbf{w},$ we solve the equation $(A - \\lambda I)\\mathbf{w} = \\mathbf{v}$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-4+4 & 1 \\\\ 0 & -4+4\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}] \\\\ [\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ 0\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/6e5c9442761d05d62ccc3ce56cbe09794e57b931987e3e4ef33d93d7cfb1e39f.png)\n\nSo, we obtain\n\n$$\nw_2 = 1.\n$$\n\nThe variable $w_1$ is a free variable. Setting $w_1 = 0,$ we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/6b54faff854b99c0c86b3de477cc2dde8b5a714bfc296c59ed6757f9bc250f77.png)\n\nTherefore, the general solution is given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/96ee1e3a1af5c670b87cd06e406ac16b0fa9f5e5305b2fe95dc395c079d291da.png)\n\nFinally, we see that $a=0, b=1,$ and $a+b=1.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7050"] :question/problem "Solve the initial value problem\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/9459f772e062490c525f6c7bc083c02d0ed5dc3bc4c331f642653aa4f9bf5515.png)\n*Hint: The only eigenvalue of the system's matrix is $\\lambda=3.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/df4b98b4799865dbf40e765bda0fa6176157139d99a62bd1febe48d7c4600c8c.png)\n\nWe are given that the eigenvalue is $\\lambda=3$ (of multiplicity two). For this eigenvalue, we get \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/8032d75d584838d0743f2e9217c25844af637d07261dd2d6a89add9df531fdb1.png)\nSo, we get an eigenvector \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/aa5146c331315952e36051be1126010bbcaf706f2cbc1c886c56b0e92b468fa4.png)\n\nSince we have a repeated eigenvalue $\\lambda$ and only one linearly independent eigenvector $\\mathbf v,$ the solution to the system of differential equations is given by\n\n$$\n\\mathbf{x}(t) = c_1  \\mathbf{v}e^{\\lambda t} + c_2 (\\mathbf{v}t e^{\\lambda t} +  \\mathbf{w}e^{\\lambda t}),\n$$\n\nwhere $\\mathbf{w}$ is a solution to the equation $(A - \\lambda I)\\mathbf{w}= \\mathbf{v}.$\n\nTo find $\\mathbf{w},$ we solve the equation $(A - \\lambda I)\\mathbf{w} = \\mathbf{v}$ as follows:\n\n$$\n\\begin{aligned}(A-\\lambda I)w & =v \\\\ [\\begin{aligned}-1-3 & -8 \\\\ 2 & 7-3\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}-4 & -8 \\\\ 2 & 4\\end{aligned}][\\begin{aligned}{w}_{1} \\\\ {w}_{2}\\end{aligned}] & =[\\begin{aligned}-2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nThe last equality allows us to form the following system of equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/b0d075668031a0decad6d092f2f03c3f74eacdcff0546e99e8373901c5a910ac.png)\n\nNote that the first equation is a constant multiple of the second. So, we obtain\n\n$$\nw_1 =\\dfrac{1}{2} - 2 w_2 .\n$$\n\nThe variable $w_2$ is a free variable. Setting $w_2 = 0,$  we get $w_1 = \\dfrac{1}{2},$ and therefore\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/726b5737809539337c1a8a259727a47b9bdacdf81de92a4a35783518df9dcaa0.png)\n\nTherefore, the general solution is given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/a1a3e46d8352ceee549fb5040261d8edf036d8fb32fc5fc5b960cab07097970f.png)\n\nNow, we need to find the values of $c_1$ and $c_2$ using the initial condition ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14067736/assets/2e3a20e62437546fb2498d1575c9ed2cd268c43b968174ea7e0139977fb6fbd5.png) Substituting $t=0$ into the general solution gives\n\n$$\n\\begin{aligned}\\text{x}(0) & =[\\begin{aligned}-2{c}_{1}+\\frac{1}{2}{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}-3 \\\\ 1\\end{aligned}] & =[\\begin{aligned}-2{c}_{1}+\\frac{1}{2}{c}_{2} \\\\ {c}_{1}\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1} \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}1 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =[\\begin{aligned}-2 \\\\ 1\\end{aligned}]{e}^{3t}-2([\\begin{aligned}-2 \\\\ 1\\end{aligned}]t{e}^{3t}+[\\begin{aligned}\\frac{1}{2} \\\\ 0\\end{aligned}]{e}^{3t}) \\\\  & =[\\begin{aligned}-3 \\\\ 1\\end{aligned}]{e}^{3t}+[\\begin{aligned}4 \\\\ -2\\end{aligned}]t{e}^{3t} \\\\  & =[\\begin{aligned}(4t-3){e}^{3t} \\\\ (1-2t){e}^{3t}\\end{aligned}].\\end{aligned}\n$$" :db/ensure [:question/validate]}]
