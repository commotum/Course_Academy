          "value": [
            ":answer.type/math",
            "{y}_{\\text{new}}=\\frac{{e}^{x}+{e}^{{x}_{\\text{new}}}-3xy+2y}{2+3{x}_{\\text{new}}}"
          ],
          "category": "reviewed_ma_solution",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14047192/answer-source-reviews.json",
