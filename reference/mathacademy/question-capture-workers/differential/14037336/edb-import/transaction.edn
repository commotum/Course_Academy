[{:db/id "q-50566/selection/5fc20efea3ef3ca585b31a98a909cfe55d0d47050c083b1b3f6a699bb77b4d09" :answer/id #uuid "da9e9b0c-b4cd-5345-b2e9-dce18a822acf" :answer/type :answer.type/math :answer/value "-y=\\sqrt{x+4}" :db/ensure [:answer/validate]} {:db/id "q-50566/selection/f322a59a048363a1ba6f4bf9d4a3b0fc8ad12655d4c4f6d32851eef37b981d25" :answer/id #uuid "ccc6e12d-cbc7-5f30-9434-b017a69c5a0b" :answer/type :answer.type/math :answer/value "y=\\sqrt{{x}^{2}-8}" :db/ensure [:answer/validate]} {:db/id "q-50566/selection/051828a987f4fe9cc2e8824e8ff70146e30bb239d33df135110810bca1c22574" :answer/id #uuid "5004f8ab-bcfd-5b95-9df0-163643659ee8" :answer/type :answer.type/math :answer/value "y=\\frac{1}{4}\\sqrt{2{x}^{2}-2}" :db/ensure [:answer/validate]} {:db/id "q-50566/selection/5538240dc827801968325f5068f15e2866eb3a2b4106087c3bc4a85051cd232c" :answer/id #uuid "6469cc98-0d3e-505a-a4bd-ad22baaed83a" :answer/type :answer.type/math :answer/value "y=\\sqrt{2{x}^{2}-4}" :db/ensure [:answer/validate]} {:db/id "q-50566/selection/8869472ebd59bff9998da0c2d960b0356196e4718b63281da20b5e3927c262eb" :answer/id #uuid "0938ef89-ec65-56dd-9c08-fbac94ee08a8" :answer/type :answer.type/math :answer/value "-y=\\sqrt{2x+7}" :db/ensure [:answer/validate]} {:db/id "q-50566/selection" :answer-field/id #uuid "cc0999a9-e763-5a12-a30b-184d1afbb9ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-50566/selection/f322a59a048363a1ba6f4bf9d4a3b0fc8ad12655d4c4f6d32851eef37b981d25" :answer-field/choices ["q-50566/selection/5fc20efea3ef3ca585b31a98a909cfe55d0d47050c083b1b3f6a699bb77b4d09" "q-50566/selection/f322a59a048363a1ba6f4bf9d4a3b0fc8ad12655d4c4f6d32851eef37b981d25" "q-50566/selection/051828a987f4fe9cc2e8824e8ff70146e30bb239d33df135110810bca1c22574" "q-50566/selection/5538240dc827801968325f5068f15e2866eb3a2b4106087c3bc4a85051cd232c" "q-50566/selection/8869472ebd59bff9998da0c2d960b0356196e4718b63281da20b5e3927c262eb"] :db/ensure [:answer-field/validate]} {:db/id "q-50566" :question/id #uuid "2bedb039-83dc-5e1b-b856-f023ba4d6c27" :question/math-academy-id "q-50566" :question/problem "Find the particular solution to the differential equation $y\\frac{\\text{d}y}{\\text{d}x}=x$  that satisfies  $y(-3)=1.$  Assume that $y>0.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}y\\frac{\\text{d}y}{\\text{d}x} & =x \\\\ \\int y\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\int y\\text{d}y & =\\int x\\text{d}x \\\\ \\frac{{y}^{2}}{2} & =\\frac{{x}^{2}}{2}+{C}_{1} \\\\ {y}^{2} & ={x}^{2}+2{C}_{1} \\\\ y & =\\pm \\sqrt{{x}^{2}+2{C}_{1}}\\end{aligned}\n$$\n\nAssuming $y>0,$ the general solution is\n\n$$\ny=\\sqrt{{x}^{2}+C},\n$$\n\nwhere $C$ is an arbitrary constant.\n\nWe now apply the condition $y(-3)=1$ to find $C:$\n\n$$\n\\begin{aligned}1 & =\\sqrt{(-3)^{2}+C} \\\\ 1 & =\\sqrt{9+C} \\\\ C & =-8\\end{aligned}\n$$\n\nThus, the particular solution of $y\\frac{\\text{d}y}{\\text{d}x}=x$ that satisfies the condition $y(-3)=1$ is\n\n$$\ny=\\sqrt{{x}^{2}-8}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-50566/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99112850-043d-53e5-8d61-fecb0317bd11"] :knowledge-point/questions ["q-50566"] :db/ensure [:knowledge-point/validate]} {:db/id "q-14313/selection/5a395df4b1c7ff028a15e0d759bb6b128e4493b4eb8a937eee65868339f7b8ed" :answer/id #uuid "62ebf476-68aa-5bd7-bff4-c6c6a4b750c3" :answer/type :answer.type/math :answer/value "{y}^{3}=5{x}^{3}+3" :db/ensure [:answer/validate]} {:db/id "q-14313/selection/4bad4a0e2fcb0fec1b7366a77edbb9a3155ca1b53e688cce1b518d81197cd13f" :answer/id #uuid "d573eb2d-82ab-5413-8bcb-b9b2336a830d" :answer/type :answer.type/math :answer/value "{y}^{3}={x}^{3}+7" :db/ensure [:answer/validate]} {:db/id "q-14313/selection/6c10f23894ae9ed03ac398dafa500bdea821d1b6a9699595e4cf99e5ce5e95e6" :answer/id #uuid "3ef8da88-22a3-5a8a-8a1d-60b6223fcbb8" :answer/type :answer.type/math :answer/value "{y}^{3}={x}^{2}+3" :db/ensure [:answer/validate]} {:db/id "q-14313/selection/5e095752b31fb47ddaffe0eddbc7d5d5d5800a2e3488f6feaa2dc3dde45dd2aa" :answer/id #uuid "98f15021-418c-5d7a-81fc-5a641671a6c9" :answer/type :answer.type/math :answer/value "{y}^{3}=2{x}^{3}+2" :db/ensure [:answer/validate]} {:db/id "q-14313/selection/b8080b84341a71b2a897d41d939be05012cabed5489b0b69539b908b6062c211" :answer/id #uuid "f0f49ccd-93ef-5294-bc32-626551ecf864" :answer/type :answer.type/math :answer/value "{y}^{3}=3{x}^{2}+5" :db/ensure [:answer/validate]} {:db/id "q-14313/selection" :answer-field/id #uuid "1e931c97-953c-5bd7-9dfc-1e428ad98edf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-14313/selection/4bad4a0e2fcb0fec1b7366a77edbb9a3155ca1b53e688cce1b518d81197cd13f" :answer-field/choices ["q-14313/selection/5a395df4b1c7ff028a15e0d759bb6b128e4493b4eb8a937eee65868339f7b8ed" "q-14313/selection/4bad4a0e2fcb0fec1b7366a77edbb9a3155ca1b53e688cce1b518d81197cd13f" "q-14313/selection/6c10f23894ae9ed03ac398dafa500bdea821d1b6a9699595e4cf99e5ce5e95e6" "q-14313/selection/5e095752b31fb47ddaffe0eddbc7d5d5d5800a2e3488f6feaa2dc3dde45dd2aa" "q-14313/selection/b8080b84341a71b2a897d41d939be05012cabed5489b0b69539b908b6062c211"] :db/ensure [:answer-field/validate]} {:db/id "q-14313" :question/id #uuid "a5938f28-6b10-54af-bd46-b5bd83651a7a" :question/math-academy-id "q-14313" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{{x}^{2}}{{y}^{2}}$  that satisfies $y(1)=2.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{x}^{2}}{{y}^{2}} \\\\ {y}^{2}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{2} \\\\ \\int {y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int {y}^{2}\\,\\text{d}y & =\\int {x}^{2}\\,\\text{d}x \\\\ \\frac{{y}^{3}}{3} & =\\frac{{x}^{3}}{3}+{C}_{1} \\\\ {y}^{3} & ={x}^{3}+C,\\end{aligned}\n$$\n\nwhere   $C=3{C}_{1}$ is an arbitrary constant.  \n\nWe now apply the condition $y(1)=2$ to find $C:$\n\n$$\n\\begin{aligned}{2}^{3} & ={1}^{3}+C \\\\ 8-1 & =C \\\\ C & =7\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n{y}^{3}={x}^{3}+7.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-14313/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99112850-043d-53e5-8d61-fecb0317bd11"] :knowledge-point/questions ["q-14313"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8308/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" :answer/id #uuid "99498ada-4103-5335-a8b5-12a34cfd23a8" :answer/type :answer.type/math :answer/value "y=1" :db/ensure [:answer/validate]} {:db/id "q-8308/selection/ecbc8b3da331617c70e912efc3a9fa9cb2b6e95c578a1fd786b7b7abfc19ba59" :answer/id #uuid "614d8a46-8296-5657-af99-99d91e61bc9a" :answer/type :answer.type/math :answer/value "y={e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-8308/selection/b39ff14733880c6e3df4c850e40b42a0321ffb7a172638c7181b47da2ea7a174" :answer/id #uuid "2130de2e-cc23-57a6-8e34-fa5e0fec0fe4" :answer/type :answer.type/math :answer/value "y={e}^{\\operatorname{sin}⁡x}" :db/ensure [:answer/validate]} {:db/id "q-8308/selection/dd79d3e7fd3c4adb06ced5a0e468bd5cd474a3acf088bc484cac3c775d54258d" :answer/id #uuid "701fb091-d6ed-52b2-9dbc-34a7d8122808" :answer/type :answer.type/math :answer/value "y={e}^{x}" :db/ensure [:answer/validate]} {:db/id "q-8308/selection/a4eae6a017f6ad75a7e05ebbb5d62ce35ba96b0e30fe149317e3994f322e37b1" :answer/id #uuid "ee7b41c4-6d99-5e49-9242-d1e09126a719" :answer/type :answer.type/math :answer/value "y=x+1" :db/ensure [:answer/validate]} {:db/id "q-8308/selection" :answer-field/id #uuid "d32f41e7-63e4-5787-8002-217ab0c5c16d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8308/selection/dd79d3e7fd3c4adb06ced5a0e468bd5cd474a3acf088bc484cac3c775d54258d" :answer-field/choices ["q-8308/selection/f7031104f14fe004994e4fe4b8af3fbe4e65cfa2bff3c7eab1748f5f2092c758" "q-8308/selection/ecbc8b3da331617c70e912efc3a9fa9cb2b6e95c578a1fd786b7b7abfc19ba59" "q-8308/selection/b39ff14733880c6e3df4c850e40b42a0321ffb7a172638c7181b47da2ea7a174" "q-8308/selection/dd79d3e7fd3c4adb06ced5a0e468bd5cd474a3acf088bc484cac3c775d54258d" "q-8308/selection/a4eae6a017f6ad75a7e05ebbb5d62ce35ba96b0e30fe149317e3994f322e37b1"] :db/ensure [:answer-field/validate]} {:db/id "q-8308" :question/id #uuid "1eaf4214-5b2e-5a79-b5f4-dc081a8c4d8e" :question/math-academy-id "q-8308" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=y$  that satisfies $y(0)=1.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =y \\\\ \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x} & =1 \\\\ \\int \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =x+C\\,.\\end{aligned}\n$$\n\nApplying the exponential function to both sides, we find the general solution:\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{x+C} \\\\ |y| & ={e}^{x+C}\\, \\\\ y & =\\pm {e}^{x+C} \\\\ y & =K{e}^{x}\\,.\\end{aligned}\n$$\n\nwhere $K=\\pm {e}^{C}$ is an arbitrary constant. \n\nWe now apply the condition $y(0)=1$ to find $K:$ \n\n$$\n\\begin{aligned}1 & =K{e}^{0} \\\\ K & =1\\end{aligned}\n$$\n\nThus, the particular solution of $\\frac{\\text{d}y}{\\text{d}x}=y$ that satisfies the condition $y(0)=1$ is\n\n$$\ny={e}^{x}\\,.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-8308/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99112850-043d-53e5-8d61-fecb0317bd11"] :knowledge-point/questions ["q-8308"] :db/ensure [:knowledge-point/validate]} {:db/id "q-355579/field-1/a535c1564cdc1f37b4ddf67a465c7d168fc09618d97249d181fee087ea69aa25" :answer/id #uuid "2e81344c-5810-55eb-b37a-cd7e5b7b78d5" :answer/type :answer.type/math :answer/value "e^{2\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-355579/field-1/100c898434d6cced250ce46968f38fbf71bf575b2f464cc6fbf185b9c50a46e2" :answer/id #uuid "3b309eca-74f7-5b49-bd78-db38996b5ee2" :answer/type :answer.type/math :answer/value "e^{\\sqrt{x}}" :db/ensure [:answer/validate]} {:db/id "q-355579/field-1" :answer-field/id #uuid "d4d5d54c-ef9d-5325-a682-474a74c91206" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-355579/field-1/a535c1564cdc1f37b4ddf67a465c7d168fc09618d97249d181fee087ea69aa25" :answer-field/choices ["q-355579/field-1/a535c1564cdc1f37b4ddf67a465c7d168fc09618d97249d181fee087ea69aa25" "q-355579/field-1/100c898434d6cced250ce46968f38fbf71bf575b2f464cc6fbf185b9c50a46e2"] :db/ensure [:answer-field/validate]} {:db/id "q-355579" :question/id #uuid "d3a0c150-d1a0-56a4-b28e-6e1eb94bcefb" :question/math-academy-id "q-355579" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{\\sqrt{x}}$  that satisfies $y(1)={e}^{2}.$\n\n$y=$\n{{field-1}}" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{y}{\\sqrt{x}} \\\\ \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{\\sqrt{x}} \\\\ \\int \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\,\\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =2\\sqrt{x}+C\\,.\\end{aligned}\n$$\n\nApplying the exponential function to both sides, we find the general solution:\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{2\\sqrt{x}+C} \\\\ |y| & ={e}^{2\\sqrt{x}+C}\\, \\\\ |y| & ={e}^{2\\sqrt{x}}\\cdot {e}^{C} \\\\ y & =K{e}^{2\\sqrt{x}}\\,.\\end{aligned}\n$$\n\nwhere $K=\\pm {e}^{C}$ is an arbitrary constant. \n\nWe now apply the condition $y(1)={e}^{2}$ to find $K:$ \n\n$$\n\\begin{aligned}{e}^{2} & =K{e}^{2\\sqrt{1}} \\\\ {e}^{2} & =K{e}^{2} \\\\ K & =1\\end{aligned}\n$$\n\nThus, the particular solution of $\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{\\sqrt{x}}$ that satisfies the condition $y(1)={e}^{2}$ is\n\n$$\ny={e}^{2\\sqrt{x}}\\,.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-355579/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "99112850-043d-53e5-8d61-fecb0317bd11"] :knowledge-point/questions ["q-355579"] :db/ensure [:knowledge-point/validate]} {:db/id "q-355582/field-1/ab35494c8cb0b1f4082361a0f7ef2da6e59587aa12620ea790e271e531fd26f7" :answer/id #uuid "75d13c89-12e5-5819-b190-541428dbca14" :answer/type :answer.type/math :answer/value "\\ln(2-e^{-x})" :db/ensure [:answer/validate]} {:db/id "q-355582/field-1/b48cf00a57ba37b1b4328596a4a1268c8cbe720f12b0127a2b0cff3300be2731" :answer/id #uuid "32a1d111-a5d3-52c3-9b17-a247a2636772" :answer/type :answer.type/math :answer/value "\\ln(2+e^{-x})" :db/ensure [:answer/validate]} {:db/id "q-355582/field-1" :answer-field/id #uuid "800aa3ce-4273-5f23-8ff3-c955acf012d6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-355582/field-1/ab35494c8cb0b1f4082361a0f7ef2da6e59587aa12620ea790e271e531fd26f7" :answer-field/choices ["q-355582/field-1/ab35494c8cb0b1f4082361a0f7ef2da6e59587aa12620ea790e271e531fd26f7" "q-355582/field-1/b48cf00a57ba37b1b4328596a4a1268c8cbe720f12b0127a2b0cff3300be2731"] :db/ensure [:answer-field/validate]} {:db/id "q-355582" :question/id #uuid "fe04fef3-6150-519b-9e35-cabeb0ad595f" :question/math-academy-id "q-355582" :question/problem "Find the specific solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{-x-y}$ given that  $\\,y(0)=0.$\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{-x-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={e}^{-x}{e}^{-y} \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{-x} \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{-x}\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int {e}^{-x}\\,\\text{d}x \\\\ {e}^{y} & =-{e}^{-x}+C\\end{aligned}\n$$\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{y}) & =\\operatorname{ln}⁡(-{e}^{-x}+C) \\\\ y & =\\operatorname{ln}⁡(-{e}^{-x}+C).\\end{aligned}\n$$\n\nWe now apply the condition $y(0)=0$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =0 \\\\ \\operatorname{ln}⁡(-{e}^{0}+C) & =0 \\\\ \\operatorname{ln}⁡(C-1) & =0 \\\\ C-1 & =1 \\\\ C & =2\\end{aligned}\n$$\n\nThus the particular solution of $\\frac{\\text{d}y}{\\text{d}x}={e}^{-x-y}$ that satisfies the condition $y(0)=0$ is\n\n$$\ny=\\operatorname{ln}⁡(2-{e}^{-x}).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-355582/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473"] :knowledge-point/questions ["q-355582"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79371/selection/dd1e0310bc0ab285c8f0009a9676187deb5ab6e51ebb7a8a7b73cea6de91377a" :answer/id #uuid "e083fe15-44ca-5ac8-bc24-f2c898194dce" :answer/type :answer.type/math :answer/value "y=-2{e}^{-x}-1" :db/ensure [:answer/validate]} {:db/id "q-79371/selection/3bf027d0f3f2184b195697b91b24653ccc1df8d1a3b13aac0c2bf7d6c5fe014b" :answer/id #uuid "e7a3bc39-a922-5f64-bfd1-2a19006f0aab" :answer/type :answer.type/math :answer/value "y=4x+{e}^{-3x}-4" :db/ensure [:answer/validate]} {:db/id "q-79371/selection/f28e33d8587939fbb76766494b9b783ae70dcded3aded8c17179450e9eae912e" :answer/id #uuid "db8ab467-ee18-56ba-90df-79102eaa92a9" :answer/type :answer.type/math :answer/value "y={x}^{2}-3{e}^{-x}+2" :db/ensure [:answer/validate]} {:db/id "q-79371/selection/3e0d59e8ce157c7788f4de72017ec48c8a38a7e9b97e2dcc4f3f25046131c22a" :answer/id #uuid "9873e707-2fd2-5249-a343-87db775dbe1e" :answer/type :answer.type/math :answer/value "y={x}^{2}-3{e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-79371/selection/a957cdaea448a49bfe7d4dc7fa2d4398fa3525a7283ec738c4f7fba250e97ba7" :answer/id #uuid "96361bee-48b6-5d73-b545-1b1ca709bc20" :answer/type :answer.type/math :answer/value "y=x+{e}^{-3x}-4" :db/ensure [:answer/validate]} {:db/id "q-79371/selection" :answer-field/id #uuid "6a28f488-2cc3-5e9b-baa4-b221f207a20a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79371/selection/3e0d59e8ce157c7788f4de72017ec48c8a38a7e9b97e2dcc4f3f25046131c22a" :answer-field/choices ["q-79371/selection/dd1e0310bc0ab285c8f0009a9676187deb5ab6e51ebb7a8a7b73cea6de91377a" "q-79371/selection/3bf027d0f3f2184b195697b91b24653ccc1df8d1a3b13aac0c2bf7d6c5fe014b" "q-79371/selection/f28e33d8587939fbb76766494b9b783ae70dcded3aded8c17179450e9eae912e" "q-79371/selection/3e0d59e8ce157c7788f4de72017ec48c8a38a7e9b97e2dcc4f3f25046131c22a" "q-79371/selection/a957cdaea448a49bfe7d4dc7fa2d4398fa3525a7283ec738c4f7fba250e97ba7"] :db/ensure [:answer-field/validate]} {:db/id "q-79371" :question/id #uuid "b83618f6-c01a-5048-a3a3-6b622350db67" :question/math-academy-id "q-79371" :question/problem "Find the particular solution to the differential equation ${e}^{x}\\frac{\\text{d}y}{\\text{d}x}-2x{e}^{x}=3$ that satisfies $y(0)=-3.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}{e}^{x}\\frac{\\text{d}y}{\\text{d}x}-2x{e}^{x} & =3 \\\\ {e}^{x}\\frac{\\text{d}y}{\\text{d}x} & =3+2x{e}^{x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =3{e}^{-x}+2x \\\\ \\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (3{e}^{-x}+2x)\\,\\text{d}x \\\\ \\int \\,\\text{d}y & =\\int 3{e}^{-x}\\,\\text{d}x+\\int 2x\\,\\text{d}x \\\\ y & =-3{e}^{-x}+{x}^{2}+C.\\end{aligned}\n$$\n\nWe now apply the initial condition $y(0)=-3$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =-3 \\\\ -3{e}^{-0}+{0}^{2}+C & =-3 \\\\ C-3 & =-3 \\\\ C & =0\\,.\\end{aligned}\n$$\n\nThus the particular solution of ${e}^{x}\\frac{\\text{d}y}{\\text{d}x}-2x{e}^{x}=3$ that satisfies the condition $y(0)=-3$ is\n\n$$\ny={x}^{2}-3{e}^{-x}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79371/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473"] :knowledge-point/questions ["q-79371"] :db/ensure [:knowledge-point/validate]} {:db/id "q-355564/field-1/b7175cded51b4d071f133bede981b92f85dc84714d395a977b95568a979a485b" :answer/id #uuid "36f8ef4a-d466-5e27-9632-1ba0c811f4ad" :answer/type :answer.type/math :answer/value "(2x-1)e^{2x}" :db/ensure [:answer/validate]} {:db/id "q-355564/field-1/617790b0b19efbb6535d6b0a93a447fb8b0084bf410f30c8d76a970176123315" :answer/id #uuid "e20c6bba-6022-5997-aa9a-58790672ebd6" :answer/type :answer.type/math :answer/value "(2x+1)e^{2x}" :db/ensure [:answer/validate]} {:db/id "q-355564/field-1" :answer-field/id #uuid "96e36a3b-29b9-5717-92d3-0819ec1a5c2c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-355564/field-1/b7175cded51b4d071f133bede981b92f85dc84714d395a977b95568a979a485b" :answer-field/choices ["q-355564/field-1/b7175cded51b4d071f133bede981b92f85dc84714d395a977b95568a979a485b" "q-355564/field-1/617790b0b19efbb6535d6b0a93a447fb8b0084bf410f30c8d76a970176123315"] :db/ensure [:answer-field/validate]} {:db/id "q-355564" :question/id #uuid "0a0c1a6f-49f7-5e1b-8197-0268b6fe21e5" :question/math-academy-id "q-355564" :question/problem "Find the particular solution to the differential equation $(-\\frac{1}{xy}+\\frac{2}{y})\\frac{\\text{d}y}{\\text{d}x}=4$ that satisfies $y(1)={e}^{2}.$\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}(-\\frac{1}{xy}+\\frac{2}{y})\\frac{\\text{d}y}{\\text{d}x} & =4 \\\\ \\frac{2x-1}{xy}\\frac{\\text{d}y}{\\text{d}x} & =4 \\\\ \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{4x}{2x-1} \\\\ \\frac{1}{y}\\frac{\\text{d}y}{\\text{d}x} & =2+\\frac{2}{2x-1} \\\\ \\frac{1}{y}\\,\\text{d}y & =(2+\\frac{2}{2x-1})\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int (2+\\frac{2}{2x-1})\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =2x+\\operatorname{ln}⁡|2x-1|+C.\\end{aligned}\n$$\n\nApplying the exponential function to both sides, we find the general solution:\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{2x+\\operatorname{ln}⁡|2x-1|+C} \\\\ |y| & ={e}^{2x+\\operatorname{ln}⁡|2x-1|+C} \\\\ |y| & ={e}^{2x}\\cdot {e}^{\\operatorname{ln}⁡|2x-1|}\\cdot {e}^{C} \\\\ y & =K(2x-1){e}^{2x},\\end{aligned}\n$$\n\nwhere $K=\\pm {e}^{C}$ is an arbitrary constant. \n\nWe now apply the initial condition $y(1)={e}^{2}$ to find $K:$\n\n$$\n\\begin{aligned}y(1) & ={e}^{2} \\\\ K(2(1)-1){e}^{2(1)} & ={e}^{2} \\\\ K{e}^{2} & ={e}^{2} \\\\ K & =1\\end{aligned}\n$$\n\nThus, the particular solution is\n\n$$\ny(x)=(2x-1){e}^{2x}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-355564/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473"] :knowledge-point/questions ["q-355564"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350957/field-1/f2963aeaf80148bf42d8c6dfd9dd3d415a8af752fabbea040225783fcd02149b" :answer/id #uuid "38cd088b-8c79-5386-a1ca-0b764fdb511c" :answer/type :answer.type/math :answer/value "\\ln(2x^3-x)" :db/ensure [:answer/validate]} {:db/id "q-350957/field-1" :answer-field/id #uuid "375c5fbb-2e58-5428-aa32-345b96779d2a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350957/field-1/f2963aeaf80148bf42d8c6dfd9dd3d415a8af752fabbea040225783fcd02149b" :answer-field/choices ["q-350957/field-1/f2963aeaf80148bf42d8c6dfd9dd3d415a8af752fabbea040225783fcd02149b"] :db/ensure [:answer-field/validate]} {:db/id "q-350957" :question/id #uuid "66d0e457-c6f5-5966-8c94-b8d2ddac2421" :question/math-academy-id "q-350957" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}+{e}^{-y}=6{x}^{2}{e}^{-y}$ that satisfies $y(1)=0.$\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x}+{e}^{-y} & =6{x}^{2}{e}^{-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =6{x}^{2}{e}^{-y}-{e}^{-y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =(6{x}^{2}-1){e}^{-y} \\\\ {e}^{y}\\,\\text{d}y & =(6{x}^{2}-1)\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int (6{x}^{2}-1)\\,\\text{d}x \\\\ {e}^{y} & =2{x}^{3}-x+C.\\end{aligned}\n$$\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{y}) & =\\operatorname{ln}⁡(2{x}^{3}-x+C) \\\\ y & =\\operatorname{ln}⁡(2{x}^{3}-x+C)\\end{aligned}\n$$\n\nWe now apply the initial condition $y(1)=0$ to find $C:$\n\n$$\n\\begin{aligned}y(1) & =0 \\\\ \\operatorname{ln}⁡(2\\cdot {1}^{3}-1+C) & =0 \\\\ \\operatorname{ln}⁡(1+C) & =0 \\\\ C & =0\\end{aligned}\n$$\n\nThus, the particular solution is\n\n$$\ny(x)=\\operatorname{ln}⁡(2{x}^{3}-x).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350957/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473"] :knowledge-point/questions ["q-350957"] :db/ensure [:knowledge-point/validate]}]
