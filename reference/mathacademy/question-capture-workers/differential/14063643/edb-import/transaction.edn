6x}$ is not a solution." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-90729/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fcb5d818-acb0-53c7-90f9-328256600175"] :knowledge-point/questions ["q-90729"] :db/ensure [:knowledge-point/validate]} {:db/id "q-90727/selection/3e0bf27fb6a9e9c1895d147e7579755fc4493f1191b81ab91c0a1fc0ab334b35" :answer/id #uuid "b3b7e803-9822-5f3b-af3a-8eca526b74f6" :answer/type :answer.type/math :answer/value "{e}^{2(x+4)}" :db/ensure [:answer/validate]} {:db/id "q-90727/selection/7326dffd3c755beb2cb424d4f6bd710040b23e10af90bca42b3c9230350d0282" :answer/id #uuid "b6d2bc3e-256c-5a5d-93f7-35cc666ec4b2" :answer/type :answer.type/math :answer/value "2{e}^{x}" :db/ensure [:answer/validate]} {:db/id "q-90727/selection/b374c92c1ba311f5934f743b571f7ef597e0a214795a69e86a0989ebcc39fb61" :answer/id #uuid "6861242e-8eff-5799-94f3-5b06b6e2fe18" :answer/type :answer.type/math :answer/value "3{e}^{2x}+{e}^{3x}" :db/ensure [:answer/validate]} {:db/id "q-90727/selection/0a2c0cc4baabc8c6275e00db63804f01dd6beb152d6635a486cb9570be51f9bd" :answer/id #uuid "43dbbbd4-2141-5bcc-ba7e-677be6a66521" :answer/type :answer.type/math :answer/value "6{e}^{2x}-2{e}^{3x}" :db/ensure [:answer/validate]} {:db/id "q-90727/selection/74521c50c65fc6a52056746481c6d39edacf577250ffbffd7ae5248b235295c6" :answer/id #uuid "bf2a3de0-4dbb-50e2-b9c0-8724058a496c" :answer/type :answer.type/math :answer/value "{e}^{3x}" :db/ensure [:answer/validate]} {:db/id "q-90727/selection" :answer-field/id #uuid "bfca3dd7-0a4e-541c-b655-a029f427f169" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-90727/selection/7326dffd3c755beb2cb424d4f6bd710040b23e10af90bca42b3c9230350d0282" :answer-field/choices ["q-90727/selection/3e0bf27fb6a9e9c1895d147e7579755fc4493f1191b81ab91c0a1fc0ab334b35" "q-90727/selection/7326dffd3c755beb2cb424d4f6bd710040b23e10af90bca42b3c9230350d0282" "q-90727/selection/b374c92