uxiliary equation results in\n\n$$\n(\\lambda +4)(\\lambda -6)=0,\n$$\n\nand so the solutions of the auxiliary equation  are $\\lambda =-4$ or $\\lambda =6.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-90705/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4bcb5277-6d80-5cea-9688-ddb98f434093"] :knowledge-point/questions ["q-90705"] :db/ensure [:knowledge-point/validate]} {:db/id "q-90706/selection/28677d0971edd812c11765069c989be76fcaed02e838a17041e6e9b6e8bfc587" :answer/id #uuid "8400e2db-007e-5607-b5d1-f7f8c12cff93" :answer/type :answer.type/text :answer/value "$-1$ or $6$" :db/ensure [:answer/validate]} {:db/id "q-90706/selection/fad0c02550c17ff2a0c7120a104678d580261bd058e73f91ce4e6f97be13d92c" :answer/id #uuid "97f52cf9-cf44-5b19-ad28-ae6f6f6d6d33" :answer/type :answer.type/text :answer/value "$-2$ or $3$" :db/ensure [:answer/validate]} {:db/id "q-90706/selection/824ea117a51c22dcaafa4ba43dacbb8d1fbecbaa289da77fda19d45da6cd6012" :answer/id #uuid "9b213850-47e7-511e-a6a2-4cba96c6e231" :answer/type :answer.type/text :answer/value "$-3$ or $2$" :db/ensure [:answer/validate]} {:db/id "q-90706/selection/580a5b27adabc3889603f989e34fe47c5563cf079f3a63b8db21941c16008dbf" :answer/id #uuid "e564a055-0ebd-542c-aa6c-ee6120fefd13" :answer/type :answer.type/text :answer/value "$-6$ or $1$" :db/ensure [:answer/validate]} {:db/id "q-90706/selection/4382aabbc84da16c03c3a8496a94b1e7008d96d87cf0cfd839b5753b9d1619bb" :answer/id #uuid "75e2608b-1992-5092-ab83-3a9384c54d55" :answer/type :answer.type/text :answer/value "$-4$ or $2$" :db/ensure [:answer/validate]} {:db/id "q-90706/selection" :answer-field/id #uuid "39938c10-418e-5dd9-871e-81f1e865142f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-90706/selection/fad0c02550c17ff2a0c7120a104678d580261bd058e73f91ce4e6f97be13d92c" :answer-field/choices ["q-90706/selection/28677d0971edd812c11765069c989be76fcaed02e838a17041e6e