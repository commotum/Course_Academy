jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14073105/state.json" "file_sha256" "3e6b3f60c63697321adf107027986c9265904a8db05402e28e9228e823d4648c"}] "usage" {"q-337103" []} "basis" 2672 "retractions" [[17592186229655 :question/problem "Consider the d’Alembert differential equation\n\n$y = x(1 + \\frac{dy}{dx}) + (\\frac{dy}{dx})^{2}$.\n\nIf $y^{′}(x) = t$, then general solution can be expressed in parametric form $(x(t), y(t))$, where\n\n$x(t) = Ce^{-t} + f(t)$\nand $C$ is an arbitrary constant. Find the function $f(t)$.\n\n*Hint: Under the given transformation, we have*\n$\\frac{dx}{dt} + x =-2t$.\n*You may also wish to make use of the following result (constants omitted):*\n$∫te^{t}dt = (t - 1)e^{t}$"]] "immutable_answers" [17592186228355 17592186228356 17592186228357 17592186228358 17592186228359] "immutable_fields" [[17592186228354 :answer-field/correct] [17592186228354 :answer-field/id] [17592186228354 :answer-field/key] [17592186228354 :answer-field/type]] "no_history" []}
