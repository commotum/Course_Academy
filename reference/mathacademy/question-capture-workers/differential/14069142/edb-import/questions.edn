 17592186144366} {:answer/id #uuid "1326d378-b960-569c-a347-267b1b7b1ffa" :answer/type {:db/ident :answer.type/math} :answer/value "4λ^{2} - λ = 0" :db/id #edb/ref 17592186144367} {:answer/id #uuid "1c0070c8-11f3-5495-8dc6-7f4a7c2ecc83" :answer/type {:db/ident :answer.type/math} :answer/value "2λ^{2} - λ + 1 = 0" :db/id #edb/ref 17592186144368} {:answer/id #uuid "47d821b4-5dc7-5fb9-b72e-cfddf77ccd6b" :answer/type {:db/ident :answer.type/math} :answer/value "λ^{2} - λ + 2 = 0" :db/id #edb/ref 17592186144369} {:answer/id #uuid "727cb974-b3a8-5018-adc1-992291c16d6f" :answer/type {:db/ident :answer.type/math} :answer/value "λ^{2} - 2λ + 1 = 0" :db/id #edb/ref 17592186144370}] :answer-field/correct {:answer/id #uuid "f26932b6-b716-5ea2-b4e3-ca27d9be9fbf" :answer/type {:db/ident :answer.type/math} :answer/value "2λ^{2} - λ = 0" :db/id #edb/ref 17592186144366} :answer-field/id #uuid "aa054d8c-d04d-54c6-a65c-13f603166f91" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186144365}] :question/id #uuid "76de2b1a-200b-50ab-962d-beae9047d678" :question/math-academy-id "q-342276" :question/problem "$4xy^{″} + 2y^{′} - y = 0$\n\nFind the indicial equation for a Frobenius series solution about the regular singular point $x = 0$ of the differential equation above."}]}
