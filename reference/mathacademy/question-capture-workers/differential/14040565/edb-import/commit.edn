$⟨c,a⟩$ and $⟨c,b⟩:$\n\n$$\n\\begin{aligned}6\\overset{―}{⟨c,a⟩}+4\\overset{―}{⟨c,b⟩} & =6(\\overset{―}{2+4\\text{i}})+4\\overset{―}{(-5-3\\text{i})} \\\\  & =6(2-4\\text{i})+4(-5+3\\text{i}) \\\\  & =12-24\\text{i}-20+12\\text{i} \\\\  & =-8-12\\text{i}\\end{aligned}\n$$" 13194139534759 true] [17592186308220 1000 #edb/ref 17592186308221 13194139534759 true] [17592186308220 1000 #edb/ref 17592186308222 13194139534759 true] [17592186308220 1000 #edb/ref 17592186308223 13194139534759 true] [17592186308220 1000 #edb/ref 17592186308224 13194139534759 true] [17592186308220 1000 #edb/ref 17592186308225 13194139534759 true] [17592186308220 1040 #edb/ref 17592186045450 13194139534759 true] [17592186308220 1041 "selection" 13194139534759 true] [17592186308220 1104 #edb/ref 17592186308221 13194139534759 true] [17592186308220 1110 #uuid "bf0700f2-8363-5aac-9ec1-f258333daceb" 13194139534759 true] [17592186308221 1034 "-8-12\\text{i}" 13194139534759 true] [17592186308221 1103 #edb/ref 17592186045453 13194139534759 true] [17592186308221 1111 #uuid "0ff61cd9-1ab9-54da-985c-eefda8afbcba" 13194139534759 true] [17592186308222 1034 "8+12\\text{i}" 13194139534759 true] [17592186308222 1103 #edb/ref 17592186045453 13194139534759 true] [17592186308222 1111 #uuid "2ee09841-ed7c-52fd-a1d1-e33781fa5cee" 13194139534759 true] [17592186308223 1034 "-3+\\text{i}" 13194139534759 true] [17592186308223 1103 #edb/ref 17592186045453 13194139534759 true] [17592186308223 1111 #uuid "abed3f46-9bbc-5fa9-98cd-3999d7a7e37e" 13194139534759 true] [17592186308224 1034 "3-\\text{i}" 13194139534759 true] [17592186308224 1103 #edb/ref 17592186045453 13194139534759 true] [17592186308224 1111 #uuid "f025f391-8994-5de9-83cd-c7de8ad63ba4" 13194139534759 true] [17592186308225 1034 "12+8\\text{i}" 13194139534759 true] [17592186308225 1103 #edb/ref 17592186045453 13194139534759 true] [17592186308225 1111 #uuid "db1313f3-9453-575a-b454-ecf9b7fde1e9" 13194139534759 true] [17592186308226 1017 #edb/ref 17592186308227 1319