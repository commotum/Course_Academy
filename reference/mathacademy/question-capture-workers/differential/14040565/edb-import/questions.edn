nswer/id #uuid "15cbba13-b018-54ae-864c-281f2976c31e" :answer/type {:db/ident :answer.type/math} :answer/value "14 + \\textrm{i}" :db/id #edb/ref 17592186132546} {:answer/id #uuid "44e3ebb7-6021-5ac5-98e3-9d027013e7bf" :answer/type {:db/ident :answer.type/math} :answer/value "10 - 2\\textrm{i}" :db/id #edb/ref 17592186132547}] :answer-field/correct {:answer/id #uuid "9b8cdfe0-b0d8-541b-ace8-6390de59f108" :answer/type {:db/ident :answer.type/math} :answer/value "11 - 4\\textrm{i}" :db/id #edb/ref 17592186132543} :answer-field/id #uuid "0d5ef943-ac4c-5829-88ba-14e24ba16a9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132542}] :question/id #uuid "59f23fa6-6c50-54ee-b500-91f27bbfcf52" :question/math-academy-id "q-43804" :question/problem "Given that $x, y ∈ C^{3}$, compute the standard Hermitian inner product $⟨x, y⟩$ of the following two vectors.\n$x = \\begin{bmatrix}1 + \\textrm{i} \\\\ 2 \\\\ 2 - \\textrm{i}\\end{bmatrix}, y = \\begin{bmatrix}1 + \\textrm{i} \\\\ 3 \\\\ 2 + \\textrm{i}\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186134471 :knowledge-point/_questions [{:knowledge-point/id #uuid "42258cf7-c1cf-5cc3-876d-102cc2233083" :knowledge-point/title "Identifying True Statements Regarding the Hermitian Inner Product"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a54968-0216-55c2-9a8a-0bcdf4fca7f8" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186133269} {:answer/id #uuid "ac3b910c-ed49-5562-b5b5-3c07647d2ce0" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186133270} {:answer/id #uuid "bdc36f7c-b92f-5126-9272-ffb91d12ee8b" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186133271} {:answer/id #uuid "c6db85b6-61f2-5ef6-aaca-a1350ca39d45" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186133272} {:answer/id #uuid "3027af17-4f03-5cb9-83dc-c7b31c856e33" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186133273}] :answer-field/correct {:answer/id #uuid "ac3b910c-ed49-5562-b5b5-3c07647d2ce0" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186133270} :answer-field/id #uuid "5b987768-1cf1-5774-a3e1-0eb5e6a4f663" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133268}] :question/id #uuid "45f8ab8c-12d7-5df5-b151-ee8250c362bf" :question/math-academy-id "q-96833" :question/problem "Consider the standard Hermitian inner product $⟨ \\cdot, \\cdot ⟩$ over $C$.\nWhich of the following statements are true?\n\n1. $⟨a, b⟩ = ⟨b, a⟩^(―)$ for any $a, b ∈ C^{n}$\n2. $⟨a, αb⟩ = α⟨a, b⟩$ for any $a, b ∈ C^{n}$ and any $α ∈ C$\n3. $⟨a, b⟩ ∈ R$ for any $a, b ∈ C^{n}$"}]}
