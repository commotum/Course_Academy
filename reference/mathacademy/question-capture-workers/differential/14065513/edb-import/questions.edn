t :answer.type/math} :answer/value "y =-6xe^{-x} + 4\\cos 2x + 3\\sin 2x" :db/id #edb/ref 17592186086960} {:answer/id #uuid "39a5d010-3a69-5be3-8e02-f0d15c8f9f39" :answer/type {:db/ident :answer.type/math} :answer/value "y = 6e^{-x} - e^{x} + 4\\cos 2x + 3\\sin 2x" :db/id #edb/ref 17592186086961} {:answer/id #uuid "625d16c2-668f-5d31-a20f-579d15ccf8eb" :answer/type {:db/ident :answer.type/math} :answer/value "y = 2e^{-x} + 6xe^{-x} + 2\\cos 2x + \\sin 2x" :db/id #edb/ref 17592186086962} {:answer/id #uuid "652e2d5b-328f-5552-b801-60bcf167bd8e" :answer/type {:db/ident :answer.type/math} :answer/value "y = 6e^{-x} + 12xe^{-x} + 4\\cos 2x + 3\\sin 2x" :db/id #edb/ref 17592186086963}] :answer-field/correct {:answer/id #uuid "d2f28f9a-fbcb-5d19-b12a-c77331fd5a22" :answer/type {:db/ident :answer.type/math} :answer/value "y =-6xe^{-x} + 4\\cos 2x + 3\\sin 2x" :db/id #edb/ref 17592186086960} :answer-field/id #uuid "3c8445a6-c3e9-50f6-b421-320a32dbd4d3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186086958}] :question/id #uuid "f684abde-2923-5a1b-8719-a76da5c1d85c" :question/math-academy-id "q-8114" :question/problem "Solve the initial value problem\n\n$y^{″} + 2y^{′} + y =-25\\sin 2x, y(0) = 4, y^{′}(0) = 0$."}] [{:db/id #edb/ref 17592186088339 :knowledge-point/_questions [{:knowledge-point/id #uuid "1292269f-5e99-5354-924d-824238118a8d" :knowledge-point/title "Solving a Second-Order ODE When the Right-Hand Side and the Complementary Solution are Dependent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c69ed520-591c-5eb8-9b04-ef260c4a0ad2" :answer/type {:db/ident :answer.type/math} :answer/value "y = P\\cos x + Q\\sin x + \\frac{1}{4}\\cos 2x + \\frac{1}{2}\\sin 2x" :db/id #edb/ref 17592186086965} {:answer/id #uuid "434012ab-92d4-5613-be0e-1ed247361611" :answer/type {:db/ident :answer.type/math} :answer/value "y = P\\cos 2x + Q\\sin 2x + x(\\frac{1}{4}\\cos 2x + 2\\sin 2x)" :db/id #edb/ref