[[:db/retract 17592186129523 :question/answer-fields 17592186126932] {:db/id "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/7bb3818943327083e4a69059e38ff9bd854ee89a5f9dd397859b5b9fedd3d557" :answer/id #uuid "f95c33dd-2a38-5d3f-922d-f9d50ae42d4c" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/158107d88c6881b5462e65770fe0299ad25f8707d868773f9cdf539dc27f5d1b" :answer/id #uuid "f14ea23a-e3dd-5143-a09b-f75fe0796130" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-2{u}_{2}(t) \\\\ {x}_{2}(t)=3{u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/46f92a8510700abcede3fb20ce5f0e1df9d4a9c6f75200127598d71ae8a2b1cb" :answer/id #uuid "f3258add-ff24-550c-83aa-e6dbffd03599" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)=-{u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/88679d803c2ce0ce0cea85c2a25c0a78a2186f9811ce4c030fd415df6bbc6c25" :answer/id #uuid "c962bfb4-4bfd-5618-aa97-8e039d664814" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)=2{u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)=2{u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/df56ee8f79acfd67f36cdcbb5af7ff9a798dcb8094db52a10555e182ed61df38" :answer/id #uuid "06e22282-18a9-50a4-bacb-198194503d1d" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)+{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc" :answer-field/id #uuid "dfa6d9ff-e1cc-5526-9f36-d331989542e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/7bb3818943327083e4a69059e38ff9bd854ee89a5f9dd397859b5b9fedd3d557" :answer-field/choices ["q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/7bb3818943327083e4a69059e38ff9bd854ee89a5f9dd397859b5b9fedd3d557" "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/158107d88c6881b5462e65770fe0299ad25f8707d868773f9cdf539dc27f5d1b" "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/46f92a8510700abcede3fb20ce5f0e1df9d4a9c6f75200127598d71ae8a2b1cb" "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/88679d803c2ce0ce0cea85c2a25c0a78a2186f9811ce4c030fd415df6bbc6c25" "q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc/df56ee8f79acfd67f36cdcbb5af7ff9a798dcb8094db52a10555e182ed61df38"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-324455"] :question/problem "Find the substitution that will decouple the following system of differential equations: \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{2}(t)\\end{aligned}\n$$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}3 & 2 \\\\ 0 & 1\\end{aligned}].$\n\n- Since $A$ is upper-triangular, the eigenvalues are \n\n$$\n{\\lambda }_{1}=3\\,\\text{and}\\,{\\lambda }_{2}=1.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=3,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}0 & 2 \\\\ 0 & -2\\end{aligned}]∼[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{2}=1,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}2 & 2 \\\\ 0 & 0\\end{aligned}]∼[\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\nTherefore, we have $E=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}].$\n\nFinally, the change of variables that decouples the system is given by $x(t)=Eu(t)$, or equivalently,\n\n$$\n{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-324455/selection/ma-v1/fee57d893b370ed8dd395f3163616d32ff4a60f944fa1b24ddd869b8237513cc"] :db/ensure [:question/validate]} {:db/id "q-327973/selection/d939a211c8ffc82eecd0c7bf75e23a5864d2b6831ad3fe2cae56c0f365742236" :answer/id #uuid "87fd7384-b607-564a-aeee-6a09f8181676" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 0\\end{aligned}]{e}^{2t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327973/selection/fa46fc27e78c97a0c33675c63a028a82bc15e8bdb358682ac03a6e7db8e28f62" :answer/id #uuid "55ee2163-ea1a-52fd-9cf2-4d45f90c9901" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 4\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}-3 \\\\ 0\\end{aligned}]{e}^{4t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327973/selection/feb6657016a1d9bdc888cb6c5c6ce0b0a7616b10d4ea713ea9f2e43067ada7b7" :answer/id #uuid "205fe390-e578-5592-8e9c-e749c691ceeb" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}-3 \\\\ 2\\end{aligned}]{e}^{4t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327973/selection/99428129d5f6ce919681b6b25ffe002ab029b75cf2edc41e96a81292fff68f98" :answer/id #uuid "a7e703c3-6cca-569c-992a-9743bd7e8f39" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}-3 \\\\ 2\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{4t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327973/selection/c609b28ce7a7ac44fc73752e021ab324f6217bbc26dfaafca9d717dbb53d962f" :answer/id #uuid "5090d7d1-dd1b-5dc7-92f2-55ea8302d518" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}3 \\\\ 1\\end{aligned}]{e}^{4t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327973/selection" :answer-field/id #uuid "f795efb7-e089-5a79-a5c0-e8dcc6042e03" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-327973/selection/feb6657016a1d9bdc888cb6c5c6ce0b0a7616b10d4ea713ea9f2e43067ada7b7" :answer-field/choices ["q-327973/selection/d939a211c8ffc82eecd0c7bf75e23a5864d2b6831ad3fe2cae56c0f365742236" "q-327973/selection/fa46fc27e78c97a0c33675c63a028a82bc15e8bdb358682ac03a6e7db8e28f62" "q-327973/selection/feb6657016a1d9bdc888cb6c5c6ce0b0a7616b10d4ea713ea9f2e43067ada7b7" "q-327973/selection/99428129d5f6ce919681b6b25ffe002ab029b75cf2edc41e96a81292fff68f98" "q-327973/selection/c609b28ce7a7ac44fc73752e021ab324f6217bbc26dfaafca9d717dbb53d962f"] :db/ensure [:answer-field/validate]} {:db/id "q-327973" :question/id #uuid "60184a1f-a4a4-5376-90fb-5beea958c839" :question/math-academy-id "q-327973" :question/problem "Find the general solution to the system of differential equations \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t)-3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=4{x}_{2}(t).\\end{aligned}\n$$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}2 & -3 \\\\ 0 & 4\\end{aligned}].$\n\n- Since $A$ is upper-triangular, the eigenvalues are \n\n$$\n{\\lambda }_{1}=2\\,\\text{and}\\,{\\lambda }_{2}=4.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=2,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}0 & -3 \\\\ 0 & 2\\end{aligned}]∼[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{2}=4,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-2 & -3 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}-3 \\\\ 2\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]{e}^{2t}+{c}_{2}[\\begin{aligned}-3 \\\\ 2\\end{aligned}]{e}^{4t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-327973/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39"] :knowledge-point/questions ["q-327973"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327989/selection/3c3a0245dbffa44c75ae296662a998f2a7c2694f12730d4ce054303fb0d69257" :answer/id #uuid "2005c156-846e-5d2a-8a37-8c10c6d73d39" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 4\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327989/selection/c58e16c2f92c782da831e18fb26af33243bf808fb2f9888413d52f6e963db983" :answer/id #uuid "bdaa7b94-8d58-50dc-b810-d71932c951ad" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{4t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327989/selection/dbbe363ea42404cf0fea3208463b0c382d00740f7bc20cac33d911387a0c2a42" :answer/id #uuid "cc14df5f-5d44-5795-8014-c808cc303d09" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 3\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327989/selection/7fdcaf5651bba7b23c2edf90db6b6a5fe520ddbc7cd4cafe87c6ba16f9914200" :answer/id #uuid "b2a12639-3715-5404-9644-7b36e50a16da" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t},\\,{c}_{1}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327989/selection/c1cd6d177f3088c0cc5ec630769b3618cc2257536db7ac0e33182fb57b22f08e" :answer/id #uuid "894a9c3e-965f-589d-85eb-980065ff2863" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 4\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327989/selection" :answer-field/id #uuid "e478d77e-9a4e-57ae-98af-6204361758e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-327989/selection/c1cd6d177f3088c0cc5ec630769b3618cc2257536db7ac0e33182fb57b22f08e" :answer-field/choices ["q-327989/selection/3c3a0245dbffa44c75ae296662a998f2a7c2694f12730d4ce054303fb0d69257" "q-327989/selection/c58e16c2f92c782da831e18fb26af33243bf808fb2f9888413d52f6e963db983" "q-327989/selection/dbbe363ea42404cf0fea3208463b0c382d00740f7bc20cac33d911387a0c2a42" "q-327989/selection/7fdcaf5651bba7b23c2edf90db6b6a5fe520ddbc7cd4cafe87c6ba16f9914200" "q-327989/selection/c1cd6d177f3088c0cc5ec630769b3618cc2257536db7ac0e33182fb57b22f08e"] :db/ensure [:answer-field/validate]} {:db/id "q-327989" :question/id #uuid "94d96b96-98bb-5063-b4f0-15839c9585ed" :question/math-academy-id "q-327989" :question/problem "Find the general solution to the system of differential equations\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=4{x}_{1}(t)-2{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=2.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}3 & -1 \\\\ 4 & -2\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=-1\\,\\text{and}\\,{\\lambda }_{2}=2.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=-1,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}4 & -1 \\\\ 4 & -1\\end{aligned}]∼[\\begin{aligned}1 & -\\frac{1}{4} \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 4\\end{aligned}].$\n\n- For ${\\lambda }_{2}=2,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}1 & -1 \\\\ 4 & -4\\end{aligned}]∼[\\begin{aligned}1 & -1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}1 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}1 \\\\ 4\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}1 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-327989/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39"] :knowledge-point/questions ["q-327989"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327992/selection/f95e57abe7fbc6438ad287d6fe065dcdc95a405278c111790f41854855d05ba1" :answer/id #uuid "6876fbcd-43c7-527f-9064-cb17268b73f5" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{t}+{c}_{2}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{-t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327992/selection/1124c246213c70ff9ab7542eeff879366e2a5f7851c92990f52ddf1e39567548" :answer/id #uuid "4a85f485-d35a-5bf6-a15d-bb9290f5d772" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}3 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327992/selection/4575cd95b45e272c9fb5f33acb269197614568c9b64d89c19012d9291a8cf642" :answer/id #uuid "0880d0cc-1a1b-5d4d-a375-1ee8dac66c59" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327992/selection/23afd82bc63af0f2522d3422226c9af6be5b7ee3af6ad0887ee3c4038eaf34ab" :answer/id #uuid "e3c0450d-c904-58cf-be7f-ff21618e4fa9" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{-t}+{c}_{2}[\\begin{aligned}3 \\\\ 2\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327992/selection/03cedcaeb285412f7788218f375bf85d84ae83cbce636e99f137cd8a50370569" :answer/id #uuid "9ccdd717-f607-569f-9914-e91232b1df98" :answer/type :answer.type/math :answer/value "x(t)={c}_{1}[\\begin{aligned}1 \\\\ 2\\end{aligned}]{e}^{3t}+{c}_{2}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{2t},\\,{c}_{1},{c}_{2}\\in R" :db/ensure [:answer/validate]} {:db/id "q-327992/selection" :answer-field/id #uuid "90e7dbc5-7141-5506-a7e9-414a93c5e4d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-327992/selection/4575cd95b45e272c9fb5f33acb269197614568c9b64d89c19012d9291a8cf642" :answer-field/choices ["q-327992/selection/f95e57abe7fbc6438ad287d6fe065dcdc95a405278c111790f41854855d05ba1" "q-327992/selection/1124c246213c70ff9ab7542eeff879366e2a5f7851c92990f52ddf1e39567548" "q-327992/selection/4575cd95b45e272c9fb5f33acb269197614568c9b64d89c19012d9291a8cf642" "q-327992/selection/23afd82bc63af0f2522d3422226c9af6be5b7ee3af6ad0887ee3c4038eaf34ab" "q-327992/selection/03cedcaeb285412f7788218f375bf85d84ae83cbce636e99f137cd8a50370569"] :db/ensure [:answer-field/validate]} {:db/id "q-327992" :question/id #uuid "d98b6270-0f82-5465-8384-3b4abd68c525" :question/math-academy-id "q-327992" :question/problem "Find the general solution to the system of differential equations\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)+2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+2{x}_{2}(t).\\end{aligned}\n$$\n\n*Hint: The eigenvalues of the system's matrix are ${\\lambda }_{1}=4$ and ${\\lambda }_{2}=1.$*" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}3 & 2 \\\\ 1 & 2\\end{aligned}].$\n\n- We are given that the eigenvalues are \n\n$$\n{\\lambda }_{1}=4\\,\\text{and}\\,{\\lambda }_{2}=1.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=4,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}-1 & 2 \\\\ 1 & -2\\end{aligned}]∼[\\begin{aligned}1 & -2 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}].$\n\n- For ${\\lambda }_{2}=1,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}2 & 2 \\\\ 1 & 1\\end{aligned}]∼[\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\nNow, we write down the general solution to the given linear system of differential equations: \n\n$$\n\\begin{aligned}x(t) & ={c}_{1}{v}_{1}{e}^{{\\lambda }_{1}t}+{c}_{2}{v}_{2}{e}^{{\\lambda }_{2}t} \\\\  & ={c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]{e}^{4t}+{c}_{2}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]{e}^{t},\\,{c}_{1},{c}_{2}\\in R\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-327992/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9cfc838b-2e21-5021-8afc-000d12acdf39"] :knowledge-point/questions ["q-327992"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327998/selection/7bb3818943327083e4a69059e38ff9bd854ee89a5f9dd397859b5b9fedd3d557" :answer/id #uuid "6fd6e027-23d8-57d4-8c6b-783de92c7127" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-327998/selection/36864cbbbc4e66d52cc27d879f56d1de8bb2ee0b8bd4d9126400cd225aa0e11a" :answer/id #uuid "5417ee3e-aa84-5a1a-8c3d-de915206884a" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t) \\\\ {x}_{2}(t)={u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-327998/selection/6f73001774da950cd83c2f20dfe7eec4be1b9b801bad53ff9b8d3a3aaf292996" :answer/id #uuid "2ffe05dc-fc42-58e2-8d0b-50588c237929" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{1}(t)+{u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-327998/selection/a8d8d263184eefc649f522ef1c85d50774c64584bf4e856f1ad329d782f2ac0c" :answer/id #uuid "af677dff-d00a-531b-946b-eb595e0b7912" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)={u}_{1}(t) \\\\ {x}_{2}(t)=-{u}_{1}(t)+{u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-327998/selection/d470c4a1fee778bbcea05c61d95fc0539c4dde2c39879401e96328280e13ac3a" :answer/id #uuid "4018bd12-8a9d-5629-ac52-0782e8a8d004" :answer/type :answer.type/math :answer/value "{\\begin{aligned}{x}_{1}(t)=-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{1}(t)+{u}_{2}(t)\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-327998/selection" :answer-field/id #uuid "610f5317-dd9e-501f-956c-8cde748a484d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-327998/selection/7bb3818943327083e4a69059e38ff9bd854ee89a5f9dd397859b5b9fedd3d557" :answer-field/choices ["q-327998/selection/7bb3818943327083e4a69059e38ff9bd854ee89a5f9dd397859b5b9fedd3d557" "q-327998/selection/36864cbbbc4e66d52cc27d879f56d1de8bb2ee0b8bd4d9126400cd225aa0e11a" "q-327998/selection/6f73001774da950cd83c2f20dfe7eec4be1b9b801bad53ff9b8d3a3aaf292996" "q-327998/selection/a8d8d263184eefc649f522ef1c85d50774c64584bf4e856f1ad329d782f2ac0c" "q-327998/selection/d470c4a1fee778bbcea05c61d95fc0539c4dde2c39879401e96328280e13ac3a"] :db/ensure [:answer-field/validate]} {:db/id "q-327998" :question/id #uuid "433d8453-f0ad-5ea8-a709-2bf2124c3913" :question/math-academy-id "q-327998" :question/problem "Find the substitution that will decouple the following system of differential equations: \n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-4{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=5{x}_{2}(t)\\end{aligned}\n$$" :question/worked-solution "We need to find the eigenvalues and the eigenvectors of the matrix $A=[\\begin{aligned}1 & -4 \\\\ 0 & 5\\end{aligned}].$\n\n- Since $A$ is upper-triangular, the eigenvalues are \n\n$$\n{\\lambda }_{1}=1\\,\\text{and}\\,{\\lambda }_{2}=5.\n$$\n\n- Let's go through the process of finding the eigenvectors.\n\n- For ${\\lambda }_{1}=1,$ we get \n\n$$\nA-{\\lambda }_{1}I=[\\begin{aligned}0 & -4 \\\\ 0 & 4\\end{aligned}]∼[\\begin{aligned}0 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{1}=[\\begin{aligned}1 \\\\ 0\\end{aligned}].$\n\n- For ${\\lambda }_{2}=5,$ we get \n\n$$\nA-{\\lambda }_{2}I=[\\begin{aligned}-4 & -4 \\\\ 0 & 0\\end{aligned}]∼[\\begin{aligned}1 & 1 \\\\ 0 & 0\\end{aligned}].\n$$\n\nSo, we get an eigenvector \n${v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}].$\n\nTherefore, we have $E=[\\begin{aligned}1 & -1 \\\\ 0 & 1\\end{aligned}].$\n\nFinally, the change of variables that decouples the system is given by $x(t)=Eu(t)$, or equivalently,\n\n$$\n{\\begin{aligned}{x}_{1}(t)={u}_{1}(t)-{u}_{2}(t) \\\\ {x}_{2}(t)={u}_{2}(t).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-327998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2a962d5e-5cc9-530e-9f95-85c399af7e4b"] :knowledge-point/questions ["q-327998"] :db/ensure [:knowledge-point/validate]}]
