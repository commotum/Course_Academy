}^{2}.$ \n\nSo, let's substitute $u=\\frac{x}{2}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2}\\,⟹\\,\\text{d}x=2\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{4+{x}^{2}}\\,\\text{d}x & =\\frac{1}{4}\\int \\frac{1}{1+(x/2)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\cdot (2\\,\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{2})+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-49505" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/activity-metadata.json" "file_sha256" "4207968f4e09770be703843106668d261c81eac2351ac6724a5e99fb8a907a0b"} {"question" "q-49505" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-49505" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{arctan}⁡(2x)+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{2})+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡x+C"] ["math" "\\operatorname{arctan}⁡(2x)+C"] ["math" "\\operatorname{arctan}⁡(\\frac{x}{2})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-49505" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{2})+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-114036" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{1}{1+3{x}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-114036" "field" nil "attribute" "question/worked-solution" "value" "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $3{x}^{2}=(\\sqrt{3}x)^{2}.$\n\nSo, let's substitute $u=\\sqrt{3}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{3}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+3{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(\\sqrt{3}x)^{2}}\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\frac{1}{\\sqrt{3}}\\int \\frac{1}{1+{u}^{2}}\\text{d}u \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-114036" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/activity-metadata.json" "file_sha256" "4207968f4e09770be703843106668d261c81eac2351ac6724a5e99fb8a907a0b"} {"question" "q-114036" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-114036" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3\\operatorname{arctan}⁡(\\sqrt{3}x)+C"] ["math" "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C"] ["math" "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(x)+C"] ["math" "\\operatorname{arctan}⁡(\\frac{\\sqrt{3}x}{3})+C"] ["math" "\\sqrt{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-114036" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{3}}{3}\\operatorname{arctan}⁡(\\sqrt{3}x)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-73718" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{1}{5|x|\\sqrt{25{x}^{2}-1}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-73718" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{5|x|\\sqrt{25{x}^{2}-1}}=\\int \\frac{\\text{d}x}{|5x|\\sqrt{(5x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $5x.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{5|x|\\sqrt{25{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{1}{|5x|\\sqrt{(5x)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{5}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-73718" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/activity-metadata.json" "file_sha256" "4207968f4e09770be703843106668d261c81eac2351ac6724a5e99fb8a907a0b"} {"question" "q-73718" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" 