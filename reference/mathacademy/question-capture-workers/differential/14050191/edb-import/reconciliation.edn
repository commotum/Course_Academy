}⁡u+C \\\\  & =2\\operatorname{arctan}⁡(3x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-49540" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/activity-metadata.json" "file_sha256" "4207968f4e09770be703843106668d261c81eac2351ac6724a5e99fb8a907a0b"} {"question" "q-49540" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-49540" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{arcsin}⁡(3x)+C"] ["math" "2\\operatorname{arctan}⁡(3x)+C"] ["math" "6\\operatorname{arctan}⁡(3x)+C"] ["math" "\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C"] ["math" "\\frac{\\operatorname{arctan}⁡(3x)}{3}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-49540" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{arctan}⁡(3x)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14050191/state.json" "file_sha256" "209bc00cb40175a9943a64f62fd3f5191b12be9d808b34cf249d94d8af200e70"} {"question" "q-73714" "field" nil "attribute" "question/problem" "value" 