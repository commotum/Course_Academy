ourse_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-114023" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{1}{6}\\operatorname{arcsin}⁡(x)+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\int \\frac{2}{64\\cdot (1+{x}^{2}/64)}\\,\\text{d}x \\\\  & =\\frac{2}{64}\\int \\frac{1}{1+{x}^{2}/64}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{8})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{8}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{8}\\,⟹\\,\\text{d}x=8\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{64+{x}^{2}}\\,\\text{d}x & =\\frac{1}{32}\\int \\frac{1}{1+(x/8)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{32}\\int \\frac{1}{1+{u}^{2}}\\cdot (8\\,\\text{d}u) \\\\  & =\\frac{1}{4}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{8})+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/activity-metadata.json" "file_sha256" "c05a08d8162628e21f5cd0f4a253bb7a2733fb49041e999778716cebcb87e247" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{arcsin}⁡(8x)}{8}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{arcsin}⁡(\\frac{x}{8})}{4}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{arctan}⁡(\\frac{x}{4})}{4}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{4}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49551" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{arctan}⁡(\\frac{x}{8})}{8}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{2}\\frac{5}{\\sqrt{16-{x}^{2}}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{5}{\\sqrt{16-{x}^{2}}}\\,\\text{d}x & =5{\\int }_{0}^{2}\\frac{1}{\\sqrt{16\\cdot (1-{x}^{2}/16)}}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-{x}^{2}/16}}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/4)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{4})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{4}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{5}{\\sqrt{16-{x}^{2}}}\\,\\text{d}x & =\\frac{5}{4}{\\int }_{0}^{2}\\frac{1}{\\sqrt{1-(x/4)^{2}}}\\,\\text{d}x \\\\  & =\\frac{5}{4}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (4\\,\\text{d}u) \\\\  & =5{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =5\\operatorname{arcsin}⁡u{|}_{0}^{1/2} \\\\  & =5\\operatorname{arcsin}⁡(\\frac{1}{2})-5\\operatorname{arcsin}⁡(0) \\\\  & =\\frac{5\\pi }{6}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/activity-metadata.json" "file_sha256" "c05a08d8162628e21f5cd0f4a253bb7a2733fb49041e999778716cebcb87e247" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{5\\pi }{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{5\\pi }{4}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{5\\pi }{6}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{6}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19393" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\pi "] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{1/5}\\frac{20}{3+75{x}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" nil "attribute" "question/worked-solution" "value" "Note that we can write this integral as\n\n$$\n{\\int }_{0}^{1/5}\\frac{20}{3+75{x}^{2}}\\,\\text{d}x=\\frac{20}{3}{\\int }_{0}^{1/5}\\frac{1}{1+25{x}^{2}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\text{d}x=\\frac{1}{5}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{5}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/5}\\frac{20}{3+75{x}^{2}}\\,\\text{d}x & =\\frac{20}{3}{\\int }_{0}^{1/5}\\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\frac{20}{3}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{4}{3}{\\int }_{0}^{1}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{4}{3}\\operatorname{arctan}⁡u{|}_{0}^{1} \\\\  & =\\frac{4}{3}\\operatorname{arctan}⁡(1)-\\frac{4}{3}\\operatorname{arctan}⁡(0) \\\\  & =\\frac{4}{3}\\cdot \\frac{\\pi }{4} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/activity-metadata.json" "file_sha256" "c05a08d8162628e21f5cd0f4a253bb7a2733fb49041e999778716cebcb87e247" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{2\\pi }{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{4\\pi }{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\pi }{4}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-19396" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\pi }{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-470" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\displaystyle \\int \\dfrac{9}{4\\sqrt{1-9x^2}} \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-470.json" "file_sha256" "1025a33422822b6db8f473989eb2074d5d9763952048ca4f593096ef1da5e7e2" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-470" "field" nil "attribute" "question/worked-solution" "value" "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^2}}\\textrm{d}u = \\arcsin(u)+C.\n$$\n\nThe only difference is that instead of $u^2$ as the variable, we have $9x^2 = (3x)^2.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=3\\quad\\Longrightarrow\\quad \\dfrac 1 3 \\,\\textrm d u=\\textrm d x.\n$$\n\nWe can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{9}{4\\sqrt{1-9{x}^{2}}}\\,\\text{d}x & =\\frac{9}{4}\\int \\frac{1}{\\sqrt{1-(3x)^{2}}}\\,\\,\\text{d}x \\\\  & =\\frac{9}{4}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{9}{12}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{3}{4}\\cdot \\operatorname{arcsin}⁡u+C \\\\  & =\\frac{3}{4}\\operatorname{arcsin}⁡3x+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-470.json" "file_sha256" "1025a33422822b6db8f473989eb2074d5d9763952048ca4f593096ef1da5e7e2" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-471" "field" nil "attribute" "question/problem" "value" "Calculate the integral  $\\displaystyle{\\int \\dfrac{3}{2 + 50x^2} \\, \\textrm{d}x }.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-471.json" "file_sha256" "252352644dbe0a25fe397efd63f81934562ae8869aa32c079dd3097021d97db2" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-471" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\dfrac{3}{2 + 50x^2} \\, \\textrm{d}x = \\int \\dfrac{3}{2(1 + 25x^2)} = \\dfrac 3 2 \\int \\dfrac{1}{1+25x^2}\\,\\textrm d x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+u^2}\\textrm{d}u =\\arctan u +C.\n$$\n\nThe only difference is that instead of $u^2$ as the variable, we have $25x^2 = (5x)^2.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=5\\quad\\Longrightarrow\\quad \\dfrac 1 5\\,\\textrm d u = \\textrm d x.\n$$\n\nWe can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{2+50{x}^{2}}\\,\\text{d}x & =\\frac{3}{2}\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{2}\\int \\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\,\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{3}{10}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{3}{10}\\cdot \\operatorname{arctan}⁡u+C \\\\  & =\\frac{3}{10}\\operatorname{arctan}⁡5x+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-471.json" "file_sha256" "252352644dbe0a25fe397efd63f81934562ae8869aa32c079dd3097021d97db2" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-5014" "field" nil "attribute" "question/problem" "value" "${\\displaystyle \\int \\dfrac{5\\, \\textrm{d}x}{|5x|\\sqrt{(5x)^2-1}}  = }$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-5014.json" "file_sha256" "a21fd1bc799688842e857e008530cd6c2e0f3501ce9a0afcec861d7cb117cc11" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-5014" "field" nil "attribute" "question/worked-solution" "value" "This resembles the basic integral for $\\textrm{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^2-1}} \\textrm{d}u = \\textrm{arcsec}(u)+C.\n$$\n\nLet $u = 5x.$ Then\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=5\n\\quad\\Longrightarrow\\quad\n5\\,\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5\\,\\text{d}x}{|5x|\\sqrt{(5x)^{2}-1}} & =\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec}(u)+C \\\\  & =\\text{arcsec}(5x)+C.\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-5014.json" "file_sha256" "a21fd1bc799688842e857e008530cd6c2e0f3501ce9a0afcec861d7cb117cc11" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-472" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt 2} \\dfrac{1}{2+x^2}\\, \\textrm{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-472.json" "file_sha256" "03dabd58e40622eb355f9559dc7c36cdabd9fab6dc543fb17c701a650367b3c6" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "e-472" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{2}}\\frac{1}{2+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{2}}\\frac{1}{2(1+{x}^{2}/2)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\sqrt{2}}\\frac{1}{2(1+(x/\\sqrt{2})^{2})}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\sqrt{2}}\\frac{1}{1+(x/\\sqrt{2})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe see that this integral now resembles the basic integral for the inverse tangent,\n\n$$\n\\int\\dfrac{1}{1+u^2}\\,\\textrm d u = \\arctan{u} + C.\n$$\n\nWe make the substitution $u=\\dfrac{x}{\\sqrt 2}.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{\\sqrt 2}\\quad\\Longrightarrow\\quad \\sqrt 2 \\,\\textrm d u = \\textrm d x.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\sqrt2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{2}}\\frac{1}{2+{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\cdot \\sqrt{2}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}{\\operatorname{arctan}⁡u|}_{0}^{1} \\\\  & =\\frac{\\sqrt{2}}{2}(\\operatorname{arctan}⁡1-\\operatorname{arctan}⁡0) \\\\  & =\\frac{\\sqrt{2}}{2}(\\frac{\\pi }{4}-0) \\\\  & =\\frac{\\pi \\sqrt{2}}{8}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/example-472.json" "file_sha256" "03dabd58e40622eb355f9559dc7c36cdabd9fab6dc543fb17c701a650367b3c6" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-49546" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{-5/2}^{5/2}\\frac{\\text{d}x}{\\sqrt{25-{x}^{2}}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/state.json" "file_sha256" "674608c20baa5c1128425f82c7e4bddbd5ccfa579a0a8a8966c395c5497386fe" "basis" 1179 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/edb-import/verification.json"} {"question" "q-49546" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-5/2}^{5/2}\\frac{\\text{d}x}{\\sqrt{25-{x}^{2}}}\\, & ={\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{25\\cdot (1-{x}^{2}/25)}}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{1-{x}^{2}/25}}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{5})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-\\frac{5}{2}$ | $\\frac{5}{2}$ |\n| --- | --- | --- |\n| $u$ | $-\\frac{1}{2}$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{-5/2}^{5/2}\\frac{\\text{d}x}{\\sqrt{25-{x}^{2}}} & =\\frac{1}{5}{\\int }_{-5/2}^{5/2}\\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x \\\\  & =\\frac{1}{5}{\\int }_{-1/2}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (5\\,\\text{d}u) \\\\  & ={\\int }_{-1/2}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\operatorname{arcsin}⁡u{|}_{-1/2}^{1/2} \\\\  & =\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(-\\frac{1}{2}) \\\\  & =\\frac{\\pi }{6}+\\frac{\\pi }{6} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/state.json" "file_sha256" "674608c20baa5c1128425f82c7e4bddbd5ccfa579a0a8a8966c395c5497386fe" "basis" 1179 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/edb-import/verification.json"} {"question" "q-49546" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/activity-metadata.json" "file_sha256" "f58488b23f0bf4c4f5a30495a2c8a6772ea09cb609f9ecdd35e14c31759c9642" "basis" 1179 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/edb-import/verification.json"} {"question" "q-49546" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/state.json" "file_sha256" "674608c20baa5c1128425f82c7e4bddbd5ccfa579a0a8a8966c395c5497386fe" "basis" 1179 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/edb-import/verification.json"} {"question" "q-49546" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{2\\pi }{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/state.json" "file_sha256" "674608c20baa5c1128425f82c7e4bddbd5ccfa579a0a8a8966c395c5497386fe" "basis" 1179 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013963/edb-import/verification.json"} {"question" "q-49546" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{5\\pi }{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/140