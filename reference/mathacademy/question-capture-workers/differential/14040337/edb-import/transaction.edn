-53a8-82a9-f85ec6f386f1" :answer/type :answer.type/text :answer/value "$x=-3$ and $x=-2$ only" :db/ensure [:answer/validate]} {:db/id "q-48128/selection/de74767ca5e6a6afbce9f0ecec256399931114e2878f52fe8f8194180fc94eeb" :answer/id #uuid "87ac35e5-2b80-5f8a-9137-9fd3de35128f" :answer/type :answer.type/text :answer/value "$x=-3$ and $x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-48128/selection/1288db97e8c08fe1e59253bc39f36416fd21e4daf73730ee4bb5aebee1b12042" :answer/id #uuid "4fba041a-00f4-56c2-b579-8ed9efc55eeb" :answer/type :answer.type/text :answer/value "$x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-48128/selection/263f2834c39a884ed4107d93e45891bf1c03e1239f1b605574fb2a4e7fa704de" :answer/id #uuid "2500e4a4-aaad-5b59-ab49-e3398e8d6c3c" :answer/type :answer.type/text :answer/value "$x=-2$ and $x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-48128/selection/caa1480127d61a1777b06d605f1adffc9022d9830425fbcfd75797676392e878" :answer/id #uuid "1238ed40-c4bf-5e3f-8056-29ddaeb4f20b" :answer/type :answer.type/text :answer/value "$x=-2$ only" :db/ensure [:answer/validate]} {:db/id "q-48128/selection" :answer-field/id #uuid "a95f6f1a-b250-5e5f-a49b-9a562bd57875" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48128/selection/caa1480127d61a1777b06d605f1adffc9022d9830425fbcfd75797676392e878" :answer-field/choices ["q-48128/selection/284dc81e285b04d1f79c8e3a880b53065b466b3d5526b0ce040d19be51d8ca2e" "q-48128/selection/de74767ca5e6a6afbce9f0ecec256399931114e2878f52fe8f8194180fc94eeb" "q-48128/selection/1288db97e8c08fe1e59253bc39f36416fd21e4daf73730ee4bb5aebee1b12042" "q-48128/selection/263f2834c39a884ed4107d93e45891bf1c03e1239f1b605574fb2a4e7fa704de" "q-48128/selection/caa1480127d61a1777b06d605f1adffc9022d9830425fbcfd75797676392e878"] :db/ensure [:answer-field/validate]} {:db/id "q-48128" :question/id #uuid "660180ee-565e-5382-abb3-a2ce13e9f578" :question/math-academy-id "q-48128" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040337/assets/e3fa6d490da81fca9b24f9de41b01daaa957f574375cc8523aec448a0ef73015.png)\n\nConsider the function $y=f(x)$ plotted above. For what values of $x$ does the function $y=f(x)$ have a removable discontinuity?" :question/worked-solution "The function has a discontinuity at $x=-2.$ Checking our continuity conditions, we have:\n\n- $f(-2)=0$ exists $\\,✓$\n\n- ${lim}_{x\\to (-2)}f(x)=1$ exists $\\,✓$\n\n- ${lim}_{x\\to (-2)}f(x)\\ne f(-2)\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=-2$ is a removable discontinuity.\n\nNote that the function also has a discontinuity at $x=2.$ but it is not a point discontinuity. Checking the conditions, we find that\n\n- $f(2)=0$ exists $\\,✓$\n\n- ${lim}_{x\\to 2}f(x)$ does not exist $\\,\\times $\n\nSo this time, the second condition failed, and therefore $x=2$ is not a point discontinuity.\n\nConsequently, the correct answer is $x=-2$ only." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-48128/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "000408ba-6fbd-51da-9002-82fdde167a1f"] :knowledge-point/questions ["q-48128"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104425/selection/1288db97e8c08fe1e59253bc39f36416fd21e4daf73730ee4bb5aebee1b12042" :answer/id #uuid "a18d8c87-2cee-5776-9eea-acdc617efb74" :answer/type :answer.type/text :answer/value "$x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-104425/selection/68059c11adf834d7074de7ca801c10e6f130db4892fb78ff3a94e344c206fca7" :answer/id #uuid "80b73b78-4fca-598d-823b-c9b8b4cd9573" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=5$ only" :db/ensure [:answer/validate]} {:db/id "q-104425/selection/0502be303afe9b5a0b61d3fd91437f943f16881271c01710e092e19ac0a1f66f" :answer/id #uuid "30ae9b71-98ba-590d-a1cf-c4eb17c826eb" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-104425/selection/2bf1dd67714e170f87c922af4be9d1b901c810283ea5cea91fed0aeffa90bbd8" :answer/id #uuid "f01d7c76-903c-5419-98f7-dddc8172bb2d" :answer/type :answer.type/text :answer/value "$x=5$ only" :db/ensure [:answer/validate]} {:db/id "q-104425/selection/7f61d5691d5f58062eae0e42f87d2a83f74c1e869ef70f381a5596821e0d8731" :answer/id #uuid "8934eea5-143d-5d6d-a996-7a3ee55caabd" :answer/type :answer.type/text :answer/value "$x=2$ and $x=5$ only" :db/ensure [:answer/validate]} {:db/id "q-104425/selection" :answer-field/id #uuid "fe83238f-fc1a-5a5e-b094-66d4ff80d344" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104425/selection/7f61d5691d5f58062eae0e42f87d2a83f74c1e869ef70f381a5596821e0d8731" :answer-field/choices ["q-104425/selection/1288db97e8c08fe1e59253bc39f36416fd21e4daf73730ee4bb5aebee1b12042" "q-104425/selection/68059c11adf834d7074de7ca801c10e6f130db4892fb78ff3a94e344c206fca7" "q-104425/selection/0502be303afe9b5a0b61d3fd91437f943f16881271c01710e092e19ac0a1f66f" "q-104425/selection/2bf1dd67714e170f87c922af4be9d1b901c810283ea5cea91fed0aeffa90bbd8" "q-104425/selection/7f61d5691d5f58062eae0e42f87d2a83f74c1e869ef70f381a5596821e0d8731"] :db/ensure [:answer-field/validate]} {:db/id "q-104425" :question/id #uuid "12cf0cf4-20ea-574d-b3f6-b08a331df572" :question/math-academy-id "q-104425" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040337/assets/d869c61426504b7b24c2feebd60f68bca6f7dc8a2b40036bf5821e0208e1e197.png)\n\nConsider the function $y=f(x)$ plotted above. For what values of $x$ does the function $y=f(x)$ have a removable discontinuity?" :question/worked-solution "The function has a discontinuity at $x=2.$ Checking our continuity conditions, we have:\n\n- $f(2)=3$ exists $\\,✓$\n\n- ${lim}_{x\\to 2}f(x)=0$ exists $\\,✓$\n\n- ${lim}_{x\\to 2}f(x)\\ne f(2)\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=2$ is a removable discontinuity.\n\nThe function also has a discontinuity at $x=5.$ Checking our continuity conditions, we have:\n\n- $f(5)=-1$ exists $\\,✓$\n\n- ${lim}_{x\\to 5}f(x)=2$ exists $\\,✓$\n\n- ${lim}_{x\\to 5}f(x)\\ne f(5)\\,\\times $\n\nSo it's the third condition that failed, which tells us that $x=5$ is a removable discontinuity.\n\nFinally,  the function has a discontinuity at $x=-1.$ Checking our continuity conditions, we have:\n\n- $f(-1)=3$ exists $\\,✓$\n\n- ${lim}_{x\\to (-1)}f(x)$ does not exists $\\,\\times $\n\nSo it's the second condition that failed, which tells us that $x=-1$ is not a removable discontinuity.\n\nConsequently, the correct answer is $x=2$ and $x=5$ only." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104425/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "000408ba-6fbd-51da-9002-82fdde167a1f"] :knowledge-point/questions ["q-104425"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104407/selection/8c859f3420ed9d333ac1dd12d4179b3e0c7e4c9bf16a6693639ff59d1ecb88fb" :answer/id #uuid "3c9eddb6-84ba-5677-80e5-c048f19372d6" :answer/type :answer.type/text :answer/value "$x=-2$ and $x=-1$ only" :db/ensure [:answer/validate]} {:db/id "q-104407/selection/1288db97e8c08fe1e59253bc39f36416fd21e4daf73730ee4bb5aebee1b12042" :answer/id #uuid "5477384e-c542-5ac2-b4a4-a2ea440e69ed" :answer/type :answer.type/text :answer/value "$x=2$ only" :db/ensure [:answer/validate]} {:db/id "q-104407/selection/caa1480127d61a1777b06d605f1adffc9022d9830425fbcfd75797676392e878" :answer/id #uuid "5548a840-8f1e-5294-a9d0-0b9c14bff39d" :answer/type :answer.type/text :answer/value "$x=-2$ only" :db/ensure [:answer/validate]} {:db/id "q-104407/selection/0502be303afe9b5a0b61d3fd91437f943f16881271c01710e092e19ac0a1f66f" :answer/id #uuid "7546b801-cf8d-5593-bf2a-5850d9b0b105" :answer/type :answer.type/text :answer/value "$x=-1$ and $x=2$ only" :db/ensure [:answ