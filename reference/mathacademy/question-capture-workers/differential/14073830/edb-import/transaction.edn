[{:db/id "q-342496/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "e4bc5c1b-f7bf-54e8-98d1-c97f6a17b100" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id 17592186164946 :answer-field/correct "q-342496/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-342496/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-342496"] :question/problem "$$\nF(x)={\\begin{aligned}{x}^{2}, & x\\in [-3,0] \\\\ -{x}^{2}, & x\\in (0,3)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is converging when $x=2.$\n\nThe Fourier series converges to {{field-1}} when $x=2.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{-}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $6$-periodic extension $f(x)$ of our function $F(x)$ is continuous at $x=2.$ \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\nf(2)=-{2}^{2}=-4.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id 17592186164953 :answer-field/correct 17592186164955 :db/ensure [:answer-field/validate]} {:db/id "q-342573/field-2/f6827777da56db4bd58931c1c2eeb6c100de3d85bc42415c024f44e98b718fe9" :answer/id #uuid "ee29e778-46aa-5082-873a-e9034ca95ca5" :answer/type :answer.type/text :answer/value "continuous" :db/ensure [:answer/validate]} {:db/id "q-342573/field-2/f97aa1dab6b91b65fe50561f5e5db64857823d9990715ee59138c66d2b73c7cd" :answer/id #uuid "e2e17038-1196-5d09-a74e-8b4578e91378" :answer/type :answer.type/text :answer/value "discontinuous" :db/ensure [:answer/validate]} {:db/id "q-342573/field-2" :answer-field/id #uuid "98eeca51-e29e-584b-b8f9-22358b3b8f59" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-342573/field-2/f6827777da56db4bd58931c1c2eeb6c100de3d85bc42415c024f44e98b718fe9" :answer-field/choices ["q-342573/field-2/f6827777da56db4bd58931c1c2eeb6c100de3d85bc42415c024f44e98b718fe9" "q-342573/field-2/f97aa1dab6b91b65fe50561f5e5db64857823d9990715ee59138c66d2b73c7cd"] :db/ensure [:answer-field/validate]} {:db/id "q-342573/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7b55e1b4-d6b6-5c9e-b043-2a50bc093f6c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-342573/field-3/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "c906292b-48cc-50b9-b3ca-4541c22bb9d1" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-342573/field-3/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "390e8907-4438-5502-9451-de61c691bd4b" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-342573/field-3" :answer-field/id #uuid "ccb9d57a-2814-5951-b3a3-8929d965ba3e" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-342573/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-342573/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-342573/field-3/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" "q-342573/field-3/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-342573/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" :answer/id #uuid "b2b97a73-db61-5027-ac79-6bfa3840c6e2" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{8}" :db/ensure [:answer/validate]} {:db/id "q-342573/field-4/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "8d873ddc-998c-594e-a00a-8fc7f3b6b072" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-342573/field-4/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "a54094c8-89f2-5a4e-8c23-bba0577ebd08" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-342573/field-4/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc" :answer/id #uuid "da75184e-3365-5f84-978a-7ed0c3ed7e1d" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-342573/field-4" :answer-field/id #uuid "5b420089-df9a-52d9-b572-03ed13d5ccb7" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-342573/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" :answer-field/choices ["q-342573/field-4/6d0086fbf1d5dadda84b813260fdcf9f8964549bf3d2a02972d43bc272b01425" "q-342573/field-4/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-342573/field-4/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-342573/field-4/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-342573"] :question/problem "Consider the function $F(x)=|x|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{\\pi }{2}-{\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (2n-1)^{2}}\\operatorname{cos}⁡((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.At $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡((2n-1)\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{\\pi }{2}-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡((2n-1)x).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡((2n-1)\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{\\pi }{2}-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡((2n-1)\\cdot 0) \\\\ 0 & =\\frac{\\pi }{2}-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot 1 \\\\ -\\frac{\\pi }{2} & =-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} & =\\frac{{\\pi }^{2}}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342573/field-2" "q-342573/field-3" "q-342573/field-4"] :db/ensure [:question/validate]} {:db/id "q-343364/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "a44c3de8-d9f4-5306-821e-984424e29656" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-343364/field-1" :answer-field/id #uuid "dcc5035f-47c5-5c93-8144-85c39150c976" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-343364/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-343364/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-343364" :question/id #uuid "7b2281ce-81e7-5f3f-9c3a-4eb1fa35ab9b" :question/math-academy-id "q-343364" :question/problem "$$\nF(x)={\\begin{aligned}{e}^{x+2}, & x\\in [-2,0) \\\\ 1, & x\\in [0,2)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ converges when $x=-2.$\n\nThe Fourier series converges to {{field-1}} when $x=-2.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $4$-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=-2.$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}(-2) & ={lim}_{x\\to -{2}^{-}}f(x)=1 \\\\ {f}^{+}(-2) & ={lim}_{x\\to -{2}^{+}}f(x)={e}^{-2+2}=1\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}(-2)+{f}^{+}(-2)}{2}=\\frac{1+1}{2}=1.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-343364/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5f9dcbb0-d943-5340-916e-d789b6ab03bc"] :knowledge-point/questions ["q-343364"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343438/field-1/f059da041eb9c10af5c202e3f23518c1e88e6519cb516e4f5c2cc5a22f2b8121" :answer/id #uuid "20d416d2-a526-5cf0-a6a6-745707cbc6c7" :answer/type :answer.type/math :answer/value "(-1)^{n}" :db/ensure [:answer/validate]} {:db/id "q-343438/field-1/6176e2b047be2fa55f356f4eb746238d6c1d1572019aff3fe49b618179d289cd" :answer/id #uuid "f9dad747-96ca-514f-8b9f-24114f85a304" :answer/type :answer.type/math :answer/value "(-1)^{n+1}" :db/ensure [:answer/validate]} {:db/id "q-343438/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "245e99ae-e6e7-56e0-9a04-9df79033ba42" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-343438/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "070e6852-5dc1-5ba4-8736-fcf652de2070" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-343438/field-1" :answer-field/id #uuid "bd80b836-6439-51b7-944a-b2b92f850106" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-343438/field-1/f059da041eb9c10af5c202e3f23518c1e88e6519cb516e4f5c2cc5a22f2b8121" :answer-field/choices ["q-343438/field-1/f059da041eb9c10af5c202e3f23518c1e88e6519cb516e4f5c2cc5a22f2b8121" "q-343438/field-1/6176e2b047be2fa55f356f4eb746238d6c1d1572019aff3fe49b618179d289cd" "q-343438/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-343438/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-343438/field-2/f6827777da56db4bd58931c1c2eeb6c100de3d85bc42415c024f44e98b718fe9" :answer/id #uuid "af5d4d08-c666-57