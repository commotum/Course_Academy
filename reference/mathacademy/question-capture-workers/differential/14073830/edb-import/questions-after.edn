#{[{:db/id #edb/ref 17592186167230 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f9dcbb0-d943-5340-916e-d789b6ab03bc" :knowledge-point/title "Identifying the Value to What a Fourier Series Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4bc5c1b-f7bf-54e8-98d1-c97f6a17b100" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186380501}] :answer-field/correct {:answer/id #uuid "e4bc5c1b-f7bf-54e8-98d1-c97f6a17b100" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186380501} :answer-field/id #uuid "d3ff6b30-c87d-59df-b5b1-aaa8915dc7f0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186164946}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "66845167-3565-541d-84d8-7b2d1bbcac26" :question/math-academy-id "q-342496" :question/problem "$$\nF(x)={\\begin{aligned}{x}^{2}, & x\\in [-3,0] \\\\ -{x}^{2}, & x\\in (0,3)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $6$-periodic extension $f(x)$ of $F(x)$ is converging when $x=2.$\n\nThe Fourier series converges to {{field-1}} when $x=2.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{-}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $6$-periodic extension $f(x)$ of our function $F(x)$ is continuous at $x=2.$ \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\nf(2)=-{2}^{2}=-4.\n$$"}] [{:db/id #edb/ref 17592186167233 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f" :knowledge-point/title "Finding the Value of an Infinite Sum Using Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "976835b7-4e61-541a-b16d-51be2f2475d9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186164954} {:answer/id #uuid "9c104bed-2cc8-54e5-aa48-3e0615dc0287" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186164955} {:answer/id #uuid "ada4c9f5-17e4-51bc-8dc3-7394923e449c" :answer/type {:db/ident :answer.type/math} :answer/value "(− 1)^{n}" :db/id #edb/ref 17592186164956} {:answer/id #uuid "33cb762c-0eb9-56ab-b7c7-74e10082e04a" :answer/type {:db/ident :answer.type/math} :answer/value "(− 1)^{n + 1}" :db/id #edb/ref 17592186164957}] :answer-field/correct {:answer/id #uuid "9c104bed-2cc8-54e5-aa48-3e0615dc0287" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186164955} :answer-field/id #uuid "6114d64e-2fda-53d1-8583-3c7822670a6b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186164953} {:answer-field/choices [{:answer/id #uuid "ee29e778-46aa-5082-873a-e9034ca95ca5" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186380503} {:answer/id #uuid "e2e17038-1196-5d09-a74e-8b4578e91378" :answer/type {:db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186380504}] :answer-field/correct {:answer/id #uuid "ee29e778-46aa-5082-873a-e9034ca95ca5" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186380503} :answer-field/id #uuid "98eeca51-e29e-584b-b8f9-22358b3b8f59" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380502} {:answer-field/choices [{:answer/id #uuid "c906292b-48cc-50b9-b3ca-4541c22bb9d1" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186380506} {:answer/id #uuid "390e8907-4438-5502-9451-de61c691bd4b" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380507} {:answer/id #uuid "7b55e1b4-d6b6-5c9e-b043-2a50bc093f6c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186380508}] :answer-field/correct {:answer/id #uuid "7b55e1b4-d6b6-5c9e-b043-2a50bc093f6c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186380508} :answer-field/id #uuid "ccb9d57a-2814-5951-b3a3-8929d965ba3e" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380505} {:answer-field/choices [{:answer/id #uuid "b2b97a73-db61-5027-ac79-6bfa3840c6e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186380510} {:answer/id #uuid "a54094c8-89f2-5a4e-8c23-bba0577ebd08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186380511} {:answer/id #uuid "8d873ddc-998c-594e-a00a-8fc7f3b6b072" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186380512} {:answer/id #uuid "da75184e-3365-5f84-978a-7ed0c3ed7e1d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186380513}] :answer-field/correct {:answer/id #uuid "b2b97a73-db61-5027-ac79-6bfa3840c6e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186380510} :answer-field/id #uuid "5b420089-df9a-52d9-b572-03ed13d5ccb7" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380509}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f28129a8-5e3e-5ca3-8128-6017fbcdb672" :question/math-academy-id "q-342573" :question/problem "Consider the function $F(x)=|x|$ defined on $x\\in [-\\pi ,\\pi ).$ The Fourier series of the $2\\pi $-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼\\frac{\\pi }{2}-{\\sum }_{n=1}^{\\infty }\\frac{4}{\\pi (2n-1)^{2}}\\operatorname{cos}⁡((2n-1)x).\n$$\n\nSelect the correct options in the reasoning below.At $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡((2n-1)\\cdot 0)={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼\\frac{\\pi }{2}-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡((2n-1)x).\n$$\n\nNow, notice that at $x=0,$ we have\n\n$$\n\\operatorname{cos}⁡((2n-1)\\cdot 0)=\\operatorname{cos}⁡(0)=1.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=0,$ the corresponding Fourier series converges to \n\n$$\nf(0)=0.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(0) & =\\frac{\\pi }{2}-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot \\operatorname{cos}⁡((2n-1)\\cdot 0) \\\\ 0 & =\\frac{\\pi }{2}-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}}\\cdot 1 \\\\ -\\frac{\\pi }{2} & =-\\frac{4}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{1}{(2n-1)^{2}} & =\\frac{{\\pi }^{2}}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186380514 :knowledge-point/_questions [{:knowledge-point/id #uuid "5f9dcbb0-d943-5340-916e-d789b6ab03bc" :knowledge-point/title "Identifying the Value to What a Fourier Series Converges"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a44c3de8-d9f4-5306-821e-984424e29656" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380516}] :answer-field/correct {:answer/id #uuid "a44c3de8-d9f4-5306-821e-984424e29656" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380516} :answer-field/id #uuid "dcc5035f-47c5-5c93-8144-85c39150c976" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186380515}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7b2281ce-81e7-5f3f-9c3a-4eb1fa35ab9b" :question/math-academy-id "q-343364" :question/problem "$$\nF(x)={\\begin{aligned}{e}^{x+2}, & x\\in [-2,0) \\\\ 1, & x\\in [0,2)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. Find the value to which the Fourier series of the $4$-periodic extension $f(x)$ of $F(x)$ converges when $x=-2.$\n\nThe Fourier series converges to {{field-1}} when $x=-2.$" :question/worked-solution "Suppose that $f(x)$ is a $2L$-periodic piecewise smooth function with the corresponding Fourier series\n\n$$\nS(x)=\\frac{{a}_{0}}{2}+{\\sum }_{n=1}^{\\infty }{a}_{n}\\operatorname{cos}⁡(\\frac{n\\pi }{L}x)+{b}_{n}\\operatorname{sin}⁡(\\frac{n\\pi }{L}x).\n$$\n\nThen, the series converges for all $x\\in R.$\n\n- If $f(x)$ is continuous at $x,$ then the series converges to the value of the function at this point:\n\n$$\nS(x)=f(x)\n$$\n\n- If $f(x)$ has a jump discontinuity at $x,$ then the series converges to the midpoint between the values of left- and right-sided limits of the function at this point:\n\n$$\nS(x)=\\frac{{f}^{-}(x)+{f}^{+}(x)}{2}\n$$\n\nwhere ${f}^{-}(x)$ and ${f}^{+}(x)$ are the left- and right-sided limits of the function at this point, respectively.\n\nNotice that the $4$-periodic extension $f(x)$ of our function $F(x)$ is not continuous at $x=-2.$ The one-sided limits at this point are the following:\n\n$$\n\\begin{aligned}{f}^{-}(-2) & ={lim}_{x\\to -{2}^{-}}f(x)=1 \\\\ {f}^{+}(-2) & ={lim}_{x\\to -{2}^{+}}f(x)={e}^{-2+2}=1\\end{aligned}\n$$\n\n \n\nTherefore, the Fourier series of $f(x)$ converges to \n\n$$\n\\frac{{f}^{-}(-2)+{f}^{+}(-2)}{2}=\\frac{1+1}{2}=1.\n$$"}] [{:db/id #edb/ref 17592186380517 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f" :knowledge-point/title "Finding the Value of an Infinite Sum Using Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9dad747-96ca-514f-8b9f-24114f85a304" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186380519} {:answer/id #uuid "245e99ae-e6e7-56e0-9a04-9df79033ba42" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380520} {:answer/id #uuid "070e6852-5dc1-5ba4-8736-fcf652de2070" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186380521} {:answer/id #uuid "20d416d2-a526-5cf0-a6a6-745707cbc6c7" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186380522}] :answer-field/correct {:answer/id #uuid "20d416d2-a526-5cf0-a6a6-745707cbc6c7" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186380522} :answer-field/id #uuid "bd80b836-6439-51b7-944a-b2b92f850106" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380518} {:answer-field/choices [{:answer/id #uuid "af5d4d08-c666-57b5-b355-2343c51ff54a" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186380524} {:answer/id #uuid "a8fbca45-17e5-580b-b9be-2237d666d59d" :answer/type {:db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186380525}] :answer-field/correct {:answer/id #uuid "af5d4d08-c666-57b5-b355-2343c51ff54a" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186380524} :answer-field/id #uuid "e952728b-84ce-54a8-9345-4dab0223453d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380523} {:answer-field/choices [{:answer/id #uuid "f2c41706-4190-5d6a-a642-d65eaf13fb19" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186380527} {:answer/id #uuid "a78ef87e-b8eb-5605-9ad8-2408765c2be3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380528} {:answer/id #uuid "bbafc314-7425-5afd-bf39-fc8a8d970eb3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186380529}] :answer-field/correct {:answer/id #uuid "bbafc314-7425-5afd-bf39-fc8a8d970eb3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186380529} :answer-field/id #uuid "d92fbd7e-1f89-558d-9bff-5ece3b7794a1" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380526} {:answer-field/choices [{:answer/id #uuid "8036de92-27b0-5ea6-a67b-a3074c6b8676" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{8}" :db/id #edb/ref 17592186380531} {:answer/id #uuid "8fd5fc4c-00bb-5104-b16e-f3a425e13ea8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{2}" :db/id #edb/ref 17592186380532} {:answer/id #uuid "3ecfeeab-0721-5af7-859c-cf42f9ca71cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186380533} {:answer/id #uuid "078e532d-5c76-54bf-90c5-ee0c0d2d9e74" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{4}" :db/id #edb/ref 17592186380534}] :answer-field/correct {:answer/id #uuid "3ecfeeab-0721-5af7-859c-cf42f9ca71cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{4}" :db/id #edb/ref 17592186380533} :answer-field/id #uuid "5abe87d6-e5f1-5f0a-acc7-8dc5b75242b0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380530}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3ea02f42-e1ec-509f-a6b0-19fd2f4064ef" :question/math-academy-id "q-343438" :question/problem "$$\nF(x)={\\begin{aligned}-1, & x\\in [-4,0] \\\\ 3, & x\\in (0,4)\\end{aligned}\n$$\n\nConsider the function $F(x)$ shown above. The Fourier series of the $8$-periodic extension $f(x)$ of $F(x)$ is given by\n\n$$\nf(x)∼1+{\\sum }_{n=1}^{\\infty }\\frac{8}{\\pi (2n-1)}sin\\,(\\frac{(2n-1)\\pi x}{4}).\n$$\n\nSelect the correct options in the reasoning below.At $x=-2,$ we have\n\n$$\nsin\\,(\\frac{(2n-1)\\pi \\cdot (-2)}{4})={{field-1}}.\n$$\n\nSince $f(x)$ is \n{{field-2}}\nat $x=-2,$ the corresponding Fourier series converges to \n\n$$\nf(-2)={{field-3}}.\n$$\n\nTherefore, we have \n\n$$\n{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1}={{field-4}}.\n$$" :question/worked-solution "First, we rewrite our Fourier series as\n\n$$\nf(x)∼1+\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,(\\frac{(2n-1)\\pi x}{4}).\n$$\n\nNow, notice that at $x=-2,$ we have\n\n$$\nsin\\,(\\frac{(2n-1)\\pi \\cdot (-2)}{4})=sin\\,(\\frac{\\pi }{2}-n\\pi )=(-1)^{n}.\n$$\n\nSince $f(x)$ is $\\text{continuous}$ at $x=-2,$ the corresponding Fourier series converges to \n\n$$\nf(-2)=-1.\n$$\n\n \n\nTherefore, we have \n\n$$\n\\begin{aligned}f(-2) & =1+\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot sin\\,(\\frac{(2n-1)\\pi \\cdot (-2)}{4}) \\\\ -1 & =1+\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{1}{2n-1}\\cdot (-1)^{n} \\\\ -2 & =\\frac{8}{\\pi }{\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n}}{2n-1} & =-\\frac{\\pi }{4} \\\\ {\\sum }_{n=1}^{\\infty }\\frac{(-1)^{n+1}}{2n-1} & =\\frac{\\pi }{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186380535 :knowledge-point/_questions [{:knowledge-point/id #uuid "b3cb7656-1ce6-5b6a-9e88-5ba24a943c3f" :knowledge-point/title "Finding the Value of an Infinite Sum Using Fourier Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7212ebb0-9bdb-5554-a9f0-53784ab3f504" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n+1}" :db/id #edb/ref 17592186380537} {:answer/id #uuid "7049c8c1-f0ca-5fc5-987b-398e48bb6cc9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186380538} {:answer/id #uuid "ab84d80f-9fb5-5bf0-bad6-af7f86d245bf" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186380539} {:answer/id #uuid "84b10521-a354-5405-b57d-788bee05cce4" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186380540}] :answer-field/correct {:answer/id #uuid "84b10521-a354-5405-b57d-788bee05cce4" :answer/type {:db/ident :answer.type/math} :answer/value "(-1)^{n}" :db/id #edb/ref 17592186380540} :answer-field/id #uuid "4e133e87-f017-52dc-8249-d3b200c75006" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380536} {:answer-field/choices [{:answer/id #uuid "8cc6ca6e-7c13-5b58-b96b-e60b97c9b66f" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186380542} {:answer/id #uuid "fc6305b1-67f9-5bb4-9b8c-bd053aa2b3a7" :answer/type {:db/ident :answer.type/text} :answer/value "discontinuous" :db/id #edb/ref 17592186380543}] :answer-field/correct {:answer/id #uuid "8cc6ca6e-7c13-5b58-b96b-e60b97c9b66f" :answer/type {:db/ident :answer.type/text} :answer/value "continuous" :db/id #edb/ref 17592186380542} :answer-field/id #uuid "b608e662-f2b5-592f-8bab-fd6a05c43b66" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186380541} {:answer-field/choices [{:answer/id #uuid "3b65f8af-e542-57b8-b515-0768a23