ase is\n\n$$\ny=A{e}^{3x}+4{e}^{5x}.\n$$" 13194139534659 true] [17592186302001 1000 #edb/ref 17592186302002 13194139534659 true] [17592186302001 1040 #edb/ref 17592186045449 13194139534659 true] [17592186302001 1041 "field-1" 13194139534659 true] [17592186302001 1104 #edb/ref 17592186302002 13194139534659 true] [17592186302001 1110 #uuid "21bb9839-7c25-55da-ba9e-228cc7a50fda" 13194139534659 true] [17592186302002 1034 "Ae^{3x}+4e^{5x}" 13194139534659 true] [17592186302002 1103 #edb/ref 17592186045453 13194139534659 true] [17592186302002 1111 #uuid "4f4c664e-62eb-5ba6-a917-29cea6952ac1" 13194139534659 true]] :edb/tempids {"q-332655" 17592186301935 "q-332655/field-1" 17592186301936 "q-332655/field-1/9b7914b1b710e5261a78276d259d6d5990c75f13add52397e593f16fd83cd321" 17592186301937 "q-332655/field-1/c5ef0395c08b7b9e6b06b02c5626c30efa64ea2ac9cacbc8f9e0695e54e630cd" 17592186301938 "q-332664" 17592186301939 "q-332664/field-1" 17592186301940 "q-332664/field-1/89939416e86af27a29df0fe0c1e092b12510a681ba9fdec636c67b16e3ff8a1f" 17592186301941 "q-332667" 17592186301942 "q-332667/field-1" 17592186301943 "q-332667/field-1/1bbff932e4d6ca51ba86fbc43467605c960ba98f5d592b47c913a79a38439129" 17592186301944 "q-332667/field-1/ba2411b10fe7a77240900d5b9772094f8529d4fe4e9d391c515fb49d7ba38793" 17592186301945 "q-332668" 17592186301946 "q-332668/field-1" 17592186301947 "q-332668/field-1/677fedcb7ada2980240a7c168360e511e3c3dd6c0bbccb00a147f78a9fbe9309" 17592186301948 "q-332670" 17592186301949 "q-332670/field-1" 17592186301950 "q-332670/field-1/c00193e1c5a8559f3d732e7bd5fb84cc39a25744fb10bd07f489533917ea407a" 17592186301951 "q-332728" 17592186301952 "q-332728/field-1" 17592186301953 "q-332728/field-1/2dd145634d5b4fcd6d99f8608abf9f2f545a61864ea3413937883d5ae132d10d" 17592186301954 "q-332730" 17592186301955 "q-332730/field-1" 17592186301956 "q-332730/field-1/5a8ebc3aa4bb665a96d233cdea128d1455ea68c0c10d24c11e2e7290b7d4c7fb" 17592186301957 "q-332731" 17592186301958 "q-332731/field-1" 17592186301959 "