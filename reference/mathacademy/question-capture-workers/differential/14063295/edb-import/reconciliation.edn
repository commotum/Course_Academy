mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-31400" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{4}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-31400" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{ln}⁡x{log}_{2}^{2}⁡({x}^{2})}{2}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-31400" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-346435" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡2$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-346435" "field" nil "attribute" "question/worked-solution" "value" "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $32$ |\n| --- | --- | --- |\n| $u$ | $2$ | $5$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x & ={\\int }_{4}^{32}\\frac{1}{\\sqrt{{log}_{2}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot 2\\sqrt{u}\\,{|}_{2}^{5} \\\\  & =(2\\sqrt{5}-2\\sqrt{2})\\operatorname{ln}⁡2\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-346435" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/activity-metadata.json" "file_sha256" "222fe31908a93b53786ab4aa511ab10b01045386db1a176ffaba2a0d129ce6d5" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-346435" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-346435" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\sqrt{5}-2\\sqrt{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/state.json" "file_sha256" "e0fe9e8494485603aa2f1a0d0e2a29d59ad83a7b6f14b22479a6b3e533506f8e" "basis" 1138 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009028/edb-import/verification.json"} {"question" "q-13837" "field" nil "attribute" "question/problem" "value" "What is the value of ${\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/state.json" "file_sha256" "a327107e917adda7c7748e617fca468d99eec5fb29bfa4fe429923a8398cafeb" "basis" 1193 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/edb-import/verification.json"} {"question" "q-13837" "field" nil "attribute" "question/worked-solution" "value" "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{2}{3}{\\int }_{0}^{2}u\\,\\text{d}u \\\\  & =\\frac{2}{3}\\cdot {\\frac{{u}^{2}}{2}|}_{0}^{2} \\\\  & ={\\frac{{u}^{2}}{3}|}_{0}^{2} \\\\  & =\\frac{{2}^{2}}{3}-\\frac{{0}^{2}}{3} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/state.json" "file_sha256" "a327107e917adda7c7748e617fca468d99eec5fb29bfa4fe429923a8398cafeb" "basis" 1193 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/edb-import/verification.json"} {"question" "q-13837" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/activity-metadata.json" "file_sha256" "04d4bd8d8457e7f0bda96f3b9dd270f7d5fcd27a8ef6617ca039f8939171431e" "basis" 1193 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/edb-import/verification.json"} {"question" "q-13837" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/state.json" "file_sha256" "a327107e917adda7c7748e617fca468d99eec5fb29bfa4fe429923a8398cafeb" "basis" 1193 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/edb-import/verification.json"} {"question" "q-13837" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-\\frac{4}{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/state.json" "file_sha256" "a327107e917adda7c7748e617fca468d99eec5fb29bfa4fe429923a8398cafeb" "basis" 1193 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14028699/edb-import/verification.json"} {"question" "q-13837" "field" "selection"