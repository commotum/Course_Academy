aaa6fab50978" "q-210752/selection/454bbd59bc4f3489eacd761fe59d523cba4cad746751813ca2982eed04457f94"] :db/ensure [:answer-field/validate]} {:db/id "q-210752" :question/id #uuid "656945ec-8d60-5e56-9c1e-fa4289291150" :question/math-academy-id "q-210752" :question/problem "$\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-210752/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6"] :knowledge-point/questions ["q-210752"] :db/ensure [:knowledge-point/validate]}]
