#{[{:db/id #edb/ref 17592186292380 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a2f1a4-070e-5df9-bc96-f9a4de74982d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292382} {:answer/id #uuid "319ec15c-ba68-5e46-9aaf-8ac3f4fab1e5" :answer/type {:db/ident :answer.type/math} :answer/value "4\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292383} {:answer/id #uuid "0af5c69f-4a32-5280-8629-56cf6cc6a40e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}⁡x+C" :db/id #edb/ref 17592186292384} {:answer/id #uuid "4564c6d0-559d-5e06-9ade-60604719e2da" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{2}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292385} {:answer/id #uuid "09910614-5f8e-57ca-b9bb-cdbbdc063de9" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡7\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292386}] :answer-field/correct {:answer/id #uuid "15a2f1a4-070e-5df9-bc96-f9a4de74982d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C" :db/id #edb/ref 17592186292382} :answer-field/id #uuid "cd76030c-9865-5c76-b381-8194bd798e5f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292381}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8ffcfa20-542a-5da6-b7ce-c73215ba6769" :question/math-academy-id "q-114021" :question/problem "$\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{7}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡7}\\,⟹\\,\\operatorname{ln}⁡7\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{7}⁡x}{2x}\\,\\text{d}x & =\\frac{1}{2}\\int {log}_{7}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{1}{2}\\int u\\cdot \\operatorname{ln}⁡7\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡7}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡7}{4}\\cdot {log}_{7}^{2}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292387 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ebb5c01-1c79-5691-a284-503b3a980104" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186292389} {:answer/id #uuid "01c32cb9-2ad9-50ca-a5c5-dca250f86cc1" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186292390} {:answer/id #uuid "4bcdf51d-9dea-5c4d-ad01-2bf5eed3179e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186292391} {:answer/id #uuid "69c99b6a-6c0f-5f8c-9951-8a54dff3d90d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186292392} {:answer/id #uuid "e756493d-3c8c-57d8-90e1-be36dd1d5835" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186292393}] :answer-field/correct {:answer/id #uuid "2ebb5c01-1c79-5691-a284-503b3a980104" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186292389} :answer-field/id #uuid "e9ffbbfe-9f09-5e1b-bc61-14e3d7d23971" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292388}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a6c4fb19-6c0b-5ad6-b5c2-399285a74805" :question/math-academy-id "q-13837" :question/problem "What is the value of ${\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x?$" :question/worked-solution "Let's set $u=\\operatorname{ln}⁡x.$ Then, we have\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x}\\,⟹\\,\\text{d}u=\\frac{1}{x}\\,\\text{d}x.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $1$ | ${e}^{2}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $2$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{{e}^{2}}\\frac{2\\operatorname{ln}⁡x}{3x}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{1}^{{e}^{2}}\\operatorname{ln}⁡x\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\frac{2}{3}{\\int }_{0}^{2}u\\,\\text{d}u \\\\  & =\\frac{2}{3}\\cdot {\\frac{{u}^{2}}{2}|}_{0}^{2} \\\\  & ={\\frac{{u}^{2}}{3}|}_{0}^{2} \\\\  & =\\frac{{2}^{2}}{3}-\\frac{{0}^{2}}{3} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345192 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b9875952-5819-5653-8a69-a3790d12b8e2" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡{x}^{2}|+C" :db/id #edb/ref 17592186345194} {:answer/id #uuid "cf523bc9-cfca-5df0-bfcf-9c41ae8e3191" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186345195} {:answer/id #uuid "8eefc8a2-3eea-582c-b794-91a6c758562b" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2+\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186345196} {:answer/id #uuid "bd164901-8cc3-553d-9ef5-ad9e061e9d57" :answer/type {:db/ident :answer.type/math} :answer/value "{ln}^{2}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186345197} {:answer/id #uuid "c1f249d0-a998-576d-9006-869cb1bf1860" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186345198}] :answer-field/correct {:answer/id #uuid "c1f249d0-a998-576d-9006-869cb1bf1860" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C" :db/id #edb/ref 17592186345198} :answer-field/id #uuid "3a13f84f-a369-596c-9576-97d2ed4ffff0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345193}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "656945ec-8d60-5e56-9c1e-fa4289291150" :question/math-academy-id "q-210752" :question/problem "$\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\,\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{x{log}_{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{log}_{2}⁡x}\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int \\frac{1}{u}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡2\\operatorname{ln}⁡|{log}_{2}⁡x|+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288938 :knowledge-point/_questions [{:knowledge-point/id #uuid "fa28f5c4-135e-576a-baa0-68c41b5139f6" :knowledge-point/title "Integrating Functions Containing Other Logarithms"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecf8598e-6eea-5703-9c31-ff8196baf45d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡x{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288940} {:answer/id #uuid "243a3bd8-64e9-5a14-82ca-22d97fda1b37" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288941} {:answer/id #uuid "e2247c3f-e755-57a0-ae66-bfdfc706cc1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288942} {:answer/id #uuid "fae7eb33-6046-5f29-b1b7-5e65446b8fad" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{2}+C" :db/id #edb/ref 17592186288943} {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944}] :answer-field/correct {:answer/id #uuid "48938fcd-ea07-58eb-956b-7b982f09e7b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C" :db/id #edb/ref 17592186288944} :answer-field/id #uuid "ac3879c7-cbb1-5376-b8fc-d1131727dee1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186288939}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3c53474e-e877-5764-b2e1-1623184bc76e" :question/math-academy-id "q-31400" :question/problem "$\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x=$" :question/worked-solution "Let $u={log}_{2}⁡({x}^{2}).$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{2}{x\\operatorname{ln}⁡2}\\,⟹\\,\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{{log}_{2}⁡({x}^{2})}{x}\\,\\text{d}x & =\\int {log}_{2}⁡({x}^{2})\\cdot \\frac{\\text{d}x}{x} \\\\  & =\\int u\\cdot (\\frac{\\operatorname{ln}⁡2}{2}\\text{d}u) \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\int u\\,\\text{d}u \\\\  & =\\frac{\\operatorname{ln}⁡2}{2}\\cdot \\frac{{u}^{2}}{2}+C \\\\  & =\\frac{\\operatorname{ln}⁡2{log}_{2}^{2}⁡({x}^{2})}{4}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186288948 :knowledge-point/_questions [{:knowledge-point/id #uuid "37a7aff6-d1b2-5383-bb26-aa6363594b05" :knowledge-point/title "Evaluating Definite Integrals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91355321-4aaa-5827-b25a-f768637dd369" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}-2\\sqrt{2}" :db/id #edb/ref 17592186288950}] :answer-field/correct {:answer/id #uuid "91355321-4aaa-5827-b25a-f768637dd369" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}-2\\sqrt{2}" :db/id #edb/ref 17592186288950} :answer-field/id #uuid "e5a5ec03-5b0e-5ce0-ae81-bcd6e12d0f3e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186288949}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9fec3228-1358-581c-bfd2-8d4b419af6b7" :question/math-academy-id "q-346435" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x=($\n{{field-1}}\n$)\\operatorname{ln}⁡2$" :question/worked-solution "Let $u={log}_{2}⁡x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡2}\\,⟹\\,\\operatorname{ln}⁡2\\cdot \\text{d}u=\\frac{\\text{d}x}{x}.\n$$\n\nCalculating the limits for $u$ gives the following:\n\n| $x$ | $4$ | $32$ |\n| --- | --- | --- |\n| $u$ | $2$ | $5$ |\n\nWe now substitute and evaluate as follows:\n\n$$\n\\begin{aligned}{\\int }_{4}^{32}\\frac{1}{x\\sqrt{{log}_{2}⁡x}}\\,\\text{d}x & ={\\int }_{4}^{32}\\frac{1}{\\sqrt{{log}_{2}⁡x}}\\cdot \\frac{\\text{d}x}{x} \\\\  & ={\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\cdot \\operatorname{ln}⁡2\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2{\\int }_{2}^{5}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡2\\cdot 2\\sqrt{u}\\,{|}_{2}^{5} \\\\  & =(2\\sqrt{5}-2\\sqrt{2})\\operatorname{ln}⁡2\\end{aligned}\n$$"}]}
