db/id #edb/ref 17592186361985} :answer-field/id #uuid "69c1c693-2b89-5ea7-bb48-dd83455facbe" :answer-field/key "field-7" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186361981} {:answer-field/choices [{:answer/id #uuid "2463d566-0ae6-59df-823c-21036a117464" :answer/type {:db/ident :answer.type/text} :answer/value "infinity" :db/id #edb/ref 17592186361987} {:answer/id #uuid "78d01102-7a41-5fda-a86b-cd2c7e793157" :answer/type {:db/ident :answer.type/text} :answer/value "the origin" :db/id #edb/ref 17592186361988}] :answer-field/correct {:answer/id #uuid "78d01102-7a41-5fda-a86b-cd2c7e793157" :answer/type {:db/ident :answer.type/text} :answer/value "the origin" :db/id #edb/ref 17592186361988} :answer-field/id #uuid "ffec3db1-d9fe-5af9-975b-eb2139dca750" :answer-field/key "field-8" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186361986} {:answer-field/choices [{:answer/id #uuid "49a3e854-3ade-5bd9-a37d-1d39813f7618" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }_{1}=-1" :db/id #edb/ref 17592186361990} {:answer/id #uuid "a280649b-146f-58da-a5a4-52457df740a7" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }_{2}=-3" :db/id #edb/ref 17592186361991}] :answer-field/correct {:answer/id #uuid "49a3e854-3ade-5bd9-a37d-1d39813f7618" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }_{1}=-1" :db/id #edb/ref 17592186361990} :answer-field/id #uuid "304ba86e-e293-534c-a837-70b208ca8b29" :answer-field/key "field-9" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186361989}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6f3307c5-d585-5fa2-81f6-a2c996b7b9d1" :question/math-academy-id "q-333159" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-3x(t)-2y(t) \\\\ {y}^{′}(t)=-y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=-1$ and ${\\lambda }_{2}=-3,$ for which the corresponding eigenvectors are ${v}_{1}=[1,-1]^{T}$ and ${v}_{2}=[1,0]^{T},$ respectively. Select the correct options in the reasoning below.The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}\\cdot {{field-1}}[\\begin{aligned}1 \\\\ -1\\end{aligned}]+{c}_{2}\\cdot {{field-2}}[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ has the equation \n\n$$\ny={{field-3}}\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-t}[\\begin{aligned}1 \\\\ -1\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-t}\\to $ \n{{field-4}}\nas $t\\to \\infty ,$ these solutions approach \n{{field-5}} \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/44d0f3d13ca03a0644b2f28df9200cd521b7b44d625f346e981d2a54165284f5.png)\n\nThe line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ has the equation \n\n$$\ny={{field-6}}\n$$\n\nand the straight-line solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on that line.\n\nSince ${e}^{-3t}\\to $ \n{{field-7}}\nas $t\\to \\infty ,$ these solutions approach \n{{field-8}} \nas $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/6a4c15275ba80d01a90b2e010ed95e95f9a75cfa13f8e51db3433f6356949057.png)\n\nFinally, since the dominant eigenvalue is \n{{field-9}},\nsolutions become parallel to the straight-line solution containing the vector \n{{field-10}} \nas they move towards the origin.\n\nThe phase portrait of our system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/f838a055e525a264bf36b8e0478d186fe17753bba8c0088fea01ac7c5c1f8d7a.png)" :question/worked-solution "The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{-t}[\\begin{aligned}1 \\\\ -1\\end{aligned}]+{c}_{2}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\nThe line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}1 \\\\ -1\\end{aligned}]$ has the equation \n\n$$\ny=-x\n$$\n\nand the straight-line solutions of the form\n${c}_{1}{e}^{-t}[\\begin{aligned}1 \\\\ -1\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/44d0f3d13ca03a0644b2f28df9200cd521b7b44d625f346e981d2a54165284f5.png)\n\nThe line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}1 \\\\ 0\\end{aligned}]$ has the equation \n\n$$\ny=0\n$$\n\nand the straight-line solutions of the form\n${c}_{2}{e}^{-3t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]$\nlie on that line. \n\nSince ${e}^{-3t}\\to 0$ as $t\\to \\infty ,$ these solutions approach $\\text{the origin}$ as $t\\to \\infty .$\n\nLet's add the solutions to the phase space.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/6a4c15275ba80d01a90b2e010ed95e95f9a75cfa13f8e51db3433f6356949057.png)\n\nFor this particular system, we have\n\n$$\n{\\lambda }_{2}<{\\lambda }_{1}<0\n$$\n\nthus, ${\\lambda }_{1}=-1$ is the eigenvalue that determines the long-term behavior (dominant eigenvalue).\n\nSince the dominant eigenvalue is ${\\lambda }_{1}=-1,$ solutions become parallel to the straight-line solution containing the vector ${v}_{1}$ as they move towards the origin.\n\nThe phase portrait of our system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/f838a055e525a264bf36b8e0478d186fe17753bba8c0088fea01ac7c5c1f8d7a.png)"}] [{:db/id #edb/ref 17592186361992 :knowledge-point/_questions [{:knowledge-point/id #uuid "13af6d27-628d-5bdb-b396-299d9cfd64e7" :knowledge-point/title "Identifying the Parameters of a System Given Its Phase Portrait"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bea7779-bf35-50cb-b0bc-7fe3b04b00a0" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}x" :db/id #edb/ref 17592186361994} {:answer/id #uuid "d01c3989-618a-5a01-b4c1-cb87d63a3282" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186361995} {:answer/id #uuid "2d6454bf-1f4c-5cf5-a626-2f9cb1ca3190" :answer/type {:db/ident :answer.type/math} :answer/value "-x" :db/id #edb/ref 17592186361996} {:answer/id #uuid "d55a8f6a-fcc3-56f2-94f1-48ea8eeb8a1c" :answer/type {:db/ident :answer.type/math} :answer/value "2x" :db/id #edb/ref 17592186361997}] :answer-field/correct {:answer/id #uuid "d01c3989-618a-5a01-b4c1-cb87d63a3282" :answer/type {:db/ident :answer.type/math} :answer/value "x" :db/id #edb/ref 17592186361995} :answer-field/id #uuid "bf72766f-efb2-56f1-9f62-b5c6eb661494" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/select} :db/id #edb/ref 17592186361993} {:answer-field/choices [{:answer/id #uuid "7f6ac080-89ba-5ecb-aba9-c335afd83346" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }_{2}" :db/id #edb/ref 17592186361999} {:answer/id #uuid "67ffe5fd-f33a-5026-95f5-0b6116b434a3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\lambda }_{1}" :db/id #edb/ref 17592186362000}] :answer-field/correct {:answer/id #uuid "7f6ac080-89ba-5ecb-aba9-c33