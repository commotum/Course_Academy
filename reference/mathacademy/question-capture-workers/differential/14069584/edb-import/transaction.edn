nswer-field/id #uuid "51105570-3dc4-58b4-9edf-e89f7fa80739" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-333640/field-3/4d092fda865cba74a0ab80adb9b5a04b7f2fd55f4b558f785d6f342b479ec0f8" :answer-field/choices ["q-333640/field-3/4d092fda865cba74a0ab80adb9b5a04b7f2fd55f4b558f785d6f342b479ec0f8" "q-333640/field-3/1b60731b1779c600d1abbdb8187409ffe4c69778f0a32954816f2e025ce2725f"] :db/ensure [:answer-field/validate]} {:db/id "q-333640/field-4/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" :answer/id #uuid "5c531624-4f36-546f-817a-e5a72bfe85e5" :answer/type :answer.type/text :answer/value "a stable node (sink)" :db/ensure [:answer/validate]} {:db/id "q-333640/field-4/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" :answer/id #uuid "b3c5b455-1e87-522d-8b04-4bc8dddcf483" :answer/type :answer.type/text :answer/value "a saddle point" :db/ensure [:answer/validate]} {:db/id "q-333640/field-4/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" :answer/id #uuid "741b18ba-c2d1-5870-920a-aeacfe95e609" :answer/type :answer.type/text :answer/value "an unstable node (source)" :db/ensure [:answer/validate]} {:db/id "q-333640/field-4" :answer-field/id #uuid "b02d5dd2-b009-5eea-b7e1-156bf47e9eb0" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-333640/field-4/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" :answer-field/choices ["q-333640/field-4/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" "q-333640/field-4/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" "q-333640/field-4/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc"] :db/ensure [:answer-field/validate]} {:db/id "q-333640" :question/id #uuid "d111108f-9aed-5eb7-8811-2065601ee640" :question/math-academy-id "q-333640" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=2x(t) \\\\ {y}^{′}(t)=x(t)+4y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=2$ and ${\\lambda }_{2}=4,$ for which the corresponding eigenvectors are ${v}_{1}=[-2,\\text{ }1]^{T}$ and ${v}_{2}=[0,\\text{ }1]^{T},$ respectively. Select the correct options below regarding the given system.$\\,$\n$y=-\\frac{1}{2}x$ is {{field-1}} line.\n\n$\\,$\n{{field-2}} is {{field-3}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-4}}." :question/worked-solution "The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{2t}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]+{c}_{2}{e}^{4t}[\\begin{aligned}0 \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\n- The line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=-\\frac{1}{2}x.\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{2t}[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$\nlie on that line and approach infinity as $t\\to \\infty .$ So, $y=-\\frac{1}{2}x$ is $\\text{an unstable}$ line.\n\n- The line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}0 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\nx=0.\n$$\n\nThe straight-line solutions of the form\n${c}_{2}{e}^{4t}[\\begin{aligned}0 \\\\ 1\\end{aligned}]$\nlie on that line and approach infinity as $t\\to \\infty .$ So, $x=0$ is $\\text{an unstable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{an unstable node (source)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/0d9e032bfffa68f487347d6c169999e313247e89ef7de3fae28edb216dcf718f.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333640/field-1" "q-333640/field-2" "q-333640/field-3" "q-333640/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35492718-d2d7-5c9d-9c02-1ef6ae0445d0"] :knowledge-point/questions ["q-333640"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333643/field-1/4d092fda865cba74a0ab80adb9b5a04b7f2fd55f4b558f785d6f342b479ec0f8" :answer/id #uuid "e65349ea-a50f-538e-8cae-b4173969c611" :answer/type :answer.type/text :answer/value "an unstable" :db/ensure [:answer/validate]} {:db/id "q-333643/field-1/1b60731b1779c600d1abbdb8187409ffe4c69778f0a32954816f2e025ce2725f" :answer/id #uuid "8d9e517d-863d-5801-b4bc-23f019691fae" :answer/type :answer.type/text :answer/value "a stable" :db/ensure [:answer/validate]} {:db/id "q-333643/field-1" :answer-field/id #uuid "40274f6b-e58d-578f-8bb3-78c74530963b" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-333643/field-1/4d092fda865cba74a0ab80adb9b5a04b7f2fd55f4b558f785d6f342b479ec0f8" :answer-field/choices ["q-333643/field-1/4d092fda865cba74a0ab80adb9b5a04b7f2fd55f4b558f785d6f342b479ec0f8" "q-333643/field-1/1b60731b1779c600d1abbdb8187409ffe4c69778f0a32954816f2e025ce2725f"] :db/ensure [:answer-field/validate]} {:db/id "q-333643/field-2/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" :answer/id #uuid "95f7264f-2b4b-5294-b6af-32feff1a559a" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "q-333643/field-2/861981e024e897416682817ca9e79c6d1e8ed9b541c7efe134d14879c4bffd37" :answer/id #uuid "1b11aba9-1512-59b2-9c9c-e117f5fa0ad0" :answer/type :answer.type/math :answer/value "y=2x" :db/ensure [:answer/validate]} {:db/id "q-333643/field-2/a20e462a24b2d65cab7429839bc46b524d25f7f1678fb82590234c6d14c4d796" :answer/id #uuid "600d1582-04e7-5df6-8fe6-18200720e9e2" :answer/type :answer.type/math :answer/value "y=x" :db/ensure [:answer/validate]} {:db/id "q-333643/field-2/dd44173d16ac132df1a97f9fe2611d3e6d5e55380c00e64a71bded7896fbc16d" :answer/id #uuid "660433fd-85f0-5a60-9a08-39f8d17df721" :answer/type :answer.type/math 