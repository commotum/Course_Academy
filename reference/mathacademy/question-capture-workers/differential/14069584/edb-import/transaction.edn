5acf73" :answer/type :answer.type/text :answer/value "an unstable node (source)" :db/ensure [:answer/validate]} {:db/id "q-333652/field-4/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" :answer/id #uuid "33e14315-3921-5b2e-9c23-7cade8506488" :answer/type :answer.type/text :answer/value "a stable node (sink)" :db/ensure [:answer/validate]} {:db/id "q-333652/field-4" :answer-field/id #uuid "133e6e83-115c-5056-bca0-04d591148015" :answer-field/key "field-4" :answer-field/type :answer-field.type/select :answer-field/correct "q-333652/field-4/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa" :answer-field/choices ["q-333652/field-4/47b5e16428f6cc903ef4e40f0ded305cf4b2c6071376c9e87a33cc1a98eb9f04" "q-333652/field-4/cef53e2f4f249e823b4999c806f3152f01b5aecabcf33f4f9df9ee55880449dc" "q-333652/field-4/22e8a0aa62bc24395706ed418c76a5ef3df41c0d85ee55b4553fc245a500b4aa"] :db/ensure [:answer-field/validate]} {:db/id "q-333652" :question/id #uuid "5beb3016-3175-5203-9e93-892694f15883" :question/math-academy-id "q-333652" :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-4x(t)+2y(t) \\\\ {y}^{′}(t)=x(t)-5y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=-3$ and ${\\lambda }_{2}=-6,$ for which the corresponding eigenvectors are ${v}_{1}=[2,\\text{ }1]^{T}$ and ${v}_{2}=[-1,\\text{ }1]^{T},$ respectively. Select the correct options below regarding the given system.$\\,$\n$y=\\frac{1}{2}x$ is {{field-1}} line.\n\n$\\,$\n{{field-2}} is {{field-3}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-4}}." :question/worked-solution "The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{-3t}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}{e}^{-6t}[\\begin{aligned}-1 \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\n- The line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=\\frac{1}{2}x.\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{-3t}[\\begin{aligned}2 \\\\ 1\\end{aligned}]$\nlie on that line and approach the origin as as $t\\to \\infty .$ So, $y=\\frac{1}{2}x$ is $\\text{a stable}$ line.\n\n- The line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=-x.\n$$\n\nThe straight-line solutions of the form\n${c}_{2}{e}^{-6t}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$\nlie on that line and approach the origin as as $t\\to \\infty .$ So, $y=-x$ is $\\text{a stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/a21b978aaab9569ae4dcae346116e51b5248fdf8f3cff461411a2140f70a6a4c.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333652/field-1" "q-333652/field-2" "q-333652/field-3" "q-333652/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35492718-d2d7-5c9d-9c02-1ef6ae0445d0"] :knowledge-point/questions ["q-333652"] :db/ensure [:knowledge-point/validate]} {:db/id 17592186164470 :answer-field/correct 17592186164471 :db/ensure [:answer-field/validate]} {:db/id 17592186164465 :answer-field/correct 17592186164468 :db/ensure [:answer-field/validate]} {:db/id 17592186164473 :answer-field/correct 17592186164474 :db/ensure [:answer-field/validate]} {:db/id 17592186164461 :answer-field/correct 17592186164464 :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-333646"] :question/problem "$$\n{\\begin{aligned}{x}^{′}(t)=-3x(t)-2y(t) \\\\ {y}^{′}(t)=-x(t)-2y(t)\\end{aligned}\n$$\n\nConsider the system of linear differential equations above. The eigenvalues of the system's matrix are ${\\lambda }_{1}=-4$ and ${\\lambda }_{2}=-1,$ for which the corresponding eigenvectors are ${v}_{1}=[2,\\text{ }1]^{T}$ and ${v}_{2}=[-1,\\text{ }1]^{T},$ respectively. Select the correct options below regarding the given system.$\\,$\n$y=\\frac{1}{2}x$ is {{field-1}} line.\n\n$\\,$\n{{field-2}} is {{field-3}} line.\n\n$\\,$\nThe equilibrium point (origin) is {{field-4}}." :question/worked-solution "The general solution of the system is\n\n$$\n[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]={c}_{1}{e}^{-4t}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}{e}^{-t}[\\begin{aligned}-1 \\\\ 1\\end{aligned}],\\,{c}_{1},{c}_{2}\\in R.\n$$\n\n- The line that passes through the origin and is parallel to ${v}_{1}=[\\begin{aligned}2 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=\\frac{1}{2}x.\n$$\n\nThe straight-line solutions of the form\n${c}_{1}{e}^{-4t}[\\begin{aligned}2 \\\\ 1\\end{aligned}]$\nlie on that line and approach the origin as $t\\to \\infty .$ So, $y=\\frac{1}{2}x$ is $\\text{a stable}$ line.\n\n- The line that passes through the origin and is parallel to ${v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$ has the equation \n\n$$\ny=-x.\n$$\n\nThe straight-line solutions of the form\n${c}_{2}{e}^{-t}[\\begin{aligned}-1 \\\\ 1\\end{aligned}]$\nlie on that line and approach the origin as $t\\to \\infty .$ So, $y=-x$ is $\\text{a stable}$ line.\n\nTherefore, the equilibrium point (origin) is $\\text{a stable node (sink)}.$ \n\n**Note:** The phase portrait of the system looks as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14069584/assets/6337a670b6fa73c4c21759b600269cb83d808a1c13026c90e2d02519fa31cd67.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-333637/field-1/a20e462a24b2d65cab7429839bc46b524d25f7f1678fb82590234c6d14c4d796" :answer/id #uuid "bbdc1dd6-0ea9-5d8f-a55b-1af1493d2930" :answer/type :answer.type/math :answer/value "y=x" :db/ensure [:answer/validate]} {:db/id "