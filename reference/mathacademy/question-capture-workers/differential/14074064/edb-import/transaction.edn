}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-3 \\\\ 2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}{{field-1}}={{field-2}} \\\\ {{field-3}}=-3{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{2{x}_{1}(t)+{x}_{2}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{-3{x}_{1}(t)+4{x}_{2}(t)}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=2L{{x}_{1}(t)}+L{{x}_{2}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=-3L{{x}_{1}(t)}+4L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)+3=2{X}_{1}(s)+{X}_{2}(s) \\\\ s{X}_{2}(s)-2=-3{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331905/field-1" "q-331905/field-2" "q-331905/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd7b8fc8-26d3-5551-9a46-45725bd863a6"] :knowledge-point/questions ["q-331905"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331908/field-1/e55227913973cb367b9301d449c57087e181bfceb81b9bf9e23f2a903b98226c" :answer/id #uuid "b8010250-89a4-5abd-af3c-f68b90917ccd" :answer/type :answer.type/math :answer/value "\\frac{2}{s-2}" :db/ensure [:answer/validate]} {:db/id "q-331908/field-1" :answer-field/id #uuid "bad8a7d4-fe73-5b52-98d7-c91770460eea" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331908/field-1/e55227913973cb367b9301d449c57087e181bfceb81b9bf9e23f2a903b98226c" :answer-field/choices ["q-331908/field-1/e55227913973cb367b9301d449c57087e181bfceb81b9bf9e23f2a903b98226c"] :db/ensure [:answer-field/validate]} {:db/id "q-331908/field-2/2c75e970a20fb5bc3be9b294b361aefc7456a2db3d6ffca23ef5fe160df5d9ff" :answer/id #uuid "edc7accc-bae4-5d5a-879e-882410e23b5a" :answer/type :answer.type/math :answer/value "\\frac{8-s}{(s-2)(s-4)}" :db/ensure [:answer/validate]} {:db/id "q-331908/field-2" :answer-field/id #uuid "fbffcf57-1348-5f5b-a97d-93886b990c84" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331908/field-2/2c75e970a20fb5bc3be9b294b361aefc7456a2db3d6ffca23ef5fe160df5d9ff" :answer-field/choices ["q-331908/field-2/2c75e970a20fb5bc3be9b294b361aefc7456a2db3d6ffca23ef5fe160df5d9ff"] :db/ensure [:answer-field/validate]} {:db/id "q-331908" :question/id #uuid "b02012b6-0569-5174-914a-f61b8e20f9c7" :question/math-academy-id "q-331908" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=3{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=$ {{field-2}}." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{2{x}_{1}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{3{x}_{1}(t)+4{x}_{2}(t)}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=2L{{x}_{1}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=3L{{x}_{1}(t)}+4L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-2=2{X}_{1}(s) \\\\ s{X}_{2}(s)+1=3{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get\n\n$$\ns{X}_{1}(s)-2=2{X}_{1}(s)\\,⟹\\,{X}_{1}(s)=\\frac{2}{s-2}.\n$$\n\nSubstituting this in the second equation and solving for ${X}_{2}(s),$ we have\n\n$$\ns{X}_{2}(s)+1=3(\\frac{2}{s-2})+4{X}_{2}(s)\\,⟹\\,{X}_{2}(s)=\\frac{-s+8}{(s-2)(s-4)}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331908/field-1" "q-331908/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571"] :knowledge-point/questions ["q-331908"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331940/field-1/a5a8902a0bbc5f4e9f17679c13fd16a50e11c00566b98d0b752a064c7d48f4b1" :answer/id #uuid "0bdae84a-21de-5484-93fe-20d081c243e4" :answer/type :answer.type/math :answer/value "\\frac{1}{s+3}" :db/ensure [:answer/validate]} {:db/id "q-331940/field-1/33cc59b5e68594bc6af264130586e85b267e8f11d46d35571c9b78a15530c112" :answer/id #uuid "b04a51b3-5014-5872-be6b-5018c360a452" :answer/type :answer.type/math :answer/value "\\frac{1}{s-3}" :db/ensure [:answer/validate]} {:db/id "q-331940/field-1" :answer-field/id #uuid "b8fffbd9-8519-5528-9929-e1df0646fa40" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331940/field-1/a5a8902a0bbc5f4e9f17679c13fd16a50e11c00566b98d0b752a064c7d48f4b1" :answer-field/choices ["q-331940/field-1/a5a8902a0bbc5f4e9f17679c13fd16a50e11c00566b98d0b752a064c7d48f4b1" "q-331940/field-1/33cc59b5e68594bc6af264130586e85b267e8f11d46d35571c9b78a15530c112"] :db/ensure [:answer-field/validate]} {:db/id "q-331940/field-2/ca6d94469c47a7d709522a8d90e4b10a7192fa090d146f73a7cf6c278f951c2b" :answer/id #uuid "3b540ad8-5180-5c60-aa1f-d46398dd5c6b" :answer/type :answer.type/math :answer/value "\\frac{5s+17}{(s+3)(s-1)}" :db/ensure [:answer/validate]} {:db/id "q-331940/field-2" :answer-field/id #uuid "5db521e7-3b73-5309-8b49-00e1a135ea6d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331940/field-2/ca6d94469c47a7d709522a8d90e4b10a7192fa090d146f73a7cf6c278f951c2b" :answer-field/choices ["q-331940/field-2/ca6d94469c47a7d709522a8d90e4b10a7192fa090d146f73a7cf6c278f951c2b"] :db/ensure [:answer-field/validate]} {:db/id "q-331940" :question/id #uuid "4ed5907a-e045-52bc-a89e-b763f6a9b1f8" :question/math-academy-id "q-331940" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-3{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=2{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}1 \\\\ 5\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=$ {{field-2}}." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{-3{x}_{1}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{2{x}_{1}(t)+{x}_{2}(t)}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=-3L{{x}_{1}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=2L{{x}_{1}(t)}+L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-1=-3{X}_{1}(s) \\\\ s{X}_{2}(s)-5=2{X}_{1}(s)+{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get\n\n$$\ns{X}_{1}(s)-1=-3{X}_{1}(s)\\,⟹\\,{X}_{1}(s)=\\frac{1}{s+3}.\n$$\n\nSubstituting this in the second equation and solving for ${X}_{2}(s),$ we have\n\n$$\ns{X}_{2}(s)-5=2(\\frac{1}{s+3})+{X}_{2}(s)\\,⟹\\,{X}_{2}(s)=\\frac{5s+17}{(s+3)(s-1)}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331940/field-1" "q-331940/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571"] :knowledge-point/questions ["q-331940"] :db/ensure [:knowledge-point/validate]} {:db/id "q-322291/field-1/43f11e6003e5fbcb43a64f276226200b3d423d992cecf728753aa358a16386b3" :answer/id #uuid "35db50db-929a-58cf-aac5-10088f84f9c6" :answer/type :answer.type/math :answer/value "\\frac{9s-30}{s(s-3)}" :db/ensure [:answer/validate]} {:db/id 17592186163996 :answer-field/correct "q-322291/field-1/43f11e6003e5fbcb43a64f276226200b3d423d992cecf728753aa358a16386b3" :answer-field/choices ["q-322291/field-1/43f11e6003e5fbcb43a64f276226200b3d423d992cecf728753aa358a16386b3"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-322291"] :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-2{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+2{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}9 \\\\ 6\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=\\frac{3(2s-5)}{s(s-3)}.$" :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{{x}_{1}(t)-2{x}_{2}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{-{x}_{1}(t)+2{x}_{2}(t)}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=L{{x}_{1}(t)}-2L{{x}_{2}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=-L{{x}_{1}(t)}+2L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-9={X}_{1}(s)-2{X}_{2}(s) \\\\ s{X}_{2}(s)-6=-{X}_{1}(s)+2{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nRewriting the system in standard form, we get the following:\n\n$$\n{\\begin{aligned}(s-1){X}_{1}(s)+2{X}_{2}(s)=9 \\\\ {X}_{1}(s)+(s-2){X}_{2}(s)=6\\end{aligned}\n$$\n\nNow, from the second equation, we have \n\n$$\n{X}_{1}(s)=6-(s-2){X}_{2}(s).\n$$\n\nSubstituting this into the first equation, we get\n\n$$\n\\begin{aligned}(s-1)[6-(s-2){X}_{2}(s)]+2{X}_{2}(s) & =9 \\\\ 6(s-1)-[(s-1)(s-2)-2]{X}_{2}(s) & =9 \\\\ -({s}^{2}-3s){X}_{2}(s) & =9-6(s-1) \\\\ -s(s-3){X}_{2}(s) & =-6s+15 \\\\ {X}_{2}(s) & =\\frac{3(2s-5)}{s(s-3)}\\end{aligned}\n$$\n\nNext, we find ${X}_{1}(s):$\n\n$$\n\\begin{aligned}{X}_{1}(s) & =6-(s-2){X}_{2}(s) \\\\  & =6-(s-2)\\cdot \\frac{3(2s-5)}{s(s-3)} \\\\  & =\\frac{6s(s-3)-3(s-2)(2s-5)}{s(s-3)} \\\\  & =\\frac{3(3s-10)}{s(s-3)}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{X}_{1}(s)=\\frac{3(3s-10)}{s(s-3)},\\,{X}_{2}(s)=\\frac{3(2s-5)}{s(s-3)}.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-331918/field-1/ce02984bea1d26e4d402a01ae3601882da99c2264e0e64e66b0b3945df2ae481" :answer/id #uuid "7b62d0ae-285b-5fb2-b7b9-d554f50e76a4" :answer/type :answer.type/math :answer/value "\\frac{3}{s+2}" :db/ensure [:answer/validate]} {:db/id "q-331918/field-1/746b01f4f6118a363f78c05586126edd3ad5d8d2033c95d59efe17786e8143c6" :answer/id #uuid "798c5a60-79f8-52fd-9756-7ae24d9da8d4" :answer/type :answer.type/math :answer/value "\\frac{3}{s-2}" :db/ensure [:answer/validate]} {:db/id "q-331918/field-1" :answer-field/id #uuid "f36c585a-471b-5b27-ad3d-43c1b2e05a9a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331918/field-1/ce02984bea1d26e4d402a01ae3601882da99c2264e0e64e66b0b3945df2ae481" :answer-field/choices ["q-331918/field-1/ce02984bea1d26e4d402a01ae3601882da99c2264e0e64e66b0b3945df2ae481" "q-331918/field-1/746b01f4f6118a363f78c05586126edd3ad5d8d2033c95d59efe17786e8143c6"] :db/ensure [:answer-field/validate]} {:db/id "q-331918/field-2/3e1324d114e7694246e85dd14fdfcbd125e04084e9c45f0405b1e5b4ae45edc5" :answer/id #uuid "b55a2105-c8e7-54c2-b6a1-268a8b525458" :answer/type :answer.type/math :answer/value "\\frac{-4s-17}{(s+2)(s-4)}" :db/ensure [:answer/validate]} {:db/id "q-331918/field-2" :answer-field/id #uuid "a3e0ecfb-e007-54c4-9912-4b0edbf76b4a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331918/field-2/3e1324d114e7694246e85dd14fdfcbd125e04084e9c45f0405b1e5b4ae45edc5" :answer-field/choices ["q-331918/field-2/3e1324d114e7694246e85dd14fdfcbd125e04084e9c45f0405b1e5b4ae45edc5"] :db/ensure [:answer-field/validate]} {:db/id "q-331918" :question/id #uuid "9d4c3987-9e3e-598c-a571-dd6a19301f19" :question/math-academy-id "q-331918" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-2{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}3 \\\\ -4\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=$ {{field-2}}." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{-2{x}_{1}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{-3{x}_{1}(t)+4{x}_{2}(t)}\\end{aligned}\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=-2L{{x}_{1}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=-3L{{x}_{1}(t)}+4L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich simplifies to:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-3=-2{X}_{1}(s) \\\\ s{X}_{2}(s)+4=-3{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get \n\n$$\ns{X}_{1}(s)-3=-2{X}_{1}(s)\\,⟹\\,{X}_{1}(s)=\\frac{3}{s+2}.\n$$\n\nSubstituting this in the second equation and solving for ${X}_{2}(s)$ gives\n\n$$\ns{X}_{2}(s)+4=-3(\\frac{3}{s+2})+4{X}_{2}(s)\\,⟹\\,{X}_{2}(s)=\\frac{-4s-17}{(s-4)(s+2)}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331918/field-1" "q-331918/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571"] :knowledge-point/questions ["q-331918"] :db/ensure [:knowledge-point/validate]} {:db/id "q-331917/field-1/ac60e9d98235aa8bad4a99f390b2ac1f0c8b96d420d753b547f86308d1416799" :answer/id #uuid "b4b4b453-d58c-5686-b9d9-1faf86a99d65" :answer/type :answer.type/math :answer/value "\\frac{-2}{s-4}" :db/ensure [:answer/validate]} {:db/id "q-331917/field-1" :answer-field/id #uuid "a37775f2-e180-5d07-90f0-c73cd35da19a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331917/field-1/ac60e9d98235aa8bad4a99f390b2ac1f0c8b96d420d753b547f86308d1416799" :answer-field/choices ["q-331917/field-1/ac60e9d98235aa8bad4a99f390b2ac1f0c8b96d420d753b547f86308d1416799"] :db/ensure [:answer-field/validate]} {:db/id "q-331917/field-2/419039b66b04f8b8b07eefb1e7fd4017d9ff5c6d5255c72c1b5335ea6e30cf36" :answer/id #uuid "ec2dbca5-b01d-50d7-b6d3-205d68a5a2d9" :answer/type :answer.type/math :answer/value "\\frac{5s-22}{(s-4)(s-3)}" :db/ensure [:answer/validate]} {:db/id "q-331917/field-2" :answer-field/id #uuid "8a9b07c7-c786-57c9-9aa0-26856f2fcdac" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-331917/field-2/419039b66b04f8b8b07eefb1e7fd4017d9ff5c6d5255c72c1b5335ea6e30cf36" :answer-field/choices ["q-331917/field-2/419039b66b04f8b8b07eefb1e7fd4017d9ff5c6d5255c72c1b5335ea6e30cf36"] :db/ensure [:answer-field/validate]} {:db/id "q-331917" :question/id #uuid "4d1eda80-48b7-5a9e-8813-d2067a2577e4" :question/math-academy-id "q-331917" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=4{x}_{1}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}-2 \\\\ 5\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=$ {{field-2}}." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{4{x}_{1}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{{x}_{1}(t)+3{x}_{2}(t)}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=4L{{x}_{1}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=L{{x}_{1}(t)}+3L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)+2=4{X}_{1}(s) \\\\ s{X}_{2}(s)-5={X}_{1}(s)+3{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get\n\n$$\ns{X}_{1}(s)+2=4{X}_{1}(s)\\,⟹\\,{X}_{1}(s)=-\\frac{2}{s-4}.\n$$\n\nSubstituting this into the second equation and solving for ${X}_{2}(s)$ gives\n\n$$\ns{X}_{2}(s)-5=(-\\frac{2}{s-4})+3{X}_{2}(s)\\,⟹\\,{X}_{2}(s)=\\frac{5s-22}{(s-3)(s-4)}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-331917/field-1" "q-331917/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571"] :knowledge-point/questions ["q-331917"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332391/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6003bf10-8d7e-5648-9caf-da4fc474cac0" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332391/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0c566bed-0364-53d6-b686-0e2ff77e9995" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-332391/field-1" :answer-field/id #uuid "1795263a-4a87-5bd0-a73e-41259516bcd5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332391/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-332391/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-332391/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-332391/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "e7f06820-f51c-5f2c-bad5-7e87dfc177db" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332391/field-2" :answer-field/id #uuid "865883ff-8de4-5ce5-aa6d-dbcedb723309" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332391/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-332391/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-332391/field-3/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7e58061f-7f06-59d9-95c6-8a4290691114" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332391/field-3" :answer-field/id #uuid "ee28cb55-7f93-59b1-9ea8-1c83b5002df1" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332391/field-3/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-332391/field-3/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-332391/field-4/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "78422936-8253-5e67-829f-40d7e5b408e6" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-332391/field-4" :answer-field/id #uuid "601a9a9b-1800-5a7b-ba38-e26d183f58fa" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332391/field-4/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-332391/field-4/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-332391" :question/id #uuid "d82c9bdb-8f36-53f5-b5b1-09a0cfa9547f" :question/math-academy-id "q-332391" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ 0\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L{{x}_{1}(t)}=\\frac{1}{s}+\\frac{1}{s-2},\\,{X}_{2}(s)=L{{x}_{2}(t)}=\\frac{1}{s}-\\frac{1}{s-2}.\n$$\n\nFind the solution to the original initial value problem.\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{2t}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}{{X}_{1}(s)} \\\\  & ={L}^{-1}{\\frac{1}{s}+\\frac{1}{s-2}} \\\\  & ={L}^{-1}{\\frac{1}{s}}+{L}^{-1}{\\frac{1}{s-2}} \\\\  & =1+{e}^{2\\cdot t} \\\\  & =1+{e}^{2t} \\\\ {x}_{2}(t) & ={L}^{-1}{{X}_{2}(s)} \\\\  & ={L}^{-1}{\\frac{1}{s}-\\frac{1}{s-2}} \\\\  & ={L}^{-1}{\\frac{1}{s}}-{L}^{-1}{\\frac{1}{s-2}} \\\\  & =1-{e}^{2\\cdot t} \\\\  & =1-{e}^{2t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}1+{e}^{2t} \\\\ 1-{e}^{2t}\\end{aligned}]=[\\begin{aligned}1 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{2t}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332391/field-1" "q-332391/field-2" "q-332391/field-3" "q-332391/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bb88b85b-efa1-56db-8655-4b49703dda6a"] :knowledge-point/questions ["q-332391"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332436/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "ccbc4371-128b-5dc2-b9d9-d260c9bbbb5c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-332436/field-1" :answer-field/id #uuid "4f3e2677-ba88-5ce0-b55f-f7d821ddad9f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332436/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-332436/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-332436/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "4930a06c-6584-554a-bcd3-bd1b564ab0bd" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-332436/field-2" :answer-field/id #uuid "7a302926-a276-5af4-875e-89378bdce800" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332436/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-332436/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-332436/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "5d4e28d5-1692-5776-b738-181b5fff15d0" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-332436/field-3" :answer-field/id #uuid "9344212b-3309-57f8-8d3b-03802b04ec41" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332436/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-332436/field-3/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-332436/field-4/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "b3b1649a-8ec5-55c9-93a3-4ea247ecb1f1" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-332436/field-4" :answer-field/id #uuid "d7998742-37d8-5791-bdcb-ce7609ee29bc" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332436/field-4/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-332436/field-4/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-332436" :question/id #uuid "e21a0486-fb2c-5b77-8555-d2377681c5fc" :question/math-academy-id "q-332436" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)-3{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+3{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}5 \\\\ 3\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L{{x}_{1}(t)}=\\frac{4}{s}+\\frac{1}{s-6},\\,{X}_{2}(s)=L{{x}_{2}(t)}=\\frac{4}{s}-\\frac{1}{s-6}.\n$$\n\nFind the solution to the original initial value problem.\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{6t}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}{{X}_{1}(s)} \\\\  & ={L}^{-1}{\\frac{4}{s}+\\frac{1}{s-6}} \\\\  & =4{L}^{-1}{\\frac{1}{s}}+{L}^{-1}{\\frac{1}{s-6}} \\\\  & =4\\cdot 1+{e}^{6\\cdot t} \\\\  & =4+{e}^{6t} \\\\ {x}_{2}(t) & ={L}^{-1}{{X}_{2}(s)} \\\\  & ={L}^{-1}{\\frac{4}{s}-\\frac{1}{s-6}} \\\\  & =4{L}^{-1}{\\frac{1}{s}}-{L}^{-1}{\\frac{1}{s-6}} \\\\  & =4\\cdot 1-{e}^{6\\cdot t} \\\\  & =4-{e}^{6t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}4+{e}^{6t} \\\\ 4-{e}^{6t}\\end{aligned}]=[\\begin{aligned}4 \\\\ 4\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{6t}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332436/field-1" "q-332436/field-2" "q-332436/field-3" "q-332436/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bb88b85b-efa1-56db-8655-4b49703dda6a"] :knowledge-point/questions ["q-332436"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332439/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6a1d78c0-949c-528f-8beb-37bbf29e77cb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answe