s-6}} \\\\  & =5{L}^{-1}{\\frac{1}{s}}-4{L}^{-1}{\\frac{1}{s-6}} \\\\  & =5-4{e}^{6\\cdot t} \\\\  & =5-4{e}^{6t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}1+4{e}^{6t} \\\\ 5-4{e}^{6t}\\end{aligned}]=[\\begin{aligned}1 \\\\ 5\\end{aligned}]+[\\begin{aligned}4 \\\\ -4\\end{aligned}]{e}^{6t}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332439/field-1" "q-332439/field-2" "q-332439/field-3" "q-332439/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bb88b85b-efa1-56db-8655-4b49703dda6a"] :knowledge-point/questions ["q-332439"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332409/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "0d9b08b5-a84b-54eb-b27b-9a952d8be990" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-332409/field-1" :answer-field/id #uuid "fae5e745-d5fc-590a-83b3-693fd34e3c25" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332409/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-332409/field-1/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-332409/field-2/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "ef3b90b7-8b52-5e4c-a4e6-2f602216af9f" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-332409/field-2" :answer-field/id #uuid "c1337415-22f9-5fd3-b01b-5af27e503d1d" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332409/field-2/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer-field/choices ["q-332409/field-2/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf"] :db/ensure [:answer-field/validate]} {:db/id "q-332409/field-3/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "b84b9e30-9a9b-54ee-b58e-68530d875e45" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-332409/field-3" :answer-field/id #uuid "0eb0fb09-d192-5247-9110-acc77faf8170" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332409/field-3/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer-field/choices ["q-332409/field-3/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10"] :db/ensure [:answer-field/validate]} {:db/id "q-332409/field-4/b8fe8d3cb42910de21f3df8634e1c373223a74d32bfef959cca9ceacd5c4d03e" :answer/id #uuid "a964dbef-3301-5f39-8ad4-b4cd2ce4d5e3" :answer/type :answer.type/math :answer/value "-\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-332409/field-4" :answer-field/id #uuid "75537957-bd1d-54c6-bf65-d4781ff80369" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332409/field-4/b8fe8d3cb42910de21f3df8634e1c373223a74d32bfef959cca9ceacd5c4d03e" :answer-field/choices ["q-332409/field-4/b8fe8d3cb42910de21f3df8634e1c373223a74d32bfef959cca9ceacd5c4d03e"] :db/ensure [:answer-field/validate]} {:db/id "q-332409" :question/id #uuid "fee1caec-82d0-5ab4-b648-40120b354ab8" :question/math-academy-id "q-332409" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=3{x}_{1}(t)-{x}_{2}(t) \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}4 \\\\ -2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution\n\n$$\n{X}_{1}(s)=L{{x}_{1}(t)}=\\frac{1}{2s}+\\frac{7}{2(s-4)},\\,{X}_{2}(s)=L{{x}_{2}(t)}=\\frac{3}{2s}-\\frac{7}{2(s-4)}.\n$$\n\nFind the solution to the original initial value problem.\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{4t}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}{{X}_{1}(s)} \\\\  & ={L}^{-1}{\\frac{1}{2s}+\\frac{7}{2(s-4)}} \\\\  & =\\frac{1}{2}{L}^{-1}{\\frac{1}{s}}+\\frac{7}{2}{L}^{-1}{\\frac{1}{s-4}} \\\\  & =\\frac{1}{2}\\cdot 1+\\frac{7}{2}{e}^{4\\cdot t} \\\\  & =\\frac{1}{2}+\\frac{7}{2}{e}^{4t} \\\\ {x}_{2}(t) & ={L}^{-1}{{X}_{2}(s)} \\\\  & ={L}^{-1}{\\frac{3}{2s}-\\frac{7}{2(s-4)}} \\\\  & =\\frac{3}{2}{L}^{-1}{\\frac{1}{s}}-\\frac{7}{2}{L}^{-1}{\\frac{1}{s-4}} \\\\  & =\\frac{3}{2}\\cdot 1-\\frac{7}{2}{e}^{4\\cdot t} \\\\  & =\\frac{3}{2}-\\frac{7}{2}{e}^{4t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\nx(t)=[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}\\frac{1}{2}+\\frac{7}{2}{e}^{4t} \\\\ \\frac{3}{2}-\\frac{7}{2}{e}^{4t}\\end{aligned}]=[\\begin{aligned}\\frac{1}{2} \\\\ \\frac{3}{2}\\end{aligned}]+[\\begin{aligned}\\frac{7}{2} \\\\ -\\frac{7}{2}\\end{aligned}]{e}^{4t}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-332409/field-1" "q-332409/field-2" "q-332409/field-3" "q-332409/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bb88b85b-efa1-56db-8655-4b49703dda6a"] :knowledge-point/questions ["q-332409"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332381/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "ca42235c-a157-5814-bd07-c8537787e429" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-332381/field-1" :answer-field/id #uuid "00f5b1ed-2a89-587a-b71a-5b036333f561" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332381/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-332381/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-332381/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "51167137-cfbb-50f8-92ce-85d9d84e02f1" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-332381/field-2" :answer-field/id #uuid "735edb87-96ef-564f-ba4f-f9dfea6c4b02" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332381/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-332381/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-332381/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "fcd588b4-8e9f-5afe-aacd-c8b798fd18aa" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-332381/field-3" :answer-field/id #uuid "ba4125ad-060c-56fd-962e-491998af5815" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332381/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-332381/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-332381/field-4/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d56e172d-5930-569c-a2f8-b5750a9c8cdf" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-332381/field-4" :answer-field/id #uuid "37e39453-1eee-5f47-b122-19c3b99c0562" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-332381/field-4/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-332381/field-4/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-332381" :question/id #uuid "0e70dcec-ab6c-5150-a244-a01c0813cc93" :question/math-academy-id "q-332381" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-{x}_{1}(t) \\\\ {x}_{2}^{′}(t)={x}_{1}(t)+2{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}3 \\\\ 3\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\n{X}_{1}(s)=L{{x}_{1}(t)}=\\frac{3}{s+1},\\,{X}_{2}(s)=L{{x}_{2}(t)}=-\\frac{1}{s+1}+\\frac{4}{s-2}.\n$$\n\nFind the solution to the original initial value problem.\n\n| $x(t)=\\,\\,$ |  | {{field-1}} |  | $\\,\\,{e}^{-t}+\\,\\,$ |  | {{field-2}} |  | $\\,\\,{e}^{2t}$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- |\n|  | {{field-3}} |  |  | {{field-4}} |  |  |  |  |" :question/worked-solution "To find ${x}_{1}(t)$ and ${x}_{2}(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to ${X}_{1}(s)$ and ${X}_{2}(s):$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}{{X}_{1}(s)} \\\\  & ={L}^{-1}{\\frac{3}{s+1}} \\\\  & =3{L}^{-1}{\\frac{1}{s+1}} \\\\  & =3{e}^{-1\\cdot t} \\\\  & =3{e}^{-t} \\\\ {x}_{2}(t) & ={L}^{-1}{{X}_{2}(s)} \\\\  & ={L}^{-1}{-\\frac{1}{s+1}+\\frac{4}{s-2}} \\\\  & =-{L}^{-1}{\\frac{1}{s+1}}+4{L}^{-1}{\\frac{1}{s-2}} \\\\  & =-{e}^{-1\\cdot t}+4{e}^{2\\cdot t} \\\\  & =-{e}^{-t}+4{e}^{2t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}3{e}^{-t} \\\\ -{e}^{-t}+4{e}^{2t}\\end{aligned}]=[\\begin{aligned}3 \\\\ -1\\end{aligned}]{e}^{-t}+[\\begin{aligned}0 \\\\ 4\\end{aligned}]{e}^{2t}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332381/field-1" "q-332381/field-2" "q-332381/field-3" "q-332381/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bb88b85b-efa1-56db-8655-4b49703dda6a"] :knowledge-point/questions ["q-332381"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-21157"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074064/assets/0be5433ffb8166a35fc9084c59116f77b223e25b85f939cb3c279f983939bc1f.png)\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}\\boxed{\\text{[math]\\phantom{XXX}[/math]}}=-3{X}_{1}(s) \\\\ \\boxed{\\text{[math]\\phantom{XXX}[/math]}}=\\boxed{\\text{[math]\\phantom{XXXXXXXX}[/math]}}\\end{aligned}\n$$\n\nwhere $X_1(s) = \\mathcal{L}\\left\\{  x_1(t) \\right\\}$ and $X_2(s) = \\mathcal{L}\\left\\{  x_2(t) \\right\\}$ are the Laplace transforms of the functions $x_1(t)$ and $x_2(t),$ respectively." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{-3{x}_{1}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{9{x}_{1}(t)+5{x}_{2}(t)}\\end{aligned}\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=-3L{{x}_{1}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=9L{{x}_{1}(t)}+5L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-3=-3{X}_{1}(s) \\\\ s{X}_{2}(s)-7=9{X}_{1}(s)+5{X}_{2}(s)\\end{aligned}\n$$\n\nwhere $X_1(s) = \\mathcal{L}\\left\\{  x_1(t) \\right\\}$ and $X_2(s) = \\mathcal{L}\\left\\{  x_2(t) \\right\\}$ are the Laplace transforms of the functions $x_1(t)$ and $x_2(t),$ respectively." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21155"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074064/assets/075eca4fcc837dce57c4bcfba01047af3d72f15b80cd3fabfc7e5b00be83813d.png)\nConsider the initial value problem above. By applying the Laplace transform $\\mathcal{L}$ to both sides of each equation in our system, we get a system with variables $X_1(s) = \\mathcal{L}\\!\\left\\{  x_1(t) \\right\\}$ and $X_2(s) = \\mathcal{L}\\!\\left\\{  x_2(t) \\right\\}.$ \nFind the solution of the new system in terms of the parameter $s.$" :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L\\,{{x}_{1}^{′}(t)}=L\\,{-3{x}_{1}(t)+{x}_{2}(t)} \\\\ L\\,{{x}_{2}^{′}(t)}=L\\,{3{x}_{1}(t)-{x}_{2}(t)}\\end{aligned}\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL\\,{{x}_{1}(t)}-{x}_{1}(0)=-3L\\,{{x}_{1}(t)}+L\\,{{x}_{2}(t)} \\\\ sL\\,{{x}_{2}(t)}-{x}_{2}(0)=3L\\,{{x}_{1}(t)}-L\\,{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich simplifies to the following system:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-4=-3{X}_{1}(s)+{X}_{2}(s) \\\\ s{X}_{2}(s)-4=3{X}_{1}(s)-{X}_{2}(s)\\end{aligned}\n$$\n\nwhere $X_1(s) = \\mathcal{L}\\!\\left\\{  x_1(t) \\right\\}$ and $X_2(s) = \\mathcal{L}\\!\\left\\{  x_2(t) \\right\\}.$\n\nRewriting the system in standard form, we get\n\n$$\n{\\begin{aligned}(s+3){X}_{1}(s)-{X}_{2}(s)=4 \\\\ -3{X}_{1}(s)+(s+1){X}_{2}(s)=4\\end{aligned}\n$$\n\nNow, from the first equation, we have\n\n$$\nX_2(s) = (s+3)X_1(s) - 4.\n$$\n\nSubstituting this into the second equation, we get\n\n$$\n\\begin{aligned}-3{X}_{1}(s)+(s+1)\\,[(s+3){X}_{1}(s)-4] & =4 \\\\ -3{X}_{1}(s)+(s+1)(s+3){X}_{1}(s)-4(s+1) & =4 \\\\ [(s+1)(s+3)-3]{X}_{1}(s) & =4+4(s+1) \\\\ s(s+4){X}_{1}(s) & =4s+8 \\\\ {X}_{1}(s)=\\frac{4(s+2)}{s(s+4)}.\\end{aligned}\n$$\n\nNext, we find $X_2(s):$\n\n$$\n\\begin{aligned}{X}_{2}(s) & =(s+3){X}_{1}(s)-4 \\\\  & =(s+3)\\,(\\frac{4(s+2)}{s(s+4)})-4 \\\\  & =\\frac{4(s+3)(s+2)-4s(s+4)}{s(s+4)} \\\\  & =\\frac{4({s}^{2}+5s+6)-4({s}^{2}+4s)}{s(s+4)} \\\\  & =\\frac{4{s}^{2}+20s+24-4{s}^{2}-16s}{s(s+4)} \\\\  & =\\frac{4(s+6)}{s(s+4)}.\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nX_1(s) =\\dfrac{4(s+2)}{s(s+4)}, \n\\qquad\nX_2(s) = \\dfrac{4(s+6)}{s(s+4)}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-21156"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074064/assets/243212bee1e50c7ca289142dcc8a9b5ac4f6d06fe3715661e99ec2601c82bf45.png)\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation in our system, we get a transformed system with the solution \n\n$$\nX_1(s) = \\mathcal{L}\\left\\{ x_1(t) \\right\\} = \\dfrac{4}{s} + \\dfrac{1}{s-6}, \n\\qquad\nX_2(s) = \\mathcal{L}\\left\\{ x_2(t) \\right\\} = \\dfrac{20}{s} - \\dfrac{1}{s-6}.\n$$\n\nFind the solution to the original initial value problem." :question/worked-solution "To find $x_1(t)$ and $x_2(t)$ satisfying the original initial value problem, we apply the inverse Laplace transform to $X_1(s)$ and $X_2(s){:}$\n\n$$\n\\begin{aligned}{x}_{1}(t) & ={L}^{-1}{{X}_{1}(s)} \\\\  & ={L}^{-1}{\\frac{4}{s}+\\frac{1}{s-6}} \\\\  & =4{L}^{-1}{\\frac{1}{s}}+{L}^{-1}{\\frac{1}{s-6}} \\\\  & =4\\cdot 1+{e}^{6\\cdot t} \\\\  & =4+{e}^{6t} \\\\ {x}_{2}(t) & ={L}^{-1}{{X}_{2}(s)} \\\\  & ={L}^{-1}{\\frac{20}{s}-\\frac{1}{s-6}} \\\\  & =20{L}^{-1}{\\frac{1}{s}}-{L}^{-1}{\\frac{1}{s-6}} \\\\  & =20\\cdot 1-{e}^{6\\cdot t} \\\\  & =20-{e}^{6t}\\end{aligned}\n$$\n\nFinally, we write down the solution to the initial value problem:\n\n$$\n\\begin{aligned}x(t) & =[\\begin{aligned}{x}_{1}(t) \\\\ {x}_{2}(t)\\end{aligned}]=[\\begin{aligned}4+{e}^{6t} \\\\ 20-{e}^{6t}\\end{aligned}]=[\\begin{aligned}4 \\\\ 20\\end{aligned}]+[\\begin{aligned}1 \\\\ -1\\end{aligned}]{e}^{6t}\\end{aligned}\n$$" :db/ensure [:question/validate]}]
