x}_{2}(t)}-{x}_{2}(0)=2L{{x}_{1}(t)}+6L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)+2=3{X}_{1}(s)-4{X}_{2}(s) \\\\ s{X}_{2}(s)-5=2{X}_{1}(s)+6{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively."}] [{:db/id #edb/ref 17592186380308 :knowledge-point/_questions [{:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571" :knowledge-point/title "Finding the Solution of a Laplace Transformed Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8010250-89a4-5abd-af3c-f68b90917ccd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{s-2}" :db/id #edb/ref 17592186380310}] :answer-field/correct {:answer/id #uuid "b8010250-89a4-5abd-af3c-f68b90917ccd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{s-2}" :db/id #edb/ref 17592186380310} :answer-field/id #uuid "bad8a7d4-fe73-5b52-98d7-c91770460eea" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186380309} {:answer-field/choices [{:answer/id #uuid "edc7accc-bae4-5d5a-879e-882410e23b5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8-s}{(s-2)(s-4)}" :db/id #edb/ref 17592186380312}] :answer-field/correct {:answer/id #uuid "edc7accc-bae4-5d5a-879e-882410e23b5a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8-s}{(s-2)(s-4)}" :db/id #edb/ref 17592186380312} :answer-field/id #uuid "fbffcf57-1348-5f5b-a97d-93886b990c84" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186380311}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b02012b6-0569-5174-914a-f61b8e20f9c7" :question/math-academy-id "q-331908" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=2{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=3{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}2 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=$ {{field-2}}." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{2{x}_{1}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{3{x}_{1}(t)+4{x}_{2}(t)}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=2L{{x}_{1}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=3L{{x}_{1}(t)}+4L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to the following:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-2=2{X}_{1}(s) \\\\ s{X}_{2}(s)+1=3{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get\n\n$$\ns{X}_{1}(s)-2=2{X}_{1}(s)\\,⟹\\,{X}_{1}(s)=\\frac{2}{s-2}.\n$$\n\nSubstituting this in the second equation and solving for ${X}_{2}(s),$ we have\n\n$$\ns{X}_{2}(s)+1=3(\\frac{2}{s-2})+4{X}_{2}(s)\\,⟹\\,{X}_{2}(s)=\\frac{-s+8}{(s-2)(s-4)}.\n$$"}] [{:db/id #edb/ref 17592186380313 :knowledge-point/_questions [{:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571" :knowledge-point/title "Finding the Solution of a Laplace Transformed Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b4b4b453-d58c-5686-b9d9-1faf86a99d65" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-2}{s-4}" :db/id #edb/ref 17592186380315}] :answer-field/correct {:answer/id #uuid "b4b4b453-d58c-5686-b9d9-1faf86a99d65" :answ