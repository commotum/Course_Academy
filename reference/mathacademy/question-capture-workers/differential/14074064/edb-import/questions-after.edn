_{2}(t)}\\end{aligned}\n$$\n\nwhich can be simplified to:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)+2=4{X}_{1}(s) \\\\ s{X}_{2}(s)-5={X}_{1}(s)+3{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get\n\n$$\ns{X}_{1}(s)+2=4{X}_{1}(s)\\,⟹\\,{X}_{1}(s)=-\\frac{2}{s-4}.\n$$\n\nSubstituting this into the second equation and solving for ${X}_{2}(s)$ gives\n\n$$\ns{X}_{2}(s)-5=(-\\frac{2}{s-4})+3{X}_{2}(s)\\,⟹\\,{X}_{2}(s)=\\frac{5s-22}{(s-3)(s-4)}.\n$$"}] [{:db/id #edb/ref 17592186380318 :knowledge-point/_questions [{:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571" :knowledge-point/title "Finding the Solution of a Laplace Transformed Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "798c5a60-79f8-52fd-9756-7ae24d9da8d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{s-2}" :db/id #edb/ref 17592186380320} {:answer/id #uuid "7b62d0ae-285b-5fb2-b7b9-d554f50e76a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{s+2}" :db/id #edb/ref 17592186380321}] :answer-field/correct {:answer/id #uuid "7b62d0ae-285b-5fb2-b7b9-d554f50e76a4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{s+2}" :db/id #edb/ref 17592186380321} :answer-field/id #uuid "f36c585a-471b-5b27-ad3d-43c1b2e05a9a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186380319} {:answer-field/choices [{:answer/id #uuid "b55a2105-c8e7-54c2-b6a1-268a8b525458" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-4s-17}{(s+2)(s-4)}" :db/id #edb/ref 17592186380323}] :answer-field/correct {:answer/id #uuid "b55a2105-c8e7-54c2-b6a1-268a8b525458" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{-4s-17}{(s+2)(s-4)}" :db/id #edb/ref 17592186380323} :answer-field/id #uuid "a3e0ecfb-e007-54c4-9912-4b0edbf76b4a" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186380322}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9d4c3987-9e3e-598c-a571-dd6a19301f19" :question/math-academy-id "q-331918" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-2{x}_{1}(t) \\\\ {x}_{2}^{′}(t)=-3{x}_{1}(t)+4{x}_{2}(t),\\end{aligned}\\,x(0)=[\\begin{aligned}3 \\\\ -4\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform $L$ to both sides of each equation in our system, we get a system with variables ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$ In terms of the parameter $s,$ the solution of the new system is\n\n${X}_{1}(s)=$ {{field-1}},\n$\\,{X}_{2}(s)=$ {{field-2}}." :question/worked-solution "First, we find the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{-2{x}_{1}(t)} \\\\ L{{x}_{2}^{′}(t)}=L{-3{x}_{1}(t)+4{x}_{2}(t)}\\end{aligned}\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=-2L{{x}_{1}(t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=-3L{{x}_{1}(t)}+4L{{x}_{2}(t)}\\end{aligned}\n$$\n\nwhich simplifies to:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-3=-2{X}_{1}(s) \\\\ s{X}_{2}(s)+4=-3{X}_{1}(s)+4{X}_{2}(s)\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}.$\n\nNow, solving the first equation for ${X}_{1}(s),$ we get \n\n$$\ns{X}_{1}(s)-3=-2{X}_{1}(s)\\,⟹\\,{X}_{1}(s)=\\frac{3}{s+2}.\n$$\n\nSubstituting this in the second equation and solving for ${X}_{2}(s)$ gives\n\n$$\ns{X}_{2}(s)+4=-3(\\frac{3}{s+2})+4{X}_{2}(s)\\,⟹\\,{X}_{2}(s)=\\frac{-4s-17}{(s-4)(s+2)}.\n$$"}] [{:db/id #edb/ref 17592186380324 :knowledge-point/_questions [{:knowledge-point/id #uuid "c81626a0-6613-5f5d-9dda-df853958c571" :knowledge-point/title "Finding the Solution of a Laplace Transformed Initial Value Prob