lambda }_{1}+{\\lambda }_{2}).$" :question/worked-solution "Since ${\\lambda }_{1}=6-\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of ${\\lambda }_{1}.$\nTherefore, \n\n$$\n{\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}=6+\\text{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}3({\\lambda }_{1}+{\\lambda }_{2}) & =3(6-\\text{i}+(6+\\text{i})) \\\\  & =3(12) \\\\  & =36.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81036/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1"] :knowledge-point/questions ["q-81036"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81035/selection/306728c81b78d4975e4f5eb0a4b47c4aa95ae053de49d4d4af21036534180a7e" :answer/id #uuid "d3ea9eb7-ed37-5e92-a11b-8b4eb833756c" :answer/type :answer.type/math :answer/value "6\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-81035/selection/6115cec4c91996e51c6f66aac3fdd66c7ac2a5d2d6833fb5c44157bd1ea74b91" :answer/id #uuid "565a3834-a7b0-51c4-81df-59592cfc377a" :answer/type :answer.type/math :answer/value "-3\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-81035/selection/1c2f9276446d4d3e44df8620229d5d80d6a8e620a9de32c711df6addb65a45b1" :answer/id #uuid "34884872-23a3-5c64-ab43-fb1e3c778b3d" :answer/type :answer.type/math :answer/value "\\frac{3}{5}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-81035/selection/a292c43a5bdd99f5ad91dc2c1ffcf1365e0f66bcc30237684298c4592b5a76aa" :answer/id #uuid "3512ec1d-9915-5b26-a40d-a965640a8fad" :answer/type :answer.type/math :answer/value "3\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-81035/selection/5b5c2c39549080b8852cc601b2734981074ad223caceae684f2cd70ca44c91a4" :answer/id #uuid "b394afca-0af0-5419-bd40-4077bb1bd532" :answer/type :answer.type/math :answer/value "-6\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-81035/selection" :answer-field/id #uuid "ba1679b7-337d-58