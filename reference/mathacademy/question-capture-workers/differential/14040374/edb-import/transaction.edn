answer-field/validate]} {:db/id "q-81144" :question/id #uuid "023400e2-b200-55f2-b07e-675b3e7d655f" :question/math-academy-id "q-81144" :question/problem "Compute the eigenvalues of the matrix $A=[\\begin{aligned}1 & 1 \\\\ -17 & -1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}1-\\lambda  & 1 \\\\ -17 & -1-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & 1 \\\\ -17 & -1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(-1-\\lambda )-1(-17) & =0 \\\\ -1-\\lambda +\\lambda +{\\lambda }^{2}+17 & =0 \\\\ {\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2} & =-16 \\\\ \\lambda  & =\\pm 4\\text{i}\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =\\pm 4\\text{i}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81144/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc"] :knowledge-point/questions ["q-81144"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102773/selection/47ee0fb1fc99fb4702b5f5fe47ba4a74ec35f652ce0100885b8cdfc06d517ee4" :answer/id #uuid "79bfcf49-cc8b-5a65-9cc9-6246000568bc" :answer/type :answer.type/math :answer/value "\\lambda =2\\pm 2\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-102773/selection/baa80a8068dd7c782dcda3a7ea56c67dd55cb5cc6dc80a1fdbf0bd1389d0e657" :answer/id #uuid "e386df89-ab56-5b77-be86-36c4e93dc4ac" :answer/type :answer.type/math :answer/value "\\lambda =1\\pm \\sqrt{2}\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-102773/selection/29ebad76ea6e9128dca46fb20fbdb0f58d462830789db726ed43af3de3781519" :answer/id #uuid "9747391f-db12-5323-a421-08bcde48fac7" :answer/type :answer.type/math :answer/value "\\lambda =1\\pm 2\\text{i}" :db/ensure [:answer/validate]} {:db/id "q-102773/selection/0d520c9aa35af655647de648eb437e9d6a3a