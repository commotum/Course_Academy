dent :answer.type/math} :answer/value "\\lambda =-3\\pm 2\\text{i}" :db/id #edb/ref 17592186307650} {:answer/id #uuid "3ef135ac-74a8-5f63-8327-6ae3ef6a7a68" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =3\\pm 2\\text{i}" :db/id #edb/ref 17592186307651} {:answer/id #uuid "fef5b820-7cea-5ee5-957a-943d909978b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-3\\pm 3\\text{i}" :db/id #edb/ref 17592186307652} {:answer/id #uuid "6615ca1a-e75a-53d7-a29b-e1e4ca4b8f73" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-2\\pm 3\\text{i}" :db/id #edb/ref 17592186307653} {:answer/id #uuid "4dcb1b71-9c3b-5013-a849-d2a05bf7c928" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =3\\pm 3\\text{i}" :db/id #edb/ref 17592186307654}] :answer-field/correct {:answer/id #uuid "3ef135ac-74a8-5f63-8327-6ae3ef6a7a68" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =3\\pm 2\\text{i}" :db/id #edb/ref 17592186307651} :answer-field/id #uuid "f1c3607d-3f0e-5436-a6b9-f05776129344" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307649}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "252141a6-142d-5ad2-94ac-bb05b0444744" :question/math-academy-id "q-39186" :question/problem "Compute the eigenvalues of the matrix $A=[\\begin{aligned}1 & -2 \\\\ 4 & 5\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}1-\\lambda  & -2 \\\\ 4 & 5-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & -2 \\\\ 4 & 5-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(5-\\lambda )-4(-2) & =0 \\\\ 5-\\lambda -5\\lambda +{\\lambda }^{2}+8 & =0 \\\\ {\\lambda }^{2}-6\\lambda +13 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{6\\pm \\sqrt{(-6)^{2}-4(1)(13)}}{2(1)} \\\\  & =\\frac{6\\pm \\sqrt{-16}}{2} \\\\  & =\\frac{6\\pm 4\\text{i}}{2} \\\\  & =3\\pm 2\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =3\\pm 2\\text{i}.$"}] [{:db/id #edb/ref 17592186307655 :knowledge-point/_questions [{:knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc" :knowledge-point/title "Computing the Complex Eigenvalues of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffeaf430-8394-59e8-97e4-947b56ce7c33" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =2\\pm 3\\text{i}" :db/id #edb/ref 17592186307657} {:answer/id #uuid "c6e90a35-c8a9-54c4-9c09-319238d91f48" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =2\\pm 2\\text{i}" :db/id #edb/ref 17592186307658} {:answer/id #uuid "1d8401cd-fee5-5bc8-9ed8-db04ca1b5d26" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-2\\pm 3\\text{i}" :db/id #edb/ref 17592186307659} {:answer/id #uuid "da01585a-0eb6-585a-aaa6-b338af6407ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-1\\pm \\text{i}" :db/id #edb/ref 17592186307660} {:answer/id #uuid "e3e1b2b5-a8e7-581c-8887-68f2abad689d" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =1\\pm \\text{i}" :db/id #edb/ref 17592186307661}] :answer-field/correct {:answer/id #uuid "ffeaf430-8394-59e8-97e4-947b56ce7c33" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =2\\pm 3\\text{i}" :db/id #edb/ref 17592186307657} :answer-field/id #uuid "6dbdd8dc-682b-587b-ac8b-09679c629cb2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307656}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d73a0002-f223-52d5-994d-c6e2237466e9" :question/math-academy-id "q-40429" :question/problem "Compute the eigenvalues of the matrix $A=[\\begin{aligned}2 & 3 \\\\ -3 & 2\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}2-\\lambda  & 3 \\\\ -3 & 2-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ \\left|\\begin{aligned}2-\\lambda  & 3 \\\\ -3 & 2-\\lambda \\end{aligned}\\right| & =0 \\\\ (2-\\lambda )(2-\\lambda )-3(-3) & =0 \\\\ 4-4\\lambda +{\\lambda }^{2}+9 & =0 \\\\ {\\lambda }^{2}-4\\lambda +13 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-(-4)\\pm \\sqrt{(-4)^{2}-4(1)(13)}}{2(1)} \\\\  & =\\frac{4\\pm \\sqrt{-36}}{2} \\\\  & =\\frac{4\\pm 6\\text{i}}{2} \\\\  & =2\\pm 3\\text{i}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =2\\pm 3\\text{i}.$"}] [{:db/id #edb/ref 17592186307662 :knowledge-point/_questions [{:knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc" :knowledge-point/title "Computing the Complex Eigenvalues of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "256bf942-98b4-5efa-bf37-8fc7cd6b7d1f" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-2\\pm \\text{i}" :db/id #edb/ref 17592186307664} {:answer/id #uuid "a64911a1-dc9c-58d3-8718-f16f42658fc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =-1\\pm 2\\text{i}" :db/id #edb/ref 17592186307665} {:answer/id #uuid "be99cefb-597b-5af2-9bf6-82d0d0ce0085" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =1\\pm \\text{i}\\sqrt{2}" :db/id #edb/ref 17592186307666} {:answer/id #uuid "911445ea-3fb4-52ab-b7e2-979b86a89afc" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =2\\pm \\text{i}" :db/id #edb/ref 17592186307667} {:answer/id #uuid "87cd9871-e1f7-5a7d-8dc7-13f6623a182e" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 2\\text{i}" :db/id #edb/ref 17592186307668}] :answer-field/correct {:answer/id #uuid "be99cefb-597b-5af2-9bf6-82d0d0ce0085" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =1\\pm \\text{i}\\sqrt{2}" :db/id #edb/ref 17592186307666} :answer-field/id #uuid "2cca5abb-859d-5927-a9d9-f752dc977d77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307663}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ecc04e3c-5cba-53e9-b3a7-4ec76a74a26e" :question/math-academy-id "q-81022" :question/problem "Compute the eigenvalues of the matrix $A=[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}1-\\lambda  & -1 \\\\ 2 & 1-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & -1 \\\\ 2 & 1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(1-\\lambda )-2(-1) & =0 \\\\ 1-2\\lambda +{\\lambda }^{2}+2 & =0 \\\\ {\\lambda }^{2}-2\\lambda +3 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we get\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-b\\pm \\sqrt{{b}^{2}-4ac}}{2a} \\\\  & =\\frac{-(-2)\\pm \\sqrt{(-2)^{2}-4(1)(3)}}{2(1)} \\\\  & =\\frac{2\\pm \\sqrt{-8}}{2} \\\\  & =\\frac{2\\pm 2\\text{i}\\sqrt{2}}{2} \\\\  & =1\\pm \\text{i}\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =1\\pm \\text{i}\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186307669 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34884872-23a3-5c64-ab43-fb1e3c778b3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}\\text{i}" :db/id #edb/ref 17592186307671} {:answer/id #uuid "d3ea9eb7-ed37-5e92-a11b-8b4eb833756c" :answer/type {:db/ident :answer.type/math} :answer/value "6\\text{i}" :db/id #edb/ref 17592186307672} {:answer/id #uuid "b394afca-0af0-5419-bd40-4077bb1bd532" :answer/type {:db/ident :answer.type/math} :answer/value "-6\\text{i}" :db/id #edb/ref 17592186307673} {:answer/id #uuid "565a3834-a7b0-51c4-81df-59592cfc377a" :answer/type {:db/ident :answer.type/math} :answer/value "-3\\text{i}" :db/id #edb/ref 17592186307674} {:answer/id #uuid "3512ec1d-9915-5b26-a40d-a965640a8fad" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186307675}] :answer-field/correct {:answer/id #uuid "d3ea9eb7-ed37-5e92-a11b-8b4eb833756c" :answer/type {:db/ident :answer.type/math} :answer/value "6\\text{i}" :db/id #edb/ref 17592186307672} :answer-field/id #uuid "ba1679b7-337d-5883-b521-af2d949cd7fc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307670}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f4a074cd-eb14-5f96-9b0b-6d393fb5aa1f" :question/math-academy-id "q-81035" :question/problem "Given that ${\\lambda }_{1}=1+5\\text{i}$ and ${\\lambda }_{2}$ are eigenvalues of a real $2\\times 2$ matrix $A$, find $\\frac{3}{5}({\\lambda }_{1}-{\\lambda }_{2}).$" :question/worked-solution "Since ${\\lambda }_{1}=1+5\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of ${\\lambda }_{1}.$\nTherefore, \n\n$$\n{\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}=1-5\\text{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}\\frac{3}{5}({\\lambda }_{1}-{\\lambda }_{2}) & =\\frac{3}{5}(1+5\\text{i}-(1-5\\text{i})) \\\\  & =\\frac{3}{5}(10\\text{i}) \\\\  & =6\\text{i}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186307676 :knowledge-point/_questions [{:knowledge-point/id #uuid "2eae4328-dd7c-5f77-8958-840cadb6f7f1" :knowledge-point/title "Finding a Complex Eigenvalue of a 2x2 Matrix Given Another Eigenvalue"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c850429a-90ff-5070-81d7-06b7be6e124a" :answer/type {:db/ident :answer.type/math} :answer/value "6\\text{i}" :db/id #edb/ref 17592186307678} {:answer/id #uuid "7fc4fe00-99b4-5493-96c3-68a19e9f74fd" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186307679} {:answer/id #uuid "0726d242-9b99-5d4c-b22b-856999accb9d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186307680} {:answer/id #uuid "cd6e1cd2-a0b9-5732-912b-ced1074b3c0a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\text{i}" :db/id #edb/ref 17592186307681} {:answer/id #uuid "65cc1fc3-2e0a-58c8-a15a-dd36929fc97f" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186307682}] :answer-field/correct {:answer/id #uuid "7fc4fe00-99b4-5493-96c3-68a19e9f74fd" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186307679} :answer-field/id #uuid "11322505-a9ce-5bfc-b450-1a4b2ed2fcb1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307677}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6bdddd65-2107-5d29-9a4d-0f6ba2861d68" :question/math-academy-id "q-81036" :question/problem "Given that ${\\lambda }_{1}=6-\\text{i}$ and ${\\lambda }_{2}$ are eigenvalues of a real $2\\times 2$ matrix $A$, find $3({\\lambda }_{1}+{\\lambda }_{2}).$" :question/worked-solution "Since ${\\lambda }_{1}=6-\\text{i}$ is a complex eigenvalue of $A,$ the second eigenvalue of $A$ must be the complex conjugate of ${\\lambda }_{1}.$\nTherefore, \n\n$$\n{\\lambda }_{2}={\\overset{―}{\\lambda }}_{1}=6+\\text{i}.\n$$\n\nFinally, we have\n\n$$\n\\begin{aligned}3({\\lambda }_{1}+{\\lambda }_{2}) & =3(6-\\text{i}+(6+\\text{i})) \\\\  & =3(12) \\\\  & =36.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186307683 :knowledge-point/_questions [{:knowledge-point/id #uuid "7a453400-6363-5782-b346-aae37570c9bc" :knowledge-point/title "Computing the Complex Eigenvalues of a Matrix"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3e785c53-41a1-5158-a588-9b6cc59df58b" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 4\\text{i}" :db/id #edb/ref 17592186307685} {:answer/id #uuid "8f7b84d5-923b-5c05-9a58-8b2c92dc9349" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =4\\pm \\text{i}" :db/id #edb/ref 17592186307686} {:answer/id #uuid "876fa660-73b1-5e64-bb2b-f0ce00314154" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =2\\pm 4\\text{i}" :db/id #edb/ref 17592186307687} {:answer/id #uuid "75519b4d-771f-559b-af5d-68d0a0fdbd45" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 8\\text{i}" :db/id #edb/ref 17592186307688} {:answer/id #uuid "336ea47e-2d02-5896-91be-8aa3012ae451" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 2\\text{i}" :db/id #edb/ref 17592186307689}] :answer-field/correct {:answer/id #uuid "3e785c53-41a1-5158-a588-9b6cc59df58b" :answer/type {:db/ident :answer.type/math} :answer/value "\\lambda =\\pm 4\\text{i}" :db/id #edb/ref 17592186307685} :answer-field/id #uuid "3d940503-c5ad-5030-97f5-026ae2937fba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307684}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "023400e2-b200-55f2-b07e-675b3e7d655f" :question/math-academy-id "q-81144" :question/problem "Compute the eigenvalues of the matrix $A=[\\begin{aligned}1 & 1 \\\\ -17 & -1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}1-\\lambda  & 1 \\\\ -17 & -1-\\lambda \\end{aligned}]\n$$\n\nThen, we compute the characteristic equation, as follows:\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}1-\\lambda  & 1 \\\\ -17 & -1-\\lambda \\end{aligned}| & =0 \\\\ (1-\\lambda )(-1-\\lambda )-1(-17) & =0 \\\\ -1-\\lambda +\\lambda +{\\lambda }^{2}+17 & =0 \\\\ {\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2} & =-16 \\\\ \\lambda  & =\\pm 4\\text{i}\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =\\pm 4\\text{i}.$"}]}
