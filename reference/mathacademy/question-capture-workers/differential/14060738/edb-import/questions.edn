#{[{:db/id #edb/ref 17592186290207 :knowledge-point/_questions [{:knowledge-point/id #uuid "98a67346-c2c9-5d22-8adf-479fea81eaa2" :knowledge-point/title "Computing the Integral of a Logarithmic Expression Using Integration by Parts Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1f53230a-ac18-5819-b7aa-8fc4cd6a24fe" :answer/type {:db/ident :answer.type/math} :answer/value "2x(3{({log}_{3}⁡x)}^{2}+\\frac{{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2}{{ln}^{2}⁡3})+C" :db/id #edb/ref 17592186290209} {:answer/id #uuid "04d9df7e-0377-57d5-8cae-d60a0dc50cdb" :answer/type {:db/ident :answer.type/math} :answer/value "x({({log}_{3}⁡x)}^{2}+\\frac{2{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}-\\frac{2}{{ln}^{2}⁡3})+C" :db/id #edb/ref 17592186290210} {:answer/id #uuid "2cea4065-d7d7-58a4-a77e-122972c73e74" :answer/type {:db/ident :answer.type/math} :answer/value "2x({({log}_{3}⁡x)}^{2}-\\frac{{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}-\\frac{1}{{ln}^{2}⁡3})+C" :db/id #edb/ref 17592186290211} {:answer/id #uuid "6aa58726-c13b-5add-834b-ac023e4a62ed" :answer/type {:db/ident :answer.type/math} :answer/value "x({({log}_{3}⁡x)}^{2}-\\frac{3{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{3}{{ln}^{2}⁡3})+C" :db/id #edb/ref 17592186290212} {:answer/id #uuid "68ec665d-5383-56a5-8aec-69399e614220" :answer/type {:db/ident :answer.type/math} :answer/value "x({({log}_{3}⁡x)}^{2}-\\frac{2{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2}{{ln}^{2}⁡3})+C" :db/id #edb/ref 17592186290213}] :answer-field/correct {:answer/id #uuid "68ec665d-5383-56a5-8aec-69399e614220" :answer/type {:db/ident :answer.type/math} :answer/value "x({({log}_{3}⁡x)}^{2}-\\frac{2{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2}{{ln}^{2}⁡3})+C" :db/id #edb/ref 17592186290213} :answer-field/id #uuid "044cf0d4-63f0-5c69-ba32-5a850ebc7d7e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186290208}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "35c6bb4e-1ad8-5bd0-8b19-4423d0943b19" :question/math-academy-id "q-12708" :question/problem "Calculate the integral $\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x.$" :question/worked-solution "We need to use integration by parts.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=({log}_{3}⁡x)^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nUsing the formula of integration by parts, we get\n\n$$\n\\begin{aligned}\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & ={({log}_{3}⁡x)}^{2}(x)-\\int (x)(\\frac{2{log}_{3}⁡x}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =x{({log}_{3}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡3}\\int {log}_{3}⁡(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nWe use integration by parts once again to evaluate  $\\int {log}_{3}⁡(x)\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u={log}_{3}⁡(x)\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{x\\operatorname{ln}⁡3} \\\\ \\frac{\\text{d}v}{\\text{d}x}=1\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\,\\text{d}x=x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int {log}_{3}⁡(x)\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =({log}_{3}⁡(x))(x)-\\int (x)(\\frac{1}{x\\operatorname{ln}⁡3})\\,\\text{d}x \\\\  & =x{log}_{3}⁡(x)-\\frac{1}{\\operatorname{ln}⁡3}\\int \\,\\text{d}x \\\\  & =x{log}_{3}⁡(x)-\\frac{x}{\\operatorname{ln}⁡3}+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant.\n\nSo we have\n\n$$\n\\begin{aligned}\\int ({log}_{3}⁡x)^{2}\\,\\text{d}x & =x{({log}_{3}⁡x)}^{2}-\\frac{2}{\\operatorname{ln}⁡3}(x{log}_{3}⁡(x)-\\frac{x}{\\operatorname{ln}⁡3}+D) \\\\  & =x{({log}_{3}⁡x)}^{2}-\\frac{2x{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2x}{{ln}^{2}⁡3}-\\frac{2D}{\\operatorname{ln}⁡3} \\\\  & =x({({log}_{3}⁡x)}^{2}-\\frac{2{log}_{3}⁡(x)}{\\operatorname{ln}⁡3}+\\frac{2}{{ln}^{2}⁡3})+C,\\end{aligned}\n$$\n\nwhere $C=-\\frac{2D}{\\operatorname{ln}⁡3}.$"}] [{:db/id #edb/ref 17592186292572 :knowledge-point/_questions [{:knowledge-point/id #uuid "d2a41ede-381e-55f6-99e5-1baf1ea348a1" :knowledge-point/title "Computing the Integral of a Trigonometric Expression Using Integration by Parts Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "168ff4b3-533f-582d-b25a-979d3efd7f50" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\pi^2+12" :db/id #edb/ref 17592186292574} {:answer/id #uuid "a86f81ec-d4a1-5b3b-a720-98fcd4e8ed18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\pi^2-12" :db/id #edb/ref 17592186292575}] :answer-field/correct {:answer/id #uuid "a86f81ec-d4a1-5b3b-a720-98fcd4e8ed18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}\\pi^2-12" :db/id #edb/ref 17592186292575} :answer-field/id #uuid "40d323e5-1043-5a99-a402-d3f5e604ca44" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292573}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "7c8ed404-9352-554d-b8ea-95293b796d19" :question/math-academy-id "q-352029" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We need to use integration by parts. We'll work out the indefinite integral first, and then proceed to work out the definite integral.\n\nIn this case, we define\n\n$$\n\\begin{aligned}u=6{x}^{2}\\, & ⟹\\,\\frac{\\text{d}u}{\\text{d}x}=12x \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{cos}⁡x\\, & ⟹\\,v=\\int \\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x=\\int \\operatorname{cos}⁡x\\,\\text{d}x=\\operatorname{sin}⁡x.\\end{aligned}\n$$\n\nUsing the formula for integration by parts, we get\n\n$$\n\\begin{aligned}\\int 6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =(6{x}^{2})(\\operatorname{sin}⁡x)-\\int (\\operatorname{sin}⁡x)(12x)\\,\\text{d}x \\\\  & =6{x}^{2}\\operatorname{sin}⁡x-12\\int x\\operatorname{sin}⁡x\\,\\text{d}x.\\end{aligned}\n$$\n\nAgain, we use integration by parts to evaluate $\\int x\\operatorname{sin}⁡x\\,\\text{d}x.$ We take\n\n$$\n\\begin{aligned}u=x & \\,⟹\\,\\frac{\\text{d}u}{\\text{d}x}=1\\,, \\\\ \\frac{\\text{d}v}{\\text{d}x}=\\operatorname{sin}⁡x & \\,⟹\\,v=\\int \\operatorname{sin}⁡x\\text{d}x=-\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nIn this case, the formula for integration by parts gives\n\n$$\n\\begin{aligned}\\int x\\operatorname{sin}⁡x\\,\\text{d}x & =\\int u\\frac{\\text{d}v}{\\text{d}x}\\,\\text{d}x \\\\  & =uv-\\int v\\frac{\\text{d}u}{\\text{d}x}\\,\\text{d}x \\\\  & =x(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)\\,dx \\\\  & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D,\\end{aligned}\n$$\n\nwhere $D$ is an integral constant. \n\nSo, we get that the indefinite integral is\n\n$$\n\\begin{aligned}\\int 6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & =6{x}^{2}\\operatorname{sin}⁡x-12\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =6{x}^{2}\\operatorname{sin}⁡x-12(-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x+D) \\\\  & =6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x+C,\\end{aligned}\n$$\n\nwhere $C=-12D.$\n\nFinally, we can work out the definite integral:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}6{x}^{2}\\operatorname{cos}⁡x\\,\\text{d}x & ={[6{x}^{2}\\operatorname{sin}⁡x+12x\\operatorname{cos}⁡x-12\\operatorname{sin}⁡x]}_{0}^{\\pi /2} \\\\  & =(\\frac{3{\\pi }^{2}}{2}-12)-0 \\\\  & =\\frac{3{\\pi }^{2}}{2}-12\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069320 :knowledge-point/_questions [{:knowledge-point/id #uuid "d2a41ede-381e-55f6-99e5-1baf1ea348a1" :knowledge-point/title "Computing the Integral of a Trigonometric Expression Using Integration by Parts Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e43000d-d261-55a5-a180-481002f03d85" :answer/type {:db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) + 2\\intx\\cos (2x)dx" :db/id #edb/ref 17592186067452} {:answer/id #uuid "90d63a70-4815-58be-9c3d-baa0abafe498" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos (2x) - 2\\intx\\sin (2x)dx" :db/id #edb/ref 17592186067453} {:answer/id #uuid "9cd2a0e1-16c6-58ee-8c30-0ba6e9a6fce2" :answer/type {:db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) + \\intx\\sin (2x)dx" :db/id #edb/ref 17592186067454} {:answer/id #uuid "59d49b1a-803b-53d8-83fa-db70c7789e5c" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos (2x) + \\intx\\cos (2x)dx" :db/id #edb/ref 17592186067455} {:answer/id #uuid "7f31ebbc-a68d-5c7a-8fdb-dfb85730e139" :answer/type {:db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) - 2\\intx\\cos (2x)dx" :db/id #edb/ref 17592186067456}] :answer-field/correct {:answer/id #uuid "8e43000d-d261-55a5-a180-481002f03d85" :answer/type {:db/ident :answer.type/math} :answer/value "-x^{2}\\cos (2x) + 2\\intx\\cos (2x)dx" :db/id #edb/ref 17592186067452} :answer-field/id #uuid "bdc0a1cc-0786-5dc8-94ce-95c2c8213374" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067451}] :question/id #uuid "7db8d1cc-8a1b-5f0d-8178-c39bb5e755e0" :question/math-academy-id "q-49931" :question/problem "What is $\\displaystyle \\int2x^{2}\\sin (2x)dx$?"}]}
