ab49a2cb8ef75ac0b6b02bbe9f1573c257d1123d16d6e3926392" :answer/id #uuid "6fe7f566-e543-5dc5-8f91-7021764ed817" :answer/type :answer.type/math :answer/value "\\frac{1}{s}" :db/ensure [:answer/validate]} {:db/id "q-332818/field-3" :answer-field/id #uuid "a5b76dc8-1783-5f72-a7fc-273377a7794c" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-332818/field-3/e95a22dcb48894635bdea7d6de08114e41918c20fa2ce07a6aaba944993b8057" :answer-field/choices ["q-332818/field-3/689672a08b28fba294c58d7c7551b966529c1867da17fdb3ae1b4ced60fec7d8" "q-332818/field-3/f50990d4800749e632952b0928ef97cb331e9bc980e70ad1e2ee4a2f26c3b16d" "q-332818/field-3/e95a22dcb48894635bdea7d6de08114e41918c20fa2ce07a6aaba944993b8057" "q-332818/field-3/952ee89c9a25ab49a2cb8ef75ac0b6b02bbe9f1573c257d1123d16d6e3926392"] :db/ensure [:answer-field/validate]} {:db/id "q-332818" :question/id #uuid "72d238eb-48c9-5de5-97ab-30b6d926cde0" :question/math-academy-id "q-332818" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+4 \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t)-2,\\end{aligned}\\,x(0)=[\\begin{aligned}1 \\\\ -1\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}{{field-1}}={X}_{1}(s)+{{field-2}} \\\\ s{X}_{2}(s)+1=-{X}_{1}(s)+3{X}_{2}(s)-{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{{x}_{1}(t)+4} \\\\ L{{x}_{2}^{′}(t)}=L{-{x}_{1}(t)+3{x}_{2}(t)-2}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=L{{x}_{1}(t)}+4L{1} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=-L{{x}_{1}(t)}+3L{{x}_{2}(t)}-2L{1}\\end{aligned}\n$$\n\nFinally, using the result\n\n$$\nL{1}=\\frac{1}{s},\n$$\n\n we can write our system as follows:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)-1={X}_{1}(s)+\\frac{4}{s} \\\\ s{X}_{2}(s)+1=-{X}_{1}(s)+3{X}_{2}(s)-\\frac{2}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-332818/field-1" "q-332818/field-2" "q-332818/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca890a8e-9ddd-51f7-9784-c9c1f020adef"] :knowledge-point/questions ["q-332818"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332814/field-1/620138f110c5b16702870709ac46185f7bd258ac249811e9e467771258e94ab7" :answer/id #uuid "a9c17b18-3ec1-5e6b-b4ee-a948b91bef16" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{6}{{s}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-332814/field-1/c999393efec21d7a50f41c3c08f1ae8232b60d8d4c092c5540a59396b0975e36" :answer/id #uuid "6821db9a-2678-5c8d-9477-137ffa52aa91" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{8}{{s}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-332814/field-1/f300a94e78376ccbf431bad1f4c3547c28e37f97c518cce1af4b0b7f03b8dd53" :answer/id #uuid "de26685e-dc49-516f-ba12-93c3c1256a03" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{4}{{s}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-332814/field-1/2c790ab1e56a5f2dc8ce902384ac8bf848e2140a518adac42655f46e33142a52" :answer/id #uuid "846af8c0-37ca-54bd-8480-c23f233ed29c" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{8}{{s}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-332814/field-1" :answer-field/id #uuid "10a837fc-c0df-5c96-bd6e-20c2e32999d4" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-332814/field-1/2