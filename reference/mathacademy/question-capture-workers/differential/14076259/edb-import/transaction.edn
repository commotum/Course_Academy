2825/field-3" :answer-field/id #uuid "abbf0a57-7427-5b8a-8f53-4009cd7c0740" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-332825/field-3/952ee89c9a25ab49a2cb8ef75ac0b6b02bbe9f1573c257d1123d16d6e3926392" :answer-field/choices ["q-332825/field-3/952ee89c9a25ab49a2cb8ef75ac0b6b02bbe9f1573c257d1123d16d6e3926392" "q-332825/field-3/f50990d4800749e632952b0928ef97cb331e9bc980e70ad1e2ee4a2f26c3b16d" "q-332825/field-3/22ae2c9bad1eee1c0fcc921351dd6252fb055675a05403c3e888170a539f02c1" "q-332825/field-3/e95a22dcb48894635bdea7d6de08114e41918c20fa2ce07a6aaba944993b8057"] :db/ensure [:answer-field/validate]} {:db/id "q-332825" :question/id #uuid "d13bb8d6-abdb-56b1-aa9c-35123b36b876" :question/math-academy-id "q-332825" :question/problem "$$\n{\\begin{aligned}{x}_{1}^{′}(t)={x}_{1}(t)+2\\operatorname{cos}⁡(3t) \\\\ {x}_{2}^{′}(t)=-{x}_{1}(t)+3{x}_{2}(t)-1,\\end{aligned}\\,x(0)=[\\begin{aligned}0 \\\\ 2\\end{aligned}]\n$$\n\nConsider the initial value problem above. By applying the Laplace transform to both sides of each equation, we get the system\n\n$$\n{\\begin{aligned}{{field-1}}={{field-2}} \\\\ s{X}_{2}(s)-2=-{X}_{1}(s)+3{X}_{2}(s)-{{field-3}}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/worked-solution "First, we compute the Laplace transforms of both sides of each equation in our system:\n\n$$\n{\\begin{aligned}L{{x}_{1}^{′}(t)}=L{{x}_{1}(t)+2\\operatorname{cos}⁡(3t)} \\\\ L{{x}_{2}^{′}(t)}=L{-{x}_{1}(t)+3{x}_{2}(t)-1}\\end{aligned}\\,\\,\n$$\n\nUsing the derivative property of the Laplace transform, we obtain the system\n\n$$\n{\\begin{aligned}sL{{x}_{1}(t)}-{x}_{1}(0)=L{{x}_{1}(t)}+2L{\\operatorname{cos}⁡(3t)} \\\\ sL{{x}_{2}(t)}-{x}_{2}(0)=-L{{x}_{1}(t)}+3L{{x}_{2}(t)}-L{1}\\end{aligned}\n$$\n\nFinally, using the results\n\n$$\nL{1}=\\frac{1}{s},\\,L{\\operatorname{cos}⁡(3t)}=\\frac{s}{{s}^{2}+9},\n$$\n\nwe can write our system as follows:\n\n$$\n{\\begin{aligned}s{X}_{1}(s)={X}_{1}(s)+\\frac{2s}{{s}^{2}+9} \\\\ s{X}_{2}(s)-2=-{X}_{1}(s)+3{X}_{2}(s)-\\frac{1}{s}\\end{aligned}\n$$\n\nwhere ${X}_{1}(s)=L{{x}_{1}(t)}$ and ${X}_{2}(s)=L{{x}_{2}(t)}$ are the Laplace transforms of the functions ${x}_{1}(t)$ and ${x}_{2}(t),$ respectively." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-332825/field-1" "q-332825/field-2" "q-332825/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca890a8e-9ddd-51f7-9784-c9c1f020adef"] :knowledge-point/questions ["q-332825"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332820/field-1/304ac8c95bf8ace33cd7171753650e7fb623e3e7e77de62f90ca6de0b270423c" :answer/id #uuid "fbcf8136-ba42-54af-8008-e7c8794c08a0" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{6}{s}" :db/ensure [:answer/validate]} {:db/id "q-332820/field-1/7df7df2d2d88433c6ab3dd5d333dc1f1ab04245c4daae793826e79ed62c413d0" :answer/id #uuid "bda3602c-f16f-5b69-9385-b65673b15dc2" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{5}{s}" :db/ensure [:answer/validate]} {:db/id "q-332820/field-1/ed4d2cd7ae890b486ea0752dc4635a06676a090ffbe56c3c24e793a782511637" :answer/id #uuid "d23b7b92-0e99-5f38-bcce-a9eaa76d9670" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{3}{s}" :db/ensure [:answer/validate]} {:db/id "q-332820/field-1/cd1a3f18cf2264dec43987aa179d03aa0c64897cd9aa6066267f13055dca9308" :answer/id #uuid "11948bc7-0cf6-5016-9a2b-f152b0356e5b" :answer/type :answer.type/math :answer/value "{X}_{1}(s)+\\frac{4}{s}" :db/ensure [:answer/validate]} {:db/id "q-332820/field-1" :answer-field/id #uuid "dd206a4f-2ce7-57c8-8033-55f31fc42c38" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-332820/field-1/304ac8c95bf8ace33cd7171753650e7fb623e3e7e77de62f90ca6de0b270423c" :answer-field/choices ["q-332820/field-1/304ac8c95bf8ace