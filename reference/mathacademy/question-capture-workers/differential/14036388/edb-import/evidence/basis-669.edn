#{[{:db/id #edb/ref 17592186275711 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "02299284-7905-5e23-a99b-fab257fad339" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186275713} {:answer/id #uuid "45f7f7ff-fa85-556d-ac9b-fb6cf116a017" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275714} {:answer/id #uuid "96b91ed0-23a5-5a64-b958-be50242ffb32" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275715} {:answer/id #uuid "19d23dce-89ec-5bf3-8b43-cb25fdebb900" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275716} {:answer/id #uuid "29f955b3-1f9d-5ebc-9826-4d116af6cf84" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275717}] :answer-field/correct {:answer/id #uuid "19d23dce-89ec-5bf3-8b43-cb25fdebb900" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275716} :answer-field/id #uuid "d3289c5e-cad9-5a38-9f0d-b79099f92a16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275712}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b1e8835d-2849-5c15-b2b3-5060e0821698" :question/math-academy-id "q-31585" :question/problem "${lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1}=$" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & ={lim}_{x\\to 0}\\frac{[{e}^{x}-x-1]^{′}}{[\\operatorname{cos}⁡x-1]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{e}^{x}-1}{-\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{[{e}^{x}-1]^{′}}{[\\operatorname{sin}⁡x]^{′}} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}}{\\operatorname{cos}⁡x} \\\\  & =-\\frac{{e}^{0}}{\\operatorname{cos}⁡0} \\\\  & =-\\frac{1}{1} \\\\  & =-1.\\end{aligned}\n$$"}]}
