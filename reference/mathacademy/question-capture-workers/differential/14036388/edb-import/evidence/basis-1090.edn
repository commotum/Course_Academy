#{[{:db/id #edb/ref 17592186286502 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ffd25587-a492-5f8f-84f4-e747217aa1ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}" :db/id #edb/ref 17592186286504} {:answer/id #uuid "749265ec-a632-578c-ba48-869c9af399ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286505} {:answer/id #uuid "a650c7fe-4f48-528b-8b34-de554a108c90" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186286506} {:answer/id #uuid "3b14a418-103a-5fb6-8f04-63ddc02daabf" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286507} {:answer/id #uuid "ff4783dc-8d72-5371-819c-07486a86cbe3" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186286508}] :answer-field/correct {:answer/id #uuid "749265ec-a632-578c-ba48-869c9af399ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186286505} :answer-field/id #uuid "88dad7ce-ab8f-53b2-ae30-acd9f22d68bf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286503}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "81f753e1-569a-5d13-ba2f-798190f0ed00" :question/math-academy-id "q-114245" :question/problem "${lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1}=$" :question/worked-solution "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{{[1-x+x\\operatorname{ln}⁡x]}^{′}}{{[{x}^{2}-2x+1]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{\\operatorname{ln}⁡x}{2x-2}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{\\operatorname{ln}⁡x}{2x-2} \\\\  & ={lim}_{x\\to 1}\\frac{{[\\operatorname{ln}⁡x]}^{′}}{{[2x-2]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{(\\frac{1}{x})}{2} \\\\  & ={lim}_{x\\to 1}\\frac{1}{2x} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286526 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da55b3cd-b3e8-59e9-b9e8-070e83112e52" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186286528} {:answer/id #uuid "07087731-666d-58af-a2e7-6a0a907cf3d5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186286529} {:answer/id #uuid "02e62621-c735-5fdf-b340-2c7fa45763c6" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286530} {:answer/id #uuid "0d1bb1e8-02a3-58ad-874f-067a6a2b11d1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286531} {:answer/id #uuid "f0cdfcb3-2017-5148-b268-7e1b92ce6a2b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186286532}] :answer-field/correct {:answer/id #uuid "0d1bb1e8-02a3-58ad-874f-067a6a2b11d1" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286531} :answer-field/id #uuid "4d31bd59-f417-56ce-bfde-f80567be8b4d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286527}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "841794cb-2192-56f5-9b25-7e39f616568c" :question/math-academy-id "q-72328" :question/problem "${lim}_{x\\to \\infty }\\frac{100x}{{x}^{2}-1}=$" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{100x}{{x}^{2}-1} & ={lim}_{x\\to \\infty }\\frac{[100x]^{′}}{[{x}^{2}-1]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{100}{2x} \\\\  & =0.\\end{aligned}\n$$"}]}
