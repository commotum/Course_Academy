c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336874" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{5{x}^{3}+6{x}^{2}-11}{4{x}^{3}-4} & ={lim}_{x\\to 1}\\frac{[5{x}^{3}+6{x}^{2}-11]^{′}}{[4{x}^{3}-4]^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{15{x}^{2}+12x}{12{x}^{2}} \\\\  & =\\frac{15(1)^{2}+12(1)}{12(1)^{2}} \\\\  & =\\frac{15+12}{12} \\\\  & =\\frac{9}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336874" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-336874" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336874" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9}{4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336879" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{{x}^{2}-4x}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336879" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\operatorname{sin}⁡x}{{x}^{2}-4x} & ={lim}_{x\\to 0}\\frac{[\\operatorname{sin}⁡x]^{′}}{[{x}^{2}-4x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{\\operatorname{cos}⁡x}{2x-4} \\\\  & =\\frac{\\operatorname{cos}⁡(0)}{2(0)-4} \\\\  & =\\frac{1}{0-4} \\\\  & =-\\frac{1}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336879" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-336879" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336879" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114252" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 0}\\frac{x{e}^{-x}-x+2{x}^{2}}{{sin}^{2}⁡x}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114252" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{x{e}^{-x}-x+2{x}^{2}}{{sin}^{2}⁡x} & ={lim}_{x\\to 0}\\frac{[x{e}^{-x}-x+2{x}^{2}]^{′}}{[{sin}^{2}⁡x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(1-x){e}^{-x}-1+4x}{2\\operatorname{sin}⁡x\\operatorname{cos}⁡x} \\\\  & ={lim}_{x\\to 0}\\frac{(1-x){e}^{-x}-1+4x}{\\operatorname{sin}⁡2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{x{e}^{-x}-x+2{x}^{2}}{{sin}^{2}⁡x} & ={lim}_{x\\to 0}\\frac{(1-x){e}^{-x}-1+4x}{\\operatorname{sin}⁡2x} \\\\  & ={lim}_{x\\to 0}\\frac{[(1-x){e}^{-x}-1+4x]^{′}}{[\\operatorname{sin}⁡2x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(x-2){e}^{-x}+4}{2\\operatorname{cos}⁡2x} \\\\  & =\\frac{(0-2){e}^{0}+4}{2\\operatorname{cos}⁡0} \\\\  & =\\frac{-2+4}{2} \\\\  & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114252" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-114252" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114252" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "3"] ["math" "\\frac{1}{2}"] ["math" "\\frac{1}{4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114252" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336932" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x}{1-\\operatorname{cos}⁡(3x)}=\\frac{1}{9}((\\operatorname{ln}⁡4)^{2}-$\n{{field-1}}\n$)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336932" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x}{1-\\operatorname{cos}⁡(3x)} & ={lim}_{x\\to 0}\\frac{{[{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x]}^{′}}{{[1-\\operatorname{cos}⁡(3x)]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)}{3\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)}{\\operatorname{sin}⁡(3x)}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{4}^{x}-{9}^{x}-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)x}{1-\\operatorname{cos}⁡(3x)} & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)}{\\operatorname{sin}⁡(3x)} \\\\  & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{[{4}^{x}\\operatorname{ln}⁡4-{9}^{x}\\operatorname{ln}⁡9-(\\operatorname{ln}⁡4-\\operatorname{ln}⁡9)]}^{′}}{{[\\operatorname{sin}⁡(3x)]}^{′}} \\\\  & =\\frac{1}{3}{lim}_{x\\to 0}\\frac{{4}^{x}(\\operatorname{ln}⁡4)^{2}-{9}^{x}(\\operatorname{ln}⁡9)^{2}}{3\\operatorname{cos}⁡(3x)} \\\\  & =\\frac{1}{9}\\cdot \\frac{(\\operatorname{ln}⁡4)^{2}-(\\operatorname{ln}⁡9)^{2}}{1} \\\\  & =\\frac{1}{9}((\\operatorname{ln}⁡4)^{2}-(\\operatorname{ln}⁡9)^{2}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336932" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-336932" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336932" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\ln(9))^2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336910" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{x}^{2}}{1-\\operatorname{cos}⁡(x)}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336910" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{x}^{2}}{1-\\operatorname{cos}⁡(x)} & ={lim}_{x\\to 0}\\frac{{[{x}^{2}]}^{′}}{[1-\\operatorname{cos}⁡(x)]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{2x}{\\operatorname{sin}⁡(x)}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{x}^{2}}{1-\\operatorname{cos}⁡(x)} & ={lim}_{x\\to 0}\\frac{2x}{\\operatorname{sin}⁡(x)} \\\\  & ={lim}_{x\\to 0}\\frac{{[2x]}^{′}}{{[\\operatorname{sin}⁡(x)]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{2}{\\operatorname{cos}⁡(x)} \\\\  & =2{lim}_{x\\to 0}\\frac{1}{\\operatorname{cos}⁡(x)} \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336910" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-336910" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336910" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31585" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31585" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & ={lim}_{x\\to 0}\\frac{[{e}^{x}-x-1]^{′}}{[\\operatorname{cos}⁡x-1]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{e}^{x}-1}{-\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{x}-x-1}{\\operatorname{cos}⁡x-1} & =-{lim}_{x\\to 0}\\frac{{e}^{x}-1}{\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to 0}\\frac{[{e}^{x}-1]^{′}}{[\\operatorname{sin}⁡x]^{′}} \\\\  & =-{lim}_{x\\to 0}\\frac{{e}^{x}}{\\operatorname{cos}⁡x} \\\\  & =-\\frac{{e}^{0}}{\\operatorname{cos}⁡0} \\\\  & =-\\frac{1}{1} \\\\  & =-1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31585" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-31585" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31585" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "0"] ["math" "1"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31585" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114245" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114245" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{{[1-x+x\\operatorname{ln}⁡x]}^{′}}{{[{x}^{2}-2x+1]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{\\operatorname{ln}⁡x}{2x-2}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{1-x+x\\operatorname{ln}⁡x}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{\\operatorname{ln}⁡x}{2x-2} \\\\  & ={lim}_{x\\to 1}\\frac{{[\\operatorname{ln}⁡x]}^{′}}{{[2x-2]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{(\\frac{1}{x})}{2} \\\\  & ={lim}_{x\\to 1}\\frac{1}{2x} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114245" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-114245" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114245" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\frac{1}{2}"] ["math" "1"] ["math" "2"] ["math" "\\frac{1}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-114245" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336787" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to {0}^{+}}\\frac{{e}^{3/{x}^{2}}}{(\\frac{1}{{x}^{2}})}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336787" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}{e}^{3/{x}^{2}}=\\infty $ and ${lim}_{x\\to {0}^{+}}(\\frac{1}{{x}^{2}})=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{{e}^{3/{x}^{2}}}{(\\frac{1}{{x}^{2}})} & ={lim}_{x\\to {0}^{+}}\\frac{[{e}^{3/{x}^{2}}]^{′}}{{[\\frac{1}{{x}^{2}}]}^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{{e}^{3/{x}^{2}}(-\\frac{6}{{x}^{3}})}{(-\\frac{2}{{x}^{3}})} \\\\  & =3{lim}_{x\\to {0}^{+}}\\frac{{e}^{3/{x}^{2}}\\cancel{(\\frac{1}{{x}^{3}})}}{\\cancel{(\\frac{1}{{x}^{3}})}} \\\\  & =3{lim}_{x\\to {0}^{+}}{e}^{3/{x}^{2}} \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336787" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-336787" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336787" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336782" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)}{\\operatorname{cot}⁡(2x)}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336782" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{csc}⁡(x)=\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{cot}⁡(2x)=\\infty ,$ respectively, so we have the indeterminate form $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)}{\\operatorname{cot}⁡(2x)} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{csc}⁡(x)]^{′}}{[\\operatorname{cot}⁡(2x)]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{-\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{-2{csc}^{2}⁡(2x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{2{csc}^{2}⁡(2x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{\\operatorname{sin}⁡(x)})(\\frac{\\operatorname{cos}⁡(x)}{\\operatorname{sin}⁡(x)})}{2(\\frac{1}{{sin}^{2}⁡(2x)})} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){sin}^{2}⁡(2x)}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){(2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x))}^{2}}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x)\\cdot 4{sin}^{2}⁡(x){cos}^{2}⁡(x)}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{4{cos}^{3}⁡(x)\\cancel{{sin}^{2}⁡(x)}}{2\\cancel{{sin}^{2}⁡(x)}} \\\\  & ={lim}_{x\\to {0}^{+}}2{cos}^{3}⁡(x) \\\\  & =2{cos}^{3}⁡(0) \\\\  & =2\\cdot 1 \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336782" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-336782" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336782" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115523" "field" nil "attribute" "question/problem" "value" "Evaluate ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{tan}⁡x}{{e}^{\\operatorname{tan}⁡x}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115523" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\operatorname{tan}⁡x=\\infty $ and ${lim}_{x\\to {\\frac{\\pi }{2}}^{-}}{e}^{\\operatorname{tan}⁡x}=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\operatorname{tan}⁡x}{{e}^{\\operatorname{tan}⁡x}} & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{[\\operatorname{tan}⁡x]^{′}}{{[{e}^{\\operatorname{tan}⁡x}]}^{′}} \\\\  & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{{sec}^{2}⁡x}{{sec}^{2}⁡x\\cdot {e}^{\\operatorname{tan}⁡x}} \\\\  & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{\\cancel{{sec}^{2}⁡x}}{\\cancel{{sec}^{2}⁡x}\\cdot {e}^{\\operatorname{tan}⁡x}} \\\\  & ={lim}_{x\\to {\\frac{\\pi }{2}}^{-}}\\frac{1}{{e}^{\\operatorname{tan}⁡x}} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115523" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-115523" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115523" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\infty "] ["math" "0"] ["math" "1"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115523" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72333" "field" nil "attribute" "question/problem" "value" "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72333" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡x=-\\infty $ and ${lim}_{x\\to {0}^{+}}{e}^{1/x}=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡x}{{e}^{1/x}} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡x]^{′}}{[{e}^{1/x}]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{{e}^{1/x}(-\\frac{1}{{x}^{2}})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{{e}^{1/x}\\cdot {x}^{-2}} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{x}{{e}^{1/x}} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72333" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-72333" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72333" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "0"] ["math" "2"] ["math" "4"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72333" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115517" "field" nil "attribute" "question/problem" "value" "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{\\operatorname{cot}⁡x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115517" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\frac{1}{x}=\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{cot}⁡x=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{\\operatorname{cot}⁡x} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\frac{1}{x}]}^{′}}{{[\\operatorname{cot}⁡x]}^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(-\\frac{1}{{x}^{2}})}{-{csc}^{2}⁡x} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{sin}^{2}⁡x})} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{{sin}^{2}⁡x}{{x}^{2}} \\\\  & ={({lim}_{x\\to {0}^{+}}\\frac{\\operatorname{sin}⁡x}{x})}^{2}.\\end{aligned}\n$$\n\nThis time, the resulting limit gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{\\operatorname{cot}⁡x} & ={({lim}_{x\\to {0}^{+}}\\frac{\\operatorname{sin}⁡x}{x})}^{2} \\\\  & ={({lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{sin}⁡x]^{′}}{[x]^{′}})}^{2} \\\\  & ={({lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡x}{1})}^{2} \\\\  & ={(\\operatorname{cos}⁡0)}^{2} \\\\  & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115517" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-115517" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115517" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2\\pi "] ["math" "\\frac{1}{2}"] ["math" "\\pi "] ["math" "{\\pi }^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-115517" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31597" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x}{{e}^{x}}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31597" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{{[2\\operatorname{ln}⁡x]}^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{x})}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31597" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-31597" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31597" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "0"] ["math" "1"] ["math" "2"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31597" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336971" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336971" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & ={lim}_{x\\to \\infty }\\frac{[{x}^{3}]^{′}}{[{ln}^{2}⁡x]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{3{x}^{2}}{(\\frac{2\\operatorname{ln}⁡x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{3{x}^{3}}{2\\operatorname{ln}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & ={lim}_{x\\to \\infty }\\frac{[3{x}^{3}]^{′}}{{[2\\operatorname{ln}⁡x]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{9{x}^{2}}{(\\frac{2}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{9{x}^{3}}{2} \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336971" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-336971" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-336971" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31257" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to \\infty }\\frac{\\sqrt{x}+4x+3}{2x+3}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31257" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{\\sqrt{x}+4x+3}{2x+3} & ={lim}_{x\\to \\infty }\\frac{[\\sqrt{x}+4x+3]^{′}}{[2x+3]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{2\\sqrt{x}}+4)}{2} \\\\  & =\\frac{0+4}{2} \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31257" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-31257" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31257" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "0"] ["math" "1"] ["math" "2"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31257" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72328" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to \\infty }\\frac{100x}{{x}^{2}-1}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72328" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{100x}{{x}^{2}-1} & ={lim}_{x\\to \\infty }\\frac{[100x]^{′}}{[{x}^{2}-1]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{100}{2x} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72328" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-72328" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72328" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\infty "] ["math" "0"] ["math" "1"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-72328" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31517" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31517" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{[x\\operatorname{ln}⁡x]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{x\\operatorname{ln}⁡x}{{e}^{x}} & ={lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡x+1}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{[\\operatorname{ln}⁡x+1]^{′}}{[{e}^{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{x})}{{e}^{x}} \\\\  & ={lim}_{x\\to \\infty }\\frac{1}{x{e}^{x}} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31517" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/activity-metadata.json" "file_sha256" "3b2a77a80d73e1184b4b9ea714112cff4f9671a324fc00a8a1c05c5def17292b"} {"question" "q-31517" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31517" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "0"] ["math" "1"] ["math" "2"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "q-31517" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/state.json" "file_sha256" "6e943508857c8fc4bf139c120f82525d89fc4b72008f31c338c3397b53e55c5d"} {"question" "e-300" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\lim_{x\\rightarrow 3}\\dfrac{x^3-27}{x-3}$." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-300.json" "file_sha256" "3fa49fb89cc3f449d566bcc77f2daf2d593590a363e8b05788c7b2490422c630"} {"question" "e-300" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=3$ gives the indeterminate form $\\dfrac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\eqalign{\n\\lim_{x\\to 3}  \\dfrac {x^3-27}{x-3} \n&= \\lim_{x\\to3}  \\dfrac {[x^3-27]'}{[x-3]'}\\[5pt]\n&= \\lim_{x\\to 3}  \\dfrac {3x^2}{1}\\[5pt]\n&=  3(3)^2\\[5pt]\n&= 27\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-300.json" "file_sha256" "3fa49fb89cc3f449d566bcc77f2daf2d593590a363e8b05788c7b2490422c630"} {"question" "e-301" "field" nil "attribute" "question/problem" "value" "Evaluate  $\\displaystyle \\lim_{x\\to 0} \\, \\frac {\\sin^2 (2x)}{x^2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-301.json" "file_sha256" "0240bd5760ae0f49edcc6a7c9fc2e6f9761a534c0714533e0c12d51dd544327a"} {"question" "e-301" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\dfrac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\eqalign{\n\\lim_{x\\to0}  \\dfrac{\\sin^2 (2x)}{x^2} &= \\lim_{x\\to 0}  \\dfrac {\\left[\\sin^2 (2x)\\right]'}{[x^2]'}\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{2\\cdot \\sin (2x) \\cdot\\cos (2x)\\cdot 2}{2x}\\[5pt]\n&= \\lim_{x\\to 0}{2\\cos (2x)} \\cdot \\lim_{x\\to 0} \\dfrac{\\sin (2x)}{x}\\[5pt]\n&= 2\\cos(2\\cdot 0)\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x}\\[5pt]\n&= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x}\n}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\dfrac{0}{0}.$ But that's okay, because we can just apply L'Hopital's rule again! We get\n\n$$\n\\eqalign{\n\\lim_{x\\to0}  \\dfrac{\\sin^2 (2x)}{x^2} &= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x}\\[5pt]\n&=  2\\lim_{x\\to0}  \\dfrac {[\\sin (2x)]'}{[x]'}\\[5pt]\n&=  2\\lim_{x\\to0}  \\dfrac {2\\cos (2x)}{1}\\[5pt]\n&= 4\\cos(2\\cdot 0)\\\n&=4.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-301.json" "file_sha256" "0240bd5760ae0f49edcc6a7c9fc2e6f9761a534c0714533e0c12d51dd544327a"} {"question" "e-302" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\lim_{x\\to 0}  \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)} .$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-302.json" "file_sha256" "148ec8403f65ecfb7ab128467ee7c615a0853467a05774c8db925ea02236c95a"} {"question" "e-302" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are\n$\\displaystyle\n \\lim_{x\\to 0}  \\ln\\left(x^2\\right) = -\\infty$ and $\\displaystyle \\lim_{x\\to 0} \\dfrac{2}{x^2} = \\infty$ respectively,\nso we have the case $\\dfrac{-\\infty}{\\infty}$.\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\eqalign{\n\\lim_{x\\to 0}  \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)} &= \\lim_{x\\to 0}  \\dfrac{[\\ln\\left(x^2\\right)]'}{\\left(\\dfrac{2}{x^2}\\right)'}\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{\\left(1/x^2\\right)\\cdot 2x}{-\\left({4}/{x^3}\\right)}\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{x^{-2} \\cdot 2x}{-4x^{-3} }\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{2x^{-1}}{-4x^{-3} }\\[5pt]\n&= -\\dfrac{1}{2}  \\lim_{x\\to 0} {x^2}\\[5pt]\n&= -\\dfrac{1}{2}\\cdot 0\\[5pt]\n&= 0.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-302.json" "file_sha256" "148ec8403f65ecfb7ab128467ee7c615a0853467a05774c8db925ea02236c95a"} {"question" "e-303" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\displaystyle \\lim_{x\\to\\infty}  \\frac {x^6}{5x^6-4} }.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-303.json" "file_sha256" "3aa3190786d7e95470add384d807b1fabcd71ffff71d43f753bb85d7e5864aee"} {"question" "e-303" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\dfrac{\\infty}{\\infty},$ so applying  L'Hopital's rule yields\n\n$$\n\\eqalign{\n\\lim_{x\\to \\infty}  \\dfrac {x^6}{5x^6-4} &= \\lim_{x\\to\\infty}  \\dfrac {[x^6]'}{[5x^6-4]'}\\\n&= \\lim_{x\\to \\infty}  \\dfrac {6x^5}{5(6x^5)-0}\\\n&=  \\lim_{x\\to \\infty}  \\dfrac {1}{5}\\\n&= \\dfrac{1}{5}.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036388/example-303.json" "file_sha256" "3aa3190786d7e95470add384d807b1fabcd71ffff71d43f753bb85d7e5864aee"}] "usage" {"q-336932" [] "q-31585" [] "e-303" [] "q-31517" [] "q-31257" [] "q-72333" [] "q-114245" [] "e-300" [] "q-72328" [] "e-301" [] "q-31597" [] "e-302" []} "basis" 1259 "retractions" [[17592186069170 :question/problem "What is $\\displaystyle \\lim_{x \\to \\infty}\\frac{2\\ln x}{e^{x}}$?"] [17592186068455 :question/worked-solution "Note that plugging in $x=3$ gives the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\nHowever, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned} \\lim_{x\\to 3} \\dfrac {x^3-27}{x-3} &= \\lim_{x\\to3} \\dfrac {[x^3-27]'}{[x-3]'} \\\\[5pt] &= \\lim_{x\\to 3} \\dfrac {3x^2}{1} \\\\[5pt] &= 3(3)^2 \\\\[5pt] &= 27 \\end{aligned}\n$$"] [17592186068456 :question/problem "Evaluate $\\displaystyle \\lim_{x\\to 0} \\, \\frac {\\sin^2 (2x)}{x^2}$."] [17592186068456 :question/worked-solution "If we plug in $x=0$ we get the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\nso we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned} \\lim_{x\\to0} \\dfrac{\\sin^2 (2x)}{x^2} &= \\lim_{x\\to 0} \\dfrac {\\left[\\sin^2 (2x)\\right]'}{[x^2]'} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{2\\cdot \\sin (2x) \\cdot\\cos (2x)\\cdot 2}{2x} \\\\[5pt] &= \\lim_{x\\to 0}{2\\cos (2x)} \\cdot \\lim_{x\\to 0} \\dfrac{\\sin (2x)}{x} \\\\[5pt] &= 2\\cos(2\\cdot 0)\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x} \\\\[5pt] &= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x} \\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form\n\n$$\n\\dfrac{0}{0}\n$$\n\nBut that's okay, because we can just apply L'Hopital's rule again! We get\n\n$$\n\\begin{aligned} \\lim_{x\\to0} \\dfrac{\\sin^2 (2x)}{x^2} &= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x} \\\\[5pt] &= 2\\lim_{x\\to0} \\dfrac {[\\sin (2x)]'}{[x]'} \\\\[5pt] &= 2\\lim_{x\\to0} \\dfrac {2\\cos (2x)}{1} \\\\[5pt] &= 4\\cos(2\\cdot 0) \\\\ &=4. \\end{aligned}\n$$"] [17592186068457 :question/problem "Evaluate $\\displaystyle \\lim_{x\\to 0} \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)}$."] [17592186068457 :question/worked-solution "Here the limits of the numerator and denominator are\n\n$$\n\\displaystyle \\lim_{x\\to 0} \\ln\\left(x^2\\right) = -\\infty\n$$\n\nand\n\n$$\n\\displaystyle \\lim_{x\\to 0} \\dfrac{2}{x^2} = \\infty\n$$\n\nrespectively,\nso we have the case\n\n$$\n\\dfrac{-\\infty}{\\infty}\n$$\n\n.\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned} \\lim_{x\\to 0} \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)} &= \\lim_{x\\to 0} \\dfrac{[\\ln\\left(x^2\\right)]'}{\\left(\\dfrac{2}{x^2}\\right)'} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{\\left(1/x^2\\right)\\cdot 2x}{-\\left({4}/{x^3}\\right)} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{x^{-2} \\cdot 2x}{-4x^{-3}} \\\\[5pt] &= \\lim_{x\\to 0} \\dfrac{2x^{-1}}{-4x^{-3}} \\\\[5pt] &= -\\dfrac{1}{2} \\lim_{x\\to 0} {x^2} \\\\[5pt] &= -\\dfrac{1}{2}\\cdot 0 \\\\[5pt] &= 0. \\end{aligned}\n$$"] [17592186068458 :question/problem "Evaluate ${\\displaystyle \\lim_{x\\to\\infty} \\frac {x^6}{5x^6-4}}$."] [17592186068458 :question/worked-solution "In this case, we have an indeterminate form of type\n\n$$\n\\dfrac{\\infty}{\\infty}\n$$\n\nso applying L'Hopital's rule yields\n\n$$\n\\begin{aligned} \\lim_{x\\to \\infty} \\dfrac {x^6}{5x^6-4} &= \\lim_{x\\to\\infty} \\dfrac {[x^6]'}{[5x^6-4]'} \\\\ &= \\lim_{x\\to \\infty} \\dfrac {6x^5}{5(6x^5)-0} \\\\ &= \\lim_{x\\to \\infty} \\dfrac {1}{5} \\\\ &= \\dfrac{1}{5}. \\end{aligned}\n$$"]] "immutable_answers" [17592186066552 17592186066553 17592186066554 17592186066555 17592186066556 17592186264186 17592186264187 17592186264188 17592186264189 17592186264190 17592186264196 17592186264197 17592186264198 17592186264199 17592186264200 17592186264238 17592186264252 17592186264253 17592186264254 17592186264255 17592186264256 17592186275713 17592186275714 17592186275715 17592186275716 17592186275717 17592186286504 17592186286505 17592186286506 17592186286507 17592186286508 17592186286528 17592186286529 17592186286530 17592186286531 17592186286532] "immutable_fields" [[17592186066551 :answer-field/correct] [17592186066551 :answer-field/id] [17592186066551 :answer-field/key] [17592186066551 :answer-field/type] [17592186264185 :answer-field/correct] [17592186264185 :answer-field/id] [17592186264185 :answer-field/key] [17592186264185 :answer-field/type] [17592186264195 :answer-field/correct] [17592186264195 :answer-field/id] [17592186264195 :answer-field/key] [17592186264195 :answer-field/type] [17592186264237 :answer-field/correct] [17592186264237 :answer-field/id] [17592186264237 :answer-field/key] [17592186264237 :answer-field/type] [17592186264251 :answer-field/correct] [17592186264251 :answer-field/id] [17592186264251 :answer-field/key] [17592186264251 :answer-field/type] [17592186275712 :answer-field/correct] [17592186275712 :answer-field/id] [17592186275712 :answer-field/key] [17592186275712 :answer-field/type] [17592186286503 :answer-field/correct] [17592186286503 :answer-field/id] [17592186286503 :answer-field/key] [17592186286503 :answer-field/type] [1