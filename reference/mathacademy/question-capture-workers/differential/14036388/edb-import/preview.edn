o 0}\\frac{2}{\\operatorname{cos}⁡(x)} \\\\  & =2{lim}_{x\\to 0}\\frac{1}{\\operatorname{cos}⁡(x)} \\\\  & =2.\\end{aligned}\n$$" 13194139534572 true] [17592186296271 1000 #edb/ref 17592186296272 13194139534572 true] [17592186296271 1040 #edb/ref 17592186045449 13194139534572 true] [17592186296271 1041 "field-1" 13194139534572 true] [17592186296271 1104 #edb/ref 17592186296272 13194139534572 true] [17592186296271 1110 #uuid "76a43d30-43ed-5cdf-90ad-be1e3e53597f" 13194139534572 true] [17592186296272 1034 "2" 13194139534572 true] [17592186296272 1103 #edb/ref 17592186045453 13194139534572 true] [17592186296272 1111 #uuid "9c82f9f4-cb1e-51c7-90ff-b7bb219bd1ca" 13194139534572 true] [17592186296273 1034 "(\\ln(4))^2" 13194139534572 true] [17592186296273 1103 #edb/ref 17592186045453 13194139534572 true] [17592186296273 1111 #uuid "333fcf9c-5ec8-5552-ad22-66943ec6c9cf" 13194139534572 true] [17592186296274 1017 #edb/ref 17592186296275 13194139534572 true] [17592186296274 1089 "q-336971" 13194139534572 true] [17592186296274 1091 #edb/ref 17592186045465 13194139534572 true] [17592186296274 1100 "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x}=$\n{{field-1}}" 13194139534572 true] [17592186296274 1113 #uuid "eb212d02-e01a-5a05-96a9-bd2df6014b4a" 13194139534572 true] [17592186296274 1145 "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & ={lim}_{x\\to \\infty }\\frac{[{x}^{3}]^{′}}{[{ln}^{2}⁡x]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{3{x}^{2}}{(\\frac{2\\operatorname{ln}⁡x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{3{x}^{3}}{2\\operatorname{ln}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & 