name{cot}⁡(2x)} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{csc}⁡(x)]^{′}}{[\\operatorname{cot}⁡(2x)]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{-\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{-2{csc}^{2}⁡(2x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{csc}⁡(x)\\operatorname{cot}⁡(x)}{2{csc}^{2}⁡(2x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{\\operatorname{sin}⁡(x)})(\\frac{\\operatorname{cos}⁡(x)}{\\operatorname{sin}⁡(x)})}{2(\\frac{1}{{sin}^{2}⁡(2x)})} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){sin}^{2}⁡(2x)}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x){(2\\operatorname{sin}⁡(x)\\operatorname{cos}⁡(x))}^{2}}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡(x)\\cdot 4{sin}^{2}⁡(x){cos}^{2}⁡(x)}{2{sin}^{2}⁡(x)} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{4{cos}^{3}⁡(x)\\cancel{{sin}^{2}⁡(x)}}{2\\cancel{{sin}^{2}⁡(x)}} \\\\  & ={lim}_{x\\to {0}^{+}}2{cos}^{3}⁡(x) \\\\  & =2{cos}^{3}⁡(0) \\\\  & =2\\cdot 1 \\\\  & =2.\\end{aligned}\n$$" 13194139534572 true] [17592186296257 1000 #edb/ref 17592186296258 13194139534572 true] [17592186296257 1000 #edb/ref 17592186296259 13194139534572 true] [17592186296257 1040 #edb/ref 17592186045449 13194139534572 true] [17592186296257 1041 "field-1" 13194139534572 true] [17592186296257 1104 #edb/ref 17592186296258 13194139534572 true] [17592186296257 1110 #uuid "7f0e3ee9-a364-50d4-9c4e-1c649c388b05" 13194139534572 true] [17592186296258 1034 "2" 13194139534572 true] [17592186296258 1103 #edb/ref 17592186045453 13194139534572 true] [17592186296258 1111 #uuid "d483070b-321e-52c4-9503-66f96824a418" 13194139534572 true] [17592186296259 1034 "1" 13194139534572 true] [17592186296259 1103 #edb/ref 17592186045453 13194139534572 true] [17592186296259 1111 #uuid "1cef9843-1327-529c-8122-51addf761c1e" 13194139534572 true] [17592186296260 1017 #edb/ref 17592186296261 13194139534572 true] [17592186296260 1089 "q-336787" 13194139534572 true] [17592186296260 1091 #