[{:db/id [:question/math-academy-id "q-64217"] :question/problem "The function $y(t)$ gives the position of a particle at time $t.$ Which of the following equations represents a situation in which the particle is undergoing simple harmonic motion?" :question/worked-solution "The simple harmonic motion (SHM) equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nWe can see that the only equation that represents SHM is\n\n$$\n{y}^{″}+4y=0.\n$$\n\nIn the above case:\n\n$$\n{\\omega }^{2}=4\\,⟹\\,\\omega =2\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-94268/selection/b93e53501cd2fc582b14c41183633e0325dcfb639ed84ddfda748648cf5d0fc2" :answer/id #uuid "1b9894c9-c90b-528e-97da-090158f81c8e" :answer/type :answer.type/math :answer/value "{y}^{″}+8y=0" :db/ensure [:answer/validate]} {:db/id "q-94268/selection/f8f967b9ba0dfd72e23a0625c740443c473c6497af883375facfecbc4fd94c2f" :answer/id #uuid "b1145be8-bc61-551f-b464-54e0abc66124" :answer/type :answer.type/math :answer/value "{y}^{″}+9{y}^{′}+3y=0" :db/ensure [:answer/validate]} {:db/id "q-94268/selection/540e313dce431a8ea3a1de5db209ef5f43385502c2cd8783650d122cbe365603" :answer/id #uuid "45517759-afc6-51a1-a051-4fedb984fd87" :answer/type :answer.type/math :answer/value "{y}^{″}-4y=0" :db/ensure [:answer/validate]} {:db/id "q-94268/selection/735ceb36c056ea9c83000cdb582d54ecbbc0d07b5065154bfe74793e26723a07" :answer/id #uuid "10f4727e-c451-584d-91e5-d5cda4e9a124" :answer/type :answer.type/math :answer/value "{y}^{″}+2=0" :db/ensure [:answer/validate]} {:db/id "q-94268/selection/a314f31d4dc48987ba33da88e455c71a4c35c39ec08d2650a2aab67fb8a51535" :answer/id #uuid "97de58c6-cad0-5bf5-9f38-92a021d6d728" :answer/type :answer.type/math :answer/value "{y}^{″}+6{y}^{′}=0" :db/ensure [:answer/validate]} {:db/id "q-94268/selection" :answer-field/id #uuid "2e61a434-ddb1-538b-8453-3d6b356d5390" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-94268