re [:answer-field/validate]} {:db/id "q-79485" :question/id #uuid "3605b04a-15fd-50ac-9f72-ed54fb63e1dd" :question/math-academy-id "q-79485" :question/problem "The position $y(t)$ of a particle oscillating with simple harmonic motion is governed by the equation\n\n$$\n{y}^{″}+36y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. What is the period of the oscillation?" :question/worked-solution "The simple harmonic motion (SHM) equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nIn our case\n\n$$\n{\\omega }^{2}=36\\,⟹\\,\\omega =6.\n$$\n\nThe period $T$ is given by:\n\n$$\nT=\\frac{2\\pi }{\\omega }\n$$\n\nTherefore, in our case, the period (in seconds) is\n\n$$\nT=\\frac{2\\pi }{6}=\\frac{\\pi }{3}\\,\\text{s}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79485/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ef654722-031d-51cc-86fc-a0cbc498b350"] :knowledge-point/questions ["q-79485"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-64221"] :question/problem "The position $y(t)$ of a particle oscillating with simple harmonic motion is governed by the equation\n\n$$\n{y}^{″}+16y=0,\n$$\n\nwhere $t>0$ is the time, in seconds. What is the period of the oscillation?" :question/worked-solution "The simple harmonic motion (SHM) equation is\n\n$$\n{y}^{″}+{\\omega }^{2}y=0.\n$$\n\nIn our case\n\n$$\n{\\omega }^{2}=16\\,⟹\\,\\omega =4.\n$$\n\nThe period $T$ is given by:\n\n$$\nT=\\frac{2\\pi }{\\omega }\n$$\n\nTherefore, in our case, the period (in seconds) is\n\n$$\nT=\\frac{2\\pi }{4}=\\frac{\\pi }{2}\\,\\text{s}.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-94274/selection/d4ce5caee005bad053bd8cf57620ec88b660e66dc0f4a89b14715f17349deb5d" :answer/id #uuid "707a35c8-caad-5833-b7de-1096fac4f495" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}\\,\\text{s}" :db/ensure [:answer/validate]} {:db/id "q-94274/selection/fa