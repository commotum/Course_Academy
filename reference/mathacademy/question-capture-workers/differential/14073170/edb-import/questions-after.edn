#{[{:db/id #edb/ref 17592186378403 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "815187de-f4ee-5812-b0ab-d424fbc39b56" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡x=\\frac{\\pi }{4}+\\frac{\\pi }{4}(x-1)+\\frac{\\pi }{8}(x-1)^{2}+⋯" :db/id #edb/ref 17592186378405} {:answer/id #uuid "df3a993c-291b-5fa8-8dad-4750737b3e4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡x=\\frac{\\pi }{4}+\\frac{1}{2}(x-1)-\\frac{1}{4}(x-1)^{2}+⋯" :db/id #edb/ref 17592186378406} {:answer/id #uuid "7b9dd9ca-9ddf-5faf-b965-79138306241e" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡x=\\frac{\\pi }{4}+\\frac{\\pi }{2}(x-1)-\\frac{\\pi }{4}(x-1)^{2}+⋯" :db/id #edb/ref 17592186378407} {:answer/id #uuid "8a7f4989-212a-516f-b5ce-6349d74852bc" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡x=\\frac{\\pi }{4}+(x-1)-\\frac{1}{2}(x-1)^{2}+⋯" :db/id #edb/ref 17592186378408} {:answer/id #uuid "3f6d76f9-dcca-5cbb-892e-06ae5faf47e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡x=\\frac{\\pi }{4}+\\frac{1}{2}(x-1)-\\frac{1}{8}(x-1)^{2}+⋯" :db/id #edb/ref 17592186378409}] :answer-field/correct {:answer/id #uuid "df3a993c-291b-5fa8-8dad-4750737b3e4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{arctan}⁡x=\\frac{\\pi }{4}+\\frac{1}{2}(x-1)-\\frac{1}{4}(x-1)^{2}+⋯" :db/id #edb/ref 17592186378406} :answer-field/id #uuid "a8ac5c05-26f8-59ba-bc15-97f822d699f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378404}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "533de05b-1751-5888-841c-ffc1b54b5265" :question/math-academy-id "q-126847" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{arctan}⁡(x)$ about the point $x=1.$" :question/worked-solution "We use Taylor's theorem in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{arctan}⁡x$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{arctan}⁡x \\\\ f(1) & =\\operatorname{arctan}⁡1=\\frac{\\pi }{4} \\\\ {f}^{′}(x) & =\\frac{1}{1+{x}^{2}} \\\\ {f}^{′}(1) & =\\frac{1}{1+1}=\\frac{1}{2} \\\\ {f}^{″}(x) & =-\\frac{2x}{(1+{x}^{2})^{2}} \\\\ {f}^{″}(1) & =-\\frac{2(1)}{(1+1)^{2}}=-\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{arctan}⁡x & =\\frac{\\pi }{4}+(\\frac{1}{2})(x-1)+\\frac{1}{2!}(-\\frac{1}{2})(x-1)^{2}+⋯ \\\\  & =\\frac{\\pi }{4}+\\frac{1}{2}(x-1)-\\frac{1}{4}(x-1)^{2}+⋯\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186310633 :knowledge-point/_questions [{:knowledge-point/id #uuid "e3146eb6-b4ef-554d-83c1-351a3fb15651" :knowledge-point/title "Finding the First Terms of the Taylor Series of a Function About a Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4d424f9-994f-5e5f-8a16-d0e21575bdd9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186310635} {:answer/id #uuid "bb6ac4dc-fc04-54e5-9bb8-5e2b2fc3524c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186310636}] :answer-field/correct {:answer/id #uuid "bb6ac4dc-fc04-54e5-9bb8-5e2b2fc3524c" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186310636} :answer-field/id #uuid "1e91e638-9a0f-5257-bdcb-466b2c7df9c5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310634} {:answer-field/choices [{:answer/id #uuid "d1e6ce05-f3ac-5192-a716-ebfbf206cc8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186310638}] :answer-field/correct {:answer/id #uuid "d1e6ce05-f3ac-5192-a716-ebfbf206cc8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186310638} :answer-field/id #uuid "83c01ef3-bb1d-5089-893f-524c6e531279" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310637} {:answer-field/choices [{:answer/id #uuid "6bf25ab4-42e5-5454-88ac-5de4f783d11f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186310640}] :answer-field/correct {:answer/id #uuid "6bf25ab4-42e5-5454-88ac-5de4f783d11f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186310640} :answer-field/id #uuid "e5960653-e1a0-5b43-a7a5-33a593a2293f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186310639}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "98ed4bd4-cd51-5bf7-857e-4a26fd6e986f" :question/math-academy-id "q-353917" :question/problem "Find the first three non-zero terms in the Taylor expansion of $\\operatorname{sin}⁡x$ centered about the point $x=-\\frac{\\pi }{2}.$\n\n$\\operatorname{sin}⁡x=$\n{{field-1}}\n$+$\n{{field-2}}\n${(x+\\frac{\\pi }{2})}^{2}\\,-\\,$\n{{field-3}}\n${(x+\\frac{\\pi }{2})}^{4}\\,+⋯$" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+\\frac{{f}^{‴}(a)}{3!}(x-a)^{3}+⋯,\n$$\n\nwith $f(x)=\\operatorname{sin}⁡x$ and $a=-\\frac{\\pi }{2}.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{sin}⁡x \\\\ f\\,(-\\frac{\\pi }{2}) & =sin\\,(-\\frac{\\pi }{2})=-1 \\\\ {f}^{′}(x) & =\\operatorname{cos}⁡x \\\\ {f}^{′}\\,(-\\frac{\\pi }{2}) & =cos\\,(-\\frac{\\pi }{2})=0 \\\\ {f}^{″}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{″}\\,(-\\frac{\\pi }{2}) & =-sin\\,(-\\frac{\\pi }{2})=1 \\\\ {f}^{‴}(x) & =-\\operatorname{cos}⁡x \\\\ {f}^{‴}\\,(-\\frac{\\pi }{2}) & =-cos\\,(-\\frac{\\pi }{2})=0 \\\\ {f}^{(4)}(x) & =\\operatorname{sin}⁡x \\\\ {f}^{(4)}\\,(-\\frac{\\pi }{2}) & =sin\\,(-\\frac{\\pi }{2})=-1. \\\\ \\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sin}⁡x & =-1+0\\,(x+\\frac{\\pi }{2})+\\frac{1}{2!}\\,{(x+\\frac{\\pi }{2})}^{2}+\\frac{0}{3!}\\,{(x+\\frac{\\pi }{2})}^{3}+\\frac{(-1)}{4!}\\,{(x+\\frac{\\pi }{2})}^{4}+⋯ \\\\  & =-1+\\frac{1}{2}\\,{(x+\\frac{\\pi }{2})}^{2}-\\frac{1}{24}\\,{(x+\\frac{\\pi }{2})}^{4}+⋯.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186378410 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "594cbfef-f66b-5359-ac46-8f0a3dcc5b10" :answer/type {:db/ident :answer.type/math} :answer/value "0.29" :db/id #edb/ref 17592186378412}] :answer-field/correct {:answer/id #uuid "594cbfef-f66b-5359-ac46-8f0a3dcc5b10" :answer/type {:db/ident :answer.type/math} :answer/value "0.29" :db/id #edb/ref 17592186378412} :answer-field/id #uuid "c358405a-917e-5b3c-a016-214889b2a28a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378411}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6d5cd0a4-e6bd-5a8c-a006-38f56f18a060" :question/math-academy-id "q-354017" :question/problem "Use the first three non-zero terms of the Taylor expansion for $f(x)=\\operatorname{cos}⁡x$ about $x=2\\pi $ to approximate the value of $\\operatorname{cos}⁡(5).$ Round your answer to **two decimal places**.\n\n$\\operatorname{cos}⁡(5)≈$\n{{field-1}}" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $f(x)=\\operatorname{cos}⁡x$ and $a=2\\pi .$ \n\nCalculating the necessary derivatives, we get\n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡x \\\\ f(2\\pi ) & =\\operatorname{cos}⁡(2\\pi )=1 \\\\ {f}^{′}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{′}(2\\pi ) & =-\\operatorname{sin}⁡(2\\pi )=0 \\\\ {f}^{″}(x) & =-\\operatorname{cos}⁡x \\\\ {f}^{″}(2\\pi ) & =-\\operatorname{cos}⁡(2\\pi )=-1 \\\\ {f}^{‴}(x) & =\\operatorname{sin}⁡x \\\\ {f}^{‴}(2\\pi ) & =\\operatorname{sin}⁡(2\\pi )=0 \\\\ {f}^{(4)}(x) & =\\operatorname{cos}⁡x \\\\ {f}^{(4)}(2\\pi ) & =\\operatorname{cos}⁡(2\\pi )=1.\\end{aligned}\n$$\n\nSo, the Taylor series is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡x & =(1)+(0)(x-2\\pi )+\\frac{(-1)}{2!}(x-2\\pi )^{2}+\\frac{(0)}{3!}(x-2\\pi )^{3}+\\frac{(1)}{4!}(x-2\\pi )^{4}+⋯ \\\\  & =1-\\frac{(x-2\\pi )^{2}}{2}+\\frac{(x-2\\pi )^{4}}{24}+⋯\\,.\\end{aligned}\n$$\n\nWe substitute $x=5$ into the above to approximate $\\operatorname{cos}⁡(5).$ We get\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(5) & ≈1-\\frac{(5-2\\pi )^{2}}{2}+\\frac{(5-2\\pi )^{4}}{24} \\\\  & ≈0.29,\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186378413 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15a7d1ce-086b-55d8-bba1-d874a9bc04ec" :answer/type {:db/ident :answer.type/math} :answer/value "4.28" :db/id #edb/ref 17592186378415} {:answer/id #uuid "90dfbe70-e064-54fa-9ef8-5b545809f99c" :answer/type {:db/ident :answer.type/math} :answer/value "4.29" :db/id #edb/ref 17592186378416}] :answer-field/correct {:answer/id #uuid "90dfbe70-e064-54fa-9ef8-5b545809f99c" :answer/type {:db/ident :answer.type/math} :answer/value "4.29" :db/id #edb/ref 17592186378416} :answer-field/id #uuid "9ea677ed-5f99-53d5-8a64-9f8e64a9264a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378414}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "79c3e8b3-1afe-5d55-adc2-24f3988011bf" :question/math-academy-id "q-363485" :question/problem "Use the first three non-zero terms of the Taylor expansion of $f(x)={2}^{x}$ about $x=2$ to approximate the value of ${2}^{2.1}.$ Round your answer to **two decimal places**.\n\n${2}^{2.1}≈$\n{{field-1}}" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $f(x)={2}^{x}$ and $a=2.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & ={2}^{x} \\\\ f(2) & =4 \\\\ {f}^{′}(x) & ={2}^{x}\\operatorname{ln}⁡2 \\\\ {f}^{′}(2) & =4\\operatorname{ln}⁡2 \\\\ {f}^{″}(x) & ={2}^{x}(\\operatorname{ln}⁡2)^{2} \\\\ {f}^{″}(2) & =4(\\operatorname{ln}⁡2)^{2}.\\end{aligned}\n$$\n\nSo, the Taylor expansion is\n\n$$\n{2}^{x}=4+4(\\operatorname{ln}⁡2)(x-2)+\\frac{4(\\operatorname{ln}⁡2)^{2}}{2!}(x-2)^{2}+⋯,\n$$\n\nwhich simplifies to\n\n$$\n{2}^{x}=4+4(\\operatorname{ln}⁡2)(x-2)+2(\\operatorname{ln}⁡2)^{2}(x-2)^{2}+⋯.\n$$\n\nWe substitute $x=2.1.$ Since $2.1-2=0.1=\\frac{1}{10},$ we obtain\n\n$$\n\\begin{aligned}{2}^{2.1} & ≈4+4(\\operatorname{ln}⁡2)(\\frac{1}{10})+2(\\operatorname{ln}⁡2)^{2}{(\\frac{1}{10})}^{2} \\\\  & ≈4.29.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{2}^{2.1}≈4.29.\n$$"}] [{:db/id #edb/ref 17592186378417 :knowledge-point/_questions [{:knowledge-point/id #uuid "a239976c-cf11-5c26-b250-2c03b3fb1ec3" :knowledge-point/title "Approximating the Value of a Function at a  Point Using Its Taylor Series"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "612e926e-5a23-5e6d-b9db-5ba8af1e85ec" :answer/type {:db/ident :answer.type/math} :answer/value "8.0" :db/id #edb/ref 17592186378419}] :answer-field/correct {:answer/id #uuid "612e926e-5a23-5e6d-b9db-5ba8af1e85ec" :answer/type {:db/ident :answer.type/math} :answer/value "8.0" :db/id #edb/ref 17592186378419} :answer-field/id #uuid "f72ec028-c6f5-5dbb-be78-b012c8a15d53" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378418}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "52462734-7b5e-5643-af09-a9a3063c6148" :question/math-academy-id "q-363486" :question/problem "Use the first three non-zero terms of the Taylor expansion of $f(x)={5}^{x}$ about $x=1$ to approximate the value of ${5}^{1.3}.$ Round your answer to **one decimal place**.\n\n${5}^{1.3}≈$\n{{field-1}}" :question/worked-solution "We use Taylor's formula in the form\n\n$$\nf(x)=f(a)+{f}^{′}(a)(x-a)+\\frac{{f}^{″}(a)}{2!}(x-a)^{2}+⋯,\n$$\n\nwith $f(x)={5}^{x}$ and $a=1.$ \n\nComputing the required derivatives, we have\n\n$$\n\\begin{aligned}f(x) & ={5}^{x} \\\\ f(1) & =5 \\\\ {f}^{′}(x) & ={5}^{x}\\operatorname{ln}⁡5 \\\\ {f}^{′}(1) & =5\\operatorname{ln}⁡5 \\\\ {f}^{″}(x) & ={5}^{x}(\\operatorname{ln}⁡5)^{2} \\\\ {f}^{″}(1) & =5(\\operatorname{ln}⁡5)^{2}.\\end{aligned}\n$$\n\nSo, the Taylor expansion is\n\n$$\n{5}^{x}=5+5(\\operatorname{ln}⁡5)(x-1)+\\frac{5(\\operatorname{ln}⁡5)^{2}}{2!}(x-1)^{2}+⋯,\n$$\n\nwhich simplifies to\n\n$$\n{5}^{x}=5+5(\\operatorname{ln}⁡5)(x-1)+\\frac{5(\\operatorname{ln}⁡5)^{2}}{2}(x-1)^{2}+⋯.\n$$\n\nWe substitute $x=1.3.$ Since $1.3-1=0.3=\\frac{3}{10},$ we obtain\n\n$$\n\\begin{aligned}{5}^{1.3} & ≈5+5(\\operatorname{ln}⁡5)(\\frac{3}{10})+\\frac{5(\\operatorname{ln}⁡5)^{2}}{2}{(\\frac{3}{10})}^{2} \\\\  & ≈8.0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{5}^{1.3}≈8.0.\n$$"}]}
