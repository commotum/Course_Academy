n}⁡t\\end{aligned}\n$$\n\nWe can represent this system as the matrix differential equation ${x}^{′}(t)=Ax(t)+f(t)$ as follows:\n\n$$\n[\\begin{aligned}{x}_{1}^{′} \\\\ {x}_{2}^{′} \\\\ {x}_{3}^{′}\\end{aligned}]=[\\begin{aligned}0 & 1 & 0 \\\\ 0 & 0 & 1 \\\\ 0 & 3 & -t\\end{aligned}][\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ {x}_{3}\\end{aligned}]+[\\begin{aligned}0 \\\\ 0 \\\\ \\operatorname{ln}⁡t\\end{aligned}]\n$$" 13194139535809 true] [17592186367590 1000 #edb/ref 17592186367591 13194139535809 true] [17592186367590 1000 #edb/ref 17592186367592 13194139535809 true] [17592186367590 1040 #edb/ref 17592186045449 13194139535809 true] [17592186367590 1041 "field-1" 13194139535809 true] [17592186367590 1104 #edb/ref 17592186367592 13194139535809 true] [17592186367590 1110 #uuid "1b090c15-2670-5178-b98f-5259d8d6959e" 13194139535809 true] [17592186367591 1034 "1" 13194139535809 true] [17592186367591 1103 #edb/ref 17592186045453 13194139535809 true] [17592186367591 1111 #uuid "b6f11e82-391f-5219-a855-ab975d662aee" 13194139535809 true] [17592186367592 1034 "0" 13194139535809 true] [17592186367592 1103 #edb/ref 17592186045453 13194139535809 true] [17592186367592 1111 #uuid "8899737f-1a2b-54dd-901b-e10b80abcd56" 13194139535809 true] [17592186367593 1000 #edb/ref 17592186367594 13194139535809 true] [17592186367593 1040 #edb/ref 17592186045449 13194139535809 true] [17592186367593 1041 "field-2" 13194139535809 true] [17592186367593 1104 #edb/ref 17592186367594 13194139535809 true] [17592186367593 1110 #uuid "83adc4e1-40ec-5178-865f-456019d2b66d" 13194139535809 true] [17592186367594 1034 "0" 13194139535809 true] [17592186367594 1103 #edb/ref 17592186045453 13194139535809 true] [17592186367594 1111 #uuid "dca06435-52cb-5706-bb15-bc32d9ae0057" 13194139535809 true] [17592186367595 1000 #edb/ref 17592186367596 13194139535809 true] [17592186367595 1040 #edb/ref 17592186045449 13194139535809 true] [17592186367595 1041 "field-3" 13194139535809 true] [17592186367595 1104 #edb/ref 175921