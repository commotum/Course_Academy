rac{1}{{2}^{(-x)}}) \\\\  & =({(\\frac{1}{2})}^{x}-\\frac{1}{(1/2)^{x}}) \\\\  & =(\\frac{1}{{2}^{x}}-{2}^{x}) \\\\  & =-({2}^{x}-\\frac{1}{{2}^{x}}) \\\\  & =-f(x).\\end{aligned}\n$$\n\nSo, because $f(x)=({2}^{x}-\\frac{1}{{2}^{x}})$ is an odd function, we have\n\n$$\n{\\int }_{-2}^{2}({2}^{x}-\\frac{1}{{2}^{x}})\\,\\text{d}x=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "6c26f7d5a82b9903e2fa8a28011835999e0a48010f9f38ef2da2f550b8d7db72" "basis" 2070 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/edb-import/verification.json"} {"question" "q-156183" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/activity-metadata.json" "file_sha256" "695c9a2f231761c8f243abfac54df5a4553eb3b4e729f309ec9a167d9fef3aec" "basis" 2070 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/edb-import/verification.json"} {"question" "q-156183" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/state.json" "file_sha256" "6c26f7d5a82b9903e2fa8a28011835999e0a48010f9f38ef2da2f550b8d7db72" "basis" 2070 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/edb-import/verification.json"} {"question" "q-156183" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "-{\\int }_{0}^{2}({2}^{x}-\\frac{1}{{2}^{x}})\\,\\text{d}x"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14056630/st