{\\lambda }_{2}=6.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}1 & 2 \\\\ 1 & -1\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80389/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5164c6cb-aef0-554b-b361-77245991c0ea"] :knowledge-point/questions ["q-80389"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186125003 :question/answer-fields 17592186123040] {:db/id "q-37600/selection/ma-v1/a6947ffc0aa2e82631d22f6d5978111d1ec16d93f02fec2bb19dbb879497c7ae/8ef110f70b254b9a0aad93b6fca1278bd8fdd57945aab9116cd5690db84ae552" :answer/id #uuid "324e6ead-fbcc-53d5-a4b8-76b68755c531" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]$\nand \n$P=[\\begin{aligned}-2 & 1 \\\\ 2 & 0\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37600/selection/ma-v1/a6947ffc0aa2e82631d22f6d5978111d1ec16d93f02fec2bb19dbb879497c7ae/1e40b8f1e9776e81e7ace1aba1b0331f04e32e4ec137993ddeed1b36d09511e1" :answer/id #uuid "ca7101e9-43c3-514d-beb7-5f1fe906a14c" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}1 & 0 \\\\ 0 & -3\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & -2 \\\\ 0 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37600/selection/ma-v1/a6947ffc0aa2e82631d22f6d5978111d1ec16d93f02fec2bb19dbb879497c7ae/080e2cdc00beb2e2fbfc6529ecd148cc92a0b1fca16d892ad6acd341959b06c7" :answer/id #uuid "3a20d4bc-348e-5712-ad52-9a76f2e54d62" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{aligned}]$\nand\n$P=[\\begin{aligned}2 & 0 \\\\ -2 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-37600/selection/ma-v1/a6947ffc0aa2e82631d22f6d5978111d1ec16d93f02fec2bb19dbb879497c7ae/27ad3b02e42938cfe513d6ce331073a5841e33382ae4e59b2ba9ed3aa947c4d1" :answer/id #uuid "d5e8da2f-adf0-521a-ba14-accadb7a050f" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & 1\\end{