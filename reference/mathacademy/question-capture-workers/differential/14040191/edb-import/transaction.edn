eaf25ae50d9593869e9693da6012a287d/5e12b0a93f4ee1f9382905874a877a2301cc5c65ea9545817f7ec8c335d21267" :answer-field/choices ["q-37610/selection/ma-v1/1a4bdd3c2347c558f7923a6cf0f5ce8eaf25ae50d9593869e9693da6012a287d/e2212ef9e581db987b8817eb1e163d6b098e72f5ef6b99b8f4f8f6ccaa7293a1" "q-37610/selection/ma-v1/1a4bdd3c2347c558f7923a6cf0f5ce8eaf25ae50d9593869e9693da6012a287d/5e12b0a93f4ee1f9382905874a877a2301cc5c65ea9545817f7ec8c335d21267" "q-37610/selection/ma-v1/1a4bdd3c2347c558f7923a6cf0f5ce8eaf25ae50d9593869e9693da6012a287d/45a343d16f6abcc11dacd988f336af0300ee001282775b9ce40985e5112c1b92" "q-37610/selection/ma-v1/1a4bdd3c2347c558f7923a6cf0f5ce8eaf25ae50d9593869e9693da6012a287d/8103a4f02d5aa8ae5bde4bb037b65500f7bde54730a7103b6fa42a3855f36340" "q-37610/selection/ma-v1/1a4bdd3c2347c558f7923a6cf0f5ce8eaf25ae50d9593869e9693da6012a287d/20d19ac3ad68b188f1039489deaead7ba2a359c3576faf34b00f0237dcc5770f"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-37610"] :question/problem "Consider the matrix $A$ for which ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=15$ are eigenvalues, and\n\n$$\n{v}_{1}=[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,{v}_{2}=[\\begin{aligned}-1 \\\\ 1\\end{aligned}]\n$$\n\nare the respective eigenvectors. What are the values of $a,b,c$ given that\n\n$$\nA=[\\begin{aligned}1 & b \\\\ 2 & c\\end{aligned}][\\begin{aligned}a & 0 \\\\ 0 & 15\\end{aligned}]{[\\begin{aligned}1 & b \\\\ 2 & c\\end{aligned}]}^{-1}?\n$$" :question/worked-solution "Since the eigenvalues of the matrix are ${\\lambda }_{1}=3$ and ${\\lambda }_{2}=15,$ we construct the diagonal matrix $D$ by writing the eigenvalues in the main diagonal:\n\n$$\nD=[\\begin{aligned}3 & 0 \\\\ 0 & 15\\end{aligned}].\n$$\n\nNow, to construct the matrix $P,$ we simply write the respective eigenvectors as columns: \n\n- the $1$st column is the eigenvector corresponding to ${\\lambda }_{1}=3,$ and\n\n- the $2$nd column is the eigenvector corresponding to ${\\lambda }_{2}=15.$\n\nTherefore, we get\n\n$$\nP=[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}].\n$$\n\nFinally, we obtain\n\n$$\nA=[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}][\\begin{aligned}3 & 0 \\\\ 0 & 15\\end{aligned}]{[\\begin{aligned}1 & -1 \\\\ 2 & 1\\end{aligned}]}^{-1}.\n$$\n\n \n\nIn conclusion, we get $a=3,$ $b=-1,$ and $c=1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-37610/selection/ma-v1/1a4bdd3c2347c558f7923a6cf0f5ce8eaf25ae50d9593869e9693da6012a287d"] :db/ensure [:question/validate]} {:db/id "q-80389/selection/9479caf3292c9348f4929db832b5d352aab96c9f3dcb632b205e922595bb532a" :answer/id #uuid "7645a980-b29d-5fe8-bd7c-485982bee7c9" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-3 & 0 \\\\ 0 & -6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80389/selection/8e903c0837d54b0aefc46a2727faf090ceedbee238de3637569689fe3efe775f" :answer/id #uuid "8b868259-d51e-56a7-b9e4-714a37a2a3dd" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}-6 & 0 \\\\ 0 & -3\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 1 \\\\ 1 & -2\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80389/selection/b65ba18c45eed4024ecd6c41adb607ce77c7f1429a9f5c7c4863ed87ab52997b" :answer/id #uuid "f94b1b57-4526-5515-963d-1874737b1f2d" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & 6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & -1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80389/selection/643bbe3d0b34197b69897104b4f121685c194c6b3d52978f5904dd7ebe79d0d1" :answer/id #uuid "629a0baa-dc7e-5342-9844-6a3d285087a6" :answer/type :answer.type/text :answer/value "$D=[\\begin{aligned}3 & 0 \\\\ 0 & -6\\end{aligned}]$ and \n$P=[\\begin{aligned}1 & 2 \\\\ 1 & 1\\end{aligned}]$" :db/ensure [:answer/validate]} {:db/id "q-80389/selection/b85a6e8bd40d1b090825685f5fb9292ae79222da1c2654e7687db879392bd9bc" :answer/id #uuid "d0ab0081-93