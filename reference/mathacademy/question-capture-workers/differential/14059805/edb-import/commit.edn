 \\\\ 1 \\\\ 1\\end{aligned}] \\\\ {\\text{proj}}_{{a}_{2}}x & =\\frac{x\\cdot {a}_{2}}{{a}_{2}\\cdot {a}_{2}}{a}_{2}=\\frac{3\\cdot 2+4\\cdot (-1)+(-3)\\cdot (-2)+2\\cdot 1}{{2}^{2}+(-1)^{2}+(-2)^{2}+{1}^{2}}{a}_{2}=[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\n \n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{{a}_{1}}x+{\\text{proj}}_{{a}_{2}}x \\\\  & =\\frac{3}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}2 \\\\ -1 \\\\ -2 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}(3[\\begin{aligned}1 \\\\ 1 \\\\ 1 \\\\ 1\\end{aligned}]+[\\begin{aligned}4 \\\\ -2 \\\\ -4 \\\\ 2\\end{aligned}]) \\\\  & =\\frac{1}{2}[\\begin{aligned}7 \\\\ 1 \\\\ -1 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\n \n\nThe acute angle between $x$ and $S$ is the acute angle between $x$ and ${\\text{proj}}_{S}x$ or any other non-zero vector that is parallel to ${\\text{proj}}_{S}x.$ So, to make calculations easier, we can find the angle between the vectors\n\n$\\,$ $x=[\\begin{aligned}3 \\\\ 4 \\\\ -3 \\\\ 2\\end{aligned}]\\,$ and $\\,2\\,{\\text{proj}}_{S}x=[\\begin{aligned}7 \\\\ 1 \\\\ -1 \\\\ 5\\end{aligned}].$\n\nComputing the cosine using the dot product, we obtain \n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{3\\cdot 7+4\\cdot 1+(-3)\\cdot (-1)+2\\cdot 5}{\\sqrt{{3}^{2}+{4}^{2}+(-3)^{2}+{2}^{2}}\\sqrt{{7}^{2}+{1}^{2}+(-1)^{2}+{5}^{2}}} \\\\  & =\\frac{38}{\\sqrt{38}\\sqrt{76}} \\\\  & =\\frac{38}{38\\cdot \\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2})=\\frac{\\pi }{4},\n$$\n\nwhich is already an acute angle." 13194139535227 true] [17592186338675 1000 #edb/ref 17592186338676 13194139535227 true] [17592186338675 1000 #edb/ref 17592186338677 13194139535227 true] [17592186338675 1000 #edb/ref 17592186338678 13194139535227 true] [17592186338675 1000 #edb/ref 17592186338679 13194139535227 