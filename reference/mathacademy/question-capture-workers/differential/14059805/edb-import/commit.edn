gin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, we have that\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,x & ={\\text{proj}}_{v}\\,x+{\\text{proj}}_{w}\\,x \\\\  & =\\frac{1}{2}[\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}] \\\\  & =\\frac{1}{2}([\\begin{aligned}1 \\\\ 1 \\\\ 0\\end{aligned}]+2[\\begin{aligned}-1 \\\\ 1 \\\\ 1\\end{aligned}]) \\\\  & =[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}].\\end{aligned}\n$$" 13194139535227 true] [17592186338647 1000 #edb/ref 17592186338648 13194139535227 true] [17592186338647 1000 #edb/ref 17592186338649 13194139535227 true] [17592186338647 1000 #edb/ref 17592186338650 13194139535227 true] [17592186338647 1000 #edb/ref 17592186338651 13194139535227 true] [17592186338647 1000 #edb/ref 17592186338652 13194139535227 true] [17592186338647 1040 #edb/ref 17592186045450 13194139535227 true] [17592186338647 1041 "selection" 13194139535227 true] [17592186338647 1104 #edb/ref 17592186338648 13194139535227 true] [17592186338647 1110 #uuid "7ad82d57-2701-59ec-99a6-bdd8f6f370e1" 13194139535227 true] [17592186338648 1034 "[\\begin{aligned}-\\frac{1}{2} \\\\ \\frac{3}{2} \\\\ 1\\end{aligned}]" 13194139535227 true] [17592186338648 1103 #edb/ref 17592186045453 13194139535227 true] [17592186338648 1111 #uuid "c6af211d-3e87-53dd-b488-022c6dffb945" 13194139535227 true] [17592186338649 1034 "[\\begin{aligned}-\\frac{3}{2} \\\\ \\frac{1}{2} \\\\ \\frac{1}{2}\\end{aligned}]" 13194139535227 true] [17592186338649 1103 #edb/ref 17592186045453 13194139535227 true] [17592186338649 1111 #uuid "58fe3b20-37cc-5459-8e68-e0f8bada6c7a" 13194139535227 true] [17592186338650 1034 "[\\begin{aligned}-1 \\\\ \\frac{1}{2} \\\\ \\frac{3}{2}\\end{aligned}]" 13194139535227 true] [17592186338650 1103 #edb/ref 17592186045453 13194139535227 true] [17592186338650 1111 #uuid "a0df0db0-5196-5162-affa-2a7891657598" 13194139535227 true] [17592186338651 1034 "[\\begin{aligned