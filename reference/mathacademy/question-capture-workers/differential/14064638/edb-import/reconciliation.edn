40e507c99ce" "basis" 1240 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14035334/edb-import/verification.json"} {"question" "q-164138" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "None of those listed"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14035334/state.json" "file_sha256" "f3ff58676550e44dc400467358c6732bfddd8dcce979c9bcfdd8240e507c99ce" "basis" 1240 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14035334/edb-import/verification.json"}] "sources" [{"question" "q-89876" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y+2x.\n$$\n\n \n\nGiven that the point $P(0,-1)$ lies on the graph of the function, evaluate $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}$ at $P.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89876" "field" nil "attribute" "question/worked-solution" "value" "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) & =\\frac{\\text{d}}{\\text{d}x}(y+2x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(y)+\\frac{\\text{d}}{\\text{d}x}(2x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}y}{\\text{d}x}+2\\frac{\\text{d}}{\\text{d}x}(x) \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}y}{\\text{d}x}+2\\end{aligned}\n$$\n\nNow, we substitute the given expression for $\\frac{\\text{d}y}{\\text{d}x}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =(y+2x)+2 \\\\ \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =y+2x+2\\end{aligned}\n$$\n\nFinally, we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,-1)} & ={(y+2x+2)|}_{(0,-1)} \\\\  & =-1+2(0)+2 \\\\  & =1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89876" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/activity-metadata.json" "file_sha256" "c07bcae1c5ef32f5a645df035c3b129e9637b4be7bbc0a0bb6d6f334654fecb3"} {"question" "q-89876" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89876" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-4"] ["math" "0"] ["math" "1"] ["math" "3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89876" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89880" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation ${y}^{′}=\\frac{y}{{x}^{2}}.$ Given that the point $(1,2)$ lies on the graph of the function, what is the value of ${{y}^{″}|}_{(1,2)}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89880" "field" nil "attribute" "question/worked-solution" "value" "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}({y}^{′})^{′} & ={(\\frac{y}{{x}^{2}})}^{′} \\\\ {y}^{″} & =\\frac{(y)^{′}{x}^{2}-y({x}^{2})^{′}}{{x}^{4}} \\\\ {y}^{″} & =\\frac{{x}^{2}{y}^{′}-2xy}{{x}^{4}}\\end{aligned}\n$$\n\nNow, we substitute the given expression for ${y}^{′}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}{y}^{″} & =\\frac{{x}^{2}{y}^{′}-2xy}{{x}^{4}} \\\\ {y}^{″} & =\\frac{({x}^{2}\\cdot \\frac{y}{{x}^{2}}-2xy)}{{x}^{4}} \\\\ {y}^{″} & =\\frac{y-2xy}{{x}^{4}} \\\\ {y}^{″} & =\\frac{y(1-2x)}{{x}^{4}}\\end{aligned}\n$$\n\nFinally, we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{{y}^{″}|}_{(1,2)} & ={\\frac{y(1-2x)}{{x}^{4}}|}_{(1,2)} \\\\  & =\\frac{2(1-2(1))}{(1)^{4}} \\\\  & =-2\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89880" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/activity-metadata.json" "file_sha256" "c07bcae1c5ef32f5a645df035c3b129e9637b4be7bbc0a0bb6d6f334654fecb3"} {"question" "q-89880" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89880" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "1"] ["math" "2"] ["math" "\\frac{1}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89880" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89884" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation ${y}^{′}={e}^{y}+x.$ Given that the point $(-1,0)$ lies on the graph of the function, what is the value of ${{y}^{″}|}_{(-1,0)}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89884" "field" nil "attribute" "question/worked-solution" "value" "To find an expression for the second derivative, we differentiate the equation with respect to $x,$ as follows:\n\n$$\n\\begin{aligned}({y}^{′})^{′} & ={({e}^{y}+x)}^{′} \\\\ ({y}^{′})^{′} & ={({e}^{y})}^{′}+{(x)}^{′} \\\\ {y}^{″} & ={y}^{′}{e}^{y}+1\\end{aligned}\n$$\n\nNotice that we used the chain rule to compute ${({e}^{y})}^{′}.$\n\nNow, we substitute the given expression for ${y}^{′}$ into the above and simplify the resulting expression:\n\n$$\n\\begin{aligned}{y}^{″} & ={y}^{′}{e}^{y}+1 \\\\ {y}^{″} & =({e}^{y}+x)\\cdot {e}^{y}+1 \\\\ {y}^{″} & ={e}^{2y}+x{e}^{y}+1\\end{aligned}\n$$\n\nFinally, we substitute the coordinates of our point into the above expression for the second derivative:\n\n$$\n\\begin{aligned}{{y}^{″}|}_{(-1,0)} & ={({e}^{2y}+x{e}^{y}+1)|}_{(-1,0)} \\\\  & ={e}^{2(0)}+(-1){e}^{0}+1 \\\\  & =1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89884" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/activity-metadata.json" "file_sha256" "c07bcae1c5ef32f5a645df035c3b129e9637b4be7bbc0a0bb6d6f334654fecb3"} {"question" "q-89884" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89884" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "1"] ["math" "2"] ["math" "2e"] ["math" "e"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89884" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89891" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=y{e}^{x}.\n$$\n\nGiven that the point $(0,e)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\n- $(0,e)$ is a stationary point of the function $f$\n- $(0,e)$ is a local minimum point of the function $f$\n- $(0,e)$ is an inflection point of the function $f$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89891" "field" nil "attribute" "question/worked-solution" "value" "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(0,e),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,e)} & ={(y{e}^{x})|}_{(0,e)} \\\\  & =e\\cdot {e}^{0} \\\\  & =e\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y{e}^{x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(y)\\cdot {e}^{x}+y\\cdot \\frac{\\text{d}}{\\text{d}x}({e}^{x}) \\\\  & =\\frac{\\text{d}y}{\\text{d}x}\\cdot {e}^{x}+y{e}^{x} \\\\  & =(y{e}^{x}){e}^{x}+y{e}^{x} \\\\  & =y{e}^{2x}+y{e}^{x} \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(0,e)} & ={(y{e}^{2x}+y{e}^{x})|}_{(0,e)} \\\\  & =e\\cdot {e}^{2(0)}+e\\cdot {e}^{0} \\\\  & =2e \\\\  & >0\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is false. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,e)}=e\\ne 0,\n$$\n\nwe obtain that $(0,e)$ is not a stationary point of the function $f.$\n\n- Statement II is false. There is no critical point at $(0,e),$ therefore we cannot have a local minimum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(0,e).$\n\nTherefore, the correct answer is \"None of those listed.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89891" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/activity-metadata.json" "file_sha256" "c07bcae1c5ef32f5a645df035c3b129e9637b4be7bbc0a0bb6d6f334654fecb3"} {"question" "q-89891" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89891" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "III only"] ["text" "None of those listed"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-89891" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "None of those listed"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-164138" "field" nil "attribute" "question/problem" "value" "The function $y=f(x)$ satisfies the differential equation \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{y}{1+{x}^{2}}.\n$$\n\nGiven that the point $(-\\frac{1}{2},1)$ lies on the graph of $y=f(x),$ which of the following statements are true?\n\n- $(-\\frac{1}{2},1)$ is a stationary point of the function $f$\n- $(-\\frac{1}{2},1)$ is a local maximum point of the function $f$\n- $(-\\frac{1}{2},1)$ is an inflection point of the function $f$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-164138" "field" nil "attribute" "question/worked-solution" "value" "First, we find the value of the first and second derivatives of the function at the given point.\n\nTo find the first derivative of $f$ at $(-\\frac{1}{2},1),$ we substitute the coordinates of our point into the differential equation:\n\n$$\n\\begin{aligned}{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1/2,1)} & ={(\\frac{y}{1+{x}^{2}})|}_{(-1/2,1)} \\\\  & =\\frac{1}{1+{(-\\frac{1}{2})}^{2}} \\\\  & =\\frac{4}{5}\\end{aligned}\n$$\n\nTo find the second derivative, we first need to differentiate the equation and then substitute the coordinates of the point:\n\n$$\n\\begin{aligned}\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}} & =\\frac{\\text{d}}{\\text{d}x}(\\frac{\\text{d}y}{\\text{d}x}) \\\\  & =\\frac{\\text{d}}{\\text{d}x}(\\frac{y}{1+{x}^{2}}) \\\\  & =\\frac{1}{1+{x}^{2}}\\cdot \\frac{\\text{d}y}{\\text{d}x}-\\frac{2xy}{(1+{x}^{2})^{2}} \\\\  & =\\frac{1}{1+{x}^{2}}\\cdot \\frac{y}{1+{x}^{2}}-\\frac{2xy}{(1+{x}^{2})^{2}} \\\\  & =\\frac{y(1-2x)}{(1+{x}^{2})^{2}} \\\\ {\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}|}_{(-1/2,1)} & ={(\\frac{y(1-2x)}{(1+{x}^{2})^{2}})|}_{(-1/2,1)} \\\\  & =\\frac{1(1-2(-\\frac{1}{2}))}{{(1+{(-\\frac{1}{2})}^{2})}^{2}} \\\\  & =\\frac{32}{25}.\\end{aligned}\n$$\n\nWith that in mind, let's examine the statements in turn.\n\n- Statement I is false. Indeed, since\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1/2,1)}=\\frac{4}{5}\\ne 0,\n$$\n\nwe obtain that $(-\\frac{1}{2},1)$ is not a stationary point of the function $f.$\n\n- Statement II is false. There is no critical point at $(-\\frac{1}{2},1).$ Therefore we cannot have a local minimum at that point.\n\n- Statement III is false. Since the second derivative is not zero, there is no inflection point at $(-\\frac{1}{2},1).$\n\nTherefore, the correct answer is \"None of those listed.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-164138" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/activity-metadata.json" "file_sha256" "c07bcae1c5ef32f5a645df035c3b129e9637b4be7bbc0a0bb6d6f334654fecb3"} {"question" "q-164138" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-164138" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II only"] ["text" "None of those listed"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"} {"question" "q-164138" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "None of those listed"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14064638/state.json" "file_sha256" "9d03b8b494512ba3e75e89dde0a8094803684bdc46fc5b343f7284ecae074151"}] "usage" {"q-89891" [] "q-164138" [] "q-89880" []} "basis" 2120 "retractions" [] "immutable_answers" [17592186156827 17592186156828 17592186156829 17592186156830 17592186156831 17592186294956 17592186294957 17592186294958 17592186294959 17592186294960 17592186294994 17592186294995 17592186294996 17592186294997 17592186294998] "immutable_fields" [[17592186156826 :answer-field/correct] [17592186156826 :answer-field/id] [17592186156826 :answer-field/key] [17592186156826 :answer-field/type] [17592186294955 :answer-field/correct] [17592186294955 :answer-field/id] [17592186294955 :answer-field/key] [17592186294955 :answer-field/type] [17592186294993 :answer-field/correct] [17592186294993 :answer-field/id] [17592186294993 :answer-field/key] [17592186294993 :answer-field/type]] "no_history" []}
