f-3039-59a9-a5f0-f06806d4ec92" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "q-333827/field-4" :answer-field/id #uuid "26e2032c-e4ad-5fad-ae2f-cd4c8cd7892b" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333827/field-4/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" :answer-field/choices ["q-333827/field-4/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e"] :db/ensure [:answer-field/validate]} {:db/id "q-333827" :question/id #uuid "7a50ae29-36bb-5c20-82b9-5124a29667b7" :question/math-academy-id "q-333827" :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=3x+2y+z,\\, & y(0)=3 \\\\ {z}^{′}=2x-y+3z,\\, & z(0)=-2\\end{aligned}\n$$\n\nWe wish to approximate the solution using Euler's method.\nWhat entries should be placed in the columns for $Δy$ and $Δz$ in the table below if the step size is $Δx=2?$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ |  |  | {{field-1}} |  |  | {{field-2}} |\n\nTherefore, $y(2)≈$\n{{field-3}}\nand $z(2)≈$\n{{field-4}}." :question/worked-solution "For an initial value problem\n\n$$\n{\\begin{aligned}{y}^{′}=f(x,y,z),\\, & y(a)=c, \\\\ {z}^{′}=g(x,y,z),\\, & z(a)=d,\\end{aligned}\n$$\n\nEuler's method approximates the solution by applying the update rule component-wise to each equation. More precisely, the increments on $y$ and $z$ are\n\n$$\n{\\begin{aligned}Δy={y}^{′}\\cdot Δx, \\\\ Δz={z}^{′}\\cdot Δx.\\end{aligned}\n$$\n\nThe new values are then given by ${y}_{\\text{new}}=y+Δy$ and ${z}_{\\text{new}}=z+Δz.$\n\nFirst, because the initial conditions are $y(0)=3$ and $z(0)=-2,$ we place $y=3$ and $z=-2$ in the table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $3$ |  |  | $-2$ |  |  |\n\nNext, we compute both ${y}^{′}$ and ${z}^{′}$ according to the given rules:\n\n$$\n\\begin{aligned}{y}^{′} & =3x+2y+z \\\\  & =3\\cdot 0+2\\cdot 3+(-2) \\\\  & =0+6-2 \\\\  & =4 \\\\ {z}^{′} & =2x-y+3z \\\\  & =2\\cdot 0-3+3\\cdot (-2) \\\\  & =0-3-6 \\\\  & =-9\\end{aligned}\n$$\n\nSo, we add these to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $3$ | $4$ |  | $-2$ | $-9$ |  |\n\nFinally, we compute $Δy$ and $Δz$ using Euler's method:\n\n$$\n\\begin{aligned}Δy & ={y}^{′}\\cdot Δx \\\\  & =4\\cdot 2 \\\\  & =8 \\\\ Δz & ={z}^{′}\\cdot Δx \\\\  & =(-9)\\cdot 2 \\\\  & =-18\\end{aligned}\n$$\n\nWe add these to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $3$ | $4$ | $8$ | $-2$ | $-9$ | $-18$ |\n\nTo get the new values of $x,$ $y,$ and $z$ in the *next* row, we add $Δx$ to $x,$ $Δy$ to $y,$ and $Δz$ to $z,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx=0+2=2 \\\\ {y}_{\\text{new}} & =y+Δy=3+8=11 \\\\ {z}_{\\text{new}} & =z+Δz=-2+(-18)=-20\\end{aligned}\n$$\n\nAdding these values to our table in a new row gives the following:\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $3$ | $4$ | $8$ | $-2$ | $-9$ | $-18$ |\n| $2$ | $11$ |  |  | $-20$ |  |  |\n\nTherefore, we conclude that\n$y(2)≈11$\nand\n$z(2)≈-20.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333827/field-1" "q-333827/field-2" "q-333827/field-3" "q-333827/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "70c9c14c-62d1-592c-81f7-92d683050e3c"] :knowledge-point/questions ["q-333827"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335132/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "fefac858-7064-59e9-a01e-cea5d3c05754" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-335132/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3ebb0779-f116-538b-addf-af85689e1f90" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-335132/field-1" :answer-field/id #uuid "fff826eb-ef54-586f-9cc5-3363913f1eb6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335132/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-335132/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-335132/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-335132/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "5cceb39d-a9c4-55ab-bff3-7f42d18bd472" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-335132/field-2" :answer-field/id #uuid "4007e908-5b03-55e0-b565-bb8c2960fb5e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335132/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-335132/field-2/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-335132" :question/id #uuid "581e40f5-5653-5de3-8725-8300356b1b66" :question/math-academy-id "q-335132" :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=x-y,\\, & y(0)=0 \\\\ {z}^{′}=1+y,\\, & z(0)=0\\end{aligned}\n$$\n\nUse Euler's method with two steps of equal size to approximate $y(1)$ and $z(1).$\n\n$y(1)≈$\n{{field-1}},\n$\\,z(1)≈$\n{{field-2}}" :question/worked-solution "For an initial value problem\n\n$$\n{\\begin{aligned}{y}^{′}=f(x,y,z),\\, & y(a)=c, \\\\ {z}^{′}=g(x,y,z),\\, & z(a)=d,\\end{aligned}\n$$\n\nEuler's method approximates the solution by applying the update rule component-wise to each equation. More precisely, the increments on $y$ and $z$ are\n\n$$\n{\\begin{aligned}Δy={y}^{′}\\cdot Δx, \\\\ Δz={z}^{′}\\cdot Δx.\\end{aligned}\n$$\n\nThe new values are then given by ${y}_{\\text{new}}=y+Δy$ and ${z}_{\\text{new}}=z+Δz.$\n\nFirst, note that we are given the values of $y$ and $z$ at $x=0$ and asked to find their values at $x=1.$ The distance from $x=0$ to $x=1$ is $1,$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{1-0}{2}=\\frac{1}{2}.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=0$ and $z(0)=0.$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ |  |  | $0$ |  |  |\n\n**Step 1**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the first row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x-y=0-0=0 \\\\ {z}^{′} & =1+y=1+0=1 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot \\frac{1}{2}=0 \\\\ Δz & ={z}^{′}\\cdot Δx=1\\cdot \\frac{1}{2}=\\frac{1}{2} \\\\ {x}_{\\text{new}} & =x+Δx=0+\\frac{1}{2}=\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy=0+0=0 \\\\ {z}_{\\text{new}} & =z+Δz=0+\\frac{1}{2}=\\frac{1}{2}\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $0$ | $0$ | $1$ | $\\frac{1}{2}$ |\n| $\\frac{1}{2}$ | $0$ |  |  | $\\frac{1}{2}$ |  |  |\n\n**Step 2**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the second row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x-y=\\frac{1}{2}-0=\\frac{1}{2} \\\\ {z}^{′} & =1+y=1+0=1 \\\\ Δy & ={y}^{′}\\cdot Δx=\\frac{1}{2}\\cdot \\frac{1}{2}=\\frac{1}{4} \\\\ Δz & ={z}^{′}\\cdot Δx=1\\cdot \\frac{1}{2}=\\frac{1}{2} \\\\ {x}_{\\text{new}} & =x+Δx=\\frac{1}{2}+\\frac{1}{2}=1 \\\\ {y}_{\\text{new}} & =y+Δy=0+\\frac{1}{4}=\\frac{1}{4} \\\\ {z}_{\\text{new}} & =z+Δz=\\frac{1}{2}+\\frac{1}{2}=1\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $0$ | $0$ | $1$ | $\\frac{1}{2}$ |\n| $\\frac{1}{2}$ | $0$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ | $1$ | $\\frac{1}{2}$ |\n| $1$ | $\\frac{1}{4}$ |  |  | $1$ |  |  |\n\nTherefore, we conclude that\n\n$$\ny(1)≈\\frac{1}{4}\\,\\text{and}\\,z(1)≈1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-335132/field-1" "q-335132/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "854a12f4-ba8e-5cfe-b044-939b33dc3086"] :knowledge-point/questions ["q-335132"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333277/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "7957db0b-5187-5ec2-8dcd-c586d2a2e42d" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-333277/field-1" :answer-field/id #uuid "13ab4801-fb13-525f-a6e9-315ca46aaffa" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333277/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-333277/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-333277/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "7d539fe7-0afb-5eef-bd6f-babdb49ec8e7" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-333277/field-2" :answer-field/id #uuid "12d42b43-8fb4-5408-b74d-7a76b1a4623b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333277/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer-field/choices ["q-333277/field-2/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133"] :db/ensure [:answer-field/validate]} {:db/id "q-333277" :question/id #uuid "43792451-4c32-56a9-859a-ec49bdf0e39a" :question/math-academy-id "q-333277" :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=2x+y-z,\\, & y(-1)=2 \\\\ {z}^{′}={x}^{2}-y+2z,\\, & z(-1)=0\\end{aligned}\n$$\n\nUse Euler's method with two steps of equal size to approximate $y(1)$ and $z(1).$\n\n$y(1)≈$\n{{field-1}},\n$\\,z(1)≈$\n{{field-2}}" :question/worked-solution "For an initial value problem\n\n$$\n{\\begin{aligned}{y}^{′}=f(x,y,z),\\, & y(a)=c, \\\\ {z}^{′}=g(x,y,z),\\, & z(a)=d,\\end{aligned}\n$$\n\nEuler's method approximates the solution by applying the update rule component-wise to each equation. More precisely, the increments on $y$ and $z$ are\n\n$$\n{\\begin{aligned}Δy={y}^{′}\\cdot Δx, \\\\ Δz={z}^{′}\\cdot Δx.\\end{aligned}\n$$\n\nThe new values are then given by ${y}_{\\text{new}}=y+Δy$ and ${z}_{\\text{new}}=z+Δz.$\n\nFirst, note that we are given the values of $y$ and $z$ at $x=-1$ and asked to find their values at $x=1.$ The distance from $x=-1$ to $x=1$ is $2,$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{1-(-1)}{2}=\\frac{2}{2}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(-1)=2$ and $z(-1)=0.$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $2$ |  |  | $0$ |  |  |\n\n**Step 1**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the first row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x+y-z=2\\cdot (-1)+2-0=0, \\\\ {z}^{′} & ={x}^{2}-y+2z=(-1)^{2}-2+2\\cdot 0=-1, \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0, \\\\ Δz & ={z}^{′}\\cdot Δx=(-1)\\cdot 1=-1, \\\\ {x}_{\\text{new}} & =x+Δx=-1+1=0, \\\\ {y}_{\\text{new}} & =y+Δy=2+0=2, \\\\ {z}_{\\text{new}} & =z+Δz=0+(-1)=-1.\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $2$ | $0$ | $0$ | $0$ | $-1$ | $-1$ |\n| $0$ | $2$ |  |  | $-1$ |  |  |\n\n**Step 2**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the second row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =2x+y-z=2\\cdot 0+2-(-1)=3, \\\\ {z}^{′} & ={x}^{2}-y+2z={0}^{2}-2+2\\cdot (-1)=-4, \\\\ Δy & ={y}^{′}\\cdot Δx=3\\cdot 1=3, \\\\ Δz & ={z}^{′}\\cdot Δx=(-4)\\cdot 1=-4, \\\\ {x}_{\\text{new}} & =x+Δx=0+1=1, \\\\ {y}_{\\text{new}} & =y+Δy=2+3=5, \\\\ {z}_{\\text{new}} & =z+Δz=-1+(-4)=-5.\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-1$ | $2$ | $0$ | $0$ | $0$ | $-1$ | $-1$ |\n| $0$ | $2$ | $3$ | $3$ | $-1$ | $-4$ | $-4$ |\n| $1$ | $5$ |  |  | $-5$ |  |  |\n\nTherefore, we conclude that\n$y(1)≈5$\nand\n$z(1)≈-5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333277/field-1" "q-333277/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "854a12f4-ba8e-5cfe-b044-939b33dc3086"] :knowledge-point/questions ["q-333277"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333279/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "63b07b4f-ae99-5ad7-85b2-30762a965eab" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-333279/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "e1a56eec-b0ad-59a5-bd02-1a3943948e7c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-333279/field-1" :answer-field/id #uuid "e5ae20e7-bbeb-599a-87b1-efcad86f268d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333279/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-333279/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-333279/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-333279/field-2/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "d92976cd-c6d6-5750-9d25-c8946ed8bfbd" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-333279/field-2" :answer-field/id #uuid "0878709a-7883-539a-a726-0b2ecae2160b" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333279/field-2/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer-field/choices ["q-333279/field-2/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd"] :db/ensure [:answer-field/validate]} {:db/id "q-333279" :question/id #uuid "84afedd7-628a-5ca4-b6c4-7866a13fe1f8" :question/math-academy-id "q-333279" :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=1-x+2y+z,\\, & y(1)=-1 \\\\ {z}^{′}=x-y+{z}^{2},\\, & z(1)=1\\end{aligned}\n$$\n\nUse Euler's method with two steps of equal size to approximate $y(3)$ and $z(3).$\n\n$y(3)≈$\n{{field-1}},\n$\\,z(3)≈$\n{{field-2}}" :question/worked-solution "For an initial value problem\n\n$$\n{\\begin{aligned}{y}^{′}=f(x,y,z),\\, & y(a)=c, \\\\ {z}^{′}=g(x,y,z),\\, & z(a)=d,\\end{aligned}\n$$\n\nEuler's method approximates the solution by applying the update rule component-wise to each equation. More precisely, the increments on $y$ and $z$ are\n\n$$\n{\\begin{aligned}Δy={y}^{′}\\cdot Δx, \\\\ Δz={z}^{′}\\cdot Δx.\\end{aligned}\n$$\n\nThe new values are then given by ${y}_{\\text{new}}=y+Δy$ and ${z}_{\\text{new}}=z+Δz.$\n\nFirst, note that we are given the values of $y$ and $z$ at $x=1$ and asked to find their values at $x=3.$ The distance from $x=1$ to $x=3$ is $2,$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{3-1}{2}=\\frac{2}{2}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(1)=-1$ and $z(1)=1.$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ |  |  | $1$ |  |  |\n\n**Step 1**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the first row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =1-x+2y+z=1-1+2\\cdot (-1)+1=-1, \\\\ {z}^{′} & =x-y+{z}^{2}=1-(-1)+{1}^{2}=3, \\\\ Δy & ={y}^{′}\\cdot Δx=(-1)\\cdot 1=-1, \\\\ Δz & ={z}^{′}\\cdot Δx=3\\cdot 1=3, \\\\ {x}_{\\text{new}} & =x+Δx=1+1=2, \\\\ {y}_{\\text{new}} & =y+Δy=-1+(-1)=-2, \\\\ {z}_{\\text{new}} & =z+Δz=1+3=4.\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $-1$ | $-1$ | $1$ | $3$ | $3$ |\n| $2$ | $-2$ |  |  | $4$ |  |  |\n\n**Step 2**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the second row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =1-x+2y+z=1-2+2\\cdot (-2)+4=-1, \\\\ {z}^{′} & =x-y+{z}^{2}=2-(-2)+{4}^{2}=20, \\\\ Δy & ={y}^{′}\\cdot Δx=(-1)\\cdot 1=-1, \\\\ Δz & ={z}^{′}\\cdot Δx=20\\cdot 1=20, \\\\ {x}_{\\text{new}} & =x+Δx=2+1=3, \\\\ {y}_{\\text{new}} & =y+Δy=-2+(-1)=-3, \\\\ {z}_{\\text{new}} & =z+Δz=4+20=24.\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $-1$ | $-1$ | $1$ | $3$ | $3$ |\n| $2$ | $-2$ | $-1$ | $-1$ | $4$ | $20$ | $20$ |\n| $3$ | $-3$ |  |  | $24$ |  |  |\n\nTherefore, we conclude that\n$y(3)≈-3$\nand\n$z(3)≈24.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333279/field-1" "q-333279/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "854a12f4-ba8e-5cfe-b044-939b33dc3086"] :knowledge-point/questions ["q-333279"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335125/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "571eb8f0-de8d-57e2-972f-d02e4f4941fb" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-335125/field-1" :answer-field/id #uuid "ca343d68-084c-56a6-a612-389f9fce93f1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335125/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-335125/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-335125/field-2/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "ad200a1e-fb87-5f2a-8726-87b4b258a60c" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-335125/field-2" :answer-field/id #uuid "fb9a9793-bf1c-5e63-9f2b-0d9e6ee4c40c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335125/field-2/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-335125/field-2/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-335125" :question/id #uuid "a17cea14-cf1a-5be5-bda7-bd48d9a65421" :question/math-academy-id "q-335125" :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=y+z,\\, & y(0)=0 \\\\ {z}^{′}=1-x,\\, & z(0)=0\\end{aligned}\n$$\n\nUse Euler's method with two steps of equal size to approximate $y(1)$ and $z(1).$\n\n$y(1)≈$\n{{field-1}},\n$\\,z(1)≈$\n{{field-2}}" :question/worked-solution "For an initial value problem\n\n$$\n{\\begin{aligned}{y}^{′}=f(x,y,z),\\, & y(a)=c, \\\\ {z}^{′}=g(x,y,z),\\, & z(a)=d,\\end{aligned}\n$$\n\nEuler's method approximates the solution by applying the update rule component-wise to each equation. More precisely, the increments on $y$ and $z$ are\n\n$$\n{\\begin{aligned}Δy={y}^{′}\\cdot Δx, \\\\ Δz={z}^{′}\\cdot Δx.\\end{aligned}\n$$\n\nThe new values are then given by ${y}_{\\text{new}}=y+Δy$ and ${z}_{\\text{new}}=z+Δz.$\n\nFirst, note that we are given the values of $y$ and $z$ at $x=0$ and asked to find their values at $x=1.$ The distance from $x=0$ to $x=1$ is $1,$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{1-0}{2}=\\frac{1}{2}.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(0)=0$ and $z(0)=0.$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ |  |  | $0$ |  |  |\n\n**Step 1**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the first row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =y+z=0+0=0 \\\\ {z}^{′} & =1-x=1-0=1 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot \\frac{1}{2}=0 \\\\ Δz & ={z}^{′}\\cdot Δx=1\\cdot \\frac{1}{2}=\\frac{1}{2} \\\\ {x}_{\\text{new}} & =x+Δx=0+\\frac{1}{2}=\\frac{1}{2} \\\\ {y}_{\\text{new}} & =y+Δy=0+0=0 \\\\ {z}_{\\text{new}} & =z+Δz=0+\\frac{1}{2}=\\frac{1}{2}\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $0$ | $0$ | $1$ | $\\frac{1}{2}$ |\n| $\\frac{1}{2}$ | $0$ |  |  | $\\frac{1}{2}$ |  |  |\n\n**Step 2**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the second row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =y+z=0+\\frac{1}{2}=\\frac{1}{2} \\\\ {z}^{′} & =1-x=1-\\frac{1}{2}=\\frac{1}{2} \\\\ Δy & ={y}^{′}\\cdot Δx=\\frac{1}{2}\\cdot \\frac{1}{2}=\\frac{1}{4} \\\\ Δz & ={z}^{′}\\cdot Δx=\\frac{1}{2}\\cdot \\frac{1}{2}=\\frac{1}{4} \\\\ {x}_{\\text{new}} & =x+Δx=\\frac{1}{2}+\\frac{1}{2}=1 \\\\ {y}_{\\text{new}} & =y+Δy=0+\\frac{1}{4}=\\frac{1}{4} \\\\ {z}_{\\text{new}} & =z+Δz=\\frac{1}{2}+\\frac{1}{4}=\\frac{3}{4}\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $0$ | $0$ | $0$ | $0$ | $0$ | $1$ | $\\frac{1}{2}$ |\n| $\\frac{1}{2}$ | $0$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ | $\\frac{1}{2}$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ |\n| $1$ | $\\frac{1}{4}$ |  |  | $\\frac{3}{4}$ |  |  |\n\nTherefore, we conclude that\n\n$$\ny(1)≈\\frac{1}{4}\\,\\text{and}\\,z(1)≈\\frac{3}{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-335125/field-1" "q-335125/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "854a12f4-ba8e-5cfe-b044-939b33dc3086"] :knowledge-point/questions ["q-335125"] :db/ensure [:knowledge-point/validate]} {:db/id "q-332892/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "50c1b9fb-39e0-5dfb-add8-1e80ac6b9d43" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id 17592186164391 :answer-field/correct "q-332892/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-332892/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-332892/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "17d53145-7032-564a-bb13-c8fa05824465" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id 17592186164392 :answer-field/correct "q-332892/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-332892/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-332892"] :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=x+3y-{z}^{2},\\, & y(-2)=1 \\\\ {z}^{′}=x-y+2z,\\, & z(-2)=1\\end{aligned}\n$$\n\nUse Euler's method with two steps of equal size to approximate $y(0)$ and $z(0).$\n\n$y(0)≈$\n{{field-1}},\n$\\,z(0)≈$\n{{field-2}}" :question/worked-solution "For an initial value problem\n\n$$\n{\\begin{aligned}{y}^{′}=f(x,y,z),\\, & y(a)=c, \\\\ {z}^{′}=g(x,y,z),\\, & z(a)=d,\\end{aligned}\n$$\n\nEuler's method approximates the solution by applying the update rule component-wise to each equation. More precisely, the increments on $y$ and $z$ are\n\n$$\n{\\begin{aligned}Δy={y}^{′}\\cdot Δx, \\\\ Δz={z}^{′}\\cdot Δx.\\end{aligned}\n$$\n\nThe new values are then given by ${y}_{\\text{new}}=y+Δy$ and ${z}_{\\text{new}}=z+Δz.$\n\nFirst, note that we are given the values of $y$ and $z$ at $x=-2$ and asked to find their values at $x=0.$ The distance from $x=-2$ to $x=0$ is $2,$ and since we are asked to use two steps of equal size, our step size must be\n\n$$\nΔx=\\frac{0-(-2)}{2}=\\frac{2}{2}=1.\n$$\n\nNow, let's proceed with Euler's method. We'll start by creating a table that includes the initial condition data $y(-2)=1$ and $z(-2)=1.$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-2$ | $1$ |  |  | $1$ |  |  |\n\n**Step 1**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the first row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x+3y-{z}^{2}=-2+3\\cdot 1-{1}^{2}=0 \\\\ {z}^{′} & =x-y+2z=-2-1+2\\cdot 1=-1 \\\\ Δy & ={y}^{′}\\cdot Δx=0\\cdot 1=0 \\\\ Δz & ={z}^{′}\\cdot Δx=-1\\cdot 1=-1 \\\\ {x}_{\\text{new}} & =x+Δx=-2+1=-1 \\\\ {y}_{\\text{new}} & =y+Δy=1+0=1 \\\\ {z}_{\\text{new}} & =z+Δz=1+(-1)=0\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-2$ | $1$ | $0$ | $0$ | $1$ | $-1$ | $-1$ |\n| $-1$ | $1$ |  |  | $0$ |  |  |\n\n**Step 2**.\n\nWe compute ${y}^{′}$ and $Δy,$ ${z}^{′}$ and $Δz$ (using the values of $x,$ $y,$ and $z$ in the second row), and the values of ${x}_{\\text{new}},$ ${y}_{\\text{new}},$ and ${z}_{\\text{new}}$ using Euler's method:\n\n$$\n\\begin{aligned}{y}^{′} & =x+3y-{z}^{2}=-1+3\\cdot 1-{0}^{2}=2 \\\\ {z}^{′} & =x-y+2z=-1-1+2\\cdot 0=-2 \\\\ Δy & ={y}^{′}\\cdot Δx=2\\cdot 1=2 \\\\ Δz & ={z}^{′}\\cdot Δx=-2\\cdot 1=-2 \\\\ {x}_{\\text{new}} & =x+Δx=-1+1=0 \\\\ {y}_{\\text{new}} & =y+Δy=1+2=3 \\\\ {z}_{\\text{new}} & =z+Δz=0+(-2)=-2\\end{aligned}\n$$\n\nWe add these values to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $-2$ | $1$ | $0$ | $0$ | $1$ | $-1$ | $-1$ |\n| $-1$ | $1$ | $2$ | $2$ | $0$ | $-2$ | $-2$ |\n| $0$ | $3$ |  |  | $-2$ |  |  |\n\nTherefore, we conclude that\n$y(0)≈3$\nand\n$z(0)≈-2.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-335285/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "b0f13da2-a2ad-5379-a7db-635018de10ca" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-335285/field-1" :answer-field/id #uuid "d934e650-a1d5-5a0e-af1f-90038b7447b0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335285/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-335285/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-335285/field-2/ed43d5224151224cedff9572a0bc31a320bd7a8ebd2aa526ca5884904c9d6cb4" :answer/id #uuid "f79e5bb2-a45a-526e-8b92-d460dc208770" :answer/type :answer.type/math :answer/value "\\frac{9}{4}" :db/ensure [:answer/validate]} {:db/id "q-335285/field-2" :answer-field/id #uuid "f6aa6c7e-2182-529e-9a51-81fefb8e42a0" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335285/field-2/ed43d5224151224cedff9572a0bc31a320bd7a8ebd2aa526ca5884904c9d6cb4" :answer-field/choices ["q-335285/field-2/ed43d5224151224cedff9572a0bc31a320bd7a8ebd2aa526ca5884904c9d6cb4"] :db/ensure [:answer-field/validate]} {:db/id "q-335285/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "5acefb5a-d03c-5261-a0a9-b155b683f836" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-335285/field-3" :answer-field/id #uuid "bd2a0133-bfac-5572-a07c-65c17e04c5b5" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-335285/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-335285/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-335285" :question/id #uuid "093ac35e-f604-539e-9b64-0532189327a6" :question/math-academy-id "q-335285" :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x),w=w(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=xz+1,\\, & y\\,(-\\frac{1}{2})=0 \\\\ {z}^{′}=y+w-x,\\, & z\\,(-\\frac{1}{2})=1 \\\\ {w}^{′}=-yz,\\, & w\\,(-\\frac{1}{2})=2\\end{aligned}\n$$\n\nUse Euler's Method with one step to approximate $y(0),$ $z(0),$ and $w(0).$\n\n$\\,y(0)≈$\n{{field-1}},\n$\\,z(0)≈$\n{{field-2}},\n$\\,w(0)≈$\n{{field-3}}" :question/worked-solution "Euler's method approximates the solution of an initial value problem containing a system of ODEs by applying the update rule component-wise to each equation.\n\nSince we want to find the values of $y,$ $z,$ and $w$ at $x=0,$ we will use a step size of\n\n$$\nΔx=0-(-\\frac{1}{2})=\\frac{1}{2}.\n$$\n\nFirst, we place the initial condition data in a table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ | $w$ | ${w}^{′}$ | $Δw$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $-\\frac{1}{2}$ | $0$ |  |  | $1$ |  |  | $2$ |  |  |\n\nNext, we compute ${y}^{′},$ ${z}^{′},$ and ${w}^{′}$ according to the given rules:\n\n$$\n\\begin{aligned}{y}^{′} & =xz+1 \\\\  & =(-\\frac{1}{2})\\cdot 1+1 \\\\  & =\\frac{1}{2} \\\\ {z}^{′} & =y+w-x \\\\  & =0+2-(-\\frac{1}{2}) \\\\  & =\\frac{5}{2} \\\\ {w}^{′} & =-yz \\\\  & =-(0)\\cdot 1 \\\\  & =0\\end{aligned}\n$$\n\nSo, we add these to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ | $w$ | ${w}^{′}$ | $Δw$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $-\\frac{1}{2}$ | $0$ | $\\frac{1}{2}$ |  | $1$ | $\\frac{5}{2}$ |  | $2$ | $0$ |  |\n\nNext, we compute $Δy,$ $Δz,$ and $Δw$ using Euler's method:\n\n$$\n\\begin{aligned}Δy & ={y}^{′}\\cdot Δx \\\\  & =\\frac{1}{2}\\cdot \\frac{1}{2} \\\\  & =\\frac{1}{4} \\\\ Δz & ={z}^{′}\\cdot Δx \\\\  & =\\frac{5}{2}\\cdot \\frac{1}{2} \\\\  & =\\frac{5}{4} \\\\ Δw & ={w}^{′}\\cdot Δx \\\\  & =0\\cdot \\frac{1}{2} \\\\  & =0\\end{aligned}\n$$\n\nWe add these to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ | $w$ | ${w}^{′}$ | $Δw$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $-\\frac{1}{2}$ | $0$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ | $1$ | $\\frac{5}{2}$ | $\\frac{5}{4}$ | $2$ | $0$ | $0$ |\n\nTo get the new values of $x,$ $y,$ $z,$ and $w$ in the *next* row, we add $Δx$ to $x,$ $Δy$ to $y,$ $Δz$ to $z,$ and $Δw$ to $w,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx=-\\frac{1}{2}+\\frac{1}{2}=0 \\\\ {y}_{\\text{new}} & =y+Δy=0+\\frac{1}{4}=\\frac{1}{4} \\\\ {z}_{\\text{new}} & =z+Δz=1+\\frac{5}{4}=\\frac{9}{4} \\\\ {w}_{\\text{new}} & =w+Δw=2+0=2\\end{aligned}\n$$\n\nAdding these values to our table in a new row gives the following:\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ | $w$ | ${w}^{′}$ | $Δw$ |\n| --- | --- | --- | --- | --- | --- | --- | --- | --- | --- |\n| $-\\frac{1}{2}$ | $0$ | $\\frac{1}{2}$ | $\\frac{1}{4}$ | $1$ | $\\frac{5}{2}$ | $\\frac{5}{4}$ | $2$ | $0$ | $0$ |\n| $0$ | $\\frac{1}{4}$ |  |  | $\\frac{9}{4}$ |  |  | $2$ |  |  |\n\nTherefore, we conclude that\n\n$$\ny(0)≈\\frac{1}{4},\\,z(0)≈\\frac{9}{4},\\,w(0)≈2.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-335285/field-1" "q-335285/field-2" "q-335285/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c8b20277-7fb3-5702-a295-1b1722d1cc5d"] :knowledge-point/questions ["q-335285"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335367/field-1/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "a8737bbc-2a6f-5