aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-333823/field-4/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "40c94a75-6b23-52cd-9116-abeb3fbe0940" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-333823/field-4" :answer-field/id #uuid "1e574577-29aa-5a98-a423-4cc5c66d1e94" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-333823/field-4/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-333823/field-4/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-333823" :question/id #uuid "74705740-066f-5911-8220-fe8b5043de46" :question/math-academy-id "q-333823" :question/problem "Consider the following initial value problem for the functions $y=y(x),z=z(x):$\n\n$$\n{\\begin{aligned}{y}^{′}=6x+2y+z,\\, & y(1)=-1 \\\\ {z}^{′}=2x-y+z,\\, & z(1)=3\\end{aligned}\n$$\n\nWe wish to approximate the solution using Euler's method.\nWhat entries should be placed in the columns for $Δy$ and $Δz$ in the table below if the step size is $Δx=1?$\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ |  |  | {{field-1}} |  |  | {{field-2}} |\n\nTherefore, $y(2)≈$\n{{field-3}}\nand $z(2)≈$\n{{field-4}}." :question/worked-solution "For an initial value problem\n\n$$\n{\\begin{aligned}{y}^{′}=f(x,y,z),\\, & y(a)=c, \\\\ {z}^{′}=g(x,y,z),\\, & z(a)=d,\\end{aligned}\n$$\n\nEuler's method approximates the solution by applying the update rule component-wise to each equation. More precisely, the increments on $y$ and $z$ are\n\n$$\n{\\begin{aligned}Δy={y}^{′}\\cdot Δx, \\\\ Δz={z}^{′}\\cdot Δx.\\end{aligned}\n$$\n\nThe new values are then given by ${y}_{\\text{new}}=y+Δy$ and ${z}_{\\text{new}}=z+Δz.$\n\nFirst, because the initial conditions are $y(1)=-1$ and $z(1)=3,$ we place $y=-1$ and $z=3$ in the table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ |  |  | $3$ |  |  |\n\nNext, we compute both ${y}^{′}$ and ${z}^{′}$ according to the given rules:\n\n$$\n\\begin{aligned}{y}^{′} & =6x+2y+z \\\\  & =6\\cdot 1+2\\cdot (-1)+3 \\\\  & =6-2+3 \\\\  & =7 \\\\ {z}^{′} & =2x-y+z \\\\  & =2\\cdot 1-(-1)+3 \\\\  & =2+1+3 \\\\  & =6\\end{aligned}\n$$\n\nSo, we add these to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $7$ |  | $3$ | $6$ |  |\n\nFinally, we compute $Δy$ and $Δz$ using Euler's method:\n\n$$\n\\begin{aligned}Δy & ={y}^{′}\\cdot Δx \\\\  & =7\\cdot 1 \\\\  & =7, \\\\ Δz & ={z}^{′}\\cdot Δx \\\\  & =6\\cdot 1 \\\\  & =6.\\end{aligned}\n$$\n\nWe add these to our table.\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $7$ | $7$ | $3$ | $6$ | $6$ |\n\nTo get the new values of $x,$ $y,$ and $z$ in the *next* row, we add $Δx$ to $x,$ $Δy$ to $y,$ and $Δz$ to $z,$ as follows:\n\n$$\n\\begin{aligned}{x}_{\\text{new}} & =x+Δx=1+1=2, \\\\ {y}_{\\text{new}} & =y+Δy=-1+7=6, \\\\ {z}_{\\text{new}} & =z+Δz=3+6=9.\\end{aligned}\n$$\n\nAdding these values to our table in a new row gives the following:\n\n| $x$ | $y$ | ${y}^{′}$ | $Δy$ | $z$ | ${z}^{′}$ | $Δz$ |\n| --- | --- | --- | --- | --- | --- | --- |\n| $1$ | $-1$ | $7$ | $7$ | $3$ | $6$ | $6$ |\n| $2$ | $6$ |  |  | $9$ |  |  |\n\nTherefore, we conclude that $y(2)≈6$ and $z(2)≈9.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-333823/field-1" "q-333823/field-2" "q-333823/field-3" "q-333823/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "70c9c14c-62d1-592c-81f7-92d683050e3c"] :knowledge-point/questions ["q-333823"] :db/ensure [:knowledge-point/validate]} {:db/id "q-333827/field-1/7845f5bf94d2cf