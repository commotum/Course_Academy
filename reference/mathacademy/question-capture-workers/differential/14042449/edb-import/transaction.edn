[{:db/id "kp-fcf6bdc9-3628-5a16-88d6-80be1670c38d" :knowledge-point/id #uuid "fcf6bdc9-3628-5a16-88d6-80be1670c38d" :knowledge-point/title "Identifying Piecewise-Smooth Functions" :db/ensure [:knowledge-point/validate]} {:db/id [:topic/math-academy-id 6669] :topic/knowledge-points ["kp-fcf6bdc9-3628-5a16-88d6-80be1670c38d"]} {:db/id "q-341433/selection/0c1ca63c3c6c805ef06c7bcf31ae0d5219aad8d8f314916c203a48f8e14c7d02" :answer/id #uuid "b6e1dbae-f84f-588f-b087-fcf9f8e30743" :answer/type :answer.type/text :answer/value "$f$ and $g$ only" :db/ensure [:answer/validate]} {:db/id "q-341433/selection/2a1d8a89f00ace1b1ddd51d9e5ff705929e76b6edeee97f394d666550954368a" :answer/id #uuid "cdd58f86-a2c0-5029-adce-eb9cf6d062a2" :answer/type :answer.type/text :answer/value "$h$ only" :db/ensure [:answer/validate]} {:db/id "q-341433/selection/bb292cda762e5b8cdec132334ba43c76a2cfaab9cfffc89bd50f767fb9b03a74" :answer/id #uuid "4d6ab5cb-96d1-520a-9a07-40a6cb4a4b97" :answer/type :answer.type/text :answer/value "$f$ only" :db/ensure [:answer/validate]} {:db/id "q-341433/selection/03748f52aea6637ec4ac8e6115a0813c94904a56cb803618e611dd65fd847541" :answer/id #uuid "a29e4b4e-76e2-5d6a-b13c-a3e4a39f0063" :answer/type :answer.type/text :answer/value "$f,g$ and $h$" :db/ensure [:answer/validate]} {:db/id "q-341433/selection/c820fc75b83ab642062caecaa665e20c3efdace607db6b590468cae51c449859" :answer/id #uuid "403bad6a-8138-5ae4-8853-65d3a06dcb7f" :answer/type :answer.type/text :answer/value "$f$ and $h$ only" :db/ensure [:answer/validate]} {:db/id "q-341433/selection" :answer-field/id #uuid "8604277d-2913-53dd-9c20-eb301d8e681f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-341433/selection/c820fc75b83ab642062caecaa665e20c3efdace607db6b590468cae51c449859" :answer-field/choices ["q-341433/selection/0c1ca63c3c6c805ef06c7bcf31ae0d5219aad8d8f314916c203a48f8e14c7d02" "q-341433/selection/2a1d8a89f00ace1b1ddd51d9e5ff705929e76b6edeee97f394d666550954368a" "q-341433/selection/bb292cda762e5b8cdec132334ba43c76a2cfaab9cfffc89bd50f767fb9b03a74" "q-341433/selection/03748f52aea6637ec4ac8e6115a0813c94904a56cb803618e611dd65fd847541" "q-341433/selection/c820fc75b83ab642062caecaa665e20c3efdace607db6b590468cae51c449859"] :db/ensure [:answer-field/validate]} {:db/id "q-341433" :question/id #uuid "531d87af-4210-5449-9281-58ee14134875" :question/math-academy-id "q-341433" :question/problem "Which of the following functions are piecewise continuous on $x\\in [0,\\pi ].$\n\n$$\nf(x)={\\begin{aligned}x-1,\\, & x\\ne 1 \\\\ 2,\\, & x=1,\\end{aligned}\\,g(x)=\\operatorname{tan}⁡x\\,h(x)={2}^{x+1}.\n$$" :question/worked-solution "A function $f(x)$ is piecewise continuous on $x\\in [a,b]$ if\n\n- it is continuous on $[a,b]$ except at finitely many points, and\n\n- at each point of discontinuity, the one-sided limits exist and are finite.\n\nIn other words, there can only be finitely many discontinuities, and each of them must be either a point or a jump discontinuity.\n\nWith that in mind, let's examine each function.\n\n- The function $f(x)$ is piecewise continuous over $x\\in [0,\\pi ]$ since it is continuous over $x\\in [0,\\pi ]$ except at the point $x=1,$ where the one-sided limits exist and are finite:\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)={lim}_{x\\to {1}^{+}}f(x)=0\n$$\n\n- The function $g(x)$ is not piecewise continuous over $x\\in [0,\\pi ]$ since the one-sided limits at $x=\\frac{\\pi }{2}$ are infinite:\n\n$$\n{lim}_{x\\to \\pi /{2}^{-}}g(x)=+\\infty ,\\,{lim}_{x\\to \\pi /{2}^{+}}g(x)=-\\infty \n$$\n\n- The function $h(x)$ is piecewise continuous over $x\\in [0,\\pi ]$ since it is continuous over $x\\in [0,\\pi ].$\n\nTherefore, the correct answer is \"$f$ and $h$ only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341433/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35b757ed-e2b3-5ab2-8cef-6ec9ef7bb7e8"] :knowledge-point/questions ["q-341433"] :db/ensure [:knowledge-point/validate]} {:db/id "q-341431/selection/54260034644bf2398d955582fcfe14cc95cc4887ad666376368d8327ed5e3102" :answer/id #uuid "1bd5c92b-6d7d-5e2a-8ddc-c5c6d8797ffe" :answer/type :answer.type/text :answer/value "$g$ only" :db/ensure [:answer/validate]} {:db/id "q-341431/selection/3a3755feb1a05cec3176c3d2cc45a265049aa4bdd6b69f00387a116663369c21" :answer/id #uuid "25269ca1-4940-5a95-ad2b-837c29b40599" :answer/type :answer.type/text :answer/value "$f,g,$ and $h$" :db/ensure [:answer/validate]} {:db/id "q-341431/selection/bb292cda762e5b8cdec132334ba43c76a2cfaab9cfffc89bd50f767fb9b03a74" :answer/id #uuid "4fd0fac0-14c8-5fe7-adef-fc06b1d8416d" :answer/type :answer.type/text :answer/value "$f$ only" :db/ensure [:answer/validate]} {:db/id "q-341431/selection/c820fc75b83ab642062caecaa665e20c3efdace607db6b590468cae51c449859" :answer/id #uuid "966ae377-9b36-53fe-9d32-9d8c75e94faa" :answer/type :answer.type/text :answer/value "$f$ and $h$ only" :db/ensure [:answer/validate]} {:db/id "q-341431/selection/0c1ca63c3c6c805ef06c7bcf31ae0d5219aad8d8f314916c203a48f8e14c7d02" :answer/id #uuid "3922de2b-4290-5f29-a23b-44977f73451f" :answer/type :answer.type/text :answer/value "$f$ and $g$ only" :db/ensure [:answer/validate]} {:db/id "q-341431/selection" :answer-field/id #uuid "38946df1-1937-57d3-8ebb-2d5ae7a6e14c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-341431/selection/3a3755feb1a05cec3176c3d2cc45a265049aa4bdd6b69f00387a116663369c21" :answer-field/choices ["q-341431/selection/54260034644bf2398d955582fcfe14cc95cc4887ad666376368d8327ed5e3102" "q-341431/selection/3a3755feb1a05cec3176c3d2cc45a265049aa4bdd6b69f00387a116663369c21" "q-341431/selection/bb292cda762e5b8cdec132334ba43c76a2cfaab9cfffc89bd50f767fb9b03a74" "q-341431/selection/c820fc75b83ab642062caecaa665e20c3efdace607db6b590468cae51c449859" "q-341431/selection/0c1ca63c3c6c805ef06c7bcf31ae0d5219aad8d8f314916c203a48f8e14c7d02"] :db/ensure [:answer-field/validate]} {:db/id "q-341431" :question/id #uuid "e0a7bdac-40b1-5174-8ff3-41111d8bd21d" :question/math-academy-id "q-341431" :question/problem "Which of the following functions are piecewise continuous on $x\\in [-1,2].$\n\n$$\nf(x)={\\begin{aligned}{x}^{2}+5,\\, & x\\ne 1 \\\\ -2,\\, & x=1,\\end{aligned}\\,g(x)=\\operatorname{ln}⁡(x+3),\\,h(x)={e}^{1-x}.\n$$" :question/worked-solution "A function $f(x)$ is piecewise continuous on $x\\in [a,b]$ if\n\n- it is continuous on $[a,b]$ except at finitely many points, and\n\n- at each point of discontinuity, the one-sided limits exist and are finite.\n\nIn other words, there can only be finitely many discontinuities, and each of them must be either a point or a jump discontinuity.\n\nWith that in mind, let's examine each function.\n\n- The function $f(x)$ is piecewise continuous over $x\\in [-1,2]$ since it is continuous over $x\\in [-1,2]$ except at the point $x=1,$ where the one-sided limits exist and are finite:\n\n$$\n{lim}_{x\\to {1}^{-}}f(x)={lim}_{x\\to {1}^{+}}f(x)=6\n$$\n\n- The function $g(x)$ is piecewise continuous over $x\\in [-1,2]$ since it is continuous over $x\\in [-1,2].$\n\n- The function $h(x)$ is piecewise continuous over $x\\in [-1,2]$ since it is continuous over $x\\in [-1,2].$\n\nTherefore, the correct answer is \"$f,g,$ and $h.$\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-341431/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "35b757ed-e2b3-5ab2-8cef-6ec9ef7bb7e8"] :knowledge-point/questions ["q-341431"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186229686 :question/answer-fields 17592186228579] {:db/id "q-340908/selection/ma-v1/071435deba0788bcca584c136a492878bc5224fc7d5c598b6d98dc84ef83621b/3a3755feb1a05cec3176c3d2cc45a265049aa4bdd6b69f00387a116663369c21" :answer/id #uuid "d85fb704-48eb-5fa6-928b-d253419f98df" :answer/type :answer.type/text :answer/value "$f,g,$ and $h$" :db/ensure [:answer/validate]} {:db/id "q-340908/selection/ma-v1/