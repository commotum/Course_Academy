b/ident :answer.type/math} :answer/value "y =-\\frac{x^{2}}{2}" :db/id #edb/ref 17592186216552} {:answer/id #uuid "f2d0957f-ba17-5b44-85ae-d329d0a3e2d5" :answer/type {:db/ident :answer.type/math} :answer/value "y =-x^{2}" :db/id #edb/ref 17592186216553} {:answer/id #uuid "0f55d7e4-54cc-5a33-a7aa-6b4030610e8e" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{x^{2}}{2}" :db/id #edb/ref 17592186216554}] :answer-field/correct {:answer/id #uuid "a2c5c98a-feb1-5c85-b440-f462fb2a314f" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\frac{x^{2}}{4}" :db/id #edb/ref 17592186216550} :answer-field/id #uuid "868d0f5b-8b10-55ea-a693-68260b8c3c22" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186216549}] :question/id #uuid "a266b256-994a-5563-82c8-322702645919" :question/math-academy-id "q-334398" :question/problem "Find the singular solution to the following Clairaut differential equation:\n\n$y = xy^{′} + (y^{′})^{2}$."}]}
