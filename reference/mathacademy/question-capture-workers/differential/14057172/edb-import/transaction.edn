fa398b5" "q-338129/field-2/97af8a97437bb05d33f587f3c91a826e361d57b91ceb75d8bcbe4fc23ba56742" "q-338129/field-2/b1e758852c792eb12f69e3ef7a6a07006fe332ba6da1310a0141dc5a22255a29"] :db/ensure [:answer-field/validate]} {:db/id "q-338129/field-3/e49e6899d4b9585fff8b3233d9af9c21d3823d3b33a4081364b4bf53815f71bb" :answer/id #uuid "6b12a7f6-8a45-566d-b5dd-011fdfad4e79" :answer/type :answer.type/math :answer/value "{e}^{3x}-\\frac{1}{2}x{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-338129/field-3/0c55894530fa5a98a671b35687f451b5fd2aea25debb9e276ebde4af6ddccd48" :answer/id #uuid "137c9ba6-d2ba-5a39-b61c-af416817e6d1" :answer/type :answer.type/math :answer/value "{e}^{3x}-x{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-338129/field-3/a4f035f26dafad14178ba3bc852665a71c50b86fa19669b54ee002042e9be7e1" :answer/id #uuid "af238b7c-27f4-5751-ae7c-947df35f94ec" :answer/type :answer.type/math :answer/value "3x{e}^{3x}-\\frac{1}{2}{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-338129/field-3/f62c2b55ed01d8ee5ee0299032f6756ab9fbe3d287fb1cc6bd782cf2eb9dc5eb" :answer/id #uuid "3390a2ea-9386-5a81-9669-6ba5366dea4d" :answer/type :answer.type/math :answer/value "3x{e}^{3x}-{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-338129/field-3" :answer-field/id #uuid "29a9537d-e6fc-50e4-92c2-a5164921c0d4" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-338129/field-3/a4f035f26dafad14178ba3bc852665a71c50b86fa19669b54ee002042e9be7e1" :answer-field/choices ["q-338129/field-3/e49e6899d4b9585fff8b3233d9af9c21d3823d3b33a4081364b4bf53815f71bb" "q-338129/field-3/0c55894530fa5a98a671b35687f451b5fd2aea25debb9e276ebde4af6ddccd48" "q-338129/field-3/a4f035f26dafad14178ba3bc852665a71c50b86fa19669b54ee002042e9be7e1" "q-338129/field-3/f62c2b55ed01d8ee5ee0299032f6756ab9fbe3d287fb1cc6bd782cf2eb9dc5eb"] :db/ensure [:answer-field/validate]} {:db/id "q-338129" :question/id #uuid "30381914-6c05-5474-8e6f-cee39aeb98f0" :question/math-academy-id "q-338129" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3y=6\\operatorname{cosh}⁡3x.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-3{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{3x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{3x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{3x})}^{′}-3(u{e}^{3x}) & =6\\operatorname{cosh}⁡3x \\\\ {u}^{′}{e}^{3x}+3u{e}^{3x}-3u{e}^{3x} & =6\\operatorname{cosh}⁡3x \\\\ {u}^{′}{e}^{3x}+\\cancel{3u{e}^{3x}}-\\cancel{3u{e}^{3x}} & =6\\operatorname{cosh}⁡3x \\\\ {u}^{′}{e}^{3x} & =6\\operatorname{cosh}⁡3x \\\\ {u}^{′} & =6{e}^{-3x}\\operatorname{cosh}⁡3x\\end{aligned}\n$$\n\nUsing the fact that \n\n$$\n\\operatorname{cosh}⁡3x=\\frac{{e}^{3x}+{e}^{-3x}}{2}\n$$\n\nour equation for $u$ becomes\n\n$$\n\\begin{aligned}{u}^{′} & =6{e}^{-3x}\\operatorname{cosh}⁡3x \\\\  & =6{e}^{-3x}(\\frac{{e}^{3x}+{e}^{-3x}}{2}) \\\\  & =3{e}^{-3x}({e}^{3x}+{e}^{-3x}) \\\\  & =3+3{e}^{-6x}.\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =3+3{e}^{-6x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int 3+3{e}^{-6x}\\,\\text{d}x \\\\ u & =3x-\\frac{1}{2}{e}^{-6x}.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{3x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{3x} \\\\  & =3x{e}^{3x}-\\frac{1}{2}{e}^{-3x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-338129/field-1" "q-338129/field-2" "q-338129/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a5fb547a-2518-5db9-b1b1-aab8d80328af"] :knowledge-point/questions ["q-338129"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352892/field-1/0dfd7211371cc7d8403c054fcef962b61d8a8feaf3d34d77257754f397cd581b" :answer/id #uuid "93613f48-348c-5950-a6db-3fcaf4392705" :answer/type :answer.type/math :answer/value "u(x){e}^{-5x}" :db/ensure [:answer/validate]} {:db/id "q-352892/field-1/d2e81689053b2ebae446faeee3737f8c65f277d7870bb0a42ccc7852d3d0d24d" :answer/id #uuid "5a281eaf-9838-521f-aeb1-7a4d3237e311" :answer/type :answer.type/math :answer/value "u(x){e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-352892/field-1/731809e6967206c0c06d8bc301ac761310a988b1ff753feac3df89e794575d15" :answer/id #uuid "4644aa7a-c2b1-562b-956a-69255128e5ce" :answer/type :answer.type/math :answer/value "u(x){e}^{x}" :db/ensure [:answer/validate]} {:db/id "q-352892/field-1/445f108130eddd660efb3f4e744c623ab48e31797df84645d9dabb690099bd49" :answer/id #uuid "02a6cece-6b1c-5f98-a1a5-0b4926de0c5d" :answer/type :answer.type/math :answer/value "u(x){e}^{4x}" :db/ensure [:answer/validate]} {:db/id "q-352892/field-1/1c87915a6c57b766bbb06d9fd3b05c238a68caca6be59893391c9af122458273" :answer/id #uuid "c65b486a-aca0-594c-aa78-acbb135c9c12" :answer/type :answer.type/math :answer