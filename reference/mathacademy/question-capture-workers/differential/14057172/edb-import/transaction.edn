2366895be860" :answer/id #uuid "a396b4f0-425b-5695-972d-bbae38db063c" :answer/type :answer.type/math :answer/value "7{e}^{-4x}" :db/ensure [:answer/validate]} {:db/id "q-337375/field-3/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" :answer/id #uuid "536fae60-901b-57bd-b475-e2ffcd9d57d7" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "q-337375/field-3/9330decb7a79f4709f67b5d23737386e20e528a4a5463a723cea62f9e8191ed5" :answer/id #uuid "c7bc405d-b6cc-5e73-aaa6-f82a0eedb9b3" :answer/type :answer.type/math :answer/value "\\frac{7}{4}{e}^{4x}" :db/ensure [:answer/validate]} {:db/id "q-337375/field-3/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "f8a47ab9-58a1-5e66-98c1-7ec2dc3ab4ee" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-337375/field-3/7627fb02fec1c7a865cb3e7797f7ea7835cb8ec3423f266885f8f5d01084e358" :answer/id #uuid "da9a978a-6f04-5b0e-b1ba-330671ce800b" :answer/type :answer.type/math :answer/value "-\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "q-337375/field-3" :answer-field/id #uuid "70921230-38fa-5ad2-9101-f1bfc99a73de" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-337375/field-3/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" :answer-field/choices ["q-337375/field-3/4e69ac22c7c11200dd58d6360c527d0084942f19bb607487182d2366895be860" "q-337375/field-3/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" "q-337375/field-3/9330decb7a79f4709f67b5d23737386e20e528a4a5463a723cea62f9e8191ed5" "q-337375/field-3/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-337375/field-3/7627fb02fec1c7a865cb3e7797f7ea7835cb8ec3423f266885f8f5d01084e358"] :db/ensure [:answer-field/validate]} {:db/id "q-337375" :question/id #uuid "2c874b63-ba61-5224-951d-5ad10fbf990c" :question/math-academy-id "q-337375" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+4y=7.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+4{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-4x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{-4x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{-4x})}^{′}+4(u{e}^{-4x}) & =7 \\\\ {u}^{′}{e}^{-4x}-4u{e}^{-4x}+4u{e}^{-4x} & =7 \\\\ {u}^{′}{e}^{-4x}-\\cancel{4u{e}^{-4x}}+\\cancel{4u{e}^{-4x}} & =7 \\\\ {u}^{′}{e}^{-4x} & =7 \\\\ {u}^{′} & =7{e}^{4x}\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & =7{e}^{4x} \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int 7{e}^{4x}\\,\\text{d}x \\\\ u & =\\frac{7}{4}{e}^{4x}.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{-4x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{-4x} \\\\  & =\\frac{7}{4}{e}^{4x}\\cdot {e}^{-4x} \\\\  & =\\frac{7}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-337375/field-1" "q-337375/field-2" "q-337375/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ac34a18-053d-5eab-8c2c-bd0f15658186"] :knowledge-point/questions ["q-337375"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337395/field-1/1c87915a6c57b766bbb06d9fd3b05c238a68caca6be59893391c9af122458273" :answer/id #uuid "9675e90c-04c4-575a-bb2c-e0e709f70828" :answer/type :answer.type/math :answer/value "u(x){e}^{5x}" :db/ensure [:answer/validate]} {:db/id "q-337395/field-1/d2e81689053b2ebae446faeee3737f8c65f277d7870bb0a42ccc7852d3d0d24d" :answer/id #uuid "3fdac4b0-c9ab-5666-82c2-ce9a8b86ff2d" :answer/type :answer.type/math :answer/value "u(x){e}^{-x}" :db/ensure [:answer/validate]} {:db/id "q-337395/field-1/0f0bf3e5b4d49d098cc5baf660c6977edc9ec113af6f735d59f497de50943951" :answer/id #uuid "45b747e4-2547-559c-94e6-c31c4087f78e" :answer/type :answer.type/math :answer/value "u(x){e}^{-2x}" :db/ensure [:answer/validate]} {:db/id "q-337395/field-1/58e66e13dc98313f1c71e73a32f04479429e770bf3852598ea62e9f4fbb454e6" :answer/id #uuid "49ca8f81-e15c-50ed-a80f-2153a5ffdd94" :answer/type :answer.type/math :answer/value "u(x){e}^{2x}" :db/ensure [:answer/validate]} {:db/id "q-337395/field-1/731809e6967206c0c06d8bc301ac761310a988b1ff753feac3df89e794575d15" :answer/id #uuid "e17900bb-7c78-53d4-9cb9-492d9e7ba0b4" :answer/type :answer.type/math :answer/value "u(x){e}^{x}" :db/ensure [:answer/validate]} {:db/id "q-337395/field-1" :answer-field/id #uuid "f3c6b39e-c0e6-5e97-b21d-45795ae718eb" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-337395/field-1/731809e6967206c0c06d8bc301ac761310a988b1ff753feac3df89e794575d15" :answer-field/choices ["q-337395/field-1/1c87915a6c57b766bbb06d9fd3b05c238a68caca6be59893391c9af122458273" "q-337395/field-1/d2e81689053b2ebae446faeee3737f8c65f277d7870bb0a42ccc7852d3d0d24d" "q-337395/field-1/0f0bf3e5b4d49d098cc5baf660c6977edc9ec113af6f735d59f497de50943951" "q-337395/field-1/58e66e13dc98313f1c71e73a32f04479429e770bf3852598ea62e9f4fbb454e6" "q-337395/field-1/731809e6967206c0c06d8bc301ac761310a988b1ff753feac3df89e794575d15"] :db/ensure [:answer-field/validate]} {:db/id "q-337395/field-2/39074337ed28e6c143210ba20ff583e31905bb31fe0e601e08c16e32f92cd9c6" :answer/id #uuid "da11807c-e743-5c27-8928-2e14f5fa3e26" :answer/type :answer.type/math :answer/value "\\int {e}^{-x}(2x-5)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-2/5c9f7cd806f93a3a1f8482e2b4be7523927a0e5274f20ec56979638b23d8bd50" :answer/id #uuid "f01d3319-75eb-5fca-84cb-9be41c1410fd" :answer/type :answer.type/math :answer/value "\\int {e}^{-x}(2x+5)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-2/93faa807442595cd9b3ad1c563eb8c1e4c6ae4a73f27a2a492a40fc6f07f20e0" :answer/id #uuid "4ae598fd-19c8-5a1f-9259-99ca2d19ee29" :answer/type :answer.type/math :answer/value "\\int {e}^{x}(2x-5)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-2/28691970366a670bb21b3c74ea72c8894dbbbbc8185bcc17a0bb31bb42a0948f" :answer/id #uuid "164457d8-f242-5667-8861-eee54e6415e3" :answer/type :answer.type/math :answer/value "\\int {e}^{-x}(5-2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-2" :answer-field/id #uuid "55e62dcf-aa19-5497-ba40-81f81e3e1296" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-337395/field-2/39074337ed28e6c143210ba20ff583e31905bb31fe0e601e08c16e32f92cd9c6" :answer-field/choices ["q-337395/field-2/39074337ed28e6c143210ba20ff583e31905bb31fe0e601e08c16e32f92cd9c6" "q-337395/field-2/5c9f7cd806f93a3a1f8482e2b4be7523927a0e5274f20ec56979638b23d8bd50" "q-337395/field-2/93faa807442595cd9b3ad1c563eb8c1e4c6ae4a73f27a2a492a40fc6f07f20e0" "q-337395/field-2/28691970366a670bb21b3c74ea72c8894dbbbbc8185bcc17a0bb31bb42a0948f"] :db/ensure [:answer-field/validate]} {:db/id "q-337395/field-3/8e732cc329f7a21b783a9b5f2e4ecdafe614533f3fcec24a1a0b1b8b07e7f6de" :answer/id #uuid "d896c2f3-75cc-50d4-970c-4eaca6a23ecd" :answer/type :answer.type/math :answer/value "{e}^{-x}\\int {e}^{-x}(5-2x)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-3/38e32fe5ded239a97136109e00232b171e3239a6ebe02218452940cf05ee34d9" :answer/id #uuid "40a21d53-dcfe-53dd-a728-83798bf9143e" :answer/type :answer.type/math :answer/value "{e}^{x}\\int {e}^{-x}(2x-5)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-3/c6e6ed44ddcb58c5b75a7f32229d30d20406545ffde31ec1c83097bd5d5f7331" :answer/id #uuid "1356ddff-33f8-5b55-9c44-d409f635827b" :answer/type :answer.type/math :answer/value "{e}^{-x}\\int {e}^{x}(2x-5)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-3/5dbe2692d5da78cea234d52affbc8317a15891f62d69f5b5d28c5f14b4eb1136" :answer/id #uuid "d8e8b798-d22f-50fd-bf1a-88ac5a6048a4" :answer/type :answer.type/math :answer/value "{e}^{x}\\int {e}^{-x}(2x+5)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-337395/field-3" :answer-field/id #uuid "924c0b44-0735-5ca2-86fa-9133546f1d78" :answer-field/key "field-3" :answer-field/type :answer-field.type/select :answer-field/correct "q-337395/field-3/38e32fe5ded239a97136109e00232b171e3239a6ebe02218452940cf05ee34d9" :answer-field/choices ["q-337395/field-3/8e732cc329f7a21b783a9b5f2e4ecdafe614533f3fcec24a1a0b1b8b07e7f6de" "q-337395/field-3/38e32fe5ded239a97136109e00232b171e3239a6ebe02218452940cf05ee34d9" "q-337395/field-3/c6e6ed44ddcb58c5b75a7f32229d30d20406545ffde31ec1c83097bd5d5f7331" "q-337395/field-3/5dbe2692d5da78cea234d52affbc8317a15891f62d69f5b5d28c5f14b4eb1136"] :db/ensure [:answer-field/validate]} {:db/id "q-337395" :question/id #uuid "bc82baf7-6e13-5137-9b62-5ced3f36541b" :question/math-academy-id "q-337395" :question/problem "Consider the first-order linear ODE\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-y=2x-5.\n$$\n\nWe wish to solve this equation using the method of variation of parameters (VOP).\n\nSelect the correct options below.\n\n$\\,$ According to VOP, we assume a particular solution of the form {{field-1}}.\n\n$\\,$ Solving for $u,$ we have $u(x)=$ {{field-2}}.\n\n$\\,$ Therefore, the particular solution is ${y}_{p}(x)=$ {{field-3}}." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nThe method of variation of parameters constructs a particular solution by varying the constant in the homogeneous solution. So, to find a suitable ${y}_{p},$ we set $A=u(x)$ in the complementary solution, as given by the following ansatz:\n\n$$\n{y}_{p}(x)=u(x){e}^{x}\n$$\n\nIntuitively, this form of ${y}_{p}$ tracks the homogeneous solution but with a varying amplitude.\n\nTo find $u,$ we substitute our ansatz into the equation, apply the product rule to the derivative term, and simplify to isolate ${u}^{′}:$\n\n$$\n\\begin{aligned}{(u{e}^{x})}^{′}-(u{e}^{x}) & =2x-5 \\\\ {u}^{′}{e}^{x}+u{e}^{x}-u{e}^{x} & =2x-5 \\\\ {u}^{′}{e}^{x}+\\cancel{u{e}^{x}}-\\cancel{u{e}^{x}} & =2x-5 \\\\ {u}^{′}{e}^{x} & =2x-5 \\\\ {u}^{′} & ={e}^{-x}(2x-5)\\end{aligned}\n$$\n\nIntegrating both sides with respect to $x$ (omitting the arbitrary constant), we have\n\n$$\n\\begin{aligned}{u}^{′} & ={e}^{-x}(2x-5) \\\\ \\int {u}^{′}\\,\\text{d}x & =\\int {e}^{-x}(2x-5)\\,\\text{d}x \\\\ u & =\\int {e}^{-x}(2x-5)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, since ${y}_{p}=u(x){e}^{x},$ we have\n\n$$\n\\begin{aligned}{y}_{p} & =u(x){e}^{x} \\\\  & =\\int {e}^{-x}(2x-5)\\,\\text{d}x\\cdot {e}^{x} \\\\  & ={e}^{x}\\int {e}^{-x}(2x-5)\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-337395/field-1" "q-337395/field-2" "q-337395/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7ac34a18-053d-5eab-8c2c-bd0f15658186"] :knowledge-point/questions ["q-337395"] :db/ensure [:knowledge-point/validate]} {:db/id "q-337533/field-1/4979f4e46ce15e233d9c3d358ad5f4fe6f678dd91b228ee79f31078c2e020125" :answer/id #uuid "630b3248-5005-584a-9b13-09b251396ece" :answer/type :answer.type/math :answer/value "u(x){e}^{8x}" :db/ensure [:answer/validate]} {:db/id "q-337533/field-1/f2d119ff0255695435eec5ab7ebcca19e1e2099822a0df6168ddf38dd3665a22" :answer/id #uuid "f5ca964f-b2ff-57f5-8da3-0c0f0c2fd6c8" :answer/type :answer.type/math :answer/value "u(x){e}^{-4x}" :db/ensure [:answer/validate]} {:db/id "q-337533/field-1/445f108130eddd660efb3f4e744c623ab48e31797df84645d9dabb690099bd49" :answer/id #uuid "e49089fe-9191-56bd-9fd3-d50a5325ad69" :answer/type :answer.type/math :answer/value "u(x){e}^{4x}" :db/ensure [:answer/validate]} {:db/id "q-337533/field-1/80dedcd716cbf4bfcbb881a6b9e04d28115146cffc40f13409d93b7510c747c9" :answer/id #uuid "0429c658-1f53-5839-9694-4745d2e0a383" :answer/type :answer.type/math :answer/value "u(x){e}^{6x}" :db/ensure [:answer/validate]} {:db/id "q-337533/field-1/104b19ddfff8532674993f9f432695275c1081fdb892f9b6b1664b5a8361b9ca" :answer/id #uuid "d7bab9d3-a643-542a-91fd-0e987dea1805" :answer/type :answer.type/math :answer/value "u(x){e}^{-6x}" :db/ensure [:answer/validate]} {:db/id "q-337533/field-1" :answer-field/id #uuid "acdfc81d-1134-588e-b05a-9cfa412ea176" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-337533/field-1/80dedcd716cbf4bfcbb881a6b9e04d28115146cffc40f13409d93b7510c747c9" :answer-field/choices ["q-337533/field-1/4979f4e46ce15e233d9c3d358ad5f4fe6f678dd91b228ee79f31078c2e020125" "q-337533/field-1/f2d119ff0255695435eec5ab7ebcca19e1e2