nd\n\n$$\n\\begin{aligned}⟨{p}_{1}(t),{p}_{1}(t)⟩ & ={p}_{1}(-1){p}_{1}(-1)+{p}_{1}(0){p}_{1}(0)+{p}_{1}(1){p}_{1}(1) \\\\  & =(t)^{2}{|}_{-1}+(t)^{2}{|}_{0}+(t)^{2}{|}_{1} \\\\  & =(-1)^{2}+{0}^{2}+{1}^{2} \\\\  & =2.\\end{aligned}\n$$\n\n  \n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{proj}}_{{p}_{1}(t)}\\,q(t) & =\\frac{2}{2}\\cdot t=t.\\end{aligned}\n$$\n\n  \n\nFinally,  \n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,q(t) & ={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t) \\\\  & =t+0 \\\\  & =t.\\end{aligned}\n$$" 13194139535510 true] [17592186352855 1000 #edb/ref 17592186352856 13194139535510 true] [17592186352855 1000 #edb/ref 17592186352857 13194139535510 true] [17592186352855 1000 #edb/ref 17592186352858 13194139535510 true] [17592186352855 1000 #edb/ref 17592186352859 13194139535510 true] [17592186352855 1000 #edb/ref 17592186352860 13194139535510 true] [17592186352855 1040 #edb/ref 17592186045450 13194139535510 true] [17592186352855 1041 "selection" 13194139535510 true] [17592186352855 1104 #edb/ref 17592186352858 13194139535510 true] [17592186352855 1110 #uuid "c9da03e5-022a-5795-a16e-83c330c668d3" 13194139535510 true] [17592186352856 1034 "{t}^{2}-t" 13194139535510 true] [17592186352856 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352856 1111 #uuid "95ed8383-cd42-5418-9860-9d09884bad32" 13194139535510 true] [17592186352857 1034 "{t}^{2}+t" 13194139535510 true] [17592186352857 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352857 1111 #uuid "fd4ae18a-7244-5381-bb06-c8e7522a00af" 13194139535510 true] [17592186352858 1034 "t" 13194139535510 true] [17592186352858 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352858 1111 #uuid "dc2b862c-8b0a-5f41-ae03-b6e8fc993588" 13194139535510 true] [17592186352859 1034 "{t}^{2}" 13194139535510 true] [17592186352859 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352859 1111 #uuid "8e5bfb0c-7895-5abe-af6a-f610e22ffe36" 13194139535510 true] [1759218635