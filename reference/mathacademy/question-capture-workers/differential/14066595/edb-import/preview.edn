(t-1){|}_{1} \\\\  & =(-3)\\cdot (-1)+1\\cdot 0 \\\\  & =3,\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{2}(t)⟩ & ={p}_{2}(0){p}_{2}(0)+{p}_{2}(1){p}_{2}(1) \\\\  & =(t-1)^{2}{|}_{0}+(t-1)^{2}{|}_{1} \\\\  & =(-1)^{2}+{0}^{2} \\\\  & =1.\\end{aligned}\n$$\n\n  \n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{proj}}_{{p}_{2}(t)}\\,q(t) & =\\frac{3}{1}\\cdot (t-1)=3t-3.\\end{aligned}\n$$\n\n  \n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,q(t) & ={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t) \\\\  & =t+(3t-3) \\\\  & =4t-3.\\end{aligned}\n$$" 13194139535510 true] [17592186352848 1000 #edb/ref 17592186352849 13194139535510 true] [17592186352848 1000 #edb/ref 17592186352850 13194139535510 true] [17592186352848 1000 #edb/ref 17592186352851 13194139535510 true] [17592186352848 1000 #edb/ref 17592186352852 13194139535510 true] [17592186352848 1000 #edb/ref 17592186352853 13194139535510 true] [17592186352848 1040 #edb/ref 17592186045450 13194139535510 true] [17592186352848 1041 "selection" 13194139535510 true] [17592186352848 1104 #edb/ref 17592186352849 13194139535510 true] [17592186352848 1110 #uuid "f2e21f82-f24f-5792-b857-183cfbb32c2b" 13194139535510 true] [17592186352849 1034 "4t-3" 13194139535510 true] [17592186352849 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352849 1111 #uuid "421c358a-2a34-5df1-a3f4-ea24e97b071a" 13194139535510 true] [17592186352850 1034 "8t-6" 13194139535510 true] [17592186352850 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352850 1111 #uuid "57c16c71-d785-55a7-badc-dd726531e6ff" 13194139535510 true] [17592186352851 1034 "-4t+3" 13194139535510 true] [17592186352851 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352851 1111 #uuid "a2a10e03-901e-5e5d-bc2c-d409a4634315" 13194139535510 true] [17592186352852 1034 "2" 13194139535510 true] [17592186352852 1103 #edb/ref 17592186045453 13194139535510 true] [17592186352852 1111 #uuid "b7fb3eea-a71a-5f62-98d2-