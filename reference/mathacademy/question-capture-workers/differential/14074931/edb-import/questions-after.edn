#{[{:db/id #edb/ref 17592186381834 :knowledge-point/_questions [{:knowledge-point/id #uuid "8ebb2332-3e40-5627-bc43-258ca4a80424" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Imaginary Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3461801c-a6fc-502a-aada-47a46b1e5abb" :answer/type {:db/ident :answer.type/math} :answer/value "y=9\\operatorname{sin}⁡9x+\\operatorname{cos}⁡9x" :db/id #edb/ref 17592186381836} {:answer/id #uuid "d5a1bee4-8e74-5567-a724-4c5b712d6017" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\operatorname{sin}⁡9x+\\operatorname{cos}⁡9x" :db/id #edb/ref 17592186381837} {:answer/id #uuid "fa8bf968-74ab-505f-aeb8-f8fa66640eb9" :answer/type {:db/ident :answer.type/math} :answer/value "y=2\\operatorname{sin}⁡9x+\\operatorname{cos}⁡9x" :db/id #edb/ref 17592186381838} {:answer/id #uuid "8ea08fb9-6a13-50a6-8169-a1f5974c0ae4" :answer/type {:db/ident :answer.type/math} :answer/value "y=-2\\operatorname{sin}⁡9x+\\operatorname{cos}⁡9x" :db/id #edb/ref 17592186381839} {:answer/id #uuid "67e15767-19e6-5657-8520-f74c4f5015ba" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{cos}⁡9x" :db/id #edb/ref 17592186381840}] :answer-field/correct {:answer/id #uuid "d5a1bee4-8e74-5567-a724-4c5b712d6017" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\operatorname{sin}⁡9x+\\operatorname{cos}⁡9x" :db/id #edb/ref 17592186381837} :answer-field/id #uuid "267b02e2-9111-5156-8c9e-c0a81bc71524" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381835}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5484a5c3-0023-5cdb-b78a-d2038bca8aa0" :question/math-academy-id "q-130353" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+81y=0\n$$\n\nhas the general solution\n\n$$\ny=A\\operatorname{sin}⁡9x+B\\operatorname{cos}⁡9x,\n$$\n\nsolve the following initial value problem:\n\n$$\n{y}^{″}+81y=0,\\,y(0)=1,\\,{y}^{′}(0)=-9.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions.\n\n- Substituting $y(0)=1$ into the general solution gives\n\n$$\n\\begin{aligned}B & =1.\\end{aligned}\n$$\n\n- To apply the condition ${y}^{′}(0)=-9,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=9A\\operatorname{cos}⁡9x-9B\\operatorname{sin}⁡9x.\n$$\n\nSubstituting ${y}^{′}(0)=-9$ into the above gives\n\n$$\n\\begin{aligned}-9=9A\\,⟹\\,A=-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-\\operatorname{sin}⁡9x+\\operatorname{cos}⁡9x.\n$$"}] [{:db/id #edb/ref 17592186381841 :knowledge-point/_questions [{:knowledge-point/id #uuid "20e5f532-d99f-5406-b006-f34aa9074819" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "489f0643-3c87-583d-94d8-598ec9538128" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186381843} {:answer/id #uuid "00de4583-0c03-5b01-a1ee-c7b3abff754f" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186381844} {:answer/id #uuid "10e5854a-359e-5c22-9803-0c15f17c0cc3" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{e}^{-x}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381845} {:answer/id #uuid "12386fd2-1e92-5737-974b-8e0ecb06e956" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x-\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186381846} {:answer/id #uuid "fb99c50e-69ed-5e37-832d-f5c79f6a79d3" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(2\\operatorname{cos}⁡x-4\\operatorname{sin}⁡x)" :db/id #edb/ref 17592186381847}] :answer-field/correct {:answer/id #uuid "10e5854a-359e-5c22-9803-0c15f17c0cc3" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{e}^{-x}\\operatorname{cos}⁡x" :db/id #edb/ref 17592186381845} :answer-field/id #uuid "f514ec9d-519b-5ff9-9964-f5aaadb817dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381842}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e41e4a4-a4ff-518a-ba3d-1adb97965117" :question/math-academy-id "q-130374" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+2{y}^{′}+2y=0\n$$\n\nhas the general solution\n\n$$\ny={e}^{-x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x),\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+2{y}^{′}+2y=0,\\,y(0)=2,\\,{y}^{′}(0)=-2.\n$$" :question/worked-solution "We find the constants $P$ and $Q$ using the initial conditions. \n\n- Substituting $y(0)=2$ into the general solution gives\n\n$$\nP=2.\n$$\n\n- To apply the condition ${y}^{′}(0)=-2,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-{e}^{-x}(P\\operatorname{cos}⁡x+Q\\operatorname{sin}⁡x)+{e}^{-x}(-P\\operatorname{sin}⁡x+Q\\operatorname{cos}⁡x).\n$$\n\nThen, we substitute ${y}^{′}(0)=-2$ into the above to get\n\n$$\n-P+Q=-2.\n$$\n\nUsing the fact that $P=2$ gives $Q=0.$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y & =2{e}^{-x}\\operatorname{cos}⁡x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186152560 :knowledge-point/_questions [{:knowledge-point/id #uuid "8ebb2332-3e40-5627-bc43-258ca4a80424" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Imaginary Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "814d6f4b-58c7-51c4-a8e0-bebc87fb35ae" :answer/type {:db/ident :answer.type/math} :answer/value "y = 2\\sin 4x + \\cos 4x" :db/id #edb/ref 17592186150271} {:answer/id #uuid "8b81406f-1ab0-5163-8a2d-55de50779f63" :answer/type {:db/ident :answer.type/math} :answer/value "y =-2\\sin 4x + \\cos 4x" :db/id #edb/ref 17592186150272} {:answer/id #uuid "973e9ca0-07ad-5d9c-9799-ca703e81b256" :answer/type {:db/ident :answer.type/math} :answer/value "y = 4\\sin 4x + \\cos 4x" :db/id #edb/ref 17592186150273} {:answer/id #uuid "3d634a7e-5c54-5bc0-ad85-37849a896d3d" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\cos 4x" :db/id #edb/ref 17592186150274} {:answer/id #uuid "5a61b953-7a38-5281-91c1-f11c70ead448" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\sin 4x + \\cos 4x" :db/id #edb/ref 17592186150275}] :answer-field/correct {:answer/id #uuid "5a61b953-7a38-5281-91c1-f11c70ead448" :answer/type {:db/ident :answer.type/math} :answer/value "y =-\\sin 4x + \\cos 4x" :db/id #edb/ref 17592186150275} :answer-field/id #uuid "bac304b7-d195-5f81-a312-dc5938508e78" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186150270}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0006dc55-4e80-5e2f-bc47-1762d506390e" :question/math-academy-id "q-65117" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+16y=0\n$$\n\nhas the general solution\n\n$$\ny=A\\operatorname{sin}⁡4x+B\\operatorname{cos}⁡4x,\n$$\n\nsolve the following initial value problem:\n\n$$\n{y}^{″}+16y=0,\\,y(0)=1,\\,{y}^{′}(0)=-4.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions.\n\n- Substituting $y(0)=1$ into the general solution gives\n\n$$\n\\begin{aligned}B & =1.\\end{aligned}\n$$\n\n- To apply the condition ${y}^{′}(0)=-4,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=4A\\operatorname{cos}⁡4x-4B\\operatorname{sin}⁡4x.\n$$\n\nSubstituting ${y}^{′}(0)=-4$ into the above gives\n\n$$\n\\begin{aligned}-4=4A\\,⟹\\,A=-1.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-\\operatorname{sin}⁡4x+\\operatorname{cos}⁡4x.\n$$"}] [{:db/id #edb/ref 17592186381848 :knowledge-point/_questions [{:knowledge-point/id #uuid "84e87d0d-806d-5587-849e-17d6999dbbd1" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Repeated Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3427423-ce64-5e6e-8a38-831c684e2f35" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{e}^{-x}-4x{e}^{-x}" :db/id #edb/ref 17592186381850} {:answer/id #uuid "8b7f6f36-998e-53bf-b5ba-b9a7938fda69" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{e}^{-x}-8x{e}^{-x}" :db/id #edb/ref 17592186381851} {:answer/id #uuid "1069cf11-3e42-50fe-a737-e26c7caa7f40" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{e}^{-x}+4x{e}^{-x}" :db/id #edb/ref 17592186381852} {:answer/id #uuid "fe3662cf-eb77-50bd-8423-cd52bc16d5b3" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{e}^{-x}+8x{e}^{-x}" :db/id #edb/ref 17592186381853} {:answer/id #uuid "3206ec8d-430e-5233-9401-d04e560c71cc" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{e}^{-x}+6x{e}^{-x}" :db/id #edb/ref 17592186381854}] :answer-field/correct {:answer/id #uuid "fe3662cf-eb77-50bd-8423-cd52bc16d5b3" :answer/type {:db/ident :answer.type/math} :answer/value "y=8{e}^{-x}+8x{e}^{-x}" :db/id #edb/ref 17592186381853} :answer-field/id #uuid "eb9f6266-adb6-510b-96d6-5c2926e352dc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381849}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "08939a7c-c0f3-5976-a888-8e7f9abb04aa" :question/math-academy-id "q-94017" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+2{y}^{′}+y=0\n$$\n\nhas the general solution\n\n$$\ny=A{e}^{-x}+Bx{e}^{-x},\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+2{y}^{′}+y=0,\\,y(0)=8,\\,{y}^{′}(0)=0.\n$$" :question/worked-solution "We find the constants $A$ and $B$ using the initial conditions. \n\n- Substituting $y(0)=8$ into the general solution gives\n\n$$\nA=8.\n$$\n\n- To apply the condition ${y}^{′}(0)=0,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-A{e}^{-x}+B{e}^{-x}-Bx{e}^{-x}.\n$$\n\nSubstituting ${y}^{′}(0)=0$ into the above gives\n\n$$\n-A+B=0.\n$$\n\nUsing the fact that $A=8$ gives $B=8.$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=8{e}^{-x}+8x{e}^{-x}.\n$$"}] [{:db/id #edb/ref 17592186381855 :knowledge-point/_questions [{:knowledge-point/id #uuid "20e5f532-d99f-5406-b006-f34aa9074819" :knowledge-point/title "Solving Second-Order IVPs When the Characteristic Equation Has Complex Roots"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a902351-68a3-54e1-bfcb-27662cb18157" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(-\\operatorname{cos}⁡4x-4\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186381857} {:answer/id #uuid "635acc79-7b3a-5c41-bfee-ebb3a765e305" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(-\\operatorname{cos}⁡4x-\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186381858} {:answer/id #uuid "1e3567c8-a695-5bd1-a541-e371a84c378f" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(-\\operatorname{cos}⁡4x+5\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186381859} {:answer/id #uuid "9a354572-ff97-5fd7-b254-59d7149ca4c0" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(-\\operatorname{cos}⁡4x-3\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186381860} {:answer/id #uuid "9e756dfb-3c00-583f-a870-598dd392b44b" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(-\\operatorname{cos}⁡4x+2\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186381861}] :answer-field/correct {:answer/id #uuid "9a354572-ff97-5fd7-b254-59d7149ca4c0" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{-x}(-\\operatorname{cos}⁡4x-3\\operatorname{sin}⁡4x)" :db/id #edb/ref 17592186381860} :answer-field/id #uuid "ba9b0706-fa5f-58e2-9a10-da0c49fed6e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186381856}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "20b8d32e-a707-5956-8ecb-9412b3c07a1d" :question/math-academy-id "q-94031" :question/problem "Given that the differential equation\n\n$$\n{y}^{″}+2{y}^{′}+17y=0\n$$\n\nhas the general solution\n\n$$\ny={e}^{-x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x),\n$$\n\nsolve the initial value problem\n\n$$\n{y}^{″}+2{y}^{′}+17y=0,\\,y(0)=-1,\\,{y}^{′}(0)=-11.\n$$" :question/worked-solution "We find the constants $P$ and $Q$ using the initial conditions. \n\n- Substituting $y(0)=-1$ into the general solution gives\n\n$$\nP=-1.\n$$\n\n- To apply the condition ${y}^{′}(0)=-11,$ we first differentiate $y$ to get\n\n$$\n{y}^{′}=-{e}^{-x}(P\\operatorname{cos}⁡4x+Q\\operatorname{sin}⁡4x)+{e}^{-x}(-4P\\operatorname{sin}⁡4x+4Q\\operatorname{cos}⁡4x).\n$$\n\nThen, we substitute ${y}^{′}(0)=-11$ into the above to get\n\n$$\n-P+4Q=-11.\n$$\n\nUsing the fact that $P=-1$ gives $Q=-3.$\n\nTherefore, the solution to the initial value problem is\n\n$$\n\\begin{aligned}y & ={e}^{-x}(-\\operatorname{cos}⁡4x-3\\operatorname{sin}⁡4x).\\end{aligned}\n$$"}]}
