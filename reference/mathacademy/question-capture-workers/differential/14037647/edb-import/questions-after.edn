ext{d}x \\\\ \\operatorname{ln}⁡|{y}_{c}| & =-9x+C\\end{aligned}\n$$\n\nNext, we make ${y}_{c}$ the subject by exponentiating both sides:\n\n$$\n\\begin{aligned}|{y}_{c}| & ={e}^{-9x+C} \\\\  & ={e}^{-9x}{e}^{C} \\\\  & =K{e}^{-9x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$ \n\nFinally, we can drop the absolute value by allowing the arbitrary constant to be either positive or negative, i.e., setting $A=\\pm K.$  Therefore, the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-9x},\n$$\n\nwhere $A$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186301266 :knowledge-point/_questions [{:knowledge-point/id #uuid "77ba8502-9ddb-52d0-a885-33190dc04d4f" :knowledge-point/title "Finding the Complementary Solution to a First-Order Inhomogeneous ODE"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bba209e6-6d48-5d9b-9849-d599bcba0162" :answer/type {:db/ident :answer.type/math} :answer/value "A{e}^{16x}" :db/id #edb/ref 17592186301268} {:answer/id #uuid "a336320c-3c6b-5594-aaac-be768d9a90a6" :answer/type {:db/ident :answer.type/math} :answer/value "A{e}^{8x}" :db/id #edb/ref 17592186301269} {:answer/id #uuid "55771132-3496-5aac-92a1-81aef0eba17d" :answer/type {:db/ident :answer.type/math} :answer/value "A\\operatorname{ln}⁡(8x)" :db/id #edb/ref 17592186301270} {:answer/id #uuid "1c3a9c0d-c11d-5c9b-803c-d825e79a7653" :answer/type {:db/ident :answer.type/math} :answer/value "A{e}^{-16x}" :db/id #edb/ref 17592186301271} {:answer/id #uuid "25cf3dde-55a0-53d3-ab9b-9242b4255768" :answer/type {:db/ident :answer.type/math} :answer/value "A{e}^{-8x}" :db/id #edb/ref 17592186301272}] :answer-field/correct {:answer/id #uuid "25cf3dde-55a0-53d3-ab9b-9242b4255768" :answer/type {:db/ident :answer.type/math} :answer/value "A{e}^{-8x}" :db/id #edb/ref 17592186301272} :answer-field/id #uuid "669dee12-8c5e-57aa-9a9a-d0ebc0e335ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301267}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a34f15af-0935-50c9-ba42-ca8012158411" :question/math-academy-id "q-332741" :question/problem "Consider the differential equation\n\n$$\n{y}^{′}+8y=-13.\n$$\n\nFind the complementary solution ${y}_{c}(x)$ to this equation, where $A$ is an arbitrary constant." :question/worked-solution "To find the complementary solution, we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+8{y}_{c}=0.\n$$\n\nNotice that this differential equation is separable since we can write it as\n\n$$\n\\frac{\\text{d}{y}_{c}}{\\text{d}x}=-8{y}_{c}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{{y}_{c}}\\cdot \\frac{\\text{d}{y}_{c}}{\\text{d}x}=-8\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}_{c}}\\,\\frac{\\text{d}{y}_{c}}{\\text{d}x}\\,\\text{d}x & =\\int -8\\,\\text{d}x \\\\ \\int \\frac{1}{{y}_{c}}\\,\\text{d}{y}_{c} & =\\int -8\\,\\text{d}x \\\\ \\operatorname{ln}⁡|{y}_{c}| & =-8x+C\\end{aligned}\n$$\n\nNext, we make ${y}_{c}$ the subject by exponentiating both sides:\n\n$$\n\\begin{aligned}|{y}_{c}| & ={e}^{-8x+C} \\\\  & ={e}^{-8x}{e}^{C} \\\\  & =K{e}^{-8x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}.$ \n\nFinally, we can drop the absolute value by allowing the arbitrary constant to be either positive or negative, i.e., setting $A=\\pm K.$  Therefore, the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-8x},\n$$\n\nwhere $A$ is an arbitrary constant."}] [{:db/id #edb/ref 17592186301273 :knowledge-point/_questions [{:knowledge-point/id #uuid "34158a33-c6b6-55dc-a4a7-2b5c1c753ac6" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351a888f-ff0d-5b36-9dad-1269415b1d0c" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{6x}-2" :db/id #edb/ref 17592186301275}] :answer-field/correct {:answer/id #uuid "351a888f-ff0d-5b36-9dad-1269415b1d0c" :answer/type {:db/ident :answer.type/math} :answer/value "2e^{6x}-2" :db/id #edb/ref 17592186301275} :answer-field/id #uuid "de2350d3-6b2c-559b-a260-10a5fa8d1783" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301274}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "23d16a30-c940-5f1b-8608-970838c99c44" :question/math-academy-id "q-332780" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}-6y=12,\\,y(0)=0\n$$\n\nGiven that the differential equation \n\n$$\n{y}^{′}-6y=12\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{6x},$ solve the initial value problem.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-6{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{6x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a constant. Therefore, we assume that the particular integral is also a constant, i.e.,\n\n$$\n{y}_{p}(x)=\\beta ,\n$$\n\nwhere $\\beta $ is a constant to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=0.\n$$\n\nTo find the value of $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n0-6\\beta =12\n$$\n\nSolving for $\\beta $ gives $\\beta =-2.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-2.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{6x}-2.\n$$\n\nNow, we can find the constant $A$ using the initial conditions.\n\nSubstituting $y(0)=0$ into the general solution gives\n\n$$\n\\begin{aligned}A{e}^{0}-2 & =0 \\\\ A-2 & =0 \\\\ A & =2.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=2\\,{e}^{6x}-2.\n$$"}] [{:db/id #edb/ref 17592186301276 :knowledge-point/_questions [{:knowledge-point/id #uuid "34158a33-c6b6-55dc-a4a7-2b5c1c753ac6" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "22b0f493-effc-55dc-a51b-811605d952c8" :answer/type {:db/ident :answer.type/math} :answer/value "y={e}^{2x}-{x}^{2}-x" :db/id #edb/ref 17592186301278} {:answer/id #uuid "9de78cf2-29fb-5226-8952-92341e1abd22" :answer/type {:db/ident :answer.type/math} :answer/value "y=2{e}^{2x}-{x}^{2}-x-1" :db/id #edb/ref 17592186301279} {:answer/id #uuid "c0c9999c-aa94-5260-8c82-19ce01323e9a" :answer/type {:db/ident :answer.type/math} :answer/value "y=3{e}^{2x}-{x}^{2}-x-2" :db/id #edb/ref 17592186301280} {:answer/id #uuid "4ba5fde5-ba38-5fc8-a780-1dac0a17aed8" :answer/type {:db/ident :answer.type/math} :answer/value "y=3{e}^{2x}-{x}^{2}+x-2" :db/id #edb/ref 17592186301281} {:answer/id #uuid "821a1b94-0ce1-5de6-988e-9c7cc1bbb762" :answer/type {:db/ident :answer.type/math} :answer/value "y=4{e}^{2x}-3{x}^{2}-x-3" :db/id #edb/ref 17592186301282}] :answer-field/correct {:answer/id #uuid "c0c9999c-aa94-5260-8c82-19ce01323e9a" :answer/type {:db/ident :answer.type/math} :answer/value "y=3{e}^{2x}-{x}^{2}-x-2" :db/id #edb/ref 17592186301280} :answer-field/id #uuid "eccc5358-a2cf-5805-a9fe-6c492f645e5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301277}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "17577237-e9e4-56d2-b8e7-b2f014655c05" :question/math-academy-id "q-332988" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}-2y=2{x}^{2}+3,\\,y(0)=1\n$$\n\nGiven that the differential equation\n\n$$\n{y}^{′}-2y=2{x}^{2}+3\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{2x},$ solve the initial value problem." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-2{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{2x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $2.$ Therefore, we assume that the particular integral is also a polynomial of degree $2,$ i.e.,\n\n$$\n{y}_{p}(x)=\\alpha {x}^{2}+\\beta x+\\gamma \n$$\n\nwhere $\\alpha ,$ $\\beta ,$ and $\\gamma $ are constants to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha x+\\beta .\n$$\n\nTo find the values of $\\alpha ,$ $\\beta ,$ and $\\gamma ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(2\\alpha x+\\beta )-2(\\alpha {x}^{2}+\\beta x+\\gamma )=2{x}^{2}+3.\n$$\n\nWe then group the terms on the left-hand side, as follows:\n\n$$\n-2\\alpha {x}^{2}+(2\\alpha -2\\beta )x+(\\beta -2\\gamma )=2{x}^{2}+3.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n{\\begin{aligned}-2\\alpha =2\\,(\\text{equating the coefficients of }{x}^{2}) \\\\ 2\\alpha -2\\beta =0\\,(\\text{equating the coefficients of }x) \\\\ \\beta -2\\gamma =3\\,(\\text{equating the constants})\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-1,$ $\\beta =-1,$ and $\\gamma =-2.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-{x}^{2}-x-2.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{2x}-{x}^{2}-x-2.\n$$\n\nNow, we can find the constant $A$ using the initial condition.\n\nSubstituting $y(0)=1$ into the general solution gives\n\n$$\n\\begin{aligned}A{e}^{2(0)}-(0)^{2}-(0)-2 & =1 \\\\ A-2 & =1 \\\\ A & =3.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=3{e}^{2x}-{x}^{2}-x-2.\n$$"}] [{:db/id #edb/ref 17592186301283 :knowledge-point/_questions [{:knowledge-point/id #uuid "34158a33-c6b6-55dc-a4a7-2b5c1c753ac6" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4f14d54-3b68-5511-8ebc-94d7e7ef9dac" :answer/type {:db/ident :answer.type/math} :answer/value "y=-9{e}^{-2x}-2{x}^{2}-\\frac{7}{2}x+7" :db/id #edb/ref 17592186301285} {:answer/id #uuid "ab98b9dc-9aae-5305-b1fa-80643f1ad078" :answer/type {:db/ident :answer.type/math} :answer/value "y=-4{e}^{-2x}+2{x}^{2}-\\frac{7}{2}x+2" :db/id #edb/ref 17592186301286} {:answer/id #uuid "e7d56cee-26d5-5eb4-9240-95543d131e87" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{19}{4}{e}^{-2x}+2{x}^{2}-\\frac{7}{2}x+\\frac{11}{4}" :db/id #edb/ref 17592186301287} {:answer/id #uuid "a92e6602-1191-5eac-9b37-fe6411e0efa4" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{9}{4}{e}^{-2x}+2{x}^{2}-\\frac{7}{2}x+\\frac{1}{4}" :db/id #edb/ref 17592186301288} {:answer/id #uuid "b1a8d3ed-b266-59a6-b7ec-7c53ccc470a9" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{19}{4}{e}^{-2x}+2{x}^{2}+\\frac{7}{2}x-\\frac{11}{4}" :db/id #edb/ref 17592186301289}] :answer-field/correct {:answer/id #uuid "e7d56cee-26d5-5eb4-9240-95543d131e87" :answer/type {:db/ident :answer.type/math} :answer/value "y=-\\frac{19}{4}{e}^{-2x}+2{x}^{2}-\\frac{7}{2}x+\\frac{11}{4}" :db/id #edb/ref 17592186301287} :answer-field/id #uuid "b584940c-7b63-53ec-9eb0-ef15f5f8f1a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301284}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "19f94b6b-4608-5fc8-9322-fa3e662d1adb" :question/math-academy-id "q-333045" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}+2y=4{x}^{2}-3x+2,\\,y(0)=-2\n$$\n\nGiven that the differential equation\n\n$$\n{y}^{′}+2y=4{x}^{2}-3x+2\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{-2x},$ solve the initial value problem." :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}+2{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{-2x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $2.$ Therefore, we assume that the particular integral is also a polynomial of degree $2,$ i.e.,\n\n$$\n{y}_{p}(x)=\\alpha {x}^{2}+\\beta x+\\gamma \n$$\n\nwhere $\\alpha ,$ $\\beta ,$ and $\\gamma $ are constants to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=2\\alpha x+\\beta .\n$$\n\nTo find the values of $\\alpha ,$ $\\beta ,$ and $\\gamma ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n(2\\alpha x+\\beta )+2(\\alpha {x}^{2}+\\beta x+\\gamma )=4{x}^{2}-3x+2.\n$$\n\nWe then group the terms on the left-hand side, as follows:\n\n$$\n2\\alpha {x}^{2}+(2\\alpha +2\\beta )x+(\\beta +2\\gamma )=4{x}^{2}-3x+2.\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n{\\begin{aligned}2\\alpha =4\\,(\\text{equating the coefficients of }{x}^{2}) \\\\ 2\\alpha +2\\beta =-3\\,(\\text{equating the coefficients of }x) \\\\ \\beta +2\\gamma =2\\,(\\text{equating the constants})\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =2,$ $\\beta =-\\frac{7}{2},$ and $\\gamma =\\frac{11}{4}.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=2{x}^{2}-\\frac{7}{2}x+\\frac{11}{4}.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{-2x}+2{x}^{2}-\\frac{7}{2}x+\\frac{11}{4}.\n$$\n\nNow, we can find the constant $A$ using the initial condition.\n\nSubstituting $y(0)=-2$ into the general solution gives\n\n$$\n\\begin{aligned}A{e}^{-2(0)}+2(0)^{2}-\\frac{7}{2}(0)+\\frac{11}{4} & =-2 \\\\ A+\\frac{11}{4} & =-2 \\\\ A & =-\\frac{19}{4}.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=-\\frac{19}{4}{e}^{-2x}+2{x}^{2}-\\frac{7}{2}x+\\frac{11}{4}.\n$$"}] [{:db/id #edb/ref 17592186301290 :knowledge-point/_questions [{:knowledge-point/id #uuid "34158a33-c6b6-55dc-a4a7-2b5c1c753ac6" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05ef04e4-5980-59f8-b00a-478ee63bb877" :answer/type {:db/ident :answer.type/math} :answer/value "12e^{x}-2x-9" :db/id #edb/ref 17592186301292}] :answer-field/correct {:answer/id #uuid "05ef04e4-5980-59f8-b00a-478ee63bb877" :answer/type {:db/ident :answer.type/math} :answer/value "12e^{x}-2x-9" :db/id #edb/ref 17592186301292} :answer-field/id #uuid "8d87bf10-e58d-506c-960b-9ab113128e61" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301291}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "07a5e239-db71-5a83-b584-0e6f1063a68a" :question/math-academy-id "q-333052" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}-y=2x+7,\\,y(0)=3\n$$\n\nGiven that the differential equation \n\n$$\n{y}^{′}-y=2x+7\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{x},$ solve the initial value problem.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{x}\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a polynomial of degree $1.$ Therefore, we assume that the particular integral is also a polynomial of degree $1,$ i.e.,\n\n$$\n{y}_{p}(x)=\\alpha x+\\beta \n$$\n\nwhere $\\alpha $ and $\\beta $ are constants to be determined. \n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=\\alpha .\n$$\n\nTo find the values of $\\alpha ,$ and $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n\\alpha -(\\alpha x+\\beta )=2x+7\n$$\n\nWe then group the terms on the left-hand side, as follows:\n\n$$\n-\\alpha x+(\\alpha -\\beta )=2x+7\n$$\n\nEquating the coefficients, we get the following system of equations:\n\n$$\n\\begin{aligned}{\\begin{aligned}-\\alpha =2\\, & (\\text{equating the coefficients of}\\,\\,x) \\\\ \\alpha -\\beta =7\\, & (\\text{equating the constants})\\end{aligned}\\end{aligned}\n$$\n\nSolving this system gives $\\alpha =-2,\\,\\beta =-9.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-2x-9.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{x}-2x-9.\n$$\n\nNow, we can find the constant $A$ using the initial conditions.\n\nSubstituting $y(0)=3$ into the general solution gives\n\n$$\n\\begin{aligned}A{e}^{0}-2(0)-9 & =3 \\\\ A-9 & =3 \\\\ A & =12.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=12\\,{e}^{x}-2x-9.\n$$"}] [{:db/id #edb/ref 17592186301293 :knowledge-point/_questions [{:knowledge-point/id #uuid "34158a33-c6b6-55dc-a4a7-2b5c1c753ac6" :knowledge-point/title "Solving an Initial Value Problem"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc5497ea-33d0-5f4b-877d-4acdeac8c443" :answer/type {:db/ident :answer.type/math} :answer/value "7e^{2x}+2" :db/id #edb/ref 17592186301295} {:answer/id #uuid "00adc0be-f7a7-5401-ad04-a5424f105846" :answer/type {:db/ident :answer.type/math} :answer/value "7e^{2x}-2" :db/id #edb/ref 17592186301296}] :answer-field/correct {:answer/id #uuid "00adc0be-f7a7-5401-ad04-a5424f105846" :answer/type {:db/ident :answer.type/math} :answer/value "7e^{2x}-2" :db/id #edb/ref 17592186301296} :answer-field/id #uuid "f5ec826e-d1b6-518c-8292-d0f81ca1b2e9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301294}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "693b99ff-648b-58e8-8cc1-0950d6dd7372" :question/math-academy-id "q-333057" :question/problem "Consider the following initial value problem:\n\n$$\n{y}^{′}-2y=4,\\,y(0)=5\n$$\n\nGiven that the differential equation \n\n$$\n{y}^{′}-2y=4\n$$\n\nhas the complementary solution ${y}_{c}=A{e}^{2x},$ solve the initial value problem.\n\n$y(x)=$\n{{field-1}}" :question/worked-solution "To find the general solution of an inhomogeneous first-order linear equation, we must find the sum of the complementary and particular solutions.\n\nTo find the complementary solution ${y}_{c},$ we solve the corresponding homogeneous equation, given by\n\n$$\n{y}_{c}^{′}-2{y}_{c}=0.\n$$\n\nSolving this equation, we find that the complementary solution is\n\n$$\n{y}_{c}=A{e}^{2x},\n$$\n\nwhere $A$ is an arbitrary constant.\n\nWe now need to find the particular solution ${y}_{p}(x).$\n\nThe right-hand side of the inhomogeneous equation is a constant. Therefore, we assume that the particular integral is also a constant, i.e.,\n\n$$\n{y}_{p}(x)=\\beta ,\n$$\n\nwhere $\\beta $ is a constant to be determined.\n\nCalculating the first derivative of ${y}_{p}$ gives\n\n$$\n\\frac{\\text{d}{y}_{p}}{\\text{d}x}=0.\n$$\n\nTo find the value of $\\beta ,$ we substitute ${y}_{p}$ and ${y}_{p}^{′}$ into the differential equation:\n\n$$\n0-2\\beta =4\n$$\n\nSolving for $\\beta $ gives $\\beta =-2.$\n\nTherefore, the particular solution ${y}_{p}(x)$ is\n\n$$\n{y}_{p}(x)=-2.\n$$\n\nThe general solution is given by\n\n$$\ny(x)={y}_{c}(x)+{y}_{p}(x),\n$$\n\nand therefore, the general solution in our case is\n\n$$\ny=A{e}^{2x}-2.\n$$\n\nNow, we can find the constant $A$ using the initial conditions.\n\nSubstituting $y(0)=5$ into the general solution gives\n\n$$\n\\begin{aligned}A{e}^{0}-2 & =5 \\\\ A-2 & =5 \\\\ A & =7.\\end{aligned}\n$$\n\nTherefore, the solution to the initial value problem is\n\n$$\ny=7{e}^{2x}-2.\n$$"}]}
