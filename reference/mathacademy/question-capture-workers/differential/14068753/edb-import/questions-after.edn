#{[{:db/id #edb/ref 17592186360021 :knowledge-point/_questions [{:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/title "Computing a Differential in a Geometrical Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e61b44d-58e0-516a-a2bc-a2284544cb65" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,\\text{d}a+24\\,\\text{d}b+48\\,\\text{d}c" :db/id #edb/ref 17592186360023} {:answer/id #uuid "20716d3e-0ced-5eab-9d0e-b667eebea912" :answer/type {:db/ident :answer.type/math} :answer/value "36\\,\\text{d}a+9\\,\\text{d}b+64\\,\\text{d}c" :db/id #edb/ref 17592186360024} {:answer/id #uuid "a184a913-10d6-5f55-95ec-dd7f374fb975" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\text{d}a+3\\,\\text{d}b+9\\,\\text{d}c" :db/id #edb/ref 17592186360025} {:answer/id #uuid "5f8972ae-ea1c-5dc7-ad48-4b78db87e0eb" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,\\text{d}a+48\\,\\text{d}b+18\\,\\text{d}c" :db/id #edb/ref 17592186360026} {:answer/id #uuid "1a310886-f1e9-5e21-a04b-93a3a8ae3261" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{d}a+24\\,\\text{d}b+9\\,\\text{d}c" :db/id #edb/ref 17592186360027}] :answer-field/correct {:answer/id #uuid "5f8972ae-ea1c-5dc7-ad48-4b78db87e0eb" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,\\text{d}a+48\\,\\text{d}b+18\\,\\text{d}c" :db/id #edb/ref 17592186360026} :answer-field/id #uuid "4b3230ec-ebf2-5215-bc63-a70b60441691" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360022}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6d876ea7-17d5-5364-9fcb-920fe99b4035" :question/math-academy-id "q-168150" :question/problem "Given a rectangular solid, find the differential $\\text{d}V$ for the volume $V$ of the rectangular solid if the lengths of the sides are $a=6,$ $b=3,$ and $c=8.$" :question/worked-solution "The volume of the rectangular solid is $V=abc.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,b,c) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂b})\\,\\text{d}b+(\\frac{∂V}{∂c})\\,\\text{d}c \\\\  & =bc\\,\\text{d}a+ac\\,\\text{d}b+ab\\,\\text{d}c\\end{aligned}\n$$\n\nFor $a=6,$ $b=3,$ and $c=8,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(6,3,8) & =3\\cdot 8\\,\\text{d}a+6\\cdot 8\\,\\text{d}b+6\\cdot 3\\,\\text{d}c \\\\  & =24\\,\\text{d}a+48\\,\\text{d}b+18\\,\\text{d}c.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360028 :knowledge-point/_questions [{:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/title "Computing a Differential in a Geometrical Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351992d8-41fe-538a-9781-dcf117b50700" :answer/type {:db/ident :answer.type/math} :answer/value "20\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186360030} {:answer/id #uuid "3369d40e-4399-5198-97d8-8cd519b4921c" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186360031} {:answer/id #uuid "93a00ec9-2d86-5eb1-a996-29be91c06c06" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+48\\,\\text{d}h" :db/id #edb/ref 17592186360032} {:answer/id #uuid "ab0c2010-0da2-583a-ada6-a19c9b2c7df3" :answer/type {:db/ident :answer.type/math} :answer/value "17\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186360033} {:answer/id #uuid "93538b5b-50bb-514c-abbb-408c2553ad94" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186360034}] :answer-field/correct {:answer/id #uuid "3369d40e-4399-5198-97d8-8cd519b4921c" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186360031} :answer-field/id #uuid "eefdb437-4504-5696-bcd2-5ec8f24fb252" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360029}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "53687acb-b08d-578e-a441-a512a9af4425" :question/math-academy-id "q-79747" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the base is a square with the side of $a=3$ and the height is $h=7.$" :question/worked-solution "The surface area of the given rectangular solid is $S=2{a}^{2}+4ah.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,h) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂h})\\,\\text{d}h \\\\  & =(4a+4h)\\,\\text{d}a+4a\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=3$ and $h=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(3,7) & =(4\\cdot 3+4\\cdot 7)\\,\\text{d}a+4\\cdot 3\\,\\text{d}h \\\\  & =40\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360035 :knowledge-point/_questions [{:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/title "Using Differentials to Approximate the Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b881e7c-75f2-5aa9-a457-bb8270306d7a" :answer/type {:db/ident :answer.type/math} :answer/value "0.062" :db/id #edb/ref 17592186360037} {:answer/id #uuid "378f1ad7-2d4b-557f-8cf1-cd25f20d7fac" :answer/type {:db/ident :answer.type/math} :answer/value "0.060" :db/id #edb/ref 17592186360038} {:answer/id #uuid "025cf1dc-af33-5287-966c-40487b153082" :answer/type {:db/ident :answer.type/math} :answer/value "0.058" :db/id #edb/ref 17592186360039} {:answer/id #uuid "67626242-3c24-59c2-8ee9-b37a76ad8c47" :answer/type {:db/ident :answer.type/math} :answer/value "0.064" :db/id #edb/ref 17592186360040} {:answer/id #uuid "fc08241b-2384-5c58-9577-f2615e06e031" :answer/type {:db/ident :answer.type/math} :answer/value "0.066" :db/id #edb/ref 17592186360041}] :answer-field/correct {:answer/id #uuid "378f1ad7-2d4b-557f-8cf1-cd25f20d7fac" :answer/type {:db/ident :answer.type/math} :answer/value "0.060" :db/id #edb/ref 17592186360038} :answer-field/id #uuid "2d6e93ef-3eff-5f22-97f9-1edb8510c78b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360036}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7fc83675-a8a8-514c-a823-811d52a7f31e" :question/math-academy-id "q-79836" :question/problem "Estimate $\\operatorname{cos}⁡(1)\\operatorname{sin}⁡(0.12)$ using a differential $\\text{d}f$ of the function $f(x,y)=\\operatorname{cos}⁡x\\operatorname{sin}⁡y$ at the point $(\\frac{\\pi }{3},0).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =-\\operatorname{sin}⁡x\\operatorname{sin}⁡y\\,\\text{d}x+\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(\\frac{\\pi }{3},0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =-\\operatorname{sin}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡0\\,\\text{d}x+\\operatorname{cos}⁡(\\frac{\\pi }{3})\\operatorname{cos}⁡0\\,\\text{d}y \\\\  & =0\\,\\text{d}x+\\frac{1}{2}\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(\\frac{\\pi }{3}+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈0\\,Δx+\\frac{1}{2}\\,Δy\n$$\n\nNote that \n\n$$\n\\operatorname{cos}⁡(1)\\operatorname{sin}⁡(0.12)=f(1,0.12),\n$$\n\nso we want to move to the point $(1,0.12).$\n\nMoving from $(\\frac{\\pi }{3},0)$ to $(1,0.12),$ we have\n\n$$\n\\begin{aligned}Δx & =1-\\frac{\\pi }{3}, \\\\ Δy & =0.12-0=0.12.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈0\\cdot (1-\\frac{\\pi }{3})+\\frac{1}{2}\\cdot (0.12) \\\\  & ≈0+0.5\\cdot 0.12 \\\\  & ≈0.06.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.06.$ Consequently, we have\n\n$$\n\\begin{aligned}f(1,0.12) & ≈f(\\frac{\\pi }{3},0)+0.06 \\\\ \\operatorname{cos}⁡(1)\\operatorname{sin}⁡(0.12) & ≈\\operatorname{cos}⁡(\\frac{\\pi }{3})\\operatorname{sin}⁡(0)+0.06 \\\\  & ≈0+0.06 \\\\  & ≈0.06.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360042 :knowledge-point/_questions [{:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9" :knowledge-point/title "Using Differentials to Approximate the Value of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5e142022-0a13-5572-a090-e4c3e3f9d6c4" :answer/type {:db/ident :answer.type/math} :answer/value "1.30" :db/id #edb/ref 17592186360044} {:answer/id #uuid "e093deb8-af07-57a4-a3c5-9d5cabe67cff" :answer/type {:db/ident :answer.type/math} :answer/value "1.28" :db/id #edb/ref 17592186360045} {:answer/id #uuid "7ee19c44-0e62-5f92-b07d-c2f384f63fc8" :answer/type {:db/ident :answer.type/math} :answer/value "1.22" :db/id #edb/ref 17592186360046} {:answer/id #uuid "61dac524-823b-5e13-b56d-133c28aec53c" :answer/type {:db/ident :answer.type/math} :answer/value "1.24" :db/id #edb/ref 17592186360047} {:answer/id #uuid "2ac479b4-059e-536d-ab39-7951b8182714" :answer/type {:db/ident :answer.type/math} :answer/value "1.26" :db/id #edb/ref 17592186360048}] :answer-field/correct {:answer/id #uuid "61dac524-823b-5e13-b56d-133c28aec53c" :answer/type {:db/ident :answer.type/math} :answer/value "1.24" :db/id #edb/ref 17592186360047} :answer-field/id #uuid "458fa144-24b7-5a14-a379-5e62a18ed85d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360043}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "0fa48839-143d-5a0b-8b2f-09125573ccac" :question/math-academy-id "q-79876" :question/problem "Estimate $(1.06)^{4.1}$ using a differential $\\text{d}f$ of the function $f(x,y)={x}^{y}$ at the point $(1,4).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =y{x}^{y-1}\\,\\text{d}x+{x}^{y}\\operatorname{ln}⁡x\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(1,4),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =4\\cdot {1}^{3}\\,\\text{d}x+{1}^{4}\\operatorname{ln}⁡(1)\\,\\text{d}y \\\\  & =4\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(1+Δx,4+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈4\\,Δx+0\\,Δy.\n$$\n\nNote that \n\n$$\n(1.06)^{4.1}=f(1.06,4.1),\n$$\n\nso we want to move to the point $(1.06,4.1).$\n\nMoving from $(1,4)$ to $(1.06,4.1),$ we have\n\n$$\n\\begin{aligned}Δx & =1.06-1=0.06, \\\\ Δy & =4.1-4=0.1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈4\\cdot (0.06)+0\\cdot (0.1) \\\\  & ≈0.24+0 \\\\  & ≈0.24\\,.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.24.$ Consequently, we have\n\n$$\n\\begin{aligned}f(1.06,4.1) & ≈f(1,4)+0.24 \\\\ (1.06)^{4.1} & ≈{1}^{4}+0.24 \\\\  & ≈1+0.24 \\\\  & ≈1.24\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360049 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649" :knowledge-point/title "Using Differentials to Approximate the Change in a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee984fef-dfa3-5c07-a7ad-eb2e15b08360" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186360051} {:answer/id #uuid "116262b2-e5ad-5d71-b1fb-0ee218f844a6" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186360052} {:answer/id #uuid "a520640a-07a2-5431-bad2-906fbbbed2db" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186360053} {:answer/id #uuid "413db8fc-c1b2-5ae3-8842-885ebb0c236f" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186360054} {:answer/id #uuid "f3f8826f-291c-500b-9535-2a5b7a218e68" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186360055}] :answer-field/correct {:answer/id #uuid "f3f8826f-291c-500b-9535-2a5b7a218e68" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186360055} :answer-field/id #uuid "0ff4a3a4-2864-5eb3-bd8e-28f01e3e2df7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360050}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5cd05d8b-6c57-5623-803a-2f4730ea02a0" :question/math-academy-id "q-86715" :question/problem "If $f(x,y,z)={x}^{2}+4\\operatorname{ln}⁡({z}^{3}-y),$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(2,-3,1)$ to $(1,-2,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =2x\\,\\text{d}x-(\\frac{4}{{z}^{3}-y})\\,\\text{d}y+(\\frac{12{z}^{2}}{{z}^{3}-y})\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(2,-3,1),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,-3,1) & =(2\\cdot 2)\\,\\text{d}x-(\\frac{4}{{1}^{3}-(-3)})\\,\\text{d}y+(\\frac{12\\cdot {1}^{2}}{{1}^{3}-(-3)})\\,\\text{d}z \\\\  & =4\\,\\text{d}x-\\,\\text{d}y+3\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,-3+Δy,1+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈4\\,Δx-\\,Δy+3\\,Δz.\n$$\n\nMoving from $(2,-3,1)$ to $(1,-2,2),$ we have\n\n$$\n\\begin{aligned}Δx & =1-2=-1, \\\\ Δy & =-2-(-3)=1 \\\\ Δz & =2-1=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈4\\,Δx-1\\,Δy+3\\,Δz \\\\  & ≈4\\cdot (-1)-1\\cdot 1+3\\cdot 1 \\\\  & ≈-2.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ decreases by approximately $-2.$"}]}
