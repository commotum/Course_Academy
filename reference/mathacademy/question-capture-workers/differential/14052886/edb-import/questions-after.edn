#{[{:db/id #edb/ref 17592186330256 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a810eff-87d3-5517-b9c4-853087c35e74" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186330258} {:answer/id #uuid "2aab37f4-c1ce-5c35-a1e6-bbf628ed35a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186330259} {:answer/id #uuid "9040d46e-4db2-5122-8530-d9e97777c6c7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186330260} {:answer/id #uuid "e9db10c1-60c5-58be-abf3-51ce64715667" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186330261} {:answer/id #uuid "1c4a2e46-69f5-5cfb-bef4-c9e1b633e1d6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186330262}] :answer-field/correct {:answer/id #uuid "1a810eff-87d3-5517-b9c4-853087c35e74" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186330258} :answer-field/id #uuid "42b24e91-9b04-5f1c-a582-e36a4ce56aea" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330257}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "115b44c6-02ff-530e-996f-805570ccd3cb" :question/math-academy-id "q-115528" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{{x}^{2}}{\\operatorname{ln}⁡2x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to \\infty }{x}^{2}=\\infty $ and ${lim}_{x\\to \\infty }\\operatorname{ln}⁡2x=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{2}}{\\operatorname{ln}⁡2x} & ={lim}_{x\\to \\infty }\\frac{[{x}^{2}]^{′}}{{[\\operatorname{ln}⁡2x]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2x}{(\\frac{1}{x})} \\\\  & =2{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330263 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e9c32464-f609-5091-80ba-b70256ac5e6e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186330265}] :answer-field/correct {:answer/id #uuid "e9c32464-f609-5091-80ba-b70256ac5e6e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186330265} :answer-field/id #uuid "158a9856-3ee6-5860-9f01-ea88bab1c692" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330264}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "808beaf8-4c4f-5366-8636-d03635acae03" :question/math-academy-id "q-336802" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to (\\pi /2)^{-}}\\frac{ln\\,(\\operatorname{sec}⁡x)}{ln\\,(\\operatorname{cot}⁡x)}=$\n{{field-1}}" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to (\\pi /2)^{-}}ln\\,(\\operatorname{sec}⁡x)=\\infty $ and ${lim}_{x\\to (\\pi /2)^{-}}ln\\,(\\operatorname{cot}⁡x)=-\\infty ,$ respectively, so we have the case $\\frac{\\infty }{-\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /2)^{-}}\\frac{ln\\,(\\operatorname{sec}⁡x)}{ln\\,(\\operatorname{cot}⁡x)} & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{{[ln\\,(\\operatorname{sec}⁡x)]}^{′}}{{[ln\\,(\\operatorname{cot}⁡x)]}^{′}} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{(\\frac{\\operatorname{sec}⁡x\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x})}{(-\\frac{{csc}^{2}⁡x}{\\operatorname{cot}⁡x})} \\\\  & =-{lim}_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\operatorname{cot}⁡x}{{csc}^{2}⁡x} \\\\  & =-{lim}_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{tan}⁡x\\cdot \\frac{1}{\\operatorname{tan}⁡x}}{\\frac{1}{{sin}^{2}⁡x}} \\\\  & =-{lim}_{x\\to (\\pi /2)^{-}}{sin}^{2}⁡x \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259772 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ee0f398f-597a-5b09-b835-c7b222771d92" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259774} {:answer/id #uuid "47ea25ec-db6b-58be-a50e-d5eac4a24611" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186330266}] :answer-field/correct {:answer/id #uuid "ee0f398f-597a-5b09-b835-c7b222771d92" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186259774} :answer-field/id #uuid "65b65e21-4124-599c-8ef5-38bd7add3afa" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259773}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "e257b16a-a775-5397-9d95-12edd8b09eb7" :question/math-academy-id "q-336903" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to -4}\\frac{(x+4)^{3}}{3\\sqrt[3]{x+5}-x-7}=$\n{{field-1}}" :question/worked-solution "If we plug in $x=-4$ we get the indeterminate form $\\frac{0}{0},$ so we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{(x+4)^{3}}{3\\sqrt[3]{x+5}-x-7} & ={lim}_{x\\to -4}\\frac{{[(x+4)^{3}]}^{′}}{{[3(x+5)^{1/3}-x-7]}^{′}} \\\\  & ={lim}_{x\\to -4}\\frac{3(x+4)^{2}}{(x+5)^{-2/3}-1}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3(x+4)^{2}}{(x+5)^{-2/3}-1} & ={lim}_{x\\to -4}\\frac{{[3(x+4)^{2}]}^{′}}{{[(x+5)^{-2/3}-1]}^{′}} \\\\  & ={lim}_{x\\to -4}\\frac{6(x+4)}{-\\frac{2}{3}(x+5)^{-5/3}} \\\\  & =-9{lim}_{x\\to -4}(x+4)(x+5)^{5/3} \\\\  & =-9(-4+4)\\,(-4+5)^{5/3} \\\\  & =-9\\cdot 0\\cdot 1 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259775 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "441ce2f1-8463-59ab-9df1-c1090a81dfa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln5}2" :db/id #edb/ref 17592186259777}] :answer-field/correct {:answer/id #uuid "441ce2f1-8463-59ab-9df1-c1090a81dfa3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\ln5}2" :db/id #edb/ref 17592186259777} :answer-field/id #uuid "68586d47-416c-5b02-a214-0b04cc3eb25e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186259776}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "807afca8-b2c0-59ad-99e9-bb1c9df82ff6" :question/math-academy-id "q-336927" :question/problem "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}⁡5)x}{{x}^{2}\\operatorname{ln}⁡5}=$\n{{field-1}}" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}⁡5)x}{{x}^{2}\\operatorname{ln}⁡5} & ={lim}_{x\\to 0}\\frac{{[{5}^{x}-1-(\\operatorname{ln}⁡5)x]}^{′}}{[{x}^{2}\\operatorname{ln}⁡5]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(\\operatorname{ln}⁡5)\\cdot {5}^{x}-(\\operatorname{ln}⁡5)}{2\\operatorname{ln}⁡5\\cdot x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}⁡5)x}{{x}^{2}\\text{ }\\operatorname{ln}⁡5} & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{[{5}^{x}-1]}^{′}}{[x]^{′}} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{(\\operatorname{ln}⁡5){5}^{x}}{1} \\\\  & =\\frac{1}{2}\\,(\\operatorname{ln}⁡5){e}^{0} \\\\  & =\\frac{\\operatorname{ln}⁡5}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330267 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c220d1c-79d6-51a4-b009-fe03d8203405" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186330269} {:answer/id #uuid "3379e6f4-8199-50d8-a328-c7966876e0a8" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186330270} {:answer/id #uuid "6111c118-6920-59ce-a0ab-c2993cd08f8c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186330271} {:answer/id #uuid "5d89cdfc-e933-568e-86d3-20ec41201bab" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186330272} {:answer/id #uuid "46812fa3-8345-54b8-9807-4afc3dc7ded6" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186330273}] :answer-field/correct {:answer/id #uuid "5c220d1c-79d6-51a4-b009-fe03d8203405" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186330269} :answer-field/id #uuid "f56f2eb0-ca9e-511d-9465-e723a3c28a2c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330268}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c5e0e8c7-827a-5bff-88ab-7a081b38a994" :question/math-academy-id "q-3781" :question/problem "${lim}_{x\\to \\infty }\\frac{2{x}^{3}-6}{{x}^{2}-4}=$" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying  L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2{x}^{3}-6}{{x}^{2}-4} & ={lim}_{x\\to \\infty }\\frac{[2{x}^{3}-6]^{′}}{[{x}^{2}-4]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{6{x}^{2}}{2x} \\\\  & ={lim}_{x\\to \\infty }3x \\\\  & =\\infty .\\end{aligned}\n$$"}]}
