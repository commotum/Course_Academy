]}^{′}} \\\\  & ={lim}_{x\\to -4}\\frac{6(x+4)}{-\\frac{2}{3}(x+5)^{-5/3}} \\\\  & =-9{lim}_{x\\to -4}(x+4)(x+5)^{5/3} \\\\  & =-9(-4+4)\\,(-4+5)^{5/3} \\\\  & =-9\\cdot 0\\cdot 1 \\\\  & =0.\\end{aligned}\n$$" 13194139535083 true] [17592186259773 1000 #edb/ref 17592186330266 13194139535083 true] [17592186259775 1100 "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\operatorname{ln}5}=$\n{{field-1}}" 13194139535083 false] [17592186259775 1100 "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}⁡5)x}{{x}^{2}\\operatorname{ln}⁡5}=$\n{{field-1}}" 13194139535083 true] [17592186259775 1145 "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\operatorname{ln}5} & ={lim}_{x\\to 0}\\frac{{[{5}^{x}-1-(\\operatorname{ln}5)x]}^{'}}{[{x}^{2}\\operatorname{ln}5]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{(\\operatorname{ln}5)\\cdot {5}^{x}-(\\operatorname{ln}5)}{2\\operatorname{ln}5\\cdot x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}5)x}{{x}^{2}\\text{ }\\operatorname{ln}5} & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{[{5}^{x}-1]}^{'}}{[x]^{'}} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{(\\operatorname{ln}5){5}^{x}}{1} \\\\  & =\\frac{1}{2}\\,(\\operatorname{ln}5){e}^{0} \\\\  & =\\frac{\\operatorname{ln}5}{2}.\\end{aligned}\n$$" 13194139535083 false] [17592186259775 1145 "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}⁡5)x}{{x}^{2}\\operatorname{ln}⁡5} & ={lim}_{x\\to 0}\\frac{{[{5}^{x}-1-(\\operatorname{ln}⁡5)x]}^{′}}{[{x}^{2}\\operatorname{ln}⁡5]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(\\operatorname{ln}⁡5)\\cdot {5}^{x}-(\\operatorname{ln}⁡5)}{2\\operatorname{ln}⁡5\\cdot x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{5}^{x}-1-(\\operatorname{ln}⁡5)x}{{x}^{2}\\text{ }\\operatorname{ln}⁡5} & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{5}^{x}-1}{x} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{{[{5}^{x}-1]}^{′}}{[x]^{′}} \\\\  & =\\frac{1}{2}{lim}_{x\\to 0}\\frac{(\\operatorname{ln}⁡5){5}^{x}}{1} \\\\  & =\\frac{1}{2}\\,(\\operatorname{ln}⁡5){e}^{0} \\\\  & =\\frac{\\operatorname{ln}⁡5}{2}.\\end{aligned}\n$$" 13194139535083 true] [17592186330256 1017 #edb/ref 17592186330257 13194139535083 true] [17592186330256 1089 "q-115528" 13194139535083 true] [17592186330256 1091 #edb/ref 17592186045463 13194139535083 true] [17592186330256 1100 "Evaluate ${lim}_{x\\to \\infty }\\frac{{x}^{2}}{\\operatorname{ln}⁡2x}.$" 13194139535083 true] [17592186330256 1113 #uuid "115b44c6-02ff-530e-996f-805570ccd3cb" 13194139535083 true] [17592186330256 1145 "Here the limits of the numerator and denominator are ${lim}_{x\\to \\infty }{x}^{2}=\\infty $ and ${lim}_{x\\to \\infty }\\operatorname{ln}⁡2x=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{2}}{\\operatorname{ln}⁡2x} & ={lim}_{x\\to \\infty }\\frac{[{x}^{2}]^{′}}{{[\\operatorname{ln}⁡2x]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2x}{(\\frac{1}{x})} \\\\  & =2{lim}_{x\\to \\infty }{x}^{2} \\\\  & =\\infty .\\end{aligned}\n$$" 13194139535083 true] [17592186330257 1000 #edb/ref 17592186330258 13194139535083 true