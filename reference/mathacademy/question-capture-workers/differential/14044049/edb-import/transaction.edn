election/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "1fb695a8-8d9a-5a05-a0bd-2526893f9ae3" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-90580/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "fffa18b7-4eeb-5869-95ec-efe1e68446fa" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-90580/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "b0fc8cdc-8955-50a3-bfdb-ac4f1c238b8b" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-90580/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "ac9fdb9c-fd23-518a-a6ea-aa68bfdae880" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-90580/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "5462d0d5-f197-58c6-ad6f-c03cfe8d6f48" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-90580/selection" :answer-field/id #uuid "71826cb2-d3fc-5862-a2c1-10bd50eba439" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-90580/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-90580/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" "q-90580/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-90580/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-90580/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-90580/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23"] :db/ensure [:answer-field/validate]} {:db/id "q-90580" :question/id #uuid "056f268e-6f23-5cca-ba50-28679fda2fed" :question/math-academy-id "q-90580" :question/problem "Which of the following polynomials are homogeneous?\n\n- $f(x)=7{x}^{7}$\n- $g(x,y)=x+y$\n- $h(x,y,z)={x}^{2}z-2xyz+x{z}^{2}$" :question/worked-solution "Let's go through each of the options.\n\n- The function $f(x)$ is homogeneous of degree $7.$  It is a polynomial of degree $7,$ with no terms of degree other than $7.$\n\n- The function $g(x,y)$ is homogeneous of degree $1.$ It is a polynomial of degree $1,$ and all of its terms are of degree $1.$\n\n- The function $h(x,y,z)$ is  homogeneous of degree $3.$ It is a polynomial of degree $3,$ and all of its terms are of degree $3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-90580/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fc7eacaa-2cf2-5cae-a40c-737c98124bcf"] :knowledge-point/questions ["q-90580"] :db/ensure [:knowledge-point/validate]} {:db/id "q-90582/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "1828dd33-b40a-5c88-a28b-fa036e1855b3" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-90582/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "cb33fa20-a90e-5e8d-a85b-c3373dabae8f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-90582/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "8581da7a-a4b3-5ebd-9040-6415f148e75e" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-90582/selection/93198c2e65472148f49c73a47d70892e6efd0b46acbb489ee2afeea42a4a8c25" :answer/id #uuid "2d9167b0-29e3-5817-87c8-fce4fdfa391d" :answer/type :answer.type/text :answer/value "None" :db/ensure [:answer/validate]} {:db/id "q-90582/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid 