#{[{:db/id #edb/ref 17592186088081 :knowledge-point/_questions [{:knowledge-point/id #uuid "739a8f10-413a-5a1d-a47e-4afd0b14eb44" :knowledge-point/title "Identifying Homogeneous and Inhomogeneous ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94a38643-71ab-5649-8a0d-1f0a0bdbcd23" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186085392} {:answer/id #uuid "ac4f2660-fc99-5fe8-8355-d646203fcae5" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186085393} {:answer/id #uuid "dfd15e50-101e-5283-bb7f-b784ef932453" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186085394} {:answer/id #uuid "faaf7af8-3a08-5003-a54e-672d648e3ad1" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186085395} {:answer/id #uuid "57051897-2625-5762-994d-3740964f0109" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186085396}] :answer-field/correct {:answer/id #uuid "94a38643-71ab-5649-8a0d-1f0a0bdbcd23" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186085392} :answer-field/id #uuid "a6cc48f7-56e8-524f-9fd4-9b41ff89a516" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186085391}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d7723c02-822f-5a83-b3af-429d938426d6" :question/math-academy-id "q-331744" :question/problem "Which of the following first-order linear differential equations are inhomogeneous?\n\n1. $y^{\\prime } - xy = 0$\n2. $y^{\\prime } - xy = y$\n3. $y^{\\prime } - xy = x^{3}$" :question/requires-calculator false :question/worked-solution "An equation is inhomogeneous when its forcing function is not identically zero after collecting all $y$ terms on the left. Equation I has zero forcing. Equation II becomes $y^{\\prime}-(x+1)y=0$ and also has zero forcing. Equation III has forcing $x^3$, which is not identically zero. Therefore only III is inhomogeneous."}] [{:db/id #edb/ref 17592186088363 :knowledge-point/_questions [{:knowledge-point/id #uuid "bc50a680-dbf8-5d45-a8c3-72c3c15243f6" :knowledge-point/title "Identifying First-Order Linear ODEs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8787ecbb-bcde-5e1b-a5ed-9d23815522e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + y = x" :db/id #edb/ref 17592186087109} {:answer/id #uuid "b54535fc-a8dc-5ada-b428-b490dbf1a18b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + y = xy" :db/id #edb/ref 17592186087110} {:answer/id #uuid "c792fe58-82f5-5954-93e9-3119bea36ec1" :answer/type {:db/ident :answer.type/math} :answer/value "y\\frac{dy}{dx} + x = y" :db/id #edb/ref 17592186087111} {:answer/id #uuid "6b67e556-e64d-523c-9321-f7fb1846ebc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + x = y" :db/id #edb/ref 17592186087112} {:answer/id #uuid "6b9de150-76e4-5439-86c8-31f5b6d852a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{dy}{dx} + y = \\cos e^{\\arctan (x^{2} + \\ln x)}" :db/id #edb/ref 17592186087113}] :answer-field/correct {:answer/id #uuid "c792fe58-82f5-5954-93e9-3119bea36ec1" :answer/type {:db/ident :answer.type/math} :answer/value "y\\frac{dy}{dx} + x = y" :db/id #edb/ref 17592186087111} :answer-field/id #uuid "7759e328-b997-576f-b938-3880d1aeb387" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087108}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ecc44493-c978-58e2-96eb-083d048c8f5e" :question/math-academy-id "q-8352" :question/problem "Which of the following is **NOT** a first-order linear ordinary differential equation?" :question/requires-calculator false :question/worked-solution "The equation $yy^{\\prime}+x=y$ has a derivative coefficient depending on the unknown $y$. Dividing by $y$, where possible, gives $y^{\\prime}=1-x/y$, which is nonlinear in $y$. The remaining choices can all be rearranged into $y^{\\prime}+P(x)y=Q(x)$; a complicated function of $x$ alone is allowed."}]}
