0}\\frac{{[4\\sqrt{x+4}-x-8]}^{′}}{[{x}^{2}]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{′}}{[2x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068434/state.json" "file_sha256" "eba99a830e7033b322eceba6d91f900c953b715de77ce127a84e5a961e57bae8"} {"question" "q-31272" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068434/activity-metadata.json" "file_sha256" "543a47ee29201caea3d4fe4078ab9f2433b6e634fd1408c35864fe779760c0f4"} {"question" "q-31272" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068434/state.json" "file_sha256" "eba99a830e7033b322eceba6d91f900c953b715de77ce127a84e5a961e57bae8"} {"question" "q-31272" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\frac{1}{16}"] ["math" "-\\frac{1}{4}"] ["math" "4"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068434/state.json" "file_sha256" "eba99a830e7033b322eceba6d91f900c953b715de77ce