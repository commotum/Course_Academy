f2bceb2f4854d" :answer-field/choices ["q-31272/selection/ma-v1/a3e0fb565694da43a93e27976464801a2a6fe3db490245b78790918f0d6ed638/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" "q-31272/selection/ma-v1/a3e0fb565694da43a93e27976464801a2a6fe3db490245b78790918f0d6ed638/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-31272/selection/ma-v1/a3e0fb565694da43a93e27976464801a2a6fe3db490245b78790918f0d6ed638/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-31272/selection/ma-v1/a3e0fb565694da43a93e27976464801a2a6fe3db490245b78790918f0d6ed638/df78ed3595aa493f54f4470c09f00753d8a5b28fabf1c1c57abf2bceb2f4854d" "q-31272/selection/ma-v1/a3e0fb565694da43a93e27976464801a2a6fe3db490245b78790918f0d6ed638/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-31272"] :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[4\\sqrt{x+4}-x-8]}^{′}}{[{x}^{2}]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{′}}{[2x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$" :question/answer-fields ["q-31272/selection/ma-v1/a3e0fb565694da43a93e27976464801a2a6fe3db490245b78790918f0d6ed638"] :db/ensure [:question/validate]} {:db/id "q-115516/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" :answer/id #uuid "2236bbc8-f10b-5169-a40e-6af08ce7e710" :answer/type :answer.type/math :answer/value "\\infty " :db/ensure [:answer/validate]} {:db/id "q-115516/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "dabf1c0b-dfff-572a-90a3-a8b5dd1e187e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-115516/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" :answer/id #uuid "f1e5bec9-8925-510b-9196-c748bacca1dc" :answer/type :answer.type/math :answer/value "-\\infty " :db/ensure [:answer/validate]} {:db/id "q-115516/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "61d040c5-de24-594c-83cc-abea1ceeee2b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-115516/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "2d9053de-0ca5-52f2-b904-3dcea6632fbe" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-115516/selection" :answer-field/id #uuid "40f8f6ec-e089-5dc6-9ad5-f319a4be13f8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115516/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-115516/selection/64ee21896e4acdba2b7ccd5d21e7c3b0caad319fb011e671d6ce72f671b3bb6c" "q-115516/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-115516/selection/7bc54ef2cebd9c4cf6fef3072c83d13d0dfd6652d02cb9919fbcbc5497b7a408" "q-115516/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-115516/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-115516" :question/id #uuid "3bec609f-956f-5b26-89c0-bf155d1eac55" :question/math-academy-id "q-115516" :question/problem "Evaluate ${lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡4x}{x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to \\infty }\\operatorname{ln}⁡4x=\\infty $ and ${lim}_{x\\to \\infty }x=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{\\operatorname{ln}⁡4x}{x} & ={lim}_{x\\to \\infty }\\frac{[\\operatorname{ln}⁡4x]^{′}}{{[x]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{1}{x})}{1} \\\\  & ={lim}_{x\\to \\infty }\\frac{1}{x} \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115516/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4"] :knowledge-point/questions ["q-115516"] :db/ensure [:knowledge-point/validate]}]
