#{[{:db/id #edb/ref 17592186259427 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd110029-792d-5d2f-a199-753a181780fe" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186271759} {:answer/id #uuid "10e1ab92-a9b0-5046-8b1a-c9cf3b955975" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271760} {:answer/id #uuid "81fa32dd-aef8-552c-8554-6db6c9ccb6dd" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186271761} {:answer/id #uuid "e9d66cac-f039-57b6-8fd4-6d94e5185041" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271762} {:answer/id #uuid "98a448f9-884c-5037-9ec5-cf92b3737e2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186271763}] :answer-field/correct {:answer/id #uuid "98a448f9-884c-5037-9ec5-cf92b3737e2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186271763} :answer-field/id #uuid "5d33e61f-76a6-5193-aace-cae7e7fccfcd" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274631}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5f6b45e4-aad3-52ce-a5c4-dc96f14dd157" :question/math-academy-id "q-31272" :question/problem "${lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}}=$" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[4\\sqrt{x+4}-x-8]}^{'}}{[{x}^{2}]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{'}}{[2x]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$"}]}
