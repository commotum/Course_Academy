#{[{:db/id #edb/ref 17592186264170 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2588752-2571-5af5-8f1c-40164f54d92f" :answer/type {:db/ident :answer.type/math} :answer/value "-{\\pi }^{2}" :db/id #edb/ref 17592186264172} {:answer/id #uuid "f4eea8a1-99b2-5df2-8aa9-4b7be41bed25" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{\\pi }{2}" :db/id #edb/ref 17592186264173} {:answer/id #uuid "e6ea63fd-2ec6-533e-bc77-e0ee6d142100" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186264174} {:answer/id #uuid "44381b3f-6776-56a0-9b39-7caf8acc8342" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{2}}{2}" :db/id #edb/ref 17592186264175} {:answer/id #uuid "bb598ad9-346b-57fd-86bc-464fad453a4b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186264176}] :answer-field/correct {:answer/id #uuid "bb598ad9-346b-57fd-86bc-464fad453a4b" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186264176} :answer-field/id #uuid "dbf03e82-4adc-5a2b-a301-257c99585aae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186264171}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0910a0b7-374a-578c-b2a2-b95c0ef0d221" :question/math-academy-id "q-114250" :question/problem "${lim}_{x\\to 1}\\frac{2+2\\operatorname{cos}⁡(\\pi x)}{{x}^{2}-2x+1}=$" :question/worked-solution "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{2+2\\operatorname{cos}⁡(\\pi x)}{{x}^{2}-2x+1} & ={lim}_{x\\to 1}\\frac{[2+2\\operatorname{cos}⁡(\\pi x)]^{′}}{[{x}^{2}-2x+1]^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{-2\\pi \\operatorname{sin}⁡(\\pi x)}{2x-2} \\\\  & =-{lim}_{x\\to 1}\\frac{\\pi \\operatorname{sin}⁡(\\pi x)}{x-1}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{2+2\\operatorname{cos}⁡(\\pi x)}{{x}^{2}-2x+1} & =-{lim}_{x\\to 1}\\frac{\\pi \\operatorname{sin}⁡(\\pi x)}{x-1} \\\\  & =-{lim}_{x\\to 1}\\frac{[\\pi \\operatorname{sin}⁡(\\pi x)]^{′}}{[x-1]^{′}} \\\\  & =-{lim}_{x\\to 1}\\frac{{\\pi }^{2}\\operatorname{cos}⁡(\\pi x)}{1} \\\\  & =-{\\pi }^{2}\\operatorname{cos}⁡\\pi  \\\\  & ={\\pi }^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286516 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8273d28e-d6e0-542d-abe1-b54108227c99" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186286518} {:answer/id #uuid "1c28b18e-9f73-570b-91a6-73a51c4959f6" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty " :db/id #edb/ref 17592186286519} {:answer/id #uuid "0de15992-a87b-5674-a76d-a925e74a34d4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186286520} {:answer/id #uuid "da392022-7578-5451-8fcf-8e22e22ece1c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286521} {:answer/id #uuid "ac6426f0-c7f5-5cc8-af80-c57930601b16" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186286522}] :answer-field/correct {:answer/id #uuid "da392022-7578-5451-8fcf-8e22e22ece1c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286521} :answer-field/id #uuid "d0bd86ba-9e20-566e-a0c1-144cc917e44f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286517}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e900ba34-3cb6-52c9-99d1-156d048c4788" :question/math-academy-id "q-115526" :question/problem "Evaluate ${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{cot}⁡x}.$" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(\\operatorname{sin}⁡x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{cot}⁡x=\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(\\operatorname{sin}⁡x)}{\\operatorname{cot}⁡x} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\operatorname{ln}⁡(\\operatorname{sin}⁡x)]}^{′}}{[\\operatorname{cot}⁡x]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x})}{-{csc}^{2}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{(\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x})}{(\\frac{1}{{sin}^{2}⁡x})} \\\\  & =-{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{cos}⁡x{sin}^{2}⁡x}{\\operatorname{sin}⁡x} \\\\  & =-{lim}_{x\\to {0}^{+}}\\operatorname{cos}⁡x\\operatorname{sin}⁡x \\\\  & =-\\operatorname{cos}⁡0\\operatorname{sin}⁡0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186259427 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd110029-792d-5d2f-a199-753a181780fe" :answer/type {:db/ident :answer.type/math} :answer/value "− 1" :db/id #edb/ref 17592186271759} {:answer/id #uuid "10e1ab92-a9b0-5046-8b1a-c9cf3b955975" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186271760} {:answer/id #uuid "81fa32dd-aef8-552c-8554-6db6c9ccb6dd" :answer/type {:db/ident :answer.type/math} :answer/value "− (1)/(2)" :db/id #edb/ref 17592186271761} {:answer/id #uuid "e9d66cac-f039-57b6-8fd4-6d94e5185041" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186271762} {:answer/id #uuid "98a448f9-884c-5037-9ec5-cf92b3737e2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186271763}] :answer-field/correct {:answer/id #uuid "98a448f9-884c-5037-9ec5-cf92b3737e2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186271763} :answer-field/id #uuid "5d33e61f-76a6-5193-aace-cae7e7fccfcd" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274631}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5f6b45e4-aad3-52ce-a5c4-dc96f14dd157" :question/math-academy-id "q-31272" :question/problem "${lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}}=$" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[4\\sqrt{x+4}-x-8]}^{'}}{[{x}^{2}]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{'}}{[2x]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186264222 :knowledge-point/_questions [{:knowledge-point/id #uuid "9f29435f-b112-5999-b0ca-9003d9e622e1" :knowledge-point/title "Calculating an Indeterminate Limit of the Form Infinity Divided by Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f84c8628-5fbb-5d13-b29a-d6c444b39cf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186264224}] :answer-field/correct {:answer/id #uuid "f84c8628-5fbb-5d13-b29a-d6c444b39cf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186264224} :answer-field/id #uuid "8636f221-317b-5f04-b70a-35d71fb0e0c0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264223}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8411c106-d2f4-578b-8564-df4ec0ed1b0a" :question/math-academy-id "q-336758" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡({x}^{3})}=$\n{{field-1}}" :question/worked-solution "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡(5x)=-\\infty $ and ${lim}_{x\\to {0}^{+}}\\operatorname{ln}⁡({x}^{3})=-\\infty ,$ respectively, so we have the case $\\frac{-\\infty }{-\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{\\operatorname{ln}⁡(5x)}{\\operatorname{ln}⁡({x}^{3})} & ={lim}_{x\\to {0}^{+}}\\frac{[\\operatorname{ln}⁡(5x)]^{′}}{[\\operatorname{ln}⁡({x}^{3})]^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(\\frac{1}{x})}{(\\frac{3}{x})} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{{x}^{-1}}{3{x}^{-1}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{1}{3} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"}]}
