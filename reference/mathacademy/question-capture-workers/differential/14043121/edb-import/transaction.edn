2a38b0379cc32b8ce6958e3f3df7beeff8646357" :answer/id #uuid "b62b56ee-136a-56d9-9cbb-9b14378ef6d5" :answer/type :answer.type/math :answer/value "6{e}^{2x}+C{e}^{3x}" :db/ensure [:answer/validate]} {:db/id "q-335402/field-2/93132c1fc2fa67c55368fd96636f71bce70b7263cf14b5dfdffec09a7e00e894" :answer/id #uuid "e8e4d9f6-eb82-5a10-9f7a-fb31e13a35e5" :answer/type :answer.type/math :answer/value "6{e}^{-2x}+C{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-335402/field-2" :answer-field/id #uuid "d577595a-12bd-50fb-96b0-7e6791e9d0d3" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-335402/field-2/9556a80e30ca022328ff554d380c969dcb543bb15e00d6eb2eb2bc32493c815a" :answer-field/choices ["q-335402/field-2/37d49ae80200d054bc17297f84a4b05d24482a73d25e4e5869cafdc4e3b577c3" "q-335402/field-2/9556a80e30ca022328ff554d380c969dcb543bb15e00d6eb2eb2bc32493c815a" "q-335402/field-2/90b246bf46870fda0b6e54d02a38b0379cc32b8ce6958e3f3df7beeff8646357" "q-335402/field-2/93132c1fc2fa67c55368fd96636f71bce70b7263cf14b5dfdffec09a7e00e894"] :db/ensure [:answer-field/validate]} {:db/id "q-335402" :question/id #uuid "6530e5db-b521-5f5c-99f7-59872d852e59" :question/math-academy-id "q-335402" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3y=6{e}^{2x}.\n$$\n\nSelect the correct options below.$\\,$ An integrating factor for this equation is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is given by $y(x)=$ {{field-2}}." :question/worked-solution "This equation is already in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\n$$\n\nwith $P(x)=-3$ and $Q(x)=6{e}^{2x}.$ We proceed to find an integrating factor $I(x)$ using the definition:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int -3\\,\\text{d}x} \\\\  & ={e}^{-3x}\\end{aligned}\n$$\n\nNow, we multiply our differential equation through by $I(x)={e}^{-3x}$ as follows:\n\n$$\n\\begin{aligned}{e}^{-3x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}-3y) & ={e}^{-3x}\\cdot 6{e}^{2x} \\\\ {e}^{-3x}\\cdot \\frac{\\text{d}y}{\\text{d}x}-3{e}^{-3x}\\cdot y & =6{e}^{-x}\\end{aligned}\n$$\n\nFinally, we rewrite the left hand side as $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x))$ and carry out the integration:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y{e}^{-3x}) & =6{e}^{-x} \\\\ \\int \\frac{\\text{d}}{\\text{d}x}(y{e}^{-3x})\\text{d}x & =\\int 6{e}^{-x}\\,\\text{d}x \\\\ y{e}^{-3x} & =-6{e}^{-x}+C \\\\ y & =-6{e}^{2x}+C{e}^{3x}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-335402/field-1" "q-335402/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6bbeb4f6-23b2-586c-8cb9-9742cce5a9a9"] :knowledge-point/questions ["q-335402"] :db/ensure [:knowledge-point/validate]} {:db/id "q-335409/field-1/d5ccc67a0af7ed709899adf357dd9d87e71344eb5b1aa1680a11724ea1238f78" :answer/id #uuid "27eea719-1a05-5ea7-abe2-69d814e82c55" :answer/type :answer.type/math :answer/value "{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-1/19518834b4a9e5a6805b91623b182c569ba80d44c2f0e29cff81194ed1214532" :answer/id #uuid "322307e0-2dd4-556e-87a7-6bbb0563cf06" :answer/type :answer.type/math :answer/value "\\frac{2}{x}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-1/439a639854c9228d402444eff0a00303e9deef2ee760ca22240bfc82ef4da0c7" :answer/id #uuid "705695b6-e392-5c6a-b5d5-2e96e9cc7044" :answer/type :answer.type/math :answer/value "{e}^{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-1/a59566f5456266c0a23c12e3bbbf0ded9e6ad0f8aa5112fc125bd2444c0d99a2" :answer/id #uuid "166e637d-b668-55e6-989f-23eb78e98ab0" :answer/type :answer.type/math :answer/value "{e}^{2/x}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-1" :answer-field/id #uuid "de5155f0-eb54-5135-87a6-d33277f1533f" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-335409/field-1/d5ccc67a0af7ed709899adf357dd9d87e71344eb5b1aa1680a11724ea1238f78" :answer-field/choices ["q-335409/field-1/d5ccc67a0af7ed709899adf357dd9d87e71344eb5b1aa1680a11724ea1238f78" "q-335409/field-1/19518834b4a9e5a6805b91623b182c569ba80d44c2f0e29cff81194ed1214532" "q-335409/field-1/439a639854c9228d402444eff0a00303e9deef2ee760ca22240bfc82ef4da0c7" "q-335409/field-1/a59566f5456266c0a23c12e3bbbf0ded9e6ad0f8aa5112fc125bd2444c0d99a2"] :db/ensure [:answer-field/validate]} {:db/id "q-335409/field-2/0a8d7c8304cd1c2eae5a3a3b90ea77419296f29a218a599960193ead54776872" :answer/id #uuid "4f2cdcb9-9f83-5ef8-8ff4-bc6b0f4c6cf2" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x}{x}+\\frac{\\operatorname{cos}⁡x}{{x}^{2}}+\\frac{C}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-2/da7af112cf5f3d362932bf4286e95e1df33a5042592247a3945f62bdaf85a0ad" :answer/id #uuid "c254a346-9a01-5cb8-be81-cadbca5bedd1" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x}{{x}^{2}}-\\frac{\\operatorname{cos}⁡x}{x}+\\frac{C}{{x}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-2/b07526f20e65c68ef9034cfde02dff110061ee2b5b8218a66e87f2e200b813ab" :answer/id #uuid "0a7c0901-d23c-5204-8677-ad8c8b86e62a" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x}{x}-\\frac{\\operatorname{cos}⁡x}{{x}^{2}}+\\frac{C}{x}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-2/49de39b4bfd3693a7345b29daccd281bb9eb5f99e6229ac22c0ae3eb4d6c6324" :answer/id #uuid "c70ee9e1-5d7b-5944-af98-a1ab861f49d4" :answer/type :answer.type/math :answer/value "\\frac{\\operatorname{sin}⁡x}{{x}^{2}}+\\frac{\\operatorname{cos}⁡x}{x}+\\frac{C}{x}" :db/ensure [:answer/validate]} {:db/id "q-335409/field-2" :answer-field/id #uuid "6e733161-63b4-5fa8-a9af-bb5718b96480" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-335409/field-2/da7af112cf5f3d362932bf4286e95e1df33a5042592247a3945f62bdaf85a0ad" :answer-field/choices ["q-335409/field-2/0a8d7c8304cd1c2eae5a3a3b90ea77419296f29a218a599960193ead54776872" "q-335409/field-2/da7af112cf5f3d362932bf4286e95e1df33a5042592247a3945f62bdaf85a0ad" "q-335409/field-2/b07526f20e65c68ef9034cfde02dff110061ee2b5b8218a66e87f2e200b813ab" "q-335409/field-2/49de39b4bfd3693a7345b29daccd281bb9eb5f99e6229ac22c0ae3eb4d6c6324"] :db/ensure [:answer-field/validate]} {:db/id "q-335409" :question/id #uuid "68d33cb4-f198-5630-836f-f4155551348b" :question/math-academy-id "q-335409" :question/problem "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y=\\frac{\\operatorname{sin}⁡x}{x},\\,x>0.\n$$\n\nSelect the correct options below.$\\,$ An integrating factor for this equation is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is given by $y(x)=$ {{field-2}}." :question/worked-solution "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\n$$\n\nwith $P(x)=\\frac{2}{x}$ and $Q(x)=\\frac{\\operatorname{sin}⁡x}{x}.$ We proceed to find an integrating factor $I(x)$ using the definition:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int (2/x)\\,\\text{d}x} \\\\  & ={e}^{2\\operatorname{ln}⁡x} \\\\  & ={x}^{2}\\end{aligned}\n$$\n\nNow, we multiply our differential equation through by $I(x)={x}^{2}$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y) & ={x}^{2}\\cdot \\frac{\\operatorname{sin}⁡x}{x} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy & =x\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nFinally, we rewrite the left hand side as $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x))$ and carry out the integration:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y{x}^{2}) & =x\\operatorname{sin}⁡x \\\\ \\int \\frac{\\text{d}}{\\text{d}x}(y{x}^{2})\\text{d}x & =\\int x\\operatorname{sin}⁡x\\,\\text{d}x\\end{aligned}\n$$\n\nTo solve this integral, we integrate by parts. \n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int {u}^{′}v\\,\\text{d}x\n$$\n\nLet $u=x,{u}^{′}=1,{v}^{′}=\\operatorname{sin}⁡x,$ and $v=-\\operatorname{cos}⁡x.$ Then, we have\n\n$$\n\\begin{aligned}y{x}^{2} & =\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\ y{x}^{2} & =x(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)\\cdot 1\\,\\text{d}x \\\\ y{x}^{2} & =-x\\operatorname{cos}⁡x+\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ y{x}^{2} & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x\\,+C \\\\ y & =\\frac{\\operatorname{sin}⁡x}{{x}^{2}}-\\frac{\\operatorname{cos}⁡x}{x}+\\frac{C}{{x}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-335409/field-1" "q-335409/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6bbeb4f6-23b2-586c-8cb9-9742cce5a9a9"] :knowledge-point/questions ["q-335409"] :db/ensure [:knowledge-point/validate]} {:db/id "q-339138/field-1/74521c50c65fc6a52056746481c6d39edacf577250ffbffd7ae5248b235295c6" :answer/id #uuid "707c0390-40f2-5fb6-b7e9-5284a1a1e1dd" :answer/type :answer.type/math :answer/value "{e}^{3x}" :db/ensure [:answer/validate]} {:db/id "q-339138/field-1/41020abd668100d9eaa1bf128349cc871dd36fec3d033b6fb97da6705b2d9497" :answer/id #uuid "970ff56e-2e52-52c2-97d3-7f53f0dbb4c1" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡x" :db/ensure [:answer/validate]} {:db/id "q-339138/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "3fcf45f3-bf36-5140-a0f9-a9d66f925998" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-339138/field-1/d16d2f2c0663bb4966ce2a0611f38907505af8eb33768de78e090a87c06d1cd5" :answer/id #uuid "a4fd6a89-a1b4-577f-9dc3-425e3be3ad05" :answer/type :answer.type/math :answer/value "{e}^{-3x}" :db/ensure [:answer/validate]} {:db/id "q-339138/field-1" :answer-field/id #uuid "1fd74287-9990-5f7e-a03a-4d5cea776822" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-339138/field