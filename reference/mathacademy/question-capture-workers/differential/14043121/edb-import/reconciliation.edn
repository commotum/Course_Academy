ferential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" nil "attribute" "question/problem" "value" "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}-3y=6{e}^{2x}.\n$$\n\nSelect the correct options below.$\\,$ An integrating factor for this equation is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is given by $y(x)=$ {{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" nil "attribute" "question/worked-solution" "value" "This equation is already in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\n$$\n\nwith $P(x)=-3$ and $Q(x)=6{e}^{2x}.$ We proceed to find an integrating factor $I(x)$ using the definition:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int -3\\,\\text{d}x} \\\\  & ={e}^{-3x}\\end{aligned}\n$$\n\nNow, we multiply our differential equation through by $I(x)={e}^{-3x}$ as follows:\n\n$$\n\\begin{aligned}{e}^{-3x}\\cdot (\\frac{\\text{d}y}{\\text{d}x}-3y) & ={e}^{-3x}\\cdot 6{e}^{2x} \\\\ {e}^{-3x}\\cdot \\frac{\\text{d}y}{\\text{d}x}-3{e}^{-3x}\\cdot y & =6{e}^{-x}\\end{aligned}\n$$\n\nFinally, we rewrite the left hand side as $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x))$ and carry out the integration:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y{e}^{-3x}) & =6{e}^{-x} \\\\ \\int \\frac{\\text{d}}{\\text{d}x}(y{e}^{-3x})\\text{d}x & =\\int 6{e}^{-x}\\,\\text{d}x \\\\ y{e}^{-3x} & =-6{e}^{-x}+C \\\\ y & =-6{e}^{2x}+C{e}^{3x}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/activity-metadata.json" "file_sha256" "0f11112cb65b3e750933ec31424c8747ef9562283a56dd3eadf84f0b9e159d1c"} {"question" "q-335402" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" "field-1" "attribute" "answer-field/choices" "value" [["math" "{e}^{-2x}"] ["math" "{e}^{-3x}"] ["math" "{e}^{2x}"] ["math" "{e}^{3x}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{-3x}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" "field-2" "attribute" "answer-field/choices" "value" [["math" "-6{e}^{-x}+C{e}^{-3x}"] ["math" "-6{e}^{2x}+C{e}^{3x}"] ["math" "6{e}^{-2x}+C{e}^{-3x}"] ["math" "6{e}^{2x}+C{e}^{3x}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335402" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-6{e}^{2x}+C{e}^{3x}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335409" "field" nil "attribute" "question/problem" "value" "Consider the differential equation\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y=\\frac{\\operatorname{sin}⁡x}{x},\\,x>0.\n$$\n\nSelect the correct options below.$\\,$ An integrating factor for this equation is $I(x)=$ {{field-1}}.\n\n$\\,$ The general solution is given by $y(x)=$ {{field-2}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335409" "field" nil "attribute" "question/worked-solution" "value" "This equation is in the standard form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}+P(x)y=Q(x)\n$$\n\nwith $P(x)=\\frac{2}{x}$ and $Q(x)=\\frac{\\operatorname{sin}⁡x}{x}.$ We proceed to find an integrating factor $I(x)$ using the definition:\n\n$$\n\\begin{aligned}I(x) & ={e}^{\\int P(x)\\,\\text{d}x} \\\\  & ={e}^{\\int (2/x)\\,\\text{d}x} \\\\  & ={e}^{2\\operatorname{ln}⁡x} \\\\  & ={x}^{2}\\end{aligned}\n$$\n\nNow, we multiply our differential equation through by $I(x)={x}^{2}$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}\\cdot (\\frac{\\text{d}y}{\\text{d}x}+\\frac{2}{x}y) & ={x}^{2}\\cdot \\frac{\\operatorname{sin}⁡x}{x} \\\\ {x}^{2}\\frac{\\text{d}y}{\\text{d}x}+2xy & =x\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nFinally, we rewrite the left hand side as $\\frac{\\text{d}}{\\text{d}x}(y\\cdot I(x))$ and carry out the integration:\n\n$$\n\\begin{aligned}\\frac{\\text{d}}{\\text{d}x}(y{x}^{2}) & =x\\operatorname{sin}⁡x \\\\ \\int \\frac{\\text{d}}{\\text{d}x}(y{x}^{2})\\text{d}x & =\\int x\\operatorname{sin}⁡x\\,\\text{d}x\\end{aligned}\n$$\n\nTo solve this integral, we integrate by parts. \n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int {u}^{′}v\\,\\text{d}x\n$$\n\nLet $u=x,{u}^{′}=1,{v}^{′}=\\operatorname{sin}⁡x,$ and $v=-\\operatorname{cos}⁡x.$ Then, we have\n\n$$\n\\begin{aligned}y{x}^{2} & =\\int x\\operatorname{sin}⁡x\\,\\text{d}x \\\\ y{x}^{2} & =x(-\\operatorname{cos}⁡x)-\\int (-\\operatorname{cos}⁡x)\\cdot 1\\,\\text{d}x \\\\ y{x}^{2} & =-x\\operatorname{cos}⁡x+\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ y{x}^{2} & =-x\\operatorname{cos}⁡x+\\operatorname{sin}⁡x\\,+C \\\\ y & =\\frac{\\operatorname{sin}⁡x}{{x}^{2}}-\\frac{\\operatorname{cos}⁡x}{x}+\\frac{C}{{x}^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335409" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/activity-metadata.json" "file_sha256" "0f11112cb65b3e750933ec31424c8747ef9562283a56dd3eadf84f0b9e159d1c"} {"question" "q-335409" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/select "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14043121/state.json" "file_sha256" "262ce129f7f1f65c402783c2d66bedb70122542fa8239199acd5449d117bec1a"} {"question" "q-335409" "field" "field-1" "attribute" "answer-fiel