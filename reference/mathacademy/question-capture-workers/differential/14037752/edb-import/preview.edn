3}\\end{aligned}\n$$\n\nSince $\\frac{11}{3}\\ne 0$ and $\\frac{11}{3}\\ne -3,$ we conclude that $x=\\frac{11}{3}$ is a valid solution.\n\nTherefore, the solution to our original equation is $x=\\frac{11}{3}.$" 13194139534596 true] [17592186297866 1000 #edb/ref 17592186297867 13194139534596 true] [17592186297866 1040 #edb/ref 17592186045449 13194139534596 true] [17592186297866 1041 "field-1" 13194139534596 true] [17592186297866 1104 #edb/ref 17592186297867 13194139534596 true] [17592186297866 1110 #uuid "4006b580-a5cc-52cd-8b89-317238a6fcb2" 13194139534596 true] [17592186297867 1034 "\\frac{11}{3}" 13194139534596 true] [17592186297867 1103 #edb/ref 17592186045453 13194139534596 true] [17592186297867 1111 #uuid "046acada-78e0-5eb9-ade9-a08ac8ee1793" 13194139534596 true] [17592186297868 1017 #edb/ref 17592186297869 13194139534596 true] [17592186297868 1089 "q-276460" 13194139534596 true] [17592186297868 1091 #edb/ref 17592186045463 13194139534596 true] [17592186297868 1100 "Solve the equation $\\frac{4}{5s(s+1)}+\\frac{3}{5s}=\\frac{1}{s+1}.$\n\n$s=$\n{{field-1}}" 13194139534596 true] [17592186297868 1113 #uuid "604a1c9f-a782-5971-a297-e70b31599a7a" 13194139534596 true] [17592186297868 1145 "We make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(5s(s+1),\\,5s,\\,s+1)=5s(s+1).\n$$\n\n- The values $s=0$ and $s=-1$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{4}{5s(s+1)}+\\frac{3}{5s} & =\\frac{1}{s+1} \\\\ 5s(s+1)\\cdot (\\frac{4}{5s(s+1)}+\\frac{3}{5s}) & =5s(s+1)\\cdot \\frac{1}{s+1} \\\\ \\frac{20s(s+1)}{5s(s+1)}+\\frac{15s(s+1)}{5s} & =\\frac{5s(s+1)}{s+1} \\\\ \\frac{4\\cdot \\cancel{5s(s+1)}}{\\cancel{5s(s+1)}}+\\frac{3\\cdot \\cancel{5s}(s+1)}{\\cancel{5s}} & =\\frac{5s\\cancel{(s+1)}}{\\cancel{s+1}} \\\\ 4+3(s+1) & =5s\\end{aligned}\n$$\n\nSolving this equation for $s,$ we get the following:\n\n$$\n\\begin{aligned}4+3(s+1) & =5s \\\\ 4+3s+3 & =5s \\\\ 7 & =2s \\\\ s & =\\frac{7}{2}\\end{aligned}\n$$\n\nSince $\\frac{7}{2}\\ne 0$ and $\\frac{7}{2}\\ne -1,$ we conclude that $s=\\frac{7}{2}$ is a valid solution.\n\nTherefore, the solution to our original equation is $s=\\frac{7}{2}.$" 13194139534596 true] [17592186297869 1000 #edb/ref 17592186297870 13194139534596 true] [17592186297869 1040 #edb/ref 17592186045449 13194139534596 true] [17592186297869 1041 "field-1" 13194139534596 true] [17592186297869 1104 #edb/ref 17592186297870 13194139534596 true] [17592186297869 1110 #uuid "da601fb2-e576-5d03-8969-2a75ecc7797a" 13194139534596 true] [17592186297870 1034 "\\frac{7}{2}" 13194139534596 true] [17592186297870 1103 #edb/ref 17592186045453 13194139534596 true] [17592186297870 1111 #uuid "33fdba8b-2f76-50be-911e-13fae2be6df9" 13194139534596 true] [17592186297871 1017 #edb/ref 17592186297872 13194139534596 true] [17592186297871 1089 "q-276549" 13194139534596 true] [17592186297871 1091 #edb/ref 17592186045463 13194139534596 true] [17592186297871 1100 "Solve the equation $\\frac{3}{y+2}=\\frac{7}{{y}^{2}-4}-\\frac{1}{y-2}.$\n\n$y=$\n{{field-1}}" 13194139534596 true] [17592186297871 1113 #uuid "fb9e4d21-8a7f-5a9f-9b01-4676c8c52014" 13194139534596 true] [17592186297871 1145 "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{3}{y+2}=\\frac{7}{(y-2)(y+2)}-\\frac{1}{y-2}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(y+2,\\,y-2,\\,(y-2)(y+2))=(y-2)(y+2).\n$$\n\n- The values $y=-2$ and $y=2$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{3}{y+2} & =\\frac{7}{(y-2)(y+2)}-\\frac{1}{y-2} \\\\ (y-2)(y+2)\\cdot \\frac{3}{y+2} & =(y-2)(y+2)\\cdot (\\frac{7}{(y-2)(y+2)}-\\frac{1}{y-2}) \\\\ \\frac{3(y-2)(y+2)}{y+2} & =\\frac{7(y-2)(y+2)}{(y-2)(y+2)}-\\frac{(y-2)(y+2)}{y-2} \\\\ \\frac{3(y-2)\\cancel{(y+2)}}{\\cancel{y+2}} & =\\frac{7\\cancel{(y-2)(y+2)}}{\\cancel{(y-2)(y+2)}}-\\frac{\\cancel{(y-2)}(y+2)}{\\cancel{y-2}} \\\\ 3(y-2) & =7-(y+2)\\end{aligned}\n$$\n\n \n\nSolving this equation for $y,$ we get the following:\n\n$$\n\\begin{aligned}3(y-2) & =7-(y+2) \\\\ 3y-6 & =7-y-2 \\\\ 4y & =11 \\\\ y & =\\frac{11}{4}\\end{aligned}\n$$\n\n \n\nSince $\\frac{11}{4}\\ne -2$ and $\\frac{11}{4}\\ne 2,$ we conclude that $y=\\frac{11}{4}$ is a valid solution. \n\nTherefore, the solution to our original equation is $y=\\frac{11}{4}.$" 13194139534596 true] [17592186297872 1000 #edb/ref 17592186297873 13194139534596 true] [17592186297872 1000 #edb/ref 17592186297874 13194139534596 true] [17592186297872 1040 #edb/ref 17592186045449 13194139534596 true] [17592186297872 1041 "field-1" 13194139534596 true] [17592186297872 1104 #edb/ref 17592186297873 13194139534596 true] [17592186297872 1110 #uuid "58f40ec9-f503-5bb3-95aa-6c93bc478fb6" 13194139534596 true] [17592186297873 1034 "\\frac{11}{4}" 13194139534596 true] [17592186297873 1103 #edb/ref 17592186045453 13194139534596 true] [17592186297873 1111 #uuid "e3ea28c8-8814-5f82-aeab-17ef0ebf07d3" 13194139534596 true] [17592186297874 1034 "3" 13194139534596 true] [17592186297874 1103 #edb/ref 17592186045453 13194139534596 true] [17592186297874 1111 #uuid "2b7eaaca-2a2e-5bd1-9f4b-b2480bb312bd" 13194139534596 true] [17592186297875 1017 #edb/ref 17592186297876 13194139534596 true] [17592186297875 1089 "q-276552" 13194139534596 true] [17592186297875 1091 #edb/ref 17592186045463 13194139534596 true] [17592186297875 1100 "Solve the equation $\\frac{1}{{w}^{2}-25}=\\frac{1}{w-5}-\\frac{4}{w+5}.$\n\n$w=$\n{{field-1}}" 13194139534596 true] [17592186297875 1113 #uuid "d3bbffe4-f265-5a0b-b678-d351a5f34ada" 13194139534596 true] [17592186297875 1145 "First, we factor the quadratic denominator, giving us the equation\n\n$$\n\\frac{1}{(w-5)(w+5)}=\\frac{1}{w-5}-\\frac{4}{w+5}.\n$$\n\nWe now make the following observations:\n\n- The least common denominator of our equation is given by\n\n$$\n\\text{LCM}(w-5,\\,w+5,\\,(w-5)(w+5))=(w-5)(w+5).\n$$\n\n- The values $w=-5$ and $w=5$ cannot be solutions to our equation. These values make at least one denominator in our original equation equal zero, and division by zero is undefined.\n\nNow, multiplying both sides of the equation by the least common denominator, we can simplify it as follows:\n\n$$\n\\begin{aligned}\\frac{1}{(w-5)(w+5)} & =\\frac{1}{w-5}-\\frac{4}{w+5} \\\\ (w-5)(w+5)\\cdot \\frac{1}{(w-5)(w+5)} & =(w-5)(w+5)\\cdot (\\frac{1}{w-5}-\\frac{4}{w+5}) \\\\ \\frac{(w-5)(w+5)}{(w-5)(w+5)} & =\\frac{(w-5)(w+5)}{w-5}-\\frac{4(w-5)(w+5)}{x+5} \\\\ \\frac{\\cancel{(w-5)(w+5)}}{\\cancel{(w-5)(w+5)}} & =\\frac{\\cancel{(w-5)}(w+5)}{\\cancel{(w-5)}}-\\frac{4(w-5)\\cancel{(w+5)}}{\\cancel{w+5}} \\\\ 1 & =(w+5)-4(w-5)\\end{aligned}\n$$\n\n \n\nSolving this equation for $w,$ we get the following:\n\n$$\n\\begin{aligned}1 & =(w+5)-4(w-5) \\\\ 1 & =w+5-4w+20 \\\\ 3w & =24 \\\\ w & =8\\end{aligned}\n$$\n\n \n\nSince $8\\ne -5$ and $8\\ne 5,$ we conclude that $w=8$ is a valid solution. \n\nTherefore, the solution to our original equation is $w=8.$" 13194139534596 true] [17592186297876 1000 #edb/ref 17592186297877 13194139534596 true] [17592186297876 1040 #edb/ref 17592186045449 13194139534596 true] [17592186297876 1041 "field-1" 13194139534596 true] [17592186297876 1104 #edb/ref 17592186297877 13194139534596 true] [17592186297876 1110 #uuid "2cc2cbe0-9f1b-567e-b0ef-ef0fa2d468ac" 13194139534596 true] [17592186297877 1034 "8" 13194139534596 true] [17592186297877 1103 #edb/ref 17592186045453 13194139534596 true] [17592186297877 1111 #uuid "14d5eaaa-518b-5375-a7a6