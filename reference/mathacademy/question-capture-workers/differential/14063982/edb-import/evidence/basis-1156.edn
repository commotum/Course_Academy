#{[{:db/id #edb/ref 17592186289916 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa0f6412-9d9a-5e5f-b235-30bf39102742" :answer/type {:db/ident :answer.type/math} :answer/value "2t^7+3t^4" :db/id #edb/ref 17592186289918} {:answer/id #uuid "438fe4b3-62f1-5533-a20c-d8669ccf09e2" :answer/type {:db/ident :answer.type/math} :answer/value "2t^7+3t^4+6" :db/id #edb/ref 17592186289919}] :answer-field/correct {:answer/id #uuid "438fe4b3-62f1-5533-a20c-d8669ccf09e2" :answer/type {:db/ident :answer.type/math} :answer/value "2t^7+3t^4+6" :db/id #edb/ref 17592186289919} :answer-field/id #uuid "a309ad20-6987-57d0-b45b-abe948c42042" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289917}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e1638b5-7055-56e8-8524-6658a022f221" :question/math-academy-id "q-350978" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=14{t}^{6}+12{t}^{3},$ where $t$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{m/s}$) of the particle at time $t$ given that the particle has velocity $v=310\\,\\text{m/s}$ when $t=2\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (14{t}^{6}+12{t}^{3})\\text{d}t \\\\  & =2{t}^{7}+3{t}^{4}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(2)=310.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}310 & =2({2}^{7})+3({2}^{4})+C \\\\ 310 & =304+C \\\\ C & =6.\\end{aligned}\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=2{t}^{7}+3{t}^{4}+6.$"}]}
