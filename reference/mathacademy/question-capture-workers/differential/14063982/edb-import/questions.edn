92186289916 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aa0f6412-9d9a-5e5f-b235-30bf39102742" :answer/type {:db/ident :answer.type/math} :answer/value "2t^7+3t^4" :db/id #edb/ref 17592186289918} {:answer/id #uuid "438fe4b3-62f1-5533-a20c-d8669ccf09e2" :answer/type {:db/ident :answer.type/math} :answer/value "2t^7+3t^4+6" :db/id #edb/ref 17592186289919}] :answer-field/correct {:answer/id #uuid "438fe4b3-62f1-5533-a20c-d8669ccf09e2" :answer/type {:db/ident :answer.type/math} :answer/value "2t^7+3t^4+6" :db/id #edb/ref 17592186289919} :answer-field/id #uuid "a309ad20-6987-57d0-b45b-abe948c42042" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186289917}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e1638b5-7055-56e8-8524-6658a022f221" :question/math-academy-id "q-350978" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $\\text{m}/{\\text{s}}^{2},$ given by the function $a(t)=14{t}^{6}+12{t}^{3},$ where $t$ is the time in seconds. Find the velocity $v(t)$ (in $\\text{m/s}$) of the particle at time $t$ given that the particle has velocity $v=310\\,\\text{m/s}$ when $t=2\\,\\text{s}.$\n\n$v(t)=$\n{{field-1}}" :question/worked-solution "First, we find $v(t)$ by integrating the acceleration with respect to time:\n\n$$\n\\begin{aligned}v(t) & =\\int a(t)\\text{d}t \\\\  & =\\int (14{t}^{6}+12{t}^{3})\\text{d}t \\\\  & =2{t}^{7}+3{t}^{4}+C\\end{aligned}\n$$\n\nTo determine $C$, we use the fact that $v(2)=310.$ Substituting this into the above gives\n\n$$\n\\begin{aligned}310 & =2({2}^{7})+3({2}^{4})+C \\\\ 310 & =304+C \\\\ C & =6.\\end{aligned}\n$$\n\nTherefore, the velocity of the particle at time $t$ is $v(t)=2{t}^{7}+3{t}^{4}+6.$"}] [{:db/id #edb/ref 17592186083827 :knowledge-point/_questions [{:knowledge-point/id #uuid "ee2920dc-93e1-5595-a751-62ad5e4f3035" :knowledge-point/title "Finding the Velocity of a Particle Whose Acceleration Is Given By a Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9bfc1bda-5eff-5a6f-b371-ab5883fc7a95" :answer/type {:db/ident :answer.type/math} :answer/value "12m/s" :db/id #edb/ref 17592186082329} {:answer/id #uuid "cb76cb83-825b-5d0d-be09-9bfb4563099c" :answer/type {:db/ident :answer.type/math} :answer/value "16m/s" :db/id #edb/ref 17592186082330} {:answer/id #uuid "d0045836-72f5-5b20-a3a4-bbfd93f1daf8" :answer/type {:db/ident :answer.type/math} :answer/value "20m/s" :db/id #edb/ref 17592186082331} {:answer/id #uuid "50ffc313-9571-553c-b356-7dae55d432ee" :answer/type {:db/ident :answer.type/math} :answer/value "4m/s" :db/id #edb/ref 17592186082332} {:answer/id #uuid "7b99555a-846b-5a82-ba1b-a2a1f5c28fde" :answer/type {:db/ident :answer.type/math} :answer/value "24m/s" :db/id #edb/ref 17592186082333}] :answer-field/correct {:answer/id #uuid "d0045836-72f5-5b20-a3a4-bbfd93f1daf8" :answer/type {:db/ident :answer.type/math} :answer/value "20m/s" :db/id #edb/ref 17592186082331} :answer-field/id #uuid "a34c9314-d67c-5e55-b802-bfbf18eee36a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082328}] :question/id #uuid "fdcc1478-03c8-5a05-bbb2-e650f412de86" :question/math-academy-id "q-7112" :question/problem "A particle moves along a straight line relative to a fixed origin $O$ with acceleration, measured in $m/s^{2}$, given by the function $a(t) = 2t - 9t^{2}$, where $t$ is the time in seconds. If the particle has velocity $v =-2m/s$ when $t = 1s$, calculate the speed of the particle at the moment $t = 2s$."}]}
