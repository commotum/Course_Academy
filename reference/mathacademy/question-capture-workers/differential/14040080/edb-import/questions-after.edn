 a vertical line, the slopes touching the line vary as we go up and down the line. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/97f075f29a703d1cae44a533d4540093644d1fb19b7808feec6583d140f78de4.png)"}] [{:db/id #edb/ref 17592186305908 :knowledge-point/_questions [{:knowledge-point/id #uuid "5177f277-29a6-5df6-96c5-6bf53ffd9c51" :knowledge-point/title "Identifying a Possible Slope Field Based on the Type of Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "275ccd95-32b2-539d-ac4f-a71dd2c844fb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/7fa15a5bb016272df819a954be52a984a18d242d5617a5a02343b356ed38789c.png" :db/id #edb/ref 17592186305910} {:answer/id #uuid "a71479c2-5cb0-5ad0-b01d-c474c2b69a46" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/ebcc2639206da90f50f226b568538b8c20e6e29ecb0a9c44211331ffd1bce1b5.png" :db/id #edb/ref 17592186305911} {:answer/id #uuid "e4c99fb4-89b3-5cb3-92a9-e77162e2728e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/2666b0dbfa5cc6f725d2d656b968b46f2c0b344247985fd4859be36a8cef211e.png" :db/id #edb/ref 17592186305912} {:answer/id #uuid "07c3d370-d067-5363-be4b-84c9dab2acf0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/4746fd4a7c793882f09065278ad9a7350c41f91fcd35677e9ee8768a8ca57b66.png" :db/id #edb/ref 17592186305913} {:answer/id #uuid "a911d95f-c66a-57bf-9bb4-27997272f9f5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Develope