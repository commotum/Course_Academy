c69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "488c3d7e-972e-5d22-896b-e1332f1f6c2b" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-96457/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c5a8c3e6-d4b4-5eaf-852b-73cfaa32e21d" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-96457/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "19156c10-3d31-50d6-9bda-6858c5c4f4d1" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-96457/selection" :answer-field/id #uuid "55462a1c-8e1a-54ba-86d8-3bc4a1241abe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96457/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-96457/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-96457/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-96457/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-96457/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-96457/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-96457" :question/id #uuid "26b5af41-aa8e-538e-8148-814f5268dc52" :question/math-academy-id "q-96457" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=x-2$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $x=-2,$ the slope field has a negative slope\n- At every point along the line $x=1,$ the slope field has a positive slope\n- At every point along the line $x=2,$ the slope field is horizontal" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(-2,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,y)}=-2-2=-4<0,\n$$\n\nand this implies that the slope at the point $(-2,y)$ is negative for any $y.$ Moreover, the slope at the point $(-2,y)$ is equal to $-4$ for any $y.$\n\n- Statement II is false. Consider a point of the form $(1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,y)}=1-2=-1<0,\n$$\n\nand this implies that the slope at the point $(1,y)$ is negative for any $y.$ Moreover, the slope at the point $(1,y)$ is equal to $-1$ for any $y.$\n\n- Statement III is true. Consider a point of the form $(2,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(2,y)}=2-2=0,\n$$\n\nand this implies that the slope at the point $(2,y)$ is horizontal for any $y.$\n\nTherefore, the correct answer is \"I and III only.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/34ab84e5a2b05adad50384cbbb33f48233976aa9e757a40468d5778709801d83.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-96457/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735"] :knowledge-point/questions ["q-96457"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119194/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "dd17f401-6e06-5f25-9880-098485c3d7c5" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-119194/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "809a515f-2671-5f91-8153-b7defac35fb5" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-119194/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "f1fd8d68-b69b-5f96-9008-5250e81518d6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-119194/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "9405908b-b6ff-5be2-ad08-a3b44f98fd91" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-119194/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "1e41064b-7938-5eb6-9d44-ac8cf9ba31dd" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-119194/selection" :answer-field/id #uuid "caff0cc2-5cb4-5a1d-b38a-39f62b81dabd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119194/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-119194/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-119194/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-119194/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-119194/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-119194/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6"] :db/ensure [:answer-field/validate]} {:db/id "q-119194" :question/id #uuid "68b47d11-a021-5ca6-a752-6f99062a5a8b" :question/math-academy-id "q-119194" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2x+2$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $x=0,$ the slope field has a positive slope\n- At every point along the line $x=-1,$ the slope field is horizontal\n- At every point along the line $x=-2,$ the slope field has a positive slope" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(0,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,y)}=2(0)+2=2>0,\n$$\n\nand this implies that the slope at the point $(0,y)$ is positive for any $y.$ Moreover, the slope at the point $(0,y)$ is equal to $2$ for any $y.$\n\n- Statement II is true. Consider a point of the form $(-1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,y)}=2(-1)+2=0,\n$$\n\nand this implies that the slope at the point $(-1,y)$ is horizontal for any $y.$\n\n- Statement III is false. Consider a point of the form $(-2,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,y)}=2(-2)+2=-2<0,\n$$\n\nand this implies that the slope at the point $(-2,y)$ is negative for any $y.$ Moreover, the slope at the point $(-2,y)$ is equal to $-2$ for any $y.$\n\nTherefore, the correct answer is \"I and II only.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/8d40c405f3f4db66a18e06a5327e86600081a6bc57b502ebed9c94471a0d5857.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119194/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735"] :knowledge-point/questions ["q-119194"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119206/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "c18ea625-0115-5561-9143-cbe962a27cab" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-119206/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d32f2eca-0a06-5c68-8bc1-416688b63393" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-119206/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "342e8986-e752-5c8c-98bf-c3447e6699fc" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-119206/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "7d49ad34-cc6f-5ef1-8171-6756b4a13b8f" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-119206/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "01e55814-eeb5-5d67-a58f-013d0f4491bb" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-119206/selection" :answer-field/id #uuid "396d2c48-5f8f-52f5-b05c-513636b29ee3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119206/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-119206/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-119206/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-119206/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-119206/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-119206/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-119206" :question/id #uuid "3abc9452-624e-5579-a29d-03f9a68262cf" :question/math-academy-id "q-119206" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}={x}^{2}-3x$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $x=2,$  the slope field has a negative slope\n- At every point along the line $x=0,$  the slope field is horizontal\n- At every point along the line $y=1,$ the slope of the slope field does not vary" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(2,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(2,y)}={2}^{2}-3(2)=-2,\n$$\n\nand this implies that the slope at the point $(2,y)$ is negative for any $y.$\n\n- Statement II is true. Consider a point of the form $(0,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,y)}={0}^{2}-3(0)=0,\n$$\n\nand this implies that the slope of the slope field at the point $(0,y)$ is horizontal for any $y.$\n\n- Statement III is false. Consider a point of the form $(x,1)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,1)}={x}^{2}-3x,\n$$\n\nand this implies that the slope of the slope field at the point $(x,1)$ depends on $x.$\n\nTherefore, the correct answer is \"I and II only.\"\n\nWe can use the information given by the true statements to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/e2ce8d7df3d0ceee4f8c9dcf368940006f1266a751c2f8e5ea8afdcfb90bf7ac.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119206/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735"] :knowledge-point/questions ["q-119206"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96460/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "ba5b7e5b-32a5-5635-94a6-36edcd4d91e2" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-96460/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "3ade0966-1801-597b-a5ec-cf6aaddffe25" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-96460/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "54e1fbd3-d5f5-5631-8c5e-851b88a50197" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-96460/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "47f181dd-3a48-5346-8d97-13e0eb37932a" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-96460/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "3e65d89f-ad53-5995-869e-d9e804392388" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-96460/selection" :answer-field/id #uuid "cafc1843-6256-5c96-a316-ceaa9cda3fb6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96460/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-96460/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-96460/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-96460/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-96460/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-96460/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-96460" :question/id #uuid "2deae67f-b66c-5463-b4cc-a6e8cdf95fcd" :question/math-academy-id "q-96460" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}={x}^{3}+x$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $x=-1,$ the slope field has a negative slope\n- At every point along the line $x=0,$ the slope field is horizontal\n- At every point along the line $x=1,$ the slope field has a positive slope" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(-1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(-1,y)}=(-1)^{3}+(-1)=-2<0,\n$$\n\nand this implies that the slope at the point $(-1,y)$ is negative for any $y.$ Moreover, the slope at the point $(-1,y)$ is equal to $-2$ for any $y.$\n\n- Statement II is true. Consider a point of the form $(0,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,y)}=(0)^{2}+0=0,\n$$\n\nand this implies that the slope at the point $(0,y)$ is horizontal for any $y.$\n\n- Statement III is true. Consider a point of the form $(1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,y)}=(1)^{3}+1=2,\n$$\n\nand this implies that the slope at the point $(1,y)$ is positive for any $y.$ Moreover, the slope at the point $(1,y)$ is equal to $2$ for any $y.$\n\nTherefore, the correct answer is \"I, II, and III.\"\n\nWe can use this information to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/45427ef9ff00752ad528335ae51143c27fcc01d9c535d2fe380edfbbfdb9b167.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-96460/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735"] :knowledge-point/questions ["q-96460"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119209/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "9887084b-5019-5cd2-9df1-018009397cec" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-119209/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "a4ff5cc9-f180-5cd0-ae04-4f91d4752659" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-119209/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "9dc5c6d3-2e46-59e2-ba32-638221f91109" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-119209/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "d79e85a2-3cff-5704-aef5-ee356ac841dd" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-119209/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "a6bc331a-7727-5c12-be7c-cd557e4b6dc5" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-119209/selection" :answer-field/id #uuid "8640bf9a-f040-5c14-b49b-51693fcc0301" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119209/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-119209/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-119209/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-119209/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-119209/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-119209/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-119209" :question/id #uuid "f3ead8fb-34d4-5aea-a509-a80a04973d86" :question/math-academy-id "q-119209" :question/problem "Consider the differential equation $\\frac{\\text{d}y}{\\text{d}x}=1-{x}^{3}$ and its slope field. Which of the following statements are true?\n\n- At every point along the line $x=1,$  the slope field is horizontal\n- At every point along the line $x=0,$  the slope field has a positive slope\n- At every point along the line $y=2,$ the slope of the slope field varies" :question/worked-solution "Notice that we are given an equation of the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=f(x).\n$$\n\nThe right-hand side is a function of $x$ only. This means that, for a fixed value of $x,$ the slope does not vary with $y.$ \n\nNow, let's check each statement:\n\n- Statement I is true. Consider a point of the form $(1,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(1,y)}=1-{1}^{3}=0,\n$$\n\nand this implies that the slope at the point $(1,y)$ is horizontal for any $y.$\n\n- Statement II is true. Consider a point of the form $(0,y)$ where $y$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(0,y)}=1-{0}^{3}=1>0,\n$$\n\nand this implies that the slope of the slope field at the point $(0,y)$ is positive for any $y.$ Moreover, the slope at the point $(0,y)$ is equal to $1$ for any $y.$\n\n- Statement III is true. Consider a point of the form $(x,2)$ where $x$ is arbitrary. We have\n\n$$\n{\\frac{\\text{d}y}{\\text{d}x}|}_{(x,2)}=1-{x}^{3},\n$$\n\nand this implies that the slope of the slope field at the point $(x,2)$ depends on $x.$\n\nTherefore, the correct answer is \"I, II, and III.\"\n\nWe can use the information given by the true statements to begin sketching the slope field, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/85d8f71c4680a56d5722b87fa5f7b2a7623fd2457f540c2cd15cd3bfa29694f3.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119209/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3aa84ae8-6663-5aa1-844b-89090bcce735"] :knowledge-point/questions ["q-119209"] :db/ensure [:knowledge-point/validate]} {:db/id "q-96658/selection/d2235f72538dc4a8f9ef0ad49554c7513df49cf14f4153863b415074593f6b46" :answer/id #uuid "9a26226a-32ba-5613-8d44-613a0aba7b40" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/14096d22db478ed54dc368c28c27b651a423836e0b8b1c656c98f0375e526f05.png" :db/ensure [:answer/validate]} {:db/id "q-96658/selection/8e97f8cc0ce993e3b562734cac8a373d80f81dd9cea664b72ebf2121daf75a5e" :answer/id #uuid "5122e204-2044-5a0b-a014-413b1a09427f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/679693a06199f2862ebc45476afbf3e093c1062b7d1a3a6f0bfd9236c1473d96.png" :db/ensure [:answer/validate]} {:db/id "q-96658/selection/6b506039f1020e26a3a19c8751b8186f766cc2b2c324b6ef22c534780e0ea169" :answer/id #uuid "f9c6ec4f-c8b9-5d9e-b97d-6f921203c00c" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/d94451671073d38af905b1190a15f97e6419a3a6052f83e53caa5a94b4a7000a.png" :db/ensure [:answer/validate]} {:db/id "q-96658/selection/fdef5f2426192da6d24b3c2a7d284721ba07c31c937db843674e70ada3251d6a" :answer/id #uuid "70696bcb-71a7-5b54-b645-fae3515de2f5" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/refe