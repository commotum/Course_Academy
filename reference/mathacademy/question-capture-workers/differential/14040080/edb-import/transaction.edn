ion-capture-workers/differential/14040080/assets/1d1251339041f6f17af438aa45fb26db5ab69027a68dcd3ac80f1e890e61ae25.png" :db/ensure [:answer/validate]} {:db/id "q-96628/selection" :answer-field/id #uuid "cafa040f-4f94-5586-a8dd-253dd01717c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-96628/selection/0013fd5e214cea320699ade67f442ebd4b04d402ea1112f5f710250114e61b86" :answer-field/choices ["q-96628/selection/b83c47139e25e699a8a0c88ff6fffd26d654a174dc5a1120006db2e2669eefad" "q-96628/selection/20dbb5a0c2c9eb0dcf5f2eb3fde08e7040a9ddf8e0606deed32c3ff17421afd3" "q-96628/selection/0013fd5e214cea320699ade67f442ebd4b04d402ea1112f5f710250114e61b86" "q-96628/selection/edc4f62e13c5089df525d33a9ac7ae420d02958c6e3252173ee6368a3bc930a5" "q-96628/selection/b7cd2dc7da54c73d7b4a51da79dc422be002c5774385b38626f439f1497ed9c0"] :db/ensure [:answer-field/validate]} {:db/id "q-96628" :question/id #uuid "33118801-2c57-5ee6-ba58-478cea588767" :question/math-academy-id "q-96628" :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+x?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,-1),(-2,-2),$ and $(1,1).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,-1)}=(-2)^{2}+(-2)=2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,-2)}=(-2)^{2}+(-2)=2, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(1,1)}=(1)^{2}+(1)=2.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/21e88a2ac9e3c4e94e72f49e2c7635bf326b7a5ff2d8697c776e0d5eefc52b2a.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-96628/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a2936c86-e02f-5b66-8fe2-5aa81aab8754"] :knowledge-point/questions ["q-96628"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-96083"] :question/problem "Which of the following diagrams gives the slope field at the points indicated for the differential equation $\\frac{\\text{d}y}{\\text{d}x}={x}^{2}+2x?$" :question/worked-solution "We have to sketch the slope field at the points $(-2,1),(-2,2),$ and $(2,3).$\n\nTo sketch the slope field at the given points, we substitute their coordinates into the right-hand side of the differential equation.\n\n$$\n\\begin{aligned} & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,1)}=(-2)^{2}+2(-2)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(-2,2)}=(-2)^{2}+2(-2)=0, \\\\  & {\\frac{\\text{d}y}{\\text{d}x}|}_{(2,3)}=(2)^{2}+2(2)=8.\\end{aligned}\n$$\n\nSetting up our points and drawing our line segments, we get the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/4b6ef4f2b56acf2d09a07d73c19f49f5b1c6b9eee17caa382a5c9924cbb0ea5f.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-119184/selection/8fb5b8cc819c1467b0d1e0fdfe43eb7864f129ea278e9b601a1d192883bbc9d0" :answer/id #uuid "6f05679d-fa90-542d-ad09-708385c017f2" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/467f0de9a886dbdb4d7620a4249379c2a8a661738960c3242d5e6618c35eb22b.png" :db/ensure [:answer/validate]} {:db/id "q-119184/selection/d4063bd4b9c1b29ad8ad5ed1c3fe058151db8e675e5455d6d830876fbefe7981" :answer/id #uuid "6ff053a3-6803-5b31-8710-0c1ce3ecdb9a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14040080/assets/4d1215951e