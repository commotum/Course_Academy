in}⁡(3t)\\end{aligned}],\\,x(0)=[\\begin{aligned}4 \\\\ 1\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]\\,+$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3t)+2\\operatorname{sin}⁡(3t) \\\\ -2\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333638" "field" nil "attribute" "question/worked-solution" "value" "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3t)+2\\operatorname{sin}⁡(3t) \\\\ -2\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}\\operatorname{cos}⁡(2\\cdot 0) \\\\ \\operatorname{sin}⁡(2\\cdot 0)\\end{aligned}]+{c}_{2}[\\begin{aligned}-\\operatorname{sin}⁡(2\\cdot 0) \\\\ \\operatorname{cos}⁡(2\\cdot 0)\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3\\cdot 0)+2\\operatorname{sin}⁡(3\\cdot 0) \\\\ -2\\operatorname{cos}⁡(3\\cdot 0)+\\operatorname{sin}⁡(3\\cdot 0)\\end{aligned}] & =[\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ -2\\end{aligned}] & =[\\begin{aligned}4 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+1 \\\\ {c}_{2}-2\\end{aligned}] & =[\\begin{aligned}4 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n{\\begin{aligned}{c}_{1}+1=4 \\\\ {c}_{2}-2=1\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=3.$ From the second equation, we have ${c}_{2}=3.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=3\\cdot [\\begin{aligned}\\operatorname{cos}⁡(2t) \\\\ \\operatorname{sin}⁡(2t)\\end{aligned}]+3\\cdot [\\begin{aligned}-\\operatorname{sin}⁡(2t) \\\\ \\operatorname{cos}⁡(2t)\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3t)+2\\operatorname{sin}⁡(3t) \\\\ -2\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333638" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/activity-metadata.json" "file_sha256" "ad2a51c3104c829087039fd85ba5dc7fe4c610f46a2a25976081cfaa2a1446bb"} {"question" "q-333638" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333638" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333638" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333638" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333631" "field" nil "attribute" "question/problem" "value" "$$\n{x}^{′}(t)=[\\begin{aligned}-4 & 4 \\\\ -1 & 0\\end{aligned}]x(t)+[\\begin{aligned}-14\\operatorname{cos}⁡(3t)-15\\operatorname{sin}⁡(3t) \\\\ 4\\operatorname{cos}⁡(3t)-11\\operatorname{sin}⁡(3t)\\end{aligned}],\\,x(0)=[\\begin{aligned}-1 \\\\ 6\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}2{e}^{-2t} \\\\ {e}^{-2t}\\end{aligned}]\\,+$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}(2t-1){e}^{-2t} \\\\ t{e}^{-2t}\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3t)-2\\operatorname{sin}⁡(3t) \\\\ 3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333631" "field" nil "attribute" "question/worked-solution" "value" "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}2{e}^{-2t} \\\\ {e}^{-2t}\\end{aligned}]+{c}_{2}[\\begin{aligned}(2t-1){e}^{-2t} \\\\ t{e}^{-2t}\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3t)-2\\operatorname{sin}⁡(3t) \\\\ 3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}-1 \\\\ 6\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}2{e}^{-2(0)} \\\\ {e}^{-2(0)}\\end{aligned}]+{c}_{2}[\\begin{aligned}(2\\cdot 0-1){e}^{-2(0)} \\\\ 0\\cdot {e}^{-2(0)}\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3\\cdot 0)-2\\operatorname{sin}⁡(3\\cdot 0) \\\\ 3\\operatorname{cos}⁡(3\\cdot 0)+\\operatorname{sin}⁡(3\\cdot 0)\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 6\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}2 \\\\ 1\\end{aligned}]+{c}_{2}[\\begin{aligned}-1 \\\\ 0\\end{aligned}]+[\\begin{aligned}1 \\\\ 3\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 6\\end{aligned}] \\\\ [\\begin{aligned}2{c}_{1}-{c}_{2}+1 \\\\ {c}_{1}+3\\end{aligned}] & =[\\begin{aligned}-1 \\\\ 6\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n{\\begin{aligned}2{c}_{1}-{c}_{2}+1=-1 \\\\ {c}_{1}+3=6\\end{aligned}\n$$\n\nFrom the second equation, we get ${c}_{1}=3.$  Substituting this into the second equation and solving for ${c}_{2},$ we get ${c}_{2}=8.$ \n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=3\\cdot [\\begin{aligned}2{e}^{-2t} \\\\ {e}^{-2t}\\end{aligned}]+8\\cdot [\\begin{aligned}(2t+1){e}^{-2t} \\\\ (t+1){e}^{-2t}\\end{aligned}]+[\\begin{aligned}\\operatorname{cos}⁡(3t)-2\\operatorname{sin}⁡(3t) \\\\ 3\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡(3t)\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333631" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/activity-metadata.json" "file_sha256" "ad2a51c3104c829087039fd85ba5dc7fe4c610f46a2a25976081cfaa2a1446bb"} {"question" "q-333631" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333631" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333631" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333631" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "8"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333595" "field" nil "attribute" "question/problem" "value" "$$\n{x}^{′}(t)=[\\begin{aligned}1 & 0 \\\\ 0 & 3\\end{aligned}]x(t)+{e}^{-t}[\\begin{aligned}-2 \\\\ 0\\end{aligned}],\\,x(0)=[\\begin{aligned}3 \\\\ 5\\end{aligned}]\n$$\n\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$x(t)=$ \n{{field-1}} \n$\\,\\cdot \\,[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]\\,+$\n{{field-2}}\n$\\,\\cdot \\,[\\begin{aligned}0 \\\\ {e}^{3t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}1 \\\\ 0\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333595" "field" nil "attribute" "question/worked-solution" "value" "We are told that the general solution to the system is \n\n$$\nx(t)={c}_{1}[\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {e}^{3t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}1 \\\\ 0\\end{aligned}]\n$$\n\nwhere ${c}_{1},{c}_{2}$ are constants that are to be determined. \n\nNext, we find the values of ${c}_{1}$ and ${c}_{2}.$ Substituting $t=0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}3 \\\\ 5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}{e}^{0} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ {e}^{3(0)}\\end{aligned}]+{e}^{-0}[\\begin{aligned}1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}3 \\\\ 5\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}1 \\\\ 0\\end{aligned}] & =[\\begin{aligned}3 \\\\ 5\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+1 \\\\ {c}_{2}\\end{aligned}] & =[\\begin{aligned}3 \\\\ 5\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n{\\begin{aligned}{c}_{1}+1=3 \\\\ {c}_{2}=5\\end{aligned}\n$$\n\nFrom the first equation, we get ${c}_{1}=2.$ From the second equation, we have ${c}_{2}=5.$\n\nTherefore, the solution to the initial value problem is\n\n$$\nx(t)=2\\cdot [\\begin{aligned}{e}^{t} \\\\ 0\\end{aligned}]+5\\cdot [\\begin{aligned}0 \\\\ {e}^{3t}\\end{aligned}]+{e}^{-t}[\\begin{aligned}1 \\\\ 0\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333595" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/activity-metadata.json" "file_sha256" "ad2a51c3104c829087039fd85ba5dc7fe4c610f46a2a25976081cfaa2a1446bb"} {"question" "q-333595" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333595" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333595" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "q-333595" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/state.json" "file_sha256" "d822f5cea8e8fa86991ed476fcb4167e10bee94e38be8d6943407c7a7c2b31cb"} {"question" "e-21544" "field" nil "attribute" "question/problem" "value" "$$\n{\\begin{aligned}{x}_{1}^{′}(t)=-2{x}_{1}(t)-{x}_{2}(t)+4{t}^{2}+t-2 \\\\ {x}_{2}^{′}(t)=3{x}_{1}(t)-{t}^{2}+5t+6\\end{aligned}\n$$\n\nWrite the system of linear ODEs in matrix form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21544.json" "file_sha256" "d9a13991d4dece4acc57672a1d55df726480e0408639cbe2ea00f18f7324ef32"} {"question" "e-21544" "field" nil "attribute" "question/worked-solution" "value" "First, let's rewrite our system, highlighting the coefficients:\n\n$$\n{\\begin{aligned}{x}_{1}^{′}(t)=(-2)\\cdot {x}_{1}(t)+(-1)\\cdot {x}_{2}(t)+4\\cdot {t}^{2}+1\\cdot t+(-2) \\\\ {x}_{2}^{′}(t)=3\\cdot {x}_{1}(t)+0\\cdot {x}_{2}(t)+(-1)\\cdot {t}^{2}+5\\cdot t+6\\end{aligned}\n$$\n\nNow, we can write the system in matrix form:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/1247ff4c5147a3d08c411ac0ecdfd6ef56a0683797cfa5a39856a840c129a250.png)\nwhere ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/da94081e0c87897fa4daece41902fb1ae6774725559c687189a9de66160571a4.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21544.json" "file_sha256" "d9a13991d4dece4acc57672a1d55df726480e0408639cbe2ea00f18f7324ef32"} {"question" "e-21543" "field" nil "attribute" "question/problem" "value" "Consider the following inhomogeneous system of linear differential equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/c9810bd07c9da4bd3d803740a85ce484cd92f4a0d8cb73af75d53602f8611a72.png)\nA complementary solution to this system is given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/85139452af923a4f7b793fc47454cb99579ce0fa68ae33de3a15747501f624ef.png)\nThen, the general solution of the system can be written as $\\mathbf{x}(t)=\\mathbf{x}_c(t)+\\mathbf{x}_p(t),$ where $\\mathbf{x}_p(t)$ is a particular solution. Determine the form of the particular solution $\\mathbf{x}_p(t).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21543.json" "file_sha256" "366c2de26613a4161c9f22cc5832d7963233eccad64b1f0f555113548e7201ad"} {"question" "e-21543" "field" nil "attribute" "question/worked-solution" "value" "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\n\\mathbf{x}(t)=\\mathbf{x}_c(t)+\\mathbf{x}_p(t)\n$$\n\nwhere $\\mathbf{x}_c(t)$ is the complementary solution (solution of the corresponding homogeneous system) and $\\mathbf{x}_p(t)$ is a particular solution.\n\nThe forcing term\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/13785393b66b769c10efcbf7cf9f1bb4f05c412a1ddb8649427b659728c7bd3e.png)\nof the inhomogeneous system of ODEs is sinusoidal. Therefore, we assume that the particular solution is also sinusoidal, i.e.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/4b2dbbf0847dc9ea9f438e3848dca79da5f4e3f4473ab325a5f2c48e8b77e98c.png)\nwhere $a_1,a_2,b_1,b_2$ are constants that are to be determined." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21543.json" "file_sha256" "366c2de26613a4161c9f22cc5832d7963233eccad64b1f0f555113548e7201ad"} {"question" "e-21540" "field" nil "attribute" "question/problem" "value" "Consider the following inhomogeneous system of linear differential equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/eaf224db946e02695b83465fa548948a27e7587c7d4b270c604c897cdd4a2228.png)\nThe complementary solution to this system is given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/b7ae867ae694152125bc8cdf1ee7ab34c52b0c050408db3d2da86c7cbbc88493.png)\nFind the general solution of the system." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21540.json" "file_sha256" "367b4bd260109adafba6e0887eb96d2375f443492a3d178d4b2c7e72fdbd0b4b"} {"question" "e-21540" "field" nil "attribute" "question/worked-solution" "value" "Recall that the general solution of an inhomogeneous system can be written as \n\n$$\n\\mathbf{x}(t) = \\mathbf{x}_c(t) + \\mathbf{x}_p(t)\n$$\n\nwhere $\\mathbf{x}_c(t)$ is the complementary solution (solution of the corresponding homogeneous system) and $\\mathbf{x}_p(t)$ is a particular solution.\n\nThe forcing term\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/c68bfa253f23fb2c116b8769744e6fd22b7b898047e3ef3fe97f66dd91fefaa1.png)\nof the inhomogeneous system of ODEs is exponential. Therefore, we assume that the particular solution is also exponential, i.e.\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/b270d56283fdced6971e1a00fc3e642e379fc9348a0e4fb17a97ba6db2d8fc13.png)\nwhere $a,b$ are constants that are to be determined. \n\nCalculating the derivative of $\\mathbf{x}_p$ with respect to $t$ gives\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/ca497159ae72a8b87997c78815119bb3de53782878cb2209072dcc505c902f37.png)\n\nTo find the unknown constants, we substitute $\\mathbf{x}_p$ and $\\mathbf{x}'_p$ into our system:\n\n$$\n\\begin{aligned}7{e}^{7t}[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}]\\cdot {e}^{7t}[\\begin{aligned}a \\\\ b\\end{aligned}]+{e}^{7t}[\\begin{aligned}-1 \\\\ -3\\end{aligned}] \\\\ 7[\\begin{aligned}a \\\\ b\\end{aligned}] & =[\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}]\\cdot [\\begin{aligned}a \\\\ b\\end{aligned}]+[\\begin{aligned}-1 \\\\ -3\\end{aligned}] \\\\ [\\begin{aligned}7a \\\\ 7b\\end{aligned}] & =[\\begin{aligned}3a+b \\\\ b\\end{aligned}]+[\\begin{aligned}-1 \\\\ -3\\end{aligned}] \\\\ [\\begin{aligned}7a \\\\ 7b\\end{aligned}] & =[\\begin{aligned}3a+b-1 \\\\ b-3\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{\\begin{aligned}3a+b-1=7a \\\\ b-3=7b\\end{aligned}\n$$\n\nFrom the second equation, we get \n\n$$\nb - 7b = 3\n\\qquad\\Rightarrow\\qquad\nb = -\\dfrac12.\n$$\n\nSubstituting this into the first equation and solving for $a,$ we have\n\n$$\n3a - \\dfrac12 - 1 = 7a\n\\qquad\\Rightarrow\\qquad\na = -\\dfrac38.\n$$\n\nTherefore, the particular solution is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/fff596d40155dc7787910405557a722b5258890e3fae88f60842de92fac47177.png)\n\nAnd thus, the general solution is given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/dc74c06c84905f8490932369e24cecd8f3b7eb64fdc4413e42c2f8bc1a3f3cbd.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21540.json" "file_sha256" "367b4bd260109adafba6e0887eb96d2375f443492a3d178d4b2c7e72fdbd0b4b"} {"question" "e-21541" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/5b0bb8069abe99949fc52c0be82c22f5879d7ca0ac334af396f47efa41ae0b5e.png)\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/f220005265275c9297b7beef58777203a94351cb4957a26ca630802664759dc5.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21541.json" "file_sha256" "bf0cd0ecbe34af5edfd0f35be1e025d1a28414dbe31c9605d8318507cf074995"} {"question" "e-21541" "field" nil "attribute" "question/worked-solution" "value" "We are told that the general solution to the system is \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/40f93d12ebe4519dc4aa15f0df4b568ffa25f25afd99ec45130b569083c21fe0.png)\nwhere $c_1,c_2$ are constants that are to be determined. \n\nNext, we find the values of $c_1$ and $c_2.$ Substituting $t = 0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}x(0) & =[\\begin{aligned}6 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}{e}^{0} \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0\\cdot {e}^{0} \\\\ {e}^{0}\\end{aligned}]+[\\begin{aligned}{0}^{2}-0+4 \\\\ -{0}^{2}+2\\end{aligned}] & =[\\begin{aligned}6 \\\\ 1\\end{aligned}] \\\\ {c}_{1}[\\begin{aligned}1 \\\\ 0\\end{aligned}]+{c}_{2}[\\begin{aligned}0 \\\\ 1\\end{aligned}]+[\\begin{aligned}4 \\\\ 2\\end{aligned}] & =[\\begin{aligned}6 \\\\ 1\\end{aligned}] \\\\ [\\begin{aligned}{c}_{1}+4 \\\\ {c}_{2}+2\\end{aligned}] & =[\\begin{aligned}6 \\\\ 1\\end{aligned}]\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n{\\begin{aligned}{c}_{1}+4=6 \\\\ {c}_{2}+2=1\\end{aligned}\n$$\n\nFrom the first equation, we get $c_1 = 2.$ From the second equation, we have $c_2 = -1.$\n\nTherefore, the solution to the initial value problem is\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/assets/948088eb5d495f3d8a8a96f038b5b036b53fa398544f9faedbb08026e96b661e.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068256/example-21541.json" "file_sha256" "bf0cd0ecbe34af5edfd0f35be1e025d1a28414dbe31c9605d8318507cf074995"}] "usage" {"e-21541" [] "e-21544" [] "e-21540" [] "q-329268" [] "e-21543" []} "basis" 2290 "retractions" [[17592186167112 :question/problem "${x_{1}^{′}(t) =-x_{1}(t) + 2x_{2}(t) + 3t + 2; x_{2}^{′}(t) = 3x_{1}(t) - x_{2}(t) - t$\nThe systems of linear ODEs above can be written in matrix form as follows:\n\n| $x^{′}(t) =$ |  | {{field-1}} | {{field-2}} |  | $x(t) +$ |  | {{field-3}} |  |  | $t +$ |  | {{field-4}} |  |  |\n| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |\n|  | {{field-5}} | {{field-6}} |  |  | {{field-7}} |  |  | {{field-8}} |  |  |  |  |  |  |\n\n---\n\n<a id=\"complementary-vs-particular-solutions\"></a>"] [17592186166455 :question/problem "${x_{1}^{′}(t) =-2x_{1}(t) - x_{2}(t) + 4t^{2} + t - 2; x_{2}^{′}(t) = 3x_{1}(t) - t^{2} + 5t + 6$\nWrite the system of linear ODEs in matrix form."] [17592186166455 :question/worked-solution "First, let's rewrite our system, highlighting the coefficients:\n\n$$\n{x_{1}^{′}(t) = (-2) \\cdot x_{1}(t) + (-1) \\cdot x_{2}(t) + 4 \\cdot t^{2} + 1 \\cdot t + (-2); x_{2}^{′}(t) = 3 \\cdot x_{1}(t) + 0 \\cdot x_{2}(t) + (-1) \\cdot t^{2} + 5 \\cdot t + 6\n$$\n\nNow, we can write the system in matrix form:\n$\\begin{bmatrix}-2 & -1 \\\\ 3 & 0\\end{bmatrix}$\nwhere $\\begin{bmatrix}x_{1}(t) \\\\ x_{2}(t)\\end{bmatrix}$"] [17592186166454 :question/problem "Consider the following inhomogeneous system of linear differential equations:\n$\\begin{bmatrix}-3 & 6 \\\\ -3 & 3\\end{bmatrix}$\nA complementary solution to this system is given by\n$\\begin{bmatrix}2\\cos (3t) \\\\ \\cos (3t) - \\sin (3t)\\end{bmatrix}$\nThen, the general solution of the system can be written as $\\mathbf{x}(t)=\\mathbf{x}_c(t)+\\mathbf{x}_p(t)$, where $\\mathbf{x}_p(t)$ is a particular solution. Determine the form of the particular solution $\\mathbf{x}_p(t)$."] [17592186166454 :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as\n\n$$\n\\mathbf{x}(t)=\\mathbf{x}_c(t)+\\mathbf{x}_p(t)\n$$\n\nwhere $\\mathbf{x}_c(t)$ is the complementary solution (solution of the corresponding homogeneous system) and $\\mathbf{x}_p(t)$ is a particular solution.\n\nThe forcing term\n$\\begin{bmatrix}-3 \\\\ 2\\end{bmatrix}$\nof the inhomogeneous system of ODEs is sinusoidal. Therefore, we assume that the particular solution is also sinusoidal, i.e.\n$\\begin{bmatrix}a_{1} \\\\ a_{2}\\end{bmatrix}$\nwhere $a_1,a_2,b_1,b_2$ are constants that are to be determined."] [17592186166452 :question/problem "Consider the following inhomogeneous system of linear differential equations:\n$\\begin{bmatrix}3 & 1 \\\\ 0 & 1\\end{bmatrix}$\nThe complementary solution to this system is given by\n$\\begin{bmatrix}e^{3t} \\\\ 0\\end{bmatrix}$\nFind the general solution of the system."] [17592186166452 :question/worked-solution "Recall that the general solution of an inhomogeneous system can be written as\n\n$$\n\\mathbf{x}(t) = \\mathbf{x}_c(t) + \\mathbf{x}_p(t)\n$$\n\nwhere $\\mathbf{x}_c(t)$ is the complementary solution (solution of the corresponding homogeneous system) and $\\mathbf{x}_p(t)$ is a particular solution.\n\nThe forcing term\n$\\begin{bmatrix}-1 \\\\ -3\\end{bmatrix}$\nof the inhomogeneous system of ODEs is exponential. Therefore, we assume that the particular solution is also exponential, i.e.\n$\\begin{bmatrix}a \\\\ b\\end{bmatrix}$\nwhere $a,b$ are constants that are to be determined.\n\nCalculating the derivative of $\\mathbf{x}_p$ with respect to $t$ gives\n$\\begin{bmatrix}a \\\\ b\\end{bmatrix}$\n\nTo find the unknown constants, we substitute $\\mathbf{x}_p$ and $\\mathbf{x}'_p$ into our system:\n\n$$\n\\begin{aligned}\n7e^{7t}\\begin{bmatrix}a \\\\ b\\end{bmatrix} &= \\begin{bmatrix}3 & 1 \\\\ 0 & 1\\end{bmatrix} \\cdot e^{7t}\\begin{bmatrix}a \\\\ b\\end{bmatrix} + e^{7t}\\begin{bmatrix}-1 \\\\ -3\\end{bmatrix} \\\\\n7\\begin{bmatrix}a \\\\ b\\end{bmatrix} &= \\begin{bmatrix}3 & 1 \\\\ 0 & 1\\end{bmatrix} \\cdot \\begin{bmatrix}a \\\\ b\\end{bmatrix} + \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix} \\\\\n\\begin{bmatrix}7a \\\\ 7b\\end{bmatrix} &= \\begin{bmatrix}3a + b \\\\ b\\end{bmatrix} + \\begin{bmatrix}-1 \\\\ -3\\end{bmatrix} \\\\\n\\begin{bmatrix}7a \\\\ 7b\\end{bmatrix} &= \\begin{bmatrix}3a + b - 1 \\\\ b - 3\\end{bmatrix}\n\\end{aligned}\n$$\n\nEquating the corresponding components, we get the following system:\n\n$$\n{3a + b - 1 = 7a; b - 3 = 7b\n$$\n\nFrom the second equation, we get\n\n$$\nb - 7b = 3 \\qquad\\Rightarrow\\qquad b = -\\dfrac12\n$$\n\nSubstituting this into the first equation and solving for $a$, we have\n\n$$\n3a - \\dfrac12 - 1 = 7a \\qquad\\Rightarrow\\qquad a = -\\dfrac38\n$$\n\nTherefore, the particular solution is\n\n$$\n\\begin{bmatrix}-\\frac{3}{8} \\\\ -\\frac{1}{2}\\end{bmatrix}\n$$\n\nAnd thus, the general solution is given by\n\n$$\n\\begin{bmatrix}-\\frac{3}{8} \\\\ -\\frac{1}{2}\\end{bmatrix}\n$$"] [17592186166453 :question/problem "$\\begin{bmatrix}1 & 1 \\\\ 0 & 1\\end{bmatrix}$\nFind the missing coefficients in the solution to the initial value problem, shown above.\n\n$\\begin{bmatrix}e^{t} \\\\ 0\\end{bmatrix}$"] [17592186166453 :question/worked-solution "We are told that the general solution to the system is\n$\\begin{bmatrix}e^{t} \\\\ 0\\end{bmatrix}$\nwhere $c_1,c_2$ are constants that are to be determined.\n\nNext, we find the values of $c_1$ and $c_2$. Substituting $t = 0$ into the general solution, we get the following:\n\n$$\n\\begin{aligned}\nx(0) &= \\begin{bmatrix}6 \\\\ 1\\end{bmatrix} \\\\\nc_{1}\\begin{bmatrix}e^{0} \\\\ 0\\end{bmatrix} + c_{2}\\begin{bmatrix}0 \\cdot e^{0} \\\\ e^{0}\\end{bmatrix} + \\begin{bmatrix}0^{2} - 0 + 4 \\\\ -0^{2} + 2\\end{bmatrix} &= \\begin{bmatrix}6 \\\\ 1\\end{bmatrix} \\\\\nc_{1}\\begin{bmatrix}1 \\\\ 0\\end{bmatrix} + c_{2}\\begin{bmatrix}0 \\\\ 1\\end{bmatrix} + \\begin{bmatrix}4 \\\\ 2\\end{bmatrix} &= \\begin{bmatrix}6 \\\\ 1\\end{bmatrix} \\\\\n\\begin{bmatrix}c_{1} + 4 \\\\ c_{2} + 2\\end{bmatrix} &= \\begin{bmatrix}6 \\\\ 1\\end{bmatrix}\n\\end{aligned}\n$$\n\nSo, we have the following system of linear equations:\n\n$$\n{c_{1} + 4 = 6; c_{2} + 2 = 1\n$$\n\nFrom the first equation, we get $c_1 = 2$. From the second equation, we have $c_2 = -1$.\n\nTherefore, the solution to the initial value problem is\n$\\begin{bmatrix}e^{t} \\\\ 0\\end{bmatrix}$"]] "immutable_answers" [] "immutable_fields" [[17592186164033 :answer-field/id] [17592186164033 :answer-field/key] [17592186164033 :answer-field/type] [17592186164034 :answer-field/id] [17592186164034 :answer-field/key] [17592186164034 :answer-field/type] [17592186164035 :answer-field/id] [17592186164035 :answer-field/key] [17592186164035 :answer-field/type] [17592186164036 :answer-field/id] [17592186164036 :answer-field/key] [17592186164036 :answer-field/type] [17592186164037 :answer-field/id] [17592186164037 :answer-field/key] [17592186164037 :answer-field/type] [17592186164038 :answer-field/id] [17592186164038 :answer-field/key] [17592186164038 :answer-field/type] [17592186164039 :answer-field/id] [17592186164039 :answer-field/key] [17592186164039 :answer-field/type] [17592186164040 :answer-field/id] [17592186164040 :answer-field/key] [17592186164040 :answer-field/type]] "no_history" []}
