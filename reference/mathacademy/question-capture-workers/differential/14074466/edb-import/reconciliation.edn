}⁡t \\\\ \\operatorname{cos}⁡t & =\\sqrt{1-{sin}^{2}⁡t}.\\end{aligned}\n$$\n\nWe used here that $\\operatorname{cos}⁡t>0$ in the range $0<t<\\frac{\\pi }{2}.$\n\nNow, using the definition of a tangent, we obtain\n\n$$\n\\operatorname{tan}⁡t=\\frac{\\operatorname{sin}⁡t}{\\operatorname{cos}⁡t}=\\frac{\\operatorname{sin}⁡t}{\\sqrt{1-{sin}^{2}⁡t}}.\n$$\n\nSubstituting $\\operatorname{sin}⁡t=x$ and $\\operatorname{tan}⁡t=y$ into this formula, we get\n\n$$\ny=\\frac{x}{\\sqrt{1-{x}^{2}}}.\n$$\n\nSo the Cartesian equation of the given curve is $y=\\frac{x}{\\sqrt{1-{x}^{2}}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-15759" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/activity-metadata.json" "file_sha256" "10b8b9755865e721315350edf775fef8f9e2ccfd994248cefe8f9bf65b358023"} {"question" "q-15759" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-15759" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=\\frac{2x}{\\sqrt{2+{x}^{2}}}"] ["math" "y=\\frac{2x}{\\sqrt{{x}^{2}-1}}"] ["math" "y=\\frac{4x}{\\sqrt{1+{x}^{2}}}"] ["math" "y=\\frac{x}{\\sqrt{1-{x}^{2}}}"] ["math" "y=\\frac{x}{\\sqrt{{x}^{2}-4}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-15759" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=\\frac{x}{\\sqrt{1-{x}^{2}}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24378" "field" nil "attribute" "question/problem" "value" "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=2\\operatorname{sin}⁡t,\\,\\,\\,y=3\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24378" "field" nil "attribute" "question/worked-solution" "value" "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=2\\operatorname{sin}⁡t\\, & ⇒\\,\\operatorname{sin}⁡t=\\frac{x}{2} \\\\ y=3\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{3}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & =(1-{sin}^{2}⁡t)-{sin}^{2}⁡t \\\\  & =1-2{sin}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{sin}⁡t=\\frac{x}{2}$ and $\\operatorname{cos}⁡2t=\\frac{y}{3}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{3} & =1-2{(\\frac{x}{2})}^{2} \\\\ \\frac{y}{3} & =1-2(\\frac{{x}^{2}}{4}) \\\\ \\frac{y}{3} & =1-\\frac{{x}^{2}}{2} \\\\ y & =3(1-\\frac{{x}^{2}}{2}).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=3(1-\\frac{{x}^{2}}{2}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24378" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/activity-metadata.json" "file_sha256" "10b8b9755865e721315350edf775fef8f9e2ccfd994248cefe8f9bf65b358023"} {"question" "q-24378" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24378" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=1-\\frac{{x}^{2}}{2}"] ["math" "y=1-\\frac{{x}^{2}}{4}"] ["math" "y=2(1+\\frac{{x}^{2}}{4})"] ["math" "y=3(1+\\frac{{x}^{2}}{4})"] ["math" "y=3(1-\\frac{{x}^{2}}{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24378" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=3(1-\\frac{{x}^{2}}{2})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24575" "field" nil "attribute" "question/problem" "value" "Find the Cartesian equation of the curve defined parametrically as \n\n$$\nx=-3\\operatorname{cos}⁡t,\\,\\,\\,y=4\\operatorname{cos}⁡2t,\\,t\\in [0,2\\pi ).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24575" "field" nil "attribute" "question/worked-solution" "value" "First, let's make the trigonometric functions the subject of each equation:\n\n$$\n\\begin{aligned}x=-3\\operatorname{cos}⁡t\\, & ⇒\\,\\operatorname{cos}⁡t=-\\frac{x}{3} \\\\ y=4\\operatorname{cos}⁡2t\\, & ⇒\\,\\operatorname{cos}⁡2t=\\frac{y}{4}.\\end{aligned}\n$$\n\nNow, using double angle formula for cosine and the Pythagorean identity, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡2t & ={cos}^{2}⁡t-{sin}^{2}⁡t \\\\  & ={cos}^{2}⁡t-(1-{cos}^{2}⁡t) \\\\  & =2{cos}^{2}⁡t-1.\\end{aligned}\n$$\n\nSubstituting $\\operatorname{cos}⁡t=-\\frac{x}{3}$ and $\\operatorname{cos}⁡2t=\\frac{y}{4}$ into this formula, we get\n\n$$\n\\begin{aligned}\\frac{y}{4} & =2{(-\\frac{x}{3})}^{2}-1 \\\\ \\frac{y}{4} & =\\frac{2{x}^{2}}{9}-1 \\\\ y & =4(\\frac{2{x}^{2}}{9}-1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=4(\\frac{2{x}^{2}}{9}-1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24575" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/activity-metadata.json" "file_sha256" "10b8b9755865e721315350edf775fef8f9e2ccfd994248cefe8f9bf65b358023"} {"question" "q-24575" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24575" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=1+\\frac{{x}^{2}}{6}"] ["math" "y=1-\\frac{{x}^{2}}{9}"] ["math" "y=4(\\frac{2{x}^{2}}{9}-1)"] ["math" "y=7(\\frac{{x}^{2}}{9}+1)"] ["math" "y=\\frac{{x}^{2}}{9}-1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-24575" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=4(\\frac{2{x}^{2}}{9}-1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-102668" "field" nil "attribute" "question/problem" "value" "Find the Cartesian equation of the curve defined parametrically by\n\n$$\nx=\\frac{t-5}{2},\\,\\,\\,y=({t}^{2}-25)(t-4),\\,t\\in (-\\infty ,\\infty ).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-102668" "field" nil "attribute" "question/worked-solution" "value" "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\frac{t-5}{2}\\,⇒\\,t=2x+5\\end{aligned}\n$$\n\nNow, substituting $t=2x+5$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =((2x+5)^{2}-25)(2x+5-4) \\\\  & =(4{x}^{2}+20x+25-25)(2x+1) \\\\  & =(4{x}^{2}+20x)(2x+1) \\\\  & =4x(x+5)(2x+1).\\end{aligned}\n$$\n\nSo the Cartesian equation of the given curve is $y=4x(x+5)(2x+1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-102668" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/activity-metadata.json" "file_sha256" "10b8b9755865e721315350edf775fef8f9e2ccfd994248cefe8f9bf65b358023"} {"question" "q-102668" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-102668" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=(2x+1)^{3}"] ["math" "y=2(2x+1)^{3}"] ["math" "y=2x(x-5)(2x+1)"] ["math" "y=4x(2x+1)(2x-5)"] ["math" "y=4x(x+5)(2x+1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-102668" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=4x(x+5)(2x+1)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-321084" "field" nil "attribute" "question/problem" "value" "Consider the curve defined parametrically as\n\n$$\nx=\\sqrt{\\,t+1\\,},\\,\\,\\,y=t(4-t),\\,t\\ge 0.\n$$\n\nThe Cartesian equation of this curve is\n\n$y=$\n{{field-1}}$,\\,x\\ge 1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-321084" "field" nil "attribute" "question/worked-solution" "value" "To find the Cartesian equation, we eliminate $t.$ First, we use the $x$ equation to solve for $t:$\n\n$$\n\\begin{aligned}x=\\sqrt{\\,t+1\\,}\\,⇒\\,t={x}^{2}-1\\end{aligned}\n$$\n\nNow, substituting $t={x}^{2}-1$ into our expression for $y,$ we get\n\n$$\n\\begin{aligned}y & =({x}^{2}-1)(4-({x}^{2}-1)) \\\\  & =({x}^{2}-1)(5-{x}^{2})\\end{aligned}\n$$\n\nSo, the Cartesian equation of the given curve is $y=({x}^{2}-1)(5-{x}^{2}).$\n\nFinally, since $t\\ge 0$ and $t={x}^{2}-1,$ we must have ${x}^{2}-1\\ge 0,$ i.e., $x\\ge 1.$\n\nTherefore, the complete Cartesian equation is $y=({x}^{2}-1)(5-{x}^{2}),\\,x\\ge 1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-321084" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/activity-metadata.json" "file_sha256" "10b8b9755865e721315350edf775fef8f9e2ccfd994248cefe8f9bf65b358023"} {"question" "q-321084" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/state.json" "file_sha256" "dab18387523269122ef994dcb935eb89ef2b1ea8695600158b32705611c365fc"} {"question" "q-321084" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-x^4+6x^2-5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14074466/stat