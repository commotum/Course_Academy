=[\\begin{aligned}5 \\\\ -2-4\\text{i}\\end{aligned}].\n$$\n\nFinally, \n\n$$\n\\begin{aligned}\\frac{{a}_{1}{a}_{2}}{{b}_{1}{b}_{2}} & =\\frac{(5)(5)}{(-2+4\\text{i})(-2-4\\text{i})}=\\frac{5}{4}.\\end{aligned}\n$$" 13194139534833 true] [17592186313342 1000 #edb/ref 17592186313343 13194139534833 true] [17592186313342 1000 #edb/ref 17592186313344 13194139534833 true] [17592186313342 1000 #edb/ref 17592186313345 13194139534833 true] [17592186313342 1000 #edb/ref 17592186313346 13194139534833 true] [17592186313342 1000 #edb/ref 17592186313347 13194139534833 true] [17592186313342 1040 #edb/ref 17592186045450 13194139534833 true] [17592186313342 1041 "selection" 13194139534833 true] [17592186313342 1104 #edb/ref 17592186313346 13194139534833 true] [17592186313342 1110 #uuid "a2f4e12a-3b1a-57d1-ab00-fc0000bea3c7" 13194139534833 true] [17592186313343 1034 "\\frac{4}{5}" 13194139534833 true] [17592186313343 1103 #edb/ref 17592186045453 13194139534833 true] [17592186313343 1111 #uuid "9921d574-2dc7-5723-ba9f-285a546e593a" 13194139534833 true] [17592186313344 1034 "\\frac{1}{4}" 13194139534833 true] [17592186313344 1103 #edb/ref 17592186045453 13194139534833 true] [17592186313344 1111 #uuid "8245439d-c6b3-5fcb-80b4-af49ec7f2e42" 13194139534833 true] [17592186313345 1034 "4" 13194139534833 true] [17592186313345 1103 #edb/ref 17592186045453 13194139534833 true] [17592186313345 1111 #uuid "d906558f-25fc-5767-82b1-eae98d88bae8" 13194139534833 true] [17592186313346 1034 "\\frac{5}{4}" 13194139534833 true] [17592186313346 1103 #edb/ref 17592186045453 13194139534833 true] [17592186313346 1111 #uuid "c210fa92-6b03-5ddb-ab89-cc20a20c2433" 13194139534833 true] [17592186313347 1034 "-2" 13194139534833 true] [17592186313347 1103 #edb/ref 17592186045453 13194139534833 true] [17592186313347 1111 #uuid "d496f189-e88a-5dde-baa2-87abc9bb9a4e" 13194139534833 true]] :edb/tempids {"q-140387" 17592186313257 "q-140387/selection" 17592186313258 "q-140387/selection/681a4b64a7bb464b7f554c4e26477e354