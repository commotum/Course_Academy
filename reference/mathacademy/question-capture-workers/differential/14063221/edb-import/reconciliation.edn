pture-workers/differential/14063221/state.json" "file_sha256" "0a4ed507fc55a22a755e1ee513df96ceee2d9c6956c30559722b866c093f7b57"}] "usage" {"q-340367" []} "basis" 2031 "retractions" [[17592186167213 :question/problem "$⟨f(x), g(x)⟩ = \\displaystyle \\int_{- π}^{π}f(x)g(x)dx$\nGiven the inner product on the set of continuous functions over $[MATH: x ∈ [- π, π)]$ defined above, select the correct options below.\n$⟨\\sin (3x), \\sin (3x)⟩ =$\n{{field-1}}\n\nThe functions $f(x) = \\sin (3x)$ and $g(x) = \\sin (3x)$\n{{field-2}}."]] "immutable_answers" [17592186164839 17592186164840 17592186164842 17592186164843 17592186164844 17592186164845 17592186164846] "immutable_fields" [[17592186164838 :answer-field/correct] [17592186164838 :answer-field/id] [17592186164838 :answer-field/key] [17592186164838 :answer-field/type] [17592186164841 :answer-field/correct] [17592186164841 :answer-field/id] [17592186164841 :answer-field/key] [17592186164841 :answer-field/type]] "no_history" []}
