swer.type/math} :answer/value "1" :db/id #edb/ref 17592186133347} {:answer/id #uuid "a5f8376a-778e-5c85-b36b-6569ca09d3db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{3}" :db/id #edb/ref 17592186133348} {:answer/id #uuid "14c88388-e221-5b54-8dc0-34ca2d827a35" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186133349} {:answer/id #uuid "4c3a24a4-eb3d-51a4-9f78-1ac811078ed6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186133350} {:answer/id #uuid "57a36fb6-39f9-5be6-a938-85d1542f79d5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186133351}] :answer-field/correct {:answer/id #uuid "97f87aab-fa20-5534-ba98-4d817c88f286" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186133347} :answer-field/id #uuid "442d8234-d5d2-57c7-aff2-a9f143ac1c6b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133346}] :question/id #uuid "526aae2e-3eab-5216-b385-aa02beed49e0" :question/math-academy-id "q-98750" :question/problem "Let $V = C[0, 1]$, the vector space of functions that are continuous over $[0, 1]$. Given that the inner product on $V$ is defined as\n\n$⟨x(t), y(t)⟩ = ∫_{0}^{1}x(t)y(t)dt$,\nfind the distance between $f(t) = 2t$ and the subspace spanned by $g(t) = 6t - 3$ with respect to the inner product."}] [{:db/id #edb/ref 17592186134485 :knowledge-point/_questions [{:knowledge-point/id #uuid "25e84fac-02c3-5111-98b3-bc67fe1ec9ab" :knowledge-point/title "Calculating the Distance Between a Vector and a Subspace"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ad9ee5b9-34fa-52c2-9c13-3a818e290502" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186133353} {:answer/id #uuid "b18aaf57-2feb-5258-8a3e-5052fc1e5a7f" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}" :db/id #edb/ref 17592186133354} {:answer/id #uuid "f2bd6ee4-b2ac-577c-ba58-1ea0c20f5da2" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{6}" :db/id #edb/ref 17592186133355} {:answer/id #uuid "634726cc-0770-5bf1-ac97-0be5ee44ff41" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186133356} {:answer/id #uuid "7d153d5e-bc1b-56b5-a356-3a6a8b20de4f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\sqrt{6}" :db/id #edb/ref 17592186133357}] :answer-field/correct {:answer/id #uuid "ad9ee5b9-34fa-52c2-9c13-3a818e290502" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186133353} :answer-field/id #uuid "20e80cd6-5f43-5592-a0a2-7267c3311994" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133352}] :question/id #uuid "19bd0012-8f43-5302-aef7-3199e4a33606" :question/math-academy-id "q-98751" :question/problem "Let $V = C[0, 1]$, the vector space of functions that are continuous over $[0, 1]$. Given that the inner product on $V$ is defined as\n\n$⟨x(t), y(t)⟩ = ∫_{0}^{1}x(t)y(t)dt$,\nfind the distance between $f(t) = 6t$ and $g(t) = 5t^{2}$ with respect to the inner product."}]}
