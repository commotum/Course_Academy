xt{d}t \\\\  & ={\\int }_{0}^{1}24{t}^{3}\\,\\text{d}t \\\\  & =[6{t}^{4}]_{0}^{1} \\\\  & =6-0 \\\\  & =6,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}⟨g(t),g(t)⟩ & ={\\int }_{0}^{1}(6t)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}36{t}^{2}\\,\\text{d}t \\\\  & =[12{t}^{3}]_{0}^{1} \\\\  & =12-0 \\\\  & =12.\\end{aligned}\n$$\n\nTherefore, the projection is\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{6}{12}\\cdot 6t \\\\  & =3t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104583/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df300955-830a-5347-9aeb-2b2b25f865c8"] :knowledge-point/questions ["q-104583"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104587/selection/2bc7413dda3fc032e0501cb31270a0cbacd3d1ca49f8e91a4502d266ed8cf532" :answer/id #uuid "f3a1b73d-bd1f-5102-b76c-fbad970bd85a" :answer/type :answer.type/math :answer/value "t-3" :db/ensure [:answer/validate]} {:db/id "q-104587/selection/218d54f712bc054f6c9d601e905d15b87a336ea46a891ff7011d88794a36731b" :answer/id #uuid "1318c054-7ef2-5f67-bfe0-9aa25705459e" :answer/type :answer.type/math :answer/value "3(t-1)" :db/ensure [:answer/validate]} {:db/id "q-104587/selection/946b908d72463939c14074d8aa85b0bdf478b061a6b79b09569ec789633d33dc" :answer/id #uuid "519d7b21-0ec4-5701-a1fa-860e2f848874" :answer/type :answer.type/math :answer/value "2(t-1)" :db/ensure [:answer/validate]} {:db/id "q-104587/selection/77baf6fcc8dc4d610efea7557c3e7a0eaeff3474a3041467497c38fcb9cf530e" :answer/id #uuid "2938166f-3547-5960-96ab-3b8a5e64559b" :answer/type :answer.type/math :answer/value "{t}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-104587/selection/04c6c7cbbaf1c095377c30dca7810d37f802f893b6fe3ab6d61aad78d1945c5d" :answer/id #uuid "4ecc472e-7f58-5204-8f5a-f35b16bc33f1" :answer/type :answer.type/math :answer/value "3t-1" :db/ensure [:answer/validate]} {:db/id "q-104587/selection" :answer-field/id #uuid "752d89a7-361b-5103-9ff2-6c7bc9001333" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104587/selection/218d54f712bc054f6c9d601e905d15b87a336ea46a891ff7011d88794a36731b" :answer-field/choices ["q-104587/selection/2bc7413dda3fc032e0501cb31270a0cbacd3d1ca49f8e91a4502d266ed8cf532" "q-104587/selection/218d54f712bc054f6c9d601e905d15b87a336ea46a891ff7011d88794a36731b" "q-104587/selection/946b908d72463939c14074d8aa85b0bdf478b061a6b79b09569ec789633d33dc" "q-104587/selection/77baf6fcc8dc4d610efea7557c3e7a0eaeff3474a3041467497c38fcb9cf530e" "q-104587/selection/04c6c7cbbaf1c095377c30dca7810d37f802f893b6fe3ab6d61aad78d1945c5d"] :db/ensure [:answer-field/validate]} {:db/id "q-104587" :question/id #uuid "fd13a1f8-61e0-59b9-98f1-25c67a07e7f8" :question/math-academy-id "q-104587" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the orthogonal projection of $f(t)=12({t}^{2}-t)$ onto the subspace spanned by $g(t)=t-1.$" :question/worked-solution "The orthogonal projection of $f(t)$ onto $\\text{Span}{g(t)}$ is given by\n\n$$\n{\\text{proj}}_{g(t)}\\,f(t)=\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨f(t),g(t)⟩ & ={\\int }_{0}^{1}12({t}^{2}-t)\\cdot (t-1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(12{t}^{3}-24{t}^{2}+12t)\\,\\text{d}t \\\\  & =[3{t}^{4}-8{t}^{3}+6{t}^{2}]_{0}^{1} \\\\  & =(3-8+6)-0 \\\\  & =1,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}⟨g(t),g(t)⟩ & ={\\int }_{0}^{1}(t-1)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}({t}^{2}-2t+1)\\,\\text{d}t \\\\  & =[\\frac{1}{3}{t}^{3}-{t}^{2}+t]_{0}^{1} \\\\  & =(\\frac{1}{3}-1+1)-0 \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$\n\nTherefore, the projection is\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{1}{(\\frac{1}{3})}\\cdot (t-1) \\\\  & =3(t-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104587/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df300955-830a-5347-9aeb-2b2b25f865c8"] :knowledge-point/questions ["q-104587"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104865/selection/5b16d9a9aa5e6121a4ae433e6d754983eca30126646f8b3b0a6c16a79115933e" :answer/id #uuid "04f189f2-391d-5733-8a96-46a11ff2d315" :answer/type :answer.type/math :answer/value "-5(3t-1)" :db/ensure [:answer/validate]} {:db/id "q-104865/selection/77baf6fcc8dc4d610efea7557c3e7a0eaeff3474a3041467497c38fcb9cf530e" :answer/id #uuid "6eb618d0-e6ac-51ce-be3d-ae7d1f4c13aa" :answer/type :answer.type/math :answer/value "{t}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-104865/selection/2531a48c91faaad06b4d8b85cfa7bef83ed899daf17dd1433386d021b7e1cd95" :answer/id #uuid "ec556b9e-e4a5-543e-bcdc-6bc4015a7b6b" :answer/type :answer.type/math :answer/value "-3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-104865/selection/39b017b56d1cad83f630b8dcb14237fe73b501e5fce3946d9ddccf6f1b7aba34" :answer/id #uuid "c145253d-0efc-588c-a5eb-8d2914e4d907" :answer/type :answer.type/math :answer/value "9(3{t}^{2}-1)" :db/ensure [:answer/validate]} {:db/id "q-104865/selection/61f737cc586a731bdfb33ce9737070429c26edf5326fe9d6389fdd513183b323" :answer/id #uuid "be2838d3-ad2d-5ac7-a8d6-be87e8e57fa1" :answer/type :answer.type/math :answer/value "5(3{t}^{2}-1)" :db/ensure [:answer/validate]} {:db/id "q-104865/selection" :answer-field/id #uuid "9e98d763-de02-5c03-b575-35d8592a9722" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104865/selection/61f737cc586a731bdfb33ce9737070429c26edf5326fe9d6389fdd513183b323" :answer-field/choices ["q-104865/selection/5b16d9a9aa5e6121a4ae433e6d754983eca30126646f8b3b0a6c16a79115933e" "q-104865/selection/77baf6fcc8dc4d610efea7557c3e7a0eaeff3474a3041467497c38fcb9cf530e" "q-104865/selection/2531a48c91faaad06b4d8b85cfa7bef83ed899daf17dd1433386d021b7e1cd95" "q-104865/selection/39b017b56d1cad83f630b8dcb14237fe73b501e5fce3946d9ddccf6f1b7aba34" "q-104865/selection/61f737cc586a731bdfb33ce9737070429c26edf5326fe9d6389fdd513183b323"] :db/ensure [:answer-field/validate]} {:db/id "q-104865" :question/id #uuid "3fe7eba6-b1a8-5d8c-8040-6976d04b7758" :question/math-academy-id "q-104865" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the orthogonal projection of $f(t)=16{t}^{3}+2$ onto the subspace spanned by $g(t)=3{t}^{2}-1.$" :question/worked-solution "The orthogonal projection of $f(t)$ onto $\\text{Span}{g(t)}$ is given by\n\n$$\n{\\text{proj}}_{g(t)}\\,f(t)=\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨f(t),g(t)⟩ & ={\\int }_{0}^{1}(16{t}^{3}+2)\\cdot (3{t}^{2}-1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(48{t}^{5}-16{t}^{3}+6{t}^{2}-2)\\,\\text{d}t \\\\  & =[8{t}^{6}-4{t}^{4}+2{t}^{2}-2t]_{0}^{1} \\\\  & =(8-4+2-2)-0 \\\\  & =4,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}⟨g(t),g(t)⟩ & ={\\int }_{0}^{1}(3{t}^{2}-1)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(9{t}^{4}-6{t}^{2}+1)\\,\\text{d}t \\\\  & =[\\frac{9{t}^{5}}{5}-2{t}^{3}+t]_{0}^{1} \\\\  & =(\\frac{9}{5}-2+1)-0 \\\\  & =\\frac{4}{5}.\\end{aligned}\n$$\n\nTherefore, the projection is\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{4}{(\\frac{4}{5})}\\cdot (3{t}^{2}-1) \\\\  & =5(3{t}^{2}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104865/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "df300955-830a-5347-9aeb-2b2b25f865c8"] :knowledge-point/questions ["q-104865"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105400/selection/4c7b99133f942322b97f302956cbba54e2415a04105bc69426a7d254c8ae8ab4" :answer/id #uuid "37718ee6-2568-5e32-a39d-06e5f81e0af9" :answer/type :answer.type/math :answer/value "5t+3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-105400/selection/fc95cef1d9a31ff3ee4ca324dbbf796ac0f0c9e2dfb087807fbf4342ba86854a" :answer/id #uuid "ea40bac0-c077-5558-a30c-0bda680da0d3" :answer/type :answer.type/math :answer/value "15t+5{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-105400/selection/d5ee214fc4ebdb964d67239e3da5811b7c787bb4ef47ec0ccbaa764f05d5fe99" :answer/id #uuid "fdbb785a-a466-5e6c-9b05-5110763a77f1" :answer/type :answer.type/math :answer/value "3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-105400/selection/fcf4113afae86473f269bef29ef8244175cf45eafdeab43db566424e3c03e955" :answer/id #uuid "366a3e6c-1179-52c4-bff7-37fbedd7f96c" :answer/type :answer.type/math :answer/value "15t+3{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-105400/selection/d35578950abd359e9e8019c6874180aad756e222e8a46936da39abaa72a47fbb" :answer/id #uuid "b23676f1-ab7b-5ff8-9d13-ad4d66a02b5b" :answer/type :answer.type/math :answer/value "3t+5{t}^{2}" :db/ensure [:answer/validate]} {:db/id "q-105400/selection" :answer-field/id #uuid "68038974-e290-5ade-8392-b88488e2078f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105400/selection/fc95cef1d9a31ff3ee4ca324dbbf796ac0f0c9e2dfb087807fbf4342ba86854a" :answer-field/choices ["q-105400/selection/4c7b99133f942322b97f302956cbba54e2415a04105bc69426a7d254c8ae8ab4" "q-105400/selection/fc95cef1d9a31ff3ee4ca324dbbf796ac0f0c9e2dfb087807fbf4342ba86854a" "q-105400/selection/d5ee214fc4ebdb964d67239e3da5811b7c787bb4ef47ec0ccbaa764f05d5fe99" "q-105400/selection/fcf4113afae86473f269bef29ef8244175cf45eafdeab43db566424e3c03e955" "q-105400/selection/d35578950abd359e9e8019c6874180aad756e222e8a46936da39abaa72a47fbb"] :db/ensure [:answer-field/validate]} {:db/id "q-105400" :question/id #uuid "e6c5f2f2-7e44-530a-acb6-a43ee50efa44" :question/math-academy-id "q-105400" :question/problem "Let $V=C[-1,1],$ the vector space of continuous functions over $[-1,1]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-1}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$ \n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={t}^{2},\\,g(t)=15t+3\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}$ equals $15t.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=15t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(15t+3)\\cdot {t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}15{t}^{3}+3{t}^{2}\\,\\text{d}t \\\\  & ={[\\frac{15}{4}{t}^{4}+{t}^{3}]}_{-1}^{1} \\\\  & =(\\frac{15}{4}+1)-(\\frac{15}{4}-1) \\\\  & =2,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}⟨{f}_{2}(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}{f}_{2}(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{2}\\cdot {t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}{t}^{4}\\,\\text{d}t \\\\  & ={\\frac{1}{5}{t}^{5}|}_{-1}^{1} \\\\  & =\\frac{1}{5}-(-\\frac{1}{5}) \\\\  & =\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{2}{(\\frac{2}{5})}\\cdot {t}^{2}=5{t}^{2}.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =15t+5{t}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105400/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39692b40-7d68-5ae5-9fe1-0f8b0b2e0d77"] :knowledge-point/questions ["q-105400"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105173/selection/9d0d77e465c391ce134562ce77c112dd5bc50b062365ec507cf65872061fc798" :answer/id #uuid "24776c90-b32b-5bdb-a3e4-efe023656906" :answer/type :answer.type/math :answer/value "-t-4" :db/ensure [:answer/validate]} {:db/id "q-105173/selection/74a97c13a3ca2bd78bdbcea8cba4369b7f9b6a55b90a64b8947f6b2db87e533b" :answer/id #uuid "6d561531-76f6-59f3-a433-ab10416d35b4" :answer/type :answer.type/math :answer/value "-4t+1" :db/ensure [:answer/validate]} {:db/id "q-105173/selection/12543f57e6c7b73eb3af33994543b3f7679b032fcd8ead1caf4795525b22acef" :answer/id #uuid "99dcd642-5fa4-5986-8a64-caafe3586a3e" :answer/type :answer.type/math :answer/value "t-4" :db/ensure [:answer/validate]} {:db/id "q-105173/selection/c29b555dea74fd20c0c3ee1261efa37068e809f45a7c4431d7e38b67c422f764" :answer/id #uuid "0ddef629-bbfa-567b-957c-7b01722117f4" :answer/type :answer.type/math :answer/value "t+4" :db/ensure [:answer/validate]} {:db/id "q-105173/selection/4288615a2a9057157b162694e159812cbe1a4c4b2d93c2dfaf9761159997a3ce" :answer/id #uuid "b33673f1-88af-5c61-a951-a4c3e1b5c796" :answer/type :answer.type/math :answer/value "4t-1" :db/ensure [:answer/validate]} {:db/id "q-105173/selection" :answer-field/id #uuid "5de5af44-6d73-5618-bc98-e2dcc9c1ac82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105173/selection/9d0d77e465c391ce134562ce77c112dd5bc50b062365ec507cf65872061fc798" :answer-field/choices ["q-105173/selection/9d0d77e465c391ce134562ce77c112dd5bc50b062365ec507cf65872061fc798" "q-105173/selection/74a97c13a3ca2bd78bdbcea8cba4369b7f9b6a55b90a64b8947f6b2db87e533b" "q-105173/selection/12543f57e6c7b73eb3af33994543b3f7679b032fcd8ead1caf4795525b22acef" "q-105173/selection/c29b555dea74fd20c0c3ee1261efa37068e809f45a7c4431d7e38b67c422f764" "q-105173/selection/4288615a2a9057157b162694e159812cbe1a4c4b2d93c2dfaf9761159997a3ce"] :db/ensure [:answer-field/validate]} {:db/id "q-105173" :question/id #uuid "6a356727-a0fe-572f-be32-85750e64943b" :question/math-academy-id "q-105173" :question/problem "Let $V={R}_{1}[t],$ the vector space of real polynomials of degree at most $1,$ and let the inner product on $V$ be defined as\n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1).\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{p}_{1}(t)=5t,\\,{p}_{2}(t)=-2t+2,\\,q(t)=-t-4\n$$\n\nFind the orthogonal projection of $q(t)$ onto $S=\\text{Span}{{p}_{1}(t),{p}_{2}(t)}$ given that ${p}_{1}(t)⊥{p}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $q(t)$ onto $\\text{Span}{{p}_{1}(t)}$ equals $-5t.$" :question/worked-solution "Since the set ${{p}_{1}(t),{p}_{2}(t)}$ is orthogonal, the orthogonal projection of $q(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,q(t)={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t).\n$$\n\nWe are given that ${\\text{proj}}_{{p}_{1}(t)}\\,q(t)=-5t,$ so let's now find the orthogonal projection of $q(t)$ onto $\\text{Span}{{p}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{p}_{2}(t)}\\,q(t)=\\frac{⟨q(t),{p}_{2}(t)⟩}{⟨{p}_{2}(t),{p}_{2}(t)⟩}\\,{p}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨q(t),{p}_{2}(t)⟩ & =q(0){p}_{2}(0)+q(1){p}_{2}(1) \\\\  & =(-t-4){|}_{0}\\cdot (-2t+2){|}_{0}+(-t-4){|}_{1}\\cdot (-2t+2){|}_{1} \\\\  & =(-4)\\cdot 2+(-5)\\cdot 0 \\\\  & =-8,\\end{aligned}\n$$\n\n  \n\nand\n\n$$\n\\begin{aligned}⟨{p}_{2}(t),{p}_{2}(t)⟩ & ={p}_{2}(0){p}_{2}(0)+{p}_{2}(1){p}_{2}(1) \\\\  & =(-2t+2)^{2}{|}_{0}+(-2t+2)^{2}{|}_{1} \\\\  & ={2}^{2}+{0}^{2} \\\\  & =4.\\end{aligned}\n$$\n\n  \n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{proj}}_{{p}_{2}(t)}\\,q(t) & =\\frac{-8}{4}\\cdot (-2t+2)=4t-4.\\end{aligned}\n$$\n\n  \n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,q(t) & ={\\text{proj}}_{{p}_{1}(t)}\\,q(t)+{\\text{proj}}_{{p}_{2}(t)}\\,q(t) \\\\  & =-5t+(4t-4) \\\\  & =-t-4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105173/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39692b40-7d68-5ae5-9fe1-0f8b0b2e0d77"] :knowledge-point/questions ["q-105173"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-105416"] :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{sin}⁡t,\\,{f}_{2}(t)=\\operatorname{cos}⁡t,\\,g(t)={sin}^{2}⁡t-\\operatorname{cos}⁡t\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}$ equals $-\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{2}(t)}\\,g(t)=-\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{1}(t)⟩}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\,{f}_{1}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{1}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{1}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while ${sin}^{2}⁡t-\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t({sin}^{2}⁡t-\\operatorname{cos}⁡t)\\,\\text{d}t=0.\n$$\n\n  \n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{1}(t)}\\,g(t)=\\frac{0}{⟨{f}_{1}(t),{f}_{1}(t)⟩}\\cdot \\operatorname{sin}⁡t=0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =0-\\operatorname{cos}⁡t \\\\  & =-\\operatorname{cos}⁡t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-105136/selection/a461d3892c40e94c385b9777e3e8a71925aebe2b717db6c6d9d02fd089afbd05" :answer/id #uuid "cec7a713-7cdc-5693-8ff2-e1f7c6217e64" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1" :db/ensure [:answer/validate]} {:db/id "q-105136/selection/beef43669f14aa1b1bddf0fa212ef65a530d8ae1278667f1098482dd3b1302e8" :answer/id #uuid "80fe6c47-bded-53b6-bcce-7feb8de4f6e4" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t" :db/ensure [:answer/validate]} {:db/id "q-105136/selection/87f9b2daebcdcd9bc772d2ce119e7b839fcdb79075b7fb37270f7b87d66d075e" :answer/id #uuid "75bbe7ac-425d-5752-8e4e-252eb23d028e" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡t+4\\operatorname{sin}⁡t+1" :db/ensure [:answer/validate]} {:db/id "q-105136/selection/3377b2a5e3c4ede75ec205fb2056f8ee42b634c63a514308f7c6914d7e428046" :answer/id #uuid "0fa9c646-b493-55be-a3c4-ec533c355300" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡t-\\operatorname{sin}⁡t" :db/ensure [:answer/validate]} {:db/id "q-105136/selection/3b5cb22c5a560e705c925b00176adf5c503c61a66c159cbaa73356f36ef794bd" :answer/id #uuid "3b7a965b-0a60-5017-8214-996f97e2ea88" :answer/type :answer.type/math :answer/value "4\\operatorname{cos}⁡t+5\\operatorname{sin}⁡t+1" :db/ensure [:answer/validate]} {:db/id "q-105136/selection" :answer-field/id #uuid "03b3a249-0c96-5473-8690-a84f38e6ff86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105136/selection/beef43669f14aa1b1bddf0fa212ef65a530d8ae1278667f1098482dd3b1302e8" :answer-field/choices ["q-105136/selection/a461d3892c40e94c385b9777e3e8a71925aebe2b717db6c6d9d02fd089afbd05" "q-105136/selection/beef43669f14aa1b1bddf0fa212ef65a530d8ae1278667f1098482dd3b1302e8" "q-105136/selection/87f9b2daebcdcd9bc772d2ce119e7b839fcdb79075b7fb37270f7b87d66d075e" "q-105136/selection/3377b2a5e3c4ede75ec205fb2056f8ee42b634c63a514308f7c6914d7e428046" "q-105136/selection/3b5cb22c5a560e705c925b00176adf5c503c61a66c159cbaa73356f36ef794bd"] :db/ensure [:answer-field/validate]} {:db/id "q-105136" :question/id #uuid "f5cfd074-4e95-58da-9317-7b8b6bf8cbb8" :question/math-academy-id "q-105136" :question/problem "Let $V=C[-\\pi ,\\pi ],$ the vector space of continuous functions over $[-\\pi ,\\pi ]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-\\pi }^{\\pi }x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=\\operatorname{cos}⁡t,\\,{f}_{2}(t)=\\operatorname{sin}⁡t,\\,g(t)=5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}$ equals $5\\operatorname{cos}⁡t.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=5\\operatorname{cos}⁡t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-\\pi }^{\\pi }g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-\\pi }^{\\pi }(5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t+1)\\cdot \\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =5{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t+{\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡t$ is an odd function, while $\\operatorname{cos}⁡t$ is even. Hence, their product $\\operatorname{cos}⁡t\\operatorname{sin}⁡t$ must be an odd function. Now, since we have an integral over the interval $[-\\pi ,\\pi ],$ which is symmetric about the origin, we can conclude that\n\n$$\n{\\int }_{-\\pi }^{\\pi }\\operatorname{cos}⁡t\\operatorname{sin}⁡t\\,\\text{d}t={\\int }_{-\\pi }^{\\pi }\\operatorname{sin}⁡t\\,\\text{d}t=0.\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & =-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{proj}}_{{f}_{2}(t)}\\,g(t) & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot \\operatorname{sin}⁡t \\\\  & =\\frac{-4{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}{{\\int }_{-\\pi }^{\\pi }{sin}^{2}⁡t\\,\\text{d}t}\\cdot \\operatorname{sin}⁡t \\\\  & =-4\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =5\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105136/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39692b40-7d68-5ae5-9fe1-0f8b0b2e0d77"] :knowledge-point/questions ["q-105136"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105162/selection/fd9ca1cffa6c209ad15d1b41275c6e3e6bad8553b556d2cb6c937eaaac748dec" :answer/id #uuid "3d147174-af74-51fb-ae8b-ced94b4ba111" :answer/type :answer.type/math :answer/value "3t" :db/ensure [:answer/validate]} {:db/id "q-105162/selection/4da76e5d4d9e03476988fa262c78bdc1cfe925db21f546f98690efd6e418bc24" :answer/id #uuid "f82d6982-4fb8-52f3-a24e-8736d338b47f" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡\\pi t" :db/ensure [:answer/validate]} {:db/id "q-105162/selection/942ab4f8e2d67ad8c88fa6e85cff013030f1398d4daaa5217fc12f299e7c9f26" :answer/id #uuid "76be5757-02f7-5d18-ad1a-078740bdb63f" :answer/type :answer.type/math :answer/value "t\\pi \\operatorname{sin}⁡\\pi t" :db/ensure [:answer/validate]} {:db/id "q-105162/selection/f4407c97cb87a2a553d56b156e8fdd2e79be0f7f96a4bed81a5fe88bbd5d3ab5" :answer/id #uuid "0642bf24-5352-5911-b934-cf9b0d0676f9" :answer/type :answer.type/math :answer/value "\\pi \\operatorname{sin}⁡\\pi t+t" :db/ensure [:answer/validate]} {:db/id "q-105162/selection/6f05d282e8d3e933c6b199a279c5489735364343760d017efa65c0c60b055592" :answer/id #uuid "f5ac8701-ccc2-515b-816a-7a2aa31a0582" :answer/type :answer.type/math :answer/value "2{t}^{2}+3t" :db/ensure [:answer/validate]} {:db/id "q-105162/selection" :answer-field/id #uuid "24c268ec-8c6b-5d73-bf9a-155056132b1f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105162/selection/fd9ca1cffa6c209ad15d1b41275c6e3e6bad8553b556d2cb6c937eaaac748dec" :answer-field/choices ["q-105162/selection/fd9ca1cffa6c209ad15d1b41275c6e3e6bad8553b556d2cb6c937eaaac748dec" "q-105162/selection/4da76e5d4d9e03476988fa262c78bdc1cfe925db21f546f98690efd6e418bc24" "q-105162/selection/942ab4f8e2d67ad8c88fa6e85cff013030f1398d4daaa5217fc12f299e7c9f26" "q-105162/selection/f4407c97cb87a2a553d56b156e8fdd2e79be0f7f96a4bed81a5fe88bbd5d3ab5" "q-105162/selection/6f05d282e8d3e933c6b199a279c5489735364343760d017efa65c0c60b055592"] :db/ensure [:answer-field/validate]} {:db/id "q-105162" :question/id #uuid "c07bc9ef-08f9-5b31-9daf-46f1ad215cf8" :question/math-academy-id "q-105162" :question/problem "Let $V=C[-1,1],$ the vector space of continuous functions over $[-1,1]$, and let the inner product on $V$ be defined as\n\n$$\n⟨x(t),y(t)⟩={\\int }_{-1}^{1}x(t)y(t)\\,\\text{d}t.\n$$\n\nNow consider the following elements of $V:$\n\n$$\n{f}_{1}(t)=t,\\,{f}_{2}(t)={t}^{2},\\,g(t)=\\pi \\operatorname{sin}⁡(\\pi t)\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}{{f}_{1}(t),{f}_{2}(t)}$ given that ${f}_{1}(t)⊥{f}_{2}(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{1}(t)}$ equals $3t.$" :question/worked-solution "Since the set ${{f}_{1}(t),{f}_{2}(t)}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n{\\text{proj}}_{S}\\,g(t)={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t).\n$$\n\nWe are given that ${\\text{proj}}_{{f}_{1}(t)}\\,g(t)=3t,$ so let's now find the orthogonal projection of $g(t)$ onto $\\text{Span}{{f}_{2}(t)}.$ This can be computed as\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{⟨g(t),{f}_{2}(t)⟩}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\,{f}_{2}(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}(\\pi \\operatorname{sin}⁡(\\pi t))\\cdot {t}^{2}\\,\\text{d}t \\\\  & =\\pi {\\int }_{-1}^{1}{t}^{2}\\operatorname{sin}⁡(\\pi t)\\,\\text{d}t\\end{aligned}\n$$\n\nNotice that $\\operatorname{sin}⁡(\\pi t)$ is an odd function, while ${t}^{2}$ is even. Hence, their product ${t}^{2}\\operatorname{sin}⁡(\\pi t)$ must be an odd function. Now, since we have an integral over the interval $[-1,1],$ which is symmetric about the origin, we can conclude that\n\n$$\n\\pi {\\int }_{-1}^{1}{t}^{2}\\operatorname{sin}⁡(\\pi t)\\,\\text{d}t=0.\n$$\n\n  \n\nTherefore,\n\n$$\n{\\text{proj}}_{{f}_{2}(t)}\\,g(t)=\\frac{0}{⟨{f}_{2}(t),{f}_{2}(t)⟩}\\cdot {t}^{2}=0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =3t+0 \\\\  & =3t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-105162/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39692b40-7d68-5ae5-9fe1-0f8b0b2e0d77"] :knowledge-point/questions ["q-105162"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-98750"] :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=2t$ and the subspace spanned by $g(t)=6t-3$ with respect to the inner product." :question/worked-solution "The orthogonal projection of $f(t)$ onto $\\text{Span}{g(t)}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{g(t)}\\,f(t) & =\\frac{⟨f(t),g(t)⟩}{⟨g(t),g(t)⟩}\\,g(t) \\\\  & =\\frac{{\\int }_{0}^{1}2t\\cdot (6t-3)\\,\\text{d}t}{{\\int }_{0}^{1}(6t-3)^{2}\\,\\text{d}t}\\cdot (6t-3) \\\\  & =\\frac{{\\int }_{0}^{1}(12{t}^{2}-6t)\\,\\text{d}t}{{\\int }_{0}^{1}(36{t}^{2}-36t+9)\\,\\text{d}t}\\cdot (6t-3) \\\\  & =\\frac{{[4{t}^{3}-3{t}^{2}]}_{0}^{1}}{{[12{t}^{3}-18{t}^{2}+9t]}_{0}^{1}}\\cdot (6t-3) \\\\  & =\\frac{(4-3)-0}{(12-18+9)-0}\\cdot (6t-3) \\\\  & =\\frac{1}{3}\\cdot (6t-3) \\\\  & =2t-1.\\end{aligned}\n$$\n\nThe distance between $f(t)=2t$ and the subspace spanned by $g(t)=6t-3$ with respect to our inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-{\\text{proj}}_{g(t)}\\,f(t)‖ \\\\  & =‖2t-(2t-1)‖ \\\\  & =‖1‖ \\\\  & =\\sqrt{⟨1,1⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨1,1⟩ & ={\\int }_{0}^{1}1\\cdot 1\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\,\\text{d}t \\\\  & =t{|}_{0}^{1} \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{1}=1.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-105461/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "aa68039c-6722-50d3-a689-f3b2aed812ff" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-105461/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "5dfa2e25-81ce-5924-970a-96d2a18faa26" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-105461/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "8fc85b12-a821-5c07-94ec-cb320f330f46" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-105461/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "06c483de-f06a-54b1-a94a-580debc19ab7" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-105461/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "9ce71407-c2ca-5832-a64c-511575a71f6c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-105461/selection" :answer-field/id #uuid "f4e2d9bf-7e45-574a-9a72-53ef3116396c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105461/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-105461/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-105461/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-105461/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-105461/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" "q-105461/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-105461" :question/id #uuid "9e6e65b2-e2c1-500c-950b-259a5f8738be" :question/math-academy-id "q-105461" :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=3t$ and $g(t)=-3t+3$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=3t$ and $g(t)=-3t+3$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖3t-(-3t+3)‖ \\\\  & =‖6t-3‖ \\\\  & =\\sqrt{⟨6t-3,6t-3⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨6t-3,6t-3⟩ & ={\\int }_{0}^{1}(6t-3)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(36{t}^{2}-36t+9)\\text{d}t \\\\  & =[12{t}^{3}-18{t}^{2}+9t]_{0}^{1} \\\\  & =(12-18+9)-0 \\\\  & =3.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{3}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105461/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "25e84fac-02c3-5111-98b3-bc67fe1ec9ab"] :knowledge-point/questions ["q-105461"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105492/selection/4ef0fcc340e40ad6bcef1c832215cd28abf240aabeed43296dfece28d20d1935" :answer/id #uuid "385ae02c-d710-5c03-b4c4-02603877b199" :answer/type :answer.type/math :answer/value "\\sqrt{10}" :db/ensure [:answer/validate]} {:db/id "q-105492/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "a1c520b3-378f-5b1c-9c0c-5ca24387d3cb" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-105492/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "4967ee0d-f59b-5f2b-80b2-6a5b12837c43" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-105492/selection/d7a2eed6f1a0ddde34dda83c2eff63b490d1c46926c189e70f393bd730e4d502" :answer/id #uuid "2665c87f-e290-529d-89a1-17e1f255411b" :answer/type :answer.type/math :answer/value "\\sqrt{15}" :db/ensure [:answer/validate]} {:db/id "q-105492/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "f1b43892-717e-51e6-a2d8-9a8b2d0f215e" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-105492/selection" :answer-field/id #uuid "2998dfd0-6d17-5290-8d22-0c7bb51c0c3d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105492/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-105492/selection/4ef0fcc340e40ad6bcef1c832215cd28abf240aabeed43296dfece28d20d1935" "q-105492/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-105492/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" "q-105492/selection/d7a2eed6f1a0ddde34dda83c2eff63b490d1c46926c189e70f393bd730e4d502" "q-105492/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-105492" :question/id #uuid "3aec81d0-b348-5e41-ba67-b3252693dfb4" :question/math-academy-id "q-105492" :question/problem "Let $V={R}_{1}[t],$ the vector space of polynomials of degree at most $1$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(0)q(0)+p(1)q(1),\n$$\n\nfind the distance between $f(t)=5t$ and $g(t)=7t-8$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=5t$ and $g(t)=7t-8$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖5t-(7t-8)‖ \\\\  & =‖-2t+8‖ \\\\  & =\\sqrt{⟨-2t+8,-2t+8⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨-2t+8,-2t+8⟩ & =(-2t+8){|}_{0}\\cdot (-2t+8){|}_{0}+(-2t+8){|}_{1}\\cdot (-2t+8){|}_{1} \\\\  & =8\\cdot 8+6\\cdot 6 \\\\  & =100.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{100}=10.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105492/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "25e84fac-02c3-5111-98b3-bc67fe1ec9ab"] :knowledge-point/questions ["q-105492"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-98751"] :question/problem "Let $V=C[0,1],$ the vector space of functions that are continuous over $[0,1].$ Given that the inner product on $V$ is defined as \n\n$$\n⟨x(t),y(t)⟩={\\int }_{0}^{1}x(t)y(t)\\,\\text{d}t,\n$$\n\nfind the distance between $f(t)=6t$ and $g(t)=5{t}^{2}$ with respect to the inner product." :question/worked-solution "The distance between $f(t)=6t$ and $g(t)=5{t}^{2}$ with respect to the given inner product is\n\n$$\n\\begin{aligned}d & =‖f(t)-g(t)‖ \\\\  & =‖6t-5{t}^{2}‖ \\\\  & =‖5{t}^{2}-6t‖ \\\\  & =\\sqrt{⟨5{t}^{2}-6t,5{t}^{2}-6t⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨5{t}^{2}-6t,5{t}^{2}-6t⟩ & ={\\int }_{0}^{1}(5{t}^{2}-6t)^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(25{t}^{4}-60{t}^{3}+36{t}^{2})\\text{d}t \\\\  & =[5{t}^{5}-15{t}^{4}+12{t}^{3}]_{0}^{1} \\\\  & =(5-15+12)-0 \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{2}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-105494/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "732ee3bd-8c0a-551e-ab05-b2efa5cedba1" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-105494/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "fe6ee12f-1223-55a0-aeb4-f87a3e2e3cc2" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-105494/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "29d97a5d-9e4a-5692-ac7e-c79b1797a2dc" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-105494/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "cd395293-0d16-5163-94cc-bb265ab83dc2" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-105494/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d519eac8-d7a1-5bf5-bf48-fac18a99108a" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-105494/selection" :answer-field/id #uuid "c87e86e6-e8d0-51e8-bf93-3336aecaeb74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105494/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-105494/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-105494/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-105494/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-105494/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-105494/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-105494" :question/id #uuid "427e7cc7-9f36-51c5-83a8-b85a2e8396b2" :question/math-academy-id "q-105494" :question/problem "Let $V={R}_{2}[t],$ the vector space of polynomials of degree at most $2$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n⟨p(t),q(t)⟩=p(-1)q(-1)+p(0)q(0)+p(1)q(1),\n$$\n\nfind the distance between $p(t)=7{t}^{2}-t$ and the subspace spanned by $q(t)=4{t}^{2}-4t$ with respect to the inner product." :question/worked-solution "The orthogonal projection of $p(t)$ onto $\\text{Span}{q(t)}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{q(t)}\\,p(t) & =\\frac{⟨p(t),q(t)⟩}{⟨q(t),q(t)⟩}\\,q(t) \\\\  & =\\frac{p(-1)q(-1)+p(0)q(0)+p(1)q(1)}{q(-1)q(-1)+q(0)q(0)+q(1)q(1)}\\cdot q(t) \\\\  & =\\frac{{\\sum }_{i\\in {-1,0,1}}(7{t}^{2}-t){|}_{t=i}\\cdot (4{t}^{2}-4t){|}_{t=i}}{{\\sum }_{i\\in {-1,0,1}}(4{t}^{2}-4t){|}_{t=i}\\cdot (4{t}^{2}-4t){|}_{t=i}}\\cdot (4{t}^{2}-4t) \\\\  & =\\frac{8\\cdot 8+0\\cdot 0+6\\cdot 0}{8\\cdot 8+0\\cdot 0+0\\cdot 0}\\cdot (4{t}^{2}-4t) \\\\  & =\\frac{64}{64}\\cdot (4{t}^{2}-4t) \\\\  & =4{t}^{2}-4t.\\end{aligned}\n$$\n\n \n\nThe distance between $p(t)=7{t}^{2}-t$ and the subspace spanned by $q(t)=4{t}^{2}-4t$ with respect to our inner product is\n\n$$\n\\begin{aligned}d & =‖p(t)-{\\text{proj}}_{q(t)}\\,p(t)‖ \\\\  & =‖7{t}^{2}-t-(4{t}^{2}-4t)‖ \\\\  & =‖3{t}^{2}+3t‖ \\\\  & =\\sqrt{⟨3{t}^{2}+3t,3{t}^{2}+3t⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨3{t}^{2}+3t,3{t}^{2}+3t⟩ & ={\\sum }_{i\\in {-1,0,1}}(3{t}^{2}+3t){|}_{t=i}\\cdot (3{t}^{2}+3t){|}_{t=i} \\\\  & =0\\cdot 0+0\\cdot 0+6\\cdot 6 \\\\  & =0+0+36 \\\\  & =36.\\end{aligned}\n$$\n\nTherefore, the distance is $d=\\sqrt{36}=6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105494/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "25e84fac-02c3-5111-98b3-bc67fe1ec9ab"] :knowledge-point/questions ["q-105494"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8729"] :question/problem "Let $V = \\Bbb R_1[t],$ the vector space of polynomials of degree at most $1$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n\\langle p(t),q(t) \\rangle = p(0)q(0)+p(1)q(1),\n$$\n\nfind the orthogonal projection of $p(t)=-5t-3$ onto the subspace spanned by the polynomial $q(t) =t-1.$" :question/worked-solution "The orthogonal projection of $p(t)$ onto $\\textrm{Span}\\{ q(t) \\}$ is given by\n\n$$\n\\textrm{proj}_{q(t)}\\,p(t) \n= \\dfrac{\\langle{p(t),q(t)}\\rangle}{\\langle{q(t),q(t)}\\rangle}\\,q(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨p(t),q(t)⟩ & =p(0)q(0)+p(1)q(1) \\\\  & =(-5t-3){|}_{0}\\cdot (t-1){|}_{0}+(-5t-3){|}_{1}\\cdot (t-1){|}_{1} \\\\  & =(-3)\\cdot (-1)+(-8)\\cdot 0 \\\\  & =3+0 \\\\  & =3,\\end{aligned}\n$$\n\n \n\nand\n\n$$\n\\begin{aligned}⟨q(t),q(t)⟩ & =q(0)q(0)+q(1)q(1) \\\\  & =(t-1){|}_{0}\\cdot (t-1){|}_{0}+(t-1){|}_{1}\\cdot (t-1){|}_{1} \\\\  & =(-1)\\cdot (-1)+0\\cdot 0 \\\\  & =1+0 \\\\  & =1.\\end{aligned}\n$$\n\n \n\nTherefore, the projection is\n\n$$\n\\begin{aligned}{\\text{proj}}_{q(t)}\\,p(t) & =\\frac{⟨p(t),q(t)⟩}{⟨q(t),q(t)⟩}\\,q(t) \\\\  & =\\frac{3}{1}\\cdot (t-1) \\\\  & =3(t-1).\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8730"] :question/problem "Let $V = \\mathcal{C}[-1,1],$ the vector space of continuous functions over $[-1,1]$, and let the inner product on $V$ be defined as\n\n$$\n\\langle x(t),y(t) \\rangle =\\int_{-1}^{1} x(t) y(t) \\, \\text{d}t.\n$$\n\nNow consider the following elements of $V\\mathbin{:}$\n\n$$\nf_1(t)=1,\\quad f_2(t)=\\sin \\pi t, \\quad g(t)=6t^2\n$$\n\nFind the orthogonal projection of $g(t)$ onto $S=\\text{Span}\\{f_1(t), f_2(t)\\}$ given that $f_1(t) \\perp f_2(t)$ with respect to the inner product, and that the orthogonal projection of $g(t)$ onto $\\textrm{Span}\\{f_1(t)\\}$ equals $2.$" :question/worked-solution "Since the set $\\{f_1(t),f_2(t)\\}$ is orthogonal, the orthogonal projection of $g(t)$ onto the subspace $S$ is given by\n\n$$\n\\textrm{proj}_{S}\\,g(t) \n= \\textrm{proj}_{f_1(t)}\\,g(t) + \\textrm{proj}_{f_2(t)}\\,g(t).\n$$\n\nWe are given that $\\textrm{proj}_{f_1(t)}\\,g(t) = 2,$ so let's now find the orthogonal projection of $g(t)$ onto $\\textrm{Span}\\{f_2(t)\\}.$ This can be computed as\n\n$$\n\\textrm{proj}_{f_2(t)}\\,g(t) \n= \\dfrac{\\langle{g(t),f_2(t)}\\rangle}{\\langle{f_2(t),f_2(t)}\\rangle}\\,f_2(t).\n$$\n\n \n\nIn our case, we have\n\n$$\n\\begin{aligned}⟨g(t),{f}_{2}(t)⟩ & ={\\int }_{-1}^{1}g(t){f}_{2}(t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}6{t}^{2}\\cdot \\operatorname{sin}⁡(\\pi t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}6{t}^{2}\\operatorname{sin}⁡(\\pi t)\\,\\text{d}t.\\end{aligned}\n$$\n\nNotice that $\\sin (\\pi t)$ is an odd function, while $6t^2$ is even. Hence, their product $6 t^2 \\sin (\\pi t)$ must be an odd function. Now, since we have an integral over the interval $[-1,1],$ which is symmetric about the origin, we can conclude that\n\n$$\n\\int_{-1}^{1}   6t^2 \\sin (\\pi t) \\, \\text{d}t = 0.\n$$\n\n  \n\nTherefore,\n\n$$\n\\textrm{proj}_{f_2(t)}\\,g(t) = \\dfrac{0}{\\langle{f_2(t),f_2(t)}\\rangle} \\cdot  \\sin \\pi t = 0.\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{\\text{proj}}_{S}\\,g(t) & ={\\text{proj}}_{{f}_{1}(t)}\\,g(t)+{\\text{proj}}_{{f}_{2}(t)}\\,g(t) \\\\  & =2+0 \\\\  & =2.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8733"] :question/problem "Let $V = \\Bbb R_1[t],$ the vector space of polynomials of degree at most $1$ with real coefficients. Given that the inner product on $V$ is defined as \n\n$$\n\\langle p(t), q(t) \\rangle = p(0)q(0) + p(1)q(1),\n$$\n\nfind the distance between $p(t) = 4t + 2$ and the subspace spanned by $q(t) = t$ with respect to the inner product." :question/worked-solution "The orthogonal projection of $p(t)$ onto $\\textrm{Span}\\{ q(t) \\}$ is given by\n\n$$\n\\begin{aligned}{\\text{proj}}_{q(t)}\\,p(t) & =\\frac{⟨p(t),q(t)⟩}{⟨q(t),q(t)⟩}\\,q(t) \\\\  & =\\frac{p(0)q(0)+p(1)q(1)}{q(0)^{2}+q(1)^{2}}\\cdot q(t) \\\\  & =\\frac{(2)(0)+(6)(1)}{{0}^{2}+{1}^{2}}\\cdot t \\\\  & =6t.\\end{aligned}\n$$\n\nThe distance between $p(t) = 4t + 2$ and the subspace spanned by $q(t) = t$ with respect to our inner product is\n\n$$\n\\begin{aligned}d & =‖p(t)-{\\text{proj}}_{q(t)}\\,p(t)‖ \\\\  & =‖(4t+2)-6t‖ \\\\  & =‖-2t+2‖ \\\\  & =\\sqrt{⟨-2t+2,\\text{ }-2t+2⟩}.\\end{aligned}\n$$\n\nComputing the inner product, we get\n\n$$\n\\begin{aligned}⟨-2t+2,\\text{ }-2t+2⟩ & =(-2t+2){|}_{0}\\cdot (-2t+2){|}_{0}+(-2t+2){|}_{1}\\cdot (-2t+2){|}_{1} \\\\  & =(-2(0)+2)^{2}+(-2(1)+2)^{2} \\\\  & ={2}^{2}+{0}^{2} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore, the distance is $d = \\sqrt{4} = 2.$" :db/ensure [:question/validate]}]
