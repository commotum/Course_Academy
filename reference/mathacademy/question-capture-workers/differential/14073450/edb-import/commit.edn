aligned}\\frac{3}{5} \\\\ -\\frac{4}{5}\\end{aligned}]\\end{aligned}\n$$\n\nFinally, the solution to our initial value problem is given by\n\n$$\n\\begin{aligned}\\text{x}(t) & =\\frac{3}{5}[\\begin{aligned}-2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ 5\\operatorname{cos}⁡t\\end{aligned}]{e}^{2t}-\\frac{4}{5}[\\begin{aligned}\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t \\\\ 5\\operatorname{sin}⁡t\\end{aligned}]{e}^{2t} \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡t-2\\operatorname{cos}⁡t \\\\ 3\\operatorname{cos}⁡t-4\\operatorname{sin}⁡t\\end{aligned}]{e}^{2t}.\\end{aligned}\n$$" 13194139536002 true] [17592186378986 1000 #edb/ref 17592186378987 13194139536002 true] [17592186378986 1000 #edb/ref 17592186378988 13194139536002 true] [17592186378986 1000 #edb/ref 17592186378989 13194139536002 true] [17592186378986 1000 #edb/ref 17592186378990 13194139536002 true] [17592186378986 1000 #edb/ref 17592186378991 13194139536002 true] [17592186378986 1040 #edb/ref 17592186045450 13194139536002 true] [17592186378986 1041 "selection" 13194139536002 true] [17592186378986 1104 #edb/ref 17592186378990 13194139536002 true] [17592186378986 1110 #uuid "d4de7ef6-9bff-58f8-a6d2-7ffadc76bdd7" 13194139536002 true] [17592186378987 1034 "\\text{x}(t)=[\\begin{aligned}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}]" 13194139536002 true] [17592186378987 1103 #edb/ref 17592186045453 13194139536002 true] [17592186378987 1111 #uuid "1ace0ca8-c885-5465-95e7-49f465c89f42" 13194139536002 true] [17592186378988 1034 "\\text{x}(t)=[\\begin{aligned}3\\operatorname{sin}⁡t+\\operatorname{cos}⁡t \\\\ 2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}]" 13194139536002 true] [17592186378988 1103 #edb/ref 17592186045453 13194139536002 true] [17592186378988 1111 #uuid "5be9126a-ad88-533b-8774-1da843f52ff3" 13194139536002 true] [17592186378989 1034 "\\text{x}(t)=[\\begin{aligned}\\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ -\\opera