{:edb/committed true :edb/basis-t 1886 :edb/replayed false :edb/tx-hash "534f757c17618eb2d0f2e6dfd89950681098b970a13120727eb64d20f7e65df0" :edb/db-before-t 1885 :edb/db-after-t 1886 :edb/tx-data [[13194139535198 50 #inst "2026-10-08T19:19:02.975Z" 13194139535198 true] [17592186179461 1100 "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C (x^2+y)\\,\\mathrm{d}x + x\\,\\mathrm{d}y$, where $C$ is parametrized by $\\mathbf{r}(t) = t\\,\\mathbf{i} + t^2\\,\\mathbf{j}$ for $t\\in\\left[0,1\\right]$." 13194139535198 false] [17592186179461 1100 "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C (x^2+y)\\,\\mathrm{d}x + x\\,\\mathrm{d}y,$ where $C$ is parametrized by $\\mathbf{r}(t) = t\\,\\mathbf{i} + t^2\\,\\mathbf{j}$ for $t\\in\\left[0,1\\right].$" 13194139535198 true] [17592186179461 1145 "Along the curve, we have\n\n$$\nx(t) = t, \\qquad\ny(t) = t^2.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j \\\\  & =i+2t\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+y)\\,dx+x\\,dy & ={\\int }_{0}^{1}({x}^{2}+y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(({x}^{2}+y)\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{1}({t}^{2}+{t}^{2})\\cdot 1+t\\cdot 2t\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}2{t}^{2}+2{t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}4{t}^{2}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t\\end{aligned}\n$$" 13194139535198 true] [17592186179461 1145 "Along the curve, we have\n\n$$\nx(t) = t, \\qquad y(t) = t^2\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}\nr^{′}(t) &= \\frac{dx}{dt}i + \\frac{dy}{dt}j \\\\\n&= \\frac{d}{dt}(t)i + \\frac{d}{dt}(t^{2})j \\\\\n&= i + 2tj\n\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}\n∫_(C)(x^{2} + y)dx + xdy &= ∫_{0}^{1}(x^{2} + y)\\frac{dx}{dt}dt + x\\frac{dy}{dt}dt \\\\\n&= ∫_{0}^{1}((x^{2} + y)\\frac{dx}{dt} + x\\frac{dy}{dt})dt \\\\\n&= ∫_{0}^{1}(t^{2} + t^{2}) \\cdot 1 + t \\cdot 2tdt \\\\\n&= ∫_{0}^{1}2t^{2} + 2t^{2}dt \\\\\n&= ∫_{0}^{1}4t^{2}dt \\\\\n&= 4∫_{0}^{1}t^{2}dt\n\\end{aligned}\n$$" 13194139535198 false] [17592186179521 1100 "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C x^3\\,\\mathrm{d}x + z\\,\\mathrm{d}y + y\\,\\mathrm{d}z$, where $C$ is a portion of the helix $\\mathbf{r}(t)=2t\\,\\mathbf{i} + \\cos t\\,\\mathbf{j} + \\sin t\\,\\mathbf{k}$ for $t\\in[0,\\pi]$?" 13194139535198 false] [17592186179521 1100 "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C x^3\\,\\mathrm{d}x + z\\,\\mathrm{d}y + y\\,\\mathrm{d}z,$ where $C$ is a portion of the helix $\\mathbf{r}(t)=2t\\,\\mathbf{i} + \\cos t\\,\\mathbf{j} + \\sin t\\,\\mathbf{k}$ for $t\\in[0,\\pi]?$" 13194139535198 true] [17592186179521 1145 "Along the curve, we have\n\n$$\nx(t) =2t, \\qquad \ny(t) = \\cos t , \\qquad \nz(t) = \\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =2\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}\\,dx+z\\,dy+y\\,dz & ={\\int }_{0}^{\\pi }{x}^{3}\\frac{\\text{d}x}{\\text{d}t}\\,dt+z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }({x}^{3}\\frac{\\text{d}x}{\\text{d}t}+z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }(2t)^{3}\\cdot (2)+\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot (\\operatorname{cos}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}-{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+({cos}^{2}⁡t-{sin}^{2}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+\\operatorname{cos}⁡2t\\,dt\\end{aligned}\n$$" 13194139535198 true] [17592186179521 1145 "Along the curve, we have\n\n$$\nx(t) =2t, \\qquad y(t) = \\cos t, \\qquad z(t) = \\sin t\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}\nr^{′}(t) &= \\frac{dx}{dt}i + \\frac{dy}{dt}j + \\frac{dz}{dt}k \\\\\n&= \\frac{d}{dt}(2t)i + \\frac{d}{dt}(\\cos t)j + \\frac{d}{dt}(\\sin t)k \\\\\n&= 2i - \\sin tj + \\cos tk\n\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}\n∫_(C)x^{3}dx + zdy + ydz &= ∫_{0}^{π}x^{3}\\frac{dx}{dt}dt + z\\frac{dy}{dt}dt + y\\frac{dz}{dt}dt \\\\\n&= ∫_{0}^{π}(x^{3}\\frac{dx}{dt} + z\\frac{dy}{dt} + y\\frac{dz}{dt})dt \\\\\n&= ∫_{0}^{π}(2t)^{3} \\cdot (2) + \\sin t \\cdot (-\\sin t) + \\cos t \\cdot (\\cos t)dt \\\\\n&= ∫_{0}^{π}16t^{3} - \\sin^{2} t + \\cos^{2} tdt \\\\\n&= ∫_{0}^{π}16t^{3} + (\\cos^{2} t - \\sin^{2} t)dt \\\\\n&= ∫_{0}^{π}16t^{3} + \\cos 2tdt\n\\end{aligned}\n$$" 13194139535198 false] [17592186179526 1100 "Evaluate $\\displaystyle \\int\\limits_C y\\,\\mathrm{d}x -x\\,\\mathrm{d}y ,$ where $C$ is a portion of the ellipse parametrized by $\\mathbf{r}(t)=\\cos t\\,\\mathbf{i} + 3\\sin t\\,\\mathbf{j}$ for $t\\in[0,\\pi].$" 13194139535198 true] [17592186179526 1100 "Evaluate $\\displaystyle \\int\\limits_C y\\,\\mathrm{d}x -x\\,\\mathrm{d}y$, where $C$ is a portion of the ellipse parametrized by $\\mathbf{r}(t)=\\cos t\\,\\mathbf{i} + 3\\sin t\\,\\mathbf{j}$ for $t\\in[0,\\pi]$." 13194139535198 false] [17592186179526 1145 "Along the curve, we have\n\n$$\nx(t) = \\cos t, \\qquad\ny(t) = 3\\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx-x\\,dy & ={\\int }_{0}^{\\pi }y\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt-x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(y\\cdot \\frac{\\text{d}x}{\\text{d}t}-x\\cdot \\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{\\pi }3\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)-(\\operatorname{cos}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }-3{sin}^{2}⁡t-3{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }\\,dt \\\\  & =-3{t|}_{0}^{\\pi } \\\\  & =-3\\pi \\end{aligned}\n$$" 13194139535198 true] [17592186179526 1145 "Along the curve, we have\n\n$$\nx(t) = \\cos t, \\qquad y(t) = 3\\sin t\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}\nr^{′}(t) &= \\frac{dx}{dt}i + \\frac{dy}{dt}j \\\\\n&= \\frac{d}{dt}(\\cos t)i + \\frac{d}{dt}(3\\sin t)j \\\\\n&=-\\sin ti + 3\\cos tj\n\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}\n∫_(C)ydx - xdy &= ∫_{0}^{π}y \\cdot \\frac{dx}{dt}dt - x \\cdot \\frac{dy}{dt}dt \\\\\n&= ∫_{0}^{π}(y \\cdot \\frac{dx}{dt} - x \\cdot \\frac{dy}{dt})dt \\\\\n&= ∫_{0}^{π}3\\sin t \\cdot (-\\sin t) - (\\cos t) \\cdot 3\\cos tdt \\\\\n&= ∫_{0}^{π} - 3\\sin^{2} t - 3\\cos^{2} tdt \\\\\n&=-3∫_{0}^{π}\\sin^{2} t + \\cos^{2} tdt \\\\\n&=-3∫_{0}^{π}dt \\\\\n&=-3t \\mid _{0}^{π} \\\\\n&=-3π\n\\end{aligned}\n$$" 13194139535198 false] [17592186179605 10