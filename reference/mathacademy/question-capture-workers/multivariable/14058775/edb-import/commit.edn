xt{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}(t-1)\\cdot (1)+t\\cdot (1)+{e}^{t}\\cdot ({e}^{t})\\,dt \\\\  & ={\\int }_{0}^{1}{e}^{2t}+2t-1\\,dt \\\\  & =(\\frac{{e}^{2t}}{2}+{t}^{2}-t){|}_{0}^{1} \\\\  & =(\\frac{{e}^{2}}{2}+1-1)-\\frac{1}{2} \\\\  & =\\frac{{e}^{2}}{2}-\\frac{1}{2}\\end{aligned}\n$$" 13194139535198 true] [17592186336980 1000 #edb/ref 17592186336981 13194139535198 true] [17592186336980 1000 #edb/ref 17592186336982 13194139535198 true] [17592186336980 1000 #edb/ref 17592186336983 13194139535198 true] [17592186336980 1000 #edb/ref 17592186336984 13194139535198 true] [17592186336980 1000 #edb/ref 17592186336985 13194139535198 true] [17592186336980 1040 #edb/ref 17592186045450 13194139535198 true] [17592186336980 1041 "selection" 13194139535198 true] [17592186336980 1104 #edb/ref 17592186336982 13194139535198 true] [17592186336980 1110 #uuid "e9dca487-2c50-5d30-aa7d-d8e2864f5926" 13194139535198 true] [17592186336981 1034 "\\frac{{e}^{2}}{2}+1" 13194139535198 true] [17592186336981 1103 #edb/ref 17592186045453 13194139535198 true] [17592186336981 1111 #uuid "f5f4dd46-3506-5555-bb12-0be2c604bd5b" 13194139535198 true] [17592186336982 1034 "\\frac{{e}^{2}}{2}-\\frac{1}{2}" 13194139535198 true] [17592186336982 1103 #edb/ref 17592186045453 13194139535198 true] [17592186336982 1111 #uuid "c170e8f6-f51b-5ef9-9b9c-28b91606e94f" 13194139535198 true] [17592186336983 1034 "\\frac{{e}^{2}}{2}+\\frac{5}{2}" 13194139535198 true] [17592186336983 1103 #edb/ref 17592186045453 13194139535198 true] [17592186336983 1111 #uuid "61aae4e1-cf91-530a-b7d0-f0a22450d212" 13194139535198 true] [17592186336984 1034 "\\frac{5{e}^{2}}{2}" 13194139535198 true] [17592186336984 1103 #edb/ref 17592186045453 13194139535198 true] [17592186336984 1111 #uuid "364a4f31-9048-52dc-a24d-f28014de5