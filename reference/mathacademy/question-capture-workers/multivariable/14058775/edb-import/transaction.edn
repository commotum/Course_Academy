[{:db/id "q-124885/selection/d1423dc28a5ec88a98e69bcc9e5f2df5e821589e5a0435c469077ea4e67a5d2d" :answer/id #uuid "36f39c70-7626-5242-ae8b-a57198b21e11" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{3}\\frac{t-1}{t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124885/selection/c5243ff08a5dc57210aeec423c07120b02636fac543b2e6716256094ab805547" :answer/id #uuid "fa1cba29-5903-508b-80d1-efe1081431fa" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{3}2t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124885/selection/0d3a85d1450dc801b1bd6e04e977e96711d4d59cf2c5d783ee16e4c0fed1e82f" :answer/id #uuid "9f905835-4673-54fc-9a76-954a46c59501" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{3}\\frac{{t}^{2}+1}{t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124885/selection/25ec7f94063f51e1df186a4f5df248d8fc75bb860b68931d5396520bdd114381" :answer/id #uuid "708b577c-1b87-58d4-89c2-5fb7858bd4d1" :answer/type :answer.type/math :answer/value "2{\\int }_{1}^{3}\\frac{1}{t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124885/selection/cd7faa7ea38b1d98632cf2712d939a3d95d2c87a2189885131804c6dd1bf8dab" :answer/id #uuid "511d32a8-5f44-557f-8d54-9cc9da66582c" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{3}\\frac{{t}^{2}-1}{t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124885/selection" :answer-field/id #uuid "7aed3c9b-fead-59af-86bb-5518a1d6a05d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124885/selection/cd7faa7ea38b1d98632cf2712d939a3d95d2c87a2189885131804c6dd1bf8dab" :answer-field/choices ["q-124885/selection/d1423dc28a5ec88a98e69bcc9e5f2df5e821589e5a0435c469077ea4e67a5d2d" "q-124885/selection/c5243ff08a5dc57210aeec423c07120b02636fac543b2e6716256094ab805547" "q-124885/selection/0d3a85d1450dc801b1bd6e04e977e96711d4d59cf2c5d783ee16e4c0fed1e82f" "q-124885/selection/25ec7f94063f51e1df186a4f5df248d8fc75bb860b68931d5396520bdd114381" "q-124885/selection/cd7faa7ea38b1d98632cf2712d939a3d95d2c87a2189885131804c6dd1bf8dab"] :db/ensure [:answer-field/validate]} {:db/id "q-124885" :question/id #uuid "20c4e7d1-de84-56b1-8cd9-a50360665597" :question/math-academy-id "q-124885" :question/problem "Which of the following is equivalent to ${\\int }_{C}x{y}^{2}\\,dx+\\frac{1}{x}\\,dy,$ where $C$ is parametrized by $r(t)=\\frac{1}{t}\\,i+t\\,j$ for $t\\in [1,3]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=\\frac{1}{t},\\,y(t)=t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j \\\\  & =-\\frac{1}{{t}^{2}}\\,i+j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}x{y}^{2}\\,dx+\\frac{1}{x}\\,dy & ={\\int }_{1}^{3}x{y}^{2}\\frac{\\text{d}x}{\\text{d}t}\\,dt+\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{1}^{3}(x{y}^{2}\\frac{\\text{d}x}{\\text{d}t}+\\frac{1}{x}\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{1}^{3}\\frac{1}{t}\\cdot {t}^{2}\\cdot (-\\frac{1}{{t}^{2}})+\\frac{1}{(\\frac{1}{t})}\\cdot 1\\,\\text{d}t \\\\  & ={\\int }_{1}^{3}-\\frac{1}{t}+t\\,\\text{d}t \\\\  & ={\\int }_{1}^{3}\\frac{{t}^{2}-1}{t}\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124885/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3be2c44e-775f-53fa-a078-cff25eaea903"] :knowledge-point/questions ["q-124885"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124875/selection/d98ca664da929b4a54bb6f381ef5c668edfca1351a8499a69ced197c20df8333" :answer/id #uuid "4738f29a-065f-5348-b749-bfeb1c6e07aa" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}t(4{t}^{2}-1)\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124875/selection/ff1f63b68aa38ea7083c2c7ba27e104e6a163b4eb9066655c56f72fb91e06cdd" :answer/id #uuid "49584ac4-ce58-5bf7-8564-0dc7120c97f0" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}4{t}^{3}-3t-2\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124875/selection/ce1310663083a2f1253ad00151603b17ac01a5e63bb28048c1723fb72503dce4" :answer/id #uuid "db973b1b-cb55-54d1-899f-25067da84d37" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}4{t}^{3}+t-2\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124875/selection/ca5b65baf69998895647ddada928bf6b01d40c9c098ea60b614fc1339d8679fa" :answer/id #uuid "132876a1-4518-512e-8ce9-ebcdc2ce95c2" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}4{t}^{3}-t-2\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124875/selection/7681ee58430eb778cd9243c219f2aea8525fb2a28dfaec233e66a4cb291935c7" :answer/id #uuid "d0f65502-6b25-5400-8d15-d626498c0a30" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{2}4{t}^{3}-2\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124875/selection" :answer-field/id #uuid "5c677cc0-8fb7-5cfc-8d08-ba9d17bdabf3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124875/selection/ca5b65baf69998895647ddada928bf6b01d40c9c098ea60b614fc1339d8679fa" :answer-field/choices ["q-124875/selection/d98ca664da929b4a54bb6f381ef5c668edfca1351a8499a69ced197c20df8333" "q-124875/selection/ff1f63b68aa38ea7083c2c7ba27e104e6a163b4eb9066655c56f72fb91e06cdd" "q-124875/selection/ce1310663083a2f1253ad00151603b17ac01a5e63bb28048c1723fb72503dce4" "q-124875/selection/ca5b65baf69998895647ddada928bf6b01d40c9c098ea60b614fc1339d8679fa" "q-124875/selection/7681ee58430eb778cd9243c219f2aea8525fb2a28dfaec233e66a4cb291935c7"] :db/ensure [:answer-field/validate]} {:db/id "q-124875" :question/id #uuid "87d7259c-ca26-53c7-b47d-c8aa49f4ead9" :question/math-academy-id "q-124875" :question/problem "Which of the following is equivalent to ${\\int }_{C}(x+y)\\,dx+(x+2)\\,dy,$ where $C$ is parametrized by $r(t)=(t-2)\\,i+({t}^{3}-t)\\,j$ for $t\\in [1,2]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t-2,\\,y(t)={t}^{3}-t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t-2)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{3}-t)\\,j \\\\  & =i+(3{t}^{2}-1)\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,dx+(x+2)\\,dy & ={\\int }_{1}^{2}(x+y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+(x+2)\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{1}^{2}((x+y)\\frac{\\text{d}x}{\\text{d}t}+(x+2)\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{1}^{2}(t-2+{t}^{3}-t)\\cdot 1+(t-2+2)\\cdot (3{t}^{2}-1)\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}{t}^{3}-2+3{t}^{3}-t\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}4{t}^{3}-t-2\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124875/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3be2c44e-775f-53fa-a078-cff25eaea903"] :knowledge-point/questions ["q-124875"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124872/selection/09798e7311626e5c1f4b0606ce52eee310184a9ff9a7f1b666ee458397a13f1d" :answer/id #uuid "5188eab9-baa2-5efe-8117-464775f0aaaf" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{1}1-3t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124872/selection/1a01729043e232b262fb856feebbde7794387f3d217b308e07ce7f372d047ad0" :answer/id #uuid "07a2efde-37a2-5563-8e47-b8782b606334" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{1}1-4t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124872/selection/581a8957a846fe6c2fee68948acca662d673a814aa6004069442c6300df96f18" :answer/id #uuid "14e91ed0-1420-5055-b30e-e6aea08bde47" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{1}8{t}^{2}+4t+1\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124872/selection/5b4869cc5078725b2ad27f90505e0fd0b4d8a324eb5bdeed519b3e03c38eb592" :answer/id #uuid "83465644-4be0-5400-bdbb-f631b1da8427" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{1}1-3t-8{t}^{2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124872/selection/34934286646cb6a1e7f7b06306b4081fdb3aae46f8007a55e61e087f460e776a" :answer/id #uuid "3b4436e0-994d-5a91-a100-17c228098560" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{1}1-5t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124872/selection" :answer-field/id #uuid "47f373be-fc61-5ca1-83f8-65042ce99b1f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124872/selection/09798e7311626e5c1f4b0606ce52eee310184a9ff9a7f1b666ee458397a13f1d" :answer-field/choices ["q-124872/selection/09798e7311626e5c1f4b0606ce52eee310184a9ff9a7f1b666ee458397a13f1d" "q-124872/selection/1a01729043e232b262fb856feebbde7794387f3d217b308e07ce7f372d047ad0" "q-124872/selection/581a8957a846fe6c2fee68948acca662d673a814aa6004069442c6300df96f18" "q-124872/selection/5b4869cc5078725b2ad27f90505e0fd0b4d8a324eb5bdeed519b3e03c38eb592" "q-124872/selection/34934286646cb6a1e7f7b06306b4081fdb3aae46f8007a55e61e087f460e776a"] :db/ensure [:answer-field/validate]} {:db/id "q-124872" :question/id #uuid "72ed363a-5d1e-5655-b35c-7247ea7c02ee" :question/math-academy-id "q-124872" :question/problem "Which of the following is equivalent to ${\\int }_{C}(x-2y)\\,dx+x\\,dy,$ where $C$ is parametrized by $r(t)=(t+1)\\,i-2{t}^{2}\\,j$ for $t\\in [-1,1]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t+1,\\,y(t)=-2{t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t+1)\\,i+\\frac{\\text{d}}{\\text{d}t}(-2{t}^{2})\\,j \\\\  & =i+(-4t)\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-2y)\\,dx+x\\,dy & ={\\int }_{-1}^{1}(x-2y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{-1}^{1}((x-2y)\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{-1}^{1}(t+1-2\\cdot (-2{t}^{2}))\\cdot 1+(t+1)\\cdot (-4t)\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}t+1+4{t}^{2}-4{t}^{2}-4t\\,\\text{d}t \\\\  & ={\\int }_{-1}^{1}1-3t\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124872/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3be2c44e-775f-53fa-a078-cff25eaea903"] :knowledge-point/questions ["q-124872"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124878/selection/0d126cca023547df8ce8f652bbe38eeb47be494f1a05d2cb60169feb0be8b3d7" :answer/id #uuid "597eca5e-f978-5002-9f37-22d95d74e8c6" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124878/selection/4cc4b9bcd10ab316bb1f922b48ef8da1bfb69fdff5d1557d16837604fd4ee9a4" :answer/id #uuid "dbe347ea-7baa-52d6-bb60-57e9c7ce4329" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{\\pi /2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124878/selection/b03e4cefc5939cca89caa283983c9af84f6eeea07cb723727ad7c929727b2020" :answer/id #uuid "b1e0f538-4142-5ba6-8ff1-5861135387d8" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡(2t)\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124878/selection/12ad44abb3c21c86937d0865f613ec9f867018eb8d4b10d148dff732f39f4b7d" :answer/id #uuid "d52ebe83-b16f-5952-b1f7-8c9475ec83d9" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡(2t)\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124878/selection/2b58af5a6c416f6c2cca8c0851a669ad36ee61e7c9cf6f96d5dfdd55a6c5469a" :answer/id #uuid "f0cec9ba-e608-5357-984d-3798d5e791f6" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡(2t)-\\operatorname{sin}⁡(2t)\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124878/selection" :answer-field/id #uuid "4e12cdab-144a-5862-9123-a2c0e7effe26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124878/selection/12ad44abb3c21c86937d0865f613ec9f867018eb8d4b10d148dff732f39f4b7d" :answer-field/choices ["q-124878/selection/0d126cca023547df8ce8f652bbe38eeb47be494f1a05d2cb60169feb0be8b3d7" "q-124878/selection/4cc4b9bcd10ab316bb1f922b48ef8da1bfb69fdff5d1557d16837604fd4ee9a4" "q-124878/selection/b03e4cefc5939cca89caa283983c9af84f6eeea07cb723727ad7c929727b2020" "q-124878/selection/12ad44abb3c21c86937d0865f613ec9f867018eb8d4b10d148dff732f39f4b7d" "q-124878/selection/2b58af5a6c416f6c2cca8c0851a669ad36ee61e7c9cf6f96d5dfdd55a6c5469a"] :db/ensure [:answer-field/validate]} {:db/id "q-124878" :question/id #uuid "a6c4d7e0-6d3a-5784-88f9-be750756f8cd" :question/math-academy-id "q-124878" :question/problem "Which of the following is equivalent to ${\\int }_{C}(x-y)\\,dx+(y-x)\\,dy,$ where $C$ is parametrized by $r(t)=2\\operatorname{sin}⁡t\\,i-2\\operatorname{cos}⁡t\\,j$ for $t\\in [0,\\frac{\\pi }{2}]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=2\\operatorname{sin}⁡t,\\,y(t)=-2\\operatorname{cos}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(-2\\operatorname{cos}⁡t)\\,j \\\\  & =2\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,dx+(y-x)\\,dy & ={\\int }_{0}^{\\pi /2}(x-y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+(y-x)\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}((x-y)\\frac{\\text{d}x}{\\text{d}t}+(y-x)\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}(2\\operatorname{sin}⁡t-(-2\\operatorname{cos}⁡t))\\cdot 2\\operatorname{cos}⁡t+(-2\\operatorname{cos}⁡t-2\\operatorname{sin}⁡t)\\cdot 2\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+4{cos}^{2}⁡t-4\\operatorname{cos}⁡t\\operatorname{sin}⁡t-4{sin}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}4({cos}^{2}⁡t-{sin}^{2}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}4\\operatorname{cos}⁡(2t)\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡(2t)\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124878/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3be2c44e-775f-53fa-a078-cff25eaea903"] :knowledge-point/questions ["q-124878"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124882/selection/40df4495bd84ec24a0c053ab971fda48d5c17dfdeb4c3d31a7904a47e239c817" :answer/id #uuid "10a688bd-9f86-5b4f-8d7f-28137a29326e" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{1}{e}^{2t+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124882/selection/3e475548522c1eb0265046f7038ffd9cafe20c86672c47ad470659e7cef182e8" :answer/id #uuid "7c46a4c4-4404-5cdd-b483-54474a7748ac" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{e}^{3t+1}+{e}^{2t+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124882/selection/d6ad658e9df686eea338ba58b722d0076f34de047f21c7bda06a965bbad9315b" :answer/id #uuid "e1253b91-011b-5d6d-9242-cd2b3741bafc" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{1}{e}^{3t+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124882/selection/69116380fe20c0465d7fc6dfebafc00063ce8e54e8825de31508e826eba26da3" :answer/id #uuid "4e634465-c33b-5166-8048-28452b316f39" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{e}^{5t+2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124882/selection/39720abdf2df457e5decedb4a6154a5f451d2e44cf825ec23aa5f91d5926bc03" :answer/id #uuid "e8012cb3-861d-5c6c-b36b-316b61f631cd" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{e}^{3t}+{e}^{2t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124882/selection" :answer-field/id #uuid "4c3cd091-bba1-5cdc-9ad3-b8d51c88b7b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124882/selection/3e475548522c1eb0265046f7038ffd9cafe20c86672c47ad470659e7cef182e8" :answer-field/choices ["q-124882/selection/40df4495bd84ec24a0c053ab971fda48d5c17dfdeb4c3d31a7904a47e239c817" "q-124882/selection/3e475548522c1eb0265046f7038ffd9cafe20c86672c47ad470659e7cef182e8" "q-124882/selection/d6ad658e9df686eea338ba58b722d0076f34de047f21c7bda06a965bbad9315b" "q-124882/selection/69116380fe20c0465d7fc6dfebafc00063ce8e54e8825de31508e826eba26da3" "q-124882/selection/39720abdf2df457e5decedb4a6154a5f451d2e44cf825ec23aa5f91d5926bc03"] :db/ensure [:answer-field/validate]} {:db/id "q-124882" :question/id #uuid "f1c03e17-fa10-5a92-95ff-3965b57742a3" :question/math-academy-id "q-124882" :question/problem "Which of the following is equivalent to ${\\int }_{C}xy\\,dx+x\\,dy,$ where $C$ is parametrized by $r(t)={e}^{t}\\,i+{e}^{t+1}\\,j$ for $t\\in [0,1]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)={e}^{t},\\,y(t)={e}^{t+1}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,i+\\frac{\\text{d}}{\\text{d}t}({e}^{t+1})\\,j \\\\  & ={e}^{t}\\,i+{e}^{t+1}\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,dx+x\\,dy & ={\\int }_{0}^{1}xy\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(xy\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{1}{e}^{t}\\cdot {e}^{t+1}\\cdot {e}^{t}+{e}^{t}\\cdot {e}^{t+1}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{3t+1}+{e}^{2t+1}\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124882/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3be2c44e-775f-53fa-a078-cff25eaea903"] :knowledge-point/questions ["q-124882"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-124871"] :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-124809/selection/d132fb82c7f0b234a0bfebdc8b9065c8730c3299a267fd517e7ba810374cb86e" :answer/id #uuid "b09948ac-44ef-5e9d-a1c8-91614e52a6fe" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\operatorname{cos}⁡2t+\\operatorname{sin}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124809/selection/40d5358506eaf2168a2b2ccc1081d9a91ea32eb67a7322501caad06882cd84fd" :answer/id #uuid "1b1ac0f6-8da0-5e3a-a21c-0bddafd16848" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{t}^{3}+\\operatorname{cos}⁡2t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124809/selection/bdeb1fc38e1938314aef5ca9d9f79bdb226c6f6de72f0375756ee8815873adc2" :answer/id #uuid "b7b4bbb9-9a4c-53e2-8581-e46c7f6c8d95" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{cos}^{3}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124809/selection/6466e52bee3e65ef6574d951de3acbb48da9efca2104808572633599409749cd" :answer/id #uuid "8867512a-3a84-5f89-a1a4-d3b9f879ef8c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{t}^{2}-\\operatorname{cos}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124809/selection/b61ea87e1dc7dc9424c715c710ec538236a598488aa6f5b4b0530d3cab9d9924" :answer/id #uuid "e0ad45ba-3c98-5a34-a103-02d62efded6e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{cos}^{2}⁡t+1\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124809/selection" :answer-field/id #uuid "4e586c51-8ccd-5953-b73b-4c0efdaea965" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124809/selection/40d5358506eaf2168a2b2ccc1081d9a91ea32eb67a7322501caad06882cd84fd" :answer-field/choices ["q-124809/selection/d132fb82c7f0b234a0bfebdc8b9065c8730c3299a267fd517e7ba810374cb86e" "q-124809/selection/40d5358506eaf2168a2b2ccc1081d9a91ea32eb67a7322501caad06882cd84fd" "q-124809/selection/bdeb1fc38e1938314aef5ca9d9f79bdb226c6f6de72f0375756ee8815873adc2" "q-124809/selection/6466e52bee3e65ef6574d951de3acbb48da9efca2104808572633599409749cd" "q-124809/selection/b61ea87e1dc7dc9424c715c710ec538236a598488aa6f5b4b0530d3cab9d9924"] :db/ensure [:answer-field/validate]} {:db/id "q-124809" :question/id #uuid "fb7ae2bd-0784-56ff-b58a-eea210c6700b" :question/math-academy-id "q-124809" :question/problem "Which of the following is equivalent to ${\\int }_{C}{x}^{3}\\,dx+z\\,dy+y\\,dz,$ where $C$ is a portion of the helix $r(t)=t\\,i+\\operatorname{cos}⁡t\\,j+\\operatorname{sin}⁡t\\,k$ for $t\\in [0,\\pi ]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)=\\operatorname{cos}⁡t,\\,z(t)=\\operatorname{sin}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}\\,dx+z\\,dy+y\\,dz & ={\\int }_{0}^{\\pi }{x}^{3}\\frac{\\text{d}x}{\\text{d}t}\\,dt+z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }({x}^{3}\\frac{\\text{d}x}{\\text{d}t}+z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }{t}^{3}\\cdot (1)+\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot (\\operatorname{cos}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }{t}^{3}+{cos}^{2}⁡t-{sin}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }{t}^{3}+\\operatorname{cos}⁡2t\\,dt\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124809/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049"] :knowledge-point/questions ["q-124809"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124832/selection/85df62453669ca38f5d9b9c131b9c1d7b5530a0177aab8b842e72cce39c98095" :answer/id #uuid "fabafa75-9e7c-5ef7-9e34-b255191d8913" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /3}{t}^{2}+9\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124832/selection/a390050601ec970c8d28b4c7cc131f0a5a7b595128e06f8f31ccf37fc36b8b03" :answer/id #uuid "3b1281db-a9f3-5673-b18e-5d639c9f8e87" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /3}{t}^{2}+{cos}^{2}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124832/selection/0efde200a429a186ddf6d45fe9ae06c14de6e7f56b9e1f68c8c80672ef80b021" :answer/id #uuid "8bce23a0-140e-5961-b337-7497156db4f0" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /3}{t}^{2}-\\operatorname{sin}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124832/selection/0e25d6d9746ff580fb65b8864368eb694403f30cec56cb513ff78ce7002acddc" :answer/id #uuid "b69a3c39-9526-5be7-b7ea-fc888875d9c4" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /3}t+2\\operatorname{cos}⁡2t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124832/selection/6cee22b3f0c4187f8b713512ef9a34ed5966cc931c16d4368ec1662abbc61c9e" :answer/id #uuid "c040dc44-f8d0-5928-b803-dc570daf2d0e" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /3}t+2\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124832/selection" :answer-field/id #uuid "8df17946-a5ca-5962-b4d9-4a316df98bfc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124832/selection/6cee22b3f0c4187f8b713512ef9a34ed5966cc931c16d4368ec1662abbc61c9e" :answer-field/choices ["q-124832/selection/85df62453669ca38f5d9b9c131b9c1d7b5530a0177aab8b842e72cce39c98095" "q-124832/selection/a390050601ec970c8d28b4c7cc131f0a5a7b595128e06f8f31ccf37fc36b8b03" "q-124832/selection/0efde200a429a186ddf6d45fe9ae06c14de6e7f56b9e1f68c8c80672ef80b021" "q-124832/selection/0e25d6d9746ff580fb65b8864368eb694403f30cec56cb513ff78ce7002acddc" "q-124832/selection/6cee22b3f0c4187f8b713512ef9a34ed5966cc931c16d4368ec1662abbc61c9e"] :db/ensure [:answer-field/validate]} {:db/id "q-124832" :question/id #uuid "1ffc1b85-360b-5d52-b60e-3d001d7bff89" :question/math-academy-id "q-124832" :question/problem "Which of the following is equivalent to ${\\int }_{C}-y\\,dx+x\\,dy+z\\,dz,$ where $C$ is a portion of the helix $r(t)=\\sqrt{2}\\operatorname{cos}⁡t\\,i+\\sqrt{2}\\operatorname{sin}⁡t\\,j+t\\,k$ for $t\\in [\\frac{\\pi }{4},\\frac{\\pi }{3}]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=\\sqrt{2}\\operatorname{cos}⁡t,\\,y(t)=\\sqrt{2}\\operatorname{sin}⁡t,\\,z(t)=t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\sqrt{2}\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(t)\\,k \\\\  & =-\\sqrt{2}\\operatorname{sin}⁡t\\,i+\\sqrt{2}\\operatorname{cos}⁡t\\,j+k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-y\\,dx+x\\,dy+z\\,dz & ={\\int }_{\\pi /4}^{\\pi /3}-y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}(-y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}-\\sqrt{2}\\operatorname{sin}⁡t\\cdot (-\\sqrt{2}\\operatorname{sin}⁡t)+\\sqrt{2}\\operatorname{cos}⁡t\\cdot (\\sqrt{2}\\operatorname{cos}⁡t)+t\\cdot 1\\,dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}t+2{sin}^{2}⁡t+2{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{\\pi /4}^{\\pi /3}t+2\\,dt\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124832/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049"] :knowledge-point/questions ["q-124832"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124823/selection/92998603ed00bd4b9d73a601ccfeb98a5ef85acdeb34619ad0d9c9347e6d7ef7" :answer/id #uuid "b263f413-c6b1-5209-90fe-0dc5aed8fb5c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}2{t}^{2}+3{cos}^{2}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124823/selection/5ccd9ab9e5164bcab617946f9bc43b5cb320afb064718d678c16a84a3b923de3" :answer/id #uuid "3439b6c0-4c05-58a2-84b0-65880b6e61a8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}{t}^{4}-2\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124823/selection/34f10ef529b2eb878680d1ffd4cce4bf8b70e61ef8f2311292d4a12b9e59d541" :answer/id #uuid "cec41933-97a0-5e8f-ad55-0dca03248247" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}2{t}^{3}-9\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124823/selection/235864b2eb1207132058208ef51800ebb86a4c2086945006afecd1c131902c24" :answer/id #uuid "032e2a1e-eefd-51bb-84cd-9d2c54603206" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}2{t}^{2}+3{sin}^{2}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124823/selection/a32917609b46fd8fe4297fa05f822ad970d1554a01b319573fa9c4ef8ee7bae0" :answer/id #uuid "b21468b5-00c4-5489-9e2a-6555d43826f2" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}t-{sin}^{2}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124823/selection" :answer-field/id #uuid "b8bbe138-306d-5251-ac89-a72690e8356a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124823/selection/34f10ef529b2eb878680d1ffd4cce4bf8b70e61ef8f2311292d4a12b9e59d541" :answer-field/choices ["q-124823/selection/92998603ed00bd4b9d73a601ccfeb98a5ef85acdeb34619ad0d9c9347e6d7ef7" "q-124823/selection/5ccd9ab9e5164bcab617946f9bc43b5cb320afb064718d678c16a84a3b923de3" "q-124823/selection/34f10ef529b2eb878680d1ffd4cce4bf8b70e61ef8f2311292d4a12b9e59d541" "q-124823/selection/235864b2eb1207132058208ef51800ebb86a4c2086945006afecd1c131902c24" "q-124823/selection/a32917609b46fd8fe4297fa05f822ad970d1554a01b319573fa9c4ef8ee7bae0"] :db/ensure [:answer-field/validate]} {:db/id "q-124823" :question/id #uuid "e5839d56-f6d8-5d06-95f8-dd9c646ba1f7" :question/math-academy-id "q-124823" :question/problem "Which of the following is equivalent to ${\\int }_{C}z\\,dx+y\\,dy-x\\,dz,$ where $C$ is a portion of the curve $r(t)=3\\operatorname{cos}⁡t\\,i+{t}^{2}\\,j+3\\operatorname{sin}⁡t\\,k$ for $t\\in [0,\\frac{\\pi }{2}]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=3\\operatorname{cos}⁡t,\\,y(t)={t}^{2},\\,z(t)=3\\operatorname{sin}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,k \\\\  & =-3\\operatorname{sin}⁡t\\,i+2t\\,j+3\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}z\\,dx+y\\,dy-x\\,dz & ={\\int }_{0}^{\\pi /2}z\\frac{\\text{d}x}{\\text{d}t}\\,dt+y\\frac{\\text{d}y}{\\text{d}t}\\,dt-x\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}(z\\frac{\\text{d}x}{\\text{d}t}+y\\frac{\\text{d}y}{\\text{d}t}-x\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{sin}⁡t\\cdot (-3\\operatorname{sin}⁡t)+{t}^{2}\\cdot (2t)-3\\operatorname{cos}⁡t\\cdot (3\\operatorname{cos}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}2{t}^{3}-9{sin}^{2}⁡t-9{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi /2}2{t}^{3}-9\\,dt\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124823/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049"] :knowledge-point/questions ["q-124823"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124865/selection/cf2d15b964db4614414fa870b29099a71bdd8159cbaff4af04c70a89b6bbe1c0" :answer/id #uuid "2165de66-752f-5508-987b-b68c638d459f" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}4{t}^{2}+11t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124865/selection/e2433949922d694b0ff40750afd18a50aa4c55cadddca6b43403a24c174478e9" :answer/id #uuid "67c5a40f-e222-58c9-a0f4-ce24321fe456" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}4t+5\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124865/selection/bc9a9b0c86038df0d9bd9dff9c3f3c013e7b1372702eb123a712ae00a728006e" :answer/id #uuid "447aaf43-fb1d-5efc-ae9c-ecf39337b403" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}{t}^{2}+10t+5\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124865/selection/aea9c9fe0731c2fbc9be0fdfc345f8c88644b13d9267b04f38ea4276e22b0db0" :answer/id #uuid "2fbda87b-ba93-5d6e-9d03-fe957f64db27" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}{t}^{3}+2\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124865/selection/b611acc915396245f2851eec7bb382296837ddde025a00468e17b0baee3bb507" :answer/id #uuid "8e5e601a-faf4-50b6-a7ab-709ad9ee98ec" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}2{t}^{4}-5t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124865/selection" :answer-field/id #uuid "05811525-dcfe-5c17-bf64-c70e8c386c1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124865/selection/cf2d15b964db4614414fa870b29099a71bdd8159cbaff4af04c70a89b6bbe1c0" :answer-field/choices ["q-124865/selection/cf2d15b964db4614414fa870b29099a71bdd8159cbaff4af04c70a89b6bbe1c0" "q-124865/selection/e2433949922d694b0ff40750afd18a50aa4c55cadddca6b43403a24c174478e9" "q-124865/selection/bc9a9b0c86038df0d9bd9dff9c3f3c013e7b1372702eb123a712ae00a728006e" "q-124865/selection/aea9c9fe0731c2fbc9be0fdfc345f8c88644b13d9267b04f38ea4276e22b0db0" "q-124865/selection/b611acc915396245f2851eec7bb382296837ddde025a00468e17b0baee3bb507"] :db/ensure [:answer-field/validate]} {:db/id "q-124865" :question/id #uuid "38abb4d1-bac7-5e9e-bd43-53ae0b7ce435" :question/math-academy-id "q-124865" :question/problem "Which of the following is equivalent to ${\\int }_{C}{y}^{2}\\,dx+x\\,dy+z\\,dz,$ where $C$ is a portion of the line $r(t)=t\\,i+2t\\,j+3t\\,k$ for $t\\in [0,5]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)=2t,\\,z(t)=3t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(3t)\\,k \\\\  & =\\,i+2\\,j+3\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{y}^{2}\\,dx+x\\,dy+z\\,dz & ={\\int }_{0}^{5}{y}^{2}\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{5}({y}^{2}\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{5}4{t}^{2}\\cdot (1)+t\\cdot (2)+3t\\cdot (3)\\,dt \\\\  & ={\\int }_{0}^{5}4{t}^{2}+11t\\,dt\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124865/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049"] :knowledge-point/questions ["q-124865"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81177/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "e8baa50f-ad43-5e7c-be1d-104e6c1d9d36" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-81177/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "ece0917c-3d63-5e94-9bd6-39f84810fe95" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-81177/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "34d7d6dc-6baf-5361-a33d-7d59c7a46b7f" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-81177/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "5a7f9683-6e99-55eb-adb7-c1c410779747" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-81177/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "446b2787-bb2d-55cf-a7af-c06113b29207" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-81177/selection" :answer-field/id #uuid "c51450c4-28c4-5436-91f0-a6432b3850b8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81177/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-81177/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-81177/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-81177/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" "q-81177/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-81177/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-81177" :question/id #uuid "152c261f-360a-52bd-b3d4-387741e2a06f" :question/math-academy-id "q-81177" :question/problem "Evaluate ${\\int }_{C}y\\,dx+x\\,dy,$ where $C$ is a portion of the ellipse parametrized by $r(t)=4\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j$ for $t\\in [\\frac{\\pi }{12},\\frac{\\pi }{4}].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=4\\operatorname{cos}⁡t,\\,y(t)=2\\operatorname{sin}⁡t.\n$$\n\n.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)\\,j \\\\  & =-4\\operatorname{sin}⁡t\\,i+2\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx+x\\,dy & ={\\int }_{\\pi /12}^{\\pi /4}y\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{\\pi /12}^{\\pi /4}(y\\cdot \\frac{\\text{d}x}{\\text{d}t}+x\\cdot \\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{\\pi /12}^{\\pi /4}2\\operatorname{sin}⁡t\\cdot (-4\\operatorname{sin}⁡t)+4\\operatorname{cos}⁡t\\cdot (2\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & =8{\\int }_{\\pi /12}^{\\pi /4}{cos}^{2}⁡t-{sin}^{2}⁡t\\,\\text{d}t \\\\  & =8{\\int }_{\\pi /12}^{\\pi /4}\\operatorname{cos}⁡(2t)\\,\\text{d}t \\\\  & =4\\operatorname{sin}⁡(2t){|}_{\\pi /12}^{\\pi /4} \\\\  & =4\\operatorname{sin}⁡(\\frac{\\pi }{2})-4\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =4-2 \\\\  & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81177/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75"] :knowledge-point/questions ["q-81177"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81097/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "d28e9ad5-9558-5dda-96be-31998cf5dce8" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-81097/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "5a3c1817-cf56-5d30-8501-d679b1be4793" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-81097/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c623b031-0d1d-56f4-96ff-5e81ca76ba21" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-81097/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "534bb052-2e3e-5099-9546-a63a7d380704" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-81097/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "58b9bd7d-b0ea-5cdb-8098-f6d118d13baa" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-81097/selection" :answer-field/id #uuid "7025f285-c5f5-556e-91a7-61e33f34bd08" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81097/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer-field/choices ["q-81097/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-81097/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-81097/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-81097/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-81097/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951"] :db/ensure [:answer-field/validate]} {:db/id "q-81097" :question/id #uuid "7af25f1a-9124-52a0-83a0-6d803e2bac66" :question/math-academy-id "q-81097" :question/problem "Evaluate ${\\int }_{C}-y\\,dx+x\\,dy,$ where $C$ is a portion of the circle parametrized by $r(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j$ for $t\\in [0,\\pi ].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=\\operatorname{cos}⁡t,\\,y(t)=\\operatorname{sin}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-y\\,dx+x\\,dy & ={\\int }_{0}^{\\pi }-y\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(-y\\cdot \\frac{\\text{d}x}{\\text{d}t}+x\\cdot \\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{sin}⁡t\\cdot \\operatorname{sin}⁡t+\\operatorname{cos}⁡t\\cdot \\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }\\,dt \\\\  & =t{|}_{0}^{\\pi } \\\\  & =\\pi -0 \\\\  & =\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81097/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75"] :knowledge-point/questions ["q-81097"] :db/ensure [:knowledge-point/validate]} {:db/id "q-90844/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "ddacda9b-0383-5939-8d3d-b9877cd71303" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-90844/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "8f92d9ca-8eb8-5421-8772-ea7fe7d6651a" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-90844/selection/65f0fec56f6a66f8e3ced081771b98aea3b89364635fd715090c02ca19e5be19" :answer/id #uuid "fa2a3b17-8aa1-5f6f-acb3-b3120a8ded72" :answer/type :answer.type/math :answer/value "2+\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-90844/selection/c2504524716cd00ef228b78ddcf6ef09c2e45cec8ef42f3c273b642ac24f94dd" :answer/id #uuid "692743d4-e03d-5ece-9f07-7a77fa18947f" :answer/type :answer.type/math :answer/value "\\pi +2" :db/ensure [:answer/validate]} {:db/id "q-90844/selection/26d56282497397e2cb22481c4a4fa1a5e785860d52ba1416fe2e4e5146075126" :answer/id #uuid "d3f1d29e-e4f4-5e47-994d-e772d5e70597" :answer/type :answer.type/math :answer/value "2-\\pi " :db/ensure [:answer/validate]} {:db/id "q-90844/selection" :answer-field/id #uuid "cd9ea258-9454-55c0-a355-a1fc0a48e1ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-90844/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer-field/choices ["q-90844/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-90844/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" "q-90844/selection/65f0fec56f6a66f8e3ced081771b98aea3b89364635fd715090c02ca19e5be19" "q-90844/selection/c2504524716cd00ef228b78ddcf6ef09c2e45cec8ef42f3c273b642ac24f94dd" "q-90844/selection/26d56282497397e2cb22481c4a4fa1a5e785860d52ba1416fe2e4e5146075126"] :db/ensure [:answer-field/validate]} {:db/id "q-90844" :question/id #uuid "fec06d68-180e-5575-8694-e1107dfa1adf" :question/math-academy-id "q-90844" :question/problem "Evaluate ${\\int }_{C}-\\frac{1}{z}\\,dx+x\\,dy+dz,$ where $C$ is a portion of the helix parametrized by $r(t)=\\operatorname{cos}⁡t\\,i+t\\,j+\\operatorname{sin}⁡t\\,k$ for $t\\in [0,\\pi ].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=\\operatorname{cos}⁡t,\\,y(t)=t,\\,z(t)=\\operatorname{sin}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =-\\operatorname{sin}⁡t\\,i+\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-\\frac{1}{z}\\,dx+x\\,dy+dz & ={\\int }_{0}^{\\pi }-\\frac{1}{z}\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(-\\frac{1}{z}\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }-\\frac{1}{\\operatorname{sin}⁡t}\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot 1+\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }1+2\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =(t+2\\operatorname{sin}⁡t)\\,{|}_{0}^{\\pi } \\\\  & =\\pi +2\\operatorname{sin}⁡\\pi -0 \\\\  & =\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-90844/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75"] :knowledge-point/questions ["q-90844"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124721/selection/9fc2a4fe4fd30b19c71d4c440f400ea87f0ac4a3d50c9e4b72f40f6705efde3c" :answer/id #uuid "c170e8f6-f51b-5ef9-9b9c-28b91606e94f" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{2}-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-124721/selection/ebe79e296c4b1df304fa47fd30e0667e48e006ea560fc6bd3b302305437a5833" :answer/id #uuid "364a4f31-9048-52dc-a24d-f28014de59b3" :answer/type :answer.type/math :answer/value "\\frac{5{e}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-124721/selection/d86eff1ea6e16c19c4e0debe112922b3c70827ac091d80c0128b1c7d9c428f12" :answer/id #uuid "61aae4e1-cf91-530a-b7d0-f0a22450d212" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{2}+\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-124721/selection/5c95e1c490655767233475106d36feb7b4b7c29fcf409adcda3ebf8418c51f4a" :answer/id #uuid "f5f4dd46-3506-5555-bb12-0be2c604bd5b" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{2}+1" :db/ensure [:answer/validate]} {:db/id "q-124721/selection/f003b95a6c7a22f536ec799844670c061a2d01da9486469d5da5d96020e58645" :answer/id #uuid "88c28e57-b9fa-54be-af1f-4ee8884859ba" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-124721/selection" :answer-field/id #uuid "e9dca487-2c50-5d30-aa7d-d8e2864f5926" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124721/selection/9fc2a4fe4fd30b19c71d4c440f400ea87f0ac4a3d50c9e4b72f40f6705efde3c" :answer-field/choices ["q-124721/selection/9fc2a4fe4fd30b19c71d4c440f400ea87f0ac4a3d50c9e4b72f40f6705efde3c" "q-124721/selection/ebe79e296c4b1df304fa47fd30e0667e48e006ea560fc6bd3b302305437a5833" "q-124721/selection/d86eff1ea6e16c19c4e0debe112922b3c70827ac091d80c0128b1c7d9c428f12" "q-124721/selection/5c95e1c490655767233475106d36feb7b4b7c29fcf409adcda3ebf8418c51f4a" "q-124721/selection/f003b95a6c7a22f536ec799844670c061a2d01da9486469d5da5d96020e58645"] :db/ensure [:answer-field/validate]} {:db/id "q-124721" :question/id #uuid "5a58dfe4-c80f-5943-8159-e20f4642d770" :question/math-academy-id "q-124721" :question/problem "Evaluate ${\\int }_{C}y\\,dx+x\\,dy+z\\,dz,$ where $C$ is a portion of the curve $r(t)=t\\,i+(t-1)\\,j+{e}^{t}\\,k$ for $t\\in [0,1].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)=t-1,\\,z(t)={e}^{t}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t-1)\\,j+\\frac{\\text{d}}{\\text{d}t}({e}^{t})\\,k \\\\  & =i+j+{e}^{t}\\,k.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx+x\\,dy+z\\,dz & ={\\int }_{0}^{1}y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}(t-1)\\cdot (1)+t\\cdot (1)+{e}^{t}\\cdot ({e}^{t})\\,dt \\\\  & ={\\int }_{0}^{1}{e}^{2t}+2t-1\\,dt \\\\  & =(\\frac{{e}^{2t}}{2}+{t}^{2}-t){|}_{0}^{1} \\\\  & =(\\frac{{e}^{2}}{2}+1-1)-\\frac{1}{2} \\\\  & =\\frac{{e}^{2}}{2}-\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-124721/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75"] :knowledge-point/questions ["q-124721"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81171/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "b374a0cc-1570-51ec-8c6e-f5cb43e1ab75" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-81171/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0832d413-1eb6-54ad-846c-5acaacccdf4c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-81171/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "be78d9bc-0353-5eab-995a-b71c8c780db7" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-81171/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "c3cd8746-a7b8-5bec-9351-f8031bd90ff7" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-81171/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "09d03aa1-4d25-57b2-bced-15fd4f450c5b" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-81171/selection" :answer-field/id #uuid "8937c22f-332c-5acc-ba22-d73f4d9b3af3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81171/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-81171/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-81171/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-81171/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-81171/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-81171/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-81171" :question/id #uuid "a9869daf-0562-5202-8bf9-2c81e380f815" :question/math-academy-id "q-81171" :question/problem "Evaluate ${\\int }_{C}\\frac{(2x+y+1)}{x}\\,dx+dy,$ where $C$ is a portion of the parabola parametrized by $r(t)=t\\,i+({t}^{2}-1)\\,j$ for $t\\in [0,2].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)={t}^{2}-1.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\,j \\\\  & =i+2t\\,j.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{2x+y+1}{x}\\,dx+dy & ={\\int }_{0}^{2}\\frac{2x+y+1}{x}\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt+\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{2}(\\frac{2x+y+1}{x}\\cdot \\frac{\\text{d}x}{\\text{d}t}+\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{2}\\frac{2t+{t}^{2}-1+1}{t}+2t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}2+t+2t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}2+3t\\,\\text{d}t \\\\  & ={[2t+\\frac{3}{2}{t}^{2}]}_{0}^{2} \\\\  & =[2(2)+\\frac{3}{2}(2)^{2}]-[0] \\\\  & =[4+6] \\\\  & =10\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81171/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75"] :knowledge-point/questions ["q-81171"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7118"] :question/problem "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C (x^2+y)\\,\\mathrm{d}x + x\\,\\mathrm{d}y,$ where $C$ is parametrized by $\\mathbf{r}(t) = t\\,\\mathbf{i} + t^2\\,\\mathbf{j}$ for $t\\in\\left[0,1\\right].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t) = t, \\qquad\ny(t) = t^2.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j \\\\  & =i+2t\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}+y)\\,dx+x\\,dy & ={\\int }_{0}^{1}({x}^{2}+y)\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(({x}^{2}+y)\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{1}({t}^{2}+{t}^{2})\\cdot 1+t\\cdot 2t\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}2{t}^{2}+2{t}^{2}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}4{t}^{2}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{1}{t}^{2}\\,\\text{d}t\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9517"] :question/problem "Construct a definite integral that is equivalent to $\\displaystyle \\int\\limits_C x^3\\,\\mathrm{d}x + z\\,\\mathrm{d}y + y\\,\\mathrm{d}z,$ where $C$ is a portion of the helix $\\mathbf{r}(t)=2t\\,\\mathbf{i} + \\cos t\\,\\mathbf{j} + \\sin t\\,\\mathbf{k}$ for $t\\in[0,\\pi]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t) =2t, \\qquad \ny(t) = \\cos t , \\qquad \nz(t) = \\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)\\,k \\\\  & =2\\,i-\\operatorname{sin}⁡t\\,j+\\operatorname{cos}⁡t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{3}\\,dx+z\\,dy+y\\,dz & ={\\int }_{0}^{\\pi }{x}^{3}\\frac{\\text{d}x}{\\text{d}t}\\,dt+z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }({x}^{3}\\frac{\\text{d}x}{\\text{d}t}+z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{\\pi }(2t)^{3}\\cdot (2)+\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)+\\operatorname{cos}⁡t\\cdot (\\operatorname{cos}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}-{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+({cos}^{2}⁡t-{sin}^{2}⁡t)\\,dt \\\\  & ={\\int }_{0}^{\\pi }16{t}^{3}+\\operatorname{cos}⁡2t\\,dt\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9528"] :question/problem "Evaluate $\\displaystyle \\int\\limits_C y\\,\\mathrm{d}x -x\\,\\mathrm{d}y ,$ where $C$ is a portion of the ellipse parametrized by $\\mathbf{r}(t)=\\cos t\\,\\mathbf{i} + 3\\sin t\\,\\mathbf{j}$ for $t\\in[0,\\pi].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t) = \\cos t, \\qquad\ny(t) = 3\\sin t.\n$$\n\nThe derivative of $\\mathbf r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j \\\\  & =-\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx-x\\,dy & ={\\int }_{0}^{\\pi }y\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt-x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{\\pi }(y\\cdot \\frac{\\text{d}x}{\\text{d}t}-x\\cdot \\frac{\\text{d}y}{\\text{d}t})\\,dt \\\\  & ={\\int }_{0}^{\\pi }3\\operatorname{sin}⁡t\\cdot (-\\operatorname{sin}⁡t)-(\\operatorname{cos}⁡t)\\cdot 3\\operatorname{cos}⁡t\\,dt \\\\  & ={\\int }_{0}^{\\pi }-3{sin}^{2}⁡t-3{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }{sin}^{2}⁡t+{cos}^{2}⁡t\\,dt \\\\  & =-3{\\int }_{0}^{\\pi }\\,dt \\\\  & =-3{t|}_{0}^{\\pi } \\\\  & =-3\\pi \\end{aligned}\n$$" :db/ensure [:question/validate]}]
