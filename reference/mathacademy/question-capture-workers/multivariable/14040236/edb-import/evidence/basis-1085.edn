#{[{:db/id #edb/ref 17592186286186 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c699610-261c-5695-b196-3999bf781137" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{\\sqrt{26}}" :db/id #edb/ref 17592186286188} {:answer/id #uuid "3f11c720-e046-523b-8dc7-c52f825eba0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{26}}" :db/id #edb/ref 17592186286189} {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} {:answer/id #uuid "ba533aff-71f4-54f1-a488-8e6bd6e66a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{14}}" :db/id #edb/ref 17592186286191} {:answer/id #uuid "08f2859a-5d24-534f-82e7-b3fbf2ac9ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{14}}" :db/id #edb/ref 17592186286192}] :answer-field/correct {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} :answer-field/id #uuid "c23d68cf-4f67-573a-91f0-15f4e696233a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286187}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26907092-d115-5133-80f7-1ed5a1bdc6ed" :question/math-academy-id "q-19139" :question/problem "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106134 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c57ffadb-4b3c-5e37-a582-3db44c3f5be2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186103037} {:answer/id #uuid "23135d70-addc-5580-aa35-c02c68832632" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186103038} {:answer/id #uuid "244f5799-8646-5b1f-b0d3-d3c608b45930" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186103039} {:answer/id #uuid "39e1f26d-f1c5-542c-a6da-ca05957526a6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186103040} {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041}] :answer-field/correct {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041} :answer-field/id #uuid "857c8ca0-e5aa-56ce-af4b-fdf9bb998e77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103036}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "71a079d2-97d0-5455-a26c-8d71df225e2c" :question/math-academy-id "q-236734" :question/problem "Let $p=⟨-1,1,2⟩$ and $q=⟨4,x,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 4+1\\cdot x+2\\cdot 1 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"}]}
