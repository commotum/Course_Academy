#{[{:db/id #edb/ref 17592186105411 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/id #uuid "1a24b403-754c-5424-8182-8cad3487deed" :question/math-academy-id "e-15606" :question/problem "Suppose $\\mid \\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}$. Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\\begin{array}{rl}{\\text{comp}}_{\\mathbf{b}} \\, \\mathbf{a} & = | \\, \\mathbf{a} \\, | \\cos   \\theta \\\\  & = 13 \\cos   ( \\frac{2 \\pi}{3} ) \\\\  & = 13 \\cdot  ( - \\frac{1}{2} ) \\\\  & = - \\frac{13}{2} .\\end{array}$$"}] [{:db/id #edb/ref 17592186105412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/id #uuid "da8a1521-86cc-5747-88a7-e2ec56010c11" :question/math-academy-id "e-15607" :question/problem "Let $\\mathbf{a}=\\langle 3,3,-1 \\rangle$ and $\\mathbf{b}=\\langle 2,-7,0 \\rangle$. Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\\begin{array}{rl}{\\text{comp}}_{\\mathbf{b}} \\, \\mathbf{a} & = \\frac{\\mathbf{a} \\cdot  \\mathbf{b}}{| \\, \\mathbf{b} \\, |} \\\\  & = \\frac{{a}_{x} {b}_{x} + {a}_{y} {b}_{y} + {a}_{z} {b}_{z}}{\\sqrt{{b}_{x}^{2} + {b}_{y}^{2} + {b}_{z}^{2}}} \\\\  & = \\frac{3 \\cdot  2 + 3 \\cdot  ( - 7 ) + ( - 1 ) \\cdot  0}{\\sqrt{{2}^{2} + ( - 7 {)}^{2} + {0}^{2}}} \\\\  & = - \\frac{15}{\\sqrt{53}} .\\end{array}$$"}] [{:db/id #edb/ref 17592186105413 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/id #uuid "4693b28f-df75-574e-8e49-bb89e162b107" :question/math-academy-id "e-15608" :question/problem "Let \n\n$$\n\\mathbf{a}=\\left[ \\begin{array}{c}0 \\\\ 0 \\\\ 1\\end{array}\\right]\n$$\n\n and \n\n$$\n\\mathbf{b}=\\left[ \\begin{array}{c}2 \\\\ - 4 \\\\ 0\\end{array}\\right].\n$$\n\n Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}$." :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\\begin{array}{rl}{\\text{comp}}_{\\mathbf{b}} \\, \\mathbf{a} & = \\frac{\\mathbf{a} \\cdot  \\mathbf{b}}{| \\, \\mathbf{b} \\, |} \\\\  & = \\frac{{a}_{x} {b}_{x} + {a}_{y} {b}_{y} + {c}_{z} {b}_{z}}{\\sqrt{{b}_{x}^{2} + {b}_{y}^{2} + {b}_{z}^{2}}} \\\\  & = \\frac{0 \\cdot  2 + 0 \\cdot  ( - 4 ) + 1 \\cdot  0}{\\sqrt{{2}^{2} + ( - 4 {)}^{2} + {0}^{2}}} \\\\  & = \\frac{0}{\\sqrt{{2}^{2} + ( - 4 {)}^{2} + {0}^{2}}} \\\\  & = 0.\\end{array}$$"}] [{:db/id #edb/ref 17592186286186 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c699610-261c-5695-b196-3999bf781137" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{\\sqrt{26}}" :db/id #edb/ref 17592186286188} {:answer/id #uuid "3f11c720-e046-523b-8dc7-c52f825eba0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{26}}" :db/id #edb/ref 17592186286189} {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} {:answer/id #uuid "ba533aff-71f4-54f1-a488-8e6bd6e66a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{14}}" :db/id #edb/ref 17592186286191} {:answer/id #uuid "08f2859a-5d24-534f-82e7-b3fbf2ac9ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{14}}" :db/id #edb/ref 17592186286192}] :answer-field/correct {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} :answer-field/id #uuid "c23d68cf-4f67-573a-91f0-15f4e696233a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286187}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26907092-d115-5133-80f7-1ed5a1bdc6ed" :question/math-academy-id "q-19139" :question/problem "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106134 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c57ffadb-4b3c-5e37-a582-3db44c3f5be2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186103037} {:answer/id #uuid "23135d70-addc-5580-aa35-c02c68832632" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186103038} {:answer/id #uuid "244f5799-8646-5b1f-b0d3-d3c608b45930" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186103039} {:answer/id #uuid "39e1f26d-f1c5-542c-a6da-ca05957526a6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186103040} {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041}] :answer-field/correct {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041} :answer-field/id #uuid "857c8ca0-e5aa-56ce-af4b-fdf9bb998e77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103036}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "71a079d2-97d0-5455-a26c-8d71df225e2c" :question/math-academy-id "q-236734" :question/problem "Let $p=⟨-1,1,2⟩$ and $q=⟨4,x,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 4+1\\cdot x+2\\cdot 1 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275262 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118c25ca-ff53-54d8-ab14-2aeeb4551f36" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275264} {:answer/id #uuid "ed259811-ee86-5e3f-9239-4e65aac0076e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275265} {:answer/id #uuid "53478fed-80e4-5b24-a4a3-fff977c9872a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275266} {:answer/id #uuid "f39e126e-efa6-554f-953c-331edb92410b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275267} {:answer/id #uuid "48f2d81b-3702-5e6f-bc84-6a13176b409e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275268}] :answer-field/correct {:answer/id #uuid "ed259811-ee86-5e3f-9239-4e65aac0076e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275265} :answer-field/id #uuid "112a0e5a-df0c-52f6-bfd3-c4935b7fa72c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275263}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "11400851-a7d6-5cf8-83fd-cf451a3727e6" :question/math-academy-id "q-237016" :question/problem "Let $a=[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}-2 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275286 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1db01d4-bed5-598f-b1cb-23662d49546b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186275288} {:answer/id #uuid "4131b337-e9ba-5d6d-b70a-05c861298c89" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275289}] :answer-field/correct {:answer/id #uuid "b1db01d4-bed5-598f-b1cb-23662d49546b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186275288} :answer-field/id #uuid "10069dba-1971-5c9d-9263-8c3c42a8b671" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275287}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "77ab9492-52e0-5744-9116-93405b825a7c" :question/math-academy-id "q-275247" :question/problem "Let $c=⟨4,-3,0⟩$ and $d=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$\n\n${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275300 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82968493-c570-54e4-9a22-dc990367e552" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275302}] :answer-field/correct {:answer/id #uuid "82968493-c570-54e4-9a22-dc990367e552" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275302} :answer-field/id #uuid "bc125a59-b82a-537c-bc27-b1603fec35b1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275301}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e3cf13f3-399e-5099-a24e-b2d19fcea90e" :question/math-academy-id "q-318975" :question/problem "Suppose $|\\,t\\,|=\\sqrt{2}$ and the angle between vectors $t$ and $u$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $t$ onto $u.$\n\n${\\text{comp}}_{u}\\,t=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{u}\\,t & =|\\,t\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}cos\\,(\\frac{3\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106407 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d696f98-faf1-5406-a712-34c26fad4044" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186104952} {:answer/id #uuid "97bfaf7f-e2ec-5548-a57d-f584e4439f46" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9\\sqrt{2}}{2}" :db/id #edb/ref 17592186104953} {:answer/id #uuid "9d866463-9d5a-55b9-8e35-dc5c2a5f3bbc" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186104954} {:answer/id #uuid "a2421de6-fcb0-5cc6-98a5-bdfa69d54ef0" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186104955} {:answer/id #uuid "518f8991-b553-5531-a39c-e0846bae8b2e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186104956}] :answer-field/correct {:answer/id #uuid "9d866463-9d5a-55b9-8e35-dc5c2a5f3bbc" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186104954} :answer-field/id #uuid "1baff159-3f74-5fe8-bd17-f124e27e7e51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104951}] :question/id #uuid "7617fec2-cebf-5dcc-8f77-3696984cb4f2" :question/math-academy-id "q-71532" :question/problem "Suppose $| \\, \\mathbf{c} \\, | = 18$ and the angle between vectors $c$ and $d$ is $\\theta  = \\frac{3\\pi }{4}$. Find the scalar projection of $c$ onto $d$."}]}
