#{[{:db/id #edb/ref 17592186105411 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/id #uuid "1a24b403-754c-5424-8182-8cad3487deed" :question/math-academy-id "e-15606" :question/problem "Suppose $|\\,\\mathbf{a}\\,|=13$ and the angle between vectors $\\mathbf{a}$ and $\\mathbf{b}$ is $\\theta = \\dfrac{2\\pi}{3}.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =|\\,a\\,|\\operatorname{cos}⁡\\theta  \\\\  & =13\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =13\\cdot (-\\frac{1}{2}) \\\\  & =-\\frac{13}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105412 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/id #uuid "da8a1521-86cc-5747-88a7-e2ec56010c11" :question/math-academy-id "e-15607" :question/problem "Let $\\mathbf{a}=\\langle 3,3,-1 \\rangle$ and $\\mathbf{b}=\\langle 2,-7,0 \\rangle.$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 2+3\\cdot (-7)+(-1)\\cdot 0}{\\sqrt{{2}^{2}+(-7)^{2}+{0}^{2}}} \\\\  & =-\\frac{15}{\\sqrt{53}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186105413 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/id #uuid "4693b28f-df75-574e-8e49-bb89e162b107" :question/math-academy-id "e-15608" :question/problem "Let $[\\begin{aligned}0 \\\\ 0 \\\\ 1\\end{aligned}]$ and $[\\begin{aligned}2 \\\\ -4 \\\\ 0\\end{aligned}]$ Find the scalar projection of $\\mathbf{a}$ onto $\\mathbf{b}.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{c}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{0\\cdot 2+0\\cdot (-4)+1\\cdot 0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =\\frac{0}{\\sqrt{{2}^{2}+(-4)^{2}+{0}^{2}}} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306508 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4fde6e52-84f8-5631-9278-f2c176ddaaed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{6}}" :db/id #edb/ref 17592186306510} {:answer/id #uuid "1db001f0-f195-5b63-8664-d56d132d5874" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186306511} {:answer/id #uuid "9c7d1b28-9c1b-544d-86c3-e937bebd487b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186306512} {:answer/id #uuid "2d538c90-14d2-5ed0-9a45-9453bcbc0b0a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186306513} {:answer/id #uuid "74c9140b-67ee-54e4-8221-e1b9e8770454" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186306514}] :answer-field/correct {:answer/id #uuid "74c9140b-67ee-54e4-8221-e1b9e8770454" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186306514} :answer-field/id #uuid "e521dd36-fbe1-5dfa-8732-d870d769383a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306509}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "31e97cf5-4193-5237-a0d0-eeb6b075de3b" :question/math-academy-id "q-101526" :question/problem "Let $a=⟨3,-1,-1⟩$ and $b=⟨4,4,2⟩.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 4+(-1)\\cdot 4+(-1)\\cdot 2}{\\sqrt{{4}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{6}{\\sqrt{36}} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306515 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b360b317-2ddd-56e7-bbce-073b28e9b7bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186306517} {:answer/id #uuid "f988322b-3a51-54f8-ae3e-96abc9d89d40" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{2}{7}" :db/id #edb/ref 17592186306518} {:answer/id #uuid "a291e390-37fa-55f4-bd08-e51118dc2ce1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186306519} {:answer/id #uuid "008c994d-d127-523c-954f-ee5e191f61d3" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{7}" :db/id #edb/ref 17592186306520} {:answer/id #uuid "d9e33301-a32b-5e8a-b475-3ff8dddcca16" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{4}{3}" :db/id #edb/ref 17592186306521}] :answer-field/correct {:answer/id #uuid "b360b317-2ddd-56e7-bbce-073b28e9b7bc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{16}{21}" :db/id #edb/ref 17592186306517} :answer-field/id #uuid "04de6a71-232e-5b57-822e-7fa6fe1505ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306516}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e1ea5a15-b955-5f56-9693-5d850452583a" :question/math-academy-id "q-101528" :question/problem "Let $a=⟨2,-1,2⟩$ and $b=⟨6,2,-3⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 6+(-1)\\cdot 2+2\\cdot (-3)}{\\sqrt{{6}^{2}+{2}^{2}+(-3)^{2}}} \\\\  & =\\frac{4}{\\sqrt{49}} \\\\  & =\\frac{4}{7}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{4}{\\sqrt{{2}^{2}+(-1)^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{4}{7}-\\frac{4}{3} \\\\  & =4(\\frac{1}{7}-\\frac{1}{3}) \\\\  & =4(\\frac{3}{21}-\\frac{7}{21}) \\\\  & =-\\frac{16}{21}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306522 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1673216b-bb5e-52ad-8245-a1e77f9c597e" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{5}{2}" :db/id #edb/ref 17592186306524} {:answer/id #uuid "2772a0b1-e181-5003-8b5e-23abe30938fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186306525} {:answer/id #uuid "b2a32fbd-75a8-514a-b32c-0a04392fc7b3" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186306526} {:answer/id #uuid "fe074ee6-6095-581e-b352-3f0baee13f40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306527} {:answer/id #uuid "e43dbf93-e54d-5dc8-ae7a-f6d7ad348ffa" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186306528}] :answer-field/correct {:answer/id #uuid "fe074ee6-6095-581e-b352-3f0baee13f40" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306527} :answer-field/id #uuid "30fdb03a-6e9a-598c-9c03-52813eb1ec68" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306523}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "458b532b-3f7c-52f5-a53e-7171e61fa055" :question/math-academy-id "q-126498" :question/problem "Suppose $|\\,c\\,|=5$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{cos}⁡(\\frac{\\pi }{2}) \\\\  & =5\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286186 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c699610-261c-5695-b196-3999bf781137" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{\\sqrt{26}}" :db/id #edb/ref 17592186286188} {:answer/id #uuid "3f11c720-e046-523b-8dc7-c52f825eba0a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{26}}" :db/id #edb/ref 17592186286189} {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} {:answer/id #uuid "ba533aff-71f4-54f1-a488-8e6bd6e66a13" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{14}}" :db/id #edb/ref 17592186286191} {:answer/id #uuid "08f2859a-5d24-534f-82e7-b3fbf2ac9ede" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{\\sqrt{14}}" :db/id #edb/ref 17592186286192}] :answer-field/correct {:answer/id #uuid "5cd6b170-da5f-508f-a233-6372ca4cf73d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{18}{\\sqrt{26}}" :db/id #edb/ref 17592186286190} :answer-field/id #uuid "c23d68cf-4f67-573a-91f0-15f4e696233a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286187}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "26907092-d115-5133-80f7-1ed5a1bdc6ed" :question/math-academy-id "q-19139" :question/problem "Let $a=⟨3,2,1⟩$ and $b=⟨3,4,1⟩.$ Find the scalar projection of $a$ onto $b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 3+2\\cdot 4+1\\cdot 1}{\\sqrt{{3}^{2}+{4}^{2}+{1}^{2}}} \\\\  & =\\frac{18}{\\sqrt{26}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306529 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bb6d4d7c-611c-5856-b908-bba404390130" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{29}{5}" :db/id #edb/ref 17592186306531} {:answer/id #uuid "1e8a47eb-8cf0-50a8-9725-56c5f083ddf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{29}{5}" :db/id #edb/ref 17592186306532} {:answer/id #uuid "d95743f7-829c-5e9b-89d9-7df6f46dc79d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{32}{5}" :db/id #edb/ref 17592186306533} {:answer/id #uuid "511015a1-8cb1-50c6-a054-0e37a6f3e7d9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{27}{10}" :db/id #edb/ref 17592186306534} {:answer/id #uuid "d2224e69-12b9-5002-a1d4-8017bf984593" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186306535}] :answer-field/correct {:answer/id #uuid "d2224e69-12b9-5002-a1d4-8017bf984593" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{63}{10}" :db/id #edb/ref 17592186306535} :answer-field/id #uuid "1ff4d9a8-f001-57b6-a079-27b34a6bd2da" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306530}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "12160eb7-66fc-562b-9de3-7b07d5dea29e" :question/math-academy-id "q-19147" :question/problem "Let $p=⟨1,4,2\\sqrt{2}⟩$ and $q=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106134 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c57ffadb-4b3c-5e37-a582-3db44c3f5be2" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186103037} {:answer/id #uuid "23135d70-addc-5580-aa35-c02c68832632" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186103038} {:answer/id #uuid "244f5799-8646-5b1f-b0d3-d3c608b45930" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186103039} {:answer/id #uuid "39e1f26d-f1c5-542c-a6da-ca05957526a6" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186103040} {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041}] :answer-field/correct {:answer/id #uuid "3ca51ccc-d6fb-5239-98b7-2b216c90ab6a" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186103041} :answer-field/id #uuid "857c8ca0-e5aa-56ce-af4b-fdf9bb998e77" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186103036}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "71a079d2-97d0-5455-a26c-8d71df225e2c" :question/math-academy-id "q-236734" :question/problem "Let $p=⟨-1,1,2⟩$ and $q=⟨4,x,1⟩.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 4+1\\cdot x+2\\cdot 1 \\\\  & =x-2.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275262 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "118c25ca-ff53-54d8-ab14-2aeeb4551f36" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186275264} {:answer/id #uuid "ed259811-ee86-5e3f-9239-4e65aac0076e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275265} {:answer/id #uuid "53478fed-80e4-5b24-a4a3-fff977c9872a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275266} {:answer/id #uuid "f39e126e-efa6-554f-953c-331edb92410b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275267} {:answer/id #uuid "48f2d81b-3702-5e6f-bc84-6a13176b409e" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186275268}] :answer-field/correct {:answer/id #uuid "ed259811-ee86-5e3f-9239-4e65aac0076e" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186275265} :answer-field/id #uuid "112a0e5a-df0c-52f6-bfd3-c4935b7fa72c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275263}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "11400851-a7d6-5cf8-83fd-cf451a3727e6" :question/math-academy-id "q-237016" :question/problem "Let $a=[\\begin{aligned}0 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}-2 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =0\\cdot (-2)+(-2)\\cdot x+1\\cdot 2 \\\\  & =2-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 2-2x & =0 \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306536 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b101b3f-c6df-5958-99f5-dfab47fa8f91" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186306538} {:answer/id #uuid "87146dc0-3dab-52f2-b5bd-ca1d90d6a906" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186306539} {:answer/id #uuid "9ac37fcf-5d73-51a8-a338-797820a98c13" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186306540} {:answer/id #uuid "b75b7a70-4ce9-5e24-b606-28754442b224" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186306541} {:answer/id #uuid "6ae1a565-5874-586e-8b19-742283f3a2c2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186306542}] :answer-field/correct {:answer/id #uuid "87146dc0-3dab-52f2-b5bd-ca1d90d6a906" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186306539} :answer-field/id #uuid "9dfef76b-3d7c-5a21-9af7-96825d86d539" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306537}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "290c0b6e-110d-5702-8100-9644b3d7d678" :question/math-academy-id "q-237017" :question/problem "Let $p=i-3j$ and $q=xi+2j+k.$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =1\\cdot x+(-3)\\cdot 2+0\\cdot 1 \\\\  & =x-6.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ x-6 & =0 \\\\ x & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275286 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b1db01d4-bed5-598f-b1cb-23662d49546b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186275288} {:answer/id #uuid "4131b337-e9ba-5d6d-b70a-05c861298c89" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186275289}] :answer-field/correct {:answer/id #uuid "b1db01d4-bed5-598f-b1cb-23662d49546b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186275288} :answer-field/id #uuid "10069dba-1971-5c9d-9263-8c3c42a8b671" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275287}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "77ab9492-52e0-5744-9116-93405b825a7c" :question/math-academy-id "q-275247" :question/problem "Let $c=⟨4,-3,0⟩$ and $d=⟨2,1,-2⟩.$ Find, ${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d.$\n\n${\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =\\frac{c\\cdot d}{|\\,d\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{d}_{x}^{2}+{d}_{y}^{2}+{d}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+(-3)\\cdot 1+0\\cdot (-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{5}{\\sqrt{9}} \\\\  & =\\frac{5}{3}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{c}\\,d & =\\frac{c\\cdot d}{|\\,c\\,|} \\\\  & =\\frac{{c}_{x}{d}_{x}+{c}_{y}{d}_{y}+{c}_{z}{d}_{z}}{\\sqrt{{c}_{x}^{2}+{c}_{y}^{2}+{c}_{z}^{2}}} \\\\  & =\\frac{5}{\\sqrt{{4}^{2}+(-3)^{2}+{0}^{2}}} \\\\  & =\\frac{5}{\\sqrt{25}} \\\\  & =\\frac{5}{5} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c-{\\text{comp}}_{c}\\,d & =\\frac{5}{3}-1 \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275300 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "82968493-c570-54e4-9a22-dc990367e552" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275302}] :answer-field/correct {:answer/id #uuid "82968493-c570-54e4-9a22-dc990367e552" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186275302} :answer-field/id #uuid "bc125a59-b82a-537c-bc27-b1603fec35b1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275301}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e3cf13f3-399e-5099-a24e-b2d19fcea90e" :question/math-academy-id "q-318975" :question/problem "Suppose $|\\,t\\,|=\\sqrt{2}$ and the angle between vectors $t$ and $u$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $t$ onto $u.$\n\n${\\text{comp}}_{u}\\,t=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{u}\\,t & =|\\,t\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{2}cos\\,(\\frac{3\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306543 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cc65785b-34f5-5d82-8abf-d50b1a52802d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306545}] :answer-field/correct {:answer/id #uuid "cc65785b-34f5-5d82-8abf-d50b1a52802d" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306545} :answer-field/id #uuid "09b44f63-7cc5-511a-b452-f39356a8bca0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306544}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "792f64da-3108-5664-8d5f-47cfdc363040" :question/math-academy-id "q-318976" :question/problem "Suppose $|\\,r\\,|=3\\sqrt{3}$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =3\\sqrt{3}cos\\,(\\frac{\\pi }{2}) \\\\  & =3\\sqrt{3}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306546 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20a08fcb-8d67-587b-908d-8bfaa6dc506a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186306548} {:answer/id #uuid "e3181933-1d04-52b3-ab3e-236ee829e388" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186306549}] :answer-field/correct {:answer/id #uuid "20a08fcb-8d67-587b-908d-8bfaa6dc506a" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186306548} :answer-field/id #uuid "77860c74-b969-57ea-ad6c-3e724a7c142e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306547}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "166b44a5-699d-55cc-b286-b547b1216d16" :question/math-academy-id "q-319253" :question/problem "Let $p=-4i+2j-3k$ and $q=5i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-4)\\cdot 5+2\\cdot x+(-3)\\cdot 0 \\\\  & =-20+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -20+2x & =0 \\\\ 2x & =20 \\\\ x & =10.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306550 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "763365f5-a7b6-56af-b499-6b49a8baba4b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306552}] :answer-field/correct {:answer/id #uuid "763365f5-a7b6-56af-b499-6b49a8baba4b" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186306552} :answer-field/id #uuid "916c3fb5-e064-5a36-ab58-9496664a59c7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306551}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f2a4a062-1d72-5aa1-8b04-33915ad48cf9" :question/math-academy-id "q-319255" :question/problem "Let $a=[\\begin{aligned}3 \\\\ -2 \\\\ 1\\end{aligned}]$ and $b=[\\begin{aligned}x \\\\ 1 \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $a$ is a nonzero vector, its scalar projection onto another nonzero vector $b$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\na⊥b\\,⟹\\,a\\cdot b=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}a\\cdot b & ={a}_{x}\\cdot {b}_{x}+{a}_{y}\\cdot {b}_{y}+{a}_{z}\\cdot {b}_{z} \\\\  & =3\\cdot x+(-2)\\cdot 1+1\\cdot 2 \\\\  & =3x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}a\\cdot b & =0 \\\\ 3x & =0 \\\\ x & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306553 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64231bcb-85a0-5d99-a07f-f0ae2d00ed47" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186306555} {:answer/id #uuid "87db763f-26ed-5e86-bdcf-aaa168960204" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186306556} {:answer/id #uuid "737a298e-1178-5176-9917-5a247026acf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186306557} {:answer/id #uuid "d3988143-21bc-5fd9-9ae3-c9dddd0be7d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186306558} {:answer/id #uuid "0a5eab95-605b-548a-b55b-6c64e444f676" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}}{2}" :db/id #edb/ref 17592186306559}] :answer-field/correct {:answer/id #uuid "d3988143-21bc-5fd9-9ae3-c9dddd0be7d2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186306558} :answer-field/id #uuid "e4f651eb-bdca-5b43-a084-bd1e41cb3d48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306554}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7006bff9-ec71-5325-92a8-f2ac48505ed1" :question/math-academy-id "q-71527" :question/problem "Suppose $|\\,p\\,|=\\sqrt{3}$ and the angle between vectors $p$ and $q$ is $\\theta =\\frac{\\pi }{6}.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =|\\,p\\,|\\operatorname{cos}⁡\\theta  \\\\  & =\\sqrt{3}\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =\\sqrt{3}\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =\\frac{3}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186106407 :knowledge-point/_questions [{:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6" :knowledge-point/title "Calculating a Scalar Projection Using Angles and Magnitudes"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d696f98-faf1-5406-a712-34c26fad4044" :answer/type {:db/ident :answer.type/math} :answer/value "-9" :db/id #edb/ref 17592186104952} {:answer/id #uuid "97bfaf7f-e2ec-5548-a57d-f584e4439f46" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{9\\sqrt{2}}{2}" :db/id #edb/ref 17592186104953} {:answer/id #uuid "9d866463-9d5a-55b9-8e35-dc5c2a5f3bbc" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186104954} {:answer/id #uuid "a2421de6-fcb0-5cc6-98a5-bdfa69d54ef0" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186104955} {:answer/id #uuid "518f8991-b553-5531-a39c-e0846bae8b2e" :answer/type {:db/ident :answer.type/math} :answer/value "9\\sqrt{2}" :db/id #edb/ref 17592186104956}] :answer-field/correct {:answer/id #uuid "9d866463-9d5a-55b9-8e35-dc5c2a5f3bbc" :answer/type {:db/ident :answer.type/math} :answer/value "-9\\sqrt{2}" :db/id #edb/ref 17592186104954} :answer-field/id #uuid "1baff159-3f74-5fe8-bd17-f124e27e7e51" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186104951}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7617fec2-cebf-5dcc-8f77-3696984cb4f2" :question/math-academy-id "q-71532" :question/problem "Suppose $|\\,c\\,|=18$ and the angle between vectors $c$ and $d$ is $\\theta =\\frac{3\\pi }{4}.$ Find the scalar projection of $c$ onto $d.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{d}\\,c & =|\\,c\\,|\\operatorname{cos}⁡\\theta  \\\\  & =18\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =18\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-9\\sqrt{2}.\\end{aligned}\n$$"}]}
