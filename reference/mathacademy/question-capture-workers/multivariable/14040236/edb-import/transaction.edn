|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 4+(-1)\\cdot 4+(-1)\\cdot 2}{\\sqrt{{4}^{2}+{4}^{2}+{2}^{2}}} \\\\  & =\\frac{6}{\\sqrt{36}} \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-101526/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-101526"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19147/selection/0f8b74c49644da77a807dfffb16b9321258eff44c895199ae7f83bed0fa9378a" :answer/id #uuid "bb6d4d7c-611c-5856-b908-bba404390130" :answer/type :answer.type/math :answer/value "-\\frac{29}{5}" :db/ensure [:answer/validate]} {:db/id "q-19147/selection/521c25b61dc999888e4121703de686f5ce515c7330b676a58797545d23210e58" :answer/id #uuid "1e8a47eb-8cf0-50a8-9725-56c5f083ddf0" :answer/type :answer.type/math :answer/value "\\frac{29}{5}" :db/ensure [:answer/validate]} {:db/id "q-19147/selection/71d62b021618a1784d909d243d6b79e7103b06d8835499c7e3354d1d71863221" :answer/id #uuid "d95743f7-829c-5e9b-89d9-7df6f46dc79d" :answer/type :answer.type/math :answer/value "\\frac{32}{5}" :db/ensure [:answer/validate]} {:db/id "q-19147/selection/dcce20d52e96452662431a8439c98dd6071346e39b17ea491a35a4dcc1d3e70f" :answer/id #uuid "d2224e69-12b9-5002-a1d4-8017bf984593" :answer/type :answer.type/math :answer/value "\\frac{63}{10}" :db/ensure [:answer/validate]} {:db/id "q-19147/selection/c1e4a5d5803fd0e609349156c0e0e24f1882bbb4193b8ef42a448145c5df48d4" :answer/id #uuid "511015a1-8cb1-50c6-a054-0e37a6f3e7d9" :answer/type :answer.type/math :answer/value "\\frac{27}{10}" :db/ensure [:answer/validate]} {:db/id "q-19147/selection" :answer-field/id #uuid "1ff4d9a8-f001-57b6-a079-27b34a6bd2da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19147/selection/dcce20d52e96452662431a8439c98dd6071346e39b17ea491a35a4dcc1d3e70f" :answer-field/choices ["q-19147/selection/0f8b74c49644da77a807dfffb16b9321258eff44c895199ae7f83bed0fa9378a" "q-19147/selection/521c25b61dc999888e4121703de686f5ce515c7330b676a58797545d23210e58" "q-19147/selection/71d62b021618a1784d909d243d6b79e7103b06d8835499c7e3354d1d71863221" "q-19147/selection/dcce20d52e96452662431a8439c98dd6071346e39b17ea491a35a4dcc1d3e70f" "q-19147/selection/c1e4a5d5803fd0e609349156c0e0e24f1882bbb4193b8ef42a448145c5df48d4"] :db/ensure [:answer-field/validate]} {:db/id "q-19147" :question/id #uuid "12160eb7-66fc-562b-9de3-7b07d5dea29e" :question/math-academy-id "q-19147" :question/problem "Let $p=⟨1,4,2\\sqrt{2}⟩$ and $q=⟨1,1,\\sqrt{2}⟩.$ Find ${\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{1\\cdot 1+4\\cdot 1+2\\sqrt{2}\\cdot \\sqrt{2}}{\\sqrt{{1}^{2}+{1}^{2}+(\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{4}} \\\\  & =\\frac{9}{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{p}\\,q & =\\frac{p\\cdot q}{|\\,p\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{p}_{x}^{2}+{p}_{y}^{2}+{p}_{z}^{2}}} \\\\  & =\\frac{9}{\\sqrt{{1}^{2}+{4}^{2}+(2\\sqrt{2})^{2}}} \\\\  & =\\frac{9}{\\sqrt{25}} \\\\  & =\\frac{9}{5}.\\end{aligned}\n$$\n\nTherefore\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p+{\\text{comp}}_{p}\\,q & =\\frac{9}{2}+\\frac{9}{5} \\\\  & =9(\\frac{1}{2}+\\frac{1}{5}) \\\\  & =9(\\frac{5}{10}+\\frac{2}{10}) \\\\  & =\\frac{63}{10}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19147/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-19147"] :db/ens