e [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-126498"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318976/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "cc65785b-34f5-5d82-8abf-d50b1a52802d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-318976/field-1" :answer-field/id #uuid "09b44f63-7cc5-511a-b452-f39356a8bca0" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318976/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-318976/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-318976" :question/id #uuid "792f64da-3108-5664-8d5f-47cfdc363040" :question/math-academy-id "q-318976" :question/problem "Suppose $|\\,r\\,|=3\\sqrt{3}$ and the angle between vectors $r$ and $s$ is $\\theta =\\frac{\\pi }{2}.$ Find the scalar projection of $r$ onto $s.$\n\n${\\text{comp}}_{s}\\,r=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we have\n\n$$\n\\begin{aligned}{\\text{comp}}_{s}\\,r & =|\\,r\\,|\\operatorname{cos}⁡\\theta  \\\\  & =3\\sqrt{3}cos\\,(\\frac{\\pi }{2}) \\\\  & =3\\sqrt{3}\\cdot 0 \\\\  & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318976/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e598ad1e-cee5-5d5f-b2a9-c067e4625cf6"] :knowledge-point/questions ["q-318976"] :db/ensure [:knowledge-point/validate]} {:db/id "q-101526/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "1db001f0-f195-5b63-8664-d56d132d5874" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-101526/selection/77d5aaaa7e3f72fdb6025b9f9fc67702975aeaaed9281c12