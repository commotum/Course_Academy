[{:db/id "q-39422/selection/59e0c2385e3a99331233dd433e03451c25fad25cb0d7b90df55de1cbc0ae8c3a" :answer/id #uuid "b471ab24-ab0d-524f-8626-0455780560f0" :answer/type :answer.type/math :answer/value "-2+\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-39422/selection/d762fcdb3c094c00f3e3ad98957b4879828c269e306ca34cefeedd793a97aa15" :answer/id #uuid "12c89997-0a6c-506e-9856-34a212a64834" :answer/type :answer.type/math :answer/value "-4-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-39422/selection/85aa965640aba9bcb1eb584cf5dd96ebd6aa564058946250528a7660b311a583" :answer/id #uuid "03b659a3-aaff-5092-9265-1e62f77fa885" :answer/type :answer.type/math :answer/value "1-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-39422/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "3b680060-b1c7-55c4-88eb-a4c880d95863" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-39422/selection/f1870eca1026ad3509b61838478aa63761dc3f326eade31fe2846d78ea351b77" :answer/id #uuid "a7af635f-3545-5846-b9c5-1da977e6daaf" :answer/type :answer.type/math :answer/value "2-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-39422/selection" :answer-field/id #uuid "c5584c01-3148-540c-b5e3-008fa9ec8104" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-39422/selection/f1870eca1026ad3509b61838478aa63761dc3f326eade31fe2846d78ea351b77" :answer-field/choices ["q-39422/selection/59e0c2385e3a99331233dd433e03451c25fad25cb0d7b90df55de1cbc0ae8c3a" "q-39422/selection/d762fcdb3c094c00f3e3ad98957b4879828c269e306ca34cefeedd793a97aa15" "q-39422/selection/85aa965640aba9bcb1eb584cf5dd96ebd6aa564058946250528a7660b311a583" "q-39422/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-39422/selection/f1870eca1026ad3509b61838478aa63761dc3f326eade31fe2846d78ea351b77"] :db/ensure [:answer-field/validate]} {:db/id "q-39422" :question/id #uuid "8aa84b06-fe62-591a-9b9c-4089fba53bfd" :question/math-academy-id "q-39422" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y)=(y\\operatorname{sin}⁡x)\\,i+(x+y)\\,j$ and $C$ is the path  $r(t)=\\operatorname{arcsin}⁡t\\,i+2j$ for $t\\in [0,\\frac{1}{2}].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=\\operatorname{arcsin}⁡t,\\,y=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =2\\operatorname{sin}⁡(\\operatorname{arcsin}⁡t)\\,i+(\\operatorname{arcsin}⁡t+2)\\,j \\\\  & =2t\\,i+(\\operatorname{arcsin}⁡t+2)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arcsin}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2)j \\\\  & =\\frac{1}{\\sqrt{1-{t}^{2}}}\\,i.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(2t\\,i+(\\operatorname{arcsin}⁡t+2)\\,j)\\cdot (\\frac{1}{\\sqrt{1-{t}^{2}}}\\,i) \\\\  & =\\frac{2t}{\\sqrt{1-{t}^{2}}}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{1/2}f(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1/2}\\frac{2t}{\\sqrt{1-{t}^{2}}}\\,dt \\\\  & =-2\\sqrt{1-{t}^{2}}\\,{|}_{0}^{1/2} \\\\  & =-2(\\sqrt{1-{(\\frac{1}{2})}^{2}}-1) \\\\  & =2-\\sqrt{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-39422/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16a9183a-68b4-5bad-b2d8-3bcf6597f263"] :knowledge-point/questions ["q-39422"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124669/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "573741cb-d3bf-5205-9999-7e7a25c1a959" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-124669/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "3c09a3fe-b5b3-5745-bbe3-45d087eaac70" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-124669/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "47da9d3f-e8f2-562c-af04-2592b8b6bb76" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-124669/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c668debb-3f67-55bf-8761-dd75051c06ce" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-124669/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "8e635146-9f51-5d21-a0b0-715792fb776d" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-124669/selection" :answer-field/id #uuid "7ce104c6-60ae-51d1-9713-a0e473da7571" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124669/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-124669/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-124669/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-124669/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-124669/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-124669/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-124669" :question/id #uuid "319ea04d-1637-5773-b8c1-a193af4e0ec8" :question/math-academy-id "q-124669" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y,z)=(x+z)\\,i+(z-y)\\,j+{z}^{2}\\,k$ and $C$ is the path $r(t)={t}^{2}\\,i+3{t}^{2}\\,j+2t\\,k$ for $t\\in [0,1].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx={t}^{2},\\,y=3{t}^{2},\\,z=2t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(2t+{t}^{2})\\,i+(2t-3{t}^{2})\\,j+(2t)^{2}\\,k \\\\  & =(2t+{t}^{2})\\,i+(2t-3{t}^{2})\\,j+4{t}^{2}\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})i+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})j+\\frac{\\text{d}}{\\text{d}t}(2t)j \\\\  & =2ti+6t\\,j+2\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =((2t+{t}^{2})\\,i+(2t-3{t}^{2})\\,j+4{t}^{2}\\,k)\\cdot (2ti+6t\\,j+2\\,k) \\\\  & =4{t}^{2}+2{t}^{3}+12{t}^{2}-18{t}^{3}+8{t}^{2} \\\\  & =24{t}^{2}-16{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(24{t}^{2}-16{t}^{3})\\,dt \\\\  & ={8{t}^{3}-4{t}^{4}|}_{0}^{1} \\\\  & =8-4 \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-124669/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2900032e-de37-5c3e-a03a-be6b892976db"] :knowledge-point/questions ["q-124669"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124691/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "40666354-d2ce-54ba-866a-9fe0630d6dbb" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-124691/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ebff1a52-8adc-5fd6-851c-95ce20169f9e" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-124691/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "7faa78cb-4358-5649-b0c2-e12cd14020ba" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-124691/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" :answer/id #uuid "1fb16e04-9231-566a-98c4-7b2aa57888f8" :answer/type :answer.type/math :answer/value "2{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-124691/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" :answer/id #uuid "993e80d9-9539-54db-a0e8-3283100d58d6" :answer/type :answer.type/math :answer/value "{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-124691/selection" :answer-field/id #uuid "457c7324-3189-5b8d-b899-2087b4b99ba0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124691/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" :answer-field/choices ["q-124691/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" "q-124691/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-124691/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-124691/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" "q-124691/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8"] :db/ensure [:answer-field/validate]} {:db/id "q-124691" :question/id #uuid "dce16c9b-1c91-5d9e-b352-bfb9ff29e134" :question/math-academy-id "q-124691" :question/problem "Evaluate  ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y)=x\\,i+y\\,j$ and $C$ is the path $r(t)=t\\operatorname{sin}⁡t\\,i+t\\operatorname{cos}⁡t\\,j$ for $t\\in [0,2\\pi ].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t\\operatorname{sin}⁡t,\\,y=t\\operatorname{cos}⁡t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i+y\\,j \\\\  & =t\\operatorname{sin}⁡t\\,i+t\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t)j \\\\  & =(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(t\\operatorname{sin}⁡t\\,i+t\\operatorname{cos}⁡t\\,j)\\cdot ((\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j) \\\\  & =t\\operatorname{sin}⁡t(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)+t\\operatorname{cos}⁡t(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =t{sin}^{2}⁡t+{t}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t+t{cos}^{2}⁡t-{t}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =t({sin}^{2}⁡t+{cos}^{2}⁡t) \\\\  & =t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }f(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }t\\,dt \\\\  & =\\frac{{t}^{2}}{2}\\,{|}_{0}^{2\\pi } \\\\  & =\\frac{(2\\pi )^{2}}{2}-0 \\\\  & =2{\\pi }^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124691/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16a9183a-68b4-5bad-b2d8-3bcf6597f263"] :knowledge-point/questions ["q-124691"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124696/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3019576e-e6ec-5ccb-a9a9-13f3606ebec0" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-124696/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" :answer/id #uuid "99356230-7831-5c86-a1ca-ba80d1c3476a" :answer/type :answer.type/math :answer/value "-11" :db/ensure [:answer/validate]} {:db/id "q-124696/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "653b20a6-222c-5d07-953e-4724d31c65f6" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-124696/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "17cb0565-1b0a-519b-915c-979bfd95ae68" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-124696/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "11ada30b-04b8-5d7f-936c-e8d11a5aca2d" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-124696/selection" :answer-field/id #uuid "e6ee9230-f953-5130-867a-9d340bb6cc9c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124696/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-124696/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-124696/selection/23c0b4da815e7ba954fedc5e75955047cfe471feec4d2029849a63511c000fa3" "q-124696/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-124696/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-124696/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-124696" :question/id #uuid "a7d30c22-8246-51dd-afa0-09d0f9f35f52" :question/math-academy-id "q-124696" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y)=\\frac{y+1}{x}\\,i-\\frac{2(x-1)}{y}\\,j$ and $C$ is the path $r(t)={t}^{2}\\,i+(t-1)\\,j$ for $t\\in [3,4].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx={t}^{2},\\,y=t-1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =\\frac{y+1}{x}\\,i-\\frac{2(x-1)}{y}\\,j \\\\  & =\\frac{(t-1)+1}{{t}^{2}}\\,i-\\frac{2({t}^{2}-1)}{t-1}\\,j \\\\  & =\\frac{1}{t}\\,i-2(t+1)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})i+\\frac{\\text{d}}{\\text{d}t}(t-1)j \\\\  & =2t\\,i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\frac{1}{t}\\,i-2(t+1)\\,j)\\cdot (2t\\,i+j) \\\\  & =\\frac{1}{t}\\cdot 2t-2(t+1)\\cdot 1 \\\\  & =2-2(t+1)\\cdot 1 \\\\  & =-2t.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{3}^{4}f(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{3}^{4}(-2t)\\,dt \\\\  & ={[-{t}^{2}]}_{3}^{4} \\\\  & =[-16+9] \\\\  & =-7\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124696/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "16a9183a-68b4-5bad-b2d8-3bcf6597f263"] :knowledge-point/questions ["q-124696"] :db/ensure [:knowledge-point/validate]} {:db/id "q-165421/selection/935f7eda41ab1e1576b346c5399d5dda13709739343485e5abfd1cfaa8416044" :answer/id #uuid "69752267-25da-58bd-9bdd-3c9947259161" :answer/type :answer.type/math :answer/value "\\frac{10\\sqrt{2}+45}{6}" :db/ensure [:answer/validate]} {:db/id "q-165421/selection/d7d9966a72c65e519c2d22c5eeac6380f32b6f60ee2aadad32c4149f17212e78" :answer/id #uuid "c09c38dd-f789-5d8a-b8be-cf5d2a8153cc" :answer/type :answer.type/math :answer/value "\\frac{5\\sqrt{2}+31}{6}" :db/ensure [:answer/validate]} {:db/id "q-165421/selection/be51b31a62e4455493f04d7f1066b3ba850558d8d3e28cb12203175f198fffe4" :answer/id #uuid "d3ca97a3-aa40-56ae-83b7-c765f4ada16c" :answer/type :answer.type/math :answer/value "\\frac{8\\sqrt{2}+47}{6}" :db/ensure [:answer/validate]} {:db/id "q-165421/selection/b756b67cd2d703e97f99fe5aa586268798a411fa70a1b1364480a7eaa50acd6f" :answer/id #uuid "2c19b839-9a10-5147-a62f-1f9b959a9cf5" :answer/type :answer.type/math :answer/value "\\frac{16\\sqrt{2}+37}{6}" :db/ensure [:answer/validate]} {:db/id "q-165421/selection/fa2c4984d3a4d9f0624c943eacafc3ecbc535e982516124444d2667c590ef189" :answer/id #uuid "cb5174e8-5782-5e5d-9066-0d982cbe5463" :answer/type :answer.type/math :answer/value "\\frac{7\\sqrt{2}+32}{6}" :db/ensure [:answer/validate]} {:db/id "q-165421/selection" :answer-field/id #uuid "1df3633a-a3bd-5e70-ab18-9f09768f1f2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-165421/selection/b756b67cd2d703e97f99fe5aa586268798a411fa70a1b1364480a7eaa50acd6f" :answer-field/choices ["q-165421/selection/935f7eda41ab1e1576b346c5399d5dda13709739343485e5abfd1cfaa8416044" "q-165421/selection/d7d9966a72c65e519c2d22c5eeac6380f32b6f60ee2aadad32c4149f17212e78" "q-165421/selection/be51b31a62e4455493f04d7f1066b3ba850558d8d3e28cb12203175f198fffe4" "q-165421/selection/b756b67cd2d703e97f99fe5aa586268798a411fa70a1b1364480a7eaa50acd6f" "q-165421/selection/fa2c4984d3a4d9f0624c943eacafc3ecbc535e982516124444d2667c590ef189"] :db/ensure [:answer-field/validate]} {:db/id "q-165421" :question/id #uuid "8428a8a2-892a-5703-b6ea-b11b3285ab85" :question/math-academy-id "q-165421" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y,z)=\\sqrt{x}\\,i+\\sqrt{y}\\,j+z\\,k$ and $C$ is the path $r(t)=t\\,i+t\\,j+{t}^{2}\\,k$ for $t\\in [1,2].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t,\\,y=t,\\,z={t}^{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =\\sqrt{x}\\,i+\\sqrt{y}\\,j+z\\,k \\\\  & =\\sqrt{t}\\,i+\\sqrt{t}\\,j+{t}^{2}\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(t)j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =i+j+2t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\sqrt{t}\\,i+\\sqrt{t}\\,j+{t}^{2}\\,k)\\cdot (i+j+2t\\,k) \\\\  & =\\sqrt{t}+\\sqrt{t}+2{t}^{3} \\\\  & =2\\sqrt{t}+2{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{1}^{2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}(2\\sqrt{t}+2{t}^{3})\\,dt \\\\  & ={[\\frac{4}{3}{t}^{3/2}+\\frac{{t}^{4}}{2}]}_{1}^{2} \\\\  & =\\frac{4}{3}\\cdot 2\\sqrt{2}+8-\\frac{4}{3}-\\frac{1}{2} \\\\  & =\\frac{16\\sqrt{2}+37}{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-165421/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2900032e-de37-5c3e-a03a-be6b892976db"] :knowledge-point/questions ["q-165421"] :db/ensure [:knowledge-point/validate]}]
