#{[{:db/id #edb/ref 17592186345328 :knowledge-point/_questions [{:knowledge-point/id #uuid "2900032e-de37-5c3e-a03a-be6b892976db" :knowledge-point/title "Evaluating Line Integrals of Vector-Valued Functions Over Space Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "47da9d3f-e8f2-562c-af04-2592b8b6bb76" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186345330} {:answer/id #uuid "573741cb-d3bf-5205-9999-7e7a25c1a959" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186345331} {:answer/id #uuid "8e635146-9f51-5d21-a0b0-715792fb776d" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186345332} {:answer/id #uuid "c668debb-3f67-55bf-8761-dd75051c06ce" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186345333} {:answer/id #uuid "3c09a3fe-b5b3-5745-bbe3-45d087eaac70" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186345334}] :answer-field/correct {:answer/id #uuid "c668debb-3f67-55bf-8761-dd75051c06ce" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186345333} :answer-field/id #uuid "7ce104c6-60ae-51d1-9713-a0e473da7571" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345329}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "319ea04d-1637-5773-b8c1-a193af4e0ec8" :question/math-academy-id "q-124669" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y,z)=(x+z)\\,i+(z-y)\\,j+{z}^{2}\\,k$ and $C$ is the path $r(t)={t}^{2}\\,i+3{t}^{2}\\,j+2t\\,k$ for $t\\in [0,1].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx={t}^{2},\\,y=3{t}^{2},\\,z=2t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =(2t+{t}^{2})\\,i+(2t-3{t}^{2})\\,j+(2t)^{2}\\,k \\\\  & =(2t+{t}^{2})\\,i+(2t-3{t}^{2})\\,j+4{t}^{2}\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})i+\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})j+\\frac{\\text{d}}{\\text{d}t}(2t)j \\\\  & =2ti+6t\\,j+2\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =((2t+{t}^{2})\\,i+(2t-3{t}^{2})\\,j+4{t}^{2}\\,k)\\cdot (2ti+6t\\,j+2\\,k) \\\\  & =4{t}^{2}+2{t}^{3}+12{t}^{2}-18{t}^{3}+8{t}^{2} \\\\  & =24{t}^{2}-16{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{1}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(24{t}^{2}-16{t}^{3})\\,dt \\\\  & ={8{t}^{3}-4{t}^{4}|}_{0}^{1} \\\\  & =8-4 \\\\  & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345335 :knowledge-point/_questions [{:knowledge-point/id #uuid "16a9183a-68b4-5bad-b2d8-3bcf6597f263" :knowledge-point/title "Evaluating Line Integrals of a Vector-Valued Functions Over Plane Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ebff1a52-8adc-5fd6-851c-95ce20169f9e" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186345337} {:answer/id #uuid "40666354-d2ce-54ba-866a-9fe0630d6dbb" :answer/type {:db/ident :answer.type/math} :answer/value "\\pi " :db/id #edb/ref 17592186345338} {:answer/id #uuid "1fb16e04-9231-566a-98c4-7b2aa57888f8" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186345339} {:answer/id #uuid "7faa78cb-4358-5649-b0c2-e12cd14020ba" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186345340} {:answer/id #uuid "993e80d9-9539-54db-a0e8-3283100d58d6" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186345341}] :answer-field/correct {:answer/id #uuid "1fb16e04-9231-566a-98c4-7b2aa57888f8" :answer/type {:db/ident :answer.type/math} :answer/value "2{\\pi }^{2}" :db/id #edb/ref 17592186345339} :answer-field/id #uuid "457c7324-3189-5b8d-b899-2087b4b99ba0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345336}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "dce16c9b-1c91-5d9e-b352-bfb9ff29e134" :question/math-academy-id "q-124691" :question/problem "Evaluate  ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y)=x\\,i+y\\,j$ and $C$ is the path $r(t)=t\\operatorname{sin}⁡t\\,i+t\\operatorname{cos}⁡t\\,j$ for $t\\in [0,2\\pi ].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t\\operatorname{sin}⁡t,\\,y=t\\operatorname{cos}⁡t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =x\\,i+y\\,j \\\\  & =t\\operatorname{sin}⁡t\\,i+t\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t)j \\\\  & =(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(t\\operatorname{sin}⁡t\\,i+t\\operatorname{cos}⁡t\\,j)\\cdot ((\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j) \\\\  & =t\\operatorname{sin}⁡t(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)+t\\operatorname{cos}⁡t(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =t{sin}^{2}⁡t+{t}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t+t{cos}^{2}⁡t-{t}^{2}\\operatorname{sin}⁡t\\operatorname{cos}⁡t \\\\  & =t({sin}^{2}⁡t+{cos}^{2}⁡t) \\\\  & =t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{2\\pi }f(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }t\\,dt \\\\  & =\\frac{{t}^{2}}{2}\\,{|}_{0}^{2\\pi } \\\\  & =\\frac{(2\\pi )^{2}}{2}-0 \\\\  & =2{\\pi }^{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345342 :knowledge-point/_questions [{:knowledge-point/id #uuid "16a9183a-68b4-5bad-b2d8-3bcf6597f263" :knowledge-point/title "Evaluating Line Integrals of a Vector-Valued Functions Over Plane Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99356230-7831-5c86-a1ca-ba80d1c3476a" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186345344} {:answer/id #uuid "11ada30b-04b8-5d7f-936c-e8d11a5aca2d" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186345345} {:answer/id #uuid "653b20a6-222c-5d07-953e-4724d31c65f6" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186345346} {:answer/id #uuid "3019576e-e6ec-5ccb-a9a9-13f3606ebec0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186345347} {:answer/id #uuid "17cb0565-1b0a-519b-915c-979bfd95ae68" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186345348}] :answer-field/correct {:answer/id #uuid "11ada30b-04b8-5d7f-936c-e8d11a5aca2d" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186345345} :answer-field/id #uuid "e6ee9230-f953-5130-867a-9d340bb6cc9c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345343}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a7d30c22-8246-51dd-afa0-09d0f9f35f52" :question/math-academy-id "q-124696" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y)=\\frac{y+1}{x}\\,i-\\frac{2(x-1)}{y}\\,j$ and $C$ is the path $r(t)={t}^{2}\\,i+(t-1)\\,j$ for $t\\in [3,4].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx={t}^{2},\\,y=t-1.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =\\frac{y+1}{x}\\,i-\\frac{2(x-1)}{y}\\,j \\\\  & =\\frac{(t-1)+1}{{t}^{2}}\\,i-\\frac{2({t}^{2}-1)}{t-1}\\,j \\\\  & =\\frac{1}{t}\\,i-2(t+1)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})i+\\frac{\\text{d}}{\\text{d}t}(t-1)j \\\\  & =2t\\,i+j.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\frac{1}{t}\\,i-2(t+1)\\,j)\\cdot (2t\\,i+j) \\\\  & =\\frac{1}{t}\\cdot 2t-2(t+1)\\cdot 1 \\\\  & =2-2(t+1)\\cdot 1 \\\\  & =-2t.\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{3}^{4}f(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{3}^{4}(-2t)\\,dt \\\\  & ={[-{t}^{2}]}_{3}^{4} \\\\  & =[-16+9] \\\\  & =-7\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345349 :knowledge-point/_questions [{:knowledge-point/id #uuid "2900032e-de37-5c3e-a03a-be6b892976db" :knowledge-point/title "Evaluating Line Integrals of Vector-Valued Functions Over Space Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "69752267-25da-58bd-9bdd-3c9947259161" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10\\sqrt{2}+45}{6}" :db/id #edb/ref 17592186345351} {:answer/id #uuid "2c19b839-9a10-5147-a62f-1f9b959a9cf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16\\sqrt{2}+37}{6}" :db/id #edb/ref 17592186345352} {:answer/id #uuid "d3ca97a3-aa40-56ae-83b7-c765f4ada16c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8\\sqrt{2}+47}{6}" :db/id #edb/ref 17592186345353} {:answer/id #uuid "c09c38dd-f789-5d8a-b8be-cf5d2a8153cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5\\sqrt{2}+31}{6}" :db/id #edb/ref 17592186345354} {:answer/id #uuid "cb5174e8-5782-5e5d-9066-0d982cbe5463" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\sqrt{2}+32}{6}" :db/id #edb/ref 17592186345355}] :answer-field/correct {:answer/id #uuid "2c19b839-9a10-5147-a62f-1f9b959a9cf5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16\\sqrt{2}+37}{6}" :db/id #edb/ref 17592186345352} :answer-field/id #uuid "1df3633a-a3bd-5e70-ab18-9f09768f1f2a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345350}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8428a8a2-892a-5703-b6ea-b11b3285ab85" :question/math-academy-id "q-165421" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y,z)=\\sqrt{x}\\,i+\\sqrt{y}\\,j+z\\,k$ and $C$ is the path $r(t)=t\\,i+t\\,j+{t}^{2}\\,k$ for $t\\in [1,2].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=t,\\,y=t,\\,z={t}^{2}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =\\sqrt{x}\\,i+\\sqrt{y}\\,j+z\\,k \\\\  & =\\sqrt{t}\\,i+\\sqrt{t}\\,j+{t}^{2}\\,k.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(t)j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})j \\\\  & =i+j+2t\\,k.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(\\sqrt{t}\\,i+\\sqrt{t}\\,j+{t}^{2}\\,k)\\cdot (i+j+2t\\,k) \\\\  & =\\sqrt{t}+\\sqrt{t}+2{t}^{3} \\\\  & =2\\sqrt{t}+2{t}^{3}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{1}^{2}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}(2\\sqrt{t}+2{t}^{3})\\,dt \\\\  & ={[\\frac{4}{3}{t}^{3/2}+\\frac{{t}^{4}}{2}]}_{1}^{2} \\\\  & =\\frac{4}{3}\\cdot 2\\sqrt{2}+8-\\frac{4}{3}-\\frac{1}{2} \\\\  & =\\frac{16\\sqrt{2}+37}{6}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186345356 :knowledge-point/_questions [{:knowledge-point/id #uuid "16a9183a-68b4-5bad-b2d8-3bcf6597f263" :knowledge-point/title "Evaluating Line Integrals of a Vector-Valued Functions Over Plane Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b680060-b1c7-55c4-88eb-a4c880d95863" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186345358} {:answer/id #uuid "b471ab24-ab0d-524f-8626-0455780560f0" :answer/type {:db/ident :answer.type/math} :answer/value "-2+\\sqrt{3}" :db/id #edb/ref 17592186345359} {:answer/id #uuid "03b659a3-aaff-5092-9265-1e62f77fa885" :answer/type {:db/ident :answer.type/math} :answer/value "1-\\sqrt{3}" :db/id #edb/ref 17592186345360} {:answer/id #uuid "12c89997-0a6c-506e-9856-34a212a64834" :answer/type {:db/ident :answer.type/math} :answer/value "-4-\\sqrt{2}" :db/id #edb/ref 17592186345361} {:answer/id #uuid "a7af635f-3545-5846-b9c5-1da977e6daaf" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{3}" :db/id #edb/ref 17592186345362}] :answer-field/correct {:answer/id #uuid "a7af635f-3545-5846-b9c5-1da977e6daaf" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{3}" :db/id #edb/ref 17592186345362} :answer-field/id #uuid "c5584c01-3148-540c-b5e3-008fa9ec8104" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186345357}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8aa84b06-fe62-591a-9b9c-4089fba53bfd" :question/math-academy-id "q-39422" :question/problem "Evaluate ${\\int }_{C}F\\cdot \\text{d}r$ given that $F(x,y)=(y\\operatorname{sin}⁡x)\\,i+(x+y)\\,j$ and $C$ is the path  $r(t)=\\operatorname{arcsin}⁡t\\,i+2j$ for $t\\in [0,\\frac{1}{2}].$" :question/worked-solution "We will use the formula\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{a}^{b}F(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t.\n$$\n\nAlong the curve $C,$ we have \n\n$$\nx=\\operatorname{arcsin}⁡t,\\,y=2.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t)) & =2\\operatorname{sin}⁡(\\operatorname{arcsin}⁡t)\\,i+(\\operatorname{arcsin}⁡t+2)\\,j \\\\  & =2t\\,i+(\\operatorname{arcsin}⁡t+2)\\,j.\\end{aligned}\n$$\n\nComputing ${r}^{′}(t),$ we get \n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{arcsin}⁡t)i+\\frac{\\text{d}}{\\text{d}t}(2)j \\\\  & =\\frac{1}{\\sqrt{1-{t}^{2}}}\\,i.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}F(r(t))\\cdot {r}^{′}(t) & =(2t\\,i+(\\operatorname{arcsin}⁡t+2)\\,j)\\cdot (\\frac{1}{\\sqrt{1-{t}^{2}}}\\,i) \\\\  & =\\frac{2t}{\\sqrt{1-{t}^{2}}}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral, as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F(r)\\cdot \\text{d}r & ={\\int }_{0}^{1/2}f(r(t))\\cdot {r}^{′}(t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1/2}\\frac{2t}{\\sqrt{1-{t}^{2}}}\\,dt \\\\  & =-2\\sqrt{1-{t}^{2}}\\,{|}_{0}^{1/2} \\\\  & =-2(\\sqrt{1-{(\\frac{1}{2})}^{2}}-1) \\\\  & =2-\\sqrt{3}\\end{aligned}\n$$"}]}
