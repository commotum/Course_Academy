^{2} & =17 \\\\ (x-1)^{2}+1+{z}^{2} & =17 \\\\ (x-1)^{2}+{z}^{2} & =16 \\\\ (x-1)^{2}+{z}^{2} & ={4}^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xz$-plane gives us the equation of the circle of radius $4$ centered at $(1,0).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71948/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3"] :knowledge-point/questions ["q-71948"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164216/selection/a0e84d0419ce09afe2763f4006f9a28c5d48544aa5fddaf1af2e781cee1eb0dd" :answer/id #uuid "c484d389-9eae-5ef9-9f33-c845aac49b7b" :answer/type :answer.type/text :answer/value "An ellipse with semi-axes $4$ and $1,$ centered at $(3,0)$ in the $xz$-plane" :db/ensure [:answer/validate]} {:db/id "q-164216/selection/e6d0f8ba2d958979db394936d7b096bc516c1b7fd0b68e84d84746ccbe927e8b" :answer/id #uuid "2c9e1ab0-15ac-541e-ade7-70cdfb1cfa50" :answer/type :answer.type/text :answer/value "An ellipse with semi-axes $2\\sqrt{2}$ and $\\sqrt{2},$ centered at $(0,0)$ in the $xz$-plane" :db/ensure [:answer/validate]} {:db/id "q-164216/selection/5a83b12409b147e7905329a25352d3e1634521e1cd1cb691d9b20f57faac67da" :answer/id #uuid "12c6bf60-308a-5f56-ad36-36c86a67a317" :answer/type :answer.type/text :answer/value "An ellipse with semi-axes $2\\sqrt{2}$ and $2,$ centered at $(3,0)$ in the $xz$-plane" :db/ensure [:answer/validate]} {:db/id "q-164216/selection/274f71c957c6a9a522bc9e9d6bca9d304e4be4ee003f32689ef64a5cf66fa2f2" :answer/id #uuid "e40086d5-749b-5222-bec3-9c41b3b87024" :answer/type :answer.type/text :answer/value "An ellipse with semi-axes $4$ and $1,$ centered at $(0,0)$ in the $xz$-plane" :db/ensure [:answer/validate]} {:db/id "q-164216/selection/95ef539f486d1025875b11d25cd429dd05421144df55a7b0a0240bf859322eff" :answer/id #uuid "e3327e7d-a655-5711-bc94-23542812678a" :answer/type :answer.type/text :answer/value "An ellipse with semi-axes $2\\sqrt{2}$ and $\\sqrt{2},$ centered at $(0,3)$ in the $xz$-plane" :db/ensure [:answer/validate]} {:db/id "q-164216/selection" :answer-field/id #uuid "f600bd91-85b2-5dea-9840-5f1d7258644a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164216/selection/a0e84d0419ce09afe2763f4006f9a28c5d48544aa5fddaf1af2e781cee1eb0dd" :answer-field/choices ["q-164216/selection/a0e84d0419ce09afe2763f4006f9a28c5d48544aa5fddaf1af2e781cee1eb0dd" "q-164216/selection/e6d0f8ba2d958979db394936d7b096bc516c1b7fd0b68e84d84746ccbe927e8b" "q-164216/selection/5a83b12409b147e7905329a25352d3e1634521e1cd1cb691d9b20f57faac67da" "q-164216/selection/274f71c957c6a9a522bc9e9d6bca9d304e4be4ee003f32689ef64a5cf66fa2f2" "q-164216/selection/95ef539f486d1025875b11d25cd429dd05421144df55a7b0a0240bf859322eff"] :db/ensure [:answer-field/validate]} {:db/id "q-164216" :question/id #uuid "d92bb0fb-ca2e-543b-a67c-2516a62739fc" :question/math-academy-id "q-164216" :question/problem "What is the trace in the $xz$-plane of the ellipsoid $\\frac{(x-3)^{2}}{16}+\\frac{{y}^{2}}{2}+{z}^{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the ellipsoid:\n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{16}+\\frac{{0}^{2}}{2}+{z}^{2} & =1 \\\\ \\frac{(x-3)^{2}}{16}+{z}^{2} & =1 \\\\ \\frac{(x-3)^{2}}{{4}^{2}}+\\frac{{z}^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of the ellipse with semi-axes $4$ and $1,$ centered at $(3,0)$ in the $xz$-plane." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164216/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3"] :knowledge-point/questions ["q-164216"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5311"] :question/problem "What are the radius $r$ and the coordinates of the center $C$ for the sphere $(x+1)^2 + y^2 + z^2 + 8z = 20?$" :question/worked-solution "The equation of a sphere centered at $(x_0, y_0, z_0)$ with radius $r > 0$ is given by\n\n$$\n(x-x_0)^2 + (y-y_0)^2 + (z-z_0)^2 = r^2.\n$$\n\nBy completing the square for the variable $z$, we have\n\n$$\n\\begin{aligned}(x+1)^{2}+{y}^{2}+{z}^{2}+8z & =20 \\\\ (x+1)^{2}+{y}^{2}+({z}^{2}+8z+16) & =20+16 \\\\ (x+1)^{2}+{y}^{2}+(z+4)^{2} & =36.\\end{aligned}\n$$\n\nNow, we can write our equation as\n\n$$\n(x-(-1))^2 + (y-0)^2 + (z-(-4))^2 = 6^2,\n$$\n\nwhich gives us the center at the point $C(-1,0,-4)$ and the radius $r=6.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5263"] :question/problem "Given the ellipsoid $\\dfrac {(x-2)^2} {2} +  {y^2} + \\dfrac{(z+1)^2}{2} =1,$ find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}+(0)^{2}+\\frac{(0+1)^{2}}{2} & =1 \\\\ \\frac{(x-2)^{2}}{2}+\\frac{1}{2} & =1 \\\\ \\frac{(x-2)^{2}}{2} & =\\frac{1}{2} \\\\ (x-2)^{2} & =1 \\\\ x-2 & =\\pm 1 \\\\ x & =2\\pm 1 \\\\ x & =1,3\\end{aligned}\n$$\n\nTherefore, the intercepts with the $x$-axis are $\\left(1, 0, 0\\right)$ and $\\left(3, 0, 0\\right).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-12554"] :question/problem "Given the ellipsoid $\\dfrac {x^2} {4} +  \\dfrac {y^2} 9  + z^2 = 1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}+{z}^{2} & =1 \\\\ {z}^{2} & =1-\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{9} \\\\ z & =\\pm \\sqrt{1-\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{9}}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}1-\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{9}\\ge 0 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the ellipse $\\dfrac {x^2} {4} +  \\dfrac {y^2} 9 =  1$ and its boundary.  \n\nTherefore, the domain is of $z = z(x,y)$ is given by\n\n$$\n\\bigg\\{ (x, y) \\,:\\, \\dfrac {x^2} {4} +  \\dfrac {y^2} 9 \\leq  1 \\bigg\\}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5312"] :question/problem "What is the trace in the $xy$-plane of the sphere $x^2 + (y+2)^2 + (z-3)^2 = 25?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2}+(0-3)^{2} & =25 \\\\ {x}^{2}+(y+2)^{2}+9 & =25 \\\\ {x}^{2}+(y+2)^{2} & =16\\end{aligned}\n$$\n\nThis gives us the equation of the circle of radius $4$ centered at $(0,-2)$ in the $xy$-plane." :db/ensure [:question/validate]}]
