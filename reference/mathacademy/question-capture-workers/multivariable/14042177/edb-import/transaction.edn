ure [:answer-field/validate]} {:db/id "q-70649" :question/id #uuid "69541963-bfeb-5f91-b675-aa9309c1e160" :question/math-academy-id "q-70649" :question/problem "What are the radius $r$ and the coordinates of the center $C$ for the sphere ${x}^{2}+(y+5)^{2}+{z}^{2}=10?$" :question/worked-solution "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nWe can write our equation as\n\n$$\n{x}^{2}+(y-(-5))^{2}+{z}^{2}=(\\sqrt{10})^{2},\n$$\n\nwhich gives us the center at the point point $C(0,-5,0)$ and the radius $r=\\sqrt{10}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70649/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "304a85ac-e980-5081-8f2b-20df471c30fc"] :knowledge-point/questions ["q-70649"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70648/selection/6df8080b226be5d4391e9398efeca9fd36d7025d21a883b5ba2fa1cb47cf1825" :answer/id #uuid "39823bf7-f9d5-5564-9f1a-5d08d914507a" :answer/type :answer.type/text :answer/value "$r=2$ and $C(-2,3,0)$" :db/ensure [:answer/validate]} {:db/id "q-70648/selection/69ecdea2d204cc7e95b9cd681aeb0a9ae7e799ceae76f275703b4ef66f18ac55" :answer/id #uuid "9bca39e2-4243-5f92-b5f9-1bcc581272b7" :answer/type :answer.type/text :answer/value "$r=4$ and $C(-2,0,3)$" :db/ensure [:answer/validate]} {:db/id "q-70648/selection/a4ed301679699c05d9b7f561e7741aa29aac8c27dd24fec072f7ffe08c3beff1" :answer/id #uuid "e88a2693-94fb-5c35-96b1-c6c797d7904b" :answer/type :answer.type/text :answer/value "$r=4$ and $C(0,2,3)$" :db/ensure [:answer/validate]} {:db/id "q-70648/selection/cb1a4306fb565a71fd014e4664fe5d66ed9c36636f668e5ee525bffddd191cee" :answer/id #uuid "b1cd5537-3e50-531d-9634-90349ea00827" :answer/type :answer.type/text :answer/value "$r=2$ and $C(-2,0,3)$" :db/ensure [:answer/validate]} {:db/id "q-70648/selection/d62313b244e2ea2df79c8f1b66b53e5c3bb2ab743