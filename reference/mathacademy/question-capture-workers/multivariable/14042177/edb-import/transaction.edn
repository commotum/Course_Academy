0} & =\\frac{2}{5} \\\\ {z}^{2} & =16 \\\\ z & =\\pm 4\\end{aligned}\n$$\n\nHence, we get the solutions $z=-4$ and $z=4.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-4)$ and $(0,0,4).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164275/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7"] :knowledge-point/questions ["q-164275"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-73214"] :question/problem "Given the ellipsoid $\\frac{(x+1)^{2}}{9}+(y+2)^{2}+\\frac{(z-2)^{2}}{9}=1$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+1)^{2}}{9}+(y+2)^{2}+\\frac{(0-2)^{2}}{9} & =1 \\\\ \\frac{1}{9}+(y+2)^{2}+\\frac{4}{9} & =1 \\\\ \\frac{5}{9}+(y+2)^{2} & =1 \\\\ (y+2)^{2} & =\\frac{4}{9} \\\\ y+2 & =\\pm \\frac{2}{3} \\\\ y & =-2\\pm \\frac{2}{3}\\end{aligned}\n$$\n\nHence, we get the solutions $y=-\\frac{8}{3}$ and $y=-\\frac{4}{3}.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-\\frac{8}{3},0)$ and $(0,-\\frac{4}{3},0).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-164311/selection/1dbe215a626a3f6d906052bcd74f9998bf5e7cc21edf89a0edbc94269317a630" :answer/id #uuid "9a5ee55f-54b8-5d95-9002-173b0aacd687" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(-3,1)$" :db/ensure [:answer/validate]} {:db/id "q-164311/selection/8e7fb5fa5e7c71fd700f5bb6d93dcbb16a267a82397fd6862d15f45706df7396" :answer/id #uuid "3420634e-0cfa-577e-bd4a-241ef1a74b7d" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(3,2)$" :db/ensure [:answer/validate]} {:db/id "q-164311/selection/00d44d0c3172f63d2da9daa6a6c5f24d6bcb5c5aeb8aa455a0dbddacf25b4240" :answer/id #uuid "fa5341f1-ab9b-5010-afbc-cb3a9c297b59" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,1)$" :db/ensure [:answer/validate]} {:db/id "q-164311/selection/923e109b4f5b9b0178d34546aa6e1226eacd262588ca41e651afe49ee5ba7b7c" :answer/id #uuid "c18d4fac-d47d-5e9f-be53-772e700e1d62" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(1,3)$" :db/ensure [:answer/validate]} {:db/id "q-164311/selection/0ae0bf56a56cc039026a616ae8911bbc69c764b2f619acadc357b2c7405c4973" :answer/id #uuid "05ca48e1-0d8a-5b1c-ad56-1176dfcd9483" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $3$ centered at $(1,-3)$" :db/ensure [:answer/validate]} {:db/id "q-164311/selection" :answer-field/id #uuid "0e6f3958-59c5-54f9-9454-66e264b97a30" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164311/selection/00d44d0c3172f63d2da9daa6a6c5f24d6bcb5c5aeb8aa455a0dbddacf25b4240" :answer-field/choices ["q-164311/selection/1dbe215a626a3f6d906052bcd74f9998bf5e7cc21edf89a0edbc94269317a630" "q-164311/selection/8e7fb5fa5e7c71fd700f5bb6d93dcbb16a267a82397fd6862d15f45706df7396" "q-164311/selection/00d44d0c3172f63d2da9daa6a6c5f24d6bcb5c5aeb8aa455a0dbddacf25b4240" "q-164311/selection/923e109b4f5b9b0178d34546aa6e1226eacd262588ca41e651afe49ee5ba7b7c" "q-164311/selection/0ae0bf56a56cc039026a616ae8911bbc69c764b2f619acadc357b2c7405c4973"] :db/ensure [:answer-field/validate]} {:db/id "q-164311" :question/id #uuid "3e6a384d-7ca2-5551-9c7a-30830f5ff58a" :question/math-academy-id "q-164311" :question/problem "Given the sphere $(x-3)^{2}+(y-1)^{2}+(z-2)^{2}=9,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-3)^{2}+(y-1)^{2}+(z-2)^{2} & =9 \\\\ (z-2)^{2} & =9-((x-3)^{2}+(y-1)^{2}) \\\\ z-2 & =\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})} \\\\ z & =2\\pm \\sqrt{9-((x-3)^{2}+(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}9-((x-3)^{2}+(y-1)^{2})\\ge 0 \\\\ (x-3)^{2}+(y-1)^{2}\\le 9\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x-3)^{2}+(y-1)^{2}=9\n$$\n\nwhich is a circle of radius $3$ centered at $(3,1)$ in the $xy$-plane." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164311/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339"] :knowledge-point/questions ["q-164311"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164317/selection/b8ebd74e98df4f3c664d920bcfdf888e42d9009fbcd1d20d0e7eb52c3c5b0c4a" :answer/id #uuid "8ba095ea-13f1-5b07-ab75-d4dbc6b64323" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{5}+\\frac{(y-2)^{2}}{10}>1}" :db/ensure [:answer/validate]} {:db/id "q-164317/selection/f3fc81e457ee62b1275a161c3ef6fb49487eb5cd073b71ce81082ebf1eb9d967" :answer/id #uuid "5c6568c1-b53c-5bf3-b3bb-7e2fb2363f52" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x-2)^{2}+\\frac{{y}^{2}}{10}<1}" :db/ensure [:answer/validate]} {:db/id "q-164317/selection/7557474df1aa7eed576c1f0fad195a122f38392ab8de0246be519896ba5c558c" :answer/id #uuid "18e88a93-80f6-5024-b2dc-461333550327" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{5}+\\frac{(y-2)^{2}}{10}<1}" :db/ensure [:answer/validate]} {:db/id "q-164317/selection/e2af1e5d34fb9944599fd6cb704dfd60986f3aa668ce70e6b568daa5e16c13f4" :answer/id #uuid "1b368d08-2ceb-5348-a845-cf4b9252acea" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x-2)^{2}}{10}+{y}^{2}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-164317/selection/c113333018397ee339061a5f1872727beb627807dc93b9f798cd83e54c716e85" :answer/id #uuid "b9b2ebd1-e5a2-5282-9a02-34c028bda414" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x-2)^{2}+\\frac{(y-2)^{2}}{10}<1}" :db/ensure [:answer/validate]} {:db/id "q-164317/selection" :answer-field/id #uuid "c01f0dcb-19ec-5895-849e-d01f4f8252c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164317/selection/e2af1e5d34fb9944599fd6cb704dfd60986f3aa668ce70e6b568daa5e16c13f4" :answer-field/choices ["q-164317/selection/b8ebd74e98df4f3c664d920bcfdf888e42d9009fbcd1d20d0e7eb52c3c5b0c4a" "q-164317/selection/f3fc81e457ee62b1275a161c3ef6fb49487eb5cd073b71ce81082ebf1eb9d967" "q-164317/selection/7557474df1aa7eed576c1f0fad195a122f38392ab8de0246be519896ba5c558c" "q-164317/selection/e2af1e5d34fb9944599fd6cb704dfd60986f3aa668ce70e6b568daa5e16c13f4" "q-164317/selection/c113333018397ee339061a5f1872727beb627807dc93b9f798cd83e54c716e85"] :db/ensure [:answer-field/validate]} {:db/id "q-164317" :question/id #uuid "160c2e7f-7903-5bb5-85db-a233663b371d" :question/math-academy-id "q-164317" :question/problem "Given the ellipsoid $\\frac{(x-2)^{2}}{10}+{y}^{2}+\\frac{(z+1)^{2}}{5}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{10}+{y}^{2}+\\frac{(z+1)^{2}}{5} & =1 \\\\ (z+1)^{2} & =5(1-\\frac{(x-2)^{2}}{10}-{y}^{2}) \\\\ z+1 & =\\pm \\sqrt{5(1-\\frac{(x-2)^{2}}{10}-{y}^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-\\frac{(x-2)^{2}}{10}-{y}^{2}\\ge 0 \\\\ \\frac{(x-2)^{2}}{10}+{y}^{2}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the ellipse $\\frac{(x-2)^{2}}{10}+{y}^{2}=1$ and its boundary. \n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,\\frac{(x-2)^{2}}{10}+{y}^{2}\\le 1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-164317/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339"] :knowledge-point/questions ["q-164317"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186124803 :question/answer-fields 17592186121840] {:db/id "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/6c97192bc5673c28e39e79c532a739c486370412fc9ef7ddd7d66312fac81a0a" :answer/id #uuid "1e6fc4f0-0737-5b25-a001-f06377fa20df" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{4}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/478295c65b8f56f2cc54c57bfb48a5a99f4c49963c8543a6a5c0528b96c6fd6c" :answer/id #uuid "7d350195-56fa-5618-9340-8f72c43ae52b" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{16}+\\frac{{y}^{2}}{4}<1}" :db/ensure [:answer/validate]} {:db/id "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/985e06ebd049b7ad31806ec90fdf3f824a102c6c92d96cc91ec110e0f2554cb5" :answer/id #uuid "4d23800d-ef58-50dc-ad3e-973a943b148d" :answer/type :answer.type/text :answer/value "Entire $xy$-plane" :db/ensure [:answer/validate]} {:db/id "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/5896031229afc56ab647790fb47ac9e1eab7cec92936c564bc3d626cdaba9bea" :answer/id #uuid "8c5371f3-da5d-5f75-b98e-a511ee8ef652" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x-1)^{2}}{16}+\\frac{{y}^{2}}{4}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/e0f76be04241e692a0e03d666d17a995b771c8ec530820ce0a40d4b495f80565" :answer/id #uuid "ee15b1b4-eae5-553c-adf7-517e7687dfe1" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{16}+\\frac{{y}^{2}}{4}>1}" :db/ensure [:answer/validate]} {:db/id "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249" :answer-field/id #uuid "25473d56-1170-5a5d-91e6-08b4fd49f7d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/5896031229afc56ab647790fb47ac9e1eab7cec92936c564bc3d626cdaba9bea" :answer-field/choices ["q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/6c97192bc5673c28e39e79c532a739c486370412fc9ef7ddd7d66312fac81a0a" "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/478295c65b8f56f2cc54c57bfb48a5a99f4c49963c8543a6a5c0528b96c6fd6c" "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/985e06ebd049b7ad31806ec90fdf3f824a102c6c92d96cc91ec110e0f2554cb5" "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/5896031229afc56ab647790fb47ac9e1eab7cec92936c564bc3d626cdaba9bea" "q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249/e0f76be04241e692a0e03d666d17a995b771c8ec530820ce0a40d4b495f80565"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-35518"] :question/problem "Given the ellipsoid $\\frac{(x-1)^{2}}{16}+\\frac{{y}^{2}}{4}+(z+2)^{2}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{16}+\\frac{{y}^{2}}{4}+(z+2)^{2} & =1 \\\\ (z+2)^{2} & =1-\\frac{(x-1)^{2}}{16}-\\frac{{y}^{2}}{4} \\\\ z+2 & =\\pm \\sqrt{1-\\frac{(x-1)^{2}}{16}-\\frac{{y}^{2}}{4}}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-\\frac{(x-1)^{2}}{16}-\\frac{{y}^{2}}{4}\\ge 0 \\\\ \\frac{(x-1)^{2}}{16}+\\frac{{y}^{2}}{4}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the ellipse $\\frac{(x-1)^{2}}{16}+\\frac{{y}^{2}}{4}=1$ and its boundary.\n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,\\frac{(x-1)^{2}}{16}+\\frac{{y}^{2}}{4}\\le 1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-35518/selection/ma-v1/9519a19dd15c238eb046b18ad757fbe3100aba96fee27b23435d641eeae03249"] :db/ensure [:question/validate]} {:db/id "q-164378/selection/3303841ac4b6a11660d3e5973b1e528bd144b89ed8d43962811d6e4a44a9ea15" :answer/id #uuid "85325582-ab19-5c7f-85ec-1bb6f9342717" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $\\sqrt{3}$ centered at $(-3,4)$" :db/ensure [:answer/validate]} {:db/id "q-164378/selection/0292f99d7fcbc1aadab273b5db36adfce35170dc31fbffd450112e6e28b39527" :answer/id #uuid "7d9ee151-cf6c-5263-b815-85ff5f47aaa4" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $3$ centered at $(3,-1)$" :db/ensure [:answer/validate]} {:db/id "q-164378/selection/e2b80940554d82151010dc582de3491d49e24ce4affbaa27e259d40c5500779e" :answer/id #uuid "4923d341-be85-5b8d-88c9-ee9b2ecf645a" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $9$ centered at $(-3,-1)$" :db/ensure [:answer/validate]} {:db/id "q-164378/selection/b13c628d6069e9463ce6c02a72d89fc10d1613b8a80f9e85d4c1b4f2b06e1130" :answer/id #uuid "df9beecc-e2b2-57b5-b50e-05799f8f27f7" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $9$ centered at $(3,-1)$" :db/ensure [:answer/validate]} {:db/id "q-164378/selection/6756f0c5a334c5e18cbd59e391ed00a13e589d678a66c0135a305d46833ca56b" :answer/id #uuid "aeb079b6-1d5c-5a45-9dbf-30e2e7e32086" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $3$ centered at $(-3,1)$" :db/ensure [:answer/validate]} {:db/id "q-164378/selection" :answer-field/id #uuid "afdbb149-1654-52a3-99bc-b8b65b44e455" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164378/selection/6756f0c5a334c5e18cbd59e391ed00a13e589d678a66c0135a305d46833ca56b" :answer-field/choices ["q-164378/selection/3303841ac4b6a11660d3e5973b1e528bd144b89ed8d43962811d6e4a44a9ea15" "q-164378/selection/0292f99d7fcbc1aadab273b5db36adfce35170dc31fbffd450112e6e28b39527" "q-164378/selection/e2b80940554d82151010dc582de3491d49e24ce4affbaa27e259d40c5500779e" "q-164378/selection/b13c628d6069e9463ce6c02a72d89fc10d1613b8a80f9e85d4c1b4f2b06e1130" "q-164378/selection/6756f0c5a334c5e18cbd59e391ed00a13e589d678a66c0135a305d46833ca56b"] :db/ensure [:answer-field/validate]} {:db/id "q-164378" :question/id #uuid "05acb460-cd41-56dc-8b5b-f6ebf429381f" :question/math-academy-id "q-164378" :question/problem "Given the sphere $(x+3)^{2}+(y-1)^{2}+(z-4)^{2}=9,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+3)^{2}+(y-1)^{2}+(z-4)^{2} & =9 \\\\ (z-4)^{2} & =9-((x+3)^{2}+(y-1)^{2}) \\\\ z-4 & =\\pm \\sqrt{9-({x}^{2}+(y+3)^{2})} \\\\ z & =4\\pm \\sqrt{9-((x+3)^{2}+(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}9-((x+3)^{2}+(y-1)^{2})\\ge 0 \\\\ (x+3)^{2}+(y-1)^{2}\\le 9\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x+3)^{2}+(y-1)^{2}=9\n$$\n\nwhich is a circle of radius $3$ centered at $(-3,1)$ in the $xy$-plane." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164378/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339"] :knowledge-point/questions ["q-164378"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-164186"] :question/problem "Given the sphere ${x}^{2}+(y+3)^{2}+(z-1)^{2}=2,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}{x}^{2}+(y+3)^{2}+(z-1)^{2} & =2 \\\\ (z-1)^{2} & =2-({x}^{2}+(y+3)^{2}) \\\\ z-1 & =\\pm \\sqrt{2-({x}^{2}+(y+3)^{2})} \\\\ z & =1\\pm \\sqrt{2-({x}^{2}+(y+3)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}2-({x}^{2}+(y+3)^{2})\\ge 0 \\\\ {x}^{2}+(y+3)^{2}\\le 2\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n{x}^{2}+(y+3)^{2}=2\n$$\n\nwhich is a circle of radius $\\sqrt{2}$ centered at $(0,-3)$ in the $xy$-plane." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-70927"] :question/problem "What is the trace in the $xz$-plane of the sphere $(x-2)^{2}+{y}^{2}+(z+2)^{2}=16?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(x-2)^{2}+(0)^{2}+(z+2)^{2} & =16 \\\\ (x-2)^{2}+(z+2)^{2} & =16\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-70926/selection/0f5347c67eae0877a2537dedb73ecb45780cadd936f7618001bbe329372fcbb7" :answer/id #uuid "b1347e99-63f2-58bc-bb94-35d775e1d32d" :answer/type :answer.type/text :answer/value "The circle of radius $\\sqrt{3}$ centered at $(0,4)$" :db/ensure [:answer/validate]} {:db/id "q-70926/selection/59836fa67f90260c49398130d03272e14195032d338fd17ab5e268ed48d34f24" :answer/id #uuid "9021a18e-8f13-54df-8c5d-4781a03f2dae" :answer/type :answer.type/text :answer/value "The circle of radius $4$ centered at $(4,0)$" :db/ensure [:answer/validate]} {:db/id "q-70926/selection/3536994a26a1444e158a5f703ea66a1e4f96c445ad5f07783abc24b31cb5f5cb" :answer/id #uuid "4b06f284-5ac1-5aab-9668-4b5a71bfd5b5" :answer/type :answer.type/text :answer/value "The circle of radius $12$ centered at $(0,0)$" :db/ensure [:answer/validate]} {:db/id "q-70926/selection/3cf93f2e224af93278543d3eaefc9c00c2812a3f583173ae8a379d382a1a349d" :answer/id #uuid "35f3b4d2-4341-5a24-aad2-d77468677527" :answer/type :answer.type/text :answer/value "The circle of radius $2$ centered at $(0,-4)$" :db/ensure [:answer/validate]} {:db/id "q-70926/selection/e3cce8ab146b75565d5bbd7814cd30abf645f5f09ab46a6b757bfae5a06523ea" :answer/id #uuid "a2e249bd-6e6c-5c99-bebf-93aa09ea6d83" :answer/type :answer.type/text :answer/value "The circle of radius $2\\sqrt{3}$ centered at $(-4,0)$" :db/ensure [:answer/validate]} {:db/id "q-70926/selection" :answer-field/id #uuid "55a888bc-747b-5c3d-ae12-7ce3342fe3a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70926/selection/e3cce8ab146b75565d5bbd7814cd30abf645f5f09ab46a6b757bfae5a06523ea" :answer-field/choices ["q-70926/selection/0f5347c67eae0877a2537dedb73ecb45780cadd936f7618001bbe329372fcbb7" "q-70926/selection/59836fa67f90260c49398130d03272e14195032d338fd17ab5e268ed48d34f24" "q-70926/selection/3536994a26a1444e158a5f703ea66a1e4f96c445ad5f07783abc24b31cb5f5cb" "q-70926/selection/3cf93f2e224af93278543d3eaefc9c00c2812a3f583173ae8a379d382a1a349d" "q-70926/selection/e3cce8ab146b75565d5bbd7814cd30abf645f5f09ab46a6b757bfae5a06523ea"] :db/ensure [:answer-field/validate]} {:db/id "q-70926" :question/id #uuid "1624d2db-d10f-59ae-bae3-c241890eb9fd" :question/math-academy-id "q-70926" :question/problem "What is the projection of the intersection between the sphere ${x}^{2}+(y+4)^{2}+{z}^{2}=16$ and the plane $x=2$ onto the $yz$-plane." :question/worked-solution "To find the intersection of the sphere and the plane $x=2$, we substitute $x=2$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(2)^{2}+(y+4)^{2}+{z}^{2} & =16 \\\\ 4+(y+4)^{2}+{z}^{2} & =16 \\\\ (y+4)^{2}+{z}^{2} & =12 \\\\ (y+4)^{2}+{z}^{2} & =(2\\sqrt{3})^{2}\\end{aligned}\n$$\n\nProjecting this onto the $yz$-plane gives us the circle of radius $2\\sqrt{3}$ centered at $(-4,0).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-70926/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3"] :knowledge-point/questions ["q-70926"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71949/selection/294385f4a1a2c220d34d86d00fcfe0619b8f8f4c239bd14a0d99cc49b232080b" :answer/id #uuid "829ab927-6d2a-5df2-aa53-fb0c7abc757c" :answer/type :answer.type/text :answer/value "The circle of radius $2\\sqrt{5}$ centered at $(0,-2)$" :db/ensure [:answer/validate]} {:db/id "q-71949/selection/cc3c74fb5206c96cda275c664de86a1b4552414243184d29d78142cc3456baf2" :answer/id #uuid "9f8bf85f-e24d-5186-bc2a-6f8b329cb4fe" :answer/type :answer.type/text :answer/value "The circle of radius $6$ centered at $(0,2)$" :db/ensure [:answer/validate]} {:db/id "q-71949/selection/934a064b6b6c762f505863aadd9573a4280b5132eaed690ca28d75373d18d1c1" :answer/id #uuid "feb0d2fa-2a6a-5a65-8854-95ac65518a06" :answer/type :answer.type/text :answer/value "The circle of radius $2\\sqrt{5}$ centered at $(0,2)$" :db/ensure [:answer/validate]} {:db/id "q-71949/selection/c92858e97ab894cb7ee36093b1a39d91b863b7b0a542221350ae8bd4f10eb5e1" :answer/id #uuid "99a725f7-be8e-50bf-be65-c206e4da2af9" :answer/type :answer.type/text :answer/value "The circle of radius $20$ centered at $(0,-2)$" :db/ensure [:answer/validate]} {:db/id "q-71949/selection/fb68fdebc7c849009552e00edd7e2ae551172972052d4d4bdd36c32634fff3a9" :answer/id #uuid "9a86893e-38bc-5e8c-b770-371902eb9eec" :answer/type :answer.type/text :answer/value "The circle of radius $\\sqrt{5}$ centered at $(0,2)$" :db/ensure [:answer/validate]} {:db/id "q-71949/selection" :answer-field/id #uuid "da0094fd-2e79-546e-8474-d026140c413b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71949/selection/934a064b6b6c762f505863aadd9573a4280b5132eaed690ca28d75373d18d1c1" :answer-field/choices ["q-71949/selection/294385f4a1a2c220d34d86d00fcfe0619b8f8f4c239bd14a0d99cc49b232080b" "q-71949/selection/cc3c74fb5206c96cda275c664de86a1b4552414243184d29d78142cc3456baf2" "q-71949/selection/934a064b6b6c762f505863aadd9573a4280b5132eaed690ca28d75373d18d1c1" "q-71949/selection/c92858e97ab894cb7ee36093b1a39d91b863b7b0a542221350ae8bd4f10eb5e1" "q-71949/selection/fb68fdebc7c849009552e00edd7e2ae551172972052d4d4bdd36c32634fff3a9"] :db/ensure [:answer-field/validate]} {:db/id "q-71949" :question/id #uuid "d2ff6712-19ec-54c8-bda1-46ab6fc386b4" :question/math-academy-id "q-71949" :question/problem "What is the projection of the intersection between the sphere ${x}^{2}+(y-2)^{2}+(z+1)^{2}=36$ and the plane $z=3$ onto the $xy$-plane." :question/worked-solution "To find the intersection of the sphere and the plane $z=3$, we substitute $z=3$ into the equation of the sphere:\n\n$$\n\\begin{aligned}{x}^{2}+(y-2)^{2}+(3+1)^{2} & =36 \\\\ {x}^{2}+(y-2)^{2}+16 & =36 \\\\ {x}^{2}+(y-2)^{2} & =20 \\\\ {x}^{2}+(y-2)^{2} & =(2\\sqrt{5})^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xy$-plane gives us the equation of the circle of radius $2\\sqrt{5}$ centered at $(0,2).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71949/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3"] :knowledge-point/questions ["q-71949"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71948/selection/862a68d5872dc26c9bfbec73d39e386f90292dbdd39608fb767f8951d4554417" :answer/id #uuid "58ee27a9-cece-5e0f-8577-c8301ab9bafb" :answer/type :answer.type/text :answer/value "The circle of radius $4$ centered at $(1,0)$" :db/ensure [:answer/validate]} {:db/id "q-71948/selection/21a971baf3c8dba83aac14c41fd782ab39715df4395d07ba097d59f5435b48be" :answer/id #uuid "828031ca-cf8f-5013-84f3-a3fa904ea0d8" :answer/type :answer.type/text :answer/value "The circle of radius $16$ centered at $(-1,0)$" :db/ensure [:answer/validate]} {:db/id "q-71948/selection/9d9728583f7