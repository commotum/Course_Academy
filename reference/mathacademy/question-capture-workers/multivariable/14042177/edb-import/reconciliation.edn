177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71948" "field" nil "attribute" "question/worked-solution" "value" "To find the intersection of the sphere and the plane $y=5$, we substitute $y=5$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(x-1)^{2}+(5-6)^{2}+{z}^{2} & =17 \\\\ (x-1)^{2}+1+{z}^{2} & =17 \\\\ (x-1)^{2}+{z}^{2} & =16 \\\\ (x-1)^{2}+{z}^{2} & ={4}^{2}\\end{aligned}\n$$\n\nProjecting this onto the $xz$-plane gives us the equation of the circle of radius $4$ centered at $(1,0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71948" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/activity-metadata.json" "file_sha256" "40c9b47f84a46075b258520c8bb344da4c894b0d0c5fd9f11b282ef313c0163f"} {"question" "q-71948" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71948" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "The circle of radius $16$ centered at $(-1,0)$"] ["text" "The circle of radius $16$ centered at $(1,0)$"] ["text" "The circle of radius $4$ centered at $(-1,0)$"] ["text" "The circle of radius $4$ centered at $(1,0)$"] ["text" "The circle of radius $\\sqrt{17}$ centered at $(1,0)$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multiva