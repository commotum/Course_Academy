,1)$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-70560" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$r=\\sqrt{2}$ and $C(0,-3,1)$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-70650" "field" nil "attribute" "question/problem" "value" "What is the radius of the sphere ${x}^{2}+4x+{y}^{2}+(z-3)^{2}=12?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-70650" "field" nil "attribute" "question/worked-solution" "value" "Remember that the equation of a sphere centered at $({x}_{0},{y}_{0},{z}_{0})$ with radius $r>0$ is given by\n\n$$\n(x-{x}_{0})^{2}+(y-{y}_{0})^{2}+(z-{z}_{0})^{2}={r}^{2}.\n$$\n\nBy completing the square for the variable $x$, we have:\n\n$$\n\\begin{aligned}{x}^{2}+4x+{y}^{2}+(z-3)^{2} & =12 \\\\ ({x}^{2}+4x+4)+{y}^{2}+(z-3)^{2} & =12+4 \\\\ (x+2)^{2}+{y}^{2}+(z-3)^{2} & =16\\end{aligned}\n$$\n\nNow, we can write our equation as\n\n$$\n(x+2)^{2}+{y}^{2}+(z-3)^{2}={4}^{2},\n$$\n\nwhich gives us a radius of $4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-70650" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/activity-metadata.json" "file_sha256" "40c9b47f84a46075b258520c8bb344da4c894b0d0c5fd9f11b282ef313c0163f"} {"question" "q-70650" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-70650" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "12"] ["math" "16"] ["math" "2\\sqrt{3}"] ["math" "4"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-70650" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-164251" "field" nil "attribute" "question/problem" "value" "Given the ellipsoid $\\frac{(x-2)^{2}}{16}+\\frac{(y+2)^{2}}{8}+\\frac{(z-1)^{2}}{4}=1$, find its intercepts with the $x$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-164251" "field" nil "attribute" "question/worked-solution" "value" "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{16}+\\frac{(0+2)^{2}}{8}+\\frac{(0-1)^{2}}{4} & =1 \\\\ \\frac{(x-2)^{2}}{16}+\\frac{1}{2}+\\frac{1}{4} & =1 \\\\ \\frac{(x-2)^{2}}{16} & =\\frac{1}{4} \\\\ (x-2)^{2} & =4 \\\\ x-2 & =\\pm 2 \\\\ x & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $x=0$ and $x=4.$\n\nTherefore, the intercepts with the $x$-axis are $(0,0,0)$ and $(4,0,0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-164251" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/activity-metadata.json" "file_sha256" "40c9b47f84a46075b258520c8bb344da4c894b0d0c5fd9f11b282ef313c0163f"} {"question" "q-164251" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-164251" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$(-2,0,0)$ and $(0,0,0).$"] ["text" "$(-2,0,0)$ and $(2,0,0).$"] ["text" "$(-4,0,0)$ and $(4,0,0).$"] ["text" "$(0,0,0)$ and $(2,0,0).$"] ["text" "$(0,0,0)$ and $(4,0,0)$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-164251" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$(0,0,0)$ and $(4,0,0)$"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71118" "field" nil "attribute" "question/problem" "value" "Given the ellipsoid $\\frac{(x+1)^{2}}{4}+\\frac{(y-2)^{2}}{9}+\\frac{{z}^{2}}{11}=1$, find its intercepts with the $z$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71118" "field" nil "attribute" "question/worked-solution" "value" "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+1)^{2}}{4}+\\frac{(0-2)^{2}}{9}+\\frac{{z}^{2}}{11} & =1 \\\\ \\frac{1}{4}+\\frac{4}{9}+\\frac{{z}^{2}}{11} & =1 \\\\ \\frac{{z}^{2}}{11} & =\\frac{11}{36} \\\\ {z}^{2} & =\\frac{121}{36} \\\\ z & =\\pm \\frac{11}{6}\\end{aligned}\n$$\n\nHence, we get the solutions $z=-\\frac{11}{6}$ and $z=\\frac{11}{6}.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-\\frac{11}{6})$ and $(0,0,\\frac{11}{6}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71118" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/activity-metadata.json" "file_sha256" "40c9b47f84a46075b258520c8bb344da4c894b0d0c5fd9f11b282ef313c0163f"} {"question" "q-71118" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71118" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$(0,0,-\\frac{11}{6})$ and $(0,0,\\frac{11}{6})$"] ["text" "$(0,0,-\\sqrt{11})$ and $(0,0,\\sqrt{11})$"] ["text" "$(0,0,0)$ and $(0,0,\\frac{11}{6})$"] ["text" "$(0,0,0)$ only"] ["text" "$(0,0,\\frac{11}{6})$ only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-71118" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$(0,0,-\\frac{11}{6})$ and $(0,0,\\frac{11}{6})$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-73190" "field" nil "attribute" "question/problem" "value" "Given the ellipsoid $\\frac{(x-1)^{2}}{18}+\\frac{(y+2)^{2}}{8}+\\frac{{z}^{2}}{16}=1$, find its intercepts with the $x$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042177/state.json" "file_sha256" "d94aeaff82090a7938a0d72149a5f134f48e63b50ea71550611d24627b4ff4ab"} {"question" "q-73190" "field" nil "attribute" "question/worked-solution" "value" "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{18}+\\frac{(0+2)^{2}}{8}+\\frac{{0}^{2}}{16} & =1 \\\\ \\frac{(x-1)^{2}}{18}+\\frac{1}{2}+0 & =1 \\\\ \\frac{(x-1)^{2}}{18} & =\\frac{1}{2} \\\\ (x-1)^{2} & =9 \\\\ x-1 & =\\pm 3 \\\\ x & =1\\pm 3\\end{aligned}\n$$\n\nHence, we get the solutions $x=4$ and $x=-2.$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(4,0,0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Acade