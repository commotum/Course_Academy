}\\,\\text{d}t.\\end{aligned}\n$$\n\nNow, factoring the expression $36{t}^{4}+72{t}^{2}+36,$ we can rewrite our integral as follows:\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{1}6{t}^{2}\\sqrt{36({t}^{4}+2{t}^{2}+1)}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{1}6{t}^{2}\\cdot 6\\sqrt{{t}^{4}+2{t}^{2}+1}\\,\\text{d}t \\\\  & =72\\pi {\\int }_{0}^{1}{t}^{2}\\sqrt{({t}^{2}+1)^{2}}\\,\\text{d}t \\\\  & =72\\pi {\\int }_{0}^{1}{t}^{2}\\cdot |{t}^{2}+1|\\,\\text{d}t \\\\  & =72\\pi {\\int }_{0}^{1}{t}^{2}({t}^{2}+1)\\,\\text{d}t \\\\  & =72\\pi {\\int }_{0}^{1}({t}^{4}+{t}^{2})\\,\\text{d}t\\end{aligned}\n$$\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & =72\\pi {\\int }_{0}^{1}({t}^{4}+{t}^{2})\\,\\text{d}t \\\\  & =72\\pi \\cdot {[\\frac{{t}^{5}}{5}+\\frac{{t}^{3}}{3}]}_{0}^{1} \\\\  & =72\\pi [(\\frac{1}{5}+\\frac{1}{3})-(\\frac{0}{5}+\\frac{0}{3})] \\\\  & =72\\pi \\cdot \\frac{8}{15} \\\\  & =\\frac{192\\pi }{5}.\\end{aligned}\n$$" 13194139536176 true] [17592186387405 1000 #edb/ref 17592186387406 13194139536176 true] [17592186387405 1040 #edb/ref 17592186045449 13194139536176 true] [17592186387405 1041 "field-1" 13194139536176 true] [17592186387405 1104 #edb/ref 17592186387406 13194139536176 true] [17592186387405 1110 #uuid "579db1e0-fab8-5f42-bd70-7d25ebdc19a6" 13194139536176 true] [17592186387406 1034 "\\frac{192\\pi}{5}" 13194139536176 true] [17592186387406 1103 #edb/ref 17592186045453 13194139536176 true] [17592186387406 1111 #uuid "089067a8-8bca-5f3c-9018-0d49018d4701" 13194139536176 true] [17592186387407 1017 #edb/ref 17592186387408 13194139536176 true] [17592186387407 1089 "q-352089" 13194139536176 true] [17592186387407 1091 #edb/ref 17592186045464 13194139536176 true] [17592186387407 1100 "Consider the curve defined parametrically as \n\n$$\nx={e}^{t}-t,\\,y=4{e}^{t/2},\\,t\\in [0,\\operatorname{ln}⁡4].\n$$\n\nDetermine the surface area $S$ generated when this curve is rotated $2\\pi $ radians about the $x$-axis. Do not round the answer.\n\n$S=$\n{{field-1}}" 13194139536176 true] [17592186387407 1113 #uuid "f78d6a56-cd43-5d8a-9efe-3b87eb7543f2" 13194139536176 true] [17592186387407 1145 "We can find the surface area generated when a curve is rotated $2\\pi $ radians about the $x$-axis using the formula\n\n$$\nS=\\int 2\\pi y\\,\\text{d}s.\n$$\n\nSince our curve is given in parametric form, we have\n\n$$\n\\text{d}s=\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nTherefore, we will use\n\n$$\nS=2\\pi {\\int }_{{t}_{1}}^{{t}_{2}}y\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nWe are told that the limits of integration are from ${t}_{1}=0$ to ${t}_{2}=\\operatorname{ln}⁡4.$ \n\nComputing the derivatives, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}-t)={e}^{t}-1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4{e}^{t/2})=2{e}^{t/2}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}S & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡4}4{e}^{t/2}\\sqrt{{({e}^{t}-1)}^{2}+{(2{e}^{t/2})}^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡4}4{e}^{t/2}\\sqrt{{e}^{2t}-2{e}^{t}+1+4{e}^{t}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡4}4{e}^{t/2}\\sqrt{{e}^{2t}+2{e}^{t}+1}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡4}4{e}^{t/2}\\sqrt{({e}^{t}+1)^{2}}\\,\\text{d}t \\\\  & =2\\pi {\\int }_{0}^{\\operatorname{ln}⁡4}4{e}^{t/2}({e}^{t}+1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\operatorname{ln}⁡4}8\\pi {e}^{t/2}({e}^{t}+1)\\,\\text{d}t.\\end{aligned}\n$$\n\nWe evaluate the last integral using the substitution $u={e}^{t/2}.$ Then, $\\text{d}u=\\frac{1}{2}{e}^{t/2}\\,\\text{d}t,$ or $2\\,\\text{d}u={e}^{t/2}\\,\\text{d}t.$ We also update the limits of integration for $u:$\n\n| **$t$** | $0$ | $\\operatorname{ln}⁡4$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nTherefore, we get\n\n$$\n\\begin{aligned}S & ={\\int }_{0}^{\\operatorname{ln}⁡4}8\\pi ({e}^{t}+1)\\cdot {e}^{t/2}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}8\\pi ({u}^{2}+1)\\cdot 2\\,\\text{d}u \\\\  & =16\\pi {\\int }_{1}^{2}({u}^{2}+1)\\,\\text{d}u \\\\  & =16\\pi {[\\frac{{u}^{3}}{3}+u]}_{1}^{2} \\\\  & =16\\pi ((\\frac{8}{3}+2)-(\\frac{1}{3}+1)) \\\\  & =16\\pi (\\frac{14}{3}-\\frac{4}{3}) \\\\  & =16\\pi (\\frac{10}{3}) \\\\  & =\\frac{160\\pi }{3}.\\end{aligned}\n$$" 13194139536176 true] [17592186387408 1000 #edb/ref 17592186387409 13194139536176 true] [17592186387408 1000 #edb/ref 17592186387410 13194139536176 true] [17592186387408 1040 #edb/ref 17592186045449 13194139536176 true] [17592186387408 1041 "field-1" 13194139536176 true] [17592186387408 1104 #edb/ref 17592186387409 13194139536176 true] [17592186387408 1110 #uuid "c2e43e6c-e7b0-5460-bf0b-c8d4a4c46570" 13194139536176 true] [17592186387409 1034 "\\frac{160\\pi}{3}" 13194139536176 true] [17592186387409 1103 #edb/ref 17592186045453 13194139536176 true] [17592186387409 1111 #uuid "fa374d7c-4411-5a62-8563-5e84feaa60c7" 13194139536176 true] [17592186387410 1034 "\\frac{80\\pi}{3}" 13194139536176 true] [17592186387410 1103 #edb/ref 17592186045453 13194139536176 true] [17592186387410 1111 #uuid "c60d6a6f-1f82-5747-8247-1b9fffe2c1cf" 13194139536176 true]] :edb/tempids {"q-138968" 17592186387334 "q-138968/selection" 17592186387335 "q-138968/selection/23661ede757798ffc525445b87fc223468412ecaa49c95910af4e63603a171da" 17592186387336 "q-138968/selection/3bea9d8cd4fc3892626f9d7d9c0a758fcdef06531ed423bbff4983f4a738d7c5" 17592186387337 "q-138968/selection/429275a5ff2346a993e63cc1aea0d4ab25164f01b6127f24c5bab1423c0d933d" 17592186387338 "q-138968/selection/805887a0866385461955a44ecd9cb4d84c01a1c8d32dd68aebab7e81c8d6b253" 17592186387339 "q-138968/selection/b600077a2351dac33f695b94456b8472d5548bb1fd4c81ce5fb874e580e7c308" 17592186387340 "q-138979" 17592186387341 "q-138979/selection" 17592186387342 "q-138979/selection/141d2fdbc0ea1f617cb325d41726ed229a5a55d52