[{:db/id "q-80403/selection/c2aecc3c8ca0ea7e03b9bcb6005d59e32ad5cca23838d1996fc5b73ae1436cf0" :answer/id #uuid "e2c57dc7-2cb0-58ad-8793-c754bbdade0e" :answer/type :answer.type/math :answer/value "\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80403/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "1116da51-0686-53ac-a717-2a805f4c806f" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-80403/selection/cf2540eaef4eb96703b580c57c8e9f2dee7c739e4dbda954451a0c913d4c8721" :answer/id #uuid "294d9d73-fd6b-5737-bd43-44ba4b029f06" :answer/type :answer.type/math :answer/value "-\\frac{x-y}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80403/selection/641b8f9e53242ae022724fcb0a155f43b18e6f44fca215fb0090b4abbe3836f3" :answer/id #uuid "a4e310da-fbab-5cf7-91ee-fd80803c69ba" :answer/type :answer.type/math :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80403/selection/e0faa24dd1060bdef46bfe3c6722f7ffb934cb1c74df340e984b95446d67af33" :answer/id #uuid "5d2ccb86-60ad-528e-8451-25f1cc986782" :answer/type :answer.type/math :answer/value "-\\frac{-(x+y)}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80403/selection" :answer-field/id #uuid "d4b7b212-9858-5d6a-84ea-83c0249caacb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80403/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-80403/selection/c2aecc3c8ca0ea7e03b9bcb6005d59e32ad5cca23838d1996fc5b73ae1436cf0" "q-80403/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-80403/selection/cf2540eaef4eb96703b580c57c8e9f2dee7c739e4dbda954451a0c913d4c8721" "q-80403/selection/641b8f9e53242ae022724fcb0a155f43b18e6f44fca215fb0090b4abbe3836f3" "q-80403/selection/e0faa24dd1060bdef46bfe3c6722f7ffb934cb1c74df340e984b95446d67af33"] :db/ensure [:answer-field/validate]} {:db/id "q-80403" :question/id #uuid "e753edf8-58fc-597a-9f65-e842d6000549" :question/math-academy-id "q-80403" :question/problem "Find ${f}_{xx}(x,y)+{f}_{yy}(x,y)$ given that  ${f}_{x}(x,y)=-\\frac{y}{{x}^{2}+{y}^{2}}$ and ${f}_{y}(x,y)=\\frac{x}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "To find ${f}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =\\frac{∂}{∂x}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(-\\frac{y}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot \\frac{∂}{∂x}(\\frac{1}{{x}^{2}+{y}^{2}}) \\\\  & =-y\\cdot (-\\frac{2x}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${f}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot \\frac{∂}{∂y}(\\frac{1}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot (-\\frac{2y}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xx}(x,y)+{f}_{yy}(x,y) & =\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}=0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80403/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673"] :knowledge-point/questions ["q-80403"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80469/selection/a4d944d6a9daa5475f4291c325c17a45ab3968f0e7ef8afdb2f63f2b11978b9f" :answer/id #uuid "0f3b6c73-0448-5b76-bec8-2a617ac85bdf" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}-2xy-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80469/selection/ac6e2f8c586d77691e3073d42e6f93d8217467aba84e28edfe69d9976e2795dc" :answer/id #uuid "25ca5469-ae2c-5f0c-b653-d96a7de34d1b" :answer/type :answer.type/math :answer/value "\\frac{2{y}^{2}-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80469/selection/3e1a6022c88f69b78125d171c4c14411989979ef6ce54e18ed7ba199b1fc66fd" :answer/id #uuid "8f7463d3-4943-5427-bf00-7470889d4589" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}+2xy-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80469/selection/4e38265dc7b2f668fefa043b368d92b95d443ced92257802c782c1c8960d67a8" :answer/id #uuid "1019a7de-92e0-5bdf-8255-87b8fc565c77" :answer/type :answer.type/math :answer/value "\\frac{(y-x)^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80469/selection/9a7369fe9420d7a9258ab191742e075fac7598c4eab23d4431d6f57105a43c95" :answer/id #uuid "db3b5d12-dc5a-547b-8500-5dc2feaddd81" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}-2{x}^{2}}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-80469/selection" :answer-field/id #uuid "e8c5eea7-ca30-59de-a7cf-969d82fbcdc7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80469/selection/a4d944d6a9daa5475f4291c325c17a45ab3968f0e7ef8afdb2f63f2b11978b9f" :answer-field/choices ["q-80469/selection/a4d944d6a9daa5475f4291c325c17a45ab3968f0e7ef8afdb2f63f2b11978b9f" "q-80469/selection/ac6e2f8c586d77691e3073d42e6f93d8217467aba84e28edfe69d9976e2795dc" "q-80469/selection/3e1a6022c88f69b78125d171c4c14411989979ef6ce54e18ed7ba199b1fc66fd" "q-80469/selection/4e38265dc7b2f668fefa043b368d92b95d443ced92257802c782c1c8960d67a8" "q-80469/selection/9a7369fe9420d7a9258ab191742e075fac7598c4eab23d4431d6f57105a43c95"] :db/ensure [:answer-field/validate]} {:db/id "q-80469" :question/id #uuid "8c97e120-e555-59c4-8223-d7d466a7bcd8" :question/math-academy-id "q-80469" :question/problem "Find ${g}_{xy}(x,y)+{g}_{xx}(x,y)$ given that  ${g}_{x}(x,y)=\\frac{x}{{x}^{2}+{y}^{2}}.$" :question/worked-solution "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =x\\cdot (-\\frac{2y}{({x}^{2}+{y}^{2})^{2}}) \\\\  & =-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTo find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =\\frac{1}{{x}^{2}+{y}^{2}}-\\frac{x}{({x}^{2}+{y}^{2})^{2}}\\cdot 2x \\\\  & =\\frac{{x}^{2}+{y}^{2}-2{x}^{2}}{({x}^{2}+{y}^{2})^{2}} \\\\  & =\\frac{{y}^{2}-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{g}_{xy}(x,y)+{g}_{xx}(x,y) & =-\\frac{2xy}{({x}^{2}+{y}^{2})^{2}}+\\frac{{y}^{2}-{x}^{2}}{({x}^{2}+{y}^{2})^{2}} \\\\  & =\\frac{{y}^{2}-2xy-{x}^{2}}{({x}^{2}+{y}^{2})^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80469/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673"] :knowledge-point/questions ["q-80469"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80474/selection/ebe9f94a4a600c380835eb4cb211375ef37d940d0582b60d28a944795130ce8d" :answer/id #uuid "ed3e785d-cdf8-5c84-b8d0-78b6bbd8cdce" :answer/type :answer.type/math :answer/value "{x}^{2}\\operatorname{sin}⁡(xy)-xy\\operatorname{cos}⁡(xy)" :db/ensure [:answer/validate]} {:db/id "q-80474/selection/571c344f0e8415aead6924352d697950c878c3dc6bdfc07d2163a7dad22f025c" :answer/id #uuid "7d8b7507-4166-5ec8-8ae0-a5c68714a672" :answer/type :answer.type/math :answer/value "{x}^{2}y\\operatorname{cos}⁡(xy)" :db/ensure [:answer/validate]} {:db/id "q-80474/selection/1421bba2d9a8e5523532c9d5353186a43c27a1c8b5775a8664d89c2f2edcac27" :answer/id #uuid "dfef15c8-dd5d-5e20-a358-9ff8c6c86bee" :answer/type :answer.type/math :answer/value "-{x}^{2}y\\operatorname{sin}⁡(xy)" :db/ensure [:answer/validate]} {:db/id "q-80474/selection/a6662493235aaf5d300a2e41779ab9c083ac1783007a1eb9a9377cb993f1bf3e" :answer/id #uuid "0fb61e81-4ba0-5aae-9d6f-d8580ebb0072" :answer/type :answer.type/math :answer/value "-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)" :db/ensure [:answer/validate]} {:db/id "q-80474/selection/b88d0984bd1a96bd0324b16821e31f32f082c39be4e71be1e2306bc6fe879ad3" :answer/id #uuid "bb02b69f-f5d7-5aad-894b-342e32fb4cc5" :answer/type :answer.type/math :answer/value "-x\\operatorname{sin}⁡(xy)+xy\\operatorname{cos}⁡(xy)" :db/ensure [:answer/validate]} {:db/id "q-80474/selection" :answer-field/id #uuid "34ec01b2-3288-5a6b-b361-cd1da6ec3772" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80474/selection/a6662493235aaf5d300a2e41779ab9c083ac1783007a1eb9a9377cb993f1bf3e" :answer-field/choices ["q-80474/selection/ebe9f94a4a600c380835eb4cb211375ef37d940d0582b60d28a944795130ce8d" "q-80474/selection/571c344f0e8415aead6924352d697950c878c3dc6bdfc07d2163a7dad22f025c" "q-80474/selection/1421bba2d9a8e5523532c9d5353186a43c27a1c8b5775a8664d89c2f2edcac27" "q-80474/selection/a6662493235aaf5d300a2e41779ab9c083ac1783007a1eb9a9377cb993f1bf3e" "q-80474/selection/b88d0984bd1a96bd0324b16821e31f32f082c39be4e71be1e2306bc6fe879ad3"] :db/ensure [:answer-field/validate]} {:db/id "q-80474" :question/id #uuid "80238c18-8486-5149-b928-3f5a200b3672" :question/math-academy-id "q-80474" :question/problem "Calculate ${f}_{yyx}(x,y)$ given that $f(x,y)=\\operatorname{sin}⁡(xy).$" :question/worked-solution "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy)) \\\\  & =x\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nNext, we find ${f}_{yy}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡(xy)) \\\\  & =-{x}^{2}\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nFinally, we find ${f}_{yyx}(x,y)$ by differentiating ${f}_{yy}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yyx}(x,y) & =\\frac{∂}{∂x}({f}_{yy}(x,y)) \\\\  & =\\frac{∂}{∂x}(-{x}^{2}\\operatorname{sin}⁡(xy)) \\\\  & =-2x\\cdot \\operatorname{sin}⁡(xy)-{x}^{2}\\cdot \\operatorname{cos}⁡(xy)\\cdot y \\\\  & =-2x\\operatorname{sin}⁡(xy)-{x}^{2}y\\operatorname{cos}⁡(xy)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80474/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38"] :knowledge-point/questions ["q-80474"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132894/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "623a7141-d94a-5d42-8263-2b090887d144" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-132894/selection/fc56af872312876ed2b2a58b5b35b52ca21e0f2445febc40c43683b8252c7c36" :answer/id #uuid "1f5a6900-a291-5084-94b1-36e25017c628" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\sqrt{3}+\\pi )" :db/ensure [:answer/validate]} {:db/id "q-132894/selection/507533fe9aaec7ea8d63314c265713eff329cd2aeedfabc9a6c270ec77c9e283" :answer/id #uuid "0eaf434b-c8a7-521f-91da-406c51252b38" :answer/type :answer.type/math :answer/value "\\sqrt{3}-\\pi " :db/ensure [:answer/validate]} {:db/id "q-132894/selection/08cb021aecbc2d096a0bfe30ce3d08f62c29605c27e566e80ba57faef72e1cec" :answer/id #uuid "fae74f18-853a-5710-9dc9-d9f14d105b95" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\pi -\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-132894/selection/24d842f03e999e132d1e860866398b56dc5dac07fe9a2c7016345b66af4a7a1a" :answer/id #uuid "47caf0c6-c2e2-542f-a94c-15b9db3ddb84" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(\\sqrt{3}-\\frac{\\pi }{3})" :db/ensure [:answer/validate]} {:db/id "q-132894/selection" :answer-field/id #uuid "873de911-186f-5b87-889c-bbe068ce98d2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132894/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-132894/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-132894/selection/fc56af872312876ed2b2a58b5b35b52ca21e0f2445febc40c43683b8252c7c36" "q-132894/selection/507533fe9aaec7ea8d63314c265713eff329cd2aeedfabc9a6c270ec77c9e283" "q-132894/selection/08cb021aecbc2d096a0bfe30ce3d08f62c29605c27e566e80ba57faef72e1cec" "q-132894/selection/24d842f03e999e132d1e860866398b56dc5dac07fe9a2c7016345b66af4a7a1a"] :db/ensure [:answer-field/validate]} {:db/id "q-132894" :question/id #uuid "1c3855bf-1622-5d3d-847f-9d7c74379538" :question/math-academy-id "q-132894" :question/problem "Find ${g}_{xx}(x,y)-{g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3})$ given that ${g}_{x}(x,y)=x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)$ and ${g}_{y}(x,y)=x\\operatorname{sin}⁡(x+y).$" :question/worked-solution "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{sin}⁡(x+y)-\\operatorname{cos}⁡(x+y)) \\\\  & =\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)+\\operatorname{sin}⁡(x+y) \\\\  & =2\\operatorname{sin}⁡(x+y)+x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{sin}⁡(x+y)) \\\\  & =x\\operatorname{cos}⁡(x+y)\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(\\frac{\\pi }{3},\\frac{\\pi }{3}):$\n\n$$\n\\begin{aligned}{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =2\\operatorname{sin}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})+\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6} \\\\ {g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3}) & =\\frac{\\pi }{3}\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{3})=-\\frac{\\pi }{6}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(\\frac{\\pi }{3},\\frac{\\pi }{3})-{g}_{yy}(\\frac{\\pi }{3},\\frac{\\pi }{3})=\\sqrt{3}-\\frac{\\pi }{6}-(-\\frac{\\pi }{6})=\\sqrt{3}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-132894/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "503a0bfe-7c69-5ad0-ad1d-aa8692dae673"] :knowledge-point/questions ["q-132894"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132984/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer/id #uuid "2528ed8a-e6b9-5549-896f-9cc56b700eb0" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "q-132984/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "7711932b-125e-5d2c-94e1-24e735a181e1" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-132984/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "354a7545-e85e-59df-b65d-d2eefb2ac3ea" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-132984/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "142d340b-0f5a-5abf-932b-039c8dc51fb6" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-132984/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "1bae5314-0108-50bb-97e6-13d0524a8345" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-132984/selection" :answer-field/id #uuid "0008eab6-b6ff-5522-9bc3-18ed3af8ed73" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132984/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer-field/choices ["q-132984/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" "q-132984/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-132984/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" "q-132984/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-132984/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45"] :db/ensure [:answer-field/validate]} {:db/id "q-132984" :question/id #uuid "130ad7f8-2367-56d1-afed-1995cee8fbfb" :question/math-academy-id "q-132984" :question/problem "Evaluate ${f}_{xyz}(-1,2,1)$ for $f(x,y,z)={x}^{3}{y}^{2}{z}^{2}-\\frac{3}{\\operatorname{ln}⁡z}.$" :question/worked-solution "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({z}^{2}{x}^{3}{y}^{2}-\\frac{3}{\\operatorname{ln}⁡z}) \\\\  & =3{x}^{2}{y}^{2}{z}^{2}\\end{aligned}\n$$\n\nNow, we find ${f}_{xy}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y,z) & =\\frac{∂}{∂y}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(3{x}^{2}{y}^{2}{z}^{2}) \\\\  & =6{x}^{2}y{z}^{2}\\end{aligned}\n$$\n\nNext, we find ${f}_{xyz}(x,y,z)$ by differentiating ${f}_{xy}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xy}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(6{x}^{2}y{z}^{2}) \\\\  & =12{x}^{2}yz\\end{aligned}\n$$\n\nFinally, we evaluate ${f}_{xyz}(x,y,z)$ at $(-1,2,1):$\n\n$$\n\\begin{aligned}{f}_{xyz}(-1,2,1) & =12(-1)^{2}(2)(1)=24\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-132984/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "83724b66-0f15-5b94-9576-76e9dfd56d38"] :knowledge-point/questions ["q-132984"] :db/ensure [:knowledge-point/validate]}]
