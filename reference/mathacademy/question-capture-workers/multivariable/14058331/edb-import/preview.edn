{t}^{2}}\\cdot 2\\sqrt{2}\\cdot \\text{d}t \\\\  & =2\\sqrt{2}{\\int }_{0}^{1}(8t+2)\\,{e}^{2t+4{t}^{2}}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=2t+4{t}^{2},$ $\\text{d}u=(2+8t)\\,\\text{d}t$ as follows:  \n\n$$\n\\begin{aligned}2\\sqrt{2}{\\int }_{0}^{1}(8t+2)\\,{e}^{2t+4{t}^{2}}\\,\\text{d}t & =2\\sqrt{2}{\\int }_{0}^{6}{e}^{u}\\,\\text{d}u \\\\  & =2\\sqrt{2}\\,{e}^{u}\\,{|}_{0}^{6} \\\\  & =2\\sqrt{2}({e}^{6}-{e}^{0}) \\\\  & =2\\sqrt{2}({e}^{6}-1)\\end{aligned}\n$$" 13194139535181 true] [17592186335946 1000 #edb/ref 17592186335947 13194139535181 true] [17592186335946 1000 #edb/ref 17592186335948 13194139535181 true] [17592186335946 1000 #edb/ref 17592186335949 13194139535181 true] [17592186335946 1000 #edb/ref 17592186335950 13194139535181 true] [17592186335946 1000 #edb/ref 17592186335951 13194139535181 true] [17592186335946 1040 #edb/ref 17592186045450 13194139535181 true] [17592186335946 1041 "selection" 13194139535181 true] [17592186335946 1104 #edb/ref 17592186335949 13194139535181 true] [17592186335946 1110 #uuid "0ef71ad3-cc87-5b91-8a6c-7e531aa8bd65" 13194139535181 true] [17592186335947 1034 "\\sqrt{2}({e}^{6}-1)" 13194139535181 true] [17592186335947 1103 #edb/ref 17592186045453 13194139535181 true] [17592186335947 1111 #uuid "ad4bf771-f5f2-5fb4-83fe-42bfe4852a08" 13194139535181 true] [17592186335948 1034 "2({e}^{6}-1)" 13194139535181 true] [17592186335948 1103 #edb/ref 17592186045453 13194139535181 true] [17592186335948 1111 #uuid "08ea5b05-df62-5298-a748-9528b4a30408" 13194139535181 true] [17592186335949 1034 "2\\sqrt{2}({e}^{6}-1)" 13194139535181 true] [17592186335949 1103 #edb/ref 17592186045453 13194139535181 true] [17592186335949 1111 #uuid "1b552fac-410e-5af3-bea2-eb26d8e10e40" 13194139535181 true] [17592186335950 1034 "2e\\sqrt{2}({e}^{5}-1)" 13194139535181 true] [17592186335950 1103 #edb/ref 17592186045453 13194139535181 true] [17592186335950 1111 #uuid "bbd49761-2cba-5f36-9fb6-6a1498f98228" 13194139535181 