mport/verification.json"} {"question" "q-78379" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "(6,9)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949542/state.json" "file_sha256" "04180657b303999f72ca01cb996b0139ea810637ab9c20e94bd9af51ba2022fb" "basis" 580 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13949542/edb-import/verification.json"} {"question" "q-328355" "field" nil "attribute" "question/problem" "value" "The center of the hyperbola $4{x}^{2}-{y}^{2}-8x+6y=11$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/state.json" "file_sha256" "d281669f496ebbd76aab3f14de55dfe8003b38563b8e8e9196cb407cdfa547a0" "basis" 976 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/edb-import/verification.json"} {"question" "q-328355" "field" nil "attribute" "question/worked-solution" "value" "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the given equation in standard form, group the $x$ and $y$ terms and complete the squares:\n\n$$\n\\begin{aligned}4{x}^{2}-{y}^{2}-8x+6y & =11 \\\\ 4({x}^{2}-2x)-({y}^{2}-6y) & =11 \\\\ 4[(x-1)^{2}-1]-[(y-3)^{2}-9] & =11 \\\\ 4(x-1)^{2}-4-(y-3)^{2}+9 & =11 \\\\ 4(x-1)^{2}-(y-3)^{2} & =11+4-9 \\\\ 4(x-1)^{2}-(y-3)^{2} & =6 \\\\ \\frac{(x-1)^{2}}{3/2}-\\frac{(y-3)^{2}}{6} & =1.\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,3\\,).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/state.json" "file_sha256" "d281669f496ebbd76aab3f14de55dfe8003b38563b8e8e9196cb407cdfa547a0" "basis" 976 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/edb-import/verification.json"} {"question" "q-328355" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/activity-metadata.json" "file_sha256" "ffd4734ecee11eae46a2ed4c95c42443f4b1ead9798dedc6e38d085c1b8ddf33" "basis" 976 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/edb-import/verification.json"} {"question" "q-328355" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/state.json" "file_sha256" "d281669f496ebbd76aab3f14de55dfe8003b38563b8e8e9196cb407cdfa547a0" "basis" 976 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/edb-import/verification.json"} {"question" "q-328355" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/state.json" "file_sha256" "d281669f496ebbd76aab3f14de55dfe8003b38563b8e8e9196cb407cdfa547a0" "basis" 976 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13988753/edb-import/verification.json"} {"question" "q-328358" "field" nil "attribute" "question/problem" "value" "The center of the hyperbola $4{x}^{2}-{y}^{2}-8x+2y=7$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "0a685444faccd327a9a553c528ef51d6a23e914a34faf9f99d0a9afa2864db2d" "basis" 1173 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/edb-import/verification.json"} {"question" "q-328358" "field" nil "attribute" "question/worked-solution" "value" "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the given equation in standard form, group the $x$ and $y$ terms and complete the squares:\n\n$$\n\\begin{aligned}4{x}^{2}-{y}^{2}-8x+2y & =7 \\\\ 4({x}^{2}-2x)-({y}^{2}-2y) & =7 \\\\ 4[(x-1)^{2}-1]-[(y-1)^{2}-1] & =7 \\\\ 4(x-1)^{2}-4-(y-1)^{2}+1 & =7 \\\\ 4(x-1)^{2}-(y-1)^{2} & =7+4-1 \\\\ 4(x-1)^{2}-(y-1)^{2} & =10 \\\\ \\frac{(x-1)^{2}}{5/2}-\\frac{(y-1)^{2}}{10} & =1.\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,1\\,).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "0a685444faccd327a9a553c528ef51d6a23e914a34faf9f99d0a9afa2864db2d" "basis" 1173 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/edb-import/verification.json"} {"question" "q-328358" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/activity-metadata.json" "file_sha256" "08283654b18d4f3db96e73000f824a9f15e18318a753ff27764d0667804ac18d" "basis" 1173 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/edb-import/verification.json"} {"question" "q-328358" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/state.json" "file_sha256" "0a685444faccd327a9a553c528ef51d6a23e914a34faf9f99d0a9afa2864db2d" "basis" 1173 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14013817/edb-import/verification.json"} {"question" "q-328358" "field" "field-2" "attribute" "answ