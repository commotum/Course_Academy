#{[{:db/id #edb/ref 17592186291471 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "72c86939-8c99-5a56-8ffe-383a1b611c26" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291473} {:answer/id #uuid "f5884a66-2e21-5b66-bcf5-af8f60d4b733" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186291474}] :answer-field/correct {:answer/id #uuid "72c86939-8c99-5a56-8ffe-383a1b611c26" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291473} :answer-field/id #uuid "bc4a7150-b28b-5f86-bf16-b80258a5f170" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291472} {:answer-field/choices [{:answer/id #uuid "baf47612-0907-5263-95fe-e164d900bd4f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291476}] :answer-field/correct {:answer/id #uuid "baf47612-0907-5263-95fe-e164d900bd4f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186291476} :answer-field/id #uuid "3fd4b86e-2a1b-5c6a-86a9-1e03505a534b" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186291475}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "de9dda81-a345-5236-acbb-5d210b78c08c" :question/math-academy-id "q-328358" :question/problem "The center of the hyperbola $4{x}^{2}-{y}^{2}-8x+2y=7$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the given equation in standard form, group the $x$ and $y$ terms and complete the squares:\n\n$$\n\\begin{aligned}4{x}^{2}-{y}^{2}-8x+2y & =7 \\\\ 4({x}^{2}-2x)-({y}^{2}-2y) & =7 \\\\ 4[(x-1)^{2}-1]-[(y-1)^{2}-1] & =7 \\\\ 4(x-1)^{2}-4-(y-1)^{2}+1 & =7 \\\\ 4(x-1)^{2}-(y-1)^{2} & =7+4-1 \\\\ 4(x-1)^{2}-(y-1)^{2} & =10 \\\\ \\frac{(x-1)^{2}}{5/2}-\\frac{(y-1)^{2}}{10} & =1.\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,1\\,).$"}]}
