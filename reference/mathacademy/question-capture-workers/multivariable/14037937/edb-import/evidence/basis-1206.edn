#{[{:db/id #edb/ref 17592186292905 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7318ed52-b5d6-52a1-a771-333d18578307" :answer/type {:db/ident :answer.type/math} :answer/value "(7,-4)" :db/id #edb/ref 17592186292907} {:answer/id #uuid "ae6df21f-943c-5bda-a647-56b849766d9f" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,9)" :db/id #edb/ref 17592186292908} {:answer/id #uuid "3e9e4df3-52af-5a57-9f44-011e417573b4" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-7)" :db/id #edb/ref 17592186292909} {:answer/id #uuid "6364d58e-2fd4-5f1f-877f-5b3230936160" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,7)" :db/id #edb/ref 17592186292910} {:answer/id #uuid "82ea2dc5-4aed-5797-8435-8c74b31f1e50" :answer/type {:db/ident :answer.type/math} :answer/value "(9,1)" :db/id #edb/ref 17592186292911}] :answer-field/correct {:answer/id #uuid "6364d58e-2fd4-5f1f-877f-5b3230936160" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,7)" :db/id #edb/ref 17592186292910} :answer-field/id #uuid "6f6b5fcd-1080-5de0-9c6e-99bbcb2f126d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292906}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b2096e13-b432-5188-9b2a-286612b8e650" :question/math-academy-id "q-78868" :question/problem "What is the center of the hyperbola $\\frac{(y-7)^{2}}{9}-(x+4)^{2}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-7)^{2}}{9}-\\frac{(x-(-4))^{2}}{1}=1\n$$\n\nIn this case, we have $h=-4$ and $k=7.$\n\nTherefore, the center of the hyperbola is $(-4,7).$"}]}
