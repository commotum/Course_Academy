#{[{:db/id #edb/ref 17592186283230 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98792725-41a0-5da0-b5d6-db129288946a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283232} {:answer/id #uuid "85fa5698-91ef-5c47-ba6f-ce806d63abad" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186283233}] :answer-field/correct {:answer/id #uuid "98792725-41a0-5da0-b5d6-db129288946a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186283232} :answer-field/id #uuid "a46e7f45-4f14-549b-8d34-2661338a50d1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283231} {:answer-field/choices [{:answer/id #uuid "1591d5c8-2a19-5ea4-9ff8-fe4dff361aaa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283235}] :answer-field/correct {:answer/id #uuid "1591d5c8-2a19-5ea4-9ff8-fe4dff361aaa" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186283235} :answer-field/id #uuid "3aeef4ab-8348-5c3d-8693-991a60de3e78" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283234}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e9b14a36-f374-5fea-92c5-1f777c17e46a" :question/math-academy-id "q-328355" :question/problem "The center of the hyperbola $4{x}^{2}-{y}^{2}-8x+6y=11$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the given equation in standard form, group the $x$ and $y$ terms and complete the squares:\n\n$$\n\\begin{aligned}4{x}^{2}-{y}^{2}-8x+6y & =11 \\\\ 4({x}^{2}-2x)-({y}^{2}-6y) & =11 \\\\ 4[(x-1)^{2}-1]-[(y-3)^{2}-9] & =11 \\\\ 4(x-1)^{2}-4-(y-3)^{2}+9 & =11 \\\\ 4(x-1)^{2}-(y-3)^{2} & =11+4-9 \\\\ 4(x-1)^{2}-(y-3)^{2} & =6 \\\\ \\frac{(x-1)^{2}}{3/2}-\\frac{(y-3)^{2}}{6} & =1.\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,1,3\\,).$"}]}
