y} :question/id #uuid "a3668991-b7c7-5625-859d-527dc7e0482e" :question/math-academy-id "q-116082" :question/problem "What is the center of the hyperbola $\\frac{(x+2)^{2}}{5}-\\frac{(y-4)^{2}}{6}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-(-2))^{2}}{(\\sqrt{5})^{2}}-\\frac{(y-4)^{2}}{(\\sqrt{6})^{2}}=1\n$$\n\nIn this case, $h=-2$ and $k=4.$\n\nTherefore, the center of the hyperbola is $(-2,4).$"}] [{:db/id #edb/ref 17592186298147 :knowledge-point/_questions [{:knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "15e9b901-a13e-51f6-978a-ee437c87b56e" :answer/type {:db/ident :answer.type/math} :answer/value "(8,2)" :db/id #edb/ref 17592186298149} {:answer/id #uuid "6fff8cb2-47ec-5081-bb9b-68b96f3a3f73" :answer/type {:db/ident :answer.type/math} :answer/value "(2,8)" :db/id #edb/ref 17592186298150} {:answer/id #uuid "b205a97a-b7f9-5885-adcb-9bd1d7eb3a6e" :answer/type {:db/ident :answer.type/math} :answer/value "(2,5)" :db/id #edb/ref 17592186298151} {:answer/id #uuid "cdcb06d1-0478-553f-a949-2848d6595281" :answer/type {:db/ident :answer.type/math} :answer/value "(5,2)" :db/id #edb/ref 17592186298152} {:answer/id #uuid "61621451-ca6b-5033-a73f-7da14fb179da" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-8)" :db/id #edb/ref 17592186298153}] :answer-field/correct {:answer/id #uuid "6fff8cb2-47ec-5081-bb9b-68b96f3a3f73" :answer/type {:db/ident :answer.type/math} :answer/value "(2,8)" :db/id #edb/ref 17592186298150} :answer-field/id #uuid "ec52956e-d360-5493-b806-07c237c39230" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298148}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f4106658-11af-5e6f-bc57-a5f578d555d8" :question/math-academy-id "q-116086" :question/problem "What is the center of the hyperbola $\\frac{(x-2)^{2}}{25}-\\frac{(y-8)^{2}}{4}=1?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-2)^{2}}{{5}^{2}}-\\frac{(y-8)^{2}}{{2}^{2}}=1\n$$\n\nIn this case, $h=2$ and $k=8.$\n\nTherefore, the center of the hyperbola is $(2,8).$"}] [{:db/id #edb/ref 17592186298154 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2ee0f8d9-4e3a-598b-a9b8-b2345b37fac0" :answer/type {:db/ident :answer.type/math} :answer/value "(4,0)" :db/id #edb/ref 17592186298156} {:answer/id #uuid "129671c2-f886-5d73-b036-913c12caff1f" :answer/type {:db/ident :answer.type/math} :answer/value "(2,5)" :db/id #edb/ref 17592186298157} {:answer/id #uuid "29b5747b-134e-5faa-a25e-b01dc8742a42" :answer/type {:db/ident :answer.type/math} :answer/value "(5,2)" :db/id #edb/ref 17592186298158} {:answer/id #uuid "be27575a-46e9-5903-b396-0461bb673b6c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186298159} {:answer/id #uuid "11a93e41-d422-566b-a2c6-b4dcab0220e0" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,0)" :db/id #edb/ref 17592186298160}] :answer-field/correct {:answer/id #uuid "be27575a-46e9-5903-b396-0461bb673b6c" :answer/type {:db/ident :answer.type/math} :answer/value "(0,4)" :db/id #edb/ref 17592186298159} :answer-field/id #uuid "e5397d73-8a04-5ff2-a30d-a413b0fe66ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298155}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fe9bae86-29f5-5081-a9a1-ca082f8cf4d4" :question/math-academy-id "q-116102" :question/problem "What is the center of the hyperbola $\\frac{(y-4)^{2}}{4}-\\frac{{x}^{2}}{25}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-4)^{2}}{{2}^{2}}-\\frac{(x-0)^{2}}{{5}^{2}}=1\n$$\n\nIn this case, we have $h=0$ and $k=4.$\n\nTherefore, the center of the hyperbola is $(0,4).$"}] [{:db/id #edb/ref 17592186298161 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e6885b0b-8f6a-5ed3-90a1-34ed60681d75" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186298163} {:answer/id #uuid "d2198cfc-6720-5e11-b5f0-e75b1226f2f3" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-4)" :db/id #edb/ref 17592186298164} {:answer/id #uuid "637acd3e-97d8-53c3-ad7c-c22e3d33afb5" :answer/type {:db/ident :answer.type/math} :answer/value "(1,3)" :db/id #edb/ref 17592186298165} {:answer/id #uuid "eca4497e-956f-51b8-a0b7-5873a991eba0" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,6)" :db/id #edb/ref 17592186298166} {:answer/id #uuid "5dc3c7b1-9243-5caa-9f8e-aee06b7c1766" :answer/type {:db/ident :answer.type/math} :answer/value "(-6,4)" :db/id #edb/ref 17592186298167}] :answer-field/correct {:answer/id #uuid "d2198cfc-6720-5e11-b5f0-e75b1226f2f3" :answer/type {:db/ident :answer.type/math} :answer/value "(6,-4)" :db/id #edb/ref 17592186298164} :answer-field/id #uuid "919713a4-46ca-5a1b-a100-7c306dccfd7c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298162}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "26612c97-0720-569b-b769-98a2b47976ff" :question/math-academy-id "q-116118" :question/problem "What is the center of the hyperbola \n$-{x}^{2}+3{y}^{2}+12x+24y=-9?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-{x}^{2}+3{y}^{2}+12x+24y & =-9 \\\\ 3{y}^{2}+24y-{x}^{2}+12x & =-9 \\\\ 3[{y}^{2}+8y]-[{x}^{2}-12x] & =-9 \\\\ 3[(y+4)^{2}-16]-[(x-6)^{2}-36] & =-9 \\\\ 3(y+4)^{2}-48-(x-6)^{2}+36 & =-9 \\\\ 3(y+4)^{2}-(x-6)^{2} & =-9+48-36 \\\\ 3(y+4)^{2}-(x-6)^{2} & =3 \\\\ (y+4)^{2}-\\frac{(x-6)^{2}}{3} & =1 \\\\ \\frac{(y-(-4))^{2}}{{1}^{2}}-\\frac{(x-6)^{2}}{(\\sqrt{3})^{2}} & =1.\\end{aligned}\n$$\n\nHence, the center is $(6,-4).$"}] [{:db/id #edb/ref 17592186298168 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ac2f9cd6-7f31-5514-8d95-9bdf8f36b774" :answer/type {:db/ident :answer.type/math} :answer/value "(4,4)" :db/id #edb/ref 17592186298170} {:answer/id #uuid "609c4f04-67d8-5c03-8001-b562523e9abf" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-3)" :db/id #edb/ref 17592186298171} {:answer/id #uuid "c2b81028-ea60-53cc-9d69-3e5f51830096" :answer/type {:db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186298172} {:answer/id #uuid "1df6296b-c603-5331-a801-fa802e339ebd" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-4)" :db/id #edb/ref 17592186298173} {:answer/id #uuid "e5eb8b47-2f4b-5c74-b309-d00e30d70215" :answer/type {:db/ident :answer.type/math} :answer/value "(4,-4)" :db/id #edb/ref 17592186298174}] :answer-field/correct {:answer/id #uuid "1df6296b-c603-5331-a801-fa802e339ebd" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,-4)" :db/id #edb/ref 17592186298173} :answer-field/id #uuid "31291d09-d33f-585a-aa4f-7e082dc55bdb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298169}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "06fc4f4a-0b4c-50cd-a212-e802af5be139" :question/math-academy-id "q-116122" :question/problem "What is the center of the hyperbola \n$-3{x}^{2}+{y}^{2}-24x+8y=41?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-3{x}^{2}+{y}^{2}-24x+8y & =41 \\\\ {y}^{2}+8y-3{x}^{2}-24x & =41 \\\\ [{y}^{2}+8y]-3[{x}^{2}+8x] & =41 \\\\ [(y+4)^{2}-16]-3[(x+4)^{2}-16] & =41 \\\\ (y+4)^{2}-16-3(x+4)^{2}+48 & =41 \\\\ (y+4)^{2}-3(x+4)^{2} & =41+16-48 \\\\ (y+4)^{2}-3(x+4)^{2} & =9 \\\\ \\frac{(y+4)^{2}}{9}-\\frac{(x+4)^{2}}{3} & =1 \\\\ \\frac{(y-(-4))^{2}}{{3}^{2}}-\\frac{(x-(-4))^{2}}{(\\sqrt{3})^{2}} & =1.\\end{aligned}\n$$\n\nHence, the center is $(-4,-4).$"}] [{:db/id #edb/ref 17592186298175 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "05589f08-7097-5c65-8916-f56caeb015f9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298177} {:answer/id #uuid "fb265e28-4b3d-54cc-8919-e0b68573d367" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186298178}] :answer-field/correct {:answer/id #uuid "05589f08-7097-5c65-8916-f56caeb015f9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186298177} :answer-field/id #uuid "6f22a483-2528-5707-8809-d724ee9b0bac" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298176} {:answer-field/choices [{:answer/id #uuid "d474651f-fff4-518c-ba35-d6332b5eaaf6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298180}] :answer-field/correct {:answer/id #uuid "d474651f-fff4-518c-ba35-d6332b5eaaf6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186298180} :answer-field/id #uuid "caaf31fa-8cff-5512-865c-eb67c4bf527d" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298179}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6a6f7719-246b-5cb9-9010-c1535116b5f5" :question/math-academy-id "q-274638" :question/problem "The center of the hyperbola $9{x}^{2}-16{y}^{2}-54x+64y=-1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in standard form, we need to group $x$ and $y$ terms and complete the squares as follows:\n\n$$\n\\begin{aligned}9{x}^{2}-16{y}^{2}-54x+64y & =-1 \\\\ 9{x}^{2}-54x-16{y}^{2}+64y & =-1 \\\\ 9[{x}^{2}-6x]-16[{y}^{2}-4y] & =-1 \\\\ 9[(x-3)^{2}-9]-16[(y-2)^{2}-4] & =-1 \\\\ 9(x-3)^{2}-81-16(y-2)^{2}+64 & =-1 \\\\ 9(x-3)^{2}-16(y-2)^{2} & =-1+81-64 \\\\ 9(x-3)^{2}-16(y-2)^{2} & =16 \\\\ \\frac{(x-3)^{2}}{{(\\frac{4}{3})}^{2}}-\\frac{(y-2)^{2}}{{1}^{2}} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,3,2\\,).$"}] [{:db/id #edb/ref 17592186298181 :knowledge-point/_questions [{:knowledge-point/id #uuid "f99d4fec-bc58-5a09-9fac-38b46f233489" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45ee0728-4f29-55d1-ac90-9c33ee08f33c" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298183}] :answer-field/correct {:answer/id #uuid "45ee0728-4f29-55d1-ac90-9c33ee08f33c" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186298183} :answer-field/id #uuid "02323939-2f25-5023-943e-5fc5d51e18de" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298182} {:answer-field/choices [{:answer/id #uuid "5e43ab64-f74a-5951-bad4-62ee76362849" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186298185}] :answer-field/correct {:answer/id #uuid "5e43ab64-f74a-5951-bad4-62ee76362849" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186298185} :answer-field/id #uuid "23c13937-be80-54e2-a61a-8e5fe4f78a04" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186298184}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "232462ce-9aca-5a81-9eb0-b525a27151cd" :question/math-academy-id "q-328264" :question/problem "The center of the hyperbola $\\frac{(x+6)^{2}}{64}-\\frac{(y+11)^{2}}{49}=1$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(x-(-6))^{