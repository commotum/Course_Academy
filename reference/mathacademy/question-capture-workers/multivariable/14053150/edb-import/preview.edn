c{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{1}^{2}} \\\\  & =\\sqrt{1+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, since $f(x,y)=x+y$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =t+(1+t)=2t+1.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}s & ={\\int }_{0}^{1}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}(2t+1)\\cdot \\sqrt{2}\\cdot \\text{d}t \\\\  & =\\sqrt{2}{\\int }_{0}^{1}2t+1\\,\\text{d}t \\\\  & =\\sqrt{2}{[{t}^{2}+t]}_{0}^{1} \\\\  & =\\sqrt{2}(1+1-0) \\\\  & =2\\sqrt{2}.\\end{aligned}\n$$" 13194139535087 true] [17592186330403 1000 #edb/ref 17592186330404 13194139535087 true] [17592186330403 1000 #edb/ref 17592186330405 13194139535087 true] [17592186330403 1000 #edb/ref 17592186330406 13194139535087 true] [17592186330403 1000 #edb/ref 17592186330407 13194139535087 true] [17592186330403 1000 #edb/ref 17592186330408 13194139535087 true] [17592186330403 1040 #edb/ref 17592186045450 13194139535087 true] [17592186330403 1041 "selection" 13194139535087 true] [17592186330403 1104 #edb/ref 17592186330406 13194139535087 true] [17592186330403 1110 #uuid "5f4b5fdd-5557-511e-b596-d1a1f4a96a8b" 13194139535087 true] [17592186330404 1034 "\\sqrt{2}" 13194139535087 true] [17592186330404 1103 #edb/ref 17592186045453 13194139535087 true] [17592186330404 1111 #uuid "cef1b1ec-6f32-566c-9b29-3059b9bcc304" 13194139535087 true] [17592186330405 1034 "2" 13194139535087 true] [17592186330405 1103 #edb/ref 17592186045453 13194139535087 true] [17592186330405 1111 #uuid "3045b749-b61d-5b6c-99ec-e8a3e181cdf5" 13194139535087 true] [17592186330406 1034 "2\\sqrt{2}" 13194139535087 true] [17592186330406 1103 #edb/ref 17592186045453 13194139535087 true] [17592186330406 1111 #uuid "88f4b64c-0637-5605-afea-a3f0f66a6587" 13194139535087 true] [17592186330407 1034 "4" 13194139535087 true] [17592186330407 1103 #edb/ref 17592186045453 13194139535087 true] [175921