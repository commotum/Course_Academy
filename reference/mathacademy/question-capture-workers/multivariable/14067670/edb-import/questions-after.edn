#{[{:db/id #edb/ref 17592186355950 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b95ef5e-0c8d-5ccc-889f-7503aa2d49df" :answer/type {:db/ident :answer.type/text} :answer/value "A paraboloid" :db/id #edb/ref 17592186355952} {:answer/id #uuid "a0864500-bd8a-5d31-8c75-62933711a497" :answer/type {:db/ident :answer.type/text} :answer/value "A cylinder" :db/id #edb/ref 17592186355953} {:answer/id #uuid "c3b4f7f8-d111-5e88-94d3-2975ad169d76" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid" :db/id #edb/ref 17592186355954} {:answer/id #uuid "6c33bd8b-abb1-5914-b572-caba20c624f8" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186355955} {:answer/id #uuid "8e0be18f-9c8c-5207-b49d-d08a2c1c0846" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186355956}] :answer-field/correct {:answer/id #uuid "8e0be18f-9c8c-5207-b49d-d08a2c1c0846" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186355956} :answer-field/id #uuid "bfb762f9-9a83-5d9a-a07c-3fdfd0036b1b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355951}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1ef46611-6066-5608-b7b6-cb53d9ef1a50" :question/math-academy-id "q-164403" :question/problem "Identify the following surface: \n\n$$\n\\frac{(x-1)^{2}}{9}+\\frac{(y+2)^{2}}{7}+\\frac{{z}^{2}}{4}=1\n$$" :question/worked-solution "Recall that the equation of an ellipsoid centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1,\n$$\n\nand an ellipsoid centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}+\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=1,\n$$\n\nThus, our equation is an ellipsoid with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(1,-2,0),\\,a=3,\\,b=\\sqrt{7},\\,c=2.\n$$"}] [{:db/id #edb/ref 17592186355957 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f3ca0e8c-1512-51c5-b94b-7afc00632307" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186355959} {:answer/id #uuid "377835be-5d0e-56f2-a9ef-642088f19904" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186355960} {:answer/id #uuid "2ba23b59-3a71-5232-be12-e09eeb7a7154" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186355961} {:answer/id #uuid "0751a617-c31e-5e05-835a-bbc397b694ac" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186355962} {:answer/id #uuid "64f0906a-02e2-5de4-8d4a-2ce5a428d598" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186355963}] :answer-field/correct {:answer/id #uuid "64f0906a-02e2-5de4-8d4a-2ce5a428d598" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186355963} :answer-field/id #uuid "f6d8ff84-e3ee-57de-8b2b-280332bc1836" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355958}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "86cae1b8-bb88-5825-87a6-01d4f4777d9f" :question/math-academy-id "q-164508" :question/problem "Identify the surface $\\frac{{z}^{2}}{9}+{y}^{2}-{x}^{2}=-1.$" :question/worked-solution "Recall that the equation of a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of two sheets centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of two sheets whose axis of symmetry is the $x$-axis and $a=b=1,\\,c=3.$"}] [{:db/id #edb/ref 17592186355964 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55f3c4e2-5bd5-5912-8dc7-0e7f21c45759" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186355966} {:answer/id #uuid "4733e6f0-f206-5b9f-abf1-424b35adfa19" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186355967} {:answer/id #uuid "f25fbd18-bad6-56e4-8efc-44801d44e3a1" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186355968} {:answer/id #uuid "ad1f24e8-1a9c-5b03-8b3c-40ad0cd72dad" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186355969} {:answer/id #uuid "3e486243-b8a7-59e3-ad81-7d33c0ff56cf" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186355970}] :answer-field/correct {:answer/id #uuid "55f3c4e2-5bd5-5912-8dc7-0e7f21c45759" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186355966} :answer-field/id #uuid "f790f26b-c41f-5849-89e2-f6fad94e05bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355965}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "053926ce-0dff-5aef-bfd1-e83aa21062c5" :question/math-academy-id "q-164516" :question/problem "Identify the following surface: \n\n$$\n{y}^{2}+{z}^{2}=1,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of an elliptic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, an elliptic cylinder whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is an elliptic cylinder whose axis of symmetry is the $x$-axis and $b=c=1.$"}] [{:db/id #edb/ref 17592186355971 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92056e5e-93d9-5ec2-8399-dc50b6aca04d" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186355973} {:answer/id #uuid "3530f0ca-c0c7-5afb-9296-99d0c1b9963b" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,-2,3)$" :db/id #edb/ref 17592186355974} {:answer/id #uuid "b8bc513c-12c9-5390-b82c-323c92576473" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186355975} {:answer/id #uuid "3fff997a-b47e-58b2-88db-deb8ab0fbcf1" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,2,3)$" :db/id #edb/ref 17592186355976} {:answer/id #uuid "0ae5056a-b92f-5440-b7cc-8088e9b11057" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,2,-3)$" :db/id #edb/ref 17592186355977}] :answer-field/correct {:answer/id #uuid "b8bc513c-12c9-5390-b82c-323c92576473" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-3)$" :db/id #edb/ref 17592186355975} :answer-field/id #uuid "b86800b4-0f8d-57c6-85ea-6de4b890552e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355972}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7a50f136-2ecf-5b35-8044-78d3351fdd71" :question/math-academy-id "q-164549" :question/problem "Identify the surface ${y}^{2}-{z}^{2}-x-4y-6z-4=0.$" :question/worked-solution "First, we complete the square in the $y$ and $z$ terms:\n\n$$\n\\begin{aligned}{y}^{2}-{z}^{2}-x-4y-6z-4 & =0 \\\\ ({y}^{2}-4y)-({z}^{2}+6z)-x-4 & =0 \\\\ (y-2)^{2}-4-(z+3)^{2}+9-x-4 & =0 \\\\ (y-2)^{2}-(z+3)^{2}+1-x & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(y-2)^{2}-(z+3)^{2}+1-x & =0 \\\\ (y-2)^{2}-(z+3)^{2} & =x-1\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-3).$"}] [{:db/id #edb/ref 17592186355978 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ac8f862-048b-54bc-a025-73af865271b0" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(2,0,-1)$" :db/id #edb/ref 17592186355980} {:answer/id #uuid "db46510d-d885-52a6-a1aa-d0bba625ab51" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-2,0,1)$" :db/id #edb/ref 17592186355981} {:answer/id #uuid "2e9481b0-8c36-5709-b51c-b938a49f719c" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186355982} {:answer/id #uuid "8d14e072-e680-5b03-8a41-16e663e6baf0" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186355983} {:answer/id #uuid "b73c4a7e-24a4-53a7-b7bc-cba5d5af2670" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,0,5)$" :db/id #edb/ref 17592186355984}] :answer-field/correct {:answer/id #uuid "db46510d-d885-52a6-a1aa-d0bba625ab51" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-2,0,1)$" :db/id #edb/ref 17592186355981} :answer-field/id #uuid "63b4fb69-3146-591b-b6f7-8be87e1fcdd9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355979}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "616a7efa-b0f3-555d-b2fa-29047d5c993a" :question/math-academy-id "q-36110" :question/problem "Identify the surface $4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-25{z}^{2}+16x+50z+91 & =0 \\\\ 4({x}^{2}+4x)+{y}^{2}-25({z}^{2}-2z)+91 & =0 \\\\ 4[(x+2)^{2}-4]+{y}^{2}-25[(z-1)^{2}-1]+91 & =0 \\\\ 4(x+2)^{2}-16+{y}^{2}-25(z-1)^{2}+25+91 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(x+2)^{2}+{y}^{2}-25(z-1)^{2}+100 & =0 \\\\ 4(x+2)^{2}+{y}^{2}-25(z-1)^{2} & =-100 \\\\ \\frac{(x+2)^{2}}{25}+\\frac{{y}^{2}}{100}-\\frac{(z-1)^{2}}{4} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(-2,0,1).$"}]}
