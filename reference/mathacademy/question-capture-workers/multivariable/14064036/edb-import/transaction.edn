[{:db/id "kp-13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/id #uuid "13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/title "Finding a Double-Integral Formula for Volume" :db/ensure [:knowledge-point/validate]} {:db/id [:topic/math-academy-id 2053] :topic/knowledge-points ["kp-13f9ed67-24d8-5d41-8f82-1296abc57f12"]} {:db/id "q-161659/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "ecdb8e8e-1ead-5c2f-8d11-87110257f63d" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-161659/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer/id #uuid "903a36b0-2df4-5939-b9bd-0873e6e07dcc" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-161659/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "cb041ec0-9c6c-5ad5-9495-7ff8c30ef3f5" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-161659/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer/id #uuid "a87a5d93-f289-5dda-942b-2017705bfade" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "q-161659/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "aed7bd19-f8b0-597d-b737-419d7e9b3deb" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-161659/selection" :answer-field/id #uuid "9d3ca650-3e2b-5b33-bd49-57b9bd062470" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161659/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer-field/choices ["q-161659/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-161659/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" "q-161659/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-161659/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" "q-161659/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-161659" :question/id #uuid "9ab8e166-680c-5883-9f97-66afbfcc44a9" :question/math-academy-id "q-161659" :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,-2\\le x\\le 2,\\,0\\le z\\le \\sqrt{2-{x}^{2}},\\,0\\le y\\le 2z}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type III region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{2-{x}^{2}}}{\\int }_{0}^{2z}\\,dy\\,dz\\,dx \\\\  & ={\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{2-{x}^{2}}}[y]_{y=0}^{y=2z}\\,dz\\,dx \\\\  & ={\\int }_{-2}^{2}{\\int }_{0}^{\\sqrt{2-{x}^{2}}}2z\\,dz\\,dx \\\\  & ={\\int }_{-2}^{2}{[{z}^{2}]}_{z=-0}^{z=\\sqrt{2-{x}^{2}}}\\,dx \\\\  & ={\\int }_{-2}^{2}{(\\sqrt{2-{x}^{2}})}^{2}-0\\,dx \\\\  & ={\\int }_{-2}^{2}2-{x}^{2}\\,dx \\\\  & ={[2x-\\frac{1}{3}{x}^{3}]}_{x=-2}^{x=2} \\\\  & =(2(2)-\\frac{1}{3}(2)^{3})-(2(-2)-\\frac{1}{3}(-2)^{3}) \\\\  & =(4-\\frac{8}{3})-(-4+\\frac{8}{3}) \\\\  & =\\frac{8}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161659/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb891682-26ae-541c-a92d-a79756d1714e"] :knowledge-point/questions ["q-161659"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161656/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" :answer/id #uuid "a7e25b2b-eaa7-52e7-bab7-47cd2dcb5fc5" :answer/type :answer.type/math :answer/value "56" :db/ensure [:answer/validate]} {:db/id "q-161656/selection/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997" :answer/id #uuid "19500e0b-841c-58fc-b770-14aa998983e1" :answer/type :answer.type/math :answer/value "52" :db/ensure [:answer/validate]} {:db/id "q-161656/selection/1114f773249b584f03ae90d8348b5b14abd566a3f244c0aad51e974a9460892e" :answer/id #uuid "037237d7-c28f-54f5-adf4-134ac6f4b141" :answer/type :answer.type/math :answer/value "\\frac{27}{2}" :db/ensure [:answer/validate]} {:db/id "q-161656/selection/2d74805832f67ef59e036240357e0736f8e1a4a3ed1ef603afd65848b6d8a1e3" :answer/id #uuid "cc462843-fb53-56a5-b557-a644bae05960" :answer/type :answer.type/math :answer/value "\\frac{53}{2}" :db/ensure [:answer/validate]} {:db/id "q-161656/selection/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e" :answer/id #uuid "29506a0f-81c2-577d-8660-457520696835" :answer/type :answer.type/math :answer/value "23" :db/ensure [:answer/validate]} {:db/id "q-161656/selection" :answer-field/id #uuid "25be8db5-531d-50bf-8e2c-d021aadd0e64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161656/selection/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997" :answer-field/choices ["q-161656/selection/879a225aaf1b8272157c33247ace982b7e338d5701ba0d4d6c31dd38d4da6784" "q-161656/selection/85f23a53be0e95a7e191561cc5a77501369717526aae5254cc8d13ed8080d997" "q-161656/selection/1114f773249b584f03ae90d8348b5b14abd566a3f244c0aad51e974a9460892e" "q-161656/selection/2d74805832f67ef59e036240357e0736f8e1a4a3ed1ef603afd65848b6d8a1e3" "q-161656/selection/abe476e447976564bc5c670fe73789666287b967d49bbed12b1d85144449e63e"] :db/ensure [:answer-field/validate]} {:db/id "q-161656" :question/id #uuid "f08aba5b-443f-57e6-8701-3029a49c21a4" :question/math-academy-id "q-161656" :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,1\\le y\\le 3,\\,0\\le z\\le 2y,\\,0\\le x\\le y+2z}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type II region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{1}^{3}{\\int }_{0}^{2y}{\\int }_{0}^{y+2z}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{1}^{3}{\\int }_{0}^{2y}[x]_{x=0}^{x=y+2z}\\,dz\\,dy \\\\  & ={\\int }_{1}^{3}{\\int }_{0}^{2y}y+2z\\,dz\\,dy \\\\  & ={\\int }_{1}^{3}{[yz+{z}^{2}]}_{z=0}^{z=2y}\\,dy \\\\  & ={\\int }_{1}^{3}y(2y)+(2y)^{2}-0\\,dy \\\\  & ={\\int }_{1}^{3}6{y}^{2}\\,dy \\\\  & ={[2{y}^{3}]}_{y=1}^{y=3} \\\\  & =2(3)^{3}-2(1)^{3}-0 \\\\  & =52.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161656/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb891682-26ae-541c-a92d-a79756d1714e"] :knowledge-point/questions ["q-161656"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161653/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "6bb1709d-cb10-583f-9d82-bf25a8b48b20" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-161653/selection/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" :answer/id #uuid "e59ffa58-74f1-562a-a741-d4c6351b9270" :answer/type :answer.type/math :answer/value "\\frac{32}{3}" :db/ensure [:answer/validate]} {:db/id "q-161653/selection/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" :answer/id #uuid "ebeb9cd6-3829-5945-8ab6-7f8f8cf7d489" :answer/type :answer.type/math :answer/value "27" :db/ensure [:answer/validate]} {:db/id "q-161653/selection/d472470bf61b62667bf520b42074414f07d1266def1002f8f8325fe27d872b2d" :answer/id #uuid "2b3d4c71-66a0-5a85-ac89-57300619ce15" :answer/type :answer.type/math :answer/value "39" :db/ensure [:answer/validate]} {:db/id "q-161653/selection/f7e0ddf094e193f19f45f558390669c9c07e6d10f3e3ead2989b7db0b6a77d28" :answer/id #uuid "f9433e48-13ab-58b9-a220-8fc15935944c" :answer/type :answer.type/math :answer/value "\\frac{33}{2}" :db/ensure [:answer/validate]} {:db/id "q-161653/selection" :answer-field/id #uuid "635a1867-36b4-5b88-bb71-5e9e1ee7e72a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161653/selection/d472470bf61b62667bf520b42074414f07d1266def1002f8f8325fe27d872b2d" :answer-field/choices ["q-161653/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-161653/selection/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" "q-161653/selection/c9ec5d6cdf4e67c7f8bce68475bed400e56bf403f3d09b5928f78b6baa512eab" "q-161653/selection/d472470bf61b62667bf520b42074414f07d1266def1002f8f8325fe27d872b2d" "q-161653/selection/f7e0ddf094e193f19f45f558390669c9c07e6d10f3e3ead2989b7db0b6a77d28"] :db/ensure [:answer-field/validate]} {:db/id "q-161653" :question/id #uuid "72d6f8d0-1f35-5a19-b558-bcfd9f34f6df" :question/math-academy-id "q-161653" :question/problem "Find the volume of the solid $R$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,1\\le y\\le 4,\\,2\\le z\\le 3y+x}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type I region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}{\\int }_{2}^{3y+x}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}[z]_{z=2}^{z=3y+x}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{1}^{4}3y+x-2\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[\\frac{3}{2}{y}^{2}+xy-2y]}_{y=1}^{y=4}\\,dx \\\\  & ={\\int }_{0}^{2}\\,[(24+4x-8)-(\\frac{3}{2}+x-2)]\\,dx \\\\  & =4{\\int }_{0}^{2}3x+\\frac{33}{2}\\,dx \\\\  & ={[\\frac{3{x}^{2}}{2}+\\frac{33}{2}x]}_{x=0}^{x=2} \\\\  & =\\frac{3(2)^{2}}{2}+\\frac{33}{2}(2)-0 \\\\  & =39.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161653/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb891682-26ae-541c-a92d-a79756d1714e"] :knowledge-point/questions ["q-161653"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40327"] :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,-2\\le y\\le 0,\\,0\\le z\\le 2+y,\\,1\\le x\\le y-z+3}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type II region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-2}^{0}{\\int }_{0}^{2+y}{\\int }_{1}^{y-z+3}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{-2}^{0}{\\int }_{0}^{2+y}[x]_{x=1}^{x=y-z+3}\\,dz\\,dy \\\\  & ={\\int }_{-2}^{0}{\\int }_{0}^{2+y}(y-z+3)-1\\,dz\\,dy \\\\  & ={\\int }_{-2}^{0}{\\int }_{0}^{2+y}y-z+2\\,dz\\,dy \\\\  & ={\\int }_{-2}^{0}{[(y+2)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=2+y}\\,dy \\\\  & ={\\int }_{-2}^{0}((y+2)(2+y)-\\frac{(2+y)^{2}}{2})-0\\,dy \\\\  & =\\frac{1}{2}{\\int }_{-2}^{0}{y}^{2}+4y+4\\,dy \\\\  & =\\frac{1}{2}{[\\frac{{y}^{3}}{3}+2{y}^{2}+4y]}_{y=-2}^{y=0} \\\\  & =0-\\frac{1}{2}(\\frac{(-2)^{3}}{3}+2(-2)^{2}+4(-2)) \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-161657/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer/id #uuid "a3c5a6ce-cc61-545a-bbd2-dcbc68b1d804" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-161657/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "f3be178f-5390-5a71-99a0-d0ceb47603fa" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-161657/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "1024fdbc-83bd-5faf-ba5d-5093ca5c9caf" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-161657/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "eb663a61-1e86-5bfd-abf9-45e475d7d7ae" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-161657/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "14a411e9-4c25-59ea-865b-12c23e2a14b1" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-161657/selection" :answer-field/id #uuid "2e6dd80f-da63-5cab-8de9-ae7ccd48407d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161657/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-161657/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" "q-161657/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-161657/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" "q-161657/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-161657/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-161657" :question/id #uuid "685f5c88-d6f7-5d95-bc6d-097dd6fed3b8" :question/math-academy-id "q-161657" :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le \\frac{\\pi }{2},\\,1\\le z\\le 3,\\,0\\le x\\le 2z\\operatorname{sin}⁡y}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type II region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{1}^{3}{\\int }_{0}^{2z\\operatorname{sin}⁡y}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{1}^{3}[x]_{x=0}^{x=2z\\operatorname{sin}⁡y}\\,dz\\,dy \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{1}^{3}2z\\operatorname{sin}⁡y\\,dz\\,dy \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡y\\,{[{z}^{2}]}_{z=1}^{z=3}\\,dy \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡y({3}^{2}-{1}^{2})\\,dy \\\\  & ={\\int }_{0}^{\\pi /2}8\\operatorname{sin}⁡y\\,dy \\\\  & =8[-\\operatorname{cos}⁡y]_{y=0}^{y=\\pi /2} \\\\  & =-8(0-1) \\\\  & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161657/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fb891682-26ae-541c-a92d-a79756d1714e"] :knowledge-point/questions ["q-161657"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161739/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "d1bb0d5e-e280-50ef-8ca8-a2cd73e51a6c" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-161739/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "4934a78c-d46e-53a4-809a-d51ee5e28f2c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-161739/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "3ccb700b-e908-5a96-85c7-3b7220e22b82" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-161739/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "494dcf07-02d7-5acb-8cd0-d5c4bc681b42" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-161739/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "afd07bb1-b0c4-57a4-af8d-04de56e9c777" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-161739/selection" :answer-field/id #uuid "82d2a86a-27e9-50f1-a5a2-0c90fa48a49f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161739/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-161739/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-161739/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-161739/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-161739/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-161739/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-161739" :question/id #uuid "5be76099-fab4-5c16-9f1f-54513eb4e9fd" :question/math-academy-id "q-161739" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/4485b56f6b31059b42d379993951d94952397fe01bd1b5922b0ea8e7b171f8f6.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/66593acc794ee28d8372ec5758abf14594ea58528c1fe793917754dd9d21c5ad.png)\n\n \n\nNotice that our solid can be written as the type I region\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 6-3x-2y},\n$$\n\nwhere $D$ is the projection of $R$ onto the $xy$-plane.\n\nTo find the top boundary curve of $D$ in the form $y=y(x),$ we substitute $z=0$ into the equation $z=6-3x-2y:$\n\n$$\n0=6-3x-2y\\,⟹\\,y=3-\\frac{3}{2}x\n$$\n\nThen, we have\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 3-\\frac{3}{2}x},\n$$\n\nas shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/8b3edbf61dc8a2b2a027c79a0ac1bbee54163b89277040119aaea382121998ff.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 3-\\frac{3}{2}x,\\,\\,0\\le z\\le 6-3x-2y}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3-3x/2}{\\int }_{0}^{6-3x-2y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3-3x/2}[z]_{z=0}^{z=6-3x-2y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3-3x/2}(6-3x-2y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{3-3x/2}6-3x-2y\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[(6-3x)y-{y}^{2}]}_{y=0}^{y=3-3x/2}\\,dx \\\\  & ={\\int }_{0}^{2}((6-3x)(3-\\frac{3x}{2})-{(3-\\frac{3x}{2})}^{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}(3-\\frac{3x}{2})((6-3x)-(3-\\frac{3x}{2}))\\,dx \\\\  & ={\\int }_{0}^{2}(3-\\frac{3x}{2})(3-\\frac{3x}{2})\\,dx \\\\  & ={\\int }_{0}^{2}{(3-\\frac{3x}{2})}^{2}\\,dx \\\\  & ={\\int }_{0}^{2}9-9x+\\frac{9{x}^{2}}{4}\\,dx \\\\  & ={[9x-\\frac{9{x}^{2}}{2}+\\frac{3{x}^{3}}{4}]}_{x=0}^{x=2} \\\\  & =(9(2)-\\frac{9(2)^{2}}{2}+\\frac{3(2)^{3}}{4})-0 \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161739/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "43198aae-a4dd-5b79-803a-1bb625a96355"] :knowledge-point/questions ["q-161739"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161695/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "52a932a2-f5e5-5f78-b875-a9181035b1ec" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answer/validate]} {:db/id "q-161695/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "1a793928-bb3c-5eaa-8721-72e91886cc9f" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-161695/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "34016ea3-c3e9-5cd2-af9e-af92072bad4c" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-161695/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" :answer/id #uuid "c658fb48-b655-5636-a827-9793a38a4b83" :answer/type :answer.type/math :answer/value "16" :db/ensure [:answer/validate]} {:db/id "q-161695/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "52021203-ee29-52ae-8cbb-cd4367b1d17f" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-161695/selection" :answer-field/id #uuid "fa94fe5f-46af-5496-bf12-970fee73f52b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161695/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-161695/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" "q-161695/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-161695/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-161695/selection/650efaaa01beaa7de6c030497edff1dd29c570bf683f3726bbcacabc3dfa7e4c" "q-161695/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-161695" :question/id #uuid "7f21bcdd-eac7-590c-9dc8-50716691e3d6" :question/math-academy-id "q-161695" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/214d629cdac48642a7a8b4d435f91098388a7a799bd7e70d5b7c91ae028714c3.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/bf9c4790a8e31e000d2aeb7f7e557661683d3f52d737ba1b99abd407c15d6e99.png)\n\n  \n\nNotice that our solid can be written as the type I region\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,0\\le z\\le 3+x-y},\n$$\n\nwhere\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2}\n$$\n\nis the projection of $R$ onto the $xy$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/74954715928551ebb271cdfd461d783778b02b7944cbfd5502d6d06011408ad8.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2,\\,\\,0\\le z\\le 3+x-y}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{3+x-y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}[z]_{z=0}^{z=3+x-y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(3+x-y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}3+x-y\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{[(3+x)y-\\frac{{y}^{2}}{2}]}_{y=0}^{y=2}\\,dx \\\\  & ={\\int }_{0}^{2}((3+x)(2)-\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}4+2x\\,dx \\\\  & =[4x+{x}^{2}]_{x=0}^{x=2} \\\\  & =(8+4)-0 \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161695/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "43198aae-a4dd-5b79-803a-1bb625a96355"] :knowledge-point/questions ["q-161695"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161742/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "ffcd0c8f-af8f-507d-9be5-03de454002df" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-161742/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f8096c88-b6fb-5bfe-be35-10cb080537c8" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-161742/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "aaf673d8-e2af-5828-bbfe-dd23af2f202a" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-161742/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" :answer/id #uuid "3dbc590d-b682-5c2c-963f-f3964523b956" :answer/type :answer.type/math :answer/value "\\frac{6}{5}" :db/ensure [:answer/validate]} {:db/id "q-161742/selection/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e" :answer/id #uuid "482fad78-19c0-5fad-8ddf-a96aa5fff7c1" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "q-161742/selection" :answer-field/id #uuid "5083bed3-a6ab-54e3-843d-140238769cc1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161742/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer-field/choices ["q-161742/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-161742/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-161742/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-161742/selection/75be7144d0f06979df25a4d833026b673a3f8e67075b82357bb7a90b42abaa01" "q-161742/selection/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e"] :db/ensure [:answer-field/validate]} {:db/id "q-161742" :question/id #uuid "719f7cf4-cc4c-592b-b44a-4aa9730f64a7" :question/math-academy-id "q-161742" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/770cdf03e988f811ccc3ff805889cef55304b01b6e8009e25ba128fbdbb89066.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/8e5f3095cac4e068e54d9b3ac2bb55dc4789e7ca68d4524dce4d25a55abd5be6.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 4-2x-4z},\n$$\n\nwhere $D$ is the projection of $R$ onto the $xz$-plane.\n\nTo find the top boundary curve of $D$ in the form $z=z(x),$ we substitute $y=0$  into the equation $y=4-2x-4z:$\n\n$$\n0=4-2x-4z\\,⟹\\,z=1-\\frac{x}{2}\n$$\n\nThen, we have\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 1-\\frac{x}{2}},\n$$\n\nas shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/76fcca4251a904a08ac2f6ba8181d92c2c2fa7e07e596ef6276f1d21b574817a.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 1-\\frac{x}{2},\\,\\,0\\le y\\le 4-2x-4z}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}{\\int }_{0}^{4-2x-4z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}[y]_{y=0}^{y=4-2x-4z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}(4-2x-4z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1-x/2}4-2x-4z\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{[(4-2x)z-2{z}^{2}]}_{z=0}^{z=1-x/2}\\,dx \\\\  & ={\\int }_{0}^{2}((4-2x)(1-\\frac{x}{2})-2{(1-\\frac{x}{2})}^{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}(1-\\frac{x}{2})((4-2x)-2(1-\\frac{x}{2}))\\,dx \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(2-x)(2-x)\\,dx \\\\  & ={\\int }_{0}^{2}2-2x+\\frac{{x}^{2}}{2}\\,dx \\\\  & ={[2x-{x}^{2}+\\frac{{x}^{3}}{6}]}_{x=0}^{x=2} \\\\  & =(2(2)-{2}^{2}+\\frac{{2}^{3}}{6})-0 \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161742/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "43198aae-a4dd-5b79-803a-1bb625a96355"] :knowledge-point/questions ["q-161742"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40353"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/7456b549ac815ab491945d9b3f2873d65b091636f7b8282f296a435954ba503d.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/702e54d6f4b951eec56a62d340f81df1f618622114cfef6045460a6d184bffbc.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 3-x-z},\n$$\n\nwhere\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 1}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/af505b53a12bbe74da4d3885df59c4c00cc7bfaf71df9f7167caa9dbf67cfb73.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,0\\le z\\le 1,\\,\\,0\\le y\\le 3-x-z}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{3-x-z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}[y]_{y=0}^{y=3-x-z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(3-x-z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}3-x-z\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{[(3-x)z-\\frac{{z}^{2}}{2}]}_{z=0}^{z=1}\\,dx \\\\  & ={\\int }_{0}^{1}((3-x)(1)-\\frac{{1}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{5}{2}-x\\,dx \\\\  & ={[\\frac{5}{2}x-\\frac{{x}^{2}}{2}]}_{x=0}^{x=1} \\\\  & =(\\frac{5}{2}(1)-\\frac{{1}^{2}}{2})-0 \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-161699/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "a1e56578-1ef1-5752-83e9-a32e45a82dc0" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-161699/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "4686037a-3fba-5a25-86e1-efcfe0588e32" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-161699/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "f09dd3d1-791b-5fee-b31f-d003ca12b419" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-161699/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "a77239a8-9197-50b0-a4b1-60eeee73a73c" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-161699/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "7d6bca99-70ea-561b-b5e4-446adda9a23f" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-161699/selection" :answer-field/id #uuid "4da7669f-6b58-58bc-a92e-3bb1cc0dd734" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161699/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-161699/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-161699/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-161699/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-161699/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-161699/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-161699" :question/id #uuid "3725fa5e-4286-5db6-99d1-eca169a9fe12" :question/math-academy-id "q-161699" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/237856bbfdfa6c5ecaead68d257270bb86aeca666fe4170be50b88b67d3ab9de.png)\n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the right one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/33d937ccc1ae72f5add46a9358af4427147205a072ca2848a44d61288e705235.png)\n\n \n\nNotice that our solid can be written as the type III region\n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,0\\le y\\le 1+\\frac{x}{2}+z},\n$$\n\nwhere\n\n$$\nD={(x,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2}\n$$\n\nis the projection of $R$ onto the $xz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/9e7c6fad45d9d85bad5ca16a2000e4d44a1739ab70797e41ae94945a4ffb02ef.png)\n\nHence, the type III representation of $R$ is\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le z\\le 2,\\,\\,0\\le y\\le 1+\\frac{x}{2}+z}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{1+x/2+z}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}[y]_{y=0}^{y=1+x/2+z}\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}(1+\\frac{x}{2}+z)-0\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}1+\\frac{x}{2}+z\\,dz\\,dx \\\\  & ={\\int }_{0}^{2}{[(1+\\frac{x}{2})z+\\frac{{z}^{2}}{2}]}_{z=0}^{z=2}\\,dx \\\\  & ={\\int }_{0}^{2}((1+\\frac{x}{2})(2)+\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{2}4+x\\,dx \\\\  & ={[4x+\\frac{{x}^{2}}{2}]}_{x=0}^{x=2} \\\\  & =(8+2)-0 \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161699/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "43198aae-a4dd-5b79-803a-1bb625a96355"] :knowledge-point/questions ["q-161699"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161685/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "2133dea4-a504-5329-8492-56488f6ce9b2" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-161685/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer/id #uuid "e4fb14c7-c1ea-5f85-95fb-cdc018796aa6" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "q-161685/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "eab9a17a-57a7-525d-b91a-947e5634dfbc" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-161685/selection/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" :answer/id #uuid "afc54909-ab26-53d1-86ba-38a29195f264" :answer/type :answer.type/math :answer/value "\\frac{11}{2}" :db/ensure [:answer/validate]} {:db/id "q-161685/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "0f2daadd-33df-55df-a127-1484db43e99c" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-161685/selection" :answer-field/id #uuid "ea23cd1f-94bd-53d4-8d68-1df5aef6bb8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161685/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-161685/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-161685/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" "q-161685/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-161685/selection/968b78a1da72ee3df196b4b60a1cb9afd2082e522352c24e5babcf63ab6a5c7b" "q-161685/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-161685" :question/id #uuid "bfad8f1e-d853-5761-8ae8-4b4f0145a00b" :question/math-academy-id "q-161685" :question/problem "Find the volume of the solid region enclosed by the $xz$-plane and the surface $y=5-3{z}^{2},$ and the planes $x=0,$ $x=1,$ $z=-1,$ $z=0.$" :question/worked-solution "Notice that our solid can be written as a type III region: \n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 1,\\,\\,-1\\le z\\le 0,\\,\\,0\\le y\\le 5-3{z}^{2}}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}{\\int }_{0}^{5-3{z}^{2}}dy\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}[y]_{y=0}^{y=5-3{z}^{2}}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{-1}^{0}5-3{z}^{2}\\,dz\\,dx \\\\  & ={\\int }_{0}^{1}[5z-{z}^{3}]_{z=-1}^{z=0}\\,dx \\\\  & ={\\int }_{0}^{1}0-(5(-1)-(-1)^{3})\\,dx \\\\  & ={\\int }_{0}^{1}5-1\\,dx \\\\  & =4{\\int }_{0}^{1}dx \\\\  & =4[x]_{x=0}^{x=1} \\\\  & =4(1-0) \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161685/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2c89813f-95aa-50b9-9bab-eec718bd34cd"] :knowledge-point/questions ["q-161685"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161680/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "4c0fcca5-4496-5af2-95c4-c906ab8c14f9" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-161680/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "d141a7e0-17ba-561d-842a-e6cbef4d8354" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-161680/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0cfbd79a-93a3-5ccc-83ef-2b95f3d24229" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-161680/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "868720a0-e931-5c0b-a441-f0f0413f9039" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-161680/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "ccd1ac0d-a435-50ef-a14e-834186cf4a4d" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-161680/selection" :answer-field/id #uuid "5be1295d-04e2-574a-8f44-3e2fb4ae836a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161680/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-161680/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-161680/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-161680/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-161680/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-161680/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-161680" :question/id #uuid "fd764b51-829d-54cc-85ea-847cd4f0a2d4" :question/math-academy-id "q-161680" :question/problem "Find the volume of the solid region enclosed by the planes $x=1-y$ and $x=y+1,$ and the planes $y=1,$ $y=2,$ $z=0,$ $z=1.$" :question/worked-solution "Notice that our solid can be written as a type II region: \n\n$$\nR={(x,y,z)\\,:\\,1\\le y\\le 2,\\,\\,0\\le z\\le 1,\\,\\,1-y\\le x\\le y+1}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}{\\int }_{1-y}^{y+1}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}[x]_{x=1-y}^{x=y+1}\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}y+1-(1-y)\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}2y\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}2y[z]_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{1}^{2}2y\\,dy \\\\  & =[{y}^{2}]_{y=1}^{y=2} \\\\  & ={2}^{2}-{1}^{2} \\\\  & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161680/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2c89813f-95aa-50b9-9bab-eec718bd34cd"] :knowledge-point/questions ["q-161680"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161684/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" :answer/id #uuid "25904396-86ff-583a-baec-c71d9c5fdfd9" :answer/type :answer.type/math :answer/value "2e" :db/ensure [:answer/validate]} {:db/id "q-161684/selection/2ac323549514e2d679c04e3563fe5283210cd07bc287b01500f7a1d44649c015" :answer/id #uuid "6d63adfe-df0d-5d07-9ff7-2fe1bc9aacec" :answer/type :answer.type/math :answer/value "\\frac{3{e}^{2}-1}{e}" :db/ensure [:answer/validate]} {:db/id "q-161684/selection/8227b346d0662c6608f550aae372ec20ddc4809a5234c137bb5eedf6085bb184" :answer/id #uuid "3bad839d-5b62-53a6-9511-b96cf5045815" :answer/type :answer.type/math :answer/value "\\frac{2-{e}^{2}}{2e}" :db/ensure [:answer/validate]} {:db/id "q-161684/selection/03adb6ab7b2ac1f24256ce8f8bb5d578ad0aca033123e54c2519fd0d567b744b" :answer/id #uuid "882994b6-69aa-50aa-b14d-2f9d2a9d3f9f" :answer/type :answer.type/math :answer/value "\\frac{3}{e}" :db/ensure [:answer/validate]} {:db/id "q-161684/selection/1612daefbb3a0f284a6e115b34d673daf9d2bee8baab183204d4f17ea8de6878" :answer/id #uuid "c58dd086-1953-550c-915e-10ddc96d3af1" :answer/type :answer.type/math :answer/value "\\frac{e-1}{2e}" :db/ensure [:answer/validate]} {:db/id "q-161684/selection" :answer-field/id #uuid "e6ae9075-5335-5400-a701-b07e72d6dba9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161684/selection/1612daefbb3a0f284a6e115b34d673daf9d2bee8baab183204d4f17ea8de6878" :answer-field/choices ["q-161684/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" "q-161684/selection/2ac323549514e2d679c04e3563fe5283210cd07bc287b01500f7a1d44649c015" "q-161684/selection/8227b346d0662c6608f550aae372ec20ddc4809a5234c137bb5eedf6085bb184" "q-161684/selection/03adb6ab7b2ac1f24256ce8f8bb5d578ad0aca033123e54c2519fd0d567b744b" "q-161684/selection/1612daefbb3a0f284a6e115b34d673daf9d2bee8baab183204d4f17ea8de6878"] :db/ensure [:answer-field/validate]} {:db/id "q-161684" :question/id #uuid "f762d84a-3a78-576d-90bc-a8bbd9017d01" :question/math-academy-id "q-161684" :question/problem "Find the volume of the solid region enclosed by the $xz$-plane and the surface $y=z{e}^{x},$ and the planes $x=-1,$ $x=0,$ $z=0,$ $z=1.$" :question/worked-solution "Notice that our solid can be written as a type III region: \n\n$$\nR={(x,y,z)\\,:\\,-1\\le x\\le 0,\\,\\,0\\le z\\le 1,\\,\\,0\\le y\\le z{e}^{x}}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}{\\int }_{0}^{z{e}^{x}}dy\\,dz\\,dx \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}[y]_{y=0}^{y=z{e}^{x}}\\,dz\\,dx \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}z{e}^{x}\\,dz\\,dx \\\\  & ={\\int }_{-1}^{0}{e}^{x}{[\\frac{1}{2}{z}^{2}]}_{z=0}^{z=1}\\,dx \\\\  & ={\\int }_{-1}^{0}\\frac{1}{2}{e}^{x}\\,dx \\\\  & =\\frac{1}{2}[{e}^{x}]_{x=-1}^{x=0} \\\\  & =\\frac{1}{2}({e}^{0}-{e}^{-1}) \\\\  & =\\frac{1}{2}(1-\\frac{1}{e}) \\\\  & =\\frac{e-1}{2e}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161684/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2c89813f-95aa-50b9-9bab-eec718bd34cd"] :knowledge-point/questions ["q-161684"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161677/selection/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" :answer/id #uuid "9a1e34b4-d753-538d-b5fb-e65b8daed738" :answer/type :answer.type/math :answer/value "\\frac{32}{3}" :db/ensure [:answer/validate]} {:db/id "q-161677/selection/96ee6a3361e9d457b88fc124f1f022ef8dc27c2272728293b480cef1fc3f4e34" :answer/id #uuid "a1f4b6d8-5206-5177-9177-8c72533c873b" :answer/type :answer.type/math :answer/value "\\frac{21}{2}" :db/ensure [:answer/validate]} {:db/id "q-161677/selection/8e1065e0a433f859a01c77631b6451e105d707d70e2225dc268d4aa4c9c23074" :answer/id #uuid "7973f11b-c80f-5f58-be37-f273469cff2b" :answer/type :answer.type/math :answer/value "\\frac{16}{5}" :db/ensure [:answer/validate]} {:db/id "q-161677/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "adbdb2f7-d2a1-5e67-bbfe-38e91cf1c4f6" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-161677/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d4d66139-fba5-5a06-b1c5-fded675d3c25" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-161677/selection" :answer-field/id #uuid "7342c8d0-87ca-51f9-8d2f-8152b19aba95" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161677/selection/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" :answer-field/choices ["q-161677/selection/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" "q-161677/selection/96ee6a3361e9d457b88fc124f1f022ef8dc27c2272728293b480cef1fc3f4e34" "q-161677/selection/8e1065e0a433f859a01c77631b6451e105d707d70e2225dc268d4aa4c9c23074" "q-161677/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-161677/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-161677" :question/id #uuid "00e947c4-55c5-5d76-b7c7-7a54f4ff0b9b" :question/math-academy-id "q-161677" :question/problem "Find the volume of the solid region enclosed by the $xy$-plane, the surface $z=4-{x}^{2},$ and the planes $x=0,$ $x=2,$ $y=0,$ $y=2.$" :question/worked-solution "Notice that our solid can be written as a type I region: \n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le 2,\\,\\,0\\le y\\le 2,\\,\\,0\\le z\\le 4-{x}^{2}}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}{\\int }_{0}^{4-{x}^{2}}\\,dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}[z]_{z=0}^{z=4-{x}^{2}}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{2}4-{x}^{2}\\,dy\\,dx \\\\  & ={\\int }_{0}^{2}(4-{x}^{2})[y]_{y=0}^{y=2}\\,dx \\\\  & ={\\int }_{0}^{2}(4-{x}^{2})(2-0)\\,dx \\\\  & =2{\\int }_{0}^{2}4-{x}^{2}\\,dx \\\\  & =2{[4x-\\frac{1}{3}{x}^{3}]}_{x=0}^{x=2} \\\\  & =2(4(2)-\\frac{1}{3}({2}^{3}))-0 \\\\  & =2(\\frac{16}{3}) \\\\  & =\\frac{32}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161677/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2c89813f-95aa-50b9-9bab-eec718bd34cd"] :knowledge-point/questions ["q-161677"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161681/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "ea0c19ec-4ec6-5fbb-8f96-a8c1af1bb66e" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-161681/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "272239d9-b9fe-5544-8d7f-beba2b2b2052" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-161681/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer/id #uuid "217f9b6d-de38-5284-aa4f-c583d502c53c" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "q-161681/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "98f4b053-be8f-54b2-8d3b-c31542d14bff" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-161681/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "cb1b1ffb-70fe-55ed-b849-304c0fa12193" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-161681/selection" :answer-field/id #uuid "e271e4a4-e558-503b-aeda-f7f04905942e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161681/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-161681/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-161681/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-161681/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" "q-161681/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-161681/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-161681" :question/id #uuid "5c9f6633-0d96-57c5-a90c-b39462d06c5a" :question/math-academy-id "q-161681" :question/problem "Find the volume of the solid region enclosed by the plane $x=-1$ and the surface $x=3{y}^{2}+3{z}^{2},$ and the planes $y=0,$ $y=1,$ $z=0,$ $z=1.$" :question/worked-solution "Notice that our solid can be written as a type II region: \n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1,\\,\\,-1\\le x\\le 3{y}^{2}+3{z}^{2}}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{-1}^{3{y}^{2}+3{z}^{2}}dx\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}[x]_{x=-1}^{x=3{y}^{2}+3{z}^{2}}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}3{y}^{2}+3{z}^{2}-(-1)\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}3{y}^{2}+3{z}^{2}+1\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{[(3{y}^{2}+1)z+{z}^{3}]}_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{1}(3{y}^{2}+1)(1)+{1}^{3}\\,dy \\\\  & ={\\int }_{0}^{1}3{y}^{2}+2\\,dy \\\\  & =[{y}^{3}+2y]_{y=0}^{y=1} \\\\  & ={1}^{3}+2(1)-0 \\\\  & =3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161681/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2c89813f-95aa-50b9-9bab-eec718bd34cd"] :knowledge-point/questions ["q-161681"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161715/selection/f802e1420c5fd1412b61230953c774224e410b46158c2a855d5b45dbca753be8" :answer/id #uuid "8223a7de-6c9a-5f4b-b9a8-c06dd97f1542" :answer/type :answer.type/math :answer/value "2-{y}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161715/selection/716fcbfab2956612af8edc8c13d5225a14e6c4ddba98ba9f845cb7674bccb4b2" :answer/id #uuid "6f097bee-f125-586a-b709-6d8b508194da" :answer/type :answer.type/math :answer/value "2-2{y}^{2}-2{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161715/selection/18a44ad0183c8901a6e8a0d687623a55994dab6b744955b395803470aaf3226b" :answer/id #uuid "bed9cc6a-c49f-54bc-ae2a-57b717f707c3" :answer/type :answer.type/math :answer/value "\\frac{3}{2}-2{y}^{2}+4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161715/selection/e49735d1f3e778fa7cc4ef4c2ba11b6c7faa986b2e364cdbb46603bc554bf601" :answer/id #uuid "f78d6104-4d38-5693-aa16-b2a6c273c53a" :answer/type :answer.type/math :answer/value "3+6{y}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161715/selection/54b6a574229494e6e9c6e8eb113d3267db17273e0fe30c51b16c9681fe81cdd5" :answer/id #uuid "7aa00230-1a42-52e6-b198-b25b620298c4" :answer/type :answer.type/math :answer/value "1-3{y}^{2}-2{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161715/selection" :answer-field/id #uuid "75ddea3b-8b6e-5f00-bba3-7ddfc6866b6e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161715/selection/716fcbfab2956612af8edc8c13d5225a14e6c4ddba98ba9f845cb7674bccb4b2" :answer-field/choices ["q-161715/selection/f802e1420c5fd1412b61230953c774224e410b46158c2a855d5b45dbca753be8" "q-161715/selection/716fcbfab2956612af8edc8c13d5225a14e6c4ddba98ba9f845cb7674bccb4b2" "q-161715/selection/18a44ad0183c8901a6e8a0d687623a55994dab6b744955b395803470aaf3226b" "q-161715/selection/e49735d1f3e778fa7cc4ef4c2ba11b6c7faa986b2e364cdbb46603bc554bf601" "q-161715/selection/54b6a574229494e6e9c6e8eb113d3267db17273e0fe30c51b16c9681fe81cdd5"] :db/ensure [:answer-field/validate]} {:db/id "q-161715" :question/id #uuid "0e6b7281-889f-50e9-9a22-290c6faa279a" :question/math-academy-id "q-161715" :question/problem "Consider the solid enclosed between the paraboloid $x=-2+{y}^{2}+4{z}^{2}$ and the parabolic cylinder $x=-1+2{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1}^{1}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}-2+{y}^{2}+4{z}^{2} & =-1+2{z}^{2} \\\\ {y}^{2}+2{z}^{2} & =1 \\\\ {y}^{2}+2{z}^{2} & =1\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is an ellipse.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,-2+{y}^{2}+4{z}^{2}\\le x\\le -1+2{z}^{2}},\n$$\n\nwhere $D$ is the interior of the ellipse ${y}^{2}+2{z}^{2}=1.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{-2+{y}^{2}+4{z}^{2}}^{-1+2{z}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(-1+2{z}^{2})-(-2+{y}^{2}+4{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}1-{y}^{2}-2{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{\\frac{1-{y}^{2}}{2}},$ and\n\n- the upper part $z=\\sqrt{\\frac{1-{y}^{2}}{2}},$\n\nfor $-1\\le y\\le 1.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}1-{y}^{2}-2{z}^{2}\\,\\text{d}A & ={\\int }_{-1}^{1}{\\int }_{-\\sqrt{(1-{y}^{2})/2}}^{\\sqrt{(1-{y}^{2})/2}}\\,1-{y}^{2}-2{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{\\frac{1-{y}^{2}}{2}})}^{2}+{(\\sqrt{\\frac{1-{y}^{2}}{2}})}^{2}+(1-{y}^{2}-2{z}^{2}) \\\\  & =\\frac{1-{y}^{2}}{2}+\\frac{1-{y}^{2}}{2}+(1-{y}^{2}-2{z}^{2}) \\\\  & =2-2{y}^{2}-2{z}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161715/selection"] :db/ensure [:question/validate]} {:db/id "kp-13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/questions ["q-161715"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161705/selection/473cdecf68cea43a18cf13358bb8fc23381aae417802269b77e51edcfa186bee" :answer/id #uuid "7f937aa2-2f71-51e0-9e5c-59231ef9464e" :answer/type :answer.type/math :answer/value "3+{x}^{2}+2{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161705/selection/6b9861ffbee3963711f6d8c86b821488d2d257f8b72b0e6aee04146a4af12770" :answer/id #uuid "d2f1b6bf-1da5-569e-9f17-9116a6d6ba69" :answer/type :answer.type/math :answer/value "6-5{x}^{2}-2{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161705/selection/79fc28bfa03e3833863ba7e7522d711b2dcc5a7f3c0f451be407b9a4b0f8f22f" :answer/id #uuid "612a1ef7-161e-5596-b387-3809377e8e86" :answer/type :answer.type/math :answer/value "3+2{x}^{2}-2{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161705/selection/d20597f498b767bba8c104578f7fe94c5d899e6a2a4a25f2798d1d4ec94b7265" :answer/id #uuid "45a92263-7e80-56ae-8d27-f1ee9fc79b67" :answer/type :answer.type/math :answer/value "6-3{x}^{2}-5{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161705/selection/3782fe1e1a2050c55ef85d04826dc3acb2e8445832676d46475afd46df560ae8" :answer/id #uuid "f59903f9-90a6-5fef-bb48-3b229090796d" :answer/type :answer.type/math :answer/value "4-2{x}^{2}-2{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161705/selection" :answer-field/id #uuid "48730a7d-deb3-50d2-89fc-c90c617250f3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161705/selection/3782fe1e1a2050c55ef85d04826dc3acb2e8445832676d46475afd46df560ae8" :answer-field/choices ["q-161705/selection/473cdecf68cea43a18cf13358bb8fc23381aae417802269b77e51edcfa186bee" "q-161705/selection/6b9861ffbee3963711f6d8c86b821488d2d257f8b72b0e6aee04146a4af12770" "q-161705/selection/79fc28bfa03e3833863ba7e7522d711b2dcc5a7f3c0f451be407b9a4b0f8f22f" "q-161705/selection/d20597f498b767bba8c104578f7fe94c5d899e6a2a4a25f2798d1d4ec94b7265" "q-161705/selection/3782fe1e1a2050c55ef85d04826dc3acb2e8445832676d46475afd46df560ae8"] :db/ensure [:answer-field/validate]} {:db/id "q-161705" :question/id #uuid "89397d8f-ca3d-5aa6-936a-51ec58a30523" :question/math-academy-id "q-161705" :question/problem "Consider the solid enclosed between the paraboloids $z=-3+6{x}^{2}+5{y}^{2}$ and $z=-1+5{x}^{2}+3{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-\\sqrt{2}}^{\\sqrt{2}}{\\int }_{a(x)}^{b(x)}\\,f(x,y)\\,dy\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $xy$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}-3+6{x}^{2}+5{y}^{2} & =-1+5{x}^{2}+3{y}^{2} \\\\ {x}^{2}+2{y}^{2} & =2\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xy$-plane is an ellipse.\n\nNotice that our solid can be written as a type I region: \n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,\\,-3+6{x}^{2}+5{y}^{2}\\le z\\le -1+5{x}^{2}+3{y}^{2}},\n$$\n\nwhere $D$ is the interior of the ellipse ${x}^{2}+2{y}^{2}=2.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{-3+6{x}^{2}+5{y}^{2}}^{-1+5{x}^{2}+3{y}^{2}}\\text{d}z]\\text{d}A \\\\  & ={∬}_{D}(-1+5{x}^{2}+3{y}^{2})-(-3+6{x}^{2}+5{y}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}2-{x}^{2}-2{y}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of\n\n- the lower part $y=-\\sqrt{1-\\frac{{x}^{2}}{2}},$ and\n\n- the upper part $y=\\sqrt{1-\\frac{{x}^{2}}{2}},$\n\nfor $-\\sqrt{2}\\le x\\le \\sqrt{2}.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}2-{x}^{2}-2{y}^{2}\\,\\text{d}A & ={\\int }_{-\\sqrt{2}}^{\\sqrt{2}}{\\int }_{-\\sqrt{1-{x}^{2}/2}}^{\\sqrt{1-{x}^{2}/2}}\\,2-{x}^{2}-2{y}^{2}\\,dy\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{1-\\frac{{x}^{2}}{2}})}^{2}+{(\\sqrt{1-\\frac{{x}^{2}}{2}})}^{2}+(2-{x}^{2}-2{y}^{2}) \\\\  & =1-\\frac{{x}^{2}}{2}+1-\\frac{{x}^{2}}{2}+(2-{x}^{2}-2{y}^{2}) \\\\  & =4-2{x}^{2}-2{y}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161705/selection"] :db/ensure [:question/validate]} {:db/id "kp-13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/questions ["q-161705"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161716/selection/90e68a890eca082ed2071a19783eb8969fa1da8c3d42352df440921e661c4d92" :answer/id #uuid "b273525f-901c-52ab-9559-ada9ca874695" :answer/type :answer.type/math :answer/value "1-4{x}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161716/selection/6880bb6ddba90ff29bb754b70d58260b1327057d53c7695fbf9ece0df70867fe" :answer/id #uuid "e2070529-2d39-522b-a99e-d62f4510a384" :answer/type :answer.type/math :answer/value "2-{x}^{2}+4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161716/selection/95f5eaee3facc32bdf3c204a152afc92b3f8ba1444c7cf314d551a529d5c5e61" :answer/id #uuid "a7181fb2-19fc-5bca-bb2a-a442347734f1" :answer/type :answer.type/math :answer/value "1+3{x}^{2}-2{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161716/selection/cfb64099362c00b8fe60ae7c2bfb931a58ba0bc7945023e4bee6244ac8b9d1b7" :answer/id #uuid "69e58e3c-0755-5025-9ac4-11db537e9348" :answer/type :answer.type/math :answer/value "1-6{x}^{2}+4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161716/selection/cf1f15e40a438e137f2f366839c9c29278b7671473dcf1e7d3494408078f3fdf" :answer/id #uuid "e2a1214b-5c29-5a5f-843a-c1bb30b7e11f" :answer/type :answer.type/math :answer/value "2-8{x}^{2}-2{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161716/selection" :answer-field/id #uuid "59b74bed-7004-5cad-9792-eceb1faaefdd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161716/selection/cf1f15e40a438e137f2f366839c9c29278b7671473dcf1e7d3494408078f3fdf" :answer-field/choices ["q-161716/selection/90e68a890eca082ed2071a19783eb8969fa1da8c3d42352df440921e661c4d92" "q-161716/selection/6880bb6ddba90ff29bb754b70d58260b1327057d53c7695fbf9ece0df70867fe" "q-161716/selection/95f5eaee3facc32bdf3c204a152afc92b3f8ba1444c7cf314d551a529d5c5e61" "q-161716/selection/cfb64099362c00b8fe60ae7c2bfb931a58ba0bc7945023e4bee6244ac8b9d1b7" "q-161716/selection/cf1f15e40a438e137f2f366839c9c29278b7671473dcf1e7d3494408078f3fdf"] :db/ensure [:answer-field/validate]} {:db/id "q-161716" :question/id #uuid "82f158da-cdbf-547c-a9f3-2ae44cc23680" :question/math-academy-id "q-161716" :question/problem "Consider the solid enclosed between the parabolic cylinders $y=4{x}^{2}$ and $y=1-2{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1/2}^{1/2}{\\int }_{a(x)}^{b(x)}\\,f(x,z)\\,dz\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $xz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}4{x}^{2} & =1-2{z}^{2} \\\\ 4{x}^{2}+2{z}^{2} & =1\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xz$-plane is an ellipse.\n\nNotice that our solid can be written as a type III region: \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,4{x}^{2}\\le y\\le 1-2{z}^{2}},\n$$\n\nwhere $D$ is the interior of the elipse $4{x}^{2}+2{z}^{2}=1.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{4{x}^{2}}^{1-2{z}^{2}}\\text{d}y]\\text{d}A \\\\  & ={∬}_{D}(1-2{z}^{2})-(4{x}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}1-2{z}^{2}-4{x}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\sqrt{\\frac{1-4{x}^{2}}{2}},$ and\n\n- the upper part $z=\\sqrt{\\frac{1-4{x}^{2}}{2}},$\n\nfor $-\\frac{1}{2}\\le x\\le \\frac{1}{2}.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}1-2{z}^{2}-4{x}^{2}\\,\\text{d}A & ={\\int }_{-1/2}^{1/2}{\\int }_{-\\sqrt{(1-4{x}^{2})/2}}^{\\sqrt{(1-4{x}^{2})/2}}\\,1-2{z}^{2}-4{x}^{2}\\,dz\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\sqrt{\\frac{1-4{x}^{2}}{2}})}^{2}+{(\\sqrt{\\frac{1-4{x}^{2}}{2}})}^{2}+(1-2{z}^{2}-4{x}^{2}) \\\\  & =\\frac{1-4{x}^{2}}{2}+\\frac{1-4{x}^{2}}{2}+(1-2{z}^{2}-4{x}^{2}) \\\\  & =2-8{x}^{2}-2{z}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161716/selection"] :db/ensure [:question/validate]} {:db/id "kp-13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/questions ["q-161716"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161706/selection/e49735d1f3e778fa7cc4ef4c2ba11b6c7faa986b2e364cdbb46603bc554bf601" :answer/id #uuid "356d94d6-0bd1-5e41-9097-40ce9acb653c" :answer/type :answer.type/math :answer/value "3+6{y}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161706/selection/d009447cf5865a6aac4f1c4d55d4840e71f35d9a1267bca8133f88146d04e486" :answer/id #uuid "30d1acc5-d4db-5f45-b854-0d5990517f11" :answer/type :answer.type/math :answer/value "3-9{y}^{2}-8{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161706/selection/d8fa68a17c032f7e0d9a69aca62ac8c69419d564beb5edf8323622f8306d854e" :answer/id #uuid "6e4b795a-adfc-536c-a041-03b3545126a5" :answer/type :answer.type/math :answer/value "\\frac{3}{2}-\\frac{9}{2}{y}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161706/selection/db85331d7aa654a1ef819d4c1cb768078b54473a78996ae77be757083d8fef74" :answer/id #uuid "6d953ce0-5168-5182-a5bc-591fb6c34ebe" :answer/type :answer.type/math :answer/value "\\frac{3}{2}-6{y}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161706/selection/39dbd94b2ab37fc39cea68d5a8d0e4bfeed215a4ee293de96a7e167ed06c92d8" :answer/id #uuid "f145ccfb-cf24-5fab-b67d-8c29becde622" :answer/type :answer.type/math :answer/value "1-6{y}^{2}-{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161706/selection" :answer-field/id #uuid "ebec8cdf-063c-518e-9a10-f0c9c2def370" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161706/selection/db85331d7aa654a1ef819d4c1cb768078b54473a78996ae77be757083d8fef74" :answer-field/choices ["q-161706/selection/e49735d1f3e778fa7cc4ef4c2ba11b6c7faa986b2e364cdbb46603bc554bf601" "q-161706/selection/d009447cf5865a6aac4f1c4d55d4840e71f35d9a1267bca8133f88146d04e486" "q-161706/selection/d8fa68a17c032f7e0d9a69aca62ac8c69419d564beb5edf8323622f8306d854e" "q-161706/selection/db85331d7aa654a1ef819d4c1cb768078b54473a78996ae77be757083d8fef74" "q-161706/selection/39dbd94b2ab37fc39cea68d5a8d0e4bfeed215a4ee293de96a7e167ed06c92d8"] :db/ensure [:answer-field/validate]} {:db/id "q-161706" :question/id #uuid "cc058cbe-e1e2-5f16-ac7c-3f82322fc472" :question/math-academy-id "q-161706" :question/problem "Consider the solid enclosed between the paraboloid $x=3{y}^{2}+4{z}^{2}$ and the parabolic cylinder $x=1-{y}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-1/2}^{1/2}{\\int }_{a(y)}^{b(y)}\\,f(y,z)\\,dz\\,dy\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $yz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}3{y}^{2}+4{z}^{2} & =1-{y}^{2} \\\\ 4{y}^{2}+4{z}^{2} & =1 \\\\ {y}^{2}+{z}^{2} & =\\frac{1}{4}\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $yz$-plane is a circle.\n\nNotice that our solid can be written as a type II region: \n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,3{y}^{2}+4{z}^{2}\\le x\\le 1-{y}^{2}},\n$$\n\nwhere $D$ is the interior of the circle ${y}^{2}+{z}^{2}=\\frac{1}{4}.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{3{y}^{2}+4{z}^{2}}^{1-{y}^{2}}\\text{d}x]\\text{d}A \\\\  & ={∬}_{D}(1-{y}^{2})-(3{y}^{2}+4{z}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}1-4{y}^{2}-4{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\frac{1}{2}\\sqrt{1-4{y}^{2}},$ and\n\n- the upper part $z=\\frac{1}{2}\\sqrt{1-4{y}^{2}},$\n\nfor $-\\frac{1}{2}\\le y\\le \\frac{1}{2}.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}1-4{y}^{2}-4{z}^{2}\\,\\text{d}A & ={\\int }_{-1/2}^{1/2}{\\int }_{-\\sqrt{1-4{y}^{2}}/2}^{\\sqrt{1-4{y}^{2}}/2}\\,1-4{y}^{2}-4{z}^{2}\\,dz\\,dy.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\frac{1}{2}\\sqrt{1-4{y}^{2}})}^{2}+{(\\frac{1}{2}\\sqrt{1-4{y}^{2}})}^{2}+(1-4{y}^{2}-4{z}^{2}) \\\\  & =\\frac{1}{4}(1-4{y}^{2})+\\frac{1}{4}(1-4{y}^{2})+(1-4{y}^{2}-4{z}^{2}) \\\\  & =\\frac{3}{2}-6{y}^{2}-4{z}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161706/selection"] :db/ensure [:question/validate]} {:db/id "kp-13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/questions ["q-161706"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161719/selection/1a29e95fa9dea043657162ef7f9a9624f62691b8919df5d68ab8aa2f4bc52fd6" :answer/id #uuid "60dd21e0-6406-5d58-85a0-afe7c6186d10" :answer/type :answer.type/math :answer/value "1-\\frac{9}{2}{x}^{2}-{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161719/selection/37934c871bce5d808edcc512f2fb3d0474ea83dd13cc915071cdc5e431aa1439" :answer/id #uuid "3c92bfe3-1fe8-5653-9109-78a6c1b03032" :answer/type :answer.type/math :answer/value "2+9{x}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161719/selection/2e042269847274b7b399cba393209c97082c00fd65d327cffa2f01049c6e32e0" :answer/id #uuid "1b79a634-8460-5a18-a62d-b7ca64861db7" :answer/type :answer.type/math :answer/value "1-\\frac{3}{2}{x}^{2}+2{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161719/selection/9ecc0adbce8114e5a306e56c6589942893d1ecbef6cb1e6bf1629341a1ecbf6d" :answer/id #uuid "307a6187-bf40-5c08-b148-f242e734d7a8" :answer/type :answer.type/math :answer/value "3-9{x}^{2}-2{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161719/selection/f2db092b4524db391f79442ac397970939ed3909429e0105e6711308a7d341ef" :answer/id #uuid "ac9dd0f0-9460-5682-8523-40e0d3d98ca1" :answer/type :answer.type/math :answer/value "3-\\frac{9}{2}{x}^{2}-4{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161719/selection" :answer-field/id #uuid "ccb749c9-311c-5d81-9c66-b181b18805a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161719/selection/f2db092b4524db391f79442ac397970939ed3909429e0105e6711308a7d341ef" :answer-field/choices ["q-161719/selection/1a29e95fa9dea043657162ef7f9a9624f62691b8919df5d68ab8aa2f4bc52fd6" "q-161719/selection/37934c871bce5d808edcc512f2fb3d0474ea83dd13cc915071cdc5e431aa1439" "q-161719/selection/2e042269847274b7b399cba393209c97082c00fd65d327cffa2f01049c6e32e0" "q-161719/selection/9ecc0adbce8114e5a306e56c6589942893d1ecbef6cb1e6bf1629341a1ecbf6d" "q-161719/selection/f2db092b4524db391f79442ac397970939ed3909429e0105e6711308a7d341ef"] :db/ensure [:answer-field/validate]} {:db/id "q-161719" :question/id #uuid "38ab4bd5-173d-559d-9de9-30730176f570" :question/math-academy-id "q-161719" :question/problem "Consider the solid enclosed between the parabolic cylinders $y=-2+3{x}^{2}$ and $y=-4{z}^{2},$ whose volume can be written in terms of double integrals, as follows:\n\n$$\nV={\\int }_{-\\sqrt{6}/3}^{\\sqrt{6}/3}{\\int }_{a(x)}^{b(x)}\\,f(x,z)\\,dz\\,dx\n$$\n\nWhat is ${a}^{2}+{b}^{2}+f?$" :question/worked-solution "First, we need to determine the projection of the intersection of our surfaces onto the $xz$-plane. So, let's find where they intersect.\n\n$$\n\\begin{aligned}-2+3{x}^{2} & =-4{z}^{2} \\\\ 3{x}^{2}+4{z}^{2} & =2\\end{aligned}\n$$\n\nSo, the projection of the intersection in the $xz$-plane is an ellipse.\n\nNotice that our solid can be written as a type III region: \n\n$$\nR={(x,y,z)\\,:\\,(x,z)\\in D,\\,\\,-2+3{x}^{2}\\le y\\le -4{z}^{2}},\n$$\n\nwhere $D$ is the interior of the ellipse $3{x}^{2}+4{z}^{2}=2.$ \n\nAs a result, the volume of $R$ is given by \n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={∬}_{D}[{\\int }_{-2+3{x}^{2}}^{-4{z}^{2}}\\text{d}y]\\text{d}A \\\\  & ={∬}_{D}(-4{z}^{2})-(-2+3{x}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}2-3{x}^{2}-4{z}^{2}\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, notice that the boundary of $D$ consists of \n\n- the lower part $z=-\\frac{1}{2}\\sqrt{2-3{x}^{2}},$ and\n\n- the upper part $z=\\frac{1}{2}\\sqrt{2-3{x}^{2}},$\n\nfor $-\\frac{\\sqrt{6}}{3}\\le x\\le \\frac{\\sqrt{6}}{3}.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{∬}_{D}2-3{x}^{2}-4{z}^{2}\\,\\text{d}A & ={\\int }_{-\\sqrt{6}/3}^{\\sqrt{6}/3}{\\int }_{-\\sqrt{2-3{x}^{2}}/2}^{\\sqrt{2-3{x}^{2}}/2}\\,2-3{x}^{2}-4{z}^{2}\\,dz\\,dx.\\end{aligned}\n$$\n\n \n\nFinally, \n\n$$\n\\begin{aligned}{a}^{2}+{b}^{2}+f & ={(-\\frac{1}{2}\\sqrt{2-3{x}^{2}})}^{2}+{(\\frac{1}{2}\\sqrt{2-3{x}^{2}})}^{2}+(2-3{x}^{2}-4{z}^{2}) \\\\  & =\\frac{2-3{x}^{2}}{4}+\\frac{2-3{x}^{2}}{4}+(2-3{x}^{2}-4{z}^{2}) \\\\  & =3-\\frac{9}{2}{x}^{2}-4{z}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161719/selection"] :db/ensure [:question/validate]} {:db/id "kp-13f9ed67-24d8-5d41-8f82-1296abc57f12" :knowledge-point/questions ["q-161719"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8189"] :question/problem "Find the volume of the solid $R,$ given by\n\n$$\nR = \\Big\\{ (x,y,z) \\: : \\: 1 \\leq y \\leq 2, \\: 0 \\leq z \\leq \\sqrt{2y}, \\: 0 \\leq x \\leq yz \\Big\\}.\n$$" :question/worked-solution "Notice that we have a three-dimensional type II region.\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{\\sqrt{2y}}{\\int }_{0}^{yz}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{\\sqrt{2y}}[x]_{x=0}^{x=yz}\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{\\sqrt{2y}}yz\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}y{[\\frac{{z}^{2}}{2}]}_{z=0}^{z=\\sqrt{2y}}\\,dy \\\\  & ={\\int }_{1}^{2}\\frac{y}{2}{(\\sqrt{2y})}^{2}\\,dy \\\\  & ={\\int }_{1}^{2}{y}^{2}\\,dy \\\\  & ={[\\frac{{y}^{3}}{3}]}_{y=1}^{y=2} \\\\  & =\\frac{1}{3}(8-1)-0 \\\\  & =\\frac{7}{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8190"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/043adf0ef683c24fbf4680145411d86fa94b52016bee44ac8f08ca7c5ca9f1b7.png)\n\n \n\nFind the volume of the solid region above.\n\n*Hint: All surfaces, except for the top one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/75a76a2dbc34c889335e66623e12b686eb9a255ee0d67f9be0e3792f2650360c.png)\n\n \n\nNotice that our solid can be written as the type I region\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\: (x,y) \\in D, \\:\\: 0 \\leq z \\leq 4-x-y \\big\\},\n$$\n\nwhere\n\n$$\nD = \\big\\{ (x,y) \\: : \\: 0 \\leq x \\leq 1, \\:\\: 0 \\leq y \\leq 2 \\big\\}\n$$\n\nis the projection of $R$ onto the $xy$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/e19ffe6a0555851c2b05526272beb21dbcdc082a23a2e11809c661666efdf133.png)\n\nHence, the type I representation of $R$ is\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\: 0 \\leq x \\leq 1, \\:\\: 0 \\leq y \\leq 2, \\:\\: 0 \\leq z \\leq 4-x-y \\big\\}.\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}{\\int }_{0}^{4-x-y}dz\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}[z]_{z=0}^{z=4-x-y}\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}(4-x-y)-0\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{2}4-x-y\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}{[(4-x)y-\\frac{{y}^{2}}{2}]}_{y=0}^{y=2}\\,dx \\\\  & ={\\int }_{0}^{1}((4-x)(2)-\\frac{{2}^{2}}{2})-0\\,dx \\\\  & ={\\int }_{0}^{1}6-2x\\,dx \\\\  & =[6x-{x}^{2}]_{x=0}^{x=1} \\\\  & =(6(1)-{1}^{2})-0 \\\\  & =5\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8191"] :question/problem "Find the volume of the solid region enclosed by the surface ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/9597cda64435e7e578c996c4c5d3e3056705e5c4fb79ccbb9bbf48cd7befe296.png) the plane ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/cd3b605899fbd8e49350a7f9fc6184911d4308e39ec94fe5b072cf0697b131f8.png) and the planes ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/7eb560050bef519d15d7bea27856044c51d6bdd794b40b95f2dd8a3c50e59c0f.png) ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/ffebc693860930a5435af764f3707689c9f70fc4ad6c764dfac1a124e65356c1.png) ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/565885d259d0dbf65c2faa6f43d18dcfba04ca1249bda3e90d0c2f433e80a8b4.png) ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/76bc9b4689fb88451fa5003bc31ef3c12d7dbcbae6955da504fbce27d0345829.png)" :question/worked-solution "Notice that our solid can be written as a type III region.\n\nFor each point ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/2a3a167677bfdfb8d87dff88867664d5f458ead614c4ec27b43bb2e498bde545.png) in the rectangular base region\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/341b60cfc6c2a2005ddf74477e9cb5a3daa5f9c64194ecef6c65c4df0295dbf4.png)\nthe variable ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/523ba398cc130edb20b50aa7b9a5deab0a53e4222824e3deda7f1a13ac7b0a56.png) runs from the surface\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/a0569d8f914ef9ad9e121ee79be25a1decce6381aedf54e3eb5ef633f652fe8e.png)\nup to the plane\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/0f1adb561fc36d233b9c2711b7da31566c8e9475b3ac442677963c5fdf54e5ac.png)\n\nSo we can write:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/f2c48bb89e04bcbf32e367ed0cdf260f7fa0630b3039f0fd842bfd418a5b124e.png)\n\nTherefore, the volume of ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/f49bc07ef2d4d420878a9a9a3fab238aa47bed7fb96828ab0249cfd0c7419484.png) is given by the following triple integral:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064036/assets/37f11eb812a19788af700184269ef20eb4cef4115fef59477afb49da067d940f.png)" :db/ensure [:question/validate]} {:db