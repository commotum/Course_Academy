y\\le x\\le y+1}\n$$\n\nTherefore, the volume of $R$ is given by the following triple integral:\n\n$$\n\\begin{aligned}V & ={∭}_{R}\\text{d}V \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}{\\int }_{1-y}^{y+1}\\,dx\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}[x]_{x=1-y}^{x=y+1}\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}y+1-(1-y)\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}{\\int }_{0}^{1}2y\\,dz\\,dy \\\\  & ={\\int }_{1}^{2}2y[z]_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{1}^{2}2y\\,dy \\\\  & =[{y}^{2}]_{y=1}^{y=2} \\\\  & ={2}^{2}-{1}^{2} \\\\  & =3\\end{aligned}\n$$" 13194139535406 true] [17592186347629 1000 #edb/ref 17592186347630 13194139535406 true] [17592186347629 1000 #edb/ref 17592186347631 13194139535406 true] [17592186347629 1000 #edb/ref 17592186347632 13194139535406 true] [17592186347629 1000 #edb/ref 17592186347633 13194139535406 true] [17592186347629 1000 #edb/ref 17592186347634 13194139535406 true] [17592186347629 1040 #edb/ref 17592186045450 13194139535406 true] [17592186347629 1041 "selection" 13194139535406 true] [17592186347629 1104 #edb/ref 17592186347631 13194139535406 true] [17592186347629 1110 #uuid "5be1295d-04e2-574a-8f44-3e2fb4ae836a" 13194139535406 true] [17592186347630 1034 "\\frac{5}{2}" 13194139535406 true] [17592186347630 1103 #edb/ref 17592186045453 13194139535406 true] [17592186347630 1111 #uuid "4c0fcca5-4496-5af2-95c4-c906ab8c14f9" 13194139535406 true] [17592186347631 1034 "3" 13194139535406 true] [17592186347631 1103 #edb/ref 17592186045453 13194139535406 true] [17592186347631 1111 #uuid "d141a7e0-17ba-561d-842a-e6cbef4d8354" 13194139535406 true] [17592186347632 1034 "2" 13194139535406 true] [17592186347632 1103 #edb/ref 17592186045453 13194139535406 true] [17592186347632 1111 #uuid "0cfbd79a-93a3-5ccc-83ef-2b95f3d24229" 13194139535406 true] [17592186347633 1034 "\\frac{3}{4}" 13194139535406 true] [17592186347633 1103 #edb/ref 17592186045453 13194139535406 true] [17592186347633 1111 #uuid "ccd1ac0d-a435-50ef-a14e-834186cf4a4d" 1319413