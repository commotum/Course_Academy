        {
          "question": "e-6106",
          "field": null,
          "attribute": "question/problem",
          "value": "Evaluate the double integral $\\displaystyle \\iint\\limits_{R} xy\\ \\!e^{x+y}\\ \\textrm d A$ over the rectangle $R= [0,1] \\times [1,2].$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-6106.json",
          "file_sha256": "6345112ddafcb49805665f96900d73bb280c5c8f446a78a036b8c21d20cd00f3"
        }
      ],
      "basis": 1795,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/edb-import/commit.edn",
