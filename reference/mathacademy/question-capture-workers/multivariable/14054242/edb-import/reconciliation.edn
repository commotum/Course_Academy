os}⁡x\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130025" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/activity-metadata.json" "file_sha256" "4268d8bae7a70f39a54b4e6287468d7ce3c5211a844a56c84c2509dc70d02393"} {"question" "q-130025" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130025" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A"] ["math" "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}{e}^{x+y}\\,\\text{d}A"] ["math" "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{T}{e}^{x+y}\\,\\text{d}A+{∬}_{U}\\,\\text{d}A"] ["math" "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A"] ["math" "{∬}_{S}{e}^{x+y}\\,\\text{d}A+{∬}_{U}y\\operatorname{cos}⁡x\\,\\text{d}A"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130025" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{∬}_{S}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{U}{e}^{x+y}\\,\\text{d}A"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-80452" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/assets/ed0be2aca8d43d733e91f3a8feaaca0649957dcbd516a8218b1e7dea136170d8.png)\n\nConsider the region $R$ shown above. Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)={\\begin{aligned}x, & (x,y)\\in S, \\\\ 0, & (x,y)\\in T, \\\\ {x}^{2}y, & (x,y)\\in U.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{R}f(x,y)\\text{ }\\text{d}A=\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-80452" "field" nil "attribute" "question/worked-solution" "value" "First, notice that the domain $R$ can be represented as a union of three sub-domains, as follows:\n\n$$\n\\begin{aligned}R & =S\\cup T\\cup U.\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{S}f(x,y)\\,\\text{d}A+{∬}_{T}f(x,y)\\,\\text{d}A+{∬}_{U}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{S}x\\,\\text{d}A+{∬}_{T}0\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A \\\\  & ={∬}_{S}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-80452" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/activity-metadata.json" "file_sha256" "4268d8bae7a70f39a54b4e6287468d7ce3c5211a844a56c84c2509dc70d02393"} {"question" "q-80452" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-80452" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{∬}_{S}x\\,\\text{d}A+{∬}_{T}(x+{x}^{2}y)\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A"] ["math" "{∬}_{S}x\\,\\text{d}A+{∬}_{T}y\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A"] ["math" "{∬}_{S}x\\,\\text{d}A+{∬}_{T}{x}^{2}y\\,\\text{d}A"] ["math" "{∬}_{S}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A"] ["math" "{∬}_{T}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-80452" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{∬}_{S}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-81254" "field" nil "attribute" "question/problem" "value" "Evaluate the double integral ${∬}_{R}f(x,y)\\,\\text{d}A$, where\n\n$$\nf(x,y)={\\begin{aligned}3{y}^{2},\\, & \\text{if}\\,1<x<9,\\,-1<y<1, \\\\ \\frac{1}{4\\sqrt{xy}},\\, & \\text{if}\\,1<x<9,\\,1<y<4,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-81254" "field" nil "attribute" "question/worked-solution" "value" "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(1,9)\\times (-1,1)$ and ${R}_{2}=(1,9)\\times (1,4).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}3{y}^{2}\\,\\text{d}A+{∬}_{{R}_{2}}\\frac{1}{4\\sqrt{xy}}\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}3{y}^{2}\\,\\text{d}A+{∬}_{{R}_{2}}(\\frac{1}{2\\sqrt{x}})(\\frac{1}{2\\sqrt{y}})\\,\\text{d}A \\\\  & =(9-1){\\int }_{-1}^{1}3{y}^{2}\\,\\text{d}y+({\\int }_{1}^{9}\\frac{1}{2\\sqrt{x}}\\,\\text{d}x)({\\int }_{1}^{4}\\frac{1}{2\\sqrt{y}}\\,\\text{d}y) \\\\  & =8[{y}^{3}]_{-1}^{1}+[\\sqrt{x}]_{1}^{9}\\cdot [\\sqrt{y}]_{1}^{4} \\\\  & =8({1}^{3}-(-1)^{3})+(3-1)\\cdot (2-1) \\\\  & =18.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-81254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/activity-metadata.json" "file_sha256" "4268d8bae7a70f39a54b4e6287468d7ce3c5211a844a56c84c2509dc70d02393"} {"question" "q-81254" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-81254" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "14"] ["math" "16"] ["math" "18"] ["math" "2"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-81254" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "18"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130038" "field" nil "attribute" "question/problem" "value" "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)={\\begin{aligned}\\frac{y+1}{1+{x}^{2}},\\, & \\text{if}\\,1<x<2,\\,1<y<2, \\\\ \\frac{{x}^{2}}{{y}^{2}},\\, & \\text{if}\\,1<x<2,\\,2<y<4.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(1,2)\\times (1,4)}f(x,y)\\text{ }\\text{d}A=\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130038" "field" nil "attribute" "question/worked-solution" "value" "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(1,2)\\times ((1,2)\\cup (2,4)) \\\\  & =((1,2)\\times (1,2))\\cup ((1,2)\\times (2,4)).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(1,2)\\times (1,2)}f(x,y)\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130038" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/activity-metadata.json" "file_sha256" "4268d8bae7a70f39a54b4e6287468d7ce3c5211a844a56c84c2509dc70d02393"} {"question" "q-130038" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130038" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A"] ["math" "{∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(2,4)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A"] ["math" "{∬}_{(1,2)\\times (1,2)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A"] ["math" "{∬}_{(1,2)\\times (1,4)}(\\frac{y+1}{1+{x}^{2}}+\\frac{{x}^{2}}{{y}^{2}})\\,\\text{d}A"] ["math" "{∬}_{(1,2)\\times (1,4)}\\frac{{x}^{2}(y+1)}{{y}^{2}(1+{x}^{2})}\\,\\text{d}A"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130038" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{∬}_{(1,2)\\times (1,2)}\\frac{y+1}{1+{x}^{2}}\\,\\text{d}A+{∬}_{(1,2)\\times (2,4)}\\frac{{x}^{2}}{{y}^{2}}\\,\\text{d}A"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130042" "field" nil "attribute" "question/problem" "value" "Evaluate the double integral ${∬}_{R}f(x,y)\\,\\text{d}A$, where\n\n$$\nf(x,y)={\\begin{aligned}x{y}^{2},\\, & \\text{if}\\,-2<x<0,\\,0<y<2, \\\\ 2x,\\, & \\text{if}\\,0<x<1,\\,0<y<2,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130042" "field" nil "attribute" "question/worked-solution" "value" "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(-2,0)\\times (0,2)$ and ${R}_{2}=(0,1)\\times (0,2).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}x{y}^{2}\\,\\text{d}A+{∬}_{{R}_{2}}2x\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}(x)({y}^{2})\\,\\text{d}A+{∬}_{{R}_{2}}2x\\,\\text{d}A \\\\  & =({\\int }_{-2}^{0}x\\,\\text{d}x)({\\int }_{0}^{2}{y}^{2}\\,\\text{d}y)+(2-0){\\int }_{0}^{1}2x\\,\\text{d}x \\\\  & ={[\\frac{{x}^{2}}{2}]}_{-2}^{0}\\cdot {[\\frac{{y}^{3}}{3}]}_{0}^{2}+2[{x}^{2}]_{0}^{1} \\\\  & =(-2)\\cdot \\frac{8}{3}+2 \\\\  & =-\\frac{10}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130042" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/activity-metadata.json" "file_sha256" "4268d8bae7a70f39a54b4e6287468d7ce3c5211a844a56c84c2509dc70d02393"} {"question" "q-130042" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130042" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "-\\frac{10}{3}"] ["math" "2"] ["math" "6"] ["math" "\\frac{5}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130042" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{10}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130044" "field" nil "attribute" "question/problem" "value" "Evaluate the double integral ${∬}_{R}f(x,y)\\,\\text{d}A$, where\n\n$$\nf(x,y)={\\begin{aligned}y{e}^{x+1},\\, & \\text{if}\\,0<x<1,\\,-2<y<0, \\\\ 3y\\sqrt{x},\\, & \\text{if}\\,1<x<4,\\,-2<y<0,\\end{aligned}\n$$\n\nand  $R$ is the domain of $f.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130044" "field" nil "attribute" "question/worked-solution" "value" "First, notice that we have $R={R}_{1}\\cup {R}_{2}$, where ${R}_{1}=(0,1)\\times (-2,0)$ and ${R}_{2}=(1,4)\\times (-2,0).$ So, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A= & ={∬}_{{R}_{1}}f(x,y)\\,\\text{d}A+{∬}_{{R}_{2}}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}y{e}^{x+1}\\,\\text{d}A+{∬}_{{R}_{2}}3y\\sqrt{x}\\,\\text{d}A \\\\  & ={∬}_{{R}_{1}}({e}^{x+1})(y)\\,\\text{d}A+{∬}_{{R}_{2}}(\\sqrt{x})(3y)\\,\\text{d}A \\\\  & =({\\int }_{0}^{1}{e}^{x+1}\\,\\text{d}x)({\\int }_{-2}^{0}y\\,\\text{d}y)+({\\int }_{1}^{4}\\sqrt{x}\\,\\text{d}x)({\\int }_{-2}^{0}3y\\,\\text{d}y) \\\\  & =[{e}^{x+1}]_{0}^{1}\\cdot {[\\frac{{y}^{2}}{2}]}_{-2}^{0}+{[\\frac{2\\sqrt{{x}^{3}}}{3}]}_{1}^{4}\\cdot {[\\frac{3{y}^{2}}{2}]}_{-2}^{0} \\\\  & =({e}^{2}-e)\\cdot (0-2)+(\\frac{16}{3}-\\frac{2}{3})\\cdot (0-6) \\\\  & =-2{e}^{2}+2e-28.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130044" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/activity-metadata.json" "file_sha256" "4268d8bae7a70f39a54b4e6287468d7ce3c5211a844a56c84c2509dc70d02393"} {"question" "q-130044" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130044" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{e}^{2}+2e-28"] ["math" "-2{e}^{2}-28"] ["math" "-{e}^{2}+2e-14"] ["math" "2{e}^{2}-e"] ["math" "2{e}^{2}-e+14"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130044" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2{e}^{2}+2e-28"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130039" "field" nil "attribute" "question/problem" "value" "Let the function $f(x,y)$ be defined as\n\n$$\nf(x,y)={\\begin{aligned}y\\operatorname{cos}⁡x,\\, & \\text{if}\\,0<x<\\pi ,\\,0<y<\\frac{\\pi }{4}, \\\\ \\sqrt{x}{sec}^{2}⁡y,\\, & \\text{if}\\,0<x<\\pi ,\\,\\frac{\\pi }{4}<y<\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nThen,\n\n$$\n{∬}_{(0,\\pi )\\times (0,\\pi /2)}f(x,y)\\text{ }\\text{d}A=\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130039" "field" nil "attribute" "question/worked-solution" "value" "First, notice that the rectangle $R$ can be represented as a union of two smaller rectangles, as follows:\n\n$$\n\\begin{aligned}R & =(0,\\pi )\\times ((0,\\frac{\\pi }{4})\\cup (\\frac{\\pi }{4},\\frac{\\pi }{2})) \\\\  & =((0,\\pi )\\times (0,\\frac{\\pi }{4}))\\cup ((0,\\pi )\\times (\\frac{\\pi }{4},\\frac{\\pi }{2})).\\end{aligned}\n$$\n\nSo, we can write\n\n$$\n\\begin{aligned}{∬}_{R}f(x,y)\\,\\text{d}A & ={∬}_{(0,\\pi )\\times (0,\\pi /4)}f(x,y)\\,\\text{d}A+{∬}_{(0,\\pi )\\times (\\pi /4,\\pi /2)}f(x,y)\\,\\text{d}A \\\\  & ={∬}_{(0,\\pi )\\times (0,\\pi /4)}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{(0,\\pi )\\times (\\pi /4,\\pi /2)}\\sqrt{x}{sec}^{2}⁡y\\,\\text{d}A.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130039" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/activity-metadata.json" "file_sha256" "4268d8bae7a70f39a54b4e6287468d7ce3c5211a844a56c84c2509dc70d02393"} {"question" "q-130039" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130039" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\int }_{(0,\\pi )}\\sqrt{x}\\operatorname{cos}⁡x\\,\\text{d}x+{\\int }_{(0,\\pi /2)}y{sec}^{2}⁡y\\,\\text{d}y"] ["math" "{∬}_{(0,\\pi )\\times (0,\\pi /2)}(y\\operatorname{cos}⁡x+\\sqrt{x}{sec}^{2}⁡y)\\,\\text{d}A"] ["math" "{∬}_{(0,\\pi )\\times (0,\\pi /4)}\\sqrt{x}{sec}^{2}⁡y\\,\\text{d}A+{∬}_{(0,\\pi )\\times (\\pi /4,\\pi /2)}y\\operatorname{cos}⁡x\\,\\text{d}A"] ["math" "{∬}_{(0,\\pi )\\times (0,\\pi /4)}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{(0,\\pi )\\times (\\pi /4,\\pi /2)}\\sqrt{x}{sec}^{2}⁡y\\,\\text{d}A"] ["math" "{∬}_{(0,\\pi /2)\\times (0,\\pi /2)}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{(\\pi /2,\\pi )\\times (0,\\pi /2)}\\sqrt{x}{sec}^{2}⁡y\\,\\text{d}A"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "q-130039" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{∬}_{(0,\\pi )\\times (0,\\pi /4)}y\\operatorname{cos}⁡x\\,\\text{d}A+{∬}_{(0,\\pi )\\times (\\pi /4,\\pi /2)}\\sqrt{x}{sec}^{2}⁡y\\,\\text{d}A"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/state.json" "file_sha256" "7657dbc527d157b97356580289bf2db64fc387abe9b8da0e583ac2e0788f2e6b"} {"question" "e-6106" "field" nil "attribute" "question/problem" "value" "Evaluate the double integral $\\displaystyle \\iint\\limits_{R} xy\\ \\!e^{x+y}\\ \\textrm d A$ over the rectangle $R= [0,1] \\times [1,2].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-6106.json" "file_sha256" "6345112ddafcb49805665f96900d73bb280c5c8f446a78a036b8c21d20cd00f3"} {"question" "e-6106" "field" nil "attribute" "question/worked-solution" "value" "We apply the multiplicative property of double integrals and then evaluate each of the integrals separately:\n\n$$\n\\eqalign{\n\\iint\\limits_{R}  xy\\  e^{x+y}\\: \\textrm d A &= \\iint\\limits_{R} \\Big( x\\ \\! e^x \\Big)\\Big( y\\ \\! e^{y} \\Big) \\textrm d A\\[5pt]\n&= \\left(\\int_0^1x\\  e^{x}  \\ \\textrm d x\\right)\\left( \\int_1^2 y \\ \\!e^{y} \\ \\textrm d y\\right)\\[5pt]\n                                                                         &= \\Big[x\\ \\!e^x-e^x\\Big]_0^1 \\cdot  \\Big[y\\ \\!e^y-e^y\\Big]_1^2\\[5pt]\n                                                                         &=  \\Big(e^1-e^1 - \\left(0-e^0\\right)\\Big) \\cdot \\Big(2e^2-e^2 - \\left(e^1-e^1\\right) \\Big)\\[5pt]\n                                                                         &= 1\\cdot e^2\\[5pt]\n                                                                         &= e^2\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-6106.json" "file_sha256" "6345112ddafcb49805665f96900d73bb280c5c8f446a78a036b8c21d20cd00f3"} {"question" "e-6107" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\iint\\limits_{R} \\left(x^2-y^2 +3\\right)  \\textrm d A,$  where $R= [-1,3] \\times [2, 4].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-6107.json" "file_sha256" "e1532b3a549e7c56c071d96bf340e70c312f4941343334d2dddae46729b2c0e5"} {"question" "e-6107" "field" nil "attribute" "question/worked-solution" "value" "Using the linearity property of double integrals, we can write\n\n$$\n\\begin{aligned}{∬}_{R}({x}^{2}-{y}^{2}+3)\\text{ }\\text{d}A & ={∬}_{R}{x}^{2}\\text{ }\\text{d}A-{∬}_{R}{y}^{2}\\text{ }\\text{d}A+{∬}_{R}3\\,\\text{d}A.\\end{aligned}\n$$\n\nNow, let's evaluate each of the three integrals.\n\n- The function under the first integral is independent of $y.$ So, we have \n\n$$\n\\begin{aligned}{∬}_{R}{x}^{2}\\text{ }\\text{d}A & =(4-2){\\int }_{-1}^{3}{x}^{2}\\text{ }\\text{d}x \\\\  & =2\\cdot \\frac{{x}^{3}}{3}{|}_{-1}^{3} \\\\  & =2(\\frac{27}{3}+\\frac{1}{3}) \\\\  & =\\frac{56}{3}.\\end{aligned}\n$$\n\n- The function under the second integral is independent of $x.$ So, we have\n\n$$\n\\begin{aligned}{∬}_{R}{y}^{2}\\text{ }\\text{d}A & =(3-(-1)){\\int }_{2}^{4}{y}^{2}\\text{ }\\text{d}y \\\\  & =4{\\int }_{2}^{4}{y}^{2}\\,\\text{d}y \\\\  & =4\\cdot \\frac{{y}^{3}}{3}{|}_{2}^{4} \\\\  & =\\frac{4}{3}{4}^{3}-\\frac{4}{3}{2}^{3} \\\\  & =\\frac{224}{3}.\\end{aligned}\n$$\n\n- The function under the third integral is a constant, so we have\n\n$$\n\\begin{aligned}{∬}_{R}3\\,\\text{d}A=3\\,\\text{Area}(R)=3\\cdot (2\\cdot 4)=24.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain\n\n$$\n\\begin{aligned}{∬}_{R}({x}^{2}-{y}^{2}+3)\\,\\text{d}A=\\frac{56}{3}-\\frac{224}{3}+24=-32.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-6107.json" "file_sha256" "e1532b3a549e7c56c071d96bf340e70c312f4941343334d2dddae46729b2c0e5"} {"question" "e-7023" "field" nil "attribute" "question/problem" "value" "Given that $C$ and $D$ are finite, non-overlapping regions and that\n\n$$\n\\iint\\limits_{C}  f(x,y)\\ \\textrm{d}A = 8,\n\\qquad\n\\iint\\limits_{D}  f(x,y)\\ \\textrm{d}A = -5,\n$$\n\nfind the value of \n\n$$\n\\iint\\limits_{C \\cup D}  3f(x,y)\\ \\textrm{d}A.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-7023.json" "file_sha256" "3b3b35130e5cbc7b36ee0e55d8f95db9da8d7f27f39e5c860b3be08021adc517"} {"question" "e-7023" "field" nil "attribute" "question/worked-solution" "value" "Using the linearity and additivity of double integrals, we get the following:\n\n$$\n\\begin{aligned}{∬}_{C\\cup D}3f(x,y)\\text{ }\\text{d}A & =3{∬}_{C\\cup D}f(x,y)\\text{ }\\text{d}A \\\\  & =3({∬}_{C}f(x,y)\\text{ }\\text{d}A+{∬}_{D}f(x,y)\\text{ }\\text{d}A) \\\\  & =3(8+(-5)) \\\\  & =3\\cdot 3 \\\\  & =9\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-7023.json" "file_sha256" "3b3b35130e5cbc7b36ee0e55d8f95db9da8d7f27f39e5c860b3be08021adc517"} {"question" "e-6108" "field" nil "attribute" "question/problem" "value" "Evaluate the double integral $\\displaystyle \\iint\\limits_{R}  f(x,y)\\ \\textrm d A$, where\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/assets/d96ec9ab40f8f1cadd6d2492dddcc0090f766b72e9c7fdb659e3b2f7f39fce0d.png)\nand  $R$ is the domain of $f.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-6108.json" "file_sha256" "b0b1d742a6c3a79e660b743f8779736a296acb7524f0263fdd018662d9b478f1"} {"question" "e-6108" "field" nil "attribute" "question/worked-solution" "value" "First, notice that we have $R = R_1 \\cup R_2,$ where $R_1= (0,2) \\times (-1,0)$ and $R_2= (0,2) \\times (0,1).$ So, we can write\n\n$$\n\\eqalign{\n\\iint\\limits_{R}  f(x,y)\\ \\textrm d A &= \\iint\\limits_{R_1} 2 \\ \\textrm d A + \\iint\\limits_{R_2}    \\dfrac{1}{xy+x+y+1} \\ \\textrm d A\\[5pt]\n&= 2\\iint\\limits_{R_1} \\textrm d A\n+ \\iint\\limits_{R_2}  \\dfrac{1}{(x+1)(y+1)} \\ \\textrm d A\\[5pt]\n&= 2(2-0)(0-(-1)) + \\Bigg( \\int_0^2 \\dfrac{1}{x+1} \\ \\textrm d x \\Bigg) \\Bigg( \\int_0^1 \\dfrac{1}{y+1}\\ \\textrm d y \\Bigg) \\[5pt]\n&= 4 + \\Big[\\ln(x+1)\\Big]_0^2  \\cdot \\Big[\\ln(y+1)\\Big]_0^1\\[5pt] \n&= 4+ \\ln 3\\ln 2.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/example-6108.json" "file_sha256" "b0b1d742a6c3a79e660b743f8779736a296acb7524f0263fdd018662d9b478f1"} {"question" "q-80452" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{∬}_{S}x\\,\\text{d}A+{∬}_{U}{x}^{2}y\\,\\text{d}A"] "category" "reviewed_ma_solution" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054242/answer-source-reviews.json" "file_sha256" "89d850803dcb6707153af49916f1d2d691fe6ddbbfa8fa373c51dc28d6ac63ef" "reviewer_session" "01a11908-fa8d-7c61-8e03-c1185d0b9506" "rationale" "The diagram partitions R into S, T, and U with disjoint interiors. Additivity gives the sum of integrals over these regions. Substituting the specified function gives ∬_S x dA+∬_T 0 dA+∬_U x²y dA, and the T term vanishes. This is original option a, matching the authentic worked solution and stored key. Saved grading reports Correct. The legacy _(S) and _(U) notation denotes the same integration regions as the captured subscripts." "bindings" {"problem" "6018109abd3bdf83b2a0c4c2aa112f9fe073eb54a0161afeaaf82f4c332ee751" "worked_solution" "abc2cc7bdac0a0f4cb5136f2b6c4746d4dd6e67ed28a65dba1d74b6004