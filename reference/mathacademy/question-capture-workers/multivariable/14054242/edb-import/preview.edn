}^{2}{|}_{2}^{4} \\\\  & =3({4}^{2}-{2}^{2}) \\\\  & =36.\\end{aligned}\n$$\n\nFinally, combining our results, we obtain \n\n$$\n\\begin{aligned}{∬}_{R}\\frac{2+6y{x}^{2}}{{x}^{2}}\\,\\text{d}A=2+36=38.\\end{aligned}\n$$" 13194139535108 true] [17592186331719 1000 #edb/ref 17592186331720 13194139535108 true] [17592186331719 1000 #edb/ref 17592186331721 13194139535108 true] [17592186331719 1000 #edb/ref 17592186331722 13194139535108 true] [17592186331719 1000 #edb/ref 17592186331723 13194139535108 true] [17592186331719 1000 #edb/ref 17592186331724 13194139535108 true] [17592186331719 1040 #edb/ref 17592186045450 13194139535108 true] [17592186331719 1041 "selection" 13194139535108 true] [17592186331719 1104 #edb/ref 17592186331721 13194139535108 true] [17592186331719 1110 #uuid "6d1d8f99-e8f2-5c7b-8e3c-1a377dc16933" 13194139535108 true] [17592186331720 1034 "22" 13194139535108 true] [17592186331720 1103 #edb/ref 17592186045453 13194139535108 true] [17592186331720 1111 #uuid "1e4eb38d-2263-5662-b7bc-97900c473302" 13194139535108 true] [17592186331721 1034 "38" 13194139535108 true] [17592186331721 1103 #edb/ref 17592186045453 13194139535108 true] [17592186331721 1111 #uuid "6344c30c-7da7-5f67-88ea-0b7dae0cf25c" 13194139535108 true] [17592186331722 1034 "26" 13194139535108 true] [17592186331722 1103 #edb/ref 17592186045453 13194139535108 true] [17592186331722 1111 #uuid "276ad511-5dad-520e-87e9-57b70df049a4" 13194139535108 true] [17592186331723 1034 "48" 13194139535108 true] [17592186331723 1103 #edb/ref 17592186045453 13194139535108 true] [17592186331723 1111 #uuid "d3ebab3e-d54e-51ba-8bd4-27166789830d" 13194139535108 true] [17592186331724 1034 "18" 13194139535108 true] [17592186331724 1103 #edb/ref 17592186045453 13194139535108 true] [17592186331724 1111 #uuid "47fb5657-e78c-5c1f-a25c-4a2c8c35e82e" 13194139535108 true] [17592186331725 1017 #edb/ref 17592186331726 13194139535108 true] [17592186331725 1089 "q-80638" 13194139535108 true] [17592186331725 1091 #edb/ref 175921