sin}⁡\\theta ,\\,z⟩.\n$$\n\nFinally, substituting $z=r\\operatorname{cos}⁡4\\theta ,$ we obtain the parametrization\n\n$$\nf(r,\\theta )=⟨r\\operatorname{cos}⁡\\theta ,\\,r\\operatorname{sin}⁡\\theta ,\\,r\\operatorname{cos}⁡4\\theta ⟩.\n$$\n\nTherefore, the second component of $f$ is $r\\operatorname{sin}⁡\\theta .$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104276/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "097a87b7-38e3-5002-b460-2edccb9ce85c"] :knowledge-point/questions ["q-104276"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104365/selection/3461971431045a29571ed0ba2808b4e1beadc7469104c72b7fe653e738156078" :answer/id #uuid "091b82d5-eea2-5f5c-ad68-288ddf337de9" :answer/type :answer.type/math :answer/value "ϕ\\operatorname{sec}⁡\\theta \\operatorname{cos}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104365/selection/7f45797e0122bb61807a1f6c5668c62cfc619c7d8cf1a7172e131abe8424178e" :answer/id #uuid "8fdcdfe8-eb49-520d-895d-2f875a7d7f16" :answer/type :answer.type/math :answer/value "ϕ\\operatorname{cos}⁡\\theta \\operatorname{tan}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104365/selection/b37b782d8bf58c4cccf9560725f3beeeb540e434ec044b5f8259a39f46a8d4a7" :answer/id #uuid "f7a9f5bf-2019-5ccc-b514-818d617842fb" :answer/type :answer.type/math :answer/value "ϕ\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104365/selection/fc848c75983f5c9cc652a3f03bce2f9b9434d3131d45b8d3cb191bfff1c6f981" :answer/id #uuid "c2865ff9-b565-5d24-9cfc-b9dade1e2bc3" :answer/type :answer.type/math :answer/value "ϕ\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104365/selection/14b7b70efaae5e9804849e94a447885a8823dd5d1b8e18801cd7a1a776e87256" :answer/id #uuid "b00824a8-0540-5875-9e8e-8817a9eed237" :answer/type :answer.type/math :answer/value "ϕ\\operatorname{sin}⁡\\theta \\operatorname{tan}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104365/selection" :answer-field/id #uuid "08d0ed85-6489-5cb7-afbe-0c0669c8e9f2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104365/selection/3461971431045a29571ed0ba2808b4e1beadc7469104c72b7fe653e738156078" :answer-field/choices ["q-104365/selection/3461971431045a29571ed0ba2808b4e1beadc7469104c72b7fe653e738156078" "q-104365/selection/7f45797e0122bb61807a1f6c5668c62cfc619c7d8cf1a7172e131abe8424178e" "q-104365/selection/b37b782d8bf58c4cccf9560725f3beeeb540e434ec044b5f8259a39f46a8d4a7" "q-104365/selection/fc848c75983f5c9cc652a3f03bce2f9b9434d3131d45b8d3cb191bfff1c6f981" "q-104365/selection/14b7b70efaae5e9804849e94a447885a8823dd5d1b8e18801cd7a1a776e87256"] :db/ensure [:answer-field/validate]} {:db/id "q-104365" :question/id #uuid "96230e9a-9b2e-5ded-835d-50fdb79267c0" :question/math-academy-id "q-104365" :question/problem "$$\nf(\\theta ,ϕ)=⟨ϕ\\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\text{ _____ }⟩\n$$\n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$ϕ=\\rho \\operatorname{cos}⁡\\theta .$\nWhat is the third component of $f?$" :question/worked-solution "First, we write the equation of the surface in the form $\\rho =f(\\theta ,ϕ):$\n\n$$\n\\begin{aligned}ϕ & =\\rho \\operatorname{cos}⁡\\theta  \\\\ \\rho  & =\\frac{ϕ}{\\operatorname{cos}⁡\\theta }\\end{aligned}\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =\\frac{ϕ}{\\operatorname{cos}⁡\\theta },$ we obtain\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨\\frac{ϕ}{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\frac{ϕ}{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\frac{ϕ}{\\operatorname{cos}⁡\\theta }\\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨ϕ\\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{tan}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{sec}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the third component of $f$ is $ϕ\\operatorname{sec}⁡\\theta \\operatorname{cos}⁡ϕ.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-104365/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e6352a6-6505-517a-9a70-7c5701eda938"] :knowledge-point/questions ["q-104365"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104372/selection/d0487121cde4547eacbdb99294fc62a84ab2483d9022dcad3b205d5706d19dd7" :answer/id #uuid "9ada14d3-b271-59e0-89b7-4f43c81854a8" :answer/type :answer.type/math :answer/value "2{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104372/selection/45c264210ac2725d1a1da817dfe29f2d46e675f2dde574f02b22fa40930d2b71" :answer/id #uuid "051d5993-7904-56ef-a271-e5d002615b6d" :answer/type :answer.type/math :answer/value "2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104372/selection/dbc2711011b43fd33fe181c1261e0e7c64a0ba7298825582d62d8e0fb6381f25" :answer/id #uuid "3f09c4a9-6b7c-511f-b8d2-a889e20d0541" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104372/selection/3e230b44fdaa836691d031f6ee71cd59ba717ca5fe5768e13eeb3e2b8adc9181" :answer/id #uuid "970d2b1a-4e14-56d6-8533-1eaeddbc716e" :answer/type :answer.type/math :answer/value "{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104372/selection/a2865415646dea391ce16d550e869ca4b61cc3a03e8f984c07c4764445174ed5" :answer/id #uuid "7ca84e6e-e108-5201-b564-b5082480b300" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡2\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104372/selection" :answer-field/id #uuid "f61fb015-9e76-50b9-92fa-0c9abe890de2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104372/selection/a2865415646dea391ce16d550e869ca4b61cc3a03e8f984c07c4764445174ed5" :answer-field/choices ["q-104372/selection/d0487121cde4547eacbdb99294fc62a84ab2483d9022dcad3b205d5706d19dd7" "q-104372/selection/45c264210ac2725d1a1da817dfe29f2d46e675f2dde574f02b22fa40930d2b71" "q-104372/selection/dbc2711011b43fd33fe181c1261e0e7c64a0ba7298825582d62d8e0fb6381f25" "q-104372/selection/3e230b44fdaa836691d031f6ee71cd59ba717ca5fe5768e13eeb3e2b8adc9181" "q-104372/selection/a2865415646dea391ce16d550e869ca4b61cc3a03e8f984c07c4764445174ed5"] :db/ensure [:answer-field/validate]} {:db/id "q-104372" :question/id #uuid "025b4b30-6969-5e0b-82fb-0c3def5d3c2e" :question/math-academy-id "q-104372" :question/problem "$$\nf(\\theta ,ϕ)=⟨\\text{_____},\\,2{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ⟩\n$$\n\n \n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$\\rho =2\\operatorname{sin}⁡\\theta .$\nWhat is the first component of $f?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =2\\operatorname{sin}⁡\\theta ,$ we obtain \n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨\\operatorname{sin}⁡2\\theta \\operatorname{sin}⁡ϕ,\\,2{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ,\\,2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the first component of $f$ is $\\operatorname{sin}⁡2\\theta \\operatorname{sin}⁡ϕ.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104372/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e6352a6-6505-517a-9a70-7c5701eda938"] :knowledge-point/questions ["q-104372"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-103796"] :question/problem "$$\nf(\\theta ,ϕ)=⟨ϕ\\operatorname{cot}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{sin}⁡ϕ,\\,\\text{ _____ }⟩\n$$\n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$ϕ=\\rho \\operatorname{sin}⁡\\theta .$\nWhat is the third component of $f?$" :question/worked-solution "First, we write the equation of the surface in the form $\\rho =f(\\theta ,ϕ):$\n\n$$\n\\begin{aligned}ϕ & =\\rho \\operatorname{sin}⁡\\theta  \\\\ \\rho  & =\\frac{ϕ}{\\operatorname{sin}⁡\\theta }\\end{aligned}\n$$\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =\\frac{ϕ}{\\operatorname{sin}⁡\\theta },$ we obtain\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨\\frac{ϕ}{\\operatorname{sin}⁡\\theta }\\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\frac{ϕ}{\\operatorname{sin}⁡\\theta }\\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\frac{ϕ}{\\operatorname{sin}⁡\\theta }\\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨ϕ\\operatorname{cot}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{csc}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the third component of $f$ is $ϕ\\operatorname{csc}⁡\\theta \\operatorname{cos}⁡ϕ.$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-104375/selection/124d16294fd7893c1c5a163b6046b445b3671672c785624e6ec788236ab8c19f" :answer/id #uuid "9ea4a32f-e113-575c-b6b3-ff2c12045092" :answer/type :answer.type/math :answer/value "ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104375/selection/ed13506d069ea70c113f8cc076fd5c7352818be62c3c568d6ba665f7ae9ff8cc" :answer/id #uuid "d40b9de3-3a8b-5cf6-8dc9-90c6c189b49b" :answer/type :answer.type/math :answer/value "ϕ{sin}^{3}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104375/selection/1ed3b3191730df7b8dd23b7a1e80d28bc8ae9e24233f27de901dc763aba43287" :answer/id #uuid "156e8b7c-6226-5b25-bd27-ba590e72f057" :answer/type :answer.type/math :answer/value "ϕ\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104375/selection/578cdd6902590fa6f8efe2dcf75d12de9b2ec4a15f7687d282223104ebd57f47" :answer/id #uuid "5f6d03ba-ab0f-5e38-b309-eef48666fb7d" :answer/type :answer.type/math :answer/value "ϕ\\operatorname{sin}⁡2\\theta " :db/ensure [:answer/validate]} {:db/id "q-104375/selection/a9c27d68283e774aa64231a6ab89fa40dc19ef4f212c1dac8aa7fe79b5cd7a60" :answer/id #uuid "79f0d568-ff39-5e22-b988-215a4af8e073" :answer/type :answer.type/math :answer/value "ϕ{sin}^{2}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-104375/selection" :answer-field/id #uuid "4e1bade2-c256-5dc0-b78d-5f94e7fb6f59" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104375/selection/ed13506d069ea70c113f8cc076fd5c7352818be62c3c568d6ba665f7ae9ff8cc" :answer-field/choices ["q-104375/selection/124d16294fd7893c1c5a163b6046b445b3671672c785624e6ec788236ab8c19f" "q-104375/selection/ed13506d069ea70c113f8cc076fd5c7352818be62c3c568d6ba665f7ae9ff8cc" "q-104375/selection/1ed3b3191730df7b8dd23b7a1e80d28bc8ae9e24233f27de901dc763aba43287" "q-104375/selection/578cdd6902590fa6f8efe2dcf75d12de9b2ec4a15f7687d282223104ebd57f47" "q-104375/selection/a9c27d68283e774aa64231a6ab89fa40dc19ef4f212c1dac8aa7fe79b5cd7a60"] :db/ensure [:answer-field/validate]} {:db/id "q-104375" :question/id #uuid "027c00df-6ab8-583f-bb22-d5f3b64f0acb" :question/math-academy-id "q-104375" :question/problem "$$\nf(\\theta ,ϕ)=⟨ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\text{_____},\\,ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡ϕ⟩\n$$\n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$\\rho =ϕ{sin}^{2}⁡\\theta .$\nWhat is the second component of $f?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =ϕ{sin}^{2}⁡\\theta ,$ we obtain\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨ϕ{sin}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{2}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{2}⁡\\theta \\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{3}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ{sin}^{2}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the second component of $f$ is $ϕ{sin}^{3}⁡\\theta \\operatorname{sin}⁡ϕ.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-104375/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e6352a6-6505-517a-9a70-7c5701eda938"] :knowledge-point/questions ["q-104375"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-103795"] :question/problem "$$\nf(\\theta ,ϕ)=⟨\\text{_____},\\,ϕ\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ⟩\n$$\n\nThe vector-valued function $f(\\theta ,ϕ)$ parametrizes the surface defined in spherical polar coordinates as \n$\\rho =ϕ\\operatorname{cos}⁡\\theta .$\nWhat is the first component of $f?$" :question/worked-solution "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\nf=⟨x,\\,y,\\,z⟩=⟨\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\rho \\operatorname{cos}⁡ϕ⟩.\n$$\n\nFinally, substituting $\\rho =ϕ\\operatorname{cos}⁡\\theta ,$ we obtain\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨ϕ\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{cos}⁡\\theta \\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{cos}⁡\\theta \\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨ϕ{cos}^{2}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,ϕ\\operatorname{cos}⁡\\theta \\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the first component of $f$ is $ϕ{cos}^{2}⁡\\theta \\operatorname{sin}⁡ϕ.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8875"] :question/problem "Find a vector-valued function $\\mathbf{r}(u,v)$ that parametrizes the surface defined in Cartesian coordinates as $z=y^5-x^2.$" :question/worked-solution "A point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\n\\mathbf{r} = x \\, \\mathbf{i} + y \\, \\mathbf{j} + z \\, \\mathbf{k} = x \\, \\mathbf{i} + y \\, \\mathbf{j} + \\big(y^5-x^2\\big) \\, \\mathbf{k}.\n$$\n\nNow, setting $x=u$ and $y=v,$ we obtain the vector function that parametrizes the surface:\n\n$$\n\\mathbf{r}(u,v) = u \\, \\mathbf{i} + v \\, \\mathbf{j} + \\big(v^5-u^2\\big) \\, \\mathbf{k}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8876"] :question/problem "$$\n\\mathbf{r}(u,v) =\\big\\langle u, \\: v, \\:  \\text{_____} \\big\\rangle\n$$\n\nThe vector-valued function $\\mathbf{r}(u,v)$ parametrizes the surface defined in Cartesian coordinates as \n$x^2z-2y+z=6.$\n What is the third component of $\\mathbf{r}?$" :question/worked-solution "First, we write the equation of the surface in the form $z=f(x,y)\\mathbin{:}$\n\n$$\n\\begin{aligned}{x}^{2}z-2y+z & =6 \\\\ ({x}^{2}+1)z & =6+2y \\\\ z & =\\frac{2(y+3)}{{x}^{2}+1}\\end{aligned}\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\n\\mathbf{r} = \\big\\langle x, \\: y, \\: z \\big\\rangle = \\left\\langle x, \\: y, \\: \\dfrac{2(y+3)}{x^2+1} \\right\\rangle.\n$$\n\nFinally, setting $x=u$ and $y=v,$ we obtain the vector function that parametrizes the surface:\n\n$$\n\\mathbf{r}(u,v) =\\left\\langle u, \\: v, \\:  {\\color{black}\\dfrac{2(v+3)}{u^2+1}} \\right\\rangle\n$$\n\n \n\nTherefore, the third component of $\\mathbf{r}$ is ${\\color{black}\\dfrac{2(v+3)}{u^2+1}}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8877"] :question/problem "$$\n\\mathbf{f}(r,\\theta) =\\big\\langle r\\cos{\\theta}, \\: r\\sin{\\theta}, \\: \\text{_____} \\big\\rangle\n$$\n\nThe vector-valued function $\\mathbf{f}(r,\\theta)$ parametrizes the surface defined in cylindrical polar coordinates as \n${r^2}-4z^2=0$\nfor $z \\geq 0.$ What is the third component of $\\mathbf{f}?$" :question/worked-solution "First, we write the equation of the surface in the form $z=f(r,\\theta)\\mathbin{:}$\n\n$$\n\\begin{aligned}{r}^{2}-4{z}^{2} & =0 \\\\ 4{z}^{2} & ={r}^{2} \\\\ {z}^{2} & =\\frac{{r}^{2}}{4} \\\\ z & =\\frac{r}{2}\\end{aligned}\n$$\n\nWe disregard the negative solution since we are given that $z\\geq 0.$\n\nIf $(r, \\theta, z)$ are the cylindrical coordinates of a point and $(x,y,z)$ are the corresponding Cartesian coordinates of that point, then we have\n\n$$\nx = r\\cos\\theta, \\qquad\ny = r\\sin\\theta, \\qquad \nz = z.\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\n\\mathbf{f} = \\big\\langle x, \\: y, \\: z \\big\\rangle = \\big\\langle r\\cos\\theta, \\: r\\sin\\theta, \\: z \\big\\rangle.\n$$\n\nFinally, substituting $z= \\dfrac r2,$ we obtain\n\n$$\n\\mathbf{f}(r,\\theta) =\\left\\langle r\\cos{\\theta}, \\: r\\sin{\\theta}, \\: {\\color{black}  \\dfrac r2} \\right\\rangle.\n$$\n\nTherefore, the third component of $\\mathbf{f}$ is ${\\color{black}  \\dfrac r2}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8878"] :question/problem "$$\n\\mathbf{f}(\\theta,\\phi) = \\big\\langle \\text{_____}, \\: \\theta \\sin\\theta \\sin^2 \\phi, \\: \\theta \\sin\\phi \\cos\\phi \\big\\rangle\n$$\n\nThe vector-valued function $\\mathbf{f}(\\theta,\\phi)$ parametrizes the surface defined in spherical polar coordinates as \n$\\rho=\\theta \\sin{\\phi}.$\nWhat is the first component of $\\mathbf{f}?$" :question/worked-solution "If $(\\rho, \\theta, \\phi)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad\ny = \\rho\\sin\\theta\\sin\\phi, \\qquad \nz = \\rho\\cos\\phi\n$$\n\nNow, a point $(x,y,z)$ on our surface has the corresponding position vector given by\n\n$$\n\\mathbf{f} = \\big\\langle x, \\: y, \\: z \\big\\rangle = \\big\\langle \\rho\\cos\\theta\\sin\\phi, \\: \\rho\\sin\\theta\\sin\\phi, \\: \\rho\\cos\\phi \\big\\rangle.\n$$\n\nFinally, substituting $\\rho=\\theta \\sin{\\phi},$ we obtain\n\n$$\n\\begin{aligned}f(\\theta ,ϕ) & =⟨\\theta \\operatorname{sin}⁡ϕ\\cdot \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\theta \\operatorname{sin}⁡ϕ\\cdot \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\theta \\operatorname{sin}⁡ϕ\\cdot \\operatorname{cos}⁡ϕ⟩ \\\\  & =⟨\\theta \\operatorname{cos}⁡\\theta {sin}^{2}⁡ϕ,\\,\\theta \\operatorname{sin}⁡\\theta {sin}^{2}⁡ϕ,\\,\\theta \\operatorname{sin}⁡ϕ\\operatorname{cos}⁡ϕ⟩.\\end{aligned}\n$$\n\nTherefore, the first component of $\\mathbf{f}$ is ${\\color{black}\\theta \\cos\\theta \\sin^2 \\phi}.$" :db/ensure [:question/validate]}]
