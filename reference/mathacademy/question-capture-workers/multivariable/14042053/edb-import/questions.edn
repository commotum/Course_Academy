"a6880998-e36f-5eee-b5b8-21d635e9bf0c" :answer/type {:db/ident :answer.type/math} :answer/value "θ\\sin r" :db/id #edb/ref 17592186116509} {:answer/id #uuid "13f85ddf-da5e-5e0c-b680-a15f0ef137bf" :answer/type {:db/ident :answer.type/math} :answer/value "r\\tan θ" :db/id #edb/ref 17592186116510} {:answer/id #uuid "2e2ce324-c910-5777-86f5-8636cd07b499" :answer/type {:db/ident :answer.type/math} :answer/value "r\\cos θ" :db/id #edb/ref 17592186116511}] :answer-field/correct {:answer/id #uuid "8c9ce550-cd38-5439-b755-a164d5700ab4" :answer/type {:db/ident :answer.type/math} :answer/value "r\\sin θ" :db/id #edb/ref 17592186116507} :answer-field/id #uuid "591f0400-0bbb-5e3c-b610-29a09399e72c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186116506}] :question/id #uuid "abe0a7ed-085e-5846-929d-0cc0539c1f71" :question/math-academy-id "q-103789" :question/problem "$f(r, θ) = ⟨r\\cos θ, _____, 2r^{2}\\cos θ⟩$\n\nThe vector-valued function $f(r, θ)$ parametrizes the surface defined in cylindrical polar coordinates as\n$z = 2r^{2}\\cos θ$.\nWhat is the second component of $f$?"}] [{:db/id #edb/ref 17592186119992 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e6352a6-6505-517a-9a70-7c5701eda938" :knowledge-point/title "Finding a Parametrization of a Surface Defined in Spherical Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "97f03a9e-1967-5781-a28c-59b82f5ce0a5" :answer/type {:db/ident :answer.type/math} :answer/value "ϕ\\cos^{2} θ\\sin ϕ" :db/id #edb/ref 17592186116519} {:answer/id #uuid "b3ab1fb4-d72f-59fe-b69e-e0fe1d9373a1" :answer/type {:db/ident :answer.type/math} :answer/value "ϕ\\sin θ\\cos ϕ" :db/id #edb/ref 17592186116520} {:answer/id #uuid "13ade8c6-9c44-56b7-ba09-1e234048433a" :answer/type {:db/ident :answer.type/math} :answer/value "ϕ\\cos θ\\sin^{2} ϕ" :db/id #edb/ref 17592186116521} {:answer/id #uuid "3d034e32-f7b4-5fd7-86da-8301bbadea92" :answer/type {:d