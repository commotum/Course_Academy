.type/math} :answer/value "ϕ\\csc θ\\cos ϕ" :db/id #edb/ref 17592186116529}] :answer-field/correct {:answer/id #uuid "6eefb807-9b5e-5c45-9259-222ecd626ace" :answer/type {:db/ident :answer.type/math} :answer/value "ϕ\\csc θ\\cos ϕ" :db/id #edb/ref 17592186116529} :answer-field/id #uuid "8cf402b3-7c32-5942-821e-82c84e6c6af2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186116524}] :question/id #uuid "26d2eff3-e64e-54a4-8d22-1bebcd2af070" :question/math-academy-id "q-103796" :question/problem "$f(θ, ϕ) = ⟨ϕ\\cot θ\\sin ϕ, ϕ\\sin ϕ, _____⟩$\n\nThe vector-valued function $f(θ, ϕ)$ parametrizes the surface defined in spherical polar coordinates as\n$ϕ = ρ\\sin θ$.\nWhat is the third component of $f$?"}]}
