44c61-81fc-5f6e-9540-2d453d1ee392" 13194139535635 true] [17592186358625 1145 "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<0,$ we have\n\n$$\n\\begin{aligned}P(X\\le 2) & ={\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{1}{72}({x}^{3}+x)\\,\\text{d}x \\\\  & =\\frac{1}{72}{\\int }_{0}^{2}{x}^{3}+x\\,\\text{d}x \\\\  & =\\frac{1}{72}{[\\frac{1}{4}{x}^{4}+\\frac{1}{2}{x}^{2}]}_{0}^{2} \\\\  & =\\frac{1}{72}([\\frac{1}{4}(2)^{4}+\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(0)^{4}+\\frac{1}{2}(0)^{2}]) \\\\  & =\\frac{1}{72}(4+2-0) \\\\  & =\\frac{6}{72} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" 13194139535635 true] [17592186358626 1000 #edb/ref 17592186358627 13194139535635 true] [17592186358626 1000 #edb/ref 17592186358628 13194139535635 true] [17592186358626 1000 #edb/ref 17592186358629 13194139535635 true] [17592186358626 1000 #edb/ref 17592186358630 13194139535635 true] [17592186358626 1000 #edb/ref 17592186358631 13194139535635 true] [17592186358626 1040 #edb/ref 17592186045450 13194139535635 true] [17592186358626 1041 "selection" 13194139535635 true] [17592186358626 1104 #edb/ref 17592186358630 13194139535635 true] [17592186358626 1110 #uuid "6a180d26-32f9-591e-b639-4023629da8b4" 13194139535635 true] [17592186358627 1034 "\\frac{5}{12}" 13194139535635 true] [17592186358627 1103 #edb/ref 17592186045453 13194139535635 true] [17592186358627 1111 #uuid "13b04393-6f2e-54ec-bba9-24ae7358033c" 13194139535635 true] [17592186358628 1034 "\\frac{1}{24}" 13194139535635 true] [17592186358628 1103 #edb/ref 17592186045453 13194139535635 true] [17592186358628 1111 #uuid "bce8beee-d061-5a79-b626-a19557f61ad9" 13194139535635 true] [17592186358629 1034 "\\frac{1}{6}" 13194139535635 true] [17592186358629 1103 #edb/ref 17592186045453 13194139535635 true] [17592186358629 1111 #uuid "acdb899f-e9b7-587e-b43d-ecbee2a7147b" 1319