#{[{:db/id #edb/ref 17592186358618 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "818f70f1-87f8-56f3-8318-0534a260a0d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{27}" :db/id #edb/ref 17592186358620} {:answer/id #uuid "d4510a2c-352b-59e1-aa08-94174e5035cf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186358621} {:answer/id #uuid "4e93f498-27dc-57df-ae43-9dc10ce9ddb8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186358622} {:answer/id #uuid "33a2b757-dc1d-52a6-844d-0b215a5f46ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186358623} {:answer/id #uuid "353009d3-2d71-5cb2-9283-d491ccd2ef10" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{27}" :db/id #edb/ref 17592186358624}] :answer-field/correct {:answer/id #uuid "33a2b757-dc1d-52a6-844d-0b215a5f46ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186358623} :answer-field/id #uuid "191f4ca7-ca99-579a-a771-91d0ccebe3ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358619}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "75322c62-5512-5fa6-9e6b-c02ecb534869" :question/math-academy-id "q-158357" :question/problem "Compute $P(X>1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{27}(3{x}^{2}-{x}^{3}),\\, & 0\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>3,$ we have\n\n$$\n\\begin{aligned}P(X>1) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{4}{27}(3{x}^{2}-{x}^{3})\\,\\text{d}x \\\\  & =\\frac{4}{27}{\\int }_{1}^{3}3{x}^{2}-{x}^{3}\\,\\text{d}x \\\\  & =\\frac{4}{27}{[{x}^{3}-\\frac{1}{4}{x}^{4}]}_{1}^{3} \\\\  & =\\frac{4}{27}([(3)^{3}-\\frac{1}{4}(3)^{4}]-[(1)^{3}-\\frac{1}{4}(1)^{4}]) \\\\  & =\\frac{4}{27}(27-\\frac{81}{4}-1+\\frac{1}{4}) \\\\  & =\\frac{4}{27}\\cdot 6 \\\\  & =\\frac{8}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358625 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "13b04393-6f2e-54ec-bba9-24ae7358033c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186358627} {:answer/id #uuid "bce8beee-d061-5a79-b626-a19557f61ad9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{24}" :db/id #edb/ref 17592186358628} {:answer/id #uuid "acdb899f-e9b7-587e-b43d-ecbee2a7147b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186358629} {:answer/id #uuid "407ab90d-c95a-59e0-bf1a-0a5be1cdf54a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186358630} {:answer/id #uuid "bde294d3-e674-5d71-8339-59e4454222d3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186358631}] :answer-field/correct {:answer/id #uuid "407ab90d-c95a-59e0-bf1a-0a5be1cdf54a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{12}" :db/id #edb/ref 17592186358630} :answer-field/id #uuid "6a180d26-32f9-591e-b639-4023629da8b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358626}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "83444c61-81fc-5f6e-9540-2d453d1ee392" :question/math-academy-id "q-158363" :question/problem "Compute $P(X\\le 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{72}({x}^{3}+x),\\, & 0\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<0,$ we have\n\n$$\n\\begin{aligned}P(X\\le 2) & ={\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{1}{72}({x}^{3}+x)\\,\\text{d}x \\\\  & =\\frac{1}{72}{\\int }_{0}^{2}{x}^{3}+x\\,\\text{d}x \\\\  & =\\frac{1}{72}{[\\frac{1}{4}{x}^{4}+\\frac{1}{2}{x}^{2}]}_{0}^{2} \\\\  & =\\frac{1}{72}([\\frac{1}{4}(2)^{4}+\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(0)^{4}+\\frac{1}{2}(0)^{2}]) \\\\  & =\\frac{1}{72}(4+2-0) \\\\  & =\\frac{6}{72} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358632 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "faa994cd-c3ee-59fd-98c3-f607a4f7ecc8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186358634} {:answer/id #uuid "7fa1b390-0011-5d90-99e4-5a8c57f67b6a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186358635} {:answer/id #uuid "333f3ce2-7a2e-5fdf-8545-f859df3ff63b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{32}" :db/id #edb/ref 17592186358636} {:answer/id #uuid "9544363f-3fe5-512e-a6af-a408eacd137d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{32}" :db/id #edb/ref 17592186358637} {:answer/id #uuid "a65c8e6b-c2ff-57e3-a87b-b088bca2c380" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186358638}] :answer-field/correct {:answer/id #uuid "333f3ce2-7a2e-5fdf-8545-f859df3ff63b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{32}" :db/id #edb/ref 17592186358636} :answer-field/id #uuid "8b2f1b2f-0db9-5626-afab-4722db8de6c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358633}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "336b0a0c-24e6-5e16-b273-0851177f81e6" :question/math-academy-id "q-158416" :question/problem "Compute $P(0\\le X<1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{8}{x}^{3},\\, & 0\\le x<2, \\\\ \\frac{1}{5}x & 2\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0\\le X<1) & ={\\int }_{0}^{1}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{8}{x}^{3}\\,\\text{d}x \\\\  & ={[\\frac{1}{32}{x}^{4}]}_{0}^{1} \\\\  & =\\frac{1}{32}({1}^{4}-{0}^{4}) \\\\  & =\\frac{1}{32}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358639 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "68b4c9cd-0ae5-595c-8e4c-c12dac1ad048" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186358641} {:answer/id #uuid "a31f7559-3f4c-59ca-9d5b-aef4a1a61d73" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186358642} {:answer/id #uuid "91fc9e55-03ae-50bb-9fef-db3eda039341" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186358643} {:answer/id #uuid "856c31d7-716e-52fb-afb3-eacc50cd1310" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186358644} {:answer/id #uuid "6c277c89-a6c2-59f9-801b-e0590201f757" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186358645}] :answer-field/correct {:answer/id #uuid "91fc9e55-03ae-50bb-9fef-db3eda039341" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186358643} :answer-field/id #uuid "98facf91-8d68-503b-81e1-14bb2d670c98" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358640}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "434b555f-b72f-545e-b793-9c987713b2d5" :question/math-academy-id "q-158418" :question/problem "Compute $P(2\\le X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{3}({x}^{3}-x),\\, & 1\\le x<2, \\\\ \\frac{1}{6}(x-1) & 2\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2\\le X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{6}(x-1)\\,\\text{d}x \\\\  & =\\frac{1}{6}{[\\frac{1}{2}{x}^{2}-x]}_{2}^{3} \\\\  & =\\frac{1}{6}([\\frac{1}{2}(3)^{2}-(3)]-[\\frac{1}{2}(2)^{2}-2]) \\\\  & =\\frac{1}{6}(\\frac{9}{2}-3-2+2) \\\\  & =\\frac{1}{6}(\\frac{3}{2}) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186358646 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "049c43f6-471c-5c04-9889-f4970d56a3b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186358648} {:answer/id #uuid "1397b84a-d055-5390-8efc-4f19a7a7706d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186358649} {:answer/id #uuid "362af040-6b89-5743-abeb-304870701b60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186358650} {:answer/id #uuid "030e25f4-e12e-5709-8844-352fb4aba974" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186358651} {:answer/id #uuid "4247caf2-e339-5a84-9e79-8ef72afba5df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186358652}] :answer-field/correct {:answer/id #uuid "049c43f6-471c-5c04-9889-f4970d56a3b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186358648} :answer-field/id #uuid "23784f27-0645-573b-9b41-baf817d386dd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358647}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6484a3cf-215c-5c2f-b58a-685bc2278093" :question/math-academy-id "q-158431" :question/problem "Compute $P(2<X<4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{20}\\sqrt{x},\\, & 0\\le x\\le 1, \\\\ \\frac{1}{20}({x}^{2}-1) & 1<x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X<4) & ={\\int }_{2}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{4}\\frac{1}{20}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{20}{[\\frac{1}{3}{x}^{3}-x]}_{2}^{4} \\\\  & =\\frac{1}{20}([\\frac{1}{3}(4)^{3}-(4)]-[\\frac{1}{3}(2)^{3}-(2)]) \\\\  & =\\frac{1}{20}(\\frac{64}{3}-4-\\frac{8}{3}+2) \\\\  & =\\frac{1}{20}(\\frac{50}{3}) \\\\  & =\\frac{5}{6}.\\end{aligned}\n$$"}]}
