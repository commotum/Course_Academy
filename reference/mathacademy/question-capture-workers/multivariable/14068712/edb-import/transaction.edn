on/id #uuid "75322c62-5512-5fa6-9e6b-c02ecb534869" :question/math-academy-id "q-158357" :question/problem "Compute $P(X>1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{27}(3{x}^{2}-{x}^{3}),\\, & 0\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>3,$ we have\n\n$$\n\\begin{aligned}P(X>1) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{4}{27}(3{x}^{2}-{x}^{3})\\,\\text{d}x \\\\  & =\\frac{4}{27}{\\int }_{1}^{3}3{x}^{2}-{x}^{3}\\,\\text{d}x \\\\  & =\\frac{4}{27}{[{x}^{3}-\\frac{1}{4}{x}^{4}]}_{1}^{3} \\\\  & =\\frac{4}{27}([(3)^{3}-\\frac{1}{4}(3)^{4}]-[(1)^{3}-\\frac{1}{4}(1)^{4}]) \\\\  & =\\frac{4}{27}(27-\\frac{81}{4}-1+\\frac{1}{4}) \\\\  & =\\frac{4}{27}\\cdot 6 \\\\  & =\\frac{8}{9}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158357/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c"] :knowledge-point/questions ["q-158357"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158363/selection/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" :answer/id #uuid "407ab90d-c95a-59e0-bf1a-0a5be1cdf54a" :answer/type :answer.type/math :answer/value "\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "q-158363/selection/1512fbc4ba9ac54935748bd30a3df0f8adcca19968544e9199178dd45a802f05" :answer/id #uuid "13b04393-6f2e-54ec-bba9-24ae7358033c" :answer/type :answer.type/math :answer/value "\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "q-158363/selection/393522ee4ded7288062e6072c329c38ecb06c9de712f11faf938346737b8d6d5" :answer/id #uuid "bce8beee-d061-5a79-b626-a19557f61ad9" :answer/type :answer.type/math :answer/value "\\frac{1}{24}" :db/ensure [:answer/validate]} {:db/id "q-158363/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "acdb899f-e9b7-587e-b43d-ecbee2a7147b" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-158363/selection/cfb72468d7473f9de7c9ab610be7ad254785b32f2f1aaa989c4331093ae0a062" :answer/id #uuid "bde294d3-e674-5d71-8339-59e4454222d3" :answer/type :answer.type/math :answer/value "\\frac{5}{24}" :db/ensure [:answer/validate]} {:db/id "q-158363/selection" :answer-field/id #uuid "6a180d26-32f9-591e-b639-4023629da8b4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158363/selection/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" :answer-field/choices ["q-158363/selection/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" "q-158363/selection/1512fbc4ba9ac54935748bd30a3df0f8adcca19968544e9199178dd45a802f05" "q-158363/selection/393522ee4ded7288062e6072c329c38ecb06c9de712f11faf938346737b8d6d5" "q-158363/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" "q-158363/selection/cfb72468d7473f9de7c9ab610be7ad254785b32f2f1aaa989c4331093ae0a062"] :db/ensure [:answer-field/validate]} {:db/id "q-158363" :question/id #uuid "83444c61-81fc-5f6e-9540-2d453d1ee392" :question/math-academy-id "q-158363" :question/problem "Compute $P(X\\le 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{72}({x}^{3}+x),\\, & 0\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<0,$ we have\n\n$$\n\\begin{aligned}P(X\\le 2) & ={\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}\\frac{1}{72}({x}^{3}+x)\\,\\text{d}x \\\\  & =\\frac{1}{72}{\\int }_{0}^{2}{x}^{3}+x\\,\\text{d}x \\\\  & =\\frac{1}{72}{[\\frac{1}{4}{x}^{4}+\\frac{1}{2}{x}^{2}]}_{0}^{2} \\\\  & =\\frac{1}{72}([\\frac{1}{4}(2)^{4}+\\frac{1}{2}(2)^{2}]-[\\frac{1}{4}(0)^{4}+\\frac{1}{2}(0)^{2}]) \\\\  & =\\frac{1}{72}(4+2-0) \\\\  & =\\frac{6}{72} \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158363/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c"] :knowledge-point/questions ["q-158363"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158416/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" :answer/id #uuid "7fa1b390-0011-5d90-99e4-5a8c57f67b6a" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "q-158416/selection/dbc9f34791df2cfa1ba97f4fcb508d6756c3df39f1458e13c2498bf0264679fe" :answer/id #uuid "333f3ce2-7a2e-5fdf-8545-f859df3ff63b" :answer/type :answer.type/math :answer/value "\\frac{1}{32}" :db/ensure [:answer/validate]} {:db/id "q-158416/selection/f2288f9352f7ca2a51938247a89477aea196296ae7b20690ce35ebb30dfe5331" :answer/id #uuid "a65c8e6b-c2ff-57e3-a87b-b088bca2c380" :answer/type :answer.type/math :answer/value "\\frac{1}{16}" :db/ensure [:answer/validate]} {:db/id "q-158416/selection/7ca406ed6690410e3c85c046a8fc266540a56cf4545cf1cbb6354f4fdf108590" :answer/id #uuid "faa994cd-c3ee-59fd-98c3-f607a4f7ecc8" :answer/type :answer.type/math :answer/value "\\frac{5}{16}" :db/ensure [:answer/validate]} {:db/id "q-158416/selection/e3f24454ad345b52c3bd83e065c3234b9827468595eecee3484c0f10261bb218" :answer/id #uuid "9544363f-3fe5-512e-a6af-a408eacd137d" :answer/type :answer.type/math :answer/value "\\frac{3}{32}" :db/ensure [:answer/validate]} {:db/id "q-158416/selection" :answer-field/id #uuid "8b2f1b2f-0db9-5626-afab-4722db8de6c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158416/selection/dbc9f34791df2cfa1ba97f4fcb508d6756c3df39f1458e13c2498bf0264679fe" :answer-field/choices ["q-158416/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" "q-158416/selection/dbc9f34791df2cfa1ba97f4fcb508d6756c3df39f1458e13c2498bf0264679fe" "q-158416/selection/f2288f9352f7ca2a51938247a89477aea196296ae7b20690ce35ebb30dfe5331" "q-158416/selection/7ca406ed6690410e3c85c046a8fc266540a56cf4545cf1cbb6354f4fdf108590" "q-158416/selection/e3f24454ad345b52c3bd83e065c3234b9827468595eecee3484c0f10261bb218"] :db/ensure [:answer-field/validate]} {:db/id "q-158416" :question/id #uuid "336b0a0c-24e6-5e16-b273-0851177f81e6" :question/math-academy-id "q-158416" :question/problem "Compute $P(0\\le X<1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{8}{x}^{3},\\, & 0\\le x<2, \\\\ \\frac{1}{5}x & 2\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0\\le X<1) & ={\\int }_{0}^{1}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{8}{x}^{3}\\,\\text{d}x \\\\  & ={[\\frac{1}{32}{x}^{4}]}_{0}^{1} \\\\  & =\\frac{1}{32}({1}^{4}-{0}^{4}) \\\\  & =\\frac{1}{32}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158416/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3"] :knowledge-point/questions ["q-158416"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158418/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "6c277c89-a6c2-59f9-801b-e0590201f757" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-158418/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "856c31d7-716e-52fb-afb3-eacc50cd1310" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-158418/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "91fc9e55-03ae-50bb-9fef-db3eda039341" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-158418/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "a31f7559-3f4c-59ca-9d5b-aef4a1a61d73" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-158418/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer/id #uuid "68b4c9cd-0ae5-595c-8e4c-c12dac1ad048" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-158418/selection" :answer-field/id #uuid "98facf91-8d68-503b-81e1-14bb2d670c98" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158418/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-158418/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-158418/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" "q-158418/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-158418/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-158418/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a"] :db/ensure [:answer-field/validate]} {:db/id "q-158418" :question/id #uuid "434b555f-b72f-545e-b793-9c987713b2d5" :question/math-academy-id "q-158418" :question/problem "Compute $P(2\\le X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{3}({x}^{3}-x),\\, & 1\\le x<2, \\\\ \\frac{1}{6}(x-1) & 2\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2\\le X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{6}(x-1)\\,\\text{d}x \\\\  & =\\frac{1}{6}{[\\frac{1}{2}{x}^{2}-x]}_{2}^{3} \\\\  & =\\frac{1}{6}([\\frac{1}{2}(3)^{2}-(3)]-[\\frac{1}{2}(2)^{2}-2]) \\\\  & =\\frac{1}{6}(\\frac{9}{2}-3-2+2) \\\\  & =\\frac{1}{6}(\\frac{3}{2}) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158418/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3"] :knowledge-point/questions ["q-158418"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158431/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "1397b84a-d055-5390-8efc-4f19a7a7706d" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-158431/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "030e25f4-e12e-5709-8844-352fb4aba974" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-158431/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "362af040-6b89-5743-abeb-304870701b60" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-158431/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer/id #uuid "049c43f6-471c-5c04-9889-f4970d56a3b3" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-158431/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "4247caf2-e339-5a84-9e79-8ef72afba5df" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-158431/selection" :answer-field/id #uuid "23784f27-0645-573b-9b41-baf817d386dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158431/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer-field/choices ["q-158431/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-158431/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" "q-158431/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-158431/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" "q-158431/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-158431" :question/id #uuid "6484a3cf-215c-5c2f-b58a-685bc2278093" :question/math-academy-id "q-158431" :question/problem "Compute $P(2<X<4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{20}\\sqrt{x},\\, & 0\\le x\\le 1, \\\\ \\frac{1}{20}({x}^{2}-1) & 1<x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X<4) & ={\\int }_{2}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{4}\\frac{1}{20}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{20}{[\\frac{1}{3}{x}^{3}-x]}_{2}^{4} \\\\  & =\\frac{1}{20}([\\frac{1}{3}(4)^{3}-(4)]-[\\frac{1}{3}(2)^{3}-(2)]) \\\\  & =\\frac{1}{20}(\\frac{64}{3}-4-\\frac{8}{3}+2) \\\\  & =\\frac{1}{20}(\\frac{50}{3}) \\\\  & =\\frac{5}{6}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158431/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3"] :knowledge-point/questions ["q-158431"] :db/ensure [:knowledge-point/validate]}]
