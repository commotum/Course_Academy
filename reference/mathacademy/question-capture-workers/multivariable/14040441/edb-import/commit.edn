6045464 13194139534758 true] [17592186308121 1100 "The affine transformation $T$ is defined as\n\n$$\nx=2u-3v-4,\\,y=2u-4v-5.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+ay+b,\\,v=x-y+c,\n$$\n\nwhat is the value of $a+b+c?$" 13194139534758 true] [17592186308121 1113 #uuid "d9f195c0-9862-5d56-a2f8-0cd7f911970a" 13194139534758 true] [17592186308121 1145 "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-3v-4 \\\\ 2u-4v-5\\end{aligned}] \\\\  & =[\\begin{aligned}2u-3v \\\\ 2u-4v\\end{aligned}]+[\\begin{aligned}-4 \\\\ -5\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -3 \\\\ 2 & -4\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-4 \\\\ -5\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-4\\cdot 2-(-3)\\cdot 2}[\\begin{aligned}-4 & 3 \\\\ -2 & 2\\end{aligned}] \\\\  & =\\frac{1}{-2}[\\begin{aligned}-4 & 3 \\\\ -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}-4 \\\\ -5\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{aligned}][\\begin{aligned}x+4 \\\\ y+5\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (x+4)+(-\\frac{3}{2})\\cdot (y+5) \\\\ 1\\cdot (x+4)+(-1)\\cdot (y+5)\\end{aligned}] \\\\  & =[\\begin{aligned}2x-\\frac{3}{2}y+\\frac{1}{2} \\\\ x-y-1\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+(-\\frac{3}{2})y+\\frac{1}{2},\\,v=x-y+(-1).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-\\frac{3}{2}+\\frac{1}{2}+(-1)=-2.\n$$" 13194139534758 true] [17592186308122 1000 #edb/ref 17592186308123 13194139534758 true] [17592186308122 1000 #edb/ref 17592186308124 13194139534758 true] [17592186308122 1000 #edb/ref 17592186308125 13194139534758 true] [17592186308122 1000 #edb/ref 17592186308126 13194139534758 true] [17592186308122 1000 #edb/ref 17592186308127 13194139534758 true] [17592186308122 1040 #edb/ref 17592186045450 13194139534758 true] [17592186308122 1041 "selection" 13194139534758 true] [17592186308122 1104 #edb/ref 17592186308127 13194139534758 true] [17592186308122 1110 #uuid "2203eddd-9493-50de-8490-c775c45d2eda" 13194139534758 true] [17592186308123 1034 "-5" 13194139534758 true] [17592186308123 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308123 1111 #uuid "20d1c890-5088-5604-9749-8fec731b72ec" 13194139534758 true] [17592186308124 1034 "1" 13194139534758 true] [17592186308124 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308124 1111 #uuid "c335e2ba-f6b0-5f9e-af2a-163782e0d2e9" 13194139534758 true] [17592186308125 1034 "-3" 13194139534758 true] [17592186308125 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308125 1111 #uuid "03cea75a-2b48-533d-8a09-b88157e6dee2" 13194139534758 true] [17592186308126 1034 "5" 13194139534758 true] [17592186308126 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308126 1111 #uuid "54c40a29-cda9-5187-ab83-994972d8a532" 13194139534758 true] [17592186308127 1034 "-2" 13194139534758 true] [17592186308127 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308127 1111 #uuid "e81d8237-12c8-573f-a3f3-41b61f0f167b" 13194139534758 true] [17592186308128 1017 #edb/ref 17592186308129 13194139534758 true] [17592186308128 1089 "q-124314" 13194139534758 true] [17592186308128 1091 #edb/ref 17592186045464 13194139534758 true] [17592186308128 1100 "The affine transformation $T$ is defined as\n\n$$\nx=2u-3v+2,\\,y=6v-3u-4.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+y+a,\\,v=x+by+c,\n$$\n\nwhat is the value of $a+b+c?$" 13194139534758 true] [17592186308128 1113 #uuid "a16fabd1-386c-542d-8938-52c582128a39" 13194139534758 true] [17592186308128 1145 "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-3v+2 \\\\ 6v-3u-4\\end{aligned}] \\\\  & =[\\begin{aligned}2u-3v \\\\ -3u+6v\\end{aligned}]+[\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -3 \\\\ -3 & 6\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ -4\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 2-(-3)\\cdot (-3)}[\\begin{aligned}6 & 3 \\\\ 3 & 2\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ -4\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}][\\begin{aligned}x-2 \\\\ y+4\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (x-2)+1\\cdot (y+4) \\\\ 1\\cdot (x-2)+(\\frac{2}{3})\\cdot (y+4)\\end{aligned}] \\\\  & =[\\begin{aligned}2x+y \\\\ x+\\frac{2}{3}y+\\frac{2}{3}\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+y+0,\\,v=x+\\frac{2}{3}y+\\frac{2}{3}.\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+\\frac{2}{3}+\\frac{2}{3}=\\frac{4}{3}.\n$$" 13194139534758 true] [17592186308129 1000 #edb/ref 17592186308130 13194139534758 true] [17592186308129 1000 #edb/ref 17592186308131 13194139534758 true] [17592186308129 1000 #edb/ref 17592186308132 13194139534758 true] [17592186308129 1000 #edb/ref 17592186308133 13194139534758 true] [17592186308129 1000 #edb/ref 17592186308134 13194139534758 true] [17592186308129 1040 #edb/ref 17592186045450 13194139534758 true] [17592186308129 1041 "selection" 13194139534758 true] [17592186308129 1104 #edb/ref 17592186308131 13194139534758 true] [17592186308129 1110 #uuid "65896239-c279-5eea-bd7b-fecc4e226ab9" 13194139534758 true] [17592186308130 1034 "\\frac{13}{3}" 13194139534758 true] [17592186308130 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308130 1111 #uuid "722c53d5-36ff-506d-b554-2ddf30ae1afc" 13194139534758 true] [17592186308131 1034 "\\frac{4}{3}" 13194139534758 true] [17592186308131 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308131 1111 #uuid "f1500fc0-c954-50af-91a8-19bb95eee5c6" 13194139534758 true] [17592186308132 1034 "\\frac{5}{3}" 13194139534758 true] [17592186308132 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308132 1111 #uuid "1c2a9948-ac27-5356-ad60-dd3e7defa7a9" 13194139534758 true] [17592186308133 1034 "\\frac{7}{3}" 13194139534758 true] [17592186308133 1103 #edb/ref 17592186045453 13194139534758 true] [17592186308133 1111 #uuid 