& -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-7 & -2 \\\\ -4 & -1\\end{aligned}][\\begin{aligned}2 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}-7 & -2 \\\\ -4 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-4 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}-7 & -2 \\\\ -4 & -1\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}4 \\\\ 3\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-7+(-1)+3=-5.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124228" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124228" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124228" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-12"] ["math" "-15"] ["math" "-3"] ["math" "-5"] ["math" "-8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124228" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-5"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124241" "field" nil "attribute" "question/problem" "value" "The matrix form of the affine transformation $T$ is given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}8 & 9 \\\\ 4 & 5\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}6 \\\\ 2\\end{aligned}].\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}a & b \\\\ -1 & c\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}-3 \\\\ 2\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124241" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{[\\begin{aligned}8 & 9 \\\\ 4 & 5\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}6 \\\\ 2\\end{aligned}]}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{5\\cdot 8-9\\cdot 4}[\\begin{aligned}5 & -9 \\\\ -4 & 8\\end{aligned}] \\\\  & =\\frac{1}{4}[\\begin{aligned}5 & -9 \\\\ -4 & 8\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}6 \\\\ 2\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}6 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{5}{4} & -\\frac{9}{4} \\\\ -1 & 2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}-3 \\\\ 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=\\frac{5}{4}+(-\\frac{9}{4})+2=1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124241" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124241" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124241" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-3"] ["math" "0"] ["math" "1"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124241" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124249" "field" nil "attribute" "question/problem" "value" "The matrix form of the affine transformation $T$ is given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}7 & -5 \\\\ -4 & 3\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}4 \\\\ -3\\end{aligned}].\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}a & 5 \\\\ b & 7\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}c \\\\ 5\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124249" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{[\\begin{aligned}7 & -5 \\\\ -4 & 3\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}4 \\\\ -3\\end{aligned}]}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{3\\cdot 7-(-5)\\cdot (4)}[\\begin{aligned}3 & 5 \\\\ 4 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 \\\\ 4 & 7\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}3 & 5 \\\\ 4 & 7\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}4 \\\\ -3\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}3 & 5 \\\\ 4 & 7\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}3 & 5 \\\\ 4 & 7\\end{aligned}][\\begin{aligned}4 \\\\ -3\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 \\\\ 4 & 7\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-3 \\\\ -5\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 5 \\\\ 4 & 7\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}3 \\\\ 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=3+4+3=10.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124249" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124249" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124249" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4"] ["math" "0"] ["math" "10"] ["math" "4"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124249" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124233" "field" nil "attribute" "question/problem" "value" "The matrix form of the affine transformation $T$ is given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-4 & 2 \\\\ -5 & 2\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}0 \\\\ -1\\end{aligned}].\n$$\n\nFind $a+b+c,$ given that the matrix form of the inverse transformation ${T}^{-1}$ is given by\n\n$$\n[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}a & -1 \\\\ b & -2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}-1 \\\\ c\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124233" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nThe matrix form of $T$ gives us the following information:\n\n$$\n{{[\\begin{aligned}-4 & 2 \\\\ -5 & 2\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}0 \\\\ -1\\end{aligned}]}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot (-4)-2\\cdot (-5)}[\\begin{aligned}2 & -2 \\\\ 5 & -4\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}2 & -2 \\\\ 5 & -4\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ \\frac{5}{2} & -2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}1 & -1 \\\\ \\frac{5}{2} & -2\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}0 \\\\ -1\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}1 & -1 \\\\ \\frac{5}{2} & -2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}1 & -1 \\\\ \\frac{5}{2} & -2\\end{aligned}][\\begin{aligned}0 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ \\frac{5}{2} & -2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}1 \\\\ 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -1 \\\\ \\frac{5}{2} & -2\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}-1 \\\\ -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+\\frac{5}{2}+(-2)=\\frac{3}{2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124233" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124233" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124233" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{2}"] ["math" "-\\frac{5}{2}"] ["math" "2"] ["math" "3"] ["math" "\\frac{3}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124233" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124276" "field" nil "attribute" "question/problem" "value" "The affine transformation $T$ is defined as\n\n$$\nx=4u+7v+2,\\,y=u+2v+1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-7y+3,\\,v=by+cx-2,\n$$\n\nwhat is the value of $a+b+c?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124276" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}4u+7v+2 \\\\ u+2v+1\\end{aligned}] \\\\  & =[\\begin{aligned}4u+7v \\\\ u+2v\\end{aligned}]+[\\begin{aligned}2 \\\\ 1\\end{aligned}] \\\\  & ={{[\\begin{aligned}4 & 7 \\\\ 1 & 2\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ 1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{2\\cdot 4-7\\cdot 1}[\\begin{aligned}2 & -7 \\\\ -1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -7 \\\\ -1 & 4\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}2 & -7 \\\\ -1 & 4\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ 1\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}2 & -7 \\\\ -1 & 4\\end{aligned}][\\begin{aligned}x-2 \\\\ y-1\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (x-2)+(-7)\\cdot (y-1) \\\\ (-1)\\cdot (x-2)+4\\cdot (y-1)\\end{aligned}] \\\\  & =[\\begin{aligned}2x-7y+3 \\\\ 4y-x-2\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x-7y+3,\\,v=4y+(-1)x-2.\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+4+(-1)=5.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124276" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124276" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124276" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "3"] ["math" "5"] ["math" "7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124276" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124280" "field" nil "attribute" "question/problem" "value" "The affine transformation $T$ is defined as\n\n$$\nx=2-u-v,\\,y=3u+4v-1.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=7+ax-y,\\,v=bx+y+c,\n$$\n\nwhat is the value of $a+b+c?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124280" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2-u-v \\\\ 3u+4v-1\\end{aligned}] \\\\  & =[\\begin{aligned}-u-v \\\\ 3u+4v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & ={{[\\begin{aligned}-1 & -1 \\\\ 3 & 4\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ -1\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot (-1)-(-1)\\cdot 3}[\\begin{aligned}4 & 1 \\\\ -3 & -1\\end{aligned}] \\\\  & =\\frac{1}{-1}[\\begin{aligned}4 & 1 \\\\ -3 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ -1\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}-4 & -1 \\\\ 3 & 1\\end{aligned}][\\begin{aligned}x-2 \\\\ y+1\\end{aligned}] \\\\  & =[\\begin{aligned}-4\\cdot (x-2)+(-1)\\cdot (y+1) \\\\ 3\\cdot (x-2)+1\\cdot (y+1)\\end{aligned}] \\\\  & =[\\begin{aligned}7-4x-y \\\\ 3x+y-5\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=7+(-4)x-y,\\,v=3x+y+(-5).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-4+3+(-5)=-6.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124280" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124280" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124280" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-4"] ["math" "-6"] ["math" "2"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124280" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124317" "field" nil "attribute" "question/problem" "value" "The affine transformation $T$ is defined as\n\n$$\nx=5v-7u+3,\\,y=7v-10u+5.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=ax-5y+4,\\,v=bx+cy+5,\n$$\n\nwhat is the value of $a+b+c?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124317" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}5v-7u+3 \\\\ 7v-10u+5\\end{aligned}] \\\\  & =[\\begin{aligned}-7u+5v \\\\ -10u+7v\\end{aligned}]+[\\begin{aligned}3 \\\\ 5\\end{aligned}] \\\\  & ={{[\\begin{aligned}-7 & 5 \\\\ -10 & 7\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}3 \\\\ 5\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{7\\cdot (-7)-5\\cdot (-10)}[\\begin{aligned}7 & -5 \\\\ 10 & -7\\end{aligned}] \\\\  & =[\\begin{aligned}7 & -5 \\\\ 10 & -7\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}7 & -5 \\\\ 10 & -7\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}3 \\\\ 5\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}7 & -5 \\\\ 10 & -7\\end{aligned}][\\begin{aligned}x-3 \\\\ y-5\\end{aligned}] \\\\  & =[\\begin{aligned}7\\cdot (x-3)+(-5)\\cdot (y-5) \\\\ 10\\cdot (x-3)+(-7)\\cdot (y-5)\\end{aligned}] \\\\  & =[\\begin{aligned}7x-5y+4 \\\\ 10x-7y+5\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=7x-5y+4,\\,v=10x+(-7)y+5.\n$$\n\nTherefore, we have\n\n$$\na+b+c=7+10+(-7)=10.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124317" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124317" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124317" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "1"] ["math" "10"] ["math" "5"] ["math" "7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124317" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124312" "field" nil "attribute" "question/problem" "value" "The affine transformation $T$ is defined as\n\n$$\nx=2u-3v-4,\\,y=2u-4v-5.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+ay+b,\\,v=x-y+c,\n$$\n\nwhat is the value of $a+b+c?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124312" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-3v-4 \\\\ 2u-4v-5\\end{aligned}] \\\\  & =[\\begin{aligned}2u-3v \\\\ 2u-4v\\end{aligned}]+[\\begin{aligned}-4 \\\\ -5\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -3 \\\\ 2 & -4\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-4 \\\\ -5\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-4\\cdot 2-(-3)\\cdot 2}[\\begin{aligned}-4 & 3 \\\\ -2 & 2\\end{aligned}] \\\\  & =\\frac{1}{-2}[\\begin{aligned}-4 & 3 \\\\ -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}-4 \\\\ -5\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}2 & -\\frac{3}{2} \\\\ 1 & -1\\end{aligned}][\\begin{aligned}x+4 \\\\ y+5\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (x+4)+(-\\frac{3}{2})\\cdot (y+5) \\\\ 1\\cdot (x+4)+(-1)\\cdot (y+5)\\end{aligned}] \\\\  & =[\\begin{aligned}2x-\\frac{3}{2}y+\\frac{1}{2} \\\\ x-y-1\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+(-\\frac{3}{2})y+\\frac{1}{2},\\,v=x-y+(-1).\n$$\n\nTherefore, we have\n\n$$\na+b+c=-\\frac{3}{2}+\\frac{1}{2}+(-1)=-2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124312" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124312" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124312" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-3"] ["math" "-5"] ["math" "1"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124312" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124314" "field" nil "attribute" "question/problem" "value" "The affine transformation $T$ is defined as\n\n$$\nx=2u-3v+2,\\,y=6v-3u-4.\n$$\n\nGiven that the inverse transformation ${T}^{-1}$ of $T$ is\n\n$$\nu=2x+y+a,\\,v=x+by+c,\n$$\n\nwhat is the value of $a+b+c?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124314" "field" nil "attribute" "question/worked-solution" "value" "An affine transformation $T:{R}^{2}\\to {R}^{2}$ is a function of the form\n\n$$\nx=Au+b,\n$$\n\nwhere $x,u,$ and $b$ are column vectors in ${R}^{2},$ and $A$ is a $2\\times 2$ matrix.\n\nReversing the action of $T,$ we get\n\n$$\n\\begin{aligned}Au+b & =x \\\\ Au & =x-b \\\\ u & ={A}^{-1}(x-b).\\end{aligned}\n$$\n\nSo, writing our transformation in matrix form, we have\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}2u-3v+2 \\\\ 6v-3u-4\\end{aligned}] \\\\  & =[\\begin{aligned}2u-3v \\\\ -3u+6v\\end{aligned}]+[\\begin{aligned}2 \\\\ -4\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -3 \\\\ -3 & 6\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}2 \\\\ -4\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot 2-(-3)\\cdot (-3)}[\\begin{aligned}6 & 3 \\\\ 3 & 2\\end{aligned}] \\\\  & =\\frac{1}{3}[\\begin{aligned}6 & 3 \\\\ 3 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}2 \\\\ -4\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}2 & 1 \\\\ 1 & \\frac{2}{3}\\end{aligned}][\\begin{aligned}x-2 \\\\ y+4\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (x-2)+1\\cdot (y+4) \\\\ 1\\cdot (x-2)+(\\frac{2}{3})\\cdot (y+4)\\end{aligned}] \\\\  & =[\\begin{aligned}2x+y \\\\ x+\\frac{2}{3}y+\\frac{2}{3}\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+y+0,\\,v=x+\\frac{2}{3}y+\\frac{2}{3}.\n$$\n\nTherefore, we have\n\n$$\na+b+c=0+\\frac{2}{3}+\\frac{2}{3}=\\frac{4}{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124314" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-124314" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124314" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{10}{3}"] ["math" "\\frac{13}{3}"] ["math" "\\frac{4}{3}"] ["math" "\\frac{5}{3}"] ["math" "\\frac{7}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-124314" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162151" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/assets/3f8c1c9854ec54dd3caf4487328d3f3c35f2d69680a8fd1c13d28125dac77d03.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-1 \\\\ 1\\end{aligned}].\n$$\n\n \nWhat would be the image of the square shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162151" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-2 & 6 \\\\ 1 & -3\\end{aligned}| \\\\  & =(-2)\\cdot (-3)-6\\cdot 1 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible and the image of the square under the action of $T$ is a line segment." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162151" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-162151" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162151" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "A line segment"] ["text" "A parallelepiped"] ["text" "A parallelogram"] ["text" "A point on the plane"] ["text" "A triangle"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162151" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "A line segment"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162214" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/assets/00151dc7a58722a649a52494434950695a27cb4e7cad14f32f76abbddf629a91.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\nx=u-3v+2,\\,y=4v-1.\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162214" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nThe given transformation can be expressed as\n\n$$\n\\begin{aligned}[\\begin{aligned}x \\\\ y\\end{aligned}] & =[\\begin{aligned}u-3v+2 \\\\ 4v-1\\end{aligned}] \\\\  & =[\\begin{aligned}u-3v \\\\ 4v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 \\\\ 0 & 4\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}2 \\\\ -1\\end{aligned}].\\end{aligned}\n$$\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}1 & -3 \\\\ 0 & 4\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & -3 \\\\ 0 & 4\\end{aligned}| \\\\  & =1\\cdot 4-0\\cdot (-3) \\\\  & =4 \\\\  & \\ne 0.\\end{aligned}\n$$\n\nSo, we have a non-singular matrix. \n\nTherefore, $T$ is invertible and the image of the triangle under the action of $T$ is a triangle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162214" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-162214" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162214" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "A line segment"] ["text" "A point"] ["text" "A quadrilateral"] ["text" "A tetrahedron"] ["text" "A triangle"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162214" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "A triangle"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162225" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/assets/afee2a3c30384baa044088177550b0ac5ed2de228b14e48dd7f729e8a7493318.png)\n\nConsider the affine transformation $T,$ given by\n\n$$\n[\\begin{aligned}x \\\\ y\\end{aligned}]=[\\begin{aligned}3 & 6 \\\\ -2 & -4\\end{aligned}]\\cdot [\\begin{aligned}u \\\\ v\\end{aligned}]+[\\begin{aligned}-1 \\\\ -1\\end{aligned}].\n$$\n\n \nWhat would be the image of the pentagon shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162225" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any affine transformation \n\n$$\nT:u⟶Au+b,\n$$\n\nwhere $A$ is a $2\\times 2$ matrix and $u$ and $b$ are $2\\times 1$ column vectors, we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., when $det(A)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., when $det(A)=0,$ we have two additional subcases:\n\n- If $A$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $A$ is the zero matrix, then the image of a two-dimensional object is a point on the plane.\n\nWith that in mind, let's examine our transformation.\n\nNotice that the matrix representation of the linear transformation associated with $T$ is \n$A=[\\begin{aligned}3 & 6 \\\\ -2 & -4\\end{aligned}].$\n\nComputing the determinant of $A,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}3 & 6 \\\\ -2 & -4\\end{aligned}| \\\\  & =3\\cdot (-4)-(-2)\\cdot 6 \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. \n\nTherefore, $T$ is non-invertible, and the image of the pentagon under the action of $T$ is a line segment." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162225" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/activity-metadata.json" "file_sha256" "c67f98e447853b9489432463be401ef6e7cedb7246a49161b503e29f4c4fc198"} {"question" "q-162225" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" "1ecba6ddb51ebffbbf3aecdfa2dffaedfca50f5520271906b7096c58abde30e6"} {"question" "q-162225" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "A line segment"] ["text" "A pentagon"] ["text" "A point"] ["text" "A quadrilateral"] ["text" "A triangle"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040441/state.json" "file_sha256" 