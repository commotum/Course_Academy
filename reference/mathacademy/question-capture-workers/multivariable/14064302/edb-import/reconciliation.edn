n}{3},\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component ${e}^{-t}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\frac{\\pi n}{3},\n$$\n\nwhere $n$ is an integer." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/state.json" "file_sha256" "fe4806f977d40508537d93d617d8a9ab4130d2aca9f6ba6207548f9b38e98557"} {"question" "q-162644" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/activity-metadata.json" "file_sha256" "1811d961b5b176e07877bc49d24986050c77f4917fa1a1d0bf868755b351e218"} {"question" "q-162644" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/state.json" "file_sha256" "fe4806f977d40508537d93d617d8a9ab4130d2aca9f6ba6207548f9b38e98557"} {"question" "q-162644" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3\\pi n"] ["math" "\\frac{\\pi n}{3}"] ["math" "\\frac{\\pi n}{6}"] ["math" "\\frac{\\pi }{2}+\\frac{\\pi n}{3}"] ["math" "\\frac{\\pi }{6}+\\frac{\\pi n}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/state.json" "file_sha256" "fe4806f977d40508537d93d617d8a9ab4130d2aca9f6ba6207548f9b38e98557"} {"question" "q-162644" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\pi }{6}+\\frac{\\pi n}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/state.json" "file_sha256" "fe4806f977d40508537d93d617d8a9ab4130d2aca9f6ba6207548f9b38e98557"} {"question" "q-162645" "field" nil "attribute" "question/problem" "value" "The domain of the vector-valued function $f(t)={t}^{3}\\,i+\\operatorname{sec}⁡(t+\\frac{\\pi }{3})\\,j+\\sqrt{2{t}^{2}+1}\\,k$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne .\n$$\n\nWhat is the missing expression? You may assume that $n$ is an integer." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/state.json" "file_sha256" "fe4806f977d40508537d93d617d8a9ab4130d2aca9f6ba6207548f9b38e98557"} {"question" "q-162645" "field" nil "attribute" "question/worked-solution" "value" "To find the domain of $f$, we need the intersection of the domains of the individual components.\n\n- The domain of the 1st component ${t}^{3}$ is $t\\in (-\\infty ,\\infty ).$\n\n- The domain of the 2nd component $\\operatorname{sec}⁡(t+\\frac{\\pi }{3})$ is $t\\in (-\\infty ,\\infty ),$ except for the values of $t$ for which\n\n$$\nt+\\frac{\\pi }{3}=\\frac{\\pi }{2}+\\pi n\\,⟹\\,t=\\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer.\n\n- The domain of the 3rd component $\\sqrt{2{t}^{2}+1}$ is $t\\in (-\\infty ,\\infty ).$\n\nTherefore, the domain of the vector-valued function $f(t)$ is \n\n$$\nt\\in (-\\infty ,\\infty ),\\,t\\ne \\frac{\\pi }{6}+\\pi n,\n$$\n\nwhere $n$ is an integer." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/state.json" "file_sha256" "fe4806f977d40508537d93d617d8a9ab4130d2aca9f6ba6207548f9b38e98557"} {"question" "q-162645" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14064302/activity-metadata.json" "file_sha256" "1811d961b5b176e07877bc49d24986050