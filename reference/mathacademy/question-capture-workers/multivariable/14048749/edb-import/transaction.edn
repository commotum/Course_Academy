[[:db/retract 17592186115686 :question/answer-fields 17592186113516] {:db/id "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/bd4df99c4f6bb997bf43dc8f26f0ae69728c05f4f9840eafacb080e96e1c34c2" :answer/id #uuid "43282c4f-790d-5cd6-8f5c-5659619f19d1" :answer/type :answer.type/math :answer/value "⟨2t+3,\\,-2t-1,\\,8⟩" :db/ensure [:answer/validate]} {:db/id "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/0de6a4bedc9f91812834156e0ae188e4318f41e3737bb73f66cdee2f7f092e86" :answer/id #uuid "43e6f936-424e-5183-99e0-988712a9e068" :answer/type :answer.type/math :answer/value "⟨2t,\\,-2t,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/3573926c8a65ffc3e2ef41b4ea24ae384cd3852cdbc330b85bb2fcf2ab026a59" :answer/id #uuid "dd050266-1870-5f15-86d6-f057084932d2" :answer/type :answer.type/math :answer/value "⟨2t+3,\\,-2t-1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/ec7a48af273f1798ed721c20e07b9bf888c05b7036bdb0bd68442b000975ad71" :answer/id #uuid "ce59a7ac-bc7f-5eba-9140-a5898f3e51be" :answer/type :answer.type/math :answer/value "⟨t+3,\\,-t-1,\\,8⟩" :db/ensure [:answer/validate]} {:db/id "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/c6deb04c17dbcf4eb3c60cc82aa5326e256dcd549949581cc92e292787ab0c24" :answer/id #uuid "0316b704-1192-5729-b51c-e89f67f5927d" :answer/type :answer.type/math :answer/value "⟨2t+3,\\,2t+1,\\,8t⟩" :db/ensure [:answer/validate]} {:db/id "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7" :answer-field/id #uuid "a97f65b0-6b8d-55ab-80d3-18a5b299a6ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/bd4df99c4f6bb997bf43dc8f26f0ae69728c05f4f9840eafacb080e96e1c34c2" :answer-field/choices ["q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/bd4df99c4f6bb997bf43dc8f26f0ae69728c05f4f9840eafacb080e96e1c34c2" "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/0de6a4bedc9f91812834156e0ae188e4318f41e3737bb73f66cdee2f7f092e86" "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/3573926c8a65ffc3e2ef41b4ea24ae384cd3852cdbc330b85bb2fcf2ab026a59" "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/ec7a48af273f1798ed721c20e07b9bf888c05b7036bdb0bd68442b000975ad71" "q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7/c6deb04c17dbcf4eb3c60cc82aa5326e256dcd549949581cc92e292787ab0c24"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-33122"] :question/problem "Differentiate $f(t)+g(t)$ with respect to $t$, given that \n\n$$\n\\begin{aligned}f(t) & =⟨3t-1,\\,6-t,\\,7t⟩ \\\\ g(t) & =⟨{t}^{2},\\,1-{t}^{2},\\,t⟩\\end{aligned}\n$$" :question/worked-solution "By the sum rule, we have\n\n$$\n(f(t)+g(t))^{′}={f}^{′}(t)+{g}^{′}(t)\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3t-1),\\,\\frac{\\text{d}}{\\text{d}t}(6-t),\\,\\frac{\\text{d}}{\\text{d}t}(7t)⟩ \\\\  & =⟨3,\\,-1,\\,7⟩ \\\\ {g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨2t,\\,-2t,\\,1⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f(t)+g(t))^{′} & ={f}^{′}(t)+{g}^{′}(t) \\\\  & =⟨3,\\,-1,\\,7⟩+⟨2t,\\,-2t,\\,1⟩ \\\\  & =⟨2t+3,\\,-2t-1,\\,8⟩\\end{aligned}\n$$" :question/answer-fields ["q-33122/selection/ma-v1/8092d8192ce01bfaf86c29ed4ebb94c58179e8d4e3a0efcb2199e8ac8ed1d8b7"] :db/ensure [:question/validate]} {:db/id "q-33123/selection/96bbfd2b25ded16a395b992fb8488c0bc5d40866bb3a11dca04d0b89b933579e" :answer/id #uuid "f39c95bd-809f-5cd9-b776-655b7a49c1a0" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡t\\,i-6\\operatorname{sin}⁡t\\,j" :db/ensure [:answer/validate]} {:db/id "q-33123/selection/f75bf41f9b1e340bd040643c11734db8f7da0047f2fc594380f6e74a7e8a554d" :answer/id #uuid "5623d412-2fd6-52d0-a119-3ce764edaa99" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡ti-2\\operatorname{sin}⁡t\\,k" :db/ensure [:answer/validate]} {:db/id "q-33123/selection/16a2341022ce20f845b1a73ef952bd68c63007d413891940f677b0bea956fb10" :answer/id #uuid "ed7b3206-5983-5b63-b254-e0498df9e1b7" :answer/type :answer.type/math :answer/value "4\\operatorname{cos}⁡t\\,i-6\\operatorname{sin}⁡t\\,j+6\\operatorname{sin}⁡t\\,k" :db/ensure [:answer/validate]} {:db/id "q-33123/selection/0711f459cee91e1164b11089041e5fafd0ae10e67dc3c3c02e02e08d03c85593" :answer/id #uuid "52709d2e-d294-581f-9d56-484236a58193" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡t\\,i+6\\operatorname{sin}⁡t\\,j+6\\operatorname{sin}⁡t\\,k" :db/ensure [:answer/validate]} {:db/id "q-33123/selection/445a1f222c7c5bf8275692e8943c0f318e77d23e2e2394b13ae63cc9d7fb6fb0" :answer/id #uuid "197016fb-2543-5ac0-b838-de273370b5ff" :answer/type :answer.type/math :answer/value "2\\operatorname{cos}⁡t\\,i-3\\operatorname{sin}⁡t\\,j+3\\operatorname{sin}⁡t\\,k" :db/ensure [:answer/validate]} {:db/id "q-33123/selection" :answer-field/id #uuid "8c645193-93f7-59fd-9b5c-fe06f6304120" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33123/selection/96bbfd2b25ded16a395b992fb8488c0bc5d40866bb3a11dca04d0b89b933579e" :answer-field/choices ["q-33123/selection/96bbfd2b25ded16a395b992fb8488c0bc5d40866bb3a11dca04d0b89b933579e" "q-33123/selection/f75bf41f9b1e340bd040643c11734db8f7da0047f2fc594380f6e74a7e8a554d" "q-33123/selection/16a2341022ce20f845b1a73ef952bd68c63007d413891940f677b0bea956fb10" "q-33123/selection/0711f459cee91e1164b11089041e5fafd0ae10e67dc3c3c02e02e08d03c85593" "q-33123/selection/445a1f222c7c5bf8275692e8943c0f318e77d23e2e2394b13ae63cc9d7fb6fb0"] :db/ensure [:answer-field/validate]} {:db/id "q-33123" :question/id #uuid "7f8271aa-2e12-5068-81a4-7f21907bc217" :question/math-academy-id "q-33123" :question/problem "Differentiate $2f(t)+3g(t)$ with respect to $t$, where\n\n \n\n$$\n\\begin{aligned}f(t) & =2\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,(j-\\,k) \\\\ g(t) & =(5-\\operatorname{sin}⁡t)\\,i-\\,j+2\\operatorname{cos}⁡t\\,k\\end{aligned}\n$$" :question/worked-solution "Using the constant multiple and the sum rules, we have \n\n$$\n(2f(t)+3g(t))^{′}=2{f}^{′}(t)+3{g}^{′}(t)\n$$\n\nLet's find the derivatives of each function:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)\\,j-\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)\\,k \\\\  & =2\\operatorname{cos}⁡t\\,i-3\\operatorname{sin}⁡t\\,j+3\\operatorname{sin}⁡t\\,k \\\\ {g}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(5-\\operatorname{sin}⁡t)\\,i-\\frac{\\text{d}}{\\text{d}t}1\\,j+\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)\\,k \\\\  & =-\\operatorname{cos}⁡ti-2\\operatorname{sin}⁡t\\,k\\end{aligned}\n$$\n\nHence \n\n$$\n\\begin{aligned}(2f(t)+3g(t))^{′} & =2{f}^{′}(t)+3{g}^{′}(t) \\\\  & =2(2\\operatorname{cos}⁡t\\,i-3\\operatorname{sin}⁡t\\,j+3\\operatorname{sin}⁡t\\,k)+3(-\\operatorname{cos}⁡ti-2\\operatorname{sin}⁡t\\,k) \\\\  & =4\\operatorname{cos}⁡t\\,i-6\\operatorname{sin}⁡t\\,j+6\\operatorname{sin}⁡t\\,k-3\\operatorname{cos}⁡ti-6\\operatorname{sin}⁡t\\,k \\\\  & =\\operatorname{cos}⁡t\\,i-6\\operatorname{sin}⁡t\\,j\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656"] :knowledge-point/questions ["q-33123"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32499/selection/af13b3372319ecf9bf55f8b8a861f80dc02092ae9381af2b15524bb6ba08b948" :answer/id #uuid "c2d7e36f-f584-5952-9e24-f1423ecac285" :answer/type :answer.type/math :answer/value "⟨-2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,7,\\,-4t⟩" :db/ensure [:answer/validate]} {:db/id "q-32499/selection/8ec6280a3bafd3f374f9e9fe59018823d6681a54429b40932bd1e21faa5756c2" :answer/id #uuid "95efbad6-b565-586c-bc8c-e346736b1125" :answer/type :answer.type/math :answer/value "⟨-2\\operatorname{cos}⁡t,\\,7,\\,4t⟩" :db/ensure [:answer/validate]} {:db/id "q-32499/selection/929335423787d597ea059605374c3a96085881de672d1785ed669d6202baa391" :answer/id #uuid "00a96291-62d0-5490-b5c7-976b882ec7aa" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{sin}⁡t,\\,3,\\,-2t⟩" :db/ensure [:answer/validate]} {:db/id "q-32499/selection/e00abcaa6fcf7bcd979f30baee135b7b6ff1dca438d4987f4735cfe36c692e74" :answer/id #uuid "bbc39652-a88b-5eee-bd56-943a70c8d6cd" :answer/type :answer.type/math :answer/value "⟨\\operatorname{cos}⁡t,\\,-1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-32499/selection/9131e350210e940b85033899b29013134a75cdf9e75876ebd4383faacfca0ab9" :answer/id #uuid "c6099b29-cb16-5f47-ae26-faa61bf4b759" :answer/type :answer.type/math :answer/value "⟨-2\\operatorname{sin}⁡t,\\,6,\\,-4t⟩" :db/ensure [:answer/validate]} {:db/id "q-32499/selection" :answer-field/id #uuid "5d6bd355-3ffb-5e9d-b726-0ca182b67512" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32499/selection/af13b3372319ecf9bf55f8b8a861f80dc02092ae9381af2b15524bb6ba08b948" :answer-field/choices ["q-32499/selection/af13b3372319ecf9bf55f8b8a861f80dc02092ae9381af2b15524bb6ba08b948" "q-32499/selection/8ec6280a3bafd3f374f9e9fe59018823d6681a54429b40932bd1e21faa5756c2" "q-32499/selection/929335423787d597ea059605374c3a96085881de672d1785ed669d6202baa391" "q-32499/selection/e00abcaa6fcf7bcd979f30baee135b7b6ff1dca438d4987f4735cfe36c692e74" "q-32499/selection/9131e350210e940b85033899b29013134a75cdf9e75876ebd4383faacfca0ab9"] :db/ensure [:answer-field/validate]} {:db/id "q-32499" :question/id #uuid "0c3942f9-741e-500b-b021-a56f2876f5b4" :question/math-academy-id "q-32499" :question/problem "Differentiate $2g(t)-h(t)$ with respect to $t$, where\n\n$$\n\\begin{aligned}g(t) & =⟨\\operatorname{cos}⁡t,\\,3t-3,\\,-{t}^{2}⟩ \\\\ h(t) & =⟨\\operatorname{sin}⁡t,\\,-t,\\,4⟩\\end{aligned}\n$$" :question/worked-solution "Using the constant multiple and the sum rules, we have\n\n$$\n(2g(t)-h(t))^{′}=2{g}^{′}(t)-{h}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}\\operatorname{cos}⁡t,\\,\\frac{\\text{d}}{\\text{d}t}(3t-3),\\,\\frac{\\text{d}}{\\text{d}t}(-{t}^{2})⟩ \\\\  & =⟨-\\operatorname{sin}⁡t,\\,3,\\,-2t⟩ \\\\ {h}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}\\operatorname{sin}⁡t,\\,\\frac{\\text{d}}{\\text{d}t}(-t),\\,\\frac{\\text{d}}{\\text{d}t}4⟩ \\\\  & =⟨\\operatorname{cos}⁡t,\\,-1,\\,0⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(2g(t)-h(t))^{′} & =2{g}^{′}(t)-{h}^{′}(t) \\\\  & =2⟨-\\operatorname{sin}⁡t,\\,3,\\,-2t⟩-⟨\\operatorname{cos}⁡t,\\,-1,\\,0⟩ \\\\  & =⟨-2\\operatorname{sin}⁡t,\\,6,\\,-4t⟩-⟨\\operatorname{cos}⁡t,\\,-1,\\,0⟩ \\\\  & =⟨-2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,6-(-1),\\,-4t-0⟩ \\\\  & =⟨-2\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,7,\\,-4t⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32499/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "49b54258-61d2-549c-94e4-a251f6d2a656"] :knowledge-point/questions ["q-32499"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128481/selection/447c9e30b18b2e8305ff87d548858129ff5afdee0e989e1ae90cdc05f2681ca7" :answer/id #uuid "0d7bb0f9-8241-59dc-84ef-242b9967874d" :answer/type :answer.type/math :answer/value "⟨5\\sqrt{t},\\,4{t}^{3},\\,3t+6{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-128481/selection/197aa294f10f2ba95d8c1a866d5995e39593270f9afa5fc26e94c1540a35fe4f" :answer/id #uuid "c7bf0574-f62a-50b0-b258-2bfc1dfc7afc" :answer/type :answer.type/math :answer/value "⟨12\\sqrt{t},\\,8{t}^{3}+2t,\\,4{t}^{2}+6{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-128481/selection/837fa29e58bd682050b5939b4ca362d32602d87950049fcaf09fb7c470c2535e" :answer/id #uuid "2426cc07-f1a0-516d-bfd0-c142e3b4a6e3" :answer/type :answer.type/math :answer/value "⟨6\\sqrt{t},\\,{t}^{3},\\,t+6{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-128481/selection/64048740a2405b80bb4c80771b552cd2e7a3b9d04d18c38b65fdbaca0bc0c2bb" :answer/id #uuid "81115a2c-3ebf-5dbb-8c65-2bfdae0f1bcd" :answer/type :answer.type/math :answer/value "⟨12\\sqrt{t},\\,8{t}^{3},\\,4t+6{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-128481/selection/7e141f6829b8fb0c27bf9d183f22275d4be9e45e77d56a949b1ec0d6572737e1" :answer/id #uuid "307dc8bb-869b-5538-9834-e9edbffc46d1" :answer/type :answer.type/math :answer/value "⟨6\\sqrt{t},\\,2{t}^{2},\\,10{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-128481/selection" :answer-field/id #uuid "17609dc3-c229-5ca9-8caa-b4da3800c4cb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128481/selection/64048740a2405b80bb4c80771b552cd2e7a3b9d04d18c38b65fdbaca0bc0c2bb" :answer-field/choices ["q-128481/selection/447c9e30b18b2e8305ff87d548858129ff5afdee0e989e1ae90cdc05f2681ca7" "q-128481/selection/197aa294f10f2ba95d8c1a866d5995e39593270f9afa5fc26e94c1540a35fe4f" "q-128481/selection/837fa29e58bd682050b5939b4ca362d32602d87950049fcaf09fb7c470c2535e" "q-128481/selection/64048740a2405b80bb4c80771b552cd2e7a3b9d04d18c38b65fdbaca0bc0c2bb" "q-128481/selection/7e141f6829b8fb0c27bf9d183f22275d4be9e45e77d56a949b1ec0d6572737e1"] :db/ensure [:answer-field/validate]} {:db/id "q-128481" :question/id #uuid "ffb6e1fe-344f-5ac5-bc61-6cb251c0c574" :question/math-academy-id "q-128481" :question/problem "Find  $(u(t)g(t))^{′}$ where $g(t)=⟨4\\sqrt{t},\\,{t}^{3},\\,t+{t}^{2}⟩$ and $u(t)=2t.$" :question/worked-solution "By the scalar function multiple rule, we have\n \n\n$$\n(u(t)g(t))^{′}=u(t){g}^{′}(t)+{u}^{′}(t)g(t).\n$$\n\nLet's find ${u}^{′}(t)$ and ${g}^{′}(t).$ \n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\sqrt{t}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(t+{t}^{2})⟩ \\\\  & =⟨\\frac{2}{\\sqrt{t}},\\,3{t}^{2},\\,1+2t⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2t) \\\\  & =2\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)g(t))^{′} & =u(t){g}^{′}(t)+{u}^{′}(t)g(t) \\\\  & =2t⟨\\frac{2}{\\sqrt{t}},\\,3{t}^{2},\\,1+2t⟩+2⟨4\\sqrt{t},\\,{t}^{3},\\,t+{t}^{2}⟩ \\\\  & =⟨4\\sqrt{t},\\,6{t}^{3},\\,2t+4{t}^{2}⟩+⟨8\\sqrt{t},\\,2{t}^{3},\\,2t+2{t}^{2}⟩ \\\\  & =⟨12\\sqrt{t},\\,8{t}^{3},\\,4t+6{t}^{2}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128481/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc"] :knowledge-point/questions ["q-128481"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32286"] :question/problem "Find $(u(t)f(t))^{′}$ where $f(t)=[\\begin{aligned}\\operatorname{sin}⁡t \\\\ 2t-8 \\\\ {5}^{t}\\end{aligned}]$ and $u(t)={t}^{2}.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n(u(t)f(t))^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t)\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(2t-8) \\\\ \\frac{\\text{d}}{\\text{d}t}({5}^{t})\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ 2 \\\\ {5}^{t}\\operatorname{ln}⁡5\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(u(t)f(t))^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & ={t}^{2}[\\begin{aligned}\\operatorname{cos}⁡t \\\\ 2 \\\\ {5}^{t}\\operatorname{ln}⁡5\\end{aligned}]+2t[\\begin{aligned}\\operatorname{sin}⁡t \\\\ 2t-8 \\\\ {5}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}{t}^{2}\\operatorname{cos}⁡t \\\\ 2{t}^{2} \\\\ {5}^{t}{t}^{2}\\operatorname{ln}⁡5\\end{aligned}]+[\\begin{aligned}2t\\operatorname{sin}⁡t \\\\ 4{t}^{2}-16t \\\\ {5}^{t}\\cdot 2t\\end{aligned}] \\\\  & =[\\begin{aligned}{t}^{2}\\operatorname{cos}⁡t+2t\\operatorname{sin}⁡t \\\\ 6{t}^{2}-16t \\\\ {5}^{t}{t}^{2}\\operatorname{ln}⁡5+{5}^{t}\\cdot 2t\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-128488/selection/46215084038e1cf865a90075fdb71b392c36864b5c808438f17b7bdf4eb352d1" :answer/id #uuid "3795bac1-857b-518c-bb87-0f04772d63f9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ {t}^{2}{e}^{-t}(3-t) \\\\ {e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128488/selection/53d7daca03796859fbbc45b5801fa4226da9f8cb1d721378fd1b4e5238c83f62" :answer/id #uuid "2da29843-29bb-54cc-ac1f-9be3591a066b" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 \\\\ 3-t \\\\ {t}^{2}{e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128488/selection/8211546e8727caac5df83cb42b509802e9d7ae3955a880d2c12b66a10dd608c7" :answer/id #uuid "43916381-84af-5a12-a29c-6705c4b89b22" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ {t}^{2}{e}^{-t} \\\\ {e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128488/selection/59683e65feedc57f1c5cb7bf5a69a3c0e834f441e751dc2011fa2c93f1b7807d" :answer/id #uuid "85a08aef-cfd5-5ea6-a8e9-6fb25e5de8d3" :answer/type :answer.type/math :answer/value "[\\begin{aligned}t \\\\ t{e}^{-t}(3-t) \\\\ t{e}^{t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128488/selection/565a9e1a42092c4f7bfc