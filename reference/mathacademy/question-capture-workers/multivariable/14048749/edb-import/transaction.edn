^{-t}[\\begin{aligned}{e}^{t} \\\\ 3{t}^{2} \\\\ 2{e}^{2t}\\end{aligned}] \\\\  & =[\\begin{aligned}-1 \\\\ -{t}^{3}{e}^{-t} \\\\ -{e}^{t}\\end{aligned}]+[\\begin{aligned}1 \\\\ 3{t}^{2}{e}^{-t} \\\\ 2{e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ 3{t}^{2}{e}^{-t}-{t}^{3}{e}^{-t} \\\\ {e}^{t}\\end{aligned}] \\\\  & =[\\begin{aligned}0 \\\\ {t}^{2}{e}^{-t}(3-t) \\\\ {e}^{t}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128488/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc"] :knowledge-point/questions ["q-128488"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128473/selection/996abadf231a80754818428efbeab527ab77d607898cf5e5988a387517eb8782" :answer/id #uuid "4c8b39a7-1cae-57a4-9289-26e4d3651c1a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\operatorname{cos}⁡t \\\\ \\operatorname{sin}⁡t\\operatorname{tan}⁡t+\\operatorname{csc}⁡t \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128473/selection/f85b036b59688079b14514eaba611c2cdb2828ca886e86bbed3a959033ac5041" :answer/id #uuid "c9e92e6a-2135-5cd0-a91b-8edc3a4b35c9" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 \\\\ \\operatorname{sin}⁡t\\operatorname{tan}⁡t+\\operatorname{sec}⁡t \\\\ \\operatorname{cot}⁡t\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128473/selection/cfaef9406528e62f7dc473ce6b8857ec081cfcf02c5ed27c5844f1676ed6353c" :answer/id #uuid "824769ec-ce6c-510e-b94f-9560539e0713" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\operatorname{cos}⁡2t \\\\ \\operatorname{sin}⁡t\\operatorname{tan}⁡t-\\operatorname{sec}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128473/selection/3979421a61eaccaf3bc0d51cb851a0e699385562797456d3109d743087211156" :answer/id #uuid "0797b573-6b49-56c7-93cc-12fbaeeb75e2" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ \\operatorname{sin}⁡t\\operatorname{tan}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128473/selection/763a6aa879ecf2ab1ecae47bd513de8ce9bf19c2cb34bbdd8650273a4525e983" :answer/id #uuid "4e904431-29ed-5d78-a761-330a0c174c0a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 \\\\ \\operatorname{tan}⁡t+\\operatorname{sec}⁡t \\\\ \\operatorname{cos}⁡t\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128473/selection" :answer-field/id #uuid "929b3455-9798-5808-8dad-51b1754cf022" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128473/selection/cfaef9406528e62f7dc473ce6b8857ec081cfcf02c5ed27c5844f1676ed6353c" :answer-field/choices ["q-128473/selection/996abadf231a80754818428efbeab527ab77d607898cf5e5988a387517eb8782" "q-128473/selection/f85b036b59688079b14514eaba611c2cdb2828ca886e86bbed3a959033ac5041" "q-128473/selection/cfaef9406528e62f7dc473ce6b8857ec081cfcf02c5ed27c5844f1676ed6353c" "q-128473/selection/3979421a61eaccaf3bc0d51cb851a0e699385562797456d3109d743087211156" "q-128473/selection/763a6aa879ecf2ab1ecae47bd513de8ce9bf19c2cb34bbdd8650273a4525e983"] :db/ensure [:answer-field/validate]} {:db/id "q-128473" :question/id #uuid "ed124114-d5b6-5cba-b3bb-b981a963c3d5" :question/math-academy-id "q-128473" :question/problem "Find $(u(t)f(t))^{′}$ where $f(t)=[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{tan}⁡t \\\\ 1\\end{aligned}]$ and $u(t)=-\\operatorname{cos}⁡t.$" :question/worked-solution "Using the scalar function multiple rule, we can write\n\n$$\n(u(t)f(t))^{′}={u}^{′}(t)f(t)+u(t){f}^{′}(t).\n$$\n\nLet's find ${u}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}(1)\\end{aligned}]=[\\begin{aligned}\\operatorname{cos}⁡t \\\\ {sec}^{2}⁡t \\\\ 0\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t)=\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)f(t))^{′} & ={u}^{′}(t)f(t)+u(t){f}^{′}(t) \\\\  & =\\operatorname{sin}⁡t[\\begin{aligned}\\operatorname{sin}⁡t \\\\ \\operatorname{tan}⁡t \\\\ 1\\end{aligned}]-\\operatorname{cos}⁡t[\\begin{aligned}\\operatorname{cos}⁡t \\\\ {sec}^{2}⁡t \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{sin}^{2}⁡t \\\\ \\operatorname{sin}⁡t\\operatorname{tan}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}]-[\\begin{aligned}{cos}^{2}⁡t \\\\ \\operatorname{sec}⁡t \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}{sin}^{2}⁡t-{cos}^{2}⁡t \\\\ \\operatorname{sin}⁡t\\operatorname{tan}⁡t-\\operatorname{sec}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}] \\\\  & =[\\begin{aligned}-\\operatorname{cos}⁡2t \\\\ \\operatorname{sin}⁡t\\operatorname{tan}⁡t-\\operatorname{sec}⁡t \\\\ \\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128473/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc"] :knowledge-point/questions ["q-128473"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32502/selection/0db0c7f2573035d0e8a454c2268f6a75c9daadf5594810780dac23d02d4bedb5" :answer/id #uuid "a9586f72-890c-5b16-a110-d043b18b3118" :answer/type :answer.type/math :answer/value "{t}^{2}i+2{t}^{2}\\,j+3{t}^{2}\\,k" :db/ensure [:answer/validate]} {:db/id "q-32502/selection/0a248926d2342c8f61534b3ee1c92cdfce2e71cb6ea14f9cdd9f5b16cffd1986" :answer/id #uuid "bd21e7c5-8371-5b75-8447-6ce7fe86eca0" :answer/type :answer.type/math :answer/value "4t\\,i+8t\\,j+12t\\,k" :db/ensure [:answer/validate]} {:db/id "q-32502/selection/05c1a208f044724db63414fe8896cbac0af78ad5f9f640cad9a636d23f3ed4a4" :answer/id #uuid "ef7085ac-a6ae-51cf-8d34-b9fde3ec025a" :answer/type :answer.type/math :answer/value "2t\\,i+4t\\,j+6t\\,k" :db/ensure [:answer/validate]} {:db/id "q-32502/selection/ef3ceabfb4d00726fc87e7e353d7bd64acaa8bb71f75915ffab9ac38ff25ac9e" :answer/id #uuid "c63cb60e-a89b-5537-8df8-b692d3b4c1cc" :answer/type :answer.type/math :answer/value "4t\\,i+4t\\,j+4t\\,k" :db/ensure [:answer/validate]} {:db/id "q-32502/selection/31436859803a70dce1d77e19f34e75655008e3dd6fb1ece2552e866ffc4670bc" :answer/id #uuid "5a880e73-be30-5a64-a543-3b4a53489a90" :answer/type :answer.type/math :answer/value "i+2\\,j+3\\,k" :db/ensure [:answer/validate]} {:db/id "q-32502/selection" :answer-field/id #uuid "93bb2d7f-92d2-50a3-959c-881a10527c50" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32502/selection/05c1a208f044724db63414fe8896cbac0af78ad5f9f640cad9a636d23f3ed4a4" :answer-field/choices ["q-32502/selection/0db0c7f2573035d0e8a454c2268f6a75c9daadf5594810780dac23d02d4bedb5" "q-32502/selection/0a248926d2342c8f61534b3ee1c92cdfce2e71cb6ea14f9cdd9f5b16cffd1986" "q-32502/selection/05c1a208f044724db63414fe8896cbac0af78ad5f9f640cad9a636d23f3ed4a4" "q-32502/selection/ef3ceabfb4d00726fc87e7e353d7bd64acaa8bb71f75915ffab9ac38ff25ac9e" "q-32502/selection/31436859803a70dce1d77e19f34e75655008e3dd6fb1ece2552e866ffc4670bc"] :db/ensure [:answer-field/validate]} {:db/id "q-32502" :question/id #uuid "af028eae-58a8-55ac-b5bf-34af76194260" :question/math-academy-id "q-32502" :question/problem "If  $f(u)=u\\,i+2u\\,j+3u\\,k$ and $u(t)={t}^{2}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write \n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nNow, let's find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}u\\,i+\\frac{\\text{d}}{\\text{d}u}2u\\,j+\\frac{\\text{d}}{\\text{d}t}3u\\,k \\\\  & =i+2\\,j+3\\,k \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}) \\\\  & =2t\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & =f′(u(t))u′(t) \\\\  & =(i+2\\,j+3\\,k)2t \\\\  & =2t\\,i+4t\\,j+6t\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-32502/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282"] :knowledge-point/questions ["q-32502"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70695/selection/7d69e501d728ecb8b542f133cf297a415e7347ed50556b3a2e624e45bbcc7c5f" :answer/id #uuid "23d3cbec-6609-5443-aa68-9e52f77ae151" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ {e}^{2t}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70695/selection/ac29ca21cf37e7a44050a861d726a8f74da87c2c0507d45be7a1dcfce6b8a3c3" :answer/id #uuid "03f1ed98-54a0-5162-a056-4a21bf99c171" :answer/type :answer.type/math :answer/value "[\\begin{aligned}\\operatorname{sin}⁡({e}^{2t}) \\\\ {e}^{3t} \\\\ \\frac{1}{{e}^{2t}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70695/selection/50ac3e5f00db00eb0115a4a7747d482cb107f59e470e967d232050eb11f77331" :answer/id #uuid "2f64baa6-ed0b-583d-a7b4-3b54733334ea" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{2t}) \\\\ 3{e}^{2t} \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70695/selection/008b1a066447dd727ea2113d889b1567ad2578809073b5a18f80d245655f6df6" :answer/id #uuid "e7b55457-c9f9-5d0c-a7e9-237db15ce839" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\operatorname{cos}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{t} \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70695/selection/bb0dec89fe92b1593912824ee4120a6148ea05f92c7b43e3d3b1c495a6d08d79" :answer/id #uuid "a3e2e139-02bf-500e-a4d6-71101d952c59" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-70695/selection" :answer-field/id #uuid "ccdcf9ec-f301-5cf0-88ef-a2e67a7aa2a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-70695/selection/bb0dec89fe92b1593912824ee4120a6148ea05f92c7b43e3d3b1c495a6d08d79" :answer-field/choices ["q-70695/selection/7d69e501d728ecb8b542f133cf297a415e7347ed50556b3a2e624e45bbcc7c5f" "q-70695/selection/ac29ca21cf37e7a44050a861d726a8f74da87c2c0507d45be7a1dcfce6b8a3c3" "q-70695/selection/50ac3e5f00db00eb0115a4a7747d482cb107f59e470e967d232050eb11f77331" "q-70695/selection/008b1a066447dd727ea2113d889b1567ad2578809073b5a18f80d245655f6df6" "q-70695/selection/bb0dec89fe92b1593912824ee4120a6148ea05f92c7b43e3d3b1c495a6d08d79"] :db/ensure [:answer-field/validate]} {:db/id "q-70695" :question/id #uuid "c43762c8-310f-5f86-a903-48bba629edc4" :question/math-academy-id "q-70695" :question/problem "If $f(u)=[\\begin{aligned}\\operatorname{cos}⁡u \\\\ {u}^{3} \\\\ \\operatorname{ln}⁡u\\end{aligned}]$ and $u(t)={e}^{t}$, then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t).\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u) \\\\ \\frac{\\text{d}}{\\text{d}u}\\,({u}^{3}) \\\\ \\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡u)\\end{aligned}]=[\\begin{aligned}-\\operatorname{sin}⁡u \\\\ 3{u}^{2} \\\\ \\frac{1}{u}\\end{aligned}] \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t)){u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡(u(t)) \\\\ 3(u(t))^{2} \\\\ \\frac{1}{u(t)}\\end{aligned}]\\cdot {u}^{′}(t) \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3({e}^{t})^{2} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}) \\\\ 3{e}^{2t} \\\\ \\frac{1}{{e}^{t}}\\end{aligned}]\\cdot {e}^{t} \\\\  & =[\\begin{aligned}-\\operatorname{sin}⁡({e}^{t}){e}^{t} \\\\ 3{e}^{3t} \\\\ 1\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-70695/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282"] :knowledge-point/questions ["q-70695"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32866"] :question/problem "If $f(t)=\\operatorname{cos}⁡u\\,i+(1-{u}^{2})\\,j+12\\,k$ and $u(t)={t}^{3}$ then $(f∘u)^{′}(t)=$" :question/worked-solution "Using the chain rule, we can write\n\n$$\n(f∘u)^{′}(t)={f}^{′}(u(t)){u}^{′}(t)\n$$\n\nLet's now find the derivatives of each function.\n\n$$\n\\begin{aligned}{f}^{′}(u) & =\\frac{\\text{d}}{\\text{d}u}(\\operatorname{cos}⁡u)\\,i+\\frac{\\text{d}}{\\text{d}u}(1-{u}^{2})\\,j+\\frac{\\text{d}}{\\text{d}u}(12)\\,k \\\\  & =-\\operatorname{sin}⁡u\\,i-2u\\,j+0\\,k \\\\  & =-\\operatorname{sin}⁡u\\,i-2u\\,j \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{3})=3{t}^{2}\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}(f∘u)^{′}(t) & ={f}^{′}(u(t))\\cdot {u}^{′}(t) \\\\  & =(-\\operatorname{sin}⁡(u(t))\\,i-2(u(t))\\,j)\\cdot {u}^{′}(t) \\\\  & =(-\\operatorname{sin}⁡({t}^{3})\\,i-2({t}^{3})\\,j)\\cdot 3{t}^{2} \\\\  & =-3{t}^{2}\\operatorname{sin}⁡{t}^{3}\\,i-6{t}^{5}\\,j\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-128563/selection/818f51a834f80ff6369b4568d3fcdcf7c10c8fbffa8a97a21a35eed19724ba7b" :answer/id #uuid "6d508997-e8d0-5eb1-a25e-9c3cd228db95" :answer/type :answer.type/math :answer/value "⟨2t\\operatorname{cos}⁡({t}^{2}),\\,\\frac{2}{t},\\,2t{sec}^{2}⁡({t}^{2})⟩" :db/ensure [:answer/validate]} {:db/id "q-128563/selection/e7dda4282a6eb04e9cb9edbf85fc5a7f5338eda4990d74c15af0bb54d80c429a" :answer/id #uuid "b3fddfcd-9883-5c9f-83a3-930ff7e1a81b" :answer/type :answer.type/math :answer/value "⟨2t\\operatorname{sin}⁡({t}^{2}),\\,\\frac{1}{t},\\,2t{cos}^{2}⁡({t}^{2})⟩" :db/ensure [:answer/validate]} {:db/id "q-128563/selection/71500008a868fb9fc0a647729585ab54684321ca2ff602ed3d937e26a12847cb" :answer/id #uuid "d0b3d41f-2718-5e62-9a51-1176b24f19a1" :answer/type :answer.type/math :answer/value "⟨2t\\operatorname{sec}⁡({t}^{2}),\\,\\frac{1}{t},\\,2t\\operatorname{sin}⁡({t}^{2})⟩" :db/ensure [:answer/validate]} {:db/id "q-128563/selection/1ebdd08d342ec0cefdc5c73b72badfd13ae2026508d5664c6fc709c03aa7bbce" :answer/id #uuid "0e8e5dda-2d9f-58c9-80ea-e60157e0e87d" :answer/type :answer.type/math :answer/value "⟨\\operatorname{cos}⁡({t}^{2}),\\,\\frac{1}{{t}^{2}},\\,t{sec}^{2}⁡({t}^{2})⟩" :db/ensure [:answer/validate]} {:db/id "q-128563/selection/69ffa3b3d6a6e2ce77de63a7821baf705b1a67cf5dbfac2d7be953b5f82842d6" :answer/id #uuid "207b0ccc-c099-544a-ad48-4aec987a64d3" :answer/type :answer.type/math :answer/value "⟨\\operatorname{cos}⁡({t}^{2}),\\,\\frac{1}{t},\\,2t⟩" :db/ensure [:answer/validate]} {:db/id "q-128563/selection" :answer-field/id #uuid "6d757322-156c-5ffd-ade3-62bd6adc4b46" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128563/selection/818f51a834f80ff6369b4568d3fcdcf7c10c8fbffa8a97a21a35eed19724ba7b" :answer-field/choices ["q-128563/selection/818f51a834f80ff6369b4568d3fcdcf7c10c8fbffa8a97a21a35eed19724ba7b" "q-128563/selection/e7dda4282a6eb04e9cb9edbf85fc5a7f5338eda4990d74c15af0bb54d80c429a" "q-128563/selection/71500008a868fb9fc0a647729585ab54684321ca2ff602ed3d937e26a12847cb" "q-128563/selection/1ebdd08d342ec0cefdc5c73b72badfd13ae2026508d5664c6fc709c03aa7bbce" "q-128563/selection/69ffa3b3d6a6e2ce77de63a7821baf705b1a67cf5dbfac2d7be953b5f82842d6"] :db/ensure [:answer-field/validate]} {:db/id "q-128563" :question/id #uuid "a9d380bc-946d-5cb2-b6f8-b82e7bbd040b" :question/math-academy-id "q-128563" :question/problem "If $g(u)=⟨\\operatorname{sin}⁡u,\\,\\operatorname{ln}⁡2u,\\,\\operatorname{tan}⁡u⟩$ and $u(t)={t}^{2},$ then $(g∘u)^{′}(t)=$" :question/worked-solution "By the chain rule, we have \n\n$$\n(g∘u)^{′}(t)=g′(u(t))u′(t).\n$$\n\nNow, let's find the derivatives of each function:\n\n$$\n\\begin{aligned}{g}^{′}(u) & =⟨\\frac{\\text{d}}{\\text{d}u}(\\operatorname{sin}⁡u),\\,\\frac{\\text{d}}{\\text{d}u}(\\operatorname{ln}⁡2u),\\,\\frac{\\text{d}}{\\text{d}u}(\\operatorname{tan}⁡u)⟩ \\\\  & =⟨\\operatorname{cos}⁡u,\\,\\frac{1}{u},\\,{sec}^{2}⁡u⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({t}^{2})=2t\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(g∘u)^{′}(t) & =g′(u(t))u′(t) \\\\  & =⟨\\operatorname{cos}⁡(u(t)),\\,\\frac{1}{u(t)},\\,{sec}^{2}⁡(u(t))⟩\\cdot {u}^{′}(t) \\\\  & =⟨\\operatorname{cos}⁡({t}^{2}),\\,\\frac{1}{{t}^{2}},\\,{sec}^{2}⁡({t}^{2})⟩\\cdot 2t \\\\  & =⟨2t\\operatorname{cos}⁡({t}^{2}),\\,\\frac{2}{t},\\,2t{sec}^{2}⁡({t}^{2})⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128563/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a146d5d3-2562-5b8b-886e-4cf6519d3282"] :knowledge-point/questions ["q-128563"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32804/selection/41d139c6e182fabb2557b91908319891aad11897f862dcf0102fe9d407cb866f" :answer/id #uuid "cf39db88-b32f-585b-b8b8-ccf646e5f791" :answer/type :answer.type/math :answer/value "60{t}^{4}+50{t}^{2}+6" :db/ensure [:answer/validate]} {:db/id "q-32804/selection/33fe7cfc25e386e50f0e9514e21372f37ce07db5ad9144a5bea4f168ae30e213" :answer/id #uuid "37fa1e0b-f43b-5001-9551-b4528c7a34c9" :answer/type :answer.type/math :answer/value "12{t}^{4}+150{t}^{2}+14" :db/ensure [:answer/validate]} {:db/id "q-32804/selection/0945b8135e57d72633a8d7cd598b30dd99d23af2fc6b269ddb76e38aeffa34e1" :answer/id #uuid "7de1e558-d278-55f6-a981-93ca06dd7f92" :answer/type :answer.type/math :answer/value "60{t}^{4}+150{t}^{2}+14" :db/ensure [:answer/validate]} {:db/id "q-32804/selection/cc0dd9171a406d895d2028d75956277df0a46884efe3dd0f9fae273640aa3a3e" :answer/id #uuid "7b0b6a77-ee0b-5d5d-8710-bf67b9e717f2" :answer/type :answer.type/math :answer/value "12{t}^{4}+50{t}^{2}+14" :db/ensure [:answer/validate]} {:db/id "q-32804/selection/6873d76130a4524ee8805c9fd896c64a6f2eb6f7787f07f0812c294009feaab2" :answer/id #uuid "2c642803-2513-50f8-af08-4542983f40c8" :answer/type :answer.type/math :answer/value "60{t}^{4}+150{t}^{2}-10" :db/ensure [:answer/validate]} {:db/id "q-32804/selection" :answer-field/id #uuid "66ee22d6-224d-513e-9288-ec735a3c0376" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32804/selection/0945b8135e57d72633a8d7cd598b30dd99d23af2fc6b269ddb76e38aeffa34e1" :answer-field/choices ["q-32804/selection/41d139c6e182fabb2557b91908319891aad11897f862dcf0102fe9d407cb866f" "q-32804/selection/33fe7cfc25e386e50f0e9514e21372f37ce07db5ad9144a5bea4f168ae30e213" "q-32804/selection/0945b8135e57d72633a8d7cd598b30dd99d23af2fc6b269ddb76e38aeffa34e1" "q-32804/selection/cc0dd9171a406d895d2028d75956277df0a46884efe3dd0f9fae273640aa3a3e" "q-32804/selection/6873d76130a4524ee8805c9fd896c64a6f2eb6f7787f07f0812c294009feaab2"] :db/ensure [:answer-field/validate]} {:db/id "q-32804" :question/id #uuid "8ac3cd05-f3fc-5ed1-8ce7-9ba2fec9c762" :question/math-academy-id "q-32804" :question/problem "Given $f(t)=2{t}^{3}\\,i-2t\\,j+(1+5{t}^{2})\\,k$, find $({f}^{′}\\cdot f)^{′}(t).$" :question/worked-solution "Using the dot product rule, we can write:\n\n$$\n({f}^{′}\\cdot f)^{′}(t)={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})\\,i-\\frac{\\text{d}}{\\text{d}t}(2t)\\,j+\\frac{\\text{d}}{\\text{d}t}(1+5{t}^{2})\\,k \\\\  & =2\\cdot 3{t}^{2}\\,i-2\\,j+5\\cdot 2t\\,k \\\\  & =6{t}^{2}\\,i-2\\,j+10t\\,k \\\\ {f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(6{t}^{2})\\,i-\\frac{\\text{d}}{\\text{d}t}(2)\\,j+\\frac{\\text{d}}{\\text{d}t}(10t)\\,k \\\\  & =6\\cdot 2t\\,i+(0)j+(10)\\,k \\\\  & =12t\\,i+10\\,k\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}({f}^{′}\\cdot f)^{′}(t) & ={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t) \\\\  & =(12t\\,i+10\\,k)\\cdot (2{t}^{3}\\,i-2t\\,j+(1+5{t}^{2})\\,k)+(6{t}^{2}\\,i-2\\,j+10t\\,k)\\cdot (6{t}^{2}\\,i-2\\,j+10t\\,k) \\\\  & =(12t\\cdot 2{t}^{3}+0\\cdot (-2t)+10\\cdot (1+5{t}^{2}))+((6{t}^{2})^{2}+(-2)^{2}+(10t)^{2}) \\\\  & =24{t}^{4}+0+10+50{t}^{2}+36{t}^{4}+4+100{t}^{2} \\\\  & =60{t}^{4}+150{t}^{2}+14\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32804/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45"] :knowledge-point/questions ["q-32804"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32836/selection/b6a76f1879a481222208f7ac8f2d275589a024b1bc894f4a72dcab05cd824cff" :answer/id #uuid "afa25a13-13f3-54e6-9083-587d5159b115" :answer/type :answer.type/math :answer/value "⟨-6t+6{t}^{2}\\,,\\,-2+2t\\,,\\,-6t+8{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-32836/selection/72272a71cacddbac8b0ef5b34e0de4fd44a751efa99b161a0cf1da64d68459b3" :answer/id #uuid "94cf379d-a3bd-584f-9e63-5d3fc1e779ef" :answer/type :answer.type/math :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-32836/selection/fa0bd757d645bf95159fb09be131c95f0c3a3c10f830bcff475f2a4d63db4eea" :answer/id #uuid "bf3e617b-d986-50f9-9d49-60c355c307eb" :answer/type :answer.type/math :answer/value "⟨-6+6{t}^{2}\\,,\\,-2t\\,,\\,-2+6t-4{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-32836/selection/5150a95bae9eab1943d154a6349253167a8077a9c524f5968beb82e989d57d34" :answer/id #uuid "dd2c20d2-f738-50da-94f6-971d9f7901b2" :answer/type :answer.type/math :answer/value "⟨0\\,,\\,0\\,,\\,-2+6t-4{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-32836/selection/20d1d2b901762650e54d0ab78330a45ae0e9e4c947d317e68307c6f5faa88d41" :answer/id #uuid "a9c161ff-a01d-5249-9ba4-673b0b6a353b" :answer/type :answer.type/math :answer/value "⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+8{t}^{3}⟩" :db/ensure [:answer/validate]} {:db/id "q-32836/selection" :answer-field/id #uuid "067c9103-0d8e-5bff-a030-3cb37846f77b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32836/selection/72272a71cacddbac8b0ef5b34e0de4fd44a751efa99b161a0cf1da64d68459b3" :answer-field/choices ["q-32836/selection/b6a76f1879a481222208f7ac8f2d275589a024b1bc894f4a72dcab05cd824cff" "q-32836/selection/72272a71cacddbac8b0ef5b34e0de4fd44a751efa99b161a0cf1da64d68459b3" "q-32836/selection/fa0bd757d645bf95159fb09be131c95f0c3a3c10f830bcff475f2a4d63db4eea" "q-32836/selection/5150a95bae9eab1943d154a6349253167a8077a9c524f5968beb82e989d57d34" "q-32836/selection/20d1d2b901762650e54d0ab78330a45ae0e9e4c947d317e68307c6f5faa88d41"] :db/ensure [:answer-field/validate]} {:db/id "q-32836" :question/id #uuid "d806e973-4767-5c33-a683-2e2483aec09e" :question/math-academy-id "q-32836" :question/problem "Given $f(t)=⟨1-{t}^{2}\\,,\\,1-{t}^{3}\\,,\\,1-t⟩$, find $({f}^{′}\\times f)^{′}(t).$" :question/worked-solution "Using the cross product rule, we can write:\n\n$$\n({f}^{′}\\times f)^{′}(t)={f}^{″}(t)\\times f(t)+{f}^{′}(t)\\times {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(1-{t}^{3})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(1-t)⟩ \\\\  & =⟨-2t\\,,\\,-3{t}^{2}\\,,\\,-1⟩ \\\\ {f}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-2t)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(-3{t}^{2})\\,,\\,\\frac{\\text{d}}{\\text{d}t}(-1)⟩ \\\\  & =⟨-2\\,,\\,-6t\\,,\\,0⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}{f}^{″}(t)\\times f(t) & =|\\begin{aligned}i & j & k \\\\ -2 & -6t & 0 \\\\ 1-{t}^{2} & 1-{t}^{3} & 1-t\\end{aligned}| \\\\  & =|\\begin{aligned}-6t & 0 \\\\ 1-{t}^{3} & 1-t\\end{aligned}|i-|\\begin{aligned}-2 & 0 \\\\ 1-{t}^{2} & 1-t\\end{aligned}|j+|\\begin{aligned}-2 & -6t \\\\ 1-{t}^{2} & 1-{t}^{3}\\end{aligned}|k \\\\  & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩ \\\\ {f}^{′}(t)\\times {f}^{′}(t) & =|\\begin{aligned}i & j & k \\\\ -2t & -3{t}^{2} & -1 \\\\ -2t & -3{t}^{2} & -1\\end{aligned}| \\\\  & =|\\begin{aligned}-3{t}^{2} & -1 \\\\ -3{t}^{2} & -1\\end{aligned}|i-|\\begin{aligned}-2t & -1 \\\\ -2t & -1\\end{aligned}|j+|\\begin{aligned}-2t & -3{t}^{2} \\\\ -2t & -3{t}^{2}\\end{aligned}|k \\\\  & =⟨0\\,,\\,0\\,,\\,0⟩\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}({f}^{′}\\times f)^{′}(t) & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩+⟨0\\,,\\,0\\,,\\,0⟩ \\\\  & =⟨-6t+6{t}^{2}\\,,\\,2-2t\\,,\\,-2+6t-4{t}^{3}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-32836/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45"] :knowledge-point/questions ["q-32836"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128894/selection/77414979a4c9391bab94f3db32bb36660e3cba9fb6c334f1d198e45ba6969b60" :answer/id #uuid "26ab7f96-88f6-54e0-b263-a0b991bfc789" :answer/type :answer.type/math :answer/value "⟨2{e}^{t+1},\\,2,\\,4{e}^{3t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128894/selection/2d90d91cd13b7f347fb32a7cd96facc3e1fe3f507a70e62fb3cea4006a209499" :answer/id #uuid "34c326b2-379c-58e4-9c46-1d84ba590236" :answer/type :answer.type/math :answer/value "⟨{e}^{2t+1},\\,1,\\,2{e}^{3t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128894/selection/75b6611a2a970557a296ce29c3c69e82543d72042e49529bff3bb1f4f0c8cc7c" :answer/id #uuid "d2533ed3-ca3e-5c4a-8589-11aadbd79d72" :answer/type :answer.type/math :answer/value "⟨2{e}^{2t+1},\\,0,\\,3{e}^{3t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128894/selection/efe87b2a55c60faaa04186993ac344b8fb33a1dac4ee2a1e39a4680c49e24934" :answer/id #uuid "6b9019b2-da71-5f36-8636-4afcae9478e1" :answer/type :answer.type/math :answer/value "⟨{e}^{2t+1},\\,0,\\,-3{e}^{3t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128894/selection/47d8d5ec3e47c58e406576c2b29c6cef15421a42c5a29796328abfbd95bc2cb8" :answer/id #uuid "e2211f80-7e5b-5b68-8324-e2084aab0199" :answer/type :answer.type/math :answer/value "⟨{e}^{2t+1},\\,-2,\\,2{e}^{3t}⟩" :db/ensure [:answer/validate]} {:db/id "q-128894/selection" :answer-field/id #uuid "ca83f0bf-318a-545b-be68-7cadefbf726e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128894/selection/75b6611a2a970557a296ce29c3c69e82543d72042e49529bff3bb1f4f0c8cc7c" :answer-field/choices ["q-128894/selection/77414979a4c9391bab94f3db32bb36660e3cba9fb6c334f1d198e45ba6969b60" "q-128894/selection/2d90d91cd13b7f347fb32a7cd96facc3e1fe3f507a70e62fb3cea4006a209499" "q-128894/selection/75b6611a2a970557a296ce29c3c69e82543d72042e49529bff3bb1f4f0c8cc7c" "q-128894/selection/efe87b2a55c60faaa04186993ac344b8fb33a1dac4ee2a1e39a4680c49e24934" "q-128894/selection/47d8d5ec3e47c58e406576c2b29c6cef15421a42c5a29796328abfbd95bc2cb8"] :db/ensure [:answer-field/validate]} {:db/id "q-128894" :question/id #uuid "024e2103-5c9c-588b-958c-f18d46a16350" :question/math-academy-id "q-128894" :question/problem "Find $(v(t)f(t))^{′}$ given that  $f(t)=⟨{e}^{t+1},\\,{e}^{-t},\\,{e}^{2t}⟩$ and $v(t)={e}^{t}.$" :question/worked-solution "By the scalar function multiple rule, we have\n\n$$\n(v(t)f(t))^{′}=v(t){f}^{′}(t)+{v}^{′}(t)f(t).\n$$\n\nLet's find ${v}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({e}^{t+1}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{-t}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{2t})⟩ \\\\  & =⟨{e}^{t+1},\\,-{e}^{-t},\\,2{e}^{2t}⟩ \\\\ {v}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(v(t)f(t))^{′} & =v(t){f}^{′}(t)+{v}^{′}(t)f(t) \\\\  & ={e}^{t}⟨{e}^{t+1},\\,-{e}^{-t},\\,2{e}^{2t}⟩+{e}^{t}⟨{e}^{t+1},\\,{e}^{-t},\\,{e}^{2t}⟩ \\\\  & =⟨{e}^{2t+1},\\,-1,\\,2{e}^{3t}⟩+⟨{e}^{2t+1},\\,1,\\,{e}^{3t}⟩ \\\\  & =⟨2{e}^{2t+1},\\,0,\\,3{e}^{3t}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128894/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45"] :knowledge-point/questions ["q-128894"] :db/ensure [:knowledge-point/validate]} {:db/id "q-32835/selection/efa05f0ff17a570272e8a7dde1edf9c12ef207d66d488463df84805b83026903" :answer/id #uuid "3009bed0-7929-5409-838e-291b41a616e2" :answer/type :answer.type/math :answer/value "3{t}^{4}+2{t}^{2}-6t+2" :db/ensure [:answer/validate]} {:db/id "q-32835/selection/f3bdee93868e019508e4c8e97d65940b782823e5949bd74c74330c8434eeb9f0" :answer/id #uuid "284c53b5-8f19-53d1-99a1-965543e8c747" :answer/type :answer.type/math :answer/value "15{t}^{4}+6{t}^{2}-6t+2" :db/ensure [:answer/validate]} {:db/id "q-32835/selection/843cd20bce0315bf96164c68865ff1d68a0bd04394edbfaad3ce54fa2e530e49" :answer/id #uuid "b330afeb-f1c7-5275-92b8-d385cc4ad314" :answer/type :answer.type/math :answer/value "15{t}^{4}+6{t}^{2}+2" :db/ensure [:answer/validate]} {:db/id "q-32835/selection/6178ba35d7bede7bdda9c69e29be116e7759495a35f4e057ca2e6c5fba82a8d1" :answer/id #uuid "8dde70b3-d130-59a9-a704-074c530476f8" :answer/type :answer.type/math :answer/value "15{t}^{4}-6t+2" :db/ensure [:answer/validate]} {:db/id "q-32835/selection/7f712c1639ce02e915aa52cd71cd25161d262cd248dc87fdd51d4943be770848" :answer/id #uuid "8ed1e6f4-9567-5244-9885-b1048253c420" :answer/type :answer.type/math :answer/value "3{t}^{4}-2{t}^{2}+6t+2" :db/ensure [:answer/validate]} {:db/id "q-32835/selection" :answer-field/id #uuid "3f20dab2-6173-51e0-b5f6-4e6d3f417c49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32835/selection/f3bdee93868e019508e4c8e97d65940b782823e5949bd74c74330c8434eeb9f0" :answer-field/choices ["q-32835/selection/efa05f0ff17a570272e8a7dde1edf9c12ef207d66d488463df84805b83026903" "q-32835/selection/f3bdee93868e019508e4c8e97d65940b782823e5949bd74c74330c8434eeb9f0" "q-32835/selection/843cd20bce0315bf96164c68865ff1d68a0bd04394edbfaad3ce54fa2e530e49" "q-32835/selection/6178ba35d7bede7bdda9c69e29be116e7759495a35f4e057ca2e6c5fba82a8d1" "q-32835/selection/7f712c1639ce02e915aa52cd71cd25161d262cd248dc87fdd51d4943be770848"] :db/ensure [:answer-field/validate]} {:db/id "q-32835" :question/id #uuid "7e434471-9049-548d-a35e-123fe4871bee" :question/math-academy-id "q-32835" :question/problem "Given $f(t)=⟨{t}^{2}-1\\,,\\,2t\\,,\\,{t}^{3}-1⟩$, find $({f}^{′}\\cdot f)^{′}(t).$" :question/worked-solution "Using the dot product rule, we can write: \n\n$$\n({f}^{′}\\cdot f)^{′}(t)={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t)\n$$\n\nLet's now find the first and second derivative of the function.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-1)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(2t)\\,,\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-1)⟩ \\\\  & =⟨2t\\,,\\,2\\,,\\,3{t}^{2}⟩ \\\\ {f}^{″}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2t)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(2)\\,,\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})⟩ \\\\  & =⟨2\\,,\\,0\\,,\\,6t⟩\\end{aligned}\n$$\n\nTherefore, we obtain:\n\n$$\n\\begin{aligned}({f}^{′}\\cdot f)^{′}(t) & ={f}^{″}(t)\\cdot f(t)+{f}^{′}(t)\\cdot {f}^{′}(t) \\\\  & =⟨2\\,,\\,0\\,,\\,6t⟩\\cdot ⟨{t}^{2}-1\\,,\\,2t\\,,\\,{t}^{3}-1⟩+⟨2t\\,,\\,2\\,,\\,3{t}^{2}⟩\\cdot ⟨2t\\,,\\,2\\,,\\,3{t}^{2}⟩ \\\\  & =(2\\cdot ({t}^{2}-1)+0\\cdot (2t)+6t\\cdot ({t}^{3}-1))+((2t)^{2}+{2}^{2}+(3{t}^{2})^{2}) \\\\  & =2{t}^{2}-2+0+6{t}^{4}-6t+4{t}^{2}+4+9{t}^{4} \\\\  & =15{t}^{4}+6{t}^{2}-6t+2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32835/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45"] :knowledge-point/questions ["q-32835"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33446/selection/ddb145d07389ad3654a2a97762cf00f2e7b27f37c6d4842a9347967ff384c7fc" :answer/id #uuid "6916f06b-5480-5608-a66d-48411b7564d4" :answer/type :answer.type/math :answer/value "⟨0,\\,\\operatorname{ln}⁡2,\\,-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}⟩" :db/ensure [:answer/validate]} {:db/id "q-33446/selection/76dbe3c4a4d1aea370ccb7c5511cbd31ebe07076f7a098c3fa01c2929b254069" :answer/id #uuid "bb2a9f7c-05cf-55be-8894-f40cc879a7bc" :answer/type :answer.type/math :answer/value "⟨{2}^{t},\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩" :db/ensure [:answer/validate]} {:db/id "q-33446/selection/526d3c81d017124fea711ba50566ca26c6e7e12974304c1730f2cb4f78082aa0" :answer/id #uuid "b67cd514-5d5b-5d26-a442-dc0a758efd0e" :answer/type :answer.type/math :answer/value "⟨0,\\,-\\frac{\\operatorname{ln}⁡2}{{2}^{t}},\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-33446/selection/f10ffb4e7f8bae22eff252d4703fc7e3795c69c48fbac5a27ca74be75a102ca6" :answer/id #uuid "d26b33c4-f4dd-5a63-8fd1-2e4e42c63241" :answer/type :answer.type/math :answer/value "⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩" :db/ensure [:answer/validate]} {:db/id "q-33446/selection/18cdfff209f711bd9c9d0d3e3449af2bd6464832cfbc1cd17f54a048bbf4426b" :answer/id #uuid "64a0a43f-3b9f-5f8c-9f84-12d03178410f" :answer/type :answer.type/math :answer/value "⟨\\operatorname{ln}⁡2,\\,\\operatorname{ln}⁡2,\\,({2}^{2t}-1)\\operatorname{ln}⁡2⟩" :db/ensure [:answer/validate]} {:db/id "q-33446/selection" :answer-field/id #uuid "ddf695ad-3e17-535e-b5ef-925f18c49390" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33446/selection/f10ffb4e7f8bae22eff252d4703fc7e3795c69c48fbac5a27ca74be75a102ca6" :answer-field/choices ["q-33446/selection/ddb145d07389ad3654a2a97762cf00f2e7b27f37c6d4842a9347967ff384c7fc" "q-33446/selection/76dbe3c4a4d1aea370ccb7c5511cbd31ebe07076f7a098c3fa01c2929b254069" "q-33446/selection/526d3c81d017124fea711ba50566ca26c6e7e12974304c1730f2cb4f78082aa0" "q-33446/selection/f10ffb4e7f8bae22eff252d4703fc7e3795c69c48fbac5a27ca74be75a102ca6" "q-33446/selection/18cdfff209f711bd9c9d0d3e3449af2bd6464832cfbc1cd17f54a048bbf4426b"] :db/ensure [:answer-field/validate]} {:db/id "q-33446" :question/id #uuid "4ab16987-2b95-50b0-9362-48aafca307ca" :question/math-academy-id "q-33446" :question/problem "Find $(v(t)f(t))^{′}$ given that  $f(t)=⟨{2}^{t},\\,{2}^{t+1},\\,{2}^{2t}+1⟩$ and $v(t)=\\frac{1}{{2}^{t}}.$" :question/worked-solution "By the scalar function multiple rule, we have\n\n$$\n(v(t)f(t))^{′}=v(t){f}^{′}(t)+{v}^{′}(t)f(t)\n$$\n\nLet's find ${v}^{′}(t)$ and ${f}^{′}(t).$\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}({2}^{t}),\\,\\frac{\\text{d}}{\\text{d}t}({2}^{t+1}),\\,\\frac{\\text{d}}{\\text{d}t}({2}^{2t}+1)⟩ \\\\  & =⟨{2}^{t}\\operatorname{ln}⁡2,\\,{2}^{t+1}\\operatorname{ln}⁡2,\\,2\\cdot {2}^{2t}\\operatorname{ln}⁡2⟩ \\\\ {v}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{{2}^{t}})=-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(v(t)f(t))^{′} & =v(t){f}^{′}(t)+{v}^{′}(t)f(t) \\\\  & =\\frac{1}{{2}^{t}}⟨{2}^{t}\\operatorname{ln}⁡2,\\,{2}^{t+1}\\operatorname{ln}⁡2,\\,2\\cdot {2}^{2t}\\operatorname{ln}⁡2⟩-\\frac{\\operatorname{ln}⁡2}{{2}^{t}}⟨{2}^{t},\\,{2}^{t+1},\\,{2}^{2t}+1⟩ \\\\  & =⟨\\frac{{2}^{t}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{{2}^{t+1}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{2\\cdot {2}^{2t}\\operatorname{ln}⁡2}{{2}^{t}}⟩-⟨\\frac{{2}^{t}\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{{2}^{t+1}2\\operatorname{ln}⁡2}{{2}^{t}},\\,\\frac{({2}^{2t}+1)\\operatorname{ln}⁡2}{{2}^{t}}⟩ \\\\  & =⟨0,\\,0,\\,\\frac{({2}^{2t}-1)\\operatorname{ln}⁡2}{{2}^{t}}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33446/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d54a6dbe-42cb-5614-ae0b-611de1719b45"] :knowledge-point/questions ["q-33446"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-2478"] :question/problem "Find $\\big( u(t) \\mathbf g(t) \\big)'$ where ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048749/assets/9e23d542bfc56d506f5437a35a92c304d618109ef60086e1f5a7a4fee57d8a80.png) and $u(t) = t.$" :db/ensure [:question/validate]}]
