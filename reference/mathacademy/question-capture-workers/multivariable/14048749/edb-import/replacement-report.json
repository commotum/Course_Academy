      "source": [
        {
          "question": "q-32866",
          "field": null,
          "attribute": "question/problem",
          "value": "If $f(t)=\\operatorname{cos}\u2061u\\,i+(1-{u}^{2})\\,j+12\\,k$ and $u(t)={t}^{3}$ then $(f\u2218u)^{\u2032}(t)=$",
