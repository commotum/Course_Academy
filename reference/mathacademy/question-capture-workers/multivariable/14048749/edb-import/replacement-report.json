      "source": [
        {
          "question": "q-32286",
          "field": null,
          "attribute": "question/problem",
          "value": "Find $(u(t)f(t))^{\u2032}$ where $f(t)=[\\begin{aligned}\\operatorname{sin}\u2061t \\\\ 2t-8 \\\\ {5}^{t}\\end{aligned}]$ and $u(t)={t}^{2}.$",
          "category": "ma_capture",
          "file": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048749/state.json",
          "file_sha256": "8bbd5e23263f56ea3cb8eb23fb4fd8fd21705614156bb2dafbeec6a71b0d54ee"
        }
      ],
      "basis": 1708,
      "reason": "Observed MA content supersedes the stored value",
      "action": "replace",
      "transaction_receipt": "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048749/edb-import/commit.edn",
