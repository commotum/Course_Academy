[[:db/retract 17592186129536 :question/answer-fields 17592186127010] {:db/id "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/577d21d6300c716886bbe6ad7921b94cb293253cd114447b98c136003d590a96" :answer/id #uuid "8760143c-d921-5b2b-b6ac-21e7470de4c3" :answer/type :answer.type/text :answer/value "A family of spheres centered at $(0,0,e)$" :db/ensure [:answer/validate]} {:db/id "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/d139ba4633f0a4d0ee265926ee72a4a2f97544355a8c53fa5c8ab59ad94a90de" :answer/id #uuid "67290681-9872-5ba5-89b3-941d47ec4615" :answer/type :answer.type/text :answer/value "A family of surfaces given by  ${z}^{2}+c={x}^{2}+{y}^{2}$ for $c>0$" :db/ensure [:answer/validate]} {:db/id "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/e671effa713bb50a5b99121c8a99ef2e9276cfdceb9ac9ab48a14ecc9ea2c676" :answer/id #uuid "5e460968-e353-588b-8bdd-a7ff65ccde11" :answer/type :answer.type/text :answer/value "A family of surfaces given by ${z}^{2}+c={x}^{2}+{y}^{2}$ for $c\\ne 0$" :db/ensure [:answer/validate]} {:db/id "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/4a06be2244e03479e67a0c4c58c1b4c98493fae4eb096ce336358e42bc094548" :answer/id #uuid "45ad949d-4d2e-56aa-84fc-128f042e9a4c" :answer/type :answer.type/text :answer/value "A family of spheres centered at $(0,0,{e}^{-1})$" :db/ensure [:answer/validate]} {:db/id "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/63422bfc01500334e02816980c272181d9c1eaab26110e5d6a661ecd546bd532" :answer/id #uuid "4dc7fe16-21b8-5e01-b76d-1c688bcf3c89" :answer/type :answer.type/text :answer/value "A family of spheres centered at the origin" :db/ensure [:answer/validate]} {:db/id "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80" :answer-field/id #uuid "356be647-ae8c-5506-a2f3-4a2451b5dd03" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/63422bfc01500334e02816980c272181d9c1eaab26110e5d6a661ecd546bd532" :answer-field/choices ["q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/577d21d6300c716886bbe6ad7921b94cb293253cd114447b98c136003d590a96" "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/d139ba4633f0a4d0ee265926ee72a4a2f97544355a8c53fa5c8ab59ad94a90de" "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/e671effa713bb50a5b99121c8a99ef2e9276cfdceb9ac9ab48a14ecc9ea2c676" "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/4a06be2244e03479e67a0c4c58c1b4c98493fae4eb096ce336358e42bc094548" "q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80/63422bfc01500334e02816980c272181d9c1eaab26110e5d6a661ecd546bd532"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-36342"] :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)={e}^{-{x}^{2}-{y}^{2}-{z}^{2}}?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {e}^{-{x}^{2}-{y}^{2}-{z}^{2}} & =c \\\\ -{x}^{2}-{y}^{2}-{z}^{2} & =\\operatorname{ln}⁡c \\\\ {x}^{2}+{y}^{2}+{z}^{2} & =-\\operatorname{ln}⁡c\\end{aligned}\n$$\n\nNotice that $0<c\\le 1$ since $-\\operatorname{ln}⁡c$ must be non-negative. If we let $-\\operatorname{ln}⁡c={r}^{2},$ we get\n\n$$\n{x}^{2}+{y}^{2}+{z}^{2}={r}^{2}.\n$$\n\nTherefore, the level surfaces form a family of spheres centered at the origin." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36342/selection/ma-v1/a64cc52745adbeaa0d1f4067e5d56f10c183794789076e0ed8aa42d9f52f6f80"] :db/ensure [:question/validate]} {:db/id "q-37131/selection/edb92d10c898124c4458bc6e1a0af3c958633edfd1282e9cc22222bec8a40ee9" :answer/id #uuid "1c93ce09-8f59-5716-b3af-4b54a575dad3" :answer/type :answer.type/math :answer/value "z=\\operatorname{cos}⁡xy" :db/ensure [:answer/validate]} {:db/id "q-37131/selection/95a55d6f3fd3ab818cbda78d7a1c051a67458edb3eeb88975b9e5b9727ae4493" :answer/id #uuid "7c8c531f-b4c8-5d4a-9e6a-35f135f5ddbe" :answer/type :answer.type/math :answer/value "z=\\pi -\\operatorname{sin}⁡xy" :db/ensure [:answer/validate]} {:db/id "q-37131/selection/f71171f45165c5c59b8c82866c320b2dec7418caf2557f5df9c9834c7722eaae" :answer/id #uuid "2e938519-b510-510d-94e1-c33aec43b04b" :answer/type :answer.type/math :answer/value "z=\\operatorname{sin}⁡xy" :db/ensure [:answer/validate]} {:db/id "q-37131/selection/8189d31e10ab0a441979637098aee6f26afe54eb14d6a6ccf38040b3ad36efbf" :answer/id #uuid "b2899bac-97db-5f57-b481-a04587b7e4b3" :answer/type :answer.type/math :answer/value "z=-\\operatorname{cos}⁡xy" :db/ensure [:answer/validate]} {:db/id "q-37131/selection/7dd7063b9ac9b82418f9b1e7d0fc933b29bf59693c4bbbd0645e1bfb44071839" :answer/id #uuid "e8743c70-1eb7-5ec4-8bb9-4c34fe99a98a" :answer/type :answer.type/math :answer/value "z=-\\operatorname{sin}⁡xy" :db/ensure [:answer/validate]} {:db/id "q-37131/selection" :answer-field/id #uuid "d76830ff-d00f-56aa-9d9d-e9f2e9fc3065" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37131/selection/edb92d10c898124c4458bc6e1a0af3c958633edfd1282e9cc22222bec8a40ee9" :answer-field/choices ["q-37131/selection/edb92d10c898124c4458bc6e1a0af3c958633edfd1282e9cc22222bec8a40ee9" "q-37131/selection/95a55d6f3fd3ab818cbda78d7a1c051a67458edb3eeb88975b9e5b9727ae4493" "q-37131/selection/f71171f45165c5c59b8c82866c320b2dec7418caf2557f5df9c9834c7722eaae" "q-37131/selection/8189d31e10ab0a441979637098aee6f26afe54eb14d6a6ccf38040b3ad36efbf" "q-37131/selection/7dd7063b9ac9b82418f9b1e7d0fc933b29bf59693c4bbbd0645e1bfb44071839"] :db/ensure [:answer-field/validate]} {:db/id "q-37131" :question/id #uuid "e3e19cf1-1438-5521-a704-9195b3cd730a" :question/math-academy-id "q-37131" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=xy+\\operatorname{arcsin}⁡z$ that passes through the point $P(0,1,1).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(0,1,1) & =0\\cdot 1+\\operatorname{arcsin}⁡(1)=\\frac{\\pi }{2}\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=\\frac{\\pi }{2}.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ xy+\\operatorname{arcsin}⁡z & =\\frac{\\pi }{2} \\\\ \\operatorname{arcsin}⁡z & =\\frac{\\pi }{2}-xy \\\\ z & =\\operatorname{sin}⁡(\\frac{\\pi }{2}-xy) \\\\ z & =\\operatorname{cos}⁡xy\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(0,1,1)$ is the surface $z=\\operatorname{cos}⁡xy.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37131/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142"] :knowledge-point/questions ["q-37131"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71574/selection/ed30b00022bb463af41272bdd58ee3b195b1d8163bfc4d898bfd1d00ff357390" :answer/id #uuid "d307c0a9-2630-56f5-9a70-0a9e9289c484" :answer/type :answer.type/math :answer/value "z=-x-y-1" :db/ensure [:answer/validate]} {:db/id "q-71574/selection/4ab7b70b47350c1ddff337c17c1cb859e6734b7ebde06c09bd62b8b07d45dd55" :answer/id #uuid "2ba6e191-43d8-5547-b6d0-94e14aafed93" :answer/type :answer.type/math :answer/value "z=x-y+2" :db/ensure [:answer/validate]} {:db/id "q-71574/selection/89e33abddad672c4f6928eedbc8d2ccaf7ef25abac487fc175c71fdc39ec5724" :answer/id #uuid "7d16788d-ca1b-504e-88df-a4c3da7e4151" :answer/type :answer.type/math :answer/value "z=\\frac{1}{x+y-1}" :db/ensure [:answer/validate]} {:db/id "q-71574/selection/c9c1031d8bd40834fc87aae1db8e7c177632b11e4a0faa0bf9b4d4ccbab27d36" :answer/id #uuid "0b114a20-d15d-5381-acc8-70cc1ab0618d" :answer/type :answer.type/math :answer/value "z=x+y+2" :db/ensure [:answer/validate]} {:db/id "q-71574/selection/62a92627d0c87f79ec720cbc9555f8b848312a3c2bf80e5ed321db2efc4fdd2b" :answer/id #uuid "bb53c6fc-f3a7-5348-aa34-74d8b978b88f" :answer/type :answer.type/math :answer/value "z=x+y+1" :db/ensure [:answer/validate]} {:db/id "q-71574/selection" :answer-field/id #uuid "d14de792-7989-5c5a-9522-c3dfd65b9bda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71574/selection/c9c1031d8bd40834fc87aae1db8e7c177632b11e4a0faa0bf9b4d4ccbab27d36" :answer-field/choices ["q-71574/selection/ed30b00022bb463af41272bdd58ee3b195b1d8163bfc4d898bfd1d00ff357390" "q-71574/selection/4ab7b70b47350c1ddff337c17c1cb859e6734b7ebde06c09bd62b8b07d45dd55" "q-71574/selection/89e33abddad672c4f6928eedbc8d2ccaf7ef25abac487fc175c71fdc39ec5724" "q-71574/selection/c9c1031d8bd40834fc87aae1db8e7c177632b11e4a0faa0bf9b4d4ccbab27d36" "q-71574/selection/62a92627d0c87f79ec720cbc9555f8b848312a3c2bf80e5ed321db2efc4fdd2b"] :db/ensure [:answer-field/validate]} {:db/id "q-71574" :question/id #uuid "e388c922-dab9-5bf6-870c-17599df704f0" :question/math-academy-id "q-71574" :question/problem "For the function $f(x,y,z)=z-x-y-1,$ find the equation of the level surface $f(x,y,z)=1.$" :question/worked-solution "The level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=1.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ z-x-y-1 & =1 \\\\ z & =x+y+2\\end{aligned}\n$$\n\nTherefore, the level surface for $c=1$ is the plane $z=x+y+2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71574/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5e0a37b-23ad-5e79-a175-378b88640ba4"] :knowledge-point/questions ["q-71574"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71593/selection/d38912053b59ec452fdda846b21c09d146b166e779c10c2745e7cc517a6f89d4" :answer/id #uuid "979ddc9b-cad0-56cf-8004-a82ef13bd803" :answer/type :answer.type/math :answer/value "z=(x+y)^{2}" :db/ensure [:answer/validate]} {:db/id "q-71593/selection/b3e07b46a02cacb791810ac92cd72cff5a00aee57f1dc4e4c68bfd754ae6b758" :answer/id #uuid "ed9be010-ebc4-5754-95a3-77841972757d" :answer/type :answer.type/math :answer/value "z={x}^{2}+2xy-{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71593/selection/baa97335c16a3a7a1d802dd199d3a90b45bd49ff9bcb9b18d9164d07fbebb485" :answer/id #uuid "451901a1-42ae-5cfb-9d27-7c947c9b5508" :answer/type :answer.type/math :answer/value "z={y}^{2}+2xy-{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71593/selection/bc698ee96873d00c72f9f81faef013d9ba8b28c488aa035b0c42b15765c3d6e8" :answer/id #uuid "feb0774e-3d4b-5a90-8d59-dd78831bc49b" :answer/type :answer.type/math :answer/value "z={x}^{2}-2xy-{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71593/selection/57f83f200c8d3e65d7636551318d74fd59fde8675ba74028867f299fe740cf1c" :answer/id #uuid "2b3793a2-fe4a-5725-99d7-031958909144" :answer/type :answer.type/math :answer/value "z=(x-y)^{2}" :db/ensure [:answer/validate]} {:db/id "q-71593/selection" :answer-field/id #uuid "932e4ba5-543a-518f-8a15-dc35af72beff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71593/selection/b3e07b46a02cacb791810ac92cd72cff5a00aee57f1dc4e4c68bfd754ae6b758" :answer-field/choices ["q-71593/selection/d38912053b59ec452fdda846b21c09d146b166e779c10c2745e7cc517a6f89d4" "q-71593/selection/b3e07b46a02cacb791810ac92cd72cff5a00aee57f1dc4e4c68bfd754ae6b758" "q-71593/selection/baa97335c16a3a7a1d802dd199d3a90b45bd49ff9bcb9b18d9164d07fbebb485" "q-71593/selection/bc698ee96873d00c72f9f81faef013d9ba8b28c488aa035b0c42b15765c3d6e8" "q-71593/selection/57f83f200c8d3e65d7636551318d74fd59fde8675ba74028867f299fe740cf1c"] :db/ensure [:answer-field/validate]} {:db/id "q-71593" :question/id #uuid "5c696959-b72e-5102-9ec4-acc967980567" :question/math-academy-id "q-71593" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=\\frac{z-{x}^{2}+{y}^{2}}{xy}$ that passes through the point $P(1,1,2).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(1,1,2) & =\\frac{(2)-(1)^{2}+(1)^{2}}{(1)(1)}=2\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=2.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{z-{x}^{2}+{y}^{2}}{xy} & =2 \\\\ z-{x}^{2}+{y}^{2} & =2xy \\\\ z & ={x}^{2}+2xy-{y}^{2}\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(1,1,2)$ is the surface $z={x}^{2}+2xy-{y}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71593/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142"] :knowledge-point/questions ["q-71593"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129199/selection/1ecb1bbd8d1c1632c201844f385eedd92979c3c7e7e8437616dc725562715b65" :answer/id #uuid "cc89d93a-f650-5673-8db9-773c021bc91f" :answer/type :answer.type/text :answer/value "A family of elliptic paraboloids: $z=4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c$" :db/ensure [:answer/validate]} {:db/id "q-129199/selection/9d0f95b956ea0cc0d62081aabd38d31bd740695d0302ecf0f770cefae0f03145" :answer/id #uuid "bf7146f5-d291-572f-9a8e-ea3d0423858a" :answer/type :answer.type/text :answer/value "A family of surfaces: $z=\\operatorname{ln}⁡(4{x}^{2}+9{y}^{2}-3-c)$" :db/ensure [:answer/validate]} {:db/id "q-129199/selection/e32d310befb47f11608c481047d1bafacd54a35e5b912c4fac42815fbc40a10e" :answer/id #uuid "49c71707-d07d-50a5-8cd5-8e64cc34a1f5" :answer/type :answer.type/text :answer/value "A family of surfaces: $z=\\operatorname{ln}⁡(4{x}^{2}+9{y}^{2}-3)+c$" :db/ensure [:answer/validate]} {:db/id "q-129199/selection/824322384862df1551db8852e266a9b3c7b6547c0296f98cde120ba1dddf7e29" :answer/id #uuid "bdcd5190-eaef-5b64-bd6c-a01857fc73b1" :answer/type :answer.type/text :answer/value "A family of elliptic paraboloids: $z=-4{x}^{2}-9{y}^{2}+3+\\operatorname{ln}⁡c$" :db/ensure [:answer/validate]} {:db/id "q-129199/selection/e785d545917b039774ab2a2768c84807c921a99a0930985ae047d932453f3b4a" :answer/id #uuid "7f36be23-457b-50fb-b93f-741d67d40eb7" :answer/type :answer.type/text :answer/value "A family of hyperboloids of two sheets: ${z}^{2}=4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c$" :db/ensure [:answer/validate]} {:db/id "q-129199/selection" :answer-field/id #uuid "fb381f8a-4bea-53df-91b1-08b8ff021513" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129199/selection/1ecb1bbd8d1c1632c201844f385eedd92979c3c7e7e8437616dc725562715b65" :answer-field/choices ["q-129199/selection/1ecb1bbd8d1c1632c201844f385eedd92979c3c7e7e8437616dc725562715b65" "q-129199/selection/9d0f95b956ea0cc0d62081aabd38d31bd740695d0302ecf0f770cefae0f03145" "q-129199/selection/e32d310befb47f11608c481047d1bafacd54a35e5b912c4fac42815fbc40a10e" "q-129199/selection/824322384862df1551db8852e266a9b3c7b6547c0296f98cde120ba1dddf7e29" "q-129199/selection/e785d545917b039774ab2a2768c84807c921a99a0930985ae047d932453f3b4a"] :db/ensure [:answer-field/validate]} {:db/id "q-129199" :question/id #uuid "252dccd1-3816-5e56-9b75-ae474230a890" :question/math-academy-id "q-129199" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)={e}^{4{x}^{2}+9{y}^{2}-z-3}?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {e}^{4{x}^{2}+9{y}^{2}-z-3} & =c \\\\ 4{x}^{2}+9{y}^{2}-z-3 & =\\operatorname{ln}⁡c \\\\ z & =4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c,\\end{aligned}\n$$\n\nwhere $c>0.$\n\nTherefore, we get a family of elliptic paraboloids:\n\n$$\nz=4{x}^{2}+9{y}^{2}-3-\\operatorname{ln}⁡c,\\,c\\in (0,\\infty )\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129199/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489"] :knowledge-point/questions ["q-129199"] :db/ensure [:knowledge-point/validate]}]
