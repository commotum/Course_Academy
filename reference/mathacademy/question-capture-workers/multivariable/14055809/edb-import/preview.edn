\\frac{\\text{d}y}{\\text{d}t})}^{2}} \\\\  & =\\sqrt{{1}^{2}+{(\\frac{t}{2})}^{2}} \\\\  & =\\sqrt{1+\\frac{{t}^{2}}{4}}\\end{aligned}\n$$\n\nNow, since $f(x,y)=\\frac{y}{x}$, we obtain\n\n$$\n\\begin{aligned}f(r(t)) & =\\frac{(\\frac{{t}^{2}}{4})}{t}=\\frac{t}{4}.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}\\frac{y}{x}\\,\\text{d}s & ={\\int }_{0}^{4\\sqrt{6}}f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{0}^{4\\sqrt{6}}\\frac{t}{4}\\cdot \\sqrt{1+\\frac{{t}^{2}}{4}}\\cdot \\text{d}t \\\\  & =\\frac{1}{4}{\\int }_{0}^{4\\sqrt{6}}t\\sqrt{1+\\frac{{t}^{2}}{4}}\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=1+\\frac{{t}^{2}}{4}$, $\\text{d}u=\\frac{t}{2}\\,\\text{d}t$ as follows: \n\n$$\n\\begin{aligned}\\frac{1}{4}{\\int }_{0}^{4\\sqrt{6}}t\\sqrt{1+\\frac{{t}^{2}}{4}}\\text{d}t & =\\frac{1}{2}{\\int }_{1}^{25}{u}^{1/2}\\,\\text{d}u \\\\  & =\\frac{{u}^{3/2}}{3}{|}_{1}^{25} \\\\  & =\\frac{1}{3}({25}^{3/2}-{1}^{3/2}) \\\\  & =\\frac{1}{3}(125-1) \\\\  & =\\frac{124}{3}\\end{aligned}\n$$" 13194139535132 true] [17592186332908 1000 #edb/ref 17592186332909 13194139535132 true] [17592186332908 1000 #edb/ref 17592186332910 13194139535132 true] [17592186332908 1000 #edb/ref 17592186332911 13194139535132 true] [17592186332908 1000 #edb/ref 17592186332912 13194139535132 true] [17592186332908 1000 #edb/ref 17592186332913 13194139535132 true] [17592186332908 1040 #edb/ref 17592186045450 13194139535132 true] [17592186332908 1041 "selection" 13194139535132 true] [17592186332908 1104 #edb/ref 17592186332910 13194139535132 true] [17592186332908 1110 #uuid "d9ac526d-ec36-58a3-a158-23749532ce78" 13194139535132 true] [17592186332909 1034 "\\frac{25}{3}" 13194139535132 true] [17592186332909 1103 #edb/ref 17592186045453 13194139535132 true] [17592186332909 1111 #uuid "0b5c3457-e383-5443-974a-ee7b2309802f" 13194139535132 true] [17592186332910 1034 "\\frac{124}{3}" 13194139535132 true] [1759218633291