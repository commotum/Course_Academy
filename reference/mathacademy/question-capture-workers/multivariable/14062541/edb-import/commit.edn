d9de9be44dfbbed592e5.png)\n\n \n\nIf $R$ is a type I region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(x,y)=x+y-1\\,{u}_{2}(x,y)={x}^{2}+3.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{x+y-1}^{{x}^{2}+3}f(x,y,z)\\,dz]dA.\n$$" 13194139535331 true] [17592186344209 1000 #edb/ref 17592186344210 13194139535331 true] [17592186344209 1000 #edb/ref 17592186344211 13194139535331 true] [17592186344209 1000 #edb/ref 17592186344212 13194139535331 true] [17592186344209 1000 #edb/ref 17592186344213 13194139535331 true] [17592186344209 1000 #edb/ref 17592186344214 13194139535331 true] [17592186344209 1040 #edb/ref 17592186045450 13194139535331 true] [17592186344209 1041 "selection" 13194139535331 true] [17592186344209 1104 #edb/ref 17592186344212 13194139535331 true] [17592186344209 1110 #uuid "535613ed-2da3-51be-a454-a7f14433a8b9" 13194139535331 true] [17592186344210 1034 "{∬}_{D}[{\\int }_{x+y-1}^{{x}^{2}+3}f(x,y,z)\\,dy]dA" 13194139535331 true] [17592186344210 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344210 1111 #uuid "4377cd2f-4a04-5821-84df-c8efc8ddbc16" 13194139535331 true] [17592186344211 1034 "{\\int }_{x+y-1}^{{x}^{2}+3}[{∬}_{D}f(x,y,z)\\,dA]dy" 13194139535331 true] [17592186344211 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344211 1111 #uuid "abb74dcd-1ef2-51ae-af91-611d54ce27c7" 13194139535331 true] [17592186344212 1034 "{∬}_{D}[{\\int }_{x+y-1}^{{x}^{2}+3}f(x,y,z)\\,dz]dA" 13194139535331 true] [17592186344212 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344212 1111 #uuid "54851f0e-17df-5b6e-9e8b-75d3e67e4667" 13194139535331 true] [17592186344213 1034 "{∬}_{D}[{\\int }_{x+y-1}^{{x}^{2}+3}f(x,y,z)\\,dx]dA" 13194139535331 true] [17592186344213 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344213 1111 #uuid "6d2ecf5a-6fa7-5da3-bd87-ce6806a9e452" 13194139535331 true] [17592186344214 1034 "{\\int }_{x+y-1}^{{x}^{2}+3}[{∬}_{D}f(x,y,z)\\,dA]dx" 13194139535331 true] [17592186344214 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344214 1111 #uuid "4f0323c0-f482-5606-9643-983e5ffe64bc" 13194139535331 true] [17592186344215 1017 #edb/ref 17592186344216 13194139535331 true] [17592186344215 1089 "q-161489" 13194139535331 true] [17592186344215 1091 #edb/ref 17592186045465 13194139535331 true] [17592186344215 1100 "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{1}^{y+1}\\frac{z}{4}\\,dz]dA\n$$\n\nwhere the region $D$ in the $xy$-plane is given by\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 4x}.\n$$" 13194139535331 true] [17592186344215 1113 #uuid "b5657ffc-4e66-5bec-9c59-17aecadd2acd" 13194139535331 true] [17592186344215 1145 "First, we evaluate the inner integral with respect to $z,$ treating $x$ and $y$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{1}^{y+1}\\frac{z}{4}\\,dz]dA & ={∬}_{D}{[\\frac{1}{8}{z}^{2}]}_{z=1}^{z=y+1}\\,dA \\\\  & ={∬}_{D}\\frac{1}{8}((y+1)^{2}-1)\\,dA \\\\  & ={∬}_{D}\\frac{1}{8}({y}^{2}+2y)\\,dA\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{8}({y}^{2}+2y)\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{4x}\\frac{1}{8}({y}^{2}+2y)\\,dy\\,dx \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{4x}\\frac{1}{8}({y}^{2}+2y)\\,dy]dx \\\\  & ={\\int }_{0}^{1}\\frac{1}{8}{[\\frac{1}{3}{y}^{3}+{y}^{2}]}_{y=0}^{y=4x}dx \\\\  & =\\frac{1}{8}{\\int }_{0}^{1}\\frac{1}{3}(64{x}^{3}-0)+(16{x}^{2}-0)\\,dx \\\\  & =\\frac{1}{8}{\\int }_{0}^{1}\\frac{64}{3}{x}^{3}+16{x}^{2}\\,dx \\\\  & =\\frac{1}{8}{[\\frac{16}{3}{x}^{4}+\\frac{16}{3}{x}^{3}]}_{x=0}^{x=1} \\\\  & =\\frac{2}{3}(1-0)+\\frac{2}{3}(1-0) \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" 13194139535331 true] [17592186344216 1000 #edb/ref 17592186344217 13194139535331 true] [17592186344216 1000 #edb/ref 17592186344218 13194139535331 true] [17592186344216 1000 #edb/ref 17592186344219 13194139535331 true] [17592186344216 1000 #edb/ref 17592186344220 13194139535331 true] [17592186344216 1000 #edb/ref 17592186344221 13194139535331 true] [17592186344216 1040 #edb/ref 17592186045450 13194139535331 true] [17592186344216 1041 "selection" 13194139535331 true] [17592186344216 1104 #edb/ref 17592186344220 13194139535331 true] [17592186344216 1110 #uuid "60e13600-b6a2-5f73-b518-046c37e7d29a" 13194139535331 true] [17592186344217 1034 "\\frac{9}{2}" 13194139535331 true] [17592186344217 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344217 1111 #uuid "19534706-2030-52dc-ac65-cf92a8f078e3" 13194139535331 true] [17592186344218 1034 "\\frac{16}{3}" 13194139535331 true] [17592186344218 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344218 1111 #uuid "52c06ae5-81db-563d-be80-5e8ea904b84c" 13194139535331 true] [17592186344219 1034 "2" 13194139535331 true] [17592186344219 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344219 1111 #uuid "2521ec5b-531b-51b0-b32a-77104afce1ae" 13194139535331 true] [17592186344220 1034 "\\frac{4}{3}" 13194139535331 true] [17592186344220 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344220 1111 #uuid "07c01cde-3fa9-55c8-a42c-45adba01b416" 13194139535331 true] [17592186344221 1034 "\\frac{3}{2}" 13194139535331 true] [17592186344221 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344221 1111 #uuid "348efb8e-97aa-5651-a562-638ac23271ce" 13194139535331 true] [17592186344222 1017 #edb/ref 17592186344223 13194139535331 true] [17592186344222 1089 "q-161490" 13194139535331 true] [17592186344222 1091 #edb/ref 17592186045465 13194139535331 true] [17592186344222 1100 "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{x}^{x+y}(y+2z)\\,dz]dA\n$$\n\nwhere the region $D$ in the $xy$-plane is given by\n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le x}.\n$$" 13194139535331 true] [17592186344222 1113 #uuid "e10680dc-d37c-5d39-bcb4-15462d1936c7" 13194139535331 true] [17592186344222 1145 "First, we evaluate the inner integral with respect to $z,$ treating $x$ and $y$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{x}^{x+y}(y+2z)\\,dz]dA & ={∬}_{D}[yz+{z}^{2}]_{z=x}^{z=x+y}\\,dA \\\\  & ={∬}_{D}y((x+y)-x)+((x+y)^{2}-{x}^{2})\\,dA \\\\  & ={∬}_{D}{y}^{2}+{x}^{2}+2xy+{y}^{2}-{x}^{2}\\,dA \\\\  & ={∬}_{D}2xy+2{y}^{2}\\,dA\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}2xy+2{y}^{2}\\,dA & ={\\int }_{1}^{2}{\\int }_{0}^{x}2xy+2{y}^{2}\\,dy\\,dx \\\\  & ={\\int }_{1}^{2}[{\\int }_{0}^{x}2xy+2{y}^{2}\\,dy]dx \\\\  & ={\\int }_{1}^{2}{[x{y}^{2}+\\frac{2}{3}{y}^{3}]}_{y=0}^{y=x}dx \\\\  & ={\\int }_{1}^{2}x({x}^{2}-0)+\\frac{2}{3}({x}^{3}-0)\\,dx \\\\  & ={\\int }_{0}^{1}\\frac{5}{3}{x}^{3}\\,dx \\\\  & =\\frac{5}{3}{[\\frac{1}{4}{x}^{4}]}_{x=1}^{x=2} \\\\  & =\\frac{5}{12}(16-1) \\\\  & =\\frac{25}{4}\\end{aligned}\n$$" 13194139535331 true] [17592186344223 1000 #edb/ref 17592186344224 13194139535331 true] [17592186344223 1000 #edb/ref 17592186344225 13194139535331 true] [17592186344223 1000 #edb/ref 17592186344226 13194139535331 true] [17592186344223 1000 #edb/ref 17592186344227 13194139535331 true] [17592186344223 1000 #edb/ref 17592186344228 13194139535331 true] [17592186344223 1040 #edb/ref 17592186045450 13194139535331 true] [17592186344223 1041 "selection" 13194139535331 true] [17592186344223 1104 #edb/ref 17592186344225 13194139535331 true] [17592186344223 1110 #uuid "8f652020-5fb4-5f8f-8bff-246b16fa28e2" 13194139535331 true] [17592186344224 1034 "\\frac{9}{2}" 13194139535331 true] [17592186344224 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344224 1111 #uuid "bbdc50bf-788f-5004-9515-5e6090b8007f" 13194139535331 true] [17592186344225 1034 "\\frac{25}{4}" 13194139535331 true] [17592186344225 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344225 1111 #uuid "6d7a7bd8-7b13-5212-abba-6c05d749b68e" 13194139535331 true] [17592186344226 1034 "\\frac{2}{3}" 13194139535331 true] [17592186344226 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344226 1111 #uuid "6cc4cb6a-81c6-52af-bd68-202a6bfd5925" 13194139535331 true] [17592186344227 1034 "4" 13194139535331 true] [17592186344227 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344227 1111 #uuid "cb3cb9f5-d994-54c0-84dc-0c857f6c4e71" 13194139535331 true] [17592186344228 1034 "5" 13194139535331 true] [17592186344228 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344228 1111 #uuid "264bbddf-31a4-5f5f-aea7-a689915fb9d8" 13194139535331 true] [17592186344229 1017 #edb/ref 17592186344230 13194139535331 true] [17592186344229 1089 "q-161495" 13194139535331 true] [17592186344229 1091 #edb/ref 17592186045465 13194139535331 true] [17592186344229 1100 "The triple integral\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{∗}^{∗}{\\int }_{∗}^{∗}f(x,y,z)\\,dz\\,dx\\,dy\n$$\n\nis defined over the type I region $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,0\\le x\\le {y}^{2},\\,-2\\le y\\le 4,\\,0\\le z\\le 1+xy}.\n$$\n\nWhat is $a+b?$" 13194139535331 true] [17592186344229 1113 #uuid "26712122-d955-52e5-a48d-0c18c4785850" 13194139535331 true] [17592186344229 1145 "A type I region in three-dimensional space can be written as\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,{u}_{1}(x,y)\\le z\\le {u}_{2}(x,y)}.\n$$\n\nA typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062541/assets/1bd4b6d0b1aa955921c1f7855d3fbd95417072a67504d9de9be44dfbbed592e5.png)\n\n \n\nIf $R$ is a type I region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(x,y)=0,\\,{u}_{2}(x,y)=1+xy.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{1+xy}f(x,y,z)\\,dz]dA.\n$$\n\nNow, the region $D$ is given by\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le {y}^{2},\\,-2\\le y\\le 4}.\n$$\n\nTherefore, by expressing the double integral over $D$ as a repeated integral, we get\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{1+xz}f(x,y,z)\\,dz]dA & ={\\int }_{-2}^{4}{\\int }_{0}^{{y}^{2}}[{\\int }_{0}^{1+xy}f(x,y,z)\\,dz]dx\\,\\text{d}y \\\\  & ={\\int }_{-2}^{4}{\\int }_{0}^{{y}^{2}}{\\int }_{0}^{1+xy}f(x,y,z)\\,dz\\,dx\\,dy.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=-2+4=2.\n$$" 13194139535331 true] [17592186344230 1000 #edb/ref 17592186344231 13194139535331 true] [17592186344230 1000 #edb/ref 17592186344232 13194139535331 true] [17592186344230 1000 #edb/ref 17592186344233 13194139535331 true] [17592186344230 1000 #edb/ref 17592186344234 13194139535331 true] [17592186344230 1000 #edb/ref 17592186344235 13194139535331 true] [17592186344230 1040 #edb/ref 17592186045450 13194139535331 true] [17592186344230 1041 "selection" 13194139535331 true] [17592186344230 1104 #edb/ref 17592186344234 13194139535331 true] [17592186344230 1110 #uuid "780a5649-9207-53ae-9fbc-ca4e87b29e38" 13194139535331 true] [17592186344231 1034 "1+xy" 13194139535331 true] [17592186344231 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344231 1111 #uuid "070f7b7d-4de6-59d3-8631-f2f1dd96090f" 13194139535331 true] [17592186344232 1034 "{y}^{2}" 13194139535331 true] [17592186344232 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344232 1111 #uuid "ac513e85-3ea0-5377-8564-d9e202173bbc" 13194139535331 true] [17592186344233 1034 "1+xy+{y}^{2}" 13194139535331 true] [17592186344233 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344233 1111 #uuid "93887add-252d-5b7d-ae86-15a575f894eb" 13194139535331 true] [17592186344234 1034 "2" 13194139535331 true] [17592186344234 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344234 1111 #uuid "7456e408-cfa2-5ab0-8417-8be0c717e02b" 13194139535331 true] [17592186344235 1034 "6" 13194139535331 true] [17592186344235 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344235 1111 #uuid "2ea23d3f-5ab8-533a-976a-1c4db5d09553" 13194139535331 true] [17592186344236 1017 #edb/ref 17592186344237 13194139535331 true] [17592186344236 1089 "q-161496" 13194139535331 true] [17592186344236 1091 #edb/ref 17592186045465 13194139535331 true] [17592186344236 1100 "The triple integral\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{∗}^{∗}{\\int }_{∗}^{∗}f(x,y,z)\\,dz\\,dx\\,dy\n$$\n\nis defined over the type I region $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,\\frac{1}{2}y\\le x\\le 2,\\,1\\le y\\le 4,\\,0\\le z\\le 4-x-y}.\n$$\n\nWhat is $a+b?$" 13194139535331 true] [17592186344236 1113 #uuid "05d837ac-69f8-5c45-8fb6-a9ac4817dd42" 13194139535331 true] [17592186344236 1145 "A type I region in three-dimensional space can be written as\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,{u}_{1}(x,y)\\le z\\le {u}_{2}(x,y)}.\n$$\n\nA typical three-dimensional type I region can be visualized schematically, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062541/assets/1bd4b6d0b1aa955921c1f7855d3fbd95417072a67504d9de9be44dfbbed592e5.png)\n\n \n\nIf $R$ is a type I region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(x,y)}^{{u}_{2}(x,y)}f(x,y,z)\\,\\text{d}z]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(x,y)=0,\\,{u}_{2}(x,y)=4-x-y.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{4-x-y}f(x,y,z)\\,dz]dA.\n$$\n\nNow, the region $D$ is given by\n\n$$\nD={(x,y)\\,:\\,\\frac{1}{2}y\\le x\\le 2,\\,1\\le y\\le 4}.\n$$\n\nTherefore, by expressing the double integral over $D$ as a repeated integral, we get\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{4-x-y}f(x,y,z)\\,dz]dA & ={\\int }_{1}^{4}{\\int }_{y/2}^{2}[{\\int }_{0}^{4-x-y}f(x,y,z)\\,dz]dx\\,\\text{d}y \\\\  & ={\\int }_{1}^{4}{\\int }_{y/2}^{2}{\\int }_{0}^{4-x-y}f(x,y,z)\\,dz\\,dx\\,dy.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=1+4=5.\n$$" 13194139535331 true] [17592186344237 1000 #edb/ref 17592186344238 13194139535331 true] [17592186344237 1000 #edb/ref 17592186344239 13194139535331 true] [17592186344237 1000 #edb/ref 17592186344240 13194139535331 true] [17592186344237 1000 #edb/ref 17592186344241 13194139535331 true] [17592186344237 1000 #edb/ref 17592186344242 13194139535331 true] [17592186344237 1040 #edb/ref 17592186045450 13194139535331 true] [17592186344237 1041 "selection" 13194139535331 true] [17592186344237 1104 #edb/ref 17592186344241 13194139535331 true] [17592186344237 1110 #uuid "02a72223-5b93-5038-9629-5363cfa57566" 13194139535331 true] [17592186344238 1034 "\\frac{1}{2}y+2" 13194139535331 true] [17592186344238 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344238 1111 #uuid "2281b5d8-2a29-52ff-ac92-7b3ac7d5b0e8" 13194139535331 true] [17592186344239 1034 "4-x-y" 13194139535331 true] [17592186344239 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344239 1111 #uuid "ad8ce24f-1c15-5c95-bc11-61cc63059ff6" 13194139535331 true] [17592186344240 1034 "2" 13194139535331 true] [17592186344240 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344240 1111 #uuid "09a0fb5a-e2f9-5dcb-9aed-ee906167c0a5" 13194139535331 true] [17592186344241 1034 "5" 13194139535331 true] [17592186344241 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344241 1111 #uuid "bc8c718c-8048-5446-a15f-91f36a7ba1f8" 13194139535331 true] [17592186344242 1034 "6-x-y" 13194139535331 true] [17592186344242 1103 #edb/ref 17592186045453 13194139535331 true] [17592186344242 1111 #uuid "fc79813d-2bfd-5742-b427-85fd7cbf7d0f" 13194139535331 true] [17592186344243 1017 #edb/ref 17592186344244 13194139535331 true] [17592186344243 1089 "q-161498" 13194139535331 true] [17592186344243 1091 #edb/ref 17592186045464 13194139535331 true] [17592186344243 1100 "Evaluate the triple integral \n\n$$\n{∭}_{R}2y\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(x,y)\\in D,\\,x\\le z\\le 0},\n$$\n\nand $D$ is a finite region in $xy$-plane enclosed between the coordinate axes and the line $y=2+2x$ in the second quadrant." 13194139535331 true] [17592186344243 1113 #uuid "8fcc7d9b-7e30-5d8d-9c47-ff75b8628610" 13194139535331 true] [17592186344243 1145 "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}2y\\,\\text{d}V={∬}_{D}[{\\int }_{x}^{0}2y\\,dz]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $z,$ treating $x$ and $y$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{x}^{0}2y\\,dz]dA & ={∬}_{D}[2yz]_{z=x}^{z=0}\\,dA \\\\  & ={∬}_{D}2y(0-x)\\,dA \\\\  & ={∬}_{D}-2xy\\,dA\\end{aligned}\n$$\n\nWe must now evaluate the double integral above over the region $D$ in the $xy$-plane shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062541/assets/10a5bb8e61589b71634a21dd17c342eb3f8212995aef52e28f8e8e8033fcdc7d.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}-2xy\\,dA & =-{\\int }_{-1}^{0}{\\int }_{0}^{2+2x}2xy\\,dy\\,dx \\\\  & =-{\\int }_{-1}^{0}[{\\int }_{0}^{2+2x}2xy\\text{ }\\,dy]dx \\\\  & =-{\\int }_{-1}^{0}{[x{y}^{2}]}_{y=0}^{y=2+2x}dx \\\\  & =-{\\int }_{-1}^{0}x{(2+2x)}^{2}\\,dx \\\\  & =-{\\int }_{-1}^{0}(4x+8{x}^{2}+4{x}^{3})\\,dx \\\\  & =-{[2{x}^{2}+\\frac{8}{3}{x}^{3}+{x}^{4}]}_{x=-1}^{x=0} \\\\  & =-0+(2-\\frac{8}{3}+1) \\\\  & =\\frac{1}{3}\\end{aligned}\n$$" 13194139535331 true] [17592186344244 1000 #edb/ref 17592186344245 13194139535331 true] [17592186344244 1000 #edb/ref 17592186344246 13194139535331 true] [17592186344244 1000 #edb/ref 17592186344247 13194139535331 true] [17592186344244 1000 #edb/ref 17592186344248 1