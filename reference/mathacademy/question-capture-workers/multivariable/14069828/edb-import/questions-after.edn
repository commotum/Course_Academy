#{[{:db/id #edb/ref 17592186363170 :knowledge-point/_questions [{:knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8e252d15-9d72-549a-a170-af1dbe6fe620" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-\\frac{1}{2},0)$ and $(0,1,0)$" :db/id #edb/ref 17592186363172} {:answer/id #uuid "b6e36100-b9de-54f5-be78-3693c51e2814" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,\\frac{1}{2},0)$" :db/id #edb/ref 17592186363173} {:answer/id #uuid "6c645a31-398d-5201-8580-00e944e0d56c" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1,0)$ and $(0,1,0)$" :db/id #edb/ref 17592186363174} {:answer/id #uuid "15ce00b9-9977-54ac-930c-a7e4fb034935" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1,0)$ and $(0,\\frac{1}{2},0)$" :db/id #edb/ref 17592186363175} {:answer/id #uuid "b19931c3-d2ea-5db7-a60e-3462af3547fb" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-\\frac{1}{2},0)$ and $(0,\\frac{1}{2},0)$" :db/id #edb/ref 17592186363176}] :answer-field/correct {:answer/id #uuid "6c645a31-398d-5201-8580-00e944e0d56c" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1,0)$ and $(0,1,0)$" :db/id #edb/ref 17592186363174} :answer-field/id #uuid "d757ea12-ef2a-51eb-8f8f-7dbaa93fc0ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363171}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "50783562-e3df-58d6-82c6-67c9daca87a3" :question/math-academy-id "q-164267" :question/problem "Given the ellipsoid $\\frac{(x+2)^{2}}{8}+\\frac{{y}^{2}}{4}+\\frac{(z-2)^{2}}{16}=1$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+2)^{2}}{8}+\\frac{{y}^{2}}{4}+\\frac{(0-2)^{2}}{16} & =1 \\\\ \\frac{4}{8}+\\frac{{y}^{2}}{4}+\\frac{4}{16} & =1 \\\\ \\frac{{y}^{2}}{4} & =\\frac{1}{4} \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nHence, we get the solutions $y=-1$ and $y=1.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-1,0)$ and $(0,1,0).$"}] [{:db/id #edb/ref 17592186363177 :knowledge-point/_questions [{:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339" :knowledge-point/title "The Domain of a Sphere or Ellipsoid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a199e263-c5ec-51b1-bcbe-94d826ea9f63" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{5}$  centered at  $(2,2)$" :db/id #edb/ref 17592186363179} {:answer/id #uuid "639878ec-d84e-5081-93ae-67f5d766aca9" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $5$  centered at  $(-2,2)$" :db/id #edb/ref 17592186363180} {:answer/id #uuid "3d095463-aa89-59df-a48b-fd275cd03c95" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $5$  centered at  $(-2,-2)$" :db/id #edb/ref 17592186363181} {:answer/id #uuid "b3013b1c-db7a-563d-bd7a-d3bc3f1c8191" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{5}$  centered at  $(-2,2)$" :db/id #edb/ref 17592186363182} {:answer/id #uuid "cfbe648f-9d71-5da5-b518-878f8ba2645d" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{5}$  centered at  $(2,-2)$" :db/id #edb/ref 17592186363183}] :answer-field/correct {:answer/id #uuid "cfbe648f-9d71-5da5-b518-878f8ba2645d" :answer/type {:db/ident :answer.type/text} :answer/value "The interior and boundary of the circle of radius $\\sqrt{5}$  centered at  $(2,-2)$" :db/id #edb/ref 17592186363183} :answer-field/id #uuid "0ef280cc-6728-5f3d-aaa7-e97f59550f02" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363178}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "318dfd95-fd1d-563c-ab1e-77dd3f083414" :question/math-academy-id "q-164310" :question/problem "Given the sphere $(x-2)^{2}+(y+2)^{2}+{z}^{2}=5,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-2)^{2}+(y+2)^{2}+{z}^{2} & =5 \\\\ {z}^{2} & =5-((x-2)^{2}+(y+2)^{2}) \\\\ z & =\\pm \\sqrt{5-((x-2)^{2}+(y+2)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}5-((x-2)^{2}+(y+2)^{2})\\ge 0 \\\\ (x-2)^{2}+(y+2)^{2}\\le 5\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x-2)^{2}+(y+2)^{2}=5\n$$\n\nwhich is a circle of radius $\\sqrt{5}$ centered at $(2,-2)$ in the $xy$-plane."}] [{:db/id #edb/ref 17592186363184 :knowledge-point/_questions [{:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339" :knowledge-point/title "The Domain of a Sphere or Ellipsoid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "318be70c-85dc-57c5-b586-5ac051526996" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,{x}^{2}+{y}^{2}<1}" :db/id #edb/ref 17592186363186} {:answer/id #uuid "d6742970-de21-529f-82b3-8177313cb8b9" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le \\frac{1}{3}}" :db/id #edb/ref 17592186363187} {:answer/id #uuid "472615e4-d73b-5b00-b451-7fceea139314" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{3}\\le 1}" :db/id #edb/ref 17592186363188} {:answer/id #uuid "b1a316c0-78f3-54ce-b430-d32da07fb576" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+{y}^{2}>1}" :db/id #edb/ref 17592186363189} {:answer/id #uuid "387089d1-90ef-50ee-beb5-9f0844993364" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le 1}" :db/id #edb/ref 17592186363190}] :answer-field/correct {:answer/id #uuid "387089d1-90ef-50ee-beb5-9f0844993364" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le 1}" :db/id #edb/ref 17592186363190} :answer-field/id #uuid "994816f4-574d-5806-a422-55714416164e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363185}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "151fba39-3341-5c5c-87dc-fa3aad0af0b5" :question/math-academy-id "q-164408" :question/problem "Given the ellipsoid $(x-1)^{2}+(y-1)^{2}+\\frac{(z-1)^{2}}{3}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+(y-1)^{2}+\\frac{(z-1)^{2}}{3} & =1 \\\\ (z+2)^{2} & =3(1-(x-1)^{2}-(y-1)^{2}) \\\\ z+2 & =\\pm \\sqrt{3(1-(x-1)^{2}-(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-(x-1)^{2}-(y-1)^{2}\\ge 0 \\\\ (x-1)^{2}+(y-1)^{2}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the circle $(x-1)^{2}+(y-1)^{2}=1$ and its boundary.\n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le 1}.\n$$"}] [{:db/id #edb/ref 17592186124802 :knowledge-point/_questions [{:knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7" :knowledge-point/title "Calculating Intercepts of Spheres and Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93617cf9-3d17-5af3-8b5b-0af3ff0a1366" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ only" :db/id #edb/ref 17592186121835} {:answer/id #uuid "a04ffbc6-9173-5b40-9429-59d068fa9e5a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0, 0)$ and $(4, 0, 0)$" :db/id #edb/ref 17592186121836} {:answer/id #uuid "e2133937-5633-5d47-8538-ffd02df02013" :answer/type {:db/ident :answer.type/text} :answer/value "$(-27, 0, 0)$ and $(27, 0, 0)$" :db/id #edb/ref 17592186121837} {:answer/id #uuid "3545ce41-2bbd-57ae-ac23-25a5048e69a4" :answer/type {:db/ident :answer.type/text} :answer/value "$(-3\\sqrt{3}, 0, 0)$ and $(3\\sqrt{3}, 0, 0)$" :db/id #edb/ref 17592186121838} {:answer/id #uuid "3ad1e2b2-723c-56e6-814e-f5a94e21b7f1" :answer/type {:db/ident :answer.type/text} :answer/value "$(2, 0, 0)$ only" :db/id #edb/ref 17592186121839}] :answer-field/correct {:answer/id #uuid "a04ffbc6-9173-5b40-9429-59d068fa9e5a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0, 0)$ and $(4, 0, 0)$" :db/id #edb/ref 17592186121836} :answer-field/id #uuid "fd32ea76-5111-5159-815d-d8b416fcdd3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121834}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "863f05c5-808b-57a4-8854-1d3c4552848f" :question/math-academy-id "q-35509" :question/problem "Given the ellipsoid $\\frac{(x-2)^{2}}{12}+\\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{2}=1$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{12}+\\frac{(0+1)^{2}}{6}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{(x-2)^{2}}{12}+\\frac{1}{6}+\\frac{1}{2} & =1 \\\\ \\frac{(x-2)^{2}}{12} & =\\frac{1}{3} \\\\ (x-2)^{2} & =4 \\\\ x-2 & =\\pm 2 \\\\ x & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $x=0$ and $x=4.$\n\nTherefore, the intercepts with the $x$-axis are $(0,0,0)$ and $(4,0,0).$"}] [{:db/id #edb/ref 17592186363191 :knowledge-point/_questions [{:knowledge-point/id #uuid "8db2909b-26fd-53bf-8ce2-9fca4451efc3" :knowledge-point/title "Describing Traces of Ellipsoids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c4ff777-2ffa-5e7a-a9f6-f3d114c51e35" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+(z-1)^{2}=9" :db/id #edb/ref 17592186363193} {:answer/id #uuid "8f1e7edc-f493-5e2a-aee8-1b4e73755641" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=3" :db/id #edb/ref 17592186363194} {:answer/id #uuid "e55ec289-0898-582a-8d59-ae1f9db7ba16" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=41" :db/id #edb/ref 17592186363195} {:answer/id #uuid "a6968aa1-7dba-5616-a633-fedcd149aa7c" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+(z-1)^{2}=36" :db/id #edb/ref 17592186363196} {:answer/id #uuid "4935df32-3e62-54e5-ac99-c005981e8292" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=9" :db/id #edb/ref 17592186363197}] :answer-field/correct {:answer/id #uuid "4935df32-3e62-54e5-ac99-c005981e8292" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{2}+(z+1)^{2}=9" :db/id #edb/ref 17592186363197} :answer-field/id #uuid "504d724a-89e7-5940-b4f7-f35af8a78a25" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363192}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "90279907-b2df-5e94-bbed-58ea69a57bd8" :question/math-academy-id "q-71947" :question/problem "What is the trace in the $yz$-plane of the sphere $(x-4)^{2}+{y}^{2}+(z+1)^{2}=25?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the sphere:\n\n$$\n\\begin{aligned}(0-4)^{2}+{y}^{2}+(z+1)^{2} & =25 \\\\ 16+{y}^{2}+(z+1)^{2} & =25 \\\\ {y}^{2}+(z+1)^{2} & =9\\end{aligned}\n$$"}]}
