{2},0)$" :db/ensure [:answer/validate]} {:db/id "q-164267/selection/48d4fd5512a5c083b24251221d06d9881e209d8a8e7340d31ff788ef76340d7c" :answer/id #uuid "6c645a31-398d-5201-8580-00e944e0d56c" :answer/type :answer.type/text :answer/value "$(0,-1,0)$ and $(0,1,0)$" :db/ensure [:answer/validate]} {:db/id "q-164267/selection/b5f32b76cf53bea878c665014db5064b4a37356a89b1b805135c50a2e42dc52b" :answer/id #uuid "b19931c3-d2ea-5db7-a60e-3462af3547fb" :answer/type :answer.type/text :answer/value "$(0,-\\frac{1}{2},0)$ and $(0,\\frac{1}{2},0)$" :db/ensure [:answer/validate]} {:db/id "q-164267/selection/2551da48235737490035a1fcb6a1666d06b5619068b8bced75cdd59ad0dc4c6c" :answer/id #uuid "8e252d15-9d72-549a-a170-af1dbe6fe620" :answer/type :answer.type/text :answer/value "$(0,-\\frac{1}{2},0)$ and $(0,1,0)$" :db/ensure [:answer/validate]} {:db/id "q-164267/selection" :answer-field/id #uuid "d757ea12-ef2a-51eb-8f8f-7dbaa93fc0ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164267/selection/48d4fd5512a5c083b24251221d06d9881e209d8a8e7340d31ff788ef76340d7c" :answer-field/choices ["q-164267/selection/3ad5dfe146a0c3982db40ecab33c6f6a68c10237df522caeca06ced0de480fbf" "q-164267/selection/64269dc3cc74b316401dfc0e74e8da65063ba3c82489595619e4db6625835812" "q-164267/selection/48d4fd5512a5c083b24251221d06d9881e209d8a8e7340d31ff788ef76340d7c" "q-164267/selection/b5f32b76cf53bea878c665014db5064b4a37356a89b1b805135c50a2e42dc52b" "q-164267/selection/2551da48235737490035a1fcb6a1666d06b5619068b8bced75cdd59ad0dc4c6c"] :db/ensure [:answer-field/validate]} {:db/id "q-164267" :question/id #uuid "50783562-e3df-58d6-82c6-67c9daca87a3" :question/math-academy-id "q-164267" :question/problem "Given the ellipsoid $\\frac{(x+2)^{2}}{8}+\\frac{{y}^{2}}{4}+\\frac{(z-2)^{2}}{16}=1$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(0+2)^{2}}{8}+\\frac{{y}^{2}}{4}+\\frac{(0-2)^{2}}{16} & =1 \\\\ \\frac{4}{8}+\\frac{{y}^{2}}{4}+\\frac{4}{16} & =1 \\\\ \\frac{{y}^{2}}{4} & =\\frac{1}{4} \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nHence, we get the solutions $y=-1$ and $y=1.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-1,0)$ and $(0,1,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164267/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "64e7d2fb-003c-58c0-ab80-159e50748cc7"] :knowledge-point/questions ["q-164267"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164310/selection/7259701e81f92ae687565c9f31d81d12bd7774c293499129a9de1bf6e29005b5" :answer/id #uuid "b3013b1c-db7a-563d-bd7a-d3bc3f1c8191" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $\\sqrt{5}$  centered at  $(-2,2)$" :db/ensure [:answer/validate]} {:db/id "q-164310/selection/ad8ad944e4e45cab52fb2902faa339199a95bc409bb813381552e209387182c9" :answer/id #uuid "cfbe648f-9d71-5da5-b518-878f8ba2645d" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $\\sqrt{5}$  centered at  $(2,-2)$" :db/ensure [:answer/validate]} {:db/id "q-164310/selection/3abf0c7092d69607b1d3093500d3b6eb3b3d70d763bb9145b07bc0aaba3e6238" :answer/id #uuid "a199e263-c5ec-51b1-bcbe-94d826ea9f63" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $\\sqrt{5}$  centered at  $(2,2)$" :db/ensure [:answer/validate]} {:db/id "q-164310/selection/719a0fbf3c0bdf9771eb859698a8adea0bf2e6f93d7d5e80c86fe9cb6897e5e8" :answer/id #uuid "3d095463-aa89-59df-a48b-fd275cd03c95" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $5$  centered at  $(-2,-2)$" :db/ensure [:answer/validate]} {:db/id "q-164310/selection/5fb96b535d7e482e0f344d5389dff7b3d9d076e48b4b76044c3b72e50358f736" :answer/id #uuid "639878ec-d84e-5081-93ae-67f5d766aca9" :answer/type :answer.type/text :answer/value "The interior and boundary of the circle of radius $5$  centered at  $(-2,2)$" :db/ensure [:answer/validate]} {:db/id "q-164310/selection" :answer-field/id #uuid "0ef280cc-6728-5f3d-aaa7-e97f59550f02" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164310/selection/ad8ad944e4e45cab52fb2902faa339199a95bc409bb813381552e209387182c9" :answer-field/choices ["q-164310/selection/7259701e81f92ae687565c9f31d81d12bd7774c293499129a9de1bf6e29005b5" "q-164310/selection/ad8ad944e4e45cab52fb2902faa339199a95bc409bb813381552e209387182c9" "q-164310/selection/3abf0c7092d69607b1d3093500d3b6eb3b3d70d763bb9145b07bc0aaba3e6238" "q-164310/selection/719a0fbf3c0bdf9771eb859698a8adea0bf2e6f93d7d5e80c86fe9cb6897e5e8" "q-164310/selection/5fb96b535d7e482e0f344d5389dff7b3d9d076e48b4b76044c3b72e50358f736"] :db/ensure [:answer-field/validate]} {:db/id "q-164310" :question/id #uuid "318dfd95-fd1d-563c-ab1e-77dd3f083414" :question/math-academy-id "q-164310" :question/problem "Given the sphere $(x-2)^{2}+(y+2)^{2}+{z}^{2}=5,$ what is the domain of $z=z(x,y)?$" :question/worked-solution "From the equation of the sphere, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-2)^{2}+(y+2)^{2}+{z}^{2} & =5 \\\\ {z}^{2} & =5-((x-2)^{2}+(y+2)^{2}) \\\\ z & =\\pm \\sqrt{5-((x-2)^{2}+(y+2)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have the following:\n\n$$\n\\begin{aligned}5-((x-2)^{2}+(y+2)^{2})\\ge 0 \\\\ (x-2)^{2}+(y+2)^{2}\\le 5\\end{aligned}\n$$\n\nThis inequality describes the interior and boundary of the circle \n\n$$\n(x-2)^{2}+(y+2)^{2}=5\n$$\n\nwhich is a circle of radius $\\sqrt{5}$ centered at $(2,-2)$ in the $xy$-plane." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164310/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339"] :knowledge-point/questions ["q-164310"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164408/selection/24e6011d1094d81ffb4efa1dc846cc399a441dc2fe9b6dae1a3c2eab744dab7c" :answer/id #uuid "318be70c-85dc-57c5-b586-5ac051526996" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,{x}^{2}+{y}^{2}<1}" :db/ensure [:answer/validate]} {:db/id "q-164408/selection/b2108df7e3fe17fac874d83898c64ea54436e90c01baf7f3948e05c093be1cb6" :answer/id #uuid "387089d1-90ef-50ee-beb5-9f0844993364" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-164408/selection/7d52e062cf57a3ee327295e04f3b165ad74fcc5d72e9d9b5b412e99b56e6510c" :answer/id #uuid "472615e4-d73b-5b00-b451-7fceea139314" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x-1)^{2}+\\frac{(y-1)^{2}}{3}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-164408/selection/a89d6db649cc0c292975bf3ee8bd5003a513cff59de4989d6e2e87ab7d80008f" :answer/id #uuid "b1a316c0-78f3-54ce-b430-d32da07fb576" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x-1)^{2}+{y}^{2}>1}" :db/ensure [:answer/validate]} {:db/id "q-164408/selection/7822dc1547487bca3b9b08c63a04c7ade07766d68b3bcdddbce5cc3e0c39e5e4" :answer/id #uuid "d6742970-de21-529f-82b3-8177313cb8b9" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le \\frac{1}{3}}" :db/ensure [:answer/validate]} {:db/id "q-164408/selection" :answer-field/id #uuid "994816f4-574d-5806-a422-55714416164e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164408/selection/b2108df7e3fe17fac874d83898c64ea54436e90c01baf7f3948e05c093be1cb6" :answer-field/choices ["q-164408/selection/24e6011d1094d81ffb4efa1dc846cc399a441dc2fe9b6dae1a3c2eab744dab7c" "q-164408/selection/b2108df7e3fe17fac874d83898c64ea54436e90c01baf7f3948e05c093be1cb6" "q-164408/selection/7d52e062cf57a3ee327295e04f3b165ad74fcc5d72e9d9b5b412e99b56e6510c" "q-164408/selection/a89d6db649cc0c292975bf3ee8bd5003a513cff59de4989d6e2e87ab7d80008f" "q-164408/selection/7822dc1547487bca3b9b08c63a04c7ade07766d68b3bcdddbce5cc3e0c39e5e4"] :db/ensure [:answer-field/validate]} {:db/id "q-164408" :question/id #uuid "151fba39-3341-5c5c-87dc-fa3aad0af0b5" :question/math-academy-id "q-164408" :question/problem "Given the ellipsoid $(x-1)^{2}+(y-1)^{2}+\\frac{(z-1)^{2}}{3}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the ellipsoid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+(y-1)^{2}+\\frac{(z-1)^{2}}{3} & =1 \\\\ (z+2)^{2} & =3(1-(x-1)^{2}-(y-1)^{2}) \\\\ z+2 & =\\pm \\sqrt{3(1-(x-1)^{2}-(y-1)^{2})}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}1-(x-1)^{2}-(y-1)^{2}\\ge 0 \\\\ (x-1)^{2}+(y-1)^{2}\\le 1\\end{aligned}\n$$\n\nwhich gives the interior of the circle $(x-1)^{2}+(y-1)^{2}=1$ and its boundary.\n\nTherefore, the domain is \n\n$$\n{(x,y)\\,:\\,(x-1)^{2}+(y-1)^{2}\\le 1}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-164408/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "08c2d581-8b12-575d-bb78-d8bb293a7339"] :knowledge-point/questions ["q-164408"] :db/ensure [:knowledge-point/validate]}]
