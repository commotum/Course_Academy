[{:db/id [:question/math-academy-id "q-35509"] :question/problem "Given the ellipsoid $\\frac{(x-2)^{2}}{12}+\\frac{(y+1)^{2}}{6}+\\frac{(z-1)^{2}}{2}=1$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{12}+\\frac{(0+1)^{2}}{6}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{(x-2)^{2}}{12}+\\frac{1}{6}+\\frac{1}{2} & =1 \\\\ \\frac{(x-2)^{2}}{12} & =\\frac{1}{3} \\\\ (x-2)^{2} & =4 \\\\ x-2 & =\\pm 2 \\\\ x & =2\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $x=0$ and $x=4.$\n\nTherefore, the intercepts with the $x$-axis are $(0,0,0)$ and $(4,0,0).$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-71947/selection/aef43c2b05f4e7c9003cf57b560910f29bb4022b297ad3fb0a0e558648492169" :answer/id #uuid "e55ec289-0898-582a-8d59-ae1f9db7ba16" :answer/type :answer.type/math :answer/value "{y}^{2}+(z+1)^{2}=41" :db/ensure [:answer/validate]} {:db/id "q-71947/selection/ceafb4e7051c7901f7af30057f56947d3aadd000b8973264ed68054802018716" :answer/id #uuid "4935df32-3e62-54e5-ac99-c005981e8292" :answer/type :answer.type/math :answer/value "{y}^{2}+(z+1)^{2}=9" :db/ensure [:answer/validate]} {:db/id "q-71947/selection/0d49da040360c1e7d31322b3d6d92ecdb7ca05739c9414bfb77851681240fea2" :answer/id #uuid "9c4ff777-2ffa-5e7a-a9f6-f3d114c51e35" :answer/type :answer.type/math :answer/value "{y}^{2}+(z-1)^{2}=9" :db/ensure [:answer/validate]} {:db/id "q-71947/selection/7386b82bd897a33b475b6c5dc72763b5a747a6057dcddf926767cf681817d99b" :answer/id #uuid "8f1e7edc-f493-5e2a-aee8-1b4e73755641" :answer/type :answer.type/math :answer/value "{y}^{2}+(z+1)^{2}=3" :db/ensure [:answer/validate]} {:db/id "q-71947/selection/b00d427cd6892f75c42170b7a70b5a052782bdfd08f973debc734355c91d3ba0" :answer/id #uuid "a6968aa1-7dba-5616-a633-fedcd149aa7c" :answer/type :answer.type/math :answer/value "{y}^{2}+(z-1)^{2}=36" :db/ensure [:answer/vali