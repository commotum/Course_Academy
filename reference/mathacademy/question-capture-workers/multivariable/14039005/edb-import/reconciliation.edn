& =2\\pm \\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\sqrt{3},0)$ and $(2+\\sqrt{3},0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/state.json" "file_sha256" "7becc90cb0fd23a99b2458b71a48b4031cc64b5450cfe699b8717248b42ac003" "basis" 635 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/edb-import/verification.json"} {"question" "q-72914" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/activity-metadata.json" "file_sha256" "b0bf8dc005ff807fc386e7a92f1d75a0fa0012b80de133fc69e1f49058d9876b" "basis" 635 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/edb-import/verification.json"} {"question" "q-72914" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/state.json" "file_sha256" "7becc90cb0fd23a99b2458b71a48b4031cc64b5450cfe699b8717248b42ac003" "basis" 635 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/edb-import/verification.json"} {"question" "q-72914" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "(-2\\pm \\sqrt{3},0)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/state.json" "file_sha256" "7becc90cb0fd23a99b2458b71a48b4031cc64b5450cfe699b8717248b42ac003" "basis" 635 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/edb-import/verification.json"} {"question" "q-72914" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "(-3\\pm \\sqrt{2},0)"] 