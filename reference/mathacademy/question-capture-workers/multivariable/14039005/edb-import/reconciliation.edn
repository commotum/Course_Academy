erence/mathacademy/question-capture/13958862/state.json" "file_sha256" "7becc90cb0fd23a99b2458b71a48b4031cc64b5450cfe699b8717248b42ac003" "basis" 635 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/edb-import/verification.json"} {"question" "q-16646" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $x$-intercept, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ Doing this, we get\n\n$$\n\\begin{aligned}5{x}^{2}+2(y-4)^{2} & =-20 \\\\ 5{x}^{2}+2(0-4)^{2} & =-20 \\\\ 5{x}^{2}+2(16) & =-20 \\\\ 5{x}^{2}+32 & =-20 \\\\ {x}^{2} & =-\\frac{52}{5}\\end{aligned}\n$$\n\nSince ${x}^{2}\\ge 0$, there is no $x$ such that ${x}^{2}=-\\frac{52}{5}.$ Therefore, the ellipse has no $x$-intercepts, meaning that it does not intercept the $x$-axis at any point." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/state.json" "file_sha256" "7becc90cb0fd23a99b2458b71a48b4031cc64b5450cfe699b8717248b42ac003" "basis" 635 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/edb-import/verification.json"} {"question" "q-16646" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/activity-metadata.json" "file_sha256" "b0bf8dc005ff807fc386e7a92f1d75a0fa0012b80de133fc69e1f49058d9876b" "basis" 635 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/edb-import/verification.json"} {"question" "q-16646" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/state.json" "file_sha256" "7becc90cb0fd23a99b2458b71a48b4031cc64b5450c