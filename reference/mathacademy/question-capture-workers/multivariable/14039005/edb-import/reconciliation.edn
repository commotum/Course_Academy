7f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-328517" "field" "field-4" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-328517" "field" "field-4" "attribute" "answer-field/correct" "value" [:answer.type/math "4-\\sqrt{5}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-327146" "field" nil "attribute" "question/problem" "value" "Calculate the point where the ellipse $4{x}^{2}+{y}^{2}-8x-5y+\\frac{25}{4}=0$ intercepts the $y$-axis.\n\nThe $y$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-327146" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-8x-5y+\\frac{25}{4} & =0 \\\\ 4(0)^{2}+{y}^{2}-8(0)-5y+\\frac{25}{4} & =0 \\\\ {y}^{2}-5y+\\frac{25}{4} & =0 \\\\ {(y-\\frac{5}{2})}^{2} & =0 \\\\ y-\\frac{5}{2} & =0 \\\\ y & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,\\frac{5}{2}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/0a1303644a54b07f874df4f6694d84384e634403bc4efe8ee5086d922bc6f25e.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-327146" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/activity-metadata.json" "file_sha256" "ff6f25355f5ba1b63a008467791aa46d3322718ec7dc41d87d5b384ba372a02f"} {"question" "q-327146" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-327146" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-327146" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-327146" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9468" "field" nil "attribute" "question/problem" "value" "Determine the point where the ellipse ${x}^{2}+6{y}^{2}-8x+24y+28=0$ intercepts the $y$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9468" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+6{y}^{2}-8x+24y+28 & =0 \\\\ {0}^{2}+6{y}^{2}-8\\cdot 0+24y+28 & =0 \\\\ 6{y}^{2}+24y+28 & =0 \\\\ 6[{y}^{2}+4y]+28 & =0 \\\\ 6[(y+2)^{2}-4]+28 & =0 \\\\ 6(y+2)^{2}-24+28 & =0 \\\\ 6(y+2)^{2}+4 & =0 \\\\ 6(y+2)^{2} & =-4.\\end{aligned}\n$$\n\nSince $6(y+2)^{2}\\ge 0$, there is no $y$ such that $6(y+2)^{2}=-4.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9468" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/activity-metadata.json" "file_sha256" "ff6f25355f5ba1b63a008467791aa46d3322718ec7dc41d87d5b384ba372a02f"} {"question" "q-9468" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9468" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,-2)"] ["math" "(0,2)"] ["text" "$(0,-1)$ and $(0,3)$"] ["text" "$(0,-3)$ and $(0,1)$"] ["text" "There is no $y$-intercept"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9468" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "There is no $y$-intercept"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-170551" "field" nil "attribute" "question/problem" "value" "Determine the points where the ellipse $3{x}^{2}+2{y}^{2}-12x+8y+3=0$ intercepts the $y$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-170551" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}3{x}^{2}+2{y}^{2}-12x+8y+3 & =0 \\\\ 3(0)^{2}+2{y}^{2}-12(0)+8y+3 & =0 \\\\ 2{y}^{2}+8y+3 & =0 \\\\ 2[{y}^{2}+4y]+3 & =0 \\\\ 2[(y+2)^{2}-4]+3 & =0 \\\\ 2(y+2)^{2}-8+3 & =0 \\\\ 2(y+2)^{2} & =5 \\\\ (y+2)^{2} & =\\frac{5}{2} \\\\ y+2 & =\\pm \\sqrt{\\frac{5}{2}} \\\\ y & =-2\\pm \\sqrt{\\frac{5}{2}}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at $(0,-2-\\sqrt{\\frac{5}{2}})$ and $(0,-2+\\sqrt{\\frac{5}{2}}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-170551" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/activity-metadata.json" "file_sha256" "ff6f25355f5ba1b63a008467791aa46d3322718ec7dc41d87d5b384ba372a02f"} {"question" "q-170551" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-170551" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,-1\\pm \\sqrt{\\frac{3}{2}})"] ["math" "(0,-2\\pm \\sqrt{\\frac{5}{2}})"] ["math" "(0,-5\\pm \\sqrt{\\frac{2}{3}})"] ["math" "(0,1\\pm \\sqrt{5})"] ["math" "(0,2\\pm \\sqrt{5})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-170551" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(0,-2\\pm \\sqrt{\\frac{5}{2}})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9471" "field" nil "attribute" "question/problem" "value" "Determine the point where the ellipse ${x}^{2}+3{y}^{2}-4\\sqrt{3}x-6\\sqrt{5}y+15=0$ intercepts the $y$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9471" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}-4\\sqrt{3}x-6\\sqrt{5}y+15 & =0 \\\\ {0}^{2}+3{y}^{2}-4\\sqrt{3}(0)-6\\sqrt{5}y+15 & =0 \\\\ 3{y}^{2}-6\\sqrt{5}y+15 & =0 \\\\ 3[{y}^{2}-2\\sqrt{5}y]+15 & =0 \\\\ 3[(y-\\sqrt{5})^{2}-5]+15 & =0 \\\\ 3(y-\\sqrt{5})^{2}-15+15 & =0 \\\\ 3(y-\\sqrt{5})^{2} & =0 \\\\ y-\\sqrt{5} & =0 \\\\ y & =\\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at $(0,\\sqrt{5}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/d37e546bf2b17c99c87650e7c0973a3a881c8c5f3a8ed28f5f923d9d3d500511.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9471" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/activity-metadata.json" "file_sha256" "ff6f25355f5ba1b63a008467791aa46d3322718ec7dc41d87d5b384ba372a02f"} {"question" "q-9471" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9471" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,1+\\sqrt{2})"] ["math" "(0,1+\\sqrt{3})"] ["math" "(0,2)"] ["math" "(0,3)"] ["math" "(0,\\sqrt{5})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "q-9471" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(0,\\sqrt{5})"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/state.json" "file_sha256" "8b6e6702474aa5857a83fcd72d8cc30f47f7f1e29cb93ff75397ea8c9ed6925c"} {"question" "e-5214" "field" nil "attribute" "question/problem" "value" "Calculate the point where the ellipse $(x-2)^2 + \\dfrac{(y-2)^2}{4} = 1$ intercepts the $x$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5214.json" "file_sha256" "88e5a7f5d987588e8f1880522aac1dce817b275afd6af1201ddbb301526951e0"} {"question" "e-5214" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $x$-intercept, we need to substitute $y = 0$ into the equation of the ellipse and solve the resulting equation for $x.$ Doing this, we get\n\n$$\n\\begin{aligned}(x-2)^{2}+\\frac{(y-2)^{2}}{4} & =1 \\\\ (x-2)^{2}+\\frac{(0-2)^{2}}{4} & =1 \\\\ (x-2)^{2}+1 & =1 \\\\ (x-2)^{2} & =0 \\\\ x-2 & =0 \\\\ x & =2.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at the point $(2,0).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/db1ffc11b3321e87f7c5d2cb490d0381f4b950dfcfd64be00f49c07577f797c0.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5214.json" "file_sha256" "88e5a7f5d987588e8f1880522aac1dce817b275afd6af1201ddbb301526951e0"} {"question" "e-5213" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/4527514f6b522bf5922bcba4b77a1574b29f65c238c8b3dd976d6af6bb6c01ae.png)\n\nCalculate the points where the ellipse $x^2 + 3y^2 - 4x -  6y = 2$ (shown above) intercepts the $x$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5213.json" "file_sha256" "b310de6f6dd0938ecdaa28d83bd6cef1979f0d98ef379d0e906bb770bc2685d3"} {"question" "e-5213" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $x$-intercepts, we need to substitute $y = 0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}-4x-6y & =2 \\\\ {x}^{2}+3\\cdot {0}^{2}-4x-6\\cdot 0 & =2 \\\\ {x}^{2}-4x & =2 \\\\ ({x}^{2}-4x+4)-4 & =2 \\\\ (x-2)^{2}-4 & =2 \\\\ (x-2)^{2} & =6 \\\\ x-2 & =\\pm \\sqrt{6} \\\\ x & =2\\pm \\sqrt{6}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\sqrt{6},0)$ and $(2+\\sqrt{6},0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5213.json" "file_sha256" "b310de6f6dd0938ecdaa28d83bd6cef1979f0d98ef379d0e906bb770bc2685d3"} {"question" "e-5220" "field" nil "attribute" "question/problem" "value" "Calculate the point where the ellipse $\\dfrac{(x-1)^2}{4}+\\dfrac{(y-3)^2}{16}=1$ intercepts the $y$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5220.json" "file_sha256" "36fed67b7ad48a0899b97f195df767cd8a9fef9cf69f31237c45ff0e78794909"} {"question" "e-5220" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $y$-intercept, we need to substitute $x = 0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{4}+\\frac{(y-3)^{2}}{16} & =1 \\\\ \\frac{(0-1)^{2}}{4}+\\frac{(y-3)^{2}}{16} & =1 \\\\ \\frac{1}{4}+\\frac{(y-3)^{2}}{16} & =1 \\\\ \\frac{(y-3)^{2}}{16} & =\\frac{3}{4} \\\\ (y-3)^{2} & =12 \\\\ y-3 & =\\pm \\sqrt{12} \\\\ y-3 & =2\\sqrt{3} \\\\ y & =3\\pm 2\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,3 -2\\sqrt{3})$ and $(0,3 +2\\sqrt{3}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/c090d0410cca8d00f0f93641a4f8bfbfa66c3b586894797e5c5c89291d11126d.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5220.json" "file_sha256" "36fed67b7ad48a0899b97f195df767cd8a9fef9cf69f31237c45ff0e78794909"} {"question" "e-5221" "field" nil "attribute" "question/problem" "value" "Calculate the points where the ellipse $5x^2 + 2y^2 - 20x - 8y + 13 = 0$ intercepts the $y$-axis." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5221.json" "file_sha256" "0c8edc653382113fd67d08638a5a5138b33c232e7cecc410c45188e80f5ddf71"} {"question" "e-5221" "field" nil "attribute" "question/worked-solution" "value" "To calculate the $y$-intercepts, we need to substitute $x = 0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}5{x}^{2}+2{y}^{2}-20x-8y+13 & =0 \\\\ 5\\cdot {0}^{2}+2{y}^{2}-20\\cdot 0-8y+13 & =0 \\\\ 2{y}^{2}-8y+13 & =0 \\\\ 2({y}^{2}-4y)+13 & =0 \\\\ 2[{y}^{2}-4y+4-4]+13 & =0 \\\\ 2[(y-2)^{2}-4]+13 & =0 \\\\ 2{(y-2)}^{2}+5 & =0 \\\\ (y-2)^{2} & =-\\frac{5}{2}\\end{aligned}\n$$\n\nSince $(y-2)^2 \\geq 0$, there is no $y$ such that $(y-2)^2 = -\\dfrac{5}{2}.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/dc56aec7e7c16c4fcfee77f7126f53351c1513c4bfb5e64ac41834ed30ee5782.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/example-5221.json" "file_sha256" "0c8edc653382113fd67d08638a5a5138b33c232e7cecc410c45188e80f5ddf71"}] "usage" {"q-9471" [] "q-16642" [] "e-5221" [] "q-72914" [] "e-5214" [] "q-16646" [] "q-9457" [] "e-5220" [] "q-327146" [] "q-16647" [] "q-16684" [] "e-5213" []} "basis" 1344 "retractions" [[17592186088398 :question/problem "Calculate the points where the ellipse $((x + 4)^{2})/(3) + ((y + 2)^{2})/(6) = 1$ intercepts the $x$-axis."] [17592186088398 :question/worked-solution "To calculate the $x$-intercept, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+4)^{2}}{3}+\\frac{(y+2)^{2}}{6} & =1 \\\\ \\frac{(x+4)^{2}}{3}+\\frac{(0+2)^{2}}{6} & =1 \\\\ \\frac{(x+4)^{2}}{3}+\\frac{4}{6} & =1 \\\\ \\frac{(x+4)^{2}}{3}+\\frac{2}{3} & =1 \\\\ (x+4)^{2}+2 & =3 \\\\ (x+4)^{2} & =1 \\\\ x+4 & =\\pm 1 \\\\ x & =-4\\pm 1 \\\\ x & =-5,\\,-3.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at the points $(-5,0)$ and $(-3,0).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/assets/f491b886477531fbd081cbdd73244e9cf489bd2474528ea27b66b187b9eb170e.png)"] [17592186087986 :question/problem "Determine the points where the ellipse $((x - 2)^{2})/(4) + ((y + 6)^{2})/(36) = 1$ intercepts the $y$-axis."] [17592186267931 :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-8x-5y+\\frac{25}{4} & =0 \\\\ 4(0)^{2}+{y}^{2}-8(0)-5y+\\frac{25}{4} & =0 \\\\ {y}^{2}-5y+\\frac{25}{4} & =0 \\\\ {(y-\\frac{5}{2})}^{2} & =0 \\\\ y-\\frac{5}{2} & =0 \\\\ y & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,\\frac{5}{2}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13958862/assets/0a1303644a54b07f874df4f6694d84384e634403bc4efe8ee5086d922bc6f25e.png)"] [17592186088400 :question/problem "Determine the point where the ellipse $x^{2} + 3y^{2} - 4\\sqrt{3}x - 6\\sqrt{5}y + 15 = 0$ intercepts the $y$-axis."] [17592186087461 :question/worked-solution "To calculate the $x$-intercept, we need to substitute $y = 0$ into the equation of the ellipse and solve the resulting equation for $x$. Doing this, we get\n\n$$\n\\begin{aligned}\n(x - 2)^{2} + ((y - 2)^{2})/(4) &= 1 \\\\\n(x - 2)^{2} + ((0 - 2)^{2})/(4) &= 1 \\\\\n(x - 2)^{2} + 1 &= 1 \\\\\n(x - 2)^{2} &= 0 \\\\\nx - 2 &= 0 \\\\\nx &= 2\n\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at the point $(2,0)$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/850/Source/Images/c435c838bf3a88b169499c58834c75c4.png)"] [17592186087460 :question/problem "Calculate the points where the ellipse $x^2 + 3y^2 - 4x - 6y = 2$ (shown above) intercepts the $x$-axis.\n\n![](/home/jake/Developer/MA/DATA/Lessons/850/Source/Images/7a5d03c5fc0581217a488b76e6d39486.png)"] [17592186087460 :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y = 0$ into the equation of the ellipse and solve the resulting equation for $x$. We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}\nx^{2} + 3y^{2} - 4x - 6y &= 2 \\\\\nx^{2} + 3 \\cdot 0^{2} - 4x - 6 \\cdot 0 &= 2 \\\\\nx^{2} - 4x &= 2 \\\\\n(x^{2} - 4x + 4) - 4 &= 2 \\\\\n(x - 2)^{2} - 4 &= 2 \\\\\n(x - 2)^{2} &= 6 \\\\\nx - 2 &= ± \\sqrt{6} \\\\\nx &= 2 ± \\sqrt{6}\n\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(2-\\sqrt{6},0)$ and $(2+\\sqrt{6},0)$."] [17592186087465 :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x = 0$ in the equation of the ellipse and solve the resulting equation for $y$. Doing this, we get\n\n$$\n\\begin{aligned}\n((x - 1)^{2})/(4) + ((y - 3)^{2})/(16) &= 1 \\\\\n((0 - 1)^{2})/(4) + ((y - 3)^{2})/(16) &= 1 \\\\\n\\frac{1}{4} + ((y - 3)^{2})/(16) &= 1 \\\\\n((y - 3)^{2})/(16) &= \\frac{3}{4} \\\\\n(y - 3)^{2} &= 12 \\\\\ny - 3 &= ± \\sqrt{12} \\\\\ny - 3 &= 2\\sqrt{3} \\\\\ny &= 3 ± 2\\sqrt{3}\n\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,3 -2\\sqrt{3})$ and $(0,3 +2\\sqrt{3})$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/850/Source/Images/686d5b60b8ea3f16af57af3ed5ef341d.png)"] [17592186087466 :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x = 0$ in the equation of the ellipse and try to solve the resulting equation for $y$. We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}\n5x^{2} + 2y^{2} - 20x - 8y + 13 &= 0 \\\\\n5 \\cdot 0^{2} + 2y^{2} - 20 \\cdot 0 - 8y + 13 &= 0 \\\\\n2y^{2} - 8y + 13 &= 0 \\\\\n2(y^{2} - 4y) + 13 &= 0 \\\\\n2[y^{2} - 4y + 4 - 4] + 13 &= 0 \\\\\n2[(y - 2)^{2} - 4] + 13 &= 0 \\\\\n2(y - 2)^{2} + 5 &= 0 \\\\\n(y - 2)^{2} &= -\\frac{5}{2}\n\\end{aligned}\n$$\n\nSince\n\n$$\n(y-2)^2 \\geq 0\n$$\n\n, there is no $y$ such that\n\n$$\n(y-2)^2 = -\\dfrac{5}{2}\n$$\n\nTherefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point.\n\n![](/home/jake/Developer/MA/DATA/Lessons/850/Source/Images/dadec72b5f61bde4c28bdf1079eb4729.png)"]] "immutable_answers" [17592186084928 17592186084929 17592186084930 17592186084931 17592186084932 17592186087319 17592186087320 17592186087321 17592186087322 17592186087323 17592186087331 17592186087332 17592186087333 17592186087334 17592186087335 17592186267862 17592186267863 17592186267864 17592186267865 17592186267866 17592186267869 17592186267870 17592186267871 17592186267872 17592186267873 17592186267876 17592186267877 17592186267878 17592186267879 17592186267880 17592186267933 17592186267935 17592186267944 17592186267945 17592186267946 17592186267947 17592186267948] "immutable_fields" [[17592186084927 :answer-field/correct] [17592186084927 :answer-field/id] [17592186084927 :answer-field/key] [17592186084927 :answer-field/type] [17592186087318 :answer-field/correct] [17592186087318 :answer-field/id] [17592186087318 :answer-field/key] [17592186087318 :answer-field/type] [17592186087330 :answer-field/correct] [17592186087330 :answer-field/id] [17592186087330 :answer-field/key] [17592186087330 :answer-field/type] [17592186267861 :answer-field/correct] [17592186267861 :answer-field/id] [17592186267861 :answer-field/key] [17592186267861 :answer-field/type] [17592186267868 :answer-field/correct] [17592186267868 :answer-field/id] [17592186267868 :answer-field/key] [17592186267868 :answer-field/type] [17592186267875 :answer-field/correct] [17592186267875 :answer-field/id] [17592186267875 :answer-field/key] [17592186267875 :answer-field/type] [17592186267932 :answer-field/correct] [17592186267932 :answer-field/id] [17592186267932 :answer-field/key] [17592186267932 :answer-field/type] [17592186267934 :answer-field/correct] [17592186267934 :answer-field/id] [17592186267934 :answer-field/key] [17592186267934 :answer-field/type] [17592186267943 :answer-field/correct] [17592186267943 :answer-field/id] [17592186267943 :answer-field/key] [17