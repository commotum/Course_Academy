ledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-328497"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9461/selection/22b554a3013bb1fb8496e86f98c5dac72b29c91b686e766107f6f4d9d69a4a77" :answer/id #uuid "dc13af03-e5f2-54f9-a17c-a6649aae82a5" :answer/type :answer.type/math :answer/value "(-3\\pm 2\\sqrt{3},0)" :db/ensure [:answer/validate]} {:db/id "q-9461/selection/4091bfd76ae298ceb4a683cffe12a124fd2f166152e89ed75cbf45912771acf2" :answer/id #uuid "0d0f82d5-1461-56ce-88c6-ffc4901b6b08" :answer/type :answer.type/math :answer/value "(\\pm \\sqrt{3},0)" :db/ensure [:answer/validate]} {:db/id "q-9461/selection/e45c584892f2c347ed70093e892c50c363f505921f5544db81df2716a40367ee" :answer/id #uuid "053cac49-342e-57f5-998c-bba4681483a7" :answer/type :answer.type/text :answer/value "$(-5,0)$ and $(2,0)$" :db/ensure [:answer/validate]} {:db/id "q-9461/selection/e469e30323c1c6b1abfd9d3f935f2756448f37b78a287125987db4925cefdabe" :answer/id #uuid "5dad6ca9-58c7-59eb-8853-5ff946f23abe" :answer/type :answer.type/math :answer/value "(1\\pm \\sqrt{2},0)" :db/ensure [:answer/validate]} {:db/id "q-9461/selection/b89ef750f16bc3028aec19353453cacb5f6d5fbf4e7265b8a7749b1a3a47f8a8" :answer/id #uuid "01e87915-1e7b-562c-8c11-a63d42719a98" :answer/type :answer.type/text :answer/value "$(-3,0)$ and $(1,0)$" :db/ensure [:answer/validate]} {:db/id "q-9461/selection" :answer-field/id #uuid "14a15f87-933a-5b64-9f43-2de5fd23f841" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9461/selection/22b554a3013bb1fb8496e86f98c5dac72b29c91b686e766107f6f4d9d69a4a77" :answer-field/choices ["q-9461/selection/22b554a3013bb1fb8496e86f98c5dac72b29c91b686e766107f6f4d9d69a4a77" "q-9461/selection/4091bfd76ae298ceb4a683cffe12a124fd2f166152e89ed75cbf45912771acf2" "q-9461/selection/e45c584892f2c347ed70093e892c50c363f505921f5544db81df2716a40367ee" "q-9461/selection/e469e30323c1c6b1abfd9d3f935f2756448f37b78a287125987db4925cefdabe" "q-9461/selection/b89ef750f16bc3028aec19353453cacb5f6d5fbf4e7265b8a7749b1a3a47f8a8"] :db/ensure [:answer-field/validate]} {:db/id "q-9461" :question/id #uuid "c118445f-8af4-5515-9f4b-7c6040808075" :question/math-academy-id "q-9461" :question/problem "Calculate the points where the ellipse ${x}^{2}+3{y}^{2}+6x+6y=3$  intercepts the $x$-axis." :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}+6x+6y & =3 \\\\ {x}^{2}+3\\cdot {0}^{2}+6x+6\\cdot 0 & =3 \\\\ {x}^{2}+6x & =3 \\\\ (x+3)^{2}-9 & =3 \\\\ (x+3)^{2} & =3+9 \\\\ (x+3)^{2} & =12 \\\\ x+3 & =\\pm 2\\sqrt{3} \\\\ x & =-3\\pm 2\\sqrt{3}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at $(-3-2\\sqrt{3},0)$ and $(-3+2\\sqrt{3},0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-9461/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-9461"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326042/field-1/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" :answer/id #uuid "4b3b7519-12eb-5ab1-9892-4ad1ef482105" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-326042/field-1" :answer-field/id #uuid "4685700b-2f4c-5738-8854-51b4e36bcdf7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326042/field-1/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" :answer-field/choices ["q-326042/field-1/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f"] :db/ensure [:answer-field/validate]} {:db/id "q-326042/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "afb77033-5bff-5f7b-af40-2852be4204b4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-326042/field-2" :answer-field/id #uuid "25f10560-6332-57b2-8efb-723c4109450c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-326042/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-326042/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-326042" :question/id #uuid "55778a1f-c4b7-5bf3-8c36-14a56c602b7c" :question/math-academy-id "q-326042" :question/problem "Calculate the point where the ellipse  $4{x}^{2}+6{y}^{2}+12x+24y+9=0$ intercepts the $x$-axis.\n\nThe $x$-intercept is $($\n{{field-1}}\n,\n{{field-2}}$).$" :question/worked-solution "To calculate the $x$-intercepts, we need to substitute $y=0$ into the equation of the ellipse and solve the resulting equation for $x.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}4{x}^{2}+6{y}^{2}+12x+24y+9 & =0 \\\\ 4{x}^{2}+6\\cdot {0}^{2}+12x+24\\cdot 0+9 & =0 \\\\ 4{x}^{2}+12x+9 & =0 \\\\ (2x+3)^{2} & =0 \\\\ 2x+3 & =0 \\\\ x & =-\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $x$-axis at  $(-\\frac{3}{2},0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-326042/field-1" "q-326042/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6381faa4-5dfd-58fa-ace7-411fd2a97e98"] :knowledge-point/questions ["q-326042"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328527/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "5b200b06-bf5f-533c-bfdf-84942b8d6f80" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328527/field-1" :answer-field/id #uuid "6983fe3a-713b-5b13-8875-055cf9b0717e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328527/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328527/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328527/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ef63e84b-4e83-5206-a522-6c11382c87a4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328527/field-2" :answer-field/id #uuid "d93b1327-0537-5563-84b9-4738a20bc1a4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328527/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328527/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328527/field-3/b046c3ba985a20909664745cd8c54614308bf0b1a33245d0b2e0e268c8ec75e2" :answer/id #uuid "8ea3d861-8a74-54fa-9573-6809f894919d" :answer/type :answer.type/math :answer/value "-\\frac{22}{5}" :db/ensure [:answer/validate]} {:db/id "q-328527/field-3" :answer-field/id #uuid "f6ea4876-62c4-5fb1-9e27-9ab0febf1402" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328527/field-3/b046c3ba985a20909664745cd8c54614308bf0b1a33245d0b2e0e268c8ec75e2" :answer-field/choices ["q-328527/field-3/b046c3ba985a20909664745cd8c54614308bf0b1a33245d0b2e0e268c8ec75e2"] :db/ensure [:answer-field/validate]} {:db/id "q-328527" :question/id #uuid "a9b9dc65-fcd0-5105-8764-5a33b3bbe450" :question/math-academy-id "q-328527" :question/problem "From **top to bottom**, the ellipse $\\frac{(x-4)^{2}}{25}+\\frac{(y+2)^{2}}{16}=1$ intercepts the $y$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,\\frac{2}{5})\\,$\n\nand \n\n$\\,B($\n{{field-2}}$,$\n{{field-3}}\n$)$" :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-4)^{2}}{25}+\\frac{(y+2)^{2}}{16} & =1 \\\\ \\frac{(0-4)^{2}}{25}+\\frac{(y+2)^{2}}{16} & =1 \\\\ \\frac{16}{25}+\\frac{(y+2)^{2}}{16} & =1 \\\\ 256+25(y+2)^{2} & =400 \\\\ 25(y+2)^{2} & =144 \\\\ (y+2)^{2} & =\\frac{144}{25} \\\\ y+2 & =\\pm \\frac{12}{5} \\\\ y & =-2\\pm \\frac{12}{5} \\\\ y & =-\\frac{22}{5},\\frac{2}{5}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,\\frac{2}{5})\\,\\text{and}\\,B(0,-\\frac{22}{5}).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328527/field-1" "q-328527/field-2" "q-328527/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-328527"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9467/selection/ca60314b72d361f4741886b033a562c60ade90c6ff1d05d9e7c9858167996ec3" :answer/id #uuid "5d156dea-6432-572c-a444-30a17b7705c8" :answer/type :answer.type/text :answer/value "$(0,-2)$ and $(0,3)$" :db/ensure [:answer/validate]} {:db/id "q-9467/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" :answer/id #uuid "a58cb241-c60e-5299-ad58-a5a5359e57fd" :answer/type :answer.type/text :answer/value "There is no $y$-intercept" :db/ensure [:answer/validate]} {:db/id "q-9467/selection/6044746d81a998f29c58985dbf134c104c838c50c710fbac3b136834478dc847" :answer/id #uuid "553f9051-6c24-5eee-8280-8bdfafa595da" :answer/type :answer.type/math :answer/value "(0,-1)" :db/ensure [:answer/validate]} {:db/id "q-9467/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" :answer/id #uuid "d9805dc2-05da-5fff-ba9e-2236db0cbb39" :answer/type :answer.type/math :answer/value "(0,1)" :db/ensure [:answer/validate]} {:db/id "q-9467/selection/83df69fe4a35199940b9647364f7f39421d662829ee23a53f02b61ff15e364ac" :answer/id #uuid "b6ce7357-8e94-55f0-8254-f92c8ed12a07" :answer/type :answer.type/text :answer/value "$(0,-3)$ and $(0,2)$" :db/ensure [:answer/validate]} {:db/id "q-9467/selection" :answer-field/id #uuid "6be86e06-edb0-5a45-8312-a3372faf7842" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9467/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" :answer-field/choices ["q-9467/selection/ca60314b72d361f4741886b033a562c60ade90c6ff1d05d9e7c9858167996ec3" "q-9467/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" "q-9467/selection/6044746d81a998f29c58985dbf134c104c838c50c710fbac3b136834478dc847" "q-9467/selection/49dd955f7246aaaf8b0009bb70935ca10c0397c18703e7d61cbb9a56e3d7ae6f" "q-9467/selection/83df69fe4a35199940b9647364f7f39421d662829ee23a53f02b61ff15e364ac"] :db/ensure [:answer-field/validate]} {:db/id "q-9467" :question/id #uuid "abc24ff4-9a14-532c-930a-11e5cec7f6a6" :question/math-academy-id "q-9467" :question/problem "Calculate the points where the ellipse $\\frac{(x+2)^{2}}{3}+\\frac{(y-3)^{2}}{9}=1$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{{(x+2)}^{2}}{3}+\\frac{{(y-3)}^{2}}{9} & =1 \\\\ \\frac{{(0+2)}^{2}}{3}+\\frac{{(y-3)}^{2}}{9} & =1 \\\\ \\frac{4}{3}+\\frac{{(y-3)}^{2}}{9} & =1 \\\\ 12+{(y-3)}^{2} & =9 \\\\ {(y-3)}^{2} & =-3.\\end{aligned}\n$$\n\nSince $(y-3)^{2}\\ge 0$, there is no $y$ such that $(y-3)^{2}=-3.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-9467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-9467"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-16684"] :question/problem "Determine the points where the ellipse $\\frac{(x-2)^{2}}{4}+\\frac{(y+6)^{2}}{36}=1$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{4}+\\frac{(y+6)^{2}}{36} & =1 \\\\ \\frac{(0-2)^{2}}{4}+\\frac{(y+6)^{2}}{36} & =1 \\\\ 1+\\frac{(y+6)^{2}}{36} & =1 \\\\ \\frac{(y+6)^{2}}{36} & =0 \\\\ y+6 & =0 \\\\ y & =-6.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,-6).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/d3780834bd9f303ee9d7a6fff0c1fcf28ccfff4cbe4d69c9ec38691a33aca7e1.png)" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-16683/selection/91b4511052ca27450650895999fbccbe93c1795173bcb2a25bbaeffb52db74ff" :answer/id #uuid "067eaf49-7f61-5a27-a4dd-0354b9d1d951" :answer/type :answer.type/math :answer/value "(0,-7\\pm \\frac{3\\sqrt{3}}{2})" :db/ensure [:answer/validate]} {:db/id "q-16683/selection/2d5b336e9345a574578f2e5395e3d3b290b8209f9529ede30cc8735639ad0bf6" :answer/id #uuid "9117ccb5-342a-51e6-bce2-e863e1c206f9" :answer/type :answer.type/math :answer/value "(0,7\\pm \\frac{3\\sqrt{7}}{4})" :db/ensure [:answer/validate]} {:db/id "q-16683/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" :answer/id #uuid "668a3a0a-8269-59d2-a600-8840c4fbae70" :answer/type :answer.type/text :answer/value "There is no $y$-intercept" :db/ensure [:answer/validate]} {:db/id "q-16683/selection/d8823f74f37fb90392dd3e955c9a628c7527ed5c7fea84b93d19cb42f3fec734" :answer/id #uuid "70f32130-3939-5f94-85c7-a7d384f38596" :answer/type :answer.type/math :answer/value "(0,\\pm 7)" :db/ensure [:answer/validate]} {:db/id "q-16683/selection/cb584b5a26ec18b706f0fa60126da68f2cd9503b65f8959765f6ed9ba8e172ff" :answer/id #uuid "acc89d54-c83e-5ca2-b01b-119303b680bd" :answer/type :answer.type/math :answer/value "(0,7)" :db/ensure [:answer/validate]} {:db/id "q-16683/selection" :answer-field/id #uuid "aeb0e84c-b7d7-55bc-b40c-174c62dc7ac0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16683/selection/2d5b336e9345a574578f2e5395e3d3b290b8209f9529ede30cc8735639ad0bf6" :answer-field/choices ["q-16683/selection/91b4511052ca27450650895999fbccbe93c1795173bcb2a25bbaeffb52db74ff" "q-16683/selection/2d5b336e9345a574578f2e5395e3d3b290b8209f9529ede30cc8735639ad0bf6" "q-16683/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" "q-16683/selection/d8823f74f37fb90392dd3e955c9a628c7527ed5c7fea84b93d19cb42f3fec734" "q-16683/selection/cb584b5a26ec18b706f0fa60126da68f2cd9503b65f8959765f6ed9ba8e172ff"] :db/ensure [:answer-field/validate]} {:db/id "q-16683" :question/id #uuid "73127ff2-1cda-57f0-ae1f-5bfe9c540720" :question/math-academy-id "q-16683" :question/problem "Calculate the points where the ellipse $\\frac{(x+3)^{2}}{16}+\\frac{(y-7)^{2}}{9}=1$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{16}+\\frac{(y-7)^{2}}{9} & =1 \\\\ \\frac{(0+3)^{2}}{16}+\\frac{(y-7)^{2}}{9} & =1 \\\\ \\frac{9}{16}+\\frac{(y-7)^{2}}{9} & =1 \\\\ 81+16(y-7)^{2} & =9\\cdot 16 \\\\ 81+16(y-7)^{2} & =144 \\\\ 16(y-7)^{2} & =63 \\\\ (y-7)^{2} & =\\frac{63}{16} \\\\ y-7 & =\\pm \\sqrt{\\frac{63}{16}} \\\\ y-7 & =\\pm \\frac{3\\sqrt{7}}{4} \\\\ y & =7\\pm \\frac{3\\sqrt{7}}{4}.\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the points $(0,7-\\frac{3\\sqrt{7}}{4})$ and $(0,7+\\frac{3\\sqrt{7}}{4}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16683/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-16683"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328525/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "0d0fb522-af20-50be-8320-72979132453e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328525/field-1" :answer-field/id #uuid "a2f3adc0-d12b-5784-8b8b-56889690c76c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328525/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328525/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328525/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "3b2d58e0-d1f6-500c-bc5b-f51f57ddeaf9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328525/field-2" :answer-field/id #uuid "6148b6ee-79a6-592d-a4cc-8b5465cc84ab" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328525/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-328525/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-328525/field-3/b8fe8d3cb42910de21f3df8634e1c373223a74d32bfef959cca9ceacd5c4d03e" :answer/id #uuid "1b42ec80-7bc2-53a8-bd9f-3372bfe2fb84" :answer/type :answer.type/math :answer/value "-\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-328525/field-3" :answer-field/id #uuid "0f84eea5-2fb7-5c5b-9eae-7b0dcf4327fd" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-328525/field-3/b8fe8d3cb42910de21f3df8634e1c373223a74d32bfef959cca9ceacd5c4d03e" :answer-field/choices ["q-328525/field-3/b8fe8d3cb42910de21f3df8634e1c373223a74d32bfef959cca9ceacd5c4d03e"] :db/ensure [:answer-field/validate]} {:db/id "q-328525" :question/id #uuid "089dcf31-aaaf-55cc-ada0-5bd4d18c4900" :question/math-academy-id "q-328525" :question/problem "From **top to bottom**, the ellipse $\\frac{(x-3)^{2}}{12}+\\frac{(y+2)^{2}}{9}=1$ intercepts the $y$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,-\\frac{1}{2})\\,$\n\nand \n\n$\\,B($\n{{field-2}}$,$\n{{field-3}}\n$)$" :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and solve the resulting equation for $y.$ Doing this, we get\n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{12}+\\frac{(y+2)^{2}}{9} & =1 \\\\ \\frac{(0-3)^{2}}{12}+\\frac{(y+2)^{2}}{9} & =1 \\\\ \\frac{9}{12}+\\frac{(y+2)^{2}}{9} & =1 \\\\ \\frac{3}{4}+\\frac{(y+2)^{2}}{9} & =1 \\\\ 9\\,(\\frac{3}{4})+(y+2)^{2} & =9 \\\\ \\frac{27}{4}+(y+2)^{2} & =\\frac{36}{4} \\\\ (y+2)^{2} & =\\frac{9}{4} \\\\ y+2 & =\\pm \\frac{3}{2} \\\\ y & =-2\\pm \\frac{3}{2} \\\\ y & =-\\frac{1}{2},-\\frac{7}{2}.\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA(0,\\,-\\frac{1}{2})\\,\\text{and}\\,B(0,\\,-\\frac{7}{2}).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328525/field-1" "q-328525/field-2" "q-328525/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a57ec9ff-99fd-5a3d-9a89-e76ded9d01cb"] :knowledge-point/questions ["q-328525"] :db/ensure [:knowledge-point/validate]} {:db/id "q-328517/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "271d39ba-e44c-5311-a27e-98f4bbbe3deb" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-328517/field-1" :answer-field/id #uuid "ab9005b6-00df-50d2-8547-02da027e4dab" :answer-field/key "field-1" :answer-field/type 