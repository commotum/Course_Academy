ld-4/156b802b8fc2d79595049a24ddbf7c331559505374731cb04c3ab50c79be092c" :answer-field/choices ["q-328517/field-4/156b802b8fc2d79595049a24ddbf7c331559505374731cb04c3ab50c79be092c"] :db/ensure [:answer-field/validate]} {:db/id "q-328517" :question/id #uuid "297fe128-9264-50ed-838b-4c61ab2d1cbc" :question/math-academy-id "q-328517" :question/problem "From **top to bottom**, the ellipse $4{x}^{2}+{y}^{2}-8x-8y+11=0$ intercepts the $y$-axis at the points $A$ and $B.$ Find the coordinates of these points.\n\n$A($\n{{field-1}}\n$,$\n{{field-2}}$)\\,$\n\nand \n\n$\\,B($\n{{field-3}}$,$\n{{field-4}}$)\\,$" :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-8x-8y+11 & =0 \\\\ 4(0)^{2}+{y}^{2}-8\\cdot 0-8y+11 & =0 \\\\ {y}^{2}-8y+11 & =0 \\\\ [{y}^{2}-8y]+11 & =0 \\\\ [(y-4)^{2}-16]+11 & =0 \\\\ (y-4)^{2}-5 & =0 \\\\ (y-4)^{2} & =5 \\\\ y-4 & =\\pm \\sqrt{5} \\\\ y & =4\\pm \\sqrt{5}\\end{aligned}\n$$\n\nTherefore, from top to bottom, the $y$-intercepts are\n\n$$\nA\\,(0,4+\\sqrt{5})\\,\\text{and}\\,B\\,(0,4-\\sqrt{5}).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-328517/field-1" "q-328517/field-2" "q-328517/field-3" "q-328517/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-328517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-327146/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "74edc858-86e8-5410-81a1-f3add125c5ec" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186267932 :answer-field/choices ["q-327146/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-327146"] :question/worked-solution "To calculate the $y$-intercept, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}4{x}^{2}+{y}^{2}-8x-5y+\\frac{25}{4} & =0 \\\\ 4(0)^{2}+{y}^{2}-8(0)-5y+\\frac{25}{4} & =0 \\\\ {y}^{2}-5y+\\frac{25}{4} & =0 \\\\ {(y-\\frac{5}{2})}^{2} & =0 \\\\ y-\\frac{5}{2} & =0 \\\\ y & =\\frac{5}{2}\\end{aligned}\n$$\n\nTherefore, the ellipse intercepts the $y$-axis at the point $(0,\\frac{5}{2}).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039005/assets/0a1303644a54b07f874df4f6694d84384e634403bc4efe8ee5086d922bc6f25e.png)" :db/ensure [:question/validate]} {:db/id "q-9468/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" :answer/id #uuid "c4897e7d-684d-5124-b228-fe3dd22b31f7" :answer/type :answer.type/math :answer/value "(0,-2)" :db/ensure [:answer/validate]} {:db/id "q-9468/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" :answer/id #uuid "197fc32b-18f8-5f1d-b7bb-b4ddc9945fc1" :answer/type :answer.type/text :answer/value "There is no $y$-intercept" :db/ensure [:answer/validate]} {:db/id "q-9468/selection/5dc5346c45050060e67df02c81a9273dcc8642ec4733d100c80334e6dbacdae7" :answer/id #uuid "c3ec3f05-236c-5e61-a849-f454c4a51fc7" :answer/type :answer.type/text :answer/value "$(0,-1)$ and $(0,3)$" :db/ensure [:answer/validate]} {:db/id "q-9468/selection/56f4333305444f21ac6e627e2ada8af9cfd9b62b84d6eb7d3f6300971d270871" :answer/id #uuid "8b5cf51a-0bc3-58a6-bf67-dea1cafc39fa" :answer/type :answer.type/text :answer/value "$(0,-3)$ and $(0,1)$" :db/ensure [:answer/validate]} {:db/id "q-9468/selection/85cb4fac0396602d43dca2c00e3ca71b29816b8e6c6a13d1cfa7f3ced25f7b78" :answer/id #uuid "051e7c67-9edb-56a3-90f4-5a88147c07d1" :answer/type :answer.type/math :answer/value "(0,2)" :db/ensure [:answer/validate]} {:db/id "q-9468/selection" :answer-field/id #uuid "7e17f1e2-fdd5-5bd6-b6a3-fe3360f784c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9468/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" :answer-field/choices ["q-9468/selection/ff54de989731767e89ed471a3eb4118cafc39b059c87b75411d559c5f8b9e6d5" "q-9468/selection/8321a2979a16551077c65e6e38879453e2008e1e6ec20a58ad319189f2ffe86d" "q-9468/selection/5dc5346c45050060e67df02c81a9273dcc8642ec4733d100c80334e6dbacdae7" "q-9468/selection/56f4333305444f21ac6e627e2ada8af9cfd9b62b84d6eb7d3f6300971d270871" "q-9468/selection/85cb4fac0396602d43dca2c00e3ca71b29816b8e6c6a13d1cfa7f3ced25f7b78"] :db/ensure [:answer-field/validate]} {:db/id "q-9468" :question/id #uuid "9f068945-a72d-5d56-b777-f84b01c8b6a7" :question/math-academy-id "q-9468" :question/problem "Determine the point where the ellipse ${x}^{2}+6{y}^{2}-8x+24y+28=0$ intercepts the $y$-axis." :question/worked-solution "To calculate the $y$-intercepts, we need to substitute $x=0$ in the equation of the ellipse and try to solve the resulting equation for $y.$ We do this and solve the resulting equation by completing the square:\n\n$$\n\\begin{aligned}{x}^{2}+6{y}^{2}-8x+24y+28 & =0 \\\\ {0}^{2}+6{y}^{2}-8\\cdot 0+24y+28 & =0 \\\\ 6{y}^{2}+24y+28 & =0 \\\\ 6[{y}^{2}+4y]+28 & =0 \\\\ 6[(y+2)^{2}-4]+28 & =0 \\\\ 6(y+2)^{2}-24+28 & =0 \\\\ 6(y+2)^{2}+4 & =0 \\\\ 6(y+2)^{2} & =-4.\\end{aligned}\n$$\n\nSince $6(y+2)^{2}\\ge 0$, there is no $y$ such that $6(y+2)^{2}=-4.$ Therefore, the ellipse has no $y$-intercepts, meaning that it does not intercept the $y$-axis at any point." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-9468/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fea426db-a854-5efc-a0cd-7d52019a7cc6"] :knowledge-point/questions ["q-9468"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170551/s