 =79\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72397/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8537cc22-8d18-57c8-9ebf-921bd4d06ae7"] :knowledge-point/questions ["q-72397"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149656/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer/id #uuid "f72c58ae-4382-5b7c-bac8-0f38a40a5c0b" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "q-149656/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" :answer/id #uuid "26a10fe3-3c44-5678-8753-7e01b7df09bb" :answer/type :answer.type/math :answer/value "130" :db/ensure [:answer/validate]} {:db/id "q-149656/selection/f07223adf063c43bfac440bfcfa1f5e709d54202b4c2c93d5f069881800b6a64" :answer/id #uuid "1d0028a4-d1bf-5b36-a0ec-61f70a4eda9f" :answer/type :answer.type/math :answer/value "100" :db/ensure [:answer/validate]} {:db/id "q-149656/selection/631278020d4feb6e6637bbf6f3aedefe7a2af6275b863fcbb6dd29a701c97b2d" :answer/id #uuid "d6367fe5-a9a5-58b2-b3c4-bbc9c89b82e3" :answer/type :answer.type/math :answer/value "110" :db/ensure [:answer/validate]} {:db/id "q-149656/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "c83a7605-aba5-555b-962e-e24f08a7bee6" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-149656/selection" :answer-field/id #uuid "3f37c383-59c0-59e7-ba25-a8e19ba845d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149656/selection/f07223adf063c43bfac440bfcfa1f5e709d54202b4c2c93d5f069881800b6a64" :answer-field/choices ["q-149656/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" "q-149656/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" "q-149656/selection/f07223adf063c43bfac440bfcfa1f5e709d54202b4c2c93d5f069881800b6a64" "q-149656/selection/631278020d4feb6e6637bbf6f3aedefe7a2af6275b863fcbb6dd29a701c97b2d" "q-149656/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649"] :db/ensure [:answer-field/validate]} {:db/id "q-149656" :question/id #uuid "38d56462-cbf1-5e86-b460-023450c63c10" :question/math-academy-id "q-149656" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{40}5({a}_{ij}-{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{40}{a}_{ij}=220,\\,{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{40}{b}_{ij}=200.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying these rules to the given sum, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{40}5({a}_{ij}-{b}_{ij}) & =5{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{40}({a}_{ij}-{b}_{ij}) \\\\  & =5{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{40}{a}_{ij}-5{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{40}{b}_{ij} \\\\  & =5\\cdot 220-5\\cdot 200 \\\\  & =1,100-1,000 \\\\  & =100.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-149656/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd"] :knowledge-point/questions ["q-149656"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149676/selection/eb57fb392c21478621c4c209554229c785123f38918aca582a228a144fdce87a" :answer/id #uuid "71c0f49a-415f-5a0e-8c96-7cc657ba28aa" :answer/type :answer.type/math :answer/value "75" :db/ensure [:answer/validate]} {:db/id "q-149676/selection/a2ce0d7121680ad5ca64b109a32cd456c311ade4af21eb0a0dd652e8319117f1" :answer/id #uuid "afcf76d6-3dea-51ba-a7e4-9c1a168914ec" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id "q-149676/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" :answer/id #uuid "a188518a-819c-5e89-a010-8674b6e34d2c" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "q-149676/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" :answer/id #uuid "32b618fd-84cb-5abd-b0af-d8616c1b7ae3" :answer/type :answer.type/math :answer/value "65" :db/ensure [:answer/validate]} {:db/id "q-149676/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "398e8e8b-aff2-5edf-a956-678522685bea" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-149676/selection" :answer-field/id #uuid "f03e86d1-ba0b-5a25-92d0-ef9f8b9fa24b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149676/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" :answer-field/choices ["q-149676/selection/eb57fb392c21478621c4c209554229c785123f38918aca582a228a144fdce87a" "q-149676/selection/a2ce0d7121680ad5ca64b109a32cd456c311ade4af21eb0a0dd652e8319117f1" "q-149676/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" "q-149676/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" "q-149676/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc"] :db/ensure [:answer-field/validate]} {:db/id "q-149676" :question/id #uuid "a4326694-54aa-5ca1-8295-67918bfd804e" :question/math-academy-id "q-149676" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}({a}_{ij}+{b}_{ij}-2)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}{a}_{ij}=300,\\,{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}{b}_{ij}=250.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}({a}_{ij}+{b}_{ij}-2) & ={\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}{a}_{ij}+{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}{b}_{ij}-{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}2 \\\\  & =300+250-(2{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}1) \\\\  & =550-2({\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}1).\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}550-2({\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}1) & =550-2\\cdot (15\\cdot 16) \\\\  & =550-480 \\\\  & =70.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{16}({a}_{ij}+{b}_{ij}-2)=70.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-149676/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd"] :knowledge-point/questions ["q-149676"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149661/selection/42aff35720b567089407a2a0cf7c70ff6334c9493e4d877ecdcdfa86adae004c" :answer/id #uuid "2ca0fa06-3de7-523d-8346-b0993d420cc2" :answer/type :answer.type/math :answer/value "150" :db/ensure [:answer/validate]} {:db/id "q-149661/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "896a4d90-78cc-5707-a715-c85cb45179a6" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-149661/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" :answer/id #uuid "b12b841e-010d-5f40-9611-b719716d0b1e" :answer/type :answer.type/math :answer/value "130" :db/ensure [:answer/validate]} {:db/id "q-149661/selection/ae1ec0bcc83ac82fe7d363f2ad54fe23dc343f2913e126433b39173ac74d85e6" :answer/id #uuid "6313883d-5de0-5960-a31b-017f0e296ebb" :answer/type :answer.type/math :answer/value "160" :db/ensure [:answer/validate]} {:db/id "q-149661/selection/2dc9539b1cae5422841480b1cf8698050a67f73e90df6bc3af3be02ebaa8e890" :answer/id #uuid "5297db7c-cae7-50cd-ac5f-402c45d9feaf" :answer/type :answer.type/math :answer/value "140" :db/ensure [:answer/validate]} {:db/id "q-149661/selection" :answer-field/id #uuid "e5ebd467-11c3-5f0a-b099-d5ff547fdae0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149661/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" :answer-field/choices ["q-149661/selection/42aff35720b567089407a2a0cf7c70ff6334c9493e4d877ecdcdfa86adae004c" "q-149661/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" "q-149661/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" "q-149661/selection/ae1ec0bcc83ac82fe7d363f2ad54fe23dc343f2913e126433b39173ac74d85e6" "q-149661/selection/2dc9539b1cae5422841480b1cf8698050a67f73e90df6bc3af3be02ebaa8e890"] :db/ensure [:answer-field/validate]} {:db/id "q-149661" :question/id #uuid "78a51fd9-8d34-52f1-82e6-e61ba25914f8" :question/math-academy-id "q-149661" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}(1+{a}_{ij}-{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}{a}_{ij}=20,\\,{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}{b}_{ij}=10.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}(1+{a}_{ij}-{b}_{ij}) & ={\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}1+{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}{a}_{ij}-{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}1)+20-10 \\\\  & =({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}1)+10.\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}1)+10 & =10\\cdot 12+10 \\\\  & =120+10 \\\\  & =130.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{12}(1+{a}_{ij}-{b}_{ij})=130.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-149661/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd"] :knowledge-point/questions ["q-149661"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-149603"] :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}(1-{a}_{ij}-{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}{a}_{ij}=10,\\,{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}{b}_{ij}=20.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}(1-{a}_{ij}-{b}_{ij}) & ={\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}1-{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}{a}_{ij}-{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}1)-10-20 \\\\  & =({\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}1)-30.\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}1)-30 & =5\\cdot 10-30 \\\\  & =50-30 \\\\  & =20.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{5}{\\sum }_{j=1}^{10}(1-{a}_{ij}-{b}_{ij})=20.\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-149658/selection/ceeb45a591a9149928d526611589351bf4d69ef474587b1e33a35f64c8a092e4" :answer/id #uuid "eaf11a1a-6320-56b5-b2e3-225cdc796ffd" :answer/type :answer.type/math :answer/value "370" :db/ensure [:answer/validate]} {:db/id "q-149658/selection/2e3ac8a9be268ab7b7c07f98cd54459f6b3b2f925f90387606bc9479a0d5dbfd" :answer/id #uuid "c4551799-b919-5937-8bca-d4a013d31d7b" :answer/type :answer.type/math :answer/value "340" :db/ensure [:answer/validate]} {:db/id "q-149658/selection/d5ed3ac547233a6f335c11bcc929110d91d964f6abceff82a41a501ec761b8f3" :answer/id #uuid "c0ba6273-8d28-5cd6-8674-f7380ff8d525" :answer/type :answer.type/math :answer/value "350" :db/ensure [:answer/validate]} {:db/id "q-149658/selection/20a23d5229906dcc2803cae6c4384e067965769fbaf836025afb803afd7eea4c" :answer/id #uuid "e687e59b-bd5e-5091-af45-549909da909a" :answer/type :answer.type/math :answer/value "380" :db/ensure [:answer/validate]} {:db/id "q-149658/selection/fa2764e4d443b0fd1a8b9b79f38b985d2b576f72681c3b867c06cfeb24c839e4" :answer/id #uuid "7c4eb561-a931-55e4-8d26-794b52f181fe" :answer/type :answer.type/math :answer/value "360" :db/ensure [:answer/validate]} {:db/id "q-149658/selection" :answer-field/id #uuid "2151875a-93a5-5122-9b63-f0ef4175404b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149658/selection/ceeb45a591a9149928d526611589351bf4d69ef474587b1e33a35f64c8a092e4" :answer-field/choices ["q-149658/selection/ceeb45a591a9149928d526611589351bf4d69ef474587b1e33a35f64c8a092e4" "q-149658/selection/2e3ac8a9be268ab7b7c07f98cd54459f6b3b2f925f90387606bc9479a0d5dbfd" "q-149658/selection/d5ed3ac547233a6f335c11bcc929110d91d964f6abceff82a41a501ec761b8f3" "q-149658/selection/20a23d5229906dcc2803cae6c4384e067965769fbaf836025afb803afd7eea4c" "q-149658/selection/fa2764e4d443b0fd1a8b9b79f38b985d2b576f72681c3b867c06cfeb24c839e4"] :db/ensure [:answer-field/validate]} {:db/id "q-149658" :question/id #uuid "f6977d60-a2ed-5069-b7de-47e979b8077a" :question/math-academy-id "q-149658" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}(3{a}_{ij}+4{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}{a}_{ij}=50,\\,{\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}{b}_{ij}=55.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying these rules to the given sum, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}(3{a}_{ij}+4{b}_{ij}) & ={\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}3{a}_{ij}+{\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}4{b}_{ij} \\\\  & =3{\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}{a}_{ij}+4{\\sum }_{i=1}^{25}{\\sum }_{j=1}^{70}{b}_{ij} \\\\  & =3\\cdot 50+4\\cdot 55 \\\\  & =150+220 \\\\  & =370.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-149658/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd"] :knowledge-point/questions ["q-149658"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149726/selection/e4e5059e43747775ab