cademy-id "q-72401" :question/problem "${\\sum }_{j=1}^{2}{\\sum }_{i=1}^{2}{2}^{i+j}=$" :question/worked-solution "First, we write out the inner summation by summing over the index $i:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{2}{\\sum }_{i=1}^{2}{2}^{i+j} & ={\\sum }_{j=1}^{2}[{\\sum }_{i=1}^{2}{2}^{i+j}] \\\\  & ={\\sum }_{j=1}^{2}({2}^{1+j}+{2}^{2+j}) \\\\  & ={\\sum }_{j=1}^{2}({2}^{1+j}+{2}^{2+j})\\end{aligned}\n$$\n\nNext, we sum over the index $j:$\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{2}({2}^{1+j}+{2}^{2+j}) & =({2}^{1+1}+{2}^{2+1})+({2}^{2+1}+{2}^{2+2}) \\\\  & =(4+8)+(8+16) \\\\  & =36\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72401/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8537cc22-8d18-57c8-9ebf-921bd4d06ae7"] :knowledge-point/questions ["q-72401"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72399/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "486b3146-648e-52db-ba91-98636d5a98c3" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-72399/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer/id #uuid "711c1da8-ae0a-575d-bfdb-a3962947c4d6" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "q-72399/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "c3eec983-a3b7-5e01-8214-1465b2a0dcba" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-72399/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "c0c9d668-59d0-5980-9294-69c7e019dfe4" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-72399/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326" :answer/id #uuid "c118fbcc-ecd2-5b78-a2f4-96abb1739f3b" :answer/type :answer.type/math :answer/value "84" :db/ensure [:answer/validate]} {:db/id "q-72399/selection" :answer-field/id #uuid "26e38ca1-b05b-5753-9bd1-a305837276e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72399/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer-field/choices ["q-72399/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" "q-72399/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" "q-72399/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" "q-72399/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-72399/selection/842947b00d8ffc5745884eed061ea57d57affe318d15d13be5c3612b41e13326"] :db/ensure [:answer-field/validate]} {:db/id "q-72399" :question/id #uuid "243cc13e-53eb-5717-a1d8-f55967d77d3c" :question/math-academy-id "q-72399" :question/problem "${\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}i{j}^{2}=$" :question/worked-solution "First, we write out the inner summation by summing over the index $j:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{3}{\\sum }_{j=1}^{2}i{j}^{2} & ={\\sum }_{i=1}^{3}[{\\sum }_{j=1}^{2}i{j}^{2}] \\\\  & ={\\sum }_{i=1}^{3}(i\\cdot {1}^{2}+i\\cdot {2}^{2}) \\\\  & ={\\sum }_{i=1}^{3}(i+4i) \\\\  & ={\\sum }_{i=1}^{3}5i\\end{aligned}\n$$\n\nNext, we sum over the index $i:$\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{3}5i & =5\\cdot 1+5\\cdot 2+5\\cdot 3 \\\\  & =5+10+15 \\\\  & =30\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72399/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8537cc22-8d18-57c8-9ebf-921bd4d06ae7"] :knowledge-point/questions ["q-72399"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72398/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "66df2178-83c4-584c-b143-aff474e3ac5e" :answer/type :answer.type/math :answer/value "6" :db/ensure [: