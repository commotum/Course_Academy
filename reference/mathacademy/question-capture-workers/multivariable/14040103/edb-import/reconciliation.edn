{3}^{2}}} \\\\  & =\\frac{10}{\\sqrt{14}\\cdot \\sqrt{14}} \\\\  & =\\frac{10}{14} \\\\  & =\\frac{5}{7}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{5}{7})≈{44}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19035" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-19035" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19035" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{35}^{∘}"] ["math" "{41}^{∘}"] ["math" "{44}^{∘}"] ["math" "{48}^{∘}"] ["math" "{78}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19035" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{44}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-67797" "field" nil "attribute" "question/problem" "value" "Find the angle between $a=⟨-1,7,0⟩$ and $b=⟨3,6,-1⟩.$ Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-67797" "field" nil "attribute" "question/worked-solution" "value" "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 3+7\\cdot 6+0\\cdot (-1)}{\\sqrt{(-1)^{2}+{7}^{2}+{0}^{2}}\\sqrt{{3}^{2}+{6}^{2}+(-1)^{2}}} \\\\  & =\\frac{39}{\\sqrt{50}\\cdot \\sqrt{46}} \\\\  & =\\frac{39}{\\sqrt{2300}} \\\\  & =\\frac{39}{10\\sqrt{23}}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{39}{10\\sqrt{23}})≈{35.6}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-67797" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-67797" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-67797" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{31.7}^{∘}"] ["math" "{35.6}^{∘}"] ["math" "{42.3}^{∘}"] ["math" "{45.3}^{∘}"] ["math" "{47.1}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-67797" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{35.6}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124802" "field" nil "attribute" "question/problem" "value" "Find the angle between $a=⟨3,1,1⟩$ and $b=⟨1,3,1⟩.$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124802" "field" nil "attribute" "question/worked-solution" "value" "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{3\\cdot 1+1\\cdot 3+1\\cdot 1}{\\sqrt{{3}^{2}+{1}^{2}+{1}^{2}}\\sqrt{{1}^{2}+{3}^{2}+{1}^{2}}} \\\\  & =\\frac{7}{\\sqrt{11}\\cdot \\sqrt{11}} \\\\  & =\\frac{7}{11}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{7}{11})≈{50}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124802" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-124802" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124802" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{45}^{∘}"] ["math" "{48}^{∘}"] ["math" "{50}^{∘}"] ["math" "{53}^{∘}"] ["math" "{57}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124802" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{50}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124813" "field" nil "attribute" "question/problem" "value" "Find $∠BAC$ given the points $A(2,-1,2)$, $B(3,-5,1)$, and $C(1,-4,-1).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124813" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,2⟩,\\,b=⟨3,-5,1⟩,\\,c=⟨1,-4,-1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,-5,1⟩-⟨2,-1,2⟩ \\\\  & =⟨1,-4,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨1,-4,-1⟩-⟨2,-1,2⟩ \\\\  & =⟨-1,-3,-3⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-1)+(-4)\\cdot (-3)+(-1)\\cdot (-3)}{\\sqrt{{1}^{2}+(-4)^{2}+(-1)^{2}}\\sqrt{(-1)^{2}+(-3)^{2}+(-3)^{2}}} \\\\  & =\\frac{14}{\\sqrt{18}\\cdot \\sqrt{19}} \\\\  & =\\frac{14}{3\\sqrt{38}}\\,.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{14}{3\\sqrt{38}})≈{41}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124813" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-124813" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124813" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{35}^{∘}"] ["math" "{38}^{∘}"] ["math" "{41}^{∘}"] ["math" "{46}^{∘}"] ["math" "{50}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124813" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{41}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101511" "field" nil "attribute" "question/problem" "value" "Find $∠BAC$ given the points $A(2,-1,1)$, $B(3,1,-2)$, and $C(-1,1,1).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101511" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,1⟩,\\,b=⟨3,1,-2⟩,\\,c=⟨-1,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,1,-2⟩-⟨2,-1,1⟩ \\\\  & =⟨1,2,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨-1,1,1⟩-⟨2,-1,1⟩ \\\\  & =⟨-3,2,0⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-3)+2\\cdot 2+(-3)\\cdot 0}{\\sqrt{{1}^{2}+{2}^{2}+(-3)^{2}}\\sqrt{(-3)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{14}\\cdot \\sqrt{13}} \\\\  & =\\frac{1}{\\sqrt{182}}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{182}})≈{86}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101511" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-101511" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101511" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{77}^{∘}"] ["math" "{79}^{∘}"] ["math" "{81}^{∘}"] ["math" "{86}^{∘}"] ["math" "{91}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101511" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{86}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19110" "field" nil "attribute" "question/problem" "value" "Find $∠QPR$ given the points $P(0,4,5)$, $Q(1,5,4)$, and $R(2,3,6).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19110" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨0,4,5⟩,\\,q=⟨1,5,4⟩,\\,r=⟨2,3,6⟩.\\end{aligned}\n$$\n\nThe $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨1,5,4⟩-⟨0,4,5⟩ \\\\  & =⟨1,1,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨2,3,6⟩-⟨0,4,5⟩ \\\\  & =⟨2,-1,1⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{1\\cdot 2+1\\cdot (-1)+(-1)\\cdot 1}{\\sqrt{{1}^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{0}{\\sqrt{3}\\cdot \\sqrt{6}} \\\\  & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(0)={90}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19110" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-19110" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19110" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{120}^{∘}"] ["math" "{45}^{∘}"] ["math" "{60}^{∘}"] ["math" "{75}^{∘}"] ["math" "{90}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19110" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{90}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124826" "field" nil "attribute" "question/problem" "value" "Find $∠XZY$ given the points $X(-2,1,0)$, $Y(-1,0,4)$, and $Z(-1,2,-2).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124826" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $X$, $Y$, $Z$ are\n\n$$\n\\begin{aligned}x=⟨-2,1,0⟩,\\,y=⟨-1,0,4⟩,\\,z=⟨-1,2,-2⟩.\\end{aligned}\n$$\n\nThe $△XYZ$ is shown (schematically) in the diagram below, where we denote $∠XZY=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/87453fecb9da6b9e673ab5a85a289a3fac73f4fb90fc8f1b33e7c0a80b1ea77f.png)\n\nFirst, we find the components of $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{ZX} & =x-z \\\\  & =⟨-2,1,0⟩-⟨-1,2,-2⟩ \\\\  & =⟨-1,-1,2⟩ \\\\ \\overset{\\to }{ZY} & =y-z \\\\  & =⟨-1,0,4⟩-⟨-1,2,-2⟩ \\\\  & =⟨0,-2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{ZX}$ and $\\overset{\\to }{ZY}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{ZX}\\cdot \\overset{\\to }{ZY}}{|\\overset{\\to }{ZX}||\\overset{\\to }{ZY}|} \\\\  & =\\frac{(-1)\\cdot 0+(-1)\\cdot (-2)+2\\cdot 6}{\\sqrt{(-1)^{2}+(-1)^{2}+{2}^{2}}\\sqrt{{0}^{2}+(-2)^{2}+{6}^{2}}} \\\\  & =\\frac{14}{\\sqrt{6}\\cdot \\sqrt{40}} \\\\  & =\\frac{14}{\\sqrt{240}} \\\\  & =\\frac{14}{4\\sqrt{15}} \\\\  & =\\frac{7}{2\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{7}{2\\sqrt{15}})={25}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124826" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-124826" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124826" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{21}^{∘}"] ["math" "{23}^{∘}"] ["math" "{25}^{∘}"] ["math" "{28}^{∘}"] ["math" "{30}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-124826" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{25}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19112" "field" nil "attribute" "question/problem" "value" "Find $∠BAC$ given the points $A(3,-3,1)$, $B(5,-3,3)$, and $C(3,-2,3).$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19112" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨3,-3,1⟩,\\,b=⟨5,-3,3⟩,\\,c=⟨3,-2,3⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨5,-3,3⟩-⟨3,-3,1⟩ \\\\  & =⟨2,0,2⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨3,-2,3⟩-⟨3,-3,1⟩ \\\\  & =⟨0,1,2⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{2\\cdot 0+0\\cdot 1+2\\cdot 2}{\\sqrt{{2}^{2}+{0}^{2}+{2}^{2}}\\sqrt{{0}^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{4}{\\sqrt{8}\\cdot \\sqrt{5}} \\\\  & =\\frac{4}{2\\sqrt{10}} \\\\  & =\\frac{2}{\\sqrt{10}}\\,.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{\\sqrt{10}})≈{51}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19112" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-19112" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19112" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{102}^{∘}"] ["math" "{33}^{∘}"] ["math" "{48}^{∘}"] ["math" "{51}^{∘}"] ["math" "{66}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19112" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{51}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101520" "field" nil "attribute" "question/problem" "value" "Consider the points $D(t,5,3)$, $E({t}^{2},2,t)$ and $F(t+3,{t}^{2},1).$ Find $∠EDF$ given that $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=6.$ Round your answer to $2$ decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101520" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $D$, $E$, $F$ are\n\n$$\n\\begin{aligned}d=⟨t,\\,5,\\,3⟩,\\,e=⟨{t}^{2},\\,2,\\,t⟩,\\,f=⟨t+3,\\,{t}^{2},\\,1⟩.\\end{aligned}\n$$\n\nThe triangle $△DEF$ is shown (schematically) in the diagram below, where we denote $∠EDF=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/c9cfb3e84e6f76d243125f2a09246b2a1300a0134e71359bb2b528082f064f93.png)\n\nFirst, we find the components of $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =⟨{t}^{2},\\,2,\\,t⟩-⟨t,\\,5,\\,3⟩ \\\\  & =⟨{t}^{2}-t,\\,-3,\\,t-3⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =⟨t+3,\\,{t}^{2},\\,1⟩-⟨t,\\,5,\\,3⟩ \\\\  & =⟨3,\\,{t}^{2}-5,\\,-2⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=6$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF} & =6 \\\\ ({t}^{2}-t)\\cdot 3+(-3)\\cdot ({t}^{2}-5)+(t-3)\\cdot (-2) & =6 \\\\ 3{t}^{2}-3t-3{t}^{2}+15-2t+6 & =6 \\\\ -5t+21 & =6 \\\\ -5t & =-15 \\\\ t & =3\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨{3}^{2}-3,-3,3-3⟩ \\\\  & =⟨6,-3,0⟩, \\\\ \\overset{\\to }{DF} & =⟨3,{3}^{2}-5,-2⟩ \\\\  & =⟨3,4,-2⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}}{|\\overset{\\to }{DE}||\\overset{\\to }{DF}|} \\\\  & =\\frac{6}{\\sqrt{{6}^{2}+(-3)^{2}+{0}^{2}}\\sqrt{{3}^{2}+{4}^{2}+(-2)^{2}}} \\\\  & =\\frac{6}{3\\sqrt{5}\\cdot \\sqrt{29}} \\\\  & =\\frac{2}{\\sqrt{145}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{\\sqrt{145}})≈{80.44}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101520" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-101520" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101520" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{70.99}^{∘}"] ["math" "{75.22}^{∘}"] ["math" "{78.55}^{∘}"] ["math" "{80.44}^{∘}"] ["math" "{85.33}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101520" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{80.44}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77167" "field" nil "attribute" "question/problem" "value" "Consider the points $A(2t,4,3),$ $B(5t-1,4,3)$ and $C(2t+4,t+5,3).$ Find $∠BAC$ given that $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=8.$ Round your answer to $2$ decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77167" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A,$ $B$ and $C$ are\n\n$$\n\\begin{aligned}a=⟨2t,\\,4,\\,3⟩,\\,b=⟨5t-1,\\,4,\\,3⟩,\\,c=⟨2t+4,\\,t+5,\\,3⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨5t-1,\\,4,\\,3⟩-⟨2t,\\,4,\\,3⟩ \\\\  & =⟨3t-1,\\,0,\\,0⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨2t+4,\\,t+5,\\,3⟩-⟨2t,\\,4,\\,3⟩ \\\\  & =⟨4,\\,t+1,\\,0⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=8,$ we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC} & =8 \\\\ (3t-1)\\cdot 4+0\\cdot (t+1)+0\\cdot 0 & =8 \\\\ 4(3t-1)+0+0 & =8 \\\\ 12t-4 & =8 \\\\ 12t & =12 \\\\ t & =1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨2,0,0⟩, \\\\ \\overset{\\to }{AC} & =⟨4,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{8}{\\sqrt{{2}^{2}+{0}^{2}+{0}^{2}}\\cdot \\sqrt{{4}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{4}\\cdot \\sqrt{20}} \\\\  & =\\frac{8}{\\sqrt{80}} \\\\  & =\\frac{8}{4\\sqrt{5}} \\\\  & =\\frac{2}{\\sqrt{5}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{\\sqrt{5}})≈{26.57}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77167" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-77167" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77167" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{10.52}^{∘}"] ["math" "{21.42}^{∘}"] ["math" "{26.57}^{∘}"] ["math" "{63.43}^{∘}"] ["math" "{77.07}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77167" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{26.57}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77164" "field" nil "attribute" "question/problem" "value" "Consider the points $A(3t,t,4),$ $B(3t,4t,3)$ and $C(5t,t+1,5).$ Find $∠BAC$ given that $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2.$ Round your answer to the nearest degree." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77164" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A,$ $B$ and $C$ are\n\n$$\n\\begin{aligned}a=⟨3t,\\,t,\\,4⟩,\\,b=⟨3t,\\,4t,\\,3⟩,\\,c=⟨5t,\\,t+1,\\,5⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3t,\\,4t,\\,3⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨0,\\,3t,\\,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5t,\\,t+1,\\,5⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨2t,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2$, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC} & =2 \\\\ 0\\cdot 2t+3t\\cdot 1+(-1)\\cdot 1 & =2 \\\\ 3t-1 & =2 \\\\ 3t & =3 \\\\ t & =1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,3,-1⟩, \\\\ \\overset{\\to }{AC} & =⟨2,\\,1,\\,1⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{2}{\\sqrt{{0}^{2}+{3}^{2}+(-1)^{2}}\\cdot \\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{10}\\cdot \\sqrt{6}} \\\\  & =\\frac{2}{2\\sqrt{15}} \\\\  & =\\frac{1}{\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{15}})≈{75}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77164" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-77164" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77164" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{58}^{∘}"] ["math" "{65}^{∘}"] ["math" "{75}^{∘}"] ["math" "{79}^{∘}"] ["math" "{82}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-77164" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{75}^{∘}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19040" "field" nil "attribute" "question/problem" "value" "Given that $g\\cdot h=8$, find the angle between $g=⟨t,t,t-1⟩$ and $h=⟨4,-2,-1⟩.$ Round your answer to $2$ decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19040" "field" nil "attribute" "question/worked-solution" "value" "First, since $g\\cdot h=8$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}g\\cdot h & =8 \\\\ t\\cdot 4+t\\cdot (-2)+(t-1)\\cdot (-1) & =8 \\\\ 4t-2t-t+1 & =8 \\\\ t+1 & =8 \\\\ t & =7\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}g & =⟨7,7,7-1⟩ \\\\  & =⟨7,7,6⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $g$ and $h$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{g\\cdot h}{|\\,g\\,||\\,h\\,|} \\\\  & =\\frac{{g}_{x}{h}_{x}+{g}_{y}{h}_{y}+{g}_{z}{h}_{z}}{\\sqrt{{g}_{x}^{2}+{g}_{y}^{2}+{g}_{z}^{2}}\\sqrt{{h}_{x}^{2}+{h}_{y}^{2}+{h}_{z}^{2}}} \\\\  & =\\frac{8}{\\sqrt{{7}^{2}+{7}^{2}+{6}^{2}}\\sqrt{{4}^{2}+(-2)^{2}+(-1)^{2}}} \\\\  & =\\frac{8}{\\sqrt{134}\\cdot \\sqrt{21}} \\\\  & =\\frac{8}{\\sqrt{2\\,814}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{8}{\\sqrt{2\\,814}})≈{81.33}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19040" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-19040" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19040" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{67.13}^{∘}"] ["math" "{72.34}^{∘}"] ["math" "{81.33}^{∘}"] ["math" "{87.33}^{∘}"] ["math" "{88.21}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-19040" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{81.33}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101512" "field" nil "attribute" "question/problem" "value" "Given that $a\\cdot b=-5$, find the angle between $a=⟨2t,t⟩$ and $b=⟨1,3⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101512" "field" nil "attribute" "question/worked-solution" "value" "First, since $a\\cdot b=-5$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =-5 \\\\ 2t\\cdot 1+t\\cdot 3 & =-5 \\\\ 2t+3t & =-5 \\\\ 5t & =-5 \\\\ t & =-1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}a & =⟨2(-1),\\,(-1)⟩ \\\\  & =⟨-2,-1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $a$ and $b$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}}} \\\\  & =\\frac{-5}{\\sqrt{(-2)^{2}+(-1)^{2}}\\sqrt{{1}^{2}+{3}^{2}}} \\\\  & =-\\frac{5}{\\sqrt{5}\\cdot \\sqrt{10}} \\\\  & =-\\frac{5}{5\\sqrt{2}} \\\\  & =-\\frac{1}{\\sqrt{2}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(-\\frac{1}{\\sqrt{2}})={135}^{∘}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101512" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/activity-metadata.json" "file_sha256" "6ec99b73bd0e45287c6205dca701f4d8435e073bd05cb9cfc6c557ae7078ee9b"} {"question" "q-101512" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101512" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{120}^{∘}"] ["math" "{135}^{∘}"] ["math" "{150}^{∘}"] ["math" "{180}^{∘}"] ["math" "{90}^{∘}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "q-101512" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{135}^{∘}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/state.json" "file_sha256" "a76a2d55fe4cfab0d7e16df12e92bb8e31ac112f538228a90f5596ed85e85232"} {"question" "e-4327" "field" nil "attribute" "question/problem" "value" "Find the angle between $\\mathbf{a}=\\langle 2,-1,1 \\rangle$ and $\\mathbf{b}=\\langle 1,5,-2 \\rangle$. Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/example-4327.json" "file_sha256" "d54021ef644f7b5a247e30e2c3fc9eb3555b9bc1c406195f79d008067ba64e20"} {"question" "e-4327" "field" nil "attribute" "question/worked-solution" "value" "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 1+(-1)\\cdot 5+1\\cdot (-2)}{\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}\\sqrt{{1}^{2}+{5}^{2}+(-2)^{2}}} \\\\  & =\\frac{-5}{\\sqrt{6}\\cdot \\sqrt{30}} \\\\  & =\\frac{-5}{\\sqrt{6}\\cdot \\sqrt{6}\\cdot \\sqrt{5}} \\\\  & =-\\frac{\\sqrt{5}}{6}\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{\\sqrt{5}}{6} \\right) \\approx 111.9^\\circ.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/example-4327.json" "file_sha256" "d54021ef644f7b5a247e30e2c3fc9eb3555b9bc1c406195f79d008067ba64e20"} {"question" "e-4328" "field" nil "attribute" "question/problem" "value" "Find $\\angle BAC$ given the points $A(2,-1,-5)$, $B(-1,0,-4)$, and $C(5,1,1).$ Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/example-4328.json" "file_sha256" "c43feac91985f7b27ec8be206d554d465601616ddc293165e1174fd301ac5efc"} {"question" "e-4328" "field" nil "attribute" "question/worked-solution" "value" "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,-5⟩,\\,b=⟨-1,0,-4⟩,\\,c=⟨5,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $\\triangle ABC$ is shown (schematically) in the diagram below, where we denote $\\angle BAC = \\theta.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overrightarrow{AB}$ and $\\overrightarrow{AC}\\mathbin{:}$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨-1,0,-4⟩-⟨2,-1,-5⟩ \\\\  & =⟨-3,1,1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5,1,1⟩-⟨2,-1,-5⟩ \\\\  & =⟨3,2,6⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{-3\\cdot 3+1\\cdot 2+1\\cdot 6}{\\sqrt{(-3)^{2}+{1}^{2}+{1}^{2}}\\sqrt{{3}^{2}+{2}^{2}+{6}^{2}}} \\\\  & =\\frac{-1}{\\sqrt{11}\\sqrt{49}} \\\\  & =-\\frac{1}{7\\sqrt{11}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{1}{7\\sqrt{11}} \\right) \\approx 92.5^\\circ.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/example-4328.json" "file_sha256" "c43feac91985f7b27ec8be206d554d465601616ddc293165e1174fd301ac5efc"} {"question" "e-5112" "field" nil "attribute" "question/problem" "value" "Given that $\\mathbf{a}\\cdot \\mathbf{b}=-4$, find the angle between $\\mathbf{a}=\\langle t, \\, -2 \\rangle$ and $\\mathbf{b}=\\langle 6, \\, t \\rangle$. Round your answer to $1$ decimal place." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/example-5112.json" "file_sha256" "356ecf4df1339dc2a4c44a754ee592b1e87a838e992cfecdca401222768cfd31"} {"question" "e-5112" "field" nil "attribute" "question/worked-solution" "value" "First, since $\\mathbf{a}\\cdot \\mathbf{b}=-4$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}a\\cdot b & =-4 \\\\ t\\cdot 6+(-2)\\cdot t & =-4 \\\\ 6t-2t & =-4 \\\\ 4t & =-4 \\\\ t & =-1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}a=⟨-1,-2⟩,\\,b=⟨6,-1⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\mathbf{a}$ and $\\mathbf{b}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{a\\cdot b}{|\\,a\\,||\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}}\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}}} \\\\  & =\\frac{-4}{\\sqrt{(-1)^{2}+(-2)^{2}}\\cdot \\sqrt{{6}^{2}+(-1)^{2}}} \\\\  & =-\\frac{4}{\\sqrt{5}\\cdot \\sqrt{37}} \\\\  & =-\\frac{4}{\\sqrt{185}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left( -\\dfrac{4}{\\sqrt{185}} \\right) \\approx 107.1^\\circ.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040103/example-5112.json" "file_sha256" "356ecf4df1339dc2a4c44a754ee592b1e87a838e992cfecdca401222768cfd31"}] "usage" {"q-19112" [] "e-5112" [] "e-4328" [] "q-19035" [] "e-4327" [] "q-101520" [] "q-19036" [] "q-77164" [] "q-101511" [] "q-124813" [] "q-19110" []} "basis" 1408 "retractions" [[17592186106031 :question/problem "> A scientific calculator is required to answer this question.\n\nFind the angle between $a = ⟨3, 2, 1⟩$ and $b = ⟨1, 2, 3⟩$. Round your answer to the nearest degree."] [17592186279158 :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,2⟩,\\,b=⟨3,-5,1⟩,\\,c=⟨1,-4,-1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978202/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,-5,1⟩-⟨2,-1,2⟩ \\\\  & =⟨1,-4,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨1,-4,-1⟩-⟨2,-1,2⟩ \\\\  & =⟨-1,-3,-3⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-1)+(-4)\\cdot (-3)+(-1)\\cdot (-3)}{\\sqrt{{1}^{2}+(-4)^{2}+(-1)^{2}}\\sqrt{(-1)^{2}+(-3)^{2}+(-3)^{2}}} \\\\  & =\\frac{14}{\\sqrt{18}\\cdot \\sqrt{19}} \\\\  & =\\frac{14}{3\\sqrt{38}}\\,.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{14}{3\\sqrt{38}})≈{41}^{∘}.\n$$"] [17592186269073 :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\n\\begin{aligned}a=⟨2,-1,1⟩,\\,b=⟨3,1,-2⟩,\\,c=⟨-1,1,1⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3,1,-2⟩-⟨2,-1,1⟩ \\\\  & =⟨1,2,-3⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨-1,1,1⟩-⟨2,-1,1⟩ \\\\  & =⟨-3,2,0⟩.\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{1\\cdot (-3)+2\\cdot 2+(-3)\\cdot 0}{\\sqrt{{1}^{2}+{2}^{2}+(-3)^{2}}\\sqrt{(-3)^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{1}{\\sqrt{14}\\cdot \\sqrt{13}} \\\\  & =\\frac{1}{\\sqrt{182}}.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{182}})≈{86}^{∘}.\n$$"] [17592186106032 :question/worked-solution "Note that the position vectors of the points $P$, $Q$, $R$ are\n\n$$\n\\begin{aligned}p=⟨0,4,5⟩,\\,q=⟨1,5,4⟩,\\,r=⟨2,3,6⟩.\\end{aligned}\n$$\n\nThe $△PQR$ is shown (schematically) in the diagram below, where we denote $∠QPR=\\theta .$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13978202/assets/3003f0cb329a8f8ef9bc315c70df4773ac1f0c54843dea1208c68bd0f6227bd1.png)\n\nFirst, we find the components of $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =q-p \\\\  & =⟨1,5,4⟩-⟨0,4,5⟩ \\\\  & =⟨1,1,-1⟩ \\\\ \\overset{\\to }{PR} & =r-p \\\\  & =⟨2,3,6⟩-⟨0,4,5⟩ \\\\  & =⟨2,-1,1⟩\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overset{\\to }{PQ}$ and $\\overset{\\to }{PR}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{PQ}\\cdot \\overset{\\to }{PR}}{|\\overset{\\to }{PQ}||\\overset{\\to }{PR}|} \\\\  & =\\frac{1\\cdot 2+1\\cdot (-1)+(-1)\\cdot 1}{\\sqrt{{1}^{2}+{1}^{2}+(-1)^{2}}\\sqrt{{2}^{2}+(-1)^{2}+{1}^{2}}} \\\\  & =\\frac{0}{\\sqrt{3}\\cdot \\sqrt{6}} \\\\  & =0.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(0)={90}^{∘}.\n$$"] [17592186106033 :question/problem "> A scientific calculator is required to answer this question.\n\nFind $∠BAC$ given the points $A(3,-3, 1)$, $B(5,-3, 3)$, and $C(3,-2, 3)$. Round your answer to the nearest degree."] [17592186269087 :question/worked-solution "Note that the position vectors of the points $D$, $E$, $F$ are\n\n$$\n\\begin{aligned}d=⟨t,\\,5,\\,3⟩,\\,e=⟨{t}^{2},\\,2,\\,t⟩,\\,f=⟨t+3,\\,{t}^{2},\\,1⟩.\\end{aligned}\n$$\n\nThe triangle $△DEF$ is shown (schematically) in the diagram below, where we denote $∠EDF=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/c9cfb3e84e6f76d243125f2a09246b2a1300a0134e71359bb2b528082f064f93.png)\n\nFirst, we find the components of $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =e-d \\\\  & =⟨{t}^{2},\\,2,\\,t⟩-⟨t,\\,5,\\,3⟩ \\\\  & =⟨{t}^{2}-t,\\,-3,\\,t-3⟩ \\\\ \\overset{\\to }{DF} & =f-d \\\\  & =⟨t+3,\\,{t}^{2},\\,1⟩-⟨t,\\,5,\\,3⟩ \\\\  & =⟨3,\\,{t}^{2}-5,\\,-2⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}=6$, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF} & =6 \\\\ ({t}^{2}-t)\\cdot 3+(-3)\\cdot ({t}^{2}-5)+(t-3)\\cdot (-2) & =6 \\\\ 3{t}^{2}-3t-3{t}^{2}+15-2t+6 & =6 \\\\ -5t+21 & =6 \\\\ -5t & =-15 \\\\ t & =3\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{DE} & =⟨{3}^{2}-3,-3,3-3⟩ \\\\  & =⟨6,-3,0⟩, \\\\ \\overset{\\to }{DF} & =⟨3,{3}^{2}-5,-2⟩ \\\\  & =⟨3,4,-2⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{DE}$ and $\\overset{\\to }{DF}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{DE}\\cdot \\overset{\\to }{DF}}{|\\overset{\\to }{DE}||\\overset{\\to }{DF}|} \\\\  & =\\frac{6}{\\sqrt{{6}^{2}+(-3)^{2}+{0}^{2}}\\sqrt{{3}^{2}+{4}^{2}+(-2)^{2}}} \\\\  & =\\frac{6}{3\\sqrt{5}\\cdot \\sqrt{29}} \\\\  & =\\frac{2}{\\sqrt{145}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{2}{\\sqrt{145}})≈{80.44}^{∘}.\n$$"] [17592186269150 :question/worked-solution "Note that the position vectors of the points $A,$ $B$ and $C$ are\n\n$$\n\\begin{aligned}a=⟨3t,\\,t,\\,4⟩,\\,b=⟨3t,\\,4t,\\,3⟩,\\,c=⟨5t,\\,t+1,\\,5⟩.\\end{aligned}\n$$\n\nThe triangle $△ABC$ is shown (schematically) in the diagram below, where we denote $∠BAC=\\theta .$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964292/assets/285b8343208079181ac6036cf9ca16abc974d59b9262878ed40c0da9af5683d0.png)\n\nFirst, we find the components of $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}:$\n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =b-a \\\\  & =⟨3t,\\,4t,\\,3⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨0,\\,3t,\\,-1⟩ \\\\ \\overset{\\to }{AC} & =c-a \\\\  & =⟨5t,\\,t+1,\\,5⟩-⟨3t,\\,t,\\,4⟩ \\\\  & =⟨2t,\\,1,\\,1⟩\\end{aligned}\n$$\n\nNow, since $\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}=2$, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC} & =2 \\\\ 0\\cdot 2t+3t\\cdot 1+(-1)\\cdot 1 & =2 \\\\ 3t-1 & =2 \\\\ 3t & =3 \\\\ t & =1\\end{aligned}\n$$\n\nSo, \n\n$$\n\\begin{aligned}\\overset{\\to }{AB} & =⟨0,3,-1⟩, \\\\ \\overset{\\to }{AC} & =⟨2,\\,1,\\,1⟩.\\end{aligned}\n$$\n\nNext, the cosine of the angle between $\\overset{\\to }{AB}$ and $\\overset{\\to }{AC}$ is\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡\\theta  & =\\frac{\\overset{\\to }{AB}\\cdot \\overset{\\to }{AC}}{|\\overset{\\to }{AB}||\\overset{\\to }{AC}|} \\\\  & =\\frac{2}{\\sqrt{{0}^{2}+{3}^{2}+(-1)^{2}}\\cdot \\sqrt{{2}^{2}+{1}^{2}+{1}^{2}}} \\\\  & =\\frac{2}{\\sqrt{10}\\cdot \\sqrt{6}} \\\\  & =\\frac{2}{2\\sqrt{15}} \\\\  & =\\frac{1}{\\sqrt{15}}.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta =\\operatorname{arccos}⁡(\\frac{1}{\\sqrt{15}})≈{75}^{∘}.\n$$"] [17592186105511 :question/worked-solution "Rearranging the dot product formula, we have:\n\n$$\n\\begin{aligned}\n\\cos θ &= \\frac{a \\cdot b}{\\mid a \\mid \\mid b \\mid} \\\\\n&= \\frac{a_{x}b_{x} + a_{y}b_{y} + a_{z}b_{z}}{\\sqrt{a_{x}^{2} + a_{y}^{2} + a_{z}^{2}}\\sqrt{b_{x}^{2} + b_{y}^{2} + b_{z}^{2}}} \\\\\n&= (2 \\cdot 1 + (-1) \\cdot 5 + 1 \\cdot (-2))/(\\sqrt{2^{2} + (-1)^{2} + 1^{2}}\\sqrt{1^{2} + 5^{2} + (-2)^{2}}) \\\\\n&= \\frac{-5}{\\sqrt{6} \\cdot \\sqrt{30}} \\\\\n&= \\frac{-5}{\\sqrt{6} \\cdot \\sqrt{6} \\cdot \\sqrt{5}} \\\\\n&=-\\frac{\\sqrt{5}}{6}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left(-\\dfrac{\\sqrt{5}}{6} \\right) \\approx 111.9^\\circ\n$$"] [17592186105512 :question/problem "Find $\\angle BAC$ given the points $A(2,-1,-5)$, $B(-1,0,-4)$, and $C(5,1,1)$. Round your answer to $1$ decimal place."] [17592186105512 :question/worked-solution "Note that the position vectors of the points $A$, $B$, $C$ are\n\n$$\na = ⟨2,-1,-5⟩, b = ⟨ - 1, 0,-4⟩, c = ⟨5, 1, 1⟩\n$$\n\nThe triangle $\\triangle ABC$ is shown (schematically) in the diagram below, where we denote\n\n$$\n\\angle BAC = \\theta\n$$\n\n![](/home/jake/Developer/MA/DATA/Lessons/1278/Source/Images/3326328c02627ffa40dbcdf7cb16cc96.png)\n\nFirst, we find the components of $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$:\n\n$$\n\\begin{aligned}\nAB^(→) &= b - a \\\\\n&= ⟨ - 1, 0,-4⟩ - ⟨2,-1,-5⟩ \\\\\n&= ⟨ - 3, 1, 1⟩ \\\\\nAC^(→) &= c - a \\\\\n&= ⟨5, 1, 1⟩ - ⟨2,-1,-5⟩ \\\\\n&= ⟨3, 2, 6⟩\n\\end{aligned}\n$$\n\nNow, the cosine of the angle between $\\overrightarrow{AB}$ and $\\overrightarrow{AC}$ is\n\n$$\n\\begin{aligned}\n\\cos θ &= (AB^(→) \\cdot AC^(→))/(\\mid AB^(→) \\mid \\mid AC^(→) \\mid) \\\\\n&= (-3 \\cdot 3 + 1 \\cdot 2 + 1 \\cdot 6)/(\\sqrt{(-3)^{2} + 1^{2} + 1^{2}}\\sqrt{3^{2} + 2^{2} + 6^{2}}) \\\\\n&= \\frac{-1}{\\sqrt{11}\\sqrt{49}} \\\\\n&=-\\frac{1}{7\\sqrt{11}}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left(-\\dfrac{1}{7\\sqrt{11}} \\right) \\approx 92.5^\\circ\n$$"] [17592186105529 :question/worked-solution "First, since\n\n$$\n\\mathbf{a}\\cdot \\mathbf{b}=-4\n$$\n\n, we can solve for $t$, as follows:\n\n$$\n\\begin{aligned}\na \\cdot b &= -4 \\\\\nt \\cdot 6 + (-2) \\cdot t &= -4 \\\\\n6t - 2t &= -4 \\\\\n4t &= -4 \\\\\nt &= -1\n\\end{aligned}\n$$\n\nSo,\n\n$$\na = ⟨ - 1,-2⟩, b = ⟨6,-1⟩\n$$\n\nNow, the cosine of the angle between $\\mathbf{a}$ and $\\mathbf{b}$ is\n\n$$\n\\begin{aligned}\n\\cos θ &= \\frac{a \\cdot b}{\\mid a \\mid \\mid b \\mid} \\\\\n&= \\frac{a_{x}b_{x} + a_{y}b_{y}}{\\sqrt{a_{x}^{2} + a_{y}^{2}}\\sqrt{b_{x}^{2} + b_{y}^{2}}} \\\\\n&= (-4)/(\\sqrt{(-1)^{2} + (-2)^{2}} \\cdot \\sqrt{6^{2} + (-1)^{2}}) \\\\\n&=-\\frac{4}{\\sqrt{5} \\cdot \\sqrt{37}} \\\\\n&=-\\frac{4}{\\sqrt{185}}\n\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\theta = \\arccos \\left(-\\dfrac{4}{\\sqrt{185}} \\right) \\approx 107.1^\\circ\n$$"]] "immutable_answers" [17592186102424 17592186102425 17592186102426 17592186102427 17592186102428 17592186102430 17592186102431 17592186102432 17592186102433 17592186102434 17592186102436 17592186102437 17592186102438 17592186102439 17592186102440 17592186269075 17592186269076 17592186269077 17592186269078 17592186269079 17592186269089 17592186269090 17592186269091 17592