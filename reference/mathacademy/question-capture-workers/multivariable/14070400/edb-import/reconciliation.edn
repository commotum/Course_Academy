nally, we want to replace the proportionality symbol with an equality symbol. Let $k$ be a positive constant. Since the volume of gas *increases* with time, our derivative should be *positive*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}G}{\\text{d}t}=k{t}^{2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037103/state.json" "file_sha256" "0d9f525c4d5985d6aa8793a8be364b558d2b13f59fa68f5eb3b50e0d77a796da" "basis" 1255 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037103/edb-import/verification.json"} {"question" "q-143035" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037103/activity-metadata.json" "file_sha256" "b08e89e3902ba9360f9961f50e9f3f1b8ba1a959fe0de04a87724d72ff237043" "basis" 1255 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037103/edb-import/verification.json"} {"question" "q-143035" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037103/state.json" "file_sha256" "0d9f525c4d5985d6aa8793a8be364b558d2b13f59fa68f5eb3b50e0d77a796da" "basis" 1255 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14037103/edb-import/verification.json"} {"question" "q-143035" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\text{d}G}{\\text{d}t}=-\\frac{k}{{t}^{2}},\\,\\,k>0"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differentia