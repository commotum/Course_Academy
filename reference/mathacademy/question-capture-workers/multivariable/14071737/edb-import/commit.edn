2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nHence, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{2}.\\end{aligned}\n$$" 13194139535892 true] [17592186373008 1000 #edb/ref 17592186373009 13194139535892 true] [17592186373008 1000 #edb/ref 17592186373010 13194139535892 true] [17592186373008 1000 #edb/ref 17592186373011 13194139535892 true] [17592186373008 1000 #edb/ref 17592186373012 13194139535892 true] [17592186373008 1000 #edb/ref 17592186373013 13194139535892 true] [17592186373008 1040 #edb/ref 17592186045450 13194139535892 true] [17592186373008 1041 "selection" 13194139535892 true] [17592186373008 1104 #edb/ref 17592186373010 13194139535892 true] [17592186373008 1110 #uuid "58f5f8e7-7825-5270-8004-16910762b42b" 13194139535892 true] [17592186373009 1034 "\\frac{2}{\\sqrt{2{cos}^{2}⁡t+{sin}^{2}⁡t}}" 13194139535892 true] [17592186373009 1103 #edb/ref 17592186045453 13194139535892 true] [17592186373009 1111 #uuid "feb92d1f-be47-5332-aa7c-6994c61e2c4c" 13194139535892 true] [17592186373010 1034 "\\frac{1}{2}" 13194139535892 true] [17592186373010 1103 #edb/ref 17592186045453 13194139535892 true] [17592186373010 1111 #uuid "07c42237-bbf2-5738-870f-a9e52fa6342f" 13194139535892 true] [17592186373011 1034 "\\frac{1}{4}" 13194139535892 true] [17592186373011 1103 #edb/ref 17592186045453 13194139535892 true] [17592186373011 1111 #uuid "6f733e40-3ff5-5dca-8581-c886c37634e0" 13194139535892 true] [17592186373012 1034 "1" 13194139535892 true] [17592186373012 1103 #edb/ref 17592186045453 13194139535892 true] [17592186373012 1111 #uuid "636d2e33-6e38-5bb9-b216-deeef88f0013" 13194139535892 true] [17592186373013 1034 "\\frac{1}{\\sqrt{2}}" 13194139535892 true] [17592186373013 1103 #edb/ref 17592186045453 13194139535892 true] [17592186373013 1111 #uuid "e2733e40-3710-57c5-9d34-63be2dc554c1" 13194139535892 true] [17592186373014 1017 #edb/ref 17592186373015 13194139535892 true] [17592186373014 1089 "q-64680" 13194139535892 true] [17592186373014 1091 #edb/ref 17592186045464 13194139535892 true] [17592186373014 1100 "Find the curvature at an arbitrary point on the curve $r(t)=⟨\\,\\operatorname{sin}⁡3t,\\,\\operatorname{cos}⁡3t,\\,t⟩.$" 13194139535892 true] [17592186373014 1113 #uuid "314012c1-13af-5a6a-b428-2d65422933f0" 13194139535892 true] [17592186373014 1145 "Let $T(t)$ denote the unit tangent to the given curve as a function of the parameter $t.$ Since we are given the curve $r(t)$ parametrized by the parameter $t$ (not the arc length $s$), we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we calculate ${r}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨3\\operatorname{cos}⁡3t,\\,-3\\operatorname{sin}⁡3t,\\,1⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(3\\operatorname{cos}⁡3t)}^{2}+{(-3\\operatorname{sin}⁡3t)}^{2}+{(1)}^{2}} \\\\  & =\\sqrt{9({cos}^{2}⁡(3t)+{sin}^{2}⁡(3t))+1} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nHence, the corresponding unit tangent vector is\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{\\sqrt{10}}⟨3\\operatorname{cos}⁡3t,\\,-3\\operatorname{sin}⁡3t,\\,1⟩.\\end{aligned}\n$$\n\nNext, we calculate ${T}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{10}}⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(-3\\operatorname{sin}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(1)⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨-9\\operatorname{sin}⁡3t,\\,-9\\operatorname{cos}⁡3t,\\,0⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{10}}\\sqrt{(9\\operatorname{sin}⁡3t)^{2}+(-9\\operatorname{cos}⁡t)^{2}+{0}^{2}} \\\\  & =\\frac{1}{\\sqrt{10}}\\sqrt{{9}^{2}({sin}^{2}⁡3t+{cos}^{2}⁡3t)} \\\\  & =\\frac{9}{\\sqrt{10}}\\end{aligned}\n$$\n\nF