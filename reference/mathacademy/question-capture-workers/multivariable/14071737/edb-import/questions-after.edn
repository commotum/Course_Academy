#{[{:db/id #edb/ref 17592186372993 :knowledge-point/_questions [{:knowledge-point/id #uuid "2c9d719f-4936-5994-90eb-c33da57639cc" :knowledge-point/title "Finding the Curvature Given a General Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3f48bee-4c65-5fac-bfd3-3466028bd795" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sec}⁡t" :db/id #edb/ref 17592186372995} {:answer/id #uuid "aaec0542-9350-526b-93e8-70e97358b248" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{csc}⁡t" :db/id #edb/ref 17592186372996} {:answer/id #uuid "a5b39a93-ff50-51b1-8c31-9beabf4ce7c0" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{tan}⁡t" :db/id #edb/ref 17592186372997} {:answer/id #uuid "b6ca60e0-9ee3-5fca-8dc2-781801d2b53c" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡t" :db/id #edb/ref 17592186372998} {:answer/id #uuid "69fab617-6054-5135-bc63-0eac4f647dec" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t" :db/id #edb/ref 17592186372999}] :answer-field/correct {:answer/id #uuid "69fab617-6054-5135-bc63-0eac4f647dec" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡t" :db/id #edb/ref 17592186372999} :answer-field/id #uuid "0cf77a15-fd72-5c6d-b784-4190e8d603e2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372994}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f000c9ed-a6ae-5faa-9857-7ca6186fd3c0" :question/math-academy-id "q-131225" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)=⟨-\\operatorname{ln}⁡(\\operatorname{cos}⁡t),\\,t⟩$ for $0\\le t\\le \\frac{\\pi }{4}$" :question/worked-solution "Let $T(t)$ denote the unit tangent to the given curve as a function of the parameter $t.$ Since we are given the curve $r(t)$ parametrized by the parameter $t$ (not the arc length $s$), we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we calculate ${r}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{ln}⁡(\\operatorname{cos}⁡t)),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨\\operatorname{tan}⁡t,\\,1⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{(\\operatorname{tan}⁡t)^{2}+{1}^{2}} \\\\  & =\\sqrt{{tan}^{2}⁡t+1} \\\\  & =\\sqrt{{sec}^{2}⁡t} \\\\  & =\\operatorname{sec}⁡t\\end{aligned}\n$$\n\nHence, the corresponding unit tangent vector is\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{\\operatorname{sec}⁡t}⟨\\operatorname{tan}⁡t,\\,1⟩ \\\\  & =⟨\\operatorname{sin}⁡t,\\,\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$\n\nNext, we calculate ${T}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =⟨\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\sqrt{(\\operatorname{cos}⁡t)^{2}+(-\\operatorname{sin}⁡t)^{2}} \\\\  & =\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =1\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{\\operatorname{sec}⁡t}=\\operatorname{cos}⁡t.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373000 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c819c5c-aa18-5887-ace3-dfbd9c5700e1" :knowledge-point/title "Finding the Curvature Given the Arc Length Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef4113c6-0c1c-5570-bd9c-04e58532f465" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186373002} {:answer/id #uuid "76de6172-4a5e-5b30-bf3b-69d074a86eea" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186373003} {:answer/id #uuid "ec9c1564-75e2-55c2-93a7-35f4c562a347" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186373004} {:answer/id #uuid "5ce7de25-ff66-58f6-bc19-c1a22526d962" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186373005} {:answer/id #uuid "12871d6e-6dc9-5b09-8267-bf1396854e18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}}{2}" :db/id #edb/ref 17592186373006}] :answer-field/correct {:answer/id #uuid "ef4113c6-0c1c-5570-bd9c-04e58532f465" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186373002} :answer-field/id #uuid "94681e28-29ab-5586-b5ba-771b09a53acc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373001}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "500840b9-52ef-5a7b-a404-716dffa712d4" :question/math-academy-id "q-34238" :question/problem "Find the curvature at an arbitrary point on the curve $r(s)$ parametrized by its arc length $s$, where\n\n$$\nr(s)=⟨\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡(\\sqrt{2}s),\\,-\\frac{1}{2}\\operatorname{cos}⁡(\\sqrt{2}s),\\,-\\frac{1}{2}\\operatorname{cos}⁡(\\sqrt{2}s)⟩,\\,0\\le s<\\sqrt{2}\\pi .\n$$" :question/worked-solution "Let $T(s)$ denote the unit tangent to the given curve as a function of the arc length $s.$ Since we are given the curve $r(s)$ parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖=‖{r}^{″}(s)‖\n$$\n\nNow, we calculate ${r}^{′}(s)$ and ${r}^{″}(s)$:\n\n$$\n\\begin{aligned}{r}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡(\\sqrt{2}s)),\\,\\frac{\\text{d}}{\\text{d}s}(-\\frac{1}{2}\\operatorname{cos}⁡(\\sqrt{2}s)),\\,\\frac{\\text{d}}{\\text{d}s}(-\\frac{1}{2}\\operatorname{cos}⁡(\\sqrt{2}s))⟩ \\\\  & =⟨\\frac{\\sqrt{2}}{2}\\operatorname{cos}⁡(\\sqrt{2}s)\\cdot \\sqrt{2},\\,-\\frac{1}{2}(-\\operatorname{sin}⁡(\\sqrt{2}s))\\cdot \\sqrt{2},\\,-\\frac{1}{2}(-\\operatorname{sin}⁡(\\sqrt{2}s))\\cdot \\sqrt{2}⟩ \\\\  & =⟨\\operatorname{cos}⁡(\\sqrt{2}s),\\,\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡(\\sqrt{2}s),\\,\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡(\\sqrt{2}s)⟩ \\\\ {r}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡(\\sqrt{2}s)),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡(\\sqrt{2}s)),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{2}}{2}\\operatorname{sin}⁡(\\sqrt{2}s))⟩ \\\\  & =⟨(-\\operatorname{sin}⁡(\\sqrt{2}s))\\cdot \\sqrt{2},\\,\\frac{\\sqrt{2}}{2}\\cdot \\operatorname{cos}⁡(\\sqrt{2}s)\\cdot \\sqrt{2},\\,\\frac{\\sqrt{2}}{2}\\cdot \\operatorname{cos}⁡(\\sqrt{2}s)\\cdot \\sqrt{2}⟩ \\\\  & =⟨-\\sqrt{2}\\operatorname{sin}⁡(\\sqrt{2}s),\\,\\operatorname{cos}⁡(\\sqrt{2}s),\\,\\operatorname{cos}⁡(\\sqrt{2}s)⟩\\end{aligned}\n$$\n\n   \n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(s) & =‖{r}^{″}(s)‖ \\\\  & =\\sqrt{{(-\\sqrt{2}\\operatorname{sin}⁡\\sqrt{2}s)}^{2}+{(\\operatorname{cos}⁡\\sqrt{2}s)}^{2}+{(\\operatorname{cos}⁡\\sqrt{2}s)}^{2}} \\\\  & =\\sqrt{2{sin}^{2}⁡(\\sqrt{2}s)+2{cos}^{2}⁡(\\sqrt{2}s)} \\\\  & =\\sqrt{2({sin}^{2}⁡(\\sqrt{2}s)+{cos}^{2}⁡(\\sqrt{2}s))} \\\\  & =\\sqrt{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373007 :knowledge-point/_questions [{:knowledge-point/id #uuid "2c9d719f-4936-5994-90eb-c33da57639cc" :knowledge-point/title "Finding the Curvature Given a General Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "feb92d1f-be47-5332-aa7c-6994c61e2c4c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{2{cos}^{2}⁡t+{sin}^{2}⁡t}}" :db/id #edb/ref 17592186373009} {:answer/id #uuid "07c42237-bbf2-5738-870f-a9e52fa6342f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186373010} {:answer/id #uuid "6f733e40-3ff5-5dca-8581-c886c37634e0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186373011} {:answer/id #uuid "636d2e33-6e38-5bb9-b216-deeef88f0013" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186373012} {:answer/id #uuid "e2733e40-3710-57c5-9d34-63be2dc554c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186373013}] :answer-field/correct {:answer/id #uuid "07c42237-bbf2-5738-870f-a9e52fa6342f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186373010} :answer-field/id #uuid "58f5f8e7-7825-5270-8004-16910762b42b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373008}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "21cc2202-208d-54db-a96f-6d80eba20259" :question/math-academy-id "q-34245" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)$ given that its derivative ${r}^{′}(t)$ and the derivative of the corresponding unit tangent ${T}^{′}(t)$ are as follows: \n\n$$\n\\begin{aligned}{r}^{′}(t)=⟨\\sqrt{3}\\operatorname{sin}⁡t,\\,\\operatorname{sin}⁡t,\\,2\\operatorname{cos}⁡t⟩,\\,{T}^{′}(t)=⟨\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡t,\\,\\frac{1}{2}\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$" :question/worked-solution "Since we are given both the derivative of the curve ${r}^{′}(t)$ and the derivative of the unit tangent ${T}^{′}(t)$, we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we find the magnitudes of ${r}^{′}(t)$ and ${T}^{′}(t):$\n\n$$\n\\begin{aligned}‖{T}^{′}(t)‖ & =\\sqrt{{(\\frac{\\sqrt{3}}{2}\\operatorname{cos}⁡t)}^{2}+{(\\frac{1}{2}\\operatorname{cos}⁡t)}^{2}+(-\\operatorname{sin}⁡t)^{2}} \\\\  & =\\sqrt{(\\frac{3}{4}+\\frac{1}{4}){cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =1 \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{3{sin}^{2}⁡t+{sin}^{2}⁡t+4{cos}^{2}⁡t} \\\\  & =\\sqrt{4({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =2\\end{aligned}\n$$\n\nHence, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373014 :knowledge-point/_questions [{:knowledge-point/id #uuid "2c9d719f-4936-5994-90eb-c33da57639cc" :knowledge-point/title "Finding the Curvature Given a General Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "833689aa-9f7b-59fe-87fc-c3bdb2bf299e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{10}" :db/id #edb/ref 17592186373016} {:answer/id #uuid "a4984003-60bd-5b00-9e28-ead53cc11ac3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{9}" :db/id #edb/ref 17592186373017} {:answer/id #uuid "e1d2d962-8383-589e-a00c-aa207e70c7b3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{9}" :db/id #edb/ref 17592186373018} {:answer/id #uuid "c6c88c8c-0093-5f18-b30b-6d3159c57abf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{\\sqrt{10}}" :db/id #edb/ref 17592186373019} {:answer/id #uuid "35d2b500-ef7e-59d2-8712-ff647a7cb6d1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{10}}{10}" :db/id #edb/ref 17592186373020}] :answer-field/correct {:answer/id #uuid "833689aa-9f7b-59fe-87fc-c3bdb2bf299e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{10}" :db/id #edb/ref 17592186373016} :answer-field/id #uuid "e6e2b9c7-de0a-5247-988a-ac44127e9e45" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373015}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "314012c1-13af-5a6a-b428-2d65422933f0" :question/math-academy-id "q-64680" :question/problem "Find the curvature at an arbitrary point on the curve $r(t)=⟨\\,\\operatorname{sin}⁡3t,\\,\\operatorname{cos}⁡3t,\\,t⟩.$" :question/worked-solution "Let $T(t)$ denote the unit tangent to the given curve as a function of the parameter $t.$ Since we are given the curve $r(t)$ parametrized by the parameter $t$ (not the arc length $s$), we will use the following formula for the curvature:\n\n$$\nκ(t)=\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}\n$$\n\nNow, we calculate ${r}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(t)⟩ \\\\  & =⟨3\\operatorname{cos}⁡3t,\\,-3\\operatorname{sin}⁡3t,\\,1⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(3\\operatorname{cos}⁡3t)}^{2}+{(-3\\operatorname{sin}⁡3t)}^{2}+{(1)}^{2}} \\\\  & =\\sqrt{9({cos}^{2}⁡(3t)+{sin}^{2}⁡(3t))+1} \\\\  & =\\sqrt{10}\\end{aligned}\n$$\n\nHence, the corresponding unit tangent vector is\n\n$$\n\\begin{aligned}T(t) & =\\frac{{r}^{′}(t)}{‖{r}^{′}(t)‖} \\\\  & =\\frac{1}{\\sqrt{10}}⟨3\\operatorname{cos}⁡3t,\\,-3\\operatorname{sin}⁡3t,\\,1⟩.\\end{aligned}\n$$\n\nNext, we calculate ${T}^{′}(t)$ and find its magnitude:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{10}}⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(-3\\operatorname{sin}⁡3t),\\,\\frac{\\text{d}}{\\text{d}t}(1)⟩ \\\\  & =\\frac{1}{\\sqrt{10}}⟨-9\\operatorname{sin}⁡3t,\\,-9\\operatorname{cos}⁡3t,\\,0⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{10}}\\sqrt{(9\\operatorname{sin}⁡3t)^{2}+(-9\\operatorname{cos}⁡t)^{2}+{0}^{2}} \\\\  & =\\frac{1}{\\sqrt{10}}\\sqrt{{9}^{2}({sin}^{2}⁡3t+{cos}^{2}⁡3t)} \\\\  & =\\frac{9}{\\sqrt{10}}\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(t) & =\\frac{‖{T}^{′}(t)‖}{‖{r}^{′}(t)‖}=\\frac{\\,\\frac{9}{\\sqrt{10}}\\,}{\\sqrt{10}}=\\frac{9}{10}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186373021 :knowledge-point/_questions [{:knowledge-point/id #uuid "5c819c5c-aa18-5887-ace3-dfbd9c5700e1" :knowledge-point/title "Finding the Curvature Given the Arc Length Parametrization"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4dfc91fb-90bc-5d66-bd6b-7c26644387fd" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186373023} {:answer/id #uuid "dbb13572-3191-5ab1-9235-c4493d61582f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186373024} {:answer/id #uuid "e5db4a40-7a3c-580b-abcc-4afaf2b8def2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186373025} {:answer/id #uuid "70a1f621-0ef0-552f-82a5-fb834179165a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186373026} {:answer/id #uuid "061ed4a2-fba1-5f41-a68b-3b9b0c5076f9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186373027}] :answer-field/correct {:answer/id #uuid "e5db4a40-7a3c-580b-abcc-4afaf2b8def2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186373025} :answer-field/id #uuid "58537abf-1f58-5bd3-bddc-2d581d2fe926" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186373022}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "41f024c1-9750-5366-af91-f493bbf57c27" :question/math-academy-id "q-83644" :question/problem "Find the curvature at an arbitrary point on the curve $r(s)$ parametrized by its arc length $s$, where\n\n$$\nr(s)=⟨-3\\operatorname{sin}⁡(\\frac{s}{3}),\\,3\\operatorname{cos}⁡(\\frac{s}{3})⟩,\\,0\\le s<6\\pi .\n$$" :question/worked-solution "Let $T(s)$ denote the unit tangent to the given curve as a function of the arc length $s.$ Since we are given the curve $r(s)$ parametrized by the arc length $s$, we will use the following formula for the curvature:\n\n$$\nκ(s)=‖{T}^{′}(s)‖=‖{r}^{″}(s)‖\n$$\n\nNow, we calculate ${r}^{′}(s)$ and ${r}^{″}(s):$\n\n$$\n\\begin{aligned}{r}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-3\\operatorname{sin}⁡(\\frac{s}{3})),\\,\\frac{\\text{d}}{\\text{d}s}(3\\operatorname{cos}⁡(\\frac{s}{3}))⟩ \\\\  & =⟨-3\\operatorname{cos}⁡(\\frac{s}{3})\\cdot \\frac{1}{3},\\,-3\\operatorname{sin}⁡(\\frac{s}{3})\\cdot \\frac{1}{3}⟩ \\\\  & =⟨-\\operatorname{cos}⁡(\\frac{s}{3}),\\,-\\operatorname{sin}⁡(\\frac{s}{3})⟩ \\\\ {r}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{cos}⁡(\\frac{s}{3})),\\,\\frac{\\text{d}}{\\text{d}s}(-\\operatorname{sin}⁡(\\frac{s}{3}))⟩ \\\\  & =⟨\\operatorname{sin}⁡(\\frac{s}{3})\\cdot \\frac{1}{3},\\,-\\operatorname{cos}⁡(\\frac{s}{3})\\cdot \\frac{1}{3}⟩ \\\\  & =\\frac{1}{3}⟨\\operatorname{sin}⁡(\\frac{s}{3}),\\,-\\operatorname{cos}⁡(\\frac{s}{3})⟩\\end{aligned}\n$$\n\nFinally, the curvature is\n\n$$\n\\begin{aligned}κ(s) & =‖{r}^{″}(s)‖ \\\\  & =|\\frac{1}{3}|\\sqrt{{(\\operatorname{sin}⁡(\\frac{s}{3}))}^{2}+{(-\\operatorname{cos}⁡(\\frac{s}{3}))}^{2}} \\\\  & =\\frac{1}{3}\\sqrt{{sin}^{2}⁡(\\frac{s}{3})+{cos}^{2}⁡(\\frac{s}{3})} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$"}]}
