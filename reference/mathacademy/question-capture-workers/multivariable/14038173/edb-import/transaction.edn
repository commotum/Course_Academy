[{:db/id "q-350337/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "bea6b7c1-773b-5c39-861d-df7d7d6c4751" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-350337/field-1" :answer-field/id #uuid "53a277eb-23a2-5da8-b7c7-53aaeabebd20" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350337/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-350337/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-350337" :question/id #uuid "27ce0742-f150-56aa-89d0-d602f7e76617" :question/math-academy-id "q-350337" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{8}{\\sqrt[5]{{t}^{13}}}\\,\\text{d}t=$\n{{field-1}}" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8}{\\sqrt[5]{{t}^{13}}}\\,\\text{d}t & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{8}{\\sqrt[5]{{t}^{13}}}\\,\\text{d}t \\\\  & =8{lim}_{a\\to \\infty }{\\int }_{1}^{a}{t}^{-13/5}\\,\\text{d}t \\\\  & =8{lim}_{a\\to \\infty }{[-\\frac{5}{8}{t}^{-8/5}]}_{1}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[5]{{t}^{8}}}]}_{1}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[5]{{a}^{8}}}-\\frac{1}{\\sqrt[5]{{1}^{8}}}) \\\\  & =-5(0-1) \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350337/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89"] :knowledge-point/questions ["q-350337"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350331/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "6f378c1e-7988-55b0-8ca6-060416c74d4d" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-350331/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "bc7cc983-5aab-5f99-98f9-27e883c2e83e" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-350331/field-1" :answer-field/id #uuid "4828f9dc-3bc8-56c2-800a-e0a2223a6451" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350331/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-350331/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-350331/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-350331" :question/id #uuid "0c22bb14-f75a-54e4-a1e8-fa4dca43eeca" :question/math-academy-id "q-350331" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y=$\n{{field-1}}" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{5}{\\sqrt[3]{{y}^{8}}}\\,\\text{d}y \\\\  & =5{lim}_{a\\to \\infty }{\\int }_{1}^{a}{y}^{-8/3}\\,\\text{d}y \\\\  & =5{lim}_{a\\to \\infty }{[-\\frac{3}{5}{y}^{-5/3}]}_{1}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{{y}^{5}}}]}_{1}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{{a}^{5}}}-\\frac{1}{\\sqrt[3]{{1}^{5}}}) \\\\  & =-3(0-1) \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350331/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89"] :knowledge-point/questions ["q-350331"] :db/ensure [:knowledge-point/validate]} {:db/id "q-152758/selection/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer/id #uuid "7e550597-2210-5f06-835f-865b4c946942" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "q-152758/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" :answer/id #uuid "34457adf-8d22-5123-9dae-bf860942cdc8" :answer/type :answer.type/text :answer/value "The integral diverges" :db/ensure [:answer/validate]} {:db/id "q-152758/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "99c90756-ac79-5f5d-9f89-007029cd71cd" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-152758/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "569140db-2295-540c-83c2-e025fdc121c5" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-152758/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "9070218c-370e-540e-99af-cbd325962aef" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-152758/selection" :answer-field/id #uuid "7c8c3999-135c-5573-86dd-ea6dca68e4be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-152758/selection/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer-field/choices ["q-152758/selection/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" "q-152758/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" "q-152758/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-152758/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-152758/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda"] :db/ensure [:answer-field/validate]} {:db/id "q-152758" :question/id #uuid "8b574e06-9e6e-5b6a-8649-78b526fbd886" :question/math-academy-id "q-152758" :question/problem "Evaluate the integral ${\\int }_{3}^{\\infty }\\frac{5}{{x}^{2}}\\,\\text{d}x.$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{3}^{\\infty }\\frac{5}{{x}^{2}}\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}\\frac{5}{{x}^{2}}\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}5{x}^{-2}\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[(-5{x}^{-1})]}_{3}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{x}]}_{3}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }(\\frac{1}{a}-\\frac{1}{3}) \\\\  & =-5\\cdot (0-\\frac{1}{3}) \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-152758/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89"] :knowledge-point/questions ["q-152758"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350333/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "904e63ac-2ccc-5ddc-a207-046c3d71db34" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-350333/field-1" :answer-field/id #uuid "10724fca-93ff-5869-bff8-17d4fc761b7a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350333/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-350333/field-1/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-350333" :question/id #uuid "a5e4dca8-dc29-57ac-ba08-843dc7c7ea8b" :question/math-academy-id "q-350333" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{12}{\\sqrt[3]{{s}^{7}}}\\,\\text{d}s=$\n{{field-1}}" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{12}{\\sqrt[3]{{s}^{7}}}\\,\\text{d}s & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{12}{\\sqrt[3]{{s}^{7}}}\\,\\text{d}s \\\\  & =12{lim}_{a\\to \\infty }{\\int }_{1}^{a}{s}^{-7/3}\\,\\text{d}s \\\\  & =12{lim}_{a\\to \\infty }{[-\\frac{3}{4}{s}^{-4/3}]}_{1}^{a} \\\\  & =-9\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{{s}^{4}}}]}_{1}^{a} \\\\  & =-9\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{{a}^{4}}}-\\frac{1}{\\sqrt[3]{{1}^{4}}}) \\\\  & =-9(0-1) \\\\  & =9.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350333/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6ef2ab87-f78b-5cbd-9be4-0c1ac3448d89"] :knowledge-point/questions ["q-350333"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350532/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3c0e29a2-462d-5188-9dec-f006de874f4f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id 17592186288876 :answer-field/choices ["q-350532/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-350531/field-1/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "54990329-8839-5b9f-be72-ecbf4c33446c" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-350531/field-1" :answer-field/id #uuid "ea3cb50b-f366-5f3c-b40e-9ce1220974a8" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350531/field-1/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer-field/choices ["q-350531/field-1/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9"] :db/ensure [:answer-field/validate]} {:db/id "q-350531" :question/id #uuid "a61f8d65-5463-50ce-aa4e-b54f5d35b90a" :question/math-academy-id "q-350531" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=4t+3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=4\\,⟹\\,\\text{d}u=4\\text{d}t.\n$$\n\nSince $u\\to \\infty $ when $t\\to \\infty ,$ the table for the limits of integration using the rule $u=4t+3$ is as follows:\n\n| $t$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $3$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t={\\int }_{3}^{\\infty }\\frac{3}{2\\sqrt{{u}^{3}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t & ={\\int }_{3}^{\\infty }\\frac{3}{2\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & ={\\int }_{3}^{\\infty }\\frac{3}{2}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}\\frac{3}{2}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-3{u}^{-1/2}]}_{3}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }{[{u}^{-1/2}]}_{3}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }[\\frac{1}{\\sqrt{a}}-\\frac{1}{\\sqrt{3}}] \\\\  & =-3\\cdot (0-\\frac{1}{\\sqrt{3}}) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350531/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2"] :knowledge-point/questions ["q-350531"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350528/field-1/a90795cb97f088027c1ba4e06482f27437698deb2169bbb6b9bc291f6fb50a79" :answer/id #uuid "72f8065d-d6ac-5d0a-bf32-5c46f2de19c7" :answer/type :answer.type/math :answer/value "\\frac{2}{81}" :db/ensure [:answer/validate]} {:db/id "q-350528/field-1/7110723cdf09d4f34689c4058f443cda2747917885e3e9c8ec877dbcc93f9c3a" :answer/id #uuid "747bb286-32c5-5794-8d89-3067b6d6ebad" :answer/type :answer.type/math :answer/value "\\frac{2}{27}" :db/ensure [:answer/validate]} {:db/id "q-350528/field-1" :answer-field/id #uuid "ecdd8cb4-8959-5cad-9588-3e7a0a2db755" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350528/field-1/a90795cb97f088027c1ba4e06482f27437698deb2169bbb6b9bc291f6fb50a79" :answer-field/choices ["q-350528/field-1/a90795cb97f088027c1ba4e06482f27437698deb2169bbb6b9bc291f6fb50a79" "q-350528/field-1/7110723cdf09d4f34689c4058f443cda2747917885e3e9c8ec877dbcc93f9c3a"] :db/ensure [:answer-field/validate]} {:db/id "q-350528" :question/id #uuid "5404e7e2-ca8a-5dbd-8ad7-53e4bb5ca4fe" :question/math-academy-id "q-350528" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=x+3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=x+3$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $3$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x={\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{{u}^{8}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x & ={\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{{u}^{8}}}\\,\\text{d}u \\\\  & ={\\int }_{3}^{\\infty }2{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}2{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{2}{3}{u}^{-3}]}_{3}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3}]}_{3}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{3}^{3}}] \\\\  & =-\\frac{2}{3}\\cdot (0-\\frac{1}{27}) \\\\  & =\\frac{2}{81}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350528/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2"] :knowledge-point/questions ["q-350528"] :db/ensure [:knowledge-point/validate]} {:db/id "q-152785/selection/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" :answer/id #uuid "1d15d8a5-9581-588a-8ca0-22f32e4dadb6" :answer/type :answer.type/math :answer/value "\\frac{1}{12}" :db/ensure [:answer/validate]} {:db/id "q-152785/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" :answer/id #uuid "18727bbe-e2e5-52a9-9f54-2fa8e7a2d0b4" :answer/type :answer.type/math :answer/value "\\frac{5}{6}" :db/ensure [:answer/validate]} {:db/id "q-152785/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "b88dd8c5-01cb-53a8-b29e-e205e94129ff" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-152785/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "dd94a039-a70d-50e3-9d3a-f8d2e30e7aa5" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-152785/selection/f90eb948f09b2ca494ad948f3ff4825a743d8d8e7dfe2cf71e9adfaa12ddc09d" :answer/id #uuid "8971a357-60ef-5a52-acbd-3b80c36c2abb" :answer/type :answer.type/text :answer/value "The Integral diverges" :db/ensure [:answer/validate]} {:db/id "q-152785/selection" :answer-field/id #uuid "da8fb055-0d15-5c88-ace6-1b413b879ba8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-152785/selection/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" :answer-field/choices ["q-152785/selection/a7643e7c9a6f47b7e23102a9f593aee2dc956fa29938bf5d470303f0587bc3b1" "q-152785/selection/21bc1f5ac2b6db8ca11973d9b85c1eeb6af2cd920b556e0cf3d98ab9a728286a" "q-152785/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" "q-152785/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-152785/selection/f90eb948f09b2ca494ad948f3ff4825a743d8d8e7dfe2cf71e9adfaa12ddc09d"] :db/ensure [:answer-field/validate]} {:db/id "q-152785" :question/id #uuid "0e170d41-084d-538f-a61d-6c472df013b8" :question/math-academy-id "q-152785" :question/problem "Evaluate the integral ${\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z.$" :question/worked-solution "First, we substitute $u={z}^{4}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=4{z}^{3}\\,⟹\\,\\frac{1}{4}\\text{d}u={z}^{3}\\,\\text{d}z.\n$$\n\nSince $u\\to \\infty $ when $z\\to \\infty ,$ the table for the limits of integration using the rule $u={z}^{4}+1$ is as follows:\n\n| $z$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & ={\\int }_{2}^{\\infty }\\frac{8}{{u}^{4}}(\\frac{1}{4}\\,\\text{d}u) \\\\  & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u \\\\  & =2{\\int }_{2}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{2}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }(\\frac{1}{{a}^{3}}-\\frac{1}{8}) \\\\  & =-\\frac{2}{3}(0-\\frac{1}{8}) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-152785/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2"] :knowledge-point/questions ["q-152785"] :db/ensure [:knowledge-point/validate]} {:db/id "q-152080/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" :answer/id #uuid "d93c1dd1-fd9c-530c-b462-be1229e94db8" :answer/type :answer.type/text :answer/value "The integral diverges" :db/ensure [:answer/validate]} {:db/id "q-152080/selection/5bd506083b26258fa0a95592fb35bf47cdd382f7f42161f0c65d3072d0e5167a" :answer/id #uuid "570b97b6-7767-55ff-8a9d-06fabec17b9f" :answer/type :answer.type/math :answer/value "\\frac{3}{25}" :db/ensure [:answer/validate]} {:db/id "q-152080/selection/845101f597595a55f345d7411c0601d1951064b826cd796c53fea51333a1029a" :answer/id #uuid "0c511ab6-1746-5ad7-8b83-2f3d5e297c09" :answer/type :answer.type/math :answer/value "\\frac{1}{75}" :db/ensure [:answer/validate]} {:db/id "q-152080/selection/ed2291aaa5801bdfea85bb6eaebc5df39c902d1e03ab1a86b6d27ed9dde3c019" :answer/id #uuid "ee4c3b7a-2eb4-5e00-8089-b8f2e9d4dffb" :answer/type :answer.type/math :answer/value "\\frac{1}{25}" :db/ensure [:answer/validate]} {:db/id "q-152080/selection/2faeea9c9eedefeae671c807b51ede422449e2976700bcbd604b58e50a79be38" :answer/id #uuid "fc9c1ece-6da2-541b-96eb-067c970a478c" :answer/type :answer.type/math :answer/value "\\frac{1}{15}" :db/ensure [:answer/validate]} {:db/id "q-152080/selection" :answer-field/id #uuid "0622968c-8977-5e11-8cb4-e1476c21bc1b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-152080/selection/845101f597595a55f345d7411c0601d1951064b826cd796c53fea51333a1029a" :answer-field/choices ["q-152080/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" "q-152080/selection/5bd506083b26258fa0a95592fb35bf47cdd382f7f42161f0c65d3072d0e5167a" "q-152080/selection/845101f597595a55f345d7411c0601d1951064b826cd796c53fea51333a1029a" "q-152080/selection/ed2291aaa5801bdfea85bb6eaebc5df39c902d1e03ab1a86b6d27ed9dde3c019" "q-152080/selection/2faeea9c9eedefeae671c807b51ede422449e2976700bcbd604b58e50a79be38"] :db/ensure [:answer-field/validate]} {:db/id "q-152080" :question/id #uuid "fa273f5b-ed18-5bd0-b99c-c7db22579ef5" :question/math-academy-id "q-152080" :question/problem "Evaluate ${\\int }_{-\\infty }^{-3}\\frac{{x}^{2}}{{({x}^{3}+2)}^{2}}\\,\\text{d}x.$" :question/worked-solution "First, we substitute $u={x}^{3}+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\,\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u={x}^{3}+2$ is as follows:\n\n| $x$ | $-3$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-25$ | $-\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-3}\\frac{{x}^{2}}{{({x}^{3}+2)}^{2}}\\,\\text{d}x=\\frac{1}{3}{\\int }_{-\\infty }^{-25}\\frac{1}{{u}^{2}}\\,\\text{d}u.\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-3}\\frac{{x}^{2}}{{({x}^{3}+2)}^{2}}\\,\\text{d}x & =\\frac{1}{3}{\\int }_{-\\infty }^{-25}\\frac{1}{{u}^{2}}\\,\\text{d}u. \\\\  & =\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{-25}{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }{[-{u}^{-1}]}_{a}^{-25} \\\\  & =-\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{u}]}_{a}^{-25} \\\\  & =-\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-25)}-\\frac{1}{a}] \\\\  & =-\\frac{1}{3}(-\\frac{1}{25}-0) \\\\  & =\\frac{1}{75}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-152080/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12"] :knowledge-point/questions ["q-152080"] :db/ensure [:knowledge-point/validate]} {:db/id "q-152073/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" :answer/id #uuid "884d42e7-8c61-5605-b94e-e76d28e3d13f" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-152073/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "7c7a9dfa-3a83-582c-bf91-a2e38c5165be" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-152073/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "5d99763c-ab4d-5d13-beb2-3a0d6dcc1299" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-152073/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "760edbcc-8cc4-5d02-9ccc-cd12a044f6ea" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-152073/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "848a41bb-e838-5474-83c1-7c60ee93b484" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-152073/selection" :answer-field/id #uuid "cefb5cf4-a995-56d9-b548-800b70a60798" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-152073/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-152073/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" "q-152073/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-152073/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-152073/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-152073/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-152073" :question/id #uuid "9f259d1c-9ee4-5cec-a652-10655665ae0e" :question/math-academy-id "q-152073" :question/problem "${\\int }_{-\\infty }^{-2}\\frac{4}{{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-2}\\frac{4}{{x}^{2}}\\,\\text{d}x & =4{lim}_{a\\to -\\infty }{\\int }_{a}^{-2}{x}^{-2}\\,\\text{d}x \\\\  & =4{lim}_{a\\to -\\infty }{[-{x}^{-1}]}_{a}^{-2} \\\\  & =-4\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{x}]}_{a}^{-2} \\\\  & =-4\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-2)}-\\frac{1}{a}] \\\\  & =-4\\cdot (-\\frac{1}{2}-0) \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-152073/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12"] :knowledge-point/questions ["q-152073"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-20872"] :question/problem "${\\int }_{-\\infty }^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x=$" :question/worked-solution "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{x}^{-3}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[-\\frac{1}{2}{x}^{-2}]}_{a}^{-1} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{x}^{2}}]}_{a}^{-1} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-1)^{2}}-\\frac{1}{{a}^{2}}] \\\\  & =-\\frac{1}{2}\\cdot 1 \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-350541/field-1/218737221c87068b5a3ecf4846db83f5270e1c6afb30794119a7ebf529f20fa6" :answer/id #uuid "d43c431d-1b0e-54a7-b48c-4148f021cef9" :answer/type :answer.type/math :answer/value "\\frac{1}{60}" :db/ensure [:answer/validate]} {:db/id "q-350541/field-1/f594cbbb4a66bc41743b074d8df31c04839068c3f93c44ebcfba00b647948a3b" :answer/id #uuid "a80003de-7aa5-5c1e-a203-51119564ddba" :answer/type :answer.type/math :answer/value "\\frac{1}{20}" :db/ensure [:answer/validate]} {:db/id "q-350541/field-1" :answer-field/id #uuid "610bd97b-4b7c-54b0-9996-f645f37e5e5e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350541/field-1/218737221c87068b5a3ecf4846db83f5270e1c6afb30794119a7ebf529f20fa6" :answer-field/choices ["q-350541/field-1/218737221c87068b5a3ecf4846db83f5270e1c6afb30794119a7ebf529f20fa6" "q-350541/field-1/f594cbbb4a66bc41743b074d8df31c04839068c3f93c44ebcfba00b647948a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-350541" :question/id #uuid "2d8ff14d-b0de-5272-8574-0c630c74c23b" :question/math-academy-id "q-350541" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}\\frac{8}{(3y-2)^{6}}\\,\\text{d}y=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=3y-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=3\\,⟹\\,\\text{d}u=3\\text{d}y.\n$$\n\nSince $u\\to -\\infty $ when $y\\to -\\infty ,$ the table for the limits of integration using the rule $u=3y-2$ is as follows:\n\n| $y$ | $-\\infty $ | $0$ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $-2$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{0}\\frac{8}{(3y-2)^{6}}\\,\\text{d}y={\\int }_{-\\infty }^{-2}\\frac{8}{3{u}^{6}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-2}\\frac{8}{3{u}^{6}}\\,\\text{d}u & =\\frac{8}{3}{lim}_{a\\to -\\infty }{\\int }_{a}^{-2}{u}^{-6}\\,\\text{d}u \\\\  & =\\frac{8}{3}{lim}_{a\\to -\\infty }{[-\\frac{1}{5}{u}^{-5}]}_{a}^{-2} \\\\  & =-\\frac{8}{15}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{5}}]}_{a}^{-2} \\\\  & =-\\frac{8}{15}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-2)^{5}}-\\frac{1}{{a}^{5}}] \\\\  & =-\\frac{8}{15}\\cdot (-\\frac{1}{32}-0) \\\\  & =\\frac{1}{60}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350541/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12"] :knowledge-point/questions ["q-350541"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350545/field-1/6ab9c942f0bdf8387beb8bd7d5b0dca8d94536c2237134f3250eeba6f05f6e80" :answer/id #uuid "6513878f-97ae-56bf-a805-82af099c8116" :answer/type :answer.type/math :answer/value "\\frac{4}{81}" :db/ensure [:answer/validate]} {:db/id "q-350545/field-1" :answer-field/id #uuid "2b9dbd80-74e2-5f3b-b789-70e959eb62bb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350545/field-1/6ab9c942f0bdf8387beb8bd7d5b0dca8d94536c2237134f3250eeba6f05f6e80" :answer-field/choices ["q-350545/field-1/6ab9c942f0bdf8387beb8bd7d5b0dca8d94536c2237134f3250eeba6f05f6e80"] :db/ensure [:answer-field/validate]} {:db/id "q-350545" :question/id #uuid "a81a7145-95d3-5175-8540-457ed8a70894" :question/math-academy-id "q-350545" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{-1}\\frac{20{x}^{4}}{({x}^{5}-2)^{4}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u={x}^{5}-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u={x}^{5}-2$ is as follows:\n\n| $x$ | $-\\infty $ | $-1$ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $-3$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-1}\\frac{20{x}^{4}}{({x}^{5}-2)^{4}}\\,\\text{d}x={\\int }_{-\\infty }^{-3}\\frac{4}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-3}\\frac{4}{{u}^{4}}\\,\\text{d}u & =4{lim}_{a\\to -\\infty }{\\int }_{a}^{-3}{u}^{-4}\\,\\text{d}u \\\\  & =4{lim}_{a\\to -\\infty }{[-\\frac{1}{3}{u}^{-3}]}_{a}^{-3} \\\\  & =-\\frac{4}{3}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{3}}]}_{a}^{-3} \\\\  & =-\\frac{4}{3}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-3)^{3}}-\\frac{1}{{a}^{3}}] \\\\  & =-\\frac{4}{3}\\cdot (-\\frac{1}{27}-0) \\\\  & =\\frac{4}{81}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-350545/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12"] :knowledge-point/questions ["q-350545"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80342/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "e9a49859-a401-5650-84f7-7c45612d0c51" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-80342/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "2ead26d2-6053-54cd-99fe-048771dcd319" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-80342/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "0d49f380-a9ca-5e4f-84c8-2fac0a7fc1c9" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-80342/selection/7ea009d38067b85c260cd71ce15cce585e1f931f7adf440bc470127b22bd36c2" :answer/id #uuid "ed834307-d51c-562e-9d1c-09da7ae9f234" :answer/type :answer.type/text :answer/value "The integral is divergent" :db/ensure [:answer/validate]} {:db/id "q-80342/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "ff6ab626-0cb6-55f4-8f8a-31fd0baf4b4f" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-80342/selection" :answer-field/id #uuid "4f977b89-5ff1-5470-a706-032247c2ae34" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80342/selection/7ea009d38067b85c260cd71ce15cce585e1f931f7adf440bc470127b22bd36c2" :answer-field/choices ["q-80342/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-80342/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-80342/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-80342/selection/7ea009d38067b85c260cd71ce15cce585e1f931f7adf440bc470127b22bd36c2" "q-80342/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-80342" :question/id #uuid "d0d42f46-94b6-5bf0-ac2d-2b69e88b9757" :question/math-academy-id "q-80342" :question/problem "Evaluate ${\\int }_{-\\infty }^{0}\\frac{\\text{d}z}{\\sqrt{1-z}}.$" :question/worked-solution "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{\\text{d}z}{\\sqrt{1-z}} & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{\\text{d}z}{\\sqrt{1-z}} \\\\  & ={lim}_{a\\to -\\infty }{[-2\\sqrt{1-z}]}_{a}^{0} \\\\  & =-2\\cdot {lim}_{a\\to -\\infty }(\\sqrt{1-0}-\\sqrt{1-a}) \\\\  & =-2+2\\cdot {lim}_{a\\to -\\infty }\\sqrt{1-a} \\\\  & =-2+2\\cdot \\infty  \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-80342/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dc6d9b69-0459-515a-ba7b-c62cab96ca00"] :knowledge-point/questions ["q-80342"] :db/ensure [:knowledge-point/validate]} {:db/id "q-5964/selection/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" :answer/id #uuid "d7307377-eb31-55f9-969b-a0b58e2584d1" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-5964/selection/7ea009d38067b85c260cd71ce15cce585e1f931f7adf440bc470127b22bd36c2" :answer/id #uuid "8f569797-b6c9-5f13-ae38-77d15b994b03" :answer/type :answer.type/text :answer/value "The integral is divergent" :db/ensure [:answer/validate]} {:db/id "q-5964/selection/7f8657d5825e3425423a974c63bc9bea1f4b27e3dab9810688fb4ac77f66cf94" :answer/id #uuid "ed05cc4c-9148-5278-a1b1-6d44db5df57b" :answer/type :answer.type/math :answer/value "-\\frac{15}{8}" :db/ensure [:answer/validate]} {:db/id "q-5964/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "0bcd1184-aeb9-5c36-b1e0-b3656321ec13" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-5964/selection/0a7f84ce6a5311ee2a131d459729f4ba2610ffac28c52f629e461ace99cdaa88" :answer/id #uuid "850bf373-e368-522c-ac3f-d215b97ab8df" :answer/type :answer.type/math :answer/value "-\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "q-5964/selection" :answer-field/id #uuid "0a0112c6-1ed1-5678-9317-