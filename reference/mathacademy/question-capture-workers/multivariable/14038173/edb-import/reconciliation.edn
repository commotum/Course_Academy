3}^{a}5{x}^{-2}\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[(-5{x}^{-1})]}_{3}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{x}]}_{3}^{a} \\\\  & =-5\\cdot {lim}_{a\\to \\infty }(\\frac{1}{a}-\\frac{1}{3}) \\\\  & =-5\\cdot (0-\\frac{1}{3}) \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152758" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-152758" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152758" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{3}"] ["math" "\\frac{1}{5}"] ["math" "\\frac{5}{2}"] ["math" "\\frac{5}{3}"] ["text" "The integral diverges"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152758" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350333" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{1}^{\\infty }\\frac{12}{\\sqrt[3]{{s}^{7}}}\\,\\text{d}s=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350333" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{12}{\\sqrt[3]{{s}^{7}}}\\,\\text{d}s & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{12}{\\sqrt[3]{{s}^{7}}}\\,\\text{d}s \\\\  & =12{lim}_{a\\to \\infty }{\\int }_{1}^{a}{s}^{-7/3}\\,\\text{d}s \\\\  & =12{lim}_{a\\to \\infty }{[-\\frac{3}{4}{s}^{-4/3}]}_{1}^{a} \\\\  & =-9\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{{s}^{4}}}]}_{1}^{a} \\\\  & =-9\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{{a}^{4}}}-\\frac{1}{\\sqrt[3]{{1}^{4}}}) \\\\  & =-9(0-1) \\\\  & =9.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350333" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-350333" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350333" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350534" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{4{x}^{3}}{\\sqrt{({x}^{4}+2)^{3}}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350534" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u={x}^{4}+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4{x}^{3}\\,⟹\\,\\text{d}u=4{x}^{3}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u={x}^{4}+2$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{4{x}^{3}}{\\sqrt{({x}^{4}+2)^{3}}}\\,\\text{d}x={\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{4{x}^{3}}{\\sqrt{({x}^{4}+2)^{3}}}\\,\\text{d}x & ={\\int }_{2}^{\\infty }\\frac{1}{\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & ={\\int }_{2}^{\\infty }{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-2{u}^{-1/2}]}_{2}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }{[{u}^{-1/2}]}_{2}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{1/2}}-\\frac{1}{{2}^{1/2}}] \\\\  & =-2\\cdot (0-\\frac{1}{\\sqrt{2}}) \\\\  & =\\sqrt{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350534" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-350534" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350534" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\sqrt{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350532" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{2}{(5\\theta +1)^{3}}\\,\\text{d}\\theta =$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350532" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=5\\theta +1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}\\theta }=5\\,⟹\\,\\text{d}u=5\\text{d}\\theta .\n$$\n\nSince $u\\to \\infty $ when $\\theta \\to \\infty ,$ the table for the limits of integration using the rule $u=5\\theta +1$ is as follows:\n\n| $\\theta $ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{2}{(5\\theta +1)^{3}}\\,\\text{d}\\theta ={\\int }_{1}^{\\infty }\\frac{2}{5{u}^{3}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{(5\\theta +1)^{3}}\\,\\text{d}\\theta  & ={\\int }_{1}^{\\infty }\\frac{2}{5{u}^{3}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{\\infty }\\frac{2}{5}{u}^{-3}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{2}{5}{u}^{-3}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{5}{u}^{-2}]}_{1}^{a} \\\\  & =-\\frac{1}{5}\\cdot {lim}_{a\\to \\infty }{[{u}^{-2}]}_{1}^{a} \\\\  & =-\\frac{1}{5}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{2}}-\\frac{1}{{1}^{2}}] \\\\  & =-\\frac{1}{5}\\cdot (0-1) \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350532" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-350532" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350532" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{5}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350531" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350531" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=4t+3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}t}=4\\,⟹\\,\\text{d}u=4\\text{d}t.\n$$\n\nSince $u\\to \\infty $ when $t\\to \\infty ,$ the table for the limits of integration using the rule $u=4t+3$ is as follows:\n\n| $t$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $3$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t={\\int }_{3}^{\\infty }\\frac{3}{2\\sqrt{{u}^{3}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{6}{\\sqrt{(4t+3)^{3}}}\\,\\text{d}t & ={\\int }_{3}^{\\infty }\\frac{3}{2\\sqrt{{u}^{3}}}\\,\\text{d}u \\\\  & ={\\int }_{3}^{\\infty }\\frac{3}{2}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}\\frac{3}{2}{u}^{-3/2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-3{u}^{-1/2}]}_{3}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }{[{u}^{-1/2}]}_{3}^{a} \\\\  & =-3\\cdot {lim}_{a\\to \\infty }[\\frac{1}{\\sqrt{a}}-\\frac{1}{\\sqrt{3}}] \\\\  & =-3\\cdot (0-\\frac{1}{\\sqrt{3}}) \\\\  & =\\sqrt{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350531" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-350531" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350531" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\sqrt{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350528" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350528" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=x+3.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=1\\,⟹\\,\\text{d}u=\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=x+3$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $3$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x={\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{{u}^{8}}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{2}{\\sqrt{(x+3)^{8}}}\\,\\text{d}x & ={\\int }_{3}^{\\infty }\\frac{2}{\\sqrt{{u}^{8}}}\\,\\text{d}u \\\\  & ={\\int }_{3}^{\\infty }2{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{3}^{a}2{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{2}{3}{u}^{-3}]}_{3}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3}]}_{3}^{a} \\\\  & =-\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{3}^{3}}] \\\\  & =-\\frac{2}{3}\\cdot (0-\\frac{1}{27}) \\\\  & =\\frac{2}{81}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350528" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-350528" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350528" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{81}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152785" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152785" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u={z}^{4}+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=4{z}^{3}\\,⟹\\,\\frac{1}{4}\\text{d}u={z}^{3}\\,\\text{d}z.\n$$\n\nSince $u\\to \\infty $ when $z\\to \\infty ,$ the table for the limits of integration using the rule $u={z}^{4}+1$ is as follows:\n\n| $z$ | $1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & ={\\int }_{2}^{\\infty }\\frac{8}{{u}^{4}}(\\frac{1}{4}\\,\\text{d}u) \\\\  & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u.\\end{aligned}\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{8{z}^{3}}{{({z}^{4}+1)}^{4}}\\,\\text{d}z & =2{\\int }_{2}^{\\infty }\\frac{1}{{u}^{4}}\\,\\text{d}u \\\\  & =2{\\int }_{2}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{2}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =2{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{2}^{a} \\\\  & =-\\frac{2}{3}{lim}_{a\\to \\infty }(\\frac{1}{{a}^{3}}-\\frac{1}{8}) \\\\  & =-\\frac{2}{3}(0-\\frac{1}{8}) \\\\  & =\\frac{1}{12}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152785" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-152785" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152785" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{12}"] ["math" "\\frac{1}{6}"] ["math" "\\frac{3}{4}"] ["math" "\\frac{5}{6}"] ["text" "The Integral diverges"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152785" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{12}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152080" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{-\\infty }^{-3}\\frac{{x}^{2}}{{({x}^{3}+2)}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152080" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u={x}^{3}+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\,\\text{d}u={x}^{2}\\,\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u={x}^{3}+2$ is as follows:\n\n| $x$ | $-3$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $-25$ | $-\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-3}\\frac{{x}^{2}}{{({x}^{3}+2)}^{2}}\\,\\text{d}x=\\frac{1}{3}{\\int }_{-\\infty }^{-25}\\frac{1}{{u}^{2}}\\,\\text{d}u.\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-3}\\frac{{x}^{2}}{{({x}^{3}+2)}^{2}}\\,\\text{d}x & =\\frac{1}{3}{\\int }_{-\\infty }^{-25}\\frac{1}{{u}^{2}}\\,\\text{d}u. \\\\  & =\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }{\\int }_{a}^{-25}{u}^{-2}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }{[-{u}^{-1}]}_{a}^{-25} \\\\  & =-\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{u}]}_{a}^{-25} \\\\  & =-\\frac{1}{3}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-25)}-\\frac{1}{a}] \\\\  & =-\\frac{1}{3}(-\\frac{1}{25}-0) \\\\  & =\\frac{1}{75}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152080" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-152080" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152080" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{15}"] ["math" "\\frac{1}{25}"] ["math" "\\frac{1}{75}"] ["math" "\\frac{3}{25}"] ["text" "The integral diverges"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152080" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{75}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/questi