$$\n\\begin{aligned}{\\int }_{8}^{\\infty }\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z & ={lim}_{a\\to \\infty }{\\int }_{8}^{a}\\frac{2}{\\sqrt[3]{{z}^{4}}}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{\\int }_{8}^{a}{z}^{-4/3}\\,\\text{d}z \\\\  & =2{lim}_{a\\to \\infty }{[-3{z}^{-1/3}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{\\sqrt[3]{z}}]}_{8}^{a} \\\\  & =-6\\cdot {lim}_{a\\to \\infty }(\\frac{1}{\\sqrt[3]{a}}-\\frac{1}{\\sqrt[3]{8}}) \\\\  & =-6(0-\\frac{1}{2}) \\\\  & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152762" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-152762" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152762" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "6"] ["math" "\\frac{1}{3}"] ["math" "\\frac{4}{3}"] ["text" "The integral diverges"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152762" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "categor