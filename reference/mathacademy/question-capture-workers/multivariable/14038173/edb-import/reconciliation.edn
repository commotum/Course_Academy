a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152073" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "\\frac{1}{2}"] ["math" "\\frac{1}{3}"] ["math" "\\frac{1}{4}"] ["math" "\\frac{1}{8}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-152073" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-20872" "field" nil "attribute" "question/problem" "value" "${\\int }_{-\\infty }^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-20872" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{1}{{x}^{3}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{x}^{-3}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[-\\frac{1}{2}{x}^{-2}]}_{a}^{-1} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{x}^{2}}]}_{a}^{-1} \\\\  & =-\\frac{1}{2}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-1)^{2}}-\\frac{1}{{a}^{2}}] \\\\  & =-\\frac{1}{2}\\cdot 1 \\\\  & =-\\frac{1}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-20872" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-20872" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-20872" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "-\\frac{1}{2}"] ["math" "-\\frac{1}{4}"] ["math" "-\\frac{1}{5}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-20872" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350541" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}\\frac{8}{(3y-2)^{6}}\\,\\text{d}y=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350541" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=3y-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=3\\,⟹\\,\\text{d}u=3\\text{d}y.\n$$\n\nSince $u\\to -\\infty $ when $y\\to -\\infty ,$ the table for the limits of integration using the rule $u=3y-2$ is as follows:\n\n| $y$ | $-\\infty $ | $0$ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $-2$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{0}\\frac{8}{(3y-2)^{6}}\\,\\text{d}y={\\int }_{-\\infty }^{-2}\\frac{8}{3{u}^{6}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-2}\\frac{8}{3{u}^{6}}\\,\\text{d}u & =\\frac{8}{3}{lim}_{a\\to -\\infty }{\\int }_{a}^{-2}{u}^{-6}\\,\\text{d}u \\\\  & =\\frac{8}{3}{lim}_{a\\to -\\infty }{[-\\frac{1}{5}{u}^{-5}]}_{a}^{-2} \\\\  & =-\\frac{8}{15}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{5}}]}_{a}^{-2} \\\\  & =-\\frac{8}{15}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-2)^{5}}-\\frac{1}{{a}^{5}}] \\\\  & =-\\frac{8}{15}\\cdot (-\\frac{1}{32}-0) \\\\  & =\\frac{1}{60}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350541" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-350541" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350541" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{60}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350545" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{-1}\\frac{20{x}^{4}}{({x}^{5}-2)^{4}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350545" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u={x}^{5}-2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5{x}^{4}\\,⟹\\,\\text{d}u=5{x}^{4}\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u={x}^{5}-2$ is as follows:\n\n| $x$ | $-\\infty $ | $-1$ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $-3$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-1}\\frac{20{x}^{4}}{({x}^{5}-2)^{4}}\\,\\text{d}x={\\int }_{-\\infty }^{-3}\\frac{4}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-3}\\frac{4}{{u}^{4}}\\,\\text{d}u & =4{lim}_{a\\to -\\infty }{\\int }_{a}^{-3}{u}^{-4}\\,\\text{d}u \\\\  & =4{lim}_{a\\to -\\infty }{[-\\frac{1}{3}{u}^{-3}]}_{a}^{-3} \\\\  & =-\\frac{4}{3}\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{3}}]}_{a}^{-3} \\\\  & =-\\frac{4}{3}\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-3)^{3}}-\\frac{1}{{a}^{3}}] \\\\  & =-\\frac{4}{3}\\cdot (-\\frac{1}{27}-0) \\\\  & =\\frac{4}{81}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350545" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-350545" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-350545" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{81}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80342" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{-\\infty }^{0}\\frac{\\text{d}z}{\\sqrt{1-z}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80342" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{\\text{d}z}{\\sqrt{1-z}} & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}\\frac{\\text{d}z}{\\sqrt{1-z}} \\\\  & ={lim}_{a\\to -\\infty }{[-2\\sqrt{1-z}]}_{a}^{0} \\\\  & =-2\\cdot {lim}_{a\\to -\\infty }(\\sqrt{1-0}-\\sqrt{1-a}) \\\\  & =-2+2\\cdot {lim}_{a\\to -\\infty }\\sqrt{1-a} \\\\  & =-2+2\\cdot \\infty  \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80342" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-80342" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80342" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "-4"] ["math" "-\\frac{1}{2}"] ["text" "The integral is divergent"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80342" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "The integral is divergent"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-6032" "field" nil "attribute" "question/problem" "value" "Which of the following improper integrals are divergent?\n\n- ${\\int }_{10}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x$\n- ${\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x$\n- ${\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}}\\,\\text{d}x$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-6032" "field" nil "attribute" "question/worked-solution" "value" "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{10}^{\\infty }\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{10}^{a}\\frac{1}{\\sqrt{x-1}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[2\\sqrt{x-1}]}_{10}^{a} \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-2\\sqrt{10-1}) \\\\  & ={lim}_{a\\to \\infty }(2\\sqrt{a-1}-6) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{1}{x}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-1}\\frac{1}{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\operatorname{ln}⁡|x|]}_{a}^{-1} \\\\  & ={lim}_{a\\to -\\infty }(\\operatorname{ln}⁡|-1|-\\operatorname{ln}⁡|a|) \\\\  & =-\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{{x}^{2}}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{1}{{x}^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{x}]}_{1}^{a} \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{a}+\\frac{1}{1}) \\\\  & =1,\\end{aligned}\n$$\n\nso the integral is convergent.\n\nIn conclusion, only integrals I and II are divergent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-6032" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-6032" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-6032" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-6032" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-101735" "field" nil "attribute" "question/problem" "value" "Which of the following improper integrals are divergent?\n\n- ${\\int }_{-\\infty }^{-2}\\frac{1}{{u}^{3}}\\,\\text{d}u$\n- ${\\int }_{0}^{\\infty }\\frac{1}{(z+3)^{2}}\\,\\text{d}z$\n- ${\\int }_{2}^{\\infty }\\frac{1}{x}\\,\\text{d}x$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-101735" "field" nil "attribute" "question/worked-solution" "value" "Let's work out each integral.\n\nFor the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-2}\\frac{1}{{u}^{3}}\\,\\text{d}u & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-2}\\frac{1}{{u}^{3}}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{[-\\frac{1}{2{u}^{2}}]}_{a}^{-2} \\\\  & ={lim}_{a\\to -\\infty }(-\\frac{1}{2(-2)^{2}}+\\frac{1}{2{a}^{2}}) \\\\  & ={lim}_{a\\to -\\infty }(\\frac{1}{2{a}^{2}}-\\frac{1}{8}) \\\\  & =-\\frac{1}{8},\\end{aligned}\n$$\n\nso the integral is convergent.\n\nFor the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{1}{(z+3)^{2}}\\,\\text{d}z & ={lim}_{a\\to \\infty }{\\int }_{0}^{a}\\frac{1}{(z+3)^{2}}\\,\\text{d}z \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{1}{z+3}]}_{0}^{a} \\\\  & ={lim}_{a\\to \\infty }(-\\frac{1}{a+3}+\\frac{1}{0+3}) \\\\  & =\\frac{1}{3},\\end{aligned}\n$$\n\nso the integral is convergent.\n\nFor the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{1}{x}\\,\\text{d}x & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{1}{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to \\infty }[\\operatorname{ln}⁡|x|]_{2}^{a} \\\\  & ={lim}_{a\\to \\infty }(\\operatorname{ln}⁡a-\\operatorname{ln}⁡2) \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\nIn conclusion, only integrals III is divergent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-101735" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-101735" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-101735" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-101735" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80347" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\int }_{-\\infty }^{-1}\\frac{{x}^{2}}{\\sqrt{8-{x}^{3}}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80347" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=8-{x}^{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3{x}^{2}\\,⟹\\,-\\frac{1}{3}\\,\\text{d}u={x}^{2}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=8-{x}^{3}$ is as follows:\n\n$$\n\\begin{aligned}x & -1 & -\\infty  \\\\ u & 9 & \\infty \\end{aligned}\n$$\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-1}\\frac{{x}^{2}}{\\sqrt{8-{x}^{3}}}\\,\\text{d}x={\\int }_{\\infty }^{9}(-\\frac{1}{3\\sqrt{u}})\\,\\text{d}u=\\frac{1}{3}{\\int }_{9}^{\\infty }\\frac{1}{\\sqrt{u}}\\,\\text{d}u.\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{{x}^{2}}{\\sqrt{8-{x}^{3}}}\\,\\text{d}x & =\\frac{1}{3}\\cdot {lim}_{a\\to \\infty }{\\int }_{9}^{a}\\frac{1}{\\sqrt{u}}\\,\\text{d}u \\\\  & =\\frac{1}{3}\\cdot {lim}_{a\\to \\infty }{[2\\sqrt{u}]}_{9}^{a} \\\\  & =\\frac{2}{3}\\cdot {lim}_{a\\to \\infty }[\\sqrt{a}-\\sqrt{9}] \\\\  & =\\frac{2}{3}\\cdot \\infty  \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80347" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-80347" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80347" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-\\frac{2}{3}"] ["math" "2"] ["math" "\\frac{1}{3}"] ["text" "The integral is divergent"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-80347" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "The integral is divergent"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-5964" "field" nil "attribute" "question/problem" "value" "${\\int }_{1}^{\\infty }-\\frac{6}{\\sqrt[5]{x}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-5964" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }-\\frac{6}{\\sqrt[5]{x}}\\,\\text{d}x & =-6\\cdot {lim}_{a\\to \\infty }{\\int }_{1}^{a}\\frac{1}{\\sqrt[5]{x}}\\,\\text{d}x \\\\  & =-6\\cdot {lim}_{a\\to \\infty }{[\\frac{5}{4}{x}^{4/5}]}_{1}^{a} \\\\  & =-\\frac{15}{2}\\cdot {lim}_{a\\to \\infty }{[{x}^{4/5}]}_{1}^{a} \\\\  & =-\\frac{15}{2}\\cdot {lim}_{a\\to \\infty }({a}^{4/5}-1) \\\\  & =-\\frac{15}{2}\\cdot \\infty  \\\\  & =-\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-5964" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/activity-metadata.json" "file_sha256" "aa0b14a86a2daf58bc7eca87741e85faeccd6a87593339a5336720ba2940d61f"} {"question" "q-5964" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-5964" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{15}{2}"] ["math" "-\\frac{15}{8}"] ["math" "-\\frac{1}{2}"] ["math" "-\\frac{3}{2}"] ["text" "The integral is divergent"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "q-5964" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "The integral is divergent"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/state.json" "file_sha256" "b69ab6711ad421d51a9f7fadb7dc5ae09cf0a84faa28b456994b4cdeb03fe8f6"} {"question" "e-511" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int_2^\\infty \\dfrac { 8}{t^5}  \\,\\textrm{d}t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-511.json" "file_sha256" "1f7cd81c1ed1667d1bd40081579ea8a5bc9b56037d67966883560c7ca4ead6b3"} {"question" "e-511" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to\\infty.$\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{8}{{t}^{5}}\\,\\text{d}t & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{8}{{t}^{5}}\\,\\text{d}t \\\\  & =8{lim}_{a\\to \\infty }{\\int }_{2}^{a}{t}^{-5}\\,\\text{d}t \\\\  & =8{lim}_{a\\to \\infty }{[-\\frac{1}{4}{t}^{-4}]}_{2}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{t}^{4}}]}_{2}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }(\\frac{1}{{a}^{4}}-\\frac{1}{{2}^{4}}) \\\\  & =-2(0-\\frac{1}{16}) \\\\  & =\\frac{1}{8}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-511.json" "file_sha256" "1f7cd81c1ed1667d1bd40081579ea8a5bc9b56037d67966883560c7ca4ead6b3"} {"question" "e-10717" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle\\int_0^\\infty \\dfrac{1}{(x+1)^2} \\,\\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-10717.json" "file_sha256" "73b2ed70acdc75bf93e60583e5221c525cdac18314d44f0e961006d6e8970487"} {"question" "e-10717" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=x+1.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x} = 1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}u =\\textrm{d}x.\n$$\n\nSince $u \\to \\infty$ when $x \\to \\infty,$ the table for the limits of integration using the rule $u=x+1$ is as follows:\n\n| $x$ | $0$ | $\\infty$ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\int_0^\\infty \\dfrac{1}{(x+1)^2} \\,\\textrm{d}x\n=\n\\int_1^\\infty \\dfrac{1}{u^2} \\,\\textrm{d}u.\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to\\infty.$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{1}{(x+1)^{2}}\\,\\text{d}x & ={\\int }_{1}^{\\infty }\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & ={\\int }_{1}^{\\infty }{u}^{-2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-2}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-{u}^{-1}]}_{1}^{a} \\\\  & =-{lim}_{a\\to \\infty }{[\\frac{1}{u}]}_{1}^{a} \\\\  & =-1\\cdot {lim}_{a\\to \\infty }[\\frac{1}{a}-\\frac{1}{1}] \\\\  & =-1\\cdot (0-1) \\\\  & =1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-10717.json" "file_sha256" "73b2ed70acdc75bf93e60583e5221c525cdac18314d44f0e961006d6e8970487"} {"question" "e-512" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int_{-\\infty}^{0}    \\dfrac{1}{(x-4)^2} \\,\\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-512.json" "file_sha256" "f2a030f9621ba5e6759ccd432865242da0b2ef78f1f0ace804d31bcf3633d237"} {"question" "e-512" "field" nil "attribute" "question/worked-solution" "value" "Notice that, this time, it's the *lower* limit of integration that's unbounded.  \n\nFirst, we substitute $u=x-4.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}= 1\n\\quad\\Longrightarrow\\quad\n\\textrm{d}u =\\textrm{d}x.\n$$\n\nSince $u\\to -\\infty$ when $x\\to -\\infty,$ the table for the limits of integration using the rule $u=x-4$ is as follows:\n\n| $x$ | $0$ | $-\\infty$ |\n| --- | --- | --- |\n| $u$ | $-4$ | $-\\infty$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\displaystyle \\int_{-\\infty}^{0}    \\dfrac{1}{(x-4)^2} \\,\\textrm{d}x\n=\\int_{-\\infty}^{-4} \\dfrac{1}{u^2}  \\,\\textrm{d}u.\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to-\\infty.$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}\\frac{1}{(x-4)^{2}}\\,\\text{d}x & ={\\int }_{-\\infty }^{-4}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & ={\\int }_{-\\infty }^{-4}{u}^{-2}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-4}{u}^{-2}\\,\\text{d}u \\\\  & ={lim}_{a\\to -\\infty }{[-{u}^{-1}]}_{a}^{-4} \\\\  & =-1\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{u}]}_{a}^{-4} \\\\  & =-1\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-4)}-\\frac{1}{a}] \\\\  & =-1\\cdot {lim}_{a\\to -\\infty }(-\\frac{1}{4}-\\frac{1}{a}) \\\\  & =-1\\cdot (-\\frac{1}{4}-0) \\\\  & =\\frac{1}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-512.json" "file_sha256" "f2a030f9621ba5e6759ccd432865242da0b2ef78f1f0ace804d31bcf3633d237"} {"question" "e-513" "field" nil "attribute" "question/problem" "value" "Which of the following improper integrals are divergent?\n\n- $\\displaystyle \\int_1^\\infty \\frac{1}{\\sqrt{x} }\\,\\textrm{d}x$\n\n- $\\displaystyle \\int_{-\\infty}^{-2} \\frac{1}{(1+x)^2}\\,\\textrm{d}x$\n\n- $\\displaystyle \\int_{1}^\\infty \\dfrac{1}{x^3} \\,\\textrm{d}x$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-513.json" "file_sha256" "52085e349980b4f06c3f55be95be4ba39a848f59cf174bbcdebacf9056023f40"} {"question" "e-513" "field" nil "attribute" "question/worked-solution" "value" "Let's work out each integral.\n\n- For the first integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{\\sqrt{x}}\\,\\text{d}x & ={lim}_{b\\to \\infty }{\\int }_{1}^{b}\\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\  & ={lim}_{b\\to \\infty }{\\int }_{1}^{b}{x}^{-1/2}\\,\\text{d}x \\\\  & ={lim}_{b\\to \\infty }{[2{x}^{1/2}]}_{1}^{b} \\\\  & =2{lim}_{b\\to \\infty }{[\\sqrt{x}]}_{1}^{b} \\\\  & =2{lim}_{b\\to \\infty }[\\sqrt{b}-1] \\\\  & =\\infty ,\\end{aligned}\n$$\n\nso the integral diverges.\n\n- For the second integral, we have\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-2}\\frac{1}{(1+x)^{2}}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{-2}\\frac{1}{(1+x)^{2}}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[-\\frac{1}{1+x}]}_{a}^{-2} \\\\  & ={lim}_{a\\to -\\infty }[-\\frac{1}{1-2}+\\frac{1}{1+a}] \\\\  & ={lim}_{a\\to -\\infty }[\\frac{1}{1+a}+1] \\\\  & =1,\\end{aligned}\n$$\n\nso the integral is convergent (not divergent).\n\n- For the third integral, we have\n\n$$\n\\begin{aligned}{\\int }_{1}^{\\infty }\\frac{1}{{x}^{3}}\\,\\text{d}x & ={lim}_{b\\to \\infty }{\\int }_{1}^{b}\\frac{1}{{x}^{3}}\\,\\text{d}x \\\\  & ={lim}_{b\\to \\infty }{\\int }_{1}^{b}{x}^{-3}\\,\\text{d}x \\\\  & ={lim}_{b\\to \\infty }{[-\\frac{1}{2{x}^{2}}]}_{1}^{b} \\\\  & ={lim}_{b\\to \\infty }[-\\frac{1}{2{b}^{2}}+\\frac{1}{2({1}^{2})}] \\\\  & ={lim}_{b\\to \\infty }[\\frac{1}{2}-\\frac{1}{2{b}^{2}}] \\\\  & =\\frac{1}{2}-0 \\\\  & =\\frac{1}{2},\\end{aligned}\n$$\n\nso the integral is convergent (not divergent).\n\nIn conclusion, only integral I is divergent." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038173/example-513.json" "file_sha256" "52085e349980b4f06c3f55be95be4ba39a848f59cf174bbcdebacf9056023f40"}] "usage" {"q-20872" [] "q-80347" [] "e-10717" [] "q-6032" [] "e-512" [] "q-152762" [] "e-513" [] "q-350532" [] "q-101735" [] "e-511" [] "q-350534" []} "basis" 1305 "retr