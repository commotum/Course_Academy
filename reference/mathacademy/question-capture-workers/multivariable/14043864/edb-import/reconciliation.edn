cademy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65060" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-65060" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65060" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2y({x}^{2}+{y}^{2}){e}^{{x}^{2}{y}^{2}}"] ["math" "4(x+y)({x}^{2}+{y}^{2}){e}^{{x}^{2}{y}^{2}}"] ["math" "4xy(1+{x}^{2}{y}^{2}){e}^{{x}^{2}{y}^{2}}"] ["math" "4y(1-{x}^{2}{y}^{2}){e}^{{x}^{2}{y}^{2}}"] ["math" "xy(1-{x}^{2}{y}^{2}){e}^{{x}^{2}{y}^{2}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65060" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4xy(1+{x}^{2}{y}^{2}){e}^{{x}^{2}{y}^{2}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132800" "field" nil "attribute" "question/problem" "value" "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=\\frac{{e}^{y}}{x+y}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132800" "field" nil "attribute" "question/worked-solution" "value" "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{{e}^{y}}{x+y}) \\\\  & ={e}^{y}\\cdot (-\\frac{1}{(x+y)^{2}}) \\\\  & =-\\frac{{e}^{y}}{(x+y)^{2}}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132800" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-132800" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132800" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{{e}^{x}}{(x+y)^{2}}"] ["math" "-\\frac{{e}^{y}}{(x+y)^{2}}"] ["math" "-\\frac{{e}^{y}}{(x-y)^{2}}"] ["math" "\\frac{{e}^{y}(x+y-1)}{(x+y)^{2}}"] ["math" "\\frac{{e}^{y}}{(x+y)^{2}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132800" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{{e}^{y}}{(x+y)^{2}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132764" "field" nil "attribute" "question/problem" "value" "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂x∂y}$ given that $\\frac{∂f}{∂y}=-\\frac{2{x}^{2}+y}{{y}^{3}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132764" "field" nil "attribute" "question/worked-solution" "value" "To find $\\frac{{∂}^{2}f}{∂x∂y}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂y}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(-\\frac{2{x}^{2}+y}{{y}^{3}}) \\\\  & =-\\frac{1}{{y}^{3}}\\cdot \\frac{∂}{∂x}(2{x}^{2}+y) \\\\  & =-\\frac{1}{{y}^{3}}(4x) \\\\  & =-\\frac{4x}{{y}^{3}}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132764" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-132764" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132764" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{2x}{{y}^{2}}"] ["math" "-\\frac{2x}{{y}^{3}}"] ["math" "-\\frac{4x}{{y}^{3}}"] ["math" "\\frac{4x}{{y}^{3}}"] ["math" "\\frac{4x}{{y}^{4}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132764" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{4x}{{y}^{3}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65058" "field" nil "attribute" "question/problem" "value" "For the function $f(x,y),$ calculate $\\frac{{∂}^{2}f}{∂{x}^{2}}$ given that $\\frac{∂f}{∂x}=2x\\operatorname{cos}⁡({x}^{2}+{y}^{2}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65058" "field" nil "attribute" "question/worked-solution" "value" "To find $\\frac{{∂}^{2}f}{∂{x}^{2}}$ we differentiate the given first-order partial derivative $\\frac{∂f}{∂x}$ with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\frac{∂f}{∂x}) \\\\  & =\\frac{∂}{∂x}(2x\\operatorname{cos}⁡({x}^{2}+{y}^{2})) \\\\  & =2\\cdot \\operatorname{cos}⁡({x}^{2}+{y}^{2})+2x\\cdot (-\\operatorname{sin}⁡({x}^{2}+{y}^{2}))\\cdot 2x \\\\  & =2\\operatorname{cos}⁡({x}^{2}+{y}^{2})-4{x}^{2}\\operatorname{sin}⁡({x}^{2}+{y}^{2})\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65058" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-65058" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65058" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{cos}⁡({x}^{2}+{y}^{2})+{x}^{2}\\operatorname{sin}⁡({x}^{2}+{y}^{2})"] ["math" "2\\operatorname{cos}⁡({x}^{2}+{y}^{2})-4{x}^{2}\\operatorname{sin}⁡({x}^{2}+{y}^{2})"] ["math" "2\\operatorname{sin}⁡({x}^{2}+{y}^{2})+8{x}^{2}\\operatorname{sin}⁡({x}^{2}+{y}^{2})"] ["math" "2\\operatorname{sin}⁡({x}^{2}+{y}^{2})-4{x}^{2}\\operatorname{cos}⁡({x}^{2}+{y}^{2})"] ["math" "\\operatorname{cos}⁡({x}^{2}+{y}^{2})-8x\\operatorname{sin}⁡({x}^{2}+{y}^{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65058" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{cos}⁡({x}^{2}+{y}^{2})-4{x}^{2}\\operatorname{sin}⁡({x}^{2}+{y}^{2})"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132875" "field" nil "attribute" "question/problem" "value" "Find ${f}_{xx}(x,y)+{f}_{yy}(x,y)$ given that  ${f}_{x}(x,y)=x\\sqrt{{x}^{2}+{y}^{2}}$ and ${f}_{y}(x,y)=y\\sqrt{{x}^{2}+{y}^{2}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132875" "field" nil "attribute" "question/worked-solution" "value" "To find ${f}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =\\frac{∂}{∂x}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\sqrt{{x}^{2}+{y}^{2}}) \\\\  & =\\sqrt{{x}^{2}+{y}^{2}}+\\frac{{x}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =\\frac{{x}^{2}+{y}^{2}+{x}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =\\frac{2{x}^{2}+{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}\\end{aligned}\n$$\n\nTo find ${f}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{yy}(x,y) & =\\frac{∂}{∂y}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(y\\sqrt{{x}^{2}+{y}^{2}}) \\\\  & =\\sqrt{{x}^{2}+{y}^{2}}+\\frac{{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =\\frac{{x}^{2}+{y}^{2}+{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =\\frac{{x}^{2}+2{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xx}(x,y)+{f}_{yy}(x,y) & =\\frac{2{x}^{2}+{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}}+\\frac{{x}^{2}+2{y}^{2}}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =\\frac{3({x}^{2}+{y}^{2})}{\\sqrt{{x}^{2}+{y}^{2}}} \\\\  & =3\\sqrt{{x}^{2}+{y}^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132875" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-132875" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132875" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3({x}^{2}+{y}^{2})"] ["math" "3\\sqrt{{x}^{2}+{y}^{2}}"] ["math" "\\frac{2x+y}{\\sqrt{{x}^{2}+{y}^{2}}}"] ["math" "\\frac{2xy}{\\sqrt{({x}^{2}+{y}^{2})^{3}}}"] ["math" "\\frac{2xy}{\\sqrt{{x}^{2}+{y}^{2}}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132875" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\sqrt{{x}^{2}+{y}^{2}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80456" "field" nil "attribute" "question/problem" "value" "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=\\frac{2x}{{x}^{2}+y}$ and ${f}_{y}(x,y)=\\frac{1}{{x}^{2}+y}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80456" "field" nil "attribute" "question/worked-solution" "value" "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{2x}{{x}^{2}+y}) \\\\  & =2x\\cdot \\frac{∂}{∂y}(\\frac{1}{{x}^{2}+y}) \\\\  & =2x\\cdot (-\\frac{1}{({x}^{2}+y)^{2}}) \\\\  & =-\\frac{2x}{({x}^{2}+y)^{2}}\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{1}{{x}^{2}+y}) \\\\  & =(-\\frac{1}{({x}^{2}+y)^{2}})\\cdot 2x \\\\  & =-\\frac{2x}{({x}^{2}+y)^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =-\\frac{2x}{({x}^{2}+y)^{2}}-\\frac{2x}{({x}^{2}+y)^{2}} \\\\  & =-\\frac{4x}{({x}^{2}+y)^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80456" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-80456" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80456" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{4x}{({x}^{2}+y)^{2}}"] ["math" "-\\frac{4}{({x}^{2}+y)^{2}}"] ["math" "0"] ["math" "\\frac{2x+1}{({x}^{2}+y)^{2}}"] ["math" "\\frac{4x}{{x}^{2}+y}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80456" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{4x}{({x}^{2}+y)^{2}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80468" "field" nil "attribute" "question/problem" "value" "Find ${f}_{xy}(x,y)+{f}_{yx}(x,y)$ given that  ${f}_{x}(x,y)=x\\operatorname{cos}⁡({x}^{2}-{y}^{2})$ and ${f}_{y}(x,y)=-y\\operatorname{cos}⁡({x}^{2}-{y}^{2}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80468" "field" nil "attribute" "question/worked-solution" "value" "To find ${f}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${f}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡({x}^{2}-{y}^{2})) \\\\  & =x\\cdot (-\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\cdot (-2y)) \\\\  & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\end{aligned}\n$$\n\nTo find ${f}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(-y\\operatorname{cos}⁡({x}^{2}-{y}^{2})) \\\\  & =-y(-\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\cdot 2x) \\\\  & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})+2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2}) \\\\  & =4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2}).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80468" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-80468" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80468" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})"] ["math" "2({x}^{2}+{y}^{2})\\operatorname{sin}⁡({x}^{2}-{y}^{2})"] ["math" "2({x}^{2}y+x{y}^{2})\\operatorname{sin}⁡({x}^{2}-{y}^{2})"] ["math" "4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})"] ["math" "4{x}^{2}{y}^{2}\\operatorname{sin}⁡({x}^{2}-{y}^{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-80468" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4xy\\operatorname{sin}⁡({x}^{2}-{y}^{2})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132897" "field" nil "attribute" "question/problem" "value" "Find ${g}_{xy}(x,y)+{g}_{yx}(x,y)$ at $(-1,2)$ given that ${g}_{x}(x,y)=\\frac{1}{x+2y}$ and ${g}_{y}(x,y)=\\frac{2}{x+2y}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132897" "field" nil "attribute" "question/worked-solution" "value" "To find ${g}_{xy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y) & =\\frac{∂}{∂y}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(\\frac{1}{x+2y}) \\\\  & =-\\frac{2}{(x+2y)^{2}}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{yx}(x,y) & =\\frac{∂}{∂x}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{2}{x+2y}) \\\\  & =-\\frac{2}{(x+2y)^{2}}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xy}(x,y)$ and ${g}_{yx}(x,y)$ at $(-1,2):$\n\n$$\n\\begin{aligned}{g}_{xy}(-1,2) & =-\\frac{2}{((-1)+2(2))^{2}}=-\\frac{2}{9} \\\\ {g}_{yx}(-1,2) & =-\\frac{2}{((-1)+2(2))^{2}}=-\\frac{2}{9}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xy}(-1,2)+{g}_{yx}(-1,2)=-\\frac{4}{9}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132897" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-132897" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132897" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\frac{1}{9}"] ["math" "-\\frac{2}{9}"] ["math" "-\\frac{4}{9}"] ["math" "9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132897" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{4}{9}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132891" "field" nil "attribute" "question/problem" "value" "Find ${g}_{xx}(x,y)\\cdot {g}_{yy}(x,y)$ at $(0,1)$ given that ${g}_{x}(x,y)=2{e}^{2x-y}$ and ${g}_{y}(x,y)=-{e}^{2x-y}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132891" "field" nil "attribute" "question/worked-solution" "value" "To find ${g}_{xx}(x,y)$ we differentiate the given first-order partial derivative ${g}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{g}_{xx}(x,y) & =\\frac{∂}{∂x}({g}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(2{e}^{2x-y}) \\\\  & =4{e}^{2x-y}\\end{aligned}\n$$\n\n \n\nTo find ${g}_{yy}(x,y)$ we differentiate the given first-order partial derivative ${g}_{y}(x,y)$ with respect to $y:$\n\n$$\n\\begin{aligned}{g}_{yy}(x,y) & =\\frac{∂}{∂y}({g}_{y}(x,y)) \\\\  & =\\frac{∂}{∂y}(-{e}^{2x-y}) \\\\  & ={e}^{2x-y}\\end{aligned}\n$$\n\n \n\nNext, we evaluate ${g}_{xx}(x,y)$ and ${g}_{yy}(x,y)$ at $(0,1):$\n\n$$\n\\begin{aligned}{g}_{xx}(0,1) & =4{e}^{2(0)-1}=4{e}^{-1} \\\\ {g}_{yy}(0,1) & ={e}^{2(0)-1}={e}^{-1}\\end{aligned}\n$$\n\nFinally, we have\n\n$$\n{g}_{xx}(0,1)\\cdot {g}_{yy}(0,1)=4{e}^{-1}\\cdot {e}^{-1}=4{e}^{-2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132891" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-132891" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132891" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2{e}^{-2}"] ["math" "-{e}^{-3}"] ["math" "2({e}^{-1}-{e}^{-2})"] ["math" "2{e}^{-1}"] ["math" "4{e}^{-2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132891" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4{e}^{-2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65068" "field" nil "attribute" "question/problem" "value" "Calculate ${f}_{xxy}(x,y)$ given that $f(x,y)={e}^{xy}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65068" "field" nil "attribute" "question/worked-solution" "value" "First, we find the first-order derivative ${f}_{x}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({e}^{xy}) \\\\  & =y{e}^{xy}\\end{aligned}\n$$\n\nNext, we find ${f}_{xx}(x,y)$ by differentiating ${f}_{x}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y) & =\\frac{∂}{∂x}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂x}(y{e}^{xy}) \\\\  & =y(y{e}^{xy}) \\\\  & ={y}^{2}{e}^{xy}\\end{aligned}\n$$\n\nFinally, we find ${f}_{xxy}(x,y)$ by differentiating ${f}_{xx}(x,y)$ with respect to $y:$ \n\n$$\n\\begin{aligned}{f}_{xxy}(x,y) & =\\frac{∂}{∂y}({f}_{xx}(x,y)) \\\\  & =\\frac{∂}{∂y}({y}^{2}{e}^{xy}) \\\\  & =2y\\cdot {e}^{xy}+{y}^{2}\\cdot {e}^{xy}\\cdot x \\\\  & =y(2+xy){e}^{xy}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65068" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-65068" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65068" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(1+xy){e}^{xy}"] ["math" "(2-xy){e}^{xy}"] ["math" "2(1+xy){e}^{xy}"] ["math" "x(2-xy){e}^{xy}"] ["math" "y(2+xy){e}^{xy}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65068" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y(2+xy){e}^{xy}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-36019" "field" nil "attribute" "question/problem" "value" "Evaluate ${f}_{xyz}(1,1,1)$ for $f(x,y,z)=\\frac{yz}{x-2z}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-36019" "field" nil "attribute" "question/worked-solution" "value" "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\frac{yz}{x-2z}) \\\\  & =-\\frac{yz}{(x-2z)^{2}}\\end{aligned}\n$$\n\nNow, we find ${f}_{xy}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y,z) & =\\frac{∂}{∂y}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(-\\frac{yz}{(x-2z)^{2}}) \\\\  & =-\\frac{z}{(x-2z)^{2}}\\end{aligned}\n$$\n\nNext, we find ${f}_{xyz}(x,y,z)$ by differentiating ${f}_{xy}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xy}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(-\\frac{z}{(x-2z)^{2}}) \\\\  & =-\\frac{1\\cdot (x-2z)^{2}-z\\cdot 2(x-2z)\\cdot (-2)}{(x-2z)^{4}} \\\\  & =-\\frac{(x-2z)^{2}+4z(x-2z)}{(x-2z)^{4}} \\\\  & =-\\frac{x-2z+4z}{(x-2z)^{3}} \\\\  & =-\\frac{x+2z}{(x-2z)^{3}}\\end{aligned}\n$$\n\nFinally, we evaluate ${f}_{xyz}(x,y,z)$ at $(1,1,1):$\n\n$$\n\\begin{aligned}{f}_{xyz}(1,1,1) & =-\\frac{1+2\\cdot 1}{(1-2\\cdot 1)^{3}}=3\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-36019" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-36019" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-36019" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\frac{1}{3}"] ["math" "0"] ["math" "1"] ["math" "3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-36019" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132940" "field" nil "attribute" "question/problem" "value" "Evaluate ${f}_{xyz}(-5,2,3)$ for $f(x,y,z)={x}^{2}\\operatorname{ln}⁡(y+z).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132940" "field" nil "attribute" "question/worked-solution" "value" "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}\\operatorname{ln}⁡(y+z)) \\\\  & =2x\\operatorname{ln}⁡(y+z)\\end{aligned}\n$$\n\nNow, we find ${f}_{xy}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $y:$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y,z) & =\\frac{∂}{∂y}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂y}(2x\\operatorname{ln}⁡(y+z)) \\\\  & =2x\\cdot \\frac{1}{y+z} \\\\  & =\\frac{2x}{y+z}\\end{aligned}\n$$\n\nNext, we find ${f}_{xyz}(x,y,z)$ by differentiating ${f}_{xy}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xyz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xy}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(\\frac{2x}{y+z}) \\\\  & =2x\\cdot \\frac{∂}{∂z}(\\frac{1}{y+z}) \\\\  & =2x\\cdot (-\\frac{1}{(y+z)^{2}}) \\\\  & =-\\frac{2x}{(y+z)^{2}}\\end{aligned}\n$$\n\nFinally, we evaluate ${f}_{xyz}(x,y,z)$ at $(-5,2,3):$\n\n$$\n\\begin{aligned}{f}_{xyz}(-5,2,3) & =-\\frac{2(-5)}{(2+3)^{2}}=\\frac{2}{5}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132940" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-132940" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132940" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{2}{25}"] ["math" "-\\frac{2}{5}"] ["math" "\\frac{1}{5}"] ["math" "\\frac{2}{25}"] ["math" "\\frac{2}{5}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132940" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{5}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132961" "field" nil "attribute" "question/problem" "value" "Evaluate ${f}_{xxz}(1,\\frac{1}{2},\\pi )$ for $f(x,y,z)=\\operatorname{sin}⁡(xyz).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132961" "field" nil "attribute" "question/worked-solution" "value" "First, we find the first-order derivative ${f}_{x}(x,y,z):$\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{sin}⁡xyz) \\\\  & =\\operatorname{cos}⁡(xyz)\\cdot yz \\\\  & =yz\\operatorname{cos}⁡(xyz)\\end{aligned}\n$$\n\nNow, we find ${f}_{xx}(x,y,z)$ by differentiating ${f}_{x}(x,y,z)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{xx}(x,y,z) & =\\frac{∂}{∂x}({f}_{x}(x,y,z)) \\\\  & =\\frac{∂}{∂x}(yz\\operatorname{cos}⁡(xyz)) \\\\  & =yz\\cdot (-yz\\operatorname{sin}⁡(xyz)) \\\\  & =-{y}^{2}{z}^{2}\\operatorname{sin}⁡(xyz)\\end{aligned}\n$$\n\nNext, we find ${f}_{xxz}(x,y,z)$ by differentiating ${f}_{xx}(x,y,z)$ with respect to $z:$ \n\n$$\n\\begin{aligned}{f}_{xxz}(x,y,z) & =\\frac{∂}{∂z}({f}_{xx}(x,y,z)) \\\\  & =\\frac{∂}{∂z}(-{y}^{2}{z}^{2}\\operatorname{sin}⁡(xyz)) \\\\  & =-{y}^{2}\\frac{∂}{∂z}({z}^{2}\\operatorname{sin}⁡(xyz)) \\\\  & =-{y}^{2}\\cdot (2z\\operatorname{sin}⁡(xyz)+xy{z}^{2}\\operatorname{cos}⁡(xyz)) \\\\  & =-{y}^{2}z(2\\operatorname{sin}⁡(xyz)+xyz\\operatorname{cos}⁡(xyz))\\end{aligned}\n$$\n\n \n\nFinally, we evaluate ${f}_{xxz}(x,y,z)$ at $(1,\\frac{1}{2},\\pi ):$\n\n$$\n\\begin{aligned}{f}_{xxz}(1,\\frac{1}{2},\\pi ) & =-{(\\frac{1}{2})}^{2}\\cdot \\pi \\cdot (2\\operatorname{sin}⁡(1\\cdot \\frac{1}{2}\\cdot \\pi )+1\\cdot \\frac{1}{2}\\cdot \\pi \\cdot \\operatorname{cos}⁡(1\\cdot \\frac{1}{2}\\cdot \\pi )) \\\\  & =-\\frac{\\pi }{4}(2\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{2}\\operatorname{cos}⁡(\\frac{\\pi }{2})) \\\\  & =-\\frac{\\pi }{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132961" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-132961" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132961" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2\\pi "] ["math" "-\\frac{\\pi }{2}"] ["math" "-\\frac{\\pi }{4}"] ["math" "\\frac{\\pi }{2}"] ["math" "\\frac{\\pi }{4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-132961" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{\\pi }{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65071" "field" nil "attribute" "question/problem" "value" "Calculate ${f}_{yxx}(x,y)$ given that $f(x,y)={y}^{2}\\operatorname{ln}⁡({x}^{2}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65071" "field" nil "attribute" "question/worked-solution" "value" "First, we find the first-order derivative ${f}_{y}(x,y):$ \n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}({y}^{2}\\operatorname{ln}⁡({x}^{2})) \\\\  & =\\operatorname{ln}⁡({x}^{2})\\frac{∂}{∂y}({y}^{2}) \\\\  & =2y\\operatorname{ln}⁡({x}^{2})\\end{aligned}\n$$\n\nNext, we find ${f}_{yx}(x,y)$ by differentiating ${f}_{y}(x,y)$ with respect to $x:$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(2y\\operatorname{ln}⁡({x}^{2})) \\\\  & =2y\\cdot \\frac{2x}{{x}^{2}} \\\\  & =\\frac{4y}{x}\\end{aligned}\n$$\n\nFinally, we find ${f}_{yxx}(x,y)$ by differentiating ${f}_{yx}(x,y)$ with respect to $x:$ \n\n$$\n\\begin{aligned}{f}_{yxx}(x,y) & =\\frac{∂}{∂x}({f}_{yx}(x,y)) \\\\  & =\\frac{∂}{∂x}(\\frac{4y}{x}) \\\\  & =\\frac{0\\cdot x-4y\\cdot 1}{{x}^{2}} \\\\  & =-\\frac{4y}{{x}^{2}}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65071" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/activity-metadata.json" "file_sha256" "d47d6331b62b30213ae5ab9c9023e7287a004897bc643e2e48e45a8227b504cf"} {"question" "q-65071" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65071" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{4+y}{x}"] ["math" "-\\frac{4y}{{x}^{2}}"] ["math" "\\frac{2y}{x}"] ["math" "\\frac{y}{4x}"] ["math" "\\frac{y}{{x}^{2}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "q-65071" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{4y}{{x}^{2}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/state.json" "file_sha256" "ae75f884af0d53a49469c08c5a707fd7d42d7edc42e8ef3e94a8849586691bcc"} {"question" "e-3127" "field" nil "attribute" "question/problem" "value" "Find $\\dfrac {\\partial^2 f }{\\partial x\\partial y}$ given that $\\dfrac {\\partial f}{\\partial y} =  \\dfrac {2y} {x + y^2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/example-3127.json" "file_sha256" "bad73fec91eb5f071d9f6ae08d8a1ba989d78c3447d1ce1c6a7e15d9899a6cac"} {"question" "e-3127" "field" nil "attribute" "question/worked-solution" "value" "To find $\\dfrac {\\partial^2 f }{\\partial x\\partial y},$ we differentiate the given first-order partial derivative $\\dfrac {\\partial f}{\\partial y}$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\  & =\\frac{∂}{∂x}(\\frac{2y}{x+{y}^{2}}) \\\\  & =2y\\cdot \\frac{∂}{∂x}({(x+{y}^{2})}^{-1}) \\\\  & =-2y(x+{y}^{2})^{-2}\\cdot 1 \\\\  & =-\\frac{2y}{{(x+{y}^{2})}^{2}}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/example-3127.json" "file_sha256" "bad73fec91eb5f071d9f6ae08d8a1ba989d78c3447d1ce1c6a7e15d9899a6cac"} {"question" "e-3129" "field" nil "attribute" "question/problem" "value" "Find $f_{xy}(x,y)+f_{yx}(x,y)$ given that  $f_x(x,y)=y\\cos(xy)$ and $f_y(x,y)=x\\cos(xy).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/example-3129.json" "file_sha256" "4a7f52ebf1a72d045ed6188de3e056212d29ae5a404e5140e459d9af5e3ec844"} {"question" "e-3129" "field" nil "attribute" "question/worked-solution" "value" "To find $f_{xy}(x,y),$ we differentiate the given first-order partial derivative $f_{x}(x,y)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{xy}(x,y) & =\\frac{∂}{∂y}({f}_{x}(x,y)) \\\\  & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+y(-\\operatorname{sin}⁡(xy)\\cdot x) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\n \n\nSimilarly, to find $f_{yx}(x,y),$ we differentiate the given first-order partial derivative $f_{y}(x,y)$ with respect to $x\\mathbin{:}$\n\n$$\n\\begin{aligned}{f}_{yx}(x,y) & =\\frac{∂}{∂x}({f}_{y}(x,y)) \\\\  & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡(xy)) \\\\  & =1\\cdot \\operatorname{cos}⁡(xy)+x(-\\operatorname{sin}⁡(xy)\\cdot y) \\\\  & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}{f}_{xy}(x,y)+{f}_{yx}(x,y) & =\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)+\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\  & =2(\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/example-3129.json" "file_sha256" "4a7f52ebf1a72d045ed6188de3e056212d29ae5a404e5140e459d9af5e3ec844"} {"question" "e-3130" "field" nil "attribute" "question/problem" "value" "Evaluate $g_{xyz}(x,y,z)$ at $(1,2,3)$ if $g_x(x,y,z) = 2x y z +  y^3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/example-3130.json" "file_sha256" "8b2304c35fc8558d3c9c75c0bf6cf0186e2c2a99ebb2ef6502a95424f1e5d241"} {"question" "e-3130" "field" nil "attribute" "question/worked-solution" "value" "First, we find $g_{xy}(x,y,z)$ by differentiating $g_{x}(x,y,z)$ with respect to $y\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xy}(x,y,z) & =\\frac{∂}{∂y}(2xyz+{y}^{3}) \\\\  & =2xz+3{y}^{2}\\end{aligned}\n$$\n\nNext, we find $g_{xyz}(x,y,z)$ by differentiating $g_{xy}(x,y,z)$ with respect to $z\\mathbin{:}$\n\n$$\n\\begin{aligned}{g}_{xyz}(x,y,z) & =\\frac{∂}{∂z}(2xz+3{y}^{2}) \\\\  & =2x\\end{aligned}\n$$\n\nFinally, we obtain \n\n$$\n\\begin{aligned}{g}_{xyz}(1,2,3) & =2(1) \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043864/example-3130.json" "file_sha256" "8b2304c35fc8558d3c9c75c0bf6cf0186e2c2a99ebb2ef6502a95424f1e5d241"}] "usage" {"e-3129" [] "q-36019" [] "e-3130" [] "e-3127" []} "basis" 1634 "retractions" [[17592186124864 :question/problem "Evaluate $f_{xyz}(1, 1, 1)$ for $f(x, y, z) = \\frac{yz}{x - 2z}$."] [17592186124159 :question/problem "Find $\\dfrac {\\partial^2 f}{\\partial x\\partial y}$ given that $\\dfrac {\\partial f}{\\partial y} = \\dfrac {2y} {x + y^2}$."] [17592186124159 :question/worked-solution "To find\n\n$$\n\\dfrac {\\partial^2 f}{\\partial x\\partial y}\n$$\n\nwe differentiate the given first-order partial derivative\n\n$$\n\\dfrac {\\partial f}{\\partial y}\n$$\n\nwith respect to $x$:\n\n$$\n\\begin{aligned}\n\\frac{∂^{2}f}{∂x∂y} &= \\frac{∂}{∂x}(\\frac{∂f}{∂y}) \\\\\n&= \\frac{∂}{∂x}(\\frac{2y}{x + y^{2}}) \\\\\n&= 2y \\cdot \\frac{∂}{∂x}((x + y^{2})^{-1}) \\\\\n&=-2y(x + y^{2})^{-2} \\cdot 1 \\\\\n&= - (2y)/((x + y^{2})^{2})\n\\end{aligned}\n$$"] [17592186124160 :question/problem "Find $f_{xy}(x,y)+f_{yx}(x,y)$ given that $f_x(x,y)=y\\cos(xy)$ and $f_y(x,y)=x\\cos(xy)$."] [17592186124160 :question/worked-solution "To find $f_{xy}(x,y)$, we differentiate the given first-order partial derivative $f_{x}(x,y)$ with respect to $y$:\n\n$$\n\\begin{aligned}\nf_{xy}(x, y) &= \\frac{∂}{∂y}(f_{x}(x, y)) \\\\\n&= \\frac{∂}{∂y}(y\\cos (xy)) \\\\\n&= 1 \\cdot \\cos (xy) + y(-\\sin (xy) \\cdot x) \\\\\n&= \\cos (xy) - xy\\sin (xy)\n\\end{aligned}\n$$\n\nSimilarly, to find $f_{yx}(x,y)$, we differentiate the given first-order partial derivative $f_{y}(x,y)$ with respect to $x$:\n\n$$\n\\begin{aligned}\nf_{yx}(x, y) &= \\frac{∂}{∂x}(f_{y}(x, y)) \\\\\n&= \\frac{∂}{∂x}(x\\cos (xy)) \\\\\n&= 1 \\cdot \\cos (xy) + x(-\\sin (xy) \\cdot y) \\\\\n&= \\cos (xy) - xy\\sin (xy)\n\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\nf_{xy}(x, y) + f_{yx}(x, y) &= \\cos (xy) - xy\\sin (xy) + \\cos (xy) - xy\\sin (xy) \\\\\n&= 2(\\cos (xy) - xy\\sin (xy))\n\\end{aligned}\n$$"] [17592186124161 :question/problem "Evaluate $g_{xyz}(x,y,z)$ at $(1,2,3)$ if $g_x(x,y,z) = 2x y z + y^3$."] [17592186124161 :question/worked-solution "First, we find $g_{xy}(x,y,z)$ by differentiating $g_{x}(x,y,z)$ with respect to $y$:\n\n$$\n\\begin{aligned}\ng_{xy}(x, y, z) &= \\frac{∂}{∂y}(2xyz + y^{3}) \\\\\n&= 2xz + 3y^{2}\n\\end{aligned}\n$$\n\nNext, we find $f_{xyz}(x,y,z)$ by differentiating $f_{xy}(x,y,z)$ with respect to $z$:\n\n$$\n\\begin{aligned}\ng_{xyz}(x, y, z) &= \\frac{∂}{∂z}(2xz + 3y^{2}) \\\\\n&= 2x\n\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}\ng_{xyz}(1, 2, 3) &= 2(1) \\\\\n&= 2\n\\end{aligned}\n$$"]] "immutable_answers" [17592186122207 17592186122208 17592186122209 17592186122210 17592186122211] "immutable_fields" [[17592186122206 :answer-field/correct] [17592186122206 :answer-field/id] [17592186122206 :answer-field/key] [1