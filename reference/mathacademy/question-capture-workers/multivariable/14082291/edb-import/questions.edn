#{[{:db/id #edb/ref 17592186124872 :knowledge-point/_questions [{:knowledge-point/id #uuid "cc017b0d-6418-570a-9a5d-57572e4fe70a" :knowledge-point/title "Evaluating the Derivative at a Point Using the Chain Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da1c5d4e-b495-5071-a38e-eb0a0b6b4a3d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186122255} {:answer/id #uuid "e35c0d1b-8d76-56c8-bc9f-05a9ea0766eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186122256} {:answer/id #uuid "35c28916-89d0-57d1-94f5-ff29dbd00862" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186122257} {:answer/id #uuid "36ff272b-0c38-5d74-9a75-f15d64c7f980" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186122258} {:answer/id #uuid "40123f3b-09d3-560e-81ef-74fa8b78185c" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186122259}] :answer-field/correct {:answer/id #uuid "35c28916-89d0-57d1-94f5-ff29dbd00862" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186122257} :answer-field/id #uuid "d747335a-d6e5-5823-901b-cd8c67c0ab13" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122254}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ceb16fee-64a8-51ee-a3b7-7009e970259a" :question/math-academy-id "q-36215" :question/problem "Evaluate $\\frac{\\text{d}}{\\text{d} t} [ f ( \\mathbf{r} ( t ) ) ]$ at $t = 1$ given that\n\n$\\mathrm{\\nabla } f ( x , y ) = \\frac{2 x}{{x}^{2} + 3 y} \\, \\mathbf{i} + \\frac{3}{{x}^{2} + 3 y} \\, \\mathbf{j}$\nand\n$\\mathbf{r} ( t ) = t \\, \\mathbf{i} + {t}^{2} \\, \\mathbf{j} .$." :question/requires-calculator false :question/worked-solution "At $t=1$, $\\mathbf r(1)=(1,1)$, so $\\nabla f(\\mathbf r(1))=\\langle2/4,3/4\\rangle$. Also $\\mathbf r'(t)=\\langle1,2t\\rangle$. The chain rule gives $$\\left.\\frac{d}{dt}f(\\mathbf r(t))\\right|_{t=1}=\\left\\langle\\frac12,\\frac34\\right\\rangle\\cdot\\langle1,2\\rangle=\\frac12+\\frac32=2.$$"}]}
