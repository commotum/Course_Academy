\operatorname{sin}⁡ϕ,\\,\\sqrt{3}\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\sqrt{3}\\operatorname{cos}⁡ϕ⟩\\end{aligned}\n$$\n\nwhere $\\theta \\in [0,2\\pi )$ and $ϕ\\in [-\\pi ,\\pi ].$\n\nTherefore, the first component of $f$ is $\\sqrt{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105638/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f1e45977-275f-51ef-b8b5-f7a47c770ca5"] :knowledge-point/questions ["q-105638"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105617/selection/69970300f7f1b2539764006f13b4e49afa2b273bfe07e50f9bb1b169d0a7f5ed" :answer/id #uuid "f0eb6076-5cdd-5195-aa0e-abda749a07d3" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-105617/selection/39718491563c6ad1485406ec157534d84b2a49132f2b507f15225564ca92aea6" :answer/id #uuid "ed031848-9011-5f6f-b9f4-9c1c4a725336" :answer/type :answer.type/math :answer/value "5\\operatorname{sin}⁡\\theta " :db/ensure [:answer/validate]} {:db/id "q-105617/selection/66f462fa5419ce1751888d2d25abc6d51eb4ba459a17b99f17cc32fe469ed61e" :answer/id #uuid "b6a0c8d3-4264-5842-b8cd-30441d13205d" :answer/type :answer.type/math :answer/value "5\\operatorname{cos}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-105617/selection/f4e382b83fdbba37ccb849d16de742459710e8fe5b86257f10227ed071fa56d6" :answer/id #uuid "2c88d89b-7ab8-5330-b770-0b23c54ba357" :answer/type :answer.type/math :answer/value "5\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-105617/selection/3cd3121caade06c16ab916bd5a8a377cd991ffb902cd7aebd9c624dbad713823" :answer/id #uuid "8749cbc7-8c9d-5205-9b5a-150ad2307b7c" :answer/type :answer.type/math :answer/value "25\\operatorname{sin}⁡ϕ" :db/ensure [:answer/validate]} {:db/id "q-105617/selection" :answer-field/id #uuid "9d94636c-625f-5994-b3c1-f8818ab6f729" :a