[{:db/id "q-135283/selection/e06b99529dfb0e4fee54d17109c1a719af0e8c55f97bd99b279589d73ed260fb" :answer/id #uuid "ad6bae9d-a86b-5249-ad8e-657ac2768522" :answer/type :answer.type/math :answer/value "ϕ=\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-135283/selection/5e6e777b8eed37422f55cc31675d7165f29ad5a25d700e65d79d5c50fead8ac3" :answer/id #uuid "a25c809e-c457-5049-ba8c-b210b2c042a7" :answer/type :answer.type/math :answer/value "\\rho =\\frac{\\theta }{4}" :db/ensure [:answer/validate]} {:db/id "q-135283/selection/682af8c48896b4fdf3fff4f944e5dc4208c780dce0d5b9405d3e4cfeebec069e" :answer/id #uuid "a99f4f2d-73a1-5f99-b324-42b153dd2126" :answer/type :answer.type/math :answer/value "\\theta =\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-135283/selection/c7151c814288f3231112c86ec59e1268e1078d4c44fa325366660c10ea3128ab" :answer/id #uuid "459ffdfb-6368-5701-b7d1-11a1a75bb4e4" :answer/type :answer.type/math :answer/value "ϕ=\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-135283/selection/0f1e631bff516d8c63a751d008742cdc8cb019576c935379059dfea901a73764" :answer/id #uuid "8ff72d1b-b153-5849-9fa0-9f9e4f7e3513" :answer/type :answer.type/math :answer/value "\\theta =\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-135283/selection" :answer-field/id #uuid "12972fdb-d6a6-515e-870f-45235973639b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-135283/selection/e06b99529dfb0e4fee54d17109c1a719af0e8c55f97bd99b279589d73ed260fb" :answer-field/choices ["q-135283/selection/e06b99529dfb0e4fee54d17109c1a719af0e8c55f97bd99b279589d73ed260fb" "q-135283/selection/5e6e777b8eed37422f55cc31675d7165f29ad5a25d700e65d79d5c50fead8ac3" "q-135283/selection/682af8c48896b4fdf3fff4f944e5dc4208c780dce0d5b9405d3e4cfeebec069e" "q-135283/selection/c7151c814288f3231112c86ec59e1268e1078d4c44fa325366660c10ea3128ab" "q-135283/selection/0f1e631bff516d8c63a751d008742cdc8cb019576c935379059dfea901a73764"] :db/ensure [:answer-field/validate]} {:db/id "q-135283" :question/id #uuid "e9d70e19-4ec6-510a-946b-fdc58cad22e9" :question/math-academy-id "q-135283" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038412/assets/68dc8c639235c6dbc2fe9a238a3855327a0c7da337e5792b7896c30e19b2714e.png)\n\nWhat is the equation of the surface shown above in spherical polar coordinates?" :question/worked-solution "In the picture, we are given a half-cone with the $z$-axis as its axis.\n\nWe write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nEvery point on the given half-cone makes an angle of $\\frac{\\pi }{4}$ radians with the positive $z$-axis. On the other hand, $\\rho $ and $\\theta $ can vary arbitrarily in their respective domains. \n\nTherefore, the spherical polar equation of the surface is $ϕ=\\frac{\\pi }{4}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-135283/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "133f6b90-4074-5860-9b89-16b59c5613bf"] :knowledge-point/questions ["q-135283"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-102949"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038412/assets/e542606b09d564f450aa9c2f4e2de5bf8dc197644a094c37420ee1b881f14e1f.png)\n\nWhat is the equation of the surface shown above in spherical polar coordinates?" :question/worked-solution "In the picture, we are given a sphere of radius $2$ centered at the origin.\n\nWe write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nThe distance from any point to the origin on the given surface equals $2.$ On the other hand, $\\theta $ and $ϕ$ vary arbitrarily in their respective domains. \n\nTherefore, the spherical polar equation of the surface is $\\rho =2.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-135246/selection/1a2113340cbccbf03ef6f2820dbf0d593712808904575d8d588bd5a0f80d8951" :answer/id #uuid "cbea4182-f6a8-5d15-8353-409959ed3837" :answer/type :answer.type/math :answer/value "ϕ=\\frac{5\\pi }{6}\\theta " :db/ensure [:answer/validate]} {:db/id "q-135246/selection/2b522bb40e7eda5ca92aa8f9ec414d7b1dbfc3b1a769005070849be8e2e2b274" :answer/id #uuid "3fc764d0-8e18-5274-bc0d-7d4c8fd54cd1" :answer/type :answer.type/math :answer/value "ϕ=\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-135246/selection/7e2b48383d5d1cc80a4b40001f958af2e676fec2cb1400c3d40af53d8105a997" :answer/id #uuid "ab9cf9a3-5496-5e59-8a2a-e6a851557bb9" :answer/type :answer.type/math :answer/value "\\theta =\\frac{5\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-135246/selection/7d6a9e926adb7325d8a9ca1b402a6d19db0b8e2b59c1f1080d875510213f6120" :answer/id #uuid "443f1e23-6dc9-584f-81e9-6b18f7b59656" :answer/type :answer.type/math :answer/value "\\theta =\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-135246/selection/08731fda7566c2c8b949b7d8cb72b0af69d71ee2776f5eae62dbae9444f1ef34" :answer/id #uuid "7963f00b-1548-56cd-9b47-e08247a52cf8" :answer/type :answer.type/math :answer/value "ϕ=\\frac{5\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-135246/selection" :answer-field/id #uuid "dd2dff53-5112-5a0a-ba5b-bcfea601833c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-135246/selection/7e2b48383d5d1cc80a4b40001f958af2e676fec2cb1400c3d40af53d8105a997" :answer-field/choices ["q-135246/selection/1a2113340cbccbf03ef6f2820dbf0d593712808904575d8d588bd5a0f80d8951" "q-135246/selection/2b522bb40e7eda5ca92aa8f9ec414d7b1dbfc3b1a769005070849be8e2e2b274" "q-135246/selection/7e2b48383d5d1cc80a4b40001f958af2e676fec2cb1400c3d40af53d8105a997" "q-135246/selection/7d6a9e926adb7325d8a9ca1b402a6d19db0b8e2b59c1f1080d875510213f6120" "q-135246/selection/08731fda7566c2c8b949b7d8cb72b0af69d71ee2776f5eae62dbae9444f1ef34"] :db/ensure [:answer-field/validate]} {:db/id "q-135246" :question/id #uuid "97712f28-e4fa-5d27-9d28-9d9d405f7678" :question/math-academy-id "q-135246" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038412/assets/1fa98148cf4302a5524ade655ee09a3f74d248ba766849f62a71f3ec85e860c6.png)\n\nWhat is the equation of the surface shown above in spherical polar coordinates?" :question/worked-solution "In the picture, we are given a half-plane that passes through the $z$-axis.\n\nWe write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nEvery point on the given plane makes an angle of $\\frac{5\\pi }{6}$ radians with the positive $x$-axis. On the other hand, $\\rho $ and $ϕ$ can vary arbitrarily in their respective domains. \n\nTherefore, the spherical polar equation of the surface is $\\theta =\\frac{5\\pi }{6}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-135246/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "133f6b90-4074-5860-9b89-16b59c5613bf"] :knowledge-point/questions ["q-13524