field/choices ["q-135295/selection/e3bc01c1a7cc4eaaa3d0fec3c0eb87ff9cb3bf03f2891a742d43b82797869ffc" "q-135295/selection/b1351b8d6e4b1f60c445722c5aab2f3e1a56009d234588b4f56554f9bba327b8" "q-135295/selection/13bd218f147bb9f6ca3e89b82bc3a6f81ca117761afc159891e41b0d26a13bbb" "q-135295/selection/9a01d3b7bb50f74f0f0a937ec21e923b3fd4baedfed010beb5720f21b3f20cd5" "q-135295/selection/c42687c1e0e0b1f1d69a99bb36f784671f2be77b295e7dc563f9366ef570bdd1"] :db/ensure [:answer-field/validate]} {:db/id "q-135295" :question/id #uuid "e4204862-8d04-599c-b1c4-5e077bf6c058" :question/math-academy-id "q-135295" :question/problem "What surface is defined by the equation $ϕ=\\frac{3\\pi }{4}$ in spherical polar coordinates?" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nWith that in mind, let's examine our equation:\n\n$$\nϕ=\\frac{3\\pi }{4}\n$$\n\nThis equation specifies that for any point on the surface, the angle that the corresponding vector makes with the positive $z$-axis must equal $\\frac{3\\pi }{4}.$ On the other hand, $\\rho $ and $\\theta $ can vary arbitrarily in their respective domains. \n\nTherefore, since $\\rho \\ge 0,$ our surface is a half-cone.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038412/assets/ee967c13fa7edaaba4d3a218abf20aa067cbd2251f2a008158c9c991c27344ea.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-135295/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a52e1346-75c4-537c-add9-777911dbe5ff"] :knowledge-point/questions ["q-135295"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161833/selection/7c8ca4f6c90f2d46b225812c3f9977d543cf13017a57f09a231d572bee85bd0d" :answer/id #uuid "ec5f701a-b33f-5d81-9d89-785021b3dfb4" :answer/type :answer.type/math :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,0\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi /2}" :db/ensure [:answer/validate]} {:db/id "q-161833/selection/d05c9c531d92b5b38d5adb4ee6b3e3edf93d16298931de347af1a61c5a7b1671" :answer/id #uuid "aec26e67-0cb9-5ea1-83cf-0ee76f1d7703" :answer/type :answer.type/math :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,3\\pi /2\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }" :db/ensure [:answer/validate]} {:db/id "q-161833/selection/b92bd96f49133b7963cce5d3ac0562ef295659f1f6aa754c997df067e4b0a318" :answer/id #uuid "20d48fd6-16e7-5c3e-abe1-90345a13c952" :answer/type :answer.type/math :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,\\pi /2\\le \\theta \\le 3\\pi /2,\\,0\\le ϕ\\le \\pi }" :db/ensure [:answer/validate]} {:db/id "q-161833/selection/c10dce5603f0f78e4ff122f221d1ad84427c8fca20d4e5e18bac5d2a200d9ef0" :answer/id #uuid "e261b37f-f10e-5c17-987d-eef37ca2f1da" :answer/type :answer.type/math :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 8,\\,\\pi /4\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le 2\\pi }" :db/ensure [:answer/validate]} {:db/id "q-161833/selection/cd8345b54535ece72b2d5ec955502a5d2e66224365ee5cff1c7f4a0745b0b3f5" :answer/id #uuid "25c7af3d-00ac-5dc8-9468-b08e260956ba" :answer/type :answer.type/math :answer/value "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le \\sqrt{2},\\,\\pi /2\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi }" :db/ensure [:answer/validate]} {:db/id "q-161833/selection" :answer-field/id #uuid "001933f9-1815-5f56-9d8d-322211108f2f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161833/selection/d05c9c531d92b5b38d5adb4ee6b3e3edf93d16298931de347af1a61c5a7b1671" :answer-field/choices ["q-161833/selection/7c8ca4f6c90f2d46b225812c3f9977d543cf13017a57f09a231d572bee85bd0d" "q-161833/selection/d05c9c531d92b5b38d5adb4ee6b3e3edf93d16298931de347af1a61c5a7b1671" "q-161833/selection/b92bd96f49133b7963cce5d3ac0562ef295659f1f6aa754c997df067e4b0a318" "q-161833/selection/c10dce5603f0f78e4ff122f221d1ad84427c8fca20d4e5e18bac5d2a200d9ef0" "q-161833/selection/cd8345b54535ece72b2d5ec955502a5d2e66224365ee5cff1c7f4a0745b0b3f5"] :db/ensure [:answer-field/validate]} {:db/id "q-161833" :question/id #uuid "060710b8-3073-5599-a037-d51edefd5e9b" :question/math-academy-id "q-161833" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038412/assets/b221cb7e202e72f500416481175dd55b87c6a129dbdc121e20bcfdb7f8d0d443.png)\n\nThe solid enclosed by the quarter-sphere ${x}^{2}+{y}^{2}+{z}^{2}=4$ for $x\\ge 0$ and $y\\le 0,$ shown above, can be described in spherical polar coordinates as" :question/worked-solution "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038412/assets/cca15d8d91ebfe643777122cf41a49f2bfe3bac901b30e160cad65eb6b4b102f.png)\n\n  \n\nNotice that inside our region, the spherical polar coordinates vary withing the following domains:\n\n- $\\rho \\in [0,2]$\n\n- $\\theta \\in [\\frac{3\\pi }{2},2\\pi ]$\n\n- $ϕ\\in [0,\\pi ]$\n\nTherefore, we have\n\n$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 2,\\,\\frac{3\\pi }{2}\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161833/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fde60ded-ec05-5