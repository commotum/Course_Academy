{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}\\sqrt{{(6{e}^{\\theta })}^{2}+{(6{e}^{\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}\\sqrt{36{e}^{2\\theta }+36{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}\\sqrt{72{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =6\\sqrt{2}{\\int }_{0}^{\\pi /8}{e}^{\\theta }\\,\\text{d}\\theta  \\\\  & =6\\sqrt{2}\\,{e}^{\\theta }{|}_{0}^{\\pi /8} \\\\  & =6\\sqrt{2}({e}^{\\pi /8}-{e}^{0}) \\\\  & =6\\sqrt{2}({e}^{\\pi /8}-1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/state.json" "file_sha256" "0b1ed19fd4a8c9d1e603759e8dfd614a9b19cf8538c17e1fc27da327e60f3985"} {"question" "q-347926" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/activity-metadata.json" "file_sha256" "25534f8c05e1af5c601f976cba8c3964f83556db143e500fca90165f9b904eda"} {"question" "q-347926" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/state.json" "file_sha256" "0b1ed19fd4a8c9d1e603759e8dfd614a9b19cf8538c17e1fc27da327e60f3985"} {"question" "q-347926" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "e^{\\pi/8}-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/state.json" "file_sha256" "0b1ed19fd4a8c9d1e603759e8dfd614a9b19cf8538c17e1fc27da327e60f3985"} {"question" "q-51201" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Develo