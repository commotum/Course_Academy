[{:db/id "q-103832/selection/e92111ef40ae82304629197b68a34f006d47a4fd4fc7b063f7d8dc699d520a03" :answer/id #uuid "90f9b78e-20e1-5156-b4ec-5e79a23a7a1c" :answer/type :answer.type/math :answer/value "6{\\int }_{0}^{\\pi /12}\\sqrt{{cos}^{2}⁡(6\\theta )+{sin}^{2}⁡(6\\theta )}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103832/selection/018e2c0c8045c66312d5631bc0a521d8a2abf2f721db385a7e766b99da644fac" :answer/id #uuid "974ca213-2172-5e9c-8725-e36303616bb5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /12}\\sqrt{{cos}^{2}⁡(6\\theta )+36{sin}^{2}⁡(6\\theta )}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103832/selection/29058c1abfeb3ef0b0f52de453fc1c9d60e37d4124b14a2ca400a7b7a94cf429" :answer/id #uuid "1ea815d7-5176-5026-9d14-50609b292b5e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /12}\\sqrt{{sin}^{2}⁡(6\\theta )+6{cos}^{2}⁡(6\\theta )}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103832/selection/664f566723139e27800af9a26ede3a125cdc8417689572fda54b0ad23a592af8" :answer/id #uuid "91cefaee-7f3d-5552-9d31-85ee9e1b2e1f" :answer/type :answer.type/math :answer/value "6{\\int }_{0}^{\\pi /12}\\sqrt{{sin}^{2}⁡(6\\theta )-{cos}^{2}⁡(6\\theta )}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103832/selection/394672f8126c4f548f99c90dca20cf1331771484d2c8b6193ef0397cba152a02" :answer/id #uuid "6e533383-5c44-55d5-bbe5-0ca489de7f0d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /12}\\sqrt{{cos}^{2}⁡(6\\theta )-6{sin}^{2}⁡(6\\theta )}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103832/selection" :answer-field/id #uuid "46de6714-54ea-554b-9b0d-7ced1a3e4f2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103832/selection/018e2c0c8045c66312d5631bc0a521d8a2abf2f721db385a7e766b99da644fac" :answer-field/choices ["q-103832/selection/e92111ef40ae82304629197b68a34f006d47a4fd4fc7b063f7d8dc699d520a03" "q-103832/selection/018e2c0c8045c66312d5631bc0a521d8a2abf2f721db385a7e766b99da644fac" "q-103832/selection/29058c1abfeb3ef0b0f52de453fc1c9d60e37d4124b14a2ca400a7b7a94cf429" "q-103832/selection/664f566723139e27800af9a26ede3a125cdc8417689572fda54b0ad23a592af8" "q-103832/selection/394672f8126c4f548f99c90dca20cf1331771484d2c8b6193ef0397cba152a02"] :db/ensure [:answer-field/validate]} {:db/id "q-103832" :question/id #uuid "dc7335a9-16fc-51fb-856d-48780c80c78e" :question/math-academy-id "q-103832" :question/problem "Which of the following gives the arc length of the polar curve $r=\\operatorname{cos}⁡(6\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{12}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{cos}⁡(6\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-6\\operatorname{sin}⁡(6\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /12}\\sqrt{(\\operatorname{cos}⁡(6\\theta ))^{2}+(-6\\operatorname{sin}⁡(6\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /12}\\sqrt{{cos}^{2}⁡(6\\theta )+36{sin}^{2}⁡(6\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-103832/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b"] :knowledge-point/questions ["q-103832"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-15144"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/assets/4b03822d65ec9f5bea3a1e47d25e4831470754fa09cef510e7c452cc292e9e40.png)\n\nWhich of the following gives the arc length of the polar curve $r=\\theta {e}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}$ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\theta {e}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={e}^{\\theta }+\\theta {e}^{\\theta }=(1+\\theta ){e}^{\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(\\theta {e}^{\\theta })}^{2}+{((1+\\theta ){e}^{\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{\\theta }^{2}{e}^{2\\theta }+(1+2\\theta +{\\theta }^{2}){e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(2{\\theta }^{2}+2\\theta +1){e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{e}^{\\theta }\\sqrt{2{\\theta }^{2}+2\\theta +1}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-103834/selection/c5038297c2d9666b6525b8afa8c9f1600be31b8a1ca08cded1f0c49940d084b9" :answer/id #uuid "4d751d74-87d1-5ad2-9e5c-7dc9050e2a8e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{5+4\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103834/selection/8fd41bfa9f02bf100094696411b21414b1fe864270ba0b7d76a190aeea0478bb" :answer/id #uuid "bd8ed757-247d-5d0a-ac56-25fb9552df02" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi }\\sqrt{1+\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103834/selection/a500d2fc75a1faa015bbc3b5dd8477a9dd32eeaf7c9be5abb6970408ddb2a241" :answer/id #uuid "781ee685-3944-5237-b948-c18d06a01f3f" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{\\pi }\\sqrt{5+\\operatorname{cos}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103834/selection/5a928cda1427f86fcb6dc38b1d919135c1706ee1b9ba443e04409173927c38f5" :answer/id #uuid "eea7efe9-c899-52a9-b469-e59474f9b0d0" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{1+4\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103834/selection/0070c9bf2fc2a2f2f01ac5e5144b2cb238ddaf2e682771e74f2055a9da841580" :answer/id #uuid "5d7f5e70-2f71-54cd-9319-8c3a6c54a7b9" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }\\sqrt{5+4\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-103834/selection" :answer-field/id #uuid "c028f2ad-eb7b-557c-85a0-12b80ab13ee1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-103834/selection/0070c9bf2fc2a2f2f01ac5e5144b2cb238ddaf2e682771e74f2055a9da841580" :answer-field/choices ["q-103834/selection/c5038297c2d9666b6525b8afa8c9f1600be31b8a1ca08cded1f0c49940d084b9" "q-103834/selection/8fd41bfa9f02bf100094696411b21414b1fe864270ba0b7d76a190aeea0478bb" "q-103834/selection/a500d2fc75a1faa015bbc3b5dd8477a9dd32eeaf7c9be5abb6970408ddb2a241" "q-103834/selection/5a928cda1427f86fcb6dc38b1d919135c1706ee1b9ba443e04409173927c38f5" "q-103834/selection/0070c9bf2fc2a2f2f01ac5e5144b2cb238ddaf2e682771e74f2055a9da841580"] :db/ensure [:answer-field/validate]} {:db/id "q-103834" :question/id #uuid "7ed037d3-a424-5f4d-8851-f39873da08ad" :question/math-academy-id "q-103834" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/assets/1bd01b4fe70a497cc66811a2d5b070908221b9932655ee396d9a8039471702c2.png)\n\nWhich of the following gives the arc length of the polar curve $r=1+2\\operatorname{sin}⁡\\theta $ for $0\\le \\theta \\le \\pi $ (shown in blue in the diagram above)?" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1+2\\operatorname{sin}⁡\\theta ,$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=2\\operatorname{cos}⁡\\theta .\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{(1+2\\operatorname{sin}⁡\\theta )^{2}+(2\\operatorname{cos}⁡\\theta )^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1+4\\operatorname{sin}⁡\\theta +4{sin}^{2}⁡\\theta +4{cos}^{2}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{1+4\\operatorname{sin}⁡\\theta +4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{5+4\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-103834/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b"] :knowledge-point/questions ["q-103834"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15136/selection/e719dc2a8ef5d817dd9884536babcc38a51c7aff0479da3a1b8e35d7ef218745" :answer/id #uuid "a7367d03-86ba-5bc7-bf5a-2cc55ad56c18" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{{e}^{\\theta }+2{e}^{2\\theta }}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-15136/selection/b03bc1fa2e9c48f2639a2ce278609bbf0687fb444d4a0aa94c7fb72a546b4c1c" :answer/id #uuid "77067f41-cff1-55a6-ac42-d1cde970f3a9" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{2{e}^{\\theta }+{e}^{2\\theta }}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-15136/selection/cd6d9c98770dfca5f239a0ae9bd8e8a6fd08c100ea33d0e24935647b8555b43a" :answer/id #uuid "5b6d4286-d426-5db8-b46d-04d6318f2ecc" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{1+{e}^{\\theta }+{e}^{2\\theta }}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-15136/selection/506223bbed25fb657d12de94fb2de27cfa61bec3355fac2fabf0ea1c9070e537" :answer/id #uuid "6cd58626-f106-57af-9e9b-6b7850a52c69" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{1+2{e}^{2\\theta }}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-15136/selection/eb0620f3682271f79ea05e7d943ef5a4627144adf4c76ae49b439c5d07880a8d" :answer/id #uuid "1730c364-d722-5384-bbf4-eee62d4725a4" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\sqrt{1+2{e}^{\\theta }+2{e}^{2\\theta }}\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-15136/selection" :answer-field/id #uuid "ab7be4b7-a6bd-5f58-b416-5153b8789e82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15136/selection/eb0620f3682271f79ea05e7d943ef5a4627144adf4c76ae49b439c5d07880a8d" :answer-field/choices ["q-15136/selection/e719dc2a8ef5d817dd9884536babcc38a51c7aff0479da3a1b8e35d7ef218745" "q-15136/selection/b03bc1fa2e9c48f2639a2ce278609bbf0687fb444d4a0aa94c7fb72a546b4c1c" "q-15136/selection/cd6d9c98770dfca5f239a0ae9bd8e8a6fd08c100ea33d0e24935647b8555b43a" "q-15136/selection/506223bbed25fb657d12de94fb2de27cfa61bec3355fac2fabf0ea1c9070e537" "q-15136/selection/eb0620f3682271f79ea05e7d943ef5a4627144adf4c76ae49b439c5d07880a8d"] :db/ensure [:answer-field/validate]} {:db/id "q-15136" :question/id #uuid "c659d13d-a024-51d5-b83b-b004bef94416" :question/math-academy-id "q-15136" :question/problem "Which of the following gives the arc length of the polar curve $r=1+{e}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{2}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=1+{e}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={e}^{\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(1+{e}^{\\theta })}^{2}+{({e}^{\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{1+2{e}^{\\theta }+{e}^{2\\theta }+{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{1+2{e}^{\\theta }+2{e}^{2\\theta }}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15136/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd0b4da9-1a0f-5a46-aff1-3ce5c0cebb3b"] :knowledge-point/questions ["q-15136"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-51198"] :question/problem "Which of the following gives the arc length of the polar curve $r=\\operatorname{cos}⁡(2\\theta )$ for $0\\le \\theta \\le \\frac{\\pi }{3}?$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=\\operatorname{cos}⁡(2\\theta ),$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=-2\\operatorname{sin}⁡(2\\theta ).\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{(\\operatorname{cos}⁡(2\\theta ))^{2}+(-2\\operatorname{sin}⁡(2\\theta ))^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\sqrt{{cos}^{2}⁡(2\\theta )+4{sin}^{2}⁡(2\\theta )}\\,\\text{d}\\theta \\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-20070"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/assets/fa1c1c3ae2769f45854de4f0b00fc394fccb40b40704cfd09e6eb11eee3c07af.png)\n\nFind the arc length of the polar curve $r=3{e}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{4}$ (shown in blue in the diagram above)." :db/ensure [:question/validate]} {:db/id "q-353605/field-1/b4a3c85397f8e29da6b3b3fa3d3212c2e172a12d6b56debb952762f560e02395" :answer/id #uuid "f9813fe1-459a-5e43-be3b-d8816ecf0ba6" :answer/type :answer.type/math :answer/value "\\frac{2}{\\ln(3)}" :db/ensure [:answer/validate]} {:db/id "q-353605/field-1/bfc01d4108e2ea76cb7922a0115e63fe359192edb8cfff247237fa5302acb56e" :answer/id #uuid "a89feb5d-3bfe-547c-ab24-a7ffc179252c" :answer/type :answer.type/math :answer/value "\\frac{1}{\\ln(3)}" :db/ensure [:answer/validate]} {:db/id "q-353605/field-1" :answer-field/id #uuid "2af181e2-36db-5731-ae7a-c207a459de58" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353605/field-1/b4a3c85397f8e29da6b3b3fa3d3212c2e172a12d6b56debb952762f560e02395" :answer-field/choices ["q-353605/field-1/b4a3c85397f8e29da6b3b3fa3d3212c2e172a12d6b56debb952762f560e02395" "q-353605/field-1/bfc01d4108e2ea76cb7922a0115e63fe359192edb8cfff247237fa5302acb56e"] :db/ensure [:answer-field/validate]} {:db/id "q-353605" :question/id #uuid "607472b8-7420-5238-a280-73715b78e8a7" :question/math-academy-id "q-353605" :question/problem "Find the arc length $L$ of the polar curve $r={3}^{\\theta /4}$ for $0\\le \\theta \\le 4.$ Do not round the answer.\n\n$L=$\n{{field-1}}$\\sqrt{{ln}^{2}⁡3+16}$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r={3}^{\\theta /4},$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }={3}^{\\theta /4}\\cdot \\frac{\\operatorname{ln}⁡3}{4}.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{4}\\sqrt{{({3}^{\\theta /4})}^{2}+{({3}^{\\theta /4}\\cdot \\frac{\\operatorname{ln}⁡3}{4})}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{4}\\sqrt{{3}^{\\theta /2}+{3}^{\\theta /2}\\cdot \\frac{{ln}^{2}⁡3}{16}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{4}\\sqrt{(1+\\frac{{ln}^{2}⁡3}{16}){3}^{\\theta /2}}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+\\frac{{ln}^{2}⁡3}{16}}{\\int }_{0}^{4}{3}^{\\theta /4}\\,\\text{d}\\theta  \\\\  & =\\sqrt{1+\\frac{{ln}^{2}⁡3}{16}}\\cdot \\frac{4}{\\operatorname{ln}⁡3}\\cdot {3}^{\\theta /4}\\,{|}_{0}^{4} \\\\  & =\\sqrt{1+\\frac{{ln}^{2}⁡3}{16}}\\cdot \\frac{4}{\\operatorname{ln}⁡3}\\cdot ({3}^{1}-{3}^{0}) \\\\  & =\\sqrt{1+\\frac{{ln}^{2}⁡3}{16}}\\cdot \\frac{8}{\\operatorname{ln}⁡3} \\\\  & =\\frac{2}{\\operatorname{ln}⁡3}\\sqrt{{ln}^{2}⁡3+16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-353605/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1"] :knowledge-point/questions ["q-353605"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-9532"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/assets/085be1e624ae99afee256d2a9591f17d2f33f688364b6e59fdcd7c415206bda7.png)\n\nFind the arc length of the polar curve $r=2\\operatorname{sin}⁡\\theta $ for $\\frac{\\pi }{2}\\le \\theta \\le \\frac{5\\pi }{6}$ (shown in blue in the diagram above)." :db/ensure [:question/validate]} {:db/id "q-347926/field-1/a611b578069120ebf0e89fa34d852fa50fa1081e5fc5da7f9af9d1e25823d7ed" :answer/id #uuid "38e024c3-2f36-51b4-9808-c9b74ce7d6e5" :answer/type :answer.type/math :answer/value "e^{\\pi/8}-1" :db/ensure [:answer/validate]} {:db/id "q-347926/field-1/c66d17721982600a01e870aaa51b8b09fafa99909c98bd17fb348558fe9e6b19" :answer/id #uuid "1de9c005-5309-53f4-8684-874cd3ffc09b" :answer/type :answer.type/math :answer/value "e^{\\pi/8}+1" :db/ensure [:answer/validate]} {:db/id "q-347926/field-1" :answer-field/id #uuid "e562ab53-baf2-5d81-ac32-7a5ffe8bfac7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347926/field-1/a611b578069120ebf0e89fa34d852fa50fa1081e5fc5da7f9af9d1e25823d7ed" :answer-field/choices ["q-347926/field-1/a611b578069120ebf0e89fa34d852fa50fa1081e5fc5da7f9af9d1e25823d7ed" "q-347926/field-1/c66d17721982600a01e870aaa51b8b09fafa99909c98bd17fb348558fe9e6b19"] :db/ensure [:answer-field/validate]} {:db/id "q-347926" :question/id #uuid "fd251789-4dc6-5eb3-a93a-44a9735de025" :question/math-academy-id "q-347926" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/assets/2da83e2ec620d3920c4378a77785a9ef2802dd1d06badcf4852be2263f68264e.png)\n\nFind the arc length $L$ of the polar curve $r=6{e}^{\\theta }$ for $0\\le \\theta \\le \\frac{\\pi }{8}$ (shown in blue in the diagram above). Do not round the answer.\n\n$L=6\\sqrt{2}($\n{{field-1}} $)$" :question/worked-solution "The arc length $L$ of a polar curve $r=r(\\theta )$ is given by\n\n$$\nL={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta .\n$$\n\nSince $r=6{e}^{\\theta },$ we have\n\n$$\n\\frac{\\text{d}r}{\\text{d}\\theta }=6{e}^{\\theta }.\n$$\n\nTherefore, the arc length is\n\n$$\n\\begin{aligned}L & ={\\int }_{{\\theta }_{1}}^{{\\theta }_{2}}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}\\sqrt{{(6{e}^{\\theta })}^{2}+{(6{e}^{\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}\\sqrt{36{e}^{2\\theta }+36{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /8}\\sqrt{72{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =6\\sqrt{2}{\\int }_{0}^{\\pi /8}{e}^{\\theta }\\,\\text{d}\\theta  \\\\  & =6\\sqrt{2}\\,{e}^{\\theta }{|}_{0}^{\\pi /8} \\\\  & =6\\sqrt{2}({e}^{\\pi /8}-{e}^{0}) \\\\  & =6\\sqrt{2}({e}^{\\pi /8}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-347926/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1"] :knowledge-point/questions ["q-347926"] :db/ensure [:knowledge-point/validate]} {:db/id "q-51201/selection/b17bafc20d5ba80adbc83ee7446daa3eada7963ae03fda0ebd25336249ffff4a" :answer/id #uuid "b1b4ea04-76a3-51fe-86c7-3f2053f855a2" :answer/type :answer.type/math :answer/value "5\\sqrt{2}{e}^{\\pi /6}" :db/ensure [:answer/validate]} {:db/id "q-51201/selection/f2612f3ccce930d69529217fc6b9aef602f80efb7cd0db1f3f0482bc6f7ac5b7" :answer/id #uuid "706b5e30-545c-5187-8dd2-f5d9a963fd30" :answer/type :answer.type/math :answer/value "5({e}^{\\pi /6}-1)" :db/ensure [:answer/validate]} {:db/id "q-51201/selection/bf0f9d9e69bf46840c80bf127bc206f0faf48231e40e4ee13e2fb87677ae3700" :answer/id #uuid "05ec77a2-d017-55b6-b85d-3f8a362803c1" :answer/type :answer.type/math :answer/value "5{e}^{\\pi /6}" :db/ensure [:answer/validate]} {:db/id "q-51201/selection/d10ec45a8294131d8516b8ab0a23efe879a4fd038a6c90ffe9a17c4d205635c4" :answer/id #uuid "0d151997-d40b-5d02-865e-a135456459e8" :answer/type :answer.type/math :answer/value "5\\sqrt{2}({e}^{\\pi /6}-e)" :db/ensure [:answer/validate]} {:db/id "q-51201/selection/38f235a786bed920f49591946222a499ce85c6b64dc14794394ad71920d58f72" :answer/id #uuid "af5078a4-a99b-5126-bc81-39bc1715b7cd" :an