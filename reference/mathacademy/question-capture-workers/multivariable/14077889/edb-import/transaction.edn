25{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /6}\\sqrt{50{e}^{2\\theta }}\\,\\text{d}\\theta  \\\\  & =5\\sqrt{2}{\\int }_{0}^{\\pi /6}{e}^{\\theta }\\,\\text{d}\\theta  \\\\  & =5\\sqrt{2}\\,{e}^{\\theta }{|}_{0}^{\\pi /6} \\\\  & =5\\sqrt{2}({e}^{\\pi /6}-{e}^{0}) \\\\  & =5\\sqrt{2}({e}^{\\pi /6}-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-51201/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "84a533e8-9a7c-58f3-9d3c-7c08b3c6bfd1"] :knowledge-point/questions ["q-51201"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7400"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/assets/e5647c0f19727d1e626e637464cc57444e0bc0f2f8e99a4afd15d3c3631dc3f0.png)\n\nFind an integral expression for the arc length of the polar curve $r=3-\\sin(7\\theta)$ for $0 \\leq \\theta \\leq \\pi,$ shown in blue in the diagram above." :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-641"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077889/assets/0bb9e5e7315d4bcd5fc21700fdd2597f6d9b585a109145de53c6f94e9530eabf.png)\n\nFind the arc length of the polar curve $r=2(1-\\cos\\theta)$ for $0 \\leq \\theta \\leq \\pi$ (shown in blue in the picture above)." :db/ensure [:question/validate]}]
