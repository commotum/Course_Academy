$$\n{I}^{′}(t)=10{t}^{4}(2{t}^{5})=20{t}^{9}.\n$$" 13194139536007 true] [17592186379208 1000 #edb/ref 17592186379209 13194139536007 true] [17592186379208 1040 #edb/ref 17592186045449 13194139536007 true] [17592186379208 1041 "field-1" 13194139536007 true] [17592186379208 1104 #edb/ref 17592186379209 13194139536007 true] [17592186379208 1110 #uuid "ce38428c-6c3f-5e4a-8f35-9675de041abc" 13194139536007 true] [17592186379209 1034 "20t^9" 13194139536007 true] [17592186379209 1103 #edb/ref 17592186045453 13194139536007 true] [17592186379209 1111 #uuid "826bad29-8cab-576e-8fe5-c67f43909d9d" 13194139536007 true]] :edb/tempids {"q-350548" 17592186379200 "q-350548/field-1" 17592186379201 "q-350548/field-1/894040af4eb4f74d268a1de5813d74686faf1a22690102f0101d53b8bf3e439c" 17592186379202 "q-350548/field-1/bc1e3201c7e1f5484dfa1706a75ff8730b0e59c2b02ccc7f438c0dafca55fff8" 17592186379203 "q-350550" 17592186379204 "q-350550/field-1" 17592186379205 "q-350550/field-1/b046ca2f88edab8492765792146511ac6d7233b61ff927ae179262786f44e60c" 17592186379206 "q-350551" 17592186379207 "q-350551/field-1" 17592186379208 "q-350551/field-1/8d4191e6e8cc3013d0ef84c8ea4953971358fff0f0060734825100d0f3acfd8d" 17592186379209}}
