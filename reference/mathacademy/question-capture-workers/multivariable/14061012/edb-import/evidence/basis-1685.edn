#{[{:db/id #edb/ref 17592186106023 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "846fec6b-0634-527c-95c2-25754ce33c08" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186102376} {:answer/id #uuid "98084e96-1175-5ccb-9f1b-d2c905265afd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2\\sqrt{3}}" :db/id #edb/ref 17592186102377} {:answer/id #uuid "cda2fdc1-166a-5b7a-b0ce-a12be6fe892a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2}" :db/id #edb/ref 17592186102378} {:answer/id #uuid "fdd1d530-3fe4-537c-8416-40b990c1ef12" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186102379} {:answer/id #uuid "22d7a360-bc93-5f42-9551-0ca7a207abd2" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186102380}] :answer-field/correct {:answer/id #uuid "cda2fdc1-166a-5b7a-b0ce-a12be6fe892a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3} - 1}{2}" :db/id #edb/ref 17592186102378} :answer-field/id #uuid "5a6ff4f7-e72a-5c98-af10-7d1e281c3900" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102375}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e48bd53-4841-5a1d-adee-85eb3b590727" :question/math-academy-id "q-18374" :question/problem "Let $p=⟨\\sqrt{2},1,-1⟩$ and $q=⟨\\sqrt{8},-\\sqrt{3},1⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{\\sqrt{2}\\cdot \\sqrt{8}+1\\cdot (-\\sqrt{3})+(-1)\\cdot 1}{\\sqrt{(\\sqrt{8})^{2}+(-\\sqrt{3})^{2}+{1}^{2}}} \\\\  & =\\frac{3-\\sqrt{3}}{\\sqrt{12}} \\\\  & =\\frac{3-\\sqrt{3}}{2\\sqrt{3}} \\\\  & =\\frac{\\sqrt{3}-1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325643 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "379dcbef-4c41-513f-8577-7563a279e9c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186325645}] :answer-field/correct {:answer/id #uuid "379dcbef-4c41-513f-8577-7563a279e9c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{\\sqrt{13}}" :db/id #edb/ref 17592186325645} :answer-field/id #uuid "4a97814c-22dd-5e52-b37f-cc2496d165e1" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325644}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "58e692ad-2f21-5e36-851a-c003694ad570" :question/math-academy-id "q-275244" :question/problem "Let $p=⟨2,1,-2⟩$ and $q=⟨3,2,0⟩.$ Find the exact value of the scalar projection of $p$ onto $q.$\n\n${\\text{comp}}_{q}\\,p=$\n{{field-1}}" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{2\\cdot 3+1\\cdot 2+(-2)\\cdot 0}{\\sqrt{{3}^{2}+{2}^{2}+{0}^{2}}} \\\\  & =\\frac{8}{\\sqrt{13}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186275290 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e91d1d3b-1185-52e5-a2b0-ca758b020b9e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275292}] :answer-field/correct {:answer/id #uuid "e91d1d3b-1185-52e5-a2b0-ca758b020b9e" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186275292} :answer-field/id #uuid "825cc115-7959-55bc-9a6d-6100726bc4e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275291}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d1067d56-4d83-5281-8c53-6dfcd93ed0f2" :question/math-academy-id "q-275256" :question/problem "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186325650 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29fc626e-908a-5210-bc9b-c842034bf3a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186325652}] :answer-field/correct {:answer/id #uuid "29fc626e-908a-5210-bc9b-c842034bf3a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186325652} :answer-field/id #uuid "0c6e7d34-eda1-5901-af72-e7495be58b3b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186325651}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1ab23067-0b24-53fd-9375-d57deff25b7a" :question/math-academy-id "q-318979" :question/problem "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}]}
