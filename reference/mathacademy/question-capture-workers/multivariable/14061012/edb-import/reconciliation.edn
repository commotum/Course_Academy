ademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-275244" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/activity-metadata.json" "file_sha256" "d0615a346086edb0e1956bf5c50ff0d4cf1f6e1f77d01d718f95136c1c710a8b"} {"question" "q-275244" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-275244" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{8}{\\sqrt{13}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-275256" "field" nil "attribute" "question/problem" "value" "Let $a=[\\begin{aligned}-1 \\\\ 2 \\\\ 4\\end{aligned}]$ and $b=[\\begin{aligned}0 \\\\ x \\\\ 2\\end{aligned}].$ Given that the scalar projection of $a$ onto $b$ is $0,$ find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-275256" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-1)\\cdot 0+2\\cdot x+4\\cdot 2 \\\\  & =2x+8.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 2x+8 & =0 \\\\ 2x & =-8 \\\\ x & =-4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-275256" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/activity-metadata.json" "file_sha256" "d0615a346086edb0e1956bf5c50ff0d4cf1f6e1f77d01d718f95136c1c710a8b"} {"question" "q-275256" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-275256" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-318979" "field" nil "attribute" "question/problem" "value" "Let $a=⟨3,-2,1⟩$ and $b=⟨2,1,-2⟩.$ Find the scalar projection of $a$ onto $b.$\n\n${\\text{comp}}_{b}\\,a=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-318979" "field" nil "attribute" "question/worked-solution" "value" "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(3)(2)+(-2)(1)+(1)(-2)}{\\sqrt{{2}^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{6-2-2}{\\sqrt{9}} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-318979" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/activity-metadata.json" "file_sha256" "d0615a346086edb0e1956bf5c50ff0d4cf1f6e1f77d01d718f95136c1c710a8b"} {"question" "q-318979" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-318979" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-319254" "field" nil "attribute" "question/problem" "value" "Let $p=3i+2j-k$ and $q=-2i+xj.$ Given that the scalar projection of $p$ onto $q$ is zero, find the value of $x.$\n\n$x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-319254" "field" nil "attribute" "question/worked-solution" "value" "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =3\\cdot (-2)+2\\cdot x+(-1)\\cdot 0 \\\\  & =-6+2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ -6+2x & =0 \\\\ 2x & =6 \\\\ x & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-319254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/activity-metadata.json" "file_sha256" "d0615a346086edb0e1956bf5c50ff0d4cf1f6e1f77d01d718f95136c1c710a8b"} {"question" "q-319254" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061012/state.json" "file_sha256" "c0bd64da52539ae9a767050c98e9f91a69037b8f6835a6c9b464c504533ef368"} {"question" "q-319254" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/ref