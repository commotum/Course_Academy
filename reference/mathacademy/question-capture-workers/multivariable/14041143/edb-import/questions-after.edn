e-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f4dd399-17ba-5d5d-a947-9f9d97c58fc6" :answer/type {:db/ident :answer.type/math} :answer/value "148" :db/id #edb/ref 17592186174727} {:answer/id #uuid "91d2df24-cd40-51a6-ad1c-36ace1984565" :answer/type {:db/ident :answer.type/math} :answer/value "88" :db/id #edb/ref 17592186174728} {:answer/id #uuid "078faf97-fccc-5d7d-b441-d5f5a91ba9c8" :answer/type {:db/ident :answer.type/math} :answer/value "92" :db/id #edb/ref 17592186174729} {:answer/id #uuid "356c94ec-fbbf-551d-970e-7d05c53a16e7" :answer/type {:db/ident :answer.type/math} :answer/value "111" :db/id #edb/ref 17592186174730} {:answer/id #uuid "79c9c1e4-dc41-55e4-8853-f413f78e314b" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186174731}] :answer-field/correct {:answer/id #uuid "356c94ec-fbbf-551d-970e-7d05c53a16e7" :answer/type {:db/ident :answer.type/math} :answer/value "111" :db/id #edb/ref 17592186174730} :answer-field/id #uuid "68f5ca45-0719-56a4-9d9b-0c959b47bdb0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186174726}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c7aa456d-0ee8-5696-8091-d1aa1fc2aa26" :question/math-academy-id "q-2409" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=6{t}^{2}-2t.$ What is the total displacement of the particle between $t=1$ and $t=4?$" :question/requires-calculator true :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement. Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{1}^{4}(6{t}^{2}-2t)\\,\\text{d}t \\\\  & =(2{t}^{3}-{t}^{2}){|}_{1}^{4} \\\\  & =[2(4)^{3}-(4)^{2}]-[2(1)^{3}-(1)^{2}] \\\\  & =[128-16]-[2-1] \\\\  & =112-1 \\\\  & =111.\\end{aligned}\n$$\n\nSo the total displacement between $t=1$ and $t=4$ is $111.$"}] [{:db/id #edb/ref 17592186317099 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f40f1b33-c29b-5929-91ff-0f0a7d405bef" :answer/type {:db/ident :answer.type/math} :answer/value "324" :db/id #edb/ref 17592186317101} {:answer/id #uuid "5e502939-66a9-58f2-8483-22e61f79f86f" :answer/type {:db/ident :answer.type/math} :answer/value "453" :db/id #edb/ref 17592186317102} {:answer/id #uuid "8cfdc686-2da9-542f-8416-945c31df98ba" :answer/type {:db/ident :answer.type/math} :answer/value "269" :db/id #edb/ref 17592186317103} {:answer/id #uuid "a85a23e7-ec63-5eb1-addb-0f450089f786" :answer/type {:db/ident :answer.type/math} :answer/value "214" :db/id #edb/ref 17592186317104} {:answer/id #uuid "3e685537-fdec-5193-b919-f201a7bd1e10" :answer/type {:db/ident :answer.type/math} :answer/value "221" :db/id #edb/ref 17592186317105}] :answer-field/correct {:answer/id #uuid "f40f1b33-c29b-5929-91ff-0f0a7d405bef" :answer/type {:db/ident :answer.type/math} :answer/value "324" :db/id #edb/ref 17592186317101} :answer-field/id #uuid "792b11c7-7227-5f02-917b-c8e6000176a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317100}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5831fc2e-764d-5a31-8755-1f580d3a4978" :question/math-academy-id "q-2417" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)=6{t}^{2}+4t.$ At time $t=4$ the particle is located at the position $x=-300.$ What is the position of the particle at time $t=7?$" :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=4$ plus the total displacement over $t\\in [4,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(4)+{\\int }_{4}^{7}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(7) & =-300+{\\int }_{4}^{7}(6{t}^{2}+4t)\\,\\text{dt} \\\\  & =-300+{[2{t}^{3}+2{t}^{2})]}_{4}^{7} \\\\  & =-300+([2(7)^{3}+2(7)^{2}]-[2(4)^{3}+2(4)^{2}]) \\\\  & =-300+([686+98]-[128+32]) \\\\  & =-300+(784-160) \\\\  & =-300+624 \\\\  & =324.\\end{aligned}\n$$\n\nSo the position of the particle at $t=7$ is $x=324.$"}] [{:db/id #edb/ref 17592186317106 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6ed8794f-8d5f-5151-a373-508d49d28475" :answer/type {:db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186317108}] :answer-field/correct {:answer/id #uuid "6ed8794f-8d5f-5151-a373-508d49d28475" :answer/type {:db/ident :answer.type/math} :answer/value "200" :db/id #edb/ref 17592186317108} :answer-field/id #uuid "8665b4bb-f5ff-5512-a0aa-62e8272667c0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317107}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1352850d-196b-5e3b-b4aa-7a3aa8b03b2c" :question/math-academy-id "q-348281" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=6{t}^{2}-4t.$ Find the total displacement $d$ of the particle between $t=0$ and $t=5.$\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=0$ and $t=5.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{0}^{5}(6{t}^{2}-4t)\\,\\text{dt} \\\\  & =(2{t}^{3}-2{t}^{2}){|}_{0}^{5} \\\\  & =[2(5)^{3}-2(5)^{2}]-[2(0)^{3}-2(0)^{2}] \\\\  & =[250-50]-0 \\\\  & =200.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317109 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7b0ee78-9caa-591c-bf3e-ae677d383656" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186317111} {:answer/id #uuid "30558b2d-f9d9-5a82-8400-bc8e75e57f74" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186317112}] :answer-field/correct {:answer/id #uuid "30558b2d-f9d9-5a82-8400-bc8e75e57f74" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186317112} :answer-field/id #uuid "92f08796-c227-5008-9923-4794a926e496" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317110}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "26d9513e-8557-587b-a7aa-f43d97b00bb3" :question/math-academy-id "q-351420" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=-4t-1.$ Find the total displacement $d$ of the particle between $t=0$ and $t=1.$\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=0$ and $t=1.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{0}^{1}(-4t-1)\\,\\text{dt} \\\\  & =(-2{t}^{2}-t){|}_{0}^{1} \\\\  & =[-2(1)^{2}-(1)]-[-2(0)^{2}-(0)] \\\\  & =[-2-1]-0 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292194 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f5f22ce7-e843-5b2f-aa76-d8a89bec012d" :answer/type {:db/ident :answer.type/math} :answer/value "-95" :db/id #edb/ref 17592186292196} {:answer/id #uuid "82e94eae-a41e-526d-9760-a60a7c5b5740" :answer/type {:db/ident :answer.type/math} :answer/value "95" :db/id #edb/ref 17592186292197}] :answer-field/correct {:answer/id #uuid "f5f22ce7-e843-5b2f-aa76-d8a89bec012d" :answer/type {:db/ident :answer.type/math} :answer/value "-95" :db/id #edb/ref 17592186292196} :answer-field/id #uuid "b55e316f-3bbb-59bb-987e-a56715861c55" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186292195}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6e25066f-b114-5d4b-8ff9-3e93d1808c46" :question/math-academy-id "q-351430" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=16-9{t}^{2}.$ Find the total displacement $d$ of the particle between $t=3$ and $t=4.$\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=3$ and $t=4.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{3}^{4}(16-9{t}^{2})\\,\\text{dt} \\\\  & ={(16t-3{t}^{3})|}_{3}^{4} \\\\  & =[16(4)-3(4)^{3}]-[16(3)-3(3)^{3}] \\\\  & =[64-192]-[48-81] \\\\  & =-95.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317113 :knowledge-point/_questions [{:knowledge-point/id #uuid "d7ca7dee-1a1b-5af6-8719-5d2377004be9" :knowledge-point/title "Finding the Total Displacement of a Particle Given Its Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "499aacff-594b-5c11-a8e2-162bbfe14224" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186317115} {:answer/id #uuid "d465bbe6-3dbd-5530-8b0c-417c00332fc9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317116}] :answer-field/correct {:answer/id #uuid "499aacff-594b-5c11-a8e2-162bbfe14224" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi}{4}" :db/id #edb/ref 17592186317115} :answer-field/id #uuid "9038322d-cc66-50ab-a7ab-1cfda5851b5d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317114}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "97403b47-5240-5854-b79c-59d3da5d4bb0" :question/math-academy-id "q-351442" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t$ is given by $v(t)=\\frac{1}{1+{t}^{2}}.$ Find the total displacement $d$ of the particle between $t=0$ and $t=1.$ Do not round the answer.\n\n$d=$\n{{field-1}}" :question/worked-solution "We find the total displacement by calculating the definite integral of the velocity.\n\nLet $d$ be the total displacement between $t=0$ and $t=1.$ Then we have\n\n$$\n\\begin{aligned}d & ={\\int }_{0}^{1}(\\frac{1}{1+{t}^{2}})\\,\\text{dt} \\\\  & =(\\operatorname{arctan}⁡(t)){|}_{0}^{1} \\\\  & =\\operatorname{arctan}⁡(1)-\\operatorname{arctan}⁡(0) \\\\  & =\\frac{\\pi }{4}-0 \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186317117 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45a04164-bff4-56a7-8f76-8a4c21319410" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186317119}] :answer-field/correct {:answer/id #uuid "45a04164-bff4-56a7-8f76-8a4c21319410" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186317119} :answer-field/id #uuid "56912d8e-2282-50a1-b8f1-7c273bbfe54b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317118}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "a6304d94-83b6-5e47-99ea-2a324e57b572" :question/math-academy-id "q-351448" :question/problem "A particle $Q$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡(t).$ At time $t=\\frac{\\pi }{2}$ the particle is located at the position $x=5.$ \nFind the position of the particle at time $t=\\pi .$ Do not round the answer.\n\nThe position of the particle at $t=\\pi $ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=\\pi $ is equal to its position at $t=\\frac{\\pi }{2}$ plus the total displacement over $t\\in [\\frac{\\pi }{2},\\pi ].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\pi )=x(\\frac{\\pi }{2})+{\\int }_{\\pi /2}^{\\pi }v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\pi ) & =5+{\\int }_{\\pi /2}^{\\pi }(\\operatorname{cos}⁡(t)-\\operatorname{sin}⁡(t))\\,\\text{d}t \\\\  & =5+{[\\operatorname{sin}⁡(t)+\\operatorname{cos}⁡(t)]}_{\\pi /2}^{\\pi } \\\\  & =5+[\\operatorname{sin}⁡(\\pi )+\\operatorname{cos}⁡(\\pi )]-[\\operatorname{sin}⁡(\\frac{\\pi }{2})+\\operatorname{cos}⁡(\\frac{\\pi }{2})) \\\\  & =5+(0-1)-(1+0) \\\\  & =5-2 \\\\  & =3.\\end{aligned}\n$$\n\nSo, the position of the particle at $t=\\pi $ is $x=3.$"}] [{:db/id #edb/ref 17592186317120 :knowledge-point/_questions [{:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d3d6a6f4-5207-5d1e-b17c-8fdb9cb76df7" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186317122}] :answer-field/correct {:answer/id #uuid "d3d6a6f4-5207-5d1e-b17c-8fdb9cb76df7" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186317122} :answer-field/id #uuid "646bf74a-2efd-599c-84e7-ef18756f9212" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186317121}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cef565e7-787d-578b-a8be-b1fe99f0a51c" :question/math-academy-id "q-351472" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041143/assets/a3fb5a3a6102485294de519cc1372b7a348235317336a1d4c7fdbcf88be019b2.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=3,$ the particle is located at the position $x=3.$ What is the position of the particle at time $t=7?$\n\nThe position of the particle at $t=7$ is $x=$\n{{field-1}}." :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=3$ plus the total displacement over $t\\in [3,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(3)+{\\int }_{3}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(3)=3$, and we can compute the integral ${\\int }_{3}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=3$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{3}^{7}v(t)\\,\\text{d}t=8.\n$$\n\nTherefore,\n\n$$\nx(7)=3+8=11.\n$$\n\nSo the position of the particle at $t=7$ is $x=11.$"}] [{:db/id #edb/ref 17592186317123 :knowledge-point/_questions [{:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7" :knowledge-point/title "Finding the Final Position of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de45d70e-3a87-5e14-908f-e023cfbc45d1" :answer/type {:db/ident :answer.type/math} :answer/value "e+2" :db/id #edb/ref 17592186317125} {:answer/id #uuid "bf28dac6-5262-5ef8-ae61-260c80d0852a" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186317126} {:answer/id #uuid "0116b71d-c4f0-5ff8-b474-601f05d618d6" :answer/type {:db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186317127} {:answer/id #uuid "af1f8aef-223b-5f91-b856-ac95f42bf92c" :answer/type {:db/ident :answer.type/math} :answer/value "e" :db/id #edb/ref 17592186317128} {:answer/id #uuid "d2213493-201f-5d6c-8c92-575820b9fe79" :answer/type {:db/ident :answer.type/math} :answer/value "2e+1" :db/id #edb/ref 17592186317129}] :answer-field/correct {:answer/id #uuid "0116b71d-c4f0-5ff8-b474-601f05d618d6" :answer/type {:db/ident :answer.type/math} :answer/value "e+1" :db/id #edb/ref 17592186317127} :answer-field/id #uuid "b8f4b06a-af27-5068-b635-d916b5e1842c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317124}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "301e0eb4-35d3-5c4c-920a-0903dcd0b3ba" :question/math-academy-id "q-84265" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t>0$ is given by $v(t)={e}^{t-1}.$ At time $t=1$ the particle is located at the position $x=2.$ What is the position of the particle at time $t=2?$" :question/worked-solution "The position of the particle at $t=2$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,2].$ Therefore, we can calculate it as follows:\n\n$$\nx(2)=x(1)+{\\int }_{1}^{2}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(2) & =2+{\\int }_{1}^{2}{e}^{t-1}\\,\\text{d}t \\\\  & =2+{[{e}^{t-1}]}_{1}^{2} \\\\  & =2+({e}^{2-1}-{e}^{1-1}) \\\\  & =2+({e}^{1}-{e}^{0}) \\\\  & =2+e-1 \\\\  & =e+1.\\end{aligned}\n$$\n\nSo the position of the particle at $t=2$ is $x=e+1.$"}] [{:db/id #edb/ref 17592186317130 :knowledge-point/_questions [{:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fe5b2e3f-7cc7-550b-897f-6de4216debe6" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186317132} {:answer/id #uuid "74ae7088-6055-5940-9f0c-e7121192ef9c" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186317133} {:answer/id #uuid "0f184e21-f844-5c87-b7b1-1c3954a16364" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186317134} {:answer/id #uuid "fa3b5596-dc38-5579-86e5-675eb4daceb4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317135} {:answer/id #uuid "a79d0f03-8c04-5e01-8e8c-91a0bde2879f" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186317136}] :answer-field/correct {:answer/id #uuid "fa3b5596-dc38-5579-86e5-675eb4daceb4" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317135} :answer-field/id #uuid "9d90e7e1-bf4c-5f1b-a5d7-0b35efe79405" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317131}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "7e318d6a-aa1e-5cdd-b7ae-c05a16f91087" :question/math-academy-id "q-84315" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041143/assets/b2fbcc246230bd88e58d7928384a6d09966e37af63879775470fb58dd5005582.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At the time $t=1$ the particle is located at the position $x=4.$ What is the position of the particle at time $t=7?$" :question/worked-solution "The position of the particle at $t=7$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,7].$ Therefore, we can calculate it as follows:\n\n$$\nx(7)=x(1)+{\\int }_{1}^{7}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(1)=4,$ and we can compute the integral ${\\int }_{1}^{7}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=1$ to $t=7.$ Computing the signed area, we get\n\n$$\n{\\int }_{1}^{7}v(t)\\,\\text{d}t=-3.\n$$\n\nTherefore,\n\n$$\nx(7)=4+(-3)=1\n$$\n\nSo the position of the particle at $t=7$ is $x=1.$"}] [{:db/id #edb/ref 17592186317137 :knowledge-point/_questions [{:knowledge-point/id #uuid "089120d4-b37b-5936-8ea4-b68848290606" :knowledge-point/title "Finding the Final Position of a Particle Given a Velocity-Time Graph"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e23e9cf-a1a2-5ce8-8e28-c602d8f237cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186317139} {:answer/id #uuid "14f89910-8999-52fd-a658-5957a2312c8b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186317140} {:answer/id #uuid "b19b9234-1901-5017-99b2-221b5b944a1c" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186317141} {:answer/id #uuid "376700d4-a463-5671-bfa8-65971b99e8a9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186317142} {:answer/id #uuid "b0334e94-64a0-588b-a1e7-40db17fbca4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186317143}] :answer-field/correct {:answer/id #uuid "b0334e94-64a0-588b-a1e7-40db17fbca4b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186317143} :answer-field/id #uuid "150ab9af-5f77-563f-a837-d45b6949f8c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317138}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "263d6caa-9164-5db2-8f9b-c84178662d9f" :question/math-academy-id "q-84316" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041143/assets/2743c66fc9181611e3095b736d7d5021e43eafcd2e6639766ef5e65fa7779018.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=1$ the particle is located at the position $x=1.$ What is the position of the particle at time $t=6?$" :question/worked-solution "The position of the particle at $t=6$ is equal to its position at $t=1$ plus the total displacement over $t\\in [1,6].$ Therefore, we can calculate it as follows:\n\n$$\nx(6)=x(1)+{\\int }_{1}^{6}v(t)\\,\\text{d}t\n$$\n\nWe are told that $x(1)=1$, and we can compute the integral ${\\int }_{1}^{6}v(t)\\,\\text{d}t$ by finding the signed area under the graph from $t=1$ to $t=6.$ Computing the signed area, we get\n\n$$\n{\\int }_{1}^{6}v(t)\\,\\text{d}t=\\frac{1}{2}.\n$$\n\nTherefore,\n\n$$\nx(6)=1+\\frac{1}{2}=\\frac{3}{2}\n$$\n\nSo the position of the particle at $t=6$ is $x=\\frac{3}{2}.$"}]}
