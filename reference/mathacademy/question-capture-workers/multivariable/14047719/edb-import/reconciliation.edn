demy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-152875" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{10}{\\operatorname{ln}⁡(5)}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351416" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x=$\n\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351416" "field" nil "attribute" "question/worked-solution" "value" "First, let's recall the following result:\n\n$$\n\\int {b}^{\\,px+q}\\,\\text{d}x=\\frac{1}{p\\operatorname{ln}⁡(b)}{b}^{\\,px+q}+C\n$$\n\nWe proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{1}{2}^{3x-1}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{{2}^{3x}}{6\\operatorname{ln}⁡(2)}]}_{a}^{1} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot {lim}_{a\\to -\\infty }{[{2}^{3x}]}_{a}^{1} \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot {lim}_{a\\to -\\infty }(8-{2}^{3a}) \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-{lim}_{a\\to -\\infty }{2}^{3a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={2}^{3x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{2}^{3x}=0$\n\n- ${lim}_{x\\to \\infty }{2}^{3x}=\\infty $\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/assets/c2af905a46cea7b7512a727a5e53a2a178e4902f7114f86439365684e6685efa.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{1}{2}^{3x-1}\\,\\text{d}x & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-{lim}_{a\\to -\\infty }{2}^{3a}) \\\\  & =\\frac{1}{6\\operatorname{ln}⁡(2)}\\cdot (8-0) \\\\  & =\\frac{4}{3\\operatorname{ln}⁡(2)}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351416" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/activity-metadata.json" "file_sha256" "6a15390178eee87ca05d2f3502c32a44baa8c6e4266127e91909847ae46cbc72" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351416" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351416" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{3\\ln(2)}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-152876" "field" nil "attribute" "question/problem" "value" "${\\int }_{-\\infty }^{0}4\\cdot {6}^{x}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-152876" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}4\\cdot {6}^{x}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}4\\cdot {6}^{x}\\,\\text{d}x \\\\  & =4\\cdot {lim}_{a\\to -\\infty }{[\\frac{{6}^{x}}{\\operatorname{ln}⁡(6)}]}_{a}^{0} \\\\  & =4\\cdot \\frac{1}{\\operatorname{ln}⁡(6)}\\cdot {lim}_{a\\to -\\infty }{[{6}^{x}]}_{a}^{0} \\\\  & =\\frac{4}{\\operatorname{ln}⁡(6)}\\cdot {lim}_{a\\to -\\infty }({6}^{0}-{6}^{a}) \\\\  & =\\frac{4}{\\operatorname{ln}⁡(6)}\\cdot (1-{lim}_{a\\to -\\infty }{6}^{a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={6}^{x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{6}^{x}=0$\n\n- ${lim}_{x\\to \\infty }{6}^{x}=\\infty $\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/assets/2ebee84cf543b25e56b360f145459696554a3b67daaf64c21812cb4b92fa420a.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}4\\cdot {6}^{x}\\,\\text{d}x & =\\frac{4}{\\operatorname{ln}⁡(6)}\\cdot (1-{lim}_{a\\to -\\infty }{6}^{a}) \\\\  & =\\frac{4}{\\operatorname{ln}⁡(6)}\\cdot (1-0) \\\\  & =\\frac{4}{\\operatorname{ln}⁡(6)}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-152876" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/activity-metadata.json" "file_sha256" "6a15390178eee87ca05d2f3502c32a44baa8c6e4266127e91909847ae46cbc72" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-152876" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Dev