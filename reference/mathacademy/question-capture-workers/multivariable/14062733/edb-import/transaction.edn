[{:db/id "q-6034/selection/492fee7fe1fe5c63c6bab2abc4c1423d56f08bc05ef1c2fd22a1d3da4c09b3d3" :answer/id #uuid "78a8ccb5-5882-5d5a-bf1b-893e15a88191" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(6)" :db/ensure [:answer/validate]} {:db/id "q-6034/selection/611bf93b78b7d249c81df9b2cef2a87689612fe28e2d5d6d403b24eda8b26573" :answer/id #uuid "a5f9695a-e78a-5566-9143-174a34c22be9" :answer/type :answer.type/math :answer/value "{e}^{6}" :db/ensure [:answer/validate]} {:db/id "q-6034/selection/890d246f3214eb6f10d93316b079eea15553d72a53ee4588de5f2989f223930b" :answer/id #uuid "f95b6f3b-549c-5e6e-9473-f8cac9aba03f" :answer/type :answer.type/math :answer/value "6\\operatorname{ln}⁡(6)" :db/ensure [:answer/validate]} {:db/id "q-6034/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" :answer/id #uuid "1dc00b9d-8d41-54f5-8b6a-46558c84a63a" :answer/type :answer.type/text :answer/value "The integral diverges" :db/ensure [:answer/validate]} {:db/id "q-6034/selection/02b2842195510c4849aa074cdb96789ffc017c113fc9b248ef69f21c1e97cb60" :answer/id #uuid "a26682fb-7cd1-5d2e-bcbd-26d484c1dc93" :answer/type :answer.type/math :answer/value "\\frac{1}{\\operatorname{ln}⁡(6)}" :db/ensure [:answer/validate]} {:db/id "q-6034/selection" :answer-field/id #uuid "a03e1142-93be-5384-8df4-1fd0c4b8f633" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-6034/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" :answer-field/choices ["q-6034/selection/492fee7fe1fe5c63c6bab2abc4c1423d56f08bc05ef1c2fd22a1d3da4c09b3d3" "q-6034/selection/611bf93b78b7d249c81df9b2cef2a87689612fe28e2d5d6d403b24eda8b26573" "q-6034/selection/890d246f3214eb6f10d93316b079eea15553d72a53ee4588de5f2989f223930b" "q-6034/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" "q-6034/selection/02b2842195510c4849aa074cdb96789ffc017c113fc9b248ef69f21c1e97cb60"] :db/ensure [:answer-field/validate]} {:db/id "q-6034" :question/id #uuid "5520fa3a-7402-5c25-853c-0b46915bd183" :question/math-academy-id "q-6034" :question/problem "Evaluate ${\\int }_{6}^{\\infty }\\frac{\\text{d}z}{z}.$" :question/worked-solution "We proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{6}^{\\infty }\\frac{\\text{d}z}{z} & ={lim}_{a\\to \\infty }{\\int }_{6}^{a}\\frac{\\text{d}z}{z} \\\\  & ={lim}_{a\\to \\infty }{[\\operatorname{ln}⁡z]}_{6}^{a} \\\\  & ={lim}_{a\\to \\infty }(\\operatorname{ln}⁡a-\\operatorname{ln}⁡6) \\\\  & =\\infty -\\operatorname{ln}⁡6 \\\\  & =\\infty .\\end{aligned}\n$$\n\nTherefore, the integral is divergent." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-6034/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dc6d9b69-0459-515a-ba7b-c62cab96ca00"] :knowledge-point/questions ["q-6034"] :db/ensure [:knowledge-point/validate]} {:db/id "q-152779/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "9b12a8a8-2a3d-5bb4-8175-8631655f718b" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-152779/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "2d4af8ae-06d1-5267-b6bb-a7b51c84c0cd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-152779/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "788b2813-f86c-592d-ae92-b9ba3f8d43bf" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-152779/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" :answer/id #uuid "7837b34f-2f07-5eb6-bb96-40fc9c40bacf" :answer/type :answer.type/text :answer/value "The integral diverges" :db/ensure [:answer/validate]} {:db/id "q-152779/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "12f87729-5188-5272-a77b-3ec75fe4c548" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-152779/selection" :answer-field/id #uuid "a7af7e8f-410f-5568-b4b7-4ff308fc9746" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-152779/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-152779/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-152779/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-152779/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-152779/selection/3be4a0b33d8ae752fcff4e19cc6abeec9ea0ac2c8234b469f7c7959c2008fb10" "q-152779/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-152779" :question/id #uuid "2bdb7d52-6816-5912-9b60-a3ec899e692c" :question/math-academy-id "q-152779" :question/problem "Evaluate ${\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z.$" :question/worked-solution "First, we substitute $u=z+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}z}=1\\,⟹\\,\\text{d}u=\\text{d}z.\n$$\n\nSince $u\\to \\infty $ when $z\\to \\infty ,$ the table for the limits of integration using the rule $u=z+2$ is as follows:\n\n| $z$ | $-1$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z={\\int }_{1}^{\\infty }\\frac{6}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{\\infty }\\frac{6}{(z+2)^{4}}\\,\\text{d}z & ={\\int }_{1}^{\\infty }\\frac{6}{{u}^{4}}\\,\\text{d}u \\\\  & =6{\\int }_{1}^{\\infty }{u}^{-4}\\,\\text{d}u \\\\  & =6{lim}_{a\\to \\infty }{\\int }_{1}^{a}{u}^{-4}\\,\\text{d}u \\\\  & =6{lim}_{a\\to \\infty }{[-\\frac{1}{3}{u}^{-3}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }{[\\frac{1}{{u}^{3}}]}_{1}^{a} \\\\  & =-2\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{1}^{3}}] \\\\  & =-2\\cdot (0-1) \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-152779/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2"] :knowledge-point/questions ["q-152779"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350530/field-1/91770ccf162a6a2f9a38c78b34c4dafd213970248b0d982a9e67494fa70b3027" :answer/id #uuid "b2c3c665-cc9a-5fff-8971-f38b9bf3a039" :answer/type :answer.type/math :answer/value "\\frac{5}{72}" :db/ensure [:answer/validate]} {:db/id "q-350530/field-1" :answer-field/id #uuid "992bab60-b4dd-5f0b-8e4f-9e0847c08eff" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350530/field-1/91770ccf162a6a2f9a38c78b34c4dafd213970248b0d982a9e67494fa70b3027" :answer-field/choices ["q-350530/field-1/91770ccf162a6a2f9a38c78b34c4dafd213970248b0d982a9e67494fa70b3027"] :db/ensure [:answer-field/validate]} {:db/id "q-350530" :question/id #uuid "8ae06e11-3b4b-55e3-b2a5-df274e7748c0" :question/math-academy-id "q-350530" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{5}{(3y+2)^{4}}\\,\\text{d}y=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=3y+2.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}y}=3\\,⟹\\,\\text{d}u=3\\text{d}y.\n$$\n\nSince $u\\to \\infty $ when $y\\to \\infty ,$ the table for the limits of integration using the rule $u=3y+2$ is as follows:\n\n| $y$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $2$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{0}^{\\infty }\\frac{5}{(3y+2)^{4}}\\,\\text{d}y={\\int }_{2}^{\\infty }\\frac{5}{3{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{5}{(3y+2)^{4}}\\,\\text{d}y & ={\\int }_{2}^{\\infty }\\frac{5}{3{u}^{4}}\\,\\text{d}u \\\\  & ={\\int }_{2}^{\\infty }\\frac{5}{3}{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{\\int }_{2}^{a}\\frac{5}{3}{u}^{-4}\\,\\text{d}u \\\\  & ={lim}_{a\\to \\infty }{[-\\frac{5}{9}{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{5}{9}\\cdot {lim}_{a\\to \\infty }{[{u}^{-3}]}_{2}^{a} \\\\  & =-\\frac{5}{9}\\cdot {lim}_{a\\to \\infty }[\\frac{1}{{a}^{3}}-\\frac{1}{{2}^{3}}] \\\\  & =-\\frac{5}{9}\\cdot (0-\\frac{1}{8}) \\\\  & =\\frac{5}{72}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350530/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6dc2621a-77e1-56d9-af63-1917eaa933b2"] :knowledge-point/questions ["q-350530"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350537/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b759741e-626a-55a5-900e-5ca9e82faa79" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-350537/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "5e50c56f-77c5-5a66-b782-c86e1ab0654a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-350537/field-1" :answer-field/id #uuid "17eae316-3906-51b2-9fb9-d1269dd02d65" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350537/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-350537/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-350537/field-1/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-350537" :question/id #uuid "cda1b2de-8da8-517b-8487-2e8df17cbd49" :question/math-academy-id "q-350537" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{-1}\\frac{10}{{x}^{6}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{10}{{x}^{6}}\\,\\text{d}x & =10{lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{x}^{-6}\\,\\text{d}x \\\\  & =10{lim}_{a\\to -\\infty }{[-\\frac{1}{5}{x}^{-5}]}_{a}^{-1} \\\\  & =-2\\cdot {lim}_{a\\to -\\infty }{[\\frac{1}{{x}^{5}}]}_{a}^{-1} \\\\  & =-2\\cdot {lim}_{a\\to -\\infty }[\\frac{1}{(-1)^{5}}-\\frac{1}{{a}^{5}}] \\\\  & =-2\\cdot (-1-0) \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-350537/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12"] :knowledge-point/questions ["q-350537"] :db/ensure [:knowledge-point/validate]} {:db/id "q-350540/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "ebd16e4a-4baa-5c3f-a524-6ab7eee1bd16" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-350540/field-1" :answer-field/id #uuid "86451857-4f62-5366-a9bb-5f09fd21119e" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-350540/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-350540/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-350540" :question/id #uuid "57d778df-49ba-5f2a-8974-783c558a308f" :question/math-academy-id "q-350540" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{-1}\\frac{6}{(2x+1)^{4}}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "First, we substitute $u=2x+1.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}u=2\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u=2x+1$ is as follows:\n\n| $x$ | $-\\infty $ | $-1$ |\n| --- | --- | --- |\n| $u$ | $-\\infty $ | $-1$ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{-1}\\frac{6}{(2x+1)^{4}}\\,\\text{d}x={\\int }_{-\\infty }^{-1}\\frac{3}{{u}^{4}}\\,\\text{d}u\n$$\n\nFinally, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{-1}\\frac{3}{{u}^{4}}\\,\\text{d}u & =3{lim}_{a\\to -\\infty }{\\int }_{a}^{-1}{u}^{-4}\\,\\text{d}u \\\\  & =3{lim}_{a\\to -\\infty }{[-\\frac{1}{3}{u}^{-3}]}_{a}^{-1} \\\\  & =-{lim}_{a\\to -\\infty }{[\\frac{1}{{u}^{3}}]}_{a}^{-1} \\\\  & =-{lim}_{a\\to -\\infty }[\\frac{1}{(-1)^{3}}-\\frac{1}{{a}^{3}}] \\\\  & =-(-1-0) \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-350540/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "39a476b5-eacc-59c1-9d16-fc0675e3bc12"] :knowledge-point/questions ["q-350540"] :db/ensure [:knowledge-point/validate]}]
