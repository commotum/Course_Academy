[{:db/id "q-48719/selection/ade01094fff56ae768867e0cdb3fa01e3f91ffa167f5c7e644edf7129c122373" :answer/id #uuid "ececdeec-8160-5276-9f68-f0e0d45450c8" :answer/type :answer.type/math :answer/value "\\frac{{l}^{3}}{3}" :db/ensure [:answer/validate]} {:db/id "q-48719/selection/61ea062955cb0cf9e117f5a37ab335785ad25bda28fdb46d84b309c9e4f525f2" :answer/id #uuid "8f768e2d-a1e8-56c7-a93c-031601a54e07" :answer/type :answer.type/math :answer/value "2l" :db/ensure [:answer/validate]} {:db/id "q-48719/selection/643865ba56fc113af2f4a8a792214b14162ca842e6717b3efd85c2885837d41f" :answer/id #uuid "af472d1f-97c9-5a79-bc15-1a6b1670675b" :answer/type :answer.type/math :answer/value "l" :db/ensure [:answer/validate]} {:db/id "q-48719/selection/8f738b3765cc9144fae4b5191884f6b7c9e7fc9d2c1ab224bc13574164c297ec" :answer/id #uuid "bd0e5dd0-370a-5029-bd3a-8602ec423e39" :answer/type :answer.type/math :answer/value "\\frac{l}{2}" :db/ensure [:answer/validate]} {:db/id "q-48719/selection/f3ced9f3ba9d330919fed060189c581214e7b5d933cec1c9de8f4fc44b4d594d" :answer/id #uuid "dd867a6a-4d54-5c05-81a2-d9e7c961c291" :answer/type :answer.type/math :answer/value "{l}^{2}" :db/ensure [:answer/validate]} {:db/id "q-48719/selection" :answer-field/id #uuid "4d013116-27c0-5024-a993-b98b4219b78b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-48719/selection/61ea062955cb0cf9e117f5a37ab335785ad25bda28fdb46d84b309c9e4f525f2" :answer-field/choices ["q-48719/selection/ade01094fff56ae768867e0cdb3fa01e3f91ffa167f5c7e644edf7129c122373" "q-48719/selection/61ea062955cb0cf9e117f5a37ab335785ad25bda28fdb46d84b309c9e4f525f2" "q-48719/selection/643865ba56fc113af2f4a8a792214b14162ca842e6717b3efd85c2885837d41f" "q-48719/selection/8f738b3765cc9144fae4b5191884f6b7c9e7fc9d2c1ab224bc13574164c297ec" "q-48719/selection/f3ced9f3ba9d330919fed060189c581214e7b5d933cec1c9de8f4fc44b4d594d"] :db/ensure [:answer-field/validate]} {:db/id "q-48719" :question/id #uuid "062fcd02-d338-5b14-8c30-fb2aac436416" :question/math-academy-id "q-48719" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14066378/assets/2b5d589462bf2477be3d305ea88f3d5462b7d6ea4e001a9a71790d53e1683665.png)\n\nThe area of the square above is increasing. The length of the side of the square is $l.$ Find the rate of change of the area of a square with respect to the length of its side." :question/worked-solution "The area of the square is given by \n\n$$\nA=A(l)={l}^{2}\n$$\n\nwhere $l$ is the length of the side of the square.\n\nTherefore, the rate of change of $A(l)$ with respect to $l$ is\n\n$$\n\\begin{aligned}{A}^{′}(l) & =\\frac{\\text{d}}{\\text{d}l}({l}^{2})=2l.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-48719/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20b289d4-96a7-5d1b-9714-6afabab4804d"] :knowledge-point/questions ["q-48719"] :db/ensure [:knowledge-point/validate]} {:db/id "q-170656/selection/6d4063a8b92e2aa2375fcf2caaac07e0f989b06594b056b766b7427621f5b051" :answer/id #uuid "160e7109-21ba-583a-bf44-dddea22b35d1" :answer/type :answer.type/math :answer/value "3b" :db/ensure [:answer/validate]} {:db/id "q-170656/selection/99effbe3b54b67baaeb34a2eb94e44b1dcbaf2c3b1f7559b7514b772090e3081" :answer/id #uuid "3cbe346f-7894-54d3-afe6-23233fd890e5" :answer/type :answer.type/math :answer/value "b" :db/ensure [:answer/validate]} {:db/id "q-170656/selection/0300610cc31227047092ab4cb0eba6767eb5b86d857871f70b01a905cbe3e26e" :answer/id #uuid "4e83a5ba-83b1-5620-9b77-a5f9ceca89a3" :answer/type :answer.type/math :answer/value "4{b}^{2}" :db/ensure [:answer/validate]} {:db/id "q-170656/selection/d4ef20a6d036ea20b9af35b4bd6e015d3916cccb324627786f7ce687c1e91740" :answer/id #uuid "31500ce3-c0a2-5695-87c2-0cbd39a07e50" :answer/type :answer.type/math :answer/value "{b}^{2}" :db/ensure [:answer/validate]} {:db/id "q-170656/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "6f252992-bbb8-5043-9dda-2fb3232020cc" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-170656/selection" :answer-field/id #uuid "0d012542-7176-595f-bd94-312364df2fb2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-170656/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-170656/selection/6d4063a8b92e2aa2375fcf2caaac07e0f989b06594b056b766b7427621f5b051" "q-170656/selection/99effbe3b54b67baaeb34a2eb94e44b1dcbaf2c3b1f7559b7514b772090e3081" "q-170656/selection/0300610cc31227047092ab4cb0eba6767eb5b86d857871f70b01a905cbe3e26e" "q-170656/selection/d4ef20a6d036ea20b9af35b4bd6e015d3916cccb324627786f7ce687c1e91740" "q-170656/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-170656" :question/id #uuid "334676cf-0dd1-5735-bc6e-72eb49b9359e" :question/math-academy-id "q-170656" :question/problem "The bases of a trapezoid are increasing and the larger base is always twice the smaller base. The height of the trapezoid is $2\\,cm.$ Find the rate of change of the area of the trapezoid with respect to its smaller base $b.$" :question/worked-solution "The area of a trapezoid is given by \n\n$$\nA=\\frac{(B+b)h}{2},\n$$\n\n where $b$ is the smaller base, $B$ is the larger base and $h$ is the height of the trapezoid.\n\nWe are given that $B=2b$ and $h=2,$ so we can express the area $A$ as a function of the base $b$ by substituting $B=2b$ and $h=2$ in the formula above. We get\n\n$$\nA=\\frac{(b+2b)(2)}{2}=3b.\n$$\n\nTherefore, the rate of change of $A(b)$ with respect to $b$ is\n\n$$\n\\begin{aligned}{A}^{′}(b) & =\\frac{\\text{d}}{\\text{d}b}(3b) \\\\  & =3\\frac{\\text{d}}{\\text{d}b}(b) \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-170656/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20b289d4-96a7-5d1b-9714-6afabab4804d"] :knowledge-point/questions ["q-170656"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343169/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "1977d7ab-32a5-5fc2-9e99-bb39ba2991b6" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-343169/field-1" :answer-field/id #uuid "9a0248ff-1b8b-5b69-9237-e6c5c4d2985f" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-343169/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-343169/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-343169" :question/id #uuid "750bc4e7-798f-5eba-ad9f-61537ac1f813" :question/math-academy-id "q-343169" :question/problem "Air is pumped into and released from a pressurized chamber. After $t$ minutes, the volume of air (in cubic meters) is modeled by\n\n$$\nA(t)=-6{t}^{2}+90t+400,\\,0\\le t\\le 15.\n$$\n\nFind the exact value of the instantaneous rate of change of the air volume with respect to time when $t=7$ minutes.\n\nThe instantaneous rate of change when $t=7$ minutes is\n{{field-1}} cubic meters per minute." :question/worked-solution "The instantaneous rate of change of the air volume at $t=7$ minutes is ${A}^{′}(7).$\n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{A}^{′}(t) & =\\frac{d}{dt}\\,(-6{t}^{2}+90t+400) \\\\  & =-12t+90.\\end{aligned}\n$$\n\nNow, substituting $t=7,$ we get\n\n$$\n\\begin{aligned}{A}^{′}(7) & =-12(7)+90 \\\\  & =-84+90 \\\\  & =6.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change of the air volume at $t=7$ minutes is $6$ cubic meters per minute." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-343169/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dff5ec0b-1456-5231-94e1-0fc5923d6672"] :knowledge-point/questions ["q-343169"] :db/ensure [:knowledge-point/validate]} {:db/id "q-343404/field-1/f594cbbb4a66bc41743b074d8df31c04839068c3f93c44ebcfba00b647948a3b" :answer/id #uuid "08961285-718b-541f-a56a-3caea667241f" :answer/type :answer.type/math :answer/value "\\frac{1}{20}" :db/ensure [:answer/validate]} {:db/id "q-343404/field-1/09f9568b9032a258744b73b08553a45679ce3baf10e1847349ddb9cf78a3d261" :answer/id #uuid "4b4fd285-19ee-5346-a08a-1a8483262811" :answer/type :answer.type/math :answer/value "\\frac{1}{10}" :db/ensure [:answer/validate]} {:db/id "q-343404/field-1" :answer-field/id #uuid "5b5419fb-8feb-57fd-b6a6-8e84ce71fbab" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-343404/field-1/f594cbbb4a66bc41743b074d8df31c04839068c3f93c44ebcfba00b647948a3b" :answer-field/choices ["q-343404/field-1/f594cbbb4a66bc41743b074d8df31c04839068c3f93c44ebcfba00b647948a3b" "q-343404/field-1/09f9568b9032a258744b73b08553a45679ce3baf10e1847349ddb9cf78a3d261"] :db/ensure [:answer-field/validate]} {:db/id "q-343404" :question/id #uuid "42884ae8-06df-563a-81bb-8d8c47e48c56" :question/math-academy-id "q-343404" :question/problem "The depth $D,$ in meters, of a plant’s root system after $t$ months is modeled by $D(t)=\\frac{1}{4}\\sqrt{2t+13}.$ What is the instantaneous rate of change of the root depth when $t=6$ months?\n\nThe instantaneous rate of change when $t=6$ months is\n{{field-1}} meters per month." :question/worked-solution "The instantaneous rate of change of the root depth when $t=6$ months is equal to ${D}^{′}(6).$ \n\nFirst, we take the derivative and get\n\n$$\n\\begin{aligned}{D}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{4}\\sqrt{2t+13}) \\\\  & =\\frac{1}{4}\\cdot \\frac{1}{2}\\cdot (2t+13)^{(1/2)-1}\\cdot 2 \\\\  & =\\frac{1}{4}(2t+13)^{-1/2}.\\end{aligned}\n$$\n\nNow, substituting $t=6,$ we get\n\n$$\n\\begin{aligned}{D}^{′}(6) & =\\frac{1}{4}(2(6)+13)^{-1/2} \\\\  & =\\frac{1}{4\\sqrt{25}} \\\\  & =\\frac{1}{20}.\\end{aligned}\n$$\n\nTherefore, the instantaneous rate of change of the root depth when $t=6$ months is $\\frac{1}{20}$ meters per month." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-343404/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dff5ec0b-1456-5231-94e1-0fc5923d6672"] :knowledge-point/questions ["q-343404"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-343499"] :question/worked-solution "We know that the surface area of a cube with side length $s$ is given by \n\n$$\nA=A(s)=6{s}^{2}.\n$$\n\nTaking the derivative, the rate of change of $A(s)$ with respect to $s$ is\n\n$$\n\\begin{aligned}{A}^{′}(s) & =\\frac{\\text{d}}{\\text{d}s}(6{s}^{2}) \\\\  & =6(2s) \\\\  & =12s,\\end{aligned}\n$$\n\nand evaluating at $s=3$ gives\n\n$$\n{A}^{′}(3)=12(3)=36.\n$$\n\nTherefore, the instantaneous rate at which the surface area of the cube is changing when its side length is $3\\,\\text{in}$, is $36$ ${\\text{in}}^{2}/\\text{in}.$" :db/ensure [:question/validate]}]
