/validate]} {:db/id "q-159613/selection/2a27776671deaba12c1b8a0bd17268835941ff6e6217cf93d3a91f29f8eb4a17" :answer/id #uuid "357125ad-3833-5f2f-926a-e5a44a0e170b" :answer/type :answer.type/math :answer/value "y+2x\\operatorname{ln}⁡y" :db/ensure [:answer/validate]} {:db/id "q-159613/selection/94d50d630c1e93772c378c3d157adf7ba8a30599c080f8ae5d0a86652f29adf6" :answer/id #uuid "5174d346-0e3a-5cee-9873-ebf98d7e5922" :answer/type :answer.type/math :answer/value "y+\\frac{2x}{y}" :db/ensure [:answer/validate]} {:db/id "q-159613/selection/3f4b7a8589ba87fa278375adc4d727486f1ee3da106738b25da87331981ace3c" :answer/id #uuid "ed8d7054-d04e-5335-a7aa-415ec9ac968e" :answer/type :answer.type/math :answer/value "x+\\frac{{x}^{2}}{y}" :db/ensure [:answer/validate]} {:db/id "q-159613/selection" :answer-field/id #uuid "037335cf-bdfb-5fbe-b72c-9551145780ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-159613/selection/3f4b7a8589ba87fa278375adc4d727486f1ee3da106738b25da87331981ace3c" :answer-field/choices ["q-159613/selection/d6611981909e79738e50a3e0138cd9109eef11278427b0b78e496302ad7ffd61" "q-159613/selection/673cc3497bd17ce30220a7932cbc9e1106850f6a6cd3dba2a7551f0e4d633ff7" "q-159613/selection/2a27776671deaba12c1b8a0bd17268835941ff6e6217cf93d3a91f29f8eb4a17" "q-159613/selection/94d50d630c1e93772c378c3d157adf7ba8a30599c080f8ae5d0a86652f29adf6" "q-159613/selection/3f4b7a8589ba87fa278375adc4d727486f1ee3da106738b25da87331981ace3c"] :db/ensure [:answer-field/validate]} {:db/id "q-159613" :question/id #uuid "0f5d5fa7-fec7-5274-8185-e140fc19c6ad" :question/math-academy-id "q-159613" :question/problem "Find $\\frac{∂f}{∂y}$ given that $f(x,y)=xy+{x}^{2}\\operatorname{ln}⁡y.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(xy+{x}^{2}\\operatorname{ln}⁡y) \\\\  & =\\frac{∂}{∂y}(xy)+\\frac{∂}{∂y}({x}^{2}\\operatorname{ln}⁡y) \\\\  & =x\\cdot \\frac{∂}{∂y}(y)+{x}^{2}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y) \\\\  & =x\\cdot 1+{x}^{2}\\cdot \\frac{1}{y} \\\\  & =x+\\frac{{x}^{2}}{y}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-159613/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9"] :knowledge-point/questions ["q-159613"] :db/ensure [:knowledge-point/validate]} {:db/id "q-159623/selection/14094d809016b122a741b06a2a2cae0b5f4a7fc9df25a080634552fb8fa013a8" :answer/id #uuid "b0a6be4b-f538-5142-84d1-c091ce15b534" :answer/type :answer.type/math :answer/value "6{e}^{2x+3y}+6x{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-159623/selection/0f24c69471dc9dc2634199693c4a59a13585454fa999e47a34cb45e0acd2e6e4" :answer/id #uuid "2858e9c6-24c1-5ffa-b291-f2cde0251007" :answer/type :answer.type/math :answer/value "3{e}^{2x+3y}+6x{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-159623/selection/006477754dbf1f841a2861ce8a79da222714c4effdef2a6e14958c58aa460c8a" :answer/id #uuid "661162e3-29b9-5070-b602-c9c69283e4f9" :answer/type :answer.type/math :answer/value "{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-159623/selection/a9cc11bbaea2f93c1532e4688d9f00e1a782a697dbc000443230dca4b7c4b8ce" :answer/id #uuid "d0ddf655-5d7e-508e-a62b-dd839ad9c805" :answer/type :answer.type/math :answer/value "3{e}^{2x+3y}+3{x}^{2}{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-159623/selection/e8175f84ff93a9401cc6e8cb5d5651cb7aa45f9df781c72552f3c315be2c5c34" :answer/id #uuid "f1773c6a-09ba-52cb-8b51-2b9cf26c9154" :answer/type :answer.type/math :answer/value "2{e}^{2x+3y}+2x{y}^{3}" :db/ensure [:answer/validate]} {:db/id "q-159623/selection" :answer-field/id #uuid "689057ca-6f2e-52a3-a9d7-194165093b78" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-159623/selection/a9cc11bbaea2f93c1532e4688d9f00e1a782a697dbc000443230dca4b7c4b8ce" :answer-field/choices ["q-159623/selection/14094d809016b122a741b06a2a2cae0b5f4a7fc9df25a080634552fb8fa013a8" "q-159623/selection/0f24c69471dc9dc2634199693c4a59a13585454fa999e47a34cb45e0acd2e6e4" "q-159623/selection/006477754dbf1f841a2861ce8a79da222714c4effdef2a6e14958c58aa460c8a" "q-159623/selection/a9cc11bbaea2f93c1532e4688d9f00e1a782a697dbc000443230dca4b7c4b8ce" "q-159623/selection/e8175f84ff93a9401cc6e8cb5d5651cb7aa45f9df781c72552f3c315be2c5c34"] :db/ensure [:answer-field/validate]} {:db/id "q-159623" :question/id #uuid "dfa081e6-eae3-55c1-8810-551ff3bada92" :question/math-academy-id "q-159623" :question/problem "Find ${f}_{y}(x,y)$ for $f(x,y)={e}^{2x+3y}+{x}^{2}{y}^{3}.$" :question/worked-solution "The notation ${f}_{y}$ denotes the partial derivative of $f$ with respect to $y.$\n\nWe differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum rule for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{y}(x,y) & =\\frac{∂}{∂y}({e}^{2x+3y}+{x}^{2}{y}^{3}) \\\\  & =\\frac{∂}{∂y}({e}^{2x}\\cdot {e}^{3y})+\\frac{∂}{∂y}({x}^{2}{y}^{3}) \\\\  & ={e}^{2x}\\cdot \\frac{∂}{∂y}({e}^{3y})+{x}^{2}\\cdot \\frac{∂}{∂y}({y}^{3}) \\\\  & ={e}^{2x}\\cdot 3{e}^{3y}+{x}^{2}\\cdot 3{y}^{2} \\\\  & =3{e}^{2x+3y}+3{x}^{2}{y}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-159623/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9"] :knowledge-point/questions ["q-159623"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-35709"] :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x,y)={x}^{2}\\operatorname{sin}⁡y+xy.$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}\\operatorname{sin}⁡y+xy) \\\\  & =\\frac{∂}{∂x}({x}^{2}\\operatorname{sin}⁡y)+\\frac{∂}{∂x}(xy) \\\\  & =\\operatorname{sin}⁡y\\cdot \\frac{∂}{∂x}({x}^{2})+y\\cdot \\frac{∂}{∂x}(x) \\\\  & =\\operatorname{sin}⁡y\\cdot (2x)+y\\cdot (1) \\\\  & =2x\\operatorname{sin}⁡y+y\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-159619/selection/6f69872c2eaf7413bd4fd3c033f2631af92b71d01c0dc1f9e914faec1dfe9fc7" :answer/id #uuid "b3716e1b-8b5e-53e5-841a-46fd58d79639" :answer/type :answer.type/math :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}-16y" :db/ensure [:answer/validate]} {:db/id "q-159619/selection/98ffb87576db561db9724fb589ce54dfa0237fcd654091775a3a945e840f88b4" :answer/id #uuid "c6cd2eea-0fbc-50dd-b35d-f19a54f43133" :answer/type :answer.type/math :answer/value "y\\operatorname{arcsin}⁡x" :db/ensure [:answer/validate]} {:db/id "q-159619/selection/a6bb2611e87387d1024e6895e431995789ba9571480b00cfb990b1a148a7da72" :answer/id #uuid "9c929630-1715-53c8-bc4a-2dd65e872c16" :answer/type :answer.type/math :answer/value "\\operatorname{arcsin}⁡x-16y" :db/ensure [:answer/validate]} {:db/id "q-159619/selection/739db2c244fddde59896e89e27a96d8872d23bdefa58bf1918297f4d998da9fb" :answer/id #uuid "e6c2071f-62e7-5140-8804-873d2d70b616" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{1-{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-159619/selection/1c24db2ea35de611d779d97da9d104a6c20c5bab9f2007610c5d789daa74ec73" :answer/id #uuid "c0e0cdff-fa61-5f7d-a4a3-bc49f775d199" :answer/type :answer.type/math :answer/value "\\frac{y}{\\sqrt{1-{x}^{2}}}" :db/ensure [:answer/validate]} {:db/id "q-159619/selection" :answer-field/id #uuid "cf634820-a0bd-5357-baa7-ac1d13b2431e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-159619/selection/1c24db2ea35de611d779d97da9d104a6c20c5bab9f2007610c5d789daa74ec73" :answer-field/choices ["q-159619/selection/6f69872c2eaf7413bd4fd3c033f2631af92b71d01c0dc1f9e914faec1dfe9fc7" "q-159619/selection/98ffb87576db561db9724fb589ce54dfa0237fcd654091775a3a945e840f88b4" "q-159619/selection/a6bb2611e87387d1024e6895e431995789ba9571480b00cfb990b1a148a7da72" "q-159619/selection/739db2c244fddde59896e89e27a96d8872d23bdefa58bf1918297f4d998da9fb" "q-159619/selection/1c24db2ea35de611d779d97da9d104a6c20c5bab9f2007610c5d789daa74ec73"] :db/ensure [:answer-field/validate]} {:db/id "q-159619" :question/id #uuid "84e45fe6-0b31-5027-8855-f065bf6bccdd" :question/math-academy-id "q-159619" :question/problem "Find ${f}_{x}(x,y)$ for $f(x,y)=y\\operatorname{arcsin}⁡x-8{y}^{2}.$" :question/worked-solution "The notation ${f}_{x}$ denotes the partial derivative of $f$ with respect to $x.$\n\nWe differentiate the given function with respect to $x,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x-8{y}^{2}) \\\\  & =\\frac{∂}{∂x}(y\\operatorname{arcsin}⁡x)-\\frac{∂}{∂x}(8{y}^{2}) \\\\  & =y\\cdot \\frac{∂}{∂x}(\\operatorname{arcsin}⁡x)-8{y}^{2}\\frac{∂}{∂x}(1) \\\\  & =y\\cdot \\frac{1}{\\sqrt{1-{x}^{2}}}-0 \\\\  & =\\frac{y}{\\sqrt{1-{x}^{2}}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-159619/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9"] :knowledge-point/questions ["q-159619"] :db/ensure [:knowledge-point/validate]} {:db/id "q-159616/selection/d489f99ff8153d2e37b931e6bfdf8372d87d814868ff2d7ae739cb45983a4b71" :answer/id #uuid "0ed2b6eb-a902-5d6c-92de-6bab00cf4774" :answer/type :answer.type/math :answer/value "\\frac{1}{y}+\\frac{2y}{{x}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-159616/selection/b3a09