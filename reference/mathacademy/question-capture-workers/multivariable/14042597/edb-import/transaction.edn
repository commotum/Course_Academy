53df1a"] :knowledge-point/questions ["q-159597"] :db/ensure [:knowledge-point/validate]} {:db/id "q-159599/selection/e1a79fe21dbd63050cc5b8abf7bbfe646e6735d60cb33653e6f487991ef831d5" :answer/id #uuid "245b39f9-d671-5a4d-85ed-460eb1fa7fd4" :answer/type :answer.type/math :answer/value "2e+1" :db/ensure [:answer/validate]} {:db/id "q-159599/selection/5a1fe28b022029f27455dc36a9cc0dbfd0eced1186649091706824f56db6ba8d" :answer/id #uuid "24161292-d0ce-5d89-a581-fa63fa194ae0" :answer/type :answer.type/math :answer/value "e+1" :db/ensure [:answer/validate]} {:db/id "q-159599/selection/32e65fe743d0d028abb30010be473c4445ce2177c6c283fcc4d5963ada5dca86" :answer/id #uuid "b527e5ca-c325-5f9c-92ac-a30e84694839" :answer/type :answer.type/math :answer/value "{e}^{2}+1" :db/ensure [:answer/validate]} {:db/id "q-159599/selection/8280aa14e5d75a82d6af9ae6ca5154ee33c6b48ca431ee02a2efa60ca575f25f" :answer/id #uuid "a6dd857d-6ffc-53da-a31f-9aefc3c97a1a" :answer/type :answer.type/math :answer/value "\\frac{1}{2}e+1" :db/ensure [:answer/validate]} {:db/id "q-159599/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6" :answer/id #uuid "daccc790-7f79-570b-b129-00cbe32f3d66" :answer/type :answer.type/math :answer/value "2e" :db/ensure [:answer/validate]} {:db/id "q-159599/selection" :answer-field/id #uuid "619af242-6a1e-5034-8f47-289c8e7bdfd9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-159599/selection/e1a79fe21dbd63050cc5b8abf7bbfe646e6735d60cb33653e6f487991ef831d5" :answer-field/choices ["q-159599/selection/e1a79fe21dbd63050cc5b8abf7bbfe646e6735d60cb33653e6f487991ef831d5" "q-159599/selection/5a1fe28b022029f27455dc36a9cc0dbfd0eced1186649091706824f56db6ba8d" "q-159599/selection/32e65fe743d0d028abb30010be473c4445ce2177c6c283fcc4d5963ada5dca86" "q-159599/selection/8280aa14e5d75a82d6af9ae6ca5154ee33c6b48ca431ee02a2efa60ca575f25f" "q-159599/selection/2a28a53216361474017108aa9cf0fffd0fb392524d53aeb00b78355e4fa703c6"] :db/ensure [:answer-field/validate]} {:db/id "q-159599" :question/id #uuid "00bfed32-600a-58a8-8ea5-69052d463a56" :question/math-academy-id "q-159599" :question/problem "For the function $f(x,y)={e}^{x}\\operatorname{ln}⁡y+{x}^{7}y,$ evaluate $\\frac{∂f}{∂y}$ at the point $(1,\\frac{1}{2}).$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y+{x}^{7}y) \\\\  & =\\frac{∂}{∂y}({e}^{x}\\operatorname{ln}⁡y)+\\frac{∂}{∂y}({x}^{7}y) \\\\  & ={e}^{x}\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+{x}^{7}\\cdot \\frac{∂}{∂y}(y) \\\\  & ={e}^{x}\\cdot (\\frac{1}{y})+{x}^{7}\\cdot (1) \\\\  & =\\frac{{e}^{x}}{y}+{x}^{7}\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(1,\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y}{|}_{(1,1/2)} & =\\frac{{e}^{1}}{(\\frac{1}{2})}+{1}^{7} \\\\  & =2e+1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-159599/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a"] :knowledge-point/questions ["q-159599"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-11045"] :question/problem "Given that $f(x,y) = y^2\\ln{x},$ express $\\dfrac{\\partial f}{\\partial x}$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit \n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0} \\left(\\dfrac{f(x+h,y)-f(x,y)}{h}\\right).\n$$\n\nSince $f(x) = y^2 \\ln{x},$  we have that \n\n$$\nf(x+h,y) = y^2\\ln(x+h).\n$$\n\nTherefore,\n\n$$\n\\displaystyle \\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0}\\left( \\dfrac{y^2\\ln(x+h) -y^2\\ln{x} }{h}\\right).\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-11026"] :question/problem "Find $\\dfrac{\\partial f}{\\partial y}$ given that $f(x,y) = 3x\\ln y + 2ye^x.$" :question/worked-solution "We differentiate the given function with respect to $y,$ treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y+2y{e}^{x}) \\\\  & =\\frac{∂}{∂y}(3x\\operatorname{ln}⁡y)+\\frac{∂}{∂y}(2y{e}^{x}) \\\\  & =3x\\cdot \\frac{∂}{∂y}(\\operatorname{ln}⁡y)+2{e}^{x}\\cdot \\frac{∂}{∂y}(y) \\\\  & =3x\\cdot \\frac{1}{y}+2{e}^{x}\\cdot 1 \\\\  & =\\frac{3x}{y}+2{e}^{x}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-11049"] :question/problem "For the function $f(x,y) = x^2y^2+\\sin{x}\\cos{y},$ evaluate $\\dfrac{\\partial f}{\\partial x}$ at the point $(\\pi,2\\pi).$" :question/worked-solution "We differentiate the given function with respect to $x,$ treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}{y}^{2}+\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & =\\frac{∂}{∂x}({x}^{2}{y}^{2})+\\frac{∂}{∂x}(\\operatorname{sin}⁡x\\operatorname{cos}⁡y) \\\\  & ={y}^{2}\\cdot \\frac{∂}{∂x}({x}^{2})+\\operatorname{cos}⁡y\\cdot \\frac{∂}{∂x}(\\operatorname{sin}⁡x) \\\\  & ={y}^{2}\\cdot (2x)+\\operatorname{cos}⁡y\\cdot (\\operatorname{cos}⁡x) \\\\  & =2x{y}^{2}+\\operatorname{cos}⁡x\\operatorname{cos}⁡y\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\pi,2\\pi)\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x}{|}_{(\\pi ,2\\pi )} & =2\\cdot \\pi \\cdot (2\\pi )^{2}+\\operatorname{cos}⁡\\pi \\cdot \\operatorname{cos}⁡2\\pi  \\\\  & =2\\pi \\cdot 4{\\pi }^{2}+(-1)\\cdot 1 \\\\  & =8{\\pi }^{3}-1\\end{aligned}\n$$" :db/ensure [:question/validate]}]
