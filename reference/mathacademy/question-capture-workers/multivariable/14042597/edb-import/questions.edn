#{[{:db/id #edb/ref 17592186124115 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/id #uuid "35a664b8-a895-5c52-a92f-b62c75b44744" :question/math-academy-id "e-11026" :question/problem "Find $\\dfrac{\\partial f}{\\partial y}$ given that $f(x,y) = 3x\\ln y + 2ye^x$." :question/worked-solution "We differentiate the given function with respect to $y$, treating all other variables as constants.\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\n\\frac{∂f}{∂y} &= \\frac{∂}{∂y}(3x\\ln y + 2ye^{x}) \\\\\n&= \\frac{∂}{∂y}(3x\\ln y) + \\frac{∂}{∂y}(2ye^{x}) \\\\\n&= 3x \\cdot \\frac{∂}{∂y}(\\ln y) + 2e^{x} \\cdot \\frac{∂}{∂y}(y) \\\\\n&= 3x \\cdot \\frac{1}{y} + 2e^{x} \\cdot 1 \\\\\n&= \\frac{3x}{y} + 2e^{x}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124119 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "59c3f441-0499-575c-af10-b597d61e6e35" :knowledge-point/title "Partial Derivatives as Limits of Difference Quotients"}] :question/id #uuid "a14d53ae-1922-531d-bb2a-bda9b4829f6e" :question/math-academy-id "e-11045" :question/problem "Given that $f(x,y) = y^2\\ln{x}$, express $\\dfrac{\\partial f}{\\partial x}$ as the limit of a difference quotient." :question/worked-solution "The partial derivative of $f$ with respect to $x$ is given by the limit\n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0} \\left(\\dfrac{f(x+h,y)-f(x,y)}{h}\\right)\n$$\n\nSince\n\n$$\nf(x) = y^2 \\ln{x}\n$$\n\nwe have that\n\n$$\nf(x+h,y) = y^2\\ln(x+h)\n$$\n\nTherefore,\n\n$$\n\\displaystyle \\dfrac{\\partial f}{\\partial x} = \\lim_{h \\to 0}\\left(\\dfrac{y^2\\ln(x+h) -y^2\\ln{x}}{h}\\right)\n$$"}] [{:db/id #edb/ref 17592186124120 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "facdd9e7-8fcb-5ad1-b9c1-82c0f753df1a" :knowledge-point/title "Evaluating a Partial Derivative at a Point"}] :question/id #uuid "ee2294e1-1e9a-5be5-be47-4c2e295b640a" :question/math-academy-id "e-11049" :question/problem "For the function $f(x,y) = x^2y^2+\\sin{x}\\cos{y}$, evaluate $\\dfrac{\\partial f}{\\partial x}$ at the point $(\\pi,2\\pi)$." :question/worked-solution "We differentiate the given function with respect to $x$, treating all other variables as constants:\n\nAdditionally, we use the sum and constant multiple rules for differentiation, as follows:\n\n$$\n\\begin{aligned}\n\\frac{∂f}{∂x} &= \\frac{∂}{∂x}(x^{2}y^{2} + \\sin x\\cos y) \\\\\n&= \\frac{∂}{∂x}(x^{2}y^{2}) + \\frac{∂}{∂x}(\\sin x\\cos y) \\\\\n&= y^{2} \\cdot \\frac{∂}{∂x}(x^{2}) + \\cos y \\cdot \\frac{∂}{∂x}(\\sin x) \\\\\n&= y^{2} \\cdot (2x) + \\cos y \\cdot (\\cos x) \\\\\n&= 2xy^{2} + \\cos x\\cos y\n\\end{aligned}\n$$\n\nFinally, we evaluate the partial derivative at the point $(\\pi,2\\pi)$:\n\n$$\n\\begin{aligned}\n\\frac{∂f}{∂x} \\mid _{(π, 2π)} &= 2 \\cdot π \\cdot (2π)^{2} + \\cos π \\cdot \\cos 2π \\\\\n&= 2π \\cdot 4π^{2} + (-1) \\cdot 1 \\\\\n&= 8π^{3} - 1\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186124817 :knowledge-point/_questions [{:knowledge-point/id #uuid "53c5d5d7-40d4-5210-8794-428cffc1f3f9" :knowledge-point/title "Finding Partial Derivatives of Two-Variable Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "978084bc-6bf2-5803-95e5-58f403ea0aa7" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos y + y" :db/id #edb/ref 17592186121925} {:answer/id #uuid "cbab19fd-3674-5c42-a736-5e4f8dc0491b" :answer/type {:db/ident :answer.type/math} :answer/value "x^{2}\\cos y + x" :db/id #edb/ref 17592186121926} {:answer/id #uuid "ed0b169e-c044-5d32-b5d9-288aff4e2196" :answer/type {:db/ident :answer.type/math} :answer/value "x\\sin y + x" :db/id #edb/ref 17592186121927} {:answer/id #uuid "fd54039a-95ed-5699-9f0b-8d53d6d4493b" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\sin y + y" :db/id #edb/ref 17592186121928} {:answer/id #uuid "28025b94-e726-5b33-892c-5a7cf2fd7d40" :answer/type {:db/ident :answer.type/math} :answer/value "2y\\sin y + x" :db/id #edb/ref 17592186121929}] :answer-field/correct {:answer/id #uuid "fd54039a-95ed-5699-9f0b-8d53d6d4493b" :answer/type {:db/ident :answer.type/math} :answer/value "2x\\sin y + y" :db/id #edb/ref 17592186121928} :answer-field/id #uuid "98d02875-fb45-5a92-a367-de0402e93596" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121924}] :question/id #uuid "f09939e1-cd34-5f87-ba1b-e1ac2c9af5b2" :question/math-academy-id "q-35709" :question/problem "Find $\\frac{∂f}{∂x}$ given that $f(x, y) = x^{2}\\sin y + xy$."}]}
