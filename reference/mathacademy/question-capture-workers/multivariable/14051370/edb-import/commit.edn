in}⁡t,\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=\\frac{\\pi }{2},$ we substitute into the above:\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{2}) & =⟨\\operatorname{sin}⁡(\\frac{\\pi }{2}),\\operatorname{cos}⁡(\\frac{\\pi }{2})⟩ \\\\  & =⟨1,0⟩\\end{aligned}\n$$" 13194139535142 true] [17592186333460 1000 #edb/ref 17592186333461 13194139535142 true] [17592186333460 1000 #edb/ref 17592186333462 13194139535142 true] [17592186333460 1000 #edb/ref 17592186333463 13194139535142 true] [17592186333460 1000 #edb/ref 17592186333464 13194139535142 true] [17592186333460 1000 #edb/ref 17592186333465 13194139535142 true] [17592186333460 1040 #edb/ref 17592186045450 13194139535142 true] [17592186333460 1041 "selection" 13194139535142 true] [17592186333460 1104 #edb/ref 17592186333463 13194139535142 true] [17592186333460 1110 #uuid "47393157-bd26-51b5-95d4-a3633a396640" 13194139535142 true] [17592186333461 1034 "v(\\frac{\\pi }{2})=⟨1,-1⟩" 13194139535142 true] [17592186333461 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333461 1111 #uuid "b3db8b19-d568-50d0-a489-5717e1bb7dc8" 13194139535142 true] [17592186333462 1034 "v(\\frac{\\pi }{2})=⟨-1,1⟩" 13194139535142 true] [17592186333462 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333462 1111 #uuid "fec23b36-0478-5117-9ca8-0bc7ae7f0246" 13194139535142 true] [17592186333463 1034 "v(\\frac{\\pi }{2})=⟨1,0⟩" 13194139535142 true] [17592186333463 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333463 1111 #uuid "8bac786a-850a-5142-a9d4-89c95623fd9c" 13194139535142 true] [17592186333464 1034 "v(\\frac{\\pi }{2})=⟨-1,0⟩" 13194139535142 true] [17592186333464 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333464 1111 #uuid "7e06ad6f-b267-551b-ac40-9fb77d5b3081" 13194139535142 true] [17592186333465 1034 "v(\\frac{\\pi }{2})=⟨0,1⟩" 13194139535142 true] [17592186333465 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333465 1111 #uuid "7ca0f76c-5c2a-580b-86a5-6460adef95ef" 13194139535142 true] [17592186333466 1017 #edb/ref 17592186333467 13194139535142 true] [17592186333466 1089 "q-121722" 13194139535142 true] [17592186333466 1091 #edb/ref 17592186045463 13194139535142 true] [17592186333466 1100 "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨1-5t,{e}^{2t}⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v$ at time $t=1.$" 13194139535142 true] [17592186333466 1113 #uuid "21d59417-64de-5660-afc1-3936a54352ed" 13194139535142 true] [17592186333466 1145 "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(1-5t),\\frac{\\text{d}}{\\text{d}t}({e}^{2t})⟩ \\\\  & =⟨-5,2{e}^{2t}⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=1,$ we substitute into the above:\n\n$$\n\\begin{aligned}v(1) & =⟨-5,2{e}^{2(1)}⟩ \\\\  & =⟨-5,2{e}^{2}⟩\\end{aligned}\n$$" 13194139535142 true] [17592186333467 1000 #edb/ref 17592186333468 13194139535142 true] [17592186333467 1000 #edb/ref 17592186333469 13194139535142 true] [17592186333467 1000 #edb/ref 17592186333470 13194139535142 true] [17592186333467 1000 #edb/ref 17592186333471 13194139535142 true] [17592186333467 1000 #edb/ref 17592186333472 13194139535142 true] [17592186333467 1040 #edb/ref 17592186045450 13194139535142 true] [17592186333467 1041 "selection" 13194139535142 true] [17592186333467 1104 #edb/ref 17592186333471 13194139535142 true] [17592186333467 1110 #uuid "9a024740-43c8-54cf-8b82-3c8b939048a6" 13194139535142 true] [17592186333468 1034 "v(1)=⟨-5,2e⟩" 13194139535142 true] [17592186333468 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333468 1111 #uuid "d2179c9f-5429-5917-8b1e-4242c9e3b06a" 13194139535142 true] [17592186333469 1034 "v(1)=⟨-4,2{e}^{2}⟩" 13194139535142 true] [17592186333469 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333469 1111 #uuid "49ebf0ca-8984-5511-a206-312ad62e8b14" 13194139535142 true] [17592186333470 1034 "v(1)=⟨-5,{e}^{2}⟩" 13194139535142 true] [17592186333470 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333470 1111 #uuid "fe275af1-2516-5331-9483-e7ad9d3ba716" 13194139535142 true] [17592186333471 1034 "v(1)=⟨-5,2{e}^{2}⟩" 13194139535142 true] [17592186333471 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333471 1111 #uuid "ee12e991-cec0-578e-a373-b0bedff2b909" 13194139535142 true] [17592186333472 1034 "v(1)=⟨-4,2e⟩" 13194139535142 true] [17592186333472 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333472 1111 #uuid "42ce0577-1954-5a19-98cb-8ba25f53043e" 13194139535142 true] [17592186333473 1017 #edb/ref 17592186333474 13194139535142 true] [17592186333473 1089 "q-121736" 13194139535142 true] [17592186333473 1091 #edb/ref 17592186045464 13194139535142 true] [17592186333473 1100 "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\nr=⟨\\operatorname{ln}⁡({t}^{2}-4t+8),{t}^{4}-\\frac{8}{3}{t}^{3}⟩,\\,t\\in [0,\\infty ).\n$$\n\nCalculate the times at which the particle is stationary." 13194139535142 true] [17592186333473 1113 #uuid "942f342e-d375-5134-864c-b37213f6cf64" 13194139535142 true] [17592186333473 1145 "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}\\operatorname{ln}⁡({t}^{2}-4t+8),\\frac{\\text{d}}{\\text{d}t}({t}^{4}-\\frac{8}{3}{t}^{3})⟩ \\\\  & =⟨\\frac{2t-4}{{t}^{2}-4t+8},4{t}^{3}-8{t}^{2}⟩ \\\\  & =⟨\\frac{2(t-2)}{{t}^{2}-4t+8},4{t}^{2}(t-2)⟩.\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero:\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨\\frac{2(t-2)}{{t}^{2}-4t+8},4{t}^{2}(t-2)⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}\\frac{2(t-2)}{{t}^{2}-4t+8}=0\\, & ⇒\\,t=2, \\\\ 4{t}^{2}(t-2)=0\\, & ⇒\\,t=0,2.\\end{aligned}\n$$\n\nThe solution $t=2$ is the only solution that satisfies both equations, so this is the only value of $t$ when the particle is stationary." 13194139535142 true] [17592186333474 1000 #edb/ref 17592186333475 13194139535142 true] [17592186333474 1000 #edb/ref 17592186333476 13194139535142 true] [17592186333474 1000 #edb/ref 17592186333477 13194139535142 true] [17592186333474 1000 #edb/ref 17592186333478 13194139535142 true] [17592186333474 1000 #edb/ref 17592186333479 13194139535142 true] [17592186333474 1040 #edb/ref 17592186045450 13194139535142 true] [17592186333474 1041 "selection" 13194139535142 true] [17592186333474 1104 #edb/ref 17592186333478 13194139535142 true] [17592186333474 1110 #uuid "f1d504dc-d3ab-59bc-b706-2a6beff615f5" 13194139535142 true] [17592186333475 1034 "t=0" 13194139535142 true] [17592186333475 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333475 1111 #uuid "08779a6f-b0b9-56ff-8814-a43c29ab9a74" 13194139535142 true] [17592186333476 1034 "t=0,4" 13194139535142 true] [17592186333476 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333476 1111 #uuid "cd023b9a-ef5b-5edf-b8dc-e77258dc8f06" 13194139535142 true] [17592186333477 1034 "t=0,2" 13194139535142 true] [17592186333477 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333477 1111 #uuid "1626e7f9-33d1-54f5-aa99-61752c0c4688" 13194139535142 true] [17592186333478 1034 "t=2" 13194139535142 true] [17592186333478 1103 #edb/ref 17592186045453 13194139535142 true] [17592186333478 1111 #uuid "a97c7458-8a57-593f-b53b-0777e07d4888" 13194139535142 true] [17592186333479 1034 "The particle is never stationary" 13194139535142 true] [17592186333479 1103 #edb/ref 17592186045454 13194139535142 true] [17592186333479 1111 #uuid "9dc23d8d-070f-50b0-b07c-8adbf9c7ce5c" 13194139535142 true] [17592186333480 1017 #edb/ref 17592186333481 13194139535142 true] [175