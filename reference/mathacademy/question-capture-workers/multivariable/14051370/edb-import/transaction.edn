on/995e2d4ba93aa5da743e6b64ab156b7f32a66d8a9cb0ed189c9ddc81c12485f8"] :db/ensure [:answer-field/validate]} {:db/id "q-121709" :question/id #uuid "c096fc60-9dd6-554e-aa27-723f03855f59" :question/math-academy-id "q-121709" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{cos}⁡({t}^{2}-1),4t-1⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v.$" :question/worked-solution "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡({t}^{2}-1)),\\frac{\\text{d}}{\\text{d}t}(4t-1)⟩ \\\\  & =⟨-2t\\operatorname{sin}⁡({t}^{2}-1),4⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121709/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dccdc3ad-6acb-57ae-83ef-95ffedfbff2f"] :knowledge-point/questions ["q-121709"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352530/field-1/d6dc07b74c66cf142c5cf890d139486aa911c897bfd2e80f4cfc3a32ab507fc5" :answer/id #uuid "03d467aa-e370-59e2-b7a5-b35aac35dd27" :answer/type :answer.type/math :answer/value "\\frac{9}{4}t^2-6" :db/ensure [:answer/validate]} {:db/id "q-352530/field-1/e84a9e601f6dcd464efb460ca0d22f939736abeda3ae81b5529da98c5d0692d2" :answer/id #uuid "db690645-92b9-5cea-8e42-95c59acb932e" :answer/type :answer.type/math :answer/value "\\frac{3}{4}t^2-6" :db/ensure [:answer/validate]} {:db/id "q-352530/field-1" :answer-field/id #uuid "4f676f38-e312-59f7-ba85-4b0c1db69b74" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352530/field-1/d6dc07b74c66cf142c5cf890d139486aa911c897bfd2e80f4cfc3a32ab507fc5" :answer-field/choices ["q-352530/field-1/d6dc07b74c66cf142c5cf890d139486aa911c897bfd2e80f4cfc3a32ab507fc5" 