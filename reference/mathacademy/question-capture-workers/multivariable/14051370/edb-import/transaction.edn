+5)),\\frac{\\text{d}}{\\text{d}t}(4-2t)⟩ \\\\  & =⟨\\frac{6t}{3{t}^{2}+5},-2⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-352536/field-1" "q-352536/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dccdc3ad-6acb-57ae-83ef-95ffedfbff2f"] :knowledge-point/questions ["q-352536"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352538/field-1/0a846961484f0704870274f901b97876e33b9705584ff10991a33fbc237daae1" :answer/id #uuid "b1a3600b-913f-597f-8bcc-4fd475077119" :answer/type :answer.type/math :answer/value "\\frac{2t}{t^2+4}" :db/ensure [:answer/validate]} {:db/id "q-352538/field-1" :answer-field/id #uuid "e38dae9d-3466-506a-8ef1-3a92aca8c778" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352538/field-1/0a846961484f0704870274f901b97876e33b9705584ff10991a33fbc237daae1" :answer-field/choices ["q-352538/field-1/0a846961484f0704870274f901b97876e33b9705584ff10991a33fbc237daae1"] :db/ensure [:answer-field/validate]} {:db/id "q-352538" :question/id #uuid "5895ef0d-c063-5025-ae65-53030ec3bfea" :question/math-academy-id "q-352538" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{ln}⁡(7-3{t}^{2}),\\operatorname{ln}⁡({t}^{2}+4)⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v.$\n\n$v=⟨\\,-\\frac{6t}{7-3{t}^{2}},$\n{{field-1}}$⟩$" :question/worked-solution "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(7-3{t}^{2})),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}+4))⟩ \\\\  & =⟨-\\frac{6t}{7-3{t}^{2}},\\frac{2t}{{t}^{2}+4}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-352538/fie