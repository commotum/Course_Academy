f60f137dd2f817d72bf6fea00150c5" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "q-31654" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "t=4"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/state.json" "file_sha256" "5b3a5f891d7c29d5c23ea696b3c05384bff60f137dd2f817d72bf6fea00150c5" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "q-31654" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "The particle is never stationary"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/state.json" "file_sha256" "5b3a5f891d7c29d5c23ea696b3c05384bff60f137dd2f817d72bf6fea00150c5" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "q-31654" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "The particle is never stationary"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/state.json" "file_sha256" "5b3a5f891d7c29d5c23ea696b3c05384bff60f137dd2f817d72bf6fea00150c5" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-616" "field" nil "attribute" "question/problem" "value" "The position vector $\\mathbf{r}$ of a particle $P$ relative to a fixed origin $O$ at time $t > 0$ is given by\n\n$$\n\\mathbf{r} = \\langle 3t^3, 2t^2\\rangle.\n$$\n\nCalculate the velocity vector $\\mathbf{v}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-616.json" "file_sha256" "5c7c8050cce5ad00fab3cc2962f2dfdf333eae1cbb4ccd0af97ffd26597aaa5c" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-616" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})⟩ \\\\  & =⟨9{t}^{2},\\,4t⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-616.json" "file_sha256" "5c7c8050cce5ad00fab3cc2962f2dfdf333eae1cbb4ccd0af97ffd26597aaa5c" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-617" "field" nil "attribute" "question/problem" "value" "The position vector $\\mathbf{r}$ of a particle $P$ (relative to a fixed origin $O$) at time $t > 0$ is given by\n\n$$\n\\mathbf{r} = \\langle 12t, 2t^3\\rangle.\n$$\n\nCalculate the velocity vector $\\mathbf{v}$ at time $t=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-617.json" "file_sha256" "ec01de610dbde8c4bb7bc1517492214f5c9f395863c3043678b3485652e96a82" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-617" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(12t),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})⟩ \\\\  & =⟨12,6{t}^{2}⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=1$, we substitute into the above:\n\n$$\n\\begin{aligned}v(1) & =⟨12,6(1)^{2}⟩ \\\\  & =⟨12,6⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-617.json" "file_sha256" "ec01de610dbde8c4bb7bc1517492214f5c9f395863c3043678b3485652e96a82" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-618" "field" nil "attribute" "question/problem" "value" "The position vector $\\mathbf{r}$ of a particle $P$ relative to a fixed origin $O$ at time $t > 0$ is given by\n\n$$\n\\mathbf{r} = \\langle 6t^2+2, 2t^3\\rangle.\n$$\n\nCalculate the speed of the particle at time $t=2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-618.json" "file_sha256" "9843ab9a3a3305df1da2eeee116e23fa9b7ea54438d921e7a3d7c9a6dcc7274d" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-618" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $\\mathbf{v}.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}+2),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})⟩ \\\\  & =⟨12t,6{t}^{2}⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=2$, we substitute into the above:\n\n$$\n\\begin{aligned}v(2) & =⟨12(2),6(2)^{2}⟩ \\\\  & =⟨24,24⟩.\\end{aligned}\n$$\n\nTo find the speed at $t=2$ we calculate the magnitude of $\\mathbf{v}(2),$ and we get\n\n$$\n\\begin{aligned}|v(2)| & =\\sqrt{{24}^{2}+{24}^{2}} \\\\  & =\\sqrt{2({24}^{2})} \\\\  & =24\\sqrt{2}.\\end{aligned}\n$$\n\nSo, the speed when $t=2$ is $24\\sqrt{2}\\approx 33.94$ to two decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-618.json" "file_sha256" "9843ab9a3a3305df1da2eeee116e23fa9b7ea54438d921e7a3d7c9a6dcc7274d" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-619" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\n\\mathbf{r} = \\langle t^2-2t, t^3-3t \\rangle, \\quad t\\in[0,\\infty).\n$$\n\nCalculate the times at which the particle is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-619.json" "file_sha256" "6422104744549b4be3be7a34c1004b4874c0914208fad5bae976efd8c2790053" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"} {"question" "e-619" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $\\mathbf{v}.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3t)⟩ \\\\  & =⟨2t-2,\\,3{t}^{2}-3⟩.\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero. This gives,\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨2t-2,3{t}^{2}-3⟩ & =⟨0,0⟩.\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}2t-2 & =0\\,⇒\\,t=1, \\\\ 3{t}^{2}-3 & =0\\,⇒\\,t=\\pm 1.\\end{aligned}\n$$\n\nNote that $t=-1$ is outside of the domain of $t,$ so we discard it. \n\nThe solution $t=1$ is the only solution that satisfies both equations, so this is the only time when the object is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/example-619.json" "file_sha256" "6422104744549b4be3be7a34c1004b4874c0914208fad5bae976efd8c2790053" "basis" 1448 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14040567/edb-import/verification.json"}] "sources" [{"question" "q-121709" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{cos}⁡({t}^{2}-1),4t-1⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121709" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡({t}^{2}-1)),\\frac{\\text{d}}{\\text{d}t}(4t-1)⟩ \\\\  & =⟨-2t\\operatorname{sin}⁡({t}^{2}-1),4⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121709" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-121709" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121709" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "v=⟨-2t\\operatorname{sin}⁡({t}^{2}-1),-4⟩"] ["math" "v=⟨-2t\\operatorname{sin}⁡({t}^{2}-1),4⟩"] ["math" "v=⟨-\\operatorname{sin}⁡({t}^{2}-1),-4⟩"] ["math" "v=⟨-\\operatorname{sin}⁡({t}^{2}-1),4⟩"] ["math" "v=⟨2t\\operatorname{sin}⁡({t}^{2}-1),4⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121709" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "v=⟨-2t\\operatorname{sin}⁡({t}^{2}-1),4⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352530" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{3}{4}{t}^{3}-6t+1,\\,-\\frac{5}{{t}^{3}}⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v.$\n\n$v=⟨${{field-1}},\n{{field-2}}$⟩$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352530" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{4}{t}^{3}-6t+1),\\frac{\\text{d}}{\\text{d}t}(-\\frac{5}{{t}^{3}})⟩ \\\\  & =⟨\\frac{9}{4}{t}^{2}-6,\\frac{15}{{t}^{4}}⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352530" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352530" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352530" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9}{4}t^2-6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352530" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "0