t}^{2}),\\operatorname{ln}⁡({t}^{2}+4)⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v.$\n\n$v=⟨\\,-\\frac{6t}{7-3{t}^{2}},$\n{{field-1}}$⟩$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352538" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(7-3{t}^{2})),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡({t}^{2}+4))⟩ \\\\  & =⟨-\\frac{6t}{7-3{t}^{2}},\\frac{2t}{{t}^{2}+4}⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352538" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352538" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352538" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2t}{t^2+4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121722" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨1-5t,{e}^{2t}⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v$ at time $t=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121722" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(1-5t),\\frac{\\text{d}}{\\text{d}t}({e}^{2t})⟩ \\\\  & =⟨-5,2{e}^{2t}⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=1,$ we substitute into the above:\n\n$$\n\\begin{aligned}v(1) & =⟨-5,2{e}^{2(1)}⟩ \\\\  & =⟨-5,2{e}^{2}⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121722" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-121722" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121722" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "v(1)=⟨-4,2e⟩"] ["math" "v(1)=⟨-4,2{e}^{2}⟩"] ["math" "v(1)=⟨-5,2e⟩"] ["math" "v(1)=⟨-5,2{e}^{2}⟩"] ["math" "v(1)=⟨-5,{e}^{2}⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121722" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "v(1)=⟨-5,2{e}^{2}⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352570" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨5\\sqrt{1+8t},\\,(3+2t)^{3/2}⟩,\\,0<t<4.\n$$\n\nCalculate the components of the velocity vector $v$ at time $t=3.$ Do not round the answers.\n\n$v(3)=⟨${{field-1}},\n{{field-2}}$⟩$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352570" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5\\sqrt{1+8t}),\\frac{\\text{d}}{\\text{d}t}((3+2t)^{3/2})⟩ \\\\  & =⟨5\\cdot \\frac{1}{2}(1+8t)^{-1/2}\\cdot 8,\\frac{3}{2}(3+2t)^{1/2}\\cdot 2⟩ \\\\  & =⟨\\frac{20}{\\sqrt{1+8t}},3\\sqrt{3+2t}⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=3,$ we substitute into the above:\n\n$$\n\\begin{aligned}v(3) & =⟨\\frac{20}{\\sqrt{1+8(3)}},3\\sqrt{3+2(3)}⟩ \\\\  & =⟨\\frac{20}{\\sqrt{25}},3\\sqrt{9}⟩ \\\\  & =⟨\\frac{20}{5},3(3)⟩ \\\\  & =⟨4,\\,9⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352570" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352570" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352570" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352570" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352570" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75290" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨4\\sqrt{1+t},(1+t)^{2}⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v$ at time $t=3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75290" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\sqrt{1+t}),\\frac{\\text{d}}{\\text{d}t}((1+t)^{2})⟩ \\\\  & =⟨2(1+t)^{-1/2},2(1+t)⟩ \\\\  & =⟨\\frac{2}{\\sqrt{1+t}},2+2t⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=3,$ we substitute into the above:\n\n$$\n\\begin{aligned}v(3) & =⟨\\frac{2}{\\sqrt{1+3}},2+2(3)⟩ \\\\  & =⟨\\frac{2}{2},\\,2+6⟩ \\\\  & =⟨1,\\,8⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75290" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-75290" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75290" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "v(3)=⟨1,\\,7⟩"] ["math" "v(3)=⟨1,\\,8⟩"] ["math" "v(3)=⟨2,\\,7⟩"] ["math" "v(3)=⟨2,\\,8⟩"] ["math" "v(3)=⟨4,\\,8⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75290" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "v(3)=⟨1,\\,8⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121720" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨-\\operatorname{cos}⁡t,\\operatorname{sin}⁡t⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v$ at time $t=\\frac{\\pi }{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121720" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)⟩ \\\\  & =⟨\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=\\frac{\\pi }{2},$ we substitute into the above:\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{2}) & =⟨\\operatorname{sin}⁡(\\frac{\\pi }{2}),\\operatorname{cos}⁡(\\frac{\\pi }{2})⟩ \\\\  & =⟨1,0⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121720" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-121720" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121720" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "v(\\frac{\\pi }{2})=⟨-1,0⟩"] ["math" "v(\\frac{\\pi }{2})=⟨-1,1⟩"] ["math" "v(\\frac{\\pi }{2})=⟨0,1⟩"] ["math" "v(\\frac{\\pi }{2})=⟨1,-1⟩"] ["math" "v(\\frac{\\pi }{2})=⟨1,0⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121720" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "v(\\frac{\\pi }{2})=⟨1,0⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121719" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨t+4,\\operatorname{ln}⁡(5t+1)⟩,\\,t>0.\n$$\n\nCalculate the velocity vector $v$ at time $t=3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121719" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(t+4),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(5t+1))⟩ \\\\  & =⟨1,\\frac{5}{5t+1}⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=3,$ we substitute into the above:\n\n$$\n\\begin{aligned}v(3) & =⟨1,\\frac{5}{5(3)+1}⟩ \\\\  & =⟨1,\\frac{5}{16}⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121719" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-121719" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121719" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "v(3)=⟨1,4\\operatorname{ln}⁡2⟩"] ["math" "v(3)=⟨1,\\frac{5}{16}⟩"] ["math" "v(3)=⟨1,\\frac{5}{4}⟩"] ["math" "v(3)=⟨7,4\\operatorname{ln}⁡2⟩"] ["math" "v(3)=⟨7,\\frac{5}{16}⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121719" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "v(3)=⟨1,\\frac{5}{16}⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352588" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{ln}⁡(t+3),\\,\\sqrt{t}⟩,\\,t>0.\n$$\n\nCalculate the speed $|v|$ of the particle at time $t=1.$ Do not round the answer.\n\nThe speed at time $t=1$ is\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352588" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t+3)),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t})⟩ \\\\  & =⟨\\frac{1}{t+3},\\,\\frac{1}{2\\sqrt{t}}⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=1,$ we substitute in the above:\n\n$$\n\\begin{aligned}v(1) & =⟨\\frac{1}{1+3},\\,\\frac{1}{2\\sqrt{1}}⟩ \\\\  & =⟨\\frac{1}{4},\\,\\frac{1}{2}⟩\\end{aligned}\n$$\n\nTo find the speed at $t=1$ we calculate the magnitude of $v(1),$ and we get\n\n$$\n\\begin{aligned}|v(1)| & =\\sqrt{{(\\frac{1}{4})}^{2}+{(\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{1}{16}+\\frac{1}{4}} \\\\  & =\\sqrt{\\frac{5}{16}} \\\\  & =\\frac{\\sqrt{5}}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352588" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352588" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352588" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{5}}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75302" "field" nil "attribute" "question/problem" "value" "A particle $P$ is moving in the $x$-$y$ plane. Its position vector relative to a fixed origin $O$ is given by\n\n$$\nr=⟨2\\operatorname{cos}⁡(2t),\\,\\operatorname{sin}⁡(4t)⟩,\\,t>0.\n$$\n\nCalculate the speed of the particle at time $t=\\frac{\\pi }{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75302" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(2t)),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(4t))⟩ \\\\  & =⟨-4\\operatorname{sin}⁡(2t),4\\operatorname{cos}⁡(4t)⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=\\frac{\\pi }{2},$ we substitute in the above:\n\n$$\n\\begin{aligned}v(\\frac{\\pi }{2}) & =⟨-4\\operatorname{sin}⁡(\\pi ),4\\operatorname{cos}⁡(2\\pi )⟩ \\\\  & =⟨-4(0),4(1)⟩ \\\\  & =⟨0,4⟩\\end{aligned}\n$$\n\nTo find the speed at $t=\\frac{\\pi }{2}$ we calculate the magnitude of $v(\\frac{\\pi }{2}),$ and we get\n\n$$\n\\begin{aligned}|v(\\frac{\\pi }{2})| & =\\sqrt{{0}^{2}+{4}^{2}} \\\\  & =\\sqrt{16} \\\\  & =4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75302" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-75302" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75302" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "2\\sqrt{2}"] ["math" "4"] ["math" "4\\sqrt{2}"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-75302" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352584" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{ln}⁡(t+2),\\,\\frac{4}{t}⟩,\\,t>0.\n$$\n\nCalculate the speed $|v|$ of the particle at time $t=2.$ Do not round the answer.\n\nThe speed at time $t=2$ is\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352584" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t+2)),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{t})⟩ \\\\  & =⟨\\frac{1}{t+2},\\,-\\frac{4}{{t}^{2}}⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=2,$ we substitute in the above:\n\n$$\n\\begin{aligned}v(2) & =⟨\\frac{1}{2+2},\\,-\\frac{4}{{2}^{2}}⟩ \\\\  & =⟨\\frac{1}{4},\\,-1⟩\\end{aligned}\n$$\n\nTo find the speed at $t=2$ we calculate the magnitude of $v(2),$ and we get\n\n$$\n\\begin{aligned}|v(2)| & =\\sqrt{{(\\frac{1}{4})}^{2}+{(-1)}^{2}} \\\\  & =\\sqrt{\\frac{1}{16}+1} \\\\  & =\\sqrt{\\frac{17}{16}} \\\\  & =\\frac{\\sqrt{17}}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352584" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352584" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352584" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{17}}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352596" "field" nil "attribute" "question/problem" "value" "A particle $P$ is moving in the $x$-$y$ plane. Its position vector relative to a fixed origin $O$ is given by\n\n$$\nr=⟨4\\operatorname{cos}⁡(\\frac{\\pi }{2}t),\\,\\sqrt{t+2}⟩,\\,t>0.\n$$\n\nCalculate the speed of the particle at time $t=2.$\n\nThe speed at time $t=2$ is\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352596" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡(\\frac{\\pi }{2}t)),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{t+2})⟩ \\\\  & =⟨-2\\pi \\operatorname{sin}⁡(\\frac{\\pi }{2}t),\\frac{1}{2\\sqrt{t+2}}⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=2,$ we substitute in the above:\n\n$$\n\\begin{aligned}v(2) & =⟨-2\\pi \\operatorname{sin}⁡(\\pi ),\\frac{1}{2\\sqrt{2+2}}⟩ \\\\  & =⟨0,\\frac{1}{4}⟩\\end{aligned}\n$$\n\nTo find the speed at $t=2$ we calculate the magnitude of $v(2),$ and we get\n\n$$\n\\begin{aligned}|v(2)| & =\\sqrt{{0}^{2}+{(\\frac{1}{4})}^{2}} \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352596" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352596" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352596" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352572" "field" nil "attribute" "question/problem" "value" "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\frac{5{t}^{2}}{2},\\,3t+2⟩,\\,t>0.\n$$\n\nCalculate the speed  $|v|$ of the particle at time $t=3.$ Do not round the answer.\n\nThe speed at time $t=3$ is\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352572" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{5{t}^{2}}{2}),\\frac{\\text{d}}{\\text{d}t}(3t+2)⟩ \\\\  & =⟨5t,\\,3⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=3,$ we substitute in the above:\n\n$$\n\\begin{aligned}v(3) & =⟨5(3),\\,3⟩ \\\\  & =⟨15,3⟩\\end{aligned}\n$$\n\nTo find the speed at $t=3$ we calculate the magnitude of $v(3),$ and we get\n\n$$\n\\begin{aligned}|v(3)| & =\\sqrt{{15}^{2}+{3}^{2}} \\\\  & =\\sqrt{225+9} \\\\  & =\\sqrt{234} \\\\  & =3\\sqrt{26}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352572" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352572" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352572" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\sqrt{26}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121736" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\nr=⟨\\operatorname{ln}⁡({t}^{2}-4t+8),{t}^{4}-\\frac{8}{3}{t}^{3}⟩,\\,t\\in [0,\\infty ).\n$$\n\nCalculate the times at which the particle is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121736" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}\\operatorname{ln}⁡({t}^{2}-4t+8),\\frac{\\text{d}}{\\text{d}t}({t}^{4}-\\frac{8}{3}{t}^{3})⟩ \\\\  & =⟨\\frac{2t-4}{{t}^{2}-4t+8},4{t}^{3}-8{t}^{2}⟩ \\\\  & =⟨\\frac{2(t-2)}{{t}^{2}-4t+8},4{t}^{2}(t-2)⟩.\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero:\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨\\frac{2(t-2)}{{t}^{2}-4t+8},4{t}^{2}(t-2)⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}\\frac{2(t-2)}{{t}^{2}-4t+8}=0\\, & ⇒\\,t=2, \\\\ 4{t}^{2}(t-2)=0\\, & ⇒\\,t=0,2.\\end{aligned}\n$$\n\nThe solution $t=2$ is the only solution that satisfies both equations, so this is the only value of $t$ when the particle is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121736" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-121736" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121736" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "t=0"] ["math" "t=0,2"] ["math" "t=0,4"] ["math" "t=2"] ["text" "The particle is never stationary"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-121736" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "t=2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31654" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\nr=⟨{t}^{3}-3t,\\,2{t}^{2}+6t-3⟩,\\,t>0.\n$$\n\nCalculate the times at which the particle is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31654" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3t),\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}+6t-3)⟩ \\\\  & =⟨3{t}^{2}-3,4t+6⟩ \\\\  & =⟨3({t}^{2}-1),2(2t+3)⟩ \\\\  & =⟨3(t-1)(t+1),2(2t+3)⟩\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero:\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨3(t-1)(t+1),2(2t+3)⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}3(t-1)(t+1)=0\\, & ⇒\\,t=\\pm 1, \\\\ 2(2t+3)=0\\, & ⇒\\,t=-\\frac{3}{2}.\\end{aligned}\n$$\n\nThere is no value of $t$ that satisfies both equations, so there are no stationary points." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31654" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-31654" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31654" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "t=1"] ["math" "t=2"] ["math" "t=3"] ["math" "t=4"] ["text" "The particle is never stationary"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31654" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "The particle is never stationary"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31653" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\nr=⟨\\sqrt{{t}^{2}+1},\\,{t}^{3}-6{t}^{2}⟩,\\,t\\ge 0.\n$$\n\nCalculate the times at which the particle is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31653" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\sqrt{{t}^{2}+1}),\\frac{\\text{d}}{\\text{d}t}({t}^{3}-6{t}^{2})⟩ \\\\  & =⟨\\frac{1}{2}\\cdot ({t}^{2}+1)^{-1/2}\\cdot 2t,3{t}^{2}-12t⟩ \\\\  & =⟨\\frac{t}{\\sqrt{{t}^{2}+1}},3t(t-4)⟩\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero:\n\n$$\n\\begin{aligned}v & =0 \\\\ ⟨\\frac{t}{\\sqrt{{t}^{2}+1}},3t(t-4)⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}\\frac{t}{\\sqrt{{t}^{2}+1}}=0\\, & ⇒\\,t=0, \\\\ 3t(t-4)=0\\, & ⇒\\,t=0,4.\\end{aligned}\n$$\n\nThe solution $t=0$ is the only solution that satisfies both equations, so this is the only value of $t$ when the object is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31653" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-31653" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31653" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "t=0"] ["math" "t=0,2"] ["math" "t=1"] ["math" "t=1,2"] ["text" "The particle is never stationary"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-31653" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "t=0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352729" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\nr=⟨t-\\frac{1}{2}\\operatorname{sin}⁡(2t),\\,\\operatorname{cos}⁡(3t)⟩,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nCalculate the times at which the particle is stationary.\n\nThe particle is stationary at $t=$\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352729" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(t-\\frac{1}{2}\\operatorname{sin}⁡(2t)),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(3t))⟩ \\\\  & =⟨1-\\operatorname{cos}⁡2t,-3\\operatorname{sin}⁡3t⟩.\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero:\n\n$$\n\\begin{aligned}v & =0 \\\\ ⟨1-\\operatorname{cos}⁡2t,-3\\operatorname{sin}⁡3t⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}1-\\operatorname{cos}⁡2t=0\\, & ⇒\\,t=0, \\\\ -3\\operatorname{sin}⁡3t=0\\, & ⇒\\,t=0,\\frac{\\pi }{3}.\\end{aligned}\n$$\n\nThe solution $t=0$ is the only solution that satisfies both equations, so this is the only value of $t$ when the object is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352729" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352729" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352729" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352732" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\nr=⟨t-\\operatorname{sin}⁡t,\\,\\sqrt{{t}^{2}+1}⟩,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nCalculate the times at which the particle is stationary.\n\nThe particle is stationary at $t=$\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352732" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $v.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡t),\\frac{\\text{d}}{\\text{d}t}(\\sqrt{{t}^{2}+1})⟩ \\\\  & =⟨1-\\operatorname{cos}⁡t,\\frac{t}{\\sqrt{{t}^{2}+1}}⟩.\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero:\n\n$$\n\\begin{aligned}v & =0 \\\\ ⟨1-\\operatorname{cos}⁡t,\\frac{t}{\\sqrt{{t}^{2}+1}}⟩ & =⟨0,0⟩\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}1-\\operatorname{cos}⁡t=0\\, & ⇒\\,t=0, \\\\ \\frac{t}{\\sqrt{{t}^{2}+1}}=0\\, & ⇒\\,t=0.\\end{aligned}\n$$\n\nThe solution $t=0$ is the only solution that satisfies both equations, so this is the only value of $t$ when the object is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352732" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/activity-metadata.json" "file_sha256" "955bacc56879aca7fb61d5baff2d233332309e8803a3e8c138fb3e71f118db86"} {"question" "q-352732" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "q-352732" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/state.json" "file_sha256" "05f1e5c5ad389b6c1e8a63328ed30e09fd7fdedc996b5f820971cadd8ba1d695"} {"question" "e-616" "field" nil "attribute" "question/problem" "value" "The position vector $\\mathbf{r}$ of a particle $P$ relative to a fixed origin $O$ at time $t > 0$ is given by\n\n$$\n\\mathbf{r} = \\langle 3t^3, 2t^2\\rangle.\n$$\n\nCalculate the velocity vector $\\mathbf{v}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-616.json" "file_sha256" "9f290cd79037c747d8d32d28db241351ee87339ac27fa96a8bba34cf75b6be39"} {"question" "e-616" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2})⟩ \\\\  & =⟨9{t}^{2},\\,4t⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-616.json" "file_sha256" "9f290cd79037c747d8d32d28db241351ee87339ac27fa96a8bba34cf75b6be39"} {"question" "e-617" "field" nil "attribute" "question/problem" "value" "The position vector $\\mathbf{r}$ of a particle $P$ (relative to a fixed origin $O$) at time $t > 0$ is given by\n\n$$\n\\mathbf{r} = \\langle 12t, 2t^3\\rangle.\n$$\n\nCalculate the velocity vector $\\mathbf{v}$ at time $t=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-617.json" "file_sha256" "98adcde478221172a6e51a650fc098cf103eb3780ec468700e53d70aeaddf14b"} {"question" "e-617" "field" nil "attribute" "question/worked-solution" "value" "The particle's velocity vector is given by the derivative of its position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(12t),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})⟩ \\\\  & =⟨12,6{t}^{2}⟩\\end{aligned}\n$$\n\nTo find the velocity when $t=1$, we substitute into the above:\n\n$$\n\\begin{aligned}v(1) & =⟨12,6(1)^{2}⟩ \\\\  & =⟨12,6⟩\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-617.json" "file_sha256" "98adcde478221172a6e51a650fc098cf103eb3780ec468700e53d70aeaddf14b"} {"question" "e-618" "field" nil "attribute" "question/problem" "value" "The position vector $\\mathbf{r}$ of a particle $P$ relative to a fixed origin $O$ at time $t > 0$ is given by\n\n$$\n\\mathbf{r} = \\langle 6t^2+2, 2t^3\\rangle.\n$$\n\nCalculate the speed of the particle at time $t=2.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-618.json" "file_sha256" "33c16486650fc885b77cc966cd7408745c3da8c8fc731e4675892d0f88f612c9"} {"question" "e-618" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $\\mathbf{v}.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}+2),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{3})⟩ \\\\  & =⟨12t,6{t}^{2}⟩.\\end{aligned}\n$$\n\nTo find the velocity when $t=2$, we substitute into the above:\n\n$$\n\\begin{aligned}v(2) & =⟨12(2),6(2)^{2}⟩ \\\\  & =⟨24,24⟩.\\end{aligned}\n$$\n\nTo find the speed at $t=2$ we calculate the magnitude of $\\mathbf{v}(2),$ and we get\n\n$$\n\\begin{aligned}|v(2)| & =\\sqrt{{24}^{2}+{24}^{2}} \\\\  & =\\sqrt{2({24}^{2})} \\\\  & =24\\sqrt{2}.\\end{aligned}\n$$\n\nSo, the speed when $t=2$ is $24\\sqrt{2}\\approx 33.94$ to two decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-618.json" "file_sha256" "33c16486650fc885b77cc966cd7408745c3da8c8fc731e4675892d0f88f612c9"} {"question" "e-619" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves in the $x$-$y$ plane (relative to a fixed origin $O$) with position vector\n\n$$\n\\mathbf{r} = \\langle t^2-2t, t^3-3t \\rangle, \\quad t\\in[0,\\infty).\n$$\n\nCalculate the times at which the particle is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-619.json" "file_sha256" "48578632bc8d19a7651cef9edb553662f46971ee6c572654abad9430c3ea601d"} {"question" "e-619" "field" nil "attribute" "question/worked-solution" "value" "First, we calculate the velocity vector $\\mathbf{v}.$ Differentiating the position vector, we get\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}-2t),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-3t)⟩ \\\\  & =⟨2t-2,\\,3{t}^{2}-3⟩.\\end{aligned}\n$$\n\nThe particle is stationary when its velocity is zero. This gives,\n\n$$\n\\begin{aligned}v(t) & =0 \\\\ ⟨2t-2,3{t}^{2}-3⟩ & =⟨0,0⟩.\\end{aligned}\n$$\n\nSo we need\n\n$$\n\\begin{aligned}2t-2 & =0\\,⇒\\,t=1, \\\\ 3{t}^{2}-3 & =0\\,⇒\\,t=\\pm 1.\\end{aligned}\n$$\n\nNote that $t=-1$ is outside of the domain of $t,$ so we discard it. \n\nThe solution $t=1$ is the only solution that satisfies both equations, so this is the only time when the object is stationary." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14051370/example-619.json" "file_sha256" "48578632bc8d19a7651cef9edb553662f46971ee6c572654abad9430c3ea601d"}] "usage" {"e-619" [] "q-31654" [] "e-618" [] "e-617" [] "e-616" []} "basis" 1829 "retractions" [] "immutable_answers" [17592186308277 17592186308278 17592186308279 17592186308280 17592186308281] "immutable_fields" [[17592186308276 :answer-field/correct] [17592186308276 :answer-field/id] [17592186308276 :answer-field/key] [17592186308276 :answer-field/type]] "no_history" []}
