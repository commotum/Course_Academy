}^{2},\\,2⟩\\end{aligned}\n$$\n\nThe vectors ${r}^{′}(t)$ and $r(t)$ are parallel for some specific value ${t}_{0}$ of the parameter $t$ if and only if there exists a constant $c$ such that $r({t}_{0})=c\\,{r}^{′}({t}_{0}).$ So, we have\n\n$$\n\\begin{aligned}r(t) & =c\\,{r}^{′}(t) \\\\ ⟨\\sqrt{t},\\,{t}^{3}+5,\\,2t+2⟩ & =c\\,⟨\\frac{1}{2\\sqrt{t}},\\,3{t}^{2},\\,2⟩ \\\\ ⟨\\sqrt{t},\\,{t}^{3}+5,\\,2t+2⟩ & =⟨\\frac{c}{2\\sqrt{t}},\\,3c{t}^{2},\\,2c⟩.\\end{aligned}\n$$\n\nEquating the components gives:\n\n$$\n{\\begin{aligned}\\sqrt{t}=\\frac{c}{2\\sqrt{t}} \\\\ {t}^{3}+5=3c{t}^{2} \\\\ 2t+2=2c\\end{aligned}\n$$\n\nFrom the first equation, we obtain that $c=2t.$ Substituting into the third equation, we get\n\n$$\n\\begin{aligned}2t+2 & =2\\cdot (2t) \\\\ 2t+2 & =4t \\\\ 2t-2 & =0 \\\\ t & =1.\\end{aligned}\n$$\n\nThis satisfies also the second equation ${t}^{3}+5=3c{t}^{2}.$\n\nTherefore, $r$ and ${r}^{′}$ are parallel only at the point corresponding to $t=1.$ These values also satisfy the second equation. \n\nFinally, since\n\n$$\n\\begin{aligned}r(1) & =⟨\\sqrt{1}\\,,\\,{1}^{3}+5\\,,\\,2(1)+2⟩ \\\\  & =⟨1,\\,6,\\,4⟩,\\end{aligned}\n$$\n\nwe conclude that $r(t)$ and ${r}^{′}(t)$ are parallel at the point $(1,6,4).$" 13194139535036 true] [17592186328052 1000 #edb/ref 17592186328053 13194139535036 true] [17592186328052 1000 #edb/ref 17592186328054 13194139535036 true] [17592186328052 1000 #edb/ref 17592186328055 13194139535036 true] [17592186328052 1000 #edb/ref 17592186328056 13194139535036 true] [17592186328052 1000 #edb/ref 17592186328057 13194139535036 true] [17592186328052 1040 #edb/ref 17592186045450 13194139535036 true] [17592186328052 1041 "selection" 13194139535036 true] [17592186328052 1104 #edb/ref 17592186328054 13194139535036 true] [17592186328052 1110 #uuid "0d426ef4-94f8-5cb6-ba02-bf5da2cf2a6a" 13194139535036 true] [17592186328053 1034 "(0,5,2)" 13194139535036 true] [17592186328053 1103 #edb/ref 17592186045453 13194139535036 true] [17592186328053 1111 #u