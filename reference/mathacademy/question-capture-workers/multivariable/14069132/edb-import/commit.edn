{t}{2})),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡(\\frac{t}{2}))⟩ \\\\  & =\\frac{1}{2}⟨\\operatorname{cos}⁡(\\frac{t}{2}),-\\operatorname{sin}⁡(\\frac{t}{2})⟩ \\\\ {T}^{′}(\\pi ) & =\\frac{1}{2}⟨\\operatorname{cos}⁡(\\frac{\\pi }{2}),\\,-\\operatorname{sin}⁡(\\frac{\\pi }{2})⟩=\\frac{1}{2}⟨0,-1⟩ \\\\ ‖{T}^{′}(\\pi )‖ & =\\frac{1}{2}\\sqrt{{0}^{2}+{(-1)}^{2}}=\\frac{1}{2}\\end{aligned}\n$$\n\nHence, the radius of curvature is\n\n$$\n\\begin{aligned}R(\\pi ) & =\\frac{‖{r}^{′}(\\pi )‖}{‖{T}^{′}(\\pi )‖}=\\frac{2}{(\\frac{1}{2})}=4.\\end{aligned}\n$$\n\nNext, we find the principal normal vector at $t=\\pi $ as\n\n$$\n\\begin{aligned}N(\\pi ) & =\\frac{{T}^{′}(\\pi )}{‖{T}^{′}(\\pi )‖}=\\frac{(\\frac{1}{2})}{(\\frac{1}{2})}⟨0,-1⟩=⟨0,-1⟩.\\end{aligned}\n$$\n\nFinally, the center of the osculating circle is given by\n\n$$\n\\begin{aligned}r(\\pi )+R(\\pi )N(\\pi ) & =⟨\\pi ,2⟩+4⟨0,-1⟩=⟨\\pi ,-2⟩.\\end{aligned}\n$$" 13194139535661 true] [17592186359814 1000 #edb/ref 17592186359815 13194139535661 true] [17592186359814 1000 #edb/ref 17592186359816 13194139535661 true] [17592186359814 1000 #edb/ref 17592186359817 13194139535661 true] [17592186359814 1000 #edb/ref 17592186359818 13194139535661 true] [17592186359814 1000 #edb/ref 17592186359819 13194139535661 true] [17592186359814 1040 #edb/ref 17592186045450 13194139535661 true] [17592186359814 1041 "selection" 13194139535661 true] [17592186359814 1104 #edb/ref 17592186359817 13194139535661 true] [17592186359814 1110 #uuid "ea1c74ac-36bf-510b-bebb-39ebcfb0f08f" 13194139535661 true] [17592186359815 1034 "The center is $(\\pi ,1)$ and the radius $2$" 13194139535661 true] [17592186359815 1103 #edb/ref 17592186045454 13194139535661 true] [17592186359815 1111 #uuid "84df81f6-3e54-528a-b6cf-3992562b10c9" 13194139535661 true] [17592186359816 1034 "The center is $(\\pi ,-1)$ and the radius $2$" 13194139535661 true] [17592186359816 1103 #edb/ref 17592186045454 13194139535661 true] [17592186359816 1111 #uuid "0ca2262b-4b0f