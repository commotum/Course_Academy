\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621" :answer-field/id #uuid "68992ab9-b6a4-594b-ad94-5e22de8daede" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" :answer-field/choices ["q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621/0eb26a40acaca9cea6115682e086ac98f768a095f98f0f6c055016c6e0fbe9d3" "q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621/b331b72fbc647af25e87beeed0ecd2094bccd700da9db995e5333721577b2be0" "q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f" "q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" "q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621/3094eae62ed7931038a0e6b3203e28a7df4866da553ee53dc7578468910b0606"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-76476"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069302/assets/9fd222d255fd1a37f00cbe7c9abf6af0d0e3af92f9ac581591bb1062780e69fa.png)\n\nWhich of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $C$ is the closed polygonal path $ABCA,$ shown in the diagram above, traversed in the **clockwise** direction?" :question/worked-solution "First, notice that we can represent $C,$ which is traversed clockwise, as the union of $3$ paths:\n\n$$\nC={-{C}_{1}}\\cup {C}_{2}\\cup {-{C}_{3}},\n$$\n\nwhere $-{C}_{1}$ and $-{C}_{3}$ are the same paths as ${C}_{1}$ and ${C}_{3}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{-{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{-{C}_{3}}F\\cdot \\text{d}r \\\\  & =-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-76476/selection/ma-v1/4f97d1cab2af4460a0cc4002a6a77e78e7e0816c9070a5b516611f65a409b621"] :db/ensure [:question/validate]} {:db/id "q-77138/selection/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" :answer/id #uuid "f15fc8a4-499b-5df5-b3db-feea0aab19cb" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77138/selection/f47739a8ffa56e1c1475de0d5b0b439e01e2abe6ed718f59aca03796d9b5164d" :answer/id #uuid "c914423a-6e9a-5baa-8011-ebf492f74f5e" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77138/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" :answer/id #uuid "0f06d9b8-f9b1-56ea-a95b-999bab3d5f65" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77138/selection/0eb26a40acaca9cea6115682e086ac98f768a095f98f0f6c055016c6e0fbe9d3" :answer/id #uuid "90fc1fbc-c280-5894-9e46-b3ff4d018189" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77138/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f" :answer/id #uuid "bee3a55c-683f-58e8-a571-64f541ee050b" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77138/selection" :answer-field/id #uuid "5da77b03-8105-535f-af40-d35df51c9647" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77138/selection/0eb26a40acaca9cea6115682e086ac98f768a095f98f0f6c055016c6e0fbe9d3" :answer-field/choices ["q-77138/selection/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" "q-77138/selection/f47739a8ffa56e1c1475de0d5b0b439e01e2abe6ed718f59aca03796d9b5164d" "q-77138/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" "q-77138/selection/0eb26a40acaca9cea6115682e086ac98f768a095f98f0f6c055016c6e0fbe9d3" "q-77138/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f"] :db/ensure [:answer-field/validate]} {:db/id "q-77138" :question/id #uuid "5e888134-eb3b-5fc5-bc68-dfef9821c1b8" :question/math-academy-id "q-77138" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069302/assets/3121d24ea2b9eac3d95c34202619800331d4719c786b8f5a1051350370a1bea2.png)\n\nWhich of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $C$ is the closed polygonal path $TUVT,$ shown in the diagram above, traversed in the **clockwise** direction?" :question/worked-solution "First, notice that we can represent $C,$ which is traversed in clockwise, as the union of $3$ paths:\n\n$$\nC={-{C}_{1}}\\cup {C}_{2}\\cup {C}_{3},\n$$\n\nwhere $-{C}_{1}$ is the same path as ${C}_{1}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{-{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r \\\\  & =-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77138/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "70b4357f-d5c5-5946-9022-0602c4217a1d"] :knowledge-point/questions ["q-77138"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77182/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "3a01d6c1-bef2-5b92-9e56-899d4f0e493e" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-77182/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "46ab4da4-214f-5ea2-9300-7d2c6df1ae2c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-77182/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer/id #uuid "7e1a9133-6fd1-5aec-ba42-2d93ef6bdfb5" :answer/type :answer.type/math :answer/value "\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "q-77182/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e27c24c3-00e0-5c61-a7d7-30715a34d5d8" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-77182/selection/b937b5a9c9148a5914243385a1d84bacb019d6c5ff771ce01182a0f3091b9285" :answer/id #uuid "c5087f29-2701-5b97-83bf-7259e855f1db" :answer/type :answer.type/math :answer/value "\\frac{8}{5}" :db/ensure [:answer/validate]} {:db/id "q-77182/selection" :answer-field/id #uuid "d5c3e3f2-885c-54e8-a2d6-677ac96e440b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77182/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" :answer-field/choices ["q-77182/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-77182/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-77182/selection/80f9bea33aa6a89d127ee9002c35787893c3c59b57df469ba089cea1a4a6a472" "q-77182/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-77182/selection/b937b5a9c9148a5914243385a1d84bacb019d6c5ff771ce01182a0f3091b9285"] :db/ensure [:answer-field/validate]} {:db/id "q-77182" :question/id #uuid "223216ba-852e-5d29-a251-0152d4edcfb4" :question/math-academy-id "q-77182" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069302/assets/6087da076e65bda5240c428ff67c570ad59ae9a8e5a5a3c9e8406184998de56a.png)\n\nThe path ${C}_{1}$ consists of a the line segment from the point $O(0,0)$ to the point $A(1,0),$ and the path ${C}_{2}$ consists of a line segment from the point $A(1,0)$ to the point $B(0,-2).$\n\nGiven that ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=\\frac{7}{3},$ evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=({x}^{2}+y)\\,i+(x-{y}^{2})\\,j,$ and $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "We will use the fact that\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r.\n$$\n\nWe're given the value of the second integral, so we only need to work out the first.\n\nThe path ${C}_{1}$ is the horizontal line segment from $O$ to $A.$ It can be parametrized as\n\n$$\n\\begin{aligned}{r}_{1}(t) & =0+t(a-0) \\\\  & =⟨0,0⟩+t(⟨1,0⟩-⟨0,0⟩) \\\\  & =⟨t,0⟩ \\\\  & =t\\,i,\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=t$ and $y=0.$ Therefore, \n\n$$\n\\begin{aligned}F({r}_{1}(t)) & =({x}^{2}+y)\\,i+(x-{y}^{2})\\,j \\\\  & =({t}^{2}+0)\\,i+(t-{0}^{2})\\,j \\\\  & ={t}^{2}\\,i+t\\,j.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{r}_{1}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(0)j \\\\  & =i\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t) & =({t}^{2}\\,i+t\\,j)\\cdot (i) \\\\  & ={t}^{2}\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r \\\\  & ={\\int }_{0}^{1}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t)\\,\\text{d}t+\\frac{7}{3} \\\\  & ={\\int }_{0}^{1}{t}^{2}\\,\\text{d}t+\\frac{7}{3} \\\\  & =\\frac{1}{3}{t}^{3}\\,{|}_{0}^{1}+\\frac{7}{3} \\\\  & =(\\frac{1}{3}-0)+\\frac{7}{3} \\\\  & =\\frac{1}{3}+\\frac{7}{3} \\\\  & =\\frac{8}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77182/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5ce5418-6b75-5efa-b7f9-99ee16c510be"] :knowledge-point/questions ["q-77182"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77185/selection/0a7f84ce6a5311ee2a131d459729f4ba2610ffac28c52f629e461ace99cdaa88" :answer/id #uuid "3d87b00e-a677-5d78-b909-1ac1401ff81c" :answer/type :answer.type/math :answer/value "-\\frac{15}{2}" :db/ensure [:answer/validate]} {:db/id "q-77185/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "de8d659d-0751-55a0-a526-27e17183816f" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-77185/selection/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" :answer/id #uuid "67f797c6-8f97-52d1-9a81-aa74e2aff1ae" :answer/type :answer.type/math :answer/value "-\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-77185/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "9546d485-e9fe-5dd5-9167-e3f9bc7c7639" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-77185/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "84d4434a-e3f5-5482-af06-a30265b7ecd7" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-77185/selection" :answer-field/id #uuid "64464526-a56e-56fc-b602-ecc6fc0103e2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77185/selection/0a7f84ce6a5311ee2a131d459729f4ba2610ffac28c52f629e461ace99cdaa88" :answer-field/choices ["q-77185/selection/0a7f84ce6a5311ee2a131d459729f4ba2610ffac28c52f629e461ace99cdaa88" "q-77185/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-77185/selection/8e918182341451051ce2dca07cfe2b17fa3abe4a925a8df02308f239a4dd798f" "q-77185/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-77185/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-77185" :question/id #uuid "70aabb4e-a948-5d21-a14d-e3abdf21c8a1" :question/math-academy-id "q-77185" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069302/assets/c0a4f042748ddadd824bed4ee71bca9724d7ca7dcc376a0ccf7c1353d59ec4fc.png)\n\nThe path ${C}_{1}$ consists of a line segment from the point $A(-2,2)$ to the point $B(-1,2),$ and the path ${C}_{2}$ consists of a line segment from the point $B(-1,2)$ to the point $D(-1,0).$\n\nGiven that ${\\int }_{{C}_{1}}F\\cdot \\text{d}r=-\\frac{7}{2},$ evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=(x-y)\\,i+(y-x)\\,j,$ and $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "We will use the fact that\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r.\n$$\n\nWe're given the value of the first integral, so we only need to work out the second.\n\nThe path ${C}_{2}$ is the vertical line segment from $B$ to $D.$ It can be parametrized as\n\n$$\n\\begin{aligned}{r}_{2}(t) & =b+t(d-b) \\\\  & =⟨-1,2⟩+t(⟨-1,0⟩-⟨-1,2⟩) \\\\  & =⟨-1,2-2t⟩ \\\\  & =-\\,i+(2-2t)\\,j,\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=-1$ and $y=2-2t.$ Therefore, \n\n$$\n\\begin{aligned}F({r}_{2}(t)) & =(x-y)\\,i+(y-x)\\,j \\\\  & =(-1-(2-2t))\\,i+(2-2t-(-1))\\,j \\\\  & =(-3+2t)\\,i+(3-2t)\\,j.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{r}_{2}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(-1)i+\\frac{\\text{d}}{\\text{d}t}(2-2t)j \\\\  & =-2\\,j\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}F({r}_{2}(t))\\cdot {r}_{2}^{′}(t) & =((-3+2t)\\,i+(3-2t)\\,j)\\cdot (-2\\,j) \\\\  & =(3-2t)\\cdot (-2) \\\\  & =4t-6\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r \\\\  & =-\\frac{7}{2}+{\\int }_{0}^{1}F({r}_{2}(t))\\cdot {r}_{2}^{′}(t)\\,\\text{d}t \\\\  & =-\\frac{7}{2}+{\\int }_{0}^{1}(4t-6)\\,\\text{d}t \\\\  & =-\\frac{7}{2}+[2{t}^{2}-6t]_{0}^{1} \\\\  & =-\\frac{7}{2}+[2({1}^{2})-6(1)-0] \\\\  & =-\\frac{7}{2}-4 \\\\  & =-\\frac{15}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77185/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5ce5418-6b75-5efa-b7f9-99ee16c510be"] :knowledge-point/questions ["q-77185"] :db/ensure [:knowledge-point/validate]} {:db/id "q-125413/selection/b3466cca3b8818f44dda2b600fda7b96c30a7b1afab3b700f217539b42f0ca39" :answer/id #uuid "f1a6266e-89b0-571c-9a79-dc6b8403720c" :answer/type :answer.type/math :answer/value "{\\int }_{C}2z\\,\\text{d}x+3x\\,\\text{d}y-4y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-125413/selection/7b65cca88109ae55591f548e1c3a5c13b561f02c25df742d336e7b08392c304a" :answer/id #uuid "9a7020f5-a843-576e-b61f-411e39cd6c2b" :answer/type :answer.type/math :answer/value "{\\int }_{C}-4y\\,\\text{d}x+2z\\,\\text{d}y+3x\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-125413/selection/9da99bd44e8089cdb185a324918ef88bbae46c6644dacb6a1bd8380834437a3e" :answer/id #uuid "be80cec7-a514-5400-8c64-3516fde7acb3" :answer/type :answer.type/math :answer/value "{\\int }_{C}(2z+3x-4y)\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-125413/selection/fa20c1e7e0bf2dbf9e12ba0fe6fdb24e357590ff4439e2bbf1222ca38d4befe6" :answer/id #uuid "2ef21edd-0f37-5c90-854f-19ce32843ff4" :answer/type :answer.type/math :answer/value "{\\int }_{C}3x\\,\\text{d}x-4y\\,\\text{d}y+2z\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-125413/selection/d7d7830ffddc96aa8f5d260938a612658b9258368647a360f6828ecf173304c1" :answer/id #uuid "64681851-a737-5da3-b117-29ae8f673b47" :answer/type :answer.type/math :answer/value "{\\int }_{C}2\\,\\text{d}x+3\\,\\text{d}y-4\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-125413/selection" :answer-field/id #uuid "d74d1e46-0258-52ef-8ff6-17e3b3961433" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-125413/selection/b3466cca3b8818f44dda2b600fda7b96c30a7b1afab3b700f217539b42f0ca39" :answer-field/choices ["q-125413/selection/b3466cca3b8818f44dda2b600fda7b96c30a7b1afab3b700f217539b42f0ca39" "q-125413/selection/7b65cca88109ae55591f548e1c3a5c13b561f02c25df742d336e7b08392c304a" "q-125413/selection/9da99bd44e8089cdb185a324918ef88bbae46c6644dacb6a1bd8380834437a3e" "q-125413/selection/fa20c1e7e0bf2dbf9e12ba0fe6fdb24e357590ff4439e2bbf1222ca38d4befe6" "q-125413/selection/d7d7830ffddc96aa8f5d260938a612658b9258368647a360f6828ecf173304c1"] :db/ensure [:answer-field/validate]} {:db/id "q-125413" :question/id #uuid "f6568490-f28b-51b2-8a83-ff4a151c3cd9" :question/math-academy-id "q-125413" :question/problem "Let $F(x,y,z)=2z\\,i+3x\\,j-4y\\,k$ and let $C$ be a path in ${R}^{3}.$ Which of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r?$" :question/worked-solution "Given a piecewise-smooth path $C$ and a vector field \n\n$$\nF(x,y,z)=P(x,y,z)\\,i+Q(x,y,z)\\,j+R(x,y,z)\\,k\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{C}P(x,y,z)\\,\\text{d}x+Q(x,y,z)\\,\\text{d}y+R(x,y,z)\\,\\text{d}z.\n$$\n\nTherefore, in our case, we obtain \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{C}2z\\,\\text{d}x+3x\\,\\text{d}y-4y\\,\\text{d}z.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-125413/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bed301c-59ac-5cb3-85e4-4aeaeebc15c2"] :knowledge-point/questions ["q-125413"] :db/ensure [:knowledge-point/validate]}]
