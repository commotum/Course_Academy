{z}^{3}\\,dy\\,dz & ={\\int }_{0}^{1}[{\\int }_{0}^{2}9+12{z}^{3}+9{y}^{2}\\,dy]dz \\\\  & ={\\int }_{0}^{1}[(9+12{z}^{3})y+3{y}^{3}]_{y=0}^{y=2}\\,dz \\\\  & ={\\int }_{0}^{1}(9+12{z}^{3})(2-0)+3(8-0)\\,dz \\\\  & ={\\int }_{0}^{1}18+24{z}^{3}+24\\,dz \\\\  & ={\\int }_{0}^{1}42+24{z}^{3}\\,dz\\end{aligned}\n$$\n\nFinally, we integrate with respect to $z:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}42+24{z}^{3}\\,dz & =[42z+6{z}^{4}]_{z=0}^{z=1} \\\\  & =42(1-0)+6(1-0) \\\\  & =48\\end{aligned}\n$$" 13194139535747 true] [17592186364628 1000 #edb/ref 17592186364629 13194139535747 true] [17592186364628 1000 #edb/ref 17592186364630 13194139535747 true] [17592186364628 1000 #edb/ref 17592186364631 13194139535747 true] [17592186364628 1000 #edb/ref 17592186364632 13194139535747 true] [17592186364628 1000 #edb/ref 17592186364633 13194139535747 true] [17592186364628 1040 #edb/ref 17592186045450 13194139535747 true] [17592186364628 1041 "selection" 13194139535747 true] [17592186364628 1104 #edb/ref 17592186364631 13194139535747 true] [17592186364628 1110 #uuid "759db459-2786-5a1e-8f86-e3fb671492bb" 13194139535747 true] [17592186364629 1034 "26" 13194139535747 true] [17592186364629 1103 #edb/ref 17592186045453 13194139535747 true] [17592186364629 1111 #uuid "79d74311-7572-5aec-a4c8-ad95a32d6d54" 13194139535747 true] [17592186364630 1034 "36" 13194139535747 true] [17592186364630 1103 #edb/ref 17592186045453 13194139535747 true] [17592186364630 1111 #uuid "dea85c0b-f5f7-5feb-b79d-b540f1ead0b4" 13194139535747 true] [17592186364631 1034 "48" 13194139535747 true] [17592186364631 1103 #edb/ref 17592186045453 13194139535747 true] [17592186364631 1111 #uuid "a4122072-ec99-58ca-a3bc-0d766f458a6e" 13194139535747 true] [17592186364632 1034 "54" 13194139535747 true] [17592186364632 1103 #edb/ref 17592186045453 13194139535747 true] [17592186364632 1111 #uuid "aed6811c-cc1d-5ad9-8cb6-21ff718624ab" 13194139535747 true] [17592186364633 1034 "18" 13194139535747 true] [17592186364633 1103 #edb/r