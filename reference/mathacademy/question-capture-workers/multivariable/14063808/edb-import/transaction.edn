[{:db/id "q-15639/selection/6d79a1991177ca44767e241a78ce3a56b956610ca6503c63deaa6dbb22431c13" :answer/id #uuid "67981fba-8b7b-5aca-ae3c-86c44d2d765d" :answer/type :answer.type/math :answer/value "1+(x-\\frac{\\pi }{4})-{(x-\\frac{\\pi }{4})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15639/selection/a751ac47736ff14e09e7d78081f44900f18d79e7db87a7b85d64c1b76fdaf399" :answer/id #uuid "cfacc6ac-8414-5223-96d0-45d26a13bcf6" :answer/type :answer.type/math :answer/value "1+4(x-\\frac{\\pi }{4})+4{(x-\\frac{\\pi }{4})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15639/selection/c93bddf404eb17f48a6f87c0ec760eed32c748f5b0aa1a6040420e27d500c31d" :answer/id #uuid "21d1ec86-5f56-57db-a9e5-b8d22bfc00aa" :answer/type :answer.type/math :answer/value "1+2(x-\\frac{\\pi }{4})+2{(x-\\frac{\\pi }{4})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15639/selection/72895e887e3f564e8c36875fc7f59b6cd429befcc64effcf9dc4706ff00a88ec" :answer/id #uuid "9978aa49-945d-5279-a0f2-c5bf0f2458c0" :answer/type :answer.type/math :answer/value "1+4(x-\\frac{\\pi }{4})+{(x-\\frac{\\pi }{4})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15639/selection/7837333ab4a09106c09af630a3c632f1e6ec3f6eb2847a194b421b67b128d84d" :answer/id #uuid "0cefc7e7-93ae-52cc-8d05-c2c58f0a0b1a" :answer/type :answer.type/math :answer/value "1+(x-\\frac{\\pi }{4})+4{(x-\\frac{\\pi }{4})}^{2}" :db/ensure [:answer/validate]} {:db/id "q-15639/selection" :answer-field/id #uuid "48ba0d34-03aa-5c01-9d1a-e255f69d5396" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15639/selection/c93bddf404eb17f48a6f87c0ec760eed32c748f5b0aa1a6040420e27d500c31d" :answer-field/choices ["q-15639/selection/6d79a1991177ca44767e241a78ce3a56b956610ca6503c63deaa6dbb22431c13" "q-15639/selection/a751ac47736ff14e09e7d78081f44900f18d79e7db87a7b85d64c1b76fdaf399" "q-15639/selection/c93bddf404eb17f48a6f87c0ec760eed32c748f5b0aa1a6040420e27d500c31d" "q-15639/selection/72895e887e3f564e8c36875fc7f59b6cd429befcc64effcf9dc4706ff00a88ec" "q-15639/selection/7837333ab4a09106c09af630a3c632f1e6ec3f6eb2847a194b421b67b128d84d"] :db/ensure [:answer-field/validate]} {:db/id "q-15639" :question/id #uuid "6f9cde73-40ae-547d-802a-7ec567609306" :question/math-academy-id "q-15639" :question/problem "The second-degree Taylor polynomial of $f(x)=\\operatorname{tan}⁡(x)$ about $x=\\frac{\\pi }{4}$ is" :question/worked-solution "To find the second-degree Taylor polynomial about $x=\\frac{\\pi }{4},$ we plug $a=\\frac{\\pi }{4}$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(\\frac{\\pi }{4})+{f}^{′}(\\frac{\\pi }{4})(x-\\frac{\\pi }{4})+\\frac{1}{2}{f}^{″}(\\frac{\\pi }{4}){(x-\\frac{\\pi }{4})}^{2}.\n$$\n\nSo, we need to work out $f(\\frac{\\pi }{4}),$ ${f}^{′}(\\frac{\\pi }{4}),$ and ${f}^{″}(\\frac{\\pi }{4}):$ \n\n$$\n\\begin{aligned}f(x) & =\\operatorname{tan}⁡(x) & ⟹ &  & f(\\frac{\\pi }{4}) & =1 \\\\ {f}^{′}(x) & =\\frac{1}{{cos}^{2}⁡(x)} & ⟹ &  & {f}^{′}(\\frac{\\pi }{4}) & =2 \\\\ {f}^{″}(x) & =\\frac{2\\operatorname{sin}⁡(x)}{{cos}^{3}⁡(x)} & ⟹ &  & {f}^{″}(\\frac{\\pi }{4}) & =4\\end{aligned}\n$$\n\nWe now plug the results for $f(\\frac{\\pi }{4}),$ ${f}^{′}(\\frac{\\pi }{4}),$ and ${f}^{″}(\\frac{\\pi }{4})$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =1+2(x-\\frac{\\pi }{4})+4\\cdot \\frac{1}{2}{(x-\\frac{\\pi }{4})}^{2} \\\\  & =1+2(x-\\frac{\\pi }{4})+2{(x-\\frac{\\pi }{4})}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15639/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4"] :knowledge-point/questions ["q-15639"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81060/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "8c3e4a6f-bb35-5f43-b43d-e91147eac604" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-81060/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c4669e03-32fe-58aa-8503-d66e52690501" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-81060/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "e131caab-868e-50ca-b2b4-233299b291d8" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-81060/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "6234f610-391c-5987-8321-7b60d3b19e45" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-81060/selection/8edf36f0d0c04b8e0e3f881a66fab0f1901a06368d5ca1f6d437f77714de6bc5" :answer/id #uuid "4fce059c-05a0-5ca8-a7a1-36aa6f74e5b6" :answer/type :answer.type/math :answer/value "-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-81060/selection" :answer-field/id #uuid "386f2634-6a02-5424-a30e-4354f55e1520" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81060/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-81060/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-81060/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-81060/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-81060/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-81060/selection/8edf36f0d0c04b8e0e3f881a66fab0f1901a06368d5ca1f6d437f77714de6bc5"] :db/ensure [:answer-field/validate]} {:db/id "q-81060" :question/id #uuid "1446f41e-fdd3-5f5c-9f6f-940b5c967764" :question/math-academy-id "q-81060" :question/problem "What is the coefficient of $(x-\\pi )^{2}$ in the second-degree Taylor polynomial of $f(x)=\\operatorname{cos}⁡x$ at $x=\\pi ?$" :question/worked-solution "The second-degree Taylor polynomial of $f(x)$ about $x=\\pi $ is given by\n\n$$\n\\begin{aligned}{P}_{2}(x) & =f(\\pi )+{f}^{′}(\\pi )(x-\\pi )+\\frac{{f}^{″}(\\pi )}{2}(x-\\pi )^{2}.\\end{aligned}\n$$\n\nThe coefficient of $(x-\\pi )^{2}$ in the above Taylor polynomial is \n\n$$\n\\frac{1}{2}{f}^{″}(\\pi ).\n$$\n\nTo find this coefficient, we start by computing the second derivative ${f}^{″}(x):$ \n\n$$\n\\begin{aligned}f(x) & =\\operatorname{cos}⁡x \\\\ {f}^{′}(x) & =-\\operatorname{sin}⁡x \\\\ {f}^{″}(x) & =-\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nThen, we evaluate ${f}^{″}(x)$ at $x=\\pi .$ This gives\n\n$$\n{f}^{″}(\\pi )=-\\operatorname{cos}⁡(\\pi )=-(-1)=1.\n$$\n\nFinally, we determine the coefficient of $(x-\\pi )^{2},$ as follows:\n\n$$\n\\begin{aligned}\\frac{{f}^{″}(\\pi )}{2} & =\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81060/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "039f9f0b-70dd-5360-9240-2260ff706c93"] :knowledge-point/questions ["q-81060"] :db/ensure [:knowledge-point/validate]} {:db/id "q-347466/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "b314e82c-c376-5f16-a296-e0f1868064c1" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-347466/field-1" :answer-field/id #uuid "078a3e91-6106-5938-859d-451323231709" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347466/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-347466/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-347466/field-2/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "e5e4091b-73f7-57b4-8f45-dec53f6acfb7" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-347466/field-2" :answer-field/id #uuid "38abe5a2-3c2e-5153-8bfc-061d892a6ba8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347466/field-2/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer-field/choices ["q-347466/field-2/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d"] :db/ensure [:answer-field/validate]} {:db/id "q-347466/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "7798ecc6-3643-5cec-9857-5b025e3b6aee" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-347466/field-3" :answer-field/id #uuid "d064edb9-0923-55ee-a1b4-e037e0f6eaf6" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347466/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-347466/field-3/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-347466" :question/id #uuid "e0cf8efa-6fc7-5bd2-bd5d-4aeaac7ec023" :question/math-academy-id "q-347466" :question/problem "Find the second-degree Taylor polynomial ${P}_{2}(x)$ of $f(x)=\\frac{1}{1-\\sqrt{2}\\,x}$ about $x=0.$\n\n${P}_{2}(x)=$\n{{field-1}}$\\,+$\n{{field-2}}$\\,x\\,+$\n{{field-3}}$\\,{x}^{2}$" :question/worked-solution "To find the second-degree Taylor polynomial about $x=0,$ we plug $a=0$ into the general formula to give\n\n$$\n{P}_{2}(x)=f(0)+{f}^{′}(0)(x-0)+\\frac{1}{2}{f}^{″}(0)(x-0)^{2}.\n$$\n\nSo, we need to work out $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0):$ \n\n$$\n\\begin{aligned}f(x) & =\\frac{1}{1-\\sqrt{2}\\,x}=(1-\\sqrt{2}\\,x)^{-1} & ⟹ &  & f(0) & =1 \\\\ {f}^{′}(x) & =\\sqrt{2}(1-\\sqrt{2}\\,x)^{-2} & ⟹ &  & {f}^{′}(0) & =\\sqrt{2} \\\\ {f}^{″}(x) & =4(1-\\sqrt{2}\\,x)^{-3} & ⟹ &  & {f}^{″}(0) & =4\\end{aligned}\n$$\n\nWe now plug the results for $f(0),$ ${f}^{′}(0),$ and ${f}^{″}(0)$ into our second-degree Taylor polynomial. This gives\n\n$$\n\\begin{aligned}{P}_{2}(x) & =1+\\sqrt{2}\\,x+4\\cdot \\frac{1}{2}{x}^{2} \\\\  & =1+\\sqrt{2}\\,x+2\\,{x}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-347466/field-1" "q-347466/field-2" "q-347466/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "33159d0b-24b5-587e-89e1-b545c2be59c4"] :knowledge-point/questions ["q-347466"] :db/ensure [:knowledge-point/validate]}]
