-point/questions ["q-121273"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121269/selection/f208f7bf57094476ea52c3e51eab3e7664e39d5bddf21311d32cd52b188af478" :answer/id #uuid "ecd4430c-edfb-58d2-ab52-875ef5d09c0e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/d0f7d9eedffeb6955deab3d670b7ecd36203a79f7eab9cbdeaa713be52ed15d8.png" :db/ensure [:answer/validate]} {:db/id "q-121269/selection/42c28ded91fad4118600dc6223dc30f31a079f38a876a0fa39e6db4d0de9834a" :answer/id #uuid "dc8b8288-bf1e-5053-8626-a762fdf8c953" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/ccc98a2beb22904a810ba0bd7f6f74b2d38ee58cf62d344f4714f1cf8dcc1aa0.png" :db/ensure [:answer/validate]} {:db/id "q-121269/selection/e1b047fa5a68707fda6e9777b4b375deb451e43afe0ba2fa9281398f8d9ac1db" :answer/id #uuid "c6de38eb-1742-563d-b11e-336d0b3e77dc" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/90ab47aa1a7c9ab58291318337289e1bce08050acaaaf9f4fb7e6a3b74731457.png" :db/ensure [:answer/validate]} {:db/id "q-121269/selection/4ca72fa751043e5265181563de3a098db8ed3405996944e2e1c8491936737f4c" :answer/id #uuid "250bbb5e-46bf-58d3-aebc-a62377144003" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/d4a2bce7ff44e32d9fd4dfbcc892bd473e025d1305cfa40514a0f9892caff622.png" :db/ensure [:answer/validate]} {:db/id "q-121269/selection/efc00de6c053bd3629cc7b9c65e13492d9748716f6e93109d0d43bcc5b70bdce" :answer/id #uuid "02cbdf42-a499-5410-8a32-db1dccc1eb88" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/9edcf28abdd93e2a789fd513605bc31de04913edea476b485555cddcdd07bb76.png" :db/ensure [:answer/validate]} {:db/id "q-121269/selection" :answer-field/id #uuid "280f375f-3d0b-5c54-a1d2-1cb50d36feff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121269/selection/4ca72fa751043e5265181563de3a098db8ed3405996944e2e1c8491936737f4c" :answer-field/choices ["q-121269/selection/f208f7bf57094476ea52c3e51eab3e7664e39d5bddf21311d32cd52b188af478" "q-121269/selection/42c28ded91fad4118600dc6223dc30f31a079f38a876a0fa39e6db4d0de9834a" "q-121269/selection/e1b047fa5a68707fda6e9777b4b375deb451e43afe0ba2fa9281398f8d9ac1db" "q-121269/selection/4ca72fa751043e5265181563de3a098db8ed3405996944e2e1c8491936737f4c" "q-121269/selection/efc00de6c053bd3629cc7b9c65e13492d9748716f6e93109d0d43bcc5b70bdce"] :db/ensure [:answer-field/validate]} {:db/id "q-121269" :question/id #uuid "dda91e78-ace9-56d2-8473-dec09b0b5a79" :question/math-academy-id "q-121269" :question/problem "Suppose that $f(x,y)=y(x-1).$ Which of the following shaded areas gives the solution to the inequality $f(x,y)>0?$" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=1$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below. Since we have a strict inequality, we use dashed lines to divide the plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/3e5663e03b92fc2be3deea9480f5314cff001cab66bfc7242837f72fbd825b69.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/a143baf42225cd4959987aa1e12abab084e4949092c7c18a1a4a2ec401cf744c.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(x-1)$ | $y$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(0,1)$ | $-$ | $+$ | $-$ |\n| Top-Right | $(2,1)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(0,-1)$ | $-$ | $-$ | $+$ |\n| Bottom-Right | $(2,-1)$ | $+$ | $-$ | $-$ |\n\n \n\nFinally, on our diagram, we shade in the solutions to $f(x,y)>0$ using the *last* column of the table above.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/fd46cb5d9bd91bc73bd152ca41e55ca32ba8af67870c132c906d63bb32f7c961.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121269/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ef881ff-71d4-5268-9cac-32c478dc02a5"] :knowledge-point/questions ["q-121269"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-9412"] :question/worked-solution "Notice that $f(x,y)$ equals zero when $x = 3$ and $y = -1.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/df8519853487a7da738b4b3c477b141e00287c67dcb9eb804cbd385c6f43b611.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/4666739c474f85cbf8de7e7ca183206ab7b0bd804816a5504f9c1d97b03956b4.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(3-x)$ | $(y+1)^2$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-left | $(2,0)$ | $\\color{blue}+$ | $\\color{blue}+$ | $\\color{blue}+$ |\n| Top-Right | $(4,0)$ | $\\color{red}-$ | $\\color{blue}+$ | $\\color{red}-$ |\n| Bottom-Left | $(2,-2)$ | $\\color{blue}+$ | $\\color{blue}+$ | $\\color{blue}+$ |\n| Bottom-Right | $(4,-2)$ | $\\color{red}-$ | $\\color{blue}+$ | $\\color{red}-$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/e789ce41c696b456e0c9d79ba8ce60aba030e454ab614902ea13c8d9ccd02d8c.png)\n\nFinally, we fill in the required sign table.\n\n| $y > -1$ | $\\color{blue}+$ | $\\color{red}-$ |\n| --- | --- | --- |\n| $y <               -1$ | $\\color{blue}+$ | $\\color{red}-$ |\n|  | $x<  3$ | $x> 3$ |" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-9414"] :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=2$ and $y=-1.$ These lines divide the $xy$-plane into four regions, as shown below. Since we have a strict inequality, we use dashed lines to divide the plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/8e635d2ba2e7ca5721ff8b1dec2055b4ac0c9bcc2eca648848c27190271e92b6.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/1ce934096086de33423910710a010400922ea86c66bbfe0b1bfb0d92291ab59e.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(x-2)^2$ | $(y+1)$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(1,0)$ | $\\color{blue}+$ | $\\color{blue}+$ | $\\color{blue}+$ |\n| Top-Right | $(3,0)$ | $\\color{blue}+$ | $\\color{blue}+$ | $\\color{blue}+$ |\n| Bottom-Left | $(1,-2)$ | $\\color{blue}+$ | $\\color{red}-$ | $\\color{red}-$ |\n| Bottom-Right | $(3,-2)$ | $\\color{blue}+$ | $\\color{red}-$ | $\\color{red}-$ |\n\n \n\nFinally, on our diagram, we shade in the solutions to $f(x,y) > 0$ using the *last* column of the table above.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/70a2ca01e47e91f9d818599886f79b0f00edad0cfd12b080995dfbe6cdf68235.png)" :db/ensure [:question/validate]}]
