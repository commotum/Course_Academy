[{:db/id "q-121315/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" :answer/id #uuid "9a7081f2-ee29-517a-8ab1-cba3663d6952" :answer/type :answer.type/text :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121315/selection/8aeecd39a62f0e7e086a13b8dc6247818469757a2ad4c68d10219db33e06a8ac" :answer/id #uuid "595db54d-029c-5b8c-9cf3-6dbcce8946ca" :answer/type :answer.type/text :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $-$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121315/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" :answer/id #uuid "d3e8113a-e541-5523-9c3a-85702632c730" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121315/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer/id #uuid "ec99ccc6-d5e1-53cc-a83c-373f6274e168" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121315/selection/bab4acf5ca3a66ed4f11bbcf7574627e6848417923ee89f9393917451c190309" :answer/id #uuid "17a8cb03-d5df-5abb-af23-ae68fb70eb2c" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121315/selection" :answer-field/id #uuid "df60aade-9354-5d57-88b7-312f1624cf1c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121315/selection/bab4acf5ca3a66ed4f11bbcf7574627e6848417923ee89f9393917451c190309" :answer-field/choices ["q-121315/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" "q-121315/selection/8aeecd39a62f0e7e086a13b8dc6247818469757a2ad4c68d10219db33e06a8ac" "q-121315/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" "q-121315/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" "q-121315/selection/bab4acf5ca3a66ed4f11bbcf7574627e6848417923ee89f9393917451c190309"] :db/ensure [:answer-field/validate]} {:db/id "q-121315" :question/id #uuid "eb7ad426-51c5-57d1-8778-32a1d21ccb44" :question/math-academy-id "q-121315" :question/problem "Consider the function $f(x,y)=-y(x-2).$ What are the missing entries in the following sign table of $f(x,y)?$\n\n| $y>0$ |  |  |\n| --- | --- | --- |\n| $y<0$ |  |  |\n|  | $x<2$ | $x>2$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=2$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/41e876c3444c2fc9a5103c16b9c6c3b34a4c7596082e4c8235a5e86cd57f8570.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/c21e4edde44891c4173420575268750fc0f1f407ba8503953de86a9cc72297dc.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $-y$ | $(x-2)$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(1,1)$ | $-$ | $-$ | $+$ |\n| Top-Right | $(3,1)$ | $-$ | $+$ | $-$ |\n| Bottom-Left | $(1,-1)$ | $+$ | $-$ | $-$ |\n| Bottom-Right | $(3,-1)$ | $+$ | $+$ | $+$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/b668aa9647600567c5d6deccbe3830a26561c06f920e2db2364e632f26c39eff.png)\n\nFinally, we fill in the required sign table.\n\n| $y>0$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<0$ | $-$ | $+$ |\n|  | $x<2$ | $x>2$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121315/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d8033e21-86ab-5dc6-8060-a0b5c134bf9d"] :knowledge-point/questions ["q-121315"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149548/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" :answer/id #uuid "051e2a0a-b740-5ffa-9b8a-f140254282e5" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-149548/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" :answer/id #uuid "c7f8afcf-22c3-515d-9a90-7fc4324a481a" :answer/type :answer.type/text :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-149548/selection/c8a570a7a45299d6bca7534749498af91d95f2281bdd8454030e707cf44ee838" :answer/id #uuid "ae5d44d1-bb64-52f0-9fca-97455afedfd7" :answer/type :answer.type/text :answer/value "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-149548/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer/id #uuid "bedd5892-27ac-5fa1-aa42-fb4729a2c742" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-149548/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" :answer/id #uuid "7d1cad7a-b673-5c45-93ba-7d130b9fc391" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-149548/selection" :answer-field/id #uuid "abe48cc3-ae93-5420-9056-c85e6a758e72" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149548/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer-field/choices ["q-149548/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" "q-149548/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" "q-149548/selection/c8a570a7a45299d6bca7534749498af91d95f2281bdd8454030e707cf44ee838" "q-149548/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" "q-149548/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054"] :db/ensure [:answer-field/validate]} {:db/id "q-149548" :question/id #uuid "8fb709d8-90a5-57a1-95a3-b0285559ae32" :question/math-academy-id "q-149548" :question/problem "Consider the function $f(x,y)=(1-x)(y+2)^{2}.$ What are the missing entries in the following sign table of $f(x,y)?$\n\n| $y>-2$ |  |  |\n| --- | --- | --- |\n| $y<-2$ |  |  |\n|  | $x<1$ | $x>1$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=1$ and $y=-2.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/345665733b6554a7cea9b54a4ca4e93b6d478d67231cfaf3f6180cf0a75c4b1a.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/4058b0f027297faf71756da7cad372b76aae980657f053b95318115889c1d614.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $1-x$ | $(y+2)^{2}$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(0,-1)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(2,-1)$ | $-$ | $+$ | $-$ |\n| Bottom-Left | $(0,-3)$ | $+$ | $+$ | $+$ |\n| Bottom-Right | $(2,-3)$ | $-$ | $+$ | $-$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/fc54a4044465d485d4eb55aa8dd81c0e952e8dd56528bc2874bcc67dcffbf3c8.png)\n\nFinally, we fill in the required sign table.\n\n| $y>-2$ | $+$ | $-$ |\n| --- | --- | --- |\n| $y<-2$ | $+$ | $-$ |\n|  | $x<1$ | $x>1$ |" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-149548/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d8033e21-86ab-5dc6-8060-a0b5c134bf9d"] :knowledge-point/questions ["q-149548"] :db/ensure [:knowledge-point/validate]} {:db/id "q-326449/field-1/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer/id #uuid "84593211-0c2a-5fe4-b2d3-29dbd7f19dc8" :answer/type :answer.type/math :answer/value "-" :db/ensure [:answer/validate]} {:db/id "q-326449/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer/id #uuid "bb8fe931-280f-5c63-a034-f404f93c57a6" :answer/type :answer.type/math :answer/value "+" :db/ensure [:answer/validate]} {:db/id "q-326449/field-1" :answer-field/id #uuid "329fadcf-2ad1-56ef-aa6a-d4f24327f8b1" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-326449/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer-field/choices ["q-326449/field-1/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" "q-326449/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949"] :db/ensure [:answer-field/validate]} {:db/id "q-326449/field-2/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer/id #uuid "5cdec670-c854-5ba0-892f-0f3fc5c8eb98" :answer/type :answer.type/math :answer/value "+" :db/ensure [:answer/validate]} {:db/id "q-326449/field-2/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer/id #uuid "d243be25-710e-542c-9772-d1677491ceb2" :answer/type :answer.type/math :answer/value "-" :db/ensure [:answer/validate]} {:db/id "q-326449/field-2" :answer-field/id #uuid "76e9652e-738c-5c6d-8642-5e4fd5498a9f" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-326449/field-2/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer-field/choices ["q-326449/field-2/4e1443bd31b83d9674b14c2b39fdc69b7291d3