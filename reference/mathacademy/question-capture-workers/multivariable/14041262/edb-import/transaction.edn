27815afac4720949"] :db/ensure [:answer-field/validate]} {:db/id "q-326449" :question/id #uuid "023abe06-191f-5e12-8e21-5b19e4d43ccd" :question/math-academy-id "q-326449" :question/problem "Consider the function $f(x,y)=(x+1)^{2}(y-2).$ Fill in the missing signs in the sign table of $f(x,y)$ shown below.\n\n| $y>2$ | {{field-1}} | {{field-2}} |\n| --- | --- | --- |\n| $y<2$ | {{field-3}} | {{field-4}} |\n|  | $x<-1$ | $x>-1$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=-1$ and $y=2.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/bce3befee4d7ae90df59b7bfb17e965ca29615220ca6845a78cfaad3e02a0730.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/b6cac24748d4a3990038ef7140943bd0947207456132e66ca6b7fb887be44164.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(x+1)^{2}$ | $(y-2)$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(-2,3)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(0,3)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(-2,1)$ | $+$ | $-$ | $-$ |\n| Bottom-Right | $(0,1)$ | $+$ | $-$ | $-$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/174965ef064b55b29326c4681f709a6dfcbc690673e2e5a7498e9a65c4a6af2c.png)\n\nFinally, we fill in the required sign table.\n\n| $y>2$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<2$ | $-$ | $-$ |\n|  | $x<-1$ | $x>-1$ |" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-326449/field-1" "q-326449/field-2" "q-326449/field-3" "q-326449/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d8033e21-86ab-5dc6-8060-a0b5c134bf9d"] :knowledge-point/questions ["q-326449"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121317/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer/id #uuid "85e8b5fd-c295-5328-b30b-527ea27c0d94" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121317/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" :answer/id #uuid "aa196a19-3dad-5f24-8b9f-999ec212d659" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121317/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" :answer/id #uuid "1724dbc3-b64b-5c20-85b3-ab43cc810569" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121317/selection/bab4acf5ca3a66ed4f11bbcf7574627e6848417923ee89f9393917451c190309" :answer/id #uuid "e136d3b1-a9d2-56ff-9aff-912dbb5d8f95" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121317/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" :answer/id #uuid "9fd06188-de1c-58ad-a5dc-c999cbf9859c" :answer/type :answer.type/text :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121317/selection" :answer-field/id #uuid "95ce4a22-8f63-5ca4-af95-0f684e0beccd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121317/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" :answer-field/choices ["q-121317/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" "q-121317/selection/46070df805b4653a5d877039a93fbcfb0cf7186aafc46672fa7e330153961054" "q-121317/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" "q-121317/selection/bab4acf5ca3a66ed4f11bbcf7574627e6848417923ee89f9393917451c190309" "q-121317/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4"] :db/ensure [:answer-field/validate]} {:db/id "q-121317" :question/id #uuid "6e58710c-8293-5127-9aea-2f3fc3bb3b32" :question/math-academy-id "q-121317" :question/problem "Consider the function $f(x,y)=y(x-3)^{3}.$ What are the missing entries in the following sign table of $f(x,y)?$\n\n| $y>0$ |  |  |\n| --- | --- | --- |\n| $y<0$ |  |  |\n|  | $x<3$ | $x>3$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=3$ and $y=0.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/6b88b092c69226e8590547f6cf1c27fb5046006c6d24516c8a112ea5ae5fe665.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/9ce50d0e01602f4c28666444df79e9feb98312338b2fe11a2760d7587ea5a548.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $y$ | $(x-3)^{3}$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(2,1)$ | $+$ | $-$ | $-$ |\n| Top-Right | $(4,1)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(2,-1)$ | $-$ | $-$ | $+$ |\n| Bottom-Right | $(4,-1)$ | $-$ | $+$ | $-$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/f03e23b1a5f1bc4faf478d0a14c90d4bc2f24f5e56a61e9708dd7339ff5558e6.png)\n\nFinally, we fill in the required sign table.\n\n| $y>0$ | $-$ | $+$ |\n| --- | --- | --- |\n| $y<0$ | $+$ | $-$ |\n|  | $x<3$ | $x>3$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121317/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d8033e21-86ab-5dc6-8060-a0b5c134bf9d"] :knowledge-point/questions ["q-121317"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121277/selection/b45472c41c348fae5c2ea622ac59d486198e709e16c4ef496f42c765fd8ffa33" :answer/id #uuid "1cd6c29a-eae2-552c-aa04-eb45d171e246" :answer/type :answer.type/text :answer/value "| $+$ | $+$ |\n| --- | --- |\n| $+$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121277/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" :answer/id #uuid "be3fc398-b7c1-58e7-8983-f4108d7ec319" :answer/type :answer.type/text :answer/value "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121277/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" :answer/id #uuid "27f96356-a023-59f9-8d69-f49c4240ef9f" :answer/type :answer.type/text :answer/value "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |" :db/ensure [:answer/validate]} {:db/id "q-121277/selection/c8a570a7a45299d6bca7534749498af91d95f2281bdd8454030e707cf44ee838" :answer/id #uuid "1f62b9f3-2761-5ea3-8a25-a41f0d646d3f" :answer/type :answer.type/text :answer/value "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121277/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f" :answer/id #uuid "b13e42d4-7e88-514a-93f0-463e89429510" :answer/type :answer.type/text :answer/value "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" :db/ensure [:answer/validate]} {:db/id "q-121277/selection" :answer-field/id #uuid "d9417f58-a22a-5ed3-90ea-b64c2e08320d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121277/selection/b45472c41c348fae5c2ea622ac59d486198e709e16c4ef496f42c765fd8ffa33" :answer-field/choices ["q-121277/selection/b45472c41c348fae5c2ea622ac59d486198e709e16c4ef496f42c765fd8ffa33" "q-121277/selection/a3c72559d7d25083af41603553dab28f112bf464761c0eb8d3b6e870c70cfb9e" "q-121277/selection/6ec7f55390e84a805c2f4b28c93f893967d5f7a64eeb901750d34dda29cf16f4" "q-121277/selection/c8a570a7a45299d6bca7534749498af91d95f2281bdd8454030e707cf44ee838" "q-121277/selection/e4d5cbdd1dc7cc0dd0fdf2a9056c717b9f60123484c35fc7a65c937abab9db2f"] :db/ensure [:answer-field/validate]} {:db/id "q-121277" :question/id #uuid "7d377a23-4bb2-5df7-a2b0-d0ab6bfc6f59" :question/math-academy-id "q-121277" :question/problem "Consider the expression $f(x,y)=(x+2)^{2}(y-2)^{2}.$  What are the missing entries in the sign table of $f(x,y),$ shown below?\n\n| $y>2$ |  |  |\n| --- | --- | --- |\n| $y<2$ |  |  |\n|  | $x<-2$ | $x>-2$ |" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=-2$ and $y=2.$ These lines divide the $xy$-plane into four regions, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/1c0457cd5861a8b9af72febb0da0ce390a50910cada39dd1b6f1c61bc5f83810.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/590ec40cbf836d0a492aa5da2a4f70494ccf0d808cf4929f273d148642c4c4d4.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(x+2)^{2}$ | $(y-2)^{2}$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-left | $(-3,3)$ | $+$ | $+$ | $+$ |\n| Top-Right | $(-1,3)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(-3,1)$ | $+$ | $+$ | $+$ |\n| Bottom-Right | $(-1,1)$ | $+$ | $+$ | $+$ |\n\n \n\nUsing the *last* column of the table above, we get the following picture:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/0a70fbd50b5c79323d67eac3fbd8bbab68c14578aefa0d918d65314fed1ffce0.png)\n\nFinally, we fill in the required sign table.\n\n| $y>2$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<2$ | $+$ | $+$ |\n|  | $x<-2$ | $x>-2$ |" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121277/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d8033e21-86ab-5dc6-8060-a0b5c134bf9d"] :knowledge-point/questions ["q-121277"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121313/selection/5d428675086a693bc41eb21b3df6c7f1923ae4e76d810164610568b8691035eb" :answer/id #uuid "4d013b50-3e53-535f-8321-de95ea373285" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/28d18defd0b2fbd2565e3929e0acf2575d9ecbe90e931a43e2806616e8041094.png" :db/ensure [:answer/validate]} {:db/id "q-121313/selection/55b2347f6f92fb33b7dfa550b783079cbf5671d958c1cfdd886d6b02baa0c895" :answer/id #uuid "fb8442c7-f901-5fcc-812f-b01dc861df1d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/b8f4397a5b7dea9e0cbad1c2e61f2a595658dbfad0ecee82e5797ed0431c8ca1.png" :db/ensure [:answer/validate]} {:db/id "q-121313/selection/19c0d881dd609a4c621c735d453b01ce51c2cc593d3bf5d43efafe9cc5874d8e" :answer/id #uuid "3ff67824-88b8-5883-aff3-870c414a4ebf" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/6979eefe00fcb6e1c0e7cb5b993d9b3e162922443d26a6571bd3a86679576d86.png" :db/ensure [:answer/validate]} {:db/id "q-121313/selection/d4a1d5fbe650564f662fdc9af06dceb4d2acad5fa4f3e8514496ef77f3686ac0" :answer/id #uuid "047374e8-12e0-5c7f-adf7-53d3d311ce14" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/8180521b3a878e91950d27111104c0c2ef918ac67dd3ec902fc3861e56270179.png" :db/ensure [:answer/validate]} {:db/id "q-121313/selection/8ef4dc1a29c9f5a80a6beda853388040c31be39dcfe7c3c2fd66491791be145f" :answer/id #uuid "f6afe9a6-7ad8-59a0-b7ee-830fa8680a0e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/b5f63ced598cd8a8a28f774b1d11cf73e340827b2032fd574bc7b9612e4ff467.png" :db/ensure [:answer/validate]} {:db/id "q-121313/selection" :answer-field/id #uuid "4bd411ec-af27-5d78-84b8-c2ff358255a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121313/selection/8ef4dc1a29c9f5a80a6beda853388040c31be39dcfe7c3c2fd66491791be145f" :answer-field/choices ["q-121313/selection/5d428675086a693bc41eb21b3df6c7f1923ae4e76d810164610568b8691035eb" "q-121313/selection/55b2347f6f92fb33b7dfa550b783079cbf5671d958c1cfdd886d6b02baa0c895" "q-121313/selection/19c0d881dd609a4c621c735d453b01ce51c2cc593d3bf5d43efafe9cc5874d8e" "q-121313/selection/d4a1d5fbe650564f662fdc9af06dceb4d2acad5fa4f3e8514496ef77f3686ac0" "q-121313/selection/8ef4dc1a29c9f5a80a6beda853388040c31be39dcfe7c3c2fd66491791be145f"] :db/ensure [:answer-field/validate]} {:db/id "q-121313" :question/id #uuid "9769f13c-3532-5731-bc38-1e623e8a1641" :question/math-academy-id "q-121313" :question/problem "Suppose that $f(x,y)=(x-2)^{3}(y+3).$ Which of the following shaded areas gives the solution to the inequality $f(x,y)>0?$" :question/worked-solution "Notice that $f(x,y)$ equals zero when $x=2$ and $y=-3.$ These lines divide the $xy$-plane into four regions, as shown below. Since we have a strict inequality, we use dashed lines to divide the plane.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/6c1830847adf66b3d015227fb2b822d236cc0ca04d4e79b34485e0e307bebfb2.png)\n\nTo determine the sign of $f(x,y)$ in each region, we pick four test points, one for each region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/e04638efe40ea1813185855bb8c9a47e3e782487f6497ba63c7ed5e9046af421.png)\n\nNext, we calculate the sign of $f(x,y)$ in each region using a sign table:\n\n|  | Test point | $(x-2)^{3}$ | $(y+3)$ | $f(x,y)$ |\n| --- | --- | --- | --- | --- |\n| Top-Left | $(1,-2)$ | $-$ | $+$ | $-$ |\n| Top-Right | $(3,-2)$ | $+$ | $+$ | $+$ |\n| Bottom-Left | $(1,-4)$ | $-$ | $-$ | $+$ |\n| Bottom-Right | $(3,-4)$ | $+$ | $-$ | $-$ |\n\n \n\nFinally, on our diagram, we shade in the solutions to $f(x,y)>0$ using the *last* column of the table above.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/51df420aa99597c5f476be571557aa9f1c91a1ec1f888687058bfd0fe96813e4.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121313/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1ef881ff-71d4-5268-9cac-32c478dc02a5"] :knowledge-point/questions ["q-121313"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121310/selection/e3ae5a71d0ac51e24927e13026ed9413209fb9c8c7fbc6582ad9bdd9844f17b2" :answer/id #uuid "d7db3619-e740-581f-852b-067fa3a08854" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/10080518e756d9d915dadc4346c23a9db90ff7d0f8df90b09f571b3f9f8aa29c.png" :db/ensure [:answer/validate]} {:db/id "q-121310/selection/a0436298b8a1b90d46cd301c24d8a70cf96acab15a30cd083e8787b2c7101855" :answer/id #uuid "b348b87a-9431-53d7-9109-508c609b4719" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041262/assets/d996ae0305472b14d52d3ec951669590aad2a249a3ce2f2643d65ad17993a899.png" :db/ensure [:answer/validate]} {:db/id "q-121310/selecti