, we fill in the required sign table.\n\n| $y>2$ | $+$ | $+$ |\n| --- | --- | --- |\n| $y<2$ | $+$ | $+$ |\n|  | $x<-2$ | $x>-2$ |" 13194139534804 true] [17592186311043 1000 #edb/ref 17592186311044 13194139534804 true] [17592186311043 1000 #edb/ref 17592186311045 13194139534804 true] [17592186311043 1000 #edb/ref 17592186311046 13194139534804 true] [17592186311043 1000 #edb/ref 17592186311047 13194139534804 true] [17592186311043 1000 #edb/ref 17592186311048 13194139534804 true] [17592186311043 1040 #edb/ref 17592186045450 13194139534804 true] [17592186311043 1041 "selection" 13194139534804 true] [17592186311043 1104 #edb/ref 17592186311046 13194139534804 true] [17592186311043 1110 #uuid "d9417f58-a22a-5ed3-90ea-b64c2e08320d" 13194139534804 true] [17592186311044 1034 "| $-$ | $-$ |\n| --- | --- |\n| $+$ | $+$ |" 13194139534804 true] [17592186311044 1103 #edb/ref 17592186045454 13194139534804 true] [17592186311044 1111 #uuid "27f96356-a023-59f9-8d69-f49c4240ef9f" 13194139534804 true] [17592186311045 1034 "| $-$ | $+$ |\n| --- | --- |\n| $-$ | $+$ |" 13194139534804 true] [17592186311045 1103 #edb/ref 17592186045454 13194139534804 true] [17592186311045 1111 #uuid "be3fc398-b7c1-58e7-8983-f4108d7ec319" 13194139534804 true] [17592186311046 1034 "| $+$ | $+$ |\n| --- | --- |\n| $+$ | $+$ |" 13194139534804 true] [17592186311046 1103 #edb/ref 17592186045454 13194139534804 true] [17592186311046 1111 #uuid "1cd6c29a-eae2-552c-aa04-eb45d171e246" 13194139534804 true] [17592186311047 1034 "| $+$ | $+$ |\n| --- | --- |\n| $-$ | $-$ |" 13194139534804 true] [17592186311047 1103 #edb/ref 17592186045454 13194139534804 true] [17592186311047 1111 #uuid "1f62b9f3-2761-5ea3-8a25-a41f0d646d3f" 13194139534804 true] [17592186311048 1034 "| $+$ | $-$ |\n| --- | --- |\n| $+$ | $-$ |" 13194139534804 true] [17592186311048 1103 #edb/ref 17592186045454 13194139534804 true] [17592186311048 1111 #uuid "b13e42d4-7e88-514a-93f0-463e89429510" 13194139534804 true] [17592186311049 1017 #edb/ref 175921863