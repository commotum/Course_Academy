 & =(c-5)(c-7) \\\\ c & =5,\\,7\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74072/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41bedcde-cbc1-5634-8846-eb58ffda32e2"] :knowledge-point/questions ["q-74072"] :db/ensure [:knowledge-point/validate]} {:db/id "q-120450/selection/5972b56c6fbefb22ca8e694af3a7f3337cb5308e953f7b3a7d1ef2f280e3bb68" :answer/id #uuid "ef74a6b0-7f25-544b-b8ae-f7d47395dabf" :answer/type :answer.type/math :answer/value "-2,\\,3" :db/ensure [:answer/validate]} {:db/id "q-120450/selection/e3956cb9e4c222d2e00687127d599f8f12ce8e85fde0e6934a8980bb3b04c180" :answer/id #uuid "88809e12-686d-52c1-966f-b7ab0228f703" :answer/type :answer.type/math :answer/value "-3,\\,2" :db/ensure [:answer/validate]} {:db/id "q-120450/selection/49480c4ce171a24817574f2aa0a9695e97e964b2c7c36b027c5ca080d36e846e" :answer/id #uuid "5e3208c6-746e-5199-90ad-789d0a4b2409" :answer/type :answer.type/math :answer/value "0,\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-120450/selection/b11869d80e945d67c71abdbf83fa36f9cd6809c69478ff778fb841c07c1a2bc7" :answer/id #uuid "b7cc8716-b4a7-5334-9599-1a521a91bffa" :answer/type :answer.type/math :answer/value "2,\\,\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-120450/selection/c42debc647e5fdc95f0413eea9f1e731d3e414221bf0378638ae9b5fac8a2bd2" :answer/id #uuid "e91cd08b-ba6d-527f-b8ad-1b84c3416576" :answer/type :answer.type/math :answer/value "\\frac{1}{3},\\,\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-120450/selection" :answer-field/id #uuid "61d61f9f-b9eb-5c9d-8c61-aefcbb45c2a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120450/selection/b11869d80e945d67c71abdbf83fa36f9cd6809c69478ff778fb841c07c1a2bc7" :answer-field/choices ["q-120450/selection/5972b56c6fbefb22ca8e694af3a7f3337cb5308e953f7b3a7d1ef2f280e3bb68" "q-120450/selection/e3956cb9e4c222d2e00687127d599f8f12ce8e85fde0e6934a8980bb3b04c180" "q-120450/selection/49480c4ce171a24817574f2aa0a9695e97e964b2c7c36b027c5ca080d36e846e" "q-120450/selection/b11869d80e945d67c71abdbf83fa36f9cd6809c69478ff778fb841c07c1a2bc7" "q-120450/selection/c42debc647e5fdc95f0413eea9f1e731d3e414221bf0378638ae9b5fac8a2bd2"] :db/ensure [:answer-field/validate]} {:db/id "q-120450" :question/id #uuid "645765fa-26ae-5ed8-a0d8-99efa4f8225a" :question/math-academy-id "q-120450" :question/problem "Find the numbers $c$ such that the average value of $f(x)=-9{x}^{2}+14x-2$ on the interval $[0,c]$ is equal to $0.$" :question/worked-solution "To solve for $c,$ we apply the average value formula:\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ 0 & =\\frac{1}{c-0}{\\int }_{0}^{c}(-9{x}^{2}+14x-2)\\,\\text{d}x \\\\ 0 & ={\\frac{1}{c}(-3{x}^{3}+7{x}^{2}-2x)|}_{0}^{c} \\\\ 0 & =\\frac{1}{c}[(-3{c}^{3}+7{c}^{2}-2c)-0] \\\\ 0 & =-3{c}^{2}+7c-2 \\\\ 3{c}^{2}-7c+2 & =0 \\\\ (c-2)(3c-1) & =0 \\\\ c & =2,\\,\\frac{1}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120450/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41bedcde-cbc1-5634-8846-eb58ffda32e2"] :knowledge-point/questions ["q-120450"] :db/ensure [:knowledge-point/validate]} {:db/id "q-18143/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "cb4f1599-3de3-5096-9d83-500f1b467fe8" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-18143/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "bc641657-f01d-5448-868b-b2f2e9979abd" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-18143/selection/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" :answer/id #uuid "404e9f9c-aace-5a13-85bf-68c2cfbc6896" :answer/type :answer.type/math :answer/value "\\frac{7}{4}" :db/ensure [:answer/validate]} {:db/id "q-18143/selection/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e" :answer/id #uuid "e564d2b2-f995-5714-b7c9-a3a83e4f5605" :answer/type :answer.type/math :answer/value "\\frac{5}{4}" :db/ensure [:answer/validate]} {:db/id "q-18143/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "ea863b2c-2f4f-59f2-aa56-01a4f179ef4d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-18143/selection" :answer-field/id #uuid "c99991c4-91d3-56e9-86a4-3e7f15632f3e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-18143/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer-field/choices ["q-18143/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-18143/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-18143/selection/2b998a440c758092569557828849b9a2d05282247ea8a11a5727b6cadcbcb080" "q-18143/selection/d278d4936eb1c69dc660a77f5f1c7b1eb5b4a4db4aee8a8ad2dc52aa3f827f2e" "q-18143/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5"] :db/ensure [:answer-field/validate]} {:db/id "q-18143" :question/id #uuid "fbfdded4-c230-5698-b4cd-d1a52f9642db" :question/math-academy-id "q-18143" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14081209/assets/7eddb6203ccc3eead9a2a89d7868d3206af52be4c269962e33c551ddd3cf08cd.png)\n\nThe graph of the function $f(x),$ which is defined on $[-4,4],$ is shown above. It consists of six line segments.  Find the average value of $f(x)$ on $[-1,3].$" :question/worked-solution "The average value of a function on a given interval $[a,b]$ is\n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{-1}^{3}f(x)\\,\\text{d}x={{{\\int }_{-1}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{1}^{3}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-1,1].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 1 \\\\  & =1.\\end{aligned}\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,3].$ The corresponding region is a triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =1+2 \\\\  & =3.\\end{aligned}\n$$\n\nFinally, using the formula for the average, we get \n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{3-(-1)}\\cdot 3 \\\\  & =\\frac{3}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-18143/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd9167b4-572f-589f-9b94-b62ba57eb28f"] :knowledge-point/questions ["q-18143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74172/selection/d45beb8a8eed73fb58adaaae4f139d98ef800e474810458d742741381fa9dcf5" :answer/id #uuid "7cd55be5-ac16-5930-b91f-c064a56cf8ef" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{16}+\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-74172/selection/5915109ee6c518b90400b424b4c34e65e37956f776dfed3068c2b2688a9b6a00" :answer/id #uuid "7e914cbe-1fe9-5d44-9e8d-81ff0cc9804d" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{8}-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-74172/selection/e1c1dada720bb81888138290fa6dac56bea3c21cb7a9863d03d19ef91d0cfc76" :answer/id #uuid "781f9926-f7c3-5368-9ed7-dcc69b8b25b4" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{2}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74172/selection/799a892c1e8faf1b81362c1cddbbbb991442d0618c690bfa8ed8a2e5e714177e" :answer/id #uuid "0a5d8f94-1493-5952-9ba9-eabf150eaf51" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{8}+\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-74172/selection/2905d570b1203fff36ee3c680a211eaaee7dcffffa2bc32797e6e8217a5f6929" :answer/id #uuid "aadbaaa8-2eb9-5504-804e-2a8da4ed0196" :answer/type :answer.type/math :answer/value "\\frac{9\\pi }{16}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74172/selection" :answer-field/id #uuid "391e9439-8564-54f1-a7f8-c3e4de1a8ec6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74172/selection/d45beb8a8eed73fb58adaaae4f139d98ef800e474810458d742741381fa9dcf5" :answer-field/choices ["q-74172/selection/d45beb8a8eed73fb58adaaae4f139d98ef800e474810458d742741381fa9dcf5" "q-74172/selection/5915109ee6c518b90400b424b4c34e65e37956f776dfed3068c2b2688a9b6a00" "q-74172/selection/e1c1dada720bb81888138290fa6dac56bea3c21cb7a9863d03d19ef91d0cfc76" "q-74172/selection/799a892c1e8faf1b81362c1cddbbbb991442d0618c690bfa8ed8a2e5e714177e" "q-74172/selection/2905d570b1203fff36ee3c680a211eaaee7dcffffa2bc32797e6e8217a5f6929"] :db/ensure [:answer-field/validate]} {:db/id "q-74172" :question/id #uuid "fa6fc6e8-f5ff-590f-accd-6b5cf81b87bf" :question/math-academy-id "q-74172" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14081209/assets/7ecbb53bb87156d11f9a9d8021182cdfb8c0c1749cd028780377bb61f32adf43.png)\n\nThe graph of the function $f(x)$, which is defined on $[-3,6]$, is shown above. It consists of the arc of the semi-circle centered at $(0,0)$ with radius $3,$ and two line segments. Find the average value of $f(x)$ on $[-3,5].$" :question/worked-solution "The average value of a function on a given interval $[a,b]$ is\n\n$$\n{f}_{\\text{avg}}=\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nUsing the additive property of the definite integral, we write\n\n$$\n{\\int }_{-3}^{5}f(x)\\,\\text{d}x={{{\\int }_{-3}^{3}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{3}^{5}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}.\n$$\n\nThe 1st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,3].$ The corresponding region is a semi-cirle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{2}\\pi {r}^{2} \\\\  & =\\frac{1}{2}\\pi \\cdot {3}^{2} \\\\  & =\\frac{9\\pi }{2}.\\end{aligned}\n$$\n\nThe 2nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [3,5].$ The corresponding region is a right triangle, so we find the area using the formula:\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}\\cdot 2\\cdot 2 \\\\  & =2.\\end{aligned}\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-3}^{5}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =\\frac{9\\pi }{2}+2.\\end{aligned}\n$$\n\nFinally, using the formula for the average value, we get\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{5-(-3)}\\cdot (\\frac{9\\pi }{2}+2) \\\\  & =\\frac{9\\pi }{16}+\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74172/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cd9167b4-572f-589f-9b94-b62ba57eb28f"] :knowledge-point/questions ["q-74172"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-15225"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14081209/assets/6c70d5f15424c4d7d67a3998a785a214e46e8dfa47b83839fd99a574b2f756cf.png)\n\nThe graph of the function $f(x)$, which is defined on $[-1,6]$, is shown above. It consists of three line segments and the arc of the semi-circle centered at $(4,0)$ with radius $1.$ Find the average value of $f(x)$ on $[0,5].$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-344702"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14081209/assets/8ddd8493662174e0ddaf9bdd63b0ec382f6bb25c9079f1a339b71400b8cf3860.png)\n\nThe graph of the function $f(x),$ which is defined on $[-6,6],$ is shown above. The areas of the regions between the graph and the $x$-axis are $15$, $60$ and $9,$ respectively (from left to right). \n\nFind the average value of $f(x)$ on $[-6,6].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-316307"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14081209/assets/64682c2166e3f9fd2366f925330d04f95b54f370fd3d887d1d8aef8885ac35ec.png)\n\nThe graph of the function $f(x),$ which is defined on $[-8,4],$ is shown above. The areas of the regions between the graph and the $x$-axis are $20$, $80$ and $10,$ respectively (from left to right). \n\nFind the average value of $f(x)$ on $[-8,4].$ Do not round the answer.\n\n${f}_{\\text{avg}}=$\n{{field-1}}" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-550"] :question/problem "The graph of the function $f(x),$ which is defined on $[1,6],$ is shown below. The areas of the regions between the graph and the $x$-axis are $5$ and $2,$ respectively (from left to right). Find the average value of $f(x)$ on $[1,6].$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14081209/assets/6433d1ca57ceb334f304e894e2655ef50d987567fbcf219314302bb381fd9a83.png)" :db/ensure [:question/validate]}]
