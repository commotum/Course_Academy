[{:db/id "q-120298/selection/240764b3abf59c6e971f5d4018b3bb6b0343d15f2f6e75c3c0cda609e78b9523" :answer/id #uuid "a711b4cd-449a-5b67-bc2b-1daf47ab2a29" :answer/type :answer.type/math :answer/value "\\pm \\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-120298/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "8bc5d772-308a-5e43-9c75-bbf99a23b44c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-120298/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "78473b4c-b515-5fd8-8166-4e008255ff46" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-120298/selection/8ef805aaba172bf67ddd675ea17640e6840a9c5706b7e0c6c275400d4a5e62e1" :answer/id #uuid "e4f4344c-5821-5448-bbf8-caf063e16d8b" :answer/type :answer.type/math :answer/value "\\pm 1" :db/ensure [:answer/validate]} {:db/id "q-120298/selection/add48b243ebaf46eba7641661c03d006608a5acdecbbc38b771c9f737352650c" :answer/id #uuid "f077af58-34cf-5d08-95a9-5150fb89c66b" :answer/type :answer.type/math :answer/value "\\pm 6" :db/ensure [:answer/validate]} {:db/id "q-120298/selection" :answer-field/id #uuid "6d01f545-648e-544e-bd81-bf3ed51943fe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120298/selection/8ef805aaba172bf67ddd675ea17640e6840a9c5706b7e0c6c275400d4a5e62e1" :answer-field/choices ["q-120298/selection/240764b3abf59c6e971f5d4018b3bb6b0343d15f2f6e75c3c0cda609e78b9523" "q-120298/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-120298/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-120298/selection/8ef805aaba172bf67ddd675ea17640e6840a9c5706b7e0c6c275400d4a5e62e1" "q-120298/selection/add48b243ebaf46eba7641661c03d006608a5acdecbbc38b771c9f737352650c"] :db/ensure [:answer-field/validate]} {:db/id "q-120298" :question/id #uuid "eef23b72-e36a-5c45-a5b3-e03a1d351b74" :question/math-academy-id "q-120298" :question/problem "Find all values of $c$ that satisfy the mean value theorem for integrals for  $f(x)=6{x}^{2}$ on the interval $[-1,2].$" :question/worked-solution "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{2-(-1)}{\\int }_{-1}^{2}6{x}^{2}\\,\\text{d}x \\\\  & ={\\frac{1}{3}\\cdot (2{x}^{3})|}_{-1}^{2} \\\\  & =\\frac{1}{3}[2(2)^{3}-2(-1)^{3}] \\\\  & =\\frac{1}{3}\\cdot 18 \\\\  & =6.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =6 \\\\ 6{c}^{2} & =6 \\\\ {c}^{2} & =1 \\\\ c & =\\pm 1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120298/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "86221215-32a6-5c5a-bcd7-220e166bcee8"] :knowledge-point/questions ["q-120298"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-2491"] :question/problem "Find all values of $c$ that satisfy the mean value theorem for integrals for  $f(x)=3{x}^{2}$ on the interval $[-2,2].$" :question/worked-solution "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{2-(-2)}{\\int }_{-2}^{2}3{x}^{2}\\,\\text{d}x \\\\  & ={\\frac{1}{4}\\cdot ({x}^{3})|}_{-2}^{2} \\\\  & =\\frac{1}{4}[{2}^{3}-(-2)^{3}] \\\\  & =\\frac{1}{4}\\cdot 16 \\\\  & =4.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =4 \\\\ 3{c}^{2} & =4 \\\\ {c}^{2} & =\\frac{4}{3} \\\\ c & =\\pm \\frac{2}{\\sqrt{3}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-120333/selection/ddd4b5a64d1a91976388cbf0c13dce0958eb21478d9b62a319ad602ad90fac12" :answer/id #uuid "81d09b30-d0f9-5648-a9dd-72ef95d21227" :answer/type :answer.type/math :answer/value "\\frac{32}{25}" :db/ensure [:answer/validate]} {:db/id "q-120333/selection/7fc8bdb65c73ab344ccaebcbd0441c8a49bff928856226cc45b12a25df31dc3e" :answer/id #uuid "3d9bf282-58a1-5d82-b0e7-c72fdf9d90e5" :answer/type :answer.type/math :answer/value "\\sqrt[3]{\\frac{32}{25}}" :db/ensure [:answer/validate]} {:db/id "q-120333/selection/e52baf6f58a50be3f0aad1fe30f8b37e477346a1c9e6ca8a0db6be64cfef2da7" :answer/id #uuid "e3a3cd76-835c-5485-b247-c563ad07c69f" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{5}" :db/ensure [:answer/validate]} {:db/id "q-120333/selection/ee875d10153fa4bb909fbbc627a25a7be015bf21281d6aad66ce58387afa62eb" :answer/id #uuid "2b3323d0-b849-5ade-bdce-8dad4c76f1da" :answer/type :answer.type/math :answer/value "\\frac{2\\sqrt{2}}{25}" :db/ensure [:answer/validate]} {:db/id "q-120333/selection/b94cd91016b851e50d1e1ee3c94c586f1ac2521bd8df1afabbe712aa34f73d57" :answer/id #uuid "41901d4d-81c2-562f-abe2-33e08b75c0e2" :answer/type :answer.type/math :answer/value "\\sqrt[3]{\\frac{16}{5}}" :db/ensure [:answer/validate]} {:db/id "q-120333/selection" :answer-field/id #uuid "fdcd021c-11f6-5e32-90b2-c5143d5dbd98" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-120333/selection/7fc8bdb65c73ab344ccaebcbd0441c8a49bff928856226cc45b12a25df31dc3e" :answer-field/choices ["q-120333/selection/ddd4b5a64d1a91976388cbf0c13dce0958eb21478d9b62a319ad602ad90fac12" "q-120333/selection/7fc8bdb65c73ab344ccaebcbd0441c8a49bff928856226cc45b12a25df31dc3e" "q-120333/selection/e52baf6f58a50be3f0aad1fe30f8b37e477346a1c9e6ca8a0db6be64cfef2da7" "q-120333/selection/ee875d10153fa4bb909fbbc627a25a7be015bf21281d6aad66ce58387afa62eb" "q-120333/selection/b94cd91016b851e50d1e1ee3c94c586f1ac2521bd8df1afabbe712aa34f73d57"] :db/ensure [:answer-field/validate]} {:db/id "q-120333" :question/id #uuid "e2b64626-04c3-5fb9-a70b-3ec150e19575" :question/math-academy-id "q-120333" :question/problem "Find all values of $c$ that satisfy the mean value theorem for integrals for  $f(x)=5\\sqrt{{x}^{3}}$ on the interval $[0,2].$" :question/worked-solution "Applying the mean value theorem for integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{2-0}{\\int }_{0}^{2}5\\sqrt{{x}^{3}}\\,\\text{d}x \\\\  & ={\\frac{1}{2}\\cdot (2{x}^{5/2})|}_{0}^{2} \\\\  & =\\frac{1}{2}[2\\cdot {2}^{5/2}-2\\cdot {0}^{5/2}] \\\\  & =\\frac{1}{2}\\cdot 8\\sqrt{2} \\\\  & =4\\sqrt{2}.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =4\\sqrt{2} \\\\ 5\\sqrt{{c}^{3}} & =4\\sqrt{2} \\\\ c & =\\sqrt[3]{\\frac{32}{25}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-120333/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "86221215-32a6-5c5a-bcd7-220e166bcee8"] :knowledge-point/questions ["q-120333"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2476/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "d89224a4-7338-5554-b49a-7e20f0f12bd8" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-2476/selection/540eff13c194ee903ec872830e9f00a45a72d214923bf8b71c9eb513b96efcb9" :answer/id #uuid "87172de7-e0a9-5165-8750-ad28138c18b7" :answer/type :answer.type/math :answer/value "\\frac{2}{\\sqrt[3]{3}}" :db/ensure [:answer/validate]} {:db/id "q-2476/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "2b4da1d6-8785-5852-983c-273d5447277e" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-2476/selection/67e0f5d75c2a539e46396e253ad7f6f5ecef95d35d8d5d631e9dd41b6629166e" :answer/id #uuid "0c224cc2-de66-57d2-b97a-b6ee32f04489" :answer/type :answer.type/math :answer/value "\\sqrt[3]{2}" :db/ensure [:answer/validate]} {:db/id "q-2476/selection/03c96705b89da5babaf34653c01e6f60e52dfbb53a8db9885714fbf32845111d" :answer/id #uuid "7561c120-2dd2-5147-a914-b9d8055b13e5" :answer/type :answer.type/math :answer/value "\\frac{3}{\\sqrt[3]{3}}" :db/ensure [:answer/validate]} {:db/id "q-2476/selection" :answer-field/id #uuid "dce538c8-a1b8-5237-b33b-7e091e8514e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2476/selection/540eff13c194ee903ec872830e9f00a45a72d214923bf8b71c9eb513b96efcb9" :answer-field/choices ["q-2476/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-2476/selection/540eff13c194ee903ec872830e9f00a45a72d214923bf8b71c9eb513b96efcb9" "q-2476/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-2476/selection/67e0f5d75c2a539e46396e253ad7f6f5ecef95d35d8d5d631e9dd41b6629166e" "q-2476/selection/03c96705b89da5babaf34653c01e6f60e52dfbb53a8db9885714fbf32845111d"] :db/ensure [:answer-field/validate]} {:db/id "q-2476" :question/id #uuid "861d7909-aecf-5978-9bba-b5634c19846a" :question/math-academy-id "q-2476" :question/problem "Find the value of $c$ that satisfies the mean value theorem for integrals for $f(x)=4+\\frac{2}{{x}^{3}}$ on the interval $[1,2].$" :question/worked-solution "Applying the mean value theorem for the integrals, we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{2-1}{\\int }_{1}^{2}(4+\\frac{2}{{x}^{3}})\\text{d}x \\\\  & ={(4x-\\frac{1}{{x}^{2}})|}_{1}^{2} \\\\  & =(4\\cdot 2-\\frac{1}{{2}^{2}})-(4\\cdot 1-\\frac{1}{{1}^{2}}) \\\\  & =\\frac{31}{4}-3 \\\\  & =\\frac{19}{4}.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =\\frac{19}{4} \\\\ 4+\\frac{2}{{c}^{3}} & =\\frac{19}{4} \\\\ \\frac{2}{{c}^{3}} & =\\frac{3}{4} \\\\ \\frac{{c}^{3}}{2} & =\\frac{4}{3} \\\\ {c}^{3} & =\\frac{8}{3} \\\\ c & =\\sqrt[3]{\\frac{8}{3}} \\\\ c & =\\frac{2}{\\sqrt[3]{3}}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2476/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "86221215-32a6-5c5a-bcd7-220e166bcee8"] :knowledge-point/questions ["q-2476"] :db/ensure [:knowledge-point/validate]} {:db/id "q-2474/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d9799a52-0244-5aec-b5ca-0ebcd18def1b" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-2474/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "1413b167-c304-5d75-a8ed-cab2474cc2f8" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-2474/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "a85a5c86-d002-5709-9803-6467b782f27a" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-2474/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "e3abe82d-e288-51a6-a112-e9d1b2bc0aaa" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-2474/selection/8ef805aaba172bf67ddd675ea17640e6840a9c5706b7e0c6c275400d4a5e62e1" :answer/id #uuid "9de014ad-2055-5349-9244-64ad84e18e91" :answer/type :answer.type/math :answer/value "\\pm 1" :db/ensure [:answer/validate]} {:db/id "q-2474/selection" :answer-field/id #uuid "5212c4b8-99cc-5faa-87db-05ad7d8c8963" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-2474/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-2474/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-2474/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-2474/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-2474/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-2474/selection/8ef805aaba172bf67ddd675ea17640e6840a9c5706b7e0c6c275400d4a5e62e1"] :db/ensure [:answer-field/validate]} {:db/id "q-2474" :question/id #uuid "c4b62ed1-12e5-5a6e-aad0-bc0c6b0adfd0" :question/math-academy-id "q-2474" :question/problem "Find the value of $c$ that satisfies the mean value theorem for integrals for $f(x)=-x+2$ on the interval $[-2,2].$" :question/worked-solution "Applying the mean value theorem for the integrals. we have\n\n$$\n\\begin{aligned}f(c)(b-a) & ={\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ f(c) & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\  & =\\frac{1}{2-(-2)}{\\int }_{-2}^{2}(-x+2)\\,\\text{d}x \\\\  & ={\\frac{1}{4}\\cdot (-\\frac{{x}^{2}}{2}+2x)|}_{-2}^{2} \\\\  & =\\frac{1}{4}[(-\\frac{{2}^{2}}{2}+2\\cdot 2)-(-\\frac{(-2)^{2}}{2}+2\\cdot (-2))] \\\\  & =\\frac{1}{4}[2-(-6)] \\\\  & =2.\\end{aligned}\n$$\n\nNow, we use the expression for $f(x)$ to solve for the value of $c:$\n\n$$\n\\begin{aligned}f(c) & =2 \\\\ -c+2 & =2 \\\\ c & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-2474/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "86221215-32a6-5c5a-bcd7-220e166bcee8"] :knowledge-point/questions ["q-2474"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30771/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "ec7de4e6-1c18-5e63-954f-1af030a0a984" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-30771/selection/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer/id #uuid "0475e6ab-