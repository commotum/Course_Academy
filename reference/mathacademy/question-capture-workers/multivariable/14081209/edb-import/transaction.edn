ext{d}x \\\\  & =\\frac{1}{1-(-2)}{\\int }_{-2}^{1}({x}^{3}-2x)\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{-2}^{1}({x}^{3}-2x)\\,\\text{d}x \\\\  & ={\\frac{1}{3}(\\frac{1}{4}{x}^{4}-{x}^{2})|}_{-2}^{1} \\\\  & =\\frac{1}{3}[(\\frac{1}{4}\\cdot {1}^{4}-{1}^{2})-(\\frac{1}{4}\\cdot (-2)^{4}-(-2)^{2})] \\\\  & =\\frac{1}{3}(-\\frac{3}{4}-0) \\\\  & =-\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-30771/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c"] :knowledge-point/questions ["q-30771"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30903/selection/20c9eeaf5b9ffdfb999210b9b505bea7c75fc99368b925bf6dbcdfe1b72abf2f" :answer/id #uuid "afabe4d8-7a6f-581e-ac7c-40d1a4a33283" :answer/type :answer.type/math :answer/value "230-\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30903/selection/b7b192da1dd091fcc6c927fa9ec941f86281b0961d04c3884d1a38df0ca55d97" :answer/id #uuid "b09a779d-8273-58dd-857f-a62049401af2" :answer/type :answer.type/math :answer/value "200-\\frac{12}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30903/selection/4cb80e2fc9a68967b9dd30fcf19e7ae0410daefeecc07274ae0e3a25a774522e" :answer/id #uuid "588dc3dd-bc80-5888-bda7-d183057799e0" :answer/type :answer.type/math :answer/value "220+\\frac{5}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30903/selection/c0e515bdf5b2a0b71deb8bf863d33e2b676d0c95a5168e145ff77398f5a4d46c" :answer/id #uuid "86ac5ef3-a422-5fb8-a11c-5d3923356efa" :answer/type :answer.type/math :answer/value "210-\\frac{1}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30903/selection/a63d7c69df57e4a381680d517ecf373cf2acb5e10802ec04f7ef5d27dc916b00" :answer/id #uuid "b48ce326-1c17-5a52-838e-b1887171d52e" :answer/type :answer.type/math :answer/value "200+\\frac{16}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30903/selection" :answer-field/id #uuid "a391066b-1032-502e-9574-3f5785d5542e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30903/selection/a63d7c69df57e4a381680d517ecf373cf2acb5e10802ec04f7ef5d27dc916b00" :answer-field/choices ["q-30903/selection/20c9eeaf5b9ffdfb999210b9b505bea7c75fc99368b925bf6dbcdfe1b72abf2f" "q-30903/selection/b7b192da1dd091fcc6c927fa9ec941f86281b0961d04c3884d1a38df0ca55d97" "q-30903/selection/4cb80e2fc9a68967b9dd30fcf19e7ae0410daefeecc07274ae0e3a25a774522e" "q-30903/selection/c0e515bdf5b2a0b71deb8bf863d33e2b676d0c95a5168e145ff77398f5a4d46c" "q-30903/selection/a63d7c69df57e4a381680d517ecf373cf2acb5e10802ec04f7ef5d27dc916b00"] :db/ensure [:answer-field/validate]} {:db/id "q-30903" :question/id #uuid "4c918188-0e18-5c96-8d7f-113270e439f2" :question/math-academy-id "q-30903" :question/problem "A biologist found that the population $P$ of some bacteria in a petri dish can be modeled by the function $P(t)=200+8\\operatorname{sin}⁡(\\frac{\\pi }{4}t),$ where $t$ is the number of hours after $12$ noon. Find the average number of bacteria during the period from $12$ noon to $4$ p.m." :question/worked-solution "Since the function is valid starting from $12$ P.M., we can conclude our interval is $[0,4].$\n\nApplying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{P}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}P(t)\\,\\text{d}t \\\\  & =\\frac{1}{4-0}{\\int }_{0}^{4}(200+8\\operatorname{sin}⁡(\\frac{\\pi }{4}t))\\text{d}t \\\\  & ={\\frac{1}{4}(200t-\\frac{32}{\\pi }\\operatorname{cos}⁡(\\frac{\\pi \\,t}{4}))|}_{0}^{4} \\\\  & =\\frac{1}{4}[(200\\cdot 4-\\frac{32}{\\pi }\\operatorname{cos}⁡(\\frac{\\pi \\cdot 4}{4}))-(200\\cdot 0-\\frac{32}{\\pi }\\operatorname{cos}⁡(\\frac{\\pi \\cdot 0}{4}))] \\\\  & =\\frac{1}{4}[(800-\\frac{32}{\\pi }\\operatorname{cos}⁡(\\pi ))-(-\\frac{32}{\\pi }\\operatorname{cos}⁡(0))] \\\\  & =\\frac{1}{4}[(800-\\frac{32}{\\pi }\\cdot (-1))+\\frac{32}{\\pi }\\cdot 1] \\\\  & =\\frac{1}{4}[800+\\frac{32}{\\pi }+\\frac{32}{\\pi }] \\\\  & =\\frac{1}{4}(800+\\frac{64}{\\pi }) \\\\  & =200+\\frac{16}{\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-30903/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c"] :knowledge-point/questions ["q-30903"] :db/ensure [:knowledge-point/validate]} {:db/id "q-30893/selection/62404fa2a3befdbadced522181a75c40bde39f599622d4f84a756feaa05ecb06" :answer/id #uuid "6cb1679d-d1ea-53fa-b29c-8f05e0a0593e" :answer/type :answer.type/math :answer/value "\\frac{2}{3\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30893/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "848814d5-c847-56f3-82e7-1969063db4ca" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-30893/selection/bf97f55407d92f3df8b021d249020e52ad271792a2702da43f45f51f9fb2e9c1" :answer/id #uuid "628e2732-9e24-5921-b8fa-629cbe975ef4" :answer/type :answer.type/math :answer/value "-\\frac{2}{3\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30893/selection/a319e2074b264fdb964c2b6eb43d32d763280e23b0599a55d545f0a58e6fea9e" :answer/id #uuid "7c9da9e5-c033-59c1-97b0-536672acbf2f" :answer/type :answer.type/math :answer/value "\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30893/selection/9677250c9edd0a612a0d750dc6fff6fd833a7f772cd890cb65b14a85469dade3" :answer/id #uuid "a35beb41-be5d-5150-83f9-b2566774d060" :answer/type :answer.type/math :answer/value "-\\frac{2}{\\pi }" :db/ensure [:answer/validate]} {:db/id "q-30893/selection" :answer-field/id #uuid "8b132c79-ba4e-5ead-9b93-15a76ca38b7c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30893/selection/62404fa2a3befdbadced522181a75c40bde39f599622d4f84a756feaa05ecb06" :answer-field/choices ["q-30893/selection/62404fa2a3befdbadced522181a75c40bde39f599622d4f84a756feaa05ecb06" "q-30893/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-30893/selection/bf97f55407d92f3df8b021d249020e52ad271792a2702da43f45f51f9fb2e9c1" "q-30893/selection/a319e2074b264fdb964c2b6eb43d32d763280e23b0599a55d545f0a58e6fea9e" "q-30893/selection/9677250c9edd0a612a0d750dc6fff6fd833a7f772cd890cb65b14a85469dade3"] :db/ensure [:answer-field/validate]} {:db/id "q-30893" :question/id #uuid "c8da72f4-4be3-59c9-b893-26555f51f2de" :question/math-academy-id "q-30893" :question/problem "Within the interval $[-\\frac{\\pi }{2},\\frac{\\pi }{2}],$ determine the average value of $g(x)=\\operatorname{sin}⁡3x-\\operatorname{cos}⁡3x.$" :question/worked-solution "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{g}_{\\text{avg}} & =\\frac{1}{b-a}{\\int }_{a}^{b}g(x)\\,\\text{d}x \\\\  & =\\frac{1}{\\frac{\\pi }{2}-(-\\frac{\\pi }{2})}{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{sin}⁡3x-\\operatorname{cos}⁡3x)\\,\\text{d}x \\\\  & =\\frac{1}{\\pi }{\\int }_{-\\pi /2}^{\\pi /2}(\\operatorname{sin}⁡3x-\\operatorname{cos}⁡3x)\\,\\text{d}x \\\\  & ={\\frac{1}{\\pi }(-\\frac{1}{3}\\operatorname{cos}⁡3x-\\frac{1}{3}\\operatorname{sin}⁡3x)|}_{-\\pi /2}^{\\pi /2} \\\\  & =-\\frac{1}{3\\pi }[(\\operatorname{cos}⁡(3\\cdot \\frac{\\pi }{2})+\\operatorname{sin}⁡(3\\cdot \\frac{\\pi }{2}))-(\\operatorname{cos}⁡(3\\cdot (-\\frac{\\pi }{2}))+\\operatorname{sin}⁡(3\\cdot (-\\frac{\\pi }{2})))] \\\\  & =-\\frac{1}{3\\pi }[(\\operatorname{cos}⁡(\\frac{3\\pi }{2})+\\operatorname{sin}⁡(\\frac{3\\pi }{2}))-(\\operatorname{cos}⁡(-\\frac{3\\pi }{2})+\\operatorname{sin}⁡(-\\frac{3\\pi }{2}))] \\\\  & =-\\frac{1}{3\\pi }[(0+(-1))-(0+1)] \\\\  & =-\\frac{1}{3\\pi }(-2) \\\\  & =\\frac{2}{3\\pi }.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-30893/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55fab3ac-cad3-54bd-b07b-9159554b634c"] :knowledge-point/questions ["q-30893"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316306/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "0eb1a3ab-a4c6-55b8-8739-6a5c9cda8e1c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-316306/field-1" :answer-field/id #uuid "e9bf128c-1b88-5b9e-adb7-7ee48e4e7610" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316306/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-316306/field-1/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-316306/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "30c37489-1167-5f71-92ca-47c1b702b12e" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-316306/field-2" :answer-field/id #uuid "e75cd6b8-f7c8-52e8-91d7-6dc307047c9c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316306/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-316306/field-2/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-316306" :question/id #uuid "89716bdf-323f-525b-8018-ace34761dc72" :question/math-academy-id "q-316306" :question/problem "In **ascending order**, the **exact** nonzero values of $c$ such that the average value of $f(x)=12{x}^{2}-16x-12$ over the interval with endpoints $0$ and $c$ is equal to $0$ are\n\n$c=$\n{{field-1}} $\\,$ and  $\\,c=$\n{{field-2}}." :question/worked-solution "To solve for $c\\ne 0,$ we apply the average value formula:\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{b-a}{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ 0 & =\\frac{1}{c-0}{\\int }_{0}^{c}(12{x}^{2}-16x-12)\\,\\text{d}x \\\\ 0 & ={\\frac{1}{c}(4{x}^{3}-8{x}^{2}-12x)|}_{0}^{c} \\\\ 0 & =\\frac{1}{c}[(4{c}^{3}-8{c}^{2}-12c)-0] \\\\ 0 & =4{c}^{2}-8c-12 \\\\ 0 & =4({c}^{2}-2c-3) \\\\ 0 & =4(c-3)(c+1) \\\\ c & =-1,\\,3\\end{aligned}\n$$\n\nTherefore, in **ascending order**, the values of $c$ are \n\n$$\nc=-1\\,\\text{and}\\,c=3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316306/field-1" "q-316306/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41bedcde-cbc1-5634-8846-eb58ffda32e2"] :knowledge-point/questions ["q-316306"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74069/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a492f9f4-9c9d-5c8f-a371-ab13ec4ada8b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74069/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d3144dae-8030-59f4-813f-2ca1a571ac05" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-74069/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c3aabe9a-f5f7-56e7-b317-98ccfa5b920c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-74069/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "2d57212b-05d0-52e6-a8fc-c40c4fb34078" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-74069/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "0b70ac59-eb21-505d-a7dc-f2de47828d17" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-74069/selection" :answer-field/id #uuid "2bf47106-1eaf-5ef4-9d82-8027465c0a9f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74069/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer-field/choices ["q-74069/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-74069/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-74069/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-74069/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-74069/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-74069" :question/id #uuid "aaa57727-9ab3-5495-b558-e512a24ae7a1" :question/math-academy-id "q-74069" :question/problem "Find $c$ such that the average value of $f(x)=-3\\sqrt{x}$ on the interval $[0,c]$ is equal to $-6.$" :question/worked-solution "To solve for $c,$ we apply the average value formula:\n\n$$\n\\begin{aligned}{f}_{\\text{avg}} & =\\frac{1}{b-a}\\,{\\int }_{a}^{b}f(x)\\,\\text{d}x \\\\ -6 & =\\frac{1}{c-0}\\,{\\int }_{0}^{c}(-3\\sqrt{x})\\,\\text{d}x \\\\ -6 & ={\\frac{1}{c}(-2{x}^{3/2})|}_{0}^{c} \\\\ -6 & =\\frac{1}{c}[(-2{c}^{3/2})-(0)] \\\\ -6 & =-2\\sqrt{c} \\\\ \\sqrt{c} & =3 \\\\ c & =9\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74069/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "41bedcde-cbc1-5634-8846-eb58ffda32e2"] :knowledge-point/questions ["q-74069"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74072/selection/5cbdc998af2ff8246d9cff2de8ab5f3a4ae9186eacbd84f1b1db9a87a1a95f5a" :answer/id #uuid "8090e378-a201-589b-a78f-24fe960a065c" :answer/type :answer.type/math :answer/value "3,\\,5" :db/ensure [:answer/validate]} {:db/id "q-74072/selection/39086a279b92367af9ebf3d055c68d5a26eea0eecc07a00f47d7113be39749a5" :answer/id #uuid "9874b151-c44a-57b4-bf45-da4fd9dae072" :answer/type :answer.type/math :answer/value "5,\\,7" :db/ensure [:answer/validate]} {:db/id "q-74072/selection/50964b53a3364d273910d1fcddffb5246e16e73605b56ef36ab0368d2ace8d93" :answer/id #uuid "c254bb8a-73d2