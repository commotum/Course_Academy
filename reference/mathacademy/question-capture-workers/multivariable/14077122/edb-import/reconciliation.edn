2}}{20} \\\\ \\frac{{x}^{2}}{20}-\\frac{{y}^{2}}{7} & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325932" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/activity-metadata.json" "file_sha256" "6b79d0c8e71050c67741f67c1d2dde70a5ffeeb2c69963c48f8146b82a95eef1"} {"question" "q-325932" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325932" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x^2}{20}-\\frac{y^2}{7}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325931" "field" nil "attribute" "question/problem" "value" "Find the Cartesian equation of the hyperbola $x=\\sqrt{3}\\operatorname{sec}⁡t,\\,y=2\\sqrt{2}\\operatorname{tan}⁡t.$\n\n{{field-1}}\n$=1$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325931" "field" nil "attribute" "question/worked-solution" "value" "To find the Cartesian equation of the hyperbola, we need to eliminate the parameter $t.$ We can do this using the secant-tangent identity.\n\n- Isolating the $\\operatorname{sec}⁡t$ term in the $x$-equation and squaring, we get\n\n$$\n\\begin{aligned}x & =\\sqrt{3}\\operatorname{sec}⁡t \\\\ \\frac{x}{\\sqrt{3}} & =\\operatorname{sec}⁡t \\\\ \\frac{{x}^{2}}{(\\sqrt{3})^{2}} & ={sec}^{2}⁡t \\\\ \\frac{{x}^{2}}{3} & ={sec}^{2}⁡t.\\end{aligned}\n$$\n\n- Isolating the $\\operatorname{tan}⁡t$ term in the $y$-equation and squaring, we get\n\n$$\n\\begin{aligned}y & =2\\sqrt{2}\\operatorname{tan}⁡t \\\\ \\frac{y}{2\\sqrt{2}} & =\\operatorname{tan}⁡t \\\\ \\frac{{y}^{2}}{(2\\sqrt{2})^{2}} & ={tan}^{2}⁡t \\\\ \\frac{{y}^{2}}{8} & ={tan}^{2}⁡t.\\end{aligned}\n$$\n\nSubstituting the two equations into the identity ${tan}^{2}⁡t+1={sec}^{2}⁡t$ and rearranging, we get\n\n$$\n\\begin{aligned}{tan}^{2}⁡t+1 & ={sec}^{2}⁡t \\\\ \\frac{{y}^{2}}{8}+1 & =\\frac{{x}^{2}}{3} \\\\ \\frac{{x}^{2}}{3}-\\frac{{y}^{2}}{8} & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325931" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/activity-metadata.json" "file_sha256" "6b79d0c8e71050c67741f67c1d2dde70a5ffeeb2c69963c48f8146b82a95eef1"} {"question" "q-325931" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325931" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x^2}{3}-\\frac{y^2}{8}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325985" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/assets/5b133ac885861d82704a6d6c2d99b8e4179210e4f28e94bc6d7283da23f97042.png)\n\nThe quarter-hyperbola above is defined by the parametric equations \n\n$$\nx=\\sqrt{5}\\operatorname{sec}⁡t,\\,y=\\sqrt{6}\\operatorname{tan}⁡t.\n$$\n\nDetermine the domain of the parameter $t$ for this quarter, assuming that the entire parabola is defined only for $t\\in [-\\pi ,\\pi ].$\n\n$t\\in [${{field-1}}$,$\n{{field-2}}$)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325985" "field" nil "attribute" "question/worked-solution" "value" "The parametric equations of the full hyperbola are\n\n$$\nx=\\sqrt{5}\\operatorname{sec}⁡t,\\,y=\\sqrt{6}\\operatorname{tan}⁡t,\\,t\\in [-\\pi ,\\pi ],\\,t\\ne \\pm \\frac{\\pi }{2}.\n$$\n\nTo restrict the parameterization to a quarter-hyperbola, we refer to the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/assets/6ac31692404208d80637291fb30be028a7efdc3a172af0337da26039f1e87326.png)\n\nWe can see that if we restrict $t$ to $[-\\pi ,-\\frac{\\pi }{2}),$ we get only the quarter-hyperbola.\n\nTherefore, the parametric equations that describe the required quarter-hyperbola are\n\n$$\nx=\\sqrt{5}\\operatorname{sec}⁡t,\\,y=\\sqrt{6}\\operatorname{tan}⁡t,\\,t\\in [-\\pi ,-\\frac{\\pi }{2}).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325985" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/activity-metadata.json" "file_sha256" "6b79d0c8e71050c67741f67c1d2dde70a5ffeeb2c69963c48f8146b82a95eef1"} {"question" "q-325985" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325985" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\pi"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325985" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-325985" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{\\pi}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077122/state.json" "file_sha256" "636fa6983d58c40e15a33f6aa4ad25de24933f58ddf4e172191689086b10b2f6"} {"question" "q-106594" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_