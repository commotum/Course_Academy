orrect "q-106509/selection/138c49182b2ee081af946e35aaf53d58e1951168546695bbc9cfc9fdeef88502" :answer-field/choices ["q-106509/selection/93183218543728eb2b93a278cc15172f7ff0ee3b344d55a390e3bdfb993962e7" "q-106509/selection/7cc746723dcf4138fcb0df0d271445f203f280db9055ebd4ef7d2a27525b03d6" "q-106509/selection/00ab98f045cbbdd0b8b91b4cb1a24348d21789c3d84ca0d5cc743c7a48ef4334" "q-106509/selection/138c49182b2ee081af946e35aaf53d58e1951168546695bbc9cfc9fdeef88502" "q-106509/selection/1ba53d4aa29404e90e9e860a6daecce5169803aae0d43e728f944041ef35b954"] :db/ensure [:answer-field/validate]} {:db/id "q-106509" :question/id #uuid "6884465a-f493-5a74-9bcc-3f6f410be1b3" :question/math-academy-id "q-106509" :question/problem "What are the parametric equations of the hyperbola ${x}^{2}-\\frac{{y}^{2}}{9}=1?$" :question/worked-solution "The parametric equations of a horizontal hyperbola with Cartesian equation\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1\n$$\n\nare given by\n\n$$\nx=a\\operatorname{sec}⁡t,\\,y=b\\operatorname{tan}⁡t.\n$$\n\nIn our case, $a=1$ and $b=\\sqrt{9}=3.$ Therefore, the parametric equations are\n\n$$\nx=\\operatorname{sec}⁡t,\\,y=3\\operatorname{tan}⁡t.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106509/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2669e657-da47-5e22-9ac5-7a69f3b0a55f"] :knowledge-point/questions ["q-106509"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325900/field-1/7a019166d53f8f445cfca04bbbb5d9fea414f91656d4091feae12bd71715d58a" :answer/id #uuid "f21de89a-e012-54a6-b4b8-f8baa2d1e0aa" :answer/type :answer.type/math :answer/value "5\\tan(t)" :db/ensure [:answer/validate]} {:db/id "q-325900/field-1/bb27a9b9ef8265d1d4d47ef30527c31dc8d9d04ed95d2d7faf07e61d54311d94" :answer/id #uuid "eb4c38f5-8e07-5507-bf9e-e1e66e546e9c" :answer/type :answer.type/math :answer/value "3\\tan(t)" :db/ensure [:answer/validate]} {:db/id "q-325900/field-1" :answer-field/id #uuid "f8d67a59-342d-5405-91e3-abbfe9edc76c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325900/field-1/7a019166d53f8f445cfca04bbbb5d9fea414f91656d4091feae12bd71715d58a" :answer-field/choices ["q-325900/field-1/7a019166d53f8f445cfca04bbbb5d9fea414f91656d4091feae12bd71715d58a" "q-325900/field-1/bb27a9b9ef8265d1d4d47ef30527c31dc8d9d04ed95d2d7faf07e61d54311d94"] :db/ensure [:answer-field/validate]} {:db/id "q-325900" :question/id #uuid "37fcb16a-9359-5abe-abfd-1125176fde9f" :question/math-academy-id "q-325900" :question/problem "Complete the following parametric equations generating the hyperbola $25{x}^{2}-9{y}^{2}=225$ in terms of the parameter $t,$ defined for $t\\in [-\\pi ,\\pi ]$ where $t\\ne \\pm \\frac{\\pi }{2}.$\n\n$x=3\\operatorname{sec}⁡t,\\,$\n$y=$\n{{field-1}}" :question/worked-solution "The parametric equations of a horizontal hyperbola with Cartesian equation\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1\n$$\n\nare given by\n\n$$\nx=a\\operatorname{sec}⁡t,\\,y=b\\operatorname{tan}⁡t.\n$$\n\nFirst, we rewrite the equation of our hyperbola in standard form, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-9{y}^{2} & =225 \\\\ \\frac{25{x}^{2}}{225}-\\frac{9{y}^{2}}{225} & =1 \\\\ \\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, in our case, we have $a=\\sqrt{9}=3$ and $b=\\sqrt{25}=5.$ Therefore, the parametric equations are\n\n$$\nx=3\\operatorname{sec}⁡t,\\,y=5\\operatorname{tan}⁡t.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-325900/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2669e657-da47-5e22-9ac5-7a69f3b0a55f"] :knowledge-point/questions ["q-325900"] :db/ensure [:knowledge-point/validate]} {:db/id "q-325892/field-1/14c5650e8a374c123552d1a072b04d8a250dba2c68db2b5f25eba7cb42b69ced" :answer/id #uuid "1b698401-ed1d-5d99-9ddc-df74f8c11057" :answer/type :answer.type/math :answer/value "6\\tan(t)" :db/ensure [:answer/validate]} {:db/id "q-325892/field-1" :answer-field/id #uuid "8f294ff0-ec91-5e31-bd9b-c4a3a86f2eac" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-325892/field-1/14c5650e8a374c123552d1a072b04d8a250dba2c68db2b5f25eba7cb42b69ced" :answer-field/choices ["q-325892/field-1/14c5650e8a374c123552d1a072b04d8a250dba2c68db2b5f25eba7cb42b69ced"] :db/ensure [:answer-field/validate]} {:db/id "q-325892" :question/id #uuid "ae7b8fd5-a18f-5fb5-a00a-406d9956174f" :question/math-academy-id "q-325892" :question/problem "Complete the following parametric equations generating the hyperbola $\\frac{{x}^{2}}{100}-\\frac{{y}^{2}}{36}=1$ in terms of the parameter $t,$ defined for $t\\in [-\\pi ,\\pi ]$ where $t\\ne \\pm \\frac{\\pi }{2}.$\n\n$x=10\\operatorname{sec}⁡t,\\,$\n$y=$\n{{field-1}}" :question/worked-solution "The parametric equations of a horizontal hyperbola with Cartesian equation\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1\n$$\n\nare given by\n\n$$\nx=a\\operatorname{sec}⁡t,\\,y=b\\operatorname{tan}⁡t.\n$$\n\nIn our case, $a=\\sqrt{100}=10$ and $b=\\sqrt{36}=6.$ Therefore, the parametric equations are\n\n$$\nx=10\\operatorname{sec}⁡t,\\,y=6\\operatorname{tan}⁡t.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-325892/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2669e657-da47-5e22-9ac5-7a69f3b0a55f"] :knowledge-point/questions ["q-325892"] :db/ensure [:knowledge-point/validate]} {:db/id "q-274721/field-1/074db57ccf825fbe5a10a70e35cb67baad9ac7c62bbea6742236ffcef4f68926" :answer/id #uuid "9360eeaf-641c-5e60-8329-99af413294cd" :answer/type :answer.type/math :answer/value "4\\tan(t)" :db/ensure [:answer/validate]} {:db/id "q-274721/field-1" :answer-field/id #uuid "f8a24f84-3d59-5512-99de-c207276923c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-274721/field-1/074db57ccf825fbe5a10a70e35cb67baad9ac