[{:db/id "q-74196/selection/0dfb0bf1507ba51fcaa3543f31ae89d61e9812f2302c3d5d6875a7b1333a59a3" :answer/id #uuid "63e1dd70-a357-58e8-b8ee-e09b32244d33" :answer/type :answer.type/math :answer/value "(1,\\frac{7\\pi }{4},-1)" :db/ensure [:answer/validate]} {:db/id "q-74196/selection/29f48bbd2eaf46573b30ae973a8caeb710ff235174c2f6066b1ff435c32edcc4" :answer/id #uuid "e53183e0-c5f0-521c-9b7b-6fc7169249b9" :answer/type :answer.type/math :answer/value "(1,\\frac{7\\pi }{4},1)" :db/ensure [:answer/validate]} {:db/id "q-74196/selection/f92007b2b3d8ebbb31f91372d846e0b35242e749f016589696c3bcefe237f12f" :answer/id #uuid "11f8d8d6-fa4a-5b61-b8ea-7604c8187285" :answer/type :answer.type/math :answer/value "(1,\\frac{\\pi }{4},-1)" :db/ensure [:answer/validate]} {:db/id "q-74196/selection/18d4727dab49364e957ba6a7d98429a3cbcedeac85f18c99ef57873c53256bb9" :answer/id #uuid "45a3a300-cc2b-5b0c-87dd-c5588a59a6d4" :answer/type :answer.type/math :answer/value "(1,\\frac{3\\pi }{4},-1)" :db/ensure [:answer/validate]} {:db/id "q-74196/selection/dbc0683e5c8bfb910274986a530fd2264788620171729ee91105c17e96171a7c" :answer/id #uuid "6b344122-6d56-5fb8-bf9f-0f372d4ad6c7" :answer/type :answer.type/math :answer/value "(-1,\\frac{\\pi }{4},1)" :db/ensure [:answer/validate]} {:db/id "q-74196/selection" :answer-field/id #uuid "0f4b53d1-dcd0-55d1-a450-7fb67bbbda3d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74196/selection/0dfb0bf1507ba51fcaa3543f31ae89d61e9812f2302c3d5d6875a7b1333a59a3" :answer-field/choices ["q-74196/selection/0dfb0bf1507ba51fcaa3543f31ae89d61e9812f2302c3d5d6875a7b1333a59a3" "q-74196/selection/29f48bbd2eaf46573b30ae973a8caeb710ff235174c2f6066b1ff435c32edcc4" "q-74196/selection/f92007b2b3d8ebbb31f91372d846e0b35242e749f016589696c3bcefe237f12f" "q-74196/selection/18d4727dab49364e957ba6a7d98429a3cbcedeac85f18c99ef57873c53256bb9" "q-74196/selection/dbc0683e5c8bfb910274986a530fd2264788620171729ee91105c17e96171a7c"] :db/ensure [:answer-field/validate]} {:db/id "q-74196" :question/id #uuid "c3c82b8a-7967-52e2-8482-c631843361f7" :question/math-academy-id "q-74196" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/3a919c1ad631af6dfea304db2bdf0ad36fcbff6162f516e8591d7ce9cef3ecca.png)\n\nWhat are the cylindrical polar coordinates of the point $P?$" :question/worked-solution "We write the position of a point in cylindrical coordinates as $(r,\\theta ,z),$ where $r\\ge 0$ and $0\\le \\theta <2\\pi .$\n\nAccording to the diagram, we have the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/c06f6a453581797596203059e6a1bfd30afd959f469f0408889c6c947a368809.png)\n\n \n\n- The ray from the origin through ${P}^{′}$ makes an angle of $\\theta =2\\pi -\\frac{\\pi }{4}=\\frac{7\\pi }{4}$ radians with the positive $x$-axis.\n\n- The distance from the origin to ${P}^{′}$ is $r=1.$\n\n- The $z$-coordinate is $z=1$ because $P$ lies $1$ unit *below* the $xy$-plane.\n\nSo, the cylindrical coordinates of $P$ are $(1,\\frac{7\\pi }{4},-1).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74196/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fad1a9a-7860-5c31-8b3a-e9279f88965b"] :knowledge-point/questions ["q-74196"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74460/selection/19b2f324c6a733a7430bbb60af1aa141ac2517a8d5884eab78ea51e38b288f16" :answer/id #uuid "d84253b9-98e5-5eea-b9e1-7fb55fa72025" :answer/type :answer.type/math :answer/value "(2,\\frac{5\\pi }{3},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-74460/selection/5ddceafed6ae9c6273b50a85e10e6abeb8f94fc5fc3e4cbf5e3ffdd02f4583fe" :answer/id #uuid "bbed4d0a-26d9-515a-9d79-a7d7832f4094" :answer/type :answer.type/math :answer/value "(2,\\frac{5\\pi }{3},2)" :db/ensure [:answer/validate]} {:db/id "q-74460/selection/31cc7c47147dd2d427e0faac132ac4c028cdc2a909e10b929b543b77ccbee62d" :answer/id #uuid "116ee320-b30c-51b0-8cf5-78850e685f34" :answer/type :answer.type/math :answer/value "(\\sqrt{2},\\frac{5\\pi }{3},-2)" :db/ensure [:answer/validate]} {:db/id "q-74460/selection/d43c550642d2c80149bd455e80697bbb17e151247a3a179e390139854dd8b088" :answer/id #uuid "7bb8e3d2-ba93-5ec3-b22d-8bbbccf865ef" :answer/type :answer.type/math :answer/value "(-2,\\frac{\\pi }{3},\\sqrt{2})" :db/ensure [:answer/validate]} {:db/id "q-74460/selection/88f167fd021e03252cab2ea86622cbe7e41fe0ef165356b225290ae0e010b312" :answer/id #uuid "3a9e9c0c-df90-5ed5-a7f6-832af8b695da" :answer/type :answer.type/math :answer/value "(\\sqrt{2},\\frac{\\pi }{3},2)" :db/ensure [:answer/validate]} {:db/id "q-74460/selection" :answer-field/id #uuid "e66826c8-afe5-5efe-94e7-526b9beb74e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74460/selection/31cc7c47147dd2d427e0faac132ac4c028cdc2a909e10b929b543b77ccbee62d" :answer-field/choices ["q-74460/selection/19b2f324c6a733a7430bbb60af1aa141ac2517a8d5884eab78ea51e38b288f16" "q-74460/selection/5ddceafed6ae9c6273b50a85e10e6abeb8f94fc5fc3e4cbf5e3ffdd02f4583fe" "q-74460/selection/31cc7c47147dd2d427e0faac132ac4c028cdc2a909e10b929b543b77ccbee62d" "q-74460/selection/d43c550642d2c80149bd455e80697bbb17e151247a3a179e390139854dd8b088" "q-74460/selection/88f167fd021e03252cab2ea86622cbe7e41fe0ef165356b225290ae0e010b312"] :db/ensure [:answer-field/validate]} {:db/id "q-74460" :question/id #uuid "20767a75-5369-5236-acee-13aa15c1cb10" :question/math-academy-id "q-74460" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/947857af9d5746ceef623a5d2cc2bf0ac82e6570d7f288727a7591278fc50452.png)\n\nWhat are the cylindrical polar coordinates of the point $M?$" :question/worked-solution "We write the position of a point in cylindrical coordinates as $(r,\\theta ,z),$ where $r\\ge 0$ and $0\\le \\theta <2\\pi .$\n\nAccording to the diagram, we have the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/88aeecb46c1f996a7a2a8947a8b5262faa2991992771a960a1e806c2b8915cac.png)\n\n \n\n- The ray from the origin through ${M}^{′}$ makes an angle of $\\theta =2\\pi -\\frac{\\pi }{3}=\\frac{5\\pi }{3}$ radians with the positive $x$-axis.\n\n- The distance from the origin to ${M}^{′}$ is $r=\\sqrt{2}.$\n\n- The $z$-coordinate is $z=2$ because $M$ lies $2$ units *below* the $xy$-plane.\n\nSo, the cylindrical coordinates of $M$ are $(\\sqrt{2},\\frac{5\\pi }{3},-2).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74460/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fad1a9a-7860-5c31-8b3a-e9279f88965b"] :knowledge-point/questions ["q-74460"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-74430"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/dcf326a7962c01814c937e07083193a107597e1995fb66dffd5776a40cf07a9f.png)\n\nWhat are the cylindrical polar coordinates of the point $F?$" :question/worked-solution "We write the position of a point in cylindrical coordinates as $(r,\\theta ,z),$ where $r\\ge 0$ and $0\\le \\theta <2\\pi .$\n\nAccording to the diagram, we have the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/189c1f77e7d2dfd97f51e05f4be55423d100921d2dcad5cafe4be4d90463e8d8.png)\n\n \n\n- The ray from the origin through ${F}^{′}$ makes an angle of $\\theta =\\frac{\\pi }{5}$ radians with the positive $x$-axis.\n\n- The distance from the origin to ${F}^{′}$ is $r=1.$\n\n- The $z$-coordinate is $z=-1$ because $F$ lies $1$ unit *below* the $xy$-plane.\n\nSo, the cylindrical coordinates of $F$ are $(1,\\frac{\\pi }{5},-1).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-74456/selection/7ce1ad512f6dc2b18664bcec38f1a25a19c67d22c58aa7ee65de73ceba04530e" :answer/id #uuid "4cb17452-332e-5cf4-bdea-ff585699fa77" :answer/type :answer.type/math :answer/value "(\\frac{5}{4},\\frac{\\pi }{4},2)" :db/ensure [:answer/validate]} {:db/id "q-74456/selection/2cf8d35843d28f392698d99e61cdbe905bf7614e6750ba156c8a7ba34ec8659d" :answer/id #uuid "70a9eeb9-26d9-5b4e-a329-5d37c3c158b8" :answer/type :answer.type/math :answer/value "(\\frac{4}{5},\\frac{5\\pi }{4},-2)" :db/ensure [:answer/validate]} {:db/id "q-74456/selection/77d7eb657a2eae900eb752c695a90accbccd13d135107ce03fa7078a9d0681c4" :answer/id #uuid "a7d217c7-7a90-508d-8f8a-9260d4e9cbc5" :answer/type :answer.type/math :answer/value "(\\frac{5}{4},\\frac{5\\pi }{4},2)" :db/ensure [:answer/validate]} {:db/id "q-74456/selection/c7b4d3246c30aa19043b9b66e11ed81a769fbeb05ee5ea562090989d3223f14b" :answer/id #uuid "781fde25-1a84-56ab-8b9d-a1efb7e381c9" :answer/type :answer.type/math :answer/value "(\\frac{3}{4},\\frac{4\\pi }{5},2)" :db/ensure [:answer/validate]} {:db/id "q-74456/selection/542b5e66fd40cc990455e7d197f9a0d850297198a65d95081e968fcf0d614ef9" :answer/id #uuid "99927f45-57a4-5e55-aaef-472f1ccee159" :answer/type :answer.type/math :answer/value "(\\frac{4}{5},\\frac{\\pi }{4},2)" :db/ensure [:answer/validate]} {:db/id "q-74456/selection" :answer-field/id #uuid "1334cdea-bafa-51db-b8b2-6795b8974fc3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74456/selection/77d7eb657a2eae900eb752c695a90accbccd13d135107ce03fa7078a9d0681c4" :answer-field/choices ["q-74456/selection/7ce1ad512f6dc2b18664bcec38f1a25a19c67d22c58aa7ee65de73ceba04530e" "q-74456/selection/2cf8d35843d28f392698d99e61cdbe905bf7614e6750ba156c8a7ba34ec8659d" "q-74456/selection/77d7eb657a2eae900eb752c695a90accbccd13d135107ce03fa7078a9d0681c4" "q-74456/selection/c7b4d3246c30aa19043b9b66e11ed81a769fbeb05ee5ea562090989d3223f14b" "q-74456/selection/542b5e66fd40cc990455e7d197f9a0d850297198a65d95081e968fcf0d614ef9"] :db/ensure [:answer-field/validate]} {:db/id "q-74456" :question/id #uuid "4690f5df-0d5c-5893-b967-ee1c189586a6" :question/math-academy-id "q-74456" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/c6de44233dec37e695e70902e0dace0771dd42a4cb87b45205345ba431e7774c.png)\n\nWhat are the cylindrical polar coordinates of the point $K?$" :question/worked-solution "We write the position of a point in cylindrical coordinates as $(r,\\theta ,z),$ where $r\\ge 0$ and $0\\le \\theta <2\\pi .$\n\nAccording to the diagram, we have the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/7c49639200c77c264ecb7b58e1eda4053b3ab0fe378d35caa3d3f8bdc6ad5027.png)\n\n  \n\n- The ray from the origin through ${K}^{′}$ makes an angle of $\\theta =\\frac{3\\pi }{2}-\\frac{\\pi }{4}=\\frac{5\\pi }{4}$ radians with the positive $x$-axis.\n\n- The distance from the origin to ${K}^{′}$ is $r=\\frac{5}{4}.$\n\n- The $z$-coordinate is $z=2$ because $K$ lies $2$ units *above* the $xy$-plane.\n\nSo, the cylindrical coordinates of $K$ are $(\\frac{5}{4},\\frac{5\\pi }{4},2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74456/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fad1a9a-7860-5c31-8b3a-e9279f88965b"] :knowledge-point/questions ["q-74456"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74455/selection/da62ec5cbd5d78c601c505b2b7e321aafba48cbbb21b1c4b4efaca126a16a5f2" :answer/id #uuid "53e57438-ec6b-50d3-b053-d241f6947281" :answer/type :answer.type/math :answer/value "(2,\\frac{\\pi }{3},-\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-74455/selection/09462ab6ea769b09399b4872617c71f62e87e0bf1d14a6f027e341cc64ef98b4" :answer/id #uuid "72fcdd34-76db-546b-8f64-0d10d3265758" :answer/type :answer.type/math :answer/value "(\\sqrt{3},\\frac{\\pi }{6},2)" :db/ensure [:answer/validate]} {:db/id "q-74455/selection/356e682e5cd613b645c7a7bd636efe4070c6eaafde94c941f32975a5921f63b6" :answer/id #uuid "068ecdfa-0222-58f3-99f8-a976c7ba15b9" :answer/type :answer.type/math :answer/value "(3,\\frac{\\pi }{3},2)" :db/ensure [:answer/validate]} {:db/id "q-74455/selection/bbbd0aad74b6bca31aee5aafe8b1952990ec283abd930226d4c0b779234a846e" :answer/id #uuid "06cb26d4-a720-526c-b64d-913efcc9462a" :answer/type :answer.type/math :answer/value "(2,\\frac{\\pi }{6},-\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-74455/selection/9dc346475b78366a34b556fdc3c3bf5175d47f99e827472e0ffe477d1b1cb3f0" :answer/id #uuid "a8961439-ec9c-5d8e-a94f-a728a2225ea6" :answer/type :answer.type/math :answer/value "(2,\\frac{\\pi }{3},\\sqrt{3})" :db/ensure [:answer/validate]} {:db/id "q-74455/selection" :answer-field/id #uuid "fbd753ca-fbfc-5a86-87cf-c0d7810a4541" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74455/selection/9dc346475b78366a34b556fdc3c3bf5175d47f99e827472e0ffe477d1b1cb3f0" :answer-field/choices ["q-74455/selection/da62ec5cbd5d78c601c505b2b7e321aafba48cbbb21b1c4b4efaca126a16a5f2" "q-74455/selection/09462ab6ea769b09399b4872617c71f62e87e0bf1d14a6f027e341cc64ef98b4" "q-74455/selection/356e682e5cd613b645c7a7bd636efe4070c6eaafde94c941f32975a5921f63b6" "q-74455/selection/bbbd0aad74b6bca31aee5aafe8b1952990ec283abd930226d4c0b779234a846e" "q-74455/selection/9dc346475b78366a34b556fdc3c3bf5175d47f99e827472e0ffe477d1b1cb3f0"] :db/ensure [:answer-field/validate]} {:db/id "q-74455" :question/id #uuid "4d042fb9-aa57-556a-8a5e-0719c71e7350" :question/math-academy-id "q-74455" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/b8f187c949db780dc4ef62360c76be4a952e2c299257c6d4e9ee80c7254605d6.png)\n\nWhat are the cylindrical polar coordinates of the point $W?$" :question/worked-solution "We write the position of a point in cylindrical coordinates as $(r,\\theta ,z),$ where $r\\ge 0$ and $0\\le \\theta <2\\pi .$\n\nAccording to the diagram, we have the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033855/assets/d1855e0e8f1b8feed4eb2f5fb9dd2a1abadd0ee92304ae0460f9bd130e376b04.png)\n\n  \n\n- The ray from the origin through ${W}^{′}$ makes an angle of $\\theta =\\frac{\\pi }{2}-\\frac{\\pi }{6}=\\frac{\\pi }{3}$ radians with the positive $x$-axis.\n\n- The distance from the origin to ${W}^{′}$ is $r=2.$\n\n- The $z$-coordinate is $z=\\sqrt{3}$ because $W$ lies $\\sqrt{3}$ units *above* the $xy$-plane.\n\nSo, the cylindrical coordinates of $W$ are $(2,\\frac{\\pi }{3},\\sqrt{3}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74455/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0fad1a9a-7860-5c31-8b3a-e9279f88965b"] :knowledge-point/questions ["q-74455"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-74299"] :question/problem "The point $P$ has cylindrical polar coordinates $(4,\\frac{\\pi }{6},-2).$ Find the Cartesian coordinates of $P.$" :question/worked-solution "If $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =4\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =4\\cdot \\frac{\\sqrt{3}}{2} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =4\\operatorname{sin}⁡(\\frac{\\pi }{6}) \\\\  & =4\\cdot \\frac{1}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(2\\sqrt{3},2,-2).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-74474/selection/ddd66406762dd1a653df2d30b0551632bf229f64997eeafa40da1fc140d2cce6" :answer/id #uuid "d4f8a570-c9e8-53f2-acf0-3cdd52caaaaf" :answer/type :answer.type/math :answer/value "(-2,2,-3)" :db/ensure [:answer/validate]} {:db/id "q-74474/selection/b5a7841591ce8c53ca5111b0060a2792ad6d079256d407b11d647078a0f87bad" :answer/id #uuid "7ce8601e-ac9f-5552-ba08-f5ca7454d79c" :answer/type :answer.type/math :answer/value "(-2\\sqrt{2},-2,-3)" :db/ensure [:answer/validate]} {:db/id "q-74474/selection/333d7f7a581da11780bd851bb25529fe7465acffa682ffd05e9d482b0d022414" :answer/id #uuid "266c9573-a4de-5acd-a642-a29005a8422d" :answer/type :answer.type/math :answer/value "(2,\\sqrt{2},-3)" :db/ensure [:answer/validate]} {:db/id "q-74474/selection/eb97cf38fc3979457498dfda47a19fe949ff1dc5b6c0f0caf311bff5ed67b305" :answer/id #uuid "25569dc0-0eca-59e1-bd9e-eacd25bcf060" :answer/type :answer.type/math :answer/value "(2,-2\\sqrt{2},-3)" :db/ensure [:answer/validate]} {:db/id "q-74474/selection/dcf447871234f8987d68418631354fb1a66a729d27653cc03b6db7d3b71f2432" :answer/id #uuid "631a3e13-3f7b-5f39-a7aa-773a196e092a" :answer/type :answer.type/math :answer/value "(2,2,-3)" :db/ensure [:answer/validate]} {:db/id "q-74474/selection" :answer-field/id #uuid "63ea183d-3390-5597-9df7-e59224d62a1a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74474/selection/ddd66406762dd1a653df2d30b0551632bf229f64997eeafa40da1fc140d2cce6" :answer-field/choices ["q-74474/selection/ddd66406762dd1a653df2d30b0551632bf229f64997eeafa40da1fc140d2cce6" "q-74474/selection/b5a7841591ce8c53ca5111b0060a2792ad6d079256d407b11d647078a0f87bad" "q-74474/selection/333d7f7a581da11780bd851bb25529fe7465acffa682ffd05e9d482b0d022414" "q-74474/selection/eb97cf38fc3979457498dfda47a19fe949ff1dc5b6c0f0caf311bff5ed67b305" "q-74474/selection/dcf447871234f8987d68418631354fb1a66a729d27653cc03b6db7d3b71f2432"] :db/ensure [:answer-field/validate]} {:db/id "q-74474" :question/id #uuid "2bfca49b-1cfe-599f-b76c-99ada9ea4dad" :question/math-academy-id "q-74474" :question/problem "The point $Q$ has cylindrical coordinates $(2\\sqrt{2},\\frac{3\\pi }{4},-3).$ Find the Cartesian coordinates of $Q.$" :question/worked-solution "If $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =2\\sqrt{2}\\cdot (\\frac{-\\sqrt{2}}{2}) \\\\  & =-2.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =2\\sqrt{2}\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =2\\sqrt{2}\\cdot (\\frac{\\sqrt{2}}{2}) \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $Q$ are $(-2,2,-3).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74474/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bb1182f-76ed-514d-808a-94cad16bc2c7"] :knowledge-point/questions ["q-74474"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74469/selection/dd3b4d9b4169e6bf4b65b34417aba8af34d393ea4953d5d729437d223fb597e6" :answer/id #uuid "2de1832a-32f9-5914-8ee4-e626bacc96d3" :answer/type :answer.type/math :answer/value "(1,\\frac{\\sqrt{2}}{2},-1)" :db/ensure [:answer/validate]} {:db/id "q-74469/selection/409e23f1413c913256f8acef6f81c1f53202ecab66a8007ac428fcd2a49a7014" :answer/id #uuid "ebda8b4b-32d9-5a53-b46d-2d31fdf7f3f8" :answer/type :answer.type/math :answer/value "(-1,\\sqrt{2},-1)" :db/ensure [:answer/validate]} {:db/id "q-74469/selection/e6897260d256207cf875dacc7d5dcf5ed1c1abb82b8499a2411ce58fab80