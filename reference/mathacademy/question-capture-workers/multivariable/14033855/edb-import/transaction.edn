os}⁡\\theta  \\\\  & =\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =1.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =\\sqrt{2}\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(1,1,-1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74469/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9bb1182f-76ed-514d-808a-94cad16bc2c7"] :knowledge-point/questions ["q-74469"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-74300"] :question/problem "The point $Q$ has cylindrical coordinates $(5,\\pi ,7).$ Find the Cartesian coordinates of $Q.$" :question/worked-solution "If $(r,\\theta ,z)$ are the cylindrical polar coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,z=z\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =5\\operatorname{cos}⁡(\\pi ) \\\\  & =5\\cdot (-1) \\\\  & =-5.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =r\\operatorname{sin}⁡\\theta  \\\\  & =5\\operatorname{sin}⁡(\\pi ) \\\\  & =5\\cdot 0 \\\\  & =0.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $Q$ are $(-5,0,7).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-168896/selection/15f90eaa350b43a51abffba20e22f76c12e79b9f805df9e49fe0fe21fee778ec" :answer/id #uuid "8e69a953-dd80-5431-b0f1-eb4e0406ca3a" :answer/type :answer.type/math :answer/value "(2\\sqrt{3},4,-5)" :db/ensure [:answer/validate]} {:db/id "q-168896/selection/a078a8b66394a285c41df3cdad80cf6159b2d56f74f6626a23694c657be6c274" :answer/id #uuid "e1614bdf-52