6b65904e1"] :db/ensure [:answer-field/validate]} {:db/id "q-123517" :question/id #uuid "d8f25bbf-4e2b-5901-9f0f-91861655df78" :question/math-academy-id "q-123517" :question/problem "${\\int }_{0}^{6}⟨{e}^{-t},\\,4{t}^{2}⟩\\,\\text{d}t=$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}⟨{e}^{-t},\\,4{t}^{2}⟩\\,\\text{d}t & =⟨{\\int }_{0}^{6}{e}^{-t}\\,\\text{d}t,{\\int }_{0}^{6}4{t}^{2}\\,\\text{d}t⟩ \\\\  & =⟨(-{e}^{-t}){|}_{0}^{6},\\,\\frac{4}{3}{t}^{3}\\,{|}_{0}^{6}⟩ \\\\  & =⟨-{e}^{-6}+{e}^{-0},\\,\\frac{4}{3}\\cdot {6}^{3}-\\frac{4}{3}\\cdot {0}^{3}⟩ \\\\  & =⟨1-\\frac{1}{{e}^{6}},\\,288⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-123517/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f"] :knowledge-point/questions ["q-123517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349147/field-1/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225" :answer/id #uuid "8d1aab51-65cb-5fcc-b95b-6ee586256733" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "q-349147/field-1" :answer-field/id #uuid "1ad3696c-ddc0-535e-9e05-7cf9407c510b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349147/field-1/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225" :answer-field/choices ["q-349147/field-1/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225"] :db/ensure [:answer-field/validate]} {:db/id "q-349147/field-2/f1a3f6364b4b6488166c92c743a5a8e2e2bdb28aff5bc6025ac2678cb4926932" :answer/id #uuid "d2da444f-5894-574e-a687-136da4e5ad37" :answer/type :answer.type/math :answer/value "200" :db/ensure [:answer/validate]} {:db/id "q-349147/field-2" :answer-field/id #uuid "a3a4bf87-ed49-5dcf-98ac-d829a358ca67" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349147/field-2/f1a3f6364b4b6488166c92c743a5a8e2e2bdb28aff5bc6025ac2678cb4926932" :answer-field/choices ["q-349147/field-2/f1a3f6364b4b6488166c92c743a5a8e2e2bdb28aff5bc6025ac2678cb4926932"] :db/ensure [:answer-field/validate]} {:db/id "q-349147" :question/id #uuid "baea03dd-15c5-569c-9f74-7ecdd75c4adb" :question/math-academy-id "q-349147" :question/problem "Evaluate the following integral of a vector-valued function. Do not round the answer.\n\n${\\int }_{0}^{4}⟨{t}^{2}-2t,\\,3{t}^{3}+t⟩\\,\\text{d}t=⟨$\n{{field-1}}$,$\n{{field-2}} $⟩$" :question/worked-solution "To integrate a vector-valued function, we integrate each component separately:\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}⟨{t}^{2}-2t,\\,3{t}^{3}+t⟩\\,\\text{d}t & =⟨{\\int }_{0}^{4}({t}^{2}-2t)\\,\\text{d}t,\\,{\\int }_{0}^{4}(3{t}^{3}+t)\\,\\text{d}t⟩.\\end{aligned}\n$$\n\nFor the first component,\n\n$$\n\\int ({t}^{2}-2t)\\,\\text{d}t=\\frac{1}{3}{t}^{3}-{t}^{2}.\n$$\n\nFor the second component,\n\n$$\n\\int (3{t}^{3}+t)\\,\\text{d}t=3\\cdot \\frac{1}{4}{t}^{4}+\\frac{1}{2}{t}^{2}=\\frac{3}{4}{t}^{4}+\\frac{1}{2}{t}^{2}.\n$$\n\nThus,\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}⟨{t}^{2}-2t,\\,3{t}^{3}+t⟩\\,\\text{d}t & =⟨(\\frac{1}{3}{t}^{3}-{t}^{2}){|}_{0}^{4},\\,(\\frac{3}{4}{t}^{4}+\\frac{1}{2}{t}^{2}){|}_{0}^{4}⟩ \\\\  & =⟨(\\frac{1}{3}(64)-16)-0,\\,(\\frac{3}{4}(256)+\\frac{1}{2}(16))-0⟩ \\\\  & =⟨(\\frac{64}{3}-16),\\,(192+8)⟩ \\\\  & =⟨\\frac{16}{3},\\,200⟩ \\\\  & =⟨\\frac{16}{3},\\,200⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349147/field-1" "q-349147/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3081ffe7-c448-5e0d-8dd1-808d23199a7f"] :knowledge-point/questions ["q-349147"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123456/selection/6fa2e63d4abaedfbb7f495132799e24eebbe0eadcc05d615d11d667f1b9d04fa" :answer/id #uuid "3432b9b6-ffa1-5971-810d-