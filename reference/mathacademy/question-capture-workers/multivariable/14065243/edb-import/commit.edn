(v\\operatorname{cos}⁡u)⟩ \\\\  & =⟨0,\\,u\\operatorname{cos}⁡v,\\,\\operatorname{cos}⁡u⟩\\end{aligned}\n$$\n\nTherefore, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & \\operatorname{sin}⁡v & -v\\operatorname{sin}⁡u \\\\ 0 & u\\operatorname{cos}⁡v & \\operatorname{cos}⁡u\\end{aligned}| \\\\  & =⟨|\\begin{aligned}\\operatorname{sin}⁡v & -v\\operatorname{sin}⁡u \\\\ u\\operatorname{cos}⁡v & \\operatorname{cos}⁡u\\end{aligned}|,\\,-|\\begin{aligned}1 & -v\\operatorname{sin}⁡u \\\\ 0 & \\operatorname{cos}⁡u\\end{aligned}|,\\,|\\begin{aligned}1 & \\operatorname{sin}⁡v \\\\ 0 & u\\operatorname{cos}⁡v\\end{aligned}|⟩ \\\\  & =⟨\\operatorname{cos}⁡u\\operatorname{sin}⁡v+uv\\operatorname{sin}⁡u\\operatorname{cos}⁡v,\\,-\\operatorname{cos}⁡u,\\,u\\operatorname{cos}⁡v⟩.\\end{aligned}\n$$" 13194139535451 true] [17592186349869 1000 #edb/ref 17592186349870 13194139535451 true] [17592186349869 1000 #edb/ref 17592186349871 13194139535451 true] [17592186349869 1000 #edb/ref 17592186349872 13194139535451 true] [17592186349869 1000 #edb/ref 17592186349873 13194139535451 true] [17592186349869 1000 #edb/ref 17592186349874 13194139535451 true] [17592186349869 1040 #edb/ref 17592186045450 13194139535451 true] [17592186349869 1041 "selection" 13194139535451 true] [17592186349869 1104 #edb/ref 17592186349874 13194139535451 true] [17592186349869 1110 #uuid "fe50237d-9e81-5c7c-8d50-adad84ff5502" 13194139535451 true] [17592186349870 1034 "⟨\\operatorname{sin}⁡u\\operatorname{cos}⁡v-uv\\operatorname{cos}⁡u\\operatorname{sin}⁡v,\\,\\operatorname{cos}⁡u,\\,-u\\operatorname{cos}⁡u⟩" 13194139535451 true] [17592186349870 1103 #edb/ref 17592186045453 13194139535451 true] [17592186349870 1111 #uuid "05a2d210-0eae-5120-964c-548312c60db8" 13194139535451 true] [17592186349871 1034 "⟨uv\\operatorname{cos}⁡u\\operatorname{sin}⁡v,\\,-\\operatorname{cos}⁡v,\\,u\\operatorname{sin}⁡v⟩" 13194139535451 true] [17592186349871 1103 #edb/ref 17592186045453 13194139535451 true] [17592186349871 1111 #uuid "90605b8f-2c68-5b0a-b0f2-c2fc52b8b6b9" 13194139535451 true] [17592186349872 1034 "⟨\\operatorname{sin}⁡u\\operatorname{cos}⁡v,\\,-\\operatorname{cos}⁡v,\\,v\\operatorname{cos}⁡u⟩" 13194139535451 true] [17592186349872 1103 #edb/ref 17592186045453 13194139535451 true] [17592186349872 1111 #uuid "be51671e-f6c4-577a-b17e-abb7b65d435b" 13194139535451 true] [17592186349873 1034 "⟨uv\\operatorname{cos}⁡u\\operatorname{sin}⁡v,\\,-v\\operatorname{cos}⁡u,\\,u\\operatorname{cos}⁡v⟩" 13194139535451 true] [17592186349873 1103 #edb/ref 17592186045453 13194139535451 true] [17592186349873 1111 #uuid "70f3d8ae-d688-5813-be98-1433ef35d848" 13194139535451 true] [17592186349874 1034 "⟨\\operatorname{cos}⁡u\\operatorname{sin}⁡v+uv\\operatorname{sin}⁡u\\operatorname{cos}⁡v,\\,-\\operatorname{cos}⁡u,\\,u\\operatorname{cos}⁡v⟩" 13194139535451 true] [17592186349874 1103 #edb/ref 17592186045453 13194139535451 true] [17592186349874 1111 #uuid "8f968ba7-7e7b-5b64-a5f7-0325a6c60abb" 13194139535451 true] [17592186349875 1017 #edb/ref 17592186349876 13194139535451 true] [17592186349875 1089 "q-109943" 13194139535451 true] [17592186349875 1091 #edb/ref 17592186045465 13194139535451 true] [17592186349875 1100 "$$\n{∬}_{D}\\boxed{}\\,\\text{d}A,\\,D={(u,v)\\,:\\,0\\le u\\le 1,\\,0\\le v\\le 2}\n$$\n\nThe integral above gives the surface area of the parametric surface $r(u,v)=⟨u+v,\\,3-v,\\,1+4u+5v⟩$ for $0\\le u\\le 1$ and $0\\le v\\le 2.$ What is the missing expression?" 13194139535451 true] [17592186349875 1113 #uuid "8259cc12-8425-5d9e-923a-3106edaae5d3" 13194139535451 true] [17592186349875 1145 "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the surface area of $S$ is given by\n\n$$\n{∬}_{S}\\,\\text{d}S={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A.\n$$\n\nWe first compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′} & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(u+v),\\,\\frac{∂}{∂u}(3-v),\\,\\frac{∂}{∂u}(1+4u+5v)⟩ \\\\  & =⟨1,\\,0,\\,4⟩ \\\\ {r}_{v}^{′} & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(u+v),\\,\\frac{∂}{∂v}(3-v),\\,\\frac{∂}{∂v}(1+4u+5v)⟩ \\\\  & =⟨1,\\,-1,\\,5⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{u}^{′}\\times {r}_{v}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & 4 \\\\ 1 & -1 & 5\\end{aligned}| \\\\  & =⟨|\\begin{aligned}0 & 4 \\\\ -1 & 5\\end{aligned}|,\\,-|\\begin{aligned}1 & 4 \\\\ 1 & 5\\end{aligned}|,\\,|\\begin{aligned}1 & 0 \\\\ 1 & -1\\end{aligned}|⟩ \\\\  & =⟨4,\\,-1,\\,-1⟩,\\end{aligned}\n$$\n\nand \n\n$$\n\\begin{aligned}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖ & =‖⟨4,\\,-1,\\,-1⟩‖ \\\\  & =\\sqrt{(4)^{2}+(-1)^{2}+(-1)^{2}} \\\\  & =\\sqrt{16+1+1} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}{∬}_{S}\\,\\text{d}S & ={∬}_{D}‖{r}_{u}^{′}\\times {r}_{v}^{′}‖\\text{d}A \\\\  & ={∬}_{D}3\\sqrt{2}\\,\\text{d}A\\end{aligned}\n$$" 13194139535451 true] [17592186349876 1000 #edb/ref 17592186349877 13194139535451 true] [17592186349876 1000 #edb/ref 17592186349878 13194139535451 true] [17592186349876 1000 #edb/ref 17592186349879 13194139535451 true] [17592186349876 1000 #edb/ref 17592186349880 13194139535451 true] [17592186349876 1000 #edb/ref 17592186349881 13194139535451 true] [17592186349876 1040 #edb/ref 17592186045450 13194139535451 true] [17592186349876 1041 "selection" 13194139535451 true] [17592186349876 1104 #edb/ref 17592186349881 13194139535451 true] [17592186349876 1110 #uuid "05b54108-a654-5d8c-8c13-657eeb0b8940" 13194139535451 true] [17592186349877 1034 "\\sqrt{10}" 13194139535451 true] [17592186349877 1103 #edb/ref 17592186045453 13194139535451 true] [17592186349877 1111 #uuid "15b3da73-1805-5927-8615-273fae3abd78" 13194139535451 true] [17592186349878 1034 "\\sqrt{3}" 13194139535451 true] [17592186349878 1103 #edb/ref 1759218