nswer.type/math} :answer/value "10" :db/id #edb/ref 17592186116586} {:answer/id #uuid "cc274ea7-401a-5676-80dc-6ee01923d282" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{70}" :db/id #edb/ref 17592186116587} {:answer/id #uuid "de6feef4-1ae0-5da7-befe-66de7c727461" :answer/type {:db/ident :answer.type/math} :answer/value "20" :db/id #edb/ref 17592186116588} {:answer/id #uuid "3ae5a2ba-c746-5cbc-aec9-fdb98e82e80b" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{35}" :db/id #edb/ref 17592186116589}] :answer-field/correct {:answer/id #uuid "cc274ea7-401a-5676-80dc-6ee01923d282" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{70}" :db/id #edb/ref 17592186116587} :answer-field/id #uuid "b1cd35e9-52eb-5e41-81af-424b36fb5ff2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186116584}] :question/id #uuid "04aeca54-3b07-58c4-888a-6b39f758095a" :question/math-academy-id "q-105920" :question/problem "Find the surface area of the parametric surface defined by the equations\n\n$x = 2u - v, y = 3u + 2, z = u + 2v$\n\nfor $0 \\le u \\le 1$ and $-1 \\le v \\le 1$."}] [{:db/id #edb/ref 17592186120004 :knowledge-point/_questions [{:knowledge-point/id #uuid "9361ad5a-b15c-507b-85d4-fe7ccb4d9fd8" :knowledge-point/title "Finding the Surface Area of a Parametric Surface"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c88f2bde-790d-554e-bd35-d3b4deb63df0" :answer/type {:db/ident :answer.type/math} :answer/value "2π\\sqrt{57}" :db/id #edb/ref 17592186116591} {:answer/id #uuid "f4955983-2a5f-5add-8f00-da932fb4065b" :answer/type {:db/ident :answer.type/math} :answer/value "π\\sqrt{19}" :db/id #edb/ref 17592186116592} {:answer/id #uuid "3d2dbc3f-2c7e-59c3-b009-dce3713555d8" :answer/type {:db/ident :answer.type/text} :answer/value "$π\\sqrt{38}$\n\n---\n\n<a id=\"intuition-behind-the-formula\"></a>" :db/id #edb/ref 17592186116593} {:answer/id #uuid "68342b01-1