order to find $Av$, we need to rotate $v$ **clockwise** by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/ab6a3ec35954243105f9bb6c9f1f2cc21c02358f90855f9f36f0a590092eb93d.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/state.json" "file_sha256" "f07b529fcc489010236892ec02a2f855802235483748b56921c87bff17bae15d" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/edb-import/verification.json"} {"question" "q-81831" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/activity-metadata.json" "file_sha256" "d5412300abaf3d9cfe40c7fe60724db3bf41b03e257c8e1c9aa4b8a19eb15cd3" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/edb-import/verification.json"} {"question" "q-81831" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/state.json" "file_sha256" "f07b529fcc489010236892ec02a2f855802235483748b56921c87bff17bae15d" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/edb-import/verification.json"} {"question" "q-81831" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/assets/4bf42e3bdeb61feccd68cf4eeb9e3c4a40e8b903a5739df77c993e9aa4abc993.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/state.json" "file_sha256" "f07b529fcc489010236892ec02a2f8