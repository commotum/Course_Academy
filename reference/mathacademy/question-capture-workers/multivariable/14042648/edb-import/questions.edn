#{[{:db/id #edb/ref 17592186124314 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/id #uuid "c351fdde-ce68-5fa1-97e1-7678211a3963" :question/math-academy-id "e-8216" :question/problem "Given the elliptic cone $\\dfrac{(x-2)^2}{4} + \\dfrac{(y-2)^2}{2} = \\dfrac{(z+1)^2}{3}$, find its intercepts with the $z$-axis." :question/worked-solution "To find the $z$-intercepts of the elliptic cone, we plug $x=0$ and $y=0$ into the equation and solve for $z$:\n\n$$\n\\begin{aligned}\n((0 - 2)^{2})/(4) + ((0 - 2)^{2})/(2) &= ((z + 1)^{2})/(3) \\\\\n\\frac{4}{4} + \\frac{4}{2} &= ((z + 1)^{2})/(3) \\\\\n1 + 2 &= ((z + 1)^{2})/(3) \\\\\n3 &= ((z + 1)^{2})/(3) \\\\\n9 &= (z + 1)^{2} \\\\\nz + 1 &= ± 3 \\\\\nz &= -1 ± 3 \\\\\nz &= -4, 2\n\\end{aligned}\n$$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-4)$ and $(0,0,2)$."}] [{:db/id #edb/ref 17592186124315 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/id #uuid "89ae8962-7ad4-5860-b070-8df4d92128ed" :question/math-academy-id "e-8217" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $3x^2 + 4y ^2=12(z+3)^2\\:$?" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\n3x^{2} + 4 \\cdot 0^{2} &= 12(z + 3)^{2} \\\\\n3x^{2} &= 12(z + 3)^{2} \\\\\nx^{2} &= 4(z + 3)^{2} \\\\\n± x &= 2(z + 3) \\\\\n± \\frac{x}{2} &= z + 3 \\\\\nz &= ± \\frac{x}{2} - 3\n\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations\n\n$$\nz = \\pm\\dfrac{x}{2}-3\n$$"}] [{:db/id #edb/ref 17592186124809 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a0f520-3025-58a4-a5ac-0589879482c1" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{\\sqrt{2}} + 2" :db/id #edb/ref 17592186121877} {:answer/id #uuid "a6e920b1-1ad8-50b2-8262-5f950e32e4b4" :answer/type {:db/ident :answer.type/math} :answer/value "z =-\\frac{y}{2} + 4" :db/id #edb/ref 17592186121878} {:answer/id #uuid "d70bd1b9-f0a0-565f-b11f-6f91170c0a24" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{2} + 4" :db/id #edb/ref 17592186121879} {:answer/id #uuid "4d197c74-e2e4-52a2-82d6-eff38906ca9f" :answer/type {:db/ident :answer.type/math} :answer/value "z = \\frac{y}{2} + 2" :db/id #edb/ref 17592186121880} {:answer/id #uuid "6536c120-fe20-5d9b-9f51-59844ba34099" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{2} + 2" :db/id #edb/ref 17592186121881}] :answer-field/correct {:answer/id #uuid "d70bd1b9-f0a0-565f-b11f-6f91170c0a24" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{2} + 4" :db/id #edb/ref 17592186121879} :answer-field/id #uuid "f0d9c6fe-ba77-50f1-a99c-ff16002a13b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121876}] :question/id #uuid "8fafc510-161c-5c1c-82ac-429f0c08613a" :question/math-academy-id "q-35596" :question/problem "What is the trace in the $yz$-plane of the elliptic cone $\\frac{x^{2}}{8} + \\frac{y^{2}}{4} = (z - 4)^{2}$?"}] [{:db/id #edb/ref 17592186125154 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a02df854-fc59-5fba-8a52-144b94384b56" :answer/type {:db/ident :answer.type/text} :answer/value "$(-4, 0, 0)$ and $(4, 0, 0)$" :db/id #edb/ref 17592186123947} {:answer/id #uuid "ce466903-815f-5873-994e-128882147f2f" :answ