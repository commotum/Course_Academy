#{[{:db/id #edb/ref 17592186124314 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/id #uuid "c351fdde-ce68-5fa1-97e1-7678211a3963" :question/math-academy-id "e-8216" :question/problem "Given the elliptic cone $\\dfrac{(x-2)^2}{4} + \\dfrac{(y-2)^2}{2} = \\dfrac{(z+1)^2}{3},$ find its intercepts with the $z$-axis." :question/worked-solution "To find the $z$-intercepts of the elliptic cone, we plug $x=0$ and $y=0$ into the equation and solve for $z\\mathbin{:}$\n\n$$\n\\begin{aligned}\\frac{(0-2)^{2}}{4}+\\frac{(0-2)^{2}}{2} & =\\frac{(z+1)^{2}}{3} \\\\ \\frac{4}{4}+\\frac{4}{2} & =\\frac{(z+1)^{2}}{3} \\\\ 1+2 & =\\frac{(z+1)^{2}}{3} \\\\ 3 & =\\frac{(z+1)^{2}}{3} \\\\ 9 & =(z+1)^{2} \\\\ z+1 & =\\pm 3 \\\\ z & =-1\\pm 3 \\\\ z & =-4,2\\end{aligned}\n$$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-4)$ and $(0,0,2).$"}] [{:db/id #edb/ref 17592186124315 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/id #uuid "89ae8962-7ad4-5860-b070-8df4d92128ed" :question/math-academy-id "e-8217" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $3x^2 +  4y ^2=12(z+3)^2\\: ?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}+4\\cdot {0}^{2} & =12(z+3)^{2} \\\\ 3{x}^{2} & =12(z+3)^{2} \\\\ {x}^{2} & =4(z+3)^{2} \\\\ \\pm x & =2(z+3) \\\\ \\pm \\frac{x}{2} & =z+3 \\\\ z & =\\pm \\frac{x}{2}-3\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z = \\pm\\dfrac{x}{2}-3.$"}] [{:db/id #edb/ref 17592186316760 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1dde02e1-716e-52ec-aff6-2776c21d7fa7" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,2,0)$" :db/id #edb/ref 17592186316762} {:answer/id #uuid "8231b6c6-cfa5-5a9f-84b4-4fe2c7413ced" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-2,0)$ only" :db/id #edb/ref 17592186316763} {:answer/id #uuid "b246ed0d-76b5-5d1b-b38f-3a23929cd24b" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,-2,0)$" :db/id #edb/ref 17592186316764} {:answer/id #uuid "0125cce2-e928-5bca-85fb-b39ef96df5a7" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,7,0)$" :db/id #edb/ref 17592186316765} {:answer/id #uuid "eb2cb3c5-4613-57cb-a342-dfcc82ef64e6" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-8,0)$ only" :db/id #edb/ref 17592186316766}] :answer-field/correct {:answer/id #uuid "b246ed0d-76b5-5d1b-b38f-3a23929cd24b" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-8,0)$ and $(0,-2,0)$" :db/id #edb/ref 17592186316764} :answer-field/id #uuid "22a66afc-c3e6-5b03-b787-381fe0c34aba" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316761}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "476b5ba6-7557-5084-9691-646b1cb8f507" :question/math-academy-id "q-176833" :question/problem "Given the elliptic cone $\\frac{(x+8)^{2}}{16}+\\frac{(y+5)^{2}}{3}=\\frac{(z-7)^{2}}{7},$ find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the elliptic cone, we plug $x=0$ and $z=0$ into the equation and solve for $y:$\n\n$$\n\\begin{aligned}\\frac{(0+8)^{2}}{16}+\\frac{(y+5)^{2}}{3} & =\\frac{(0-7)^{2}}{7} \\\\ \\frac{64}{16}+\\frac{(y+5)^{2}}{3} & =\\frac{49}{7} \\\\ 4+\\frac{(y+5)^{2}}{6} & =7 \\\\ \\frac{(y+5)^{2}}{3} & =3 \\\\ (y+5)^{2} & =9 \\\\ y+5 & =\\pm 3 \\\\ y & =-5\\pm 3 \\\\ y & =-8,-2\\end{aligned}\n$$\n\nTherefore, the intercepts with the $y$-axis are $(0,-8,0)$ and $(0,-2,0).$"}] [{:db/id #edb/ref 17592186316767 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "348cabea-f511-560f-8379-34e3aa4c7756" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\sqrt{2},\\sqrt{2})" :db/id #edb/ref 17592186316769} {:answer/id #uuid "634288e4-9e2f-50e8-b81a-1ec3d26996e0" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1,\\frac{\\sqrt{3}}{2})" :db/id #edb/ref 17592186316770} {:answer/id #uuid "c6d7f5aa-1429-545d-bab7-1ae2d320c367" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0,0)" :db/id #edb/ref 17592186316771} {:answer/id #uuid "3ab5c47f-90d5-5059-ae58-15ac8d2bb229" :answer/type {:db/ident :answer.type/math} :answer/value "(\\sqrt{2}+1,1,1)" :db/id #edb/ref 17592186316772} {:answer/id #uuid "ef3fe25a-f1e9-5539-82b2-6340149ddab1" :answer/type {:db/ident :answer.type/math} :answer/value "(5,0,2)" :db/id #edb/ref 17592186316773}] :answer-field/correct {:answer/id #uuid "c6d7f5aa-1429-545d-bab7-1ae2d320c367" :answer/type {:db/ident :answer.type/math} :answer/value "(1,0,0)" :db/id #edb/ref 17592186316771} :answer-field/id #uuid "77f7d43d-2160-5d79-b283-3fe99241f725" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316768}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8cf1e2a7-da38-57ea-b1de-04392dc7110c" :question/math-academy-id "q-35266" :question/problem "Given that the trace of the elliptic cone $\\frac{(x-1)^{2}}{4}+\\frac{{y}^{2}}{2}={z}^{2}$ and the $xz$-plane are two lines, what is the intersection point of these lines?" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\\frac{(x-1)^{2}}{4}+\\frac{(0)^{2}}{2} & ={z}^{2} \\\\ \\frac{(x-1)^{2}}{4} & ={z}^{2} \\\\ \\pm \\frac{x-1}{2} & =z\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z=\\frac{x-1}{2}$ and $z=\\frac{1-x}{2}.$ \n\nTo find the point of intersection of both lines, we equate the right-hand sides. This gives\n\n$$\n\\begin{aligned}\\frac{x-1}{2} & =\\frac{1-x}{2} \\\\ x-1 & =1-x \\\\ 2x & =2 \\\\ x & =1.\\end{aligned}\n$$\n\nSubstituting $x=1$ in the equation of the first line and solving for $z,$ we obtain $z=\\frac{1-1}{2}=0.$\n\nTherefore, the point of intersection is $(1,0,0).$"}] [{:db/id #edb/ref 17592186124809 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "93a0f520-3025-58a4-a5ac-0589879482c1" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{\\sqrt{2}} + 2" :db/id #edb/ref 17592186121877} {:answer/id #uuid "a6e920b1-1ad8-50b2-8262-5f950e32e4b4" :answer/type {:db/ident :answer.type/math} :answer/value "z =-\\frac{y}{2} + 4" :db/id #edb/ref 17592186121878} {:answer/id #uuid "d70bd1b9-f0a0-565f-b11f-6f91170c0a24" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{2} + 4" :db/id #edb/ref 17592186121879} {:answer/id #uuid "4d197c74-e2e4-52a2-82d6-eff38906ca9f" :answer/type {:db/ident :answer.type/math} :answer/value "z = \\frac{y}{2} + 2" :db/id #edb/ref 17592186121880} {:answer/id #uuid "6536c120-fe20-5d9b-9f51-59844ba34099" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{2} + 2" :db/id #edb/ref 17592186121881}] :answer-field/correct {:answer/id #uuid "d70bd1b9-f0a0-565f-b11f-6f91170c0a24" :answer/type {:db/ident :answer.type/math} :answer/value "z = ± \\frac{y}{2} + 4" :db/id #edb/ref 17592186121879} :answer-field/id #uuid "f0d9c6fe-ba77-50f1-a99c-ff16002a13b2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121876}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8fafc510-161c-5c1c-82ac-429f0c08613a" :question/math-academy-id "q-35596" :question/problem "What is the trace in the $yz$-plane of the elliptic cone $\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{4}=(z-4)^{2}\\,?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{8}+\\frac{{y}^{2}}{4} & =(z-4)^{2} \\\\ \\frac{{y}^{2}}{2} & =(z-4)^{2} \\\\ \\pm \\frac{y}{2} & =z-4 \\\\ z & =\\pm \\frac{y}{2}+4\\end{aligned}\n$$\n\nThis gives us two lines in the $yz$-plane with equations $z=\\pm \\frac{y}{2}+4.$"}] [{:db/id #edb/ref 17592186125154 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a02df854-fc59-5fba-8a52-144b94384b56" :answer/type {:db/ident :answer.type/text} :answer/value "$(-4, 0, 0)$ and $(4, 0, 0)$" :db/id #edb/ref 17592186123947} {:answer/id #uuid "ce466903-815f-5873-994e-128882147f2f" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ and $(6, 0, 0)$" :db/id #edb/ref 17592186123948} {:answer/id #uuid "fd91ae19-b3aa-5385-9f2e-dfe8fb30ef88" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ only" :db/id #edb/ref 17592186123949} {:answer/id #uuid "00a1c3eb-d50c-5296-87bf-096e51d97a52" :answer/type {:db/ident :answer.type/text} :answer/value "$(2, 0, 0)$ and $(4, 0, 0)$" :db/id #edb/ref 17592186123950} {:answer/id #uuid "582d341e-1df5-53ba-8c62-c08c6ca82f11" :answer/type {:db/ident :answer.type/text} :answer/value "$(4, 0, 0)$ only" :db/id #edb/ref 17592186123951}] :answer-field/correct {:answer/id #uuid "ce466903-815f-5873-994e-128882147f2f" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ and $(6, 0, 0)$" :db/id #edb/ref 17592186123948} :answer-field/id #uuid "3f841aee-e933-5deb-b8ec-8ddd8cafedf4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123946}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f0cabaaa-77b2-5df5-b276-82aad1e2675a" :question/math-academy-id "q-94081" :question/problem "Given the elliptic cone $\\frac{(x-2)^{2}}{2}+\\frac{(y+2)^{2}}{4}=(z+3)^{2},$ find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the elliptic cone, we plug $y=0$ and $z=0$ into the equation and solve for $x:$\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}+\\frac{(0+2)^{2}}{4} & =(0+3)^{2} \\\\ \\frac{(x-2)^{2}}{2}+\\frac{4}{4} & =9 \\\\ \\frac{(x-2)^{2}}{2}+1 & =9 \\\\ \\frac{(x-2)^{2}}{2} & =8 \\\\ (x-2)^{2} & =16 \\\\ x-2 & =\\pm 4 \\\\ x & =2\\pm 4 \\\\ x & =-2,6\\end{aligned}\n$$\n\nTherefore, the intercepts with the $x$-axis are $(-2,0,0)$ and $(6,0,0).$"}] [{:db/id #edb/ref 17592186125155 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c7b327ce-712a-507e-9d33-52e144b2670c" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 0, 0)" :db/id #edb/ref 17592186123953} {:answer/id #uuid "e5972853-7e6f-5ead-bd7d-2eb30377a9b3" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1, 0)" :db/id #edb/ref 17592186123954} {:answer/id #uuid "2971d5e9-0bd5-544f-a5d0-aa6060f26401" :answer/type {:db/ident :answer.type/math} :answer/value "(-2, 1, 0)" :db/id #edb/ref 17592186123955} {:answer/id #uuid "442bdda3-d6ac-567f-921e-7dc2435b622b" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1, 0)" :db/id #edb/ref 17592186123956} {:answer/id #uuid "4df3f673-6916-5829-b19d-217f7b67f8fd" :answer/type {:db/ident :answer.type/math} :answer/value "(2, 1, 0)" :db/id #edb/ref 17592186123957}] :answer-field/correct {:answer/id #uuid "2971d5e9-0bd5-544f-a5d0-aa6060f26401" :answer/type {:db/ident :answer.type/math} :answer/value "(-2, 1, 0)" :db/id #edb/ref 17592186123955} :answer-field/id #uuid "011bb2eb-1c74-50b9-ae8f-4315a02879c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186123952}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6dbbc8b0-b994-5e7b-854a-3bf51bb1a258" :question/math-academy-id "q-94082" :question/problem "Find the center of the elliptic cone $2(x+2)^{2}+3(y-1)^{2}={z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}2(x+2)^{2}+3(y-1)^{2} & =(z-0)^{2} \\\\ \\frac{(x+2)^{2}}{1/2}+\\frac{(y-1)^{2}}{1/3} & =(z-0)^{2} \\\\ \\frac{(x-(-2))^{2}}{1/2}+\\frac{(y-1)^{2}}{1/3} & =(z-0)^{2}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(-2,1,0).$"}] [{:db/id #edb/ref 17592186316774 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2bcab5e5-4bc7-5832-80ce-3868ed6012c6" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{3}" :db/id #edb/ref 17592186316776} {:answer/id #uuid "e66722e2-4447-58b6-b28a-6513edf71490" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\frac{y}{3}" :db/id #edb/ref 17592186316777} {:answer/id #uuid "9354c474-e593-5dc5-88a5-b62bae7ac79c" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{9}" :db/id #edb/ref 17592186316778} {:answer/id #uuid "b58d23c4-5e30-5306-8529-4cdd4556b110" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{9}+1" :db/id #edb/ref 17592186316779} {:answer/id #uuid "3a252632-dc8a-5ba2-95ab-6e022446003c" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\frac{y}{3}\\pm 1" :db/id #edb/ref 17592186316780}] :answer-field/correct {:answer/id #uuid "2bcab5e5-4bc7-5832-80ce-3868ed6012c6" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm \\frac{y}{3}" :db/id #edb/ref 17592186316776} :answer-field/id #uuid "c5fa9f76-fa14-5642-b2f2-2a3609a1b5c5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316775}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f1ca6c81-c90d-53e2-91fd-a40e8a96a96b" :question/math-academy-id "q-94486" :question/problem "What is the trace in the $yz$-plane of the elliptic cone $\\frac{3{x}^{2}}{4}+\\frac{{y}^{2}}{9}={z}^{2}\\,?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{4}+\\frac{{y}^{2}}{9} & ={z}^{2} \\\\ \\frac{{y}^{2}}{9} & ={z}^{2} \\\\ z & =\\pm \\frac{y}{3}\\end{aligned}\n$$\n\nThis gives us two lines in the $yz$-plane with equations $z=\\pm \\frac{y}{3}.$"}] [{:db/id #edb/ref 17592186316781 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3bbb7abe-2515-5225-9c40-7157c703dc7f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{x}{3}+2" :db/id #edb/ref 17592186316783} {:answer/id #uuid "1439a00c-5fd7-5ff4-9c05-375ae54375db" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 3x-5" :db/id #edb/ref 17592186316784} {:answer/id #uuid "d26f7178-7b4e-5b40-8a2c-cc56c1d45308" :answer/type {:db/ident :answer.type/math} :answer/value "(9,2,0)" :db/id #edb/ref 17592186316785} {:answer/id #uuid "61a18a56-0239-5d46-8788-0a8784686fb8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2x}{3}+18" :db/id #edb/ref 17592186316786} {:answer/id #uuid "d969eee5-49d4-52a4-be96-91ac7e08a1b3" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0,0)" :db/id #edb/ref 17592186316787}] :answer-field/correct {:answer/id #uuid "d969eee5-49d4-52a4-be96-91ac7e08a1b3" :answer/type {:db/ident :answer.type/math} :answer/value "(2,0,0)" :db/id #edb/ref 17592186316787} :answer-field/id #uuid "02c90aa7-a97d-5728-ab71-1585eaef3c3c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316782}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6734b6c1-1fe4-5e74-9521-784543a97764" :question/math-academy-id "q-94496" :question/problem "What is the trace in the $xy$-plane of the elliptic cone $9(x-2)^{2}+2{y}^{2}=18{z}^{2}\\,?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}9(x-2)^{2}+2{y}^{2}=18(0)^{2} \\\\ 9(x-2)^{2}+2{y}^{2}=0\\end{aligned}\n$$\n\nThis gives in the $xy$-plane the point $(2,0,0).$"}] [{:db/id #edb/ref 17592186316788 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5126299-745f-523f-bdd1-47c5d8a8602c" :answer/type {:db/ident :answer.type/math} :answer/value "(3,7,1)" :db/id #edb/ref 17592186316790} {:answer/id #uuid "f40b0875-c4e9-5c16-be1d-714a22fd5efc" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186316791} {:answer/id #uuid "1b11e0dc-71d9-52b9-8411-70368204ad26" :answer/type {:db/ident :answer.type/math} :answer/value "(7,3,21)" :db/id #edb/ref 17592186316792} {:answer/id #uuid "51cc2545-a80f-5f6a-871e-8d96e17107be" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0,1)" :db/id #edb/ref 17592186316793} {:answer/id #uuid "278f55ed-3618-5b17-8d5d-04c2004a54e9" :answer/type {:db/ident :answer.type/math} :answer/value "(-7,-3,-21)" :db/id #edb/ref 17592186316794}] :answer-field/correct {:answer/id #uuid "f40b0875-c4e9-5c16-be1d-714a22fd5efc" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0,0)" :db/id #edb/ref 17592186316791} :answer-field/id #uuid "4bee53b8-fbfb-54f8-84e2-98f951401745" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316789}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b3ea4837-32ba-5546-9a0a-236b390a5978" :question/math-academy-id "q-94602" :question/problem "Find the center of the elliptic cone $7{x}^{2}+3{y}^{2}=21{z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}7(x-0)^{2}+3(y-0)^{2} & =21(z-0)^{2} \\\\ \\frac{(x-0)^{2}}{1/7}+\\frac{(y-0)^{2}}{1/3} & =\\frac{(z-0)^{2}}{1/21}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(0,0,0).$"}] [{:db/id #edb/ref 17592186316795 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5aaa03a3-b6df-5703-9a5c-25aabe31d37c" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,4,0)$" :db/id #edb/ref 17592186316797} {:answer/id #uuid "36c58996-a72f-5721-89f0-9ee7a56e5440" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1.5,0)$ and $(0,4,0)$" :db/id #edb/ref 17592186316798} {:answer/id #uuid "f5b4bae7-eccb-5f5e-8cc3-fbd7f2ec53c6" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,2,0)$ only" :db/id #edb/ref 17592186316799} {:answer/id #uuid "15ef40c7-5f0b-546e-b664-3a99e6e8bbd6" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1.5,0)$ only" :db/id #edb/ref 17592186316800} {:answer/id #uuid "f79f5dde-c4d1-5102-8735-fceb7c96e88a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186316801}] :answer-field/correct {:answer/id #uuid "f79f5dde-c4d1-5102-8735-fceb7c96e88a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186316801} :answer-field/id #uuid "4e90a7eb-3ef4-5e98-95d4-9c571fd3c2f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316796}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "61c83505-bb91-59ab-a450-ae05b1d9fb7c" :question/math-academy-id "q-94603" :question/problem "Given the elliptic cone $\\frac{{x}^{2}}{8}+\\frac{{y}^{2}}{4}=\\frac{{z}^{2}}{2},$ find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the elliptic cone, we plug $x=0$ and $z=0$ into the equation and solve for $y:$\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{8}+\\frac{{y}^{2}}{4} & =\\frac{{0}^{2}}{2} \\\\ 0+\\frac{{y}^{2}}{4} & =0 \\\\ \\frac{{y}^{2}}{4} & =0 \\\\ {y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the intercept with the $y$-axis is $(0,0,0)$ only."}] [{:db/id #edb/ref 17592186316802 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0411e661-3f7a-5479-b0ad-14a233702b24" :answer/type {:db/ident :answer.type/math} :answer/value "z=4x+1" :db/id #edb/ref 17592186316804} {:answer/id #uuid "2bed8085-5d30-5066-8048-b64efc5400ff" :answer/type {:db/ident :answer.type/math} :answer/value "z=-\\frac{1}{4}x-1" :db/id #edb/ref 17592186316805} {:answer/id #uuid "b791444e-da5c-5336-a644-4dc58497467a" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm \\frac{1}{4}(x+1)" :db/id #edb/ref 17592186316806} {:answer/id #uuid "c4c0303f-4f81-575e-ae8d-8f50352a6661" :answer/type {:db/ident :answer.type/math} :answer/value "z=-4x+4" :db/id #edb/ref 17592186316807} {:answer/id #uuid "3e0facec-10c0-56c1-99df-92f1b8a262b2" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm 4(x-1)" :db/id #edb/ref 17592186316808}] :answer-field/correct {:answer/id #uuid "3e0facec-10c0-56c1-99df-92f1b8a262b2" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm 4(x-1)" :db/id #edb/ref 17592186316808} :answer-field/id #uuid "b1fdddbe-c0c6-5329-b5e8-57c784708b60" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186316803}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3b5c5f76-89be-5d6d-8365-ed748f50ee8c" :question/math-academy-id "q-95462" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $(x-1)^{2}+7{y}^{2}=\\frac{1}{16}{z}^{2}\\,?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+7(0)^{2} & =\\frac{1}{16}{z}^{2} \\\\ (x-1)^{2} & =\\frac{1}{16}{z}^{2} \\\\ \\frac{1}{4}z & =\\pm (x-1) \\\\ z & =\\pm 4(x-1)\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z=\\pm 4(x-1).$"}]}
