II only" :db/id #edb/ref 17592186168498}] :answer-field/correct {:answer/id #uuid "0303117a-7361-5307-91c0-5bb718658463" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186168496} :answer-field/id #uuid "00e5a510-8833-50f0-a6d1-d8482e153aae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168493}] :question/id #uuid "7b23ed53-bb63-5272-af53-a6429d08e4c0" :question/math-academy-id "q-122643" :question/problem "Which of the following are vector fields on $R^{2}$?\n\n1. $\\mathbf{P} ( x , y ) = \\frac{1}{{x}^{2}} \\, \\mathbf{i} + ( x + y {)}^{2} \\, \\mathbf{j}$\n2. $\\mathbf{Q} ( x , y , z ) = y \\, \\mathbf{i} - x y \\, \\mathbf{j} + ( z + 1 ) \\, \\mathbf{k}$\n3. $\\mathbf{R} ( t ) = ( t + 1 ) \\, \\mathbf{i} - ( 3 t - 1 ) \\, \\mathbf{j}$"}] [{:db/id #edb/ref 17592186172217 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb34fdb0-198e-507d-a944-9be782b4cfeb" :knowledge-point/title "Identifying Vector Fields on Three-Dimensions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f8cb00e6-41f6-5d29-8631-0293daa68897" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186168506} {:answer/id #uuid "02eff869-eda8-5803-a634-1271df860d13" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186168507} {:answer/id #uuid "6bb09b36-0e19-5b43-adcb-12e66dab0ff4" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186168508} {:answer/id #uuid "6ede929f-0a0b-50b2-8b21-c6ee73309b9b" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186168509} {:answer/id #uuid "713f30c1-2cd9-55d9-a51a-76066e723182" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186168510}] :answer-field/correct {:answer/id #uuid "f8cb00e6-41f6-5d29-8631-0293daa68897" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186168506} :answer-field/id #uuid "9e3eb357-e60c-59d6-9cd4-24c2d7144b9f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168505}] :question/id #uuid "4052d0d0-adca-5eb3-9bef-49295b1e5651" :question/math-academy-id "q-122697" :question/problem "Which of the following are vector fields on $R^{3}$?\n\n1. $\\mathbf{U} ( x , y , z ) = \\langle  x + 2 , \\sqrt{x - y} , \\ln   z \\rangle$\n2. $\\mathbf{V} ( x , y ) = \\langle  x {e}^{y} , 1 - y \\rangle$\n3. $\\mathbf{W} ( t ) = \\langle  {t}^{2} , 2 t , 2 - 3 t \\rangle$"}]}
