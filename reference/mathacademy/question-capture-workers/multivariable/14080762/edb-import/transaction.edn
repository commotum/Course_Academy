={x}_{i-1}^{2}+2{y}_{j-1}^{2}+{y}_{j-1}\n$$\n\nand the lower Riemann sum is given by\n\n$$\nL(f,P)={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({x}_{i-1}^{2}+2{y}_{j-1}^{2}+{y}_{j-1})Δ{x}_{i}Δ{y}_{j}.\n$$\n\nSo, the missing expression is ${x}_{i-1}^{2}+2{y}_{j-1}^{2}+{y}_{j-1}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123742/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "89023510-57f4-52f9-90ed-eae07f48f707"] :knowledge-point/questions ["q-123742"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123737/selection/940f6e5a4d5504b847afa12ff0791a1919091b5bd659405d2f86940f3640ef38" :answer/id #uuid "a47031fa-61d9-5f7b-813b-ada6deb0590e" :answer/type :answer.type/text :answer/value "None of the options is correct" :db/ensure [:answer/validate]} {:db/id "q-123737/selection/724b8999fd429367001123c1cb0f7ed6391591e5822ddea181aa68b69e36585a" :answer/id #uuid "c9791c8b-7381-57ac-acff-8778cd3eb8fa" :answer/type :answer.type/math :answer/value "3{x}_{i-1}^{2}+{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id "q-123737/selection/b5c38c809b1fae68e713709767bc36ea51bf679de4405f83aa9ad507f3db1ec8" :answer/id #uuid "921dd73b-252a-55f7-82de-1ba662abbcd6" :answer/type :answer.type/math :answer/value "3{x}_{i}^{2}+{y}_{j}^{2}" :db/ensure [:answer/validate]} {:db/id "q-123737/selection/307d70ea882ff9ca8c1102c1fdb813cf838af7a1ad472a64a84d2d9e1dc58159" :answer/id #uuid "34daec8f-11eb-5899-af23-7c8346363889" :answer/type :answer.type/math :answer/value "3{x}_{i-1}^{2}+{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "q-123737/selection/e5bfbcf6612cc64cd0a909663cf420eaf40b7ac55da022b46f7a5234838a6a91" :answer/id #uuid "4c697b73-d863-5d47-bf08-c090da5e8c23" :answer/type :answer.type/math :answer/value "3{x}_{i}^{2}+{y}_{j-1}^{2}" :db/ensure [:answer/validate]} {:db/id "q-123737/selection" :answer-field/id #uuid "2e65237b-99cb-59cb-8f53-f1cf6730519b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :