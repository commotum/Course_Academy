#{[{:db/id #edb/ref 17592186287498 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Secant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "29ee8153-af01-53fa-afe5-b4270151bafa" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{arcsec}(5x)+C" :db/id #edb/ref 17592186287500} {:answer/id #uuid "76658b0f-bdb1-5178-a04c-e74d20b5614b" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186287501} {:answer/id #uuid "5d032742-72a0-5631-a227-587bdd5dffd9" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(5x)+C" :db/id #edb/ref 17592186287502} {:answer/id #uuid "75156ac2-1acc-5fc2-81d1-afc274fa4cc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}\\,\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186287503} {:answer/id #uuid "556bc950-a93a-5a12-a14d-a56c0183c7a6" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186287504}] :answer-field/correct {:answer/id #uuid "76658b0f-bdb1-5178-a04c-e74d20b5614b" :answer/type {:db/ident :answer.type/math} :answer/value "\\text{arcsec}(\\sqrt{5}x)+C" :db/id #edb/ref 17592186287501} :answer-field/id #uuid "2390826e-c3f6-5f7e-975a-d4d0aba4a2f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287499}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "604712d6-42d9-5fa2-83bd-a9f37f01b70e" :question/math-academy-id "q-114051" :question/problem "Calculate $\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x.$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{5{x}^{2}-1}}=\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{5}x.$\n\nSo, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{5}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\sqrt{5}\\cdot \\frac{1}{\\sqrt{5}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186287533 :knowledge-point/_questions [{:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "efbd9355-7eca-50ac-9063-b06770bdc7cc" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(25x)}{25}+C" :db/id #edb/ref 17592186287535} {:answer/id #uuid "64a7ab19-7abb-57f6-a957-9d9a7cf2d6a3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(x)}{25}+C" :db/id #edb/ref 17592186287536} {:answer/id #uuid "97242a87-2ce3-57fd-928b-28648b62cbc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186287537} {:answer/id #uuid "28602c5a-0558-5bfb-adfa-a6e38012cfab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C" :db/id #edb/ref 17592186287538} {:answer/id #uuid "aea0486f-7ecf-5b4b-aaf0-d75ab5ee51ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\text{arcsec}(25x)}{25}+C" :db/id #edb/ref 17592186287539}] :answer-field/correct {:answer/id #uuid "97242a87-2ce3-57fd-928b-28648b62cbc1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C" :db/id #edb/ref 17592186287537} :answer-field/id #uuid "b5033eb5-575b-5736-bdc0-22f90f2d0c84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287534}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b276c35b-2077-5eef-8db9-05ae17fa54c3" :question/math-academy-id "q-2507" :question/problem "$\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x=$" :question/worked-solution "This integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $25{x}^{2}=(5x)^{2}.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=5\\,⟹\\,\\frac{1}{5}\\,\\text{d}u=\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{1+{u}^{2}}\\,\\cdot (\\frac{1}{5}\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{\\operatorname{arctan}⁡(5x)}{5}+C\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064792 :knowledge-point/_questions [{:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287" :knowledge-point/title "Calculating Indefinite Integrals Using Substitution with Inverse Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c69be993-3132-5696-9b79-e5b3d281cbd3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\arctan (\\frac{x}{9}) + C" :db/id #edb/ref 17592186063263} {:answer/id #uuid "cfcaa2b3-e4ea-55b2-b6dc-e88a4ed4c2f6" :answer/type {:db/ident :answer.type/math} :answer/value "\\arctan (\\frac{x}{9}) + C" :db/id #edb/ref 17592186063264} {:answer/id #uuid "fd0d0bff-f768-510e-b5c4-691f98a3f859" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}\\arctan (\\frac{x}{9}) + C" :db/id #edb/ref 17592186063265} {:answer/id #uuid "1d5d6d23-685a-5bcc-9d0a-4b5e34a7b9c3" :answer/type {:db/ident :answer.type/math} :answer/value "\\arctan (\\frac{x}{3}) + C" :db/id #edb/ref 17592186063266} {:answer/id #uuid "3859c10f-d795-5c84-b6f5-969568b4922a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\arctan (\\frac{x}{3}) + C" :db/id #edb/ref 17592186063267}] :answer-field/correct {:answer/id #uuid "3859c10f-d795-5c84-b6f5-969568b4922a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}\\arctan (\\frac{x}{3}) + C" :db/id #edb/ref 17592186063267} :answer-field/id #uuid "ff188bde-6bcb-5810-aef6-1e39a9361870" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063262}] :question/id #uuid "ea76ea1f-1600-5c9d-b198-b9fb197580ab" :question/math-academy-id "q-49548" :question/problem "What is $∫\\frac{1}{9 + x^{2}}dx$?"}]}
