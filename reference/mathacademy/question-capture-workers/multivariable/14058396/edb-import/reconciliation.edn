e2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-2507" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\operatorname{arctan}⁡(x)}{25}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-2507" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{\\text{arcsec}(25x)}{25}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-114051" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-114051" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{5{x}^{2}-1}}=\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{5}x.$\n\nSo, let's substitute $u=\\sqrt{5}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{5}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{5}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{5{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{5}}{|\\sqrt{5}x|\\sqrt{(\\sqrt{5}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{5}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{5}}\\text{d}u) \\\\  & =\\sqrt{5}\\cdot \\frac{1}{\\sqrt{5}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{5}x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-114051" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/activity-metadata.json" "file_sha256" "c05a08d8162628e21f5cd0f4a253bb7a2733fb49041e999778716cebcb87e247" "basis" 1111 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/edb-import/verification.json"} {"question" "q-114051" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005939/state.json" "file_sha256" "1b766436967935033c945ef278fc467eb3cee6d379be2244fc5b6bacb12054cd" "basis" 1111 "verification" "/home/j