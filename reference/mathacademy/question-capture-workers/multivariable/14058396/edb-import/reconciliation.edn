2da1bef1b3fe012a2be9b719466b8d5cbd343bba9"} {"question" "q-2507" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058396/activity-metadata.json" "file_sha256" "0f93b9a3f902ac849992de95124c7f0a813db318b9252d08098d838c9ff9b71e"} {"question" "q-2507" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058396/state.json" "file_sha256" "007cc25a06b3c4fa173bf522da1bef1b3fe012a2be9b719466b8d5cbd343bba9"} {"question" "q-2507" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\operatorname{arcsin}⁡(5x)}{5}+C"] ["math" "\\frac{\\operatorname{arctan}⁡(25x)}{25}+C"] ["math" "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C"] ["math" "\\frac{\\operatorname{arctan}⁡(x)}{25}+C"] ["math" "\\frac{\\text{arcsec}(25x)}{25}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058396/state.json" "file_sha256" "007cc25a06b3c4fa173bf522da1bef1b3fe012a2be9b719466b8d5cbd343bba9"} {"question" "q-2507" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\operatorname{arctan}⁡(5x)}{5}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058396/state.json" "file_sha256" "007cc25a06b3c4fa173bf522da1bef1b3fe012a2be9b719466b8d5cbd343bba9"} {"question" "q-49548" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{1}{9+{x}^{2}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058396/state.json" "file_sha256" "007cc25a06b3c4fa173bf522da1bef1b3fe012a2be9b719466b8d5cbd343bba9"} {"question" "q-49548" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{9+{x}^{2}}\\,\\text{d}x & =\\int \\frac{1}{9\\cdot (1+{x}^{2}/9)}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{x}^{2}/9}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+(x/3)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{3})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{3}\\,⟹\\,\\text{d}x=3\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{9+{x}^{2}}\\,\\text{d}x & =\\frac{1}{9}\\int \\frac{1}{1+(x/3)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{9}\\int \\frac{1}{1+{u}^{2}}\\cdot (3\\,\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{3}\\operatorname{arctan}⁡(\\frac{x}{3})+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058396/state.json" "file_sha256" "007cc25a06b3c4fa173bf522da1bef1b3fe012a2be9b719466b8d5cbd343bba9"} {"question" "q-49548" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058396/activity-metadata.json" "file_sha256" "0f93b9a3f902ac849992de95124c7f0a813db318b9252d08098d838c9ff9b71e"} {"question" "q-49548" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "ca