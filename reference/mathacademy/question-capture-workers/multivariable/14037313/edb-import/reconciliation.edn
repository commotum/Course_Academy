af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114288" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 4x{e}^{8x}\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=4x\\, & ⟹\\,{u}^{′}=4 \\\\ {v}^{′}={e}^{8x}\\, & ⟹\\,v=\\frac{1}{8}{e}^{8x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot {e}^{8x}\\,\\text{d}x & =4x\\cdot \\frac{1}{8}{e}^{8x}-\\int \\frac{1}{8}{e}^{8x}\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 4x{e}^{8x}\\,\\text{d}x & =\\frac{1}{2}x{e}^{8x}-\\frac{1}{2}\\int {e}^{8x}\\,\\text{d}x \\\\  & =\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114288" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-114288" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114288" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{3x{e}^{8x}}{8}+\\frac{{e}^{8x}}{12}+C"] ["math" "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C"] ["math" "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{4}+C"] ["math" "\\frac{x{e}^{8x}}{4}+\\frac{5{e}^{8x}}{16}+C"] ["math" "\\frac{x{e}^{8x}}{8}-\\frac{{e}^{8x}}{16}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114288" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x{e}^{8x}}{2}-\\frac{{e}^{8x}}{16}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114309" "field" nil "attribute" "question/problem" "value" "$\\int (x+4)\\operatorname{sin}⁡(2x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114309" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (x+4)\\operatorname{sin}⁡(2x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x+4\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(2x)\\, & ⟹\\,v=-\\frac{\\operatorname{cos}⁡(2x)}{2}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (x+4)\\cdot \\operatorname{sin}⁡(2x)\\,\\text{d}x & =(x+4)\\cdot (-\\frac{\\operatorname{cos}⁡(2x)}{2})-\\int (-\\frac{\\operatorname{cos}⁡(2x)}{2})\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int (x+4)\\operatorname{sin}⁡(2x)\\text{d}x & =-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{1}{2}\\int \\operatorname{cos}⁡(2x)\\,\\text{d}x \\\\  & =-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114309" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-114309" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114309" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+C"] ["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{4}+\\frac{\\operatorname{sin}⁡(2x)}{8}+C"] ["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{4}-\\frac{\\operatorname{sin}⁡(2x)}{2}+C"] ["math" "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{6}-\\frac{\\operatorname{sin}⁡(2x)}{2}+C"] ["math" "-\\frac{3(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{6}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114309" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{(x+4)\\operatorname{cos}⁡(2x)}{2}+\\frac{\\operatorname{sin}⁡(2x)}{4}+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14449" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 5x\\operatorname{sin}⁡(x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14449" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 5x\\operatorname{sin}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=5x\\, & ⟹\\,{u}^{′}=5 \\\\ {v}^{′}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 5x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =5x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 5\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 5x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-5x\\operatorname{cos}⁡(x)+5\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-5x\\operatorname{cos}⁡(x)+5\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14449" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-14449" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14449" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-5x\\operatorname{cos}⁡x+5\\operatorname{sin}⁡x+C"] ["math" "-5x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+C"] ["math" "-x\\operatorname{cos}⁡x-\\operatorname{cos}⁡5x+C"] ["math" "5x\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+C"] ["math" "\\operatorname{cos}⁡5x+x\\operatorname{sin}⁡5x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14449" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-5x\\operatorname{cos}⁡x+5\\operatorname{sin}⁡x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-74088" "field" nil "attribute" "question/problem" "value" "$\\int (6x+1)\\operatorname{cos}⁡(x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-74088" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int (6x+1)\\operatorname{cos}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=6x+1\\, & ⟹\\,{u}^{′}=6 \\\\ {v}^{′}=\\operatorname{cos}⁡(x)\\, & ⟹\\,v=\\operatorname{sin}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (6x+1)\\cdot \\operatorname{cos}⁡(x)\\,\\text{d}x & =(6x+1)\\cdot \\operatorname{sin}⁡(x)-\\int \\operatorname{sin}⁡(x)\\cdot 6\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows\n\n$$\n\\begin{aligned}\\int (6x+1)\\operatorname{cos}⁡(x)\\text{d}x & =(6x+1)\\operatorname{sin}⁡(x)-6\\int \\operatorname{sin}⁡(x)\\,\\text{d}x \\\\  & =(6x+1)\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-74088" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-74088" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-74088" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(6x+1)\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C"] ["math" "(6x+1)\\operatorname{sin}⁡(x)+\\frac{\\operatorname{cos}⁡(x)}{6}+C"] ["math" "6\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C"] ["math" "\\frac{(6x+1)\\operatorname{sin}⁡(x)}{6}+\\operatorname{cos}⁡(x)+C"] ["math" "\\operatorname{sin}⁡(x)+\\operatorname{cos}⁡(x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-74088" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(6x+1)\\operatorname{sin}⁡(x)+6\\operatorname{cos}⁡(x)+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114299" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 2x\\operatorname{cos}⁡4x\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114299" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 2x\\operatorname{cos}⁡4x\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=2x\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{cos}⁡4x\\, & ⟹\\,v=\\frac{1}{4}\\operatorname{sin}⁡4x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\operatorname{cos}⁡4x\\,\\text{d}x & =2x\\cdot \\frac{1}{4}\\operatorname{sin}⁡4x-\\int \\frac{1}{4}\\operatorname{sin}⁡4x\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 2x\\operatorname{cos}⁡4x\\,\\text{d}x & =\\frac{1}{2}x\\operatorname{sin}⁡4x-\\frac{1}{2}\\int \\operatorname{sin}⁡4x\\,\\text{d}x \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡4x-\\frac{1}{2}(-\\frac{1}{4}\\operatorname{cos}⁡4x)+C \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡4x+\\frac{1}{8}\\operatorname{cos}⁡4x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114299" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-114299" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114299" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{\\operatorname{sin}⁡4x}{4}+\\frac{x\\operatorname{cos}⁡4x}{6}+C"] ["math" "-\\frac{\\operatorname{sin}⁡4x}{8}+\\frac{x\\operatorname{cos}⁡4x}{2}+C"] ["math" "\\frac{3x\\operatorname{sin}⁡4x}{2}+\\frac{\\operatorname{cos}⁡4x}{4}+C"] ["math" "\\frac{x\\operatorname{sin}⁡4x}{2}+\\frac{\\operatorname{cos}⁡4x}{8}+C"] ["math" "\\frac{x\\operatorname{sin}⁡4x}{4}-\\frac{\\operatorname{cos}⁡4x}{2}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114299" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{x\\operatorname{sin}⁡4x}{2}+\\frac{\\operatorname{cos}⁡4x}{8}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14437" "field" nil "attribute" "question/problem" "value" "Calculate $\\int 2x\\operatorname{sin}⁡(x)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14437" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int u{v}^{′}\\,\\text{d}x=uv-\\int v{u}^{′}\\,\\text{d}x.\n$$\n\nWe need to express $\\int 2x\\operatorname{sin}⁡(x)\\text{d}x$ as $\\int u{v}^{′}\\,\\text{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=2x\\, & ⟹\\,{u}^{′}=2 \\\\ {v}^{′}=\\operatorname{sin}⁡(x)\\, & ⟹\\,v=-\\operatorname{cos}⁡(x).\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot \\operatorname{sin}⁡(x)\\,\\text{d}x & =2x\\cdot (-\\operatorname{cos}⁡(x))-\\int (-\\operatorname{cos}⁡(x))\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int 2x\\operatorname{sin}⁡(x)\\,\\text{d}x & =-2x\\operatorname{cos}⁡(x)+2\\int \\operatorname{cos}⁡(x)\\,\\text{d}x \\\\  & =-2x\\operatorname{cos}⁡(x)+2\\operatorname{sin}⁡(x)+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14437" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-14437" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14437" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2x\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x+C"] ["math" "-2x\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+C"] ["math" "-x\\operatorname{cos}⁡x-\\operatorname{cos}⁡2x+C"] ["math" "2x\\operatorname{cos}⁡x-x\\operatorname{sin}⁡x+C"] ["math" "\\operatorname{cos}⁡2x+x\\operatorname{sin}⁡2x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-14437" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2x\\operatorname{cos}⁡x+2\\operatorname{sin}⁡x+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349305" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}(-18x)\\operatorname{cos}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349305" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=-18x & ⇒ & {u}^{′}=-18 \\\\ {v}^{′}=\\operatorname{cos}⁡(3x) & ⇒ & v=\\frac{1}{3}\\operatorname{sin}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int (-18x)\\cdot \\operatorname{cos}⁡(3x)\\,\\text{d}x & =(-18x)\\cdot \\frac{1}{3}\\operatorname{sin}⁡(3x)-\\int \\frac{1}{3}\\operatorname{sin}⁡(3x)\\cdot (-18)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}(-18x)\\operatorname{cos}⁡(3x)\\,\\text{d}x & =-6x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}+6{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(3x)\\,\\text{d}x \\\\  & =-6x\\operatorname{sin}⁡(3x)\\,{|}_{0}^{\\pi /3}-2\\operatorname{cos}⁡(3x)\\,{|}_{0}^{\\pi /3} \\\\  & =-6(\\frac{\\pi }{3}\\cdot \\operatorname{sin}⁡(\\pi )-0\\cdot \\operatorname{sin}⁡(0))-2(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡(0)) \\\\  & =-6(\\frac{\\pi }{3}\\cdot 0-0\\cdot 0)-2(-1-1) \\\\  & =4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349305" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-349305" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349305" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-346870" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-346870" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=2x & ⇒ & {u}^{′}=2 \\\\ {v}^{′}={e}^{x} & ⇒ & v={e}^{x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 2x\\cdot {e}^{x}\\,\\text{d}x & =2x\\cdot {e}^{x}-\\int {e}^{x}\\cdot 2\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2x{e}^{x}\\,\\text{d}x & =2x{e}^{x}\\,{|}_{0}^{1}-2{\\int }_{0}^{1}{e}^{x}\\,\\text{d}x \\\\  & =2x{e}^{x}\\,{|}_{0}^{1}-2{e}^{x}\\,{|}_{0}^{1} \\\\  & =2(1\\cdot {e}^{1}-0\\cdot {e}^{0})-2({e}^{1}-{e}^{0}) \\\\  & =2e-2(e-1) \\\\  & =2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-346870" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-346870" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-346870" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349231" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349231" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{sin}⁡(\\pi x) & ⇒ & v=-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =4x\\cdot (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))-\\int (-\\frac{1}{\\pi }\\operatorname{cos}⁡(\\pi x))\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}4x\\operatorname{sin}⁡(\\pi x)\\,\\text{d}x & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{\\pi }{\\int }_{0}^{1}\\operatorname{cos}⁡(\\pi x)\\,\\text{d}x \\\\  & =-\\frac{4}{\\pi }x\\operatorname{cos}⁡(\\pi x)\\,{|}_{0}^{1}+\\frac{4}{{\\pi }^{2}}\\operatorname{sin}⁡(\\pi x)\\,{|}_{0}^{1} \\\\  & =-\\frac{4}{\\pi }(1\\cdot \\operatorname{cos}⁡(\\pi \\cdot 1)-0\\cdot \\operatorname{cos}⁡(\\pi \\cdot 0))+\\frac{4}{{\\pi }^{2}}(\\operatorname{sin}⁡(\\pi \\cdot 1)-\\operatorname{sin}⁡(\\pi \\cdot 0)) \\\\  & =-\\frac{4}{\\pi }(-1-0)+\\frac{4}{{\\pi }^{2}}(0-0) \\\\  & =\\frac{4}{\\pi }.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349231" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-349231" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349231" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4}{\\pi}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349253" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{2\\pi }4x\\operatorname{sin}⁡(3x)\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349253" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=4x & ⇒ & {u}^{′}=4 \\\\ {v}^{′}=\\operatorname{sin}⁡(3x) & ⇒ & v=-\\frac{1}{3}\\operatorname{cos}⁡(3x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 4x\\cdot \\operatorname{sin}⁡(3x)\\,\\text{d}x & =4x\\cdot (-\\frac{1}{3}\\operatorname{cos}⁡(3x))-\\int (-\\frac{1}{3}\\operatorname{cos}⁡(3x))\\cdot 4\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2\\pi }4x\\operatorname{sin}⁡(3x)\\,\\text{d}x & =-\\frac{4}{3}x\\operatorname{cos}⁡(3x)\\,{|}_{0}^{2\\pi }+\\frac{4}{3}{\\int }_{0}^{2\\pi }\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =-\\frac{4}{3}x\\operatorname{cos}⁡(3x)\\,{|}_{0}^{2\\pi }+\\frac{4}{9}\\operatorname{sin}⁡(3x)\\,{|}_{0}^{2\\pi } \\\\  & =-\\frac{4}{3}(2\\pi \\cdot \\operatorname{cos}⁡(6\\pi )-0\\cdot \\operatorname{cos}⁡(0))+\\frac{4}{9}(\\operatorname{sin}⁡(6\\pi )-\\operatorname{sin}⁡(0)) \\\\  & =-\\frac{4}{3}(2\\pi \\cdot 1-0\\cdot 1)+\\frac{4}{9}(0-0) \\\\  & =-\\frac{8\\pi }{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349253" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-349253" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-349253" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{8\\pi}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114322" "field" nil "attribute" "question/problem" "value" "${\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(4x)\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114322" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(4x) & ⟹\\,v=-\\frac{1}{4}\\operatorname{cos}⁡(4x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sin}⁡(4x)\\,\\text{d}x & =x\\cdot (-\\frac{1}{4}\\operatorname{cos}⁡(4x))-\\int (-\\frac{1}{4}\\operatorname{cos}⁡(4x))\\cdot 1\\,\\text{d}x \\\\  & =-\\frac{x\\operatorname{cos}⁡(4x)}{4}+\\frac{1}{4}\\int \\operatorname{cos}⁡(4x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }x\\operatorname{sin}⁡(4x)\\,\\text{d}x & ={-\\frac{x\\operatorname{cos}⁡(4x)}{4}|}_{0}^{\\pi }+\\frac{1}{4}{\\int }_{0}^{\\pi }\\operatorname{cos}⁡(4x)\\,\\text{d}x \\\\  & ={-\\frac{x\\operatorname{cos}⁡(4x)}{4}|}_{0}^{\\pi }+{\\frac{1}{16}\\operatorname{sin}⁡(4x)|}_{0}^{\\pi } \\\\  & =[-\\frac{\\pi \\operatorname{cos}⁡(4\\pi )}{4}+\\frac{0\\operatorname{cos}⁡(4\\cdot 0)}{4}] \\\\  & +\\frac{1}{16}[\\operatorname{sin}⁡(4\\pi )-\\operatorname{sin}⁡(4\\cdot 0)] \\\\  & =(-\\frac{\\pi }{4}+0)+\\frac{1}{16}(0-0) \\\\  & =-\\frac{\\pi }{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114322" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/activity-metadata.json" "file_sha256" "1a77b5d0d3582ab92a8158644acff6d27ec0cbf8ee8f7abf77b21d7ef73cdffb"} {"question" "q-114322" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114322" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{5\\pi }{4}"] ["math" "-\\frac{\\pi }{2}"] ["math" "-\\frac{\\pi }{4}"] ["math" "\\frac{3\\pi }{4}"] ["math" "\\frac{\\pi }{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "q-114322" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{\\pi }{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/state.json" "file_sha256" "6ee97563daa16ea5c1378e058847b8af9ab780c1bde093e08acd54f2a021ab4b"} {"question" "e-491" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\int xe^{7x} \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-491.json" "file_sha256" "7c46823a076f27418f687c1c57f0be26c1c0d58db148bd07e8215baee597f933"} {"question" "e-491" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int uv' \\, \\textrm{d}x= uv - \\int vu' \\, \\textrm{d}x.\n$$\n\nWe need to express $\\displaystyle  \\int xe^{7x} \\textrm{d}x$ as $\\displaystyle  \\int uv'\\,\\textrm{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}={e}^{7x}\\, & ⟹\\,v=\\frac{1}{7}{e}^{7x}.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get the following:\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot {e}^{7x}\\,\\text{d}x & =x\\cdot \\frac{1}{7}{e}^{7x}-\\int \\frac{1}{7}{e}^{7x}\\cdot 1\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we calculate the integral:\n\n$$\n\\begin{aligned}\\int x{e}^{7x}\\,\\text{d}x & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{7}\\int {e}^{7x}\\,\\text{d}x \\\\  & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{7}(\\frac{{e}^{7x}}{7})+C \\\\  & =\\frac{1}{7}x{e}^{7x}-\\frac{1}{49}{e}^{7x}+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-491.json" "file_sha256" "7c46823a076f27418f687c1c57f0be26c1c0d58db148bd07e8215baee597f933"} {"question" "e-492" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle\\int x \\cos{2x}\\,\\textrm d x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-492.json" "file_sha256" "6ea45868b53e6a7ef46cd6a099a1f9edf4ee7fd285ddd7f1dc86b89a549281ab"} {"question" "e-492" "field" nil "attribute" "question/worked-solution" "value" "To solve this integral, we use the by-parts formula, given by\n\n$$\n\\int uv'\\,\\textrm{d}x= uv- \\int vu'\\,\\textrm{d}x.\n$$\n\nWe need to express $\\displaystyle \\int x \\cos{2x} \\textrm{d}x$ as $\\displaystyle \\int uv'\\,\\textrm{d}x.$ Therefore, we set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{cos}⁡2x\\, & ⟹\\,v=\\frac{1}{2}\\operatorname{sin}⁡2x.\\end{aligned}\n$$\n\nWe substitute the above into the integration by parts formula, and we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\operatorname{cos}⁡2x\\,\\text{d}x & =x\\cdot \\frac{1}{2}\\operatorname{sin}⁡2x-\\int \\frac{1}{2}\\operatorname{sin}⁡2x\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we calculate the integral, as follows:\n\n$$\n\\begin{aligned}\\int x\\operatorname{cos}⁡2x\\,\\text{d}x & =\\frac{1}{2}x\\operatorname{sin}⁡2x-\\frac{1}{2}\\int \\operatorname{sin}⁡2x\\,\\text{d}x \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡2x-\\frac{1}{2}(-\\frac{1}{2}\\operatorname{cos}⁡2x)+C \\\\  & =\\frac{1}{2}x\\operatorname{sin}⁡2x+\\frac{1}{4}\\operatorname{cos}⁡2x+C\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-492.json" "file_sha256" "6ea45868b53e6a7ef46cd6a099a1f9edf4ee7fd285ddd7f1dc86b89a549281ab"} {"question" "e-6209" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int_0^{\\pi/5} x\\sin(5x) \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-6209.json" "file_sha256" "873e4784b82e098e69e17d1c87e19a6fff599f58729fd44e363879ddeff1d870"} {"question" "e-6209" "field" nil "attribute" "question/worked-solution" "value" "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=x\\, & ⟹\\,{u}^{′}=1 \\\\ {v}^{′}=\\operatorname{sin}⁡(5x) & ⟹\\,v=-\\frac{1}{5}\\operatorname{cos}⁡(5x).\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int x\\cdot \\operatorname{sin}⁡(5x)\\,\\text{d}x & =-x\\cdot \\frac{1}{5}\\operatorname{cos}⁡(5x)-\\int (-\\frac{1}{5}\\operatorname{cos}⁡(5x))\\cdot 1\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /5}x\\operatorname{sin}⁡(5x)\\,\\text{d}x & =-{\\frac{1}{5}x\\operatorname{cos}⁡(5x)|}_{0}^{\\pi /5}+\\frac{1}{5}{\\int }_{0}^{\\pi /5}\\operatorname{cos}⁡(5x)\\,\\text{d}x \\\\  & =-{\\frac{1}{5}x\\operatorname{cos}⁡(5x)|}_{0}^{\\pi /5}+{\\frac{1}{5}(\\frac{\\operatorname{sin}⁡(5x)}{5})|}_{0}^{\\pi /5} \\\\  & =[-\\frac{1}{5}\\cdot \\frac{\\pi }{5}\\operatorname{cos}⁡(\\pi )+\\frac{1}{5}\\cdot 0\\cdot \\operatorname{cos}⁡(0)]+[\\frac{1}{25}\\operatorname{sin}⁡(\\pi )-\\frac{1}{25}\\operatorname{sin}⁡(0)] \\\\  & =[-\\frac{\\pi }{25}\\cdot (-1)+0]+[0-0] \\\\  & =\\frac{\\pi }{25}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037313/example-6209.json" "file_sha256" "873e4784b82e098e69e17d1c87e19a6fff599f58729fd44e363879ddeff1d870"}] "usage" {"q-14434" [] "e-491" [] "e-6209" [] "q-114293" [] "q-74088" [] "e-492" [] "q-349231" [] "q-14437" [] "q-114288" []} "basis" 1263 "retractions" [[17592186064423 :question/problem "What is $\\displaystyle \\int6xe^{4x}dx$?"] [17592186064423 :question/worked-solution "Use integration by parts with $u=6x$ and $dv=e^{4x}\\,dx$. Then $du=6\\,dx$ and $v=e^{4x}/4$, so\n$$\\int6xe^{4x}\\,dx=\\frac32xe^{4x}-\\frac32\\int e^{4x}\\,dx\n=\\frac32xe^{4x}-\\frac38e^{4x}+C.$$"] [17592186064423 :question/difficulty 17592186045465] [17592186064424 :question/problem "Calculate $\\displaystyle \\int2x\\sin (x)dx$."] [17592186064424 :question/worked-solution "Let $u=2x$ and $dv=\\sin x\\,dx$, so $du=2\\,dx$ and $v=-\\cos x$. Then\n$$\\int2x\\sin x\\,dx=-2x\\cos x+2\\int\\cos x\\,dx\n=-2x\\cos x+2\\sin x+C.$$"] [17592186064424 :question/difficulty 17592186045465]] "immutable_answers" [17592186061223 17592186061224 1759218606122