[{:db/id [:question/math-academy-id "q-122463"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067637/assets/e3614ea1954f36435eb1ab5f52c04d4fa3062ac337eccf76a5b47e4a03a64a1b.png)\n\nWhich of the following could be the function that generates the vector field above?" :question/worked-solution "We notice the following:\n\n- The horizontal component (i.e., the $i$ component) is negative for each vector in our vector field. Therefore, we can rule out the following options:\n\n$$\nF(x,y)=i-2\\,j,\\,H(x,y)=i\n$$\n\n- The vertical component (i.e., the $j$ component) is positive for each vector in our vector field. Therefore, we can rule out the following option:\n\n$$\nK(x,y)=-j\n$$\n\nTherefore, we conclude that the diagram corresponds to the vector field $G(x,y)=-i+j.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-122633/selection/421ba3cf61c86c7d854403490925f53920cd3c015c12342698571d9a74aca2fd" :answer/id #uuid "f36579c1-a15a-5c9c-86e5-d88683ef116b" :answer/type :answer.type/text :answer/value "None of the listed" :db/ensure [:answer/validate]} {:db/id "q-122633/selection/1ff35d9042b7faaa78485405010fbc99e8a90b4df5de485cc0f011f400bfbca9" :answer/id #uuid "4a704b3c-ce02-53aa-9160-1f264dbf6080" :answer/type :answer.type/math :answer/value "F(x,y)=x\\,i" :db/ensure [:answer/validate]} {:db/id "q-122633/selection/1ae9ee21f4e7d209d9e0dd347563c2029d90cf3e0d3359b9b717b206be87163a" :answer/id #uuid "b9fb5b94-5e4d-5e8d-badc-f06e1748045e" :answer/type :answer.type/math :answer/value "K(x,y)=-i" :db/ensure [:answer/validate]} {:db/id "q-122633/selection/1c863dd5994ea3d9d078cce8f02b0cd74bd26467cd482dce19cae64f86fca4f1" :answer/id #uuid "6cb9413f-2322-5c1a-b080-8bbee476c873" :answer/type :answer.type/math :answer/value "H(x,y)=y\\,i+j" :db/ensure [:answer/validate]} {:db/id "q-122633/selection/c3509ab7685717bb623a74405ca7543a99c9ed5e43160b50d261e8a4a563559a" :answe