b77c3470a7b5d68567dab"} {"question" "q-102688" "field" nil "attribute" "question/worked-solution" "value" "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}y\\operatorname{cos}⁡(xy) & x\\operatorname{cos}⁡(xy)\\end{aligned}],$\nwe must have\n\n$$\n\\frac{∂f}{∂x}=y\\operatorname{cos}⁡(xy),\\,\\frac{∂f}{∂y}=x\\operatorname{cos}⁡(xy).\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(y\\operatorname{cos}⁡(xy))=-{y}^{2}\\operatorname{sin}⁡(xy)\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡(xy))=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(xy))=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡(xy))=-{x}^{2}\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}-{y}^{2}\\operatorname{sin}⁡(xy) & \\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\ \\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) & -{x}^{2}\\operatorname{sin}⁡(xy)\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(\\pi ,-1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(\\pi ,-1)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(\\pi ,-1)=0\\cdot 0-(-1)\\cdot (-1)=-1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-102688" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/activity-metadata.json" "file_sha256" "c7bb03c9a97a80a934eeb050314d775f797fa80674863257aabfac0318d9c116"} {"question" "q-102688" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-102688" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-{\\pi }^{2}"] ["math" "1"] ["math" "1-2{\\pi }^{2}"] ["math" "{\\pi }^{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-102688" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163641" "field" nil "attribute" "question/problem" "value" "Given that \n${f}^{′}(x,y)=[\\begin{aligned}3{x}^{2}+6x-4y & 4{y}^{3}-4x+8y\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(1,0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163641" "field" nil "attribute" "question/worked-solution" "value" "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}3{x}^{2}+6x-4y & 4{y}^{3}-4x+8y\\end{aligned}],$\nwe must have\n\n$$\n\\frac{∂f}{∂x}=3{x}^{2}+6x-4y,\\,\\frac{∂f}{∂y}=4{y}^{3}-4x+8y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(3{x}^{2}+6x-4y)=6x+6\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(4{y}^{3}-4x+8y)=-4 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(3{x}^{2}+6x-4y)=-4\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(4{y}^{3}-4x+8y)=12{y}^{2}+8\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}6x+6 & -4 \\\\ -4 & 12{y}^{2}+8\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(1,0),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,0)=[\\begin{aligned}12 & -4 \\\\ -4 & 8\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(1,0)=12\\cdot 8-(-4)\\cdot (-4)=80.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163641" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/activity-metadata.json" "file_sha256" "c7bb03c9a97a80a934eeb050314d775f797fa80674863257aabfac0318d9c116"} {"question" "q-163641" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163641" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "64"] ["math" "72"] ["math" "80"] ["math" "81"] ["math" "96"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163641" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "80"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163643" "field" nil "attribute" "question/problem" "value" "Given that \n${f}^{′}(x,y)=[\\begin{aligned}y\\operatorname{sin}⁡(y-x) & \\operatorname{cos}⁡(x-y)+y\\operatorname{sin}⁡(x-y)\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(\\pi ,\\pi ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163643" "field" nil "attribute" "question/worked-solution" "value" "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}y\\operatorname{sin}⁡(y-x) & \\operatorname{cos}⁡(x-y)+y\\operatorname{sin}⁡(x-y)\\end{aligned}],$\nwe must have\n\n$$\n\\frac{∂f}{∂x}=y\\operatorname{sin}⁡(y-x),\\,\\frac{∂f}{∂y}=\\operatorname{cos}⁡(x-y)+y\\operatorname{sin}⁡(x-y).\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(y\\operatorname{sin}⁡(y-x))=-y\\operatorname{cos}⁡(x-y)\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\operatorname{cos}⁡(x-y)+y\\operatorname{sin}⁡(x-y))=\\operatorname{sin}⁡(y-x)+y\\operatorname{cos}⁡(x-y) \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(y\\operatorname{sin}⁡(y-x))=\\operatorname{sin}⁡(y-x)+y\\operatorname{cos}⁡(x-y)\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\operatorname{cos}⁡(x-y)+y\\operatorname{sin}⁡(x-y))=2\\operatorname{sin}⁡(x-y)-y\\operatorname{cos}⁡(x-y)\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}-y\\operatorname{cos}⁡(x-y) & \\operatorname{sin}⁡(y-x)+y\\operatorname{cos}⁡(x-y) \\\\ \\operatorname{sin}⁡(y-x)+y\\operatorname{cos}⁡(x-y) & 2\\operatorname{sin}⁡(x-y)-y\\operatorname{cos}⁡(x-y)\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(\\pi ,\\pi ),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(\\pi ,\\pi )=[\\begin{aligned}-\\pi  & \\pi  \\\\ \\pi  & -\\pi \\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(\\pi ,\\pi )=(-\\pi )\\cdot (-\\pi )-\\pi \\cdot \\pi =0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163643" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/activity-metadata.json" "file_sha256" "c7bb03c9a97a80a934eeb050314d775f797fa80674863257aabfac0318d9c116"} {"question" "q-163643" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163643" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2\\pi "] ["math" "-\\pi "] ["math" "0"] ["math" "2\\pi "] ["math" "\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163643" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81023" "field" nil "attribute" "question/problem" "value" "Given that \n${f}^{′}(x,y)=[\\begin{aligned}2(x-1){y}^{2} & 2(x-1)^{2}y\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(0,1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81023" "field" nil "attribute" "question/worked-solution" "value" "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=[\\begin{aligned}2(x-1){y}^{2} & 2(x-1)^{2}y\\end{aligned}],$ we must have\n\n$$\n\\frac{∂f}{∂x}=2(x-1){y}^{2},\\,\\frac{∂f}{∂y}=2(x-1)^{2}y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2(x-1){y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2(x-1)^{2}y)=4(x-1)y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2(x-1){y}^{2})=4(x-1)y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2(x-1)^{2}y)=2(x-1)^{2}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}2{y}^{2} & 4(x-1)y \\\\ 4(x-1)y & 2(x-1)^{2}\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(0,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,1)=[\\begin{aligned}2 & -4 \\\\ -4 & 2\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(0,1)=2\\cdot 2-(-4)\\cdot (-4)=-12.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81023" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/activity-metadata.json" "file_sha256" "c7bb03c9a97a80a934eeb050314d775f797fa80674863257aabfac0318d9c116"} {"question" "q-81023" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81023" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-12"] ["math" "-6"] ["math" "-8"] ["math" "10"] ["math" "14"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81023" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-12"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "e-12522" "field" nil "attribute" "question/problem" "value" "Find $\\boldsymbol f''(\\pi,0)$ for the function $f(x,y)$ given that\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/08502aa81729d4f88aec094e2e2f5c7b4a57825ef3767f1eec29700ceb6e21a3.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/example-12522.json" "file_sha256" "d71ba56ea9462f2b5084f2eca49a6d8e24d3b19cbf1e54d6a1ea57223572a97e"} {"question" "e-12522" "field" nil "attribute" "question/worked-solution" "value" "For a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/025dd1a0b89b52e32a3e42e5bd3492261ed060f104f627051b6950c7f94d66c1.png)\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/f1a47569220f01e1dc474a13a5040e969449ee0b10cfe7df39c3aec4c6175f41.png)\n\nIn our case, we have\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/f0b46d26ccc6fefc404b021bde11c4d6959c00ae0ef1145a9984da602bcc54ef.png)\n\nFirst, notice that since ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/964f8ac9ca9c305faef8562f66d063f318ecbe402df337377bd9efdf61301567.png) \n we must have\n\n$$\n\\dfrac{\\partial f}{\\partial x} = e^y\\cos x ,  \n\\qquad \n\\dfrac{\\partial f}{\\partial y} =e^y\\sin x .\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}({e}^{y}\\operatorname{cos}⁡x)=-{e}^{y}\\operatorname{sin}⁡x\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({e}^{y}\\operatorname{sin}⁡x)={e}^{y}\\operatorname{cos}⁡x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}({e}^{y}\\operatorname{cos}⁡x)={e}^{y}\\operatorname{cos}⁡x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({e}^{y}\\operatorname{sin}⁡x)={e}^{y}\\operatorname{sin}⁡x\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}-{e}^{y}\\operatorname{sin}⁡x & {e}^{y}\\operatorname{cos}⁡x \\\\ {e}^{y}\\operatorname{cos}⁡x & {e}^{y}\\operatorname{sin}⁡x\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(\\pi,0).$ This gives\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/540c920abd2989b29aae275eedd179c5118e82354915e591c0d1c5296ca9fa21.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/example-12522.json" "file_sha256" "d71ba56ea9462f2b5084f2eca49a6d8e24d3b19cbf1e54d6a1ea57223572a97e"} {"question" "e-12524" "field" nil "attribute" "question/problem" "value" "Find $\\boldsymbol f''(1,0)$ for the function $f(x,y)  = x^2 e^y.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/example-12524.json" "file_sha256" "ae492501bb0d7f4cc3f2e8dec756ec26e51a918be49b840ac4656a928a96344f"} {"question" "e-12524" "field" nil "attribute" "question/worked-solution" "value" "For a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/7444a8128c085d7bf4f56a57a60c260864a50da0b744b6dbe22a2ced89a0588d.png)\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/22dd960829ea268e5aade685b56949f8998f87ae8c040a90f04436cbfc6b9a58.png)\n\nIn our case, we have\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/4fede2bb5c2306f62b55b7996488baee52c69e7d41b011e0e9d2b7405e63a8f4.png)\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({x}^{2}{e}^{y}) & \\frac{∂}{∂y}({x}^{2}{e}^{y})\\end{aligned}] \\\\  & =[\\begin{aligned}2x{e}^{y} & {x}^{2}{e}^{y}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x\\text{ }\\,{e}^{y})=2\\text{ }\\,{e}^{y}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({x}^{2}{e}^{y})=2x\\text{ }\\,{e}^{y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x\\text{ }\\,{e}^{y})=2x\\text{ }\\,{e}^{y}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({x}^{2}{e}^{y})={x}^{2}{e}^{y}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}2\\text{ }\\,{e}^{y} & 2x\\text{ }\\,{e}^{y} \\\\ 2x\\text{ }\\,{e}^{y} & {x}^{2}{e}^{y}\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $\\left(1,0\\right).$ This gives\n\n$$\n\\begin{aligned}{f}^{″}(1,0)=[\\begin{aligned}2 & 2 \\\\ 2 & 1\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/example-12524.json" "file_sha256" "ae492501bb0d7f4cc3f2e8dec756ec26e51a918be49b840ac4656a928a96344f"} {"question" "e-12523" "field" nil "attribute" "question/problem" "value" "Given that \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/b3e96b1a54af842b69da4ae5fcb44858bffdac48b27cde6677c15c05906e890d.png) \n evaluate the Hessian determinant of $f(x,y)$ at the point $(0,1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/example-12523.json" "file_sha256" "a1abc2931d9af1dd98a895c378118eda2375dd25f04cba4ac168034395c9eef6"} {"question" "e-12523" "field" nil "attribute" "question/worked-solution" "value" "For a function $f: \\mathbb R^n \\to \\mathbb R,$ given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/af5524049f5f8b3c4c4241520f2d874b454d61b1b025362f5193437f766e610b.png)\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/8882516e2732e419efdfb8439265212dd4f380d6a6ea58f6ff1291030bf50bfb.png)\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(\\mathbf x) = \\det \\left( \\boldsymbol{f}''(\\mathbf x) \\right)\n$$\n\nIn our case, we have\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/4fede2bb5c2306f62b55b7996488baee52c69e7d41b011e0e9d2b7405e63a8f4.png)\n\nFirst, notice that since ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/assets/9252d1ce4f5df828f45351d01e0709cf2f2ca5df2c9c25390c111f40ca00fb22.png) we must have\n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\ln y, \n\\qquad \n\\dfrac{\\partial f}{\\partial y} = \\dfrac xy.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\operatorname{ln}⁡y)=0\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(\\frac{x}{y})=\\frac{1}{y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(\\operatorname{ln}⁡y)=\\frac{1}{y}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(\\frac{x}{y})=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}0 & \\frac{1}{y} \\\\ \\frac{1}{y} & -\\frac{x}{{y}^{2}}\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(0,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(0,1)=[\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(0,1) = 0 \\cdot 0 - 1\\cdot 1 = -1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/example-12523.json" "file_sha256" "a1abc2931d9af1dd98a895c378118eda2375dd25f04cba4ac168034395c9eef6"}] "usage" {"e-12523" [] "e-12524" [] "q-80939" [] "e-12522" [] "q-102477" []} "basis" 2446 "retractions" [[17592186157471 :question/problem "Find $f^{″}(1, 2)$ for the function $f(x, y)$ given that\n\n$f^{′}(x, y) = \\begin{bmatrix}y - 2xy & x - x^{2}\\end{bmatrix}$"] [17592186157729 :question/problem "Find $f^{″}(x, y)$ for the function $f(x, y) = x\\sin y + xy$."] [17592186156929 :question/problem "Find $\\boldsymbol f''(\\pi,0)$ for the function $f(x,y)$ given that\n$\\begin{bmatrix}e^{y}\\cos x & e^{y}\\sin x\\end{bmatrix}$"] [17592186156929 :question/worked-solution "For a function $f: \\mathbb R^n \\to \\mathbb R$, given by\n$\\begin{bmatrix}x_{1} \\\\ x_{2} \\\\ ⋮ \\\\ x_{n}\\end{bmatrix}$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x_{1}^{2}} & \\frac{∂^{2}f}{∂x_{1}∂x_{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{1}∂x_{n}} \\\\ \\frac{∂^{2}f}{∂x_{2}∂x_{1}} & \\frac{∂^{2}f}{∂x_{2}^{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{2}∂x_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂^{2}f}{∂x_{n}∂x_{1}} & \\frac{∂^{2}f}{∂x_{n}∂x_{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{n}^{2}}\\end{bmatrix}\n$$\n\nIn our case, we have\n\n$$\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x^{2}} & \\frac{∂^{2}f}{∂x∂y} \\\\ \\frac{∂^{2}f}{∂y∂x} & \\frac{∂^{2}f}{∂y^{2}}\\end{bmatrix}\n$$\n\nFirst, notice that since $\\begin{bmatrix}e^{y}\\cos x & e^{y}\\sin x\\end{bmatrix}$\nwe must have\n\n$$\n\\dfrac{\\partial f}{\\partial x} = e^y\\cos x, \\qquad \\dfrac{\\partial f}{\\partial y} =e^y\\sin x\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x^{2}} &= \\frac{∂}{∂x}(e^{y}\\cos x) =-e^{y}\\sin x & \\frac{∂^{2}f}{∂x∂y}|= \\frac{∂}{∂x}(e^{y}\\sin x) = e^{y}\\cos x \\\\ \\frac{∂^{2}f}{∂y∂x}|= \\frac{∂}{∂y}(e^{y}\\cos x) = e^{y}\\cos x & \\frac{∂^{2}f}{∂y^{2}}|= \\frac{∂}{∂y}(e^{y}\\sin x) = e^{y}\\sin x\\end{bmatrix}\n\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}\nf^{″}(x, y) &= \\begin{bmatrix}-e^{y}\\sin x & e^{y}\\cos x \\\\ e^{y}\\cos x & e^{y}\\sin x\\end{bmatrix}\n\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(\\pi,0)$. This gives\n\n$$\n\\begin{bmatrix}0 & -1 \\\\ -1 & 0\\end{bmatrix}\n$$"] [17592186156931 :question/problem "Find $\\boldsymbol f''(1,0)$ for the function $f(x,y) = x^2 e^y$."] [17592186156931 :question/worked-solution "For a function $f: \\mathbb R^n \\to \\mathbb R$, given by\n$\\begin{bmatrix}x_{1} \\\\ x_{2} \\\\ ⋮ \\\\ x_{n}\\end{bmatrix}$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x_{1}^{2}} & \\frac{∂^{2}f}{∂x_{1}∂x_{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{1}∂x_{n}} \\\\ \\frac{∂^{2}f}{∂x_{2}∂x_{1}} & \\frac{∂^{2}f}{∂x_{2}^{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{2}∂x_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂^{2}f}{∂x_{n}∂x_{1}} & \\frac{∂^{2}f}{∂x_{n}∂x_{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{n}^{2}}\\end{bmatrix}\n$$\n\nIn our case, we have\n\n$$\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x^{2}} & \\frac{∂^{2}f}{∂x∂y} \\\\ \\frac{∂^{2}f}{∂y∂x} & \\frac{∂^{2}f}{∂y^{2}}\\end{bmatrix}\n$$\n\nFirst, we compute the first derivative of $f(x,y)$, as follows:\n\n$$\n\\begin{aligned}\nf^{′}(x, y) &= \\begin{bmatrix}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{bmatrix} \\\\\n&= \\begin{bmatrix}\\frac{∂}{∂x}(x^{2}e^{y}) & \\frac{∂}{∂y}(x^{2}e^{y})\\end{bmatrix} \\\\\n&= \\begin{bmatrix}2xe^{y} & x^{2}e^{y}\\end{bmatrix}\n\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x^{2}} &= \\frac{∂}{∂x}(2xe^{y}) = 2e^{y} & \\frac{∂^{2}f}{∂x∂y}|= \\frac{∂}{∂x}(x^{2}e^{y}) = 2xe^{y} \\\\ \\frac{∂^{2}f}{∂y∂x}|= \\frac{∂}{∂y}(2xe^{y}) = 2xe^{y} & \\frac{∂^{2}f}{∂y^{2}}|= \\frac{∂}{∂y}(x^{2}e^{y}) = x^{2}e^{y}\\end{bmatrix}\n\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}\nf^{″}(x, y) &= \\begin{bmatrix}2e^{y} & 2xe^{y} \\\\ 2xe^{y} & x^{2}e^{y}\\end{bmatrix}\n\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at\n\n$$\n\\left(1,0\\right)\n$$\n\nThis gives\n\n$$\nf^{″}(1, 0) = \\begin{bmatrix}2 & 2 \\\\ 2 & 1\\end{bmatrix}\n$$"] [17592186156930 :question/problem "Given that\n$\\begin{bmatrix}\\ln y & \\frac{x}{y}\\end{bmatrix}$\nevaluate the Hessian determinant of $f(x,y)$ at the point $(0,1)$."] [17592186156930 :question/worked-solution "For a function $f: \\mathbb R^n \\to \\mathbb R$, given by\n$\\begin{bmatrix}x_{1} \\\\ x_{2} \\\\ ⋮ \\\\ x_{n}\\end{bmatrix}$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x_{1}^{2}} & \\frac{∂^{2}f}{∂x_{1}∂x_{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{1}∂x_{n}} \\\\ \\frac{∂^{2}f}{∂x_{2}∂x_{1}} & \\frac{∂^{2}f}{∂x_{2}^{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{2}∂x_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂^{2}f}{∂x_{n}∂x_{1}} & \\frac{∂^{2}f}{∂x_{n}∂x_{2}} & ⋯ & \\frac{∂^{2}f}{∂x_{n}^{2}}\\end{bmatrix}\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(\\mathbf x) = \\det \\left(\\boldsymbol{f}''(\\mathbf x) \\right)\n$$\n\nIn our case, we have\n\n$$\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x^{2}} & \\frac{∂^{2}f}{∂x∂y} \\\\ \\frac{∂^{2}f}{∂y∂x} & \\frac{∂^{2}f}{∂y^{2}}\\end{bmatrix}\n$$\n\nFirst, notice that since\n\n$$\n\\begin{bmatrix}\\ln y & \\frac{x}{y}\\end{bmatrix}\n$$\n\nwe must have\n\n$$\n\\dfrac{\\partial f}{\\partial x} = \\ln y, \\qquad \\dfrac{\\partial f}{\\partial y} = \\dfrac xy\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}\\frac{∂^{2}f}{∂x^{2}} &= \\frac{∂}{∂x}(\\ln y) = 0 & \\frac{∂^{2}f}{∂x∂y}|= \\frac{∂}{∂x}(\\frac{x}{y}) = \\frac{1}{y} \\\\ \\frac{∂^{2}f}{∂y∂x}|= \\frac{∂}{∂y}(\\ln y) = \\frac{1}{y} & \\frac{∂^{2}f}{∂y^{2}}|= \\frac{∂}{∂y}(\\frac{x}{y}) =-\\frac{x}{y^{2}}\\end{bmatrix}\n\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}\nf^{″}(x, y) &= \\begin{bmatrix}\\frac{∂^{2}f}{∂x^{2}} & \\frac{∂^{2}f}{∂x∂y} \\\\ \\frac{∂^{2}f}{∂y∂x} & \\frac{∂^{2}f}{∂y^{2}}\\end{bmatrix} = \\begin{bmatrix}0 & \\frac{1}{y} \\\\ \\frac{1}{y} & -\\frac{x}{y^{2}}\\end{bmatrix}\n\\end{aligned}\n$$\n\nEvaluating the second derivative at $(0,1)$, we obtain\n\n$$\nf^{″}(0, 1) = \\begin{bmatrix}0 & 1 \\\\ 1 & 0\\end{bmatrix}\n$$\n\nFinally, we have\n\n$$\nH(0,1) = 0 \\cdot 0 - 1\\cdot 1 = -1\n$$"]] "immutable_answers" [17592186153402 17592186153403 17592186153404 17592186153405 17592186153406 17592186155627 17592186155628 17592186155629 17592186155630 17592186155631] "immutable_fields" [[17592186153401 :answer-field/correct] [17592186153401 :answer-field/id] [17592186153401 :answer-field/key] [17592186153401 :answer-field/type] [17592186155626 :answer-field/correct] [17592186155626 :answer-field/id] [17592186155626 :answer-field/key] [17592186155626 :answer-field/type]] "no_history" []}
