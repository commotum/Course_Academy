f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({e}^{xy}) & \\frac{∂}{∂y}({e}^{xy})\\end{aligned}] \\\\  & =[\\begin{aligned}y{e}^{xy} & x{e}^{xy}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(y{e}^{xy})={y}^{2}{e}^{xy}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(x{e}^{xy})={e}^{xy}+xy\\,\\text{ }{e}^{xy} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(y{e}^{xy})={e}^{xy}+xy\\,\\text{ }{e}^{xy}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(x{e}^{xy})={x}^{2}{e}^{xy}\\end{aligned}\n$$\n\n \n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}{y}^{2}{e}^{xy} & {e}^{xy}(1+xy) \\\\ {e}^{xy}(1+xy) & {x}^{2}{e}^{xy}\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-80947" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/activity-metadata.json" "file_sha256" "c7bb03c9a97a80a934eeb050314d775f797fa80674863257aabfac0318d9c116"} {"question" "q-80947" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-80947" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}{e}^{xy} & {e}^{xy}(1+xy) \\\\ {e}^{xy}(1+xy) & {e}^{xy}\\end{aligned}]"] ["math" "[\\begin{aligned}{e}^{xy} & {e}^{xy}+xy \\\\ {e}^{xy}+xy & {e}^{xy}\\end{aligned}]"] ["math" "[\\begin{aligned}{x}^{2}{e}^{xy} & {e}^{xy}(2+xy) \\\\ {e}^{xy}(2+xy) & {y}^{2}{e}^{xy}\\end{aligned}]"] ["math" "[\\begin{aligned}{y}^{2}{e}^{xy} & {e}^{xy} \\\\ {e}^{xy} & {x}^{2}{e}^{xy}\\end{aligned}]"] ["math" "[\\begin{aligned}{y}^{2}{e}^{xy} & {e}^{xy}(1+xy) \\\\ {e}^{xy}(1+xy) & {x}^{2}{e}^{xy}\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-80947" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}{y}^{2}{e}^{xy} & {e}^{xy}(1+xy) \\\\ {e}^{xy}(1+xy) & {x}^{2}{e}^{xy}\\end{aligned}]"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81119" "field" nil "attribute" "question/problem" "value" "Find ${f}^{″}(x,y)$ for the function $f(x,y)={y}^{2}({x}^{2}-1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81119" "field" nil "attribute" "question/worked-solution" "value" "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({y}^{2}({x}^{2}-1)) & \\frac{∂}{∂y}({y}^{2}({x}^{2}-1))\\end{aligned}] \\\\  & =[\\begin{aligned}2x{y}^{2} & 2y({x}^{2}-1)\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives: \n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y({x}^{2}-1))=4xy \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{y}^{2})=4xy\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y({x}^{2}-1))=2({x}^{2}-1)\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81119" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/activity-metadata.json" "file_sha256" "c7bb03c9a97a80a934eeb050314d775f797fa80674863257aabfac0318d9c116"} {"question" "q-81119" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81119" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "[\\begin{aligned}2 & 2y \\\\ 2y & 2({x}^{2}-1)\\end{aligned}]"] ["math" "[\\begin{aligned}2y & 0 \\\\ 0 & 2({x}^{2}-1)\\end{aligned}]"] ["math" "[\\begin{aligned}2y & 2x \\\\ 2x & 2({x}^{2}-1)\\end{aligned}]"] ["math" "[\\begin{aligned}2y & 2xy \\\\ 2xy & 2({x}^{2}-1)\\end{aligned}]"] ["math" "[\\begin{aligned}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{aligned}]"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-81119" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "[\\begin{aligned}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{aligned}]"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163642" "field" nil "attribute" "question/problem" "value" "Given that \n${f}^{′}(x,y)=[\\begin{aligned}4xy-3{y}^{2} & 2{x}^{2}-6xy\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(1,1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" "file_sha256" "cbfed8d5ac8aed714d4ee90c33fe3f8b1cc32d8d027b77c3470a7b5d68567dab"} {"question" "q-163642" "field" nil "attribute" "question/worked-solution" "value" "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}4xy-3{y}^{2} & 2{x}^{2}-6xy\\end{aligned}],$\nwe must have\n\n$$\n\\frac{∂f}{∂x}=4xy-3{y}^{2},\\,\\frac{∂f}{∂y}=2{x}^{2}-6xy.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(4xy-3{y}^{2})=4y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2{x}^{2}-6xy)=4x-6y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(4xy-3{y}^{2})=4x-6y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2{x}^{2}-6xy)=-6x\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}4y & 4x-6y \\\\ 4x-6y & -6x\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=[\\begin{aligned}4 & -2 \\\\ -2 & -6\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(1,1)=4\\cdot (-6)-(-2)\\cdot (-2)=-28.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070131/state.json" 