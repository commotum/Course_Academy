{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since ${f}^{′}(x,y)=[\\begin{aligned}2x\\operatorname{sin}⁡y & {x}^{2}\\operatorname{cos}⁡y\\end{aligned}],$ \n we must have\n\n$$\n\\frac{∂f}{∂x}=2x\\operatorname{sin}⁡y,\\,\\frac{∂f}{∂y}={x}^{2}\\operatorname{cos}⁡y.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x\\operatorname{sin}⁡y)=2\\operatorname{sin}⁡y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({x}^{2}\\operatorname{cos}⁡y)=2x\\operatorname{cos}⁡y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x\\operatorname{sin}⁡y)=2x\\operatorname{cos}⁡y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({x}^{2}\\operatorname{cos}⁡y)=-{x}^{2}\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}2\\operatorname{sin}⁡y & 2x\\operatorname{cos}⁡y \\\\ 2x\\operatorname{cos}⁡y & -{x}^{2}\\operatorname{sin}⁡y\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(2,\\frac{\\pi }{2}).$ This gives\n\n$$\n{f}^{″}(2,\\frac{\\pi }{2})=[\\begin{aligned}2 & 0 \\\\ 0 & -4\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163635/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74c4234a-3aa1-5b6b-b68b-48e6aa2b0dfb"] :knowledge-point/questions ["q-163635"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81123/selection/e7a040f53a0718aae8e6e8dc532082b771517e052c716f867a1517a8f876732c" :answer/id #uuid "f43acab8-541f-56dd-bf48-2923951342b4" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 0 \\\\ 0 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81123/selection/7d3e88fc4a703af6877753f07368884d096e0593bff83421305dc44362faadd0" :answer/id #uuid "adcaa052-6d7c-567e-af8f-3946c47a2e69" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -2 \\\\ -2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81123/selection/46b3d411e155001c5e7d874af3fd7c38dca1154d2ffa0bb7628957f4e4dfbb46" :answer/id #uuid "4e5aeef0-7c3b-5e26-963f-af5017f88979" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & 2 \\\\ 2 & 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81123/selection/65e45ec443b08a705f6d5214c5b10e2f0ce0f9ff2b64cbeb1b67d9b9939a3f93" :answer/id #uuid "70abffe5-ca6b-5ec2-9c2a-79dd5da4e83e" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 2 \\\\ 2 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81123/selection/32e1eaca8eeb8372202836ba48177cbad280e905b4798d9c635b13ba4d54bccf" :answer/id #uuid "bf275c60-709a-5dde-987d-70d9d909bf45" :answer/type :answer.type/math :answer/value "[\\begin{aligned}0 & -1 \\\\ -1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81123/selection" :answer-field/id #uuid "23cb1c28-fb05-56f5-a623-2400fdc9b744" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81123/selection/7d3e88fc4a703af6877753f07368884d096e0593bff83421305dc44362faadd0" :answer-field/choices ["q-81123/selection/e7a040f53a0718aae8e6e8dc532082b771517e052c716f867a1517a8f876732c" "q-81123/selection/7d3e88fc4a703af6877753f07368884d096e0593bff83421305dc44362faadd0" "q-81123/selection/46b3d411e155001c5e7d874af3fd7c38dca1154d2ffa0bb7628957f4e4dfbb46" "q-81123/selection/65e45ec443b08a705f6d5214c5b10e2f0ce0f9ff2b64cbeb1b67d9b9939a3f93" "q-81123/selection/32e1eaca8eeb8372202836ba48177cbad280e905b4798d9c635b13ba4d54bccf"] :db/ensure [:answer-field/validate]} {:db/id "q-81123" :question/id #uuid "74262592-fff9-55b8-b09e-a90c6c4a1e4c" :question/math-academy-id "q-81123" :question/problem "Find ${f}^{″}(-1,2)$ for the function $f(x,y)=(y-1)({x}^{2}-1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}((y-1)({x}^{2}-1)) & \\frac{∂}{∂y}((y-1)({x}^{2}-1))\\end{aligned}] \\\\  & =[\\begin{aligned}2x(y-1) & {x}^{2}-1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x(y-1))=2(y-1)\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}({x}^{2}-1)=2x \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x(y-1))=2x\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}({x}^{2}-1)=0\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}2(y-1) & 2x \\\\ 2x & 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we evaluate this matrix at $(-1,2).$ This gives\n\n$$\n\\begin{aligned}{f}^{″}(-1,2)=[\\begin{aligned}2 & -2 \\\\ -2 & 0\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-81123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92"] :knowledge-point/questions ["q-81123"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-80939"] :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)=x\\operatorname{sin}⁡y+xy.$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}(x\\operatorname{sin}⁡y+xy) & \\frac{∂}{∂y}(x\\operatorname{sin}⁡y+xy)\\end{aligned}] \\\\  & =[\\begin{aligned}\\operatorname{sin}⁡y+y & x\\operatorname{cos}⁡y+x\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡y+y)=0\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡y+x)=\\operatorname{cos}⁡y+1 \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(\\operatorname{sin}⁡y+y)=\\operatorname{cos}⁡y+1\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡y+x)=-x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y)=[\\begin{aligned}0 & \\operatorname{cos}⁡y+1 \\\\ \\operatorname{cos}⁡y+1 & -x\\operatorname{sin}⁡y\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-81111/selection/352a3cbef9c92bd5e4225f484325b98a8febe1fa64112fe7e97bd712aa15a679" :answer/id #uuid "0cebbac0-0da0-5dc7-afd9-ca1cc5b20538" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 4xy{e}^{{x}^{2}+{y}^{2}} \\\\ 4xy{e}^{{x}^{2}+{y}^{2}} & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81111/selection/4661141610b4e13ca624d27afddad00fa58fde2d34405459e79583a41e34c736" :answer/id #uuid "815e2989-d2ac-53db-ac92-56a41c46a90a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(2+4x){e}^{{x}^{2}+{y}^{2}} & 2{e}^{{x}^{2}+{y}^{2}} \\\\ 2{e}^{{x}^{2}+{y}^{2}} & (2+4y){e}^{{x}^{2}+{y}^{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81111/selection/4939c7418d8670495f443d149ee343b89b2544e16c56c8b796569b703c6c2eab" :answer/id #uuid "fa1874e9-0770-5f2d-a605-212a71f7c41a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 0 \\\\ 0 & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81111/selection/0e75a611f9e3f92a93b06051c21365bc2c12b47715261851edbf6a78bc958c59" :answer/id #uuid "a7a24aa2-6613-5404-8b61-9f0360442eda" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{{x}^{2}+{y}^{2}} & 2{e}^{{x}^{2}+{y}^{2}} \\\\ 2{e}^{{x}^{2}+{y}^{2}} & {e}^{{x}^{2}+{y}^{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81111/selection/b9bad304e4dbeb3f751a86e4284d8ec05a98d598ffe7398426c61c88db6810f4" :answer/id #uuid "cd92eb1f-bf56-52be-9e24-671ff930c874" :answer/type :answer.type/math :answer/value "[\\begin{aligned}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 2{e}^{{x}^{2}+{y}^{2}} \\\\ 2{e}^{{x}^{2}+{y}^{2}} & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81111/selection" :answer-field/id #uuid "d30d1a2e-2166-5e0b-afbc-84c87bbefacb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81111/selection/352a3cbef9c92bd5e4225f484325b98a8febe1fa64112fe7e97bd712aa15a679" :answer-field/choices ["q-81111/selection/352a3cbef9c92bd5e4225f484325b98a8febe1fa64112fe7e97bd712aa15a679" "q-81111/selection/4661141610b4e13ca624d27afddad00fa58fde2d34405459e79583a41e34c736" "q-81111/selection/4939c7418d8670495f443d149ee343b89b2544e16c56c8b796569b703c6c2eab" "q-81111/selection/0e75a611f9e3f92a93b06051c21365bc2c12b47715261851edbf6a78bc958c59" "q-81111/selection/b9bad304e4dbeb3f751a86e4284d8ec05a98d598ffe7398426c61c88db6810f4"] :db/ensure [:answer-field/validate]} {:db/id "q-81111" :question/id #uuid "93f5f48f-d420-5aa1-920f-ebb239acb303" :question/math-academy-id "q-81111" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)={e}^{{x}^{2}+{y}^{2}}.$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({e}^{{x}^{2}+{y}^{2}}) & \\frac{∂}{∂y}({e}^{{x}^{2}+{y}^{2}})\\end{aligned}] \\\\  & =[\\begin{aligned}2x{e}^{{x}^{2}+{y}^{2}} & 2y{e}^{{x}^{2}+{y}^{2}}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives: \n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{e}^{{x}^{2}+{y}^{2}})=(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y{e}^{{x}^{2}+{y}^{2}})=4xy{e}^{{x}^{2}+{y}^{2}} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{e}^{{x}^{2}+{y}^{2}})=4xy{e}^{{x}^{2}+{y}^{2}}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y{e}^{{x}^{2}+{y}^{2}})=(2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\n  \n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}(2+4{x}^{2}){e}^{{x}^{2}+{y}^{2}} & 4xy{e}^{{x}^{2}+{y}^{2}} \\\\ 4xy{e}^{{x}^{2}+{y}^{2}} & (2+4{y}^{2}){e}^{{x}^{2}+{y}^{2}}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81111/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92"] :knowledge-point/questions ["q-81111"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80947/selection/fd76f3258e1c03931cefc0fe9d38faf54f007e94bc1df6827119434d0bf253b5" :answer/id #uuid "c06664ed-c82e-58ec-b253-08acbeb1b049" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{xy} & {e}^{xy}(1+xy) \\\\ {e}^{xy}(1+xy) & {e}^{xy}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80947/selection/855dedf41267f1d8218c2030bece0b75c6a7f0c0f05857d89a5baf0789a8f331" :answer/id #uuid "e0b58862-d09a-52a2-a26c-755afa039661" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{y}^{2}{e}^{xy} & {e}^{xy}(1+xy) \\\\ {e}^{xy}(1+xy) & {x}^{2}{e}^{xy}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80947/selection/36103184d8fa89bb4e68d44a4b17328fc7f71c49d10672969e522c9a9256f00e" :answer/id #uuid "a959768f-f344-594d-b877-47fbec33620a" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{y}^{2}{e}^{xy} & {e}^{xy} \\\\ {e}^{xy} & {x}^{2}{e}^{xy}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80947/selection/ee4b8c26a3e19bcd72a2c97458d603c9b2088cc31fffdbb49d4b95b4b27122b7" :answer/id #uuid "db485220-6bfd-53d3-a20a-3c70e88501e7" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{xy} & {e}^{xy}+xy \\\\ {e}^{xy}+xy & {e}^{xy}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80947/selection/f6a246f25c5f2530a01bf425df4976289ef6b58832e30feaa3dccb0e6af566d6" :answer/id #uuid "c5646e33-2662-5a2e-a68e-5dff25f92833" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{x}^{2}{e}^{xy} & {e}^{xy}(2+xy) \\\\ {e}^{xy}(2+xy) & {y}^{2}{e}^{xy}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-80947/selection" :answer-field/id #uuid "f062014e-da95-5e90-80f7-697c9690531e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80947/selection/855dedf41267f1d8218c2030bece0b75c6a7f0c0f05857d89a5baf0789a8f331" :answer-field/choices ["q-80947/selection/fd76f3258e1c03931cefc0fe9d38faf54f007e94bc1df6827119434d0bf253b5" "q-80947/selection/855dedf41267f1d8218c2030bece0b75c6a7f0c0f05857d89a5baf0789a8f331" "q-80947/selection/36103184d8fa89bb4e68d44a4b17328fc7f71c49d10672969e522c9a9256f00e" "q-80947/selection/ee4b8c26a3e19bcd72a2c97458d603c9b2088cc31fffdbb49d4b95b4b27122b7" "q-80947/selection/f6a246f25c5f2530a01bf425df4976289ef6b58832e30feaa3dccb0e6af566d6"] :db/ensure [:answer-field/validate]} {:db/id "q-80947" :question/id #uuid "5b55b18c-139d-56b5-94eb-26aeb293ef39" :question/math-academy-id "q-80947" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)={e}^{xy}.$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({e}^{xy}) & \\frac{∂}{∂y}({e}^{xy})\\end{aligned}] \\\\  & =[\\begin{aligned}y{e}^{xy} & x{e}^{xy}\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(y{e}^{xy})={y}^{2}{e}^{xy}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(x{e}^{xy})={e}^{xy}+xy\\,\\text{ }{e}^{xy} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(y{e}^{xy})={e}^{xy}+xy\\,\\text{ }{e}^{xy}\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(x{e}^{xy})={x}^{2}{e}^{xy}\\end{aligned}\n$$\n\n \n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}{y}^{2}{e}^{xy} & {e}^{xy}(1+xy) \\\\ {e}^{xy}(1+xy) & {x}^{2}{e}^{xy}\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80947/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92"] :knowledge-point/questions ["q-80947"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81119/selection/9aef71476472e6a77e449c7585ac2337cc0b04648134b3b20e2987d3db525ce7" :answer/id #uuid "ddd802c6-0729-5df3-a155-3d6ae8c8ce66" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & 2y \\\\ 2y & 2({x}^{2}-1)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81119/selection/bbe425a6c7d731d93520d68ec39df8d2d542030d7ef71443e1dd497e1af0b744" :answer/id #uuid "36d8011d-a00e-5381-9a6e-2a4cdad44313" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2y & 2x \\\\ 2x & 2({x}^{2}-1)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81119/selection/61011b6737eafe9bd34bed7dbe376b72ae58eccb68344ce8b2d365f86b2bd87a" :answer/id #uuid "686adeba-dae4-5d97-a60a-63cdb9ec1d29" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81119/selection/636da2671c6257d7d3cc0771250a1eb3ccd48c92195e86bba4110805865b425d" :answer/id #uuid "a014e6fb-9047-5386-940e-8d6d00460928" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2y & 0 \\\\ 0 & 2({x}^{2}-1)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81119/selection/96bdbe1c4ccde84f9cf2442825c9202bbb19b889b09a37c9d6c4f82892bd8538" :answer/id #uuid "309a0585-e3b2-5b59-a649-089e97a86a3d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2y & 2xy \\\\ 2xy & 2({x}^{2}-1)\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-81119/selection" :answer-field/id #uuid "306146fd-2450-50f2-9d7c-01f25ac77438" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81119/selection/61011b6737eafe9bd34bed7dbe376b72ae58eccb68344ce8b2d365f86b2bd87a" :answer-field/choices ["q-81119/selection/9aef71476472e6a77e449c7585ac2337cc0b04648134b3b20e2987d3db525ce7" "q-81119/selection/bbe425a6c7d731d93520d68ec39df8d2d542030d7ef71443e1dd497e1af0b744" "q-81119/selection/61011b6737eafe9bd34bed7dbe376b72ae58eccb68344ce8b2d365f86b2bd87a" "q-81119/selection/636da2671c6257d7d3cc0771250a1eb3ccd48c92195e86bba4110805865b425d" "q-81119/selection/96bdbe1c4ccde84f9cf2442825c9202bbb19b889b09a37c9d6c4f82892bd8538"] :db/ensure [:answer-field/validate]} {:db/id "q-81119" :question/id #uuid "953fe33f-1428-5dd9-88fe-de345ba3b466" :question/math-academy-id "q-81119" :question/problem "Find ${f}^{″}(x,y)$ for the function $f(x,y)={y}^{2}({x}^{2}-1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, we compute the first derivative of $f(x,y),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x,y) & =[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{∂}{∂x}({y}^{2}({x}^{2}-1)) & \\frac{∂}{∂y}({y}^{2}({x}^{2}-1))\\end{aligned}] \\\\  & =[\\begin{aligned}2x{y}^{2} & 2y({x}^{2}-1)\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the second partial derivatives: \n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(2x{y}^{2})=2{y}^{2}\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2y({x}^{2}-1))=4xy \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(2x{y}^{2})=4xy\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2y({x}^{2}-1))=2({x}^{2}-1)\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}2{y}^{2} & 4xy \\\\ 4xy & 2({x}^{2}-1)\\end{aligned}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81119/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf99849-1f2b-5c34-828c-164ad4058c92"] :knowledge-point/questions ["q-81119"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163642/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" :answer/id #uuid "2a0c6bec-1135-5071-931f-2dc14d4eb0b2" :answer/type :answer.type/math :answer/value "25" :db/ensure [:answer/validate]} {:db/id "q-163642/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" :answer/id #uuid "02349ac6-0b22-5fb1-8e57-19399fecf3f4" :answer/type :answer.type/math :answer/value "-16" :db/ensure [:answer/validate]} {:db/id "q-163642/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" :answer/id #uuid "b4f1b36e-b82e-52a3-99d4-bd6f57fbe987" :answer/type :answer.type/math :answer/value "32" :db/ensure [:answer/validate]} {:db/id "q-163642/selection/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" :answer/id #uuid "e27acc18-d276-599f-b725-1840f8eb24ca" :answer/type :answer.type/math :answer/value "-28" :db/ensure [:answer/validate]} {:db/id "q-163642/selection/008b962e8dba6a793a19582d7b90d25ecc915fb39cdb8821fa797599cabe57ab" :answer/id #uuid "4223c84a-633e-5d34-ae57-21c4f7de5091" :answer/type :answer.type/math :answer/value "-40" :db/ensure [:answer/validate]} {:db/id "q-163642/selection" :answer-field/id #uuid "6aae77dd-804e-5791-9b66-5a8e698e4c7f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163642/selection/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" :answer-field/choices ["q-163642/selection/a84d639d380e10cb74c92005685f9f65779377dfb51342c280c63c645679bbea" "q-163642/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" "q-163642/selection/a38ef12f135c1e6010d68ed21f81bc27372a73a756455b7066f6182c46018cc8" "q-163642/selection/94b1e608a1bece13c117321c62644f2051416b0003719c2dd4b9ea44af9d6b64" "q-163642/selection/008b962e8dba6a793a19582d7b90d25ecc915fb39cdb8821fa797599cabe57ab"] :db/ensure [:answer-field/validate]} {:db/id "q-163642" :question/id #uuid "2c30dd99-4223-5fc5-b0a9-d42d9d800191" :question/math-academy-id "q-163642" :question/problem "Given that \n${f}^{′}(x,y)=[\\begin{aligned}4xy-3{y}^{2} & 2{x}^{2}-6xy\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(1,1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}4xy-3{y}^{2} & 2{x}^{2}-6xy\\end{aligned}],$\nwe must have\n\n$$\n\\frac{∂f}{∂x}=4xy-3{y}^{2},\\,\\frac{∂f}{∂y}=2{x}^{2}-6xy.\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(4xy-3{y}^{2})=4y\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(2{x}^{2}-6xy)=4x-6y \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(4xy-3{y}^{2})=4x-6y\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(2{x}^{2}-6xy)=-6x\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}4y & 4x-6y \\\\ 4x-6y & -6x\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(1,1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(1,1)=[\\begin{aligned}4 & -2 \\\\ -2 & -6\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(1,1)=4\\cdot (-6)-(-2)\\cdot (-2)=-28.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163642/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "037ff08b-3246-5eed-870b-b4951f319c96"] :knowledge-point/questions ["q-163642"] :db/ensure [:knowledge-point/validate]} {:db/id "q-102688/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "575b63e0-b224-5f63-81bf-770a43cd8a7c" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-102688/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6ebab16c-d020-56a6-8aa7-4657a8c695c2" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-102688/selection/27b6b290159b137d6361e7e4a5864f4eb11e17e7cf948e4987251275b0b033b2" :answer/id #uuid "3bf48c51-728d-5aa7-ba8f-f6181230d084" :answer/type :answer.type/math :answer/value "-{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-102688/selection/1fd5d015557ac5383f2a73475fa5e248de4f39baff99ad3720b4199596f806c3" :answer/id #uuid "15152ce0-2ad0-5fbe-8e02-7e363388b0c7" :answer/type :answer.type/math :answer/value "1-2{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-102688/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8" :answer/id #uuid "b6bc9658-5be2-5242-b8b6-0c28a7e886c6" :answer/type :answer.type/math :answer/value "{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-102688/selection" :answer-field/id #uuid "fc8bc93e-e92d-561c-8f69-7e91b3d1ec9b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-102688/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-102688/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-102688/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-102688/selection/27b6b290159b137d6361e7e4a5864f4eb11e17e7cf948e4987251275b0b033b2" "q-102688/selection/1fd5d015557ac5383f2a73475fa5e248de4f39baff99ad3720b4199596f806c3" "q-102688/selection/f6cd7ad815cbceebfe1cddfb3219edf7d8bce0273da1c741fc6acf433fc7d1c8"] :db/ensure [:answer-field/validate]} {:db/id "q-102688" :question/id #uuid "64d88488-c131-5b90-b996-0433a97d3737" :question/math-academy-id "q-102688" :question/problem "Given that \n${f}^{′}(x,y)=[\\begin{aligned}y\\operatorname{cos}⁡(xy) & x\\operatorname{cos}⁡(xy)\\end{aligned}],$ \nevaluate the Hessian determinant of $f(x,y)$ at the point $(\\pi ,-1).$" :question/worked-solution "For a function $f:{R}^{n}\\to R,$ given by\n\n$$\nf:{{[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]}_{⏟}}_{x}⟶f({x}_{1},{x}_{2},…,{x}_{n}),\n$$\n\nthe second derivative of $f$ is given by the $n\\times n$ matrix\n\n$$\n{f}^{″}(x)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}].\n$$\n\nThe Hessian determinant $H(x,y)$ is the determinant of the second derivative:\n\n$$\nH(x)=det({f}^{″}(x))\n$$\n\nIn our case, we have\n\n$$\n{f}^{″}(x,y)=[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}].\n$$\n\nFirst, notice that since\n${f}^{′}(x,y)=[\\begin{aligned}y\\operatorname{cos}⁡(xy) & x\\operatorname{cos}⁡(xy)\\end{aligned}],$\nwe must have\n\n$$\n\\frac{∂f}{∂x}=y\\operatorname{cos}⁡(xy),\\,\\frac{∂f}{∂y}=x\\operatorname{cos}⁡(xy).\n$$\n\nNow, we compute the second partial derivatives:\n\n$$\n\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & =\\frac{∂}{∂x}(y\\operatorname{cos}⁡(xy))=-{y}^{2}\\operatorname{sin}⁡(xy)\\, & \\frac{{∂}^{2}f}{∂x∂y} & =\\frac{∂}{∂x}(x\\operatorname{cos}⁡(xy))=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\ \\frac{{∂}^{2}f}{∂y∂x} & =\\frac{∂}{∂y}(y\\operatorname{cos}⁡(xy))=\\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy)\\, & \\frac{{∂}^{2}f}{∂{y}^{2}} & =\\frac{∂}{∂y}(x\\operatorname{cos}⁡(xy))=-{x}^{2}\\operatorname{sin}⁡(xy)\\end{aligned}\n$$\n\nSo, the second derivative is\n\n$$\n\\begin{aligned}{f}^{″}(x,y) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]=[\\begin{aligned}-{y}^{2}\\operatorname{sin}⁡(xy) & \\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) \\\\ \\operatorname{cos}⁡(xy)-xy\\operatorname{sin}⁡(xy) & -{x}^{2}\\operatorname{sin}⁡(xy)\\end{aligned}].\\end{aligned}\n$$\n\n \n\nEvaluating the second derivative at $(\\pi ,-1),$ we obtain\n\n$$\n\\begin{aligned}{f}^{″}(\\pi ,-1)=[\\begin{aligned}0 & -1 \\\\ -1 & 0\\end{aligned}].\\end{aligned}\n$$\n\nFinally, we have\n\n$$\nH(\\pi ,-1)=0\\cdot 0-(-1)\\cdot (-1)=-1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-102688/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "037ff08b-3246-5eed-870b-b4951f319c96"] :knowledge-point/questions ["q-102688"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163641/selection/a5bcf5044d7131cdf0d721e80125a87ad3d00d