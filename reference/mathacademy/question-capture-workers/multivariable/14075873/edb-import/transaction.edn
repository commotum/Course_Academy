8e6bcc31d8afd497a3bfbec73/2feafbd1c9c87ffb823267aed1405d073fcb774c73b9d2dc504a1c990c95c9dd" :answer-field/choices ["q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73/2feafbd1c9c87ffb823267aed1405d073fcb774c73b9d2dc504a1c990c95c9dd" "q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73/7fee6f9a98fe37f97bab0281ab609fd6877c7f0077323c1735fe8f780f997318" "q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73/0268646bd09f6f0dda6364f10a56beadf51693d23f4ee5eb9f47edacf6a0de0f" "q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73/8f00b62b0e57f1f0053a290091404ff2b0c0cdb9ecbd46a098640f3fc5106adc" "q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73/dc525147380ed85f1221aebf6d149498235c58ca717bd413fb089f523ca2fb8e"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-161166"] :question/problem "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(\\frac{}{∂x}-Q\\frac{∂g}{}+R)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nSince our surface $S$ is of the form $z=g(x,y),$ it can be parameterized as\n\n$$\nr(x,y)=⟨x,\\,y,\\,g(x,y)⟩.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨1,\\,0,\\,\\frac{∂g}{∂x}⟩ \\\\ {r}_{y}^{′} & =⟨0,\\,1,\\,\\frac{∂g}{∂y}⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{y}^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & 0 & \\frac{∂g}{∂x} \\\\ 0 & 1 & \\frac{∂g}{∂y}\\end{aligned}|=⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,y))\\cdot ({r}_{x}^{′}\\times {r}_{y}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,\\,R⟩\\cdot ⟨-\\frac{∂g}{∂x},\\,-\\frac{∂g}{∂y},\\,1⟩\\,\\text{d}A \\\\  & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73"] :db/ensure [:question/validate]} {:db/id "q-161435/selection/d3594336ad0ef9a52cff1d0161e65a326238c152d3dcf7a889f48502c0de39ec" :answer/id #uuid "e6c75a04-f929-501d-b9ce-0d993a68daef" :answer/type :answer.type/math :answer/value "\\frac{4{e}^{2}-1}{8}" :db/ensure [:answer/validate]} {:db/id "q-161435/selection/bc670bc6ef15f254dcc8b5adbbe57885c94f931ea92efc6e319c9f15f7c92ba3" :answer/id #uuid "3eba5cb2-7d57-5fa6-8347-2e9f7e7d9b7c" :answer/type :answer.type/math :answer/value "\\frac{4{e}^{2}+1}{8}" :db/ensure [:answer/validate]} {:db/id "q-161435/selection/036990c4d64b34581452d4a0ae1aeda3c675889dd871bff2b6d23782af27027d" :answer/id #uuid "f18d0a5c-cea3-5a67-afbe-3ccf23901d60" :answer/type :answer.type/math :answer/value "\\frac{8e-1}{8}" :db/ensure [:answer/validate]} {:db/id "q-161435/selection/74da883b5289ce58c87a09ed19769d04f67075d787498d50b492d1347fe508b3" :answer/id #uuid "534ac176-0233-5f15-b86f-13383c3f5416" :answer/type :answer.type/math :answer/value "\\frac{4{e}^{2}-8e}{8}" :db/ensure [:answer/validate]} {:db/id "q-161435/selection/99ab710d42fb838b0b917e02d2a66fc440bdb1093bf7725a2550f1cc5580264d" :answer/id #uuid "40be4934-a3ab-518e-b0bb-649486ed7e3c" :answer/type :answer.type/math :answer/value "\\frac{4{e}^{2}-8e-1}{8}" :db/ensure [:answer/validate]} {:db/id "q-161435/selection" :answer-field/id #uuid "8ccd42e7-12bb-5f6a-9513-22af848b8f70" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161435/selection/99ab710d42fb838b0b917e02d2a66fc440bdb1093bf7725a2550f1cc5580264d" :answer-field/choices ["q-161435/selection/d3594336ad0ef9a52cff1d0161e65a326238c152d3dcf7a889f48502c0de39ec" "q-161435/selection/bc670bc6ef15f254dcc8b5adbbe57885c94f931ea92efc6e319c9f15f7c92ba3" "q-161435/selection/036990c4d64b34581452d4a0ae1aeda3c675889dd871bff2b6d23782af27027d" "q-161435/selection/74da883b5289ce58c87a09ed19769d04f67075d787498d50b492d1347fe508b3" "q-161435/selection/99ab710d42fb838b0b917e02d2a66fc440bdb1093bf7725a2550f1cc5580264d"] :db/ensure [:answer-field/validate]} {:db/id "q-161435" :question/id #uuid "afd6524e-9981-5d04-b2d9-53c6f686b4d2" :question/math-academy-id "q-161435" :question/problem "Evaluate the surface integral\n\n$$\n{∬}_{S}⟨xy,\\,x+y,\\,{e}^{z}⟩\\cdot \\text{d}S\n$$\n\nwhere the surface $S$ is defined by $z=x+y$ for $0\\le x\\le 1$ and $0\\le y\\le x.$" :question/worked-solution "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(x+y)=1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(x+y)=1\\end{aligned}\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨xy,\\,x+y,\\,{e}^{z}⟩{|}_{z=x+y} \\\\  & =⟨xy,\\,x+y,\\,{e}^{x+y}⟩ \\\\  & =⟨{{xy}_{⏟}}_{P},\\,{{x+y}_{⏟}}_{Q},\\,{{{e}^{x+y}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨xy,\\,x+y,\\,{e}^{z}⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(xy)\\cdot 1-(x+y)\\cdot 1+{e}^{x+y})\\,\\text{d}A \\\\  & ={∬}_{D}(-xy-x-y+{e}^{x+y})\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{x}(-xy-x-y+{e}^{x+y})\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{[-\\frac{x{y}^{2}}{2}-xy-\\frac{{y}^{2}}{2}+{e}^{x+y}]}_{y=0}^{y=x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-\\frac{{x}^{3}}{2}-{x}^{2}-\\frac{{x}^{2}}{2}+{e}^{2x}-{e}^{x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-\\frac{{x}^{3}}{2}-\\frac{3{x}^{2}}{2}+{e}^{2x}-{e}^{x})\\,\\text{d}x \\\\  & ={[-\\frac{{x}^{4}}{8}-\\frac{{x}^{3}}{2}+\\frac{{e}^{2x}}{2}-{e}^{x}]}_{0}^{1} \\\\  & =(-\\frac{1}{8}-\\frac{1}{2}+\\frac{{e}^{2}}{2}-e)-(0+\\frac{1}{2}-1) \\\\  & =\\frac{4{e}^{2}-8e-1}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161435/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aaa6b152-86d3-5f96-8a94-57f86a17a84d"] :knowledge-point/questions ["q-161435"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161465/selection/4268d5f2e1787d99d87401d0719953cfcf6c49f3fdbea7f686c5932758956d26" :answer/id #uuid "d86f08ee-46a5-5d5c-a4f6-6ab578a67d65" :answer/type :answer.type/math :answer/value "-Q,\\text{ }\\frac{∂k}{∂x},\\text{ }\\frac{∂k}{∂z}" :db/ensure [:answer/validate]} {:db/id "q-161465/selection/4e692c22478d6df13d49d365582d88d94a8d36298568c0694fbaa9683a1b3946" :answer/id #uuid "83d932bf-ac71-5275-9b57-4a0085556665" :answer/type :answer.type/math :answer/value "-Q,\\text{ }\\frac{∂k}{∂y},\\text{ }\\frac{∂k}{∂z}" :db/ensure [:answer/validate]} {:db/id "q-161465/selection/5eee6f9b69dc6d2ba397e14594e43604f0adf15314f9fc76f9be4f3aac7e9376" :answer/id #uuid "b2ab5af8-f54d-54ad-9e2e-73bc5c880dc1" :answer/type :answer.type/math :answer/value "-Q,\\text{ }\\frac{∂k}{∂z},\\text{ }\\frac{∂k}{∂y}" :db/ensure [:answer/validate]} {:db/id "q-161465/selection/442f028a968a61987b97320b98f84c7a73fa6f970b5983839300188a2b0a0a4c" :answer/id #uuid "6d5c1b9e-bb8a-508e-bccf-cf999c09ffd7" :answer/type :answer.type/math :answer/value "Q,\\text{ }\\frac{∂k}{∂y},\\text{ }\\frac{∂k}{∂z}" :db/ensure [:answer/validate]} {:db/id "q-161465/selection/239eaac999f40a0d8dda48233790a0f0734973723f90baa0c895c942b445906b" :answer/id #uuid "d331386a-7420-5e9b-8b84-e79285c94750" :answer/type :answer.type/math :answer/value "Q,\\text{ }\\frac{∂k}{∂y},\\text{ }\\frac{∂k}{∂x}" :db/ensure [:answer/validate]} {:db/id "q-161465/selection" :answer-field/id #uuid "0bb1c8f2-e35a-5ce0-a8b8-63701b0f3baa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161465/selection/442f028a968a61987b97320b98f84c7a73fa6f970b5983839300188a2b0a0a4c" :answer-field/choices ["q-161465/selection/4268d5f2e1787d99d87401d0719953cfcf6c49f3fdbea7f686c5932758956d26" "q-161465/selection/4e692c22478d6df13d49d365582d88d94a8d36298568c0694fbaa9683a1b3946" "q-161465/selection/5eee6f9b69dc6d2ba397e14594e43604f0adf15314f9fc76f9be4f3aac7e9376" "q-161465/selection/442f028a968a61987b97320b98f84c7a73fa6f970b5983839300188a2b0a0a4c" "q-161465/selection/239eaac999f40a0d8dda48233790a0f0734973723f90baa0c895c942b445906b"] :db/ensure [:answer-field/validate]} {:db/id "q-161465" :question/id #uuid "ce7abf15-5470-59cf-959c-492a8c66495f" :question/math-academy-id "q-161465" :question/problem "For a surface $S$ given by $x=k(y,z)$ for $(y,z)\\in D,$ the flux of the vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(P-\\,-R\\,)\\,\\text{d}A.\n$$\n\nFrom left to right, what are the missing parts of the formula?" :question/worked-solution "For a surface $S$ with parametrization $r(u,v)$ for $(u,v)\\in D,$ the flux of a vector field $F$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{S}F\\cdot n\\,\\text{d}S={∬}_{D}F(r(u,v))\\cdot ({r}_{u}^{′}\\times {r}_{v}^{′})\\,\\text{d}A.\n$$\n\nSince our surface $S$ is of the form $x=k(y,z),$ it can be parameterized as\n\n$$\nr(y,z)=⟨k(y,z),\\,y,\\,z⟩.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{y}^{′} & =⟨\\frac{∂k}{∂y},\\,1,\\,0⟩ \\\\ {r}_{z}^{′} & =⟨\\frac{∂k}{∂z},\\,0,\\,1⟩\\end{aligned}\n$$\n\nNow, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{z}^{′} & =|\\begin{aligned}i & j & k \\\\ \\frac{∂k}{∂y} & 1 & 0 \\\\ \\frac{∂k}{∂z} & 0 & 1\\end{aligned}|=⟨1,\\,-\\frac{∂k}{∂y},\\,-\\frac{∂k}{∂z}⟩.\\end{aligned}\n$$\n\nTherefore, the surface integral can be written as\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{D}F(r(x,y))\\cdot ({r}_{y}^{′}\\times {r}_{z}^{′})\\,\\text{d}A \\\\  & ={∬}_{D}⟨P,\\,Q,\\,R⟩\\cdot ⟨1,\\,-\\frac{∂k}{∂y},\\,-\\frac{∂k}{∂z}⟩\\,\\text{d}A \\\\  & ={∬}_{D}(P-Q\\,\\frac{∂k}{∂y}-R\\,\\frac{∂k}{∂z})\\,\\text{d}A.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161465/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55cd2fdb-4cae-5f0b-bea0-e845d51190e1"] :knowledge-point/questions ["q-161465"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161541/selection/5d157037d7c29f09096b9c397683686d65b758304acf3fda933b0ebc9e6efa59" :answer/id #uuid "5a64bc40-8f8a-5091-97d0-2358e8f21db6" :answer/type :answer.type/math :answer/value "\\frac{4(3-\\operatorname{ln}⁡2)}{2}" :db/ensure [:answer/validate]} {:db/id "q-161541/selection/3f2c3d5bde4626c6498cfbc42f464872ad2e593f78a6c7e9afd75ba227d96e27" :answer/id #uuid "163c0a86-5178-5d24-aee3-f6409ef89e3a" :answer/type :answer.type/math :answer/value "\\frac{7(3-\\operatorname{ln}⁡2)}{2}" :db/ensure [:answer/validate]} {:db/id "q-161541/selection/bfba4f36c28697d76ab9bea5db62e07018427c7b4d40d936001889b3614c90dc" :answer/id #uuid "96d89a9f-d7d6-5e53-8707-79240df6d741" :answer/type :answer.type/math :answer/value "\\frac{7(3-\\operatorname{ln}⁡4)}{2}" :db/ensure [:answer/validate]} {:db/id "q-161541/selection/32860d1508b9e39b3e802bb7deeb931ecdfa11505f5d22d1a7af155b95e09e01" :answer/id #uuid "eba9ddb8-6f53-572a-be52-1182e40d9d9f" :answer/type :answer.type/math :answer/value "\\frac{7(2-\\operatorname{ln}⁡4)}{2}" :db/ensure [:answer/validate]} {:db/id "q-161541/selection/404ed290384d69ada0e463c40eb6f1300038b2eb5e54126f497966f4c39c2046" :answer/id #uuid "d96f830f-6566-5d91-ac8d-6451d5d04872" :answer/type :answer.type/math :answer/value "\\frac{7(6-\\operatorname{ln}⁡2)}{2}" :db/ensure [:answer/validate]} {:db/id "q-161541/selection" :answer-field/id #uuid "bd083817-246a-5e7a-9d91-8c1ac722854a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161541/selection/404ed290384d69ada0e463c40eb6f1300038b2eb5e54126f497966f4c39c2046" :answer-field/choices ["q-161541/selection/5d157037d7c29f09096b9c397683686d65b758304acf3fda933b0ebc9e6efa59" "q-161541/selection/3f2c3d5bde4626c6498cfbc42f464872ad2e593f78a6c7e9afd75ba227d96e27" "q-161541/selection/bfba4f36c28697d76ab9bea5db62e07018427c7b4d40d936001889b3614c90dc" "q-161541/selection/32860d1508b9e39b3e802bb7deeb931ecdfa11505f5d22d1a7af155b95e09e01" "q-161541/selection/404ed290384d69ada0e463c40eb6f1300038b2eb5e54126f497966f4c39c2046"] :db/ensure [:answer-field/validate]} {:db/id "q-161541" :question/id #uuid "c65e1ef4-e971-501b-8625-feef09c152dd" :question/math-academy-id "q-161541" :question/problem "Calculate the flux of the vector field\n\n$$\nF(x,y,z)=⟨\\sqrt{\\frac{x}{y}},\\,\\sqrt{\\frac{x}{y}},\\,{z}^{2}+1⟩,\n$$\n\nwhere the surface $S$ is defined by $z=2\\sqrt{xy}$ for $3\\le x\\le 4$ and $1\\le y\\le 2.$" :question/worked-solution "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(2\\sqrt{xy})=\\sqrt{\\frac{y}{x}} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(2\\sqrt{xy})=\\sqrt{\\frac{x}{y}}\\end{aligned}\n$$\n\nIn this case, the flux of $F$ through $S$ is given by \n\n$$\n{∬}_{S}⟨\\sqrt{\\frac{x}{y}},\\,\\sqrt{\\frac{x}{y}},\\,{z}^{2}+1⟩\\cdot \\text{d}S\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨\\sqrt{\\frac{x}{y}},\\,\\sqrt{\\frac{x}{y}},\\,{z}^{2}+1⟩{|}_{z=2\\sqrt{xy}} \\\\  & =⟨{{\\sqrt{\\frac{x}{y}}}_{⏟}}_{P},\\,{{\\sqrt{\\frac{x}{y}}}_{⏟}}_{Q},\\,{{4xy+1}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨\\sqrt{\\frac{x}{y}},\\,\\sqrt{\\frac{x}{y}},\\,{z}^{2}+1⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-\\sqrt{\\frac{x}{y}}\\cdot \\sqrt{\\frac{y}{x}}-\\sqrt{\\frac{x}{y}}\\cdot \\sqrt{\\frac{x}{y}}+4xy+1)\\,\\text{d}A \\\\  & ={∬}_{D}(-1-\\frac{x}{y}+4xy+1)\\,\\text{d}A \\\\  & ={∬}_{D}(-\\frac{x}{y}+4xy)\\,\\text{d}A \\\\  & ={\\int }_{3}^{4}{\\int }_{1}^{2}(-\\frac{x}{y}+4xy)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}{[-x\\operatorname{ln}⁡y+2x{y}^{2}]}_{y=1}^{y=2}\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}(-x\\operatorname{ln}⁡2+8x+0-2x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}(6-\\operatorname{ln}⁡2)x\\,\\text{d}x \\\\  & =(6-\\operatorname{ln}⁡2){[\\frac{{x}^{2}}{2}]}_{3}^{4} \\\\  & =\\frac{7(6-\\operatorname{ln}⁡2)}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161541/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aaa6b152-86d3-5f96-8a94-57f86a17a84d"] :knowledge-point/questions ["q-161541"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161552/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" :answer/id #uuid "f5c11cb1-acad-5672-8c46-4055348e1439" :answer/type :answer.type/math :answer/value "-8" :db/ensure [:answer/validate]} {:db/id "q-161552/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "b881d85f-cd3d-501d-9f3d-3495a903a0c6" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-161552/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer/id #uuid "7eb8efcf-3964-5c1b-b353-0427b05f8c74" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-161552/selection/95c393685f82efe05ce58fc07554851561d61659fa09076d238e849d9023f203" :answer/id #uuid "81237a2b-a008-5b97-a92e-1d25a45f6fa0" :answer/type :answer.type/math :answer/value "-\\frac{8}{3}" :db/ensure [:answer/validate]} {:db/id "q-161552/selection/77332d6a2127b8769eed8978ed6ca15eac39efa56adcd443bcf8a5b233adfe4f" :answer/id #uuid "fd502819-c5ac-5e05-b914-e33f68a4eee8" :answer/type :answer.type/math :answer/value "-\\frac{10}{3}" :db/ensure [:answer/validate]} {:db/id "q-161552/selection" :answer-field/id #uuid "3864bd0f-f05f-53f7-a736-3520035541f7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161552/selection/95c393685f82efe05ce58fc07554851561d61659fa09076d238e849d9023f203" :answer-field/choices ["q-161552/selection/34d6a116cfea25ad11008d41d6152ee565691a4dc671039515875488f5520d96" "q-161552/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-161552/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" "q-161552/selection/95c393685f82efe05ce58fc07554851561d61659fa09076d238e849d9023f203" "q-161552/selection/77332d6a2127b8769eed8978ed6ca15eac39efa56adcd443bcf8a5b233adfe4f"] :db/ensure [:answer-field/validate]} {:db/id "q-161552" :question/id #uuid "c3d8ac87-3067-5a70-a085-ecb28a8bc772" :question/math-academy-id "q-161552" :question/problem "Calculate the flux of the vector field\n\n$$\nF(x,y,z)=⟨3{x}^{3}y,\\,2yz,\\,2x(y+z)⟩,\n$$\n\nwhere the surface $S$ is defined by $z=2x+y$ for $0\\le x\\le 2$ and $0\\le y\\le 1.$" :question/worked-solution "For a surface $S$ given by $z=g(x,y)$ for $(x,y)\\in D,$ the flux of a vector field $F(x,y,z)=⟨P,\\,Q,\\,R⟩$ over $S$ is given by\n\n$$\n{∬}_{S}F\\cdot \\text{d}S={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A.\n$$\n\nWe first compute the partial derivatives of the graph $z=g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(2x+y)=2 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(2x+y)=1\\end{aligned}\n$$\n\nIn this case, the flux of $F$ through $S$ is given by \n\n$$\n{∬}_{S}⟨3{x}^{3}y,\\,2yz,\\,2x(y+z)⟩\\cdot \\text{d}S\n$$\n\nNext, we substitute the equation $z=g(x,y)$ into $F(x,y,z):$\n\n$$\n\\begin{aligned}F(x,y,g(x,y)) & =⟨3{x}^{3}y,\\,2yz,\\,2xz⟩{|}_{z=2x+y} \\\\ F(x,y,g(x,y)) & =⟨3{x}^{3}y,\\,2y(2x+y),\\,2x(y+2x+y)⟩{|}_{z=2x+y} \\\\  & =⟨{{3{x}^{3}y}_{⏟}}_{P},\\,{{4xy+2{y}^{2}}_{⏟}}_{Q},\\,{{4xy+4{x}^{2}}_{⏟}}_{R}⟩\\end{aligned}\n$$\n\nTherefore, we can evaluate our surface integral as follows:\n\n$$\n\\begin{aligned}{∬}_{S}⟨3{x}^{3}y,\\,2yz,\\,2x(y+z)⟩\\cdot \\text{d}S & ={∬}_{D}(-P\\frac{∂g}{∂x}-Q\\frac{∂g}{∂y}+R)\\text{d}A \\\\  & ={∬}_{D}(-(3{x}^{3}y)\\cdot (2)-(4xy+2{y}^{2})\\cdot (1)+4xy+4{x}^{2})\\,\\text{d}A \\\\  & ={∬}_{D}(-6{x}^{3}y-2{y}^{2}+4{x}^{2})\\,\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(-6{x}^{3}y-2{y}^{2}+4{x}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{[-3{x}^{3}{y}^{2}-\\frac{2{y}^{3}}{3}+4{x}^{2}y]}_{0}^{1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(-3{x}^{3}-\\frac{2}{3}+4{x}^{2})\\,\\text{d}x \\\\  & ={[-\\frac{3{x}^{4}}{4}-\\frac{2x}{3}+\\frac{4{x}^{3}}{3}]}_{0}^{2} \\\\  & =-12-\\frac{4}{3}+\\frac{32}{3} \\\\  & =-\\frac{8}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161552/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aaa6b152-86d3-5f96-8a94-57f86a17a84d"] :knowledge-point/questions ["q-161552"] :db/ensure [:knowledge-point/validate]}]
