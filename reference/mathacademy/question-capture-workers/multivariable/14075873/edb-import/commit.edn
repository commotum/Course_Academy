}^{2} \\\\  & =-12-\\frac{4}{3}+\\frac{32}{3} \\\\  & =-\\frac{8}{3}\\end{aligned}\n$$" 13194139536075 true] [17592186382524 1000 #edb/ref 17592186382525 13194139536075 true] [17592186382524 1000 #edb/ref 17592186382526 13194139536075 true] [17592186382524 1000 #edb/ref 17592186382527 13194139536075 true] [17592186382524 1000 #edb/ref 17592186382528 13194139536075 true] [17592186382524 1000 #edb/ref 17592186382529 13194139536075 true] [17592186382524 1040 #edb/ref 17592186045450 13194139536075 true] [17592186382524 1041 "selection" 13194139536075 true] [17592186382524 1104 #edb/ref 17592186382527 13194139536075 true] [17592186382524 1110 #uuid "3864bd0f-f05f-53f7-a736-3520035541f7" 13194139536075 true] [17592186382525 1034 "-8" 13194139536075 true] [17592186382525 1103 #edb/ref 17592186045453 13194139536075 true] [17592186382525 1111 #uuid "f5c11cb1-acad-5672-8c46-4055348e1439" 13194139536075 true] [17592186382526 1034 "-\\frac{10}{3}" 13194139536075 true] [17592186382526 1103 #edb/ref 17592186045453 13194139536075 true] [17592186382526 1111 #uuid "fd502819-c5ac-5e05-b914-e33f68a4eee8" 13194139536075 true] [17592186382527 1034 "-\\frac{8}{3}" 13194139536075 true] [17592186382527 1103 #edb/ref 17592186045453 13194139536075 true] [17592186382527 1111 #uuid "81237a2b-a008-5b97-a92e-1d25a45f6fa0" 13194139536075 true] [17592186382528 1034 "\\frac{7}{3}" 13194139536075 true] [17592186382528 1103 #edb/ref 17592186045453 13194139536075 true] [17592186382528 1111 #uuid "7eb8efcf-3964-5c1b-b353-0427b05f8c74" 13194139536075 true] [17592186382529 1034 "-2" 13194139536075 true] [17592186382529 1103 #edb/ref 17592186045453 13194139536075 true] [17592186382529 1111 #uuid "b881d85f-cd3d-501d-9f3d-3495a903a0c6" 13194139536075 true]] :edb/tempids {"q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73" 17592186382496 "q-161166/selection/ma-v1/58c5c037874e2e83e3eb45ad173e1b3598499f28e6bcc31d8afd497a3bfbec73/0268646bd09f6f0dda6364f10a56beadf51693d23f