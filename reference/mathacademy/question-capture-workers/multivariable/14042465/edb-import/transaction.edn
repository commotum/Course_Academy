be-8bda-af067b0df37e" :question/math-academy-id "q-36108" :question/problem "${lim}_{x\\to (-1,1,0)}\\frac{{x}^{2}+yz+{z}^{2}}{{x}^{2}-xy+xz-yz}=$" :question/worked-solution "The function \n\n$$\nf(x,y,z)=\\frac{{x}^{2}+yz+{z}^{2}}{{x}^{2}-xy+xz-yz}\n$$\n\nis continuous except when the denominator is zero. However, the point $(-1,1,0)$ does not cause the denominator to become zero, so we can calculate the limit by substituting  $(-1,1,0)$ into the function:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1,0)}\\frac{{x}^{2}+yz+{z}^{2}}{{x}^{2}-xy+xz-yz} & =\\frac{(-1)^{2}+(1)(0)+(0)^{2}}{(-1)^{2}-(-1)(1)+(-1)(0)-(1)(0)} \\\\  & =\\frac{1+0+0}{1+1+0-0} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36108/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1f2ac99b-55b2-5742-81ab-d2961db1250f"] :knowledge-point/questions ["q-36108"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129322/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "367f0af2-d240-52cc-9dc8-774c74214613" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-129322/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "5e24b156-b156-5f3e-abeb-a2fcb2d2b2c8" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-129322/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "0c0e8ac9-634d-5d62-8a1e-7db4b9436ac2" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-129322/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "4e613dc0-f2f7-58cc-b45c-b027c6f30f2b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-129322/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f