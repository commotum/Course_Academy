{x\\to (-2,4)}\\sqrt[3]{xy}=\\sqrt{(-2)\\cdot 4}=\\sqrt[3]{-8}=-2\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74912/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1f2ac99b-55b2-5742-81ab-d2961db1250f"] :knowledge-point/questions ["q-74912"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129332/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "67d1b8c3-35e6-52cf-9305-3451e13ecf6c" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-129332/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3032877d-6e22-5b69-8e5a-4c30f0690dad" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129332/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "94153e33-9831-5b84-891e-f08a78f90bdf" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-129332/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "be49af45-eb51-5569-8959-b5cf989e7a92" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-129332/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "e202b999-4d91-5745-9d67-f265fca08fe1" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-129332/selection" :answer-field/id #uuid "e8206484-df2b-5b6e-8600-02a1b57b6b26" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129332/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-129332/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-129332/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-129332/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-129332/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-129332/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-129332" :question/id #uuid "d8bd1edb-6522-5fc2-913a-8539c7fccaee" :question/math-academy-id "q-129332" :question/problem "Find ${lim}_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}} & =\\frac{(-1)(2)+1(2)}{(-1)^{2}-{1}^{2}} \\\\  & =\\frac{-2+2}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1,2)}\\frac{xz+yz}{{x}^{2}-{y}^{2}} & ={lim}_{x\\to (-1,1,2)}\\frac{z(x+y)}{(x+y)(x-y)} \\\\  & ={lim}_{x\\to (-1,1,2)}\\frac{z\\cancel{(x+y)}}{\\cancel{(x+y)}(x-y)} \\\\  & ={lim}_{x\\to (-1,1,2)}\\frac{z}{x-y}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1,2)}\\frac{z}{x-y} & =\\frac{2}{-1-1} \\\\  & =\\frac{2}{(-2)} \\\\  & =-1\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129332/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42"] :knowledge-point/questions ["q-129332"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74952/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "58667621-fc45-5733-ad01-8f4cf58bccf8" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-74952/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "f2f79e09-9635-51a5-8448-4332fa81d372" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-74952/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "16a48cfc-2c20-50da-b9f5-03734c029ecd" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74952/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "e3257c10-8cdd-5eae-8a29-2dab093ff5bc" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-74952/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "d5165c9b-7a8a-5914-b15f-1e54b26f20d4" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-74952/selection" :answer-field/id #uuid "b60bdedf-738a-5f0f-a06d-1e0d0ce7b04b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74952/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-74952/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-74952/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-74952/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-74952/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" "q-74952/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-74952" :question/id #uuid "c00255c1-b43f-541c-9a67-c83b1ddf6f8c" :question/math-academy-id "q-74952" :question/problem "Find  ${lim}_{x\\to (-1,1)}\\frac{{x}^{2}+2xy+{y}^{2}}{{y}^{2}-{x}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (-1,1)}\\frac{{x}^{2}+2xy+{y}^{2}}{{y}^{2}-{x}^{2}}=\\frac{(-1)^{2}+2\\cdot (-1)\\cdot 1+{1}^{2}}{{1}^{2}-(-1)^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1)}\\frac{{x}^{2}+2xy+{y}^{2}}{{y}^{2}-{x}^{2}} & ={lim}_{x\\to (-1,1)}\\frac{(x+y)^{2}}{(y-x)(y+x)} \\\\  & ={lim}_{x\\to (-1,1)}\\frac{(x+y)(x+y)}{(y-x)(x+y)} \\\\  & ={lim}_{x\\to (-1,1)}\\frac{x+y}{y-x}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1)}\\frac{x+y}{y-x} & =\\frac{(-1)+1}{1-(-1)} \\\\  & =\\frac{0}{2} \\\\  & =0\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74952/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42"] :knowledge-point/questions ["q-74952"] :db/ensure [:knowledge-point/validate]} {:db/id "q-35956/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "2d5d878b-7ccd-504d-bdc6-9124c7e429a7" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-35956/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "3697c5cc-4c70-504d-8940-f0a23fe8ef76" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-35956/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "3a3e5458-a2c0-5000-a4df-5e6ecfdaeb92" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-35956/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "b326d666-d131-5a13-b409-b5cf824fa17f" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-35956/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "dd6c1d6f-fb9c-57e9-a70d-ec0592f0cb72" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-35956/selection" :answer-field/id #uuid "7c68e877-133f-51a4-97d7-0865024a3c94" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35956/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer-field/choices ["q-35956/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-35956/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-35956/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-35956/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-35956/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81"] :db/ensure [:answer-field/validate]} {:db/id "q-35956" :question/id #uuid "55596b54-33a3-5062-81fe-5d7982b1999d" :question/math-academy-id "q-35956" :question/problem "${lim}_{(x,y,z)\\to (1,-1,1)}\\frac{2{x}^{2}+xy-{y}^{2}}{z{x}^{2}-z{y}^{2}}=$" :question/worked-solution "Unfortunately, this limit takes the indeterminate form because the numerator and denominator both evaluate to zero at the given point:\n\n$$\n{lim}_{(x,y,z)\\to (1,-1,1)}\\frac{2{x}^{2}+xy-{y}^{2}}{z{x}^{2}-z{y}^{2}}=\\frac{2\\cdot {1}^{2}+1\\cdot (-1)-(-1)^{2}}{1\\cdot {1}^{2}-1\\cdot (-1)^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{(x,y,z)\\to (1,-1,1)}\\frac{2{x}^{2}+xy-{y}^{2}}{z{x}^{2}-z{y}^{2}} & ={lim}_{(x,y,z)\\to (1,-1,1)}\\frac{2{x}^{2}+2xy-xy-{y}^{2}}{z({x}^{2}-{y}^{2})} \\\\  & ={lim}_{(x,y,z)\\to (1,-1,1)}\\frac{2x(x+y)-y(x+y)}{z(x+y)(x-y)} \\\\  & ={lim}_{(x,y,z)\\to (1,-1,1)}\\frac{(2x-y)(x+y)}{z(x+y)(x-y)} \\\\  & ={lim}_{(x,y,z)\\to (1,-1,1)}\\frac{2x-y}{z(x-y)}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{(x,y,z)\\to (1,-1,1)}\\frac{2x-y}{z(x-y)} & =\\frac{2(1)-(-1)}{1(1-(-1))} \\\\  & =\\frac{3}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{3}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-35956/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42"] :knowledge-point/questions ["q-35956"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129335/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "b82d2154-a143-5949-b919-c6171e60be3d" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-129335/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "a375d288-caa2-5fe3-ba57-afdb509d8f28" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-129335/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "039139d6-3863-589d-a57e-e00d46b79bd2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129335/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "eca7444e-a50d-5948-afa3-61ffa4828358" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-129335/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "32dc1ec0-f7fe-56cd-8b45-ff7b6db19dd8" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-129335/selection" :answer-field/id #uuid "08e5b09e-79d3-555b-b694-c46828149e88" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129335/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-129335/selection/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" "q-129335/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-129335/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-129335/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-129335/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-129335" :question/id #uuid "70ef35a4-44c9-5fae-8567-f69f8501178b" :question/math-academy-id "q-129335" :question/problem "Determine ${lim}_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}} & =\\frac{{2}^{3}-3({2}^{2})(2)+3(2)({2}^{2})-{2}^{3}}{{2}^{2}-2(2)(2)+{2}^{2}} \\\\  & =\\frac{8-24+24-8}{4-8+4} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2)}\\frac{{x}^{3}-3{x}^{2}y+3x{y}^{2}-{y}^{3}}{{x}^{2}-2xy+{y}^{2}} & ={lim}_{x\\to (2,2)}\\frac{(x-y)^{3}}{(x-y)^{2}} \\\\  & ={lim}_{x\\to (2,2)}\\frac{(x-y)(x-y)^{2}}{(x-y)^{2}} \\\\  & ={lim}_{x\\to (2,2)}\\frac{(x-y)\\cancel{(x-y)^{2}}}{\\cancel{(x-y)^{2}}} \\\\  & ={lim}_{x\\to (2,2)}(x-y)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,2)}(x-y) & =2-2=0\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $0.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-129335/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42"] :knowledge-point/questions ["q-129335"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74918/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "08bc8a81-2db7-5de6-9bc3-f1237177e49c" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74918/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "d6869a31-1c84-5bd2-bc49-3bdc64d8524f" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74918/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "10252635-3a52-5b75-b241-974037c3478b" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74918/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "f6510986-eef2-5e84-867d-7e79eb16bc61" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-74918/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "9f7d56c3-14f8-5094-b249-d7edc0bc0b89" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-74918/selection" :answer-field/id #uuid "794d2f73-99f5-59dd-9bf5-544c1c110f5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74918/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-74918/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-74918/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-74918/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-74918/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-74918/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-74918" :question/id #uuid "deb2adb5-ecfa-59f5-a026-bcec3ebdb40f" :question/math-academy-id "q-74918" :question/problem "Find  ${lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz}=\\frac{1\\cdot {2}^{2}-1\\cdot {2}^{2}}{1\\cdot 2-1\\cdot 2}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1,2)}\\frac{x{z}^{2}-y{z}^{2}}{yz-xz} & ={lim}_{x\\to (1,1,2)}\\frac{(x-y){z}^{2}}{(y-x)z} \\\\  & ={lim}_{x\\to (1,1,2)}-\\frac{(x-y){z}^{2}}{(x-y)z} \\\\  & ={lim}_{x\\to (1,1,2)}(-z)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it using direct substitution:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1,2)}(-z) & =-2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-2.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74918/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5666035-199d-56aa-a6f4-f65a3f847b42"] :knowledge-point/questions ["q-74918"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74957/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "1ff860ff-2f02-5bd2-b5d8-a199b57f778d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74957/selection/f3f015f7bf164eadf2b2d92252a28c37b91b15d299981e3564221776c934dc48" :answer/id #uuid "2962d9c3-e927-50da-be19-9c5eaeae8be2" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id "q-74957/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "256a9d7c-c1eb-5184-a093-fc6d25bf1bbb" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-74957/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "151c7acd-ed5f-5c36-bd84-7d719e44679c" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-74957/selection/3e8a5589ce5011f03552e43cb7097b504a00f368ae7b8c60f803f1c8ee3e34ab" :answer/id #uuid "d25e93c7-512e-5476-80a5-0c9834f12d1d" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{3}}" :db/ensure [:answer/validate]} {:db/id "q-74957/selection" :answer-field/id #uuid "07c29856-0371-57af-83a1-c0d8f80b1696" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74957/selection/3e8a5589ce5011f03552e43cb7097b504a00f368ae7b8c60f803f1c8ee3e34ab" :answer-field/choices ["q-74957/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-74957/selection/f3f015f7bf164eadf2b2d92252a28c37b91b15d299981e3564221776c934dc48" "q-74957/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" "q-74957/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-74957/selection/3e8a5589ce5011f03552e43cb7097b504a00f368ae7b8c60f803f1c8ee3e34ab"] :db/ensure [:answer-field/validate]} {:db/id "q-74957" :question/id #uuid "deda2e5d-44c0-50de-ba98-e7bf413e3a06" :question/math-academy-id "q-74957" :question/problem "${lim}_{x\\to (3,1)}\\frac{\\sqrt{x}-\\sqrt{y+2}}{x-y-2}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (3,1)}\\frac{\\sqrt{x}-\\sqrt{y+2}}{x-y-2}=\\frac{\\sqrt{3}-\\sqrt{1+2}}{3-1-2}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator: \n\n$$\n\\begin{aligned}{lim}_{x\\to (3,1)}\\frac{\\sqrt{x}-\\sqrt{y+2}}{x-y-2} & ={lim}_{x\\to (3,1)}\\frac{(\\sqrt{x}-\\sqrt{y+2})(\\sqrt{x}+\\sqrt{y+2})}{(x-y-2)(\\sqrt{x}+\\sqrt{y+2})} \\\\  & ={lim}_{x\\to (3,1)}\\frac{(\\sqrt{x})^{2}-(\\sqrt{y+2})^{2}}{(x-y-2)(\\sqrt{x}+\\sqrt{y+2})} \\\\  & ={lim}_{x\\to (3,1)}\\frac{x-y-2}{(x-y-2)(\\sqrt{x}+\\sqrt{y+2})} \\\\  & ={lim}_{x\\to (3,1)}\\frac{1}{\\sqrt{x}+\\sqrt{y+2}}\\end{aligned}\n$$\n\n \n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (3,1)}\\frac{1}{\\sqrt{x}+\\sqrt{y+2}} & =\\frac{1}{\\sqrt{3}+\\sqrt{1+2}} \\\\  & =\\frac{1}{\\sqrt{3}+\\sqrt{3}} \\\\  & =\\frac{1}{2\\sqrt{3}}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2\\sqrt{3}}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74957/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb"] :knowledge-point/questions ["q-74957"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74958/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "0b1eb3ad-6fe7-539e-a79e-029645e63b2d" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-74958/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "52dae356-b2bb-5e01-8e1c-87e8cbf54e90" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-74958/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" :answer/id #uuid "1ca217c6-48d8-5945-9865-6c568b35a2e7" :answer/type :answer.type/math :answer/value "-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-74958/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "0812dda3-6276-5eb3-b82d-e032879c86dc" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-74958/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9" :answer/id #uuid "65cd0dd7-64c0-58cb-92fe-9751bb07cb25" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-74958/selection" :answer-field/id #uuid "e49734f7-cd83-5b67-ba18-e0e71e066305" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74958/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-74958/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-74958/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-74958/selection/df4ef3a75f6d71027299791921d9536d50890079e16123ff435f8ed8ac6150b0" "q-74958/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-74958/selection/e014eef6d5b5b99f76a63badf4d7e4589d1524a951e6f15c41809dcf478e3da9"] :db/ensure [:answer-field/validate]} {:db/id "q-74958" :question/id #uuid "c7afe349-e2eb-5064-9031-6f2bdf6ea12e" :question/math-academy-id "q-74958" :question/problem "${lim}_{x\\to (1,1)}\\frac{\\sqrt{x}-y}{x-{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (1,1)}\\frac{\\sqrt{x}-y}{x-{y}^{2}}=\\frac{\\sqrt{1}-1}{1-{1}^{2}}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator: \n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1)}\\frac{\\sqrt{x}-y}{x-{y}^{2}} & ={lim}_{x\\to (1,1)}\\frac{(\\sqrt{x}-y)(\\sqrt{x}+y)}{(x-{y}^{2})(\\sqrt{x}+y)} \\\\  & ={lim}_{x\\to (1,1)}\\frac{(\\sqrt{x})^{2}-{y}^{2}}{(x-{y}^{2})(\\sqrt{x}+y)} \\\\  & ={lim}_{x\\to (1,1)}\\frac{x-{y}^{2}}{(x-{y}^{2})(\\sqrt{x}+y)} \\\\  & ={lim}_{x\\to (1,1)}\\frac{1}{\\sqrt{x}+y}\\end{aligned}\n$$\n\n \n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1)}\\frac{1}{\\sqrt{x}+y} & =\\frac{1}{\\sqrt{1}+1} \\\\  & =\\frac{1}{1+1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74958/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb"] :knowledge-point/questions ["q-74958"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129346/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "976570c1-6cfe-57dd-9e1f-62554c51cdf5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129346/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "7a96965a-da12-58e6-9c48-c23054111307" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-129346/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "2cf8a4c4-324b-5bb3-8bc7-4652581f22d9" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-129346/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "8a9e8066-5bfe-5f20-a11f-61b5d08c0835" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-129346/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "74895c71-2935-5bde-858c-3d4dedf1882d" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-129346/selection" :answer-field/id #uuid "33d25667-e284-58be-bb98-5b7e6f28de6b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129346/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-129346/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-129346/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-129346/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-129346/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-129346/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-129346" :question/id #uuid "045f5f9b-4b8b-5043-84f1-251aa8dc17e0" :question/math-academy-id "q-129346" :question/problem "Find ${lim}_{x\\to (1,0,1)}\\frac{x+y-{z}^{2}}{\\sqrt{x+y}-z}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (1,0,1)}\\frac{x+y-{z}^{2}}{\\sqrt{x+y}-z} & =\\frac{1+0-{1}^{2}}{\\sqrt{1+0}-1} \\\\  & =\\frac{1+0-1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,0,1)}\\frac{x+y-{z}^{2}}{\\sqrt{x+y}-z} & ={lim}_{x\\to (1,0,1)}\\frac{(x+y-{z}^{2})(\\sqrt{x+y}+z)}{(\\sqrt{x+y}-z)(\\sqrt{x+y}+z)} \\\\  & ={lim}_{x\\to (1,0,1)}\\frac{(x+y-{z}^{2})(\\sqrt{x+y}+z)}{x+y-{z}^{2}} \\\\  & ={lim}_{x\\to (1,0,1)}\\frac{\\cancel{(x+y-{z}^{2})}(\\sqrt{x+y}+z)}{\\cancel{x+y-{z}^{2}}} \\\\  & ={lim}_{x\\to (1,0,1)}(\\sqrt{x+y}+z)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,0,1)}(\\sqrt{x+y}+z) & =\\sqrt{1+0}+1 \\\\  & =1+0+1 \\\\  & =2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $2.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-129346/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb"] :knowledge-point/questions ["q-129346"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129345/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "019dbff6-8b5e-525b-b366-a9e9d857d97d" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129345/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "478fd6b7-2ff4-5829-8186-897d84b37dc6" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-129345/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "cf87dde7-ba94-5ff0-8325-52373a12315c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-129345/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "0359dbef-1e44-5943-8656-236bc7d799c1" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-129345/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "262c0fc9-8d48-5f96-bbdd-4a3f49ac4401" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-129345/selection" :answer-field/id #uuid "5682706b-1b97-5f51-b331-9241ca284484" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129345/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-129345/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-129345/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-129345/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-129345/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-129345/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-129345" :question/id #uuid "7b1c8256-d336-5d99-a779-e4db03f98e76" :question/math-academy-id "q-129345" :question/problem "${lim}_{x\\to (1,2,-1)}\\frac{x\\sqrt{y+z}-1}{{x}^{2}(y+z)-1}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n\\begin{aligned}{lim}_{x\\to (1,2,-1)}\\frac{x\\sqrt{y+z}-1}{{x}^{2}(y+z)-1} & =\\frac{1\\sqrt{2+(-1)}-1}{({1}^{2})(2+(-1))-1} \\\\  & =\\frac{1-1}{1-1} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the numerator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,2,-1)}\\frac{x\\sqrt{y+z}-1}{{x}^{2}(y+z)-1} & ={lim}_{x\\to (1,2,-1)}\\frac{(x\\sqrt{y+z}-1)(x\\sqrt{y+z}+1)}{({x}^{2}(y+z)-1)(x\\sqrt{y+z}+1)} \\\\  & ={lim}_{x\\to (1,2,-1)}\\frac{{x}^{2}(y+z)-1}{({x}^{2}(y+z)-1)(x\\sqrt{y+z}+1)} \\\\  & ={lim}_{x\\to (1,2,-1)}\\frac{\\cancel{{x}^{2}(y+z)-1}}{\\cancel{({x}^{2}(y+z)-1)}(x\\sqrt{y+z}+1)} \\\\  & ={lim}_{x\\to (1,2,-1)}\\frac{1}{x\\sqrt{y+z}+1}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,2,-1)}\\frac{1}{x\\sqrt{y+z}+1} & =\\frac{1}{1\\sqrt{2+(-1)}+1} \\\\  & =\\frac{1}{1+1} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-129345/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb"] :knowledge-point/questions ["q-129345"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74960/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "831ea746-cf09-5a14-a944-b6adb9d952b9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-74960/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "9d055cc0-e0f2-5dc4-8158-6b1d8d851af0" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-74960/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "11e3da7c-313e-576f-8659-06c632f36726" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-74960/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "a4d57108-5c2a-5bcc-ac88-2a04c6b283f3" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-74960/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "c91bf717-594a-5b4b-bb56-bf3203d9a93c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-74960/selection" :answer-field/id #uuid "debbafbb-97d4-5266-9ab3-2c48d5e94443" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74960/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-74960/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-74960/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-74960/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-74960/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-74960/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-74960" :question/id #uuid "5515b01e-12c6-5c9f-8197-c489b4b2f853" :question/math-academy-id "q-74960" :question/problem "${lim}_{x\\to (1,1)}\\frac{{y}^{2}-x}{\\sqrt{x}-y}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{x\\to (1,1)}\\frac{{y}^{2}-x}{\\sqrt{x}-y}=\\frac{{1}^{2}-1}{\\sqrt{1}-1}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1)}\\frac{{y}^{2}-x}{\\sqrt{x}-y} & ={lim}_{x\\to (1,1)}\\frac{({y}^{2}-x)(\\sqrt{x}+y)}{(\\sqrt{x}-y)(\\sqrt{x}+y)} \\\\  & ={lim}_{x\\to (1,1)}\\frac{({y}^{2}-x)(\\sqrt{x}+y)}{{(\\sqrt{x})}^{2}-{y}^{2}} \\\\  & ={lim}_{x\\to (1,1)}\\frac{-(x-{y}^{2})(\\sqrt{x}+y)}{x-{y}^{2}} \\\\  & ={lim}_{x\\to (1,1)}-(\\sqrt{x}+y)\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (1,1)}-(\\sqrt{x}+y) & =-(\\sqrt{1}+1) \\\\  & =-(1+1) \\\\  & =-2\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $-2.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74960/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d53554f-6d77-56f9-8950-d8e31a7f4fdb"] :knowledge-point/questions ["q-74960"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129405/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "5cbfb4b8-a179-5e00-b48e-dad3615cd542" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-129405/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "6d4738e4-2d35-5531-b183-dbde0e415255" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-129405/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "5cd55b1d-98da-5381-93a2-64f6fcb07592" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-129405/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "5fb14ece-6d47-5d19-b227-b2bebb26dedc" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-129405/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "b13a23a3-44bd-5c62-8a5e-06552f88d23b" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-129405/selection" :answer-field/id #uuid "9028a2e5-c466-504a-a3b9-55e0b6cd9b16" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129405/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-129405/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-129405/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-129405/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-129405/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-129405/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23"] :db/ensure [:answer-field/validate]} {:db/id "q-129405" :question/id #uuid "992fc28b-32fb-5228-941a-ed4fb7e06230" :question/math-academy-id "q-129405" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}}\n$$\n\n- The limit evaluates to $2$ along the path $y=0$\n- The limit evaluates to $\\frac{1}{3}$ along the path $y=x$\n- The limit does not exist" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}} & =\\frac{2({0}^{2})-{0}^{2}}{{0}^{2}+2({0}^{2})} \\\\  & =\\frac{0-0}{0+0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is true. Taking $x\\to (0,0)$ along the path $y=0,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=0}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}-{0}^{2}}{{x}^{2}+2({0}^{2})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2\\cancel{{x}^{2}}}{\\cancel{{x}^{2}}} \\\\  & ={lim}_{x\\to 0}2 \\\\  & =2.\\end{aligned}\n$$\n\n- Statement II is also true. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}} & ={lim}_{x\\to 0}\\frac{2{x}^{2}-{x}^{2}}{{x}^{2}+2{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{3{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{\\cancel{{x}^{2}}}{3\\cancel{{x}^{2}}} \\\\  & ={lim}_{x\\to 0}\\frac{1}{3} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\n- Statement III is true. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}-{y}^{2}}{{x}^{2}+2{y}^{2}}=\\text{DNE}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129405/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed"] :knowledge-point/questions ["q-129405"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-35953"] :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\frac{xy-x{y}^{2}}{{x}^{2}+2xy}\n$$\n\n- The limit evaluates to $1$ along the path $y=x$\n- The limit evaluates to $1$ along the path $y=-x$\n- The limit exists and is equal to $1$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\frac{xy-x{y}^{2}}{{x}^{2}+2xy}=\\frac{0\\cdot 0-0\\cdot {0}^{2}}{{0}^{2}+2\\cdot 0\\cdot 0}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is false. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\frac{xy-x{y}^{2}}{{x}^{2}+2xy} & ={lim}_{x\\to 0}\\frac{x(x)-x(x)^{2}}{{x}^{2}+2x(x)} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}-{x}^{3}}{3{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{1-x}{3} \\\\  & =\\frac{1-0}{3} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$\n\n- Statement II is true. Taking $x\\to (0,0)$ along the path $y=-x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=-x}\\frac{xy-x{y}^{2}}{{x}^{2}+2xy} & ={lim}_{x\\to 0}\\frac{x(-x)-x(-x)^{2}}{{x}^{2}+2x(-x)} \\\\  & ={lim}_{x\\to 0}\\frac{-{x}^{2}-{x}^{3}}{-{x}^{2}} \\\\  & ={lim}_{x\\to 0}(1+x) \\\\  & =1+0 \\\\  & =1\\end{aligned}\n$$\n\n- Statement III is false. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\frac{xy-x{y}^{2}}{{x}^{2}+2xy}=\\text{DNE}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-129406/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "65ecc13d-fb8f-51fe-aa62-9d63c1897800" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-129406/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d681929b-2d3d-5fad-ae12-6844743c37cf" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-129406/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "6f97202e-f85d-583e-a998-343f49b512ca" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-129406/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "cc1ab11a-fd48-5281-adb7-4a86eaaa62ab" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-129406/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "0bccdb56-f030-5278-94ba-64bf2002cc7a" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-129406/selection" :answer-field/id #uuid "312d3f81-5efe-5b33-b33f-e374f491b619" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129406/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-129406/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-129406/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-129406/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-129406/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-129406/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-129406" :question/id #uuid "a90e0332-e1b9-53a3-9997-eb452aae53b8" :question/math-academy-id "q-129406" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}}\n$$\n\n- The limit evaluates to $0$ along the path $y=0$\n- The limit evaluates to $\\frac{2}{3}$ along the path $y=x$\n- The limit does not exist" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}} & =\\frac{2(0)(0)}{3({0}^{2})-{0}^{2}} \\\\  & =\\frac{0}{0-0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is true. Taking $x\\to (0,0)$ along the path $y=0,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=0}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2x(0)}{3({0}^{2})-{x}^{2}} \\\\  & ={lim}_{x\\to 0}0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}} & ={lim}_{x\\to 0}\\frac{2x(x)}{3{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{2{x}^{2}} \\\\  & ={lim}_{x\\to 0}1 \\\\  & =1\\end{aligned}\n$$\n\n- Statement III is true. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2xy}{3{y}^{2}-{x}^{2}}=\\text{DNE}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129406/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed"] :knowledge-point/questions ["q-129406"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129408/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "2228b70d-cb85-5cd1-b208-bc23eb77e0de" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-129408/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "805faf5e-bcb3-51b6-99fb-7e2fc2d8b62e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-129408/selection/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" :answer/id #uuid "db0c8f03-d8ce-54b2-b753-60714f07a497" :answer/type :answer.type/text :answer/value "I, II and III" :db/ensure [:answer/validate]} {:db/id "q-129408/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "36a9a2ac-f049-5202-8d04-9de84c178a1f" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-129408/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "d4cfa77f-eaaf-5de9-84d7-3154d44df423" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-129408/selection" :answer-field/id #uuid "a862cc66-0b94-5b94-ac5e-09b9be4d76f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129408/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-129408/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-129408/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-129408/selection/b1a9f2bb9f9bd59b66c906c9ab98446a26ec623744a7f92356bb121785f6cea5" "q-129408/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-129408/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-129408" :question/id #uuid "f853994f-4efa-5d5e-94f0-b353a0f03e36" :question/math-academy-id "q-129408" :question/problem "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}\\sqrt{y}}{{x}^{4}+{y}^{2}}\n$$\n\n- The limit evaluates to $4$ along the path $y={x}^{4}$\n- The limit evaluates to $0$ along the path $x=0$\n- The limit does not exist" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}\\sqrt{y}}{{x}^{4}+{y}^{2}} & =\\frac{2({0}^{2})\\sqrt{0}}{{0}^{4}+{0}^{2}} \\\\  & =\\frac{0}{0+0} \\\\  & =\\frac{0}{0}\\end{aligned}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is false. Taking $x\\to (0,0)$ along the path $y={x}^{4},$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y={x}^{4}}\\,\\frac{2{x}^{2}\\sqrt{y}}{{x}^{4}+{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}\\sqrt{{x}^{4}}}{{x}^{4}+({x}^{4})^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}\\cdot {x}^{2}}{{x}^{4}+{x}^{8}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2{x}^{4}}{{x}^{4}(1+{x}^{4})} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2\\cancel{{x}^{4}}}{\\cancel{{x}^{4}}(1+{x}^{4})} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2}{1+{x}^{4}} \\\\  & =\\frac{2}{1+{0}^{4}} \\\\  & =2.\\end{aligned}\n$$\n\n- Statement II is true. Taking $x\\to (0,0)$ along the path $x=0,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,x=0}\\,\\frac{2{x}^{2}\\sqrt{y}}{{x}^{4}+{y}^{2}} & ={lim}_{y\\to 0}\\frac{2({0}^{2})\\sqrt{y}}{{0}^{4}+{y}^{2}} \\\\  & ={lim}_{y\\to 0}0 \\\\  & =0.\\end{aligned}\n$$\n\n- Statement III is true. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}\\sqrt{y}}{{x}^{4}+{y}^{2}}=\\text{DNE}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129408/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed"] :knowledge-point/questions ["q-129408"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74966/selection/e3b46c3e63ee8ef5a071cd8ef5f7250114c0c6983477af061861d82a06039d46" :answer/id #uuid "e271d336-420b-53b3-b139-814c6286cd43" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "q-74966/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "85f49930-9771-562b-83be-3268dc6e4957" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-74966/selection/9c6bfb4db8d042ca3b93589c844ac1c789909e0099f428d8083546a00b4d8cf7" :answer/id #uuid "1ce1885d-06ee-54d4-b8a2-36cc7a89ec77" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "q-74966/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "5bb7fe0d-0657-51e9-a1b6-726fac786b8e" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-74966/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer/id #uuid "892f1a1d-d4ed-565d-b472-47ca6dc03a16" :answer/type :answer.type/math :answer/value "\\text{DNE}" :db/ensure [:answer/validate]} {:db/id "q-74966/selection" :answer-field/id #uuid "4975e055-0ada-511d-b3c3-a4efdc9a87f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74966/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81" :answer-field/choices ["q-74966/selection/e3b46c3e63ee8ef5a071cd8ef5f7250114c0c6983477af061861d82a06039d46" "q-74966/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-74966/selection/9c6bfb4db8d042ca3b93589c844ac1c789909e0099f428d8083546a00b4d8cf7" "q-74966/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-74966/selection/c5e624c1da93ecfedccf3fa70b8e1fb64de1e5d703dcc02fa7b4793f81a70f81"] :db/ensure [:answer-field/validate]} {:db/id "q-74966" :question/id #uuid "0f3c5608-8eb9-50e7-ad97-cfc0c456ce05" :question/math-academy-id "q-74966" :question/problem "${lim}_{x\\to (0,0)}\\,\\frac{2y{x}^{3}}{{x}^{6}+8{y}^{2}}=$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2y{x}^{3}}{{x}^{6}+8{y}^{2}}=\\frac{2\\cdot 0\\cdot {0}^{3}}{{0}^{6}+8\\cdot {0}^{2}}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nLet's attempt to evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2y{x}^{3}}{{x}^{6}+8{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{4}}{{x}^{6}+8{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2{x}^{4}}{{x}^{2}({x}^{4}+8)} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{{x}^{4}+8} \\\\  & =0.\\end{aligned}\n$$\n\n- Taking $x\\to (0,0)$ along the path $y={x}^{3},$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y={x}^{3}}\\,\\frac{2y{x}^{3}}{{x}^{6}+8{y}^{2}} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{6}}{{x}^{6}+8{x}^{6}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2{x}^{6}}{9{x}^{6}} \\\\  & ={lim}_{x\\to 0}\\,\\frac{2}{9} \\\\  & =\\frac{2}{9}.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2y{x}^{3}}{{x}^{6}+8{y}^{2}}=\\text{DNE}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-74966/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29610715-333d-5e0c-9328-eec1d45f56ed"] :knowledge-point/questions ["q-74966"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-3330"] :question/problem "Find  $\\displaystyle{\\lim_{\\mathbf{x}\\to (-1,2)}} \\dfrac{xy^3}{x+y}.$" :question/worked-solution "The function \n\n$$\nf(x,y)= \\dfrac{xy^3}{x+y}\n$$\n\nis continuous except when the denominator is zero. However, the point $(-1,2)$ does not cause the denominator to become zero, so we can calculate the limit by substituting  $(-1,2)$ into the function:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,2)}\\frac{x{y}^{3}}{x+y} & =\\frac{(-1)\\cdot {2}^{3}}{(-1)+2} \\\\  & =\\frac{-8}{1} \\\\  & =-8\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3331"] :question/problem "Find  $\\displaystyle{\\lim_{\\mathbf{x}\\to (-1,1)}} \\dfrac{x^2y+xy^2}{x^2-y^2}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\dfrac 0 0,$ as follows:\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (-1,1)}} \\dfrac{x^2y+xy^2}{x^2-y^2} = \\dfrac{(-1)^2(1) + (-1)(1)^2}{(-1)^2 - (1)^2} = \\dfrac{0}{0}\n$$\n\nHowever, we can simplify the limit by canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1)}\\frac{{x}^{2}y+x{y}^{2}}{{x}^{2}-{y}^{2}} & ={lim}_{x\\to (-1,1)}\\frac{xy(x+y)}{(x+y)(x-y)} \\\\  & ={lim}_{x\\to (-1,1)}\\frac{xy}{(x-y)}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (-1,1)}\\frac{xy}{(x-y)} & =\\frac{(-1)\\cdot 1}{-1-1} \\\\  & =\\frac{-1}{-2} \\\\  & =\\frac{1}{2}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\dfrac{1}{2}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6239"] :question/problem "Find  $\\displaystyle{\\lim_{\\mathbf{x}\\to (2,1)}} \\dfrac{x^2-4y}{x-2\\sqrt{y}}.$" :question/worked-solution "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\dfrac00,$ as follows: \n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (2,1)}} \\dfrac{2^2-4 \\cdot 1}{2-2\\sqrt{1}} = \\dfrac{0}{0}\n$$\n\nHowever, we can simplify the limit by first multiplying the numerator and denominator by the conjugate of the denominator:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,1)}\\frac{{x}^{2}-4y}{x-2\\sqrt{y}} & ={lim}_{x\\to (2,1)}\\frac{({x}^{2}-4y)(x+2\\sqrt{y})}{(x-2\\sqrt{y})(x+2\\sqrt{y})} \\\\  & ={lim}_{x\\to (2,1)}\\frac{({x}^{2}-4y)(x+2\\sqrt{y})}{{x}^{2}-(2\\sqrt{y})^{2}} \\\\  & ={lim}_{x\\to (2,1)}\\frac{({x}^{2}-4y)(x+2\\sqrt{y})}{{x}^{2}-4y} \\\\  & ={lim}_{x\\to (2,1)}(x+2\\sqrt{y})\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (2,1)}(x+2\\sqrt{y}) & =2+2\\sqrt{1} \\\\  & =2+2 \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $4.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3366"] :question/problem "Find  $\\displaystyle{\\lim_{\\mathbf{x}\\to (0,0)}} \\dfrac{x(x + 2y)}{y^2}.$" :question/worked-solution "Direct substitution gives an indeterminate form, but the function cannot be simplified by canceling a common factor in the numerator and denominator:\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (0,0)}} \\dfrac{x(x + 2y)}{y^2} = \\dfrac{0 \\cdot (0 + 2 \\cdot 0)}{0^2} = \\dfrac{0}{0}\n$$\n\nLet's evaluate the limit approaching $(0,0)$ from different paths.\n\n- Taking $\\mathbf{x} \\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\frac{x(x+2y)}{{y}^{2}} & ={lim}_{x\\to 0}\\frac{x(x+2x)}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{3{x}^{2}}{{x}^{2}} \\\\  & =3.\\end{aligned}\n$$\n\n- Taking $\\mathbf{x} \\to (0,0)$ along the path $y=-x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=-x}\\frac{x(x+2y)}{{y}^{2}} & ={lim}_{x\\to 0}\\frac{x(x+2(-x))}{(-x)^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{-{x}^{2}}{{x}^{2}} \\\\  & =-1.\\end{aligned}\n$$\n\nBecause the limit evaluates to different results on these two paths, we conclude that the limit does not exist:\n\n$$\n\\displaystyle{\\lim_{\\mathbf{x}\\to (0,0)}} \\dfrac{x(x + 2y)}{y^2} = \\text{DNE}\n$$" :db/ensure [:question/validate]}]
