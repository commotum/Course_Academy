rkers/multivariable/14072435/assets/6e58954fccd74eaf67c95df818c4c9050c35b324c5fffe4902a366cb295b8845.png)\n\nTherefore,\n\n$$\n\\begin{aligned}{M}_{ij} & =f({x}_{i},{y}_{j})=10{x}_{i}+{y}_{j}-3\\end{aligned}\n$$\n\nfor all $1\\le i\\le m$ and $1\\le j\\le n.$\n\nFinally, the upper Riemann sum is \n\n$$\n\\begin{aligned}U(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(10{x}_{i}+{y}_{j}-3)Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $10{x}_{i}+{y}_{j}-3.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-170676/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "db8e7d68-5731-5a44-b86e-919a13689540"] :knowledge-point/questions ["q-170676"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75331/selection/4e7c4ec79fa2bf10684d130a96c491f2211b8b4f4d76a839107a45d6ee9fa55d" :answer/id #uuid "f56dc597-c9fb-5d99-9e53-72b47e238fe2" :answer/type :answer.type/math :answer/value "{x}_{i-1}+5{y}_{j-1}" :db/ensure [:answer/validate]} {:db/id "q-75331/selection/f39ac2024dbc55e06fda1540d5b7eec599e2132558127288ba1070140b2711f3" :answer/id #uuid "e98ddc8f-2605-5c7d-859e-b992ef6c6af8" :answer/type :answer.type/math :answer/value "4{x}_{i}+5{y}_{j}+23" :db/ensure [:answer/validate]} {:db/id "q-75331/selection/c9cf6e1aa7fc0442b3726149208a944c8e2078b40428d598035c708400f847a1" :answer/id #uuid "c867ee31-139e-50c9-8db1-82f458f20d70" :answer/type :answer.type/math :answer/value "4{x}_{i-1}+5{y}_{j-1}+23" :db/ensure [:answer/validate]} {:db/id "q-75331/selection/4150c3389981922566bb6aef04592ea593bcd72d3ebf34b4e702cc1d9f77d6dd" :answer/id #uuid "a8e8d495-76d3-5c63-adb3-9eeb0ede4bfe" :answer/type :answer.type/math :answer/value "{x}_{i}+5{y}_{j}" :db/ensure [:answer/validate]} {:db/id "q-75331/selection/b9c958d3511264dddf4cea45fea1572c5f41f7269dcb8c898c785886121c7ccf" :answer/id #uuid "47262f29-7516-5b4f-818e-cc8a44e656bd" :answer/type :answer.type/math :answer/value "4{x}_{i-1}+5{y}_{j}+23" :db/ensure [:answer/valida