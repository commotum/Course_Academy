th time, our derivative should be *negative*. Therefore, we can rewrite our proportionality statement as\n\n$$\n\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{t}^{2}}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041831/state.json" "file_sha256" "6c53d0ee6a7501c92f48514b41a995b101200d5c0210307e8a46b6dcc30363fc"} {"question" "q-143094" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041831/activity-metadata.json" "file_sha256" "5352fdf86e6abe82c17a6566dd848951ebe0972ce1864ab53dbaae9fcdf8bb84"} {"question" "q-143094" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041831/state.json" "file_sha256" "6c53d0ee6a7501c92f48514b41a995b101200d5c0210307e8a46b6dcc30363fc"} {"question" "q-143094" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{S}^{2}},\\,k>0"] ["math" "\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{t}^{2}},\\,k>0"] ["math" "\\frac{\\text{d}S}{\\text{d}t}=-k{t}^{2},\\,k>0"] ["math" "\\frac{\\text{d}S}{\\text{d}t}=\\frac{k}{t},\\,k>0"] ["math" "\\frac{\\text{d}S}{\\text{d}t}=\\frac{k}{{S}^{2}},\\,k>0"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041831/state.json" "file_sha256" "6c53d0ee6a7501c92f48514b41a995b101200d5c0210307e8a46b6dcc30363fc"} {"question" "q-143094" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\text{d}S}{\\text{d}t}=-\\frac{k}{{t}^{2}},\\,k>0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mat