{d}u}{\\text{d}x}=\\frac{1}{4}\\,⟹\\,\\text{d}x=4\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{16+{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}\\int \\frac{1}{1+(x/4)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\frac{1}{1+{u}^{2}}\\cdot (4\\,\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =2\\operatorname{arctan}⁡u+C \\\\  & =2\\operatorname{arctan}⁡(\\frac{x}{4})+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114045" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\operatorname{arctan}⁡(4x)+C"] ["math" "2\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{4})+C"] ["math" "\\operatorname{arctan}⁡(\\frac{x}{4})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114045" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{arctan}⁡(\\frac{x}{4})+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114056" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114056" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\text{d}x=\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{8}x.$\n\nSo, let's substitute $u=\\sqrt{8}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{8}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{8}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{8}{|x|\\sqrt{8{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{8\\sqrt{8}}{|\\sqrt{8}x|\\sqrt{(\\sqrt{8}x)^{2}-1}}\\,\\text{d}x \\\\  & =8\\sqrt{8}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{8}}\\text{d}u) \\\\  & =8\\sqrt{8}\\cdot \\frac{1}{\\sqrt{8}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =8\\,\\text{arcsec }u+C \\\\  & =8\\,\\text{arcsec}(\\sqrt{8}x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114056" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-114056" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114056" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "8\\,\\text{arcsec}(\\frac{x}{\\sqrt{8}})+C"] ["math" "8\\,\\text{arcsec}(\\sqrt{8}x)+C"] ["math" "8\\sqrt{8}\\,\\text{arcsec}(x)+C"] ["math" "\\frac{\\sqrt{8}}{8}\\,\\text{arcsec}(x)+C"] ["math" "\\text{arcsec}(\\sqrt{8}x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114056" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8\\,\\text{arcsec}(\\sqrt{8}x)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69476" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{8\\,\\text{d}x}{|8x|\\sqrt{(8x)^{2}-1}}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69476" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{8\\,\\text{d}x}{|8x|\\sqrt{(8x)^{2}-1}}=8\\int \\frac{\\text{d}x}{|8x|\\sqrt{(8x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $8x.$\n\nSo, let's substitute $u=8x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=8\\,⟹\\,\\text{d}x=\\frac{1}{8}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}8\\int \\frac{1}{|8x|\\sqrt{(8x)^{2}-1}}\\text{d}x & =8\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{8}\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(8x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69476" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-69476" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69476" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "4\\text{arcsec}(8x)+C"] ["math" "\\frac{\\text{arcsec}(4x)}{4}+C"] ["math" "\\frac{\\text{arcsec}(8x)}{8}+C"] ["math" "\\text{arcsec}(64x)+C"] ["math" "\\text{arcsec}(8x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69476" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\text{arcsec}(8x)+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-49554" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{1}{3|x|\\sqrt{9{x}^{2}-1}}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-49554" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{3|x|\\sqrt{9{x}^{2}-1}}=\\int \\frac{\\text{d}x}{|3x|\\sqrt{(3x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $3x.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{3|x|\\sqrt{9{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{1}{|3x|\\sqrt{(3x)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{3}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(3x)}{3}+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-49554" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-49554" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-49554" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\operatorname{arcsin}⁡(3x)}{3}+C"] ["math" "\\frac{\\operatorname{arcsin}⁡(9x)}{3}+C"] ["math" "\\frac{\\text{arcsec}(3x)}{3}+C"] ["math" "\\frac{\\text{arcsec}(9x)}{3}+C"] ["math" "\\frac{\\text{arcsec}(x)}{3}+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-49554" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\text{arcsec}(3x)}{3}+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69475" "field" nil "attribute" "question/problem" "value" "$\\int \\frac{7\\,\\text{d}x}{|7x|\\sqrt{(7x)^{2}-1}}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69475" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{7\\,\\text{d}x}{|7x|\\sqrt{(7x)^{2}-1}}=7\\int \\frac{\\text{d}x}{|7x|\\sqrt{(7x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $7x.$\n\nSo, let's substitute $u=7x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=7\\,⟹\\,\\text{d}x=\\frac{1}{7}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}7\\int \\frac{1}{|7x|\\sqrt{(7x)^{2}-1}}\\text{d}x & =7\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{7}\\text{d}u) \\\\  & =\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(7x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69475" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-69475" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69475" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\text{arcsec}(49x)}{7}+C"] ["math" "\\frac{\\text{arcsec}(7x)}{49}+C"] ["math" "\\frac{\\text{arcsec}(7x)}{7}+C"] ["math" "\\text{arcsec}(49x)+C"] ["math" "\\text{arcsec}(7x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-69475" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\text{arcsec}(7x)+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114053" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{1}{|x|\\sqrt{3{x}^{2}-1}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114053" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{|x|\\sqrt{3{x}^{2}-1}}=\\int \\frac{\\sqrt{3}}{|\\sqrt{3}x|\\sqrt{(\\sqrt{3}x)^{2}-1}}\\text{d}x.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $\\sqrt{3}x.$\n\nSo, let's substitute $u=\\sqrt{3}x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\sqrt{3}\\,⟹\\,\\text{d}x=\\frac{1}{\\sqrt{3}}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{|x|\\sqrt{3{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{\\sqrt{3}}{|\\sqrt{3}x|\\sqrt{(\\sqrt{3}x)^{2}-1}}\\,\\text{d}x \\\\  & =\\sqrt{3}\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{\\sqrt{3}}\\text{d}u) \\\\  & =\\sqrt{3}\\cdot \\frac{1}{\\sqrt{3}}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec }u+C \\\\  & =\\text{arcsec}(\\sqrt{3}x)+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114053" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-114053" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114053" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\sqrt{3}}{3}\\text{arcsec}(x)+C"] ["math" "\\sqrt{3}\\,\\text{arcsec}(x)+C"] ["math" "\\text{arcsec}(3x)+C"] ["math" "\\text{arcsec}(\\frac{x}{\\sqrt{3}})+C"] ["math" "\\text{arcsec}(\\sqrt{3}x)+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114053" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\text{arcsec}(\\sqrt{3}x)+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351827" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351827" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x & =15{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{36\\cdot (1-{x}^{2}/36)}}\\,\\text{d}x \\\\  & =\\frac{15}{6}{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{1-{x}^{2}/36}}\\,\\text{d}x \\\\  & =\\frac{5}{2}{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/6)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{6})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{6}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{6}\\,⟹\\,\\text{d}x=6\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $3\\sqrt{3}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3\\sqrt{3}}\\frac{15}{\\sqrt{36-{x}^{2}}}\\,\\text{d}x & =\\frac{5}{2}{\\int }_{0}^{3\\sqrt{3}}\\frac{1}{\\sqrt{1-(x/6)^{2}}}\\,\\text{d}x \\\\  & =\\frac{5}{2}{\\int }_{0}^{\\sqrt{3}/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot 6\\,\\text{d}u \\\\  & =15{\\int }_{0}^{\\sqrt{3}/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =15\\operatorname{arcsin}⁡u\\,{|}_{0}^{\\sqrt{3}/2} \\\\  & =15\\operatorname{arcsin}⁡(\\frac{\\sqrt{3}}{2})-15\\operatorname{arcsin}⁡(0) \\\\  & =15\\cdot \\frac{\\pi }{3} \\\\  & =5\\pi \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351827" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-351827" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351827" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "5\\pi"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114084" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114084" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{1}\\frac{2}{3\\cdot (1+{x}^{2}/3)}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+{x}^{2}/3}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{\\sqrt{3}})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{\\sqrt{3}}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{\\sqrt{3}}\\,⟹\\,\\text{d}x=\\sqrt{3}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $1$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\sqrt{3}}{3}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{2}{3+{x}^{2}}\\,\\text{d}x & =\\frac{2}{3}{\\int }_{0}^{1}\\frac{1}{1+(x/\\sqrt{3})^{2}}\\,\\text{d}x \\\\  & =\\frac{2}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{1}{1+{u}^{2}}\\cdot (\\sqrt{3}\\,\\text{d}u) \\\\  & =\\frac{2\\sqrt{3}}{3}{\\int }_{0}^{\\sqrt{3}/3}\\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{2\\sqrt{3}}{3}\\operatorname{arctan}⁡u{|}_{0}^{\\sqrt{3}/3} \\\\  & =\\frac{2\\sqrt{3}}{3}(\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3})-\\operatorname{arctan}⁡(0)) \\\\  & =\\frac{2\\sqrt{3}}{3}\\cdot \\frac{\\pi }{6} \\\\  & =\\frac{\\sqrt{3}\\pi }{9}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114084" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\pi }{3}"] ["math" "\\frac{\\pi }{9}"] ["math" "\\frac{\\sqrt{3}\\pi }{3}"] ["math" "\\frac{\\sqrt{3}\\pi }{9}"] ["math" "\\sqrt{3}\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-114084" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{3}\\pi }{9}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-19395" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{-0.25}^{0.25}\\frac{3}{\\sqrt{3-12{x}^{2}}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-19395" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{-0.25}^{0.25}\\frac{3}{\\sqrt{3-12{x}^{2}}}\\,\\text{d}x & =3{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{3\\cdot (1-4{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{3}{\\sqrt{3}}{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{1-4{x}^{2}}}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{1-(2x)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n  \n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(2x)}^{2}.$   \n\nSo, let's substitute $u=2x.$ Differentiating, we get \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\,⟹\\,\\text{d}x=\\frac{1}{2}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $-0.25$ | $0.25$ |\n| --- | --- | --- |\n| $u$ | $-0.5$ | $0.5$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{-0.25}^{0.25}\\frac{3}{\\sqrt{3-12{x}^{2}}}\\,\\text{d}x & =\\sqrt{3}{\\int }_{-0.25}^{0.25}\\frac{1}{\\sqrt{1-(2x)^{2}}}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{-0.5}^{0.5}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (\\frac{1}{2}\\text{d}u) \\\\  & =\\frac{\\sqrt{3}}{2}{\\int }_{-0.5}^{0.5}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{\\sqrt{3}}{2}\\operatorname{arcsin}⁡u{|}_{-0.5}^{0.5} \\\\  & =\\frac{\\sqrt{3}}{2}(\\operatorname{arcsin}⁡(0.5)-\\operatorname{arcsin}⁡(-0.5)) \\\\  & =\\frac{\\sqrt{3}}{2}(\\frac{\\pi }{6}+\\frac{\\pi }{6}) \\\\  & =\\frac{\\sqrt{3}}{2}\\cdot \\frac{\\pi }{3} \\\\  & =\\frac{\\sqrt{3}\\pi }{6}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-19395" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-19395" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-19395" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{\\pi }{3}"] ["math" "\\frac{\\sqrt{2}\\pi }{3}"] ["math" "\\frac{\\sqrt{3}\\pi }{3}"] ["math" "\\frac{\\sqrt{3}\\pi }{6}"] ["math" "\\sqrt{3}\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-19395" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{3}\\pi }{6}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351291" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351291" "field" nil "attribute" "question/worked-solution" "value" "Let's rewrite our integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x & =10{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{5(1-16{x}^{2})}}\\,\\text{d}x \\\\  & =\\frac{10}{\\sqrt{5}}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-16{x}^{2}}}\\,\\text{d}x \\\\  & =2\\sqrt{5}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x\\end{aligned}\n$$\n\n \n\nThis integral resembles the basic integral for inverse sine, \n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(4x)}^{2}.$\n\nSo, let's substitute $u=4x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=4\\,⟹\\,\\text{d}x=\\frac{1}{4}\\,\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{8}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/8}\\frac{10}{\\sqrt{5-80{x}^{2}}}\\,\\text{d}x & =2\\sqrt{5}{\\int }_{0}^{1/8}\\frac{1}{\\sqrt{1-(4x)^{2}}}\\,\\text{d}x \\\\  & =2\\sqrt{5}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{2}{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{5}}{2}\\operatorname{arcsin}⁡u\\,{|}_{0}^{1/2} \\\\  & =\\frac{\\sqrt{5}}{2}(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(0)) \\\\  & =\\frac{\\sqrt{5}}{2}(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi \\sqrt{5}}{12}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351291" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-351291" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351291" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\sqrt{5}\\pi}{12}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351835" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351835" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n{\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x=2{\\int }_{0}^{1/12}\\frac{1}{\\sqrt{1-(6x)^{2}}}\\,\\text{d}x.\n$$\n\nThis integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\text{d}u=\\operatorname{arcsin}⁡(u)+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have $(6x)^{2}.$\n\nSo, let's substitute $u=6x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=6\\,⟹\\,\\text{d}x=\\frac{1}{6}\\text{d}u.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\frac{1}{12}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{1}{2}$ |\n\nUsing the above, we can now write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{1/12}\\frac{2}{\\sqrt{1-36{x}^{2}}}\\,\\text{d}x & =2{\\int }_{0}^{1/12}\\frac{1}{\\sqrt{1-(6x)^{2}}}\\,\\text{d}x \\\\  & =2{\\int }_{0}^{1/2}\\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\cdot (\\frac{1}{6}\\text{d}u) \\\\  & =\\frac{1}{3}{\\int }_{0}^{1/2}\\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =\\frac{1}{3}\\operatorname{arcsin}⁡u{|}_{0}^{1/2} \\\\  & =\\frac{1}{3}(\\operatorname{arcsin}⁡(\\frac{1}{2})-\\operatorname{arcsin}⁡(0)) \\\\  & =\\frac{1}{3}(\\frac{\\pi }{6}-0) \\\\  & =\\frac{\\pi }{18}\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351835" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-351835" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-351835" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\pi}{18}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "e-470" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\displaystyle \\int \\dfrac{9}{4\\sqrt{1-9x^2}} \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-470.json" "file_sha256" "1025a33422822b6db8f473989eb2074d5d9763952048ca4f593096ef1da5e7e2"} {"question" "e-470" "field" nil "attribute" "question/worked-solution" "value" "This integral resembles the basic integral for inverse sine,\n\n$$\n\\int \\frac{1}{\\sqrt{1-u^2}}\\textrm{d}u = \\arcsin(u)+C.\n$$\n\nThe only difference is that instead of $u^2$ as the variable, we have $9x^2 = (3x)^2.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=3\\quad\\Longrightarrow\\quad \\dfrac 1 3 \\,\\textrm d u=\\textrm d x.\n$$\n\nWe can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{9}{4\\sqrt{1-9{x}^{2}}}\\,\\text{d}x & =\\frac{9}{4}\\int \\frac{1}{\\sqrt{1-(3x)^{2}}}\\,\\,\\text{d}x \\\\  & =\\frac{9}{4}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot \\frac{1}{3}\\text{d}u \\\\  & =\\frac{9}{12}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\,\\text{d}u \\\\  & =\\frac{3}{4}\\cdot \\operatorname{arcsin}⁡u+C \\\\  & =\\frac{3}{4}\\operatorname{arcsin}⁡3x+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-470.json" "file_sha256" "1025a33422822b6db8f473989eb2074d5d9763952048ca4f593096ef1da5e7e2"} {"question" "e-471" "field" nil "attribute" "question/problem" "value" "Calculate the integral  $\\displaystyle{\\int \\dfrac{3}{2 + 50x^2} \\, \\textrm{d}x }.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-471.json" "file_sha256" "252352644dbe0a25fe397efd63f81934562ae8869aa32c079dd3097021d97db2"} {"question" "e-471" "field" nil "attribute" "question/worked-solution" "value" "Note that we can rewrite this integral as\n\n$$\n\\int \\dfrac{3}{2 + 50x^2} \\, \\textrm{d}x = \\int \\dfrac{3}{2(1 + 25x^2)} = \\dfrac 3 2 \\int \\dfrac{1}{1+25x^2}\\,\\textrm d x.\n$$\n\nThis integral resembles the basic integral for inverse tangent,\n\n$$\n\\int \\frac{1}{1+u^2}\\textrm{d}u =\\arctan u +C.\n$$\n\nThe only difference is that instead of $u^2$ as the variable, we have $25x^2 = (5x)^2.$\n\nSo, let's substitute $u=5x.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=5\\quad\\Longrightarrow\\quad \\dfrac 1 5\\,\\textrm d u = \\textrm d x.\n$$\n\nWe can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{3}{2+50{x}^{2}}\\,\\text{d}x & =\\frac{3}{2}\\int \\frac{1}{1+25{x}^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{2}\\int \\frac{1}{1+(5x)^{2}}\\,\\text{d}x \\\\  & =\\frac{3}{2}\\int \\frac{1}{1+{u}^{2}}\\,\\,\\cdot \\frac{1}{5}\\,\\text{d}u \\\\  & =\\frac{3}{10}\\int \\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{3}{10}\\cdot \\operatorname{arctan}⁡u+C \\\\  & =\\frac{3}{10}\\operatorname{arctan}⁡5x+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-471.json" "file_sha256" "252352644dbe0a25fe397efd63f81934562ae8869aa32c079dd3097021d97db2"} {"question" "e-5014" "field" nil "attribute" "question/problem" "value" "${\\displaystyle \\int \\dfrac{5\\, \\textrm{d}x}{|5x|\\sqrt{(5x)^2-1}}  = }$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-5014.json" "file_sha256" "a21fd1bc799688842e857e008530cd6c2e0f3501ce9a0afcec861d7cb117cc11"} {"question" "e-5014" "field" nil "attribute" "question/worked-solution" "value" "This resembles the basic integral for $\\textrm{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{u^2-1}} \\textrm{d}u = \\textrm{arcsec}(u)+C.\n$$\n\nLet $u = 5x.$ Then\n\n$$\n\\dfrac{\\textrm{d}u}{\\textrm{d}x}=5\n\\quad\\Longrightarrow\\quad\n5\\,\\textrm{d}x = \\textrm{d}u.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{5\\,\\text{d}x}{|5x|\\sqrt{(5x)^{2}-1}} & =\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\text{arcsec}(u)+C \\\\  & =\\text{arcsec}(5x)+C.\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-5014.json" "file_sha256" "a21fd1bc799688842e857e008530cd6c2e0f3501ce9a0afcec861d7cb117cc11"} {"question" "e-472" "field" nil "attribute" "question/problem" "value" "Evaluate the integral $\\displaystyle{\\int_{0}^{\\sqrt 2} \\dfrac{1}{2+x^2}\\, \\textrm{d}x}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-472.json" "file_sha256" "03dabd58e40622eb355f9559dc7c36cdabd9fab6dc543fb17c701a650367b3c6"} {"question" "e-472" "field" nil "attribute" "question/worked-solution" "value" "First, we rewrite the integral as\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{2}}\\frac{1}{2+{x}^{2}}\\,\\text{d}x & ={\\int }_{0}^{\\sqrt{2}}\\frac{1}{2(1+{x}^{2}/2)}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\sqrt{2}}\\frac{1}{2(1+(x/\\sqrt{2})^{2})}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\sqrt{2}}\\frac{1}{1+(x/\\sqrt{2})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe see that this integral now resembles the basic integral for the inverse tangent,\n\n$$\n\\int\\dfrac{1}{1+u^2}\\,\\textrm d u = \\arctan{u} + C.\n$$\n\nWe make the substitution $u=\\dfrac{x}{\\sqrt 2}.$ Differentiating, we get\n\n$$\n\\dfrac{\\textrm d u}{\\textrm d x} = \\dfrac{1}{\\sqrt 2}\\quad\\Longrightarrow\\quad \\sqrt 2 \\,\\textrm d u = \\textrm d x.\n$$\n\nBefore substituting, we use the table below to change the limits from $x$ to $u.$\n\n| $x$ | $0$ | $\\sqrt2$ |\n| --- | --- | --- |\n| $u$ | $0$ | $1$ |\n\nUsing the above, we can now write the integral in terms of $u,$ and evaluate:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{2}}\\frac{1}{2+{x}^{2}}\\,\\text{d}x & =\\frac{1}{2}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\cdot \\sqrt{2}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}{\\int }_{0}^{1}\\frac{1}{1+{u}^{2}}\\,\\text{d}u \\\\  & =\\frac{\\sqrt{2}}{2}{\\operatorname{arctan}⁡u|}_{0}^{1} \\\\  & =\\frac{\\sqrt{2}}{2}(\\operatorname{arctan}⁡1-\\operatorname{arctan}⁡0) \\\\  & =\\frac{\\sqrt{2}}{2}(\\frac{\\pi }{4}-0) \\\\  & =\\frac{\\pi \\sqrt{2}}{8}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/example-472.json" "file_sha256" "03dabd58e40622eb355f9559dc7c36cdabd9fab6dc543fb17c701a650367b3c6"}] "usage" {"e-5014" [] "q-114024" [] "q-114046" [] "e-472" [] "q-69476" [] "q-2504" [] "e-470" [] "q-49550" [] "q-351291" [] "e-471" []} "basis" 1258 "retractions" [] "immu