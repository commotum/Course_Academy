+{x}^{2}/25}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+(x/5)^{2}}\\,\\text{d}x\\end{aligned}\n$$\n\nThis integral resembles the basic integral for inverse tangent\n\n$$\n\\int \\frac{1}{1+{u}^{2}}\\text{d}u=\\operatorname{arctan}⁡u+C.\n$$\n\nThe only difference is that instead of ${u}^{2}$ as the variable, we have ${(\\frac{x}{5})}^{2}.$\n\nSo, let's substitute $u=\\frac{x}{5}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\,\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{25+{x}^{2}}\\,\\text{d}x & =\\frac{1}{25}\\int \\frac{1}{1+(x/5)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{25}\\int \\frac{1}{1+{u}^{2}}\\cdot (5\\,\\text{d}u) \\\\  & =\\frac{1}{5}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{5}\\operatorname{arctan}⁡(\\frac{x}{5})+C\\end{aligned}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-49550" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/activity-metadata.json" "file_sha256" "31e77975055356dfb2474618c3afed650e3c461761c728a631bc7a95a0837710"} {"question" "q-49550" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037171/state.json" "file_sha256" "97c12285f778ab2b8c173ba1373eccc72c7b5e33b5d6af5d775f6efd34340783"} {"question" "q-49550" "field" "selection" "attribute" "answer-field/choices" "value" [["ma