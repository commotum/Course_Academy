u}{\\text{d}x}=\\frac{1}{5}\\,⟹\\,\\text{d}x=5\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{2}{\\sqrt{25-{x}^{2}}}\\,\\text{d}x & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-(x/5)^{2}}}\\,\\text{d}x \\\\  & =\\frac{2}{5}\\int \\frac{1}{\\sqrt{1-{u}^{2}}}\\cdot (5\\,\\text{d}u) \\\\  & =2\\int \\frac{\\text{d}u}{\\sqrt{1-{u}^{2}}} \\\\  & =2\\operatorname{arcsin}⁡u+C \\\\  & =2\\operatorname{arcsin}⁡(\\frac{x}{5})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114030/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "de1e3f3a-5a64-573f-8fb1-9952fa36a839"] :knowledge-point/questions ["q-114030"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49505/selection/1b1a6490d25c6e27cdebbdf0ae598cc6134cd8ef90f06907392b93f8869e7363" :answer/id #uuid "a4dc3cea-198a-5efa-835e-10ba0dbcf4b1" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-49505/selection/69bd45d008f14ed1b9e4587f812d39356f9a7edcedff74dbb61450dbbedb6904" :answer/id #uuid "3ae0ebc8-2f4e-5603-aa1f-1b2d58ed1c5d" :answer/type :answer.type/math :answer/value "\\operatorname{arctan}⁡(2x)+C" :db/ensure [:answer/validate]} {:db/id "q-49505/selection/88b4e853af1981af5a20d9794fd19a903026eb9240987f8445a7520907b472ec" :answer/id #uuid "b674bb5a-c3e8-52f6-9db4-70c1b0c2bade" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49505/selection/ec545df6ef6a5ebe37344cf7d417adbddea5bdd0e5713d98e367d6ebb3967e51" :answer/id #uuid "a7655bba-315f-5d0e-8678-cb96c5e49d16" :answer/type :answer.type/math :answer/value "\\operatorname{arctan}⁡(\\frac{x}{2})+C" :db/ensure [:answer/validate]} {:db/id "q-49505/selection/14ac60073d05d363d60ed49d32fe34ee26b6cfd77b6fe7e004edea403f511c25" :answer/