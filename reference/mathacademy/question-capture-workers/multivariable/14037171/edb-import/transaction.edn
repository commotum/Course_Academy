{1+(x/2)^{2}}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\frac{1}{1+{u}^{2}}\\cdot (2\\,\\text{d}u) \\\\  & =\\frac{1}{2}\\int \\frac{\\text{d}u}{1+{u}^{2}} \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡u+C \\\\  & =\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{2})+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49505/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "227abe29-6e31-5afd-b0ca-3b8ed7d8c287"] :knowledge-point/questions ["q-49505"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114045/selection/281b4b6a4e0665d5d4c17bab7a09de7cc5c30cdba6569d7a1a977bfabb089dd2" :answer/id #uuid "e8f91561-2994-50d4-8899-964b34007fb0" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\operatorname{arctan}⁡(\\frac{x}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-114045/selection/6ea352026f150f0fb3a5f8e5fc7affa1e59965c4ce9054de12985dcd2156cf9a" :answer/id #uuid "79dd410d-7feb-59d2-8793-065ac1904021" :answer/type :answer.type/math :answer/value "2\\operatorname{arctan}⁡(\\frac{x}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-114045/selection/6a6a554240f1e663651fbdaf3c9c9a4f0bfb551175f147878bc66e6b4a6165c1" :answer/id #uuid "6870e8fd-8f88-5aed-8b88-d157b85205d1" :answer/type :answer.type/math :answer/value "2\\operatorname{arctan}⁡(4x)+C" :db/ensure [:answer/validate]} {:db/id "q-114045/selection/0a4fb0b935839afcd6c8d16a7e61c256a17e17c014bcf18069647e1723005dab" :answer/id #uuid "161035dd-534e-5c12-88df-5fe26ee6a1e1" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{arctan}⁡(\\frac{x}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-114045/selection/b6f418c0e04ff5293bb043bc0235ba9381ff9df3acd28853b596d260ca362e61" :answer/id #uuid "966fc9a3-c000-5205-81d7-a858502c46c5" :answer/type :answer.type/math :answer/value "\\operatorname{arctan}⁡(\\frac{x}{4})+C" :db/ensure [:answer/validate]} {:db/id "q-114045/selection" :answer-field/id #uuid "f7b5e482-b