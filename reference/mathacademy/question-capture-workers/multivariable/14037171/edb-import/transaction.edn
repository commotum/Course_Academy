df8fcf0803" "q-49554/selection/d07419a418b35570f90e3cb94f4fa700fc113d41a53be45f3568c2471e824051"] :db/ensure [:answer-field/validate]} {:db/id "q-49554" :question/id #uuid "e23bb3f4-a65e-57d7-abc7-33852f454847" :question/math-academy-id "q-49554" :question/problem "$\\int \\frac{1}{3|x|\\sqrt{9{x}^{2}-1}}\\,\\text{d}x=$" :question/worked-solution "Note that we can rewrite this integral as\n\n$$\n\\int \\frac{\\text{d}x}{3|x|\\sqrt{9{x}^{2}-1}}=\\int \\frac{\\text{d}x}{|3x|\\sqrt{(3x)^{2}-1}}.\n$$\n\nThis integral now resembles the basic one for $\\text{arcsec},$\n\n$$\n\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\text{d}u=\\text{arcsec}(u)+C.\n$$\n\nThe only difference is that instead of $u$ as the variable, we have $3x.$\n\nSo, let's substitute $u=3x.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3\\,⟹\\,\\text{d}x=\\frac{1}{3}\\text{d}u.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{1}{3|x|\\sqrt{9{x}^{2}-1}}\\,\\text{d}x & =\\int \\frac{1}{|3x|\\sqrt{(3x)^{2}-1}}\\,\\text{d}x \\\\  & =\\int \\frac{1}{|u|\\sqrt{{u}^{2}-1}}\\cdot (\\frac{1}{3}\\text{d}u) \\\\  & =\\frac{1}{3}\\int \\frac{\\text{d}u}{|u|\\sqrt{{u}^{2}-1}} \\\\  & =\\frac{1}{3}\\text{arcsec }u+C \\\\  & =\\frac{\\text{arcsec}(3x)}{3}+C\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49554/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "8d18bdc7-9387-5b2d-98bd-015fa4a1eba7"] :knowledge-point/questions ["q-49554"] :db/ensure [:knowledge-point/validate]} {:db/id "q-69475/selection/cd02d2c7f7023009846d3b4d6916dbccdbc36039ed2d2a3d57e01ca99c9d40bd" :answer/id #uuid "25a79dbd-654f-5b3a-915d-8352e289b51a" :answer/type :answer.type/math :answer/value "\\text{arcsec}(49x)+C" :db/ensure [:answer/validate]} {:db/id "q-69475/selection/d49de2188aba6f2ce6d70de6048a979e22ba144b154211a061b9054b90f63a87" :answer/id #uuid "3558b5a2-