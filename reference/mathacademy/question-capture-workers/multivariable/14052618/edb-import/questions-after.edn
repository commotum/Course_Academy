#{[{:db/id #edb/ref 17592186330228 :knowledge-point/_questions [{:knowledge-point/id #uuid "ab643519-92a4-5ccf-b826-fb2a68b36534" :knowledge-point/title "Evaluating a Jacobian Determinant"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5690df46-71a1-5cb9-a07f-efc829b9df70" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186330230} {:answer/id #uuid "c5edfcd2-dd83-5487-ade5-2dbfa1584ce7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186330231} {:answer/id #uuid "f5a0d500-a743-5d8a-a25d-b2b64d7fd910" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186330232} {:answer/id #uuid "8c2c1b13-f9f5-5e24-9af5-2590bd3067f9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186330233} {:answer/id #uuid "c2b96b26-5147-5789-aea3-83d401f9227e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186330234}] :answer-field/correct {:answer/id #uuid "c5edfcd2-dd83-5487-ade5-2dbfa1584ce7" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186330231} :answer-field/id #uuid "b4572c86-e93d-5e3c-a174-ade926d35fb8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330229}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8684eb9a-aecb-5b80-9a18-39831797ddaa" :question/math-academy-id "q-160431" :question/problem "For the transformation $T,$ defined as\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{v}^{2}+uv \\\\ v-u\\end{aligned}]\n$$\n\ncompute the value of the Jacobian determinant at the point where $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}8 \\\\ -2\\end{aligned}].$" :question/worked-solution "Given a transformation \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]\\to [\\begin{aligned}x(u,v) \\\\ y(u,v)\\end{aligned}],\n$$\n\nthe Jacobian determinant of $T,$ denoted $\\frac{∂(x,y)}{∂(u,v)},$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v)={v}^{2}+uv$ and $y(u,v)=v-u.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =v & \\,\\frac{∂x}{∂v} & =2v+u \\\\ \\frac{∂y}{∂u} & =-1 & \\,\\frac{∂y}{∂v} & =1\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v & 2v+u \\\\ -1 & 1\\end{aligned}| \\\\  & =v\\cdot 1-(2v+u)\\cdot (-1) \\\\  & =v+2v+u \\\\  & =3v+u.\\end{aligned}\n$$\n\nFinally, when $[\\begin{aligned}u \\\\ v\\end{aligned}]=[\\begin{aligned}8 \\\\ -2\\end{aligned}],$ the value of our Jacobian determinant is\n\n$$\n{\\frac{∂(x,y)}{∂(u,v)}|}_{(8,-2)}=3(-2)+8=2.\n$$"}] [{:db/id #edb/ref 17592186129462 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8ad992f0-68fb-5bef-b082-8c4374d18e95" :answer/type {:db/ident :answer.type/math} :answer/value "11δA" :db/id #edb/ref 17592186126579} {:answer/id #uuid "960fcbde-8ad2-5c20-a103-e991662f0830" :answer/type {:db/ident :answer.type/math} :answer/value "5δA" :db/id #edb/ref 17592186126580} {:answer/id #uuid "acdeb260-db65-54f1-84f7-b0a3db3a7270" :answer/type {:db/ident :answer.type/math} :answer/value "8δA" :db/id #edb/ref 17592186126581} {:answer/id #uuid "e2e38318-8853-5ee9-a6ed-7ac86a7addcd" :answer/type {:db/ident :answer.type/math} :answer/value "δA" :db/id #edb/ref 17592186126582} {:answer/id #uuid "f3ba2d62-96a1-50ba-8be6-4c9415d99148" :answer/type {:db/ident :answer.type/math} :answer/value "3δA" :db/id #edb/ref 17592186126583}] :answer-field/correct {:answer/id #uuid "960fcbde-8ad2-5c20-a103-e991662f0830" :answer/type {:db/ident :answer.type/math} :answer/value "5δA" :db/id #edb/ref 17592186126580} :answer-field/id #uuid "f7992ea4-f144-5b11-89df-954b9fcb78ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126578}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c116e20c-7c3c-5121-8057-e62b04b89e02" :question/math-academy-id "q-161832" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(1,5)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\operatorname{ln}⁡(uv) \\\\ u{v}^{2}\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\frac{1}{u} & \\frac{1}{v} \\\\ {v}^{2} & 2uv\\end{aligned}| \\\\  & =\\frac{1}{u}\\cdot 2uv-\\frac{1}{v}\\cdot {v}^{2} \\\\  & =2v-v \\\\  & =v \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(1,5)} & =v\\,{|}_{u=1\\,v=5} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|5|\\cdot \\delta A \\\\  & =5\\,\\delta A.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330235 :knowledge-point/_questions [{:knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "53d1e293-06b2-518f-8f9b-a10697d6d1eb" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/fd2a51ca3a1654c2e857018268bf251366472a2c5d7f90009d5ccfbf1b1edd9d.png" :db/id #edb/ref 17592186330237} {:answer/id #uuid "9a7134ee-8c28-59d6-a54f-adfefbf5ecf3" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/c244350524a52123e2e97db4cd8eb4f57737b8b15746eb72a8d54eac32a4f3cf.png" :db/id #edb/ref 17592186330238} {:answer/id #uuid "ceff3973-b932-5863-9389-10a06bad9c8a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/0b764651dbc7999e7af13214685796b5045fab89f101bbc72bf413112df3c51f.png" :db/id #edb/ref 17592186330239} {:answer/id #uuid "cb669985-40db-5692-a60c-c3b9cc709d9c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/8bec16b8ed5083071e21761e6b2e649e136ce0662f7e5ab764161491094c0609.png" :db/id #edb/ref 17592186330240} {:answer/id #uuid "39a831ca-653e-550e-9ae8-ffc0bbd466f5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186330241}] :answer-field/correct {:answer/id #uuid "cb669985-40db-5692-a60c-c3b9cc709d9c" :answe