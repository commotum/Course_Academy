home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/8bec16b8ed5083071e21761e6b2e649e136ce0662f7e5ab764161491094c0609.png)"}] [{:db/id #edb/ref 17592186330242 :knowledge-point/_questions [{:knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a126364a-f956-5e49-bd74-b5b7522d04e6" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186330244} {:answer/id #uuid "4b559133-9776-5227-9499-09dcc827c59c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png" :db/id #edb/ref 17592186330245} {:answer/id #uuid "ad35d12a-f398-5a5d-acc5-a836f5772e4d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png" :db/id #edb/ref 17592186330246} {:answer/id #uuid "6a5f5601-4637-55d5-b428-21d93926212c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png" :db/id #edb/ref 17592186330247} {:answer/id #uuid "fcd52064-7688-5a56-95c8-dc10439372bc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png" :db/id #edb/ref 17592186330248}] :answer-field/correct {:answer/id #uuid "fcd52064-7688-5a56-95c8-dc10439372bc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png" :db/id #edb/ref 17592186330248} :answer-field/id #uuid "dfd9a1f1-a636-5ee9-ae67-ec4acbf86a5a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330243}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cbe9b704-1e10-5076-bbdf-dcc611074143" :question/math-academy-id "q-161842" :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{3}-\\frac{1}{2}{v}^{2} \\\\ u-\\frac{1}{3}v\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{u}^{3}-\\frac{1}{2}{v}^{2} \\\\ u-\\frac{1}{3}v\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}3{u}^{2} & -v \\\\ 1 & -\\frac{1}{3}\\end{aligned}| \\\\  & =(3{u}^{2})\\cdot (-\\frac{1}{3})-(1)\\cdot (-v) \\\\  & =v-{u}^{2}.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}v-{u}^{2} & <0 \\\\ v & <{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv={u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052618/assets/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png)"}] [{:db/id #edb/ref 17592186330249 :knowledge-point/_questions [{:knowledge-point/id #uuid "6d82be73-0720-5267-8698-427641b0e66e" :knowledge-point/title "Identifying the Local Area Scale Factor of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8cfebaf-5910-5742-8a6c-15a471b79c7b" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\delta A" :db/id #edb/ref 17592186330251} {:answer/id #uuid "abfd9700-88b9-5b3c-9dc3-ff3b93c6c55a" :answer/type {:db/ident :answer.type/math} :answer/value "16\\,\\delta A" :db/id #edb/ref 17592186330252} {:answer/id #uuid "7616b827-891b-5b8a-9129-bc087ac3f20a" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\delta A" :db/id #edb/ref 17592186330253} {:answer/id #uuid "268f3950-be53-5ecc-9de8-6ef635325811" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186330254} {:answer/id #uuid "0d2aa81a-44a9-55c8-8466-1f6d53626a7d" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\delta A" :db/id #edb/ref 17592186330255}] :answer-field/correct {:answer/id #uuid "268f3950-be53-5ecc-9de8-6ef635325811" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\delta A" :db/id #edb/ref 17592186330254} :answer-field/id #uuid "ff2be419-665e-5ed8-8086-6aa2b42cecac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330250}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "48dd5630-af2d-5230-b0b6-01fe1c189191" :question/math-academy-id "q-161875" :question/problem "Consider a small rectangle $Δ$ whose bottom-left corner is located at the point $(0,3)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta A.$ Which of the following gives the best approximation for the area of the image of this rectangle under the action of the transformation $T,$ given by\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\operatorname{cos}⁡u-{v}^{2} \\\\ u+v\\end{aligned}]?\n$$" :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\text{Area}(T(Δ))≈|\\frac{∂(x,y)}{∂(u,v)}|\\cdot {{\\text{Area}(Δ)}_{⏟}}_{\\delta A}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-\\operatorname{sin}⁡u & -2v \\\\ 1 & 1\\end{aligned}| \\\\  & =(-\\operatorname{sin}⁡u)\\cdot 1-1\\cdot (-2v) \\\\  & =-\\operatorname{sin}⁡u+2v \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(0,3)} & =(-\\operatorname{sin}⁡u+2v)\\,{|}_{u=0\\,v=3} \\\\  & =-\\operatorname{sin}⁡0+2(3) \\\\  & =6\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|6|\\cdot \\delta A \\\\  & =6\\,\\delta A.\\end{aligned}\n$$"}]}
