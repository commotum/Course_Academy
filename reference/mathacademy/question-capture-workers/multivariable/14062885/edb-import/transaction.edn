[{:db/id "q-121903/selection/401132cf29751e5869ebdaa006ab0ae6cdb5d8bcc2d8b2bf2a75d25ff2b694a5" :answer/id #uuid "38af4732-c6e1-552f-b2ef-d77aaaac881d" :answer/type :answer.type/math :answer/value "a=⟨\\frac{3}{3t+2},-\\operatorname{cos}⁡(2t+5)⟩" :db/ensure [:answer/validate]} {:db/id "q-121903/selection/5d4c8981c30ce080d8fca73f447622b70ef8d5811ebf22b89e8b675b343b5d0e" :answer/id #uuid "6daf4367-ac6f-5cad-91e0-736cf4d21717" :answer/type :answer.type/math :answer/value "a=⟨\\frac{1}{3t+2},2\\operatorname{cos}⁡(2t+5)⟩" :db/ensure [:answer/validate]} {:db/id "q-121903/selection/dbf7dcbbb0ab0f4a0a60276d924fa40a9c127aad6dce5f522b11e9c6f8c70757" :answer/id #uuid "f00b4afc-1698-54b1-bacc-9c2953a4c5f5" :answer/type :answer.type/math :answer/value "a=⟨\\frac{3}{3t+2},-2\\operatorname{cos}⁡(2t+5)⟩" :db/ensure [:answer/validate]} {:db/id "q-121903/selection/61c743566ddac75e810ca942c8d31b508d12ae7ce714632d8065ac237807a77f" :answer/id #uuid "7c3928d8-e681-55ba-8ddc-099c59a8b41c" :answer/type :answer.type/math :answer/value "a=⟨\\frac{3}{3t+2},2\\operatorname{cos}⁡(2t+5)⟩" :db/ensure [:answer/validate]} {:db/id "q-121903/selection/de398ba9ada4bfa58da25f35eff821cfe08828ebd4bc4184555d39fc10579030" :answer/id #uuid "ded4d8ba-193e-529f-af58-cb2a84c9d26a" :answer/type :answer.type/math :answer/value "a=⟨\\frac{1}{3t+2},\\operatorname{cos}⁡(2t+5)⟩" :db/ensure [:answer/validate]} {:db/id "q-121903/selection" :answer-field/id #uuid "7ab2f0fd-c1cd-5c59-862d-73cd691950d1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121903/selection/61c743566ddac75e810ca942c8d31b508d12ae7ce714632d8065ac237807a77f" :answer-field/choices ["q-121903/selection/401132cf29751e5869ebdaa006ab0ae6cdb5d8bcc2d8b2bf2a75d25ff2b694a5" "q-121903/selection/5d4c8981c30ce080d8fca73f447622b70ef8d5811ebf22b89e8b675b343b5d0e" "q-121903/selection/dbf7dcbbb0ab0f4a0a60276d924fa40a9c127aad6dce5f522b11e9c6f8c70757" "q-121903/selection/61c743566ddac75e810ca942c8d31b508d12ae7ce714632d8065ac237807a77f" "q-121903/selection/de398ba9ada4bfa58da25f35eff821cfe08828ebd4bc4184555d39fc10579030"] :db/ensure [:answer-field/validate]} {:db/id "q-121903" :question/id #uuid "43a48947-068a-5638-90e7-fa84c34661dc" :question/math-academy-id "q-121903" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨\\operatorname{ln}⁡(3t+2),\\operatorname{sin}⁡(2t+5)⟩,\\,t>0.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(3t+2)),\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t+5))⟩ \\\\  & =⟨\\frac{3}{3t+2},2\\operatorname{cos}⁡(2t+5)⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121903/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a"] :knowledge-point/questions ["q-121903"] :db/ensure [:knowledge-point/validate]} {:db/id "q-121905/selection/d4697108f811f0c65895e742154219dc2d9e35155973be85658db1f65b5bd95d" :answer/id #uuid "ce3dd5c9-2123-504f-b26c-79d05205b550" :answer/type :answer.type/math :answer/value "a=⟨3\\operatorname{ln}⁡|t|,{5}^{5t}⟩" :db/ensure [:answer/validate]} {:db/id "q-121905/selection/ffb39c2a5b096a7fe1b528ab2ebadfee8fdaccc5d9b6a838cc2d2ce250cb2075" :answer/id #uuid "445e6707-8682-56ce-b5c3-8814f18c2cc3" :answer/type :answer.type/math :answer/value "a=⟨-\\frac{3}{{t}^{2}},{5}^{5t+1}\\operatorname{ln}⁡5⟩" :db/ensure [:answer/validate]} {:db/id "q-121905/selection/1decfc6a13871d0860db726b5ea807ca28ad1c994599ac826c8282343a6c1d90" :answer/id #uuid "781cf13e-bc8f-59fb-b1a8-a6c313b8dcad" :answer/type :answer.type/math :answer/value "a=⟨-\\frac{3}{{t}^{2}},{5}^{5t}⟩" :db/ensure [:answer/validate]} {:db/id