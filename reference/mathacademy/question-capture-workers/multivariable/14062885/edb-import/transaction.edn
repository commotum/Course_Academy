c{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}+t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡t)⟩ \\\\  & =⟨9{t}^{2}+1,\\,\\frac{1}{t}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{2}+1),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})⟩ \\\\  & =⟨18t,\\,-\\frac{1}{{t}^{2}}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85606/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-85606"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7164/selection/67d41f3888d4fa4e7d466b8f3b26364240201418bff5731f5b6ddcf0baac9881" :answer/id #uuid "e68b76b9-d065-55bf-bc35-084cfdadaa41" :answer/type :answer.type/math :answer/value "a=⟨8t,\\,12{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-7164/selection/153ddf603acbec1b00c33400e0f475e711f8944c4020434446afca1f05c9563f" :answer/id #uuid "36d8fb1c-134c-55af-a5a0-78fc894eaf04" :answer/type :answer.type/math :answer/value "a=⟨24t,\\,24{t}^{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-7164/selection/ff497a3b50f22431ada032fb813d052eb5b7615da113d6a394e84c512ede2485" :answer/id #uuid "c4f2fe64-460b-5fe9-a56b-4de8bf21e0ef" :answer/type :answer.type/math :answer/value "a=⟨12t,\\,8{t}^{2}+3⟩" :db/ensure [:answer/validate]} {:db/id "q-7164/selection/4c867c6c47faa2ef2915207c51592c7a7cd3720fc51a9b518132144a4c50c68b" :answer/id #uuid "974f7097-fe0e-507e-9341-d013959495c4" :answer/type :answer.type/math :answer/value "a=⟨12{t}^{2},\\,8{t}^{3}+3⟩" :db/ensure [:answer/validate]} {:db/id "q-7164/selection/7a17f0f692020d573db70fda35abca349c352b513c4896ef5d5690996e84664b" :answer/id #uuid "82ad882d-a22