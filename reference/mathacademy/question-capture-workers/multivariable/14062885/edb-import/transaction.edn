{3}+3)⟩ \\\\  & =⟨24t,\\,24{t}^{2}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7164/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-7164"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7161/selection/b6af4edea1838f3ece3bc5adefe094bd0f8a8bf9bc19ad976ba822145e6d9369" :answer/id #uuid "dab636d5-d811-5d17-a4a2-2db4ba9f1c9a" :answer/type :answer.type/math :answer/value "a=⟨9,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-7161/selection/e9d20ffcf400efc62f4986f34c3773b8765ad7d67315cc404b09ae2ad8b1ba4c" :answer/id #uuid "81c2bc4a-6f1d-5447-8a13-e4a07116d64c" :answer/type :answer.type/math :answer/value "a=⟨9t,\\,4⟩" :db/ensure [:answer/validate]} {:db/id "q-7161/selection/5aac5d1cd459662b83312125039a069ba8fb444b8d91901d5e56cf1958c5829b" :answer/id #uuid "b73d3549-178c-54c3-80ed-3a65d484c5f8" :answer/type :answer.type/math :answer/value "a=⟨18,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-7161/selection/1bfa9689e550f8b0c91094dc3515c97492430e93896489852ae4617eb7f2294f" :answer/id #uuid "c4ef811a-8e10-5c7e-936b-97955a02f642" :answer/type :answer.type/math :answer/value "a=⟨18t-12,\\,4⟩" :db/ensure [:answer/validate]} {:db/id "q-7161/selection/af31a279828eb8814f8d2aa8129bd232eeb7d491457cf6030f59b3ebc8a04eaf" :answer/id #uuid "fca32a85-7d54-5a98-a5bd-977cc1b7ca43" :answer/type :answer.type/math :answer/value "a=⟨9,\\,4⟩" :db/ensure [:answer/validate]} {:db/id "q-7161/selection" :answer-field/id #uuid "52e30d46-9317-531a-afb6-41e3d2a6634d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7161/selection/5aac5d1cd459662b83312125039a069ba8fb444b8d91901d5e56cf1958c5829b" :answer-field/choices ["q-7161/selection/b6af4edea1838f3ece3bc5adefe094bd0f8a8bf9bc19ad976ba822145e6d9369" "q-7161/selection/e9d20ffcf400efc62f4986f34c3773b8765ad7d67315cc404b09ae2ad8b1ba4c" "q-7161/selection/5aac5d1cd459662b83312125039a069ba8fb444b8d91901d5e56cf1958c5829b" "q-7161/selection/1bfa9689e550f8b0c91094dc3515c97492430e93896489852ae4617eb7f2294f" "q-7161/selection/af31a279828eb8814f8d2aa8129bd232eeb7d491457cf6030f59b3ebc8a04eaf"] :db/ensure [:answer-field/validate]} {:db/id "q-7161" :question/id #uuid "31054e53-d905-5451-9de9-677fd754227a" :question/math-academy-id "q-7161" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨9{t}^{2}-12t,4t+17⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(9{t}^{2}-12t),\\,\\frac{\\text{d}}{\\text{d}t}(4t+17)⟩ \\\\  & =⟨18t-12,\\,4⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(18t-12),\\,\\frac{\\text{d}}{\\text{d}t}(4)⟩ \\\\  & =⟨18,\\,0⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-7161/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-7161"] :db/ensure [:knowledge-point/validate]} {:db/id "q-347194/field-1/337be854ff98eced745b802dc9795b6ee98850a5731debf63e7609b86cddf0c1" :answer/id #uuid "5e68ca55-d32d-51d8-b3a9-68467d14d99c" :answer/type :answer.type/math :answer/value "6t-4" :db/ensure [:answer/validate]} {:db/id "q-347194/field-1" :answer-field/id #uuid "39bade41-6417-5ab4-ace2-15ca1d04a993" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347194/field-1/337be854ff98eced745b802dc9795b6ee98850a5731debf63e7609b86cddf0c1" :answer-field/choices ["q-347194/field-1/337be854ff98eced745b802dc9795b6ee98850a5731debf63e7609b86cddf0c1"] :db/ensure [:answer-field/validate]} {:db/id "q-347194/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "61965800-427b-5bc6-adf2-d5fa618ef34e" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-347194/field-2" :answer-field/id #uuid "56ee3ea1-c906-5563-a435-bc6be0cf3ead" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-347194/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer-field/choices ["q-347194/field-2/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-347194" :question/id #uuid "67991967-f7bb-54ed-b772-128dcf9244a5" :question/math-academy-id "q-347194" :question/problem "The position vector $r(t)$ of a particle $P$ relative to a fixed origin $O$ at time $t$ is given by\n\n$$\nr(t)=⟨{t}^{2}(t-2),\\,t(3-t)⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t.$\n\n$a=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}(t-2)),\\,\\frac{\\text{d}}{\\text{d}t}(t(3-t))⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{3}-2{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(3t-{t}^{2})⟩ \\\\  & =⟨3{t}^{2}-4t,\\,3-2t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-4t),\\,\\frac{\\text{d}}{\\text{d}t}(3-2t)⟩ \\\\  & =⟨6t-4,\\,-2⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-347194/field-1" "q-347194/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "380357c3-4914-5137-9449-0e02076cb248"] :knowledge-point/questions ["q-347194"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-31683"] :question/problem "The position vector $r,$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\nr=⟨4{t}^{3/2}+4{t}^{2}+5,\\,{t}^{3}-4{t}^{2}+t⟩,\\,t>0.\n$$\n\nCalculate the magnitude of the acceleration of $P$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(4{t}^{3/2}+4{t}^{2}+5),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{3}-4{t}^{2}+t)⟩ \\\\  & =⟨6{t}^{1/2}+8t,\\,3{t}^{2}-8t+1⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{1/2}+8t),\\,\\frac{\\text{d}}{\\text{d}t}(3{t}^{2}-8t+1)⟩ \\\\  & =⟨3{t}^{-1/2}+8,\\,6t-8⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨3(1)^{-1/2}+8,\\,6(1)-8⟩ \\\\  & =⟨3+8,\\,6-8⟩ \\\\  & =⟨11,\\,-2⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$\n\n$$\n\\begin{aligned}|a(1)| & =|⟨11,\\,-2⟩| \\\\  & =\\sqrt{{11}^{2}+(-2)^{2}} \\\\  & =\\sqrt{125} \\\\  & =5\\sqrt{5}\\,{\\text{m/s}}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-121936/selection/ed50cd9d43dd4c3a8342ad453a1f314a46bb8f11b75ac8d24dde3e5685031a57" :answer/id #uuid "c663ccd1-d9e6-5da3-88d4-ea1082cfe0ba" :answer/type :answer.type/math :answer/value "a(1)=⟨\\frac{1}{2},12⟩" :db/ensure [:answer/validate]} {:db/id "q-121936/selection/9321ba344f1163e1a01c0006dbdaf943e53844660931b96aa4b8badd14f2f93f" :answer/id #uuid "ad44ddf1-5a33-5936-a333-a1d49920ed69" :answer/type :answer.type/math :answer/value "a(1)=⟨-\\frac{1}{4},12⟩" :db/ensure [:answer/validate]} {:db/id "q-121936/selection/3c4b7b26be4f0c1917e0cb14171b885d1f6186d6c9c20b88aa2051180618dc08" :answer/id #uuid "382fd4dd-1eca-5cc5-9ead-3b98b07ea2aa" :answer/type :answer.type/math :answer/value "a(1)=⟨\\frac{1}{2},16⟩" :db/ensure [:answer/validate]} {:db/id "q-121936/selection/a543a3f0a9e462fb605e843d466280956a567632d0f52694c3d164d8ccbadce9" :answer/id #uuid "e1b82a1c-14c1-536f-89d1-ddd69ffd59ea" :answer/type :answer.type/math :answer/value "a(1)=⟨-\\frac{1}{2},24⟩" :db/ensure [:answer/validate]} {:db/id "q-121936/selection/d3802eb7e102a96fc95151d2eb394d4cab2a1c5d32b0ed9d3b9e316af7ffcd1a" :answer/id #uuid "682f9f9b-92fb-51ad-a686-6463d1884cff" :answer/type :answer.type/math :answer/value "a(1)=⟨-\\frac{1}{4},24⟩" :db/ensure [:answer/validate]} {:db/id "q-121936/selection" :answer-field/id #uuid "30c7a00b-c034-581d-a1be-37ac3cb7f9d6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-121936/selection/d3802eb7e102a96fc95151d2eb394d4cab2a1c5d32b0ed9d3b9e316af7ffcd1a" :answer-field/choices ["q-121936/selection/ed50cd9d43dd4c3a8342ad453a1f314a46bb8f11b75ac8d24dde3e5685031a57" "q-121936/selection/9321ba344f1163e1a01c0006dbdaf943e53844660931b96aa4b8badd14f2f93f" "q-121936/selection/3c4b7b26be4f0c1917e0cb14171b885d1f6186d6c9c20b88aa2051180618dc08" "q-121936/selection/a543a3f0a9e462fb605e843d466280956a567632d0f52694c3d164d8ccbadce9" "q-121936/selection/d3802eb7e102a96fc95151d2eb394d4cab2a1c5d32b0ed9d3b9e316af7ffcd1a"] :db/ensure [:answer-field/validate]} {:db/id "q-121936" :question/id #uuid "84c7731a-fdb1-5923-b13d-b64da6ea7881" :question/math-academy-id "q-121936" :question/problem "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{ln}⁡(t+1),2{t}^{4}+3⟩,\\,t>0.\n$$\n\nCalculate the acceleration vector $a$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t+1)),\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}+3)⟩ \\\\  & =⟨\\frac{1}{t+1},8{t}^{3}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t+1}),\\frac{\\text{d}}{\\text{d}t}(8{t}^{3})⟩ \\\\  & =⟨-\\frac{1}{(t+1)^{2}},24{t}^{2}⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨-\\frac{1}{(1+1)^{2}},24({1}^{2})⟩ \\\\  & =⟨-\\frac{1}{4},24⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-121936/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-121936"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351408/field-1/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" :answer/id #uuid "99d59a7d-7210-5e4d-88e4-11b81e7493aa" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "q-351408/field-1" :answer-field/id #uuid "38b0a552-615b-5d02-8c6a-fe487a7924e7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351408/field-1/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" :answer-field/choices ["q-351408/field-1/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991"] :db/ensure [:answer-field/validate]} {:db/id "q-351408" :question/id #uuid "cfb11e6b-560c-5708-9869-67798680388b" :question/math-academy-id "q-351408" :question/problem "The position vector $r,$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\nr=⟨5{t}^{3}-2{t}^{2}+3,\\,{t}^{4}-3{t}^{2}+1⟩.\n$$\n\nCalculate the magnitude of the acceleration of $P$ at time $t=2\\,\\text{s}.$ Do not round the answer.\n\nThe magnitude of the acceleration is\n{{field-1}}\n${\\text{m/s}}^{2}$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(5{t}^{3}-2{t}^{2}+3),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{4}-3{t}^{2}+1)⟩ \\\\  & =⟨15{t}^{2}-4t,\\,4{t}^{3}-6t⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(15{t}^{2}-4t),\\,\\frac{\\text{d}}{\\text{d}t}(4{t}^{3}-6t)⟩ \\\\  & =⟨30t-4,\\,12{t}^{2}-6⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=2,$ we substitute $t=2$ into the above:\n\n$$\n\\begin{aligned}a(2) & =⟨30(2)-4,\\,12(2)^{2}-6⟩ \\\\  & =⟨60-4,\\,48-6⟩ \\\\  & =⟨56,\\,42⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(2)|:$\n\n$$\n\\begin{aligned}|a(2)| & =|⟨56,\\,42⟩| \\\\  & =\\sqrt{{56}^{2}+{42}^{2}} \\\\  & =\\sqrt{3136+1764} \\\\  & =\\sqrt{4900} \\\\  & =70\\end{aligned}\n$$\n\nSo, the magnitude of the acceleration at time $t=2\\,\\text{s}$ is $70{\\text{ m/s}}^{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351408/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-351408"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82337/selection/351ea70b0cedc52eb06a8a64d86d842671fc5d57c6fa522851ff5c4ffb136a30" :answer/id #uuid "81a09d16-6c65-5bf3-9e8b-2626b3cbae74" :answer/type :answer.type/math :answer/value "\\sqrt{5}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82337/selection/b9d9a7b6df1ddd3c65d662f5020088d11dbf9c3b58316bfb4fbfb80298b68246" :answer/id #uuid "d3d1c75a-1781-5b57-9788-c174553bca0b" :answer/type :answer.type/math :answer/value "1\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82337/selection/33abccbb767addf718fd954c8c85066179e2aa0bd7a9add3c72f943b27feb156" :answer/id #uuid "fe85321d-165d-57a4-9d78-cafeec0ed22e" :answer/type :answer.type/math :answer/value "2\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82337/selection/b960cd812aee4038a9cb1c7388b12ed8a6c157b55617d3dab74ea23e82ab9fb9" :answer/id #uuid "e4995511-073c-57cc-9257-453e5cea5b99" :answer/type :answer.type/math :answer/value "\\sqrt{3}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82337/selection/4fc2ed9ac4922fbbdc874f1df4970fc125e4d4160b4ed893ae4ba4ab6e666e8d" :answer/id #uuid "4d813664-675b-5d71-a8ec-ce91b44a914f" :answer/type :answer.type/math :answer/value "\\sqrt{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82337/selection" :answer-field/id #uuid "eff36480-71e7-5245-85ea-bc6b9c2295ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82337/selection/351ea70b0cedc52eb06a8a64d86d842671fc5d57c6fa522851ff5c4ffb136a30" :answer-field/choices ["q-82337/selection/351ea70b0cedc52eb06a8a64d86d842671fc5d57c6fa522851ff5c4ffb136a30" "q-82337/selection/b9d9a7b6df1ddd3c65d662f5020088d11dbf9c3b58316bfb4fbfb80298b68246" "q-82337/selection/33abccbb767addf718fd954c8c85066179e2aa0bd7a9add3c72f943b27feb156" "q-82337/selection/b960cd812aee4038a9cb1c7388b12ed8a6c157b55617d3dab74ea23e82ab9fb9" "q-82337/selection/4fc2ed9ac4922fbbdc874f1df4970fc125e4d4160b4ed893ae4ba4ab6e666e8d"] :db/ensure [:answer-field/validate]} {:db/id "q-82337" :question/id #uuid "4a4780c3-0145-50d6-a5b4-086eefdf5f1d" :question/math-academy-id "q-82337" :question/problem "The position vector $r,$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\nr=⟨\\frac{4}{1+t},\\,\\frac{{t}^{3}}{3}-4t+5⟩.\n$$\n\nCalculate the magnitude of the acceleration of $P$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{1+t}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{3}}{3}-4t+5)⟩ \\\\  & =⟨-\\frac{4}{(1+t)^{2}},\\,{t}^{2}-4⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\frac{4}{(1+t)^{2}}),\\,\\frac{\\text{d}}{\\text{d}t}({t}^{2}-4)⟩ \\\\  & =⟨\\frac{8}{(1+t)^{3}},\\,2t⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨\\frac{8}{(1+(1))^{3}},\\,2(1)⟩ \\\\  & =⟨\\frac{8}{{2}^{3}},\\,2⟩ \\\\  & =⟨1,\\,2⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$\n\n$$\n\\begin{aligned}|a(1)| & =|⟨1,\\,2⟩| \\\\  & =\\sqrt{(1)^{2}+(2)^{2}} \\\\  & =\\sqrt{5}\\,{\\text{m/s}}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-82337/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-82337"] :db/ensure [:knowledge-point/validate]} {:db/id "q-82336/selection/6619fdcc2d525a6f504d1d4316af3a6cbe5f69229a257c1a4e5f8809a59d6a1d" :answer/id #uuid "7d8fe543-852f-57b0-b186-caa2887c49bb" :answer/type :answer.type/math :answer/value "6\\sqrt{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82336/selection/7840431518d982641154c796c28267de371bed48ce258d638a94356662b5a0e9" :answer/id #uuid "1c4a2cfe-aa0e-5987-b0a0-a75d7aae4be4" :answer/type :answer.type/math :answer/value "10\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82336/selection/37f95545484edfc694aa14303e73403c847843f17b3c0a28b07fcacff44af0ca" :answer/id #uuid "27fb404a-88b1-54fc-8ec5-28c5c7673898" :answer/type :answer.type/math :answer/value "8\\sqrt{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82336/selection/aaadf8d2d6216af4c8d065895fa8b4e1c6257905923832532ca2d16a4550e365" :answer/id #uuid "12a79e21-9bae-5a90-a744-1a52cdd245c4" :answer/type :answer.type/math :answer/value "12\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82336/selection/6765b4aeae8ba170d978922dc201c92cd8a2096c4f1449b7363f20c80434563d" :answer/id #uuid "c7951422-b3f9-5efb-ac58-60b9083537a4" :answer/type :answer.type/math :answer/value "8\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-82336/selection" :answer-field/id #uuid "42ac0cba-fab2-5e71-a6b4-99da97665d1f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-82336/selection/7840431518d982641154c796c28267de371bed48ce258d638a94356662b5a0e9" :answer-field/choices ["q-82336/selection/6619fdcc2d525a6f504d1d4316af3a6cbe5f69229a257c1a4e5f8809a59d6a1d" "q-82336/selection/7840431518d982641154c796c28267de371bed48ce258d638a94356662b5a0e9" "q-82336/selection/37f95545484edfc694aa14303e73403c847843f17b3c0a28b07fcacff44af0ca" "q-82336/selection/aaadf8d2d6216af4c8d065895fa8b4e1c6257905923832532ca2d16a4550e365" "q-82336/selection/6765b4aeae8ba170d978922dc201c92cd8a2096c4f1449b7363f20c80434563d"] :db/ensure [:answer-field/validate]} {:db/id "q-82336" :question/id #uuid "868c512c-982f-5237-99ba-2683392bb64c" :question/math-academy-id "q-82336" :question/problem "The position vector $r,$ in meters, of a particle $P$ relative to a fixed origin $O$ at time $t$ seconds is given by\n\n$$\nr=⟨2{t}^{3}+3{t}^{2}+5t,\\,2{t}^{4}-4{t}^{2}+t+1⟩.\n$$\n\nCalculate the magnitude of the acceleration of $P$ at time $t=0.$" :question/worked-solution "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\,\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}+3{t}^{2}+5t),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}-4{t}^{2}+t+1)⟩ \\\\  & =⟨6{t}^{2}+6t+5,\\,8{t}^{3}-8t+1⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}+6t+5),\\,\\frac{\\text{d}}{\\text{d}t}(8{t}^{3}-8t+1)⟩ \\\\  & =⟨12t+6,\\,24{t}^{2}-8⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=0,$ we substitute $t=0$ into the above:\n\n$$\n\\begin{aligned}a(0) & =⟨12(0)+6,\\,24(0)-8⟩ \\\\  & =⟨6,\\,-8⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(0)|:$\n\n$$\n\\begin{aligned}|a(0)| & =|⟨6,\\,-8⟩| \\\\  & =\\sqrt{{6}^{2}+(-8)^{2}} \\\\  & =\\sqrt{100} \\\\  & =10\\,{\\text{m/s}}^{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-82336/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "17408599-c601-5c8c-96a7-da7566ba07c1"] :knowledge-point/questions ["q-82336"] :db/ensure [:knowledge-point/validate]}]
