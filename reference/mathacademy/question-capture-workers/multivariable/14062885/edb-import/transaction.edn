me{ln}⁡5⟩ \\\\  & =⟨-\\frac{3}{{t}^{2}},{5}^{5t+1}\\operatorname{ln}⁡5⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-121905/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a"] :knowledge-point/questions ["q-121905"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85598/selection/a04e88b34d9208dd70eb20b8033d7197ea57933775b265848805293cd07e21f1" :answer/id #uuid "21929703-6bb8-5787-944d-872761546592" :answer/type :answer.type/math :answer/value "a=⟨t,\\,{e}^{2t}⟩" :db/ensure [:answer/validate]} {:db/id "q-85598/selection/50aad33e9cd0cf064cfb281a7c7836191e046e7c39505d9050742e3093858ef0" :answer/id #uuid "c3212023-6ce1-5c35-90ac-8364065524f4" :answer/type :answer.type/math :answer/value "a=⟨2t,\\,{e}^{2t}⟩" :db/ensure [:answer/validate]} {:db/id "q-85598/selection/3aa724f70cdc94af7e70191b1901b220880c8cf93416fa88fbd636065139211b" :answer/id #uuid "42467ef3-40ae-5c36-8638-0c4ec936f823" :answer/type :answer.type/math :answer/value "a=⟨\\frac{t}{2},\\,\\frac{{e}^{2t}}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-85598/selection/9ee0dbe92eac8b4a92390ac848f753a7b3620582fdcc39fbca3f5f27298d4407" :answer/id #uuid "4ca77076-178f-5ff1-a35a-4e6c91ab8e19" :answer/type :answer.type/math :answer/value "a=⟨2t,\\,2{e}^{2t}⟩" :db/ensure [:answer/validate]} {:db/id "q-85598/selection/6b8fa31dcf672491c52c83958799ceb5f4f7bd49b02c2389f93968c605d53eac" :answer/id #uuid "f5d6b64d-1f78-59ee-982a-ea07c7f36381" :answer/type :answer.type/math :answer/value "a=⟨\\frac{t}{2},\\,\\frac{{e}^{2t}}{4}⟩" :db/ensure [:answer/validate]} {:db/id "q-85598/selection" :answer-field/id #uuid "c693e03d-ff54-5478-8511-2dea24d4a29b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85598/selection/9ee0dbe92eac8b4a92390ac848f753a7b3620582fdcc39fbca3f5f27298d4407" :answer-field/choices ["q-85598/selection/a04e88b34d9208dd70eb20b8033d7197ea57933775b265848805293cd07e21f1" "q-85598/selection/50aad33e9cd0cf064cfb281a7c7836191e046e7c39505d9050742e3093858ef0" "q-85598/selection/3aa724f70cdc94af7e70191b1901b220880c8cf93416fa88fbd636065139211b" "q-85598/selection/9ee0dbe92eac8b4a92390ac848f753a7b3620582fdcc39fbca3f5f27298d4407" "q-85598/selection/6b8fa31dcf672491c52c83958799ceb5f4f7bd49b02c2389f93968c605d53eac"] :db/ensure [:answer-field/validate]} {:db/id "q-85598" :question/id #uuid "2ba6af89-af5f-56af-a9e0-160f4f71aca0" :question/math-academy-id "q-85598" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨{t}^{2},\\,{e}^{2t}⟩.\n$$\n\nCalculate the acceleration vector $a.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}({t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}({e}^{2t})⟩ \\\\  & =⟨2t,\\,2{e}^{2t}⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-85598/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a"] :knowledge-point/questions ["q-85598"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351105/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer/id #uuid "e9fde25d-829b-5534-b667-fa77dca28186" :answer/type :answer.type/math :answer/value "-4" :db/ensure [:answer/validate]} {:db/id "q-351105/field-1" :answer-field/id #uuid "ff9146f8-8b0f-583b-af69-5c2e47619d16" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351105/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473" :answer-field/choices ["q-351105/field-1/ae9425c9e204310ed598f729a242e0b42a2acbbf125bff30bc2080e10b8cf473"] :db/ensure [:answer-field/validate]} {:db/id "q-351105/field-2/fad1c1f465a41ebbc107311b8b4c37bc3966c4a0443843d15405174386287cfd" :answer/id #uuid "4fe473a9-a6bd-5400-8bb5-eeed97176ff4" :answer/type :answer.type/math :answer/value "10t" :db/ensure [:answer/validate]} {:db/id "q-351105/field-2" :answer-field/id #uuid "63a0a0e8-1289-5861-982f-6e9b527da633" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351105/field-2/fad1c1f465a41ebbc107311b8b4c37bc3966c4a0443843d15405174386287cfd" :answer-field/choices ["q-351105/field-2/fad1c1f465a41ebbc107311b8b4c37bc3966c4a0443843d15405174386287cfd"] :db/ensure [:answer-field/validate]} {:db/id "q-351105" :question/id #uuid "41765b61-0c63-549f-bc39-5fe82b7953db" :question/math-academy-id "q-351105" :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨-4t+8,\\,5{t}^{2}+1⟩.\n$$\n\nCalculate the components of the acceleration vector $a$ at time $t.$\n\n$a=⟨${{field-1}},{{field-2}}$⟩$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(-4t+8),\\,\\frac{\\text{d}}{\\text{d}t}(5{t}^{2}+1)⟩ \\\\  & =⟨-4,\\,10t⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-351105/field-1" "q-351105/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9ec9e0af-bbdc-5a29-bdbb-602e4d1f016a"] :knowledge-point/questions ["q-351105"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-6392"] :question/problem "The velocity vector $v=⟨u,v⟩$ of a particle $P$ at time $t$ is given by\n\n$$\nv=⟨3{t}^{3},\\,-\\frac{1}{2}{t}^{2}⟩.\n$$\n\nCalculate the acceleration vector $a$ at time $t=3.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\frac{1}{2}{t}^{2})⟩ \\\\  & =⟨9{t}^{2},\\,-t⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=3,$ we substitute $t=3$ into the above:\n\n$$\n\\begin{aligned}a(3) & =⟨9(3)^{2},\\,-3⟩ \\\\  & =⟨9\\cdot 9,\\,-3⟩ \\\\  & =⟨81,\\,-3⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-31671/selection/3894d00170ee7dace48b558f42dff9ab662c24f7f1d7ab528307f155c27efe65" :answer/id #uuid "40ba6d8a-4c4a-5fb6-b297-d60960e7da44" :answer/type :answer.type/math :answer/value "6\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-31671/selection/fdafa6d2d0901921ff7eca46289c5805f6f7ced6443835ccc4e02ad825b87022" :answer/id #uuid "b9409f53-7b6c-5184-ad44-b1ed5baf7101" :answer/type :answer.type/math :answer/value "\\sqrt{52}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-31671/selection/d67d3a1947731bff39dc40c6763f76bfb7fd201fc2a14a9c06c32fcc36144300" :answer/id #uuid "ec289176-400e-5634-aa4c-2db09e24881a" :answer/type :answer.type/math :answer/value "0\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-31671/selection/6619fdcc2d525a6f504d1d4316af3a6cbe5f69229a257c1a4e5f8809a59d6a1d" :answer/id #uuid "e93789d8-ac93-5def-a265-1f86a42c9c88" :answer/type :answer.type/math :answer/value "6\\sqrt{2}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-31671/selection/16357e3e569b4e8fb2cb0b59298867bfe83c380b9e7a3e8dec3798ec00527246" :answer/id #uuid "55230c03-bfee-509e-a55b-9b6422e711d4" :answer/type :answer.type/math :answer/value "3\\sqrt{5}\\,{\\text{m/s}}^{2}" :db/ensure [:answer/validate]} {:db/id "q-31671/selection" :answer-field/id #uuid "fc5d598e-871a-5844-82eb-e2f4b0a36d5a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-31671/selection/6619fdcc2d525a6f504d1d4316af3a6cbe5f69229a257c1a4e5f8809a59d6a1d" :answer-field/choices ["q-31671/selection/3894d00170ee7dace48b558f42dff9ab662c24f7f1d7ab528307f155c27efe65" "q-31671/selection/fdafa6d2d0901921ff7eca46289c5805f6f7ced6443835ccc4e02ad825b87022" "q-31671/selection/d67d3a1947731bff39dc40c6763f76bfb7fd201fc2a14a9c06c32fcc36144300" "q-31671/selection/6619fdcc2d525a6f504d1d4316af3a6cbe5f69229a257c1a4e5f8809a59d6a1d" "q-31671/selection/16357e3e569b4e8fb2cb0b59298867bfe83c380b9e7a3e8dec3798ec00527246"] :db/ensure [:answer-field/validate]} {:db/id "q-31671" :question/id #uuid "e3dbd7ad-eccb-55d6-ad64-5592f4cbc3f0" :question/math-academy-id "q-31671" :question/problem "The velocity vector $v=⟨u,v⟩,$ measured in $\\text{m}/\\text{s},$ of a particle $P$ at time $t$ seconds, is given by\n\n$$\nv=⟨6t+1,-3{t}^{2}⟩.\n$$\n\nFind the magnitude of the acceleration of $P$ at time $t=1.$" :question/worked-solution "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6t+1),\\,\\frac{\\text{d}}{\\text{d}t}(-3{t}^{2})⟩ \\\\  & =⟨6,\\,-6t⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨6,-6(1)⟩ \\\\  & =⟨-6,6⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$ \n\n$$\n\\begin{aligned}|a(1)| & =|⟨-6,6⟩| \\\\  & =\\sqrt{(-6)^{2}+({6}^{2})} \\\\  & =\\sqrt{2\\cdot 36} \\\\  & =6\\sqrt{2}\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-31671/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "318d38c5-d3fb-52bf-8a88-5592f8301f89"] :knowledge-point/questions ["q-31671"] :db/ensure [:knowledge-point/validate]} {:db/id "q-31676/selection/1d002