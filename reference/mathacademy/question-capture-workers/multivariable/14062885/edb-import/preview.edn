ln}⁡5⟩\\end{aligned}\n$$" 13194139535343 true] [17592186344811 1000 #edb/ref 17592186344812 13194139535343 true] [17592186344811 1000 #edb/ref 17592186344813 13194139535343 true] [17592186344811 1000 #edb/ref 17592186344814 13194139535343 true] [17592186344811 1000 #edb/ref 17592186344815 13194139535343 true] [17592186344811 1000 #edb/ref 17592186344816 13194139535343 true] [17592186344811 1040 #edb/ref 17592186045450 13194139535343 true] [17592186344811 1041 "selection" 13194139535343 true] [17592186344811 1104 #edb/ref 17592186344816 13194139535343 true] [17592186344811 1110 #uuid "e2de2320-b583-5707-95e5-aa6bfa6d99e8" 13194139535343 true] [17592186344812 1034 "a=⟨-\\frac{3}{{t}^{2}},{5}^{5t}⟩" 13194139535343 true] [17592186344812 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344812 1111 #uuid "781cf13e-bc8f-59fb-b1a8-a6c313b8dcad" 13194139535343 true] [17592186344813 1034 "a=⟨3\\operatorname{ln}⁡|t|,{5}^{5t+1}\\operatorname{ln}⁡5⟩" 13194139535343 true] [17592186344813 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344813 1111 #uuid "774e39ae-247f-5627-b4b7-02742a8affb0" 13194139535343 true] [17592186344814 1034 "a=⟨3\\operatorname{ln}⁡|t|,{5}^{5t}⟩" 13194139535343 true] [17592186344814 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344814 1111 #uuid "ce3dd5c9-2123-504f-b26c-79d05205b550" 13194139535343 true] [17592186344815 1034 "a=⟨-\\frac{3}{{t}^{2}},{5}^{5t}\\operatorname{ln}⁡5⟩" 13194139535343 true] [17592186344815 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344815 1111 #uuid "9e657162-a117-5602-8bd0-1d3fde7047a3" 13194139535343 true] [17592186344816 1034 "a=⟨-\\frac{3}{{t}^{2}},{5}^{5t+1}\\operatorname{ln}⁡5⟩" 13194139535343 true] [17592186344816 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344816 1111 #uuid "445e6707-8682-56ce-b5c3-8814f18c2cc3" 13194139535343 true] [17592186344817 1017 #edb/ref 17592186344818 13194139535343 true] [17592186344817 1089 "q-121936" 13194139535343 true] [17592186344817 1091 #edb/ref 17592186045465 13194139535343 true] [17592186344817 1100 "The position vector $r$ of a particle $P$ (relative to a fixed origin $O$) at time $t$ is given by\n\n$$\nr=⟨\\operatorname{ln}⁡(t+1),2{t}^{4}+3⟩,\\,t>0.\n$$\n\nCalculate the acceleration vector $a$ at time $t=1.$" 13194139535343 true] [17592186344817 1113 #uuid "84c7731a-fdb1-5923-b13d-b64da6ea7881" 13194139535343 true] [17592186344817 1145 "To compute the acceleration vector, we need to differentiate the velocity vector. So first, we need to compute the velocity vector, which we can do this by differentiating the position vector:\n\n$$\n\\begin{aligned}v & =\\frac{\\text{d}r}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}x}{\\text{d}t},\\frac{\\text{d}y}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(t+1)),\\frac{\\text{d}}{\\text{d}t}(2{t}^{4}+3)⟩ \\\\  & =⟨\\frac{1}{t+1},8{t}^{3}⟩\\end{aligned}\n$$\n\nNow, to compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t+1}),\\frac{\\text{d}}{\\text{d}t}(8{t}^{3})⟩ \\\\  & =⟨-\\frac{1}{(t+1)^{2}},24{t}^{2}⟩\\end{aligned}\n$$\n\nFinally, to find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨-\\frac{1}{(1+1)^{2}},24({1}^{2})⟩ \\\\  & =⟨-\\frac{1}{4},24⟩\\end{aligned}\n$$" 13194139535343 true] [17592186344818 1000 #edb/ref 17592186344819 13194139535343 true] [17592186344818 1000 #edb/ref 17592186344820 13194139535343 true] [17592186344818 1000 #edb/ref 17592186344821 13194139535343 true] [17592186344818 1000 #edb/ref 17592186344822 13194139535343 true] [17592186344818 1000 #edb/ref 17592186344823 13194139535343 true] [17592186344818 1040 #edb/ref 17592186045450 13194139535343 true] [17592186344818 1041 "selection" 13194139535343 true] [17592186344818 1104 #edb/ref 17592186344822 13194139535343 true] [17592186344818 1110 #uuid "30c7a00b-c034-581d-a1be-37ac3cb7f9d6" 13194139535343 true] [17592186344819 1034 "a(1)=⟨\\frac{1}{2},16⟩" 13194139535343 true] [17592186344819 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344819 1111 #uuid "382fd4dd-1eca-5cc5-9ead-3b98b07ea2aa" 13194139535343 true] [17592186344820 1034 "a(1)=⟨-\\frac{1}{4},12⟩" 13194139535343 true] [17592186344820 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344820 1111 #uuid "ad44ddf1-5a33-5936-a333-a1d49920ed69" 13194139535343 true] [17592186344821 1034 "a(1)=⟨-\\frac{1}{2},24⟩" 13194139535343 true] [17592186344821 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344821 1111 #uuid "e1b82a1c-14c1-536f-89d1-ddd69ffd59ea" 13194139535343 true] [17592186344822 1034 "a(1)=⟨-\\frac{1}{4},24⟩" 13194139535343 true] [17592186344822 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344822 1111 #uuid "682f9f9b-92fb-51ad-a686-6463d1884cff" 13194139535343 true] [17592186344823 1034 "a(1)=⟨\\frac{1}{2},12⟩" 13194139535343 true] [17592186344823 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344823 1111 #uuid "c663ccd1-d9e6-5da3-88d4-ea1082cfe0ba" 13194139535343 true] [17592186344824 1017 #edb/ref 17592186344825 13194139535343 true] [17592186344824 1089 "q-31671" 13194139535343 true] [17592186344824 1091 #edb/ref 17592186045465 13194139535343 true] [17592186344824 1100 "The velocity vector $v=⟨u,v⟩,$ measured in $\\text{m}/\\text{s},$ of a particle $P$ at time $t$ seconds, is given by\n\n$$\nv=⟨6t+1,-3{t}^{2}⟩.\n$$\n\nFind the magnitude of the acceleration of $P$ at time $t=1.$" 13194139535343 true] [17592186344824 1113 #uuid "e3dbd7ad-eccb-55d6-ad64-5592f4cbc3f0" 13194139535343 true] [17592186344824 1145 "To compute the acceleration vector, we differentiate the velocity vector:\n\n$$\n\\begin{aligned}a & =\\frac{\\text{d}v}{\\text{d}t} \\\\  & =⟨\\frac{\\text{d}u}{\\text{d}t},\\,\\frac{\\text{d}v}{\\text{d}t}⟩ \\\\  & =⟨\\frac{\\text{d}}{\\text{d}t}(6t+1),\\,\\frac{\\text{d}}{\\text{d}t}(-3{t}^{2})⟩ \\\\  & =⟨6,\\,-6t⟩\\end{aligned}\n$$\n\nTo find the acceleration at time $t=1,$ we substitute $t=1$ into the above:\n\n$$\n\\begin{aligned}a(1) & =⟨6,-6(1)⟩ \\\\  & =⟨-6,6⟩\\end{aligned}\n$$\n\nFinally, to find the magnitude of the acceleration, we compute $|a(1)|:$ \n\n$$\n\\begin{aligned}|a(1)| & =|⟨-6,6⟩| \\\\  & =\\sqrt{(-6)^{2}+({6}^{2})} \\\\  & =\\sqrt{2\\cdot 36} \\\\  & =6\\sqrt{2}\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" 13194139535343 true] [17592186344825 1000 #edb/ref 17592186344826 13194139535343 true] [17592186344825 1000 #edb/ref 17592186344827 13194139535343 true] [17592186344825 1000 #edb/ref 17592186344828 13194139535343 true] [17592186344825 1000 #edb/ref 17592186344829 13194139535343 true] [17592186344825 1000 #edb/ref 17592186344830 13194139535343 true] [17592186344825 1040 #edb/ref 17592186045450 13194139535343 true] [17592186344825 1041 "selection" 13194139535343 true] [17592186344825 1104 #edb/ref 17592186344828 13194139535343 true] [17592186344825 1110 #uuid "fc5d598e-871a-5844-82eb-e2f4b0a36d5a" 13194139535343 true] [17592186344826 1034 "3\\sqrt{5}\\,{\\text{m/s}}^{2}" 13194139535343 true] [17592186344826 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344826 1111 #uuid "55230c03-bfee-509e-a55b-9b6422e711d4" 13194139535343 true] [17592186344827 1034 "6\\,{\\text{m/s}}^{2}" 13194139535343 true] [17592186344827 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344827 1111 #uuid "40ba6d8a-4c4a-5fb6-b297-d60960e7da44" 13194139535343 true] [17592186344828 1034 "6\\sqrt{2}\\,{\\text{m/s}}^{2}" 13194139535343 true] [17592186344828 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344828 1111 #uuid "e93789d8-ac93-5def-a265-1f86a42c9c88" 13194139535343 true] [17592186344829 1034 "0\\,{\\text{m/s}}^{2}" 13194139535343 true] [17592186344829 1103 #edb/ref 17592186045453 13194139535343 true] [17592186344829 1111 #uuid "ec289176-400e-5634-aa4c-2db09e24881a" 1319413