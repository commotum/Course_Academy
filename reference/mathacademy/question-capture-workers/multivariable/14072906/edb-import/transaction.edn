/math-academy-id "q-7611" :question/problem "What is the center of the ellipse  $\\frac{(x-3)^{2}}{16}+\\frac{(y-2)^{2}}{9}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=3$ and $k=2,$ so the center is located at $(3,2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7611/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7"] :knowledge-point/questions ["q-7611"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-7619"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072906/assets/2bc4b82c6cfae63026f221dd49cdc74a9ce3884443e933cae02c36f6d732707e.png)\n\nWhat is the equation of the ellipse given above?" :db/ensure [:question/validate]} {:db/id "q-16548/selection/769d3496fe845563a9d465f914cdbf8ba3da4506356a19655f0b859598d5fedf" :answer/id #uuid "2de53df5-06e4-5121-a129-ed3672717e72" :answer/type :answer.type/text :answer/value "$2\\sqrt{5}$ and $2\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-16548/selection/29bdcb9671bde17c7d6317cadace7fe356f84bfbc89d11b88cb54392dc529b8e" :answer/id #uuid "2073f727-f605-5e91-b847-f9e19272624c" :answer/type :answer.type/text :answer/value "$2\\sqrt{5}$ and $\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-16548/selection/8b83ad520c122b6bf9f0447fd08ee7748fd4a02ebbad7be118c0cd4d30cc7890" :answer/id #uuid "1cb69cb6-49d7-5625-9f20-c7276b5be964" :answer/type :answer.type/text :answer/value "$2$ and $\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-16548/selection/d826542d60cf90edb1a08622a3232b5f60ac38a470abdd32b384ab4acb717119" :answer/id #uuid "6be03a1c-4ab8-5873-be88-bc55894420a2" :answer/type :answer.type/text :answer/value "$\\sqrt{5}$ and $\\sqrt{2}$" :db/ensure [:answer/validate]} {:db/id "q-16548/selection/d5c68d29aa39f29064cc0355f6208093983fe13ae1fc2edc0d804d629f6dfc63" :answer/id #uuid "f914e198-512f-5d0f-bab9-e5653ba8e114" :answer/type :answer.type/text :answer/value "$2\\sqrt{5}$ and $2$" :db/ensure [:answer/validate]} {:db/id "q-16548/selection" :answer-field/id #uuid "0d149ec3-1bda-5a45-85df-69addf9bf489" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-16548/selection/769d3496fe845563a9d465f914cdbf8ba3da4506356a19655f0b859598d5fedf" :answer-field/choices ["q-16548/selection/769d3496fe845563a9d465f914cdbf8ba3da4506356a19655f0b859598d5fedf" "q-16548/selection/29bdcb9671bde17c7d6317cadace7fe356f84bfbc89d11b88cb54392dc529b8e" "q-16548/selection/8b83ad520c122b6bf9f0447fd08ee7748fd4a02ebbad7be118c0cd4d30cc7890" "q-16548/selection/d826542d60cf90edb1a08622a3232b5f60ac38a470abdd32b384ab4acb717119" "q-16548/selection/d5c68d29aa39f29064cc0355f6208093983fe13ae1fc2edc0d804d629f6dfc63"] :db/ensure [:answer-field/validate]} {:db/id "q-16548" :question/id #uuid "9ff8c2aa-59f0-5520-88ff-40444c85393f" :question/math-academy-id "q-16548" :question/problem "For the ellipse \n$\\frac{(x+4)^{2}}{5}+\\frac{(y-3)^{2}}{2}=1$, find the lengths of its major and minor axes." :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-4$ and $k=3,$ so the center is located at $(-4,3).$\n\nIn the given equation, we also have ${a}^{2}=5$ and ${b}^{2}=2.$\n\n- Since ${a}^{2}=5,$ the length of the horizontal radius must be $a=\\sqrt{5}.$\n\n- Since ${b}^{2}=2,$ the length of the vertical radius must be $b=\\sqrt{2}.$\n\nSo the semi-major axis has length $a=\\sqrt{5},$ and the semi-minor axis has length $b=\\sqrt{2}.$\n\nTherefore, the major axis has length $2a=2\\cdot \\sqrt{5}=2\\sqrt{5},$ and the minor axis has length $2b=2\\cdot \\sqrt{2}=2\\sqrt{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-16548/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7"] :knowledge-point/questions ["q-16548"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-72252"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072906/assets/28079ead5ebb4649900653172d11c25f3ff489c6b34772094a1ba947c18ef3e1.png)\n\nWhat is the equation of the ellipse given above?" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-115297"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072906/assets/1006eabe3321beb48df2cd936ff2252b77e8ded81f9c5b7aec4d143e43941088.png)\n\nWhat is the equation of the ellipse given above?" :db/ensure [:question/validate]}]
