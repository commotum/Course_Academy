cef37ed6a52d5bd374fae2d7a00c4d8012e9ea8dbef43165c10bcc9471be.png)\n\nSo, ${\\int }_{-C}F\\cdot \\text{d}r>0.$\n\nTherefore, the correct answer is \"II and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058183/state.json" "file_sha256" "2a73eff87a243f353549721bd5d900488a70f1f7bb2c99779b970432a261ecd7"} {"question" "q-125507" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058183/activity-metadata.json" "file_sha256" "a3071f644a35c8419b94dbbf157765a099d37438b76cbb14430473774f971160"} {"question" "q-125507" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058183/state.json" "file_sha256" "2a73eff87a243f353549721bd5d900488a70f1f7bb2c99779b970432a261ecd7"} {"question" "q-125507" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058183/state.json" "file_sha256" "2a73eff87a243f353549721bd5d900488a70f1f7bb2c99779b970432a261ecd7"} {"question" "q-125507" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and III only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14058183/state.json" "file_sha256" "2a73eff87a243f353549721bd5d900488a70f1f7bb2c99779b970432a261ecd7"} {"question" "q-125380" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Ac