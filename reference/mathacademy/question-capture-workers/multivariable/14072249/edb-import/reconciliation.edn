 1 \\\\ 1 & 0 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}0 & 3 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}0 & 2 & 1 \\\\ 1 & 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 0 & 6 \\\\ -6 & 0 & -12\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(3,-6)$, $(0,0),$ $(6,-12).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/9c045d6467a91676cd27a4c11cbb651a798b2480662d09b446b52d8eeb490ff4.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147611" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/activity-metadata.json" "file_sha256" "dd6d254fe764e51546faa30c13340e0b9fbe5c3f48caba75e8395c53810475e7"} {"question" "q-147611" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147611" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/69e3e6eabe9e2ea5d28a6ff0feb40437965649af45ad247b572a35ac3bf642a4.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/9c045d6467a91676cd27a4c11cbb651a798b2480662d09b446b52d8eeb490ff4.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/d271c5f4cf0f250dcfdbba8addfdc5f8c583832f378756fc3066e2b961a31dc3.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/d38c8f370e25add2a06ecc652127bae817e2c8bc394f4db6fdf539fbfef3750c.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/f9040d78661e0d33290ad14e1ddf815211985f5963c8e1c8b9b5438dd8f3931c.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147611" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/9c045d6467a91676cd27a4c11cbb651a798b2480662d09b446b52d8eeb490ff4.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147669" "field" nil "attribute" "question/problem" "value" "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-2 & 3 \\\\ 6 & -9\\end{aligned}].\n$$\n\nA triangle $S$ has vertices at $(-1,3),(0,-2),$ and $(4,1).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the action of $T?$\n\n- $(-11,3)$\n- $(-5,15)$\n- $(18,-3)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147669" "field" nil "attribute" "question/worked-solution" "value" "To find the image of $S$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\nX=[\\begin{aligned}-1 & 0 & 4 \\\\ 3 & -2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-2 & 3 \\\\ 6 & -9\\end{aligned}][\\begin{aligned}-1 & 0 & 4 \\\\ 3 & -2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}11 & -6 & -5 \\\\ -33 & 18 & 15\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(11,-33)$, $(-6,18)$ and $(-5,15).$ \n\nSo, the correct answer is \"II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147669" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/activity-metadata.json" "file_sha256" "dd6d254fe764e51546faa30c13340e0b9fbe5c3f48caba75e8395c53810475e7"} {"question" "q-147669" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147669" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-147669" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162200" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/da6c0fb32e62b6effe133c527fee528c47b6f1c8dc7dd1d77d7d04f42b4c3d2b.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162200" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nSince $T$ is the zero matrix, the image of our object under the action of $T$ is the origin." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162200" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/activity-metadata.json" "file_sha256" "dd6d254fe764e51546faa30c13340e0b9fbe5c3f48caba75e8395c53810475e7"} {"question" "q-162200" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162200" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "A line segment"] ["text" "A point, different from the origin"] ["text" "A quadrilateral"] ["text" "A triangle"] ["text" "The origin $O$ of the coordinate system"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162200" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "The origin $O$ of the coordinate system"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162206" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/assets/e6d0ce147aec90c3840a893e36596fbadf981ff96559f65d055f4486406cca7f.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 1 \\\\ 0 & 1\\end{aligned}].\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162206" "field" nil "attribute" "question/worked-solution" "value" "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}-1 & 1 \\\\ 0 & 1\\end{aligned}| \\\\  & =-1\\cdot 1-0\\cdot 1 \\\\  & =-1.\\end{aligned}\n$$\n\nSo, we have a nonsingular matrix. Therefore, the image of our object under the action of  $T$ is a quadrilateral." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162206" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/activity-metadata.json" "file_sha256" "dd6d254fe764e51546faa30c13340e0b9fbe5c3f48caba75e8395c53810475e7"} {"question" "q-162206" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162206" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "A line segment"] ["text" "A point, different from the origin"] ["text" "A quadrilateral"] ["text" "A triangle"] ["text" "The origin $O$ of the coordinate system"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"} {"question" "q-162206" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "A quadrilateral"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14072249/state.json" "file_sha256" "7c22ed54c149cdad52322e7cf331176a4947a719e830f80b32cb94b53b2ef772"}] "usage" {"q-162206" [] "q-147611" [] "q-162200" [] "q-21058" []} "basis" 2622 "retractions" [[17592186284145 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/fee79ec0b214a4ba87400b4b8c9dab2c623878d067821c572b26ae241625c48a.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$"] [17592186284145 :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ 10 & 5\\end{aligned}][\\begin{aligned}1 & 1 & 2 \\\\ 0 & 1 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 3 & 5 \\\\ 10 & 15 & 25\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(2,10)$, $(3,15)$, and  $(5,25).$  Notice that all three points lie on the same line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/bf5987fde11416780a6a599e3952db7319e1c0e859e2439b7df70c5659bc6839.png)"] [17592186343739 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/assets/27c1ad7d429eb8da46b0bb3baec048b3564ce206b4523416cb4cb56b0a33767f.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}0 & 3 \\\\ 0 & -6\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$"] [17592186343739 :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}0 & 2 & 1 \\\\ 1 & 0 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}0 & 3 \\\\ 0 & -6\\end{aligned}][\\begin{aligned}0 & 2 & 1 \\\\ 1 & 0 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}3 & 0 & 6 \\\\ -6 & 0 & -12\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(3,-6)$, $(0,0),$ $(6,-12).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/assets/9c045d6467a91676cd27a4c11cbb651a798b2480662d09b446b52d8eeb490ff4.png)"] [17592186284131 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/da6c0fb32e62b6effe133c527fee528c47b6f1c8dc7dd1d77d7d04f42b4c3d2b.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$"] [17592186105994 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14062587/assets/e6d0ce147aec90c3840a893e36596fbadf981ff96559f65d055f4486406cca7f.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & 1 \\\\ 0 & 1\\end{aligned}].\n$$\n\nWhat would be the image of the quadrilateral shown above under the action of $T?$"]] "immutable_answers" [17592186102212 17592186102213 17592186102214 17592186102215 17592186102216 17592186284133 17592186284134 17592186284135 17592186284136 17592186284137 17592186284147 17592186284148 17592186284149 17592186284150 17592186284151 17592186343741 17592186343742 17592186343743 17592186343744 17592186343745] "immutable_fields" [[17592186102211 :answer-field/correct] [17592186102211 :answer-field/id] [17592186102211 :answer-field/key] [17592186102211 :answer-field/type] [17592186284132 :answer-field/correct] [17592186284132 :answer-field/id] [17592186284132 :answer-f