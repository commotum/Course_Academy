#{[{:db/id #edb/ref 17592186296379 :knowledge-point/_questions [{:knowledge-point/id #uuid "99112850-043d-53e5-8d61-fecb0317bd11" :knowledge-point/title "Finding Particular Solutions of Differential Equations by Separating the Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d573eb2d-82ab-5413-8bcb-b9b2336a830d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}={x}^{3}+7" :db/id #edb/ref 17592186296381} {:answer/id #uuid "62ebf476-68aa-5bd7-bff4-c6c6a4b750c3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}=5{x}^{3}+3" :db/id #edb/ref 17592186296382} {:answer/id #uuid "98f15021-418c-5d7a-81fc-5a641671a6c9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}=2{x}^{3}+2" :db/id #edb/ref 17592186296383} {:answer/id #uuid "3ef8da88-22a3-5a8a-8a1d-60b6223fcbb8" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}={x}^{2}+3" :db/id #edb/ref 17592186296384} {:answer/id #uuid "f0f49ccd-93ef-5294-bc32-626551ecf864" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}=3{x}^{2}+5" :db/id #edb/ref 17592186296385}] :answer-field/correct {:answer/id #uuid "d573eb2d-82ab-5413-8bcb-b9b2336a830d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}={x}^{3}+7" :db/id #edb/ref 17592186296381} :answer-field/id #uuid "1e931c97-953c-5bd7-9dfc-1e428ad98edf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296380}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a5938f28-6b10-54af-bd46-b5bd83651a7a" :question/math-academy-id "q-14313" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{{x}^{2}}{{y}^{2}}$  that satisfies $y(1)=2.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{x}^{2}}{{y}^{2}} \\\\ {y}^{2}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{2} \\\\ \\int {y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int {y}^{2}\\,\\text{d}y & =\\int {x}^{2}\\,\\text{d}x \\\\ \\frac{{y}^{3}}{3} & =\\frac{{x}^{3}}{3}+{C}_{1} \\\\ {y}^{3} & ={x}^{3}+C,\\end{aligned}\n$$\n\nwhere   $C=3{C}_{1}$ is an arbitrary constant.  \n\nWe now apply the condition $y(1)=2$ to find $C:$\n\n$$\n\\begin{aligned}{2}^{3} & ={1}^{3}+C \\\\ 8-1 & =C \\\\ C & =7\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n{y}^{3}={x}^{3}+7.\n$$"}]}
