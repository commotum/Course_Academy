#{[{:db/id #edb/ref 17592186296379 :knowledge-point/_questions [{:knowledge-point/id #uuid "99112850-043d-53e5-8d61-fecb0317bd11" :knowledge-point/title "Finding Particular Solutions of Differential Equations by Separating the Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d573eb2d-82ab-5413-8bcb-b9b2336a830d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}={x}^{3}+7" :db/id #edb/ref 17592186296381} {:answer/id #uuid "62ebf476-68aa-5bd7-bff4-c6c6a4b750c3" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}=5{x}^{3}+3" :db/id #edb/ref 17592186296382} {:answer/id #uuid "98f15021-418c-5d7a-81fc-5a641671a6c9" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}=2{x}^{3}+2" :db/id #edb/ref 17592186296383} {:answer/id #uuid "3ef8da88-22a3-5a8a-8a1d-60b6223fcbb8" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}={x}^{2}+3" :db/id #edb/ref 17592186296384} {:answer/id #uuid "f0f49ccd-93ef-5294-bc32-626551ecf864" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}=3{x}^{2}+5" :db/id #edb/ref 17592186296385}] :answer-field/correct {:answer/id #uuid "d573eb2d-82ab-5413-8bcb-b9b2336a830d" :answer/type {:db/ident :answer.type/math} :answer/value "{y}^{3}={x}^{3}+7" :db/id #edb/ref 17592186296381} :answer-field/id #uuid "1e931c97-953c-5bd7-9dfc-1e428ad98edf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296380}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a5938f28-6b10-54af-bd46-b5bd83651a7a" :question/math-academy-id "q-14313" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{{x}^{2}}{{y}^{2}}$  that satisfies $y(1)=2.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find the particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{{x}^{2}}{{y}^{2}} \\\\ {y}^{2}\\frac{\\text{d}y}{\\text{d}x} & ={x}^{2} \\\\ \\int {y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int {y}^{2}\\,\\text{d}y & =\\int {x}^{2}\\,\\text{d}x \\\\ \\frac{{y}^{3}}{3} & =\\frac{{x}^{3}}{3}+{C}_{1} \\\\ {y}^{3} & ={x}^{3}+C,\\end{aligned}\n$$\n\nwhere   $C=3{C}_{1}$ is an arbitrary constant.  \n\nWe now apply the condition $y(1)=2$ to find $C:$\n\n$$\n\\begin{aligned}{2}^{3} & ={1}^{3}+C \\\\ 8-1 & =C \\\\ C & =7\\end{aligned}\n$$\n\nSo we get the particular solution in implicit form:\n\n$$\n{y}^{3}={x}^{3}+7.\n$$"}] [{:db/id #edb/ref 17592186335479 :knowledge-point/_questions [{:knowledge-point/id #uuid "de2e3a7c-d4f0-5b0f-8014-1519fb3a9473" :knowledge-point/title "Finding Particular Solutions of Differential Equations by First Rearranging and Then Separating"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e865fe4b-b552-5e49-96e0-af34995f5e9c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(2-{e}^{x})" :db/id #edb/ref 17592186335481} {:answer/id #uuid "dd92b623-ea95-5559-b407-a6917af8dcc5" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}\\operatorname{ln}⁡(x+1)" :db/id #edb/ref 17592186335482} {:answer/id #uuid "860d2f15-f8dc-50f2-bc1d-877881de2c7c" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{4}\\operatorname{ln}⁡(4{e}^{x}-3)" :db/id #edb/ref 17592186335483} {:answer/id #uuid "b5b377a4-5170-5909-969a-fee5feb2b631" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\operatorname{ln}⁡(\\frac{{e}^{x}+1}{2})" :db/id #edb/ref 17592186335484} {:answer/id #uuid "13db39f2-ff13-5346-83b5-dc1e2e7c1488" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}\\operatorname{ln}⁡(2{e}^{x}-1)" :db/id #edb/ref 17592186335485}] :answer-field/correct {:answer/id #uuid "13db39f2-ff13-5346-83b5-dc1e2e7c1488" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\frac{1}{2}\\operatorname{ln}⁡(2{e}^{x}-1)" :db/id #edb/ref 17592186335485} :answer-field/id #uuid "e35eb022-54e0-5d0a-b4bd-e9bd48e358a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186335480}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "20669a20-777a-5d15-ade0-e739edb8a182" :question/math-academy-id "q-4016" :question/problem "Find the particular solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}={e}^{x-2y}$ that satisfies $y(0)=0.$" :question/worked-solution "We first find the general solution and then apply the given initial condition to find a particular solution.\n\nSeparating variables and integrating both sides with respect to $x,$ we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x-2y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={e}^{x}\\cdot {e}^{-2y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{{e}^{x}}{{e}^{2y}} \\\\ {e}^{2y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={e}^{x} \\\\ \\int {e}^{2y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {e}^{x}\\,\\text{d}x \\\\ \\int {e}^{2y}\\,\\text{d}y & =\\int {e}^{x}\\,\\text{d}x \\\\ \\frac{1}{2}{e}^{2y} & ={e}^{x}+{C}_{1} \\\\ {e}^{2y} & =2{e}^{x}+C,\\end{aligned}\n$$\n\nwhere $C=2{C}_{1}$ is an arbitrary constant.\n\nApplying the natural logarithm to both sides, we find the general solution:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡({e}^{2y}) & =\\operatorname{ln}⁡(2{e}^{x}+C) \\\\ y & =\\frac{1}{2}\\operatorname{ln}⁡(2{e}^{x}+C).\\end{aligned}\n$$\n\nWe now apply the condition $y(0)=0$ to find $C:$\n\n$$\n\\begin{aligned}y(0) & =0 \\\\ \\frac{1}{2}\\operatorname{ln}⁡(2{e}^{0}+C) & =0 \\\\ \\operatorname{ln}⁡(2+C) & =0 \\\\ 2+C & =1 \\\\ C & =-1\\end{aligned}\n$$\n\nThus the particular solution of $\\frac{\\text{d}y}{\\text{d}x}={e}^{x-2y}$ that satisfies the condition $y(0)=0$ is\n\n$$\ny=\\frac{1}{2}\\operatorname{ln}⁡(2{e}^{x}-1).\n$$"}] [{:db/id #edb/ref 17592186101458 :knowledge-point/_questions [{:knowledge-point/id #uuid "99112850-043d-53e5-8d61-fecb0317bd11" :knowledge-point/title "Finding Particular Solutions of Differential Equations by Separating the Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "91a4c94b-e879-506a-96df-86c17948e054" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{1 - 2\\ln x}" :db/id #edb/ref 17592186100345} {:answer/id #uuid "e256488d-393a-59a9-8297-648ff8f800f1" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{\\ln x - 2}" :db/id #edb/ref 17592186100346} {:answer/id #uuid "0ea82528-a4be-5c21-b3bf-495db90380dd" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{\\ln x + 1}" :db/id #edb/ref 17592186100347} {:answer/id #uuid "16e71534-cbb6-53e0-b8e4-10d7a0c50641" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{\\ln x - 1}" :db/id #edb/ref 17592186100348} {:answer/id #uuid "7cc0291b-fb40-5bf4-82bb-794ab7a6dbb7" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{2\\ln x + 1}" :db/id #edb/ref 17592186100349}] :answer-field/correct {:answer/id #uuid "91a4c94b-e879-506a-96df-86c17948e054" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{2}{1 - 2\\ln x}" :db/id #edb/ref 17592186100345} :answer-field/id #uuid "976e6cbb-47e3-57ae-8d27-a93c919971ac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186100344}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "525ed303-6429-5295-90a0-f24212406b6d" :question/math-academy-id "q-8310" :question/problem "Find the particular solution to the differential equation $\\frac{dy}{dx} = \\frac{y^{2}}{x}$ that satisfies $y(1) = 2$. Assume that $x > 0$." :question/requires-calculator false :question/worked-solution "For $x>0$ and the branch through $y(1)=2$, separate and integrate:\n$$\\frac{dy}{y^2}=\\frac{dx}{x},\\qquad -\\frac1y=\\ln x+C.$$\nThe initial condition gives $C=-1/2$, so\n$$y=\\frac2{1-2\\ln x}.$$\nThe maximal interval containing $x=1$ is $0<x<\\sqrt e$."}]}
