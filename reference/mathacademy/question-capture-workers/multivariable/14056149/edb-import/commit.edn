2}{y}^{2}+9}+3)}{{x}^{2}{y}^{2}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & ={lim}_{x\\to (0,0)}\\frac{{x}^{2}{y}^{2}+9-9}{{x}^{2}{y}^{2}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & ={lim}_{x\\to (0,0)}\\frac{{x}^{2}{y}^{2}}{{x}^{2}{y}^{2}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & ={lim}_{x\\to (0,0)}\\frac{\\cancel{{x}^{2}{y}^{2}}}{\\cancel{{x}^{2}{y}^{2}}(\\sqrt{{x}^{2}{y}^{2}+9}+3)} \\\\  & ={lim}_{x\\to (0,0)}\\frac{1}{\\sqrt{{x}^{2}{y}^{2}+9}+3}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)}\\frac{1}{\\sqrt{{x}^{2}{y}^{2}+9}+3} & =\\frac{1}{\\sqrt{({0}^{2})({0}^{2})+9}+3} \\\\  & =\\frac{1}{\\sqrt{9}+3} \\\\  & =\\frac{1}{3+3} \\\\  & =\\frac{1}{6}\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $\\frac{1}{6}.$" 13194139535146 true] [17592186333798 1000 #edb/ref 17592186333799 13194139535146 true] [17592186333798 1000 #edb/ref 17592186333800 13194139535146 true] [17592186333798 1000 #edb/ref 17592186333801 13194139535146 true] [17592186333798 1000 #edb/ref 17592186333802 13194139535146 true] [17592186333798 1000 #edb/ref 17592186333803 13194139535146 true] [17592186333798 1040 #edb/ref 17592186045450 13194139535146 true] [17592186333798 1041 "selection" 13194139535146 true] [17592186333798 1104 #edb/ref 17592186333801 13194139535146 true] [17592186333798 1110 #uuid "dc263130-fd46-5e0f-b17a-8c778b502b92" 13194139535146 true] [17592186333799 1034 "3" 13194139535146 true] [17592186333799 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333799 1111 #uuid "b22613c0-519c-517b-8cb5-43f8e36cd83e" 13194139535146 true] [17592186333800 1034 "2" 13194139535146 true] [17592186333800 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333800 1111 #uuid "7169a415-04ee-5d08-be0c-2033aeca4c68" 13194139535146 true] [17592186333801 1034 "\\frac{1}{6}" 13194139535146 true] [17592186333801 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333801 1111 #uuid "2e6904e1-8a84-580f-a552-d5f7e17bde7d" 13194139535146 true] [17592186333802 1034 "\\frac{1}{3}" 13194139535146 true] [17592186333802 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333802 1111 #uuid "35f498fc-15fe-5a60-9519-9c786140c0f5" 13194139535146 true] [17592186333803 1034 "0" 13194139535146 true] [17592186333803 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333803 1111 #uuid "44dcc4f6-d2cc-54a7-b260-ce6ca40e4fdc" 13194139535146 true] [17592186333804 1017 #edb/ref 17592186333805 13194139535146 true] [17592186333804 1089 "q-36109" 13194139535146 true] [17592186333804 1091 #edb/ref 17592186045464 13194139535146 true] [17592186333804 1100 "${lim}_{(x,y)\\to (1,2)}\\frac{2{x}^{2}+3xy-2{y}^{2}}{2{x}^{2}-xy}=$" 13194139535146 true] [17592186333804 1113 #uuid "834ad829-4477-522b-95e1-81bfa2abc5d0" 13194139535146 true] [17592186333804 1145 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0},$ as follows: \n\n$$\n{lim}_{(x,y)\\to (1,2)}\\frac{2{x}^{2}+3xy-2{y}^{2}}{2{x}^{2}-xy}=\\frac{2\\cdot {1}^{2}+3\\cdot 1\\cdot 2-2\\cdot {2}^{2}}{2\\cdot {1}^{2}-1\\cdot 2}=\\frac{0}{0}\n$$\n\nHowever, we can simplify the limit by first factoring the denominator, and then canceling common factors in the numerator and denominator:\n\n$$\n\\begin{aligned}{lim}_{(x,y)\\to (1,2)}\\frac{2{x}^{2}+3xy-2{y}^{2}}{2{x}^{2}-xy} & ={lim}_{(x,y)\\to (1,2)}\\frac{2{x}^{2}+4xy-xy-2{y}^{2}}{x(2x-y)} \\\\  & ={lim}_{(x,y)\\to (1,2)}\\frac{2x(x+2y)-y(x+2y)}{x(2x-y)} \\\\  & ={lim}_{(x,y)\\to (1,2)}\\frac{(2x-y)(x+2y)}{x(2x-y)} \\\\  & ={lim}_{(x,y)\\to (1,2)}\\frac{x+2y}{x}\\end{aligned}\n$$\n\nNow that the limit has been simplified, we can evaluate it:\n\n$$\n\\begin{aligned}{lim}_{(x,y)\\to (1,2)}\\frac{x+2y}{x} & =\\frac{1+2\\cdot 2}{1} \\\\  & =5\\end{aligned}\n$$\n\nTherefore, the limit evaluates to $5.$" 13194139535146 true] [17592186333805 1000 #edb/ref 17592186333806 13194139535146 true] [17592186333805 1000 #edb/ref 17592186333807 13194139535146 true] [17592186333805 1000 #edb/ref 17592186333808 13194139535146 true] [17592186333805 1000 #edb/ref 17592186333809 13194139535146 true] [17592186333805 1000 #edb/ref 17592186333810 13194139535146 true] [17592186333805 1040 #edb/ref 17592186045450 13194139535146 true] [17592186333805 1041 "selection" 13194139535146 true] [17592186333805 1104 #edb/ref 17592186333810 13194139535146 true] [17592186333805 1110 #uuid "ffddc5a6-256c-5054-82f2-b92be4268a10" 13194139535146 true] [17592186333806 1034 "\\frac{5}{2}" 13194139535146 true] [17592186333806 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333806 1111 #uuid "b9afd34f-ccd5-58fe-bc41-91a26f018a01" 13194139535146 true] [17592186333807 1034 "2" 13194139535146 true] [17592186333807 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333807 1111 #uuid "d0427c4d-cba6-54c1-b7a1-c1b5106d2c95" 13194139535146 true] [17592186333808 1034 "4" 13194139535146 true] [17592186333808 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333808 1111 #uuid "1406d214-c7e6-59b0-9925-2ad21076e95f" 13194139535146 true] [17592186333809 1034 "\\text{DNE}" 13194139535146 true] [17592186333809 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333809 1111 #uuid "f7277171-6f35-5e20-bb12-b32d76f9a6e2" 13194139535146 true] [17592186333810 1034 "5" 13194139535146 true] [17592186333810 1103 #edb/ref 17592186045453 13194139535146 true] [17592186333810 1111 #uuid "cbed2f3a-f367-5000-9a60-fc2bdd84a40b" 13194139535146 true] [17592186333811 1017 #edb/ref 17592186333812 13194139535146 true] [17592186333811 1089 "q-74964" 13194139535146 true] [17592186333811 1091 #edb/ref 17592186045465 13194139535146 true] [17592186333811 1100 "Which of the following statements are true regarding the limit given below?\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}\n$$\n\n- The limit evaluates to $0$ along the path $y=x$\n- The limit evaluates to $2$ along the path $y={x}^{2}$\n- The limit exists and is equal to $2$" 13194139535146 true] [17592186333811 1113 #uuid "538bab68-7058-5f4f-b133-c515348f8f89" 13194139535146 true] [17592186333811 1145 "Attempting to evaluate the limit by direct substitution leads to the indeterminate form $\\frac{0}{0}:$\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\frac{2\\cdot {0}^{2}}{2\\cdot {0}^{2}-0}=\\frac{0}{0}\n$$\n\nHowever, the function cannot be simplified by canceling common factors in the numerator and denominator:\n\nWe attempt to evaluate the limit by approaching $(0,0)$ from different paths.\n\n- Statement I is true. Taking $x\\to (0,0)$ along the path $y=x,$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y=x}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\,\\frac{2{x}^{2}}{2{x}^{2}-x} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{x(2x-1)} \\\\  & ={lim}_{x\\to 0}\\frac{2x}{2x-1} \\\\  & =\\frac{2\\cdot 0}{2\\cdot 0-1} \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is also true. Taking $x\\to (0,0)$ along the path $y={x}^{2},$ we have\n\n$$\n\\begin{aligned}{lim}_{x\\to (0,0)\\,\\,\\,y={x}^{2}}\\,\\frac{2{x}^{2}}{2{x}^{2}-y} & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{2{x}^{2}-{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{2}}{{x}^{2}} \\\\  & ={lim}_{x\\to 0}\\,2 \\\\  & =2\\end{aligned}\n$$\n\n- Statement III is false. Because the limit evaluates to different results on two different paths, we conclude that the limit does not exist:\n\n$$\n{lim}_{x\\to (0,0)}\\,\\frac{2{x}^{2}}{2{x}^{2}-y}=\\text{DNE}\n$$" 13194139535146 true] [17592186333812 1000 #edb/ref 17592186333813 13194139535146 true] [17592186333812 1000 #edb/ref 17592186333814 13194139535146 true] [17592186333812 1000 #edb/ref 17592186333815 13194139535146 true] [17592186333812 1000 #edb/ref 17592186333816 13194139535146 true] [17592186333812 1000 #edb/ref 17592186333817 13194139535146 true] [17592186333812 1040 #edb/ref 17592186045450 13194139535146 true] [17592186333812 1041 "selection" 13194139535146 true] [17592186333812 1104 #edb/ref 17592186333817 13194139535146 true] [175