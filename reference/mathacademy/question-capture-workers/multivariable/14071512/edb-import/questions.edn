swer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{1}∫_{0}^{1}20 - 4 x 2 + 4 y 2dydx" :db/id #edb/ref 17592186130885} {:answer/id #uuid "72429bbc-4c1f-5953-af68-a72527d62038" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{1}∫_{0}^{1 - x}20 - 4 x 2 + 4 y 2dydx" :db/id #edb/ref 17592186130886}] :answer-field/correct {:answer/id #uuid "b93aa029-cebb-504c-9cf0-03532112bd4e" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{0}^{1}∫_{0}^{1 - x}4 x 3 + 4 x y 2 - 40 xdydx" :db/id #edb/ref 17592186130883} :answer-field/id #uuid "1b4f178d-ab86-5fbd-b750-5b059091e2bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186130881}] :question/id #uuid "d82e0bcb-c8b4-5aa2-9f3c-8a84246a499f" :question/math-academy-id "q-161927" :question/problem "Let $C$ be the intersection of the paraboloid $z = 10 - x^{2} - y^{2}$ and the boundary of the infinite vertical column enclosed by the planes $x + y = 1$, $x = 0$, and $y = 0$. Given that the curve $C$ is oriented counter-clockwise when viewed from above and $curlF = ⟨ - 2z, 0, 0⟩$, the circulation of $F$ along $C$ can be written as\n\n$∮_(C)F \\cdot dr =$"}]}
