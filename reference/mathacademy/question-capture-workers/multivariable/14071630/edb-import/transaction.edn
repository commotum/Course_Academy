sqrt{3},-1⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(\\frac{\\pi }{6}) & =T(\\frac{\\pi }{6})\\times N(\\frac{\\pi }{6}) \\\\  & =\\frac{1}{2}⟨0,-1,\\sqrt{3}⟩\\times \\frac{1}{2}⟨0,-\\sqrt{3},-1⟩ \\\\  & =\\frac{1}{4}\\,\\left|\\begin{aligned}i & j & k \\\\ 0 & -1 & \\sqrt{3} \\\\ 0 & -\\sqrt{3} & -1\\end{aligned}\\right| \\\\  & =\\frac{1}{4}[\\text{ }\\left|\\begin{aligned}-1 & \\sqrt{3} \\\\ -\\sqrt{3} & -1\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}0 & \\sqrt{3} \\\\ 0 & -1\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}0 & -1 \\\\ 0 & -\\sqrt{3}\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{4}⟨(1+3),-(0-0),(0-0)⟩ \\\\  & =\\frac{1}{4}⟨4,0,0⟩ \\\\  & =⟨1,0,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99430/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91ea3125-c2b7-56d0-97d8-4e54b2c01524"] :knowledge-point/questions ["q-99430"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99420/selection/941ca6e769e1468cceef035763e0311b57db08565e69be0e2d5557decfe19c0d" :answer/id #uuid "f8e0df4d-f18b-5442-bee5-8f331c67a9de" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨1,0,1⟩" :db/ensure [:answer/validate]} {:db/id "q-99420/selection/eeb08a7e5f490c2529e050fef0f5236cb275e7f7b3c42b5d3d7f465423eb30dc" :answer/id #uuid "6d3762ad-da00-506d-8570-7149b0f61703" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨-1,1,1⟩" :db/ensure [:answer/validate]} {:db/id "q-99420/selection/bb5837ac24c17bcbe5bc527bf1a965b33ea8a349eae06cfde2f0578f0df9a596" :answer/id #uuid "f5f5db06-db05-5619-921c-9a28019c6674" :answer/type :answer.type/math :answer/value "\\frac{1}{3}⟨2,1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-99420/selection/c13926fc911a93d7f7808e794257671f609487ccfa75e34274e2ac8ae7b19353" :answer/id #uuid "f78ee6a1-a996-5733-83f6-8b374c59e4f6" :answer/type :answer.type/math :answer/value "\\frac{1}{5}⟨3,-4,0⟩" :db/ensure [:answer/validate]} {:db/id "q-99420/selection/4db01c27e4246a1ba7bc3b42e964d322b5e8497a937aae565db14e8849733eeb" :answer/id #uuid "0b3d4385-e521-54e8-9f27-92b12645a56e" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨-1,0,2⟩" :db/ensure [:answer/validate]} {:db/id "q-99420/selection" :answer-field/id #uuid "53b33378-f1f7-5241-8734-a321e15da398" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99420/selection/4db01c27e4246a1ba7bc3b42e964d322b5e8497a937aae565db14e8849733eeb" :answer-field/choices ["q-99420/selection/941ca6e769e1468cceef035763e0311b57db08565e69be0e2d5557decfe19c0d" "q-99420/selection/eeb08a7e5f490c2529e050fef0f5236cb275e7f7b3c42b5d3d7f465423eb30dc" "q-99420/selection/bb5837ac24c17bcbe5bc527bf1a965b33ea8a349eae06cfde2f0578f0df9a596" "q-99420/selection/c13926fc911a93d7f7808e794257671f609487ccfa75e34274e2ac8ae7b19353" "q-99420/selection/4db01c27e4246a1ba7bc3b42e964d322b5e8497a937aae565db14e8849733eeb"] :db/ensure [:answer-field/validate]} {:db/id "q-99420" :question/id #uuid "d72357b6-ef82-52db-9e20-719b16aff0ed" :question/math-academy-id "q-99420" :question/problem "Find the binormal vector to the curve $r(t)$ at the point $t=1,$ given that\n\n$$\n\\begin{aligned}T(1) & =\\frac{1}{3}⟨2,2,1⟩, \\\\ N(1) & =\\frac{1}{3\\sqrt{5}}⟨-4,5,-2⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(1) & =T(1)\\times N(1) \\\\  & =\\frac{1}{3}⟨2,2,1⟩\\times \\frac{1}{3\\sqrt{5}}⟨-4,5,-2⟩ \\\\  & =\\frac{1}{9\\sqrt{5}}\\left|\\begin{aligned}i & j & k \\\\ 2 & 2 & 1 \\\\ -4 & 5 & -2\\end{aligned}\\right| \\\\  & =\\frac{1}{9\\sqrt{5}}[\\text{ }\\left|\\begin{aligned}2 & 1 \\\\ 5 & -2\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}2 & 1 \\\\ -4 & -2\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}2 & 2 \\\\ -4 & 5\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{9\\sqrt{5}}⟨(-4-5),-(-4-(-4)),(10-(-8))⟩ \\\\  & =\\frac{1}{9\\sqrt{5}}⟨-9,0,18⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨-1,0,2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99420/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91ea3125-c2b7-56d0-97d8-4e54b2c01524"] :knowledge-point/questions ["q-99420"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-99504"] :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{{t}^{2}+4}}⟨t,2,0⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{\\sqrt{{t}^{2}+4}}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{\\sqrt{{t}^{2}+4}}),\\,\\frac{\\text{d}}{\\text{d}t}(0)⟩ \\\\  & =⟨\\frac{4}{({t}^{2}+4)^{3/2}},\\,-\\frac{2t}{({t}^{2}+4)^{3/2}},\\,0⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{({t}^{2}+4)^{3/2}}\\sqrt{(4)^{2}+{(-2t)}^{2}+{(0)}^{2}} \\\\  & =\\frac{1}{({t}^{2}+4)^{3/2}}\\sqrt{16+4{t}^{2}} \\\\  & =\\frac{2}{({t}^{2}+4)^{3/2}}\\sqrt{{t}^{2}+4} \\\\  & =\\frac{2}{{t}^{2}+4}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{({t}^{2}+4)^{3/2}}⟨4,\\,-2t,\\,0⟩}{(\\frac{2}{{t}^{2}+4})}=\\frac{1}{\\sqrt{{t}^{2}+4}}⟨2,\\,-t,\\,0⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{{t}^{2}+4}}⟨t,2,0⟩\\times \\frac{1}{\\sqrt{{t}^{2}+4}}⟨2,\\,-t,\\,0⟩ \\\\  & =\\frac{1}{{t}^{2}+4}\\,\\left|\\begin{aligned}i & j & k \\\\ t & 2 & 0 \\\\ 2 & -t & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{{t}^{2}+4}[\\text{ }\\left|\\begin{aligned}2 & 0 \\\\ -t & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}t & 0 \\\\ 2 & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}t & 2 \\\\ 2 & -t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{{t}^{2}+4}⟨0+0,-(0-0),-{t}^{2}-4⟩ \\\\  & =\\frac{1}{{t}^{2}+4}⟨0,\\,0,\\,-({t}^{2}+4)⟩ \\\\  & =⟨0,0,-1⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-99574/selection/a209797611c035c25f6daf7db38914e162f7297faa7dc56495390b82c893c105" :answer/id #uuid "09c99773-42be-5d73-a2b2-3cd11cae9247" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{6}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,2,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "q-99574/selection/301a407fa3e78d6935c779c9222172fdc48261cb687ce81ef13044768fbea4fa" :answer/id #uuid "ea05a089-d7a0-56fc-be98-b597f99cd0a0" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨\\operatorname{sin}⁡t+\\operatorname{cos}⁡t,\\,-1,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "q-99574/selection/226b1f139b21b87fb7ceb5d7ddca908f093093ae1ce029ad70e61c8ef04695d0" :answer/id #uuid "5f8815dc-4d18-5cd2-ba78-3c8553a1ca2d" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨0,\\,2,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "q-99574/selection/e9b575a59a82924c1b0e5a5ef518112d0df1d7cdbf4893cbd924a64a645d368c" :answer/id #uuid "b3d61bc8-7f50-5d75-9c14-98ed028f78c8" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨\\operatorname{cos}⁡t,\\,2,\\,-\\operatorname{sin}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "q-99574/selection/03a6e2d12af5e70a3dd8fc9a0a127e3a6162faf0fad3c219da394d05329dd07b" :answer/id #uuid "f61ff981-79e6-5ee2-b177-d3b9b017bb19" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,0,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩" :db/ensure [:answer/validate]} {:db/id "q-99574/selection" :answer-field/id #uuid "f0a5929a-15f7-5ad9-b4f5-2944f1ea41dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99574/selection/a209797611c035c25f6daf7db38914e162f7297faa7dc56495390b82c893c105" :answer-field/choices ["q-99574/selection/a209797611c035c25f6daf7db38914e162f7297faa7dc56495390b82c893c105" "q-99574/selection/301a407fa3e78d6935c779c9222172fdc48261cb687ce81ef13044768fbea4fa" "q-99574/selection/226b1f139b21b87fb7ceb5d7ddca908f093093ae1ce029ad70e61c8ef04695d0" "q-99574/selection/e9b575a59a82924c1b0e5a5ef518112d0df1d7cdbf4893cbd924a64a645d368c" "q-99574/selection/03a6e2d12af5e70a3dd8fc9a0a127e3a6162faf0fad3c219da394d05329dd07b"] :db/ensure [:answer-field/validate]} {:db/id "q-99574" :question/id #uuid "c3acb097-24af-576e-b081-d26bf643475d" :question/math-academy-id "q-99574" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{3}}⟨\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,\\,1,\\,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{3}}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(0),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)⟩ \\\\  & =\\frac{1}{\\sqrt{3}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{3}}\\sqrt{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}+{(0)}^{2}+{(-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{3}}\\sqrt{{cos}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{sin}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t} \\\\  & =\\frac{\\sqrt{2}}{\\sqrt{3}}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{\\sqrt{3}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩}{(\\frac{\\sqrt{2}}{\\sqrt{3}})}=\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{3}}⟨\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,1,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩\\times \\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\  & =\\frac{1}{\\sqrt{6}}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{cos}⁡t+\\operatorname{sin}⁡t & 1 & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & 0 & -\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{6}}[\\text{ }\\left|\\begin{aligned}1 & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & -\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t & 1 \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{6}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t-0,-(-(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}-(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}),-(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}+(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2},\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,2,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99574/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93d895a2-73eb-5141-b56d-48090debf57b"] :knowledge-point/questions ["q-99574"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-96959"] :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{3}⟨2\\sqrt{2},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{3}⟨\\frac{\\text{d}}{\\text{d}t}(2\\sqrt{2}),\\,\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)⟩ \\\\  & =\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{3}\\sqrt{(0)^{2}+{(-\\operatorname{cos}⁡t)}^{2}+{(-\\operatorname{sin}⁡t)}^{2}} \\\\  & =\\frac{1}{3}\\sqrt{{cos}^{2}⁡t+{sin}^{2}⁡t} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{3}⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩}{(\\frac{1}{3})}=⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{3}⟨2\\sqrt{2},-\\operatorname{sin}⁡t,\\operatorname{cos}⁡t⟩\\times ⟨0,\\,-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t⟩ \\\\  & =\\frac{1}{3}\\left|\\begin{aligned}i & j & k \\\\ 2\\sqrt{2} & -\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right| \\\\  & =\\frac{1}{3}[\\text{ }\\left|\\begin{aligned}-\\operatorname{sin}⁡t & \\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}2\\sqrt{2} & \\operatorname{cos}⁡t \\\\ 0 & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}2\\sqrt{2} & -\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{cos}⁡t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{3}⟨({sin}^{2}⁡t-(-{cos}^{2}⁡t)),-(-2\\sqrt{2}\\operatorname{sin}⁡t-0),(-2\\sqrt{2}\\operatorname{cos}⁡t-0)⟩ \\\\  & =\\frac{1}{3}⟨1,\\,2\\sqrt{2}\\operatorname{sin}⁡t,\\,-2\\sqrt{2}\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-127686/selection/10ec2b148d5cde0ae1263c8e524f2e3e9e2c5f3078c249bc8644aa21174c7dd5" :answer/id #uuid "702d234c-3601-58ff-bc9e-b3f017f412fb" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{1+8{t}^{2}}}⟨2t,\\,2t,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-127686/selection/a51de418aa7407d3dc84d3aeaedca3fbdbf926ab36a8821b9f6ce35705195712" :answer/id #uuid "7fb5108c-048c-5bf8-90da-1a71c362297b" :answer/type :answer.type/math :answer/value "⟨0,-1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127686/selection/958f6ae4ba850886e525171c7424867ef5f6f93ce891024d3b17d94d67dd91e3" :answer/id #uuid "e90991c2-23b8-5f8e-9d2e-e9debfffad3e" :answer/type :answer.type/math :answer/value "⟨-1,0,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127686/selection/13cb6c5da950ef5f936873ab2bc4a015f5f8125ec00c5e42ae48e1e9ebc8ca6e" :answer/id #uuid "ee633dc9-259f-5932-a7ac-b59005d2c22f" :answer/type :answer.type/math :answer/value "⟨1,-1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127686/selection/41ee63be9bf59673eb64f203054a7caabfc084ec7ad8fc786403a060cc6acb7d" :answer/id #uuid "f82560b4-895a-5b07-aa98-c6e8551f1a42" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2+4{t}^{2}}}⟨-2t,\\,1,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-127686/selection" :answer-field/id #uuid "c0a31ac0-ac45-5a52-9394-cc4a69ae0a51" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127686/selection/a51de418aa7407d3dc84d3aeaedca3fbdbf926ab36a8821b9f6ce35705195712" :answer-field/choices ["q-127686/selection/10ec2b148d5cde0ae1263c8e524f2e3e9e2c5f3078c249bc8644aa21174c7dd5" "q-127686/selection/a51de418aa7407d3dc84d3aeaedca3fbdbf926ab36a8821b9f6ce35705195712" "q-127686/selection/958f6ae4ba850886e525171c7424867ef5f6f93ce891024d3b17d94d67dd91e3" "q-127686/selection/13cb6c5da950ef5f936873ab2bc4a015f5f8125ec00c5e42ae48e1e9ebc8ca6e" "q-127686/selection/41ee63be9bf59673eb64f203054a7caabfc084ec7ad8fc786403a060cc6acb7d"] :db/ensure [:answer-field/validate]} {:db/id "q-127686" :question/id #uuid "a9708eb7-d471-5841-8ae9-c412fc9cab47" :question/math-academy-id "q-127686" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨1,0,2t⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{1+4{t}^{2}}}),\\,\\frac{\\text{d}}{\\text{d}t}(0),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{2t}{\\sqrt{1+4{t}^{2}}})⟩ \\\\  & =⟨-\\frac{4t}{{(1+4{t}^{2})}^{3/2}},\\,0,\\,\\frac{2}{{(1+4{t}^{2})}^{3/2}}⟩ \\\\  & =\\frac{2}{{(1+4{t}^{2})}^{3/2}}⟨-2t,\\,0,\\,1⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{2}{{(1+4{t}^{2})}^{3/2}}\\sqrt{(-2t)^{2}+{(0)}^{2}+{(1)}^{2}} \\\\  & =\\frac{2}{{(1+4{t}^{2})}^{3/2}}\\sqrt{1+4{t}^{2}} \\\\  & =\\frac{2}{1+4{t}^{2}}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{2}{{(1+4{t}^{2})}^{3/2}}⟨-2t,\\,0,\\,1⟩}{(\\frac{2}{1+4{t}^{2}})}=\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨-2t,\\,0,\\,1⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{1+4{t}^{2}}}⟨1,0,2t⟩\\times \\frac{1}{\\sqrt{1+4{t}^{2}}}⟨-2t,\\,0,\\,1⟩ \\\\  & =\\frac{1}{1+4{t}^{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ 1 & 0 & 2t \\\\ -2t & 0 & 1\\end{aligned}\\right| \\\\  & =\\frac{1}{1+4{t}^{2}}[\\text{ }\\left|\\begin{aligned}0 & 2t \\\\ 0 & 1\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}1 & 2t \\\\ -2t & 1\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}1 & 0 \\\\ -2t & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{1+4{t}^{2}}⟨0-0,-(1+4{t}^{2}),0-0⟩ \\\\  & =\\frac{1}{1+4{t}^{2}}⟨0,\\,-(1+4{t}^{2}),\\,0⟩ \\\\  & =⟨0,-1,0⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127686/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93d895a2-73eb-5141-b56d-48090debf57b"] :knowledge-point/questions ["q-127686"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99653/selection/e64b1a08b7274029bd8269b0cb81db60b474c295df0c7bb5410ffb90271a21a7" :answer/id #uuid "c3c1e693-a8d6-5651-ab56-de4383395389" :answer/type :answer.type/math :answer/value "⟨-1,\\,0,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-99653/selection/78d6614799906be2c29ee52a5c5fdcddb4ff80b4e6f3fd1662ddf78665eb709b" :answer/id #uuid "3a812dbd-c7be-50a6-b715-546dd1cf91b4" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨1,\\,0,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-99653/selection/20451a60c35ce3d9dece612e8924a76cc9cd0b0dc1c780e47c7ce2721edafabf" :answer/id #uuid "10a09701-fbc0-531a-b9b6-cbe979759d09" :answer/type :answer.type/math :answer/value "⟨0,\\,1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-99653/selection/490a5f3af72f7fa13260c15bca05d3211db44ca2a2f73f081cf451d391aaa710" :answer/id #uuid "48af7b6a-f57b-5bd2-be7d-fd4b26b6bb86" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨1,\\,1,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-99653/selection/8d8864f601da660206184c5676af9a84518ae868a88e9815a2694918a0097c82" :answer/id #uuid "35b999fb-8ef9-581e-9f5f-9b833658a4b9" :answer/type :answer.type/math :answer/value "⟨0,\\,0,\\,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-99653/selection" :answer-field/id #uuid "e2663263-0ee6-5e60-b6b3-d27a774b454b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99653/selection/8d8864f601da660206184c5676af9a84518ae868a88e9815a2694918a0097c82" :answer-field/choices ["q-99653/selection/e64b1a08b7274029bd8269b0cb81db60b474c295df0c7bb5410ffb90271a21a7" "q-99653/selection/78d6614799906be2c29ee52a5c5fdcddb4ff80b4e6f3fd1662ddf78665eb709b" "q-99653/selection/20451a60c35ce3d9dece612e8924a76cc9cd0b0dc1c780e47c7ce2721edafabf" "q-99653/selection/490a5f3af72f7fa13260c15bca05d3211db44ca2a2f73f081cf451d391aaa710" "q-99653/selection/8d8864f601da660206184c5676af9a84518ae868a88e9815a2694918a0097c82"] :db/ensure [:answer-field/validate]} {:db/id "q-99653" :question/id #uuid "780d7d73-3673-560c-aa7d-955afb9a9935" :question/math-academy-id "q-99653" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{4{e}^{4t}+1}}⟨2{e}^{2t},1,0⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\frac{2{e}^{2t}}{\\sqrt{4{e}^{4t}+1}}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{4{e}^{4t}+1}}),\\,\\frac{\\text{d}}{\\text{d}t}(0)⟩ \\\\  & =⟨\\frac{4{e}^{2t}}{(4{e}^{4t}+1)^{3/2}},\\,-\\frac{8{e}^{4t}}{(4{e}^{4t}+1)^{3/2}},\\,0⟩ \\\\  & =\\frac{4{e}^{2t}}{(4{e}^{4t}+1)^{3/2}}⟨1,\\,-2{e}^{2t},\\,0⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{4{e}^{2t}}{(4{e}^{4t}+1)^{3/2}}\\sqrt{(1)^{2}+{(-2{e}^{2t})}^{2}+{(0)}^{2}} \\\\  & =\\frac{4{e}^{2t}}{(4{e}^{4t}+1)^{3/2}}\\sqrt{4{e}^{4t}+1} \\\\  & =\\frac{4{e}^{2t}}{4{e}^{4t}+1}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{4{e}^{2t}}{(4{e}^{4t}+1)^{3/2}}⟨1,-2{e}^{2t},0⟩}{(\\frac{4{e}^{2t}}{4{e}^{4t}+1})}=\\frac{1}{\\sqrt{4{e}^{4t}+1}}⟨1,\\,-2{e}^{2t},\\,0⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{4{e}^{4t}+1}}⟨2{e}^{2t},1,0⟩\\times \\frac{1}{\\sqrt{4{e}^{4t}+1}}⟨1,\\,-2{e}^{2t},\\,0⟩ \\\\  & =\\frac{1}{4{e}^{4t}+1}\\,\\left|\\begin{aligned}i & j & k \\\\ 2{e}^{2t} & 1 & 0 \\\\ 1 & -2{e}^{2t} & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{4{e}^{4t}+1}[\\text{ }\\left|\\begin{aligned}1 & 0 \\\\ -2{e}^{2t} & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}2{e}^{2t} & 0 \\\\ 1 & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}2{e}^{2t} & 1 \\\\ 1 & -2{e}^{2t}\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{4{e}^{4t}+1}⟨0+0,-(0-0),-4{e}^{4t}-1⟩ \\\\  & =\\frac{1}{4{e}^{4t}+1}⟨0,0,-(4{e}^{4t}+1)⟩ \\\\  & =⟨0,\\,0,\\,-1⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99653/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "93d895a2-73eb-5141-b56d-48090debf57b"] :knowledge-point/questions ["q-99653"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8595"] :question/problem "Find the binormal vector to the curve $\\mathbf r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{{t}^{2}+16}}⟨0,t,4⟩, \\\\ N(t) & =\\frac{1}{\\sqrt{{t}^{2}+16}}⟨0,4,-t⟩.\\end{aligned}\n$$\n\nNote that $\\mathbf T$ and $\\mathbf N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\n\\mathbf B(t) = \\mathbf T(t) \\times \\mathbf N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{{t}^{2}+16}}⟨0,t,4⟩\\times \\frac{1}{\\sqrt{{t}^{2}+16}}⟨0,4,-t⟩ \\\\  & =\\frac{1}{{t}^{2}+16}\\,\\left|\\begin{aligned}i & j & k \\\\ 0 & t & 4 \\\\ 0 & 4 & -t\\end{aligned}\\right| \\\\  & =\\frac{1}{{t}^{2}+16}[\\text{ }\\left|\\begin{aligned}t & 4 \\\\ 4 & -t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}0 & 4 \\\\ 0 & -t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}0 & t \\\\ 0 & 4\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{{t}^{2}+16}⟨(-{t}^{2}-16),-(0-0),(0-0)⟩ \\\\  & =\\frac{1}{{t}^{2}+16}⟨-({t}^{2}+16),0,0⟩ \\\\  & =⟨-1,0,0⟩.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8596"] :question/problem "Find the binormal vector to the curve $\\mathbf r(t)$ at the point $t=\\pi$, given that\n\n$$\n\\begin{aligned}T(\\pi ) & =\\frac{1}{5}⟨0,-3,4⟩, \\\\ N(\\pi ) & =⟨1,0,0⟩.\\end{aligned}\n$$\n\nNote that $\\mathbf T$ and $\\mathbf N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\n\\mathbf B(t) = \\mathbf T(t) \\times \\mathbf N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(\\pi ) & =T(\\pi )\\times N(\\pi ) \\\\  & =\\frac{1}{5}⟨0,-3,4⟩\\times ⟨1,0,0⟩ \\\\  & =\\frac{1}{5}\\left|\\begin{aligned}i & j & k \\\\ 0 & -3 & 4 \\\\ 1 & 0 & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{5}[\\text{ }\\left|\\begin{aligned}-3 & 4 \\\\ 0 & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}0 & 4 \\\\ 1 & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}0 & -3 \\\\ 1 & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{5}⟨(0-0),-(0-4),(0-(-3))⟩ \\\\  & =\\frac{1}{5}⟨0,4,3⟩.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8597"] :question/problem "Find the binormal vector to the curve $\\mathbf r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{5}}⟨\\operatorname{sin}⁡4t,2,\\operatorname{cos}⁡4t⟩.\\end{aligned}\n$$\n\nNote that $\\mathbf T$ denotes the unit tangent vector." :question/worked-solution "The binormal vector is given by\n\n$$\n\\mathbf B(t) = \\mathbf T(t) \\times \\mathbf N(t),\n$$\n\nwhere the principal normal vector $\\mathbf N(t)$ is given by\n\n$$\n\\mathbf N(t)= \\dfrac{\\mathbf T'(t)}{\\|\\mathbf T'(t)\\|}.\n$$\n\nFirst, we find the principal normal $\\mathbf{N}(t).$ To do this, we calculate $\\mathbf T'(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{5}}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡4t),\\,\\frac{\\text{d}}{\\text{d}t}(2),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡4t)⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨4\\operatorname{cos}⁡4t,\\,0,\\,-4\\operatorname{sin}⁡4t⟩ \\\\  & =\\frac{4}{\\sqrt{5}}⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{5}}\\sqrt{(4\\operatorname{cos}⁡4t)^{2}+{0}^{2}+{(-4\\operatorname{sin}⁡4t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16{cos}^{2}⁡4t+16{sin}^{2}⁡4t} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16({cos}^{2}⁡4t+{sin}^{2}⁡4t)} \\\\  & =\\frac{1}{\\sqrt{5}}\\sqrt{16} \\\\  & =\\frac{4}{\\sqrt{5}}\\end{aligned}\n$$\n\nNow, we normalize $\\mathbf T'(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖} \\\\  & =\\frac{\\frac{4}{\\sqrt{5}}⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩}{(\\frac{4}{\\sqrt{5}})} \\\\  & =⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{5}}⟨\\operatorname{sin}⁡4t,2,\\operatorname{cos}⁡4t⟩\\times ⟨\\operatorname{cos}⁡4t,\\,0,\\,-\\operatorname{sin}⁡4t⟩ \\\\  & =\\frac{1}{\\sqrt{5}}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{sin}⁡4t & 2 & \\operatorname{cos}⁡4t \\\\ \\operatorname{cos}⁡4t & 0 & -\\operatorname{sin}⁡4t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{5}}[\\text{ }\\left|\\begin{aligned}2 & \\operatorname{cos}⁡4t \\\\ 0 & -\\operatorname{sin}⁡4t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{sin}⁡4t & \\operatorname{cos}⁡4t \\\\ \\operatorname{cos}⁡4t & -\\operatorname{sin}⁡4t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{sin}⁡4t & 2 \\\\ \\operatorname{cos}⁡4t & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{5}}⟨-2\\operatorname{sin}⁡4t-0,-(-{sin}^{2}⁡4t-{cos}^{2}⁡4t),0-2\\operatorname{cos}⁡4t⟩ \\\\  & =\\frac{1}{\\sqrt{5}}⟨-2\\operatorname{sin}⁡4t,\\,1,\\,-2\\operatorname{cos}⁡4t⟩\\end{aligned}\n$$" :db/ensure [:question/validate]}]
