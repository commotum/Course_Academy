}^{2t}+1}}⟨0,1,-{e}^{t}⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{{e}^{2t}+1}}⟨0,{e}^{t},1⟩\\times \\frac{1}{\\sqrt{{e}^{2t}+1}}⟨0,1,-{e}^{t}⟩ \\\\  & =\\frac{1}{{e}^{2t}+1}\\,\\left|\\begin{aligned}i & j & k \\\\ 0 & {e}^{t} & 1 \\\\ 0 & 1 & -{e}^{t}\\end{aligned}\\right| \\\\  & =\\frac{1}{{e}^{2t}+1}[\\text{ }\\left|\\begin{aligned}{e}^{t} & 1 \\\\ 1 & -{e}^{t}\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}0 & 1 \\\\ 0 & -{e}^{t}\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}0 & {e}^{t} \\\\ 0 & 1\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{{e}^{2t}+1}⟨-{e}^{2t}-1,-(0-0),0-0⟩ \\\\  & =\\frac{1}{{e}^{2t}+1}⟨-({e}^{2t}+1),0,0⟩ \\\\  & =⟨-1,0,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99265/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6ef73a00-12f7-5818-85a9-d8b5e2582bfe"] :knowledge-point/questions ["q-99265"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-96958"] :question/problem "Find the binormal vector to the curve $r(t)$ at the point $t=2$, given that\n\n$$\n\\begin{aligned}T(2) & =\\frac{1}{3}⟨2,-1,2⟩, \\\\ N(2) & =\\frac{1}{3}⟨-1,2,2⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(2) & =T(2)\\times N(2) \\\\  & =\\frac{1}{3}⟨2,-1,2⟩\\times \\frac{1}{3}⟨-1,2,2⟩ \\\\  & =\\frac{1}{9}\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & 2 \\\\ -1 & 2 & 2\\end{aligned}\\right| \\\\  & =\\frac{1}{9}[\\text{ }\\left|\\begin{aligned}-1 & 2 \\\\ 2 & 2\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}2 & 2 \\\\ -1 & 2\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}2 & -1 \\\\ -1 & 2\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{9}⟨(-2-4),-(4+2),(4-1)⟩ \\\\  & =\\frac{1}{9}⟨-6,-6,3⟩ \\\\  & =\\frac{1}{3}⟨-2,-2,1⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-99429/selection/7b91913ddd41ea3ef51a68470bc638009618210ebbe5ac4643263ff9f4aa7253" :answer/id #uuid "f314dfaa-e9a0-5e3b-bfd7-7866a52236b8" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{11}}⟨-1,1,3⟩" :db/ensure [:answer/validate]} {:db/id "q-99429/selection/fea3aed522ccc1c070aa8b58e9526875688b1e9f10c0c3d22151b89cfe770573" :answer/id #uuid "318bc00b-947f-5c1f-ba16-2b80a8c12e08" :answer/type :answer.type/math :answer/value "\\frac{1}{5\\sqrt{3}}⟨3,5\\sqrt{2},4⟩" :db/ensure [:answer/validate]} {:db/id "q-99429/selection/35f9d3aa0c9a8ede2aba0c0ac1bb2302e5d9743981a144d6790f941f70fb431d" :answer/id #uuid "8f8f027a-bdec-570e-9b2d-0b1a6ce50144" :answer/type :answer.type/math :answer/value "\\frac{1}{6}⟨3,5,-\\sqrt{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-99429/selection/beba71955dbdf2d09c0a8289992f56333f11524512612e397c69e42ccbabbb9c" :answer/id #uuid "d34bc728-0722-5dc4-81cc-ed1f251353ee" :answer/type :answer.type/math :answer/value "\\frac{1}{3}⟨2,2,1⟩" :db/ensure [:answer/validate]} {:db/id "q-99429/selection/c822970116f8118a78c526cade0ba4f6ce60f0236d6955c201693ceae83c2aa4" :answer/id #uuid "e5c9c7b2-14ab-5370-8f52-f663f1f8a2d8" :answer/type :answer.type/math :answer/value "\\frac{1}{6}⟨\\sqrt{2},-5,3⟩" :db/ensure [:answer/validate]} {:db/id "q-99429/selection" :answer-field/id #uuid "fda6b27e-9695-5d30-8cae-3f262d163f33" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99429/selection/35f9d3aa0c9a8ede2aba0c0ac1bb2302e5d9743981a144d6790f941f70fb431d" :answer-field/choices ["q-99429/selection/7b91913ddd41ea3ef51a68470bc638009618210ebbe5ac4643263ff9f4aa7253" "q-99429/selection/fea3aed522ccc1c070aa8b58e9526875688b1e9f10c0c3d22151b89cfe770573" "q-99429/selection/35f9d3aa0c9a8ede2aba0c0ac1bb2302e5d9743981a144d6790f941f70fb431d" "q-99429/selection/beba71955dbdf2d09c0a8289992f56333f11524512612e397c69e42ccbabbb9c" "q-99429/selection/c822970116f8118a78c526cade0ba4f6ce60f0236d6955c201693ceae83c2aa4"] :db/ensure [:answer-field/validate]} {:db/id "q-99429" :question/id #uuid "d5570a23-d111-5812-8b43-05d4d1f22b84" :question/math-academy-id "q-99429" :question/problem "Find the binormal vector to the curve $r(t)$ at the point $t=1,$ given that\n\n$$\n\\begin{aligned}T(1) & =\\frac{1}{2}⟨-1,1,\\sqrt{2}⟩, \\\\ N(1) & =\\frac{1}{3\\sqrt{2}}⟨3,-1,2\\sqrt{2}⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(1) & =T(1)\\times N(1) \\\\  & =\\frac{1}{2}⟨-1,1,\\sqrt{2}⟩\\times \\frac{1}{3\\sqrt{2}}⟨3,-1,2\\sqrt{2}⟩ \\\\  & =\\frac{\\sqrt{2}}{12}\\,\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & \\sqrt{2} \\\\ 3 & -1 & 2\\sqrt{2}\\end{aligned}\\right| \\\\  & =\\frac{\\sqrt{2}}{12}[\\text{ }\\left|\\begin{aligned}1 & \\sqrt{2} \\\\ -1 & 2\\sqrt{2}\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}-1 & \\sqrt{2} \\\\ 3 & 2\\sqrt{2}\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}-1 & 1 \\\\ 3 & -1\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{\\sqrt{2}}{12}⟨(2\\sqrt{2}-(-\\sqrt{2})),-(-2\\sqrt{2}-3\\sqrt{2}),(1-3)⟩ \\\\  & =\\frac{\\sqrt{2}}{12}⟨2\\sqrt{2}+\\sqrt{2},-(-5\\sqrt{2}),-2⟩ \\\\  & =\\frac{\\sqrt{2}}{12}⟨3\\sqrt{2},5\\sqrt{2},-2⟩ \\\\  & =\\frac{2}{12}⟨3,5,-\\sqrt{2}⟩ \\\\  & =\\frac{1}{6}⟨3,5,-\\sqrt{2}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99429/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91ea3125-c2b7-56d0-97d8-4e54b2c01524"] :knowledge-point/questions ["q-99429"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99415/selection/ff2dc15ed6160c37f9f4ff830efc5b11cad1ad8d193e48da321c689abaa803aa" :answer/id #uuid "27b8c3dd-572c-5e2a-b80d-68510104726d" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{10}}⟨1,0,3⟩" :db/ensure [:answer/validate]} {:db/id "q-99415/selection/bd4c08f0cab0cc77a4a4009435431f58da5787c715a0137c985e6469e36d6873" :answer/id #uuid "e963946e-be1d-5014-868c-4a726d521214" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨1,0,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-99415/selection/bfe666bd9a11cc604024a55c52ddef0cbbfde7cce7be5e2ef3473df197547d23" :answer/id #uuid "603ca2b0-1134-5336-8800-592361364268" :answer/type :answer.type/math :answer/value "\\frac{1}{5\\sqrt{2}}⟨-3,5,-4⟩" :db/ensure [:answer/validate]} {:db/id "q-99415/selection/555e42cb476630e238bae08b72e4a8046450296c37153f2e365464d5961878be" :answer/id #uuid "1e0f038c-62f3-5f95-84bd-4365347af185" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{5}}⟨-2,1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-99415/selection/2e6f1538560110a8a5c0ad3fb797e1bcd7e98cae364deb7365a4644a95746750" :answer/id #uuid "8048a3c3-52ec-500f-bcef-23728084b27e" :answer/type :answer.type/math :answer/value "\\frac{1}{2}⟨2,0,-1⟩" :db/ensure [:answer/validate]} {:db/id "q-99415/selection" :answer-field/id #uuid "874a5266-d069-5a40-8d2e-d7cb0d835313" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99415/selection/bfe666bd9a11cc604024a55c52ddef0cbbfde7cce7be5e2ef3473df197547d23" :answer-field/choices ["q-99415/selection/ff2dc15ed6160c37f9f4ff830efc5b11cad1ad8d193e48da321c689abaa803aa" "q-99415/selection/bd4c08f0cab0cc77a4a4009435431f58da5787c715a0137c985e6469e36d6873" "q-99415/selection/bfe666bd9a11cc604024a55c52ddef0cbbfde7cce7be5e2ef3473df197547d23" "q-99415/selection/555e42cb476630e238bae08b72e4a8046450296c37153f2e365464d5961878be" "q-99415/selection/2e6f1538560110a8a5c0ad3fb797e1bcd7e98cae364deb7365a4644a95746750"] :db/ensure [:answer-field/validate]} {:db/id "q-99415" :question/id #uuid "a233a198-a68f-5820-8551-5bd5e6e915ce" :question/math-academy-id "q-99415" :question/problem "Find the binormal vector to the curve $r(t)$ at the point $t=\\operatorname{ln}⁡2$, given that\n\n$$\n\\begin{aligned}T(\\operatorname{ln}⁡2) & =\\frac{1}{5\\sqrt{2}}⟨3,5,4⟩, \\\\ N(\\operatorname{ln}⁡2) & =\\frac{1}{5}⟨4,0,-3⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(\\operatorname{ln}⁡2) & =T(\\operatorname{ln}⁡2)\\times N(\\operatorname{ln}⁡2) \\\\  & =\\frac{1}{5\\sqrt{2}}⟨3,5,4⟩\\times \\frac{1}{5}⟨4,0,-3⟩ \\\\  & =\\frac{1}{25\\sqrt{2}}\\,\\left|\\begin{aligned}i & j & k \\\\ 3 & 5 & 4 \\\\ 4 & 0 & -3\\end{aligned}\\right| \\\\  & =\\frac{1}{25\\sqrt{2}}[\\text{ }\\left|\\begin{aligned}5 & 4 \\\\ 0 & -3\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}3 & 4 \\\\ 4 & -3\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}3 & 5 \\\\ 4 & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{25\\sqrt{2}}⟨(-15-0),-(-9-16),(0-20)⟩ \\\\  & =\\frac{1}{25\\sqrt{2}}⟨-15,25,-20⟩ \\\\  & =\\frac{1}{5\\sqrt{2}}⟨-3,5,-4⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99415/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91ea3125-c2b7-56d0-97d8-4e54b2c01524"] :knowledge-point/questions ["q-99415"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99430/selection/313801355383300c7eadad3d2113c4483b418ab6c0c9e1f96e9c6f39b8f18715" :answer/id #uuid "98dc35fe-a3a6-51e3-a375-357bd51a1c3d" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨-1,1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-99430/selection/104c8589f3a5454fe2b1c57b9b2a385499976b322c976dc2be54fb81b45fb8