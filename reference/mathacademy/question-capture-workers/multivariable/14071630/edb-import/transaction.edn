sin}⁡(2t-1)-0,-({sin}^{2}⁡(2t-1)+{cos}^{2}⁡(2t-1)),0+\\operatorname{cos}⁡(2t-1)⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨-\\operatorname{sin}⁡(2t-1),-1,\\operatorname{cos}⁡(2t-1)⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-99413/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6ef73a00-12f7-5818-85a9-d8b5e2582bfe"] :knowledge-point/questions ["q-99413"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-96957"] :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{5}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,4⟩, \\\\ N(t) & =⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{5}⟨-3\\operatorname{sin}⁡t,3\\operatorname{cos}⁡t,4⟩\\times ⟨-\\operatorname{cos}⁡t,-\\operatorname{sin}⁡t,0⟩ \\\\  & =\\frac{1}{5}\\left|\\begin{aligned}i & j & k \\\\ -3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t & 4 \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t & 0\\end{aligned}\\right| \\\\  & =\\frac{1}{5}[\\text{ }\\left|\\begin{aligned}3\\operatorname{cos}⁡t & 4 \\\\ -\\operatorname{sin}⁡t & 0\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}-3\\operatorname{sin}⁡t & 4 \\\\ -\\operatorname{cos}⁡t & 0\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}-3\\operatorname{sin}⁡t & 3\\operatorname{cos}⁡t \\\\ -\\operatorname{cos}⁡t & -\\operatorname{sin}⁡t\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{5}⟨(0-(-4\\operatorname{sin}⁡t)),-(0-(-4\\operatorname{cos}⁡t)),(3{sin}^{2}⁡t+3{cos}^{2}⁡t)⟩ \\\\  & =\\frac{1}{5}⟨4\\operatorname{sin}⁡t,-4\\operatorname{cos}⁡t,3⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-127613/selection/6ffc44925828339f4b1e04a623c7a8790664b3003c5016eadb27ba570d8ca0e5" :answer/id #uuid "131db049-42d5-5505-9e07-8ec36d36dd62" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{2}}⟨0,-1,1⟩" :db/ensure [:answer/validate]} {:db/id "q-127613/selection/9563bb01cdc4dfd8c109bd7f1607518043a52d85360f3d1a4e0e596a31c45e25" :answer/id #uuid "efa4da52-e24f-5d58-8a9b-d4bae44ef6cf" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨\\sqrt{3-t},\\sqrt{t},0⟩" :db/ensure [:answer/validate]} {:db/id "q-127613/selection/a51de418aa7407d3dc84d3aeaedca3fbdbf926ab36a8821b9f6ce35705195712" :answer/id #uuid "d92fa104-4fb5-579f-9b80-ab815351fdb0" :answer/type :answer.type/math :answer/value "⟨0,-1,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127613/selection/6881ac8c15262b4bb4ec672547ef9f4012175d0e51ad10e892f7a6610d160fd9" :answer/id #uuid "3ffd7cf1-5bfa-5ff5-b4f8-f45aa6934823" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{3}}⟨0,-\\sqrt{3-t},\\sqrt{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-127613/selection/104c8589f3a5454fe2b1c57b9b2a385499976b322c976dc2be54fb81b45fb84f" :answer/id #uuid "3cf8fcd4-bd10-5005-9fab-a36c2aa6be03" :answer/type :answer.type/math :answer/value "⟨1,0,0⟩" :db/ensure [:answer/validate]} {:db/id "q-127613/selection" :answer-field/id #uuid "119d3a51-bb4f-5c27-9623-030c20c96853" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127613/selection/a51de418aa7407d3dc84d3aeaedca3fbdbf926ab36a8821b9f6ce35705195712" :answer-field/choices ["q-127613/selection/6ffc44925828339f4b1e04a623c7a8790664b3003c5016eadb27ba570d8ca0e5" "q-127613/selection/9563bb01cdc4dfd8c109bd7f1607518043a52d85360f3d1a4e0e596a31c45e25" "q-127613/selection/a51de418aa7407d3dc84d3aeaedca3fbdbf926ab36a8821b9f6ce35705195712" "q-127613/selection/6881ac8c15262b4bb4ec672547ef9f4012175d0e51ad10e892f7a6610d160fd9" "q-127613/selection/104c8589f3a5454fe2b1c57b9b2a385499976b322c976dc2be54fb81b45fb84f"] :db/ensure [:answer-field/validate]} {:db/id "q-127613" :question/id #uuid "126d7092-f259-50a6-8d9e-e771713a98c4" :question/math-academy-id "q-127613" :question/problem "Find the binormal vector to the curve $r(t)$ at an arbitrary point, given that\n\n$$\n\\begin{aligned}T(t) & =\\frac{1}{\\sqrt{3}}⟨-\\sqrt{t},0,\\sqrt{3-t}⟩, \\\\ N(t) & =\\frac{1}{\\sqrt{3}}⟨-\\sqrt{3-t},0,-\\sqrt{t}⟩.\\end{aligned}\n$$\n\nNote that $T$ and $N$ denote the unit tangent and principal normal, respectively." :question/worked-solution "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t).\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{3}}⟨-\\sqrt{t},0,\\sqrt{3-t}⟩\\times \\frac{1}{\\sqrt{3}}⟨-\\sqrt{3-t},0,-\\sqrt{t}⟩ \\\\  & =\\frac{1}{3}\\left|\\begin{aligned}i & j & k \\\\ -\\sqrt{t} & 0 & \\sqrt{3-t} \\\\ -\\sqrt{3-t} & 0 & -\\sqrt{t}\\end{aligned}\\right| \\\\  & =\\frac{1}{3}\\left|\\begin{aligned}0 & \\sqrt{3-t} \\\\ 0 & -\\sqrt{t}\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}-\\sqrt{t} & \\sqrt{3-t} \\\\ -\\sqrt{3-t} & -\\sqrt{t}\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}-\\sqrt{t} & 0 \\\\ -\\sqrt{3-t} & 0\\end{aligned}\\right|\\,k \\\\  & =\\frac{1}{3}⟨0-0,-(t+(3-t)),0-0⟩ \\\\  & =\\frac{1}{3}⟨0,-3,0⟩ \\\\  & =⟨0,-1,0⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-127613/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6ef73a00-12f7-5818-85a9-d8b5e2582bfe"] :knowledge-point/questions ["q-127613"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99265/selection/958f6ae4ba850886e525171c7424867ef5f6f93ce891024d3b17d94d67dd91e3" :answer/id #uuid "067a1ae9-20c4-5ed0-bfec-2a58fbdf701b" :answer/type :answer.type/math :answer/value "⟨-1,0,0⟩" :db/ensure [:answer/validate]} {:db/id "q-99265/selection/8d74b326a8377c008f3104dad595eb38340f3b96a41873c51005c7f3d3b3d54c" :answer/id