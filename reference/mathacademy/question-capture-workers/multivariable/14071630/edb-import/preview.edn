-\\operatorname{sin}⁡t⟩.\\end{aligned}\n$$\n\nNote that $T$ denotes the unit tangent vector." 13194139535879 true] [17592186372070 1113 #uuid "c3acb097-24af-576e-b081-d26bf643475d" 13194139535879 true] [17592186372070 1145 "The binormal vector is given by\n\n$$\nB(t)=T(t)\\times N(t),\n$$\n\nwhere the principal normal vector $N(t)$ is given by\n\n$$\nN(t)=\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}.\n$$\n\nFirst, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{1}{\\sqrt{3}}⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(0),\\,\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)⟩ \\\\  & =\\frac{1}{\\sqrt{3}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\ ‖{T}^{′}(t)‖ & =\\frac{1}{\\sqrt{3}}\\sqrt{(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}+{(0)}^{2}+{(-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\frac{1}{\\sqrt{3}}\\sqrt{{cos}^{2}⁡t-2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{sin}^{2}⁡t+{sin}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t} \\\\  & =\\frac{\\sqrt{2}}{\\sqrt{3}}\\end{aligned}\n$$\n\nNow, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{\\frac{1}{\\sqrt{3}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩}{(\\frac{\\sqrt{2}}{\\sqrt{3}})}=\\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$\n\nFinally, we calculate the binormal vector, as follows:\n\n$$\n\\begin{aligned}B(t) & =T(t)\\times N(t) \\\\  & =\\frac{1}{\\sqrt{3}}⟨\\operatorname{cos}⁡t+\\operatorname{sin}⁡t,1,\\operatorname{cos}⁡t-\\operatorname{sin}⁡t⟩\\times \\frac{1}{\\sqrt{2}}⟨\\operatorname{cos}⁡t-\\operatorname{sin}⁡t,\\,0,\\,-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\  & =\\frac{1}{\\sqrt{6}}\\,\\left|\\begin{aligned}i & j & k \\\\ \\operatorname{cos}⁡t+\\operatorname{sin}⁡t & 1 & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & 0 & -\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}\\right| \\\\  & =\\frac{1}{\\sqrt{6}}[\\text{ }\\left|\\begin{aligned}1 & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ 0 & -\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}\\right|\\,i-\\left|\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t & \\operatorname{cos}⁡t-\\operatorname{sin}⁡t \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & -\\operatorname{sin}⁡t-\\operatorname{cos}⁡t\\end{aligned}\\right|\\,j+\\left|\\begin{aligned}\\operatorname{cos}⁡t+\\operatorname{sin}⁡t & 1 \\\\ \\operatorname{cos}⁡t-\\operatorname{sin}⁡t & 0\\end{aligned}\\right|\\,k\\text{ }] \\\\  & =\\frac{1}{\\sqrt{6}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t-0,-(-(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}-(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2}),-(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)^{2}+(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)^{2},\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩ \\\\  & =\\frac{1}{\\sqrt{6}}⟨-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t,\\,2,\\,\\operatorname{sin}⁡t-\\operatorname{cos}⁡t⟩\\end{aligned}\n$$" 13194139535879 true] [17592186372071 1000 #edb/ref 17592186372072 13194139535879 true] [17592186372071 1000 #edb/ref 17592186372073 13194139535879 true] [17592186372071 1000 #edb/ref 17592186372074 13194139535879 true] [17592186372071 1000 #edb/ref 17592186372075 13194139535879 true] [17592186372071 1000 #edb/ref 17592186372076 13194139535879 true] [17592186372071 1040 #edb/ref 17592186045450 13194139535879 true] [17592186372071 1041 "selection" 131941395358