qrt{2}}-{e}^{\\operatorname{ln}⁡(1/\\sqrt{2})}) \\\\  & =\\frac{1}{2}(\\sqrt{2}-\\frac{1}{\\sqrt{2}}) \\\\  & =\\frac{1}{2}(\\frac{2-1}{\\sqrt{2}}) \\\\  & =\\frac{1}{2\\sqrt{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-9446" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/activity-metadata.json" "file_sha256" "addfc6251a968bc7c4488071b4d57376291c909cf447db1412fb6e079f56fc56"} {"question" "q-9446" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-9446" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{2\\sqrt{2}}"] ["math" "\\frac{1}{4\\sqrt{2}}"] ["math" "\\frac{1}{\\sqrt{2}}"] ["math" "\\frac{2}{3\\sqrt{2}}"] ["math" "\\frac{2}{\\sqrt{2}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-9446" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2\\sqrt{2}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95490" "field" nil "attribute" "question/problem" "value" "$\\operatorname{sinh}⁡2t=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95490" "field" nil "attribute" "question/worked-solution" "value" "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\operatorname{sinh}⁡2t=\\frac{1}{2}({e}^{2t}-{e}^{-2t}).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95490" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/activity-metadata.json" "file_sha256" "addfc6251a968bc7c4488071b4d57376291c909cf447db1412fb6e079f56fc56"} {"question" "q-95490" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95490" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "\\frac{1}{2}({e}^{-2t}-{e}^{2t})"] ["math" "\\frac{1}{2}({e}^{-t/2}-{e}^{t/2})"] ["math" "\\frac{1}{2}({e}^{2t}+{e}^{-2t})"] ["math" "\\frac{1}{2}({e}^{2t}-{e}^{-2t})"] ["math" "\\frac{1}{2}({e}^{t/2}-{e}^{-t/2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95490" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}({e}^{2t}-{e}^{-2t})"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-342675" "field" nil "attribute" "question/problem" "value" "Simplify $\\operatorname{tanh}⁡(2q)$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$\\operatorname{tanh}⁡(2q)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{4q}+1$ |" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-342675" "field" nil "attribute" "question/worked-solution" "value" "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(2q) & =\\frac{{e}^{2(2q)}-1}{{e}^{2(2q)}+1} \\\\  & =\\frac{{e}^{4q}-1}{{e}^{4q}+1}\\,\\,.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-342675" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/activity-metadata.json" "file_sha256" "addfc6251a968bc7c4488071b4d57376291c909cf447db1412fb6e079f56fc56"} {"question" "q-342675" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-342675" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "e^{4q}-1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95599" "field" nil "attribute" "question/problem" "value" "Which of the following is equivalent to  $\\operatorname{tanh}⁡\\sqrt{u}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95599" "field" nil "attribute" "question/worked-solution" "value" "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡\\sqrt{u} & =\\frac{{e}^{2\\sqrt{u}}-1}{{e}^{2\\sqrt{u}}+1}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077555/state.json" "file_sha256" "512ed2c0d0f9c837f349c2dd836e5e4eec29b9f91c8dccd8a236b40b4ee2f6ac"} {"question" "q-95599" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/matha