{:edb/db-before-t 2801 :edb/db-after-t 2802 :edb/tx-data [[13194139536114 50 #inst "2026-10-09T15:22:18.061Z" 13194139536114 true] [17592186092079 1100 "Evaluate $\\cosh  (\\ln 2).$" 13194139536114 true] [17592186092079 1100 "Evaluate $\\cosh (\\ln 2)$." 13194139536114 false] [17592186092079 1145 "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x})\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\cosh (\\ln 2) &= \\frac{1}{2}(e^{\\ln 2} + e^{-\\ln 2}) \\\\\n&= \\frac{1}{2}(e^{\\ln 2} + e^{\\ln 2^{-1}}) \\\\\n&= \\frac{1}{2}(2 + 2^{-1}) \\\\\n&= \\frac{1}{2}(2 + \\frac{1}{2}) \\\\\n&= \\frac{1}{2}(\\frac{4 + 1}{2}) \\\\\n&= \\frac{5}{4}\n\\end{aligned}\n$$" 13194139536114 false] [17592186092079 1145 "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡2) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{\\operatorname{ln}⁡{2}^{-1}}) \\\\  & =\\frac{1}{2}(2+{2}^{-1}) \\\\  & =\\frac{1}{2}(2+\\frac{1}{2}) \\\\  & =\\frac{1}{2}(\\frac{4+1}{2}) \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$" 13194139536114 true] [17592186092080 1100 "Evaluate $\\tanh{4}$." 13194139536114 false] [17592186092080 1100 "Evaluate $\\tanh{4}.$" 13194139536114 true] [17592186092080 1145 "The definition of $\\tanh x$ is\n\n$$\n\\begin{aligned}\n\\tanh x &= \\frac{e^{x} - e^{-x}}{e^{x} + e^{-x}} \\\\\n&= \\frac{e^{2x} - 1}{e^{2x} + 1} \\\\\n&= \\frac{1 - e^{-2x}}{1 + e^{-2x}}\n\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\n\\tanh 4 &= (e^{2(4)} - 1)/(e^{2(4)} + 1) \\\\\n&= \\frac{e^{8} - 1}{e^{8} + 1}\n\\end{aligned}\n$$" 13194139536114 false] [17592186092080 1145 "The definition of $\\tanh x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡4 & =\\frac{{e}^{2(4)}-1}{{e}^{2(4)}+1} \\\\  & =\\frac{{e}^{8}-1}{{e}^{8}+1}.\\end{aligned}\n$$" 13194139536114 true] [17592186092084 1100 "Evaluate $\\sinh 1$." 13194139536114 false] [17592186092084 1100 "Evaluate $\\sinh 1.$" 13194139536114 true] [17592186092084 1145 "The definition of $\\sinh x$ is\n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x})\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\sinh 1 &= \\frac{1}{2}(e^{1} - e^{-1}) \\\\\n&= \\frac{1}{2}(e - \\frac{1}{e}) \\\\\n&= \\frac{1}{2}(\\frac{e^{2} - 1}{e}) \\\\\n&= \\frac{e^{2} - 1}{2e}\n\\end{aligned}\n$$" 13194139536114 false] [17592186092084 1145 "The definition of $\\sinh x$ is \n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡1 & =\\frac{1}{2}({e}^{1}-{e}^{-1}) \\\\  & =\\frac{1}{2}(e-\\frac{1}{e}) \\\\  & =\\frac{1}{2}(\\frac{{e}^{2}-1}{e}) \\\\  & =\\frac{{e}^{2}-1}{2e}.\\end{aligned}\n$$" 13194139536114 true] [17592186092233 1020 #edb/ref 17592186384243 13194139536114 true] [17592186092233 1020 #edb/ref 17592186384246 13194139536114 true] [17592186092233 1020 #edb/ref 17592186384250 13194139536114 true] [17592186092233 1020 #edb/ref 17592186384253 13194139536114 true] [17592186092233 1020 #edb/ref 17592186384285 13194139536114 true] [17592186092234 1020 #edb/ref 17592186384257 13194139536114 true] [17592186092234 1020 #edb/ref 17592186384260 13194139536114 true] [17592186092234 1020 #edb/ref 17592186384264 13194139536114 true] [17592186092234 1020 #edb/ref 17592186384292 13194139536114 true] [17592186092234 1020 #edb/ref 17592186384299 13194139536114 true] [17592186092238 1020 #edb/ref 17592186384236 13194139536114 true] [17592186092238 1020 #edb/ref 17592186384268 13194139536114 true] [17592186092238 1020 #edb/ref 17592186384271 13194139536114 true] [17592186092238 1020 #edb/ref 17592186384278 13194139536114 true] [17592186