edge-point/questions ["q-95590"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342240/field-1/6d38dedfd7f6f3b9d9b9f213ae09c9e58f3114fbe66d3befb14d23f412f4c7e8" :answer/id #uuid "6154bad4-2e35-50c2-b991-2fb5649b6ded" :answer/type :answer.type/math :answer/value "z^{-6}" :db/ensure [:answer/validate]} {:db/id "q-342240/field-1/f854915fc8e7ac832619997d5a0715b83ec2d77c9f5df1e1d5309e3a8600c9ad" :answer/id #uuid "02f9344c-481d-545c-aa09-7eab7c04382f" :answer/type :answer.type/math :answer/value "z^6" :db/ensure [:answer/validate]} {:db/id "q-342240/field-1" :answer-field/id #uuid "6bfa0f50-1e07-5620-b802-081e1aaac3a2" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342240/field-1/6d38dedfd7f6f3b9d9b9f213ae09c9e58f3114fbe66d3befb14d23f412f4c7e8" :answer-field/choices ["q-342240/field-1/6d38dedfd7f6f3b9d9b9f213ae09c9e58f3114fbe66d3befb14d23f412f4c7e8" "q-342240/field-1/f854915fc8e7ac832619997d5a0715b83ec2d77c9f5df1e1d5309e3a8600c9ad"] :db/ensure [:answer-field/validate]} {:db/id "q-342240" :question/id #uuid "65335650-dc8e-59b6-bb76-191748fe0376" :question/math-academy-id "q-342240" :question/problem "Given that $z>0,$ simplify $\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})=\\frac{1}{2}({z}^{6}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2}) & =\\frac{1}{2}({e}^{3\\operatorname{ln}⁡{z}^{2}}+{e}^{-3\\operatorname{ln}⁡{z}^{2}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{2})^{3}}+{e}^{\\operatorname{ln}⁡({z}^{2})^{-3}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{6})}+{e}^{\\operatorname{ln}⁡({z}^{-6})}) \\\\  & =\\frac{1}{2}({z}^{6}+{z}^{-6}).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342240/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690"] :knowledge-point/questions ["q-342240"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342231/field-1/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer/id #uuid "f03f597f-0675-5c8a-ae63-72b262e6de63" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "q-342231/field-1" :answer-field/id #uuid "ae2d2dda-0804-55f3-a733-bed93ddce690" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342231/field-1/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer-field/choices ["q-342231/field-1/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818"] :db/ensure [:answer-field/validate]} {:db/id "q-342231" :question/id #uuid "b3a1c9c2-bdcc-5cf3-97e0-4aafa1ecc4f6" :question/math-academy-id "q-342231" :question/problem "Evaluate $\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3)).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3))=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3)) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡(1/3)}+{e}^{-\\operatorname{ln}⁡(1/3)}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡(1/3)}+{e}^{\\operatorname{ln}⁡(3)}) \\\\  & =\\frac{1}{2}(\\frac{1}{3}+3) \\\\  & =\\frac{1}{2}(\\frac{1+9}{3}) \\\\  & =\\frac{10}{6} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342231/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690"] :knowledge-point/questions ["q-342231"] :db/ensure [:knowledge-point/validate]} {:db/id