0db"] :knowledge-point/questions ["q-125355"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342689/field-1/6204a7f49d31d64de344570c382d077ad3a2c85aba589915cbcd380a42112a8e" :answer/id #uuid "dd06f2b0-27c4-542d-8fa6-23283b81391d" :answer/type :answer.type/math :answer/value "\\frac{15}{8}" :db/ensure [:answer/validate]} {:db/id "q-342689/field-1" :answer-field/id #uuid "4b0139a5-de1c-5358-a59c-64567cd4302c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342689/field-1/6204a7f49d31d64de344570c382d077ad3a2c85aba589915cbcd380a42112a8e" :answer-field/choices ["q-342689/field-1/6204a7f49d31d64de344570c382d077ad3a2c85aba589915cbcd380a42112a8e"] :db/ensure [:answer-field/validate]} {:db/id "q-342689" :question/id #uuid "455c2ee1-bb19-5c8e-824a-4a050245d2c7" :question/math-academy-id "q-342689" :question/problem "Evaluate $\\operatorname{sinh}⁡(\\operatorname{ln}⁡4).$ **Do not round** your answer.\n\n$\\operatorname{sinh}⁡(\\operatorname{ln}⁡4)=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(\\operatorname{ln}⁡4) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡4}-{e}^{-\\operatorname{ln}⁡4}) \\\\  & =\\frac{1}{2}(4-{4}^{-1}) \\\\  & =\\frac{1}{2}(4-\\frac{1}{4}) \\\\  & =\\frac{1}{2}(\\frac{15}{4}) \\\\  & =\\frac{15}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342689/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db"] :knowledge-point/questions ["q-342689"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-9446"] :question/problem "$\\operatorname{sinh}⁡(\\operatorname{ln}⁡\\sqrt{2})=$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(\\operatorname{ln}⁡\\sqrt{2}) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{2}}-{e}^{-\\operatorname{ln}⁡\\sqrt{2}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{2}}-{e}^{\\operatorname{ln}⁡(1/\\sqrt{2})}) \\\\  & =\\frac{1}{2}(\\sqrt{2}-\\frac{1}{\\sqrt{2}}) \\\\  & =\\frac{1}{2}(\\frac{2-1}{\\sqrt{2}}) \\\\  & =\\frac{1}{2\\sqrt{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-95490/selection/64e6c6f82e2827979ae1b0450fea4677904fd61b9b238f747070888ec90395ec" :answer/id #uuid "4fab7a94-2041-51c5-b6dd-46e936e5e592" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{2t}+{e}^{-2t})" :db/ensure [:answer/validate]} {:db/id "q-95490/selection/6a722c7816a230d520bc40bdd141609ea6d63e64f0ae95de97f0b46362f80609" :answer/id #uuid "1f5fd104-7b7c-5b93-a8dd-d3fd94005038" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{-t/2}-{e}^{t/2})" :db/ensure [:answer/validate]} {:db/id "q-95490/selection/1f30f24723c9f00f47650b9bace4296578cad19619def8fc911701bc9ff41da4" :answer/id #uuid "c51d56b0-7fa6-51d5-adb9-ccd8c2f25c52" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{-2t}-{e}^{2t})" :db/ensure [:answer/validate]} {:db/id "q-95490/selection/23e9b9822a42129c92be57a17ac5110f2d0f3bfc54bb6e24166b3a77a5b0c0ec" :answer/id #uuid "77a09d2f-4202-503c-b0c7-94b27750debb" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{t/2}-{e}^{-t/2})" :db/ensure [:answer/validate]} {:db/id "q-95490/selection/0c1727fa512f8201062c73cc86875e6f1ef9d683cfa2975b61c2c8da765ef726" :answer/id #uuid "5c7ecc18-1139-52f6-8b4c-3867976dd95d" :answer/type :answer.type/math :answer/value "\\frac{1}{2}({e}^{2t}-{e}^{-2t})" :db/ensure [:answer/validate]} {:db/id "q-95490/selection" :answer-field/id #uuid "84fca5b0-0163-547b-96b1-915b3475861e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95490/selection/0c1727fa512f8201062c73cc86875e6f1ef9d683cfa2975b61c2c8da765ef726" :answer-field/choices ["q-95490/selection/64e6c6f82e2827979ae1b0450fea4677904fd61b9b238f747070888ec90395ec" "q-95490/selection/6a722c7816a230d520bc40bdd141609ea6d63e64f0ae95de97f0b46362f80609" "q-95490/selection/1f30f24723c9f00f47650b9bace4296578cad19619def8fc911701bc9ff41da4" "q-95490/selection/23e9b9822a42129c92be57a17ac5110f2d0f3bfc54bb6e24166b3a77a5b0c0ec" "q-95490/selection/0c1727fa512f8201062c73cc86875e6f1ef9d683cfa2975b61c2c8da765ef726"] :db/ensure [:answer-field/validate]} {:db/id "q-95490" :question/id #uuid "f68ba0f5-66c1-5a1c-8ea7-14b5acc5ca17" :question/math-academy-id "q-95490" :question/problem "$\\operatorname{sinh}⁡2t=$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\operatorname{sinh}⁡2t=\\frac{1}{2}({e}^{2t}-{e}^{-2t}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95490/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db"] :knowledge-point/questions ["q-95490"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342675/field-1/21b2228a2b4c60bb018ca611f2c18a454267c059f54b963c79b6676a8cf0ecdf" :answer/id #uuid "0f7dd3cf-b7af-5f7f-a6a9-f31515d66e57" :answer/type :answer.type/math :answer/value "e^{4q}-1" :db/ensure [:answer/validate]} {:db/id "q-342675/field-1/ce88e00c2ad82a473d26d47b297662df60d648734c1df434fbf50c913ab9232d" :answer/id #uuid "56b0bcbb-7e3d-5c8c-a71f-6f8b29df3b6a" :answer/type :answer.type/math :answer/value "e^{4q}+1" :db/ensure [:answer/validate]} {:db/id "q-342675/field-1" :answer-field/id #uuid "b0dac74f-7189-5570-8a27-004cd59367d6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342675/field-1/21b2228a2b4c60bb018ca611f2c18a454267c059f54b963c79b6676a8cf0ecdf" :answer-field/choices ["q-342675/field-1/21b2228a2b4c60bb018ca611f2c18a454267c059f54b963c79b6676a8cf0ecdf" "q-342675/field-1/ce88e00c2ad82a473d26d47b297662df60d648734c1df434fbf50c913ab9232d"] :db/ensure [:answer-field/validate]} {:db/id "q-342675" :question/id #uuid "70877924-44df-51b9-bda6-63308a7bf099" :question/math-academy-id "q-342675" :question/problem "Simplify $\\operatorname{tanh}⁡(2q)$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$\\operatorname{tanh}⁡(2q)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{4q}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(2q) & =\\frac{{e}^{2(2q)}-1}{{e}^{2(2q)}+1} \\\\  & =\\frac{{e}^{4q}-1}{{e}^{4q}+1}\\,\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342675/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7"] :knowledge-point/questions ["q-342675"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95599/selection/e25fbc56c3d7ed2ffcefc5544455bb8f4597ac26b0264c6f3b3cee21279fa9fe" :answer/id #uuid "6f1b1a87-772c-5eff-a8d6-cbe5a5c315ba" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2\\sqrt{u}}-1}{{e}^{2\\sqrt{u}}+1}" :db/ensure [:answer/validate]} {:db/id "q-95599/selection/09bf52c3960b0aed584cdf4bf0d94c7ec9e3ac4e51547a28d81d06197eef9fd4" :answer/id #uuid "e009c367-13e0-5191-a31c-d84171965dec" :answer/type :answer.type/math :answer/value "\\frac{2{e}^{2\\sqrt{u}}-1}{2{e}^{2\\sqrt{u}}+1}" :db/ensure [:answer/validate]} {:db/id "q-95599/selection/5aede8d08d3907a110167350028d3d1603734365605ae654520c997c92edbed6" :answer/id #uuid "68cf0024-84be-596e-8be2-7ab1ef0aba04" :answer/type :answer.type/math :answer/value "\\frac{2{e}^{\\sqrt{u}/2}+1}{2{e}^{\\sqrt{u}/2}-1}" :db/ensure [:answer/validate]} {:db/id "q-95599/selection/763fb700772ead13bb1946ac4cb82401551211e9ba6da4a9975c300eb4a9e3eb" :answer/id #uuid "ff80b2b6-a9b1-58fb-9359-13346e70b174" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2\\sqrt{u}}+1}{{e}^{2\\sqrt{u}}-1}" :db/ensure [:answer/validate]} {:db/id "q-95599/selection/7db076a7bdbefe39f1330d881a429a941d6b58d2e1e4b9592df0ed54599d0a6d" :answer/id #uuid "9ac3ae1f-cea0-515e-aa7a-d61d824b4a7c" :answer/type :answer.type/math :answer/value "\\frac{{e}^{\\sqrt{u}/2}-1}{{e}^{\\sqrt{u}/2}+1}" :db/ensure [:answer/validate]} {:db/id "q-95599/selection" :answer-field/id #uuid "d8143f12-0306-5d52-8118-a558ae545d18" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95599/selection/e25fbc56c3d7ed2ffcefc5544455bb8f4597ac26b0264c6f3b3cee21279fa9fe" :answer-field/choices ["q-95599/selection/e25fbc56c3d7ed2ffcefc5544455bb8f4597ac26b0264c6f3b3cee21279fa9fe" "q-95599/selection/09bf52c3960b0aed584cdf4bf0d94c7ec9e3ac4e51547a28d81d06197eef9fd4" "q-95599/selection/5aede8d08d3907a110167350028d3d1603734365605ae654520c997c92edbed6" "q-95599/selection/763fb700772ead13bb1946ac4cb82401551211e9ba6da4a9975c300eb4a9e3eb" "q-95599/selection/7db076a7bdbefe39f1330d881a429a941d6b58d2e1e4b9592df0ed54599d0a6d"] :db/ensure [:answer-field/validate]} {:db/id "q-95599" :question/id #uuid "056dc98b-b859-5cdb-baa9-522a53f8cce0" :question/math-academy-id "q-95599" :question/problem "Which of the following is equivalent to  $\\operatorname{tanh}⁡\\sqrt{u}?$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡\\sqrt{u} & =\\frac{{e}^{2\\sqrt{u}}-1}{{e}^{2\\sqrt{u}}+1}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-95599/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7"] :knowledge-point/questions ["q-95599"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342671/field-1/5f94c0aa992af42a29a910273d1c32a75ea4ca73535aed5e1a76ec55e5078699" :answer/id #uuid "1a0588fb-c7a9-5bc3-a68d-719189b90637" :answer/type :answer.type/math :answer/value "-\\frac{15}{17}" :db/ensure [:answer/validate]} {:db/id "q-342671/field-1/8f2476260bc9bc088b5f9c9d66ce4e0c3701fef311b661036f1b7258ae1ccbbb" :answer/id #uuid "8b70385d-fe03-58d8-8dfc-959dde6c1c5d" :answer/type :answer.type/math :answer/value "\\frac{15}{17}" :db/ensure [:answer/validate]} {:db/id "q-342671/field-1" :answer-field/id #uuid "ff562ac2-c557-562f-9852-932c6ed5d0a9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342671/field-1/5f94c0aa992af42a29a910273d1c32a75ea4ca73535aed5e1a76ec55e5078699" :answer-field/choices ["q-342671/field-1/5f94c0aa992af42a29a910273d1c32a75ea4ca73535aed5e1a76ec55e5078699" "q-342671/field-1/8f2476260bc9bc088b5f9c9d66ce4e0c3701fef311b661036f1b7258ae1ccbbb"] :db/ensure [:answer-field/validate]} {:db/id "q-342671" :question/id #uuid "038d024b-f7df-5513-8567-f2c6f54c0e10" :question/math-academy-id "q-342671" :question/problem "Evaluate $\\operatorname{tanh}⁡(-\\operatorname{ln}⁡4).$ **Do not round** your answer.\n\n$\\operatorname{tanh}⁡(-\\operatorname{ln}⁡4)=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(-\\operatorname{ln}⁡4) & =\\frac{1-{e}^{-2(-\\operatorname{ln}⁡4)}}{1+{e}^{-2(-\\operatorname{ln}⁡4)}} \\\\  & =\\frac{1-{e}^{2\\operatorname{ln}⁡4}}{1+{e}^{2\\operatorname{ln}⁡4}} \\\\  & =\\frac{1-{e}^{\\operatorname{ln}⁡{4}^{2}}}{1+{e}^{\\operatorname{ln}⁡{4}^{2}}} \\\\  & =\\frac{1-{e}^{\\operatorname{ln}⁡16}}{1+{e}^{\\operatorname{ln}⁡16}} \\\\  & =\\frac{1-16}{1+16} \\\\  & =-\\frac{15}{17}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-342671/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7"] :knowledge-point/questions ["q-342671"] :db/ensure [:knowledge-point/validate]} {:db/id "q-342669/field-1/dcc478fe0c41ae28b5ff6eb0c4bc2de56fdb3f46a2449be066f9e31f9f5e340b" :answer/id #uuid "96b8c58f-6c2e-5ba9-88d6-b5d1665dcd76" :answer/type :answer.type/math :answer/value "1-e^{3/2}" :db/ensure [:answer/validate]} {:db/id "q-342669/field-1" :answer-field/id #uuid "bee46cb5-1442-593e-ac30-14f6729561d5" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-342669/field-1/dcc478fe0c41ae28b5ff6eb0c4bc2de56fdb3f46a2449be066f9e31f9f5e340b" :answer-field/choices ["q-342669/field-1/dcc478fe0c41ae28b5ff6eb0c4bc2de56fdb3f46a2449be066f9e31f9f5e340b"] :db/ensure [:answer-field/validate]} {:db/id "q-342669" :question/id #uuid "70d80134-1179-5308-95b0-e4bffde35493" :question/math-academy-id "q-342669" :question/problem "Evaluate $tanh\\,(-\\frac{3}{4}).$ **Do not round** your answer.\n\n$tanh\\,(-\\frac{3}{4})=$\n\n| {{field-1}} |\n| --- |\n| $1+{e}^{3/2}$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}tanh\\,(-\\frac{3}{4}) & =\\frac{1-{e}^{-2(-3/4)}}{1+{e}^{-2(-3/4)}} \\\\  & =\\frac{1-{e}^{3/2}}{1+{e}^{3/2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-342669/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7"] :knowledge-point/questions ["q-342669"] :db/ensure [:knowledge-point/validate]} {:db/id "q-95597/selection/b55079c3af58f86ad1896c0d071867330fce47bedf8ec87e57773a37cf8ade95" :answer/id #uuid "f38d112a-9104-58c0-af4c-2938b38a1c02" :answer/type :answer.type/math :answer/value "\\frac{1-{e}^{2/w}}{1+{e}^{2/w}}" :db/ensure [:answer/validate]} {:db/id "q-95597/selection/772af46af8f5311ec1c98f6ae36efdfd7fb9b0ccff47c17b19e434025488f7ab" :answer/id #uuid "3a348320-633b-5940-b17a-01bc11accffe" :answer/type :answer.type/math :answer/value "\\frac{1+{e}^{2/w}}{1-{e}^{2/w}}" :db/ensure [:answer/validate]} {:db/id "q-95597/selection/8a506e4e6a47ae45f038668793f59620acaf8f4abbc0e8ac76ebbfa43bf21153" :answer/id #uuid "399083f3-db7c-54cb-89ab-dbdbec24f32d" :answer/type :answer.type/math :answer/value "\\frac{1-{e}^{2w}}{1+{e}^{2w}}" :db/ensure [:answer/validate]} {:db/id "q-95597/selection/4d21a0a93d8ffa8c0660060ed40dfe2e8e29d3be577ec8f22da5b44b2febb16b" :answer/id #uuid "a5dc5269-97cd-5407-9b0b-5d4fe07e95a9" :answer/type :answer.type/math :answer/value "\\frac{1+{e}^{2w}}{1-{e}^{2w}}" :db/ensure [:answer/validate]} {:db/id "q-95597/selection/9bac31451011b23857a4eb6d6034c744dbaa41e5f18b37050155377c958c1a5e" :answer/id #uuid "1e4f90e0-274c-5f55-9ac7-0832bcf6c7fa" :answer/type :answer.type/math :answer/value "\\frac{1-2{e}^{1/w}}{1+2{e}^{1/w}}" :db/ensure [:answer/validate]} {:db/id "q-95597/selection" :answer-field/id #uuid "ebba2b93-1c4b-5dea-8b93-124026e3c282" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-95597/selection/b55079c3af58f86ad1896c0d071867330fce47bedf8ec87e57773a37cf8ade95" :answer-field/choices ["q-95597/selection/b55079c3af58f86ad1896c0d071867330fce47bedf8ec87e57773a37cf8ade95" "q-95597/selection/772af46af8f5311ec1c98f6ae36efdfd7fb9b0ccff47c17b19e434025488f7ab" "q-95597/selection/8a506e4e6a47ae45f038668793f59620acaf8f4abbc0e8ac76ebbfa43bf21153" "q-95597/selection/4d21a0a93d8ffa8c0660060ed40dfe2e8e29d3be577ec8f22da5b44b2febb16b" "q-95597/selection/9bac31451011b23857a4eb6d6034c744dbaa41e5f18b37050155377c958c1a5e"] :db/ensure [:answer-field/validate]} {:db/id "q-95597" :question/id #uuid "0ce47b2b-ffb0-5b96-8a7b-f359cd563495" :question/math-academy-id "q-95597" :question/problem "Which of the following is equivalent to  $\\operatorname{tanh}⁡(-\\frac{1}{w})?$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(-\\frac{1}{w}) & =\\frac{1-{e}^{-2(-1/w)}}{1+{e}^{-2(-1/w)}} \\\\  & =\\frac{1-{e}^{2/w}}{1+{e}^{2/w}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-95597/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7"] :knowledge-point/questions ["q-95597"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-8383"] :question/problem "Evaluate $\\cosh  (\\ln 2).$" :question/worked-solution "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡2) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{\\operatorname{ln}⁡{2}^{-1}}) \\\\  & =\\frac{1}{2}(2+{2}^{-1}) \\\\  & =\\frac{1}{2}(2+\\frac{1}{2}) \\\\  & =\\frac{1}{2}(\\frac{4+1}{2}) \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8738"] :question/problem "Evaluate $\\sinh 1.$" :question/worked-solution "The definition of $\\sinh x$ is \n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡1 & =\\frac{1}{2}({e}^{1}-{e}^{-1}) \\\\  & =\\frac{1}{2}(e-\\frac{1}{e}) \\\\  & =\\frac{1}{2}(\\frac{{e}^{2}-1}{e}) \\\\  & =\\frac{{e}^{2}-1}{2e}.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8384"] :question/problem "Evaluate $\\tanh{4}.$" :question/worked-solution "The definition of $\\tanh x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡4 & =\\frac{{e}^{2(4)}-1}{{e}^{2(4)}+1} \\\\  & =\\frac{{e}^{8}-1}{{e}^{8}+1}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
