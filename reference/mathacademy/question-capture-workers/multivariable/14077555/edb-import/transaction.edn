a67d6271de273e3916e6300e97cf8f9f2f825c1a1660773ebb39770b67"] :db/ensure [:answer-field/validate]} {:db/id "q-95493" :question/id #uuid "551ea491-e06e-5319-953d-e703ae024382" :question/math-academy-id "q-95493" :question/problem "Given that $y\\ge 0,$ which of the following is equivalent to $\\operatorname{sinh}⁡\\sqrt{y}?$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\operatorname{sinh}⁡(\\sqrt{y})=\\frac{1}{2}({e}^{\\sqrt{y}}-{e}^{-\\sqrt{y}}).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-95493/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db"] :knowledge-point/questions ["q-95493"] :db/ensure [:knowledge-point/validate]} {:db/id "q-125355/selection/eebc4dbbef98344fc1729032be045e22ec0ec6059faac095bc4c20983a2b9358" :answer/id #uuid "9326f170-9315-52f3-bb3a-e018fcdeded7" :answer/type :answer.type/math :answer/value "\\frac{{t}^{3}-1}{4{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-125355/selection/eb3e56a84eee1f35a32a71dcb6144353a9ce1342aa64eb31a0d8c9c732fd097a" :answer/id #uuid "0f91a971-625d-598c-9b26-6c4458e1c83a" :answer/type :answer.type/math :answer/value "\\frac{{t}^{6}+1}{2{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-125355/selection/0521002b973c8bdedfa89f3de054c1f3d14eeb867ea9ab79e3cc7a200492b0b1" :answer/id #uuid "909c7b41-e1c1-5c94-ac4d-cc766d6d52fb" :answer/type :answer.type/math :answer/value "\\frac{{t}^{3}-1}{{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-125355/selection/4d2d235fd4e0e2d380a31628abdadea8323315154f9d77ae729d46f41352077d" :answer/id #uuid "4931f164-370b-59c0-893f-1f95a2c68ba8" :answer/type :answer.type/math :answer/value "\\frac{{t}^{3}+1}{{t}^{3}}" :db/ensure [:answer/validate]} {:db/id "q-125355/selection/3d5f9122f1fc3fcce54d038232c792eadc0884e559884e972984e244cffcc882" :answer/id #uuid "b02b8d6c-