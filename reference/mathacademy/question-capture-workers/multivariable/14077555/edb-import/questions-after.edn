#{[{:db/id #edb/ref 17592186092079 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/id #uuid "82ba817e-a4a8-5465-b775-6cc601132b49" :question/math-academy-id "e-8383" :question/problem "Evaluate $\\cosh  (\\ln 2).$" :question/worked-solution "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡2) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{-\\operatorname{ln}⁡2}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡2}+{e}^{\\operatorname{ln}⁡{2}^{-1}}) \\\\  & =\\frac{1}{2}(2+{2}^{-1}) \\\\  & =\\frac{1}{2}(2+\\frac{1}{2}) \\\\  & =\\frac{1}{2}(\\frac{4+1}{2}) \\\\  & =\\frac{5}{4}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092080 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/id #uuid "fe7322aa-03bf-5d6f-b432-0445510448b9" :question/math-academy-id "e-8384" :question/problem "Evaluate $\\tanh{4}.$" :question/worked-solution "The definition of $\\tanh x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡4 & =\\frac{{e}^{2(4)}-1}{{e}^{2(4)}+1} \\\\  & =\\frac{{e}^{8}-1}{{e}^{8}+1}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092084 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/id #uuid "b6742668-0b09-520f-bfb7-28bfa7630808" :question/math-academy-id "e-8738" :question/problem "Evaluate $\\sinh 1.$" :question/worked-solution "The definition of $\\sinh x$ is \n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡1 & =\\frac{1}{2}({e}^{1}-{e}^{-1}) \\\\  & =\\frac{1}{2}(e-\\frac{1}{e}) \\\\  & =\\frac{1}{2}(\\frac{{e}^{2}-1}{e}) \\\\  & =\\frac{{e}^{2}-1}{2e}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384236 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "909c7b41-e1c1-5c94-ac4d-cc766d6d52fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{t}^{3}-1}{{t}^{3}}" :db/id #edb/ref 17592186384238} {:answer/id #uuid "b02b8d6c-6789-5547-a948-1d86e077eb08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{t}^{6}-1}{2{t}^{3}}" :db/id #edb/ref 17592186384239} {:answer/id #uuid "4931f164-370b-59c0-893f-1f95a2c68ba8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{t}^{3}+1}{{t}^{3}}" :db/id #edb/ref 17592186384240} {:answer/id #uuid "0f91a971-625d-598c-9b26-6c4458e1c83a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{t}^{6}+1}{2{t}^{3}}" :db/id #edb/ref 17592186384241} {:answer/id #uuid "9326f170-9315-52f3-bb3a-e018fcdeded7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{t}^{3}-1}{4{t}^{3}}" :db/id #edb/ref 17592186384242}] :answer-field/correct {:answer/id #uuid "b02b8d6c-6789-5547-a948-1d86e077eb08" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{t}^{6}-1}{2{t}^{3}}" :db/id #edb/ref 17592186384239} :answer-field/id #uuid "7b9b8bcf-9169-5df9-8808-7c831b6eefc6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384237}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "25fc73eb-101d-59e1-bcb4-4ea640bfa4f2" :question/math-academy-id "q-125355" :question/problem "Given that $t>0,$ which of the following is equivalent to $\\operatorname{sinh}⁡(\\operatorname{ln}⁡{t}^{3})?$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(\\operatorname{ln}⁡{t}^{3}) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({t}^{3})}-{e}^{-\\operatorname{ln}⁡({t}^{3})}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({t}^{3})}-{e}^{\\operatorname{ln}⁡(({t}^{3})^{-1})}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({t}^{3})}-{e}^{\\operatorname{ln}⁡({t}^{-3})}) \\\\  & =\\frac{1}{2}({t}^{3}-{t}^{-3}) \\\\  & =\\frac{1}{2}(\\frac{{t}^{6}-1}{{t}^{3}}) \\\\  & =\\frac{{t}^{6}-1}{2{t}^{3}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384243 :knowledge-point/_questions [{:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79ab942d-dd70-5291-950e-ed59770865e0" :answer/type {:db/ident :answer.type/math} :answer/value "e^3" :db/id #edb/ref 17592186384245}] :answer-field/correct {:answer/id #uuid "79ab942d-dd70-5291-950e-ed59770865e0" :answer/type {:db/ident :answer.type/math} :answer/value "e^3" :db/id #edb/ref 17592186384245} :answer-field/id #uuid "d5d63558-c0d1-5d54-8a92-fdbc0f21faaf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384244}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "901e979c-d0c6-5f5d-a1d3-6ac0308da7f6" :question/math-academy-id "q-342226" :question/problem "Evaluate $\\operatorname{cosh}⁡(-3).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(-3)=\\frac{1}{2}({e}^{-3}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(-1) & =\\frac{1}{2}({e}^{-3}+{e}^{-(-3)}) \\\\  & =\\frac{1}{2}({e}^{-3}+{e}^{3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384246 :knowledge-point/_questions [{:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f21461a8-c7c5-5728-87b6-a12b150cf867" :answer/type {:db/ident :answer.type/math} :answer/value "e^{\\frac{1}{3}}" :db/id #edb/ref 17592186384248} {:answer/id #uuid "7e5360e5-5c9a-5f5e-b32b-978cae6da9cf" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-\\frac{1}{3}}" :db/id #edb/ref 17592186384249}] :answer-field/correct {:answer/id #uuid "7e5360e5-5c9a-5f5e-b32b-978cae6da9cf" :answer/type {:db/ident :answer.type/math} :answer/value "e^{-\\frac{1}{3}}" :db/id #edb/ref 17592186384249} :answer-field/id #uuid "48c8c019-5606-55d8-9020-3fcfdd2b801d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384247}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d55f2240-ff92-5010-8321-604c9d9a094a" :question/math-academy-id "q-342227" :question/problem "Evaluate $\\operatorname{cosh}⁡(\\frac{1}{3}).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(\\frac{1}{3})=\\frac{1}{2}({e}^{1/3}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\frac{1}{3}) & =\\frac{1}{2}({e}^{1/3}+{e}^{-1/3}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384250 :knowledge-point/_questions [{:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f03f597f-0675-5c8a-ae63-72b262e6de63" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186384252}] :answer-field/correct {:answer/id #uuid "f03f597f-0675-5c8a-ae63-72b262e6de63" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186384252} :answer-field/id #uuid "ae2d2dda-0804-55f3-a733-bed93ddce690" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384251}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b3a1c9c2-bdcc-5cf3-97e0-4aafa1ecc4f6" :question/math-academy-id "q-342231" :question/problem "Evaluate $\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3)).$ **Do not round** your answer.\n\n$\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3))=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(\\operatorname{ln}⁡(1/3)) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡(1/3)}+{e}^{-\\operatorname{ln}⁡(1/3)}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡(1/3)}+{e}^{\\operatorname{ln}⁡(3)}) \\\\  & =\\frac{1}{2}(\\frac{1}{3}+3) \\\\  & =\\frac{1}{2}(\\frac{1+9}{3}) \\\\  & =\\frac{10}{6} \\\\  & =\\frac{5}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384253 :knowledge-point/_questions [{:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6154bad4-2e35-50c2-b991-2fb5649b6ded" :answer/type {:db/ident :answer.type/math} :answer/value "z^{-6}" :db/id #edb/ref 17592186384255} {:answer/id #uuid "02f9344c-481d-545c-aa09-7eab7c04382f" :answer/type {:db/ident :answer.type/math} :answer/value "z^6" :db/id #edb/ref 17592186384256}] :answer-field/correct {:answer/id #uuid "6154bad4-2e35-50c2-b991-2fb5649b6ded" :answer/type {:db/ident :answer.type/math} :answer/value "z^{-6}" :db/id #edb/ref 17592186384255} :answer-field/id #uuid "6bfa0f50-1e07-5620-b802-081e1aaac3a2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384254}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "65335650-dc8e-59b6-bb76-191748fe0376" :question/math-academy-id "q-342240" :question/problem "Given that $z>0,$ simplify $\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})$ using the definition of the hyperbolic cosine.\n\n$\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2})=\\frac{1}{2}({z}^{6}\\,+$ {{field-1}} $)$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡(3\\operatorname{ln}⁡{z}^{2}) & =\\frac{1}{2}({e}^{3\\operatorname{ln}⁡{z}^{2}}+{e}^{-3\\operatorname{ln}⁡{z}^{2}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{2})^{3}}+{e}^{\\operatorname{ln}⁡({z}^{2})^{-3}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡({z}^{6})}+{e}^{\\operatorname{ln}⁡({z}^{-6})}) \\\\  & =\\frac{1}{2}({z}^{6}+{z}^{-6}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384257 :knowledge-point/_questions [{:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "96b8c58f-6c2e-5ba9-88d6-b5d1665dcd76" :answer/type {:db/ident :answer.type/math} :answer/value "1-e^{3/2}" :db/id #edb/ref 17592186384259}] :answer-field/correct {:answer/id #uuid "96b8c58f-6c2e-5ba9-88d6-b5d1665dcd76" :answer/type {:db/ident :answer.type/math} :answer/value "1-e^{3/2}" :db/id #edb/ref 17592186384259} :answer-field/id #uuid "bee46cb5-1442-593e-ac30-14f6729561d5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384258}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "70d80134-1179-5308-95b0-e4bffde35493" :question/math-academy-id "q-342669" :question/problem "Evaluate $tanh\\,(-\\frac{3}{4}).$ **Do not round** your answer.\n\n$tanh\\,(-\\frac{3}{4})=$\n\n| {{field-1}} |\n| --- |\n| $1+{e}^{3/2}$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}tanh\\,(-\\frac{3}{4}) & =\\frac{1-{e}^{-2(-3/4)}}{1+{e}^{-2(-3/4)}} \\\\  & =\\frac{1-{e}^{3/2}}{1+{e}^{3/2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384260 :knowledge-point/_questions [{:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0588fb-c7a9-5bc3-a68d-719189b90637" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{17}" :db/id #edb/ref 17592186384262} {:answer/id #uuid "8b70385d-fe03-58d8-8dfc-959dde6c1c5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{17}" :db/id #edb/ref 17592186384263}] :answer-field/correct {:answer/id #uuid "1a0588fb-c7a9-5bc3-a68d-719189b90637" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{15}{17}" :db/id #edb/ref 17592186384262} :answer-field/id #uuid "ff562ac2-c557-562f-9852-932c6ed5d0a9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384261}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "038d024b-f7df-5513-8567-f2c6f54c0e10" :question/math-academy-id "q-342671" :question/problem "Evaluate $\\operatorname{tanh}⁡(-\\operatorname{ln}⁡4).$ **Do not round** your answer.\n\n$\\operatorname{tanh}⁡(-\\operatorname{ln}⁡4)=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(-\\operatorname{ln}⁡4) & =\\frac{1-{e}^{-2(-\\operatorname{ln}⁡4)}}{1+{e}^{-2(-\\operatorname{ln}⁡4)}} \\\\  & =\\frac{1-{e}^{2\\operatorname{ln}⁡4}}{1+{e}^{2\\operatorname{ln}⁡4}} \\\\  & =\\frac{1-{e}^{\\operatorname{ln}⁡{4}^{2}}}{1+{e}^{\\operatorname{ln}⁡{4}^{2}}} \\\\  & =\\frac{1-{e}^{\\operatorname{ln}⁡16}}{1+{e}^{\\operatorname{ln}⁡16}} \\\\  & =\\frac{1-16}{1+16} \\\\  & =-\\frac{15}{17}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384264 :knowledge-point/_questions [{:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0f7dd3cf-b7af-5f7f-a6a9-f31515d66e57" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4q}-1" :db/id #edb/ref 17592186384266} {:answer/id #uuid "56b0bcbb-7e3d-5c8c-a71f-6f8b29df3b6a" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4q}+1" :db/id #edb/ref 17592186384267}] :answer-field/correct {:answer/id #uuid "0f7dd3cf-b7af-5f7f-a6a9-f31515d66e57" :answer/type {:db/ident :answer.type/math} :answer/value "e^{4q}-1" :db/id #edb/ref 17592186384266} :answer-field/id #uuid "b0dac74f-7189-5570-8a27-004cd59367d6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384265}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "70877924-44df-51b9-bda6-63308a7bf099" :question/math-academy-id "q-342675" :question/problem "Simplify $\\operatorname{tanh}⁡(2q)$ in terms of $e$ using the definition of the hyperbolic tangent.\n\n$\\operatorname{tanh}⁡(2q)=$\n\n| {{field-1}} |\n| --- |\n| ${e}^{4q}+1$ |" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(2q) & =\\frac{{e}^{2(2q)}-1}{{e}^{2(2q)}+1} \\\\  & =\\frac{{e}^{4q}-1}{{e}^{4q}+1}\\,\\,.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384268 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dd06f2b0-27c4-542d-8fa6-23283b81391d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186384270}] :answer-field/correct {:answer/id #uuid "dd06f2b0-27c4-542d-8fa6-23283b81391d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{15}{8}" :db/id #edb/ref 17592186384270} :answer-field/id #uuid "4b0139a5-de1c-5358-a59c-64567cd4302c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186384269}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "455c2ee1-bb19-5c8e-824a-4a050245d2c7" :question/math-academy-id "q-342689" :question/problem "Evaluate $\\operatorname{sinh}⁡(\\operatorname{ln}⁡4).$ **Do not round** your answer.\n\n$\\operatorname{sinh}⁡(\\operatorname{ln}⁡4)=$\n{{field-1}}" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(\\operatorname{ln}⁡4) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡4}-{e}^{-\\operatorname{ln}⁡4}) \\\\  & =\\frac{1}{2}(4-{4}^{-1}) \\\\  & =\\frac{1}{2}(4-\\frac{1}{4}) \\\\  & =\\frac{1}{2}(\\frac{15}{4}) \\\\  & =\\frac{15}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092862 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a123e5bc-58d7-5295-9bfe-a81745c3b2d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{2}}" :db/id #edb/ref 17592186091638} {:answer/id #uuid "c6e8cbc3-0375-53e0-9185-cbc255b58de9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186091639} {:answer/id #uuid "d0b897da-86b7-5253-a4f5-5955a7c2d421" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{2}}" :db/id #edb/ref 17592186091640} {:answer/id #uuid "dfdd3ff0-41af-5ef0-b29a-42b1a4fe723b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{2}}" :db/id #edb/ref 17592186091641} {:answer/id #uuid "765614b9-4bd3-5313-b714-9dbb5a0488ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\sqrt{2}}" :db/id #edb/ref 17592186091642}] :answer-field/correct {:answer/id #uuid "d0b897da-86b7-5253-a4f5-5955a7c2d421" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{2}}" :db/id #edb/ref 17592186091640} :answer-field/id #uuid "40cb080a-87b3-5b3a-bca4-4be6d2d0455c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091637}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b4116e5d-69c2-5e7a-a45f-c3940ca942d5" :question/math-academy-id "q-9446" :question/problem "$\\operatorname{sinh}⁡(\\operatorname{ln}⁡\\sqrt{2})=$" :question/worked-solution "The definition of $\\operatorname{sinh}⁡x$ is \n\n$$\n\\operatorname{sinh}⁡x=\\frac{1}{2}({e}^{x}-{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{sinh}⁡(\\operatorname{ln}⁡\\sqrt{2}) & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{2}}-{e}^{-\\operatorname{ln}⁡\\sqrt{2}}) \\\\  & =\\frac{1}{2}({e}^{\\operatorname{ln}⁡\\sqrt{2}}-{e}^{\\operatorname{ln}⁡(1/\\sqrt{2})}) \\\\  & =\\frac{1}{2}(\\sqrt{2}-\\frac{1}{\\sqrt{2}}) \\\\  & =\\frac{1}{2}(\\frac{2-1}{\\sqrt{2}}) \\\\  & =\\frac{1}{2\\sqrt{2}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384271 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5c7ecc18-1139-52f6-8b4c-3867976dd95d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{2t}-{e}^{-2t})" :db/id #edb/ref 17592186384273} {:answer/id #uuid "c51d56b0-7fa6-51d5-adb9-ccd8c2f25c52" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{-2t}-{e}^{2t})" :db/id #edb/ref 17592186384274} {:answer/id #uuid "77a09d2f-4202-503c-b0c7-94b27750debb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{t/2}-{e}^{-t/2})" :db/id #edb/ref 17592186384275} {:answer/id #uuid "4fab7a94-2041-51c5-b6dd-46e936e5e592" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{2t}+{e}^{-2t})" :db/id #edb/ref 17592186384276} {:answer/id #uuid "1f5fd104-7b7c-5b93-a8dd-d3fd94005038" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{-t/2}-{e}^{t/2})" :db/id #edb/ref 17592186384277}] :answer-field/correct {:answer/id #uuid "5c7ecc18-1139-52f6-8b4c-3867976dd95d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}({e}^{2t}-{e}^{-2t})" :db/id #edb/ref 17592186384273} :answer-field/id #uuid "84fca5b0-0163-547b-96b1-915b3475861e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384272}] :question/difficulty