ction" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384286}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "64e94b03-de72-5b58-bb67-f5518a4489d3" :question/math-academy-id "q-95590" :question/problem "$\\operatorname{cosh}⁡4=$" :question/worked-solution "The definition of $\\operatorname{cosh}⁡x$ is\n\n$$\n\\operatorname{cosh}⁡x=\\frac{1}{2}({e}^{x}+{e}^{-x}).\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\operatorname{cosh}⁡4 & =\\frac{1}{2}({e}^{4}+{e}^{-4}).\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384292 :knowledge-point/_questions [{:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5dc5269-97cd-5407-9b0b-5d4fe07e95a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+{e}^{2w}}{1-{e}^{2w}}" :db/id #edb/ref 17592186384294} {:answer/id #uuid "3a348320-633b-5940-b17a-01bc11accffe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1+{e}^{2/w}}{1-{e}^{2/w}}" :db/id #edb/ref 17592186384295} {:answer/id #uuid "399083f3-db7c-54cb-89ab-dbdbec24f32d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{2w}}{1+{e}^{2w}}" :db/id #edb/ref 17592186384296} {:answer/id #uuid "1e4f90e0-274c-5f55-9ac7-0832bcf6c7fa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-2{e}^{1/w}}{1+2{e}^{1/w}}" :db/id #edb/ref 17592186384297} {:answer/id #uuid "f38d112a-9104-58c0-af4c-2938b38a1c02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{2/w}}{1+{e}^{2/w}}" :db/id #edb/ref 17592186384298}] :answer-field/correct {:answer/id #uuid "f38d112a-9104-58c0-af4c-2938b38a1c02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1-{e}^{2/w}}{1+{e}^{2/w}}" :db/id #edb/ref 17592186384298} :answer-field/id #uuid "ebba2b93-1c4b-5dea-8b93-124026e3c282" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384293}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0ce47b2b-ffb0-5b96-8a7b-f359cd563495" :question/math-academy-id "q-95597" :question/problem "Which of the following is equivalent to  $\\operatorname{tanh}⁡(-\\frac{1}{w})?$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the third definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡(-\\frac{1}{w}) & =\\frac{1-{e}^{-2(-1/w)}}{1+{e}^{-2(-1/w)}} \\\\  & =\\frac{1-{e}^{2/w}}{1+{e}^{2/w}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186384299 :knowledge-point/_questions [{:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e009c367-13e0-5191-a31c-d84171965dec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{e}^{2\\sqrt{u}}-1}{2{e}^{2\\sqrt{u}}+1}" :db/id #edb/ref 17592186384301} {:answer/id #uuid "68cf0024-84be-596e-8be2-7ab1ef0aba04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2{e}^{\\sqrt{u}/2}+1}{2{e}^{\\sqrt{u}/2}-1}" :db/id #edb/ref 17592186384302} {:answer/id #uuid "ff80b2b6-a9b1-58fb-9359-13346e70b174" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2\\sqrt{u}}+1}{{e}^{2\\sqrt{u}}-1}" :db/id #edb/ref 17592186384303} {:answer/id #uuid "9ac3ae1f-cea0-515e-aa7a-d61d824b4a7c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{\\sqrt{u}/2}-1}{{e}^{\\sqrt{u}/2}+1}" :db/id #edb/ref 17592186384304} {:answer/id #uuid "6f1b1a87-772c-5eff-a8d6-cbe5a5c315ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2\\sqrt{u}}-1}{{e}^{2\\sqrt{u}}+1}" :db/id #edb/ref 17592186384305}] :answer-field/correct {:answer/id #uuid "6f1b1a87-772c-5eff-a8d6-cbe5a5c315ba" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{e}^{2\\sqrt{u}}-1}{{e}^{2\\sqrt{u}}+1}" :db/id #edb/ref 17592186384305} :answer-field/id #uuid "d8143f12-0306-5d52-8118-a558ae545d18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186384300}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "056dc98b-b859-5cdb-baa9-522a53f8cce0" :question/math-academy-id "q-95599" :question/problem "Which of the following is equivalent to  $\\operatorname{tanh}⁡\\sqrt{u}?$" :question/worked-solution "The definition of $\\operatorname{tanh}⁡x$ is \n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡x & =\\frac{{e}^{x}-{e}^{-x}}{{e}^{x}+{e}^{-x}} \\\\  & =\\frac{{e}^{2x}-1}{{e}^{2x}+1} \\\\  & =\\frac{1-{e}^{-2x}}{1+{e}^{-2x}}.\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\\operatorname{tanh}⁡\\sqrt{u} & =\\frac{{e}^{2\\sqrt{u}}-1}{{e}^{2\\sqrt{u}}+1}.\\end{aligned}\n$$"}]}
