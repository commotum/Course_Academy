#{[{:db/id #edb/ref 17592186092079 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "756e8f32-69aa-55bb-bae5-e906e0d2c690" :knowledge-point/title "Evaluating Hyperbolic Cosine"}] :question/id #uuid "82ba817e-a4a8-5465-b775-6cc601132b49" :question/math-academy-id "e-8383" :question/problem "Evaluate $\\cosh (\\ln 2)$." :question/worked-solution "The definition of $\\cosh{x}$ is\n\n$$\n\\cosh{x} = \\dfrac{1}{2}(e^{x} + e^{-x})\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\cosh (\\ln 2) &= \\frac{1}{2}(e^{\\ln 2} + e^{-\\ln 2}) \\\\\n&= \\frac{1}{2}(e^{\\ln 2} + e^{\\ln 2^{-1}}) \\\\\n&= \\frac{1}{2}(2 + 2^{-1}) \\\\\n&= \\frac{1}{2}(2 + \\frac{1}{2}) \\\\\n&= \\frac{1}{2}(\\frac{4 + 1}{2}) \\\\\n&= \\frac{5}{4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092080 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "65faf418-f3c7-519d-a01c-9fa1566782f7" :knowledge-point/title "Evaluating Hyperbolic Tangent"}] :question/id #uuid "fe7322aa-03bf-5d6f-b432-0445510448b9" :question/math-academy-id "e-8384" :question/problem "Evaluate $\\tanh{4}$." :question/worked-solution "The definition of $\\tanh x$ is\n\n$$\n\\begin{aligned}\n\\tanh x &= \\frac{e^{x} - e^{-x}}{e^{x} + e^{-x}} \\\\\n&= \\frac{e^{2x} - 1}{e^{2x} + 1} \\\\\n&= \\frac{1 - e^{-2x}}{1 + e^{-2x}}\n\\end{aligned}\n$$\n\nUsing the second definition, we get\n\n$$\n\\begin{aligned}\n\\tanh 4 &= (e^{2(4)} - 1)/(e^{2(4)} + 1) \\\\\n&= \\frac{e^{8} - 1}{e^{8} + 1}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092084 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/id #uuid "b6742668-0b09-520f-bfb7-28bfa7630808" :question/math-academy-id "e-8738" :question/problem "Evaluate $\\sinh 1$." :question/worked-solution "The definition of $\\sinh x$ is\n\n$$\n\\sinh{x} = \\dfrac{1}{2}(e^{x} - e^{-x})\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\n\\sinh 1 &= \\frac{1}{2}(e^{1} - e^{-1}) \\\\\n&= \\frac{1}{2}(e - \\frac{1}{e}) \\\\\n&= \\frac{1}{2}(\\frac{e^{2} - 1}{e}) \\\\\n&= \\frac{e^{2} - 1}{2e}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186092862 :knowledge-point/_questions [{:knowledge-point/id #uuid "9d505a3b-b99e-5110-871f-67bd8abbe0db" :knowledge-point/title "Evaluating Hyperbolic Sine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a123e5bc-58d7-5295-9bfe-a81745c3b2d6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{\\sqrt{2}}" :db/id #edb/ref 17592186091638} {:answer/id #uuid "c6e8cbc3-0375-53e0-9185-cbc255b58de9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{\\sqrt{2}}" :db/id #edb/ref 17592186091639} {:answer/id #uuid "d0b897da-86b7-5253-a4f5-5955a7c2d421" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{2}}" :db/id #edb/ref 17592186091640} {:answer/id #uuid "dfdd3ff0-41af-5ef0-b29a-42b1a4fe723b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4\\sqrt{2}}" :db/id #edb/ref 17592186091641} {:answer/id #uuid "765614b9-4bd3-5313-b714-9dbb5a0488ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3\\sqrt{2}}" :db/id #edb/ref 17592186091642}] :answer-field/correct {:answer/id #uuid "d0b897da-86b7-5253-a4f5-5955a7c2d421" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2\\sqrt{2}}" :db/id #edb/ref 17592186091640} :answer-field/id #uuid "40cb080a-87b3-5b3a-bca4-4be6d2d0455c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091637}] :question/id #uuid "b4116e5d-69c2-5e7a-a45f-c3940ca942d5" :question/math-academy-id "q-9446" :question/problem "What is $\\sinh (\\ln \\sqrt{2})$?"}]}
