ϕ\\le \\pi }.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161822" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/activity-metadata.json" "file_sha256" "5549aa7705bd3391e8dee2b14e54106454742a21bc1953b59ba2e925e0899ef7"} {"question" "q-161822" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161822" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 3,\\,\\pi /2\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le 2\\pi }"] ["math" "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,\\pi /2\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi }"] ["math" "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 6,\\,\\pi /2\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi }"] ["math" "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 6,\\,\\pi /2\\le \\theta \\le \\pi /2,\\,0\\le ϕ\\le \\pi /2}"] ["math" "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 9,\\,\\pi /2\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi /2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161822" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 6,\\,\\pi /2\\le \\theta \\le \\pi ,\\,0\\le ϕ\\le \\pi }"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161883" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/assets/a32e8fd24c990a831cfee9525c6b1c035fb4ee6e09deedb3ac4c899d90ceeaac.png)\n\nThe solid enclosed by the half-sphere ${x}^{2}+{y}^{2}+{z}^{2}+4y=0$ for $z\\le 0,$ shown above, can be described in spherical polar coordinates as" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161883" "field" nil "attribute" "question/worked-solution" "value" "We write the position of a point (vector) in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where \n\n- $\\rho \\ge 0$ is the distance from the point to the origin,\n\n- $\\theta \\in [0,2\\pi )$ is the angle between the point and the positive $x$-axis, and\n\n- $ϕ\\in [0,\\pi ]$ is the angle the corresponding vector makes with the positive $z$-axis.\n\nIf $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nNotice that the region $R$ represents one-half of the sphere of radius $2$ centered at $(0,-2,0).$\n\nWith that in mind, let's now write the ${x}^{2}+{y}^{2}+{z}^{2}+4y=0$ in spherical polar coordinates:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}+{z}^{2}+4y & =0 \\\\ {\\rho }^{2}+4\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ & =0 \\\\ \\rho (\\rho +4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ) & =0\\end{aligned}\n$$\n\n \n\nSince $\\rho $ cannot be identical to zero on the entire sphere, we must have $\\rho =-4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/assets/e2865e838521a8864ad76d72e520d4b128a8fceb8c18cb9c35ba10134419c4eb.png)\n\n \n\nNotice that inside our region, the spherical polar coordinates vary within the following domains:\n\n- $\\rho \\in [0,-4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ]$\n\n- $\\theta \\in [\\pi ,2\\pi ]$\n\n- $ϕ\\in [\\frac{\\pi }{2},\\pi ]$\n\nTherefore, we have\n\n$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi }.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161883" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/activity-metadata.json" "file_sha256" "5549aa7705bd3391e8dee2b14e54106454742a21bc1953b59ba2e925e0899ef7"} {"question" "q-161883" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161883" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }\n$$"] ["text" "$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi }\n$$"] ["text" "$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4,\\,\\pi \\le \\theta \\le 2\\pi ,\\,0\\le ϕ\\le \\pi }\n$$"] ["text" "$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,0\\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi }\n$$"] ["text" "$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le 4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi }\n$$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"} {"question" "q-161883" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$$\n{(\\rho ,\\theta ,ϕ)\\,:\\,0\\le \\rho \\le -4\\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,\\pi \\le \\theta \\le 2\\pi ,\\,\\frac{\\pi }{2}\\le ϕ\\le \\pi }\n$$"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069421/state.json" "file_sha256" "5d907c6218bcd463461354f843f268ecba8f3dd3841c782abd43d07eaf86216b"}] "usage" {"q-102945" []} "basis" 2380 "retractions" [[17592186176107 :question/problem "What surface is defined by the equation $ϕ = \\frac{π}{4}$ in spherical polar coordinates?"]] "immutable_answers" [17592186173305 17592186173306 17592186173307 17592186173308 17592186173309] "immutable_fields" [[17592186173304 :answer-field/correct] [17592186173304 :answer-field/id] [17592186173304 :answer-field/key] [17592186173304 :answer-field/type]] "no_history" []}
