 [:question/math-academy-id "q-10433"] :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{25}-\\frac{{x}^{2}}{9}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{25}=5,\\,b=\\sqrt{9}=3.\n$$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{5}{3}x.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-116559/selection/456331d6bb324a86c6366cc6322928c90711ff2a82e9426366dd2cb9ceda61dc" :answer/id #uuid "093a31dc-886a-597b-beb0-fd386943253d" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{1}{2}x" :db/ensure [:answer/validate]} {:db/id "q-116559/selection/14eccf8a242f0d8f0178f9b363c4d696262f7524f235db4f37f2e8d2f72a7291" :answer/id #uuid "16295bd9-0cb4-595b-a745-86e6355884b3" :answer/type :answer.type/math :answer/value "y=\\pm 2x" :db/ensure [:answer/validate]} {:db/id "q-116559/selection/c94c7e51cb6d69ceaff458169e7f9d7a19a52b2f52709b8d98309d414a16bdad" :answer/id #uuid "806b94ed-e127-5145-a629-11f34413623f" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{1}{4}x" :db/ensure [:answer/validate]} {:db/id "q-116559/selection/0a65dbd743c5a2c68e8750998d56790ea4a2d165c43206fe1d61c66f066a536f" :answer/id #uuid "26c914a7-f6a3-51dc-bc38-9d9c5ec95d8e" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{2\\sqrt{3}}{3}x" :db/ensure [:answer/validate]} {:db/id "q-116559/selection/b31cecd316b6911ea5bd89055bbcc24f3ec86cd0a194a857d1c1b4737b8bb606" :answer/id #uuid "16be5509-d6a6-5f19-abe6-53791d7edae1" :answer/type :answer.type/math :answer/value "y=\\pm 4x" :db/ensure [:answer/validate]} {:db/id "q-116559/selection" :answer-field/id #uuid "2d8067f7-3d23-5713-9e9f-936a12436578" :answer-field/key "selection"