1e" :answer/id #uuid "4f8df0e0-fb92-59d8-a6e3-0b59b8280196" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{5}{4}x" :db/ensure [:answer/validate]} {:db/id "q-10441/selection/b8b02456486afaaf9fa5a88ff252016c8e4510cef18af6e19199674056f6ddbc" :answer/id #uuid "9f392129-5a3a-58c2-8515-50369f20c1f5" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{5}{2}x" :db/ensure [:answer/validate]} {:db/id "q-10441/selection/bb585d99b9751ea53b5d411b346fe39d5e04c0c7ec0c633d4ec125d8092b9754" :answer/id #uuid "03d14f9d-d29b-50b0-abd7-60c2fe4fa773" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{3}{5}x" :db/ensure [:answer/validate]} {:db/id "q-10441/selection/bbe5e63917119ee7237fdd695e959c25e33b08f6f04aa7a4e3856421aa97d053" :answer/id #uuid "72aea996-816a-50de-8d44-c12932e4eb59" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{2}{5}x" :db/ensure [:answer/validate]} {:db/id "q-10441/selection" :answer-field/id #uuid "a9bbe063-332d-53d2-bea7-9f9db3c21476" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10441/selection/2fec67784a2f686bc9fece296edf9221da324dc0e34cbf29534c18c8d58f2ba4" :answer-field/choices ["q-10441/selection/2fec67784a2f686bc9fece296edf9221da324dc0e34cbf29534c18c8d58f2ba4" "q-10441/selection/241d7f4e546f231146c45879647fbc0d9ba1003e4f509d0800db9e8a54ece31e" "q-10441/selection/b8b02456486afaaf9fa5a88ff252016c8e4510cef18af6e19199674056f6ddbc" "q-10441/selection/bb585d99b9751ea53b5d411b346fe39d5e04c0c7ec0c633d4ec125d8092b9754" "q-10441/selection/bbe5e63917119ee7237fdd695e959c25e33b08f6f04aa7a4e3856421aa97d053"] :db/ensure [:answer-field/validate]} {:db/id "q-10441" :question/id #uuid "a8c9183a-7e7d-51ff-bf58-dce93f1a9d98" :question/math-academy-id "q-10441" :question/problem "Find the asymptotes of the hyperbola $25{y}^{2}-16{x}^{2}=400.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $400$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{y}^{2}-16{x}^{2} & =400 \\\\ \\frac{25{y}^{2}}{400}-\\frac{16{x}^{2}}{400} & =\\frac{400}{400} \\\\ \\frac{{y}^{2}}{16}-\\frac{{x}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{16}=4$ and $b=\\sqrt{25}=5.$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{4}{5}x.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10441/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448"] :knowledge-point/questions ["q-10441"] :db/ensure [:knowledge-point/validate]} {:db/id "q-7976/selection/85dfdc3eacb92072ed0935d89ae78d3fe1e3e66f5607b749375b4fe69132cf29" :answer/id #uuid "7167697e-32aa-58fe-abce-4af17f6c9155" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{3}{2}x" :db/ensure [:answer/validate]} {:db/id "q-7976/selection/0a65dbd743c5a2c68e8750998d56790ea4a2d165c43206fe1d61c66f066a536f" :answer/id #uuid "c341b5a5-b138-543e-91aa-6f1610500142" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{2\\sqrt{3}}{3}x" :db/ensure [:answer/validate]} {:db/id "q-7976/selection/e8c53dff1b5e9e7f69dbfe8bbe1bf16f3427185f6f1950f2a5a6fe09f4f52ea1" :answer/id #uuid "00d3d7c3-7438-5f6c-a861-880e8bd90de0" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{3\\sqrt{2}}{2}x" :db/ensure [:answer/validate]} {:db/id "q-7976/selection/0b47d2261a4e9507f07da9449a60ff24e7ff9dff1b0841eefde13a760f26a2dd" :answer/id #uuid "2d20ae18-72e5-5a81-8231-991af7bef088" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{\\sqrt{3}}{4}x" :db/ensure [:answer/validate]} {:db/id "q-7976/selection/357ce466f60e49308086eaaa92644bed5ebb7982d4a55fcbb8c9d6a407b5c200" :answer/id #uuid "d2d10dd5-9c3c-5326-873f-89c4be93cc00" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{\\sqrt{3}}{2}x" :db/ensure [:answer/validate]} {:db/id "q-7976/selection" :answer-field/id #uuid "982a06c4-5232-5534-a0d2-16174190241b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-7976/selection/357ce466f60e49308086eaaa92644bed5ebb7982d4a55fcbb8c9d6a407b5c200" :answer-field/choices ["q-7976/selection/85dfdc3eacb92072ed0935d89ae78d3fe1e3e66f5607b749375b4fe69132cf29" "q-7976/selection/0a65dbd743c5a2c68e8750998d56790ea4a2d165c43206fe1d61c66f066a536f" "q-7976/selection/e8c53dff1b5e9e7f69dbfe8bbe1bf16f3427185f6f1950f2a5a6fe09f4f52ea1" "q-7976/selection/0b47d2261a4e9507f07da9449a60ff24e7ff9dff1b0841eefde13a760f26a2dd" "q-7976/selection/357ce466f60e49308086eaaa92644bed5ebb7982d4a55fcbb8c9d6a407b5c200"] :db/ensure [:answer-field/validate]} {:db/id "q-7976" :question/id #uuid "c626f7da-a75d-5e5e-8738-967cdc589d2c" :question/math-academy-id "q-7976" :question/problem "Find the asymptotes of the hyperbola $3{x}^{2}-4{y}^{2}=12.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $12$ and then simplify, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-4{y}^{2} & =12 \\\\ \\frac{3{x}^{2}}{12}-\\frac{4{y}^{2}}{12} & =\\frac{12}{12} \\\\ \\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{3} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{4}=2,$ and $b=\\sqrt{3}.$ \n\nTherefore, the asymptotes are $y=\\pm \\frac{\\sqrt{3}}{2}x.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7976/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448"] :knowledge-point/questions ["q-7976"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316956/field-1/d5e397bfd660ae1bc01efe56576e5bfbd282dfc80d48b05ceea73acba9c8a440" :answer/id #uuid "59741092-1647-5894-b6f5-b2979130dd33" :answer/type :answer.type/math :answer/value "\\frac{5}{3}x" :db/ensure [:answer/validate]} {:db/id "q-316956/field-1/8f41e4480100a26415c2cc741b8398bc7e4f0b349842f4ae55b32d0504fb7f04" :answer/id #uuid "30fd9e83-a527-5ea6-b4ac-96a92cb7dba2" :answer/type :answer.type/math :answer/value "\\frac{3}{5}x" :db/ensure [:answer/validate]} {:db/id "q-316956/field-1" :answer-field/id #uuid "c520f654-6293-513a-95bb-74a5a56cb13b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316956/field-1/d5e397bfd660ae1bc01efe56576e5bfbd282dfc80d48b05ceea73acba9c8a440" :answer-field/choices ["q-316956/field-1/d5e397bfd660ae1bc01efe56576e5bfbd282dfc80d48b05ceea73acba9c8a440" "q-316956/field-1/8f41e4480100a26415c2cc741b8398bc7e4f0b349842f4ae55b32d0504fb7f04"] :db/ensure [:answer-field/validate]} {:db/id "q-316956" :question/id #uuid "d70fcdb1-1640-55c4-b852-fcd6b07cc2ac" :question/math-academy-id "q-316956" :question/problem "The asymptotes of the hyperbola $18{y}^{2}-50{x}^{2}=900$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $900$ and then simplify, as follows:\n\n$$\n\\begin{aligned}18{y}^{2}-50{x}^{2} & =900 \\\\ \\frac{18{y}^{2}}{900}-\\frac{50{x}^{2}}{900} & =\\frac{900}{900} \\\\ \\frac{{y}^{2}}{50}-\\frac{{x}^{2}}{18} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{50}=5\\sqrt{2}$ and $b=\\sqrt{18}=3\\sqrt{2}.$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{\\sqrt{50}}{\\sqrt{18}} \\\\  & =\\pm \\frac{5\\sqrt{2}}{3\\sqrt{2}} \\\\  & =\\pm \\frac{5}{3}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316956/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448"] :knowledge-point/questions ["q-316956"] :db/ensure [:knowledge-point/validate]} {:db/id "q-316951/field-1/d7fe01db6a38c7197e125f1477c4e6a65721bcfca0421e4610184e71944e8700" :answer/id #uuid "45917502-b998-5dc5-9dec-f9cd87ce9044" :answer/type :answer.type/math :answer/value "\\frac{3}{2}x" :db/ensure [:answer/validate]} {:db/id "q-316951/field-1" :answer-field/id #uuid "c096b0da-6871-5444-b417-15317e0f3514" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-316951/field-1/d7fe01db6a38c7197e125f1477c4e6a65721bcfca0421e4610184e71944e8700" :answer-field/choices ["q-316951/field-1/d7fe01db6a38c7197e125f1477c4e6a65721bcfca0421e4610184e71944e8700"] :db/ensure [:answer-field/validate]} {:db/id "q-316951" :question/id #uuid "135b854c-5e9b-5588-82b0-85ea7b8fedb0" :question/math-academy-id "q-316951" :question/problem "The asymptotes of the hyperbola $4{y}^{2}-9{x}^{2}=36$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $36$ and then simplify, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-9{x}^{2} & =36 \\\\ \\frac{4{y}^{2}}{36}-\\frac{9{x}^{2}}{36} & =\\frac{36}{36} \\\\ \\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{4} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{9}=3$ and $b=\\sqrt{4}=2.$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{2}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-316951/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448"] :knowledge-point/questions ["q-316951"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275216/field-1/fc20968d883ca769dfb3874d84601b4e956d52d67b276c788d49f3a972f23c95" :answer/id #uuid "2144c077-fd55-5775-9bc9-d8ea5a71b5a2" :answer/type :answer.type/math :answer/value "\\frac{1}{3}x" :db/ensure [:answer/validate]} {:db/id "q-275216/field-1" :answer-field/id #uuid "ff2a321a-b2a1-5b2c-a4c6-747c3faac629" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275216/field-1/fc20968d883ca769dfb3874d84601b4e956d52d67b276c788d49f3a972f23c95" :answer-field/choices ["q-275216/field-1/fc20968d883ca769dfb3874d84601b4e956d52d67b276c788d49f3a972f23c95"] :db/ensure [:answer-field/validate]} {:db/id "q-275216" :question/id #uuid "255d13d2-da0f-5a3d-b274-a3d657b0e4b0" :question/math-academy-id "q-275216" :question/problem "The asymptotes of the hyperbola $2{x}^{2}-18{y}^{2}=162$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $162$ and then simplify, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-18{y}^{2} & =162 \\\\ \\frac{2{x}^{2}}{162}-\\frac{18{y}^{2}}{162} & =\\frac{162}{162} \\\\ \\frac{{x}^{2}}{81}-\\frac{{y}^{2}}{9} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{81}=9,$ and $b=\\sqrt{9}=3.$ \n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{9}x \\\\  & =\\pm \\frac{1}{3}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275216/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448"] :knowledge-point/questions ["q-275216"] :db/ensure [:knowledge-point/validate]}]
