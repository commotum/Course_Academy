b/ensure [:answer-field/validate]} {:db/id "q-116549" :question/id #uuid "69971471-9b0f-5238-854c-f07a81985360" :question/math-academy-id "q-116549" :question/problem "Find the asymptotes of the hyperbola $\\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{25}=1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{2},\\,b=\\sqrt{25}=5.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{5}{\\sqrt{2}}x \\\\  & =\\pm \\frac{5\\sqrt{2}}{2}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-116549/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0"] :knowledge-point/questions ["q-116549"] :db/ensure [:knowledge-point/validate]} {:db/id "q-116554/selection/d01966d535c3737e8146924ec724fd5d9e516fd93682aff0e774085178c3b35d" :answer/id #uuid "d9c1de3a-885d-527d-95ce-79cb759dc1bd" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{4}{3}x" :db/ensure [:answer/validate]} {:db/id "q-116554/selection/85dfdc3eacb92072ed0935d89ae78d3fe1e3e66f5607b749375b4fe69132cf29" :answer/id #uuid "5dd4d492-2924-5b33-86c5-33ff56f2f4bc" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{3}{2}x" :db/ensure [:answer/validate]} {:db/id "q-116554/selection/b31cecd316b6911ea5bd89055bbcc24f3ec86cd0a194a857d1c1b4737b8bb606" :answer/id #uuid "9c630777-6bc1-5883-a246-e4a58d0c1cb5" :answer/type :answer.type/math :answer/value "y=\\pm 4x" :db/ensure [:answer/validate]} {:db/id "q-116554/selection/c94c7e51cb6d69ceaff458169e7f9d7a19a52b2f52709b8d98309d414a16bdad" :answer/id #uuid "9fd6ed0b-3745-5eb9-b496-a9b7540a7626" :answer/type :answer.type/math :answer/value "y=\\pm \\frac{1}{4