#{[{:db/id #edb/ref 17592186087485 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/id #uuid "f81dc1a8-36bf-5918-b702-2d37000a0457" :question/math-academy-id "e-5356" :question/problem "Find the asymptotes of the hyperbola $\\dfrac{y^2}{9} - \\dfrac{x^2}{16} = 1$." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\dfrac{y^2}{a^2} - \\dfrac{x^2}{b^2} = 1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{a}{b} x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{9} = 3, \\qquad b=\\sqrt{16} = 4.\n$$\n\nTherefore, the asymptotes of the hyperbola are $y = \\pm \\dfrac{3}{4}x.$"}] [{:db/id #edb/ref 17592186087486 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/id #uuid "87c1fed0-66fa-5b7d-b79d-80e96074321e" :question/math-academy-id "e-5357" :question/problem "Calculate the asymptotes of the hyperbola $25 x ^ 2 - 9 y ^ 2 = 225$." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $225$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-9{y}^{2} & =225 \\\\ \\frac{25{x}^{2}}{225}-\\frac{9{y}^{2}}{225} & =\\frac{225}{225} \\\\ \\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt 9 = 3,$ and $b=\\sqrt{25} = 5.$ \n\nTherefore, the asymptotes are $y=\\pm \\dfrac{5}{3}x.$"}] [{:db/id #edb/ref 17592186087566 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/id #uuid "4d9f0ed4-18fd-54bd-8dcc-dd7753cd4963" :question/math-academy-id "e-7426" :question/problem "Find the asymptotes of the hyperbola $\\dfrac{x^2}{36} - \\dfrac{y^2}{9} = 1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{36} = 6, \\qquad b=\\sqrt9 =3.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{6}x \\\\  & =\\pm \\frac{1}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087913 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aea044a4-c379-58b6-a82b-4a78a5f1951e" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{25}{9}x" :db/id #edb/ref 17592186084490} {:answer/id #uuid "daa50918-692c-5ee0-a7f7-1a34b298024a" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{5}{9}x" :db/id #edb/ref 17592186084491} {:answer/id #uuid "2c5b0245-f00a-5e74-91c4-917745e70765" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{5}{3}x" :db/id #edb/ref 17592186084492} {:answer/id #uuid "64549be5-330e-5de0-8b5d-755a0ff76aed" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{3}{5}x" :db/id #edb/ref 17592186084493} {:answer/id #uuid "73cd5365-6578-5338-b108-5ae9472efb1b" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{9}{5}x" :db/id #edb/ref 17592186084494}] :answer-field/correct {:answer/id #uuid "2c5b0245-f00a-5e74-91c4-917745e70765" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{5}{3}x" :db/id #edb/ref 17592186084492} :answer-field/id #uuid "f56e6ae1-7a23-580d-8d37-2d339cd61ad2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084489}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "65a663b7-f048-5aa7-86f6-41942a1fce40" :question/math-academy-id "q-10433" :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{25}-\\frac{{x}^{2}}{9}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{25}=5,\\,b=\\sqrt{9}=3.\n$$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{5}{3}x.$"}] [{:db/id #edb/ref 17592186383404 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f8df0e0-fb92-59d8-a6e3-0b59b8280196" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{4}x" :db/id #edb/ref 17592186383406} {:answer/id #uuid "ebce7f12-0bbc-554f-b8cc-e4d5db04890a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{4}{5}x" :db/id #edb/ref 17592186383407} {:answer/id #uuid "9f392129-5a3a-58c2-8515-50369f20c1f5" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186383408} {:answer/id #uuid "03d14f9d-d29b-50b0-abd7-60c2fe4fa773" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{5}x" :db/id #edb/ref 17592186383409} {:answer/id #uuid "72aea996-816a-50de-8d44-c12932e4eb59" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186383410}] :answer-field/correct {:answer/id #uuid "ebce7f12-0bbc-554f-b8cc-e4d5db04890a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{4}{5}x" :db/id #edb/ref 17592186383407} :answer-field/id #uuid "a9bbe063-332d-53d2-bea7-9f9db3c21476" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383405}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a8c9183a-7e7d-51ff-bf58-dce93f1a9d98" :question/math-academy-id "q-10441" :question/problem "Find the asymptotes of the hyperbola $25{y}^{2}-16{x}^{2}=400.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $400$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{y}^{2}-16{x}^{2} & =400 \\\\ \\frac{25{y}^{2}}{400}-\\frac{16{x}^{2}}{400} & =\\frac{400}{400} \\\\ \\frac{{y}^{2}}{16}-\\frac{{x}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{16}=4$ and $b=\\sqrt{25}=5.$\n\nTherefore, the asymptotes of the hyperbola are $y=\\pm \\frac{4}{5}x.$"}] [{:db/id #edb/ref 17592186383411 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bfa8e52c-c424-5120-b651-2b18332ede7d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5\\sqrt{2}}{2}x" :db/id #edb/ref 17592186383413} {:answer/id #uuid "377e3824-ee2b-537c-ae5d-553c64c178bf" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{2}}{2}x" :db/id #edb/ref 17592186383414} {:answer/id #uuid "7e1b3564-c183-51f5-95aa-3c425ff1127e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5}{2}x" :db/id #edb/ref 17592186383415} {:answer/id #uuid "bbe42875-334a-58d6-924b-bc1219ba2170" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2}{5}x" :db/id #edb/ref 17592186383416} {:answer/id #uuid "6936123a-b8fc-5f81-a791-cf8ba4ca22d9" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{2}}{5}x" :db/id #edb/ref 17592186383417}] :answer-field/correct {:answer/id #uuid "bfa8e52c-c424-5120-b651-2b18332ede7d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{5\\sqrt{2}}{2}x" :db/id #edb/ref 17592186383413} :answer-field/id #uuid "be1288f1-dc3d-56f8-9842-18a950c01887" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383412}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "69971471-9b0f-5238-854c-f07a81985360" :question/math-academy-id "q-116549" :question/problem "Find the asymptotes of the hyperbola $\\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{25}=1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{2},\\,b=\\sqrt{25}=5.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{5}{\\sqrt{2}}x \\\\  & =\\pm \\frac{5\\sqrt{2}}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330596 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a996ac98-695e-5b66-a3e5-422f14627b85" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330598} {:answer/id #uuid "26ab6cc3-af21-5b70-9db5-c763d32abf0e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186330599} {:answer/id #uuid "4e75f933-f9b1-5fa5-a31b-b9760fc9dfe2" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186330600} {:answer/id #uuid "cd889eb4-9b00-5f9a-99af-b1ed6e908dc8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186330601} {:answer/id #uuid "5d2ba3c5-00a3-5eb4-857f-af544e73a629" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{6}}{6}x" :db/id #edb/ref 17592186330602}] :answer-field/correct {:answer/id #uuid "a996ac98-695e-5b66-a3e5-422f14627b85" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330598} :answer-field/id #uuid "6c61aeab-e3a6-5be0-9545-69b8e92984cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330597}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1c1838ee-9e3e-5081-b836-9a84c0498d65" :question/math-academy-id "q-116551" :question/problem "Find the asymptotes of the hyperbola $\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{24}=1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{6},\\,b=\\sqrt{24}=2\\sqrt{6}.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{2\\sqrt{6}}{\\sqrt{6}}x \\\\  & =\\pm 2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383418 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d48d7c15-77c6-5cf9-80e4-18cc31921a4f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{4}x" :db/id #edb/ref 17592186383420} {:answer/id #uuid "5dd4d492-2924-5b33-86c5-33ff56f2f4bc" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{2}x" :db/id #edb/ref 17592186383421} {:answer/id #uuid "9c630777-6bc1-5883-a246-e4a58d0c1cb5" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186383422} {:answer/id #uuid "9fd6ed0b-3745-5eb9-b496-a9b7540a7626" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186383423} {:answer/id #uuid "d9c1de3a-885d-527d-95ce-79cb759dc1bd" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{4}{3}x" :db/id #edb/ref 17592186383424}] :answer-field/correct {:answer/id #uuid "d48d7c15-77c6-5cf9-80e4-18cc31921a4f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{4}x" :db/id #edb/ref 17592186383420} :answer-field/id #uuid "2ca94408-72fd-5be4-ab93-d950e9f1a1ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383419}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "53f1367a-a2ea-5fca-8417-1fb1741d280f" :question/math-academy-id "q-116554" :question/problem "Find the asymptotes of the hyperbola $\\frac{{x}^{2}}{16}-\\frac{{y}^{2}}{9}=1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{16}=4,\\,b=\\sqrt{9}=3.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{4}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383425 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "26c914a7-f6a3-51dc-bc38-9d9c5ec95d8e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2\\sqrt{3}}{3}x" :db/id #edb/ref 17592186383427} {:answer/id #uuid "16295bd9-0cb4-595b-a745-86e6355884b3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186383428} {:answer/id #uuid "093a31dc-886a-597b-beb0-fd386943253d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186383429} {:answer/id #uuid "16be5509-d6a6-5f19-abe6-53791d7edae1" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186383430} {:answer/id #uuid "806b94ed-e127-5145-a629-11f34413623f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186383431}] :answer-field/correct {:answer/id #uuid "093a31dc-886a-597b-beb0-fd386943253d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186383429} :answer-field/id #uuid "2d8067f7-3d23-5713-9e9f-936a12436578" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383426}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "89b826b4-7f7a-564a-b6ad-695d8867255e" :question/math-academy-id "q-116559" :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{3}-\\frac{{x}^{2}}{12}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{3},\\,b=\\sqrt{12}=2\\sqrt{3}.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{\\sqrt{3}}{2\\sqrt{3}}x \\\\  & =\\pm \\frac{1}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383432 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "948dda9f-b506-5cd1-9462-be83e7794eeb" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186383434} {:answer/id #uuid "c5a7d65f-9740-500d-8c13-34582fc090e2" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186383435} {:answer/id #uuid "de320af3-8926-5465-b410-2ed252b6dc2d" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186383436} {:answer/id #uuid "da31c4fd-8f1f-5704-8896-690195bb79f7" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186383437} {:answer/id #uuid "35ee6f55-54a5-5c62-ad2b-b2af37887be9" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2\\sqrt{5}}{5}x" :db/id #edb/ref 17592186383438}] :answer-field/correct {:answer/id #uuid "948dda9f-b506-5cd1-9462-be83e7794eeb" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186383434} :answer-field/id #uuid "cc216b54-b45d-55e8-be0e-bd2e0ce7329a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383433}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fdbdee3c-27c3-5f4c-bc6e-98ad4be07391" :question/math-academy-id "q-116560" :question/problem "Find the asymptotes of the hyperbola $\\frac{{y}^{2}}{20}-\\frac{{x}^{2}}{5}=1.$" :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{20}=2\\sqrt{5},\\,b=\\sqrt{5}.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{2\\sqrt{5}}{\\sqrt{5}}x \\\\  & =\\pm 2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383439 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2144c077-fd55-5775-9bc9-d8ea5a71b5a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}x" :db/id #edb/ref 17592186383441}] :answer-field/correct {:answer/id #uuid "2144c077-fd55-5775-9bc9-d8ea5a71b5a2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}x" :db/id #edb/ref 17592186383441} :answer-field/id #uuid "ff2a321a-b2a1-5b2c-a4c6-747c3faac629" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186383440}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "255d13d2-da0f-5a3d-b274-a3d657b0e4b0" :question/math-academy-id "q-275216" :question/problem "The asymptotes of the hyperbola $2{x}^{2}-18{y}^{2}=162$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $162$ and then simplify, as follows:\n\n$$\n\\begin{aligned}2{x}^{2}-18{y}^{2} & =162 \\\\ \\frac{2{x}^{2}}{162}-\\frac{18{y}^{2}}{162} & =\\frac{162}{162} \\\\ \\frac{{x}^{2}}{81}-\\frac{{y}^{2}}{9} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{81}=9,$ and $b=\\sqrt{9}=3.$ \n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{9}x \\\\  & =\\pm \\frac{1}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383442 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "201760bb-41af-5a21-9ffd-992a6124b618" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}x" :db/id #edb/ref 17592186383444} {:answer/id #uuid "c393d7ea-3576-5481-a1be-0397cf928d3d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}x" :db/id #edb/ref 17592186383445}] :answer-field/correct {:answer/id #uuid "201760bb-41af-5a21-9ffd-992a6124b618" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{10}x" :db/id #edb/ref 17592186383444} :answer-field/id #uuid "715474e1-8c1f-589e-a437-cbc181d83a12" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186383443}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cdf938af-9250-5f05-a286-e3608dd24ab8" :question/math-academy-id "q-316489" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{20}-\\frac{{x}^{2}}{2}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{20},\\,b=\\sqrt{2}.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{\\sqrt{20}}{\\sqrt{2}}x \\\\  & =\\pm \\sqrt{10}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383446 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "45917502-b998-5dc5-9dec-f9cd87ce9044" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}x" :db/id #edb/ref 17592186383448}] :answer-field/correct {:answer/id #uuid "45917502-b998-5dc5-9dec-f9cd87ce9044" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}x" :db/id #edb/ref 17592186383448} :answer-field/id #uuid "c096b0da-6871-5444-b417-15317e0f3514" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186383447}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "135b854c-5e9b-5588-82b0-85ea7b8fedb0" :question/math-academy-id "q-316951" :question/problem "The asymptotes of the hyperbola $4{y}^{2}-9{x}^{2}=36$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $36$ and then simplify, as follows:\n\n$$\n\\begin{aligned}4{y}^{2}-9{x}^{2} & =36 \\\\ \\frac{4{y}^{2}}{36}-\\frac{9{x}^{2}}{36} & =\\frac{36}{36} \\\\ \\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{4} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{9}=3$ and $b=\\sqrt{4}=2.$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383449 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30fd9e83-a527-5ea6-b4ac-96a92cb7dba2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}x" :db/id #edb/ref 17592186383451} {:answer/id #uuid "59741092-1647-5894-b6f5-b2979130dd33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}x" :db/id #edb/ref 17592186383452}] :answer-field/correct {:answer/id #uuid "59741092-1647-5894-b6f5-b2979130dd33" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}x" :db/id #edb/ref 17592186383452} :answer-field/id #uuid "c520f654-6293-513a-95bb-74a5a56cb13b" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186383450}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d70fcdb1-1640-55c4-b852-fcd6b07cc2ac" :question/math-academy-id "q-316956" :question/problem "The asymptotes of the hyperbola $18{y}^{2}-50{x}^{2}=900$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $900$ and then simplify, as follows:\n\n$$\n\\begin{aligned}18{y}^{2}-50{x}^{2} & =900 \\\\ \\frac{18{y}^{2}}{900}-\\frac{50{x}^{2}}{900} & =\\frac{900}{900} \\\\ \\frac{{y}^{2}}{50}-\\frac{{x}^{2}}{18} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{50}=5\\sqrt{2}$ and $b=\\sqrt{18}=3\\sqrt{2}.$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{\\sqrt{50}}{\\sqrt{18}} \\\\  & =\\pm \\frac{5\\sqrt{2}}{3\\sqrt{2}} \\\\  & =\\pm \\frac{5}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330633 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4229a252-e235-5e97-b713-d78698c12011" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186330635}] :answer-field/correct {:answer/id #uuid "4229a252-e235-5e97-b713-d78698c12011" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186330635} :answer-field/id #uuid "22250f67-3925-51fe-97c6-335c7eee5241" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330634}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f68d254f-bdd5-5c65-9cd4-cfe81ad88b23" :question/math-academy-id "q-316965" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{16}-\\frac{{x}^{2}}{36}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{16}=4,\\,b=\\sqrt{36}=6.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{4}{6}x \\\\  & =\\pm \\frac{2}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383453 :knowledge-point/_questions [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c341b5a5-b138-543e-91aa-6f1610500142" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{2\\sqrt{3}}{3}x" :db/id #edb/ref 17592186383455} {:answer/id #uuid "2d20ae18-72e5-5a81-8231-991af7bef088" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{3}}{4}x" :db/id #edb/ref 17592186383456} {:answer/id #uuid "d2d10dd5-9c3c-5326-873f-89c4be93cc00" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{3}}{2}x" :db/id #edb/ref 17592186383457} {:answer/id #uuid "7167697e-32aa-58fe-abce-4af17f6c9155" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3}{2}x" :db/id #edb/ref 17592186383458} {:answer/id #uuid "00d3d7c3-7438-5f6c-a861-880e8bd90de0" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{3\\sqrt{2}}{2}x" :db/id #edb/ref 17592186383459}] :answer-field/correct {:answer/id #uuid "d2d10dd5-9c3c-5326-873f-89c4be93cc00" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{3}}{2}x" :db/id #edb/ref 17592186383457} :answer-field/id #uuid "982a06c4-5232-5534-a0d2-16174190241b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383454}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c626f7da-a75d-5e5e-8738-967cdc589d2c" :question/math-academy-id "q-7976" :question/problem "Find the asymptotes of the hyperbola $3{x}^{2}-4{y}^{2}=12.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $12$ and then simplify, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-4{y}^{2} & =12 \\\\ \\frac{3{x}^{2}}{12}-\\frac{4{y}^{2}}{12} & =\\frac{12}{12} \\\\ \\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{3} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt{4}=2,$ and $b=\\sqrt{3}.$ \n\nTherefore, the asymptotes are $y=\\pm \\frac{\\sqrt{3}}{2}x.$"}] [{:db/id #edb/ref 17592186330650 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2d83ce9-b436-5e97-84c2-1da6cfcb9872" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330652} {:answer/id #uuid "528cd1e8-f76c-5c70-9e68-402f1922f6d3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186330653} {:answer/id #uuid "80dd4a89-fe29-5eae-bed4-da4339d07b9f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm x" :db/id #edb/ref 17592186330654} {:answer/id #uuid "50bc15a8-8c0b-5f5a-8ce6-7919569a238a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186330655} {:answer/id #uuid "41fba7c4-3b0e-5396-9685-9aaa92da4b16" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186330656}] :answer-field/correct {:answer/id #u