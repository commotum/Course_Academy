#{[{:db/id #edb/ref 17592186087485 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/id #uuid "f81dc1a8-36bf-5918-b702-2d37000a0457" :question/math-academy-id "e-5356" :question/problem "Find the asymptotes of the hyperbola $\\dfrac{y^2}{9} - \\dfrac{x^2}{16} = 1$." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\dfrac{y^2}{a^2} - \\dfrac{x^2}{b^2} = 1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{a}{b} x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{9} = 3, \\qquad b=\\sqrt{16} = 4.\n$$\n\nTherefore, the asymptotes of the hyperbola are $y = \\pm \\dfrac{3}{4}x.$"}] [{:db/id #edb/ref 17592186087486 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "ca7c76e6-204b-5b30-8e62-c53027b63448" :knowledge-point/title "Finding the Asymptotes of a Hyperbola Given Its Equation in Non-Standard Form"}] :question/id #uuid "87c1fed0-66fa-5b7d-b79d-80e96074321e" :question/math-academy-id "e-5357" :question/problem "Calculate the asymptotes of the hyperbola $25 x ^ 2 - 9 y ^ 2 = 225$." :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{b}{a}x.\n$$\n\nTo rewrite the given equation in standard form, we divide both sides of the equation by $225$ and then simplify, as follows:\n\n$$\n\\begin{aligned}25{x}^{2}-9{y}^{2} & =225 \\\\ \\frac{25{x}^{2}}{225}-\\frac{9{y}^{2}}{225} & =\\frac{225}{225} \\\\ \\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1\\end{aligned}\n$$\n\nSo, we have $a=\\sqrt 9 = 3,$ and $b=\\sqrt{25} = 5.$ \n\nTherefore, the asymptotes are $y=\\pm \\dfrac{5}{3}x.$"}] [{:db/id #edb/ref 17592186087566 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/id #uuid "4d9f0ed4-18fd-54bd-8dcc-dd7753cd4963" :question/math-academy-id "e-7426" :question/problem "Find the asymptotes of the hyperbola $\\dfrac{x^2}{36} - \\dfrac{y^2}{9} = 1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{x^2}{a^2} - \\frac{y^2}{b^2}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\dfrac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{36} = 6, \\qquad b=\\sqrt9 =3.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{3}{6}x \\\\  & =\\pm \\frac{1}{2}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087913 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "aea044a4-c379-58b6-a82b-4a78a5f1951e" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{25}{9}x" :db/id #edb/ref 17592186084490} {:answer/id #uuid "daa50918-692c-5ee0-a7f7-1a34b298024a" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{5}{9}x" :db/id #edb/ref 17592186084491} {:answer/id #uuid "2c5b0245-f00a-5e74-91c4-917745e70765" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{5}{3}x" :db/id #edb/ref 17592186084492} {:answer/id #uuid "64549be5-330e-5de0-8b5d-755a0ff76aed" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{3}{5}x" :db/id #edb/ref 17592186084493} {:answer/id #uuid "73cd5365-6578-5338-b108-5ae9472efb1b" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{9}{5}x" :db/id #edb/ref 17592186084494}] :answer-field/correct {:answer/id #uuid "2c5b0245-f00a-5e74-91c4-917745e70765" :answer/type {:db/ident :answer.type/math} :answer/value "y = ± \\frac{5}{3}x" :db/id #edb/ref 17592186084492} :answer-field/id #uuid "f56e6ae1-7a23-580d-8d37-2d339cd61ad2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084489}] :question/id #uuid "65a663b7-f048-5aa7-86f6-41942a1fce40" :question/math-academy-id "q-10433" :question/problem "Find the asymptotes of the hyperbola $\\frac{y^{2}}{25} - \\frac{x^{2}}{9} = 1$."}] [{:db/id #edb/ref 17592186330596 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a996ac98-695e-5b66-a3e5-422f14627b85" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330598} {:answer/id #uuid "26ab6cc3-af21-5b70-9db5-c763d32abf0e" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186330599} {:answer/id #uuid "4e75f933-f9b1-5fa5-a31b-b9760fc9dfe2" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186330600} {:answer/id #uuid "cd889eb4-9b00-5f9a-99af-b1ed6e908dc8" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186330601} {:answer/id #uuid "5d2ba3c5-00a3-5eb4-857f-af544e73a629" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{\\sqrt{6}}{6}x" :db/id #edb/ref 17592186330602}] :answer-field/correct {:answer/id #uuid "a996ac98-695e-5b66-a3e5-422f14627b85" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330598} :answer-field/id #uuid "6c61aeab-e3a6-5be0-9545-69b8e92984cf" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330597}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1c1838ee-9e3e-5081-b836-9a84c0498d65" :question/math-academy-id "q-116551" :question/problem "Find the asymptotes of the hyperbola $\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{24}=1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{6},\\,b=\\sqrt{24}=2\\sqrt{6}.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{2\\sqrt{6}}{\\sqrt{6}}x \\\\  & =\\pm 2x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330633 :knowledge-point/_questions [{:knowledge-point/id #uuid "0095663f-b994-5ed0-ab96-e9270b71cf98" :knowledge-point/title "Finding the Asymptotes of a Vertical Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4229a252-e235-5e97-b713-d78698c12011" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186330635}] :answer-field/correct {:answer/id #uuid "4229a252-e235-5e97-b713-d78698c12011" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}x" :db/id #edb/ref 17592186330635} :answer-field/id #uuid "22250f67-3925-51fe-97c6-335c7eee5241" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186330634}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f68d254f-bdd5-5c65-9cd4-cfe81ad88b23" :question/math-academy-id "q-316965" :question/problem "The asymptotes of the hyperbola $\\frac{{y}^{2}}{16}-\\frac{{x}^{2}}{36}=1$ are$\\,\\,y=\\pm $\n{{field-1}}." :question/worked-solution "The standard equation of a vertical hyperbola centered at the origin is\n\n$$\n\\frac{{y}^{2}}{{a}^{2}}-\\frac{{x}^{2}}{{b}^{2}}=1.\n$$\n\nFor a vertical hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{a}{b}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{16}=4,\\,b=\\sqrt{36}=6.\n$$\n\nTherefore, the asymptotes of the hyperbola are\n\n$$\n\\begin{aligned}y & =\\pm \\frac{4}{6}x \\\\  & =\\pm \\frac{2}{3}x.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186330650 :knowledge-point/_questions [{:knowledge-point/id #uuid "d3340444-0db2-5cdd-8032-02955fc2dae0" :knowledge-point/title "Finding the Asymptotes of a Horizontal Hyperbola Given in Standard Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c2d83ce9-b436-5e97-84c2-1da6cfcb9872" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330652} {:answer/id #uuid "528cd1e8-f76c-5c70-9e68-402f1922f6d3" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{2}x" :db/id #edb/ref 17592186330653} {:answer/id #uuid "80dd4a89-fe29-5eae-bed4-da4339d07b9f" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm x" :db/id #edb/ref 17592186330654} {:answer/id #uuid "50bc15a8-8c0b-5f5a-8ce6-7919569a238a" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 4x" :db/id #edb/ref 17592186330655} {:answer/id #uuid "41fba7c4-3b0e-5396-9685-9aaa92da4b16" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm \\frac{1}{4}x" :db/id #edb/ref 17592186330656}] :answer-field/correct {:answer/id #uuid "c2d83ce9-b436-5e97-84c2-1da6cfcb9872" :answer/type {:db/ident :answer.type/math} :answer/value "y=\\pm 2x" :db/id #edb/ref 17592186330652} :answer-field/id #uuid "589fa5fd-012f-58ac-8d65-a8bf7273e297" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186330651}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "281750f4-143d-5774-af34-51dfba3c9462" :question/math-academy-id "q-8063" :question/problem "Find the asymptotes of the hyperbola $\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{16}=1.$" :question/worked-solution "The standard equation of a horizontal hyperbola centered at the origin is\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nFor a horizontal hyperbola centered at the origin, the equations of the asymptotes are\n\n$$\ny=\\pm \\frac{b}{a}x.\n$$\n\nIn our case, we have \n\n$$\na=\\sqrt{4}=2,\\,b=\\sqrt{16}=4.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{4}{2}x \\\\  & =\\pm 2x.\\end{aligned}\n$$"}]}
