r case, we have \n\n$$\na=\\sqrt{6},\\,b=\\sqrt{24}=2\\sqrt{6}.\n$$\n\nTherefore, the asymptotes of the hyperbola are \n\n$$\n\\begin{aligned}y & =\\pm \\frac{2\\sqrt{6}}{\\sqrt{6}}x \\\\  & =\\pm 2x.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14076822/state.json" "file_sha256" "1c40954da2f9101cf7f14a8e98e63ae50fa72e99e3dba7f33d0aea78b902d432"} {"question" "q-116551" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14076822/activity-metadata.json" "file_sha256" "eed75569b01102438865dcc54eba711ff91acc736cc07f6f34ca9e3749c5954a"} {"question" "q-116551" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14076822/state.json" "file_sha256" "1c40954da2f9101cf7f14a8e98e63ae50fa72e99e3dba7f33d0aea78b902d432"} {"question" "q-116551" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=\\pm 2x"] ["math" "y=\\pm 4x"] ["math" "y=\\pm \\frac{1}{2}x"] ["math" "y=\\pm \\frac{1}{4}x"] ["math" "y=\\pm \\frac{\\sqrt{6}}{6}x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14076822/state.json" "file_sha256" "1c40954da2f9101cf7f14a8e98e63ae50fa72e99e3dba7f33d0aea78b902d432"} {"question" "q-116551" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=\\pm 2x"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14076822/state.json" "file_sha256" "1c40954da2f9101cf7f14a8e98e63ae50fa72e99e3dba7f33d0aea78b902d432"} {"question" "q-84080" "fiel