\\le 1,\\,0\\le y\\le 2}.$" 13194139536155 true] [17592186386392 1113 #uuid "dc061799-2611-580f-81d1-666b5e54d90b" 13194139536155 true] [17592186386392 1145 "First, notice that \n\n$$\n\\text{Area}(D)=1\\cdot 2=2.\n$$\n\nApplying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A \\\\  & =\\frac{1}{2}{∬}_{D}(2x+3{y}^{2})\\,\\text{d}A \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}{\\int }_{0}^{2}(2x+3{y}^{2})\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}[2xy+{y}^{3}]_{y=0}^{y=2}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{0}^{1}(4x+8)\\,\\text{d}x \\\\  & =\\frac{1}{2}[2{x}^{2}+8x]_{x=0}^{x=1} \\\\  & =\\frac{1}{2}(2\\cdot {1}^{2}+8\\cdot 1) \\\\  & =\\frac{10}{2} \\\\  & =5.\\end{aligned}\n$$" 13194139536155 true] [17592186386393 1000 #edb/ref 17592186386394 13194139536155 true] [17592186386393 1000 #edb/ref 17592186386395 13194139536155 true] [17592186386393 1000 #edb/ref 17592186386396 13194139536155 true] [17592186386393 1000 #edb/ref 17592186386397 13194139536155 true] [17592186386393 1000 #edb/ref 17592186386398 13194139536155 true] [17592186386393 1040 #edb/ref 17592186045450 13194139536155 true] [17592186386393 1041 "selection" 13194139536155 true] [17592186386393 1104 #edb/ref 17592186386398 13194139536155 true] [17592186386393 1110 #uuid "7a1701e8-86e9-59a1-b366-770d392db03c" 13194139536155 true] [17592186386394 1034 "3" 13194139536155 true] [17592186386394 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386394 1111 #uuid "35ebd65b-e875-5b56-9666-b85f4af6ba3b" 13194139536155 true] [17592186386395 1034 "7" 13194139536155 true] [17592186386395 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386395 1111 #uuid "87395c66-2072-5995-ace4-dd1243a5b877" 13194139536155 true] [17592186386396 1034 "6" 13194139536155 true] [17592186386396 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386396 1111 #uuid "6d887425-acc0-5615-8335-98ed92c7b638" 13194139536155 true] [17592186386397 1034 "4" 13194139536155 true] [17592186386397 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386397 1111 #uuid "bbdd2889-f4ce-55b1-9e0e-4ea6cff9b807" 13194139536155 true] [17592186386398 1034 "5" 13194139536155 true] [17592186386398 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386398 1111 #uuid "9dedcc09-df3f-558e-bc6c-76af98360cdb" 13194139536155 true] [17592186386399 1017 #edb/ref 17592186386400 13194139536155 true] [17592186386399 1089 "q-163255" 13194139536155 true] [17592186386399 1091 #edb/ref 17592186045465 13194139536155 true] [17592186386399 1100 "Find the average value of the function $f(x,y)=12x{y}^{3}$ on the region $D={(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le \\frac{x}{4}}$ given that the area of the region is $\\frac{1}{2}.$" 13194139536155 true] [17592186386399 1113 #uuid "47c72fc7-8dae-51ee-b86c-f302860768d9" 13194139536155 true] [17592186386399 1145 "Applying the average value formula, we find that the average value of the function is\n\n$$\n\\begin{aligned}{f}_{\\text{ave}} & =\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A \\\\  & =\\frac{1}{(\\frac{1}{2})}{∬}_{D}12x{y}^{3}\\,\\text{d}A \\\\  & =2{\\int }_{0}^{2}{\\int }_{0}^{x/4}12x{y}^{3}\\,\\text{d}y\\,\\text{d}x \\\\  & =2{\\int }_{0}^{2}[3x{y}^{4}]_{y=0}^{y=x/4}\\,\\text{d}y \\\\  & =2{\\int }_{0}^{2}\\frac{3{x}^{5}}{256}\\,\\text{d}x \\\\  & =2[\\frac{{x}^{6}}{512}]_{x=0}^{x=2} \\\\  & =2(\\frac{1}{8}-0) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" 13194139536155 true] [17592186386400 1000 #edb/ref 17592186386401 13194139536155 true] [17592186386400 1000 #edb/ref 17592186386402 13194139536155 true] [17592186386400 1000 #edb/ref 17592186386403 13194139536155 true] [17592186386400 1000 #edb/ref 17592186386404 13194139536155 true] [17592186386400 1000 #edb/ref 17592186386405 13194139536155 true] [17592186386400 1040 #edb/ref 17592186045450 13194139536155 true] [17592186386400 1041 "selection" 13194139536155 true] [17592186386400 1104 #edb/ref 17592186386404 13194139536155 true] [17592186386400 1110 #uuid "8e3873d4-a0c7-5879-a8fb-662ae99c510b" 13194139536155 true] [17592186386401 1034 "\\frac{1}{8}" 13194139536155 true] [17592186386401 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386401 1111 #uuid "b5896e91-ed14-5b39-b2a7-654c250e40ad" 13194139536155 true] [17592186386402 1034 "\\frac{1}{2}" 13194139536155 true] [17592186386402 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386402 1111 #uuid "ce8ed80a-9a9c-55f6-92e4-2e4e59a536c7" 13194139536155 true] [17592186386403 1034 "2" 13194139536155 true] [17592186386403 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386403 1111 #uuid "9112772d-31ff-578a-a582-e2b4beee94cf" 13194139536155 true] [17592186386404 1034 "\\frac{1}{4}" 13194139536155 true] [17592186386404 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386404 1111 #uuid "302fc955-4607-596d-ae98-c1e5f8ecbfe8" 13194139536155 true] [17592186386405 1034 "1" 13194139536155 true] [17592186386405 1103 #edb/ref 17592186045453 13194139536155 true] [17592186386405 1111 #uuid "6d99e78b-b59b-5613-9f94-1345266d7296" 13194139536155 true] [17592186386406 1017 #edb/ref 17592186386407 13194139536155 true] [17592186386406 1089 "q-163260" 13194139536155 true] [17592186386406 1091 #edb/ref 17592186045465 13194139536155 true] [17592186386406 1100 "Find the average value of the function $f(x,y)=\\frac{2}{{x}^{2}+{y}^{2}+1}$ on the portion of the disk of radius $3$ centered at the origin, where $x\\le 0.$" 13194139536155 true] [17592186386406 1113 #uuid "e164d930-d843-5cfb-9760-b4974ed33be6" 13194139536155 true] [17592186386406 1145 "First, let's sketch our region $D:$ \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14081614/assets/25c1f00e588ddaa130f854d9f4e9dfe9b1158d7952a01bae8108ea4b94d3c347.png)\n\nNotice that \n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot \\pi \\cdot {3}^{2}=\\frac{9\\pi }{2}.\n$$\n\nThe average value of the function over a region $D$ is given by\n\n$$\n{f}_{\\text{ave}}=\\frac{1}{\\text{Area}(D)}\\,{∬}_{D}f(x,y)\\,\\text{d}A.\n$$\n\nWe will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{2}}.\n$$\n\nUsing the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2}{{x}^{2}+{y}^{2}+1}\\,\\text{d}A & ={∬}_{Δ}\\frac{2}{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}+1}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{3}\\frac{2r}{{r}^{2}+1}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}[\\operatorname{ln}⁡({r}^{2}+1)]_{0}^{3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{ln}⁡10-\\operatorname{ln}⁡1)\\,\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡10{\\int }_{\\pi /2}^{3\\pi /2}\\text{d}\\theta  \\\\  & =\\operatorname{ln}⁡10[\\theta ]_{\\pi /2}^{3\\pi /2} \\\\  & =\\operatorname{ln}⁡10(\\frac{3\\pi }{2}-\\frac{\\pi }{2}) \\\\  & =\\pi \\operatorname{ln}⁡10.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n{f}_{\\text{ave}}=\\frac{2}{9\\pi }\\cdot \\pi \\operatorname{ln}⁡10=\\frac{2\\operatorname{ln}⁡10}{9}.\n$$" 13194139536155 true] [17592186386407 1000 #edb/ref 17592186386408 13194139536155 true] [17592186386407 1000 #edb/ref 17592186386409 13194139536155 true] [17592186386407 1000 #edb/ref 17592186386410 13194139536155 true] [17592186386407 1000 #edb/ref 17592186386411 13194139536155 true] [17592186386407 1000 #edb/ref 17592186386412 13194139536155 true] [17592186386407 1040 #edb/ref 17592186045450 13194139536155 true] [17592186386407 1041 "selection" 13194139536155 true] [1759218638640