ame{cos}⁡4\\theta +1}{8}\\,\\text{d}\\theta ) \\\\  & =\\frac{8M}{3\\pi }\\cdot ({\\int }_{-\\pi /2}^{\\pi /2}\\frac{3}{8}-\\frac{\\operatorname{cos}⁡2\\theta }{2}+\\frac{\\operatorname{cos}⁡4\\theta }{8}\\,\\text{d}\\theta ) \\\\  & =\\frac{8M}{3\\pi }\\cdot {[\\frac{3\\theta }{8}-\\frac{\\operatorname{sin}⁡2\\theta }{4}+\\frac{\\operatorname{sin}⁡4\\theta }{32}]}_{-\\pi /2}^{\\pi /2} \\\\  & =\\frac{8M}{3\\pi }\\cdot \\frac{3\\pi }{8} \\\\  & =M.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{x} & =\\sqrt{\\frac{{I}_{x}}{M}} \\\\  & =\\sqrt{M\\cdot \\frac{1}{M}} \\\\  & =1.\\end{aligned}\n$$" 13194139536027 true] [17592186379959 1000 #edb/ref 17592186379960 13194139536027 true] [17592186379959 1000 #edb/ref 17592186379961 13194139536027 true] [17592186379959 1000 #edb/ref 17592186379962 13194139536027 true] [17592186379959 1000 #edb/ref 17592186379963 13194139536027 true] [17592186379959 1000 #edb/ref 17592186379964 13194139536027 true] [17592186379959 1040 #edb/ref 17592186045450 13194139536027 true] [17592186379959 1041 "selection" 13194139536027 true] [17592186379959 1104 #edb/ref 17592186379964 13194139536027 true] [17592186379959 1110 #uuid "8a73b21b-8693-53c9-b09c-068d274ba5bc" 13194139536027 true] [17592186379960 1034 "\\frac{2}{3}" 13194139536027 true] [17592186379960 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379960 1111 #uuid "d1782786-c99e-5706-95f4-e348e16fd5b7" 13194139536027 true] [17592186379961 1034 "\\frac{3\\pi }{8}" 13194139536027 true] [17592186379961 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379961 1111 #uuid "a0e5cc8b-2506-50d2-afa5-32fc1168679d" 13194139536027 true] [17592186379962 1034 "\\frac{7}{8}" 13194139536027 true] [17592186379962 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379962 1111 #uuid "99b42a1f-ecf9-5bfd-b64d-391a6c4b210b" 13194139536027 true] [17592186379963 1034 "\\frac{3}{2\\pi }" 13194139536027 true] [17592186379963 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379963 1111 #uuid "3d6ac81d-a1a8-5904-9aaa-112cd57680b7" 13194139536027 true] [17592186379964 1034 "1" 13194139536027 true] [17592186379964 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379964 1111 #uuid "ef045a0f-cfe3-5ab9-aa0e-cdbd03c3cacf" 13194139536027 true] [17592186379965 1017 #edb/ref 17592186379966 13194139536027 true] [17592186379965 1089 "q-163657" 13194139536027 true] [17592186379965 1091 #edb/ref 17592186045464 13194139536027 true] [17592186379965 1100 "A plate of mass $M$ occupies the region between two circles ${x}^{2}+{y}^{2}=1$ and ${x}^{2}+{y}^{2}=4.$ Its mass density at any point is given by $\\lambda (x,y)=\\frac{4M}{15\\pi }{x}^{2}.$ Find the radius of gyration of the plate about the origin." 13194139536027 true] [17592186379965 1113 #uuid "a99d2798-c187-5104-9954-2eb7a502ad0a" 13194139536027 true] [17592186379965 1145 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nIn polar coordinates, the region occupied by the plate is given by\n\n$$\nD={(r,\\theta )\\,:\\,1\\le r\\le 2,\\,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nThe moment of inertia about the origin, in polar coordinates, is defined as\n\n$$\n{I}_{0}={∬}_{D}\\lambda (r,\\theta ){r}^{3}\\,\\text{d}r\\,\\text{d}\\theta ,\n$$\n\nwhere $\\lambda (r,\\theta )$ is the mass density function.\n\nAlso, the mass density in terms of polar coordinates is $\\lambda (r,\\theta )=\\frac{4M}{15\\pi }{r}^{2}{cos}^{2}⁡\\theta .$\nTherefore, the moment of inertia about the $x$-axis is\n\n$$\n\\begin{aligned}{I}_{0} & ={∬}_{D}\\lambda (r,\\theta ){r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{4M}{15\\pi }{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{5}{cos}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\frac{4M}{15\\pi }({\\int }_{1}^{2}{r}^{5}\\,\\text{d}r)({\\int }_{0}^{2\\pi }{cos}^{2}⁡\\theta \\,\\text{d}\\theta ) \\\\  & =\\frac{4M}{15\\pi }\\cdot \\frac{1}{6}{r}^{6}{|}_{1}^{2}({\\int }_{0}^{2\\pi }\\frac{1+\\operatorname{cos}⁡2\\theta }{2}\\,\\text{d}\\theta ) \\\\  & =\\frac{4M}{15\\pi }\\cdot \\frac{21}{2}\\cdot {[\\frac{\\theta }{2}+\\frac{\\operatorname{sin}⁡2\\theta }{4}]}_{0}^{2\\pi } \\\\  & =\\frac{14M}{5\\pi }\\cdot \\pi  \\\\  & =\\frac{14M}{5}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $x$-axis is\n\n$$\n\\begin{aligned}{R}_{0} & =\\sqrt{\\frac{{I}_{0}}{M}} \\\\  & =\\sqrt{\\frac{14M}{5}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{14}{5}}.\\end{aligned}\n$$" 13194139536027 true] [17592186379966 1000 #edb/ref 17592186379967 13194139536027 true] [17592186379966 1000 #edb/ref 17592186379968 13194139536027 true] [17592186379966 1000 #edb/ref 17592186379969 13194139536027 true] [17592186379966 1000 #edb/ref 17592186379970 13194139536027 true] [17592186379966 1000 #edb/ref 17592186379971 13194139536027 true] [17592186379966 1040 #edb/ref 17592186045450 13194139536027 true] [17592186379966 1041 "selection" 13194139536027 true] [17592186379966 1104 #edb/ref 17592186379969 13194139536027 true] [17592186379966 1110 #uuid "c705de2f-b369-5420-971d-96cd88370316" 13194139536027 true] [17592186379967 1034 "\\sqrt{\\frac{7}{3}}" 13194139536027 true] [17592186379967 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379967 1111 #uuid "a08c0d15-519b-5833-bf89-f478d5d65d89" 13194139536027 true] [17592186379968 1034 "\\sqrt{\\frac{5}{2}}" 13194139536027 true] [17592186379968 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379968 1111 #uuid "f81728d3-164e-5677-af8f-f16be9f2feda" 13194139536027 true] [17592186379969 1034 "\\sqrt{\\frac{14}{5}}" 13194139536027 true] [17592186379969 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379969 1111 #uuid "92674799-0b41-5422-bd97-ecc681558abe" 13194139536027 true] [17592186379970 1034 "\\frac{3}{2}" 13194139536027 true] [17592186379970 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379970 1111 #uuid "6165bbc0-de39-5bec-a731-cc429253e058" 13194139536027 true] [17592186379971 1034 "\\frac{5}{3}" 13194139536027 true] [17592186379971 1103 #edb/ref 17592186045453 13194139536027 true] [17592186379971 1111 #uuid "f00fffb7-fa7b-5270-b6a6-58859f3f4cfa" 13194139536027 true] [17592186379972 1017 #edb/ref 17592186379973 13194139536027 true] [17592186379972 1089 "q-38820" 13194139536027 true] [17592186379972 1091 #edb/ref 17592186045465 13194139536027 true] [17592186379972 1100 "A plate of mass $M$ occupies the region $D$ enclosed by the curve $y={x}^{2},$ the line $x=1,$ and the $x$-axis. Its mass density at any point on the plate is given by $\\lambda (x,y)=\\frac{20M}{7}(x+y).$ Find the radius of gyration of the plate about the $y$-axis." 13194139536027 true] [17592186379972 1113 #uuid "2d6194c5-1762-5426-8143-928d732b6bf1" 13194139536027 true] [17592186379972 1145 "For a plane lamina in the shape of a region $D$ with mass $M$ and mass density function $\\lambda (x,y),$ we have the following definitions:\n\n- The radius of gyration ${R}_{x}$ about the $x$-axis is given by\n${R}_{x}=\\sqrt{\\frac{{I}_{x}}{M}},$\nwhere ${I}_{x}$ is the moment of inertia about the $x$-axis.\n\n- The radius of gyration ${R}_{y}$ about the $y$-axis is given by\n${R}_{y}=\\sqrt{\\frac{{I}_{y}}{M}},$\nwhere ${I}_{y}$ is the moment of inertia about the $y$-axis.\n\n- The radius of gyration ${R}_{0}$ about the origin is given by\n${R}_{0}=\\sqrt{\\frac{{I}_{0}}{M}},$\nwhere ${I}_{0}$ is the moment of inertia about the origin.\n\nThe moment of inertia about the $y$-axis is defined as\n\n$$\n{I}_{y}={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A,\n$$\n\nwhere $\\lambda (x,y)$ is the mass density function. The region $D$ is a type I region with representation\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,\\,0\\le y\\le {x}^{2}}.\n$$\n\nHence, the moment of inertia about the $y$-axis is\n\n$$\n\\begin{aligned}{I}_{y} & ={∬}_{D}{x}^{2}\\lambda (x,y)\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}{x}^{2}\\cdot \\frac{20M}{7}(x+y)\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{20M}{7}{\\int }_{0}^{1}{\\int }_{0}^{{x}^{2}}{x}^{3}+{x}^{2}y\\,\\text{d}y\\,\\text{d}x \\\\  & =\\frac{20M}{7}{\\int }_{0}^{1}{[{x}^{3}y+\\frac{1}{2}{x}^{2}{y}^{2}]}_{y=0}^{y={x}^{2}}\\,\\text{d}x \\\\  & =\\frac{20M}{7}{\\int }_{0}^{1}{x}^{5}+\\frac{1}{2}{x}^{6}\\,\\text{d}x \\\\  & =\\frac{20M}{7}{[\\frac{1}{6}{x}^{6}+\\frac{1}{14}{x}^{7}]}_{0}^{1} \\\\  & =\\frac{20M}{7}(\\frac{1}{6}+\\frac{1}{14}) \\\\  & =\\frac{20M}{7}\\cdot \\frac{5}{21} \\\\  & =\\frac{100M}{147}.\\end{aligned}\n$$\n\nTherefore, the radius of gyration about the $y$-axis is\n\n$$\n\\begin{aligned}{R}_{y} & =\\sqrt{\\frac{{I}_{y}}{M}} \\\\  & =\\sqrt{\\frac{100M}{147}\\cdot \\frac{1}{M}} \\\\  & =\\sqrt{\\frac{100}{147}} \\\\  & =\\frac{10}{7\\sqrt{3}}.\\end{aligned}\n$$" 13194139536027 true] [17592186379973 1000 #edb/ref 17592186379974 13194139536027 true] [17592186379973 1000 #edb/ref 17592186379975 13194139536027 true] [17592186379973 1000 #edb/ref 17592186379976 13194139536027 true] [17592186379973 1000 #edb/ref 17592186379977 13194139536027 true] [17592186379973 1000 #edb/ref 17592186379978 13194139536027 true] [17592186379973 1040 #edb/ref 17592186045450 13194139536027 true] [17592186379973 1041 "selection" 13194139536027 true] [17592186379973 1104 #edb/ref 17592186379978 13194139536027 true] [17592186379973 1110 #uuid "71d41b46-cece-5da6-8f82-a66347a43318" 13194139536027 true] [17592186379974 1034 "\\sqrt{\\frac{5}