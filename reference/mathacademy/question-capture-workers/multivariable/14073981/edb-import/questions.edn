t the $x$-axis."}] [{:db/id #edb/ref 17592186198884 :knowledge-point/_questions [{:knowledge-point/id #uuid "068d9714-bd1e-5036-a0c7-9be288831f52" :knowledge-point/title "Calculating Radii of Gyration Using Polar Coordinates"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d63eec45-6603-524b-8b1d-8cafe4400294" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{3}{8}}" :db/id #edb/ref 17592186197540} {:answer/id #uuid "1c216982-e507-5c04-8510-d5cf017c3e1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{8}{5}}" :db/id #edb/ref 17592186197541} {:answer/id #uuid "456ccd78-2fa8-5537-8f57-f080774e1a82" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{3}{5}}" :db/id #edb/ref 17592186197542} {:answer/id #uuid "614ef90a-009d-574b-b93b-7cbd61d3ff5d" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{9}{5}}" :db/id #edb/ref 17592186197543} {:answer/id #uuid "6a0e82f2-9239-5d13-a910-b57f9213ac92" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{3}{7}}" :db/id #edb/ref 17592186197544}] :answer-field/correct {:answer/id #uuid "1c216982-e507-5c04-8510-d5cf017c3e1e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{\\frac{8}{5}}" :db/id #edb/ref 17592186197541} :answer-field/id #uuid "043793c1-378d-5a98-85c7-52b59096096c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186197539}] :question/id #uuid "b6fbab0f-40fd-5c65-87d5-1b56f0245d59" :question/math-academy-id "q-38825" :question/problem "A plate of mass $M$ occupies the part of the circle $x^{2} + y^{2} \\le 4$ in the first quadrant. Its mass density at any point is given by $λ(x, y) = \\frac{3}{8}Mx$. Find the radius of gyration of the plate about the $y$-axis."}]}
