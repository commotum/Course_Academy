}\\,:\\,y\\ne 0,\\,{x}^{2}+{y}^{2}<2}"] ["math" "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,{x}^{2}+{y}^{2}\\ge 2}"] ["text" "The domain is the entire $xy-$plane"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/state.json" "file_sha256" "232a3d4216aab837d8ccd204c64debb0065dda813f05b06326ef276df6177f7a"} {"question" "q-158564" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/state.json" "file_sha256" "232a3d4216aab837d8ccd204c64debb0065dda813f05b06326ef276df6177f7a"}] "usage" {"q-158438" []} "basis" 2722 "retractions" [[17592186124726 :question/problem "Find the domain of the function $f(x, y) = e^{x^{2} - y^{2}}$."]] "immutable_answers" [17592186121376 17592186121377 17592186121378 17592186121379 17592186121380] "immutable_fields" [[17592186121375 :answer-field/correct] [17592186121375 :answer-field/id] [17592186121375 :answer-field/key] [17592186121375 :answer-field/type]] "no_history" []}
