ab63bb816e7a7c314c2.png" :db/ensure [:answer/validate]} {:db/id "q-158192/selection" :answer-field/id #uuid "5ec9f70a-3be4-5eea-89f1-33008c5591d6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158192/selection/bac7a4e2a51211597ef5c90d00a77da31e38dc9042b2bc8d93767456bd060355" :answer-field/choices ["q-158192/selection/97c015e0c694787db26a6f70e78aa9e9caaf70bec5d8c54c704edb53c7102947" "q-158192/selection/bac7a4e2a51211597ef5c90d00a77da31e38dc9042b2bc8d93767456bd060355" "q-158192/selection/2148f87d9166858d14a3f7d997cedf091025f82a6a1a1ef8158dae0a09a4b7d2" "q-158192/selection/d8574418e11f1b1bb026617548434a7135c91e6622e65dcb5245f000bc19316d" "q-158192/selection/da05e5643888cb47132f1dc8584468f21e2fd1bf2ed5e84ab3310b8ef1c73e07"] :db/ensure [:answer-field/validate]} {:db/id "q-158192" :question/id #uuid "d9d58fba-c75c-5614-b1bd-365ad3c734ff" :question/math-academy-id "q-158192" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\frac{1}{\\sqrt{{x}^{2}-{y}^{2}}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}-{y}^{2}>0\\,⟹\\,{y}^{2}<{x}^{2}\\,⟹\\,-|x|<y<|x|\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,-|x|<y<|x|}.\n$$\n\nSince the inequality involves the $<$ sign, the curves are *not* part of the domain. Therefore, we draw the dashed lines $y=-|x|$ and $y=|x|,$ and shade the area *below* the curve $y=|x|,$ and *above* the curve $y=-|x|.$\n\nThe resulting domain is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/c06082999e1737b6e4ea5d32a3d8d77a271e3db49c38cc3725422bcb979676d0.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158192/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc"] :knowledge-point/questions ["q-158192"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158200/selection/9607a5d6cf66abc2bf356293dc69f145ee32575d3a5644e2d3e5384aac5c5428" :answer/id #uuid "c61c421c-3873-5d07-b0ea-1110dce3b968" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/3e55fa4f75253935fb3f372dd82612b241d1133aceaa51666fdb0513decba8ea.png" :db/ensure [:answer/validate]} {:db/id "q-158200/selection/b27dd74406b6abb81cd6666996a64391dc283a0f760018e5728770c77134f16a" :answer/id #uuid "a0e4e60f-7956-5cd7-8cbc-84afc76d0f41" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/04b8028809192321180e05f2e86c5e149b4870ddb0adea7e3191e2db33f12133.png" :db/ensure [:answer/validate]} {:db/id "q-158200/selection/8510db3de5cbb7b4062f76c3982a59ae190dcf90fd05f901842e386feec55169" :answer/id #uuid "34456c8f-a18e-5dba-ab84-533fbd13eb43" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/91094f3f8fc9b21724e4e6d0f33e2ec0dc18782b3cc0aa1d4b1e4226e4bb93bc.png" :db/ensure [:answer/validate]} {:db/id "q-158200/selection/e36cb246bb312fbf3624817583922ac58794edce2a5bffb732b94c0320e3185c" :answer/id #uuid "074e0d0a-7bb9-51a4-a8bd-740b0ef6e0aa" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/6431427a27685248942ae4ac998feeb8f38d210b63e7f4c429ce3a5bf9afd1e5.png" :db/ensure [:answer/validate]} {:db/id "q-158200/selection/476913c92d34aa5d88b74671754cf7189dd840e906387cc99ac41e3ee2e3118f" :answer/id #uuid "7aaba697-b9b3-5a5b-9e44-9cd624847bec" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/9f4dd7da9adf7ec5580f4e866fdf094e90e87425ce435feae6dc41488e6518bf.png" :db/ensure [:answer/validate]} {:db/id "q-158200/selection" :answer-field/id #uuid "cee0024d-a7ba-5b77-91a3-c4fe8e7e64ef" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158200/selection/9607a5d6cf66abc2bf356293dc69f145ee32575d3a5644e2d3e5384aac5c5428" :answer-field/choices ["q-158200/selection/9607a5d6cf66abc2bf356293dc69f145ee32575d3a5644e2d3e5384aac5c5428" "q-158200/selection/b27dd74406b6abb81cd6666996a64391dc283a0f760018e5728770c77134f16a" "q-158200/selection/8510db3de5cbb7b4062f76c3982a59ae190dcf90fd05f901842e386feec55169" "q-158200/selection/e36cb246bb312fbf3624817583922ac58794edce2a5bffb732b94c0320e3185c" "q-158200/selection/476913c92d34aa5d88b74671754cf7189dd840e906387cc99ac41e3ee2e3118f"] :db/ensure [:answer-field/validate]} {:db/id "q-158200" :question/id #uuid "ddc33dd3-a1a1-567c-a9d1-d5d15d54e87f" :question/math-academy-id "q-158200" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{y}{2-x}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2-x\\ne 0\\,⟹\\,x\\ne 2\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,x\\ne 2}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $x=2$ and shade *right* and *left* the line.\n\nThe resulting domain is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/2371c9724d66e0f7d74c45e173f9625a986615185c10d55c029976baa82d0877.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158200/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc"] :knowledge-point/questions ["q-158200"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-158438"] :question/problem "Find the domain of the function $f(x,y)={e}^{{x}^{2}-{y}^{2}}.$" :question/worked-solution "Notice that\n\n- ${x}^{2}-{y}^{2}$ is defined for all $x$ and $y,$ and\n\n- ${e}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${e}^{{x}^{2}-{y}^{2}}$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane." :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-158560/selection/ae27f6371017041fcc7826b797ce464b93c817209e1af770be6ab3b5f955a89a" :answer/id #uuid "e7768b79-9332-593f-8cbc-ba3ad8651064" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}\\ne 4}" :db/ensure [:answer/validate]} {:db/id "q-158560/selection/398fd3049ba72190a4e95875cc51ad0e39fcd1e8f9e21ebacedb3d0d2b5f474b" :answer/id #uuid "6f0510b2-a358-5907-a294-e57cc7d1d447" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne y,\\,{x}^{2}+{y}^{2}\\ne 4}" :db/ensure [:answer/validate]} {:db/id "q-158560/selection/3648a5eb4324045dc981117d983596435125f8aa9ef396a2fcb54f6c875c17e9" :answer/id #uuid "ed1143f2-94b8-5fb1-a06a-fc593036cfcd" :answer/type :answer.type/text :answer/value "The domain is the entire $xy-$plane" :db/ensure [:answer/validate]} {:db/id "q-158560/selection/42f41065f3d992b4789a9a46b6d4fe2753aa9214cdfb51773fab6350050a2521" :answer/id #uuid "d3cc6021-ea18-56fe-935b-d0c28f9ff165" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}>4}" :db/ensure [:answer/validate]} {:db/id "q-158560/selection/3b55ff01b0c22cacff2396786fabf340b05f318e785586b9062181fabf7e459f" :answer/id #uuid "0b6e35f2-8042-52ce-96ff-be8e45e40498" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne y,\\,{x}^{2}+{y}^{2}>4}" :db/ensure [:answer/validate]} {:db/id "q-158560/selection" :answer-field/id #uuid "5c9d11bc-2e97-526d-a330-5cd4be32b5be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158560/selection/42f41065f3d992b4789a9a46b6d4fe2753aa9214cdfb51773fab6350050a2521" :answer-field/choices ["q-158560/selection/ae27f6371017041fcc7826b797ce464b93c817209e1af770be6ab3b5f955a89a" "q-158560/selection/398fd3049ba72190a4e95875cc51ad0e39fcd1e8f9e21ebacedb3d0d2b5f474b" "q-158560/selection/3648a5eb4324045dc981117d983596435125f8aa9ef396a2fcb54f6c875c17e9" "q-158560/selection/42f41065f3d992b4789a9a46b6d4fe2753aa9214cdfb51773fab6350050a2521" "q-158560/selection/3b55ff01b0c22cacff2396786fabf340b05f318e785586b9062181fabf7e459f"] :db/ensure [:answer-field/validate]} {:db/id "q-158560" :question/id #uuid "ccec8805-3852-5a29-ba5b-8442cd07e534" :question/math-academy-id "q-158560" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{x-y}}{\\sqrt{{x}^{2}+{y}^{2}-4}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}x-y\\ge 0 \\\\ {x}^{2}+{y}^{2}-4>0\\end{aligned}\\,⟹\\,{\\begin{aligned}x\\ge y \\\\ {x}^{2}+{y}^{2}>4\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}>4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158560/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b"] :knowledge-point/questions ["q-158560"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158564/selection/03e9a247feaab3d5e5203cff144cfd0ec4d6a4a7ae961f38789997e7d7bf55cf" :answer/id #uuid "a1707e49-5c30-5f53-9b0e-7ad942dc80fe" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,{x}^{2}+{y}^{2}\\ge 2}" :db/ensure [:answer/validate]} {:db/id "q-158564/selection/3648a5eb4324045dc981117d983596435125f8aa9ef396a2fcb54f6c875c17e9" :answer/id #uuid "05ceb0d9-83ef-59a1-87ea-03d8e269bd50" :answer/type :answer.type/text :answer/value "The domain is the entire $xy-$plane" :db/ensure [:answer/validate]} {:db/id "q-158564/selection/2da01d96599b8fcccda1872c3f2171e2c012f34a8dfa59c64f75c4f32cb7696d" :answer/id #uuid "b17cf60f-f0b8-59a1-93c8-013e0cf1671d" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}" :db/ensure [:answer/validate]} {:db/id "q-158564/selection/3c6333995ddeeb66b9eca7673d367d6c8d87dc36dd190ef096d0dbda2c8f1971" :answer/id #uuid "793b73c6-b4ef-53a5-a598-0dd517c5d142" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\ge 2}" :db/ensure [:answer/validate]} {:db/id "q-158564/selection/5d112d3fa47a235f5e9602988919c110f070c2c091078f61a9489b69ec792758" :answer/id #uuid "e1b6aeef-aae9-5503-8a16-206e2acc5415" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,{x}^{2}+{y}^{2}<2}" :db/ensure [:answer/validate]} {:db/id "q-158564/selection" :answer-field/id #uuid "abcd7d5b-69cf-5028-aac8-9400e9aba929" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158564/selection/2da01d96599b8fcccda1872c3f2171e2c012f34a8dfa59c64f75c4f32cb7696d" :answer-field/choices ["q-158564/selection/03e9a247feaab3d5e5203cff144cfd0ec4d6a4a7ae961f38789997e7d7bf55cf" "q-158564/selection/3648a5eb4324045dc981117d983596435125f8aa9ef396a2fcb54f6c875c17e9" "q-158564/selection/2da01d96599b8fcccda1872c3f2171e2c012f34a8dfa59c64f75c4f32cb7696d" "q-158564/selection/3c6333995ddeeb66b9eca7673d367d6c8d87dc36dd190ef096d0dbda2c8f1971" "q-158564/selection/5d112d3fa47a235f5e9602988919c110f070c2c091078f61a9489b69ec792758"] :db/ensure [:answer-field/validate]} {:db/id "q-158564" :question/id #uuid "f75389ae-f11a-5175-b5a2-7807b9dbcd75" :question/math-academy-id "q-158564" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{2y}}{\\sqrt{2-{x}^{2}-{y}^{2}}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}2y\\ge 0 \\\\ 2-{x}^{2}-{y}^{2}>0\\end{aligned}\\,⟹\\,{\\begin{aligned}y\\ge 0 \\\\ {x}^{2}+{y}^{2}<2\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158564/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b"] :knowledge-point/questions ["q-158564"] :db/ensure [:knowledge-point/validate]}]
