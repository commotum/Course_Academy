pe {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/6727002ca8a7ee3451f09e239f49693ec6819053525c8fbe4ce5749fd8622254.png" :db/id #edb/ref 17592186380381} :answer-field/id #uuid "5ec9f70a-3be4-5eea-89f1-33008c5591d6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380378}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d9d58fba-c75c-5614-b1bd-365ad3c734ff" :question/math-academy-id "q-158192" :question/problem "Which of the following shaded regions corresponds to the domain of the function $f(x,y)=\\frac{1}{\\sqrt{{x}^{2}-{y}^{2}}}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression under the square root is non-negative, and\n\n- the expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{x}^{2}-{y}^{2}>0\\,⟹\\,{y}^{2}<{x}^{2}\\,⟹\\,-|x|<y<|x|\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,-|x|<y<|x|}.\n$$\n\nSince the inequality involves the $<$ sign, the curves are *not* part of the domain. Therefore, we draw the dashed lines $y=-|x|$ and $y=|x|,$ and shade the area *below* the curve $y=|x|,$ and *above* the curve $y=-|x|.$\n\nThe resulting domain is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/c06082999e1737b6e4ea5d32a3d8d77a271e3db49c38cc3725422bcb979676d0.png)"}] [{:db/id #edb/ref 17592186380384 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e4fd256-a726-523c-84dc-f62d4e2711cc" :knowledge-point/title "Sketching the Domain of a Multivariable Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7aaba697-b9b3-5a5b-9e44-9cd624847bec" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/9f4dd7da9adf7ec5580f4e866fdf094e90e87425ce435feae6dc41488e6518bf.png" :db/id #edb/ref 17592186380386} {:answer/id #uuid "34456c8f-a18e-5dba-ab84-533fbd13eb43" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/91094f3f8fc9b21724e4e6d0f33e2ec0dc18782b3cc0aa1d4b1e4226e4bb93bc.png" :db/id #edb/ref 17592186380387} {:answer/id #uuid "c61c421c-3873-5d07-b0ea-1110dce3b968" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/3e55fa4f75253935fb3f372dd82612b241d1133aceaa51666fdb0513decba8ea.png" :db/id #edb/ref 17592186380388} {:answer/id #uuid "a0e4e60f-7956-5cd7-8cbc-84afc76d0f41" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/04b8028809192321180e05f2e86c5e149b4870ddb0adea7e3191e2db33f12133.png" :db/id #edb/ref 17592186380389} {:answer/id #uuid "074e0d0a-7bb9-51a4-a8bd-740b0ef6e0aa" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/6431427a27685248942ae4ac998feeb8f38d210b63e7f4c429ce3a5bf9afd1e5.png" :db/id #edb/ref 17592186380390}] :answer-field/correct {:answer/id #uuid "c61c421c-3873-5d07-b0ea-1110dce3b968" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/3e55fa4f75253935fb3f372dd82612b241d1133aceaa51666fdb0513decba8ea.png" :db/id #edb/ref 17592186380388} :answer-field/id #uuid "cee0024d-a7ba-5b77-91a3-c4fe8e7e64ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380385}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ddc33dd3-a1a1-567c-a9d1-d5d15d54e87f" :question/math-academy-id "q-158200" :question/problem "Which of the following shaded regions corresponds to the domain of the function $g(x,y)=\\frac{y}{2-x}?$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following condition is satisfied:\n\n- The expression in the denominator is not equal to zero.\n\nAs a result, the points in the domain must satisfy the following inequality:\n\n$$\n2-x\\ne 0\\,⟹\\,x\\ne 2\n$$\n\nTherefore, the domain is\n\n$$\nD={(x,y)\\in {R}^{2}\\,:\\,x\\ne 2}.\n$$\n\nSince the expression involves the $\\ne $ sign, the line is *not* part of the domain. Therefore, we draw the dashed line $x=2$ and shade *right* and *left* the line.\n\nThe resulting domain is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074200/assets/2371c9724d66e0f7d74c45e173f9625a986615185c10d55c029976baa82d0877.png)"}] [{:db/id #edb/ref 17592186124726 :knowledge-point/_questions [{:knowledge-point/id #uuid "88f2bc84-03e8-5921-81e2-683a09195279" :knowledge-point/title "The Domain of a Function Containing Exponential, Logarithmic, and Trigonometric Functions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c64abb46-327a-580e-b60b-3e32163e266a" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y) ∈ R^{2}: x \\ne y}" :db/id #edb/ref 17592186121376} {:answer/id #uuid "0d9af059-e10b-571c-93de-33a0ef3eee0e" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y) ∈ R^{2}: x^{2} - y^{2} > 0}" :db/id #edb/ref 17592186121377} {:answer/id #uuid "5ca536fa-fb7b-5cf6-8d3d-8330d5104c68" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y) ∈ R^{2}: x^{2} - y^{2} > 1}" :db/id #edb/ref 17592186121378} {:answer/id #uuid "75b3d922-de21-5bba-88e5-c9a5929d4299" :answer/type {:db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186121379} {:answer/id #uuid "7ef3588c-7a06-57ae-b5a2-7a15c6e163a7" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y) ∈ R^{2}: x^{2} - y^{2} < 1}" :db/id #edb/ref 17592186121380}] :answer-field/correct {:answer/id #uuid "75b3d922-de21-5bba-88e5-c9a5929d4299" :answer/type {:db/ident :answer.type/text} :answer/value "The domain is the entire $xy$-plane" :db/id #edb/ref 17592186121379} :answer-field/id #uuid "36e08555-9a98-58e0-bd2e-ced7d916b543" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121375}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "80d6d429-d2f8-586a-b19e-c50b52dbc8e3" :question/math-academy-id "q-158438" :question/problem "Find the domain of the function $f(x,y)={e}^{{x}^{2}-{y}^{2}}.$" :question/worked-solution "Notice that\n\n- ${x}^{2}-{y}^{2}$ is defined for all $x$ and $y,$ and\n\n- ${e}^{g(x,y)}$ is defined if $g(x,y)$ is defined.\n\nAs a result, ${e}^{{x}^{2}-{y}^{2}}$ is defined for all values of $x$ and $y.$ This means that the domain of $f$ is the entire $xy$-plane."}] [{:db/id #edb/ref 17592186380391 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b" :knowledge-point/title "The Domain of a Function Involving Reciprocals and Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ed1143f2-94b8-5fb1-a06a-fc593036cfcd" :answer/type {:db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186380393} {:answer/id #uuid "6f0510b2-a358-5907-a294-e57cc7d1d447" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne y,\\,{x}^{2}+{y}^{2}\\ne 4}" :db/id #edb/ref 17592186380394} {:answer/id #uuid "0b6e35f2-8042-52ce-96ff-be8e45e40498" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ne y,\\,{x}^{2}+{y}^{2}>4}" :db/id #edb/ref 17592186380395} {:answer/id #uuid "d3cc6021-ea18-56fe-935b-d0c28f9ff165" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}>4}" :db/id #edb/ref 17592186380396} {:answer/id #uuid "e7768b79-9332-593f-8cbc-ba3ad8651064" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}\\ne 4}" :db/id #edb/ref 17592186380397}] :answer-field/correct {:answer/id #uuid "d3cc6021-ea18-56fe-935b-d0c28f9ff165" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}>4}" :db/id #edb/ref 17592186380396} :answer-field/id #uuid "5c9d11bc-2e97-526d-a330-5cd4be32b5be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380392}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ccec8805-3852-5a29-ba5b-8442cd07e534" :question/math-academy-id "q-158560" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{x-y}}{\\sqrt{{x}^{2}+{y}^{2}-4}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}x-y\\ge 0 \\\\ {x}^{2}+{y}^{2}-4>0\\end{aligned}\\,⟹\\,{\\begin{aligned}x\\ge y \\\\ {x}^{2}+{y}^{2}>4\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,x\\ge y,\\,{x}^{2}+{y}^{2}>4}.\n$$"}] [{:db/id #edb/ref 17592186380398 :knowledge-point/_questions [{:knowledge-point/id #uuid "0e593685-f5ca-5501-94bf-7cb4d49e935b" :knowledge-point/title "The Domain of a Function Involving Reciprocals and Radicals"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1707e49-5c30-5f53-9b0e-7ad942dc80fe" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,{x}^{2}+{y}^{2}\\ge 2}" :db/id #edb/ref 17592186380400} {:answer/id #uuid "b17cf60f-f0b8-59a1-93c8-013e0cf1671d" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}" :db/id #edb/ref 17592186380401} {:answer/id #uuid "05ceb0d9-83ef-59a1-87ea-03d8e269bd50" :answer/type {:db/ident :answer.type/text} :answer/value "The domain is the entire $xy-$plane" :db/id #edb/ref 17592186380402} {:answer/id #uuid "793b73c6-b4ef-53a5-a598-0dd517c5d142" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}\\ge 2}" :db/id #edb/ref 17592186380403} {:answer/id #uuid "e1b6aeef-aae9-5503-8a16-206e2acc5415" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ne 0,\\,{x}^{2}+{y}^{2}<2}" :db/id #edb/ref 17592186380404}] :answer-field/correct {:answer/id #uuid "b17cf60f-f0b8-59a1-93c8-013e0cf1671d" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}" :db/id #edb/ref 17592186380401} :answer-field/id #uuid "abcd7d5b-69cf-5028-aac8-9400e9aba929" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380399}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f75389ae-f11a-5175-b5a2-7807b9dbcd75" :question/math-academy-id "q-158564" :question/problem "Find the domain of the function $z=\\frac{\\sqrt{2y}}{\\sqrt{2-{x}^{2}-{y}^{2}}}.$" :question/worked-solution "The function is well-defined at all points $(x,y)$ for which the following conditions are satisfied:\n\n- The expression in the denominator is not equal to zero, and\n\n- the expression under the square root is non-negative.\n\nAs a result, the points in the domain must satisfy the following inequalities:\n\n$$\n{\\begin{aligned}2y\\ge 0 \\\\ 2-{x}^{2}-{y}^{2}>0\\end{aligned}\\,⟹\\,{\\begin{aligned}y\\ge 0 \\\\ {x}^{2}+{y}^{2}<2\\end{aligned}\n$$\n\nTherefore, the domain is\n\n$$\n{(x,y)\\in {R}^{2}\\,:\\,y\\ge 0,\\,{x}^{2}+{y}^{2}<2}.\n$$"}]}
