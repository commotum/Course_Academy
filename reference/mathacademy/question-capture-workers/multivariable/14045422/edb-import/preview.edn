nd{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}3 \\\\ -2\\end{aligned}]}_{⏟}}_{b}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{6\\cdot (-5)-(-9)\\cdot 3}[\\begin{aligned}6 & 9 \\\\ -3 & -5\\end{aligned}] \\\\  & =\\frac{1}{-3}[\\begin{aligned}6 & 9 \\\\ -3 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}3 \\\\ -2\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{aligned}][\\begin{aligned}3 \\\\ -2\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}0 \\\\ -\\frac{1}{3}\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -3 \\\\ 1 & \\frac{5}{3}\\end{aligned}][\\begin{aligned}x \\\\ y\\end{aligned}]+[\\begin{aligned}0 \\\\ \\frac{1}{3}\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\na+b+c=-2+\\frac{5}{3}+\\frac{1}{3}=0.\n$$" 13194139534998 true] [17592186325676 1000 #edb/ref 17592186325677 13194139534998 true] [17592186325676 1000 #edb/ref 17592186325678 13194139534998 true] [17592186325676 1000 #edb/ref 17592186325679 13194139534998 true] [17592186325676 1000 #edb/ref 17592186325680 13194139534998 true] [17592186325676 1000 #edb/ref 17592186325681 13194139534998 true] [17592186325676 1040 #edb/ref 17592186045450 13194139534998 true] [17592186325676 1041 "selection" 13194139534998 true] [17592186325676 1104 #edb/ref 17592186325680 13194139534998 true] [17592186325676 1110 #uuid "2bb3df9f-9bef-5c0a-a068-b10974aff81e" 13194139534998 true] [175921