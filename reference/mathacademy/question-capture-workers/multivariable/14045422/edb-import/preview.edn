\ u+4v+6\\end{aligned}] \\\\  & =[\\begin{aligned}-2v \\\\ u+4v\\end{aligned}]+[\\begin{aligned}-4 \\\\ 6\\end{aligned}] \\\\  & ={{[\\begin{aligned}0 & -2 \\\\ 1 & 4\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}-4 \\\\ 6\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{4\\cdot 0-(-2)\\cdot 1}[\\begin{aligned}4 & 2 \\\\ -1 & 0\\end{aligned}] \\\\  & =\\frac{1}{2}[\\begin{aligned}4 & 2 \\\\ -1 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 \\\\ -\\frac{1}{2} & 0\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}2 & 1 \\\\ -\\frac{1}{2} & 0\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}-4 \\\\ 6\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}2 & 1 \\\\ -\\frac{1}{2} & 0\\end{aligned}][\\begin{aligned}x+4 \\\\ y-6\\end{aligned}] \\\\  & =[\\begin{aligned}2\\cdot (x+4)+1\\cdot (y-6) \\\\ (-\\frac{1}{2})\\cdot (x+4)+0\\cdot (y-6)\\end{aligned}] \\\\  & =[\\begin{aligned}2x+y+2 \\\\ -\\frac{1}{2}x-2\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=2x+y+2,\\,v=(-\\frac{1}{2})x+0y-2.\n$$\n\nTherefore, we have\n\n$$\na+b+c=2+(-\\frac{1}{2})+0=\\frac{3}{2}.\n$$" 13194139534998 true] [17592186325690 1000 #edb/ref 17592186325691 13194139534998 true] [17592186325690 1000 #edb/ref 17592186325692 13194139534998 true] [17592186325690 1000 #edb/ref 17592186325693 13194139534998 true] [17592186325690 1000 #edb/ref 17592186325694 13194139534998 true] [17592186325690 1000 #edb/ref 17592186325695 13194139534998 true] [17592186325690 1040 #edb/ref 17592186045450 13194139534998 true] [17592186325690 1041 "selection" 13194139534998 true] [1759218632569