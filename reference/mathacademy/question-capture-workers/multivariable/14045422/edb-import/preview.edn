\\\ 9u-4v+3\\end{aligned}] \\\\  & =[\\begin{aligned}2u-v \\\\ 9u-4v\\end{aligned}]+[\\begin{aligned}1 \\\\ 3\\end{aligned}] \\\\  & ={{[\\begin{aligned}2 & -1 \\\\ 9 & -4\\end{aligned}]}_{⏟}}_{A}\\cdot {{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u}+{{[\\begin{aligned}1 \\\\ 3\\end{aligned}]}_{⏟}}_{b}.\\end{aligned}\n$$\n\nNext, we calculate the inverse of $A:$\n\n$$\n\\begin{aligned}{A}^{-1} & =\\frac{1}{-4\\cdot 2-(-1)\\cdot 9}[\\begin{aligned}-4 & 1 \\\\ -9 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 1 \\\\ -9 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the inverse transformation ${T}^{-1}$ is\n\n$$\n\\begin{aligned}{{[\\begin{aligned}u \\\\ v\\end{aligned}]}_{⏟}}_{u} & ={{[\\begin{aligned}-4 & 1 \\\\ -9 & 2\\end{aligned}]}_{⏟}}_{{A}^{-1}}\\cdot ({{[\\begin{aligned}x \\\\ y\\end{aligned}]}_{⏟}}_{x}-{{[\\begin{aligned}1 \\\\ 3\\end{aligned}]}_{⏟}}_{b}) \\\\  & =[\\begin{aligned}-4 & 1 \\\\ -9 & 2\\end{aligned}][\\begin{aligned}x-1 \\\\ y-3\\end{aligned}] \\\\  & =[\\begin{aligned}-4\\cdot (x-1)+1\\cdot (y-3) \\\\ -9\\cdot (x-1)+2\\cdot (y-3)\\end{aligned}] \\\\  & =[\\begin{aligned}y-4x+1 \\\\ 2y-9x+3\\end{aligned}]\\end{aligned}\n$$\n\nEquating the corresponding components, the inverse transformation ${T}^{-1}$ in coordinate form is\n\n$$\nu=y-4x+1,\\,v=2y+(-9)x+3.\n$$\n\nTherefore, we have\n\n$$\na+b+c=1+2+(-9)=-6.\n$$" 13194139534998 true] [17592186325683 1000 #edb/ref 17592186325684 13194139534998 true] [17592186325683 1000 #edb/ref 17592186325685 13194139534998 true] [17592186325683 1000 #edb/ref 17592186325686 13194139534998 true] [17592186325683 1000 #edb/ref 17592186325687 13194139534998 true] [17592186325683 1000 #edb/ref 17592186325688 13194139534998 true] [17592186325683 1040 #edb/ref 17592186045450 13194139534998 true] [17592186325683 1041 "selection" 13194139534998 true] [17592186325683 1104 #edb/ref 17592186325688 13194139534998 true] [17592186325683 1110 #uuid "b6643577-fa44-52f8-9cdb-dcd7c980bb11" 13194139534998 true] [175921863