estion-capture-workers/multivariable/14053940/state.json" "file_sha256" "3ba070c31df4aea7547970c11967ad40de40a2802a40ff487f43c7e94a60c13c"} {"question" "q-86899" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/activity-metadata.json" "file_sha256" "1dd6b5880f7162c5e89d5d9a910fa55ae62fc84f22fc6ebcef9e0368d226dae3"} {"question" "q-86899" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/state.json" "file_sha256" "3ba070c31df4aea7547970c11967ad40de40a2802a40ff487f43c7e94a60c13c"} {"question" "q-86899" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/state.json" "file_sha256" "3ba070c31df4aea7547970c11967ad40de40a2802a40ff487f43c7e94a60c13c"} {"question" "q-86899" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and II only"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/state.json" "file_sha256" "3ba070c31df4aea7547970c11967ad40de40a2802a40ff487f43c7e94a60c13c"} {"question" "q-129904" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/assets/f8cb975b622bfe420d9418587293e83de60c297019f15e1b379bc118e079d35d.png)\n\nConsider the region $D$ shown above. If $R=[-1,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}(3{x}^{2}-5{y}^{4})\