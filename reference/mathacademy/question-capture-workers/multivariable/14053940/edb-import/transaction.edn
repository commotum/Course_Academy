4d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-86899" :question/id #uuid "da262874-2a96-5dfa-ad3e-eff09851e875" :question/math-academy-id "q-86899" :question/problem "Let $D$ be a finite region enclosed by the curves $y=-|x|+2$ and $y=|x|.$ If $R=[-1,1]\\times [0,2],$ and\n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\n- ${\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\notin D\\end{aligned}$\n- ${\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in D \\\\ 0, & (x,y)\\in R∖D\\end{aligned}$\n- ${\\begin{aligned}{x}^{5}-{y}^{2}, & (x,y)\\in R \\\\ 0, & (x,y)\\notin R\\end{aligned}$" :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/assets/f3ffc82025f80c357c06e28fcb091c701d53d84821bebd9d2886cf4972b77028.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal ${x}^{5}-{y}^{2}$ on $D$ and to be equal $0$ outside $D,$ we obtain  \n\n$$\n{∬}_{D}({x}^{5}-{y}^{2})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\n \n\nWith that in mind, let's examine each of the given functions.\n\n- Functions I and II equal ${x}^{5}-{y}^{2}$ on $D$ and equal $0$ outside $D.$\n\n- We cannot use function III. The function is not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(1,0)\\in R\\,∖\\,D,$ but the function is nonzero at this point.\n\nTherefore, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86899/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3"] :knowledge-point/questions ["q-86899"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129904/selection/b0d571b4f8c9a519d4151da0e7137238f1308365223597beae87aa81fb8d20bd" :answer/id #uuid "179d7cb6-d4e9-51dc-9921-a92595ffa1f5" :answer/type :answer.type/text :answer/value "None of these listed" :db/ensure [:answer/validate]} {:db/id "q-129904/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "f30042b6-d027-598e-8daf-9f8106edd8b2" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-129904/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c3113fba-5c16-5dd7-a613-35be2b9d49b4" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-129904/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "92931347-0953-5c8a-b2d0-c2f2a8b8f4ea" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-129904/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "e4ea3495-8b7d-5f17-8db3-291ea1500446" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-129904/selection" :answer-field/id #uuid "b6979997-0ef2-5529-aa56-79a8a57c5a74" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129904/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-129904/selection/b0d571b4f8c9a519d4151da0e7137238f1308365223597beae87aa81fb8d20bd" "q-129904/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-129904/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-129904/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-129904/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9"] :db/ensure [:answer-field/validate]} {:db/id "q-129904" :question/id #uuid "f4630a49-9f84-56b0-b38f-98dc1ca8cec7" :question/math-academy-id "q-129904" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/assets/f8cb975b622bfe420d9418587293e83de60c297019f15e1b379bc118e079d35d.png)\n\nConsider the region $D$ shown above. If $R=[-1,2]\\times [-2,2],$ and\n\n$$\n{∬}_{D}(3{x}^{2}-5{y}^{4})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A,\n$$\n\nwhich of the following could be the definition of $f(x,y)?$\n\n- ${\\begin{aligned}3{x}^{2}-5{y}^{4}, & (x,y)\\in R∖D \\\\ 0, & (x,y)\\in D∖R\\end{aligned}$\n- ${\\begin{aligned}0, & (x,y)\\in R∖D \\\\ 3{x}^{2}-5{y}^{4}, & (x,y)\\in D\\end{aligned}$\n- ${\\begin{aligned}0, & (x,y)\\in R\\cap D \\\\ 3{x}^{2}-5{y}^{4}, & (x,y)\\in R∖D\\end{aligned}$" :question/worked-solution "First, let's draw our region $D$ and rectangle $R:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14053940/assets/8944afb608465e49c7ae253f8e2518aa3d43b1c6e121dd91178ca1a67116a508.png)\n\nNotice that the rectangle $R$ contains the region $D$ completely. \n\nNow, if we define $f(x,y)$ to be equal $3{x}^{2}-5{y}^{4}$ on $D$ and to be equal $0$ outside $D,$ we obtain\n\n$$\n{∬}_{D}(3{x}^{2}-5{y}^{4})\\,\\text{d}A={∬}_{R}f(x,y)\\,\\text{d}A.\n$$\n\nWith that in mind, let's examine each of the given functions.\n\n- We cannot use functions I and III. Both of these functions are not identically zero for all points in $R\\,∖D.$ For example, $(x,y)=(2,2)\\in R\\,∖\\,D,$ but the functions are nonzero at this point.\n\n- Function II equals $3{x}^{2}-5{y}^{4}$ on $D$ and equals $0$ outside $D.$\n\nTherefore, the correct answer is \"II only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129904/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0ad76e6b-acef-5221-8852-71dc42625bf3"] :knowledge-point/questions ["q-129904"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129906/selection/df67a18079e3b7b726c109ae1bf07ae161d9f