uestion-import-2026-10-04/format-audit/repairs.json" "file_sha256" "0328005daa91919dd8bb81fd729228440954ec812e808e91c99da77efc57aee9" "transaction" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/transaction.edn" "transaction_sha256" "571ee7e4f8997fdfae74f800edd84d0efce760607b5043aa85a8d9d81962095f" "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/verification.json" "basis" 653} {"question" "q-113941" "field" "answer" "attribute" "answer/value" "value" [:answer.type/math "-1\\left({lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]\\right)"] "category" "local_authored" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/repairs.json" "file_sha256" "0328005daa91919dd8bb81fd729228440954ec812e808e91c99da77efc57aee9" "transaction" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/transaction.edn" "transaction_sha256" "571ee7e4f8997fdfae74f800edd84d0efce760607b5043aa85a8d9d81962095f" "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/verification.json" "basis" 653} {"question" "q-113941" "field" "answer" "attribute" "answer/value" "value" [:answer.type/math "3\\left({lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[\\sqrt{4+\\frac{5k}{n}}\\cdot \\frac{5}{n}]\\right)"] "category" "local_authored" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/repairs.json" "file_sha256" "0328005daa91919dd8bb81fd729228440954ec812e808e91c99da77efc57aee9" "transaction" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/transaction.edn" "transaction_sha256" "571ee7e4f8997fdfae74f800edd84d0efce760607b5043aa85a8d9d81962095f" "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/format-audit/database-repair/verification.json" "basis" 653} {"question" "q-315830" "field" nil "attribute" "question/problem" "value" "What is ${\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x$ expressed as the limit of a right Riemann sum?\n\n*Hint: Write down the missing expression in terms of $i$ and $n.$*\n\n${\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[9($\n{{field-1}}\n$)^{\\,3}\\cdot \\frac{3}{n}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-315830" "field" nil "attribute" "question/worked-solution" "value" "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x,\n$$\n\nthe function is $f(x)=9{x}^{3},$ the lower bound is $a=1$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-1}{n}=\\frac{3}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}9{x}^{3}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(1+i\\cdot \\frac{3}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(1+\\frac{3i}{n})\\cdot \\frac{3}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[9{(1+\\frac{3i}{n})}^{\\,3}\\cdot \\frac{3}{n}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-315830" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/activity-metadata.json" "file_sha256" "d47e30b47213e8516c2ac73ad6427c03ed276dd5fd7384c6f5410bae841e37c2" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-315830" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-315830" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1+\\frac{3i}{n}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-346180" "field" nil "attribute" "question/problem" "value" "Find the function $f(x)$ and the value of $b,$ given that\n\n$$\n{\\int }_{2}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[({2}^{\\,2+3k/n}+1)\\cdot \\frac{3}{n}].\n$$\n\n$\\,f(x)=$\n{{field-1}} $\\,$ and \n$\\,b=$\n{{field-2}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-346180" "field" nil "attribute" "question/worked-solution" "value" "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\cdot Δx\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{k}=a+kΔx.$\n\nNotice that we're given that the lower limit $a=2.$ \n\nComparing the given summation with the general expression above, we see that $Δx=\\frac{3}{n}.$ Therefore, \n\n$$\n\\frac{3}{n}=\\frac{b-2}{n}\\,⟹\\,b=5.\n$$\n\nConsequently, ${x}_{k}=2+\\frac{3k}{n}$ and $f({x}_{k})={2}^{\\,{x}_{k}}+1.$\n\nHence,\n\n$$\n{\\int }_{2}^{5}({2}^{x}+1)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[({2}^{\\,2+3k/n}+1)\\cdot \\frac{3}{n}].\n$$\n\nTherefore, the correct answer is \n\n$$\nf(x)={2}^{x}+1\\,\\text{and}\\,b=5.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-346180" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/activity-metadata.json" "file_sha256" "d47e30b47213e8516c2ac73ad6427c03ed276dd5fd7384c6f5410bae841e37c2" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-346180" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"} {"question" "q-346180" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/state.json" "file_sha256" "b093627cde4427ba2ae498d0f24ea7f6691462b800413c63a4f9d28100d83d44" "basis" 502 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13947210/edb-import/verification.json"}] "sources" [{"question" "q-30382" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/assets/e8a9dfb3ff189e96089c73ead8a3b44f04aa1684894c44203afb8884ad75c9e1.png)\n\nFor the function $f(x)=-{x}^{3}-{x}^{2}+2$ shown above, what is the expression for the area $A$ as a definite integral?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/state.json" "file_sha256" "71e4e23ce6ffc25942b10962382cc682087d08e505f08efd8deda2bb5d09496f"} {"question" "q-30382" "field" nil "attribute" "question/worked-solution" "value" "We want to express the area $A$ between the function $f(x)=-{x}^{3}-{x}^{2}+2$ and the $x$-axis, between $x=-1.5$ and $x=0.5.$\n\nThis can be expressed as the definite integral of $f(x)=-{x}^{3}-{x}^{2}+2$ between the lower limit $x=-1.5$ and the upper limit $x=0.5,$ as follows:\n\n$$\nA={\\int }_{-1.5}^{0.5}(-{x}^{3}-{x}^{2}+2)\\,\\text{d}x\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/state.json" "file_sha256" "71e4e23ce6ffc25942b10962382cc682087d08e505f08efd8deda2bb5d09496f"} {"question" "q-30382" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/activity-metadata.json" "file_sha256" "8d6317e4b24f953776249e6db2b9d49942736e1c4f5f9a98ef66656a5d14914f"} {"question" "q-30382" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/state.json" "file_sha256" "71e4e23ce6ffc25942b10962382cc682087d08e505f08efd8deda2bb5d09496f"} {"question" "q-30382" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "A={\\int }_{-1.5}^{0.5}(-{x}^{3}-{x}^{2})^{2}\\,\\text{d}x"] ["math" "A={\\int }_{-1.5}^{0.5}(-{x}^{3}-{x}^{2}+2)\\,\\text{d}x"] ["math" "A={\\int }_{0}^{-0.5}(-{x}^{3}-{x}^{2}+2)\\,\\text{d}x"] ["math" "A={\\int }_{1.5}^{3}(-{x}^{3}+2)^{2}\\,\\text{d}x"] ["math" "A={\\int }_{1.5}^{3}(-{x}^{3}-{x}^{2}+2)\\,\\text{d}x"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/state.json" "file_sha256" "71e4e23ce6ffc25942b10962382cc682087d08e505f08efd8deda2bb5d09496f"} {"question" "q-30382" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "A={\\int }_{-1.5}^{0.5}(-{x}^{3}-{x}^{2}+2)\\,\\text{d}x"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/state.json" "file_sha256" "71e4e23ce6ffc25942b10962382cc682087d08e505f08efd8de