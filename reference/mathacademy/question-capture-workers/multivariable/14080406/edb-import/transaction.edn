5ada3481cd589b60a43"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-113927"] :question/answer-fields ["q-113927/selection/ma-v1/611bfad0402c9cb0b6a9b0bb817b16a8da82d8cb0f4b8ac75ed243a61769ebed"] :db/ensure [:question/validate]} {:db/id "q-49192/selection/d0c7376da1d0548328cfbf34bde364643db377debc994ed4a2b8169fc621fa3f" :answer/id #uuid "b9213ea9-2606-52fc-9d8f-fdab15fe34b7" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[5{(1+\\frac{3i}{n})}^{2}\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-49192/selection/9209b6c66ed41b0a930fb3d9ba2645c18e22c96681ce327deba5ec5a8f935853" :answer/id #uuid "e9937bec-3f26-5e9b-a2ee-9fbc4176d202" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[5{(4+\\frac{i}{n})}^{2}\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-49192/selection/507d719fbf1ad82afe2eb6c52b8fc2f012c97369f9fe57cd8d2888750e169b7d" :answer/id #uuid "02c1dece-5c66-5afe-a533-5b49db99ee84" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[5{(3+\\frac{i}{n})}^{2}\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-49192/selection/a956f1f9bca3077d9194b1583378004165c93886e93b038c1446bea6d74d0025" :answer/id #uuid "0aa90623-787c-52b3-a2dd-9fc79760e879" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[5{(3+\\frac{3i}{n})}^{2}\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-49192/selection/1761e89ddeaa7f8a87e3b66028f33664f6e9b00475422c003fb0f8ffeaef3872" :answer/id #uuid "f30f4f98-5972-58bb-9e57-181795cfd229" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[5{(4+\\frac{i}{n})}^{2}\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-49192/selection" :answer-field/id #uuid "95c3d312-976d-5e5c-9edc-72a5cb0d7b96" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49192/selection/507d719fbf1ad82afe2eb6c52b8fc2f012c97369f9fe57cd8d2888750e169b7d" :answer-field/choices ["q-49192/selection/d0c7376da1d0548328cfbf34bde364643db377debc994ed4a2b8169fc621fa3f" "q-49192/selection/9209b6c66ed41b0a930fb3d9ba2645c18e22c96681ce327deba5ec5a8f935853" "q-49192/selection/507d719fbf1ad82afe2eb6c52b8fc2f012c97369f9fe57cd8d2888750e169b7d" "q-49192/selection/a956f1f9bca3077d9194b1583378004165c93886e93b038c1446bea6d74d0025" "q-49192/selection/1761e89ddeaa7f8a87e3b66028f33664f6e9b00475422c003fb0f8ffeaef3872"] :db/ensure [:answer-field/validate]} {:db/id "q-49192" :question/id #uuid "c93ae6fa-f0fd-57d0-8eab-5d532d391d7c" :question/math-academy-id "q-49192" :question/problem "What is ${\\int }_{3}^{4}5{x}^{2}\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx,\n$$\n\nwhere ${x}_{i}=a+iΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{3}^{4}5{x}^{2}\\text{d}x,\n$$\n\nthe function is $f(x)=5{x}^{2},$ the lower bound is $a=3$ and the upper bound is $b=4.$ So, we have\n\n$$\nΔx=\\frac{4-3}{n}=\\frac{1}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}5{x}^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(3+i\\cdot \\frac{1}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[f(3+\\frac{i}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=1}^{n}[5{(3+\\frac{i}{n})}^{2}\\cdot \\frac{1}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49192/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2"] :knowledge-point/questions ["q-49192"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73182/selection/4aa5e6a5cbc99332bbcc47c0e33e08c1d8cd3ced743c4716b1c28a1ee01afe36" :answer/id #uuid "cf607ef3-8bba-5406-b207-b748c3ea3a16" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2+\\frac{4j}{n}}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73182/selection/f667d3bf76c7150458bc0dbe7f1e7724199f7fcb6f09ba85c95c75a32e4e3f70" :answer/id #uuid "c4923bd4-2df6-587a-8263-fafc6b925ffc" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(2+\\frac{4j}{n})\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73182/selection/2872ea555725b10199b49ead0a2f8bd23f3a43935ee3f3e7f379bdaa543031cd" :answer/id #uuid "ebc999a6-0cae-5013-8181-8ade8e22b109" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(2+\\frac{4j}{n})\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73182/selection/dc3b56e99cad5a666555182aff1096eeb3f20dda667f87c1650d206e2e8010ba" :answer/id #uuid "70c723d0-7cd6-556a-8777-0917dedfb921" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[2\\sqrt{6+\\frac{4j}{n}}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73182/selection/f298865e3332a7ce0477be9dc7ecb878269b3c245b8a91e47b9359fb273da10a" :answer/id #uuid "8f04aae0-f14a-5335-aed2-582cb2f8c771" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(6+\\frac{4j}{n})\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73182/selection" :answer-field/id #uuid "a080a941-b22b-54d0-acd8-c8325ea1d73e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73182/selection/2872ea555725b10199b49ead0a2f8bd23f3a43935ee3f3e7f379bdaa543031cd" :answer-field/choices ["q-73182/selection/4aa5e6a5cbc99332bbcc47c0e33e08c1d8cd3ced743c4716b1c28a1ee01afe36" "q-73182/selection/f667d3bf76c7150458bc0dbe7f1e7724199f7fcb6f09ba85c95c75a32e4e3f70" "q-73182/selection/2872ea555725b10199b49ead0a2f8bd23f3a43935ee3f3e7f379bdaa543031cd" "q-73182/selection/dc3b56e99cad5a666555182aff1096eeb3f20dda667f87c1650d206e2e8010ba" "q-73182/selection/f298865e3332a7ce0477be9dc7ecb878269b3c245b8a91e47b9359fb273da10a"] :db/ensure [:answer-field/validate]} {:db/id "q-73182" :question/id #uuid "d76772d8-d5b1-522d-b84a-c52ac6da6060" :question/math-academy-id "q-73182" :question/problem "What is ${\\int }_{2}^{6}\\sqrt{2}\\operatorname{ln}⁡x\\,\\text{d}x$ expressed as the limit of a right Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}f({x}_{j})\\cdot Δx,\n$$\n\nwhere ${x}_{j}=a+jΔx$ and $Δx=\\frac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n{\\int }_{2}^{6}\\sqrt{2}\\operatorname{ln}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\sqrt{2}\\operatorname{ln}⁡x,$ the lower bound is $a=2$ and the upper bound is $b=6.$ So, we have\n\n$$\nΔx=\\frac{6-2}{n}=\\frac{4}{n}.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{2}^{6}\\sqrt{2}\\operatorname{ln}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}f({x}_{j})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[f(2+j\\cdot \\frac{4}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[f(2+\\frac{4j}{n})\\cdot \\frac{4}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{j=1}^{n}[\\sqrt{2}\\operatorname{ln}⁡(2+\\frac{4j}{n})\\cdot \\frac{4}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73182/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "29b136d3-69bc-51ef-a262-dbee8af377d2"] :knowledge-point/questions ["q-73182"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-405"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/assets/f02616ea8f44865a727bec3affe596503dbadacafb113acad6e5f755218b4ff5.png)\n\nFor the function $y = -2x^3+2$ shown above, write down an expression for the area $\\mathcal{A}$ as a definite integral." :question/worked-solution "We want to express the area $\\mathcal{A}$ between the function $f(x) = -2x^3+2$ and the $x$-axis, between $x=0$ and $x=1.$\n\nThis can be expressed as the definite integral of $f(x) = -2x^3+2$ between the lower limit $x=0$ and the upper limit $x=1,$ as follows:\n\n$$\n\\displaystyle \\mathcal{A} = \\int_0^1 (-2x^3+2)\\,\\textrm{d}x\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-406"] :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n\\int_a^b f(x)\\textrm{d}x = \\lim_{n\\rightarrow\\infty}\\sum_{k=0}^{n-1} f(x_k)\\Delta x,\n$$\n\n    \n\nwhere $\\Delta x = \\dfrac{b-a}{n}$ and $x_k = a + k\\Delta x.$\n\nIn the definite integral\n\n$$\n\\displaystyle \\int_1^3(4-x)\\,\\textrm{d}x,\n$$\n\nthe function is $f(x) = 4-x,$ the lower bound is $a=1,$ and the upper bound is $b=3.$ So, we have\n\n$$\n\\Delta x = \\dfrac{3-1}{n} = \\dfrac 2 n,\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}(4-x)\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}f({x}_{k})\\,Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[f(1+k\\cdot \\frac{2}{n})\\,\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[f(1+\\frac{2k}{n})\\,\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[(4-(1+\\frac{2k}{n}))\\,\\cdot \\frac{2}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=0}^{n-1}[(3-\\frac{2k}{n})\\,\\cdot \\frac{2}{n}].\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-407"] :question/problem "Find the function $f(x)$ and the value of $b,$ given that $\\displaystyle \\int_{3}^b f(x)\\, \\textrm d x =\\lim_{n\\to\\infty}\\sum_{k=0}^{n-1}\\left[\\left(3 + \\dfrac{5k}{n}\\right)^2\\cdot \\dfrac 5 n\\right].$" :question/worked-solution "A definite integral can be defined as the limit of a left Riemann sum as follows:\n\n$$\n\\int_a^b f(x) \\, \\textrm d x = \\lim_{n\\to\\infty}\\sum_{k=0}^{n-1}f\\left(x_k\\right)\\cdot \\Delta x\n$$\n\nwhere $\\Delta x = \\dfrac{b-a}{n}$ and $x_k = a + k\\Delta x.$\n\nNotice that we're given that the lower limit $a = 3.$ \n\nComparing the given summation with the general expression above, we see that $\\Delta x = \\dfrac{5}{n}.$ Therefore, \n\n$$\n\\dfrac{5}{n} = \\dfrac{b-3}{n} \\quad \\Longrightarrow \\quad b = 8.\n$$\n\nConsequently, $x_k = 3 + \\dfrac{5k}{n}$ and $f(x_k) = x_{k}^2.$\n\nHence,\n\n$$\n\\int_{3}^{8} x^2 \\, \\textrm d x =\\lim_{n\\to\\infty}\\sum_{k=0}^{n-1}\\left[\\left(3 + \\dfrac{5k}{n}\\right)^2\\cdot \\dfrac 5 n\\right].\n$$\n\nTherefore, the correct answer is $f(x)= x^2$ and $b = 8.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-408"] :question/worked-solution "The definite integral can be defined in terms of the limit of a right Riemann sum as\n\n$$\n\\int_a^b f(x)\\,\\textrm d x = \\lim_{n\\to\\infty}\\sum_{k=1}^n f(x_k)\\cdot\\Delta x,\n$$\n\nwhere $x_k = a + k\\Delta x$ and $\\Delta x =  \\dfrac{b-a}{n}.$\n\nIn the definite integral\n\n$$\n\\displaystyle \\int_1^2 x^2\\,\\textrm d x,\n$$\n\nthe function is $f(x) = x^2,$ the lower bound is $a=1$ and the upper bound is $b=2.$ So, we have\n\n$$\n\\Delta x = \\dfrac{2-1}{n} = \\dfrac 1 n.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}{x}^{2}\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}f({x}_{k})\\,Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(1+k\\cdot \\frac{1}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[f(1+\\frac{k}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{k=1}^{n}[{(1+\\frac{k}{n})}^{2}\\,\\cdot \\frac{1}{n}].\\end{aligned}\n$$" :db/ensure [:question/validate]}]
