d0db01006ebe4bd76a8b6882b4b1e92891dbf0918e0" "q-30382/selection/8f82b0fd9dee4d1134009593e87fc99fda943a7962cba3d6c5e8d9058f2e459e"] :db/ensure [:answer-field/validate]} {:db/id "q-30382" :question/id #uuid "034b151a-76c3-50b5-8c7c-2a70b048d143" :question/math-academy-id "q-30382" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/assets/e8a9dfb3ff189e96089c73ead8a3b44f04aa1684894c44203afb8884ad75c9e1.png)\n\nFor the function $f(x)=-{x}^{3}-{x}^{2}+2$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)=-{x}^{3}-{x}^{2}+2$ and the $x$-axis, between $x=-1.5$ and $x=0.5.$\n\nThis can be expressed as the definite integral of $f(x)=-{x}^{3}-{x}^{2}+2$ between the lower limit $x=-1.5$ and the upper limit $x=0.5,$ as follows:\n\n$$\nA={\\int }_{-1.5}^{0.5}(-{x}^{3}-{x}^{2}+2)\\,\\text{d}x\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-30382/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9"] :knowledge-point/questions ["q-30382"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-30265"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/assets/04e636bd831dbfd45ebed1bc8928c4b68d479a1147b98474c667b2aee7a5efc1.png)\n\nFor the function $f(x)=-{x}^{3}+2x+1$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)=-{x}^{3}+2x+1$ and the $x$-axis, between $x=0$ and $x=1.$\n\nThis can be expressed as the definite integral of $f(x)=-{x}^{3}+2x+1$ between the lower limit $x=0$ and the upper limit $x=1,$ as follows:\n\n$$\nA={\\int }_{0}^{1}(-{x}^{3}+2x+1)\\,\\text{d}x\n$$" :db/ensure [:question/validate]} {:db/id "q-30271/selection/b13d21a3aba48e17813364ca0d96f884acefb3df354d9eb9aaccfbdd697fe1b0" :answer/id #uuid "dbd3d529-ead0-58d6-bf11-180c60790ba6" :answer/type :answer.type/math :answer/value "A={\\int }_{-0.5}^{1}(-{x}^{2}+x+2)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-30271/selection/48b78fd07d888c5bf9a5cdd7af0f06b9e0e32f70bb5e8f4ea6297555453d0077" :answer/id #uuid "3c2f8f2d-55c1-5e8e-be7e-baa5b9656513" :answer/type :answer.type/math :answer/value "A=-{\\int }_{-0.5}^{0.5}({x}^{3}+x-2)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-30271/selection/7571d7d8a7a7e21b4f714ef787f9c426dc6d038c22ccc420ea6c118c95fbd871" :answer/id #uuid "7f388d25-c2e5-50e1-8196-d0aadecf6d50" :answer/type :answer.type/math :answer/value "A={\\int }_{0.5}^{1}({x}^{2}+x+2)^{2}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-30271/selection/2d69b2fdb029de0a1e3b16943f818e2948c422837d16f6f455acdf997d96d37f" :answer/id #uuid "7f3beace-b065-547b-98f1-d8a6ca4ff881" :answer/type :answer.type/math :answer/value "A={\\int }_{-1.5}^{1}(-{x}^{2}-x+2)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-30271/selection/8b2fd997185b3b2b9759f8cd04915b055beb2c38e9ab333d569d00558b607b4a" :answer/id #uuid "e773d4ee-8d7f-5ea7-a7e4-d1b49c216804" :answer/type :answer.type/math :answer/value "A={\\int }_{-1}^{1}(-{x}^{2}+x+2)\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-30271/selection" :answer-field/id #uuid "519eb5c7-65f4-5829-b36d-d7b8babf2c73" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-30271/selection/b13d21a3aba48e17813364ca0d96f884acefb3df354d9eb9aaccfbdd697fe1b0" :answer-field/choices ["q-30271/selection/b13d21a3aba48e17813364ca0d96f884acefb3df354d9eb9aaccfbdd697fe1b0" "q-30271/selection/48b78fd07d888c5bf9a5cdd7af0f06b9e0e32f70bb5e8f4ea6297555453d0077" "q-30271/selection/7571d7d8a7a7e21b4f714ef787f9c426dc6d038c22ccc420ea6c118c95fbd871" "q-30271/selection/2d69b2fdb029de0a1e3b16943f818e2948c422837d16f6f455acdf997d96d37f" "q-30271/selection/8b2fd997185b3b2b9759f8cd04915b055beb2c38e9ab333d569d00558b607b4a"] :db/ensure [:answer-field/validate]} {:db/id "q-30271" :question/id #uuid "b5c06750-e5d4-53d0-b888-e83968e906f2" :question/math-academy-id "q-30271" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/assets/b088ed9136d2b81e48752659369b24d2296924702a843629cca27d063c62b4df.png)\n\nFor the function $f(x)=-{x}^{2}+x+2$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)=-{x}^{2}+x+2$ and the $x$-axis, between $x=-0.5$ and $x=1.$\n\nThis can be expressed as the definite integral of $f(x)=-{x}^{2}+x+2$ between the lower limit $x=-0.5$ and the upper limit $x=1,$ as follows:\n\n$$\nA={\\int }_{-0.5}^{1}(-{x}^{2}+x+2)\\,\\text{d}x\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-30271/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9"] :knowledge-point/questions ["q-30271"] :db/ensure [:knowledge-point/validate]} {:db/id "q-346160/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "83376cd6-9412-5702-a19a-8908538dbb62" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-346160/field-1" :answer-field/id #uuid "29450bb5-2f5e-5296-9d47-cdefdbb1cbf7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346160/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-346160/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-346160/field-2/f0642b62b213571152d70cd23b9142d374334f7c9a1992f65f832911ebe150ba" :answer/id #uuid "07043285-b7be-5a87-80c3-0554ac463280" :answer/type :answer.type/math :answer/value "\\sqrt{x+4}+1" :db/ensure [:answer/validate]} {:db/id "q-346160/field-2" :answer-field/id #uuid "b47ad40b-156b-50b6-921e-6b7eddbf465e" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346160/field-2/f0642b62b213571152d70cd23b9142d374334f7c9a1992f65f832911ebe150ba" :answer-field/choices ["q-346160/field-2/f0642b62b213571152d70cd23b9142d374334f7c9a1992f65f832911ebe150ba"] :db/ensure [:answer-field/validate]} {:db/id "q-346160/field-3/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "d655b06f-d992-5719-bde5-20368aae480a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-346160/field-3" :answer-field/id #uuid "35c2d09c-04f7-58bd-9223-0960d06493a4" :answer-field/key "field-3" :answer-field/type :answer-field.type/blank :answer-field/correct "q-346160/field-3/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-346160/field-3/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff"] :db/ensure [:answer-field/validate]} {:db/id "q-346160" :question/id #uuid "7149286b-e549-5d38-a39f-76c05cf90c8a" :question/math-academy-id "q-346160" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/assets/3b53e88e4f93985ca999c7fd9d4e3fe3591afe10e7fbe499a303d22bfb0ce6ea.png)\n\nFor the function $f(x)=\\sqrt{x+4}+1$ shown above, what is the expression for the area $A$ as a definite integral?\n\n|  |  | {{field-1}} |  |  |\n| --- | --- | --- | --- | --- |\n| $A$ | $=$ | $\\int $ | {{field-2}} | $\\text{d}x$ |\n|  |  | {{field-3}} |  |  |" :question/worked-solution "We want to express the area $A$ between the function $f(x)=\\sqrt{x+4}+1$ and the $x$-axis, between $x=-3$ and $x=2.$\n\nThis can be expressed as the definite integral of $f(x)=\\sqrt{x+4}+1$ between the lower limit $x=-3$ and the upper limit $x=2,$ as follows:\n\n$$\nA={\\int }_{-3}^{2}\\sqrt{x+4}+1\\,\\text{d}x\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-346160/field-1" "q-346160/field-2" "q-346160/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "89902023-09e6-50cd-b08a-9d3e82d826c9"] :knowledge-point/questions ["q-346160"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-30273"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080406/assets/bb9db2eacfc01d00ca8a3436f9cd416afda7b400ae2aa2718d4ce049cd36a381.png)\n\nFor the function $y=f(x)={x}^{4}-4{x}^{2}+3$ shown above, what is the expression for the area $A$ as a definite integral?" :question/worked-solution "We want to express the area $A$ between the function $f(x)={x}^{4}-4{x}^{2}+3$ and the $x$-axis, between $x=-1$ and $x=1.$\n\nThis can be expressed as the definite integral of $f(x)={x}^{4}-4{x}^{2}+3$ between the lower limit $x=-1$ and the upper limit $x=1,$ as follows:\n\n$$\nA={\\int }_{-1}^{1}({x}^{4}-4{x}^{2}+3)\\,\\text{d}x.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-113881/selection/fcf7559b45bdf8211cf6e3e2e4da68ed7d035eff6f9f18e3ba396e24dbae266a" :answer/id #uuid "0ad26cd3-df05-56eb-909e-9cc5e0efe275" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(2+\\frac{i}{n})\\cdot \\frac{2}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113881/selection/e0a7b3289b7a9c4cd0de8ff4008f64808b589b9fa439aa8cba43a5399021fae4" :answer/id #uuid "a5e08388-50b2-5b6d-95a2-97d4dd9eb538" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(1+\\frac{i}{n})\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113881/selection/d6637f9f5bc7f03bbd59a03aa5939eca4c74e57e368a04607a9beed446c08e66" :answer/id #uuid "074ab172-dfad-5c73-8077-8e39d65394c3" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(\\frac{i}{n})\\cdot \\frac{2}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113881/selection/695c55a0ed95df92183813c638c951a5f53c7cec0477886a6f4f8bcba3a5f825" :answer/id #uuid "a2218dc5-2872-527e-bfbf-42be9531102d" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(\\frac{i}{n})\\cdot \\frac{1}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113881/selection/b49c99235a8ca7f9e97134d0eb77fd2c2b79eefe2d8439bd17950efde225b6eb" :answer/id #uuid "3e0955b2-e586-5b5c-b742-11399434e1ed" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(\\frac{i}{n})\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-113881/selection" :answer-field/id #uuid "f1d932fb-161d-5b16-8d50-0c4323f3b00f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-113881/selection/695c55a0ed95df92183813c638c951a5f53c7cec0477886a6f4f8bcba3a5f825" :answer-field/choices ["q-113881/selection/fcf7559b45bdf8211cf6e3e2e4da68ed7d035eff6f9f18e3ba396e24dbae266a" "q-113881/selection/e0a7b3289b7a9c4cd0de8ff4008f64808b589b9fa439aa8cba43a5399021fae4" "q-113881/selection/d6637f9f5bc7f03bbd59a03aa5939eca4c74e57e368a04607a9beed446c08e66" "q-113881/selection/695c55a0ed95df92183813c638c951a5f53c7cec0477886a6f4f8bcba3a5f825" "q-113881/selection/b49c99235a8ca7f9e97134d0eb77fd2c2b79eefe2d8439bd17950efde225b6eb"] :db/ensure [:answer-field/validate]} {:db/id "q-113881" :question/id #uuid "75ff0f89-478e-5f57-897a-97351f373753" :question/math-academy-id "q-113881" :question/problem "What is ${\\int }_{0}^{1}\\operatorname{arctan}⁡x\\,\\text{d}x$ expressed as the limit of a left Riemann sum?" :question/worked-solution "The definite integral can be defined in terms of the limit of a left Riemann sum as\n\n$$\n{\\int }_{a}^{b}f(x)\\,\\text{d}x={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx,\n$$\n\nwhere $Δx=\\frac{b-a}{n}$ and ${x}_{i}=a+iΔx.$\n\nIn the definite integral\n\n$$\n{\\int }_{0}^{1}\\operatorname{arctan}⁡x\\,\\text{d}x,\n$$\n\nthe function is $f(x)=\\operatorname{arctan}⁡x,$ the lower bound is $a=0,$ and the upper bound is $b=1.$ So, we have\n\n$$\nΔx=\\frac{1-0}{n}=\\frac{1}{n},\n$$\n\nand therefore\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\operatorname{arctan}⁡x\\,\\text{d}x & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}f({x}_{i})\\cdot Δx \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(0+i\\cdot \\frac{1}{n})\\,\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[f(\\frac{i}{n})\\cdot \\frac{1}{n}] \\\\  & ={lim}_{n\\to \\infty }{\\sum }_{i=0}^{n-1}[\\operatorname{arctan}⁡(\\frac{i}{n})\\cdot \\frac{1}{n}].\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-113881/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cdc82e49-5df6-5096-a8fd-e00017fb1e3a"] :knowledge-point/questions ["q-113881"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73159/selection/21207e0eb5d6ca9c417d279545c949a446de3b26156c1871efbd79b3404f45de" :answer/id #uuid "e89fda5f-83e1-5ce8-b94f-8c92a23a4e4e" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[{(1+\\frac{4l}{n})}^{4}\\cdot \\frac{4}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73159/selection/503310b21da37d0d31b148df6856c7b35cb324bef3ee38d3ad9b1b038649dfcc" :answer/id #uuid "2320ec8b-89e7-5383-8e76-8646ad5ca6ab" :answer/type :answer.type/math :answer/value "{lim}_{n\\to \\infty }{\\sum }_{l=0}^{n-1}[2{(4+\\frac{l}{n})}^{-4}\\cdot \\frac{3}{n}]" :db/ensure [:answer/validate]} {:db/id "q-73159/selection/89886d2c0d38b564deb887c0e0ac6e0c78b299b479b74cab54f59d2b540fe9bc" :answer/id #uuid "befe9551-7bbe-5e79-ad42-52f87c9b7f36" :answer/type :answer.type/math :answer/value