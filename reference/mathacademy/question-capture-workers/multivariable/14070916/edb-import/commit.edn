\,y-1,\\,z-1⟩ & =0 \\\\ ⟨4,8,4⟩\\cdot ⟨x-2,\\,y-1,\\,z-1⟩ & =0 \\\\ 4(x-2)+8(y-1)+4(z-1) & =0 \\\\ 4x+8y+4z-20 & =0 \\\\ x+2y+z-5 & =0\\end{aligned}\n$$" 13194139535828 true] [17592186368703 1000 #edb/ref 17592186368704 13194139535828 true] [17592186368703 1000 #edb/ref 17592186368705 13194139535828 true] [17592186368703 1000 #edb/ref 17592186368706 13194139535828 true] [17592186368703 1000 #edb/ref 17592186368707 13194139535828 true] [17592186368703 1000 #edb/ref 17592186368708 13194139535828 true] [17592186368703 1040 #edb/ref 17592186045450 13194139535828 true] [17592186368703 1041 "selection" 13194139535828 true] [17592186368703 1104 #edb/ref 17592186368708 13194139535828 true] [17592186368703 1110 #uuid "3032d5d6-32dd-59b8-9a00-eaaa947c6c33" 13194139535828 true] [17592186368704 1034 "2x+8y+z-13=0" 13194139535828 true] [17592186368704 1103 #edb/ref 17592186045453 13194139535828 true] [17592186368704 1111 #uuid "fd00afe2-e110-52fb-bf14-71bdee67a20e" 13194139535828 true] [17592186368705 1034 "2x+y+z-6=0" 13194139535828 true] [17592186368705 1103 #edb/ref 17592186045453 13194139535828 true] [17592186368705 1111 #uuid "1bf9813e-8ee4-5ebd-8f97-f9acce299b8d" 13194139535828 true] [17592186368706 1034 "x+8y+4z-14=0" 13194139535828 true] [17592186368706 1103 #edb/ref 17592186045453 13194139535828 true] [17592186368706 1111 #uuid "05d7abcd-56c8-5843-8296-85b0d5610b87" 13194139535828 true] [17592186368707 1034 "x+4y+4z-10=0" 13194139535828 true] [17592186368707 1103 #edb/ref 17592186045453 13194139535828 true] [17592186368707 1111 #uuid "6febd675-c9ea-5a38-8ee0-d1fe4e0e8561" 13194139535828 true] [17592186368708 1034 "x+2y+z-5=0" 13194139535828 true] [17592186368708 1103 #edb/ref 17592186045453 13194139535828 true] [17592186368708 1111 #uuid "c71e8698-6189-5639-8a2b-f410ef0691d1" 13194139535828 true] [17592186368709 1017 #edb/ref 17592186368710 13194139535828 true] [17592186368709 1089 "q-80783" 13194139535828 true] [17592186368709 1091 #edb/ref 17592186045465 13194139535828 true] [17592186368709 1100 "Consider the surface $z{x}^{3}=-1+x{y}^{2}.$ Find the equation of the tangent plane to that surface at the point $(1,-2,3).$" 13194139535828 true] [17592186368709 1113 #uuid "b91db3f9-c0e4-5574-95c9-b2372b5528a3" 13194139535828 true] [17592186368709 1145 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}z{x}^{3} & =-1+x{y}^{2} \\\\ z{x}^{3}-x{y}^{2} & =-1\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=z{x}^{3}-x{y}^{2}$, our surface can be viewed as the level surface $f(x,y,z)=-1.$ \n\nRecall that the equation of the tangent plane to the level surface $f(x,y,z)=k$ at the point $({x}_{0},{y}_{0},{z}_{0})$ can be expressed as\n\n$$\n∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩=0.\n$$\n\nNow, we find the gradient of $f(x,y,z)$ and evaluate it at $(1,-2,3):$ \n\n$$\n\\begin{aligned}∇\\,f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =\\frac{∂}{∂x}(z{x}^{3}-x{y}^{2})\\text{ }i+\\frac{∂}{∂y}(z{x}^{3}-x{y}^{2})\\text{ }j+\\frac{∂}{∂z}(z{x}^{3}-x{y}^{2})\\text{ }k \\\\  & =(3{x}^{2}z-{y}^{2})\\text{ }i-2xy\\text{ }j+{x}^{3}\\text{ }k \\\\ ∇\\,f(1,-2,3) & =(3(1)^{2}(3)-(-2)^{2})\\text{ }i-2(1)(-2)\\text{ }j+(1)^{3}\\text{ }k \\\\  & =5\\,i+4\\,j+1\\,k \\\\  & =⟨5,4,1⟩\\end{aligned}\n$$\n\n \n\nFinally, we can now write down the Cartesian equation of the tangent plane to the level surface, as follows:\n\n$$\n\\begin{aligned}∇f({x}_{0},{y}_{0},{z}_{0})\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ∇f(1,-2,3)\\cdot ⟨x-1,\\,y-(-2),\\,z-3⟩ & =0 \\\\ ⟨5,4,1⟩\\cdot ⟨x-1,\\,y+2,\\,z-3⟩ & =0 \\\\ 5(x-1)+4(y+2)+(z-3) & =0 \\\\ 5x+4y+z & =0\\end{aligned}\n$$" 13194139535828 true] [17592186368710 1000 #edb/ref 17592186368711 13194139535828 true] [17592186368710 1000 #edb/ref 17592186368712 13194139535828 true] [17592186368710 1000 #edb/ref 17592186368713 13194139535828 true] [17592186368710 1000 #edb/ref 17592186368714 13194139535828 true] [17592186368710 1000 #edb/ref 17592186368715