lty :question.difficulty/moderate :question/answer-fields ["q-129268/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375"] :knowledge-point/questions ["q-129268"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129272/selection/afac51431b49112f9fd39bca98751b67a96fbd311f41e5327fba5ecd33858e56" :answer/id #uuid "f13f40a6-70ac-59a2-b26f-f2c7483409db" :answer/type :answer.type/math :answer/value "⟨3,\\,2,\\,-9⟩" :db/ensure [:answer/validate]} {:db/id "q-129272/selection/62311bcc89b98f45407c212daba89295f33ee5085f6821e18acdd0c38cf386c7" :answer/id #uuid "c9acf765-9354-59b3-885b-46cac8c6f6e9" :answer/type :answer.type/math :answer/value "⟨1,\\,-2,\\,11⟩" :db/ensure [:answer/validate]} {:db/id "q-129272/selection/46c9b548c5e446eeba8868a9733c36789650d73b78b1d1692da9c2cf0c339827" :answer/id #uuid "0da14a70-0a80-5eab-8edb-9ce909648909" :answer/type :answer.type/math :answer/value "⟨3,\\,6,\\,-11⟩" :db/ensure [:answer/validate]} {:db/id "q-129272/selection/c37eb82250926ecfa7c9d32437b94804fd9ebb5aa67540422b94647a55aca4f6" :answer/id #uuid "5c01c4ac-119b-5bf5-8946-587c5c708b94" :answer/type :answer.type/math :answer/value "⟨5,\\,-1,\\,-9⟩" :db/ensure [:answer/validate]} {:db/id "q-129272/selection/a3365107c6e19cd6905f8c1e19b6f8c8e4633a1defddd9cc5079803d2f98ff53" :answer/id #uuid "5d9caab8-a0e1-528c-b8f4-0743b409cdef" :answer/type :answer.type/math :answer/value "⟨2,\\,2,\\,-9⟩" :db/ensure [:answer/validate]} {:db/id "q-129272/selection" :answer-field/id #uuid "26ccb60f-dd56-5b6c-b05b-4478675e58b7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129272/selection/46c9b548c5e446eeba8868a9733c36789650d73b78b1d1692da9c2cf0c339827" :answer-field/choices ["q-129272/selection/afac51431b49112f9fd39bca98751b67a96fbd311f41e5327fba5ecd33858e56" "q-129272/selection/62311bcc89b98f45407c212daba89295f33ee5085f6821e18acdd0c38cf386c7" "q-129272/selection/46c9b548c5e446eeba8868a9733c36789650d73b78b1d1692da9c2cf0c339827" "q-129272/selection/c37eb82250926ecfa7c9d32437b94804fd9ebb5aa67540422b94647a55aca4f6" "q-129272/selection/a3365107c6e19cd6905f8c1e19b6f8c8e4633a1defddd9cc5079803d2f98ff53"] :db/ensure [:answer-field/validate]} {:db/id "q-129272" :question/id #uuid "78c4a8a8-5c24-5d9d-99b9-eb62aeea153c" :question/math-academy-id "q-129272" :question/problem "Calculate \n${\\int }_{1}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨1,\\,2,\\,-1⟩$\nand\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨2,\\,4,\\,-10⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t+{\\int }_{1}^{3}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}f(t)\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t-(-{\\int }_{1}^{0}f(t)\\,\\text{d}t) \\\\  & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =⟨2,\\,4,\\,-10⟩+⟨1,\\,2,\\,-1⟩ \\\\  & =⟨3,\\,6,\\,-11⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129272/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00"] :knowledge-point/questions ["q-129272"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129275/selection/0585544a1f174750669603f019cf2bdc34dff854e5aede605091176470ad9124" :answer/id #uuid "a8ee4693-b671-5c0f-8dbf-786309f1e35f" :answer/type :answer.type/math :answer/value "⟨-6,\\,-20,\\,22⟩" :db/ensure [:answer/validate]} {:db/id "q-129275/selection/00a0c7a0b7aa7afdd4d3386f7013842236c1acd9c42167cc3d2207d6e222355e" :answer/id #uuid "ae0bea1f-2f66-53af-abf0-ed570eb0d2ca" :answer/type :answer.type/math :answer/value "⟨6,\\,-4,\\,-16⟩" :db/ensure [:answer/validate]} {:db/id "q-129275/selection/c61d6b4f5a43d45ddbfeeb1524192c4dc5c3a3339930f6c7cefdbe5494a0a85d" :answer/id #uuid "ddc2a205-4d41-5a66-a8de-a5306f1e44a9" :answer/type :answer.type/math :answer/value "⟨2,\\,4,\\,-6⟩" :db/ensure [:answer/validate]} {:db/id "q-129275/selection/dd34c32e53c5b9983010fbeb7ca5387165e9da5a7af6e110e86f945e0279351d" :answer/id #uuid "69b2a3a5-d461-539c-967b-db233cd84909" :answer/type :answer.type/math :answer/value "⟨-2,\\,-4,\\,12⟩" :db/ensure [:answer/validate]} {:db/id "q-129275/selection/40dc2b0074f9077c63a4b8b9ebbbf0ba3b6c54fecbcd33c7359c1c728a133454" :answer/id #uuid "b368a9bc-3bb5-50a8-b8f1-69c5788575e0" :answer/type :answer.type/math :answer/value "⟨2,\\,-8,\\,-20⟩" :db/ensure [:answer/validate]} {:db/id "q-129275/selection" :answer-field/id #uuid "417efc58-30d3-57fd-aa8c-e321300dd5c1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129275/selection/c61d6b4f5a43d45ddbfeeb1524192c4dc5c3a3339930f6c7cefdbe5494a0a85d" :answer-field/choices ["q-129275/selection/0585544a1f174750669603f019cf2bdc34dff854e5aede605091176470ad9124" "q-129275/selection/00a0c7a0b7aa7afdd4d3386f7013842236c1acd9c42167cc3d2207d6e222355e" "q-129275/selection/c61d6b4f5a43d45ddbfeeb1524192c4dc5c3a3339930f6c7cefdbe5494a0a85d" "q-129275/selection/dd34c32e53c5b9983010fbeb7ca5387165e9da5a7af6e110e86f945e0279351d" "q-129275/selection/40dc2b0074f9077c63a4b8b9ebbbf0ba3b6c54fecbcd33c7359c1c728a133454"] :db/ensure [:answer-field/validate]} {:db/id "q-129275" :question/id #uuid "6667ee1e-5bac-5bbf-a31f-37a435ae5255" :question/math-academy-id "q-129275" :question/problem "Calculate \n${\\int }_{3}^{5}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{5}^{0}f(t)\\,\\text{d}t=⟨-4,\\,-12,\\,14⟩$\nand\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨2,\\,8,\\,-8⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{5}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{3}^{5}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{3}^{5}f(t)\\,\\text{d}t={\\int }_{0}^{5}f(t)\\,\\text{d}t-{\\int }_{0}^{3}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{5}f(t)\\,\\text{d}t & ={\\int }_{0}^{5}f(t)\\,\\text{d}t-{\\int }_{0}^{3}f(t)\\,\\text{d}t \\\\  & =-{\\int }_{5}^{0}f(t)\\,\\text{d}t-{\\int }_{0}^{3}f(t)\\,\\text{d}t \\\\  & =-⟨-4,\\,-12,\\,14⟩-⟨2,\\,8,\\,-8⟩ \\\\  & =⟨4,\\,12,\\,-14⟩-⟨2,\\,8,\\,-8⟩ \\\\  & =⟨2,\\,4,\\,-6⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129275/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5287f63-6d1a-5710-8a71-df5d1ba09a00"] :knowledge-point/questions ["q-129275"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32516"] :question/problem "Calculate \n${\\int }_{1}^{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨2,\\,-2,\\,1⟩$\nand\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-16,\\,8,\\,-32⟩.$" :question/worked-solution "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{2}f(t)\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t+{\\int }_{1}^{2}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{2}f(t)\\,\\text{d}t={\\int }_{0}^{2}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}f(t)\\,\\text{d}t & ={\\int }_{0}^{2}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =-⟨-16,\\,8,\\,-32⟩-⟨2,\\,-2,\\,1⟩ \\\\  & =⟨14,\\,-6,\\,31⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-34822/selection/4644593a6ae896793c595e8a37cd468ba91be6a8038e715c4c88cddad1968793" :answer/id #uuid "bf487f86-19d3-505b-837d-ebca1bf27ae2" :answer/type :answer.t