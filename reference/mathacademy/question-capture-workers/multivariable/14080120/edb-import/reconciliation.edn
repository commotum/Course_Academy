al/14057355/state.json" "file_sha256" "bd85708dc06aa312de092dc6485b222955dc1688ed91ada4549eda4c56dd9f12" "basis" 1850 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/edb-import/verification.json"} {"question" "q-129140" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-3-\\operatorname{ln}⁡2,\\,-10,\\,4⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/state.json" "file_sha256" "bd85708dc06aa312de092dc6485b222955dc1688ed91ada4549eda4c56dd9f12" "basis" 1850 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/edb-import/verification.json"} {"question" "q-129143" "field" nil "attribute" "question/problem" "value" "Calculate ${\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\text{d}t$ given that ${\\int }_{-1}^{1}f(t)\\,\\text{d}t=⟨\\frac{1}{2},\\,6,\\,-1⟩$ and ${\\int }_{-1}^{1}g(t)\\,\\text{d}t=⟨1,\\,-2,\\,-6⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/state.json" "file_sha256" "bd85708dc06aa312de092dc6485b222955dc1688ed91ada4549eda4c56dd9f12" "basis" 1850 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/edb-import/verification.json"} {"question" "q-129143" "field" nil "attribute" "question/worked-solution" "value" "From the vector addition and scalar multiplication rules, we have\n \n\n$$\n{\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\text{d}t={\\int }_{-1}^{1}f(t)\\,\\text{d}t-\\frac{3}{2}{\\int }_{-1}^{1}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\,\\text{d}t & ={\\int }_{-1}^{1}f(t)\\,\\text{d}t-\\frac{3}{2}{\\int }_{-1}^{1}g(t)\\,\\text{d}t \\\\  & =⟨\\frac{1}{2},\\,6,\\,-1⟩-\\frac{3}{2}⟨1,\\,-2,\\,-6⟩ \\\\  & =⟨\\frac{1}{2},\\,6,\\,-1⟩-⟨\\frac{3}{2}\\,-3,\\,-9⟩ \\\\  & =⟨-1,\\,9,\\,8⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/state.json" "file_sha256" "bd85708dc06aa312de092dc6485b222955dc1688ed91ada4549eda4c56dd9f12" "basis" 1850 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/edb-import/verification.json"} {"question" "q-129143" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/activity-metadata.json" "file_sha256" "8b7121365a5651064a63e6ad7ea3d7b613dcf9341122c72f075f95529beee1ea" "basis" 1850 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/edb-import/verification.json"} {"question" "q-129143" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/state.json" "file_sha256" "bd85708dc06aa312de092dc6485b222955dc1688ed91ada4549eda4c56dd9f12" "basis" 1850 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/edb-import/verification.json"} {"question" "q-129143" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "⟨-1,\\,9,\\,8⟩"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14057355/state.json" "file_sha256" "bd85708dc06aa312de092dc6485b222955dc1688ed91ada4549eda4c56dd9f12" "basis" 1850 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/different