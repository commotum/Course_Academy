apture-workers/differential/14072669/edb-import/verification.json"} {"question" "q-129178" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "⟨2,\\,3,\\,-2⟩"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072669/state.json" "file_sha256" "a4f31fdcadb4b096fa582c2bec4a512ba4cbd2d533a35b292a5a4c93977583e3" "basis" 2648 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072669/edb-import/verification.json"} {"question" "q-129178" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "⟨3,\\,-9,\\,-6⟩"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072669/state.json" "file_sha256" "a4f31fdcadb4b096fa582c2bec4a512ba4cbd2d533a35b292a5a4c93977583e3" "basis" 2648 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072669/edb-import/verification.json"} {"question" "q-129178" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨1,\\,-3,\\,-2⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072669/state.json" "file_sha256" "a4f31fdcadb4b096fa582c2bec4a512ba4cbd2d533a35b292a5a4c93977583e3" "basis" 2648 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14072669/edb-import/verification.json"}] "sources" [{"question" "q-129140" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{4}f(t)\\,\\text{d}t=⟨-1,\\,-2,\\,1⟩$\nand \n${\\int }_{0}^{4}g(t)\\,\\text{d}t=⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129140" "field" nil "attribute" "question/worked-solution" "value" "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t=3{\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{0}^{4}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}[3f(t)-g(t)]\\,\\text{d}t & =3{\\int }_{0}^{4}f(t)\\,\\text{d}t-{\\int }_{0}^{4}g(t)\\,\\text{d}t \\\\  & =3⟨-1,\\,-2,\\,1⟩-⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩ \\\\  & =⟨-3,\\,-6,\\,3⟩-⟨\\operatorname{ln}⁡2,\\,4,\\,-1⟩ \\\\  & =⟨-3-\\operatorname{ln}⁡2,\\,-10,\\,4⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129140" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129140" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129140" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-3-\\operatorname{ln}⁡2,\\,-10,\\,4⟩"] ["math" "⟨2+\\operatorname{ln}⁡2,\\,-6,\\,1⟩"] ["math" "⟨2-\\operatorname{ln}⁡2,\\,-8,\\,6⟩"] ["math" "⟨\\operatorname{ln}⁡2,\\,-5,\\,2⟩"] ["math" "⟨\\operatorname{ln}⁡2-1,\\,2,\\,-2⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129140" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-3-\\operatorname{ln}⁡2,\\,-10,\\,4⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129143" "field" nil "attribute" "question/problem" "value" "Calculate ${\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\text{d}t$ given that ${\\int }_{-1}^{1}f(t)\\,\\text{d}t=⟨\\frac{1}{2},\\,6,\\,-1⟩$ and ${\\int }_{-1}^{1}g(t)\\,\\text{d}t=⟨1,\\,-2,\\,-6⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129143" "field" nil "attribute" "question/worked-solution" "value" "From the vector addition and scalar multiplication rules, we have\n \n\n$$\n{\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\text{d}t={\\int }_{-1}^{1}f(t)\\,\\text{d}t-\\frac{3}{2}{\\int }_{-1}^{1}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}[f(t)-\\frac{3}{2}g(t)]\\,\\text{d}t & ={\\int }_{-1}^{1}f(t)\\,\\text{d}t-\\frac{3}{2}{\\int }_{-1}^{1}g(t)\\,\\text{d}t \\\\  & =⟨\\frac{1}{2},\\,6,\\,-1⟩-\\frac{3}{2}⟨1,\\,-2,\\,-6⟩ \\\\  & =⟨\\frac{1}{2},\\,6,\\,-1⟩-⟨\\frac{3}{2}\\,-3,\\,-9⟩ \\\\  & =⟨-1,\\,9,\\,8⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129143" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129143" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129143" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-1,\\,9,\\,8⟩"] ["math" "⟨-2,\\,3,\\,9⟩"] ["math" "⟨-\\frac{1}{2},\\,3,\\,5⟩"] ["math" "⟨-\\frac{3}{2},\\,5,\\,2⟩"] ["math" "⟨2,\\,-4,\\,6⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129143" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-1,\\,9,\\,8⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129149" "field" nil "attribute" "question/problem" "value" "Calculate ${\\int }_{0}^{3}[2f(t)+4g(t)]\\,\\text{d}t$ given that ${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨-3,\\,\\sqrt{2},\\,2⟩$ and ${\\int }_{0}^{3}g(t)\\,\\text{d}t=⟨-\\frac{3}{2},\\,-\\frac{1}{4},\\,1⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129149" "field" nil "attribute" "question/worked-solution" "value" "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{3}[2f(t)+4g(t)]\\,\\text{d}t=2{\\int }_{0}^{3}f(t)\\,\\text{d}t+4{\\int }_{0}^{3}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}[2f(t)+4g(t)]\\,\\text{d}t & =2{\\int }_{0}^{3}f(t)\\,\\text{d}t+4{\\int }_{0}^{3}g(t)\\,\\text{d}t \\\\  & =2⟨-3,\\,\\sqrt{2},\\,2⟩+4⟨-\\frac{3}{2},\\,-\\frac{1}{4},\\,1⟩ \\\\  & =⟨-6,\\,2\\sqrt{2},\\,4⟩+⟨-6,\\,-1,\\,4⟩ \\\\  & =⟨-12,\\,2\\sqrt{2}-1,\\,8⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129149" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129149" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129149" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-10,\\,2\\sqrt{2}-6,\\,4⟩"] ["math" "⟨-12,\\,2\\sqrt{2}+1,\\,0⟩"] ["math" "⟨-12,\\,2\\sqrt{2}-1,\\,8⟩"] ["math" "⟨-5,\\,\\sqrt{2}-2,\\,4⟩"] ["math" "⟨-6,\\,5\\sqrt{2}+1,\\,6⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129149" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-12,\\,2\\sqrt{2}-1,\\,8⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98157" "field" nil "attribute" "question/problem" "value" "Calculate ${\\int }_{0}^{2}[2f(t)+3g(t)]\\,\\text{d}t$ given that ${\\int }_{0}^{2}f(t)\\,\\text{d}t=⟨{e}^{2}-1,\\,\\operatorname{sin}⁡2,\\,3⟩$ and ${\\int }_{0}^{2}g(t)\\,\\text{d}t=⟨3,\\,-1,\\,5⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98157" "field" nil "attribute" "question/worked-solution" "value" "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{0}^{2}[2f(t)+3g(t)]\\,\\text{d}t=2{\\int }_{0}^{2}f(t)\\,\\text{d}t+3{\\int }_{0}^{2}g(t)\\,\\text{d}t.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}[2f(t)+3g(t)]\\,\\text{d}t & =2{\\int }_{0}^{2}f(t)\\,\\text{d}t+3{\\int }_{0}^{2}g(t)\\,\\text{d}t \\\\  & =2⟨{e}^{2}-1,\\,\\operatorname{sin}⁡2,\\,3⟩+3⟨3,\\,-1,\\,5⟩ \\\\  & =⟨2{e}^{2}-2,\\,2\\operatorname{sin}⁡2,\\,6⟩+⟨9,\\,-3,\\,15⟩ \\\\  & =⟨2{e}^{2}+7,\\,2\\operatorname{sin}⁡2-3,\\,21⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98157" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-98157" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98157" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨2{e}^{2}+7,\\,2\\operatorname{sin}⁡2-3,\\,21⟩"] ["math" "⟨2{e}^{2},\\,6\\operatorname{sin}⁡2,\\,21⟩"] ["math" "⟨2{e}^{2}-7,\\,\\operatorname{sin}⁡2+3,\\,9⟩"] ["math" "⟨4{e}^{2}+3,\\,2\\operatorname{sin}⁡2+9,\\,12⟩"] ["math" "⟨7{e}^{2},\\,2\\operatorname{sin}⁡2-3,\\,21⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98157" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨2{e}^{2}+7,\\,2\\operatorname{sin}⁡2-3,\\,21⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98156" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{2}^{3}[f(t)-3g(t)]\\,\\text{d}t$ \ngiven that \n${\\int }_{2}^{3}f(t)\\,\\text{d}t=⟨2,\\,-4,\\,-2⟩$\nand \n${\\int }_{2}^{3}g(t)\\,\\text{d}t=⟨1,\\,2,\\,-2⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98156" "field" nil "attribute" "question/worked-solution" "value" "From the vector addition and scalar multiplication rules, we have\n\n$$\n{\\int }_{2}^{3}[f(t)-3g(t)]\\,\\text{d}t={\\int }_{2}^{3}f(t)\\,\\text{d}t-3{\\int }_{2}^{3}g(t)\\,\\text{d}t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}[f(t)-3g(t)]\\,\\text{d}t & ={\\int }_{2}^{3}f(t)\\,\\text{d}t-3{\\int }_{2}^{3}g(t)\\,\\text{d}t \\\\  & =⟨2,\\,-4,\\,-2⟩-3⟨1,\\,2,\\,-2⟩ \\\\  & =⟨2,\\,-4,\\,-2⟩-⟨3,\\,6,\\,-6⟩ \\\\  & =⟨-1,\\,-10,\\,4⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98156" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-98156" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98156" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-1,\\,-10,\\,4⟩"] ["math" "⟨-1,\\,2,\\,4⟩"] ["math" "⟨3,\\,6,\\,-6⟩"] ["math" "⟨4,\\,-1,\\,-10⟩"] ["math" "⟨5,\\,-10,\\,4⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98156" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-1,\\,-10,\\,4⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98172" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{0}^{2}\\frac{1}{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨4,\\,-10,\\,-14⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98172" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨4,\\,-10,\\,-14⟩ \\\\  & =⟨-4,\\,10,\\,14⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}\\frac{1}{2}f(t)\\,\\text{d}t & =\\frac{1}{2}{\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{2}\\cdot ⟨-4,\\,10,\\,14⟩ \\\\  & =⟨-2,\\,5,\\,7⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98172" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-98172" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98172" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-2,\\,5,\\,7⟩"] ["math" "⟨-4,\\,10,\\,14⟩"] ["math" "⟨-8,\\,15,\\,-7⟩"] ["math" "⟨2,\\,-5,\\,-7⟩"] ["math" "⟨4,\\,10,\\,14⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98172" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-2,\\,5,\\,7⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129179" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{0}^{2}4f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-\\frac{1}{2},\\,1,\\,\\frac{3}{2}⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129179" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-\\frac{1}{2},\\,1,\\,\\frac{3}{2}⟩ \\\\  & =⟨\\frac{1}{2},\\,-1,\\,-\\frac{3}{2}⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}4f(t)\\,\\text{d}t & =4{\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =4\\cdot ⟨\\frac{1}{2},\\,-1,\\,-\\frac{3}{2}⟩ \\\\  & =⟨2,\\,-4,\\,-6⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129179" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129179" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129179" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-1,\\,5,\\,-6⟩"] ["math" "⟨-2,\\,-1,\\,-3⟩"] ["math" "⟨1,\\,-1,\\,3⟩"] ["math" "⟨2,\\,-4,\\,-6⟩"] ["math" "⟨2,\\,8,\\,-2⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129179" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨2,\\,-4,\\,-6⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98096" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{0}^{1}2f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨1,\\,-3,\\,2⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98096" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(t)\\,\\text{d}t & =-{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨1,\\,-3,\\,2⟩ \\\\  & =⟨-1,\\,3,\\,-2⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}2f(t)\\,\\text{d}t & =2{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =2\\cdot ⟨-1,\\,3,\\,-2⟩ \\\\  & =⟨-2,\\,6,\\,-4⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98096" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-98096" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98096" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-1,\\,3,\\,-2⟩"] ["math" "⟨-2,\\,6,\\,-4⟩"] ["math" "⟨-3,\\,2,\\,1⟩"] ["math" "⟨2,\\,-6,\\,4⟩"] ["math" "⟨3,\\,-2,\\,-1⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98096" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-2,\\,6,\\,-4⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129178" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨-3,\\,9,\\,6⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129178" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(t)\\,\\text{d}t & =-{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-3,\\,9,\\,6⟩ \\\\  & =⟨3,\\,-9,\\,-6⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t & =\\frac{1}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{3}\\cdot ⟨3,\\,-9,\\,-6⟩ \\\\  & =⟨1,\\,-3,\\,-2⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129178" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129178" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129178" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-1,\\,0,\\,2⟩"] ["math" "⟨-3,\\,1,\\,2⟩"] ["math" "⟨1,\\,-3,\\,-2⟩"] ["math" "⟨2,\\,3,\\,-2⟩"] ["math" "⟨3,\\,-9,\\,-6⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129178" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨1,\\,-3,\\,-2⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129268" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{4}^{0}f(t)+⟨3,\\,1,\\,-2⟩\\,\\text{d}t$\ngiven that\n${\\int }_{0}^{4}f(t)\\,\\text{d}t=⟨-3,\\,6,\\,0⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129268" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{4}^{0}f(t)\\,\\text{d}t & =-{\\int }_{0}^{4}f(t)\\,\\text{d}t \\\\  & =-⟨-3,\\,6,\\,0⟩ \\\\  & =⟨3,\\,-6,\\,0⟩\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{4}^{0}f(t)+⟨3,\\,1,\\,-2⟩\\,\\text{d}t & ={\\int }_{4}^{0}f(t)\\,\\text{d}t+{\\int }_{4}^{0}⟨3,\\,1,\\,-2⟩\\,\\text{d}t \\\\  & =⟨3,\\,-6,\\,0⟩+⟨3t,\\,t,\\,-2t⟩{|}_{4}^{0} \\\\  & =⟨3,\\,-6,\\,0⟩+⟨-12,\\,-4,\\,8⟩\\text{ } \\\\  & =⟨-9,\\,-10,\\,8⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129268" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129268" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129268" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-13,\\,-5,\\,3⟩"] ["math" "⟨-9,\\,-10,\\,8⟩"] ["math" "⟨-9,\\,-8,\\,10⟩"] ["math" "⟨15,\\,-2,\\,8⟩"] ["math" "⟨9,\\,-12,\\,3⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129268" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨-9,\\,-10,\\,8⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98216" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{3}^{4}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{3}^{6}f(t)\\,\\text{d}t=⟨8,\\,-6,\\,15⟩$\nand\n${\\int }_{4}^{6}f(t)\\,\\text{d}t=⟨-2,\\,3,\\,4⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98216" "field" nil "attribute" "question/worked-solution" "value" "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{3}^{6}f(t)\\,\\text{d}t={\\int }_{3}^{4}f(t)\\,\\text{d}t+{\\int }_{4}^{6}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{3}^{4}f(t)\\,\\text{d}t={\\int }_{3}^{6}f(t)\\,\\text{d}t-{\\int }_{4}^{6}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{4}f(t)\\,\\text{d}t & ={\\int }_{3}^{6}f(t)\\,\\text{d}t-{\\int }_{4}^{6}f(t)\\,\\text{d}t \\\\  & =⟨8,\\,-6,\\,15⟩-⟨-2,\\,3,\\,4⟩ \\\\  & =⟨10,\\,-9,\\,11⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98216" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-98216" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98216" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨10,\\,-9,\\,11⟩"] ["math" "⟨10,\\,14,\\,-7⟩"] ["math" "⟨2,\\,-12,\\,11⟩"] ["math" "⟨2,\\,-9,\\,3⟩"] ["math" "⟨8,\\,-4,\\,3⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98216" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨10,\\,-9,\\,11⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129270" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{0}^{4}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{0}^{5}f(t)\\,\\text{d}t=⟨5,\\,1,\\,20⟩$\nand\n${\\int }_{4}^{5}f(t)\\,\\text{d}t=⟨1,\\,1,\\,8⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129270" "field" nil "attribute" "question/worked-solution" "value" "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{5}f(t)\\,\\text{d}t={\\int }_{0}^{4}f(t)\\,\\text{d}t+{\\int }_{4}^{5}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{0}^{4}f(t)\\,\\text{d}t={\\int }_{0}^{5}f(t)\\,\\text{d}t-{\\int }_{4}^{5}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}f(t)\\,\\text{d}t & ={\\int }_{0}^{5}f(t)\\,\\text{d}t-{\\int }_{4}^{5}f(t)\\,\\text{d}t \\\\  & =⟨5,\\,1,\\,20⟩-⟨1,\\,1,\\,8⟩ \\\\  & =⟨4,\\,0,\\,12⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129270" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129270" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129270" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-1,\\,-8,\\,3⟩"] ["math" "⟨-2,\\,-3,\\,15⟩"] ["math" "⟨4,\\,-4,\\,-2⟩"] ["math" "⟨4,\\,0,\\,12⟩"] ["math" "⟨4,\\,4,\\,2⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129270" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨4,\\,0,\\,12⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129272" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{1}^{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨1,\\,2,\\,-1⟩$\nand\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨2,\\,4,\\,-10⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129272" "field" nil "attribute" "question/worked-solution" "value" "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t+{\\int }_{1}^{3}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{3}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}f(t)\\,\\text{d}t & ={\\int }_{0}^{3}f(t)\\,\\text{d}t-(-{\\int }_{1}^{0}f(t)\\,\\text{d}t) \\\\  & ={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =⟨2,\\,4,\\,-10⟩+⟨1,\\,2,\\,-1⟩ \\\\  & =⟨3,\\,6,\\,-11⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129272" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129272" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129272" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨1,\\,-2,\\,11⟩"] ["math" "⟨2,\\,2,\\,-9⟩"] ["math" "⟨3,\\,2,\\,-9⟩"] ["math" "⟨3,\\,6,\\,-11⟩"] ["math" "⟨5,\\,-1,\\,-9⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129272" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨3,\\,6,\\,-11⟩"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129275" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{3}^{5}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{5}^{0}f(t)\\,\\text{d}t=⟨-4,\\,-12,\\,14⟩$\nand\n${\\int }_{0}^{3}f(t)\\,\\text{d}t=⟨2,\\,8,\\,-8⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129275" "field" nil "attribute" "question/worked-solution" "value" "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{5}f(t)\\,\\text{d}t={\\int }_{0}^{3}f(t)\\,\\text{d}t+{\\int }_{3}^{5}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{3}^{5}f(t)\\,\\text{d}t={\\int }_{0}^{5}f(t)\\,\\text{d}t-{\\int }_{0}^{3}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{5}f(t)\\,\\text{d}t & ={\\int }_{0}^{5}f(t)\\,\\text{d}t-{\\int }_{0}^{3}f(t)\\,\\text{d}t \\\\  & =-{\\int }_{5}^{0}f(t)\\,\\text{d}t-{\\int }_{0}^{3}f(t)\\,\\text{d}t \\\\  & =-⟨-4,\\,-12,\\,14⟩-⟨2,\\,8,\\,-8⟩ \\\\  & =⟨4,\\,12,\\,-14⟩-⟨2,\\,8,\\,-8⟩ \\\\  & =⟨2,\\,4,\\,-6⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129275" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129275" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129275" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-2,\\,-4,\\,12⟩"] ["math" "⟨-6,\\,-20,\\,22⟩"] ["math" "⟨2,\\,-8,\\,-20⟩"] ["math" "⟨2,\\,4,\\,-6⟩"] ["math" "⟨6,\\,-4,\\,-16⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129275" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨2,\\,4,\\,-6⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32516" "field" nil "attribute" "question/problem" "value" "Calculate \n${\\int }_{1}^{2}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{0}^{1}f(t)\\,\\text{d}t=⟨2,\\,-2,\\,1⟩$\nand\n${\\int }_{2}^{0}f(t)\\,\\text{d}t=⟨-16,\\,8,\\,-32⟩.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32516" "field" nil "attribute" "question/worked-solution" "value" "Using the adjacent intervals rule, we have\n\n$$\n{\\int }_{0}^{2}f(t)\\,\\text{d}t={\\int }_{0}^{1}f(t)\\,\\text{d}t+{\\int }_{1}^{2}f(t)\\,\\text{d}t.\n$$\n\nWe can rearrange the above as follows:\n\n$$\n{\\int }_{1}^{2}f(t)\\,\\text{d}t={\\int }_{0}^{2}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{1}^{2}f(t)\\,\\text{d}t & ={\\int }_{0}^{2}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =-⟨-16,\\,8,\\,-32⟩-⟨2,\\,-2,\\,1⟩ \\\\  & =⟨14,\\,-6,\\,31⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32516" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-32516" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32516" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "⟨-14,\\,6,\\,-31⟩"] ["math" "⟨-18,\\,6,\\,-33⟩"] ["math" "⟨14,\\,-6,\\,31⟩"] ["math" "⟨14,\\,6,\\,31⟩"] ["math" "⟨18,\\,-6,\\,33⟩"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32516" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "⟨14,\\,-6,\\,31⟩"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32522" "field" nil "attribute" "question/problem" "value" "Find ${\\int }_{0}^{\\pi /2}c\\times f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t=4\\,i+2\\,k$ \nand \n$c=i+j-k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32522" "field" nil "attribute" "question/worked-solution" "value" "The cross-product rule states that\n\n$$\n{\\int }_{0}^{\\pi /2}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t \\\\  & =(i+j-k)\\times (4\\,i+2\\,k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & 1 & -1 \\\\ 4 & 0 & 2\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ 0 & 2\\end{aligned}|i-|\\begin{aligned}1 & -1 \\\\ 4 & 2\\end{aligned}|j+|\\begin{aligned}1 & 1 \\\\ 4 & 0\\end{aligned}|k \\\\  & =(2-0)i-(2+4)j+(0-4)k \\\\  & =2i-6j-4k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32522" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-32522" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32522" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2i-2j+4k"] ["math" "2i+2j-4k"] ["math" "2i-6j-4k"] ["math" "4i-6j+2k"] ["math" "i+6j+2k"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32522" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2i-6j-4k"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-34822" "field" nil "attribute" "question/problem" "value" "Find ${\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{2}f(t)\\,\\text{d}t=16\\,i-10\\,j+4\\,k$ \nand \n$c=-i+j+3\\,k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-34822" "field" nil "attribute" "question/worked-solution" "value" "The dot product rule states that\n\n$$\n{\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{0}^{2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{0}^{2}f(t)\\,\\text{d}t \\\\  & =(-i+j+3\\,k)\\cdot (16\\,i-10\\,j+4\\,k) \\\\  & =-16-10+12 \\\\  & =-14.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-34822" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-34822" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-34822" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-14"] ["math" "-16"] ["math" "10"] ["math" "14"] ["math" "3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-34822" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-14"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98279" "field" nil "attribute" "question/problem" "value" "Find ${\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{2}^{3}f(t)\\,\\text{d}t=6\\,i-4\\,j+3\\,k$ \nand \n$c=i-2\\,j+2\\,k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98279" "field" nil "attribute" "question/worked-solution" "value" "The cross-product rule states that\n\n$$\n{\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{2}^{3}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{2}^{3}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{2}^{3}f(t)\\,\\text{d}t \\\\  & =(i-2\\,j+2\\,k)\\times (6\\,i-4\\,j+3\\,k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & -2 & 2 \\\\ 6 & -4 & 3\\end{aligned}| \\\\  & =|\\begin{aligned}-2 & 2 \\\\ -4 & 3\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 6 & 3\\end{aligned}|j+|\\begin{aligned}1 & -2 \\\\ 6 & -4\\end{aligned}|k \\\\  & =(-6+8)i-(3-12)j+(-4+12)k \\\\  & =2\\,i+9\\,j+8\\,k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98279" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-98279" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98279" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2\\,i-6\\,j+8\\,k"] ["math" "2\\,i+9\\,j+8\\,k"] ["math" "2\\,i-9\\,j-8\\,k"] ["math" "i+6\\,j+9\\,k"] ["math" "i-6\\,j-9\\,k"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-98279" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\,i+9\\,j+8\\,k"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129295" "field" nil "attribute" "question/problem" "value" "Find ${\\int }_{0}^{3}c\\times f(t)\\,\\text{d}t$ \ngiven that \n${\\int }_{0}^{3}f(t)\\,\\text{d}t=i+j-3\\,k$ \nand \n$c=i-j+2\\,k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129295" "field" nil "attribute" "question/worked-solution" "value" "The cross-product rule states that\n\n$$\n{\\int }_{0}^{3}c\\times f(t)\\,\\text{d}t=c\\times {\\int }_{0}^{3}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{0}^{3}f(t)\\,\\text{d}t \\\\  & =(i-j+2\\,k)\\times (i+j-3\\,k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 1 & -1 & 2 \\\\ 1 & 1 & -3\\end{aligned}| \\\\  & =|\\begin{aligned}-1 & 2 \\\\ 1 & -3\\end{aligned}|i-|\\begin{aligned}1 & 2 \\\\ 1 & -3\\end{aligned}|j+|\\begin{aligned}1 & -1 \\\\ 1 & 1\\end{aligned}|k \\\\  & =(3-2)i-(-3-2)j+(1+1)k \\\\  & =i+5\\,j+2\\,k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129295" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-129295" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129295" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2\\,i+2\\,j-k"] ["math" "-i+5\\,j+k"] ["math" "2\\,i-5\\,j+k"] ["math" "i+3\\,j+k"] ["math" "i+5\\,j+2\\,k"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-129295" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "i+5\\,j+2\\,k"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32300" "field" nil "attribute" "question/problem" "value" "Given that \n${\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t=\\frac{{\\pi }^{2}}{8}\\,i+\\,j+\\frac{\\pi }{2}\\,k,$ \n$c=i+u\\,j-\\frac{\\pi }{4}\\,k,$\nand \n${\\int }_{0}^{\\pi /2}c\\cdot f(t)\\,\\text{d}t=0,$ what is the value of $u?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32300" "field" nil "attribute" "question/worked-solution" "value" "The dot product rule states that\n\n$$\n{\\int }_{0}^{\\pi /2}c\\cdot f(t)\\,\\text{d}t=c\\cdot {\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t.\n$$\n\n \n\nApplying the dot-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}c\\cdot f(t)\\,\\text{d}t & =c\\cdot {\\int }_{0}^{\\pi /2}f(t)\\,\\text{d}t \\\\  & =(i+u\\,j-\\frac{\\pi }{4}\\,k)\\cdot (\\frac{{\\pi }^{2}}{8}\\,i+\\,j+\\frac{\\pi }{2}\\,k) \\\\  & =\\frac{{\\pi }^{2}}{8}+u-\\frac{{\\pi }^{2}}{8} \\\\  & =u.\\end{aligned}\n$$\n\nFinally, since ${\\int }_{0}^{\\pi /2}c\\cdot f(t)\\,\\text{d}t=0,$ we must have $u=0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32300" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/activity-metadata.json" "file_sha256" "959d36b4110ce0e2ea37c066964931a8cdd5b5af0855bf71c123b993e9b947d0"} {"question" "q-32300" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32300" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3"] ["math" "0"] ["math" "1"] ["math" "3"] ["math" "5"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "q-32300" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/state.json" "file_sha256" "cdfbd44a516729b43ba4feb324dd7fbfb0e3e6239471541b7deaf866b3cc0938"} {"question" "e-3019" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle{\\int_0^2} [  3 \\mathbf f(t)+\\mathbf g(t) ] \\,\\textrm{d}t$ given that $\\displaystyle{\\int_0^2} \\mathbf f(t)\\,\\textrm{d}t=\\left\\langle 16, \\: 2,\\: -2\\right\\rangle$ and $\\displaystyle{\\int_0^2}\\mathbf g(t)\\,\\textrm{d}t=\\left\\langle 2,-4,2\\right\\rangle .$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-3019.json" "file_sha256" "b4325214312d2fe2a72d3d0a7c6ae0ef7fc9e2f2ffbf86b7e22b0d47f8fd7959"} {"question" "e-3019" "field" nil "attribute" "question/worked-solution" "value" "From the vector addition and scalar multiplication rules, we have\n\n$$\n\\displaystyle {\\int_0^2 } \\big[ \\, 3 \\mathbf f(t)+\\mathbf g(t) \\, \\big] \\, \\textrm d t =  \\displaystyle {3\\int_0^2 } \\mathbf f(t) \\, \\textrm d t + \\displaystyle {\\int_0^2 } \\mathbf g(t) \\, \\textrm d t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}[3f(t)+g(t)]\\,\\text{d}t & =3{\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{0}^{2}g(t)\\,\\text{d}t \\\\  & =3⟨16,\\,2,\\,-2⟩+⟨2,\\,-4,\\,2⟩ \\\\  & =⟨48,\\,6,\\,-6⟩+⟨2,\\,-4,\\,2⟩ \\\\  & =⟨50,2,-4⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-3019.json" "file_sha256" "b4325214312d2fe2a72d3d0a7c6ae0ef7fc9e2f2ffbf86b7e22b0d47f8fd7959"} {"question" "e-8688" "field" nil "attribute" "question/problem" "value" "Calculate \n$\\displaystyle\\int_0^2\\mathbf f(t) + \\langle 1,\\:-1,\\:1\\rangle\\,\\textrm{d}t$\ngiven that\n$\\displaystyle\\int_2^0\\mathbf f(t) \\,\\textrm{d}t= \\left\\langle -3, \\: 2, \\: 1 \\right\\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-8688.json" "file_sha256" "5d5fa9256f5c11d4a41de07d95a1c885d0d8124bd806e95348707baa917c3ee8"} {"question" "e-8688" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)\\,\\text{d}t & =-{\\int }_{2}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-3,\\,2,\\,1⟩ \\\\  & =⟨3,\\,-2,\\,-1⟩.\\end{aligned}\n$$\n\nTherefore, applying the vector addition rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}f(t)+⟨1,\\,-1,\\,1⟩\\,\\text{d}t & ={\\int }_{0}^{2}f(t)\\,\\text{d}t+{\\int }_{0}^{2}⟨1,\\,-1,\\,1⟩\\,\\text{d}t \\\\  & =⟨3,\\,-2,\\,-1⟩+⟨t,\\,-t,\\,t⟩{|}_{0}^{2} \\\\  & =⟨3,\\,-2,\\,-1⟩+⟨2,\\,-2,\\,2⟩\\text{ } \\\\  & =⟨5,\\,-4,\\,1⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-8688.json" "file_sha256" "5d5fa9256f5c11d4a41de07d95a1c885d0d8124bd806e95348707baa917c3ee8"} {"question" "e-3020" "field" nil "attribute" "question/problem" "value" "Calculate \n$\\displaystyle\\int_{-1}^0\\mathbf f(t)\\,\\textrm{d}t$\ngiven that\n$\\displaystyle\\int_0^1\\mathbf f(t)\\,\\textrm{d}t= \\left\\langle \\dfrac{3}{2}, \\: 1, \\: 3 \\right\\rangle$\nand\n$\\displaystyle\\int_{-1}^1\\mathbf f(t)\\,\\textrm{d}t=\\left\\langle 0, \\: 2, \\: 6 \\right\\rangle.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-3020.json" "file_sha256" "203f27b71cbdb193ed73d4978a08ef8e94342401b0256735cf0a638d2578da86"} {"question" "e-3020" "field" nil "attribute" "question/worked-solution" "value" "Using the adjacent intervals, we get\n\n$$\n\\int_{-1}^1\\mathbf f(t)\\,\\textrm{d}t=\\int_{-1}^0\\mathbf f(t)\\,\\textrm{d}t+\\int_0^1\\mathbf f(t)\\,\\textrm{d}t .\n$$\n\nWe can rearrange the above as follows:\n\n$$\n\\int_{-1}^0\\mathbf f(t)\\,\\textrm{d}t = \n\\int_{-1}^1\\mathbf f(t)\\,\\textrm{d}t - \\int_0^1\\mathbf f(t)\\,\\textrm{d}t\n$$\n\nFinally, using the given information, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}f(t)\\,\\text{d}t & ={\\int }_{-1}^{1}f(t)\\,\\text{d}t-{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =⟨0,\\,2,\\,6⟩-⟨\\frac{3}{2},\\,1,\\,3⟩ \\\\  & =⟨-\\frac{3}{2},\\,1,\\,3⟩.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-3020.json" "file_sha256" "203f27b71cbdb193ed73d4978a08ef8e94342401b0256735cf0a638d2578da86"} {"question" "e-3021" "field" nil "attribute" "question/problem" "value" "Find $\\displaystyle {\\int_0^1 }  \\mathbf c \\times \\mathbf f(t)  \\, \\textrm d t$ \ngiven that \n$\\displaystyle\\int_0^1\\mathbf f(t)\\,\\textrm d t = \\mathbf i-3\\,\\mathbf j-4\\,\\mathbf k$ \nand \n$\\mathbf c=\\mathbf j-\\mathbf k .$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-3021.json" "file_sha256" "c03273a86020ea3e0bd108a41c3391276aa81a13a9aeed0d709722553282641e"} {"question" "e-3021" "field" nil "attribute" "question/worked-solution" "value" "The cross-product rule states that\n\n$$\n{\\int_0^1 } \\mathbf c \\times \\mathbf f(t) \\, \\textrm d t =  \\mathbf c \\times {\\int_0^1 } \\mathbf f(t) \\, \\textrm d t  .\n$$\n\n \n\nApplying the cross-product rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}c\\times f(t)\\,\\text{d}t & =c\\times {\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =(j-k)\\times (i-3\\,j-4\\,k) \\\\  & =|\\begin{aligned}i & j & k \\\\ 0 & 1 & -1 \\\\ 1 & -3 & -4\\end{aligned}| \\\\  & =|\\begin{aligned}1 & -1 \\\\ -3 & -4\\end{aligned}|i-|\\begin{aligned}0 & -1 \\\\ 1 & -4\\end{aligned}|j+|\\begin{aligned}0 & 1 \\\\ 1 & -3\\end{aligned}|k \\\\  & =(-4-3)i-(0+1)j+(0-1)k \\\\  & =-7\\,i-\\,j-\\,k.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14080120/example-3021.json" "file_sha256" "c03273a86020ea3e0bd108a41c3391276aa81a13a9aeed0d709722553282641e"}] "usage" {"q-98216" [] "q-32522" [] "q-129270" [] "q-98096" [] "q-98279" [] "q-129178" [] "q-32516" [] "q-98157" [] "e-3019" [] "e-3020" [] "q-129143" [] "e-8688" [] "e-3021" [] "q-129140" [] "q-32300" []} "basis" 2827 "retractions" [[17592186120484 :question/problem "Calculate\n\n$∫_{0}^{1}2f(t)dt$\ngiven that\n$∫_{1}^{0}f(t)dt = ⟨1,-3, 2⟩$."] [17592186120111 :question/problem "Calculate\n\n$∫_{1}^{2}f(t)dt$\ngiven that\n$∫_{0}^{1}f(t)dt = ⟨2,-2, 1⟩$\nand\n$∫_{2}^{0}f(t)dt = ⟨ - 16, 8,-32⟩$."]] "immutable_answers" [17592186117187 17592186117188 17592186117189 17592186117190 17592186117191 17592186119379 17592186119380 17592186119381 17592186119382 17592186119383 17592186334657 17592186334658 17592186334659 17592186334660 17592186334661 17592186334664 17592186334665 17592186334666 17592186334667 1759218