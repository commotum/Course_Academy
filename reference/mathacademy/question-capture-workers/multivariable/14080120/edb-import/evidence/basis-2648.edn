#{[{:db/id #edb/ref 17592186376685 :knowledge-point/_questions [{:knowledge-point/id #uuid "3eb7fd4f-f4bc-535e-b6bf-0c7df387a375" :knowledge-point/title "Reversing the Limits of Integration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b3adeb21-b90a-59f1-922e-d596b0557e08" :answer/type {:db/ident :answer.type/math} :answer/value "⟨3,\\,-9,\\,-6⟩" :db/id #edb/ref 17592186376687} {:answer/id #uuid "131eafa4-c361-5cc5-80f4-4c347f70c18a" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-3,\\,1,\\,2⟩" :db/id #edb/ref 17592186376688} {:answer/id #uuid "254ad42a-e7fd-575b-9c2f-cd77fa19afdd" :answer/type {:db/ident :answer.type/math} :answer/value "⟨-1,\\,0,\\,2⟩" :db/id #edb/ref 17592186376689} {:answer/id #uuid "8340c82c-ed51-5aec-ba60-80c40e9777ec" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,-3,\\,-2⟩" :db/id #edb/ref 17592186376690} {:answer/id #uuid "c4f90bd4-8124-5694-a830-39dc9dfc7542" :answer/type {:db/ident :answer.type/math} :answer/value "⟨2,\\,3,\\,-2⟩" :db/id #edb/ref 17592186376691}] :answer-field/correct {:answer/id #uuid "8340c82c-ed51-5aec-ba60-80c40e9777ec" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,\\,-3,\\,-2⟩" :db/id #edb/ref 17592186376690} :answer-field/id #uuid "be34a5cc-beb4-5554-a383-99337c3b7b48" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186376686}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e9a94a8b-f939-5c94-bb65-9658dde90c4c" :question/math-academy-id "q-129178" :question/problem "Calculate \n${\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t$\ngiven that\n${\\int }_{1}^{0}f(t)\\,\\text{d}t=⟨-3,\\,9,\\,6⟩.$" :question/worked-solution "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}f(t)\\,\\text{d}t & =-{\\int }_{1}^{0}f(t)\\,\\text{d}t \\\\  & =-⟨-3,\\,9,\\,6⟩ \\\\  & =⟨3,\\,-9,\\,-6⟩\\end{aligned}\n$$\n\nNow, applying the scalar multiplication rule, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{1}{3}f(t)\\,\\text{d}t & =\\frac{1}{3}{\\int }_{0}^{1}f(t)\\,\\text{d}t \\\\  & =\\frac{1}{3}\\cdot ⟨3,\\,-9,\\,-6⟩ \\\\  & =⟨1,\\,-3,\\,-2⟩.\\end{aligned}\n$$"}]}
