}⁡\\theta -\\frac{1}{r}(2r\\operatorname{cos}⁡2\\theta )\\operatorname{sin}⁡\\theta  \\\\  & =\\operatorname{sin}⁡2\\theta \\operatorname{cos}⁡\\theta -2\\operatorname{cos}⁡2\\theta \\operatorname{sin}⁡\\theta  \\\\  & =2\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta \\operatorname{cos}⁡\\theta -2\\operatorname{sin}⁡\\theta ({cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta ) \\\\  & =2\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta -2\\operatorname{sin}⁡\\theta {cos}^{2}⁡\\theta +2{sin}^{3}⁡\\theta  \\\\  & =2{sin}^{3}⁡\\theta .\\end{aligned}\n$$" 13194139535799 true] [17592186366804 1000 #edb/ref 17592186366805 13194139535799 true] [17592186366804 1000 #edb/ref 17592186366806 13194139535799 true] [17592186366804 1000 #edb/ref 17592186366807 13194139535799 true] [17592186366804 1000 #edb/ref 17592186366808 13194139535799 true] [17592186366804 1000 #edb/ref 17592186366809 13194139535799 true] [17592186366804 1040 #edb/ref 17592186045450 13194139535799 true] [17592186366804 1041 "selection" 13194139535799 true] [17592186366804 1104 #edb/ref 17592186366805 13194139535799 true] [17592186366804 1110 #uuid "aac74885-768a-5c63-9b45-c30476a54d1a" 13194139535799 true] [17592186366805 1034 "2{sin}^{3}⁡\\theta " 13194139535799 true] [17592186366805 1103 #edb/ref 17592186045453 13194139535799 true] [17592186366805 1111 #uuid "e58038de-9b8e-5a70-8001-2fb4b350011f" 13194139535799 true] [17592186366806 1034 "2{cos}^{3}⁡\\theta " 13194139535799 true] [17592186366806 1103 #edb/ref 17592186045453 13194139535799 true] [17592186366806 1111 #uuid "fa8274f0-fef6-528c-af17-fcde32543624" 13194139535799 true] [17592186366807 1034 "2{sin}^{3}⁡\\theta \\operatorname{cos}⁡\\theta " 13194139535799 true] [17592186366807 1103 #edb/ref 17592186045453 13194139535799 true] [17592186366807 1111 #uuid "66ec02ce-3590-5bfa-a765-807ed1d4fec9" 13194139535799 true] [17592186366808 1034 "3{sin}^{2}⁡\\theta " 13194139535799 true] [17592186366808 1103 #edb/ref 17592186045453 13194139535799 true] [17592186366808 11