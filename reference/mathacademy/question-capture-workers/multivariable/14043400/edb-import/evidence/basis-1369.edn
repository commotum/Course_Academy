#{[{:db/id #edb/ref 17592186303129 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b34c298e-5082-53ae-bbcc-9abd9d3deebd" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0)$ and  $(0,1)$" :db/id #edb/ref 17592186303131} {:answer/id #uuid "0fd39f9b-7cd6-5cbd-a639-497db45e5e5f" :answer/type {:db/ident :answer.type/math} :answer/value "(0,1)" :db/id #edb/ref 17592186303132} {:answer/id #uuid "d89c0caa-656e-59de-873e-5402af7b4273" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\infty )" :db/id #edb/ref 17592186303133} {:answer/id #uuid "81f1adcc-62d5-51f4-80b1-cd547bd48eca" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,0)" :db/id #edb/ref 17592186303134} {:answer/id #uuid "df90ad81-7c50-537c-9708-3715bba0d2e7" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\infty ,-1)$ and  $(1,\\infty )$" :db/id #edb/ref 17592186303135}] :answer-field/correct {:answer/id #uuid "b34c298e-5082-53ae-bbcc-9abd9d3deebd" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0)$ and  $(0,1)$" :db/id #edb/ref 17592186303131} :answer-field/id #uuid "197f6263-c641-5680-8632-5bff24d869ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303130}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "cd8f4bb2-7373-5980-915b-81559c92c88f" :question/math-academy-id "q-114060" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/assets/c528a8bdbb9bc6dd1a9895109fdc6818b70787c5024c78e06e2d2ec3997777d6.png)\n\nThe graph above shows $y={f}^{″}(x).$ Find the intervals on which the function $f(x)$ is concave up." :question/worked-solution "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the intervals  $(-1,0)$ and  $(0,1).$  Therefore, the function $f(x)$ is concave up on the intervals  $(-1,0)$ and  $(0,1).$"}] [{:db/id #edb/ref 17592186303136 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eec5bffe-f37b-542a-b883-24981acf56b0" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ and $(2,3)$" :db/id #edb/ref 17592186303138} {:answer/id #uuid "830cf24c-0dfa-5396-817d-7d783a1a481a" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ only" :db/id #edb/ref 17592186303139} {:answer/id #uuid "7495b2c2-665b-517b-a60b-9c61ed3ea1be" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,1)$ and $(1,2)$" :db/id #edb/ref 17592186303140} {:answer/id #uuid "c14260ea-f10e-52ce-bcc9-bed40a408717" :answer/type {:db/ident :answer.type/text} :answer/value "$(2,3)$ only" :db/id #edb/ref 17592186303141} {:answer/id #uuid "426ba1bd-081f-552d-a1fe-5c1a630db5c3" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ only" :db/id #edb/ref 17592186303142}] :answer-field/correct {:answer/id #uuid "426ba1bd-081f-552d-a1fe-5c1a630db5c3" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,2)$ only" :db/id #edb/ref 17592186303142} :answer-field/id #uuid "d2a4d10c-c21d-558f-b943-31033714e15e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303137}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a0161bc1-4160-5449-a401-29481660be7d" :question/math-academy-id "q-114063" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/assets/9ac6bf6978169aaa3a29c570234cdbf26f37b6e91488d8e27c63255b8cbb3ba6.png)\n\nThe graph above shows $y={f}^{″}(x),$ where the function $f(x)$ is defined on $[0,3].$ Find the intervals on which the function $f(x)$ is concave down." :question/worked-solution "A function $f(x)$ is concave down over an interval $(a,b)$ if ${f}^{″}(x)<0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)<0$ on the interval  $(1,2)$ only. Therefore, the function $f(x)$ is concave down on the interval $(1,2)$ only."}]}
