/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" nil "attribute" "question/worked-solution" "value" "A function $f(x)$ is concave down over an interval $(a,b)$ if ${f}^{″}(x)<0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)<0$ on the interval  $(1,2)$ only. Therefore, the function $f(x)$ is concave down on the interval $(1,2)$ only." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/activity-metadata.json" "file_sha256" "0ce03f4f75f1275c5c0ab23092d155e04e8161764ce97c90f3fc6d28c8e8dede" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$(0,1)$ and $(1,2)$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$(0,1)$ and $(2,3)$"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$(0,1)$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$(1,2)$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "$(2,3)$ only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"} {"question" "q-114063" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "$(1,2)$ only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/state.json" "file_sha256" "cb74f35e28f48a8da60ea8063c1e95a23d10efd7e404b4e564f553c67fb6609a" "basis" 1369 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14039567/edb-import/verification.json"}] "sources" [{"question" "q-22794" "field" nil "attribute" "question/problem" "value" "Determine the largest interval on which the function $f(x)=2x-\\operatorname{ln}⁡(1+x)$ is concave up." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-22794" "field" nil "attribute" "question/worked-solution" "value" "First, we notice that the domain of the function is $x\\in (-1,\\infty ).$\n\nA function $f(x)$ is concave up on an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nFirst, let's calculate the second derivative of $f(x)=2x-\\operatorname{ln}⁡(1+x)$:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2-\\frac{1}{1+x} \\\\ {f}^{″}(x) & =\\frac{1}{(1+x)^{2}}.\\end{aligned}\n$$\n\nNow, to find where the function is concave up, we solve the inequality ${f}^{″}(x)>0:$\n\n$$\n\\frac{1}{(1+x)^{2}}>0\n$$\n\nNotice that for $x\\ne -1$ the second derivative is always positive since both the numerator and denominator are positive. Therefore, we conclude that $f(x)$ is concave up on its entire domain, $(-1,\\infty ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-22794" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/activity-metadata.json" "file_sha256" "6fe74a5f33fb1820ffabf22a6c87527c6ab012dbdae55ed8ef38b4201dc8ed8b"} {"question" "q-22794" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-22794" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-1,1)"] ["math" "(-1,\\infty )"] ["math" "(0,\\infty )"] ["math" "(1,\\infty )"] ["text" "The function is concave up nowhere."]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-22794" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-1,\\infty )"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2719" "field" nil "attribute" "question/problem" "value" "Determine the largest interval on which the function $f(x)=3{x}^{2}-9x+6$ is concave up" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2719" "field" nil "attribute" "question/worked-solution" "value" "A function $f(x)$ is concave up on an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nFirst, let's calculate the second derivative of $f(x)=3{x}^{2}-9x+6:$\n\n$$\n\\begin{aligned}{f}^{′}(x) & =6x-9 \\\\ {f}^{″}(x) & =6.\\end{aligned}\n$$\n\nNow, to find where the function is concave up, we solve the inequality ${f}^{″}(x)>0.$ Notice that ${f}^{″}(x)=6>0$ for all values of $x.$ \n\nTherefore, $f(x)$ is concave up on $(-\\infty ,\\infty ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2719" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/activity-metadata.json" "file_sha256" "6fe74a5f33fb1820ffabf22a6c87527c6ab012dbdae55ed8ef38b4201dc8ed8b"} {"question" "q-2719" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2719" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-\\infty ,0)"] ["math" "(-\\infty ,\\infty )"] ["math" "(0,\\infty )"] ["math" "(\\infty ,6)"] ["text" "The function is concave up nowhere."]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2719" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-\\infty ,\\infty )"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344331" "field" nil "attribute" "question/problem" "value" "Determine the **largest** interval on which the function $f(x)=7x-\\operatorname{ln}⁡(x-2)$ is concave up.\n\nThe largest interval where $f(x)$ is concave up is\n$(${{field-1}}$,$\n{{field-2}}$).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344331" "field" nil "attribute" "question/worked-solution" "value" "First, we notice that the domain of the function is $x\\in (2,\\infty ).$\n\nA function $f(x)$ is concave up on an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nFirst, let's calculate the second derivative of $f(x)=7x-\\operatorname{ln}⁡(x-2)$:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =7-\\frac{1}{x-2} \\\\ {f}^{″}(x) & =\\frac{1}{(x-2)^{2}}\\end{aligned}\n$$\n\nNow, to find where the function is concave up, we solve the inequality ${f}^{″}(x)>0:$\n\n$$\n\\frac{1}{(x-2)^{2}}>0\n$$\n\nNotice that for $x\\ne 2$ the second derivative is always positive since both the numerator and denominator are positive. Therefore, we conclude that the largest interval where $f(x)$ is concave up is $(\\,2,\\infty \\,).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344331" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/activity-metadata.json" "file_sha256" "6fe74a5f33fb1820ffabf22a6c87527c6ab012dbdae55ed8ef38b4201dc8ed8b"} {"question" "q-344331" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344331" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344331" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344331" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2458" "field" nil "attribute" "question/problem" "value" "Determine the largest interval on which the function $f(x)=-{x}^{3}+2{x}^{2}-11$ is concave down." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2458" "field" nil "attribute" "question/worked-solution" "value" "A function $f(x)$ is concave down on an interval $(a,b)$ if ${f}^{″}(x)<0$ for all $x\\in (a,b).$\n\nFirst, let's calculate the second derivative of $f(x)=-{x}^{3}+2{x}^{2}-11:$\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-3{x}^{2}+4x \\\\ {f}^{″}(x) & =-6x+4.\\end{aligned}\n$$\n\nNow, to find where the function is concave down, we solve the inequality ${f}^{″}(x)<0,$ as follows:\n\n$$\n\\begin{aligned}-6x+4 & <0 \\\\ 6x & >4 \\\\ x & >\\frac{2}{3}.\\end{aligned}\n$$\n\nTherefore, $f(x)$ is concave down on $(\\frac{2}{3},\\infty ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2458" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/activity-metadata.json" "file_sha256" "6fe74a5f33fb1820ffabf22a6c87527c6ab012dbdae55ed8ef38b4201dc8ed8b"} {"question" "q-2458" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2458" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-\\infty ,-\\frac{2}{3})"] ["math" "(-\\infty ,\\frac{1}{3})"] ["math" "(-\\infty ,\\frac{2}{3})"] ["math" "(0,\\infty )"] ["math" "(\\frac{2}{3},\\infty )"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-2458" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\frac{2}{3},\\infty )"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344352" "field" nil "attribute" "question/problem" "value" "Determine the **largest** interval on which the function $f(x)=\\frac{3x+1}{x+4}$ is concave up.\n\nThe largest interval where $f(x)$ is concave up is\n$(${{field-1}}$,$\n{{field-2}}$).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344352" "field" nil "attribute" "question/worked-solution" "value" "First, we notice that the domain of the function is $x\\ne -4.$\n\nA function $f(x)$ is concave up on an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nFirst, let's calculate the second derivative of $f(x)=\\frac{3x+1}{x+4}:$\n\n$$\n\\begin{aligned}{f}^{′}(x) & =\\frac{3(x+4)-(3x+1)}{(x+4)^{2}} \\\\  & =\\frac{11}{(x+4)^{2}} \\\\  & =11(x+4)^{-2} \\\\ {f}^{″}(x) & =-22(x+4)^{-3}\\end{aligned}\n$$\n\nNow, to find where the function is concave up, we solve the inequality ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}-22(x+4)^{-3} & >0 \\\\ (x+4)^{-3} & <0 \\\\ x+4 & <0 \\\\ x & <-4\\end{aligned}\n$$\n\nTherefore, $f(x)$ is concave up on $(\\,-\\infty ,-4\\,).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344352" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/activity-metadata.json" "file_sha256" "6fe74a5f33fb1820ffabf22a6c87527c6ab012dbdae55ed8ef38b4201dc8ed8b"} {"question" "q-344352" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344352" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\infty"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344352" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344352" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "-4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344777" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/assets/f03d1f23687273ff94bb2ea4ee45991600c75a237bf4c0a1fdb955d0f00b9b3d.png)\n\nThe function $f(x)$ is defined on $(-\\infty ,\\infty ).$\nThe graph of the second derivative $y={f}^{″}(x)$ of the function $f(x)$ intersects the $x$-axis at the points $x=-2$ and $x=3,$ as shown above. Find the interval on which the function $f(x)$ is concave down.\n\n$f(x)$  is concave down on the interval\n$(${{field-1}}$,$\n{{field-2}}$).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344777" "field" nil "attribute" "question/worked-solution" "value" "A function $f(x)$ is concave down over an interval $(a,b)$ if ${f}^{″}(x)<0$ for all $x\\in (a,b).$\n\nFrom the plotted graph of $y={f}^{″}(x)$, we can  see that ${f}^{″}(x)<0$ on the interval   $(-2,3)$ \n\nTherefore, the function $f(x)$ is concave down on the interval $(\\,-2,3\\,).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344777" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/activity-metadata.json" "file_sha256" "6fe74a5f33fb1820ffabf22a6c87527c6ab012dbdae55ed8ef38b4201dc8ed8b"} {"question" "q-344777" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344777" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344777" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-344777" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-31214" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/assets/9fe57341b631d34a9dfa41619a29f816b00b41b3b07f450fd333808230835e2c.png)\n\nThe graph of the second derivative $y={f}^{″}(x)$ of the function $f(x)$ is shown above. \nFind the intervals on which the function $f(x)$ is concave up." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043400/state.json" "file_sha256" "1c011939a23a6e5d0debb54f085c155a61e7ae23ef2788846231114773e7b932"} {"question" "q-31214" "field" nil "attribute" "question/worked-solution" "value" "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the interval $(0,4)$ only. \n\nTherefore, the function $f(x)$ is concave up on the interval $(0,4)$ only." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/