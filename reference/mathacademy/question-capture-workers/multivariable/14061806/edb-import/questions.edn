/id #edb/ref 17592186158831}] :answer-field/correct {:answer/id #uuid "0615c848-ed6f-5c7f-8d81-befdaf89fb0d" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186158829} :answer-field/id #uuid "a3bcfedc-7d51-58e1-805a-6b4b5bd0ce7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186158826}] :question/id #uuid "10ef8c30-25b6-5a94-b4c4-25e4aa370204" :question/math-academy-id "q-109336" :question/problem "|  | $Y = 2$ | $Y = 4$ | $Y = 6$ |\n| --- | ---: | ---: | ---: |\n| $X = 1$ | $0.1$ | $0.25$ | $0.25$ |\n| $X = 2$ | $0.05$ | $0.15$ | $0.2$ |\n\nCompute $P(X = 2andY \\le 4)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x, y)$ shown in the table above."}] [{:db/id #edb/ref 17592186162215 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c4507b69-e64b-5605-a561-12b1af371131" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186158833} {:answer/id #uuid "e4774de0-6252-5275-804b-363b50d25202" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186158834} {:answer/id #uuid "ed73c329-4076-5018-9c42-a246f0011801" :answer/type {:db/ident :answer.type/math} :answer/value "0.6" :db/id #edb/ref 17592186158835} {:answer/id #uuid "25ef9e84-8e33-565d-95b8-ec4cd7d756b5" :answer/type {:db/ident :answer.type/math} :answer/value "0.9" :db/id #edb/ref 17592186158836} {:answer/id #uuid "69b2d0f5-8768-5064-8ec6-c2f83ce98bac" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 17592186158837}] :answer-field/correct {:answer/id #uuid "69b2d0f5-8768-5064-8ec6-c2f83ce98bac" :answer/type {:db/ident :answer.type/math} :answer/value "0.8" :db/id #edb/ref 175921861