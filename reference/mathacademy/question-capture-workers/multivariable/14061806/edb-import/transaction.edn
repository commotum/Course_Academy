75c3291963c6a55bc727ce128daeb62e061a964"] :db/ensure [:answer-field/validate]} {:db/id "q-110935" :question/id #uuid "1d515d41-267c-5289-96af-a6451b9a8eba" :question/math-academy-id "q-110935" :question/problem "|  | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.05$ | $0.1$ | $0.25$ |\n| $X=2$ | $0.15$ | $0.05$ | $0.1$ |\n| $X=3$ | $0.05$ | $0.2$ | $0.05$ |\n\nCompute $P((X,Y)\\in {(1,0),(1,2),(2,1),(3,2)})$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P((X,Y)\\in {(1,0),(1,2),(2,1),(3,2)}) & =P((X,Y)=(1,0)) \\\\  & +P((X,Y)=(1,2)) \\\\  & +P((X,Y)=(2,1)) \\\\  & +P((X,Y)=(3,2)) \\\\  & =f(1,0)+f(1,2)+f(2,1)+f(3,2) \\\\  & =0.05+0.25+0.05+0.05 \\\\  & =0.4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-110935/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c0e20c64-85be-5cb5-acde-17ffd8b6aff5"] :knowledge-point/questions ["q-110935"] :db/ensure [:knowledge-point/validate]} {:db/id "q-110931/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "4c92d3a7-136f-5784-8892-cc0073f463db" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-110931/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "1b5c2afe-40f3-54a3-ad4e-abaa57a436af" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-110931/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "05b9c595-85b0-54ac-b5f6-196153b023ea" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-110931/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "bf8c7588-b