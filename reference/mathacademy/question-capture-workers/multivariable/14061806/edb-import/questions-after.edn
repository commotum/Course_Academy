1721 :knowledge-point/_questions [{:knowledge-point/id #uuid "c0e20c64-85be-5cb5-acde-17ffd8b6aff5" :knowledge-point/title "Calculating a Joint Probability From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0841567e-a89d-5ea4-8d1c-40267e125fa3" :answer/type {:db/ident :answer.type/math} :answer/value "0.2" :db/id #edb/ref 17592186341723} {:answer/id #uuid "770504d5-a9f7-5304-930b-95077ec374af" :answer/type {:db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186341724} {:answer/id #uuid "55d9ff3b-0667-506a-8b1b-ee7c7712530b" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186341725} {:answer/id #uuid "edeef09f-10db-5997-bf4b-acdc7c637063" :answer/type {:db/ident :answer.type/math} :answer/value "0.15" :db/id #edb/ref 17592186341726} {:answer/id #uuid "c2c1e271-4f1a-5541-b427-e24de13ef253" :answer/type {:db/ident :answer.type/math} :answer/value "0.35" :db/id #edb/ref 17592186341727}] :answer-field/correct {:answer/id #uuid "55d9ff3b-0667-506a-8b1b-ee7c7712530b" :answer/type {:db/ident :answer.type/math} :answer/value "0.4" :db/id #edb/ref 17592186341725} :answer-field/id #uuid "339ddfff-db93-5f06-b050-4b18aeeec66f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341722}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1d515d41-267c-5289-96af-a6451b9a8eba" :question/math-academy-id "q-110935" :question/problem "|  | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=1$ | $0.05$ | $0.1$ | $0.25$ |\n| $X=2$ | $0.15$ | $0.05$ | $0.1$ |\n| $X=3$ | $0.05$ | $0.2$ | $0.05$ |\n\nCompute $P((X,Y)\\in {(1,0),(1,2),(2,1),(3,2)})$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P((X,Y)\\in {(1,0),(1,2),(2,1),(3,2)}) & =P((X,Y)=(1,0)) \\\\  & +P((X,Y)=(1,2)) \\\\  & +P((X,Y)=(2,1)) \\\\  & +P((X,Y)=(3,2)) \\\\  & =f(1,0)+f(1,2)+f(2,1)+f(3,2) \\\\  & =0.05+0.25+0.05+0.05 \\\\  & =0.4.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341728 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a68bf074-8843-576f-8be3-003edb5c91c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186341730} {:answer/id #uuid "f7c3699a-7723-50af-825e-cca81fe31162" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186341731} {:answer/id #uuid "16d8c98c-55e5-5ee6-8930-388393c14cc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186341732} {:answer/id #uuid "34dfa4bb-f428-5716-ac21-8d8d5250a24e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186341733} {:answer/id #uuid "aab664d5-16f8-53d0-bbf1-fe261209e5fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186341734}] :answer-field/correct {:answer/id #uuid "a68bf074-8843-576f-8be3-003edb5c91c6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186341730} :answer-field/id #uuid "d4ca3894-8e96-53c6-8a07-6cdc833484d9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341729}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "58ffa5cf-73c4-5d38-bbb0-2b8060cfb4fe" :question/math-academy-id "q-111076" :question/problem "|  | $Y=1$ | $Y=3$ | $Y=5$ |\n| --- | --- | --- | --- |\n| $X=2$ | $\\frac{1}{6}$ | $\\frac{1}{6}$ | $\\frac{2}{9}$ |\n| $X=4$ | $\\frac{1}{9}$ | $\\frac{2}{9}$ | $\\frac{1}{9}$ |\n\nCompute $P(X=4\\,\\,\\text{or}\\,\\,Y>4)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X=4\\,\\,\\text{or}\\,\\,Y>4) & =P((X,Y)\\in {(2,5),(4,1),(4,3),(4,5)}) \\\\  & =P((X,Y)=(2,5))+P((X,Y)=(4,1)) \\\\  & +P((X,Y)=(4,3))+P((X,Y)=(4,5)) \\\\  & =f(2,5)+f(4,1)+f(4,3)+f(4,5) \\\\  & =\\frac{2}{9}+\\frac{1}{9}+\\frac{2}{9}+\\frac{1}{9} \\\\  & =\\frac{2}{3}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341735 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cd9d5481-9f73-50d6-96d2-4a9d2bd7cf8a" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186341737} {:answer/id #uuid "b27a0c2f-df85-5b01-b779-1b18e7785775" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186341738} {:answer/id #uuid "a4b65303-e420-5a2e-95bb-999ff2ede7a2" :answer/type {:db/ident :answer.type/math} :answer/value "0.65" :db/id #edb/ref 17592186341739} {:answer/id #uuid "d1481559-6d1e-5832-9a80-c6110c63f379" :answer/type {:db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186341740} {:answer/id #uuid "7629299a-98f1-53ab-8ebb-2088c8b3e894" :answer/type {:db/ident :answer.type/math} :answer/value "0.55" :db/id #edb/ref 17592186341741}] :answer-field/correct {:answer/id #uuid "cd9d5481-9f73-50d6-96d2-4a9d2bd7cf8a" :answer/type {:db/ident :answer.type/math} :answer/value "0.7" :db/id #edb/ref 17592186341737} :answer-field/id #uuid "c5403483-e723-5180-915e-e846a4ee6d23" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341736}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "226be118-3237-5a6d-bb73-42ee9dce8ee2" :question/math-academy-id "q-111080" :question/problem "|  | $Y=1$ | $Y=2$ | $Y=3$ |\n| --- | --- | --- | --- |\n| $X=2$ | $0.1$ | $0.15$ | $0.3$ |\n| $X=3$ | $0.2$ | $0.1$ | $0.15$ |\n\nCompute $P(X<3\\,\\,\\text{or}\\,\\,Y>2)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X<3\\,\\,\\text{or}\\,\\,Y>2) & =P((X,Y)\\in {(2,1),(2,2),(2,3),(3,3)}) \\\\  & =P((X,Y)=(2,1))+P((X,Y)=(2,2)) \\\\  & +P((X,Y)=(2,3))+P((X,Y)=(3,3)) \\\\  & =f(2,1)+f(2,2)+f(2,3)+f(3,3) \\\\  & =0.1+0.15+0.3+0.15 \\\\  & =0.7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341742 :knowledge-point/_questions [{:knowledge-point/id #uuid "e247e2c9-3e47-5cf4-be8d-f1f22bb30b39" :knowledge-point/title "Calculating a Joint Probability Containing Inequalities From a Table"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5ba6b5c-ff60-5b34-a0af-9bdacdd0f4ef" :answer/type {:db/ident :answer.type/math} :answer/value "0.05" :db/id #edb/ref 17592186341744} {:answer/id #uuid "168b07ef-264c-51e9-9152-c48239a92234" :answer/type {:db/ident :answer.type/math} :answer/value "0.3" :db/id #edb/ref 17592186341745} {:answer/id #uuid "f611bd8d-e965-5740-bd78-5912a1f6ce70" :answer/type {:db/ident :answer.type/math} :answer/value "0.25" :db/id #edb/ref 17592186341746} {:answer/id #uuid "1db6068d-4a9b-50ed-844c-e3e4dae7b8f5" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186341747} {:answer/id #uuid "bed37fe7-ac0d-581e-927c-e1eb23b6085e" :answer/type {:db/ident :answer.type/math} :answer/value "0.45" :db/id #edb/ref 17592186341748}] :answer-field/correct {:answer/id #uuid "1db6068d-4a9b-50ed-844c-e3e4dae7b8f5" :answer/type {:db/ident :answer.type/math} :answer/value "0.5" :db/id #edb/ref 17592186341747} :answer-field/id #uuid "2f87787d-dc49-51d0-8813-8cf6df012033" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341743}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87831530-3a25-531e-9050-ede8e0edb856" :question/math-academy-id "q-111081" :question/problem "|  | $Y=0$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- | --- |\n| $X=0$ | $0.15$ | $0.2$ | $0.06$ |\n| $X=1$ | $0.1$ | $0.2$ | $0.04$ |\n| $X=2$ | $0.05$ | $0.1$ | $0.1$ |\n\nCompute $P(X>1\\,\\,\\text{or}\\,\\,Y=0)$ given that the random variables $X$ and $Y$ have the joint probability mass function $f(x,y)$ shown in the table above." :question/worked-solution "Using the values in the table, we have\n\n$$\n\\begin{aligned}P(X>1\\,\\,\\text{or}\\,\\,Y=0) & =P((X,Y)\\in {(0,0),(1,0),(2,0),(2,1),(2,2)}) \\\\  & =P((X,Y)=(0,0))+P((X,Y)=(1,0))+P((X,Y)=(2,0)) \\\\  & +P((X,Y)=(2,1))+P((X,Y)=(2,2)) \\\\  & =f(0,0)+f(1,0)+f(2,0)+f(2,1)+f(2,2) \\\\  & =0.15+0.1+0.05+0.1+0.1 \\\\  & =0.5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186341749 :knowledge-point/_questions [{:knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4d66dd33-8d1c-539f-9bde-8d792d0cbd8e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186341751} {:answer/id #uuid "2d33475a-00ee-54b5-84bf-510e3ed60604" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341752} {:answer/id #uuid "10a21add-589e-5877-8ea9-0f19150358d9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341753} {:answer/id #uuid "cbca439b-f6c0-5f83-8b39-34a24e099008" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186341754} {:answer/id #uuid "ce2bb0e8-37ed-5a89-8b71-03422fb70ad9" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341755}] :answer-field/correct {:answer/id #uuid "4d66dd33-8d1c-539f-9bde-8d792d0cbd8e" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186341751} :answer-field/id #uuid "297b63dc-d9e4-54dd-8557-fe1d23e6297d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341750}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e8d3156b-d3ae-5be3-a7d2-cf6d81a3de37" :question/math-academy-id "q-143865" :question/problem "| $f$ | $Y=0$ | $Y=1$ |\n| --- | --- | --- |\n| $X=0$ | $0.4$ | $0.3$ |\n| $X=1$ | $0.2$ | $0.1$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\n- $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n- ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n- $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is true. Every value of $f(x,y)$ in the table satisfies $0\\le f(x,y)\\le 1.$\n\n- Condition II is true. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.4+0.3+0.2+0.1=1\\,✓\\end{aligned}\n$$\n\n- Condition III is true. Because $f(x,y)$ satisfies conditions I and II, it is a valid probability mass function.\n\nTherefore, the correct answer is \"I, II, and III.\""}] [{:db/id #edb/ref 17592186341756 :knowledge-point/_questions [{:knowledge-point/id #uuid "38398622-ca45-5eb6-a589-96aec162960a" :knowledge-point/title "Finding the Joint Distribution of Two Discrete Random Variables"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "24f5b41d-885a-5b04-92c9-49c4d8dcc9ce" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186341758} {:answer/id #uuid "56f9b2ef-fa08-5ae3-ab9d-cfca1bb20f00" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186341759} {:answer/id #uuid "286cc1e8-6dee-558d-96ec-5d88a8bb84ea" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186341760} {:answer/id #uuid "44d2e239-0529-5dfe-95c6-5f63539c97a9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341761} {:answer/id #uuid "696e82b1-25cb-5d80-84f3-e29236fc6720" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186341762}] :answer-field/correct {:answer/id #uuid "44d2e239-0529-5dfe-95c6-5f63539c97a9" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186341761} :answer-field/id #uuid "91fda5b9-066b-51ab-bda2-f6fe97ae623c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186341757}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bc3ed1bd-e322-563f-9349-9795dbd7e4af" :question/math-academy-id "q-143867" :question/problem "| $f$ | $Y=1$ | $Y=2$ |\n| --- | --- | --- |\n| $X=2$ | $0.5$ | $0.1$ |\n| $X=3$ | $0.1$ | $0.2$ |\n\nConsider the function $f(x,y)$ shown in the table above. Which of the following conditions is true?\n\n- $0\\le f(x,y)\\le 1$ for all $(x,y)$ in $S$\n- ${\\sum }_{(x,y)\\in S}f(x,y)=1$\n- $f(x,y)$ is a valid joint probability mass function" :question/worked-solution "Let's check the given conditions:\n\n- Condition I is true. Every value of $f(x,y)$ in the table satisfies $0\\le f(x,y)\\le 1.$\n\n- Condition II is false. Adding up all the values of $f(x,y)$ shown in the table, we get\n\n$$\n\\begin{aligned}{\\sum }_{(x,y)\\in S}f(x,y) & =0.5+0.1+0.1+0.2=0.9\\ne 1\\,\\times \\end{aligned}\n$$\n\n- Condition III is false. Because