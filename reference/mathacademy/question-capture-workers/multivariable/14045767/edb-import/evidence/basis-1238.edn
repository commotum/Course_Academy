#{[{:db/id #edb/ref 17592186294434 :knowledge-point/_questions [{:knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593" :knowledge-point/title "Calculating the Curl of a Vector Field"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d283f95-54bf-5543-a3e0-0b16ed1817c8" :answer/type {:db/ident :answer.type/math} :answer/value "-6z\\,j+2\\,\\text{k}" :db/id #edb/ref 17592186294436} {:answer/id #uuid "3e7270e5-fb82-52ce-8533-fca2f9a580dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i" :db/id #edb/ref 17592186294437} {:answer/id #uuid "c775e906-d35f-59ca-adb9-303e359d87d1" :answer/type {:db/ident :answer.type/math} :answer/value "6z\\,j" :db/id #edb/ref 17592186294438} {:answer/id #uuid "28d7e6ed-54b5-5aa5-a4c8-6f7f98fdecd3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186294439} {:answer/id #uuid "f26d3808-820d-5590-9bfd-c4b888b3180b" :answer/type {:db/ident :answer.type/math} :answer/value "-6z\\,k" :db/id #edb/ref 17592186294440}] :answer-field/correct {:answer/id #uuid "c775e906-d35f-59ca-adb9-303e359d87d1" :answer/type {:db/ident :answer.type/math} :answer/value "6z\\,j" :db/id #edb/ref 17592186294438} :answer-field/id #uuid "a1b48c20-cda5-5a3d-88b9-877ca4dcbec0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294435}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bb2dffd2-9038-550e-ac80-acf29b387b94" :question/math-academy-id "q-105668" :question/problem "Given that $F(x,y,z)=3{z}^{2}\\,i+2y\\,j+k,$ what is $\\text{curl}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ 3{z}^{2} & 2y & 1\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}(1)-\\frac{∂}{∂z}(2y)]i-[\\frac{∂}{∂x}(1)-\\frac{∂}{∂z}(3{z}^{2})]j+[\\frac{∂}{∂x}(2y)-\\frac{∂}{∂y}(3{z}^{2})]k \\\\  & =(0-0)i-(0-6z)j+(0-0)k \\\\  & =6z\\,j.\\end{aligned}\n$$"}]}
