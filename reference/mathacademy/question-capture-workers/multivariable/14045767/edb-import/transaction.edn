y}^{2})\\,i+y{e}^{x}\\,j.$ Evaluate the scalar curl of $F$ at the point $(1,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(y{e}^{x})-\\frac{∂}{∂y}(2x+{y}^{2}) \\\\  & =y{e}^{x}-2y.\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(1,1),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(1,1)} & =(1){e}^{1}-2(1) \\\\  & =e-2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-126529/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b65b190-b587-5827-a160-b8df85b6227c"] :knowledge-point/questions ["q-126529"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126525/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "60de7bcf-814b-5ccb-b8e8-bce57a0b431c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-126525/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" :answer/id #uuid "7d03ba11-473f-506a-89e2-7473ca062f27" :answer/type :answer.type/math :answer/value "2{\\pi }^{2}" :db/ensure [:answer/validate]} {:db/id "q-126525/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "32e083f7-7105-597c-923d-4c3c80db36a2" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-126525/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "001f35a7-fac6-5caf-8ab5-ddb950d8f7a1" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-126525/selection/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc" :answer/id #uuid "3491aa08-76af-5e7d-9629-e786bfabb93f" :answer/type :answer.type/math :answer/value "\\frac{{\\pi }^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-126525/selection" :answer-field/id #uuid "a9657fda-c97b-5f9b-92f6-a20e38deab14" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126525/selection/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc" :answer-field/choices ["q-126525/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-126525/selection/aa76ea3c2bcf198aabf9b49d9f05d52d8f72c18a367ff0539bec41bc3dbc0f44" "q-126525/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-126525/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-126525/selection/b627bdd0369562afa8f12be8f167039ff5f7a2bdc550b832dce7f5205e0a89bc"] :db/ensure [:answer-field/validate]} {:db/id "q-126525" :question/id #uuid "761323b4-3599-5999-8d71-bf4e1fdb0618" :question/math-academy-id "q-126525" :question/problem "Consider the vector field $F(x,y)=\\operatorname{sin}⁡(x+y)\\,i+(x{y}^{2}+1)\\,j.$ Evaluate the scalar curl of $F$ at the point $(0,\\frac{\\pi }{2}).$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the *scalar* curl of $F$ is given by\n\n$$\n\\begin{aligned}\\frac{∂Q}{∂x}-\\frac{∂P}{∂y} & =\\frac{∂}{∂x}(x{y}^{2}+1)-\\frac{∂}{∂y}(\\operatorname{sin}⁡(x+y)) \\\\  & ={y}^{2}-\\operatorname{cos}⁡(x+y).\\end{aligned}\n$$\n\nFinally, we evaluate the scalar curl at the point $(0,\\frac{\\pi }{2}),$ and obtain\n\n$$\n\\begin{aligned}{(\\frac{∂Q}{∂x}-\\frac{∂P}{∂y})}_{(0,\\pi /2)} & ={(\\frac{\\pi }{2})}^{2}-\\operatorname{cos}⁡(0+\\frac{\\pi }{2}) \\\\  & =\\frac{{\\pi }^{2}}{4}-0 \\\\  & =\\frac{{\\pi }^{2}}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-126525/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b65b190-b587-582