} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ \\operatorname{ln}⁡(x+y) & y{z}^{2} & (x-z)\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}(x-z)-\\frac{∂}{∂z}(y{z}^{2})]i-[\\frac{∂}{∂x}(x-z)-\\frac{∂}{∂z}(\\operatorname{ln}⁡(x+y))]j+[\\frac{∂}{∂x}(y{z}^{2})-\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+y))]k \\\\  & =(0-2yz)i-(1-0)j+(0-\\frac{1}{x+y})k \\\\  & =-2yz\\,i-j-\\frac{1}{x+y}\\,k.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{curl}\\,F$ at the point $(2,-1,3),$ and obtain\n\n$$\n\\begin{aligned}(\\text{curl}\\,F)(2,-1,3) & =-2(-1)(3)\\,i-j-\\frac{1}{2+(-1)}\\,k \\\\  & =6\\,i-j-k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105698/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593"] :knowledge-point/questions ["q-105698"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131336/selection/4243ecc68d2ad90a0db198b368779b5d0c5ddbdc557f7f3042aa4b6b952a05ba" :answer/id #uuid "b81e0b59-d122-5530-afe5-cb41a315d400" :answer/type :answer.type/math :answer/value "z{e}^{yz}\\,i+xy{e}^{yz}\\,j-xz{e}^{yz}\\,k" :db/ensure [:answer/validate]} {:db/id "q-131336/selection/7a6e6c950c93329dbaa576a12464bf45a8bed10e2ee56eda6e6ddb54219810c7" :answer/id #uuid "98035247-a51a-57a9-99aa-45e957050da7" :answer/type :answer.type/math :answer/value "(z{e}^{yz}-y)\\,i+(xy{e}^{yz}-z)\\,j-{x}^{2}{e}^{yz}\\,k" :db/ensure [:answer/validate]} {:db/id "q-131336/selection/a8670e6e2fb9dda2213b6c44a67302e9b68940cb86c7f9f38fbf88896332b265" :answer/id #uuid "df1620ff-3d15-50b3-9dec-2c5ecafb5218" :answer/type :answer.type/math :answer/value "(z{e}^{yz}-y)\\,i+xy{e}^{yz}\\,j-xz{e}^{yz}\\,k" :db/ensure [:answer/validate]} {:db/id "q-131336/selection/90b83763290c777d4f1db9a1a164c16fb4b3f1093f27693da6b3e0bbdaaf6c92" :answer/id #uuid "554e3677-07f7-509f-adf4-505808f5a9b7" :answer/type :answer.type/math :answer/value "-y\\,i+xy{e}^{yz}\\,j+xz{e}^{yz}\\,k" :db/ensure [:answer/validate]} {:db/id "q-131336/selection/f882b833433fd08cd52343145966e2bc78fee0bfc06971c1b4d9e0038ba38d1c" :answer/id #uuid "42317664-5096-5d30-9b04-50e6f810a96c" :answer/type :answer.type/math :answer/value "(x{e}^{yz}-z)\\,i+x{e}^{yz}\\,j-xz{e}^{yz}\\,k" :db/ensure [:answer/validate]} {:db/id "q-131336/selection" :answer-field/id #uuid "8a2c5cf3-6683-57e2-9497-241a19c84c0f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131336/selection/a8670e6e2fb9dda2213b6c44a67302e9b68940cb86c7f9f38fbf88896332b265" :answer-field/choices ["q-131336/selection/4243ecc68d2ad90a0db198b368779b5d0c5ddbdc557f7f3042aa4b6b952a05ba" "q-131336/selection/7a6e6c950c93329dbaa576a12464bf45a8bed10e2ee56eda6e6ddb54219810c7" "q-131336/selection/a8670e6e2fb9dda2213b6c44a67302e9b68940cb86c7f9f38fbf88896332b265" "q-131336/selection/90b83763290c777d4f1db9a1a164c16fb4b3f1093f27693da6b3e0bbdaaf6c92" "q-131336/selection/f882b833433fd08cd52343145966e2bc78fee0bfc06971c1b4d9e0038ba38d1c"] :db/ensure [:answer-field/validate]} {:db/id "q-131336" :question/id #uuid "7a9c30bf-0310-5343-83be-a605b82a4ed4" :question/math-academy-id "q-131336" :question/problem "Given that $F(x,y,z)=x{e}^{yz}\\,i+yz\\,j+{e}^{yz}\\,k,$ what is $\\text{curl}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ x{e}^{yz} & yz & {e}^{yz}\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}({e}^{yz})-\\frac{∂}{∂z}(yz)]i-[\\frac{∂}{∂x}({e}^{yz})-\\frac{∂}{∂z}(x{e}^{yz})]j+[\\frac{∂}{∂x}(yz)-\\frac{∂}{∂y}(x{e}^{yz})]k \\\\  & =(z{e}^{yz}-y)\\,i-(0-xy{e}^{yz})\\,j+(0-xz{e}^{yz})\\,k \\\\  & =(z{e}^{yz}-y)\\,i+xy{e}^{yz}\\,j-xz{e}^{yz}\\,k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131336/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593"] :knowledge-point/questions ["q-131336"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131340/selection/d7e6cc00fc1530513beb903e1fb75ffc34f9a6c6532817674e9845fceb8248f6" :answer/id #uuid "c1292a88-f2b4-52b2-9e21-8ecbdbfd2557" :answer/type :answer.type/math :answer/value "-\\,i-2\\,k" :db/ensure [:answer/validate]} {:db/id "q-131340/selection/12d3adbf9233a5d3cf71cead96c28f0a62a0fcc593dcc3840b4d4532c5c9bc45" :answer/id #uuid "dafa6922-f478-54a9-a665-3bb4d18ce1e2" :answer/type :answer.type/math :answer/value "2\\,i+\\,k" :db/ensure [:answer/validate]} {:db/id "q-131340/selection/e225e4b77e66456a8b9fa34ce17e82b146e017e8e05ea8d7ca85e588b7d974b2" :answer/id #uuid "7c3a0df6-b7d6-5d1a-90dc-aa6746bf9ff3" :answer/type :answer.type/math :answer/value "\\,j+\\,k" :db/ensure [:answer/validate]} {:db/id "q-131340/selection/632c86f9f612c847561fceb7f3b259d6fa44977fb86cd1caefffb255b867f94e" :answer/id #uuid "c17eb1da-e71e-5257-8298-c45e40ae46c3" :answer/type :answer.type/math :answer/value "2\\,j-3\\,k" :db/ensure [:answer/validate]} {:db/id "q-131340/selection/d837d8e26b4d982f04d390bb83d0f5a2ead7080f69736dda9704e514c285fe1d" :answer/id #uuid "20934b7c-baec-5ab7-8b75-946d5ba4e04c" :answer/type :answer.type/math :answer/value "3\\,i+\\,j" :db/ensure [:answer/validate]} {:db/id "q-131340/selection" :answer-field/id #uuid "603eb7a6-9687-577f-aa2d-364b79bfca3e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131340/selection/12d3adbf9233a5d3cf71cead96c28f0a62a0fcc593dcc3840b4d4532c5c9bc45" :answer-field/choices ["q-131340/selection/d7e6cc00fc1530513beb903e1fb75ffc34f9a6c6532817674e9845fceb8248f6" "q-131340/selection/12d3adbf9233a5d3cf71cead96c28f0a62a0fcc593dcc3840b4d4532c5c9bc45" "q-131340/selection/e225e4b77e66456a8b9fa34ce17e82b146e017e8e05ea8d7ca85e588b7d974b2" "q-131340/selection/632c86f9f612c847561fceb7f3b259d6fa44977fb86cd1caefffb255b867f94e" "q-131340/selection/d837d8e26b4d982f04d390bb83d0f5a2ead7080f69736dda9704e514c285fe1d"] :db/ensure [:answer-field/validate]} {:db/id "q-131340" :question/id #uuid "119c787c-79ba-5ec1-aa8b-ef2fb283c3d8" :question/math-academy-id "q-131340" :question/problem "Consider the vector field $F={x}^{2}\\,i+xz\\,j+{z}^{2}\\,k.$ Evaluate $∇\\times F$ at the point  $(-2,-3,1).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ {x}^{2} & xz & {z}^{2}\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}({z}^{2})-\\frac{∂}{∂z}(xz)]i-[\\frac{∂}{∂x}({z}^{2})-\\frac{∂}{∂z}({x}^{2})]j+[\\frac{∂}{∂x}(xz)-\\frac{∂}{∂y}({x}^{2})]k \\\\  & =(0-x)i-(0-0)j+(z-0)k \\\\  & =-x\\,i+z\\,k.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{curl}\\,F$ at the point $(-2,-3,1),$ and obtain\n\n$$\n\\begin{aligned}(\\text{curl}\\,F)(-2,-3,1) & =-(-2)\\,i+(1)\\,k \\\\  & =2\\,i+\\,k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-131340/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593"] :knowledge-point/questions ["q-131340"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126529/selection/74b9878323186062e434675fc3ee407e9e4a746d2cc85ca785d4664ca99bda01"