[{:db/id "q-105672/selection/bc36be6b18f70c0caece735133bc04aff97580c26301deddf61e88f3bc99f521" :answer/id #uuid "c61d8ff7-7d70-5544-9d66-b63390590bbe" :answer/type :answer.type/math :answer/value "-2\\,k" :db/ensure [:answer/validate]} {:db/id "q-105672/selection/36480f6fb66ac3efe7913548d42445edc50c3f94b9eca7c50a8e98045f3bfaa7" :answer/id #uuid "300655e9-9738-51f6-85b2-f8c4e4a80253" :answer/type :answer.type/math :answer/value "-3\\,j+k" :db/ensure [:answer/validate]} {:db/id "q-105672/selection/18be26e12bf914c5769dd7fd9f45a124fb3e7645aab9c6c9751e9c56f13aa5a4" :answer/id #uuid "f1825438-e432-5313-b3cf-b0956965364a" :answer/type :answer.type/math :answer/value "-2\\,i+2\\,j-k" :db/ensure [:answer/validate]} {:db/id "q-105672/selection/c7c5651e05d5c17189f126ead8bbc496acf9f90ca232104afffe512fab961a36" :answer/id #uuid "0fe7a4ef-cfa8-5670-ad72-bd731a8e76b9" :answer/type :answer.type/math :answer/value "3\\,k" :db/ensure [:answer/validate]} {:db/id "q-105672/selection/532bc50e5b31e0322dca37132dea7cd858727c2fed8e5b9b7b209c9c10111f2f" :answer/id #uuid "e54c89f0-d3b0-575f-a141-810035dd3e34" :answer/type :answer.type/math :answer/value "i-2\\,j+k" :db/ensure [:answer/validate]} {:db/id "q-105672/selection" :answer-field/id #uuid "397a8fb0-cccd-539d-86cf-d5a0a54548fa" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-105672/selection/18be26e12bf914c5769dd7fd9f45a124fb3e7645aab9c6c9751e9c56f13aa5a4" :answer-field/choices ["q-105672/selection/bc36be6b18f70c0caece735133bc04aff97580c26301deddf61e88f3bc99f521" "q-105672/selection/36480f6fb66ac3efe7913548d42445edc50c3f94b9eca7c50a8e98045f3bfaa7" "q-105672/selection/18be26e12bf914c5769dd7fd9f45a124fb3e7645aab9c6c9751e9c56f13aa5a4" "q-105672/selection/c7c5651e05d5c17189f126ead8bbc496acf9f90ca232104afffe512fab961a36" "q-105672/selection/532bc50e5b31e0322dca37132dea7cd858727c2fed8e5b9b7b209c9c10111f2f"] :db/ensure [:answer-field/validate]} {:db/id "q-105672" :question/id #uuid "155bec12-a4b6-5c96-ba0a-161752e85f84" :question/math-academy-id "q-105672" :question/problem "Consider the vector field $F={e}^{y+z}\\,i+j+xyz\\,k.$ Evaluate $∇\\times F$ at the point  $(2,1,-1).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the curl of $F$ is the vector field given by\n\n$$\ncurl\\,F=∇\\times F=|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ P & Q & R\\end{aligned}|.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{curl}\\,F & =|\\begin{aligned}i & j & k \\\\ \\frac{∂}{∂x} & \\frac{∂}{∂y} & \\frac{∂}{∂z} \\\\ {e}^{y+z} & 1 & xyz\\end{aligned}| \\\\  & =[\\frac{∂}{∂y}(xyz)-\\frac{∂}{∂z}(1)]i-[\\frac{∂}{∂x}(xyz)-\\frac{∂}{∂z}({e}^{y+z})]j+[\\frac{∂}{∂x}(1)-\\frac{∂}{∂y}({e}^{y+z})]k \\\\  & =(xz-0)i-(yz-{e}^{y+z})j+(0-{e}^{y+z})k \\\\  & =xz\\,i+({e}^{y+z}-yz)j-{e}^{y+z}\\,k.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{curl}\\,F$ at the point $(2,1,-1),$ and obtain\n\n$$\n\\begin{aligned}(\\text{curl}\\,F)(2,1,-1) & =2(-1)\\,i+({e}^{1+(-1)}-1(-1))j-{e}^{1+(-1)}\\,k \\\\  & =-2\\,i+2\\,j-k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-105672/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3ad4e453-00da-5c77-8d6a-5de4dc3d5593"] :knowledge-point/questions ["q-105672"] :db/ensure [:knowledge-point/validate]} {:db/id "q-105698/selection/31436859803a70dce1d77e19f34e75655008e3dd6fb1ece2552e866ffc4670bc" :answer/id #uuid "84405628-33f9-5791-a299-783052ed3a37" :answer/type :answer.type/math :answer/value "i+2\\,j+3\\,k" :db/ensure [:answer/validate]} {:db/id "q-105698/selection/c4826504f944dc003f40e7c3012bf648cfdceea6a1404488d7d9e6a5fdfec106" :answer/id #uuid "29983acd-2b30-5c77-b9a0-e27fc951281e" :answer/type :answer.type/math :answer/value "j-6\\,k" :db/ensure [:answer/validate]} {:db/id "q-105698/selection/4c63aa0f7ff4a3aa6992c