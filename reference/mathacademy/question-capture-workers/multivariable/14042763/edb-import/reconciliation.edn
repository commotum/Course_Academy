ext{d}t} & =1 \\\\ \\int {e}^{2x}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int \\,\\text{d}t \\\\ \\int {e}^{2x}\\,\\text{d}x & =\\int \\,\\text{d}t \\\\ \\frac{1}{2}{e}^{2x} & =t+K \\\\ {e}^{2x} & =2t+C \\\\ 2x & =\\operatorname{ln}⁡(2t+C) \\\\ x & =\\frac{1}{2}\\operatorname{ln}⁡(2t+C)\\end{aligned}\n$$\n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=1,$ and the particular solution is\n\n$$\nx(t)=\\frac{1}{2}\\operatorname{ln}⁡(2t+1).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122325" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/activity-metadata.json" "file_sha256" "785f7610edd208db81cfb7c4ec13a140b5ce47e04ba0e053de3c67f7552cdd94"} {"question" "q-122325" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122325" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x(t)=2\\operatorname{ln}⁡(4t+1)"] ["math" "x(t)=2t\\operatorname{ln}⁡(t+2)"] ["math" "x(t)=\\frac{1}{2}\\operatorname{ln}⁡(2t+1)"] ["math" "x(t)=\\operatorname{ln}⁡(2t+1)"] ["math" "x(t)={t}^{2}\\operatorname{ln}⁡(t+2)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122325" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x(t)=\\frac{1}{2}\\operatorname{ln}⁡(2t+1)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122316" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\ge 0.$ When the displacement of $P$ from the origin $O$ is $x$ meters, the velocity is given by $v(x)=\\frac{1}{(1+x)^{2}}\\,m/s.$ Initially, $P$ is at the origin $O.$ Find $x$ as a function of time $t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122316" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/assets/2093298b6cacb0b29f874d401ccca40560517ff5887763e9a2b88bf4bc051abb.png)\n\nWe're given that the velocity function $v(x)$ is\n\n$$\nv(x)=\\frac{1}{(1+x)^{2}}.\n$$\n\nWe know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=\\frac{1}{(1+x)^{2}}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{1}{(1+x)^{2}} \\\\ (1+x)^{2}\\frac{\\text{d}x}{\\text{d}t} & =1 \\\\ \\int (1+x)^{2}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int \\,\\text{d}t \\\\ \\int (1+x)^{2}\\,\\text{d}x & =\\int \\,\\text{d}t \\\\ \\frac{1}{3}(1+x)^{3} & =t+K \\\\ (1+x)^{3} & =3t+C \\\\ 1+x & =\\sqrt[3]{3t+C} \\\\ x & =\\sqrt[3]{3t+C}-1\\end{aligned}\n$$\n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=1,$ and the particular solution is\n\n$$\nx(t)=\\sqrt[3]{3t+1}-1.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122316" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/activity-metadata.json" "file_sha256" "785f7610edd208db81cfb7c4ec13a140b5ce47e04ba0e053de3c67f7552cdd94"} {"question" "q-122316" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122316" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "x(t)=2\\sqrt[3]{3t+1}-2"] ["math" "x(t)=\\sqrt[3]{(t+1)^{2}}-1"] ["math" "x(t)=\\sqrt[3]{1-t}-1"] ["math" "x(t)=\\sqrt[3]{3t+1}-1"] ["math" "x(t)=\\sqrt[3]{3t-1}+1"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "q-122316" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "x(t)=\\sqrt[3]{3t+1}-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/state.json" "file_sha256" "c7aab2d70df29993bcf3933ea0964c05d6c71bd11eb5e3841881fcf936561eec"} {"question" "e-9050" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves along the $x$-axis where $x>0$. When the displacement of $P$ from the origin $O$ is $x$ meters, its velocity is $v\\, \\rm{ m/s}$ and the magnitude of its acceleration is $\\sin^2 x \\,\\rm{m/s}^2.$ Given that the acceleration is directed toward $O,$ what differential equation describes this motion?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/example-9050.json" "file_sha256" "afb3778923fb28de393f7b033f75d195e83cd624e3ec9934a5fcb0c08076ab01"} {"question" "e-9050" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/assets/f187eff194f136838b67ab12b44f8f6882eafb59885a5c3f440d41492def4a42.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\sin^2 x$ and is directed *toward* $O,$ we have\n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t} = -\\sin^2 x.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=-{sin}^{2}⁡x.\\end{aligned}\n$$\n\nNow, since $v= \\dfrac{\\textrm{d}x}{\\textrm{d}t},$ we have\n\n$$\nv \\dfrac{\\textrm{d}v}{\\textrm{d}x} = -\\sin^2 x.\\qquad \\qquad (\\ast)\n$$\n\nFinally, using the fact that\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(v^2) = 2v\\dfrac{\\textrm d v}{\\textrm d x}\n\\quad\\Longrightarrow\\quad \n\\dfrac{\\textrm d }{\\textrm d x}\\left(\\dfrac12v^2\\right) = v\\dfrac{\\textrm d v}{\\textrm d x},\n$$\n\nwe can write our differential equation $(\\ast)$ as\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}\\left(\\dfrac12v^2\\right) = -\\sin^2 x.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/example-9050.json" "file_sha256" "afb3778923fb28de393f7b033f75d195e83cd624e3ec9934a5fcb0c08076ab01"} {"question" "e-9051" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves along the $x$-axis in the direction of increasing $x,$ away from a fixed origin $O.$ When the displacement of $P$ from $O$ is $x \\,\\rm{m},$ its velocity is $v\\,\\rm{m/s}$ and its acceleration is $(2x + e^{x-2}) \\, \\rm{m/s}^2.$ If $v = 4 \\, \\rm{m/s}$ when $x = 2 \\, \\textrm m,$ find the velocity of $P$ when $x = 1 \\, \\textrm m.$ Round your answer to two decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/example-9051.json" "file_sha256" "4c7d45127b6f4c8cd190ec3043851ab25245a828fb378c302cc495d2ceb6fc11"} {"question" "e-9051" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/assets/4fdd70a4ca80965c0adce9c60be36b0712852b662cff69f9733f50c739fd1b32.png)\n\nSince the acceleration of the particle $P$ is $(2x + e^{x-2}) \\,\\rm{m/s}^2,$ we have\n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t} = 2x + e^{x-2}.\n$$\n\nUsing the fact that \n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t}= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right)\n$$\n\nwe can rewrite our equation as\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right) = 2x + e^{x-2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int (2x+{e}^{x-2})\\,\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\dfrac{1}{2}v^2 = x^2 + e^{x-2} + C.\n$$\n\nNow, since $v = 4 \\, \\rm{m/s}$ when $x = 2 \\, \\textrm m,$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}(4)^{2} & ={2}^{2}+{e}^{2-2}+C \\\\ 8 & =4+1+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={x}^{2}+{e}^{x-2}+3 \\\\ {v}^{2} & =2({x}^{2}+{e}^{x-2}+3) \\\\ v & =\\pm \\sqrt{2({x}^{2}+{e}^{x-2}+3)}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x) \\gt 0,$ so we can discard the negative square root. Therefore,\n\n$$\nv = \\sqrt{2\\left(x^2 + e^{x-2} + 3\\right)}.\n$$\n\nFinally, the velocity of $P$ at $x = 1$ is given by\n\n$$\n\\begin{aligned}v & =\\sqrt{2({1}^{2}+{e}^{1-2}+3)} \\\\  & =\\sqrt{2(4+{e}^{-1})} \\\\  & ≈2.96\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to two decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/example-9051.json" "file_sha256" "4c7d45127b6f4c8cd190ec3043851ab25245a828fb378c302cc495d2ceb6fc11"} {"question" "e-9455" "field" nil "attribute" "question/problem" "value" "A particle $P$ moves along the $x$-axis in the direction of increasing $x$ where $x\\geq 0.$ When the displacement of $P$ from the origin $O$ is $x\\,\\textrm m,$ the magnitude of its acceleration is $\\dfrac{2}{(x+1)^2}\\, \\rm{m/s}^2$ and is directed toward $O.$ Initially, $P$ is at the origin $O$ and has velocity $v=2\\,\\rm{m/s}.$ Find $x$ as a function of time $t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/example-9455.json" "file_sha256" "fbf973eafcbcd65371fe704f8f937b5d2f98f572a80dbb647209f82c6bb569bf"} {"question" "e-9455" "field" nil "attribute" "question/worked-solution" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/assets/eca36626e6a0cfb30d293e684483c37ddce6f18d4004c3f77258e9663565d8d7.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\dfrac{2}{(x+1)^2}\\, \\rm{m/s}^2$ and is directed *toward* $O,$ we have\n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t} =-\\dfrac{2}{(x+1)^2}.\n$$\n\nUsing the fact that \n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t}= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right)\n$$\n\nwe can rewrite our equation as\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right) = -\\dfrac{2}{(x+1)^2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int -\\frac{2}{(x+1)^{2}}\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{2}{x+1}+K.\\end{aligned}\n$$\n\nNow, since $v=2\\,\\rm{m/s}$ when $x=0\\, \\textrm{m},$ we can find the value of the constant $K,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{2}{x+1}+K \\\\ \\frac{1}{2}(2)^{2} & =\\frac{2}{0+1}+K \\\\ 2 & =2+K \\\\ K & =0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{2}{x+1} \\\\ {v}^{2} & =\\frac{4}{x+1} \\\\ v & =\\pm \\frac{2}{\\sqrt{x+1}}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing  $x,$ we have that $v(x) > 0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x) = \\dfrac{2}{\\sqrt{x+1}}.\n$$\n\nNow, we know that $v= \\dfrac{\\textrm{d}x}{\\textrm{d}t}.$ Therefore, we have the equation\n\n$$\n\\dfrac{\\textrm{d}x}{\\textrm{d}t} = \\dfrac{2}{\\sqrt{x+1}}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{2}{\\sqrt{x+1}} \\\\ \\sqrt{x+1}\\,\\frac{\\text{d}x}{\\text{d}t} & =2 \\\\ \\int \\sqrt{x+1}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int 2\\,\\text{d}t \\\\ \\int \\sqrt{x+1}\\,\\text{d}x & =\\int 2\\,\\text{d}t \\\\ \\frac{2}{3}(x+1)^{3/2} & =2t+{C}_{1} \\\\ (x+1)^{3/2} & =3t+C\\end{aligned}\n$$\n\nwhere $C = \\dfrac{3C_1}{2}.$ \n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=1,$ and the particular solution is\n\n$$\n(x+1)^{3/2} =3t+1.\n$$\n\nFinally, writing $x$ in terms of $t,$ we have\n\n$$\n\\begin{aligned}(x+1)^{3/2} & =3t+1 \\\\ x+1 & =(3t+1)^{2/3} \\\\ x & =(3t+1)^{2/3}-1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14042763/example-9455.json" "file_sha256" "fbf973eafcbcd65371fe704f8f937b5d2f98f572a80dbb647209f82c6bb569bf"}] "usage" {"e-9455" [] "q-122349" [] "q-122325" [] "e-9051" [] "q-122337" [] "q-122313" [] "q-108010" [] "q-122312" [] "q-122315" [] "e-9050" []} "basis" 1576 "retractions" [[17592186167003 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/52fc197612dac35373ecebf771b8444505902b5c6e00c7c55d2b21dab4809136.png)\n\nSince the acceleration of the particle $P$ has magnitude $6{x}^{3}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-6{x}^{3}.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=-6{x}^{3}.\\end{aligned}\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we have\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=6{x}^{3}.\\,\\,(∗)\n$$\n\nFinally, using the fact that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({v}^{2})=2v\\frac{\\text{d}v}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=v\\frac{\\text{d}v}{\\text{d}x},\n$$\n\nwe can write our differential equation $(∗)$ as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-6{x}^{3}.\n$$"] [17592186314074 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/00da8cdff7814df7368ff00924360db24a93934c5ae1c87ceb5daa6b00df37a7.png)\n\nSince the acceleration of the particle $P$ is $\\sqrt{{x}^{2}+3}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-\\sqrt{{x}^{2}+3}.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=-\\sqrt{{x}^{2}+3}.\\end{aligned}\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we have\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=-\\sqrt{{x}^{2}+3}.\\,\\,(∗)\n$$\n\nFinally, using the fact that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({v}^{2})=2v\\frac{\\text{d}v}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=v\\frac{\\text{d}v}{\\text{d}x},\n$$\n\nwe can write our differential equation $(∗)$ as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-\\sqrt{{x}^{2}+3}.\n$$"] [17592186314081 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/785776cee4f82c5bfa5e86b5b1cb746b7c80f2d702fb52f67055a60bdff249ae.png)\n\nSince the acceleration of the particle $P$ is $(3{e}^{x}+1)\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=3{e}^{x}+1.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=3{e}^{x}+1.\\end{aligned}\n$$\n\nNow, since $v=\\frac{\\text{d}x}{\\text{d}t},$ we have\n\n$$\nv\\frac{\\text{d}v}{\\text{d}x}=3{e}^{x}+1.\\,\\,(∗)\n$$\n\nFinally, using the fact that\n\n$$\n\\frac{\\text{d}}{\\text{d}x}({v}^{2})=2v\\frac{\\text{d}v}{\\text{d}x}\\,⟹\\,\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=v\\frac{\\text{d}v}{\\text{d}x},\n$$\n\nwe can write our differential equation $(∗)$ as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=3{e}^{x}+1.\n$$"] [17592186314095 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/164c90893a07ae9657e90b6f2b25e53c9c4927b1f4a076429ba0521a98377f24.png)\n\nSince the acceleration of the particle $P$ is ${e}^{x-3}\\,{m/s}^{2},$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}={e}^{x-3}.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2}),\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})={e}^{x-3}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\text{d}x=\\int {e}^{x-3}\\,\\text{d}x\n$$\n\nwhich gives the general solution\n\n$$\n\\frac{1}{2}{v}^{2}={e}^{x-3}+C.\n$$\n\nNow, since $x=3\\,\\text{m}$ when $v=2\\,\\text{m/s},$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={e}^{x-3}+C \\\\ \\frac{1}{2}(2)^{2} & ={e}^{3-3}+C \\\\ 2 & =1+C \\\\ C & =1\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={e}^{x-3}+1 \\\\ {v}^{2} & =2({e}^{x-3}+1) \\\\ v & =\\pm \\sqrt{2({e}^{x-3}+1)}.\\end{aligned}\n$$\n\nFinally, since the particle is moving in the direction of increasing  $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=\\sqrt{2({e}^{x-3}+1)}.\n$$"] [17592186314130 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/141c6dd6c91841238298b86fac1063c76faeb7cd103e13d2723f6ac05ed58f50.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\frac{32}{(x+2)^{5}}\\,{m/s}^{2}$ and is directed *toward* $O,$ we have\n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=-\\frac{32}{(x+2)^{5}}.\n$$\n\nUsing the fact that \n\n$$\n\\frac{\\text{d}v}{\\text{d}t}=\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\n$$\n\nwe can rewrite our equation as\n\n$$\n\\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})=-\\frac{32}{(x+2)^{5}}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int -\\frac{32}{(x+2)^{5}}\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}}+K.\\end{aligned}\n$$\n\nNow, since $v=1\\,\\text{m/s}$ when $x=0\\,\\text{m},$ we can find the value of the constant $K,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}}+K \\\\ \\frac{1}{2}(1)^{2} & =\\frac{8}{(0+2)^{4}}+K \\\\ \\frac{1}{2} & =\\frac{1}{2}+K \\\\ K & =0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{8}{(x+2)^{4}} \\\\ {v}^{2} & =\\frac{16}{(x+2)^{4}} \\\\ v & =\\pm \\frac{4}{(x+2)^{2}}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing  $x,$ we have that $v(x)>0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x)=\\frac{4}{(x+2)^{2}}.\n$$\n\nNow, we know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=\\frac{4}{(x+2)^{2}}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{4}{(x+2)^{2}} \\\\ (x+2)^{2}\\frac{\\text{d}x}{\\text{d}t} & =4 \\\\ \\int (x+2)^{2}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int 4\\,\\text{d}t \\\\ \\int (x+2)^{2}\\text{d}x & =\\int 4\\,\\text{d}t \\\\ \\frac{1}{3}(x+2)^{3} & =4t+{C}_{1} \\\\ (x+2)^{3} & =12t+C\\end{aligned}\n$$\n\nwhere $C=3{C}_{1}.$ \n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=8,$ and the particular solution is\n\n$$\n(x+2)^{3}=12t+8.\n$$\n\nFinally, writing $x$ in terms of $t,$ we have\n\n$$\n\\begin{aligned}(x+2)^{3} & =12t+8 \\\\ x+2 & =\\sqrt[3]{12t+8} \\\\ x & =\\sqrt[3]{12t+8}-2.\\end{aligned}\n$$"] [17592186314067 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/59c4a51d419b6e42633579b687cde16a2842895c589f818942c10aa304bc98a7.png)\n\nWe're given that the velocity function $v(x)$ is\n\n$$\nv(x)=1+4{x}^{2}.\n$$\n\nWe know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}=1+4{x}^{2}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =1+4{x}^{2} \\\\ \\frac{1}{1+4{x}^{2}}\\frac{\\text{d}x}{\\text{d}t} & =1 \\\\ \\int \\frac{1}{1+4{x}^{2}}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int \\,\\text{d}t \\\\ \\int \\frac{1}{1+(2x)^{2}}\\,\\text{d}x & =\\int \\,\\text{d}t \\\\ \\frac{1}{2}\\operatorname{arctan}⁡2x & =t+K \\\\ 2x & =\\operatorname{tan}⁡(2t+C) \\\\ x & =\\frac{1}{2}\\operatorname{tan}⁡(2t+C)\\end{aligned}\n$$\n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=0,$ and the particular solution is\n\n$$\nx(t)=\\frac{1}{2}\\operatorname{tan}⁡2t.\n$$"] [17592186314088 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/8faba5a783797f7025f51ec1ae587cb68355dff7138278689346c2f713275562.png)\n\nWe're given that the velocity function $v(x)$ is\n\n$$\nv(x)={e}^{-2x}.\n$$\n\nWe know that $v=\\frac{\\text{d}x}{\\text{d}t}.$ Therefore, we have the equation\n\n$$\n\\frac{\\text{d}x}{\\text{d}t}={e}^{-2x}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & ={e}^{-2x} \\\\ \\frac{1}{{e}^{-2x}}\\frac{\\text{d}x}{\\text{d}t} & =1 \\\\ \\int {e}^{2x}\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int \\,\\text{d}t \\\\ \\int {e}^{2x}\\,\\text{d}x & =\\int \\,\\text{d}t \\\\ \\frac{1}{2}{e}^{2x} & =t+K \\\\ {e}^{2x} & =2t+C \\\\ 2x & =\\operatorname{ln}⁡(2t+C) \\\\ x & =\\frac{1}{2}\\operatorname{ln}⁡(2t+C)\\end{aligned}\n$$\n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=1,$ and the particular solution is\n\n$$\nx(t)=\\frac{1}{2}\\operatorname{ln}⁡(2t+1).\n$$"] [17592186166634 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/f187eff194f136838b67ab12b44f8f6882eafb59885a5c3f440d41492def4a42.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\sin^2 x$ and is directed *toward* $O,$ we have\n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t} = -\\sin^2 x.\n$$\n\nUsing the chain rule for differentiation, we can rewrite this equation as\n\n$$\n\\begin{aligned}\\frac{\\text{d}v}{\\text{d}x}\\cdot \\frac{\\text{d}x}{\\text{d}t}=-{sin}^{2}⁡x.\\end{aligned}\n$$\n\nNow, since $v= \\dfrac{\\textrm{d}x}{\\textrm{d}t},$ we have\n\n$$\nv \\dfrac{\\textrm{d}v}{\\textrm{d}x} = -\\sin^2 x.\\qquad \\qquad (\\ast)\n$$\n\nFinally, using the fact that\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}(v^2) = 2v\\dfrac{\\textrm d v}{\\textrm d x}\n\\quad\\Longrightarrow\\quad \n\\dfrac{\\textrm d }{\\textrm d x}\\left(\\dfrac12v^2\\right) = v\\dfrac{\\textrm d v}{\\textrm d x},\n$$\n\nwe can write our differential equation $(\\ast)$ as\n\n$$\n\\dfrac{\\textrm d }{\\textrm d x}\\left(\\dfrac12v^2\\right) = -\\sin^2 x.\n$$"] [17592186166635 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/4fdd70a4ca80965c0adce9c60be36b0712852b662cff69f9733f50c739fd1b32.png)\n\nSince the acceleration of the particle $P$ is $(2x + e^{x-2}) \\,\\rm{m/s}^2,$ we have\n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t} = 2x + e^{x-2}.\n$$\n\nUsing the fact that \n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t}= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right)\n$$\n\nwe can rewrite our equation as\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right) = 2x + e^{x-2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int (2x+{e}^{x-2})\\,\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\dfrac{1}{2}v^2 = x^2 + e^{x-2} + C.\n$$\n\nNow, since $v = 4 \\, \\rm{m/s}$ when $x = 2 \\, \\textrm m,$ we can find the value of the constant $C$, as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}(4)^{2} & ={2}^{2}+{e}^{2-2}+C \\\\ 8 & =4+1+C \\\\ C & =3\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & ={x}^{2}+{e}^{x-2}+3 \\\\ {v}^{2} & =2({x}^{2}+{e}^{x-2}+3) \\\\ v & =\\pm \\sqrt{2({x}^{2}+{e}^{x-2}+3)}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing $x,$ we have that $v(x) \\gt 0,$ so we can discard the negative square root. Therefore,\n\n$$\nv = \\sqrt{2\\left(x^2 + e^{x-2} + 3\\right)}.\n$$\n\nFinally, the velocity of $P$ at $x = 1$ is given by\n\n$$\n\\begin{aligned}v & =\\sqrt{2({1}^{2}+{e}^{1-2}+3)} \\\\  & =\\sqrt{2(4+{e}^{-1})} \\\\  & ≈2.96\\,\\text{m/s},\\end{aligned}\n$$\n\nrounded to two decimal places."] [17592186166644 :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14041958/assets/eca36626e6a0cfb30d293e684483c37ddce6f18d4004c3f77258e9663565d8d7.png)\n\nSince the acceleration of the particle $P$ has magnitude $\\dfrac{2}{(x+1)^2}\\, \\rm{m/s}^2$ and is directed *toward* $O,$ we have\n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t} =-\\dfrac{2}{(x+1)^2}.\n$$\n\nUsing the fact that \n\n$$\n\\dfrac{\\textrm{d}v}{\\textrm{d}t}= \\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right)\n$$\n\nwe can rewrite our equation as\n\n$$\n\\dfrac{\\textrm{d}}{\\textrm{d}x}\\left(\\dfrac{1}{2}v^2\\right) = -\\dfrac{2}{(x+1)^2}.\n$$\n\nIntegrating both sides of the above equation with respect to $x,$ we have\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}}{\\text{d}x}(\\frac{1}{2}{v}^{2})\\,\\text{d}x & =\\int -\\frac{2}{(x+1)^{2}}\\text{d}x\\end{aligned}\n$$\n\nwhich gives the general solution\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{2}{x+1}+K.\\end{aligned}\n$$\n\nNow, since $v=2\\,\\rm{m/s}$ when $x=0\\, \\textrm{m},$ we can find the value of the constant $K,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{2}{x+1}+K \\\\ \\frac{1}{2}(2)^{2} & =\\frac{2}{0+1}+K \\\\ 2 & =2+K \\\\ K & =0\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}\\frac{1}{2}{v}^{2} & =\\frac{2}{x+1} \\\\ {v}^{2} & =\\frac{4}{x+1} \\\\ v & =\\pm \\frac{2}{\\sqrt{x+1}}.\\end{aligned}\n$$\n\nSince the particle is moving in the direction of increasing  $x,$ we have that $v(x) > 0,$ so we can discard the negative square root. Therefore,\n\n$$\nv(x) = \\dfrac{2}{\\sqrt{x+1}}.\n$$\n\nNow, we know that $v= \\dfrac{\\textrm{d}x}{\\textrm{d}t}.$ Therefore, we have the equation\n\n$$\n\\dfrac{\\textrm{d}x}{\\textrm{d}t} = \\dfrac{2}{\\sqrt{x+1}}.\n$$\n\nSeparating the variables and integrating both sides with respect to $t,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{2}{\\sqrt{x+1}} \\\\ \\sqrt{x+1}\\,\\frac{\\text{d}x}{\\text{d}t} & =2 \\\\ \\int \\sqrt{x+1}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t & =\\int 2\\,\\text{d}t \\\\ \\int \\sqrt{x+1}\\,\\text{d}x & =\\int 2\\,\\text{d}t \\\\ \\frac{2}{3}(x+1)^{3/2} & =2t+{C}_{1} \\\\ (x+1)^{3/2} & =3t+C\\end{aligned}\n$$\n\nwhere $C = \\dfrac{3C_1}{2}.$ \n\nWe're given that $x=0$ when $t=0.$ Therefore, $C=1,$ and the particular solution is\n\n$$\n(x+1)^{3/2} =3t+1.\n$$\n\nFinally, writing $x$ in terms of $t,$ we have\n\n$$\n\\begin{aligned}(x+1)^{3/2} & =3t+1 \\\\ x+1 & =(3t+1)^{2/3} \\\\ x & =(3t+1)^{2/3}-1.\\end{aligned}\n$$"]] "immutable_answers" [17592186163437 17592186163438 17592186163439 17592186163440 17592186163441 17592186314069 17592186314070 17592186314071 17592186314072 17592186314073 17592186314076 17592186314077 17592186314078 17592186314079 17592186314080 17592186314083 17592186314084 17592186314085 17592186314086 17592186314087 17592186314090 17592186314091 17592186314092 17592186314093 17592186314094 17592186314097 17592186314098 17592186314099 17592186314100 17592186314101 17592186314132 17592186314133 17592186314134 17592186314135 17592186314136] "immutable_fi