cation.json"} {"question" "q-108337" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "(3,9,-5)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/state.json" "file_sha256" "3e91084ca6463f8dfa40c9cf75a3f2dee88d00a005a7e2d68df60aa979f6909c" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "q-108337" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "No intersection"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/state.json" "file_sha256" "3e91084ca6463f8dfa40c9cf75a3f2dee88d00a005a7e2d68df60aa979f6909c" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "q-108337" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-6,15,-2)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/state.json" "file_sha256" "3e91084ca6463f8dfa40c9cf75a3f2dee88d00a005a7e2d68df60aa979f6909c" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "e-4943" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $\\Pi$ with equations\n\n$$\nl: \\mathbf{r} = \\langle 5,3,-4 \\rangle + t \\langle 4,-2,-3 \\rangle, \\qquad \t\\Pi: \\mathbf{r} \\cdot \\langle -7,5,1 \\rangle = -65.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/example-4943.json" "file_sha256" "8edb8a76fae66456c262e287e09ade8f215c09e2a407d5996a2845e67714ce3e" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "e-4943" "field" nil "attribute" "question/worked-solution" "value" "Let's write the equation of the line as \n\n$$\n\\mathbf{r} = \\langle 5+4t , 3-2t, -4-3t \\rangle.\n$$\n\nNow, substituting $\\mathbf{r} = \\langle 5+4t , 3-2t, -4-3t \\rangle$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-7,5,1⟩ & =-65 \\\\ ⟨5+4t,3-2t,-4-3t⟩\\cdot ⟨-7,5,1⟩ & =-65 \\\\ -7(5+4t)+5(3-2t)+(-4-3t) & =-65 \\\\ -35-28t+15-10t-4-3t & =-65 \\\\ -41t & =-41 \\\\ t & =1.\\end{aligned}\n$$\n\nFinally, the position vector $\\mathbf{p}$ of the intersection point is obtained by substituting $t=1$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨5+4(1),3-2(1),-4-3(1)⟩ \\\\  & =⟨9,1,-7⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(9 , 1, -7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/example-4943.json" "file_sha256" "8edb8a76fae66456c262e287e09ade8f215c09e2a407d5996a2845e67714ce3e" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "e-4945" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $\\Pi$ with equations\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/assets/2a24a49f0fc47c235776597df655e75be9c68cffbb7988db16b36d9200f801bc.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/example-4945.json" "file_sha256" "6a873b12172db6b35a2242763fe671613aeef836257fb9a54e5a36985334892e" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "e-4945" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}3x+4y+6z+25 & =0 \\\\ 3(3-4t)+4(-1+2t)+6(2+3t)+25 & =0 \\\\ 9-12t-4+8t+12+18t+25 & =0 \\\\ 14t & =-42 \\\\ t & =-3\\end{aligned}\n$$\n\nTo get the position vector $\\mathbf{p}$ of the intersection point $P$, we substitute $t=-3$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=3-4(-3)=15 \\\\ y=-1+2(-3)=-7 \\\\ z=2+3(-3)=-7\\end{aligned}\n$$\n\nSo, the intersection point is $P(15,-7,-7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/example-4945.json" "file_sha256" "6a873b12172db6b35a2242763fe671613aeef836257fb9a54e5a36985334892e" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "e-4944" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $\\Pi$ with equations\n\n$$\nl: \\mathbf{r} = \\langle 1,3,1 \\rangle + t \\langle 2,1,0 \\rangle, \\qquad  \\Pi:4x-3y+2z-7 = 0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/example-4944.json" "file_sha256" "d9796b04b5eb6819adbc2727d2a4df50a56e1e44b90f1dcb63d9d778beadf4b8" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "e-4944" "field" nil "attribute" "question/worked-solution" "value" "Let's start by writing the equation of the line as\n\n$$\n\\mathbf{r} = \\langle 1+2t , 3+t, 1 \\rangle .\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}4x-3y+2z-7 & =0 \\\\ 4x-3y+2z & =7 \\\\ ⟨x,y,z⟩\\cdot ⟨4,-3,2⟩ & =7 \\\\ r\\cdot ⟨4,-3,2⟩ & =7\\end{aligned}\n$$\n\nNow, substituting $\\mathbf{r} = \\langle 1+2t , 3+t, 1 \\rangle$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,-3,2⟩ & =7 \\\\ ⟨1+2t,3+t,1⟩\\cdot ⟨4,-3,2⟩ & =7 \\\\ 4(1+2t)-3(3+t)+2\\cdot 1 & =7 \\\\ 4+8t-9-3t+2 & =7 \\\\ 5t & =10 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $\\mathbf{p}$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨1+2(2),3+(2),1⟩ \\\\  & =⟨5,5,1⟩.\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(5 , 5, 1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/example-4944.json" "file_sha256" "d9796b04b5eb6819adbc2727d2a4df50a56e1e44b90f1dcb63d9d778beadf4b8" "basis" 1917 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/edb-import/verification.json"} {"question" "q-33992" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=5-2t \\\\ y=-1+4t \\\\ z=-3-5t\\end{aligned}\\,\\text{and}\\,Π:2x-5y+3z-84=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/state.json" "file_sha256" "d5ac13187c5339fcf3e0e3504ca71c0e26ad4d8cf2f5aee2e84ec8be40227059" "basis" 2286 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/edb-import/verification.json"} {"question" "q-33992" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x-5y+3z-84 & =0 \\\\ 2(5-2t)-5(-1+4t)+3(-3-5t) & =84 \\\\ 10-4t+5-20t-9-15t & =84 \\\\ -39t & =78 \\\\ t & =-2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-2$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=5-2(-2)=9 \\\\ y=-1+4(-2)=-9 \\\\ z=-3-5(-2)=7\\end{aligned}\n$$\n\nSo, the intersection point is  $P(9,-9,7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/state.json" "file_sha256" "d5ac13187c5339fcf3e0e3504ca71c0e26ad4d8cf2f5aee2e84ec8be40227059" "basis" 2286 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/edb-import/verification.json"} {"question" "q-33992" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/activity-metadata.json" "file_sha256" "486d40b96c066a1f72548c248e866a2bf855d775e99dff51b0e149886b51b58b" "basis" 2286 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/edb-import/verification.json"} {"question" "q-33992" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/state.json" "file_sha256" "d5ac13187c5339fcf3e0e3504ca71c0e26ad4d8cf2f5aee2e84ec8be40227059" "basis" 2286 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/edb-import/verification.json"} {"question" "q-33992" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "No intersection"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/state.json" "file_sha256" "d5ac13187c5339fcf3e0e3504ca71c0e26ad4d8cf2f5aee2e84ec8be40227059" "basis" 2286 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068245/edb-import/verification.json"}] "sources" [{"question" "q-108311" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨5,-2,3⟩+t⟨0,3,-1⟩,\\,Π:r\\cdot ⟨1,3,-2⟩=-7.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108311" "field" nil "attribute" "question/worked-solution" "value" "Let's write the equation of the line as\n\n$$\nr=⟨5,-2+3t,3-t⟩.\n$$\n\nNow, substituting $r=⟨5,-2+3t,3-t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨1,3,-2⟩ & =-7 \\\\ ⟨5,-2+3t,3-t⟩\\cdot ⟨1,3,-2⟩ & =-7 \\\\ 5+3(-2+3t)+(-2)(3-t) & =-7 \\\\ 5-6+9t-6+2t & =-7 \\\\ 11t & =0 \\\\ t & =0.\\end{aligned}\n$$\n\nFinally, position vector $p$ of the intersection point $P$ is obtained by substituting $t=0$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨5,-2+3(0),3-0⟩ \\\\  & =⟨5,-2,3⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(5,-2,3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108311" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108311" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108311" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(5,-2,3)"] ["math" "(5,-5,4)"] ["math" "(5,-8,5)"] ["math" "(5,1,2)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108311" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(5,-2,3)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108309" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨2,3,-1⟩+t⟨-1,2,3⟩,\\,Π:r\\cdot ⟨-2,1,4⟩=11.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108309" "field" nil "attribute" "question/worked-solution" "value" "Let's write the equation of the line as\n\n$$\nr=⟨2-t,3+2t,-1+3t⟩.\n$$\n\nNow, substituting $r=⟨2-t,3+2t,-1+3t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-2,1,4⟩ & =11 \\\\ ⟨2-t,3+2t,-1+3t⟩\\cdot ⟨-2,1,4⟩ & =11 \\\\ -2(2-t)+1(3+2t)+4(-1+3t) & =11 \\\\ -4+2t+3+2t-4+12t & =11 \\\\ 16t & =16 \\\\ t & =1.\\end{aligned}\n$$\n\nFinally, position vector $p$ of the intersection point $P$ is obtained by substituting $t=1$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨2-1,3+2(1),-1+3(1)⟩ \\\\  & =⟨1,5,2⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(1,5,2).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108309" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108309" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108309" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,7,5)"] ["math" "(1,5,2)"] ["math" "(3,1,-4)"] ["math" "(3,5,-4)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108309" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(1,5,2)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73985" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨2,0,2⟩+t⟨3,2,-3⟩,\\,Π:r\\cdot ⟨5,-2,3⟩=6.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73985" "field" nil "attribute" "question/worked-solution" "value" "Let's write the equation of the line as\n\n$$\nr=⟨2+3t,2t,2-3t⟩.\n$$\n\nNow, substituting $r=⟨2+3t,2t,2-3t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨5,-2,3⟩ & =6 \\\\ ⟨2+3t,2t,2-3t⟩\\cdot ⟨5,-2,3⟩ & =6 \\\\ 5(2+3t)-2(2t)+3(2-3t) & =6 \\\\ 10+15t-4t+6-9t & =6 \\\\ 2t & =-10 \\\\ t & =-5.\\end{aligned}\n$$\n\nFinally, position vector $p$ of the intersection point $P$ is obtained by substituting $t=-5$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨2+3(-5),2(-5),2-3(-5)⟩ \\\\  & =⟨-13,-10,17⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(-13,-10,17).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73985" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-73985" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73985" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-10,-13,7)"] ["math" "(-13,-10,17)"] ["math" "(-17,-10,13)"] ["math" "(-3,0,1)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73985" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-13,-10,17)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108310" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨-2,3,0⟩+t⟨3,-2,1⟩,\\,Π:r\\cdot ⟨4,1,-3⟩=-19.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108310" "field" nil "attribute" "question/worked-solution" "value" "Let's write the equation of the line as\n\n$$\nr=⟨-2+3t,3-2t,t⟩.\n$$\n\nNow, substituting $r=⟨-2+3t,3-2t,t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,1,-3⟩ & =-19 \\\\ ⟨-2+3t,3-2t,t⟩\\cdot ⟨4,1,-3⟩ & =-19 \\\\ 4(-2+3t)+1(3-2t)-3t & =-19 \\\\ -8+12t+3-2t-3t & =-19 \\\\ 7t & =-14 \\\\ t & =-2.\\end{aligned}\n$$\n\nFinally, position vector $p$ of the intersection point $P$ is obtained by substituting $t=-2$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨-2+3(-2),3-2(-2),(-2)⟩ \\\\  & =⟨-8,7,-2⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(-8,7,-2).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108310" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108310" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108310" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-2,3,0)"] ["math" "(-5,5,-1)"] ["math" "(-8,7,-2)"] ["math" "(1,-1,1)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108310" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-8,7,-2)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108313" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,0,-1⟩+t⟨5,-2,4⟩,\\,Π:r\\cdot ⟨0,1,-2⟩=22.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108313" "field" nil "attribute" "question/worked-solution" "value" "Let's write the equation of the line as\n\n$$\nr=⟨3+5t,-2t,-1+4t⟩.\n$$\n\nNow, substituting $r=⟨3+5t,-2t,-1+4t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨0,1,-2⟩ & =22 \\\\ ⟨3+5t,-2t,-1+4t⟩\\cdot ⟨0,1,-2⟩ & =22 \\\\ 0(3+5t)+1(-2t)+(-2)(-1+4t) & =22 \\\\ -2t+2-8t & =22 \\\\ -10t & =20 \\\\ t & =-2.\\end{aligned}\n$$\n\nFinally, position vector $p$ of the intersection point $P$ is obtained by substituting $t=-2$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨3+5(-2),-2(-2),-1+4(-2)⟩ \\\\  & =⟨-7,4,-9⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(-7,4,-9).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108313" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108313" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108313" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-2,2,-5)"] ["math" "(-7,4,-9)"] ["math" "(3,0,-1)"] ["math" "(8,-2,3)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108313" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-7,4,-9)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108337" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=9-3t \\\\ y=5+2t \\\\ z=-7+t\\end{aligned}\\,\\text{and}\\,Π:4x+3y+5z-11=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108337" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}4x+3y+5z-11 & =0 \\\\ 4(9-3t)+3(5+2t)+5(-7+t) & =11 \\\\ 36-12t+15+6t-35+5t & =11 \\\\ -t & =-5 \\\\ t & =5\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=5$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=9-3(5)=-6 \\\\ y=5+2(5)=15 \\\\ z=-7+5=-2\\end{aligned}\n$$\n\nSo, the intersection point is  $P(-6,15,-2).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108337" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108337" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108337" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-3,13,-3)"] ["math" "(-6,15,-2)"] ["math" "(18,-1,-10)"] ["math" "(3,9,-5)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108337" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-6,15,-2)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108325" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=2-3t \\\\ y=-3+t \\\\ z=4+2t\\end{aligned}\\,\\text{and}\\,Π:3x+y-4z+45=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108325" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}3x+y-4z+45 & =0 \\\\ 3(2-3t)+(-3+t)-4(4+2t) & =-45 \\\\ 6-9t-3+t-16-8t & =-45 \\\\ -16t & =-32 \\\\ t & =2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=2$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=2-3(2)=-4 \\\\ y=-3+2=-1 \\\\ z=4+2(2)=8\\end{aligned}\n$$\n\nSo, the intersection point is  $P(-4,-1,8).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108325" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108325" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108325" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-1,-2,6)"] ["math" "(-4,-1,8)"] ["math" "(2,-3,4)"] ["math" "(5,-4,2)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108325" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-4,-1,8)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73999" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=-2-t \\\\ y=9-3t \\\\ z=-1-6t\\end{aligned}\\,\\text{and}\\,Π:-3x+2y+5z-85=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73999" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}-3x+2y+5z-85 & =0 \\\\ -3(-2-t)+2(9-3t)+5(-1-6t) & =85 \\\\ 6+3t+18-6t-5-30t & =85 \\\\ -33t & =66 \\\\ t & =-2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-2$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=-2-(-2)=0 \\\\ y=9-3(-2)=15 \\\\ z=-1-6(-2)=11\\end{aligned}\n$$\n\nSo, the intersection point is  $P(0,15,11).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73999" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-73999" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73999" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,15,11)"] ["math" "(0,3,11)"] ["math" "(1,0,1)"] ["math" "(10,12,11)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-73999" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(0,15,11)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74003" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=5-t \\\\ y=4+2t \\\\ z=-6-3t\\end{aligned}\\,\\text{and}\\,Π:4x+6y-3z-130=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74003" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}4x+6y-3z-130 & =0 \\\\ 4(5-t)+6(4+2t)-3(-6-3t) & =130 \\\\ 20-4t+24+12t+18+9t & =130 \\\\ 17t & =68 \\\\ t & =4\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=4$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=5-4=1 \\\\ y=4+2(4)=12 \\\\ z=-6-3(4)=-18\\end{aligned}\n$$\n\nSo, the intersection point is  $P(1,12,-18).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74003" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-74003" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74003" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,1,-1)"] ["math" "(1,12,-18)"] ["math" "(1,2,-8)"] ["math" "(10,21,-14)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74003" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(1,12,-18)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33992" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=5-2t \\\\ y=-1+4t \\\\ z=-3-5t\\end{aligned}\\,\\text{and}\\,Π:2x-5y+3z-84=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33992" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x-5y+3z-84 & =0 \\\\ 2(5-2t)-5(-1+4t)+3(-3-5t) & =84 \\\\ 10-4t+5-20t-9-15t & =84 \\\\ -39t & =78 \\\\ t & =-2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-2$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=5-2(-2)=9 \\\\ y=-1+4(-2)=-9 \\\\ z=-3-5(-2)=7\\end{aligned}\n$$\n\nSo, the intersection point is  $P(9,-9,7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33992" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-33992" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33992" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-9,9,7)"] ["math" "(5,-1,3)"] ["math" "(9,-9,7)"] ["math" "(9,7,-9)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33992" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(9,-9,7)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108371" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨4,-2,3⟩+w⟨5,-1,2⟩,\\,Π:r=⟨10,-5,12⟩+s⟨4,3,0⟩+t⟨0,2,5⟩.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108371" "field" nil "attribute" "question/worked-solution" "value" "From the equation of a plane in the parametric form $r=p+tv+sw$, we have that its normal vector is $n=v\\times w.$ In our case, the normal vector to $Π$ is\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =⟨4,3,0⟩\\times ⟨0,2,5⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ 4 & 3 & 0 \\\\ 0 & 2 & 5\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 0 \\\\ 2 & 5\\end{aligned}|i-|\\begin{aligned}4 & 0 \\\\ 0 & 5\\end{aligned}|j+|\\begin{aligned}4 & 3 \\\\ 0 & 2\\end{aligned}|k \\\\  & =15i-20j+8k \\\\  & =⟨15,-20,8⟩.\\end{aligned}\n$$\n\nTherefore, the equation of the plane $Π$ in dot product form is\n\n$$\n\\begin{aligned}r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨15,-20,8⟩ & =⟨10,-5,12⟩\\cdot ⟨15,-20,8⟩ \\\\ r\\cdot ⟨15,-20,8⟩ & =346.\\end{aligned}\n$$\n\nNow, substituting $r=⟨4,-2,3⟩+w⟨5,-1,2⟩$ into the equation of the plane in dot product form, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨15,-20,8⟩ & =346 \\\\ ⟨4+5w,-2-w,3+2w⟩\\cdot ⟨15,-20,8⟩ & =346 \\\\ 15(4+5w)-20(-2-w)+8(3+2w) & =346 \\\\ 60+75w+40+20w+24+16w & =346 \\\\ 111w & =222 \\\\ w & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $q$ of the intersection point $Q,$ we substitute $w=2$ into the equation of the line:\n\n$$\n\\begin{aligned}q & =⟨4+5(2),-2-(2),3+2(2)⟩ \\\\  & =⟨14,-4,7⟩\\end{aligned}\n$$\n\nSo, the intersection point is $Q(14,-4,7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108371" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108371" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108371" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-1,-1,1)"] ["math" "(-6,0,-1)"] ["math" "(14,-4,7)"] ["math" "(9,-3,5)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108371" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(14,-4,7)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74004" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:r=⟨3,1,5⟩+w⟨-2,-5,4⟩,\\,Π:r=⟨-5,4,2⟩+s⟨0,3,1⟩+t⟨2,0,1⟩.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74004" "field" nil "attribute" "question/worked-solution" "value" "From the equation of a plane in the parametric form $r=p+tv+sw$, we have that its normal vector is $n=v\\times w.$ In our case, the normal vectors to $Π$ is\n\n$$\n\\begin{aligned}n & =v\\times w \\\\  & =⟨0,3,1⟩\\times ⟨2,0,1⟩ \\\\  & =|\\begin{aligned}i & j & k \\\\ 0 & 3 & 1 \\\\ 2 & 0 & 1\\end{aligned}| \\\\  & =|\\begin{aligned}3 & 1 \\\\ 0 & 1\\end{aligned}|i-|\\begin{aligned}0 & 1 \\\\ 2 & 1\\end{aligned}|j+|\\begin{aligned}0 & 3 \\\\ 2 & 0\\end{aligned}|k \\\\  & =3i+2j-6k \\\\  & =⟨3,2,-6⟩.\\end{aligned}\n$$\n\nTherefore, the equation of the plane $Π$ in dot product form is\n\n$$\n\\begin{aligned}r\\cdot n & =p\\cdot n \\\\ r\\cdot ⟨3,2,-6⟩ & =⟨-5,4,2⟩\\cdot ⟨3,2,-6⟩ \\\\ r\\cdot ⟨3,2,-6⟩ & =-19.\\end{aligned}\n$$\n\nNow, substituting $r=⟨3,1,5⟩+w⟨-2,-5,4⟩$ into the equation of the plane in dot product form, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,2,-6⟩ & =-19 \\\\ ⟨3-2w,1-5w,5+4w⟩\\cdot ⟨3,2,-6⟩ & =-19 \\\\ 3(3-2w)+2(1-5w)-6(5+4w) & =-19 \\\\ 9-6w+2-10w-30-24w & =-19 \\\\ -40w & =0 \\\\ w & =0.\\end{aligned}\n$$\n\nFinally, to get the position vector $q$ of the intersection point $Q,$ we substitute $w=0$ into the equation of the line:\n\n$$\n\\begin{aligned}q & =⟨3-2(0),1-5(0),5+4(0)⟩ \\\\  & =⟨3,1,5⟩\\end{aligned}\n$$\n\nSo, the intersection point is $Q(3,1,5).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74004" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-74004" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74004" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-2,-5,4)"] ["math" "(-5,4,2)"] ["math" "(2,0,1)"] ["math" "(3,1,5)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-74004" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(3,1,5)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108889" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x-3}{5}=\\frac{y-1}{2}=\\frac{z+4}{3},\\,Π:r\\cdot ⟨-3,2,-1⟩=39.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108889" "field" nil "attribute" "question/worked-solution" "value" "From the equation of the line $l$, we know that it passes through the point $A(3,1,-4)$ and it is parallel to the vector $v=⟨5,2,3⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨3,1,-4⟩+t⟨5,2,3⟩ \\\\  & =⟨3+5t,1+2t,-4+3t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨3+5t,1+2t,-4+3t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-3,2,-1⟩ & =39 \\\\ ⟨3+5t,1+2t,-4+3t⟩\\cdot ⟨-3,2,-1⟩ & =39 \\\\ (-3)(3+5t)+2(1+2t)-(-4+3t) & =39 \\\\ -9-15t+2+4t+4-3t & =39 \\\\ -14t & =42 \\\\ t & =-3.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-3$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨3+5(-3),1+2(-3),-4+3(-3)⟩ \\\\  & =⟨-12,-5,-13⟩.\\end{aligned}\n$$\n\nSo, we get $P(-12,-5,-13).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108889" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-108889" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108889" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-12,-5,-13)"] ["math" "(-7,-3,-10)"] ["math" "(13,7,2)"] ["math" "(8,3,-1)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-108889" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-12,-5,-13)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33081" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x-1}{2}=\\frac{y+2}{1}=\\frac{z-1}{3},\\,Π:r\\cdot ⟨1,6,2⟩=19.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33081" "field" nil "attribute" "question/worked-solution" "value" "From the equation of the line $l$, we know that it passes through the point $A(1,-2,1)$ and it is parallel to the vector $v=⟨2,1,3⟩.$ Therefore, its vector equation is given by\n\n$$\n\\begin{aligned}r & =⟨1,-2,1⟩+t⟨2,1,3⟩ \\\\  & =⟨1+2t,-2+t,1+3t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nNow, substituting $r=⟨1+2t,-2+t,1+3t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨1,6,2⟩ & =19 \\\\ ⟨1+2t,-2+t,1+3t⟩\\cdot ⟨1,6,2⟩ & =19 \\\\ (1+2t)+6(-2+t)+2(1+3t) & =19 \\\\ 1+2t-12+6t+2+6t & =19 \\\\ 14t & =28 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨1+2(2),-2+2,1+3(2)⟩ \\\\  & =⟨5,0,7⟩.\\end{aligned}\n$$\n\nSo, we get $P(5,0,7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33081" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-33081" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33081" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0,7,2)"] ["math" "(1,-2,19)"] ["math" "(5,0,7)"] ["math" "(5,3,7)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33081" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(5,0,7)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33197" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:\\frac{x-2}{-3}=\\frac{y-3}{2}=\\frac{z+4}{-1},\\,Π:3x-2y+z-38=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33197" "field" nil "attribute" "question/worked-solution" "value" "From the equation of the line $l$, we know that it passes through the point $A(2,3,-4)$ and it is parallel to the vector $v=⟨-3,2,-1⟩.$ Therefore, its parametric equations are given by\n\n$$\n\\begin{aligned}r & =⟨2,3,-4⟩+t⟨-3,2,-1⟩ \\\\  & =⟨2-3t,3+2t,-4-t⟩,\\end{aligned}\n$$\n\nwhere $t\\in (-\\infty ,\\infty ).$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}3x-2y+z-38 & =0 \\\\ 3x-2y+z & =38 \\\\ ⟨x,y,z⟩\\cdot ⟨3,-2,1⟩ & =38 \\\\ r\\cdot ⟨3,-2,1⟩ & =38\\end{aligned}\n$$\n\nNow, substituting $r=⟨2-3t,3+2t,-4-t⟩$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨3,-2,1⟩ & =38 \\\\ ⟨2-3t,3+2t,-4-t⟩\\cdot ⟨3,-2,1⟩ & =38 \\\\ 3(2-3t)-2(3+2t)+(-4-t) & =38 \\\\ 6-9t-6-4t-4-t & =38 \\\\ -14t & =42 \\\\ t & =-3.\\end{aligned}\n$$\n\nFinally, to get the position vector $p$ of the intersection point $P,$ we substitute $t=-3$ into the vector equation of the line:\n\n$$\n\\begin{aligned}p & =⟨2-3(-3),3+2(-3),-4-(-3)⟩ \\\\  & =⟨11,-3,-1⟩.\\end{aligned}\n$$\n\nSo, we get $P(11,-3,-1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33197" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/activity-metadata.json" "file_sha256" "8c19911335c51ebce4ec0396ed8e7f8b97b16477bdd9a8a87e51b1e1a537e712"} {"question" "q-33197" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33197" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-3,2,-1)"] ["math" "(1,-3,-11)"] ["math" "(11,-1,-3)"] ["math" "(11,-3,-1)"] ["text" "No intersection"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "q-33197" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(11,-3,-1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/state.json" "file_sha256" "59316f644ee8a5b12325e87102001dffa32fbb4b5b3dc760924f7a56e360c947"} {"question" "e-4943" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $\\Pi$ with equations\n\n$$\nl: \\mathbf{r} = \\langle 5,3,-4 \\rangle + t \\langle 4,-2,-3 \\rangle, \\qquad \t\\Pi: \\mathbf{r} \\cdot \\langle -7,5,1 \\rangle = -65.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/example-4943.json" "file_sha256" "8edb8a76fae66456c262e287e09ade8f215c09e2a407d5996a2845e67714ce3e"} {"question" "e-4943" "field" nil "attribute" "question/worked-solution" "value" "Let's write the equation of the line as \n\n$$\n\\mathbf{r} = \\langle 5+4t , 3-2t, -4-3t \\rangle.\n$$\n\nNow, substituting $\\mathbf{r} = \\langle 5+4t , 3-2t, -4-3t \\rangle$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨-7,5,1⟩ & =-65 \\\\ ⟨5+4t,3-2t,-4-3t⟩\\cdot ⟨-7,5,1⟩ & =-65 \\\\ -7(5+4t)+5(3-2t)+(-4-3t) & =-65 \\\\ -35-28t+15-10t-4-3t & =-65 \\\\ -41t & =-41 \\\\ t & =1.\\end{aligned}\n$$\n\nFinally, the position vector $\\mathbf{p}$ of the intersection point is obtained by substituting $t=1$ into the equation of the line, as follows:\n\n$$\n\\begin{aligned}p & =⟨5+4(1),3-2(1),-4-3(1)⟩ \\\\  & =⟨9,1,-7⟩\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(9 , 1, -7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/example-4943.json" "file_sha256" "8edb8a76fae66456c262e287e09ade8f215c09e2a407d5996a2845e67714ce3e"} {"question" "e-4945" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $\\Pi$ with equations\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/assets/2989739b62112c05f49beb975eb9039d1bbc7fca39ffd4d0adc058c7cf1cbb41.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/example-4945.json" "file_sha256" "d9899cc18ede081c499d18562dbfcbd49a8261eced3f8b75f2990c8085e6c016"} {"question" "e-4945" "field" nil "attribute" "question/worked-solution" "value" "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}3x+4y+6z+25 & =0 \\\\ 3(3-4t)+4(-1+2t)+6(2+3t)+25 & =0 \\\\ 9-12t-4+8t+12+18t+25 & =0 \\\\ 14t & =-42 \\\\ t & =-3\\end{aligned}\n$$\n\nTo get the position vector $\\mathbf{p}$ of the intersection point $P$, we substitute $t=-3$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=3-4(-3)=15 \\\\ y=-1+2(-3)=-7 \\\\ z=2+3(-3)=-7\\end{aligned}\n$$\n\nSo, the intersection point is $P(15,-7,-7).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/example-4945.json" "file_sha256" "d9899cc18ede081c499d18562dbfcbd49a8261eced3f8b75f2990c8085e6c016"} {"question" "e-4944" "field" nil "attribute" "question/problem" "value" "Find the intersection point of the line $l$ and the plane $\\Pi$ with equations\n\n$$\nl: \\mathbf{r} = \\langle 1,3,1 \\rangle + t \\langle 2,1,0 \\rangle, \\qquad  \\Pi:4x-3y+2z-7 = 0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/example-4944.json" "file_sha256" "d9796b04b5eb6819adbc2727d2a4df50a56e1e44b90f1dcb63d9d778beadf4b8"} {"question" "e-4944" "field" nil "attribute" "question/worked-solution" "value" "Let's start by writing the equation of the line as\n\n$$\n\\mathbf{r} = \\langle 1+2t , 3+t, 1 \\rangle .\n$$\n\nLet's also write the equation of the plane in the dot product form:\n\n$$\n\\begin{aligned}4x-3y+2z-7 & =0 \\\\ 4x-3y+2z & =7 \\\\ ⟨x,y,z⟩\\cdot ⟨4,-3,2⟩ & =7 \\\\ r\\cdot ⟨4,-3,2⟩ & =7\\end{aligned}\n$$\n\nNow, substituting $\\mathbf{r} = \\langle 1+2t , 3+t, 1 \\rangle$ into the equation of the plane, we get\n\n$$\n\\begin{aligned}r\\cdot ⟨4,-3,2⟩ & =7 \\\\ ⟨1+2t,3+t,1⟩\\cdot ⟨4,-3,2⟩ & =7 \\\\ 4(1+2t)-3(3+t)+2\\cdot 1 & =7 \\\\ 4+8t-9-3t+2 & =7 \\\\ 5t & =10 \\\\ t & =2.\\end{aligned}\n$$\n\nFinally, to get the position vector $\\mathbf{p}$ of the intersection point $P,$ we substitute $t=2$ into the equation of the line:\n\n$$\n\\begin{aligned}p & =⟨1+2(2),3+(2),1⟩ \\\\  & =⟨5,5,1⟩.\\end{aligned}\n$$\n\nTherefore, the intersection point is $P(5 , 5, 1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083348/example-4944.json" "file_sha256" "d9796b04b5eb6819adbc2727d2a4df50a56e1e44b90f1dcb63d9d778beadf4b8"}] "usage" {"q-33992" [] "e-4943" [] "q-74003" [] "q-108313" [] "q-108337" [] "q-108311" [] "e-4945" [] "e-4944" [] "q-33081" []} "basis" 2870 "retractions" [[17592186120162 :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$l: \\frac{x - 1}{2} = \\frac{y + 2}{1} = \\frac{z - 1}{3}, Π: r \\cdot ⟨1, 6, 2⟩ = 19$."] [17592186119579 :question/problem "Find the intersection point of the line $l$ and the plane $\\Pi$ with equations\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14059450/assets/2a24a49f0fc47c235776597df655e75be9c68cffbb7988db16b36d9200f801bc.png)"]] "immutable_answers" [17592186117493 17592186117494 17592186117495 17592186117496 17592186117497 17592186117839 17592186117840 17592186117841 17592186117842 17592186117843 17592186338725 17592186338726 17592186338727 17592186338728 17592186338729 17592186338732 17592186338733 17592186338734 17592186338735 17592186338736 17592186338753 17592186338754 17592186338755 17592186338756 17592186338757 17592186338816 17592186338817 17592186338818 17592186338819 17592186338820] "immutable_fields" [[17592186117492 :answer-field/correct] [17592186117492 :answer-field/id] [17592186117492 :answer-field/key] [17592186117492 :answer-field/type] [17592186117838 :answer-field/correct] [17592186117838 :answer-field/id] [17592186117838 :answer-field/key] [17592186117838 :answer-field/type] [17592186338724 :answer-field/correct] [17592186338724 :answer-field/id] [17592186338724 :answer-field/key] [17592186338724 :answer-field/type] [17592186338731 :answer-field/correct] [17592186338731 :answer-field/id] [17592186338731 :answer-field/key] [17592186338731 :answer-field/type] [17592186338752 :answer-field/correct] [17592186338752 :answer-field/id] [17592