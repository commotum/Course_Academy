#{[{:db/id #edb/ref 17592186120223 :knowledge-point/_questions [{:knowledge-point/id #uuid "82e761b5-ec1c-549d-b726-e0909cfe460b" :knowledge-point/title "Finding the Intersection Point of a Line in Parametric Form and a Plane in Cartesian Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8977164a-8ad7-56e9-94a7-d1231f0c5ade" :answer/type {:db/ident :answer.type/math} :answer/value "(-9, 9, 7)" :db/id #edb/ref 17592186117839} {:answer/id #uuid "fd122388-c8df-5ba9-8c16-8ce6fa095bc2" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-1, 3)" :db/id #edb/ref 17592186117840} {:answer/id #uuid "46f916f3-3853-57e9-ba4e-59cb01cf50fe" :answer/type {:db/ident :answer.type/math} :answer/value "(9,-9, 7)" :db/id #edb/ref 17592186117841} {:answer/id #uuid "670f3c35-0bae-5d98-a7f7-406e9c05c9eb" :answer/type {:db/ident :answer.type/math} :answer/value "(9, 7,-9)" :db/id #edb/ref 17592186117842} {:answer/id #uuid "6812f233-b49b-50e7-80f8-912186dc94d2" :answer/type {:db/ident :answer.type/text} :answer/value "No intersection" :db/id #edb/ref 17592186117843}] :answer-field/correct {:answer/id #uuid "46f916f3-3853-57e9-ba4e-59cb01cf50fe" :answer/type {:db/ident :answer.type/math} :answer/value "(9,-9, 7)" :db/id #edb/ref 17592186117841} :answer-field/id #uuid "8efee06f-3bfd-5143-ad04-c2e4495511e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186117838}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c755ffbb-8374-5c52-a967-a6387ef6da9c" :question/math-academy-id "q-33992" :question/problem "Find the intersection point of the line $l$ and the plane $Π$ with equations\n\n$$\nl:{\\begin{aligned}x=5-2t \\\\ y=-1+4t \\\\ z=-3-5t\\end{aligned}\\,\\text{and}\\,Π:2x-5y+3z-84=0.\n$$" :question/worked-solution "We can substitute the parametric expressions for $x,$ $y,$ and $z$ of the line into the equation of the plane immediately:\n\n$$\n\\begin{aligned}2x-5y+3z-84 & =0 \\\\ 2(5-2t)-5(-1+4t)+3(-3-5t) & =84 \\\\ 10-4t+5-20t-9-15t & =84 \\\\ -39t & =78 \\\\ t & =-2\\end{aligned}\n$$\n\nTo get the position vector $p$ of the intersection point $P$, we substitute $t=-2$ into the parametric equations of the line:\n\n$$\n{\\begin{aligned}x=5-2(-2)=9 \\\\ y=-1+4(-2)=-9 \\\\ z=-3-5(-2)=7\\end{aligned}\n$$\n\nSo, the intersection point is  $P(9,-9,7).$"}]}
