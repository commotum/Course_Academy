d}\n$$\n\nNext, we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}r}{\\text{d}\\theta } & =\\frac{\\text{d}}{\\text{d}\\theta }(1)=0,\\end{aligned}\n$$\n\nand therefore\n\n$$\n\\begin{aligned}\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  & =\\sqrt{{1}^{2}+{0}^{2}} \\\\  & =1.\\end{aligned}\n$$\n\nWe can now write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}x\\operatorname{arcsin}⁡y\\,\\text{d}s & ={\\int }_{0}^{\\pi /3}f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,\\sqrt{{r}^{2}+{(\\frac{\\text{d}r}{\\text{d}\\theta })}^{2}}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\theta \\operatorname{cos}⁡\\theta \\cdot 1\\cdot \\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /3}\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta .\\end{aligned}\n$$\n\nLet's use integration by parts. We denote\n\n$$\n\\begin{aligned}u=\\theta  & ⟹ & {u}^{′}=1, \\\\ {v}^{′}=\\operatorname{cos}⁡\\theta  & ⟹ & v=\\int {v}^{′}\\,\\text{d}\\theta =\\int \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta =\\operatorname{sin}⁡\\theta .\\end{aligned}\n$$\n\nNow, substituting into the formula for the integration by parts, we obtain \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\theta \\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =\\theta \\operatorname{sin}⁡\\theta {|}_{0}^{\\pi /3}-{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =(\\frac{\\sqrt{3}\\pi }{6}-0)+\\operatorname{cos}⁡\\theta {|}_{0}^{\\pi /3} \\\\  & =\\frac{\\sqrt{3}\\pi }{6}+(\\frac{1}{2}-1) \\\\  & =\\frac{\\sqrt{3}\\pi -3}{6}.\\end{aligned}\n$$" 13194139536132 true] [17592186385234 1000 #edb/ref 17592186385235 13194139536132 true] [17592186385234 1000 #edb/ref 17592186385236 13194139536132 true] [17592186385234 1000 #edb/ref 17592186385237 13194139536132 true] [17592186385234 1000 #edb/ref 17592186385238 13194139536132 true] [17592186385234 1000 #edb/ref 17592186385239 13194139536132 true] [17592186385234 1040 #edb/ref 17592186045450 1