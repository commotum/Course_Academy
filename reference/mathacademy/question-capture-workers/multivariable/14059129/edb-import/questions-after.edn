#{[{:db/id #edb/ref 17592186338984 :knowledge-point/_questions [{:knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "17022fb1-5112-5533-b749-04a65ab35462" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$" :db/id #edb/ref 17592186338986} {:answer/id #uuid "35224d72-9991-5312-8440-3ce5a67e73db" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1$" :db/id #edb/ref 17592186338987} {:answer/id #uuid "e07785da-bacd-5924-8019-b3061461d6f6" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186338988} {:answer/id #uuid "e13efd66-9868-589e-8498-1c76c8371f95" :answer/type {:db/ident :answer.type/text} :answer/value "Two parallel lines: $z=2x\\pm 4$" :db/id #edb/ref 17592186338989} {:answer/id #uuid "03f0c68d-996e-5d85-bc53-4c76a24ac8ca" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipse: $\\frac{(x-2)^{2}}{2}+\\frac{{z}^{2}}{8}=1$" :db/id #edb/ref 17592186338990}] :answer-field/correct {:answer/id #uuid "35224d72-9991-5312-8440-3ce5a67e73db" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1$" :db/id #edb/ref 17592186338987} :answer-field/id #uuid "bc0ff648-0b9b-5d68-8989-082d8d1ac7e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338985}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fcfedd1b-1d6b-51cf-8ffc-3860006da14a" :question/math-academy-id "q-36288" :question/problem "What is the projection of the intersection between the hyperboloid of two sheets $\\frac{(x-2)^{2}}{2}+\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{8}=-1$ and the plane $y=2$ onto the $xz$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $y=2$, we substitute $y=2$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}+\\frac{(2)^{2}}{4}-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}+1-\\frac{{z}^{2}}{8} & =-1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{z}^{2}}{8} & =-2 \\\\ -\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16} & =1\\end{aligned}\n$$\n\nSo, we get the hyperbola: $-\\frac{(x-2)^{2}}{4}+\\frac{{z}^{2}}{16}=1.$"}] [{:db/id #edb/ref 17592186338991 :knowledge-point/_questions [{:knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8691b817-07e3-5444-963c-feb3658f53ba" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}<1}" :db/id #edb/ref 17592186338993} {:answer/id #uuid "37038554-0809-5cbd-b086-1402bddf9a27" :answer/type {:db/ident :answer.type/text} :answer/value "The entire $xy$-plane" :db/id #edb/ref 17592186338994} {:answer/id #uuid "30303328-08ed-5e01-ad90-cc263ebd3f1e" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}\\ge 0}" :db/id #edb/ref 17592186338995} {:answer/id #uuid "2e96d36e-9083-5c65-a480-de9f7f1c813c" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}<0}" :db/id #edb/ref 17592186338996} {:answer/id #uuid "b2c0d0cc-0db3-547e-adfa-51a99a2e3514" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}" :db/id #edb/ref 17592186338997}] :answer-field/correct {:answer/id #uuid "b2c0d0cc-0db3-547e-adfa-51a99a2e3514" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}" :db/id #edb/ref 17592186338997} :answer-field/id #uuid "f7af6c87-f1c4-563d-815c-c1b791f2019a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338992}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a512bde0-1c66-51f2-af4c-d779890eea15" :question/math-academy-id "q-36388" :question/problem "Given the hyperboloid of one sheet  $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{3} & =1 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & =\\frac{(z+1)^{2}}{3} \\\\ (z+1)^{2} & =3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1) \\\\ (z+1) & =\\pm \\sqrt{3(\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1)}\\end{aligned}\n$$\n\n \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{6}+\\frac{{y}^{2}}{2}\\ge 1}.\n$$"}] [{:db/id #edb/ref 17592186124904 :knowledge-point/_questions [{:knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95125d72-47ca-5c8a-a5c0-e354bb7780d3" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y): (x - 2)^{2} + \\frac{y^{2}}{4} \\ge 1}" :db/id #edb/ref 17592186122447} {:answer/id #uuid "a903daf7-dd30-577f-9ec0-6b60c2f017e4" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y): x^{2} + \\frac{y^{2}}{4} \\ge 1}" :db/id #edb/ref 17592186122448} {:answer/id #uuid "c8bef53c-b954-5e4c-ad53-12a1707edfb4" :answer/type {:db/ident :answer.type/text} :answer/value "The entire $xy$-plane" :db/id #edb/ref 17592186122449} {:answer/id #uuid "3811d714-d24b-5024-9903-17bb20300baa" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y): (x - 2)^{2} + \\frac{y^{2}}{4} \\le 1}" :db/id #edb/ref 17592186122450} {:answer/id #uuid "521a0350-a696-58fc-90a6-98b066419d46" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y): x^{2} + \\frac{y^{2}}{4} < 1}" :db/id #edb/ref 17592186122451}] :answer-field/correct {:answer/id #uuid "95125d72-47ca-5c8a-a5c0-e354bb7780d3" :answer/type {:db/ident :answer.type/math} :answer/value "{(x, y): (x - 2)^{2} + \\frac{y^{2}}{4} \\ge 1}" :db/id #edb/ref 17592186122447} :answer-field/id #uuid "37c1fc08-b412-54ba-ba85-101328ff5122" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122446}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4ed1ee8b-94bd-5dd5-9af9-ac794637faef" :question/math-academy-id "q-36465" :question/problem "Given the hyperboloid of one sheet $(x-2)^{2}+\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{9}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-2)^{2}+\\frac{{y}^{2}}{4}-\\frac{{z}^{2}}{9} & =1 \\\\ (x-2)^{2}+\\frac{{y}^{2}}{4}-1 & =\\frac{{z}^{2}}{9}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & =9((x-2)^{2}+\\frac{{y}^{2}}{4}-1) \\\\ z & =\\pm 3\\sqrt{(x-2)^{2}+\\frac{{y}^{2}}{4}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}(x-2)^{2}+\\frac{{y}^{2}}{4}-1 & \\ge 0 \\\\ (x-2)^{2}+\\frac{{y}^{2}}{4} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $(x-2)^{2}+\\frac{{y}^{2}}{4}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,(x-2)^{2}+\\frac{{y}^{2}}{4}\\ge 1}.\n$$"}] [{:db/id #edb/ref 17592186338998 :knowledge-point/_questions [{:knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3" :knowledge-point/title "Identifying the Domain of a Hyperboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c191664c-91e5-544b-a9e5-6fdfe461401f" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}>0}" :db/id #edb/ref 17592186339000} {:answer/id #uuid "b4d98915-83c5-59e4-be75-f686b94c8be4" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}<1}" :db/id #edb/ref 17592186339001} {:answer/id #uuid "1ac83b4a-6053-5c4c-9a91-3703a3df9d97" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}-\\frac{(y-2)^{2}}{8}<0}" :db/id #edb/ref 17592186339002} {:answer/id #uuid "28cddf47-44dd-57e1-822b-eda59ead2fca" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1}" :db/id #edb/ref 17592186339003} {:answer/id #uuid "62875bf8-d496-51b2-8e61-1e96fcce1e92" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\le 1}" :db/id #edb/ref 17592186339004}] :answer-field/correct {:answer/id #uuid "28cddf47-44dd-57e1-822b-eda59ead2fca" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1}" :db/id #edb/ref 17592186339003} :answer-field/id #uuid "11eb0e8f-a65c-581e-badb-321a66b262d2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186338999}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "73e903d1-edee-53d5-8ed7-40e859ad5358" :question/math-academy-id "q-71859" :question/problem "Given the hyperboloid of one sheet  $\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-\\frac{(z-1)^{2}}{5}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-\\frac{(z-1)^{2}}{5} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & =\\frac{(z-1)^{2}}{5} \\\\ (z-1)^{2} & =5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1) \\\\ (z-1) & =\\pm \\sqrt{5(\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1)}\\end{aligned}\n$$\n\n  \n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}-1 & \\ge 0 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}=1$, including its boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{(y-2)^{2}}{8}\\ge 1}.\n$$"}] [{:db/id #edb/ref 17592186339005 :knowledge-point/_questions [{:knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d554a209-7d90-5fa4-98ea-eea2ff7171da" :answer/type {:db/ident :answer.type/math} :answer/value "{x}^{2}-{y}^{2}=4" :db/id #edb/ref 17592186339007} {:answer/id #uuid "2bbebbfe-b0f8-5feb-a153-4832182fdebb" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}-{y}^{2}=-2" :db/id #edb/ref 17592186339008} {:answer/id #uuid "ee4ef2dd-79aa-5479-b296-541bf3ed7b75" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}-4{y}^{2}=1" :db/id #edb/ref 17592186339009} {:answer/id #uuid "0c8b766a-babc-5b2d-a8a2-ad1f4e8b1626" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}-{y}^{2}=4" :db/id #edb/ref 17592186339010} {:answer/id #uuid "e1fbb8e0-aac9-5015-8e1c-ad4db880774d" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}-4{y}^{2}=4" :db/id #edb/ref 17592186339011}] :answer-field/correct {:answer/id #uuid "0c8b766a-babc-5b2d-a8a2-ad1f4e8b1626" :answer/type {:db/ident :answer.type/math} :answer/value "2{x}^{2}-{y}^{2}=4" :db/id #edb/ref 17592186339010} :answer-field/id #uuid "17fbbdb2-c84f-59dd-89b4-d740a4678f39" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186339006}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d349238c-6c2f-5255-bd28-dab6727e3a56" :question/math-academy-id "q-71957" :question/problem "What is the trace in the $xy$-plane of the hyperboloid of one sheet $\\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{4}+\\frac{{z}^{2}}{6}=1?$" :question/worked-solution "To find the trace in the $xy$-plane, we substitute $z=0$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{4}+\\frac{{0}^{2}}{6}=1 \\\\ \\frac{{x}^{2}}{2}-\\frac{{y}^{2}}{4}=1 \\\\ 2{x}^{2}-{y}^{2}=4\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola in $xy$-plane."}]}
