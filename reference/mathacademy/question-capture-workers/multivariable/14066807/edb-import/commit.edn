ta +r\\operatorname{sin}⁡\\theta )\\cdot r\\,\\text{d}r\\text{d}\\theta  \\\\  & =3{∬}_{Δ}{r}^{2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\text{d}\\theta  \\\\  & =3{\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){\\int }_{0}^{1}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =3{\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){[\\frac{{r}^{3}}{3}]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /2}(\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =[\\,\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ]_{\\pi /2}^{3\\pi /2} \\\\  & =-2.\\end{aligned}\n$$" 13194139535522 true] [17592186353580 1000 #edb/ref 17592186353581 13194139535522 true] [17592186353580 1000 #edb/ref 17592186353582 13194139535522 true] [17592186353580 1000 #edb/ref 17592186353583 13194139535522 true] [17592186353580 1000 #edb/ref 17592186353584 13194139535522 true] [17592186353580 1000 #edb/ref 17592186353585 13194139535522 true] [17592186353580 1040 #edb/ref 17592186045450 13194139535522 true] [17592186353580 1041 "selection" 13194139535522 true] [17592186353580 1104 #edb/ref 17592186353585 13194139535522 true] [17592186353580 1110 #uuid "d578db4c-decf-5216-9e96-1bd03a0c05c1" 13194139535522 true] [17592186353581 1034 "8" 13194139535522 true] [17592186353581 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353581 1111 #uuid "a2d0ae2a-18bf-5ae6-88d8-003b813b5c97" 13194139535522 true] [17592186353582 1034 "4" 13194139535522 true] [17592186353582 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353582 1111 #uuid "f7467e60-889a-5c28-8f13-cb0d7d36cbec" 13194139535522 true] [17592186353583 1034 "-1" 13194139535522 true] [17592186353583 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353583 1111 #uuid "541f7e80-2c1e-5905-8c47-de19c75bbdb6" 13194139535522 true] [17592186353584 1034 "5" 13194139535522 true