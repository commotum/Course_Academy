)=5,\n$$\n\nand\n\n$$\n\\frac{∂z}{∂y}=\\frac{∂}{∂y}(5x-y)=-1.\n$$\n\nTherefore, the surface integral can be evaluated as follows:\n\n$$\n\\begin{aligned}{∬}_{S}({x}^{2}+{z}^{2})\\,\\text{d}S & ={∬}_{D}f(x,y,g(x,y))\\sqrt{1+{(\\frac{∂z}{∂x})}^{2}+{(\\frac{∂z}{∂y})}^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,({x}^{2}+(5x-y)^{2})\\sqrt{1+{5}^{2}+(-1)^{2}}\\,\\text{d}A \\\\  & ={∬}_{D}\\,({x}^{2}+25{x}^{2}+{y}^{2}-10xy)\\sqrt{27}\\,\\text{d}A \\\\  & =3\\sqrt{3}{∬}_{D}\\,(26{x}^{2}+{y}^{2}-10xy)\\,\\text{d}A \\\\  & =3\\sqrt{3}{\\int }_{0}^{1}{\\int }_{0}^{2x}(26{x}^{2}+{y}^{2}-10xy)\\,\\text{d}y\\,\\text{d}x \\\\  & =3\\sqrt{3}{\\int }_{0}^{1}{[26{x}^{2}y+\\frac{{y}^{3}}{3}-5x{y}^{2}]}_{y=0}^{y=2x}\\,\\text{d}x \\\\  & =3\\sqrt{3}{\\int }_{0}^{1}(52{x}^{3}+\\frac{8{x}^{3}}{3}-20{x}^{3})\\,\\text{d}x \\\\  & =3\\sqrt{3}{\\int }_{0}^{1}\\frac{104{x}^{3}}{3}\\,\\text{d}x \\\\  & =\\sqrt{3}{\\int }_{0}^{1}104{x}^{3}\\,\\text{d}x \\\\  & =\\sqrt{3}[26{x}^{4}]_{0}^{1} \\\\  & =26\\sqrt{3}\\end{aligned}\n$$" 13194139535522 true] [17592186353601 1000 #edb/ref 17592186353602 13194139535522 true] [17592186353601 1000 #edb/ref 17592186353603 13194139535522 true] [17592186353601 1000 #edb/ref 17592186353604 13194139535522 true] [17592186353601 1000 #edb/ref 17592186353605 13194139535522 true] [17592186353601 1000 #edb/ref 17592186353606 13194139535522 true] [17592186353601 1040 #edb/ref 17592186045450 13194139535522 true] [17592186353601 1041 "selection" 13194139535522 true] [17592186353601 1104 #edb/ref 17592186353605 13194139535522 true] [17592186353601 1110 #uuid "d19bc6dd-bbb0-5817-8d4b-e9af4fcd78a8" 13194139535522 true] [17592186353602 1034 "25\\sqrt{3}" 13194139535522 true] [17592186353602 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353602 1111 #uuid "0332e8c5-f1cd-533a-8103-e5314bdfa6eb" 13194139535522 true] [17592186353603 1034 "25+\\sqrt{3}" 13194139535522 true] [17592186353603 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353603 1111 #uuid "a00dc6f4