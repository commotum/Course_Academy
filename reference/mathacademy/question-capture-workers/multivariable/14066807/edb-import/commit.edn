\\,\\text{d}r\\text{d}\\theta  \\\\  & =\\sqrt{5}{∬}_{Δ}{e}^{{r}^{2}}r\\,\\text{d}r\\text{d}\\theta  \\\\  & =\\sqrt{5}{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{\\int }_{0}^{2\\pi }{[\\frac{{e}^{{r}^{2}}}{2}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & =\\sqrt{5}{\\int }_{0}^{2\\pi }\\frac{{e}^{4}-1}{2}\\,\\text{d}\\theta  \\\\  & =\\frac{\\sqrt{5}({e}^{4}-1)}{2}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{\\sqrt{5}({e}^{4}-1)}{2}\\cdot 2\\pi  \\\\  & =\\sqrt{5}({e}^{4}-1)\\pi .\\end{aligned}\n$$" 13194139535522 true] [17592186353566 1000 #edb/ref 17592186353567 13194139535522 true] [17592186353566 1000 #edb/ref 17592186353568 13194139535522 true] [17592186353566 1000 #edb/ref 17592186353569 13194139535522 true] [17592186353566 1000 #edb/ref 17592186353570 13194139535522 true] [17592186353566 1000 #edb/ref 17592186353571 13194139535522 true] [17592186353566 1040 #edb/ref 17592186045450 13194139535522 true] [17592186353566 1041 "selection" 13194139535522 true] [17592186353566 1104 #edb/ref 17592186353568 13194139535522 true] [17592186353566 1110 #uuid "bc3cf7e9-e4d9-5791-84c6-50bf70c26c4c" 13194139535522 true] [17592186353567 1034 "\\sqrt{3}\\pi " 13194139535522 true] [17592186353567 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353567 1111 #uuid "01733b5c-64df-5c0a-a596-2e110014054d" 13194139535522 true] [17592186353568 1034 "\\sqrt{5}({e}^{4}-1)\\pi " 13194139535522 true] [17592186353568 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353568 1111 #uuid "7cbf9bd2-92dd-506c-917a-c168b67cbcac" 13194139535522 true] [17592186353569 1034 "{e}^{4}\\sqrt{5}\\pi " 13194139535522 true] [17592186353569 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353569 1111 #uuid "5ea49a3e-c40b-56be-a772-df2cd278369c" 13194139535522 true] [17592186353570 1034 "({e}^{4}-1)\\pi " 13194139535522 true] [17592186353570 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353570 1111 #uu