 & ={∬}_{D}\\,2xy\\,\\text{d}A \\\\  & ={\\int }_{0}^{1}{\\int }_{-2}^{1}(2xy)\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}[x{y}^{2}]_{y=-2}^{y=1}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(-3x)\\,\\text{d}x \\\\  & ={[-\\frac{3}{2}{x}^{2}]}_{0}^{1} \\\\  & =-\\frac{3}{2}(1-0) \\\\  & =-\\frac{3}{2}\\end{aligned}\n$$" 13194139535522 true] [17592186353587 1000 #edb/ref 17592186353588 13194139535522 true] [17592186353587 1000 #edb/ref 17592186353589 13194139535522 true] [17592186353587 1000 #edb/ref 17592186353590 13194139535522 true] [17592186353587 1000 #edb/ref 17592186353591 13194139535522 true] [17592186353587 1000 #edb/ref 17592186353592 13194139535522 true] [17592186353587 1040 #edb/ref 17592186045450 13194139535522 true] [17592186353587 1041 "selection" 13194139535522 true] [17592186353587 1104 #edb/ref 17592186353590 13194139535522 true] [17592186353587 1110 #uuid "17bfc62c-eb35-516e-bde0-481371902795" 13194139535522 true] [17592186353588 1034 "-\\frac{3}{4}" 13194139535522 true] [17592186353588 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353588 1111 #uuid "4018318d-2130-5136-9858-14aebe4d18e6" 13194139535522 true] [17592186353589 1034 "3" 13194139535522 true] [17592186353589 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353589 1111 #uuid "0d9184f6-4a1c-51c3-b7fe-a1d2ad6ff689" 13194139535522 true] [17592186353590 1034 "-\\frac{3}{2}" 13194139535522 true] [17592186353590 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353590 1111 #uuid "374efa56-8f5f-5322-a4db-add499f62825" 13194139535522 true] [17592186353591 1034 "\\frac{3}{2}" 13194139535522 true] [17592186353591 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353591 1111 #uuid "7267ba16-da01-554a-a34f-99c2eb4cf0a6" 13194139535522 true] [17592186353592 1034 "0" 13194139535522 true] [17592186353592 1103 #edb/ref 17592186045453 13194139535522 true] [17592186353592 1111 #uuid "242eb008-534e-5b3c-b8a7-4b6ceea3bccf" 13194139535522 true] [17592186353593 1017 #e