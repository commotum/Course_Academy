validate]} {:db/id "q-50198/selection" :answer-field/id #uuid "11aa10a4-e72b-5785-a676-515eea57c746" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-50198/selection/39e1d262e7074fd5b3d6374ba5112cca38bc7f1eab8c0059edc4cf7078502247" :answer-field/choices ["q-50198/selection/39e1d262e7074fd5b3d6374ba5112cca38bc7f1eab8c0059edc4cf7078502247" "q-50198/selection/62a3b7b3b613ee6c2ef7a6742346218e9d086abf7391f6a2c3bb7ea5e9311234" "q-50198/selection/67103710f4a3b68fdf470bd8c194f7c8f46ffe9daa5a3057b4141ba092cbd459" "q-50198/selection/61c94ff84f16bf55845b5d071cbed2f584bb2f91f0f7132f1f106d36ebea57ae" "q-50198/selection/b16d91d25721d6a54d65c26cb730b53be86e286cbb495b9243f26201be8acc7c"] :db/ensure [:answer-field/validate]} {:db/id "q-50198" :question/id #uuid "eac0f042-8c74-51de-951e-b58cf5ffc23c" :question/math-academy-id "q-50198" :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=-2.$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =-2\\int \\,\\text{d}x \\\\ y & =-2x+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-3,0,3.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/assets/2d64c09661973b7ef840e783a88de85d5ca9cf3436fae7eaebef36aca98ae631.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-50198/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "23789a74-f1e3-5e26-8678-21f84a11a12b"] :knowledge-point/questions ["q-50198"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-79563"] :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =3\\int \\,\\text{d}x \\\\ y & =3x+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-2,0,2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/assets/64b0962fbb38b2c64da68de01d1c6407174aa66f810b820ece7185866b7f8ff3.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-119132"] :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{{e}^{-x/4}}{2}\\,\\text{d}x \\\\ y & =\\frac{1}{2}\\int {e}^{-x/4}\\,\\text{d}x \\\\  & =\\frac{1}{2}(-4{e}^{-x/4}) \\\\  & =-2{e}^{-x/4}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=0,3,6.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/assets/a4b534bd33daabc94aa3c86935b1fd4c0be723fafbc418ed382716541a864293.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-50195"] :question/problem "Which of the following shows some of the solution curves of the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2(x-1)?$" :question/worked-solution "Integrating the equation, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =2\\int (x-1)\\,\\text{d}x \\\\ y & =2\\int (x-1)\\,\\text{d}x \\\\  & =(x-1)^{2}+C.\\end{aligned}\n$$\n\nWe can now plot the solution curves by selecting different values for $C.$ The sketch below shows the solution curves for $C=-1,0,1.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041209/assets/92a2dbaa5726e6a1ab83fa879ad7b630b05e68a8e366db214b74d85269a849a9.png)" :db/ensure [:question/validate]} {:db/id "q-79566/selection/9507af772221d964a38374c4ff249225a8463d5426dd