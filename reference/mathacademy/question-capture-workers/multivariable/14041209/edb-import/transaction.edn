[{:db/id "q-119033/selection/771eedda6b199b62de9dadeeac8098d4fcaa6859b659dbb718c41f198f212c08" :answer/id #uuid "0e22fabc-f00d-55d9-9962-dafaaf9c9bc3" :answer/type :answer.type/math :answer/value "f(x)={e}^{x-3}+C" :db/ensure [:answer/validate]} {:db/id "q-119033/selection/d1921c2dc27538b5727bbbf809ca05e246556bd9cf50140a30a4bf821f593a20" :answer/id #uuid "902819ca-98fd-5ff8-8e41-c5b7a45d54be" :answer/type :answer.type/math :answer/value "f(x)={e}^{-3x}+C" :db/ensure [:answer/validate]} {:db/id "q-119033/selection/98e8fae2d91e70252fbe20be476b0e50ec4317c13be750606ff20fd318626dda" :answer/id #uuid "f88798d6-517c-5b79-a201-0056dab29f59" :answer/type :answer.type/math :answer/value "f(x)=\\frac{1}{3}{e}^{-x}+C" :db/ensure [:answer/validate]} {:db/id "q-119033/selection/99b6765124aaeb15f06704f5181859b5056b9ad766281e241b4d4d0ae6aca200" :answer/id #uuid "f6c3095a-d173-5623-b174-54c28052da88" :answer/type :answer.type/math :answer/value "f(x)=3{e}^{-x}+C" :db/ensure [:answer/validate]} {:db/id "q-119033/selection/dfb3fdcbfb9d253832f4df07f9659dd244d0829185e1b077e22355148a46fcb2" :answer/id #uuid "df15a2d9-9652-570c-861e-dd19e7a11844" :answer/type :answer.type/math :answer/value "f(x)=-{e}^{-x/3}+C" :db/ensure [:answer/validate]} {:db/id "q-119033/selection" :answer-field/id #uuid "65047499-d7aa-5e87-a285-a163c3ea9768" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119033/selection/99b6765124aaeb15f06704f5181859b5056b9ad766281e241b4d4d0ae6aca200" :answer-field/choices ["q-119033/selection/771eedda6b199b62de9dadeeac8098d4fcaa6859b659dbb718c41f198f212c08" "q-119033/selection/d1921c2dc27538b5727bbbf809ca05e246556bd9cf50140a30a4bf821f593a20" "q-119033/selection/98e8fae2d91e70252fbe20be476b0e50ec4317c13be750606ff20fd318626dda" "q-119033/selection/99b6765124aaeb15f06704f5181859b5056b9ad766281e241b4d4d0ae6aca200" "q-119033/selection/dfb3fdcbfb9d253832f4df07f9659dd244d0829185e1b077e22355148a46fcb2"] :db/ensure [:answer-field/validate]} {:db/id "q-119033" :question/id #uuid "57dad966-30e8-503a-bfa2-6fa76bd6e7c3" :question/math-academy-id "q-119033" :question/problem "Find the general solution to the differential equation  ${f}^{′}(x)+3{e}^{-x}=0.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =-3{e}^{-x}\\end{aligned}\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int (-3{e}^{-x})\\text{d}x \\\\ f(x) & =-3\\int {e}^{-x}\\,\\text{d}x \\\\  & =-3(-{e}^{-x})+C \\\\  & =3{e}^{-x}+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119033/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f"] :knowledge-point/questions ["q-119033"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99006/selection/124eea7dc841039e916b75c95e1e8dfdb8d17258b4913c74b25156953d9adb50" :answer/id #uuid "9a5c2e6f-7d51-514e-838e-91d7f32b8ff3" :answer/type :answer.type/math :answer/value "f(x)=\\frac{3}{5}\\operatorname{sin}⁡(3x)+C" :db/ensure [:answer/validate]} {:db/id "q-99006/selection/5a2ce53dcf04018d581dc66a717c753ae17a8c5adb7a8d7318992f7b223142e2" :answer/id #uuid "db152df6-6469-5361-ada0-24eb57f08be1" :answer/type :answer.type/math :answer/value "f(x)=\\frac{1}{5}\\operatorname{sin}⁡(3x)+C" :db/ensure [:answer/validate]} {:db/id "q-99006/selection/e8bff5a67cdda963d55fe6fcc36259466f79641828e9efa344aeeaee1989610a" :answer/id #uuid "f50bea76-48ab-5541-9b14-93511273edf3" :answer/type :answer.type/math :answer/value "f(x)=\\frac{1}{5}\\operatorname{cos}⁡(3x)+C" :db/ensure [:answer/validate]} {:db/id "q-99006/selection/d43a0f4af4f9f2255524b8efb6fdfeedc54e5f74ba9ea6544c09180fc7936320" :answer/id #uuid "eb44196e-ffb8-57dd-913f-1a8fa4242131" :answer/type :answer.type/math :answer/value "f(x)=\\frac{9}{5}\\operatorname{cos}⁡(3x)+C" :db/ensure [:answer/validate]} {:db/id "q-99006/selection/63761eff9cbfb420dc3ef1db0d9cdca0f0af320d5e66ede7fa005b36908d393c" :answer/id #uuid "a3375472-a1ea-529c-a4cf-07d7166322be" :answer/type :answer.type/math :answer/value "f(x)=\\frac{9}{5}\\operatorname{sin}⁡(3x)+C" :db/ensure [:answer/validate]} {:db/id "q-99006/selection" :answer-field/id #uuid "d262f556-9b2d-5c2f-9836-2f9a2f032068" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99006/selection/5a2ce53dcf04018d581dc66a717c753ae17a8c5adb7a8d7318992f7b223142e2" :answer-field/choices ["q-99006/selection/124eea7dc841039e916b75c95e1e8dfdb8d17258b4913c74b25156953d9adb50" "q-99006/selection/5a2ce53dcf04018d581dc66a717c753ae17a8c5adb7a8d7318992f7b223142e2" "q-99006/selection/e8bff5a67cdda963d55fe6fcc36259466f79641828e9efa344aeeaee1989610a" "q-99006/selection/d43a0f4af4f9f2255524b8efb6fdfeedc54e5f74ba9ea6544c09180fc7936320" "q-99006/selection/63761eff9cbfb420dc3ef1db0d9cdca0f0af320d5e66ede7fa005b36908d393c"] :db/ensure [:answer-field/validate]} {:db/id "q-99006" :question/id #uuid "53e856b6-991a-5955-95a7-499fd02bfdb8" :question/math-academy-id "q-99006" :question/problem "Solve the differential equation $-5{f}^{′}(x)+3\\operatorname{cos}⁡(3x)=0.$" :question/worked-solution "First, we rearrange the equation to isolate the derivative term:\n\n$$\n{f}^{′}(x)=\\frac{3}{5}\\operatorname{cos}⁡(3x).\n$$\n\nThen, we integrate both sides of the equation with respect to $x,$ and we get\n\n$$\n\\begin{aligned}\\int {f}^{′}(x)\\,\\text{d}x & =\\int \\frac{3}{5}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\ f(x) & =\\int \\frac{3}{5}\\operatorname{cos}⁡(3x)\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we get\n\n$$\n\\begin{aligned}\\begin{aligned}f(x) & =\\int \\frac{3}{5}\\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{3}{5}\\int \\operatorname{cos}⁡(3x)\\,\\text{d}x \\\\  & =\\frac{3}{5}\\cdot \\frac{1}{3}\\operatorname{sin}⁡(3x)+C \\\\  & =\\frac{1}{5}\\operatorname{sin}⁡(3x)+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99006/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f570287d-b0e4-53bb-8fa1-37348ca9202f"] :knowledge-point/questions ["q-99006"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119039/selection/4af9e753006c21c2d14e93a270d27ae907496bc7f51d967c50fdb35b5ead3aa8" :answer/id #uuid "4ca552f4-ecd4-57e1-9e64-1b1512271b19" :answer/type :answer.type/math :answer/value "y=4{x}^{4}+C{x}^{2}+Dx" :db/ensure [:answer/validate]} {:db/id "q-119039/selection/6b5237a365ad617c078fc4a8a1e0352898cc351c14ad6cb479f29591b39d08cd" :answer/id #uuid "d0ed767e-2ea4-5874-ab05-b9cf32e3ae85" :answer/type :answer.type/math :answer/value "y={x}^{5}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119039/selection/b60f9fbb79fe16ddaa756f6164a78ba5a068817c4341b0904850daf993954539" :answer/id #uuid "34f2e060-bb98-5844-aedd-c02a5b5cd771" :answer/type :answer.type/math :answer/value "y=5{x}^{4}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119039/selection/7c60f3b3780b304d71d9fe80faecb3c11a90e99f83c54d400650dfee40c61c34" :answer/id #uuid "d6506a3e-7af8-5c03-b770-4638a91d2e5f" :answer/type :answer.type/math :answer/value "y=4{x}^{5}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119039/selection/10aa8de7a21d1b49fe76a72df1ff0a44b76e42dd3395fa9f4827723c1e5ea9de" :answer/id #uuid "5fa3cfa8-b4c4-558d-a142-c62d743f5b21" :answer/type :answer.type/math :answer/value "y={x}^{5}+C{x}^{2}+Dx" :db/ensure [:answer/validate]} {:db/id "q-119039/selection" :answer-field/id #uuid "91d2e992-27c7-55a0-8f73-5da87db86e86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119039/selection/6b5237a365ad617c078fc4a8a1e0352898cc351c14ad6cb479f29591b39d08cd" :answer-field/choices ["q-119039/selection/4af9e753006c21c2d14e93a270d27ae907496bc7f51d967c50fdb35b5ead3aa8" "q-119039/selection/6b5237a365ad617c078fc4a8a1e0352898cc351c14ad6cb479f29591b39d08cd" "q-119039/selection/b60f9fbb79fe16ddaa756f6164a78ba5a068817c4341b0904850daf993954539" "q-119039/selection/7c60f3b3780b304d71d9fe80faecb3c11a90e99f83c54d400650dfee40c61c34" "q-119039/selection/10aa8de7a21d1b49fe76a72df1ff0a44b76e42dd3395fa9f4827723c1e5ea9de"] :db/ensure [:answer-field/validate]} {:db/id "q-119039" :question/id #uuid "9f503fbb-9abb-5178-8aa2-5b5187c150ec" :question/math-academy-id "q-119039" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=20{x}^{3}.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =20\\int {x}^{3}\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =20\\cdot \\frac{1}{4}{x}^{4}+C \\\\  & =5{x}^{4}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (5{x}^{4}+C)\\text{d}x \\\\ y & =5\\cdot \\frac{1}{5}{x}^{5}+Cx+D \\\\  & ={x}^{5}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119039/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-119039"] :db/ensure [:knowledge-point/validate]} {:db/id "q-99009/selection/ab5c1ecd9ac0bb9558a714e926006ab82e40522cbc25ed0aae8752f1be1f4edb" :answer/id #uuid "08677785-ca3c-598b-8e81-00cb57908329" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{3}}{3}-\\operatorname{sin}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-99009/selection/2ca6dfeda5c06ea7ec223ee5cb0b022f1345410f74719679c91e546423ab2ebe" :answer/id #uuid "4a295427-fdd4-5410-80af-da95c18694c7" :answer/type :answer.type/math :answer/value "y={x}^{3}-2\\operatorname{cos}⁡x+C+D" :db/ensure [:answer/validate]} {:db/id "q-99009/selection/125323c1578fa12db3ef9f2f56c96b77b6f9c052aea0c24629400db3f5b1bf8e" :answer/id #uuid "847a347f-68a4-50ec-9b1e-2f13aab562d9" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{3}}{3}-\\frac{1}{2}\\operatorname{sin}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-99009/selection/8703ffd5f81c67de754180beb16bc00f9a5b83cba1a8c98f77aa5e3839ac5bd6" :answer/id #uuid "ca064583-e418-5cf0-aa49-199cc524e889" :answer/type :answer.type/math :answer/value "y=\\frac{{x}^{3}}{3}-\\operatorname{cos}⁡x+C+D" :db/ensure [:answer/validate]} {:db/id "q-99009/selection/7d7311cccb2fd2ea842062fde00339b4d4f6d9c6561c0fe19cd3746cfe6a0367" :answer/id #uuid "ae93cc03-9f50-5b74-8113-d727df0584dc" :answer/type :answer.type/math :answer/value "y={x}^{3}-\\operatorname{sin}⁡x+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-99009/selection" :answer-field/id #uuid "8795f23e-fe78-5502-b093-0d5e041c0235" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-99009/selection/125323c1578fa12db3ef9f2f56c96b77b6f9c052aea0c24629400db3f5b1bf8e" :answer-field/choices ["q-99009/selection/ab5c1ecd9ac0bb9558a714e926006ab82e40522cbc25ed0aae8752f1be1f4edb" "q-99009/selection/2ca6dfeda5c06ea7ec223ee5cb0b022f1345410f74719679c91e546423ab2ebe" "q-99009/selection/125323c1578fa12db3ef9f2f56c96b77b6f9c052aea0c24629400db3f5b1bf8e" "q-99009/selection/8703ffd5f81c67de754180beb16bc00f9a5b83cba1a8c98f77aa5e3839ac5bd6" "q-99009/selection/7d7311cccb2fd2ea842062fde00339b4d4f6d9c6561c0fe19cd3746cfe6a0367"] :db/ensure [:answer-field/validate]} {:db/id "q-99009" :question/id #uuid "99338d6e-762d-5e46-924e-c9b8ff055bcc" :question/math-academy-id "q-99009" :question/problem "Solve the differential equation $2\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}-\\operatorname{sin}⁡x=4x.$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=2x+\\frac{1}{2}\\operatorname{sin}⁡x.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (2x+\\frac{1}{2}\\operatorname{sin}⁡x)\\text{d}x \\\\  & =2\\int x\\,\\text{d}x+\\frac{1}{2}\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =2(\\frac{{x}^{2}}{2})+\\frac{1}{2}(-\\operatorname{cos}⁡x)+C \\\\  & ={x}^{2}-\\frac{1}{2}\\operatorname{cos}⁡x+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int ({x}^{2}-\\frac{1}{2}\\operatorname{cos}⁡x+C)\\,\\text{d}x \\\\ y & =\\int {x}^{2}\\,\\text{d}x-\\frac{1}{2}\\int \\operatorname{cos}⁡x\\,\\text{d}x+C\\int \\text{d}x \\\\  & =(\\frac{{x}^{3}}{3})-\\frac{1}{2}(\\operatorname{sin}⁡x)+Cx+D \\\\  & =\\frac{{x}^{3}}{3}-\\frac{1}{2}\\operatorname{sin}⁡x+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-99009/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-99009"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119042/selection/cc0f1137058342c383b78ff04b3b51f82deccd28faf10372a2b0ad3c8945d330" :answer/id #uuid "ae10f626-d26f-5227-90c5-6378973d2c40" :answer/type :answer.type/math :answer/value "y=8{e}^{x/2}-{x}^{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119042/selection/66675731d00adbb283a173a0ee38ca6055fbf0a4c15ed99d9fb1de2f60e25e3b" :answer/id #uuid "ca1ed765-8da8-56b2-b6b6-dca7f52887e8" :answer/type :answer.type/math :answer/value "y=32{e}^{x/2}-\\frac{1}{2}{x}^{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119042/selection/9c09bb53e222f4166285b80fcf95a1ef0d17b0d556b6408d33766fcc3761ee87" :answer/id #uuid "13e8808d-c92a-513d-9c5e-12c9e4d8a142" :answer/type :answer.type/math :answer/value "y=32{e}^{x/2}-{x}^{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119042/selection/d3573778fe04312de07fb0769d109f025298065e678a85954c099d30dd1bdbb2" :answer/id #uuid "9427e188-e12b-5caf-9d4b-376fba24a6f3" :answer/type :answer.type/math :answer/value "y=16{e}^{x/2}+{x}^{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119042/selection/16a0d1ad3fc32db3a0f81baa11b707572bec23747eea0572a0cef6b31c1caa83" :answer/id #uuid "bfdb6a31-56b7-5da3-833d-537f58cf0991" :answer/type :answer.type/math :answer/value "y=16{e}^{x/2}-3{x}^{3}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119042/selection" :answer-field/id #uuid "7949e831-bd6a-52f4-909d-5add3ea77214" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119042/selection/9c09bb53e222f4166285b80fcf95a1ef0d17b0d556b6408d33766fcc3761ee87" :answer-field/choices ["q-119042/selection/cc0f1137058342c383b78ff04b3b51f82deccd28faf10372a2b0ad3c8945d330" "q-119042/selection/66675731d00adbb283a173a0ee38ca6055fbf0a4c15ed99d9fb1de2f60e25e3b" "q-119042/selection/9c09bb53e222f4166285b80fcf95a1ef0d17b0d556b6408d33766fcc3761ee87" "q-119042/selection/d3573778fe04312de07fb0769d109f025298065e678a85954c099d30dd1bdbb2" "q-119042/selection/16a0d1ad3fc32db3a0f81baa11b707572bec23747eea0572a0cef6b31c1caa83"] :db/ensure [:answer-field/validate]} {:db/id "q-119042" :question/id #uuid "70bd483b-e098-5a66-894e-b6127c602eb9" :question/math-academy-id "q-119042" :question/problem "Solve the differential equation\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}+6x=8{e}^{x/2}.\n$$" :question/worked-solution "First, we rearrange the equation to give\n\n$$\n\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{x/2}-6x.\n$$\n\nNow, integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =\\int (8{e}^{x/2}-6x)\\text{d}x \\\\  & =8\\int {e}^{x/2}\\,\\text{d}x-6\\int x\\,\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(2{e}^{x/2})-6(\\frac{1}{2}{x}^{2})+C \\\\  & =16{e}^{x/2}-3{x}^{2}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (16{e}^{x/2}-3{x}^{2}+C)\\text{d}x \\\\ y & =16\\int {e}^{x/2}\\,\\text{d}x-3\\int {x}^{2}\\,\\text{d}x+C\\int \\text{d}x \\\\  & =16(2{e}^{x/2})-3(\\frac{1}{3}{x}^{3})+Cx+D \\\\  & =32{e}^{x/2}-{x}^{3}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-119042/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-119042"] :db/ensure [:knowledge-point/validate]} {:db/id "q-119038/selection/2faf396522dd61fd928454a9cb73ccd0b3731bf6d16d6ca2ca4e703e1b2719c3" :answer/id #uuid "9bfd9fab-eee2-5452-9cef-7e428deaaf4e" :answer/type :answer.type/math :answer/value "y=-4{e}^{-2x}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119038/selection/baf4292e3c4c8b15cc4e5a06745fdce1db9ec521f1f5f20edc8142ef0fd1f363" :answer/id #uuid "1547bd12-2561-5d09-8e55-3a2f8e1e5a46" :answer/type :answer.type/math :answer/value "y=-{e}^{-2x}+C{e}^{-x}+Dx" :db/ensure [:answer/validate]} {:db/id "q-119038/selection/360215ec9d2b32f415f1b9078b5eb246fc8310fd8dddc417fd893ef34ba17d61" :answer/id #uuid "a5162f30-f9f8-56f0-87e3-c050745c20d2" :answer/type :answer.type/math :answer/value "y=2{e}^{-2x}+Cx+D" :db/ensure [:answer/validate]} {:db/id "q-119038/selection/b2cf36857bd72d49324c58e03213592ba0f745fba225c99ebc19fccbc4d4e157" :answer/id #uuid "72905702-3042-5474-a8ed-03080ecbc5a9" :answer/type :answer.type/math :answer/value "y={e}^{-2x}+C{x}^{2}+Dx" :db/ensure [:answer/validate]} {:db/id "q-119038/selection/c7c5443595ce5d759b37684ef339ecd6ace7dc68c5e24d2a0e3fd121fad4a88a" :answer/id #uuid "20516aab-1dff-53db-99bc-d2fc0df33732" :answer/type :answer.type/math :answer/value "y=2{e}^{-2x}+C{e}^{-x}+D" :db/ensure [:answer/validate]} {:db/id "q-119038/selection" :answer-field/id #uuid "fc0e6c8d-b9b0-5a01-9ad3-7b6d7b3d5bd8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-119038/selection/360215ec9d2b32f415f1b9078b5eb246fc8310fd8dddc417fd893ef34ba17d61" :answer-field/choices ["q-119038/selection/2faf396522dd61fd928454a9cb73ccd0b3731bf6d16d6ca2ca4e703e1b2719c3" "q-119038/selection/baf4292e3c4c8b15cc4e5a06745fdce1db9ec521f1f5f20edc8142ef0fd1f363" "q-119038/selection/360215ec9d2b32f415f1b9078b5eb246fc8310fd8dddc417fd893ef34ba17d61" "q-119038/selection/b2cf36857bd72d49324c58e03213592ba0f745fba225c99ebc19fccbc4d4e157" "q-119038/selection/c7c5443595ce5d759b37684ef339ecd6ace7dc68c5e24d2a0e3fd121fad4a88a"] :db/ensure [:answer-field/validate]} {:db/id "q-119038" :question/id #uuid "795b711d-ea65-5cb8-87a2-70f0c9e6f190" :question/math-academy-id "q-119038" :question/problem "Solve the differential equation $\\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}=8{e}^{-2x}.$" :question/worked-solution "Integrating the equation once, we get\n\n$$\n\\begin{aligned}\\int \\frac{{\\text{d}}^{2}y}{\\text{d}{x}^{2}}\\,\\text{d}x & =8\\int {e}^{-2x}\\text{d}x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =8(-\\frac{1}{2}{e}^{-2x})+C \\\\  & =-4{e}^{-2x}+C.\\end{aligned}\n$$\n\nIntegrating a second time, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-4{e}^{-2x}+C)\\text{d}x \\\\ y & =-4(-\\frac{1}{2}{e}^{-2x})+Cx+D \\\\  & =2{e}^{-2x}+Cx+D.\\end{aligned}\n$$\n\nNote that because we had a second-order equation, our general solution contains *two* arbitrary constants, $C$ and $D.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-119038/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "192bb38b-b609-56ff-b560-becfc38ea070"] :knowledge-point/questions ["q-119038"] :db/ensure [:knowledge-point/validate]} {:db/id "q-50198/selection/39e1d262e707