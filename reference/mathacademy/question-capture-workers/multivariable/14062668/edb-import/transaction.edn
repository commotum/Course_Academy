0b48c0fda0801d1c9ba.png" :db/ensure [:answer/validate]} {:db/id "q-122693/selection" :answer-field/id #uuid "2e60660e-7547-5b05-9688-5fcb7923b18b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-122693/selection/356c3c267c6aaa3d2a561e31964f0e7b7e498a8471f0082ad6de9ef9a8c01dc0" :answer-field/choices ["q-122693/selection/6a224ffb10c51b59f656e8fff0d246048c5ca592267f3b4ae03f7da8e5c5912d" "q-122693/selection/c0f7e7fe6fedc13ff5a5ca2fc238969d5414fdd5a0bfb0dd04a32613d8ad25db" "q-122693/selection/818fa48913e0925cc90e304b05e3b7671a547f62cfd933bd8189703ca990d3de" "q-122693/selection/356c3c267c6aaa3d2a561e31964f0e7b7e498a8471f0082ad6de9ef9a8c01dc0" "q-122693/selection/0b36256168813f002ea1421b1124c96bcc1a52b4ef3cea4b05910a12a8c2daea"] :db/ensure [:answer-field/validate]} {:db/id "q-122693" :question/id #uuid "d89542da-1193-5d73-b783-8e2dd0df7f2d" :question/math-academy-id "q-122693" :question/problem "Which of the following diagrams represents the gradient vector field of the function $f(x,y)=\\frac{{x}^{2}+{y}^{2}}{2}?$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\frac{{x}^{2}+{y}^{2}}{2}) \\\\  & =x \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\frac{{x}^{2}+{y}^{2}}{2}) \\\\  & =y\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =x\\,i+y\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-1,1),$ $(2,2),$ and $(2,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-1,1) & =-\\,i+j \\\\ ∇f(2,2) & =2\\,i+2\\,j \\\\ ∇f(2,-1) & =2\\,i+(-1)j=2\\,i-j\\end{aligned}\n$$\n\n \n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/369ebf19405768bcca19f4981f0237647836250548b0a33f9b4fdba92d85ddc9.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-122693/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7a43f82e-6682-56af-994a-b0bdf12b4095"] :knowledge-point/questions ["q-122693"] :db/ensure [:knowledge-point/validate]} {:db/id "q-122732/selection/8e26380dee018176129ca488e9f71f662d4b34f4936d1041ecf940aa6feeaaa8" :answer/id #uuid "59b20182-b216-5794-af7a-866031778aca" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/020c3ec7cd0e5e57bb4c6de8516988187c9038d9e5598b116966b71fa8b917d8.png" :db/ensure [:answer/validate]} {:db/id "q-122732/selection/d541909f3686942d5097384e5e7b228e0de39c7f32b5ea4bf941a2d835cf5a86" :answer/id #uuid "b4272ac1-c670-5bd9-beef-0b5e3dc90fd1" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/25ed4b4750662433bf4405b5e63ab78396688a985c76e2d34d449c0689830380.png" :db/ensure [:answer/validate]} {:db/id "q-122732/selection/7660552b978f648812494e5cf7901e1f68e3eb7b99a6a91e95bf5217bdc2e6a6" :answer/id #uuid "c93c839e-e87d-5633-b3c4-d1da9fbc8990" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/0c425b6fcb88f4c958a7c0371a64a815eda5ebf8ed14b0adc06875de1e24003b.png" :db/ensure [:answer/validate]} {:db/id "q-122732/selection/c4e9d19ccedd63f3d2908ccb3af0dba9043c51ba87684a3d20064c7f54ce7cf9" :answer/id #uuid "4425e615-e88f-5c97-931c-fb533a5b2c97" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/48c57f24904442c74178682db34aaa0113eb84042c78516a4e6f961e73b0f9eb.png" :db/ensure [:answer/validate]} {:db/id "q-122732/selection/a2f265efe2a223126aaebd411b361d876aa34ea96df8449b1410dd0d4a203e32" :answer/id #uuid "3f630397-62af-5958-a407-110c41b7a063" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/af7fdf48d36f477174867761b90d9349344029980012f1f7907f544efd3893bc.png" :db/ensure [:answer/validate]} {:db/id "q-122732/selection" :answer-field/id #uuid "7da31b53-f741-518d-8db1-e178ff46ee68" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-122732/selection/8e26380dee018176129ca488e9f71f662d4b34f4936d1041ecf940aa6feeaaa8" :answer-field/choices ["q-122732/selection/8e26380dee018176129ca488e9f71f662d4b34f4936d1041ecf940aa6feeaaa8" "q-122732/selection/d541909f3686942d5097384e5e7b228e0de39c7f32b5ea4bf941a2d835cf5a86" "q-122732/selection/7660552b978f648812494e5cf7901e1f68e3eb7b99a6a91e95bf5217bdc2e6a6" "q-122732/selection/c4e9d19ccedd63f3d2908ccb3af0dba9043c51ba87684a3d20064c7f54ce7cf9" "q-122732/selection/a2f265efe2a223126aaebd411b361d876aa34ea96df8449b1410dd0d4a203e32"] :db/ensure [:answer-field/validate]} {:db/id "q-122732" :question/id #uuid "14b7ceda-a408-53c9-aeb5-05da06c84fba" :question/math-academy-id "q-122732" :question/problem "Which of the following diagrams represents the gradient vector field of the function $f(x,y)=x{y}^{2}?$" :question/worked-solution "The gradient vector field of a function $f$ is given by $∇f.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(x{y}^{2}) \\\\  & ={y}^{2} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(x{y}^{2}) \\\\  & =2xy\\end{aligned}\n$$\n\nSo, the gradient vector field of $f(x,y)$ is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & ={y}^{2}\\,i+2xy\\,j.\\end{aligned}\n$$\n\nNext, we have to sketch the vector field at the points $(-2,1),$ $(2,1),$ and $(-2,-1).$\n\nTo sketch the vector field at the given points, we substitute their coordinates into the expression for $∇f.$\n\n$$\n\\begin{aligned}∇f(-2,1) & ={1}^{2}\\,i+2\\cdot (-2)\\cdot 1\\,j=i-4j \\\\ ∇f(2,1) & ={1}^{2}\\,i+2\\cdot 2\\cdot 1\\,j=i+4\\,j \\\\ ∇f(-2,-1) & =(-1)^{2}\\,i+2\\cdot (-2)\\cdot (-1)\\,j=i+4\\,j\\end{aligned}\n$$\n\nNow, we draw the vectors starting at the corresponding points and obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/020c3ec7cd0e5e57bb4c6de8516988187c9038d9e5598b116966b71fa8b917d8.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-122732/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7a43f82e-6682-56af-994a-b0bdf12b4095"] :knowledge-point/questions ["q-122732"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-122810"] :question/worked-solution "We start by plotting some level curves of the function:\n\n- Setting $f(x,y)=-1,$ we get ${x}^{2}-y=-1,$ which gives the parabola $y={x}^{2}+1$\n\n- Setting $f(x,y)=0,$ we get ${x}^{2}-y=0,$ that is, the parabola $y={x}^{2}$\n\n- Setting $f(x,y)=2,$ we get ${x}^{2}-y=2,$ that is, the parabola $y={x}^{2}-2$\n\n- $⋯$\n\nContinuing in this way, we get the following contour plot:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/77a54ef31c41e0246e3d337a69c7faa161194058e6a5c672ef24d86866a83faf.png)\n\nNote that $f(x,y)$ increases as we move downward and away from the origin $O.$ \n\nNow, we recall the following facts:\n\n- The gradient field vectors of a function $f(x,y)$ always lie perpendicular to its level curves.\n\n- Moreover, the vectors point in the direction where $f(x,y)$ increases.\n\nWith this in mind, we can add the vector field to the contour plot, giving the following picture.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/4e124d5e77ef9a28002aba9aac40f0b7eff1232dd1c08b6bca10b166469675c7.png)\n\nSo, the corresponding gradient field is as follows:\n\n \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/8bd5b7575d1693935df0d25a259767f0dd267fc1153139cd55cebad75e3988fd.png)" :db/ensure [:question/validate]} {:db/id "q-122813/selection/a1650709713a71e72a0169ba859ac6c10cdeb1153640ccb2fc1eca9db4b425d4" :answer/id #uuid "cc7ce5ae-9f70-5b00-b7f2-b9b884e1b545" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/dcd7de7b52c59ceda71245ef18d7cb1327a0e3f3b93f6f8e0bb8c5e386958217.png" :db/ensure [:answer/validate]} {:db/id "q-122813/selection/8f0398451b79c8a6a54b3022dc63d4e9f34d90ea05ee9e71867c1b50213b65f9" :answer/id #uuid "641dbbe6-b8b6-5e8d-825f-b534260a2ded" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/e6598c50e72417a0bff5514fa2b8ff9fba7c617cff10dc83e15472259d040846.png" :db/ensure [:answer/validate]} {:db/id "q-122813/selection/da21cc9b396e347d2beca996ef516668833ae4360abb197e1303da37aa7f9baf" :answer/id #uuid "1227f0d6-5058-56a3-9d6b-459035d2ec35" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/8e30bba74fad98713f891950fd052d2ddd2cb2dc349bd9bcb7efe3333b7203dd.png" :db/ensure [:answer/validate]} {:db/id "q-122813/selection/4aca413bddc7c4c9cda69607867d32791d2726115a905b7141af4e07aa7fb039" :answer/id #uuid "2f58bd7c-a739-5f7a-9789-b8de0befd47e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivari