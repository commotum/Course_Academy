2668/assets/417f9bd99ad7032ffac7ce258c5122d932b1bb1610237ef030f077ca56815bec.png" 13194139535327 true] [17592186343919 1103 #edb/ref 17592186045452 13194139535327 true] [17592186343919 1111 #uuid "bd60b5b1-5f10-53b6-ae78-2baba5df4558" 13194139535327 true] [17592186343920 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/e6598c50e72417a0bff5514fa2b8ff9fba7c617cff10dc83e15472259d040846.png" 13194139535327 true] [17592186343920 1103 #edb/ref 17592186045452 13194139535327 true] [17592186343920 1111 #uuid "641dbbe6-b8b6-5e8d-825f-b534260a2ded" 13194139535327 true] [17592186343921 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/dcd7de7b52c59ceda71245ef18d7cb1327a0e3f3b93f6f8e0bb8c5e386958217.png" 13194139535327 true] [17592186343921 1103 #edb/ref 17592186045452 13194139535327 true] [17592186343921 1111 #uuid "cc7ce5ae-9f70-5b00-b7f2-b9b884e1b545" 13194139535327 true] [17592186343922 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/8e30bba74fad98713f891950fd052d2ddd2cb2dc349bd9bcb7efe3333b7203dd.png" 13194139535327 true] [17592186343922 1103 #edb/ref 17592186045452 13194139535327 true] [17592186343922 1111 #uuid "1227f0d6-5058-56a3-9d6b-459035d2ec35" 13194139535327 true] [17592186343923 1017 #edb/ref 17592186343924 13194139535327 true] [17592186343923 1089 "q-122829" 13194139535327 true] [17592186343923 1091 #edb/ref 17592186045464 13194139535327 true] [17592186343923 1100 "Which of the following could be the gradient vector field of the function $f(x,y)=\\frac{{x}^{2}}{4}+{y}^{2}?$" 13194139535327 true] [17592186343923 1113 #uuid "753fa3ed-45bf-54fd-98fd-a8b2d25b635b" 13194139535327 true] [17592186343923 1145 "We start by plotting some level curves of the function:\n\n- Setting $f(x,y)=0,$ we get $\\frac{{x}^{2}}{4}+{y}^{2}=0,$ which gives the origin $O$\n\n- Setting $f(x,y)=1,$ we get $\\frac{{x}^{2}}{4}+{y}^{2}=1,$ which gives an ellipse with semiaxes $2$ and $1$ centered at $O$\n\n- Setting $f(x,y)=4,$ we get $\\frac{{x}^{2}}{4}+{y}^{2}=4,$ which gives an ellipse with semiaxes $4$ and $2$ centered at $O$\n\n- $⋯$\n\nContinuing in this way, we get the following contour plot:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/835b4206e04d064485d02635cfd4e2ad39a934b1d2b38296cc6463a265f5d931.png)\n\nNote that $f(x,y)$ increases as we move away from the origin.\n\nNow, we recall the following facts:\n\n- The gradient field vectors of a function $f(x,y)$ always lie perpendicular to its level curves.\n\n- Moreover, the vectors point in the direction where $f(x,y)$ increases.\n\nWith this in mind, we can add the vector field to the contour plot, giving the following picture.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/cd8e0a10d162d30be895fa4ce49e3944e4e1a3ee9f79aa2fafe70c0edd2c0d61.png)\n\nSo, the corresponding gradient field is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062668/assets/5fd011917170ef1f098b875060ad48d3ea5d33a1d16d369ae58614c53cd29c9c.png)" 13194139535327 true] [17592186343924 1000 #edb/ref 17592186343925 13194139535327 true] [17592186343924 1000 #edb/ref 17592186343926 13194139535327 true] [17592186343924 1000 #edb/ref 17592186343927 13194139535327 true] [17592186343924 1000 #edb/ref 17592186343928 13194139535327 true] [17592186343924 1000 #edb/ref 17592186343929 13194139535327 true] [17592186343924 1040 #edb/ref 17592186045450 13194139535327 true] [17592186343924 1041 "selection" 13194139535327 true] [17592186343924 1104 #edb/ref 17592186343927 13194139535327 true] [17592186343924 1110 #uuid "42e413e7-86b9-5c5d-860e-92f20a80d907" 13194139535327 true] [17592186343925 1034 "/home/jake/Developer/Course_