y/question-capture/14029846/state.json" "file_sha256" "d4c768da4efb408121081183c2faa4f28e3a3934e391b52a1eb499e0f24a2c5e" "basis" 1202 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029846/edb-import/verification.json"} {"question" "q-122287" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "21"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029846/state.json" "file_sha256" "d4c768da4efb408121081183c2faa4f28e3a3934e391b52a1eb499e0f24a2c5e" "basis" 1202 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029846/edb-import/verification.json"} {"question" "q-122287" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "25"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029846/state.json" "file_sha256" "d4c768da4efb408121081183c2faa4f28e3a3934e391b52a1eb499e0f24a2c5e" "basis" 1202 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029846/edb-import/verification.json"} {"question" "q-122287" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "21"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029846/state.json" "file_sha256" "d4c768da4efb408121081183c2faa4f28e3a3934e391b52a1eb499e0f24a2c5e" "basis" 1202 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14029846/edb-import/verification.json"} {"question" "q-82619" "field" nil "attribute" "question/problem" "value" "The length of a curve $y=f(x)$ is given by ${\\int }_{0}^{1/2}\\sqrt{1+\\frac{1}{(1-x)^{2}}}\\,\\text{d}x.$ Which of the following could be  an equation for this curve?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/state.json" "file_sha256" "ed4ac198a7b04589e0ef88e7bdeeefd8a6dacc32df48b948c5b12e657256ec60" "basis" 1893 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/edb-import/verification.json"} {"question" "q-82619" "field" nil "attribute" "question/worked-solution" "value" "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nWe're given that \n\n$$\nL={\\int }_{0}^{1/2}\\sqrt{1+\\frac{1}{(1-x)^{2}}}\\,\\text{d}x.\n$$\n\nComparing the above with the arc length formula, we see that we must have\n\n$$\n[{f}^{′}(x)]^{2}=\\frac{1}{(1-x)^{2}}\\,⟹\\,{f}^{′}(x)=\\pm \\frac{1}{1-x}.\n$$\n\nIntegrating the above equation with respect to $x,$ we get\n\n$$\n\\begin{aligned}f(x) & =\\pm \\int \\frac{1}{1-x}\\text{ d}x \\\\  & =\\pm (-\\operatorname{ln}⁡|1-x|)+C \\\\  & =\\pm \\operatorname{ln}⁡(1-x)+C.\\end{aligned}\n$$\n\nFrom the given options, the only one that has the required form is $y=\\operatorname{ln}⁡(1-x)+7.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/state.json" "file_sha256" "ed4ac198a7b04589e0ef88e7bdeeefd8a6dacc32df48b948c5b12e657256ec60" "basis" 1893 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/edb-import/verification.json"} {"question" "q-82619" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/activity-metadata.json" "file_sha256" "37b72e28ffad66cad153b4a40654281df0f02639ead2f867ea84bc18623450d2" "basis" 1893 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/edb-import/verification.json"} {"question" "q-82619" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/state.json" "file_sha256" "ed4ac198a7b04589e0ef88e7bdeeefd8a6dacc32df48b948c5b12e657256ec60" "basis" 1893 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/edb-import/verification.json"} {"question" "q-82619" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=-\\frac{1}{1+x}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/state.json" "file_sha256" "ed4ac198a7b04589e0ef88e7bdeeefd8a6dacc32df48b948c5b12e657256ec60" "basis" 1893 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/edb-import/verification.json"} {"question" "q-82619" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=\\frac{1}{(1-x)^{2}}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/state.json" "file_sha256" "ed4ac198a7b04589e0ef88e7bdeeefd8a6dacc32df48b948c5b12e657256ec60" "basis" 1893 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/edb-import/verification.json"} {"question" "q-82619" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=\\frac{1}{1-x}+\\sqrt{2}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/state.json" "file_sha256" "ed4ac198a7b04589e0ef88e7bdeeefd8a6dacc32df48b948c5b12e657256ec60" "basis" 1893 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14059355/edb-import/verification.json"} {"question" "q-82619" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=\\operatorname{ln}⁡(1-x)+7"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/