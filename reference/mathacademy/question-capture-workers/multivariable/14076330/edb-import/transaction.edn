[{:db/id "q-81102/selection/1dc861fb9b88ed211e8b332aae55caefb753ec605d8e267264ba15a3cb3a1526" :answer/id #uuid "748a5a00-26eb-5fb1-8ef1-431dbd6b4abc" :answer/type :answer.type/math :answer/value "{e}^{2}-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-81102/selection/1b997d8421728c5631f9cda834cd98417afb174341c69fc34dcbf627913b140e" :answer/id #uuid "25dadd30-4f82-5609-8c95-aa2362726c73" :answer/type :answer.type/math :answer/value "e-\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-81102/selection/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" :answer/id #uuid "0983aaa1-c4d3-5315-9ea0-f8f4eb83ac61" :answer/type :answer.type/math :answer/value "{e}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-81102/selection/7a1faa903ae46b0a3e4acf78c14a9880b73ef464bcd4b78c3e7a703c6538af45" :answer/id #uuid "9b166296-6138-52ef-b814-b0d078b7a3c3" :answer/type :answer.type/math :answer/value "{e}^{2}" :db/ensure [:answer/validate]} {:db/id "q-81102/selection/5a1fe28b022029f27455dc36a9cc0dbfd0eced1186649091706824f56db6ba8d" :answer/id #uuid "2fd27e43-dbc5-5122-8be8-4bf1a5795fa2" :answer/type :answer.type/math :answer/value "e+1" :db/ensure [:answer/validate]} {:db/id "q-81102/selection" :answer-field/id #uuid "8cc7bb0d-72db-5bff-bb6f-74c7fa28ecc6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81102/selection/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" :answer-field/choices ["q-81102/selection/1dc861fb9b88ed211e8b332aae55caefb753ec605d8e267264ba15a3cb3a1526" "q-81102/selection/1b997d8421728c5631f9cda834cd98417afb174341c69fc34dcbf627913b140e" "q-81102/selection/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" "q-81102/selection/7a1faa903ae46b0a3e4acf78c14a9880b73ef464bcd4b78c3e7a703c6538af45" "q-81102/selection/5a1fe28b022029f27455dc36a9cc0dbfd0eced1186649091706824f56db6ba8d"] :db/ensure [:answer-field/validate]} {:db/id "q-81102" :question/id #uuid "11e0340d-a912-56e9-bdaf-8b1fda948873" :question/math-academy-id "q-81102" :question/problem "If the path $C$ is the line segment $\\overset{―}{AB}$ traversed from the point $A(0,1)$ to the point $B(2,3),$ then ${\\int }_{C}{e}^{x}\\,dx-\\pi \\operatorname{sin}⁡(\\frac{\\pi y}{2})\\,dy=$" :question/worked-solution "The position vectors of the endpoints of our line segment are $a=j$ and $b=2\\,i+3\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =j+t(2\\,i+3\\,j-j) \\\\  & =j+t(2\\,i+2j) \\\\  & =2t\\,i+(1+2t)\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=2t$ and $y(t)=1+2t$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2\\,i+2\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}{e}^{x}\\,dx-\\pi \\operatorname{sin}⁡(\\frac{\\pi y}{2})\\,dy & ={\\int }_{0}^{1}{e}^{x}\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t-\\pi \\operatorname{sin}⁡(\\frac{\\pi y}{2})\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}({e}^{x}\\,\\frac{\\text{d}x}{\\text{d}t}-\\pi \\operatorname{sin}⁡(\\frac{\\pi y}{2})\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}{e}^{2t}\\cdot 2-\\pi \\operatorname{sin}⁡(\\frac{\\pi (1+2t)}{2})\\cdot 2\\,dt \\\\  & ={\\int }_{0}^{1}(2{e}^{2t}-2\\pi \\operatorname{sin}⁡(\\frac{\\pi }{2}+\\pi t))dt \\\\  & ={[{e}^{2t}+2\\operatorname{cos}⁡(\\frac{\\pi }{2}+\\pi t)]}_{0}^{1} \\\\  & =[{e}^{2(1)}+2\\operatorname{cos}⁡(\\frac{\\pi }{2}+\\pi (1))]-[{e}^{2(0)}+2\\operatorname{cos}⁡(\\frac{\\pi }{2}+\\pi (0))] \\\\  & =[{e}^{2}+2\\operatorname{cos}⁡(\\frac{3\\pi }{2})]-[1+2\\operatorname{cos}⁡(\\frac{\\pi }{2})] \\\\  & =[{e}^{2}+0]-[1+0] \\\\  & ={e}^{2}-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81102/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "223ec615-045d-543e-96f4-fec8882bec9e"] :knowledge-point/questions ["q-81102"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124651/selection/88d87b245ab00dd6155ff0bd1978046b97ecdb81bfef720402cb1f2d8ef1a865" :answer/id #uuid "cc0d0d63-1875-5d0a-a3da-a955a222575f" :answer/type :answer.type/math :answer/value "-2{\\int }_{0}^{\\pi /2}{cos}^{2}⁡t{sin}^{2}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124651/selection/afd2ecc400049e25c652b2bb9f69ba24a0e12c0f6df97a459996a69094e64795" :answer/id #uuid "7ac537b3-0516-5f61-a67d-1749df535dd3" :answer/type :answer.type/math :answer/value "3{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t{sin}^{2}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124651/selection/8cb17e1fcdb6fed805244f80edd43faa9ddefe29ccad1431759f6115d4b1dd85" :answer/id #uuid "de4b1f75-bd09-5b6a-96c4-637b91ef719a" :answer/type :answer.type/math :answer/value "-6{\\int }_{0}^{\\pi /2}{cos}^{2}⁡t\\operatorname{sin}⁡t\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124651/selection/3a57746e0069012800d23b66f5a51abd753badf9d4dd439e36c18f4bce3384e0" :answer/id #uuid "00529add-81b6-5dd6-809e-59b8ff3872bd" :answer/type :answer.type/math :answer/value "6{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\operatorname{sin}⁡t(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124651/selection/a4176303cdf2f379db91da334ab4950317ec0307a17d1d7bae35f86ed28a9d4a" :answer/id #uuid "157296f9-073b-501f-97f6-3c4222cf77e8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡t\\operatorname{sin}⁡t(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-124651/selection" :answer-field/id #uuid "7c912c9a-c429-5aef-8750-8c780372a380" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124651/selection/8cb17e1fcdb6fed805244f80edd43faa9ddefe29ccad1431759f6115d4b1dd85" :answer-field/choices ["q-124651/selection/88d87b245ab00dd6155ff0bd1978046b97ecdb81bfef720402cb1f2d8ef1a865" "q-124651/selection/afd2ecc400049e25c652b2bb9f69ba24a0e12c0f6df97a459996a69094e64795" "q-124651/selection/8cb17e1fcdb6fed805244f80edd43faa9ddefe29ccad1431759f6115d4b1dd85" "q-124651/selection/3a57746e0069012800d23b66f5a51abd753badf9d4dd439e36c18f4bce3384e0" "q-124651/selection/a4176303cdf2f379db91da334ab4950317ec0307a17d1d7bae35f86ed28a9d4a"] :db/ensure [:answer-field/validate]} {:db/id "q-124651" :question/id #uuid "35a5240c-df73-5f77-b045-605d4d50b078" :question/math-academy-id "q-124651" :question/problem "Which of the following is equivalent to ${\\int }_{C}{x}^{2}\\,dx+xy\\,dy,$ where $C$ is part of the ellipse ${x}^{2}+4{y}^{2}=4$ traversed in the counterclockwise direction from the point $A(2,0)$ to the point $B(0,1).$" :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $2$ and $1,$ respectively, it can be parametrized as follows:\n\n$$\n\\begin{aligned}r(t) & =x(t)\\,i+y(t)\\,j=2\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j,\\,t\\in [0,\\frac{\\pi }{2}]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=-2\\operatorname{sin}⁡t\\,i+\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}{x}^{2}\\,dx+xy\\,dy & ={\\int }_{0}^{\\pi /2}{x}^{2}\\,\\frac{dx}{\\text{d}t}\\,\\text{d}t+xy\\,\\frac{dy}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}({x}^{2}\\,\\frac{dx}{\\text{d}t}+xy\\,\\frac{dy}{\\text{d}t})\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}(2\\operatorname{cos}⁡t)^{2}\\cdot (-2\\operatorname{sin}⁡t)+(2\\operatorname{cos}⁡t)\\cdot \\operatorname{sin}⁡t\\cdot \\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}-8{cos}^{2}⁡t\\operatorname{sin}⁡t+2{cos}^{2}⁡t\\operatorname{sin}⁡t\\,\\text{d}t \\\\  & =-6{\\int }_{0}^{\\pi /2}{cos}^{2}⁡t\\operatorname{sin}⁡t\\,\\text{d}t\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124651/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632"] :knowledge-point/questions ["q-124651"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-124654"] :question/problem "If the path $C$ is the line segment $\\overset{―}{MN}$ traversed from the point $M(-1,0)$ to the point $N(2,4),$ then ${\\int }_{C}y\\,dx-x\\,dy=$" :question/worked-solution "The position vectors of the endpoints of our line segment are $a=-i$ and $b=2\\,i+4\\,j.$ So, the parametrization of the line segment is given by\n\n$$\n\\begin{aligned}r(t) & =a+t\\,(b-a) \\\\  & =-i+t(2\\,i+4\\,j-(-i)) \\\\  & =-i+t(3\\,i+4\\,j) \\\\  & =(3t-1)\\,i+4t\\,j,\\end{aligned}\n$$\n\nwhere $0\\le t\\le 1.$ Thus, we have that $x(t)=3t-1$ and $y(t)=4t$ along the segment.\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=3\\,i+4\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}y\\,dx-x\\,dy & ={\\int }_{0}^{1}y\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t-x\\,\\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}(y\\,\\frac{\\text{d}x}{\\text{d}t}-x\\,\\frac{\\text{d}y}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{1}4t(3)-(3t-1)(4)\\,dt \\\\  & ={\\int }_{0}^{1}4\\,dt \\\\  & =4t\\,{|}_{0}^{1} \\\\  & =4(1-0) \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-124664/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "f0e8d3c0-5933-59b6-967e-7d4583c36ca1" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-124664/selection/eae6e20b0e88209df89cce04219745901eb9b1e02e887175df95d962f7bb7365" :answer/id #uuid "915db1bb-ea43-51c3-9beb-d012be218d29" :answer/type :answer.type/math :answer/value "\\frac{53}{6}" :db/ensure [:answer/validate]} {:db/id "q-124664/selection/5fb3a82d014523915e20fea47e42b6287cd778db44399d110403c3f136f18487" :answer/id #uuid "ca978376-1d2c-5c47-bf28-b7fb6d7950b9" :answer/type :answer.type/math :answer/value "\\frac{49}{8}" :db/ensure [:answer/validate]} {:db/id "q-124664/selection/27614f314625be7535995396465eb685e53174b0a298d9e08b797b076792c1be" :answer/id #uuid "99d08db5-5831-57fa-96bd-2b2e94d86303" :answer/type :answer.type/math :answer/value "\\frac{42}{7}" :db/ensure [:answer/validate]} {:db/id "q-124664/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "fa2163b8-59b2-515a-9994-d4d556d9ac34" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-124664/selection" :answer-field/id #uuid "fe52b476-1e76-5c31-8c42-ec2e48a10f12" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124664/selection/eae6e20b0e88209df89cce04219745901eb9b1e02e887175df95d962f7bb7365" :answer-field/choices ["q-124664/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-124664/selection/eae6e20b0e88209df89cce04219745901eb9b1e02e887175df95d962f7bb7365" "q-124664/selection/5fb3a82d014523915e20fea47e42b6287cd778db44399d110403c3f136f18487" "q-124664/selection/27614f314625be7535995396465eb685e53174b0a298d9e08b797b076792c1be" "q-124664/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-124664" :question/id #uuid "5ccef1ed-ef2f-5e8d-8fa8-49b0d783b043" :question/math-academy-id "q-124664" :question/problem "If the path $C$ is a part of the graph $y=2\\sqrt{x}$ traversed from the point $P(1,2)$ to point $Q(4,4),$ then ${\\int }_{C}(x-y)\\,dx+(x+y)\\,dy=$" :question/worked-solution "Notice that our curve is given by the explicit Cartesian equation $y=2\\sqrt{x}.$ As a result, we obtain the following parametrization of the curve:\n\n$$\n\\begin{aligned}r(t)=x(t)\\,i+y(t)\\,j={t}^{2}\\,i+2t\\,j,\\,t\\in [1,2]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=2t\\,i+2\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}(x-y)\\,dx+(x+y)\\,dy & ={\\int }_{1}^{2}(x-y)\\,\\frac{\\text{d}x}{\\text{d}t}\\,\\text{d}t+(x+y)\\,\\frac{\\text{d}y}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{1}^{2}((x-y)\\,\\frac{\\text{d}x}{\\text{d}t}+(x+y)\\,\\frac{\\text{d}y}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1}^{2}({t}^{2}-2t)\\cdot 2t+({t}^{2}+2t)\\cdot 2\\,dt \\\\  & =2{\\int }_{1}^{2}t({t}^{2}-2t)+({t}^{2}+2t)\\,dt \\\\  & =2{\\int }_{1}^{2}{t}^{3}-{t}^{2}+2t\\,dt \\\\  & =2{[\\frac{{t}^{4}}{4}-\\frac{{t}^{3}}{3}+{t}^{2}]}_{1}^{2} \\\\  & =2[(\\frac{{2}^{4}}{4}-\\frac{{2}^{3}}{3}+{2}^{2})-(\\frac{{1}^{4}}{4}-\\frac{{1}^{3}}{3}+{1}^{2})] \\\\  & =2[4-\\frac{8}{3}+4-\\frac{1}{4}+\\frac{1}{3}-1] \\\\  & =2\\cdot \\frac{53}{12} \\\\  & =\\frac{53}{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124664/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f04a969-e7e0-592f-b5cd-e92fedb217a8"] :knowledge-point/questions ["q-124664"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124665/selection/a6243871a01a662508c3c36bcf132779ad2e083dc3e8816c669b1d65f01067e3" :answer/id #uuid "4545096a-fe21-5515-9523-3a9dced7d27e" :answer/type :answer.type/math :answer/value "3\\pi -4" :db/ensure [:answer/validate]} {:db/id "q-124665/selection/0dd6165380a237d0c311c9816ff52800907deea698233494036eb98b5b0e349d" :answer/id #uuid "13e6d829-2a88-5644-891b-5e3578fc97cd" :answer/type :answer.type/math :answer/value "3\\pi +1" :db/ensure [:answer/validate]} {:db/id "q-124665/selection/ad5f441ebc32c9cbb6453f4d59c36a31c9bd747de66abecedf68987450f5cccd" :answer/id #uuid "aa620ab4-ea7d-5a55-a1b6-e5d549c914c3" :answer/type :answer.type/math :answer/value "2\\pi -1" :db/ensure [:answer/validate]} {:db/id "q-124665/selection/960bf769432ea718dfa724e5e092c713a2f18d7c5a238840f6d488dac85b4f0c" :answer/id #uuid "ab6a4d83-1dd1-5c5e-8e5a-8efa553af1c8" :answer/type :answer.type/math :answer/value "\\frac{3\\pi +1}{2}" :db/ensure [:answer/validate]} {:db/id "q-124665/selection/1a2c3881891ab7eca8aa4af8d7002d84b8252f633df18da1be453e64ebd8a8b4" :answer/id #uuid "36257285-c3de-51d8-bbc5-b02549c0390a" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "q-124665/selection" :answer-field/id #uuid "6e081e77-5eac-54c3-96d1-b40683f8ba62" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124665/selection/0dd6165380a237d0c311c9816ff52800907deea698233494036eb98b5b0e349d" :answer-field/choices ["q-124665/selection/a6243871a01a662508c3c36bcf132779ad2e083dc3e8816c669b1d65f01067e3" "q-124665/selection/0dd6165380a237d0c311c9816ff52800907deea698233494036eb98b5b0e349d" "q-124665/selection/ad5f441ebc32c9cbb6453f4d59c36a31c9bd747de66abecedf68987450f5cccd" "q-124665/selection/960bf769432ea718dfa724e5e092c713a2f18d7c5a238840f6d488dac85b4f0c" "q-124665/selection/1a2c3881891ab7eca8aa4af8d7002d84b8252f633df18da1be453e64ebd8a8b4"] :db/ensure [:answer-field/validate]} {:db/id "q-124665" :question/id #uuid "47948794-c19d-5fb2-9c5b-1aef41a0ecff" :question/math-academy-id "q-124665" :question/problem "Evaluate ${\\int }_{C}dx+\\frac{2}{x}\\,dy,$ where $C$ is part of the ellipse $9{x}^{2}+{y}^{2}=9$ traversed in the counterclockwise direction from the point $(-1,0)$ to the point $(0,-3).$" :question/worked-solution "Since $C$ is an ellipse centered at $O$ with horizontal and vertical semiaxes of $1$ and $3,$ respectively, it can be parametrized as follows:\n\n$$\n\\begin{aligned}r(t) & =x(t)\\,i+y(t)\\,j=\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j,\\,t\\in [\\pi ,\\frac{3\\pi }{2}]\\end{aligned}\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j=-\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}dx+\\frac{2}{x}\\,dy & ={\\int }_{\\pi }^{3\\pi /2}\\frac{dx}{\\text{d}t}\\,\\text{d}t+\\frac{2}{x}\\,\\frac{dy}{\\text{d}t}\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(\\frac{dx}{\\text{d}t}+\\frac{2}{x}\\,\\frac{dy}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}(-\\operatorname{sin}⁡t)+\\frac{2}{\\operatorname{cos}⁡t}\\cdot 3\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{\\pi }^{3\\pi /2}-\\operatorname{sin}⁡t+6\\,\\text{d}t \\\\  & =[\\operatorname{cos}⁡t+6t]_{\\pi }^{3\\pi /2} \\\\  & =(\\operatorname{cos}⁡(\\frac{3\\pi }{2})+9\\pi )-(\\operatorname{cos}⁡\\pi +6\\pi ) \\\\  & =(0+9\\pi )-(-1+6\\pi ) \\\\  & =3\\pi +1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124665/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e5b5c517-8e13-5b70-bd1f-15ae495f0632"] :knowledge-point/questions ["q-124665"] :db/ensure [:knowledge-point/validate]}]
