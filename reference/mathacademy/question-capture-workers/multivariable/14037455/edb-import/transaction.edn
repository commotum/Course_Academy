cos}⁡4t⟩,$ $|r(\\frac{\\pi }{3})|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{3}),\\,\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨-\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(-\\frac{\\sqrt{3}}{2})}^{2}+{(-\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123284/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6"] :knowledge-point/questions ["q-123284"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123218/selection/d21cf04195b9f60647c9c40557d8127317e089761bb87d88a6ff99e541a3c1f5" :answer/id #uuid "3e73d4f0-c73c-5374-9ce4-38dace754af3" :answer/type :answer.type/math :answer/value "2\\sqrt{17}" :db/ensure [:answer/validate]} {:db/id "q-123218/selection/d7a2eed6f1a0ddde34dda83c2eff63b490d1c46926c189e70f393bd730e4d502" :answer/id #uuid "21b4426f-8ec9-577e-8607-e50eff62d43c" :answer/type :answer.type/math :answer/value "\\sqrt{15}" :db/ensure [:answer/validate]} {:db/id "q-123218/selection/33ad5bb85ef2860b8848dac07e73b48f485bff167e79bb938240370691781b46" :answer/id #uuid "1e325a11-3827-54db-a0b2-16858149088d" :answer/type :answer.type/math :answer/value "34" :db/ensure [:answer/validate]} {:db/id "q-123218/selection/5371f7c0b0dcb7971e259333187268b3f161f844a21da0bac5a59ac2c4f7743f" :answer/id #uuid "ae198a46-e41e-5c56-8c6c-6806b459627f" :answer/type :answer.type/math :answer/value "\\sqrt{34}" :db/ensure [:answer/validate]} {:db/id "q-123218/selection/bce5bc74acc9e271a9aeae8cb85f9c588ed3f6d470d97b9e874c304911b907e8" :answer/id #uuid "b1a0d967-f137-5336-84a9-484d89bc2892" :answer/type :answer.type/math :answer/value "15\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-123218/selection" :answer-field/id #uuid "a1b2f1e9-c139-5a80-b010-4f8bf206834f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123218/selection/5371f7c0b0dcb7971e259333187268b3f161f844a21da0bac5a59ac2c4f7743f" :answer-field/choices ["q-123218/selection/d21cf04195b9f60647c9c40557d8127317e089761bb87d88a6ff99e541a3c1f5" "q-123218/selection/d7a2eed6f1a0ddde34dda83c2eff63b490d1c46926c189e70f393bd730e4d502" "q-123218/selection/33ad5bb85ef2860b8848dac07e73b48f485bff167e79bb938240370691781b46" "q-123218/selection/5371f7c0b0dcb7971e259333187268b3f161f844a21da0bac5a59ac2c4f7743f" "q-123218/selection/bce5bc74acc9e271a9aeae8cb85f9c588ed3f6d470d97b9e874c304911b907e8"] :db/ensure [:answer-field/validate]} {:db/id "q-123218" :question/id #uuid "e6223034-9bd4-5915-9377-485475efbf96" :question/math-academy-id "q-123218" :question/problem "Given that $r(t)=⟨4{sin}^{2}⁡(5t),\\,10\\operatorname{cos}⁡(5t)⟩,$ $|r(\\frac{\\pi }{3})|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨4{sin}^{2}⁡(\\frac{5\\pi }{3}),\\,10\\operatorname{cos}⁡(\\frac{5\\pi }{3})⟩ \\\\  & =⟨3,\\,5⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(3)}^{2}+{(5)}^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123218/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6"] :knowledge-point/questions ["q-123218"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-12450"] :question/problem "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle,$ calculate $\\mathbf r (3).$" :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}r(3) & =⟨6(3),\\,2(3)^{2}-1⟩ \\\\  & =⟨18,\\,17⟩.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-12452"] :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi.$" :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\pi ) & =⟨\\operatorname{cos}⁡\\pi ,\\,\\operatorname{sin}⁡\\pi ,\\,\\pi ⟩=⟨-1,0,\\pi \\,⟩\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle.$\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n\n$$\n[\\begin{aligned}-1 \\\\ 0 \\\\ \\pi \\end{aligned}]\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-12451"] :question/problem "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t)  = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle,$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨2-4,\\,2\\sqrt{4},\\,4-1⟩ \\\\  & =⟨-2,\\,4,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(-2)}^{2}+{(4)}^{2}+{(3)}^{2}} \\\\  & =\\sqrt{4+16+9} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
