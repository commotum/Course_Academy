 evaluate, we substitute $t=1$ into the function, as follows:\n\n$$\n\\begin{aligned}h(1) & =({1}^{3}-1)\\,i+{e}^{\\,1-1}\\,j+\\sqrt[4]{1+15}\\,sin\\,(\\frac{\\pi }{2})\\,k \\\\  & =0\\,i+{e}^{0}\\,j+\\sqrt[4]{16}\\cdot 1\\,k \\\\  & =0\\,i+1\\,j+2\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-348649/field-1" "q-348649/field-2" "q-348649/field-3"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a"] :knowledge-point/questions ["q-348649"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348652/field-1/66222026d177d8ad430f0506d17011ddfd033c06cbf0e92e9ead96ba149fe291" :answer/id #uuid "951140da-7dc1-5716-8e51-a68ab8450f13" :answer/type :answer.type/math :answer/value "\\sqrt{\\pi+8}" :db/ensure [:answer/validate]} {:db/id "q-348652/field-1/b0d5e86b183e21dac129edc377100a45b6a044bd26b46a4b73d78505598742a9" :answer/id #uuid "fba456da-20ee-508f-8a4f-ddf4f05ccd84" :answer/type :answer.type/math :answer/value "\\sqrt{\\pi+9}" :db/ensure [:answer/validate]} {:db/id "q-348652/field-1" :answer-field/id #uuid "47b44fbc-07d7-5c87-8f19-65a3255a95a7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348652/field-1/66222026d177d8ad430f0506d17011ddfd033c06cbf0e92e9ead96ba149fe291" :answer-field/choices ["q-348652/field-1/66222026d177d8ad430f0506d17011ddfd033c06cbf0e92e9ead96ba149fe291" "q-348652/field-1/b0d5e86b183e21dac129edc377100a45b6a044bd26b46a4b73d78505598742a9"] :db/ensure [:answer-field/validate]} {:db/id "q-348652/field-2/e1a60e4f41452f4cefcb3b3f6f83981739373455290bdb26b6a96fb0a7e360ca" :answer/id #uuid "896cab89-1a04-5e51-bb69-56caeb81a879" :answer/type :answer.type/math :answer/value "\\ln(\\pi+1)" :db/ensure [:answer/validate]} {:db/id "q-348652/field-2" :answer-field/id #uuid "b8189813-d715-5338-9166-defa0dfdf50f" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348652/