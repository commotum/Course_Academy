92186296795} {:answer-field/choices [{:answer/id #uuid "896cab89-1a04-5e51-bb69-56caeb81a879" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\pi+1)" :db/id #edb/ref 17592186296799}] :answer-field/correct {:answer/id #uuid "896cab89-1a04-5e51-bb69-56caeb81a879" :answer/type {:db/ident :answer.type/math} :answer/value "\\ln(\\pi+1)" :db/id #edb/ref 17592186296799} :answer-field/id #uuid "b8189813-d715-5338-9166-defa0dfdf50f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296798} {:answer-field/choices [{:answer/id #uuid "5c523f21-6918-59cb-ab52-cf50b8fbbb88" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296801}] :answer-field/correct {:answer/id #uuid "5c523f21-6918-59cb-ab52-cf50b8fbbb88" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296801} :answer-field/id #uuid "b09ec14b-9c77-5cc9-8b96-84aed0c92497" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296800}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c543b2c9-9bd9-5400-aeed-00be99158407" :question/math-academy-id "q-348652" :question/problem "What is the value of $g(t)=[\\begin{aligned}\\sqrt{t+8} \\\\ \\operatorname{ln}⁡(t+1) \\\\ 2\\operatorname{sin}⁡t\\end{aligned}]$ at $t=\\pi ?$\n\n|  |  | {{field-1}} |  |\n| --- | --- | --- | --- |\n| $g(\\pi )=\\,\\,$ |  | {{field-2}} |  |\n|  |  | {{field-3}} |  |" :question/worked-solution "To evaluate, we substitute $t=\\pi $ into our function, as follows:\n\n$$\n\\begin{aligned}g(\\pi ) & =[\\begin{aligned}\\sqrt{\\pi +8} \\\\ \\operatorname{ln}⁡(\\pi +1) \\\\ 2\\operatorname{sin}⁡(\\pi )\\end{aligned}] \\\\  & =[\\begin{aligned}\\sqrt{\\pi +8} \\\\ \\operatorname{ln}⁡(\\pi +1) \\\\ 0\\end{aligned}]\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296802 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "734c3ee4-c63b-5b2d-9d50-556990311461" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186296804} {:answer/id #uuid "d14f86ac-dcff-55d2-b3b7-af471d436804" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186296805}] :answer-field/correct {:answer/id #uuid "734c3ee4-c63b-5b2d-9d50-556990311461" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186296804} :answer-field/id #uuid "278e6af9-b46e-5157-8bf0-7abeb45e27e5" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296803}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ae45ac93-c493-5bb4-93c6-95e53a04e9aa" :question/math-academy-id "q-348690" :question/problem "Given that $r(t)=⟨cos\\,(\\frac{\\pi t}{2}),\\,\\sqrt{{t}^{3}-4},\\,ln\\,(2\\,{e}^{t-2}-1)⟩,$ what is $|r(2)|?$ Do not round the answer.\n\n$|r(2)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=2,$ we get\n\n$$\n\\begin{aligned}r(2) & =⟨cos\\,(\\frac{2\\pi }{2}),\\,\\sqrt{{2}^{3}-4},\\,ln\\,(2\\,{e}^{0}-1)⟩ \\\\  & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,\\operatorname{ln}⁡(1)⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(2)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4+0} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296806 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "08edd9c0-ba63-5ad6-91de-5442586c9005" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186296808}] :answer-field/correct {:answer/id #uuid "08edd9c0-ba63-5ad6-91de-5442586c9005" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186296808} :answer-field/id #uuid "d2db978f-561d-5f77-83e4-a92f3f23e881" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296807}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5be0218a-416b-5870-bd64-765410da524e" :question/math-academy-id "q-348693" :question/problem "Given that $r(t)=⟨\\operatorname{cos}⁡(\\pi t),\\,\\sqrt{t+3},\\,t-1⟩,$ what is $|r(1)|?$ Do not round the answer.\n\n$|r(1)|=$\n{{field-1}}" :question/worked-solution "Evaluating the function at $t=1,$ we get\n\n$$\n\\begin{aligned}r(1) & =⟨\\operatorname{cos}⁡(\\pi ),\\,\\sqrt{4},\\,0⟩ \\\\  & =⟨-1,\\,2,\\,0⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(1)| & =\\sqrt{(-1)^{2}+{2}^{2}+{0}^{2}} \\\\  & =\\sqrt{1+4} \\\\  & =\\sqrt{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186069327 :knowledge-point/_questions [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1172628-b8de-5cb4-95bd-a8f455049837" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 16⟩" :db/id #edb/ref 17592186067494} {:answer/id #uuid "f268bf05-bc56-5605-a6f5-550f86716c40" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 8⟩" :db/id #edb/ref 17592186067495} {:answer/id #uuid "0706e20a-64d3-5f9c-81d2-af0c8791de4f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 24⟩" :db/id #edb/ref 17592186067496} {:answer/id #uuid "68698433-03ea-5194-b096-e0c812be0f1e" :answer/type {:db/ident :answer.type/math} :answer/