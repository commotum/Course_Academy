#{[{:db/id #edb/ref 17592186068380 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/id #uuid "6eea01b2-bc2a-55a8-9bab-6789df00fc42" :question/math-academy-id "e-12450" :question/problem "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle,$ calculate $\\mathbf r (3).$" :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}r(3) & =⟨6(3),\\,2(3)^{2}-1⟩ \\\\  & =⟨18,\\,17⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068381 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/id #uuid "86e423e7-db4b-5fdf-a285-bded3bd8161e" :question/math-academy-id "e-12451" :question/problem "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t)  = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle,$" :question/worked-solution "Evaluating the function at $t=4,$ we get\n\n$$\n\\begin{aligned}r(4) & =⟨2-4,\\,2\\sqrt{4},\\,4-1⟩ \\\\  & =⟨-2,\\,4,\\,3⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}|r(4)| & =\\sqrt{{(-2)}^{2}+{(4)}^{2}+{(3)}^{2}} \\\\  & =\\sqrt{4+16+9} \\\\  & =\\sqrt{29}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068382 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/id #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" :question/math-academy-id "e-12452" :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi.$" :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}f(\\pi ) & =⟨\\operatorname{cos}⁡\\pi ,\\,\\operatorname{sin}⁡\\pi ,\\,\\pi ⟩=⟨-1,0,\\pi \\,⟩\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle.$\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n\n$$\n[\\begin{aligned}-1 \\\\ 0 \\\\ \\pi \\end{aligned}]\n$$"}] [{:db/id #edb/ref 17592186296741 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1e325a11-3827-54db-a0b2-16858149088d" :answer/type {:db/ident :answer.type/math} :answer/value "34" :db/id #edb/ref 17592186296743} {:answer/id #uuid "ae198a46-e41e-5c56-8c6c-6806b459627f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186296744} {:answer/id #uuid "b1a0d967-f137-5336-84a9-484d89bc2892" :answer/type {:db/ident :answer.type/math} :answer/value "15\\sqrt{3}" :db/id #edb/ref 17592186296745} {:answer/id #uuid "3e73d4f0-c73c-5374-9ce4-38dace754af3" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{17}" :db/id #edb/ref 17592186296746} {:answer/id #uuid "21b4426f-8ec9-577e-8607-e50eff62d43c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{15}" :db/id #edb/ref 17592186296747}] :answer-field/correct {:answer/id #uuid "ae198a46-e41e-5c56-8c6c-6806b459627f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{34}" :db/id #edb/ref 17592186296744} :answer-field/id #uuid "a1b2f1e9-c139-5a80-b010-4f8bf206834f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296742}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e6223034-9bd4-5915-9377-485475efbf96" :question/math-academy-id "q-123218" :question/problem "Given that $r(t)=⟨4{sin}^{2}⁡(5t),\\,10\\operatorname{cos}⁡(5t)⟩,$ $|r(\\frac{\\pi }{3})|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨4{sin}^{2}⁡(\\frac{5\\pi }{3}),\\,10\\operatorname{cos}⁡(\\frac{5\\pi }{3})⟩ \\\\  & =⟨3,\\,5⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(3)}^{2}+{(5)}^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296748 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f48ac109-c8b5-54a5-a9f1-dc0942609a4b" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186296750} {:answer/id #uuid "d6ec60fd-2b88-52ff-8e4f-71048d34a906" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186296751} {:answer/id #uuid "a9796bf4-1225-50fd-a3d7-0aa78868f190" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186296752} {:answer/id #uuid "67b54ffc-fab6-5f31-b850-45e9daa0ca41" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186296753} {:answer/id #uuid "44a1defd-4838-581d-881b-ba86e4cdc971" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296754}] :answer-field/correct {:answer/id #uuid "44a1defd-4838-581d-881b-ba86e4cdc971" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296754} :answer-field/id #uuid "f3a92006-26c7-5852-b443-05666a406f72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296749}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9707e332-503b-551e-98d0-95ec19345726" :question/math-academy-id "q-123284" :question/problem "Given that $r(t)=⟨\\operatorname{sin}⁡4t,\\,\\operatorname{cos}⁡4t⟩,$ $|r(\\frac{\\pi }{3})|=$" :question/worked-solution "Evaluating the function at $t=\\frac{\\pi }{3},$ we get\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{3}) & =⟨\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{3}),\\,\\operatorname{cos}⁡(4\\cdot \\frac{\\pi }{3})⟩ \\\\  & =⟨-\\frac{\\sqrt{3}}{2},\\,-\\frac{1}{2}⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(\\frac{\\pi }{3})| & =\\sqrt{{(-\\frac{\\sqrt{3}}{2})}^{2}+{(-\\frac{1}{2})}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}} \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296755 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8dee0141-ee47-5f4c-a7ce-e6959d32d8dd" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j-16\\,k" :db/id #edb/ref 17592186296757} {:answer/id #uuid "b0f36f45-c831-5c27-8eae-05f459e7303c" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+16\\,k" :db/id #edb/ref 17592186296758} {:answer/id #uuid "f1c8e759-c0ce-5274-9338-241596b7ed67" :answer/type {:db/ident :answer.type/math} :answer/value "5\\,j" :db/id #edb/ref 17592186296759} {:answer/id #uuid "577e3102-deff-5eee-98f2-1f101676421b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186296760} {:answer/id #uuid "a8cdf08b-251f-568b-8ca0-95067dbca6a5" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,k" :db/id #edb/ref 17592186296761}] :answer-field/correct {:answer/id #uuid "577e3102-deff-5eee-98f2-1f101676421b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,i+2\\,j+16\\,k" :db/id #edb/ref 17592186296760} :answer-field/id #uuid "dcb1abb0-c585-5d84-9b43-d58fcb8454b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296756}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dbca96e3-97ce-5664-9b73-f99e6dcd22bd" :question/math-academy-id "q-160776" :question/problem "What is the value of $f(t)=2{e}^{t}\\,i+\\sqrt{t+4}\\,j+(t-2)^{4}\\,k$ at $t=0?$" :question/worked-solution "To evaluate, we substitute $t=0$ into the function, as follows:\n\n$$\n\\begin{aligned}f(0) & =2{e}^{0}\\,i+\\sqrt{0+4}\\,j+(0-2)^{4}\\,k \\\\  & =2\\,i+2\\,j+16\\,k\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=0$ is the vector $2\\,i+2\\,j+16\\,k.$"}] [{:db/id #edb/ref 17592186296762 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b127603d-17be-5c2d-9bf1-c64942768bd3" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},1,2⟩" :db/id #edb/ref 17592186296764} {:answer/id #uuid "106597b3-f922-55d6-b06d-76130aeb76d0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,4,0⟩" :db/id #edb/ref 17592186296765} {:answer/id #uuid "a9539750-fa76-54c3-940f-33d20561b76b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},-2,0⟩" :db/id #edb/ref 17592186296766} {:answer/id #uuid "779d6003-a698-52c8-af12-331103df5da5" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-2,2⟩" :db/id #edb/ref 17592186296767} {:answer/id #uuid "ed150e4d-5652-5e75-994c-bbcfb53a9b27" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},2,0⟩" :db/id #edb/ref 17592186296768}] :answer-field/correct {:answer/id #uuid "a9539750-fa76-54c3-940f-33d20561b76b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\sqrt{2},-2,0⟩" :db/id #edb/ref 17592186296766} :answer-field/id #uuid "e32f4cc7-20ea-58f6-8016-c13f110be7f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296763}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "57c04c0e-8cfb-5c8e-9a68-5f6f365aeff7" :question/math-academy-id "q-161509" :question/problem "What is the value of $f(t)=⟨\\sqrt{t+1},\\,{t}^{2}-3,\\,1-t⟩$ at $t=1?$" :question/worked-solution "To evaluate, we substitute $t=1$ into the function, as follows:\n\n$$\n\\begin{aligned}f(1) & =⟨\\sqrt{1+1},{1}^{2}-3,1-1⟩ \\\\  & =⟨\\sqrt{2},1-3,1-1⟩ \\\\  & =⟨\\sqrt{2},-2,0⟩\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=1$ is the vector $⟨\\sqrt{2},-2,0⟩.$"}] [{:db/id #edb/ref 17592186296769 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6e5800ff-0e56-5853-9db9-e1263dd895c2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡3,\\sqrt{2},32⟩" :db/id #edb/ref 17592186296771} {:answer/id #uuid "593b4d99-0341-58bb-8e0a-6f4c9429f60b" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,\\sqrt{2},32⟩" :db/id #edb/ref 17592186296772} {:answer/id #uuid "d47e0755-e12b-5895-9265-2b4355304408" :answer/type {:db/ident :answer.type/math} :answer/value "⟨\\operatorname{ln}⁡3,2,8⟩" :db/id #edb/ref 17592186296773} {:answer/id #uuid "6f59d26c-1904-51f2-accf-fec61142cf16" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,2,32⟩" :db/id #edb/ref 17592186296774} {:answer/id #uuid "38d022ab-c4d5-5c31-a733-f6c1bbd4731d" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,2,16⟩" :db/id #edb/ref 17592186296775}] :answer-field/correct {:answer/id #uuid "6f59d26c-1904-51f2-accf-fec61142cf16" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,2,32⟩" :db/id #edb/ref 17592186296774} :answer-field/id #uuid "1492c643-722f-5547-8cd0-3f1399a2da31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186296770}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "093b9e33-3bd8-5d4d-a8c1-8097498b50b9" :question/math-academy-id "q-161511" :question/problem "What is the value of $f(t)=⟨\\operatorname{ln}⁡({t}^{2}-3),\\,\\sqrt{2t},\\,{t}^{5}⟩$ at $t=2?$" :question/worked-solution "To evaluate, we substitute $t=2$ into the function, as follows:\n\n$$\n\\begin{aligned}f(2) & =⟨\\operatorname{ln}⁡({2}^{2}-3),\\sqrt{2(2)},{2}^{5}⟩ \\\\  & =⟨\\operatorname{ln}⁡(1),\\sqrt{4},{2}^{5}⟩ \\\\  & =⟨0,2,32⟩\\end{aligned}\n$$\n\nSo, the value of $f(t)$ at $t=2$ is the vector $⟨0,2,32⟩.$"}] [{:db/id #edb/ref 17592186296776 :knowledge-point/_questions [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "202e885b-0a72-50ea-8858-a1c34da8442a" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186296778} {:answer/id #uuid "4bbca028-adf8-5b6d-b634-3d6d6c8f7a9d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186296779}] :answer-field/correct {:answer/id #uuid "4bbca028-adf8-5b6d-b634-3d6d6c8f7a9d" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186296779} :answer-field/id #uuid "f963f479-e160-5b77-a317-26225b86c77f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296777} {:answer-field/choices [{:answer/id #uuid "e8cf4d10-e17e-584e-9478-da467a880d05" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186296781}] :answer-field/correct {:answer/id #uuid "e8cf4d10-e17e-584e-9478-da467a880d05" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186296781} :answer-field/id #uuid "db2bf974-70b6-5f36-81e0-34e361ccfac3" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296780}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5974e7be-e8c4-5323-b240-f7ed5a4f5783" :question/math-academy-id "q-348637" :question/problem "Given that $r(t)=⟨\\sqrt{6t-2},\\,{t}^{2}+3⟩,$ calculate $r(3).$\n\n$r(3)=⟨$\n{{field-1}} $,$\n\n{{field-2}}$⟩$" :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}r(3) & =⟨\\sqrt{6(3)-2},\\,{3}^{2}+3⟩ \\\\  & =⟨\\sqrt{16},\\,12⟩ \\\\  & =⟨4,\\,12⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296782 :knowledge-point/_questions [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c168c6d-77d8-526b-8b23-90e76af11d58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186296784}] :answer-field/correct {:answer/id #uuid "6c168c6d-77d8-526b-8b23-90e76af11d58" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186296784} :answer-field/id #uuid "43e69b95-50aa-5f47-8949-24c0cb5921b2" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296783} {:answer-field/choices [{:answer/id #uuid "960dbdce-e1cd-51a9-bdd2-7b925bf1cf6d" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186296786}] :answer-field/correct {:answer/id #uuid "960dbdce-e1cd-51a9-bdd2-7b925bf1cf6d" :answer/type {:db/ident :answer.type/math} :answer/value "31" :db/id #edb/ref 17592186296786} :answer-field/id #uuid "87eadbcf-e126-52a8-a7a0-e1117e137018" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296785}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "47d1ecb4-0b55-56df-ad5a-47d88d22780b" :question/math-academy-id "q-348644" :question/problem "Given that $r(t)=⟨\\frac{3}{t-2},\\,2{t}^{2}-1⟩,$ calculate $r(4).$\n\n$r(4)=⟨$\n{{field-1}} $,$\n\n{{field-2}}$⟩$" :question/worked-solution "We substitute $t=4$ into our function, and we get\n\n$$\n\\begin{aligned}r(4) & =⟨\\frac{3}{4-2},\\,2(4)^{2}-1⟩ \\\\  & =⟨\\frac{3}{2},\\,31⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186296787 :knowledge-point/_questions [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5324748e-5ef3-57b8-a19e-86bc0988c0ce" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296789}] :answer-field/correct {:answer/id #uuid "5324748e-5ef3-57b8-a19e-86bc0988c0ce" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186296789} :answer-field/id #uuid "13d17852-043f-5425-92a3-9f7cea828a57" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296788} {:answer-field/choices [{:answer/id #uuid "eac88f0c-26a5-5c96-97a4-4d3b35be579f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296791}] :answer-field/correct {:answer/id #uuid "eac88f0c-26a5-5c96-97a4-4d3b35be579f" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186296791} :answer-field/id #uuid "166ff396-d156-5e8d-920d-abe8f7df91da" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186296790} {:answer-field/choices [{:answer/id #uuid "791c6aae-ee61-5072-8ce0-71e2eebffa29" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186