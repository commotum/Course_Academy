#{[{:db/id #edb/ref 17592186068380 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/id #uuid "6eea01b2-bc2a-55a8-9bab-6789df00fc42" :question/math-academy-id "e-12450" :question/problem "Given that $\\mathbf r (t) = \\langle 6t, 2t^2-1\\rangle$, calculate $\\mathbf r (3)$." :question/worked-solution "We substitute $t=3$ into our function, and we get\n\n$$\n\\begin{aligned}\nr(3) &= ⟨6(3), 2(3)^{2} - 1⟩ \\\\\n&= ⟨18, 17⟩\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068381 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/id #uuid "86e423e7-db4b-5fdf-a285-bded3bd8161e" :question/math-academy-id "e-12451" :question/problem "Find $\\left|\\mathbf r\\left(4\\right)\\right|$ given that $\\mathbf r(t) = \\left\\langle 2-t, 2\\sqrt{t}, \\, t-1\\right\\rangle$," :question/worked-solution "Evaluating the function at $t=4$, we get\n\n$$\n\\begin{aligned}\nr(4) &= ⟨2 - 4, 2\\sqrt{4}, 4 - 1⟩ \\\\\n&= ⟨ - 2, 4, 3⟩\n\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we obtain\n\n$$\n\\begin{aligned}\n\\mid r(4) \\mid &= \\sqrt{(-2)^{2} + (4)^{2} + (3)^{2}} \\\\\n&= \\sqrt{4 + 16 + 9} \\\\\n&= \\sqrt{29}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186068382 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "26571ec1-e645-5f07-ba4e-75c22558394a" :knowledge-point/title "Evaluating a Three-Component Vector-Valued Function"}] :question/id #uuid "ab3899d3-8838-57ad-8a17-b8ac2934c0f9" :question/math-academy-id "e-12452" :question/problem "Find the value of the vector function $\\mathbf f(t) = \\left\\langle \\cos t, \\: \\sin t, \\: t \\right\\rangle$ at $t = \\pi$." :question/worked-solution "To evaluate, we substitute $t = \\pi$ into the function, as follows:\n\n$$\n\\begin{aligned}\nf(π) &= ⟨\\cos π, \\sin π, π⟩ = ⟨ - 1, 0, π⟩\n\\end{aligned}\n$$\n\nSo, the value of $\\mathbf f (t)$ at $t = \\pi$ is $\\langle -1, 0, \\pi \\rangle$.\n\nWe can also express the answer using $\\mathbf i$-$\\mathbf j$-$\\mathbf k$ notation or square bracket notation, as follows:\n$\\begin{bmatrix}-1 \\\\ 0 \\\\ π\\end{bmatrix}$"}] [{:db/id #edb/ref 17592186069327 :knowledge-point/_questions [{:knowledge-point/id #uuid "d59ccd52-63db-5d28-b78b-2df7caf52ad0" :knowledge-point/title "Evaluating a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1172628-b8de-5cb4-95bd-a8f455049837" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 16⟩" :db/id #edb/ref 17592186067494} {:answer/id #uuid "f268bf05-bc56-5605-a6f5-550f86716c40" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 8⟩" :db/id #edb/ref 17592186067495} {:answer/id #uuid "0706e20a-64d3-5f9c-81d2-af0c8791de4f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 24⟩" :db/id #edb/ref 17592186067496} {:answer/id #uuid "68698433-03ea-5194-b096-e0c812be0f1e" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186067497} {:answer/id #uuid "71484200-1dc1-557f-8211-e8450bbdfab0" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 12⟩" :db/id #edb/ref 17592186067498}] :answer-field/correct {:answer/id #uuid "0706e20a-64d3-5f9c-81d2-af0c8791de4f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨4, 24⟩" :db/id #edb/ref 17592186067496} :answer-field/id #uuid "5d40d14a-6e8c-5c69-b4ac-fe2d4e6f5d43" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186067493}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a3b2939c-ae68-5c6a-8f8f-be58968873ca" :question/math-academy-id "q-50083" :question/problem "Given that $r(t) = ⟨t^{2}, 3t^{3}⟩$, calculate $r(2)$." :question/worked-solution "We  substitute $t=2$ into our function, and we get\n\n$$\n\\begin{aligned}r(2) & =⟨{2}^{2},\\,3\\cdot {2}^{3}⟩ \\\\  & =⟨4,\\,24⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186268613 :knowledge-point/_questions [{:knowledge-point/id #uuid "e520dc67-3b63-5ca7-959b-f642d85529d6" :knowledge-point/title "Finding the Magnitude of a Vector-Valued Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "87b1d33f-fe7b-5cd0-9d3d-d409a567c209" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186268615} {:answer/id #uuid "9eda29bc-19d4-52fb-b59a-85396aad351d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268616} {:answer/id #uuid "ab93ecbe-5935-5986-80ef-2fc983c0196a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{7}" :db/id #edb/ref 17592186268617} {:answer/id #uuid "586b5ae3-3342-501e-8e94-59bdffebe3d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{3}" :db/id #edb/ref 17592186268618} {:answer/id #uuid "ed18e90c-ff09-5820-afb3-957b53c31273" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186268619}] :answer-field/correct {:answer/id #uuid "9eda29bc-19d4-52fb-b59a-85396aad351d" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186268616} :answer-field/id #uuid "b323f65f-9f42-5f8d-a5af-d794abae74fd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186268614}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f9a5c122-9fbb-5128-a8f8-39c71927c4cf" :question/math-academy-id "q-75004" :question/problem "Given that $r(t)=⟨\\sqrt{t},\\,t-3⟩,$ $|r(5)|=$" :question/worked-solution "Evaluating the function at $t=5,$ we get\n\n$$\n\\begin{aligned}r(5) & =⟨\\sqrt{5},\\,5-3⟩ \\\\  & =⟨\\sqrt{5},\\,2⟩.\\end{aligned}\n$$\n\nComputing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|r(5)| & =\\sqrt{{(\\sqrt{5})}^{2}+{(2)}^{2}} \\\\  & =\\sqrt{5+4} \\\\  & =3.\\end{aligned}\n$$"}]}
