2b68-f6b9-5024-b293-d78a5df92981" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186284143} {:answer/id #uuid "bcd14e6c-96a8-5e25-8afa-97f7ad9c26f8" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186284144}] :answer-field/correct {:answer/id #uuid "4437aa5a-a749-5c6d-8f3d-d31b01601abb" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186284140} :answer-field/id #uuid "beca3bfc-6192-5bd4-9d93-1a9d76036bc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284139}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2a34e82b-455b-568a-911e-4e41e8de38c3" :question/math-academy-id "q-162201" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/cfcbd4b374456b4a5913289592d875a42caf81fd02984180e68e34c5b82ef905.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}0 & 0 \\\\ 0 & 0\\end{aligned}].\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nSince $T$ is the zero matrix, the image of our object under the action of $T$ is the origin."}] [{:db/id #edb/ref 17592186289303 :knowledge-point/_questions [{:knowledge-point/id #uuid "3fea43b6-fd7b-5edc-b6b7-7f8b2cbab502" :knowledge-point/title "Identifying the Type of Image Formed by a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b673724a-4915-517c-b9a0-fe79b8e7faa8" :answer/type {:db/ident :answer.type/text} :answer/value "The origin $O$ of the coordinate system" :db/id #edb/ref 17592186289305} {:answer/id #uuid "aec1f854-7d74-50f2-a59b-e2ff15f06aa4" :answer/type {:db/ident :answer.type/text} :answer/value "A rectangle" :db/id #edb/ref 17592186289306} {:answer/id #uuid "7b50d5f9-72ad-547c-a124-76efa4e14d33" :answer/type {:db/ident :answer.type/text} :answer/value "A triangle" :db/id #edb/ref 17592186289307} {:answer/id #uuid "c1bf9be5-b982-5166-9542-007bcdd73298" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186289308} {:answer/id #uuid "24847843-649b-595c-82b8-e8e87f70614a" :answer/type {:db/ident :answer.type/text} :answer/value "A point, different from the origin" :db/id #edb/ref 17592186289309}] :answer-field/correct {:answer/id #uuid "c1bf9be5-b982-5166-9542-007bcdd73298" :answer/type {:db/ident :answer.type/text} :answer/value "A line segment" :db/id #edb/ref 17592186289308} :answer-field/id #uuid "e42fdd2c-3928-5581-8f96-17bc27665aed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289304}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5cfe0cab-3f64-5782-9a2c-dd556be2b484" :question/math-academy-id "q-162202" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/8978d3bb02b4032b6e3a8b4a85878db647eb8323ac5b0423b5a9a6fab121c7e7.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & 4 \\\\ -2 & -8\\end{aligned}].\n$$\n\nWhat would be the image of the triangle shown above under the action of $T?$" :question/worked-solution "Recall that for any linear transformation $T$ with associated $2\\times 2$ matrix $T,$ we have one of the following three possibilities:\n\n- If $T$ is non-singular, i.e., $det(T)\\ne 0,$ then the image of a two-dimensional object is a two-dimensional object. In particular, the image of a polygon with $n$ vertices is a polygon with $n$ vertices.\n\n- If $T$ is singular, i.e., $det(T)=0,$ we have two additional subcases:\n\n- If $T$ has at least one nonzero entry, then the image of a two-dimensional object is a one-dimensional line segment.\n\n- If $T$ is the zero matrix, then the image of a two-dimensional object is the point $(0,0),$ the origin of the coordinate system.\n\nWith that in mind, let's examine our transformation.\n\nComputing the determinant of $T,$ we obtain\n\n$$\n\\begin{aligned}det(T) & =|\\begin{aligned}1 & 4 \\\\ -2 & -8\\end{aligned}| \\\\  & =1\\cdot (-8)-4\\cdot (-2) \\\\  & =0.\\end{aligned}\n$$\n\nSo, we have a singular nonzero matrix. Therefore, the image of the triangle under the action of $T$ is a line segment."}] [{:db/id #edb/ref 17592186106081 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8667b4d3-e8da-5b51-86c7-f5069af1dd99" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-21061-a-3.png" :db/id #edb/ref 17592186102724} {:answer/id #uuid "96de2d77-24db-56d3-87b9-8efb5afe88c1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-21061-a-1.png" :db/id #edb/ref 17592186102725} {:answer/id #uuid "e6db357f-700a-5a75-a186-2aa1fa365131" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-21061-a-5.png" :db/id #edb/ref 17592186102726} {:answer/id #uuid "1f067af3-e8d4-5366-829b-67c6e031edf2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-21061-a-2.png" :db/id #edb/ref 17592186102727} {:answer/id #uuid "69645bba-ebbe-5cdf-afe7-c90944267b52" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-21061-a-4.png" :db/id #edb/ref 17592186102728}] :answer-field/correct {:answer/id #uuid "96de2d77-24db-56d3-87b9-8efb5afe88c1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/1351/Source/Images/q-21061-a-1.png" :db/id #edb/ref 17592186102725} :answer-field/id #uuid "2b453d2c-355f-59f3-be5b-1ca89843e93f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186102723}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "87f1b1b7-4122-5900-82fa-45ed68940b46" :question/math-academy-id "q-21061" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/5c0196b13b3f20ba05313a9604e73b13251937b525a12fd5b9997e99f4ae21a0.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}].\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}1 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}0 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 1 & -1 \\\\ 1 & -1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-1,1)$, $(1,-1),$ $(-1,1).$ Notice that all three points lie on the same line.\n\nSo, the image of our triangle under the action of $T$ is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/2f8d6ec6c9a71e61180ad04c25d623c40dadfdd623e1e2eaa8458915bcaca2f8.png)"}] [{:db/id #edb/ref 17592186284152 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf7717b0-e75c-518c-8cd3-150b96c8cabc" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/dc5ad781e838e597706600633701871006cd59fd3db60344cf34aaddb4200da8.png" :db/id #edb/ref 17592186284154} {:answer/id #uuid "9db75bfc-fe19-51e4-ab27-cf8792f76f05" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/40f352980b38be63b071b160953eff23a98996dce58c5f616e10958a8a70182e.png" :db/id #edb/ref 17592186284155} {:answer/id #uuid "ec7cdc35-c43f-5b8a-adf1-45e56f6e2a2e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/92beb71e7d09cba01f2eeb82a60ca3b0b3929064e4f16da3af104db8c5eaa8df.png" :db/id #edb/ref 17592186284156} {:answer/id #uuid "34880a8f-4354-522a-8d0d-3ed1d347e87c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/ee4a96b2b1106fbd1a5ec222c3f7f2a5e5a9e84c9bfe539aeb29a1918943aef9.png" :db/id #edb/ref 17592186284157} {:answer/id #uuid "0f4b8ff3-6f9e-5e75-9a7e-86d7a7b55fde" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/b4d2150d92ff14a654fb7079a17d7bd75abe721c0d37d4075d5a92635bafc170.png" :db/id #edb/ref 17592186284158}] :answer-field/correct {:answer/id #uuid "34880a8f-4354-522a-8d0d-3ed1d347e87c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/ee4a96b2b1106fbd1a5ec222c3f7f2a5e5a9e84c9bfe539aeb29a1918943aef9.png" :db/id #edb/ref 17592186284157} :answer-field/id #uuid "3aeb8c20-4274-5475-9a2f-7e464fc745e4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186284153}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "aa19c1ea-c0d3-5f29-b074-4ccd448a8f88" :question/math-academy-id "q-21063" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/6501b1a7e9429c786905c11835410111c32ac0337f1ba63bff130d327350316c.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}]\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 4 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 1 \\\\ 1 & 1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}6 & 8 & 10 \\\\ 3 & 4 & 5\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(6,3)$, $(8,4)$ and $(10,5).$ Notice that all three points lie on the same line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13993138/assets/a91af151d3dc0e48aef0eef58012f6c9f72aaff02aafae2d55fe0714c29c96e3.png)"}] [{:db/id #edb/ref 17592186289317 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d1252e9-f2ac-5adf-9cf5-ef48e35fb747" :knowledge-point/title "Determining the Image of an Object Formed by a Singular Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "577bd934-421d-54ec-b0b2-d003700ec403" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/461ff9fb5ef66239eb81314f761fac9ceb32b3bc88df6940b61445c752fe3d0c.png" :db/id #edb/ref 17592186289319} {:answer/id #uuid "700107e3-638e-5589-9221-901c6ac2b7d9" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/bf7cc4e728cd1ade741c55b2fbb54720220e0e09a8521a150300532b4e3ee9ed.png" :db/id #edb/ref 17592186289320} {:answer/id #uuid "1eb774ed-95c1-54d0-a9ab-0cbb1b865b7a" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/ed8a2354f8cc04f998875f599a52b50e6c64cafe8976f1bea176772543e295ac.png" :db/id #edb/ref 17592186289321} {:answer/id #uuid "bf9411e7-77cf-54e3-a181-f1015dfa57ba" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/0af059340bdef0548876baad9bcdf990f6bc92330617dde33c18c00578aecad1.png" :db/id #edb/ref 17592186289322} {:answer/id #uuid "eb1006cf-3407-53b0-b4de-08d098a9bd1c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/da61a7fd99ce683be4e66d3708ddf15c969b038f0250dc4c024ace870c3f7544.png" :db/id #edb/ref 17592186289323}] :answer-field/correct {:answer/id #uuid "bf9411e7-77cf-54e3-a181-f1015dfa57ba" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/0af059340bdef0548876baad9bcdf990f6bc92330617dde33c18c00578aecad1.png" :db/id #edb/ref 17592186289322} :answer-field/id #uuid "3c0ee37d-c540-532c-b043-87ace79e55ef" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186289318}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f28ce8d4-0044-5e40-a90c-5299f41f2c22" :question/math-academy-id "q-21065" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/db7d2b33f2badad28b754d4482047a33bb37469ed8b7b17859b10552840e2f51.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by \n\n$$\nT=[\\begin{aligned}-2 & -1 \\\\ 4 & 2\\end{aligned}]\n$$\n\nWhich of the following is the image of the triangle shown above under the action of $T?$" :question/worked-solution "To find the image of the triangle under the action of $T$, we first create a matrix $X$ containing all of the vertices of the triangle:\n\n$$\nX=[\\begin{aligned}1 & 2 & 0 \\\\ 0 & 2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-2 & -1 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 0 \\\\ 0 & 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & -6 & -1 \\\\ 4 & 12 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the image's vertices are $(-2,4)$, \n$(-6,12)$ and $(-1,2).$ Notice that all three points lie on the same line.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14009909/assets/2e1dde461c6244a59672fc28c842b70a30297ac7a8c7e7cf2095a973cd1860cd.png)"}]}
