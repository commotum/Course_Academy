#{[{:db/id #edb/ref 17592186261464 :knowledge-point/_questions [{:knowledge-point/id #uuid "62c34646-f7cf-5ffd-b957-4151bdbb5e44" :knowledge-point/title "Expressing a Left Riemann Sum in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "10e082af-282d-5d9a-af59-46dab88425a8" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left({\\sum }_{k=0}^{2}\\frac{2+k}{1+k}\\right)" :db/id #edb/ref 17592186273367} {:answer/id #uuid "01eb0629-683a-56cc-a169-560d87312206" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12\\left({\\sum }_{k=0}^{2}\\frac{2+k}{1+k}\\right)" :db/id #edb/ref 17592186273368} {:answer/id #uuid "e232a45e-d51c-5152-9895-f677364418b1" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left({\\sum }_{k=0}^{2}\\frac{2+k}{1+k}\\right)" :db/id #edb/ref 17592186273369} {:answer/id #uuid "5a52d2d2-921f-5357-aebf-b290d78f912a" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\left({\\sum }_{k=0}^{2}\\frac{2+k}{1+k}\\right)" :db/id #edb/ref 17592186273370} {:answer/id #uuid "24938e97-2444-5d9c-a088-9be8f9bc3136" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{k=0}^{2}\\frac{2+k}{1+k}" :db/id #edb/ref 17592186273371}] :answer-field/correct {:answer/id #uuid "24938e97-2444-5d9c-a088-9be8f9bc3136" :answer/type {:db/ident :answer.type/math} :answer/value "{\\sum }_{k=0}^{2}\\frac{2+k}{1+k}" :db/id #edb/ref 17592186273371} :answer-field/id #uuid "489c3ad9-c1a9-5e8c-b206-c9a2d9f08896" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274957}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "adfb3a62-f833-537d-b80b-a21b074c623e" :question/math-academy-id "q-73137" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/99f224712b0a067d76bc02c1f33938446ad84883a439ba53cb6569197e2cf9fd.png)\n\nThe area under the curve $y=\\frac{x+1}{x}$ between $x=1$, $x=4$ and the $x$-axis is approximated using a left Riemann sum, as shown above. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The left Riemann sum for $y=f(x)$ with a regular step size in sigma notation is\n\n$$\n{\\sum }_{k=0}^{n-1}f({x}_{k})Δx,\n$$\n\nwhere ${x}_{k}=a+kΔx$ with $Δx=\\frac{b-a}{n}.$ \n\nFrom the diagram, we see that there are $n=3$ rectangles. The endpoints indicate that $a=1$ and $b=4,$ so the step size is\n\n$$\nΔx=\\frac{4-1}{3}=\\frac{3}{3}=1.\n$$\n\nTherefore, using sigma notation, the left Riemann sum can be expressed as\n\n$$\n\\begin{aligned}{\\sum }_{k=0}^{n-1}f({x}_{k})Δx & ={\\sum }_{k=0}^{n-1}f(a+kΔx)Δx \\\\  & ={\\sum }_{k=0}^{3-1}f(1+k\\cdot 1)\\cdot 1 \\\\  & ={\\sum }_{k=0}^{2}f(1+k) \\\\  & ={\\sum }_{k=0}^{2}\\frac{1+k+1}{1+k} \\\\  & ={\\sum }_{k=0}^{2}\\frac{2+k}{1+k}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186261487 :knowledge-point/_questions [{:knowledge-point/id #uuid "8d01d6ed-1c25-5170-a1ad-7a4fa0103db7" :knowledge-point/title "Expressing a Right Riemann Sum in Sigma Notation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bbabbb86-af0f-58b5-965f-950bc931a818" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4e}{n}{\\sum }_{j=1}^{n}\\sqrt[n]{{e}^{4j}}" :db/id #edb/ref 17592186273402} {:answer/id #uuid "c2402cbb-c3ec-5109-be6c-ae0acf67076f" :answer/type {:db/ident :answer.type/math} :answer/value "2\\left(\\frac{4e}{n}{\\sum }_{j=1}^{n}\\sqrt[n]{{e}^{4j}}\\right)" :db/id #edb/ref 17592186273403} {:answer/id #uuid "c13c1a04-c02b-535f-bcb5-222237b618fc" :answer/type {:db/ident :answer.type/math} :answer/value "-1\\left(\\frac{4e}{n}{\\sum }_{j=1}^{n}\\sqrt[n]{{e}^{4j}}\\right)" :db/id #edb/ref 17592186273404} {:answer/id #uuid "f7721525-1b0a-57ef-97a2-8d7a8739b5fe" :answer/type {:db/ident :answer.type/math} :answer/value "3\\left(\\frac{4e}{n}{\\sum }_{j=1}^{n}\\sqrt[n]{{e}^{4j}}\\right)" :db/id #edb/ref 17592186273405} {:answer/id #uuid "03cfe69a-c2ae-598f-934c-b6eb459668b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac12\\left(\\frac{4e}{n}{\\sum }_{j=1}^{n}\\sqrt[n]{{e}^{4j}}\\right)" :db/id #edb/ref 17592186273406}] :answer-field/correct {:answer/id #uuid "bbabbb86-af0f-58b5-965f-950bc931a818" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4e}{n}{\\sum }_{j=1}^{n}\\sqrt[n]{{e}^{4j}}" :db/id #edb/ref 17592186273402} :answer-field/id #uuid "275316e4-6f9c-58dd-9d8d-c2621912be8b" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274964}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "fd926104-dccb-5ceb-b205-b99c25d134c7" :question/math-academy-id "q-73208" :question/problem "The area under the curve $y={e}^{x}$ between $x=1$ and $x=5$ and the $x$-axis is approximated by a right Riemann sum using $n$ subintervals of equal length. What is the expression for the Riemann sum in sigma notation?" :question/worked-solution "The right Riemann sum for $y=f(x)$ with a regular step size in sigma notation is  \n\n$$\n{\\sum }_{j=1}^{n}f({x}_{j})Δx,\n$$\n\nwhere ${x}_{j}=a+jΔx$  with $Δx=\\frac{b-a}{n}.$ \n\nWe're told that there are $n$ subintervals. The endpoints indicate that $a=1$ and $b=5.$ So, we have\n\n$$\nΔx=\\frac{5-1}{n}=\\frac{4}{n}.\n$$\n\nTherefore, using sigma notation, the right Riemann sum can be expressed as \n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}f({x}_{j})Δx & ={\\sum }_{j=1}^{n}f(a+jΔx)Δx \\\\  & ={\\sum }_{j=1}^{n}f(1+j\\cdot \\frac{4}{n})\\cdot \\frac{4}{n} \\\\  & =\\frac{4}{n}{\\sum }_{j=1}^{n}f(1+\\frac{4j}{n}) \\\\  & =\\frac{4}{n}{\\sum }_{j=1}^{n}{e}^{(1+\\frac{4j}{n})} \\\\  & =\\frac{4}{n}{\\sum }_{j=1}^{n}{e}^{1}\\cdot {e}^{4j/n} \\\\  & =\\frac{4e}{n}{\\sum }_{j=1}^{n}\\sqrt[n]{{e}^{4j}}.\\end{aligned}\n$$"}]}
