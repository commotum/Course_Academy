#{[{:db/id #edb/ref 17592186129688 :knowledge-point/_questions [{:knowledge-point/id #uuid "e290e8b2-7766-55ff-95da-99a3430b18e3" :knowledge-point/title "Finding the Jacobian of an Inverse Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8b3135b2-efe6-553c-80b1-933736a0e6ef" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186127923} {:answer/id #uuid "a095503c-4b7a-5e94-a211-d1b3325895fe" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186127924} {:answer/id #uuid "1d68629c-6eeb-5cea-a136-da06c6a6bc03" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186127925} {:answer/id #uuid "3b9df6a6-c528-5fc3-8796-e581fc586f70" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186127926} {:answer/id #uuid "5a71e826-9279-571d-a0a8-bf7f580a8294" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{40}" :db/id #edb/ref 17592186127927}] :answer-field/correct {:answer/id #uuid "5a71e826-9279-571d-a0a8-bf7f580a8294" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{40}" :db/id #edb/ref 17592186127927} :answer-field/id #uuid "2410315c-b430-54de-94c7-8ff1989bd57c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127922}] :question/id #uuid "9ad6bc33-7c9a-5d03-8204-18b81f486eea" :question/math-academy-id "q-39669" :question/problem "Find the Jacobian determinant of the transformation $T: (u, v, w) → (x(u, v, w), y(u, v, w), z(u, v, w))$, given that\n\n$u = 2x + y, v =-x + 3y - 2z, w = 3y + 4z$."}] [{:db/id #edb/ref 17592186129691 :knowledge-point/_questions [{:knowledge-point/id #uuid "4b4a31c6-01be-5b15-88f5-9150f350e944" :knowledge-point/title "Determining the Critical Points of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9865ec07-4ed8-5e1e-a395-9077aca11780" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the sphere $u^{2} + v^{2} + w^{2} = 1$." :db/id #edb/ref 17592186127941} {:answer/id #uuid "c69a6d94-c00a-5d87-a560-a5f2f09e4ab6" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the $vw -$plane." :db/id #edb/ref 17592186127942} {:answer/id #uuid "2cfd4913-4ab5-5532-846b-462d3a33aa3a" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the $uv -$plane." :db/id #edb/ref 17592186127943} {:answer/id #uuid "3e0934b8-9acf-5844-8c0e-424cfdf4b1d5" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the parabolic cylinder $w^{2} = 2u$." :db/id #edb/ref 17592186127944} {:answer/id #uuid "73756ee3-5c09-5f7b-b85b-8b7272cf91bb" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the plane $w = u$." :db/id #edb/ref 17592186127945}] :answer-field/correct {:answer/id #uuid "c69a6d94-c00a-5d87-a560-a5f2f09e4ab6" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the $vw -$plane." :db/id #edb/ref 17592186127942} :answer-field/id #uuid "09a65432-6b6f-5c96-8820-a3d6b7b8d177" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186127940}] :question/id #uuid "ab44c8de-700d-51cc-ab4a-3755f7926aef" :question/math-academy-id "q-39709" :question/problem "Find the locations of all of the critical points of the transformation $T$, where $T$ is defined as\n\n$T: \\begin{bmatrix}u \\\\ v \\\\ w\\end{bmatrix}⟶\\begin{bmatrix}u^{2} - v \\\\ u^{2} + v \\\\ e^{w}\\end{bmatrix}$."}]}
