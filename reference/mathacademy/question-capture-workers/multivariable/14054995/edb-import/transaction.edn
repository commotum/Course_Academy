 ["q-83499"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161038/selection/6bb04d4149887d55a9297d943bdc2cb25e355238279a7ee6026b54ef45533e49" :answer/id #uuid "c53fcf48-2fc5-5cee-8a93-694b035005aa" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{4}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161038/selection/94bd6ccca279616a478e5b585462cc57a291cc96d89c3db701bd1088966b89b5" :answer/id #uuid "2637541b-aea9-5097-ba6a-028850d2674f" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{2}{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161038/selection/49e7d773e1b4a576e69a771e136dfee301363c5ae241075e466d1a3bc9796c76" :answer/id #uuid "316791af-cd40-540b-9e7f-3a17e2b25356" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{4}r{e}^{r}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161038/selection/0d9d58106263c1cf9eed05cb485938ffb5c856a1d9530f1e54b1408761deeb79" :answer/id #uuid "811d5009-2d2f-55b8-9a50-5ce9b8aa13ca" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}{\\int }_{0}^{2}{r}^{2}{e}^{r}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161038/selection/0a6f342ff64b90fd143b950f71951bcae1abff7972885fb262b38f050601e523" :answer/id #uuid "9f3955b2-625b-57f0-b20c-bc953c43a2f2" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi }^{3\\pi /2}{\\int }_{0}^{4}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161038/selection" :answer-field/id #uuid "c68cda96-6317-5f81-a372-f2ee047eeb93" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161038/selection/0a6f342ff64b90fd143b950f71951bcae1abff7972885fb262b38f050601e523" :answer-field/choices ["q-161038/selection/6bb04d4149887d55a9297d943bdc2cb25e35523