ta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta  & =\\frac{1}{3}{[{sin}^{3}⁡\\theta ]}_{0}^{\\pi /2} \\\\  & =\\frac{1}{3}[{1}^{3}-{0}^{3}] \\\\  & =\\frac{1}{3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38031" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/activity-metadata.json" "file_sha256" "1b0fe1d05b8a1b866fccb43de48356bf12d23644b5e5a59904dc0eac6c4644d5"} {"question" "q-38031" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38031" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "2\\pi "] ["math" "\\frac{1}{3}"] ["math" "\\frac{2}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38031" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-83957" "field" nil "attribute" "question/problem" "value" "${\\int }_{\\pi /6}^{3\\pi /4}{\\int }_{2}^{4}r\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta =$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-83957" "field" nil "attribute" "question/worked-solution" "value" "First, we integrate with respect to $r,$ treating $\\theta $ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{3\\pi /4}{\\int }_{2}^{4}r\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  & ={\\int }_{\\pi /6}^{3\\pi /4}\\operatorname{cos}⁡\\theta {\\int }_{2}^{4}r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /6}^{3\\pi /4}\\operatorname{cos}⁡\\theta {[\\frac{{r}^{2}}{2}]}_{2}^{4}\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{\\pi /6}^{3\\pi /4}\\operatorname{cos}⁡\\theta ({4}^{2}-{2}^{2})\\,\\text{d}\\theta  \\\\  & =6{\\int }_{\\pi /6}^{3\\pi /4}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we integrate with respect to $\\theta :$ \n\n$$\n\\begin{aligned}6{\\int }_{\\pi /6}^{3\\pi /4}\\operatorname{cos}⁡\\theta \\,\\text{d}\\theta  & =6[\\operatorname{sin}⁡\\theta ]_{\\pi /6}^{3\\pi /4} \\\\  & =6(\\operatorname{sin}⁡(\\frac{3\\pi }{4})-\\operatorname{sin}⁡(\\frac{\\pi }{6})) \\\\  & =6(\\frac{\\sqrt{2}}{2}-\\frac{1}{2}) \\\\  & =3(\\sqrt{2}-1)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-83957" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/activity-metadata.json" "file_sha256" "1b0fe1d05b8a1b866fccb43de48356bf12d23644b5e5a59904dc0eac6c4644d5"} {"question" "q-83957" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-83957" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "3(\\sqrt{2}-1)"] ["math" "3\\sqrt{2}"] ["math" "6(\\sqrt{2}-1)"] ["math" "\\frac{3}{2}(\\sqrt{2}-1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-83957" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3(\\sqrt{2}-1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38140" "field" nil "attribute" "question/problem" "value" "Integrate the function $f(x,y)=2x+y$ over the portion of the disk of radius $2$ centered at the origin, where $y\\ge 0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38140" "field" nil "attribute" "question/worked-solution" "value" "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/b5ba69ab02aa13e201b7b9113f6a36e705ad19e6412499504afc4f239459a8f3.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le \\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}(2x+y)\\,\\text{d}A & ={∬}_{Δ}(2r\\operatorname{cos}⁡\\theta +r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{0}^{2}{r}^{2}(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta ){\\int }_{0}^{2}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,{[\\frac{{r}^{3}}{3}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )(\\frac{{2}^{3}}{3}-0)\\text{d}\\theta  \\\\  & =\\frac{8}{3}{\\int }_{0}^{\\pi }(2\\operatorname{cos}⁡\\theta +\\operatorname{sin}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{8}{3}[2\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ]_{0}^{\\pi } \\\\  & =\\frac{8}{3}((2\\operatorname{sin}⁡(\\pi )-\\operatorname{cos}⁡(\\pi ))-(2\\operatorname{sin}⁡(0)-\\operatorname{cos}⁡(0))) \\\\  & =\\frac{8}{3}(1+1) \\\\  & =\\frac{16}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38140" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/activity-metadata.json" "file_sha256" "1b0fe1d05b8a1b866fccb43de48356bf12d23644b5e5a59904dc0eac6c4644d5"} {"question" "q-38140" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38140" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "8"] ["math" "\\frac{16}{3}"] ["math" "\\frac{3}{4}"] ["math" "\\frac{8}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-38140" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{16}{3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161055" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/719f86db69489f62bcbe2753e88cdc6713f04dc6f53415cc2484e2eaab8ffac3.png)\n\nEvaluate the double integral ${∬}_{D}\\frac{x}{y}\\,\\text{d}A,$ where the region $D$ is the semicircle shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161055" "field" nil "attribute" "question/worked-solution" "value" "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $1$ centered at \n$(0,1).$\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write the $x=\\sqrt{2y-{y}^{2}}$ in polar coordinates:\n\n$$\n\\begin{aligned}x & =\\sqrt{2y-{y}^{2}} \\\\ {x}^{2} & =2y-{y}^{2} \\\\ {x}^{2}+{y}^{2} & =2y \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =2r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta ) & =2r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2} & =2r\\operatorname{sin}⁡\\theta  \\\\ {r}^{2}-2r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{sin}⁡\\theta ) & =0\\end{aligned}\n$$\n\n \n\nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{sin}⁡\\theta .$\n\nTherefore, in polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2\\operatorname{sin}⁡\\theta ,\\,0\\le \\theta \\le \\frac{\\pi }{2}}.\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{x}{y}\\,\\text{d}A & ={∬}_{Δ}\\frac{r\\operatorname{cos}⁡\\theta }{r\\operatorname{sin}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }{\\int }_{0}^{2\\operatorname{sin}⁡\\theta }r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }{[\\frac{{r}^{2}}{2}]}_{0}^{2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\frac{\\operatorname{cos}⁡\\theta }{\\operatorname{sin}⁡\\theta }(2{sin}^{2}⁡\\theta -0)\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2\\theta \\,\\text{d}\\theta  \\\\  & ={[-\\frac{1}{2}\\operatorname{cos}⁡2\\theta ]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{1}{2}(-1-1) \\\\  & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161055" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/activity-metadata.json" "file_sha256" "1b0fe1d05b8a1b866fccb43de48356bf12d23644b5e5a59904dc0eac6c4644d5"} {"question" "q-161055" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161055" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "1"] ["math" "2"] ["math" "2\\pi "] ["math" "\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161055" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161050" "field" nil "attribute" "question/problem" "value" "Integrate the function $f(x,y)=15{x}^{2}y$ over the disk of radius $1$ centered at the origin." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161050" "field" nil "attribute" "question/worked-solution" "value" "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/9b54b7a488a1983ba1816fdf5c55e039951eb417102c61963977b2f48b9c8d9e.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 1,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}12{x}^{2}y\\,\\text{d}A & ={∬}_{Δ}15({r}^{2}{cos}^{2}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{1}15{r}^{4}({cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta ){\\int }_{0}^{1}5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )\\,{[{r}^{5}]}_{0}^{1}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta )(1-0)\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }3{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =[-{cos}^{3}⁡\\theta ]_{0}^{2\\pi } \\\\  & =-({cos}^{3}⁡(2\\pi )-{cos}^{3}⁡(0)) \\\\  & =-(1-1) \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161050" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/activity-metadata.json" "file_sha256" "1b0fe1d05b8a1b866fccb43de48356bf12d23644b5e5a59904dc0eac6c4644d5"} {"question" "q-161050" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161050" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "1"] ["math" "3"] ["math" "5"] ["math" "\\frac{1}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161050" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161053" "field" nil "attribute" "question/problem" "value" "Integrate the function $f(x,y)={e}^{{x}^{2}+{y}^{2}}$ over the disk of radius $2$ centered at the origin." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161053" "field" nil "attribute" "question/worked-solution" "value" "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/811cfa127ad232e8d5a990998604718a57344d1bd7f43173dc0987631c13db33.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}{e}^{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}{e}^{(r{cos}^{2}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{e}^{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{e}^{{r}^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{0}^{2}r{e}^{{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\,{[\\frac{1}{2}{e}^{{r}^{2}}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }\\frac{1}{2}({e}^{4}-1)\\text{d}\\theta  \\\\  & =\\frac{1}{2}({e}^{4}-1)[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{1}{2}({e}^{4}-1)(2\\pi -0) \\\\  & =\\pi ({e}^{4}-1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161053" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/activity-metadata.json" "file_sha256" "1b0fe1d05b8a1b866fccb43de48356bf12d23644b5e5a59904dc0eac6c4644d5"} {"question" "q-161053" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161053" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2\\pi ({e}^{2}-1)"] ["math" "2\\pi {e}^{4}"] ["math" "\\pi ({e}^{4}-1)"] ["math" "{\\pi }^{2}"] ["math" "{e}^{2}(2\\pi -1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161053" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\pi ({e}^{4}-1)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161054" "field" nil "attribute" "question/problem" "value" "Integrate the function $f(x,y)=2({x}^{2}+{y}^{2})$ over the disk of radius $3$ centered at the origin" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161054" "field" nil "attribute" "question/worked-solution" "value" "We will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nFirst, let's sketch our region $D:$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/0a1de805051eff4ea82b4eefb7bb113c724b3d4e7304704831b6294ee4e4d674.png)\n\nIn polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,0\\le r\\le 3,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}2({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}2({(r\\operatorname{cos}⁡\\theta )}^{2}+{(r\\operatorname{sin}⁡\\theta )}^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}2{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & =2{∬}_{Δ}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }{\\int }_{0}^{3}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }\\,{[\\frac{{r}^{4}}{4}]}_{0}^{3}\\,\\text{d}\\theta  \\\\  & =2{\\int }_{0}^{2\\pi }(\\frac{81}{4}-0)\\text{d}\\theta  \\\\  & =\\frac{81}{2}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{81}{2}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{81}{2}(2\\pi -0) \\\\  & =81\\pi .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161054" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/activity-metadata.json" "file_sha256" "1b0fe1d05b8a1b866fccb43de48356bf12d23644b5e5a59904dc0eac6c4644d5"} {"question" "q-161054" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161054" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "18\\pi +2"] ["math" "27\\pi "] ["math" "81\\pi "] ["math" "9\\pi "] ["math" "9\\pi -3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "q-161054" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "81\\pi "] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/state.json" "file_sha256" "2b56d8794211aefc41204a7195d42e43699689d92d0a585cd18cb56c0102f7aa"} {"question" "e-7347" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/1782385c55493892be0308ede1e4fbe5308ea9440e21b70cc2da7d7f01fb8dcd.png)\n\nThe region $D$ is the quarter-circle shown above. What is $\\displaystyle \\iint\\limits_D y \\sqrt{x^2+y^2} \\: \\textrm{d}A$\nexpressed in polar coordinates?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-7347.json" "file_sha256" "bd836c20cbd3c544562253c1e5bb8cb27ff7aa76a8ac6332705e14e476b513db"} {"question" "e-7347" "field" nil "attribute" "question/worked-solution" "value" "We will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nFirst, notice that the region $D$ represents a portion of the disk of radius $1$ centered at the origin. In polar coordinates $(r, \\theta),$ the region can be expressed as \n\n$$\n\\Delta = \\Big\\{ (r,\\theta) \\: : \\: 0 \\leq r \\leq 1, \\: 0 \\leq \\theta \\leq \\dfrac{\\pi}{2} \\Big\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}y\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{sin}⁡\\theta )\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{r}^{2}\\operatorname{sin}⁡\\theta \\sqrt{{r}^{2}({cos}^{2}⁡\\theta {sin}^{2}⁡\\theta )}\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{r}^{3}\\operatorname{sin}⁡\\theta \\sqrt{{cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta }\\,\\text{d}r\\text{d}\\theta  \\\\  & ={∬}_{Δ}{r}^{3}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{1}{r}^{3}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-7347.json" "file_sha256" "bd836c20cbd3c544562253c1e5bb8cb27ff7aa76a8ac6332705e14e476b513db"} {"question" "e-12376" "field" nil "attribute" "question/problem" "value" "Given that ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/f3007b053a76b455c6c5b7ea617039780e6ee7b856ac2c54ae124dad334aef7f.png) express the following integral in polar coordinates:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/5c67d939121c919b3d51b562efbc774a6f2a702d2a8e9cadee508446f9bd35d0.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-12376.json" "file_sha256" "6c65dc930cca71dbfd2f940a0f5eb244a94e0d7861e68a7178b8859777b2e718"} {"question" "e-12376" "field" nil "attribute" "question/worked-solution" "value" "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/7f645c475debdf46d06a9ecbebb3f019a7a92ea0c6129e06b8b5f326e005f9f6.png)\n\nFirst, let's sketch our region ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/c592260e19248a715187208d54cafc6f4ceac8f34c843f1b366134bc37fb5430.png)\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/e447e688e0f3e2c0411129e8d1baf4a900008173443f5392d98af52a27eb285b.png)\n\nNotice that the region ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/33d4430552670d83a2c303e8ab286d3391f5611450f4e4f0b6ad6ccb58049b0e.png) represents the disk of radius ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/f7b723906930985b61bc58989f341d6b2e1e1f70ff34946ce5f5f373e2b0f95a.png) centered at ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/484ceb02ac6fd60fc3d18cfff327672d25f5b88cb1b1825b8c1e069f153b9545.png) \n\nCartesian and polar coordinates are connected by the following equations:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/00dbdb2d8638277969db40d2ca7c43266b4f275fbeadee86f6ef37954661433b.png)\n\nWith that in mind, let's now write the ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/b78de9de64536b59ded324af0c67d84d3d64802a8a8d1af3894abfc686e2ae53.png) in polar coordinates:\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/185d596ce2824cf09bf7e5e7fd4cc432b75dfbe442c2e653564d93f347acf7ee.png) \n\nSince ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/427fd471dcf18cc90c67eb53f8f20e484fa707110281ad49811bc6a4f2ed5968.png) cannot be identical to zero on the entire circle, we must have ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/f560ba12327ee0ad0c69dbd656ab82ac974acf442e8a1642dcf597f340d7f6db.png)\n\nNow, let's determine the limits for ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/427fd471dcf18cc90c67eb53f8f20e484fa707110281ad49811bc6a4f2ed5968.png) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/4302d6f15afc8636ab514cdce845f4bbe0171d743153ee6bdfbbe2b323bf4ac4.png) First of all, ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/15012c54ccf6548b6c3e2201e44d9ccfd33d7d41c627a0ce22c56f4c6d41d16c.png) can vary from ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/4efe6d0d575bd5dd59ca5e6e05092a1d2030164be2ce65efd468d385e931fddb.png) (at the origin) to ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/cecc5f8feb56bb745748bbc79f2bfdc884364e7b9dce2c027c8c251366bb6f32.png) (at the boundary of the region): \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/f5ff820a0def58e4a2e6b15b5b77368151a71a72a083ef92fd95c20dacf711d3.png)\n\nSecondly, ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/e10bbbc0bc5b9cc38adb59e4daa0cd709a3d7165da31914f73e17bf28cc01902.png) can vary between ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/a55c0db211022b11f154d509c19b94022e218e9bf3120144dc2464bf5ca5c29c.png) (the negative ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/245bebfeb6cb95babe872c0185e33d598fb9dd08c8950252c07cdb5f5c8f87d4.png)-axis) and ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/bc5b0c56a73784c1d673cae720a8d7796922204eb07796b954ff10b197fea2c1.png) (the positive ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/245bebfeb6cb95babe872c0185e33d598fb9dd08c8950252c07cdb5f5c8f87d4.png)-axis):\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/c1e5fea69b62b94b565607da8d372160cc51dc127973f2afa4dda8cfc01116ea.png)\n\nSo, in polar coordinates ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/7eff2673c3d979c233082bd82d26977e80eec3963f1ff142a4f3a7c63ef89790.png) the region can be expressed as \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/e20685d2d0ab9822cb380f6e5ddf2cf41a24bcc1d5c28b903b77b1c660e347cd.png)\n\nTherefore, using the change of variables formula, we obtain \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/92792892be94c40c231d24839bf521ea22dce3d4fd809cfc46b7d4312ebd5d4d.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-12376.json" "file_sha256" "6c65dc930cca71dbfd2f940a0f5eb244a94e0d7861e68a7178b8859777b2e718"} {"question" "e-7346" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\int_{0}^{\\pi/8} \\int_0^{\\sin2\\theta} r \\, \\textrm d r\\,\\textrm d \\theta.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-7346.json" "file_sha256" "c8ba0889bc5a3b6ef20b1d9999a741f8dadea4d9fb06be865c190ddbaacc580a"} {"question" "e-7346" "field" nil "attribute" "question/worked-solution" "value" "First, we integrate with respect to $r,$ treating $\\theta$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /8}{\\int }_{0}^{\\operatorname{sin}⁡2\\theta }r\\,\\text{d}r\\,\\text{d}\\theta  & =\\frac{1}{2}{\\int }_{0}^{\\pi /8}{[{r}^{2}]}_{0}^{\\operatorname{sin}⁡2\\theta }\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /8}{sin}^{2}⁡2\\theta \\,\\text{d}\\theta \\end{aligned}\n$$\n\nNext, we recall the double-angle formula\n\n$$\n\\cos{2x} = 1-2\\sin^2 x.\n$$\n\nSubstituting $x=2\\theta$ and rearranging, we get\n\n$$\n\\sin^22\\theta = \\dfrac12\\left(1-\\cos4\\theta\\right).\n$$\n\n \n\nFinally, we can finish our integral by integrating with respect to $\\theta,$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{\\pi /8}{sin}^{2}⁡2\\theta \\,\\text{d}\\theta  & =\\frac{1}{2}{\\int }_{0}^{\\pi /8}\\frac{1}{2}(1-\\operatorname{cos}⁡4\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{\\int }_{0}^{\\pi /8}1-\\operatorname{cos}⁡4\\theta \\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{[\\theta -\\frac{1}{4}\\operatorname{sin}⁡4\\theta ]}_{0}^{\\pi /8} \\\\  & =\\frac{1}{4}[(\\frac{\\pi }{8}-\\frac{1}{4}\\operatorname{sin}⁡(\\frac{\\pi }{2}))-(0-\\frac{1}{4}\\operatorname{sin}⁡(0))] \\\\  & =\\frac{1}{4}(\\frac{\\pi }{8}-\\frac{1}{4}) \\\\  & =\\frac{1}{4}(\\frac{\\pi }{8}-\\frac{2}{8}) \\\\  & =\\frac{1}{32}(\\pi -2)\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-7346.json" "file_sha256" "c8ba0889bc5a3b6ef20b1d9999a741f8dadea4d9fb06be865c190ddbaacc580a"} {"question" "e-7348" "field" nil "attribute" "question/problem" "value" "Integrate the function $f(x, y) = 15xy^2$ over the portion of the disk of radius $2$ centered at the origin, where $x \\geq 0,y \\geq 0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-7348.json" "file_sha256" "6e5852616e7c8fcc8ec82b77ae5610fc97f84fbd72f2ecd054fdabffe4dc65e6"} {"question" "e-7348" "field" nil "attribute" "question/worked-solution" "value" "We will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nFirst, let's sketch our region $D\\mathbin{:}$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/assets/051cfbbf3fd37f01ff7e4442fccdc5ec4ce506e3c452b68bfa2ed5ae6e5cf6b9.png)\n\nIn polar coordinates $(r, \\theta),$ the region can be expressed as \n\n$$\n\\Delta = \\left\\{ (r,\\theta) \\: : \\: 0 \\leq r \\leq 2, \\:0\\leq \\theta \\leq  \\dfrac{\\pi}{2} \\right\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}15x{y}^{2}\\,\\text{d}A & ={∬}_{Δ}15r\\operatorname{cos}⁡\\theta \\cdot (r\\operatorname{sin}⁡\\theta )^{2}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{0}^{2}15{r}^{4}\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta {\\int }_{0}^{2}5{r}^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,{[{r}^{5}]}_{0}^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta ({2}^{5}-0)\\text{d}\\theta  \\\\  & =32{\\int }_{0}^{\\pi /2}3\\operatorname{cos}⁡\\theta {sin}^{2}⁡\\theta \\,\\text{d}\\theta  \\\\  & =32{[{sin}^{3}⁡\\theta ]}_{0}^{\\pi /2} \\\\  & =32({sin}^{3}⁡(\\frac{\\pi }{2})-{sin}^{3}⁡(0)) \\\\  & =32(1-0) \\\\  & =32.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054995/example-7348.json" "file_sha256" "6e5852616e7c8fcc8ec82b77ae5610fc97f84fbd72f2ecd054fdabffe4dc65e6"}] "usage" {"q-38031" [] "e-7347" [] "q-38076" [] "q-38140" [] "e-7348" [] "e-7346" [] "e-12376" []} "basis" 1812 "retractions" [[17592186129566 :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/2030/Source/Images/q-38076.png)\n\nThe region $D$ is the semicircle shown above. What is\n$\\iint _{D}2xydA$\nexpressed in polar coordinates?"] [17592186129566 :question/worked-solution "The diagram is the right half of the radius-$2$ disk: $0\\le r\\le2$ and $-\\pi/2\\le\\theta\\le\\pi/2$. Also $2xy=2r^2\\cos\\theta\\sin\\theta=r^2\\sin(2\\theta)$. Including the factor $r$ from $dA$ gives $$\\iint_D2xy\\,dA=\\int_{-\\pi/2}^{\\pi/2}\\int_0^2r^3\\sin(2\\theta)\\,dr\\,d\\theta.$$"] [17592186129565 :question/problem "Evaluate\n\n$\\int _{0}^{\\pi /2}\\int _{0}^{\\sin \\theta }2r\\cos \\theta drd\\theta $."] [17592186129565 :question/worked-solution "Integrate first with respect to $r$: $$\\int_0^{\\pi/2}\\int_0^{\\sin\\theta}2r\\cos\\theta\\,dr\\,d\\theta=\\int_0^{\\pi/2}\\sin^2\\theta\\cos\\theta\\,d\\theta.$$ Let $u=\\sin\\theta$, so $du=\\cos\\theta\\,d\\theta$ and the bounds become $0,1$. The result is $\\int_0^1u^2\\,du=1/3$."] [17592186129565 :question/difficulty 17592186045463] [17592186129571 :question/problem "Integrate the function $f(x, y) = 2x + y$ over the portion of the disk of radius $2$ centered at the origin, where $y \\ge 0$."] [17592186129571 :question/worked-solution "The upper half-disk has $0\\le r\\le2$, $0\\le\\theta\\le\\pi$. Hence $$\\iint_D(2x+y)\\,dA=\\int_0^\\pi\\int_0^2r^2(2\\cos\\theta+\\sin\\theta)\\,dr\\,d\\theta=\\frac83\\int_0^\\pi(2\\cos\\theta+\\sin\\theta)\\,d\\theta.$$ The cosine integral is zero and the sine integral is $2$, giving $16/3$."] [17592186128952 :question/problem "The region $D$ is the quarter-circle shown above. What is $\\displaystyle \\iint\\limits_D y \\sqrt{x^2+y^2} \\: \\textrm{d}A$\nexpressed in polar coordinates?\n\n![](/home/jake/Developer/MA/DATA/Lessons/2030/Source/Images/e61cb3c40b449c031c9d9074f8983b94.png)"] [17592186128952 :question/worked-solution "The diagram shows the first-quadrant quarter-disk of radius $1$, so $0\\le r\\le1$ and $0\\le\\theta\\le\\pi/2$. Substitute $y=r\\sin\\theta$, $\\sqrt{x^2+y^2}=r$, and $dA=r\\,dr\\,d\\theta$. Thus $$\\iint_Dy\\sqrt{x^2+y^2}\\,dA=\\int_0^{\\pi/2}\\int_0^1(r\\sin\\theta)r\\,r\\,dr\\,d\\theta=\\int_0^{\\pi/2}\\int_0^1r^3\\sin\\theta\\,dr\\,d\\theta.$$"] [17592186128788 :question/problem "Given that $D = \\left\\{(x,y) \\,: \\, x^2 + (y+2)^2 \\leq 4\\right\\}$, express the following integral in polar coordinates:\n\n$\\displaystyle \\iint\\limits_D e^{\\sqrt{x^2 + y^2}} \\, \\textrm{d}A$"] [17592186128788 :question/worked-solution "Use $x=r\\cos\\theta$, $y=r\\sin\\theta$, with $r\\ge0$. Expanding the region gives $$x^2+(y+2)^2\\le4\\quad\\Longleftrightarrow\\quad r^2+4r\\sin\\theta\\le0.$$ The disk lies below the origin, so $\\pi\\le\\theta\\le2\\pi$ and $0\\le r\\le-4\\sin\\theta$. Since $\\sqrt{x^2+y^2}=r$ and $dA=r\\,dr\\,d\\theta$, $$\\iint_De^{\\sqrt{x^2+y^2}}\\,dA=\\int_\\pi^{2\\pi}\\int_0^{-4\\sin\\theta}re^r\\,dr\\,d\\theta.$$"] [17592186128951 :question/problem "Evaluate $\\displaystyle \\int_{0}^{\\pi/8} \\int_0^{\\sin2\\theta} r \\, \\textrm d r\\,\\textrm d \\theta$."] [17592186128951 :question/worked-solution "First, we integrate with respect to $r$, treating $\\theta$ as a constant:\n\n$$\n\\begin{aligned}\n\\int _{0}^{\\pi /8}\\int _{0}^{\\sin 2\\theta }rdrd\\theta  &= \\frac{1}{2}\\int _{0}^{\\pi /8}[r^{2}]_{0}^{\\sin 2\\theta }d\\theta  \\\\\n&= \\frac{1}{2}\\int _{0}^{\\pi /8}\\sin^{2} 2\\theta d\\theta \n\\end{aligned}\n$$\n\nNext, we recall the double-angle formula\n\n$$\n\\cos{2x} = 1-2\\sin^2 x\n$$\n\nSubstituting $x=2\\theta$ and rearranging, we get\n\n$$\n\\sin^22\\theta = \\dfrac12\\left(1-\\cos4\\theta\\right)\n$$\n\nFinally, we can finish our integral by integrating with respect to $\\theta$, as follows:\n\n$$\n\\begin{aligned}\n\\frac{1}{2}\\int _{0}^{\\pi /8}\\sin^{2} 2\\theta d\\theta  &= \\frac{1}{2}\\int _{0}^{\\pi /8}\\frac{1}{2}(1 - \\cos 4\\theta )d\\theta  \\\\\n&= \\frac{1}{4}\\int _{0}^{\\pi /8}1 - \\cos 4\\theta d\\theta  \\\\\n&= \\frac{1}{4}[\\theta  - \\frac{1}{4}\\sin 4\\theta ]_{0}^{\\pi /8} \\\\\n&= \\frac{1}{4}[(\\frac{\\pi }{8} - \\frac{1}{4}\\sin (\\frac{\\pi }{2})) - (0 - \\frac{1}{4}\\sin (0))] \\\\\n&= \\frac{1}{4}(\\frac{\\pi }{8} - \\frac{1}{4}) \\\\\n&= \\frac{1}{4}(\\frac{\\pi }{8} - \\frac{2}{8}) \\\\\n&= \\frac{1}{32}(\\pi  - 2)\n\\end{aligned}\n$$"] [17592186128953 :question/problem "Integrate the function $f(x, y) = 15xy^2$ over the portion of the disk of radius $2$ centered at the origin, where $x \\geq 0,y \\geq 0$."] [17592186128953 :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\: r \\ \\mathrm d r \\mathrm d \\theta\n$$\n\nFirst, let's sketch our region $D$:\n\n![](/home/jake/Developer/MA/DATA/Lessons/2030/Source/Images/3a076157edac08be902902303455d72d.png)\n\nIn polar coordinates $(r, \\theta)$, the region can be expressed as\n\n$$\n\\Delta = \\left\\{(r,\\theta) \\:: \\: 0 \\leq r \\leq 2, \\:0\\leq \\theta \\leq \\dfrac{\\pi}{2} \\right\\}\n$$\n\nTherefore, using the change of variables formula, we obtain\n\n$$\n\\begin{aligned}\n\\iint _{D}15xy^{2}dA &= \\iint _{\\Delta }15r\\cos \\theta  \\cdot (r\\sin \\theta )^{2}rdrd\\theta  \\\\\n&= \\int _{0}^{\\pi /2}\\int _{0}^{2}15r^{4}\\cos \\theta \\sin^{2} \\theta drd\\theta  \\\\\n&= \\int _{0}^{\\pi /2}3\\cos \\theta \\sin^{2} \\theta \\int _{0}^{2}5r^{4}drd\\theta  \\\\\n&= \\int _{0}^{\\pi /2}3\\cos \\theta \\sin^{2} \\theta [r^{5}]_{0}^{2}d\\theta  \\\\\n&= \\int _{0}^{\\pi /2}3\\cos \\theta \\sin^{2} \\theta (2^{5} - 0)d\\theta  \\\\\n&= 32\\int _{0}^{\\pi /2}3\\cos \\theta \\sin^{2} \\theta d\\theta  \\\\\n&= 32[\\sin^{3} \\theta ]_{0}^{\\pi /2} \\\\\n&= 32(\\sin^{3} (\\frac{\\pi }{2}) - \\sin^{3} (0)) \\\\\n&= 32(1 - 0) \\\\\n&= 32\n\\end{aligned}\n$$"]] "immutable_answers" [17592186127185 17592186127186 17592186127187 17592186127188 17592186127189 17592186127191 17592186127192 17592186127193 17592186127194 17592186127195 17592186127221 17592186127222 17592186127223 17592186127224 17592186127225] "immutable_fields" [[17592186127184 :answer-field/correct] [17592186127184 :answer-field/id] [17592186127184 :answer-field/key] [17592186127184 :answer-field/type] [17592186127190 :answer-field/correct] [17592186127190 :answer-field/id] [17592186127190 :answer-field/key] [17592186127190 :answer-field/type] [17592186127220 :answer-field/correct] [17592186127220 :answer-field/id] [17592186127220 :answer-field/key] [17592186127220 :answer-field/type]] "no_history" []}
