453 13194139535820 true] [17592186368245 1111 #uuid "19e9486a-a598-5092-aa63-9569e559318d" 13194139535820 true] [17592186368246 1034 "10\\,\\text{d}a+8\\,\\text{d}b" 13194139535820 true] [17592186368246 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368246 1111 #uuid "60001955-14df-5a32-b7f9-d647fd3ebbfb" 13194139535820 true] [17592186368247 1034 "5\\,\\text{d}a+4\\,\\text{d}b" 13194139535820 true] [17592186368247 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368247 1111 #uuid "10a7bcd0-217e-5147-bd4c-049078d39884" 13194139535820 true] [17592186368248 1017 #edb/ref 17592186368249 13194139535820 true] [17592186368248 1089 "q-79809" 13194139535820 true] [17592186368248 1091 #edb/ref 17592186045463 13194139535820 true] [17592186368248 1100 "If $f(x,y)=x\\operatorname{sin}⁡y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(2,\\frac{\\pi }{2})$ to $(1.5,1.5).$" 13194139535820 true] [17592186368248 1113 #uuid "1aaac8bd-05f7-51d8-b74f-80f827c40f55" 13194139535820 true] [17592186368248 1145 "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{sin}⁡y\\,\\text{d}x+x\\operatorname{cos}⁡y\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(2,\\frac{\\pi }{2}),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})\\,\\text{d}x+2\\operatorname{cos}⁡(\\frac{\\pi }{2})\\,\\text{d}y \\\\  & =1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,\\frac{\\pi }{2}+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+0\\,Δy.\n$$\n\nMoving from $(2,\\frac{\\pi }{2})$ to $(1.5,1.5),$ we have\n\n$$\n\\begin{aligned}Δx & =1.5-2=-0.5, \\\\ Δy & =1.5-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+0\\,Δy \\\\  & ≈1\\cdot (-0.5)+0\\cdot (1.5-\\frac{\\pi }{2}) \\\\  & ≈-0.5.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ decreases by approximately $0.5.$" 13194139535820 true] [17592186368249 1000 #edb/ref 17592186368250 13194139535820 true] [17592186368249 1000 #edb/ref 17592186368251 13194139535820 true] [17592186368249 1000 #edb/ref 17592186368252 13194139535820 true] [17592186368249 1000 #edb/ref 17592186368253 13194139535820 true] [17592186368249 1000 #edb/ref 17592186368254 13194139535820 true] [17592186368249 1040 #edb/ref 17592186045450 13194139535820 true] [17592186368249 1041 "selection" 13194139535820 true] [17592186368249 1104 #edb/ref 17592186368252 13194139535820 true] [17592186368249 1110 #uuid "2fb18966-8112-5d33-b5d7-c27d4bd8f19f" 13194139535820 true] [17592186368250 1034 "-0.1" 13194139535820 true] [17592186368250 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368250 1111 #uuid "204428b9-93b2-5a18-9ee0-ad909a0c64b0" 13194139535820 true] [17592186368251 1034 "0.5" 13194139535820 true] [17592186368251 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368251 1111 #uuid "3c08265b-d561-5b63-b9ef-0fb3ecba8ea2" 13194139535820 true] [17592186368252 1034 "-0.5" 13194139535820 true] [17592186368252 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368252 1111 #uuid "f2f0657c-98ac-5ced-b197-b2e66cf8fdf3" 13194139535820 true] [17592186368253 1034 "1" 13194139535820 true] [17592186368253 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368253 1111 #uuid "68dd8ec3-eaae-5660-8eca-0e267280f001" 13194139535820 true] [17592186368254 1034 "-1" 13194139535820 true] [17592186368254 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368254 1111 #uuid "fcc65e08-eef4-5ace-a386-61fd6b07a4ad" 13194139535820 true] [17592186368255 1017 #edb/ref 17592186368256 13194139535820 true] [17592186368255 1089 "q-79812" 13194139535820 true] [17592186368255 1091 #edb/ref 17592186045463 13194139535820 true] [17592186368255 1100 "If $f(x,y)=x\\operatorname{ln}⁡y,$ use the differential $\\text{d}f$ to e