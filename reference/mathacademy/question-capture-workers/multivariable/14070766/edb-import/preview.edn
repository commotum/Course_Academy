 ≈1+0.6 \\\\  & ≈1.6\\,.\\end{aligned}\n$$" 13194139535820 true] [17592186368284 1000 #edb/ref 17592186368285 13194139535820 true] [17592186368284 1000 #edb/ref 17592186368286 13194139535820 true] [17592186368284 1000 #edb/ref 17592186368287 13194139535820 true] [17592186368284 1000 #edb/ref 17592186368288 13194139535820 true] [17592186368284 1000 #edb/ref 17592186368289 13194139535820 true] [17592186368284 1040 #edb/ref 17592186045450 13194139535820 true] [17592186368284 1041 "selection" 13194139535820 true] [17592186368284 1104 #edb/ref 17592186368287 13194139535820 true] [17592186368284 1110 #uuid "3fafd693-be9d-55a9-a6fa-75ea7f94c157" 13194139535820 true] [17592186368285 1034 "0.6" 13194139535820 true] [17592186368285 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368285 1111 #uuid "faabf5d6-4f4d-5870-90c3-362110fe1a53" 13194139535820 true] [17592186368286 1034 "-0.6" 13194139535820 true] [17592186368286 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368286 1111 #uuid "216cc665-0fe3-5cac-b763-4dc505b53d8d" 13194139535820 true] [17592186368287 1034 "1.6" 13194139535820 true] [17592186368287 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368287 1111 #uuid "586c65b8-fe09-5f90-a1f0-b80016569bb6" 13194139535820 true] [17592186368288 1034 "-2.6" 13194139535820 true] [17592186368288 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368288 1111 #uuid "ab23a7d2-5911-560c-8918-17a8a2518641" 13194139535820 true] [17592186368289 1034 "-1.6" 13194139535820 true] [17592186368289 1103 #edb/ref 17592186045453 13194139535820 true] [17592186368289 1111 #uuid "ba6ce929-47a0-5339-a775-d76754712a16" 13194139535820 true]] :edb/tempids {"q-167153" 17592186368220 "q-167153/selection" 17592186368221 "q-167153/selection/1631291644aaf8db61441eac46fb646373705f6eddd7ab65a438c4611b745efd" 17592186368222 "q-167153/selection/3355c202a2e83b68c13e18a065f050ba522c0120bd344c2ea167a5d195d14bda" 17592186368223 "q-167153/selection/3aef60ca39d1ca82941a70a36