os}⁡(yz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-79743/selection/a198b4d5df885dca3ba42d5e6a60a8ad3b30dfed194efb1658340ef437c416ec" :answer/id #uuid "c778bb51-8d61-5c3e-9834-d63d8c823548" :answer/type :answer.type/math :answer/value "2x\\operatorname{sin}⁡(yz)\\,\\text{d}x+{x}^{2}z\\operatorname{cos}⁡(yz)\\,\\text{d}y+{x}^{2}y\\operatorname{cos}⁡(yz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-79743/selection/1338fb9cd9174d4d4654fd6602f2488f2b8dc13bf4b274c45d7a8c533e034b5f" :answer/id #uuid "d8f44976-44ad-53d7-b855-d18b4e66d03c" :answer/type :answer.type/math :answer/value "x\\operatorname{sin}⁡(yz)\\,\\text{d}x+z\\operatorname{sin}⁡(yz)\\,\\text{d}y+y\\operatorname{sin}⁡(yz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-79743/selection/d645b2abee52c93a25103c3b2fa6a4df1fbf1e0d1c224b455c44e8ebfd8316be" :answer/id #uuid "bc8fad3c-9503-5cc5-a562-574f1cfea911" :answer/type :answer.type/math :answer/value "2x\\operatorname{cos}⁡(yz)\\,\\text{d}x+{x}^{2}\\operatorname{cos}⁡(yz)\\,\\text{d}y+{x}^{2}\\operatorname{cos}⁡(yz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-79743/selection/52f10f8f2f2e6f8102de8ff32e6f668e20c8532dacabfdd647f89be27647b2e9" :answer/id #uuid "799812fc-9ba1-5f1a-bffd-2f388a50e75a" :answer/type :answer.type/math :answer/value "x\\operatorname{cos}⁡(yz)\\,\\text{d}x+z\\operatorname{sin}⁡(yz)\\,\\text{d}y+y\\operatorname{sin}⁡(yz)\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-79743/selection" :answer-field/id #uuid "916089fb-07cc-5d70-9eab-9b44430ece3a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79743/selection/a198b4d5df885dca3ba42d5e6a60a8ad3b30dfed194efb1658340ef437c416ec" :answer-field/choices ["q-79743/selection/9bcea26b8502fd0cf04c984fbff8fd985d6520ddfb8e826d86c36e4be34585dc" "q-79743/selection/a198b4d5df885dca3ba42d5e6a60a8ad3b30dfed194efb1658340ef437c416ec" "q-79743/selection/1338fb9cd9174d4d4654fd6602f2488f2b8dc13bf4b274c45d7a8c533e034b5f" "q-79743/selection/d645b2abee52c93a25103c3b2fa6a4df1fbf1e0d1c224b455c44e8ebfd8316be" "q-79743/selection/52f10f8f2f2e6f8102de8ff32e6f668e20c8532dacabfdd647f89be27647b2e9"] :db/ensure [:answer-field/validate]} {:db/id "q-79743" :question/id #uuid "e73584a2-3314-5ba6-9e06-8a136fbad578" :question/math-academy-id "q-79743" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)={x}^{2}\\operatorname{sin}⁡(yz).$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =2x\\operatorname{sin}⁡(yz)\\,\\text{d}x+{x}^{2}z\\operatorname{cos}⁡(yz)\\,\\text{d}y+{x}^{2}y\\operatorname{cos}⁡(yz)\\,\\text{d}z\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79743/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4f23c5c7-d281-54da-b625-412925c80667"] :knowledge-point/questions ["q-79743"] :db/ensure [:knowledge-point/validate]} {:db/id "q-167153/selection/716f198a1fa01315a065f8323eba5bd6d0dfbcd78e46121f15a2b7ad80ab13db" :answer/id #uuid "61274a79-b9d7-549b-b40c-5113fa25ad4c" :answer/type :answer.type/math :answer/value "{e}^{-y}\\,\\text{d}x+({e}^{z}-x{e}^{-y})\\,\\text{d}y+y{e}^{z}\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-167153/selection/3aef60ca39d1ca82941a70a3609323c752be780dab34bbf7c908e831d0a8a7a2" :answer/id #uuid "8d6f79bb-163e-51cd-9dc3-77261c756435" :answer/type :answer.type/math :answer/value "{e}^{-y}\\,\\text{d}x-{e}^{z}\\,\\text{d}y+y{e}^{z}\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-167153/selection/67f88753952e6b714380905f46d0e9c0cc55d3878d2846ed36cedbc07d2f20b3" :answer/id #uuid "659ac91e-f130-5047-bb9f-7160f6dba51a" :answer/type :answer.type/math :answer/value "x{e}^{-y}\\,\\text{d}x+(y{e}^{z}-x{e}^{-y})\\,\\text{d}y+y\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-167153/selection/3355c202a2e83b68c13e18a065f050ba522c0120bd344c2ea167a5d195d14bda" :answer/id #uuid "c1546236-aef0-5f3c-ba0b-cf9f612ca1a8" :answer/type :answer.type/math :answer/value "{e}^{y}\\,\\text{d}x-x{e}^{-y}\\,\\text{d}y+{e}^{z}\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-167153/selection/1631291644aaf8db61441eac46fb646373705f6eddd7ab65a438c4611b745efd" :answer/id #uuid "cbb455bc-309b-5895-94c5-cea1504564c2" :answer/type :answer.type/math :answer/value "x{e}^{-y}\\,\\text{d}x+(y{e}^{z}+x{e}^{-y})\\,\\text{d}y+{e}^{z}\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-167153/selection" :answer-field/id #uuid "fd36b178-f6ee-5ce4-b56a-ef191aeed514" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-167153/selection/716f198a1fa01315a065f8323eba5bd6d0dfbcd78e46121f15a2b7ad80ab13db" :answer-field/choices ["q-167153/selection/716f198a1fa01315a065f8323eba5bd6d0dfbcd78e46121f15a2b7ad80ab13db" "q-167153/selection/3aef60ca39d1ca82941a70a3609323c752be780dab34bbf7c908e831d0a8a7a2" "q-167153/selection/67f88753952e6b714380905f46d0e9c0cc55d3878d2846ed36cedbc07d2f20b3" "q-167153/selection/3355c202a2e83b68c13e18a065f050ba522c0120bd344c2ea167a5d195d14bda" "q-167153/selection/1631291644aaf8db61441eac46fb646373705f6eddd7ab65a438c4611b745efd"] :db/ensure [:answer-field/validate]} {:db/id "q-167153" :question/id #uuid "58e81257-b6b3-578e-8b3d-12f40ca13f58" :question/math-academy-id "q-167153" :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)=x{e}^{-y}+y{e}^{z}.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =[{e}^{-y}]\\,\\text{d}x+[-x{e}^{-y}+{e}^{z}]\\,\\text{d}y+[y{e}^{z}]\\,\\text{d}z \\\\  & ={e}^{-y}\\,\\text{d}x+({e}^{z}-x{e}^{-y})\\,\\text{d}y+y{e}^{z}\\,\\text{d}z\\end{aligned}\n$$" :question/difficulty :q