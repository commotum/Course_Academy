[{:db/id [:question/math-academy-id "q-37282"] :question/problem "Find the differential $\\text{d}f$ for the function $f(x,y,z)=\\operatorname{cos}⁡(xy)-2{z}^{2}y.$" :question/worked-solution "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =[-y\\operatorname{sin}⁡(xy)]\\,\\text{d}x+[-2{z}^{2}-x\\operatorname{sin}⁡(xy)]\\,\\text{d}y+[-4yz]\\,\\text{d}z \\\\  & =-y\\operatorname{sin}⁡(xy)\\,\\text{d}x-(2{z}^{2}+x\\operatorname{sin}⁡(xy))\\,\\text{d}y-4yz\\,\\text{d}z\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-79740/selection/4ab4f56f0e6bc2d508084aa5e58f18fad354670ab300830859ee7d6f284a91e5" :answer/id #uuid "d36811ed-9c50-51e6-ac8f-4d5481f31703" :answer/type :answer.type/math :answer/value "4{y}^{3}\\,\\text{d}x+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79740/selection/462327b161efdb9fd6214f1d795c9f99e59ac25b0c68966c1a7beef9da78001e" :answer/id #uuid "84684ffd-17a2-5f3e-be9a-e4e6d3ecb279" :answer/type :answer.type/math :answer/value "4{y}^{3}\\,\\text{d}x+12{y}^{2}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79740/selection/4b5101ed52053f097be31cdc7c6eb6e2b256a7c677681938277e2d6712ef1eee" :answer/id #uuid "dc7fdbac-8e88-5c84-ab36-cd5ff674c3f0" :answer/type :answer.type/math :answer/value "\\frac{4{y}^{3}\\,\\text{d}x}{x}+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79740/selection/82d16a15480d49e0d95dccc904e4ec904d61023518159269ca03f47086036f04" :answer/id #uuid "73fae675-0c9c-52eb-9589-c2f356423762" :answer/type :answer.type/math :answer/value "\\frac{\\text{d}x}{x}+12{y}^{2}\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-79740/selection/d9f02072aee6abd63b9977e0d59e57bb763c689a7453ad10f8c88b69a6981916" :answer/id #uuid "5cb35345-31c5-5ef7-a470-66c5989bbbe