f200e3e99b7b35295359ae666c7" "q-79744/selection/008d42dc88b31bc10e8bf07ca21dcc577f6b4eb395cf089c5b9f18bba9a78a93" "q-79744/selection/ce8a0b71e905669565fb0a6c79a53bd324fd3c2a55cf626dbd79dd2f1459bf37" "q-79744/selection/12eee6532b9a3347121c998509fc3a372ab83708c0bcc78bf7ef650505ff0f2f"] :db/ensure [:answer-field/validate]} {:db/id "q-79744" :question/id #uuid "b1c3c795-7c5d-549b-81c7-5bd23b4b11f6" :question/math-academy-id "q-79744" :question/problem "Given a rectangle, find the differential $\\text{d}S$ for the area $S$ if the lengths of sides are $a=4$ and $b=5.$" :question/worked-solution "The area of the rectangle is $S=ab.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,b) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂b})\\,\\text{d}b \\\\  & =b\\,\\text{d}a+a\\,\\text{d}b\\end{aligned}\n$$\n\nFor $a=4$ and $b=5,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(4,5) & =5\\,\\text{d}a+4\\,\\text{d}b.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79744/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb"] :knowledge-point/questions ["q-79744"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79812/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "8c38c489-c392-56d7-b827-3d7519be8373" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-79812/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "ab0fef72-835c-53ea-9e68-78c0ca90383f" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-79812/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" :answer/id #uuid "4ce2bbef-c135-5197-8d10-2ee0d2def449" :answer/type :answer.type/math :answer/value "e" :db/ensure [:answer/validate]} {:db/id "q-79812/selection/59ea3a9d4275768c45175c3d1716461ab9fbdc66cd258482de76898e0a85cce4" :answer/id #uuid "bdc2660c-89f6-5af0-9c43-45260bd1415c" :answer/type :answer.type/math :answer/value "2-e" :db/ensure [:answer/validate]} {:db/id "q-79812/selection/087d6195df78ac19ad68ba3746305a749712648815fc499a6add393278e08471" :answer/id #uuid "da38700e-6cef-5a76-b977-fb143e5f3ce4" :answer/type :answer.type/math :answer/value "e-2" :db/ensure [:answer/validate]} {:db/id "q-79812/selection" :answer-field/id #uuid "98b9b42f-9987-54bc-bd68-413c1c8d2bab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79812/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-79812/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-79812/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-79812/selection/a2301b8122c312044fb5dc0b0c60c599b4f2f7f4ffcc198c9893873ab9165c9d" "q-79812/selection/59ea3a9d4275768c45175c3d1716461ab9fbdc66cd258482de76898e0a85cce4" "q-79812/selection/087d6195df78ac19ad68ba3746305a749712648815fc499a6add393278e08471"] :db/ensure [:answer-field/validate]} {:db/id "q-79812" :question/id #uuid "5dfed89f-88e1-5c5a-a0c4-8c6a48d5109c" :question/math-academy-id "q-79812" :question/problem "If $f(x,y)=x\\operatorname{ln}⁡y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(0,e)$ to $(1,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{ln}⁡y\\,\\text{d}x+\\frac{x}{y}\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(0,e),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(0,e) & =\\operatorname{ln}⁡e\\,\\text{d}x+\\frac{0}{e}\\,\\text{d}y \\\\  & =1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,e+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+0\\,Δy.\n$$\n\nMoving from $(0,e)$ to $(1,2),$ we have\n\n$$\n\\begin{aligned}Δx & =1-0=1, \\\\ Δy & =2-e.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+0\\,Δy \\\\  & ≈1\\cdot (1)+0\\cdot (2-e) \\\\  & ≈1.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ increases by approximately $1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79812/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-79812"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86716/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "15f076ae-e629-5439-9c98-bba14dca7c1e" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-86716/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "7ae014ee-7770-5f80-a9eb-38854eacf88f" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-86716/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" :answer/id #uuid "9d1fbdd8-0256-530e-9c73-db6a3145a35a" :answer/type :answer.type/math :answer/value "-24" :db/ensure [:answer/validate]} {:db/id "q-86716/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "cad56644-6bfd-5d13-bb32-30155204662d" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-86716/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "1139551c-f68b-5fb1-a7f3-8bf06c4a5752" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-86716/selection" :answer-field/id #uuid "e8d2c25a-229a-56e9-a454-7070c01113d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86716/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer-field/choices ["q-86716/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-86716/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-86716/selection/594f4371237f716a4e7b771cfac6a2ca8b8eb3c8dcb7752f2b3291728275476a" "q-86716/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-86716/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c"] :db/ensure [:answer-field/validate]} {:db/id "q-86716" :question/id #uuid "9d9b4c83-a5a4-5bcb-9b61-e4f8172a0054" :question/math-academy-id "q-86716" :question/problem "If $f(x,y,z)=(2x+{y}^{2}-z)^{2},$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y,z)$ from $(1,2,0)$ to $(2,1.5,1).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y+(\\frac{∂f}{∂z})\\,\\text{d}z \\\\  & =4(2x+{y}^{2}-z)\\,\\text{d}x+4y(2x+{y}^{2}-z)\\,\\text{d}y-2(2x+{y}^{2}-z)\\,\\text{d}z\\end{aligned}\n$$\n\nAt the point $(1,2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(1,2,0) & =4(2\\cdot 1+{2}^{2}-0)\\,\\text{d}x+(4\\cdot 2)(2\\cdot 1+{2}^{2}-0)\\,\\text{d}y-2(2\\cdot 1+{2}^{2}-0)\\,\\text{d}z \\\\  & =24\\,\\text{d}x+48\\,\\text{d}y-12\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, if we move to the point $(1+Δx,2+Δy,0+Δz),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈24\\,Δx+48\\,Δy-12\\,Δz.\n$$\n\nMoving from $(1,2,0)$ to $(2,1.5,1),$ we have\n\n$$\n\\begin{aligned}Δx & =2-1=1, \\\\ Δy & =1.5-2=-0.5 \\\\ Δz & =1-0=1.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈24\\,Δx+48\\,Δy-12\\,Δz \\\\  & ≈24\\cdot 1+48\\cdot (-0.5)-12\\cdot 1 \\\\  & ≈-12.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y,z)$ decreases by approximately $-12.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-86716/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-86716"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79809/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "fcc65e08-eef4-5ace-a386-61fd6b07a4ad" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-79809/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "68dd8ec3-eaae-5660-8eca-0e267280f001" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-79809/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" :answer/id #uuid "3c08265b-d561-5b63-b9ef-0fb3ecba8ea2" :answer/type :answer.type/math :answer/value "0.5" :db/ensure [:answer/validate]} {:db/id "q-79809/selection/a39e4c3855e119cc134cd501616b2d4242dd33fe6134da1d7da0776d673411f7" :answer/id #uuid "f2f0657c-98ac-5ced-b197-b2e66cf8fdf3" :answer/type :answer.type/math :answer/value "-0.5" :db/ensure [:answer/validate]} {:db/id "q-79809/selection/8ac30d3591fa1339da0a7d189d6941a5fce54deb3ac21613d657c90f0e256edd" :answer/id #uuid "204428b9-93b2-5a18-9ee0-ad909a0c64b0" :answer/type :answer.type/math :answer/value "-0.1" :db/ensure [:answer/validate]} {:db/id "q-79809/selection" :answer-field/id #uuid "2fb18966-8112-5d33-b5d7-c27d4bd8f19f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79809/selection/a39e4c3855e119cc134cd501616b2d4242dd33fe6134da1d7da0776d673411f7" :answer-field/choices ["q-79809/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-79809/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-79809/selection/95a1d5fa369c4d08bda10228102d0fbae8f93732afc4c2ec3773c4f3d47df28c" "q-79809/selection/a39e4c3855e119cc134cd501616b2d4242dd33fe6134da1d7da0776d673411f7" "q-79809/selection/8ac30d3591fa1339da0a7d189d6941a5fce54deb3ac21613d657c90f0e256edd"] :db/ensure [:answer-field/validate]} {:db/id "q-79809" :question/id #uuid "1aaac8bd-05f7-51d8-b74f-80f827c40f55" :question/math-academy-id "q-79809" :question/problem "If $f(x,y)=x\\operatorname{sin}⁡y,$ use the differential $\\text{d}f$ to estimate the change $Δf$ in the value of $f(x,y)$ from $(2,\\frac{\\pi }{2})$ to $(1.5,1.5).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\operatorname{sin}⁡y\\,\\text{d}x+x\\operatorname{cos}⁡y\\,\\text{d}y\\end{aligned}\n$$\n\nAt the point $(2,\\frac{\\pi }{2}),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(2,\\frac{\\pi }{2}) & =\\operatorname{sin}⁡(\\frac{\\pi }{2})\\,\\text{d}x+2\\operatorname{cos}⁡(\\frac{\\pi }{2})\\,\\text{d}y \\\\  & =1\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,\\frac{\\pi }{2}+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+0\\,Δy.\n$$\n\nMoving from $(2,\\frac{\\pi }{2})$ to $(1.5,1.5),$ we have\n\n$$\n\\begin{aligned}Δx & =1.5-2=-0.5, \\\\ Δy & =1.5-\\frac{\\pi }{2}.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\,Δx+0\\,Δy \\\\  & ≈1\\cdot (-0.5)+0\\cdot (1.5-\\frac{\\pi }{2}) \\\\  & ≈-0.5.\\end{aligned}\n$$\n\nTherefore, the value of $f(x,y)$ decreases by approximately $0.5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79809/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab023be2-0156-5de6-8843-5b720775d649"] :knowledge-point/questions ["q-79809"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79842/selection/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer/id #uuid "77b9170e-a2ed-5463-8481-11ecfc2a134b" :answer/type :answer.type/math :answer/value "2.5" :db/ensure [:answer/validate]} {:db/id "q-79842/selection/f34afcd1d8d06e16f767da9737fea297f9b48d4af4bb29ac0a317e64a3a131e9" :answer/id #uuid "705f3204-53c3-5dda-a083-3687489bd69a" :answer/type :answer.type/math :answer/value "2.1" :db/ensure [:answer/validate]} {:db/id "q-79842/selection/ccaadbd8830c06056e73238128e81dd0dc187e4352e75554fb6d21cfe6424b8c" :answer/id #uuid "c8817150-c2c6-5f94-b443-ce59d5831506" :answer/type :answer.type/math :answer/value "2.3" :db/ensure [:answer/validate]} {:db/id "q-79842/selection/449eabead9e7713acaede5d2afc64373661ad92a6819ce95b943eb2835d0094c" :answer/id #uuid "ea72e5a7-6c59-5cb5-bba5-d79dabc929db" :answer/type :answer.type/math :answer/value "2.7" :db/ensure [:answer/validate]} {:db/id "q-79842/selection/86646dfdd34dd99b12d8b2667f99ce75f934e650a9b069751cbcf304e9fbea94" :answer/id #uuid "15a5a071-d81e-5dc8-b6da-4ada35417fef" :answer/type :answer.type/math :answer/value "2.8" :db/ensure [:answer/validate]} {:db/id "q-79842/selection" :answer-field/id #uuid "2ebc7137-f09f-5d85-9d3c-f5c26a332ea2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79842/selection/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" :answer-field/choices ["q-79842/selection/1b562e91f68bc228d59da280605802cc1ce0248d770285443e7d649fb5c75d13" "q-79842/selection/f34afcd1d8d06e16f767da9737fea297f9b48d4af4bb29ac0a317e64a3a131e9" "q-79842/selection/ccaadbd8830c06056e73238128e81dd0dc187e4352e75554fb6d21cfe6424b8c" "q-79842/selection/449eabead9e7713acaede5d2afc64373661ad92a6819ce95b943eb2835d0094c" "q-79842/selection/86646dfdd34dd99b12d8b2667f99ce75f934e650a9b069751cbcf304e9fbea94"] :db/ensure [:answer-field/validate]} {:db/id "q-79842" :question/id #uuid "400e093a-adf4-5eb0-a3a9-7351a5579800" :question/math-academy-id "q-79842" :question/problem "Estimate $2.1{e}^{0.2}$ using a differential $\\text{d}f$ of the function $f(x,y)=x{e}^{y}$ at the point $(2,0).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & ={e}^{y}\\,\\text{d}x+x{e}^{y}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(2,0),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & ={e}^{0}\\,\\text{d}x+2\\cdot {e}^{0}\\,\\text{d}y \\\\  & =1\\,\\text{d}x+2\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(2+Δx,0+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈1\\,Δx+2\\,Δy\n$$\n\nNote that \n\n$$\n2.1{e}^{0.2}=f(2.1,0.2),\n$$\n\nso we want to move to the point $(2.1,0.2).$\n\nMoving from $(2,0)$ to $(2.1,0.2),$ we have\n\n$$\n\\begin{aligned}Δx & =2.1-2=0.1, \\\\ Δy & =0.2-0=0.2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈1\\cdot (0.1)+2\\cdot (0.2) \\\\  & ≈0.1+0.4 \\\\  & ≈0.5.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $0.5.$ Consequently, we have\n\n$$\n\\begin{aligned}f(2.1,0.2) & ≈f(2,0)+0.5 \\\\ 2.1{e}^{0.2} & ≈2{e}^{0}+0.5 \\\\  & ≈2+0.5 \\\\  & ≈2.5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-79842/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9"] :knowledge-point/questions ["q-79842"] :db/ensure [:knowledge-point/validate]} {:db/id "q-79839/selection/e11b91dee37df5a3317b7975f602baed0660814bab1ad496e78fede8151200bd" :answer/id #uuid "8e1e5f7a-ec23-5d51-b838-0820a666fceb" :answer/type :answer.type/math :answer/value "0.965" :db/ensure [:answer/validate]} {:db/id "q-79839/selection/1cf660b6351f32abe9ecf8e4035b51e9ec9a71aaa78c99c1362ba2e3d57b9e74" :answer/id #uuid "250506ea-7e20-54f3-b464-5b3d084ee5ca" :answer/type :answer.type/math :answer/value "0.961" :db/ensure [:answer/validate]} {:db/id "q-79839/selection/7061eaccdcb7aafa4e96b522c7bafdd6c04ac66aeeccd478b2b05391b8f750ae" :answer/id #uuid "015b742d-9721-5eac-9912-f0fa084d193b" :answer/type :answer.type/math :answer/value "0.967" :db/ensure [:answer/validate]} {:db/id "q-79839/selection/0dea656308d35ae78e8a22785d3a9d6906b83f35dd2c127a30e8e9263408ecd0" :answer/id #uuid "57684e9d-85c7-59b9-8ef0-89cb13180c82" :answer/type :answer.type/math :answer/value "0.970" :db/ensure [:answer/validate]} {:db/id "q-79839/selection/6428b7bd343ec5a857541c685ffd462df23c625a3885b7288f638645ff5b9d8e" :answer/id #uuid "1d0ff7ae-f3ce-5c8c-91f2-b0f3762a9a31" :answer/type :answer.type/math :answer/value "0.972" :db/ensure [:answer/validate]} {:db/id "q-79839/selection" :answer-field/id #uuid "6f5a2b81-bbba-529e-a955-bfdfbf250f11" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-79839/selection/7061eaccdcb7aafa4e96b522c7bafdd6c04ac66aeeccd478b2b05391b8f750ae" :answer-field/choices ["q-79839/selection/e11b91dee37df5a3317b7975f602baed0660814bab1ad496e78fede8151200bd" "q-79839/selection/1cf660b6351f32abe9ecf8e4035b51e9ec9a71aaa78c99c1362ba2e3d57b9e74" "q-79839/selection/7061eaccdcb7aafa4e96b522c7bafdd6c04ac66aeeccd478b2b05391b8f750ae" "q-79839/selection/0dea656308d35ae78e8a22785d3a9d6906b83f35dd2c127a30e8e9263408ecd0" "q-79839/selection/6428b7bd343ec5a857541c685ffd462df23c625a3885b7288f638645ff5b9d8e"] :db/ensure [:answer-field/validate]} {:db/id "q-79839" :question/id #uuid "a54c5ee7-1031-5fd0-9d6c-d7e805eea014" :question/math-academy-id "q-79839" :question/problem "Estimate the value of ${e}^{\\sqrt{10}-3.2}$ using a differential $\\text{d}f$ of the function $f(x,y)={e}^{\\sqrt{x}-y}$ at the point $(9,3).$ Round your answer to $3$ decimal places." :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =\\frac{{e}^{\\sqrt{x}-y}}{2\\sqrt{x}}\\,\\text{d}x-{e}^{\\sqrt{x}-y}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(9,3),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =\\frac{{e}^{\\sqrt{9}-3}}{2\\sqrt{9}}\\,\\text{d}x-{e}^{\\sqrt{9}-3}\\,\\text{d}y \\\\  & =\\frac{{e}^{0}}{6}\\,\\text{d}x-{e}^{0}\\,\\text{d}y \\\\  & =\\frac{1}{6}\\,\\text{d}x-1\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(9+Δx,3+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈\\frac{1}{6}\\,Δx-1\\,Δy\n$$\n\nNote that \n\n$$\n{e}^{\\sqrt{10}-3.2}=f(10,3.2),\n$$\n\nso we want to move to the point $(10,3.2).$\n\nMoving from $(9,3)$ to $(10,3.2),$ we have\n\n$$\n\\begin{aligned}Δx & =10-9=1, \\\\ Δy & =3.2-3=0.2.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈\\frac{1}{6}\\cdot 1-1\\cdot 0.2 \\\\  & ≈0.167-0.2 \\\\  & ≈-0.033.\\end{aligned}\n$$\n\nThis means that the value of $f$ decreases by about $0.033.$ Consequently, we have\n\n$$\n\\begin{aligned}(10,3.2) & ≈f(9,3)-0.033 \\\\ {e}^{\\sqrt{10}-3.2} & ≈{e}^{\\sqrt{9}-3}-0.033 \\\\  & ≈1-0.033 \\\\  & ≈0.967.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-79839/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9"] :knowledge-point/questions ["q-79839"] :db/ensure [:knowledge-point/validate]} {:db/id "q-86717/selection/1ef14df341e2f354c34ae93e3c7ddfea65840e9fda1897b5ea50de018c5615fe" :answer/id #uuid "586c65b8-fe09-5f90-a1f0-b80016569bb6" :answer/type :answer.type/math :answer/value "1.6" :db/ensure [:answer/validate]} {:db/id "q-86717/selection/646187f8e82183282d54656b209b488cfda179d49050f0410f55dbddc5950932" :answer/id #uuid "ab23a7d2-5911-560c-8918-17a8a2518641" :answer/type :answer.type/math :answer/value "-2.6" :db/ensure [:answer/validate]} {:db/id "q-86717/selection/7600f826341aff9ca964833d2dfb2466015112ef9e41cdaf608edf7415238fae" :answer/id #uuid "ba6ce929-47a0-5339-a775-d76754712a16" :answer/type :answer.type/math :answer/value "-1.6" :db/ensure [:answer/validate]} {:db/id "q-86717/selection/17c124f1b3ef1647a9eb3e32e36e133739af5a9e4bc800680ba6fa18947c4e0d" :answer/id #uuid "216cc665-0fe3-5cac-b763-4dc505b53d8d" :answer/type :answer.type/math :answer/value "-0.6" :db/ensure [:answer/validate]} {:db/id "q-86717/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f" :answer/id #uuid "faabf5d6-4f4d-5870-90c3-362110fe1a53" :answer/type :answer.type/math :answer/value "0.6" :db/ensure [:answer/validate]} {:db/id "q-86717/selection" :answer-field/id #uuid "3fafd693-be9d-55a9-a6fa-75ea7f94c157" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-86717/selection/1ef14df341e2f354c34ae93e3c7ddfea65840e9fda1897b5ea50de018c5615fe" :answer-field/choices ["q-86717/selection/1ef14df341e2f354c34ae93e3c7ddfea65840e9fda1897b5ea50de018c5615fe" "q-86717/selection/646187f8e82183282d54656b209b488cfda179d49050f0410f55dbddc5950932" "q-86717/selection/7600f826341aff9ca964833d2dfb2466015112ef9e41cdaf608edf7415238fae" "q-86717/selection/17c124f1b3ef1647a9eb3e32e36e133739af5a9e4bc800680ba6fa18947c4e0d" "q-86717/selection/0e8c61e1cbe5b6d4b3e52c0431e48b853c5faa01ca7ca0f5f9cf780292b06b1f"] :db/ensure [:answer-field/validate]} {:db/id "q-86717" :question/id #uuid "ee17ab5b-237a-58f6-8970-437f09d6b03c" :question/math-academy-id "q-86717" :question/problem "Estimate ${e}^{(0.3)(2.15)}$ using a differential $\\text{d}f$ of the function $f(x,y)={e}^{xy}$ at the point $(0,2).$" :question/worked-solution "First, let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =y{e}^{xy}\\,\\text{d}x+x{e}^{xy}\\,\\text{d}y.\\end{aligned}\n$$\n\nAt the point $(0,2),$ the differential is\n\n$$\n\\begin{aligned}\\text{d}f(x,y) & =2\\cdot {e}^{0\\cdot 2}\\,\\text{d}x+0\\cdot {e}^{0\\cdot 2}\\,\\text{d}y \\\\  & =2\\,\\text{d}x+0\\,\\text{d}y.\\end{aligned}\n$$\n\nSo, if we move to the point $(0+Δx,2+Δy),$ then we can approximate the change in $f$ as\n\n$$\nΔf≈2\\,Δx+0\\,Δy.\n$$\n\nNote that \n\n$$\n{e}^{(0.3)(2.15)}=f(0.3,2.15),\n$$\n\nso we want to move to the point $(0.3,2.15).$\n\nMoving from $(0,2)$ to $(0.3,2.15),$ we have\n\n$$\n\\begin{aligned}Δx & =0.3-0=0.3, \\\\ Δy & =2.15-2=0.15.\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\begin{aligned}Δf & ≈2\\cdot (0.3)+0\\cdot (0.15) \\\\  & ≈0.6\\,.\\end{aligned}\n$$\n\nThis means that the value of $f$ increases by about $0.6.$ Consequently, we have\n\n$$\n\\begin{aligned}f(0.3,2.15) & ≈f(0,2)+0.6 \\\\ {e}^{(0.3)(2.15)} & ≈{e}^{(0)(2)}+0.6 \\\\  & ≈1+0.6 \\\\  & ≈1.6\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-86717/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "acafc931-a294-5ca7-8e39-cf8be29f08a9"] :knowledge-point/questions ["q-86717"] :db/ensure [:knowledge-point/validate]}]
