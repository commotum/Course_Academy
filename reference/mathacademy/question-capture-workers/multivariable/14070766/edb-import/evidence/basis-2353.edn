#{[{:db/id #edb/ref 17592186360021 :knowledge-point/_questions [{:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/title "Computing a Differential in a Geometrical Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4e61b44d-58e0-516a-a2bc-a2284544cb65" :answer/type {:db/ident :answer.type/math} :answer/value "18\\,\\text{d}a+24\\,\\text{d}b+48\\,\\text{d}c" :db/id #edb/ref 17592186360023} {:answer/id #uuid "20716d3e-0ced-5eab-9d0e-b667eebea912" :answer/type {:db/ident :answer.type/math} :answer/value "36\\,\\text{d}a+9\\,\\text{d}b+64\\,\\text{d}c" :db/id #edb/ref 17592186360024} {:answer/id #uuid "a184a913-10d6-5f55-95ec-dd7f374fb975" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\text{d}a+3\\,\\text{d}b+9\\,\\text{d}c" :db/id #edb/ref 17592186360025} {:answer/id #uuid "5f8972ae-ea1c-5dc7-ad48-4b78db87e0eb" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,\\text{d}a+48\\,\\text{d}b+18\\,\\text{d}c" :db/id #edb/ref 17592186360026} {:answer/id #uuid "1a310886-f1e9-5e21-a04b-93a3a8ae3261" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{d}a+24\\,\\text{d}b+9\\,\\text{d}c" :db/id #edb/ref 17592186360027}] :answer-field/correct {:answer/id #uuid "5f8972ae-ea1c-5dc7-ad48-4b78db87e0eb" :answer/type {:db/ident :answer.type/math} :answer/value "24\\,\\text{d}a+48\\,\\text{d}b+18\\,\\text{d}c" :db/id #edb/ref 17592186360026} :answer-field/id #uuid "4b3230ec-ebf2-5215-bc63-a70b60441691" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360022}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6d876ea7-17d5-5364-9fcb-920fe99b4035" :question/math-academy-id "q-168150" :question/problem "Given a rectangular solid, find the differential $\\text{d}V$ for the volume $V$ of the rectangular solid if the lengths of the sides are $a=6,$ $b=3,$ and $c=8.$" :question/worked-solution "The volume of the rectangular solid is $V=abc.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}V(a,b,c) & =(\\frac{∂V}{∂a})\\,\\text{d}a+(\\frac{∂V}{∂b})\\,\\text{d}b+(\\frac{∂V}{∂c})\\,\\text{d}c \\\\  & =bc\\,\\text{d}a+ac\\,\\text{d}b+ab\\,\\text{d}c\\end{aligned}\n$$\n\nFor $a=6,$ $b=3,$ and $c=8,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}V(6,3,8) & =3\\cdot 8\\,\\text{d}a+6\\cdot 8\\,\\text{d}b+6\\cdot 3\\,\\text{d}c \\\\  & =24\\,\\text{d}a+48\\,\\text{d}b+18\\,\\text{d}c.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360028 :knowledge-point/_questions [{:knowledge-point/id #uuid "153739f2-df62-5baf-8438-225edfc33ecb" :knowledge-point/title "Computing a Differential in a Geometrical Context"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "351992d8-41fe-538a-9781-dcf117b50700" :answer/type {:db/ident :answer.type/math} :answer/value "20\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186360030} {:answer/id #uuid "3369d40e-4399-5198-97d8-8cd519b4921c" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186360031} {:answer/id #uuid "93a00ec9-2d86-5eb1-a996-29be91c06c06" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+48\\,\\text{d}h" :db/id #edb/ref 17592186360032} {:answer/id #uuid "ab0c2010-0da2-583a-ada6-a19c9b2c7df3" :answer/type {:db/ident :answer.type/math} :answer/value "17\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186360033} {:answer/id #uuid "93538b5b-50bb-514c-abbb-408c2553ad94" :answer/type {:db/ident :answer.type/math} :answer/value "12\\,\\text{d}a+24\\,\\text{d}h" :db/id #edb/ref 17592186360034}] :answer-field/correct {:answer/id #uuid "3369d40e-4399-5198-97d8-8cd519b4921c" :answer/type {:db/ident :answer.type/math} :answer/value "40\\,\\text{d}a+12\\,\\text{d}h" :db/id #edb/ref 17592186360031} :answer-field/id #uuid "eefdb437-4504-5696-bcd2-5ec8f24fb252" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360029}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "53687acb-b08d-578e-a441-a512a9af4425" :question/math-academy-id "q-79747" :question/problem "Given a rectangular solid, find the differential $\\text{d}S$ for the surface area $S$ of the rectangular solid if the base is a square with the side of $a=3$ and the height is $h=7.$" :question/worked-solution "The surface area of the given rectangular solid is $S=2{a}^{2}+4ah.$ Let's find the differential:\n\n$$\n\\begin{aligned}\\text{d}S(a,h) & =(\\frac{∂S}{∂a})\\,\\text{d}a+(\\frac{∂S}{∂h})\\,\\text{d}h \\\\  & =(4a+4h)\\,\\text{d}a+4a\\,\\text{d}h\\end{aligned}\n$$\n\nFor $a=3$ and $h=7,$ the differential is\n\n$$\n\\begin{aligned}\\text{d}S(3,7) & =(4\\cdot 3+4\\cdot 7)\\,\\text{d}a+4\\cdot 3\\,\\text{d}h \\\\  & =40\\,\\text{d}a+12\\,\\text{d}h.\\end{aligned}\n$$"}]}
