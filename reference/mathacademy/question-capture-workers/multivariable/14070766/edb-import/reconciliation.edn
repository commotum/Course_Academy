ac{{y}^{4}\\,\\text{d}x}{x}+4{y}^{3}\\operatorname{ln}⁡x\\,\\text{d}y"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070766/state.json" "file_sha256" "7af1851ff8675258091660e791d82a5f42ca28beaefd7982cd290356b83c0571"} {"question" "q-79740" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{4{y}^{3}\\,\\text{d}x}{x}+12{y}^{2}\\operatorname{ln}⁡x\\,\\text{d}y"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070766/state.json" "file_sha256" "7af1851ff8675258091660e791d82a5f42ca28beaefd7982cd290356b83c0571"} {"question" "q-79739" "field" nil "attribute" "question/problem" "value" "Find the differential $\\text{d}f$ for the function $f(x,y)={x}^{2}+{x}^{3}y-{y}^{3}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070766/state.json" "file_sha256" "7af1851ff8675258091660e791d82a5f42ca28beaefd7982cd290356b83c0571"} {"question" "q-79739" "field" nil "attribute" "question/worked-solution" "value" "We compute the differential using the formula:\n\n$$\n\\begin{aligned}\\text{d}f(x,y,z) & =(\\frac{∂f}{∂x})\\,\\text{d}x+(\\frac{∂f}{∂y})\\,\\text{d}y \\\\  & =(2x+3{x}^{2}y)\\text{d}x+({x}^{3}-3{y}^{2})\\text{d}y\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070766/state.json" "file_sha256" "7af1851ff8675258091660e791d82a5f42ca28beaefd7982cd290356b83c0571"} {"question" "q-79739" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14070766/activity-metadata.json" "file_sha256" "881e5874e07ad3e6df6c7cdd1a13c6a42734a08a0d