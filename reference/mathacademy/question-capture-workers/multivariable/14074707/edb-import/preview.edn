x}(-x-2y) \\\\ \\frac{∂}{∂y}(3{x}^{2}-y) & \\frac{∂}{∂y}(-x-2y)\\end{aligned}] \\\\  & =[\\begin{aligned}6x & -1 \\\\ -1 & -2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{[\\begin{aligned}6x & -1 \\\\ -1 & -2\\end{aligned}]}_{{x}_{n}}^{-1}{[\\begin{aligned}3{x}^{2}-y \\\\ -x-2y\\end{aligned}]}_{{x}_{n}}.\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{[\\begin{aligned}6x & -1 \\\\ -1 & -2\\end{aligned}]}_{{x}_{1}}^{-1}{[\\begin{aligned}3{x}^{2}-y \\\\ -x-2y\\end{aligned}]}_{{x}_{1}} \\\\  & =[\\begin{aligned}0.96 \\\\ -0.48\\end{aligned}]-{[\\begin{aligned}6(0.96) & -1 \\\\ -1 & -2\\end{aligned}]}^{-1}[\\begin{aligned}3(0.96)^{2}-(-0.48) \\\\ -0.96-2(-0.48)\\end{aligned}] \\\\  & =[\\begin{aligned}0.96 \\\\ -0.48\\end{aligned}]-{[\\begin{aligned}5.76 & -1 \\\\ -1 & -2\\end{aligned}]}^{-1}[\\begin{aligned}3.2448 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0.96 \\\\ -0.48\\end{aligned}]-\\frac{1}{5.76\\cdot (-2)-(-1)\\cdot (-1)}[\\begin{aligned}-2 & 1 \\\\ 1 & 5.76\\end{aligned}][\\begin{aligned}3.2448 \\\\ 0\\end{aligned}] \\\\  & =[\\begin{aligned}0.96 \\\\ -0.48\\end{aligned}]+\\frac{1}{12.52}[\\begin{aligned}-6.4896 \\\\ 3.2448\\end{aligned}] \\\\  & ≈[\\begin{aligned}0.442 \\\\ -0.221\\end{aligned}].\\end{aligned}\n$$" 13194139536049 true] [17592186381038 1000 #edb/ref 17592186381039 13194139536049 true] [17592186381038 1040 #edb/ref 17592186045449 13194139536049 true] [17592186381038 1041 "field-1" 13194139536049 true] [17592186381038 1104 #edb/ref 17592186381039 13194139536049 true] [17592186381038 1110 #uuid "ef4c68ed-fd56-5ba1-8fcf-9b50a652c9ea" 13194139536049 true] [17592186381039 1034 "0.442" 13194139536049 true] [17592186381039 1103 #edb/ref 17592186045453 13194139536049 true] [17592186381039 1111 #uuid "b38d3c6b-7fdc-53d8-81d9-9cf38c92a875" 13194139536049 true] [17592186381040 1017 #edb/ref 17592186381041 13194139536049 true] [17592186381040 1017 #edb/ref 17