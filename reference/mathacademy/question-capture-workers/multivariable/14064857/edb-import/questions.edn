db/id #edb/ref 17592186168346} {:answer/id #uuid "4da2fd22-c932-5f1a-b059-95595bb2c20d" :answer/type {:db/ident :answer.type/math} :answer/value "2x + y - 2z =-4" :db/id #edb/ref 17592186168347} {:answer/id #uuid "51fcca6c-d922-5a02-891e-13caa013126d" :answer/type {:db/ident :answer.type/math} :answer/value "x + 2y = 8" :db/id #edb/ref 17592186168348}] :answer-field/correct {:answer/id #uuid "3112acf2-1315-543c-96f4-ee752b4221bb" :answer/type {:db/ident :answer.type/math} :answer/value "x + 4y - 4z =-8" :db/id #edb/ref 17592186168345} :answer-field/id #uuid "c1fbbf4d-3dc1-5890-801b-84dbbb44d799" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186168343}] :question/id #uuid "e5267351-988e-5a64-a5a4-1a3cc67629e8" :question/math-academy-id "q-109818" :question/problem "Find the equation of the tangent plane to the surface defined by the equations\n\n$x = u^{2}, y = v^{2}, z = u + 2v$\nat the point $(4, 1, 4)$."}] [{:db/id #edb/ref 17592186172191 :knowledge-point/_questions [{:knowledge-point/id #uuid "d12e0d62-7d0c-55d3-aaf4-d37fe5d691bf" :knowledge-point/title "Finding a Normal Vector to a Parametric Surface Given Some Parameter Values"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a933b2ee-7e20-5228-893c-08afc72ab3ce" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0, 2,-1⟩" :db/id #edb/ref 17592186168350} {:answer/id #uuid "fa83163b-860f-5da1-9709-f65b1e160bd2" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1, 2,-1⟩" :db/id #edb/ref 17592186168351} {:answer/id #uuid "fb08a828-3dc3-5cb8-85e0-0458f9278644" :answer/type {:db/ident :answer.type/math} :answer/value "⟨0,-1, 1⟩" :db/id #edb/ref 17592186168352} {:answer/id #uuid "67ab78d6-29a5-55cc-89f7-7ded0070166f" :answer/type {:db/ident :answer.type/math} :answer/value "⟨1,-1, 0⟩" :db/id #edb/ref 17592186168353} {:answer/id #uuid "6833020a-95a8-532f-9e3a-814fa49d54a7" :answer/type {:db/ident :answer.type/math} :answ