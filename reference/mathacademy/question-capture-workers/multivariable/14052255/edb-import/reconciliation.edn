in}⁡t \\\\ 8\\operatorname{cos}⁡t\\end{aligned}]\n$$\n\nTo calculate the outward-pointing normal vector of a closed, *negatively* oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${r}^{′}(t).$\n\nDifferentiating the expression for $r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =[\\begin{aligned}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{aligned}]=[\\begin{aligned}4\\operatorname{cos}⁡t \\\\ -8\\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented clockwise, we rotate ${r}^{′}(t)$ by ${90}^{∘}$ *counterclockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ counterclockwise rotation is\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nRotating the vector ${r}^{′}(t)$ by ${90}^{∘}$ counterclockwise, we get\n\n$$\n[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}4\\operatorname{cos}⁡t \\\\ -8\\operatorname{sin}⁡t\\end{aligned}]=[\\begin{aligned}8\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{aligned}].\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${r}^{′}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}[\\begin{aligned}8\\operatorname{sin}⁡t \\\\ 4\\operatorname{cos}⁡t\\end{aligned}]=\\frac{8\\operatorname{sin}⁡t\\,i+4\\operatorname{cos}⁡t\\,j}{||{r}^{′}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $a(t)=8\\operatorname{sin}⁡t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-126932" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/activity-metadata.json" "file_sha256" "37291c515bc5b75aae1626a4e626f7f836ecad8c363f734ea825e705772440e7"} {"question" "q-126932" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-126932" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-8\\operatorname{cos}⁡t"] ["math" "-8\\operatorname{sin}⁡t"] ["math" "4\\operatorname{cos}⁡t"] ["math" "4\\operatorname{sin}⁡t"] ["math" "8\\operatorname{sin}⁡t"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-126932" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8\\operatorname{sin}⁡t"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-149685" "field" nil "attribute" "question/problem" "value" "The closed curve $C$ is defined as $r(t)=5\\operatorname{sin}⁡t\\,i+3\\operatorname{cos}⁡t\\,j$ for $t\\in [0,2\\pi ).$ The outward-pointing unit normal vector for $C$ can be expressed as\n\n$$\nn=\\frac{a(t)\\,i+b(t)\\,j}{||{r}^{′}(t)||}.\n$$\n\nFind the function $a(t).$\n\n*Hint: Observe that $C$ is traversed clockwise.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-149685" "field" nil "attribute" "question/worked-solution" "value" "For convenience, we express $r(t)$ in column vector notation:\n\n$$\nr(t)=[\\begin{aligned}x(t) \\\\ y(t)\\end{aligned}]=[\\begin{aligned}5\\operatorname{sin}⁡t \\\\ 3\\operatorname{cos}⁡t\\end{aligned}]\n$$\n\nTo calculate the outward-pointing normal vector of a closed, *negatively* oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector ${r}^{′}(t).$\n\nDifferentiating the expression for $r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =[\\begin{aligned}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{aligned}]=[\\begin{aligned}5\\operatorname{cos}⁡t \\\\ -3\\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented clockwise, we rotate ${r}^{′}(t)$ by ${90}^{∘}$ *counterclockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a ${90}^{∘}$ counterclockwise rotation is\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nRotating the vector ${r}^{′}(t)$ by ${90}^{∘}$ counterclockwise, we get\n\n$$\n[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}5\\operatorname{cos}⁡t \\\\ -3\\operatorname{sin}⁡t\\end{aligned}]=[\\begin{aligned}3\\operatorname{sin}⁡t \\\\ 5\\operatorname{cos}⁡t\\end{aligned}].\n$$\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of ${r}^{′}(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}[\\begin{aligned}3\\operatorname{sin}⁡t \\\\ 5\\operatorname{cos}⁡t\\end{aligned}]=\\frac{3\\operatorname{sin}⁡t\\,i+5\\operatorname{cos}⁡t\\,j}{||{r}^{′}(t)||}.\\end{aligned}\n$$\n\nFinally, we conclude that $a(t)=3\\operatorname{sin}⁡t.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-149685" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/activity-metadata.json" "file_sha256" "37291c515bc5b75aae1626a4e626f7f836ecad8c363f734ea825e705772440e7"} {"question" "q-149685" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-149685" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-3\\operatorname{sin}⁡t"] ["math" "-5\\operatorname{cos}⁡t"] ["math" "3\\operatorname{cos}⁡t"] ["math" "3\\operatorname{sin}⁡t"] ["math" "5\\operatorname{cos}⁡t"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "q-149685" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\operatorname{sin}⁡t"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/state.json" "file_sha256" "5309709b1ea193a28f9093382172180b60526c0aaf567e20b12a422b0af2078f"} {"question" "e-9566" "field" nil "attribute" "question/problem" "value" "The closed curve $C$ is defined as $x^2+y^2 = 2.$ Find the outward-pointing unit normal vector on $C.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/example-9566.json" "file_sha256" "1b5ab5bc5f4f70f35bb11ba9c82b6db450993a5a842532a77ef65c97e6a2f926"} {"question" "e-9566" "field" nil "attribute" "question/worked-solution" "value" "We can parameterize $C$ as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/assets/0c0a4b177a997ffb38489abc902a1c78d027d0da661b1498fc97d3d9a77862d9.png)\n\nTo calculate the outward-pointing normal vector of a closed, positively oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector $\\mathbf r'(t).$\n\nDifferentiating the expression for $\\mathbf r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =[\\begin{aligned}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{aligned}]=[\\begin{aligned}-\\sqrt{2}\\operatorname{sin}⁡t \\\\ \\sqrt{2}\\operatorname{cos}⁡t\\end{aligned}].\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented counterclockwise, we rotate $\\mathbf r'(t)$ by $90^\\circ$ *clockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a $90^\\circ$ clockwise rotation is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/assets/0cd188ffe544d454a3375df5f043096888f6dfd5243551d35502efda4bcfeb11.png)\n\nRotating the vector $\\mathbf r'(t)$ by $90^\\circ$ clockwise, we get\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/assets/5f0d414a5388ae374f46f75825b9ffec7725649a97a45de24f8178d95a94b1ad.png)\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of $\\mathbf r'(t)$ (since they differ only by a rotation).\n\nNow, since \n\n$$\n||\\mathbf r'(t)|| = \\sqrt{(-\\sqrt{2}\\sin t)^2 + (\\sqrt{2}\\cos t)^2} = \\sqrt{2},\n$$\n\nand since for our curve $x(t) = \\sqrt{2}\\cos{t}$ and $y(t) = \\sqrt{2}\\sin{t},$ it follows that\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}[\\begin{aligned}\\sqrt{2}\\operatorname{cos}⁡t \\\\ \\sqrt{2}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}\\sqrt{2}\\operatorname{cos}⁡t \\\\ \\sqrt{2}\\operatorname{sin}⁡t\\end{aligned}] \\\\  & =\\frac{1}{\\sqrt{2}}[\\begin{aligned}x \\\\ y\\end{aligned}].\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/example-9566.json" "file_sha256" "1b5ab5bc5f4f70f35bb11ba9c82b6db450993a5a842532a77ef65c97e6a2f926"} {"question" "e-9571" "field" nil "attribute" "question/problem" "value" "The closed curve $C$ is defined as $\\mathbf r(t) =  12\\sin t\\,\\mathbf{i} + 9\\cos t \\,\\mathbf{j}$ for $t \\in [0,2\\pi).$ Find the outward-pointing unit normal vector on $C.$\n\n*Hint: Observe that $C$ is traversed clockwise.*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/example-9571.json" "file_sha256" "c214c3f168aaf35d5f47cd2359eb7bc3d8470a57c267e9844ac6f2fbc6c583a8"} {"question" "e-9571" "field" nil "attribute" "question/worked-solution" "value" "For convenience, we express $\\mathbf r(t)$ in column vector notation:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/assets/007f19fb0c6e24115d719178a4b44e78c9881b9f71f52d0f2970480358e3faab.png)\n\nTo calculate the outward-pointing normal vector of a closed, *negatively* oriented curve, we follow three steps:\n\n**Step 1**: We compute the tangent vector $\\mathbf r'(t).$\n\nDifferentiating the expression for $\\mathbf r(t),$ we get\n\n$$\n\\begin{aligned}{r}^{′}(t) & =[\\begin{aligned}{x}^{′}(t) \\\\ {y}^{′}(t)\\end{aligned}]=[\\begin{aligned}12\\operatorname{cos}⁡t \\\\ -9\\operatorname{sin}⁡t\\end{aligned}].\\end{aligned}\n$$\n\n**Step 2**: Since $C$ is oriented clockwise, we rotate $\\mathbf r'(t)$ by $90^\\circ$ *counterclockwise* to obtain an outward-pointing normal vector.\n\nThe rotation matrix that corresponds to a $90^\\circ$ counterclockwise rotation is\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/assets/ec0ddbbff34ed096bb872f23663f97005932a4ea8f368059cc4b511a5c9c76cc.png)\n\nRotating the vector $\\mathbf r'(t)$ by $90^\\circ$ counterclockwise, we get\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/assets/6f74bda044d15ed504a0b95b1e60ae8542f2b304f1e2712ae8a1d840a45aeaad.png)\n\n**Step 3**: Finally, we normalize the vector found in step 2.\n\nNote that the magnitude of the vector found in step 2 equals the magnitude of $\\mathbf r'(t)$ (since they differ only by a rotation). Therefore,\n\n$$\n\\begin{aligned}n & =\\frac{1}{||{r}^{′}(t)||}[\\begin{aligned}9\\operatorname{sin}⁡t \\\\ 12\\operatorname{cos}⁡t\\end{aligned}]=\\frac{9\\operatorname{sin}⁡t\\,i+12\\operatorname{cos}⁡t\\,j}{\\sqrt{144{cos}^{2}⁡t+81{sin}^{2}⁡t}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/example-9571.json" "file_sha256" "c214c3f168aaf35d5f47cd2359eb7bc3d8470a57c267e9844ac6f2fbc6c583a8"} {"question" "q-126830" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{3}[\\begin{aligned}x \\\\ y\\end{aligned}]"] "category" "reviewed_ma_solution" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14052255/answer-source-reviews.json" "file_sha256" "a98156e0868ff40599b9580989232ebd494608651a78677913416ad3df21ffd7" "reviewer_session" "01a11908-fa8d-7c61-8e03-c1185d0b9506" "rationale" "On x²+y²=9, the radial vector (x,y) points outward and has length 3. Dividing by 3 therefore gives the outward unit normal (x/3,y/3), original option a. The authentic worked solution confirms this result, and the stored bmatrix expression has identi