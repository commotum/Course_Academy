=1}^{25}1 \\\\  & =200+175-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) \\\\  & =375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1).\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) & =375-(10\\cdot 25) \\\\  & =375-250 \\\\  & =125.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1)=125.\n$$" 13194139536087 true] [17592186383056 1000 #edb/ref 17592186383057 13194139536087 true] [17592186383056 1000 #edb/ref 17592186383058 13194139536087 true] [17592186383056 1000 #edb/ref 17592186383059 13194139536087 true] [17592186383056 1000 #edb/ref 17592186383060 13194139536087 true] [17592186383056 1000 #edb/ref 17592186383061 13194139536087 true] [17592186383056 1040 #edb/ref 17592186045450 13194139536087 true] [17592186383056 1041 "selection" 13194139536087 true] [17592186383056 1104 #edb/ref 17592186383060 13194139536087 true] [17592186383056 1110 #uuid "2c6f87ea-90fb-5709-bd6b-aaaf1bf480a8" 13194139536087 true] [17592186383057 1034 "130" 13194139536087 true] [17592186383057 1103 #edb/ref 17592186045453 13194139536087 true] [17592186383057 1111 #uuid "5dd46a14-ad3f-5e8e-813a-298a0f55b40f" 13194139536087 true] [17592186383058 1034 "145" 13194139536087 true] [17592186383058 1103 #edb/ref 17592186045453 13194139536087 true] [17592186383058 1111 #uuid "9e021bea-7591-5d96-94ae-fb1816ae100a" 13194139536087 true] [17592186383059 1034 "120" 13194139536087 true] [17592186383059 1103 #edb/ref 17592186045453 13194139536087 true] [17592186383059 1111 #uuid "6d3cd9c4-164a-591f-a734-9235d2cdec00" 13194139536087 true] [17592186383060 1034 "125" 13194139536087 true] [17592186383060 1103 #edb/ref 17592186045453 13194139536087 true] [17592186383060 1111 #uuid "de44cc68-9f64-54bb-9417-19eded577111" 13194139536087 true] [17592186383061 1034 "135" 13194139536087 true] [17592186383061 1103 #edb/ref 17592186045453 13194139536087 true] [17592186383061 1111 #uuid "85483485-5864-5430-89e0-22c19deb4d2e" 13194139536087 true] [17592186383062 1017 #edb/ref 17592186383063 13194139536087 true] [17592186383062 1089 "q-149675" 13194139536087 true] [17592186383062 1091 #edb/ref 17592186045465 13194139536087 true] [17592186383062 1100 "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}=25,\\,{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij}=20.\n$$" 13194139536087 true] [17592186383062 1113 #uuid "7cd315f2-f1e8-5b9b-9b4d-17e2cab7415d" 13194139536087 true] [17592186383062 1145 "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij}) & ={\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}2{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+2{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+25+40 \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65.\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65 & =8\\cdot 10+65 \\\\  & =80+65 \\\\  & =145.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})=145.\n$$" 13194139536087 true] [17592186383063 1000 #edb/ref 17592186383064 13194139536087 true] [1