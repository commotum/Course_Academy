[{:db/id [:question/math-academy-id "q-149622"] :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{30}2{a}_{i}({b}_{j}-2)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{30}{a}_{i}=42,\\,{\\sum }_{j=1}^{30}{b}_{j}=70.\n$$" :question/worked-solution "The product rule for double summations states that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{i}{b}_{j}={\\sum }_{i=1}^{m}{a}_{i}{\\sum }_{j=1}^{n}{b}_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{30}2{a}_{i}({b}_{j}-2) & ={\\sum }_{i=1}^{30}2{a}_{i}{\\sum }_{j=1}^{30}({b}_{j}-2).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{30}2{a}_{i}{\\sum }_{j=1}^{30}({b}_{j}-2) & =(2{\\sum }_{i=1}^{30}{a}_{i})\\cdot ({\\sum }_{j=1}^{30}{b}_{j}-{\\sum }_{j=1}^{30}2) \\\\  & =(2{\\sum }_{i=1}^{30}{a}_{i})\\cdot ({\\sum }_{j=1}^{30}{b}_{j}-2{\\sum }_{j=1}^{30}1) \\\\  & =(2\\cdot 42)\\cdot (70-2\\cdot 30) \\\\  & =(84)\\cdot (70-60) \\\\  & =(84)\\cdot (10) \\\\  & =840\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-149667/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" :answer/id #uuid "6c95a140-bbbd-5ee9-bc29-08a0c0d14f6f" :answer/type :answer.type/math :answer/value "70" :db/ensure [:answer/validate]} {:db/id "q-149667/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" :answer/id #uuid "3d855abb-44b5-5cbb-b2ca-9ae196f749a3" :answer/type :answer.type/math :answer/value "60" :db/ensure [:answer/validate]} {:db/id "q-149667/selection/a2ce0d7121680ad5ca64b109a32cd456c311ade4af21eb0a0dd652e8319117f1" :answer/id #uuid "8b2f8cd6-98bd-50d9-b0fc-2f664a92bbee" :answer/type :answer.type/math :answer/value "80" :db/ensure [:answer/validate]} {:db/id "q-149667/selection/eb57fb392c21478621c4c209554229c785123f38918aca582a228a144fdce87a" :answer/id #uuid "f9ab9af5-1b5b-5fe4-b220-dbd0e5f6ceb9" :answer/type :answer.type/math :answer/value "75" :db/ensure [:answer/validate]} {:db/id "q-149667/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491" :answer/id #uuid "d0c86596-c96b-52c7-96f3-0fb91bfc1c70" :answer/type :answer.type/math :answer/value "65" :db/ensure [:answer/validate]} {:db/id "q-149667/selection" :answer-field/id #uuid "63b3b809-bb0e-57d9-b036-32653ccb2067" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149667/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" :answer-field/choices ["q-149667/selection/0086db6077a62a5e2d9c771f7cdf57bea92b1de496b4d9b1d9c50dc1e5b58991" "q-149667/selection/23a7b929cccc5bdeb88db3bdc770afbaf59570d63e930fc5c94f26cb6f5091dc" "q-149667/selection/a2ce0d7121680ad5ca64b109a32cd456c311ade4af21eb0a0dd652e8319117f1" "q-149667/selection/eb57fb392c21478621c4c209554229c785123f38918aca582a228a144fdce87a" "q-149667/selection/8cd557fa143c2616f01a8df1d19e854fea26be776628dc106639661d1b774491"] :db/ensure [:answer-field/validate]} {:db/id "q-149667" :question/id #uuid "68736947-77b6-5f6a-9fd0-b3e7519c62df" :question/math-academy-id "q-149667" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}(2{a}_{ij}-{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{a}_{ij}=75,\\,{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{b}_{ij}=80.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying these rules to the given sum, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}(2{a}_{ij}-{b}_{ij}) & ={\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}2{a}_{ij}-{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =2{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{a}_{ij}-{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =2\\cdot 75-80 \\\\  & =150-80 \\\\  & =70.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-149667/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd"] :knowledge-point/questions ["q-149667"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149670/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "6d3cd9c4-164a-591f-a734-9235d2cdec00" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-149670/selection/c89a78e01f135d27857f87b29786d3bde75753fd31e9ec00c0c39b58d64c0b12" :answer/id #uuid "85483485-5864-5430-89e0-22c19deb4d2e" :answer/type :answer.type/math :answer/value "135" :db/ensure [:answer/validate]} {:db/id "q-149670/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" :answer/id #uuid "5dd46a14-ad3f-5e8e-813a-298a0f55b40f" :answer/type :answer.type/math :answer/value "130" :db/ensure [:answer/validate]} {:db/id "q-149670/selection/39a5ce6df648355b801d1b8ecb4c5f4f609af8f07bae4fac68affda9cbedd111" :answer/id #uuid "9e021bea-7591-5d96-94ae-fb1816ae100a" :answer/type :answer.type/math :answer/value "145" :db/ensure [:answer/validate]} {:db/id "q-149670/selection/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1" :answer/id #uuid "de44cc68-9f64-54bb-9417-19eded577111" :answer/type :answer.type/math :answer/value "125" :db/ensure [:answer/validate]} {:db/id "q-149670/selection" :answer-field/id #uuid "2c6f87ea-90fb-5709-bd6b-aaaf1bf480a8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149670/selection/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1" :answer-field/choices ["q-149670/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" "q-149670/selection/c89a78e01f135d27857f87b29786d3bde75753fd31e9ec00c0c39b58d64c0b12" "q-149670/selection/2ade7e42ed5e1f710ced0261dbad39b301e64d58630a4f94002fb6ae3c8a9f3b" "q-149670/selection/39a5ce6df648355b801d1b8ecb4c5f4f609af8f07bae4fac68affda9cbedd111" "q-149670/selection/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1"] :db/ensure [:answer-field/validate]} {:db/id "q-149670" :question/id #uuid "e1385b21-f74b-55cc-9d8c-709c13a3ae88" :question/math-academy-id "q-149670" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{a}_{ij}=200,\\,{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{b}_{ij}=175.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1) & ={\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{a}_{ij}+{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{b}_{ij}-{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1 \\\\  & =200+175-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) \\\\  & =375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1).\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) & =375-(10\\cdot 25) \\\\  & =375-250 \\\\  & =125.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1)=125.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-149670/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd"] :knowledge-point/questions ["q-149670"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149675/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" :answer/id #uuid "592793a2-7287-5c0d-98b2-7e478c526f94" :answer/type :answer.type/math :answer/value "120" :db/ensure [:answer/validate]} {:db/id "q-149675/selection/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1" :answer/id #uuid "d47d7ad0-3d72-555d-b130-7005f2074379" :answer/type :answer.type/math :answer/value "125" :db/ensure [:answer/validate]} {:db/id "q-149675/selection/42aff35720b567089407a2a0cf7c70ff6334c9493e4d877ecdcdfa86adae004c" :answer/id #uuid "fa70a9b4-996d-5468-86ab-81610f3a6180" :answer/type :answer.type/math :answer/value "150" :db/ensure [:answer/validate]} {:db/id "q-149675/selection/c89a78e01f135d27857f87b29786d3bde75753fd31e9ec00c0c39b58d64c0b12" :answer/id #uuid "95e5e132-9de1-5d43-8236-d03da781dbc5" :answer/type :answer.type/math :answer/value "135" :db/ensure [:answer/validate]} {:db/id "q-149675/selection/39a5ce6df648355b801d1b8ecb4c5f4f609af8f07bae4fac68affda9cbedd111" :answer/id #uuid "de16b034-9d7d-5076-9919-66840c465854" :answer/type :answer.type/math :answer/value "145" :db/ensure [:answer/validate]} {:db/id "q-149675/selection" :answer-field/id #uuid "4871236c-a08a-5387-b594-02ae9ed8a8c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149675/selection/39a5ce6df648355b801d1b8ecb4c5f4f609af8f07bae4fac68affda9cbedd111" :answer-field/choices ["q-149675/selection/a59e10e9ca0b8a69d2b8425f1c9930ee0733ea061a1d6430398562813d750649" "q-149675/selection/ae88b0e4e39efaf2d30ebd55cc98cb3ed5733c3f224b932ff48a4224b22ca5a1" "q-149675/selection/42aff35720b567089407a2a0cf7c70ff6334c9493e4d877ecdcdfa86adae004c" "q-149675/selection/c89a78e01f135d27857f87b29786d3bde75753fd31e9ec00c0c39b58d64c0b12" "q-149675/selection/39a5ce6df648355b801d1b8ecb4c5f4f609af8f07bae4fac68affda9cbedd111"] :db/ensure [:answer-field/validate]} {:db/id "q-149675" :question/id #uuid "7cd315f2-f1e8-5b9b-9b4d-17e2cab7415d" :question/math-academy-id "q-149675" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}=25,\\,{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij}=20.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij}) & ={\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}2{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+2{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+25+40 \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65.\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65 & =8\\cdot 10+65 \\\\  & =80+65 \\\\  & =145.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})=145.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-149675/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd"] :knowledge-point/questions ["q-149675"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149678/selection/478fd1e25e3e34a29fea1c3ec66147c061ba20da2ebcc365831518058573cd79" :answer/id #uuid "f9af8000-1cae-56e5-9008-4aac14bdd37b" :answer/type :answer.type/math :answer/value "500" :db/ensure [:answer/validate]} {:db/id "q-149678/selection/c5b7aea79f73ebc562cbcff24725697bdc076b45efa2d86abecbb1b4fa682579" :answer/id #uuid "7c276c9d-46e7-5d80-8a2e-84511d00fe5f" :answer/type :answer.type/math :answer/value "600" :db/ensure [:answer/validate]} {:db/id "q-149678/selection/2ae91f4acef1e258303c5198524ee0c09d54456f734e655864530e0fc07a0a9d" :answer/id #uuid "fbfd8841-b20f-543a-a06f-a1c49710e0e8" :answer/type :answer.type/math :answer/value "700" :db/ensure [:answer/validate]} {:db/id "q-149678/selection/176ce96a130f432c9d77726b4cdaccf1ca6ddba8dd0e5e3773d86d5d0aea4a18" :answer/id #uuid "af691731-3473-5da2-bafc-ea35e67e03e8" :answer/type :answer.type/math :answer/value "800" :db/ensure [:answer/validate]} {:db/id "q-149678/selection/9ff8157b20b64a245202d0cf913e4397546006c7c38b2b70bb634b860aa35720" :answer/id #uuid "dc62a4c1-2a7f-58b3-9b1c-d8d0d0a921ef" :answer/type :answer.type/math :answer/value "400" :db/ensure [:answer/validate]} {:db/id "q-149678/selection" :answer-field/id #uuid "7c70c7b8-bfe4-57b2-8a6c-c6884b9d1f3b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149678/selection/2ae91f4acef1e258303c5198524ee0c09d54456f734e655864530e0fc07a0a9d" :answer-field/choices ["q-149678/selection/478fd1e25e3e34a29fea1c3ec66147c061ba20da2ebcc365831518058573cd79" "q-149678/selection/c5b7aea79f73ebc562cbcff24725697bdc076b45efa2d86abecbb1b4fa682579" "q-149678/selection/2ae91f4acef1e258303c5198524ee0c09d54456f734e655864530e0fc07a0a9d" "q-149678/selection/176ce96a130f432c9d77726b4cdaccf1ca6ddba8dd0e5e3773d86d5d0aea4a18" "q-149678/selection/9ff8157b20b64a245202d0cf913e4397546006c7c38b2b70bb634b860aa35720"] :db/ensure [:answer-field/validate]} {:db/id "q-149678" :question/id #uuid "1daf1fe7-7f9b-57df-8064-355cc4b0ce67" :question/math-academy-id "q-149678" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{10}({a}_{i}+1)({b}_{j}+1)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{15}{a}_{i}=20,\\,{\\sum }_{j=1}^{10}{b}_{j}=10.\n$$" :question/worked-solution "The product rule for double summations states that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{i}{b}_{j}={\\sum }_{i=1}^{m}{a}_{i}{\\sum }_{j=1}^{n}{b}_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{10}({a}_{i}+1)({b}_{j}+1) & ={\\sum }_{i=1}^{15}({a}_{i}+1){\\sum }_{j=1}^{10}({b}_{j}+1).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{15}({a}_{i}+1){\\sum }_{j=1}^{10}({b}_{j}+1) & =({\\sum }_{i=1}^{15}{a}_{i}+{\\sum }_{i=1}^{15}1)\\cdot ({\\sum }_{j=1}^{10}{b}_{j}+{\\sum }_{j=1}^{10}1) \\\\  & =(20+15)\\cdot (10+10) \\\\  & =(35)\\cdot (20) \\\\  & =700.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-149678/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "08375770-c610-5dae-b01b-c457de086cba"] :knowledge-point/questions ["q-149678"] :db/ensure [:knowledge-point/validate]}]
