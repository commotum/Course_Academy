#{[{:db/id #edb/ref 17592186129437 :knowledge-point/_questions [{:knowledge-point/id #uuid "08375770-c610-5dae-b01b-c457de086cba" :knowledge-point/title "Applying the Product Rule and Swap Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf99c040-5fb8-5dec-a50a-5f49c821eed4" :answer/type {:db/ident :answer.type/math} :answer/value "760" :db/id #edb/ref 17592186126429} {:answer/id #uuid "eddfe5d5-c7a2-5e3e-a69b-e13d0c3bd308" :answer/type {:db/ident :answer.type/math} :answer/value "960" :db/id #edb/ref 17592186126430} {:answer/id #uuid "3fe2e63e-6416-5ae3-9f49-6a0d0e61ea95" :answer/type {:db/ident :answer.type/math} :answer/value "480" :db/id #edb/ref 17592186126431} {:answer/id #uuid "510b3d7c-96de-5ad6-ad65-b124fb0bf61a" :answer/type {:db/ident :answer.type/math} :answer/value "320" :db/id #edb/ref 17592186126432} {:answer/id #uuid "6ccfffbd-56b7-5b58-8d34-22173831bafa" :answer/type {:db/ident :answer.type/math} :answer/value "840" :db/id #edb/ref 17592186126433}] :answer-field/correct {:answer/id #uuid "6ccfffbd-56b7-5b58-8d34-22173831bafa" :answer/type {:db/ident :answer.type/math} :answer/value "840" :db/id #edb/ref 17592186126433} :answer-field/id #uuid "c071d619-a19d-5ffd-8b95-1d0654bc33f8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126428}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ac86e0d0-2b0f-5eec-b86a-0ddc34876546" :question/math-academy-id "q-149622" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{30}2{a}_{i}({b}_{j}-2)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{30}{a}_{i}=42,\\,{\\sum }_{j=1}^{30}{b}_{j}=70.\n$$" :question/requires-calculator true :question/worked-solution "The product rule for double summations states that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{i}{b}_{j}={\\sum }_{i=1}^{m}{a}_{i}{\\sum }_{j=1}^{n}{b}_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{30}2{a}_{i}({b}_{j}-2) & ={\\sum }_{i=1}^{30}2{a}_{i}{\\sum }_{j=1}^{30}({b}_{j}-2).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{30}2{a}_{i}{\\sum }_{j=1}^{30}({b}_{j}-2) & =(2{\\sum }_{i=1}^{30}{a}_{i})\\cdot ({\\sum }_{j=1}^{30}{b}_{j}-{\\sum }_{j=1}^{30}2) \\\\  & =(2{\\sum }_{i=1}^{30}{a}_{i})\\cdot ({\\sum }_{j=1}^{30}{b}_{j}-2{\\sum }_{j=1}^{30}1) \\\\  & =(2\\cdot 42)\\cdot (70-2\\cdot 30) \\\\  & =(84)\\cdot (70-60) \\\\  & =(84)\\cdot (10) \\\\  & =840\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383048 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd" :knowledge-point/title "Applying the Sum and Constant Multiple Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6c95a140-bbbd-5ee9-bc29-08a0c0d14f6f" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186383050} {:answer/id #uuid "3d855abb-44b5-5cbb-b2ca-9ae196f749a3" :answer/type {:db/ident :answer.type/math} :answer/value "60" :db/id #edb/ref 17592186383051} {:answer/id #uuid "d0c86596-c96b-52c7-96f3-0fb91bfc1c70" :answer/type {:db/ident :answer.type/math} :answer/value "65" :db/id #edb/ref 17592186383052} {:answer/id #uuid "8b2f8cd6-98bd-50d9-b0fc-2f664a92bbee" :answer/type {:db/ident :answer.type/math} :answer/value "80" :db/id #edb/ref 17592186383053} {:answer/id #uuid "f9ab9af5-1b5b-5fe4-b220-dbd0e5f6ceb9" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186383054}] :answer-field/correct {:answer/id #uuid "6c95a140-bbbd-5ee9-bc29-08a0c0d14f6f" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186383050} :answer-field/id #uuid "63b3b809-bb0e-57d9-b036-32653ccb2067" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383049}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "68736947-77b6-5f6a-9fd0-b3e7519c62df" :question/math-academy-id "q-149667" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}(2{a}_{ij}-{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{a}_{ij}=75,\\,{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{b}_{ij}=80.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying these rules to the given sum, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}(2{a}_{ij}-{b}_{ij}) & ={\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}2{a}_{ij}-{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =2{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{a}_{ij}-{\\sum }_{i=1}^{30}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =2\\cdot 75-80 \\\\  & =150-80 \\\\  & =70.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186383055 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd" :knowledge-point/title "Applying the Sum and Constant Multiple Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5dd46a14-ad3f-5e8e-813a-298a0f55b40f" :answer/type {:db/ident :answer.type/math} :answer/value "130" :db/id #edb/ref 17592186383057} {:answer/id #uuid "9e021bea-7591-5d96-94ae-fb1816ae100a" :answer/type {:db/ident :answer.type/math} :answer/value "145" :db/id #edb/ref 17592186383058} {:answer/id #uuid "6d3cd9c4-164a-591f-a734-9235d2cdec00" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186383059} {:answer/id #uuid "de44cc68-9f64-54bb-9417-19eded577111" :answer/type {:db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186383060} {:answer/id #uuid "85483485-5864-5430-89e0-22c19deb4d2e" :answer/type {:db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186383061}] :answer-field/correct {:answer/id #uuid "de44cc68-9f64-54bb-9417-19eded577111" :answer/type {:db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186383060} :answer-field/id #uuid "2c6f87ea-90fb-5709-bd6b-aaaf1bf480a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383056}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e1385b21-f74b-55cc-9d8c-709c13a3ae88" :question/math-academy-id "q-149670" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{a}_{ij}=200,\\,{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{b}_{ij}=175.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1) & ={\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{a}_{ij}+{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}{b}_{ij}-{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1 \\\\  & =200+175-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) \\\\  & =375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1).\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}375-({\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}1) & =375-(10\\cdot 25) \\\\  & =375-250 \\\\  & =125.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{10}{\\sum }_{j=1}^{25}({a}_{ij}+{b}_{ij}-1)=125.\n$$"}] [{:db/id #edb/ref 17592186383062 :knowledge-point/_questions [{:knowledge-point/id #uuid "f4312c28-e298-5185-9009-e6ca243175fd" :knowledge-point/title "Applying the Sum and Constant Multiple Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de16b034-9d7d-5076-9919-66840c465854" :answer/type {:db/ident :answer.type/math} :answer/value "145" :db/id #edb/ref 17592186383064} {:answer/id #uuid "fa70a9b4-996d-5468-86ab-81610f3a6180" :answer/type {:db/ident :answer.type/math} :answer/value "150" :db/id #edb/ref 17592186383065} {:answer/id #uuid "592793a2-7287-5c0d-98b2-7e478c526f94" :answer/type {:db/ident :answer.type/math} :answer/value "120" :db/id #edb/ref 17592186383066} {:answer/id #uuid "d47d7ad0-3d72-555d-b130-7005f2074379" :answer/type {:db/ident :answer.type/math} :answer/value "125" :db/id #edb/ref 17592186383067} {:answer/id #uuid "95e5e132-9de1-5d43-8236-d03da781dbc5" :answer/type {:db/ident :answer.type/math} :answer/value "135" :db/id #edb/ref 17592186383068}] :answer-field/correct {:answer/id #uuid "de16b034-9d7d-5076-9919-66840c465854" :answer/type {:db/ident :answer.type/math} :answer/value "145" :db/id #edb/ref 17592186383064} :answer-field/id #uuid "4871236c-a08a-5387-b594-02ae9ed8a8c3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383063}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7cd315f2-f1e8-5b9b-9b4d-17e2cab7415d" :question/math-academy-id "q-149675" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}=25,\\,{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij}=20.\n$$" :question/worked-solution "The sum and constant multiple rules for double summations state that\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({a}_{ij}+{b}_{ij}) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}+{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{b}_{ij}, \\\\ {\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}k{a}_{ij} & =k{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{ij}.\\end{aligned}\n$$\n\nApplying the sum rule to the given double summation, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij}) & ={\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}2{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{a}_{ij}+2{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}{b}_{ij} \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+25+40 \\\\  & =({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65.\\end{aligned}\n$$\n\nNow, using the fact that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}1=mn,\n$$\n\nwe have\n\n$$\n\\begin{aligned}({\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}1)+65 & =8\\cdot 10+65 \\\\  & =80+65 \\\\  & =145.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n{\\sum }_{i=1}^{8}{\\sum }_{j=1}^{10}(1+{a}_{ij}+2{b}_{ij})=145.\n$$"}] [{:db/id #edb/ref 17592186383069 :knowledge-point/_questions [{:knowledge-point/id #uuid "08375770-c610-5dae-b01b-c457de086cba" :knowledge-point/title "Applying the Product Rule and Swap Rules"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "af691731-3473-5da2-bafc-ea35e67e03e8" :answer/type {:db/ident :answer.type/math} :answer/value "800" :db/id #edb/ref 17592186383071} {:answer/id #uuid "fbfd8841-b20f-543a-a06f-a1c49710e0e8" :answer/type {:db/ident :answer.type/math} :answer/value "700" :db/id #edb/ref 17592186383072} {:answer/id #uuid "f9af8000-1cae-56e5-9008-4aac14bdd37b" :answer/type {:db/ident :answer.type/math} :answer/value "500" :db/id #edb/ref 17592186383073} {:answer/id #uuid "dc62a4c1-2a7f-58b3-9b1c-d8d0d0a921ef" :answer/type {:db/ident :answer.type/math} :answer/value "400" :db/id #edb/ref 17592186383074} {:answer/id #uuid "7c276c9d-46e7-5d80-8a2e-84511d00fe5f" :answer/type {:db/ident :answer.type/math} :answer/value "600" :db/id #edb/ref 17592186383075}] :answer-field/correct {:answer/id #uuid "fbfd8841-b20f-543a-a06f-a1c49710e0e8" :answer/type {:db/ident :answer.type/math} :answer/value "700" :db/id #edb/ref 17592186383072} :answer-field/id #uuid "7c70c7b8-bfe4-57b2-8a6c-c6884b9d1f3b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186383070}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1daf1fe7-7f9b-57df-8064-355cc4b0ce67" :question/math-academy-id "q-149678" :question/problem "Find the value of the double sum\n\n$$\n{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{10}({a}_{i}+1)({b}_{j}+1)\n$$\n\ngiven that\n\n$$\n{\\sum }_{i=1}^{15}{a}_{i}=20,\\,{\\sum }_{j=1}^{10}{b}_{j}=10.\n$$" :question/worked-solution "The product rule for double summations states that\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}{a}_{i}{b}_{j}={\\sum }_{i=1}^{m}{a}_{i}{\\sum }_{j=1}^{n}{b}_{j}.\n$$\n\nSo, using the product rule for double summations, we get\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{15}{\\sum }_{j=1}^{10}({a}_{i}+1)({b}_{j}+1) & ={\\sum }_{i=1}^{15}({a}_{i}+1){\\sum }_{j=1}^{10}({b}_{j}+1).\\end{aligned}\n$$\n\nNow, using the rules for single summations, we obtain\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{15}({a}_{i}+1){\\sum }_{j=1}^{10}({b}_{j}+1) & =({\\sum }_{i=1}^{15}{a}_{i}+{\\sum }_{i=1}^{15}1)\\cdot ({\\sum }_{j=1}^{10}{b}_{j}+{\\sum }_{j=1}^{10}1) \\\\  & =(20+15)\\cdot (10+10) \\\\  & =(35)\\cdot (20) \\\\  & =700.\\end{aligned}\n$$"}]}
