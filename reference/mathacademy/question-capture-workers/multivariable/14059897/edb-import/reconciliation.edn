897/state.json" "file_sha256" "b17ac954cae06bb27e717726d39daf0dfb673322cc32aedb2cdbf4cacbf000d8"} {"question" "q-124325" "field" nil "attribute" "question/worked-solution" "value" "The line integral of unity with respect to $x$ along a path $C$ is equal to the net change in $x$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1},\n$$\n\nwhere ${x}_{2}$ is the $x$-coordinate of the terminal point, and ${x}_{1}$ is the $x$-coordinate of the initial point.\n\nIn our case, ${x}_{2}=-3$ and ${x}_{1}=7.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}x={x}_{2}-{x}_{1}=(-3)-7=-10.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/state.json" "file_sha256" "b17ac954cae06bb27e717726d39daf0dfb673322cc32aedb2cdbf4cacbf000d8"} {"question" "q-124325" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/activity-metadata.json" "file_sha256" "8bc6f9dbda7d7db45fc648bd526ec9f400f366d03fe9b9c0445eed2bf9de20ad"} {"question" "q-124325" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/state.json" "file_sha256" "b17ac954cae06bb27e717726d39daf0dfb673322cc32aedb2cdbf4cacbf000d8"} {"question" "q-124325" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-10"] ["math" "-4\\pi -2"] ["math" "-8"] ["math" "10"] ["math" "4\\pi +2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/state.json" "file_sha256" "b17ac954cae06bb27e717726d39daf0dfb673322cc32aedb2cdbf4cacbf000d8"} {"question" "q-124325" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/state.json" "file_sha256" "b17ac954cae06bb27e717726d39daf0dfb673322cc32aedb2cdbf4cacbf000d8"} {"question" "q-124347" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/assets/0361756c09e5f72ddb040240bbec492c0a9dd3562307253ae31bece95bb41d88.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$  where $C={C}_{1}\\cup {C}_{2}\\cup {C}_{3}$ is the path comprising of two line segments and a semicircle or radius $4,$ traversed once in the counterclockwise direction, as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/state.json" "file_sha256" "b17ac954cae06bb27e717726d39daf0dfb673322cc32aedb2cdbf4cacbf000d8"} {"question" "q-124347" "field" nil "attribute" "question/worked-solution" "value" "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14059897/state.json" "file_sha256" "b17ac954cae06bb27e717726d39daf0dfb673322cc32aedb2cdbf4cacbf000d8"} {"question" "q-124347" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer