7/assets/f2f82b83edb4a74641ca72729833f1a5a3ae339c113b0cefbb13b4bef8e8e9fa.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C={C}_{1}\\cup {C}_{2}$ is the path comprising of a quarter circle of radius $2$ and a line segment, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{1}=2$ and ${y}_{2}=-1.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=(-1)-2=-3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124340/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f"] :knowledge-point/questions ["q-124340"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124342/selection/b8fa57840d74818a0622187d4c282bbc0de8cb17f74d7d65e0c4a989ca0c9d5c" :answer/id #uuid "18241a52-0569-572e-895a-8718ccaa5cc4" :answer/type :answer.type/math :answer/value "2\\pi +3" :db/ensure [:answer/validate]} {:db/id "q-124342/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "1e5dc6d7-a8cb-50d8-987a-3a8fa3ece083" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-124342/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "0a79effd-0cb0-5717-88ca-f8626f06940c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-124342/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "232730d3-c3fe-5d6d-a3a3-ae1882b99c50" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-124342/selection/1c82e3635f1f77f71e29bae7972deb3addc5b1c6757d372