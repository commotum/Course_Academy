{3}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k{e}^{2}}{3}=1\\,⟹\\,k=\\frac{3}{{e}^{2}}.\n$$" 13194139535915 true] [17592186374186 1000 #edb/ref 17592186374187 13194139535915 true] [17592186374186 1000 #edb/ref 17592186374188 13194139535915 true] [17592186374186 1000 #edb/ref 17592186374189 13194139535915 true] [17592186374186 1000 #edb/ref 17592186374190 13194139535915 true] [17592186374186 1000 #edb/ref 17592186374191 13194139535915 true] [17592186374186 1040 #edb/ref 17592186045450 13194139535915 true] [17592186374186 1041 "selection" 13194139535915 true] [17592186374186 1104 #edb/ref 17592186374190 13194139535915 true] [17592186374186 1110 #uuid "86b0f57b-f532-50d2-be7b-041bb84808ae" 13194139535915 true] [17592186374187 1034 "\\frac{3}{e}" 13194139535915 true] [17592186374187 1103 #edb/ref 17592186045453 13194139535915 true] [17592186374187 1111 #uuid "fca4f6ee-4dc3-58e4-b43d-c216b81164bf" 13194139535915 true] [17592186374188 1034 "\\frac{e}{3}" 13194139535915 true] [17592186374188 1103 #edb/ref 17592186045453 13194139535915 true] [17592186374188 1111 #uuid "67223d41-78b7-5629-b522-325f01d5ab68" 13194139535915 true] [17592186374189 1034 "3{e}^{2}" 13194139535915 true] [17592186374189 1103 #edb/ref 17592186045453 13194139535915 true] [17592186374189 1111 #uuid "5d88e836-a30d-5137-ac87-1fa9e343e031" 13194139535915 true] [17592186374190 1034 "\\frac{3}{{e}^{2}}" 13194139535915 true] [17592186374190 1103 #edb/ref 17592186045453 13194139535915 true] [17592186374190 1111 #uuid "3bff7ba7-2d3c-5b9a-888c-ed78c4980f51" 13194139535915 true] [17592186374191 1034 "3e" 13194139535915 true] [17592186374191 1103 #edb/ref 17592186045453 13194139535915 true] [17592186374191 1111 #uuid "06fb8da2-0cbe-57bd-aa2f-a6259643fc66" 13194139535915 true] [17592186374192 1017 #edb/ref 17592186374193 13194139535915 true] [17592186374192 1089 "q-87240" 13194139535915 true] [17592186374192 1091 #edb/ref 17592186045463 1