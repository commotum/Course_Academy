[{:db/id [:question/math-academy-id "q-86918"] :question/problem "Compute $P(X>8)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{{x}^{2}},\\, & x\\ge 3, \\\\ 0,\\, & x<3.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>8) & =P(8<X<\\infty ) \\\\  & ={\\int }_{8}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{8}^{\\infty }\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{3}{x}]}_{8}^{\\infty } \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-87240/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "6268317d-4715-5fb3-a8fb-540aab4b57cf" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-87240/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "c6fb0297-ebd5-5469-b9db-713f567ad746" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-87240/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "8876bbac-0bf3-500c-942e-043beb092c31" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-87240/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "4c1e7696-1ed7-52f5-b476-298ca8e52e56" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-87240/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "70a120dd-bc92-5be3-8f4d-d7dea9968526" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-87240/selection" :answer-field/id #uuid "1b340637-0fe5-5f0f-89d1-6bc22cacb542" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-87240/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-87240/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-87240/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-87240/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-87240/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-87240/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-87240" :question/id #uuid "a88b744f-34c6-53d3-b0df-8cbdedbdb3f6" :question/math-academy-id "q-87240" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}k{e}^{6x},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nIn our case, for the function $f(x)=k{e}^{6x}$ on the interval $-\\infty <x\\le 0,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{0}k{e}^{6x}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}k{e}^{6x}\\,\\text{d}x={[\\frac{k}{6}{e}^{6x}]}_{-\\infty }^{0}=\\frac{k}{6}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{6}=1\\,⟹\\,k=6.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-87240/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7"] :knowledge-point/questions ["q-87240"] :db/ensure [:knowledge-point/validate]} {:db/id "q-126028/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "f53980c9-858f-5bb0-8e8a-20ea6d296937" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-126028/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "fe9d5351-0a1d-5d28-a4be-15f1b1f4d661" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-126028/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "7c3c479b-be33-5f1b-a923-05ac65413c69" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-126028/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" :answer/id #uuid "bd63c9c6-20ed-5696-a999-6cc866d8a7f7" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-126028/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e" :answer/id #uuid "3ac79523-07c8-5f5a-af0a-98899b46c7c1" :answer/type :answer.type/math :answer/value "\\frac{3}{8}" :db/ensure [:answer/validate]} {:db/id "q-126028/selection" :answer-field/id #uuid "f94390df-b864-5748-b687-817958347222" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-126028/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer-field/choices ["q-126028/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-126028/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-126028/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-126028/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" "q-126028/selection/d427b944e26709d5f365fc6b5711be004a0a3509f614cbfd4943dc70d3f6d84e"] :db/ensure [:answer-field/validate]} {:db/id "q-126028" :question/id #uuid "8a8288b7-1b74-51d1-8dcd-4f3fd1e567da" :question/math-academy-id "q-126028" :question/problem "Compute $P(X>4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}0,\\, & x<1, \\\\ \\frac{1}{2\\sqrt{{x}^{3}}},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>4) & =P(4<X<\\infty ) \\\\  & ={\\int }_{4}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{4}^{\\infty }\\frac{1}{2\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{\\sqrt{x}}]}_{4}^{\\infty } \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-126028/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8"] :knowledge-point/questions ["q-126028"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160464/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "62a453d1-660a-59b4-9d67-180123d38e62" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-160464/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d373470c-634b-5f3b-80e1-f5e52b7a4f66" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-160464/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "5f3e496a-bebd-507e-aee1-e35c1c6b8f4b" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-160464/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "190f2842-1a2c-50c2-ba7f-ce59011f4442" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-160464/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "a1970201-5a79-502f-88e9-a602606f475e" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-160464/selection" :answer-field/id #uuid "cc7dacca-dfa0-5b83-98e9-4315fbaa0fc8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160464/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-160464/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-160464/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-160464/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-160464/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-160464/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-160464" :question/id #uuid "0b864e29-79e4-5525-91aa-ed335a53cd91" :question/math-academy-id "q-160464" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{k}{(2x-1)^{2}},\\, & x\\ge 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nIn our case, for the function $f(x)=\\frac{k}{(2x-1)^{2}}$ on the interval $x\\ge 2,$ the second condition states that\n\n$$\n{\\int }_{2}^{\\infty }\\frac{k}{(2x-1)^{2}}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{k}{(2x-1)^{2}}\\,\\text{d}x=-\\frac{k}{2(2x-1)}\\,{|}_{2}^{\\infty }=\\frac{k}{6}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{6}=1\\,⟹\\,k=6.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160464/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7"] :knowledge-point/questions ["q-160464"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160467/selection/2372eaf10d3e3c6104c5a2d85d5b9909ce1a56c36600fa4c17241dbcaf0762b2" :answer/id #uuid "5d88e836-a30d-5137-ac87-1fa9e343e031" :answer/type :answer.type/math :answer/value "3{e}^{2}" :db/ensure [:answer/validate]} {:db/id "q-160467/selection/21d9d9ed4ce616542edb555591f054a38ba8d1973844c96bc0f56fc9aaadb7da" :answer/id #uuid "67223d41-78b7-5629-b522-325f01d5ab68" :answer/type :answer.type/math :answer/value "\\frac{e}{3}" :db/ensure [:answer/validate]} {:db/id "q-160467/selection/78f141536c7cfe228b384b886a57a8e2ce0d144bc19443a7c5dd83f326b15217" :answer/id #uuid "3bff7ba7-2d3c-5b9a-888c-ed78c4980f51" :answer/type :answer.type/math :answer/value "\\frac{3}{{e}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-160467/selection/de65f68b9ebe8220ad685ae8fd317e4e85f600952fac99fcca3864668321a3a0" :answer/id #uuid "06fb8da2-0cbe-57bd-aa2f-a6259643fc66" :answer/type :answer.type/math :answer/value "3e" :db/ensure [:answer/validate]} {:db/id "q-160467/selection/03adb6ab7b2ac1f24256ce8f8bb5d578ad0aca033123e54c2519fd0d567b744b" :answer/id #uuid "fca4f6ee-4dc3-58e4-b43d-c216b81164bf" :answer/type :answer.type/math :answer/value "\\frac{3}{e}" :db/ensure [:answer/validate]} {:db/id "q-160467/selection" :answer-field/id #uuid "86b0f57b-f532-50d2-be7b-041bb84808ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160467/selection/78f141536c7cfe228b384b886a57a8e2ce0d144bc19443a7c5dd83f326b15217" :answer-field/choices ["q-160467/selection/2372eaf10d3e3c6104c5a2d85d5b9909ce1a56c36600fa4c17241dbcaf0762b2" "q-160467/selection/21d9d9ed4ce616542edb555591f054a38ba8d1973844c96bc0f56fc9aaadb7da" "q-160467/selection/78f141536c7cfe228b384b886a57a8e2ce0d144bc19443a7c5dd83f326b15217" "q-160467/selection/de65f68b9ebe8220ad685ae8fd317e4e85f600952fac99fcca3864668321a3a0" "q-160467/selection/03adb6ab7b2ac1f24256ce8f8bb5d578ad0aca033123e54c2519fd0d567b744b"] :db/ensure [:answer-field/validate]} {:db/id "q-160467" :question/id #uuid "c725f2ea-2620-5224-a362-8a0c80dcc6fa" :question/math-academy-id "q-160467" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}k{e}^{3x+2},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nIn our case, for the function $f(x)=k{e}^{3x+2}$ on the interval $x\\le 0,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{0}k{e}^{3x+2}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}k{e}^{3x+2}\\,\\text{d}x=\\frac{k}{3}{e}^{3x+2}\\,{|}_{-\\infty }^{0}=\\frac{k{e}^{2}}{3}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k{e}^{2}}{3}=1\\,⟹\\,k=\\frac{3}{{e}^{2}}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7"] :knowledge-point/questions ["q-160467"] :db/ensure [:knowledge-point/validate]}]
