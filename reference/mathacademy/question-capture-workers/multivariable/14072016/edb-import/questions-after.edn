#{[{:db/id #edb/ref 17592186374171 :knowledge-point/_questions [{:knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/title "Computing a Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bd63c9c6-20ed-5696-a999-6cc866d8a7f7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186374173} {:answer/id #uuid "7c3c479b-be33-5f1b-a923-05ac65413c69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186374174} {:answer/id #uuid "f53980c9-858f-5bb0-8e8a-20ea6d296937" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186374175} {:answer/id #uuid "fe9d5351-0a1d-5d28-a4be-15f1b1f4d661" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186374176} {:answer/id #uuid "3ac79523-07c8-5f5a-af0a-98899b46c7c1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186374177}] :answer-field/correct {:answer/id #uuid "7c3c479b-be33-5f1b-a923-05ac65413c69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186374174} :answer-field/id #uuid "f94390df-b864-5748-b687-817958347222" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374172}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "8a8288b7-1b74-51d1-8dcd-4f3fd1e567da" :question/math-academy-id "q-126028" :question/problem "Compute $P(X>4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}0,\\, & x<1, \\\\ \\frac{1}{2\\sqrt{{x}^{3}}},\\, & x\\ge 1.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>4) & =P(4<X<\\infty ) \\\\  & ={\\int }_{4}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{4}^{\\infty }\\frac{1}{2\\sqrt{{x}^{3}}}\\,\\text{d}x \\\\  & ={[-\\frac{1}{\\sqrt{x}}]}_{4}^{\\infty } \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374178 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7" :knowledge-point/title "Solving for a Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "62a453d1-660a-59b4-9d67-180123d38e62" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186374180} {:answer/id #uuid "5f3e496a-bebd-507e-aee1-e35c1c6b8f4b" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186374181} {:answer/id #uuid "d373470c-634b-5f3b-80e1-f5e52b7a4f66" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186374182} {:answer/id #uuid "190f2842-1a2c-50c2-ba7f-ce59011f4442" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374183} {:answer/id #uuid "a1970201-5a79-502f-88e9-a602606f475e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374184}] :answer-field/correct {:answer/id #uuid "190f2842-1a2c-50c2-ba7f-ce59011f4442" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374183} :answer-field/id #uuid "cc7dacca-dfa0-5b83-98e9-4315fbaa0fc8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374179}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0b864e29-79e4-5525-91aa-ed335a53cd91" :question/math-academy-id "q-160464" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}\\frac{k}{(2x-1)^{2}},\\, & x\\ge 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nIn our case, for the function $f(x)=\\frac{k}{(2x-1)^{2}}$ on the interval $x\\ge 2,$ the second condition states that\n\n$$\n{\\int }_{2}^{\\infty }\\frac{k}{(2x-1)^{2}}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{\\infty }\\frac{k}{(2x-1)^{2}}\\,\\text{d}x=-\\frac{k}{2(2x-1)}\\,{|}_{2}^{\\infty }=\\frac{k}{6}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{6}=1\\,⟹\\,k=6.\n$$"}] [{:db/id #edb/ref 17592186374185 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7" :knowledge-point/title "Solving for a Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "fca4f6ee-4dc3-58e4-b43d-c216b81164bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{e}" :db/id #edb/ref 17592186374187} {:answer/id #uuid "67223d41-78b7-5629-b522-325f01d5ab68" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e}{3}" :db/id #edb/ref 17592186374188} {:answer/id #uuid "5d88e836-a30d-5137-ac87-1fa9e343e031" :answer/type {:db/ident :answer.type/math} :answer/value "3{e}^{2}" :db/id #edb/ref 17592186374189} {:answer/id #uuid "3bff7ba7-2d3c-5b9a-888c-ed78c4980f51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{2}}" :db/id #edb/ref 17592186374190} {:answer/id #uuid "06fb8da2-0cbe-57bd-aa2f-a6259643fc66" :answer/type {:db/ident :answer.type/math} :answer/value "3e" :db/id #edb/ref 17592186374191}] :answer-field/correct {:answer/id #uuid "3bff7ba7-2d3c-5b9a-888c-ed78c4980f51" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{{e}^{2}}" :db/id #edb/ref 17592186374190} :answer-field/id #uuid "86b0f57b-f532-50d2-be7b-041bb84808ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374186}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c725f2ea-2620-5224-a362-8a0c80dcc6fa" :question/math-academy-id "q-160467" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}k{e}^{3x+2},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nIn our case, for the function $f(x)=k{e}^{3x+2}$ on the interval $x\\le 0,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{0}k{e}^{3x+2}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}k{e}^{3x+2}\\,\\text{d}x=\\frac{k}{3}{e}^{3x+2}\\,{|}_{-\\infty }^{0}=\\frac{k{e}^{2}}{3}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k{e}^{2}}{3}=1\\,⟹\\,k=\\frac{3}{{e}^{2}}.\n$$"}] [{:db/id #edb/ref 17592186193219 :knowledge-point/_questions [{:knowledge-point/id #uuid "1fdf4f96-f679-57b8-96aa-7e9c34b986b8" :knowledge-point/title "Computing a Probability Over an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "999a0d5d-11df-52cb-ab35-a8d4ab88fdd7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186192103} {:answer/id #uuid "e8bfeb96-b27d-52da-a647-ecee8dff47bf" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186192104} {:answer/id #uuid "03487f51-ec82-564a-bb94-27f3d8b1245d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186192105} {:answer/id #uuid "0dd6ccba-0047-5b82-91be-fc0704192296" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186192106} {:answer/id #uuid "2e6e2874-9c5b-5749-bfd3-fe43fc68c7ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}" :db/id #edb/ref 17592186192107}] :answer-field/correct {:answer/id #uuid "03487f51-ec82-564a-bb94-27f3d8b1245d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186192105} :answer-field/id #uuid "abeca6d0-f6bc-5722-b52c-5b3e40897b73" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186192102}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9869c64e-9e23-5b9b-b7d6-0c4c49a322f3" :question/math-academy-id "q-86918" :question/problem "Compute $P(X>8)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{{x}^{2}},\\, & x\\ge 3, \\\\ 0,\\, & x<3.\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(X>8) & =P(8<X<\\infty ) \\\\  & ={\\int }_{8}^{\\infty }f(x)\\,\\text{d}x \\\\  & ={\\int }_{8}^{\\infty }\\frac{3}{{x}^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{3}{x}]}_{8}^{\\infty } \\\\  & =\\frac{3}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374192 :knowledge-point/_questions [{:knowledge-point/id #uuid "fd8455e1-46f3-5956-80ec-e6753cc005a7" :knowledge-point/title "Solving for a Constant Given a PDF"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8876bbac-0bf3-500c-942e-043beb092c31" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186374194} {:answer/id #uuid "4c1e7696-1ed7-52f5-b476-298ca8e52e56" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186374195} {:answer/id #uuid "6268317d-4715-5fb3-a8fb-540aab4b57cf" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186374196} {:answer/id #uuid "c6fb0297-ebd5-5469-b9db-713f567ad746" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374197} {:answer/id #uuid "70a120dd-bc92-5be3-8f4d-d7dea9968526" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186374198}] :answer-field/correct {:answer/id #uuid "c6fb0297-ebd5-5469-b9db-713f567ad746" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374197} :answer-field/id #uuid "1b340637-0fe5-5f0f-89d1-6bc22cacb542" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374193}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a88b744f-34c6-53d3-b0df-8cbdedbdb3f6" :question/math-academy-id "q-87240" :question/problem "Solve for $k$ given that the following function is a probability density function:\n\n$$\nf(x)={\\begin{aligned}k{e}^{6x},\\, & x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "For a function $f(x)$ defined on a set $S$ to be a valid probability density function, it must satisfy the following conditions:\n\n- $f(x)\\ge 0$ for all $x\\in S$\n\n- ${\\int }_{S}f(x)\\,\\text{d}x=1$\n\nIn our case, for the function $f(x)=k{e}^{6x}$ on the interval $-\\infty <x\\le 0,$ the second condition states that\n\n$$\n{\\int }_{-\\infty }^{0}k{e}^{6x}\\,\\text{d}x=1.\n$$\n\nComputing the integral on the left-hand side, we get\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}k{e}^{6x}\\,\\text{d}x={[\\frac{k}{6}{e}^{6x}]}_{-\\infty }^{0}=\\frac{k}{6}.\\end{aligned}\n$$\n\nSubstituting this result back into the first equation and solving for $k,$ we get\n\n$$\n\\frac{k}{6}=1\\,⟹\\,k=6.\n$$"}]}
