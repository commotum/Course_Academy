#{[{:db/id #edb/ref 17592186355192 :knowledge-point/_questions [{:knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3ebbef09-f8e0-559a-b5e0-38b6f35695ea" :answer/type {:db/ident :answer.type/text} :answer/value "Impossible to determine" :db/id #edb/ref 17592186355194} {:answer/id #uuid "1008b0e4-860e-5920-b498-c6d35fa3ee04" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186355195} {:answer/id #uuid "a06a7bfe-67d0-54bd-abba-068cda545fdb" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186355196} {:answer/id #uuid "c9d2733d-0989-5653-8016-887b51b33451" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186355197} {:answer/id #uuid "40ae47f9-8742-50fc-a63b-3ff3368c9860" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186355198}] :answer-field/correct {:answer/id #uuid "c9d2733d-0989-5653-8016-887b51b33451" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186355197} :answer-field/id #uuid "1c3735ae-7003-56ce-9efc-c7ac39c63d8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355193}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0bc49a3e-94e5-5e0b-b0a0-e39ca31b0568" :question/math-academy-id "q-124181" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y=8$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y=-3,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}y-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\  & =-8-(-3) \\\\  & =-5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186355199 :knowledge-point/_questions [{:knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cfe5bca-101d-5cd3-a466-35407eba8301" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186355201} {:answer/id #uuid "25fb84d7-df97-52d5-9044-e02de8cb6f80" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186355202} {:answer/id #uuid "d7a199a0-2eb6-5db1-89fa-2aab139b3a01" :answer/type {:db/ident :answer.type/math} :answer/value "-27" :db/id #edb/ref 17592186355203} {:answer/id #uuid "914dfaca-7316-5b2b-a2f1-8c9807bcb044" :answer/type {:db/ident :answer.type/math} :answer/value "27" :db/id #edb/ref 17592186355204} {:answer/id #uuid "e5035d5e-5655-5ca3-8bb0-dcbe9c03b80b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186355205}] :answer-field/correct {:answer/id #uuid "25fb84d7-df97-52d5-9044-e02de8cb6f80" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186355202} :answer-field/id #uuid "f253d9bb-faac-51ac-8b6d-7592402df3fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355200}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "545af9f5-52f6-5277-ace0-011b4e386a69" :question/math-academy-id "q-124186" :question/problem "If ${\\int }_{-C}f(x,y)\\,\\text{d}x=16$ and ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x=11,$ calculate ${\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\ -{\\int }_{-C}f(x,y)\\,\\text{d}x & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\ -16 & =-11+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\ -5 & ={\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x=-5.\n$$"}] [{:db/id #edb/ref 17592186355206 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "65dbfb0d-e03f-5316-ad9e-7721e1dd3a58" :answer/type {:db/ident :answer.type/math} :answer/value "3\\pi +2" :db/id #edb/ref 17592186355208} {:answer/id #uuid "fd8a5cf2-72c5-53e9-8697-47e4e76697e2" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186355209} {:answer/id #uuid "6deaa41d-8923-5dea-8480-3f5f5186b842" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi }{2}+2\\sqrt{2}" :db/id #edb/ref 17592186355210} {:answer/id #uuid "0b07e52e-f05f-5485-97a0-71c39afdcd20" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186355211} {:answer/id #uuid "db938fef-5e65-5336-ae99-6761e76f3716" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186355212}] :answer-field/correct {:answer/id #uuid "fd8a5cf2-72c5-53e9-8697-47e4e76697e2" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186355209} :answer-field/id #uuid "38d6616b-52d6-5815-bfa1-9623657dd4ae" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355207}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c1f5fbac-def9-5884-ac36-5373ec03bd36" :question/math-academy-id "q-124341" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14066680/assets/1c074157bb6374a4da01d6c1312bb60520966317b1f903eb44a191384e398ae6.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C={C}_{1}\\cup {C}_{2}$ is the path comprising of a quarter circle of radius $3$ and a line segment, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{1}=1$ and ${y}_{2}=-4.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=(-4)-1=-5.\n$$"}] [{:db/id #edb/ref 17592186355213 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "359a4a9d-0b35-52b6-a187-9fa2e2d70858" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186355215} {:answer/id #uuid "9339a980-9d7c-521d-a29a-b18c7d5b6d46" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186355216} {:answer/id #uuid "337da379-ce56-5860-ba2b-714f4ca00574" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186355217} {:answer/id #uuid "8d8b0db1-702b-599f-977c-7f50c1e6999e" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186355218} {:answer/id #uuid "b508c2f0-7c33-5c3e-bb34-33ec7462734c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355219}] :answer-field/correct {:answer/id #uuid "b508c2f0-7c33-5c3e-bb34-33ec7462734c" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355219} :answer-field/id #uuid "9f1f3298-33ca-5257-aacc-94348efb1cbe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355214}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "f0810304-081c-5da3-b91b-eb0e44ed6c17" :question/math-academy-id "q-124346" :question/problem "Calculate ${∮}_{C}\\,\\text{d}y,$ where $C$ is the closed path along a circle of radius $2,$ traversed once in the counterclockwise direction." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$"}] [{:db/id #edb/ref 17592186355220 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "25f20c1a-1dfa-5a42-a327-c7ec733751c2" :answer/type {:db/ident :answer.type/math} :answer/value "3+\\sqrt{5}" :db/id #edb/ref 17592186355222} {:answer/id #uuid "b81e4ed6-65da-5e9f-b550-f6b3bf043497" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186355223} {:answer/id #uuid "3fbfdf52-d0c9-5366-994b-9e03f7bae899" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186355224} {:answer/id #uuid "e711272f-9729-5143-8ad8-fd656b7b634a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355225} {:answer/id #uuid "320947c0-d6b8-57b4-826d-bd19c58b0a19" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186355226}] :answer-field/correct {:answer/id #uuid "e711272f-9729-5143-8ad8-fd656b7b634a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186355225} :answer-field/id #uuid "41c9a0b3-0899-5542-8e1a-e9dc9e3b25e7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186355221}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "c7b792dd-ce4a-5f38-93b7-63f83938136f" :question/math-academy-id "q-124349" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14066680/assets/0da125535534cbd50b96cb280cf8b8a4b58653a344c8699d7b732ec73cc3b2ce.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$ where $C$ is the closed path along a right triangle, traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$"}]}
