ext{d}y \\\\  & =\\frac{2\\pi }{3}{\\int }_{0}^{1}(1-y)^{3}+{y}^{3}\\text{d}y\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{2\\pi }{3}{\\int }_{0}^{1}(1-y)^{3}+{y}^{3}\\text{d}y & =\\frac{2\\pi }{3}{[-\\frac{(1-y)^{4}}{4}+\\frac{{y}^{4}}{4}]}_{y=0}^{y=1} \\\\  & =\\frac{2\\pi }{3}((-0+\\frac{1}{4})-(-\\frac{1}{4}+0)) \\\\  & =\\frac{2\\pi }{3}\\cdot \\frac{1}{2} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$" 13194139535241 true] [17592186339344 1000 #edb/ref 17592186339345 13194139535241 true] [17592186339344 1000 #edb/ref 17592186339346 13194139535241 true] [17592186339344 1000 #edb/ref 17592186339347 13194139535241 true] [17592186339344 1000 #edb/ref 17592186339348 13194139535241 true] [17592186339344 1000 #edb/ref 17592186339349 13194139535241 true] [17592186339344 1040 #edb/ref 17592186045450 13194139535241 true] [17592186339344 1041 "selection" 13194139535241 true] [17592186339344 1104 #edb/ref 17592186339347 13194139535241 true] [17592186339344 1110 #uuid "f8bd4817-cd8f-5002-aee5-5d85b1d2b1d2" 13194139535241 true] [17592186339345 1034 "\\frac{5\\pi }{4}" 13194139535241 true] [17592186339345 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339345 1111 #uuid "7a8fe609-7b83-5540-9d6c-6250a9a9655d" 13194139535241 true] [17592186339346 1034 "\\frac{2\\pi }{3}+1" 13194139535241 true] [17592186339346 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339346 1111 #uuid "40546de5-3018-50e9-a063-6d5b8d548b01" 13194139535241 true] [17592186339347 1034 "\\frac{\\pi }{3}" 13194139535241 true] [17592186339347 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339347 1111 #uuid "5105a4dd-0c57-5cca-a7d6-9b7ff23aa444" 13194139535241 true] [17592186339348 1034 "4" 13194139535241 true] [17592186339348 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339348 1111 #uuid "d65131e4-66ee-5f6b-a9f6-e4c6184370cc" 13194139535241 true] [17592186339349 1034 "\\pi +2" 13194139535241 true] [17592186339349 1103 