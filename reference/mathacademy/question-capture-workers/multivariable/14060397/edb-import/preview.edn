}_{0}^{1} \\\\  & =4\\cdot 1\\cdot \\frac{1}{2} \\\\  & =2.\\end{aligned}\n$$\n\nTherefore, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}{\\int }_{1}^{2}{\\int }_{0}^{1}(x{y}^{2}{z}^{3}-z)\\,\\text{d}z\\,\\text{d}y\\,\\text{d}x=\\frac{14}{3}-2=\\frac{8}{3}.\\end{aligned}\n$$" 13194139535241 true] [17592186339302 1000 #edb/ref 17592186339303 13194139535241 true] [17592186339302 1000 #edb/ref 17592186339304 13194139535241 true] [17592186339302 1000 #edb/ref 17592186339305 13194139535241 true] [17592186339302 1000 #edb/ref 17592186339306 13194139535241 true] [17592186339302 1000 #edb/ref 17592186339307 13194139535241 true] [17592186339302 1040 #edb/ref 17592186045450 13194139535241 true] [17592186339302 1041 "selection" 13194139535241 true] [17592186339302 1104 #edb/ref 17592186339305 13194139535241 true] [17592186339302 1110 #uuid "8b8a821d-ac07-5baa-832d-724b52496102" 13194139535241 true] [17592186339303 1034 "\\frac{5}{6}" 13194139535241 true] [17592186339303 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339303 1111 #uuid "fba8fc24-d55e-510e-807f-4e0e198013d4" 13194139535241 true] [17592186339304 1034 "3" 13194139535241 true] [17592186339304 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339304 1111 #uuid "55e9f940-26c0-522e-8910-5223844cb48d" 13194139535241 true] [17592186339305 1034 "\\frac{8}{3}" 13194139535241 true] [17592186339305 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339305 1111 #uuid "892a83b2-0074-58c6-a55b-c8a962189b5c" 13194139535241 true] [17592186339306 1034 "2" 13194139535241 true] [17592186339306 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339306 1111 #uuid "45adaf99-f894-52de-a887-98e553f8d0e0" 13194139535241 true] [17592186339307 1034 "1" 13194139535241 true] [17592186339307 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339307 1111 #uuid "0e60d8ae-21f4-5c97-9423-087af7e11390" 13194139535241 true] [17592186339308 1017 #edb/ref 17592186339309 13194139535241 true] [1759