}+{y}^{2}\\,\\text{d}x\\,\\text{d}y\\,\\text{d}z=\\frac{4}{3}+\\frac{16}{3}=\\frac{20}{3}\\end{aligned}\n$$" 13194139535241 true] [17592186339386 1000 #edb/ref 17592186339387 13194139535241 true] [17592186339386 1000 #edb/ref 17592186339388 13194139535241 true] [17592186339386 1000 #edb/ref 17592186339389 13194139535241 true] [17592186339386 1000 #edb/ref 17592186339390 13194139535241 true] [17592186339386 1000 #edb/ref 17592186339391 13194139535241 true] [17592186339386 1040 #edb/ref 17592186045450 13194139535241 true] [17592186339386 1041 "selection" 13194139535241 true] [17592186339386 1104 #edb/ref 17592186339387 13194139535241 true] [17592186339386 1110 #uuid "c837daa7-9791-58ee-9414-9126d838aaba" 13194139535241 true] [17592186339387 1034 "\\frac{20}{3}" 13194139535241 true] [17592186339387 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339387 1111 #uuid "37994fdb-8818-54b2-8856-73c3e8191ea7" 13194139535241 true] [17592186339388 1034 "7" 13194139535241 true] [17592186339388 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339388 1111 #uuid "33e4e32b-71d8-52ae-abe7-e78c65efb746" 13194139535241 true] [17592186339389 1034 "6" 13194139535241 true] [17592186339389 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339389 1111 #uuid "17b7bfb4-6b65-5597-85f3-b8693e0f13d7" 13194139535241 true] [17592186339390 1034 "\\frac{17}{3}" 13194139535241 true] [17592186339390 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339390 1111 #uuid "1a29cb2e-3219-5985-bc14-8b6b8eeea9a2" 13194139535241 true] [17592186339391 1034 "\\frac{22}{3}" 13194139535241 true] [17592186339391 1103 #edb/ref 17592186045453 13194139535241 true] [17592186339391 1111 #uuid "08981e8e-f53b-59a8-95e5-3a7e472f1453" 13194139535241 true]] :edb/tempids {"q-161268" 17592186339294 "q-161268/selection" 17592186339295 "q-161268/selection/295dac5fa4d5d64455f39d27ce39681f8b19b2c4632faab1abe33e3d767025f0" 17592186339296 "q-161268/selection/5e542eed8f462585c79e39910b2c34ef465e22