#{[{:db/id #edb/ref 17592186286070 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "480753c5-0d0d-51c0-ba24-0967d975d9d5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286072}] :answer-field/correct {:answer/id #uuid "480753c5-0d0d-51c0-ba24-0967d975d9d5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286072} :answer-field/id #uuid "41a53f06-9530-5e4c-932f-df8d83e29d25" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286071} {:answer-field/choices [{:answer/id #uuid "a5dc76c5-7c08-524e-ac92-045277e888c5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286074}] :answer-field/correct {:answer/id #uuid "a5dc76c5-7c08-524e-ac92-045277e888c5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286074} :answer-field/id #uuid "f43ecdae-9c55-5ad1-888d-320d8787776c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286073}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c160132d-20d0-59f1-aea1-6e3f6c75bcba" :question/math-academy-id "q-317176" :question/problem "A particle moves with constant acceleration. The velocity of the particle equals $(-4i+9j)\\,\\text{ft/s}$ both when $t=0\\,\\text{s}$ and $t=7\\,\\text{s}.$ What is the acceleration of the particle?\n\n$a=($\n{{field-1}}$\\,i$\n$+$\n{{field-2}}$\\,j\\,)\\,{\\text{ft/s}}^{2}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-4i+9j,\\,v=-4i+9j,\\,t=7\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ -4i+9j & =(-4i+9j)+a(7) \\\\ 0 & =7a \\\\ a & =(0\\,i+0\\,j)\\,{\\text{ft/s}}^{2}.\\end{aligned}\n$$"}]}
