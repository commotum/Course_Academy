#{[{:db/id #edb/ref 17592186323607 :knowledge-point/_questions [{:knowledge-point/id #uuid "7439a96f-07b1-5673-a103-af2c63c25d18" :knowledge-point/title "Calculating the Final Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f164bdea-b9b5-5b1e-9ce8-6474703ea3a6" :answer/type {:db/ident :answer.type/math} :answer/value "8.34\\,\\text{m/s}" :db/id #edb/ref 17592186323609} {:answer/id #uuid "43c67b22-400b-586e-8f0e-b8a925f02649" :answer/type {:db/ident :answer.type/math} :answer/value "8.77\\,\\text{m/s}" :db/id #edb/ref 17592186323610} {:answer/id #uuid "8fd9f350-9563-54f5-acc5-d4d715be543c" :answer/type {:db/ident :answer.type/math} :answer/value "9.45\\,\\text{m/s}" :db/id #edb/ref 17592186323611} {:answer/id #uuid "1c941c65-766c-5661-a208-70f90b77673e" :answer/type {:db/ident :answer.type/math} :answer/value "10.12\\,\\text{m/s}" :db/id #edb/ref 17592186323612} {:answer/id #uuid "513e402a-22be-57c8-be5b-487b288dbabf" :answer/type {:db/ident :answer.type/math} :answer/value "9.22\\,\\text{m/s}" :db/id #edb/ref 17592186323613}] :answer-field/correct {:answer/id #uuid "513e402a-22be-57c8-be5b-487b288dbabf" :answer/type {:db/ident :answer.type/math} :answer/value "9.22\\,\\text{m/s}" :db/id #edb/ref 17592186323613} :answer-field/id #uuid "10b55310-aae7-53f6-91e1-ebff7d9c5627" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323608}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b1f34d54-8942-568b-886d-8135a1e4e0a3" :question/math-academy-id "q-136355" :question/problem "The initial velocity of a particle is $(5i+3j)\\,\\text{m/s}.$ Find the speed of the particle after $3$ seconds if the particle moves with a constant acceleration of $(-i+2j)\\,{\\text{m/s}}^{2}.$ Round your answer to two decimal places." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=5i+3j,\\,a=-i+2j.\n$$\n\nTherefore, after $3$ seconds, the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(5i+3j)+(-i+2j)(3) \\\\  & =(5i+3j)+(-3i+6j) \\\\  & =(2i+9j)\\,\\text{m/s}.\\end{aligned}\n$$\n\nFinally, the speed of the particle is\n\n$$\n\\begin{aligned}|v| & =|2i+9j| \\\\  & =\\sqrt{{2}^{2}+{9}^{2}} \\\\  & =\\sqrt{4+81} \\\\  & =\\sqrt{85} \\\\  & ≈9.22\\,\\text{m/s}\\end{aligned}\n$$\n\nrounded to two decimal places."}] [{:db/id #edb/ref 17592186323614 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "524af600-4737-53fa-9092-c1c248e8c649" :answer/type {:db/ident :answer.type/math} :answer/value "-j\\,{\\text{ft/s}}^{2}" :db/id #edb/ref 17592186323616} {:answer/id #uuid "c31ef56c-a7bb-5530-b6dc-a772beccf517" :answer/type {:db/ident :answer.type/math} :answer/value "-2j\\,{\\text{ft/s}}^{2}" :db/id #edb/ref 17592186323617} {:answer/id #uuid "7c0bb2bf-868a-5e7a-a69f-d26c9fcdf8cb" :answer/type {:db/ident :answer.type/math} :answer/value "3j\\,{\\text{ft/s}}^{2}" :db/id #edb/ref 17592186323618} {:answer/id #uuid "13e08e36-19d7-5137-ab73-3fa15d325384" :answer/type {:db/ident :answer.type/math} :answer/value "0\\,{\\text{ft/s}}^{2}" :db/id #edb/ref 17592186323619} {:answer/id #uuid "e702caaf-c263-5fda-a390-c0026e3b9541" :answer/type {:db/ident :answer.type/math} :answer/value "2i\\,{\\text{ft/s}}^{2}" :db/id #edb/ref 17592186323620}] :answer-field/correct {:answer/id #uuid "7c0bb2bf-868a-5e7a-a69f-d26c9fcdf8cb" :answer/type {:db/ident :answer.type/math} :answer/value "3j\\,{\\text{ft/s}}^{2}" :db/id #edb/ref 17592186323618} :answer-field/id #uuid "836eced1-931a-5656-98ea-f88c3efa441e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186323615}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c0106504-81c0-5de5-bc00-12192706f1e0" :question/math-academy-id "q-136376" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(5i+j)\\,\\text{ft/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $(5i+13j)\\,\\text{ft/s}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=5i+j,\\,v=5i+13j,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 5i+13j & =(5i+j)+a(4) \\\\ 12j & =4a \\\\ a & =\\frac{1}{4}(12j) \\\\  & =3j\\,{\\text{ft/s}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286070 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "480753c5-0d0d-51c0-ba24-0967d975d9d5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286072} {:answer/id #uuid "6b5e3656-999e-5b37-87e5-1b72a59f5252" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186323621}] :answer-field/correct {:answer/id #uuid "480753c5-0d0d-51c0-ba24-0967d975d9d5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286072} :answer-field/id #uuid "41a53f06-9530-5e4c-932f-df8d83e29d25" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286071} {:answer-field/choices [{:answer/id #uuid "a5dc76c5-7c08-524e-ac92-045277e888c5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286074}] :answer-field/correct {:answer/id #uuid "a5dc76c5-7c08-524e-ac92-045277e888c5" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186286074} :answer-field/id #uuid "f43ecdae-9c55-5ad1-888d-320d8787776c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186286073}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c160132d-20d0-59f1-aea1-6e3f6c75bcba" :question/math-academy-id "q-317176" :question/problem "A particle moves with constant acceleration. The velocity of the particle equals $(-4i+9j)\\,\\text{ft/s}$ both when $t=0\\,\\text{s}$ and $t=7\\,\\text{s}.$ What is the acceleration of the particle?\n\n$a=($\n{{field-1}}$\\,i$\n$+$\n{{field-2}}$\\,j\\,)\\,{\\text{ft/s}}^{2}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-4i+9j,\\,v=-4i+9j,\\,t=7\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ -4i+9j & =(-4i+9j)+a(7) \\\\ 0 & =7a \\\\ a & =(0\\,i+0\\,j)\\,{\\text{ft/s}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323622 :knowledge-point/_questions [{:knowledge-point/id #uuid "7439a96f-07b1-5673-a103-af2c63c25d18" :knowledge-point/title "Calculating the Final Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "de3916e5-f979-5e97-8825-d1e23bd23e1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{113}" :db/id #edb/ref 17592186323624}] :answer-field/correct {:answer/id #uuid "de3916e5-f979-5e97-8825-d1e23bd23e1c" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{113}" :db/id #edb/ref 17592186323624} :answer-field/id #uuid "62779e9b-d4b6-50b2-b1ed-9b5b51f36755" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186323623}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "337fe7e5-2886-56fa-9ae7-af043910f934" :question/math-academy-id "q-319037" :question/problem "The initial velocity of a particle is $(2i+5j)\\,\\text{m/s}.$ Find the **exact** speed of the particle after $3$ seconds if the particle moves with a constant acceleration of $(-3i+j)\\,{\\text{m/s}}^{2}.$\n\n$|v|=$\n\n{{field-1}} $\\text{m/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=2i+5j,\\,a=-3i+j.\n$$\n\nTherefore, after $t=3\\,\\text{s},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(2i+5j)+(-3i+j)(3) \\\\  & =(2i+5j)+(-9i+3j) \\\\  & =(-7\\,i+8\\,j)\\,\\text{m/s}.\\end{aligned}\n$$\n\nFinally, the speed of the particle is\n\n$$\n\\begin{aligned}|v| & =|-7i+8j| \\\\  & =\\sqrt{(-7)^{2}+{8}^{2}} \\\\  & =\\sqrt{49+64} \\\\  & =\\sqrt{113}\\,\\text{m/s}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186323625 :knowledge-point/_questions [{:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ef48609f-fcd6-5e30-9de6-dcea0f04aaf9" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186323627}] :answer-field/correct {:answer/id #uuid "ef48609f-fcd6-5e30-9de6-dcea0f04aaf9" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186323627} :answer-field/id #uuid "69985783-15dd-5a28-8e98-8f9cbe901597" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186323626}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0e91f25b-d36d-54f0-9adb-0e2a79068ce0" :question/math-academy-id "q-319169" :question/problem "A particle moves with a constant acceleration of $(-2i+4j)\\,{\\text{km/h}}^{2}.$ The velocity of the particle is $(10i-8j)\\,\\text{km/h}$ when $t=0\\,\\text{h}.$ Find the time when the velocity of the particle equals $(-8i+28j)\\,\\text{km/h}.$\n\n$t=$\n{{field-1}}$\\,\\text{h}$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=10i-8j,\\,v=-8i+28j,\\,a=-2i+4j,\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ -8i+28j & =10i-8j+(-2i+4j)t \\\\ -18i+36j & =(-2i+4j)t \\\\ -18i+36j & =-2ti+4tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}-18=-2t \\\\ 36=4t\\end{aligned}\\,⟹\\,t=9\\,\\text{h}.\n$$"}]}
