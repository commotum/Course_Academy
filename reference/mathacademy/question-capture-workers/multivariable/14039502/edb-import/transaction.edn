" "q-114423/selection/676acdfeeb36f02a0eaff1d849845ee71981b017e0ca89d22f61839c021921d1"] :db/ensure [:answer-field/validate]} {:db/id "q-114423" :question/id #uuid "90f43e47-681b-5a78-9983-d0ba65d64a48" :question/math-academy-id "q-114423" :question/problem "Calculate $\\int \\frac{\\operatorname{sec}⁡x}{1+{tan}^{2}⁡x}\\,\\text{d}x.$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sec}⁡x}{1+{tan}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{\\operatorname{sec}⁡x}{{sec}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\operatorname{sec}⁡x}\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114423/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7"] :knowledge-point/questions ["q-114423"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73526/selection/bb506cf003879770dcc37d3f108f66837df546bd68c5ad9b0e1b3a27b8c6ec6c" :answer/id #uuid "918b9b52-606c-5d28-a3f5-ac3005d79074" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-73526/selection/5087850b25468f7659de077ea7945b610566a75e4abb96b36ba2fb12e2d11b38" :answer/id #uuid "f2b80f7e-9287-5c0a-ac4f-88345a12e1de" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-73526/selection/9913d356e1d5d72a296ff91450a1b60ed730b8ad962ab9b9c4e4036ac4e298b9" :answer/id #uuid "5ff15703-e982-5a28-adb4-763d5ef0adfa" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x+x+C" :db/ensure [:answer/validate]} {:db/id "q-73526/selection/1b5c0cac76cfcf0ddc55b7ed8dc17cb1df8bb86e5