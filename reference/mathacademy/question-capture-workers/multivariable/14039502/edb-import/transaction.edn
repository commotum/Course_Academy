 [:answer-field/validate]} {:db/id "q-114353" :question/id #uuid "370be9f0-0eac-53fe-8b00-728cbe5bfa2c" :question/math-academy-id "q-114353" :question/problem "$\\int \\frac{1}{{cos}^{4}⁡x+{cos}^{2}⁡x{sin}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We use the Pythagorean identity:\n\n$$\n{sin}^{2}⁡x+{cos}^{2}⁡x=1\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}\\int \\frac{1}{{cos}^{4}⁡x+{cos}^{2}⁡x{sin}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{cos}^{2}⁡x({cos}^{2}⁡x+{sin}^{2}⁡x)}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{cos}^{2}⁡x\\cdot 1}\\,\\text{d}x \\\\  & =\\int \\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114353/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19a857ac-d36b-5753-a532-4f2a75612d85"] :knowledge-point/questions ["q-114353"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114350/selection/64772acb54332137e256b7e9d8ffcae9e71ad2377b9dd581f979df71277bbe00" :answer/id #uuid "8e86a532-641e-593c-8ba1-1b9b33a5c7b8" :answer/type :answer.type/math :answer/value "-\\operatorname{cot}⁡x-\\operatorname{sec}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114350/selection/62662b4ac4ec8d8c82128be02815ae17ee676ab76d485c4e517d892ae693e4ee" :answer/id #uuid "44a42067-0b76-5be8-ad9f-10f653942532" :answer/type :answer.type/math :answer/value "-\\operatorname{tan}⁡x+\\operatorname{sec}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114350/selection/9bc640fbbdf0ea620d326fd5e1aff0a6ba90228ef0e3345779c48e7b489e0e70" :answer/id #uuid "bc9067b1-fcbe-57a9-bb03-88132fe2d372" :answer/type :answer.type/math :answer/value "-\\operatorname{cot}⁡x-\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114350/selection/3214d90ad6002be3a8e9cb2970755384cc5f389b387a7097a385201342da529c" :answer/id #uuid "92e717c3-1802-5914-b7dc-3a561d667a80" :answer/type :answer.type/math :answer/value "\\operatorname{tan}⁡x+\\operatorname{sec}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114350/selection/cb3a7ce9765d1274916506e4364147275a5f3e5da2251cb4ce79e09da1e7af4a" :answer/id #uuid "bbf2e10b-e1d2-5090-9a10-b0e940a76022" :answer/type :answer.type/math :answer/value "\\operatorname{cot}⁡x+\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114350/selection" :answer-field/id #uuid "d1c42c27-0409-5092-81dc-3cbe6a9f5edf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114350/selection/9bc640fbbdf0ea620d326fd5e1aff0a6ba90228ef0e3345779c48e7b489e0e70" :answer-field/choices ["q-114350/selection/64772acb54332137e256b7e9d8ffcae9e71ad2377b9dd581f979df71277bbe00" "q-114350/selection/62662b4ac4ec8d8c82128be02815ae17ee676ab76d485c4e517d892ae693e4ee" "q-114350/selection/9bc640fbbdf0ea620d326fd5e1aff0a6ba90228ef0e3345779c48e7b489e0e70" "q-114350/selection/3214d90ad6002be3a8e9cb2970755384cc5f389b387a7097a385201342da529c" "q-114350/selection/cb3a7ce9765d1274916506e4364147275a5f3e5da2251cb4ce79e09da1e7af4a"] :db/ensure [:answer-field/validate]} {:db/id "q-114350" :question/id #uuid "f82c9c40-c837-59db-b9bc-4010d9750009" :question/math-academy-id "q-114350" :question/problem "$\\int \\frac{1}{1-\\operatorname{cos}⁡x}\\,\\text{d}x=$" :question/worked-solution "We use a variation of the Pythagorean identity:\n\n$$\n{sin}^{2}⁡x+{cos}^{2}⁡x=1\\,⟹\\,{sin}^{2}⁡x=1-{cos}^{2}⁡x.\n$$\n\nUsing the above, we rewrite the denominator and calculate the resulting integral:\n\n$$\n\\begin{aligned}\\int \\frac{1}{1-\\operatorname{cos}⁡x}\\,\\text{d}x & =\\int (\\frac{1}{1-\\operatorname{cos}⁡x}\\cdot \\frac{1+\\operatorname{cos}⁡x}{1+\\operatorname{cos}⁡x})\\text{d}x \\\\  & =\\int \\frac{1+\\operatorname{cos}⁡x}{1-{cos}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{1+\\operatorname{cos}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int (\\frac{1}{{sin}^{2}⁡x}+\\frac{\\operatorname{cos}⁡x}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int ({csc}^{2}⁡x+\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =-\\operatorname{cot}⁡x-\\operatorname{csc}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114350/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19a857ac-d36b-5753-a532-4f2a75612d85"] :knowledge-point/questions ["q-114350"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49446/selection/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f" :answer/id #uuid "001494b8-9d22-5886-bc46-d1cc13086de7" :answer/type :answer.type/math :answer/value "-2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-49446/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "fb0d6b93-dbfb-5dbe-bc89-3f9e48f7f6f4" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-49446/selection/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" :answer/id #uuid "7ed3d9ae-2e97-5009-b834-7cae8eb79b29" :answer/type :answer.type/math :answer/value "-\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-49446/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "0909d7a3-2704-5782-be52-66358d672a4b" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-49446/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d9747286-5341-5306-82dc-b77a4ae5e167" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-49446/selection" :answer-field/id #uuid "2c547227-069f-5443-b066-444125ae8567" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49446/selection/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f" :answer-field/choices ["q-49446/selection/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f" "q-49446/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" "q-49446/selection/b7e1c893089e9c7b8066a199c43cdff517fe004f1db62d878596274884ad36ec" "q-49446/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-49446/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-49446" :question/id #uuid "746c162e-1c21-5e8a-abb9-51161d5b4acf" :question/math-academy-id "q-49446" :question/problem "Evaluate ${\\int }_{\\pi /6}^{5\\pi /6}\\frac{1}{{cos}^{2}⁡x-1}\\,\\text{d}x.$" :question/worked-solution "Recall  ${cos}^{2}⁡x+{sin}^{2}⁡x=1.$ \nTherefore,\n\n$$\n\\frac{1}{{cos}^{2}⁡x-1}=\\frac{1}{-{sin}^{2}⁡x}=-{csc}^{2}⁡x.\n$$\n\nHence,\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{5\\pi /6}\\frac{1}{{cos}^{2}⁡x-1}\\,\\text{d}x & =-{\\int }_{\\pi /6}^{5\\pi /6}{csc}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{cot}⁡x{|}_{\\pi /6}^{5\\pi /6} \\\\  & =\\operatorname{cot}⁡\\frac{5\\pi }{6}-\\operatorname{cot}⁡\\frac{\\pi }{6} \\\\  & =-\\sqrt{3}-\\sqrt{3} \\\\  & =-2\\sqrt{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49446/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "19a857ac-d36b-5753-a532-4f2a75612d85"] :knowledge-point/questions ["q-49446"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49325/selection/872eca3454d90bdd32b2a3a22d2e659a1e99e055193392a3ae1a3866017878db" :answer/id #uuid "0c24d83a-967e-5ba4-9b86-7c5ec26c72a7" :answer/type :answer.type/math :answer/value "6-2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-49325/selection/e6debaeeb346598c553250e2e8ec008ffa62d42c74ba7404ededccf0e153475e" :answer/id #uuid "b1acdfb2-6bc2-5f84-8bc2-1e1442e18197" :answer/type :answer.type/math :answer/value "2\\sqrt{3}-2" :db/ensure [:answer/validate]} {:db/id "q-49325/selection/2d6c2e645776308baea53cd64e0f2e6be0d953e9204f9760e8ba5d25d8da1bd4" :answer/id #uuid "e679cfa4-f400-5152-9ad2-e57c5cd09050" :answer/type :answer.type/math :answer/value "6\\sqrt{3}-6" :db/ensure [:answer/validate]} {:db/id "q-49325/selection/8c0c7337a57049a19f0f898661900c7d2e23a0d247e7f93a5f37817dba56782e" :answer/id #uuid "c9a9610d-0636-532b-a80b-358c504d65e8" :answer/type :answer.type/math :answer/value "\\sqrt{3}+6" :db/ensure [:answer/validate]} {:db/id "q-49325/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "5c8b83ae-7404-55d6-a950-0d46a83dd1af" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-49325/selection" :answer-field/id #uuid "cb5ea80d-b788-58ce-aae1-1b363f933ce7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49325/selection/872eca3454d90bdd32b2a3a22d2e659a1e99e055193392a3ae1a3866017878db" :answer-field/choices ["q-49325/selection/872eca3454d90bdd32b2a3a22d2e659a1e99e055193392a3ae1a3866017878db" "q-49325/selection/e6debaeeb346598c553250e2e8ec008ffa62d42c74ba7404ededccf0e153475e" "q-49325/selection/2d6c2e645776308baea53cd64e0f2e6be0d953e9204f9760e8ba5d25d8da1bd4" "q-49325/selection/8c0c7337a57049a19f0f898661900c7d2e23a0d247e7f93a5f37817dba56782e" "q-49325/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629"] :db/ensure [:answer-field/validate]} {:db/id "q-49325" :question/id #uuid "f125d694-dddf-5296-9b7a-4f3ef4027f35" :question/math-academy-id "q-49325" :question/problem "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}\\frac{3(\\operatorname{sec}⁡x-1)}{\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sec}⁡x+1}{\\operatorname{tan}⁡x}\\,\\text{d}x.$" :question/worked-solution "We are using the identity\n\n$$\n{tan}^{2}⁡x+1={sec}^{2}⁡x\\,⟹\\,{tan}^{2}⁡x={sec}^{2}⁡x-1.\n$$\n\nHence,\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}\\frac{3(\\operatorname{sec}⁡x-1)}{\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{sec}⁡x+1}{\\operatorname{tan}⁡x}\\,\\text{d}x & =3{\\int }_{\\pi /6}^{\\pi /3}\\frac{({sec}^{2}⁡x-1)}{\\operatorname{cos}⁡x\\operatorname{tan}⁡x}\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /6}^{\\pi /3}\\frac{{tan}^{2}⁡x}{\\operatorname{cos}⁡x\\operatorname{tan}⁡x}\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /6}^{\\pi /3}\\frac{\\operatorname{tan}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x \\\\  & =3{\\int }_{\\pi /6}^{\\pi /3}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sec}⁡x\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =3\\operatorname{sec}⁡(\\frac{\\pi }{3})-3\\operatorname{sec}⁡(\\frac{\\pi }{6}) \\\\  & =3\\cdot 2-3\\cdot \\frac{2}{\\sqrt{3}} \\\\  & =6-2\\sqrt{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-49325/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7"] :knowledge-point/questions ["q-49325"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114435/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "10dec266-73ee-5d09-982d-ca8f1e21272e" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-114435/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "6df78d83-aa18-5e16-b7fb-4f1b761885c5" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-114435/selection/2928cadc70d5b702972833091abf1ef12b1231b3d41635f0fa3e5d01b4fa7d3c" :answer/id #uuid "b081bbe0-f271-500e-8c58-531d3b64e372" :answer/type :answer.type/math :answer/value "2\\sqrt{3}-1" :db/ensure [:answer/validate]} {:db/id "q-114435/selection/f693d32aa6c9fb64d499c9cda5efef8df8fdec9948a874d1683bfd3121ebae2f" :answer/id #uuid "b2c80570-f736-56ac-b8c9-4ffdbfb59dec" :answer/type :answer.type/math :answer/value "3\\sqrt{2}+1" :db/ensure [:answer/validate]} {:db/id "q-114435/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9" :answer/id #uuid "8ca0a295-2e04-58f5-b605-f58721b4a899" :answer/type :answer.type/math :answer/value "\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-114435/selection" :answer-field/id #uuid "90b561d7-1ab3-5ed5-8e23-a038e6363ff8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114435/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-114435/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-114435/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-114435/selection/2928cadc70d5b702972833091abf1ef12b1231b3d41635f0fa3e5d01b4fa7d3c" "q-114435/selection/f693d32aa6c9fb64d499c9cda5efef8df8fdec9948a874d1683bfd3121ebae2f" "q-114435/selection/73eeaf3fae024b54005d89a5185040ad67cf4b6c72d401d6ad32bf0e79c13de9"] :db/ensure [:answer-field/validate]} {:db/id "q-114435" :question/id #uuid "38766e50-1265-5daf-a576-57dfb7a41e67" :question/math-academy-id "q-114435" :question/problem "${\\int }_{0}^{\\pi }({cos}^{3}⁡x+{tan}^{2}⁡x{cos}^{3}⁡x)\\text{d}x=$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n1+{tan}^{2}⁡x={sec}^{2}⁡x.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }({cos}^{3}⁡x+{tan}^{2}⁡x{cos}^{3}⁡x)\\text{d}x & ={\\int }_{0}^{\\pi }{cos}^{3}⁡x(1+{tan}^{2}⁡x)\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }{cos}^{3}⁡x{sec}^{2}⁡x\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }{cos}^{3}⁡x\\cdot \\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi }\\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x\\,{|}_{0}^{\\pi } \\\\  & =\\operatorname{sin}⁡\\pi -\\operatorname{sin}⁡0 \\\\  & =0-0 \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114435/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9934a8da-2378-5019-a