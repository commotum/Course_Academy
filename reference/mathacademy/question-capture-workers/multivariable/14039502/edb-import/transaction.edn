s}⁡x(1+\\operatorname{tan}⁡x)\\,\\text{d}x \\\\  & =\\int \\operatorname{cos}⁡x(1+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x-\\operatorname{cos}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73526/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7"] :knowledge-point/questions ["q-73526"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10565/selection/380abccefc6d80cf4ec42f9228cec417cd6f3789ae40172c6fbb9c6648b5183f" :answer/id #uuid "2118736a-61f5-544f-b3ef-ecbe4bff3a67" :answer/type :answer.type/math :answer/value "-{x}^{3}-2\\operatorname{cot}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-10565/selection/db9cacfc3509f7134d221f026fb5096eccf058127452c03df6683c971c8ade20" :answer/id #uuid "8b0c2a01-fe89-5b2d-9b7d-aee915f17c41" :answer/type :answer.type/math :answer/value "{x}^{3}+2\\operatorname{tan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-10565/selection/2659f95051dc91c870f47835458df5833a93f19b2be003593b9fe21acf9c870f" :answer/id #uuid "72725af8-4242-5f4e-9756-310d26d4cbe5" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{3}}{2}-4\\operatorname{cot}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-10565/selection/adeb91d89139dee01eaf4cb96f7c210ab5d3eae0909bc3a44889ea3835db84f8" :answer/id #uuid "18e3cd71-98de-509e-ad4e-0c9d7f4fe6f0" :answer/type :answer.type/math :answer/value "-\\frac{{x}^{3}}{2}+4\\operatorname{tan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-10565/selection/f60627dae9101e5cf6c9e71506dfb12f97142d9662981176fe4087809566ac91" :answer/id #uuid "01e72d29-da06-53d7-8989-f238e92cbdbc" :answer/type :answer.type/math :answer/value "-{x}^{3}+4\\operatorname{tan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-10565/selection" :answer-field/id #uuid "70aa98f3-ddfc-5d05-ac4a-1fc1f7b322d4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10565/selection/f60627dae9101e5cf6c9e71506dfb12f97142d9662981176fe4087809566ac91" :answer-field/choices ["q-10565/selection/380abccefc6d80cf4ec42f9228cec417cd6f3789ae40172c6fbb9c6648b5183f" "q-10565/selection/db9cacfc3509f7134d221f026fb5096eccf058127452c03df6683c971c8ade20" "q-10565/selection/2659f95051dc91c870f47835458df5833a93f19b2be003593b9fe21acf9c870f" "q-10565/selection/adeb91d89139dee01eaf4cb96f7c210ab5d3eae0909bc3a44889ea3835db84f8" "q-10565/selection/f60627dae9101e5cf6c9e71506dfb12f97142d9662981176fe4087809566ac91"] :db/ensure [:answer-field/validate]} {:db/id "q-10565" :question/id #uuid "31a511c9-f158-5a66-beb5-cb2de94b5490" :question/math-academy-id "q-10565" :question/problem "$\\int (4-3{x}^{2}+4{tan}^{2}⁡x)\\,\\text{d}x=$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n{tan}^{2}⁡x+1={sec}^{2}⁡x\\,⟹\\,{tan}^{2}⁡x={sec}^{2}⁡x-1.\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\int (4-3{x}^{2}+4{tan}^{2}⁡x)\\,\\text{d}x & =\\int (4-3{x}^{2}+4({sec}^{2}⁡x-1))\\,\\text{d}x \\\\  & =\\int (4-3{x}^{2}+4{sec}^{2}⁡x-4)\\,\\text{d}x \\\\  & =\\int (-3{x}^{2}+4{sec}^{2}⁡x)\\,\\text{d}x \\\\  & =-3\\cdot \\frac{{x}^{3}}{3}+4\\operatorname{tan}⁡x+C \\\\  & =-{x}^{3}+4\\operatorname{tan}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-10565/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7"] :knowledge-point/questions ["q-10565"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73513/selection/2b44e6d43e3927389e0c1c2c163b7136f70bbb82b73accf5d4c97d2f0dd2b207" :answer/id #uuid "c274f2bb-9344-51a6-a7f9-0fb0b7f0e920" :answer/type :answer.type/math :answer/value "\\sqrt{2}-2" :db/ensure [:answer/validate]} {:db/id "q-73513/selection/51fcb3ab094675d4b3402ff8be53e0d9395d3bacc8fd3ad2f3244fe0760