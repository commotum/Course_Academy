{3})-\\operatorname{sin}⁡(0+\\frac{\\pi }{3}) \\\\  & =\\operatorname{sin}⁡(\\pi )-\\operatorname{sin}⁡(\\frac{\\pi }{3}) \\\\  & =0-\\frac{\\sqrt{3}}{2} \\\\  & =-\\frac{\\sqrt{3}}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "q-352757" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/activity-metadata.json" "file_sha256" "c15144e6a99feb7c06ddce219e48d16d26aa9d46527e66c83a77c81d177dfa44"} {"question" "q-352757" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "q-352757" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{\\sqrt{3}}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "q-114469" "field" nil "attribute" "question/problem" "value" "Calculate $\\int \\frac{1}{{tan}^{2}⁡(2x+\\frac{\\pi }{5})\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})+\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "q-114469" "field" nil "attribute" "question/worked-solution" "value" "From the identity $1+{tan}^{2}⁡\\theta ={sec}^{2}⁡\\theta ,$ with $\\theta =2x+\\frac{\\pi }{5},$ we get \n\n$$\n\\begin{aligned}1+{tan}^{2}⁡(2x+\\frac{\\pi }{5})={sec}^{2}⁡(2x+\\frac{\\pi }{5}).\\end{aligned}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}\\int \\frac{1}{{tan}^{2}⁡(2x+\\frac{\\pi }{5})\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})+\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x & = \\\\ \\int \\frac{1}{[{tan}^{2}⁡(2x+\\frac{\\pi }{5})+1]\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x & = \\\\ \\int \\frac{1}{{sec}^{2}⁡(2x+\\frac{\\pi }{5})\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x & = \\\\ \\int \\frac{{cos}^{2}⁡(2x+\\frac{\\pi }{5})}{\\operatorname{cos}⁡(2x+\\frac{\\pi }{5})}\\,\\text{d}x & = \\\\ \\int \\operatorname{cos}⁡(2x+\\frac{\\pi }{5})\\text{d}x & = \\\\ \\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C & .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "q-114469" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/activity-metadata.json" "file_sha256" "c15144e6a99feb7c06ddce219e48d16d26aa9d46527e66c83a77c81d177dfa44"} {"question" "q-114469" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "q-114469" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C"] ["math" "-\\frac{1}{2}\\operatorname{tan}⁡(2x+\\frac{\\pi }{5})+C"] ["math" "2\\operatorname{sec}⁡(2x+\\frac{\\pi }{5})+C"] ["math" "2\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C"] ["math" "\\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "q-114469" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}\\operatorname{sin}⁡(2x+\\frac{\\pi }{5})+C"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/state.json" "file_sha256" "8979bec965fc1baba21a7f08ac71c63b309dd8b2f25d6bd29bb0054459a34af3"} {"question" "e-477" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\displaystyle\\int \\dfrac{1}{1-\\sin^2 x}\\,\\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-477.json" "file_sha256" "33a6fb5067d0a9efaf01c1f5cedcb1ea3a49856e6344dcc1c050d26e6b496184"} {"question" "e-477" "field" nil "attribute" "question/worked-solution" "value" "We use a variation of the Pythagorean identity:\n\n$$\n\\sin^2 x + \\cos^2 x = 1\\quad\\Longrightarrow\\quad  \\cos^2 x = 1-\\sin^2 x.\n$$\n\nUsing the above, we rewrite the denominator and calculate the resulting integral:\n\n$$\n\\begin{aligned}\\int \\frac{1}{1-{sin}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & =\\int {(\\frac{1}{\\operatorname{cos}⁡x})}^{2}\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡x\\,\\text{d}x \\\\  & =\\operatorname{tan}⁡x+C.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-477.json" "file_sha256" "33a6fb5067d0a9efaf01c1f5cedcb1ea3a49856e6344dcc1c050d26e6b496184"} {"question" "e-478" "field" nil "attribute" "question/problem" "value" "Calculate $\\, \\displaystyle{\\int} \\tan^2 x \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-478.json" "file_sha256" "5aa058c8db4b888fa28de731cf2c707eac712f54c3919fed45d4e65cb913a59a"} {"question" "e-478" "field" nil "attribute" "question/worked-solution" "value" "First, we select the identity that contains a $\\tan^2{x}$ term. So we can use the identity \n\n$$\n1+\\tan^2x =\\sec^2x.\n$$\n\nRearranging the above identity gives\n\n$$\n\\tan^2 x =\\sec^2 x -1.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\eqalign{\n\t\t\\int \\tan^2 x \\, \\textrm{d}x&=\\int \\left(\\sec^2 x -1\\right ) \\, \\textrm{d}x\\\n\t\t\t\t&=\\tan x -x+C.\t\n\t}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-478.json" "file_sha256" "5aa058c8db4b888fa28de731cf2c707eac712f54c3919fed45d4e65cb913a59a"} {"question" "e-479" "field" nil "attribute" "question/problem" "value" "Calculate the integral $\\displaystyle{\\int} \\left(5\\cot^2 x -x^2\\right) \\, \\textrm{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-479.json" "file_sha256" "39c8e5a4f8461de8bb14161ec0e580a0d969324edd6bf19157b6e231fc7ee934"} {"question" "e-479" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have to use the identity  $1+\\cot^2x =\\csc^2 x.$ Rearranging this gives\n\n$$\n\\eqalign{\n\t\t\\cot^2 x &=\\csc^2 x -1.\n}\n$$\n\nSubstituting this into our integral gives\n\n$$\n\\eqalign{\n\t\t\\int \\left(5\\cot^2 x -x^2\\right) \\, \\textrm{d}x&=\\int \\bigg(5\\left(\\csc^2 x -1 \\right) -x^2\\bigg) \\, \\textrm{d}x\\\n\t\t\t\t&=\\int \\left(5\\csc^2 x -5 -x^2\\right ) \\, \\textrm{d}x\\\n\t\t\t\t&=-5\\cot x -5x-\\dfrac{x^3}{3}+C.\t\n\t}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-479.json" "file_sha256" "39c8e5a4f8461de8bb14161ec0e580a0d969324edd6bf19157b6e231fc7ee934"} {"question" "e-480" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle{\\int} 2\\tan^2 (3x) \\, \\textrm{d} x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-480.json" "file_sha256" "6d7fc04f1faa3094ccb11ab419906960d3c2515446565e5b1d0a57f11ed2bf6f"} {"question" "e-480" "field" nil "attribute" "question/worked-solution" "value" "From the identity  $1+\\tan^2 \\theta =\\sec^2 \\theta$ with $\\theta = 3x,$ we get \n\n$$\n\\eqalign{\n\t\t1+\\tan^2 (3x) &=\\sec^2 (3x)\\\n\t\t\\tan^2 (3x) &=\\sec^2 (3x) -1.\n}\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\eqalign{\n\t\t\\int 2\\tan^2 (3x) \\, \\textrm{d}x&= 2\\int \\tan^2 (3x) \\, \\textrm{d}x\\\n                                                                &= 2\\int \\left(\\sec^2 (3x) -1\\right ) \\, \\textrm{d}x\\\n                                                                 &= 2\\left(\\int \\sec^2 (3x)\\, \\textrm{d}x -\\int1 \\, \\textrm{d}x\\right)\\\n\t\t\t\t                                &= 2\\left( \\dfrac{1}{3}\\tan (3x) -x\\right)+C\\\n                                                                 &= \t\\dfrac{2}{3}\\tan (3x) -2x+C.\n\t}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039502/example-480.json" "file_sha256" "6d7fc04f1faa3094ccb11ab419906960d3c2515446565e5b1d0a57f11ed2bf6f"}] "usage" {"e-479" [] "q-346546" [] "q-352714"