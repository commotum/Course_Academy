#{[{:db/id #edb/ref 17592186358336 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a604bc03-6712-5fa8-888d-872bf83b126e" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186358338} {:answer/id #uuid "0b320a2e-92d8-52d4-b617-2a8f70b0421e" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186358339} {:answer/id #uuid "cefba145-4076-5b1a-aaf4-c6cc40a50274" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186358340} {:answer/id #uuid "ad076e91-5f00-51fe-8611-2b87707fb879" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186358341} {:answer/id #uuid "d0416f8b-a1ef-546a-9011-ccdc83b6c7ba" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186358342}] :answer-field/correct {:answer/id #uuid "d0416f8b-a1ef-546a-9011-ccdc83b6c7ba" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186358342} :answer-field/id #uuid "d225e5c8-4d5a-5189-b8b6-41c036c699a4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358337}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b96d3db6-3bd4-5dd7-9484-9554529374d1" :question/math-academy-id "q-176835" :question/problem "Given that the intersection of the elliptic cone $4(x+3)^{2}+8(y-1)^{2}=(z+7)^{2}$ and the plane $z=-3$ is an ellipse, what is the length of its major axis?" :question/worked-solution "To find the intersection of the elliptic cone and the plane $z=-3,$ we substitute $z=-3$ into the equation of the elliptic cone, and simplify:\n\n$$\n\\begin{aligned}4(x+3)^{2}+8(y-1)^{2} & =(-3+7)^{2} \\\\ 4(x+3)^{2}+8(y-1)^{2} & ={4}^{2} \\\\ 4(x+3)^{2}+8(y-1)^{2} & =16 \\\\ \\frac{(x+3)^{2}}{4}+\\frac{(y-1)^{2}}{2} & =1 \\\\ \\frac{(x+3)^{2}}{(2)^{2}}+\\frac{(y-1)^{2}}{(\\sqrt{2})^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of an ellipse with a semi-major axis of length $a=2.$ Therefore, the major axis has length $2a=4.$"}] [{:db/id #edb/ref 17592186358343 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "19a1186f-a0d0-5d5b-8197-3be95d11afca" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,2,0)$ and $(0,8,0)$" :db/id #edb/ref 17592186358345} {:answer/id #uuid "262ccc4a-af82-5a73-a381-44194d3ef864" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186358346} {:answer/id #uuid "e64769c2-52db-563f-99de-1074eadc650f" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,8,0)$" :db/id #edb/ref 17592186358347} {:answer/id #uuid "5dccf284-0efc-58f6-a80c-6dcaab5866c0" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,4,0)$ and $(0,16,0)$" :db/id #edb/ref 17592186358348} {:answer/id #uuid "49fcc5ae-e407-5787-8866-c8c13c0ca631" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,4,0)$ only" :db/id #edb/ref 17592186358349}] :answer-field/correct {:answer/id #uuid "e64769c2-52db-563f-99de-1074eadc650f" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,8,0)$" :db/id #edb/ref 17592186358347} :answer-field/id #uuid "630226da-dbc8-5d59-8f8e-f0c32d2f4dbd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358344}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2e9f175e-8026-51c8-a30f-c784766388ba" :question/math-academy-id "q-94485" :question/problem "Given the elliptic cone $\\frac{(x-6)^{2}}{9}+\\frac{(y-4)^{2}}{8}=\\frac{(z+6)^{2}}{6},$ find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the elliptic cone, we plug $x=0$ and $z=0$ into the equation and solve for $y:$\n\n$$\n\\begin{aligned}\\frac{(0-6)^{2}}{9}+\\frac{(y-4)^{2}}{8} & =\\frac{(0+6)^{2}}{6} \\\\ \\frac{36}{9}+\\frac{(y-4)^{2}}{8} & =\\frac{36}{6} \\\\ 4+\\frac{(y-4)^{2}}{8} & =6 \\\\ \\frac{(y-4)^{2}}{8} & =2 \\\\ (y-4)^{2} & =16 \\\\ y-4 & =\\pm 4 \\\\ y & =4\\pm 4 \\\\ y & =0,8\\end{aligned}\n$$\n\nTherefore, the intercepts with the $y$-axis are $(0,0,0)$ and $(0,8,0).$"}] [{:db/id #edb/ref 17592186358350 :knowledge-point/_questions [{:knowledge-point/id #uuid "fb7148a2-58cc-5023-845c-435b47e31c83" :knowledge-point/title "Finding Traces of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "98ad9488-f0f3-59f3-a6fe-5837e8a90116" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm x+1" :db/id #edb/ref 17592186358352} {:answer/id #uuid "7d58e0fe-29b2-5231-94df-da48ec6ac6c9" :answer/type {:db/ident :answer.type/math} :answer/value "z=-x" :db/id #edb/ref 17592186358353} {:answer/id #uuid "20bc7cb0-2d31-5c85-aceb-46ef1a12734e" :answer/type {:db/ident :answer.type/text} :answer/value "$z=-x-2,\\,$ $z=-x$" :db/id #edb/ref 17592186358354} {:answer/id #uuid "ad600997-cab7-59fb-a5bb-6ece9ab1b40b" :answer/type {:db/ident :answer.type/math} :answer/value "z=\\pm x-2" :db/id #edb/ref 17592186358355} {:answer/id #uuid "fc590fb5-d7a0-5705-936f-881aef7fc854" :answer/type {:db/ident :answer.type/text} :answer/value "$z=-x,\\,$ $z=x+2$" :db/id #edb/ref 17592186358356}] :answer-field/correct {:answer/id #uuid "fc590fb5-d7a0-5705-936f-881aef7fc854" :answer/type {:db/ident :answer.type/text} :answer/value "$z=-x,\\,$ $z=x+2$" :db/id #edb/ref 17592186358356} :answer-field/id #uuid "b2cbb472-de5f-5adf-a705-50a67dfcb947" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358351}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4d859ee6-f828-506d-b2a6-7efbe3346f4b" :question/math-academy-id "q-94490" :question/problem "What is the trace in the $xz$-plane of the elliptic cone $(x+1)^{2}+\\frac{{y}^{2}}{6}=(z-1)^{2}\\,?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the elliptic cone, as follows:\n\n$$\n\\begin{aligned}(x+1)^{2}+\\frac{{0}^{2}}{6} & =(z-1)^{2} \\\\ (x+1)^{2} & =(z-1)^{2} \\\\ \\pm (x+1) & =z-1 \\\\ z & =\\pm (x+1)+1\\end{aligned}\n$$\n\nThis gives us two lines in the $xz$-plane with equations $z=-x$ and $z=x+2.$"}] [{:db/id #edb/ref 17592186358357 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e813f2-ff0e-5444-b24d-35fbf57139d3" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,3)$ only" :db/id #edb/ref 17592186358359} {:answer/id #uuid "39bb41fa-2935-5219-b051-6a8e275a4ec2" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ and $(0,0,3)$" :db/id #edb/ref 17592186358360} {:answer/id #uuid "81397cd7-2353-51a1-ba5c-5a2ad2ea786c" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186358361} {:answer/id #uuid "b06dd098-9318-5786-8c3a-4a2ddc0fcf94" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,1)$ only" :db/id #edb/ref 17592186358362} {:answer/id #uuid "ba5c84d1-9e18-55ae-8530-8c570ca232f6" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,1)$ and $(0,0,9)$" :db/id #edb/ref 17592186358363}] :answer-field/correct {:answer/id #uuid "81397cd7-2353-51a1-ba5c-5a2ad2ea786c" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0,0)$ only" :db/id #edb/ref 17592186358361} :answer-field/id #uuid "212e1aac-59ad-53d3-ba77-fdc95dfe2dd3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358358}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "44fae6f3-1352-5773-b683-7be2b7277a05" :question/math-academy-id "q-94605" :question/problem "Given the elliptic cone $\\frac{{x}^{2}}{2}+\\frac{{y}^{2}}{9}={z}^{2},$ find its intercept with the $z$-axis." :question/worked-solution "To find the $z$-intercept of the elliptic cone, we plug $x=0$ and $y=0$ into the equation and solve for $z:$\n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{2}+\\frac{{0}^{2}}{9} & ={z}^{2} \\\\ 0+0 & ={z}^{2} \\\\ {z}^{2} & =0 \\\\ z & =0\\end{aligned}\n$$\n\nTherefore, the intercept with the $z$-axis is $(0,0,0)$ only."}] [{:db/id #edb/ref 17592186358364 :knowledge-point/_questions [{:knowledge-point/id #uuid "2e0b4012-403b-5739-8f33-3c79111129fd" :knowledge-point/title "Identifying Properties of Elliptic Cones"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6caf5be3-72ab-5114-9ce8-5796b324e988" :answer/type {:db/ident :answer.type/math} :answer/value "(3,2,0)" :db/id #edb/ref 17592186358366} {:answer/id #uuid "7bf00957-4239-53b5-a587-5f4c553ebaf3" :answer/type {:db/ident :answer.type/math} :answer/value "(-9,-4,0)" :db/id #edb/ref 17592186358367} {:answer/id #uuid "def33a8a-7ed1-521d-8ef8-d3d7153aedb2" :answer/type {:db/ident :answer.type/math} :answer/value "(9,4,1)" :db/id #edb/ref 17592186358368} {:answer/id #uuid "9eab0653-fbac-5a84-a3c4-cb16e5c433d5" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-2,0)" :db/id #edb/ref 17592186358369} {:answer/id #uuid "f74cb226-6321-5bab-b031-b5d47abbda2a" :answer/type {:db/ident :answer.type/math} :answer/value "(4,9,0)" :db/id #edb/ref 17592186358370}] :answer-field/correct {:answer/id #uuid "9eab0653-fbac-5a84-a3c4-cb16e5c433d5" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-2,0)" :db/id #edb/ref 17592186358369} :answer-field/id #uuid "44ee014d-2d30-51a5-a5f4-af0e289c22f5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358365}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bcc2e3e3-89bb-5607-9c6a-ce5e59ebb032" :question/math-academy-id "q-94698" :question/problem "Find the center of the elliptic cone $9(x+3)^{2}+4(y+2)^{2}={z}^{2}.$" :question/worked-solution "The general equation of an elliptic cone with center at the point $({x}_{0},{y}_{0},{z}_{0})$ is\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=\\frac{(z-{z}_{0})^{2}}{{c}^{2}}.\n$$\n\nTo find the center, we rewrite our equation in standard form, as follows:\n\n$$\n\\begin{aligned}9(x+3)^{2}+4(y+2)^{2} & =(z-0)^{2} \\\\ \\frac{(x+3)^{2}}{1/9}+\\frac{(y+2)^{2}}{1/4} & =(z-0)^{2} \\\\ \\frac{(x-(-3))^{2}}{1/9}+\\frac{(y-(-2))^{2}}{1/4} & =(z-0)^{2}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic cone that has its center at $(-3,-2,0).$"}]}
