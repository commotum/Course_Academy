n/ma-v1/6a2a6cf36b2e6794dcc42479c7eea57a65d5b9c7fce89db603ab5168f67d1ccf/d57f2ad494fa283ef82d0d06c1fff673f189d4b7abd60c0c2e9870f66e49fdc0" "q-164554/selection/ma-v1/6a2a6cf36b2e6794dcc42479c7eea57a65d5b9c7fce89db603ab5168f67d1ccf/cc0abe2950717f944b73bdf16f5b650bd75253fcd19c569c17c6c83f1ab4b948" "q-164554/selection/ma-v1/6a2a6cf36b2e6794dcc42479c7eea57a65d5b9c7fce89db603ab5168f67d1ccf/ff6b6729f9bf5e9401deb2a8b8eaf88af681b123f1d602700e6259e83b02ff9f" "q-164554/selection/ma-v1/6a2a6cf36b2e6794dcc42479c7eea57a65d5b9c7fce89db603ab5168f67d1ccf/a316cf17e8adc781c6f9018c5701a19dc063c557155b127265cdf908ea5d8036" "q-164554/selection/ma-v1/6a2a6cf36b2e6794dcc42479c7eea57a65d5b9c7fce89db603ab5168f67d1ccf/314c0e2c3813590fedc9373e371623c0869159ab7ff2bdc92c84fde5b42d796f"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-164554"] :question/problem "Identify the surface $2{x}^{2}-4{z}^{2}-4x-y-16z-12=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}-4{z}^{2}-4x-y-16z-12 & =0 \\\\ 2({x}^{2}-2x)-4({z}^{2}+4z)-y-12 & =0 \\\\ 2[(x-1)^{2}-1]-4[(z+2)^{2}-4]-y-12 & =0 \\\\ 2(x-1)^{2}-2-4(z+2)^{2}+16-y-12 & =0 \\\\ 2(x-1)^{2}-4(z+2)^{2}-y+2 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}2(x-1)^{2}-4(z+2)^{2}-y+2 & =0 \\\\ 2(x-1)^{2}-4(z+2)^{2} & =y-2\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164554/selection/ma-v1/6a2a6cf36b2e6794dcc42479c7eea57a65d5b9c7fce89db603ab5168f67d1ccf"] :db/ensure [:question/validate]}]
