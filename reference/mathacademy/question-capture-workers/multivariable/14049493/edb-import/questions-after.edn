#{[{:db/id #edb/ref 17592186328521 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "89af1e7c-c3a1-5339-bb8b-267da86d4daf" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186328523} {:answer/id #uuid "794382d4-742b-53e8-9753-220a115e6567" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186328524} {:answer/id #uuid "e6d6f6c9-7294-57c5-97ec-e95d45e9010d" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186328525} {:answer/id #uuid "05abe101-a679-5d20-ad6f-15cce82f5363" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186328526} {:answer/id #uuid "7b6a4dd6-e93c-53d2-93f4-e65d3bf0bdfc" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186328527}] :answer-field/correct {:answer/id #uuid "05abe101-a679-5d20-ad6f-15cce82f5363" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186328526} :answer-field/id #uuid "9f1f48ec-f198-5132-baa6-5342954a551c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328522}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "04bdbcd8-5184-50ec-95c0-30cd62912fcf" :question/math-academy-id "q-164543" :question/problem "Identify the following surface:\n\n$$\n4{y}^{2}-3{z}^{2}=1,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1.\n$$\n\nThus, a hyperbolic cylinder whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is a hyperbolic cylinder whose axis of symmetry is the $x$-axis and $b=\\frac{1}{2},\\,c=\\frac{1}{\\sqrt{3}}.$"}] [{:db/id #edb/ref 17592186124750 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a52c8352-cfdf-562e-8bf3-f80b96c4b25a" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186121520} {:answer/id #uuid "c6131658-59d8-5a77-b93e-af3d9d8c3ae7" :answer/type {:db/ident :answer.type/text} :answer/value "A couple of planes" :db/id #edb/ref 17592186121521} {:answer/id #uuid "ee58015b-3735-53a1-a71d-085378884c82" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186121522} {:answer/id #uuid "0335e136-69cc-5af4-9a07-9497f58cae5f" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186121523} {:answer/id #uuid "6215d633-c611-5eec-aa37-d362a42d6f2d" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186121524}] :answer-field/correct {:answer/id #uuid "0335e136-69cc-5af4-9a07-9497f58cae5f" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186121523} :answer-field/id #uuid "b98b7030-0771-5018-83cb-6ba7eef7c035" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121519}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "44fe2c9a-8d31-5524-87d8-4678d7fc0908" :question/math-academy-id "q-164546" :question/problem "Identify the following surface:\n\n$$\n{z}^{2}=8x,\\,-\\infty <y<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $y$**-axis** is given by\n\n$$\n{z}^{2}=4px.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $y$-axis and $p=2.$"}] [{:db/id #edb/ref 17592186328528 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c07a0479-c158-5418-8e34-3cb54ed63446" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,-1)$" :db/id #edb/ref 17592186328530} {:answer/id #uuid "c15cb172-fd51-5d68-80e9-8ec8a7524ecd" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186328531} {:answer/id #uuid "4c5b3b90-c0cf-58d2-8dc9-9c06bb449cdb" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186328532} {:answer/id #uuid "a1881301-07f4-5c0b-8692-093388d99a9a" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(-2,0,1)$" :db/id #edb/ref 17592186328533} {:answer/id #uuid "a9b83159-4a2d-5b01-8fa3-91cb0c875eae" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,1,1)$" :db/id #edb/ref 17592186328534}] :answer-field/correct {:answer/id #uuid "c15cb172-fd51-5d68-80e9-8ec8a7524ecd" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(-2,0,1)$" :db/id #edb/ref 17592186328531} :answer-field/id #uuid "5407159f-a658-5b9a-ad76-87aadca70039" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328529}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "040e9acf-1af9-5813-86f6-e469cb0eecc9" :question/math-academy-id "q-164553" :question/problem "Identify the surface $5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}5{x}^{2}-{y}^{2}-5{z}^{2}+20x+10z+15 & =0 \\\\ 5({x}^{2}+4x)-{y}^{2}-5({z}^{2}-2z)+15 & =0 \\\\ 5[(x+2)^{2}-4]-{y}^{2}-5[(z-1)^{2}-1]+15 & =0 \\\\ 5(x+2)^{2}-20-{y}^{2}-5(z-1)^{2}+5+15 & =0 \\\\ 5(x+2)^{2}-{y}^{2}-5(z-1)^{2} & =0 \\\\ -5(x+2)^{2}+{y}^{2}+5(z-1)^{2} & =0\\end{aligned}\n$$\n\nThis is the equation of an elliptic cone centered at $(-2,0,1).$"}] [{:db/id #edb/ref 17592186124751 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "157fbd6a-a77b-5618-9b19-388445f43afb" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(-1,-2,2)$" :db/id #edb/ref 17592186328536} {:answer/id #uuid "93ad502e-fcbc-5c84-b9e8-37d844283082" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,-2,2).$" :db/id #edb/ref 17592186328537} {:answer/id #uuid "688b7f3b-2753-54dd-a9c4-f60886b03d26" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,2,-2)$" :db/id #edb/ref 17592186328538} {:answer/id #uuid "d882279e-5c27-5de6-a30f-6ae4dde6ffe7" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-2).$" :db/id #edb/ref 17592186328539} {:answer/id #uuid "75c3feb1-da78-5989-80bf-0c2adacfe488" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,2,-2).$" :db/id #edb/ref 17592186328540}] :answer-field/correct {:answer/id #uuid "d882279e-5c27-5de6-a30f-6ae4dde6ffe7" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,2,-2).$" :db/id #edb/ref 17592186328539} :answer-field/id #uuid "12138bf4-9404-5ade-9a92-7f9b6d0b2b04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186328535}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "acd3345e-478a-507e-b6c0-b18910d49c60" :question/math-academy-id "q-164554" :question/problem "Identify the surface $2{x}^{2}-4{z}^{2}-4x-y-16z-12=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}2{x}^{2}-4{z}^{2}-4x-y-16z-12 & =0 \\\\ 2({x}^{2}-2x)-4({z}^{2}+4z)-y-12 & =0 \\\\ 2[(x-1)^{2}-1]-4[(z+2)^{2}-4]-y-12 & =0 \\\\ 2(x-1)^{2}-2-4(z+2)^{2}+16-y-12 & =0 \\\\ 2(x-1)^{2}-4(z+2)^{2}-y+2 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}2(x-1)^{2}-4(z+2)^{2}-y+2 & =0 \\\\ 2(x-1)^{2}-4(z+2)^{2} & =y-2\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1,2,-2).$"}] [{:db/id #edb/ref 17592186124863 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94646554-5721-5e58-ae8c-f258da8b7121" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1, 0,-2)$" :db/id #edb/ref 17592186122201} {:answer/id #uuid "c4a726ac-ed05-572d-9136-c21747191b18" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1, 0, 2)$" :db/id #edb/ref 17592186122202} {:answer/id #uuid "f4f2d242-2f61-5045-b33e-bbb78e50d7b6" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(-1, 0, 2)$" :db/id #edb/ref 17592186122203} {:answer/id #uuid "02b02cf5-09b2-5c9e-aa2c-b5a521812ebe" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1, 0,-2)$" :db/id #edb/ref 17592186122204} {:answer/id #uuid "73387278-8536-561c-b98e-9a1673daf65a" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1, 0,-2)$" :db/id #edb/ref 17592186122205}] :answer-field/correct {:answer/id #uuid "02b02cf5-09b2-5c9e-aa2c-b5a521812ebe" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1, 0,-2)$" :db/id #edb/ref 17592186122204} :answer-field/id #uuid "3d43716f-4487-5752-a5b4-4ff001178448" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122200}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b89a321a-d26e-5cd5-a353-0b2111467458" :question/math-academy-id "q-36015" :question/problem "Identify the surface $4{x}^{2}+8{y}^{2}+2{z}^{2}-8x+8z+4=0.$" :question/worked-solution "First, we complete the square in the $x$ and $z$ terms:\n\n$$\n\\begin{aligned}4{x}^{2}+8{y}^{2}+2{z}^{2}-8x+8z+4 & =0 \\\\ 4({x}^{2}-2x)+8{y}^{2}+2({z}^{2}+4z)+4 & =0 \\\\ 4[(x-1)^{2}-1]+8{y}^{2}+2[(z+2)^{2}-4]+4 & =0 \\\\ 4(x-1)^{2}-4+8{y}^{2}+2(z+2)^{2}-8+4 & =0 \\\\ 4(x-1)^{2}+8{y}^{2}+2(z+2)^{2}-8 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(x-1)^{2}+8{y}^{2}+2(z+2)^{2}-8 & =0 \\\\ 4(x-1)^{2}+8{y}^{2}+2(z+2)^{2} & =8 \\\\ \\frac{4(x-1)^{2}}{8}+\\frac{8{y}^{2}}{8}+\\frac{2(z+2)^{2}}{8} & =1 \\\\ \\frac{(x-1)^{2}}{2}+{y}^{2}+\\frac{(z+2)^{2}}{4} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipsoid centered at $(1,0,-2).$"}]}
