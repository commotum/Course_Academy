#{[{:db/id #edb/ref 17592186379678 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "64b70e69-43eb-5fb2-b6e6-a7800efb685c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{22}{\\sqrt{23}}" :db/id #edb/ref 17592186379680} {:answer/id #uuid "b8269272-7858-53d9-817d-3b20091ab3e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{\\sqrt{22}}" :db/id #edb/ref 17592186379681} {:answer/id #uuid "6c847c9a-fe8e-5965-9343-66f7254f1811" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{\\sqrt{33}}" :db/id #edb/ref 17592186379682} {:answer/id #uuid "9d19462a-6882-5925-a88a-b9e3d986f194" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{3\\sqrt{11}}" :db/id #edb/ref 17592186379683} {:answer/id #uuid "25409f85-a599-56a5-a0f8-291f980ec147" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{2\\sqrt{11}}" :db/id #edb/ref 17592186379684}] :answer-field/correct {:answer/id #uuid "b8269272-7858-53d9-817d-3b20091ab3e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{23}{\\sqrt{22}}" :db/id #edb/ref 17592186379681} :answer-field/id #uuid "71f4321b-bae9-5be0-a276-06c975b71d79" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379679}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c316905d-619f-5b92-80c9-6008ecd83837" :question/math-academy-id "q-19142" :question/problem "Let $p=⟨4,1,4⟩$ and $q=⟨2,3,3⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379685 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0600cdec-d349-5914-b21c-1db6275f7504" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186379687} {:answer/id #uuid "cad80365-ee5a-54b5-9f58-efa30a61b498" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{13}" :db/id #edb/ref 17592186379688} {:answer/id #uuid "ebb29635-54ad-56c4-a59c-8af02c1eb75a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{12}" :db/id #edb/ref 17592186379689} {:answer/id #uuid "f019cf2a-3fc0-5d85-8af6-03f323beabb7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{12}" :db/id #edb/ref 17592186379690} {:answer/id #uuid "ec46a469-241e-559b-8bd7-a913a584f9e3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186379691}] :answer-field/correct {:answer/id #uuid "ebb29635-54ad-56c4-a59c-8af02c1eb75a" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{13}{12}" :db/id #edb/ref 17592186379689} :answer-field/id #uuid "110d4236-7ab2-5630-927c-4f3345a2e633" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379686}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f8f33e2a-bf56-56a0-b6af-c35da18edc4d" :question/math-academy-id "q-19146" :question/problem "Let $a=⟨-1,2,\\sqrt{11}⟩$ and $b=⟨4,3,\\sqrt{11}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379692 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ff28e7c0-89ab-5e2a-b27e-8f1be5b16ab0" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186379694} {:answer/id #uuid "59608811-8c58-5891-ac33-35f79e2d1c7b" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186379695} {:answer/id #uuid "355341ee-e4bd-59e7-94ca-47c21da5ac7f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186379696} {:answer/id #uuid "b7b68379-57ba-5ce7-b44e-151e9911c04b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186379697} {:answer/id #uuid "1f5f5605-ab32-58cc-a41e-cb981907061a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186379698}] :answer-field/correct {:answer/id #uuid "355341ee-e4bd-59e7-94ca-47c21da5ac7f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186379696} :answer-field/id #uuid "aa0e83e4-6568-5a7e-bd27-a92cd01b14c8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379693}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cba3474b-ca66-5fe2-a7ca-7d738cd75a7d" :question/math-academy-id "q-237014" :question/problem "Let $p=[\\begin{aligned}-2 \\\\ 0 \\\\ 5\\end{aligned}]$ and $q=[\\begin{aligned}15 \\\\ \\sqrt{2} \\\\ x\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-2)\\cdot 15+0\\cdot \\sqrt{2}+5\\cdot x \\\\  & =5x-30.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 5x-30 & =0 \\\\ 5x & =30 \\\\ x & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379699 :knowledge-point/_questions [{:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f" :knowledge-point/title "Projecting a Vector Onto a Perpendicular Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ffe4ae1-c3ab-5f5a-a5d2-a0cd749627e4" :answer/type {:db/ident :answer.type/math} :answer/value "-7" :db/id #edb/ref 17592186379701} {:answer/id #uuid "978a2d78-8fd7-512d-bd40-4cf6ddb3a84f" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186379702} {:answer/id #uuid "77e47a7a-621a-59a4-a6ec-829b3f920716" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186379703} {:answer/id #uuid "4ce1e125-6907-5808-a240-ed08471bcf52" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186379704} {:answer/id #uuid "acb42f9f-5eb3-5a10-906d-3f3abfdf9e54" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186379705}] :answer-field/correct {:answer/id #uuid "77e47a7a-621a-59a4-a6ec-829b3f920716" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186379703} :answer-field/id #uuid "8478ae4e-8ae0-5b8b-90da-e87b8f2c151c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186379700}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0f664057-d678-54c0-98a3-307fcf635d06" :question/math-academy-id "q-237015" :question/problem "Let $p=[\\begin{aligned}5 \\\\ x \\\\ 2\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -2 \\\\ -3\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =5\\cdot 4+x\\cdot (-2)+2\\cdot (-3) \\\\  & =14-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 14-2x & =0 \\\\ 2x & =14 \\\\ x & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186379706 :knowledge-point/_questions [{:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036" :knowledge-point/title "Calculating a Scalar Projection Using Components"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5d58370a-6729-5a33-89f4-6de1692dd5ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186379708}] :answer-field/correct {:answer/id #uuid "5d58370a-6729-5a33-89f4-6de1692dd5ad" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{12}{13}" :db/id #edb/ref 17592186379708} :answer-field/id #uuid "11e84dc8-d9c0-5546-bbc4-18c1890c0ca4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186379707}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1c7238f9-7302-5fb5-b053-8f1624e0ba4d" :question/math-academy-id "q-318987" :question/problem "Let $m=⟨6,8,0⟩$ and $n=⟨0,5,12⟩.$ Find ${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n.$\n\n${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =\\frac{m\\cdot n}{|\\,n\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{n}_{x}^{2}+{n}_{y}^{2}+{n}_{z}^{2}}} \\\\  & =\\frac{(6)(0)+(8)(5)+(0)(12)}{\\sqrt{{0}^{2}+{5}^{2}+{12}^{2}}} \\\\  & =\\frac{40}{\\sqrt{169}} \\\\  & =\\frac{40}{13}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{m}\\,n & =\\frac{m\\cdot n}{|\\,m\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{m}_{x}^{2}+{m}_{y}^{2}+{m}_{z}^{2}}} \\\\  & =\\frac{40}{\\sqrt{{6}^{2}+{8}^{2}+{0}^{2}}} \\\\  & =\\frac{40}{\\sqrt{100}} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n & =\\frac{40}{13}-4 \\\\  & =\\frac{40-52}{13} \\\\  & =-\\frac{12}{13}.\\end{aligned}\n$$"}]}
