[{:db/id "q-19142/selection/b32c667963a3e74315adb38736efdb60a2f5184bd88f4c098f9681fc655d1777" :answer/id #uuid "25409f85-a599-56a5-a0f8-291f980ec147" :answer/type :answer.type/math :answer/value "\\frac{23}{2\\sqrt{11}}" :db/ensure [:answer/validate]} {:db/id "q-19142/selection/412661a8d54bff0abf9edb5b468c08e1407e225adb75745bacd06a7454847e96" :answer/id #uuid "b8269272-7858-53d9-817d-3b20091ab3e1" :answer/type :answer.type/math :answer/value "\\frac{23}{\\sqrt{22}}" :db/ensure [:answer/validate]} {:db/id "q-19142/selection/8c8710b33d0e6e8f814fc839205ef61a0154bb09d610d7d7d30bafebc11f836a" :answer/id #uuid "9d19462a-6882-5925-a88a-b9e3d986f194" :answer/type :answer.type/math :answer/value "\\frac{23}{3\\sqrt{11}}" :db/ensure [:answer/validate]} {:db/id "q-19142/selection/04e8d053ab883868f9d956aac0a44eb0660c355f360f6e6bedc0f0ab065fb83b" :answer/id #uuid "64b70e69-43eb-5fb2-b6e6-a7800efb685c" :answer/type :answer.type/math :answer/value "\\frac{22}{\\sqrt{23}}" :db/ensure [:answer/validate]} {:db/id "q-19142/selection/727db542483e0ffd4a769e41fa58c94c9ea38d28fabd9d902d624bbb60910787" :answer/id #uuid "6c847c9a-fe8e-5965-9343-66f7254f1811" :answer/type :answer.type/math :answer/value "\\frac{23}{\\sqrt{33}}" :db/ensure [:answer/validate]} {:db/id "q-19142/selection" :answer-field/id #uuid "71f4321b-bae9-5be0-a276-06c975b71d79" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19142/selection/412661a8d54bff0abf9edb5b468c08e1407e225adb75745bacd06a7454847e96" :answer-field/choices ["q-19142/selection/b32c667963a3e74315adb38736efdb60a2f5184bd88f4c098f9681fc655d1777" "q-19142/selection/412661a8d54bff0abf9edb5b468c08e1407e225adb75745bacd06a7454847e96" "q-19142/selection/8c8710b33d0e6e8f814fc839205ef61a0154bb09d610d7d7d30bafebc11f836a" "q-19142/selection/04e8d053ab883868f9d956aac0a44eb0660c355f360f6e6bedc0f0ab065fb83b" "q-19142/selection/727db542483e0ffd4a769e41fa58c94c9ea38d28fabd9d902d624bbb60910787"] :db/ensure [:answer-field/validate]} {:db/id "q-19142" :question/id #uuid "c316905d-619f-5b92-80c9-6008ecd83837" :question/math-academy-id "q-19142" :question/problem "Let $p=⟨4,1,4⟩$ and $q=⟨2,3,3⟩.$ Find the scalar projection of $p$ onto $q.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{q}\\,p & =\\frac{p\\cdot q}{|\\,q\\,|} \\\\  & =\\frac{{p}_{x}{q}_{x}+{p}_{y}{q}_{y}+{p}_{z}{q}_{z}}{\\sqrt{{q}_{x}^{2}+{q}_{y}^{2}+{q}_{z}^{2}}} \\\\  & =\\frac{4\\cdot 2+1\\cdot 3+4\\cdot 3}{\\sqrt{{2}^{2}+{3}^{2}+{3}^{2}}} \\\\  & =\\frac{23}{\\sqrt{22}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-19142/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-19142"] :db/ensure [:knowledge-point/validate]} {:db/id "q-19146/selection/7ce48957c13cbafdbde3c59b7102237d54bec504ad28dcba8b06917cdb6cc51d" :answer/id #uuid "cad80365-ee5a-54b5-9f58-efa30a61b498" :answer/type :answer.type/math :answer/value "\\frac{12}{13}" :db/ensure [:answer/validate]} {:db/id "q-19146/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ec46a469-241e-559b-8bd7-a913a584f9e3" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-19146/selection/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0" :answer/id #uuid "0600cdec-d349-5914-b21c-1db6275f7504" :answer/type :answer.type/math :answer/value "-\\frac{12}{13}" :db/ensure [:answer/validate]} {:db/id "q-19146/selection/a723736f5c360d14a88f6fdd90bdd9fed8d3becdd65ef96551398412d16ea262" :answer/id #uuid "f019cf2a-3fc0-5d85-8af6-03f323beabb7" :answer/type :answer.type/math :answer/value "\\frac{13}{12}" :db/ensure [:answer/validate]} {:db/id "q-19146/selection/7ffd346f35aa271ef0e75df1fa053da10dc98a7a6d5250069ddd17d299f0e033" :answer/id #uuid "ebb29635-54ad-56c4-a59c-8af02c1eb75a" :answer/type :answer.type/math :answer/value "-\\frac{13}{12}" :db/ensure [:answer/validate]} {:db/id "q-19146/selection" :answer-field/id #uuid "110d4236-7ab2-5630-927c-4f3345a2e633" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-19146/selection/7ffd346f35aa271ef0e75df1fa053da10dc98a7a6d5250069ddd17d299f0e033" :answer-field/choices ["q-19146/selection/7ce48957c13cbafdbde3c59b7102237d54bec504ad28dcba8b06917cdb6cc51d" "q-19146/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-19146/selection/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0" "q-19146/selection/a723736f5c360d14a88f6fdd90bdd9fed8d3becdd65ef96551398412d16ea262" "q-19146/selection/7ffd346f35aa271ef0e75df1fa053da10dc98a7a6d5250069ddd17d299f0e033"] :db/ensure [:answer-field/validate]} {:db/id "q-19146" :question/id #uuid "f8f33e2a-bf56-56a0-b6af-c35da18edc4d" :question/math-academy-id "q-19146" :question/problem "Let $a=⟨-1,2,\\sqrt{11}⟩$ and $b=⟨4,3,\\sqrt{11}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" :question/worked-solution "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-19146/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-19146"] :db/ensure [:knowledge-point/validate]} {:db/id "q-237014/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "1f5f5605-ab32-58cc-a41e-cb981907061a" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-237014/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "ff28e7c0-89ab-5e2a-b27e-8f1be5b16ab0" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-237014/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "355341ee-e4bd-59e7-94ca-47c21da5ac7f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-237014/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "59608811-8c58-5891-ac33-35f79e2d1c7b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-237014/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "b7b68379-57ba-5ce7-b44e-151e9911c04b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-237014/selection" :answer-field/id #uuid "aa0e83e4-6568-5a7e-bd27-a92cd01b14c8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-237014/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-237014/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-237014/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-237014/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-237014/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-237014/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-237014" :question/id #uuid "cba3474b-ca66-5fe2-a7ca-7d738cd75a7d" :question/math-academy-id "q-237014" :question/problem "Let $p=[\\begin{aligned}-2 \\\\ 0 \\\\ 5\\end{aligned}]$ and $q=[\\begin{aligned}15 \\\\ \\sqrt{2} \\\\ x\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =(-2)\\cdot 15+0\\cdot \\sqrt{2}+5\\cdot x \\\\  & =5x-30.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 5x-30 & =0 \\\\ 5x & =30 \\\\ x & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-237014/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-237014"] :db/ensure [:knowledge-point/validate]} {:db/id "q-237015/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "4ce1e125-6907-5808-a240-ed08471bcf52" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-237015/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "978a2d78-8fd7-512d-bd40-4cf6ddb3a84f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-237015/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "77e47a7a-621a-59a4-a6ec-829b3f920716" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-237015/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "acb42f9f-5eb3-5a10-906d-3f3abfdf9e54" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-237015/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "9ffe4ae1-c3ab-5f5a-a5d2-a0cd749627e4" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-237015/selection" :answer-field/id #uuid "8478ae4e-8ae0-5b8b-90da-e87b8f2c151c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-237015/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-237015/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-237015/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-237015/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-237015/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-237015/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-237015" :question/id #uuid "0f664057-d678-54c0-98a3-307fcf635d06" :question/math-academy-id "q-237015" :question/problem "Let $p=[\\begin{aligned}5 \\\\ x \\\\ 2\\end{aligned}]$ and $q=[\\begin{aligned}4 \\\\ -2 \\\\ -3\\end{aligned}].$ Given that the scalar projection of $p$ onto $q$ is $0,$ find the value of $x.$" :question/worked-solution "Since $p$ is a nonzero vector, its scalar projection onto another nonzero vector $q$ equals zero only when the vectors are perpendicular. \n\nSo, we must have\n\n$$\np⊥q\\,⟹\\,p\\cdot q=0.\n$$\n\nComputing the dot product, we obtain\n\n$$\n\\begin{aligned}p\\cdot q & ={p}_{x}\\cdot {q}_{x}+{p}_{y}\\cdot {q}_{y}+{p}_{z}\\cdot {q}_{z} \\\\  & =5\\cdot 4+x\\cdot (-2)+2\\cdot (-3) \\\\  & =14-2x.\\end{aligned}\n$$\n\nSetting the dot product equal to $0,$ we get\n\n$$\n\\begin{aligned}p\\cdot q & =0 \\\\ 14-2x & =0 \\\\ 2x & =14 \\\\ x & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-237015/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a51e317c-f6b3-5704-afb4-bdfc79f1176f"] :knowledge-point/questions ["q-237015"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318987/field-1/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0" :answer/id #uuid "5d58370a-6729-5a33-89f4-6de1692dd5ad" :answer/type :answer.type/math :answer/value "-\\frac{12}{13}" :db/ensure [:answer/validate]} {:db/id "q-318987/field-1" :answer-field/id #uuid "11e84dc8-d9c0-5546-bbc4-18c1890c0ca4" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318987/field-1/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0" :answer-field/choices ["q-318987/field-1/64651c96922ef70544ceb56e8b9b5d96ffeff681e07d490c64d6f5f96cf439a0"] :db/ensure [:answer-field/validate]} {:db/id "q-318987" :question/id #uuid "1c7238f9-7302-5fb5-b053-8f1624e0ba4d" :question/math-academy-id "q-318987" :question/problem "Let $m=⟨6,8,0⟩$ and $n=⟨0,5,12⟩.$ Find ${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n.$\n\n${\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n=$\n{{field-1}}" :question/worked-solution "Using the scalar projection formula, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m & =\\frac{m\\cdot n}{|\\,n\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{n}_{x}^{2}+{n}_{y}^{2}+{n}_{z}^{2}}} \\\\  & =\\frac{(6)(0)+(8)(5)+(0)(12)}{\\sqrt{{0}^{2}+{5}^{2}+{12}^{2}}} \\\\  & =\\frac{40}{\\sqrt{169}} \\\\  & =\\frac{40}{13}.\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{m}\\,n & =\\frac{m\\cdot n}{|\\,m\\,|} \\\\  & =\\frac{{m}_{x}{n}_{x}+{m}_{y}{n}_{y}+{m}_{z}{n}_{z}}{\\sqrt{{m}_{x}^{2}+{m}_{y}^{2}+{m}_{z}^{2}}} \\\\  & =\\frac{40}{\\sqrt{{6}^{2}+{8}^{2}+{0}^{2}}} \\\\  & =\\frac{40}{\\sqrt{100}} \\\\  & =4.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\text{comp}}_{n}\\,m-{\\text{comp}}_{m}\\,n & =\\frac{40}{13}-4 \\\\  & =\\frac{40-52}{13} \\\\  & =-\\frac{12}{13}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-318987/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "91691448-c59a-56dc-a775-d4e9c3297036"] :knowledge-point/questions ["q-318987"] :db/ensure [:knowledge-point/validate]}]
