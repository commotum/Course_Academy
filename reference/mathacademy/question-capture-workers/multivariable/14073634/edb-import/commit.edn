19 true] [17592186379680 1034 "\\frac{22}{\\sqrt{23}}" 13194139536019 true] [17592186379680 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379680 1111 #uuid "64b70e69-43eb-5fb2-b6e6-a7800efb685c" 13194139536019 true] [17592186379681 1034 "\\frac{23}{\\sqrt{22}}" 13194139536019 true] [17592186379681 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379681 1111 #uuid "b8269272-7858-53d9-817d-3b20091ab3e1" 13194139536019 true] [17592186379682 1034 "\\frac{23}{\\sqrt{33}}" 13194139536019 true] [17592186379682 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379682 1111 #uuid "6c847c9a-fe8e-5965-9343-66f7254f1811" 13194139536019 true] [17592186379683 1034 "\\frac{23}{3\\sqrt{11}}" 13194139536019 true] [17592186379683 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379683 1111 #uuid "9d19462a-6882-5925-a88a-b9e3d986f194" 13194139536019 true] [17592186379684 1034 "\\frac{23}{2\\sqrt{11}}" 13194139536019 true] [17592186379684 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379684 1111 #uuid "25409f85-a599-56a5-a0f8-291f980ec147" 13194139536019 true] [17592186379685 1017 #edb/ref 17592186379686 13194139536019 true] [17592186379685 1089 "q-19146" 13194139536019 true] [17592186379685 1091 #edb/ref 17592186045465 13194139536019 true] [17592186379685 1100 "Let $a=⟨-1,2,\\sqrt{11}⟩$ and $b=⟨4,3,\\sqrt{11}⟩.$ Find ${\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b.$" 13194139536019 true] [17592186379685 1113 #uuid "f8f33e2a-bf56-56a0-b6af-c35da18edc4d" 13194139536019 true] [17592186379685 1145 "Using the formula for the scalar projection, we obtain\n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a & =\\frac{a\\cdot b}{|\\,b\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{b}_{x}^{2}+{b}_{y}^{2}+{b}_{z}^{2}}} \\\\  & =\\frac{(-1)\\cdot 4+2\\cdot 3+\\sqrt{11}\\cdot \\sqrt{11}}{\\sqrt{{4}^{2}+{3}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{36}} \\\\  & =\\frac{13}{6}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}{\\text{comp}}_{a}\\,b & =\\frac{b\\cdot a}{|\\,a\\,|} \\\\  & =\\frac{{a}_{x}{b}_{x}+{a}_{y}{b}_{y}+{a}_{z}{b}_{z}}{\\sqrt{{a}_{x}^{2}+{a}_{y}^{2}+{a}_{z}^{2}}} \\\\  & =\\frac{13}{\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{11})^{2}}} \\\\  & =\\frac{13}{\\sqrt{16}} \\\\  & =\\frac{13}{4}.\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\text{comp}}_{b}\\,a-{\\text{comp}}_{a}\\,b & =\\frac{13}{6}-\\frac{13}{4} \\\\  & =13(\\frac{1}{6}-\\frac{1}{4}) \\\\  & =13(\\frac{2}{12}-\\frac{3}{12}) \\\\  & =-\\frac{13}{12}.\\end{aligned}\n$$" 13194139536019 true] [17592186379686 1000 #edb/ref 17592186379687 13194139536019 true] [17592186379686 1000 #edb/ref 17592186379688 13194139536019 true] [17592186379686 1000 #edb/ref 17592186379689 13194139536019 true] [17592186379686 1000 #edb/ref 17592186379690 13194139536019 true] [17592186379686 1000 #edb/ref 17592186379691 13194139536019 true] [17592186379686 1040 #edb/ref 17592186045450 13194139536019 true] [17592186379686 1041 "selection" 13194139536019 true] [17592186379686 1104 #edb/ref 17592186379689 13194139536019 true] [17592186379686 1110 #uuid "110d4236-7ab2-5630-927c-4f3345a2e633" 13194139536019 true] [17592186379687 1034 "-\\frac{12}{13}" 13194139536019 true] [17592186379687 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379687 1111 #uuid "0600cdec-d349-5914-b21c-1db6275f7504" 13194139536019 true] [17592186379688 1034 "\\frac{12}{13}" 13194139536019 true] [17592186379688 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379688 1111 #uuid "cad80365-ee5a-54b5-9f58-efa30a61b498" 13194139536019 true] [17592186379689 1034 "-\\frac{13}{12}" 13194139536019 true] [17592186379689 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379689 1111 #uuid "ebb29635-54ad-56c4-a59c-8af02c1eb75a" 13194139536019 true] [17592186379690 1034 "\\frac{13}{12}" 13194139536019 true] [17592186379690 1103 #edb/ref 17592186045453 13194139536019 true] [17592186379690 1111 #uuid "f019cf2a-3fc0-5d85-8af6-03f323beabb7" 1