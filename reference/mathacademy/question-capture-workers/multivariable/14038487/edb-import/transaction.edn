9cd1a65ca3f35b0d6c38c6130297e35dbf4556" "q-79161/selection/e65fa56aceb6473699ffa501f026ab1a37f33bad8cec2de202f0badb65ad5328" "q-79161/selection/f4048d3bf9b6381388b4407f993ce4cca21d2a508b65ce65c37825c93ae565df" "q-79161/selection/48bb2c893e0470fc9c9b81495fb22338613f52208a2923848867a4a06e7064ef" "q-79161/selection/6c59055a4cb71a494d3a333346191141c0713fbfaef860a62bbb751fd626df75"] :db/ensure [:answer-field/validate]} {:db/id "q-79161" :question/id #uuid "a0274a00-5f57-5e2c-8986-f19723d88c89" :question/math-academy-id "q-79161" :question/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $2$ centered at the point $(1,6)?$" :question/worked-solution "The parametric equations of a circle of radius $r$ centered at the point $(a,b)$ are\n\n$$\nx=r\\operatorname{cos}⁡\\theta +a,\\,y=r\\operatorname{sin}⁡\\theta +b,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, we have a circle of radius $2$ centered at the point $(1,6).$ Therefore, the parametric equations of the circle are\n\n$$\nx=2\\operatorname{cos}⁡\\theta +1,\\,y=2\\operatorname{sin}⁡\\theta +6,\\,\\theta \\in [0,2\\pi ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-79161/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0346056c-cf8e-51bf-92f3-052a0948a6fa"] :knowledge-point/questions ["q-79161"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-79192"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/assets/6b77b1b8a61b5ec7306fbc0b3d70618e7fdce2237bdcbfd017c23c01b80f2979.png)\n\nConsider the circle of radius $3$ centered at $(-4,5)$, as shown above. Which of the following sets of parametric equations, defined for $\\theta \\in [0,2\\pi ),$  traverse the circle once in the counterclockwise direction starting at the point $A(-1,5)?$" :db/ensure [:question/validate]} {:db/id "q-321947/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "eaaabe4b-630b-5cf4-b94b-265158077688" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-321947/field-1" :answer-field/id #uuid "0e29c233-ffb8-54e7-aaa0-7c423e7a89d1" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321947/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-321947/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-321947/field-2/0a6ddc2b5a7aa53dbaf860b36b1154868d90594d50efab51f97b669902110496" :answer/id #uuid "67fab322-e6f6-592d-924d-ebe7be333936" :answer/type :answer.type/math :answer/value "\\frac{7\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-321947/field-2" :answer-field/id #uuid "35443237-cdfc-5e40-a53d-b48d7ae809aa" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321947/field-2/0a6ddc2b5a7aa53dbaf860b36b1154868d90594d50efab51f97b669902110496" :answer-field/choices ["q-321947/field-2/0a6ddc2b5a7aa53dbaf860b36b1154868d90594d50efab51f97b669902110496"] :db/ensure [:answer-field/validate]} {:db/id "q-321947" :question/id #uuid "bf86fc72-2a3b-5b81-8f85-40f278af2f6f" :question/math-academy-id "q-321947" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/assets/11f1e6651d86e0b00884091338029395cd6d2ff44f25b97d010ec750d13bef59.png)\n\nThe arc of a circle above is defined by the parametric equations \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$ Assume $\\theta $ is between $0$ and $2\\pi .$\n\n$\\theta \\in [${{field-1}}$,$\n{{field-2}}$]$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=4.$ So, the parametric equations of the *full* circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to the arc above, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/assets/2a281b909e4a3577ea3774e9d75c43d97e4d4a69d0f673eed4189834e1ed1c43.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{7\\pi }{6}]$, we get the required arc of the circle.\n\nTherefore, the parametric equations of the arc of the circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{7\\pi }{6}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-321947/field-1" "q-321947/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1d81c7ff-8459-5559-bfae-c2a9c3bc739e"] :knowledge-point/questions ["q-321947"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-321948"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/assets/ed6f528f7e2b873812d492cbeec386ab56af626a964e98b2929824ec9075d320.png)\n\nThe quarter-circle above is defined by the parametric equations \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta .\n$$\n\nWhat is the domain of the parameter $\\theta ?$ Assume $\\theta $ is between $0$ and $2\\pi .$\n\n$\\theta \\in [${{field-1}}$,$\n{{field-2}}$]$" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=4.$ So, the parametric equations of the *full* circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nTo restrict the parameterization to the arc above, we associate the parameter $\\theta $ with the central angle formed by a point $(x,y)$ on the circle and the $x$-axis.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038487/assets/682f73ccec945de2789ecca71aa6dae650c485189c60ffc64ab7a7aa108665da.png)\n\nWe can see that if we restrict $\\theta $ to $[0,\\frac{\\pi }{2}]$, we get the required arc of the circle.\n\nTherefore, the parametric equations of the arc of the circle are \n\n$$\nx=4\\operatorname{cos}⁡\\theta ,\\,y=4\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,\\frac{\\pi }{2}].\n$$" :db/ensure [:question/validate]} {:db/id "q-79166/selection/4205b99be199dc7950356b855ff4a5477c48c73878a7b026d25c035dbf46acb5" :answer/id #uuid "22c3653e-9278-5059-86c9-30d610217067" :answer/type :answer.type/math :answer/value "\\theta \\in [0,\\pi ]" :db/ensure [:answer/validate]} {:db/id "q-79166/selection/254f7dc7c93945f5d800c08002268b921573aada24b982a69940059f541d28cc" :answer/id #uuid "b2a75d7f-a83a-53d2-91cf-19783575a28b" :answer/type :answer.type/math :answer/value "\\theta \\in [0,\\frac{\\pi }{2}]" :db/ensure [:answer/validate]} {:db/id "q-79166/selection/bc3e76ff6c2251409d67bd4d44714df545c2e1406f35c243db21f791e2a3cb52" :answer/id #uuid "fc478a22-4762-53c5-90b4-bcbae6233313" :answer/type :answer.type/math :answer/value "\\theta \\in [0,\\frac{3\\pi }{2}]" :db/ensure [:answer/validate]} {:db/id "q-79166/selection/e770f8e6a3b3377282f44b76cd7a0728520f58d3e8c8d90bd3420eb08a0e46f7" :answer/id #uuid "e655fb51-22af-560b-911f-fc4ad0e14612" :answer/type :answer.type/math :answer/value "\\theta \\in [0,\\frac{3\\pi }{4}]" :db/ensure [:answer/validate]} {:db/id "q-79166/selection/3a0472f96eccaa2c8