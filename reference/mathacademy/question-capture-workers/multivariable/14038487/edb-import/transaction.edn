on/problem "Which of the following parametric equations, defined for $\\theta \\in [0,2\\pi ),$ generate a circle of radius $3$ centered at the origin?" :question/worked-solution "The parametric equations of a circle  of radius $r$  centered at  the origin are\n\n$$\nx=r\\operatorname{cos}⁡\\theta ,\\,y=r\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$\n\nIn our case, the radius $r=3.$ Therefore, the parametric equations of the circle are \n\n$$\nx=3\\operatorname{cos}⁡\\theta ,\\,y=3\\operatorname{sin}⁡\\theta ,\\,\\theta \\in [0,2\\pi ).\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-6877/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7703063b-658d-50a5-8ac3-747b7f029bb3"] :knowledge-point/questions ["q-6877"] :db/ensure [:knowledge-point/validate]} {:db/id "q-321891/field-1/3a81bb292deca3519b3b331a62a1782ca5a38d355a14f20bfcafc5757528975c" :answer/id #uuid "d62cf37c-d928-5471-a730-29da52a950e2" :answer/type :answer.type/math :answer/value "10\\cos(\\theta)" :db/ensure [:answer/validate]} {:db/id "q-321891/field-1" :answer-field/id #uuid "74e501c9-f1e9-510e-8202-362c8e8398e7" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321891/field-1/3a81bb292deca3519b3b331a62a1782ca5a38d355a14f20bfcafc5757528975c" :answer-field/choices ["q-321891/field-1/3a81bb292deca3519b3b331a62a1782ca5a38d355a14f20bfcafc5757528975c"] :db/ensure [:answer-field/validate]} {:db/id "q-321891/field-2/b864bd878f1777aedf5c43b0ad56a2577a0bf670ffa50d6507e6da9960cfb4c9" :answer/id #uuid "4412556e-6fb8-579f-ae78-4929da26e1aa" :answer/type :answer.type/math :answer/value "10\\sin(\\theta)" :db/ensure [:answer/validate]} {:db/id "q-321891/field-2" :answer-field/id #uuid "54e65f65-c0b2-5b94-8cf9-7800c70d0e79" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-321891/field-2/b864bd878f1777aedf5c43b0ad56a2577a0bf670ffa50d6507e6da9960cf