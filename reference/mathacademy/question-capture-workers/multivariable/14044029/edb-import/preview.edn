z}^{2}{e}^{y}) \\\\  & =z\\operatorname{cos}⁡y+{x}^{2}+2xz{e}^{y}.\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(1,0,-2),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(1,0,-2) & =(-2)\\cdot \\operatorname{cos}⁡0+{1}^{2}+2\\cdot 1\\cdot (-2)\\cdot {e}^{0} \\\\  & =-2+1-4 \\\\  & =-5\\end{aligned}\n$$" 13194139534985 true] [17592186324923 1000 #edb/ref 17592186324924 13194139534985 true] [17592186324923 1000 #edb/ref 17592186324925 13194139534985 true] [17592186324923 1000 #edb/ref 17592186324926 13194139534985 true] [17592186324923 1000 #edb/ref 17592186324927 13194139534985 true] [17592186324923 1000 #edb/ref 17592186324928 13194139534985 true] [17592186324923 1040 #edb/ref 17592186045450 13194139534985 true] [17592186324923 1041 "selection" 13194139534985 true] [17592186324923 1104 #edb/ref 17592186324924 13194139534985 true] [17592186324923 1110 #uuid "89bd7543-750c-51df-ad98-2aa90a8faeee" 13194139534985 true] [17592186324924 1034 "-5" 13194139534985 true] [17592186324924 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324924 1111 #uuid "230f008e-d438-5fd2-b193-8daf24e89203" 13194139534985 true] [17592186324925 1034 "3" 13194139534985 true] [17592186324925 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324925 1111 #uuid "26bb1d4e-6927-5dc0-abfc-a8dbef4b0852" 13194139534985 true] [17592186324926 1034 "4" 13194139534985 true] [17592186324926 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324926 1111 #uuid "1d1a654c-ccc8-5184-a2c4-12537c38274a" 13194139534985 true] [17592186324927 1034 "0" 13194139534985 true] [17592186324927 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324927 1111 #uuid "2dcb45de-3d92-5353-9595-5c006a2e48d1" 13194139534985 true] [17592186324928 1034 "-2" 13194139534985 true] [17592186324928 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324928 1111 #uuid "c904237f-8111-534a-8a7d-3b7cf75a57f8" 13194139534985 true] [17592186324929 1017 #edb/ref 17592186324930 13194139534985 true] [17592186324929 1089 "q-131179" 13194139534985 true] [17592186324929 1091 #edb/ref 17592186045465 13194139534985 true] [17592186324929 1100 "Consider the vector field $F=x(y{e}^{z}+\\operatorname{ln}⁡y)\\,i+xy{e}^{z}\\,j+z(x+1)\\,k.$ \nEvaluate $∇\\cdot F$ at the point $(1,1,0).$" 13194139534985 true] [17592186324929 1113 #uuid "78eaf5af-1c01-56c0-b165-f85543865c50" 13194139534985 true] [17592186324929 1145 "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(x(y{e}^{z}+\\operatorname{ln}⁡y))+\\frac{∂}{∂y}(xy{e}^{z})+\\frac{∂}{∂z}(z(x+1)) \\\\  & =(y{e}^{z}+\\operatorname{ln}⁡y)+x{e}^{z}+(x+1) \\\\  & =y{e}^{z}+\\operatorname{ln}⁡y+x{e}^{z}+x+1\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(1,1,0),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(1,1,0) & =1\\cdot {e}^{0}+\\operatorname{ln}⁡1+1\\cdot {e}^{0}+1+1 \\\\  & =1+0+1+1+1 \\\\  & =4.\\end{aligned}\n$$" 13194139534985 true] [17592186324930 1000 #edb/ref 17592186324931 13194139534985 true] [17592186324930 1000 #edb/ref 17592186324932 13194139534985 true] [17592186324930 1000 #edb/ref 17592186324933 13194139534985 true] [17592186324930 1000 #edb/ref 17592186324934 13194139534985 true] [17592186324930 1000 #edb/ref 17592186324935 13194139534985 true] [17592186324930 1040 #edb/ref 17592186045450 13194139534985 true] [17592186324930 1041 "selection" 13194139534985 true] [17592186324930 1104 #edb/ref 17592186324934 13194139534985 true] [17592186324930 1110 #uuid "d2763c5c-a8f1-5cb9-b563-40bce80812bd" 13194139534985 true] [17592186324931 1034 "3" 13194139534985 true] [17592186324931 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324931 1111 #uuid "2ee239bc-90a8-5341-9562-d233bd522c09" 13194139534985 true] [17592186324932 1034 "2" 13194139534985 true] [17592186324932 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324932 1111 #uuid "ebcaa883-55b6-57e1-8b72-44a3ac9b87f5" 13194139534985 true] [17592186324933 1034 "6" 13194139534985 true] [17592186324933 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324933 1111 #uuid "51435a18-587a-511d-94b7-0ec730eab907" 13194139534985 true] [17592186324934 1034 "4" 13194139534985 true] [17592186324934 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324934 1111 #uuid "af663012-6d97-53c3-80f8-d67f604e5e57" 13194139534985 true] [17592186324935 1034 "0" 13194139534985 true] [17592186324935 1103 #edb/ref 17592186045453 13194139534985 true] [17592186324935 1111 #uuid "402360c3-be04-5d55-9c5a-5190d72cb9f7" 13194139534985 true] [17592186324936 1017 #edb/ref 17592186324937 13194139534985 true] [17592186324936 1089 "q-131192" 13194139534985 true] [17592186324936 1091 #edb/ref 17592186045465 13194139534985 true] [17592186324936 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044029/assets/e30919dc7cc107bdda9872079b4dc0e59fe8e3e5767aa2d407b9d0af392803e0.png)\n\nConsider the vector field $F$ shown above. Which of the following statements are true everywhere in the domain of $F?$\n\n- $\\text{div}\\,F=0$\n- $\\text{div}\\,F>0$\n- $\\text{div}\\,F<0$\n- $F$ is solenoidal" 13194139534985 true] [17592186324936 1113 #uuid "7504c683-ad06-5a39-9e73-18db40235f81" 13194139534985 true] [17592186324936 1145 "Recall that $\\text{div}\\,F=∇\\cdot F$ denotes the divergence of the vector field $F.$\n\nIntuitively, the divergence of $F$ at a point $P$ measures how much $F$ acts like a source or a sink at $P:$\n\n- If $F$ acts like a source at $P,$ then $∇\\cdot F>0$ at $P.$\n\n- If $F$ acts like a sink at $P,$ then $∇\\cdot F<0$ at $P.$\n\n- If $F$ acts like neither a source nor a sink at $P,$ then $∇\\cdot F=0$ at $P.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044029/assets/6c747149618d4c5ef35e727af15cd001365bd9c2d5e064689baf24c6ee23cff9.png)\n\nIf $∇\\cdot F=0$ everywhere in the domain of $F,$ we say that $F$ is solenoidal.\n\nWith that in mind, let's examine each statement:\n\n- Statement II is true, whereas statements I and III are false. Notice that the lengths of the vector's $y$-components increase as we move vertically away from the origin. Therefore, the vector field $F$ acts like a source at every point.\n\n- Statement IV is false. Since $∇\\cdot F\\ne 0,$ the vector field $F$ is not solenoidal.\n\nTherefore, the correct answer is \"II only.\"" 13194139534985 true] [17592186324937 1000 #edb/ref 17592186324938 13194139534985 true] [17592186324937 1000 #edb/ref 17592186324939 13194139534985 true] [17592186324937 1000 #edb/ref 17592186324940 13194139534985 true] [17592186324937 1000 #edb/ref 17592186324941 13194139534985 true] [17592186324937 1000 #edb/ref 17592186324942 13194139534985 true] [17592186324937 1040 #edb/ref 17592186045450 13194139534985 true] [17592186324937 1041 "selection" 13194139534985 true] [17592186324937 1104 #edb/ref 17592186324942 13194139534985 true] [17592186324937 1110 #uuid "62c28965-b786-55bc-b04e-8f085793d054" 13194139534985 true] [17592186324938 1034 "I and IV only" 13194139534985 true] [17592186324938 1103 #edb/ref 17592186045454 13194139534985 true] [17592186324938 1111 #uuid "afd4bdf1-fce2-5f96-bf59-698ab15a7893" 13194139534985 true] [17592186324939 1034 "II and IV only" 13194139534985 true] [17592186324939 1103 #edb/ref 17592186045454 13194139534985 true] [17592186324939 1111 #uuid "76fa8915-e00a-5596-892b-981f71e74f5d" 13194139534985 true] [17592186324940 1034 "I only" 13194139534985 true] [17592186324940 1103 #edb/ref 17592186045454 13194139534985 true] [17592186324940 1111 #uuid "68253369-02ff-51a1-beda-1b1f7e5c89b0" 13194139534985 true] [175921