] ["math" "2{y}^{2}\\,i+4{x}^{2}\\,j"] ["math" "4xy\\,i+8xy\\,j"] ["math" "4{x}^{2}+2{y}^{2}"] ["math" "8xy"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044029/state.json" "file_sha256" "063b2c62c2e929429d2be6666f0a83af25ad862030455b110c8d7becbbd11a3c"} {"question" "q-41817" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4{x}^{2}+2{y}^{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044029/state.json" "file_sha256" "063b2c62c2e929429d2be6666f0a83af25ad862030455b110c8d7becbbd11a3c"} {"question" "q-131170" "field" nil "attribute" "question/problem" "value" "Given that $F=\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j,$ what is $\\text{div}\\,F?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044029/state.json" "file_sha256" "063b2c62c2e929429d2be6666f0a83af25ad862030455b110c8d7becbbd11a3c"} {"question" "q-131170" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\frac{y}{{x}^{2}+{y}^{2}})+\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}}-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}} \\\\  & =-\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14044029/state.json" "file_sha256" "063b2c62c2e929429d2be6666f0a83af25ad86203045