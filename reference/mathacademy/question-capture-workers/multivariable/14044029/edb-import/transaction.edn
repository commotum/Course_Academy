n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(y\\operatorname{sin}⁡x)+\\frac{∂}{∂y}({x}^{2}{cos}^{2}⁡y) \\\\  & =y\\operatorname{cos}⁡x-2{x}^{2}\\operatorname{cos}⁡y\\operatorname{sin}⁡y.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-105554/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd"] :knowledge-point/questions ["q-105554"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-41817"] :question/problem "Given that $F=2x{y}^{2}\\,i+4{x}^{2}y\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(2x{y}^{2})+\\frac{∂}{∂y}(4{x}^{2}y) \\\\  & =2{y}^{2}+4{x}^{2} \\\\  & =4{x}^{2}+2{y}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-131170/selection/111949744e784bf6ad56bec7678f0c941f715dce5f0f15cca4f1e396e2a9d140" :answer/id #uuid "a4cc5bdb-b7d7-52d2-b85a-20a764a4e87e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}-{y}^{2}}{{x}^{2}+{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-131170/selection/2e277b62e6be96369cbf4bd7bd2060df2824b5bc2297f2c048a6abf3e67c09bc" :answer/id #uuid "7c419bb9-6af8-5b5e-a328-e1667010b833" :answer/type :answer.type/math :answer/value "\\frac{4xy}{{x}^{2}+{y}^{2}}" :db/ensure [:answer/validate]} {:db/id "q-131170/selection/eb1d8c693b8cf6303ff95b83215baf588f0e20fa8c10bf88c8cfb8b313d7d028" :answer/id #uuid "ccc265f4-cfc2-5931-9081-4e4b47505d68" :answer/type :answer.type/math :answer/value "{y}^{2}-{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-131170/selection/641b8f9e53242ae022724fcb0a155f43b18e6f44fca215fb0090b4abbe3836f3" :answer/id #uuid "eeaf7467-c7c0-503c-9dcd-2eb74fbf48ec" :answer/type :answer.type/math :answer/value "-\\frac{4xy}{({x}^{2}+{y}^{2})^{2}}" :db/ensure [:answer/validate]} {:db/id "q-131170/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "701dbbe4-67fc-53e1-9917-4dbe563b8ee4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-131170/selection" :answer-field/id #uuid "94239d68-2c2d-533b-bf4f-8614c44ad78c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131170/selection/641b8f9e53242ae022724fcb0a155f43b18e6f44fca215fb0090b4abbe3836f3" :answer-field/choices ["q-131170/selection/111949744e784bf6ad56bec7678f0c941f715dce5f0f15cca4f1e396e2a9d140" "q-131170/selection/2e277b62e6be96369cbf4bd7bd2060df2824b5bc2297f2c048a6abf3e67c09bc" "q-131170/selection/eb1d8c693b8cf6303ff95b83215baf588f0e20fa8c10bf88c8cfb8b313d7d028" "q-131170/selection/641b8f9e53242ae022724fcb0a155f43b18e6f44fca215fb0090b4abbe3836f3" "q-131170/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-131170" :question/id #uuid "cffe6d22-55ac-53f3-bb29-f92e6000e1d0" :question/math-academy-id "q-131170" :question/problem "Given that $F=\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\frac{y}{{x}^{2}+{y}^{2}})+\\frac{∂}{∂y}(\\frac{x}{{x}^{2}+{y}^{2}}) \\\\  & =-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}}-\\frac{2xy}{{({x}^{2}+{y}^{2})}^{2}} \\\\  & =-\\frac{4xy}{{({x}^{2}+{y}^{2})}^{2}}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131170/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd"] :knowledge-point/questions ["q-131170"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131171/selection/7dfa6a82c25785543eaf2600e245ea80eb2164716d575e1f1d57e0affbcf103e" :answer/id #uuid "cb20a7b5-3d15-567c-926a-afeac594682d" :answer/type :answer.type/math :answer/value "\\frac{1+{x}^{2}}{x}" :db/ensure [:answer/validate]} {:db/id "q-131171/selection/6fe2bf5f588a5566eea7ad0da6a7efec6389a0373e28de9b0c6024fd16a0c0db" :answer/id #uuid "8ce1b145-1a60-577d-ab43-7f504c25d4f1" :answer/type :answer.type/math :answer/value "\\frac{1+xy}{x}" :db/ensure [:answer/validate]} {:db/id "q-131171/selection/9ff0c678280f30085ea301e57828d8f7368c38d6b7f7da20415c9eaad1f0d7fe" :answer/id #uuid "3ff4cd5d-bdc1-5144-b15b-b5c8d199648e" :answer/type :answer.type/math :answer/value "\\frac{1}{xy}" :db/ensure [:answer/validate]} {:db/id "q-131171/selection/d8372ed9951c4e4ce34f58c955cf030feaae17e2b6ce950b025bfe36655d6125" :answer/id #uuid "47e06486-de71-5a06-928c-08b14b53e2b1" :answer/type :answer.type/math :answer/value "x(y+1)" :db/ensure [:answer/validate]} {:db/id "q-131171/selection/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7" :answer/id #uuid "d7b50649-eac5-5dbd-84e4-6e58057933b4" :answer/type :answer.type/math :answer/value "2x" :db/ensure [:answer/validate]} {:db/id "q-131171/selection" :answer-field/id #uuid "daeb9f7b-9e59-5e4e-a871-3932e80cf1d6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131171/selection/7dfa6a82c25785543eaf2600e245ea80eb2164716d575e1f1d57e0affbcf103e" :answer-field/choices ["q-131171/selection/7dfa6a82c25785543eaf2600e245ea80eb2164716d575e1f1d57e0affbcf103e" "q-131171/selection/6fe2bf5f588a5566eea7ad0da6a7efec6389a0373e28de9b0c6024fd16a0c0db" "q-131171/selection/9ff0c678280f30085ea301e57828d8f7368c38d6b7f7da20415c9eaad1f0d7fe" "q-131171/selection/d8372ed9951c4e4ce34f58c955cf030feaae17e2b6ce950b025bfe36655d6125" "q-131171/selection/e819017e19dccac106b8bdd7a345917915a57ae6ae3646d73f366105b31b91f7"] :db/ensure [:answer-field/validate]} {:db/id "q-131171" :question/id #uuid "0e2fb8a5-6ddd-5863-88eb-d9ab2a79abbf" :question/math-academy-id "q-131171" :question/problem "Given that $F=\\operatorname{ln}⁡(xy)\\,i+xy\\,j,$ what is $\\text{div}\\,F?$" :question/worked-solution "If $F=P\\,i+Q\\,j$ is a vector field on ${R}^{2}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y} \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))+\\frac{∂}{∂y}(xy) \\\\  & =\\frac{1}{x}+x \\\\  & =\\frac{1+{x}^{2}}{x}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131171/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c18e198-9ea9-57dc-b9af-8c77f0da27cd"] :knowledge-point/questions ["q-131171"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123179/selection/d83ea71dfe1f03e67737884474caa85b81938281dae7f77c5a153a9885be635a" :answer/id #uuid "a761de29-fb97-5157-9c29-78ac73e8aa10" :answer/type :answer.type/math :answer/value "x+2y-4z" :db/ensure [:answer/validate]} {:db/id "q-123179/selection/0a39ff4c1d865df7a17fda67127e45141f655a515661ff4f70eca928b82b5b6e" :answer/id #uuid "0b533fb2-bcfa-554b-bb54-8652d02a3fed" :answer/type :answer.type/math :answer/value "8x+12y-16z" :db/ensure [:answer/validate]} {:db/id "q-123179/selection/578627ec05c548bb00db88a55e6f75308da9cf012d792739aa655e993def2d21" :answer/id #uuid "916f8312-01fe-5088-b87f-075a3f9d38b8" :answer/type :answer.type/math :answer/value "(2x+3y-4z)^{2}" :db/ensure [:answer/validate]} {:db/id "q-123179/selection/652fb95825a581d8302a016d7bd9a3a1d32365a0006cfac5219603a09ebe2d97" :answer/id #uuid "e860c7e1-6866-5ede-a6a6-18befbb99d02" :answer/type :answer.type/math :answer/value "6x+9y-12z" :db/ensure [:answer/validate]} {:db/id "q-123179/selection/e00cb014fb50b34caeb2ce119e09fe54d95ed1eaf7193b1ed42f92da68fefc01" :answer/id #uuid "3a494538-80ec-5729-8a52-0f1842177151" :answer/type :answer.type/math :answer/value "4x+6y-8z" :db/ensure [:answer/validate]} {:db/id "q-123179/selection" :answer-field/id #uuid "471b424c-66c8-52b4-9674-55bc79eb6e2a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123179/selection/e00cb014fb50b34caeb2ce119e09fe54d95ed1eaf7193b1ed42f92da68fefc01" :answer-field/choices ["q-123179/selection/d83ea71dfe1f03e67737884474caa85b81938281dae7f77c5a153a9885be635a" "q-123179/selection/0a39ff4c1d865df7a17fda67127e45141f655a515661ff4f70eca928b82b5b6e" "q-123179/selection/578627ec05c548bb00db88a55e6f75308da9cf012d792739aa655e993def2d21" "q-123179/selection/652fb95825a581d8302a016d7bd9a3a1d32365a0006cfac5219603a09ebe2d97" "q-123179/selection/e00cb014fb50b34caeb2ce119e09fe54d95ed1eaf7193b1ed42f92da68fefc01"] :db/ensure [:answer-field/validate]} {:db/id "q-123179" :question/id #uuid "715b9df3-62f0-5b19-864e-25778806112d" :question/math-academy-id "q-123179" :question/problem "Consider the vector field $F=(2x+3y-4z)^{2}\\,i+(2x+3y-4z)^{2}\\,j+(2x+3y-4z)^{2}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}((2x+3y-4z)^{2})+\\frac{∂}{∂y}((2x+3y-4z)^{2})+\\frac{∂}{∂z}((2x+3y-4z)^{2}) \\\\  & =4(2x+3y-4z)+6(2x+3y-4z)-8(2x+3y-4z) \\\\  & =2(2x+3y-4z) \\\\  & =4x+6y-8z.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123179/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a"] :knowledge-point/questions ["q-123179"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123176/selection/1a04630b7c3bb9a08cf9f150ec98de21ec75d92b9b37d2aaf277001870b554a6" :answer/id #uuid "fde3b9c8-2a33-5f77-a1a6-47636186a5e5" :answer/type :answer.type/math :answer/value "{e}^{x}\\operatorname{sin}⁡yz+xyz+2" :db/ensure [:answer/validate]} {:db/id "q-123176/selection/6da5f717634b95696bea48fdc1f1b93d1788c51788411f3dbb948c253b8bfe35" :answer/id #uuid "d996c2a3-ce5b-5d60-aa5d-cc6c105b5761" :answer/type :answer.type/math :answer/value "{e}^{x}\\operatorname{cos}⁡yz+xz" :db/ensure [:answer/validate]} {:db/id "q-123176/selection/34d562f049d5b24d54d84e07252dc8bcb87bd9a4c071cd243d9d4ccb4f98c80d" :answer/id #uuid "d276bfe3-bfb2-57a2-ad11-dc1694bd5d09" :answer/type :answer.type/math :answer/value "{e}^{x}\\operatorname{cos}⁡yz+xz+2" :db/ensure [:answer/validate]} {:db/id "q-123176/selection/a840dd87ae2843cfe706ecad8f709da53e8e7bc14dd053af1f8bcc3dfeb435e6" :answer/id #uuid "ecf1b76a-1a65-5659-9bd0-e133a0882bc4" :answer/type :answer.type/math :answer/value "{e}^{x}\\operatorname{cos}⁡yz" :db/ensure [:answer/validate]} {:db/id "q-123176/selection/3206f19985cca6aef7df50e3d6551da6e1da0fd65d2a682f76807822433eb491" :answer/id #uuid "431284e0-50f4-5b7a-90df-1ed6900d79ef" :answer/type :answer.type/math :answer/value "{e}^{x}\\operatorname{sin}⁡yz+xz" :db/ensure [:answer/validate]} {:db/id "q-123176/selection" :answer-field/id #uuid "945d37b1-6217-513e-9377-a6a5935651bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123176/selection/3206f19985cca6aef7df50e3d6551da6e1d