value "0" :db/ensure [:answer/validate]} {:db/id "q-131179/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "51435a18-587a-511d-94b7-0ec730eab907" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-131179/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ebcaa883-55b6-57e1-8b72-44a3ac9b87f5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-131179/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "2ee239bc-90a8-5341-9562-d233bd522c09" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-131179/selection" :answer-field/id #uuid "d2763c5c-a8f1-5cb9-b563-40bce80812bd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131179/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-131179/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-131179/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-131179/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-131179/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-131179/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-131179" :question/id #uuid "78eaf5af-1c01-56c0-b165-f85543865c50" :question/math-academy-id "q-131179" :question/problem "Consider the vector field $F=x(y{e}^{z}+\\operatorname{ln}⁡y)\\,i+xy{e}^{z}\\,j+z(x+1)\\,k.$ \nEvaluate $∇\\cdot F$ at the point $(1,1,0).$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n\\text{div}\\,F=∇\\cdot F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(x(y{e}^{z}+\\operatorname{ln}⁡y))+\\frac{∂}{∂y}(xy{e}^{z})+\\frac{∂}{∂z}(z(x+1)) \\\\  & =(y{e}^{z}+\\operatorname{ln}⁡y)+x{e}^{z}+(x+1) \\\\  & =y{e}^{z}+\\operatorname{ln}⁡y+x{e}^{z}+x+1\\end{aligned}\n$$\n\nFinally, we evaluate $\\text{div}\\,F$ at the point $(1,1,0),$ and obtain\n\n$$\n\\begin{aligned}(∇\\cdot F)(1,1,0) & =1\\cdot {e}^{0}+\\operatorname{ln}⁡1+1\\cdot {e}^{0}+1+1 \\\\  & =1+0+1+1+1 \\\\  & =4.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-131179/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a"] :knowledge-point/questions ["q-131179"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131176/selection/706c153c7ca5f9b315d1f9a5903c36b703839f7fd623a752c168b878ba05cc97" :answer/id #uuid "b31d359d-681a-5355-9dd0-1477e5883dda" :answer/type :answer.type/math :answer/value "5y{z}^{2}+x{e}^{y}" :db/ensure [:answer/validate]} {:db/id "q-131176/selection/4deee1c464be46f59583058964d5e012b73a6c6c1afc89083decf490ab774dbc" :answer/id #uuid "e3d2b75a-1672-56d9-9444-2e10daffb7d3" :answer/type :answer.type/math :answer/value "xy{z}^{2}+xz" :db/ensure [:answer/validate]} {:db/id "q-131176/selection/3f30d9abfdce86cd2db7bfa2cddf5aa3ec321d6e5963c7677e2571b4c6d26408" :answer/id #uuid "e44b18a1-0329-5159-be73-b9b9936bad73" :answer/type :answer.type/math :answer/value "x+{e}^{y}+{z}^{2}" :db/ensure [:answer/validate]} {:db/id "q-131176/selection/27e018a38c6b6cf7b156f60457fe298035575804537a7d5ca598dc1dd0350aa5" :answer/id #uuid "2cd5a3c8-5a67-5fbd-a0d9-a2cfde260a20" :answer/type :answer.type/math :answer/value "y{z}^{2}+xy+y" :db/ensure [:answer/validate]} {:db/id "q-131176/selection/0b7c68325f97ef540424db001cbe36fbc09f086a665d82559a9822d3526f691c" :answer/id #uuid "eb117fc8-9de7-5fda-80e0-30259e456240" :answer/type :answer.type/math :answer/value "y{z}^{2}+xy{e}^{y}" :db/ensure [:answer/validate]} {:db/id "q-131176/selection" :answer-field/id #uuid "5968b33b-0e8e-589e-9e1b-54d08719fae4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-131176/selection/706c153c7ca5f9b315d1f9a5903c36b703839f7fd623a752c168b878ba05cc97" :answer-field/choices ["q-131176/selection/706c153c7ca5f9b315d1f9a5903c36b703839f7fd623a752c168b878ba05cc97" "q-131176/selection/4deee1c464be46f59583058964d5e012b73a6c6c1afc89083decf490ab774dbc" "q-131176/selection/3f30d9abfdce86cd2db7bfa2cddf5aa3ec321d6e5963c7677e2571b4c6d26408" "q-131176/selection/27e018a38c6b6cf7b156f60457fe298035575804537a7d5ca598dc1dd0350aa5" "q-131176/selection/0b7c68325f97ef540424db001cbe36fbc09f086a665d82559a9822d3526f691c"] :db/ensure [:answer-field/validate]} {:db/id "q-131176" :question/id #uuid "27a23092-236c-50b5-9673-4981030e25b9" :question/math-academy-id "q-131176" :question/problem "Consider the vector field $F=2xy{z}^{2}\\,i+x{e}^{y}\\,j+y{z}^{3}\\,k.$ \nFind $∇\\cdot F.$" :question/worked-solution "If $F=P\\,i+Q\\,j+R\\,k$ is a vector field on ${R}^{3}$ and the partial derivatives of the components of $F$ all exist, then the divergence of $F$ is the scalar field given by\n\n$$\n∇\\cdot F=\\text{div}\\,F=\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z}.\n$$\n\n  \n\nTherefore, we have\n\n$$\n\\begin{aligned}∇\\cdot F & =\\frac{∂P}{∂x}+\\frac{∂Q}{∂y}+\\frac{∂R}{∂z} \\\\  & =\\frac{∂}{∂x}(2xy{z}^{2})+\\frac{∂}{∂y}(x{e}^{y})+\\frac{∂}{∂z}(y{z}^{3}) \\\\  & =2y{z}^{2}+x{e}^{y}+3y{z}^{2} \\\\  & =5y{z}^{2}+x{e}^{y}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-131176/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6b79409-5a5b-533b-8d46-4e0e6d963b3a"] :knowledge-point/questions ["q-131176"] :db/ensure [:knowledge-point/validate]} {:db/id "q-131178/selection/4de3