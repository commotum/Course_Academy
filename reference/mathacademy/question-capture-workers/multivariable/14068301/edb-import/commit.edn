8}}=\\frac{1}{2}.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(2,8)$ is given by\n\n$$\n\\begin{aligned}∇f(2,8) & =⟨2,\\frac{1}{2}⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y) & ≈f(2,8)+∇\\,f(2,8)\\cdot ⟨x-2,\\,y-8⟩ \\\\  & =8+⟨2,\\frac{1}{2}⟩\\cdot ⟨x-2,\\,y-8⟩ \\\\  & =8+2(x-2)+\\frac{1}{2}(y-8) \\\\  & =2x+\\frac{y}{2}.\\end{aligned}\n$$" 13194139535605 true] [17592186357266 1000 #edb/ref 17592186357267 13194139535605 true] [17592186357266 1000 #edb/ref 17592186357268 13194139535605 true] [17592186357266 1000 #edb/ref 17592186357269 13194139535605 true] [17592186357266 1000 #edb/ref 17592186357270 13194139535605 true] [17592186357266 1000 #edb/ref 17592186357271 13194139535605 true] [17592186357266 1040 #edb/ref 17592186045450 13194139535605 true] [17592186357266 1041 "selection" 13194139535605 true] [17592186357266 1104 #edb/ref 17592186357269 13194139535605 true] [17592186357266 1110 #uuid "70f953ec-0ee9-5cad-9b70-336e5ef135b4" 13194139535605 true] [17592186357267 1034 "f(x,y)≈\\frac{x}{2}+2y" 13194139535605 true] [17592186357267 1103 #edb/ref 17592186045453 13194139535605 true] [17592186357267 1111 #uuid "3ba8fb6d-3a05-5c68-94a7-afc4fd13f558" 13194139535605 true] [17592186357268 1034 "f(x,y)≈16+2x+y" 13194139535605 true] [17592186357268 1103 #edb/ref 17592186045453 13194139535605 true] [17592186357268 1111 #uuid "c34967f9-9b3f-5690-b5ac-b2c3c64e7a9a" 13194139535605 true] [17592186357269 1034 "f(x,y)≈2x+\\frac{y}{2}" 13194139535605 true] [17592186357269 1103 #edb/ref 17592186045453 13194139535605 true] [17592186357269 1111 #uuid "5df35a1e-5afa-5cc0-8391-941ebc0f1dc8" 13194139535605 true] [17592186357270 1034 "f(x,y)≈\\frac{x}{2}+y" 13194139535605 true] [17592186357270 1103 #edb/ref 17592186045453 13194139535605 true] [17592186357270 1111 #uuid "7c95ec5f-6cc6-5b77-bf20-a9d5f5c26f30" 13194139535605 true] [17592186357271 1034 "f(x,y)≈16+2x+\\frac{y}{2}" 13194139535605 true] [17592186357271 1103 #edb/ref 17592186045453 13194139535605 true] [17592186357271 1111 #uuid "3e2510ee-62d1-50fb-acc2-214392fa1bd2" 13194139535605 true] [17592186357272 1017 #edb/ref 17592186357273 13194139535605 true] [17592186357272 1089 "q-98554" 13194139535605 true] [17592186357272 1091 #edb/ref 17592186045464 13194139535605 true] [17592186357272 1100 "Let $f(x,y,z)=xy-\\operatorname{ln}⁡z.$ Find the linear approximation of $f$ at the point $(1,1,e).$" 13194139535605 true] [17592186357272 1113 #uuid "f0a65ec3-c24d-50c1-a1d2-f9666a246122" 13194139535605 true] [17592186357272 1145 "The linear approximation of the function $f$ at the point $(a,b,c)$ is given by\n\n$$\nf(x,y,z)≈f(a,b,c)+∇f(a,b,c)\\cdot ⟨x-a,y-b,z-c⟩.\n$$\n\nSo, the linear approximation of $f$ at the point $(1,1,e)$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,1,e)+∇f(1,1,e)\\cdot ⟨x-1,y-1,z-e⟩.\\end{aligned}\n$$\n\nFrom the definition of $f,$ we have that $f(1,1,e)=0.$ Computing the partial derivatives, we get\n\n$$\n\\begin{aligned}{f}_{x} & =y\\, &  & ⇒\\, & {f}_{x}(1,1,e)=1, \\\\ {f}_{y} & =x\\, &  & ⇒\\, & {f}_{y}(1,1,e)=1, \\\\ {f}_{z} & =-\\frac{1}{z}\\, &  & ⇒\\, & {f}_{z}(1,1,e)=-\\frac{1}{e}.\\end{aligned}\n$$\n\nTherefore, the gradient of the function at the point $(1,1,e)$ is given by\n\n$$\n\\begin{aligned}∇f(1,1,e) & =⟨1,1,-\\frac{1}{e}⟩.\\end{aligned}\n$$\n\nFinally, the linear approximation of the function $f$ is\n\n$$\n\\begin{aligned}f(x,y,z) & ≈f(1,1,e)+∇f(1,1,e)\\cdot ⟨x-1,y-1,z-e⟩ \\\\  & =0+⟨1,1,-\\frac{1}{e}⟩\\cdot ⟨x-1,y-1,z-e⟩ \\\\  & =0+1(x-1)+1(y-1)-\\frac{1}{e}(z-e) \\\\  & =-1+x+y-\\frac{z}{e}.\\end{aligned}\n$$" 13194139535605 true] [17592186357273 1000 #edb/ref 17592186357274 13194139535605 true] [17592186357273 1000 #edb/ref 17592186357275 13194139535605 true] [17592186357273 1000 #edb/ref 17592186357276 13194139535605 true] [17592186357273 1000 #edb/ref 17592186357277 13194139535605 true] [17592186357273 1000 #edb/ref 17592186357278 13194139535605 true] [17592186357