[{:db/id [:question/math-academy-id "q-74320"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/assets/a9f9418d0a9984af019254cb06d9b2aab3251dd3127f05b89b118620ac6dd7e2.png)\n\nWhat are the spherical polar coordinates of the point $A?$" :question/worked-solution "We write the position of a point in spherical polar coordinates as $(\\rho ,\\theta ,ϕ),$ where $\\rho \\ge 0,$ $0\\le \\theta <2\\pi ,$ and $0\\le ϕ\\le \\pi .$\n\nAccording to the diagram, we have the following:\n\n- The distance from the origin to the point $A$ equals $2$ units.\n\n- The half-plane that contains the point $A$ and whose boundary is the $z$-axis forms an angle of $\\frac{\\pi }{3}$ radians with the positive $x$-axis.\n\n- The line that passes through the origin and the point $A$ forms an angle of $\\frac{\\pi }{4}$ radians with the positive $z$-axis.\n\nTherefore, the spherical coordinates of $A$ are $(2,\\frac{\\pi }{3},\\frac{\\pi }{4}).$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-165340/selection/3e39c2277546a7664a5a10322418243e6e2562ab2cbdf3d09ee489735b6d9f55" :answer/id #uuid "c2eb3481-b975-56bc-8d9e-5aa08117f2a8" :answer/type :answer.type/math :answer/value "(3,\\frac{5\\pi }{14},\\frac{2\\pi }{3})" :db/ensure [:answer/validate]} {:db/id "q-165340/selection/773f3099cabe4fd05e6dd16eebdfa05755830893a19d7d2c0417d4776cc5ffa8" :answer/id #uuid "a1e63fdd-7089-53b3-8a75-02fcb4b9b1bb" :answer/type :answer.type/math :answer/value "(3,\\frac{\\pi }{14},\\frac{\\pi }{3})" :db/ensure [:answer/validate]} {:db/id "q-165340/selection/e9de88ac05659901bf3b61bbbf1871e0984ffec7acced72ebc85fcbba43aac47" :answer/id #uuid "c11300fc-dd1f-5a3d-8985-488f97acf48c" :answer/type :answer.type/math :answer/value "(3,\\frac{5\\pi }{14},\\frac{\\pi }{3})" :db/ensure [:answer/validate]} {:db/id "q-165340/selection/189a753e9a0bc3065051b32b9bb2b8738e0c8ceedc7fd834e54d4239df2503c7" :answer/id 