}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =\\sqrt{2}\\operatorname{cos}⁡(\\pi )\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot (-1)\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-1.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =\\sqrt{2}\\operatorname{sin}⁡(\\pi )\\operatorname{sin}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot 0\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =0.\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =\\sqrt{2}\\operatorname{cos}⁡(\\frac{\\pi }{4}) \\\\  & =\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =1.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $D$ are $(-1,0,1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74550" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-74550" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74550" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-1,0,1)"] ["math" "(-1,1,0)"] ["math" "(-1,1,1)"] ["math" "(0,-1,-1)"] ["math" "(1,0,-1)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74550" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-1,0,1)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165297" "field" nil "attribute" "question/problem" "value" "The point $H$ has spherical polar coordinates $(\\sqrt{3},\\frac{4\\pi }{3},\\frac{5\\pi }{6}).$ Find the Cartesian coordinates of $H.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165297" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =\\sqrt{3}\\operatorname{cos}⁡(\\frac{4\\pi }{3})\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =\\sqrt{3}\\cdot (-\\frac{1}{2})\\cdot \\frac{1}{2} \\\\  & =-\\frac{\\sqrt{3}}{4}.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =\\sqrt{3}\\operatorname{sin}⁡(\\frac{4\\pi }{3})\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =\\sqrt{3}\\cdot (-\\frac{\\sqrt{3}}{2})\\cdot \\frac{1}{2} \\\\  & =-\\frac{3}{4}.\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =\\sqrt{3}\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =\\sqrt{3}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $H$ are $(-\\frac{\\sqrt{3}}{4},-\\frac{3}{4},-\\frac{3}{2}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165297" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-165297" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165297" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-\\frac{3}{4},-\\frac{3\\sqrt{3}}{4},-\\frac{3}{4})"] ["math" "(-\\frac{3}{4},-\\frac{\\sqrt{3}}{4},-\\frac{3}{2})"] ["math" "(-\\frac{\\sqrt{3}}{4},-\\frac{3}{4},-\\frac{3}{2})"] ["math" "(-\\frac{\\sqrt{3}}{4},-\\frac{3}{4},-\\frac{3}{4})"] ["math" "(-\\frac{\\sqrt{3}}{4},-\\frac{\\sqrt{3}}{4},-\\frac{3}{2})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165297" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-\\frac{\\sqrt{3}}{4},-\\frac{3}{4},-\\frac{3}{2})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74555" "field" nil "attribute" "question/problem" "value" "The point $P$ has spherical polar coordinates $(4\\sqrt{2},\\frac{2\\pi }{3},\\frac{3\\pi }{4}).$ Find the Cartesian coordinates of $P.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74555" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =4\\sqrt{2}\\operatorname{cos}⁡(\\frac{2\\pi }{3})\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =4\\sqrt{2}\\cdot (-\\frac{1}{2})\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =-2.\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =4\\sqrt{2}\\operatorname{sin}⁡(\\frac{2\\pi }{3})\\operatorname{sin}⁡(\\frac{3\\pi }{4}) \\\\  & =4\\sqrt{2}\\cdot \\frac{\\sqrt{3}}{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =2\\sqrt{3}.\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =4\\sqrt{2}\\operatorname{cos}⁡(\\frac{3\\pi }{4}) \\\\  & =4\\sqrt{2}\\cdot (-\\frac{\\sqrt{2}}{2}) \\\\  & =-4.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-2,2\\sqrt{3},-4).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74555" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-74555" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74555" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(-2,2\\sqrt{3},-4)"] ["math" "(-4,2\\sqrt{3},-2)"] ["math" "(-4,\\sqrt{3},-4)"] ["math" "(2,\\sqrt{3},-1)"] ["math" "(2,\\sqrt{3},-2)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74555" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(-2,2\\sqrt{3},-4)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74725" "field" nil "attribute" "question/problem" "value" "The point $S$ has Cartesian coordinates $(7,\\sqrt{2},7).$ What are the spherical polar coordinates $(\\rho ,\\theta ,ϕ)$ of $S?$ Express $\\theta $ and $ϕ$ in radians rounded to three decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74725" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{{7}^{2}+(\\sqrt{2})^{2}+{7}^{2}} \\\\  & =\\sqrt{49+2+49} \\\\  & =\\sqrt{100} \\\\  & =10\\end{aligned}\n$$\n\nNow, since $(x,y)=(7,\\sqrt{2})$ lies in the first quadrant,  we can find $\\theta $ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{2}}{7}) \\\\  & ≈0.199\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(\\frac{7}{10}) \\\\  & ≈0.795.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $S$ are $(10,0.199,0.795).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74725" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-74725" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74725" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(0.991,6,0.975)"] ["math" "(10,0.199,0.795)"] ["math" "(4,0.991,0.957)"] ["math" "(5,0.919,0.975)"] ["math" "(\\sqrt{10},0.199,0.759)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74725" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(10,0.199,0.795)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74341" "field" nil "attribute" "question/problem" "value" "The point $A$ has Cartesian coordinates $(1,-1,\\sqrt{2}).$ What are the spherical polar coordinates of $A?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74341" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-1)^{2}+(\\sqrt{2})^{2}} \\\\  & =\\sqrt{1+1+2} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nNow, $(x,y)=(1,-1)$ lies in the fourth quadrant. So to find $\\theta ,$ we first need to find the reference angle ${\\theta }_{R}:$ \n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-1}{1}| \\\\  & =\\operatorname{arctan}⁡(1) \\\\  & =\\frac{\\pi }{4}\\end{aligned}\n$$\n\nNext, we subtract the reference angle from $2\\pi $ to get $\\theta :$\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{4} \\\\  & =\\frac{7\\pi }{4}\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $A$ are $(2,\\frac{7\\pi }{4},\\frac{\\pi }{4}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74341" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-74341" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74341" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(2,-\\frac{7\\pi }{4},\\frac{\\pi }{4})"] ["math" "(2,\\frac{7\\pi }{4},-\\frac{\\pi }{4})"] ["math" "(2,\\frac{7\\pi }{4},\\frac{\\pi }{4})"] ["math" "(2\\sqrt{2},\\frac{3\\pi }{4},\\frac{\\pi }{4})"] ["math" "(2\\sqrt{2},\\frac{\\pi }{4},\\frac{\\pi }{4})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74341" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(2,\\frac{7\\pi }{4},\\frac{\\pi }{4})"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165299" "field" nil "attribute" "question/problem" "value" "The point $K$ has Cartesian coordinates $(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2},-1).$ What are the spherical polar coordinates of $K?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165299" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{{(-\\frac{\\sqrt{3}}{2})}^{2}+{(-\\frac{1}{2})}^{2}+{(-1)}^{2}} \\\\  & =\\sqrt{\\frac{3}{4}+\\frac{1}{4}+1} \\\\  & =\\sqrt{2}\\end{aligned}\n$$\n\nNow, $(x,y)=(-\\frac{\\sqrt{3}}{2},-\\frac{1}{2})$  lies in the third quadrant. So to find $\\theta ,$ we first need to find the reference angle ${\\theta }_{R}:$ \n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\frac{1}{2}}{-\\frac{\\sqrt{3}}{2}}| \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\n \n\nNext, we add $\\pi $ to the reference angle to get $\\theta :$\n\n$$\n\\begin{aligned}\\theta  & ={\\theta }_{R}+\\pi  \\\\  & =\\frac{\\pi }{6}+\\pi  \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(-\\frac{1}{\\sqrt{2}}) \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $K$ are $(\\sqrt{2},\\frac{7\\pi }{6},\\frac{3\\pi }{4}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165299" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-165299" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165299" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(2,\\frac{11\\pi }{6},\\frac{3\\pi }{4})"] ["math" "(2,\\frac{7\\pi }{6},\\frac{\\pi }{4})"] ["math" "(\\sqrt{2},\\frac{11\\pi }{6},\\frac{3\\pi }{4})"] ["math" "(\\sqrt{2},\\frac{5\\pi }{6},\\frac{\\pi }{4})"] ["math" "(\\sqrt{2},\\frac{7\\pi }{6},\\frac{3\\pi }{4})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-165299" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\sqrt{2},\\frac{7\\pi }{6},\\frac{3\\pi }{4})"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74342" "field" nil "attribute" "question/problem" "value" "The point $B$ has Cartesian coordinates $(-1,2,-\\sqrt{3}).$ What are the spherical polar coordinates $(\\rho ,\\theta ,ϕ)$ of $B?$ Express $\\theta $ and $ϕ$ in radians rounded to three decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74342" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{2}^{2}+(\\sqrt{3})^{2}} \\\\  & =\\sqrt{1+4+3} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$\n\nNow, $(x,y)=(-1,2)$ lies in the second quadrant. So to find $\\theta $, we first need to find the reference angle ${\\theta }_{R}:$\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{2}{-1}| \\\\  & =\\operatorname{arctan}⁡(2) \\\\  & ≈1.107\\,149\\end{aligned}\n$$\n\nNext, we subtract the reference angle from $\\pi $ to get $\\theta :$\n\n$$\n\\begin{aligned}\\theta  & =\\pi -{\\theta }_{R} \\\\  & ≈\\pi -1.107\\,149 \\\\  & ≈2.034\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(\\frac{-\\sqrt{3}}{2\\sqrt{2}}) \\\\  & =\\operatorname{arccos}⁡(-\\sqrt{\\frac{3}{8}}) \\\\  & ≈2.230.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $B$ are $(\\sqrt{5},2.034,2.230).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74342" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-74342" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74342" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(2\\sqrt{2},2.034,1.251)"] ["math" "(2\\sqrt{2},2.034,2.230)"] ["math" "(\\sqrt{2},0.769,2.034)"] ["math" "(\\sqrt{2},1.251,2.457)"] ["math" "(\\sqrt{2},2.034,0.769)"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74342" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(2\\sqrt{2},2.034,2.230)"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74720" "field" nil "attribute" "question/problem" "value" "The point $U$ has Cartesian coordinates $(1,-\\sqrt{3},2).$ What are the spherical polar coordinates of $U?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74720" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho ,\\theta ,ϕ)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx=\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ,\\,y=\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ,\\,z=\\rho \\operatorname{cos}⁡ϕ\n$$\n\nFrom the above equations, we can express $\\rho $, $\\theta $, and $ϕ$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}},\\,\\operatorname{tan}⁡\\theta =\\frac{y}{x},\\,\\operatorname{cos}⁡ϕ=\\frac{z}{\\rho }\n$$\n\nFirst, we find $\\rho :$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{{1}^{2}+(-\\sqrt{3})^{2}+{2}^{2}} \\\\  & =\\sqrt{1+3+4} \\\\  & =\\sqrt{8} \\\\  & =2\\sqrt{2}\\end{aligned}\n$$\n\nNow, $(x,y)=(1,-\\sqrt{3})$ lies in the fourth quadrant. So to find $\\theta ,$ we first need to find the reference angle ${\\theta }_{R}:$ \n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-\\sqrt{3}}{1}| \\\\  & =\\operatorname{arctan}⁡(\\sqrt{3}) \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nNext, we subtract the reference angle from $2\\pi $ to get $\\theta :$\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{5\\pi }{3}\\end{aligned}\n$$\n\nFinally, for $ϕ$, we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(\\frac{2}{2\\sqrt{2}}) \\\\  & =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $U$ are $(2\\sqrt{2},\\frac{5\\pi }{3},\\frac{\\pi }{4}).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74720" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/activity-metadata.json" "file_sha256" "a11863d4aedb343c63cde88c7118ffce3447ea0bcbacd24766d7f9980e695526"} {"question" "q-74720" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74720" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(2,\\frac{5\\pi }{6},\\frac{\\pi }{8})"] ["math" "(2\\sqrt{2},\\frac{5\\pi }{3},\\frac{\\pi }{4})"] ["math" "(2\\sqrt{2},\\frac{5\\pi }{6},\\frac{\\pi }{4})"] ["math" "(2\\sqrt{3},\\frac{7\\pi }{6},\\frac{3\\pi }{4})"] ["math" "(2\\sqrt{3},\\frac{\\pi }{3},\\frac{3\\pi }{4})"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "q-74720" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(2\\sqrt{2},\\frac{5\\pi }{3},\\frac{\\pi }{4})"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/state.json" "file_sha256" "1dec5651a26cc76a7511d3072282061bf93df7fee4bebcd65895c70488438f4f"} {"question" "e-6225" "field" nil "attribute" "question/problem" "value" "What are the spherical polar coordinates of the point $P?$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/assets/02219461392f94791f20e3e7f0e125e846b602862524b381fa909530e0f4e9d6.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/example-6225.json" "file_sha256" "50088c045264c50b8ea4fcbdf7e7496702d29573786da0e41a7eaf1d6ec89530"} {"question" "e-6225" "field" nil "attribute" "question/worked-solution" "value" "We write the position of a point in spherical polar coordinates as $(\\rho,\\theta,\\phi),$ where $\\rho \\geq 0,$ $0 \\leq \\theta <   2\\pi,$ and $0 \\leq \\phi \\leq \\pi.$\n\nAccording to the diagram, we have the following: \n\n- The distance from the origin to the point $P$ equals $4$ units.\n\n- The half-plane that contains the point $P$ and whose boundary is the $z$-axis forms an angle of \n\n$$\n\\dfrac{\\pi}2-\\dfrac{\\pi}{5}=\\dfrac{3\\pi}{10}\n$$\n\n radians with the positive $x$-axis.\n\n- The line that passes through the origin and the point $P$ forms an angle of $\\dfrac{\\pi}{6}$ radians with the positive $z$-axis.\n\nTherefore, the spherical coordinates of $P$ are $\\left(4, \\dfrac{3\\pi}{10}, \\dfrac{\\pi}{6} \\right).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/example-6225.json" "file_sha256" "50088c045264c50b8ea4fcbdf7e7496702d29573786da0e41a7eaf1d6ec89530"} {"question" "e-6226" "field" nil "attribute" "question/problem" "value" "The point $Q$ has spherical coordinates $\\left(2\\sqrt3, \\pi, \\dfrac{5\\pi}{6} \\right).$ Find the Cartesian coordinates of $Q.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/example-6226.json" "file_sha256" "c21313c34d80baeccb70d9eef5dc16d89c3c4c39ca9f601edee9a05d00d04fc3"} {"question" "e-6226" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho, \\theta, \\phi)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad\ny = \\rho\\sin\\theta\\sin\\phi, \\qquad \nz = \\rho\\cos\\phi.\n$$\n\nCalculating $x,$ we get \n\n$$\n\\begin{aligned}x & =\\rho \\operatorname{cos}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =2\\sqrt{3}\\operatorname{cos}⁡(\\pi )\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =2\\sqrt{3}\\cdot (-1)\\cdot \\frac{1}{2} \\\\  & =-\\sqrt{3}.\\end{aligned}\n$$\n\nCalculating $y,$ we get\n\n$$\n\\begin{aligned}y & =\\rho \\operatorname{sin}⁡\\theta \\operatorname{sin}⁡ϕ \\\\  & =2\\sqrt{3}\\operatorname{sin}⁡(\\pi )\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =2\\sqrt{3}\\cdot 0\\cdot \\frac{1}{2} \\\\  & =0.\\end{aligned}\n$$\n\nCalculating $z,$ we get\n\n$$\n\\begin{aligned}z & =\\rho \\operatorname{cos}⁡ϕ \\\\  & =2\\sqrt{3}\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =2\\sqrt{3}\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-3.\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $Q$ are $(-\\sqrt3, 0, -3).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/example-6226.json" "file_sha256" "c21313c34d80baeccb70d9eef5dc16d89c3c4c39ca9f601edee9a05d00d04fc3"} {"question" "e-6227" "field" nil "attribute" "question/problem" "value" "The point $P$ has Cartesian coordinates $(-\\sqrt2,0,\\sqrt2).$ What are the spherical polar coordinates of  $P?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/example-6227.json" "file_sha256" "12ce0b232a30d251caee3f4ea4c950562532c3b6caa84c4223a407e049af964c"} {"question" "e-6227" "field" nil "attribute" "question/worked-solution" "value" "If $(\\rho, \\theta, \\phi)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad \ny = \\rho\\sin\\theta\\sin\\phi, \\qquad \nz = \\rho\\cos\\phi.\n$$\n\nFrom the above equations, we can express $\\rho$, $\\theta$, and $\\phi$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho = \\sqrt{x^2+y^2+z^2}, \\qquad\n\\tan\\theta = \\dfrac{y}{x}, \\qquad\n\\cos\\phi = \\dfrac{z}{\\rho}.\n$$\n\nFirst, we find $\\rho\\mathbin{:}$\n\n$$\n\\begin{aligned}\\rho  & =\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}} \\\\  & =\\sqrt{(-\\sqrt{2})^{2}+{0}^{2}+{(\\sqrt{2})}^{2}} \\\\  & =\\sqrt{2+0+2} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nNow, $(x,y) = (-\\sqrt2,0)$ lies on the negative $x$-axis, so\n\n$$\n\\begin{aligned}\\theta  & =\\pi .\\end{aligned}\n$$\n\n \n\nFinally, for $\\phi,$ we obtain\n\n$$\n\\begin{aligned}ϕ & =\\operatorname{arccos}⁡(\\frac{z}{\\rho }) \\\\  & =\\operatorname{arccos}⁡(\\frac{\\sqrt{2}}{2}) \\\\  & =\\frac{\\pi }{4}.\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $P$ are $\\left(2, \\pi,  \\dfrac{\\pi}4 \\right).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/example-6227.json" "file_sha256" "12ce0b232a30d251caee3f4ea4c950562532c3b6caa84c4223a407e049af964c"} {"question" "q-74543" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(2,\\frac{\\pi }{3},\\frac{\\pi }{4})"] "category" "reviewed_ma_solution" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/answer-source-reviews.json" "file_sha256" "6affe811ee9a5e8b9f059124384f2fcc94b8e07aaa097753da88d96db9ab119a" "reviewer_session" "01a11908-fa8d-7c61-8e03-c1185d0b9506" "rationale" "The diagram labels the distance OD as 2 and the inclination from positive z as π/4. The marked π/6 is measured from positive y to the half-plane containing D, so the azimuth from positive x is π/2−π/6=π/3. Therefore (ρ,θ,ϕ)=(2,π/3,π/4), original option e. The authentic worked solution explicitly confirms this derivation, and saved grading reports Correct. This review documents the derived judgment and preserves the genuine difference from the stored π/6 azimuth." "bindings" {"problem" "f0bc1e790a0b5280119d06682f82af1d83c7c61174fb23efeb1672ccf8647d73" "worked_solution" "e88656036fbbf155aa5b51c4b69c81e4a89c69252d97061f6e819313f4cf40e5" "original_field" "61d62601da6633a0ace47ef4f9a4ecc58cf181f88e97051f826a19c4f5124bb4" "reviewed_field" "81b5c0b5b0e5f4519f38b5113812ff6c4a458ec9a95cf7cf964d87d60ebaeb0d" "raw_widget" "63d40762ae4f5086d8be1115f9b579c321b7d42edbc6cd2ead6209cf609f5cb5"} "evidence_files" [{"path" "q-74543-before.png" "sha256" "21e4fdd24bd3736e043c3573ba3795dba0cd5af7230c40873e50fca4bb3e2cda"} {"path" "q-74543-before.json" "sha256" "97bd59047aa08b8d9401eed606c5d1ea9ad49d191f55d15b92b8cc6948116409"} {"path" "history-q-74543.png" "sha256" "c7a4acb63d21842932e9675c657459f881fd10cc4c315c0316edd5388a5627f7"} {"path" "history-q-74543.json" "sha256" "883a80471a3e6b367fc46d48d367883cc93a1db0e41bedf084fb3f96a170f4b7"} {"path" "q-74543-after.json" "sha256" "d7751bf1668fa803bd0335f1d5b37f34ccdfa61ac8ae69878efaf1a3b7b7fb5d"} {"path" "edb-import/questions.edn" "sha256" "b10eac6a8d128583cc042f726c403b42cbc8040908b100f0d5664167eb0a4928"}]} {"question" "q-74543" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(2,\\frac{\\pi }{3},\\frac{\\pi }{4})"] ["math" "(2,\\frac{\\pi }{6},\\frac{\\pi }{4})"] ["math" "(4,\\frac{\\pi }{3},\\frac{\\pi }{4})"] ["math" "(\\sqrt{2},\\frac{\\pi }{3},\\frac{-\\pi }{4})"] ["math" "(\\sqrt{2},\\frac{\\pi }{6},\\frac{\\pi }{4})"]] "category" "reviewed_ma_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037850/answer-source-reviews.json" "file_sha256" "6affe811ee9a5e8b9f059124384f2fcc94b8e07aaa097753da88d96db9ab119a" "rationale" "The diagram labels the distance OD as 2 and the inclination from positive z as π/4. The marked π/6 is measured from positive y to the half-plane containing D, so the azimuth from positive x is π/2−π/6=π/3. Therefore (ρ,θ,ϕ)=(2,π/3,π/4), original option e. The authentic worked solution explicitly confirms this derivation, and saved grading reports Correct. This review documents the derived judgment and preserves the genuine difference from the stored π/6 azimuth."}] "usage" {"e-6225" [] "e-6227" [] "q-74320" [] "q-74543" [] "q-74341" [] "q-74342" [] "e-6226" []} "basis" 1284 "retractions" [[17592186129800 :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1982/Source/Images/q-74320.png)\n\nWhat are the spherical polar coordinates of the point $A$?"] [17592186129806 :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1982/Source/Images/q-74543.png)\n\nWhat are the spherical polar coordinates of the point $D$?"] [17592186129806 :question/answer-fields 17592186128630] [17592186129803 :question/problem "The point $A$ has Cartesian coordinates $(1,-1, \\sqrt{2})$. What are the spherical polar coordinates of $A$?"] [17592186129804 :question/problem "The point $B$ has Cartesian coordinates $(-1, 2,-\\sqrt{3})$. What are the spherical polar coordinates $(ρ, θ, ϕ)$ of $B$? Express $θ$ and $ϕ$ in radians rounded to three decimal places."] [17592186128938 :question/problem "What are the spherical polar coordinates of the point $P$?\n\n![](/home/jake/Developer/MA/DATA/Lessons/1982/Source/Images/f1f3dd486bff704208c9340c8937defb.png)"] [17592186128938 :question/worked-solution "We write the position of a point in spherical polar coordinates as $(\\rho,\\theta,\\phi)$, where\n\n$$\n\\rho \\geq 0\n$$\n\n$$\n0 \\leq \\theta < 2\\pi\n$$\n\nand\n\n$$\n0 \\leq \\phi \\leq \\pi\n$$\n\nAccording to the diagram, we have the following:\n\n- The distance from the origin to the point $P$ equals $4$ units.\n- The half-plane that contains the point $P$ and whose boundary is the $z$-axis forms an angle of $\\dfrac{\\pi}2-\\dfrac{\\pi}{5}=\\dfrac{3\\pi}{10}$ radians with the positive $x$-axis.\n- The line that passes through the origin and the point $P$ forms an angle of $\\dfrac{\\pi}{6}$ radians with the positive $z$-axis.\n\nTherefore, the spherical coordinates of $P$ are\n\n$$\n\\left(4, \\dfrac{3\\pi}{10}, \\dfrac{\\pi}{6} \\right)\n$$"] [17592186128939 :question/problem "The point $Q$ has spherical coordinates $\\left(2\\sqrt3, \\pi, \\dfrac{5\\pi}{6} \\right)$. Find the Cartesian coordinates of $Q$."] [17592186128939 :question/worked-solution "If $(\\rho, \\theta, \\phi)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad y = \\rho\\sin\\theta\\sin\\phi, \\qquad z = \\rho\\cos\\phi\n$$\n\nCalculating $x$, we get\n\n$$\n\\begin{aligned}\nx &= ρ\\cos θ\\sin ϕ \\\\\n&= 2\\sqrt{3}\\cos (π)\\sin (\\frac{5π}{6}) \\\\\n&= 2\\sqrt{3} \\cdot (-1) \\cdot \\frac{1}{2} \\\\\n&=-\\sqrt{3}\n\\end{aligned}\n$$\n\nCalculating $y$, we get\n\n$$\n\\begin{aligned}\ny &= ρ\\sin θ\\sin ϕ \\\\\n&= 2\\sqrt{3}\\sin (π)\\sin (\\frac{5π}{6}) \\\\\n&= 2\\sqrt{3} \\cdot 0 \\cdot \\frac{1}{2} \\\\\n&= 0\n\\end{aligned}\n$$\n\nCalculating $z$, we get\n\n$$\n\\begin{aligned}\nz &= ρ\\cos ϕ \\\\\n&= 2\\sqrt{3}\\cos (\\frac{5π}{6}) \\\\\n&= 2\\sqrt{3} \\cdot (-\\frac{\\sqrt{3}}{2}) \\\\\n&=-3\n\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $Q$ are $(-\\sqrt3, 0, -3)$."] [17592186128940 :question/problem "The point $P$ has Cartesian coordinates $(-\\sqrt2,0,\\sqrt2)$. What are the spherical polar coordinates of $P$?"] [17592186128940 :question/worked-solution "If $(\\rho, \\theta, \\phi)$ are the spherical coordinates of a point, then its Cartesian coordinates $(x,y,z)$ can be found by using the following formulas:\n\n$$\nx = \\rho\\cos\\theta\\sin\\phi, \\qquad y = \\rho\\sin\\theta\\sin\\phi, \\qquad z = \\rho\\cos\\phi\n$$\n\nFrom the above equations, we can express $\\rho$, $\\theta$, and $\\phi$ in terms of $x$, $y$, and $z$ as follows:\n\n$$\n\\rho = \\sqrt{x^2+y^2+z^2}, \\qquad \\tan\\theta = \\dfrac{y}{x}, \\qquad \\cos\\phi = \\dfrac{z}{\\rho}\n$$\n\nFirst, we find $\\rho$:\n\n$$\n\\begin{aligned}\nρ &= \\sqrt{x^{2} + y^{2} + z^{2}} \\\\\n&= \\sqrt{(-\\sqrt{2})^{2} + 0^{2} + (\\sqrt{2})^{2}} \\\\\n&= \\sqrt{2 + 0 + 2} \\\\\n&= \\sqrt{4} \\\\\n&= 2\n\\end{aligned}\n$$\n\nNow,\n\n$$\n(x,y) = (-\\sqrt2,0)\n$$\n\nlies on the negative $x$-axis, so\n\n$$\n\\begin{aligned}\nθ &= π\n\\end{aligned}\n$$\n\nFinally, for $\\phi$, we obtain\n\n$$\n\\begin{aligned}\nϕ &= \\arccos (\\frac{z}{ρ}) \\\\\n&= \\arccos (\\frac{\\sqrt{2}}{2}) \\\\\n&= \\frac{π}{4}\n\\end{aligned}\n$$\n\nTherefore, the spherical coordinates of $P$ are\n\n$$\n\\left(2, \\pi, \\dfrac{\\pi}4 \\right)\n$$"]] "immutable_answers" [17592186128595 17592186128596 17592186128597 17592186128598 17592186128599 17592186128613 17592186128614 17592186128615 17592186128616 17592186128617 17592186128619 17592186128620 17592186128621 17592186128622 17592186128623 17592186128631 17592186128632 17592186128633 17592186128634 17592186128635] "immutable_fields" [[17592186128594 :answer-field/correct] [17592186128594 :answer-field/id] [17592186128594 :answer-field/key] [17592186128594 :answer-field/type] [17592186128612 :answer-field/correct] [17592186128612 :answer-field/id] [17592186128612 :answer-field/key] [17592186128612 :answer-field/type] [17592186128618 :answer-field/correct] [17592186128618 :answer-field/id] [17592186128618 :answer-field/key] [17592186128618 :answer-field/type] [17592186128630 :answer-field/correct] [17592186128630 :answer-field/id] [17592186128630 :answer-field/key] [17592186128630 :answer-field/type]] "no_history" 