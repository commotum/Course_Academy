[{:db/id [:question/math-academy-id "q-35520"] :question/problem "Which of the following represents the level curves of $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nNotice that the range of $f(x,y)$ is $[0,\\infty ).$ So, we will consider only level curves for $c\\ge 0.$\n\nTherefore, we have:\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ \\sqrt{{x}^{2}+{y}^{2}} & =c \\\\ {x}^{2}+{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nThe equation above gives us a family of circles centered at the origin. Therefore, the correct graph is as follows:\n\n$$\n\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/413a11a52ed6a4fc76c2848867d664a63fce24dd39088cdd5826b576d8e7b09c.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-35527/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "063c3081-fc99-5c59-9c9c-17dc1247f778" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-35527/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "93ab8cf8-df3c-545b-9e70-4de71e0b453c" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-35527/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e6de069c-00e7-55c3-abef-12f93304c62a" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-35527/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "b0e38b30-9540-5800-a818-37d8d43cae7c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-35527/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "40169a3d-04d9-5678-84cf-d8a54ff12072" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-35527/selection" :answer-field/id #uuid "375cdb08-607e-5f82-98dc-008ebfc21d03" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35527/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer-field/choices ["q-35527/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-35527/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-35527/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-35527/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-35527/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-35527" :question/id #uuid "fb8b2d04-67d4-51d3-8ebf-71fc804b1a61" :question/math-academy-id "q-35527" :question/problem "The level curves of the function $f(x,y)=xy$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=1$ gives a hyperbola\n- $c=-1$ gives a parabola\n- $c=0$ gives the axes $x=0$ and $y=0$" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}xy & =c\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=\\pm 1$ then the level curves are $xy=\\pm 1,$ which are hyperbolas.\n\n- If $c=0$ then the level curves are $xy=0,$ which consists of the axes $x=0$ and $y=0.$\n\nSo, only statements I and III are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-35527/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49"] :knowledge-point/questions ["q-35527"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71395/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "0c6d9b72-e083-5051-85d3-58f0292d9e58" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-71395/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "286957ec-8684-5aae-8c65-4489a40574c4" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-71395/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "3c88c9de-96bf-5b35-8169-1b8671e4e00d" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-71395/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "8fe6c2e5-9236-5ba4-93ec-d695c3eb9c67" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-71395/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "97dcfe1e-2ae5-5418-bd47-555110b4615c" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-71395/selection" :answer-field/id #uuid "ba0d035f-188d-5d33-9360-40e5e980a843" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71395/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer-field/choices ["q-71395/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-71395/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-71395/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-71395/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-71395/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b"] :db/ensure [:answer-field/validate]} {:db/id "q-71395" :question/id #uuid "8f4b2eba-eaa0-5faa-a68a-66c51bc54701" :question/math-academy-id "q-71395" :question/problem "The level curves of the function $f(x,y)=\\sqrt{{x}^{2}-2{y}^{2}}$ are given by $f(x,y)=c.$ Which of the following statements are true?\n\n- $c=1$ gives a line\n- $c=2$ gives a hyperbola\n- $c=0$ gives two lines" :question/worked-solution "Setting $f(x,y)=c$ gives:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}-2{y}^{2}} & =c \\\\ {x}^{2}-2{y}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore:\n\n- If $c=1$ then the level curve is ${x}^{2}-2{y}^{2}=1,$ which is not a line.\n\n- If $c=2$ then the level curve is ${x}^{2}-2{y}^{2}=4,$ which is a hyperbola.\n\n- If $c=0$ then the level curve is $y=\\pm \\frac{x}{\\sqrt{2}},$ which consists of two lines.\n\nSo, only statements II and III are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71395/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "74f126da-5f3b-5af8-9aee-d6f0a4c61c49"] :knowledge-point/questions ["q-71395"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129117/selection/633e72742b0628144f65b7b465bac1c75808b0cd3bb4340632bdc0784820a28d" :answer/id #uuid "efe2f36b-4e61-58a3-9d0a-e8f44ae8a871" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png" :db/ensure [:answer/validate]} {:db/id "q-129117/selection/9a3f74893d6ac203cd7a6512c693bdd4833011e86cac46bbc1db8b2ba8b9a89a" :answer/id #uuid "d9862cec-d2cf-5bea-9a7f-abe4dd0acc4d" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/09f1a18e1a6fdcd29a40026cbffd8e8bdec23511bb692a1e920c18f942042470.png" :db/ensure [:answer/validate]} {:db/id "q-129117/selection/ab1e1814144ff0adeaab0b770995e736c024952e31004158045e4b957847640c" :answer/id #uuid "d5c71f78-d19f-5a27-81e3-6db69cacd8b4" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/aa4d0cd189808c717648640c5543a632c099970a19d38d44298d409054f2627c.png" :db/ensure [:answer/validate]} {:db/id "q-129117/selection/288be98f5356ad739e5ae382a3e588ade6f00a8d10b40d4a64a83a6e44fad03e" :answer/id #uuid "93cb7e55-2150-5080-9903-922ca34c9007" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/56e923e4c1e2603c9bd3c621df0a5a4043fcc6a37ac73427be14541407fc19d8.png" :db/ensure [:answer/validate]} {:db/id "q-129117/selection/30a53dcc5037e37cbec33c167333bd9af5cae5d1936e4eeb25393f140dbf7c3e" :answer/id #uuid "d5fac066-b7e1-5b1a-92c8-18b880099c2a" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/bf0f4b592cde648f63b21523aba1a49aeeb3b4dcaf909ba72c4629e088ca372a.png" :db/ensure [:answer/validate]} {:db/id "q-129117/selection" :answer-field/id #uuid "7bd5fd88-c341-5d33-a06a-b249288d207d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129117/selection/633e72742b0628144f65b7b465bac1c75808b0cd3bb4340632bdc0784820a28d" :answer-field/choices ["q-129117/selection/633e72742b0628144f65b7b465bac1c75808b0cd3bb4340632bdc0784820a28d" "q-129117/selection/9a3f74893d6ac203cd7a6512c693bdd4833011e86cac46bbc1db8b2ba8b9a89a" "q-129117/selection/ab1e1814144ff0adeaab0b770995e736c024952e31004158045e4b957847640c" "q-129117/selection/288be98f5356ad739e5ae382a3e588ade6f00a8d10b40d4a64a83a6e44fad03e" "q-129117/selection/30a53dcc5037e37cbec33c167333bd9af5cae5d1936e4eeb25393f140dbf7c3e"] :db/ensure [:answer-field/validate]} {:db/id "q-129117" :question/id #uuid "9ec437fa-7d05-53d2-8259-19727f28f519" :question/math-academy-id "q-129117" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/037422e7b1ce3b3d9067aba39c4fa85c6311770e63e70758c34aa61629c7f58e.png)\n\nWhich of the following could represent the level curves of the surface $z=-\\operatorname{sin}⁡y$ shown above?" :question/worked-solution "First, notice that the range of $f(x,y)$ is $[-1,1].$ So, we will consider only $c$-level curves for $c\\in [-1,1].$\n\nThe level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -\\operatorname{sin}⁡y & =c \\\\ y & =-\\operatorname{arcsin}⁡c+2\\pi n,\\end{aligned}\n$$\n\nwhere $n$ can be any integer. \n\nNotice that the equations $y=-\\operatorname{arcsin}⁡c+2\\pi n$ do not depend on $x.$ So, for a given $c\\in [-1,1]$ and integer $n$, the right-hand side of the equation is constant. As a result, we obtain a family of horizontal lines, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/67e9cfee7779fdde389a0804e7f52372ca9434de56b6611d296d4ac9c0759f72.png)" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-129117/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822"] :knowledge-point/questions ["q-129117"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129118/selection/04ad28a45b5e747dc6c9f2a3f6e249f2f395f76a74069294ee78babfe6d0dcfc" :answer/id #uuid "4cb84bfe-c871-5320-9d4c-83f92579b07b" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/7afff53b46a661fc6e0df4df871810dc5514ff7b476294e76c70f60d4e1643f9.png" :db/ensure [:answer/validate]} {:db/id "q-129118/selection/2312c13265d705e261d873d0fedee217eca4553189e41faad47a062b35a8d200" :answer/id #uuid "c637bc28-4d05-5ed2-b6b9-1edf81fd13a3" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/b79c75fb4de77313ff9ae17938eeabc8b55cca395e6516c09abf6742f9b6a23b.png" :db/ensure [:answer/validate]} {:db/id "q-129118/selection/f467de225a87dfd9ffb3fbc12f250af0deb6e7ccdf5ece85aac69af7c4526260" :answer/id #uuid "e067a96f-7163-5e68-ac5f-5ac9b0900d8f" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/f82efe38e48f39aee18cf9e00cdd69f07c37cc414b08b5bc78ebc0a876c02d7e.png" :db/ensure [:answer/validate]} {:db/id "q-129118/selection/afe12fd4a77e7be0b59b93d18b5c0d7bb72fc311a55c371a49eb3080fda25d6d" :answer/id #uuid "dc098fa2-da6b-5025-8d8d-4e55c6bae734" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/0162f31b5dbb35c6d370dff9b54257708df39b6957f6547059842cd31769669b.png" :db/ensure [:answer/validate]} {:db/id "q-129118/selection/dee957e2a0c072f224f1b1ad80195defdb0ba0d6f649fe0bc83ebadf0bbb5b70" :answer/id #uuid "bff51616-e5c0-5d20-abc4-71ea33277efb" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/b4642ea9b585ac066f2ed904b1bee4df7d1ff3449ba2d09afca8364b58f1dcba.png" :db/ensure [:answer/validate]} {:db/id "q-129118/selection" :answer-field/id #uuid "7cdebb0d-3dd1-5854-a760-38aa8a17c565" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129118/selection/04ad28a45b5e747dc6c9f2a3f6e249f2f395f76a74069294ee78babfe6d0dcfc" :answer-field/choices ["q-129118/selection/04ad28a45b5e747dc6c9f2a3f6e249f2f395f76a74069294ee78babfe6d0dcfc" "q-129118/selection/2312c13265d705e261d873d0fedee217eca4553189e41faad47a062b35a8d200" "q-129118/selection/f467de225a87dfd9ffb3fbc12f250af0deb6e7ccdf5ece85aac69af7c4526260" "q-129118/selection/afe12fd4a77e7be0b59b93d18b5c0d7bb72fc311a55c371a49eb3080fda25d6d" "q-129118/selection/dee957e2a0c072f224f1b1ad80195defdb0ba0d6f649fe0bc83ebadf0bbb5b70"] :db/ensure [:answer-field/validate]} {:db/id "q-129118" :question/id #uuid "fdd99af4-5961-5150-ae64-8efce48fac73" :question/math-academy-id "q-129118" :question/problem "Which of the following represents the level curves of $f(x,y)=-x-y+2?$" :question/worked-solution "The level curves for the function $f(x,y)$ are given by the equations \n\n$$\nf(x,y)=c.\n$$\n\nnotice that the range of $f(x,y)$ is $(-\\infty ,\\infty ).$ So, we will consider $c$-level curves for any real value of $c.$\n\nTherefore, we have\n\n$$\n\\begin{aligned}f(x,y) & =c \\\\ -x-y+2 & =c \\\\ y & =-x+2-c.\\end{aligned}\n$$\n\nThe equation above gives us a family of lines with slope of $-1.$ Therefore, the correct graph is as follows:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069946/assets/e20175ef9ac473a621a67d524e60cacc6e9a40ba30267fe81b4e6a093c780c28.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129118/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dfd8982d-d859-5eb2-9f35-69af39c04822"] :knowledge-point/questions ["q-129118"] :db/ensure [:knowledge-point/validate]}]
