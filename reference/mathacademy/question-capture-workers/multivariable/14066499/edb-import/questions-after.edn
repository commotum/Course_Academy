#{[{:db/id #edb/ref 17592186353022 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d37483d0-54e8-56db-8cf8-399d748e4c93" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}}{2}+2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186353024} {:answer/id #uuid "8a92530f-fd1b-503d-abf8-85b1f00d8ad4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}}{4}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186353025} {:answer/id #uuid "585c146e-b9a2-529b-8cca-56ef10f4d4e6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{4}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186353026} {:answer/id #uuid "c4a61483-3df0-514b-a9dd-0f74ccbddf3f" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}}{4}+2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186353027} {:answer/id #uuid "26f06fbf-1b3a-5651-b948-1bed46033232" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{x}{2}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186353028}] :answer-field/correct {:answer/id #uuid "8a92530f-fd1b-503d-abf8-85b1f00d8ad4" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{{x}^{2}}{4}-2\\operatorname{cot}⁡x+C" :db/id #edb/ref 17592186353025} :answer-field/id #uuid "e6d87b6a-2d8d-5f42-b424-21c45ef8dfa4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353023}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a1b26c3b-96b0-52d3-9e98-7e02650b6e2d" :question/math-academy-id "q-10564" :question/problem "Calculate $\\int (2-\\frac{x}{2}+2{cot}^{2}⁡x)\\,\\text{d}x.$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ Rearranging this gives\n\n$$\n\\begin{aligned}{cot}^{2}⁡x & ={csc}^{2}⁡x-1.\\end{aligned}\n$$\n\nHence,\n\n$$\n\\begin{aligned}\\int (2-\\frac{x}{2}+2{cot}^{2}⁡x)\\,\\text{d}x & =\\int (2-\\frac{x}{2}+2({csc}^{2}⁡x-1))\\,\\text{d}x \\\\  & =\\int (2-\\frac{x}{2}+2{csc}^{2}⁡x-2)\\,\\text{d}x \\\\  & =\\int (-\\frac{x}{2}+2{csc}^{2}⁡x)\\,\\text{d}x \\\\  & =-\\frac{1}{2}\\cdot \\frac{{x}^{2}}{2}-2\\operatorname{cot}⁡x+C \\\\  & =-\\frac{{x}^{2}}{4}-2\\operatorname{cot}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353029 :knowledge-point/_questions [{:knowledge-point/id #uuid "d0ba6d15-a20e-5f16-b324-0bbead5458ca" :knowledge-point/title "Integrating Using the Cosecant-Cotangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc8913f3-7c76-5780-9a88-76683c3658d2" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{3}" :db/id #edb/ref 17592186353031} {:answer/id #uuid "ea7b310b-1192-584f-bf9e-354366ac057d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-1}{2}" :db/id #edb/ref 17592186353032} {:answer/id #uuid "314135c6-8c28-5843-ac94-2e9ba7313bf3" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}-1" :db/id #edb/ref 17592186353033} {:answer/id #uuid "77f2b83f-f92e-5e4a-b0d1-fd992e8ec06d" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186353034} {:answer/id #uuid "fbcb3a13-a994-5b70-b311-95aaf043c414" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-1}{3}" :db/id #edb/ref 17592186353035}] :answer-field/correct {:answer/id #uuid "ea7b310b-1192-584f-bf9e-354366ac057d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{3}-1}{2}" :db/id #edb/ref 17592186353032} :answer-field/id #uuid "bc3f3e3a-a469-510d-8cd3-e49689d40298" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353030}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f13ef730-2951-5e5c-80ec-1865f954d1d9" :question/math-academy-id "q-114460" :question/problem "Evaluate ${\\int }_{\\pi /6}^{\\pi /3}({sin}^{3}⁡x+{cot}^{2}⁡x{sin}^{3}⁡x)\\text{d}x.$" :question/worked-solution "In this case, we have to use the identity  $1+{cot}^{2}⁡x={csc}^{2}⁡x.$ \n\nTherefore, we have\n\n$$\n\\begin{aligned}{\\int }_{\\pi /6}^{\\pi /3}({sin}^{3}⁡x+{cot}^{2}⁡x{sin}^{3}⁡x)\\text{d}x & ={\\int }_{\\pi /6}^{\\pi /3}{sin}^{3}⁡x(1+{cot}^{2}⁡x)\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}{sin}^{3}⁡x{csc}^{2}⁡x\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}{sin}^{3}⁡x\\cdot \\frac{1}{{sin}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{\\pi /6}^{\\pi /3}\\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{cos}⁡x\\,{|}_{\\pi /6}^{\\pi /3} \\\\  & =-\\operatorname{cos}⁡(\\frac{\\pi }{3})+\\operatorname{cos}⁡(\\frac{\\pi }{6}) \\\\  & =-\\frac{1}{2}+\\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{3}-1}{2}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353036 :knowledge-point/_questions [{:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3d19df34-5268-5aa7-91b1-72e6f1aa2e1a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186353038} {:answer/id #uuid "3c1a18fa-5c09-5132-95a1-54715b01e4fc" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186353039}] :answer-field/correct {:answer/id #uuid "3d19df34-5268-5aa7-91b1-72e6f1aa2e1a" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186353038} :answer-field/id #uuid "ed501d06-2884-5539-8dfc-2dc73caea2e0" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186353037}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0899606b-48d4-500a-9606-9745cf9c9ef3" :question/math-academy-id "q-352671" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /4}\\frac{6(\\operatorname{sec}⁡x-\\operatorname{tan}⁡x)}{{cos}^{2}⁡x}\\cdot \\frac{1+\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the secant-tangent identity:\n\n$$\n{tan}^{2}⁡x+1={sec}^{2}⁡x\\,⟹\\,{sec}^{2}⁡x-{tan}^{2}⁡x=1\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{6(\\operatorname{sec}⁡x-\\operatorname{tan}⁡x)}{{cos}^{2}⁡x}\\cdot \\frac{1+\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}\\frac{6(\\operatorname{sec}⁡x-\\operatorname{tan}⁡x)}{{cos}^{2}⁡x}\\cdot (\\operatorname{sec}⁡x+\\operatorname{tan}⁡x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}\\frac{6({sec}^{2}⁡x-{tan}^{2}⁡x)}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}\\frac{6\\cdot 1}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}\\frac{6}{{cos}^{2}⁡x}\\,\\text{d}x \\\\  & =6{\\int }_{0}^{\\pi /4}{sec}^{2}⁡x\\,\\text{d}x \\\\  & =6\\operatorname{tan}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =6[\\operatorname{tan}⁡(\\frac{\\pi }{4})-\\operatorname{tan}⁡(0)] \\\\  & =6(1-0) \\\\  & =6\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353040 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe5822b4-c5d4-59a8-bd72-a41d3074e4e6" :knowledge-point/title "Integrating Trigonometric Expressions With Linear Arguments Using the Pythagorean Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "57fc5c32-2622-50d7-a787-547f6a2be4be" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186353042}] :answer-field/correct {:answer/id #uuid "57fc5c32-2622-50d7-a787-547f6a2be4be" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186353042} :answer-field/id #uuid "fbb8ab33-80a7-571c-a805-9daaa00fee00" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186353041}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5f22d656-7f8b-5701-b453-1c7fe0b91d9a" :question/math-academy-id "q-362813" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}[3{x}^{2}{csc}^{2}⁡(3x-\\frac{\\pi }{4})-3{x}^{2}{cot}^{2}⁡(3x-\\frac{\\pi }{4})]\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "From the identity ${csc}^{2}⁡\\theta -{cot}^{2}⁡\\theta =1$ with $\\theta =3x-\\frac{\\pi }{4},$ we get \n\n$$\n{csc}^{2}⁡(3x-\\frac{\\pi }{4})-{cot}^{2}⁡(3x-\\frac{\\pi }{4})=1.\n$$\n\nSubstituting the above into our integral gives\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[3{x}^{2}{csc}^{2}⁡(3x-\\frac{\\pi }{4})-3{x}^{2}{cot}^{2}⁡(3x-\\frac{\\pi }{4})]\\,\\text{d}x & ={\\int }_{0}^{1}3{x}^{2}[{csc}^{2}⁡(3x-\\frac{\\pi }{4})-{cot}^{2}⁡(3x-\\frac{\\pi }{4})]\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{2}(1)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}3{x}^{2}\\,\\text{d}x \\\\  & ={x}^{3}\\,{|}_{0}^{1} \\\\  & ={1}^{3}-{0}^{3} \\\\  & =1-0 \\\\  & =1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186353043 :knowledge-point/_questions [{:knowledge-point/id #uuid "9934a8da-2378-5019-a3a3-7cd66cbeeaa7" :knowledge-point/title "Integrating Using the Secant-Tangent Identity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a5e901fd-9c20-5737-be3e-cae363d6f15c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{192}" :db/id #edb/ref 17592186353045} {:answer/id #uuid "f7212ec1-f1c8-5e00-9659-481a4ab91c0d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}-1" :db/id #edb/ref 17592186353046} {:answer/id #uuid "89f4f244-84dd-5a7e-b6fd-1b8a61cd73b6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{3}-1" :db/id #edb/ref 17592186353047} {:answer/id #uuid "8b785743-cb39-5601-b5d9-a92012515b24" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\pi }{3}" :db/id #edb/ref 17592186353048} {:answer/id #uuid "6a1c6f0b-05ab-52e8-b4db-a87b1fff2644" :answer/type {:db/ident :answer.type/math} :answer/value "{\\pi }^{2}" :db/id #edb/ref 17592186353049}] :answer-field/correct {:answer/id #uuid "a5e901fd-9c20-5737-be3e-cae363d6f15c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{{\\pi }^{3}}{192}" :db/id #edb/ref 17592186353045} :answer-field/id #uuid "8e33d844-99c2-59fc-be9d-037dc920bfe2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186353044}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6c3bd164-cd8f-542d-8dad-087dc9d87ca2" :question/math-academy-id "q-73525" :question/problem "Evaluate ${\\int }_{0}^{\\pi /4}({x}^{2}{sec}^{2}⁡x-{x}^{2}{tan}^{2}⁡x)\\,\\text{d}x.$" :question/worked-solution "First, we select the identity that contains a ${tan}^{2}⁡x$ term. So we can use the identity \n\n$$\n{tan}^{2}⁡x+1={sec}^{2}⁡x\\,⟹\\,{sec}^{2}⁡x-{tan}^{2}⁡x=1.\n$$\n\nUsing the above, we compute the given integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}({x}^{2}{sec}^{2}⁡x-{x}^{2}{tan}^{2}⁡x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /4}{x}^{2}({sec}^{2}⁡x-{tan}^{2}⁡x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /4}{x}^{2}\\,\\text{d}x \\\\  & =\\frac{1}{3}{x}^{3}\\,{|}_{0}^{\\pi /4} \\\\  & =\\frac{1}{3}[{(\\frac{\\pi }{4})}^{3}-{0}^{3}] \\\\  & =\\frac{1}{3}\\cdot \\frac{{\\pi }^{3}}{64} \\\\  & =\\frac{{\\pi }^{3}}{192}\\end{aligned}\n$$"}]}
