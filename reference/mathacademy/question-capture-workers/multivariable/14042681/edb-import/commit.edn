xt{d}y\\end{aligned}\n$$\n\nNow, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}[{\\int }_{0}^{1}xy\\,\\text{d}x]\\text{d}y & ={\\int }_{0}^{1}y[{\\int }_{0}^{1}x\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{1}y{[\\frac{{x}^{2}}{2}]}_{0}^{1}\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}y(\\frac{{1}^{2}}{2}-\\frac{{0}^{2}}{2})\\,\\text{d}y \\\\  & ={\\int }_{0}^{1}\\frac{y}{2}\\,\\text{d}y\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{y}{2}\\,\\text{d}y & ={[\\frac{{y}^{2}}{4}]}_{0}^{1} \\\\  & =\\frac{{1}^{2}}{4}-\\frac{{0}^{2}}{2} \\\\  & =\\frac{1}{4}\\end{aligned}\n$$" 13194139535039 true] [17592186328328 1000 #edb/ref 17592186328329 13194139535039 true] [17592186328328 1000 #edb/ref 17592186328330 13194139535039 true] [17592186328328 1000 #edb/ref 17592186328331 13194139535039 true] [17592186328328 1000 #edb/ref 17592186328332 13194139535039 true] [17592186328328 1000 #edb/ref 17592186328333 13194139535039 true] [17592186328328 1040 #edb/ref 17592186045450 13194139535039 true] [17592186328328 1041 "selection" 13194139535039 true] [17592186328328 1104 #edb/ref 17592186328331 13194139535039 true] [17592186328328 1110 #uuid "8af86ba6-5b96-5391-bec4-a98d51d985ea" 13194139535039 true] [17592186328329 1034 "\\frac{1}{2}" 13194139535039 true] [17592186328329 1103 #edb/ref 17592186045453 13194139535039 true] [17592186328329 1111 #uuid "363694f2-1fb0-5b9b-980f-d61fd9cd90ba" 13194139535039 true] [17592186328330 1034 "2" 13194139535039 true] [17592186328330 1103 #edb/ref 17592186045453 13194139535039 true] [17592186328330 1111 #uuid "56783d26-7ea9-58ce-bf49-c5ff3cf187f3" 13194139535039 true] [17592186328331 1034 "\\frac{1}{4}" 13194139535039 true] [17592186328331 1103 #edb/ref 17592186045453 13194139535039 true] [17592186328331 1111 #uuid "2f6e613c-a3bf-5ef9-9620-12b3e1fab9fe" 13194139535039 true] [17592186328332 1034 "1" 1319413