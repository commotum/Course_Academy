e]} {:db/id [:knowledge-point/id #uuid "9f913fab-d0b5-5e9e-b292-039afe4a148c"] :knowledge-point/questions ["q-149628"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123069/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "7581a87c-2cc7-5af3-91dd-749cec688ab4" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-123069/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "20c0b6fc-b6db-5230-aa90-eb50213f2c4b" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-123069/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "21057187-cafd-5c3e-a3d3-a501a456f965" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-123069/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "68f338e0-bea6-5944-b877-d87fc787d930" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-123069/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "0c27b782-5755-5cda-8529-8f10bd09cbd3" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-123069/selection" :answer-field/id #uuid "a0bfa80e-5c71-56e7-b4b1-c5ce3d764331" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123069/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-123069/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-123069/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-123069/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-123069/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-123069/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-123069" :question/id #uuid "dbeaa7fe-8be4-5956-b251-01b99a5c3c36" :question/math-academy-id "q-123069" :question/problem "Consider the following partitions:\n\n- ${P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}}$ is a partition of the interval $[0,3]$\n\n- ${P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}}$ is a partition of the interval $[4,8]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" :question/worked-solution "Using the product rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j}={\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ and ${\\sum }_{j=1}^{n}Δ{y}_{j}$ are just the lengths of the intervals $[0,3]$ and $[4,8]$ respectively. So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =3-0=3, \\\\ {\\sum }_{j=1}^{n}Δ{y}_{j} & =8-4=4.\\end{aligned}\n$$\n\nCombining our results, we have\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}=3\\cdot 4=12.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123069/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f913fab-d0b5-5e9e-b292-039afe4a148c"] :knowledge-point/questions ["q-123069"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-122867"] :question/problem "Consider the following partitions:\n\n- ${P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}}$ is a partition of the interval $[0,2]$\n\n- ${P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}}$ is a partition of the interval $[1,6]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" :question/worked-solution "Using the product rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}Δ{x}_{i}Δ{y}_{j}={\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ and ${\\sum }_{j=1}^{n}Δ{y}_{j}$ are just the lengths of the intervals $[0,2]$ and $[1,6]$ respectively. So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =2-0=2, \\\\ {\\sum }_{j=1}^{n}Δ{y}_{j} & =6-1=5.\\end{aligned}\n$$\n\nCombining our results, we have\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}{\\sum }_{j=1}^{n}Δ{y}_{j}=2\\cdot 5=10.\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-123104/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" :answer/id #uuid "4c276730-1b3a-5e07-bc1e-0ce9710e2c96" :answer/type :answer.type/math :answer/value "-10" :db/ensure [:answer/validate]} {:db/id "q-123104/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" :answer/id #uuid "de1783a7-57ac-5755-a0c8-bbeaf0a6011d" :answer/type :answer.type/math :answer/value "20" :db/ensure [:answer/validate]} {:db/id "q-123104/selection/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" :answer/id #uuid "5c949722-1e7d-5792-970b-9445d731d798" :answer/type :answer.type/math :answer/value "40" :db/ensure [:answer/validate]} {:db/id "q-123104/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" :answer/id #uuid "3526e92a-7a16-5f62-b867-7f493880e8af" :answer/type :answer.type/math :answer/value "-20" :db/ensure [:answer/validate]} {:db/id "q-123104/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "c2046a9f-354a-546f-a30e-e03854ddcf6c" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-123104/selection" :answer-field/id #uuid "631a65c7-7138-5408-ba99-f41d1302f22b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123104/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-123104/selection/5d022a88a643e97abec4d01dfce48411101475c0705a98f29f3a8e3560fb0616" "q-123104/selection/0fbe558572ecce67593db00d22f0d8d9d09c98d019451cd13488790a441e6c9c" "q-123104/selection/695792c47319cb1ed098a6d83038b7ad6d032838f9103d693bf346f1dc234ff8" "q-123104/selection/5d34995cddd0166b343cae457ee45643c04c739e08758db1204c66c5ee04158e" "q-123104/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-123104" :question/id #uuid "945caca7-f42a-5f31-ae86-c966bd57d4f0" :question/math-academy-id "q-123104" :question/problem "Consider the following partitions:\n\n- ${P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}}$ is a partition of the interval $[-1,1]$\n\n- ${P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}}$ is a partition of the interval $[-1,1]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}10({y}_{j}+{y}_{j-1})Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" :question/worked-solution "Using the constant multiple and product rules, we can write the summation as\n\n$$\n10{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[-1,1].$ So, we have\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i}=1-(-1) & =2.\\end{aligned}\n$$\n\nFor the sum over $j,$ we evaluate it as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{x}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}\\,+\\,{y}_{0})({y}_{1}\\,-\\,{y}_{0})\\,+\\,({y}_{2}\\,+\\,{y}_{1})({y}_{2}\\,-\\,{y}_{1})\\,+\\,⋯\\,+\\,({y}_{n}\\,+\\,{y}_{n-1})({y}_{n}\\,-\\,{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={1}^{2}-(-1)^{2} \\\\  & =0\\end{aligned}\n$$\n\nCombining our results, we finally arrive at\n\n$$\n10{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.=10\\cdot 2\\cdot 0=0.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-123104/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5ee41f2-7116-52f4-b1f7-923997d994ab"] :knowledge-point/questions ["q-123104"] :db/ensure [:knowledge-point/validate]} {:db/id "q-149631/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" :answer/id #uuid "f48f8907-a564-5505-98fb-e78ea256bc03" :answer/type :answer.type/math :answer/value "24" :db/ensure [:answer/validate]} {:db/id "q-149631/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "8c082e81-1654-51dc-8778-8fcaafabc4a5" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-149631/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" :answer/id #uuid "5d1ab82b-7f8c-5159-97b9-958ad52a34d3" :answer/type :answer.type/math :answer/value "48" :db/ensure [:answer/validate]} {:db/id "q-149631/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "8bcdcdab-6a3d-51c9-b646-fc5e1dfb60e7" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-149631/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "d2d420d7-1509-52a8-8add-399fc7cfae7f" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-149631/selection" :answer-field/id #uuid "eb825214-367e-52a5-af2c-dd696103f49c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-149631/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-149631/selection/f345fac9a81ccd096b9959c6e7a966a446e93e73b82d111a376f9064132509fd" "q-149631/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-149631/selection/cee37ae0a2921bd3973a5cb0592c822dbbfafcfefba8d7007910ead797b9112f" "q-149631/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-149631/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-149631" :question/id #uuid "2158d2cd-7cd8-538d-82a4-737072fa1c54" :question/math-academy-id "q-149631" :question/problem "Consider the following partitions:\n\n- ${P}_{1}={{x}_{0},{x}_{1},…,{x}_{m}}$ is a partition of the interval $[3,5]$\n\n- ${P}_{2}={{y}_{0},{y}_{1},…,{y}_{n}}$ is a partition of the interval $[-1,2]$\n\nCalculate ${\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{x}_{i}Δ{y}_{j},$ where $Δ{x}_{i}={x}_{i}-{x}_{i-1}$ and $Δ{y}_{j}={y}_{j}-{y}_{j-1}.$" :question/worked-solution "Using the product rule, we can write the summation as\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[3,5].$ So, we have\n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}=5-3=2.\n$$\n\nFor the sum over $j,$ we evaluate it as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{x}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{x}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={2}^{2}-(-1)^{2} \\\\  & =3\\end{aligned}\n$$\n\nCombining our results, we finally arrive at \n\n$$\n{\\sum }_{i=1}^{m}Δ{x}_{i}\\cdot {\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}=2\\cdot 3=6.\n$$" 