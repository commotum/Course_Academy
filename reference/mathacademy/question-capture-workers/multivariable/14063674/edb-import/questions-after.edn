#{[{:db/id #edb/ref 17592186346437 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2253a318-f02f-50db-96d3-30c172a6e1bb" :answer/type {:db/ident :answer.type/math} :answer/value "(-\\infty ,-4)" :db/id #edb/ref 17592186346439} {:answer/id #uuid "e284197a-b514-5aea-a5f7-f0a53fe3e40c" :answer/type {:db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(2,4)$" :db/id #edb/ref 17592186346440} {:answer/id #uuid "81dc2f5e-0e87-51e0-9055-b0ae905a2c98" :answer/type {:db/ident :answer.type/text} :answer/value "$(-\\infty ,-4),$ $(-2,2),$ and $(4,\\infty )$" :db/id #edb/ref 17592186346441} {:answer/id #uuid "7f496681-b587-5a13-a6f3-2a4102065d79" :answer/type {:db/ident :answer.type/math} :answer/value "(4,\\infty )" :db/id #edb/ref 17592186346442} {:answer/id #uuid "c9d3e377-1a61-5e5c-98de-267800eef5f7" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,4)" :db/id #edb/ref 17592186346443}] :answer-field/correct {:answer/id #uuid "e284197a-b514-5aea-a5f7-f0a53fe3e40c" :answer/type {:db/ident :answer.type/text} :answer/value "$(-4,-2)$ and $(2,4)$" :db/id #edb/ref 17592186346440} :answer-field/id #uuid "c2c4c27b-802b-576d-a604-f7f8dd87a004" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346438}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "8d160f05-f6c3-5cab-b428-a1db0a9e077b" :question/math-academy-id "q-114061" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063674/assets/d3bd98f5662140655dd2bd33f99dc8704b1bd03b6004133dc8492ac51ea3a347.png)\n\nThe graph above shows $y={h}^{″}(x).$  Find the intervals on which the function $h(x)$ is concave down." :question/worked-solution "A function $h(x)$ is concave down over an interval $(a,b)$ if ${h}^{″}(x)<0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={h}^{″}(x),$ we can see that ${h}^{″}(x)<0$ on the intervals $(-4,-2)$ and $(2,4).$  Therefore, the function $h(x)$ is concave down on the intervals $(-4,-2)$ and $(2,4).$"}] [{:db/id #edb/ref 17592186346444 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e2c7b6b8-1095-5772-b8aa-6b571b8ba6d4" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186346446} {:answer/id #uuid "8c64dcb9-5002-5251-8bd5-055a5e23e4ea" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2,-1)$ and $(1,2)$" :db/id #edb/ref 17592186346447} {:answer/id #uuid "140b671d-75df-535b-819b-eeeb1e4a6998" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186346448} {:answer/id #uuid "d1969ae4-e225-54f6-ad32-1e7d2504ae08" :answer/type {:db/ident :answer.type/text} :answer/value "None" :db/id #edb/ref 17592186346449} {:answer/id #uuid "b79973a8-c61d-525f-93c4-21e97b5b7ab6" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,2)" :db/id #edb/ref 17592186346450}] :answer-field/correct {:answer/id #uuid "140b671d-75df-535b-819b-eeeb1e4a6998" :answer/type {:db/ident :answer.type/math} :answer/value "(-1,1)" :db/id #edb/ref 17592186346448} :answer-field/id #uuid "58c9bf5e-c365-5940-9048-56324041d229" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186346445}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c6fc0242-cf86-5ce2-ba38-34bc05e4e489" :question/math-academy-id "q-114259" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063674/assets/a7330541d6102141aec87f6733d09585553de672c5e55d2f84fe70196e4c6b5f.png)\n\nThe graph above shows $y={f}^{″}(x),$ where the function $f(x)$ is defined on $[-2,2].$ Find the intervals on which the function $f(x)$ is concave up." :question/worked-solution "A function $f(x)$ is concave up over an interval $(a,b)$ if ${f}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={f}^{″}(x),$ we can see that ${f}^{″}(x)>0$ on the interval $(-1,1).$ Therefore, the function $f(x)$ is concave up on the interval  $(-1,1)$ only."}] [{:db/id #edb/ref 17592186184542 :knowledge-point/_questions [{:knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8d735eb1-2a6a-5cdb-b060-5dc7dc3f01af" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186181745} {:answer/id #uuid "aad3ca4e-e7ea-5560-93e7-24cbc7c61b13" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186181746} {:answer/id #uuid "cc0d64d3-cb64-5740-939e-e173b20856b1" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186181747} {:answer/id #uuid "e20e94a0-0b8f-550e-b13d-198fa2a95d97" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186181748} {:answer/id #uuid "2a096741-4591-5cf6-adf1-c5a5df791306" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are true." :db/id #edb/ref 17592186181749}] :answer-field/correct {:answer/id #uuid "8d735eb1-2a6a-5cdb-b060-5dc7dc3f01af" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186181745} :answer-field/id #uuid "122e0de1-170e-51e3-bd79-88ec6c9ea593" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181744}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d75ab107-adf9-5afd-9401-bb2be46187e8" :question/math-academy-id "q-22703" :question/problem "Consider the function $f(x)={x}^{2}-2{e}^{x}.$ Which of the following statements are true?\n\n- $f(x)$ is concave up on $(-\\infty ,0)$\n- $f(x)$ is concave down on $(-\\infty ,0)$\n- $f(x)$ is concave down on $(0,\\infty )$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & =2x-2{e}^{x} \\\\ {f}^{″}(x) & =2-2{e}^{x}\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}2-2{e}^{x} & >0 \\\\ {e}^{x} & <1.\\end{aligned}\n$$\n\nWe can solve this inequality by considering the graph of $y={e}^{x}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063674/assets/c199b110a3d19ecc23454f52dc7470af318ce871805595fd5fe7609dee5b0545.png)\n\nFrom the graph, we see that ${e}^{x}<1$ when $x<0.$ So the graph is concave up on the interval $(-\\infty ,0).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality ${e}^{x}>1,$ which has the solution $(0,\\infty ).$\n\nTherefore, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186184547 :knowledge-point/_questions [{:knowledge-point/id #uuid "437c168a-6799-5d13-bd9b-031290a84da6" :knowledge-point/title "Finding the Intervals of Concavity of a Function"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc5ef8d9-4ab7-53e2-bc94-b0491122a312" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186181778} {:answer/id #uuid "eabc38ec-0d09-54e1-8b6a-863ea1c29590" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186181779} {:answer/id #uuid "1fc4483e-325f-531d-8278-64c27d36817c" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186181780} {:answer/id #uuid "1fdb6cd6-edf6-5109-950e-cdf0112c8198" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186181781} {:answer/id #uuid "6b355662-0bca-5db1-a1bf-516741b0b461" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements are correct" :db/id #edb/ref 17592186181782}] :answer-field/correct {:answer/id #uuid "bc5ef8d9-4ab7-53e2-bc94-b0491122a312" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186181778} :answer-field/id #uuid "f532ac11-933d-5e1f-bcf0-7d1a125ac724" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186181777}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "7adfc0dd-472e-52b3-a8a1-63de79ba74b4" :question/math-academy-id "q-22809" :question/problem "Consider the function $f(x)={e}^{x}\\operatorname{sin}⁡x,$ defined on $x\\in (0,\\pi ).$ Which of the following statements are true?\n\n- $f(x)$ is concave down on $(0,\\frac{\\pi }{2})$\n- $f(x)$ is concave up on $(\\frac{\\pi }{2},\\pi )$\n- $f(x)$ is concave down on $(\\frac{\\pi }{2},\\pi )$" :question/worked-solution "First, we calculate the second derivative of $f(x),$ as follows:\n\n$$\n\\begin{aligned}{f}^{′}(x) & ={e}^{x}\\operatorname{sin}⁡x+{e}^{x}\\operatorname{cos}⁡x={e}^{x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x) \\\\ {f}^{″}(x) & ={e}^{x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x)+{e}^{x}(\\operatorname{cos}⁡x-\\operatorname{sin}⁡x) \\\\  & ={e}^{x}(\\operatorname{sin}⁡x+\\operatorname{cos}⁡x+\\operatorname{cos}⁡x-\\operatorname{sin}⁡x) \\\\  & =2{e}^{x}\\operatorname{cos}⁡x.\\end{aligned}\n$$\n\nTo find where the function is concave up, we need to solve ${f}^{″}(x)>0:$\n\n$$\n\\begin{aligned}2{e}^{x}\\operatorname{cos}⁡x & >0 \\\\ \\operatorname{cos}⁡x & >0.\\end{aligned}\n$$\n\nWe can solve this inequality by considering the graph of $y=\\operatorname{cos}⁡x$ over the interval $(0,\\pi ).$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063674/assets/410e0af2ed20a065c27da5edaf0095dfd22c8a37a92e3d8fbaeece629cefa278.png)\n\nFrom the graph, we see that $\\operatorname{cos}⁡x>0$ when $0<x<\\frac{\\pi }{2}.$ So the graph is concave up on the interval $(0,\\frac{\\pi }{2}).$\n\nThe function $f(x)$ is concave down when ${f}^{″}(x)<0.$ By similar reasoning to before, this leads to the inequality $\\operatorname{cos}⁡x<0,$ which has the solution $(\\frac{\\pi }{2},\\pi ).$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186346451 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1b60735-9dae-5c23-991d-0241c208b1b7" :knowledge-point/title "Determining the Intervals of Concavity Given the Graph of the Second Derivative"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50c46685-68d7-5711-ad91-969cc9ecc2fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186346453}] :answer-field/correct {:answer/id #uuid "50c46685-68d7-5711-ad91-969cc9ecc2fc" :answer/type {:db/ident :answer.type/math} :answer/value "-\\infty" :db/id #edb/ref 17592186346453} :answer-field/id #uuid "ee393f89-5082-5275-b0e7-31835628e523" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346452} {:answer-field/choices [{:answer/id #uuid "2cf4ebdb-0183-5680-98b8-3b8fe01f1e70" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186346455}] :answer-field/correct {:answer/id #uuid "2cf4ebdb-0183-5680-98b8-3b8fe01f1e70" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186346455} :answer-field/id #uuid "fb4591cf-15d8-5adf-81ca-b6fca3593610" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346454} {:answer-field/choices [{:answer/id #uuid "a1bd6f2f-67a5-5bfb-ab67-9a1279a72e60" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346457}] :answer-field/correct {:answer/id #uuid "a1bd6f2f-67a5-5bfb-ab67-9a1279a72e60" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186346457} :answer-field/id #uuid "5010bd79-fdf6-59a1-8373-aeccc9f0398a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346456} {:answer-field/choices [{:answer/id #uuid "c71325f8-8309-58d1-970b-bf091d198c1a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186346459}] :answer-field/correct {:answer/id #uuid "c71325f8-8309-58d1-970b-bf091d198c1a" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186346459} :answer-field/id #uuid "2d8a7367-fa6d-565c-ab1d-b1e100a6bb24" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186346458}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "47567230-6e1c-5ccd-bbfb-9bdb7523ea72" :question/math-academy-id "q-344783" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063674/assets/345b36f79184e0857bfc63693b2be0a968ba308035af9548136c5b7ba692ab52.png)\n\nThe function $g(x)$ is defined on $(-\\infty ,\\infty ).$\nThe graph of the second derivative $y={g}^{″}(x)$ of the function $g(x)$ intersects the $x$-axis at the points $x=-5,$ $x=-1,$ $x=1,$ $x=4,$ and $x=6,$ as shown above. The intervals on which the function $g(x)$ is concave up are\n\n$(${{field-1}}$,-5),\\,(${{field-2}}$,$\n{{field-3}}$),\\,(${{field-4}}$,6).$" :question/worked-solution "A function $g(x)$ is concave up over an interval $(a,b)$ if ${g}^{″}(x)>0$ for all $x\\in (a,b).$\n\nOn the given graph of $y={g}^{″}(x)$, we can see that ${g}^{″}(x)>0$ on the intervals $(-\\infty ,-5),$ $(-1,1),$ and $(4,6).$ \n\nTherefore, the function $g(x)$ is concave up on the intervals \n\n$$\n(\\,-\\infty ,-5\\,),\\,(\\,-1,1\\,),\\,(\\,4,6\\,).\n$$"}]}
