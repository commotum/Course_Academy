wer-fields ["q-33451/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f53201a-0d75-5f17-b869-009c8e0523c7"] :knowledge-point/questions ["q-33451"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129094/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "2ca79318-c292-567b-b18d-294f042b379e" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-129094/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer/id #uuid "9e3905ae-e406-5602-8a76-21672e1b8986" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-129094/selection/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" :answer/id #uuid "c423bea4-eabc-5c5c-8335-12e04762c48a" :answer/type :answer.type/math :answer/value "\\frac{5}{3}" :db/ensure [:answer/validate]} {:db/id "q-129094/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "ce7dfdef-a6f6-53cf-91a1-51499188e0a5" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-129094/selection/0f2b67e75f4ae07a671ced24cf3c7fea54c88ff15b4f6589af4cc44177595f85" :answer/id #uuid "f2dfb090-8668-52ad-87bd-7b0c2cb7dc62" :answer/type :answer.type/math :answer/value "\\frac{9}{3}" :db/ensure [:answer/validate]} {:db/id "q-129094/selection" :answer-field/id #uuid "3cbf1f02-a404-5378-a26b-f2713a97b4a2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129094/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer-field/choices ["q-129094/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-129094/selection/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" "q-129094/selection/c43b27454cd69f1b6f4b793e211f4f4f6e40314b87f5b1c35a69172a60fcd818" "q-129094/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-129094/selection/0f2b67e75f4ae07a671ced24cf3c7fea54c88ff15b4f6589af4cc44177595f85"] :db/ensure [:answer-field/validate]} {:db/id "q-129094" :question/id #uuid "1ad8882e-4e17-5620-b084-21aafa42032d" :question/math-academy-id "q-129094" :question/problem "Find the shortest distance between the point $P(1,2,-3)$ and the plane $Π$ with equation $(r-[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}])\\cdot [\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}]=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(1,-2,1).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =[\\begin{aligned}1 \\\\ -2 \\\\ 1\\end{aligned}]-[\\begin{aligned}1 \\\\ 2 \\\\ -3\\end{aligned}]=[\\begin{aligned}0 \\\\ -4 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=[\\begin{aligned}-2 \\\\ 1 \\\\ 2\\end{aligned}].$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|0\\cdot (-2)+(-4)\\cdot 1+4\\cdot 2|}{\\sqrt{(-2)^{2}+{1}^{2}+{2}^{2}}} \\\\  & =\\frac{|-4+8|}{\\sqrt{4+1+4}} \\\\  & =\\frac{|4|}{\\sqrt{9}} \\\\  & =\\frac{4}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129094/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f53201a-0d75-5f17-b869-009c8e0523c7"] :knowledge-point/questions ["q-129094"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129119/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c8508785-7cce-5b15-a748-06f59d173d96" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129119/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "2875b1e3-3614-576a-98fe-8d853f1d9a86" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-129119/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "ae7982c3-8b00-5fc8-86c3-9aa66b34bb45" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-129119/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "197ef296-f4e1-510f-a17f-7a953b342003" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-129119/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "6d34557c-9668-573a-b832-0e087b548a78" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-129119/selection" :answer-field/id #uuid "575c10d3-5e8b-5ded-aacf-435058c1f6a4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129119/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-129119/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-129119/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-129119/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-129119/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-129119/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-129119" :question/id #uuid "b78702ba-d6e3-50bb-96e7-281310599418" :question/math-academy-id "q-129119" :question/problem "Given that $Q(1,-3,7)$ lies on the plane $Π:r\\cdot ⟨6,3,-2⟩=-17$, find the shortest distance from $P(2,-6,2)$ to $Π.$" :question/worked-solution "First, we find\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,-3,7⟩-⟨2,-6,2⟩ \\\\  & =⟨-1,3,5⟩.\\end{aligned}\n$$\n\nFrom the equation of the plane, we get the normal vector $n=⟨6,3,-2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot 6+3\\cdot 3+5\\cdot (-2)|}{\\sqrt{{6}^{2}+{3}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-6+9-10|}{\\sqrt{36+9+4}} \\\\  & =\\frac{|-7|}{\\sqrt{49}} \\\\  & =\\frac{7}{7} \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129119/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5a50c5f1-fbda-5c87-afa2-32495c69c18d"] :knowledge-point/questions ["q-129119"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80118/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "4370c4e8-8840-520c-96e0-4331576b55a6" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-80118/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "e558ecab-5f69-5424-95ee-e1dd4980e47a" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-80118/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "9c927585-21bd-5aa6-83d1-eba5edef5c3d" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-80118/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "7e08333a-8917-5b00-8b22-cb9bc9295244" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-80118/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "0f556574-f92e-55ca-8bea-9054417e807a" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-80118/selection" :answer-field/id #uuid "755bb3bd-a2cf-5132-b8cd-fdefe65fb60f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80118/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer-field/choices ["q-80118/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-80118/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-80118/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-80118/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-80118/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393"] :db/ensure [:answer-field/validate]} {:db/id "q-80118" :question/id #uuid "e0ef2c7b-5cf6-5fcb-8997-f9ad34a75174" :question/math-academy-id "q-80118" :question/problem "Find the shortest distance between the point $P(-7,5,2)$ and the plane $Π$ with equation $4x-8y+8z=-36.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}4x-8y+8z & =-36 \\\\ 4(-1)-8(1)+8z & =-36 \\\\ 8z & =-24 \\\\ z & =-3.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,1,-3)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,1,-3⟩-⟨-7,5,2⟩ \\\\  & =⟨6,-4,-5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨4,-8,8⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|6\\cdot 4+(-4)\\cdot (-8)+(-5)\\cdot 8|}{\\sqrt{{4}^{2}+(-8)^{2}+{8}^{2}}} \\\\  & =\\frac{|24+32-40|}{\\sqrt{16+64+64}} \\\\  & =\\frac{|\\,16\\,|}{\\sqrt{144}} \\\\  & =\\frac{4}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80118/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f"] :knowledge-point/questions ["q-80118"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129165/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "e3353ea6-2843-5a76-b5d4-764fe8c24aa9" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-129165/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "b0436aca-68e1-58a6-b776-41a3792590b2" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-129165/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "f1df2aa2-eb37-5616-97f6-4481d549c40d" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-129165/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c8a21add-654c-59af-a497-2c78f4bae05c" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-129165/selection/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a" :answer/id #uuid "9260b66a-78b7-50ba-b4cf-126db8f8f862" :answer/type :answer.type/math :answer/value "\\frac{4}{9}" :db/ensure [:answer/validate]} {:db/id "q-129165/selection" :answer-field/id #uuid "a0df5def-2690-59ba-8217-e030c44d7922" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129165/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer-field/choices ["q-129165/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-129165/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-129165/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-129165/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-129165/selection/9700accffa78065d8053126335d2ac4e2336d0d88c76df9e6a237030f752585a"] :db/ensure [:answer-field/validate]} {:db/id "q-129165" :question/id #uuid "64474450-57b0-5c05-b9ab-5a9f07006716" :question/math-academy-id "q-129165" :question/problem "Find the shortest distance between the point $P(-1,4,-5)$ and the plane $Π$ with equation $-2x+2y+z=6.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=1$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-2x+2y+z & =6 \\\\ -2(1)+2(1)+z & =6 \\\\ z & =6.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,1,6)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,1,6⟩-⟨-1,4,-5⟩ \\\\  & =⟨2,-3,11⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-2,2,1⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-2)+(-3)\\cdot 2+11\\cdot 1|}{\\sqrt{(-2)^{2}+{2}^{2}+{1}^{2}}} \\\\  & =\\frac{|-4-6+11|}{\\sqrt{4+4+1}} \\\\  & =\\frac{|1|}{\\sqrt{9}} \\\\  & =\\frac{1}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129165/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f"] :knowledge-point/questions ["q-129165"] :db/ensure [:knowledge-point/validate]} {:db/id "q-80123/selection/210215610152bc22dbe0958b830998dd4e50f2b6c40baf314cb7ba76c4d375cb" :answer/id #uuid "3a2d4d69-26e7-530d-a76b-d30a13e39d43" :answer/type :answer.type/math :answer/value "4\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-80123/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" :answer/id #uuid "9360ea04-76db-54eb-b194-f517cb548b16" :answer/type :answer.type/math :answer/value "\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-80123/selection/faad0727b2c62b6cced88abf9b210ea8763c2fd1c03c01c27346d66484992037" :answer/id #uuid "c546b4e3-152d-5562-8845-17b2fd19d627" :answer/type :answer.type/math :answer/value "2\\sqrt{6}" :db/ensure [:answer/validate]} {:db/id "q-80123/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "07bbc60f-8158-5f0a-a653-c579ea16a240" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-80123/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "738fe9d0-29e4-585e-96c3-a87a2ba470c8" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-80123/selection" :answer-field/id #uuid "57b99d77-9bee-5bb6-97d4-878cc0b372d9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-80123/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" :answer-field/choices ["q-80123/selection/210215610152bc22dbe0958b830998dd4e50f2b6c40baf314cb7ba76c4d375cb" "q-80123/selection/9f6bfd6fa85d96298a99db901d9b73f609ef64ac0bcf5fbdc4a7ac6d3b733558" "q-80123/selection/faad0727b2c62b6cced88abf9b210ea8763c2fd1c03c01c27346d66484992037" "q-80123/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-80123/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-80123" :question/id #uuid "e9001a16-7619-5368-a4e0-2e300550bbbb" :question/math-academy-id "q-80123" :question/problem "Find the shortest distance between the point $P(-4,-1,5)$ and the plane $Π$ with equation $-4x-2y+2z=16.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=-1$ and $y=2$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}-4x-2y+2z & =16 \\\\ -4(-1)-2(2)+2z & =16 \\\\ 2z & =16 \\\\ z & =8.\\end{aligned}\n$$\n\nSo, we get the point $Q(-1,2,8)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨-1,2,8⟩-⟨-4,-1,5⟩ \\\\  & =⟨3,3,3⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨-4,-2,2⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|3\\cdot (-4)+3\\cdot (-2)+3\\cdot 2|}{\\sqrt{(-4)^{2}+(-2)^{2}+{2}^{2}}} \\\\  & =\\frac{|-12-6+6|}{\\sqrt{16+4+4}} \\\\  & =\\frac{|\\,-12\\,|}{\\sqrt{24}} \\\\  & =\\sqrt{6}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-80123/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f"] :knowledge-point/questions ["q-80123"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129158/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "87aadc4b-2eef-5b06-9aa0-aef0ec8b3955" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-129158/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "05569caf-db27-5128-987f-36082784f425" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-129158/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "e8eaacf8-bb02-5974-8bbc-0c424a836d11" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-129158/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "09f05e42-531e-50ab-8024-b477c36efdc5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-129158/selection/28bc0c066aafe591b47c02f22cf5d773c865cdb0e1edda3fda3b6e0b8c384a5e" :answer/id #uuid "bebba3c6-ca59-5e2e-8a7c-51a59b84e7e4" :answer/type :answer.type/math :answer/value "\\frac{30}{7}" :db/ensure [:answer/validate]} {:db/id "q-129158/selection" :answer-field/id #uuid "975ae3ec-ee75-592b-af2a-76eb70da9777" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129158/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-129158/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-129158/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-129158/selection/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" "q-129158/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-129158/selection/28bc0c066aafe591b47c02f22cf5d773c865cdb0e1edda3fda3b6e0b8c384a5e"] :db/ensure [:answer-field/validate]} {:db/id "q-129158" :question/id #uuid "e3db73ba-3f2a-5efa-9740-ea27b4704163" :question/math-academy-id "q-129158" :question/problem "Find the shortest distance between the point $P(-1,3,-4)$ and the plane $Π$ with equation $6x+2y+3z=9.$" :question/worked-solution "Let's start by picking a point on the plane. To do that, we simply substitute some concrete values for $x$ and $y$ into the equation and solve for $z.$ Let's choose $x=1$ and $y=0$ (though it doesn't really matter what values we choose). Solving for $z,$ we get \n\n$$\n\\begin{aligned}6x+2y+3z & =9 \\\\ 6(1)+2(0)+3z & =9 \\\\ 3z & =3 \\\\ z & =1.\\end{aligned}\n$$\n\nSo, we get the point $Q(1,0,1)$ which lies on the plane.\n\nComputing $\\overset{\\to }{PQ},$ we get \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨1,0,1⟩-⟨-1,3,-4⟩ \\\\  & =⟨2,-3,5⟩.\\end{aligned}\n$$\n\nWe also need a normal vector to the plane. For any Cartesian equation of a plane $ax+by+cz=d,$ the normal vector is $n=⟨a,b,c⟩.$ So, for the plane $Π,$ we have $n=⟨6,2,3⟩.$ \n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot 6+(-3)\\cdot 2+5\\cdot 3|}{\\sqrt{{6}^{2}+{2}^{2}+{3}^{2}}} \\\\  & =\\frac{|12-6+15|}{\\sqrt{36+4+9}} \\\\  & =\\frac{|21|}{\\sqrt{49}} \\\\  & =\\frac{21}{7} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129158/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "489887a0-7013-5fb2-8f16-d18616196b0f"] :knowledge-point/questions ["q-129158"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-4949"] :question/problem "Find the shortest distance between the point $P(5,2,-2)$ and the plane $\\Pi$ with equation ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083796/assets/40ec5f2b2615eedf6b16420a2089b7c377141db46237de35218c5e685b629918.png)" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(4,8,2).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =[\\begin{aligned}4 \\\\ 8 \\\\ 2\\end{aligned}]-[\\begin{aligned}5 \\\\ 2 \\\\ -2\\end{aligned}]=[\\begin{aligned}-1 \\\\ 6 \\\\ 4\\end{aligned}].\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14083796/assets/0589ebbdb2c14b93e1296b9e1f8b0caa0c3df49bff4c9fbb97e4c18102844ec1.png)\n\nFinally, the shortest distance from the point $P$ to the plane $\\Pi$ is the absolute value of the scalar projection of $\\overrightarrow{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|(-1)\\cdot 2+6\\cdot 4+4\\cdot (-4)|}{\\sqrt{{2}^{2}+{4}^{2}+(-4)^{2}}} \\\\  & =\\frac{|-2+24-16|}{\\sqrt{4+16+16}} \\\\  & =\\frac{|\\,6\\,|}{\\sqrt{36}} \\\\  & =1\\end{aligned}\n$$" :db/ensure [:question/validate]}]
