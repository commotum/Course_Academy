[{:db/id "q-33467/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "cc2dba1e-8f98-58fe-823e-1230282e48a4" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-33467/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "30026039-efa5-5cdc-ba38-3a38b0e526e9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-33467/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "9547d3a4-9003-5f74-81ab-fbd584a90edc" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-33467/selection/5cfe33d704dbba0d7c6cb0e4c8b69c5862cecddd6652e8decd2b6e71b500b63d" :answer/id #uuid "b18e5a68-4f92-52a3-93d5-b1ba3ff1b96b" :answer/type :answer.type/math :answer/value "\\sqrt{30}" :db/ensure [:answer/validate]} {:db/id "q-33467/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776" :answer/id #uuid "d7e6097c-f2aa-50f4-9197-bcdaa731e9c1" :answer/type :answer.type/math :answer/value "36" :db/ensure [:answer/validate]} {:db/id "q-33467/selection" :answer-field/id #uuid "90d74317-b6b9-59b7-9f6b-a6807df4ac4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-33467/selection/5cfe33d704dbba0d7c6cb0e4c8b69c5862cecddd6652e8decd2b6e71b500b63d" :answer-field/choices ["q-33467/selection/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" "q-33467/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-33467/selection/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" "q-33467/selection/5cfe33d704dbba0d7c6cb0e4c8b69c5862cecddd6652e8decd2b6e71b500b63d" "q-33467/selection/713bb3b087b31554fba8b48520fba2f9d4d353e9b2d87f3d41c293daf48e1776"] :db/ensure [:answer-field/validate]} {:db/id "q-33467" :question/id #uuid "798f9001-1171-56bf-9055-27ac210d1a3a" :question/math-academy-id "q-33467" :question/problem "Find the shortest distance between the point $P(4,15,-5)$ and the plane $Π$ with equation $(r-[\\begin{aligned}6 \\\\ 9 \\\\ 2\\end{aligned}])\\cdot [\\begin{aligned}-5 \\\\ 1 \\\\ -2\\end{aligned}]=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,9,2).$ Then \n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =[\\begin{aligned}6 \\\\ 9 \\\\ 2\\end{aligned}]-[\\begin{aligned}4 \\\\ 15 \\\\ -5\\end{aligned}]=[\\begin{aligned}2 \\\\ -6 \\\\ 7\\end{aligned}].\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=[\\begin{aligned}-5 \\\\ 1 \\\\ -2\\end{aligned}].$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|2\\cdot (-5)+(-6)\\cdot 1+7\\cdot (-2)|}{\\sqrt{(-5)^{2}+{1}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-10-6-14|}{\\sqrt{25+1+4}} \\\\  & =\\frac{|-30|}{\\sqrt{30}} \\\\  & =\\sqrt{30}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-33467/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f53201a-0d75-5f17-b869-009c8e0523c7"] :knowledge-point/questions ["q-33467"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129098/selection/4ca7e04cb32d17c1971e27f96c827d785e809ee86fbe2e04813f39f29bdc8cde" :answer/id #uuid "802b8e11-2584-5155-a4cd-2ebfe252af39" :answer/type :answer.type/math :answer/value "\\frac{25}{3}" :db/ensure [:answer/validate]} {:db/id "q-129098/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "2f7c4579-cee8-5fb1-815b-20318945d169" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-129098/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "6e2ca9a1-fb24-5712-925c-5959e12d4c2e" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-129098/selection/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" :answer/id #uuid "b0c6e63e-b389-5e51-b321-fb6bce740b73" :answer/type :answer.type/math :answer/value "\\frac{32}{3}" :db/ensure [:answer/validate]} {:db/id "q-129098/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "4019b38c-aa2b-5ec7-a820-42d26bea3bde" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-129098/selection" :answer-field/id #uuid "e836f468-f33f-5437-852e-2bfa512d2628" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129098/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-129098/selection/4ca7e04cb32d17c1971e27f96c827d785e809ee86fbe2e04813f39f29bdc8cde" "q-129098/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-129098/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-129098/selection/5c0598f19f8324c341654ad8fd4df667dbb52f406431a30b6711906dc66d3ee4" "q-129098/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53"] :db/ensure [:answer-field/validate]} {:db/id "q-129098" :question/id #uuid "57b9ef22-fb1b-538b-ae87-f09c0b621f1b" :question/math-academy-id "q-129098" :question/problem "Find the shortest distance between the point $P(-4,3,-1)$ and the plane $Π$ with equation $(r-⟨6,-1,5⟩)\\cdot ⟨-1,2,-2⟩=0.$" :question/worked-solution "Let's pick a point on the plane, for instance, $Q(6,-1,5).$ Then\n\n$$\n\\begin{aligned}\\overset{\\to }{PQ} & =⟨6,-1,5⟩-⟨-4,3,-1⟩ \\\\  & =⟨10,-4,6⟩.\\end{aligned}\n$$\n\nAlso, from the equation of the plane, we get a normal vector $n=⟨-1,2,-2⟩.$\n\nFinally, the shortest distance from the point $P$ to the plane $Π$ is the absolute value of the scalar projection of $\\overset{\\to }{PQ}$ onto the normal vector of the plane:\n\n$$\n\\begin{aligned}d & =|{\\text{comp}}_{n}\\,\\overset{\\to }{PQ}| \\\\  & =\\frac{|\\overset{\\to }{PQ}\\cdot n|}{|n|} \\\\  & =\\frac{|10\\cdot (-1)+(-4)\\cdot 2+6\\cdot (-2)|}{\\sqrt{(-1)^{2}+{2}^{2}+(-2)^{2}}} \\\\  & =\\frac{|-10-8-12|}{\\sqrt{1+4+4}} \\\\  & =\\frac{|-30|}{\\sqrt{9}} \\\\  & =\\frac{30}{3} \\\\  & =10.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129098/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6f53201a-0d75-5f17-b869-009c8e0523c7"] :knowledge-point/questions ["q-129098"] :db/ensure [:knowledge-point/validate]} {:db/id "q-33451/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "0f57623c-c55f-52b0-913f-67767ee78be4" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-33451/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "ece26e44-69e8-5a2f-ad9a-379b10b8b18b" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-33451/selection/d18a8dda3b8d65edd15eaec58978ca4092dbb278a54eb8bcb12a2dd65a77d732" :answer/id #uuid "4fc77481-07aa-5231-a289-93d360d16b65" :answer/type :answer.type/math :answer/value "\\sqrt{14}" :db/ensure [:answer/validate]} {:db/id "q-33451/selection/68a9d915928be2121f128b27975f8275d2e80daa3ec1c4e296357b9d0a55829c" :answer/id #uuid "3540da61-087b-5611-9bb8-d617f70adcf8" :answer/type :answer.type/math :answer/value "2\\sqrt{14}" :db/ensure [:answer/validate]} {:db/id "q-33451/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "3b17e62d-3a9d-5f3b-9586-0711e6fe25ee" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-33451/selection" :answer-field/id #uuid "bec0dd06-964d-57df-