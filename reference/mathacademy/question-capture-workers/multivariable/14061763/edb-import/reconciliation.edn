2) \\\\  & =2.\\end{aligned}\n$$\n\nThus,\n\n$$\n{\\int }_{-6}^{-4}f(x)\\,\\text{d}x=-{A}_{1}=-2.\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-4,-3).$   The corresponding region is a triangle, so\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}(1\\cdot 1) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in [-3,0).$   The corresponding region is a rectangle, so\n\n$$\n\\begin{aligned}{A}_{3} & =bh \\\\  & =3\\cdot 2 \\\\  & =6.\\end{aligned}\n$$\n\n- The $4$th integral represents the signed area between the curve and the $x$-axis, where $x\\in [0,5].$   The corresponding region is a trapezoid, so\n\n$$\n\\begin{aligned}{A}_{4} & =\\frac{1}{2}(a+b)h \\\\  & =\\frac{1}{2}(3+1)(5) \\\\  & =10.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-6}^{5}f(x)\\,\\text{d}x & =-{A}_{1}+{A}_{2}+{A}_{3}+{A}_{4} \\\\  & =-2+\\frac{1}{2}+6+10 \\\\  & =\\frac{29}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-338507" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/activity-metadata.json" "file_sha256" "f4f9ae2fef4d2d305649f3bbb377183a4e9424b6502c4172923e2c9908131f3d"} {"question" "q-338507" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-338507" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{29}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-338511" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/assets/def5dbb4e5a338159e09c098e47e0b78cbe59d31bcd67478f4dbb7b1c85488f9.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n${\\int }_{-2}^{5}f(x)\\,\\text{d}x=$\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-338511" "field" nil "attribute" "question/worked-solution" "value" "The graph consists of $2$ parts: the arc of the quarter circle for $x\\in [-2,1)$ and the line segment for $x\\in [1,5].$ So, we can use the additive property of integrals to get\n\n$$\n\\begin{aligned}{\\int }_{-2}^{5}f(x)\\,\\text{d}x={{{\\int }_{-2}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{1}}+{{{\\int }_{1}^{5}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}.\\end{aligned}\n$$\n\n- The $1$st integral represents the signed area between the curve and the $x$-axis, where $x\\in [-2,1).$ The corresponding region is a quarter circle of radius $3,$ so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =\\frac{1}{4}\\pi {r}^{2} \\\\  & =\\frac{1}{4}\\pi \\cdot (3)^{2} \\\\  & =\\frac{9\\pi }{4}.\\end{aligned}\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,5].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}bh \\\\  & =\\frac{1}{2}2\\cdot 4 \\\\  & =4.\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-2}^{5}f(x)\\,\\text{d}x & ={A}_{1}+{A}_{2} \\\\  & =\\frac{9\\pi }{4}+4 \\\\  & =\\frac{9\\pi +16}{4}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-338511" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/activity-metadata.json" "file_sha256" "f4f9ae2fef4d2d305649f3bbb377183a4e9424b6502c4172923e2c9908131f3d"} {"question" "q-338511" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-338511" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9\\pi}{4}+4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-339679" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/assets/38270fdcb312cdce6a76e1d88bfa0117b4a69b5024b2acfd0456646471ead71f.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n${\\int }_{-6}^{5}f(x)\\,\\text{d}x=$\n{{field-1}}." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-339679" "field" nil "attribute" "question/worked-solution" "value" "The graph consists of $4$ parts: the arc of the quarter-circle for \n$x\\in [-6,-4),$ the line segment for $x\\in (-4,-1],$ the line segment for \n$x\\in (-1,1],$ and the arc of the quarter-circle for $x\\in [1,5].$ \nTherefore, we write\n\n$$\n{\\int }_{-6}^{5}f(x)\\,\\text{d}x={{{\\int }_{-6}^{-4}f(x)\\,\\text{d}x}_{⏟}}_{-{A}_{1}}+{{{\\int }_{-4}^{-1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{2}}+{{{\\int }_{-1}^{1}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{3}}+{{{\\int }_{1}^{5}f(x)\\,\\text{d}x}_{⏟}}_{{A}_{4}}.\n$$\n\n- The $1$st integral represents the signed area between the curve and the\n$x$-axis, where $x\\in [-6,-4).$ The corresponding region is a rectangle minus a quarter-circle of radius $2,$ so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{1} & =bh-\\frac{1}{4}\\pi {r}^{2} \\\\  & =(2)(2)-\\frac{1}{4}\\pi (2)^{2} \\\\  & =4-\\pi .\\end{aligned}\n$$\n\nSince the region lies below the $x$-axis,\n\n$$\n{\\int }_{-6}^{-4}f(x)\\,\\text{d}x=-{A}_{1}=\\pi -4.\n$$\n\n- The $2$nd integral represents the signed area between the curve and the $x$-axis, where $x\\in (-4,-1].$ The corresponding region is a right triangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{2} & =\\frac{1}{2}(bh) \\\\  & =\\frac{1}{2}3\\cdot 2 \\\\  & =3.\\end{aligned}\n$$\n\n- The $3$rd integral represents the signed area between the curve and the $x$-axis, where $x\\in (-1,1].$ The corresponding region is a trapezoid, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{3} & =\\frac{1}{2}(a+b)h \\\\  & =\\frac{1}{2}(3+1)\\cdot 2 \\\\  & =4.\\end{aligned}\n$$\n\n- The $4$th integral represents the signed area between the curve and the $x$-axis, where $x\\in [1,5].$ The corresponding region is a combination of a semi-circle of radius $2$ and a rectangle, so we find the area using the formula\n\n$$\n\\begin{aligned}{A}_{4} & =bh+\\frac{1}{2}\\pi {r}^{2} \\\\  & =1(4)+\\frac{1}{2}\\pi (2)^{2} \\\\  & =4+2\\pi .\\end{aligned}\n$$\n\nFinally, we obtain\n\n$$\n\\begin{aligned}{\\int }_{-6}^{5}f(x)\\,\\text{d}x & =-{A}_{1}+{A}_{2}+{A}_{3}+{A}_{4} \\\\  & =\\pi -4+3+4+4+2\\pi  \\\\  & =7+3\\pi .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-339679" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/activity-metadata.json" "file_sha256" "f4f9ae2fef4d2d305649f3bbb377183a4e9424b6502c4172923e2c9908131f3d"} {"question" "q-339679" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"} {"question" "q-339679" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3\\pi+7"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14061763/state.json" "file_sha256" "b2e41b0670671e37808621de6ff6a78dcb03e6db73c1b3be00c5c3977b270987"}] "usage" {"q-338507" [] "q-316261" []} "basis" 1980 "retractions" [[17592186293780 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14032967/assets/d36f2859865da58d226a738d8338f726df950db75b7421b604bb692c9049d54a.png)\n\nIf the graph of $y=f(x)$ is shown above, then\n\n${\\int }_{-4}^{1}f(x)\\,\\text{d}x=$\n{{field-1}}."] [17592186