\\begin{aligned}L(f,P) & ={\\sum }_{i=1}^{m}{\\sum }_{j=1}^{n}(11-3{x}_{i}-4{y}_{j})Δ{x}_{i}Δ{y}_{j}.\\end{aligned}\n$$\n\nSo, the missing expression is $11-3{x}_{i}-4{y}_{j}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-75323/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "bd33f89c-3adc-5b57-b7b7-4877a9e54e11"] :knowledge-point/questions ["q-75323"] :db/ensure [:knowledge-point/validate]} {:db/id "q-75324/selection/442596c993cd3158e9d7b6a2b320364bc51a2bbe4314e5b9a73ce40a15faf489" :answer/id #uuid "d60cbd82-3c58-5c4e-8651-42e0d89102e3" :answer/type :answer.type/math :answer/value "2{x}_{i-1}+7{y}_{j-1}" :db/ensure [:answer/validate]} {:db/id "q-75324/selection/cbefc48380312f5346cedcb3d94741513efba996a3ffbcc6863cdfb97d536773" :answer/id #uuid "65a1fab1-2d64-52b1-b3dd-ff569fb6b23b" :answer/type :answer.type/math :answer/value "3{x}_{i}+5{y}_{j}" :db/ensure [:answer/validate]} {:db/id "q-75324/selection/8b1f02c509b3f536cc19e693902898baf267f155ca0380975d388d6c62fe20e8" :answer/id #uuid "222c6dc4-3b12-52a2-9288-c2f67c8bef38" :answer/type :answer.type/math :answer/value "40-{x}_{i-1}-4{y}_{j}" :db/ensure [:answer/validate]} {:db/id "q-75324/selection/524112f7707c92e92c8ff03f754f9abcd0644d96ece51f5da8e9b5174880d695" :answer/id #uuid "5f6ab464-cf6e-5383-aba5-949ddde98d91" :answer/type :answer.type/math :answer/value "40-{x}_{i}-4{y}_{j}" :db/ensure [:answer/validate]} {:db/id "q-75324/selection/9b3c46f37ca5e485607587663d48a2de927f64d89b4c72f8c2b991dbfb2ae902" :answer/id #uuid "eecda82c-1fd3-527e-9008-4bc4aefbbc54" :answer/type :answer.type/math :answer/value "40-{x}_{i-1}-4{y}_{j-1}" :db/ensure [:answer/validate]} {:db/id "q-75324/selection" :answer-field/id #uuid "60af2383-1a56-56f5-a17f-71d78057ef6c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-75324/selection/524112f7707c92e92c8ff03f754f9abcd0644d96ece51f5da8e9b5174880d695" :answer-field/choices ["q-7532