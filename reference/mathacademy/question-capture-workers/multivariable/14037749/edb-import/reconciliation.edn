ariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114006" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-345634" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral:\n\n${\\int }_{0}^{0}{sin}^{2}⁡(\\sqrt{9-{x}^{2}})\\,\\text{d}x=$ \n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-345634" "field" nil "attribute" "question/worked-solution" "value" "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n{\\int }_{0}^{0}{sin}^{2}⁡(\\sqrt{9-{x}^{2}})\\,\\text{d}x=0\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-345634" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-345634" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-345634" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114016" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{3}^{1}f(x)\\,\\text{d}x=-6,$ calculate\n${\\int }_{1}^{3}(8-f(x))\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114016" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}f(x)\\,\\text{d}x=-{\\int }_{3}^{1}f(x)\\,\\text{d}x=6\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{1}^{3}(8-f(x))\\,\\text{d}x & =8{\\int }_{1}^{3}\\text{d}x-{\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & =8\\cdot x\\,{|}_{1}^{3}-6 \\\\  & =8(3-1)-6 \\\\  & =8\\cdot 2-6 \\\\  & =10.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114016" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-114016" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114016" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-12"] ["math" "-4"] ["math" "0"] ["math" "10"] ["math" "6"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114016" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346061" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{6}^{-6}\\,f(x)\\,\\text{d}x=1,$ calculate ${\\int }_{-6}^{6}(3x-9f(x))\\,\\text{d}x.$\n\n${\\int }_{-6}^{6}(3x-9f(x))\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346061" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{-6}^{6}\\,f(x)\\,\\text{d}x=-{\\int }_{6}^{-6}\\,f(x)\\,\\text{d}x=-1\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-6}^{6}(3x-9f(x))\\,\\text{d}x & =3{\\int }_{-6}^{6}x\\,\\text{d}x\\,-\\,9{\\int }_{-6}^{6}f(x)\\,\\text{d}x \\\\  & =3\\cdot \\frac{{x}^{2}}{2}\\,{|}_{-6}^{6}\\,-\\,9(-1) \\\\  & =3\\cdot \\frac{{6}^{2}-(-6)^{2}}{2}\\,+\\,9 \\\\  & =3\\cdot 0\\,+\\,9 \\\\  & =9.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346061" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-346061" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346061" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "9"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49245" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{9}^{4}\\,f(x)\\,\\text{d}x=6$, calculate\n${\\int }_{4}^{9}(4f(x)+2)\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49245" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{4}^{9}\\,f(x)\\,\\text{d}x=-{\\int }_{9}^{4}\\,f(x)\\,\\text{d}x=-6\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{4}^{9}(4f(x)+2)\\,\\text{d}x & =4{\\int }_{4}^{9}f(x)\\,\\text{d}x+2{\\int }_{4}^{9}\\,\\text{d}x \\\\  & =4(-6)+2\\cdot x\\,{|}_{4}^{9} \\\\  & =-24+2(9-4) \\\\  & =-24+10 \\\\  & =-14.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49245" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-49245" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49245" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-14"] ["math" "-19"] ["math" "-34"] ["math" "14"] ["math" "34"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49245" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-14"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346181" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{6}^{-3}\\,f(x)\\,\\text{d}x=\\frac{113}{9},$ calculate ${\\int }_{-3}^{6}(9f(x)+8x)\\,\\text{d}x.$\n\n${\\int }_{-3}^{6}(9f(x)+8x)\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346181" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{6}\\,f(x)\\,\\text{d}x=-{\\int }_{6}^{-3}\\,f(x)\\,\\text{d}x=-\\frac{113}{9}\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{6}(9f(x)+8x)\\,\\text{d}x & =9{\\int }_{-3}^{6}f(x)\\,\\text{d}x\\,+\\,8{\\int }_{-3}^{6}x\\,\\text{d}x \\\\  & =9(-\\frac{113}{9})\\,+\\,8\\cdot \\frac{{x}^{2}}{2}\\,{|}_{-3}^{6} \\\\  & =-113\\,+\\,8\\cdot \\frac{{6}^{2}-(-3)^{2}}{2} \\\\  & =-113\\,+\\,8\\cdot \\frac{27}{2} \\\\  & =-113\\,+\\,108 \\\\  & =-5.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346181" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-346181" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346181" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-5"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346059" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{0}^{-3}\\,f(x)\\,\\text{d}x=6,$ calculate ${\\int }_{-3}^{0}(5x-f(x))\\,\\text{d}x.$\n\n${\\int }_{-3}^{0}(5x-f(x))\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346059" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{-3}^{0}\\,f(x)\\,\\text{d}x=-{\\int }_{0}^{-3}\\,f(x)\\,\\text{d}x=-6\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{-3}^{0}(5x-f(x))\\,\\text{d}x & =5{\\int }_{-3}^{0}x\\,\\text{d}x\\,-\\,{\\int }_{-3}^{0}f(x)\\,\\text{d}x \\\\  & =5\\cdot \\frac{{x}^{2}}{2}\\,{|}_{-3}^{0}\\,-\\,(-6) \\\\  & =5\\cdot \\frac{0-9}{2}\\,+\\,6 \\\\  & =-\\frac{45}{2}\\,+\\,6 \\\\  & =-\\frac{33}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346059" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-346059" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346059" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{33}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49249" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{0}^{4}f(x)\\,\\text{d}x=-5$ and ${\\int }_{4}^{7}f(x)\\,\\text{d}x=8$ then what is ${\\int }_{0}^{7}(7+3f(x))\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49249" "field" nil "attribute" "question/worked-solution" "value" "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{0}^{4}f(x)\\,\\text{d}x+{\\int }_{4}^{7}f(x)\\,\\text{d}x={\\int }_{0}^{7}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}(-5)+8={\\int }_{0}^{7}f(x)\\,\\text{d}x \\\\ 3={\\int }_{0}^{7}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}(7+3f(x))\\,\\text{d}x & =7{\\int }_{0}^{7}\\,\\text{d}x+3{\\int }_{0}^{7}f(x)\\,\\text{d}x \\\\  & =7\\cdot x{|}_{0}^{7}+3(3) \\\\  & =7(7-0)+9 \\\\  & =58.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49249" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-49249" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49249" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "37"] ["math" "40"] ["math" "58"] ["math" "67"] ["math" "9"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-49249" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "58"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-73350" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{0}^{3}f(x)\\,\\text{d}x=5$ and ${\\int }_{3}^{6}f(x)\\,\\text{d}x=\\frac{1}{3}$ then what is ${\\int }_{0}^{6}(3f(x)+3)\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-73350" "field" nil "attribute" "question/worked-solution" "value" "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}f(x)\\,\\text{d}x+{\\int }_{3}^{6}f(x)\\,\\text{d}x={\\int }_{0}^{6}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}5+\\frac{1}{3}={\\int }_{0}^{6}f(x)\\,\\text{d}x \\\\ \\frac{16}{3}={\\int }_{0}^{6}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{6}(3f(x)+3)\\,\\text{d}x & =3{\\int }_{0}^{6}f(x)\\,\\text{d}x+3{\\int }_{0}^{6}\\,\\text{d}x \\\\  & =3(\\frac{16}{3})+3\\cdot x\\,{|}_{0}^{6} \\\\  & =16+3(6-0) \\\\  & =34.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-73350" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-73350" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-73350" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "20"] ["math" "23"] ["math" "30"] ["math" "33"] ["math" "34"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-73350" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "34"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346186" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{2}^{7}f(x)\\,\\text{d}x=3$ and ${\\int }_{7}^{11}f(x)\\,\\text{d}x=-10,$ \nthen what is ${\\int }_{2}^{11}(2-6f(x))\\,\\text{d}x?$\n\n${\\int }_{2}^{11}(2-6f(x))\\,\\text{d}x=$ \n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346186" "field" nil "attribute" "question/worked-solution" "value" "From the adjacent intervals rule, we know that\n\n$$\n{\\int }_{2}^{7}f(x)\\,\\text{d}x\\,+\\,{\\int }_{7}^{11}f(x)\\,\\text{d}x\\,=\\,{\\int }_{2}^{11}f(x)\\,\\text{d}x.\n$$\n\nPlugging in the known information gives\n\n$$\n3+(-10)\\,=\\,{\\int }_{2}^{11}f(x)\\,\\text{d}x\\,⇒\\,{\\int }_{2}^{11}f(x)\\,\\text{d}x=-7.\n$$\n\nFinally, compute the desired integral:\n\n$$\n\\begin{aligned}{\\int }_{2}^{11}(2-6f(x))\\,\\text{d}x & =2{\\int }_{2}^{11}1\\,\\text{d}x\\,-\\,6{\\int }_{2}^{11}f(x)\\,\\text{d}x \\\\  & =2\\cdot x{|}_{2}^{11}\\,-\\,6(-7) \\\\  & =2(11-2)+42 \\\\  & =18+42 \\\\  & =60\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346186" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-346186" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346186" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "60"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114138" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{-1}^{1}f(x)\\,\\text{d}x=2$ and ${\\int }_{1}^{3}f(x)\\,\\text{d}x=1,$ then what is ${\\int }_{-1}^{3}(2f(x)-3)\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114138" "field" nil "attribute" "question/worked-solution" "value" "From the adjacent intervals rule, we know that\n\n$$\n\\begin{aligned}{\\int }_{-1}^{1}f(x)\\,\\text{d}x+{\\int }_{1}^{3}f(x)\\,\\text{d}x={\\int }_{-1}^{3}f(x)\\,\\text{d}x.\\end{aligned}\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}2+1 & ={\\int }_{-1}^{3}f(x)\\,\\text{d}x \\\\ 3 & ={\\int }_{-1}^{3}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{3}(2f(x)-3)\\,\\text{d}x & =2{\\int }_{-1}^{3}f(x)\\,\\text{d}x-3{\\int }_{-1}^{3}\\text{d}x \\\\  & =2\\cdot 3-3\\cdot x\\,{|}_{-1}^{3} \\\\  & =2\\cdot 3-3(3-(-1)) \\\\  & =6-3(4) \\\\  & =-6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114138" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-114138" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114138" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-6"] ["math" "0"] ["math" "1"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114138" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-6"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346187" "field" nil "attribute" "question/problem" "value" "Given that ${\\int }_{4}^{6}f(x)\\,\\text{d}x=-1$ and ${\\int }_{6}^{10}f(x)\\,\\text{d}x=11,$ \nthen what is ${\\int }_{4}^{10}(6-3f(x))\\,\\text{d}x?$\n\n${\\int }_{4}^{10}(6-3f(x))\\,\\text{d}x=$ \n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346187" "field" nil "attribute" "question/worked-solution" "value" "From the adjacent intervals rule, we know that\n\n$$\n{\\int }_{4}^{6}f(x)\\,\\text{d}x+{\\int }_{6}^{10}f(x)\\,\\text{d}x={\\int }_{4}^{10}f(x)\\,\\text{d}x.\n$$\n\nPlugging in the known information gives\n\n$$\n(-1)+11={\\int }_{4}^{10}f(x)\\,\\text{d}x\\,⇒\\,{\\int }_{4}^{10}f(x)\\,\\text{d}x=10.\n$$\n\nFinally, compute the desired integral:\n\n$$\n\\begin{aligned}{\\int }_{4}^{10}(6-3f(x))\\,\\text{d}x & =6{\\int }_{4}^{10}1\\,\\text{d}x-3{\\int }_{4}^{10}f(x)\\,\\text{d}x \\\\  & =6\\cdot x{|}_{4}^{10}-3(10) \\\\  & =6(10-4)-30 \\\\  & =36-30 \\\\  & =6\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346187" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-346187" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-346187" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4789" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x)$ is a  function such that ${\\int }_{2}^{6}f(x)\\,\\text{d}x=9$ and ${\\int }_{9}^{6}4\\,f(x)\\,\\text{d}x=20.$ What is the value of ${\\int }_{2}^{9}f(x)\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4789" "field" nil "attribute" "question/worked-solution" "value" "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{9}^{6}4\\,f(x)\\,\\text{d}x & =20 \\\\ 4{\\int }_{9}^{6}\\,f(x)\\,\\text{d}x & =20 \\\\ -4{\\int }_{6}^{9}f(x)\\,\\text{d}x & =20 \\\\ {\\int }_{6}^{9}f(x)\\,\\text{d}x & =-5\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{2}^{9}f(x)\\,\\text{d}x & ={\\int }_{2}^{6}f(x)\\,\\text{d}x+{\\int }_{6}^{9}f(x)\\,\\text{d}x \\\\  & =9+(-5) \\\\  & =4.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4789" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-4789" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4789" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-14"] ["math" "-4"] ["math" "14"] ["math" "15"] ["math" "4"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4789" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114143" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x)$ is a function such that ${\\int }_{8}^{5}3f(x)\\,\\text{d}x=-2$ and ${\\int }_{3}^{5}f(x)\\,\\text{d}x=-3.$ What is the value of ${\\int }_{3}^{8}f(x)\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114143" "field" nil "attribute" "question/worked-solution" "value" "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{8}^{5}3f(x)\\,\\text{d}x & =-2 \\\\ 3{\\int }_{8}^{5}f(x)\\,\\text{d}x & =-2 \\\\ -3{\\int }_{5}^{8}f(x)\\,\\text{d}x & =-2 \\\\ {\\int }_{5}^{8}f(x)\\,\\text{d}x & =\\frac{2}{3}\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{3}^{8}f(x)\\,\\text{d}x & ={\\int }_{3}^{5}f(x)\\,\\text{d}x+{\\int }_{5}^{8}f(x)\\,\\text{d}x \\\\  & =-3+\\frac{2}{3} \\\\  & =-\\frac{7}{3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114143" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-114143" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114143" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2"] ["math" "-\\frac{11}{3}"] ["math" "-\\frac{7}{3}"] ["math" "3"] ["math" "\\frac{2}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114143" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{7}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4795" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x)$ is a  function such that ${\\int }_{2}^{7}f(x)\\,\\text{d}x=8$ and ${\\int }_{2}^{0}2f(x)\\,\\text{d}x=4.$ What is the value of ${\\int }_{0}^{7}f(x)\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4795" "field" nil "attribute" "question/worked-solution" "value" "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{2}^{0}2f(x)\\,\\text{d}x & =4 \\\\ 2{\\int }_{2}^{0}f(x)\\,\\text{d}x & =4 \\\\ -2{\\int }_{0}^{2}f(x)\\,\\text{d}x & =4 \\\\ {\\int }_{0}^{2}f(x)\\,\\text{d}x & =-2\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}f(x)\\,\\text{d}x & ={\\int }_{0}^{2}f(x)\\,\\text{d}x+{\\int }_{2}^{7}f(x)\\,\\text{d}x \\\\  & =(-2)+8 \\\\  & =6.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4795" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-4795" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4795" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "10"] ["math" "12"] ["math" "14"] ["math" "6"] ["math" "7"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4795" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "6"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4726" "field" nil "attribute" "question/problem" "value" "Let $f$ and $g$ be continuous functions such that ${\\int }_{0}^{7}f(x)\\,\\text{d}x=18,{\\int }_{0}^{7}\\frac{1}{2}g(x)\\,\\text{d}x=5,$ and ${\\int }_{3}^{7}(f(x)-g(x))\\text{d}x=4.$ What is the value of ${\\int }_{0}^{3}(f(x)-g(x))\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4726" "field" nil "attribute" "question/worked-solution" "value" "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}\\frac{1}{2}\\,g(x)\\,\\text{d}x & =5 \\\\ \\frac{1}{2}{\\int }_{0}^{7}g(x)\\,\\text{d}x & =5 \\\\ {\\int }_{0}^{7}g(x)\\,\\text{d}x & =10\\end{aligned}\n$$\n\nThen, using the adjacent intervals rule and substituting the known values, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}(f(x)-g(x))\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+{\\int }_{3}^{7}(f(x)-g(x))\\text{d}x \\\\ {\\int }_{0}^{7}(f(x)-g(x))\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4.\\end{aligned}\n$$\n\nFinally, by applying the sum rule for definite integrals and substituting the known values, we have\n\n$$\n\\begin{aligned}{\\int }_{0}^{7}(f(x)-g(x))\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4 \\\\ {\\int }_{0}^{7}f(x)\\,\\text{d}x-{\\int }_{0}^{7}g(x)\\,\\text{d}x & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4 \\\\ 18-10 & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x+4 \\\\ 4 & ={\\int }_{0}^{3}(f(x)-g(x))\\text{d}x\\end{aligned}\n$$\n\nTherefore, ${\\int }_{0}^{3}(f(x)-g(x))\\text{d}x=4.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4726" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-4726" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4726" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "13"] ["math" "4"] ["math" "6"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-4726" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114153" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x)$ is a function such that ${\\int }_{4}^{1}\\frac{1}{3}f(x)\\,\\text{d}x=2$ and ${\\int }_{-1}^{1}f(x)\\,\\text{d}x=6.$ What is the value of ${\\int }_{-1}^{4}f(x)\\,\\text{d}x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114153" "field" nil "attribute" "question/worked-solution" "value" "Let's simplify one of the given integrals:\n\n$$\n\\begin{aligned}{\\int }_{4}^{1}\\frac{1}{3}f(x)\\,\\text{d}x & =2 \\\\ \\frac{1}{3}{\\int }_{4}^{1}f(x)\\,\\text{d}x & =2 \\\\ -\\frac{1}{3}{\\int }_{1}^{4}f(x)\\,\\text{d}x & =2 \\\\ {\\int }_{1}^{4}f(x)\\,\\text{d}x & =-6\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{4}f(x)\\,\\text{d}x & ={\\int }_{-1}^{1}f(x)\\,\\text{d}x+{\\int }_{1}^{4}f(x)\\,\\text{d}x \\\\  & =6+(-6) \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114153" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/activity-metadata.json" "file_sha256" "b5d0ec2c5848b8f24d1396021f59046d97eba12d3520c179fc90f3c2667188de"} {"question" "q-114153" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114153" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-12"] ["math" "-2"] ["math" "0"] ["math" "4"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "q-114153" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/state.json" "file_sha256" "4a35fd9077a62b43505b720078d620624a4e59378fb8b622070efd90aec5f778"} {"question" "e-418" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\int_\\pi^\\pi \\sqrt{\\sin x}\\,\\textrm d x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-418.json" "file_sha256" "097303f235af4dfbf5940399479498782725edcfe25362e03a335263c8046964"} {"question" "e-418" "field" nil "attribute" "question/worked-solution" "value" "Notice that the lower and upper limits are the same. So, the integral evaluates to zero:\n\n$$\n\\int_\\pi^\\pi \\sqrt{\\sin x}\\,\\textrm d x = 0\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-418.json" "file_sha256" "097303f235af4dfbf5940399479498782725edcfe25362e03a335263c8046964"} {"question" "e-419" "field" nil "attribute" "question/problem" "value" "Given that ${\\displaystyle \\int_{0}^{6} \\, f(x) \\; \\textrm d x = -54 },$ what is the value of\n${\\displaystyle \\int_{6}^{0} \\bigg( \\dfrac 1 3 f(x) + 1 \\bigg) \\; \\textrm d x }?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-419.json" "file_sha256" "fe168f882e5a059aa3206f5829677a51982f686e27d37d3d40c67f24d763e637"} {"question" "e-419" "field" nil "attribute" "question/worked-solution" "value" "Let's reverse the limits of integration on the known result:\n\n$$\n\\begin{aligned}{\\int }_{6}^{0}\\,f(x)\\,\\text{d}x=-{\\int }_{0}^{6}\\,f(x)\\,\\text{d}x=54\\end{aligned}\n$$\n\nNow, we can split up the given integral using the sum rule and factor out the constants. We get\n\n$$\n\\begin{aligned}{\\int }_{6}^{0}(\\frac{1}{3}f(x)+1)\\,\\text{d}x & =\\frac{1}{3}{\\int }_{6}^{0}f(x)\\,\\text{d}x+{\\int }_{6}^{0}1\\,\\text{d}x \\\\  & =\\frac{1}{3}\\cdot 54+x\\,{|}_{6}^{0} \\\\  & =18+(0-6) \\\\  & =12.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-419.json" "file_sha256" "fe168f882e5a059aa3206f5829677a51982f686e27d37d3d40c67f24d763e637"} {"question" "e-420" "field" nil "attribute" "question/problem" "value" "If $\\displaystyle \\int_7^{10}f(x)\\,\\textrm d x = 18$ and $\\displaystyle \\int_0^{7}f(x)\\,\\textrm d x = -6$ then what is $\\displaystyle \\int_0^{10} \\big( 2f(x)+1 \\big) \\,\\textrm d x?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-420.json" "file_sha256" "aff1d27d896ae722ca35f75eac66fb135da04324c16c564bda461b495f9b7e97"} {"question" "e-420" "field" nil "attribute" "question/worked-solution" "value" "From the adjacent intervals rule, we know that\n\n$$\n\\int_0^{7}f(x)\\,\\textrm d x + \\displaystyle \\int_7^{10}f(x)\\,\\textrm d x = \\displaystyle \\int_0^{10}f(x)\\,\\textrm d x.\n$$\n\nPlugging in the known information into the above gives the following:\n\n$$\n\\begin{aligned}-6+18={\\int }_{0}^{10}f(x)\\,\\text{d}x \\\\ 12={\\int }_{0}^{10}f(x)\\,\\text{d}x\\end{aligned}\n$$\n\nFinally, we compute the desired integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{10}(2f(x)+1)\\,\\text{d}x & =2{\\int }_{0}^{10}f(x)\\,\\text{d}x+{\\int }_{0}^{10}\\text{d}x \\\\  & =2(12)+x\\,{|}_{0}^{10} \\\\  & =24+(10-0) \\\\  & =34.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-420.json" "file_sha256" "aff1d27d896ae722ca35f75eac66fb135da04324c16c564bda461b495f9b7e97"} {"question" "e-421" "field" nil "attribute" "question/problem" "value" "Suppose that $f(x)$ is a  function such that ${\\displaystyle \\int_4^1 2 \\, f(x) \\, \\textrm dx = -1}$ \nand ${\\displaystyle \\int_{1}^{-1} f(x) \\, \\textrm dx = 2}.$  What is the value of ${\\displaystyle \\int_{-1}^4 f(x) \\, \\textrm dx}?$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-421.json" "file_sha256" "cf98b0a8b5b4b5181da2ccb5ba6bec4aa73b1a2327794f9664a5e0603683945f"} {"question" "e-421" "field" nil "attribute" "question/worked-solution" "value" "Let's simplify the first given integral:\n\n$$\n\\begin{aligned}{\\int }_{4}^{1}2\\,f(x)\\,\\text{d}x & =-1 \\\\ 2{\\int }_{4}^{1}\\,f(x)\\,\\text{d}x & =-1 \\\\ -2{\\int }_{1}^{4}\\,f(x)\\,\\text{d}x & =-1 \\\\ {\\int }_{1}^{4}\\,f(x)\\,\\text{d}x & =\\frac{1}{2}.\\end{aligned}\n$$\n\nThe second integral can be rewritten as follows:\n\n$$\n\\begin{aligned}{\\int }_{1}^{-1}f(x)\\,\\text{d}x & =2 \\\\ -{\\int }_{-1}^{1}f(x)\\,\\text{d}x & =2 \\\\ {\\int }_{-1}^{1}f(x)\\,\\text{d}x & =-2.\\end{aligned}\n$$\n\nThen, from the adjacent intervals rule, we get\n\n$$\n\\begin{aligned}{\\int }_{-1}^{4}f(x)\\,\\text{d}x & ={\\int }_{-1}^{1}f(x)\\,\\text{d}x+{\\int }_{1}^{4}f(x)\\,\\text{d}x \\\\  & =-2+\\frac{1}{2} \\\\  & =-\\frac{3}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14037749/example-421.json" "file_sha256" "cf98b0a8b5b4b5181da2ccb5ba6bec4aa73b1a2327794f9664a5e0603683945f"}] "usage" {"q-114143" [] "e-419" [] "q-49245" [] "q-114006" [] "e-418" [] "e-420" [] "e-421" [] "q-49240" []} "basis" 1292 "retractions" [[17592186078950 :question/problem "Calculate $∫_{π/8}^{π/8}\\sin^{3} (\\tan 2x)dx$."] [17592186078952 :question/problem "Given that $∫_{9}^{4}f(x)dx = 6$, calculate\n\n$∫_{4}^{9}(4f(x) + 2)dx$."]] "immutable_answers" [17592186076912 17592186076913 17592186076914 17592186076915 17592186076916 17592186076924 17592186076925 17592186076926 17592186076927 17592186076928 17592186287176 17592186287177 17592186287178 17592186287179 17592186287180 17592186287225 17592186287226 17592186287227 17592186287228 17592186287229] "immutable_fields" [[17592186076911 :answer-field/correct] [17592186076911 :answer-field/id] [17592186076911 :answer-field/key] [17592186076911 :answer-field/type] [17592186076923 :answer-field/correct] [17592186076923 :answer-field/id] [17592186076923 :answer-field/key] [17592186076923 :answer-field/type] [17592186287175 :answer-field/correct] [17592186287175 :answer-field/id] [17592186287175 :answer-field/key] [17592186287175 :answer-field/type] [17592186287224 :answer-field/correct] [17592186287224 :answer-field/id] [17592186287224 :answer-field/key] [17592186287224 :answer-field/type]] "no_history" []}
