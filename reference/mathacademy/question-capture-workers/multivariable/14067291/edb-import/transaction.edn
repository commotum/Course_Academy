[{:db/id "q-37683/selection/330eb0b589da5e117b65434433fc9b27dd194d66ebc1ac2885f9407ae4c4b046" :answer/id #uuid "5543ef31-dcfe-55a5-b8a8-7f23167b449f" :answer/type :answer.type/math :answer/value "\\frac{11}{12}" :db/ensure [:answer/validate]} {:db/id "q-37683/selection/53a62adc469f7106cfcc253972af70d0b351ee4c505c92859749c553ee85bd38" :answer/id #uuid "0bc036ed-9155-546c-94b7-f82b9bc76f3b" :answer/type :answer.type/math :answer/value "\\frac{11}{6}" :db/ensure [:answer/validate]} {:db/id "q-37683/selection/e4feab3a7179f2a87633c6e7922d72261df298535ed5bf9932c62a0940c0196c" :answer/id #uuid "9e227874-43d6-577f-a15e-ffd10970d5c4" :answer/type :answer.type/math :answer/value "-\\frac{11}{4}" :db/ensure [:answer/validate]} {:db/id "q-37683/selection/f2f2ee0e94d8b392fe39bf132f8fa8c2e44772dc282fe392e906c1c44c4a8dbb" :answer/id #uuid "f5da3ce4-be8d-5bc0-9194-6ec9b2ac4f15" :answer/type :answer.type/math :answer/value "\\frac{6}{11}" :db/ensure [:answer/validate]} {:db/id "q-37683/selection/f970eb8ec27fdc5900e30e845078b193214292590cdbe978abcd839cb430872c" :answer/id #uuid "4cdf106d-f431-53b9-a023-ce338c1c7135" :answer/type :answer.type/math :answer/value "-\\frac{3}{11}" :db/ensure [:answer/validate]} {:db/id "q-37683/selection" :answer-field/id #uuid "e6f5c200-2c7a-555e-ace9-8f508595cf05" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37683/selection/330eb0b589da5e117b65434433fc9b27dd194d66ebc1ac2885f9407ae4c4b046" :answer-field/choices ["q-37683/selection/330eb0b589da5e117b65434433fc9b27dd194d66ebc1ac2885f9407ae4c4b046" "q-37683/selection/53a62adc469f7106cfcc253972af70d0b351ee4c505c92859749c553ee85bd38" "q-37683/selection/e4feab3a7179f2a87633c6e7922d72261df298535ed5bf9932c62a0940c0196c" "q-37683/selection/f2f2ee0e94d8b392fe39bf132f8fa8c2e44772dc282fe392e906c1c44c4a8dbb" "q-37683/selection/f970eb8ec27fdc5900e30e845078b193214292590cdbe978abcd839cb430872c"] :db/ensure [:answer-field/validate]} {:db/id "q-37683" :question/id #uuid "3630c4f5-1f80-56c5-89c5-e4637aed4fd4" :question/math-academy-id "q-37683" :question/problem "Calculate ${\\int }_{1/2}^{1}{\\int }_{x}^{1/x}\\frac{y}{{x}^{2}}\\,dy\\,dx.$" :question/worked-solution "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{1}{\\int }_{x}^{1/x}\\frac{y}{{x}^{2}}\\,dy\\,dx & ={\\int }_{1/2}^{1}\\frac{1}{{x}^{2}}[{\\int }_{x}^{1/x}y\\,dy]dx \\\\  & ={\\int }_{1/2}^{1}\\frac{1}{{x}^{2}}{[\\frac{{y}^{2}}{2}]}_{x}^{1/x}dx \\\\  & ={\\int }_{1/2}^{1}\\frac{1}{2{x}^{2}}(\\frac{1}{{x}^{2}}-{x}^{2})dx \\\\  & =\\frac{1}{2}{\\int }_{1/2}^{1}(\\frac{1}{{x}^{4}}-1)\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{1/2}^{1}(\\frac{1}{{x}^{4}}-1)\\,dx & =\\frac{1}{2}{[-\\frac{1}{3{x}^{3}}-x]}_{1/2}^{1} \\\\  & =-\\frac{1}{2}[\\frac{1}{3}+1-(\\frac{8}{3}+\\frac{1}{2})] \\\\  & =-\\frac{1}{2}(-\\frac{11}{6}) \\\\  & =\\frac{11}{12}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-37683/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a28c4320-e2dd-5195-81ac-b910c2328691"] :knowledge-point/questions ["q-37683"] :db/ensure [:knowledge-point/validate]} {:db/id "q-37865/selection/286a23b4f88ab5c5f58674d94dd3996a24158cd522f456ca4f7fa96ef4dc831e" :answer/id #uuid "97187c1b-4fdb-52bb-ae26-c9ba925d0b7f" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡(2)" :db/ensure [:answer/validate]} {:db/id "q-37865/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "8a1d76eb-0e11-5b85-aa7c-f80308bc113b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-37865/selection/df5f86fe94e259c93164581459ce79edca3b2fc6c4e3eecbe68141953c14289f" :answer/id #uuid "b706b36c-5a51-5e2a-ac59-a839878bb4ab" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡(2)+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-37865/selection/365b7f1b32a4beeff2b856b354211824ba15df19d7c300db795c10d6a754bd5a" :answer/id #uuid "291b2acb-cfc4-59da-a935-030002db3eab" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡(2)-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-37865/selection/a131d6546a01e0c2f3e0f65d5837e8cf2c5d8855fe842282228f5bfa2d8ad428" :answer/id #uuid "6515893c-d11a-5f45-9a7d-5e2ff1d7a773" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}+\\operatorname{ln}⁡(2)" :db/ensure [:answer/validate]} {:db/id "q-37865/selection" :answer-field/id #uuid "30936431-098b-5922-9211-7dfc9d49666f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-37865/selection/a131d6546a01e0c2f3e0f65d5837e8cf2c5d8855fe842282228f5bfa2d8ad428" :answer-field/choices ["q-37865/selection/286a23b4f88ab5c5f58674d94dd3996a24158cd522f456ca4f7fa96ef4dc831e" "q-37865/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-37865/selection/df5f86fe94e259c93164581459ce79edca3b2fc6c4e3eecbe68141953c14289f" "q-37865/selection/365b7f1b32a4beeff2b856b354211824ba15df19d7c300db795c10d6a754bd5a" "q-37865/selection/a131d6546a01e0c2f3e0f65d5837e8cf2c5d8855fe842282228f5bfa2d8ad428"] :db/ensure [:answer-field/validate]} {:db/id "q-37865" :question/id #uuid "4bff3979-2b39-5332-9bb6-24c5c18decd8" :question/math-academy-id "q-37865" :question/problem "Evaluate the double integral\n${∬}_{D}\\frac{1}{(1+x+y)^{2}}\\,dA,$\nwhere $D$ is the finite region enclosed by the line\n$y=1-x$ and the coordinate axes." :question/worked-solution "Let's make a sketch of our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/95ebd0a4eb874972b459e53eecf1d57650f63284698fcad967c09620ac01cd99.png)\n\nNotice that $D$ is a type I region.\n\n- The line $y=1-x$ intercepts the $x$-axis at $x=1.$\nSo, the $x$-limits are \n$0\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/d048f20f2299722cee598cc1005237627ecdd7643e996b269f26b5a096f01f2f.png)\n\nAs a result, the integral is defined over the following type I region: \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1-x}\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}\\frac{1}{(1+x+y)^{2}}\\,dA={\\int }_{0}^{1}{\\int }_{0}^{1-x}\\frac{1}{(1+x+y)^{2}}\\,dy\\,dx\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1-x}\\frac{1}{(1+x+y)^{2}}\\,dy\\,dx & ={\\int }_{0}^{1}[{\\int }_{0}^{-x+1}\\frac{1}{(1+x+y)^{2}}\\,dy]\\,dx \\\\  & ={\\int }_{0}^{1}{[-\\frac{1}{1+x+y}]}_{0}^{-x+1}\\,dx \\\\  & ={\\int }_{0}^{1}(-\\frac{1}{1+x+(1-x)}-(-\\frac{1}{1+x+0}))\\,dx \\\\  & ={\\int }_{0}^{1}(-\\frac{1}{2}+\\frac{1}{1+x})dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(-\\frac{1}{2}+\\frac{1}{1+x})dx & ={[-\\frac{1}{2}x+\\operatorname{ln}⁡(1+x)]}_{0}^{1} \\\\  & =-\\frac{1}{2}+\\operatorname{ln}⁡(2)-(0+\\operatorname{ln}⁡(1)) \\\\  & =-\\frac{1}{2}+\\operatorname{ln}⁡(2)\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-37865/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "69f6b2a7-7a3a-5c2c-90db-5aa321784048"] :knowledge-point/questions ["q-37865"] :db/ensure [:knowledge-point/validate]} {:db/id "q-40747/selection/1a03926f6ae64b58793615a754335b02b7a0aa6f3e719bfb4cf52f8fe076177d" :answer/id #uuid "4e2413d2-9ed5-5ebc-9751-3b7e7a13602c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" :db/ensure [:answer/validate]} {:db/id "q-40747/selection/42656d20811bc65b1c3b278490f6190f9d0c8a8ac03906a3098d2ae8d544393a" :answer/id #uuid "6c5ebaa1-79cb-58bf-a53b-1e3d6362a18d" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{2x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" :db/ensure [:answer/validate]} {:db/id "q-40747/selection/668ba9e51655522ee04b3f1ddf689206e01f494b8711fd2b8b6fbba602f984dc" :answer/id #uuid "eaf1b0ac-c3c9-5844-b262-6b5ba8f3d5a6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{-2x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" :db/ensure [:answer/validate]} {:db/id "q-40747/selection/b662e5a0f24763060c05444c62849ba35601a9523836e7d4de580fd40e195829" :answer/id #uuid "72de0563-0ef0-5c1b-8353-f350474c7871" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{x/2}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" :db/ensure [:answer/validate]} {:db/id "q-40747/selection/02f87ec8a2e835255b1983697bb4139ef5f02b27c1a91a1d5c7b79e70576854a" :answer/id #uuid "658c3a22-9fde-53bb-876c-4f996b3c123c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{4}^{2x}{y}^{2}\\sqrt{x}\\,dy\\,dx" :db/ensure [:answer/validate]} {:db/id "q-40747/selection" :answer-field/id #uuid "c3c4a7a2-8c4a-5d47-82d3-57cf2fe097cf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-40747/selection/42656d20811bc65b1c3b278490f6190f9d0c8a8ac03906a3098d2ae8d544393a" :answer-field/choices ["q-40747/selection/1a03926f6ae64b58793615a754335b02b7a0aa6f3e719bfb4cf52f8fe076177d" "q-40747/selection/42656d20811bc65b1c3b278490f6190f9d0c8a8ac03906a3098d2ae8d544393a" "q-40747/selection/668ba9e51655522ee04b3f1ddf689206e01f494b8711fd2b8b6fbba602f984dc" "q-40747/selection/b662e5a0f24763060c05444c62849ba35601a9523836e7d4de580fd40e195829" "q-40747/selection/02f87ec8a2e835255b1983697bb4139ef5f02b27c1a91a1d5c7b79e70576854a"] :db/ensure [:answer-field/validate]} {:db/id "q-40747" :question/id #uuid "911b35a5-c875-5dda-a9fb-91433cdde5c5" :question/math-academy-id "q-40747" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/ce364dc7c6c4fc5e229fdeb0809b3779bf1052c60d956deb742731f34e54562d.png)\n\nIf $D$ is the finite region enclosed by the lines $y=2x,$ $x=0,$ and $y=4,$ as shown above, then ${∬}_{D}{y}^{2}\\sqrt{x}\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type I region. \n\n- To determine the $x$-limits, we need to find the $x$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $x:$\n\n$$\n\\begin{aligned}2x & =4 \\\\ x & =2\\end{aligned}\n$$\n\nSo, $x$-limits are \n$0\\le x\\le 2.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/54f366679684823341bab818459ce5fc884ebbdd2376e800b781d1b832c4ba64.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,2x\\le y\\le 4}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\sqrt{x}\\,\\text{d}A & ={\\int }_{0}^{2}{\\int }_{2x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-40747/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "853b2770-5057-50aa-9c15-7426cf4cc6a4"] :knowledge-point/questions ["q-40747"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81776/selection/a9805d3e0ad2e1ed850c9e7bd9ca69f0f8a3163035c09d70f8cfad4e162f2103" :answer/id #uuid "9e740309-62af-54a7-a695-21e843849d5a" :answer/type :answer.type/math :answer/value "\\frac{2}{15}" :db/ensure [:answer/validate]} {:db/id "q-81776/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" :answer/id #uuid "1e214645-5d14-56fa-aced-71c8ce96b13d" :answer/type :answer.type/math :answer/value "\\frac{1}{5}" :db/ensure [:answer/validate]} {:db/id "q-81776/selection/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d" :answer/id #uuid "7beab571-e611-52ae-a353-f67f703458eb" :answer/type :answer.type/math :answer/value "\\frac{2}{7}" :db/ensure [:answer/validate]} {:db/id "q-81776/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "047ac638-bb64-5d8d-a039-75ba521457f7" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-81776/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903" :answer/id #uuid "87cb4dc0-5245-5ff8-b694-a082217b6fd1" :answer/type :answer.type/math :answer/value "\\frac{2}{5}" :db/ensure [:answer/validate]} {:db/id "q-81776/selection" :answer-field/id #uuid "57789863-d478-5b9e-b4b5-7222e4bd270b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81776/selection/a9805d3e0ad2e1ed850c9e7bd9ca69f0f8a3163035c09d70f8cfad4e162f2103" :answer-field/choices ["q-81776/selection/a9805d3e0ad2e1ed850c9e7bd9ca69f0f8a3163035c09d70f8cfad4e162f2103" "q-81776/selection/c7e2c99672184a6ffc5fe21255ac37862a4c27e4b225c7b645ba47d8f3c76eda" "q-81776/selection/6aa0658ec3b64327f8a2d599faa4f715c940036c4e92b012fbfb8370208f2e7d" "q-81776/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-81776/selection/8bb646af439794acfbd313a6a7eb86a2818f1f792118f7583677724bca2d9903"] :db/ensure [:answer-field/validate]} {:db/id "q-81776" :question/id #uuid "745899d2-5260-5f7a-af3f-e49c255ef5ad" :question/math-academy-id "q-81776" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/6accbfcccdf910acca3aab9f1a12d0ab35c4da683fe78d6ca2d7ada88f28767c.png)\n\nEvaluate the double integral ${∬}_{D}{x}^{2}\\,dA,$\nwhere $D$ is the finite region above the $x$-axis enclosed by the curve $y=1-{x}^{2}$ and the line $x=0.$" :question/worked-solution "Notice that $D$ is a type I region.\n\n- We already know the intersection of the curve with the line $y=0.$\nSo, the $x$-limits are \n$0\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/db0dd47348fb2f9a97c9e0514f74adae05830de7e03f1aea2886eaa95701200e.png)\n\nAs a result, the integral is defined over the following type I region: \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1-{x}^{2}}\n$$\n\nSo, we can express the integral, as follows:\n\n$$\n{∬}_{D}{x}^{2}\\,dA={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}{x}^{2}\\,dy\\,dx\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}{x}^{2}\\,dy\\,dx & ={\\int }_{0}^{1}{x}^{2}[{\\int }_{0}^{1-{x}^{2}}dy]dx \\\\  & ={\\int }_{0}^{1}{x}^{2}[y]_{0}^{1-{x}^{2}}\\,dx \\\\  & ={\\int }_{0}^{1}{x}^{2}(1-{x}^{2}-0)\\,dx \\\\  & ={\\int }_{0}^{1}({x}^{2}-{x}^{4})\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({x}^{2}-{x}^{4})\\,dx & ={[\\frac{{x}^{3}}{3}-\\frac{{x}^{5}}{5}]}_{0}^{1} \\\\  & =\\frac{1}{3}-\\frac{1}{5}-0 \\\\  & =\\frac{2}{15}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81776/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "69f6b2a7-7a3a-5c2c-90db-5aa321784048"] :knowledge-point/questions ["q-81776"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132276/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "03900c69-17e5-58c1-8061-c49c807171c7" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-132276/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "1f865459-eacc-5938-a32e-6434f61920b9" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-132276/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "ff895d4c-11c5-5c72-a4c6-67d415f6fb03" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-132276/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "b4bddc1a-885f-5d34-853a-77b9098528c2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-132276/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "d1afaa30-d5c2-5c40-8f89-49a349cb720f" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-132276/selection" :answer-field/id #uuid "ee0745fc-045c-583f-9d68-cf03880cc771" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132276/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-132276/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-132276/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-132276/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-132276/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-132276/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-132276" :question/id #uuid "67ca505d-008f-5389-9f32-c45ef0e44690" :question/math-academy-id "q-132276" :question/problem "${\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}2\\operatorname{cos}⁡x\\,dy\\,dx=$" :question/worked-solution "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}2\\operatorname{cos}⁡x\\,dy\\,dx & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡x[{\\int }_{0}^{\\operatorname{sin}⁡x}\\,dy]dx \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡x[\\,y\\,]_{0}^{\\operatorname{sin}⁡x}\\,dx \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡x\\operatorname{sin}⁡x\\,dx \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2x\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2x\\,dx & ={[-\\frac{1}{2}\\operatorname{cos}⁡2x]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{1}{2}(-2) \\\\  & =1\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-132276/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a28c4320-e2dd-5195-81ac-b910c2328691"] :knowledge-point/questions ["q-132276"] :db/ensure [:knowledge-point/validate]}]
