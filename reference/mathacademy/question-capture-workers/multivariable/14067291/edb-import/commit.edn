{:edb/committed true :edb/basis-t 2246 :edb/replayed false :edb/tx-hash "700f414ec8a977112466a88cc80869b50d62793ffc405378259e4d2b9e80793f" :edb/db-before-t 2245 :edb/db-after-t 2246 :edb/tx-data [[13194139535558 50 #inst "2026-10-09T02:29:17.791Z" 13194139535558 true] [17592186133757 1020 #edb/ref 17592186355125 13194139535558 true] [17592186133758 1020 #edb/ref 17592186355104 13194139535558 true] [17592186133758 1020 #edb/ref 17592186355111 13194139535558 true] [17592186133759 1020 #edb/ref 17592186355118 13194139535558 true] [17592186133759 1020 #edb/ref 17592186355132 13194139535558 true] [17592186355104 1017 #edb/ref 17592186355105 13194139535558 true] [17592186355104 1089 "q-132276" 13194139535558 true] [17592186355104 1091 #edb/ref 17592186045465 13194139535558 true] [17592186355104 1100 "${\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}2\\operatorname{cos}⁡x\\,dy\\,dx=$" 13194139535558 true] [17592186355104 1113 #uuid "67ca505d-008f-5389-9f32-c45ef0e44690" 13194139535558 true] [17592186355104 1145 "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}{\\int }_{0}^{\\operatorname{sin}⁡x}2\\operatorname{cos}⁡x\\,dy\\,dx & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡x[{\\int }_{0}^{\\operatorname{sin}⁡x}\\,dy]dx \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡x[\\,y\\,]_{0}^{\\operatorname{sin}⁡x}\\,dx \\\\  & ={\\int }_{0}^{\\pi /2}2\\operatorname{cos}⁡x\\operatorname{sin}⁡x\\,dx \\\\  & ={\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2x\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡2x\\,dx & ={[-\\frac{1}{2}\\operatorname{cos}⁡2x]}_{0}^{\\pi /2} \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{1}{2}(-2) \\\\  & =1\\end{aligned}\n$$" 13194139535558 true] [17592186355105 1000 #edb/ref 17592186355106 13194139535558 true] [17592186355105 1000 #edb/ref 17592186355107 13194139535558 true] [17592186355105 1000 #edb/ref 17592186355108 13194139535558 true] [17592186355105 1000 #edb/ref 17592186355109 13194139535558 true] [17592186355105 1000 #edb/ref 17592186355110 13194139535558 true] [17592186355105 1040 #edb/ref 17592186045450 13194139535558 true] [17592186355105 1041 "selection" 13194139535558 true] [17592186355105 1104 #edb/ref 17592186355108 13194139535558 true] [17592186355105 1110 #uuid "ee0745fc-045c-583f-9d68-cf03880cc771" 13194139535558 true] [17592186355106 1034 "\\frac{1}{2}" 13194139535558 true] [17592186355106 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355106 1111 #uuid "b4bddc1a-885f-5d34-853a-77b9098528c2" 13194139535558 true] [17592186355107 1034 "2" 13194139535558 true] [17592186355107 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355107 1111 #uuid "d1afaa30-d5c2-5c40-8f89-49a349cb720f" 13194139535558 true] [17592186355108 1034 "1" 13194139535558 true] [17592186355108 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355108 1111 #uuid "03900c69-17e5-58c1-8061-c49c807171c7" 13194139535558 true] [17592186355109 1034 "\\frac{3}{2}" 13194139535558 true] [17592186355109 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355109 1111 #uuid "1f865459-eacc-5938-a32e-6434f61920b9" 13194139535558 true] [17592186355110 1034 "0" 13194139535558 true] [17592186355110 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355110 1111 #uuid "ff895d4c-11c5-5c72-a4c6-67d415f6fb03" 13194139535558 true] [17592186355111 1017 #edb/ref 17592186355112 13194139535558 true] [17592186355111 1089 "q-37683" 13194139535558 true] [17592186355111 1091 #edb/ref 17592186045465 13194139535558 true] [17592186355111 1100 "Calculate ${\\int }_{1/2}^{1}{\\int }_{x}^{1/x}\\frac{y}{{x}^{2}}\\,dy\\,dx.$" 13194139535558 true] [17592186355111 1113 #uuid "3630c4f5-1f80-56c5-89c5-e4637aed4fd4" 13194139535558 true] [17592186355111 1145 "The integral is defined over a type I region.\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1/2}^{1}{\\int }_{x}^{1/x}\\frac{y}{{x}^{2}}\\,dy\\,dx & ={\\int }_{1/2}^{1}\\frac{1}{{x}^{2}}[{\\int }_{x}^{1/x}y\\,dy]dx \\\\  & ={\\int }_{1/2}^{1}\\frac{1}{{x}^{2}}{[\\frac{{y}^{2}}{2}]}_{x}^{1/x}dx \\\\  & ={\\int }_{1/2}^{1}\\frac{1}{2{x}^{2}}(\\frac{1}{{x}^{2}}-{x}^{2})dx \\\\  & =\\frac{1}{2}{\\int }_{1/2}^{1}(\\frac{1}{{x}^{4}}-1)\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{1/2}^{1}(\\frac{1}{{x}^{4}}-1)\\,dx & =\\frac{1}{2}{[-\\frac{1}{3{x}^{3}}-x]}_{1/2}^{1} \\\\  & =-\\frac{1}{2}[\\frac{1}{3}+1-(\\frac{8}{3}+\\frac{1}{2})] \\\\  & =-\\frac{1}{2}(-\\frac{11}{6}) \\\\  & =\\frac{11}{12}\\end{aligned}\n$$" 13194139535558 true] [17592186355112 1000 #edb/ref 17592186355113 13194139535558 true] [17592186355112 1000 #edb/ref 17592186355114 13194139535558 true] [17592186355112 1000 #edb/ref 17592186355115 13194139535558 true] [17592186355112 1000 #edb/ref 17592186355116 13194139535558 true] [17592186355112 1000 #edb/ref 17592186355117 13194139535558 true] [17592186355112 1040 #edb/ref 17592186045450 13194139535558 true] [17592186355112 1041 "selection" 13194139535558 true] [17592186355112 1104 #edb/ref 17592186355113 13194139535558 true] [17592186355112 1110 #uuid "e6f5c200-2c7a-555e-ace9-8f508595cf05" 13194139535558 true] [17592186355113 1034 "\\frac{11}{12}" 13194139535558 true] [17592186355113 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355113 1111 #uuid "5543ef31-dcfe-55a5-b8a8-7f23167b449f" 13194139535558 true] [17592186355114 1034 "\\frac{11}{6}" 13194139535558 true] [17592186355114 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355114 1111 #uuid "0bc036ed-9155-546c-94b7-f82b9bc76f3b" 13194139535558 true] [17592186355115 1034 "-\\frac{11}{4}" 13194139535558 true] [17592186355115 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355115 1111 #uuid "9e227874-43d6-577f-a15e-ffd10970d5c4" 13194139535558 true] [17592186355116 1034 "\\frac{6}{11}" 13194139535558 true] [17592186355116 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355116 1111 #uuid "f5da3ce4-be8d-5bc0-9194-6ec9b2ac4f15" 13194139535558 true] [17592186355117 1034 "-\\frac{3}{11}" 13194139535558 true] [17592186355117 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355117 1111 #uuid "4cdf106d-f431-53b9-a023-ce338c1c7135" 13194139535558 true] [17592186355118 1017 #edb/ref 17592186355119 13194139535558 true] [17592186355118 1089 "q-37865" 13194139535558 true] [17592186355118 1091 #edb/ref 17592186045464 13194139535558 true] [17592186355118 1100 "Evaluate the double integral\n${∬}_{D}\\frac{1}{(1+x+y)^{2}}\\,dA,$\nwhere $D$ is the finite region enclosed by the line\n$y=1-x$ and the coordinate axes." 13194139535558 true] [17592186355118 1113 #uuid "4bff3979-2b39-5332-9bb6-24c5c18decd8" 13194139535558 true] [17592186355118 1145 "Let's make a sketch of our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/95ebd0a4eb874972b459e53eecf1d57650f63284698fcad967c09620ac01cd99.png)\n\nNotice that $D$ is a type I region.\n\n- The line $y=1-x$ intercepts the $x$-axis at $x=1.$\nSo, the $x$-limits are \n$0\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/d048f20f2299722cee598cc1005237627ecdd7643e996b269f26b5a096f01f2f.png)\n\nAs a result, the integral is defined over the following type I region: \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1-x}\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}\\frac{1}{(1+x+y)^{2}}\\,dA={\\int }_{0}^{1}{\\int }_{0}^{1-x}\\frac{1}{(1+x+y)^{2}}\\,dy\\,dx\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1-x}\\frac{1}{(1+x+y)^{2}}\\,dy\\,dx & ={\\int }_{0}^{1}[{\\int }_{0}^{-x+1}\\frac{1}{(1+x+y)^{2}}\\,dy]\\,dx \\\\  & ={\\int }_{0}^{1}{[-\\frac{1}{1+x+y}]}_{0}^{-x+1}\\,dx \\\\  & ={\\int }_{0}^{1}(-\\frac{1}{1+x+(1-x)}-(-\\frac{1}{1+x+0}))\\,dx \\\\  & ={\\int }_{0}^{1}(-\\frac{1}{2}+\\frac{1}{1+x})dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(-\\frac{1}{2}+\\frac{1}{1+x})dx & ={[-\\frac{1}{2}x+\\operatorname{ln}⁡(1+x)]}_{0}^{1} \\\\  & =-\\frac{1}{2}+\\operatorname{ln}⁡(2)-(0+\\operatorname{ln}⁡(1)) \\\\  & =-\\frac{1}{2}+\\operatorname{ln}⁡(2)\\end{aligned}\n$$" 13194139535558 true] [17592186355119 1000 #edb/ref 17592186355120 13194139535558 true] [17592186355119 1000 #edb/ref 17592186355121 13194139535558 true] [17592186355119 1000 #edb/ref 17592186355122 13194139535558 true] [17592186355119 1000 #edb/ref 17592186355123 13194139535558 true] [17592186355119 1000 #edb/ref 17592186355124 13194139535558 true] [17592186355119 1040 #edb/ref 17592186045450 13194139535558 true] [17592186355119 1041 "selection" 13194139535558 true] [17592186355119 1104 #edb/ref 17592186355123 13194139535558 true] [17592186355119 1110 #uuid "30936431-098b-5922-9211-7dfc9d49666f" 13194139535558 true] [17592186355120 1034 "2\\operatorname{ln}⁡(2)" 13194139535558 true] [17592186355120 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355120 1111 #uuid "97187c1b-4fdb-52bb-ae26-c9ba925d0b7f" 13194139535558 true] [17592186355121 1034 "2\\operatorname{ln}⁡(2)-\\frac{1}{2}" 13194139535558 true] [17592186355121 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355121 1111 #uuid "291b2acb-cfc4-59da-a935-030002db3eab" 13194139535558 true] [17592186355122 1034 "\\frac{1}{2}" 13194139535558 true] [17592186355122 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355122 1111 #uuid "8a1d76eb-0e11-5b85-aa7c-f80308bc113b" 13194139535558 true] [17592186355123 1034 "-\\frac{1}{2}+\\operatorname{ln}⁡(2)" 13194139535558 true] [17592186355123 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355123 1111 #uuid "6515893c-d11a-5f45-9a7d-5e2ff1d7a773" 13194139535558 true] [17592186355124 1034 "\\operatorname{ln}⁡(2)+\\frac{1}{2}" 13194139535558 true] [17592186355124 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355124 1111 #uuid "b706b36c-5a51-5e2a-ac59-a839878bb4ab" 13194139535558 true] [17592186355125 1017 #edb/ref 17592186355126 13194139535558 true] [17592186355125 1089 "q-40747" 13194139535558 true] [17592186355125 1091 #edb/ref 17592186045463 13194139535558 true] [17592186355125 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/ce364dc7c6c4fc5e229fdeb0809b3779bf1052c60d956deb742731f34e54562d.png)\n\nIf $D$ is the finite region enclosed by the lines $y=2x,$ $x=0,$ and $y=4,$ as shown above, then ${∬}_{D}{y}^{2}\\sqrt{x}\\,dA=$" 13194139535558 true] [17592186355125 1113 #uuid "911b35a5-c875-5dda-a9fb-91433cdde5c5" 13194139535558 true] [17592186355125 1145 "First, let's represent $D$ as a type I region. \n\n- To determine the $x$-limits, we need to find the $x$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $x:$\n\n$$\n\\begin{aligned}2x & =4 \\\\ x & =2\\end{aligned}\n$$\n\nSo, $x$-limits are \n$0\\le x\\le 2.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/54f366679684823341bab818459ce5fc884ebbdd2376e800b781d1b832c4ba64.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,2x\\le y\\le 4}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\sqrt{x}\\,\\text{d}A & ={\\int }_{0}^{2}{\\int }_{2x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx\\end{aligned}\n$$" 13194139535558 true] [17592186355126 1000 #edb/ref 17592186355127 13194139535558 true] [17592186355126 1000 #edb/ref 17592186355128 13194139535558 true] [17592186355126 1000 #edb/ref 17592186355129 13194139535558 true] [17592186355126 1000 #edb/ref 17592186355130 13194139535558 true] [17592186355126 1000 #edb/ref 17592186355131 13194139535558 true] [17592186355126 1040 #edb/ref 17592186045450 13194139535558 true] [17592186355126 1041 "selection" 13194139535558 true] [17592186355126 1104 #edb/ref 17592186355129 13194139535558 true] [17592186355126 1110 #uuid "c3c4a7a2-8c4a-5d47-82d3-57cf2fe097cf" 13194139535558 true] [17592186355127 1034 "{\\int }_{0}^{2}{\\int }_{4}^{2x}{y}^{2}\\sqrt{x}\\,dy\\,dx" 13194139535558 true] [17592186355127 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355127 1111 #uuid "658c3a22-9fde-53bb-876c-4f996b3c123c" 13194139535558 true] [17592186355128 1034 "{\\int }_{0}^{2}{\\int }_{x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" 13194139535558 true] [17592186355128 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355128 1111 #uuid "4e2413d2-9ed5-5ebc-9751-3b7e7a13602c" 13194139535558 true] [17592186355129 1034 "{\\int }_{0}^{2}{\\int }_{2x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" 13194139535558 true] [17592186355129 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355129 1111 #uuid "6c5ebaa1-79cb-58bf-a53b-1e3d6362a18d" 13194139535558 true] [17592186355130 1034 "{\\int }_{0}^{2}{\\int }_{-2x}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" 13194139535558 true] [17592186355130 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355130 1111 #uuid "eaf1b0ac-c3c9-5844-b262-6b5ba8f3d5a6" 13194139535558 true] [17592186355131 1034 "{\\int }_{0}^{2}{\\int }_{x/2}^{4}{y}^{2}\\sqrt{x}\\,dy\\,dx" 13194139535558 true] [17592186355131 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355131 1111 #uuid "72de0563-0ef0-5c1b-8353-f350474c7871" 13194139535558 true] [17592186355132 1017 #edb/ref 17592186355133 13194139535558 true] [17592186355132 1089 "q-81776" 13194139535558 true] [17592186355132 1091 #edb/ref 17592186045463 13194139535558 true] [17592186355132 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/6accbfcccdf910acca3aab9f1a12d0ab35c4da683fe78d6ca2d7ada88f28767c.png)\n\nEvaluate the double integral ${∬}_{D}{x}^{2}\\,dA,$\nwhere $D$ is the finite region above the $x$-axis enclosed by the curve $y=1-{x}^{2}$ and the line $x=0.$" 13194139535558 true] [17592186355132 1113 #uuid "745899d2-5260-5f7a-af3f-e49c255ef5ad" 13194139535558 true] [17592186355132 1145 "Notice that $D$ is a type I region.\n\n- We already know the intersection of the curve with the line $y=0.$\nSo, the $x$-limits are \n$0\\le x\\le 1.$\n\n- To determine the lower and upper functions, we draw a vertical arrow through the region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067291/assets/db0dd47348fb2f9a97c9e0514f74adae05830de7e03f1aea2886eaa95701200e.png)\n\nAs a result, the integral is defined over the following type I region: \n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,0\\le y\\le 1-{x}^{2}}\n$$\n\nSo, we can express the integral, as follows:\n\n$$\n{∬}_{D}{x}^{2}\\,dA={\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}{x}^{2}\\,dy\\,dx\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $y$, treating $x$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1-{x}^{2}}{x}^{2}\\,dy\\,dx & ={\\int }_{0}^{1}{x}^{2}[{\\int }_{0}^{1-{x}^{2}}dy]dx \\\\  & ={\\int }_{0}^{1}{x}^{2}[y]_{0}^{1-{x}^{2}}\\,dx \\\\  & ={\\int }_{0}^{1}{x}^{2}(1-{x}^{2}-0)\\,dx \\\\  & ={\\int }_{0}^{1}({x}^{2}-{x}^{4})\\,dx\\end{aligned}\n$$\n\nThen, we integrate with respect to $x:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}({x}^{2}-{x}^{4})\\,dx & ={[\\frac{{x}^{3}}{3}-\\frac{{x}^{5}}{5}]}_{0}^{1} \\\\  & =\\frac{1}{3}-\\frac{1}{5}-0 \\\\  & =\\frac{2}{15}\\end{aligned}\n$$" 13194139535558 true] [17592186355133 1000 #edb/ref 17592186355134 13194139535558 true] [17592186355133 1000 #edb/ref 17592186355135 13194139535558 true] [17592186355133 1000 #edb/ref 17592186355136 13194139535558 true] [17592186355133 1000 #edb/ref 17592186355137 13194139535558 true] [17592186355133 1000 #edb/ref 17592186355138 13194139535558 true] [17592186355133 1040 #edb/ref 17592186045450 13194139535558 true] [17592186355133 1041 "selection" 13194139535558 true] [17592186355133 1104 #edb/ref 17592186355137 13194139535558 true] [17592186355133 1110 #uuid "57789863-d478-5b9e-b4b5-7222e4bd270b" 13194139535558 true] [17592186355134 1034 "15" 13194139535558 true] [17592186355134 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355134 1111 #uuid "047ac638-bb64-5d8d-a039-75ba521457f7" 13194139535558 true] [17592186355135 1034 "\\frac{2}{7}" 13194139535558 true] [17592186355135 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355135 1111 #uuid "7beab571-e611-52ae-a353-f67f703458eb" 13194139535558 true] [17592186355136 1034 "\\frac{2}{5}" 13194139535558 true] [17592186355136 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355136 1111 #uuid "87cb4dc0-5245-5ff8-b694-a082217b6fd1" 13194139535558 true] [17592186355137 1034 "\\frac{2}{15}" 13194139535558 true] [17592186355137 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355137 1111 #uuid "9e740309-62af-54a7-a695-21e843849d5a" 13194139535558 true] [17592186355138 1034 "\\frac{1}{5}" 13194139535558 true] [17592186355138 1103 #edb/ref 17592186045453 13194139535558 true] [17592186355138 1111 #uuid "1e214645-5d14-56fa-aced-71c8ce96b13d" 13194139535558 true]] :edb/tempids {"q-132276" 17592186355104 "q-132276/selection" 17592186355105 "q-132276/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" 17592186355106 "q-132276/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" 17592186355107 "q-132276/selectio