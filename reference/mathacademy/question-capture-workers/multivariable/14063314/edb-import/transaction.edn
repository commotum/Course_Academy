[{:db/id "q-114329/selection/cef6139b90454e0526025fb3665ce03935deebf531ef66dc181e10a52fd691d6" :answer/id #uuid "dc9bb868-cb05-5ad2-8124-39241baa05a2" :answer/type :answer.type/math :answer/value "\\frac{e+1}{e}" :db/ensure [:answer/validate]} {:db/id "q-114329/selection/d9bad9836c48abe2ad16c01714ba294aba0d21e6d897fe8f1ca34ad87998c2d6" :answer/id #uuid "5b15d257-202c-5722-9af4-45e7854ae35c" :answer/type :answer.type/math :answer/value "\\frac{e-2}{e}" :db/ensure [:answer/validate]} {:db/id "q-114329/selection/35f44790458788e5f11f9806cc415e3190f427aea55b65cabd4b2d7f9ba7f22e" :answer/id #uuid "6347aa7f-9660-5c9e-8043-72ea0d093d57" :answer/type :answer.type/math :answer/value "\\frac{2e-3}{e}" :db/ensure [:answer/validate]} {:db/id "q-114329/selection/e84847c77a157fd8684e00d76ced964de17458885dd852506e95d807e5cb128f" :answer/id #uuid "75386e2b-fe73-5b35-9fb4-2999aecb1dc5" :answer/type :answer.type/math :answer/value "\\frac{e-2}{e+2}" :db/ensure [:answer/validate]} {:db/id "q-114329/selection/ba572adcb632fe41c440e99ec350c9e910e7dd1a9d57d31ce8ed842129993938" :answer/id #uuid "8993fe74-127a-538e-8a16-33a5237df576" :answer/type :answer.type/math :answer/value "\\frac{e}{e+2}" :db/ensure [:answer/validate]} {:db/id "q-114329/selection" :answer-field/id #uuid "51778cb5-b793-50f0-a25f-cb4b0c05dc39" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114329/selection/d9bad9836c48abe2ad16c01714ba294aba0d21e6d897fe8f1ca34ad87998c2d6" :answer-field/choices ["q-114329/selection/cef6139b90454e0526025fb3665ce03935deebf531ef66dc181e10a52fd691d6" "q-114329/selection/d9bad9836c48abe2ad16c01714ba294aba0d21e6d897fe8f1ca34ad87998c2d6" "q-114329/selection/35f44790458788e5f11f9806cc415e3190f427aea55b65cabd4b2d7f9ba7f22e" "q-114329/selection/e84847c77a157fd8684e00d76ced964de17458885dd852506e95d807e5cb128f" "q-114329/selection/ba572adcb632fe41c440e99ec350c9e910e7dd1a9d57d31ce8ed842129993938"] :db/ensure [:answer-field/validate]} {:db/id "q-114329" :question/id #uuid "55e954dc-2c14-5a02-b400-2dc0fdfc8de1" :question/math-academy-id "q-114329" :question/problem "Evaluate the integral ${\\int }_{0}^{1/3}9x{e}^{-3x}\\,\\text{d}x.$" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=9x & ⇒ & {u}^{′}=9 \\\\ {v}^{′}={e}^{-3x} & ⇒ & v=-\\frac{{e}^{-3x}}{3}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 9x\\cdot {e}^{-3x}\\,\\text{d}x & =9x\\cdot (-\\frac{{e}^{3x}}{3})-\\int (-\\frac{{e}^{-3x}}{3})\\cdot 9\\,\\text{d}x \\\\  & =-3x{e}^{-3x}+3\\int {e}^{-3x}\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1/3}9x{e}^{-3x}\\,\\text{d}x & =-3x{e}^{-3x}{|}_{0}^{1/3}+3{\\int }_{0}^{1/3}{e}^{-3x}\\text{d}x \\\\  & =-3x{e}^{-3x}{|}_{0}^{1/3}-{e}^{-3x}{|}_{0}^{1/3} \\\\  & =-3[\\frac{1}{3}{e}^{-3(1/3)}-0\\cdot {e}^{-3\\cdot 0}]-[{e}^{-3(1/3)}-{e}^{-3\\cdot 0}] \\\\  & =-3[\\frac{{e}^{-1}}{3}-0]-[{e}^{-1}-1] \\\\  & =-\\frac{1}{e}-\\frac{1}{e}+1 \\\\  & =1-\\frac{2}{e} \\\\  & =\\frac{e-2}{e}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114329/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8"] :knowledge-point/questions ["q-114329"] :db/ensure [:knowledge-point/validate]} {:db/id "q-349348/field-1/046950d27afc9f7c1fce1b155793260c4bcfc29fc7ceac2e46ff4746e6858e1d" :answer/id #uuid "34046d38-8674-5363-8f1d-d91bbed8295c" :answer/type :answer.type/math :answer/value "1-4e^{-3}" :db/ensure [:answer/validate]} {:db/id "q-349348/field-1" :answer-field/id #uuid "7a49d9e3-c864-5620-8d62-ea9afffb3977" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-349348/field-1/046950d27afc9f7c1fce1b155793260c4bcfc29fc7ceac2e46ff4746e6858e1d" :answer-field/choices ["q-349348/field-1/046950d27afc9f7c1fce1b155793260c4bcfc29fc7ceac2e46ff4746e6858e1d"] :db/ensure [:answer-field/validate]} {:db/id "q-349348" :question/id #uuid "e6ae8044-0222-5565-a97c-42993eaaebfe" :question/math-academy-id "q-349348" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{1}9x{e}^{-3x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "Let's use integration by parts. We set\n\n$$\n\\begin{aligned}u=9x & ⇒ & {u}^{′}=9 \\\\ {v}^{′}={e}^{-3x} & ⇒ & v=-\\frac{1}{3}{e}^{-3x}.\\end{aligned}\n$$\n\nSubstituting the above into the integration by parts formula, we get\n\n$$\n\\begin{aligned}\\int u{v}^{′}\\,\\text{d}x & =uv-\\int v{u}^{′}\\,\\text{d}x \\\\ \\int 9x\\cdot {e}^{-3x}\\,\\text{d}x & =9x\\cdot (-\\frac{1}{3}{e}^{-3x})-\\int (-\\frac{1}{3}{e}^{-3x})\\cdot 9\\,\\text{d}x.\\end{aligned}\n$$\n\nFinally, we evaluate the integral and get\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}9x{e}^{-3x}\\,\\text{d}x & =-3x{e}^{-3x}\\,{|}_{0}^{1}-3{\\int }_{0}^{1}{e}^{-3x}\\,\\text{d}x \\\\  & =-3x{e}^{-3x}\\,{|}_{0}^{1}-{e}^{-3x}\\,{|}_{0}^{1} \\\\  & =-3(1\\cdot {e}^{-3}-0\\cdot {e}^{0})-({e}^{-3}-{e}^{0}) \\\\  & =-3{e}^{-3}-({e}^{-3}-1) \\\\  & =1-4{e}^{-3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-349348/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d3aaba0a-3b86-58c3-bbc8-22ced09bc8a8"] :knowledge-point/questions ["q-349348"] :db/ensure [:knowledge-point/validate]}]
