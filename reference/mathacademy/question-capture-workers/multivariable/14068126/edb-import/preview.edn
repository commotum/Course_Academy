{2}}⟩$ is non-zero. Since the lateral side of $S$ is parallel to the $z$-axis, the flux of $F$ through $S$ will be non-zero only at the top and bottom sides. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14068126/assets/e6fe01196298c1da0961fd01c73ee4cb7c71b6a03a027cceaba0e68be944c968.png)\n\n \nLet's consider the flux of $F$ through these two sides.\n\n- Let ${S}_{1}$ denote the top surface. On this surface, we have $z=2$ for ${x}^{2}+{y}^{2}\\le 4.$ The outward-pointing unit normal vector to ${S}_{1}$ is\n\n$$\n{n}_{1}=⟨0,\\,0,\\,1⟩.\n$$\n\nUsing the fact that $z=2$ on ${S}_{1},$ we have\n\n$$\n\\begin{aligned}F\\cdot {n}_{1} & =⟨0,\\,0,\\,{z}^{2}\\sqrt{16-{x}^{2}-{y}^{2}}⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =⟨0,\\,0,\\,{2}^{2}\\sqrt{16-{x}^{2}-{y}^{2}}⟩\\cdot ⟨0,\\,0,\\,1⟩ \\\\  & =4\\sqrt{16-{x}^{2}-{y}^{2}}.\\end{aligned}\n$$\n\nTherefore, the flux of $F$ across ${S}_{1}$ is given by\n\n$$\n\\begin{aligned}{∬}_{{S}_{1}}F\\cdot \\text{d}S & ={∬}_{{S}_{1}}F\\cdot {n}_{1}\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}4\\sqrt{16-{x}^{2}-{y}^{2}}\\,\\text{d}S \\\\  & =4{∬}_{D}\\sqrt{16-{x}^{2}-{y}^{2}}\\,\\text{d}A.\\end{aligned}\n$$\n\nApplying a change of variables $(x,y)\\to (r,\\theta ),\\text{d}A=r\\,\\text{d}r\\,\\text{d}\\theta ,$ we have\n\n$$\n\\begin{aligned}4{∬}_{D}\\sqrt{16-{x}^{2}-{y}^{2}}\\,\\text{d}A & =4{∬}_{D}\\sqrt{16-{r}^{2}}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }{\\int }_{0}^{2}r\\sqrt{16-{r}^{2}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & =4{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta {\\int }_{0}^{2}r\\sqrt{16-{r}^{2}}\\,\\text{d}r \\\\  & =4\\cdot 2\\pi \\cdot {\\int }_{0}^{2}r\\sqrt{16-{r}^{2}}\\,\\text{d}r \\\\  & =8\\pi {\\int }_{0}^{2}r\\sqrt{16-{r}^{2}}\\,\\text{d}r.\\end{aligned}\n$$\n\nSetting $u=16-{r}^{2},$ we get $\\text{d}u=-2r\\,\\text{d}r.$ Also, the limits must be changed as follows:\n\n$$\n\\begin{aligned}r & 0 & 2 \\\\ u & 16 & 12\\end{aligned}\n$$\n\n \n\nSubstituting these into our integral, we obtain\n\n$$\n\\begin{aligned}8\\pi {\\int }_{0}^{2}r\\sqrt{16-{r}^{2}}\\,\\text{d}r & =8\\pi \\cdot {\\int }_{16}^{12}\\sqrt{u}(-\\frac{1}{2}\\text{d}u) \\\\  & =4\\pi {\\int }_{12}^{16}{u}^{1/2}\\,\\text{d}u \\\\  & =4\\pi \\cdot \\frac{2}{3}{[{u}^{3/2}]}_{12}^{16} \\\\  & =\\frac{8\\pi }{3}[64-24\\sqrt{3}] \\\\  & =\\frac{64\\pi (8-3\\sqrt{3})}{3}.\\end{aligned}\n$$\n\n- Let ${S}_{2}$ denote the bottom surface. On this surface, we have $z=0$ for ${x}^{2}+{y}^{2}\\le 4.$ Therefore, for everywhere on ${S}_{2},$ we have\n\n$$\nF(x,y,0)=⟨0,\\,0,\\,{0}^{2}\\sqrt{16-{x}^{2}-{y}^{2}}⟩=⟨0,\\,0,\\,0⟩.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S & ={∬}_{{S}_{2}}0\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{2}}0\\,\\text{d}S \\\\  & =0.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}{∬}_{S}F\\cdot \\text{d}S & ={∬}_{S}F\\cdot n\\,\\text{d}S \\\\  & ={∬}_{{S}_{1}}F\\cdot n\\,\\text{d}S+{∬}_{{S}_{2}}F\\cdot n\\,\\text{d}S \\\\  & =\\frac{64\\pi (8-3\\sqrt{3})}{3}+0 \\\\  & =\\frac{64\\pi (8-3\\sqrt{3})}{3}.\\end{aligned}\n$$" 13194139535588 true] [17592186356416 1000 #edb/ref 17592186356417 13194139535588 true] [17592186356416 1000 #edb/ref 17592186356418 13194139535588 true] [17592186356416 1000 #edb/ref 17592186356419 13194139535588 true] [17592186356416 1000 #edb/ref 17592186356420 13194139535588 true] [17592186356416 1000 #edb/ref 17592186356421 13194139535588 true] [17592186356416 1040 #edb/ref 17592186045450 13194139535588 true] [17592186356416 1041 "selection" 13194139535588 true] [17592186356416 1104 #edb/ref 17592186356420 13194139535588 true] [17592186356416 1110 #uuid "1e5b31ff-07aa-50c1-96ca-855d539c9f30" 13194139535588 true] [17592186356417 1034 "\\frac{27\\pi (4-\\sqrt{2})}{2}" 13194139535588 true] [17592186356417 1103 #edb/ref 17592186045453 13194139535588 true] [17592186356417 1111 #uuid "41351075-addf-5141-9223-092883a61daf" 13194139535588 true] [17592186356418 1034 "5\\pi " 13194139535588 tr