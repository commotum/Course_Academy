,2)}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂y}$ at $(e,2):$\n\n$$\n\\begin{aligned}{f}_{y}(e,2) & =2\\operatorname{ln}⁡e-\\frac{{e}^{2}}{{e}^{2}} \\\\  & =2-1 \\\\  & =1\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(e,2)} & =\\frac{∂z}{∂y}{|}_{(e,2)}(y-2) \\\\ z-3 & =1(y-2) \\\\ z & =y+1\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(e,2,3)$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}x=e \\\\ z=y+1\\end{aligned}\n$$" 13194139534950 true] [17592186321967 1000 #edb/ref 17592186321968 13194139534950 true] [17592186321967 1000 #edb/ref 17592186321969 13194139534950 true] [17592186321967 1000 #edb/ref 17592186321970 13194139534950 true] [17592186321967 1000 #edb/ref 17592186321971 13194139534950 true] [17592186321967 1000 #edb/ref 17592186321972 13194139534950 true] [17592186321967 1040 #edb/ref 17592186045450 13194139534950 true] [17592186321967 1041 "selection" 13194139534950 true] [17592186321967 1104 #edb/ref 17592186321970 13194139534950 true] [17592186321967 1110 #uuid "c0ade84a-e009-5373-9e20-c5f73c9de403" 13194139534950 true] [17592186321968 1034 "{\\begin{aligned}x=e \\\\ z=2y-3\\end{aligned}" 13194139534950 true] [17592186321968 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321968 1111 #uuid "991042b2-3d27-5a0b-a6e2-49d17fca0d50" 13194139534950 true] [17592186321969 1034 "{\\begin{aligned}x=e \\\\ z=y-2\\end{aligned}" 13194139534950 true] [17592186321969 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321969 1111 #uuid "fb86dcd4-62b0-54a2-818f-cde5b9bd4e8b" 13194139534950 true] [17592186321970 1034 "{\\begin{aligned}x=e \\\\ z=y+1\\end{aligned}" 13194139534950 true] [17592186321970 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321970 1111 #uuid "c0e823a8-b2dd-5432-a6dd-7787c3f4a712" 13194139534950 true] [17592186321971 1034 "{\\begin{aligned}x=e \\\\ z=2y-1\\end{aligned}" 13194139534950 true] [17592186321971 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321971 1111 #uuid "97721005-5ca9-5036-b701-78c3eff0d71d" 13194139534950 true] [17592186321972 1034 "{\\begin{aligned}x=e \\\\ z=y+3\\end{aligned}" 13194139534950 true] [17592186321972 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321972 1111 #uuid "eb6a2638-2da6-56b4-a918-890205bbd536" 13194139534950 true] [17592186321973 1017 #edb/ref 17592186321974 13194139534950 true] [17592186321973 1089 "q-132590" 13194139534950 true] [17592186321973 1091 #edb/ref 17592186045465 13194139534950 true] [17592186321973 1100 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=2.$ Given that the point $P(-\\frac{\\pi }{2},2,2\\pi )$ lies on $C$, and that ${f}_{x}=\\operatorname{sin}⁡x+\\frac{xy}{\\pi }$, find the equations of the tangent line to $C$ at $P.$" 13194139534950 true] [17592186321973 1113 #uuid "760c6872-f52d-53e8-b7b3-88a52e70f20e" 13194139534950 true] [17592186321973 1145 "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=2.$ Hence, the slope of the tangent to the curve at the point $P(-\\frac{\\pi }{2},2,2\\pi )$ will be given by the partial derivative $\\frac{∂z}{∂x}{|}_{(-\\pi /2,2)}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂x}$ at $(-\\frac{\\pi }{2},2):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂x}{|}_{(-\\pi /2,2)} & =\\operatorname{sin}⁡(-\\frac{\\pi }{2})+\\frac{(-\\frac{\\pi }{2})(2)}{\\pi } \\\\  & =-1-1 \\\\  & =-2\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(-\\pi /2,2)} & =\\frac{∂z}{∂x}{|}_{(-\\pi /2,2)}(x-(-\\frac{\\pi }{2})) \\\\ z-2\\pi  & =-2(x+\\frac{\\pi }{2}) \\\\ z & =-2x+\\pi \\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(-\\frac{\\pi }{2},2,2\\pi )$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}y=2 \\\\ z=-2x+\\pi \\end{aligned}\n$$" 13194139534950 true] [17592186321974 1000 #edb/ref 17592186321975 13194139534950 true] [17592186321974 1000 #edb/ref 17592186321976 13194139534950 true] [17592186321974 1000 #edb/ref 17592186321977 13194139534950 true] [17592186321974 1000 #edb/ref 17592186321978 13194139534950 true] [17592186321974 1000 #edb/ref 17592186321979 13194139534950 true] [17592186321974 1040 #edb/ref 17592186045450 13194139534950 true] [17592186321974 1041 "selection" 13194139534950 true] [17592186321974 1104 #edb/ref 17592186321979 13194139534950 true] [17592186321974 1110 #uuid "95677b3e-be0f-51c7-aace-c7b0e0552362" 13194139534950 true] [17592186321975 1034 "{\\begin{aligned}y=2 \\\\ z=x+2\\pi \\end{aligned}" 13194139534950 true] [17592186321975 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321975 1111 #uuid "382f32da-fa62-598a-8373-1b07a14e418e" 13194139534950 true] [17592186321976 1034 "{\\begin{aligned}y=2 \\\\ z=2x-2\\pi \\end{aligned}" 13194139534950 true] [17592186321976 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321976 1111 #uuid "86c20059-5dfa-5ce1-8fe9-2a4c9cb54c49" 13194139534950 true] [17592186321977 1034 "{\\begin{aligned}y=2 \\\\ z=-2x-\\frac{\\pi }{2}\\end{aligned}" 13194139534950 true] [17592186321977 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321977 1111 #uuid "a583929c-bb75-579d-95b1-bf46b4cd8f55" 13194139534950 true] [17592186321978 1034 "{\\begin{aligned}y=2 \\\\ z=x-\\pi \\end{aligned}" 13194139534950 true] [17592186321978 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321978 1111 #uuid "8234ef11-10ca-5149-9ad8-a86240cd9fe7" 13194139534950 true] [17592186321979 1034 "{\\begin{aligned}y=2 \\\\ z=-2x+\\pi \\end{aligned}" 13194139534950 true] [17592186321979 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321979 1111 #uuid "8fc76348-2713-5cee-ac94-bae3d3c969af" 13194139534950 true] [17592186321980 1017 #edb/ref 17592186321981 13194139534950 true] [17592186321980 1089 "q-132599" 13194139534950 true] [17592186321980 1091 #edb/ref 17592186045464 13194139534950 true] [17592186321980 1100 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $y=1.$ Given that the point $P(2,1,4)$ lies on $C$, and that ${f}_{x}={e}^{y-1}+2x\\operatorname{cos}⁡(y-1)$, which of the following gives a tangent vector to $C$ at $P?$" 13194139534950 true] [17592186321980 1113 #uuid "55ea53d1-23d3-50b0-af4a-d002f4c94b27" 13194139534950 true] [17592186321980 1145 "The curve $C$ is the intersection of the surface with the plane $y=1.$ Hence, the slope of the tangent to the curve $C$ at the point $P$ will be given by the partial derivative ${f}_{x}(2,1).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(2,1):$\n\n$$\n\\begin{aligned}{f}_{x}(2,1) & ={e}^{1-1}+2(2)\\operatorname{cos}⁡(1-1) \\\\  & =1+4 \\\\  & =5\\end{aligned}\n$$\n\n \n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-f(2,1) & ={f}_{x}(2,1)(x-2) \\\\ z-4 & =5(x-2) \\\\ z & =5x-6\\end{aligned}\n$$\n\nTherefore, the tangent line to the curve $C$ at $P(2,1,4)$ can be given as the intersection of two planes:\n\n$$\n{\\begin{aligned}y=1 \\\\ z=5x-6\\end{aligned}\n$$\n\nNext, notice that:\n\n- For the plane $y=0,$ a normal vector to the plane is ${n}_{1}=⟨0,1,0⟩.$\n\n- For the plane $z=5x-6$ (or $5x-z-6=0$), a normal vector to the plane is ${n}_{2}=⟨5,0,-1⟩.$\n\nFinally, to find a direction vector for the tangent line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨0,1,0⟩\\times ⟨5,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 0 & 1 & 0 \\\\ 5 & 0 & -1\\end{aligned}\\right| \\\\  & =-i-5\\,k \\\\  & =⟨-1,0,-5⟩\\end{aligned}\n$$\n\nFinally, since $⟨-1,0,-5⟩$ is parallel to the tangent line, then $-⟨-1,0,-5⟩=⟨1,0,5⟩$ is also parallel to it." 13194139534950 true] [17592186321981 1000 #edb/ref 17592186321982 13194139534950 true] [17592186321981 1000 #edb/ref 17592186321983 13194139534950 true] [17592186321981 1000 #edb/ref 17592186321984 13194139534950 true] [17592186321981 1000 #edb/ref 17592186321985 13194139534950 true] [17592186321981 1000 #edb/ref 17592186321986 13194139534950 true] [17592186321981 1040 #edb/ref 17592186045450 13194139534950 true] [17592186321981 1041 "selection" 13194139534950 true] [17592186321981 1104 #edb/ref 17592186321982 13194139534950 true] [17592186321981 1110 #uuid "70f31201-de1e-54e0-8303-6d62dd785868" 13194139534950 true] [17592186321982 1034 "⟨1,0,5⟩" 13194139534950 true] [17592186321982 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321982 1111 #uuid "d3795097-21ef-5069-87b3-fdaf4499687b" 13194139534950 true] [17592186321983 1034 "⟨1,0,2⟩" 13194139534950 true] [17592186321983 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321983 1111 #uuid "f3ec3124-2d80-5025-bc2d-f74559ffd22b" 13194139534950 true] [17592186321984 1034 "⟨3,0,5⟩" 13194139534950 true] [17592186321984 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321984 1111 #uuid "eecb499d-01e5-5d99-9b67-13734354e5d4" 13194139534950 true] [17592186321985 1034 "⟨2,0,3⟩" 13194139534950 true] [17592186321985 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321985 1111 #uuid "b6753f10-77bc-5c44-8c29-30d9379f2cef" 13194139534950 true] [17592186321986 1034 "⟨3,0,1⟩" 13194139534950 true] [17592186321986 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321986 1111 #uuid "2ea7d46d-e3a5-557f-84fe-1637e2fcd61d" 13194139534950 true] [17592186321987 1017 #edb/ref 17592186321988 13194139534950 true] [17592186321987 1089 "q-36301" 13194139534950 true] [17592186321987 1091 #edb/ref 17592186045465 13194139534950 true] [17592186321987 1100 "The curve $C$ is the intersection of a surface $S,$ defined by $z=f(x,y),$ with the plane $x=-2.$ Given that the point $P(-2,0,8)$ lies on $C$, and that ${f}_{y}=x\\operatorname{cos}⁡y+4y+x$, find the equations of the tangent line to $C$ at $P.$" 13194139534950 true] [17592186321987 1113 #uuid "33bf0daa-0427-5567-9a5c-6a79e37f5a37" 13194139534950 true] [17592186321987 1145 "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=-2.$ Hence, the slope of the tangent to the curve at the point $P(-2,0,8)$ will be given by the partial derivative $\\frac{∂z}{∂y}{|}_{(-2,0)}.$\n\nTo get the slope, we evaluate the partial derivative $\\frac{∂z}{∂y}$ at $(-2,0):$\n\n$$\n\\begin{aligned}\\frac{∂z}{∂y}{|}_{(-2,0)} & =(-2)\\operatorname{cos}⁡0+4(0)+(-2) \\\\  & =-2-2 \\\\  & =-4\\end{aligned}\n$$\n\nNow, we use the point-slope form of a straight line:\n\n$$\n\\begin{aligned}z-z{|}_{(-2,0)} & =\\frac{∂z}{∂y}{|}_{(-2,0)}(y-0) \\\\ z-8 & =-4(y-0) \\\\ z & =-4y+8\\end{aligned}\n$$\n\nFinally, the tangent line to the curve $C$ at $P(-2,0,8)$ can be given as the intersection of two planes, as follows:\n\n$$\n{\\begin{aligned}x=-2 \\\\ z=-4y+8\\end{aligned}\n$$" 13194139534950 true] [17592186321988 1000 #edb/ref 17592186321989 13194139534950 true] [17592186321988 1000 #edb/ref 17592186321990 13194139534950 true] [17592186321988 1000 #edb/ref 17592186321991 13194139534950 true] [17592186321988 1000 #edb/ref 17592186321992 13194139534950 true] [17592186321988 1000 #edb/ref 17592186321993 13194139534950 true] [17592186321988 1040 #edb/ref 17592186045450 13194139534950 true] [17592186321988 1041 "selection" 13194139534950 true] [17592186321988 1104 #edb/ref 17592186321990 13194139534950 true] [17592186321988 1110 #uuid "040cceeb-77af-5045-8aef-ab24f611ebe2" 13194139534950 true] [17592186321989 1034 "{\\begin{aligned}x=-2 \\\\ z=4y+8\\end{aligned}" 13194139534950 true] [17592186321989 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321989 1111 #uuid "65d0729f-4778-51b8-a483-1909ab84edf0" 13194139534950 true] [17592186321990 1034 "{\\begin{aligned}x=-2 \\\\ z=-4y+8\\end{aligned}" 13194139534950 true] [17592186321990 1103 #edb/ref 17592186045453 13194139534950 true] [17592186321990 1111 #uuid "a39aaeb9-f462-5498-b89c-1c8c6a9c061