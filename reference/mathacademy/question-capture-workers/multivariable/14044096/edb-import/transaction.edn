[{:db/id [:question/math-academy-id "q-36216"] :question/problem "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $y=3.$ Given that the point $P(2,3,9)$ lies on $C$, and that ${f}_{x}=6x-y$, find the slope of the tangent to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $y=3.$ Hence, the slope of the tangent to the curve $C$ at the point $P(2,3,9)$ will be given by the partial derivative ${f}_{x}(2,3).$\n\nTo get the slope, we evaluate the partial derivative ${f}_{x}(x,y)$ at $(2,3):$\n\n$$\n\\begin{aligned}{f}_{x}(2,3) & =6(2)-(3)=9\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-71198/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "7361735c-97e0-5615-b0c6-3793c9609d0a" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-71198/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "f64cf730-beaf-5858-a45c-16cd6bc80fb9" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-71198/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "03c59a88-c6f7-5794-88ea-8e1dca5385fd" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-71198/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "f4b3a63c-6270-52af-92fe-374dadfaa588" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-71198/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4c30d2a9-e439-5868-bf6a-f0943eccad48" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-71198/selection" :answer-field/id #uuid "53f6c136-16f6-5d6c-9327-383bceb91c49" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71198/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-71198/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-71198/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-71198/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-71198/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-71198/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-71198" :question/id #uuid "96ad954b-f367-5bd0-b4a5-cf923aa1850c" :question/math-academy-id "q-71198" :question/problem "A surface $S$ is defined by $z=f(x,y).$ The curve $C$ is the intersection of $S$ with the plane $x=2.$ Given that the point $P$ with $y$-coordinate $1$ lies on $C$, and that ${f}_{y}=3{x}^{2}y-6x{y}^{2}$, find the slope of the tangent to $C$ at $P.$" :question/worked-solution "The curve $C$ is the intersection of the surface $z=f(x,y)$ with the plane $x=2.$ Hence, the slope of the tangent to the curve $C$ at the point where $y=1$ will be given by the partial derivative ${f}_{y}(2,1).$ \n\nTo get the slope, we evaluate the partial derivative ${f}_{y}(x,y)$ at $(2,1):$ \n\n$$\n\\begin{aligned}{f}_{y}(2,1) & =3(2)^{2}(1)-6(2)(1)^{2} \\\\  & =12-12 \\\\  & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71198/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "049e8586-8348-50be-ac56-4ea79eba43cd"] :knowledge-point/questions ["q-71198"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132584/selection/ff16debe2c52c52798c1b8f366097bf68d5a8128d81287fb321943f2d7fb9368" :answer/id #uuid "6a56d749-783e-5b37-bbd4-ea8ffd9368dd" :answer/type :answer.type/math :answer/value "\\frac{15}{6}" :db/ensure [:answer/validate]} {:db/