0c39ad20f7f9142" "q-163078/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-163078" :question/id #uuid "aec3f0d4-dfe4-5092-884c-654f878a0c93" :question/math-academy-id "q-163078" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)={x}^{2}+xy,\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$\n\nIf the tangent to $f$ at $a=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ is given by\n\n$$\nz-∗=[\\begin{aligned}∗ & ∗\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-2 \\\\ 1\\end{aligned}])\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}+xy)=2x+y,\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}+xy)=x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}2x+y & x\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}-2 \\\\ 1\\end{aligned}],$ we have\n\n$$\nf(a)=2,\\,{f}^{′}(a)=[\\begin{aligned}-3 & -2\\end{aligned}].\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-2=[\\begin{aligned}-3 & -2\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}-2 \\\\ 1\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n2+(-3)+(-2)=-3.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163078/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7"] :knowledge-point/questions ["q-163078"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163091/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "9c18b2c2-4ab2-522f-85d8-40c838846109" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-163091/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "50a46d89-bfb7-5b3c-83c4-25c4cb9a84a2" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-163091/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "daaf09e6-ab01-5583-8cba-0a2fd9a25407" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-163091/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "3b7e11fa-11b2-59e1-8954-052354500304" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-163091/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "ea6aa0ef-7827-5bc9-8685-800a4d5ebb6c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-163091/selection" :answer-field/id #uuid "1b99d46a-57ce-5f0b-8e97-0167b64a7490" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163091/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-163091/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-163091/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-163091/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-163091/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-163091/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-163091" :question/id #uuid "783dd4bf-2bc5-51d9-add7-0b01d999695d" :question/math-academy-id "q-163091" :question/problem "Consider the transformation $f:{R}^{2}\\to {R}^{2},$ defined as\n\n$$\nf(x)=[\\begin{aligned}{x}_{2}{e}^{{x}_{1}} \\\\ 3{x}_{1}+2{x}_{2}\\end{aligned}],\\,x=[\\begin{aligned}{x}_{1} \\\\ {x}_{2}\\end{aligned}].\n$$\n\nIf the linear approximation of $f$ at  $a=[\\begin{aligned}0 \\\\ 1\\end{aligned}]$ is given by\n\n$$\nf(x)≈[\\begin{aligned}∗ \\\\ 2\\end{aligned}]+[\\begin{aligned}1 & ∗ \\\\ ∗ & 2\\end{aligned}](x-[\\begin{aligned}0 \\\\ 1\\end{aligned}]),\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}({x}_{2}{e}^{{x}_{1}})={x}_{2}{e}^{{x}_{1}},\\, & \\frac{∂{f}_{1}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}({x}_{2}{e}^{{x}_{1}})={e}^{{x}_{1}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & =\\frac{∂}{∂{x}_{1}}(3{x}_{1}+2{x}_{2})=3,\\, & \\frac{∂{f}_{2}}{∂{x}_{2}} & =\\frac{∂}{∂{x}_{2}}(3{x}_{1}+2{x}_{2})=2\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}{x}_{2}{e}^{{x}_{1}} & {e}^{{x}_{1}} \\\\ 3 & 2\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}0 \\\\ 1\\end{aligned}],$ we have\n\n$$\nf(a)=[\\begin{aligned}1 \\\\ 2\\end{aligned}],\\,{f}^{′}(a)=[\\begin{aligned}1 & 1 \\\\ 3 & 2\\end{aligned}].\n$$\n\nThe linear approximation of $f$ at $x=a$ is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nf(x)≈[\\begin{aligned}1 \\\\ 2\\end{aligned}]+[\\begin{aligned}1 & 1 \\\\ 3 & 2\\end{aligned}](x-[\\begin{aligned}0 \\\\ 1\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n1+1+3=5.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-163091/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9f09fc28-bdce-554f-98f5-019d34542a13"] :knowledge-point/questions ["q-163091"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163093/selection/ae1233ab7ddcc6e0e52e175ee82d22db190d6ba5f685af54bb9d45644dce474a" :answer/id 