{x} & \\frac{1}{y} \\\\ -\\frac{y}{{x}^{2}} & \\frac{1}{x}\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163110/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64"] :knowledge-point/questions ["q-163110"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163112/selection/0c509fb242b41fc4d6ddd3ab4aae169a12c2070d3a568540845e66d798f38b44" :answer/id #uuid "c68bfb0e-1744-5182-8e2b-0c71a77673f7" :answer/type :answer.type/text :answer/value "$x+2y,\\,$ $y,\\,$ and $\\frac{1}{x}$" :db/ensure [:answer/validate]} {:db/id "q-163112/selection/7ce481aced60a8f5f42e9101c62eb64d56d07b316e2c0fe65370aac406dc108a" :answer/id #uuid "9c6c0c9d-0d28-50cf-bdad-07b26be6ce9e" :answer/type :answer.type/text :answer/value "$x,\\,$ $x,\\,$ and $\\frac{1}{x}$" :db/ensure [:answer/validate]} {:db/id "q-163112/selection/5ce43b15aa70e9d714cdd7dd2aaee45265b67e4c1a176c23963d48a83c6bfe3c" :answer/id #uuid "f534e1c1-3b85-5db9-8f01-2716b9f0712f" :answer/type :answer.type/text :answer/value "$x+2y,\\,$ $x,\\,$ and $\\frac{1}{{x}^{2}}$" :db/ensure [:answer/validate]} {:db/id "q-163112/selection/901faef7b359e6c860ec3b27cea15a4631bc105bc034ce7f46f0acf88058c797" :answer/id #uuid "5e62682b-140d-5e73-86b7-1f637bb63bb0" :answer/type :answer.type/text :answer/value "$x+2y,\\,$ $x,\\,$ and $\\frac{1}{x}$" :db/ensure [:answer/validate]} {:db/id "q-163112/selection/2488f48baa6ee4997ea5fb53017dd737431f4f6747fa19a65209fccd66552141" :answer/id #uuid "7fa59c9f-3c3c-5a2a-9b74-e31cc3bf2428" :answer/type :answer.type/text :answer/value "$x,\\,$ $y,\\,$ and $\\frac{1}{{x}^{2}}$" :db/ensure [:answer/validate]} {:db/id "q-163112/selection" :answer-field/id #uuid "b9e5c214-0d67-5be0-98ea-63aedcf515da" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163112/selection/901faef7b359e6c860ec3b27cea15a4631bc105bc034ce7f46f0acf88058c797" :answer-field/choices ["q-163112/selection/0c509fb242b41fc4d6ddd3ab4aae169a12c2070d3a568540845e66d798f38b44" "q-163112/selection/7ce481aced60a8f5f42e9101c62eb64d56d07b316e2c0fe65370aac406dc108a" "q-163112/selection/5ce43b15aa70e9d714cdd7dd2aaee45265b67e4c1a176c23963d48a83c6bfe3c" "q-163112/selection/901faef7b359e6c860ec3b27cea15a4631bc105bc034ce7f46f0acf88058c797" "q-163112/selection/2488f48baa6ee4997ea5fb53017dd737431f4f6747fa19a65209fccd66552141"] :db/ensure [:answer-field/validate]} {:db/id "q-163112" :question/id #uuid "38207a04-818a-52aa-b0a5-f930b6a5f009" :question/math-academy-id "q-163112" :question/problem "For the transformation $f:{R}^{2}\\to {R}^{3},$ defined as\n\n$$\nf(x)=[\\begin{aligned}xy+{y}^{2} \\\\ xy \\\\ y+\\operatorname{ln}⁡x\\end{aligned}],\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\nthe total derivative ${f}^{′}$ is given by \n\n$$\n{f}^{′}(x)=[\\begin{aligned}y &  \\\\ y &  \\\\  & 1\\end{aligned}].\n$$\n\nFrom top to bottom, what are the missing entries?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & \\frac{∂{f}_{1}}{∂y} \\\\ \\frac{∂{f}_{2}}{∂x} & \\frac{∂{f}_{2}}{∂y} \\\\ \\frac{∂{f}_{3}}{∂x} & \\frac{∂{f}_{3}}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂{f}_{1}}{∂x} & =\\frac{∂}{∂x}(xy+{y}^{2})=y,\\, & \\frac{∂{f}_{1}}{∂y} & =\\frac{∂}{∂y}(xy+{y}^{2})=x+2y, \\\\ \\frac{∂{f}_{2}}{∂x} & =\\frac{∂}{∂x}(xy)=y,\\, & \\frac{∂{f}_{2}}{∂y} & =\\frac{∂}{∂y}(xy)=x, \\\\ \\frac{∂{f}_{3}}{∂x} & =\\frac{∂}{∂x}(y+\\operatorname{ln}⁡x)=\\frac{1}{x},\\, & \\frac{∂{f}_{3}}{∂y} & =\\frac{∂}{∂y}(y+\\operatorname{ln}⁡x)=1\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}y & x+2y \\\\ y & x \\\\ \\frac{1}{x} & 0\\end{aligned}].\n$$\n\nThus, the missing entries are $x+2y,\\,$ $x,\\,$ and $\\frac{1}{x}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-163112/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6a818e04-786a-56b6-90cf-dcb573ccfa64"] :knowledge-point/questions ["q-163112"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163056/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "488a23d9-e996-5853-9b60-a26335a3fb26" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-163056/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" :answer/id #uuid "4acb09ad-7e95-5421-8566-28fa5a62e51b" :answer/type :answer.type/math :answer/value "-\\pi " :db/ensure [:answer/validate]} {:db/id "q-163056/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "cc12a0fe-6b1a-5189-a97e-08d47f51a53a" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-163056/selection/63079cc748dc757e7a8e5256fd2c9d955e6cf36193b2548b0f6e7b6b72fbf55c" :answer/id #uuid "ab7f96d1-e25a-58f2-abac-a391e964f889" :answer/type :answer.type/math :answer/value "-2\\pi " :db/ensure [:answer/validate]} {:db/id "q-163056/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "ef2c10bd-dbaf-50fb-b8a5-9e39a59de7a9" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-163056/selection" :answer-field/id #uuid "1675867a-833a-5ac7-8580-3880817458ee" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163056/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer-field/choices ["q-163056/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-163056/selection/8642f29c07ed588847b818ca52d7d9b13f60105c8ca35b3f5cb1a649a54ead1c" "q-163056/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-163056/selection/63079cc748dc757e7a8e5256fd2c9d955e6cf36193b2548b0f6e7b6b72fbf55c" "q-163056/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951"] :db/ensure [:answer-field/validate]} {:db/id "q-163056" :question/id #uuid "364bef26-7750-5429-8f55-8f969b2c35ec" :question/math-academy-id "q-163056" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=\\operatorname{sin}⁡(xy),\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$\n\nIf the tangent to $f$ at $a=[\\begin{aligned}0 \\\\ \\pi \\end{aligned}]$ is given by\n\n$$\nz-∗=[\\begin{aligned}∗ & ∗\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}0 \\\\ \\pi \\end{aligned}])\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\operatorname{sin}⁡(xy))=y\\operatorname{cos}⁡(xy),\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xy))=x\\operatorname{cos}⁡(xy)\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}y\\operatorname{cos}⁡(xy) & x\\operatorname{cos}⁡(xy)\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}0 \\\\ \\pi \\end{aligned}],$ we have\n\n$$\nf(a)=0,\\,{f}^{′}(a)=[\\begin{aligned}\\pi  & 0\\end{aligned}].\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-0=[\\begin{aligned}\\pi  & 0\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}0 \\\\ \\pi \\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n0+\\pi +0=\\pi .\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163056/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7"] :knowledge-point/questions ["q-163056"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163076/selection/f003b95a6c7a22f536ec799844670c061a2d01da9486469d5da5d96020e58645" :answer/id #uuid "7b83f53a-bfe9-5fca-a9d6-2edfd9f4b84e" :answer/type :answer.type/math :answer/value "\\frac{{e}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-163076/selection/1cd5fd58f9b21c6e7fc5cc37ab6bd78d21095e67a543f8f7ecacb7f26ab8abf1" :answer/id #uuid "beab36ea-6740-52ff-943a-8b65ef61c0f4" :answer/type :answer.type/math :answer/value "\\frac{7{e}^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-163076/selection/9b517086b6adb65f5e01c90a82a69c7abc55d6e603bf0389c3f275056045d733" :answer/id #uuid "3a434b9b-b217-57c5-bc28-c02328bc35fc" :answer/type :answer.type/math :answer/value "\\frac{7{e}^{2}}{2}" :db/ensure [:answer/validate]} {:db/id "q-163076/selection/2b7e45332736dfe9854e5d802596a3119a38d34c53698b2c4a199ae1a619af06" :answer/id #uuid "d7d6a33f-a487-58b9-a9cb-14a8a552ea3f" :answer/type :answer.type/math :answer/value "\\frac{3{e}^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-163076/selection/0cb4bd2c1989dbaad50a793be449a83c68c9c373730e40da794592fd7ce3a23e" :answer/id #uuid "51cd2c35-18ce-5199-ba6f-165a0c05005d" :answer/type :answer.type/math :answer/value "\\frac{5{e}^{2}}{4}" :db/ensure [:answer/validate]} {:db/id "q-163076/selection" :answer-field/id #uuid "fdf10705-4f15-5698-a7fd-41478a30867b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163076/selection/0cb4bd2c1989dbaad50a793be449a83c68c9c373730e40da794592fd7ce3a23e" :answer-field/choices ["q-163076/selection/f003b95a6c7a22f536ec799844670c061a2d01da9486469d5da5d96020e58645" "q-163076/selection/1cd5fd58f9b21c6e7fc5cc37ab6bd78d21095e67a543f8f7ecacb7f26ab8abf1" "q-163076/selection/9b517086b6adb65f5e01c90a82a69c7abc55d6e603bf0389c3f275056045d733" "q-163076/selection/2b7e45332736dfe9854e5d802596a3119a38d34c53698b2c4a199ae1a619af06" "q-163076/selection/0cb4bd2c1989dbaad50a793be449a83c68c9c373730e40da794592fd7ce3a23e"] :db/ensure [:answer-field/validate]} {:db/id "q-163076" :question/id #uuid "97408f05-561b-583e-b4ea-54fdcf90e2e0" :question/math-academy-id "q-163076" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=\\frac{{e}^{2x}}{y},\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$\n\nIf the tangent to $f$ at $a=[\\begin{aligned}1 \\\\ 2\\end{aligned}]$ is given by\n\n$$\nz-∗=[\\begin{aligned}∗ & ∗\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}1 \\\\ 2\\end{aligned}])\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{{e}^{2x}}{y})=\\frac{2{e}^{2x}}{y},\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{{e}^{2x}}{y})=-\\frac{{e}^{2x}}{{y}^{2}}\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{2{e}^{2x}}{y} & -\\frac{{e}^{2x}}{{y}^{2}}\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}1 \\\\ 2\\end{aligned}],$ we have\n\n$$\nf(a)=\\frac{{e}^{2}}{2},\\,{f}^{′}(a)=[\\begin{aligned}{e}^{2} & -\\frac{{e}^{2}}{4}\\end{aligned}].\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-\\frac{{e}^{2}}{2}=[\\begin{aligned}{e}^{2} & -\\frac{{e}^{2}}{4}\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}1 \\\\ 2\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n\\frac{{e}^{2}}{2}+{e}^{2}+(-\\frac{{e}^{2}}{4})=\\frac{5{e}^{2}}{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163076/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7"] :knowledge-point/questions ["q-163076"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163075/selection/65f0fec56f6a66f8e3ced081771b98aea3b89364635fd715090c02ca19e5be19" :answer/id #uuid "76fcca6f-5297-5be9-8895-6e0f5ac7aba7" :answer/type :answer.type/math :answer/value "2+\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-163075/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "8bbce4e2-f350-5dca-bdd1-7abbe4dd8d9f" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-163075/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "ae29e439-fae1-529b-b39d-151288811af0" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-163075/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "761f45f6-c661-561f-bb69-ba4b618f63b7" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-163075/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "d23856d0-cc6d-57ba-8ad5-96de0beb45f6" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-163075/selection" :answer-field/id #uuid "52a4d14f-4501-5604-b1e6-cb82a74ecf6f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163075/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-163075/selection/65f0fec56f6a66f8e3ced081771b98aea3b89364635fd715090c02ca19e5be19" "q-163075/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-163075/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-163075/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-163075/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c"] :db/ensure [:answer-field/validate]} {:db/id "q-163075" :question/id #uuid "184e02f8-9497-5f94-828d-a4dd30e0b39d" :question/math-academy-id "q-163075" :question/problem "Consider the function $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=y\\operatorname{tan}⁡x,\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}].\n$$\n\nIf the tangent to $f$ at $a=[\\begin{aligned}\\frac{\\pi }{4} \\\\ 2\\end{aligned}]$ is given by\n\n$$\nz-∗=[\\begin{aligned}∗ & ∗\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}\\frac{\\pi }{4} \\\\ 2\\end{aligned}])\n$$\n\nwhat is the sum of the missing values?" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(y\\operatorname{tan}⁡x)=\\frac{y}{{cos}^{2}⁡x},\\, & \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(y\\operatorname{tan}⁡x)=\\operatorname{tan}⁡x\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{y}{{cos}^{2}⁡x} & \\operatorname{tan}⁡x\\end{aligned}].\n$$\n\nEvaluating $f$ and its derivative at $x=a=[\\begin{aligned}\\frac{\\pi }{4} \\\\ 2\\end{aligned}],$ we have\n\n$$\nf(a)=2,\\,{f}^{′}(a)=[\\begin{aligned}4 & 1\\end{aligned}].\n$$\n\nThe tangent to $f$ at $x=a$ is given by\n\n$$\nz-f(a)={f}^{′}(a)(x-a).\n$$\n\nSubstituting $f(a),$ ${f}^{′}(a),$ and $a$ in the equation above, we obtain\n\n$$\nz-2=[\\begin{aligned}4 & 1\\end{aligned}]([\\begin{aligned}x \\\\ y\\end{aligned}]-[\\begin{aligned}\\frac{\\pi }{4} \\\\ 2\\end{aligned}]).\n$$\n\nTherefore, the sum of the missing values is\n\n$$\n2+4+1=7.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163075/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0e90349c-33ae-5b60-9d0d-7542dfebbbc7"] :knowledge-point/questions ["q-163075"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163058/selection/8089ff0e89b352d1d4252d27664b2b0ad210cf12e784fc0133daf776ec5c4856" :answer/id #uuid "c7f1d8da-1683-542e-8149-4d71b7fe1f4d" :answer/type :answer.type/math :answer/value "\\frac{3e+4}{e}" :db/ensure [:answer/validate]} {:db/id "q-163058/selection/a4df2db88e917ea1cb8cbe8975032b689cc04a435fa3967ed2947cc2af989db4" :answer/id #uuid "39b7be7d-65bf-5460-8a27-1f69998b7f45" :answer/type :answer.type/math :answer/value "\\frac{5e+2}{e}" :db/ensure [:answer/validate]} {:db/id "q-163058/selection/2157b7be75f82d97d9270c2b5556b3a43afc66338dfdfec66c2a85c05a3e