ligned}\\operatorname{sin}⁡y & x\\operatorname{cos}⁡y\\end{aligned}].\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-163033/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d912b296-6fd0-57c2-84e8-ca0b56549756"] :knowledge-point/questions ["q-163033"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163046/selection/605c63f9e92eb10127bdea4953fa29dcc94ba8e0bdca7fd8044cde4665ae7eff" :answer/id #uuid "7f88a80a-1e86-5c0f-a77a-528bb6847cc6" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2 & -1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163046/selection/1131476a1955cd16b858c7de6f3946d42daea4f3186d0587255e6bf67488efa0" :answer/id #uuid "3020d3aa-975b-5ed5-84e2-550e19e6e186" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 & 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163046/selection/a301c594d9f400a9fee96f6dbb0c548e893f74930a155a3e2f47fb3fae5e97d8" :answer/id #uuid "07ddfe91-b929-5d44-8cc8-25b095a32bb8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163046/selection/b70163afa80242b6e07599db9e6649592c88c8df8d6892329736a0a5f2ef7d0f" :answer/id #uuid "34ae9f66-f2e8-59ca-b5f7-09163398e965" :answer/type :answer.type/math :answer/value "[\\begin{aligned}-2 \\\\ 1\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163046/selection/f990774d3b842b8007ad12b07afbec6f2f2aa30ad0d66fec9db00fc39ec29e97" :answer/id #uuid "808757ec-fd8a-5720-ae12-375472fd5452" :answer/type :answer.type/math :answer/value "[\\begin{aligned}1 & 2\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163046/selection" :answer-field/id #uuid "c1c7b816-258e-5d1f-b7f9-0bf373101c4a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163046/selection/f990774d3b842b8007ad12b07afbec6f2f2aa30ad0d66fec9db00fc39ec29e97" :answer-field/choices ["q-163046/selection/605c63f9e92eb10127bdea4953fa29dcc94ba8e0bdca7fd8044cde4665ae7eff" "q-163046/selection/1131476a1955cd16b858c7de6f3946d42daea4f3186d0587255e6bf67488efa0" "q-163046/selection/a301c594d9f400a9fee96f6dbb0c548e893f74930a155a3e2f47fb3fae5e97d8" "q-163046/selection/b70163afa80242b6e07599db9e6649592c88c8df8d6892329736a0a5f2ef7d0f" "q-163046/selection/f990774d3b842b8007ad12b07afbec6f2f2aa30ad0d66fec9db00fc39ec29e97"] :db/ensure [:answer-field/validate]} {:db/id "q-163046" :question/id #uuid "2b3bff85-1a01-5938-a4f3-da66675bd3b2" :question/math-academy-id "q-163046" :question/problem "For the transformation $f:{R}^{2}\\to R,$ defined as\n\n$$\nf(x)=\\frac{x}{y},\\,x=[\\begin{aligned}x \\\\ y\\end{aligned}],\n$$\n\ncalculate ${f}^{′}$ at $a=[\\begin{aligned}-2 \\\\ 1\\end{aligned}].$" :question/worked-solution "Suppose a transformation $f:{R}^{n}\\to {R}^{m}$ is defined by \n\n$$\nf:[\\begin{aligned}{x}_{1} \\\\ {x}_{2} \\\\ ⋮ \\\\ {x}_{n}\\end{aligned}]⟶[\\begin{aligned}{f}_{1}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ {f}_{2}({x}_{1},{x}_{2},…,{x}_{n}) \\\\ ⋮ \\\\ {f}_{m}({x}_{1},{x}_{2},…,{x}_{n})\\end{aligned}],\n$$\n\n \n\nwhere ${f}_{1},{f}_{2},…,{f}_{m}$ are scalar functions with $n$ variables. If $f$ is differentiable at $x,$ then the total derivative of $f$ at $x,$ denoted ${f}^{′}(x),$ is given by the $m\\times n$ matrix\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂{f}_{1}}{∂{x}_{1}} & \\frac{∂{f}_{1}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{1}}{∂{x}_{n}} \\\\ \\frac{∂{f}_{2}}{∂{x}_{1}} & \\frac{∂{f}_{2}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{2}}{∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{∂{f}_{m}}{∂{x}_{1}} & \\frac{∂{f}_{m}}{∂{x}_{2}} & ⋯ & \\frac{∂{f}_{m}}{∂{x}_{n}}\\end{aligned}].\n$$\n\nIn our case, we have the following:\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{∂f}{∂x} & \\frac{∂f}{∂y}\\end{aligned}]\n$$\n\nFirst, we compute the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{x}{y})=\\frac{1}{y}, & \\,\\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{x}{y})=-\\frac{x}{{y}^{2}}\\end{aligned}\n$$\n\n \n\nTherefore, we have\n\n$$\n{f}^{′}(x)=[\\begin{aligned}\\frac{1}{y} & -\\frac{x}{{y}^{2}}\\end{aligned}]\n$$\n\nand ${f}^{′}$ at $a=[\\begin{aligned}-2 \\\\ 1\\end{aligned}]$ is\n\n$$\n{f}^{′}(a)=[\\begin{aligned}\\frac{1}{(1)} & -\\frac{(-2)}{(1)^{2}}\\end{aligned}]=[\\begin{aligned}1 & 2\\end{aligned}].\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163046/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d912b296-6fd0-57c2-84e8-ca0b56549756"] :knowledge-point/questions ["q-163046"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163032/selection/f1957ffe3520acc646ac060df8ec73ae2c993adefb8ff541e6bfa8d533fa1839" :answer/id #uuid "8c4622c0-cca7-5d8b-8e19-8d33517e1d97" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4 & -6\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163032/selection/457f1fe1698f84aed1c9bb8963910204cef8f14801ef5f0b4d28f9e162cba125" :answer/id #uuid "2a2a467d-9bdf-5ae9-bb27-429636af45a0" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{x}^{2} & -{y}^{2}\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163032/selection/87199f6acfde7dd453373e879c7a7e383ebfb059614ee2035bb26429250c58f7" :answer/id #uuid "66f3281d-1cc3-5707-be84-675eefaab8a8" :answer/type :answer.type/math :answer/value "[\\begin{aligned}2x \\\\ -3y\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163032/selection/c0493bdcde9ec013884a54ed362503a5dc126b9960a485d0b313f20fe85f173b" :answer/id #uuid "87eb1930-6b43-53c3-8812-9caa11ee4a1d" :answer/type :answer.type/math :answer/value "[\\begin{aligned}4x & -6y\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-163032/selection/a2ce444fa295f8b443b8f664e8e34091fc7671e817e2109c74b1b5d14bb83354" :answer/id #uuid "3434148b-a4e4-5d15-83bd-cc1ed32bdc60" :answer/type :answer.type/math :answer/value "[\\begin{aligned}6y \\\\ -4x\\end{aligned}]" :db/ensure [:answer/validate]} {