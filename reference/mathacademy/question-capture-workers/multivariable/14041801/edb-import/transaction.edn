 correct answer is \"I and III only.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161646/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7adf2c3e-4a73-5098-ab60-790d637728cf"] :knowledge-point/questions ["q-161646"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161641/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "39f6c263-07dd-5a98-bb68-b1e364c04d30" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-161641/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "56c9778b-3bfa-5059-8781-b546a6f1f1ff" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-161641/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "118397e1-8f80-54b7-90c3-06a10a6c51d4" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-161641/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "ba868b25-c9f1-5b0e-a445-2602ec986358" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-161641/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "c0b093e6-8520-5d90-b142-f1714349a5a6" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-161641/selection" :answer-field/id #uuid "1c657feb-f3d1-5f81-a9a5-c7487ebd9c8d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161641/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-161641/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-161641/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-161641/se