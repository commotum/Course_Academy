 boundary points (all the corresponding inequalities are not strict).\n\n- The third set is *open* since it doesn't contain any of its boundary points (all the corresponding inequalities are strict).\n\nTherefore, the correct answer is \"II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041801/state.json" "file_sha256" "141bde0041c39d803449904834c60426f768ff35fb92fd0134dea40f4810e38e"} {"question" "q-161640" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041801/activity-metadata.json" "file_sha256" "51b1934120ab1bd3ae3df4cea8b39ccb912c5b929b335373f21a8f6d5ebd3aab"} {"question" "q-161640" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041801/state.json" "file_sha256" "141bde0041c39d803449904834c60426f768ff35fb92fd0134dea40f4810e38e"} {"question" "q-161640" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and III only"] ["text" "I only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041801/state.json" "file_sha256" "141bde0041c39d803449904834c60426f768ff35fb92fd0134dea40f4810e38e"} {"question" "q-161640" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041801/state.json" "file_sha256" "141bde0041c39d803449904834c60426f768ff35fb92fd0134dea40f4810e38e"} {"question" "q-71808" "field" nil "a