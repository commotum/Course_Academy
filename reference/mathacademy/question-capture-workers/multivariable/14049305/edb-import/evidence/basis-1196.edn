#{[{:db/id #edb/ref 17592186292530 :knowledge-point/_questions [{:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d" :knowledge-point/title "Integrating Using the Squared Sine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5fb867-84a0-50a0-9a9c-8e2598fa2c2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186292532} {:answer/id #uuid "aa21369f-f912-5470-9f8e-ceac06f6007f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292533} {:answer/id #uuid "b0bc822f-c223-51d8-97cd-f81c449ecb4b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292534} {:answer/id #uuid "d6a213ab-528a-5257-a981-5d4f93f8eb90" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186292535} {:answer/id #uuid "43717bd2-a56b-54d5-90f6-df69579bcbf8" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292536}] :answer-field/correct {:answer/id #uuid "aa21369f-f912-5470-9f8e-ceac06f6007f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292533} :answer-field/id #uuid "4712f1c9-fdcc-5d2c-add5-d58b9c384d72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292531}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "693ca81f-04ac-5c71-a591-77513b1a6f9e" :question/math-academy-id "q-74412" :question/problem "$\\int (1-2{sin}^{2}⁡(\\frac{x}{2}))\\text{d}x=$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta \n$$\n\nLetting $\\theta =\\frac{x}{2}$, we have\n\n$$\n1-2{sin}^{2}⁡(\\frac{x}{2})=\\operatorname{cos}⁡x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (1-2{sin}^{2}⁡(\\frac{x}{2}))\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+C.\\end{aligned}\n$$"}]}
