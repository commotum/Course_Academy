#{[{:db/id #edb/ref 17592186322782 :knowledge-point/_questions [{:knowledge-point/id #uuid "b466bd78-724b-51b2-8fee-7991bf7b60d2" :knowledge-point/title "Integrating Using the Squared Cosine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bc92887d-99d9-555e-b40c-0f2a8cfe6088" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}\\operatorname{sin}⁡4x-\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186322784} {:answer/id #uuid "1c854187-c69d-511b-bf1d-22b1420dffb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\operatorname{sin}⁡2x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186322785} {:answer/id #uuid "3b1e5dec-e6c4-5bb1-bf0b-abdcefca5d61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}\\operatorname{sin}⁡4x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186322786} {:answer/id #uuid "b03d6d44-84f1-5dba-9479-2420747d3099" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{4}\\operatorname{sin}⁡4x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186322787} {:answer/id #uuid "cffb20fa-7eba-5d2b-b681-2ebb1ded0c5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}\\operatorname{sin}⁡2x-\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186322788}] :answer-field/correct {:answer/id #uuid "3b1e5dec-e6c4-5bb1-bf0b-abdcefca5d61" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}\\operatorname{sin}⁡4x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C" :db/id #edb/ref 17592186322786} :answer-field/id #uuid "90c95b81-784e-545f-b0aa-64791a51987d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186322783}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "06c70e02-23ad-5443-a5fb-c80cbe357a8a" :question/math-academy-id "q-10457" :question/problem "$\\int (5{cos}^{2}⁡2x-\\frac{{x}^{2}}{2})\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡\\theta $ term, given by\n\n$$\n\\operatorname{cos}⁡2\\theta =2{cos}^{2}⁡\\theta -1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡\\theta =\\frac{1}{2}(\\operatorname{cos}⁡2\\theta +1).\n$$\n\nLetting $\\theta =2x$, we have\n\n$$\n{cos}^{2}⁡2x=\\frac{1}{2}(\\operatorname{cos}⁡4x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (5{cos}^{2}⁡2x-\\frac{{x}^{2}}{2})\\text{d}x & =\\int [5\\cdot \\frac{1}{2}(\\operatorname{cos}⁡4x+1)-\\frac{{x}^{2}}{2}]\\text{d}x \\\\  & =\\int (\\frac{5}{2}\\operatorname{cos}⁡4x+\\frac{5}{2}-\\frac{{x}^{2}}{2})\\text{d}x \\\\  & =\\frac{5}{2}\\cdot \\frac{1}{4}\\operatorname{sin}⁡4x+\\frac{5}{2}x-\\frac{1}{2}\\cdot \\frac{1}{3}{x}^{3}+C \\\\  & =\\frac{5}{8}\\operatorname{sin}⁡4x+\\frac{5x}{2}-\\frac{{x}^{3}}{6}+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186096853 :knowledge-point/_questions [{:knowledge-point/id #uuid "b466bd78-724b-51b2-8fee-7991bf7b60d2" :knowledge-point/title "Integrating Using the Squared Cosine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84c56b68-8f08-5891-b53f-1d3baa3643eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\sin 2x + C" :db/id #edb/ref 17592186093526} {:answer/id #uuid "9ddc041b-2369-5882-a12a-2825791bd6d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin 2x + C" :db/id #edb/ref 17592186093527} {:answer/id #uuid "d2e401ef-669a-5a22-b4a0-51d6303cf1f7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin 2x + C" :db/id #edb/ref 17592186093528} {:answer/id #uuid "58b0af62-bd29-50f6-bca3-a96efe2134d2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{2}\\sin 2x + C" :db/id #edb/ref 17592186093529} {:answer/id #uuid "7f1fdf02-955e-59ae-9a2b-e0d80c3dce04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}\\cos 2x + C" :db/id #edb/ref 17592186093530}] :answer-field/correct {:answer/id #uuid "9ddc041b-2369-5882-a12a-2825791bd6d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin 2x + C" :db/id #edb/ref 17592186093527} :answer-field/id #uuid "f1bcf21f-b8ff-566d-8758-5cc409bff287" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186093525}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6b22a8cc-4bee-5afb-9668-7a994a70948e" :question/math-academy-id "q-10559" :question/problem "Calculate\n$\\int (4{cos}^{2}⁡x-2)\\,\\text{d}x.$" :question/worked-solution "Here, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡x$ term, given by\n\n$$\n\\operatorname{cos}⁡2x=2{cos}^{2}⁡x-1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡x=\\frac{1}{2}(\\operatorname{cos}⁡2x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (4{cos}^{2}⁡x-2)\\,\\text{d}x & =\\int (4(\\frac{1}{2}(\\operatorname{cos}⁡2x+1))-2)\\,\\text{d}x \\\\  & =\\int (2\\operatorname{cos}⁡2x+2-2)\\,\\text{d}x \\\\  & =\\int 2\\operatorname{cos}⁡2x\\,\\text{d}x \\\\  & =2(\\frac{1}{2}\\operatorname{sin}⁡2x)+C \\\\  & =\\operatorname{sin}⁡2x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186309038 :knowledge-point/_questions [{:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d" :knowledge-point/title "Integrating Using the Squared Sine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "842161b7-0cab-5ebd-a4ed-0ffcd0c29574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi^2}{2}" :db/id #edb/ref 17592186309040}] :answer-field/correct {:answer/id #uuid "842161b7-0cab-5ebd-a4ed-0ffcd0c29574" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3\\pi^2}{2}" :db/id #edb/ref 17592186309040} :answer-field/id #uuid "ea492ab3-cc2a-5743-9b68-03b6b0b54dc4" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186309039}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "af9f658c-f88f-52fc-86e4-26004d3557fd" :question/math-academy-id "q-348852" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{\\pi }^{2\\pi }[6{sin}^{2}\\,(\\frac{x}{4})-3+3cos\\,(\\frac{x}{2})+x]\\,\\text{d}x=$  \n{{field-1}}" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta \n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )={sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =\\frac{x}{4},$ we have\n\n$$\n6{sin}^{2}\\,(\\frac{x}{4})=3(1-cos\\,(\\frac{x}{2})).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}{\\int }_{\\pi }^{2\\pi }\\,\\,[6{sin}^{2}\\,(\\frac{x}{4})-3+3cos\\,(\\frac{x}{2})+x]dx & ={\\int }_{\\pi }^{2\\pi }\\,\\,[3-3cos\\,(\\frac{x}{2})-3+3cos\\,(\\frac{x}{2})+x]dx \\\\  & ={\\int }_{\\pi }^{2\\pi }x\\,dx \\\\  & ={\\frac{{x}^{2}}{2}|}_{\\pi }^{2\\pi } \\\\  & =\\frac{(2\\pi )^{2}-{\\pi }^{2}}{2} \\\\  & =\\frac{3{\\pi }^{2}}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186327581 :knowledge-point/_questions [{:knowledge-point/id #uuid "064d3c62-5cfc-502b-aba4-48e40042593f" :knowledge-point/title "Integrating Expressions Using the Double-Angle Formula for Cosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "297647da-3ab3-5dcc-9a0f-48a9dc1e495f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327583} {:answer/id #uuid "ae3104d2-922a-56ba-ad75-57e2cb7a3a3c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{3}" :db/id #edb/ref 17592186327584} {:answer/id #uuid "d2af47ef-76c7-5f0b-8538-94f85021dbeb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186327585} {:answer/id #uuid "d65d5927-bfb8-5799-9a36-4be823721147" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186327586} {:answer/id #uuid "5984ac9f-2835-5f33-a158-60355d52e40e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186327587}] :answer-field/correct {:answer/id #uuid "297647da-3ab3-5dcc-9a0f-48a9dc1e495f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186327583} :answer-field/id #uuid "20bf7902-d8bf-522c-b9ef-2ee403332062" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186327582}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d3c3918e-b0d8-54bc-84f9-50f26c7e5758" :question/math-academy-id "q-51126" :question/problem "${\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x=$" :question/worked-solution "Here, we use the double-angle formula for cosine:\n\n$$\n\\operatorname{cos}⁡2\\theta ={cos}^{2}⁡\\theta -{sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =2x,$ we get\n\n$$\n\\operatorname{cos}⁡4x={cos}^{2}⁡2x-{sin}^{2}⁡2x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /24}({cos}^{2}⁡2x-{sin}^{2}⁡2x)\\text{d}x & ={\\int }_{0}^{\\pi /24}\\operatorname{cos}⁡4x\\,\\text{d}x \\\\  & =\\frac{\\operatorname{sin}⁡4x}{4}{|}_{0}^{\\pi /24} \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(4\\cdot \\frac{\\pi }{24})-\\operatorname{sin}⁡(4\\cdot 0)] \\\\  & =\\frac{1}{4}[\\operatorname{sin}⁡(\\frac{\\pi }{6})-\\operatorname{sin}⁡0] \\\\  & =\\frac{1}{4}(\\frac{1}{2}-0) \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186292530 :knowledge-point/_questions [{:knowledge-point/id #uuid "31f3ead1-2549-5b61-baf9-0437ba28f09d" :knowledge-point/title "Integrating Using the Squared Sine Variant of the Cosine Double-Angle Formula"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3a5fb867-84a0-50a0-9a9c-8e2598fa2c2d" :answer/type {:db/ident :answer.type/math} :answer/value "-\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186292532} {:answer/id #uuid "aa21369f-f912-5470-9f8e-ceac06f6007f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292533} {:answer/id #uuid "b0bc822f-c223-51d8-97cd-f81c449ecb4b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292534} {:answer/id #uuid "d6a213ab-528a-5257-a981-5d4f93f8eb90" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{cos}⁡x+C" :db/id #edb/ref 17592186292535} {:answer/id #uuid "43717bd2-a56b-54d5-90f6-df69579bcbf8" :answer/type {:db/ident :answer.type/math} :answer/value "-2\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292536}] :answer-field/correct {:answer/id #uuid "aa21369f-f912-5470-9f8e-ceac06f6007f" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{sin}⁡x+C" :db/id #edb/ref 17592186292533} :answer-field/id #uuid "4712f1c9-fdcc-5d2c-add5-d58b9c384d72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186292531}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "693ca81f-04ac-5c71-a591-77513b1a6f9e" :question/math-academy-id "q-74412" :question/problem "$\\int (1-2{sin}^{2}⁡(\\frac{x}{2}))\\text{d}x=$" :question/worked-solution "Let's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta \n$$\n\nLetting $\\theta =\\frac{x}{2}$, we have\n\n$$\n1-2{sin}^{2}⁡(\\frac{x}{2})=\\operatorname{cos}⁡x.\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}\\int (1-2{sin}^{2}⁡(\\frac{x}{2}))\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x+C.\\end{aligned}\n$$"}]}
