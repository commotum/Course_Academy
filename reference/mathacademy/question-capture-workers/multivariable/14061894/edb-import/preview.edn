\theta ){[\\frac{{r}^{4}}{4}]}_{0}^{4}\\,\\text{d}\\theta  \\\\  & =-64{\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =-64{[\\frac{\\operatorname{sin}⁡(2\\theta )}{2}]}_{0}^{\\pi /3} \\\\  & =-32[\\operatorname{sin}⁡(\\frac{2\\pi }{3})-\\operatorname{sin}⁡0] \\\\  & =-16\\sqrt{3}.\\end{aligned}\n$$" 13194139535298 true] [17592186342489 1000 #edb/ref 17592186342490 13194139535298 true] [17592186342489 1000 #edb/ref 17592186342491 13194139535298 true] [17592186342489 1000 #edb/ref 17592186342492 13194139535298 true] [17592186342489 1000 #edb/ref 17592186342493 13194139535298 true] [17592186342489 1000 #edb/ref 17592186342494 13194139535298 true] [17592186342489 1040 #edb/ref 17592186045450 13194139535298 true] [17592186342489 1041 "selection" 13194139535298 true] [17592186342489 1104 #edb/ref 17592186342490 13194139535298 true] [17592186342489 1110 #uuid "dcf96b01-5677-5eaf-a66d-a6e0b1e823d5" 13194139535298 true] [17592186342490 1034 "-16\\sqrt{3}" 13194139535298 true] [17592186342490 1103 #edb/ref 17592186045453 13194139535298 true] [17592186342490 1111 #uuid "51c04dd4-7c9d-5265-bf2f-ba760a60b8c0" 13194139535298 true] [17592186342491 1034 "8\\pi " 13194139535298 true] [17592186342491 1103 #edb/ref 17592186045453 13194139535298 true] [17592186342491 1111 #uuid "88995523-c7ec-54cc-af8a-bb3f24a7a410" 13194139535298 true] [17592186342492 1034 "-\\frac{8\\pi }{3}" 13194139535298 true] [17592186342492 1103 #edb/ref 17592186045453 13194139535298 true] [17592186342492 1111 #uuid "fa868bc6-df23-5353-af0d-4edeaf898840" 13194139535298 true] [17592186342493 1034 "8\\sqrt{3}" 13194139535298 true] [17592186342493 1103 #edb/ref 17592186045453 13194139535298 true] [17592186342493 1111 #uuid "d23ffd1f-36f2-58ae-bbaa-6c118dba6a88" 13194139535298 true] [17592186342494 1034 "\\frac{\\sqrt{3}}{2}" 13194139535298 true] [17592186342494 1103 #edb/ref 17592186045453 13194139535298 true] [17592186342494 1111 #uuid "2c6fd020-f57e-5402-ae86-beb2a7374a04" 13194