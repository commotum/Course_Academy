#{[{:db/id #edb/ref 17592186083851 :knowledge-point/_questions [{:knowledge-point/id #uuid "55f783c4-25d6-5855-877e-31bed16b12c4" :knowledge-point/title "Identifying a Possible Curve Given Its Arc Length As an Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88a1b1e6-87cf-5f0e-89e3-cea5b1fadb89" :answer/type {:db/ident :answer.type/math} :answer/value "y = \\frac{4x^{3}}{3} - 2x^{2} + x" :db/id #edb/ref 17592186082473} {:answer/id #uuid "ba201ae1-3784-5f25-b538-a3db1c7fd099" :answer/type {:db/ident :answer.type/math} :answer/value "y = 2x - 1" :db/id #edb/ref 17592186082474} {:answer/id #uuid "f883ee93-d216-5bdf-9ce7-a5943782e6b5" :answer/type {:db/ident :answer.type/math} :answer/value "y = x^{2} - 4" :db/id #edb/ref 17592186082475} {:answer/id #uuid "f9187eac-d0d4-5321-8870-9cbe1376088d" :answer/type {:db/ident :answer.type/math} :answer/value "y = x^{2} - x + 4" :db/id #edb/ref 17592186082476} {:answer/id #uuid "74f5f5fe-3fd4-5fcb-81a6-e26c31bad4ff" :answer/type {:db/ident :answer.type/math} :answer/value "y = x - 2" :db/id #edb/ref 17592186082477}] :answer-field/correct {:answer/id #uuid "f9187eac-d0d4-5321-8870-9cbe1376088d" :answer/type {:db/ident :answer.type/math} :answer/value "y = x^{2} - x + 4" :db/id #edb/ref 17592186082476} :answer-field/id #uuid "80edbeb1-18ba-5dd9-9b3f-f1d655ee4147" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186082472}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ab3de3f1-6311-5aac-86d4-b283aa079450" :question/math-academy-id "q-82624" :question/problem "The length of a curve $y=f(x)$ is given by ${\\int }_{0}^{1}\\sqrt{2+4{x}^{2}-4x}\\,\\text{d}x.$ Which of the following could be  an equation for this curve?" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nWe're given that \n\n$$\nL={\\int }_{0}^{1}\\sqrt{2+4{x}^{2}-4x}\\,\\text{d}x.\n$$\n\nComparing the above with the arc length formula, we see that we must have\n\n$$\n[{f}^{′}(x)]^{2}=4{x}^{2}-4x+1=(2x-1)^{2}\\,⟹\\,{f}^{′}(x)=\\pm (2x-1).\n$$\n\nIntegrating the above equation with respect to $x,$ we get\n\n$$\n\\begin{aligned}f(x) & =\\pm \\int (2x-1)\\text{ d}x \\\\  & =\\pm ({x}^{2}-x)+C.\\end{aligned}\n$$\n\nFrom the given options, the only one that has the required form is $y={x}^{2}-x+4.$"}]}
