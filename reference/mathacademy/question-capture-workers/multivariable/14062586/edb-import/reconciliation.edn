{sin}⁡(2t)\\,\\text{d}t \\\\  & =-3\\operatorname{cos}⁡(2t)\\,{|}_{0}^{\\pi /4} \\\\  & =-3\\operatorname{cos}⁡(\\frac{\\pi }{2})+3\\operatorname{cos}⁡0 \\\\  & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062586/state.json" "file_sha256" "ae15b2efdde2217aa39750eaee9b3f07fa5b293e652a5f6785073390c75e0159"} {"question" "q-351439" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062586/activity-metadata.json" "file_sha256" "3cfb54ba431bdbe5d2817c0777f24df26b9a0580b1a48e193ae845a0f0f1beb5"} {"question" "q-351439" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062586/state.json" "file_sha256" "ae15b2efdde2217aa39750eaee9b3f07fa5b293e652a5f6785073390c75e0159"} {"question" "q-351439" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062586/state.json" "file_sha256" "ae15b2efdde2217aa39750eaee9b3f07fa5b293e652a5f6785073390c75e0159"}] "usage" {"q-20909" [] "q-21353" [] "q-351439" []} "basis" 2005 "retractions" [[17592186293067 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14031229/assets/59704c6b8e643337113ab99b22eaeaac8d59ac3c15042409e8a0a8eac6ee54fd.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\frac{t}{2},\\,y={e}^{t}$\nfrom $t=0$ to $t=1$ (shown above)?"] [17592186293074 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-c