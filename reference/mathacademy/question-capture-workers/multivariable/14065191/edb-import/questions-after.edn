#{[{:db/id #edb/ref 17592186291452 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b96b734-9778-5f3a-9406-b441eed1a2ff" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-8)" :db/id #edb/ref 17592186291454} {:answer/id #uuid "f7243bdd-da61-53d8-9fdf-6550a9a4956d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186291455} {:answer/id #uuid "22500518-dbc9-5d10-b1e7-af4132b358f7" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-3)" :db/id #edb/ref 17592186291456} {:answer/id #uuid "5fb9c3fb-4a4d-55dc-91e8-03112b783e23" :answer/type {:db/ident :answer.type/math} :answer/value "(8,1)" :db/id #edb/ref 17592186291457} {:answer/id #uuid "536aca86-44fe-5155-ac2f-77cba43e221e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186291458}] :answer-field/correct {:answer/id #uuid "536aca86-44fe-5155-ac2f-77cba43e221e" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186291458} :answer-field/id #uuid "81d07959-e956-51ce-aa74-bb12d49d2b2b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291453}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "722699b4-1a0d-5686-9e7d-fcb338d56349" :question/math-academy-id "q-116107" :question/problem "What is the center of the hyperbola \n${x}^{2}-8{y}^{2}+6x+48y=71?$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{x}^{2}-8{y}^{2}+6x+48y & =71 \\\\ {x}^{2}+6x-8{y}^{2}+48y & =71 \\\\ [{x}^{2}+6x]-8[{y}^{2}-6y] & =71 \\\\ [(x+3)^{2}-9]-8[(y-3)^{2}-9] & =71 \\\\ (x+3)^{2}-9-8(y-3)^{2}+72 & =71 \\\\ (x+3)^{2}-8(y-3)^{2} & =8 \\\\ \\frac{(x+3)^{2}}{8}-(y-3)^{2} & =1 \\\\ \\frac{(x-(-3))^{2}}{(\\sqrt{8})^{2}}-\\frac{(y-3)^{2}}{{1}^{2}} & =1.\\end{aligned}\n$$\n\nTherefore, the center is $(-3,3).$"}] [{:db/id #edb/ref 17592186291459 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "92e10102-652a-56cb-a323-851ea8386c36" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-2)" :db/id #edb/ref 17592186291461} {:answer/id #uuid "c7d46d12-c266-57bf-8dd4-0b9c17ef2acc" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-1)" :db/id #edb/ref 17592186291462} {:answer/id #uuid "aebf3980-7bf1-51bd-97cf-eb2ce5416ceb" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,-2)" :db/id #edb/ref 17592186291463} {:answer/id #uuid "21452f5d-7465-5a0b-9826-bd1db4e27c8d" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,1)" :db/id #edb/ref 17592186291464} {:answer/id #uuid "4e1d26ba-c1e0-5946-a87c-815dd13da346" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186291465}] :answer-field/correct {:answer/id #uuid "92e10102-652a-56cb-a323-851ea8386c36" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-2)" :db/id #edb/ref 17592186291461} :answer-field/id #uuid "5897fe61-a0af-5a77-8b7d-4905ee537069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186291460}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "3974ad26-6b81-5dc3-9e33-03508cd607dc" :question/math-academy-id "q-16380" :question/problem "What is the center of the hyperbola \n$-10{x}^{2}+9{y}^{2}+20x+36y=64?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}-10{x}^{2}+9{y}^{2}+20x+36y & =64 \\\\ 9{y}^{2}+36y-10{x}^{2}+20x & =64 \\\\ 9[{y}^{2}+4y]-10[{x}^{2}-2x] & =64 \\\\ 9[(y+2)^{2}-4]-10[(x-1)^{2}-1] & =64 \\\\ 9(y+2)^{2}-36-10(x-1)^{2}+10 & =64 \\\\ 9(y+2)^{2}-10(x-1)^{2} & =64+36-10 \\\\ 9(y+2)^{2}-10(x-1)^{2} & =90 \\\\ \\frac{(y+2)^{2}}{10}-\\frac{(x-1)^{2}}{9} & =1.\\end{aligned}\n$$\n\nHence, the center is $(1,-2).$"}] [{:db/id #edb/ref 17592186349938 :knowledge-point/_questions [{:knowledge-point/id #uuid "223e29c9-1bb5-51ee-9ec8-4d5c15363951" :knowledge-point/title "Finding the Center of a Horizontal Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0748a8a7-5c3c-55dd-85f1-1a326b47bfb4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349940} {:answer/id #uuid "63d67eef-27b8-5ec1-b18a-5d8d25c5cd5c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186349941}] :answer-field/correct {:answer/id #uuid "0748a8a7-5c3c-55dd-85f1-1a326b47bfb4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349940} :answer-field/id #uuid "8d02687d-6773-549a-873d-34092974de96" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349939} {:answer-field/choices [{:answer/id #uuid "b9ebc2c8-4a38-508b-a7f0-ca9d2bf3d908" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349943}] :answer-field/correct {:answer/id #uuid "b9ebc2c8-4a38-508b-a7f0-ca9d2bf3d908" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186349943} :answer-field/id #uuid "eb9296ac-805f-5afc-86cf-6833ac07a5b9" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349942}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "25aaf0a3-1775-57b0-bf67-4610b7f14f89" :question/math-academy-id "q-328353" :question/problem "The center of the hyperbola $3{x}^{2}-4{y}^{2}-12x+16y=28$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a horizontal hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}-\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-4{y}^{2}-12x+16y & =28 \\\\ 3{x}^{2}-12x-4{y}^{2}+16y & =28 \\\\ 3[{x}^{2}-4x]-4[{y}^{2}-4y] & =28 \\\\ 3[(x-2)^{2}-4]-4[(y-2)^{2}-4] & =28 \\\\ 3(x-2)^{2}-12-4(y-2)^{2}+16 & =28 \\\\ 3(x-2)^{2}-4(y-2)^{2} & =28+12-16 \\\\ 3(x-2)^{2}-4(y-2)^{2} & =24 \\\\ \\frac{(x-2)^{2}}{8}-\\frac{(y-2)^{2}}{6} & =1 \\\\ \\frac{(x-2)^{2}}{(\\sqrt{8})^{2}}-\\frac{(y-2)^{2}}{(\\sqrt{6})^{2}} & =1.\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,2,2\\,).$"}] [{:db/id #edb/ref 17592186349944 :knowledge-point/_questions [{:knowledge-point/id #uuid "345d6df7-2ada-5c2e-8146-7c779afae3af" :knowledge-point/title "Finding the Center of a Vertical Hyperbola Given an Equation in Expanded Form"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6da97c55-c72c-5da2-b8b9-0c405517239d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349946}] :answer-field/correct {:answer/id #uuid "6da97c55-c72c-5da2-b8b9-0c405517239d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186349946} :answer-field/id #uuid "d309196f-6522-57bf-a0da-99e3698af87c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349945} {:answer-field/choices [{:answer/id #uuid "d54d0aed-fc02-5315-b529-b75c6db6c4b0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186349948}] :answer-field/correct {:answer/id #uuid "d54d0aed-fc02-5315-b529-b75c6db6c4b0" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186349948} :answer-field/id #uuid "85da2834-3da0-5c39-ba57-d19dc0b800b7" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186349947}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2e40da79-2484-51fc-9da4-6b12184cc73b" :question/math-academy-id "q-328402" :question/problem "The center of the hyperbola ${y}^{2}-4{x}^{2}+40x=136$ is$\\,\\,($\n{{field-1}}$,$\n{{field-2}}\n$).$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nTo rewrite the equation of the hyperbola in the above form, we need to group $x$ and $y$ terms and complete the squares, as follows:\n\n$$\n\\begin{aligned}{y}^{2}-4{x}^{2}+40x & =136 \\\\ {y}^{2}\\,-\\,4{x}^{2}+40x & =136 \\\\ {y}^{2}\\,-\\,4[{x}^{2}-10x] & =136 \\\\ {y}^{2}\\,-\\,4\\,[(x-5)^{2}-25] & =136 \\\\ {y}^{2}-4(x-5)^{2}+100 & =136 \\\\ {y}^{2}-4(x-5)^{2} & =36 \\\\ \\frac{(y-0)^{2}}{36}-\\frac{(x-5)^{2}}{9} & =1\\end{aligned}\n$$\n\nHence, the center of the hyperbola is $(\\,5,0\\,).$"}] [{:db/id #edb/ref 17592186349949 :knowledge-point/_questions [{:knowledge-point/id #uuid "cdab0134-e416-51cf-89fa-73ad4a2c2eb9" :knowledge-point/title "Finding the Center of a Vertical Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "be6c6d07-e6ca-545d-ba51-9c877913bde2" :answer/type {:db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186349951} {:answer/id #uuid "58f77c07-d81e-5267-9676-7b70c63b8879" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186349952} {:answer/id #uuid "5eb74883-1a5f-59ad-9e31-3a769a71838f" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186349953} {:answer/id #uuid "0fa6f1e3-1894-50e8-961b-a65777967cd9" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186349954} {:answer/id #uuid "8f9bcea8-4262-5996-9a1a-7abac1bcb886" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186349955}] :answer-field/correct {:answer/id #uuid "58f77c07-d81e-5267-9676-7b70c63b8879" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186349952} :answer-field/id #uuid "7fbd26b0-ab7c-55c7-9ba7-43b87ef68461" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186349950}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b7f6d0d9-2bf6-592a-a237-cd0a8ecb2415" :question/math-academy-id "q-78358" :question/problem "What is the center of the hyperbola $\\frac{(y+2)^{2}}{7}-\\frac{(x-3)^{2}}{4}=1?$" :question/worked-solution "The equation of a vertical hyperbola centered at $(h,k)$ is given by\n\n$$\n\\frac{(y-k)^{2}}{{a}^{2}}-\\frac{(x-h)^{2}}{{b}^{2}}=1.\n$$\n\nNote that the given equation can be rewritten as follows:\n\n$$\n\\frac{(y-(-2))^{2}}{7}-\\frac{(x-3)^{2}}{4}=1\n$$\n\nIn this case, we have $h=3$ and $k=-2.$\n\nTherefore, the center of the hyperbola is $(3,-2).$"}]}
