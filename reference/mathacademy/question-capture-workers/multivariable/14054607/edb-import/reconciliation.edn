{x}^{2}+y}}{y+1}\\,dA & ={\\int }_{-1}^{0}{\\int }_{2{x}^{2}}^{4x+6}\\frac{\\sqrt{{x}^{2}+y}}{y+1}\\,dy\\,dx\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054607/state.json" "file_sha256" "70dfc2d3901190177f89e5518ec1fd1e8ae9dad5f3a3be9f25ff404feb7c8814"} {"question" "q-81329" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054607/activity-metadata.json" "file_sha256" "6fc39514b7819b896c748a22fda886a33b909726f8e049309dbb73bddc29d37f"} {"question" "q-81329" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054607/state.json" "file_sha256" "70dfc2d3901190177f89e5518ec1fd1e8ae9dad5f3a3be9f25ff404feb7c8814"} {"question" "q-81329" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\int }_{-1}^{0}{\\int }_{2{x}^{2}}^{4x+6}\\frac{\\sqrt{{x}^{2}+y}}{y+1}\\,dy\\,dx"] ["math" "{\\int }_{-1}^{0}{\\int }_{4x+6}^{2{x}^{2}}\\frac{\\sqrt{{x}^{2}+y}}{y+1}\\,dy\\,dx"] ["math" "{\\int }_{2{x}^{2}}^{0}{\\int }_{-1}^{4x+6}\\frac{\\sqrt{{x}^{2}+y}}{y+1}\\,dy\\,dx"] ["math" "{\\int }_{2{x}^{2}}^{4x+6}{\\int }_{-1}^{0}\\frac{\\sqrt{{x}^{2}+y}}{y+1}\\,dy\\,dx"] ["math" "{\\int }_{4x+6}^{2{x}^{2}}{\\int }_{-1}^{0}\\frac{\\sqrt{{x}^{2}+y}}{y+1}\\,dy\\,dx"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14054607/state.json" "file_sha256" "70dfc2d3901190177f89e5518ec1fd1e8ae9dad5f3a3be9f25ff404feb7c8814"} {"question" "q-81329" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\int }_{-1}^{0}{\\int }_{2{x}^{2}}^{4x+6}\