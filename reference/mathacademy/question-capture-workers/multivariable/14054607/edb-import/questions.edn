{x}{x^{2} + y^{2}}dydx" :db/id #edb/ref 17592186133066} {:answer/id #uuid "0236fe78-131d-5c48-a384-e43ce6f12ef5" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{x^{2}}^{2x^{2}}∫_{1}^{2}\\frac{x}{x^{2} + y^{2}}dydx" :db/id #edb/ref 17592186133067} {:answer/id #uuid "1bfb3bf2-3df1-53b3-93e2-0124677f8247" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{-1}^{1}∫_{2x^{2}}^{x^{2}}\\frac{x}{x^{2} + y^{2}}dydx" :db/id #edb/ref 17592186133068} {:answer/id #uuid "7fdba46d-8810-5cca-a15c-abc62c75b1dc" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{2}^{2x^{2}}∫_{1}^{x^{2}}\\frac{x}{x^{2} + y^{2}}dydx" :db/id #edb/ref 17592186133069}] :answer-field/correct {:answer/id #uuid "a1a18d1f-1c37-53d8-9ab0-49ea8595d09c" :answer/type {:db/ident :answer.type/math} :answer/value "∫_{1}^{2}∫_{x^{2}}^{2x^{2}}\\frac{x}{x^{2} + y^{2}}dydx" :db/id #edb/ref 17592186133065} :answer-field/id #uuid "4f3ad79f-9326-5b28-a957-93a45cadcd5b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186133064}] :question/id #uuid "5f61d37a-849f-5ed6-81a5-d25f65061240" :question/math-academy-id "q-80492" :question/problem "Consider the finite region $D$ in the $xy$-plane enclosed by the lines $x = 1$, $x = 2$, and the curves $y = x^{2}$ and $y = 2x^{2}$. What is $∬_(D)\\frac{x}{x^{2} + y^{2}}dA$ expressed as a repeated integral?"}]}
