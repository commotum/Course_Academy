    {
      "question": "e-7025",
      "field": null,
      "attribute": "question/problem",
      "old_sha256": "158dd64893987174da775c77e8c8ea20c74190a47cf8a5f53195832c3c46da28",
      "new_sha256": "23332b81d0ebb6c03198e12cf189c0e8ba542ceefe495cf877688c4e263dd5ef",
      "category": "ma_capture",
