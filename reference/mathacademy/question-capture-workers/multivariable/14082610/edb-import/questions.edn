t{2}}y\\sqrt{9y^{4} - 12y^{2} + 5}dy" :db/id #edb/ref 17592186125903} {:answer/id #uuid "f1ee36fc-7458-5f3c-93ba-3fe804a66343" :answer/type {:db/ident :answer.type/math} :answer/value "2π∫_{0}^{\\sqrt{2}}(2y - y^{3})\\sqrt{9y^{4} - 12y^{2} + 5}dy" :db/id #edb/ref 17592186125904} {:answer/id #uuid "4ec62c73-022a-53f5-a458-fe05bdd41ede" :answer/type {:db/ident :answer.type/math} :answer/value "2π∫_{0}^{2}y^{2}\\sqrt{9y^{4} - 12y^{2} + 5}dy" :db/id #edb/ref 17592186125905}] :answer-field/correct {:answer/id #uuid "eb4ff329-cbec-572f-819b-87f004c11751" :answer/type {:db/ident :answer.type/math} :answer/value "2π∫_{0}^{\\sqrt{2}}y\\sqrt{9y^{4} - 12y^{2} + 5}dy" :db/id #edb/ref 17592186125903} :answer-field/id #uuid "2b744d30-5cec-5215-9c0e-5a7df0803be6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186125900}] :question/id #uuid "18821903-024e-5a0d-8496-6fcfa9ff5b2a" :question/math-academy-id "q-109179" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1994/Source/Images/q-109179.png)\n\nConsider the arc of the curve $x = 2y - y^{3}$ that lies in the first quadrant between its $y$-intercepts. What integral gives the surface area generated when this arc is rotated $2π$ radians about the $x$-axis?"}]}
