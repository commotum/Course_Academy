#{[{:db/id #edb/ref 17592186198874 :knowledge-point/_questions [{:knowledge-point/id #uuid "bf5e8b36-38f0-5dd9-8b76-82392e593b73" :knowledge-point/title "Determining the Critical Points of a Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ecd0c6b7-5db2-5493-9430-3d287e7dce68" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the hyperbola $u^{2} - v^{2} = 1$." :db/id #edb/ref 17592186197480} {:answer/id #uuid "fed315b8-dfa8-5102-be42-e6f9abe7b76c" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the line $v = 0$." :db/id #edb/ref 17592186197481} {:answer/id #uuid "142b4be6-b9d0-5721-9c63-a838147449e6" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the circle $u^{2} + v^{2} = 1$." :db/id #edb/ref 17592186197482} {:answer/id #uuid "334cad97-97c7-52ae-b927-fc7f05fa92e4" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the line $u = 0$." :db/id #edb/ref 17592186197483} {:answer/id #uuid "6c0e5567-a7e8-5c55-8b39-f4e795ef9816" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the lines $v = ± u$." :db/id #edb/ref 17592186197484}] :answer-field/correct {:answer/id #uuid "6c0e5567-a7e8-5c55-8b39-f4e795ef9816" :answer/type {:db/ident :answer.type/text} :answer/value "The critical points lie on the lines $v = ± u$." :db/id #edb/ref 17592186197484} :answer-field/id #uuid "e2f17445-ca3e-59e4-a6fd-de8b051cab04" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186197479}] :question/id #uuid "9ba03a11-dea1-56d5-9626-63bbe9ed1384" :question/math-academy-id "q-38079" :question/problem "Find the locations of all of the critical points of the transformation $T$, where $T$ is defined as\n\n$T: \\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u^{2} + v^{2} \\\\ uv\\end{bmatrix}$."}] [{:db/id #edb/ref 175921861