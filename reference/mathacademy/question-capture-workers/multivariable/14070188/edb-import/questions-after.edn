gin{aligned}0 & 1 & -1 \\\\ 1 & 0 & 1 \\\\ -1 & 1 & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈-1+[\\begin{aligned}2 & 0 & 2\\end{aligned}][\\begin{aligned}x-1 \\\\ y-1 \\\\ z-1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}x-1 \\\\ y-1 \\\\ z-1\\end{aligned}]}^{T}[\\begin{aligned}0 & 1 & -1 \\\\ 1 & 0 & 1 \\\\ -1 & 1 & 0\\end{aligned}][\\begin{aligned}x-1 \\\\ y-1 \\\\ z-1\\end{aligned}]\n$$\n\nFinally, evaluating the polynomial at $x=[\\begin{aligned}0 \\\\ 2 \\\\ 0\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}f(0,2,0) & ≈-1+[\\begin{aligned}2 & 0 & 2\\end{aligned}][\\begin{aligned}0-1 \\\\ 2-1 \\\\ 0-1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}0-1 \\\\ 2-1 \\\\ 0-1\\end{aligned}]}^{T}[\\begin{aligned}0 & 1 & -1 \\\\ 1 & 0 & 1 \\\\ -1 & 1 & 0\\end{aligned}][\\begin{aligned}0-1 \\\\ 2-1 \\\\ 0-1\\end{aligned}] \\\\  & =-1+[\\begin{aligned}2 & 0 & 2\\end{aligned}][\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}]}^{T}[\\begin{aligned}0 & 1 & -1 \\\\ 1 & 0 & 1 \\\\ -1 & 1 & 0\\end{aligned}][\\begin{aligned}-1 \\\\ 1 \\\\ -1\\end{aligned}] \\\\  & =-1+(-4)+\\frac{1}{2}[\\begin{aligned}-1 & 1 & -1\\end{aligned}][\\begin{aligned}2 \\\\ -2 \\\\ 2\\end{aligned}] \\\\  & =-5+\\frac{1}{2}(-6) \\\\  & =-8.\\end{aligned}\n$$"}]}
