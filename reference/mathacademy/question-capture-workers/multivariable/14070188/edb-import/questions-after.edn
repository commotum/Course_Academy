n}}\\end{aligned}]|}_{x=a}\n$$\n\nand\n\n$$\n{f}^{″}(a)={[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}_{1}^{2}} & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{1}∂{x}_{n}} \\\\ \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{2}^{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{2}∂{x}_{n}} \\\\ ⋮ & ⋮ & ⋮ & ⋮ \\\\ \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{1}} & \\frac{{∂}^{2}f}{∂{x}_{n}∂{x}_{2}} & ⋯ & \\frac{{∂}^{2}f}{∂{x}_{n}^{2}}\\end{aligned}]}_{x=a}\n$$\n\nIn this case, we have $a=[\\begin{aligned}1 \\\\ -1\\end{aligned}],$ and the following data:\n\n$$\n\\begin{aligned}f(a) & =-e, & \\,{f}^{′}(a) & =[\\begin{aligned}-e & e\\end{aligned}], & \\,{f}^{″}(a) & =[\\begin{aligned}-e & 0 \\\\ 0 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈-e+[\\begin{aligned}-e & e\\end{aligned}][\\begin{aligned}x-1 \\\\ y+1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}x-1 \\\\ y+1\\end{aligned}]}^{T}[\\begin{aligned}-e & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}x-1 \\\\ y+1\\end{aligned}]\n$$\n\nFinally, evaluating the polynomial at $x=[\\begin{aligned}0 \\\\ 0\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}f(0,0) & ≈-e+[\\begin{aligned}-e & e\\end{aligned}][\\begin{aligned}0-1 \\\\ 0+1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}0-1 \\\\ 0+1\\end{aligned}]}^{T}[\\begin{aligned}-e & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}0-1 \\\\ 0+1\\end{aligned}] \\\\  & =-e+[\\begin{aligned}-e & e\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}-1 \\\\ 1\\end{aligned}]}^{T}[\\begin{aligned}-e & 0 \\\\ 0 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =-e+2e+\\frac{1}{2}[\\begin{aligned}-1 & 1\\end{aligned}][\\begin{aligned}e \\\\ 1\\end{aligned}] \\\\  & =e+\\frac{1}{2}(-e+1) \\\\  & =\\frac{e+1}{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186365717 :knowledge-point/_questions [{:knowledge-point/id #uuid "b19cc766-bdc5-5ab2-aa4d-ebddf8311116" :knowledge-point/title 