^{2}}\\end{aligned}]}_{x=a}\n$$\n\nIn this case, we have $a=[\\begin{aligned}1 \\\\ 1\\end{aligned}],$ and the following data:\n\n$$\n\\begin{aligned}f(a) & =2, & \\,{f}^{′}(a) & =[\\begin{aligned}3 & 1\\end{aligned}], & \\,{f}^{″}(a) & =[\\begin{aligned}6 & 3 \\\\ 3 & 0\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈2+[\\begin{aligned}3 & 1\\end{aligned}][\\begin{aligned}x-1 \\\\ y-1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}x-1 \\\\ y-1\\end{aligned}]}^{T}[\\begin{aligned}6 & 3 \\\\ 3 & 0\\end{aligned}][\\begin{aligned}x-1 \\\\ y-1\\end{aligned}]\n$$\n\nFinally, evaluating the polynomial at $x=[\\begin{aligned}0 \\\\ 2\\end{aligned}],$ we obtain\n\n$$\n\\begin{aligned}f(0,2) & ≈2+[\\begin{aligned}3 & 1\\end{aligned}][\\begin{aligned}0-1 \\\\ 2-1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}0-1 \\\\ 2-1\\end{aligned}]}^{T}[\\begin{aligned}6 & 3 \\\\ 3 & 0\\end{aligned}][\\begin{aligned}0-1 \\\\ 2-1\\end{aligned}] \\\\  & =2+[\\begin{aligned}3 & 1\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}]+\\frac{1}{2}{[\\begin{aligned}-1 \\\\ 1\\end{aligned}]}^{T}[\\begin{aligned}6 & 3 \\\\ 3 & 0\\end{aligned}][\\begin{aligned}-1 \\\\ 1\\end{aligned}] \\\\  & =2+(-2)+\\frac{1}{2}[\\begin{aligned}-1 & 1\\end{aligned}][\\begin{aligned}-3 \\\\ -3\\end{aligned}] \\\\  & =0+\\frac{1}{2}(0) \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186365710 :knowledge-point/_questions [{:knowledge-point/id #uuid "b19cc766-bdc5-5ab2-aa4d-ebddf8311116" :knowledge-point/title "Approximating a Multivariable Function at a Point Using a Quadratic Taylor Polynomial"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2d6361aa-f276-53fb-83e6-d423225628ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{e-2}{2}" :db/id #edb/ref 17592186365712} {:answer/id #uuid "ba2b0f08-fcee-5642-afcd-9f3c4b64ec5b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3e-1}{2}" :db/id #edb/ref 