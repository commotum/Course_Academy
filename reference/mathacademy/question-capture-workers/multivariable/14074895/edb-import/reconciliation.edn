swer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/assets/d5927b5cc43ee1b5923b4d2aa4b4740e2bbc1c73b09b00525cb74767badc4808.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/state.json" "file_sha256" "4b8092cfde0d32ce65370dcd601054546f470d85048934180c21baa7f52efc70" "basis" 1866 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/edb-import/verification.json"} {"question" "q-127011" "field" "selection" "attribute" "answer/value" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/assets/f5d7744d62f94b96b8bd1600ca7f5fc752d1f83c8c8928e740261e808cb9e07b.png"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/state.json" "file_sha256" "4b8092cfde0d32ce65370dcd601054546f470d85048934180c21baa7f52efc70" "basis" 1866 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/edb-import/verification.json"} {"question" "q-127011" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/assets/4c9f5d5245a1a4aa33a0d474ff328a30a1c8820055551e3613bf7c9489c2a908.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/state.json" "file_sha256" "4b8092cfde0d32ce65370dcd601054546f470d85048934180c21baa7f52efc70" "basis" 1866 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14058243/edb-import/verification.json"}] "sources" [{"question" "q-73349" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074895/assets/6393810d90b8d340dbde041c43cb7e146cb59fedfcfd4a678827d291ea502b00.png)\n\nThe function $y=f(x)$ above is continuous on the interval $[-5,4]$ and differentiable on  $(-5,4).$  What is the missing part of the sentence in the statement below?\n\n*The mean value theorem states that there exists a point $c\\in (-5,4)$ such that $\\text{_______}\\,.$ *" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074895/state.json" "file_sha256" "8f716d7354f66ba6857898b997d23a4d7cd2bed7f6a5f768d2ef0e67da15e37c"} {"question" "q-73349" "field" nil "attribute" "question/worked-solution" "value" "Given that $f(x)$ is continuous on $[a,b]$ and differentiable on  $(a,b)$, the mean value theorem states the following: \n\n*There exists a point $c\\in (a,b)$ such that*\n\n$$\n{f}^{′}(c)=\\frac{f(b)-f(a)}{b-a}.\n$$\n\nIn our case, we have $a=-5$ and $b=4.$ Thus, \n\n$$\n\\begin{aligned}{f}^{′}(c) & =\\frac{f(4)-f(-5)}{4-(-5)} \\\\  & =\\frac{7-2}{4+5} \\\\  & =\\frac{5}{9}.\\end{aligned}\n$$\n\nTherefore, the complete sentence is as follows:\n\n *The mean value theorem states that there exists a point $c\\in (-5,4)$ such that ${f}^{′}(c)=\\frac{5}{9}.$*" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074895/state.json" "file_sha256" "8f716d7354f66ba6857898b997d23a4d7cd2bed7f6a5f768d2ef0e67da15e37c"} {"question" "q-73349" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074895/activity-metadata.json" "file_sha256" "f390378c1221a74f9572acd1218f2dc69830ecf8932ab444c1ccc83ee35204d2"} {"question" "q-73349" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-wor