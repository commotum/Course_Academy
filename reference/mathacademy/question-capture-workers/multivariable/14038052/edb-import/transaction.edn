fficulty :question.difficulty/easy :question/answer-fields ["q-104223/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404"] :knowledge-point/questions ["q-104223"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104229/selection/bb8c34e3a8d482c4f322d1b06cd4a6ac86e51d4945b204db3b37b6a23ecd312d" :answer/id #uuid "6ebd7008-e916-5687-a5bc-7c91d596070a" :answer/type :answer.type/text :answer/value "A plane that is parallel to the $xy$-plane" :db/ensure [:answer/validate]} {:db/id "q-104229/selection/826bf7aafa9cc6ead7419f848f42490f26708d4b2d9f0ac9dc3dad7483a7dd05" :answer/id #uuid "55900fbb-b194-55bd-b7eb-37072c5cb8e3" :answer/type :answer.type/text :answer/value "A cone" :db/ensure [:answer/validate]} {:db/id "q-104229/selection/9a01d3b7bb50f74f0f0a937ec21e923b3fd4baedfed010beb5720f21b3f20cd5" :answer/id #uuid "7d665306-969e-5a23-bb18-045574f17a43" :answer/type :answer.type/text :answer/value "A half-plane that passes through the $z$-axis" :db/ensure [:answer/validate]} {:db/id "q-104229/selection/b1351b8d6e4b1f60c445722c5aab2f3e1a56009d234588b4f56554f9bba327b8" :answer/id #uuid "7c957989-6e7e-5d9e-8b68-bd8a2a8455d1" :answer/type :answer.type/text :answer/value "A sphere" :db/ensure [:answer/validate]} {:db/id "q-104229/selection/0df0b3f0f6011761d153919f3db35f14c1f23575c9c17a36c469c8132a790225" :answer/id #uuid "9f4b926a-3bc1-5d59-b1c7-dbac445d4138" :answer/type :answer.type/text :answer/value "A circular sector" :db/ensure [:answer/validate]} {:db/id "q-104229/selection" :answer-field/id #uuid "f09eb661-5efc-5cc4-b052-93a73b71cd4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104229/selection/9a01d3b7bb50f74f0f0a937ec21e923b3fd4baedfed010beb5720f21b3f20cd5" :answer-field/choices ["q-104229/selection/bb8c34e3a8d482c4f322d1b06cd4a6ac86e51d4945b204db3b37b6a23ecd312d" "q-104229/selection/826bf7aafa9cc6ead7419f848f42490f26708d4b2d9f0ac9dc3dad7483a7dd05" "q-104229/selection/9a01d3b7bb50f74f0f0a937ec21e923b3fd4baedfed010beb5720f21b3f20cd5" "q-104229/selection/b1351b8d6e4b1f60c445722c5aab2f3e1a56009d234588b4f56554f9bba327b8" "q-104229/selection/0df0b3f0f6011761d153919f3db35f14c1f23575c9c17a36c469c8132a790225"] :db/ensure [:answer-field/validate]} {:db/id "q-104229" :question/id #uuid "54774580-a597-5646-b9f4-6ebf28a6a01c" :question/math-academy-id "q-104229" :question/problem "What surface is defined by the equation $\\theta =\\frac{\\pi }{2}$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\n\\theta =\\frac{\\pi }{2}\n$$\n\nThis equation requires that if we project the vector $\\overset{\\to }{OP}$ onto the $xy$-plane for every point $P$ on our surface, the resulting vector makes an angle of $\\frac{\\pi }{2}$ radians with the positive $x$-axis. So, we must have $\\theta =\\frac{\\pi }{2}$ for every point on the surface. On the other hand, $r$ and $z$ can vary arbitrarily in their respective domains.\n\nTherefore, our surface is a half-plane that passes through the $z$-axis, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038052/assets/4eefd7f719ccb0c34407d6c02ef1adeb283f45e80ed6a95525661b84e39b3a8d.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104229/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404"] :knowledge-point/questions ["q-104229"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104219/selection/9a01d3b7bb50f74f0f0a937ec21e923b3fd4baedfed010beb5720f21b3f20cd5" :answer/id #uuid "7695d1ca-ace7-5579-9fd3-c7500891f89