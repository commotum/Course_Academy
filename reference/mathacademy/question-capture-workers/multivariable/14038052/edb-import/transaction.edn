 the equation of the surface in cylindrical polar coordinates is $\\theta =\\frac{11\\pi }{8}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-104209/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eae7e5be-e883-5658-84a0-5de5da567887"] :knowledge-point/questions ["q-104209"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104214/selection/aa93df3463a1d192c0cacce03249cea0025be96fd76548410b4b34ac70ace240" :answer/id #uuid "fd5564a7-e4e9-5465-8983-82b8dfacaa45" :answer/type :answer.type/math :answer/value "z=r" :db/ensure [:answer/validate]} {:db/id "q-104214/selection/08bf7c440f06ff0bf49c6ed3af10310f81b689524874e9e5537ba870d60d071a" :answer/id #uuid "17ee542f-214d-5977-ade9-eb9d9b8d8c70" :answer/type :answer.type/math :answer/value "z=0" :db/ensure [:answer/validate]} {:db/id "q-104214/selection/5197da519a3b8a4fd649e56713e6a01faea7ae6ec4dd8af8cf36772d5f634059" :answer/id #uuid "c7f1677b-7be6-587f-9bbc-76934967b667" :answer/type :answer.type/math :answer/value "\\theta =0" :db/ensure [:answer/validate]} {:db/id "q-104214/selection/0a88567bcef3eca07fcd648e8b55b72d28c63c45877086d13182a8e319569a1b" :answer/id #uuid "869b973e-09ca-5ad7-82bf-8a3c0649de7f" :answer/type :answer.type/math :answer/value "\\theta =z" :db/ensure [:answer/validate]} {:db/id "q-104214/selection/9aaef4fde33653b6e12b885c8c7c78cf4414d7cf09f543ea188c26d1b5ea7114" :answer/id #uuid "37382c6c-6a18-5d40-85eb-3a9740a63555" :answer/type :answer.type/math :answer/value "r=0" :db/ensure [:answer/validate]} {:db/id "q-104214/selection" :answer-field/id #uuid "6e6e888d-8487-5409-b6df-d1f56273f535" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-104214/selection/08bf7c440f06ff0bf49c6ed3af10310f81b689524874e9e5537ba870d60d071a" :answer-field/choices ["q-104214/selection/aa93df3463a1d192c0cacce03249cea0025be96fd76548410b4b34ac70ace240" "q-104214/selection/08bf7c440f06ff0bf49c6ed3af10310f81b689524874e