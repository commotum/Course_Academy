#{[{:db/id #edb/ref 17592186175736 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/id #uuid "52199b9c-bb04-5c14-b4ca-909d46c7f039" :question/math-academy-id "e-8808" :question/problem "What surface is defined by the equation $\\theta=3$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta,z)$, where\n\n- $r\\geq 0$ and $[MATH: \\theta\\in [0,2\\pi)]$ are the usual plane polar coordinates, and\n- $z\\in (-\\infty, \\infty)$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\n\\theta=3\n$$\n\nThis equation requires that if we project the vector $\\overrightarrow{OP}$ onto the $xy$-plane for every point $P$ on our surface, the resulting vector makes an angle of $3$ radians with the positive $x$-axis. So, we must have $\\theta=3$ for every point on the surface. On the other hand, $r$ and $z$ can vary arbitrarily in their respective domains.\n\nTherefore, our surface is a half-plane that passes through the $z$-axis, shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/3569/Source/Images/9804cd2ed4eda4a2d4a17c22582a1e1c.png)"}] [{:db/id #edb/ref 17592186175737 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "eae7e5be-e883-5658-84a0-5de5da567887" :knowledge-point/title "Identifying the Polar Equation of a Given Surface"}] :question/id #uuid "ee821db7-b420-5f37-a54c-a0bbe6cc83be" :question/math-academy-id "e-8809" :question/problem "What is the equation of the surface shown above in cylindrical polar coordinates?\n\n![](/home/jake/Developer/MA/DATA/Lessons/3569/Source/Images/b3c5e53b06be6140a5e1a5a43f861f28.png)" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta,z)$, where\n\n- $r\\geq 0$ and $[MATH: \\theta\\in [0,2\\pi)]$ are the usual plane polar coordinates, and\n- $z\\in (-\\infty, \\infty)$ is the usual Cartesian $z$-coordinate.\n\nThe picture shows a circular cylinder of radius $5$ whose axis of symmetry is the $z$-axis.\n\nWe note the following:\n\n- Since the distance from any point on our surface to the $z$-axis equals $5$, we must have $r=5$ for every point on the surface.\n- On the other hand, $\\theta$ and $z$ can vary arbitrarily in their respective domains.\n\nTherefore, the equation of the surface in cylindrical polar coordinates is $r = 5$."}] [{:db/id #edb/ref 17592186175748 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2f4472e5-68af-5e8c-83cb-ceab2a6dfe1e" :knowledge-point/title "Identifying Cones and Half-Cones"}] :question/id #uuid "f948d39d-6d7d-56b8-bb2c-b0a74ac514b7" :question/math-academy-id "e-8893" :question/problem "What surface is defined by the equation $z=4r$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta,z)$, where\n\n- $r\\geq 0$ and $[MATH: \\theta\\in [0,2\\pi)]$ are the usual plane polar coordinates, and\n- $z\\in (-\\infty, \\infty)$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\nz=4r\n$$\n\nThis equation requires that the distance from any point on the surface to the $xy$-plane equals $4$ times the distance from that point to the $z$-axis. In other words, the tangent of the angle between any position vector on the surface and the $z$-axis must be equal to\n\n$$\n\\dfrac{r}{z} = \\dfrac{r}{4r} = \\dfrac14\n$$\n\nOn the other hand, $\\theta$ can vary arbitrarily in its domain.\n\nTherefore, our surface is the half-cone shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/3569/Source/Images/1bbb3ecdf0dec4fb3a227e144bce625c.png)"}] [{:db/id #edb/ref 17592186176122 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c839bdf4-fea4-5ac6-a1c1-cc6da9cd0d18" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186173395} {:answer/id #uuid "dab70c44-1791-5d95-9be3-edd87bf9aaa2" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186173396} {:answer/id #uuid "1d3baa5e-7253-5165-8198-0469041ee223" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186173397} {:answer/id #uuid "48d876ab-7178-5970-bffe-4c2de75ef3ed" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186173398} {:answer/id #uuid "65e71dc3-c603-5fcd-a51c-ee8e5695ac09" :answer/type {:db/ident :answer.type/text} :answer/value "A half-cone" :db/id #edb/ref 17592186173399}] :answer-field/correct {:answer/id #uuid "dab70c44-1791-5d95-9be3-edd87bf9aaa2" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186173396} :answer-field/id #uuid "3272e233-d2b2-59ea-ad3e-c8df537317fa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186173394}] :question/id #uuid "6c33c48b-3512-52f4-865d-a2fd7c43dab5" :question/math-academy-id "q-104227" :question/problem "What surface is defined by the equation $z = \\frac{π}{4}$ in cylindrical polar coordinates?"}]}
