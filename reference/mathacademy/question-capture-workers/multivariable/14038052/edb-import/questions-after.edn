hacademy/question-capture-workers/multivariable/14038052/assets/0118d67477cd0665d4ae5cbebbf3c3d6f3a6a24f4944977d4301cbaf99d3ecaa.png)"}] [{:db/id #edb/ref 17592186298657 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7c0f9ddf-85d9-556e-9da6-37686ebea0eb" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186298659} {:answer/id #uuid "5b105edc-895d-58b0-9bc1-509adde9dd79" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186298660} {:answer/id #uuid "de13067f-2e47-58ac-9ac4-6152a207a278" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186298661} {:answer/id #uuid "605b2426-91f9-5e77-831c-8975c1f7853a" :answer/type {:db/ident :answer.type/text} :answer/value "A half-cone" :db/id #edb/ref 17592186298662} {:answer/id #uuid "d51eaf3e-769f-51e9-be58-884e2f120003" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186298663}] :answer-field/correct {:answer/id #uuid "de13067f-2e47-58ac-9ac4-6152a207a278" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186298661} :answer-field/id #uuid "e7316d79-2ff2-5253-ba29-3e58c6b3f0b4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186298658}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "bb65e6d9-45e5-53d5-8bab-c34cad517cf2" :question/math-academy-id "q-104223" :question/problem "What surface is defined by the equation $z=3$ in cylindrical polar coordinates?" :question/worked-solution "The position of a point in cylindrical polar coordinates is written as $(r,\\theta ,z),$ where \n\n- $r\\ge 0$ and $\\theta \\in [0,2\\pi )$ are the usual plane polar coordinates, and\n\n- $z\\in (-\\infty ,\\infty )$ is the usual Cartesian $z$-coordinate.\n\nWith that in mind, let's examine our equation:\n\n$$\nz=3\n$$\n\nThis equation requires that $z$-coordinate of any point on our surface equals $3,$ while $r$ and $\\theta $ can vary arbitrarily in their respective domains. \n\nTherefore, our surface is the plane that is parallel to the $xy$-plane shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038052/assets/ab98ba68465b36fcc3c7ac2de4f50a8f3f16f5e7e10f2c08625cbd933c59f3c4.png)"}] [{:db/id #edb/ref 17592186298664 :knowledge-point/_questions [{:knowledge-point/id #uuid "a3e455da-2c31-55af-8122-6fa0e5020404" :knowledge-point/title "Identifying a Surface by Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d73b4191-9611-5283-b2ac-c0fedb9777eb" :answer/type {:db/ident :answer.type/text} :answer/value "A cone" :db/id #edb/ref 17592186298666} {:answer/id #uuid "1543d676-26cc-5a5b-837e-a491e53e2a9c" :answer/type {:db/ident :answer.type/text} :answer/value "A half-plane that passes through the $z$-axis" :db/id #edb/ref 17592186298667} {:answer/id #uuid "60883aa8-8269-55f9-9f7b-fafa8b1f1151" :answer/type {:db/ident :answer.type/text} :answer/value "A plane that is parallel to the $xy$-plane" :db/id #edb/ref 17592186298668} {:answer/id #uuid "f4c42afd-2915-5b3a-8573-705cf9f38e1c" :answer/type {:db/ident :answer.type/text} :answer/value "A half-cone" :db/id #edb/ref 17592186298669} {:answer/id #uuid "70a778d8-989f-5ece-bb96-4bba2a0a82ee" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :db/id #edb/ref 17592186298670}] :answer-field/correct {:answer/id #uuid "70a778d8-989f-5ece-bb96-4bba2a0a82ee" :answer/type {:db/ident :answer.type/text} :answer/value "A circular cylinder" :