#{[{:db/id #edb/ref 17592186192299 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/id #uuid "65070836-e061-5fec-ae8d-263ef0c32659" :question/math-academy-id "e-10839" :question/problem "Compute $P\\left(1 \\lt X \\lt 3 \\right)$ given that the random variable $X$ has the probability density function\n\n${\\frac{1}{18}(x^{2} - 1),\\begin{vmatrix}1 \\le x \\le 4, \\\\ 0,\\end{vmatrix}otherwise$." :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x)$, then\n\n$$\nP(a \\lt X \\lt b) = \\int_a^b f(x) \\, \\textrm dx\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}\nP(1 < X < 3) &= ∫_{1}^{3}f(x)dx \\\\\n&= ∫_{1}^{3}\\frac{1}{18}(x^{2} - 1)dx \\\\\n&= \\frac{1}{18}∫_{1}^{3}(x^{2} - 1)dx \\\\\n&= \\frac{1}{18}[\\frac{1}{3}x^{3} - x]_{1}^{3} \\\\\n&= \\frac{1}{18}([\\frac{1}{3}(3)^{3} - (3)] - [\\frac{1}{3}(1)^{3} - (1)]) \\\\\n&= \\frac{1}{18}([9 - 3] - [\\frac{1}{3} - 1]) \\\\\n&= \\frac{1}{18}(6 + \\frac{2}{3}) \\\\\n&= \\frac{1}{18} \\cdot \\frac{20}{3} \\\\\n&= \\frac{10}{27}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192339 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/id #uuid "d8425df8-1fb2-5f59-a034-2b30f14b9b4b" :question/math-academy-id "e-11036" :question/problem "Compute $P\\left(X \\leq 3 \\right)$ given that the random variable $X$ has the probability density function\n\n${\\frac{2x}{45},\\begin{vmatrix}2 \\le x \\le 7, \\\\ 0,\\end{vmatrix}otherwise$." :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x)$, then\n\n$$\nP(a \\leq X \\leq b) = \\int_a^b f(x) \\, \\textrm dx\n$$\n\nSince $f(x)$ is identical to zero for all $x \\lt 2$, we have\n\n$$\n\\begin{aligned}\nP(X \\le 3) &= ∫_{2}^{3}f(x)dx \\\\\n&= ∫_{2}^{3}\\frac{2x}{45}dx \\\\\n&= [\\frac{1}{45}x^{2}]_{2}^{3} \\\\\n&= \\frac{1}{45}(3^{2} - 2^{2}) \\\\\n&= \\frac{1}{45} \\cdot 5 \\\\\n&= \\frac{1}{9}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192340 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/id #uuid "4baa68f1-2f68-5df5-936a-aff56605ed8e" :question/math-academy-id "e-11038" :question/problem "Compute $P\\left(2 \\leq X \\leq 4 \\right)$ given that the random variable $X$ has the probability density function\n\n${\\frac{1}{9}x,\\begin{vmatrix}0 \\le x < 3, \\\\ x - 3,\\end{vmatrix}3 \\le x \\le 4,; 0, \\mid otherwise$." :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x)$, then\n\n$$\nP(a \\leq X \\leq b) = \\int_a^b f(x) \\, \\textrm dx\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}\nP(2 \\le X \\le 4) &= ∫_{2}^{4}f(x)dx \\\\\n&= ∫_{2}^{3}\\frac{1}{9}xdx + ∫_{3}^{4}(x - 3)dx \\\\\n&= [\\frac{1}{18}x^{2}]_{2}^{3} + [\\frac{1}{2}x^{2} - 3x]_{3}^{4} \\\\\n&= \\frac{1}{18}[3^{2} - 2^{2}] + ([\\frac{1}{2}(4)^{2} - 3(4)] - [\\frac{1}{2}(3)^{2} - 3(3)]) \\\\\n&= \\frac{5}{18} - 4 + \\frac{9}{2} \\\\\n&= \\frac{14}{18} \\\\\n&= \\frac{7}{9}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193216 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8165db7c-119f-52d5-8190-74e763f05248" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186192085} {:answer/id #uuid "8aab2f28-f15a-5a21-a25c-5049d55ed874" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186192086} {:answer/id #uuid "24611dd8-0902-59b4-bddc-2420a314fbdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186192087} {:answer/id #uuid "2f40af29-bef0-50e2-9b79-d4bd79c1d3f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186192088} {:answer/id #uuid "3ef4a551-4e87-5cf5-a699-4304df056b1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186192089}] :answer-field/correct {:answer/id #uuid "8aab2f28-f15a-5a21-a25c-5049d55ed874" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186192086} :answer-field/id #uuid "1903b71a-d4dc-58a1-b50d-306551c8b8c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186192084}] :question/id #uuid "7d522d4b-cd13-5ffd-9293-3255ca27b6de" :question/math-academy-id "q-86913" :question/problem "Compute $P(2 < X < 8)$ given that the random variable $X$ has the probability density function\n\n$f(x) = {\\frac{1}{50}x,\\begin{vmatrix}0 \\le x \\le 10, \\\\ 0,\\end{vmatrix}otherwise$."}]}
