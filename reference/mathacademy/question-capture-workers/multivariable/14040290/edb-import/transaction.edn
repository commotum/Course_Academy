}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>0,$ we have\n\n$$\n\\begin{aligned}P(X>-3) & ={\\int }_{-3}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-3}^{0}\\frac{1}{72}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{216}{x}^{3}]}_{-3}^{0} \\\\  & =\\frac{1}{216}[(0)^{3}-(-3)^{3}] \\\\  & =\\frac{27}{216} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158310/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c"] :knowledge-point/questions ["q-158310"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158360/selection/45b6f7e429cb4be3bcdd67a6966ac6a024c5ab90331f3eae9dcf6b4a321f18d9" :answer/id #uuid "8ae49b17-0aa0-5bde-8678-fee80e49a909" :answer/type :answer.type/math :answer/value "\\frac{9}{14}" :db/ensure [:answer/validate]} {:db/id "q-158360/selection/df817bb9da38e9cb484386a26fe6e5e9faf2ff1998e6e5a28c6ff4087baf96e1" :answer/id #uuid "489d83b5-3baf-5a69-aed0-8407eac49448" :answer/type :answer.type/math :answer/value "\\frac{7}{14}" :db/ensure [:answer/validate]} {:db/id "q-158360/selection/4582dbd6025ba0c110f8e23964efc62e8612751348ffad003e8834a5780c1878" :answer/id #uuid "7a9718d8-0d35-5956-87e9-14038de5db19" :answer/type :answer.type/math :answer/value "\\frac{4}{7}" :db/ensure [:answer/validate]} {:db/id "q-158360/selection/9c1ac190c9181bacd01f6196dd18ebf6f26f3618e0aa46bf0341b801be5c01c7" :answer/id #uuid "20b986a5-3559-5209-b25f-184ffd671f69" :answer/type :answer.type/math :answer/value "\\frac{11}{14}" :db/ensure [:answer/validate]} {:db/id "q-158360/selection/fba3f071a3bf374a14af37c3a2bf03fdd1045070379d4ec39535030fd010d58a" :answer/id #uuid "089c922f-24dd-5ed1-94ed-7626786a8ca2" :answer/type :answer.type/math :answer/value "\\frac{3}{7}" :db/ensure [:answer/validate]} {:db/id "q-158360/selection" :answer-field/id #uuid "8bc2aef9-eb9b-5d4d-a07d-acf17d764b44" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158360/selection/45b6f7e429cb4be3bcdd67a6966ac6a024c5ab90331f3eae9dcf6b4a321f18d9" :answer-field/choices ["q-158360/selection/45b6f7e429cb4be3bcdd67a6966ac6a024c5ab90331f3eae9dcf6b4a321f18d9" "q-158360/selection/df817bb9da38e9cb484386a26fe6e5e9faf2ff1998e6e5a28c6ff4087baf96e1" "q-158360/selection/4582dbd6025ba0c110f8e23964efc62e8612751348ffad003e8834a5780c1878" "q-158360/selection/9c1ac190c9181bacd01f6196dd18ebf6f26f3618e0aa46bf0341b801be5c01c7" "q-158360/selection/fba3f071a3bf374a14af37c3a2bf03fdd1045070379d4ec39535030fd010d58a"] :db/ensure [:answer-field/validate]} {:db/id "q-158360" :question/id #uuid "a3a85b19-979f-52ec-b4d9-f19bf94105c1" :question/math-academy-id "q-158360" :question/problem "Compute $P(X>-1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{28}({x}^{2}+1),\\, & -2\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>2,$ we have\n\n$$\n\\begin{aligned}P(X>-1) & ={\\int }_{-1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{2}\\frac{3}{28}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{3}{28}{\\int }_{-1}^{2}{x}^{2}+1\\,\\text{d}x \\\\  & =\\frac{3}{28}{[\\frac{1}{3}{x}^{3}+x]}_{-1}^{2} \\\\  & =\\frac{3}{28}([\\frac{1}{3}(2)^{3}+(2)]-[\\frac{1}{3}(-1)^{3}+(-1)]) \\\\  & =\\frac{3}{28}([\\frac{8}{3}+2]-[-\\frac{1}{3}-1]) \\\\  & =\\frac{3}{28}\\cdot 6 \\\\  & =\\frac{9}{14}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158360/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c"] :knowledge-point/questions ["q-158360"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158304/selection/fba3f071a3bf374a14af37c3a2bf03fdd10