uestion/id #uuid "cd66b9ef-b164-5b8b-ab3b-c7d89adda477" :question/math-academy-id "q-158364" :question/problem "Compute $P(2<X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{21}{x}^{2},\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{21}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{63}{x}^{3}]}_{2}^{3} \\\\  & =\\frac{1}{63}(27-8) \\\\  & =\\frac{19}{63}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158364/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19"] :knowledge-point/questions ["q-158364"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158365/selection/e2f21ee9469dbd9bd84da71a70fe0baafa34f15018c6b375d4e2f4e3d2a69ecb" :answer/id #uuid "57076a80-aae6-5d99-9dff-667537a780b8" :answer/type :answer.type/math :answer/value "\\frac{8}{27}" :db/ensure [:answer/validate]} {:db/id "q-158365/selection/5fd01309ee1f63c32b27d8c9403d8417b63143ceb96e996ed693a8ee322c584f" :answer/id #uuid "3138da82-1afc-5ce8-b4c6-4d474f5e2fcd" :answer/type :answer.type/math :answer/value "\\frac{10}{27}" :db/ensure [:answer/validate]} {:db/id "q-158365/selection/551f136ff3857b671ef7656e36b2b7a1f31f4551d47528d0881fd4dfc84040c0" :answer/id #uuid "0b214588-7ffe-594d-8e98-cff3a3586741" :answer/type :answer.type/math :answer/value "\\frac{7}{9}" :db/ensure [:answer/validate]} {:db/id "q-158365/selection/a93ad35cd12e61816c67ec89bd6a40508b2e90c43d5f95bb294b7af3abb1697f" :answer/id #uuid "55933809-afdb-548f-968d-4d391dabfed1" :answer/type :answer.type/math :answer/value "\\frac{13}{27}" :db/ensure [:answer/validate]} {:db/id "q-158365/selection/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0" :answer/id #uuid "5a503ce2-5470-5afd-980c-a9190fafd362" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "q-158365/selection" :answer-field/id #uuid "ea954d53-502a-5ae1-8522-8c67e9f8b18a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158365/selection/a93ad35cd12e61816c67ec89bd6a40508b2e90c43d5f95bb294b7af3abb1697f" :answer-field/choices ["q-158365/selection/e2f21ee9469dbd9bd84da71a70fe0baafa34f15018c6b375d4e2f4e3d2a69ecb" "q-158365/selection/5fd01309ee1f63c32b27d8c9403d8417b63143ceb96e996ed693a8ee322c584f" "q-158365/selection/551f136ff3857b671ef7656e36b2b7a1f31f4551d47528d0881fd4dfc84040c0" "q-158365/selection/a93ad35cd12e61816c67ec89bd6a40508b2e90c43d5f95bb294b7af3abb1697f" "q-158365/selection/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0"] :db/ensure [:answer-field/validate]} {:db/id "q-158365" :question/id #uuid "14603c57-2009-5dee-b326-f25e938d142f" :question/math-academy-id "q-158365" :question/problem "Compute $P(-1<X\\le 0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{2}{9}(x+2)(1-x),\\, & -2\\le x\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1<X\\le 0) & ={\\int }_{-1}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}\\frac{2}{9}(x+2)(1-x)\\,\\text{d}x \\\\  & =\\frac{2}{9}{\\int }_{-1}^{0}(-{x}^{2}-x+2)\\,\\text{d}x \\\\  & =\\frac{2}{9}{[-\\frac{1}{3}{x}^{3}-\\frac{1}{2}{x}^{2}+2x]}_{-1}^{0} \\\\  & =\\frac{2}{9}([-\\frac{1}{3}(0)^{3}-\\frac{1}{2}(0)^{2}+2(0)]-[-\\frac{1}{3}(-1)^{3}-\\frac{1}{2}(1)^{2}+2(-1)]) \\\\  & =\\frac{2}{9}(0-[\\frac{1}{3}-\\frac{1}{2}-2]) \\\\  & =\\frac{2}{9}\\cdot \\frac{13}{6} \\\\  & =\\frac{13}{27}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158365/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19"] :knowledge-point/questions ["q-158365"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158353/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" :answer/id #uuid "a08dc51e-f07f-5581-8362-839fa937d718" :answer/type :answer.type/math :answer/value "\\frac{1}{8}" :db/ensure [:answer/validate]} {:db/id "q-158353/selection/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" :answer/id #uuid "1d97e720-6e90-59eb-bb75-1018365114d0" :answer/type :answer.type/math :answer/value "\\frac{3}{16}" :db/ensure [:answer/validate]} {:db/id "q-158353/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "a7732b29-e0f5-5dc6-8d70-a475b50a7b5f" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-158353/selection/b05ae51c7e0f9ce8edef362b0e3bfd104c905bad9c2676254ee36131cb916baa" :answer/id #uuid "e508d937-fabd-5456-90c1-47690c820042" :answer/type :answer.type/math :answer/value "\\frac{5}{8}" :db/ensure [:answer/validate]} {:db/id "q-158353/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "d634a8b0-98a0-5eb9-965e-132c93482886" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-158353/selection" :answer-field/id #uuid "d861adc7-402b-55eb-b41e-bd7d76a7ae47" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158353/selection/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" :answer-field/choices ["q-158353/selection/3a3e10526f40c673b7703a3c103fe7589223997acb2a083d0e3a20b742c55555" "q-158353/selection/63029caaa85c8444b7e8555b288d9c5a204814f015fb59a7e4079c09bcc12be0" "q-158353/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-158353/selection/b05ae51c7e0f9ce8edef362b0e3bfd104c905bad9c2676254ee36131cb916baa" "q-158353/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-158353" :question/id #uuid "0a1b2372-d304-559c-a5fd-6cbd8c7c1382" :question/math-academy-id "q-158353" :question/problem "Compute $P(1<X<2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{20}{x}^{3},\\, & 1\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1<X<2) & ={\\int }_{1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{20}{x}^{3}\\,\\text{d}x \\\\  & ={[\\frac{1}{80}{x}^{4}]}_{1}^{2} \\\\  & =\\frac{1}{80}(16-1) \\\\  & =\\frac{3}{16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-158353/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19"] :knowledge-point/questions ["q-158353"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-86913"] :question/problem "Compute $P(2<X<8)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{50}x,\\, & 0\\le x\\le 10, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X<8) & ={\\int }_{2}^{8}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{8}\\frac{1}{50}x\\,\\text{d}x \\\\  & ={[\\frac{1}{100}{x}^{2}]}_{2}^{8} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-158452/selection/551f136ff3857b671ef7656e36b2b7a1f31f4551d47528d0881fd4dfc84040c0" :answer/id #uuid "408c691c-9077-55ae-a5d1-039340b18eff" :answer/type :answer.type/math :answer/value "\\frac{7}{9}" :db/ensure [:answer/validate]} {:db/id "q-158452/selection/a93ad35cd12e61816c67ec89bd6a40508b2e90c43d5f95bb294b7af3abb1697f" :answer/id #uuid "100ba1ae-1ee5-5f5d-a7bc-ad198aaf3b02" :answer/type :answer.type/math :answer/value "\\frac{13}{27}" :db/ensure [:answer/validate]} {:db/id "q-158452/selection/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0" :answer/id #uuid "bf2d73a2-a9b0-5ed8-8ab4-cbd2c41567e3" :answer/type :answer.type/math :answer/value "\\frac{5}{9}" :db/ensure [:answer/validate]} {:db/id "q-158452/selection/b107f74a4e16c10bb036368b88d19850ac85381660f8b8712359b4d1eac94915" :answer/id #uuid "f68f67af-fdf7-5dbb-b534-7055b6372e48" :answer/type :answer.type/math :answer/value "\\frac{7}{18}" :db/ensure [:answer/validate]} {:db/id "q-158452/selection/f9e01b893f8a53cf18c91b916d6f502de1f9faa9995beee4ad7952c09d63dc74" :answer/id #uuid "b6cd5c91-aeb4-509a-a24a-8bd0917092ab" :answer/type :answer.type/math :answer/value "\\frac{16}{27}" :db/ensure [:answer/validate]} {:db/id "q-158452/selection" :answer-field/id #uuid "b7886592-e35c-56fb-97ce-fea0a9eec751" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-158452/selection/a93ad35cd12e61816c67ec89bd6a40508b2e90c43d5f95bb294b7af3abb1697f" :answer-field/choices ["q-158452/selection/551f136ff3857b671ef7656e36b2b7a1f31f4551d47528d0881fd4dfc84040c0" "q-158452/selection/a93ad35cd12e61816c67ec89bd6a40508b2e90c43d5f95bb294b7af3abb1697f" "q-158452/selection/5b6a7457ecf38e757655a8ab80cd7dca24376644ed8b5d929a23fb6af65f88f0" "q-158452/selection/b107f74a4e16c10bb036368b88d19850ac85381660f8b8712359b4d1eac94915" "q-158452/selection/f9e01b893f8a53cf18c91b916d6f502de1f9faa9995beee4ad7952c09d63dc74"] :db/ensure [:answer-field/validate]} {:db/id "q-158452" :question/id #uuid "05b93f7d-4aad-511e-a889-e099b2aab1c3" :question/math-academy-id "q-158452" :question/problem "Compute $P(1\\le X<2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{27}(3{x}^{2}-{x}^{3}),\\, & 0\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1\\le X<2) & ={\\int }_{1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{4}{27}(3{x}^{2}-{x}^{3})\\,\\text{d}x \\\\  & =\\frac{4}{27}{\\int }_{1}^{2}3{x}^{2}-{x}^{3}\\,\\text{d}x \\\\  & =\\frac{4}{27}{[{x}^{3}-\\frac{1}{4}{x}^{4}]}_{1}^{2} \\\\  & =\\frac{4}{27}([(2)^{3}-\\frac{1}{4}(2)^{4}]-[(1)^{3}-\\frac{1}{4}(1)^{4}]) \\\\  & =\\frac{4}{27}(8-4-\\frac{3}{4}) \\\\  & =\\frac{4}{27}\\cdot \\frac{13}{4} \\\\  & =\\frac{13}{27}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-158452/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19"] :knowledge-point/questions ["q-158452"] :db/ensure [:knowledge-point/validate]} {:db/id "q-158310/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "4087c25c-453a-5092-872d-0a4a3f68d25a" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-158310/selection/f2288f9352f7ca2a51938247a89477aea196296ae7b20690ce35ebb30dfe5331" :answer/id #uuid "418a146b-892e-5a04-bf03-f6b4c87741ea" :answer/type :answer.type/math :answer/value "\\frac{1}{16}" :db/ensure [:answer/validate]}