#{[{:db/id #edb/ref 17592186192299 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/id #uuid "65070836-e061-5fec-ae8d-263ef0c32659" :question/math-academy-id "e-10839" :question/problem "Compute $P\\left( 1 \\lt   X \\lt 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040290/assets/394c60a510e39043cda5072c0b57a663b200275035d72c15f20c5a257e6c4fc0.png)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\lt   X \\lt      b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1<X<3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{18}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{18}{\\int }_{1}^{3}({x}^{2}-1)\\,\\text{d}x \\\\  & =\\frac{1}{18}{[\\frac{1}{3}{x}^{3}-x]}_{1}^{3} \\\\  & =\\frac{1}{18}([\\frac{1}{3}(3)^{3}-(3)]-[\\frac{1}{3}(1)^{3}-(1)]) \\\\  & =\\frac{1}{18}([9-3]-[\\frac{1}{3}-1]) \\\\  & =\\frac{1}{18}(6+\\frac{2}{3}) \\\\  & =\\frac{1}{18}\\cdot \\frac{20}{3} \\\\  & =\\frac{10}{27}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192339 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/id #uuid "d8425df8-1fb2-5f59-a034-2b30f14b9b4b" :question/math-academy-id "e-11036" :question/problem "Compute $P\\left(  X \\leq 3 \\right)$ given that the random variable $X$ has the probability density function\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040290/assets/1cd6271fdb46d54db66d2b4f5acd10146f42a0dd64a3326ea7e53e07d4915633.png)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\leq X \\leq  b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSince $f(x)$ is identical to zero for all $x \\lt  2,$ we have\n\n$$\n\\begin{aligned}P(X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{2x}{45}\\,\\text{d}x \\\\  & ={[\\frac{1}{45}\\,{x}^{2}]}_{2}^{3} \\\\  & =\\frac{1}{45}({3}^{2}-{2}^{2}) \\\\  & =\\frac{1}{45}\\cdot 5 \\\\  & =\\frac{1}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186192340 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/id #uuid "4baa68f1-2f68-5df5-936a-aff56605ed8e" :question/math-academy-id "e-11038" :question/problem "Compute $P\\left( 2 \\leq          X \\leq          4 \\right)$ given that the random variable $X$ has the probability density function\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040290/assets/e01b36a6a2b00b47ce36b59d5b3e1a4fea4cbc26b0b7d46d60e40638161982d8.png)" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a \\leq        X \\leq        b) = \\int_a^b f(x) \\, \\textrm dx.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2\\le X\\le 4) & ={\\int }_{2}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{9}x\\,\\text{d}x+{\\int }_{3}^{4}(x-3)\\,\\text{d}x \\\\  & ={[\\frac{1}{18}{x}^{2}]}_{2}^{3}+{[\\frac{1}{2}{x}^{2}-3x]}_{3}^{4} \\\\  & =\\frac{1}{18}[{3}^{2}-{2}^{2}]+([\\frac{1}{2}(4)^{2}-3(4)]-[\\frac{1}{2}(3)^{2}-3(3)]) \\\\  & =\\frac{5}{18}-4+\\frac{9}{2} \\\\  & =\\frac{14}{18} \\\\  & =\\frac{7}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340882 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "082f456b-3a45-5c15-a26c-bf2e20b97858" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186340884} {:answer/id #uuid "1fbf0995-d3df-5eee-8b16-58ada4d38c03" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186340885} {:answer/id #uuid "2ebaaafd-6dad-5908-9265-6766d8a64e47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186340886} {:answer/id #uuid "f8081542-ae6a-5f40-a732-f7fa7d6821fb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{7}" :db/id #edb/ref 17592186340887} {:answer/id #uuid "bc1574c4-7fb3-5661-a707-aae0c0798de1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186340888}] :answer-field/correct {:answer/id #uuid "2ebaaafd-6dad-5908-9265-6766d8a64e47" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}" :db/id #edb/ref 17592186340886} :answer-field/id #uuid "967899f8-d994-5cff-827d-35b110af3d71" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340883}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7f74bd64-e9ed-5f64-bc7d-e5e5d2b6af20" :question/math-academy-id "q-158304" :question/problem "Compute $P(X\\le -1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{35}{x}^{2},\\, & -2\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<-2,$ we have\n\n$$\n\\begin{aligned}P(X\\le -1) & ={\\int }_{-2}^{-1}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-2}^{-1}\\frac{3}{35}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{35}{x}^{3}]}_{-2}^{-1} \\\\  & =\\frac{1}{35}[(-1)^{3}-(-2)^{3}] \\\\  & =\\frac{1}{35}(-1+8) \\\\  & =\\frac{1}{35}\\cdot 7 \\\\  & =\\frac{1}{5}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340889 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "807d00cb-0e14-5752-b513-426b9e1e21b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186340891} {:answer/id #uuid "d7f0cb36-df86-55e3-b085-495da2fbb4c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186340892} {:answer/id #uuid "1a8691a2-4664-5e5a-a274-5021bdf28f39" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186340893} {:answer/id #uuid "5905e17b-fd6d-5adf-bccf-7f54c4453a7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186340894} {:answer/id #uuid "660a1e8d-e8f8-53ee-815e-47dd6a346b18" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186340895}] :answer-field/correct {:answer/id #uuid "d7f0cb36-df86-55e3-b085-495da2fbb4c5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{9}" :db/id #edb/ref 17592186340892} :answer-field/id #uuid "22881c31-f713-5841-be94-f3bf570eed8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340890}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "85c3d5c4-3104-52f7-8a7e-28306e437eaf" :question/math-academy-id "q-158309" :question/problem "Compute $P(X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{24}({x}^{2}+1),\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x<1,$ we have\n\n$$\n\\begin{aligned}P(X\\le 3) & ={\\int }_{1}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{1}{24}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{1}{24}{\\int }_{1}^{3}{x}^{2}+1\\,\\text{d}x \\\\  & =\\frac{1}{24}{[\\frac{{x}^{3}}{3}+x]}_{1}^{3} \\\\  & =\\frac{1}{24}[(\\frac{{3}^{3}}{3}+3)-(\\frac{1}{3}+1)] \\\\  & =\\frac{1}{24}(12-\\frac{4}{3}) \\\\  & =\\frac{1}{24}\\cdot \\frac{32}{3} \\\\  & =\\frac{4}{9}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340896 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "dab84539-6a17-57a8-82ab-f8719559f2a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186340898} {:answer/id #uuid "223ade67-2157-502a-be9c-571f7f47e738" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186340899} {:answer/id #uuid "4087c25c-453a-5092-872d-0a4a3f68d25a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186340900} {:answer/id #uuid "0fde857b-85e0-5131-87aa-f8748e985598" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186340901} {:answer/id #uuid "418a146b-892e-5a04-bf03-f6b4c87741ea" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{16}" :db/id #edb/ref 17592186340902}] :answer-field/correct {:answer/id #uuid "dab84539-6a17-57a8-82ab-f8719559f2a1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186340898} :answer-field/id #uuid "54392b3d-5d11-51d0-874d-bec760b5f507" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340897}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "67abe808-0acc-58a5-bc23-38d5e844f080" :question/math-academy-id "q-158310" :question/problem "Compute $P(X>-3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{72}{x}^{2},\\, & -6\\le x\\le 0, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>0,$ we have\n\n$$\n\\begin{aligned}P(X>-3) & ={\\int }_{-3}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-3}^{0}\\frac{1}{72}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{216}{x}^{3}]}_{-3}^{0} \\\\  & =\\frac{1}{216}[(0)^{3}-(-3)^{3}] \\\\  & =\\frac{27}{216} \\\\  & =\\frac{1}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340903 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a08dc51e-f07f-5581-8362-839fa937d718" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{8}" :db/id #edb/ref 17592186340905} {:answer/id #uuid "1d97e720-6e90-59eb-bb75-1018365114d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186340906} {:answer/id #uuid "d634a8b0-98a0-5eb9-965e-132c93482886" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186340907} {:answer/id #uuid "e508d937-fabd-5456-90c1-47690c820042" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186340908} {:answer/id #uuid "a7732b29-e0f5-5dc6-8d70-a475b50a7b5f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186340909}] :answer-field/correct {:answer/id #uuid "1d97e720-6e90-59eb-bb75-1018365114d0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{16}" :db/id #edb/ref 17592186340906} :answer-field/id #uuid "d861adc7-402b-55eb-b41e-bd7d76a7ae47" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340904}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0a1b2372-d304-559c-a5fd-6cbd8c7c1382" :question/math-academy-id "q-158353" :question/problem "Compute $P(1<X<2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{20}{x}^{3},\\, & 1\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1<X<2) & ={\\int }_{1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{1}{20}{x}^{3}\\,\\text{d}x \\\\  & ={[\\frac{1}{80}{x}^{4}]}_{1}^{2} \\\\  & =\\frac{1}{80}(16-1) \\\\  & =\\frac{3}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340910 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7a9718d8-0d35-5956-87e9-14038de5db19" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{7}" :db/id #edb/ref 17592186340912} {:answer/id #uuid "8ae49b17-0aa0-5bde-8678-fee80e49a909" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{14}" :db/id #edb/ref 17592186340913} {:answer/id #uuid "20b986a5-3559-5209-b25f-184ffd671f69" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{11}{14}" :db/id #edb/ref 17592186340914} {:answer/id #uuid "489d83b5-3baf-5a69-aed0-8407eac49448" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{14}" :db/id #edb/ref 17592186340915} {:answer/id #uuid "089c922f-24dd-5ed1-94ed-7626786a8ca2" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{7}" :db/id #edb/ref 17592186340916}] :answer-field/correct {:answer/id #uuid "8ae49b17-0aa0-5bde-8678-fee80e49a909" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{14}" :db/id #edb/ref 17592186340913} :answer-field/id #uuid "8bc2aef9-eb9b-5d4d-a07d-acf17d764b44" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340911}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a3a85b19-979f-52ec-b4d9-f19bf94105c1" :question/math-academy-id "q-158360" :question/problem "Compute $P(X>-1)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{28}({x}^{2}+1),\\, & -2\\le x\\le 2, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>2,$ we have\n\n$$\n\\begin{aligned}P(X>-1) & ={\\int }_{-1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{2}\\frac{3}{28}({x}^{2}+1)\\,\\text{d}x \\\\  & =\\frac{3}{28}{\\int }_{-1}^{2}{x}^{2}+1\\,\\text{d}x \\\\  & =\\frac{3}{28}{[\\frac{1}{3}{x}^{3}+x]}_{-1}^{2} \\\\  & =\\frac{3}{28}([\\frac{1}{3}(2)^{3}+(2)]-[\\frac{1}{3}(-1)^{3}+(-1)]) \\\\  & =\\frac{3}{28}([\\frac{8}{3}+2]-[-\\frac{1}{3}-1]) \\\\  & =\\frac{3}{28}\\cdot 6 \\\\  & =\\frac{9}{14}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340917 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "79d591a6-3320-5a74-8fd1-b6c5b2e51371" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{21}" :db/id #edb/ref 17592186340919} {:answer/id #uuid "797ef9c6-0165-520f-a716-bd712a206a6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{14}{63}" :db/id #edb/ref 17592186340920} {:answer/id #uuid "cb2938b5-636a-5e2e-87fb-efb2b44232d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{63}" :db/id #edb/ref 17592186340921} {:answer/id #uuid "fa5c3841-c5de-5b82-b8b8-27648ea8734e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{21}" :db/id #edb/ref 17592186340922} {:answer/id #uuid "1650dcce-d40b-53dc-81c9-e42a41be0921" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{17}{21}" :db/id #edb/ref 17592186340923}] :answer-field/correct {:answer/id #uuid "cb2938b5-636a-5e2e-87fb-efb2b44232d4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{63}" :db/id #edb/ref 17592186340921} :answer-field/id #uuid "6de0d018-78b1-5019-8635-c12bc2136a3f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340918}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cd66b9ef-b164-5b8b-ab3b-c7d89adda477" :question/math-academy-id "q-158364" :question/problem "Compute $P(2<X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{21}{x}^{2},\\, & 1\\le x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{21}{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{1}{63}{x}^{3}]}_{2}^{3} \\\\  & =\\frac{1}{63}(27-8) \\\\  & =\\frac{19}{63}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340924 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b214588-7ffe-594d-8e98-cff3a3586741" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186340926} {:answer/id #uuid "5a503ce2-5470-5afd-980c-a9190fafd362" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186340927} {:answer/id #uuid "3138da82-1afc-5ce8-b4c6-4d474f5e2fcd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{10}{27}" :db/id #edb/ref 17592186340928} {:answer/id #uuid "55933809-afdb-548f-968d-4d391dabfed1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186340929} {:answer/id #uuid "57076a80-aae6-5d99-9dff-667537a780b8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{27}" :db/id #edb/ref 17592186340930}] :answer-field/correct {:answer/id #uuid "55933809-afdb-548f-968d-4d391dabfed1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186340929} :answer-field/id #uuid "ea954d53-502a-5ae1-8522-8c67e9f8b18a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340925}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "14603c57-2009-5dee-b326-f25e938d142f" :question/math-academy-id "q-158365" :question/problem "Compute $P(-1<X\\le 0)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{2}{9}(x+2)(1-x),\\, & -2\\le x\\le 1, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1<X\\le 0) & ={\\int }_{-1}^{0}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{0}\\frac{2}{9}(x+2)(1-x)\\,\\text{d}x \\\\  & =\\frac{2}{9}{\\int }_{-1}^{0}(-{x}^{2}-x+2)\\,\\text{d}x \\\\  & =\\frac{2}{9}{[-\\frac{1}{3}{x}^{3}-\\frac{1}{2}{x}^{2}+2x]}_{-1}^{0} \\\\  & =\\frac{2}{9}([-\\frac{1}{3}(0)^{3}-\\frac{1}{2}(0)^{2}+2(0)]-[-\\frac{1}{3}(-1)^{3}-\\frac{1}{2}(1)^{2}+2(-1)]) \\\\  & =\\frac{2}{9}(0-[\\frac{1}{3}-\\frac{1}{2}-2]) \\\\  & =\\frac{2}{9}\\cdot \\frac{13}{6} \\\\  & =\\frac{13}{27}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340931 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "833ad217-2289-558b-af29-312d1d686ea8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186340933} {:answer/id #uuid "67224693-cc96-58b0-b346-59c6273369ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186340934} {:answer/id #uuid "3722cff6-bc0a-5d86-a829-d774474a396a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186340935} {:answer/id #uuid "368967a2-9d69-58d9-b55a-0d9518749f2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{6}" :db/id #edb/ref 17592186340936} {:answer/id #uuid "33cd8734-5b15-53bf-bed3-5bf32a7cf443" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186340937}] :answer-field/correct {:answer/id #uuid "67224693-cc96-58b0-b346-59c6273369ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186340934} :answer-field/id #uuid "f184288c-d128-50e2-ab84-0e0d249c368a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340932}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "95c89b76-387e-5207-81b9-29146c50eb5b" :question/math-academy-id "q-158415" :question/problem "Compute $P(2<X\\le 3)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{6}x,\\, & 1\\le x\\le 3, \\\\ \\frac{1}{3} & 3<x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X\\le 3) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{1}{6}x\\,\\text{d}x \\\\  & ={[\\frac{1}{12}{x}^{2}]}_{2}^{3} \\\\  & =\\frac{1}{12}[{3}^{2}-{2}^{2}] \\\\  & =\\frac{1}{12}(9-4) \\\\  & =\\frac{5}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340938 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71f1b8e9-3c3e-528d-87d2-9134c0cd6d62" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186340940} {:answer/id #uuid "3d909980-0bf4-55ac-86d5-63b1aa81e5c8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186340941} {:answer/id #uuid "6a7a2705-c9f3-54e5-8114-95144d10e5a9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{18}" :db/id #edb/ref 17592186340942} {:answer/id #uuid "d0de70b6-e0b9-57a4-acd7-2c3424505756" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186340943} {:answer/id #uuid "487e2ef8-6d1d-52ba-bda3-fcd9d1f47688" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{9}" :db/id #edb/ref 17592186340944}] :answer-field/correct {:answer/id #uuid "d0de70b6-e0b9-57a4-acd7-2c3424505756" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{18}" :db/id #edb/ref 17592186340943} :answer-field/id #uuid "7dd41cce-e9a8-5cfb-bb8e-7c317afd0ee6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340939}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cc19abda-ad88-5df7-a150-331010d50f44" :question/math-academy-id "q-158420" :question/problem "Compute $P(3<X<4)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{4}{x}^{2},\\, & -1\\le x\\le 1, \\\\ \\frac{1}{9}(x-1) & 1<x\\le 4, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(3<X<4) & ={\\int }_{3}^{4}f(x)\\,\\text{d}x \\\\  & ={\\int }_{3}^{4}\\frac{1}{9}(x-1)\\,\\text{d}x \\\\  & =\\frac{1}{9}{[\\frac{1}{2}{x}^{2}-x]}_{3}^{4} \\\\  & =\\frac{1}{9}([\\frac{1}{2}(4)^{2}-(4)]-[\\frac{1}{2}(3)^{2}-(3)]) \\\\  & =\\frac{1}{9}(8-4-\\frac{9}{2}+3) \\\\  & =\\frac{1}{9}(\\frac{5}{2}) \\\\  & =\\frac{5}{18}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340945 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6be4ef2a-4dfd-5522-b090-1511b57a078a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186340947} {:answer/id #uuid "41ade935-ca9f-592b-b040-91e5333de0db" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186340948} {:answer/id #uuid "8c2c7783-498a-534c-889c-1b6ed8428e9f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{6}" :db/id #edb/ref 17592186340949} {:answer/id #uuid "e3c9e206-083e-5758-b879-66a0b522fbf8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186340950} {:answer/id #uuid "51ab03ff-fd7f-50d5-b680-e095b72fe269" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186340951}] :answer-field/correct {:answer/id #uuid "6be4ef2a-4dfd-5522-b090-1511b57a078a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{12}" :db/id #edb/ref 17592186340947} :answer-field/id #uuid "f03bc6a4-9ed7-5697-a80a-d31d2a2f8a69" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340946}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "997215ba-5db0-5cc7-bb9c-ac5ba657c4ba" :question/math-academy-id "q-158436" :question/problem "Compute $P(0\\le X\\le 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{2}{5}x(x+1),\\, & 0\\le x<1, \\\\ \\frac{1}{6}x & 1\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0\\le X\\le 2) & ={\\int }_{0}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{2}{5}x(x+1)\\,\\text{d}x+{\\int }_{1}^{2}\\frac{1}{6}x\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{2}{5}({x}^{2}+x)\\,\\text{d}x+{\\int }_{1}^{2}\\frac{1}{6}x\\,\\text{d}x \\\\  & =\\frac{2}{5}{[\\frac{1}{3}{x}^{3}+\\frac{1}{2}{x}^{2}]}_{0}^{1}+{[\\frac{1}{12}{x}^{2}]}_{1}^{2} \\\\  & =\\frac{2}{5}([\\frac{1}{3}(1)^{3}+\\frac{1}{2}(1)^{2}]-[\\frac{1}{3}(0)^{3}+\\frac{1}{2}(0)^{2}])+\\frac{1}{12}[{2}^{2}-{1}^{2}] \\\\  & =\\frac{2}{5}(\\frac{5}{6})+\\frac{1}{4} \\\\  & =\\frac{1}{3}+\\frac{1}{4} \\\\  & =\\frac{7}{12}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340952 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a6caa34-0e96-5b54-887c-adf2abb2b3e1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{24}" :db/id #edb/ref 17592186340954} {:answer/id #uuid "583cb40d-2b17-5674-945a-223a1cfa0953" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{16}" :db/id #edb/ref 17592186340955} {:answer/id #uuid "75e86377-e956-5315-8c92-7bcde2548261" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{16}" :db/id #edb/ref 17592186340956} {:answer/id #uuid "0fa73fc7-cc8b-53b8-924e-5ae02f283330" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186340957} {:answer/id #uuid "c9e26a91-5872-5b07-b2bd-8722efa0d26b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{24}" :db/id #edb/ref 17592186340958}] :answer-field/correct {:answer/id #uuid "583cb40d-2b17-5674-945a-223a1cfa0953" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{16}" :db/id #edb/ref 17592186340955} :answer-field/id #uuid "1c2d74b6-7b2d-56ee-be20-23f4a0ea6be3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340953}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3d314a23-a8eb-5c75-bd4d-fd365ca8fde0" :question/math-academy-id "q-158443" :question/problem "Compute $P(0<X\\le 5)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{4}({x}^{3}+1),\\, & -1\\le x<1, \\\\ \\frac{1}{24}x & 1\\le x\\le 5, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(0<X\\le 5) & ={\\int }_{0}^{5}f(x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\frac{1}{4}({x}^{3}+1)\\,\\text{d}x+{\\int }_{1}^{5}\\frac{1}{24}x\\,\\text{d}x \\\\  & =\\frac{1}{4}{[\\frac{1}{4}{x}^{4}+x]}_{0}^{1}+{[\\frac{1}{48}{x}^{2}]}_{1}^{5} \\\\  & =\\frac{1}{4}([\\frac{1}{4}(1)^{4}+1]-[\\frac{1}{4}(0)^{4}+0])+\\frac{1}{48}[{5}^{2}-{1}^{2}] \\\\  & =\\frac{1}{4}(\\frac{5}{4})+\\frac{1}{2} \\\\  & =\\frac{5}{16}+\\frac{1}{2} \\\\  & =\\frac{13}{16}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340959 :knowledge-point/_questions [{:knowledge-point/id #uuid "17408f35-ef57-5eb2-8cb6-3a946194d2d3" :knowledge-point/title "Calculating Probabilities With Piecewise PDFs"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eed4a02f-ecf0-55a1-9c2a-881879cfb13c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{9}{20}" :db/id #edb/ref 17592186340961} {:answer/id #uuid "0aeeb80e-61ff-5800-9107-9d98aa874ad1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{60}" :db/id #edb/ref 17592186340962} {:answer/id #uuid "434c2a72-3eb4-59f5-af9c-44e40ea213ed" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{60}" :db/id #edb/ref 17592186340963} {:answer/id #uuid "4445cc9a-1d55-5b4a-907a-5cad20f86f48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{30}" :db/id #edb/ref 17592186340964} {:answer/id #uuid "cb84a5a6-bfca-58c3-b62c-0b25c6ae3699" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{20}" :db/id #edb/ref 17592186340965}] :answer-field/correct {:answer/id #uuid "0aeeb80e-61ff-5800-9107-9d98aa874ad1" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{19}{60}" :db/id #edb/ref 17592186340962} :answer-field/id #uuid "16fcd673-1e6e-51d6-9690-d893307508e8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340960}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f73d4938-e911-5c1c-a1ab-37f7eb97df84" :question/math-academy-id "q-158445" :question/problem "Compute $P(-1\\le X\\le 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{10}({x}^{2}+1),\\, & -2\\le x\\le 1, \\\\ \\frac{1}{20} & 1<x\\le 9, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(-1\\le X\\le 2) & ={\\int }_{-1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{-1}^{1}\\frac{1}{10}({x}^{2}+1)\\,\\text{d}x+{\\int }_{1}^{2}\\frac{1}{20}\\,\\text{d}x \\\\  & =\\frac{1}{10}{[\\frac{1}{3}{x}^{3}+x]}_{-1}^{1}+{[\\frac{1}{20}x]}_{1}^{2} \\\\  & =\\frac{1}{10}([\\frac{1}{3}(1)^{3}+1]-[\\frac{1}{3}(-1)^{3}+(-1)])+\\frac{1}{20}(2-1) \\\\  & =\\frac{1}{10}(\\frac{8}{3})+\\frac{1}{20} \\\\  & =\\frac{4}{15}+\\frac{1}{20} \\\\  & =\\frac{19}{60}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340966 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "408c691c-9077-55ae-a5d1-039340b18eff" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{9}" :db/id #edb/ref 17592186340968} {:answer/id #uuid "bf2d73a2-a9b0-5ed8-8ab4-cbd2c41567e3" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{9}" :db/id #edb/ref 17592186340969} {:answer/id #uuid "100ba1ae-1ee5-5f5d-a7bc-ad198aaf3b02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186340970} {:answer/id #uuid "f68f67af-fdf7-5dbb-b534-7055b6372e48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{18}" :db/id #edb/ref 17592186340971} {:answer/id #uuid "b6cd5c91-aeb4-509a-a24a-8bd0917092ab" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{16}{27}" :db/id #edb/ref 17592186340972}] :answer-field/correct {:answer/id #uuid "100ba1ae-1ee5-5f5d-a7bc-ad198aaf3b02" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{13}{27}" :db/id #edb/ref 17592186340970} :answer-field/id #uuid "b7886592-e35c-56fb-97ce-fea0a9eec751" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340967}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "05b93f7d-4aad-511e-a889-e099b2aab1c3" :question/math-academy-id "q-158452" :question/problem "Compute $P(1\\le X<2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{4}{27}(3{x}^{2}-{x}^{3}),\\, & 0\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(1\\le X<2) & ={\\int }_{1}^{2}f(x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{4}{27}(3{x}^{2}-{x}^{3})\\,\\text{d}x \\\\  & =\\frac{4}{27}{\\int }_{1}^{2}3{x}^{2}-{x}^{3}\\,\\text{d}x \\\\  & =\\frac{4}{27}{[{x}^{3}-\\frac{1}{4}{x}^{4}]}_{1}^{2} \\\\  & =\\frac{4}{27}([(2)^{3}-\\frac{1}{4}(2)^{4}]-[(1)^{3}-\\frac{1}{4}(1)^{4}]) \\\\  & =\\frac{4}{27}(8-4-\\frac{3}{4}) \\\\  & =\\frac{4}{27}\\cdot \\frac{13}{4} \\\\  & =\\frac{13}{27}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186340973 :knowledge-point/_questions [{:knowledge-point/id #uuid "1e723a34-c6e1-5827-87ad-866cbaeef98c" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within an Unbounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8895af1a-36d5-5abd-83e0-50fd84037cfd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}" :db/id #edb/ref 17592186340975} {:answer/id #uuid "a64852e3-1625-5597-9171-f3f3f09e68b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186340976} {:answer/id #uuid "cb60b298-2d9e-54a8-bf39-d0e4ae442527" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{8}" :db/id #edb/ref 17592186340977} {:answer/id #uuid "a3faf377-ad50-5425-8315-6f8684066f7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186340978} {:answer/id #uuid "fe72b249-b61e-558a-a5dc-43986c91fb7e" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{8}" :db/id #edb/ref 17592186340979}] :answer-field/correct {:answer/id #uuid "a64852e3-1625-5597-9171-f3f3f09e68b9" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{8}" :db/id #edb/ref 17592186340976} :answer-field/id #uuid "f40d7bde-1dda-52ec-bfd6-41c200409d55" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186340974}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "cf0e3a92-9f57-5c19-8c59-f00566822c2d" :question/math-academy-id "q-158454" :question/problem "Compute $P(X\\ge 2)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{3}{34}({x}^{3}-{x}^{2}),\\, & 1\\le x\\le 3, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a\\le X\\le b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSince $f(x)$ is identical to zero for all $x>3,$ we have\n\n$$\n\\begin{aligned}P(X\\ge 2) & ={\\int }_{2}^{3}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{3}\\frac{3}{34}({x}^{3}-{x}^{2})\\,\\text{d}x \\\\  & =\\frac{3}{34}{\\int }_{2}^{3}{x}^{3}-{x}^{2}\\,\\text{d}x \\\\  & =\\frac{3}{34}{[\\frac{1}{4}{x}^{4}-\\frac{1}{3}{x}^{3}]}_{2}^{3} \\\\  & =\\frac{3}{34}([\\frac{1}{4}(3)^{4}-\\frac{1}{3}(3)^{3}]-[\\frac{1}{4}(2)^{4}-\\frac{1}{3}(2)^{3}]) \\\\  & =\\frac{3}{34}([\\frac{81}{4}-9]-[4-\\frac{8}{3}]) \\\\  & =\\frac{3}{34}\\cdot \\frac{119}{12} \\\\  & =\\frac{7}{8}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186193216 :knowledge-point/_questions [{:knowledge-point/id #uuid "fe4b690c-94a9-5a27-b0e8-5583ba6dba19" :knowledge-point/title "Computing the Probability That a Random Variable Lies Within a Bounded Interval"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8165db7c-119f-52d5-8190-74e763f05248" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{5}" :db/id #edb/ref 17592186192085} {:answer/id #uuid "8aab2f28-f15a-5a21-a25c-5049d55ed874" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186192086} {:answer/id #uuid "24611dd8-0902-59b4-bddc-2420a314fbdb" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{4}" :db/id #edb/ref 17592186192087} {:answer/id #uuid "2f40af29-bef0-50e2-9b79-d4bd79c1d3f8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{10}" :db/id #edb/ref 17592186192088} {:answer/id #uuid "3ef4a551-4e87-5cf5-a699-4304df056b1a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{4}" :db/id #edb/ref 17592186192089}] :answer-field/correct {:answer/id #uuid "8aab2f28-f15a-5a21-a25c-5049d55ed874" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186192086} :answer-field/id #uuid "1903b71a-d4dc-58a1-b50d-306551c8b8c0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186192084}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7d522d4b-cd13-5ffd-9293-3255ca27b6de" :question/math-academy-id "q-86913" :question/problem "Compute $P(2<X<8)$ given that the random variable $X$ has the probability density function\n\n$$\nf(x)={\\begin{aligned}\\frac{1}{50}x,\\, & 0\\le x\\le 10, \\\\ 0,\\, & \\text{otherwise.}\\end{aligned}\n$$" :question/worked-solution "If a continuous random variable $X$ has the probability density function $f(x),$ then \n\n$$\nP(a<X<b)={\\int }_{a}^{b}f(x)\\,\\text{d}x.\n$$\n\nSo, in our case, we have\n\n$$\n\\begin{aligned}P(2<X<8) & ={\\int }_{2}^{8}f(x)\\,\\text{d}x \\\\  & ={\\int }_{2}^{8}\\frac{1}{50}x\\,\\text{d}x \\\\  & ={[\\frac{1}{100}{x}^{2}]}_{2}^{8} \\\\  & =\\frac{3}{5}.\\end{aligned}\n$$"}]}
