[{:db/id "q-72120/selection/dc6dce97eee88e06bd67445e12e9eec4463cadc57a96106089c39165f6680307" :answer/id #uuid "72f6b3dd-ab6b-57d1-bb01-7042a76c60d5" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/205fdc7a29c94d36b5bd8847a2600c41d7e3fd2ac0fd92947dddcb241bdae012.png" :db/ensure [:answer/validate]} {:db/id "q-72120/selection/0354505604701b619a671b763f5b4a7aa161477736cea57687f5ba497cf12c07" :answer/id #uuid "c211c0bb-4786-5b31-8cd3-53d57c2a2aed" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/edbcc3bcef921ef736f9bd31bec56f69736c632bf835cf4c9c1c46026fda8083.png" :db/ensure [:answer/validate]} {:db/id "q-72120/selection/b260aef9524b6483ac8aa68e8b60fd3646719f85aea804ef50d218b9097cbf49" :answer/id #uuid "4db91dbf-2c82-5d39-be40-228a85482ec8" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/a216b288b70301fb14b8f1219b909edb69ab77b08c29460b5522abc2025ab494.png" :db/ensure [:answer/validate]} {:db/id "q-72120/selection/a03f27e401faa9bc6b1d13e706f71e277ea06d6a2ef0594a707ee415ad047e1a" :answer/id #uuid "29b243ed-bb8f-5106-9f48-071a649c79a6" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/254691f56d0586b2cbfd75a3fce34ecc1062b0f0fde538d3885860ed1b71555c.png" :db/ensure [:answer/validate]} {:db/id "q-72120/selection/421ba3cf61c86c7d854403490925f53920cd3c015c12342698571d9a74aca2fd" :answer/id #uuid "4096ed5f-cb30-5202-b66e-8a4cccb2f3fa" :answer/type :answer.type/text :answer/value "None of the listed" :db/ensure [:answer/validate]} {:db/id "q-72120/selection" :answer-field/id #uuid "29e5b759-6419-5649-912b-d0b5e585caff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72120/selection/b260aef9524b6483ac8aa68e8b60fd3646719f85aea804ef50d218b9097cbf49" :answer-field/choices ["q-72120/selection/dc6dce97eee88e06bd67445e12e9eec4463cadc57a96106089c39165f6680307" "q-72120/selection/0354505604701b619a671b763f5b4a7aa161477736cea57687f5ba497cf12c07" "q-72120/selection/b260aef9524b6483ac8aa68e8b60fd3646719f85aea804ef50d218b9097cbf49" "q-72120/selection/a03f27e401faa9bc6b1d13e706f71e277ea06d6a2ef0594a707ee415ad047e1a" "q-72120/selection/421ba3cf61c86c7d854403490925f53920cd3c015c12342698571d9a74aca2fd"] :db/ensure [:answer-field/validate]} {:db/id "q-72120" :question/id #uuid "13be6924-14b7-5b8e-8469-18a97723bd20" :question/math-academy-id "q-72120" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/e472070f17c47e78024217ed750690b88de87f3849818368dda1dde5d91d90d4.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-72120/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030"] :knowledge-point/questions ["q-72120"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72187/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "e94d84b2-6593-5b61-9fcc-9f84995d5b70" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-72187/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "f87af83b-1d44-57c7-ae72-3298903b2949" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-72187/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "7615ac9e-74d3-5650-a9b6-e60d2b701789" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-72187/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "3d6a87aa-9f4d-51df-9433-16f81d9f4e5e" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-72187/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "e2227f36-a800-5719-be24-a86931609ab6" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-72187/selection" :answer-field/id #uuid "b07cd557-7b2d-59e4-a317-38bf25ba00de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72187/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-72187/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-72187/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-72187/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-72187/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-72187/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-72187" :question/id #uuid "0297c74f-edaa-5272-9403-0b2ea78a826b" :question/math-academy-id "q-72187" :question/problem "Which of the following statements are true regarding the finite region bounded between the circles ${x}^{2}+{y}^{2}=2$ and ${x}^{2}+{y}^{2}=1?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/28290c5530efd27a979f4284481ca7e0384342d7d426dde0ab36894a0d77a166.png)\n\nWe have the following:\n\n- The vertical line $x=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/3007cffb725faee44d2a06ad077eec630791b1a94c373a323f62d0d721c87207.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/383f88668435556d3a856cf852caf548b1f1bf3a90d50f9d85d7968188984804.png)\n\nTherefore, only statement III is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-72187/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004"] :knowledge-point/questions ["q-72187"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73534/selection/b1c6a63d26f12eebd1a623bd4f11ae7ddaf34c677a265063b22eb64cf04bae65" :answer/id #uuid "f31f41d9-9e2f-50b4-b9cc-be541285d6cb" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,\\sqrt{y}\\le y\\le \\frac{y}{2},\\,1\\le x\\le 3}" :db/ensure [:answer/validate]} {:db/id "q-73534/selection/2e58d163ac5016cd6e7bf0d4cfdc0d44409372a3d97796f1f06875a782bb0414" :answer/id #uuid "769a042b-6c43-5933-abce-3b28a59894f5" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,-\\sqrt{y}+2\\le y\\le -\\frac{y}{2}+3,\\,1\\le x\\le 3}" :db/ensure [:answer/validate]} {:db/id "q-73534/selection/163ac1fffa54f5e61fb66316a900f278441b26df39107c42bb15c92d298c705a" :answer/id #uuid "891ee1f4-28d7-5f47-b3ad-d79948c3c2ed" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,0\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le 2.5}" :db/ensure [:answer/validate]} {:db/id "q-73534/selection/21199e0bafe4a13b5a5aa50f9c2a09f2c114893bbfddfb34e0db06de4e17d221" :answer/id #uuid "0687b10a-8bb6-5bea-9e64-06648688887d" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3}" :db/ensure [:answer/validate]} {:db/id "q-73534/selection/87f3635d84e487c521d74f6f23d179d2401bb1a51d2884b60ab5be158a2cab52" :answer/id #uuid "070990ba-6c96-5a82-8595-b7483dc33725" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+3\\le x\\le \\frac{y}{2}+2}" :db/ensure [:answer/validate]} {:db/id "q-73534/selection" :answer-field/id #uuid "200460d2-ab2d-5bdd-a777-13bdc320d719" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73534/selection/21199e0bafe4a13b5a5aa50f9c2a09f2c114893bbfddfb34e0db06de4e17d221" :answer-field/choices ["q-73534/selection/b1c6a63d26f12eebd1a623bd4f11ae7ddaf34c677a265063b22eb64cf04bae65" "q-73534/selection/2e58d163ac5016cd6e7bf0d4cfdc0d44409372a3d97796f1f06875a782bb0414" "q-73534/selection/163ac1fffa54f5e61fb66316a900f278441b26df39107c42bb15c92d298c705a" "q-73534/selection/21199e0bafe4a13b5a5aa50f9c2a09f2c114893bbfddfb34e0db06de4e17d221" "q-73534/selection/87f3635d84e487c521d74f6f23d179d2401bb1a51d2884b60ab5be158a2cab52"] :db/ensure [:answer-field/validate]} {:db/id "q-73534" :question/id #uuid "52e9f0f2-4ec3-5721-8d20-94a9b2524d76" :question/math-academy-id "q-73534" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/c316b62d5c1a08c6513413fd87c36c6feb26fb632709909a9c9f761d0806c4af.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny=-2(x-3)\\,⟹\\,x=-\\frac{y}{2}+3\n$$\n\nThe function $x=-\\sqrt{y}+2$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=1$ and $y=3.$ So, we have $1\\le y\\le 3.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/fb05eec73599c1beb8dd588c478208315f6edaf10af999115eb29fa10d5601e9.png)\n\nThe horizontal line enters the region through the lower function $x=-\\sqrt{y}+2$ and leaves through the upper function $x=-\\frac{y}{2}+3.$ So, we have $-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le y\\le 3,\\,-\\sqrt{y}+2\\le x\\le -\\frac{y}{2}+3}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73534/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030"] :knowledge-point/questions ["q-73534"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73549/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "55343a6b-ab48-59c8-8920-2a8ee7fd127e" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-73549/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "d66fe113-7103-5577-af51-2ccc618c52db" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-73549/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "822b1574-d9ba-5496-b6f1-b66507070db1" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-73549/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "7f42f4c0-db4f-5d18-a638-d9cbfbd3621f" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-73549/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "faf3d87f-2637-5965-b5d7-2cf0993cbeff" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-73549/selection" :answer-field/id #uuid "41c4d894-a8bb-5d54-932f-f2dc5e6fe1d5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-73549/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-73549/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-73549/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-73549/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-73549/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-73549/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-73549" :question/id #uuid "563138f8-01f5-57ab-ac48-4930b8f810ac" :question/math-academy-id "q-73549" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $4{x}^{2}+{y}^{2}=4$ and $4{x}^{2}+{y}^{2}=1?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/627e7e102a0f16cb0c4946e42b48ad122299d729c5bc419293e258a3f2e1701e.png)\n\nWe have the following:\n\n- The vertical line $x=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/d7aa48c887d6fb1c3d0420867b7e74010fa93e16d7e24317e2cf214764e56113.png)\n\n- The horizontal line $y=0.5$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/ec632fa5f86d8d9b34b9ccf661a3219e965f289c28bf69d7d80eeeb46093e7ae.png)\n\nTherefore, only statement III is true." :question/difficulty :question.difficulty/hard :question/answer-fields ["q-73549/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004"] :knowledge-point/questions ["q-73549"] :db/ensure [:knowledge-point/validate]} {:db/id "q-168841/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "452bb30a-1ef6-5d9d-a817-6b89c95401da" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-168841/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "07521f48-8704-5446-aced-a64d468260e9" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-168841/selection/5267565fb670f61c6c24e0670f2fb4f745887a45a1d2648084130ba9de933c0a" :answer/id #uuid "817929ac-9631-5f21-8068-f4478a0cdb0e" :answer/type :answer.type/text :answer/value "I  and II only" :db/ensure [:answer/validate]} {:db/id "q-168841/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "b3f569ce-3662-5f90-a55e-c243afd99bb8" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-168841/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "304db9d7-feaf-5f75-baa8-b91e27bb06ff" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-168841/selection" :answer-field/id #uuid "55d09e2d-226b-5afa-9542-88d31ce647e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-168841/selection/5267565fb670f61c6c24e0670f2fb4f745887a45a1d2648084130ba9de933c0a" :answer-field/choices ["q-168841/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-168841/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-168841/selection/5267565fb670f61c6c24e0670f2fb4f745887a45a1d2648084130ba9de933c0a" "q-168841/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-168841/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-168841" :question/id #uuid "c9b9af43-228c-5217-bb35-e67966831f35" :question/math-academy-id "q-168841" :question/problem "Which of the following statements are true regarding the triangle bounded between the lines $y=1-x,$ $y=x-1,$ and $x=0?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}y=1-x\\, & ⟹\\,x=1-y \\\\ y=x-1\\, & ⟹\\,x=y+1.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048050/assets/27503f983e3e02fa748bb8ef32966a6cd3b5fff29082ffaf3c10d0521b630e93.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 1,\\,x-1\\le y\\le 1-x}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-1\\le y\\le 1,\\,0\\le x\\le 1-|y|}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-168841/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004"] :knowledge-point/questions ["q-168841"] :db/ensure [:knowledge-point/validate]}]
