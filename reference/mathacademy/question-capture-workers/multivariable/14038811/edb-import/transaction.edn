ction/421ba3cf61c86c7d854403490925f53920cd3c015c12342698571d9a74aca2fd" "q-168140/selection/85ff203d4b43a02297f847941b26c8cdcff4b563658b65b5a232becbc5433684" "q-168140/selection/3a4ce79787cbc5d149eb4bab48deb90c102169638e4b281e315ea31829668b3d" "q-168140/selection/6e4263ec1161866473c997f3c3edf422071809725c4a12e5f534bf8ed250d3d7" "q-168140/selection/96b19a917e40f595a2b10640f23c817f1ea771fcb14942345a93893af49568ef"] :db/ensure [:answer-field/validate]} {:db/id "q-168140" :question/id #uuid "2da77bc4-04e1-56ef-a7c8-2c62ea7852fc" :question/math-academy-id "q-168140" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/1bee7870760a7c267ca83806f04b3fa8b933891fa5e5524ce76ee09f2c7c98e0.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-168140/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030"] :knowledge-point/questions ["q-168140"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72140/selection/f36853c1f5bbf95984d4f608e5c15b7a2eff651c368df7a45d7b26f0c0b2aa1e" :answer/id #uuid "d0aa53d2-389f-5c75-90b4-2fa799a6e9da" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1}" :db/ensure [:answer/validate]} {:db/id "q-72140/selection/5dfb05eb5514dcd8cebfefc0dabed21cb4907ff8d0838b95f08eb24f91a84cec" :answer/id #uuid "dadb8f1f-d58a-5014-9e46-3cfe88e179a7" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,0\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1}" :db/ensure [:answer/validate]} {:db/id "q-72140/selection/c4708fa5a9a65d6c37c111d81108e5bc80f8459943a1d33a7f28e40a30742718" :answer/id #uuid "1549f265-e8a4-5a1e-b8c2-5b45fb3f2cc5" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}-1}" :db/ensure [:answer/validate]} {:db/id "q-72140/selection/53d5e89a0b347ba45520c762c753c9e57f3c88d335ce2263b5d335ec46b46aca" :answer/id #uuid "0b4bcf37-9377-578c-945a-9e418d316e9d" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,1\\le y\\le 2(x-1)^{3}+1,\\,1\\le x\\le 2}" :db/ensure [:answer/validate]} {:db/id "q-72140/selection/58991a4d56f2c08423ad57941576631d0930fe27f3564ec30f11a0911e1d89cc" :answer/id #uuid "ddefa05b-1d54-5f28-89b5-23a9026b2c3c" :answer/type :answer.type/math :answer/value "D={(x,y)\\,:\\,1\\le y\\le 2(x-1)^{3}+1,\\,0\\le x\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-72140/selection" :answer-field/id #uuid "6eaf151b-2cf1-553f-871f-64e1505e903d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72140/selection/f36853c1f5bbf95984d4f608e5c15b7a2eff651c368df7a45d7b26f0c0b2aa1e" :answer-field/choices ["q-72140/selection/f36853c1f5bbf95984d4f608e5c15b7a2eff651c368df7a45d7b26f0c0b2aa1e" "q-72140/selection/5dfb05eb5514dcd8cebfefc0dabed21cb4907ff8d0838b95f08eb24f91a84cec" "q-72140/selection/c4708fa5a9a65d6c37c111d81108e5bc80f8459943a1d33a7f28e40a30742718" "q-72140/selection/53d5e89a0b347ba45520c762c753c9e57f3c88d335ce2263b5d335ec46b46aca" "q-72140/selection/58991a4d56f2c08423ad57941576631d0930fe27f3564ec30f11a0911e1d89cc"] :db/ensure [:answer-field/validate]} {:db/id "q-72140" :question/id #uuid "4e069115-760a-5e4f-bea6-0a6b059dd3b7" :question/math-academy-id "q-72140" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/c72f0a6f9bfb83be34cf911d2a2a18b04a40f92f4d1f6c065b9d6f03f56301b6.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny=2(x-1)^{3}+1\\,⟹\\,x=\\sqrt[3]{\\frac{y-1}{2}}+1\n$$\n\nThe function $x=0$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=1$ and $y=3.$ So, we have $1\\le y\\le 3.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/1dcfc91a9392998f6de0e4ede2e67d9487f71bb521adad024c3c6891b56d0163.png)\n\nThe horizontal line enters the region through the lower function $x=0$ and leaves through the upper function $x=\\sqrt[3]{\\frac{y-1}{2}}+1.$ So, we have $0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72140/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030"] :knowledge-point/questions ["q-72140"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72319/selection/be0d9ed4da22b898e694e83d4925d1f1b9bfb5f2cac91c09a5c2eae7744eba02" :answer/id #uuid "c8bf809a-76e2-5a32-bbe4-71a057091fb0" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/67b42d