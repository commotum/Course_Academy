iable/14038811/assets/6ccd325f24c9550f82a7063623db1cae0212a07f1c938b882c6707d35a6eee29.png" :db/id #edb/ref 17592186301426} :answer-field/id #uuid "801021f5-5ed0-511c-bf51-4a2c048367f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301423}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c93f1bf1-d1a5-546e-93ed-d337cf3b226c" :question/math-academy-id "q-72049" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/7c159c025f0b7ae4bfa8984f637a492cda21ec2dd39e87be724324e1334c06a3.png)"}] [{:db/id #edb/ref 17592186301429 :knowledge-point/_questions [{:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b592c4d3-8a8d-5344-99a9-9d9e8ac8d496" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186301431} {:answer/id #uuid "25e61f72-7896-5929-a256-b5371530109b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/ccc416dcf8464cc7fb7e6ea5aad60803a4c1bb273fe6f1069bfbb3e2fe124b64.png" :db/id #edb/ref 17592186301432} {:answer/id #uuid "aed3b733-13df-5a9c-8a7c-816b0850e350" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/d25e6ae97e93e13491cac3937cae0928694f843479de353be8e5874fb0e726f1.png" :db/id #edb/ref 17592186301433} {:answer/id #uuid "55ed75c7-112f-50db-86a8-f355e1ecbf04" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/11311a36be324ae3a62fa1333203f722364ba99c6b0aefbff5672cf18df1e8f7.png" :db/id #edb/ref 17592186301434} {:answer/id #uuid "16c2b7a1-e9ac-5131-8e2f-d02eff1b4a03" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/7231c566a92c547b6fa950052ddfbe90cf08faf794937295226c468764701a3d.png" :db/id #edb/ref 17592186301435}] :answer-field/correct {:answer/id #uuid "16c2b7a1-e9ac-5131-8e2f-d02eff1b4a03" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/7231c566a92c547b6fa950052ddfbe90cf08faf794937295226c468764701a3d.png" :db/id #edb/ref 17592186301435} :answer-field/id #uuid "5ea9718c-9c1b-53a7-ab7b-7a0011dec4ff" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301430}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f27ebf72-bf4d-55a2-8215-565ccf4a58d8" :question/math-academy-id "q-72055" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/fe16f5f3d1e9663a7e0df88d71639016bfb3357a6745ee6f125968978fd54c12.png)"}] [{:db/id #edb/ref 17592186301436 :knowledge-point/_questions [{:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0b4bcf37-9377-578c-945a-9e418d316e9d" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 2(x-1)^{3}+1,\\,1\\le x\\le 2}" :db/id #edb/ref 17592186301438} {:answer/id #uuid "ddefa05b-1d54-5f28-89b5-23a9026b2c3c" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 2(x-1)^{3}+1,\\,0\\le x\\le 1}" :db/id #edb/ref 17592186301439} {:answer/id #uuid "dadb8f1f-d58a-5014-9e46-3cfe88e179a7" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1}" :db/id #edb/ref 17592186301440} {:answer/id #uuid "1549f265-e8a4-5a1e-b8c2-5b45fb3f2cc5" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}-1}" :db/id #edb/ref 17592186301441} {:answer/id #uuid "d0aa53d2-389f-5c75-90b4-2fa799a6e9da" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1}" :db/id #edb/ref 17592186301442}] :answer-field/correct {:answer/id #uuid "d0aa53d2-389f-5c75-90b4-2fa799a6e9da" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1}" :db/id #edb/ref 17592186301442} :answer-field/id #uuid "6eaf151b-2cf1-553f-871f-64e1505e903d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301437}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4e069115-760a-5e4f-bea6-0a6b059dd3b7" :question/math-academy-id "q-72140" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/c72f0a6f9bfb83be34cf911d2a2a18b04a40f92f4d1f6c065b9d6f03f56301b6.png)\n\nWhich of the following represents the shaded region above as a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type II region, we first rewrite all of the given curves as functions of $y:$\n\n$$\ny=2(x-1)^{3}+1\\,⟹\\,x=\\sqrt[3]{\\frac{y-1}{2}}+1\n$$\n\nThe function $x=0$ is already written as a function of $y.$\n\nNotice that the region lies between the horizontal lines $y=1$ and $y=3.$ So, we have $1\\le y\\le 3.$\n\nWe draw a horizontal arrow through the region to determine the left function $g(y)$ and the right function $f(y).$ A horizontal line should intersect the region in a single interval only for it to be a type II region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/1dcfc91a9392998f6de0e4ede2e67d9487f71bb521adad024c3c6891b56d0163.png)\n\nThe horizontal line enters the region through the lower function $x=0$ and leaves through the upper function $x=\\sqrt[3]{\\frac{y-1}{2}}+1.$ So, we have $0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le y\\le 3,\\,0\\le x\\le \\sqrt[3]{\\frac{y-1}{2}}+1}.\n$$"}] [{:db/id #edb/ref 17592186301443 :knowledge-point/_questions [{:knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1a0f3222-a5f8-5fcd-b098-fcccf3105990" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186301445} {:answer/id #uuid "4efd1cc1-35fd-5180-98b1-c020add13878" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186301446} {:answer/id #uuid "fc67656a-c62a-5f24-8999-265587a5d457" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186301447} {:answer/id #uuid "12f729bd-320f-50de-bd74-5b2cd483e355" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186301448} {:answer/id #uuid "81814992-97d4-5d06-b32c-f9c0ba5e739c" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186301449}] :answer-field/correct {:answer/id #uuid "12f729bd-320f-50de-bd74-5b2cd483e355" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186301448} :answer-field/id #uuid "a2ceb530-70bd-5b73-b3ec-0ae8db0a36f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301444}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a5dd306f-63b8-5be6-adf1-ac9dc3f00602" :question/math-academy-id "q-72185" :question/problem "Which of the following statements are true regarding the finite region inside the circumference ${x}^{2}+{y}^{2}=1?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, notice that\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=1\\, & ⟹\\,x=\\pm \\sqrt{1-{y}^{2}} \\\\ {x}^{2}+{y}^{2}=1\\, & ⟹\\,y=\\pm \\sqrt{1-{x}^{2}}.\\end{aligned}\n$$\n\nNow, let's sketch our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/0960063edcce8ccd55dc2f77147c4a4982645c180e8b998d7e520c65131ea045.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-1\\le x\\le 1,\\,-\\sqrt{1-{x}^{2}}\\le y\\le \\sqrt{1-{x}^{2}}}.\n$$\n\nSo, this is a type I region.\n\n- Any horizontal line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-1\\le y\\le 1,\\,-\\sqrt{1-{y}^{2}}\\le x\\le \\sqrt{1-{y}^{2}}}.\n$$\n\nSo, this is a type II region.\n\nTherefore, only statements I and II are true."}] [{:db/id #edb/ref 17592186301450 :knowledge-point/_questions [{:knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a1e4f88d-10b3-5c3f-afff-d9d099368d46" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186301452} {:answer/id #uuid "4f18db94-ad67-593f-b114-ebc6d5002eab" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186301453} {:answer/id #uuid "eb524796-12ff-54a4-b598-cd196967e8ea" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186301454} {:answer/id #uuid "674a9f4c-4b66-51bd-aab2-ed3d3dcd0e22" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186301455} {:answer/id #uuid "2a60cbe0-3aad-56b3-895f-48b7e3acfbaf" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186301456}] :answer-field/correct {:answer/id #uuid "4f18db94-ad67-593f-b114-ebc6d5002eab" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186301453} :answer-field/id #uuid "2da88fc7-748c-5911-9d27-4eaa5cc1f0be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301451}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ab932e6b-af0e-5e9b-9cca-659edaed65a4" :question/math-academy-id "q-72186" :question/problem "Which of the following statements are true regarding the finite region bounded between the parabola $y=4-{x}^{2}$ and the line $y=2-|x|?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/6f35161e7efbd53c9ef558ffe88d8e046771128965a9fdd02143ae37a9b130ea.png)\n\nWe have the following:\n\n- Any vertical line through the region intersects it on a single interval. Furthermore, we can represent our region as\n\n$$\nD={(x,y)\\,:\\,-2\\le x\\le 2,\\,2-|x|\\le y\\le 4-{x}^{2}}.\n$$\n\nSo, this is a type I region.\n\n- The horizontal line $y=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/769a521cd6b05ecf05052da382e40295b26be66fe56e4eff7c6940c9032f2f0b.png)\n\nTherefore, only statement I is true."}] [{:db/id #edb/ref 17592186301457 :knowledge-point/_questions [{:knowledge-point/id #uuid "85335de6-e1dc-5a2f-b30a-806627759030" :knowledge-point/title "Identifying Type II Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eb4569cc-7afa-5db6-abb8-57be792aa56e" :answer/type {:db/ident :answer.type/text} :answer/value "None of the listed" :db/id #edb/ref 17592186301459} {:answer/id #uuid "619bee74-f842-5275-9ba5-56fcecc92ace" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/3228d2d0c2fb3ce74c98b018c0694e9da5fc4a8444a7b67b5fb7fa0eb24eaa6c.png" :db/id #edb/ref 17592186301460} {:answer/id #uuid "0f6b6ea4-a669-5de2-90da-f16756eaf873" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/ef9d0a612a093852fd9f60fb20c86b946c178f9e2a9877ef7c16f89f98e324f6.png" :db/id #edb/ref 17592186301461} {:answer/id #uuid "c8bf809a-76e2-5a32-bbe4-71a057091fb0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/67b42d8a49263abc8cce98f20b59370047b989ae69d55050e4001897ba3f9d2e.png" :db/id #edb/ref 17592186301462} {:answer/id #uuid "8908f108-2e4e-58f2-80c4-dece6295a81e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/5eb14fb126d8b0df54e5523d705cb5491e161c00b118f07a0bf3407644b7d4a0.png" :db/id #edb/ref 17592186301463}] :answer-field/correct {:answer/id #uuid "8908f108-2e4e-58f2-80c4-dece6295a81e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/5eb14fb126d8b0df54e5523d705cb5491e161c00b118f07a0bf3407644b7d4a0.png" :db/id #edb/ref 17592186301463} :answer-field/id #uuid "ffde4384-1824-5572-92af-e06b7dba1323" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301458}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f280067d-2410-589e-b620-7c39e01b3ccd" :question/math-academy-id "q-72319" :question/problem "Which of the following is a type II region in two-dimensional space?" :question/worked-solution "A type II region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le y\\le b,\\,g(y)\\le x\\le f(y)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nA type II region has the property that a horizontal line drawn through the region intersects the region in a single interval only.\n\nAmong the given options, the only type II region is the following.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/1206abdf317df09c8c54714a6178d78570b3c10a49513c3c626c09be3ea2cf72.png)"}] [{:db/id #edb/ref 17592186301464 :knowledge-point/_questions [{:knowledge-point/id #uuid "64d342be-ebaf-5e94-b641-ea8ce6f14c12" :knowledge-point/title "Identifying Type I Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9b882010-5288-5d0a-bbff-29b6ad594ed7" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le x\\le 1,\\,-{x}^{2}+3\\le y\\le {x}^{2}+1}" :db/id #edb/ref 17592186301466} {:answer/id #uuid "c19dd8db-321b-5a04-8a6d-2464c52803a1" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 2,\\,0\\le y\\le -(x-1)^{2}+3}" :db/id #edb/ref 17592186301467} {:answer/id #uuid "62a50ee6-80f9-5e55-8bbd-05a650d8c085" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 2,\\,(x-1)^{2}+1\\le y\\le -(x-1)^{2}+3}" :db/id #edb/ref 17592186301468} {:answer/id #uuid "7b920f50-2ccc-5392-922a-1341e3c1bdf4" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,0\\le x\\le 2,\\,(x-1)^{2}+3\\le y\\le -(x-1)^{2}+1}" :db/id #edb/ref 17592186301469} {:answer/id #uuid "8c1bdea2-0bb8-5bb6-ae9e-62a3e14c8638" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 2,\\,(x-1)^{2}\\le y\\le -(x-1)^{2}}" :db/id #edb/ref 17592186301470}] :answer-field/correct {:answer/id #uuid "62a50ee6-80f9-5e55-8bbd-05a650d8c085" :answer/type {:db/ident :answer.type/math} :answer/value "D={(x,y)\\,:\\,1\\le x\\le 2,\\,(x-1)^{2}+1\\le y\\le -(x-1)^{2}+3}" :db/id #edb/ref 17592186301468} :answer-field/id #uuid "22c2f92c-84cf-5c4e-8386-899599683563" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301465}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5386da7a-d4e3-5516-bd15-c0227ea4ae2c" :question/math-academy-id "q-73532" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/d69e6b6550f7e4cae0785daaa19c0a52382a595c40309dccd1d832dbc6d2f82f.png)\n\nWhich of the following represents the shaded region above as a type I region in two-dimensional space?" :question/worked-solution "A type I region can be written as\n\n$$\nD={(x,y)\\,:\\,a\\le x\\le b,\\,g(x)\\le y\\le f(x)},\n$$\n\nwhere $f$ and $g$ are continuous functions.\n\nTo express the given region as a type I region, we first rewrite all of the given curves as functions of $x:$\n\n$$\nx=\\sqrt{y-1}+1\\,⟹\\,y=(x-1)^{2}+1\n$$\n\nThe function $y=-(x-1)^{2}+3$ is already written as a function of $x.$\n\nNotice that the region lies between the vertical lines $x=1$ and $x=2.$ So, we have $1\\le x\\le 2.$\n\nWe draw a vertical arrow through the region to determine the lower function $g(x)$ and the upper function $f(x).$ A vertical line should intersect the region in a single interval only for it to be a type I region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/942a39f885e6f88bef997e27914d05359be86ae1d6204f3834f0829ce4b81136.png)\n\nThe vertical line enters the region through the lower function $y=(x-1)^{2}+1$ and leaves through the upper function $y=-(x-1)^{2}+3.$ So, we have $(x-1)^{2}+1\\le y\\le -(x-1)^{2}+3.$\n\nTherefore, we obtain\n\n$$\nD={(x,y)\\,:\\,1\\le x\\le 2,\\,(x-1)^{2}+1\\le y\\le -(x-1)^{2}+3}.\n$$"}] [{:db/id #edb/ref 17592186301471 :knowledge-point/_questions [{:knowledge-point/id #uuid "7948909f-8dcb-5cc0-a00f-f505a41e4004" :knowledge-point/title "Classifying a Region as Type I, Type II, Both, or Neither"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "42e01d55-865b-507a-8469-a108bc7d61f6" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186301473} {:answer/id #uuid "72f7ea34-2bbb-5fc4-8d46-c698ee992a61" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186301474} {:answer/id #uuid "3f0aee89-7f16-5494-b654-c3abcf640fa6" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186301475} {:answer/id #uuid "1aa59bbc-9d00-5444-9de6-5cdb50f05706" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186301476} {:answer/id #uuid "7c5bc784-ec8d-5fe7-861e-c5847e2ec08a" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186301477}] :answer-field/correct {:answer/id #uuid "1aa59bbc-9d00-5444-9de6-5cdb50f05706" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186301476} :answer-field/id #uuid "79f23227-eb8d-5c3e-9c36-7a1ee7738ab1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301472}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "964e90c7-3ddc-59ef-9c19-6cc6da31e561" :question/math-academy-id "q-73552" :question/problem "Which of the following statements are true regarding the finite region bounded between the ellipses $(x-1)^{2}+4{y}^{2}=1$ and ${x}^{2}+4{y}^{2}=4?$\n\n- It is a type I region\n- It is a type II region\n- It's neither a type I nor a type II region" :question/worked-solution "First, let's sketch our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/215dd0c920e700a75896fc54751ec20d197487a2c992cd8910810c66129c14dc.png)\n\nWe have the following:\n\n- The vertical line $x=1$ intersects the region in two separate intervals, as shown below. So, this can't be a type I region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/7e1a0c5dd2b4aadf7efe78d903234b8d00cf4fa92eb7a3b41209a856f2d14b01.png)\n\n- The horizontal line $y=0.25$ intersects the region in two separate intervals, as shown below. So, this can't be a type II region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038811/assets/a90d7306e3f88a31609e368f9362248d6a12b7922b6a9e8c9f980ab31e7fb140.png)\n\nTherefore, only statement III is true."}]}
