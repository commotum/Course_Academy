#{[{:db/id #edb/ref 17592186294587 :knowledge-point/_questions [{:knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e" :knowledge-point/title "Finding Traces of Hyperboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a38499c7-55c3-5a9e-8044-d0ea0a672683" :answer/type {:db/ident :answer.type/text} :answer/value "$6$ and $2$" :db/id #edb/ref 17592186294589} {:answer/id #uuid "7ebbd4c0-da35-5e32-b98a-4f35891aef23" :answer/type {:db/ident :answer.type/text} :answer/value "$3\\sqrt{2}$ and $\\sqrt{2}$" :db/id #edb/ref 17592186294590} {:answer/id #uuid "5b2f1fec-0431-54e9-8542-33a81f075805" :answer/type {:db/ident :answer.type/text} :answer/value "$9$ and $4$" :db/id #edb/ref 17592186294591} {:answer/id #uuid "e377644e-ffd1-5050-9452-9d2ff27b4d62" :answer/type {:db/ident :answer.type/text} :answer/value "$18$ and $2$" :db/id #edb/ref 17592186294592} {:answer/id #uuid "ccde8264-6c46-5e45-a78b-6a583bab3808" :answer/type {:db/ident :answer.type/text} :answer/value "$\\sqrt{6}$ and $\\sqrt{3}$" :db/id #edb/ref 17592186294593}] :answer-field/correct {:answer/id #uuid "a38499c7-55c3-5a9e-8044-d0ea0a672683" :answer/type {:db/ident :answer.type/text} :answer/value "$6$ and $2$" :db/id #edb/ref 17592186294589} :answer-field/id #uuid "94346eb5-262f-588b-bef3-1a091bfda306" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186294588}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5d31914a-9f1e-5783-b7aa-a38c819334db" :question/math-academy-id "q-164380" :question/problem "The projection of the intersection between the hyperboloid of two sheets $-\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+(z-2)^{2}=-1$ and the plane $z=3$ onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=3,$ we substitute $z=3$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}-\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+(3-2)^{2} & =-1 \\\\ -\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2}+1 & =-1 \\\\ -\\frac{(x+1)^{2}}{18}+\\frac{{y}^{2}}{2} & =-2 \\\\ \\frac{(x+1)^{2}}{18}-\\frac{{y}^{2}}{2} & =2 \\\\ \\frac{(x+1)^{2}}{36}-\\frac{{y}^{2}}{4} & =1 \\\\ \\frac{(x+1)^{2}}{{6}^{2}}-\\frac{{y}^{2}}{{2}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $6$ and $2.$"}]}
