7561d57474" 13194139534861 true] [17592186315632 1034 "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}>1}" 13194139534861 true] [17592186315632 1103 #edb/ref 17592186045453 13194139534861 true] [17592186315632 1111 #uuid "36423193-08a3-5c88-ad99-c05b9b732522" 13194139534861 true] [17592186315633 1034 "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\le 3}" 13194139534861 true] [17592186315633 1103 #edb/ref 17592186045453 13194139534861 true] [17592186315633 1111 #uuid "f262bb87-4871-55d4-ab51-7488c902ae93" 13194139534861 true] [17592186315634 1034 "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\ge 1}" 13194139534861 true] [17592186315634 1103 #edb/ref 17592186045453 13194139534861 true] [17592186315634 1111 #uuid "8eb31a1b-2f6f-502a-a30b-ebc3a5805668" 13194139534861 true] [17592186315635 1034 "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}<3}" 13194139534861 true] [17592186315635 1103 #edb/ref 17592186045453 13194139534861 true] [17592186315635 1111 #uuid "9784dae7-59e5-5920-b20e-0b9284653a88" 13194139534861 true] [17592186315636 1017 #edb/ref 17592186315637 13194139534861 true] [17592186315636 1089 "q-164377" 13194139534861 true] [17592186315636 1091 #edb/ref 17592186045463 13194139534861 true] [17592186315636 1100 "What is the trace in the $yz$-plane of the hyperboloid of two sheets ${x}^{2}-\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{3}=-1?$" 13194139534861 true] [17592186315636 1113 #uuid "ef712763-c7d2-5dcd-9ca9-85b35690019f" 13194139534861 true] [17592186315636 1145 "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the hyperboloid. This gives:\n\n$$\n\\begin{aligned}{0}^{2}-\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{3} & =-1 \\\\ -\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{3} & =-1 \\\\ \\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{3} & =1\\end{aligned}\n$$\n\nwhich is the equation of a hyperbola in $yz$-plane." 13194139534861 true] [17592186315637 1000 #edb/ref 17592186315638 13194139534861 true] [17592186315637 1000 #edb/ref 17592186315639 13194139534861 true] [17592186315637 1000 #edb/ref 17592186315640 13194139534861 true] [17