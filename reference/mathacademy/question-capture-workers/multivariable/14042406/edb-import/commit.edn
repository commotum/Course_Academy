1-8a9d72de5d4c" 13194139534861 true] [17592186315652 1034 "$(0,-\\sqrt{5},0)$ and $(0,\\sqrt{5},0)$" 13194139534861 true] [17592186315652 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315652 1111 #uuid "18e0e436-88ea-59c0-b742-eb516874d076" 13194139534861 true] [17592186315653 1034 "$(0,\\sqrt{5}-1,0)$ and $(0,\\sqrt{5}+1,0)$" 13194139534861 true] [17592186315653 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315653 1111 #uuid "9757b420-9363-5a04-8342-c2c466a90165" 13194139534861 true] [17592186315654 1034 "$(0,1-\\sqrt{5},0)$ and $(0,1+\\sqrt{5},0)$" 13194139534861 true] [17592186315654 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315654 1111 #uuid "f0c21ffd-a2f6-5e92-9963-e58b2b6411f8" 13194139534861 true] [17592186315655 1034 "$(0,-4,0)$ and $(0,6,0)$" 13194139534861 true] [17592186315655 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315655 1111 #uuid "d52df98e-a995-5c6d-9d18-8f1c7f489067" 13194139534861 true] [17592186315656 1034 "$(0,4,0)$ and $(0,6,0)$" 13194139534861 true] [17592186315656 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315656 1111 #uuid "e6fd8f1e-c715-55fa-8398-b0b380815b8b" 13194139534861 true] [17592186315657 1017 #edb/ref 17592186315658 13194139534861 true] [17592186315657 1089 "q-71966" 13194139534861 true] [17592186315657 1091 #edb/ref 17592186045465 13194139534861 true] [17592186315657 1100 "What is the projection of the intersection between the hyperboloid of one sheet $\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{z}^{2}=1$ and the plane $z=1$ onto the $xy$-plane?" 13194139534861 true] [17592186315657 1113 #uuid "d9c71849-32ab-5d76-a9c0-318df90c7d29" 13194139534861 true] [17592186315657 1145 "To find the intersection of the hyperboloid and the plane $z=1$, we substitute $z=1$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{1}^{2} & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+1 & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8} & =0 \\\\ {y}^{2} & =4(x-2)^{2} \\\\ y & =\\pm 2(x-2)\\end{aligned}\n$$\n\nThis gives us two intersecting lines: $y=2(x-2)$ and $y=-2(x-2).$" 13194139534861 true] [17592186315658 1000 #edb/ref 17592186315659 13194139534861 true] [17592186315658 1000 #edb/ref 17592186315660 13194139534861 true] [17592186315658 1000 #edb/ref 17592186315661 13194139534861 true] [17592186315658 1000 #edb/ref 17592186315662 13194139534861 true] [17592186315658 1000 #edb/ref 17592186315663 13194139534861 true] [17592186315658 1040 #edb/ref 17592186045450 13194139534861 true] [17592186315658 1041 "selection" 13194139534861 true] [17592186315658 1104 #edb/ref 17592186315659 13194139534861 true] [17592186315658 1110 #uuid "23406618-5755-5060-9855-77059f132ff6" 13194139534861 true] [17592186315659 1034 "Two intersecting lines: $y=\\pm 2(x-2)$" 13194139534861 true] [17592186315659 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315659 1111 #uuid "328f4ff5-ee9a-52d0-8a00-a67b7b452ddb" 13194139534861 true] [17592186315660 1034 "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=-1$" 13194139534861 true] [17592186315660 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315660 1111 #uuid "d77965d4-1119-5cdc-9c21-fa632a942910" 13194139534861 true] [17592186315661 1034 "Two parallel lines: $y=2x\\pm 2$" 13194139534861 true] [17592186315661 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315661 1111 #uuid "5f8c74ef-d0b2-5ead-b119-70491ca7d875" 13194139534861 true] [17592186315662 1034 "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=1$" 13194139534861 true] [17592186315662 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315662 1111 #uuid "46ba76ec-cad5-5442-919d-8a0067738604" 13194139534861 true] [17592186315663 1034 "An ellipse: $\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}=1$" 13194139534861 true] [17592186315663 1103 #edb/ref 17592186045454 13194139534861 true] [17592186315663 1111 #uuid "c90b3cd8-2adc-52b6-a0d4-5dffdfad0fde" 13194139534861 true] [17592186315664 1017 #edb/ref 17592186315665 13194139534861 true] [17592186315664 1089 "q-74015" 13194139534861 true] [17592186315664 1091 #edb/ref 17592186045465 13194139534861 true] [17592186315664 1100 "Given the hyperboloid of one sheet $\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-\\frac{(z-1)^{2}}{4}=1$, find the domain of $z=z(x,y).$" 13194139534861 true] [17592186315664 1113 #uuid "d95c6e25-de35-5f9a-955b-71a91b612bd4" 13194139534861 true] [17592186315664 1145 "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-\\frac{(z-1)^{2}}{4} & =1 \\\\ \\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1 & =\\frac{(z-1)^{2}}{4}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}(z-1)^{2} & =4(\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1) \\\\ z-1 & =\\pm 2\\sqrt{\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1 & \\ge 0 \\\\ \\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}\\ge 1}.\n$$" 13194139534861 true] [17592186315665 1000 #edb/ref 17592186315666 13194139534861 true] [17592186315665 1000 #edb/ref 17592186315667 13194139534861 true] [17592186315665 1000 #edb/ref 17592186315668 13194139534861 true] [17592186315665 1000 #edb/ref 17592186315669 13194139534861 true] [17592186315665 1000 #edb/ref 17592186315670 13194139534861 true] [17592186315665 1040 #edb/ref 17592186045450 13194139534861 true] [17592186315665 1041 "selection" 13194139534861 true] [17592186315665 1104 #edb/ref 17592186315668 13194139534861 true] [17592186315665 1110 #uuid "b0f66603-76ab-5b49-ac1a-d07feb79183b" 13194139534861 true] [17592186315666 1034 "The entire $