dd544e5d357fac0ff0f623249ab3b7f264f513fcf" "q-164305/selection/a30c6bd96fbffe7069ba46b2b1208c4f7e99f36aaaeaf152c2aa1c5c23292bc2"] :db/ensure [:answer-field/validate]} {:db/id "q-164305" :question/id #uuid "5bb2562b-5a93-5104-a36a-5ac52a24497a" :question/math-academy-id "q-164305" :question/problem "Given the hyperboloid of two sheets ${x}^{2}+\\frac{(y-3)^{2}}{9}-{z}^{2}=-1,$ find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}{x}^{2}+\\frac{(y-3)^{2}}{9}-{z}^{2} & =-1 \\\\ {x}^{2}+\\frac{(y-3)^{2}}{9}+1 & ={z}^{2}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & ={x}^{2}+\\frac{(y-3)^{2}}{9}+1 \\\\ z & =\\pm \\sqrt{{x}^{2}+\\frac{(y-3)^{2}}{9}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n{x}^{2}+\\frac{(y-3)^{2}}{9}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164305/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3"] :knowledge-point/questions ["q-164305"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164379/selection/30335ac0d3848b11be57053e5e93c71a042e657c2d97d352b71eb2612a79664e" :answer/id #uuid "4d61123d-f51c-55c6-8d64-9c05a7741c38" :answer/type :answer.type/text :answer/value "$\\sqrt{3}$ and $2\\sqrt{3}$" :db/ensure [:answer/validate]} {:db/id "q-164379/selection/9f3dbaed08b462af9897debf4288bf62d05cbd32da4a07b2fc41ece7d2122858" :answer/id #uuid "9c3cca58-6c27-5785-a34c-e79e888fc9ad" :answer/type :answer.type/text :answer/value "$\\sqrt{3}$ and $\\sqrt{6}$" :db/ensure [:answer/validate]} {:db/id "q-164379/selection/1633f17068a6924cbc70f595f2272658bd0befbf53034bff26422de282f62716" :answer/id #uuid "1b3087b4-b009-5638-b244-ea98ae062981" :answer/type :answer.type/text :answer/value "$9$ and $36$" :db/ensure [:answer/validate]} {:db/id "q-164379/selection/cd9ed7a7aa1c94889ddf008f5c7dfe5bab626fb77d7a60b93b3d4db4f968bcb2" :answer/id #uuid "10d6b8d3-f5da-5828-aece-2039ddea339a" :answer/type :answer.type/text :answer/value "$3$ and $6$" :db/ensure [:answer/validate]} {:db/id "q-164379/selection/4efc77014342e4dbb00ee745d0fd1f715a0a9d1d978d1e6435c53225b273687c" :answer/id #uuid "3019cd0e-f7b8-53ef-a263-a514e67cefea" :answer/type :answer.type/text :answer/value "$3$ and $12$" :db/ensure [:answer/validate]} {:db/id "q-164379/selection" :answer-field/id #uuid "baf54bdd-3f28-5615-945b-95c8068938e8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164379/selection/cd9ed7a7aa1c94889ddf008f5c7dfe5bab626fb77d7a60b93b3d4db4f968bcb2" :answer-field/choices ["q-164379/selection/30335ac0d3848b11be57053e5e93c71a042e657c2d97d352b71eb2612a79664e" "q-164379/selection/9f3dbaed08b462af9897debf4288bf62d05cbd32da4a07b2fc41ece7d2122858" "q-164379/selection/1633f17068a6924cbc70f595f2272658bd0befbf53034bff26422de282f62716" "q-164379/selection/cd9ed7a7aa1c94889ddf008f5c7dfe5bab626fb77d7a60b93b3d4db4f968bcb2" "q-164379/selection/4efc77014342e4dbb00ee745d0fd1f715a0a9d1d978d1e6435c53225b273687c"] :db/ensure [:answer-field/validate]} {:db/id "q-164379" :question/id #uuid "b2f415cf-02db-5940-b8b7-a0327c22a852" :question/math-academy-id "q-164379" :question/problem "The projection of the intersection between the hyperboloid of two sheets ${x}^{2}-\\frac{(y-1)^{2}}{3}+\\frac{(z+3)^{2}}{12}=-1$ and the plane $x=\\sqrt{2}$ onto the $yz$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $x=\\sqrt{2},$ we substitute $x=\\sqrt{2}$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}(\\sqrt{2})^{2}-\\frac{(y-1)^{2}}{3}+\\frac{(z+3)^{2}}{12} & =-1 \\\\ 2-\\frac{(y-1)^{2}}{3}+\\frac{(z+3)^{2}}{12} & =-1 \\\\ -\\frac{(y-1)^{2}}{3}+\\frac{(z+3)^{2}}{12} & =-3 \\\\ \\frac{(y-1)^{2}}{3}-\\frac{(z+3)^{2}}{12} & =3 \\\\ \\frac{(y-1)^{2}}{9}-\\frac{(z+3)^{2}}{36} & =1 \\\\ \\frac{(y-1)^{2}}{{3}^{2}}-\\frac{(z+3)^{2}}{{6}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $3$ and $6.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164379/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e"] :knowledge-point/questions ["q-164379"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-35410"] :question/problem "The projection of the intersection between the hyperboloid of one sheet $\\frac{{x}^{2}}{8}+\\frac{(y-4)^{2}}{18}-\\frac{{z}^{2}}{50}=1$ and the plane $x=2$ onto the $yz$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $x=2$, we substitute $x=2$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(2)^{2}}{8}+\\frac{(y-4)^{2}}{18}-\\frac{{z}^{2}}{50} & =1 \\\\ \\frac{1}{2}+\\frac{(y-4)^{2}}{18}-\\frac{{z}^{2}}{50} & =1 \\\\ \\frac{(y-4)^{2}}{18}-\\frac{{z}^{2}}{50} & =1-\\frac{1}{2} \\\\ \\frac{(y-4)^{2}}{18}-\\frac{{z}^{2}}{50} & =\\frac{1}{2} \\\\ \\frac{(y-4)^{2}}{9}-\\frac{{z}^{2}}{25} & =1 \\\\ \\frac{(y-4)^{2}}{{3}^{2}}-\\frac{{z}^{2}}{{5}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $3$ and $5.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-71966/selection/cfee775a20e97b997b73c6b802ed0c0a8a40f3d9ee65b71b57fbcbfd28dabcbb" :answer/id #uuid "c90b3cd8-2adc-52b6-a0d4-5dffdfad0fde" :answer/type :answer.type/text :answer/value "An ellipse: $\\frac{(x-2)^{2}}{4}+\\frac{{y}^{2}}{8}=1$" :db/ensure [:answer/validate]} {:db/id "q-71966/selection/3744b04ecf85028dca49ceac99321c50db7032c1b45ee578e83bd6c7933cadd7" :answer/id #uuid "328f4ff5-ee9a-52d0-8a00-a67b7b452ddb" :answer/type :answer.type/text :answer/value "Two intersecting lines: $y=\\pm 2(x-2)$" :db/ensure [:answer/validate]} {:db/id "q-71966/selection/47bc3f285994ab96bf74bc7dfec7a43be22c392f622dc9c37d5a9761f255f99f" :answer/id #uuid "d77965d4-1119-5cdc-9c21-fa632a942910" :answer/type :answer.type/text :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=-1$" :db/ensure [:answer/validate]} {:db/id "q-71966/selection/65fdd5ee5437f83219bf77ae39fbc273a28c0a049acb15d18b9493bf17ee2750" :answer/id #uuid "5f8c74ef-d0b2-5ead-b119-70491ca7d875" :answer/type :answer.type/text :answer/value "Two parallel lines: $y=2x\\pm 2$" :db/ensure [:answer/validate]} {:db/id "q-71966/selection/77ea66c2d2f6b8662a45e50f993a3bab11c851f89a637d5f6784abbece626e75" :answer/id #uuid "46ba76ec-cad5-5442-919d-8a0067738604" :answer/type :answer.type/text :answer/value "A hyperbola: $\\frac{(x-2)^{2}}{4}-\\frac{{y}^{2}}{8}=1$" :db/ensure [:answer/validate]} {:db/id "q-71966/selection" :answer-field/id #uuid "23406618-5755-5060-9855-77059f132ff6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71966/selection/3744b04ecf85028dca49ceac99321c50db7032c1b45ee578e83bd6c7933cadd7" :answer-field/choices ["q-71966/selection/cfee775a20e97b997b73c6b802ed0c0a8a40f3d9ee65b71b57fbcbfd28dabcbb" "q-71966/selection/3744b04ecf85028dca49ceac99321c50db7032c1b45ee578e83bd6c7933cadd7" "q-71966/selection/47bc3f285994ab96bf74bc7dfec7a43be22c392f622dc9c37d5a9761f255f99f" "q-71966/selection/65fdd5ee5437f83219bf77ae39fbc273a28c0a049acb15d18b9493bf17ee2750" "q-71966/selection/77ea66c2d2f6b8662a45e50f993a3bab11c851f89a637d5f6784abbece626e75"] :db/ensure [:answer-field/validate]} {:db/id "q-71966" :question/id #uuid "d9c71849-32ab-5d76-a9c0-318df90c7d29" :question/math-academy-id "q-71966" :question/problem "What is the projection of the intersection between the hyperboloid of one sheet $\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{z}^{2}=1$ and the plane $z=1$ onto the $xy$-plane?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z=1$, we substitute $z=1$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+{1}^{2} & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8}+1 & =1 \\\\ \\frac{(x-2)^{2}}{2}-\\frac{{y}^{2}}{8} & =0 \\\\ {y}^{2} & =4(x-2)^{2} \\\\ y & =\\pm 2(x-2)\\end{aligned}\n$$\n\nThis gives us two intersecting lines: $y=2(x-2)$ and $y=-2(x-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71966/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e"] :knowledge-point/questions ["q-71966"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164377/selection/088f549291d180ccbccbb897d8553dffac3a0dea6e3c3766a0277b06022f9c91" :answer/id #uuid "8964de03-c1cd-5577-ba90-8c59cdbea2a5" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{3}=1" :db/ensure [:answer/validate]} {:db/id "q-164377/selection/46467167ebdb1aa4333638477f4a44fa87f34f2778f97d0c12005cbcdab3cf5e" :answer/id #uuid "3f89693d-9a5b-598a-8f97-abaaad3b0288" :answer/type :answer.type/math :answer/value "\\frac{{z}^{2}}{3}-\\frac{{y}^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "q-164377/selection/9a93b4efc057d74f1f83c237c1e405dc09c14819913a66077ef5481c7f4805ef" :answer/id #uuid "a63a5189-4da2-52e4-b8b4-9aa7a44786e8" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}}{9}-{x}^{2}=1" :db/ensure [:answer/validate]} {:db/id "q-164377/selection/ea29a8234dca7625cb091ee98a535a826ba201f658234f1b9c838c552349a35c" :answer/id #uuid "307b7503-6855-58a0-b270-c50110991a2b" :answer/type :answer.type/math :answer/value "{x}^{2}-\\frac{{y}^{2}}{9}=1" :db/ensure [:answer/validate]} {:db/id "q-164377/selection/daeb5d0929402e3c71c557d05d8245bfd8652a06fc17110ca355f7fe61f7c0a8" :answer/id #uuid "95bb2dd7-8404-5ba1-9fdc-6a088e23f280" :answer/type :answer.type/math :answer/value "\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{3}=1" :db/ensure [:answer/validate]} {:db/id "q-164377/selection" :answer-field/id #uuid "90b26f63-a7cf-5ec9-acb1-f1eab5ef0f13" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164377/selection/daeb5d0929402e3c71c557d05d8245bfd8652a06fc17110ca355f7fe61f7c0a8" :answer-field/choices ["q-164377/selection/088f549291d180ccbccbb897d8553dffac3a0dea6e3c3766a0277b06022f9c91" "q-164377/selection/46467167ebdb1aa4333638477f4a44fa87f34f2778f97d0c12005cbcdab3cf5e" "q-164377/selection/9a93b4efc057d74f1f83c237c1e405dc09c14819913a66077ef5481c7f4805ef" "q-164377/selection/ea29a8234dca7625cb091ee98a535a826ba201f658234f1b9c838c552349a35c" "q-164377/selection/daeb5d0929402e3c71c557d05d8245bfd8652a06fc17110ca355f7fe61f7c0a8"] :db/ensure [:answer-field/validate]} {:db/id "q-164377" :question/id #uuid "ef712763-c7d2-5dcd-9ca9-85b35690019f" :question/math-academy-id "q-164377" :question/problem "What is the trace in the $yz$-plane of the hyperboloid of two sheets ${x}^{2}-\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{3}=-1?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the hyperboloid. This gives:\n\n$$\n\\begin{aligned}{0}^{2}-\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{3} & =-1 \\\\ -\\frac{{y}^{2}}{9}+\\frac{{z}^{2}}{3} & =-1 \\\\ \\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{3} & =1\\end{aligned}\n$$\n\nwhich is the equation of a hyperbola in $yz$-plane." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164377/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d28eda1a-a90b-57e9-969a-eb36552e413e"] :knowledge-point/questions ["q-164377"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-12555"] :question/problem "Given the hyperboloid of one sheet  $\\dfrac{(x-3)^2}9 + \\dfrac{(y+4)^2}{16} - \\dfrac{(z-5)^2}{25} = 1,$ find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts, we plug $y=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}\\frac{(x-3)^{2}}{9}+\\frac{(0+4)^{2}}{16}-\\frac{(0-5)^{2}}{25} & =1 \\\\ \\frac{(x-3)^{2}}{9}+1-1 & =1 \\\\ \\frac{(x-3)^{2}}{9} & =1 \\\\ (x-3)^{2} & =9 \\\\ x-3 & =\\pm \\sqrt{9} \\\\ x & =3\\pm 3 \\\\ x & =0,6\\end{aligned}\n$$\n\nTherefore, the intercepts with the $x$-axis are $(0,0,0)$ and $(6,0,0).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5265"] :question/problem "Given the hyperboloid of two sheets $(x-1)^2 + y^2 - \\dfrac{z^2}{4} = -1,$ find the domain of $z = z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x-1)^{2}+{y}^{2}-\\frac{{z}^{2}}{4} & =-1 \\\\ (x-1)^{2}+{y}^{2}+1 & =\\frac{{z}^{2}}{4}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{4} & =(x-1)^{2}+{y}^{2}+1 \\\\ {z}^{2} & =4((x-1)^{2}+{y}^{2}+1) \\\\ z & =\\pm 2\\sqrt{(x-1)^{2}+{y}^{2}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in\\mathbb R^2,$ we have\n\n$$\n(x-1)^2 + y^2 + 1 \\geq 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is $\\mathbb R^2.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6078"] :question/problem "The projection of the intersection between the hyperboloid of two sheets \n\n$$\n-\\dfrac{(x-5)^2}{8} + \\dfrac{y^2}{50} + (z-3)^2 = -1\n$$\n\nand the plane $z = 4$ onto the $xy$-plane is a hyperbola. What are the lengths of the semi-axes of the hyperbola?" :question/worked-solution "To find the intersection of the hyperboloid and the plane $z = 4,$ we substitute $z = 4$ into the equation of the hyperboloid:\n\n$$\n\\begin{aligned}-\\frac{(x-5)^{2}}{8}+\\frac{{y}^{2}}{50}+(z-3)^{2} & =-1 \\\\ -\\frac{(x-5)^{2}}{8}+\\frac{{y}^{2}}{50}+1=-1 \\\\ -\\frac{(x-5)^{2}}{8}+\\frac{{y}^{2}}{50} & =-2 \\\\ \\frac{(x-5)^{2}}{8}-\\frac{{y}^{2}}{50} & =2 \\\\ \\frac{(x-5)^{2}}{16}-\\frac{{y}^{2}}{100} & =1 \\\\ \\frac{(x-5)^{2}}{{4}^{2}}-\\frac{{y}^{2}}{{10}^{2}} & =1\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbola with semi-axes of lengths $4$ and $10.$" :db/ensure [:question/validate]}]
