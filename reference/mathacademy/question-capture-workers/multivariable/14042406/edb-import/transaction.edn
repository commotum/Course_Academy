850" "q-164272/selection/fbbfed35a99d0aae9cd8ee2b0eee0ceed4be28aa48ba371330986c92ad498284"] :db/ensure [:answer-field/validate]} {:db/id "q-164272" :question/id #uuid "b589cdc8-22e6-5881-b7f2-9fb3725db0fb" :question/math-academy-id "q-164272" :question/problem "Given the hyperboloid of two sheets ${x}^{2}+\\frac{{y}^{2}}{2}-\\frac{(z+1)^{2}}{4}=-1,$ find its $z$-intercepts." :question/worked-solution "To find the $z$-intercepts, we plug $x=0$ and $y=0$ into the equation: \n\n$$\n\\begin{aligned}{0}^{2}+\\frac{{0}^{2}}{2}-\\frac{(z+1)^{2}}{4} & =-1 \\\\ -\\frac{(z+1)^{2}}{4} & =-1 \\\\ (z+1)^{2} & =4 \\\\ z+1 & =\\pm 2 \\\\ z & =-1\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $z=-3$ and $z=1.$\n\nTherefore, the intercepts with the $z$-axis are $(0,0,-3)$ and $(0,0,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164272/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf44a846-8458-5e2f-bef3-72cf87a6035f"] :knowledge-point/questions ["q-164272"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164284/selection/fc781eeb430c944a2ea4fdd5739e435a93ecd61935d06401cb14c0652379cebc" :answer/id #uuid "c2924483-de99-5fd9-8578-e1c1438b78e8" :answer/type :answer.type/text :answer/value "$(0,-6+\\sqrt{5},0)$ and $(0,-6-\\sqrt{5},0)$" :db/ensure [:answer/validate]} {:db/id "q-164284/selection/0526ed223013609e9b00c2c3452e47319c2fe9446dea0a3e3206e33f3a78652c" :answer/id #uuid "2eb07d56-3fa3-5046-8d3b-2ecd39381c73" :answer/type :answer.type/text :answer/value "The hyperboloid does not intersect the $y$-axis" :db/ensure [:answer/validate]} {:db/id "q-164284/selection/afbe7174197f72b9967084956a1f8d3c0c45cc3b595d7b97c7489f7b1353ca20" :answer/id #uuid "b90b3c75-ca9e-5fb2-86f8-480b6344bec3" :answer/type :answer.type/text :answer/value "$(0,-6+\\sqrt{5},0)$ only" :db/ensure [:answer/validate]} {:db/id "q-164284/selection/e9d805faded62b5657a881fbaa8ca281af7e38ba432719c472d529b7fdd5b71c" :answer/id #uuid "2c9b0369-4c6