answer/validate]} {:db/id "q-35489/selection/596d86f33f8b2a57211ad2200df55065fd4d034350283d8547c7bb15cc4afb19" :answer/id #uuid "18e0e436-88ea-59c0-b742-eb516874d076" :answer/type :answer.type/text :answer/value "$(0,-\\sqrt{5},0)$ and $(0,\\sqrt{5},0)$" :db/ensure [:answer/validate]} {:db/id "q-35489/selection" :answer-field/id #uuid "9ae3e863-875f-561f-b1c1-8a9d72de5d4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-35489/selection/b55b6c74ea0ae37054e2762e187cd9db30a9b6d97e66c986e8bf55770b9fa941" :answer-field/choices ["q-35489/selection/831f929f1a685a917102c151f2682cb8ab8b16e8516d24bc56c2ec37918243c1" "q-35489/selection/ff32750f62a81070a700507941180628b5b8ae122bc098427a6206bec93a439d" "q-35489/selection/b55b6c74ea0ae37054e2762e187cd9db30a9b6d97e66c986e8bf55770b9fa941" "q-35489/selection/bec837a3dc3465352f39575df9b146971b80b21fb105cdba5501b63c0a2f73f4" "q-35489/selection/596d86f33f8b2a57211ad2200df55065fd4d034350283d8547c7bb15cc4afb19"] :db/ensure [:answer-field/validate]} {:db/id "q-35489" :question/id #uuid "809cd0c2-57c2-514b-bfff-d4849f16397a" :question/math-academy-id "q-35489" :question/problem "Given the hyperboloid of one sheet $\\frac{{x}^{2}}{4}+\\frac{(y-1)^{2}}{4}-\\frac{(z-2)^{2}}{16}=1$, find its $y$-intercepts." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}\\frac{{0}^{2}}{4}+\\frac{(y-1)^{2}}{4}-\\frac{(0-2)^{2}}{16} & =1 \\\\ \\frac{(y-1)^{2}}{4}-\\frac{1}{4} & =1 \\\\ (y-1)^{2}-1 & =4 \\\\ (y-1)^{2} & =5 \\\\ y-1 & =\\pm \\sqrt{5} \\\\ y & =1\\pm \\sqrt{5}\\end{aligned}\n$$\n\nHence, we get the solutions $y=1-\\sqrt{5}$ and $1+\\sqrt{5}.$\n\nTherefore, the intercepts with the $y$-axis are $(0,1-\\sqrt{5},0)$ and $(0,1+\\sqrt{5},0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-35489/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf44a846-8458-5e2f-bef3