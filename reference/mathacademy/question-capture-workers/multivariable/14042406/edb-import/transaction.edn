2c" "q-164277/selection/8f24bf81db47e06de167e3f0dc797eb110f79e96f37f22621f17b3d97728b501"] :db/ensure [:answer-field/validate]} {:db/id "q-164277" :question/id #uuid "0ab5822f-ed35-5736-89b9-c999ed582c58" :question/math-academy-id "q-164277" :question/problem "Given the hyperboloid of two sheets $(x+2)^{2}+{y}^{2}-(z-3)^{2}=-1,$ find its $y$-intercepts." :question/worked-solution "To find the $y$-intercepts, we plug $x=0$ and $z=0$ into the equation: \n\n$$\n\\begin{aligned}(0+2)^{2}+{y}^{2}-(0-3)^{2} & =-1 \\\\ 4+{y}^{2}-9 & =-1 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nHence, we get the solutions $y=-2$ and $y=2.$\n\nTherefore, the intercepts with the $y$-axis are $(0,-2,0)$ and $(0,2,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164277/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cf44a846-8458-5e2f-bef3-72cf87a6035f"] :knowledge-point/questions ["q-164277"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164307/selection/08a42fe9e269a001cc88c365a71bbdcbac1999027688c548ee7f96b37d82a595" :answer/id #uuid "36423193-08a3-5c88-ad99-c05b9b732522" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}>1}" :db/ensure [:answer/validate]} {:db/id "q-164307/selection/7525a950d93d70ece6df3c2ffaa7d5e5adaeafc4c190ed0035250b9c1d318cb7" :answer/id #uuid "9784dae7-59e5-5920-b20e-0b9284653a88" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}<3}" :db/ensure [:answer/validate]} {:db/id "q-164307/selection/2e94e4c6d9454713e391a82a8ec2c6438df5b9723de7e522211d689a06b213fe" :answer/id #uuid "f262bb87-4871-55d4-ab51-7488c902ae93" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\le 3}" :db/ensure [:answer/validate]} {:db/id "q-164307/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "4a4fb924-e1aa-52d2-99dc-e07561d57474" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-164307/selection/4a06feae5200af6c1d50baad32254b5bab9e198faf0e2e09cc09593c627920c2" :answer/id #uuid "8eb31a1b-2f6f-502a-a30b-ebc3a5805668" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\ge 1}" :db/ensure [:answer/validate]} {:db/id "q-164307/selection" :answer-field/id #uuid "c7cf2916-5bf8-565a-ad20-5bbfc20deef8" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164307/selection/4a06feae5200af6c1d50baad32254b5bab9e198faf0e2e09cc09593c627920c2" :answer-field/choices ["q-164307/selection/08a42fe9e269a001cc88c365a71bbdcbac1999027688c548ee7f96b37d82a595" "q-164307/selection/7525a950d93d70ece6df3c2ffaa7d5e5adaeafc4c190ed0035250b9c1d318cb7" "q-164307/selection/2e94e4c6d9454713e391a82a8ec2c6438df5b9723de7e522211d689a06b213fe" "q-164307/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" "q-164307/selection/4a06feae5200af6c1d50baad32254b5bab9e198faf0e2e09cc09593c627920c2"] :db/ensure [:answer-field/validate]} {:db/id "q-164307" :question/id #uuid "e92d8979-8ed2-57ee-bba0-a5ec152cffed" :question/math-academy-id "q-164307" :question/problem "Given the hyperboloid of one sheet $(x+5)^{2}+{y}^{2}-(z-3)^{2}=1,$ find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}(x+5)^{2}+{y}^{2}-(z-3)^{2} & =1 \\\\ (x+5)^{2}+{y}^{2}-1 & =(z-3)^{2}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}(z-3)^{2} & =(x+5)^{2}+{y}^{2}-1 \\\\ z-3 & =\\pm \\sqrt{(x+5)^{2}+{y}^{2}-1} \\\\ z & =3\\pm \\sqrt{(x+5)^{2}+{y}^{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have\n\n$$\n\\begin{aligned}(x+5)^{2}+{y}^{2}-1 & \\ge 0 \\\\ (x+5)^{2}+{y}^{2} & \\ge 1,\\end{aligned}\n$$\n\nwhich gives the exterior of the circle $(x+5)^{2}+{y}^{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,(x+5)^{2}+{y}^{2}\\ge 1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164307/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3"] :knowledge-point/questions ["q-164307"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74015/selection/4abb0e0a5ff3389dd16846e2c4715210007acd0af430431967098123f0d91100" :answer/id #uuid "e0ad25ec-8e65-518d-8cbf-81a0695e08bb" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}\\ge 1}" :db/ensure [:answer/validate]} {:db/id "q-74015/selection/83838a30deb7b0fd28227fb278c0c065d56de41deebea7ebcdb93c731770e64f" :answer/id #uuid "97094e97-5f62-5d0e-90a9-7fdc5ca0f999" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{7}+\\frac{(y+8)^{2}}{2}\\ge 1}" :db/ensure [:answer/validate]} {:db/id "q-74015/selection/cb941d8c8b3f5c1f2cacffcdecb9d8e6da983c9ce312f0915b6a0151f61063c6" :answer/id #uuid "c4e6100f-78fa-5964-8f58-0cb8b92b8974" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-74015/selection/30114059874854dafb6eb7f8e48c67ff82e03c44831afc58184d5cdf61828d67" :answer/id #uuid "e8b8f82a-19f9-5a1d-a3ab-b201c6c61e59" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{(x+3)^{2}}{7}+{y}^{2}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-74015/selection/037fb834278b910823c9ef61f0f4b6409701e2031a8dedabb3aaf3077f91b312" :answer/id #uuid "f696f675-dc23-56c8-96da-559b9caebb4f" :answer/type :answer.type/text :answer/value "The entire $xy$-plane" :db/ensure [:answer/validate]} {:db/id "q-74015/selection" :answer-field/id #uuid "b0f66603-76ab-5b49-ac1a-d07feb79183b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74015/selection/4abb0e0a5ff3389dd16846e2c4715210007acd0af430431967098123f0d91100" :answer-field/choices ["q-74015/selection/4abb0e0a5ff3389dd16846e2c4715210007acd0af430431967098123f0d91100" "q-74015/selection/83838a30deb7b0fd28227fb278c0c065d56de41deebea7ebcdb93c731770e64f" "q-74015/selection/cb941d8c8b3f5c1f2cacffcdecb9d8e6da983c9ce312f0915b6a0151f61063c6" "q-74015/selection/30114059874854dafb6eb7f8e48c67ff82e03c44831afc58184d5cdf61828d67" "q-74015/selection/037fb834278b910823c9ef61f0f4b6409701e2031a8dedabb3aaf3077f91b312"] :db/ensure [:answer-field/validate]} {:db/id "q-74015" :question/id #uuid "d95c6e25-de35-5f9a-955b-71a91b612bd4" :question/math-academy-id "q-74015" :question/problem "Given the hyperboloid of one sheet $\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-\\frac{(z-1)^{2}}{4}=1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-\\frac{(z-1)^{2}}{4} & =1 \\\\ \\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1 & =\\frac{(z-1)^{2}}{4}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}(z-1)^{2} & =4(\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1) \\\\ z-1 & =\\pm 2\\sqrt{\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1}\\end{aligned}\n$$\n\nSince the square root is defined only for non-negative arguments, we have:\n\n$$\n\\begin{aligned}\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}-1 & \\ge 0 \\\\ \\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2} & \\ge 1\\end{aligned}\n$$\n\nwhich gives the exterior of the ellipse $\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}=1,$ which includes the boundary.\n\nTherefore, the domain is\n\n$$\n{(x,y)\\,:\\,\\frac{(x+3)^{2}}{7}+\\frac{(y+8)^{2}}{2}\\ge 1}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-74015/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3"] :knowledge-point/questions ["q-74015"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-164232"] :question/problem "Given the hyperboloid of two sheets ${x}^{2}+{y}^{2}-{z}^{2}=-1$, find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}-{z}^{2} & =-1 \\\\ {x}^{2}+{y}^{2}+1 & ={z}^{2}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}{z}^{2} & =1+{x}^{2}+{y}^{2} \\\\ {z}^{2} & =\\pm \\sqrt{1+{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n1+{x}^{2}+{y}^{2}\\ge 1.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-164303/selection/5b9caf36c14a3f0fcb4766572cb52e5ec00c60a12f194344488495992ee46120" :answer/id #uuid "1f2f473e-a26c-58b0-8e23-5f9fa69c15b0" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}\\le 1}" :db/ensure [:answer/validate]} {:db/id "q-164303/selection/c5bf55e727477396901a57e93953387d34778503f48282bc2578d7e30985465a" :answer/id #uuid "701b5a8f-c4b8-5cd5-8b15-8019b2c65537" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}<1}" :db/ensure [:answer/validate]} {:db/id "q-164303/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "08d0290f-39d9-5388-9902-0bda8462709b" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-164303/selection/070fb304c0f492e0277b3b8fab5f887cdea80285d10c20c241c5d6f26aeffa3a" :answer/id #uuid "e920d31d-d868-512e-93de-35bbf89ca31e" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}>1}" :db/ensure [:answer/validate]} {:db/id "q-164303/selection/c8ce0bbcc6ae8b385c1003eef286cb820ec3d61d2e720e7104e70ce96313aec8" :answer/id #uuid "a344b2d5-7c8c-51c5-940c-9cd4376e0446" :answer/type :answer.type/math :answer/value "{(x,y)\\,:\\,\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}\\ge 1}" :db/ensure [:answer/validate]} {:db/id "q-164303/selection" :answer-field/id #uuid "58f1d285-3a06-59c2-853f-912821471ec6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164303/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer-field/choices ["q-164303/selection/5b9caf36c14a3f0fcb4766572cb52e5ec00c60a12f194344488495992ee46120" "q-164303/selection/c5bf55e727477396901a57e93953387d34778503f48282bc2578d7e30985465a" "q-164303/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" "q-164303/selection/070fb304c0f492e0277b3b8fab5f887cdea80285d10c20c241c5d6f26aeffa3a" "q-164303/selection/c8ce0bbcc6ae8b385c1003eef286cb820ec3d61d2e720e7104e70ce96313aec8"] :db/ensure [:answer-field/validate]} {:db/id "q-164303" :question/id #uuid "c07acc0b-9718-5922-85a6-2aa92546197c" :question/math-academy-id "q-164303" :question/problem "Given the hyperboloid of two sheets $\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16}=-1,$ find the domain of $z=z(x,y).$" :question/worked-solution "From the hyperboloid equation, we make $z$ the subject as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}-\\frac{{z}^{2}}{16} & =-1 \\\\ \\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}+1 & =\\frac{{z}^{2}}{16}\\end{aligned}\n$$\n\n$$\n\\begin{aligned}\\frac{{z}^{2}}{16} & =\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}+1 \\\\ {z}^{2} & =16(\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}+1) \\\\ z & =\\pm 4\\sqrt{\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}+1}\\end{aligned}\n$$\n\nThe square root is defined only for non-negative arguments. However, notice that for all $(x,y)\\in {R}^{2},$ we have\n\n$$\n\\frac{{x}^{2}}{4}+\\frac{{y}^{2}}{9}+1\\ge 0.\n$$\n\nTherefore, the domain of $z(x,y)$ is ${R}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164303/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b079a5ff-e73a-592f-b16c-8740682538f3"] :knowledge-po