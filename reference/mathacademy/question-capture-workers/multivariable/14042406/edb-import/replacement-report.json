          "question": "e-5265",
          "field": null,
          "attribute": "question/problem",
          "value": "Given the hyperboloid of two sheets $(x-1)^2 + y^2 - \\dfrac{z^2}{4} = -1,$ find the domain of $z = z(x,y).$",
          "category": "ma_capture",
