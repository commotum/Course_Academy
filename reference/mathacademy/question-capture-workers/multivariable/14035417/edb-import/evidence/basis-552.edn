#{[{:db/id #edb/ref 17592186261854 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c2791d4-f801-5555-a859-1d373f91a67e" :knowledge-point/title "Evaluating Arcsine When a Coterminal Angle is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a2535e7-72ff-51a5-bd05-2314417eaa6e" :answer/type {:db/ident :answer.type/math} :answer/value "-{45}^{∘}" :db/id #edb/ref 17592186261856}] :answer-field/correct {:answer/id #uuid "9a2535e7-72ff-51a5-bd05-2314417eaa6e" :answer/type {:db/ident :answer.type/math} :answer/value "-{45}^{∘}" :db/id #edb/ref 17592186261856} :answer-field/id #uuid "48550d3c-3939-5aca-a773-68ce37df37d5" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186261855}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9a7d0a24-b1bb-5537-9873-f6cb09e77afd" :question/math-academy-id "q-82178" :question/problem "$\\operatorname{arcsin}(-\\frac{\\sqrt{2}}{2})=$\n\nAnswer: {{answer}}" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arcsin}x$ is given by\n\n$$\n-{90}^{∘}\\le \\theta \\le {90}^{∘}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the values on the unit circle, we see that\n\n$$\n\\operatorname{sin}({315}^{∘})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nHowever, ${315}^{∘}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with ${315}^{∘}$ that lies within the range of $\\theta ,$ we subtract ${360}^{∘}.$\n\n$$\n{315}^{∘}-{360}^{∘}=-{45}^{∘}.\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}(-\\frac{\\sqrt{2}}{2})=-{45}^{∘}.\n$$"}]}
