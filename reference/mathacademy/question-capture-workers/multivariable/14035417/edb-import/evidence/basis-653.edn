#{[{:db/id #edb/ref 17592186261854 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c2791d4-f801-5555-a859-1d373f91a67e" :knowledge-point/title "Evaluating Arcsine When a Coterminal Angle is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "685caf8b-0c45-5925-988a-ea7ae101733b" :answer/type {:db/ident :answer.type/math} :answer/value "-{45}^{∘}" :db/id #edb/ref 17592186273833} {:answer/id #uuid "c8ffab9b-f98c-53e0-baf9-6d561164c8d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-{45}^{∘})" :db/id #edb/ref 17592186273834} {:answer/id #uuid "f3c30e8a-0cc9-522d-a9d5-e8dd3717394c" :answer/type {:db/ident :answer.type/math} :answer/value "-(-{45}^{∘})" :db/id #edb/ref 17592186273835} {:answer/id #uuid "dcec60b1-cc4f-513e-97be-f85c1ec1a634" :answer/type {:db/ident :answer.type/math} :answer/value "3(-{45}^{∘})" :db/id #edb/ref 17592186273836} {:answer/id #uuid "93e1c923-254c-5af9-81b5-a147a717cc25" :answer/type {:db/ident :answer.type/math} :answer/value "2(-{45}^{∘})" :db/id #edb/ref 17592186273837}] :answer-field/correct {:answer/id #uuid "685caf8b-0c45-5925-988a-ea7ae101733b" :answer/type {:db/ident :answer.type/math} :answer/value "-{45}^{∘}" :db/id #edb/ref 17592186273833} :answer-field/id #uuid "ef351985-dad1-5d62-89c3-b862d8c1df8c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275051}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9a7d0a24-b1bb-5537-9873-f6cb09e77afd" :question/math-academy-id "q-82178" :question/problem "$\\operatorname{arcsin}(-\\frac{\\sqrt{2}}{2})=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arcsin}x$ is given by\n\n$$\n-{90}^{∘}\\le \\theta \\le {90}^{∘}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the values on the unit circle, we see that\n\n$$\n\\operatorname{sin}({315}^{∘})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nHowever, ${315}^{∘}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with ${315}^{∘}$ that lies within the range of $\\theta ,$ we subtract ${360}^{∘}.$\n\n$$\n{315}^{∘}-{360}^{∘}=-{45}^{∘}.\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}(-\\frac{\\sqrt{2}}{2})=-{45}^{∘}.\n$$"}]}
