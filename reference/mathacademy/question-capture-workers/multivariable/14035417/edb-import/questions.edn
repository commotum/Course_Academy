#{[{:db/id #edb/ref 17592186059533 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9e89b620-641a-5dbf-85f6-ca0f7a2fad80" :knowledge-point/title "Evaluating Arcsine or Arccosine"}] :question/id #uuid "a3f9e797-4bfb-5b2a-b460-98d7def3ae20" :question/math-academy-id "e-6754" :question/problem "Find the value of $\\arccos\\left(-\\dfrac{1}{2}\\right)$." :question/worked-solution "The range of\n\n$$\n\\theta = \\arccos x\n$$\n\nis given by\n\n$$\n0 \\le \\theta \\le \\pi\n$$\n\nNote that the angle $\\theta$ spans the first and second quadrants.\n\nSince\n\n$$\n-\\dfrac{1}{2}\n$$\n\nis negative, our answer is an angle that lies in the second quadrant, where cosine is negative.\n\n![](/home/jake/Developer/MA/DATA/Lessons/209/Source/Images/14075e642ddf4d45f6ee40cea7dbb087.png)\n\nFrom the values in the second quadrant, we see that\n\n$$\n\\cos\\left(\\dfrac{2\\pi}{3}\\right) = -\\dfrac{1}{2}\n$$\n\nTherefore,\n\n$$\n\\arccos\\left(-\\dfrac{1}{2} \\right) =\\dfrac{2\\pi}{3}\n$$"}] [{:db/id #edb/ref 17592186059534 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/title "Evaluating Arctangent"}] :question/id #uuid "83fc553b-3ad0-5003-afe3-81204a695162" :question/math-academy-id "e-6755" :question/problem "Find, in radians, the value of $\\arctan(-\\sqrt 3)$." :question/worked-solution "First, note that the range of\n\n$$\n\\theta = \\arctan x\n$$\n\nis given by\n\n$$\n-\\dfrac\\pi 2 \\lt \\theta \\lt \\dfrac\\pi 2\n$$\n\nNote that the angle $\\theta$ spans the first and fourth quadrants.\n\nSince $-\\sqrt 3$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that\n\n$$\n\\tan \\left(-\\dfrac{\\pi}{3}\\right) = -\\tan\\left(\\dfrac{\\pi}{3}\\right) = -\\sqrt 3\n$$\n\nSince\n\n$$\n-\\dfrac{\\pi}{3}\n$$\n\nis an angle in the fourth quadrant that lies within the range of $\\arctan$, we conclude that\n\n$$\n\\arctan \\left(-\\sqrt 3\\right) = -\\dfrac{\\pi}{3}\n$$"}] [{:db/id #edb/ref 17592186059544 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "7c2791d4-f801-5555-a859-1d373f91a67e" :knowledge-point/title "Evaluating Arcsine When a Coterminal Angle is Required"}] :question/id #uuid "a2641aac-7c3a-5a2c-97f0-aca4782c7215" :question/math-academy-id "e-7220" :question/problem "Find the value of $\\arcsin \\left(-\\dfrac{\\sqrt{3}} 2 \\right)$." :question/worked-solution "First, note that the range of\n\n$$\n\\theta = \\arcsin x\n$$\n\nis given by\n\n$$\n-\\dfrac\\pi 2 \\le \\theta \\le \\dfrac\\pi 2\n$$\n\nNow, let's take a look at the unit circle.\n\n![](/home/jake/Developer/MA/DATA/Lessons/209/Source/Images/cbdba1490f8dd76396ad73dfea0fe152.png)\n\nFrom the values in the unit circle, we see that\n\n$$\n\\sin\\left(\\dfrac{5\\pi}{3}\\right) = -\\dfrac {\\sqrt{3}} 2\n$$\n\nHowever,\n\n$$\n\\dfrac{5\\pi}{3}\n$$\n\ndoes not lie within the range of $\\theta$. To get an angle that's coterminal with\n\n$$\n\\dfrac{5\\pi}{3}\n$$\n\nand lies within the range of $\\theta$, we subtract $2\\pi{:}$\n\n$$\n\\dfrac{5\\pi}{3} - 2\\pi = -\\dfrac{\\pi}{3}\n$$\n\nTherefore,\n\n$$\n\\arcsin \\left(-\\dfrac {\\sqrt{3}} 2\\right) = -\\dfrac{\\pi}{3}\n$$"}] [{:db/id #edb/ref 17592186060168 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c2791d4-f801-5555-a859-1d373f91a67e" :knowledge-point/title "Evaluating Arcsine When a Coterminal Angle is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9d0a6836-7fc0-595b-b26a-c7d891ebafd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{π}{3}" :db/id #edb/ref 17592186058007} {:answer/id #uuid "c130bdf8-7f22-5250-850d-a301d7e67ba1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π}{6}" :db/id #edb/ref 17592186058008} {:answer/id #uuid "e1a1ceeb-bee8-5bfd-b903-6baaf0e7df24" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{π}{6}" :db/id #edb/ref 17592186058009} {:answer/id #uuid "2c71480d-8009-5b43-b86c-f84c81ba3e64" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π}{3}" :db/id #edb/ref 17592186058010} {:answer/id #uuid "707d9a76-2c29-5b94-857a-5edc5561375a" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7π}{6}" :db/id #edb/ref 17592186058011}] :answer-field/correct {:answer/id #uuid "c130bdf8-7f22-5250-850d-a301d7e67ba1" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{π}{6}" :db/id #edb/ref 17592186058008} :answer-field/id #uuid "47416904-f30d-5c76-b164-5ad814565fdd" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186058006}] :question/id #uuid "2cbce6d6-52b3-5bc8-a814-978defb5db2e" :question/math-academy-id "q-24770" :question/problem "What is $\\arcsin (-\\frac{1}{2})$?"}] [{:db/id #edb/ref 17592186278583 :knowledge-point/_questions [{:knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b" :knowledge-point/title "Evaluating Arctangent"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8fea6824-130d-568a-8b22-651d4b7f4508" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186278585}] :answer-field/correct {:answer/id #uuid "8fea6824-130d-568a-8b22-651d4b7f4508" :answer/type {:db/ident :answer.type/math} :answer/value "-30" :db/id #edb/ref 17592186278585} :answer-field/id #uuid "b6baa3ed-3895-59e1-a671-f7ca80a57681" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186278584}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f53bc9c3-fd24-580b-be8a-fd85b0a8922e" :question/math-academy-id "q-320730" :question/problem "Expressed in degrees, $\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})=${{field-1}}${}^{∘}.$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-{90}^{∘}<\\theta <{90}^{∘}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $-\\frac{\\sqrt{3}}{3}$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\operatorname{tan}⁡(-{30}^{∘})=-\\operatorname{tan}⁡({30}^{∘})=-\\frac{\\sqrt{3}}{3}.\n$$\n\nSince $-{30}^{∘}$ is an angle in the fourth quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(-\\frac{\\sqrt{3}}{3})={-30}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186269035 :knowledge-point/_questions [{:knowledge-point/id #uuid "9e89b620-641a-5dbf-85f6-ca0f7a2fad80" :knowledge-point/title "Evaluating Arcsine or Arccosine"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3b309955-8c8e-5971-a5aa-cd54076e91db" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186269037}] :answer-field/correct {:answer/id #uuid "3b309955-8c8e-5971-a5aa-cd54076e91db" :answer/type {:db/ident :answer.type/math} :answer/value "45" :db/id #edb/ref 17592186269037} :answer-field/id #uuid "b6e5032b-544f-5a0f-aeb5-8c72adc02d4a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186269036}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "78407dd9-1b78-5e45-bc8d-90e26337e6f7" :question/math-academy-id "q-321269" :question/problem "Expressed in degrees, $arccos\\,(\\frac{\\sqrt{2}}{2})=${{field-1}}${}^{∘}.$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arccos}⁡x$ is given by\n\n$$\n{0}^{∘}\\le \\theta \\le {180}^{∘}.\n$$\n\nNote that the angle $\\theta $ spans the first and second quadrants.\n\nSince $\\frac{\\sqrt{2}}{2}$ is positive, our answer is an angle that lies in the first quadrant, where cosine is positive.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13964047/assets/ca39c4cde40b99fd40a11746a31398d82814268b2df706e3101ee88648c9e2d4.png)\n\nFrom the values in the first quadrant, we see that\n\n$$\n\\operatorname{cos}⁡({45}^{∘})=\\frac{\\sqrt{2}}{2}.\n$$\n\nTherefore,\n\n$$\narccos\\,(\\frac{\\sqrt{2}}{2})={45}^{∘}.\n$$"}] [{:db/id #edb/ref 17592186261854 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c2791d4-f801-5555-a859-1d373f91a67e" :knowledge-point/title "Evaluating Arcsine When a Coterminal Angle is Required"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "685caf8b-0c45-5925-988a-ea7ae101733b" :answer/type {:db/ident :answer.type/math} :answer/value "-{45}^{∘}" :db/id #edb/ref 17592186273833} {:answer/id #uuid "c8ffab9b-f98c-53e0-baf9-6d561164c8d7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}(-{45}^{∘})" :db/id #edb/ref 17592186273834} {:answer/id #uuid "f3c30e8a-0cc9-522d-a9d5-e8dd3717394c" :answer/type {:db/ident :answer.type/math} :answer/value "-(-{45}^{∘})" :db/id #edb/ref 17592186273835} {:answer/id #uuid "dcec60b1-cc4f-513e-97be-f85c1ec1a634" :answer/type {:db/ident :answer.type/math} :answer/value "3(-{45}^{∘})" :db/id #edb/ref 17592186273836} {:answer/id #uuid "93e1c923-254c-5af9-81b5-a147a717cc25" :answer/type {:db/ident :answer.type/math} :answer/value "2(-{45}^{∘})" :db/id #edb/ref 17592186273837}] :answer-field/correct {:answer/id #uuid "685caf8b-0c45-5925-988a-ea7ae101733b" :answer/type {:db/ident :answer.type/math} :answer/value "-{45}^{∘}" :db/id #edb/ref 17592186273833} :answer-field/id #uuid "ef351985-dad1-5d62-89c3-b862d8c1df8c" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275051}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9a7d0a24-b1bb-5537-9873-f6cb09e77afd" :question/math-academy-id "q-82178" :question/problem "$\\operatorname{arcsin}(-\\frac{\\sqrt{2}}{2})=$" :question/worked-solution "First, note that the range of $\\theta =\\operatorname{arcsin}x$ is given by\n\n$$\n-{90}^{∘}\\le \\theta \\le {90}^{∘}.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/history-question-import-2026-10-04/import-ready/assets/d93c490adbb5cdbc0e9a09b60eea9b82ab93be8e871e334423abc17ddd62955e.png)\n\nFrom the values on the unit circle, we see that\n\n$$\n\\operatorname{sin}({315}^{∘})=-\\frac{\\sqrt{2}}{2}.\n$$\n\nHowever, ${315}^{∘}$ does not lie within the range of $\\theta .$ To get an angle that's coterminal with ${315}^{∘}$ that lies within the range of $\\theta ,$ we subtract ${360}^{∘}.$\n\n$$\n{315}^{∘}-{360}^{∘}=-{45}^{∘}.\n$$\n\nHence,\n\n$$\n\\operatorname{arcsin}(-\\frac{\\sqrt{2}}{2})=-{45}^{∘}.\n$$"}]}
