n/79646158e731768cad156c41b1acc7e7d3c8f0b1c929111f383ed45a4d9840ee" :answer-field/choices ["q-117458/selection/021797b7dee1bbc453469c610000b3c5a900cdc373425b9838467f86bcfc3c9b" "q-117458/selection/bb936222b9c802e4c28bfec3f95946cc53e5f635e4333a3f35d566cdc58fa08e" "q-117458/selection/79646158e731768cad156c41b1acc7e7d3c8f0b1c929111f383ed45a4d9840ee" "q-117458/selection/2c95c14653fec3ac393261a031577a7fcd9f9f6f0a39ecb8238ae96668229c67" "q-117458/selection/07a93f7a550d6c6638a3e6585bef8e0a1b28f463cbb8fb55ff0e08e4a8e60ff0"] :db/ensure [:answer-field/validate]} {:db/id "q-117458" :question/id #uuid "49c6a841-b393-5696-830a-e2485dd749e7" :question/math-academy-id "q-117458" :question/problem "$\\frac{1}{3}\\operatorname{arctan}⁡(\\sqrt{3})=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by:\n\n$$\n-{90}^{∘}<\\theta <{90}^{∘}\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $\\sqrt{3}$ is positive, our answer is an angle that lies in the first quadrant, where the tangent is positive.\n\nFrom the special values of the trigonometric functions, we know that \n\n$$\n\\operatorname{tan}⁡{60}^{∘}=\\sqrt{3}.\n$$\n\nSince ${60}^{∘}$ is an angle in the first quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(\\sqrt{3})={60}^{∘}.\n$$\n\nFinally, we get \n\n$$\n\\begin{aligned}\\frac{1}{3}\\operatorname{arctan}⁡(\\sqrt{3}) & =\\frac{1}{3}\\cdot ({60}^{∘}) \\\\  & ={20}^{∘}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-117458/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b"] :knowledge-point/questions ["q-117458"] :db/ensure [:knowledge-point/validate]} {:db/id "q-320789/field-1/438469ab2d71e1bb8b63f3164bacb1bbb54e29062b14dce6a666b63ac0081609" :answer/id #uuid "494974ea-a870-5f9c-8113-051d52319093" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{6}" :db/ensure [:answer/validate]} {:db/id "q-320789/field-1/ccc5b7f3cfdb4c2dfc0e1f31be54559a1ab3adaf142e500fc1f1b7bc87e93b08" :answer/id #uuid "887e9a34-79f9-5914-b83b-54a4690ecf33" :answer/type :answer.type/math :answer/value "\\frac{\\pi}{3}" :db/ensure [:answer/validate]} {:db/id "q-320789/field-1" :answer-field/id #uuid "99781a69-a70d-58eb-bf8f-ef7ff49d1c34" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-320789/field-1/438469ab2d71e1bb8b63f3164bacb1bbb54e29062b14dce6a666b63ac0081609" :answer-field/choices ["q-320789/field-1/438469ab2d71e1bb8b63f3164bacb1bbb54e29062b14dce6a666b63ac0081609" "q-320789/field-1/ccc5b7f3cfdb4c2dfc0e1f31be54559a1ab3adaf142e500fc1f1b7bc87e93b08"] :db/ensure [:answer-field/validate]} {:db/id "q-320789" :question/id #uuid "dcd819ac-f54d-580d-9c30-ef00b37e0ddd" :question/math-academy-id "q-320789" :question/problem "Expressed in radians, $\\frac{1}{2}arctan\\,(\\sqrt{3})=${{field-1}}." :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $\\sqrt{3}$ is positive, our answer is an angle that lies in the first quadrant, where the tangent is positive.\n\nFrom the special values of the trigonometric functions, we know that \n\n$$\ntan\\,(\\frac{\\pi }{3})=\\sqrt{3}.\n$$\n\nSince $\\frac{\\pi }{3}$ is an angle in the first quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\narctan\\,(\\sqrt{3})=\\frac{\\pi }{3}.\n$$\n\nFinally, we get\n\n$$\n\\frac{1}{2}arctan\\,(\\sqrt{3})=\\frac{1}{2}\\cdot \\frac{\\pi }{3}=\\frac{\\pi }{6}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-320789/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b"] :knowledge-point/questions ["q-320789"] :db/ensure [:knowledge-point/validate]} {:db/id "q-24757/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" :answer/id #uuid "930b1696-c210-5e06-9043-5ff198bc1b42" :answer/type :answer.type/math :answer/value "\\pi " :db/ensure [:answer/validate]} {:db/id "q-24757/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" :answer/id #uuid "084552c1-b899-5e7d-8ae8-dceaa00e0c6f" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{6}" :db/ensure [:answer/validate]} {:db/id "q-24757/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "1e233245-bcde-5962-91c8-374b8a42e3f5" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-24757/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "2d0d3040-2e8c-5bdc-a766-c71856e0a12c" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-24757/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198" :answer/id #uuid "34df7c27-2d2d-5d55-a675-28b2e160c9cf" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-24757/selection" :answer-field/id #uuid "9c556b56-ee7d-5b0a-a7e5-1a7a2d84febc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-24757/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer-field/choices ["q-24757/selection/986e06f062dcc0ad37fbb185f7e0d56b0fd8e74b571035e7dc0af3d06af89951" "q-24757/selection/e0bd991ac2e2f2a23ec920e03c6d5103be6b20c12a25d724ab290d4ba5292c3e" "q-24757/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-24757/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-24757/selection/adbad78d33491a071139fe589fefda7e9ba65cf97ebbcae14d252ac90459e198"] :db/ensure [:answer-field/validate]} {:db/id "q-24757" :question/id #uuid "92f42f5d-afd2-5968-8f18-421b209caed6" :question/math-academy-id "q-24757" :question/problem "$\\operatorname{arctan}⁡(1)=$" :question/worked-solution "The range of $\\theta =\\operatorname{arctan}⁡x$ is given by\n\n$$\n-\\frac{\\pi }{2}<\\theta <\\frac{\\pi }{2}.\n$$\n\nNote that the angle $\\theta $ spans the first and fourth quadrants.\n\nSince $1$ is positive, our answer is an angle that lies in the first quadrant, where tangent is positive.\n\nFrom the special values of the trigonometric functions, we know that \n\n$$\n\\operatorname{tan}⁡(\\frac{\\pi }{4})=1.\n$$\n\nSince $\\frac{\\pi }{4}$ is an angle in the first quadrant that lies within the range of $arctan,$ we conclude that\n\n$$\n\\operatorname{arctan}⁡(1)=\\frac{\\pi }{4}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-24757/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3878b5fa-fd5e-5984-8516-96ee17bf137b"] :knowledge-point/questions ["q-24757"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-6754"] :question/problem "Find the value of $\\arccos\\left(-\\dfrac{1}{2}\\right).$" :question/worked-solution "The range of $\\theta = \\arccos x$ is given by\n\n$$\n0 \\le \\theta  \\le \\pi.\n$$\n\nNote that the angle $\\theta$ spans the first and second quadrants.\n\nSince $-\\dfrac{1}{2}$ is negative, our answer is an angle that lies in the second quadrant, where cosine is negative.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14035417/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values in the second quadrant, we see that\n\n$$\n\\cos\\left( \\dfrac{2\\pi}{3}\\right) = -\\dfrac{1}{2}.\n$$\n\nTherefore,\n\n$$\n\\arccos\\left(  -\\dfrac{1}{2} \\right) =\\dfrac{2\\pi}{3}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7220"] :question/problem "Find the value of $\\arcsin \\left(-\\dfrac{\\sqrt{3}} 2 \\right).$" :question/worked-solution "First, note that the range of $\\theta = \\arcsin x$ is given by\n\n$$\n-\\dfrac\\pi 2 \\le \\theta \\le \\dfrac\\pi 2.\n$$\n\nNow, let's take a look at the unit circle.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14035417/assets/dbf36192ac332dc49ed75278838e989a37ac7d888311be1b8b059a7b59667aa6.png)\n\nFrom the values in the unit circle, we see that\n\n$$\n\\sin\\left( \\dfrac{5\\pi}{3}\\right) = -\\dfrac {\\sqrt{3}} 2.\n$$\n\nHowever, $\\dfrac{5\\pi}{3}$ does not lie within the range of $\\theta.$ To get an angle that's coterminal with $\\dfrac{5\\pi}{3}$ and lies within the range of $\\theta,$ we subtract $2\\pi{:}$\n\n$$\n\\dfrac{5\\pi}{3} - 2\\pi = -\\dfrac{\\pi}{3}\n$$\n\nTherefore,\n\n$$\n\\arcsin \\left(-\\dfrac {\\sqrt{3}} 2\\right) = -\\dfrac{\\pi}{3}.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-6755"] :question/problem "Find, in radians, the value of $\\arctan(-\\sqrt 3).$" :question/worked-solution "First, note that the range of $\\theta = \\arctan x$ is given by\n\n$$\n-\\dfrac\\pi 2 \\lt \\theta \\lt \\dfrac\\pi 2.\n$$\n\nNote that the angle $\\theta$ spans the first and fourth quadrants.\n\nSince $-\\sqrt 3$ is negative, our answer is an angle that lies in the fourth quadrant, where the tangent is negative.\n\nFrom the special values of the trigonometric functions and the oddness of the tangent function, we know that \n\n$$\n\\tan \\left(-\\dfrac{\\pi}{3}\\right) = -\\tan\\left(\\dfrac{\\pi}{3}\\right) = -\\sqrt 3.\n$$\n\nSince $-\\dfrac{\\pi}{3}$ is an angle in the fourth quadrant that lies within the range of $\\arctan,$ we conclude that\n\n$$\n\\arctan \\left(-\\sqrt 3\\right) = -\\dfrac{\\pi}{3}.\n$$" :db/ensure [:question/validate]}]
