}{3}-\\frac{\\pi }{2})-(\\frac{{\\pi }^{3}}{24}-\\frac{\\pi }{4}) \\\\  & =\\frac{7{\\pi }^{3}}{24}-\\frac{\\pi }{4}.\\end{aligned}\n$$" 13194139534691 true] [17592186303655 1000 #edb/ref 17592186303656 13194139534691 true] [17592186303655 1040 #edb/ref 17592186045449 13194139534691 true] [17592186303655 1041 "field-1" 13194139534691 true] [17592186303655 1104 #edb/ref 17592186303656 13194139534691 true] [17592186303655 1110 #uuid "fb12cd62-3c0e-552b-b36a-edaad2c59d0e" 13194139534691 true] [17592186303656 1034 "\\frac{7\\pi^3}{24}-\\frac{\\pi}{4}" 13194139534691 true] [17592186303656 1103 #edb/ref 17592186045453 13194139534691 true] [17592186303656 1111 #uuid "e70fdbe2-e3ff-5811-8b25-f2fe769c6def" 13194139534691 true] [17592186303657 1017 #edb/ref 17592186303658 13194139534691 true] [17592186303657 1089 "q-348917" 13194139534691 true] [17592186303657 1091 #edb/ref 17592186045464 13194139534691 true] [17592186303657 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039635/assets/07a1fab6073fdff2a20140719b570c0c40981ab049866480fbaff4dfad0c7799.png)\n\nFind the area $A$ of the region in the $xy$-plane that is bounded by the curve $y=\\frac{7}{2}{sin}^{2}⁡(2x),$ the $x$-axis, and the lines $x=\\frac{\\pi }{4}$ and $x=\\frac{5\\pi }{4}$, as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139534691 true] [17592186303657 1113 #uuid "33e4ffd8-e1ee-553a-bbc6-09f216ac15a3" 13194139534691 true] [17592186303657 1145 "The area of the region bounded by the curve $y=\\frac{7}{2}{sin}^{2}⁡(2x),$ the $x$-axis and the lines $x=\\frac{\\pi }{4}$ and $x=\\frac{5\\pi }{4}$ is \n\n$$\nA={\\int }_{\\pi /4}^{5\\pi /4}\\frac{7}{2}{sin}^{2}⁡(2x)\\,\\text{d}x.\n$$\n\nLet's recall the double-angle formula for cosine that involves the ${sin}^{2}$ term: \n\n$$\n\\operatorname{cos}⁡2\\theta =1-2{sin}^{2}⁡\\theta .\n$$\n\nWe can rearrange the above formula as\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡2\\theta )={sin}^{2}⁡\\theta .\n$$\n\nLetting $\\theta =2x,$ we have\n\n$$\n\\frac{1}{2}(1-\\operatorname{cos}⁡(4x))={sin}^{2}⁡(2x).\n$$\n\nWe can now integrate as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{\\pi /4}^{5\\pi /4}\\frac{7}{2}{sin}^{2}⁡(2x)\\,\\text{d}x \\\\  & =\\frac{7}{2}{\\int }_{\\pi /4}^{5\\pi /4}\\frac{1}{2}(1-\\operatorname{cos}⁡(4x))\\,\\text{d}x \\\\  & =\\frac{7}{4}{\\int }_{\\pi /4}^{5\\pi /4}(1-\\operatorname{cos}⁡(4x))\\,\\text{d}x \\\\  & =\\frac{7}{4}{(x-\\frac{1}{4}\\operatorname{sin}⁡(4x))|}_{\\pi /4}^{5\\pi /4} \\\\  & =\\frac{7}{4}[(\\frac{5\\pi }{4}-\\frac{1}{4}\\operatorname{sin}⁡(5\\pi ))-(\\frac{\\pi }{4}-\\frac{1}{4}\\operatorname{sin}⁡(\\pi ))] \\\\  & =\\frac{7}{4}(\\frac{5\\pi }{4}-\\frac{\\pi }{4}) \\\\  & =\\frac{7\\pi }{4}.\\end{aligned}\n$$" 13194139534691 true] [17592186303658 1000 #edb/ref 17592186303659 13194139534691 true] [17592186303658 1000 #edb/ref 17592186303660 13194139534691 true] [17592186303658 1040 #edb/ref 17592186045449 13194139534691 true] [17592186303658 1041 "field-1" 13194139534691 true] [17592186303658 1104 #edb/ref 17592186303659 13194139534691 true] [17592186303658 1110 #uuid "311d916e-980e-58dc-aa9b-6dc55aa6720a" 13194139534691 true] [17592186303659 1034 "\\frac{7\\pi}{4}" 13194139534691 true] [17592186303659 1103 #edb/ref 17592186045453 13194139534691 true] [17592186303659 1111 #uuid "daa8bbfb-9cd5-5ac4-af5b-f95bc53fb68a" 13194139534691 true] [17592186303660 1034 "\\frac{7\\pi}{2}" 13194139534691 true] [17592186303660 1103 #edb/ref 17592186045453 13194139534691 true] [17592186303660 1111 #uuid "97d09f74-cc14-5e81-92b4-2c27170d8852" 13194139534691 true] [17592186303661 1017 #edb/ref 17592186303662 13194139534691 true] [17592186303661 1089 "q-361710" 13194139534691 true] [17592186303661 1091 #edb/ref 17592186045464 13194139534691 true] [17592186303661 1100 "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /2}(5{sin}^{2}⁡x+11{cos}^{2}⁡x)\\,\\text{d}x=$\n{{field-1}}" 13194139534691 true] [17592186303661 1113 #uuid "aab9a792-b65b-5b10-9dcd-2375e14a55d6" 13194139534691 true] [17592186303661 1145 "Recall  ${cos}^{2}⁡x+{sin}^{2}⁡x=1,$ so we have \n\n$$\n\\begin{aligned}5{sin}^{2}⁡x+11{cos}^{2}⁡x & =5{sin}^{2}⁡x+5{cos}^{2}⁡x+6{cos}^{2}⁡x \\\\  & =5({sin}^{2}⁡x+{cos}^{2}⁡x)+6{cos}^{2}⁡x \\\\  & =5+6{cos}^{2}⁡x.\\end{aligned}\n$$\n\nHere, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡x$ term, given by\n\n$$\n\\operatorname{cos}⁡2x=2{cos}^{2}⁡x-1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡x=\\frac{1}{2}(\\operatorname{cos}⁡2x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /2}(5+6{cos}^{2}⁡x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /2}[5+6\\cdot \\frac{1}{2}(\\operatorname{cos}⁡2x+1)]\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}(8+3\\operatorname{cos}⁡2x)\\text{d}x \\\\  & ={(8x+\\frac{3}{2}\\operatorname{sin}⁡2x)|}_{0}^{\\pi /2} \\\\  & =[8\\cdot \\frac{\\pi }{2}+\\frac{3}{2}\\operatorname{sin}⁡(2\\cdot \\frac{\\pi }{2})]-[8(0)+\\frac{3}{2}\\operatorname{sin}⁡(2(0))] \\\\  & =[4\\pi +\\frac{3}{2}\\operatorname{sin}⁡(\\pi )]-[0+\\frac{3}{2}\\operatorname{sin}⁡(0)] \\\\  & =[4\\pi +\\frac{3}{2}(0)]-[0+\\frac{3}{2}(0)] \\\\  & =4\\pi .\\end{aligned}\n$$" 13194139534691 true] [17592186303662 1000 #edb/ref 17592186303663 13194139534691 true] [17592186303662 1000 #edb/ref 17592186303664 13194139534691 true] [17592186303662 1040 #edb/ref 17592186045449 13194139534691 true] [17592186303662 1041 "field-1" 13194139534691 true] [17592186303662 1104 #edb/ref 17592186303663 13194139534691 true] [17592186303662 1110 #uuid "7f2e647b-d35b-5008-bf4e-9afef43b2a41" 13194139534691 true] [17592186303663 1034 "4\\pi" 13194139534691 true] [17592186303663 1103 #edb/ref 17592186045453 13194139534691 true] [17592186303663 1111 #uuid "840e71bf-4b19-5f77-975a-504d60b8f831" 13194139534691 true] [17592186303664 1034 "8\\pi" 13194139534691 true] [17592186303664 1103 #edb/ref 17592186045453 13194139534691 true] [17592186303664 1111 #uuid "cfdcdb89-1fa0-5e5b-a6dc-945460dab185" 13194139534691 true] [17592186303665 1017 #edb/ref 17592186303666 13194139534691 true] [17592186303665 1089 "q-361711" 13194139534691 true] [17592186303665 1091 #edb/ref 17592186045464 13194139534691 true] [17592186303665 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039635/assets/f8aa97ff1ff27ec11df6aefd4523ed9d39efac686c777f7242701aa2f4fef79c.png)\n\nA region in the $xy$-plane is bounded by the curve $y=2{cos}^{2}⁡(2x)+2-x,$ the $x$-axis and the lines $x=0$ and $x=\\frac{\\pi }{2}$, as shown above. The area of the region is\n\n$A=$\n{{field-1}}" 13194139534691 true] [17592186303665 1113 #uuid "5028512b-a5ef-5c38-81c4-6a7be0e32b0a" 13194139534691 true] [17592186303665 1145 "The area of the region is given by\n\n$$\n\\begin{aligned}A={\\int }_{0}^{\\pi /2}(2{cos}^{2}⁡(2x)+2-x)\\,\\text{d}x.\\end{aligned}\n$$\n\nTo calculate this integral, we use the double-angle formula for cosine that involves the ${cos}^{2}⁡x$ term, given by\n\n$$\n\\operatorname{cos}⁡2x=2{cos}^{2}⁡x-1.\n$$\n\n \n\nRearranging, we have\n\n$$\n{cos}^{2}⁡x=\\frac{1}{2}(\\operatorname{cos}⁡2x+1).\n$$\n\nSubstituting this into our integral, we get\n\n$$\n\\begin{aligned}A & ={\\int }_{0}^{\\pi /2}(2{cos}^{2}⁡(2x)+2-x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}[(\\operatorname{cos}⁡4x+1)+2-x]\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /2}(\\operatorname{cos}⁡4x+3-x)\\text{d}x \\\\  & ={(\\frac{1}{4}\\operatorname{sin}⁡4x+3x-\\frac{1}{2}{x}^{2})|}_{0}^{\\pi /2} \\\\  & =[\\frac{1}{4}\\operatorname{sin}⁡(2\\pi )+3\\cdot \\frac{\\pi }{2}-\\frac{1}{2}{(\\frac{\\pi }{2})}^{2}]-[\\frac{1}{4}\\operatorname{sin}⁡(0)+3(0)-\\frac{1}{2}(0)^{2}] \\\\  & =[\\frac{3\\pi }{2}-\\frac{{\\pi }^{2}}{8}]-[0] \\\\  & =\\frac{12\\pi -{\\pi }^{2}}{8}.\\end{aligned}\n$$" 13194139534691 true] [17592186303666 1000 #edb/ref 17592186303667 13194139534691 true] [17592186303666 1000 #edb/ref 17592186303668 131