,\\frac{3}{5}\\operatorname{cos}⁡t,\\,\\frac{4}{5}⟩.\\end{aligned}\n$$\n\nNext, we find the principal normal $N(t).$ To do this, we calculate ${T}^{′}(t)$ and its magnitude as follows:\n\n$$\n\\begin{aligned}{T}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(-\\frac{3}{5}\\operatorname{sin}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{5}\\operatorname{cos}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{5})⟩ \\\\  & =⟨-\\frac{3}{5}\\operatorname{cos}⁡t,\\,-\\frac{3}{5}\\operatorname{sin}⁡t,\\,0⟩ \\\\  & =-\\frac{3}{5}⟨\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t,\\,0⟩ \\\\ ‖{T}^{′}(t)‖ & =\\sqrt{{(-\\frac{3}{5}\\operatorname{cos}⁡t)}^{2}+{(-\\frac{3}{5}\\operatorname{sin}⁡t)}^{2}+{0}^{2}} \\\\  & =\\sqrt{\\frac{9}{25}({cos}^{2}⁡t+{sin}^{2}⁡t)} \\\\  & =\\frac{3}{5}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(t)$ and obtain the principal normal to the curve:\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(t)}{‖{T}^{′}(t)‖}=\\frac{-\\frac{3}{5}⟨\\operatorname{cos}⁡t,\\,\\operatorname{sin}⁡t,\\,0⟩}{(\\frac{3}{5})}=⟨-\\operatorname{cos}⁡t,\\,-\\operatorname{sin}⁡t,\\,0⟩\\end{aligned}\n$$" 13194139535625 true] [17592186120175 1091 #edb/ref 17592186045465 13194139535625 true] [17592186120175 1100 "The equations of a curve $r(t)$ and its corresponding unit tangent vector $T(t)$ at an arbitrary point are given below. Find the principal normal vector to that curve at the point $P(0, 3, 4)$.\n\n$[MATH: r(t)|= 5\\cos ti + 3\\sin tj + 4\\sin tk, t ∈ [0, 2π); T(t)|=-\\sin ti + \\frac{3}{5}\\cos tj + \\frac{4}{5}\\cos tk, t ∈ [0, 2π)]$" 13194139535625 false] [17592186120175 1100 "The equations of a curve $r(t)$ and its corresponding unit tangent vector $T(t)$ at an arbitrary point are given below. Find the principal normal vector to that curve at the point $P(0,3,4).$\n\n$$\n\\begin{aligned}r(t) & =5\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j+4\\operatorname{sin}⁡t\\,k,\\,t\\in [0,2\\pi ) \\\\ T(t) & =-\\operatorname{sin}⁡t\\,i+\\frac{3}{5}\\operatorname{cos}⁡t\\,j+\\frac{4}{5}\\operatorname{cos}⁡t\\,k,\\,t\\in [0,2\\pi )\\end{aligned}\n$$" 13194139535625 true] [17592186120175 1145 "First, we find the value of $t$ that corresponds to the point $P(0,3,4)$ on the given curve. We know that:\n\n$$\n\\begin{aligned}r(t) & =⟨0,3,4⟩ \\\\ 5\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j+4\\operatorname{sin}⁡t\\,k & =0\\text{ }i+3\\text{ }j+4\\text{ }k\\end{aligned}\n$$\n\nEquating the components of $i$, $j$, and $k$ gives:\n\n$$\n\\begin{aligned}{\\begin{aligned}5\\operatorname{cos}⁡t=0 \\\\ 3\\operatorname{sin}⁡t=3 \\\\ 4\\operatorname{sin}⁡t=4\\end{aligned}\\end{aligned}\n$$\n\nFrom the first equality, $t=\\frac{\\pi }{2}.$ This value also satisfies the other two equations. Therefore, $P(0,3,4)$ is at the tip of the vector $r(\\frac{\\pi }{2}).$ \n\nNow, we calculate ${T}^{′}(t)$ and evaluate it at $t=\\frac{\\pi }{2}:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\frac{3}{5}\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{4}{5}\\operatorname{cos}⁡t)\\,k \\\\  & =-\\operatorname{cos}⁡t\\,i-\\frac{3}{5}\\operatorname{sin}⁡t\\,j-\\frac{4}{5}\\operatorname{sin}⁡t\\,k \\\\ {T}^{′}(\\frac{\\pi }{2}) & =-\\operatorname{cos}⁡\\frac{\\pi }{2}\\,i-\\frac{3}{5}\\operatorname{sin}⁡\\frac{\\pi }{2}\\,j-\\frac{4}{5}\\operatorname{sin}⁡\\frac{\\pi }{2}\\,k \\\\  & =-\\frac{3}{5}\\,j-\\frac{4}{5}\\,k\\end{aligned}\n$$\n\nNext, we find the magnitude of ${T}^{′}(\\frac{\\pi }{2}):$\n\n$$\n\\begin{aligned}‖{T}^{′}(\\frac{\\pi }{2})‖ & =\\sqrt{(0)^{2}+{(-\\frac{3}{5})}^{2}+{(-\\frac{4}{5})}^{2}} \\\\  & =\\sqrt{\\frac{9}{25}+\\frac{16}{25}} \\\\  & =1\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(\\frac{\\pi }{2})$ and obtain the principal normal to the curve $r(t)$ at the point $P(0,3,4):$\n\n$$\n\\begin{aligned}N(t) & =\\frac{{T}^{′}(\\frac{\\pi }{2})}{‖{T}^{′}(\\frac{\\pi }{2})‖}=\\frac{-\\frac{3}{5}\\,j-\\frac{4}{5}\\,k}{1}=-\\frac{3}{5}\\,j-\\frac{4}{5}\\,k\\end{aligned}\n$$\n\nNote that when we find the scalar product of $T$ and $N$ at the point where at $t=\\frac{\\pi }{2},$ we get\n\n$$\n\\begin{aligned}T(\\frac{\\pi }{2})\\cdot N(\\frac{\\pi }{2}) & =(-i)\\cdot (-\\frac{3}{5}\\,j-\\frac{4}{5}\\,k) \\\\  & =\\frac{3}{5}(i\\cdot j)+\\frac{4}{5}(i\\cdot k) \\\\  & =0.\\,✓\\end{aligned}\n$$" 13194139535625 true] [17592186358107 1017 #edb/ref 17592186358108 13194139535625 true] [17592186358107 1089 "q-127333" 13194139535625 true] [17592186358107 1091 #edb/ref 17592186045463 13194139535625 true] [17592186358107 1100 "The unit tangent vector to a curve at an arbitrary point is given by\n\n$$\nT(t)=\\frac{1}{\\sqrt{4{t}^{2}+1}}⟨1,\\,2t⟩.\n$$\n\nFind the principal normal vector at the point where $t=1.$" 13194139535625 true] [17592186358107 1113 #uuid "d9ec2fe9-559e-547b-851b-6351eb71769b" 13194139535625 true] [17592186358107 1145 "First, we calculate ${T}^{′}(t)$ and evaluate it at $t=1:$\n\n$$\n\\begin{aligned}{T}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{4{t}^{2}+1}}⟨1,\\,2t⟩) \\\\  & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{\\sqrt{4{t}^{2}+1}})⟨1,\\,2t⟩+\\frac{1}{\\sqrt{4{t}^{2}+1}}⟨\\frac{\\text{d}}{\\text{d}t}(1),\\frac{\\text{d}}{\\text{d}t}(2t)⟩ \\\\  & =-\\frac{4t}{(4{t}^{2}+1)^{3/2}}⟨1,\\,2t⟩+\\frac{1}{(4{t}^{2}+1)^{1/2}}⟨0,\\,2⟩ \\\\  & =\\frac{1}{(4{t}^{2}+1)^{3/2}}[-4t⟨1,\\,2t⟩+(4{t}^{2}+1)⟨0,\\,2⟩] \\\\  & =\\frac{1}{(4{t}^{2}+1)^{3/2}}⟨-4t,\\,2\\,⟩ \\\\ {T}^{′}(1) & =\\frac{1}{(4(1)^{2}+1)^{3/2}}⟨-4(1),\\,2⟩ \\\\  & =\\frac{1}{\\sqrt{{5}^{3}}}⟨-4,2⟩ \\\\  & =\\frac{2}{5\\sqrt{5}}⟨-2,1⟩\\end{aligned}\n$$\n\n \n\nNext, we find the magnitude of ${T}^{′}(1):$\n\n$$\n\\begin{aligned}‖{T}^{′}(1)‖ & =\\frac{2}{5\\sqrt{5}}‖⟨-2,1⟩‖ \\\\  & =\\frac{2}{5\\sqrt{5}}\\sqrt{(-2)^{2}+(1)^{2}} \\\\  & =\\frac{2}{5\\sqrt{5}}\\sqrt{5} \\\\  & =\\frac{2}{5}\\end{aligned}\n$$\n\nFinally, we normalize ${T}^{′}(1)$ and obtain the principal normal vector to the curve at the point where $t=1:$\n\n$$\n\\begin{aligned}N(1) & =\\frac{{T}^{′}(1)}{‖{T}^{′}(1)‖}=\\frac{\\frac{2}{5\\sqrt{5}}⟨-2,1⟩}{(\\frac{2}{5})}=\\frac{1}{\\sqrt{5}}⟨-2,1⟩\\end{aligned}\n$$\n\nNote that when we find the scalar product of $N$ and $T$ at the point where $t=1,$ we get\n\n$$\n\\begin{aligned}N(1)\\cdot T(1) & =\\frac{1}{\\sqrt{5}}⟨-2,1⟩\\cdot (\\frac{1}{\\sqrt{5}}⟨1,\\,2⟩) \\\\  & =\\frac{1}{5}(⟨-2,1⟩\\cdot ⟨1,\\,2⟩) \\\\  & =\\frac{1}{5}((-2)(1)+(1)(2)) \\\\  & =0.\\,✓\\end{aligned}\n$$" 13194139535625 true] [17592186358108 1000 #edb/ref 17592186358109 13194139535625 true] [17592186358108 1000 #edb/ref 17592186358110 13194139535625 true] [17592186358108 1000 #edb/ref 17592186358111 13194139535625 true] [17592186358108 1000 #edb/ref 17592186358112 13194139535625 true] [17592186358108 1000 #edb/ref 17592186358113 13194139535625 true] [17592186358108 1040 #edb/ref 17592186045450 13194139535625 true] [17592186358108 1041 "selection" 13194139535625 true] [17592186358108 1104 #edb/ref 17592186358111 13194139535625 true] [17592186358108 1110 #uuid "96d84f76-9265-5f0f-9224-db03e41a7003" 13194139535625 true] [17592186358109 1034 "\\frac{1}{\\sqrt{2}}⟨1,1⟩" 13194139535625 true] [17592186358109 1103 #edb/ref 17592186045453 13194139535625 true] [17592186358109 1111 #uuid "6774fef1-a23b-59a7-859b-0334493c8db2" 13194139535625 true] [17592186358110 1034 "⟨-1,0⟩" 13194139535625 true] [17592186358110 1103 #edb/ref 17592186045453 13194139535625 true] [17592186358110 1111 #uuid "b4e02ba9-8a36-54ea-9a29-e2d6978a66b2" 13194139535625 true] [17592186358111 1034 "\\frac{1}{\\sqrt{5}}⟨-2,1⟩" 13194139535625 true] [17592186358111 1103 #edb/ref 17592186045453 13194139535625 true] [17592186358111 1111 #uuid "e0160c2c-74b1-5aa1-8d57-4c84b7be07f6" 13194139535625 true] [17592186358112 1034 "\\frac{1}{\\sqrt{5}}⟨2,1⟩" 13194139535625 true] [17592186358112 1103 #edb/ref 17592186045453 13194139535625 true] [17592186358112 1111 #uuid "e0b92453-93e0-583d-8fe6-c805203adcd4" 13194139535625 true] [17592186358113 1034 "\\frac{1}{\\sq