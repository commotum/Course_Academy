        {
          "question": "q-36305",
          "field": null,
          "attribute": "question/problem",
          "value": "In what direction does the function $g(x,y,z)={y}^{2}+\\operatorname{sin}\u2061(2\\pi x+\\pi z)$ increase most rapidly at the point $(1,1,2)?$",
