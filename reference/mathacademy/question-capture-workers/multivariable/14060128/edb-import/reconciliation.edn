ot \\text{d}r.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-77146" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/activity-metadata.json" "file_sha256" "07849ef2f32f1ba0e1c09dfd9bc0c36c6ace0ddb24f49ed3bfac5595ae9949cf"} {"question" "q-77146" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-77146" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r"] ["math" "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r"] ["math" "{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r"] ["math" "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r"] ["math" "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-77146" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\in