\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-125417" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/activity-metadata.json" "file_sha256" "07849ef2f32f1ba0e1c09dfd9bc0c36c6ace0ddb24f49ed3bfac5595ae9949cf"} {"question" "q-125417" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-125417" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\int }_{C}(2y-3x)\\,\\text{d}x-4\\,\\text{d}y"] ["math" "{\\int }_{C}(3x-1)\\,\\text{d}x+y\\,\\text{d}y"] ["math" "{\\int }_{C}(3y-1)\\,\\text{d}x+x\\,\\text{d}y"] ["math" "{\\int }_{C}4\\,\\text{d}x-(2y-3x)\\,\\text{d}y"] ["math" "{\\int }_{C}x\\,\\text{d}x+(3y-1)\\,\\text{d}y"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-125417" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\int }_{C}4\\,\\text{d}x-(2y-3x)\\,\\text{d}y"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-125427" "field" nil "attribute" "question/problem" "value" "If ${\\int }_{C}{x}^{2}\\,\\text{d}x+y\\,\\text{d}y+{z}^{3}\\,\\text{d}z$ is equivalent to ${\\int }_{C}F\\cdot \\text{d}r$ for some piecewise smooth curve $C,$ then $F(x,y,z)=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-125427" "field" nil "attribute" "question/worked-solution" "value" "Given a piecewise-smooth path $C$ and a vector field \n\n$$\nF(x,y,z)=P(x,y,z)\\,i+Q(x,y,z)\\,j+R(x,y,z)\\,k\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{C}P\\,\\text{d}x+Q\\,\\text{d}y+R\\,\\text{d}z\n$$\n\nIn our case, $P={x}^{2},Q=y,R={z}^{3}.$ Therefore\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}\\,i+y\\,j+{z}^{3}\\,k)\\cdot \\text{d}r & ={\\int }_{C}{x}^{2}\\,\\text{d}x+y\\,\\text{d}y+{z}^{3}\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, $F={x}^{2}\\,i+y\\,j+{z}^{3}\\,k.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-125427" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/activity-metadata.json" "file_sha256" "07849ef2f32f1ba0e1c09dfd9bc0c36c6ace0ddb24f49ed3bfac5595ae9949cf"} {"question" "q-125427" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/state.json" "file_sha256" "607957d5c1c86bc1a6cbc810c862d313142021b91e329b21542c17971ce6ec95"} {"question" "q-125427" "field" "selection" 