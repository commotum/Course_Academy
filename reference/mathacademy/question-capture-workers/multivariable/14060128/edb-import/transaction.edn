2}-y+2z)" :db/ensure [:answer/validate]} {:db/id "q-125423/selection/19bbe984ec16da62c138b04775b124b9ab6eb3f2ebdc7552a2606127b6c0892b" :answer/id #uuid "343eec27-eaa8-5e5b-8259-9d7dfdcdc4f6" :answer/type :answer.type/math :answer/value "\\frac{1}{2}∇({x}^{2}-y+2z)^{2}" :db/ensure [:answer/validate]} {:db/id "q-125423/selection/3a825b9b062128a09b25e144773af719e0a8f8433a4d783d0cf48c53e1a063cd" :answer/id #uuid "185bda7f-d40b-5456-b569-9b9de1d4c609" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{x}^{3}\\,i-\\frac{1}{2}{y}^{2}\\,j+{z}^{2}\\,k" :db/ensure [:answer/validate]} {:db/id "q-125423/selection/6d735d6df4c60346f3973ceb2f614b6c4939138cdfc203eb240fd58c5b718272" :answer/id #uuid "b75ccf0b-5123-5716-95b7-50327cc93c80" :answer/type :answer.type/math :answer/value "{x}^{2}\\,i-y\\,j+2z\\,k" :db/ensure [:answer/validate]} {:db/id "q-125423/selection" :answer-field/id #uuid "fecbb061-bfa5-53d8-ad78-33c0c65a1adc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-125423/selection/6d735d6df4c60346f3973ceb2f614b6c4939138cdfc203eb240fd58c5b718272" :answer-field/choices ["q-125423/selection/d65499557f93d7bf9d1bf965b58bcd41f8929432548b9bcd4833656a8696420e" "q-125423/selection/09a20d6678beb3258fe4dd42e94e987e9faa4e1bcb64eca11f97730c9eaef592" "q-125423/selection/19bbe984ec16da62c138b04775b124b9ab6eb3f2ebdc7552a2606127b6c0892b" "q-125423/selection/3a825b9b062128a09b25e144773af719e0a8f8433a4d783d0cf48c53e1a063cd" "q-125423/selection/6d735d6df4c60346f3973ceb2f614b6c4939138cdfc203eb240fd58c5b718272"] :db/ensure [:answer-field/validate]} {:db/id "q-125423" :question/id #uuid "58a9e20b-0a6a-52a8-ac51-bb7071b3781e" :question/math-academy-id "q-125423" :question/problem "If ${\\int }_{C}{x}^{2}\\,\\text{d}x-y\\,\\text{d}y+2z\\,\\text{d}z$ is equivalent to ${\\int }_{C}F\\cdot \\text{d}r$ for some piecewise smooth curve $C,$ then $F(x,y,z)=$" :question/worked-solution "Given a piecewise-smooth path $C$ and a vector field \n\n$$\nF(x,y,z)=P(x,y,z)\\,i+Q(x,y,z)\\,j+R(x,y,z)\\,k\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{C}P\\,\\text{d}x+Q\\,\\text{d}y+R\\,\\text{d}z\n$$\n\nIn our case, $P={x}^{2},Q=-y,R=2z.$ Therefore\n\n$$\n\\begin{aligned}{\\int }_{C}({x}^{2}\\,i-y\\,j+2z\\,k)\\cdot \\text{d}r & ={\\int }_{C}{x}^{2}\\,\\text{d}x-y\\,\\text{d}y+2z\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, $F={x}^{2}\\,i-y\\,j+2z\\,k.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-125423/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bed301c-59ac-5cb3-85e4-4aeaeebc15c2"] :knowledge-point/questions ["q-125423"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77146/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" :answer/id #uuid "14ee7014-34c2-550e-b2ee-755e6a56a377" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77146/selection/b331b72fbc647af25e87beeed0ecd2094bccd700da9db995e5333721577b2be0" :answer/id #uuid "4b06fa5d-38fe-575b-bca8-0a2d30a1438a" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77146/selection/0eb26a40acaca9cea6115682e086ac98f768a095f98f0f6c055016c6e0fbe9d3" :answer/id #uuid "6fa63303-3fc1-5a3a-a8d6-be1ee3ba4f0d" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77146/selection/f47739a8ffa56e1c1475de0d5b0b439e01e2abe6ed718f59aca03796d9b5164d" :answer/id #uuid "88d55be4-a97e-5881-8bfc-c7090e4fc5a7" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77146/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f" :answer/id #uuid "d102a56f-40b4-5dab-b17c-6a619b2892b1" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77146/selection" :answer-field/id #uuid "0abe0a97-bcba-521f-ad9f-38d7a500512b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77146/selection/b331b72fbc647af25e87beeed0ecd2094bccd700da9db995e5333721577b2be0" :answer-field/choices ["q-77146/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" "q-77146/selection/b331b72fbc647af25e87beeed0ecd2094bccd700da9db995e5333721577b2be0" "q-77146/selection/0eb26a40acaca9cea6115682e086ac98f768a095f98f0f6c055016c6e0fbe9d3" "q-77146/selection/f47739a8ffa56e1c1475de0d5b0b439e01e2abe6ed718f59aca03796d9b5164d" "q-77146/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f"] :db/ensure [:answer-field/validate]} {:db/id "q-77146" :question/id #uuid "5cf810bf-14bb-52f6-b193-0b8f38245ca4" :question/math-academy-id "q-77146" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/assets/fec5c3e96eeed9fb01479c0127e2d530a628855a124d8ab1ef380c48c2f569f1.png)\n\nWhich of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $C$ is the closed polygonal path $LMNL,$ shown in the diagram above, traversed in the counterclockwise direction?" :question/worked-solution "First, notice that we can represent $C,$ which is traversed in counterclockwise, as the union of $3$ paths:\n\n$$\nC={C}_{1}\\cup {-{C}_{2}}\\cup {C}_{3},\n$$\n\nwhere $-{C}_{2}$ is the same path as ${C}_{2}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{-{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r \\\\  & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77146/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "70b4357f-d5c5-5946-9022-0602c4217a1d"] :knowledge-point/questions ["q-77146"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77131/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f" :answer/id #uuid "cb6fbe6b-9382-597e-bde6-bf8ed3435f24" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77131/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" :answer/id #uuid "1c5f0624-0824-5de2-93c0-18fd1eacb124" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77131/selection/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" :answer/id #uuid "3980feba-7acf-51c7-bb90-115b5ccc1350" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77131/selection/b331b72fbc647af25e87beeed0ecd2094bccd700da9db995e5333721577b2be0" :answer/id #uuid "f96fa3ac-4707-533d-adc5-5e8981c44b53" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77131/selection/0eb26a40acaca9cea6115682e086ac98f768a09