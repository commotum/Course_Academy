\,\\text{d}x+y\\,\\text{d}y+{z}^{3}\\,\\text{d}z.\\end{aligned}\n$$\n\nSo, $F={x}^{2}\\,i+y\\,j+{z}^{3}\\,k.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-125427/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3bed301c-59ac-5cb3-85e4-4aeaeebc15c2"] :knowledge-point/questions ["q-125427"] :db/ensure [:knowledge-point/validate]} {:db/id "q-125416/selection/d4ccb1f3c873b7fc5cfcee6df1cf256a427cc09044d6822fa14c512e17a3d70c" :answer/id #uuid "6d7a1a33-96e7-5fd4-a228-7f7dfbd49520" :answer/type :answer.type/math :answer/value "{\\int }_{C}2\\,\\text{d}x+(x-3y)\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125416/selection/af20cb2b42a1f23627231ebf3e5abd9069e8369e64a49b9d7f6873e8b03aa958" :answer/id #uuid "514f012e-c2a0-5c77-bad7-0b7e35e869a0" :answer/type :answer.type/math :answer/value "{\\int }_{C}({x}^{2}+1)\\,\\text{d}x+y\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125416/selection/44b7a37594333d98484af13da55528976a7a7bc3ab8013568a4bcff641b94ec8" :answer/id #uuid "a0c52da8-959c-567e-bdf7-9b115d6ac413" :answer/type :answer.type/math :answer/value "{\\int }_{C}({y}^{2}+1)\\,\\text{d}x+x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125416/selection/2da127ba6f755d44ea2a400ef7e3d5c75aff4caa527a14ce46453f5029852409" :answer/id #uuid "e8cd4484-0b0d-5ae4-abe2-6dac077cc733" :answer/type :answer.type/math :answer/value "{\\int }_{C}(x-3y)\\,\\text{d}x+2\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125416/selection/280665d304ff5d35e8e633f63e3e4b3e9aea232d0a36a40d82729ce4c87cd5d8" :answer/id #uuid "d3715e9e-3683-5bc0-b82e-81ccbf1603b1" :answer/type :answer.type/math :answer/value "{\\int }_{C}x\\,\\text{d}x+({y}^{2}+1)\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125416/selection" :answer-field/id #uuid "cb89f632-48d7-5ccf-b3b5-776a801a1524" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-125416/selection/2da127ba6f