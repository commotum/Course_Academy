nswer-field/id #uuid "ffa5c498-2566-5a14-bbf7-d5603ec0574e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-125370/selection/ma-v1/2bd671f3703ef224338416f66f12189acf1bd51766fe95bb4eaa8c51558417a5/c384bd4b183ffb1ee1f72c8400589f07d5b16020101d9fc5c187c31c2133af66" :answer-field/choices ["q-125370/selection/ma-v1/2bd671f3703ef224338416f66f12189acf1bd51766fe95bb4eaa8c51558417a5/c384bd4b183ffb1ee1f72c8400589f07d5b16020101d9fc5c187c31c2133af66" "q-125370/selection/ma-v1/2bd671f3703ef224338416f66f12189acf1bd51766fe95bb4eaa8c51558417a5/8f15f04130d8a84d4e858364d0b9da098e115cf042bc3a0c582444b0564e36a1" "q-125370/selection/ma-v1/2bd671f3703ef224338416f66f12189acf1bd51766fe95bb4eaa8c51558417a5/03cf1f9d342b9ff99a9fdc868b3f4a572bcb218a25fd170ebe57ab3af7a4e905" "q-125370/selection/ma-v1/2bd671f3703ef224338416f66f12189acf1bd51766fe95bb4eaa8c51558417a5/07e74efc57476975fb4d7102777a317c8cab1b5d10de3ded9cbd45bcffbd4618" "q-125370/selection/ma-v1/2bd671f3703ef224338416f66f12189acf1bd51766fe95bb4eaa8c51558417a5/1d1ec262ed32e7cbe0095759ee27e850430931ace6f318a84c2eb9bb0faf8d64"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-125370"] :question/problem "Let $F(x,y,z)={y}^{2}\\,i-{x}^{2}\\,j+5\\,k$ and let $C$ be a path in ${R}^{3}.$ Which of the following is equivalent to ${\\int }_{C}F\\cdot \\text{d}r?$" :question/worked-solution "Given a piecewise-smooth path $C$ and a vector field \n\n$$\nF(x,y,z)=P(x,y,z)\\,i+Q(x,y,z)\\,j+R(x,y,z)\\,k\n$$\n\ndefined on $C,$ we have\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{C}P(x,y,z)\\,\\text{d}x+Q(x,y,z)\\,\\text{d}y+R(x,y,z)\\,\\text{d}z.\n$$\n\nTherefore, in our case, we obtain \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{C}{y}^{2}\\,\\text{d}x-{x}^{2}\\,\\text{d}y+5\\,\\text{d}z.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-125370/selection/ma-v1/2bd671f3703ef224338416f66f12189acf1bd51766fe95bb4eaa8c51558417a5"] :db/ensure [:question/validate]} {:db/id "q-125417/selection/9af5d9af9b8746d6dbb5bcbd5885bc877de96d35bdb165daf8e6056e5af72c7e" :answer/id #uuid "a846a046-5495-534d-82c3-a39b0377b1a2" :answer/type :answer.type/math :answer/value "{\\int }_{C}(3x-1)\\,\\text{d}x+y\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125417/selection/6c98c726ab7a16034fcd1b98db677ab34c8c7bb837fe3986d9cb9f734bb662fc" :answer/id #uuid "9582b85e-fc4e-5578-a500-ab8e88447f5f" :answer/type :answer.type/math :answer/value "{\\int }_{C}x\\,\\text{d}x+(3y-1)\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125417/selection/f1b1dd782f5855509f5ab0d1430c50055fc2aac7a301e6c2cd6eda404c58c89b" :answer/id #uuid "a288affd-b59a-5731-b5b1-579f7a8652fc" :answer/type :answer.type/math :answer/value "{\\int }_{C}4\\,\\text{d}x-(2y-3x)\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125417/selection/7d3f520133a80a1325fa0c2b7f9eede9cef4a8743fa273df8c39fc3fb08244d5" :answer/id #uuid "0dbfebf8-bd10-50e3-a9e0-5dd9a60adc7f" :answer/type :answer.type/math :answer/value "{\\int }_{C}(2y-3x)\\,\\text{d}x-4\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125417/selection/f29ee7304435d6ab0fd3d06a9bf5b71bb82717695e7fc4d953bed5416b57065f" :answer/id #uuid "6a99e9d3-e89d-5a2a-84a7-a5eca44a552e" :answer/type :answer.type/math :answer/value "{\\int }_{C}(3y-1)\\,\\text{d}x+x\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-125417/selection" :answer-field/id #uuid "85ec17be-75c3-534c-8c33-75133f074c4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-125417/selection/f1b1dd782f5855509f5ab0d1430c50055fc2aac7a301e6c2cd6eda404c58c89b" :answer-field/choices ["q-125417/selection/9af5d9af9b8746d6dbb5bcbd5885bc877de96d35bdb165daf8e6056e5af72c7e" "q-125417/selection/6c98c726ab7a16034fcd1b98db677ab34c8c7bb837fe3986d9cb9f734bb662fc" "q-125417/selection/f1b1dd782f5855509f5ab0d1430c50055fc2aac7a301e6c2cd6eda404c58c89b" "q-125417/selectio