r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77143/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "70b4357f-d5c5-5946-9022-0602c4217a1d"] :knowledge-point/questions ["q-77143"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77125/selection/b331b72fbc647af25e87beeed0ecd2094bccd700da9db995e5333721577b2be0" :answer/id #uuid "586ed02f-20a2-5fa8-9228-436044a2a678" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77125/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" :answer/id #uuid "e9be1398-de92-5345-b278-cc0f96459312" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77125/selection/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" :answer/id #uuid "2c8ce228-2a6f-5b15-b722-ad32a0ac365c" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77125/selection/0112f78b443cd401e4d0e83cb3b567685c157bc6e858b9f478baff3b065df996" :answer/id #uuid "0f0310ad-aa2a-57cc-8a7b-63c9dd8346f3" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77125/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f" :answer/id #uuid "da0feff4-c48d-5be9-adae-69d3b6a9a937" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77125/selection" :answer-field/id #uuid "d14f6520-4e77-53f0-946a-275eba7ed4b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77125/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f" :answer-field/choices ["q-77125/selection/b331b72fbc647af25e87beeed0ecd2094bccd700da9db995e5333721577b2be0" "q-77125/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" "q-77125/selection/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" "q-77125/selection/0112f78b443cd401e4d0e83cb3b567685c157bc6e858b9f478baff3b065df996" "q-77125/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f"] :db/ensure [:answer-field/validate]} {:db/id "q-77125" :question/id #uuid "3890c66d-8c20-5b90-82ca-7b57f4f1196f" :question/math-academy-id "q-77125" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/assets/a42c95d0604d9855fb00ac9b7f2a1d2f9db0dd9c6beb3b68750a074818c99dc8.png)\n\nWhich of the following is equivalent to the integral ${\\int }_{C}F\\cdot \\text{d}r,$ where $C$ is the closed polygonal path $ODEO,$ shown in the diagram above, traversed in the counterclockwise direction?" :question/worked-solution "First, notice that we can represent $C,$ which is traversed in counterclockwise, as the union of $3$ paths: \n\n$$\nC={C}_{1}\\cup {-{C}_{2}}\\cup {-{C}_{3}},\n$$\n\nwhere $-{C}_{2}$ and $-{C}_{3}$ are the same paths as ${C}_{2}$ and ${C}_{3}$ but traversed in the opposite direction.\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{-{C}_{2}}F\\cdot \\text{d}r+{\\int }_{-{C}_{3}}F\\cdot \\text{d}r \\\\  & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$" 