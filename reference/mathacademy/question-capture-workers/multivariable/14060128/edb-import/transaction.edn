t \\text{d}r+{\\int }_{-{C}_{3}}F\\cdot \\text{d}r \\\\  & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77131/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "70b4357f-d5c5-5946-9022-0602c4217a1d"] :knowledge-point/questions ["q-77131"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77143/selection/0eb26a40acaca9cea6115682e086ac98f768a095f98f0f6c055016c6e0fbe9d3" :answer/id #uuid "d5ed875e-c689-5a4e-9408-461ffcee3d4b" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77143/selection/f47739a8ffa56e1c1475de0d5b0b439e01e2abe6ed718f59aca03796d9b5164d" :answer/id #uuid "6fb0eeb1-7f04-5fd5-a33e-cb9c30212903" :answer/type :answer.type/math :answer/value "-{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r+{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77143/selection/dba9bdc16849274b5723c42baa68ea1cc97b282b65dfadb88f4c692c29ade4ee" :answer/id #uuid "a4a03b7f-47ba-5642-9d4b-125967d7f1e6" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77143/selection/ab79d8e668398b9227c293e171d9553dc22cb5cf8447df9b53c5da8b7863542f" :answer/id #uuid "6758a4f8-963f-53f1-8d63-3eabdc330315" :answer/type :answer.type/math :answer/value "{\\int }_{{C}_{1}}F\\cdot \\text{d}r-{\\int }_{{C}_{2}}F\\cdot \\text{d}r-{\\int }_{{C}_{3}}F\\cdot \\text{d}r" :db/ensure [:answer/validate]} {:db/id "q-77143/selection/3f707b04d69b0b233940d68a127f5014b47a36c3a68a9502184d3bcef692b87d" :answer/id #uuid "bba9a765-84a0-573f-9004-4c15aa4956df" :answer/type :answer.type/