35230 true] [17592186338855 1091 #edb/ref 17592186045465 13194139535230 true] [17592186338855 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14060128/assets/73c6a8268a179f72611fb65e099d1249d48501e4fd4731d03747800e1944fd97.png)\n\nThe path ${C}_{1}$ consists of a the line segment from the point $A(0,1)$ to the point $B(1,2),$ and the path ${C}_{2}$ consists of a line segment from the point $B(1,2)$ to the point $D(1,3).$\n\nGiven that ${\\int }_{{C}_{2}}F\\cdot \\text{d}r=\\frac{7}{2},$ evaluate ${\\int }_{C}F\\cdot \\text{d}r,$ where $F(x,y)=(2x-3y)\\,i+(x+y)\\,j,$ and $C={C}_{1}\\cup {C}_{2}.$" 13194139535230 true] [17592186338855 1113 #uuid "ff3b2637-63d0-5a51-b3a4-46d0fad2a2ed" 13194139535230 true] [17592186338855 1145 "We will use the fact that\n\n$$\n{\\int }_{C}F\\cdot \\text{d}r={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r.\n$$\n\nWe're given the value of the second integral, so we only need to work out the first.\n\nThe path ${C}_{1}$ is the line segment from $A$ to $B.$  It can be parametrized as\n\n$$\n\\begin{aligned}{r}_{1}(t) & =a+t(b-a) \\\\  & =⟨0,1⟩+t(⟨1,2⟩-⟨0,1⟩) \\\\  & =⟨t,1+t⟩ \\\\  & =t\\,i+(1+t)\\,j,\\end{aligned}\n$$\n\nwhere $0<t<1.$ Along this segment, we have $x=t$ and $y=1+t.$ Therefore, \n\n$$\n\\begin{aligned}F({r}_{1}(t)) & =(2x-3y)\\,i+(x+y)\\,j \\\\  & =(2t-3(1+t))\\,i+(t+(1+t))\\,j \\\\  & =(-3-t)\\,i+(2t+1)\\,j.\\end{aligned}\n$$\n\nComputing the derivative, we get the following:\n\n$$\n\\begin{aligned}{r}_{1}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t)i+\\frac{\\text{d}}{\\text{d}t}(1+t)j \\\\  & =i+j\\end{aligned}\n$$\n\nWe can now compute the dot product:\n\n$$\n\\begin{aligned}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t) & =((-3-t)\\,i+(2t+1)\\,j)\\cdot (i+j) \\\\  & =-3-t+2t+1 \\\\  & =t-2\\end{aligned}\n$$\n\nFinally, we can evaluate the integral, as follows: \n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot \\text{d}r & ={\\int }_{{C}_{1}}F\\cdot \\text{d}r+{\\int }_{{C}_{2}}F\\cdot \\text{d}r \\\\  & ={\\int }_{0}^{1}F({r}_{1}(t))\\cdot {r}_{1}^{′}(t)\\,\\text{d}t+\\frac{7}{2} \\\\  & ={\\int }_{0}^{1}(t-2)\\,\\text{d}t+\\frac{7}{2} \\\\  & ={[\\frac{{t}^{2}}{2}-2t]}_{0}^{1}+\\frac{7}{2} \\\\  & =[\\frac{1}{2}-2-0]+\\frac{7}{2} \\\\  & =-\\frac{3}{2}+\\frac{7}{2} \\\\  & =2\\end{aligned}\n$$" 13194139535230 true] [17592186338856 1000 #edb/ref 17592186338857 13194139535230 true] [17592186338856 1000 #edb/ref 17592186338858 13194139535230 true] [17592186338856 1000 #edb/ref 17592186338859 13194139535230 true] [17592186338856 1000 #edb/ref 17592186338860 13194139535230 true] [17592186338856 1000 #edb/ref 17592186338861 13194139535230 true] [17592186338856 1040 #edb/ref 17592186045450 13194139535230 true] [17592186338856 1041 "selection" 13194139535230 true] [17592186338856 1104 #edb/ref 17592186338860 13194139535230 true] [17592186338856 1110 #uuid "b3ea1cae-7b0b-5f81-8c1f-98fa88663273" 13194139535230 true] [17592186338857 1034 "\\frac{7}{2}" 13194139535230 true] [17592186338857 1103 #edb/ref 17592186045453 13194139535230 true] [17592186338857 1111 #uuid "bbe46702-0779-5802-ba7f-2b20370f0a6d" 13194139535230 true] [17592186338858 1034 "e-2" 13194139535230 true] [17592186338858 1103 #edb/ref 17592186045453 13194139535230 true] [17592186338858 1111 #uuid "2083c2e6-7d2a-5e0f-8192-a12055690202" 13194139535230 true] [17592186338859 1034 "-\\frac{3}{2}" 13194139535230 true] [17592186338859 1103 #edb/ref 17592186045453 13194139535230 true] [17592186338859 1111 #uuid "5e8c4b83-ba8a-5d16-bd8c-e5ed99be2ad3" 13194139535230 true] [17592186338860 1034 "2" 13194139535230 true] [17592186338860 1103 #edb/ref 17592186045453 13194139535230 true] [17592186338860 1111 #uuid "a3b02fcc-a142-5e8b-a69a-0fd4ab1bf686" 13194139535230 true] [17592186338861 1034 "2+\\operatorname{ln}⁡3" 13194139535230 true] [17592186338861 1103 #edb/ref 17592186045453 13194139535230 true] [17592186338861 1111 #uuid "2224fb9e-af87-566e-a8ea-6a6ad44e203e" 1319413953