_{D}2(y+2z-0)\\,\\text{d}A \\\\  & ={∬}_{D}2y+4z\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}2y+4z\\,\\text{d}A & ={\\int }_{1}^{3}{\\int }_{0}^{2y}2y+4z\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}[2yz+2{z}^{2}]_{z=0}^{z=2y}\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}2y(2y)+2(2y)^{2}\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}4{y}^{2}+8{y}^{2}\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}12{y}^{2}\\,\\text{d}y \\\\  & =[4{y}^{3}]_{y=1}^{y=3} \\\\  & =4(27-1) \\\\  & =104\\end{aligned}\n$$" 13194139535361 true] [17592186345786 1000 #edb/ref 17592186345787 13194139535361 true] [17592186345786 1000 #edb/ref 17592186345788 13194139535361 true] [17592186345786 1000 #edb/ref 17592186345789 13194139535361 true] [17592186345786 1000 #edb/ref 17592186345790 13194139535361 true] [17592186345786 1000 #edb/ref 17592186345791 13194139535361 true] [17592186345786 1040 #edb/ref 17592186045450 13194139535361 true] [17592186345786 1041 "selection" 13194139535361 true] [17592186345786 1104 #edb/ref 17592186345788 13194139535361 true] [17592186345786 1110 #uuid "8f29b384-fa33-5b83-9cd5-e308d52b498a" 13194139535361 true] [17592186345787 1034 "94" 13194139535361 true] [17592186345787 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345787 1111 #uuid "83fc4178-3778-561f-a894-30026f919f85" 13194139535361 true] [17592186345788 1034 "104" 13194139535361 true] [17592186345788 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345788 1111 #uuid "855588bd-17c6-5cb3-905b-eea06e2c2a66" 13194139535361 true] [17592186345789 1034 "82" 13194139535361 true] [17592186345789 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345789 1111 #uuid "99da2280-53f2-5e5b-b72d-02dcf3fa4b49" 13194139535361 true] [17592186345790 1034 "76" 13194139535361 true] [17592186345790 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345790 1111 #uuid "e3437526-8df8-5c32-8411-217b35638a43" 13194139535361 true] [17592186345791 1034 "124" 13194139535361 true] [17592186345791 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345791 1111 #uuid "0f4f2f4e-5fde-56ef-b4db-a58c33a6f28a" 13194139535361 true] [17592186345792 1017 #edb/ref 17592186345793 13194139535361 true] [17592186345792 1089 "q-161561" 13194139535361 true] [17592186345792 1091 #edb/ref 17592186045465 13194139535361 true] [17592186345792 1100 "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{z}4xz\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 2,\\,0\\le z\\le \\sqrt{4-2y}}.\n$$" 13194139535361 true] [17592186345792 1113 #uuid "a06af5b6-6503-5e3b-8a72-567c64d6a27c" 13194139535361 true] [17592186345792 1145 "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{z}4xz\\,\\text{d}x]\\text{d}A & ={∬}_{D}[2z{x}^{2}]_{x=0}^{x=z}\\,\\text{d}A \\\\  & ={∬}_{D}2z({z}^{2}-0)\\,\\text{d}A \\\\  & ={∬}_{D}2{z}^{3}\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}2{z}^{3}\\,\\text{d}A & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2y}}2{z}^{3}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{[\\frac{1}{2}{z}^{4}]}_{z=0}^{z=\\sqrt{4-2y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(\\sqrt{4-2y)})^{4}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(4-2y)^{2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(16-16y+4{y}^{2})\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}8-8y+2{y}^{2}\\,\\text{d}y \\\\  & ={[8y-4{y}^{2}+\\frac{2}{3}{y}^{3}]}_{y=0}^{y=2} \\\\  & =16-16+\\frac{16}{3} \\\\  & =\\frac{16}{3}\\end{aligned}\n$$" 13194139535361 true] [17592186345793 1000 #edb/ref 17592186345794 13194139535361 true] [17592186345793 1000 #edb/ref 17592186345795 13194139535361 true] [17592186345793 1000 #edb/ref 17592186345796 13194139535361 true] [17592186345793 1000 #edb/ref 17592186345797 13194139535361 true] [17592186345793 1000 #edb/ref 17592186345798 13194139535361 true] [17592186345793 1040 #edb/ref 17592186045450 13194139535361 true] [17592186345793 1041 "selection" 13194139535361 true] [17592186345793 1104 #edb/ref 17592186345794 13194139535361 true] [17592186345793 1110 #uuid "66b3538a-313c-52d6-b33e-cc222a5aa658" 13194139535361 true] [17592186345794 1034 "\\frac{16}{3}" 13194139535361 true] [17592186345794 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345794 1111 #uuid "2b47d6d3-ab78-5890-a21a-f5fa838567e5" 13194139535361 true] [17592186345795 1034 "\\frac{14}{3}" 13194139535361 true] [17592186345795 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345795 1111 #uuid "25e5a23d-8498-5e55-96b2-45a6b80d7cf9" 13194139535361 true] [17592186345796 1034 "8" 13194139535361 true] [17592186345796 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345796 1111 #uuid "d4458c12-032b-5ed8-bc56-f9489cfd37e4" 13194139535361 true] [17592186345797 1034 "18" 13194139535361 true] [17592186345797 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345797 1111 #uuid "30e37ac7-9a9b-565c-9556-318b6faea207" 13194139535361 true] [17592186345798 1034 "\\frac{22}{3}" 13194139535361 true] [17592186345798 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345798 1111 #uuid "d26036a4-f7e8-543d-b97c-ad9a77a319e7" 13194139535361 true] [17592186345799 1017 #edb/ref 17592186345800 13194139535361 true] [17592186345799 1089 "q-161563" 13194139535361 true] [17592186345799 1091 #edb/ref 17592186045465 13194139535361 true] [17592186345799 1100 "The triple integral\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{∗}^{∗}{\\int }_{a}^{b}{\\int }_{∗}^{∗}f(x,y,z)\\,dx\\,dz\\,dy\n$$\n\nis defined over the type II region $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,1\\le y\\le 4,\\,2y\\le z\\le 8,\\,0\\le x\\le {z}^{2}-{y}^{2}}.\n$$\n\nWhat is $a+b?$" 13194139535361 true] [17592186345799 1113 #uuid "8bf1bbf2-7733-5ac2-a5df-579136f67cb2" 13194139535361 true] [17592186345799 1145 "A type II region in three-dimensional space can be written as\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,{u}_{1}(y,z)\\le x\\le {u}_{2}(y,z)}.\n$$\n\nA typical three-dimensional type II region can be visualized schematically, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/a905e1f60fb0aa865c071fcbccbfecb30dcac7a74b4b647d24a40f4c89ff1935.png)\n\n \n\nIf $R$ is a type II region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(y,z)=0,\\,{u}_{2}(y,z)={z}^{2}-{y}^{2}.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{{z}^{2}-{y}^{2}}f(x,y,z)\\,dx]dA.\n$$\n\nNow, the region $D$ is given by\n\n$$\nD={(x,y)\\,:\\,1\\le y\\le 4,\\,2y\\le z\\le 8}.\n$$\n\nTherefore, by expressing the double integral over $D$ as a repeated integral, we get\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{{z}^{2}-{y}^{2}}f(x,y,z)\\,dx]dA & ={\\int }_{1}^{4}{\\int }_{2y}^{8}[{\\int }_{0}^{{z}^{2}-{y}^{2}}f(x,y,z)\\,dx]dz\\,\\text{d}y \\\\  & ={\\int }_{1}^{4}{\\int }_{2y}^{8}{\\int }_{0}^{{z}^{2}-{y}^{2}}f(x,y,z)\\,dx\\,dz\\,dy.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=2y+8.\n$$" 13194139535361 true] [17592186345800 1000 #edb/ref 17592186345801 13194139535361 true] [17592186345800 1000 #edb/ref 17592186345802 13194139535361 true] [17592186345800 1000 #edb/ref 17592186345803 13194139535361 true] [17592186345800 1000 #edb/ref 17592186345804 13194139535361 true] [17592186345800 1000 #edb/ref 17592186345805 13194139535361 true] [17592186345800 1040 #edb/ref 17592186045450 13194139535361 true] [17592186345800 1041 "selection" 13194139535361 true] [17592186345800 1104 #edb/ref 17592186345803 13194139535361 true] [17592186345800 1110 #uuid "6d9b4dcc-8dfb-5857-bf6a-c65f904912c3" 13194139535361 true] [17592186345801 1034 "3" 13194139535361 true] [17592186345801 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345801 1111 #uuid "8ce5d283-2b53-5584-b58e-605c9ec84740" 13194139535361 true] [17592186345802 1034 "{z}^{2}-{y}^{2}" 13194139535361 true] [17592186345802 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345802 1111 #uuid "b0fc01a3-79f2-52f8-aaf4-4bf5c2cdbf85" 13194139535361 true] [17592186345803 1034 "2y+8" 13194139535361 true] [17592186345803 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345803 1111 #uuid "f1519679-dfcf-5e0e-95f8-2f0071168365" 13194139535361 true] [17592186345804 1034 "2y+3" 13194139535361 true] [17592186345804 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345804 1111 #uuid "069a7d4d-2ef7-5a82-aed4-b61b50f08be6" 13194139535361 true] [17592186345805 1034 "5" 13194139535361 true] [17592186345805 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345805 1111 #uuid "c0da0498-6009-583b-a739-a3b823bfe474" 13194139535361 true] [17592186345806 1017 #edb/ref 17592186345807 13194139535361 true] [17592186345806 1089 "q-161564" 13194139535361 true] [17592186345806 1091 #edb/ref 17592186045465 13194139535361 true] [17592186345806 1100 "The triple integral\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{∗}^{∗}{\\int }_{∗}^{∗}f(x,y,z)\\,dx\\,dy\\,dz\n$$\n\nis defined over the type II region $R,$ given by\n\n$$\nR={(x,y,z)\\,:\\,-z\\le y\\le 1,\\,4\\le z\\le 5,\\,-\\sqrt{y+z}\\le x\\le 4}.\n$$\n\nWhat is $a+b?$" 13194139535361 true] [17592186345806 1113 #uuid "0d1c0425-d74e-54e3-8f7e-dc33ee94df6c" 13194139535361 true] [17592186345806 1145 "A type II region in three-dimensional space can be written as\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,{u}_{1}(y,z)\\le x\\le {u}_{2}(y,z)}.\n$$\n\nA typical three-dimensional type II region can be visualized schematically, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/a905e1f60fb0aa865c071fcbccbfecb30dcac7a74b4b647d24a40f4c89ff1935.png)\n\n \n\nIf $R$ is a type II region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x]\\,\\text{d}A\n$$\n\nIn our case, we have\n\n$$\n{u}_{1}(y,z)=-\\sqrt{y+z},\\,{u}_{2}(y,z)=4.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{-\\sqrt{y+z}}^{4}f(x,y,z)\\,dx]dA.\n$$\n\nNow, the region $D$ is given by\n\n$$\nD={(x,y)\\,:\\,-z\\le y\\le 1,\\,4\\le z\\le 5}.\n$$\n\nTherefore, by expressing the double integral over $D$ as a repeated integral, we get\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{-\\sqrt{y+z}}^{4}f(x,y,z)\\,dx]dA & ={\\int }_{4}^{5}{\\int }_{-z}^{1}[{\\int }_{-\\sqrt{y+z}}^{4}f(x,y,z)\\,dx]dy\\,\\text{d}z \\\\  & ={\\int }_{4}^{5}{\\int }_{-z}^{1}{\\int }_{-\\sqrt{y+z}}^{4}f(x,y,z)\\,dx\\,dy\\,dz.\\end{aligned}\n$$\n\nFinally, \n\n$$\na+b=4+5=9.\n$$" 13194139535361 true] [17592186345807 1000 #edb/ref 17592186345808 13194139535361 true] [17592186345807 1000 #edb/ref 17592186345809 13194139535361 true] [17592186345807 1000 #edb/ref 17592186345810 13194139535361 true] [17592186345807 1000 #edb/ref 17592186345811 13194139535361 true] [17592186345807 1000 #edb/ref 17592186345812 13194139535361 true] [17592186345807 1040 #edb/ref 17592186045450 13194139535361 true] [17592186345807 1041 "selection" 13194139535361 true] [17592186345807 1104 #edb/ref 17592186345808 13194139535361 true] [17592186345807 1110 #uuid "bf378297-4efc-59da-9476-d79c43e94ceb" 13194139535361 true] [17592186345808 1034 "9" 13194139535361 true] [17592186345808 1103 #edb/ref 17592186045453 13194139535361 true] [17592186345808 1111 #uuid "8e59a877-7829-5aa5-b8de-39ab9aec25e8" 13194139535361 true] [17592186345809 1034 "4-\\sqrt{y+z}" 13194139535361 true] [17592186345809 1103 #edb/ref 17592186045453 13194139535361 true]