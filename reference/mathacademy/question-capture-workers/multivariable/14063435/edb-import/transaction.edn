1aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" "q-161561/selection/e6646fcb45a26e1ecf9ce86b9413aae0ce5df5e798725213d97f8bdf67694e61"] :db/ensure [:answer-field/validate]} {:db/id "q-161561" :question/id #uuid "a06af5b6-6503-5e3b-8a72-567c64d6a27c" :question/math-academy-id "q-161561" :question/problem "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{z}4xz\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 2,\\,0\\le z\\le \\sqrt{4-2y}}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{z}4xz\\,\\text{d}x]\\text{d}A & ={∬}_{D}[2z{x}^{2}]_{x=0}^{x=z}\\,\\text{d}A \\\\  & ={∬}_{D}2z({z}^{2}-0)\\,\\text{d}A \\\\  & ={∬}_{D}2{z}^{3}\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}2{z}^{3}\\,\\text{d}A & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{4-2y}}2{z}^{3}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{[\\frac{1}{2}{z}^{4}]}_{z=0}^{z=\\sqrt{4-2y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(\\sqrt{4-2y)})^{4}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(4-2y)^{2}\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}\\frac{1}{2}(16-16y+4{y}^{2})\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}8-8y+2{y}^{2}\\,\\text{d}y \\\\  & ={[8y-4{y}^{2}+\\frac{2}{3}{y}^{3}]}_{y=0}^{y=2} \\\\  & =16-16+\\frac{16}{3} \\\\  & =\\frac{16}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161561/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0bd48398-cb9d-579f-b7f7-0f6be19172ce"] :knowledge-point/questions ["q-161561"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161571/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "b51e872d-153f-5642-9787-350a80175f8a" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-161571/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" :answer/id #uuid "327c7773-5dae-5bcf-8fa6-a2365f723a02" :answer/type :answer.type/math :answer/value "\\frac{9}{2}" :db/ensure [:answer/validate]} {:db/id "q-161571/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "0089b168-80b7-5fba-9e26-8af7e6bec32c" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-161571/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "30f104d7-0280-507b-8db3-92abc8668141" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-161571/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "1d0314ee-3843-5e04-9478-b1f90d18a821" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-161571/selection" :answer-field/id #uuid "096fc5cf-f431-53fe-8d91-3eed2358a342" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161571/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer-field/choices ["q-161571/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-161571/selection/07791849728418b50d59d705e3d959e93383e408886fd319ae3a513a1b7159ba" "q-161571/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-161571/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-161571/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856"] :db/ensure [:answer-field/validate]} {:db/id "q-161571" :question/id #uuid "8dfdbc1e-41c1-5eba-82b0-7d445d5af9aa" :question/math-academy-id "q-161571" :question/problem "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{\\sqrt{2z}}\\frac{x}{2}\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD={(y,z)\\,:\\,1\\le y\\le 3,\\,y\\le z\\le y+1}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{2z}}\\frac{x}{2}\\,\\text{d}x]\\text{d}A & ={∬}_{D}\\frac{1}{4}[{x}^{2}]_{x=0}^{x=\\sqrt{2z}}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{4}(2z-0)\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{1}{2}z\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{2}z\\,\\text{d}A & ={\\int }_{1}^{3}{\\int }_{y}^{y+1}\\frac{1}{2}z\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}\\frac{1}{4}[{z}^{2}]_{z=y}^{z=y+1}\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}\\frac{1}{4}((y+1)^{2}-{y}^{2})\\,\\text{d}y \\\\  & ={\\int }_{1}^{3}\\frac{1}{4}(2y+1)\\,\\text{d}y \\\\  & =\\frac{1}{4}{[{y}^{2}+y]}_{y=1}^{y=3} \\\\  & =\\frac{1}{4}(9+3)-\\frac{1}{4}(1+1) \\\\  & =\\frac{5}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161571/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0bd48398-cb9d-579f-b7f7-0f6be19172ce"] :knowledge-point/questions ["q-161571"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161570/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" :answer/id #uuid "a4c65824-061b-50e6-9559-071c9dbefca8" :answer/type :answer.type/math :answer/value "42" :db/ensure [:answer/validate]} {:db/id "q-161570/selection/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2" :answer/id #uuid "8b298d70-c115-510f-9ceb-c9e0d66b55a7" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "q-161570/selection/87f70942b9483cb5cedbd7b4150ebc995451772f024ba0c75aaaea5741b3bd06" :answer/id #uuid "487a4a13-7ebc-57b2-b138-ce424a172816" :answer/type :answer.type/math :answer/value "68" :db/ensure [:answer/validate]} {:db/id "q-161570/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" :answer/id #uuid "b10f9425-6859-5bad-a114-f1a321d29e40" :answer/type :answer.type/math :answer/value "90" :db/ensure [:answer/validate]} {:db/id "q-161570/selection/d6944c4d51ee6e8916d5e2815a8478bad91a2f9e9e9bcd499b503b9fbcb165ab" :answer/id #uuid "9988de87-50d6-5cc5-8f3b-04a5d83b0c0b" :answer/type :answer.type/math :answer/value "54" :db/ensure [:answer/validate]} {:db/id "q-161570/selection" :answer-field/id #uuid "36609a6b-13a3-5328-a8b9-7129fc23f252" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161570/selection/d6944c4d51ee6e8916d5e2815a8478bad91a2f9e9e9bcd499b503b9fbcb165ab" :answer-field/choices ["q-161570/selection/a20b3c9808c291c56ec5bfc5f0f93a856fc692714ca7ebd36c5e4bc361f7075c" "q-161570/selection/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2" "q-161570/selection/87f70942b9483cb5cedbd7b4150ebc995451772f024ba0c75aaaea5741b3bd06" "q-161570/selection/f9ce6d2531e925e028befc33f5bb5202bf5c98dc29df5818c58d5bd59c914412" "q-161570/selection/d6944c4d51ee6e8916d5e2815a8478bad91a2f9e9e9bcd499b503b9fbcb165ab"] :db/ensure [:answer-field/validate]} {:db/id "q-161570" :question/id #uuid "3d4d48da-93b4-5e0b-a47c-b8056a8a432d" :question/math-academy-id "q-161570" :question/problem "Evaluate the mixed integral\n\n$$\n{∬}_{D}[{\\int }_{0}^{\\sqrt{{y}^{2}+{z}^{2}}}4x\\,\\text{d}x]\\text{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 3,\\,0\\le z\\le y}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{{y}^{2}+{z}^{2}}}4x\\,\\text{d}x]\\text{d}A & ={∬}_{D}2[{x}^{2}]_{x=0}^{x=\\sqrt{{y}^{2}+{z}^{2}}}\\,\\text{d}A \\\\  & ={∬}_{D}2({(\\sqrt{{y}^{2}+{z}^{2}})}^{2}-0)\\,\\text{d}A \\\\  & ={∬}_{D}2{y}^{2}+2{z}^{2}\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}2{y}^{2}+2{z}^{2}\\,\\text{d}A & ={\\int }_{0}^{3}{\\int }_{0}^{y}2{y}^{2}+2{z}^{2}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}{[2{y}^{2}z+\\frac{2}{3}{z}^{3}]}_{z=0}^{z=y}\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}2{y}^{3}+\\frac{2}{3}{y}^{3}\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}\\frac{8}{3}{y}^{3}\\,\\text{d}y \\\\  & ={[\\frac{2}{3}{y}^{4}]}_{y=0}^{y=3} \\\\  & =\\frac{2}{3}(81-0) \\\\  & =54\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161570/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0bd48398-cb9d-579f-b7f7-0f6be19172ce"] :knowledge-point/questions ["q-161570"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161575/selection/5993b717b73cd5512ba44c97fef7689b7aa66d3f713ed8f773bd35622a47da9d" :answer/id #uuid "29fd257e-187d-560a-8c07-c8cb5d56ce03" :answer/type :answer.type/math :answer/value "8-3e" :db/ensure [:answer/validate]} {:db/id "q-161575/selection/61dbf4b1960554051a62f9151c1b66686e649e8c28ef7bdbf5e4a826cabd6b75" :answer/id #uuid "b9842096-2ee3-5bb7-9d74-ac9cd5d88db5" :answer/type :answer.type/math :answer/value "2{e}^{-1}+1" :db/ensure [:answer/validate]} {:db/id "q-161575/selection/747032b4a4c43424f389f4625a5dabdb41ebb37c1f67e94ae811cd15d0983889" :answer/id #uuid "dd842b71-aba2-5250-a4bd-b50a300b283b" :answer/type :answer.type/math :answer/value "3-{e}^{2}" :db/ensure [:answer/validate]} {:db/id "q-161575/selection/9c7804ca9c540566d4d003db71cccb84f8dcb5bf1309d11afa9bdbf30e7dd73b" :answer/id #uuid "933dc5e5-8d51-5602-b9f5-cdf0d13b16fe" :answer/type :answer.type/math :answer/value "4{e}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-161575/selection/870d15a34b646be1c862985b1b79215e9c818723f46515c8ca55deca95924736" :answer/id #uuid "525ec21c-bf14-5005-bcd9-ab9cb6c117d1" :answer/type :answer.type/math :answer/value "3{e}^{-1}-2" :db/ensure [:answer/validate]} {:db/id "q-161575/selection" :answer-field/id #uuid "52075f2e-7b6e-5241-b6d3-25133ec49afd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161575/selection/61dbf4b1960554051a62f9151c1b66686e649e8c28ef7bdbf5e4a826cabd6b75" :answer-field/choices ["q-161575/selection/5993b717b73cd5512ba44c97fef7689b7aa66d3f713ed8f773bd35622a47da9d" "q-161575/selection/61dbf4b1960554051a62f9151c1b66686e649e8c28ef7bdbf5e4a826cabd6b75" "q-161575/selection/747032b4a4c43424f389f4625a5dabdb41ebb37c1f67e94ae811cd15d0983889" "q-161575/selection/9c7804ca9c540566d4d003db71cccb84f8dcb5bf1309d11afa9bdbf30e7dd73b" "q-161575/selection/870d15a34b646be1c862985b1b79215e9c818723f46515c8ca55deca95924736"] :db/ensure [:answer-field/validate]} {:db/id "q-161575" :question/id #uuid "8bde12b4-ffd2-5c0e-8555-b9fe3facf7ea" :question/math-academy-id "q-161575" :question/problem "Evaluate the triple integral\n\n$$\n{∭}_{R}2+2{e}^{x}\\,\\text{d}V\n$$\n\nwhere $R$ is the type II region given by \n\n$$\nR={(x,y,z)\\,:\\,-1\\le y\\le 0,\\,0\\le z\\le 1,\\,-z\\le x\\le 0}.\n$$" :question/worked-solution "Writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}2+2{e}^{x}\\,\\text{d}V={\\int }_{-1}^{0}{\\int }_{0}^{1}{\\int }_{-z}^{0}2+2{e}^{x}\\,dx\\,dz\\,dy.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1}{\\int }_{-z}^{0}2+2{e}^{x}\\,dx\\,dz\\,dy & ={\\int }_{-1}^{0}{\\int }_{0}^{1}[{\\int }_{-z}^{0}2+2{e}^{x}\\,dx]dz\\,dy \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}[2x+2{e}^{x}]_{x=-z}^{x=0}dz\\,dy \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}0+2{e}^{0}-2(-z)-2{e}^{-z}\\,dz\\,dy \\\\  & ={\\int }_{-1}^{0}{\\int }_{0}^{1}2+2z-2{e}^{-z}\\,dz\\,dy\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z,$ treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}{\\int }_{0}^{1}2+2z-2{e}^{-z}\\,dz\\,dy & ={\\int }_{-1}^{0}[{\\int }_{0}^{1}2+2z-2{e}^{-z}\\,dz]dy \\\\  & ={\\int }_{-1}^{0}{[2z+{z}^{2}+2{e}^{-z}]}_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{-1}^{0}(2+1+2{e}^{-1})-2{e}^{0}\\,dy \\\\  & ={\\int }_{-1}^{0}1+2{e}^{-1}\\,dy\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{-1}^{0}1+2{e}^{-1}\\,dy & =(1+2{e}^{-1})[y]_{y=-1}^{y=0} \\\\  & =(1+2{e}^{-1})(0-(-1)) \\\\  & =2{e}^{-1}+1\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161575/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90adf237-9627-55f1-8f90-8fbc4acf02fc"] :knowledge-point/questions ["q-161575"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161585/selection/776598c485748fda2136e6cd250d92fcba2fc2dc4c727ac05e42a07877519160" :answer/id #uuid "587e8c04-ddd1-5ee5-8403-ec1c90247522" :answer/type :answer.type/math :answer/value "\\frac{79}{100}" :db/ensure [:answer/validate]} {:db/id "q-161585/selection/0c26f1abf23aaca988d79237fa90b8b5470beed23d38e42a07cc5f4532be5837" :answer/id #uuid "31002da7-5aa8-5131-bed9-bfe5d9350bae" :answer/type :answer.type/math :answer/value "\\frac{72}{121}" :db/ensure [:answer/validate]} {:db/id "q-161585/selection/958644239eebfe877a6bf2bb934d1ceda72e94b02a33e8003f1c2073298ba3d9" :answer/id #uuid "2c023ca5-9eba-556b-996c-b06fca980833" :answer/type :answer.type/math :answer/value "\\frac{61}{105}" :db/ensure [:answer/validate]} {:db/id "q-161585/selection/6ac4e0fb50e5ff2a151d60ea7214874e883d178519f8cd6a323e45573481f06f" :answer/id #uuid "3e3c6399-6607-5c87-93e7-f06e701d6c3a" :answer/type :answer.type/math :answer/value "\\frac{34}{81}" :db/ensure [:answer/validate]} {:db/id "q-161585/selection/d003f746e761909a75ed374bb6c60d8e52d78821f3e6b47f3f43088a59e6b775" :answer/id #uuid "4dc6af97-65f4-578e-b92a-db5b854954b5" :answer/type :answer.type/math :answer/value "\\frac{67}{92}" :db/ensure [:answer/validate]} {:db/id "q-161585/selection" :answer-field/id #uuid "be53cb49-8a48-5762-aeaa-2ef555c03209" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161585/selection/958644239eebfe877a6bf2bb934d1ceda72e94b02a33e8003f1c2073298ba3d9" :answer-field/choices ["q-161585/selection/776598c485748fda2136e6cd250d92fcba2fc2dc4c727ac05e42a07877519160" "q-161585/selection/0c26f1abf23aaca988d79237fa90b8b5470beed23d38e42a07cc5f4532be5837" "q-161585/selection/958644239eebfe877a6bf2bb934d1ceda72e94b02a33e8003f1c2073298ba3d9" "q-161585/selection/6ac4e0fb50e5ff2a151d60ea7214874e883d178519f8cd6a323e45573481f06f" "q-161585/selection/d003f746e761909a75ed374bb6c60d8e52d78821f3e6b47f3f43088a59e6b775"] :db/ensure [:answer-field/validate]} {:db/id "q-161585" :question/id #uuid "411a3ab9-0aa0-5668-8896-afd110dee3fc" :question/math-academy-id "q-161585" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,0\\le x\\le {y}^{2}+{z}^{2}+1},\n$$\n\nand $D$ is a finite region in $yz$-plane enclosed between the $y$-axis, the line $y=1$ and the parabola $z=-{y}^{2}$ in the fourth quadrant." :question/worked-solution "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}\\text{d}V={∬}_{D}[{\\int }_{0}^{{y}^{2}+{z}^{2}+1}dx]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{{y}^{2}+{z}^{2}+1}dx]dA & ={∬}_{D}[x]_{x=0}^{x={y}^{2}+{z}^{2}+1}\\,dA \\\\  & ={∬}_{D}{y}^{2}+{z}^{2}+1\\,dA\\end{aligned}\n$$\n\nWe must now evaluate the double integral above over the region $D$ in the $yz$-plane shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/38ea49a6fae41574107b2ba68a578586a306cf43d419d4de5699dcfa009137c2.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}+{z}^{2}+1\\,dA & ={\\int }_{0}^{1}{\\int }_{-{y}^{2}}^{0}{y}^{2}+{z}^{2}+1\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}[{\\int }_{-{y}^{2}}^{0}{y}^{2}+{z}^{2}+1\\,dz]dy \\\\  & ={\\int }_{0}^{1}{[({y}^{2}+1)z+\\frac{1}{3}{z}^{3}]}_{z=-{y}^{2}}^{z=0}dy \\\\  & ={\\int }_{0}^{1}({y}^{2}+1)((0-(-{y}^{2}))+\\frac{1}{3}(0-{(-{y}^{2})}^{3})\\,dy \\\\  & ={\\int }_{0}^{1}({y}^{2}+1){y}^{2}+\\frac{1}{3}{y}^{6}\\,dy \\\\  & ={\\int }_{0}^{1}{y}^{4}+{y}^{2}+\\frac{1}{3}{y}^{6}\\,dy \\\\  & ={[\\frac{1}{5}{y}^{5}+\\frac{1}{3}{y}^{3}+\\frac{1}{21}{y}^{7}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{5}+\\frac{1}{3}+\\frac{1}{21} \\\\  & =\\frac{61}{105}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161585/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90adf237-9627-55f1-8f90-8fbc4acf02fc"] :knowledge-point/questions ["q-161585"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40208"] :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}2y\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,0\\le x\\le z\\sqrt{3}},\n$$\n\nand $D$ is a finite region in $yz$-plane enclosed between the $y$-axes, the line $y=2$ and the line $z=y$ in the first quadrant." :question/worked-solution "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}2y\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{z\\sqrt{3}}2y\\,dx]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{z\\sqrt{3}}2y\\,dx]dA & ={∬}_{D}2y[x]_{x=0}^{x=z\\sqrt{3}}\\,dA \\\\  & ={∬}_{D}2yz\\sqrt{3}\\,dA\\end{aligned}\n$$\n\nWe must now evaluate the double integral above over the region $D$ in the $yz$-plane shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/63a8768b2769fad339ba7667357812d2dda0ea856e846ad666a100f8bc1336e9.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}2yz\\sqrt{3}\\,dA & ={\\int }_{0}^{2}{\\int }_{0}^{y}2yz\\sqrt{3}\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}y\\sqrt{3}[{\\int }_{0}^{y}2z\\,dz]dy \\\\  & ={\\int }_{0}^{2}y\\sqrt{3}[{z}^{2}]_{z=0}^{z=y}dy \\\\  & ={\\int }_{0}^{2}y\\sqrt{3}({y}^{2}-0)\\,dy \\\\  & =\\sqrt{3}{\\int }_{0}^{2}{y}^{3}\\,dy \\\\  & =\\sqrt{3}{[\\frac{{y}^{4}}{4}]}_{y=0}^{y=2} \\\\  & =\\sqrt{3}(\\frac{16}{4}-0) \\\\  & =4\\sqrt{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-161581/selection/5521c093c4d60c23d630a99bc791ac7318f4615e164361df756510ffc0408a97" :answer/id #uuid "ff8365eb-0de9-505e-a99e-5929f21f44cf" :answer/type :answer.type/math :answer/value "\\frac{14}{3}" :db/ensure [:answer/validate]} {:db/id "q-161581/selection/7b54b999c57fada1b743f169198a4c20380454a1faea851f19209b74515a0504" :answer/id #uuid "6fa5a7d7-33f6-5f78-b0ab-11f41d5afd8f" :answer/type :answer.type/math :answer/value "\\frac{19}{2}" :db/ensure [:answer/validate]} {:db/id "q-161581/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3dedf070-9163-5bfd-8414-8c71f4114c84" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-161581/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "58c7ff58-467d-5623-8910-3ba05fda5413" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-161581/selection/682ceb87e528d663d8eea8e84482433fbb30e3cbe8ffdf3d44582c1c84f9e422" :answer/id #uuid "8334554d-e6c0-5719-a407-6eb5431ecb41" :answer/type :answer.type/math :answer/value "\\frac{23}{6}" :db/ensure [:answer/validate]} {:db/id "q-161581/selection" :answer-field/id #uuid "c4a19db3-df16-55a0-ac05-56ac3de3c554" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161581/selection/5521c093c4d60c23d630a99bc791ac7318f4615e164361df756510ffc0408a97" :answer-field/choices ["q-161581/selection/5521c093c4d60c23d630a99bc791ac7318f4615e164361df756510ffc0408a97" "q-161581/selection/7b54b999c57fada1b743f169198a4c20380454a1faea851f19209b74515a0504" "q-161581/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-161581/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-161581/selection/682ceb87e528d663d8eea8e84482433fbb30e3cbe8ffdf3d44582c1c84f9e422"] :db/ensure [:answer-field/validate]} {:db/id "q-161581" :question/id #uuid "42f45f71-27d5-5a4a-be80-b08c3b688e33" :question/math-academy-id "q-161581" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}y\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,0\\le x\\le y+z+2},\n$$\n\nand $D$ is a finite region in $yz$-plane enclosed between the $y$-axis, the $z$-axis and the line $z=2-y$ in the first quadrant." :question/worked-solution "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}y\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{y+z+2}y\\,dx]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{y+z+2}y\\,dx]dA & ={∬}_{D}y[x]_{x=0}^{x=y+z+2}\\,dA \\\\  & ={∬}_{D}y(y+z+2)\\,dA \\\\  & ={∬}_{D}{y}^{2}+yz+2y\\,dA\\end{aligned}\n$$\n\nWe must now evaluate the double integral above over the region $D$ in the $yz$-plane shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/b473cc75dbbd6fa36ba43f6bbdec4a0133164e6fd8bc5f76ff86cec74714a256.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}+yz+2y\\,dA & ={\\int }_{0}^{2}{\\int }_{0}^{2-y}{y}^{2}+yz+2y\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{0}^{2-y}{y}^{2}+yz+2y\\,dz]dy \\\\  & ={\\int }_{0}^{2}{[({y}^{2}+2y)z+\\frac{1}{2}y{z}^{2}]}_{z=0}^{z=2-y}dy \\\\  & ={\\int }_{0}^{2}({y}^{2}+2y)(2-y)+\\frac{1}{2}y(2-y)^{2}\\,dy \\\\  & ={\\int }_{0}^{2}(4y-{y}^{3})+\\frac{1}{2}y(4-4y+{y}^{2})\\,dy \\\\  & ={\\int }_{0}^{2}-\\frac{1}{2}{y}^{3}-2{y}^{2}+6y\\,dy \\\\  & ={[-\\frac{1}{8}{y}^{4}-\\frac{2}{3}{y}^{3}+3{y}^{2}]}_{y=0}^{y=2} \\\\  & =-2-\\frac{16}{3}+12 \\\\  & =\\frac{14}{3}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161581/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90adf237-9627-55f1-8f90-8fbc4acf02fc"] :knowledge-point/questions ["q-161581"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161583/selection/734d74928a78be6974b19009b44f8d068dacfbb2cada7180aee9e63a87b6007c" :answer/id #uuid "4e843926-8cd5-5599-9b8b-9ad831c075b5" :answer/type :answer.type/math :answer/value "\\frac{1}{27}" :db/ensure [:answer/validate]} {:db/id "q-161583/selection/be80c4b10c2262e7165b2c3683cd66c82685822ebb5d747b205d67fb1d4622e1" :answer/id #uuid "1b97ccb1-aa79-5691-9343-9914ab8a8e51" :answer/type :answer.type/math :answer/value "\\frac{5}{18}" :db/ensure [:answer/validate]} {:db/id "q-161583/selection/9c6bfb4db8d042ca3b93589c844ac1c789909e0099f428d8083546a00b4d8cf7" :answer/id #uuid "b9cdf12f-b650-56de-b7f7-5d76c8840ef6" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "q-161583/selection/330eb0b589da5e117b65434433fc9b27dd194d66ebc1ac2885f9407ae4c4b046" :answer/id #uuid "84f03db3-b90c-5c71-a84b-d3de3a197ccd" :answer/type :answer.type/math :answer/value "\\frac{11}{12}" :db/ensure [:answer/validate]} {:db/id "q-161583/selection/f2288f9352f7ca2a51938247a89477aea196296ae7b20690ce35ebb30dfe5331" :answer/id #uuid "9d71eca6-3e03-5d88-a34c-f94eeaa9a608" :answer/type :answer.type/math :answer/value "\\frac{1}{16}" :db/ensure [:answer/validate]} {:db/id "q-161583/selection" :answer-field/id #uuid "be55cf0f-6150-574d-9a8d-38e9c2d7d650" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161583/selection/734d74928a78be6974b19009b44f8d068dacfbb2cada7180aee9e63a87b6007c" :answer-field/choices ["q-161583/selection/734d74928a78be6974b19009b44f8d068dacfbb2cada7180aee9e63a87b6007c" "q-161583/selection/be80c4b10c2262e7165b2c3683cd66c82685822ebb5d747b205d67fb1d4622e1" "q-161583/selection/9c6bfb4db8d042ca3b93589c844ac1c789909e0099f428d8083546a00b4d8cf7" "q-161583/selection/330eb0b589da5e117b65434433fc9b27dd194d66ebc1ac2885f9407ae4c4b046" "q-161583/selection/f2288f9352f7ca2a51938247a89477aea196296ae7b20690ce35ebb30dfe5331"] :db/ensure [:answer-field/validate]} {:db/id "q-161583" :question/id #uuid "38ba2e71-6d19-5a55-bf3c-392d867b639c" :question/math-academy-id "q-161583" :question/problem "Evaluate the triple integral \n\n$$\n{∭}_{R}2x\\,dV\n$$\n\nwhere the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,0\\le x\\le yz},\n$$\n\nand $D$ is a finite region in $yz$-plane enclosed between the $y$-axis, the line $y=1$ and the parabola $z={y}^{2}$ in the first quadrant." :question/worked-solution "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n{∭}_{R}2x\\,\\text{d}V={∬}_{D}[{\\int }_{0}^{yz}2x\\,dx]dA.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{yz}2x\\,dx]dA & ={∬}_{D}[{x}^{2}]_{x=0}^{x=yz}\\,dA \\\\  & ={∬}_{D}(yz)^{2}\\,dA \\\\  & ={∬}_{D}{y}^{2}{z}^{2}\\,dA\\end{aligned}\n$$\n\nWe must now evaluate the double integral above over the region $D$ in the $yz$-plane shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/acb173db9d28ed8b38e63c7bc365c20e5755aeb1af3f6340e7b9229a4b49101d.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}{z}^{2}\\,dA & ={\\int }_{0}^{1}{\\int }_{0}^{{y}^{2}}{y}^{2}{z}^{2}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}[{\\int }_{0}^{{y}^{2}}{y}^{2}{z}^{2}\\,dz]dy \\\\  & ={\\int }_{0}^{1}{[\\frac{1}{3}{y}^{2}{z}^{3}]}_{z=0}^{z={y}^{2}}dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{3}{y}^{2}({y}^{6}-0)\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{1}{3}{y}^{8}\\,dy \\\\  & =\\frac{1}{3}{[\\frac{1}{9}{y}^{9}]}_{y=0}^{y=1} \\\\  & =\\frac{1}{3}(\\frac{1}{9}-0) \\\\  & =\\frac{1}{27}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161583/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "90adf237-9627-55f1-8f90-8fbc4acf02fc"] :knowledge-point/questions ["q-161583"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161784/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "9dc96c16-507f-5e39-9e06-cbdeb1d8766d" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-161784/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "b00137a0-9917-53ee-8915-833087c8b564" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-161784/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "fb031b68-4086-5c4a-88f0-100aa7a5ef3c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-161784/selection/e3b46c3e63ee8ef5a071cd8ef5f7250114c0c6983477af061861d82a06039d46" :answer/id #uuid "0830b5d7-d144-5d72-a3e9-b81f570e22c8" :answer/type :answer.type/math :answer/value "\\frac{1}{9}" :db/ensure [:answer/validate]} {:db/id "q-161784/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "c080851d-f994-5c21-b4d4-953fda191d86" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-161784/selection" :answer-field/id #uuid "c8270bc6-063c-537c-bfa3-2431ffe6f033" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161784/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-161784/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" "q-161784/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-161784/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-161784/selection/e3b46c3e63ee8ef5a071cd8ef5f7250114c0c6983477af061861d82a06039d46" "q-161784/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-161784" :question/id #uuid "d31e4325-59b1-526f-a289-64b327737018" :question/math-academy-id "q-161784" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/ca49b92d602d04a73dc7ab9936d601654bd293ce3fb7950372ac86155875aca3.png)\n\nEvaluate the triple integral \n${∭}_{R}\\frac{1}{6-y+3z}\\,dV$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/0008ba406cfe8a5b61d683a6854260897cb441752a5333add281ab1279e31b0b.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2-\\frac{y}{3}+z},\n$$\n\nwhere\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 3}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/bbe6b6b897e5d53421080ae8e8b9dc49f2ea1b7e135f8426ee3f11af01cc2401.png)\n\nHence, we can express the region $R$ as\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 3,\\,\\,0\\le 2-\\frac{y}{3}+z}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}\\frac{1}{6-y+3z}\\,\\text{d}V={\\int }_{0}^{3}{\\int }_{0}^{3}{\\int }_{0}^{2-y/3+z}\\frac{1}{6-y+3z}\\,dx\\,dz\\,dy.\n$$\n\nFirst, we evaluate the inner integral with respect to $x$, treating $y$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{\\int }_{0}^{3}{\\int }_{0}^{2-y/3+z}\\frac{1}{6-y+3z}\\,dx\\,dz\\,dy & ={\\int }_{0}^{3}{\\int }_{0}^{3}[{\\int }_{0}^{2-y/3+z}\\frac{1}{6-y+3z}\\,dx]dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{3}\\frac{1}{6-y+3z}[x]_{x=0}^{x=2-y/3+z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{3}\\frac{1}{6-y+3z}(2-\\frac{y}{3}+z)\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{3}\\frac{1}{3}\\,dz\\,dy\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{\\int }_{0}^{3}\\frac{1}{3}\\,dz\\,dy & ={\\int }_{0}^{3}[{\\int }_{0}^{3}\\frac{1}{3}\\,dz]dy \\\\  & ={\\int }_{0}^{3}\\frac{1}{3}{[z]}_{z=0}^{z=3}\\,dy \\\\  & ={\\int }_{0}^{3}\\frac{1}{3}(3)\\,dy \\\\  & ={\\int }_{0}^{3}\\,dy\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}\\,dy & =[y]_{y=0}^{y=3} \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161784/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e612d4ba-b772-5f56-a031-fdfc05d63221"] :knowledge-point/questions ["q-161784"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161783/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "81f5c9aa-ae0a-53ad-af70-47d8421072c6" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-161783/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "242096ed-d41a-5d6d-98e1-028871bfa249" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-161783/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d26d4c23-36ab-5376-82dd-b1fed6968883" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-161783/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "83ff5443-55a6-5aac-82c7-b81c2cfd2eca" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-161783/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "f9f7c3d4-0e9c-5b1a-b1d5-dd75f724d77a" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-161783/selection" :answer-field/id #uuid "cd620578-dd05-5846-bced-85b22a8b4888" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161783/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-161783/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-161783/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-161783/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-161783/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-161783/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-161783" :question/id #uuid "61ab6bf1-137b-57a1-bf89-390949bf96b6" :question/math-academy-id "q-161783" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/3fe3ec24f8f8006f22bde8ba2dc39fd3cd3f73668b06f8ea4a74e4ed5206a193.png)\n\nEvaluate the triple integral \n${∭}_{R}\\frac{1}{10-2y-z}\\,dV$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/2a20f2651c24e48871028b44fe61da4600d632481877ef32ccdfd3241262a53b.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 5-y-\\frac{z}{2}},\n$$\n\nwhere\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 4}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/1ba7c02f254313a73a813e4e43c44c25523ce77dd47e594a1db3b412a6bd5c3d.png)\n\nHence, we can express the region $R$ as\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 3,\\,\\,0\\le z\\le 4,\\,\\,0\\le x\\le 5-y-\\frac{z}{2}}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}\\frac{1}{10-2y-z}\\,\\text{d}V={\\int }_{0}^{3}{\\int }_{0}^{4}{\\int }_{0}^{5-y-z/2}\\frac{1}{10-2y-z}\\,dx\\,dz\\,dy.\n$$\n\nFirst, we evaluate the inner integral with respect to $x$, treating $y$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{\\int }_{0}^{4}{\\int }_{0}^{5-y-z/2}\\frac{1}{10-2y-z}\\,dx\\,dz\\,dy & ={\\int }_{0}^{3}{\\int }_{0}^{4}[{\\int }_{0}^{5-y-z/2}\\frac{1}{10-2y-z}\\,dx]dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{4}\\frac{1}{10-2y-z}[x]_{x=0}^{x=5-y-z/2}\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{4}\\frac{1}{10-2y-z}(5-y-\\frac{z}{2})\\,dz\\,dy \\\\  & ={\\int }_{0}^{3}{\\int }_{0}^{4}\\frac{1}{2}\\,dz\\,dy\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{\\int }_{0}^{4}\\frac{1}{2}\\,dz\\,dy & ={\\int }_{0}^{3}[{\\int }_{0}^{4}\\frac{1}{2}\\,dz]dy \\\\  & ={\\int }_{0}^{3}{[\\frac{z}{2}]}_{z=0}^{z=4}\\,dy \\\\  & ={\\int }_{0}^{3}2\\,dy\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}2\\,dy & =[2y]_{y=0}^{y=3} \\\\  & =6-0 \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161783/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e612d4ba-b772-5f56-a031-fdfc05d63221"] :knowledge-point/questions ["q-161783"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161589/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "9b823093-1d5d-5b2c-81ca-cd77e7019fba" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-161589/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" :answer/id #uuid "fc8d7283-92d8-5679-a77a-192d04ac0f4a" :answer/type :answer.type/math :answer/value "\\frac{1}{6}" :db/ensure [:answer/validate]} {:db/id "q-161589/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "566221f6-05f9-5a62-ad5d-a14b8f6663c2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-161589/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "4af2d5c0-c18a-5b00-bca0-f4d7f21685c5" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-161589/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833" :answer/id #uuid "23da081d-2cec-5f18-9eae-59476b85ed61" :answer/type :answer.type/math :answer/value "\\frac{1}{3}" :db/ensure [:answer/validate]} {:db/id "q-161589/selection" :answer-field/id #uuid "ebd964e0-ee68-5278-b55d-92ee733d2366" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161589/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer-field/choices ["q-161589/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-161589/selection/9e11fa4df3725c69efaf2fb0a82d90e47a4519d002f721e23606c3d6290fb02c" "q-161589/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-161589/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-161589/selection/d027d90726f5bdbf1525aade1b6bde5c85e2082f2b792dfacee399fcc90e9833"] :db/ensure [:answer-field/validate]} {:db/id "q-161589" :question/id #uuid "d80c8b49-f108-517b-a5d1-42a714175231" :question/math-academy-id "q-161589" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/d5690bff5819d72cc9d49016c119dc79f62f4d766c142a43a89df196ce9f2335.png)\n\nEvaluate the triple integral \n${∭}_{R}{y}^{2}\\,dV$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/2427e053c0e2d808b32db5d7fedf81365e7e50f0b3f2dc61598ad1795394686e.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 2+2y-z},\n$$\n\nwhere\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/145f0d494ffe24de84e3a289b3a7316d3f4933f193d734aed118609f7fb9f94f.png)\n\nHence, we can express the region $R$ as\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 1,\\,\\,0\\le z\\le 1,\\,\\,0\\le x\\le 2+2y-z}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}{y}^{2}\\,\\text{d}V={\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2+2y-z}{y}^{2}\\,dx\\,dz\\,dy.\n$$\n\nFirst, we evaluate the inner integral with respect to $x$, treating $y$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{2+2y-z}{y}^{2}\\,dx\\,dz\\,dy & ={\\int }_{0}^{1}{\\int }_{0}^{1}[{\\int }_{0}^{2+2y-z}{y}^{2}\\,dx]dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{y}^{2}[x]_{x=0}^{x=2+2y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}{y}^{2}(2+2y-z)\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}2{y}^{2}+2{y}^{3}-{y}^{2}z\\,dz\\,dy\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1}2{y}^{2}+2{y}^{3}-{y}^{2}z\\,dz\\,dy & ={\\int }_{0}^{1}[{\\int }_{0}^{1}2{y}^{2}+2{y}^{3}-{y}^{2}z\\,dz]dy \\\\  & ={\\int }_{0}^{1}{[2{y}^{2}z+2{y}^{3}z-\\frac{1}{2}{y}^{2}{z}^{2}]}_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{1}2{y}^{2}+2{y}^{3}-\\frac{1}{2}{y}^{2}\\,dy \\\\  & ={\\int }_{0}^{1}\\frac{3}{2}{y}^{2}+2{y}^{3}\\,dy\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}\\frac{3}{2}{y}^{2}+2{y}^{3}\\,dy & ={[\\frac{1}{2}{y}^{3}+\\frac{1}{2}{y}^{4}]}_{y=0}^{y=1} \\\\  & =(\\frac{1}{2}+\\frac{1}{2})-0 \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161589/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e612d4ba-b772-5f56-a031-fdfc05d63221"] :knowledge-point/questions ["q-161589"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40219"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/bc1b0ea463b0f753a2c65784fa5d46203cde8f457116c481301bf3f20ce82f54.png)\n\nEvaluate the triple integral \n${∭}_{R}4y\\,dV$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/9bb9311cbaf796f76c4b8b7cb7ed81abec48abc445b894f838f940fbd92e534b.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,\\,0\\le x\\le 4-y-z},\n$$\n\nwhere\n\n$$\nD={(y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 1}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/82f237dc5fb7d8b8ed34b7a1c16527ab338923a33462f0bd7dafbe54bc5e5158.png)\n\nHence, we can express the region $R$ as\n\n$$\nR={(x,y,z)\\,:\\,0\\le y\\le 2,\\,\\,0\\le z\\le 1,\\,\\,0\\le x\\le 4-y-z}.\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}4y\\,\\text{d}V={\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{4-y-z}4y\\,dx\\,dz\\,dy.\n$$\n\nFirst, we evaluate the inner integral with respect to $x$, treating $y$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{1}{\\int }_{0}^{4-y-z}4y\\,dx\\,dz\\,dy & ={\\int }_{0}^{2}{\\int }_{0}^{1}[{\\int }_{0}^{4-y-z}4y\\,dx]dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}4y[x]_{x=0}^{x=4-y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}4y(4-y-z)\\,dz\\,dy \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{1}(16y-4{y}^{2}-4yz)\\,dz\\,dy\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{1}(16y-4{y}^{2}-4yz)\\,dz\\,dy & ={\\int }_{0}^{2}[{\\int }_{0}^{1}(16y-4{y}^{2}-4yz)\\,dz]dy \\\\  & ={\\int }_{0}^{2}[16yz-4{y}^{2}z-2y{z}^{2}]_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{2}(14y-4{y}^{2})\\,dy\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}(14y-4{y}^{2})\\,dy & ={[7{y}^{2}-\\frac{4}{3}{y}^{3}]}_{y=0}^{y=2} \\\\  & =(28-\\frac{32}{3})-0 \\\\  & =\\frac{52}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-161594/selection/8b1256562dec408e48466db804493f154ae3c573b8f670aafeeca47c87a473f4" :answer/id #uuid "15c5bfac-7a70-5074-b840-4cbd1d14a9d5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{1-(y-1)^{2}}}3\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-161594/selection/f58f5cb6ef5c58772c5e480e1727b2c590545dbd60177e5a28017bbdc422195f" :answer/id #uuid "d79a42bd-4ffe-5589-9366-db84c051c4e6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{\\sqrt{1-(y-1)^{2}}}3z\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-161594/selection/9635ef00964bb12cc872f6a517a0e86db3226ae983f3ea46c5fd776638cbd483" :answer/id #uuid "137455a8-e5cd-540f-9859-24f40273b3fc" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt{1-(y-1)^{2}}}{\\int }_{0}^{2}3y\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-161594/selection/8668604dd6b238e6571cf1397b2dc61cb7eae081cef521f88f29cac6c575e1d0" :answer/id #uuid "15b050f1-9e57-5b74-80e1-ff2e2422124e" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{1}3\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-161594/selection/6b12520fcdc1367bc0c8049126d6f9ff33f7f06dd006e748f32d4579fe82fdc4" :answer/id #uuid "a2f1afdc-c843-5ee1-bb6c-447b29d9f822" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{0}^{2}3yz\\,\\text{d}z\\,\\text{d}y" :db/ensure [:answer/validate]} {:db/id "q-161594/selection" :answer-field/id #uuid "2c8e251d-48b1-5631-af6f-1b4cd3f362c4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161594/selection/8b1256562dec408e48466db804493f154ae3c573b8f670aafeeca47c87a473f4" :answer-field/choices ["q-161594/selection/8b1256562dec408e48466db804493f154ae3c573b8f670aafeeca47c87a473f4" "q-161594/selection/f58f5cb6ef5c58772c5e480e1727b2c590545dbd60177e5a28017bbdc422195f" "q-161594/selection/9635ef00964bb12cc872f6a517a0e86db3226ae983f3ea46c5fd776638cbd483" "q-161594/selection/8668604dd6b238e6571cf1397b2dc61cb7eae081cef521f88f29cac6c575e1d0" "q-161594/selection/6b12520fcdc1367bc0c8049126d6f9ff33f7f06dd006e748f32d4579fe82fdc4"] :db/ensure [:answer-field/validate]} {:db/id "q-161594" :question/id #uuid "9f7a494d-dd58-51ac-963c-d9b00a8df0cd" :question/math-academy-id "q-161594" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/f1f3493cd1ff0bee115bf7c311504a2b8a9bbd38dd35adae96c9f7abcae40ae1.png)\n\nGiven that $R$ is the type II region shown above, \n${∭}_{R}2x\\,\\text{d}V=$" :question/worked-solution "For a type II region $R$ with projection $D$ onto the $yz$-plane, the triple integral of a continuous function $f(x,y,z)$ over $R$ is given by\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={∬}_{D}[{\\int }_{{u}_{1}(y,z)}^{{u}_{2}(y,z)}f(x,y,z)\\,\\text{d}x]\\text{d}A.\n$$\n\nWe consider the region $R$ as a type II region enclosed between the back surface $x={u}_{1}(y,z)=1$ and the front surface $x={u}_{2}(y,z)=2.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/6cc327f63d7141c43852e868812a7cff1ec9ae0acfed636ff896ceb204b6fbf0.png)\n\nSo, the region $R$ is given by\n\n$$\nR={(x,y,z)\\,:\\,(y,z)\\in D,\\,1\\le x\\le 2}.\n$$\n\nNow, we consider the projection $D$ as a type I *plane* region in the $yz$-plane with the upper curve\n\n$$\n(y-1)^{2}+{z}^{2}=1\\,⟺\\,z=\\sqrt{1-(y-1)^{2}}.\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/a0fb19d32c2545e5c2a61cbb54536e7c28b1a54dbce51c7752c3687035d6c3d6.png)\n\nHence, $D={(y,z)\\,:\\,0\\le y\\le 2,\\,0\\le z\\le \\sqrt{1-(y-1)^{2}}}.$\n\nTherefore, we write the triple integral as follows:\n\n$$\n\\begin{aligned}{∭}_{R}2x\\,\\text{d}V & ={∬}_{D}[{\\int }_{1}^{2}2x\\,\\text{d}x]\\text{d}A \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{1-(y-1)^{2}}}[{\\int }_{1}^{2}2x\\,\\text{d}x]\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{1-(y-1)^{2}}}[{x}^{2}]_{x=1}^{x=2}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{2}{\\int }_{0}^{\\sqrt{1-(y-1)^{2}}}3\\,\\text{d}z\\,\\text{d}y\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-161594/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e612d4ba-b772-5f56-a031-fdfc05d63221"] :knowledge-point/questions ["q-161594"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-12398"] :question/problem "Find the missing limits in the repeated integral below\n\n$$\n\\displaystyle \\iiint \\limits_{R} f(x,y,z) \\: \\textrm{d}V\n= \n\\int_{\\ast}^{\\ast} \n\\int_{\\ast}^{\\ast} \n\\int_{\\ast}^{\\ast} \nf(x,y,z) \\: \\mathrm{d}x \\: \\mathrm{d}z \\: \\mathrm{d}y\n$$\n\nwhere $R$ is the type II region defined as\n\n$$\nR=\\left\\{ (x,y,z) \\: : \\: 1 \\leq y \\leq 4, \\: -y^2 \\leq z \\leq \\sqrt{y}, \\: -2 \\leq x \\leq ye^{z+2} \\right\\}.\n$$" :question/worked-solution "A type II region in three-dimensional space can be written as\n\n$$\nR = \\big\\{ (x,y,z)  \\: : \\: (y,z) \\in D, \\: u_1(y,z) \\leq x \\leq u_2(y,z) \\big\\}.\n$$\n\nA typical three-dimensional type II region can be visualized schematically, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/1b49704bf6d5837a18d8b5dbb8b420d430d5e3881507540fb62a45cf1f6ce52f.png)\n\n \n\nIf $R$ is a type II region, we can express the triple integral of $f(x,y,z)$ over $R$ as a mixed integral, as follows:\n\n$$\n\\iiint\\limits_{R} f(x,y,z)\\,\\textrm d V = \\iint\\limits_{D} \\left[\\int_{u_1(y,z)}^{u_2(y,z)} f(x,y,z)\\,\\textrm{d}x \\right]\\,\\textrm d A\n$$\n\nIn our case, we have\n\n$$\nu_1(y,z) = -2, \\qquad u_2(y,z)  = ye^{z+2}.\n$$\n\nTherefore, our triple integral can be written as\n\n$$\n\\displaystyle \\iiint \\limits_{R} f(x,y,z) \\: \\textrm{d}V \n= \n\\iint\\limits_{D} \\left[ \\int_{-2}^{ye^{z+2}} f(x,y,z) \\: \\mathrm{d}x \\right] \\mathrm{d}A.\n$$\n\nNow, the region $D$ is given by\n\n$$\nD =\\left\\{ (x,y) \\: : \\: 1 \\leq y \\leq 4, \\: -y^2 \\leq z \\leq \\sqrt{y} \\right\\}.\n$$\n\nTherefore, by expressing the double integral over $D$ as a repeated integral, we get\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{-2}^{y{e}^{z+2}}f(x,y,z)\\,dx]dA & ={\\int }_{1}^{4}{\\int }_{-{y}^{2}}^{\\sqrt{y}}[{\\int }_{-2}^{y{e}^{z+2}}f(x,y,z)\\,dx]dz\\,\\text{d}y \\\\  & ={\\int }_{1}^{4}{\\int }_{-{y}^{2}}^{\\sqrt{y}}{\\int }_{-2}^{y{e}^{z+2}}f(x,y,z)\\,dx\\,dz\\,dy.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-11349"] :question/problem "Evaluate the mixed integral\n\n$$\n\\displaystyle \\iint\\limits_D \\left[ \\int_{0}^{z} \\dfrac{\\cos (2y)}{1-y} \\,\\textrm{d}x \\right] \\textrm{d}A\n$$\n\nwhere the region $D$ in the $yz$-plane is given by\n\n$$\nD = \\left\\{ (y,z) \\, : \\, 0 \\leq y \\leq \\dfrac{\\pi}{6}, \\: 0 \\leq z \\leq 2\\sqrt{1-y} \\right\\}.\n$$" :question/worked-solution "First, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{z}\\frac{\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}x]\\,\\text{d}A & ={∬}_{D}\\frac{\\operatorname{cos}⁡(2y)}{1-y}[x]_{x=0}^{x=z}\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{\\operatorname{cos}⁡(2y)}{1-y}(z-0)\\,\\text{d}A \\\\  & ={∬}_{D}\\frac{z\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}A\\end{aligned}\n$$\n\nNext, we evaluate the double integral:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{z\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}A & ={\\int }_{0}^{\\pi /6}{\\int }_{0}^{2\\sqrt{1-y}}\\frac{z\\operatorname{cos}⁡(2y)}{1-y}\\,\\text{d}z\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{cos}⁡(2y)}{1-y}{[\\frac{{z}^{2}}{2}]}_{z=0}^{z=2\\sqrt{1-y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /6}\\frac{\\operatorname{cos}⁡(2y)}{1-y}(\\frac{4(1-y)}{2}-0)\\,\\text{d}y \\\\  & ={\\int }_{0}^{\\pi /6}2\\operatorname{cos}⁡(2y)\\,\\text{d}y \\\\  & =[\\operatorname{sin}⁡(2y)]_{y=0}^{y=\\pi /6} \\\\  & =\\operatorname{sin}⁡(\\frac{\\pi }{3})-\\operatorname{sin}⁡(0) \\\\  & =\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-11348"] :question/problem "Evaluate the triple integral \n\n$$\n\\displaystyle \\iiint\\limits_R 4x^3  \\: \\mathrm{d}V\n$$\n\nwhere the region $R$ is given by\n\n$$\nR = \\left\\{ (x,y,z) \\: : \\: (y,z) \\in D, \\: 0 \\leq x \\leq \\sqrt{y} \\right\\},\n$$\n\nand $D$ is a finite region in $yz$-plane enclosed between the $y$-axis, the $z$-axis, and the line $z = 4-y$ in the first quadrant." :question/worked-solution "Writing down our triple integral as a mixed integral, we obtain\n\n$$\n\\displaystyle \\iiint \\limits_{R} 4x^3 \\, \\textrm{d}V\n= \n\\iint\\limits_{D} \\left[ \\int_{0}^{\\sqrt{y}} 4x^3 \\, \\mathrm{d}x \\right] \\mathrm{d}A.\n$$\n\nFirst, we evaluate the inner integral with respect to $x,$ treating $y$ and $z$ as constants:\n\n$$\n\\begin{aligned}{∬}_{D}[{\\int }_{0}^{\\sqrt{y}}4{x}^{3}\\,dx]dA & ={∬}_{D}[{x}^{4}]_{x=0}^{x=\\sqrt{y}}\\,dA \\\\  & ={∬}_{D}{(\\sqrt{y})}^{4}\\,dA \\\\  & ={∬}_{D}{y}^{2}\\,dA\\end{aligned}\n$$\n\nWe must now evaluate this double integral over the region $D$ in the $yz$-plane shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/3c8712fa0a30ad94f503efe5e080ee89f83eb21f19fba45033bbedeab08ac816.png)\n\nWe can evaluate our double integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}{y}^{2}\\,dA & ={\\int }_{0}^{4}{\\int }_{0}^{4-y}{y}^{2}\\,dz\\,dy \\\\  & ={\\int }_{0}^{4}[{\\int }_{0}^{4-y}{y}^{2}\\,dz]dy \\\\  & ={\\int }_{0}^{4}[{y}^{2}z]_{z=0}^{z=4-y}dy \\\\  & ={\\int }_{0}^{4}{y}^{2}(4-y)\\,dy \\\\  & ={\\int }_{0}^{4}4{y}^{2}-{y}^{3}\\,dy \\\\  & ={[\\frac{4}{3}{y}^{3}-\\frac{1}{4}{y}^{4}]}_{y=0}^{y=4} \\\\  & =\\frac{4}{3}(64-0)-\\frac{1}{4}(256-0) \\\\  & =\\frac{64}{3}\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-12369"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/fc19dd4415663ab027e0fc386d4c5bc81a28c1bc26d5f6cf2083f4f4228a4dea.png)\n\n \n\nEvaluate the triple integral \n$\\displaystyle \\iiint\\limits_R 12z^2 \\: \\mathrm{d}V$\nover the region $R,$ shown above.\n\n*Hint: All surfaces, except for the front one, are parallel to the corresponding coordinate planes.*" :question/worked-solution "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/f25c393f10c35ffd9b4fa91cdf672a516cf6cff974a8aa563d350619a64b79bd.png)\n\n \n\nNotice that our solid can be written as the type II region\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\: (y,z) \\in D, \\:\\: 0 \\leq x \\leq 3-y-z \\big\\},\n$$\n\nwhere\n\n$$\nD = \\big\\{ (y,z) \\: : \\: 0 \\leq y \\leq 1, \\:\\: 0 \\leq z \\leq 1 \\big\\}\n$$\n\nis the projection of $R$ onto the $yz$-plane, shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14063435/assets/145f0d494ffe24de84e3a289b3a7316d3f4933f193d734aed118609f7fb9f94f.png)\n\nHence, we can express the region $R$ as\n\n$$\nR = \\big\\{ (x,y,z) \\: : \\: 0 \\leq y \\leq 1, \\:\\: 0 \\leq z \\leq 1, \\:\\: 0 \\leq x \\leq 3-y-z \\big\\}\n$$\n\nAs a result, by writing down our triple integral as a repeated integral, we obtain\n\n$$\n\\iiint \\limits_{R}  12z^2  \\: \\textrm{d}V \n= \n\\int_{0}^{1} \\int_{0}^{1} \\int_{0}^{3-y-z}  12z^2  \\: \\mathrm{d}x \\: \\mathrm{d}z \\: \\mathrm{d}y.\n$$\n\nFirst, we evaluate the inner integral with respect to $x$, treating $y$ and $z$ as constants: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1}{\\int }_{0}^{3-y-z}12{z}^{2}\\,dx\\,dz\\,dy & ={\\int }_{0}^{1}{\\int }_{0}^{1}[{\\int }_{0}^{3-y-z}12{z}^{2}\\,dx]dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}12{z}^{2}[x]_{x=0}^{x=3-y-z}\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}12{z}^{2}(3-y-z)\\,dz\\,dy \\\\  & ={\\int }_{0}^{1}{\\int }_{0}^{1}(36{z}^{2}-12y{z}^{2}-12{z}^{3})\\,dz\\,dy\\end{aligned}\n$$\n\nNext, we evaluate the inner integral with respect to $z$, treating $y$ as a constant: \n\n$$\n\\begin{aligned}{\\int }_{0}^{1}{\\int }_{0}^{1}(36{z}^{2}-12y{z}^{2}-12{z}^{3})\\,dz\\,dy & ={\\int }_{0}^{1}[{\\int }_{0}^{1}(36{z}^{2}-12y{z}^{2}-12{z}^{3})\\,dz]dy \\\\  & ={\\int }_{0}^{1}[12{z}^{3}-4y{z}^{3}-3{z}^{4}]_{z=0}^{z=1}\\,dy \\\\  & ={\\int }_{0}^{1}(12-4y-3)\\,dy \\\\  & ={\\int }_{0}^{1}(9-4y)\\,dy\\end{aligned}\n$$\n\nFinally, we integrate with respect to $y{:}$\n\n$$\n\\begin{aligned}{\\int }_{0}^{1}(9-4y)\\,dy & =[9y-2{y}^{2}]_{y=0}^{y=1} \\\\  & =(9-2)-0 \\\\  & =7\\end{aligned}\n$$" :db/ensure [:question/validate]}]
