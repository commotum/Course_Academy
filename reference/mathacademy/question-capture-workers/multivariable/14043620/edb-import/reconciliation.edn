apture-workers/multivariable/14043620/assets/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161839" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161838" "field" nil "attribute" "question/problem" "value" "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+v \\\\ {u}^{2}+{v}^{2}\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161838" "field" nil "attribute" "question/worked-solution" "value" "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}u+v \\\\ {u}^{2}+{v}^{2}\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}1 & 1 \\\\ 2u & 2v\\end{aligned}| \\\\  & =1\\cdot (2v)-(2u)\\cdot 1 \\\\  & =2v-2u.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}2v-2u & <0 \\\\ 2v & <2u \\\\ v & <u\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=u\n$$\n\ndefines a straight line, and the coordinates of, say, $(1,-1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161838" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/activity-metadata.json" "file_sha256" "d17f747f7a272c4fa07dae0292564f48112308f51a1fdd537a70bd5439817bee"} {"question" "q-161838" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161838" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/14015cadab7d5dc8a9c33d0c1a57a44a79506bd01ba9b1cfe8ec1d280eb3fbb6.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/7f214af0b5d71689ec7f21fff043e1779f1d3244c13fdbaf7b8df7f408d66298.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161838" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161837" "field" nil "attribute" "question/problem" "value" "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\frac{1}{3}{u}^{3}+v \\\\ uv\\end{aligned}],\n$$\n\nis (locally) orientation-reversing?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161837" "field" nil "attribute" "question/worked-solution" "value" "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}<0\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}\\frac{1}{3}{u}^{3}+v \\\\ uv\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{u}^{2} & 1 \\\\ v & u\\end{aligned}| \\\\  & ={u}^{2}\\cdot u-v\\cdot 1 \\\\  & ={u}^{3}-v.\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}{u}^{3}-v & <0 \\\\ v & >{u}^{3}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv={u}^{3}\n$$\n\ndefines a cubic function, and the coordinates of, say, $(-1,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161837" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/activity-metadata.json" "file_sha256" "d17f747f7a272c4fa07dae0292564f48112308f51a1fdd537a70bd5439817bee"} {"question" "q-161837" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161837" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/3033f0ae73e3f484fc5d3d65e388062feba1824fb3da9971d560cf2f518f49bb.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/b0171dfd42295e39cd45186e8edba3a5105fbd1bd02a1621223091de75815f61.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/d5889bd5e8d537757de25a7b1a868ff8a903da14c9088c5f8de5a70d8b078552.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161837" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/cb5b22ff46569b231d122c2ed11bd412907f36271a033d86769435adf9fe48c7.png"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161855" "field" nil "attribute" "question/problem" "value" "Which of the following shows the region in the $uv$-plane where the transformation $T,$ given by \n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{e}^{uv} \\\\ {u}^{2}+v\\end{aligned}],\n$$\n\nis (locally) orientation-preserving?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161855" "field" nil "attribute" "question/worked-solution" "value" "Recall that a transformation is (locally) orientation-preserving at the points where the Jacobian determinant is positive:\n\n$$\n\\frac{∂(x,y)}{∂(u,v)}>0.\n$$\n\nWe have\n\n$$\nT:[\\begin{aligned}u \\\\ v\\end{aligned}]⟶[\\begin{aligned}{e}^{uv} \\\\ {u}^{2}+v\\end{aligned}].\n$$\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}v{e}^{uv} & u{e}^{uv} \\\\ 2u & 1\\end{aligned}| \\\\  & =v{e}^{uv}\\cdot (1)-(2u)\\cdot u{e}^{uv} \\\\  & ={e}^{uv}(v-2{u}^{2}).\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}{e}^{uv}(v-2{u}^{2}) & >0 \\\\ v-2{u}^{2} & >0 \\\\ v & >2{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=2{u}^{2}\n$$\n\ndefines a parabola, and the coordinates of, say, $(0,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-preserving must be the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/613e83ce5ad6154905ec9001ece078309e396561e251e85455ff261bb4cd61a0.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161855" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/activity-metadata.json" "file_sha256" "d17f747f7a272c4fa07dae0292564f48112308f51a1fdd537a70bd5439817bee"} {"question" "q-161855" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161855" "field" "selection" "attribute" "answer-field/choices" "value" [["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/1368ee41963c1abcc320d2cd35449c08599582f37c7d68f750e137fcdcd2e57b.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/613e83ce5ad6154905ec9001ece078309e396561e251e85455ff261bb4cd61a0.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/7fc8ce1e1eaa3eb4e4acbbc167bdc4a479591bea21d2acdeaf799bd99d6b1150.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/9ecab1b0f048e83b57d04a60c1cf20ee5ed0e61257577cf42c1a091976c04473.png"] ["image" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/fe7bb422a3f992ea88a900e63b2c55df99bce3a785929901c248abadfadf23f1.png"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "q-161855" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/image "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/613e83ce5ad6154905ec9001ece078309e396561e251e85455ff261bb4cd61a0.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/state.json" "file_sha256" "fa93ed03b9daf087c8e462ead63eeeceacd33e8a13833b5756626e87d33ea74d"} {"question" "e-6810" "field" nil "attribute" "question/problem" "value" "Find the Jacobian determinant of the transformation $\\mathbf{T},$ defined as\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/ce4692599c5c9fe69ed9247d65dee5d982e1b7a2cf33b9070b799c94c321bad4.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-6810.json" "file_sha256" "3b6eb1941b1614e9bfd1649c28ff2d486c00f809926355fba64df0a930763baf"} {"question" "e-6810" "field" nil "attribute" "question/worked-solution" "value" "Given a transformation \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/59265be9c026880542032006b0c4aec9f1c8eeb2cd448423d38c17f75e1393cd.png)\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y)}{\\partial (u, v)} ,$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x=(u+v)^3$ and $y=(u-v)^2.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =3(u+v)^{2} & \\,\\frac{∂x}{∂v} & =3(u+v)^{2} \\\\ \\frac{∂y}{∂u} & =2(u-v) & \\,\\frac{∂y}{∂v} & =-2(u-v)\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}3(u+v)^{2} & 3(u+v)^{2} \\\\ 2(u-v) & -2(u-v)\\end{aligned}| \\\\  & =3(u+v)^{2}\\cdot (-2(u-v))-3(u+v)^{2}\\cdot 2(u-v) \\\\  & =-12(u+v)^{2}(u-v).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-6810.json" "file_sha256" "3b6eb1941b1614e9bfd1649c28ff2d486c00f809926355fba64df0a930763baf"} {"question" "e-11156" "field" nil "attribute" "question/problem" "value" "For the transformation $\\mathbf{T},$ defined as\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/eec66e1a6fdb16b157ec4ba8ea32b8e2328c26910594a7d21bb7346669797627.png)\n\ncompute the value of the Jacobian determinant at the point where ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/01df906c78b9ed5b4d6f1e29b4aeeb3be607b7570db357c4dce5949702432011.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-11156.json" "file_sha256" "c30827235b35141f8b5757d0c7ce545201148e66f9e45967ee0864ee2c86ae09"} {"question" "e-11156" "field" nil "attribute" "question/worked-solution" "value" "Given a transformation \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/62dec67282c5bc2707377cb976412a48ca3c41ffeed6aa74ef0d5b1ef8d6e380.png)\n\nthe Jacobian determinant of $\\mathbf T,$ denoted $\\dfrac{\\partial (x, y)}{\\partial (u, v)} ,$ is given by\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}|.\\end{aligned}\n$$\n\nHere, we have $x(u,v) = 2v\\cos{u}$ and $y(u,v) = v\\sin{u}.$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂x}{∂u} & =-2v\\operatorname{sin}⁡u & \\,\\frac{∂x}{∂v} & =2\\operatorname{cos}⁡u \\\\ \\frac{∂y}{∂u} & =v\\operatorname{cos}⁡u & \\,\\frac{∂y}{∂v} & =\\operatorname{sin}⁡u\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}-2v\\operatorname{sin}⁡u & 2\\operatorname{cos}⁡u \\\\ v\\operatorname{cos}⁡u & \\operatorname{sin}⁡u\\end{aligned}| \\\\  & =-2v\\operatorname{sin}⁡u\\cdot \\operatorname{sin}⁡u-2\\operatorname{cos}⁡u\\cdot v\\operatorname{cos}⁡u \\\\  & =-2v({sin}^{2}⁡u+{cos}^{2}⁡u) \\\\  & =-2v.\\end{aligned}\n$$\n\nFinally, when ![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/72902f1a278bc1316ff58c54940b4d5e65fa04aa8e1711c8e0a1726f57cd3641.png) the value of our Jacobian determinant is\n\n$$\n\\left.\\dfrac{\\partial (x, y)}{\\partial (u, v)}\\right|_{(0,-1)} = -2(-1) = 2.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-11156.json" "file_sha256" "c30827235b35141f8b5757d0c7ce545201148e66f9e45967ee0864ee2c86ae09"} {"question" "e-12417" "field" nil "attribute" "question/problem" "value" "Consider a small rectangle $\\Delta$ whose bottom-left corner is located at the point $(-1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta{A}.$ Find an approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf T,$ given by\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/4c41597b6c647ba16bff7b6675d1bbe9d3c66b8cbb8e9a13bbb6651da6cd284e.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-12417.json" "file_sha256" "6cbe17011a13de30730726aaed33e5c583b69e7ebd40e9b7eeb8315dbd54097a"} {"question" "e-12417" "field" nil "attribute" "question/worked-solution" "value" "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\textrm{Area}\\big(\\mathbf{T}(\\Delta)\\big) \\approx \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right| \\cdot \\underbrace{\\textrm{Area}(\\Delta)}_{\\large \\delta{A}}\n$$\n\n \n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{v}^{3} & 3u{v}^{2} \\\\ 2u & 2v\\end{aligned}| \\\\  & ={v}^{3}\\cdot 2v-3u{v}^{2}\\cdot 2u \\\\  & =2{v}^{4}-6{u}^{2}{v}^{2} \\\\ {\\frac{∂(x,y)}{∂(u,v)}|}_{(-1,2)} & =(2{v}^{4}-6{u}^{2}{v}^{2})\\,{|}_{u=-1\\,v=2} \\\\  & =2(2)^{4}-6(-1)^{2}(2)^{2} \\\\  & =32-24 \\\\  & =8\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\n\\begin{aligned}\\text{Area}(T(Δ)) & ≈|8|\\cdot \\delta A \\\\  & =8\\,\\delta A.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-12417.json" "file_sha256" "6cbe17011a13de30730726aaed33e5c583b69e7ebd40e9b7eeb8315dbd54097a"} {"question" "e-12418" "field" nil "attribute" "question/problem" "value" "Sketch the region in the $uv$-plane where the transformation $\\mathbf{T},$ given by \n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/0e620d5ca71a48c87a0d5942ffa8378964f6172bff7396c290024a5299531204.png)\nis (locally) orientation-reversing." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-12418.json" "file_sha256" "33f9f7f23bd83030a2da15042482a519b155c76c01698ad34eefa4b603d4dc3f"} {"question" "e-12418" "field" nil "attribute" "question/worked-solution" "value" "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)}  <    0\n$$\n\nWe have\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/e947cb962ec1c0405292be18c838205b7be95ab083e07925d797b87e9c5b8654.png)\n\nComputing the corresponding Jacobian determinant, we obtain \n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}{e}^{v} & u{e}^{v} \\\\ 2u & -2v\\end{aligned}| \\\\  & ={e}^{v}\\cdot (-2v)-u{e}^{v}\\cdot 2u \\\\  & =-2{e}^{v}({u}^{2}+v).\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{aligned}-2{e}^{v}({u}^{2}+v) & <0 \\\\ {u}^{2}+v & >0 \\\\ v & >-{u}^{2}\\end{aligned}\n$$\n\n \n\nNotice that the equation \n\n$$\nv=-u^2\n$$\n\ndefines a downward-opening parabola, and the coordinates of, say, $(1,1)$ satisfy the inequality. \n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/2b6128c5a1737e3ad1fd82f91f5ccd320421ad3472ae8152440034ecea10d364.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/example-12418.json" "file_sha256" "33f9f7f23bd83030a2da15042482a519b155c76c01698ad34eefa4b603d4dc3f"}] "usage" {"q-160341" [] "e-11156" [] "q-38078" [] "q-160394" [] "e-12417" [] "e-6810" [] "e-12418" []} "basis" 1630 "retractions" [[17592186129568 :question/problem "Find the Jacobian determinant of the transformation $T$, defined as\n\n$T: \\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}2u\\cos v \\\\ 3u\\sin v\\end{bmatrix}$."] [17592186129443 :question/problem "For the transformation $T$, defined as\n\n$T: \\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}e^{u + v} \\\\ e^{u - v}\\end{bmatrix}$.\n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix} = \\begin{bmatrix}0 \\\\ -5\\end{bmatrix}$."] [17592186129438 :question/problem "Which of the following shows the region in the $uv$-plane where the transformation $T$, given by\n$T: \\begin{bmatrix}u \\\\ v\\end{bmatrix}⟶\\begin{bmatrix}u^{2} - 2v^{2} \\\\ u - v\\end{bmatrix}$,\nis (locally) orientation-reversing?"] [17592186128941 :question/problem "Find the Jacobian determinant of the transformation $\\mathbf{T}$, defined as\n\n$\\begin{bmatrix}u \\\\ v\\end{bmatrix}$"] [17592186128941 :question/worked-solution "Given a transformation\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}\n$$\n\nthe Jacobian determinant of $\\mathbf T$, denoted\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)}\n$$\n\nis given by\n\n$$\n\\begin{aligned}\n(∂(x, y))/(∂(u, v)) &= \\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}\n\\end{aligned}\n$$\n\nHere, we have\n\n$$\nx=(u+v)^3\n$$\n\nand $y=(u-v)^2$.\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}\\frac{∂x}{∂u} &= 3(u + v)^{2} & \\frac{∂x}{∂v}|= 3(u + v)^{2} \\\\ \\frac{∂y}{∂u}|= 2(u - v) & \\frac{∂y}{∂v}|=-2(u - v)\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\n(∂(x, y))/(∂(u, v)) &= \\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\\n&=\\begin{vmatrix}3(u + v)^{2} & 3(u + v)^{2} \\\\ 2(u - v) & -2(u - v)\\end{vmatrix} \\\\\n&= 3(u + v)^{2} \\cdot (-2(u - v)) - 3(u + v)^{2} \\cdot 2(u - v) \\\\\n&=-12(u + v)^{2}(u - v)\n\\end{aligned}\n$$"] [17592186128773 :question/problem "For the transformation $\\mathbf{T}$, defined as\n\n$\\begin{bmatrix}u \\\\ v\\end{bmatrix}$\n\ncompute the value of the Jacobian determinant at the point where $\\begin{bmatrix}u \\\\ v\\end{bmatrix}$"] [17592186128773 :question/worked-solution "Given a transformation\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}\n$$\n\nthe Jacobian determinant of $\\mathbf T$, denoted\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)}\n$$\n\nis given by\n\n$$\n\\begin{aligned}\n(∂(x, y))/(∂(u, v)) &= \\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix}\n\\end{aligned}\n$$\n\nHere, we have\n\n$$\nx(u,v) = 2v\\cos{u}\n$$\n\nand\n\n$$\ny(u,v) = v\\sin{u}\n$$\n\nFirst, we find the partial derivatives:\n\n$$\n\\begin{aligned}\n\\begin{bmatrix}\\frac{∂x}{∂u} &= -2v\\sin u & \\frac{∂x}{∂v}|= 2\\cos u \\\\ \\frac{∂y}{∂u}|= v\\cos u & \\frac{∂y}{∂v}|= \\sin u\\end{bmatrix}\n\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\n(∂(x, y))/(∂(u, v)) &= \\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\\n&=\\begin{vmatrix}-2v\\sin u & 2\\cos u \\\\ v\\cos u & \\sin u\\end{vmatrix} \\\\\n&=-2v\\sin u \\cdot \\sin u - 2\\cos u \\cdot v\\cos u \\\\\n&=-2v(\\sin^{2} u + \\cos^{2} u) \\\\\n&=-2v\n\\end{aligned}\n$$\n\nFinally, when $\\begin{bmatrix}u \\\\ v\\end{bmatrix}$ the value of our Jacobian determinant is\n\n$$\n\\left.\\dfrac{\\partial (x, y)}{\\partial (u, v)}\\right|_{(0,-1)} = -2(-1) = 2\n$$"] [17592186128795 :question/problem "Consider a small rectangle $\\Delta$ whose bottom-left corner is located at the point $(-1,2)$ with sides parallel to the coordinate axes in the $uv$-plane and whose area is $\\delta{A}$. Find an approximation for the area of the image of this rectangle under the action of the transformation $\\mathbf T$, given by\n$\\begin{bmatrix}u \\\\ v\\end{bmatrix}$"] [17592186128795 :question/worked-solution "Recall that the absolute value of the Jacobian determinant gives the local area scale factor of the transformation at that point:\n\n$$\n\\textrm{Area}\\big(\\mathbf{T}(\\Delta)\\big) \\approx \\left| \\dfrac{\\partial (x, y)}{\\partial (u, v)} \\right| \\cdot \\underbrace{\\textrm{Area}(\\Delta)}_{\\large \\delta{A}}\n$$\n\nComputing the corresponding Jacobian determinant, we obtain the following:\n\n$$\n\\begin{aligned}\n(∂(x, y))/(∂(u, v)) &= \\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\\n&=\\begin{vmatrix}v^{3} & 3uv^{2} \\\\ 2u & 2v\\end{vmatrix} \\\\\n&= v^{3} \\cdot 2v - 3uv^{2} \\cdot 2u \\\\\n&= 2v^{4} - 6u^{2}v^{2} \\\\\n(∂(x, y))/(∂(u, v)) \\mid _{(-1, 2)} &= (2v^{4} - 6u^{2}v^{2}) \\mid _{u =-1v = 2} \\\\\n&= 2(2)^{4} - 6(-1)^{2}(2)^{2} \\\\\n&= 32 - 24 \\\\\n&= 8\n\\end{aligned}\n$$\n\nTherefore, we have\n\n$$\nArea(T(Δ))\\begin{vmatrix}\\approx & 8\\end{vmatrix}\\cdot δA; = 8δA\n$$"] [17592186128796 :question/problem "Sketch the region in the $uv$-plane where the transformation $\\mathbf{T}$, given by\n$\\begin{bmatrix}u \\\\ v\\end{bmatrix}$\nis (locally) orientation-reversing."] [17592186128796 :question/worked-solution "Recall that a transformation is (locally) orientation-reversing at the points where the Jacobian determinant is negative:\n\n$$\n\\dfrac{\\partial (x, y)}{\\partial (u, v)} < 0\n$$\n\nWe have\n\n$$\n\\begin{bmatrix}u \\\\ v\\end{bmatrix}\n$$\n\nComputing the corresponding Jacobian determinant, we obtain\n\n$$\n\\begin{aligned}\n(∂(x, y))/(∂(u, v)) &= \\begin{vmatrix}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{vmatrix} \\\\\n&=\\begin{vmatrix}e^{v} & ue^{v} \\\\ 2u & -2v\\end{vmatrix} \\\\\n&= e^{v} \\cdot (-2v) - ue^{v} \\cdot 2u \\\\\n&=-2e^{v}(u^{2} + v)\n\\end{aligned}\n$$\n\nTo find the required regions, we solve the following inequality:\n\n$$\n\\begin{bmatrix}-2e^{v}(u^{2} + v) & < 0 \\\\ u^{2} + v & > 0 \\\\ v & > - u^{2}\\end{bmatrix}\n$$\n\nNotice that the equation\n\n$$\nv=-u^2\n$$\n\ndefines a downward-opening parabola, and the coordinates of, say, $(1,1)$ satisfy the inequality.\n\nTherefore, the region where the transformation is (locally) orientation-reversing must be the following:\n\n![](/home/jake/Developer/MA/DATA/Lessons/1999/Source/Images/c1f0d183af763ad356f1fbb644c7e42e.png)"]] "immutable_answers" [17592186126435 17592186126436 17592186126437 17592186126438 17592186126439 17592186126465 17592186126466 17592186126467 17592186126468 17592186126469 17592186127203 17592186127204 17592186127205 17592186127206 17592186127207] "immutable_fields" [[17592186126434 :answer-field/correct] [17592186126434 :answer-field/id] [17592186126434 :answer-field/key] [17592186126434 :answer-field/type] [17592186126464 :answer-field/correct] [17592186126464 :answer-field/id] [17592186126464 :answer-field/key] [17592186126464 :answer-field/type] [17592186127202 :answer-field/correct] [17592186127202 :answer-field/id] [17592186127202 :answer-field/key] [17592186127202 :answer-field/type]] "no_history" []}
