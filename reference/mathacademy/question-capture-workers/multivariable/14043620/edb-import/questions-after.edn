ts/8382e54c1f91ff0e07910c1250c046413814748d9e7ef8968984b7223b43afcc.png)"}] [{:db/id #edb/ref 17592186321450 :knowledge-point/_questions [{:knowledge-point/id #uuid "091b8235-56d8-5a08-bc95-08c99772cfd8" :knowledge-point/title "Finding Regions Where a Transformation is Orientation-Preserving or Reversing"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5815e171-546a-5f9a-a4da-1ed44c6b5128" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/105e6e8a010b7b9001f75cf17e11cbbc1e031d83cbc2ddfafc3595c745106f3f.png" :db/id #edb/ref 17592186321452} {:answer/id #uuid "9cf92da6-2648-531d-991d-ef0e1e93a2e8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/090bab0ac1c6356010d83a6ad54c59b53b7dd12062fb5e331a936ce3f3a1b411.png" :db/id #edb/ref 17592186321453} {:answer/id #uuid "49574022-cbc5-5311-9ec6-bf20326d8c64" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/8b35fbafaf8d121bceef7a0763253df075fe4fe85eb3c992f95c59d05f986c67.png" :db/id #edb/ref 17592186321454} {:answer/id #uuid "480b62ed-9d84-5ea3-b12e-875da468fcc6" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/d477a9f312fc2fb0a5a4c2d13164c96118aa70b53cf23db80be9ec698151e6fd.png" :db/id #edb/ref 17592186321455} {:answer/id #uuid "80300e32-a562-5bc8-b8fe-dc3d7949aa79" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14043620/assets/09f7f36ecc2197cc95e1878fa22ac22367978809a5241f09886a7eb2fab071f3.png" :db/id #edb/ref 175