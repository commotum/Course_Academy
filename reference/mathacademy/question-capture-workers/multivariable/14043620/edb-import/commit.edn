)\\end{aligned}\n$$\n\nTherefore, the corresponding Jacobian determinant is\n\n$$\n\\begin{aligned}\\frac{∂(x,y)}{∂(u,v)} & =|\\begin{aligned}\\frac{∂x}{∂u} & \\frac{∂x}{∂v} \\\\ \\frac{∂y}{∂u} & \\frac{∂y}{∂v}\\end{aligned}| \\\\  & =|\\begin{aligned}\\operatorname{cos}⁡(u+v) & \\operatorname{cos}⁡(u+v) \\\\ -\\operatorname{sin}⁡(u-v)\\, & \\operatorname{sin}⁡(u-v)\\end{aligned}| \\\\  & =\\operatorname{cos}⁡(u+v)\\cdot \\operatorname{sin}⁡(u-v)-\\operatorname{cos}⁡(u+v)\\cdot (-\\operatorname{sin}⁡(u-v)) \\\\  & =2\\operatorname{cos}⁡(u+v)\\operatorname{sin}⁡(u-v).\\end{aligned}\n$$" 13194139534943 true] [17592186321493 1000 #edb/ref 17592186321494 13194139534943 true] [17592186321493 1000 #edb/ref 17592186321495 13194139534943 true] [17592186321493 1000 #edb/ref 17592186321496 13194139534943 true] [17592186321493 1000 #edb/ref 17592186321497 13194139534943 true] [17592186321493 1000 #edb/ref 17592186321498 13194139534943 true] [17592186321493 1040 #edb/ref 17592186045450 13194139534943 true] [17592186321493 1041 "selection" 13194139534943 true] [17592186321493 1104 #edb/ref 17592186321497 13194139534943 true] [17592186321493 1110 #uuid "a1afaefd-4350-5818-8b7b-7a9c63c65e34" 13194139534943 true] [17592186321494 1034 "2\\operatorname{cos}⁡(u-v)\\operatorname{sin}⁡(u+v)" 13194139534943 true] [17592186321494 1103 #edb/ref 17592186045453 13194139534943 true] [17592186321494 1111 #uuid "5ab097c8-fd2e-5294-b764-ae11be7adedc" 13194139534943 true] [17592186321495 1034 "{cos}^{2}⁡(u+v){sin}^{2}⁡(u-v)" 13194139534943 true] [17592186321495 1103 #edb/ref 17592186045453 13194139534943 true] [17592186321495 1111 #uuid "e558ee73-5bd8-52fb-926c-447f7c9cb4ad" 13194139534943 true] [17592186321496 1034 "\\operatorname{cos}⁡(u+v)\\operatorname{sin}⁡(u-v)" 13194139534943 true] [17592186321496 1103 #edb/ref 17592186045453 13194139534943 true] [17592186321496 1111 #uuid "42331668-5e01-55a8-94d6-a6ee432d6290" 13194139534943 true] [17592186321497 1034 "2\\operatorname{cos}⁡(u+v)\\operator