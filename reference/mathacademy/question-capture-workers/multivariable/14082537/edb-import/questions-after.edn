#{[{:db/id #edb/ref 17592186387128 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc7343e3-fa7d-58c8-b4c7-49ef5b85110b" :knowledge-point/title "Finding a Unit Tangent Given the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f563db8-5a92-5a94-a004-54299fcd46ed" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,-\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,\\sqrt{2}\\operatorname{cos}⁡(\\frac{s}{\\sqrt{2}})⟩" :db/id #edb/ref 17592186387130} {:answer/id #uuid "400f88c0-24a3-5d5d-926e-da51d0cbb3c3" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡(2s),\\,-\\operatorname{sin}⁡(2s),\\,\\sqrt{2}\\operatorname{cos}⁡(\\frac{s}{2})⟩" :db/id #edb/ref 17592186387131} {:answer/id #uuid "1680c502-e9f6-54c3-94f6-9b7b25704c95" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡s,\\,-\\operatorname{sin}⁡s,\\,\\sqrt{2}\\operatorname{cos}⁡s⟩" :db/id #edb/ref 17592186387132} {:answer/id #uuid "bece0aea-1636-5566-985f-5e28c17649cd" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡(\\frac{s}{2}),\\,-\\operatorname{sin}⁡(\\frac{s}{2}),\\,\\sqrt{2}\\operatorname{cos}⁡(2s)⟩" :db/id #edb/ref 17592186387133} {:answer/id #uuid "ad89ba39-5a76-5a2c-9549-9761553f5def" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,-\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}\\,s)⟩" :db/id #edb/ref 17592186387134}] :answer-field/correct {:answer/id #uuid "ad89ba39-5a76-5a2c-9549-9761553f5def" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,-\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}\\,s)⟩" :db/id #edb/ref 17592186387134} :answer-field/id #uuid "934d7893-7008-50ac-88df-c8521ebb4353" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387129}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3a0d8698-4b6a-51eb-917f-3ffab46caf40" :question/math-academy-id "q-127703" :question/problem "Given the curve $r(t)=⟨{sin}^{2}⁡t,\\,{cos}^{2}⁡t,\\,\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡2t⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=\\sqrt{2}\\,t,$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" :question/worked-solution "First, since $s=\\sqrt{2}\\,t,$ we have that $t=\\frac{s}{\\sqrt{2}}.$\n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\frac{s}{\\sqrt{2}}) \\\\  & =⟨{sin}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,{cos}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(2\\cdot \\frac{s}{\\sqrt{2}})⟩ \\\\  & =⟨{sin}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,{cos}^{2}⁡(\\frac{s}{\\sqrt{2}}),\\,\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(\\sqrt{2}\\,s)⟩.\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parametrized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n \n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =⟨\\frac{\\text{d}}{\\text{d}s}({sin}^{2}⁡(\\frac{s}{\\sqrt{2}})),\\,\\frac{\\text{d}}{\\text{d}s}({cos}^{2}⁡(\\frac{s}{\\sqrt{2}})),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(\\sqrt{2}\\,s))⟩ \\\\  & =⟨\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(2\\cdot \\frac{s}{\\sqrt{2}}),\\,-\\frac{1}{\\sqrt{2}}\\operatorname{sin}⁡(2\\cdot \\frac{s}{\\sqrt{2}}),\\,\\operatorname{cos}⁡(\\sqrt{2}\\,s)⟩ \\\\  & =\\frac{1}{\\sqrt{2}}⟨\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,-\\operatorname{sin}⁡(\\sqrt{2}\\,s),\\,\\sqrt{2}\\operatorname{cos}⁡(\\sqrt{2}\\,s)⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387135 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc7343e3-fa7d-58c8-b4c7-49ef5b85110b" :knowledge-point/title "Finding a Unit Tangent Given the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a33652d4-7f55-53d8-9101-035cfa1d5b67" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{5}⟨9,0,16⟩" :db/id #edb/ref 17592186387137} {:answer/id #uuid "34902e5f-83a5-521c-a965-eac79cb61a19" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{\\sqrt{5}}{5}⟨1,0,2⟩" :db/id #edb/ref 17592186387138} {:answer/id #uuid "001424b2-aecf-5914-b856-9c2e699688c4" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{5}⟨3,0,4⟩" :db/id #edb/ref 17592186387139} {:answer/id #uuid "9807502a-08ff-5d29-b195-6de4e63db7b1" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{\\sqrt{5}}{5}⟨3,1,4⟩" :db/id #edb/ref 17592186387140} {:answer/id #uuid "5c793df8-9306-5126-a9b8-374c202c6234" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{\\sqrt{2}}{4}⟨\\sqrt{3},1,2⟩" :db/id #edb/ref 17592186387141}] :answer-field/correct {:answer/id #uuid "001424b2-aecf-5914-b856-9c2e699688c4" :answer/type {:db/ident :answer.type/math} :answer/value "T(s)=\\frac{1}{5}⟨3,0,4⟩" :db/id #edb/ref 17592186387139} :answer-field/id #uuid "87da3487-3c4c-5afa-b55e-147f13901421" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387136}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a5d30766-fbf9-51ac-b32d-e1cc50064292" :question/math-academy-id "q-127709" :question/problem "Given the curve $r(t)=⟨\\frac{3}{5}{t}^{3/2},\\,1,\\,\\frac{4}{5}{t}^{3/2}⟩,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s={t}^{3/2},$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" :question/worked-solution "First, since $s={t}^{3/2},$ we have that $t={s}^{2/3}.$ \n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r({s}^{2/3}) \\\\  & =⟨\\frac{3}{5}{({s}^{2/3})}^{3/2},\\,1,\\,\\frac{4}{5}{({s}^{2/3})}^{3/2}⟩ \\\\  & =⟨\\frac{3s}{5},\\,1,\\,\\frac{4s}{5}⟩.\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parameterized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =⟨\\frac{\\text{d}}{\\text{d}s}(\\frac{3s}{5}),\\,\\frac{\\text{d}}{\\text{d}s}(1),\\,\\frac{\\text{d}}{\\text{d}s}(\\frac{4s}{5})⟩ \\\\  & =⟨\\frac{3}{5},\\,0,\\,\\frac{4}{5}⟩ \\\\  & =\\frac{1}{5}⟨3,0,4⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387142 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aecbb8b-bda3-5956-9b0f-98509330a84d" :knowledge-point/title "Finding the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f387d99e-6fc8-545d-8b8a-6d49c6c837b0" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡(\\frac{s}{\\sqrt{3}})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{\\sqrt{3}})⟩" :db/id #edb/ref 17592186387144} {:answer/id #uuid "ffcde8a0-8e85-5d05-92eb-e0eb0c362766" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=\\frac{1}{2}⟨\\operatorname{sin}⁡2s,\\,\\operatorname{cos}⁡2s⟩" :db/id #edb/ref 17592186387145} {:answer/id #uuid "e14966b7-3d84-5fe8-aeb7-4496303128b5" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=-3⟨\\operatorname{sin}⁡(\\frac{s}{3}),\\,\\operatorname{cos}⁡(\\frac{s}{3})⟩" :db/id #edb/ref 17592186387146} {:answer/id #uuid "f337d89c-6e24-518d-b0cd-08a2bd3d6aa5" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡(\\frac{s}{3})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{3})⟩" :db/id #edb/ref 17592186387147} {:answer/id #uuid "6bcd4f85-52be-515a-9580-a304b88718b7" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡3s-2,\\,1-3\\operatorname{sin}⁡3s⟩" :db/id #edb/ref 17592186387148}] :answer-field/correct {:answer/id #uuid "f337d89c-6e24-518d-b0cd-08a2bd3d6aa5" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=⟨3\\operatorname{cos}⁡(\\frac{s}{3})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{3})⟩" :db/id #edb/ref 17592186387147} :answer-field/id #uuid "1d7dcb92-e720-523a-88e6-bdf83920c069" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387143}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "6d6be787-1631-5d67-992f-e029b60d2ee2" :question/math-academy-id "q-127732" :question/problem "What is the parametrization of the curve $r(t)=⟨3\\operatorname{cos}⁡t-2,\\,1-3\\operatorname{sin}⁡t⟩,$ $t\\ge 0,$ by its arc length $s?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-2),\\,\\frac{\\text{d}}{\\text{d}t}(1-3\\operatorname{sin}⁡t)⟩ \\\\  & =⟨-3\\operatorname{sin}⁡t,\\,-3\\operatorname{cos}⁡t⟩ \\\\ ‖{r}^{′}(t)‖ & =\\sqrt{{(-3\\operatorname{sin}⁡t)}^{2}+{(-3\\operatorname{cos}⁡t)}^{2}} \\\\  & =\\sqrt{9{sin}^{2}⁡t+9{cos}^{2}⁡t} \\\\  & =\\sqrt{9({sin}^{2}⁡t+{cos}^{2}⁡t)} \\\\  & =\\sqrt{9} \\\\  & =3\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}3\\,\\text{d}u \\\\  & =3u\\,{|}_{0}^{t} \\\\  & =3t\\end{aligned}\n$$\n\nSince $s=3t,$ we have that $t=\\frac{s}{3}.$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\frac{s}{3}) \\\\  & =⟨3\\operatorname{cos}⁡(\\frac{s}{3})-2,\\,1-3\\operatorname{sin}⁡(\\frac{s}{3})⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387149 :knowledge-point/_questions [{:knowledge-point/id #uuid "4aecbb8b-bda3-5956-9b0f-98509330a84d" :knowledge-point/title "Finding the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "55c76955-9710-551b-9508-9e5ec2b1be1f" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=⟨{s}^{2}-1,\\,-2{s}^{2},\\,\\sqrt{5}{s}^{2}⟩" :db/id #edb/ref 17592186387151} {:answer/id #uuid "9a7de6ae-f1e0-5eef-87d0-aef64afab7c9" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=⟨1-{s}^{2},\\,2{s}^{2},\\,\\frac{\\sqrt{5}}{2}{s}^{2}⟩" :db/id #edb/ref 17592186387152} {:answer/id #uuid "aed192e0-24b7-59ba-a02b-c2a8a336fadb" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=\\frac{1}{5}⟨5-2s,\\,4s,\\,s\\sqrt{5}⟩" :db/id #edb/ref 17592186387153} {:answer/id #uuid "91881fdd-3541-5e83-a6c7-80ebe46f6ca1" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=\\frac{1}{5}⟨1-3s,\\,4s,\\,s\\sqrt{5}⟩" :db/id #edb/ref 17592186387154} {:answer/id #uuid "7b5b667d-7215-56d2-a1ba-229eefbf782d" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=\\frac{1}{3}⟨1-s,\\,s\\sqrt{3},\\,s\\sqrt{5}⟩" :db/id #edb/ref 17592186387155}] :answer-field/correct {:answer/id #uuid "aed192e0-24b7-59ba-a02b-c2a8a336fadb" :answer/type {:db/ident :answer.type/math} :answer/value "R(s)=\\frac{1}{5}⟨5-2s,\\,4s,\\,s\\sqrt{5}⟩" :db/id #edb/ref 17592186387153} :answer-field/id #uuid "507f2261-78b5-5206-8759-c2447632f362" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387150}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "663ad2ec-e20d-5150-8871-dd026ab4920b" :question/math-academy-id "q-127735" :question/problem "What is the parametrization of the curve $r(t)=⟨1-{t}^{2},\\,2{t}^{2},\\,\\frac{\\sqrt{5}}{2}{t}^{2}⟩,$ $t\\ge 0,$ by its arc length $s?$" :question/worked-solution "First, we find ${r}^{′}(t)$ and its magnitude $‖{r}^{′}(t)‖:$\n\n$$\n\\begin{aligned}{r}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(1-{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(2{t}^{2}),\\,\\frac{\\text{d}}{\\text{d}t}(\\frac{\\sqrt{5}}{2}{t}^{2})⟩ \\\\  & =⟨-2t,\\,4t,\\,\\sqrt{5}t⟩ \\\\  & =t⟨-2,\\,4,\\,\\sqrt{5}⟩ \\\\ ‖{r}^{′}(t)‖ & =|t|\\sqrt{{(-2)}^{2}+{(4)}^{2}+(\\sqrt{5})^{2}} \\\\  & =t\\sqrt{4+16+5} \\\\  & =t\\sqrt{25} \\\\  & =5t\\end{aligned}\n$$\n\nNow, we calculate the arc length of the curve from $0$ to $t:$\n\n$$\n\\begin{aligned}s & ={\\int }_{0}^{t}‖{r}^{′}(u)‖\\,\\text{d}u \\\\  & ={\\int }_{0}^{t}5u\\,\\text{d}u \\\\  & =5{\\int }_{0}^{t}u\\,\\text{d}u \\\\  & =\\frac{5}{2}{u}^{2}\\,{|}_{0}^{t} \\\\  & =\\frac{5}{2}{t}^{2}\\end{aligned}\n$$\n\nSince $s=\\frac{5}{2}{t}^{2},$ we have\n\n$$\n\\begin{aligned}\\frac{5}{2}{t}^{2} & =s \\\\ {t}^{2} & =\\frac{2s}{5} \\\\ t & =\\sqrt{\\frac{2s}{5}}.\\end{aligned}\n$$\n\nTherefore, the vector function that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\sqrt{\\frac{2s}{5}}) \\\\  & =⟨1-{(\\sqrt{\\frac{2s}{5}})}^{2},\\,2{(\\sqrt{\\frac{2s}{5}})}^{2},\\,\\frac{\\sqrt{5}}{2}{(\\sqrt{\\frac{2s}{5}})}^{2}⟩ \\\\  & =⟨1-\\frac{2s}{5},\\,\\frac{4s}{5},\\,\\frac{s\\sqrt{5}}{5}⟩ \\\\  & =\\frac{1}{5}⟨5-2s,\\,4s,\\,s\\sqrt{5}⟩.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186387156 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc7343e3-fa7d-58c8-b4c7-49ef5b85110b" :knowledge-point/title "Finding a Unit Tangent Given the Parametrization of a Curve by Arc Length"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bcd9f0d9-edae-5329-8465-bbec48b380be" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\,i-\\frac{\\sqrt{8}}{5}\\,j-\\frac{2}{5}\\,k" :db/id #edb/ref 17592186387158} {:answer/id #uuid "ed3f37bd-8fd7-5c8f-94a1-26f3fc589427" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}\\,i+\\frac{\\sqrt{8}}{5}\\,j-\\frac{1}{5}\\,k" :db/id #edb/ref 17592186387159} {:answer/id #uuid "03550200-de1d-562c-9029-88536a4d3e48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\,i+\\frac{\\sqrt{8}}{5}\\,j-\\frac{4}{5}\\,k" :db/id #edb/ref 17592186387160} {:answer/id #uuid "4bf44ec1-daff-5a70-a86d-9d6bcb2acb3b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{50}\\,i+\\frac{\\sqrt{8}}{5}\\,j-\\frac{4}{25}\\,k" :db/id #edb/ref 17592186387161} {:answer/id #uuid "03ac0e75-4c77-52ff-9e5c-7281ae371e91" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{s}{5}\\,i+\\frac{\\sqrt{8}}{5}\\,j+\\frac{4}{5}\\,k" :db/id #edb/ref 17592186387162}] :answer-field/correct {:answer/id #uuid "03550200-de1d-562c-9029-88536a4d3e48" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{5}\\,i+\\frac{\\sqrt{8}}{5}\\,j-\\frac{4}{5}\\,k" :db/id #edb/ref 17592186387160} :answer-field/id #uuid "2cea0611-1561-5119-b977-26732a94c13f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186387157}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "72f93e03-a33f-50d8-b52b-f8964fad8ff2" :question/math-academy-id "q-78349" :question/problem "Given the curve  $r(t)=t\\,i+\\sqrt{8}t\\,j-4t\\,k,$ $t\\ge 0,$ for which the arc length $s$ from $r(0)$ to $r(t)$ is given by $s=5t,$ find the corresponding unit tangent $T(s),$ parametrized by $s.$" :question/worked-solution "First, since $s=5t$, we have that $t=\\frac{s}{5}.$  \n\nTherefore, the vector function $R(s)$ that parametrizes $r(t)$ by its arc length is given by\n\n$$\n\\begin{aligned}R(s) & =r(\\frac{s}{5}) \\\\  & =\\frac{s}{5}\\,i+(\\sqrt{8}\\cdot \\frac{s}{5})j-4\\cdot \\frac{s}{5}\\,k \\\\  & =\\frac{s}{5}\\,i+\\frac{\\sqrt{8}s}{5}\\,j-\\frac{4s}{5}\\,k.\\end{aligned}\n$$\n\n   \n\nNow, since the curve is parametrized by its arc length $s$, the unit tangent can be found as\n\n$$\nT(s)=\\frac{\\text{d}}{\\text{d}s}R(s).\n$$\n\nSo, we obtain\n\n$$\n\\begin{aligned}T(s) & =\\frac{\\text{d}}{\\text{d}s}R(s) \\\\  & =\\frac{\\text{d}}{\\text{d}s}(\\frac{s}{5})i+\\frac{\\text{d}}{\\text{d}s}(\\frac{\\sqrt{8}s}{5})j-\\frac{\\text{d}}{\\text{d}s}(\\frac{4s}{5})k \\\\  & =\\frac{1}{5}\\,i+\\frac{\\sqrt{8}}{5}\\,j-\\frac{4}{5}\\,k.\\end{aligned}\n$$"}]}
