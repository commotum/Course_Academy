#{[{:db/id #edb/ref 17592186124132 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/id #uuid "58055e3d-a903-5b8d-8d65-241cfc118218" :question/math-academy-id "e-12559" :question/problem "Identify the surface $z -1 = \\dfrac{(x-3)^2}{4} - \\dfrac{(y+2)^2}4.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2},\n$$\n\nand a hyperbolic paraboloid centered at $(x_0,y_0,z_0)$ is given by\n\n$$\nz - z_0 = \\dfrac{(x-x_0)^2}{a^2}-\\dfrac{(y-y_0)^2}{b^2}.\n$$\n\nThus, our equation is a hyperbolic paraboloid with the following parameters:\n\n$$\n(x_0,y_0,z_0) = (3, -2, 1), \\quad a= b=2.\n$$"}] [{:db/id #edb/ref 17592186124133 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/id #uuid "badbbddb-cfe9-589c-becd-d863b061ac6f" :question/math-academy-id "e-12560" :question/problem "Identify the surface $x = \\dfrac{y^2}{4} - 4z^2.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $\\boldsymbol x$**-axis** is given by\n\n$$\nx = \\dfrac{y^2}{b^2} - \\dfrac{z^2}{c^2}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $x$-axis, and $b=2, \\: c=\\dfrac 12.$"}] [{:db/id #edb/ref 17592186124327 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/id #uuid "50223d8d-b31c-5895-ab0b-178258fea716" :question/math-academy-id "e-8313" :question/problem "Identify the surface $-x^2 + z^2 + 2x + y=0.$" :question/worked-solution "First, we complete the square in the $x$ term:\n\n$$\n\\begin{aligned}-{x}^{2}+{z}^{2}+2x+y & =0 \\\\ -({x}^{2}-2x)+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+1+{z}^{2}+y & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}-(x-1)^{2}+1+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+{z}^{2} & =-y-1 \\\\ (x-1)^{2}-{z}^{2} & =y+1.\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1, -1, 0).$"}] [{:db/id #edb/ref 17592186124749 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da9a4b8b-0415-5fd7-9da0-8efe5c229f60" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186121514} {:answer/id #uuid "ebbea473-f7c9-5d69-9815-ac006aa1077a" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186121515} {:answer/id #uuid "18785efe-c638-5298-8cf4-77ddce89c590" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186121516} {:answer/id #uuid "22d57297-be47-54b6-b3df-080539be7153" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis." :db/id #edb/ref 17592186121517} {:answer/id #uuid "657f62e5-d8e2-5491-abf1-739e1ba9cc9c" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186121518}] :answer-field/correct {:answer/id #uuid "657f62e5-d8e2-5491-abf1-739e1ba9cc9c" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186121518} :answer-field/id #uuid "20069c8a-5310-5e63-b444-86ffa0e7f607" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121513}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a4c96dde-6df8-575b-bdd9-f49e9283853d" :question/math-academy-id "q-164373" :question/problem "Identify the surface ${z}^{2}+{y}^{2}-{x}^{2}=1.$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nThus, a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n-\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=-1.\n$$\n\nTherefore, our equation is a hyperboloid of one sheet whose axis of symmetry is the $x$-axis and $a=b=c=1.$"}] [{:db/id #edb/ref 17592186317991 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f30fd7d1-e33f-5533-8c45-c61c41afba7e" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186317993} {:answer/id #uuid "820f11cb-9451-57ef-97d5-c90c1992694c" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186317994} {:answer/id #uuid "19182391-bf7e-5581-b1d9-d73648400bc0" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186317995} {:answer/id #uuid "f07ed99f-f851-57f9-93c8-86b3e21d1c28" :answer/type {:db/ident :answer.type/text} :answer/value "A sphere" :db/id #edb/ref 17592186317996} {:answer/id #uuid "f342403c-82b5-53e2-b71b-4b0b57ac51b4" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186317997}] :answer-field/correct {:answer/id #uuid "19182391-bf7e-5581-b1d9-d73648400bc0" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186317995} :answer-field/id #uuid "a97c1d46-738f-5d58-903e-ace8caaa6dd0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317992}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "409c6f40-648e-50d1-9c75-8b4b95b93e61" :question/math-academy-id "q-164474" :question/problem "Identify the following surface: \n\n$$\n(x+1)^{2}+(y-3)^{2}-(z-1)^{2}=1\n$$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1,\n$$\n\nand a hyperboloid of one sheet centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}-\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=1,\n$$\n\nThus, our equation is a hyperboloid of one sheet with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(-1,3,1),\\,a=b=c=1.\n$$"}] [{:db/id #edb/ref 17592186317998 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1acf8187-cb9d-5cb7-a0d8-d7817eea5b37" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186318000} {:answer/id #uuid "e64ec4be-1ba0-53ab-a472-5f3ede7d2bd4" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186318001} {:answer/id #uuid "9c95281d-3d3b-55d7-ad2e-cab87b0628a7" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet" :db/id #edb/ref 17592186318002} {:answer/id #uuid "adbd99ef-83bd-5958-b7e8-8d1f72348506" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186318003} {:answer/id #uuid "a86735e7-3b4b-5ff2-9230-a8799bea55d3" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid" :db/id #edb/ref 17592186318004}] :answer-field/correct {:answer/id #uuid "1acf8187-cb9d-5cb7-a0d8-d7817eea5b37" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets" :db/id #edb/ref 17592186318000} :answer-field/id #uuid "880a890a-40a9-51f4-ba11-3f6d6bbecfc7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186317999}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1cc40487-6e8d-55c3-bbc9-868108f22530" :question/math-academy-id "q-164476" :question/problem "Identify the following surface: \n\n$$\n\\frac{(x+1)^{2}}{3}+\\frac{{y}^{2}}{4}-(z-2)^{2}=-1\n$$" :question/worked-solution "Recall that the equation of a hyperboloid of two sheets centered at $O$ is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=-1,\n$$\n\nand a hyperboloid of two sheets centered at $({x}_{0},{y}_{0},{z}_{0})$ is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}-\\frac{(z-{z}_{0})^{2}}{{c}^{2}}=-1,\n$$\n\nThus, our equation is a hyperboloid of two sheets with the following parameters:\n\n$$\n({x}_{0},{y}_{0},{z}_{0})=(-1,0,2),\\,a=\\sqrt{3},\\,b=2,\\,c=1.\n$$"}] [{:db/id #edb/ref 17592186318005 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "2a1d21cd-3b76-508f-b23f-8886bc6707de" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186318007} {:answer/id #uuid "f0b6f286-448d-57c2-94a1-d2f88cb0a6b1" :answer/type {:db/ident :answer.type/text} :answer/value "A paraboloid" :db/id #edb/ref 17592186318008} {:answer/id #uuid "93d70e3e-98c4-5f0d-96d8-4828cf533af0" :answer/type {:db/ident :answer.type/text} :answer/value "A couple of incident planes" :db/id #edb/ref 17592186318009} {:answer/id #uuid "23191fe5-f5ca-59a7-87a1-e62a73dfcb45" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186318010} {:answer/id #uuid "36261c82-c30e-52a2-a86b-d40e5fb54a58" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186318011}] :answer-field/correct {:answer/id #uuid "2a1d21cd-3b76-508f-b23f-8886bc6707de" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186318007} :answer-field/id #uuid "1a2f625a-b678-50f9-9547-31f758050b9e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318006}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "54012dc7-14b3-5689-95f3-f8a190ce1f21" :question/math-academy-id "q-164480" :question/problem "Identify the following surface:\n\n$$\n{x}^{2}=8y,\\,-\\infty <z<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder, whose axis is the $z$-axis, is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, our equation is a parabolic cylinder with $p=2.$"}] [{:db/id #edb/ref 17592186318012 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ce325de-59fe-5a84-ba52-a452dd96d85e" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone" :db/id #edb/ref 17592186318014} {:answer/id #uuid "ef4c683a-1163-5f4e-9520-cf03e64e663c" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid" :db/id #edb/ref 17592186318015} {:answer/id #uuid "e1bf6a72-a95e-5560-9746-6705a2918e21" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186318016} {:answer/id #uuid "5f28c077-57ff-59f3-a1a9-63ea3c5dc991" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186318017} {:answer/id #uuid "87242e56-6808-5b9a-98d6-9670dfcc6664" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186318018}] :answer-field/correct {:answer/id #uuid "87242e56-6808-5b9a-98d6-9670dfcc6664" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic cylinder" :db/id #edb/ref 17592186318018} :answer-field/id #uuid "c67bdacd-4bb3-59e8-9133-9f3a64ec4856" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318013}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "540afee8-a0c6-54b4-b0fc-ff72c9dd4c07" :question/math-academy-id "q-164481" :question/problem "Identify the following surface: \n\n$$\n(x+2)^{2}-(y-1)^{2}=1,\\,-\\infty <z<\\infty \n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder, whose axis of symmetry is the $z$-axis, is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1,\n$$\n\nand a hyperbolic cylinder, whose axis of symmetry is parallel to the $z$-axis and passes through the point $({x}_{0},{y}_{0})$ in the $xy$-plane, is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=1.\n$$\n\nThus, our equation is a hyperbolic cylinder with the following parameters:\n\n$$\n({x}_{0},{y}_{0})=(-2,1),\\,a=b=1.\n$$"}] [{:db/id #edb/ref 17592186318019 :knowledge-point/_questions [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0bddedb4-e640-5cd9-bf13-19e6c37e3766" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186318021} {:answer/id #uuid "3e19584b-6891-5e55-beed-9aeac1672ea9" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid" :db/id #edb/ref 17592186318022} {:answer/id #uuid "311a5a34-8050-59f4-944f-d4a190db1480" :answer/type {:db/ident :answer.type/text} :answer/value "A plane" :db/id #edb/ref 17592186318023} {:answer/id #uuid "a0f944b3-4d3e-5be9-8724-d9f403115bbf" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder" :db/id #edb/ref 17592186318024} {:answer/id #uuid "fd3b2057-8b72-575b-95c4-e450e6bd062f" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid" :db/id #edb/ref 17592186318025}] :answer-field/correct {:answer/id #uuid "0bddedb4-e640-5cd9-bf13-19e6c37e3766" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder" :db/id #edb/ref 17592186318021} :answer-field/id #uuid "9d8e1b59-1ea2-5f9f-a698-0e06cbae7775" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318020}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0d873ba3-1de8-589c-8d59-c93b67e60172" :question/math-academy-id "q-164482" :question/problem "Identify the following surface: \n\n$$\n(x+2)^{2}=-y,\\,-\\infty <z<\\infty \n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder, whose axis is the $z$-axis, is given by\n\n$$\n{x}^{2}=4py,\n$$\n\nand a parabolic cylinder, shifted ${x}_{0}$ along the x-axis and ${y}_{0}$ along the y-axis, is given by\n\n$$\n(x-{x}_{0})^{2}=4p(y-{y}_{0}).\n$$\n\nThus, our equation is a parabolic cylinder with the following parameters:\n\n$$\n({x}_{0},{y}_{0})=(-2,0),\\,p=-\\frac{1}{4}.\n$$"}] [{:db/id #edb/ref 17592186318026 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e5ca5383-5470-51fe-a496-460013639df9" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318028} {:answer/id #uuid "04db37e8-f663-5f1e-91b8-3cef59a639a8" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318029} {:answer/id #uuid "44160997-38f1-5eda-bb61-d49457e5d735" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318030} {:answer/id #uuid "c7324a2c-c610-568d-af87-b6d3ad72ab1a" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318031} {:answer/id #uuid "faa5f01f-db56-5cca-b32c-3056621016fc" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318032}] :answer-field/correct {:answer/id #uuid "44160997-38f1-5eda-bb61-d49457e5d735" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318030} :answer-field/id #uuid "57d2e64e-2f6b-55fb-b232-7c32ffa4a9a8" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318027}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "957cab7b-45d6-58a1-a2fb-5fe2be5930e7" :question/math-academy-id "q-164507" :question/problem "Identify the surface ${x}^{2}-4{y}^{2}+\\frac{{z}^{2}}{9}=1.$" :question/worked-solution "Recall that the equation of a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nThus, a hyperboloid of one sheet centered at $O$ whose axis of symmetry is the $y$**-axis** is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1.\n$$\n\nTherefore, our equation is a hyperboloid of one sheet whose axis of symmetry is the $y$-axis and $a=1,\\,b=\\frac{1}{2},\\,c=3.$"}] [{:db/id #edb/ref 17592186318033 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "74fd38a9-d719-5599-8113-02e54fc5b0ed" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318035} {:answer/id #uuid "04c62c20-9921-5ea0-9e23-779897aadfcd" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318036} {:answer/id #uuid "9095ca39-7a82-5dfc-bdec-91a163ad9787" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318037} {:answer/id #uuid "20d415a6-3946-54d9-b649-a0577945abba" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318038} {:answer/id #uuid "e514088a-8e29-5121-b14a-a35d22def77c" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318039}] :answer-field/correct {:answer/id #uuid "20d415a6-3946-54d9-b649-a0577945abba" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318038} :answer-field/id #uuid "74a2e19c-d360-5dd6-b691-33b53c190f0e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318034}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e5a75c9b-5dbc-5d66-b2ec-39592397a14a" :question/math-academy-id "q-164510" :question/problem "Identify the surface $x=\\frac{{y}^{2}}{2}+\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of an elliptic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic paraboloid centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\nx=\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic paraboloid whose axis of symmetry is the $x$-axis and $b=\\sqrt{2},\\,c=2.$"}] [{:db/id #edb/ref 17592186318040 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94bd3ba3-8a69-517a-9a7f-72fc8eeddfc1" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318042} {:answer/id #uuid "726a7a59-0612-533f-9c2f-618cdc10a2ae" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318043} {:answer/id #uuid "1bb71857-908c-525a-9470-86241d15d126" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318044} {:answer/id #uuid "828e515d-ce16-5926-8119-7d171b72aa52" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid with one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318045} {:answer/id #uuid "c1c71383-7341-5431-8803-5b6e470a3cf4" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $y$-axis" :db/id #edb/ref 17592186318046}] :answer-field/correct {:answer/id #uuid "1bb71857-908c-525a-9470-86241d15d126" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186318044} :answer-field/id #uuid "1d338007-a0f8-50b8-99c9-e1358a0135ed" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318041}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "162a7330-3cd1-534a-96c3-f95256e264e0" :question/math-academy-id "q-164514" :question/problem "Identify the surface ${x}^{2}=\\frac{{y}^{2}}{4}+\\frac{{z}^{2}}{4}.$" :question/worked-solution "Recall that the equation of an elliptic cone centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\n\\frac{{z}^{2}}{{c}^{2}}=\\frac{{x}^{2}}{{a}^{2}}+\\frac{{y}^{2}}{{b}^{2}}.\n$$\n\nThus, an elliptic cone centered at $O$ whose axis of symmetry is the $x$**-axis** is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}=\\frac{{y}^{2}}{{b}^{2}}+\\frac{{z}^{2}}{{c}^{2}}.\n$$\n\nTherefore, our equation is an elliptic cone whose axis of symmetry is the $x$-axis and $a=1,\\,b=c=2.$"}] [{:db/id #edb/ref 17592186318047 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e7b5d5d-f2d8-532a-8fad-c23ed2e55342" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186318049} {:answer/id #uuid "3181e6ff-b563-5a5c-b346-62f0602c6fdb" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186318050} {:answer/id #uuid "2836790f-a379-599b-a480-259122e64e76" :answer/type {:db/ident :answer.type/text} :answer/value "A couple of planes" :db/id #edb/ref 17592186318051} {:answer/id #uuid "2429412a-4b5a-5295-9b29-91029a407806" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186318052} {:answer/id #uuid "4c0f9be3-a31e-51b8-b636-3ca4eed6722d" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cylinder whose axis is the $y$-axis" :db/id #edb/ref 17592186318053}] :answer-field/correct {:answer/id #uuid "0e7b5d5d-f2d8-532a-8fad-c23ed2e55342" :answer/type {:db/ident :answer.type/text} :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/id #edb/ref 17592186318049} :answer-field/id #uuid "e07bee6a-0441-5240-b738-410d0b8968fe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318048}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e6405c1f-687f-5885-ba4f-9acf28300465" :question/math-academy-id "q-164548" :question/problem "Identify the following surface:\n\n$$\n{z}^{2}=-12y,\\,-\\infty <x<\\infty .\n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder whose axis is the $z$-axis is given by\n\n$$\n{x}^{2}=4py.\n$$\n\nThus, a parabolic cylinder whose axis is the $x$**-axis** is given by\n\n$$\n{z}^{2}=4py.\n$$\n\nTherefore, our equation is a parabolic cylinder whose axis is the $x$-axis and $p=-3.$"}] [{:db/id #edb/ref 17592186318054 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95d20a1c-0df8-56ec-8726-faa627d9a2a8" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(0,-1,-2)$" :db/id #edb/ref 17592186318056} {:answer/id #uuid "93630aef-9a4c-5cf6-8c87-3c3a1311145f" :answer/type {:db/ident :answer.type/text} :answer/value "A ellipsoid centered at $(0,-1,2)$" :db/id #edb/ref 17592186318057} {:answer/id #uuid "6da1efea-911b-5e83-9255-81452bcf43dd" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(0,1,2)$" :db/id #edb/ref 17592186318058} {:answer/id #uuid "4a2eeed0-46b5-5cd3-b77e-798176dd1f50" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(0,-1,2)$" :db/id #edb/ref 17592186318059} {:answer/id #uuid "9c766077-08d1-53c9-b04b-15fe668cd137" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(0,-1,2)$" :db/id #edb/ref 17592186318060}] :answer-field/correct {:answer/id #uuid "4a2eeed0-46b5-5cd3-b77e-798176dd1f50" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(0,-1,2)$" :db/id #edb/ref 17592186318059} :answer-field/id #uuid "e224170f-25b6-5699-b9ab-a49272b99b7b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318055}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "eb9dbbc2-96e4-50d8-8192-3c9948666874" :question/math-academy-id "q-164550" :question/problem "Identify the surface ${x}^{2}-{y}^{2}+2{z}^{2}-2y-8z-9=0.$" :question/worked-solution "First, we complete the square in the $y$ and $z$ terms:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2}+2{z}^{2}-2y-8z-9 & =0 \\\\ {x}^{2}-({y}^{2}+2y)+2({z}^{2}-4z)-9 & =0 \\\\ {x}^{2}-(y+1)^{2}+1+2[(z-2)^{2}-4]-9 & =0 \\\\ {x}^{2}-(y+1)^{2}+1+2(z-2)^{2}-8-9 & =0 \\\\ {x}^{2}-(y+1)^{2}+2(z-2)^{2}-16 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}{x}^{2}-(y+1)^{2}+2(z-2)^{2}-16 & =0 \\\\ {x}^{2}-(y+1)^{2}+2(z-2)^{2} & =16 \\\\ \\frac{{x}^{2}}{16}-\\frac{(y+1)^{2}}{16}+\\frac{(z-2)^{2}}{8} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of one sheet centered at $(0,-1,2).$"}] [{:db/id #edb/ref 17592186318061 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0703470a-6dd4-5c96-b415-5d7861a9d3ba" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,-2,0)$" :db/id #edb/ref 17592186318063} {:answer/id #uuid "de6b9c73-d23f-5ab8-ad44-417858274573" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-2,0)$" :db/id #edb/ref 17592186318064} {:answer/id #uuid "9ea72bf5-fb09-57f6-bf8f-bde090f371df" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,2,1)$" :db/id #edb/ref 17592186318065} {:answer/id #uuid "63c6ae56-97b1-5707-a91c-bb379daf5ebf" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,-2,0)$" :db/id #edb/ref 17592186318066} {:answer/id #uuid "2dc1659c-fe24-5447-a738-559fc001ff7a" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,2,1)$" :db/id #edb/ref 17592186318067}] :answer-field/correct {:answer/id #uuid "0703470a-6dd4-5c96-b415-5d7861a9d3ba" :answer/type {:db/ident :answer.type/text} :answer/value "An ellipsoid centered at $(1,-2,0)$" :db/id #edb/ref 17592186318063} :answer-field/id #uuid "1e53187f-e027-5eed-8f43-84c27237d42c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318062}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "84fd9eec-1cf5-594c-8917-00bf240277f1" :question/math-academy-id "q-164555" :question/problem "Identify the surface ${x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11 & =0 \\\\ ({x}^{2}-2x)+5({y}^{2}+4y)+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5([y+2)^{2}-4]+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5(y+2)^{2}-20+{z}^{2}+11 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2} & =10 \\\\ \\frac{(x-1)^{2}}{10}+\\frac{(y+2)^{2}}{2}+\\frac{{z}^{2}}{10} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipsoid centered at $(1,-2,0).$"}] [{:db/id #edb/ref 17592186318068 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30b7142d-4b8f-5b30-9107-a6f3463948da" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(-1,0,1)$" :db/id #edb/ref 17592186318070} {:answer/id #uuid "df31f0a9-3efb-5456-8830-e2bb6ac8da33" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(-1,1,0)$" :db/id #edb/ref 17592186318071} {:answer/id #uuid "65cfe060-6377-5908-beb3-f8d344eae1d7" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186318072} {:answer/id #uuid "b9a265b7-5e8b-5e41-a759-c2783396ac01" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186318073} {:answer/id #uuid "bf681932-5e7e-54c1-96a4-14ef8981acee" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-1,0)$" :db/id #edb/ref 17592186318074}] :answer-field/correct {:answer/id #uuid "65cfe060-6377-5908-beb3-f8d344eae1d7" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/id #edb/ref 17592186318072} :answer-field/id #uuid "0a7a8c6f-9473-5089-bbc9-acffaeaec200" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318069}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e6d1bbdf-cfcb-54f3-b97f-c63787cc6751" :question/math-academy-id "q-36107" :question/problem "Identify the surface $4{y}^{2}+8y+9{z}^{2}-5x+9=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}4{y}^{2}+8y+9{z}^{2}-5x+9 & =0 \\\\ 4({y}^{2}+2y)+9{z}^{2}-5x+9 & =0 \\\\ 4[(y+1)^{2}-1]+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}-4+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}+9{z}^{2}-5x+5 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(y+1)^{2}+9{z}^{2}-5x+5 & =0 \\\\ 4(y+1)^{2}+9{z}^{2} & =5(x-1) \\\\ \\frac{4(y+1)^{2}}{5}+\\frac{9{z}^{2}}{5} & =x-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(1,-1,0).$"}] [{:db/id #edb/ref 17592186318075 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b366c570-9014-550e-a72f-3960455399e0" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(1,-2,0)$" :db/id #edb/ref 17592186318077} {:answer/id #uuid "237e2ada-4aa2-5b6a-9d36-42e6999d497b" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(0,-2,1)$" :db/id #edb/ref 17592186318078} {:answer/id #uuid "1aeca64a-d410-5b41-9b0e-b7b02b5a4fe4" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186318079} {:answer/id #uuid "5b8cdd42-126c-5ad9-a783-820f95c9fced" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone centered at $(1,-2,0)$" :db/id #edb/ref 17592186318080} {:answer/id #uuid "f9ce7fa3-9ae9-5fe5-890c-1c16313bff5b" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbolic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186318081}] :answer-field/correct {:answer/id #uuid "1aeca64a-d410-5b41-9b0e-b7b02b5a4fe4" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic paraboloid centered at $(0,-2,1)$" :db/id #edb/ref 17592186318079} :answer-field/id #uuid "d6b94f7e-42c4-5308-b3a4-d0d4634e1410" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318076}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3aef9826-cee6-5c7b-99d8-ae9e9ec092cd" :question/math-academy-id "q-36111" :question/problem "Identify the surface ${x}^{2}+3{y}^{2}+12y-z+13=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}+12y-z+13 & =0 \\\\ {x}^{2}+3({y}^{2}+4y)-z+13 & =0 \\\\ {x}^{2}+3[(y+2)^{2}-4]-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-12-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-z+1 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}{x}^{2}+3(y+2)^{2}-z+1 & =0 \\\\ {x}^{2}+3(y+2)^{2} & =z-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(0,-2,1).$"}] [{:db/id #edb/ref 17592186318082 :knowledge-point/_questions [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "18f2ba50-156e-5cdd-9a51-10f6077523f4" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,-1,0)$" :db/id #edb/ref 17592186318084} {:answer/id #uuid "7575149c-32bb-57ad-b840-427d0d6d01ee" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(-1,-1,0)$" :db/id #edb/ref 17592186318085} {:answer/id #uuid "039762d1-d0ba-5737-b000-352cfdcdb9f1" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet centered at $(1,1,0)$" :db/id #edb/ref 17592186318086} {:answer/id #uuid "385da4ad-dc9e-5a45-9c00-d184601abac5" :answer/type {:db/ident :answer.type/text} :answer/value "A ellipsoid centered at $(1,1,0)$" :db/id #edb/ref 17592186318087} {:answer/id #uuid "428777b1-ea9a-54ff-ab02-757fbbfb7635" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186318088}] :answer-field/correct {:answer/id #uuid "428777b1-ea9a-54ff-ab02-757fbbfb7635" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets centered at $(1,1,0)$" :db/id #edb/ref 17592186318088} :answer-field/id #uuid "e9e99390-6a30-5ca0-958d-0a5b4087024e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186318083}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "007da143-db60-5e0f-8ea3-b131ac1ff8ef" :question/math-academy-id "q-36666" :question/problem "Identify the surface $6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}6{x}^{2}-4{y}^{2}-6{z}^{2}-12x+8y-10 & =0 \\\\ 6({x}^{2}-2x)-4({y}^{2}-2y)-6{z}^{2}-10 & =0 \\\\ 6[(x-1)^{2}-1]-4[(y-1)^{2}-1]-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-6-4(y-1)^{2}+4-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2} & =12 \\\\ \\frac{(x-1)^{2}}{2}-\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{2} & =1 \\\\ \\frac{(y-1)^{2}}{3}+\\frac{{z}^{2}}{2}-\\frac{(x-1)^{2}}{2} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(1,1,0).$"}]}
