#{[{:db/id #edb/ref 17592186124132 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders"}] :question/id #uuid "58055e3d-a903-5b8d-8d65-241cfc118218" :question/math-academy-id "e-12559" :question/problem "Identify the surface $z -1 = \\dfrac{(x-3)^2}{4} - \\dfrac{(y+2)^2}4$." :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}\n$$\n\nand a hyperbolic paraboloid centered at $(x_0,y_0,z_0)$ is given by\n\n$$\nz - z_0 = \\dfrac{(x-x_0)^2}{a^2}-\\dfrac{(y-y_0)^2}{b^2}\n$$\n\nThus, our equation is a hyperbolic paraboloid with the following parameters:\n\n$$\n(x_0,y_0,z_0) = (3, -2, 1), \\quad a= b=2\n$$"}] [{:db/id #edb/ref 17592186124133 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/id #uuid "badbbddb-cfe9-589c-becd-d863b061ac6f" :question/math-academy-id "e-12560" :question/problem "Identify the surface $x = \\dfrac{y^2}{4} - 4z^2$." :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $\\boldsymbol x$**-axis** is given by\n\n$$\nx = \\dfrac{y^2}{b^2} - \\dfrac{z^2}{c^2}\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $x$-axis, and\n\n$$\nb=2, \\: c=\\dfrac 12\n$$"}] [{:db/id #edb/ref 17592186124327 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f" :knowledge-point/title "Identifying Quadric Surfaces by Completing the Square"}] :question/id #uuid "50223d8d-b31c-5895-ab0b-178258fea716" :question/math-academy-id "e-8313" :question/problem "Identify the surface $-x^2 + z^2 + 2x + y=0$." :question/worked-solution "First, we complete the square in the $x$ term:\n\n$$\n\\begin{aligned}\n-x^{2} + z^{2} + 2x + y &= 0 \\\\\n- (x^{2} - 2x) + z^{2} + y &= 0 \\\\\n- (x - 1)^{2} + 1 + z^{2} + y &= 0\n\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}\n- (x - 1)^{2} + 1 + z^{2} + y &= 0 \\\\\n- (x - 1)^{2} + z^{2} &= -y - 1 \\\\\n(x - 1)^{2} - z^{2} &= y + 1\n\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1, -1, 0)$."}] [{:db/id #edb/ref 17592186124749 :knowledge-point/_questions [{:knowledge-point/id #uuid "89fbf42b-d171-5772-87ce-cf622b720963" :knowledge-point/title "Identifying Quadric Surfaces and Cylinders With Alternative Orientations"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "da9a4b8b-0415-5fd7-9da0-8efe5c229f60" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186121514} {:answer/id #uuid "ebbea473-f7c9-5d69-9815-ac006aa1077a" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186121515} {:answer/id #uuid "18785efe-c638-5298-8cf4-77ddce89c590" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of two sheets whose axis of symmetry is the $z$-axis" :db/id #edb/ref 17592186121516} {:answer/id #uuid "22d57297-be47-54b6-b3df-080539be7153" :answer/type {:db/ident :answer.type/text} :answer/value "An elliptic cone whose axis of symmetry is the $x$-axis." :db/id #edb/ref 17592186121517} {:answer/id #uuid "657f62e5-d8e2-5491-abf1-739e1ba9cc9c" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186121518}] :answer-field/correct {:answer/id #uuid "657f62e5-d8e2-5491-abf1-739e1ba9cc9c" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperboloid of one sheet whose axis of symmetry is the $x$-axis" :db/id #edb/ref 17592186121518} :answer-field/id #uuid "20069c8a-5310-5e63-b444-86ffa0e7f607" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186121513}] :question/id #uuid "a4c96dde-6df8-575b-bdd9-f49e9283853d" :question/math-academy-id "q-164373" :question/problem "Identify the surface $z^{2} + y^{2} - x^{2} = 1$."}]}
