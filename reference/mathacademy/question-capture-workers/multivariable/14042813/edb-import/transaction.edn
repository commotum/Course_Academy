}^{2}-10 & =0 \\\\ 6(x-1)^{2}-6-4(y-1)^{2}+4-6{z}^{2}-10 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}6(x-1)^{2}-4(y-1)^{2}-6{z}^{2}-12 & =0 \\\\ 6(x-1)^{2}-4(y-1)^{2}-6{z}^{2} & =12 \\\\ \\frac{(x-1)^{2}}{2}-\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{2} & =1 \\\\ \\frac{(y-1)^{2}}{3}+\\frac{{z}^{2}}{2}-\\frac{(x-1)^{2}}{2} & =-1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of two sheets centered at $(1,1,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36666/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f"] :knowledge-point/questions ["q-36666"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36107/selection/a0c8be148088f4737383abde385c3ac25592d1c33eee5402f519e6ab68df73aa" :answer/id #uuid "b9a265b7-5e8b-5e41-a759-c2783396ac01" :answer/type :answer.type/text :answer/value "A hyperbolic paraboloid centered at $(1,-1,0)$" :db/ensure [:answer/validate]} {:db/id "q-36107/selection/0d9f0e4faf05caaca07539c07a6617054a96c21acf074a2822e21256ae91ddeb" :answer/id #uuid "30b7142d-4b8f-5b30-9107-a6f3463948da" :answer/type :answer.type/text :answer/value "A hyperbolic paraboloid centered at $(-1,0,1)$" :db/ensure [:answer/validate]} {:db/id "q-36107/selection/d134ab772d1432d30484b13620e091cce0dbd3537835064a03cb755da4886103" :answer/id #uuid "bf681932-5e7e-54c1-96a4-14ef8981acee" :answer/type :answer.type/text :answer/value "An elliptic cone centered at $(1,-1,0)$" :db/ensure [:answer/validate]} {:db/id "q-36107/selection/5ac6bb915a0d6ae3042cf40a366873e754bf7f611c8daaafbe5a309de7684e7d" :answer/id #uuid "df31f0a9-3efb-5456-8830-e2bb6ac8da33" :answer/type :answer.type/text :answer/value "An elliptic paraboloid centered at $(-1,1,0)$" :db/ensure [:answer/validate]} {:db/id "q-36107/selection/7329bf99041c6d7efc29c1e823b8de346f7244a89871f97f0289ceba2590f901" :answer/id #uuid "65cfe060-6377-5908-beb3-f8d344eae1d7" :answer/type :answer.type/text :answer/value "An elliptic paraboloid centered at $(1,-1,0)$" :db/ensure [:answer/validate]} {:db/id "q-36107/selection" :answer-field/id #uuid "0a7a8c6f-9473-5089-bbc9-acffaeaec200" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36107/selection/7329bf99041c6d7efc29c1e823b8de346f7244a89871f97f0289ceba2590f901" :answer-field/choices ["q-36107/selection/a0c8be148088f4737383abde385c3ac25592d1c33eee5402f519e6ab68df73aa" "q-36107/selection/0d9f0e4faf05caaca07539c07a6617054a96c21acf074a2822e21256ae91ddeb" "q-36107/selection/d134ab772d1432d30484b13620e091cce0dbd3537835064a03cb755da4886103" "q-36107/selection/5ac6bb915a0d6ae3042cf40a366873e754bf7f611c8daaafbe5a309de7684e7d" "q-36107/selection/7329bf99041c6d7efc29c1e823b8de346f7244a89871f97f0289ceba2590f901"] :db/ensure [:answer-field/validate]} {:db/id "q-36107" :question/id #uuid "e6d1bbdf-cfcb-54f3-b97f-c63787cc6751" :question/math-academy-id "q-36107" :question/problem "Identify the surface $4{y}^{2}+8y+9{z}^{2}-5x+9=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}4{y}^{2}+8y+9{z}^{2}-5x+9 & =0 \\\\ 4({y}^{2}+2y)+9{z}^{2}-5x+9 & =0 \\\\ 4[(y+1)^{2}-1]+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}-4+9{z}^{2}-5x+9 & =0 \\\\ 4(y+1)^{2}+9{z}^{2}-5x+5 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}4(y+1)^{2}+9{z}^{2}-5x+5 & =0 \\\\ 4(y+1)^{2}+9{z}^{2} & =5(x-1) \\\\ \\frac{4(y+1)^{2}}{5}+\\frac{9{z}^{2}}{5} & =x-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(1,-1,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36107/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f"] :knowledge-point/questions ["q-36107"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164550/selection/10cb16b1aade27