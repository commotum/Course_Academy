er.type/text :answer/value "A hyperboloid" :db/ensure [:answer/validate]} {:db/id "q-164481/selection" :answer-field/id #uuid "c67bdacd-4bb3-59e8-9133-9f3a64ec4856" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164481/selection/d31ad39935ff9d2b0053e736fe3ac4359b7ccfba0b1fa70ac15346daf95df63f" :answer-field/choices ["q-164481/selection/d31ad39935ff9d2b0053e736fe3ac4359b7ccfba0b1fa70ac15346daf95df63f" "q-164481/selection/b5c859553965429f3e60ae7ec9147979d72e7f93854212d461d43b8e283eacfb" "q-164481/selection/86a636cda23021b65b366d430ba78a3ee94a31d03527a1692449b60075a6b41a" "q-164481/selection/3000e60ead649b0407aee4ed49d4da4caf2503629ff21f25e289c8552392f118" "q-164481/selection/821a899de875615f3c804d7554df15ce5b06d7c4e333e12de72752be95b6ee6e"] :db/ensure [:answer-field/validate]} {:db/id "q-164481" :question/id #uuid "540afee8-a0c6-54b4-b0fc-ff72c9dd4c07" :question/math-academy-id "q-164481" :question/problem "Identify the following surface: \n\n$$\n(x+2)^{2}-(y-1)^{2}=1,\\,-\\infty <z<\\infty \n$$" :question/worked-solution "Recall that the equation of a hyperbolic cylinder, whose axis of symmetry is the $z$-axis, is given by\n\n$$\n\\frac{{x}^{2}}{{a}^{2}}-\\frac{{y}^{2}}{{b}^{2}}=1,\n$$\n\nand a hyperbolic cylinder, whose axis of symmetry is parallel to the $z$-axis and passes through the point $({x}_{0},{y}_{0})$ in the $xy$-plane, is given by\n\n$$\n\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}=1.\n$$\n\nThus, our equation is a hyperbolic cylinder with the following parameters:\n\n$$\n({x}_{0},{y}_{0})=(-2,1),\\,a=b=1.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164481/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297"] :knowledge-point/questions ["q-164481"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164482/selection/83d0c1cc2343a5f9829a70cc8b62f87db675c6fe17b42b5e3bfcf66eef7fa6a5" :answer/id #uuid "311a5a34-8050-59f4-944f-d4a190db1480" :answer/type :answer.type/text :answer/value "A plane" :db/ensure [:answer/validate]} {:db/id "q-164482/selection/628e7448ea87cdc7a9c3226149674cafd04f4796d82e78e663c06e1a456ca93e" :answer/id #uuid "3e19584b-6891-5e55-beed-9aeac1672ea9" :answer/type :answer.type/text :answer/value "An elliptic paraboloid" :db/ensure [:answer/validate]} {:db/id "q-164482/selection/09b2974676dce93fed6dbe64a333fbbfc8214055b7f0c2e0dbe21d9a274b6979" :answer/id #uuid "0bddedb4-e640-5cd9-bf13-19e6c37e3766" :answer/type :answer.type/text :answer/value "A parabolic cylinder" :db/ensure [:answer/validate]} {:db/id "q-164482/selection/b5c859553965429f3e60ae7ec9147979d72e7f93854212d461d43b8e283eacfb" :answer/id #uuid "fd3b2057-8b72-575b-95c4-e450e6bd062f" :answer/type :answer.type/text :answer/value "A hyperbolic paraboloid" :db/ensure [:answer/validate]} {:db/id "q-164482/selection/86a636cda23021b65b366d430ba78a3ee94a31d03527a1692449b60075a6b41a" :answer/id #uuid "a0f944b3-4d3e-5be9-8724-d9f403115bbf" :answer/type :answer.type/text :answer/value "An elliptic cylinder" :db/ensure [:answer/validate]} {:db/id "q-164482/selection" :answer-field/id #uuid "9d8e1b59-1ea2-5f9f-a698-0e06cbae7775" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164482/selection/09b2974676dce93fed6dbe64a333fbbfc8214055b7f0c2e0dbe21d9a274b6979" :answer-field/choices ["q-164482/selection/83d0c1cc2343a5f9829a70cc8b62f87db675c6fe17b42b5e3bfcf66eef7fa6a5" "q-164482/selection/628e7448ea87cdc7a9c3226149674cafd04f4796d82e78e663c06e1a456ca93e" "q-164482/selection/09b2974676dce93fed6dbe64a333fbbfc8214055b7f0c2e0dbe21d9a274b6979" "q-164482/selection/b5c859553965429f3e60ae7ec9147979d72e7f93854212d461d43b8e283eacfb" "q-164482/selection/86a636cda23021b65b366d430ba78a3ee94a31d03527a1692449b60075a6b41a"] :db/ensure [:answer-field/validate]} {:db/id "q-164482" :question/id #uuid "0d873ba3-1de8-589c-8d59-c93b67e60172" :question/math-academy-id "q-164482" :question/problem "Identify the following surface: \n\n$$\n(x+2)^{2}=-y,\\,-\\infty <z<\\infty \n$$" :question/worked-solution "Recall that the equation of a parabolic cylinder, whose axis is the $z$-axis, is given by\n\n$$\n{x}^{2}=4py,\n$$\n\nand a parabolic cylinder, shifted ${x}_{0}$ along the x-axis and ${y}_{0}$ along the y-axis, is given by\n\n$$\n(x-{x}_{0})^{2}=4p(y-{y}_{0}).\n$$\n\nThus, our equation is a parabolic cylinder with the following parameters:\n\n$$\n({x}_{0},{y}_{0})=(-2,0),\\,p=-\\frac{1}{4}.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164482/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "9840265f-02bf-58fa-94fd-77fb970af297"] :knowledge-point/questions ["q-164482"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164548/selection/d30dbae2861e7fa330ca39df3600a1c778b3c141092891d02711cbb998a1f50d" :answer/id #uuid "2429412a-4b5a-5295-9b29-91029a407806" :answer/type :answer.type/text :answer/value "An elliptic cylinder whose axis is the $x$-axis" :db/ensure [:answer/validate]} {:db/id "q-164548/selection/5d26a032caa8ba49461d9d7f6280d6632e1d97541d8ce79cf920ecfdc0a9aa84" :answer/id #uuid "3181e6ff-b563-5a5c-b346-62f0602c6fdb" :answer/type :answer.type/text :answer/value "A parabolic cylinder whose axis is the $y$-axis" :db/ensure [:answer/validate]} {:db/id "q-164548/selection/4db350024b3ae4c51ba72697d0eb5388148c54710feb81a618cc7a559fc08f33" :answer/id #uuid "0e7b5d5d-f2d8-532a-8fad-c23ed2e55342" :answer/type :answer.type/text :answer/value "A parabolic cylinder whose axis is the $x$-axis" :db/ensure [:answer/validate]} {:db/id "q-164548/selection/a8e9ccb72fa8aa5b4d897d61c2785eebf9d1312274185eded2dbaac3fc25e027" :answer/id #uuid "2836790f-a379-599b-a480-259122e64e76" :answer/type :answer.type/text :answer/value "A couple of planes" :db/ensure [:answer/validate]} {:db/id "q-164548/selection/e2fd09c5b29672a308e42fbcdd5fe487b447524c52e98f2eb8e70d862f842f