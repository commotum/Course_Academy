30d0a2cd81ff5f3e3148816a19c9132e8845d1438cfd52af7bb9303c320"] :db/ensure [:answer-field/validate]} {:db/id "q-164550" :question/id #uuid "eb9dbbc2-96e4-50d8-8192-3c9948666874" :question/math-academy-id "q-164550" :question/problem "Identify the surface ${x}^{2}-{y}^{2}+2{z}^{2}-2y-8z-9=0.$" :question/worked-solution "First, we complete the square in the $y$ and $z$ terms:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2}+2{z}^{2}-2y-8z-9 & =0 \\\\ {x}^{2}-({y}^{2}+2y)+2({z}^{2}-4z)-9 & =0 \\\\ {x}^{2}-(y+1)^{2}+1+2[(z-2)^{2}-4]-9 & =0 \\\\ {x}^{2}-(y+1)^{2}+1+2(z-2)^{2}-8-9 & =0 \\\\ {x}^{2}-(y+1)^{2}+2(z-2)^{2}-16 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}{x}^{2}-(y+1)^{2}+2(z-2)^{2}-16 & =0 \\\\ {x}^{2}-(y+1)^{2}+2(z-2)^{2} & =16 \\\\ \\frac{{x}^{2}}{16}-\\frac{(y+1)^{2}}{16}+\\frac{(z-2)^{2}}{8} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of one sheet centered at $(0,-1,2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164550/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f"] :knowledge-point/questions ["q-164550"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36111/selection/0f42803538b7c395920a822c8182e19575b43500bbcc919a4a22276766067910" :answer/id #uuid "b366c570-9014-550e-a72f-3960455399e0" :answer/type :answer.type/text :answer/value "An elliptic paraboloid centered at $(1,-2,0)$" :db/ensure [:answer/validate]} {:db/id "q-36111/selection/91efec4d85a6861cdcb19808838b53e9167b856c600039eace5673d5f05e387c" :answer/id #uuid "f9ce7fa3-9ae9-5fe5-890c-1c16313bff5b" :answer/type :answer.type/text :answer/value "A hyperbolic paraboloid centered at $(0,-2,1)$" :db/ensure [:answer/validate]} {:db/id "q-36111/selection/171861b98355511eadb976aa8d78325799a7d4605fc625f049573b3d4e1d4909" :answer/id #uuid "237e2ada-4aa2-5b6a-9d36-42e6999d497b" :answer/type :answer.type/text :answer/value "An elliptic cone centered at $(0,-2,1)$" :db/ensure [:answer/validate]} {:db/id "q-36111/selection/4c0eed727a0dc84bf73b7f3736edfa9a03f57ce91063a14b6a4951c39bb13173" :answer/id #uuid "1aeca64a-d410-5b41-9b0e-b7b02b5a4fe4" :answer/type :answer.type/text :answer/value "An elliptic paraboloid centered at $(0,-2,1)$" :db/ensure [:answer/validate]} {:db/id "q-36111/selection/52fa66aa5beabb42c569a9e0991ab3a64b06690b9af95e14d9614883b67ecca1" :answer/id #uuid "5b8cdd42-126c-5ad9-a783-820f95c9fced" :answer/type :answer.type/text :answer/value "An elliptic cone centered at $(1,-2,0)$" :db/ensure [:answer/validate]} {:db/id "q-36111/selection" :answer-field/id #uuid "d6b94f7e-42c4-5308-b3a4-d0d4634e1410" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36111/selection/4c0eed727a0dc84bf73b7f3736edfa9a03f57ce91063a14b6a4951c39bb13173" :answer-field/choices ["q-36111/selection/0f42803538b7c395920a822c8182e19575b43500bbcc919a4a22276766067910" "q-36111/selection/91efec4d85a6861cdcb19808838b53e9167b856c600039eace5673d5f05e387c" "q-36111/selection/171861b98355511eadb976aa8d78325799a7d4605fc625f049573b3d4e1d4909" "q-36111/selection/4c0eed727a0dc84bf73b7f3736edfa9a03f57ce91063a14b6a4951c39bb13173" "q-36111/selection/52fa66aa5beabb42c569a9e0991ab3a64b06690b9af95e14d9614883b67ecca1"] :db/ensure [:answer-field/validate]} {:db/id "q-36111" :question/id #uuid "3aef9826-cee6-5c7b-99d8-ae9e9ec092cd" :question/math-academy-id "q-36111" :question/problem "Identify the surface ${x}^{2}+3{y}^{2}+12y-z+13=0.$" :question/worked-solution "First, we complete the square in the $y$ term:\n\n$$\n\\begin{aligned}{x}^{2}+3{y}^{2}+12y-z+13 & =0 \\\\ {x}^{2}+3({y}^{2}+4y)-z+13 & =0 \\\\ {x}^{2}+3[(y+2)^{2}-4]-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-12-z+13 & =0 \\\\ {x}^{2}+3(y+2)^{2}-z+1 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}{x}^{2}+3(y+2)^{2}-z+1 & =0 \\\\ {x}^{2}+3(y+2)^{2} & =z-1.\\end{aligned}\n$$\n\nThis is the equation of an elliptic paraboloid centered at $(0,-2,1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36111/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f"] :knowledge-point/questions ["q-36111"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-12559"] :question/problem "Identify the surface $z -1 = \\dfrac{(x-3)^2}{4} - \\dfrac{(y+2)^2}4.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2},\n$$\n\nand a hyperbolic paraboloid centered at $(x_0,y_0,z_0)$ is given by\n\n$$\nz - z_0 = \\dfrac{(x-x_0)^2}{a^2}-\\dfrac{(y-y_0)^2}{b^2}.\n$$\n\nThus, our equation is a hyperbolic paraboloid with the following parameters:\n\n$$\n(x_0,y_0,z_0) = (3, -2, 1), \\quad a= b=2.\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-12560"] :question/problem "Identify the surface $x = \\dfrac{y^2}{4} - 4z^2.$" :question/worked-solution "Recall that the equation of a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $z$-axis is given by\n\n$$\nz = \\dfrac{x^2}{a^2}-\\dfrac{y^2}{b^2}.\n$$\n\nThus, a hyperbolic paraboloid centered at $O$ whose axis of symmetry is the $\\boldsymbol x$**-axis** is given by\n\n$$\nx = \\dfrac{y^2}{b^2} - \\dfrac{z^2}{c^2}.\n$$\n\nTherefore, our equation is a hyperbolic paraboloid whose axis of symmetry is the $x$-axis, and $b=2, \\: c=\\dfrac 12.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-8313"] :question/problem "Identify the surface $-x^2 + z^2 + 2x + y=0.$" :question/worked-solution "First, we complete the square in the $x$ term:\n\n$$\n\\begin{aligned}-{x}^{2}+{z}^{2}+2x+y & =0 \\\\ -({x}^{2}-2x)+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+1+{z}^{2}+y & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}-(x-1)^{2}+1+{z}^{2}+y & =0 \\\\ -(x-1)^{2}+{z}^{2} & =-y-1 \\\\ (x-1)^{2}-{z}^{2} & =y+1.\\end{aligned}\n$$\n\nThis is the equation of a hyperbolic paraboloid centered at $(1, -1, 0).$" :db/ensure [:question/validate]}]
