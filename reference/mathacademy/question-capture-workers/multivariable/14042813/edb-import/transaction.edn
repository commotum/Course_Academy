1244fbf11eb36" "q-164555/selection/52fa66aa5beabb42c569a9e0991ab3a64b06690b9af95e14d9614883b67ecca1" "q-164555/selection/0d5a4b9bd49569a5a52ce65e9b67c9f44298bdff218ba866b529b18c2a30d401" "q-164555/selection/640cd15e52d580bddb65008d2af16586a6af6a42fb31244deb0989511c35d401"] :db/ensure [:answer-field/validate]} {:db/id "q-164555" :question/id #uuid "84fd9eec-1cf5-594c-8917-00bf240277f1" :question/math-academy-id "q-164555" :question/problem "Identify the surface ${x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11=0.$" :question/worked-solution "First, we complete the square in the $x$ and $y$ terms:\n\n$$\n\\begin{aligned}{x}^{2}+5{y}^{2}+{z}^{2}-2x+20y+11 & =0 \\\\ ({x}^{2}-2x)+5({y}^{2}+4y)+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5([y+2)^{2}-4]+{z}^{2}+11 & =0 \\\\ (x-1)^{2}-1+5(y+2)^{2}-20+{z}^{2}+11 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0\\end{aligned}\n$$\n\nNow, by rearranging, we get the equation\n\n$$\n\\begin{aligned}(x-1)^{2}+5(y+2)^{2}+{z}^{2}-10 & =0 \\\\ (x-1)^{2}+5(y+2)^{2}+{z}^{2} & =10 \\\\ \\frac{(x-1)^{2}}{10}+\\frac{(y+2)^{2}}{2}+\\frac{{z}^{2}}{10} & =1.\\end{aligned}\n$$\n\nThis is the equation of an ellipsoid centered at $(1,-2,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164555/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "549870ce-a18a-5a94-a9ea-f3de72aaac1f"] :knowledge-point/questions ["q-164555"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36666/selection/583dc46e6bd81241e2a6a4577d7557f9381f2d16d4fc6c4a5c6abeb061fe0566" :answer/id #uuid "039762d1-d0ba-5737-b000-352cfdcdb9f1" :answer/type :answer.type/text :answer/value "A hyperboloid of one sheet centered at $(1,1,0)$" :db/ensure [:answer/validate]} {:db/id "q-36666/selection/51fcec58899b3978653eb0045299918b3723a56c8c3d19ef4e770b3aee3104f1" :answer/id #uuid "18f2ba50-156e-5cdd-9a51-10f6077523f4" :answer/type :answer.type/text :answer/value "A hyperboloid of one sheet centered at $(1,-1,0)$" :db/ensure [:answer/validate]} {:db/