gned}{x}^{2}-(y+1)^{2}+2(z-2)^{2}-16 & =0 \\\\ {x}^{2}-(y+1)^{2}+2(z-2)^{2} & =16 \\\\ \\frac{{x}^{2}}{16}-\\frac{(y+1)^{2}}{16}+\\frac{(z-2)^{2}}{8} & =1.\\end{aligned}\n$$\n\nThis is the equation of a hyperboloid of one sheet centered at $(0,-1,2).$" 13194139534894 true] [17592186318055 1000 #edb/ref 17592186318056 13194139534894 true] [17592186318055 1000 #edb/ref 17592186318057 13194139534894 true] [17592186318055 1000 #edb/ref 17592186318058 13194139534894 true] [17592186318055 1000 #edb/ref 17592186318059 13194139534894 true] [17592186318055 1000 #edb/ref 17592186318060 13194139534894 true] [17592186318055 1040 #edb/ref 17592186045450 13194139534894 true] [17592186318055 1041 "selection" 13194139534894 true] [17592186318055 1104 #edb/ref 17592186318059 13194139534894 true] [17592186318055 1110 #uuid "e224170f-25b6-5699-b9ab-a49272b99b7b" 13194139534894 true] [17592186318056 1034 "A hyperboloid of two sheets centered at $(0,-1,-2)$" 13194139534894 true] [17592186318056 1103 #edb/ref 17592186045454 13194139534894 true] [17592186318056 1111 #uuid "95d20a1c-0df8-56ec-8726-faa627d9a2a8" 13194139534894 true] [17592186318057 1034 "A ellipsoid centered at $(0,-1,2)$" 13194139534894 true] [17592186318057 1103 #edb/ref 17592186045454 13194139534894 true] [17592186318057 1111 #uuid "93630aef-9a4c-5cf6-8c87-3c3a1311145f" 13194139534894 true] [17592186318058 1034 "A hyperboloid of one sheet centered at $(0,1,2)$" 13194139534894 true] [17592186318058 1103 #edb/ref 17592186045454 13194139534894 true] [17592186318058 1111 #uuid "6da1efea-911b-5e83-9255-81452bcf43dd" 13194139534894 true] [17592186318059 1034 "A hyperboloid of one sheet centered at $(0,-1,2)$" 13194139534894 true] [17592186318059 1103 #edb/ref 17592186045454 13194139534894 true] [17592186318059 1111 #uuid "4a2eeed0-46b5-5cd3-b77e-798176dd1f50" 13194139534894 true] [17592186318060 1034 "A hyperboloid of two sheets centered at $(0,-1,2)$" 13194139534894 true] [17592186318060 1103 #edb/ref 17592186045454 131941395