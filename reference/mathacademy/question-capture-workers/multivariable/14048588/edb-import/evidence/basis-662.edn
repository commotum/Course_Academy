#{[{:db/id #edb/ref 17592186275480 :knowledge-point/_questions [{:knowledge-point/id #uuid "a5028940-be34-56b7-8947-6129252f06a7" :knowledge-point/title "Determining the Center and Lengths of the Major and Minor Axes Given the Equation of an Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "44631735-3ce3-5d02-8e1c-c7e8113aceb7" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-2)" :db/id #edb/ref 17592186275482} {:answer/id #uuid "7b0de19a-3ff6-5c10-adce-889cfd8ee0b4" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,2)" :db/id #edb/ref 17592186275483} {:answer/id #uuid "26aa4646-9885-59f5-bda6-72c9d726a578" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186275484} {:answer/id #uuid "3e015584-74f9-527e-be25-9a2800b3a9fd" :answer/type {:db/ident :answer.type/math} :answer/value "(3,3)" :db/id #edb/ref 17592186275485} {:answer/id #uuid "1b817f5c-17e3-595f-8df0-0f456f1f8221" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-3)" :db/id #edb/ref 17592186275486}] :answer-field/correct {:answer/id #uuid "26aa4646-9885-59f5-bda6-72c9d726a578" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,3)" :db/id #edb/ref 17592186275484} :answer-field/id #uuid "644a796f-4ce0-5438-bc9e-9d0f8fbbca33" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186275481}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ac71fe37-e4e6-5f04-833b-dc05c051078d" :question/math-academy-id "q-115308" :question/problem "What is the center of the ellipse $\\frac{(x+2)^{2}}{3}+\\frac{(y-3)^{2}}{9}=1?$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=-2$ and $k=3,$ so the center is located at $(-2,3).$"}] [{:db/id #edb/ref 17592186275487 :knowledge-point/_questions [{:knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656" :knowledge-point/title "Determining the Equation of a Tall Ellipse"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0c833d29-7783-5eba-b328-e441a01cc990" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(x-5)^2}{4}+\\frac{(y-2)^2}{25}" :db/id #edb/ref 17592186275489}] :answer-field/correct {:answer/id #uuid "0c833d29-7783-5eba-b328-e441a01cc990" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{(x-5)^2}{4}+\\frac{(y-2)^2}{25}" :db/id #edb/ref 17592186275489} :answer-field/id #uuid "ba6f87da-c319-57a2-ad8a-fe94131112fe" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186275488}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5cc9c897-95e9-5696-af7c-76e6d5890aee" :question/math-academy-id "q-278312" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13971771/assets/0405790e07a49ddb62c4444ba13669ee74e6b7c37d5c2949a244246b8d54b65a.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(5,2),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=5.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-5)^{2}}{{2}^{2}}+\\frac{(y-2)^{2}}{{5}^{2}} & =1 \\\\ \\frac{(x-5)^{2}}{4}+\\frac{(y-2)^{2}}{25} & =1.\\end{aligned}\n$$"}]}
