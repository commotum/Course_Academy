[{:db/id "q-115294/selection/34d3b172023fa10b23f1846293392489b20bacb4535e45bf82d2a8840b0e5f82" :answer/id #uuid "fc5a24c5-7fda-5555-990e-858e8a177338" :answer/type :answer.type/math :answer/value "\\frac{(x-2)^{2}}{16}+\\frac{(y-4)^{2}}{4}=1" :db/ensure [:answer/validate]} {:db/id "q-115294/selection/4190b45ad2f10797f165381bc4b3e4bec6184547387a737bff72c3da5650cbdb" :answer/id #uuid "c690cc91-8fdf-5bd4-b6da-b259ed879530" :answer/type :answer.type/math :answer/value "\\frac{(x+4)^{2}}{4}+\\frac{(y+2)^{2}}{16}=1" :db/ensure [:answer/validate]} {:db/id "q-115294/selection/c7e89808b19cd6b954f84643f2a45a9a03fa66ed77a6bbe02e23e55c0e0ebb6e" :answer/id #uuid "e9b90a1b-720b-51ee-b3ba-703b3f769331" :answer/type :answer.type/math :answer/value "\\frac{(x-2)^{2}}{4}+\\frac{(y-4)^{2}}{8}=1" :db/ensure [:answer/validate]} {:db/id "q-115294/selection/1f57778689d7e33ee4dc36e9c65b2062aa94320a85964b3f0b43f4fb54ad9eee" :answer/id #uuid "ee626abc-6596-5788-8c21-712d77893dc6" :answer/type :answer.type/math :answer/value "\\frac{(x-2)^{2}}{2}+\\frac{(y-4)^{2}}{4}=1" :db/ensure [:answer/validate]} {:db/id "q-115294/selection/32356edfe6176e051dcb1c31f9e06d3058014e7c3dcfd4b397b56e427aeb221b" :answer/id #uuid "9ad3dd6d-ffa1-5573-8019-cf0c2c7ce21c" :answer/type :answer.type/math :answer/value "\\frac{(x-2)^{2}}{4}+\\frac{(y-4)^{2}}{16}=1" :db/ensure [:answer/validate]} {:db/id "q-115294/selection" :answer-field/id #uuid "d0562518-004f-5f3f-88fe-c6bb0947eace" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-115294/selection/32356edfe6176e051dcb1c31f9e06d3058014e7c3dcfd4b397b56e427aeb221b" :answer-field/choices ["q-115294/selection/34d3b172023fa10b23f1846293392489b20bacb4535e45bf82d2a8840b0e5f82" "q-115294/selection/4190b45ad2f10797f165381bc4b3e4bec6184547387a737bff72c3da5650cbdb" "q-115294/selection/c7e89808b19cd6b954f84643f2a45a9a03fa66ed77a6bbe02e23e55c0e0ebb6e" "q-115294/selection/1f57778689d7e33ee4dc36e9c65b2062aa94320a85964b3f0b43f4fb54ad9eee" "q-115294/selection/32356edfe6176e051dcb1c31f9e06d3058014e7c3dcfd4b397b56e427aeb221b"] :db/ensure [:answer-field/validate]} {:db/id "q-115294" :question/id #uuid "f3fa3198-e19c-54f1-b75b-5eecd6189fe5" :question/math-academy-id "q-115294" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048588/assets/bdfab2c7bdab1c3b360a0be55507ace6198b005f944fb8c7f2928bb5943d337c.png)\n\nWhat is the equation of the ellipse given above?" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(2,4),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-2)^{2}}{{2}^{2}}+\\frac{(y-4)^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x-2)^{2}}{4}+\\frac{(y-4)^{2}}{16} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-115294/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656"] :knowledge-point/questions ["q-115294"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278251/field-1/ba48a39f319bd171f2e3c80c0c90b93cfc42f537ecc374834bbf7aa469eab1e2" :answer/id #uuid "bd06eb0e-ed61-5a4c-a567-e0827720d9af" :answer/type :answer.type/math :answer/value "\\frac{(x-4)^2}{9}+\\frac{(y-1)^2}{16}" :db/ensure [:answer/validate]} {:db/id "q-278251/field-1" :answer-field/id #uuid "613b492a-041c-5243-86a8-59377273798d" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278251/field-1/ba48a39f319bd171f2e3c80c0c90b93cfc42f537ecc374834bbf7aa469eab1e2" :answer-field/choices ["q-278251/field-1/ba48a39f319bd171f2e3c80c0c90b93cfc42f537ecc374834bbf7aa469eab1e2"] :db/ensure [:answer-field/validate]} {:db/id "q-278251" :question/id #uuid "7ac2a839-75e5-5f5a-83ab-b3cd73d92635" :question/math-academy-id "q-278251" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048588/assets/6bb7a8dc9b34c03e5456b84b843c8975aac8ec8f09135fe9069693febc24ba78.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :question/worked-solution "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(4,1),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-4)^{2}}{{3}^{2}}+\\frac{(y-1)^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x-4)^{2}}{9}+\\frac{(y-1)^{2}}{16} & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278251/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "57e19ee3-db9a-58d7-8ca3-4e8801aee656"] :knowledge-point/questions ["q-278251"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278312/field-1/71906bfe004eaaf8099bbe4c3dee420cae3fd78e71d38fe6ae25e5e55702f3bd" :answer/id #uuid "2a6b6e7a-00d7-55ed-a3d4-67284d336346" :answer/type :answer.type/math :answer/value "\\frac{(x-5)^2}{25}+\\frac{(y-2)^2}{4}" :db/ensure [:answer/validate]} {:db/id 17592186275488 :answer-field/choices ["q-278312/field-1/71906bfe004eaaf8099bbe4c3dee420cae3fd78e71d38fe6ae25e5e55702f3bd"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-278312"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14048588/assets/0405790e07a49ddb62c4444ba13669ee74e6b7c37d5c2949a244246b8d54b65a.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" :db/ensure [:question/validate]}]
