}^{2}+4{y}^{2}=16\\,}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/state.json" "file_sha256" "5579d886d8cbf4dc8afab9f4e3d2db81c23d80d306fb36c5b3c2f178f2e0b801"} {"question" "q-161590" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/activity-metadata.json" "file_sha256" "8e9e0af57d11aa61b8e1486c4935f1be8908aaf5f8d0cdd39c79afc9a8917909"} {"question" "q-161590" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/state.json" "file_sha256" "5579d886d8cbf4dc8afab9f4e3d2db81c23d80d306fb36c5b3c2f178f2e0b801"} {"question" "q-161590" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{x}^{2}+4{y}^{2}<16"] ["math" "{x}^{2}+4{y}^{2}=16"] ["math" "{x}^{2}+4{y}^{2}>16"] ["math" "{x}^{2}+4{y}^{2}\\ge 16"] ["math" "{x}^{2}+4{y}^{2}\\le 16"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/state.json" "file_sha256" "5579d886d8cbf4dc8afab9f4e3d2db81c23d80d306fb36c5b3c2f178f2e0b801"} {"question" "q-161590" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{x}^{2}+4{y}^{2}=16"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/state.json" "file_sha256" "5579d886d8cbf4dc8afab9f4e3d2db81c23d80d306fb36c5b3c2f178f2e0b801"} {"question" "q-161599" "field" nil "attribute" "question/problem" "value" "Consider the set $A,$ defined by \n\n$$\nA={(x,y)\\in {R}^{2}\\,:\\,-2y\\ge {x}^{2}}.\n$$\n\nThe boundary of $A$ is given by\n\n$$\n∂A={(x,y)\\in {R}^{2}\\,:\\,}.\n$$\n\nWhat is the missing expression?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/state.json" "file_sha256" "5579d886d8cbf4dc8afab9f4e3d2db81c23d80d306fb36c5b3c2f178f2e0b801"} {"question" "q-161599" "field" nil "attribute" "question/worked-solution" "value" "The boundary of a set $A,$ denoted $∂A,$ is the set that contains all the boundary points of $A.$\n\nThe set $A$ and its boundary $∂A$ are shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/assets/0fc95ee69ce7121c0cf8ae68029b135d9667f50275227d141f1d979f85408859.png)\n\nFrom the diagram, the boundary points of $A$ lie on the  parabola $-2y={x}^{2}.$ \n\nTherefore,  \n\n$$\n∂A={(x,y)\\in {R}^{2}\\,:\\,-2y={x}^{2}\\,}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/state.json" "file_sha256" "5579d886d8cbf4dc8afab9f4e3d2db81c23d80d306fb36c5b3c2f178f2e0b801"} {"question" "q-161599" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/activity-metadata.json" "file_sha256" "8e9e0af57d11aa61b8e1486c4935f1be8908aaf5f8d0cdd39c79afc9a8917909"} {"question" "q-161599" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041552/state.json" "file_sha256" "5579d886d8cbf4dc8afab9f4e3d2db81c23d80d306fb36c5b3c2f178f2e0b801"} {"question" "q-161599" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2y<{x}^{2}"] ["math" "-2y={x}^{2}"] ["math" "-2y>{x}^{2}"] ["math" "-2y\\ge {