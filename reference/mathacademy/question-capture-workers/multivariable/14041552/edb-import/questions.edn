}$.\nWhat is the missing expression?"}] [{:db/id #edb/ref 17592186193039 :knowledge-point/_questions [{:knowledge-point/id #uuid "a024c46e-0374-5d03-b895-eb754ff7ad97" :knowledge-point/title "Identifying True Statements Regarding Interiors and Boundaries of Sets"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9ce0f030-b4c1-57a9-9722-3cd31e13688f" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186191084} {:answer/id #uuid "e87713fa-7bfd-5c4e-a4f4-e7924ad8d147" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186191085} {:answer/id #uuid "031a8edc-724f-5134-b433-606b44e5f4eb" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186191086} {:answer/id #uuid "17616b13-a46d-58b0-bc4e-cc01d95576bb" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186191087} {:answer/id #uuid "459ba8c5-ae94-5c84-afdf-ba80e4ecdae6" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186191088}] :answer-field/correct {:answer/id #uuid "031a8edc-724f-5134-b433-606b44e5f4eb" :answer/type {:db/ident :answer.type/text} :answer/value "I, II, and III" :db/id #edb/ref 17592186191086} :answer-field/id #uuid "e55d3b07-e262-5483-8899-20d53781acb0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186191083}] :question/id #uuid "68256c62-7faf-5747-9e8c-b2c67a0a95a2" :question/math-academy-id "q-161444" :question/problem "Consider the set $A$, defined by\n$A = {(x, y) ∈ R^{2}: 4x^{2} + y^{2} \\ge 4}$.\n\nWhich of the following statements are true?\n\n1. $intA∩∂A = ∅$\n2. $A - ∂A = intA$\n3. $∂A⊂A$"}]}
