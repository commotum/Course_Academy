[{:db/id "q-71573/selection/9b2f2b52aabb402e0316bd27c83eac5be46d7c6ae6f6e2aa905a76e7ea5dadbf" :answer/id #uuid "94f795c5-78ce-522a-a8f7-6729f7c24ce6" :answer/type :answer.type/math :answer/value "z=\\frac{{x}^{2}}{1/9}+{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71573/selection/f85d8a916dbbf6bc1638bc2d1c92405dc2e37b634df6dad3ff087d10c84968ab" :answer/id #uuid "384756a4-d176-5ddb-b562-298a0a944b10" :answer/type :answer.type/math :answer/value "{z}^{2}={x}^{2}+\\frac{{y}^{2}}{9}" :db/ensure [:answer/validate]} {:db/id "q-71573/selection/eed712b1a349a9d30d1eaaa3310372d2bd4c3f2438d018ba1cfa2dd3ed3a1cf4" :answer/id #uuid "cffc2cb4-edb9-5761-8ea4-e7b35b895e3a" :answer/type :answer.type/math :answer/value "z={x}^{2}+{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71573/selection/e86ca9bb3b01c34f9efe0457fc2c0419bcaa6f3921591f31657839ed4cb403a1" :answer/id #uuid "f4c1655c-fbf9-5a01-8590-7fe28a37739b" :answer/type :answer.type/math :answer/value "{z}^{2}={x}^{2}+\\frac{{y}^{2}}{1/9}" :db/ensure [:answer/validate]} {:db/id "q-71573/selection/67b958a251730b024586d12c243b91d76b0199089f16b1f8cae409b0f4749a18" :answer/id #uuid "5e4fe4e4-ed56-5979-ad5e-c45a46888634" :answer/type :answer.type/math :answer/value "z=\\frac{{x}^{2}}{9}+{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71573/selection" :answer-field/id #uuid "ba2919c4-256e-5c44-8e50-e71a6e9dceb4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71573/selection/9b2f2b52aabb402e0316bd27c83eac5be46d7c6ae6f6e2aa905a76e7ea5dadbf" :answer-field/choices ["q-71573/selection/9b2f2b52aabb402e0316bd27c83eac5be46d7c6ae6f6e2aa905a76e7ea5dadbf" "q-71573/selection/f85d8a916dbbf6bc1638bc2d1c92405dc2e37b634df6dad3ff087d10c84968ab" "q-71573/selection/eed712b1a349a9d30d1eaaa3310372d2bd4c3f2438d018ba1cfa2dd3ed3a1cf4" "q-71573/selection/e86ca9bb3b01c34f9efe0457fc2c0419bcaa6f3921591f31657839ed4cb403a1" "q-71573/selection/67b958a251730b024586d12c243b91d76b0199089f16b1f8cae409b0f4749a18"] :db/ensure [:answer-field/validate]} {:db/id "q-71573" :question/id #uuid "765d8808-dc7f-55d5-b2be-2ea7a5ecc1b1" :question/math-academy-id "q-71573" :question/problem "For the function $f(x,y,z)=9{x}^{2}+{y}^{2}-z,$ find the equation of the level surface $f(x,y,z)=0.$" :question/worked-solution "Recall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=0.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ 9{x}^{2}+{y}^{2}-z & =0 \\\\ z & =9{x}^{2}+{y}^{2} \\\\ z & =\\frac{{x}^{2}}{1/9}+{y}^{2}\\end{aligned}\n$$\n\nTherefore, the level surface for $c=0$ is the elliptic paraboloid $z=\\frac{{x}^{2}}{1/9}+{y}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71573/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5e0a37b-23ad-5e79-a175-378b88640ba4"] :knowledge-point/questions ["q-71573"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71572/selection/24447d81c126f88a7c875895c2a0a01331825ff374698fa9572754d1feb073e6" :answer/id #uuid "abd64aef-cae7-5f36-bf09-c71b429f26bd" :answer/type :answer.type/math :answer/value "z={y}^{2}-{x}^{2}+4" :db/ensure [:answer/validate]} {:db/id "q-71572/selection/2e1f2c927b32572d8782744e3518e176704e71878d86ccb07858c7f7f777afde" :answer/id #uuid "bd26dcf1-58f9-5b44-ae27-7a90c667017d" :answer/type :answer.type/math :answer/value "z={y}^{2}-{x}^{2}-2" :db/ensure [:answer/validate]} {:db/id "q-71572/selection/dd71e57da969d28295014498030b47fb7b80f77017a80b6bcd20e746013c62fd" :answer/id #uuid "3135899f-3d87-529c-bdac-3958c0ca17b1" :answer/type :answer.type/math :answer/value "z={y}^{2}+{x}^{2}-4" :db/ensure [:answer/validate]} {:db/id "q-71572/selection/7dc4d32a61dfa0aad5fb5d614680e47fdea53d3b615abe53e39a0f82022f7a07" :answer/id #uuid "1ea14d98-a14f-533e-af7b-121619326b36" :answer/type :answer.type/math :answer/value "z={y}^{2}+{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71572/selection/30fb8a902e06df5c66bd3a634425006c9ca9c08c547efbdffe9764263ef832b7" :answer/id #uuid "edd36415-7920-5cf1-9377-c70f903f4908" :answer/type :answer.type/math :answer/value "z={y}^{2}-{x}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71572/selection" :answer-field/id #uuid "57c88a73-db4d-5bf5-904e-d08eb84dfbbc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71572/selection/30fb8a902e06df5c66bd3a634425006c9ca9c08c547efbdffe9764263ef832b7" :answer-field/choices ["q-71572/selection/24447d81c126f88a7c875895c2a0a01331825ff374698fa9572754d1feb073e6" "q-71572/selection/2e1f2c927b32572d8782744e3518e176704e71878d86ccb07858c7f7f777afde" "q-71572/selection/dd71e57da969d28295014498030b47fb7b80f77017a80b6bcd20e746013c62fd" "q-71572/selection/7dc4d32a61dfa0aad5fb5d614680e47fdea53d3b615abe53e39a0f82022f7a07" "q-71572/selection/30fb8a902e06df5c66bd3a634425006c9ca9c08c547efbdffe9764263ef832b7"] :db/ensure [:answer-field/validate]} {:db/id "q-71572" :question/id #uuid "8672825f-d6f0-5dee-8831-9d4f462607ae" :question/math-academy-id "q-71572" :question/problem "For the function $f(x,y,z)={x}^{2}-{y}^{2}+z-2,$ find the equation of the level surface $f(x,y,z)=-2.$" :question/worked-solution "Recall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=-2.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {x}^{2}-{y}^{2}+z-2 & =-2 \\\\ z & ={y}^{2}-{x}^{2}\\end{aligned}\n$$\n\nTherefore, the level surface for $c=-2$ is the hyperbolic paraboloid $z={y}^{2}-{x}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71572/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5e0a37b-23ad-5e79-a175-378b88640ba4"] :knowledge-point/questions ["q-71572"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129183/selection/78ba13807c99d8cee5ecf07fa508e50531196f49ec9e92cc5ecd0c6508de02b5" :answer/id #uuid "9f567d29-a97c-59ba-8814-3e87ae2cf680" :answer/type :answer.type/math :answer/value "z=x-y" :db/ensure [:answer/validate]} {:db/id "q-129183/selection/93d2cb84f49fb5093f89836a8f5f72919812dc26e8e01a8b0e8973d242d1625b" :answer/id #uuid "c18af71a-e98a-597c-8338-7bc77fbabff3" :answer/type :answer.type/math :answer/value "z=\\frac{1}{x+y}" :db/ensure [:answer/validate]} {:db/id "q-129183/selection/221817cdf2136a6b30a0e753651d4421d869260479b17a4229262726ff2c9718" :answer/id #uuid "557840b2-1c87-5581-b70e-c674e75cdfba" :answer/type :answer.type/math :answer/value "z=y-x" :db/ensure [:answer/validate]} {:db/id "q-129183/selection/91b9031152425e98c769af4a1dd99bbe6d04aed8eaad65e8dda6e16c4b3c6868" :answer/id #uuid "e7dfe23a-f83b-5846-96e4-4e0f41451d15" :answer/type :answer.type/math :answer/value "z=x+y" :db/ensure [:answer/validate]} {:db/id "q-129183/selection/e6b4ee34b73d716be64f10ceb1f50ee7f2677f46f81a3bd130d0dc42d5605bbb" :answer/id #uuid "1833156f-bc74-5510-8e51-c5f6d5fde277" :answer/type :answer.type/math :answer/value "z=\\frac{1}{x-y}" :db/ensure [:answer/validate]} {:db/id "q-129183/selection" :answer-field/id #uuid "df24c305-ab2b-5f19-9ab0-d5f020dbdd4c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129183/selection/221817cdf2136a6b30a0e753651d4421d869260479b17a4229262726ff2c9718" :answer-field/choices ["q-129183/selection/78ba13807c99d8cee5ecf07fa508e50531196f49ec9e92cc5ecd0c6508de02b5" "q-129183/selection/93d2cb84f49fb5093f89836a8f5f72919812dc26e8e01a8b0e8973d242d1625b" "q-129183/selection/221817cdf2136a6b30a0e753651d4421d869260479b17a4229262726ff2c9718" "q-129183/selection/91b9031152425e98c769af4a1dd99bbe6d04aed8eaad65e8dda6e16c4b3c6868" "q-129183/selection/e6b4ee34b73d716be64f10ceb1f50ee7f2677f46f81a3bd130d0dc42d5605bbb"] :db/ensure [:answer-field/validate]} {:db/id "q-129183" :question/id #uuid "fe136611-dc75-58d5-ad80-3b8bced294da" :question/math-academy-id "q-129183" :question/problem "For the function $f(x,y,z)=\\frac{z}{x-y},$ find the equation of the level surface $f(x,y,z)=-1.$" :question/worked-solution "The level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=-1.$ So, we have\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{z}{x-y} & =-1 \\\\ z & =y-x.\\end{aligned}\n$$\n\nTherefore, the level surface for $c=-1$ is the plane $z=y-x.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129183/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5e0a37b-23ad-5e79-a175-378b88640ba4"] :knowledge-point/questions ["q-129183"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129186/selection/827f6191474673ca0ad7bf1b4e3312ce1ce0d1478b610d88bec4f2170e822053" :answer/id #uuid "fc212aa1-2b52-5605-b31a-ec992818c6f6" :answer/type :answer.type/math :answer/value "z=-{x}^{2}-{y}^{2}-2" :db/ensure [:answer/validate]} {:db/id "q-129186/selection/eed712b1a349a9d30d1eaaa3310372d2bd4c3f2438d018ba1cfa2dd3ed3a1cf4" :answer/id #uuid "172acc8b-bde8-5487-8a12-5f5551793afe" :answer/type :answer.type/math :answer/value "z={x}^{2}+{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-129186/selection/2fe8f69d0aeffe6c7d93ccea677b3d9c884b62c1a793a27bed95376c006a4064" :answer/id #uuid "722e9fe7-52bc-58f5-a99d-17088447b4e8" :answer/type :answer.type/math :answer/value "z={x}^{2}+{y}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-129186/selection/93a719a0700942fabe7a570b68671c368922575352d5d378ac34be5ebe02e7e4" :answer/id #uuid "7c128848-f51f-5ecd-9bd3-fb25e4f53f02" :answer/type :answer.type/math :answer/value "z=-{x}^{2}-{y}^{2}+1" :db/ensure [:answer/validate]} {:db/id "q-129186/selection/c730d6d434eaf8dab61099385445986903e31c3f10ee6b6c34103432f25708a2" :answer/id #uuid "d1ff482a-31ae-5c8b-97fc-d67346a38098" :answer/type :answer.type/math :answer/value "z={x}^{2}+{y}^{2}-2" :db/ensure [:answer/validate]} {:db/id "q-129186/selection" :answer-field/id #