r/id #uuid "91126c2f-bf3b-5c9e-9a4a-ce6aa3a342d7" :answer/type :answer.type/math :answer/value "z=4x-y-1" :db/ensure [:answer/validate]} {:db/id "q-129182/selection/1e46a2c55d678659360f034b079091ca447260c70861f16246308553911bf429" :answer/id #uuid "1e44fd69-5864-5b6d-bbce-d61d8ec5d562" :answer/type :answer.type/math :answer/value "z=4x+y-1" :db/ensure [:answer/validate]} {:db/id "q-129182/selection/91d94a7cce284f949cc846ac76a4a71c88772d28489b1ab3f0c7980286aeac03" :answer/id #uuid "68ba5c70-7eb3-531c-afaa-d24febbf5e3a" :answer/type :answer.type/math :answer/value "z=-4{x}^{2}-{y}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-129182/selection/888885c45bf23520d1d71efa45e1189666cac01f13d7d94d8fd5b4adbcd56cd7" :answer/id #uuid "dbcc2a95-e0e3-5052-99d0-7bdbc50f2e90" :answer/type :answer.type/math :answer/value "z=4{x}^{2}-{y}^{2}+2" :db/ensure [:answer/validate]} {:db/id "q-129182/selection" :answer-field/id #uuid "d06afb17-f132-5190-82a7-68f7dd757662" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129182/selection/5f379deb3d6411eba33b430a6f6a2080dcb4312804e69fde709a191f75610a9d" :answer-field/choices ["q-129182/selection/5f379deb3d6411eba33b430a6f6a2080dcb4312804e69fde709a191f75610a9d" "q-129182/selection/bd816cb067db79dd7f5f56fe6c5efe032e09c84c95854fea14b434cfcdd1dcc7" "q-129182/selection/1e46a2c55d678659360f034b079091ca447260c70861f16246308553911bf429" "q-129182/selection/91d94a7cce284f949cc846ac76a4a71c88772d28489b1ab3f0c7980286aeac03" "q-129182/selection/888885c45bf23520d1d71efa45e1189666cac01f13d7d94d8fd5b4adbcd56cd7"] :db/ensure [:answer-field/validate]} {:db/id "q-129182" :question/id #uuid "aaa065e5-4d42-53ad-a1bb-ce64f0d24542" :question/math-academy-id "q-129182" :question/problem "For the function $f(x,y,z)=z-4{x}^{2}-{y}^{2}+1,$ find the equation of the level surface $f(x,y,z)=1.$" :question/worked-solution "The level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=0.$ So, we have\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ z-4{x}^{2}-{y}^{2}+1 & =1 \\\\ z & =4{x}^{2}+{y}^{2}.\\end{aligned}\n$$\n\nTherefore, the level surface for $c=1$ is the elliptic paraboloid $z=4{x}^{2}+{y}^{2}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129182/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c5e0a37b-23ad-5e79-a175-378b88640ba4"] :knowledge-point/questions ["q-129182"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129198/selection/aa34b3f027f5fad81544259e8dbd40c293b5732dadc00de5f7d69aa3148c31ce" :answer/id #uuid "84fb5007-bb54-548c-92e3-3fbac15ccc13" :answer/type :answer.type/text :answer/value "A family of surfaces: $z={e}^{-x+2y+{r}^{2}}$" :db/ensure [:answer/validate]} {:db/id "q-129198/selection/4a783a9895d1a2bcaa3c1147239d213df58686c100c17a9013f34c45145229a3" :answer/id #uuid "d7d42da4-9b70-5a47-a5d2-6e2b651862f7" :answer/type :answer.type/text :answer/value "A family of surfaces: $z={e}^{x-2y+{r}^{2}}$" :db/ensure [:answer/validate]} {:db/id "q-129198/selection/b83783d4135c37e0742cb06076b822c097f7461304aa689e152323c499a2dde7" :answer/id #uuid "cdacd41f-d844-5aea-85a6-b5614df9f622" :answer/type :answer.type/text :answer/value "A family of planes: $x-2y+z={r}^{2}$" :db/ensure [:answer/validate]} {:db/id "q-129198/selection/f423b63d45a56c25d6c7bc6d3aa00cc865d15248c66c27c579a701f0e8bffe7d" :answer/id #uuid "e9309054-d552-5e4f-8830-1f10182954b6" :answer/type :answer.type/text :answer/value "A family of planes: $x-2y+z=-{r}^{2}$" :db/ensure [:answer/validate]} {:db/id "q-129198/selection/fcedb975191c139e3d9b68c9a867f976c1f11695f7d02ca75351ce345078361e" :answer/id #uuid "a6009bb8-b43c-5638-b529-22d1193070dd" :answer/type :answer.type/text :answer/value "A family of planes: $x-2y+z=0$" :db/ensure [:answer/validate]} {:db/id "q-129198/selection" :answer-field/id #uuid "d9e3ce89-d58d-5eac-b873-20b1b3da36fb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129198/selection/b83783d4135c37e0742cb06076b822c097f7461304aa689e152323c499a2dde7" :answer-field/choices ["q-129198/selection/aa34b3f027f5fad81544259e8dbd40c293b5732dadc00de5f7d69aa3148c31ce" "q-129198/selection/4a783a9895d1a2bcaa3c1147239d213df58686c100c17a9013f34c45145229a3" "q-129198/selection/b83783d4135c37e0742cb06076b822c097f7461304aa689e152323c499a2dde7" "q-129198/selection/f423b63d45a56c25d6c7bc6d3aa00cc865d15248c66c27c579a701f0e8bffe7d" "q-129198/selection/fcedb975191c139e3d9b68c9a867f976c1f11695f7d02ca75351ce345078361e"] :db/ensure [:answer-field/validate]} {:db/id "q-129198" :question/id #uuid "b82355ef-f6b0-5644-b274-2b1d50d4f10b" :question/math-academy-id "q-129198" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=\\operatorname{ln}⁡(x-2y+z)?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\operatorname{ln}⁡(x-2y+z) & =c \\\\ x-2y+z & ={e}^{c}\\end{aligned}\n$$\n\nNotice that the exponent ${e}^{c}$ is positive for all $-\\infty <c<\\infty .$ If we let ${e}^{c}={r}^{2},$ we get a family of planes:\n\n$$\nx-2y+z={r}^{2},\\,r\\in (-\\infty ,\\infty )\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129198/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489"] :knowledge-point/questions ["q-129198"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129196/selection/9cf124eb7c7661ea9cadf3031192156098f4594beffd4c4a20fc6b8ca7f44125" :answer/id #uuid "8c5055ac-cabf-5e49-8ff0-303b17a02c17" :answer/type :answer.type/text :answer/value "A family of hyperbolic paraboloids: $z={x}^{2}-3{y}^{2}+C$" :db/ensure [:answer/validate]} {:db/id "q-129196/selection/546d99f346cfd7ff2c03a2265010de504f49df7ab24b46370af51114968dc716" :answer/id #uuid "e019e33c-6c6c-55a7-9bbd-3e8852e82ee1" :answer/type :answer.type/text :answer/value "A family of elliptic paraboloids: $z=-{x}^{2}-3{y}^{2}+C$" :db/ensure [:answer/validate]} {:db/id "q-129196/selection/49f0c47e4f3b44a8c398b5662fca5337c244b382e32069a60b3668df6654c1bb" :answer/id #uuid "03d3163d-481d-5ee9-b45c-768c96dd0bb8" :answer/type :answer.type/text :answer/value "A family of elliptic paraboloids: $z={x}^{2}+3{y}^{2}+C$" :db/ensure [:answer/validate]} {:db/id "q-129196/selection/6411ff450056782a903d16a81a261fa2ee6b29dfd56428fdcd283b5e2996aee8" :answer/id #uuid "d3f7ffac-9f86-5028-98e1-1a011e9fc166" :answer/type :answer.type/text :answer/value "A family of planes: $z=x+3y+C$" :db/ensure [:answer/validate]} {:db/id "q-129196/selection/b9fe51ad317c99f44dd2d93584cf54d5c96f2a6d4001c128e89b2b9d6f79561f" :answer/id #uuid "814c62dd-9fda-5f39-87c1-7e08829d1c18" :answer/type :answer.type/text :answer/value "A family of elliptic cones: ${z}^{2}={x}^{2}+3{y}^{2}+C$" :db/ensure [:answer/validate]} {:db/id "q-129196/selection" :answer-field/id #uuid "e87767bc-2d38-5651-a50a-7158a84da983" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129196/selection/49f0c47e4f3b44a8c398b5662fca5337c244b382e32069a60b3668df6654c1bb" :answer-field/choices ["q-129196/selection/9cf124eb7c7661ea9cadf3031192156098f4594beffd4c4a20fc6b8ca7f44125" "q-129196/selection/546d99f346cfd7ff2c03a2265010de504f49df7ab24b46370af51114968dc716" "q-129196/selection/49f0c47e4f3b44a8c398b5662fca5337c244b382e32069a60b3668df6654c1bb" "q-129196/selection/6411ff450056782a903d16a81a261fa2ee6b29dfd56428fdcd283b5e2996aee8" "q-129196/selection/b9fe51ad317c99f44dd2d93584cf54d5c96f2a6d4001c128e89b2b9d6f79561f"] :db/ensure [:answer-field/validate]} {:db/id "q-129196" :question/id #uuid "852bf822-f29b-5192-aec8-e90f16061ab3" :question/math-academy-id "q-129196" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=-{x}^{2}-3{y}^{2}+z+3?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ -{x}^{2}-3{y}^{2}+z+3 & =c \\\\ z & ={x}^{2}+3{y}^{2}+c-3\\end{aligned}\n$$\n\nIf we let $c-3=C,$ we get a family of elliptic paraboloids:\n\n$$\nz={x}^{2}+3{y}^{2}+C,\\,C\\in (-\\infty ,\\infty )\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129196/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489"] :knowledge-point/questions ["q-129196"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71582/selection/5ddac082595a5767d83b421bf33434990116bdc22ab6e30bc4b3cc360dfdac00" :answer/id #uuid "7e89b980-cc1c-502e-b7d5-4b9d52e36c97" :answer/type :answer.type/text :answer/value "A family of hyperboloids of one sheet: $cx-2cy+3cz-8=0$" :db/ensure [:answer/validate]} {:db/id "q-71582/selection/25eb19a588220339ed516fabefe41a7847015bf577a8edaea768d844a910ad6f" :answer/id #uuid "8cd79d17-842a-5fa3-af0e-ca173253a94b" :answer/type :answer.type/text :answer/value "A family of hyperboloids of one sheet: $\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1$" :db/ensure [:answer/validate]} {:db/id "q-71582/selection/b278228afe91ca1e8dfc5aa064ed5ae3c928be4e24b006a2e6eca546b25c5a64" :answer/id #uuid "6e2870f3-bd85-5dec-9116-464f03afc8bf" :answer/type :answer.type/text :answer/value "A family of ellipsoids: $\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}+{z}^{2}=1$" :db/ensure [:answer/validate]} {:db/id "q-71582/selection/76442e99a32a9cb2cf01818ad7584f76156db7514cb4378c4e301bde5d7f9933" :answer/id #uuid "98037671-4d3d-5e59-901d-3ddc5a084545" :answer/type :answer.type/text :answer/value "A family of hyperbolic paraboloid: $\\frac{{x}^{2}}{{c}^{2}}-\\frac{{y}^{2}}{{c}^{2}}=z$" :db/ensure [:answer/validate]} {:db/id "q-71582/selection/a2a647690f82985626a01bbe96bf7e92201a41a8c34e35af44471f90823b525b" :answer/id #uuid "7b0f6e1b-1d8d-5ba1-b9b5-d4274a290cfa" :answer/type :answer.type/text :answer/value "A family of spheres: $\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}+\\frac{{z}^{2}}{{c}^{2}}=1$" :db/ensure [:answer/validate]} {:db/id "q-71582/selection" :answer-field/id #uuid "f4b876f1-d2f6-5dad-973a-274cbe416921" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71582/selection/25eb19a588220339ed516fabefe41a7847015bf577a8edaea768d844a910ad6f" :answer-field/choices ["q-71582/selection/5ddac082595a5767d83b421bf33434990116bdc22ab6e30bc4b3cc360dfdac00" "q-71582/selection/25eb19a588220339ed516fabefe41a7847015bf577a8edaea768d844a910ad6f" "q-71582/selection/b278228afe91ca1e8dfc5aa064ed5ae3c928be4e24b006a2e6eca546b25c5a64" "q-71582/selection/76442e99a32a9cb2cf01818ad7584f76156db7514cb4378c4e301bde5d7f9933" "q-71582/selection/a2a647690f82985626a01bbe96bf7e92201a41a8c34e35af44471f90823b525b"] :db/ensure [:answer-field/validate]} {:db/id "q-71582" :question/id #uuid "196e54b1-6877-5611-9d9d-7ecb8d24abce" :question/math-academy-id "q-71582" :question/problem "Which of the following describes the $c$-level surfaces of the function $f(x,y,z)=\\sqrt{{x}^{2}+{y}^{2}-{z}^{2}},$ where $c>0?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\sqrt{{x}^{2}+{y}^{2}-{z}^{2}} & =c \\\\ {x}^{2}+{y}^{2}-{z}^{2} & ={c}^{2}\\end{aligned}\n$$\n\nTherefore, we get a family of hyperboloids of one sheet:\n\n$$\n\\frac{{x}^{2}}{{c}^{2}}+\\frac{{y}^{2}}{{c}^{2}}-\\frac{{z}^{2}}{{c}^{2}}=1,\\,c\\in (0,\\infty ).\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71582/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489"] :knowledge-point/questions ["q-71582"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71578/selection/9a593ed864b4dfd908fc1ff8b418065f0800fb061a053bdbc1c70be63908f8ce" :answer/id #uuid "a58cec26-d066-5de7-a50b-dd2d7e0138ee" :answer/type :answer.type/text :answer/value "A family of spheres centered at $(0,0,{e}^{c})$" :db/ensure [:answer/validate]} {:db/id "q-71578/selection/63422bfc01500334e02816980c272181d9c1eaab26110e5d6a661ecd546bd532" :answer/id #uuid "56558b26-cace-5491-9917-8b5fef9205c3" :answer/type :answer.type/text :answer/value "A family of spheres centered at the origin" :db/ensure [:answer/validate]} {:db/id "q-71578/selection/ecd151e7ca5afe97120b6f24f7a64bd92e320e33f498881815f835cb315aa5ad" :answer/id #uuid "7e7da0ca-bee0-5c9d-8fee-3c4b713c97c5" :answer/type :answer.type/text :answer/value "A family of surfaces given by ${z}^{2}+c=\\operatorname{ln}⁡({x}^{2}+{y}^{2})$" :db/ensure [:answer/validate]} {:db/id "q-71578/selection/cbaf20123725eefe5a29be1c3e344e19f9b6f8ca08002398493258a0c587b2dc" :answer/id #uuid "aa36eb4c-224a-52e9-8492-ef27157720de" :answer/type :answer.type/text :answer/value "A family of spheres centered at $(0,0,{e}^{-c})$" :db/ensure [:answer/validate]} {:db/id "q-71578/selection/cd197543aae24a98fa216f21a396bafc91a642651f6039234db1eb1273ca64fb" :answer/id #uuid "2f0f766b-c78e-52b0-9cef-cc1d2e0375d8" :answer/type :answer.type/text :answer/value "A family of surfaces given by ${z}^{2}+c={e}^{{x}^{2}+{y}^{2}}$" :db/ensure [:answer/validate]} {:db/id "q-71578/selection" :answer-field/id #uuid "6e34b1c8-b84e-5c85-b357-c2bf653de476" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71578/selection/63422bfc01500334e02816980c272181d9c1eaab26110e5d6a661ecd546bd532" :answer-field/choices ["q-71578/selection/9a593ed864b4dfd908fc1ff8b418065f0800fb061a053bdbc1c70be63908f8ce" "q-71578/selection/63422bfc01500334e02816980c272181d9c1eaab26110e5d6a661ecd546bd532" "q-71578/selection/ecd151e7ca5afe97120b6f24f7a64bd92e320e33f498881815f835cb315aa5ad" "q-71578/selection/cbaf20123725eefe5a29be1c3e344e19f9b6f8ca08002398493258a0c587b2dc" "q-71578/selection/cd197543aae24a98fa216f21a396bafc91a642651f6039234db1eb1273ca64fb"] :db/ensure [:answer-field/validate]} {:db/id "q-71578" :question/id #uuid "c8f1be0d-70ce-5024-b2a6-192f82740e7a" :question/math-academy-id "q-71578" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2})?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\operatorname{ln}⁡({x}^{2}+{y}^{2}+{z}^{2}) & =c \\\\ {x}^{2}+{y}^{2}+{z}^{2} & ={e}^{c}\\end{aligned}\n$$\n\nIf we let ${e}^{c}={r}^{2},$ we get\n\n$$\n{x}^{2}+{y}^{2}+{z}^{2}={r}^{2}.\n$$\n\nTherefore, the level surfaces form a family of spheres centered at the origin." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71578/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489"] :knowledge-point/questions ["q-71578"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129203/selection/2bcefbf6be7609828602a7ddcf85b2041cf69a69cd2eef6db557023b9db1144e" :answer/id #uuid "2548d072-9da1-52b0-9b37-f211d1ae2bc7" :answer/type :answer.type/text :answer/value "A family of hyperbolic paraboloids: $z={x}^{2}-{y}^{2}+c$" :db/ensure [:answer/validate]} {:db/id "q-129203/selection/52c14dfa1737f254aca697b668542316e5214803219cee3e23e04c96205e9c7f" :answer/id #uuid "400db4cd-98a3-5392-81f3-c03a3abdc0ff" :answer/type :answer.type/text :answer/value "A family of curves: $z={e}^{{x}^{2}}+{y}^{2}+c$" :db/ensure [:answer/validate]} {:db/id "q-129203/selection/35b69f020045c82ed8cc136d303d1dd7dea9dc9527d8b502d6ee77cef62ef664" :answer/id #uuid "19bf0b6e-9f65-5ce3-97d1-f50f926dcb18" :answer/type :answer.type/text :answer/value "A family of curves: $z={e}^{{x}^{2}+{y}^{2}-c}$" :db/ensure [:answer/validate]} {:db/id "q-129203/selection/6bfcb9bb67b75c181ba23954cdbd8137893b7e9eb880a10c4e9e77e744c524c1" :answer/id #uuid "e691a7ce-6608-5118-9675-39a1f5db7951" :answer/type :answer.type/text :answer/value "A family of curves: $z=\\operatorname{ln}⁡({x}^{2}+{y}^{2}+c)$" :db/ensure [:answer/validate]} {:db/id "q-129203/selection/4c4a9f1094cb2f2074c06f5dd16f57301831067278cb52f86b66b69670a51a89" :answer/id #uuid "d50bcff7-fb9a-5147-98f6-fa001a9a8ece" :answer/type :answer.type/text :answer/value "A family of paraboloids: $z={x}^{2}+{y}^{2}+c$" :db/ensure [:answer/validate]} {:db/id "q-129203/selection" :answer-field/id #uuid "39db1192-6cca-5e89-ac58-05369e68c96f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129203/selection/35b69f020045c82ed8cc136d303d1dd7dea9dc9527d8b502d6ee77cef62ef664" :answer-field/choices ["q-129203/selection/2bcefbf6be7609828602a7ddcf85b2041cf69a69cd2eef6db557023b9db1144e" "q-129203/selection/52c14dfa1737f254aca697b668542316e5214803219cee3e23e04c96205e9c7f" "q-129203/selection/35b69f020045c82ed8cc136d303d1dd7dea9dc9527d8b502d6ee77cef62ef664" "q-129203/selection/6bfcb9bb67b75c181ba23954cdbd8137893b7e9eb880a10c4e9e77e744c524c1" "q-129203/selection/4c4a9f1094cb2f2074c06f5dd16f57301831067278cb52f86b66b69670a51a89"] :db/ensure [:answer-field/validate]} {:db/id "q-129203" :question/id #uuid "d12435a2-bc4c-5e0c-ae4f-ac947d914e83" :question/math-academy-id "q-129203" :question/problem "Which of the following describes the level surfaces of the function $f(x,y,z)={x}^{2}+{y}^{2}-\\operatorname{ln}⁡z?$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {x}^{2}+{y}^{2}-\\operatorname{ln}⁡z & =c \\\\ \\operatorname{ln}⁡z & ={x}^{2}+{y}^{2}-c \\\\ z & ={e}^{{x}^{2}+{y}^{2}-c}\\end{aligned}\n$$\n\nTherefore, we get a family of curves:\n\n$$\nz={e}^{{x}^{2}+{y}^{2}-c},\\,c\\in (-\\infty ,\\infty )\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129203/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "5165085e-ffa9-533a-ab7c-c03304fc1489"] :knowledge-point/questions ["q-129203"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129192/selection/1ce269d0c4a3a95a47d9c53ff73dbb41fc88ea9be6f567e9048c3d1d867e1ce8" :answer/id #uuid "71ce9699-023b-59c5-9569-c6e2b71041af" :answer/type :answer.type/math :answer/value "x-y+z-4=0" :db/ensure [:answer/validate]} {:db/id "q-129192/selection/da00d5c5a7b564cc834b030bfffc8ae30124a842b957d5a9b11627694b2bb1e6" :answer/id #uuid "64dbe6fd-20a2-5f77-874d-7020bf40d16a" :answer/type :answer.type/math :answer/value "x-y+z-1=0" :db/ensure [:answer/validate]} {:db/id "q-129192/selection/f88601ec12ad2e2f508f14babd6aefc2bfb79481463acc337c7d3fd71c3e170b" :answer/id #uuid "c8e4ff0b-7f94-5df5-9bfa-601d35af5673" :answer/type :answer.type/math :answer/value "x-y+z+4=0" :db/ensure [:answer/validate]} {:db/id "q-129192/selection/d285b78488db9227e5607f4623486d22da31e5fc87395a30f6992a0aea599807" :answer/id #uuid "5ac57ccf-f61d-54a4-b93c-dd7da4d1033e" :answer/type :answer.type/math :answer/value "x-y+z+2=0" :db/ensure [:answer/validate]} {:db/id "q-129192/selection/9658cca5410dc0c92a12f70a16c913e7e25a57b20fba074c5a3c94d2f46bd3c1" :answer/id #uuid "1583e6f2-63e0-58dd-8c64-4dbe81f903ab" :answer/type :answer.type/math :answer/value "x-y+z=0" :db/ensure [:answer/validate]} {:db/id "q-129192/selection" :answer-field/id #uuid "353c8a90-687c-5f55-816b-7ccce79a0dbd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129192/selection/da00d5c5a7b564cc834b030bfffc8ae30124a842b957d5a9b11627694b2bb1e6" :answer-field/choices ["q-129192/selection/1ce269d0c4a3a95a47d9c53ff73dbb41fc88ea9be6f567e9048c3d1d867e1ce8" "q-129192/selection/da00d5c5a7b564cc834b030bfffc8ae30124a842b957d5a9b11627694b2bb1e6" "q-129192/selection/f88601ec12ad2e2f508f14babd6aefc2bfb79481463acc337c7d3fd71c3e170b" "q-129192/selection/d285b78488db9227e5607f4623486d22da31e5fc87395a30f6992a0aea599807" "q-129192/selection/9658cca5410dc0c92a12f70a16c913e7e25a57b20fba074c5a3c94d2f46bd3c1"] :db/ensure [:answer-field/validate]} {:db/id "q-129192" :question/id #uuid "ba672326-c9ff-5430-ad98-64efc5364b6e" :question/math-academy-id "q-129192" :question/problem "Find the equation of the level surface for the function $f(x,y,z)={e}^{x-y+z-1}$ that passes through the point $P(1,1,1).$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(1,1,1) & ={e}^{1-1+1-1} \\\\  & ={e}^{0} \\\\  & =1\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=1.$ So, we have\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {e}^{x-y+z-1} & =1 \\\\ x-y+z-1 & =0.\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(1,1,1)$ is the plane $x-y+z-1=0.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129192/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142"] :knowledge-point/questions ["q-129192"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129194/selection/4638d4c42be7d2725e91545372d84a8e9d5610f354a67798102bcab419f2b214" :answer/id #uuid "be6e99ec-8760-530d-9aba-a7779581c8fc" :answer/type :answer.type/math :answer/value "{z}^{2}={x}^{2}+9{y}^{2}+2" :db/ensure [:answer/validate]} {:db/id "q-129194/selection/6f78b410d83c85fa143ccc0b0a33778da72a8798af291dc422c2bc845ebac5c8" :answer/id #uuid "340d9701-c97a-571e-9bf1-7175e23f28de" :answer/type :answer.type/math :answer/value "{z}^{2}=2{x}^{2}+18{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-129194/selection/e2082f512ef54dbc7d8f1d275d64096e0772ff3db80bc3150839a7edba6a8407" :answer/id #uuid "3ab55915-f020-585f-8122-378d7ba3208c" :answer/type :answer.type/math :answer/value "{z}^{2}={x}^{2}+9{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-129194/selection/b3e22ad67c1f84cfc8bb2d2f199392c8b4235db48ed67a26b3d0855153a2e584" :answer/id #uuid "5b658d57-acec-5180-a95a-c130c6132c5d" :answer/type :answer.type/math :answer/value "{z}^{2}=4{x}^{2}+36{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-129194/selection/1e9cbbf2ce1f111eb1b9f112db41c9395830deb6cfeb1dfdf536894635dd54ce" :answer/id #uuid "956e0626-4f96-52ef-b79b-524bf1a85273" :answer/type :answer.type/math :answer/value "{z}^{2}={x}^{2}+9{y}^{2}+4" :db/ensure [:answer/validate]} {:db/id "q-129194/selection" :answer-field/id #uuid "211ba566-a416-55d5-9c53-963c66d7ba82" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129194/selection/6f78b410d83c85fa143ccc0b0a33778da72a8798af291dc422c2bc845ebac5c8" :answer-field/choices ["q-129194/selection/4638d4c42be7d2725e91545372d84a8e9d5610f354a67798102bcab419f2b214" "q-129194/selection/6f78b410d83c85fa143ccc0b0a33778da72a8798af291dc422c2bc845ebac5c8" "q-129194/selection/e2082f512ef54dbc7d8f1d275d64096e0772ff3db80bc3150839a7edba6a8407" "q-129194/selection/b3e22ad67c1f84cfc8bb2d2f199392c8b4235db48ed67a26b3d0855153a2e584" "q-129194/selection/1e9cbbf2ce1f111eb1b9f112db41c9395830deb6cfeb1dfdf536894635dd54ce"] :db/ensure [:answer-field/validate]} {:db/id "q-129194" :question/id #uuid "597e3f3c-01b1-5b60-85f0-1eda3e7982d7" :question/math-academy-id "q-129194" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=\\frac{{z}^{2}}{{x}^{2}+9{y}^{2}}$ that passes through the point $P(3,1,6).$" :question/worked-solution "First, we find the value of the function at $P:$\n\n$$\n\\begin{aligned}f(3,1,6) & =\\frac{{6}^{2}}{{3}^{2}+9({1}^{2})} \\\\  & =\\frac{36}{18} \\\\  & =2\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=2.$ So, we have\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\frac{{z}^{2}}{{x}^{2}+9{y}^{2}} & =2 \\\\ {z}^{2} & =2({x}^{2}+9{y}^{2}) \\\\ {z}^{2} & =2{x}^{2}+18{y}^{2}.\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(3,1,6)$ is the elliptic cone\n ${z}^{2}=2{x}^{2}+18{y}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129194/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142"] :knowledge-point/questions ["q-129194"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36986"] :question/problem "Find the equation of the level surface for the function $f(x,y,z)=\\operatorname{ln}⁡(x+2y+3z)$ that passes through the point $P(1,1,0).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(1,1,0) & =\\operatorname{ln}⁡(1+2(1)+3(0))=\\operatorname{ln}⁡3\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=\\operatorname{ln}⁡3.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\operatorname{ln}⁡(x+2y+3z) & =\\operatorname{ln}⁡3 \\\\ x+2y+3z & =3 \\\\ x+2y+3z-3 & =0\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(1,1,0)$ is the plane $x+2y+3z-3=0.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-71596/selection/b5da69dc5d82793ea9294a88460d249679260f8bba032bef07cf1e9afebd65fe" :answer/id #uuid "bc209b47-a4f5-5723-a789-d60e6516f63e" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{3}-\\frac{{z}^{2}}{18}=1" :db/ensure [:answer/validate]} {:db/id "q-71596/selection/fb35a321c832870b7d439f51dcda3279a7d0c57c66b57713cc4dc7b531b36bc8" :answer/id #uuid "21c751b9-391b-5c6c-9fb3-0873b76fbbd5" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{12}+\\frac{(y-1)^{2}}{8}-\\frac{{z}^{2}}{12}=1" :db/ensure [:answer/validate]} {:db/id "q-71596/selection/5b34441148215a9665f4c9809fd3c31304866b6fe462aecdfaadf3dcd17a61c7" :answer/id #uuid "3f7b662b-d3b6-5e39-8854-fef1dc436af8" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{18}-\\frac{{z}^{2}}{18}=1" :db/ensure [:answer/validate]} {:db/id "q-71596/selection/2e73faa9a19689cc3c378d8a3ffd725e69662cd845a137981e5fccbb13195d4d" :answer/id #uuid "732c3d24-16a4-58fd-8fd0-a9a6f93badef" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{6}-\\frac{{z}^{2}}{18}=1" :db/ensure [:answer/validate]} {:db/id "q-71596/selection/805f6d0190777fe9f4833124b86eb6541b347ffad2174ce738df53928b20fe5e" :answer/id #uuid "7ed07e63-6b21-5a34-9b4e-f2a23ac17087" :answer/type :answer.type/math :answer/value "\\frac{{x}^{2}}{12}-\\frac{(y-1)^{2}}{4}-\\frac{{z}^{2}}{12}=1" :db/ensure [:answer/validate]} {:db/id "q-71596/selection" :answer-field/id #uuid "5329080f-b8a7-5ae0-b1e5-0243f93baa73" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71596/selection/2e73faa9a19689cc3c378d8a3ffd725e69662cd845a137981e5fccbb13195d4d" :answer-field/choices ["q-71596/selection/b5da69dc5d82793ea9294a88460d249679260f8bba032bef07cf1e9afebd65fe" "q-71596/selection/fb35a321c832870b7d439f51dcda3279a7d0c57c66b57713cc4dc7b531b36bc8" "q-71596/selection/5b34441148215a9665f4c9809fd3c31304866b6fe462aecdfaadf3dcd17a61c7" "q-71596/selection/2e73faa9a19689cc3c378d8a3ffd725e69662cd845a137981e5fccbb13195d4d" "q-71596/selection/805f6d0190777fe9f4833124b86eb6541b347ffad2174ce738df53928b20fe5e"] :db/ensure [:answer-field/validate]} {:db/id "q-71596" :question/id #uuid "0c7e17bc-81d9-5d3a-a5a3-3325aa70370c" :question/math-academy-id "q-71596" :question/problem "Find the equation of the level surface for the function $f(x,y,z)={x}^{2}+3(y-1)^{2}-{z}^{2}$ that passes through the point $P(4,2,1).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(4,2,1) & ={4}^{2}+3(2-1)^{2}-{1}^{2}=18\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=18.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {x}^{2}+3(y-1)^{2}-{z}^{2} & =18 \\\\ \\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{6}-\\frac{{z}^{2}}{18} & =1\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(4,2,1)$ is the hyperboloid of one sheet $\\frac{{x}^{2}}{18}+\\frac{(y-1)^{2}}{6}-\\frac{{z}^{2}}{18}=1.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71596/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142"] :knowledge-point/questions ["q-71596"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71597/selection/4418159b7f3ca46e5530335c7458fe5636986de1943c1674eebb706b52a8c2cd" :answer/id #uuid "e4f55ce4-2a8f-5362-8787-89e93ac55ab3" :answer/type :answer.type/math :answer/value "z=4{x}^{2}+6{y}^{2}+2" :db/ensure [:answer/validate]} {:db/id "q-71597/selection/27b6506b87c92334a29095ffb161ca483a000995de79244a219c0f1872c6dfff" :answer/id #uuid "1d9ad17e-9847-5943-9e1c-3dad79407f4d" :answer/type :answer.type/math :answer/value "z=2{x}^{2}+3{y}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-71597/selection/15859ad0eb9ca193f1d3fd92287484d85598cc900807966acc6b16be2b5b5573" :answer/id #uuid "bd7d95cf-c2bf-5940-96c7-2bc4fa3eb331" :answer/type :answer.type/math :answer/value "z=4{x}^{2}+6{y}^{2}-2" :db/ensure [:answer/validate]} {:db/id "q-71597/selection/26c5d3bdf5c913b1a051e66036e052db52900017e122d2cf7382a07d484ebc29" :answer/id #uuid "c8ec7d73-0d7e-5f13-854f-c6fa4e3cf239" :answer/type :answer.type/math :answer/value "z=4{x}^{2}+6{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71597/selection/697cda874cfd07b8eeb87374e7ea646f5fe4422aea68eb114a2177b1f77ee423" :answer/id #uuid "341fa4bd-a21a-56f2-ac43-007c571f961b" :answer/type :answer.type/math :answer/value "z=2{x}^{2}+3{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-71597/selection" :answer-field/id #uuid "f20bdcfa-a054-50c1-a5a6-73f79ea72b4e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71597/selection/26c5d3bdf5c913b1a051e66036e052db52900017e122d2cf7382a07d484ebc29" :answer-field/choices ["q-71597/selection/4418159b7f3ca46e5530335c7458fe5636986de1943c1674eebb706b52a8c2cd" "q-71597/selection/27b6506b87c92334a29095ffb161ca483a000995de79244a219c0f1872c6dfff" "q-71597/selection/15859ad0eb9ca193f1d3fd92287484d85598cc900807966acc6b16be2b5b5573" "q-71597/selection/26c5d3bdf5c913b1a051e66036e052db52900017e122d2cf7382a07d484ebc29" "q-71597/selection/697cda874cfd07b8eeb87374e7ea646f5fe4422aea68eb114a2177b1f77ee423"] :db/ensure [:answer-field/validate]} {:db/id "q-71597" :question/id #uuid "3cee2f9e-e585-5811-8e82-df8782bd57e3" :question/math-academy-id "q-71597" :question/problem "Find the equation of the level surface for the function $f(x,y,z)=z-4{x}^{2}-6{y}^{2}$ that passes through the point $P(2,1,22).$" :question/worked-solution "First, we find the value of the function at $P$:\n\n$$\n\\begin{aligned}f(2,1,22) & =22-4(2)^{2}-6(1)^{2}=0\\end{aligned}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z)=c.\n$$\n\nIn our case, we're interested in $c=0.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ z-4{x}^{2}-6{y}^{2} & =0 \\\\ z & =4{x}^{2}+6{y}^{2}\\end{aligned}\n$$\n\nTherefore, the level surface that passes through the point $P(2,1,22)$ is the elliptic paraboloid $z=4{x}^{2}+6{y}^{2}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71597/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "77be6032-ec22-5561-94c2-be289e343142"] :knowledge-point/questions ["q-71597"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5967"] :question/problem "For the function $f(x,y,z) = x^2+4y^2-z,$ find the equation of the level surface $f(x,y,z)=0.$" :question/worked-solution "Recall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z) = c.\n$$\n\nIn our case, we're interested in $c = 0.$ So, we have:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ {x}^{2}+4{y}^{2}-z & =0 \\\\ z & ={x}^{2}+4{y}^{2} \\\\ z & ={x}^{2}+\\frac{{y}^{2}}{1/4}\\end{aligned}\n$$\n\nTherefore, the level surface for $c=0$ is the elliptic paraboloid $z = x^2+\\dfrac{y^2}{{1/4}}.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5965"] :question/problem "Find the family of surfaces that describe the level surfaces of the function $f(x,y, z) = \\ln(x^2 + 2y^2 - z^2).$" :question/worked-solution "The level surfaces of the function $f(x,y,z)$ are given by the following equation:\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\operatorname{ln}⁡({x}^{2}+2{y}^{2}-{z}^{2}) & =c \\\\ {x}^{2}+2{y}^{2}-{z}^{2} & ={e}^{c} \\\\ \\frac{{x}^{2}}{{e}^{c}}+\\frac{2{y}^{2}}{{e}^{c}}-\\frac{{z}^{2}}{{e}^{c}} & =1\\end{aligned}\n$$\n\nTherefore, we get a family of hyperboloids of one sheet:\n\n$$\n\\dfrac{x^2}{e^c} + \\dfrac{y^2}{e^c/2} - \\dfrac{z^2}{e^c} =  1, \\qquad c \\in (-\\infty,\\infty)\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5966"] :question/problem "Find the equation of the level surface for the function $f(x,y,z) = \\sin{xyz}$ that passes through the point $P\\left(\\pi,1,\\dfrac{1}{2}\\right).$" :question/worked-solution "First, we find the value of the function at $P\\mathbin{:}$\n\n$$\n\\eqalign{\n  f\\left(\\pi,1,\\dfrac{1}{2}\\right)&= \\sin \\left(\\pi\\cdot 1 \\cdot \\dfrac{1}{2} \\right) = \\sin{\\left(\\dfrac{\\pi}{2}\\right)} = 1}\n$$\n\nRecall that the level surfaces for the function $f(x,y,z)$ are given by the equation\n\n$$\nf(x,y,z) = c.\n$$\n\nIn our case, we're interested in $c = 1.$ So, we have\n\n$$\n\\begin{aligned}f(x,y,z) & =c \\\\ \\operatorname{sin}⁡xyz & =1 \\\\ xyz & =\\frac{\\pi }{2}+2\\pi k\\end{aligned}\n$$\n\nwhere $k$ is any integer.\n\nTherefore, the level surface that passes through the point $P\\left(\\pi,1,\\dfrac{1}{2}\\right)$ is the surface $xyz= \\dfrac{\\pi}{2} + 2\\pi k,$ where $k$ is any integer." :db/ensure [:question/validate]}]
