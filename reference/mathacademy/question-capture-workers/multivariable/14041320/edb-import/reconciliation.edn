036385/edb-import/verification.json"} {"question" "q-158035" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\text{ }y={x}^{3}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-154359" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{2x}{{e}^{y}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-154359" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x}{{e}^{y}} \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2x\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\text{d}y & =\\int 2x\\,\\text{d}x \\\\ {e}^{y} & ={x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{e}^{y}={x}^{2}+C.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-154359" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/activity-metadata.json" "file_sha256" "0ec922797d4c37acbca1781ba045d6de34dbdb3272845aa74b441f66eabb810e" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-154359" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-14257" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation ${y}^{′}={y}^{2}+1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-14257" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & ={y}^{2}+1 \\\\ \\frac{\\text{d}y}{\\text{d}x} & ={y}^{2}+1 \\\\ \\frac{1}{{y}^{2}+1}\\,\\frac{\\text{d}y}{\\text{d}x} & =1\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{{y}^{2}+1}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}+1}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\,\\text{d}x \\\\ \\int \\frac{1}{{y}^{2}+1}\\,\\text{d}y & =\\int \\,\\text{d}x \\\\ \\operatorname{arctan}⁡(y) & =x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{arctan}⁡(y)=x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\operatorname{tan}⁡(x+C).\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-14257" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/activity-metadata.json" "file_sha256" "0ec922797d4c37acbca1781ba045d6de34dbdb3272845aa74b441f66eabb810e" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-14257" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-51256" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=6x\\sqrt[3]{{y}^{2}}$ for $y\\ne 0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-51256" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =6x\\sqrt[3]{{y}^{2}} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =2x\\cdot 3\\sqrt[3]{{y}^{2}} \\\\ \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2x\\,\\text{d}x \\\\ \\int \\frac{1}{3\\sqrt[3]{{y}^{2}}}\\cdot \\text{d}y & =\\int 2x\\,\\text{d}x \\\\ \\frac{1}{3}\\int {y}^{-2/3}\\,\\text{d}y & =\\int 2x\\,\\text{d}x \\\\ {y}^{1/3} & ={x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{y}^{1/3}={x}^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=({x}^{2}+C)^{3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-51256" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/activity-metadata.json" "file_sha256" "0ec922797d4c37acbca1781ba045d6de34dbdb3272845aa74b441f66eabb810e" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-51256" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-51256" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=(6x+C)^{3}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-51256" "field" "selection" "attribute" "answer/value" "value"