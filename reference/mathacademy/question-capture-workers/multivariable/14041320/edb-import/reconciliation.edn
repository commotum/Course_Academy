22aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{\\sqrt{x}}{\\sqrt{y}} \\\\ \\sqrt{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\sqrt{x}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\sqrt{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\int \\sqrt{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\sqrt{x}\\,\\text{d}x \\\\ \\int {y}^{1/2}\\,\\text{d}y & =\\int {x}^{1/2}\\,\\text{d}x \\\\ \\frac{2{y}^{3/2}}{3} & =\\frac{2{x}^{3/2}}{3}+K \\\\ {y}^{3/2} & ={x}^{3/2}+C \\\\ \\sqrt{{y}^{3}} & =\\sqrt{{x}^{3}}+C,\\end{aligned}\n$$\n\nwhere $C=\\frac{3K}{2}.$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\sqrt{{y}^{3}}=\\sqrt{{x}^{3}}+C.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/activity-metadata.json" "file_sha256" "46dbe064e7d548bc283b07a09958fc59b77b8700062f68f20f01d2ba9a3bc5eb" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{{y}^{3}}=\\sqrt{{x}^{3}}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\sqrt{{y}^{3}}=x+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=\\sqrt{{x}^{3}}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y={x}^{2}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-154373" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "{y}^{3}=\\sqrt{x}+C"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation ${y}^{′}=\\frac{y}{{cos}^{2}⁡x}$ for $y\\ne 0$ and $-\\frac{\\pi }{2}<x<\\frac{\\pi }{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{y}{{cos}^{2}⁡x} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{y}{{cos}^{2}⁡x} \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{{cos}^{2}⁡x} \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & ={sec}^{2}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {sec}^{2}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int {sec}^{2}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int {sec}^{2}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{tan}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{tan}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{\\operatorname{tan}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{tan}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{tan}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{tan}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{\\operatorname{tan}⁡x}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/activity-metadata.json" "file_sha256" "46dbe064e7d548bc283b07a09958fc59b77b8700062f68f20f01d2ba9a3bc5eb" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=K\\operatorname{ln}⁡(\\operatorname{tan}⁡x)"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=K{e}^{\\operatorname{cos}⁡x}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=K{e}^{\\operatorname{tan}⁡x}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y=\\operatorname{ln}⁡(\\operatorname{cos}⁡x)+K"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "y={e}^{\\operatorname{tan}⁡x}+K"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158013" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=K{e}^{\\operatorname{tan}⁡x}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/state.json" "file_sha256" "027204b3cbdf3a65f7eb179b07ae00d638522aef9bb0c783f1db77ebff526c31" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10849" "field" nil "attribute" "question/problem" "value" "Given that $x,y \\geq 0,$ separate the variables in the following differential equation: \n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = \\sqrt{2xy}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10849.json" "file_sha256" "bcf520050a87378e04d859edcc8db85e258dbbb1d43df8cfefe7f330c4526897" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10849" "field" nil "attribute" "question/worked-solution" "value" "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} = h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\dfrac{1}{g(y)} \\cdot \\dfrac{\\textrm{d}y}{\\textrm{d}x} = h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\dfrac{\\textrm{d}y}{\\textrm{d}x} =  \\sqrt{2x} \\cdot  \\sqrt{y}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\dfrac{1}{\\sqrt{y}} \\cdot \\dfrac {\\textrm{d}y} {\\textrm{d}x} = \\sqrt{2x}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10849.json" "file_sha256" "bcf520050a87378e04d859edcc8db85e258dbbb1d43df8cfefe7f330c4526897" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10997" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation $\\dfrac{\\textrm{d}y}{\\textrm{d}x}\n    =\n    \\dfrac{x}{y}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10997.json" "file_sha256" "b335c0fe38f222588aaae2888d5bfa22c4e7108ae113efc3af2f71261a999dec" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10997" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{x}{y} \\\\ y\\frac{\\text{d}y}{\\text{d}x} & =x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int x\\,\\text{d}x \\\\ \\int y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int x\\,\\text{d}x \\\\ \\int y\\,\\text{d}y & =\\int x\\,\\text{d}x \\\\ \\frac{{y}^{2}}{2} & =\\frac{{x}^{2}}{2}+K \\\\ {y}^{2} & ={x}^{2}+2K \\\\ {y}^{2} & ={x}^{2}+C,\\end{aligned}\n$$\n\nwhere $C= 2K.$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\ny^2 = x^2 + C .\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10997.json" "file_sha256" "b335c0fe38f222588aaae2888d5bfa22c4e7108ae113efc3af2f71261a999dec" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10832" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation $y' = \\dfrac {x^2}{y}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10832.json" "file_sha256" "f8fd12f51042371f834f9bbde315713093900153e983b9e60fc2eecb7d5f8998" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10832" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =\\frac{{x}^{2}}{y} \\\\ \\frac{\\text{d}y}{\\text{d}x} & =\\frac{{x}^{2}}{y} \\\\ y\\,\\frac{\\text{d}y}{\\text{d}x} & ={x}^{2}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\int y\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int y\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int {x}^{2}\\,\\text{d}x \\\\ \\int y\\,\\text{d}y & =\\int {x}^{2}\\,\\text{d}x \\\\ \\frac{1}{2}{y}^{2} & =\\frac{1}{3}{x}^{3}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\dfrac{1}{2}y^2 = \\dfrac{1}{3}x^3 + C.\n$$\n\nWe can express the solution in the form $y = y(x)$ as follows:\n\n$$\n\\begin{aligned}\\frac{1}{2}{y}^{2} & =\\frac{1}{3}{x}^{3}+C \\\\ {y}^{2} & =\\frac{2}{3}{x}^{3}+2C \\\\ y & =\\pm \\sqrt{\\frac{2}{3}{x}^{3}+2C} \\\\ y & =\\pm \\sqrt{\\frac{2}{3}{x}^{3}+K}\\end{aligned}\n$$\n\nwhere $K = 2C.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10832.json" "file_sha256" "f8fd12f51042371f834f9bbde315713093900153e983b9e60fc2eecb7d5f8998" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10833" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation $y' + 2xy = 0$ for $y\\neq 0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10833.json" "file_sha256" "9e82b8f67fa194f48a1e8775f5847c138bb592feb33120741147b5c836ba16a4" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "e-10833" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′}+2xy & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x}+2xy & =0 \\\\ \\frac{\\text{d}y}{\\text{d}x} & =-2xy \\\\ \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =-2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x{:}$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int (-2x)\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =-2\\int x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =-{x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\ln \\vert y \\vert = -x^2 + C.\n$$\n\nWe're required to write the solution in the form $y = y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|y| & =-{x}^{2}+C \\\\ |y| & ={e}^{-{x}^{2}+C} \\\\ |y| & ={e}^{-{x}^{2}}\\cdot {e}^{C} \\\\ |y| & =K{e}^{-{x}^{2}}\\end{aligned}\n$$\n\nwhere $K = e^C$  and $K > 0.$ \n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny = Ke^{-x^2}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/example-10833.json" "file_sha256" "9e82b8f67fa194f48a1e8775f5847c138bb592feb33120741147b5c836ba16a4" "basis" 1158 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14012237/edb-import/verification.json"} {"question" "q-158026" "field" nil "attribute" "question/problem" "value" "Separate the variables in the following differential equation: \n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{\\sqrt{1+{y}^{2}}}{x}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-158026" "field" nil "attribute" "question/worked-solution" "value" "A differentiable equation is *separable* if it can be written in the form\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=h(x)g(y).\n$$\n\nIf an equation is separable, we say that the variables are *separated* when it is written in the form\n\n$$\n\\frac{1}{g(y)}\\cdot \\frac{\\text{d}y}{\\text{d}x}=h(x).\n$$\n\nNotice that our differentiable equation is separable since it can be written as\n\n$$\n\\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{x}\\cdot \\sqrt{1+{y}^{2}}.\n$$\n\nTherefore, we separate the variables as follows:\n\n$$\n\\frac{1}{\\sqrt{1+{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{x}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-158026" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/activity-metadata.json" "file_sha256" "0ec922797d4c37acbca1781ba045d6de34dbdb3272845aa74b441f66eabb810e" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-158026" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json"} {"question" "q-158026" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "\\frac{1}{\\sqrt{1+{y}^{2}}}\\cdot \\frac{\\text{d}y}{\\text{d}x}=\\frac{1}{x}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/state.json" "file_sha256" "f588af69fd6a70003e4b83c52e2208b3c81dd1ea2734b6e1b44421fe2bea8532" "basis" 1244 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14036385/edb-import/verification.json