⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{sin}⁡t)\\cdot (4\\operatorname{cos}⁡t)-(-8\\operatorname{cos}⁡t)\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-16\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & =-16{\\int }_{0}^{0}u\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$" 13194139535303 true] [17592186342851 1000 #edb/ref 17592186342852 13194139535303 true] [17592186342851 1000 #edb/ref 17592186342853 13194139535303 true] [17592186342851 1000 #edb/ref 17592186342854 13194139535303 true] [17592186342851 1000 #edb/ref 17592186342855 13194139535303 true] [17592186342851 1000 #edb/ref 17592186342856 13194139535303 true] [17592186342851 1040 #edb/ref 17592186045450 13194139535303 true] [17592186342851 1041 "selection" 13194139535303 true] [17592186342851 1104 #edb/ref 17592186342856 13194139535303 true] [17592186342851 1110 #uuid "6610bfb8-5fcc-5cba-ae06-4a8a099de7dd" 13194139535303 true] [17592186342852 1034 "14\\pi " 13194139535303 true] [17592186342852 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342852 1111 #uuid "d143f9ca-cfdc-52a1-88ef-3ca911a71c7b" 13194139535303 true] [17592186342853 1034 "-7\\pi " 13194139535303 true] [17592186342853 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342853 1111 #uuid "e1ba467a-9da9-5198-bb20-105670a5b35e" 13194139535303 true] [17592186342854 1034 "7\\pi " 13194139535303 true] [17592186342854 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342854 1111 #uuid "1bd7e956-c4df-5113-9e6d-18022a206343" 13194139535303 true] [17592186342855 1034 "28\\pi " 13194139535303 true] [17592186342855 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342855 1111 #uuid "06bb92da-9b86-508d-9134-62cfe0a97f61" 13194139535303 true] [17592186342856 1034 "0" 13194139535303 true] [17592186342856 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342856 1111 #uuid "731bde59-f11a-53cd-a88e-23c8232e0d70" 13194139535303 true] [17592186342857 1017 #edb/ref 17592186342858 13194139535303 true] [17592186342857 1089 "q-127153" 13194139535303 true] [17592186342857 1091 #edb/ref 17592186045465 13194139535303 true] [17592186342857 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/fbfe241043e9014c1b633d163cf7e06234db70702a9052297b5df8b9df3fd82f.png)\n\nCalculate the flux of the vector field $F(x,y)=x\\,i+{y}^{2}\\,j$ through the curve $C$ given by $r(t)=\\frac{1}{t}\\,i+t\\,j$ for $t\\in [\\frac{1}{2},2],$ measured with respect to the unit normal vector $n$ on $C,$ as shown above." 13194139535303 true] [17592186342857 1113 #uuid "bbd6b7d5-dad7-5c0e-bd3a-49f70eaa3031" 13194139535303 true] [17592186342857 1145 "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $F$ across $C$ measured with respect to a unit normal vector $n$ on $C$ is given by\n\n$$\n{\\int }_{C}F\\cdot n\\,\\text{d}s={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $n$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $T(t).$\n\nIn this case, $n$ is indeed a ${90}^{∘}$ clockwise rotation of $T,$ so we can apply the above formula. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/d432857e3350dfcb70a2a00b66ad9b86bc207382edd277c2169be0834c1710e0.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=\\frac{1}{t},\\,y=t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x=\\frac{1}{t}, \\\\ Q(x,y) & ={y}^{2}={t}^{2}.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})=-\\frac{1}{{t}^{2}}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{2}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1/2}^{2}(\\frac{1}{t})\\cdot (1)-({t}^{2})\\cdot (-\\frac{1}{{t}^{2}})\\,\\text{d}t \\\\  & ={\\int }_{1/2}^{2}\\frac{1}{t}+1\\,\\text{d}t \\\\  & =(\\operatorname{ln}⁡t+t){|}_{1/2}^{2} \\\\  & =(\\operatorname{ln}⁡2+2)-(\\operatorname{ln}⁡\\frac{1}{2}+\\frac{1}{2}) \\\\  & =2\\operatorname{ln}⁡2+\\frac{3}{2}\\end{aligned}\n$$" 13194139535303 true] [17592186342858 1000 #edb/ref 17592186342859 13194139535303 true] [17592186342858 1000 #edb/ref 17592186342860 13194139535303 true] [17592186342858 1000 #edb/ref 17592186342861 13194139535303 true] [17592186342858 1000 #edb/ref 17592186342862 13194139535303 true] [17592186342858 1000 #edb/ref 17592186342863 13194139535303 true] [17592186342858 1040 #edb/ref 17592186045450 13194139535303 true] [17592186342858 1041 "selection" 13194139535303 true] [17592186342858 1104 #edb/ref 17592186342859 13194139535303 true] [17592186342858 1110 #uuid "99417d4a-769e-5f0e-9aa2-bb671b7bf87d" 13194139535303 true] [17592186342859 1034 "2\\operatorname{ln}⁡2+\\frac{3}{2}" 13194139535303 true] [17592186342859 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342859 1111 #uuid "8329b4b7-6b69-5cf9-982f-f97724d72d96" 13194139535303 true] [17592186342860 1034 "-\\frac{3}{2}" 13194139535303 true] [17592186342860 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342860 1111 #uuid "8631ca9a-23d9-5c00-a