ed}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{cos}⁡t-16\\operatorname{sin}⁡t)\\cdot (\\operatorname{cos}⁡t)-(4\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4{cos}^{2}⁡t-16\\operatorname{sin}⁡t\\operatorname{cos}⁡t+16\\operatorname{sin}⁡t\\operatorname{cos}⁡t+4{sin}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\,\\text{d}t \\\\  & =4t\\,{|}_{0}^{2\\pi } \\\\  & =4(2\\pi -0) \\\\  & =8\\pi \\end{aligned}\n$$" 13194139535303 true] [17592186342809 1000 #edb/ref 17592186342810 13194139535303 true] [17592186342809 1000 #edb/ref 17592186342811 13194139535303 true] [17592186342809 1000 #edb/ref 17592186342812 13194139535303 true] [17592186342809 1000 #edb/ref 17592186342813 13194139535303 true] [17592186342809 1000 #edb/ref 17592186342814 13194139535303 true] [17592186342809 1040 #edb/ref 17592186045450 13194139535303 true] [17592186342809 1041 "selection" 13194139535303 true] [17592186342809 1104 #edb/ref 17592186342812 13194139535303 true] [17592186342809 1110 #uuid "f0afa333-a50f-521b-ae4f-9019720c3be8" 13194139535303 true] [17592186342810 1034 "-8\\pi " 13194139535303 true] [17592186342810 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342810 1111 #uuid "bd1f43bb-75b5-51ce-b47d-c5c53b05463d" 13194139535303 true] [17592186342811 1034 "4\\pi " 13194139535303 true] [17592186342811 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342811 1111 #uuid "1e64141b-2b34-5536-8988-238c143305fb" 13194139535303 true] [17592186342812 1034 "8\\pi " 13194139535303 true] [17592186342812 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342812 1111 #uuid "b0edc086-e4db-520f-a713-61ccfade5452" 13194139535303 true] [