,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}⁡t-3\\operatorname{cos}⁡t)\\cdot (3\\operatorname{cos}⁡t)-(-3\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t)\\cdot (-3\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{cos}^{2}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{sin}^{2}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }-({sin}^{2}⁡t+{cos}^{2}⁡t)\\,\\text{d}t \\\\  & =-9{\\int }_{0}^{2\\pi }\\,\\text{d}t \\\\  & =-9t\\,{|}_{0}^{2\\pi } \\\\  & =-9(2\\pi -0) \\\\  & =-18\\pi \\end{aligned}\n$$" 13194139535303 true] [17592186342844 1000 #edb/ref 17592186342845 13194139535303 true] [17592186342844 1000 #edb/ref 17592186342846 13194139535303 true] [17592186342844 1000 #edb/ref 17592186342847 13194139535303 true] [17592186342844 1000 #edb/ref 17592186342848 13194139535303 true] [17592186342844 1000 #edb/ref 17592186342849 13194139535303 true] [17592186342844 1040 #edb/ref 17592186045450 13194139535303 true] [17592186342844 1041 "selection" 13194139535303 true] [17592186342844 1104 #edb/ref 17592186342846 13194139535303 true] [17592186342844 1110 #uuid "37686ea6-ae29-5495-8729-e3508c7301c4" 13194139535303 true] [17592186342845 1034 "9\\pi " 13194139535303 true] [17592186342845 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342845 1111 #uuid "83566363-d32e-58c4-9f21-6695086c5902" 13194139535303 true] [17592186342846 1034 "-18\\pi " 13194139535303 true] [17592186342846 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342846 1111 #uuid "eae3cd37-c45b-5b2c-9c7b-e234e516ad8e" 13194139535303 true] [17592186342847 1034 "-9\\pi " 13194139535303 true] [17592186342847 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342847 1111 #uuid "24b3841e-3a58-559d-9f2b-9d1b371fc645" 13194139535303 true] [17592186342848 1034 "