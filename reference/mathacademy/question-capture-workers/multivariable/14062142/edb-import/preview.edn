\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({sin}^{3}⁡t)\\cdot (\\operatorname{cos}⁡t)-({cos}^{3}⁡t)\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{3}⁡t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t{cos}^{3}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t({sin}^{2}+{cos}^{2}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{0}u\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$" 13194139535303 true] [17592186342837 1000 #edb/ref 17592186342838 13194139535303 true] [17592186342837 1000 #edb/ref 17592186342839 13194139535303 true] [17592186342837 1000 #edb/ref 17592186342840 13194139535303 true] [17592186342837 1000 #edb/ref 17592186342841 13194139535303 true] [17592186342837 1000 #edb/ref 17592186342842 13194139535303 true] [17592186342837 1040 #edb/ref 17592186045450 13194139535303 true] [17592186342837 1041 "selection" 13194139535303 true] [17592186342837 1104 #edb/ref 17592186342840 13194139535303 true] [17592186342837 1110 #uuid "199de684-df9a-5e52-96da-33a9c2a2c613" 13194139535303 true] [17592186342838 1034 "2" 13194139535303 true] [17592186342838 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342838 1111 #uuid "86e62f91-bb49-5c00-89e2-42eeebe6f8d2" 13194139535303 true] [17592186342839 1034 "1" 13194139535303 true] [17592186342839 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342839 1111 #uuid "aeb1a41e-2532-5b6e-9c2e-afe361b983cc" 13194139535303 true] [17592186342840 1034 "0" 13194139535303 true] [17592186342840 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342840 1111 #uuid "e94b1e07-f431-523f-9965-d502316cf5db" 13194139535303 true] [17592186342841 1034 "-1" 13194139535303 true] [17592186342841 1103 #edb/ref 17592186045453 13194139535303 true] [17592186342841 1111 #uuid "d6baf4a7-03be-58ad-9fa9-2d59d6dc5a03" 1319413