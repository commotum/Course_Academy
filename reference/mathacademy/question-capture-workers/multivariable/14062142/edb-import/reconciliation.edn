{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(5\\operatorname{cos}⁡t)\\cdot (6\\operatorname{cos}⁡t)-(6\\operatorname{sin}⁡t)\\cdot (-5\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =30{\\int }_{0}^{2\\pi }({cos}^{2}⁡t+{sin}^{2}⁡t)\\,\\text{d}t \\\\  & =30{\\int }_{0}^{2\\pi }1\\,\\text{d}t \\\\  & =30(2\\pi -0) \\\\  & =60\\pi \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127077" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127077" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127077" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-30\\pi "] ["math" "-60\\pi "] ["math" "0"] ["math" "30\\pi "] ["math" "60\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127077" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "60\\pi "] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127140" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $F(x,y)=4x\\,i+4y\\,j$ across the closed curve $C$ given by $r(t)=8\\operatorname{cos}⁡t\\,i+6\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127140" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=8\\operatorname{cos}⁡t,\\,y=6\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =4x=4(8\\operatorname{cos}⁡t)=32\\operatorname{cos}⁡t, \\\\ Q(x,y) & =4y=4(6\\operatorname{sin}⁡t)=24\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(8\\operatorname{cos}⁡t)=-8\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(6\\operatorname{sin}⁡t)=6\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(32\\operatorname{cos}⁡t)\\cdot (6\\operatorname{cos}⁡t)-(24\\operatorname{sin}⁡t)\\cdot (-8\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }192({cos}^{2}⁡t+{sin}^{2}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }192\\,\\text{d}t \\\\  & =192t{|}_{0}^{2\\pi } \\\\  & =192(2\\pi -0) \\\\  & =384\\pi \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127140" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127140" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127140" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "192\\pi "] ["math" "24\\pi "] ["math" "32\\pi "] ["math" "384\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127140" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "384\\pi "] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127081" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $F(x,y)=y\\,i+9{x}^{3}\\,j$ across the closed curve $C$ given by $r(t)=\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j$ for $t\\in [0,2\\pi ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127081" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y=3\\operatorname{sin}⁡t, \\\\ Q(x,y) & =9{x}^{3}=9{cos}^{3}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $\\operatorname{cos}⁡t=u,du=-\\operatorname{sin}⁡t\\,dt,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}⁡t)\\cdot (3\\operatorname{cos}⁡t)-(9{cos}^{3}⁡t)\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t{cos}^{3}⁡t)\\,\\text{d}t \\\\  & =-9{\\int }_{1}^{1}(u+{u}^{3})\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127081" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127081" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127081" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-9"] ["math" "-\\frac{9}{2}"] ["math" "0"] ["math" "9"] ["math" "\\frac{9}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127081" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127080" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $F(x,y)=(x-16y)\\,i+(x+y)\\,j$ across the ellipse $C$ with equation ${x}^{2}+16{y}^{2}=16.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127080" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{1}^{2}}=1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $4$ and $1,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\nr(t)=4\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x-16y=4\\operatorname{cos}⁡t-16\\operatorname{sin}⁡t, \\\\ Q(x,y) & =x+y=4\\operatorname{cos}⁡t+\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{cos}⁡t-16\\operatorname{sin}⁡t)\\cdot (\\operatorname{cos}⁡t)-(4\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4{cos}^{2}⁡t-16\\operatorname{sin}⁡t\\operatorname{cos}⁡t+16\\operatorname{sin}⁡t\\operatorname{cos}⁡t+4{sin}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }4\\,\\text{d}t \\\\  & =4t\\,{|}_{0}^{2\\pi } \\\\  & =4(2\\pi -0) \\\\  & =8\\pi \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127080" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127080" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127080" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-4\\pi "] ["math" "-8\\pi "] ["math" "0"] ["math" "4\\pi "] ["math" "8\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127080" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8\\pi "] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127079" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $F(x,y)=3x\\,i+3y\\,j$ across the ellipse $C$ with equation $4{x}^{2}+16{y}^{2}=64.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127079" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\frac{{x}^{2}}{{4}^{2}}+\\frac{{y}^{2}}{{2}^{2}}=1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $4$ and $2,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\nr(t)=4\\operatorname{cos}⁡t\\,i+2\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=2\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =3x=12\\operatorname{cos}⁡t, \\\\ Q(x,y) & =3y=6\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t)=2\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(12\\operatorname{cos}⁡t)\\cdot (2\\operatorname{cos}⁡t)-(6\\operatorname{sin}⁡t)\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }24{cos}^{2}⁡t+24{sin}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }24\\,\\text{d}t \\\\  & =24t\\,{|}_{0}^{2\\pi } \\\\  & =24(2\\pi -0) \\\\  & =48\\pi \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127079" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127079" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127079" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-24\\pi "] ["math" "-48\\pi "] ["math" "0"] ["math" "24\\pi "] ["math" "48\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127079" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "48\\pi "] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127143" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $F(x,y)={y}^{3}\\,i+{x}^{3}\\,j$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=1$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127143" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={1}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $1.$ It can be parameterized in the counterclockwise direction as\n\n$$\nr(t)=\\operatorname{cos}⁡t\\,i+\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=\\operatorname{cos}⁡t,\\,y=\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & ={y}^{3}={sin}^{3}⁡t, \\\\ Q(x,y) & ={x}^{3}={cos}^{3}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t)=\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }({sin}^{3}⁡t)\\cdot (\\operatorname{cos}⁡t)-({cos}^{3}⁡t)\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }{sin}^{3}⁡t\\operatorname{cos}⁡t+\\operatorname{sin}⁡t{cos}^{3}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t({sin}^{2}+{cos}^{2}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{0}u\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127143" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127143" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127143" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "0"] ["math" "1"] ["math" "2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127143" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127144" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $F(x,y)=(y-x)\\,i-(x+y)\\,j$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=9$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127144" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={3}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $1.$ It can be parameterized in the counterclockwise direction as\n\n$$\nr(t)=3\\operatorname{cos}⁡t\\,i+3\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=3\\operatorname{cos}⁡t,\\,y=3\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y-x=3\\operatorname{sin}⁡t-3\\operatorname{cos}⁡t, \\\\ Q(x,y) & =-(x+y)=-3\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)=-3\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}⁡t-3\\operatorname{cos}⁡t)\\cdot (3\\operatorname{cos}⁡t)-(-3\\operatorname{cos}⁡t-3\\operatorname{sin}⁡t)\\cdot (-3\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }(\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{cos}^{2}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{sin}^{2}⁡t)\\,\\text{d}t \\\\  & =9{\\int }_{0}^{2\\pi }-({sin}^{2}⁡t+{cos}^{2}⁡t)\\,\\text{d}t \\\\  & =-9{\\int }_{0}^{2\\pi }\\,\\text{d}t \\\\  & =-9t\\,{|}_{0}^{2\\pi } \\\\  & =-9(2\\pi -0) \\\\  & =-18\\pi \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127144" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127144" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127144" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-18\\pi "] ["math" "-9\\pi "] ["math" "0"] ["math" "18\\pi "] ["math" "9\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127144" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-18\\pi "] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127145" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $F(x,y)=y\\,i-2x\\,j$ across the circle $C$ with equation ${x}^{2}+{y}^{2}=16.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127145" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $F$ across $C$ is given by\n\n$$\n{∮}_{C}F\\cdot n\\,\\text{d}s={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x,\n$$\n\nwhere $n$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n{x}^{2}+{y}^{2}={4}^{2}.\n$$\n\nThe closed curve $C$ is a circle centered at the origin with the radius $4.$ It can be parameterized in the counterclockwise direction as\n\n$$\nr(t)=4\\operatorname{cos}⁡t\\,i+4\\operatorname{sin}⁡t\\,j,\\,0\\le t\\le 2\\pi .\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx=4\\operatorname{cos}⁡t,\\,y=4\\operatorname{sin}⁡t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y=4\\operatorname{sin}⁡t, \\\\ Q(x,y) & =-2x=-8\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\operatorname{sin}⁡t,\\text{d}u=\\operatorname{cos}⁡t\\,\\text{d}t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4\\operatorname{sin}⁡t)\\cdot (4\\operatorname{cos}⁡t)-(-8\\operatorname{cos}⁡t)\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(-16\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\,\\text{d}t \\\\  & =-16{\\int }_{0}^{0}u\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127145" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127145" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127145" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-7\\pi "] ["math" "0"] ["math" "14\\pi "] ["math" "28\\pi "] ["math" "7\\pi "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127145" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127153" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/fbfe241043e9014c1b633d163cf7e06234db70702a9052297b5df8b9df3fd82f.png)\n\nCalculate the flux of the vector field $F(x,y)=x\\,i+{y}^{2}\\,j$ through the curve $C$ given by $r(t)=\\frac{1}{t}\\,i+t\\,j$ for $t\\in [\\frac{1}{2},2],$ measured with respect to the unit normal vector $n$ on $C,$ as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127153" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $F$ across $C$ measured with respect to a unit normal vector $n$ on $C$ is given by\n\n$$\n{\\int }_{C}F\\cdot n\\,\\text{d}s={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $n$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $T(t).$\n\nIn this case, $n$ is indeed a ${90}^{∘}$ clockwise rotation of $T,$ so we can apply the above formula. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/d432857e3350dfcb70a2a00b66ad9b86bc207382edd277c2169be0834c1710e0.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=\\frac{1}{t},\\,y=t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =x=\\frac{1}{t}, \\\\ Q(x,y) & ={y}^{2}={t}^{2}.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{t})=-\\frac{1}{{t}^{2}}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{2}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1/2}^{2}(\\frac{1}{t})\\cdot (1)-({t}^{2})\\cdot (-\\frac{1}{{t}^{2}})\\,\\text{d}t \\\\  & ={\\int }_{1/2}^{2}\\frac{1}{t}+1\\,\\text{d}t \\\\  & =(\\operatorname{ln}⁡t+t){|}_{1/2}^{2} \\\\  & =(\\operatorname{ln}⁡2+2)-(\\operatorname{ln}⁡\\frac{1}{2}+\\frac{1}{2}) \\\\  & =2\\operatorname{ln}⁡2+\\frac{3}{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127153" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127153" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127153" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-2\\operatorname{ln}⁡2-\\frac{3}{2}"] ["math" "-\\frac{3}{2}"] ["math" "0"] ["math" "2\\operatorname{ln}⁡2+\\frac{3}{2}"] ["math" "\\frac{3}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127153" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2\\operatorname{ln}⁡2+\\frac{3}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127253" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/cd21413d8eea5e2fec67eebe22967c846fd7916fd4fb0fbe5f8efe7ac9df6b1a.png)\n\nThe curve $C$ is given by $y=1-x$ from the point $(0,1)$ to the point $(1,0).$ Calculate the flux of the vector field $F(x,y)=\\,i+\\,j$ through $C,$ measured with respect to the unit normal vector $n$ on $C,$ as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127253" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $F$ across $C$ measured with respect to a unit normal vector $n$ on $C$ is given by\n\n$$\n{\\int }_{C}F\\cdot n\\,\\text{d}s={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $n$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $T(t).$\n\nParameterizing the curve $C,$ we have\n\n$$\nx=t,\\,y=1-t,\\,t\\in [0,1].\n$$\n\n \n\nThis parameterization traverses the curve from the point $(0,1)$ to the point $(1,0).$ Therefore, $n$ is indeed a ${90}^{∘}$ clockwise rotation of $T,$ so we can apply the above formula for the flux. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/e288ed1095be61e4645fb63c22b7fd2cb605d34795c30557e84afb31b7ec8721.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =1, \\\\ Q(x,y) & =1.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-t)=-1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}(1)\\cdot (-1)-(1)\\cdot (1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}-2\\,\\text{d}t \\\\  & =(-2t){|}_{0}^{1} \\\\  & =-2-0 \\\\  & =-2\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127253" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127253" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127253" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "0"] ["math" "1"] ["math" "2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127253" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-126943" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/27fe7019b715ca8f4d07a3f5e7f6ddc312288a135cb1dcb197aacbb98765cdf9.png)\n\nThe curve $C$ is given by ${y}^{2}=4x$ from the point $(0,0)$ to the point $(1,2).$ Calculate the flux of the vector field $F(x,y)=2\\,i-4\\,j$ through $C,$ measured with respect to the unit normal vector $n$ on $C,$ as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-126943" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $F$ across $C$ measured with respect to a unit normal vector $n$ on $C$ is given by\n\n$$\n{\\int }_{C}F\\cdot n\\,\\text{d}s={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $n$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $T(t).$\n\nParameterizing the curve $C,$ we have\n\n$$\nx=\\frac{1}{4}{t}^{2},\\,y=t,\\,t\\in [0,2].\n$$\n\n \n\nThis parameterization traverses the curve from the point $(0,0)$ to the point $(1,2.)$ Therefore, $n$ is indeed a ${90}^{∘}$ clockwise rotation of $T,$ so we can apply the above formula for the flux. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/b7ac1ce4a79528f5660b8f898739da72489ebe8e8fc156020efae77a103fbec4.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =2, \\\\ Q(x,y) & =-4.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{4}{t}^{2})=\\frac{1}{2}t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2}(2)\\cdot (1)-(-4)\\cdot (\\frac{1}{2}t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2}2+2t\\,\\text{d}t \\\\  & =(2t+{t}^{2}){|}_{0}^{2} \\\\  & =(2\\cdot 2+{2}^{2})-0 \\\\  & =8\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-126943" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-126943" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-126943" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-16"] ["math" "-8"] ["math" "12"] ["math" "16"] ["math" "8"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-126943" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127223" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/414611a90c2227ff163d40a4f6f560bc67c471fa0f35724e459cec280e4904f9.png)\n\nCalculate the flux of the vector field $F(x,y)=4\\,i+2\\,j$ through the curve $C$ given by $r(t)=\\frac{t}{2}\\,i+\\frac{1}{2t}\\,j$ for $t\\in [\\frac{1}{2},2],$ measured with respect to the unit normal vector $n$ on $C,$ as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127223" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $F$ across $C$ measured with respect to a unit normal vector $n$ on $C$ is given by\n\n$$\n{\\int }_{C}F\\cdot n\\,\\text{d}s={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $n$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $T(t).$\n\nIn this case, $n$ is indeed a ${90}^{∘}$ clockwise rotation of $T,$ so we can apply the above formula. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/11376e6ef18b151a6dd1a02dd09f20b72bce3160c718f4095b4f08b23721ff1f.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=\\frac{t}{2},\\,y=\\frac{1}{2t}.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =4, \\\\ Q(x,y) & =2.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{t}{2})=\\frac{1}{2}, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2t})=-\\frac{1}{2{t}^{2}}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{1/2}^{2}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{1/2}^{2}(4)\\cdot (-\\frac{1}{2{t}^{2}})-(2)\\cdot (\\frac{1}{2})\\,\\text{d}t \\\\  & ={\\int }_{1/2}^{2}-\\frac{2}{{t}^{2}}-1\\,\\text{d}t \\\\  & =(\\frac{2}{t}-t){|}_{1/2}^{2} \\\\  & =(1-2)-(4-\\frac{1}{2}) \\\\  & =-\\frac{9}{2}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127223" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127223" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127223" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\frac{3}{2}"] ["math" "-\\frac{9}{2}"] ["math" "0"] ["math" "\\frac{3}{2}"] ["math" "\\frac{9}{2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127223" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{9}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127233" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/9bb15934c271a17851342b9032f5096f48e7ac9ee4e149af92ac1010dea46d88.png)\n\nCalculate the flux of the vector field $F(x,y)=3xy\\,i+(2x+1)\\,j$ through the curve $C$ given by $r(t)=t\\,i+t\\,j$ for $t\\in [0,1],$ measured with respect to the unit normal vector $n$ on $C,$ as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127233" "field" nil "attribute" "question/worked-solution" "value" "If $F=P\\,i+Q\\,j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $F$ across $C$ measured with respect to a unit normal vector $n$ on $C$ is given by\n\n$$\n{\\int }_{C}F\\cdot n\\,\\text{d}s={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $n$ *must* be a ${90}^{∘}$ clockwise rotation of the unit tangent vector $T(t).$\n\nIn this case, $n$ is indeed a ${90}^{∘}$ clockwise rotation of $T,$ so we can apply the above formula. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/0e751adb9f44d24ba89af318fe5f063b1be146bbae45d05fc2dd9a99bef259f2.png)\n\nAlong the curve $C,$ we have\n\n$$\nx=t,\\,y=t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =3xy=3{t}^{2}, \\\\ Q(x,y) & =2x+1=2t+1.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{1}(3{t}^{2})(1)-(2t+1)(1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}3{t}^{2}-2t-1\\,\\text{d}t \\\\  & =({t}^{3}-{t}^{2}-t){|}_{0}^{1} \\\\  & =(1-1-1)-(0-0-0) \\\\  & =-1\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127233" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/activity-metadata.json" "file_sha256" "200349b5b389a316f845fccfa51ea969477adead3846fc8f84179d3abac98463"} {"question" "q-127233" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127233" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "0"] ["math" "1"] ["math" "2"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "q-127233" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/state.json" "file_sha256" "050f6132b91122117a4817d852115130552ab313e152a4ad8d636afa53c76f92"} {"question" "e-9560" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $\\mathbf F(x,y) = (y - x)\\,\\mathbf{i} - (x + y )\\,\\mathbf{j}$ across the closed curve $C$ given by $\\mathbf r(t) = 4\\cos t\\,\\mathbf{i} + 4\\sin t\\,\\mathbf{j}$ for $t \\in [0,2\\pi).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/example-9560.json" "file_sha256" "5705184e98ed473226a19ac4c376ba1cdff761a141ae5b41d5a770da043a470b"} {"question" "e-9560" "field" nil "attribute" "question/worked-solution" "value" "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nAlong the curve $C,$ we have\n\n$$\nx = 4\\cos t, \\qquad\n\ty = 4\\sin t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =y-x=4(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t), \\\\ Q(x,y) & =-(x+y)=-4(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t).\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{cos}⁡t)=-4\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{sin}⁡t)=4\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(4(\\operatorname{sin}⁡t-\\operatorname{cos}⁡t))\\cdot (4\\operatorname{cos}⁡t)-(-4(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t))\\cdot (-4\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & =16{\\int }_{0}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{cos}^{2}⁡t-\\operatorname{sin}⁡t\\operatorname{cos}⁡t-{sin}^{2}⁡t\\,\\text{d}t \\\\  & =16{\\int }_{0}^{2\\pi }(-1)\\,\\text{d}t \\\\  & =-16t{|}_{0}^{2\\pi } \\\\  & =-16(2\\pi -0) \\\\  & =-32\\pi \\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/example-9560.json" "file_sha256" "5705184e98ed473226a19ac4c376ba1cdff761a141ae5b41d5a770da043a470b"} {"question" "e-9561" "field" nil "attribute" "question/problem" "value" "Calculate the flux of the vector field $\\mathbf F(x,y) = xy\\,\\mathbf{i} + x^2\\,\\mathbf{j}$ across the ellipse $C$ with equation $9x^2 + y^2 = 9.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/example-9561.json" "file_sha256" "3343a986c3e84e35fc08c11d1754ae971b99cd5fb2b24122effd8993c4d970aa"} {"question" "e-9561" "field" nil "attribute" "question/worked-solution" "value" "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x,\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C.$ \n\nFirst, we write the equation of our curve as\n\n$$\n\\dfrac{x^2}{1^2}+\\dfrac{y^2}{3^2} = 1.\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $1$ and $3,$ respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t) = \\cos{t}\\,\\mathbf{i} +3\\sin{t}\\,\\mathbf{j},\n\\qquad 0 \\leq t \\leq 2\\pi.\n$$\n\nAlong the curve $C,$ we have\n\n$$\nx = \\cos t, \\qquad\ny = 3\\sin t.\n$$\n\n \n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =xy=3\\operatorname{sin}⁡t\\operatorname{cos}⁡t, \\\\ Q(x,y) & ={x}^{2}={cos}^{2}⁡t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t)=-\\operatorname{sin}⁡t, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)=3\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution $u=\\cos t, \\textrm d u = -\\sin t\\,\\textrm d t,$ as follows:\n\n$$\n\\begin{aligned}{∮}_{C}F\\cdot n\\,\\text{d}s & ={∮}_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{2\\pi }(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }(3\\operatorname{sin}⁡t\\operatorname{cos}⁡t)\\cdot (3\\operatorname{cos}⁡t)-({cos}^{2}⁡t)\\cdot (-\\operatorname{sin}⁡t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }9\\operatorname{sin}⁡t{cos}^{2}⁡t+\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & ={\\int }_{0}^{2\\pi }10\\operatorname{sin}⁡t{cos}^{2}⁡t\\,\\text{d}t \\\\  & =-{\\int }_{1}^{1}10{u}^{2}\\,\\text{d}u \\\\  & =0\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/example-9561.json" "file_sha256" "3343a986c3e84e35fc08c11d1754ae971b99cd5fb2b24122effd8993c4d970aa"} {"question" "e-9574" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/6eebbc5ae9f548f5b00de9a12d454fa788884bf73ad46a1065eab0d26330a921.png)\n\nThe curve $C$ is given by $y = \\dfrac14x^2$ from the point $\\left(0,0\\right)$ to the point $\\left(4,4\\right).$ Calculate the flux of the vector field $\\mathbf F(x,y) = -2\\,\\mathbf{i} + x\\,\\mathbf{j}$ through $C,$ measured with respect to the unit normal vector $\\mathbf n$ on $C,$ as shown above." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/example-9574.json" "file_sha256" "38d5c94519ff8f26b9d3aafc64f7a5845cce3fa984121745f1b4b782cf5e73c1"} {"question" "e-9574" "field" nil "attribute" "question/worked-solution" "value" "If $\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j$ is a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf F$ across $C$ measured with respect to a unit normal vector $\\mathbf n$ on $C$ is given by\n\n$$\n\\int\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\int\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x.\n$$\n\nTo apply this formula, \n\n- the curve should be parameterized as $\\mathbf r(t)$ for $t\\in [a,b],$ and\n\n- the unit normal vector $\\mathbf n$ *must* be a $90^\\circ$ clockwise rotation of the unit tangent vector $\\mathbf T(t).$\n\nParameterizing the curve $C,$ we have\n\n$$\nx = t, \\qquad\ny = \\dfrac{t^2}{4},\n\\qquad\nt\\in \\left[0,4\\right].\n$$\n\n \n\nThis parameterization traverses the curve from the point $(0,0)$ to the point $(4,4).$ Therefore, $\\mathbf n$ is indeed a $90^\\circ$ clockwise rotation of $\\mathbf T,$ so we can apply the above formula for the flux. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/assets/2b94e24344f600fc02ec5ecac6c1e0ee4c6a5450132753a0a5ac5fceaa9aa1fc.png)\n\nTherefore,\n\n$$\n\\begin{aligned}P(x,y) & =-2, \\\\ Q(x,y) & =x=t.\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1, \\\\ \\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{{t}^{2}}{4})=\\frac{t}{2}.\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}F\\cdot n\\,\\text{d}s & ={\\int }_{C}P\\,\\text{d}y-Q\\,\\text{d}x \\\\  & ={\\int }_{0}^{4}(P\\cdot \\frac{\\text{d}y}{\\text{d}t}-Q\\cdot \\frac{\\text{d}x}{\\text{d}t})\\text{d}t \\\\  & ={\\int }_{0}^{4}(-2)\\cdot (\\frac{t}{2})-(t)\\cdot (1)\\,\\text{d}t \\\\  & ={\\int }_{0}^{4}-2t\\,\\text{d}t \\\\  & =-{t}^{2}{|}_{0}^{4} \\\\  & =-16-0 \\\\  & =-16\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14062142/example-9574.json" "file_sha256" "38d5c94519ff8f26b9d3aafc64f7a5845cce3fa984121745f1b4b782cf5e73c1"}] "usage" {"q-126943" [] "e-9561" [] "e-9560" [] "e-9574" []} "basis" 1990 "retractions" [[17592186179970 :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/3716/Source/Images/q-126943.png)\n\nThe curve $C$ is given by $y^{2} = 4x$ from the point $(0, 0)$ to the point $(1, 2)$. Calculate the flux of the vector field $F(x, y) = 2i - 4j$ through $C$, measured with respect to the unit normal vector $n$ on $C$, as shown above."] [17592186179536 :question/problem "Calculate the flux of the vector field $\\mathbf F(x,y) = (y - x)\\,\\mathbf{i} - (x + y)\\,\\mathbf{j}$ across the closed curve $C$ given by $\\mathbf r(t) = 4\\cos t\\,\\mathbf{i} + 4\\sin t\\,\\mathbf{j}$ for $[MATH: t \\in [0,2\\pi).]$"] [17592186179536 :question/worked-solution "If\n\n$$\n\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j\n$$\n\nis a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C$.\n\nAlong the curve $C$, we have\n\n$$\nx = 4\\cos t, \\qquad y = 4\\sin t\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(x, y) &= y - x = 4(\\sin t - \\cos t), \\\\\nQ(x, y) &= - (x + y) =-4(\\cos t + \\sin t)\n\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\n\\frac{dx}{dt} &= \\frac{d}{dt}(4\\cos t) =-4\\sin t, \\\\\n\\frac{dy}{dt} &= \\frac{d}{dt}(4\\sin t) = 4\\cos t\n\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\n∮_(C)F \\cdot nds &= ∮_(C)Pdy - Qdx \\\\\n&= ∫_{0}^{2π}(P \\cdot \\frac{dy}{dt} - Q \\cdot \\frac{dx}{dt})dt \\\\\n&= ∫_{0}^{2π}(4(\\sin t - \\cos t)) \\cdot (4\\cos t) - (-4(\\cos t + \\sin t)) \\cdot (-4\\sin t)dt \\\\\n&= 16∫_{0}^{2π}\\sin t\\cos t - \\cos^{2} t - \\sin t\\cos t - \\sin^{2} tdt \\\\\n&= 16∫_{0}^{2π}(-1)dt \\\\\n&=-16t \\mid _{0}^{2π} \\\\\n&=-16(2π - 0) \\\\\n&=-32π\n\\end{aligned}\n$$"] [17592186179537 :question/problem "Calculate the flux of the vector field $\\mathbf F(x,y) = xy\\,\\mathbf{i} + x^2\\,\\mathbf{j}$ across the ellipse $C$ with equation $9x^2 + y^2 = 9$."] [17592186179537 :question/worked-solution "If\n\n$$\n\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j\n$$\n\nis a vector field and $C$ is a piecewise-smooth, simple, closed curve, then the flux of $\\mathbf F$ across $C$ is given by\n\n$$\n\\oint\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\oint\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x\n$$\n\nwhere $\\mathbf{n}$ denotes the outward-pointing unit normal vector to $C$.\n\nFirst, we write the equation of our curve as\n\n$$\n\\dfrac{x^2}{1^2}+\\dfrac{y^2}{3^2} = 1\n$$\n\nThe closed curve $C$ is an ellipse centered at the origin with horizontal and vertical semiaxes $1$ and $3$, respectively. It can be parameterized in the counterclockwise direction as\n\n$$\n\\mathbf{r}(t) = \\cos{t}\\,\\mathbf{i} +3\\sin{t}\\,\\mathbf{j}, \\qquad 0 \\leq t \\leq 2\\pi\n$$\n\nAlong the curve $C$, we have\n\n$$\nx = \\cos t, \\qquad y = 3\\sin t\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(x, y) &= xy = 3\\sin t\\cos t, \\\\\nQ(x, y) &= x^{2} = \\cos^{2} t\n\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\n\\frac{dx}{dt} &= \\frac{d}{dt}(\\cos t) =-\\sin t, \\\\\n\\frac{dy}{dt} &= \\frac{d}{dt}(3\\sin t) = 3\\cos t\n\\end{aligned}\n$$\n\nFinally, we evaluate the integral using the substitution\n\n$$\nu=\\cos t, \\textrm d u = -\\sin t\\,\\textrm d t\n$$\n\nas follows:\n\n$$\n\\begin{aligned}\n∮_(C)F \\cdot nds &= ∮_(C)Pdy - Qdx \\\\\n&= ∫_{0}^{2π}(P \\cdot \\frac{dy}{dt} - Q \\cdot \\frac{dx}{dt})dt \\\\\n&= ∫_{0}^{2π}(3\\sin t\\cos t) \\cdot (3\\cos t) - (\\cos^{2} t) \\cdot (-\\sin t)dt \\\\\n&= ∫_{0}^{2π}9\\sin t\\cos^{2} t + \\sin t\\cos^{2} tdt \\\\\n&= ∫_{0}^{2π}10\\sin t\\cos^{2} tdt \\\\\n&= - ∫_{1}^{1}10u^{2}du \\\\\n&= 0\n\\end{aligned}\n$$"] [17592186179538 :question/problem "The curve $C$ is given by $y = \\dfrac14x^2$ from the point $\\left(0,0\\right)$ to the point $\\left(4,4\\right)$. Calculate the flux of the vector field $\\mathbf F(x,y) = -2\\,\\mathbf{i} + x\\,\\mathbf{j}$ through $C$, measured with respect to the unit normal vector $\\mathbf n$ on $C$, as shown above.\n\n![](/home/jake/Developer/MA/DATA/Lessons/3716/Source/Images/3c3cd3d66ea52e21e2fe90aa0d9971f2.png)"] [17592186179538 :question/worked-solution "If\n\n$$\n\\mathbf{F} = P\\,\\mathbf i + Q\\,\\mathbf j\n$$\n\nis a vector field and $C$ is a piecewise-smooth, simple curve, then the flux of $\\mathbf F$ across $C$ measured with respect to a unit normal vector $\\mathbf n$ on $C$ is given by\n\n$$\n\\int\\limits_C \\mathbf F \\cdot \\mathbf{n} \\: \\textrm{d}s = \\int\\limits_{C}P\\,\\textrm d y - Q\\,\\textrm d x\n$$\n\nTo apply this formula,\n\n- the curve should be parameterized as $\\mathbf r(t)$ for $t\\in [a,b]$, and\n- the unit normal vector $\\mathbf n$ *must* be a $90^\\circ$ clockwise rotation of the unit tangent vector $\\mathbf T(t)$.\n\nParameterizing the curve $C$, we have\n\n$$\nx = t, \\qquad y = \\dfrac{t^2}{4}, \\qquad t\\in \\left[0,4\\right]\n$$\n\nThis parameterization traverses the curve from the point $(0,0)$ to the point $(4,4)$. Therefore, $\\mathbf n$ is indeed a $90^\\circ$ clockwise rotation of $\\mathbf T$, so we can apply the above formula for the flux.\n\n![](/home/jake/Developer/MA/DATA/Lessons/3716/Source/Images/e4d6ca89f594b3d7ac45d34d2fda4a6b.png)\n\nTherefore,\n\n$$\n\\begin{aligned}\nP(x, y) &= -2, \\\\\nQ(x, y) &= x = t\n\\end{aligned}\n$$\n\nComputing the derivatives of $x(t)$ and $y(t)$ along the curve, we get\n\n$$\n\\begin{aligned}\n\\frac{dx}{dt} &= \\frac{d}{dt}(t) = 1, \\\\\n\\frac{dy}{dt} &= \\frac{d}{dt}(\\frac{t^{2}}{4}) = \\frac{t}{2}\n\\end{aligned}\n$$\n\nFinally, we evaluate the integral as follows:\n\n$$\n\\begin{aligned}\n∫_(C)F \\cdot nds &= ∫_(C)Pdy - Qdx \\\\\n&= ∫_{0}^{4}(P \\cdot \\frac{dy}{dt} - Q \\cdot \\frac{dx}{dt})dt \\\\\n&= ∫_{0}^{4}(-2) \\cdot (\\frac{t}{2}) - (t) \\cdot (1)dt \\\\\n&= ∫_{0}^{4} - 2tdt \\\\\n&=-t^{2} \\mid _{0}^{4} \\\\\n&=-16 - 0 \\\\\n&=-16\n\\end{aligned}\n$$"]] "immutable_answers" [17592186177821 17592186177822 17592186177823 17592186177824 17592186177825] "immutable_fields" [[17592186177820 :answer-field/correct] [17592186177820 :answer-field/id] [17592186177820 :answer-field/key] [17592186177820 :answer-field/type]] "no_history" []}
