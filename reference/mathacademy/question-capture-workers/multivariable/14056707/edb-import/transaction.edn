int }_{3}^{5}3{r}^{2}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-85061/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1f13c3a8-ba48-5299-b335-3752e8b92ef4"] :knowledge-point/questions ["q-85061"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85177/selection/25a151fd4882732d741e93074f41083d8f8d132ed663136ae724b9d5584505b7" :answer/id #uuid "24fecbcd-671e-5be7-8f3d-4d81ab09bddd" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85177/selection/262b9f4ea8ac46ba5b1541580f0ef518f9a9b44a662b3b107110a778ef644667" :answer/id #uuid "c9b29140-5283-5e62-b4ee-c41f0020750a" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}r\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85177/selection/0730774969d651fc5ed88752684795e8cd67b396de79cb735a03caf94dd38235" :answer/id #uuid "ec658ba7-e967-53d2-b7a5-46ef3845b9a3" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85177/selection/8ff9c672e629aa4221b9b62a669d90fc0515b99b82821acd6b9e9d5691c1febc" :answer/id #uuid "7602d930-bd07-50d5-839b-8dafc8b23da3" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}r\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85177/selection/6bde88309d6c86ded4dd3ce4289429b99e4ecda666d1a2ca29811b5148eda7ea" :answer/id #uuid "e0a657e5-a5af-57ad-af07-4c7ea7556e57" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85177/selection" :answer-field/id #uuid "dea87252-16b5-5057-9ca7-d8e94d8d267d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85177/selection/0730774969d651fc5ed88752684795e8cd67b396de79cb735a03caf94dd38235" :answer-field/choices ["q-85177/selection/25a151fd4882732d741e93074f41083d8f8d132ed663136ae724b9d5584505b7" "q-85177/selection/262b9f4ea8ac46ba5b1541580f0ef518f9a9b44a662b3b107110a778ef644667" "q-85177/selection/0730774969d651fc5ed88752684795e8cd67b396de79cb735a03caf94dd38235" "q-85177/selection/8ff9c672e629aa4221b9b62a669d90fc0515b99b82821acd6b9e9d5691c1febc" "q-85177/selection/6bde88309d6c86ded4dd3ce4289429b99e4ecda666d1a2ca29811b5148eda7ea"] :db/ensure [:answer-field/validate]} {:db/id "q-85177" :question/id #uuid "7058f657-11d2-5523-91ce-8187030a00b5" :question/math-academy-id "q-85177" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/97dfdde016e4c3482fe036379e22aa95af27c1bcf93076ea9054e263100ad8e1.png)\n\nThe region $D$ in the second quadrant is enclosed between two quarter-circles centered at $O$ of radii $3$ and $4,$ as shown above. What is \n${∬}_{D}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $3$ and $4$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,3\\le r\\le 4,\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{r\\operatorname{sin}⁡\\theta }{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}\\frac{{r}^{2}\\operatorname{sin}⁡\\theta }{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{3}^{4}\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-85177/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1f13c3a8-ba48-5299-b335-3752e8b92ef4"] :knowledge-point/questions ["q-85177"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-85059"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/6f7f37b10d483f7ce2bf147f316195b4be578ae62da8538a3aac4a8dbfa2ec1c.png)\n\nThe region $D$ in the upper-half plane is enclosed between two semi-circles centered at $O$ of radii $1$ and $2,$ as shown above. What is\n${∬}_{D}(x-y)\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $1$ and $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,1\\le r\\le 2,\\,0\\le \\theta \\le \\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}(x-y)\\,\\text{d}x\\text{d}y & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta -r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{1}^{2}r(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{1}^{2}{r}^{2}(\\operatorname{cos}⁡\\theta -\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-161079/selection/6cd8463c453b6e15ecae2d28818c2bb29fc9cc4e9aa3e2d96bd4ffb2cb3e07d3" :answer/id #uuid "2e824e3f-6818-52e6-8e93-cf30bbce3ccf" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{3}\\operatorname{sin}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161079/selection/feffe5619b0ef6c7df02f1295ba38c626ab80761824f49c69ab46e6138fa8124" :answer/id #uuid "cf1794e4-5a4f-5d99-a469-93b0685a8f66" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{1}^{2}(2{r}^{2}\\operatorname{sin}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161079/selection/2112bfb200189d6e5ae9008492861cac8c419062b1ec6c71bc74d6293c8635e9" :answer/id #uuid "e9f57136-53c9-5d5b-81a3-d361f456559b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2\\pi }{\\int }_{1}^{2}(\\frac{{r}^{2}\\operatorname{sin}⁡\\theta }{2})\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161079/selection/a4b10a02938ae4f148b01c85ab7bab5a2c5b1c66fe80095268a7884eb9cbe572" :answer/id #uuid "8dcdb2b0-87a5-52ad-8fdc-940d513c7609" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}{\\int }_{0}^{\\pi }({r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161079/selection/602b414e82fcea386986e76d3a19f34e54726969e29506d99f427a95b7239a3b" :answer/id #uuid "3622aad5-b996-5d34-9f22-6444517decc8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{0}^{2}({r}^{2}\\operatorname{sin}⁡\\theta \\operatorname{cos}⁡\\theta )\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161079/selection" :answer-field/id #uuid "982f2593-50a7-5034-a02e-038a5a3354b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161079/selection/6cd8463c453b6e15ecae2d28818c2bb29fc9cc4e9aa3e2d96bd4ffb2cb3e07d3" :answer-field/choices ["q-161079/selection/6cd8463c453b6e15ecae2d28818c2bb29fc9cc4e9aa3e2d96bd4ffb2cb3e07d3" "q-161079/selection/feffe5619b0ef6c7df02f1295ba38c626ab80761824f49c69ab46e6138fa8124" "q-161079/selection/2112bfb200189d6e5ae9008492861cac8c419062b1ec6c71bc74d6293c8635e9" "q-161079/selection/a4b10a02938ae4f148b01c85ab7bab5a2c5b1c66fe80095268a7884eb9cbe572" "q-161079/selection/602b414e82fcea386986e76d3a19f34e54726969e29506d99f427a95b7239a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-161079" :question/id #uuid "108e2d2a-b886-54f8-90a0-21329e09bdb3" :question/math-academy-id "q-161079" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/4da25a7fcce468774aafcf2c1dbf7b4ef65089194d0330b1159d18a9a8f4bfe9.png)\n\nThe region $D$ in the plane is enclosed between two circles centered at $O$ of radii $1$ and $2,$ as shown above. What is\n${∬}_{D}2xy\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form \n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $1$ and $2$ centered at the origin. In polar coordinates $(r,\\theta ),$ the region can be expressed as \n\n$$\nΔ={(r,\\theta )\\,:\\,1\\le r\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}2xy\\,\\text{ }dA & ={∬}_{Δ}2(r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{2}(2\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{2}{r}^{3}\\operatorname{sin}⁡2\\theta \\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161079/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1f13c3a8-ba48-5299-b335-3752e8b92ef4"] :knowledge-point/questions ["q-161079"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85182/selection/919a599297a57c011e0222e2f498b9044afbc92690a73ad94813026cb7f91d83" :answer/id #uuid "336d5bf2-8491-50f7-8dd5-b20cd2e60752" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{\\pi /6}\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta {\\int }_{3\\operatorname{sec}⁡\\theta }^{4\\operatorname{cos}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85182/selection/7f845216ae6f1b15646267624e8691b523b9d2f4686c5375e4abfe97951f1d84" :answer/id #uuid "cc4e5c03-69bd-5bcc-98d5-c67fe9f8b68c" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{0}\\operatorname{tan}⁡\\theta {\\int }_{3\\operatorname{sec}⁡\\theta }^{4\\operatorname{cos}⁡\\theta }\\frac{1}{r}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85182/selection/7a5b2ec17b440a90f5bd6a4c164a5fc43eca9687401b1a2ea812a5948f6a5cd4" :answer/id #uuid "e7ae53ac-ece4-5e32-9274-27693c9942c7" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{0}{sec}^{2}⁡\\theta {\\int }_{3\\operatorname{sec}⁡\\theta }^{4\\operatorname{cos}⁡\\theta }{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85182/selection/bed9a6684bea6a75dff2825babe64ee463f6da9738542b4abd4a35fb8ae727f4" :answer/id #uuid "cbea9882-f2d4-5070-a77b-27824dc1647b" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{0}\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta {\\int }_{3\\operatorname{sec}⁡\\theta }^{4\\operatorname{cos}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85182/selection/5bfb1664c8ee0b536bd7a69f37451612dff3c47c0c1b4be1f697a2ec2565a4ad" :answer/id #uuid "e09fa82b-f6ce-55f8-8aaa-4ed16725fb62" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /6}^{0}\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta {\\int }_{3}^{4}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85182/selection" :answer-field/id #uuid "5b9741a1-096b-5dea-8215-2114e0d558e0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85182/selection/bed9a6684bea6a75dff2825babe64ee463f6da9738542b4abd4a35fb8ae727f4" :answer-field/choices ["q-85182/selection/919a599297a57c011e0222e2f498b9044afbc92690a73ad94813026cb7f91d83" "q-85182/selection/7f845216ae6f1b15646267624e8691b523b9d2f4686c5375e4abfe97951f1d84" "q-85182/selection/7a5b2ec17b440a90f5bd6a4c164a5fc43eca9687401b1a2ea812a5948f6a5cd4" "q-85182/selection/bed9a6684bea6a75dff2825babe64ee463f6da9738542b4abd4a35fb8ae727f4" "q-85182/selection/5bfb1664c8ee0b536bd7a69f37451612dff3c47c0c1b4be1f697a2ec2565a4ad"] :db/ensure [:answer-field/validate]} {:db/id "q-85182" :question/id #uuid "fd504b15-bc52-5a08-812b-fde09422adac" :question/math-academy-id "q-85182" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/51439321ae9d3760eb48d54351dbd519efe290c77d9197ca55aa590ce79e91a8.png)\n\nThe region $D$ is enclosed between the curve $(x-2)^{2}+{y}^{2}=4$ and the line $x=3,$ as shown above. What is\n${∬}_{D}\\frac{y}{{x}^{2}}\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $2$ centered at $(2,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For $(x-2)^{2}+{y}^{2}=4,$ we obtain\n\n$$\n\\begin{aligned}(x-2)^{2}+{y}^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta -2)^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta -4r\\operatorname{cos}⁡\\theta +4+{r}^{2}{sin}^{2}⁡\\theta  & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-4r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}-4r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r-4\\operatorname{cos}⁡\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=4\\operatorname{cos}⁡\\theta .$\n\n- For $x=3,$ we get\n\n$$\n\\begin{aligned}x & =3 \\\\ r\\operatorname{cos}⁡\\theta  & =3 \\\\ r & =\\frac{3}{\\operatorname{cos}⁡\\theta } \\\\ r & =3\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(3,-\\sqrt{3}).$ So, the entire region $D$ lies between the polar lines $\\theta =-\\frac{\\pi }{6}$ and $\\theta =0,$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/bf2d20acbb93d3c61e9890a49d1c15a08c2b4e18b474da421bded7cf3dafc297.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,3\\operatorname{sec}⁡\\theta \\le r\\le 4\\operatorname{cos}⁡\\theta ,\\,-\\frac{\\pi }{6}\\le \\theta \\le 0}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y}{{x}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{r\\operatorname{sin}⁡\\theta }{(r\\operatorname{cos}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /6}^{0}{\\int }_{3\\operatorname{sec}⁡\\theta }^{4\\operatorname{cos}⁡\\theta }\\frac{{r}^{2}\\operatorname{sin}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /6}^{0}\\operatorname{sec}⁡\\theta \\operatorname{tan}⁡\\theta {\\int }_{3\\operatorname{sec}⁡\\theta }^{4\\operatorname{cos}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85182/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aad77980-4324-5d52-a93f-a37ab3390ef8"] :knowledge-point/questions ["q-85182"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-83980"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/928fb72015b78436f95895799c2846d1a0b34242b7216d31a6ed6bdda46728a1.png)\n\nThe region $D$ is enclosed between the curve ${x}^{2}+{y}^{2}=16$ and the line $x=2\\sqrt{2},$ as shown above. What is\n${∬}_{D}\\frac{y}{x}\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $4$ centered at $(0,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=16,$ we obtain $r=4.$\n\n- For $x=2\\sqrt{2},$ we get\n\n$$\n\\begin{aligned}x & =2\\sqrt{2} \\\\ r\\operatorname{cos}⁡\\theta  & =2\\sqrt{2} \\\\ r & =\\frac{2\\sqrt{2}}{\\operatorname{cos}⁡\\theta } \\\\ r & =2\\sqrt{2}\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(2\\sqrt{2},2\\sqrt{2}).$ So, the entire region $D$ lies between the polar lines $\\theta =0$ and $\\theta =\\frac{\\pi }{4},$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/375e270ce444d9f62b50f9a25abfae781113fdad895833d693061ffffe93f5d3.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,2\\sqrt{2}\\operatorname{sec}⁡\\theta \\le r\\le 4,\\,0\\le \\theta \\le \\frac{\\pi }{4}}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{y}{x}\\,\\text{d}A & ={∬}_{Δ}\\frac{r\\operatorname{sin}⁡\\theta }{r\\operatorname{cos}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{2\\sqrt{2}\\operatorname{sec}⁡\\theta }^{4}r\\operatorname{tan}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{tan}⁡\\theta {\\int }_{2\\sqrt{2}\\operatorname{sec}⁡\\theta }^{4}r\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "q-85067/selection/86fe5aa045cac08685c4d17b8b086090fc2dbf2802f4d240c9c2a51c0f42090e" :answer/id #uuid "e204d77a-255f-5eec-9466-70c3fd2bd48f" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{3\\pi /4}{\\int }_{-\\operatorname{sec}⁡\\theta /\\sqrt{2}}^{1}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85067/selection/d26b634d10be1040fc38092fdb941097b96e9948939bb00ce227f2b92e2e4e4b" :answer/id #uuid "4a042657-2b55-58a3-847a-c5a36437f2e5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\pi }{\\int }_{\\sqrt{2}\\operatorname{sec}⁡\\theta }^{\\sqrt{2}}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85067/selection/af619e9d19754f2a9d74b96a779ae5eb2b7df40b5d84c526f74e91816b0cecc5" :answer/id #uuid "d1a0cfd5-1119-5025-bc84-f3c518bbc354" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }{\\int }_{-\\sqrt{2}\\operatorname{sec}⁡\\theta }^{1}r\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85067/selection/ad8a44d9d14bbea77c1ddd04986a12dcf7025ad233383988161f35c29b929cdf" :answer/id #uuid "77ecddd3-28de-5a61-b2d7-b749f8387b87" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi }{\\int }_{\\operatorname{sec}⁡\\theta /\\sqrt{2}}^{\\sqrt{2}}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85067/selection/a03773f75d25c7f18e738c038460fb1ae819a3480f069a6021b5ca03032be7d1" :answer/id #uuid "df7150db-979e-5a1d-875b-4b73a9f4806f" :answer/type :answer.type/math :answer/value "{\\int }_{3\\pi /4}^{\\pi }{\\int }_{-\\operatorname{sec}⁡\\theta /\\sqrt{2}}^{1}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85067/selection" :answer-field/id #uuid "3139e0e1-17d2-5c9e-b85c-96c6e707290b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85067/selection/a03773f75d25c7f18e738c038460fb1ae819a3480f069a6021b5ca03032be7d1" :answer-field/choices ["q-85067/selection/86fe5aa045cac08685c4d17b8b086090fc2dbf2802f4d240c9c2a51c0f42090e" "q-85067/selection/d26b634d10be1040fc38092fdb941097b96e9948939bb00ce227f2b92e2e4e4b" "q-85067/selection/af619e9d19754f2a9d74b96a779ae5eb2b7df40b5d84c526f74e91816b0cecc5" "q-85067/selection/ad8a44d9d14bbea77c1ddd04986a12dcf7025ad233383988161f35c29b929cdf" "q-85067/selection/a03773f75d25c7f18e738c038460fb1ae819a3480f069a6021b5ca03032be7d1"] :db/ensure [:answer-field/validate]} {:db/id "q-85067" :question/id #uuid "94aee767-7dc5-5c61-be85-11041ceb750d" :question/math-academy-id "q-85067" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/dc35d0362ef95d11402ad44cded01abf46686d3088e9d852bd0b9a7ba2454e16.png)\n\nThe region $D$ is enclosed between the curve ${x}^{2}+{y}^{2}=1$ and the line $x=-\\frac{\\sqrt{2}}{2},$ as shown above. What is\n${∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at $(0,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=1,$ we obtain $r=1.$\n\n- For $x=-\\frac{\\sqrt{2}}{2},$ we get\n\n$$\n\\begin{aligned}x & =-\\frac{\\sqrt{2}}{2} \\\\ r\\operatorname{cos}⁡\\theta  & =-\\frac{\\sqrt{2}}{2} \\\\ r & =-\\frac{\\sqrt{2}}{2\\operatorname{cos}⁡\\theta } \\\\ r & =-\\frac{\\operatorname{sec}⁡\\theta }{\\sqrt{2}}.\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(-\\frac{\\sqrt{2}}{2},\\frac{\\sqrt{2}}{2}).$ So, the entire region $D$ lies between the polar lines $\\theta =\\frac{3\\pi }{4}$ and $\\theta =\\pi ,$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/ca09f228fc218ef1b57196c6b6b1e740c10173b7cd38b1c27407726eccd783f1.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,-\\frac{\\operatorname{sec}⁡\\theta }{\\sqrt{2}}\\le r\\le 1,\\,\\frac{3\\pi }{4}\\le \\theta \\le \\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /4}^{\\pi }{\\int }_{-\\operatorname{sec}⁡\\theta /\\sqrt{2}}^{1}\\sqrt{{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )}\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /4}^{\\pi }{\\int }_{-\\operatorname{sec}⁡\\theta /\\sqrt{2}}^{1}{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85067/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aad77980-4324-5d52-a93f-a37ab3390ef8"] :knowledge-point/questions ["q-85067"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85062/selection/250b0d9841768f41c43930f744e3e916842c862b46137cf571d5b5c53a781fe9" :answer/id #uuid "d9e3390d-9a72-50e8-bede-151e4947904d" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /3}^{\\pi /3}{\\int }_{-4\\operatorname{sin}⁡\\theta }^{-3\\operatorname{csc}⁡\\theta }r\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85062/selection/2aafbbd94ee235b9f4ad414695691df7c4cdf6a3ce45a809791c9fc10ff3e61b" :answer/id #uuid "7b2f9c47-64f8-5cd4-8291-1a4ca7ec17cc" :answer/type :answer.type/math :answer/value "{\\int }_{-2\\pi /3}^{-\\pi /3}{\\int }_{-\\operatorname{csc}⁡\\theta }^{-\\operatorname{sin}⁡\\theta }{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85062/selection/5e05cd2f6f7a0751c4f9013f6a3ca34344176457fef47939b96d9a7b57f37191" :answer/id #uuid "b45830b4-0744-5cfd-a282-a0603554de28" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi /3}^{-\\pi /6}{\\int }_{-4\\operatorname{csc}⁡\\theta }^{-3\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85062/selection/e6e82289298aeaf5f2204345ffe7af952cc38cec43495d5c25de5b4505b02d96" :answer/id #uuid "5e9ee4eb-4a8f-5e8a-a6c4-c4f83cebad53" :answer/type :answer.type/math :answer/value "{\\int }_{-2\\pi /3}^{-\\pi /3}{\\int }_{-3\\operatorname{csc}⁡\\theta }^{-4\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85062/selection/5fb34ebb435d87e7551e5f090bd44bcb6f0ad62615093622ed7c0c656dee2bf7" :answer/id #uuid "7806ad45-3da7-5aa5-a036-d036f4e13559" :answer/type :answer.type/math :answer/value "{\\int }_{-\\pi }^{0}{\\int }_{-\\operatorname{csc}⁡\\theta }^{-\\operatorname{sin}⁡\\theta }{r}^{2}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-85062/selection" :answer-field/id #uuid "1899ac13-8bd0-57fa-b2c3-c40a582918ce" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85062/selection/e6e82289298aeaf5f2204345ffe7af952cc38cec43495d5c25de5b4505b02d96" :answer-field/choices ["q-85062/selection/250b0d9841768f41c43930f744e3e916842c862b46137cf571d5b5c53a781fe9" "q-85062/selection/2aafbbd94ee235b9f4ad414695691df7c4cdf6a3ce45a809791c9fc10ff3e61b" "q-85062/selection/5e05cd2f6f7a0751c4f9013f6a3ca34344176457fef47939b96d9a7b57f37191" "q-85062/selection/e6e82289298aeaf5f2204345ffe7af952cc38cec43495d5c25de5b4505b02d96" "q-85062/selection/5fb34ebb435d87e7551e5f090bd44bcb6f0ad62615093622ed7c0c656dee2bf7"] :db/ensure [:answer-field/validate]} {:db/id "q-85062" :question/id #uuid "1bddde3a-859e-58d0-9562-df6a6a576260" :question/math-academy-id "q-85062" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/acb2f50d01df6ebec6003cc7b9c944b759113b9f364455fb62eede389b335229.png)\n\nThe region $D$ is enclosed between the curve ${x}^{2}+(y+2)^{2}=4$ and the line $y=-3,$ as shown above. What is\n${∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $2$ centered at $(0,-2).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+(y+2)^{2}=4,$ we obtain\n\n$$\n\\begin{aligned}{x}^{2}+(y+2)^{2} & =4 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta +2)^{2} & =4 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +4r\\operatorname{sin}⁡\\theta +4 & =4 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}+4r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r+4\\operatorname{sin}⁡\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=-4\\operatorname{sin}⁡\\theta .$\n\n- For $y=-3,$ we get\n\n$$\n\\begin{aligned}y & =-3 \\\\ r\\operatorname{sin}⁡\\theta  & =-3 \\\\ r & =-\\frac{3}{\\operatorname{sin}⁡\\theta } \\\\ r & =-3\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the points $(-\\sqrt{3},-3)$ and $(\\sqrt{3},-3).$ So, the entire region $D$ lies between the polar lines $\\theta =-\\frac{2\\pi }{3}$ and $\\theta =-\\frac{\\pi }{3},$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/5991463a56d8358164d32b15f73e938573463d8d706d2b9c8fc06803326a5f0f.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,-3\\operatorname{csc}⁡\\theta \\le r\\le -4\\operatorname{sin}⁡\\theta ,\\,-2\\frac{\\pi }{3}\\le \\theta \\le -\\frac{\\pi }{3}}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}+{y}^{2})\\,\\text{d}A & ={∬}_{Δ}((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-2\\pi /3}^{-\\pi /3}{\\int }_{-3\\operatorname{csc}⁡\\theta }^{-4\\operatorname{sin}⁡\\theta }{r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )\\,r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-2\\pi /3}^{-\\pi /3}{\\int }_{-3\\operatorname{csc}⁡\\theta }^{-4\\operatorname{sin}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85062/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aad77980-4324-5d52-a93f-a37ab3390ef8"] :knowledge-point/questions ["q-85062"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161101/selection/954baadcb15f66975fffeb5d7fe328086c2317c860ac9628023b7af37c69a3d7" :answer/id #uuid "2b5c19ff-cf95-5829-9048-fc6f350d87ff" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{1/(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}^{2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161101/selection/d5a70ede149012bb9f7f77825806d190abe808ff45cca4231034c40f5d621a31" :answer/id #uuid "29f6505d-ab92-514b-91a5-2e557547eaca" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{2/(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}^{2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161101/selection/aa88aba68110b1be343d8d4147c51fd398910aa60b3a951e7755fb070bfdbfea" :answer/id #uuid "b2418142-2ffc-5ddf-ad74-97241b6d50ab" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{2/(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )}^{2(\\operatorname{sin}⁡\\theta +\\operatorname{cos}⁡\\theta )}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161101/selection/e8f87896cc30b7551d1133821a54e16c240028b8b8260d2ea0b7de0b0f175305" :answer/id #uuid "04f650e9-ac51-5c7a-bf2d-7d393d70b95b" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{1/(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}^{\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161101/selection/a90fc52d28caef03e2444eaa219a90df2c2b05616626caa840b280eb2af8b969" :answer/id #uuid "a8609207-33a8-5098-87fb-0c378d57ea16" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /2}^{3\\pi /2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{2/(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}^{2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta " :db/ensure [:answer/validate]} {:db/id "q-161101/selection" :answer-field/id #uuid "5764dc4b-51b4-53ba-879b-0fbb9f545772" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161101/selection/d5a70ede149012bb9f7f77825806d190abe808ff45cca4231034c40f5d621a31" :answer-field/choices ["q-161101/selection/954baadcb15f66975fffeb5d7fe328086c2317c860ac9628023b7af37c69a3d7" "q-161101/selection/d5a70ede149012bb9f7f77825806d190abe808ff45cca4231034c40f5d621a31" "q-161101/selection/aa88aba68110b1be343d8d4147c51fd398910aa60b3a951e7755fb070bfdbfea" "q-161101/selection/e8f87896cc30b7551d1133821a54e16c240028b8b8260d2ea0b7de0b0f175305" "q-161101/selection/a90fc52d28caef03e2444eaa219a90df2c2b05616626caa840b280eb2af8b969"] :db/ensure [:answer-field/validate]} {:db/id "q-161101" :question/id #uuid "4d08ae8b-d701-5c32-a8bc-6cc3936a7567" :question/math-academy-id "q-161101" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/aed70cc2e5495fcfd9f42ff5d79c3371fb17b62e12ab1909c7738071e59f1a23.png)\n\nThe region $D$ is enclosed between the curve $(x+1)^{2}+(y-1)^{2}=2$ and the line $y=x+2,$ as shown above. What is\n${∬}_{D}xy\\,\\text{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $\\sqrt{2}$ centered at $(-1,1).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For $(x+1)^{2}+(y-1)^{2}=2,$ we obtain\n\n$$\n\\begin{aligned}(x+1)^{2}+(y-1)^{2} & =2 \\\\ (r\\operatorname{cos}⁡\\theta +1)^{2}+(r\\operatorname{sin}⁡\\theta -1)^{2} & =2 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta +2r\\operatorname{cos}⁡\\theta -2r\\operatorname{sin}⁡\\theta +2 & =2 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-2r(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ) & =0 \\\\ {r}^{2}-2r(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ) & =0 \\\\ r(r-2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ).$\n\n- For $y=x+2,$ we get\n\n$$\n\\begin{aligned}y & =x+2 \\\\ r\\operatorname{sin}⁡\\theta  & =r\\operatorname{cos}⁡\\theta +2 \\\\ r(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ) & =2 \\\\ r & =\\frac{2}{\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta }.\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the points $(-2,0)$ and $(0,2).$ So, the entire region $D$ lies between the polar lines $\\theta =\\frac{\\pi }{2}$ and $\\theta =\\pi ,$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/b9c2cd48302ef8d4e2d5e65a56d19506600c5e6552a4d9a1ef7d578a09a21557.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,\\frac{2}{\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta }\\le r\\le 2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta ),\\,\\frac{\\pi }{2}\\le \\theta \\le \\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}xy\\,\\text{d}A & ={∬}_{Δ}{r}^{2}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\cdot r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }{\\int }_{2/(\\operatorname{sin}⁡\\theta -\\operatorname{sin}⁡\\theta )}^{2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}{r}^{3}\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{\\pi }\\operatorname{cos}⁡\\theta \\operatorname{sin}⁡\\theta {\\int }_{2/(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}^{2(\\operatorname{sin}⁡\\theta -\\operatorname{cos}⁡\\theta )}{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161101/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "aad77980-4324-5d52-a93f-a37ab3390ef8"] :knowledge-point/questions ["q-161101"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85206/selection/26d56282497397e2cb22481c4a4fa1a5e785860d52ba1416fe2e4e5146075126" :answer/id #uuid "2f112108-fc29-5944-b533-b4da8475ffb3" :answer/type :answer.type/math :answer/value "2-\\pi " :db/ensure [:answer/validate]} {:db/id "q-85206/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "f02dd304-8613-5e88-a981-a78f6e4032b8" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-85206/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "bfc8ba26-c416-5083-b24b-b9e2a596de61" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-85206/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" :answer/id #uuid "155180f4-d19a-5aff-9529-b2cde64bd4c1" :answer/type :answer.type/math :answer/value "2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-85206/selection/75cfe163af644022e98aa249b7017a09c127830cfc9db9522a7243a483eb0eef" :answer/id #uuid "c08bf500-b4aa-54f9-a809-fb58f01d0092" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}\\pi " :db/ensure [:answer/validate]} {:db/id "q-85206/selection" :answer-field/id #uuid "fa4b75d4-b828-549b-b05e-2d2e1004592c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85206/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-85206/selection/26d56282497397e2cb22481c4a4fa1a5e785860d52ba1416fe2e4e5146075126" "q-85206/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-85206/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" "q-85206/selection/05402db46107d70ece210f0bd5e24b332ae4f43bd474d592035c3e3c92625629" "q-85206/selection/75cfe163af644022e98aa249b7017a09c127830cfc9db9522a7243a483eb0eef"] :db/ensure [:answer-field/validate]} {:db/id "q-85206" :question/id #uuid "3911b601-a237-5fb0-be5d-bd15dffefda8" :question/math-academy-id "q-85206" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/bf7089294bc72330065590a9fe54acebee6d0ab982bffb4a162407c7232898ec.png)\n\nEvaluate the double integral ${∬}_{D}\\frac{4y}{{x}^{2}+{y}^{2}}\\,\\text{d}A,$ where the region $D$ is shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at $(0,1).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+(y-1)^{2}=1,$ we obtain\n\n$$\n\\begin{aligned}{x}^{2}+(y-1)^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta -1)^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -2r\\operatorname{sin}⁡\\theta +1 & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-2r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}-2r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-2\\operatorname{sin}⁡\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r=2\\operatorname{sin}⁡\\theta .$\n\n- For $y=1,$ we get\n\n$$\n\\begin{aligned}y & =1 \\\\ r\\operatorname{sin}⁡\\theta  & =1 \\\\ r & =\\frac{1}{\\operatorname{sin}⁡\\theta } \\\\ r & =\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(-1,1).$ So, the entire region $D$ lies between the polar lines $\\theta =\\frac{\\pi }{2}$ and $\\theta =\\frac{3\\pi }{4},$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/1b83e2674bba4bd6c326083f8c94496b5288de23575dc63a92b9a660eba69f67.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,\\operatorname{csc}⁡\\theta \\le r\\le 2\\operatorname{sin}⁡\\theta ,\\,\\frac{\\pi }{2}\\le \\theta \\le \\frac{3\\pi }{4}}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{4y}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{4r\\operatorname{sin}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}{\\int }_{\\operatorname{csc}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }4\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}4\\operatorname{sin}⁡\\theta {\\int }_{\\operatorname{csc}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}4\\operatorname{sin}⁡\\theta [r]_{\\operatorname{csc}⁡\\theta }^{2\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /2}^{3\\pi /4}4\\operatorname{sin}⁡\\theta (2\\operatorname{sin}⁡\\theta -\\operatorname{csc}⁡\\theta )\\,\\text{d}\\theta  \\\\  & =4{\\int }_{\\pi /2}^{3\\pi /4}(2{sin}^{2}⁡\\theta -1)\\,\\text{d}\\theta  \\\\  & =-4{\\int }_{\\pi /2}^{3\\pi /4}\\operatorname{cos}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =-2[\\operatorname{sin}⁡(2\\theta )]_{\\pi /2}^{3\\pi /4} \\\\  & =-2[\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(\\pi )] \\\\  & =2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-85206/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab96fd62-5043-501a-a3b5-5ee705f69d18"] :knowledge-point/questions ["q-85206"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-161102"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/b0e8a196dc27f333db4179b5c318ccd3aa4b385c0752c570fbfedc0226b3b15b.png)\n\nEvaluate the double integral ${∬}_{D}\\frac{1}{({x}^{2}+{y}^{2})^{2}}\\,\\text{d}A,$ where the region $D$ is enclosed between two circles centered at $O$ of radii $2$ and $3,$ as shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents the annulus between the disks of radii $2$ and $3$ centered at the origin. \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=4,$ we obtain $r=2.$\n\n- For ${x}^{2}+{y}^{2}=9,$ we obtain $r=3.$\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,2\\le r\\le 3,\\,0\\le \\theta <2\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{({x}^{2}+{y}^{2})^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{1}{((r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2})^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{2}^{3}\\frac{1}{{r}^{4}}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{2}^{3}\\frac{1}{{r}^{3}}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{[-\\frac{1}{2{r}^{2}}]}_{2}^{3}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }(\\frac{1}{8}-\\frac{1}{18})\\,\\text{d}\\theta  \\\\  & =\\frac{5}{72}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta  \\\\  & =\\frac{5}{72}[\\theta ]_{0}^{2\\pi } \\\\  & =\\frac{5}{72}\\cdot 2\\pi  \\\\  & =\\frac{5\\pi }{36}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-161121/selection/fbba506e9db012b751baac86e99e5d44a0b6ba0da286da806119d9e13bb78dc9" :answer/id #uuid "88a6da60-d7c1-5cf3-b0ae-36e8364d3db4" :answer/type :answer.type/math :answer/value "\\frac{136}{3}" :db/ensure [:answer/validate]} {:db/id "q-161121/selection/65607f6756a6054f51564e23a1af63ce570404008f6f5eb9767ad6f7c255678e" :answer/id #uuid "bbcd4135-5629-597f-b35b-f780cb5be53f" :answer/type :answer.type/math :answer/value "272" :db/ensure [:answer/validate]} {:db/id "q-161121/selection/e87d73a0704882803bc7d8b9eda02abcc1efbb43e3592d3c7637d7727369c401" :answer/id #uuid "03800d38-5328-501e-aec6-b4c8be727556" :answer/type :answer.type/math :answer/value "136" :db/ensure [:answer/validate]} {:db/id "q-161121/selection/da6b97a4bc630b5c2f394079f718522471dbf4ba41f5cde7f139bc4fde8caaed" :answer/id #uuid "4e053cd7-87c9-52d3-8367-295e2dcf20e5" :answer/type :answer.type/math :answer/value "\\frac{272}{3}" :db/ensure [:answer/validate]} {:db/id "q-161121/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "a614c07f-aaa8-5fef-acd1-5a4453286ef4" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-161121/selection" :answer-field/id #uuid "d6cc85e6-2d6d-5944-9612-8d5244a6aa5a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161121/selection/da6b97a4bc630b5c2f394079f718522471dbf4ba41f5cde7f139bc4fde8caaed" :answer-field/choices ["q-161121/selection/fbba506e9db012b751baac86e99e5d44a0b6ba0da286da806119d9e13bb78dc9" "q-161121/selection/65607f6756a6054f51564e23a1af63ce570404008f6f5eb9767ad6f7c255678e" "q-161121/selection/e87d73a0704882803bc7d8b9eda02abcc1efbb43e3592d3c7637d7727369c401" "q-161121/selection/da6b97a4bc630b5c2f394079f718522471dbf4ba41f5cde7f139bc4fde8caaed" "q-161121/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-161121" :question/id #uuid "9b6cfed2-365c-5005-ae47-027cb53be6fb" :question/math-academy-id "q-161121" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/9cd21fbe460f530f08bc8e85f407f9d6ac49b263d3a5361af093a21cd1ca8d11.png)\n\nEvaluate the double integral ${∬}_{D}\\frac{{x}^{2}y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,\\text{d}A,$ where the region $D$ is a half annulus enclosed between two circles centered at $O$ of radii $3$ and $5,$ as shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents the half-annulus between the disks of radii $3$ and $5$ centered at the origin. \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=9,$ we obtain $r=3.$\n\n- For ${x}^{2}+{y}^{2}=25,$ we obtain $r=5.$\n\nNow, let's find the limits for the parameter $\\theta .$ The entire region lies between the radial lines $\\theta =0$ and $\\theta =\\pi ,$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/da18aafec278b5d44b0530097729e4cb4b319e219c005fc155d78fab8aa90937.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,3\\le r\\le 5,\\,0\\le \\theta <\\pi }.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{{x}^{2}y}{\\sqrt{{x}^{2}+{y}^{2}}}\\,\\text{d}A & ={∬}_{Δ}\\frac{{r}^{3}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }{\\sqrt{(r\\operatorname{cos}⁡\\theta )^{2}+(r\\operatorname{sin}⁡\\theta )^{2}}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{3}^{5}\\frac{{r}^{3}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta }{r}\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{\\int }_{3}^{5}{r}^{3}{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta {[\\frac{{r}^{4}}{4}]}_{3}^{5}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi }{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta (\\frac{625}{4}-\\frac{81}{4})\\,\\text{d}\\theta  \\\\  & =136{\\int }_{0}^{2\\pi }{cos}^{2}⁡\\theta \\operatorname{sin}⁡\\theta \\,\\text{d}\\theta  \\\\  & =136{[-\\frac{{cos}^{3}⁡\\theta }{3}]}_{0}^{\\pi } \\\\  & =136\\cdot (\\frac{1}{3}+\\frac{1}{3}) \\\\  & =\\frac{272}{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-161121/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab96fd62-5043-501a-a3b5-5ee705f69d18"] :knowledge-point/questions ["q-161121"] :db/ensure [:knowledge-point/validate]} {:db/id "q-83999/selection/73a6ebb844b6609cdde4b717cc4544cfe52910a6a0520b3b46882a3e5b0c5728" :answer/id #uuid "789dd74b-cdfa-5805-98a5-1f4d3f8d2eb8" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}-2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-83999/selection/ba9438d64a90b670b9335b035f40b9fe1978ef09d1c2a5687649b5db838a2a02" :answer/id #uuid "f6e5ba0e-b9ef-59e3-80e1-1f6f01400644" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}(e-1)" :db/ensure [:answer/validate]} {:db/id "q-83999/selection/ee802a81e34d8b0de7339744a115e333ff72191067f142f9ae69513463d24f13" :answer/id #uuid "39cbb040-bc78-5875-b3b7-90433fc3dd31" :answer/type :answer.type/math :answer/value "2e-\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-83999/selection/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f" :answer/id #uuid "ad893a91-f9e0-5ce7-883c-67be6b98622b" :answer/type :answer.type/math :answer/value "-2\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-83999/selection/35d0af53e25a7911f6d08c6d063fcf9231a1273a16a0f7056530d6f5d5dfbdd8" :answer/id #uuid "50a9bf64-a4cc-56e6-b47b-b81ac55fade6" :answer/type :answer.type/math :answer/value "\\frac{2\\pi }{3}" :db/ensure [:answer/validate]} {:db/id "q-83999/selection" :answer-field/id #uuid "6d1359b5-6ade-5f8d-890b-f8b13f918ec0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-83999/selection/73a6ebb844b6609cdde4b717cc4544cfe52910a6a0520b3b46882a3e5b0c5728" :answer-field/choices ["q-83999/selection/73a6ebb844b6609cdde4b717cc4544cfe52910a6a0520b3b46882a3e5b0c5728" "q-83999/selection/ba9438d64a90b670b9335b035f40b9fe1978ef09d1c2a5687649b5db838a2a02" "q-83999/selection/ee802a81e34d8b0de7339744a115e333ff72191067f142f9ae69513463d24f13" "q-83999/selection/db7b536abbfbcf7bf94ee6f7b1bfcfcde80a4b0681c0d4a814e23a1769d0dc6f" "q-83999/selection/35d0af53e25a7911f6d08c6d063fcf9231a1273a16a0f7056530d6f5d5dfbdd8"] :db/ensure [:answer-field/validate]} {:db/id "q-83999" :question/id #uuid "939fc921-a379-5688-8de2-0d74998d81dc" :question/math-academy-id "q-83999" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/d0d72be437a462f5eea781e83cc2a95e956e11ddc3295ad3b02a4a57867d9271.png)\n\nEvaluate the double integral ${∬}_{D}\\frac{2y}{{x}^{2}+{y}^{2}}\\,\\text{d}A,$ where the region $D$ is shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $2$ centered at the origin.\n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=4,$ we obtain $r=2.$\n\n- For $y=-1,$ we get\n\n$$\n\\begin{aligned}y & =-1 \\\\ r\\operatorname{sin}⁡\\theta  & =-1 \\\\ r & =-\\frac{1}{\\operatorname{sin}⁡\\theta } \\\\ r & =-\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(\\sqrt{3},-1).$ So, the entire region lies between the radial lines $\\theta =-\\frac{\\pi }{2}$ and $\\theta =-\\frac{\\pi }{6},$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/2386c1dcb1cf71231f2bb508dc1dd85dadef15b806eaf7f9a9ad0d3e4f3da1ca.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,-\\operatorname{csc}⁡\\theta \\le r\\le 2,\\,-\\frac{\\pi }{2}\\le \\theta \\le -\\frac{\\pi }{6}}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2y}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{2r\\operatorname{sin}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}{\\int }_{-\\operatorname{csc}⁡\\theta }^{2}2\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}2\\operatorname{sin}⁡\\theta {\\int }_{-\\operatorname{csc}⁡\\theta }^{2}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}2\\operatorname{sin}⁡\\theta [r]_{-\\operatorname{csc}⁡\\theta }^{2}\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}2\\operatorname{sin}⁡\\theta (2+\\operatorname{csc}⁡\\theta )\\,\\text{d}\\theta  \\\\  & ={\\int }_{-\\pi /2}^{-\\pi /6}(4\\operatorname{sin}⁡\\theta +2)\\,\\text{d}\\theta  \\\\  & =[-4\\operatorname{cos}⁡\\theta +2\\theta ]_{-\\pi /2}^{-\\pi /6} \\\\  & =[(-4\\operatorname{cos}⁡(-\\frac{\\pi }{6})-\\frac{\\pi }{3})-(0-\\pi )] \\\\  & =\\frac{2\\pi }{3}-2\\sqrt{3}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-83999/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab96fd62-5043-501a-a3b5-5ee705f69d18"] :knowledge-point/questions ["q-83999"] :db/ensure [:knowledge-point/validate]} {:db/id "q-85204/selection/c63d7a2830a35892b9dd2a112d69ad4dd2540c5d50d3530677d299455a7b7f51" :answer/id #uuid "d5d79de3-7bb2-5eda-9290-1df112a63404" :answer/type :answer.type/math :answer/value "12\\sqrt{2}-3\\pi \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-85204/selection/389e86c385b4c25fbaf75655ef3db393b0ac7912468c85d419cf51eaedef7b52" :answer/id #uuid "c36785ed-045f-51a6-8b92-9a58654176bd" :answer/type :answer.type/math :answer/value "3\\sqrt{2}+5" :db/ensure [:answer/validate]} {:db/id "q-85204/selection/fdade9905f81d185649c6b95306c66ec1092ce21f9306a45688e0d6791da1076" :answer/id #uuid "422b5cf8-a06b-5621-b3c8-3d63da0bb4fe" :answer/type :answer.type/math :answer/value "12\\pi \\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-85204/selection/edd0810305864797c5fe0477a357a891b1aa52b182f07d482e0e4df077733f4c" :answer/id #uuid "8d38fea8-c8fe-5682-b61d-6d4a9ac0ab12" :answer/type :answer.type/math :answer/value "\\pi \\sqrt{2}+\\sqrt{3}" :db/ensure [:answer/validate]} {:db/id "q-85204/selection/0fb978d2b1ce374ae0f1700c585078833e85991af693baf7445a5e2dc6cdf6cc" :answer/id #uuid "ddacb08e-ad82-53d2-ac7f-c049bc330e86" :answer/type :answer.type/math :answer/value "12\\pi " :db/ensure [:answer/validate]} {:db/id "q-85204/selection" :answer-field/id #uuid "94034ac5-6db5-5120-a36f-bd11e45979ae" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85204/selection/c63d7a2830a35892b9dd2a112d69ad4dd2540c5d50d3530677d299455a7b7f51" :answer-field/choices ["q-85204/selection/c63d7a2830a35892b9dd2a112d69ad4dd2540c5d50d3530677d299455a7b7f51" "q-85204/selection/389e86c385b4c25fbaf75655ef3db393b0ac7912468c85d419cf51eaedef7b52" "q-85204/selection/fdade9905f81d185649c6b95306c66ec1092ce21f9306a45688e0d6791da1076" "q-85204/selection/edd0810305864797c5fe0477a357a891b1aa52b182f07d482e0e4df077733f4c" "q-85204/selection/0fb978d2b1ce374ae0f1700c585078833e85991af693baf7445a5e2dc6cdf6cc"] :db/ensure [:answer-field/validate]} {:db/id "q-85204" :question/id #uuid "2d97c4f3-ec20-5090-97d9-495e8f3aa9c1" :question/math-academy-id "q-85204" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/928fb72015b78436f95895799c2846d1a0b34242b7216d31a6ed6bdda46728a1.png)\n\nEvaluate the double integral ${∬}_{D}\\frac{6x}{{x}^{2}+{y}^{2}}\\,\\text{d}A,$ where the region $D$ is shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n{∬}_{D}f(x,y)\\text{ }dA={∬}_{Δ}\\text{ }f(r\\operatorname{cos}⁡\\theta ,r\\operatorname{sin}⁡\\theta )\\,r\\text{ }drd\\theta .\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $4$ centered at $(0,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's now write our curves in polar coordinates.\n\n- For ${x}^{2}+{y}^{2}=16,$ we obtain $r=4.$\n\n- For $x=2\\sqrt{2},$ we get\n\n$$\n\\begin{aligned}x & =2\\sqrt{2} \\\\ r\\operatorname{cos}⁡\\theta  & =2\\sqrt{2} \\\\ r & =\\frac{2\\sqrt{2}}{\\operatorname{cos}⁡\\theta } \\\\ r & =2\\sqrt{2}\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta .$ Our curves intersect at the point $(2\\sqrt{2},2\\sqrt{2}).$ So, the entire region $D$ lies between the polar lines $\\theta =0$ and $\\theta =\\frac{\\pi }{4},$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/375e270ce444d9f62b50f9a25abfae781113fdad895833d693061ffffe93f5d3.png)\n\nAs a result, the region can be expressed in polar coordinates $(r,\\theta )$ as \n\n$$\nΔ={(r,\\theta )\\,:\\,2\\sqrt{2}\\operatorname{sec}⁡\\theta \\le r\\le 4,\\,0\\le \\theta \\le \\frac{\\pi }{4}}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{6x}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{6r\\operatorname{cos}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}{\\int }_{2\\sqrt{2}\\operatorname{sec}⁡\\theta }^{4}6\\operatorname{cos}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}6\\operatorname{cos}⁡\\theta {\\int }_{2\\sqrt{2}\\operatorname{sec}⁡\\theta }^{4}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}6\\operatorname{cos}⁡\\theta [r]_{2\\sqrt{2}\\operatorname{sec}⁡\\theta }^{4}\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}6\\operatorname{cos}⁡\\theta (4-2\\sqrt{2}\\operatorname{sec}⁡\\theta )\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /4}(24\\operatorname{cos}⁡\\theta -12\\sqrt{2})\\,\\text{d}\\theta  \\\\  & =[24\\operatorname{sin}⁡\\theta -12\\sqrt{2}\\,\\theta ]_{0}^{\\pi /4} \\\\  & =[(24\\operatorname{sin}⁡(\\frac{\\pi }{4})-12\\sqrt{2}(\\frac{\\pi }{4}))-0] \\\\  & =12\\sqrt{2}-3\\pi \\sqrt{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-85204/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ab96fd62-5043-501a-a3b5-5ee705f69d18"] :knowledge-point/questions ["q-85204"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7411"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/940f547f886f1b680cbb37ef950438e6a4f33bd3c84df28a5e00480631c97711.png)\n\nThe region $D$ in the first quadrant is enclosed between the quarter-circles of radii $3$ and $4,$ as shown above. What is\n$\\displaystyle \\iint\\limits_D \\dfrac{1}{x^2+y^2} \\: \\textrm{d}A$\nexpressed in polar coordinates?" :question/worked-solution "We will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nThe region $D$ represents a portion of the washer enclosed between the circles of radii $3$ and $4$ centered at the origin. In polar coordinates $(r, \\theta),$ the region can be expressed as \n\n$$\n\\Delta = \\Big\\{ (r,\\theta) \\: : \\: 3 \\leq r \\leq 4, \\: 0 \\leq \\theta \\leq \\dfrac{\\pi}{2} \\Big\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain  \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{1}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{1}{(r\\operatorname{sin}⁡\\theta )^{2}+(r\\operatorname{cos}⁡\\theta )^{2}}\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{3}^{4}\\frac{r}{{r}^{2}({sin}^{2}⁡\\theta +{cos}^{2}⁡\\theta )}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{\\pi /2}{\\int }_{3}^{4}\\frac{1}{r}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7409"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/4e47cfcf3da66707e6bc898d099868bfbd6d5163dcd38d47e4c79b2180e89ec6.png)\n\nThe region $D$ is enclosed between the curve $(x+1)^2+y^2=1$ and the line $x=-1,$ as shown above. Express the following double integral in polar coordinates:\n\n$$\n\\displaystyle \\iint\\limits_D xy \\: \\textrm{d}A\n$$" :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $1$ centered at $(-1,0).$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's write our curves in polar coordinates.\n\n- For $(x+1)^2+y^2=1,$ we obtain\n\n$$\n\\begin{aligned}(x+1)^{2}+{y}^{2} & =1 \\\\ (r\\operatorname{cos}⁡\\theta +1)^{2}+(r\\operatorname{sin}⁡\\theta )^{2} & =1 \\\\ {r}^{2}{cos}^{2}⁡\\theta +2r\\operatorname{cos}⁡\\theta +1+{r}^{2}{sin}^{2}⁡\\theta  & =1 \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )+2r\\operatorname{cos}⁡\\theta  & =0 \\\\ {r}^{2}+2r\\operatorname{cos}⁡\\theta  & =0 \\\\ r(r+2\\operatorname{cos}⁡\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r = -2\\cos\\theta.$\n\n- For $x=-1,$ we get\n\n$$\n\\begin{aligned}x & =-1 \\\\ r\\operatorname{cos}⁡\\theta  & =-1 \\\\ r & =-\\frac{1}{\\operatorname{cos}⁡\\theta } \\\\ r & =-\\operatorname{sec}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta.$ Our curves intersect at the point $(-1,1).$ So, the entire region $D$ lies between the polar lines $\\theta=\\dfrac{3\\pi}{4}$ and $\\theta=\\pi,$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/769c13bea2dfc91aa3a507df1b7a763ae0da7591e0d6ba5face12268efb88240.png)\n\nAs a result, the region can be expressed in polar coordinates $(r, \\theta)$ as \n\n$$\n\\Delta = \\Big\\{ (r,\\theta) \\: : \\: -\\sec\\theta \\leq r \\leq -2\\cos\\theta, \\: \\dfrac{3\\pi}{4} \\leq \\theta \\leq {\\pi} \\Big\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}xy\\,\\text{d}A & ={∬}_{Δ}(r\\operatorname{cos}⁡\\theta \\cdot r\\operatorname{sin}⁡\\theta )\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /4}^{\\pi }{\\int }_{-\\operatorname{sec}⁡\\theta }^{-2\\operatorname{cos}⁡\\theta }{r}^{3}\\operatorname{cos}⁡\\theta \\,\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{3\\pi /4}^{\\pi }\\operatorname{cos}⁡\\theta \\,\\operatorname{sin}⁡\\theta {\\int }_{-\\operatorname{sec}⁡\\theta }^{-2\\operatorname{cos}⁡\\theta }{r}^{3}\\,\\text{d}r\\,\\text{d}\\theta .\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7410"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/aa730804a15decac8450255e714ca1e0697f4f2326eb615d4d035a2870a49dce.png)\n\nEvaluate the double integral $\\displaystyle \\iint\\limits_D \\dfrac{2y}{x^2+y^2} \\: \\textrm{d}A,$ where the region $D$ is shown above." :question/worked-solution "We need to change the coordinate system from Cartesian coordinates to polar coordinates. To do this, we will use the change of variables formula in the form\n\n$$\n\\iint\\limits_{D} f(x,y) \\ \\mathrm d A = \\iint\\limits_{\\Delta} \\ f(r\\cos\\theta, r\\sin\\theta) \\:  r \\ \\mathrm d r \\mathrm d \\theta.\n$$\n\nNotice that the region $D$ represents a portion of the disk of radius $\\dfrac{1}{2}$ centered at $\\left(0,\\dfrac{1}{2}\\right)\\!.$ \n\nCartesian and polar coordinates are connected by the following equations:\n\n$$\n{\\begin{aligned}x=r\\operatorname{cos}⁡\\theta  \\\\ y=r\\operatorname{sin}⁡\\theta \\end{aligned}\n$$\n\nWith that in mind, let's write our curves in polar coordinates.\n\n- For $x^2+\\left( y-\\dfrac{1}{2} \\right)^2=\\dfrac14,$ we obtain\n\n$$\n\\begin{aligned}{x}^{2}+{(y-\\frac{1}{2})}^{2} & =\\frac{1}{4} \\\\ (r\\operatorname{cos}⁡\\theta )^{2}+{(r\\operatorname{sin}⁡\\theta -\\frac{1}{2})}^{2} & =\\frac{1}{4} \\\\ {r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta -r\\operatorname{sin}⁡\\theta +\\frac{1}{4} & =\\frac{1}{4} \\\\ {r}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )-r\\operatorname{sin}⁡\\theta  & =0 \\\\ {r}^{2}-r\\operatorname{sin}⁡\\theta  & =0 \\\\ r(r-\\operatorname{sin}⁡\\theta ) & =0.\\end{aligned}\n$$\n\n \nSince $r$ cannot be identical to zero on the entire semicircle, we must have $r = \\sin\\theta.$\n\n- For $y=\\dfrac{1}{2},$ we get\n\n$$\n\\begin{aligned}y & =\\frac{1}{2} \\\\ r\\operatorname{sin}⁡\\theta  & =\\frac{1}{2} \\\\ r & =\\frac{1}{2\\operatorname{sin}⁡\\theta } \\\\ r & =\\frac{1}{2}\\operatorname{csc}⁡\\theta .\\end{aligned}\n$$\n\nNow, let's find the limits for the parameter $\\theta.$ Our curves intersect at the point $\\left(\\dfrac{1}{2},\\dfrac{1}{2}\\right).$ So, the entire region lies between the radial lines $\\theta=\\dfrac{\\pi}{4}$ and $\\theta=\\dfrac{\\pi}{2},$ as depicted below.  \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14056707/assets/1284a8b4b3f1634b4f7586d40ab8adf9cf93c69484b7ed069f138c8055e88892.png)\n\nAs a result, the region can be expressed in polar coordinates $(r, \\theta)$ as \n\n$$\n\\Delta = \\Big\\{ (r,\\theta) \\: : \\: \\dfrac{1}{2}\\csc\\theta \\leq r \\leq \\sin\\theta, \\: \\dfrac{\\pi}{4} \\leq \\theta \\leq \\dfrac{\\pi}{2} \\Big\\}.\n$$\n\nTherefore, using the change of variables formula, we obtain \n\n$$\n\\begin{aligned}{∬}_{D}\\frac{2y}{{x}^{2}+{y}^{2}}\\,\\text{d}A & ={∬}_{Δ}\\frac{2r\\operatorname{sin}⁡\\theta }{{r}^{2}{cos}^{2}⁡\\theta +{r}^{2}{sin}^{2}⁡\\theta }\\,r\\,\\text{d}r\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}{\\int }_{1/2\\operatorname{csc}⁡\\theta }^{\\operatorname{sin}⁡\\theta }2\\operatorname{sin}⁡\\theta \\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}2\\operatorname{sin}⁡\\theta {\\int }_{1/2\\operatorname{csc}⁡\\theta }^{\\operatorname{sin}⁡\\theta }\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}2\\operatorname{sin}⁡\\theta [r]_{1/2\\operatorname{csc}⁡\\theta }^{\\operatorname{sin}⁡\\theta }\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}2\\operatorname{sin}⁡\\theta (\\operatorname{sin}⁡\\theta -\\frac{1}{2}\\operatorname{csc}⁡\\theta )\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}(2{sin}^{2}⁡\\theta -1)\\,\\text{d}\\theta  \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}-\\operatorname{cos}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =-\\frac{1}{2}[\\operatorname{sin}⁡(2\\theta )]_{\\pi /4}^{\\pi /2} \\\\  & =-\\frac{1}{2}(0-\\operatorname{sin}⁡(\\frac{\\pi }{2})) \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" :db/ensure [:question/validate]}]
