[{:db/id "q-123025/selection/221524725f374ffe3fd730bfad0001f0b17cf71abcb82117046ac2147f8390a7" :answer/id #uuid "f17eafaa-4e17-52c4-80d4-1de331f7989d" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123025/selection/4037fd7c262c75e9618be2f82f2827011d0e9581f5f187806cde6657f97d19c1" :answer/id #uuid "e4f12ce6-7e4f-5369-ae21-a8b9ddb6f8ce" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{9{t}^{4}+4{t}^{2}-20t+5}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123025/selection/04c4f54a9aa14f4d2070c11556befb95c8d872c4e022ddf0bc7352b9889cfb80" :answer/id #uuid "1a22c9cb-e3d1-5ce7-9d7e-0f9c1911b806" :answer/type :answer.type/math :answer/value "2{\\int }_{-1}^{2}\\sqrt{9{t}^{4}+{t}^{2}-5t+6}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123025/selection/564ae19af972749ce5e6a321baedfbdc6a0fa4a8a6c8b972a4285516e9873bda" :answer/id #uuid "037dc31e-e1d8-5684-b347-1fac35d64cbe" :answer/type :answer.type/math :answer/value "3{\\int }_{-1}^{2}\\sqrt{27{t}^{4}+4{t}^{2}-t+6}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123025/selection/e013920d168d95e8e39bd043032c23d96f42ba745e57ddbe14a9b69961876a94" :answer/id #uuid "f31ab6e7-9c49-524a-8521-60b4a1c46bf0" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{2}\\sqrt{85{t}^{4}-20t+25}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123025/selection" :answer-field/id #uuid "d64f3857-74e3-5fee-8a53-bba738755f86" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123025/selection/221524725f374ffe3fd730bfad0001f0b17cf71abcb82117046ac2147f8390a7" :answer-field/choices ["q-123025/selection/221524725f374ffe3fd730bfad0001f0b17cf71abcb82117046ac2147f8390a7" "q-123025/selection/4037fd7c262c75e9618be2f82f2827011d0e9581f5f187806cde6657f97d19c1" "q-123025/selection/04c4f54a9aa14f4d2070c11556befb95c8d872c4e022ddf0bc7352b9889cfb80" "q-123025/selection/564ae19af972749ce5e6a321baedfbdc6a0fa4a8a6c8b972a4285516e9873bda" "q-123025/selection/e013920d168d95e8e39bd043032c23d96f42ba745e57ddbe14a9b69961876a94"] :db/ensure [:answer-field/validate]} {:db/id "q-123025" :question/id #uuid "ae49ad18-0c87-5be6-839a-5bdd26096c22" :question/math-academy-id "q-123025" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{3}+5,\\,y={t}^{2}-5t$\nfrom $t=-1$ to $t=2$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{3}+5)=9{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{2}-5t)=2t-5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{(9{t}^{2})^{2}+(2t-5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-1}^{2}\\sqrt{81{t}^{4}+4{t}^{2}-20t+25}\\,\\text{d}t.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123025/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-123025"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123020/selection/6ca177625f506c3db2cd75b750294292a46a5234760f860b49664b8275d964ff" :answer/id #uuid "bf250aec-9cb7-5333-bfed-dbbf13f3542f" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+3}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123020/selection/deb65fd5b0e64b98b74674647889de9c1ec5d21ad854540519a4e13c5f23ba4a" :answer/id #uuid "aab887c4-9bef-52b7-948c-d8ce8dfad46e" :answer/type :answer.type/math :answer/value "3{\\int }_{-2}^{0}\\sqrt{3{t}^{4}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123020/selection/00648c83c48bffd31ba53f3362d8e09518a0cdaf92827fd5f6f5ecb4edae4e4d" :answer/id #uuid "9e0933ca-ba48-5db9-82fb-7ffa2d7eadc6" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123020/selection/8b456dc58e9f8efe059fcf68535e09f09cf0d8493bfbc76631c55ce58467f535" :answer/id #uuid "661f9314-797d-5e07-ba5c-4970f63fe671" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{0}\\sqrt{{t}^{4}+2}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123020/selection/16d95b5c22ad3fca7f6c67e8f18b12b25c983478ab2e502d3f5f978bd6f3f713" :answer/id #uuid "b3aa40dd-e4c5-519e-ac8d-0e5b89f0a87a" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123020/selection" :answer-field/id #uuid "5ab018a4-0d7e-59a4-856b-d31b5a0e5be9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123020/selection/16d95b5c22ad3fca7f6c67e8f18b12b25c983478ab2e502d3f5f978bd6f3f713" :answer-field/choices ["q-123020/selection/6ca177625f506c3db2cd75b750294292a46a5234760f860b49664b8275d964ff" "q-123020/selection/deb65fd5b0e64b98b74674647889de9c1ec5d21ad854540519a4e13c5f23ba4a" "q-123020/selection/00648c83c48bffd31ba53f3362d8e09518a0cdaf92827fd5f6f5ecb4edae4e4d" "q-123020/selection/8b456dc58e9f8efe059fcf68535e09f09cf0d8493bfbc76631c55ce58467f535" "q-123020/selection/16d95b5c22ad3fca7f6c67e8f18b12b25c983478ab2e502d3f5f978bd6f3f713"] :db/ensure [:answer-field/validate]} {:db/id "q-123020" :question/id #uuid "ce632c36-0a89-59ca-a425-8c378bad7972" :question/math-academy-id "q-123020" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/ae210abc4028440aa9c822510d68f0ab0b8ba4b9f5806dd299149e953ccd1b21.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={t}^{3}-4,\\,y=2t$\nfrom $t=-2$ to $t=0$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({t}^{3}-4)=3{t}^{2}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2t)=2.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{(3{t}^{2})^{2}+(2)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-2}^{0}\\sqrt{9{t}^{4}+4}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123020/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-123020"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123019/selection/d8b5976a1e7c64fc8a946a09ca54a32f31d095fdb8dfd24f314ca5fbf2c759c1" :answer/id #uuid "7eac3d80-f3c0-5717-9e97-4e428b9ceb08" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{6{t}^{2}+1}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123019/selection/59a4b52a284070edd2ed51bc838f3bfaca1948feaef7b2b75e911dbeaaa13400" :answer/id #uuid "aaa61ac9-4138-50d5-8a79-1de8485c52c8" :answer/type :answer.type/math :answer/value "5{\\int }_{0}^{1}\\sqrt{{t}^{2}+5}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123019/selection/27a4d0146f1ad65c66ab31c4f6ce301f06ba3e027cf29783368e9c529cf27d64" :answer/id #uuid "5b70caea-1ccf-5a45-8d78-16c3fffa43ff" :answer/type :answer.type/math :answer/value "4{\\int }_{0}^{1}\\sqrt{36{t}^{2}+5t}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123019/selection/350fbc2fc0a7a9a2e69d809c9b12ed2710f2617664e054671eab42fcbf0c44d5" :answer/id #uuid "5a48e08e-e8d9-5871-ad12-b6c74ffa63ea" :answer/type :answer.type/math :answer/value "2{\\int }_{0}^{1}\\sqrt{18{t}^{2}-12}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123019/selection/9846c6bef3e9620386647c7ae4f4dbde12f472ec40acf080b0c4361447d024c8" :answer/id #uuid "10925a1f-1d5a-52d0-aee3-8dbfdb5ef588" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-123019/selection" :answer-field/id #uuid "d37965b3-61d6-5169-9b49-be5a394abde7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123019/selection/9846c6bef3e9620386647c7ae4f4dbde12f472ec40acf080b0c4361447d024c8" :answer-field/choices ["q-123019/selection/d8b5976a1e7c64fc8a946a09ca54a32f31d095fdb8dfd24f314ca5fbf2c759c1" "q-123019/selection/59a4b52a284070edd2ed51bc838f3bfaca1948feaef7b2b75e911dbeaaa13400" "q-123019/selection/27a4d0146f1ad65c66ab31c4f6ce301f06ba3e027cf29783368e9c529cf27d64" "q-123019/selection/350fbc2fc0a7a9a2e69d809c9b12ed2710f2617664e054671eab42fcbf0c44d5" "q-123019/selection/9846c6bef3e9620386647c7ae4f4dbde12f472ec40acf080b0c4361447d024c8"] :db/ensure [:answer-field/validate]} {:db/id "q-123019" :question/id #uuid "9091f4f0-0534-58df-a783-a69125c7f605" :question/math-academy-id "q-123019" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/0a58808ee9b20e201d1ea8a31683f742e02f739127640de2fea87ce4757e7901.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=3{t}^{2},\\,y=5t$\nfrom $t=0$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})=6t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(5t)=5.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{(6t)^{2}+(5)^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{36{t}^{2}+25}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-123019/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b03546f-6c79-53b9-b284-fb23ae4dba52"] :knowledge-point/questions ["q-123019"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-123030"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/8868658c9bc7195f435a0109fce26b8a4fa39324c0a9a39e3fb644c5f02cdc9b.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{cos}⁡(5t),\\,y=6\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?" :db/ensure [:question/validate]} {:db/id "q-21347/selection/ebee5851739181da554f60c34a6afc0576213e43b9e1d550fca364ab07e11131" :answer/id #uuid "9f3ff4cc-6c60-540f-bde8-1dfde9577a46" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21347/selection/4dbf6d7923c9d4264ec598a3a1ecfda88fd7c8c8f7e3531467aa29b2a2efa84b" :answer/id #uuid "de23775d-a282-52e5-a955-e58e67baa09e" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21347/selection/1aa10c42b71d95af51ab6d75fe35154430845e7f9ef0ae39780568db3badcc00" :answer/id #uuid "7ddd6dde-1b3d-5e87-a217-b2480968313a" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{16{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21347/selection/7a4f70707accfa87cf84420cab57a59d1649e96f4693382f2542cab5869b7e0e" :answer/id #uuid "3c3a79ec-6ce4-5595-823e-72c01226248e" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{2{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21347/selection/bdb2a5a856efe12da85f881c616c124d2871ea9d20b53dd1088dd87f0953464e" :answer/id #uuid "1f57bf4b-d815-5220-a948-3671c4d73bc5" :answer/type :answer.type/math :answer/value "{\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+3{cos}^{2}⁡(3t)}\\,\\text{d}t" :db/ensure [:answer/validate]} {:db/id "q-21347/selection" :answer-field/id #uuid "421a9648-86d5-5126-b421-bc72fd96654b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-21347/selection/ebee5851739181da554f60c34a6afc0576213e43b9e1d550fca364ab07e11131" :answer-field/choices ["q-21347/selection/ebee5851739181da554f60c34a6afc0576213e43b9e1d550fca364ab07e11131" "q-21347/selection/4dbf6d7923c9d4264ec598a3a1ecfda88fd7c8c8f7e3531467aa29b2a2efa84b" "q-21347/selection/1aa10c42b71d95af51ab6d75fe35154430845e7f9ef0ae39780568db3badcc00" "q-21347/selection/7a4f70707accfa87cf84420cab57a59d1649e96f4693382f2542cab5869b7e0e" "q-21347/selection/bdb2a5a856efe12da85f881c616c124d2871ea9d20b53dd1088dd87f0953464e"] :db/ensure [:answer-field/validate]} {:db/id "q-21347" :question/id #uuid "2112d390-b95e-5d15-9081-2aafcdbe78a5" :question/math-academy-id "q-21347" :question/problem "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(2t),\\,y=\\operatorname{sin}⁡(3t)$\nfrom $t=\\frac{\\pi }{4}$ to $t=\\frac{\\pi }{2}$ ?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(3t))=3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{(2\\operatorname{cos}⁡(2t))^{2}+(3\\operatorname{cos}⁡(3t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{\\pi /4}^{\\pi /2}\\sqrt{4{cos}^{2}⁡(2t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-21347/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ebd2a5c8-5d15-589d-81c9-9b67f4e8f0b3"] :knowledge-point/questions ["q-21347"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-15185"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/80577a585741748702b61596db84983592ecbc6c01fca78af033bf82dbe62ad2.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y={e}^{t}\\operatorname{sin}⁡t$\nfrom $t=-3$ to $t=1$ (shown above)?" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)={e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}\\sqrt{{e}^{2t}+{e}^{2t}{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{1+{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :db/ensure [:question/validate]} {:db/id "q-10257/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" :answer/id #uuid "eaba7bba-53b5-5509-b334-f4da84149b7c" :answer/type :answer.type/math :answer/value "\\frac{2}{3}" :db/ensure [:answer/validate]} {:db/id "q-10257/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "f1d7eb29-18e9-5b97-949e-7bc4e9c60919" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-10257/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "7bbbd4b1-18d0-55a9-a077-1f69d804375e" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-10257/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "e20f86aa-e684-58e6-92cf-1a4c7135d75c" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-10257/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "3ab95e35-7027-5a36-acd6-ca913286129c" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-10257/selection" :answer-field/id #uuid "ce0eaa8c-5036-522e-97ea-b1d5ec6ad207" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10257/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer-field/choices ["q-10257/selection/523b37883474afade764165f552bc128b7640323ff7244275508d19e6f99b277" "q-10257/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-10257/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-10257/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-10257/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-10257" :question/id #uuid "fd387a77-72ef-5833-83c0-73cdf3cd884d" :question/math-academy-id "q-10257" :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=2{cos}^{3}⁡t,\\,y=2{sin}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{cos}^{3}⁡t)=-6{cos}^{2}⁡t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{sin}^{3}⁡t)=6{sin}^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(-6{cos}^{2}⁡t\\operatorname{sin}⁡t)}^{2}+{(6{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{4}⁡t{sin}^{2}⁡t+36{sin}^{4}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}6\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡(2t){|}_{0}^{\\pi /2} \\\\  & =-\\frac{3}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{3}{2}(-1-1) \\\\  & =3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-10257/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-10257"] :db/ensure [:knowledge-point/validate]} {:db/id "q-348086/field-1/81a7ca3bda1657d80a433094f6d7508e86f3496f8f48717dccc3ee8fb4cd5215" :answer/id #uuid "90c9055a-bde9-591f-8fa0-e8803fc2d7bd" :answer/type :answer.type/math :answer/value "\\frac{\\pi^2}{2}" :db/ensure [:answer/validate]} {:db/id "q-348086/field-1/29ec2dfefa1bd3742bf5ba922b9c261dd5f2325bd8484e9153eb979dbd6eced6" :answer/id #uuid "9e49bcb9-e769-56f9-be28-8807dbd5ee4e" :answer/type :answer.type/math :answer/value "\\pi" :db/ensure [:answer/validate]} {:db/id "q-348086/field-1" :answer-field/id #uuid "ef6f97a9-aa98-57bd-8fdb-898797af988c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-348086/field-1/81a7ca3bda1657d80a433094f6d7508e86f3496f8f48717dccc3ee8fb4cd5215" :answer-field/choices ["q-348086/field-1/81a7ca3bda1657d80a433094f6d7508e86f3496f8f48717dccc3ee8fb4cd5215" "q-348086/field-1/29ec2dfefa1bd3742bf5ba922b9c261dd5f2325bd8484e9153eb979dbd6eced6"] :db/ensure [:answer-field/validate]} {:db/id "q-348086" :question/id #uuid "b49a267a-860d-553d-868a-f2e692e29275" :question/math-academy-id "q-348086" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/121012fc5671ada263e83ec6d3a897d187ecb3a9d56c8e4331a3c0c608a92622.png)\n\nFind the arc length $L$ of the curve defined parametrically as\n\n$$\nx=\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t,\\,y=-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t,\\,t\\in [0,\\pi ].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t) \\\\  & =\\operatorname{cos}⁡t-(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =t\\operatorname{sin}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =\\operatorname{sin}⁡t-(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =-t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(t\\operatorname{sin}⁡t)}^{2}+{(-t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}{sin}^{2}⁡t+{t}^{2}{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }t\\,\\text{d}t \\\\  & =\\frac{{t}^{2}}{2}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{{\\pi }^{2}}{2}-0 \\\\  & =\\frac{{\\pi }^{2}}{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-348086/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-348086"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351438/field-1/62056d5ec4a7975ff5d6d624dc578a5d9c9514c65b1c7c3d4b62f913e332ffcd" :answer/id #uuid "3d6b098f-ac04-571f-91dc-9fdb70a2ad8a" :answer/type :answer.type/math :answer/value "e^{\\pi}-1" :db/ensure [:answer/validate]} {:db/id "q-351438/field-1" :answer-field/id #uuid "34649362-6b33-52b0-b6a7-299b70d82198" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351438/field-1/62056d5ec4a7975ff5d6d624dc578a5d9c9514c65b1c7c3d4b62f913e332ffcd" :answer-field/choices ["q-351438/field-1/62056d5ec4a7975ff5d6d624dc578a5d9c9514c65b1c7c3d4b62f913e332ffcd"] :db/ensure [:answer-field/validate]} {:db/id "q-351438" :question/id #uuid "515b6037-514c-5b0a-9744-97a84ce56ac0" :question/math-academy-id "q-351438" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/19f2adedfeac6e4c4af07c3d3742203020e10ce841dd22f8b2e22c36ee2bf8e1.png)\n\nFind the arc length of the curve $L$ defined parametrically as\n\n$$\nx={e}^{2t}\\operatorname{cos}⁡t,\\,y={e}^{2t}\\operatorname{sin}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nDo not round the answer.\n\n$L=\\frac{\\sqrt{5}}{2}(${{field-1}}$)$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t}\\operatorname{cos}⁡t) \\\\  & =2{e}^{2t}\\operatorname{cos}⁡t-{e}^{2t}\\operatorname{sin}⁡t \\\\  & ={e}^{2t}(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t}\\operatorname{sin}⁡t) \\\\  & =2{e}^{2t}\\operatorname{sin}⁡t+{e}^{2t}\\operatorname{cos}⁡t \\\\  & ={e}^{2t}(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{2t}(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t))}^{2}+{({e}^{2t}(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}{(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{e}^{4t}{(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}({(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2})}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}(4{cos}^{2}⁡t-4\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+4{sin}^{2}⁡t+4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}(4({cos}^{2}⁡t+{sin}^{2}⁡t)+{sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5{e}^{4t}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5}\\,{e}^{2t}\\,\\text{d}t \\\\  & =\\sqrt{5}\\cdot \\frac{{e}^{2t}}{2}\\,{|}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-351438/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-351438"] :db/ensure [:knowledge-point/validate]} {:db/id "q-10261/selection/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225" :answer/id #uuid "abb451af-ba20-5d14-9ac4-af61b67a6cd7" :answer/type :answer.type/math :answer/value "\\frac{16}{3}" :db/ensure [:answer/validate]} {:db/id "q-10261/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "79ea321c-fe00-5a87-a86d-00591936b716" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-10261/selection/1a2c3881891ab7eca8aa4af8d7002d84b8252f633df18da1be453e64ebd8a8b4" :answer/id #uuid "445be6a6-0063-502b-9aac-23e37c7a323e" :answer/type :answer.type/math :answer/value "4\\pi " :db/ensure [:answer/validate]} {:db/id "q-10261/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" :answer/id #uuid "dbe551f7-24b9-5809-b76f-56a3d8f97901" :answer/type :answer.type/math :answer/value "2\\pi " :db/ensure [:answer/validate]} {:db/id "q-10261/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "1357c54c-84b7-5d6b-992f-79e653977c54" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-10261/selection" :answer-field/id #uuid "38bd5068-041d-5e13-96a4-7dbcc59c88b0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-10261/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-10261/selection/29e18d29d5a8d00489a807deb821c9d8fb2c816d74392c4ec1d541f26b369225" "q-10261/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-10261/selection/1a2c3881891ab7eca8aa4af8d7002d84b8252f633df18da1be453e64ebd8a8b4" "q-10261/selection/d0ab94490dee12664d2f70471811316d5faf74c9c2c3f6dde546976ea292b76b" "q-10261/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-10261" :question/id #uuid "954304bc-c5f4-5131-95ba-54e09bfed3c0" :question/math-academy-id "q-10261" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/8288453c2625dac592a51054df332abf8ee49dbf8cbcabaf327c3ffe63b55f71.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t),\\,y=2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t),\\,t\\in [0,\\pi ].\n$$" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t))}^{2}+{(2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{sin}^{2}⁡t-8\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t)+4{sin}^{2}⁡(2t)+4{cos}^{2}⁡t-8\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+4{cos}^{2}⁡(2t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4+4-8(\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t))}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡(2t-t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2\\theta )=1-2{sin}^{2}⁡\\theta .$ Substituting $\\theta =\\frac{t}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2\\cdot \\frac{t}{2}) & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ \\operatorname{cos}⁡t & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 1-\\operatorname{cos}⁡t & =2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 8-8\\operatorname{cos}⁡t & =16{sin}^{2}⁡(\\frac{t}{2})\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{16{sin}^{2}⁡(\\frac{t}{2})}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(\\frac{t}{2})\\,\\text{d}t \\\\  & =-8{\\operatorname{cos}⁡(\\frac{t}{2})|}_{0}^{\\pi } \\\\  & =-8(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0) \\\\  & =-8(0-1) \\\\  & =8.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-10261/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-10261"] :db/ensure [:knowledge-point/validate]} {:db/id "q-351471/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "2beef0bb-f2de-5065-88df-6fa42f7e8cfc" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-351471/field-1" :answer-field/id #uuid "9583cf61-c775-58ba-b5f7-6ed8c59ee09a" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-351471/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-351471/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-351471" :question/id #uuid "f7189a16-363d-589b-963a-795f787317a0" :question/math-academy-id "q-351471" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/a4d2cf1820b792d804ab4d1b17ce1f36c0b63e4f406f8692d47f64a823b805f1.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=3\\operatorname{cos}⁡t-\\operatorname{cos}⁡(3t),\\,y=3\\operatorname{sin}⁡t-\\operatorname{sin}⁡(3t),\\,t\\in [0,\\pi ].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-\\operatorname{cos}⁡(3t)) \\\\  & =-3\\operatorname{sin}⁡t+3\\operatorname{sin}⁡(3t),\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t-\\operatorname{sin}⁡(3t)) \\\\  & =3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(-3\\operatorname{sin}⁡t+3\\operatorname{sin}⁡(3t))}^{2}+{(3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡(3t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9{sin}^{2}⁡t-18\\operatorname{sin}⁡t\\operatorname{sin}⁡(3t)+9{sin}^{2}⁡(3t)+9{cos}^{2}⁡t-18\\operatorname{cos}⁡t\\operatorname{cos}⁡(3t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9+9-18(\\operatorname{cos}⁡t\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡t\\operatorname{sin}⁡(3t))}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(3t-t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(2t)}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2t)=1-2{sin}^{2}⁡t.$ Therefore, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2t) & =1-2{sin}^{2}⁡(t) \\\\ 1-\\operatorname{cos}⁡(2t) & =2{sin}^{2}⁡(t) \\\\ 18-18\\operatorname{cos}⁡(2t) & =36{sin}^{2}⁡(t)\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(2t)}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{36{sin}^{2}⁡(t)}\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }|\\operatorname{sin}⁡(t)|\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(t)\\,\\text{d}t \\\\  & =-6\\operatorname{cos}⁡(t)\\,{|}_{0}^{\\pi } \\\\  & =-6(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡0) \\\\  & =-6(-1-1) \\\\  & =12.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-351471/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4c82bbc8-83bc-55f8-be32-4d63f6db7261"] :knowledge-point/questions ["q-351471"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-602"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/834eff403ac2a6f696e104ec914cac1b951f8a6d989e11c0e9f2576ac9e7f0d8.png)\n\nFind an integral expression for the arc length of the curve defined parametrically as\n\n$$\nx=1-t, \\quad y= \\dfrac{2}{3} t^{3/2}, \\qquad t\\in[0,1].\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-7130"] :question/problem "Find the expression that gives the length of the curve defined by the parametric equations\n$x=t, \\, y=\\ln{(\\cos{t})}$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/48de26c11ae08afb45ec19ee56e770f7418f9be2afb8ee7dd46a0d1136cb125b.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-603"] :question/problem "Find the arc length of the curve defined parametrically as\n\n$$\nx=e^t(\\cos{t}+\\sin{t}), \\quad y=e^t(\\cos{t}-\\sin{t}) , \\quad t\\in \\left[0,\\dfrac{\\pi}{4}\\right].\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/15d185178bf8882f837c19361d630c0e537e145ca2337cad4655677255d0348a.png)" :db/ensure [:question/validate]}]
