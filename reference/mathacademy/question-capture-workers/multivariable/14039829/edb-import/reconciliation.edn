operatorname{cos}⁡(3t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡(2t)+2) \\\\  & =-2\\operatorname{sin}⁡(2t)\\cdot 2 \\\\  & =-4\\operatorname{sin}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{(6\\operatorname{cos}⁡(3t))^{2}+(-4\\operatorname{sin}⁡(2t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{2}⁡(3t)+16{sin}^{2}⁡(2t)}\\,\\text{d}t \\\\  & =2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21339" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-21339" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21339" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)+2{sin}^{2}⁡(2t)}\\,\\text{d}t"] ["math" "2{\\int }_{0}^{\\pi /2}\\sqrt{6{cos}^{2}⁡(3t)-2{sin}^{2}⁡(2t)}\\,\\text{d}t"] ["math" "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t"] ["math" "4{\\int }_{0}^{\\pi /2}\\sqrt{{cos}^{2}⁡(3t)+{sin}^{2}⁡(2t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)-4{sin}^{2}⁡(2t)}\\,\\text{d}t"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21339" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "2{\\int }_{0}^{\\pi /2}\\sqrt{9{cos}^{2}⁡(3t)+4{sin}^{2}⁡(2t)}\\,\\text{d}t"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-15185" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/80577a585741748702b61596db84983592ecbc6c01fca78af033bf82dbe62ad2.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x={e}^{t},\\,y={e}^{t}\\operatorname{sin}⁡t$\nfrom $t=-3$ to $t=1$ (shown above)?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-15185" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t})={e}^{t}\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}\\operatorname{sin}⁡t)={e}^{t}(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}\\sqrt{{e}^{2t}+{e}^{2t}{(\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{1+{sin}^{2}⁡t+{cos}^{2}⁡t+2\\operatorname{sin}⁡t\\operatorname{cos}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-15185" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-15185" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-15185" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{cos}⁡(2t)}\\,\\text{d}t"] ["math" "{\\int }_{-3}^{1}{e}^{2t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t"] ["math" "{\\int }_{-3}^{1}{e}^{t}\\sqrt{1+\\operatorname{sin}⁡(2t)}\\,\\text{d}t"] ["math" "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{cos}⁡(2t)}\\,\\text{d}t"] ["math" "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-15185" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\int }_{-3}^{1}{e}^{t}\\sqrt{2+\\operatorname{sin}⁡(2t)}\\,\\text{d}t"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21354" "field" nil "attribute" "question/problem" "value" "Which of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t),\\,y=t-\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{4}$ ?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21354" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡(t)-\\operatorname{cos}⁡(t))=\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t-\\operatorname{sin}⁡(t))=1-\\operatorname{cos}⁡(t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{(\\operatorname{cos}⁡(t)+\\operatorname{sin}⁡(t))^{2}+(1-\\operatorname{cos}⁡(t))^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{cos}^{2}⁡(t)+{sin}^{2}⁡(t)+2\\operatorname{cos}⁡(t)\\operatorname{sin}⁡(t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+1+{cos}^{2}⁡(t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t\\,.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21354" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-21354" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21354" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)+{cos}^{2}⁡(t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /4}\\sqrt{1+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)+\\operatorname{cos}⁡(t)-{cos}^{2}⁡(t)}\\,\\text{d}t"] ["math" "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-21354" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\int }_{0}^{\\pi /4}\\sqrt{2+\\operatorname{sin}⁡(2t)-2\\operatorname{cos}⁡(t)+{cos}^{2}⁡(t)}\\,\\text{d}t"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10257" "field" nil "attribute" "question/problem" "value" "Find the arc length of the curve defined parametrically as\n\n$$\nx=2{cos}^{3}⁡t,\\,y=2{sin}^{3}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10257" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{cos}^{3}⁡t)=-6{cos}^{2}⁡t\\operatorname{sin}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2{sin}^{3}⁡t)=6{sin}^{2}⁡t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{(-6{cos}^{2}⁡t\\operatorname{sin}⁡t)}^{2}+{(6{sin}^{2}⁡t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{cos}^{4}⁡t{sin}^{2}⁡t+36{sin}^{4}⁡t{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{36{sin}^{2}⁡t{cos}^{2}⁡t({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}6\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t \\\\  & =3{\\int }_{0}^{\\pi /2}\\operatorname{sin}⁡(2t)\\,\\text{d}t \\\\  & =-\\frac{3}{2}\\operatorname{cos}⁡(2t){|}_{0}^{\\pi /2} \\\\  & =-\\frac{3}{2}(\\operatorname{cos}⁡\\pi -\\operatorname{cos}⁡0) \\\\  & =-\\frac{3}{2}(-1-1) \\\\  & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10257" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-10257" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Dev