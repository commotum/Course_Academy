d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t) \\\\  & =\\operatorname{cos}⁡t-(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =t\\operatorname{sin}⁡t,\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(-\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t) \\\\  & =\\operatorname{sin}⁡t-(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t) \\\\  & =-t\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(t\\operatorname{sin}⁡t)}^{2}+{(-t\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}{sin}^{2}⁡t+{t}^{2}{cos}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}({sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{t}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }t\\,\\text{d}t \\\\  & =\\frac{{t}^{2}}{2}\\,{|}_{0}^{\\pi } \\\\  & =\\frac{{\\pi }^{2}}{2}-0 \\\\  & =\\frac{{\\pi }^{2}}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-348086" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-348086" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-348086" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{\\pi^2}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351438" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/19f2adedfeac6e4c4af07c3d3742203020e10ce841dd22f8b2e22c36ee2bf8e1.png)\n\nFind the arc length of the curve $L$ defined parametrically as\n\n$$\nx={e}^{2t}\\operatorname{cos}⁡t,\\,y={e}^{2t}\\operatorname{sin}⁡t,\\,t\\in [0,\\frac{\\pi }{2}].\n$$\n\nDo not round the answer.\n\n$L=\\frac{\\sqrt{5}}{2}(${{field-1}}$)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351438" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t}\\operatorname{cos}⁡t) \\\\  & =2{e}^{2t}\\operatorname{cos}⁡t-{e}^{2t}\\operatorname{sin}⁡t \\\\  & ={e}^{2t}(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t),\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{2t}\\operatorname{sin}⁡t) \\\\  & =2{e}^{2t}\\operatorname{sin}⁡t+{e}^{2t}\\operatorname{cos}⁡t \\\\  & ={e}^{2t}(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{\\pi /2}\\sqrt{{({e}^{2t}(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t))}^{2}+{({e}^{2t}(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}{(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{e}^{4t}{(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}({(2\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)}^{2}+{(2\\operatorname{sin}⁡t+\\operatorname{cos}⁡t)}^{2})}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}(4{cos}^{2}⁡t-4\\operatorname{cos}⁡t\\operatorname{sin}⁡t+{sin}^{2}⁡t+4{sin}^{2}⁡t+4\\operatorname{sin}⁡t\\operatorname{cos}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{{e}^{4t}(4({cos}^{2}⁡t+{sin}^{2}⁡t)+{sin}^{2}⁡t+{cos}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5{e}^{4t}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /2}\\sqrt{5}\\,{e}^{2t}\\,\\text{d}t \\\\  & =\\sqrt{5}\\cdot \\frac{{e}^{2t}}{2}\\,{|}_{0}^{\\pi /2} \\\\  & =\\frac{\\sqrt{5}}{2}({e}^{\\pi }-1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351438" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-351438" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351438" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "e^{\\pi}-1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10261" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/8288453c2625dac592a51054df332abf8ee49dbf8cbcabaf327c3ffe63b55f71.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t),\\,y=2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t),\\,t\\in [0,\\pi ].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10261" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t-\\operatorname{cos}⁡(2t))=-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t)\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{sin}⁡t-\\operatorname{sin}⁡(2t))=2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(-2\\operatorname{sin}⁡t+2\\operatorname{sin}⁡(2t))}^{2}+{(2\\operatorname{cos}⁡t-2\\operatorname{cos}⁡(2t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4{sin}^{2}⁡t-8\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t)+4{sin}^{2}⁡(2t)+4{cos}^{2}⁡t-8\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+4{cos}^{2}⁡(2t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{4+4-8(\\operatorname{cos}⁡t\\operatorname{cos}⁡(2t)+\\operatorname{sin}⁡t\\operatorname{sin}⁡(2t))}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡(2t-t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2\\theta )=1-2{sin}^{2}⁡\\theta .$ Substituting $\\theta =\\frac{t}{2},$ we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2\\cdot \\frac{t}{2}) & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ \\operatorname{cos}⁡t & =1-2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 1-\\operatorname{cos}⁡t & =2{sin}^{2}⁡(\\frac{t}{2}) \\\\ 8-8\\operatorname{cos}⁡t & =16{sin}^{2}⁡(\\frac{t}{2})\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{8-8\\operatorname{cos}⁡t}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{16{sin}^{2}⁡(\\frac{t}{2})}\\,\\text{d}t \\\\  & =4{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(\\frac{t}{2})\\,\\text{d}t \\\\  & =-8{\\operatorname{cos}⁡(\\frac{t}{2})|}_{0}^{\\pi } \\\\  & =-8(\\operatorname{cos}⁡(\\frac{\\pi }{2})-\\operatorname{cos}⁡0) \\\\  & =-8(0-1) \\\\  & =8.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10261" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-10261" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10261" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2\\pi "] ["math" "4\\pi "] ["math" "8"] ["math" "\\frac{16}{3}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-10261" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "8"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351471" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/a4d2cf1820b792d804ab4d1b17ce1f36c0b63e4f406f8692d47f64a823b805f1.png)\n\nFind the arc length of the curve defined parametrically as\n\n$$\nx=3\\operatorname{cos}⁡t-\\operatorname{cos}⁡(3t),\\,y=3\\operatorname{sin}⁡t-\\operatorname{sin}⁡(3t),\\,t\\in [0,\\pi ].\n$$\n\nDo not round the answer.\n\n$L=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351471" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t-\\operatorname{cos}⁡(3t)) \\\\  & =-3\\operatorname{sin}⁡t+3\\operatorname{sin}⁡(3t),\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t-\\operatorname{sin}⁡(3t)) \\\\  & =3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡(3t).\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length and get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{{(-3\\operatorname{sin}⁡t+3\\operatorname{sin}⁡(3t))}^{2}+{(3\\operatorname{cos}⁡t-3\\operatorname{cos}⁡(3t))}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9{sin}^{2}⁡t-18\\operatorname{sin}⁡t\\operatorname{sin}⁡(3t)+9{sin}^{2}⁡(3t)+9{cos}^{2}⁡t-18\\operatorname{cos}⁡t\\operatorname{cos}⁡(3t)+9{cos}^{2}⁡(3t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{9+9-18(\\operatorname{cos}⁡t\\operatorname{cos}⁡(3t)+\\operatorname{sin}⁡t\\operatorname{sin}⁡(3t))}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(3t-t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(2t)}\\,\\text{d}t.\\end{aligned}\n$$\n\nAccording to the double-angle formula for cosine, $\\operatorname{cos}⁡(2t)=1-2{sin}^{2}⁡t.$ Therefore, we obtain\n\n$$\n\\begin{aligned}\\operatorname{cos}⁡(2t) & =1-2{sin}^{2}⁡(t) \\\\ 1-\\operatorname{cos}⁡(2t) & =2{sin}^{2}⁡(t) \\\\ 18-18\\operatorname{cos}⁡(2t) & =36{sin}^{2}⁡(t)\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi }\\sqrt{18-18\\operatorname{cos}⁡(2t)}\\,\\text{d}t & ={\\int }_{0}^{\\pi }\\sqrt{36{sin}^{2}⁡(t)}\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }|\\operatorname{sin}⁡(t)|\\,\\text{d}t \\\\  & =6{\\int }_{0}^{\\pi }\\operatorname{sin}⁡(t)\\,\\text{d}t \\\\  & =-6\\operatorname{cos}⁡(t)\\,{|}_{0}^{\\pi } \\\\  & =-6(\\operatorname{cos}⁡(\\pi )-\\operatorname{cos}⁡0) \\\\  & =-6(-1-1) \\\\  & =12.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351471" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/activity-metadata.json" "file_sha256" "fca83d133dfbce94c6d6fb8122c09b1e7028fadefab673818953b0808b76345f"} {"question" "q-351471" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "q-351471" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "12"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/state.json" "file_sha256" "2e0226043fed6ba0104c5d1ce045f228d357296f9c74a07382d19d96cfe7c2e5"} {"question" "e-602" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/834eff403ac2a6f696e104ec914cac1b951f8a6d989e11c0e9f2576ac9e7f0d8.png)\n\nFind an integral expression for the arc length of the curve defined parametrically as\n\n$$\nx=1-t, \\quad y= \\dfrac{2}{3} t^{3/2}, \\qquad t\\in[0,1].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/example-602.json" "file_sha256" "7e9df96239d3209227b27384091c19ef491bcad47293a723476cf37872c6a526"} {"question" "e-602" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(1-t)=-1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{3}{t}^{3/2})={t}^{1/2}.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{{(-1)}^{2}+{({t}^{1/2})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}\\sqrt{1+t}\\,\\text{d}t.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/example-602.json" "file_sha256" "7e9df96239d3209227b27384091c19ef491bcad47293a723476cf37872c6a526"} {"question" "e-7130" "field" nil "attribute" "question/problem" "value" "Find the expression that gives the length of the curve defined by the parametric equations\n$x=t, \\, y=\\ln{(\\cos{t})}$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/48de26c11ae08afb45ec19ee56e770f7418f9be2afb8ee7dd46a0d1136cb125b.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/example-7130.json" "file_sha256" "4c0c3301091de7841a15e903f9b73d52539118c9742282a5c215c022659df354"} {"question" "e-7130" "field" nil "attribute" "question/worked-solution" "value" "To compute the arc length $L$ of a parametrically defined curve, we use the formula\n\n$$\nL = \\int_{t_1}^{t_2} \\sqrt{ \\left( \\dfrac{\\textrm{d}x}{\\textrm{d}t}\\right)^2 + \\left( \\dfrac{\\textrm{d}y}{\\textrm{d}t}\\right)^2}\\:\\textrm{d}t.\n$$\n\nComputing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(t)=1\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{ln}⁡(\\operatorname{cos}⁡t))=-\\operatorname{tan}⁡t\\,.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(1)}^{2}+{(-\\operatorname{tan}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{1+{tan}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{sec}^{2}⁡t}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡t\\,\\text{d}t\\,.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/example-7130.json" "file_sha256" "4c0c3301091de7841a15e903f9b73d52539118c9742282a5c215c022659df354"} {"question" "e-603" "field" nil "attribute" "question/problem" "value" "Find the arc length of the curve defined parametrically as\n\n$$\nx=e^t(\\cos{t}+\\sin{t}), \\quad y=e^t(\\cos{t}-\\sin{t}) , \\quad t\\in \\left[0,\\dfrac{\\pi}{4}\\right].\n$$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/assets/15d185178bf8882f837c19361d630c0e537e145ca2337cad4655677255d0348a.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/example-603.json" "file_sha256" "fbc8d577d536723b968a63663e29c2f073b1b34f88ae642107fa1f79c7348eea"} {"question" "e-603" "field" nil "attribute" "question/worked-solution" "value" "Computing the derivatives of $x$ and $y,$ we have\n\n$$\n\\begin{aligned}\\frac{\\text{d}x}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t+\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t+\\operatorname{cos}⁡t) \\\\  & =2{e}^{t}\\operatorname{cos}⁡t\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}t} & =\\frac{\\text{d}}{\\text{d}t}({e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)) \\\\  & ={e}^{t}(\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)+{e}^{t}(-\\operatorname{sin}⁡t-\\operatorname{cos}⁡t) \\\\  & =-2{e}^{t}\\operatorname{sin}⁡t.\\end{aligned}\n$$\n\nWe substitute these derivatives in the formula for arc length, and we get\n\n$$\n\\begin{aligned}L & ={\\int }_{{t}_{1}}^{{t}_{2}}\\sqrt{{(\\frac{\\text{d}x}{\\text{d}t})}^{2}+{(\\frac{\\text{d}y}{\\text{d}t})}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{{(2{e}^{t}\\operatorname{cos}⁡t)}^{2}+{(-2{e}^{t}\\operatorname{sin}⁡t)}^{2}}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}\\sqrt{4{e}^{2t}({cos}^{2}⁡t+{sin}^{2}⁡t)}\\,\\text{d}t \\\\  & ={\\int }_{0}^{\\pi /4}2{e}^{t}\\,\\text{d}t \\\\  & =2{e}^{t}{|}_{0}^{\\pi /4} \\\\  & =2({e}^{\\pi /4}-1).\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039829/example-603.json" "file_sha256" "fbc8d577d536723b968a63663e29c2f073b1b34f88ae642107fa1f79c7348eea"}] "usage" {"q-123030" [] "e-602" [] "q-21354" [] "q-15174" [] "q-15185" [] "e-7130" [] "e-603" [] "q-81377" [] "q-21339" []} "basis" 1388 "retractions" [[17592186289504 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/8868658c9bc7195f435a0109fce26b8a4fa39324c0a9a39e3fb644c5f02cdc9b.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x=\\operatorname{cos}⁡(5t),\\,y=6\\operatorname{sin}⁡(t)$\nfrom $t=0$ to $t=\\frac{\\pi }{2}$ (shown above)?"] [17592186092521 :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/997/Source/Images/q-15185.png)\n\nWhich of the following gives the length of the curve defined by the parametric equations\n$x = e^{t}, y = e^{t}\\sin t$\nfrom $t =-3$ to $t = 1$ (shown above)?"] [17592186092028 :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14010979/assets/834eff403ac2a6f696e104ec914cac1b951f8a6d989e11c0e9f2576ac9e7f0d8.png)\n\nFind an integral expression for the arc length of the curve defined parametrically as\n\n$$\nx=1-t, \\quad y= \\dfrac{2}{3} t^{3/2}, \\qquad t\\in[0,1].\n$$"] [17592186092060 :question/problem "Find the expression that gives the length of the curve defined by the parametric equations\n$x=t, \\, y=\\ln{(\\cos{t})}$\nfrom $t=0$ to $t=\\dfrac{\\pi}{4}$ (see graph below).\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-captu