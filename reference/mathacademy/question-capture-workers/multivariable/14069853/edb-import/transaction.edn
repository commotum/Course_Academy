[{:db/id "q-124670/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "5f7912b5-d5e1-5abb-84ac-2d18623090dd" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-124670/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "c10a001b-61dd-5524-897a-428e48681ad0" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-124670/selection/2ee71f97da76a36a5f98bee4ae2425715bbc4597486731aaed28becb23704cce" :answer/id #uuid "61022807-4ade-5a11-b8bc-a656d6ee6560" :answer/type :answer.type/math :answer/value "\\frac{25}{4}" :db/ensure [:answer/validate]} {:db/id "q-124670/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "7293fbaf-d3e7-50ed-8620-edcc624024de" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-124670/selection/bcbe057cec11b06e556ce6eb64efebcbc7b9b530f339b3d67669620f3e550dc2" :answer/id #uuid "6236548a-068c-5997-b9c5-3215d5939b04" :answer/type :answer.type/math :answer/value "\\frac{12}{5}" :db/ensure [:answer/validate]} {:db/id "q-124670/selection" :answer-field/id #uuid "d650df58-6526-5067-8448-f34df84b167a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124670/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer-field/choices ["q-124670/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-124670/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" "q-124670/selection/2ee71f97da76a36a5f98bee4ae2425715bbc4597486731aaed28becb23704cce" "q-124670/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-124670/selection/bcbe057cec11b06e556ce6eb64efebcbc7b9b530f339b3d67669620f3e550dc2"] :db/ensure [:answer-field/validate]} {:db/id "q-124670" :question/id #uuid "16250da2-a90d-5af7-9a9c-94a80f6b4648" :question/math-academy-id "q-124670" :question/problem "Evaluate ${\\int }_{C}(x+y)\\,dx+x\\,dy,$ where $C$ is a portion of the parabola parametrized by $r(t)=2t\\,i+(2-{t}^{2})\\,j$ for $t\\in [0,1].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=2t,\\,y(t)=2-{t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2-{t}^{2})\\,j \\\\  & =2\\,i-2t\\,j.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,dx+x\\,dy & ={\\int }_{0}^{1}(x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}[(x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}+x\\cdot \\frac{\\text{d}y}{\\text{d}t}]dt \\\\  & ={\\int }_{0}^{1}(2t+2-{t}^{2})\\cdot 2+2t\\cdot (-2t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}-6{t}^{2}+4t+4\\,\\text{d}t \\\\  & ={[-2{t}^{3}+2{t}^{2}+4t]}_{0}^{1} \\\\  & =(-2+2+4)-0 \\\\  & =4\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124670/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75"] :knowledge-point/questions ["q-124670"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124712/selection/d8cd264091a836aefb02dec1f570201d35401e86aa6f7b9880840a4ca4479e72" :answer/id #uuid "9789d3d6-9044-5179-b88b-f261e68e646a" :answer/type :answer.type/math :answer/value "72{\\pi }^{4}-18\\pi " :db/ensure [:answer/validate]} {:db/id "q-124712/selection/9cc8582e1f46c750b0fc23fcba4f2f2c2fc67b75c046c6b1c23d58c86b2accf8" :answer/id #uuid "f829ebbb-6f79-5ae8-a858-6ff0e1fae74e" :answer/type :answer.type/math :answer/value "24{\\pi }^{4}" :db/ensure [:answer/validate]} {:db/id "q-124712/selection/fa594c4b13f6c3fd2a5cc7d459373a4b3a612aec4917da31e54ed30eba6cdd3c" :answer/id #uuid "ccf58632-30a2-5112-9b5c-00b75a4ae509" :answer/type :answer.type/math :answer/value "36{\\pi }^{4}" :db/ensure [:answer/validate]} {:db/id "q-124712/selection/3ea91a5bab2602c41f5a97c3b9aa457dd0458c0f795a62f850d94f68ae32d117" :answer/id #uuid "6494d20b-7b01-5731-9a4a-c4cb8c4f9e60" :answer/type :answer.type/math :answer/value "60{\\pi }^{2}-12\\pi " :db/ensure [:answer/validate]} {:db/id "q-124712/selection/a98fdae50d54c041df841453073c01a0bdc310bd4bff249815913e687bca30b9" :answer/id #uuid "e73fc8ea-29e0-5690-8cd3-11f9f60bc9cc" :answer/type :answer.type/math :answer/value "13{\\pi }^{2}+5" :db/ensure [:answer/validate]} {:db/id "q-124712/selection" :answer-field/id #uuid "1a34eb79-bc84-5310-9738-cebc91dc8e3a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124712/selection/d8cd264091a836aefb02dec1f570201d35401e86aa6f7b9880840a4ca4479e72" :answer-field/choices ["q-124712/selection/d8cd264091a836aefb02dec1f570201d35401e86aa6f7b9880840a4ca4479e72" "q-124712/selection/9cc8582e1f46c750b0fc23fcba4f2f2c2fc67b75c046c6b1c23d58c86b2accf8" "q-124712/selection/fa594c4b13f6c3fd2a5cc7d459373a4b3a612aec4917da31e54ed30eba6cdd3c" "q-124712/selection/3ea91a5bab2602c41f5a97c3b9aa457dd0458c0f795a62f850d94f68ae32d117" "q-124712/selection/a98fdae50d54c041df841453073c01a0bdc310bd4bff249815913e687bca30b9"] :db/ensure [:answer-field/validate]} {:db/id "q-124712" :question/id #uuid "d4cf4200-fc0d-5217-9f63-3ee1808f45ab" :question/math-academy-id "q-124712" :question/problem "Evaluate ${\\int }_{C}x\\,dx-z\\,dy+y\\,dz,$ where $C$ is a portion of the curve $r(t)=3{t}^{2}\\,i+3\\operatorname{sin}⁡t\\,j+3\\operatorname{cos}⁡t\\,k$ for $t\\in [0,2\\pi ].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=3{t}^{2},\\,y(t)=3\\operatorname{sin}⁡t,\\,z(t)=3\\operatorname{cos}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)\\,k \\\\  & =6t\\,i+3\\operatorname{cos}⁡t\\,j-3\\operatorname{sin}⁡t\\,k.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,dx-z\\,dy+y\\,dz & ={\\int }_{0}^{2\\pi }x\\frac{\\text{d}x}{\\text{d}t}\\,dt-z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }(x\\frac{\\text{d}x}{\\text{d}t}-z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{2\\pi }3{t}^{2}\\cdot (6t)-3\\operatorname{cos}⁡t\\cdot (3\\operatorname{cos}⁡t)+3\\operatorname{sin}⁡t\\cdot (-3\\operatorname{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }18{t}^{3}-9{cos}^{2}⁡t-9{sin}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }18{t}^{3}-9\\,dt \\\\  & =(\\frac{9{t}^{4}}{2}-9t){|}_{0}^{2\\pi } \\\\  & =72{\\pi }^{4}-18\\pi \\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-124712/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75"] :knowledge-point/questions ["q-124712"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124830/selection/54cd7b230169a7dfc6ecf3e5e7ab44038146bb1d1cb5dfdbe690c0f023ba1311" :answer/id #uuid "1924e64a-a123-5e87-968a-ef6c5dff57d4" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{3}+2\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124830/selection/70dc06a5afd70f61c6146be577f5f58850d168007a932de3a2e4cc5bb222dff6" :answer/id #uuid "1e606268-942a-5720-9c3d-19259cc7a145" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{3}+{sin}^{2}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124830/selection/54d6eaef3331ca88c45c31030dbba1a4836bfe318880daaffd520361dfd52116" :answer/id #uuid "8bfbd984-e051-516a-bb15-22c78d2429df" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{5}-4\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124830/selection/67a88e809288c4b062a5babf59f8247c483f41b1d7851a59564a7a536388b753" :answer/id #uuid "d62cf39f-99ce-5d61-b01e-ae6ba5eb11e3" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{4}-2{sin}^{2}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124830/selection/119e9eb2826d0650862c3729775c7257891dd166091466499c363167a84e1450" :answer/id #uuid "eda5059b-1009-5daa-a916-692dffe1ab53" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{4}-2\\operatorname{cos}⁡t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124830/selection" :answer-field/id #uuid "f8693755-87b9-59d8-994b-005c85b660e9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124830/selection/54d6eaef3331ca88c45c31030dbba1a4836bfe318880daaffd520361dfd52116" :answer-field/choices ["q-124830/selection/54cd7b230169a7dfc6ecf3e5e7ab44038146bb1d1cb5dfdbe690c0f023ba1311" "q-124830/selection/70dc06a5afd70f61c6146be577f5f58850d168007a932de3a2e4cc5bb222dff6" "q-124830/selection/54d6eaef3331ca88c45c31030dbba1a4836bfe318880daaffd520361dfd52116" "q-124830/selection/67a88e809288c4b062a5babf59f8247c483f41b1d7851a59564a7a536388b753" "q-124830/selection/119e9eb2826d0650862c3729775c7257891dd166091466499c363167a84e1450"] :db/ensure [:answer-field/validate]} {:db/id "q-124830" :question/id #uuid "11b5a17d-6e7e-5206-aa6e-9f629bb3afce" :question/math-academy-id "q-124830" :question/problem "Which of the following is equivalent to ${\\int }_{C}-y\\,dx+x\\,dy+{z}^{2}\\,dz,$ where $C$ is a portion of the curve $r(t)=2\\operatorname{cos}⁡t\\,i-2\\operatorname{sin}⁡t\\,j+{t}^{2}\\,k$ for $t\\in [0,\\frac{3\\pi }{2}]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=2\\operatorname{cos}⁡t,\\,y(t)=-2\\operatorname{sin}⁡t,\\,z(t)={t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(-2\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =-2\\operatorname{sin}⁡t\\,i-2\\operatorname{cos}⁡t\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-y\\,dx+x\\,dy+{z}^{2}\\,dz & ={\\int }_{0}^{3\\pi /2}-y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+{z}^{2}\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}(-y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+{z}^{2}\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{3\\pi /2}2\\operatorname{sin}⁡t\\cdot (-2\\operatorname{sin}⁡t)+2\\operatorname{cos}⁡t\\cdot (-2\\operatorname{cos}⁡t)+{t}^{4}\\cdot (2t)\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}2{t}^{5}-4{sin}^{2}⁡t-4{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}2{t}^{5}-4\\,dt\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124830/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049"] :knowledge-point/questions ["q-124830"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124874/selection/0ee8562743dbf59aa99dd3c5adf8bd14c4a9294876e2bb0726862df9fc3913a1" :answer/id #uuid "7fb2992a-bfdf-552f-b76c-c488c8b71280" :answer/type :answer.type/math :answer/value "{\\int }_{3}^{5}{t}^{2}+5\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124874/selection/1714d3e98d50255d298c5cd0020dc4feb432ce5a75b510a18e1f77e0a4b5e15f" :answer/id #uuid "a7ee24dc-48a5-5b9b-b841-7c77b2b4e76c" :answer/type :answer.type/math :answer/value "3{\\int }_{3}^{5}{t}^{5}+{t}^{3}\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124874/selection/c64436c9e99dcdf412195e3e230ddcb2b725f8f4ccbd4fa31a2b20a36f576b09" :answer/id #uuid "555c01a7-cfa4-512e-ad42-9fbac72b4708" :answer/type :answer.type/math :answer/value "{\\int }_{3}^{5}{t}^{5}+13t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124874/selection/911176fbd2e869508dbd93e85c2032cc14626fba0e6545ffe6fb50693b2b2f11" :answer/id #uuid "50b5668d-11ab-5285-9f56-9b4ea164a411" :answer/type :answer.type/math :answer/value "3{\\int }_{3}^{5}{t}^{4}+t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124874/selection/0c3c728f1e1dec10951fcc91c3648152e870506d4073308ea3d29f8f243cad70" :answer/id #uuid "9c251dc8-6ab8-57e7-baa0-648ad19a3149" :answer/type :answer.type/math :answer/value "3{\\int }_{3}^{5}t+5\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124874/selection" :answer-field/id #uuid "dea43d7e-e263-5fa8-ad24-5e19124d3b13" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124874/selection/1714d3e98d50255d298c5cd0020dc4feb432ce5a75b510a18e1f77e0a4b5e15f" :answer-field/choices ["q-124874/selection/0ee8562743dbf59aa99dd3c5adf8bd14c4a9294876e2bb0726862df9fc3913a1" "q-124874/selection/1714d3e98d50255d298c5cd0020dc4feb432ce5a75b510a18e1f77e0a4b5e15f" "q-124874/selection/c64436c9e99dcdf412195e3e230ddcb2b725f8f4ccbd4fa31a2b20a36f576b09" "q-124874/selection/911176fbd2e869508dbd93e85c2032cc14626fba0e6545ffe6fb50693b2b2f11" "q-124874/selection/0c3c728f1e1dec10951fcc91c3648152e870506d4073308ea3d29f8f243cad70"] :db/ensure [:answer-field/validate]} {:db/id "q-124874" :question/id #uuid "0ecd3a3a-cbc4-5984-b2b3-63464f6c03d0" :question/math-academy-id "q-124874" :question/problem "Which of the following is equivalent to ${\\int }_{C}xy\\,dx+y\\,dy+z\\,dz,$ where $C$ is a portion of the curve $r(t)=t\\,i+{t}^{2}\\,j+{t}^{3}\\,k$ for $t\\in [3,5]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)={t}^{2},\\,z(t)={t}^{3}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,k \\\\  & =\\,i+2t\\,j+3{t}^{2}\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,dx+y\\,dy+z\\,dz & ={\\int }_{3}^{5}xy\\frac{\\text{d}x}{\\text{d}t}\\,dt+y\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{3}^{5}(xy\\frac{\\text{d}x}{\\text{d}t}+y\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{3}^{5}{t}^{3}\\cdot (1)+{t}^{2}\\cdot (2t)+{t}^{3}\\cdot (3{t}^{2})\\,dt \\\\  & ={\\int }_{3}^{5}3{t}^{5}+3{t}^{3}\\,dt \\\\  & =3{\\int }_{3}^{5}{t}^{5}+{t}^{3}\\,dt\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124874/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049"] :knowledge-point/questions ["q-124874"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124879/selection/7f2c30bf067a0d368896fa2ca90dd0234eb74443b236b6d55fb04636b3befddc" :answer/id #uuid "2125d1c5-291b-5693-8723-e5479d57e6f1" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{6}5\\operatorname{ln}⁡t+4{t}^{4}\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124879/selection/b00b471d1e5fcca6cd58ecd4bdcf33446e1473cfe12050a0e32d27db9402562c" :answer/id #uuid "b5e11bc3-87d3-5833-81d4-456426acdb34" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{6}\\operatorname{ln}⁡t+2{t}^{5}-2{t}^{3}\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124879/selection/bac07d8e415f749c5e8e852080e12a937adfcc42daba5156c3485a49f77e6949" :answer/id #uuid "66eda466-7ed6-5afb-8e7c-ba897d54de1a" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{6}5{t}^{5}-3{t}^{3}\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124879/selection/11c7d244b609e3b55c50197646190576b5f5ae0a1d243e130b3947a8892fad10" :answer/id #uuid "c9f19e8a-e822-5f4e-baec-7b48e3d21c41" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{6}\\operatorname{ln}⁡t+5t\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124879/selection/bb4ef174ffdfb70b19d6f09026bb3e5e045439396d89e1bec046a6ba9d741f4d" :answer/id #uuid "518e472f-75c2-518b-9e0a-ff0e5ce670c8" :answer/type :answer.type/math :answer/value "{\\int }_{2}^{6}{ln}^{2}⁡t-2{t}^{3}\\,dt" :db/ensure [:answer/validate]} {:db/id "q-124879/selection" :answer-field/id #uuid "136e6e19-7c5b-5fe5-a994-00852cc9396e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124879/selection/b00b471d1e5fcca6cd58ecd4bdcf33446e1473cfe12050a0e32d27db9402562c" :answer-field/choices ["q-124879/selection/7f2c30bf067a0d368896fa2ca90dd0234eb74443b236b6d55fb04636b3befddc" "q-124879/selection/b00b471d1e5fcca6cd58ecd4bdcf33446e1473cfe12050a0e32d27db9402562c" "q-124879/selection/bac07d8e415f749c5e8e852080e12a937adfcc42daba5156c3485a49f77e6949" "q-124879/selection/11c7d244b609e3b55c50197646190576b5f5ae0a1d243e130b3947a8892fad10" "q-124879/selection/bb4ef174ffdfb70b19d6f09026bb3e5e045439396d89e1bec046a6ba9d741f4d"] :db/ensure [:answer-field/validate]} {:db/id "q-124879" :question/id #uuid "a503ae2b-c508-50f6-a415-a83a3a5ff562" :question/math-academy-id "q-124879" :question/problem "Which of the following is equivalent to ${\\int }_{C}\\operatorname{ln}⁡x\\,dx-z\\,dy+{y}^{2}\\,dz,$ where $C$ is a portion of the curve $r(t)=t\\,i+{t}^{2}\\,j+{t}^{2}\\,k$ for $t\\in [2,6]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)={t}^{2},\\,z(t)={t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =\\,i+2t\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{ln}⁡x\\,dx-z\\,dy+{y}^{2}\\,dz & ={\\int }_{2}^{6}\\operatorname{ln}⁡x\\frac{\\text{d}x}{\\text{d}t}\\,dt-z\\frac{\\text{d}y}{\\text{d}t}\\,dt+{y}^{2}\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{2}^{6}(\\operatorname{ln}⁡x\\frac{\\text{d}x}{\\text{d}t}-z\\frac{\\text{d}y}{\\text{d}t}+{y}^{2}\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{2}^{6}\\operatorname{ln}⁡t\\cdot (1)-{t}^{2}\\cdot (2t)+{t}^{4}\\cdot (2t)\\,dt \\\\  & ={\\int }_{2}^{6}\\operatorname{ln}⁡t+2{t}^{5}-2{t}^{3}\\,dt\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124879/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049"] :knowledge-point/questions ["q-124879"] :db/ensure [:knowledge-point/validate]}]
