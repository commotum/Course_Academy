#{[{:db/id #edb/ref 17592186363254 :knowledge-point/_questions [{:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75" :knowledge-point/title "Evaluating a Line Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "61022807-4ade-5a11-b8bc-a656d6ee6560" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{4}" :db/id #edb/ref 17592186363256} {:answer/id #uuid "5f7912b5-d5e1-5abb-84ac-2d18623090dd" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186363257} {:answer/id #uuid "7293fbaf-d3e7-50ed-8620-edcc624024de" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186363258} {:answer/id #uuid "6236548a-068c-5997-b9c5-3215d5939b04" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{12}{5}" :db/id #edb/ref 17592186363259} {:answer/id #uuid "c10a001b-61dd-5524-897a-428e48681ad0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186363260}] :answer-field/correct {:answer/id #uuid "c10a001b-61dd-5524-897a-428e48681ad0" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186363260} :answer-field/id #uuid "d650df58-6526-5067-8448-f34df84b167a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363255}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "16250da2-a90d-5af7-9a9c-94a80f6b4648" :question/math-academy-id "q-124670" :question/problem "Evaluate ${\\int }_{C}(x+y)\\,dx+x\\,dy,$ where $C$ is a portion of the parabola parametrized by $r(t)=2t\\,i+(2-{t}^{2})\\,j$ for $t\\in [0,1].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=2t,\\,y(t)=2-{t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2t)\\,i+\\frac{\\text{d}}{\\text{d}t}(2-{t}^{2})\\,j \\\\  & =2\\,i-2t\\,j.\\end{aligned}\n$$\n\nWe can calculate the line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}(x+y)\\,dx+x\\,dy & ={\\int }_{0}^{1}(x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\cdot \\frac{\\text{d}y}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{1}[(x+y)\\cdot \\frac{\\text{d}x}{\\text{d}t}+x\\cdot \\frac{\\text{d}y}{\\text{d}t}]dt \\\\  & ={\\int }_{0}^{1}(2t+2-{t}^{2})\\cdot 2+2t\\cdot (-2t)\\,\\text{d}t \\\\  & ={\\int }_{0}^{1}-6{t}^{2}+4t+4\\,\\text{d}t \\\\  & ={[-2{t}^{3}+2{t}^{2}+4t]}_{0}^{1} \\\\  & =(-2+2+4)-0 \\\\  & =4\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186363261 :knowledge-point/_questions [{:knowledge-point/id #uuid "2daf57e1-a02d-5e5f-b4a4-bb8ae9638a75" :knowledge-point/title "Evaluating a Line Integral"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6494d20b-7b01-5731-9a4a-c4cb8c4f9e60" :answer/type {:db/ident :answer.type/math} :answer/value "60{\\pi }^{2}-12\\pi " :db/id #edb/ref 17592186363263} {:answer/id #uuid "f829ebbb-6f79-5ae8-a858-6ff0e1fae74e" :answer/type {:db/ident :answer.type/math} :answer/value "24{\\pi }^{4}" :db/id #edb/ref 17592186363264} {:answer/id #uuid "e73fc8ea-29e0-5690-8cd3-11f9f60bc9cc" :answer/type {:db/ident :answer.type/math} :answer/value "13{\\pi }^{2}+5" :db/id #edb/ref 17592186363265} {:answer/id #uuid "9789d3d6-9044-5179-b88b-f261e68e646a" :answer/type {:db/ident :answer.type/math} :answer/value "72{\\pi }^{4}-18\\pi " :db/id #edb/ref 17592186363266} {:answer/id #uuid "ccf58632-30a2-5112-9b5c-00b75a4ae509" :answer/type {:db/ident :answer.type/math} :answer/value "36{\\pi }^{4}" :db/id #edb/ref 17592186363267}] :answer-field/correct {:answer/id #uuid "9789d3d6-9044-5179-b88b-f261e68e646a" :answer/type {:db/ident :answer.type/math} :answer/value "72{\\pi }^{4}-18\\pi " :db/id #edb/ref 17592186363266} :answer-field/id #uuid "1a34eb79-bc84-5310-9738-cebc91dc8e3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363262}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "d4cf4200-fc0d-5217-9f63-3ee1808f45ab" :question/math-academy-id "q-124712" :question/problem "Evaluate ${\\int }_{C}x\\,dx-z\\,dy+y\\,dz,$ where $C$ is a portion of the curve $r(t)=3{t}^{2}\\,i+3\\operatorname{sin}⁡t\\,j+3\\operatorname{cos}⁡t\\,k$ for $t\\in [0,2\\pi ].$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=3{t}^{2},\\,y(t)=3\\operatorname{sin}⁡t,\\,z(t)=3\\operatorname{cos}⁡t.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(3{t}^{2})\\,i+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(3\\operatorname{cos}⁡t)\\,k \\\\  & =6t\\,i+3\\operatorname{cos}⁡t\\,j-3\\operatorname{sin}⁡t\\,k.\\end{aligned}\n$$\n\nWe can now evaluate the line integral:\n\n$$\n\\begin{aligned}{\\int }_{C}x\\,dx-z\\,dy+y\\,dz & ={\\int }_{0}^{2\\pi }x\\frac{\\text{d}x}{\\text{d}t}\\,dt-z\\frac{\\text{d}y}{\\text{d}t}\\,dt+y\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{2\\pi }(x\\frac{\\text{d}x}{\\text{d}t}-z\\frac{\\text{d}y}{\\text{d}t}+y\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{2\\pi }3{t}^{2}\\cdot (6t)-3\\operatorname{cos}⁡t\\cdot (3\\operatorname{cos}⁡t)+3\\operatorname{sin}⁡t\\cdot (-3\\operatorname{sin}⁡t)\\,dt \\\\  & ={\\int }_{0}^{2\\pi }18{t}^{3}-9{cos}^{2}⁡t-9{sin}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{2\\pi }18{t}^{3}-9\\,dt \\\\  & =(\\frac{9{t}^{4}}{2}-9t){|}_{0}^{2\\pi } \\\\  & =72{\\pi }^{4}-18\\pi \\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186363268 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049" :knowledge-point/title "Constructing a Sum of Line Integrals With Respect to X, Y, and Z"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eda5059b-1009-5daa-a916-692dffe1ab53" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{4}-2\\operatorname{cos}⁡t\\,dt" :db/id #edb/ref 17592186363270} {:answer/id #uuid "1924e64a-a123-5e87-968a-ef6c5dff57d4" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{3}+2\\,dt" :db/id #edb/ref 17592186363271} {:answer/id #uuid "8bfbd984-e051-516a-bb15-22c78d2429df" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{5}-4\\,dt" :db/id #edb/ref 17592186363272} {:answer/id #uuid "d62cf39f-99ce-5d61-b01e-ae6ba5eb11e3" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{4}-2{sin}^{2}⁡t\\,dt" :db/id #edb/ref 17592186363273} {:answer/id #uuid "1e606268-942a-5720-9c3d-19259cc7a145" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{3}+{sin}^{2}⁡t\\,dt" :db/id #edb/ref 17592186363274}] :answer-field/correct {:answer/id #uuid "8bfbd984-e051-516a-bb15-22c78d2429df" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{0}^{3\\pi /2}2{t}^{5}-4\\,dt" :db/id #edb/ref 17592186363272} :answer-field/id #uuid "f8693755-87b9-59d8-994b-005c85b660e9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363269}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "11b5a17d-6e7e-5206-aa6e-9f629bb3afce" :question/math-academy-id "q-124830" :question/problem "Which of the following is equivalent to ${\\int }_{C}-y\\,dx+x\\,dy+{z}^{2}\\,dz,$ where $C$ is a portion of the curve $r(t)=2\\operatorname{cos}⁡t\\,i-2\\operatorname{sin}⁡t\\,j+{t}^{2}\\,k$ for $t\\in [0,\\frac{3\\pi }{2}]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=2\\operatorname{cos}⁡t,\\,y(t)=-2\\operatorname{sin}⁡t,\\,z(t)={t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(-2\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =-2\\operatorname{sin}⁡t\\,i-2\\operatorname{cos}⁡t\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}-y\\,dx+x\\,dy+{z}^{2}\\,dz & ={\\int }_{0}^{3\\pi /2}-y\\frac{\\text{d}x}{\\text{d}t}\\,dt+x\\frac{\\text{d}y}{\\text{d}t}\\,dt+{z}^{2}\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}(-y\\frac{\\text{d}x}{\\text{d}t}+x\\frac{\\text{d}y}{\\text{d}t}+{z}^{2}\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{0}^{3\\pi /2}2\\operatorname{sin}⁡t\\cdot (-2\\operatorname{sin}⁡t)+2\\operatorname{cos}⁡t\\cdot (-2\\operatorname{cos}⁡t)+{t}^{4}\\cdot (2t)\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}2{t}^{5}-4{sin}^{2}⁡t-4{cos}^{2}⁡t\\,dt \\\\  & ={\\int }_{0}^{3\\pi /2}2{t}^{5}-4\\,dt\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186363275 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049" :knowledge-point/title "Constructing a Sum of Line Integrals With Respect to X, Y, and Z"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9c251dc8-6ab8-57e7-baa0-648ad19a3149" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{3}^{5}t+5\\,dt" :db/id #edb/ref 17592186363277} {:answer/id #uuid "7fb2992a-bfdf-552f-b76c-c488c8b71280" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{3}^{5}{t}^{2}+5\\,dt" :db/id #edb/ref 17592186363278} {:answer/id #uuid "a7ee24dc-48a5-5b9b-b841-7c77b2b4e76c" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{3}^{5}{t}^{5}+{t}^{3}\\,dt" :db/id #edb/ref 17592186363279} {:answer/id #uuid "50b5668d-11ab-5285-9f56-9b4ea164a411" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{3}^{5}{t}^{4}+t\\,dt" :db/id #edb/ref 17592186363280} {:answer/id #uuid "555c01a7-cfa4-512e-ad42-9fbac72b4708" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{3}^{5}{t}^{5}+13t\\,dt" :db/id #edb/ref 17592186363281}] :answer-field/correct {:answer/id #uuid "a7ee24dc-48a5-5b9b-b841-7c77b2b4e76c" :answer/type {:db/ident :answer.type/math} :answer/value "3{\\int }_{3}^{5}{t}^{5}+{t}^{3}\\,dt" :db/id #edb/ref 17592186363279} :answer-field/id #uuid "dea43d7e-e263-5fa8-ad24-5e19124d3b13" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363276}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0ecd3a3a-cbc4-5984-b2b3-63464f6c03d0" :question/math-academy-id "q-124874" :question/problem "Which of the following is equivalent to ${\\int }_{C}xy\\,dx+y\\,dy+z\\,dz,$ where $C$ is a portion of the curve $r(t)=t\\,i+{t}^{2}\\,j+{t}^{3}\\,k$ for $t\\in [3,5]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)={t}^{2},\\,z(t)={t}^{3}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{3})\\,k \\\\  & =\\,i+2t\\,j+3{t}^{2}\\,j.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}xy\\,dx+y\\,dy+z\\,dz & ={\\int }_{3}^{5}xy\\frac{\\text{d}x}{\\text{d}t}\\,dt+y\\frac{\\text{d}y}{\\text{d}t}\\,dt+z\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{3}^{5}(xy\\frac{\\text{d}x}{\\text{d}t}+y\\frac{\\text{d}y}{\\text{d}t}+z\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{3}^{5}{t}^{3}\\cdot (1)+{t}^{2}\\cdot (2t)+{t}^{3}\\cdot (3{t}^{2})\\,dt \\\\  & ={\\int }_{3}^{5}3{t}^{5}+3{t}^{3}\\,dt \\\\  & =3{\\int }_{3}^{5}{t}^{5}+{t}^{3}\\,dt\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186363282 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b5ecc45-95ec-55c0-86bf-bbaeffef4049" :knowledge-point/title "Constructing a Sum of Line Integrals With Respect to X, Y, and Z"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c9f19e8a-e822-5f4e-baec-7b48e3d21c41" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{6}\\operatorname{ln}⁡t+5t\\,dt" :db/id #edb/ref 17592186363284} {:answer/id #uuid "2125d1c5-291b-5693-8723-e5479d57e6f1" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{6}5\\operatorname{ln}⁡t+4{t}^{4}\\,dt" :db/id #edb/ref 17592186363285} {:answer/id #uuid "b5e11bc3-87d3-5833-81d4-456426acdb34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{6}\\operatorname{ln}⁡t+2{t}^{5}-2{t}^{3}\\,dt" :db/id #edb/ref 17592186363286} {:answer/id #uuid "66eda466-7ed6-5afb-8e7c-ba897d54de1a" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{6}5{t}^{5}-3{t}^{3}\\,dt" :db/id #edb/ref 17592186363287} {:answer/id #uuid "518e472f-75c2-518b-9e0a-ff0e5ce670c8" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{6}{ln}^{2}⁡t-2{t}^{3}\\,dt" :db/id #edb/ref 17592186363288}] :answer-field/correct {:answer/id #uuid "b5e11bc3-87d3-5833-81d4-456426acdb34" :answer/type {:db/ident :answer.type/math} :answer/value "{\\int }_{2}^{6}\\operatorname{ln}⁡t+2{t}^{5}-2{t}^{3}\\,dt" :db/id #edb/ref 17592186363286} :answer-field/id #uuid "136e6e19-7c5b-5fe5-a994-00852cc9396e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186363283}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a503ae2b-c508-50f6-a415-a83a3a5ff562" :question/math-academy-id "q-124879" :question/problem "Which of the following is equivalent to ${\\int }_{C}\\operatorname{ln}⁡x\\,dx-z\\,dy+{y}^{2}\\,dz,$ where $C$ is a portion of the curve $r(t)=t\\,i+{t}^{2}\\,j+{t}^{2}\\,k$ for $t\\in [2,6]?$" :question/worked-solution "Along the curve, we have\n\n$$\nx(t)=t,\\,y(t)={t}^{2},\\,z(t)={t}^{2}.\n$$\n\nThe derivative of $r(t)$ is given by\n\n$$\n\\begin{aligned}{r}^{′}(t) & =\\frac{\\text{d}x}{\\text{d}t}\\,i+\\frac{\\text{d}y}{\\text{d}t}\\,j+\\frac{\\text{d}z}{\\text{d}t}\\,k \\\\  & =\\frac{\\text{d}}{\\text{d}t}(t)\\,i+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2})\\,k \\\\  & =\\,i+2t\\,j+2t\\,k.\\end{aligned}\n$$\n\nTherefore, we can write our line integral as follows:\n\n$$\n\\begin{aligned}{\\int }_{C}\\operatorname{ln}⁡x\\,dx-z\\,dy+{y}^{2}\\,dz & ={\\int }_{2}^{6}\\operatorname{ln}⁡x\\frac{\\text{d}x}{\\text{d}t}\\,dt-z\\frac{\\text{d}y}{\\text{d}t}\\,dt+{y}^{2}\\frac{\\text{d}z}{\\text{d}t}\\,dt \\\\  & ={\\int }_{2}^{6}(\\operatorname{ln}⁡x\\frac{\\text{d}x}{\\text{d}t}-z\\frac{\\text{d}y}{\\text{d}t}+{y}^{2}\\frac{\\text{d}z}{\\text{d}t})dt \\\\  & ={\\int }_{2}^{6}\\operatorname{ln}⁡t\\cdot (1)-{t}^{2}\\cdot (2t)+{t}^{4}\\cdot (2t)\\,dt \\\\  & ={\\int }_{2}^{6}\\operatorname{ln}⁡t+2{t}^{5}-2{t}^{3}\\,dt\\end{aligned}\n$$"}]}
