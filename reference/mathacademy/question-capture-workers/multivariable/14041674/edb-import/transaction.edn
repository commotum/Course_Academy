d "q-136366" :question/id #uuid "186d12d2-2e90-5668-aa61-33527d2a94e3" :question/math-academy-id "q-136366" :question/problem "A particle starts moving from the point with position vector $(2i-j)\\,\\text{mm}$ with a constant velocity of $(-i+j)\\,\\text{mm/s}.$ Find the position vector of the particle after $1$ second." :question/worked-solution "If a particle moves with constant velocity $u,$  the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\n \nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=2i-j,\\,u=-i+j.\n$$\n\nTherefore, the position vector of the particle after $t=1\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(2i-j)+(-i+j)(1) \\\\  & =(2i-j)+(-i+j) \\\\  & =i\\,\\text{mm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-136366/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-136366"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136383/selection/c7c25ec85da967dca051674ad3df7729b131c1dd2a56e353e00d544a3ba9dfc8" :answer/id #uuid "90d790f3-4e99-5972-904c-f20c98af4068" :answer/type :answer.type/math :answer/value "(-3i+5j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136383/selection/5ee31f792810425bbccded6de37a982ef5e3664318fde0f875762029a6641717" :answer/id #uuid "c7ce8430-ffb6-5792-add1-e984ffaaaa3f" :answer/type :answer.type/math :answer/value "-15i\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136383/selection/a402ce0d63589c45815da94f727baaed884fbff2389ee609d1fce52893c309ca" :answer/id #uuid "bf8576ec-b0cc-51c2-a761-cb3a2e4d60bc" :answer/type :answer.type/math :answer/value "(5i+2j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136383/selection/05a71cb3f683a12445d43acd16e62d183b2754dbb2aedecaae1037c3e1484c70" :answer/id #uuid "d53a3f97-b580-564c-bad8-169a2c9b7bf2" :