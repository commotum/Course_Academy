ledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-136383"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275478/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "8b78e483-7de7-545e-b237-cc7971bed3dc" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-275478/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "96d6527f-31d8-5b61-be6e-4a5191c803e3" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-275478/field-1" :answer-field/id #uuid "fb07faaa-cf0f-5a91-8364-f12408cd1423" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275478/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer-field/choices ["q-275478/field-1/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" "q-275478/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-275478/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "643aefcc-75b2-59f9-babf-7dffd98d9e86" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-275478/field-2" :answer-field/id #uuid "d3e72549-5094-55f7-b9ab-4a38cc24eeb8" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275478/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-275478/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-275478" :question/id #uuid "b543fba2-fe8d-511a-bebc-d81567c388dd" :question/math-academy-id "q-275478" :question/problem "A particle moves from the origin with a constant velocity of $(3i-2j)\\,\\text{cm/s}.$ Determine the position vector of the particle$(r)$ after $4$ seconds.\n\n$r=(${{field-1}}\n$i\\,\\,-$\n{{field-2}}\n$j)\\text{cm}$" :question/worked-solution "If a particle moves with constant velocity $u,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=3i-2j.\n$$\n\nTherefore, the position vector of the particle after $t=4\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(0i+0j)+(3i-2j)(4) \\\\  & =(\\,12\\,i-8\\,j)\\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275478/field-1" "q-275478/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-275478"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280268/field-1/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer/id #uuid "ffe76b83-9c7b-5739-8645-3ca298cdbe5f" :answer/type :answer.type/math :answer/value "30" :db/ensure [:answer/validate]} {:db/id "q-280268/field-1" :answer-field/id #uuid "0942a011-1629-5b73-ba37-4a0fe59c372b" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280268/field-1/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8" :answer-field/choices ["q-280268/field-1/a4c8bdda186d0d425e9963bf17967cd5e356d934f319fa58135b8f8cf8a589f8"] :db/ensure [:answer-field/validate]} {:db/id "q-280268/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "29d4a741-30e5-529e-91e3-b22770b107dc" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-280268/field-2" :answer-field/id #uuid "8518a2b1-c503-5b3a-b28f-1bbb208ede30" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280268/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-280268/field-2/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-280268" :question/id #uuid "a7d9c578-ab84-56ec-97b9-8ac1c1fcffad" :question/math-academy-id "q-280268" :question/problem "A skier glides down a smooth slope starting from the origin with a constant velocity of $(6i-1j)\\,\\text{m/s}.$ Determine the skier's position vector$(r)$ after $5$ seconds.\n\n$r=(${{field-1}}  \n$i\\,\\,-$  \n{{field-2}}  \n$j)\\text{m}$" :question/worked-solution "When a particle (or object) moves with constant velocity $u,$ the position vector at time $t$ is given by the equation\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position vector.\n\nIn this case, the skier starts at the origin, so\n\n$$\n{r}_{0}=0i+0j,\\,u=6i-1j.\n$$\n\nTherefore, the position vector of the skier after $t=5\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(0i+0j)+(6i-1j)(5) \\\\  & =(\\,30\\,i-5\\,j)\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-280268/field-1" "q-280268/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-280268"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136374/selection/400a53a0caefee97f2a8512a485f7569ac9277492cfaf707447148a54cc8ad80" :answer/id #uuid "e9c3b218-ab56-5e80-95f2-c8b940229e96" :answer/type :answer.type/math :answer/value "-4j\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136374/selection/c21651b4fc367f0b8555ddfcf612573f85c6688ac162225db4fac2568bb56ff2" :answer/id #uuid "71045546-a43c-5454-bd44-0c69216af31e" :answer/type :answer.type/math :answer/value "(2i-j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136374/selection/677f73cf2f17ac4e5d19a4c11ddeedb593b1a7caef7874c25adab2da5645b565" :answer/id #uuid "5c3dfff0-1e95-57b8-91d8-63a470af9c15" :answer/type :answer.type/math :answer/value "(6i+6j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136374/selection/aa98a371e233efe6ade84a91f8c8545b690df9cdd29f9bcf4af43f7879fe5644" :answer/id #uuid "7148ed7f-513f-5250-aae4-2b245ccc568a" :answer/type :answer.type/math :answer/value "(9i-5j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136374/selection/329f36f93b2c7250ad97e1a0beb3f4204300d64d9b2a642464917e9c7890ceab" :answer/id #uuid "87a34b56-3954-5982-a00c-ded6f7dbe9b1" :answer/type :answer.type/math :answer/value "(8i+11j)\\,\\text{in}" :db/ensure [:answer/validate]} {:db/id "q-136374/selection" :answer-field/id #uuid "77a9b85a-8473-528f-a0ce-997db8511fbb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136374/selection/c21651b4fc367f0b8555ddfcf612573f85c6688ac162225db4fac2568bb56ff2" :answer-field/choices ["q-136374/selection/400a53a0caefee97f2a8512a485f7569ac9277492cfaf707447148a54cc8ad80" "q-136374/selection/c21651b4fc367f0b8555ddfcf612573f85c6688ac162225db4fac2568bb56ff2" "q-136374/selection/677f73cf2f17ac4e5d19a4c11ddeedb593b1a7caef7874c25adab2da5645b565" "q-136374/selection/aa98a371e233efe6ade84a91f8c8545b690df9cdd29f9bcf4af43f7879fe5644" "q-136374/selection/329f36f93b2c7250ad97e1a0beb3f4204300d64d9b2a642464917e9c7890ceab"] :db/ensure [:answer-field/validate]} {:db/id "q-136374" :question/id #uuid "126b5ac1-4e18-57c8-9621-e06a35dd984c" :question/math-academy-id "q-136374" :question/problem "A particle starts moving from the point with position vector $(2i+3j)\\,\\text{in}$ with a constant velocity of $-j\\,\\text{in/s}.$ Find the position vector of the particle after $4$ seconds." :question/worked-solution "If a particle moves with constant velocity $u,$  the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\n \nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=2i+3j,\\,u=-j.\n$$\n\nTherefore, the position vector of the particle after $t=4\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(2i+3j)+(-j)(4) \\\\  & =(2i+3j)-4j \\\\  & =(2i-j)\\,\\text{in}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-136374/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a54dcd1d-56f5-527d-9f24-ff4b7d221d06"] :knowledge-point/questions ["q-136374"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136427/selection/abbd999d36f4536671a9146423be63bb102a6d6e5a261eecb612f4c845e1cca1" :answer/id #uuid "e9aa3492-3040-5aa3-b912-0a1ac661e980" :answer/type :answer.type/math :answer/value "(27i-15j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136427/selection/95042938d7fe6f3947cf6fe6916c3a3881acd30c8c427c7b4310f3cf218bf9f0" :answer/id #uuid "c5c42bff-d055-5577-a9bc-1ca03b21a21d" :answer/type :answer.type/math :answer/value "(-6i-18j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136427/selection/0923198462b6d4062f2f875cc80f60b4b7858c44d5bf5f0acbb47f9e1f3326ad" :answer/id #uuid "cd62f4b5-b39d-5fbe-9492-83327b1f89a0" :answer/type :answer.type/math :answer/value "(7i+10j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136427/selection/de03bd773a0214c611342abbcae2a196b45b12f5933283b3cb27cf838f3952ea" :answer/id #uuid "5bf1ed69-c738-548b-b6ae-227baf689d57" :answer/type :answer.type/math :answer/value "(9i+5j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136427/selection/06d80f1a5030160e03deed571111848af1fddb94e88e4ecb4b6e833dbc01738d" :answer/id #uuid "bc99b14b-8ca3-5afc-9e10-5e14d2c20d53" :answer/type :answer.type/math :answer/value "(-5i-14j)\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136427/selection" :answer-field/id #uuid "7b027617-b94e-5e88-8c81-e79b75dde9fc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136427/selection/abbd999d36f4536671a9146423be63bb102a6d6e5a261eecb612f4c845e1cca1" :answer-field/choices ["q-136427/selection/abbd999d36f4536671a9146423be63bb102a6d6e5a261eecb612f4c845e1cca1" "q-136427/selection/95042938d7fe6f3947cf6fe6916c3a3881acd30c8c427c7b4310f3cf218bf9f0" "q-136427/selection/0923198462b6d4062f2f875cc80f60b4b7858c44d5bf5f0acbb47f9e1f3326ad" "q-136427/selection/de03bd773a0214c611342abbcae2a196b45b12f5933283b3cb27cf838f3952ea" "q-136427/selection/06d80f1a5030160e03deed571111848af1fddb94e88e4ecb4b6e833dbc01738d"] :db/ensure [:answer-field/validate]} {:db/id "q-136427" :question/id #uuid "6e64ebbb-b149-5c92-a228-0b1efc17991c" :question/math-academy-id "q-136427" :question/problem "A particle moves from the origin with an acceleration of $6i\\,{\\text{km/h}}^{2}$ and an initial velocity of $-5j\\,\\text{km/h}.$ Find the position vector of the particle after $3$ hours." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=-5j,\\,a=6i.\n$$\n\nTherefore, the position vector of the particle after $t=3\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(-5j)(3)+\\frac{1}{2}(6i)(3)^{2} \\\\  & =-15j+27i \\\\  & =(27i-15j)\\,\\text{km}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136427/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-136427"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136423/selection/911fd068016ddf7899391cab682f9993685d6a1ea82cdc8410d39153b423f9e6" :answer/id #uuid "d8bb4a69-774d-5711-829f-34f748b52960" :answer/type :answer.type/math :answer/value "(-3i-30j)\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-136423/selection/88f3faee1e02eacf22e2299be5eb0d2e3bf122bb5868115e4c846198965874e0" :answer/id #uuid "2a82a880-f58e-5110-8a47-83dcb97583fa" :answer/type :answer.type/math :answer/value "(-9i-15j)\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-136423/selection/e60e8b3401a076124e5559f794b8fd5a49d1885dbbfcb0d946bc57c9a061c87a" :answer/id #uuid "aeb37fd7-07a8-5b67-af49-7eccf6109cae" :answer/type :answer.type/math :answer/value "(i+30j)\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-136423/selection/dbeea283bd9b3246406b8195ed7dbac37a18f0ff58f927fce67b4636c6c5c977" :answer/id #uuid "d41b352e-a901-5308-8543-e8727ef65060" :answer/type :answer.type/math :answer/value "(i-10j)\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-136423/selection/12bf01f1c8cb8e512c5b42b13f69003815c8d99efbc16fb74acbfe4491e1f1c4" :answer/id #uuid "633d7d65-d6ac-595c-9b6d-d0e90423674d" :answer/type :answer.type/math :answer/value "(-3i+5j)\\,\\text{m}" :db/ensure [:answer/validate]} {:db/id "q-136423/selection" :answer-field/id #uuid "a88feb05-32eb-517c-89e5-e6e869abbdd2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136423/selection/911fd068016ddf7899391cab682f9993685d6a1ea82cdc8410d39153b423f9e6" :answer-field/choices ["q-136423/selection/911fd068016ddf7899391cab682f9993685d6a1ea82cdc8410d39153b423f9e6" "q-136423/selection/88f3faee1e02eacf22e2299be5eb0d2e3bf122bb5868115e4c846198965874e0" "q-136423/selection/e60e8b3401a076124e5559f794b8fd5a49d1885dbbfcb0d946bc57c9a061c87a" "q-136423/selection/dbeea283bd9b3246406b8195ed7dbac37a18f0ff58f927fce67b4636c6c5c977" "q-136423/selection/12bf01f1c8cb8e512c5b42b13f69003815c8d99efbc16fb74acbfe4491e1f1c4"] :db/ensure [:answer-field/validate]} {:db/id "q-136423" :question/id #uuid "447576b1-f4dd-5955-9578-449eb78ad034" :question/math-academy-id "q-136423" :question/problem "A particle moves in a uniform gravitational field from the origin with an acceleration of $-10j\\,{\\text{m/s}}^{2}$ and an initial velocity of $(-i+5j)\\,\\text{m/s}.$ Find the position vector of the particle after $3$ seconds." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=-i+5j,\\,a=-10j.\n$$\n\nTherefore, the position vector of the particle after $t=3\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(-i+5j)(3)+\\frac{1}{2}(-10j)(3)^{2} \\\\  & =(-3i+15j)+9(-5j) \\\\  & =(-3i+15j)-45j \\\\  & =(-3i-30j)\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136423/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-136423"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280515/field-1/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "80be0219-834e-56fc-a8eb-bf2311a6e204" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-280515/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "eaa3662c-d120-5324-bca4-f373db03ff65" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-280515/field-1" :answer-field/id #uuid "e7281faf-0adb-5606-bf19-8abe70b581c9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280515/field-1/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer-field/choices ["q-280515/field-1/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" "q-280515/field-1/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-280515/field-2/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer/id #uuid "c5520887-5739-5ff9-b622-0fc71b1902f8" :answer/type :answer.type/math :answer/value "\\frac{7}{2}" :db/ensure [:answer/validate]} {:db/id "q-280515/field-2" :answer-field/id #uuid "cb23decd-599e-567a-b9d1-b87335369f1a" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280515/field-2/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf" :answer-field/choices ["q-280515/field-2/04ab8c59d12921ca2d995f79fd8be713086563c65c468afaa0d4bd8ea5bfffaf"] :db/ensure [:answer-field/validate]} {:db/id "q-280515" :question/id #uuid "800eb994-8a3d-5bca-85e6-13c645924122" :question/math-academy-id "q-280515" :question/problem "A parcel robot begins at the position ${r}_{0}=(3i+2j)\\,\\text{cm}$ with an initial velocity of $(i-j)\\,\\text{cm/s}$ and a constant acceleration of $(2i+j)\\,{\\text{cm/s}}^{2}.$ Determine the position vector after $3$ seconds.\n\n$r=(${{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j)\\text{cm}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=3i+2j,\\,u=i-j,\\,a=2i+j.\n$$\n\nTherefore, the position vector of the parcel robot after $t=3\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(3i+2j)+(i-j)(3)+\\frac{1}{2}(2i+j)(3)^{2} \\\\  & =(3i+2j)+(i-j)(3)+\\frac{1}{2}(18i+9j) \\\\  & =(3i+2j)+(3i-3j)+(9i+4.5j) \\\\  & =(\\,15\\,i+3.5\\,j)\\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280515/field-1" "q-280515/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-280515"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280537/field-1/8bffcbd4b3f2abb4728ffbfe78f560e6bf79afec32f4896add7b7714de08c792" :answer/id #uuid "0c7c6d77-d298-5d2d-9edc-04f1be2b263c" :answer/type :answer.type/math :answer/value "\\sqrt{61}" :db/ensure [:answer/validate]} {:db/id "q-280537/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce" :answer/id #uuid "17e57a88-9de7-581a-bfa2-fe8565c21cc4" :answer/type :answer.type/math :answer/value "11" :db/ensure [:answer/validate]} {:db/id "q-280537/field-1" :answer-field/id #uuid "062476d8-3544-5a77-97c8-52a9ab626fd6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280537/field-1/8bffcbd4b3f2abb4728ffbfe78f560e6bf79afec32f4896add7b7714de08c792" :answer-field/choices ["q-280537/field-1/8bffcbd4b3f2abb4728ffbfe78f560e6bf79afec32f4896add7b7714de08c792" "q-280537/field-1/478cbf1ea235fbfb5b60a0837fffa0a678f83a3bcb8f958a024b0760ea2175ce"] :db/ensure [:answer-field/validate]} {:db/id "q-280537" :question/id #uuid "898c8dfc-9e20-53d9-8140-6db68ccf63e0" :question/math-academy-id "q-280537" :question/problem "A helicopter starts from the position $(5i+2j)\\,\\text{m}$ with an initial velocity of $(-i+3j)\\,\\text{m/s}$ and an acceleration of $(i-j)\\,{\\text{m/s}}^{2}.$ Find the distance from the helicopter to the origin $(|r|)$ after $2$ seconds.\n\n$\\,|r|=$\n{{field-1}}\n$\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=5i+2j,\\,u=-i+3j,\\,a=i-j.\n$$\n\nTherefore, the position vector of the helicopter after $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(5i+2j)+(-i+3j)(2)+\\frac{1}{2}(i-j)(2)^{2} \\\\  & =(5i+2j)+(-2i+6j)+2(i-j) \\\\  & =(5i+2j)+(-2i+6j)+(2i-2j) \\\\  & =(5i+6j)\\,\\text{m}.\\end{aligned}\n$$\n\nFinally, the distance from the helicopter to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|5i+6j| \\\\  & =\\sqrt{{5}^{2}+{6}^{2}} \\\\  & =\\sqrt{25+36} \\\\  & =\\sqrt{61} \\\\  & =\\sqrt{61}\\,\\text{m}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-280537/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-280537"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280523/field-1/5371f7c0b0dcb7971e259333187268b3f161f844a21da0bac5a59ac2c4f7743f" :answer/id #uuid "8fecbee0-2afd-58ac-9fad-158504fd7cef" :answer/type :answer.type/math :answer/value "\\sqrt{34}" :db/ensure [:answer/validate]} {:db/id "q-280523/field-1" :answer-field/id #uuid "720c3e3c-f324-5593-957f-656896297048" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280523/field-1/5371f7c0b0dcb7971e259333187268b3f161f844a21da0bac5a59ac2c4f7743f" :answer-field/choices ["q-280523/field-1/5371f7c0b0dcb7971e259333187268b3f161f844a21da0bac5a59ac2c4f7743f"] :db/ensure [:answer-field/validate]} {:db/id "q-280523" :question/id #uuid "79c43728-f80b-5944-96f5-175b3840a615" :question/math-academy-id "q-280523" :question/problem "A weather balloon drifts from the point with position vector $(6i-j)\\,\\text{mi}$ and moves with a constant velocity of $(-3i+2j)\\,\\text{mi/h}.$ Determine the distance $(|r|)$ from the balloon to the origin after $3$ hours.\n\n$\\,|r|=$\n{{field-1}}\n$\\text{mi}$" :question/worked-solution "If a particle moves with constant velocity $u,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=6i-j,\\,u=-3i+2j.\n$$\n\nTherefore, the position vector of the balloon after $t=3\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(6i-j)+(-3i+2j)(3) \\\\  & =(6i-j)+(-9i+6j) \\\\  & =(-3i+5j)\\,\\text{mi}.\\end{aligned}\n$$\n\nFinally, the distance from the balloon to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|-3i+5j| \\\\  & =\\sqrt{(-3)^{2}+{5}^{2}} \\\\  & =\\sqrt{9+25} \\\\  & =\\sqrt{34} \\\\  & =\\sqrt{34}\\,\\text{mi}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280523/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-280523"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136438/selection/363e62841fc967694878efa9cadf607b3887e22342333ea66257abdb70fa05bc" :answer/id #uuid "9a7c8719-fe39-5280-91b7-e268627c59cf" :answer/type :answer.type/math :answer/value "13\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136438/selection/a81942bd11dbb4afaae791872ab9ba2861ada5bd8f5ba26a4f1d98bd2e89c421" :answer/id #uuid "ddb8f548-0792-5834-ac49-c57bdcab4278" :answer/type :answer.type/math :answer/value "6\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136438/selection/a83844bb639134295b92cc97738b62c5c174d0d9f949fed5acf7871cbdbcecd1" :answer/id #uuid "c241cc0e-79ca-57e4-90bc-b186f86f2798" :answer/type :answer.type/math :answer/value "7\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136438/selection/b3e0fa4d69544fadc865e01ac9b6630560be3fe67893261163dd482fc24a313e" :answer/id #uuid "b99aafaa-c0f1-5db3-abba-99ad07ab71d8" :answer/type :answer.type/math :answer/value "\\sqrt{13}\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136438/selection/c3640caf98d17b600fd8b7a84f5075e5c8e158834bbb08c7c1d96a65a4176020" :answer/id #uuid "51ee5125-4155-5571-94da-e66449bb20bd" :answer/type :answer.type/math :answer/value "\\sqrt{85}\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136438/selection" :answer-field/id #uuid "b1ea705b-cade-53e6-b127-c196647a4243" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136438/selection/c3640caf98d17b600fd8b7a84f5075e5c8e158834bbb08c7c1d96a65a4176020" :answer-field/choices ["q-136438/selection/363e62841fc967694878efa9cadf607b3887e22342333ea66257abdb70fa05bc" "q-136438/selection/a81942bd11dbb4afaae791872ab9ba2861ada5bd8f5ba26a4f1d98bd2e89c421" "q-136438/selection/a83844bb639134295b92cc97738b62c5c174d0d9f949fed5acf7871cbdbcecd1" "q-136438/selection/b3e0fa4d69544fadc865e01ac9b6630560be3fe67893261163dd482fc24a313e" "q-136438/selection/c3640caf98d17b600fd8b7a84f5075e5c8e158834bbb08c7c1d96a65a4176020"] :db/ensure [:answer-field/validate]} {:db/id "q-136438" :question/id #uuid "803dd0b0-053a-50ba-b961-b37668936fe0" :question/math-academy-id "q-136438" :question/problem "A particle starts moving from the point with position vector $(-i+2j)\\,\\text{km},$ with an acceleration of $(i-j)\\,{\\text{km/h}}^{2}$ and an initial velocity of $3j\\,\\text{km/h}.$ Find the distance from the particle to the origin after $4$ hours." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=-i+2j,\\,u=3j,\\,a=i-j.\n$$\n\nTherefore, the position vector of the particle after $t=4\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & =(-i+2j)+(3j)(4)+\\frac{1}{2}(i-j)(4)^{2} \\\\  & =(-i+2j)+(12j)+8(i-j) \\\\  & =(-i+14j)+(8i-8j) \\\\  & =(7i+6j)\\,\\text{km}.\\end{aligned}\n$$\n\nFinally, the distance from the particle to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|7i+6j| \\\\  & =\\sqrt{{7}^{2}+{6}^{2}} \\\\  & =\\sqrt{49+36} \\\\  & =\\sqrt{85}\\,\\text{km}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-136438/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-136438"] :db/ensure [:knowledge-point/validate]} {:db/id "q-136435/selection/4018853ab99f68cce6ace25dcdb9ba6762c95fcd07f8640dff03327e4d4b795e" :answer/id #uuid "2d49f10b-3e3f-5925-bfb0-b44e53c71fbc" :answer/type :answer.type/math :answer/value "5\\sqrt{5}\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136435/selection/181cc009a40e588e43150ef157cb9ea4cdc878320cd3c1278805b0161139ac21" :answer/id #uuid "da2547ca-c71e-56f2-ab42-372158200671" :answer/type :answer.type/math :answer/value "25\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136435/selection/15a415bb5e41e9afd04e045041879265974fb9bec490ddf11c8d9b7f2b61b0ac" :answer/id #uuid "2c3f2375-2d91-5370-bd9c-1418f684de99" :answer/type :answer.type/math :answer/value "\\sqrt{5}\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136435/selection/1cf982ec022806b9569de2031ed5fe0f8d9de5537d4841a186adb35b64bd9aa7" :answer/id #uuid "37f13cf5-9160-5e1c-930e-1895b9b94932" :answer/type :answer.type/math :answer/value "\\sqrt{15}\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136435/selection/08c0b0196bd8f48895210cb139e50933762a0fccfd3fb1ad9e66ff347146a4d0" :answer/id #uuid "e85ca916-3997-5874-826f-8bf3501c3bb3" :answer/type :answer.type/math :answer/value "\\sqrt{10}\\,\\text{km}" :db/ensure [:answer/validate]} {:db/id "q-136435/selection" :answer-field/id #uuid "9b51b5cc-2d65-575e-baf4-68ef902f5a87" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136435/selection/4018853ab99f68cce6ace25dcdb9ba6762c95fcd07f8640dff03327e4d4b795e" :answer-field/choices ["q-136435/selection/4018853ab99f68cce6ace25dcdb9ba6762c95fcd07f8640dff03327e4d4b795e" "q-136435/selection/181cc009a40e588e43150ef157cb9ea4cdc878320cd3c1278805b0161139ac21" "q-136435/selection/15a415bb5e41e9afd04e045041879265974fb9bec490ddf11c8d9b7f2b61b0ac" "q-136435/selection/1cf982ec022806b9569de2031ed5fe0f8d9de5537d4841a186adb35b64bd9aa7" "q-136435/selection/08c0b0196bd8f48895210cb139e50933762a0fccfd3fb1ad9e66ff347146a4d0"] :db/ensure [:answer-field/validate]} {:db/id "q-136435" :question/id #uuid "66632282-ea06-507b-8329-70e0f5e79853" :question/math-academy-id "q-136435" :question/problem "A particle moves from the origin with a constant velocity of $(i-2j)\\,\\text{km/h}.$ Find the distance from the particle to the origin after $5$ hours." :question/worked-solution "If a particle moves with constant velocity $u,$  the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=i-2j.\n$$\n\nTherefore, the position vector of the particle after $t=5\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(0i+0j)+(i-2j)(5) \\\\  & =(5i-10j)\\,\\text{km}.\\end{aligned}\n$$\n\nFinally, the distance from the particle to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|5i-10j| \\\\  & =\\sqrt{{5}^{2}+(-10)^{2}} \\\\  & =\\sqrt{25+100} \\\\  & =\\sqrt{125} \\\\  & =5\\sqrt{5}\\,\\text{km}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136435/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-136435"] :db/ensure [:knowledge-point/validate]} {:db/id "q-280528/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "f990279b-d4f2-5303-900c-8ee6d93432df" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-280528/field-1" :answer-field/id #uuid "7633c9f3-0ab1-52bd-b43a-944dfa15e249" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-280528/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer-field/choices ["q-280528/field-1/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc"] :db/ensure [:answer-field/validate]} {:db/id "q-280528" :question/id #uuid "d4b26847-5f09-546b-bd05-0cd5caf581b4" :question/math-academy-id "q-280528" :question/problem "A falcon flies from the origin with a constant velocity of $(-6i+8j)\\,\\text{mi/h}.$ Determine the distance $(|r|)$ from the falcon to the origin after $1$ hour.\n\n$\\,|r|=$\n{{field-1}}\n$\\text{mi}$" :question/worked-solution "If a particle moves with constant velocity $u,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut,\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=-6i+8j.\n$$\n\nTherefore, the position vector of the falcon after $t=1\\,\\text{h}$ is\n\n$$\n\\begin{aligned}r & ={r}_{0}+ut \\\\  & =(0i+0j)+(-6i+8j)(1) \\\\  & =(-6i+8j)\\,\\text{mi}.\\end{aligned}\n$$\n\nFinally, the distance from the falcon to the origin at this time is\n\n$$\n\\begin{aligned}|r| & =|-6i+8j| \\\\  & =\\sqrt{(-6)^{2}+{8}^{2}} \\\\  & =\\sqrt{36+64} \\\\  & =\\sqrt{100} \\\\  & =10\\,\\text{mi}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-280528/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3048320d-7346-53fd-819b-d6e32e4fc02c"] :knowledge-point/questions ["q-280528"] :db/ensure [:knowledge-point/validate]}]
