\\operatorname{cos}⁡z,z{y}^{2}-xz\\operatorname{cos}⁡z⟩ \\\\  & =⟨-x{y}^{2},-xyz\\operatorname{sin}⁡z+xy\\operatorname{cos}⁡z,z{y}^{2}-xz\\operatorname{cos}⁡z⟩ \\\\  & =⟨-x{y}^{2},-xy(z\\operatorname{sin}⁡z-\\operatorname{cos}⁡z),z({y}^{2}-x\\operatorname{cos}⁡z)⟩.\\end{aligned}\n$$\n\nFinally,\n\n$$\n\\begin{aligned}∇\\times (f\\,F)(1,1,0) & =⟨-1,-(0\\operatorname{sin}⁡0-\\operatorname{cos}⁡0),0⟩ \\\\  & =⟨-1,1,0⟩.\\end{aligned}\n$$" 13194139535986 true] [17592186378334 1000 #edb/ref 17592186378335 13194139535986 true] [17592186378334 1000 #edb/ref 17592186378336 13194139535986 true] [17592186378334 1000 #edb/ref 17592186378337 13194139535986 true] [17592186378334 1000 #edb/ref 17592186378338 13194139535986 true] [17592186378334 1000 #edb/ref 17592186378339 13194139535986 true] [17592186378334 1040 #edb/ref 17592186045450 13194139535986 true] [17592186378334 1041 "selection" 13194139535986 true] [17592186378334 1104 #edb/ref 17592186378338 13194139535986 true] [17592186378334 1110 #uuid "9c4e64be-4dca-54cc-8b48-c32c25eeacab" 13194139535986 true] [17592186378335 1034 "⟨-2,-2,0⟩" 13194139535986 true] [17592186378335 1103 #edb/ref 17592186045453 13194139535986 true] [17592186378335 1111 #uuid "0c036cb5-5d41-57cf-8a56-454bb9f35983" 13194139535986 true] [17592186378336 1034 "⟨2,-1,2⟩" 13194139535986 true] [17592186378336 1103 #edb/ref 17592186045453 13194139535986 true] [17592186378336 1111 #uuid "1f51a641-718d-5401-9491-34d2244c4bf6" 13194139535986 true] [17592186378337 1034 "⟨0,1,2⟩" 13194139535986 true] [17592186378337 1103 #edb/ref 17592186045453 13194139535986 true] [17592186378337 1111 #uuid "49b4e40f-b00b-5817-938a-be697a9f9f34" 13194139535986 true] [17592186378338 1034 "⟨-1,1,0⟩" 13194139535986 true] [17592186378338 1103 #edb/ref 17592186045453 13194139535986 true] [17592186378338 1111 #uuid "8d996f81-30fe-5e69-8245-11f5e55f2d0e" 13194139535986 true] [17592186378339 1034 "⟨-1,2,1⟩" 13194139535986 true] [17592186378339 1103 #edb/ref 17592186045453 13194139535986 