}{4}))-(\\operatorname{sin}⁡(0)-\\operatorname{cos}⁡(0)) \\\\  & =(\\frac{\\sqrt{2}}{2}-\\frac{\\sqrt{2}}{2})-(0-1) \\\\  & =1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-73361/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5"] :knowledge-point/questions ["q-73361"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114306/selection/8799e02886d0a392717cf567e84a29c882cb3e2ecf8acdc4fcf1c78ab4d29f97" :answer/id #uuid "39cc65ca-fb96-563f-811a-c0e00f5e0a7a" :answer/type :answer.type/math :answer/value "3(\\sqrt{2}-1)" :db/ensure [:answer/validate]} {:db/id "q-114306/selection/9c852864a92ae8391966dc2299d16c8994e5df53e1e93588509e563826c67f36" :answer/id #uuid "86cf893e-69da-553f-a4e9-4fb26df5615c" :answer/type :answer.type/math :answer/value "\\sqrt{2}-3" :db/ensure [:answer/validate]} {:db/id "q-114306/selection/7d00f9b66830b14fefc14bf7531dbbd2d05f295ddd76a38bfd102c324772b0e1" :answer/id #uuid "d098fb97-95f7-5f86-a8aa-a83703db2038" :answer/type :answer.type/math :answer/value "\\sqrt{2}+1" :db/ensure [:answer/validate]} {:db/id "q-114306/selection/3852486362d7ef154eb5b7b615d411dbab7c589516ccc8ed9a022377ac00f6ca" :answer/id #uuid "ebe05d70-e334-50fa-82ab-657e120476de" :answer/type :answer.type/math :answer/value "3(\\sqrt{2}-2)" :db/ensure [:answer/validate]} {:db/id "q-114306/selection/dcc3c053280d9fafdd8647272b73a3cba34fe88199bd81cafb2dd1cbb7895084" :answer/id #uuid "187fd51c-418f-5182-a575-d02a9b2d1076" :answer/type :answer.type/math :answer/value "3(\\sqrt{2}+1)" :db/ensure [:answer/validate]} {:db/id "q-114306/selection" :answer-field/id #uuid "6954e32c-c94f-5b26-902c-8cb55225375f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114306/selection/8799e02886d0a392717cf567e84a29c882cb3e2ecf8acdc4fcf1c78ab4d29f97" :answer-field/choices ["q-114306/selection/8799e02886d0a392717cf567e84a29c882cb3e2ecf8acdc4fcf1c78ab4d29f97" "q-114306/selection/9c852864a92ae8391966dc2299d16c8994e5df53e1e93588509e563826c67f36" "q-114306/selection/7d00f9b66830b14fefc14bf7531dbbd2d05f295ddd76a38bfd102c324772b0e1" "q-114306/selection/3852486362d7ef154eb5b7b615d411dbab7c589516ccc8ed9a022377ac00f6ca" "q-114306/selection/dcc3c053280d9fafdd8647272b73a3cba34fe88199bd81cafb2dd1cbb7895084"] :db/ensure [:answer-field/validate]} {:db/id "q-114306" :question/id #uuid "90fb5794-ccc5-5bbb-84a7-0497aefc34e6" :question/math-academy-id "q-114306" :question/problem "${\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x=3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x\n$$\n\nThen, we use the fact that $\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}=\\operatorname{tan}⁡x,$ as follows:\n\n$$\n\\begin{aligned}3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /4}\\frac{3\\operatorname{sec}⁡x\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\,\\text{d}x & =3{\\int }_{0}^{\\pi /4}\\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & =3\\operatorname{sec}⁡x\\,{|}_{0}^{\\pi /4} \\\\  & =3[\\operatorname{sec}⁡(\\frac{\\pi }{4})-\\operatorname{sec}⁡0] \\\\  & =3(\\sqrt{2}-1)\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114306/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5"] :knowledge-point/questions ["q-114306"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49259"] :question/problem "$\\int \\operatorname{cot}⁡x\\,\\text{d}x=$" :question/worked-solution "We use the identity $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}$ and rewrite the integral as\n\n$$\n\\int \\operatorname{cot}⁡x\\,\\text{d}x=\\int \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{sin}⁡x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{cos}⁡x\\,⟹\\,\\text{d}u=\\operatorname{cos}⁡x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x & =\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|+C \\\\  & =\\operatorname{ln}⁡|\\operatorname{sin}⁡x|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-49278/selection/96725069d5316a6e95fb6acdefab31c3327a4ad48b824baf00c1c22a2244cfb5" :answer/id #uuid "02011bf2-46cb-516c-8c78-6db3fd69d5e6" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡|\\operatorname{cos}⁡3x|+C" :db/ensure [:answer/validate]} {:db/id "q-49278/selection/8a91916c290e558a0bb6fca23d6d5c59c496556377f7305a5964fee1e130d2dd" :answer/id #uuid "1ba0753d-3ab7-5a40-bc0b-f5f07a498521" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{cos}⁡3x|+C" :db/ensure [:answer/validate]} {:db/id "q-49278/selection/c5758851a7da9fd611538c7eea367bb229d5d81982e12239ac514972079c06a1" :answer/id #uuid "65fc1d7d-598c-57e5-b3c7-bcef672dfd7a" :answer/type :answer.type/math :answer/value "3\\operatorname{ln}⁡|\\operatorname{sin}⁡3x|+C" :db/ensure [:answer/validate]} {:db/id "q-49278/selection/665bacbaa4bf532f0697b5ccb12c7b446a4992ce652fe202e67350740dd87f6c" :answer/id #uuid "4ed4b054-3977-51b1-a7f4-c1aeefeb871e" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{csc}⁡3x|+C" :db/ensure [:answer/validate]} {:db/id "q-49278/selection/6b933f16069105bd0f69446fc20b4e6800cf9db163d21a1c1b178ccc41a6f090" :answer/id #uuid "4cf5336e-f675-5794-b628-7e93fc0b9143" :answer/type :answer.type/math :answer/value "\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{sec}⁡3x|+C" :db/ensure [:answer/validate]} {:db/id "q-49278/selection" :answer-field/id #uuid "01b62ac7-9351-542b-a6b3-7727956f560b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49278/selection/6b933f16069105bd0f69446fc20b4e6800cf9db163d21a1c1b178ccc41a6f090" :answer-field/choices ["q-49278/selection/96725069d5316a6e95fb6acdefab31c3327a4ad48b824baf00c1c22a2244cfb5" "q-49278/selection/8a91916c290e558a0bb6fca23d6d5c59c496556377f7305a5964fee1e130d2dd" "q-49278/selection/c5758851a7da9fd611538c7eea367bb229d5d81982e12239ac514972079c06a1" "q-49278/selection/665bacbaa4bf532f0697b5ccb12c7b446a4992ce652fe202e67350740dd87f6c" "q-49278/selection/6b933f16069105bd0f69446fc20b4e6800cf9db163d21a1c1b178ccc41a6f090"] :db/ensure [:answer-field/validate]} {:db/id "q-49278" :question/id #uuid "1a20189d-02fe-55f5-871e-83e3f87395e1" :question/math-academy-id "q-49278" :question/problem "$\\int \\operatorname{sin}⁡3x\\operatorname{sec}⁡3x\\,\\text{d}x=$" :question/worked-solution "We use the identity $\\operatorname{sec}⁡3x=\\frac{1}{\\operatorname{cos}⁡3x}$ and rewrite the integral as\n\n$$\n\\int \\operatorname{sin}⁡3x\\operatorname{sec}⁡3x\\,\\text{d}x=\\int \\frac{1}{\\operatorname{cos}⁡3x}\\cdot \\operatorname{sin}⁡3x\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{cos}⁡3x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-3\\operatorname{sin}⁡3x\\,⟹\\,-\\frac{1}{3}\\text{d}u=\\operatorname{sin}⁡3x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{1}{\\operatorname{cos}⁡3x}\\cdot \\operatorname{sin}⁡3x\\,\\text{d}x & =-\\frac{1}{3}\\int \\frac{1}{u}\\,\\text{d}u \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|u|+C \\\\  & =-\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{cos}⁡3x|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|(\\operatorname{cos}⁡3x)^{-1}|+C \\\\  & =\\frac{1}{3}\\operatorname{ln}⁡|\\operatorname{sec}⁡3x|+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49278/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa"] :knowledge-point/questions ["q-49278"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49280/selection/4f6f96f0fb77218bb917b9c1fb386a80226891e85b2c3a3c5128bba5a7d78f58" :answer/id #uuid "f5ee91c7-d405-56f1-b102-1875a9f26cb3" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{tan}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-49280/selection/d570e97c9b34f39bad9feff257eb5cdaaee0dabf44e9b7aafbcb001b70b59e4f" :answer/id #uuid "9080a115-8bce-5471-a440-9d603cc94588" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{tan}⁡4x\\operatorname{sec}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-49280/selection/4a41246c9f1e122f0b7b5090749aa764baa855c1132e346630f64fc835d21f9c" :answer/id #uuid "b0374ace-3185-5f45-9639-79ce4494cf5a" :answer/type :answer.type/math :answer/value "\\frac{1}{4}{tan}^{2}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-49280/selection/55fec684c612641dfb21a06d292337e5a5f5eaa59b56a81c92fbd6e56b930309" :answer/id #uuid "089934f9-52e8-50d7-9a4d-304d048364ad" :answer/type :answer.type/math :answer/value "4\\operatorname{tan}⁡4x\\operatorname{sec}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-49280/selection/ad351e6ef8a6fe1dcd0988127c9689fa563ccce0d5d981c37c41f0500c86ff6c" :answer/id #uuid "f1c44999-74d7-5c74-b945-63ecb2d8d3ba" :answer/type :answer.type/math :answer/value "4\\operatorname{tan}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-49280/selection" :answer-field/id #uuid "c7708ddb-84df-5021-9323-7836c0f0e9c3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49280/selection/4f6f96f0fb77218bb917b9c1fb386a80226891e85b2c3a3c5128bba5a7d78f58" :answer-field/choices ["q-49280/selection/4f6f96f0fb77218bb917b9c1fb386a80226891e85b2c3a3c5128bba5a7d78f58" "q-49280/selection/d570e97c9b34f39bad9feff257eb5cdaaee0dabf44e9b7aafbcb001b70b59e4f" "q-49280/selection/4a41246c9f1e122f0b7b5090749aa764baa855c1132e346630f64fc835d21f9c" "q-49280/selection/55fec684c612641dfb21a06d292337e5a5f5eaa59b56a81c92fbd6e56b930309" "q-49280/selection/ad351e6ef8a6fe1dcd0988127c9689fa563ccce0d5d981c37c41f0500c86ff6c"] :db/ensure [:answer-field/validate]} {:db/id "q-49280" :question/id #uuid "07bc96d4-2114-5d28-917f-2b7ffe5f207c" :question/math-academy-id "q-49280" :question/problem "Calculate $\\int \\frac{\\operatorname{tan}⁡4x}{\\operatorname{cos}⁡4x\\operatorname{sin}⁡4x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{\\operatorname{tan}⁡4x}{\\operatorname{cos}⁡4x\\operatorname{sin}⁡4x}\\,\\text{d}x=\\int \\operatorname{tan}⁡4x\\cdot \\frac{1}{\\operatorname{cos}⁡4x\\operatorname{sin}⁡4x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\operatorname{tan}⁡4x=\\frac{\\operatorname{sin}⁡4x}{\\operatorname{cos}⁡4x}$ to express this as\n\n$$\n\\int \\frac{\\operatorname{sin}⁡4x}{\\operatorname{cos}⁡4x}\\cdot \\frac{1}{\\operatorname{cos}⁡4x\\operatorname{sin}⁡4x}\\,\\text{d}x.\n$$\n\nTherefore, using the identity $\\frac{1}{\\operatorname{cos}⁡4x}=\\operatorname{sec}⁡4x$, we get\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{tan}⁡4x}{\\operatorname{cos}⁡4x\\operatorname{sin}⁡4x}\\,\\text{d}x & =\\int \\frac{\\operatorname{sin}⁡4x}{\\operatorname{cos}⁡4x}\\cdot \\frac{1}{\\operatorname{cos}⁡4x\\operatorname{sin}⁡4x}\\,\\text{d}x \\\\  & =\\int \\frac{1}{\\operatorname{cos}⁡4x}\\cdot \\frac{1}{\\operatorname{cos}⁡4x}\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡4x\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=4x.$ Then $\\text{d}x=\\frac{1}{4}\\text{d}u.$ Hence,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\operatorname{tan}⁡4x}{\\operatorname{cos}⁡4x\\operatorname{sin}⁡4x}\\,\\text{d}x & =\\int {sec}^{2}⁡4x\\,\\text{d}x \\\\  & =\\int {sec}^{2}⁡u\\cdot \\frac{1}{4}\\,\\text{d}u \\\\  & =\\frac{1}{4}\\int {sec}^{2}⁡u\\,\\text{d}u \\\\  & =\\frac{1}{4}\\operatorname{tan}⁡u+C \\\\  & =\\frac{1}{4}\\operatorname{tan}⁡4x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49280/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa"] :knowledge-point/questions ["q-49280"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352797/field-1/011f5075d049da4fd0d5a02d69285f4ddc96af541fc9aef9d2fbb71616009e7f" :answer/id #uuid "276d12cf-e996-5357-b64d-096f04206208" :answer/type :answer.type/math :answer/value "\\ln(\\frac{3}{2})" :db/ensure [:answer/validate]} {:db/id "q-352797/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "1d67476d-5b1f-5fb2-8008-3de35a910411" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-352797/field-1" :answer-field/id #uuid "9bfea8b5-982e-51c7-94d0-286a2e511620" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352797/field-1/011f5075d049da4fd0d5a02d69285f4ddc96af541fc9aef9d2fbb71616009e7f" :answer-field/choices ["q-352797/field-1/011f5075d049da4fd0d5a02d69285f4ddc96af541fc9aef9d2fbb71616009e7f" "q-352797/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-352797" :question/id #uuid "75c4ab91-ebb5-5fe9-9351-221cd3ae76d8" :question/math-academy-id "q-352797" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /12}\\frac{2\\operatorname{cos}⁡(2x)}{1+\\operatorname{sin}⁡(2x)}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We can solve this by substitution. Let $u=1+\\operatorname{sin}⁡2x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{cos}⁡2x\\,⟹\\,\\text{d}u=2\\operatorname{cos}⁡2x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=1+\\operatorname{sin}⁡2x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{12}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $\\frac{3}{2}$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /12}\\frac{2\\operatorname{cos}⁡(2x)}{1+\\operatorname{sin}⁡(2x)}\\,\\text{d}x & ={\\int }_{1}^{3/2}\\frac{1}{u}\\,\\text{d}u \\\\  & =\\operatorname{ln}⁡|u|{|}_{1}^{3/2} \\\\  & =\\operatorname{ln}⁡(\\frac{3}{2})-\\operatorname{ln}⁡(1) \\\\  & =\\operatorname{ln}⁡(\\frac{3}{2})\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-352797/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa"] :knowledge-point/questions ["q-352797"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352786/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer/id #uuid "b1730c4a-1cab-567c-bc2c-f5931f316bd1" :answer/type :answer.type/math :answer/value "\\frac{7}{3}" :db/ensure [:answer/validate]} {:db/id "q-352786/field-1" :answer-field/id #uuid "527507f2-7464-5fa6-a11e-d163834e2854" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352786/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3" :answer-field/choices ["q-352786/field-1/cedce138738816f1e959edfd5049bf0c6bcf0acc69b898c7f84479cb3a782ce3"] :db/ensure [:answer-field/validate]} {:db/id "q-352786" :question/id #uuid "fc1564b1-ddad-50e0-ae4c-ee2d033f736e" :question/math-academy-id "q-352786" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}{sec}^{3}\\,x\\,\\operatorname{tan}⁡x\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We can solve this by substitution. Let $u=\\operatorname{sec}⁡x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\operatorname{sec}⁡x\\,\\operatorname{tan}⁡x\\,⟹\\,\\text{d}u=\\operatorname{sec}⁡x\\,\\operatorname{tan}⁡x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sec}⁡x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{3}$ |\n| --- | --- | --- |\n| $u$ | $1$ | $2$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{0}^{\\pi /3}{sec}^{3}\\,x\\,\\operatorname{tan}⁡x\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}{sec}^{2}\\,x\\cdot \\operatorname{sec}⁡x\\,\\operatorname{tan}⁡x\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}{u}^{2}\\,\\text{d}u \\\\  & =\\frac{{u}^{3}}{3}{|}_{1}^{2} \\\\  & =\\frac{1}{3}({2}^{3}-{1}^{3}) \\\\  & =\\frac{1}{3}(8-1) \\\\  & =\\frac{7}{3}\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-352786/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa"] :knowledge-point/questions ["q-352786"] :db/ensure [:knowledge-point/validate]}]
