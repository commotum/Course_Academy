fac9f5a0bfae"] :db/ensure [:answer-field/validate]} {:db/id "q-49274" :question/id #uuid "c407cd3a-68bd-5db6-8cf4-b08f6bf2ac1e" :question/math-academy-id "q-49274" :question/problem "Calculate $\\int \\frac{\\operatorname{tan}⁡x\\operatorname{cos}⁡x}{2}\\,\\text{d}x.$" :question/worked-solution "We use the identity $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\operatorname{tan}⁡x\\operatorname{cos}⁡x}{2}\\,\\text{d}x & =\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\cdot \\frac{\\operatorname{cos}⁡x}{2}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sin}⁡x}{2}\\,\\text{d}x \\\\  & =\\frac{1}{2}\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =-\\frac{1}{2}\\operatorname{cos}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49274/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7bd68b3-56ae-57e5-81ef-2370c96664c4"] :knowledge-point/questions ["q-49274"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-49070"] :question/problem "$\\int \\operatorname{tan}⁡x(\\operatorname{sec}⁡x+2\\operatorname{cos}⁡x)\\,\\text{d}x=$" :question/worked-solution "We multiply out the parentheses and then use the identity $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},$ as follows:\n\n$$\n\\begin{aligned}\\int \\operatorname{tan}⁡x(\\operatorname{sec}⁡x+2\\operatorname{cos}⁡x)\\,\\text{d}x & =\\int (\\operatorname{tan}⁡x\\operatorname{sec}⁡x+\\operatorname{tan}⁡x\\cdot 2\\operatorname{cos}⁡x)\\text{d}x \\\\  & =\\int (\\operatorname{sec}⁡x\\operatorname{tan}⁡x+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\cdot 2\\operatorname{cos}⁡x)\\text{d}x \\\\  & =\\int (\\operatorname{sec}⁡x\\operatorname{tan}⁡x+2\\operatorname{sin}⁡x)\\text{d}x \\\\  & =\\int \\operatorname{sec}⁡x\\operatorname{tan}⁡x\\,\\text{d}x+2\\int \\operatorname{sin}⁡x\\,\\text{d}x \\\\  & =\\operatorname{sec}⁡x-2\\operatorname{cos}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-49272/selection/85c3934b3db2f518d7c5c7fd5c80da08309c8810883e90e77c05b68e5dd6400d" :answer/id #uuid "ec2a3299-9f90-5596-838d-cff5c0c4952a" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x-x+C" :db/ensure [:answer/validate]} {:db/id "q-49272/selection/4fb6e799a56acd16b7db0282d09f432581828a9608d021abfc8620c3aade649f" :answer/id #uuid "f0131869-e77c-53ea-9a97-8a419d11e0be" :answer/type :answer.type/math :answer/value "-\\operatorname{sin}⁡x-x+C" :db/ensure [:answer/validate]} {:db/id "q-49272/selection/bb506cf003879770dcc37d3f108f66837df546bd68c5ad9b0e1b3a27b8c6ec6c" :answer/id #uuid "e1323c3f-2c75-50d9-a04e-46433f2de703" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49272/selection/613409c5e37e53b1ed2e94643d48d487eafecc38199f442be1ea7e50590f6301" :answer/id #uuid "6ff04e81-bf94-5a5e-968a-6569b54db209" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x-x+C" :db/ensure [:answer/validate]} {:db/id "q-49272/selection/b157222d6286bd76fe30d4a2451e96dc3dde5e7b70e78df6a178b9be026b65f2" :answer/id #uuid "1f2a87d6-846e-5eed-a0d5-7cc2064f58d9" :answer/type :answer.type/math :answer/value "-\\operatorname{cos}⁡x-x+C" :db/ensure [:answer/validate]} {:db/id "q-49272/selection" :answer-field/id #uuid "7838c7bc-0311-52aa-aac9-395894888917" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49272/selection/85c3934b3db2f518d7c5c7fd5c80da08309c8810883e90e77c05b68e5dd6400d" :answer-field/choices ["q-49272/selection/85c3934b3db2f518d7c5c7fd5c80da08309c8810883e90e77c05b68e5dd6400d" "q-49272/selection/4fb6e799a56acd16b7db0282d09f432581828a9608d021abfc8620c3aade649f" "q-49272/selection/bb506cf003879770dcc37d3f108f66837df546bd68c5ad9b0e1b3a27b8c6ec6c" "q-49272/selection/613409c5e37e53b1ed2e94643d48d487eafecc38199f442be1ea7e50590f6301" "q-49272/selection/b157222d6286bd76fe30d4a2451e96dc3dde5e7b70e78df6a178b9be026b65f2"] :db/ensure [:answer-field/validate]} {:db/id "q-49272" :question/id #uuid "9bc58fe3-4afd-5b0d-a72b-13bb8464c51a" :question/math-academy-id "q-49272" :question/problem "$\\int \\operatorname{cot}⁡x(\\operatorname{sin}⁡x-\\operatorname{tan}⁡x)\\,\\text{d}x=$" :question/worked-solution "We multiply out the parentheses and then use the identities $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x},$ and $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{cot}⁡x(\\operatorname{sin}⁡x-\\operatorname{tan}⁡x)\\,\\text{d}x & =\\int (\\operatorname{cot}⁡x\\cdot \\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot \\operatorname{tan}⁡x)\\,\\text{d}x \\\\  & =\\int (\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\operatorname{sin}⁡x-\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x-1)\\,\\text{d}x \\\\  & =\\operatorname{sin}⁡x-x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49272/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7bd68b3-56ae-57e5-81ef-2370c96664c4"] :knowledge-point/questions ["q-49272"] :db/ensure [:knowledge-point/validate]} {:db/id "q-51109/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "55b650bb-4e4a-5aae-a0ac-bbcdbdfe81de" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-51109/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "3ffd38aa-dc3b-5624-8442-f55807557453" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-51109/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "ff2915cc-2ec4-5ce7-91bf-7bd31941fbed" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-51109/selection/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" :answer/id #uuid "345ed6a6-e213-50c0-bc26-3d82566c387e" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-51109/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "c93ba90b-3f50-5023-9616-4888404c88cb" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-51109/selection" :answer-field/id #uuid "2b4a1100-5b8a-5db0-9078-e78b1a8b368f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-51109/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer-field/choices ["q-51109/selection/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" "q-51109/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-51109/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-51109/selection/e53026d2e72b5a9665afb169ba986753fff36dfc4557e460320cb8d9594cece8" "q-51109/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873"] :db/ensure [:answer-field/validate]} {:db/id "q-51109" :question/id #uuid "379e9498-17d7-5258-a37f-d94516f74aac" :question/math-academy-id "q-51109" :question/problem "${\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(2x)\\operatorname{tan}⁡(2x)\\,\\text{d}x=$" :question/worked-solution "We use the identity $\\operatorname{tan}⁡2x=\\frac{\\operatorname{sin}⁡2x}{\\operatorname{cos}⁡2x},$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(2x)\\operatorname{tan}⁡(2x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /6}\\operatorname{cos}⁡(2x)\\cdot \\frac{\\operatorname{sin}⁡2x}{\\operatorname{cos}⁡2x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /6}\\operatorname{sin}⁡(2x)\\,\\text{d}x\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=2x.$ Then $\\text{d}x=\\frac{1}{2}\\text{d}u.$ \n\nNow, we fill the table for the limits of integration, according to the rule $u=2x.$\n\n| $x$ | $0$ | $\\frac{\\pi }{6}$ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\frac{\\pi }{3}$ |\n\nTherefore, the integral in terms of the new variable is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /6}\\operatorname{sin}⁡(2x)\\,\\text{d}x & ={\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡u\\cdot \\frac{1}{2}\\text{d}u \\\\  & =\\frac{1}{2}{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡u\\,\\text{d}u \\\\  & =-\\frac{\\operatorname{cos}⁡u}{2}{|}_{0}^{\\pi /3} \\\\  & =-\\frac{1}{2}(\\operatorname{cos}⁡(\\frac{\\pi }{3})-\\operatorname{cos}⁡(0)) \\\\  & =-\\frac{1}{2}\\cdot (\\frac{1}{2}-1) \\\\  & =\\frac{1}{4}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-51109/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7bd68b3-56ae-57e5-81ef-2370c96664c4"] :knowledge-point/questions ["q-51109"] :db/ensure [:knowledge-point/validate]} {:db/id "q-49258/selection/7b279d81235513e0ad414cd3bd62486f900c59a782d1e2091f62ec9714cb427e" :answer/id #uuid "4ece5e31-a3b6-557c-86ca-d097b4e71653" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{cos}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49258/selection/4164f6545dee27515015a42b4af54cfc80421242737584f91316788006da4c92" :answer/id #uuid "9da9a697-2470-5eab-ac75-025dd2c42471" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49258/selection/bb506cf003879770dcc37d3f108f66837df546bd68c5ad9b0e1b3a27b8c6ec6c" :answer/id #uuid "12ac93e4-48da-5e7d-8e86-449073272e96" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49258/selection/a73c5ea78df11c7d4c0ffed5f25a76cdafd8dd5cd7b916f26feb40149cb75ef7" :answer/id #uuid "6a22cc0d-3ce6-5c0b-87df-ddcbb555b548" :answer/type :answer.type/math :answer/value "\\operatorname{sec}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49258/selection/96f62147f13c97219bb42c049238e849be813b1cdea1c9511461591d7973b482" :answer/id #uuid "1eeaf580-58e6-5ce7-ab34-109a63893baa" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\operatorname{tan}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-49258/selection" :answer-field/id #uuid "a278f1cb-b741-5a0d-ad86-3d531580b8ac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49258/selection/4164f6545dee27515015a42b4af54cfc80421242737584f91316788006da4c92" :answer-field/choices ["q-49258/selection/7b279d81235513e0ad414cd3bd62486f900c59a782d1e2091f62ec9714cb427e" "q-49258/selection/4164f6545dee27515015a42b4af54cfc80421242737584f91316788006da4c92" "q-49258/selection/bb506cf003879770dcc37d3f108f66837df546bd68c5ad9b0e1b3a27b8c6ec6c" "q-49258/selection/a73c5ea78df11c7d4c0ffed5f25a76cdafd8dd5cd7b916f26feb40149cb75ef7" "q-49258/selection/96f62147f13c97219bb42c049238e849be813b1cdea1c9511461591d7973b482"] :db/ensure [:answer-field/validate]} {:db/id "q-49258" :question/id #uuid "4267ace3-7026-57ec-b5b0-b39e5d715bde" :question/math-academy-id "q-49258" :question/problem "Calculate $\\int \\frac{\\operatorname{cot}⁡x\\operatorname{sin}⁡x}{4}\\,\\text{d}x.$" :question/worked-solution "We use the identity $\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}$ as follows:\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\frac{\\operatorname{cot}⁡x\\operatorname{sin}⁡x}{4}\\,\\text{d}x & =\\int \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{sin}⁡x}{4}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{cos}⁡x}{4}\\,\\text{d}x \\\\  & =\\frac{1}{4}\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\  & =\\frac{1}{4}\\operatorname{sin}⁡x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-49258/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d7bd68b3-56ae-57e5-81ef-2370c96664c4"] :knowledge-point/questions ["q-49258"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352853/field-1/53a420520806087169afd016e0222593d83e6cf4de094532635be1c9c324cb3e" :answer/id #uuid "7b9a0236-0378-5579-93c8-a43981adbfb6" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}+\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-352853/field-1" :answer-field/id #uuid "22869a33-682a-53cb-977f-c168b27b8d28" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352853/field-1/53a420520806087169afd016e0222593d83e6cf4de094532635be1c9c324cb3e" :answer-field/choices ["q-352853/field-1/53a420520806087169afd016e0222593d83e6cf4de094532635be1c9c324cb3e"] :db/ensure [:answer-field/validate]} {:db/id "q-352853" :question/id #uuid "c38935ed-4bc6-5d43-868b-d331452b0131" :question/math-academy-id "q-352853" :question/problem "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\pi /3}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\,\\text{d}x=$\n{{field-1}}" :question/worked-solution "We use the identities $\\frac{1}{\\operatorname{sec}⁡x}=\\operatorname{cos}⁡x$  and  $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x},$ as follows:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\pi /3}\\frac{1+\\operatorname{tan}⁡x}{\\operatorname{sec}⁡x}\\text{d}x & ={\\int }_{0}^{\\pi /3}\\frac{1}{\\operatorname{sec}⁡x}\\cdot (1+\\operatorname{tan}⁡x)\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}\\operatorname{cos}⁡x(1+\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x})\\,\\text{d}x \\\\  & ={\\int }_{0}^{\\pi /3}(\\operatorname{cos}⁡x+\\operatorname{sin}⁡x)\\,\\text{d}x \\\\  & =(\\operatorname{sin}⁡x-\\operatorname{cos}⁡x){|}_{0}^{\\pi /3} \\\\  & =(\\frac{\\sqrt{3}}{2}-\\frac{1}{2})-(0-1) \\\\  & =\\frac{1}{2}+\\frac{\\sqrt{3}}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352853/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5"] :knowledge-point/questions ["q-352853"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352868/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "fe47818b-fb2f-50d3-98b2-39d200c448c0" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id 17592186298553 :answer-field/choices ["q-352868/field-1/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e"] :db/ensure [:answer-field/validate]} {:db/id "q-114313/selection/dc9fc23c2fb599e8ec825c1d4a1139da15462432a0c7a574ff8e3aeb41245b56" :answer/id #uuid "5bfe218a-4298-5d1a-8d4a-21bc096f7b0c" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡x+\\operatorname{sec}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114313/selection/6ec91dfae0f8a165c963970e35e51150afb937485710022a822d04897d7be9ef" :answer/id #uuid "90c6c6df-c0db-5186-b953-2b0fb9f31ec9" :answer/type :answer.type/math :answer/value "\\operatorname{csc}⁡x-\\operatorname{cot}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114313/selection/72a5bdfc283f8e570d0bb8c81650c610fa62a03b6e281dcf49964bd17c00d40f" :answer/id #uuid "c99da369-f5ac-523b-b0cc-5a3fb4bb74c7" :answer/type :answer.type/math :answer/value "\\operatorname{cos}⁡x-\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114313/selection/bbebbf170eeb5926622b1f0c1454b0491923d45642d8b1fdaf1c4f09109ef4cc" :answer/id #uuid "d47c6437-a1fb-5960-9720-e18bbfd3d39c" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x+\\operatorname{csc}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114313/selection/a89b50cae9c759efcf8f90509a5fcf0c8e11a6e5818672901697a6952ff9a39b" :answer/id #uuid "8dbeadf8-1a95-5a05-926c-031574f13c95" :answer/type :answer.type/math :answer/value "\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114313/selection" :answer-field/id #uuid "5ccdb9d8-a843-5e82-93e0-6e7eb65611de" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114313/selection/bbebbf170eeb5926622b1f0c1454b0491923d45642d8b1fdaf1c4f09109ef4cc" :answer-field/choices ["q-114313/selection/dc9fc23c2fb599e8ec825c1d4a1139da15462432a0c7a574ff8e3aeb41245b56" "q-114313/selection/6ec91dfae0f8a165c963970e35e51150afb937485710022a822d04897d7be9ef" "q-114313/selection/72a5bdfc283f8e570d0bb8c81650c610fa62a03b6e281dcf49964bd17c00d40f" "q-114313/selection/bbebbf170eeb5926622b1f0c1454b0491923d45642d8b1fdaf1c4f09109ef4cc" "q-114313/selection/a89b50cae9c759efcf8f90509a5fcf0c8e11a6e5818672901697a6952ff9a39b"] :db/ensure [:answer-field/validate]} {:db/id "q-114313" :question/id #uuid "8642bcc0-89fd-586c-8c7c-00d4c39709e8" :question/math-academy-id "q-114313" :question/problem "$\\int \\frac{\\operatorname{sin}⁡x-\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{\\operatorname{sin}⁡x-\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x=\\int \\frac{1}{\\operatorname{tan}⁡x}(\\operatorname{sin}⁡x-\\operatorname{csc}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{1}{\\operatorname{tan}⁡x}=\\operatorname{cot}⁡x=\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}$ to express this as\n\n$$\n\\begin{aligned}\\int \\operatorname{cot}⁡x(\\operatorname{sin}⁡x-\\operatorname{csc}⁡x)\\text{d}x & =\\int (\\operatorname{cot}⁡x\\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot \\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\cdot \\operatorname{sin}⁡x-\\operatorname{cot}⁡x\\cdot \\operatorname{csc}⁡x)\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sin}⁡x-\\operatorname{csc}⁡x}{\\operatorname{tan}⁡x}\\,\\text{d}x & =\\int (\\operatorname{cos}⁡x-\\operatorname{csc}⁡x\\operatorname{cot}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-(-\\operatorname{csc}⁡x)+C \\\\  & =\\operatorname{sin}⁡x+\\operatorname{csc}⁡x+C.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114313/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5"] :knowledge-point/questions ["q-114313"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73361/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "97a7e750-0c3b-59ef-b2e8-5a581387defb" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-73361/selection/2b44e6d43e3927389e0c1c2c163b7136f70bbb82b73accf5d4c97d2f0dd2b207" :answer/id #uuid "4a87016a-964b-54a6-8d1d-8b7347307c84" :answer/type :answer.type/math :answer/value "\\sqrt{2}-2" :db/ensure [:answer/validate]} {:db/id "q-73361/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "8e20ad80-43ad-5fad-a90a-286dc5619cc0" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-73361/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "3db8725f-db52-5ce1-b009-c06d371ac1c8" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-73361/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "e88dd7d7-1743-59f0-bb84-1bde1ca3a50c" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-73361/selection" :answer-field/id #uuid "639f496d-d