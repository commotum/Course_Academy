}/4}^{{y}^{2}/4}f(x,y)\\,\\text{d}x\\,\\text{d}y & ={\\int }_{-1}^{0}{\\int }_{2\\sqrt{-x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{1}{\\int }_{2\\sqrt{x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x.\\end{aligned}\n$$" 13194139535840 true] [17592186369501 1000 #edb/ref 17592186369502 13194139535840 true] [17592186369501 1000 #edb/ref 17592186369503 13194139535840 true] [17592186369501 1000 #edb/ref 17592186369504 13194139535840 true] [17592186369501 1000 #edb/ref 17592186369505 13194139535840 true] [17592186369501 1000 #edb/ref 17592186369506 13194139535840 true] [17592186369501 1040 #edb/ref 17592186045450 13194139535840 true] [17592186369501 1041 "selection" 13194139535840 true] [17592186369501 1104 #edb/ref 17592186369503 13194139535840 true] [17592186369501 1110 #uuid "2476e7fd-dd6b-522b-becf-475e3c807e6b" 13194139535840 true] [17592186369502 1034 "{\\int }_{-1}^{0}{\\int }_{-2\\sqrt{x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{1}{\\int }_{2\\sqrt{-x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x" 13194139535840 true] [17592186369502 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369502 1111 #uuid "b47b8823-16b3-5969-8a1b-8f206f5dc0ab" 13194139535840 true] [17592186369503 1034 "{\\int }_{-1}^{0}{\\int }_{2\\sqrt{-x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{1}{\\int }_{2\\sqrt{x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x" 13194139535840 true] [17592186369503 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369503 1111 #uuid "77ea91a6-9ad7-5ca5-b456-6f125376b6f9" 13194139535840 true] [17592186369504 1034 "{\\int }_{-2}^{0}{\\int }_{2\\sqrt{-x}}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{2}{\\int }_{2\\sqrt{x}}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x" 13194139535840 true] [17592186369504 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369504 1111 #uuid "6bf7ef9b-3b72-52cb-ab14-e2139cec8df8" 13194139535840 true] [17592186369505 1034 "{\\int }_{-1}^{0}{\\int }_{-2\\sqrt{x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{1}{\\int }_{2\\sqrt{x}}^{2}f(x,y)\\,\\text{d}y\\,\\text{d}x" 13194139535840 true] [17592186369505 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369505 1111 #uuid "25767e96-4838-56b8-ac30-6e22cca5b6f4" 13194139535840 true] [17592186369506 1034 "{\\int }_{-2}^{0}{\\int }_{2\\sqrt{-x}}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x+{\\int }_{0}^{2}{\\int }_{-2\\sqrt{x}}^{1}f(x,y)\\,\\text{d}y\\,\\text{d}x" 13194139535840 true] [17592186369506 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369506 1111 #uuid "5a0e42c4-7895-50b9-9667-bdf30f0318c8" 13194139535840 true] [17592186369507 1017 #edb/ref 17592186369508 13194139535840 true] [17592186369507 1089 "q-132638" 13194139535840 true] [17592186369507 1091 #edb/ref 17592186045465 13194139535840 true] [17592186369507 1100 "Change the order of integration and evaluate the double integral \n${\\int }_{0}^{2}{\\int }_{0}^{4-{x}^{2}}4x{e}^{8y-{y}^{2}}\\,\\text{d}y\\,\\text{d}x.$" 13194139535840 true] [17592186369507 1113 #uuid "ce12cfe8-66ac-51ba-9613-47633a967b14" 13194139535840 true] [17592186369507 1145 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071085/assets/262e1b0c4e0ddf338c527b487fcadc85baac12712f91cb4c54b771e49add25b9.png)\n\nThe diagram above shows the region of integration. It is a type I region, and its type I representation is\n\n$$\nD={(x,y)\\,:\\,0\\le x\\le 2,\\,0\\le y\\le 4-{x}^{2}}.\n$$\n\nNotice that the left boundary of the region, written in the form $y=y(x),$ is\n\n$$\nx=0,\n$$\n\nand the right boundary of the region is\n\n$$\ny=4-{x}^{2}\\,⟹\\,x=\\sqrt{4-y}.\n$$\n\nTo change the order of integration, we write $D$ as a type II region. The type II representation of the region is\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 4,\\,0\\le x\\le \\sqrt{4-y}},\n$$\n\nas shown in the diagram below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071085/assets/48c874b069b55599f76a8fe1aa50c5f4db36ff8943d264a107452668d689174b.png)\n\nTherefore, swapping the order of integration, we obtain\n\n$$\n\\begin{aligned}{\\int }_{0}^{2}{\\int }_{0}^{4-{x}^{2}}4x{e}^{8y-{y}^{2}}\\,\\text{d}y\\,\\text{d}x & ={\\int }_{0}^{4}{\\int }_{0}^{\\sqrt{4-y}}4x{e}^{8y-{y}^{2}}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}{e}^{8y-{y}^{2}}[{\\int }_{0}^{\\sqrt{4-y}}4x\\,\\text{d}x]\\text{d}y \\\\  & ={\\int }_{0}^{4}{e}^{8y-{y}^{2}}\\cdot 2{x}^{2}\\,{|}_{0}^{\\sqrt{4-y}}\\,\\text{d}y \\\\  & ={\\int }_{0}^{4}2(4-y){e}^{8y-{y}^{2}}\\,\\text{d}y \\\\  & ={e}^{8y-{y}^{2}}\\,{|}_{0}^{4} \\\\  & ={e}^{8(4)-{4}^{2}}-{e}^{8(0)-{0}^{2}} \\\\  & ={e}^{16}-1.\\end{aligned}\n$$" 13194139535840 true] [17592186369508 1000 #edb/ref 17592186369509 13194139535840 true] [17592186369508 1000 #edb/ref 17592186369510 13194139535840 true] [17592186369508 1000 #edb/ref 17592186369511 13194139535840 true] [17592186369508 1000 #edb/ref 17592186369512 13194139535840 true] [17592186369508 1000 #edb/ref 17592186369513 13194139535840 true] [17592186369508 1040 #edb/ref 17592186045450 13194139535840 true] [17592186369508 1041 "selection" 13194139535840 true] [17592186369508 1104 #edb/ref 17592186369511 13194139535840 true] [17592186369508 1110 #uuid "80e985df-366f-5045-8110-abecdf985e8f" 13194139535840 true] [17592186369509 1034 "{e}^{4}+1" 13194139535840 true] [17592186369509 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369509 1111 #uuid "c9b5f5ef-9b99-5f5b-b0cc-9ac257ae7a41" 13194139535840 true] [17592186369510 1034 "1-{e}^{8}" 13194139535840 true] [17592186369510 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369510 1111 #uuid "eb65f06d-de1e-5a3d-91d5-b1fb93976ab5" 13194139535840 true] [17592186369511 1034 "{e}^{16}-1" 13194139535840 true] [17592186369511 1103 #edb/ref 17592186045453 13194139535840 true] [17592186369511 1111 #uuid "9a029056-dc77-50d6-aeee-01696dea412a" 13194139535840 true] [17592186369512 1034 "{e}^{4}-{e}^{-16}" 13194139535840 true] [17592186369512 1103 #ed