me{sin}⁡\\theta ⟩.\\end{aligned}\n$$\n\nSince $f={cos}^{2}⁡y,$ we obtain ${f}^{′}=-2\\operatorname{sin}⁡y\\operatorname{cos}⁡y.$ So, finally, we conclude that the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{y}^{′}\\times {r}_{\\theta }^{′}=⟨{cos}^{2}⁡y\\operatorname{cos}⁡\\theta ,\\,2\\operatorname{sin}⁡y{cos}^{3}⁡y,\\,{cos}^{2}⁡y\\operatorname{sin}⁡\\theta ⟩.\\end{aligned}\n$$" 13194139535903 true] [17592186172312 1091 #edb/ref 17592186045463 13194139535903 true] [17592186172312 1100 "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $y = x^{4}$ is rotated by $2π$ radians about the $x$-axis for $x ∈ [- 2, 2]$." 13194139535903 false] [17592186172312 1100 "Use a fundamental vector product to determine which of the following integrals gives the surface area generated when the curve $y={x}^{4}$ is rotated by $2\\pi $ radians about the $x$-axis for $x\\in [-2,2].$" 13194139535903 true] [17592186172312 1145 "Notice that $y={x}^{4}\\ge 0$ for all $x\\in [-2,2].$ The parametrization of our surface of revolution is\n\n$$\n\\begin{aligned}r=⟨x,\\,f(x)\\operatorname{cos}⁡\\theta ,\\,f(x)\\operatorname{sin}⁡\\theta ⟩,\\,(x,\\theta )\\in D\\end{aligned}\n$$\n\nwhere $f(x)={x}^{4},$ and\n\n$$\nD={(x,\\theta )\\,:\\,-2\\le x\\le 2,\\,0\\le \\theta \\le 2\\pi }.\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{x}^{′} & =⟨\\frac{∂x}{∂x},\\,\\frac{∂y}{∂x},\\,\\frac{∂z}{∂x}⟩=⟨1,\\,{f}^{′}\\operatorname{cos}⁡\\theta ,\\,{f}^{′}\\operatorname{sin}⁡\\theta ⟩ \\\\ {r}_{\\theta }^{′} & =⟨\\frac{∂x}{∂\\theta },\\,\\frac{∂y}{∂\\theta },\\,\\frac{∂z}{∂\\theta }⟩=⟨0,\\,-f\\operatorname{sin}⁡\\theta ,\\,f\\operatorname{cos}⁡\\theta ⟩\\end{aligned}\n$$\n\nNext, the fundamental vector product is\n\n$$\n\\begin{aligned}{r}_{x}^{′}\\times {r}_{\\theta }^{′} & =|\\begin{aligned}i & j & k \\\\ 1 & {f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}| \\\\  & =⟨|\\begin{aligned}{f}^{′}\\operatorname{cos}⁡\\theta  & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ -f\\operatorname{sin}⁡\\theta  & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,-|\\begin{aligned}1 & {f}^{′}\\operatorname{sin}⁡\\theta  \\\\ 0 & f\\operatorname{cos}⁡\\theta \\end{aligned}|,\\,|\\begin{aligned}1 & {f}^{′}\\operatorname{cos}⁡\\theta  \\\\ 0 & -f\\operatorname{sin}⁡\\theta \\end{aligned}|⟩ \\\\  & =⟨f{f}^{′}{cos}^{2}⁡\\theta +f{f}^{′}{sin}^{2}⁡\\theta ,\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩ \\\\  & =⟨f{f}^{′},\\,-f\\operatorname{cos}⁡\\theta ,\\,-f\\operatorname{sin}⁡\\theta ⟩\\end{aligned}\n$$\n\nand\n\n$$\n\\begin{aligned}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖ & =\\sqrt{(f{f}^{′})^{2}+(-f\\operatorname{cos}⁡\\theta )^{2}+(-f\\operatorname{sin}⁡\\theta )^{2}} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}({cos}^{2}⁡\\theta +{sin}^{2}⁡\\theta )} \\\\  & =\\sqrt{{f}^{2}({f}^{′})^{2}+{f}^{2}} \\\\  & =f\\sqrt{1+({f}^{′})^{2}}.\\end{aligned}\n$$\n\nTherefore, the surface area is\n\n$$\n\\begin{aligned}A & ={∬}_{S}\\,\\text{d}S \\\\  & ={∬}_{D}‖{r}_{x}^{′}\\times {r}_{\\theta }^{′}‖\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={∬}_{D}f\\sqrt{1+({f}^{′})^{2}}\\,\\,\\text{d}x\\,\\text{d}\\theta  \\\\  & ={\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}{\\int }_{0}^{2\\pi }\\,\\text{d}\\theta \\,\\text{d}x \\\\  & ={\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\cdot \\theta \\,{|}_{0}^{2\\pi }\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nSince $f={x}^{4},$ we obtain ${f}^{′}=4{x}^{3}.$ So, finally, we conclude that our expression for the surface area is\n\n$$\n\\begin{aligned}2\\pi {\\int }_{-2}^{2}f\\sqrt{1+({f}^{′})^{2}}\\,\\text{d}x & =2\\pi {\\int }_{-2}^{2}{x}^{4}\\sqrt{1+(4{x}^{3})^{2}}\\,\\text{d}x \\\\  & =2\\pi {\\int }_{-2}^{2}{x}^{4}\\sqrt{1+16{x}^{6}}\\,\\text{d}x.\\end{aligned}\