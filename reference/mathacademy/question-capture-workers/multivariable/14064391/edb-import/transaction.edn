7635/selection/17189c607fad2a9a1ec2e47aff5b7c58b65b290340873f2f1af28a5ec55ec56c" "q-97635/selection/09a1429fb322077928b096d1aa2d5e2ad1814460a872b3b2ce0952c670557f5a"] :db/ensure [:answer-field/validate]} {:db/id "q-97635" :question/id #uuid "c28d54e1-803b-58a8-b2b2-007b4a9cffb6" :question/math-academy-id "q-97635" :question/problem "A particle moves along a **clockwise** circular path with center $O$ in the $xy$-plane with a constant angular velocity of $3\\text{ rad/s}.$ Given that the object is at the position $(2,0)$ when $t=0,$ find the position function of the particle." :question/worked-solution "The position function of a particle moving in a circular path of radius $R$ in the $xy$-plane with a constant angular velocity $\\omega $ is given by\n\n$$\nr(t)=R(\\operatorname{cos}⁡\\omega t\\,i+\\operatorname{sin}⁡\\omega t\\,j),\n$$\n\nwhere it is assumed that the circle is centered at $O,$ and particle is at the position $(R,0)$ when $t=0.$\n\nSince the object's initial position is $(2,0),$ we have that $r(0)=\\,2i,$ and we can conclude that the radius of the circle $R=2.$\n\nTherefore, since we have $R=2$ and $\\omega =-3\\text{ rad/s}$ (negative because the motion is clockwise), we get that the position function is given by\n\n$$\n\\begin{aligned}r(t) & =2(\\operatorname{cos}⁡(-3t)\\,i+\\operatorname{sin}⁡(-3t)\\,j) \\\\  & =2(\\operatorname{cos}⁡3t\\,i-\\operatorname{sin}⁡3t\\,j).\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-97635/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "eb1745c5-6485-5a9d-9e8f-19492928e4b4"] :knowledge-point/questions ["q-97635"] :db/ensure [:knowledge-point/validate]} {:db/id "q-97631/selection/2934858f23cdf4c4645db0b99b6b070551324e462c286f2be81b92b6b2c5297f" :answer/id #uuid "cadb88ee-225b-5f6a-9b83-faa4f40265f5" :answer/type :answer.type/math :answer/value "r(t)=\\operatorname{cos}⁡4t\\,i+\\operatorname{sin}⁡4t\\,j" :db/ensure [:answer/validate]} 