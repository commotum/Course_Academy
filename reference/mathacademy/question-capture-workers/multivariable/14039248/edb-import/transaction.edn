1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/4e0e5c9cee037bded1f5739af35c3a8acfaa4d4e6f469b3e50afe69b96990e39.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/358dcedefd029cdbd07f3c64b1264e568bfbac134b92a607e9d55c632c277b13.png)" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81821/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b"] :knowledge-point/questions ["q-81821"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-160619"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/f3e31d1c15a97adea32790eafe75ad1bc9f70c854b516b98de6648ec8d7bcb87.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =A(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =A(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/9fae3ec0ada3008937d88e4e76374a56da4369b1821cfee072c90d88b562df46.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/ae800b271848948b5f60f5cd7c1cecd163c2aa7399e9a87e2a52d158857c6a42.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-160621"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/b75a7519c7953b7a3c5bd5b5e61e961ca26c3f0dc9e1aab32bf2c639dd95325f.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/f154267ed0a528b1e9fbec40064b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/8ea257c65769c4d6f67f55ce6533c1bfdfe45debcf1ba532b9ec3f717238507a.png)" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-81450"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/d111b1df75cfaa0d86d17c06584c57b19ca4711ae3e6720e68d1704fd72d86ae.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/f154267ed0a528b1e9fbec40064b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/dd0496914b35f969896c6a54907fbfa5ea6c139c878d8682b933a8757bde7524.png)" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-160648/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "e642302b-2c97-566a-bc78-c5cc15eeb8ba" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-160648/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "a8032f23-fcb4-53dc-a28d-542950709418" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-160648/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "abe73f35-7b0d-56f3-9aac-e923a6b1fe1e" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-160648/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "8f4fe7c8-beeb-5d20-a2b9-7a1dde933a13" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-160648/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "069f3ebf-61eb-519c-8cd0-87d6077ab52c" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-160648/selection" :answer-field/id #uuid "60f038ee-6e0a-5901-9bfb-2e937307a9b2" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160648/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-160648/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-160648/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-160648/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-160648/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-160648/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-160648" :question/id #uuid "805b41fe-1938-5f5c-95ff-fff97c430efd" :question/math-academy-id "q-160648" :question/problem "A triangle $S$ has vertices at  $(1,-1),(-2,3),(-1,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(1,1)$\n- $(-3,-2)$\n- $(0,2)$" :question/worked-solution "The clockwise rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ is the same as counterclockwise rotation by an angle of ${90}^{∘}.$ It's given by the matrix\n\n$$\nR[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}1 & -2 & -1 \\\\ -1 & 3 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 & -2 & -1 \\\\ -1 & 3 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 & 0 \\\\ 1 & -2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,1),(-3,-2),(0,-1).$\n\nSo, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-160648/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-160648"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11961/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "fbc60a6d-2862-52aa-b8d3-7f5efd1a1738" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-11961/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "1c46cf2d-9bff-5f3b-8ecf-f5bd8754777f" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-11961/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "52109998-cd20-53b1-a3e0-e455f318a62f" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-11961/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "9506c4ca-6a11-5c3d-b959-ee562bbba4e3" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-11961/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "33c35414-c1a7-5d57-9d69-e73a67690ce3" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-11961/selection" :answer-field/id #uuid "efd2d3ff-916a-554f-b5ff-99fc73d2ad5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11961/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-11961/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-11961/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-11961/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-11961/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-11961/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-11961" :question/id #uuid "1bc23a19-df35-5757-b9a8-0b3bf67f1e4c" :question/math-academy-id "q-11961" :question/problem "A triangle $S$ has vertices at $(-2,-3),(0,5),(2,-5).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians about the origin?\n\n- $(3,-2)$\n- $(-5,0)$\n- $(5,2)$" :question/worked-solution "The counterclockwise rotation ${R}_{\\pi /2}$ by an angle of $\\frac{\\pi }{2}$ radians is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{\\pi /2},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 0 & 2 \\\\ -3 & 5 & -5\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{\\pi /2}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}-2 & 0 & 2 \\\\ -3 & 5 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}3 & -5 & 5 \\\\ -2 & 0 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(3,-2),(-5,0),(5,2).$\n\nSo, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-11961/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4"] :knowledge-point/questions ["q-11961"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-7186"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/a43a1658a16151c0306702959c50e8d0288077983ad50a084b39703e206469c0.png)\n\nConsider the vector $\\mathbf{v}$ shown above. Find the vector $A\\mathbf{v}$ given that \n\n$$\n[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]\n$$" :question/worked-solution "Consider the standard basis $\\{ \\mathbf{i},\\mathbf{j} \\}$ of the Euclidean plane $\\mathbb{R}^2$ and the unit square spanned by the vectors. Computing the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $A,$ we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/414cb72ff004fe4c5898a0e2c7b60b4b3651473e776388fad21efd8fc9ae6165.png)\n\nSo, the matrix represents a rotation of $\\dfrac{\\pi}{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $A\\mathbf{v},$ we need to rotate $\\mathbf{v}$ counterclockwise by an angle of $\\dfrac{\\pi}{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/b24d8d460b7833a49f2bd7183f0f4b5d22d94a7d3b1d3bb9eb51beff9eeb7ef6.png)" :db/ensure [:question/validate]}]
