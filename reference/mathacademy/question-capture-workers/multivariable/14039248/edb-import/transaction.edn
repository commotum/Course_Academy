[{:db/id "q-160374/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "91361bc0-3a63-5084-a396-0725cc52af54" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-160374/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "4df960ef-15bb-575e-abe6-7eb4ec4fcbf1" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-160374/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer/id #uuid "3697d24e-db87-59e0-8232-8633e6adcc43" :answer/type :answer.type/text :answer/value "I, II, and III" :db/ensure [:answer/validate]} {:db/id "q-160374/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e737328b-6d06-5289-99e1-58f03bdeb38e" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-160374/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "73f1cd39-b5fa-56d8-9655-abd022fb838d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-160374/selection" :answer-field/id #uuid "8c7f1735-e4ea-57b4-b36c-82e173ec4951" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160374/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" :answer-field/choices ["q-160374/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-160374/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-160374/selection/1e5815fe88f764dcffb6e1d4884bd91ce2c23cb2e4c57c2f2f99b70378aa1f23" "q-160374/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-160374/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-160374" :question/id #uuid "9ec38e30-b9a4-5c3b-89e7-0bc6ddab674a" :question/math-academy-id "q-160374" :question/problem "A triangle $S$ has vertices at $(4,-3),(2,-2),(1,3).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-\\pi }$ by an angle of $\\pi $ radians about the origin?\n\n- $(-4,3)$\n- $(-2,2)$\n- $(-1,-3)$" :question/worked-solution "The clockwise rotation ${R}_{-\\pi }$ by an angle of $\\pi $ radians is the same as counterclockwise rotation by the same angle. It's given by the matrix\n\n$$\nR=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-\\pi },$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}4 & 2 & 1 \\\\ -3 & -2 & 3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-\\pi }$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}4 & 2 & 1 \\\\ -3 & -2 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & -2 & -1 \\\\ 3 & 2 & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-4,3),(-2,2),(-1,-3).$\n\nSo, the correct answer is \"I, II, and III.\"" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-160374/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20f4ef93-3e7b-58ec-992e-3a62b12b74e2"] :knowledge-point/questions ["q-160374"] :db/ensure [:knowledge-point/validate]} {:db/id "q-160618/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "fe1156bd-ba34-57e6-82d4-076adca071a5" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-160618/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "4e81369e-a07b-5f0e-8861-2431f87e1369" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-160618/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "efe11742-d61d-5bd2-a765-ee8df2c69bef" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-160618/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "001eb2af-a482-5264-bcd2-34d157942e48" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-160618/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "698904b5-8def-56f9-808f-1f86e923f280" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-160618/selection" :answer-field/id #uuid "108ada0e-2296-5b6c-9dff-d68f0bc0682b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-160618/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer-field/choices ["q-160618/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-160618/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-160618/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-160618/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-160618/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6"] :db/ensure [:answer-field/validate]} {:db/id "q-160618" :question/id #uuid "e31cede0-51e5-5629-b2ba-9af98c0d402b" :question/math-academy-id "q-160618" :question/problem "A triangle $S$ has vertices at $(-2,-1),(2,-3),(1,5).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{180}^{∘}}$ by an angle of ${180}^{∘}$ about the origin?\n\n- $(2,1)$\n- $(-2,3)$\n- $(-1,5)$" :question/worked-solution "The counterclockwise rotation ${R}_{{180}^{∘}}$ by an angle of ${180}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{180}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 2 & 1 \\\\ -1 & -3 & 5\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{180}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-2 & 2 & 1 \\\\ -1 & -3 & 5\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 & -1 \\\\ 1 & 3 & -5\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(2,1),(-2,3),(-1,-5).$\n\nSo, the correct answer is \"I and II only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-160618/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "20f4ef93-3e7b-58ec-992e-3a62b12b74e2"] :knowledge-point/questions ["q-160618"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-12121"] :question/problem "A triangle $S$ has vertices at $(-1,-2),(-1,2),(1,1).$  Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-\\pi }$ by an angle of $\\pi $ radians about the origin?\n\n- $(1,2)$\n- $(1,-2)$\n- $(-1,-1)$" :question/worked-solution "The clockwise rotation ${R}_{-\\pi }$ by an angle of $\\pi $ radians is the same as counterclockwise rotation by the same angle. It's given by the matrix\n\n$$\nR=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-\\pi },$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 2 & 1\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-\\pi }$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}-1 & -1 & 1 \\\\ -2 & 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 1 & -1 \\\\ 2 & -2 & -1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,2),(1,-2),(-1,-1).$\n\nSo, the correct answer is \"I, II and III.\"" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-81820"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/e6741c165a0f0f50bf932dd04c6d4c1157b4f70a8dc4c63efc5416b3883124bc.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =A(i)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i \\\\ {j}^{′} & =A(j)=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}0 \\\\ -1\\end{aligned}]=-j\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/4e0e5c9cee037bded1f5739af35c3a8acfaa4d4e6f469b3e50afe69b96990e39.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/45f0ff53440247c533dd2b97ae03c8cd3e2e762b67832ce770c0bd5749e74f6e.png)" :db/ensure [:question/validate]} {:db/id "q-81821/selection/947f684b82d83610f64d21c02719d858343b19718317c71ff60cf9e8075dbd3c" :answer/id #uuid "9d347172-3243-5de5-866e-506f468645df" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/ca19bbcea3f01e99b0c606ad719686d84bca7b4dbfa1596f7b28e27fa494c44c.png" :db/ensure [:answer/validate]} {:db/id "q-81821/selection/9849732c091f63517d893f50d398fe67ee4099936218012ef8dbb56831a07725" :answer/id #uuid "b338d9f3-e6f8-5a79-94b9-8b83630f366e" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/3a7e4f6e534ec77a08e425b86d97f43535c376909c80aa6621d0061ce1127b45.png" :db/ensure [:answer/validate]} {:db/id "q-81821/selection/841737bc83968fbdf2f70e893dd6efcc98918de3f2c298a425ed075a2d8b35e2" :answer/id #uuid "44f36cf0-53cc-5efd-b66a-1f69a32be5c7" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/e6a72b4fb4a9c100996e7761407a2eb923d22f0d26832964bea2d4d6e3c90f2e.png" :db/ensure [:answer/validate]} {:db/id "q-81821/selection/fd305d8964173474b63d4cbfba796d21f532e05e1621c94d6b8d670cb6c17c02" :answer/id #uuid "322cc891-ef7a-57e6-a11d-9d8e2d3c1766" :answer/type :answer.type/image :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039248/assets/f84c512bb1c78f49fe4f6711a1b4c7ca937befdb7993939e2eb94577f20ee057.png" :db/ensure [:answer/validate]} {:db/id "q-81821/selection/3c58cb1581bdafd3b78b721aa61bacd3fd58c7b0626046b55dc933f330f5660e" :answer/id #uuid "23e6b633-cb58-5313-8cfc-a3247e