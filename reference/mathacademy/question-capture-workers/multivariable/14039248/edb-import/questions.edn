Academy/reference/mathacademy/question-capture/14033087/assets/9fae3ec0ada3008937d88e4e76374a56da4369b1821cfee072c90d88b562df46.png)\n\nSo, the matrix represents a rotation of $\\pi $ radians (counterclockwise or clockwise) about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ (counterclockwise or clockwise) by an angle of $\\pi $ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/ae800b271848948b5f60f5cd7c1cecd163c2aa7399e9a87e2a52d158857c6a42.png)"}] [{:db/id #edb/ref 17592186293897 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a451e005-9920-55ba-aba2-4a82df7fdc89" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/4a78a3e98da4c602b4e8a2ebbe8860f75e507ec2ec5c20df0e59100f96a099ac.png" :db/id #edb/ref 17592186293899} {:answer/id #uuid "12c5a080-b22a-52c1-9b3c-1e3a4833e96d" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/cf86cad03c80018ac3976a64780650c827d7c93a0889286c711c5aa69d2b899f.png" :db/id #edb/ref 17592186293900} {:answer/id #uuid "1bef1177-6e7a-54d6-8454-e86c89efdb92" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/f2beba76039ead47c83c93aaad5f9c4717a4abd2b803e65157f23d770f4f9181.png" :db/id #edb/ref 17592186293901} {:answer/id #uuid "4504772e-8da4-5cff-a3c3-c6172ca608b2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/3edafbd6273f8058114c606c8b2a288e52b348d560867b6ea90e8b981b486904.png" :db/id #edb/ref 17592186293902} {:answer/id #uuid "5e6b05d3-925f-5dad-adbd-f539eb186ef1" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/82091407834f5d7aa8caf6e01cb800a3f7b1999cb0c6e568c899d43479b1d7a3.png" :db/id #edb/ref 17592186293903}] :answer-field/correct {:answer/id #uuid "a451e005-9920-55ba-aba2-4a82df7fdc89" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/4a78a3e98da4c602b4e8a2ebbe8860f75e507ec2ec5c20df0e59100f96a099ac.png" :db/id #edb/ref 17592186293899} :answer-field/id #uuid "2c52ba30-782e-5f65-9f49-6868e4cb05f7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186293898}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "efaa3158-b486-5ce8-9ecd-d7b2e13036d3" :question/math-academy-id "q-160621" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/b75a7519c7953b7a3c5bd5b5e61e961ca26c3f0dc9e1aab32bf2c639dd95325f.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that \n\n$$\nA=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$" :question/worked-solution "Consider the standard basis ${i,j}$ of the Euclidean plane ${R}^{2}$ and the unit square spanned by the vectors. Computing the images of ${i,j}$ under $A$, we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/f154267ed0a528b1e9fbec40064b090560410fe76dab00070e13fb3d1978b59c.png)\n\nSo, the matrix represents a rotation of $\\frac{\\pi }{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14033087/assets/8ea257c65769c4d6f67f55ce6533c1bfdfe45debcf1ba532b9ec3f717238507a.png)"}] [{:db/id #edb/ref 17592186283683 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "533fe1e0-736f-56d4-808f-c1d14b2743d8" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186283685} {:answer/id #uuid "1dceeb35-0cb2-5a43-8e49-86d4583f28b7" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186283686} {:answer/id #uuid "c7eb0977-8a2d-5218-b250-3fa7d83eb3ba" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186283687} {:answer/id #uuid "d5c0cc42-8a0b-5c9c-ac44-596917ab7319" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186283688} {:answer/id #uuid "3d16dded-e01f-512b-b59e-d410e6956f17" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283689}] :answer-field/correct {:answer/id #uuid "1dceeb35-0cb2-5a43-8e49-86d4583f28b7" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186283686} :answer-field/id #uuid "bd86fb08-e9a6-50ff-89b2-48d975d8101e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283684}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "37ce60a1-7ee2-5ebe-8858-c59ff464ba06" :question/math-academy-id "q-160643" :question/problem "A triangle $S$ has vertices at $(0,1),(-1,0),(-1,-2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(1,0)$\n- $(0,-1)$\n- $(-2,1)$" :question/worked-solution "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & -2 \\\\ 0 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,0),(0,1),(-2,1).$\n\nSo, the correct answer is \"I and III only.\""}] [{:db/id #edb/ref 17592186283690 :knowledge-point/_questions [{:knowledge-point/id #uuid "1b86558a-4c99-5ccb-a100-719692a056f4" :knowledge-point/title "Using a Matrix That Represents a Rotation of 90 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23b8cce3-342c-5d43-9666-d1f16ea5ef6d" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186283692} {:answer/id #uuid "3da4c708-2c9b-5200-b8c9-1c381670eedf" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186283693} {:answer/id #uuid "c6666819-cfa2-5225-956a-905d8b63b19f" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186283694} {:answer/id #uuid "9cbb4d98-4041-5882-8d32-a049dad37879" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186283695} {:answer/id #uuid "0a85f801-e304-50a1-bbb5-53fc60815182" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283696}] :answer-field/correct {:answer/id #uuid "0a85f801-e304-50a1-bbb5-53fc60815182" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283696} :answer-field/id #uuid "2701afd1-8c74-50cf-8cb6-61b818707a0a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283691}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4f78fbb4-97dc-56c5-a843-630741ba1e9e" :question/math-academy-id "q-160645" :question/problem "A triangle $S$ has vertices at $(-3,1),(1,-4),(1,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{90}^{∘}}$ by an angle of ${90}^{∘}$ about the origin?\n\n- $(-1,3)$\n- $(4,1)$\n- $(0,-1)$" :question/worked-solution "The counterclockwise rotation ${R}_{{90}^{∘}}$ by an angle of ${90}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{90}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}\\,-3 & 1 & 1 \\\\ 1 & \\,\\,\\,-4 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{90}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}\\,-3 & 1 & 1 \\\\ 1 & \\,\\,\\,-4 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 4 & 0 \\\\ -3 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-1,-3),(4,1),(0,1).$\n\nSo, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186092773 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "88da30c2-feaa-5d94-9c98-e41fd1ed9ea5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/931/Source/Images/q-81450-a-2.png" :db/id #edb/ref 17592186091104} {:answer/id #uuid "93a9126c-4c6c-5b2d-95c6-cfed9b180113" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/931/Source/Images/q-81450-a-1.png" :db/id #edb/ref 17592186091105} {:answer/id #uuid "fb9a95e0-ae9b-5161-a560-ee947bd76206" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/931/Source/Images/q-81450-a-5.png" :db/id #edb/ref 17592186091106} {:answer/id #uuid "02bb3447-584b-5dae-af10-da7e71bffad2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/931/Source/Images/q-81450-a-3.png" :db/id #edb/ref 17592186091107} {:answer/id #uuid "7c486708-be44-5f4c-a56a-3f4c2807527c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/931/Source/Images/q-81450-a-4.png" :db/id #edb/ref 17592186091108}] :answer-field/correct {:answer/id #uuid "93a9126c-4c6c-5b2d-95c6-cfed9b180113" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/931/Source/Images/q-81450-a-1.png" :db/id #edb/ref 17592186091105} :answer-field/id #uuid "e6cb8394-67d6-5bcb-a291-d8c3a2f43b72" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091103}] :question/id #uuid "be344c11-b1a1-5df9-959f-34ab811cf29b" :question/math-academy-id "q-81450" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/931/Source/Images/q-81450.png)\n\nConsider the vector $v$ shown above. Find the vector $Av$ given that\n$A = \\begin{bmatrix}0 & -1 \\\\ 1 & 0\\end{bmatrix}$."}] [{:db/id #edb/ref 17592186283711 :knowledge-point/_questions [{:knowledge-point/id #uuid "20f4ef93-3e7b-58ec-992e-3a62b12b74e2" :knowledge-point/title "Using a Matrix That Represents a Rotation of 180 Degrees"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "583eebc8-9b82-554d-b2de-5c335db960f9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186283713} {:answer/id #uuid "5ae11bac-66c8-5798-8fa5-a2f753aa3798" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186283714} {:answer/id #uuid "ed32353d-285a-581f-84a7-665c32f26c9e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186283715} {:answer/id #uuid "14e4b63d-27b0-5e04-a172-a0cd24c58b38" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186283716} {:answer/id #uuid "341b1054-3b59-571d-b0bb-be4696fb5426" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186283717}] :answer-field/correct {:answer/id #uuid "583eebc8-9b82-554d-b2de-5c335db960f9" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186283713} :answer-field/id #uuid "b3733fa4-37ac-5b8e-8d55-f9b595ba5660" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283712}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "4efc51d3-b393-57b6-8514-a14b7c1d9942" :question/math-academy-id "q-81819" :question/problem "A triangle $S$ has vertices at $(4,4),(-3,-3),(-1,7).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{180}^{∘}}$ by an angle of ${180}^{∘}$ about the origin?\n\n- $(3,-3)$\n- $(-4,-4)$\n- $(1,-7)$" :question/worked-solution "The counterclockwise rotation ${R}_{{180}^{∘}}$ by an angle of ${180}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{180}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}4 & -3 & -1 \\\\ 4 & -3 & 7\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{180}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}4 & -3 & -1 \\\\ 4 & -3 & 7\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 3 & 1 \\\\ -4 & 3 & -7\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-4,-4),(3,3),(1,-7).$\n\nSo, the correct answer is \"II and III only.\""}] [{:db/id #edb/ref 17592186283718 :knowledge-point/_questions [{:knowledge-point/id #uuid "b4df33ff-e04e-55ec-b273-9eceff7db53b" :knowledge-point/title "Identifying Rotation Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27b5f433-bd4e-5f65-b834-ac07a468506c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/ca19bbcea3f01e99b0c606ad719686d84bca7b4dbfa1596f7b28e27fa494c44c.png" :db/id #edb/ref 17592186283720} {:answer/id #uuid "f2233722-a9fc-5e5b-8758-4ebf4e5d9785" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/90dcf60e19c9031927df68a1d0be6b85c47910e6ec92e9052c292f667971d7f1.png" :db/id #edb/ref 17592186283721} {:answer/id #uuid "6e76ce5f-f648-553e-a359-f4b73443423f" :answer/type {:db/ident :answer.type/image} :