/13991115/assets/90dcf60e19c9031927df68a1d0be6b85c47910e6ec92e9052c292f667971d7f1.png"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" nil "attribute" "question/problem" "value" "A triangle $S$ has vertices at $(0,1),(-1,0),(-1,-2).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(1,0)$\n- $(0,-1)$\n- $(-2,1)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" nil "attribute" "question/worked-solution" "value" "The counterclockwise rotation ${R}_{{270}^{∘}}$ by an angle of ${270}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}0 & -1 & -1 \\\\ 1 & 0 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 0 & -2 \\\\ 0 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,0),(0,1),(-2,1).$\n\nSo, the correct answer is \"I and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/activity-metadata.json" "file_sha256" "31c2feb4266eff72b427e01802c275f867994df67b826b638bbbd5094a9a83ca" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "II and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160643" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "I and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" nil "attribute" "question/problem" "value" "A triangle $S$ has vertices at $(-3,1),(1,-4),(1,0).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the counterclockwise rotation ${R}_{{90}^{∘}}$ by an angle of ${90}^{∘}$ about the origin?\n\n- $(-1,3)$\n- $(4,1)$\n- $(0,-1)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" nil "attribute" "question/worked-solution" "value" "The counterclockwise rotation ${R}_{{90}^{∘}}$ by an angle of ${90}^{∘}$ is given by the matrix\n\n$$\nR=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{{90}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}\\,-3 & 1 & 1 \\\\ 1 & \\,\\,\\,-4 & 0\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{{90}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}\\,-3 & 1 & 1 \\\\ 1 & \\,\\,\\,-4 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 4 & 0 \\\\ -3 & 1 & 1\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(-1,-3),(4,1),(0,1).$\n\nSo, the correct answer is \"II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/activity-metadata.json" "file_sha256" "31c2feb4266eff72b427e01802c275f867994df67b826b638bbbd5094a9a83ca" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "II and III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "III only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-160645" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/state.json" "file_sha256" "5f82fa702c211b046081b0fcaee8c5a347d50545af66c632d5e643818e7988a1" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "e-5458" "field" nil "attribute" "question/problem" "value" "A triangle $S$ has vertices at $(2,-1), (-3,5),$ and $(4,-3).$  Which of the following are coordinates of the vertices of $S',$ the image of $S$ under the counterclockwise rotation $\\mathbf{R}_{\\pi}$ by an angle of $\\pi$ radians about the origin?\n\n- $(-2,1)$\n\n- $(-4,3)$\n\n- $(-5,3)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/example-5458.json" "file_sha256" "61938044688b7fc932764702198ebe6a6a6d2cd660696f668f9734838de81e0f" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "e-5458" "field" nil "attribute" "question/worked-solution" "value" "The counterclockwise rotation $\\mathbf{R}_{\\pi}$ by an angle of $\\pi$ radians is given by the matrix\n\n$$\n[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}]\n$$\n\nTo find the image of $S$ under the action of $\\mathbf{R}_{\\pi},$ we first create a matrix $X$ containing all of the vertices of $S$ as columns:\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}2 & -3 & 4 \\\\ -1 & 5 & -3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under $\\mathbf{R}_{\\pi}$ by calculating the matrix product $RX\\mathbin{:}$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}-1 & 0 \\\\ 0 & -1\\end{aligned}][\\begin{aligned}2 & -3 & 4 \\\\ -1 & 5 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 3 & -4 \\\\ 1 & -5 & 3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $S'$ are $(-2,1), (3,-5), (-4,3).$\n\nSo, the correct answer is \"I and II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/example-5458.json" "file_sha256" "61938044688b7fc932764702198ebe6a6a6d2cd660696f668f9734838de81e0f" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "e-7186" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/a43a1658a16151c0306702959c50e8d0288077983ad50a084b39703e206469c0.png)\n\nConsider the vector $\\mathbf{v}$ shown above. Find the vector $A\\mathbf{v}$ given that \n\n$$\n[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}]\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/example-7186.json" "file_sha256" "480e292c46ad0d9bd280e35cb7f315305674491365dbe0403592b82c66b9390a" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "e-7186" "field" nil "attribute" "question/worked-solution" "value" "Consider the standard basis $\\{ \\mathbf{i},\\mathbf{j} \\}$ of the Euclidean plane $\\mathbb{R}^2$ and the unit square spanned by the vectors. Computing the images of $\\{ \\mathbf{i},\\mathbf{j} \\}$ under $A,$ we get the following:\n\n$$\n\\begin{aligned}{i}^{′} & =Ai=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}1 \\\\ 0\\end{aligned}]=[\\begin{aligned}0 \\\\ 1\\end{aligned}]=j \\\\ {j}^{′} & =Aj=[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 \\\\ 1\\end{aligned}]=[\\begin{aligned}-1 \\\\ 0\\end{aligned}]=-i\\end{aligned}\n$$\n\nAs a result, we obtain the following diagram:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/414cb72ff004fe4c5898a0e2c7b60b4b3651473e776388fad21efd8fc9ae6165.png)\n\nSo, the matrix represents a rotation of $\\dfrac{\\pi}{2}$ radians counterclockwise about the origin.\n\nTherefore, in order to find $A\\mathbf{v},$ we need to rotate $\\mathbf{v}$ counterclockwise by an angle of $\\dfrac{\\pi}{2}$ radians, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/assets/b24d8d460b7833a49f2bd7183f0f4b5d22d94a7d3b1d3bb9eb51beff9eeb7ef6.png)" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/example-7186.json" "file_sha256" "480e292c46ad0d9bd280e35cb7f315305674491365dbe0403592b82c66b9390a" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "e-5457" "field" nil "attribute" "question/problem" "value" "A triangle $S$ has vertices at  $(-5,-1), (1,4), (3,-5).$ Which of the following are coordinates of the vertices of $S',$ the image of $S$ under the **clockwise** rotation $\\mathbf{R}_{-90^\\circ}$ by an angle of $90^\\circ$ about the origin?\n\n- $(1,-5)$\n\n- $(4,-1)$\n\n- $(-5,-3)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/example-5457.json" "file_sha256" "23ae715fa99013cbdce0d1c2f6ca84550bc2b34f1788a319a5d06af8a8d4845f" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "e-5457" "field" nil "attribute" "question/worked-solution" "value" "The clockwise rotation $\\mathbf{R}_{-90^\\circ}$ by an angle of $90^\\circ$ is the same as counterclockwise rotation by an angle of $270^\\circ.$ It's given by the matrix\n\n$$\n[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}]\n$$\n\nTo find the image of $S$ under the action of $\\mathbf{R}_{-90^\\circ},$ we first create a matrix $X$ containing all of the vertices of $S$ as columns:\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-5 & 1 & 3 \\\\ -1 & 4 & -5\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under $\\mathbf{R}_{-90^\\circ}$ by calculating the matrix product $RX\\mathbin{:}$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & 1 \\\\ -1 & 0\\end{aligned}][\\begin{aligned}-5 & 1 & 3 \\\\ -1 & 4 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}-1 & 4 & -5 \\\\ 5 & -1 & -3\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $S'$ are $(-1,5), (4,-1), (-5,-3).$\n\nSo, the correct answer is \"II and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/example-5457.json" "file_sha256" "23ae715fa99013cbdce0d1c2f6ca84550bc2b34f1788a319a5d06af8a8d4845f" "basis" 1023 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991115/edb-import/verification.json"} {"question" "q-12124" "field" nil "attribute" "question/problem" "value" "A triangle $S$ has vertices at  $(-2,-1),(1,3),(2,-3).$ Which of the following are coordinates of the vertices of ${S}^{′},$ the image of $S$ under the **clockwise** rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ about the origin?\n\n- $(-3,1)$\n- $(-3,2)$\n- $(1,-2)$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/state.json" "file_sha256" "f07b529fcc489010236892ec02a2f855802235483748b56921c87bff17bae15d" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/edb-import/verification.json"} {"question" "q-12124" "field" nil "attribute" "question/worked-solution" "value" "The clockwise rotation ${R}_{-{270}^{∘}}$ by an angle of ${270}^{∘}$ is the same as counterclockwise rotation by an angle of ${90}^{∘}.$ It's given by the matrix\n\n$$\nR[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nTo find the image of $S$ under the action of ${R}_{-{270}^{∘}},$ we first create a matrix $X$ containing all of the vertices of $S:$\n\n$$\n\\begin{aligned}X & =[\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}]\\end{aligned}\n$$\n\nNow, we compute the image of $X$ under ${R}_{-{270}^{∘}}$ by calculating the matrix product $RX:$\n\n$$\n\\begin{aligned}RX & =[\\begin{aligned}0 & -1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}-2 & 1 & 2 \\\\ -1 & 3 & -3\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -3 & 3 \\\\ -2 & 1 & 2\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of ${S}^{′}$ are $(1,-2),(-3,1),(3,2).$\n\nSo, the correct answer is \"I and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/state.json" "file_sha256" "f07b529fcc489010236892ec02a2f855802235483748b56921c87bff17bae15d" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/edb-import/verification.json"} {"question" "q-12124" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/activity-metadata.json" "file_sha256" "d5412300abaf3d9cfe40c7fe60724db3bf41b03e257c8e1c9aa4b8a19eb15cd3" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/edb-import/verification.json"} {"question" "q-12124" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/state.json" "file_sha256" "f07b529fcc489010236892ec02a2f855802235483748b56921c87bff17bae15d" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/edb-import/verification.json"} {"question" "q-12124" "field" "selection" "attribute" "answer/value" "value" [:answer.type/text "I and II only"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14003089/state.json" "file_sha256" "f07b529fcc489010236892ec02a2f855802235483748b56921c87bff17bae15d" "basis" 1083 "verification" "/home/jake/Developer/Course_Academy/referenc