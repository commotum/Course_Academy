-6)^{2}}{{3}^{2}}+\\frac{(y-0)^{2}}{{6}^{2}} & =1 \\\\ \\frac{(x-6)^{2}}{9}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-278395" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/activity-metadata.json" "file_sha256" "978ad4aecbb5087179a1a9a0986edf59e95f7dc95ee797b6f0b5822accb9c3f1"} {"question" "q-278395" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-278395" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{(x-6)^2}{9}+\\frac{y^2}{36}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-278254" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/assets/65a76a438b3459a92db0e00b0c9bd281b8a9c58fa68afd2d8e6468a1d99b1cf9.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-278254" "field" nil "attribute" "question/worked-solution" "value" "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(-1,-3),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-(-1))^{2}}{{2}^{2}}+\\frac{(y-(-3))^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x+1)^{2}}{4}+\\frac{(y+3)^{2}}{16} & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-278254" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/activity-metadata.json" "file_sha256" "978ad4aecbb5087179a1a9a0986edf59e95f7dc95ee797b6f0b5822accb9c3f1"} {"question" "q-278254" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-278254" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{(x+1)^2}{4}+\\frac{(y+3)^2}{16}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-7627" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/assets/2ab9745cb9d157e566c101a6ca79514017903fa57eaf8725c846afd272c74f93.png)\n\nWhat is the equation of the ellipse given above?" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-7627" "field" nil "attribute" "question/worked-solution" "value" "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(3,-1),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=4.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{{2}^{2}}+\\frac{(y-(-1))^{2}}{{4}^{2}} & =1 \\\\ \\frac{(x-3)^{2}}{4}+\\frac{(y+1)^{2}}{16} & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/state.json" "file_sha256" "583d196f49dcc52efd388e346e3d5f96473286b07fef0c6c4141991ce4beb062"} {"question" "q-7627" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/activity-metadata.json" "file_sha256" "978ad4aecbb5087179a1a9a0986edf59e95f7dc95ee797b6f0b5822accb9c3f1"} {"question" "q-7627" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/referen