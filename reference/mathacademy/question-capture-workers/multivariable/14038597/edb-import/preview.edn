484dc6f4" 13194139534629 true] [17592186299769 1017 #edb/ref 17592186299770 13194139534629 true] [17592186299769 1089 "q-278395" 13194139534629 true] [17592186299769 1091 #edb/ref 17592186045463 13194139534629 true] [17592186299769 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/assets/33adaa159f0926038c6b04a750b6a61b8a18e0fe2df9c6c3c581c139e27b2c95.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" 13194139534629 true] [17592186299769 1113 #uuid "ce98f2e0-6ed9-52bc-9c0e-fcc399b98190" 13194139534629 true] [17592186299769 1145 "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(6,0),$ the horizontal radius has length $a=3,$ and the vertical radius has length $b=6.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-6)^{2}}{{3}^{2}}+\\frac{(y-0)^{2}}{{6}^{2}} & =1 \\\\ \\frac{(x-6)^{2}}{9}+\\frac{{y}^{2}}{36} & =1.\\end{aligned}\n$$" 13194139534629 true] [17592186299770 1000 #edb/ref 17592186299771 13194139534629 true] [17592186299770 1000 #edb/ref 17592186299772 13194139534629 true] [17592186299770 1040 #edb/ref 17592186045449 13194139534629 true] [17592186299770 1041 "field-1" 13194139534629 true] [17592186299770 1104 #edb/ref 17592186299771 13194139534629 true] [17592186299770 1110 #uuid "f5013c2c-4868-59d0-a27b-a2c9a4548036" 13194139534629 true] [17592186299771 1034 "\\frac{(x-6)^2}{9}+\\frac{y^2}{36}" 13194139534629 true] [17592186299771 1103 #edb/ref 17592186045453 13194139534629 true] [17592186299771 1111 #uuid "22deb66e-5e78-5951-be4f-1ae2ffda1c5d" 13194139534629 true] [17592186299772 1034 "\\frac{(x-6)^2}{36}+\\frac{y^2}{9}" 13194139534629 true] [17592186299772 1103 #edb/ref 17592186045453 13194139534629 true] [17592186299772 1111 #uuid "98f379a7-0954-5831-9002-4189e49954cd" 13194139534629 true] [17592186299773 1017 #edb/ref 17592186299774 13194139534629 true] [17592186299773 1089 "q-278398" 13194139534629 true] [17592186299773 1091 #edb/ref 17592186045463 13194139534629 true] [17592186299773 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038597/assets/441ee336bc10f5787a5956a6c118cde9faaa0485c3c2f8a6adb9dd93903b3972.png)\n\nWhat is the equation of the ellipse given above?\n\n{{field-1}}$=1$" 13194139534629 true] [17592186299773 1113 #uuid "961e5475-3c5e-59e1-82c7-c4526ff0e464" 13194139534629 true] [17592186299773 1145 "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nHere, the ellipse is centered at $(0,5),$ the horizontal radius has length $a=2,$ and the vertical radius has length $b=3.$ Therefore, the equation of the ellipse is\n\n$$\n\\begin{aligned}\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}} & =1 \\\\ \\frac{(x-0)^{2}}{{2}^{2}}+\\frac{(y-5)^{2}}{{3}^{2}} & =1 \\\\ \\frac{{x}^{2}}{4}+\\frac{(y-5)^{2}}{9} & =1.\\end{aligned}\n$$" 13194139534629 true] [17592186299774 1000 #edb/ref 17592186299775 13194139534629 true] [17592186299774 1000 #edb/ref 17592186299776 13194139534629 true] [17592186299774 1040 #edb/ref 17592186045449 13194139534629 true] [17592186299774 1041 "field-1" 13194139534629 true] [17592186299774 1104 #edb/ref 17592186299776 13194139534629 true] [17592186299774 1110 #uuid "f1fe4127-c821-51ee-8e22-dec017dc030f" 13194139534629 true] [17592186299775 1034 "\\frac{x^2}{4}+\\frac{(y+5)^2}{9}" 13194139534629 true] [17592186299775 1103 #edb/ref 17592186045453 13194139534629 true] [17592186299775 1111 #uuid "58fa4f7e-e9fc-51fe-ade5-af17c2a43bfd" 13194139534629 true] [17592186299776 1034 "\\frac{x^2}{4}+\\frac{(y-5)^2}{9}" 13194139534629 true] [17592186299776 1103 #edb/ref 17592186045453 13194139534629 true] [17592186299776 1111 #uuid "cfa01e02-6c59-5363-9f3d-27a697e45447" 13194139534629 true] [17592186299777 1034 "7" 13194139534629 true] [17592186299777 1103 #edb/ref 17592186045453 13194139534629 true] [17592186299777 1111 #uuid "b3b18822-8955-5d83-a983-ce01e53b13ba" 13194139534629 true] [17592186299778 1017 #edb/ref 17592186299779 13194139534629 true] [17592186299778 1017 #edb/ref 17592186299781 13194139534629 true] [17592186299778 1089 "q-278403" 13194139534629 true] [17592186299778 1091 #edb/ref 17592186045465 13194139534629 true] [17592186299778 1100 "For the ellipse $\\frac{(x-1)^{2}}{15}+\\frac{(y-6)^{2}}{49}=1,$ find the lengths of its major and minor axes.\n\n$\\,$ The length of the major axis is \n{{field-1}}.\n\n$\\,$ The length of the minor axis is \n{{field-2}}." 13194139534629 true] [17592186299778 1113 #uuid "96ae2185-6307-5de4-8916-3673bdc7e5d3" 13194139534629 true] [17592186299778 1145 "Remember that the general equation of an ellipse centered at $(h,k)$ with a horizontal radius of length $a$ and a vertical radius of length $b$ is given by\n\n$$\n\\frac{(x-h)^{2}}{{a}^{2}}+\\frac{(y-k)^{2}}{{b}^{2}}=1.\n$$\n\n \n\nIn the given equation, we have $h=1$ and $k=6,$ so the center is located at $(1,6).$\n\nIn the given equation, we also have ${a}^{2}=15$ and ${b}^{2}=49.$\n\n- Since ${a}^{2}=15,$ the length of the horizontal radius must be $a=\\sqrt{15}.$\n\n- Since ${b}^{2}=49,$ the length of the vertical radius must be $b=\\sqrt{49}=7.$\n\nSo the semi-major axis has length $b=7,$ and the semi-minor axis has length $a=\\sqrt{15}.$\n\nTherefore, the major axis has length $2b=2\\cdot 7=14,$ and the minor axis has length $2a=2\\cdot \\sqrt{15}=2\\sqrt{15}.$" 13194139534629 true] [17592186299779 1000 #edb/ref 17592186299780 13194139534629 true] [17592186299779 1040 #edb/ref 17592186045449 13194139534629 true] [17592186299779 