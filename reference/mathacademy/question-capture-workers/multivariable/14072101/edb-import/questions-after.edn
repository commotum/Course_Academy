eal Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63699e4a-1d91-58dc-b5ec-c9f876020eaa" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186374411} {:answer/id #uuid "d58e5d4c-ec6a-5a0d-8ce7-de004358315b" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements give a partition of $[-3,7]$" :db/id #edb/ref 17592186374412} {:answer/id #uuid "665e065f-8301-5856-98b1-18a0a03e152a" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186374413} {:answer/id #uuid "69f4a99e-b58a-531b-a5bd-249359bd1750" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186374414} {:answer/id #uuid "8da35a66-fed4-5c8c-8731-02f1468c30c0" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186374415}] :answer-field/correct {:answer/id #uuid "665e065f-8301-5856-98b1-18a0a03e152a" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186374413} :answer-field/id #uuid "d1196a67-37e5-56cc-80f3-ccbb89847c57" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374410}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "38e18c22-0d10-5bd8-9bb1-b67243431b28" :question/math-academy-id "q-122937" :question/problem "Which of the following are partitions of the real interval $[-3,7]?$\n\n- ${-3,-5,1,2,6}$\n- ${-3,0,3,7,8}$\n- ${-3,-2,1,3,4,7}$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[-3,7]$ since it does not include the right endpoint $b=7.$\n\n- Statement II is not a partition of $[-3,7]$ since $8$ does not belong to $[-3,7].$\n\n- Statement III is a partition of $[-3,7].$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186374416 :knowledge-point/_questions [{:knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4703da73-27e9-5124-ac19-47b14eb2cbc8" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements give a partition of $[0,4]$" :db/id #edb/ref 17592186374418} {:answer/id #uuid "3067162a-79fa-5321-b834-81b4aa2acd5b" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186374419} {:answer/id #uuid "83214b58-8a81-536b-bbf3-888499b14c07" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186374420} {:answer/id #uuid "14ea9cfc-c7cd-5b24-a55d-73411d7d0fb2" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186374421} {:answer/id #uuid "f54e2c75-fa11-5268-8dde-343d9fb9219e" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186374422}] :answer-field/correct {:answer/id #uuid "83214b58-8a81-536b-bbf3-888499b14c07" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186374420} :answer-field/id #uuid "057cba8f-4ae2-5144-a3bf-4593abbf4d10" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374417}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fc0905cc-8f09-5d01-9f83-706838bde9af" :question/math-academy-id "q-122938" :question/problem "Which of the following are partitions of the real interval $[0,4]?$\n\n- $0<0.5<1.5<2.5<4<4.5$\n- ${0,1,2,3.9}$\n- $0<0.1<1.5<2.5<4$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[0,4]$  since $4.5$ does not belong to $[0,4].$\n\n- Statement II is not a partition of $[0,4]$  since it does not include the left endpoint $a=4.$\n\n- Statement III is  a partition of  $[0,4].$\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186374423 :knowledge-point/_questions [{:knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320" :knowledge-point/title "Identifying Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f968a12-70a4-526c-aeee-e6f78a66955e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186374425} {:answer/id #uuid "c285c1f0-0e80-5781-8c58-110bf879ff87" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186374426} {:answer/id #uuid "4620a9ff-63e2-5485-a003-4eb3b4b91170" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186374427} {:answer/id #uuid "2a6b7f94-23ac-5492-87df-51bb0f3f046b" :answer/type {:db/ident :answer.type/text} :answer/value "None of the statements give a partition of $[-1,1]$" :db/id #edb/ref 17592186374428} {:answer/id #uuid "1e3a9754-e4e6-553d-9bdc-fc3c47535ee3" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186374429}] :answer-field/correct {:answer/id #uuid "4f968a12-70a4-526c-aeee-e6f78a66955e" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186374425} :answer-field/id #uuid "645cbe52-db3e-5131-abba-f07561df4245" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374424}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "9d42fa6f-9c63-5f36-99ad-1e6b6c114b50" :question/math-academy-id "q-122954" :question/problem "Which of the following are partitions of the real interval $[-1,1]?$\n\n- $-1<0<\\frac{1}{2}<1$\n- ${-2,-1,0,1}$\n- ${-1,0,2}$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is a partition of $[-1,1].$\n\n- Statement II is not a partition of $[-1,1]$ since $-2$ does not belong to $[-1,1].$\n\n- Statement III is not a partition of  $[-1,1]$ since $2$ does not belong to $[-1,1].$\n\nTherefore, the correct answer is \"I only\"."}] [{:db/id #edb/ref 17592186374430 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c91d51f-39b4-547a-971b-9c2dada9eb47" :knowledge-point/title "Computing Simple Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5888b0ba-9bce-598c-9ca1-e6d31db1af6e" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186374432} {:answer/id #uuid "d76344d4-ccd1-5302-ac21-25da8de5203a" :answer/type {:db/ident :answer.type/math} :answer/value "15" :db/id #edb/ref 17592186374433} {:answer/id #uuid "47758275-b7ab-5356-b0bf-31676720404c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186374434} {:answer/id #uuid "76fb3b57-6c94-5aa3-b2cc-ff7921cf58ea" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374435} {:answer/id #uuid "977b3473-1e9a-52c3-84bb-2a63d9f2380b" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186374436}] :answer-field/correct {:answer/id #uuid "47758275-b7ab-5356-b0bf-31676720404c" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186374434} :answer-field/id #uuid "fe483357-5dc8-597d-8d9b-624ce4cb4459" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374431}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "38bea492-5700-5868-9b17-34a91ec6a822" :question/math-academy-id "q-122973" :question/problem "Let $P={{x}_{0},{x}_{1},…,{x}_{m}}$ be a partition of the interval $[4,11].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}Δ{x}_{i}.$" :question/worked-solution "Note that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[4,11],$ because\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =({x}_{1}-{x}_{0})+({x}_{2}-{x}_{1})+({x}_{3}-{x}_{2})+⋯+({x}_{m}-{x}_{m-1}) \\\\  & =(\\cancel{{x}_{1}}-{x}_{0})+(\\cancel{{x}_{2}}-\\cancel{{x}_{1}})+(\\cancel{{x}_{3}}-\\cancel{{x}_{2}})+⋯+({x}_{m}-\\cancel{{x}_{m-1}}) \\\\  & =-{x}_{0}+{x}_{m} \\\\  & ={x}_{m}-{x}_{0} \\\\  & =11-4 \\\\  & =7.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374437 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c91d51f-39b4-547a-971b-9c2dada9eb47" :knowledge-point/title "Computing Simple Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0ed04bd5-c0e6-5e3f-82e5-25e72183097c" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186374439} {:answer/id #uuid "f434cdf7-57dc-5390-aa53-3166cae8785e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186374440} {:answer/id #uuid "8be75581-6cba-5c21-b269-ff75596b6dd4" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186374441} {:answer/id #uuid "2d2c8da4-e337-588b-b26c-9b5ee632164f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374442} {:answer/id #uuid "84aa126f-bc95-589e-9c9e-ca9ba557c32d" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186374443}] :answer-field/correct {:answer/id #uuid "2d2c8da4-e337-588b-b26c-9b5ee632164f" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186374442} :answer-field/id #uuid "51218c0c-3b8e-5367-8c27-b51a9ee44967" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374438}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "32ec3bc7-fdd6-5891-8708-3ccd6e143548" :question/math-academy-id "q-122976" :question/problem "Let $P={{z}_{0},{z}_{1},…,{z}_{q}}$ be a partition of the interval $[-7,-1].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}Δ{z}_{k}.$" :question/worked-solution "Note that ${\\sum }_{k=1}^{q}Δ{z}_{k}$ is just the length of the interval $[-7,-1],$ because\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}Δ{z}_{k} & =({z}_{1}-{z}_{0})+({z}_{2}-{z}_{1})+({z}_{3}-{z}_{2})+⋯+({z}_{q}-{z}_{q-1}) \\\\  & =(\\cancel{{z}_{1}}-{z}_{0})+(\\cancel{{z}_{2}}-\\cancel{{z}_{1}})+(\\cancel{{z}_{3}}-\\cancel{{z}_{2}})+⋯+({z}_{q}-\\cancel{{z}_{q-1}}) \\\\  & =-{z}_{0}+{z}_{q} \\\\  & ={z}_{q}-{z}_{0} \\\\  & =(-1)-(-7) \\\\  & =7-1 \\\\  & =6.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374444 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c91d51f-39b4-547a-971b-9c2dada9eb47" :knowledge-point/title "Computing Simple Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b7f2360e-c32b-5489-83ba-e2b19a151c6a" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186374446} {:answer/id #uuid "aa33aeed-4401-570a-a7af-d3a401dbbc5b" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186374447} {:answer/id #uuid "348d66c1-eda4-5abf-930c-6f90c5f8736f" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186374448} {:answer/id #uuid "ab1b98ea-cc2a-577b-b914-62d56db7e3c7" :answer/type {:db/ident :answer.type/math} :answer/value "36" :db/id #edb/ref 17592186374449} {:answer/id #uuid "104fde5b-2348-56c4-b72d-83fa809b09c5" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186374450}] :answer-field/correct {:answer/id #uuid "104fde5b-2348-56c4-b72d-83fa809b09c5" :answer/type {:db/ident :answer.type/math} :answer/value "-32" :db/id #edb/ref 17592186374450} :answer-field/id #uuid "e9e24d27-fc4d-5c1b-ad7c-fce17142be53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374445}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "37911f87-b989-5d3e-90cb-981f2734954c" :question/math-academy-id "q-122977" :question/problem "Let $P={{x}_{0},{x}_{1},…,{x}_{m}}$ be a partition of the interval $[2,10].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}-4Δ{x}_{i}.$" :question/worked-solution "First, we take the factor $(-4)$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}-4Δ{x}_{i}=-4{\\sum }_{i=1}^{m}Δ{x}_{i}\\end{aligned}\n$$\n\nNote that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[2,10],$ because\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =({x}_{1}-{x}_{0})+({x}_{2}-{x}_{1})+({x}_{3}-{x}_{2})+⋯+({x}_{m}-{x}_{m-1}) \\\\  & =(\\cancel{{x}_{1}}-{x}_{0})+(\\cancel{{x}_{2}}-\\cancel{{x}_{1}})+(\\cancel{{x}_{3}}-\\cancel{{x}_{2}})+⋯+({x}_{m}-\\cancel{{x}_{m-1}}) \\\\  & =-{x}_{0}+{x}_{m} \\\\  & ={x}_{m}-{x}_{0} \\\\  & =10-2 \\\\  & =8.\\end{aligned}\n$$\n\nTherefore,\n\n$$\n-4{\\sum }_{i=1}^{m}Δ{x}_{i}=(-4)\\cdot 8=-32.\n$$"}] [{:db/id #edb/ref 17592186374451 :knowledge-point/_questions [{:knowledge-point/id #uuid "6c91d51f-39b4-547a-971b-9c2dada9eb47" :knowledge-point/title "Computing Simple Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edc96f63-68b6-574b-8da8-f530913bb3be" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186374453} {:answer/id #uuid "b8dd6905-3f2d-521e-90a7-3f5f264a3918" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186374454} {:answer/id #uuid "665f44af-17e0-5004-a5ba-65e0dd89e298" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186374455} {:answer/id #uuid "fbceda53-b478-577b-a79b-e363692745e3" :answer/type {:db/ident :answer.type/math} :answer/value "42" :db/id #edb/ref 17592186374456} {:answer/id #uuid "003f0e85-1d07-5002-b1fe-af4d8282917b" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186374457}] :answer-field/correct {:answer/id #uuid "003f0e85-1d07-5002-b1fe-af4d8282917b" :answer/type {:db/ident :answer.type/math} :answer/value "35" :db/id #edb/ref 17592186374457} :answer-field/id #uuid "2ac77867-9339-57c9-8925-ec29a1ea9625" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374452}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "787c9775-c4b1-52f1-af0a-bd9395a70f3a" :question/math-academy-id "q-122979" :question/problem "Let $P={{z}_{0},{z}_{1},…,{z}_{q}}$ be a partition of the interval $[4,9].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}7Δ{z}_{k}.$" :question/worked-solution "First, we take the factor $7$ outside the summation:\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}7Δ{z}_{k}=7{\\sum }_{k=1}^{q}Δ{z}_{k}\\end{aligned}\n$$\n\nNote that ${\\sum }_{k=1}^{q}Δ{z}_{k}$ is just the length of the interval $[4,9],$ because\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}Δ{z}_{k} & =({z}_{1}-{z}_{0})+({z}_{2}-{z}_{1})+({z}_{3}-{z}_{2})+⋯+({z}_{q}-{z}_{q-1}) \\\\  & =(\\cancel{{z}_{1}}-{z}_{0})+(\\cancel{{z}_{2}}-\\cancel{{z}_{1}})+(\\cancel{{z}_{3}}-\\cancel{{z}_{2}})+⋯+({z}_{q}-\\cancel{{z}_{q-1}}) \\\\  & =-{z}_{0}+{z}_{q} \\\\  & ={z}_{q}-{z}_{0} \\\\  & =9-4 \\\\  & =5.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n7{\\sum }_{k=1}^{q}Δ{z}_{k}=7\\cdot 5=35.\n$$"}] [{:db/id #edb/ref 17592186374458 :knowledge-point/_questions [{:knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f2488cd-b772-5227-bae3-efbf13ac4862" :answer/type {:db/ident :answer.type/math} :answer/value "28" :db/id #edb/ref 17592186374460} {:answer/id #uuid "a4baa7e5-94dd-546d-8c5f-ec7328894b3a" :answer/type {:db/ident :answer.type/math} :answer/value "16" :db/id #edb/ref 17592186374461} {:answer/id #uuid "663976d6-e357-5dc5-a5ae-15f3294306aa" :answer/type {:db/ident :answer.type/math} :answer/value "21" :db/id #edb/ref 17592186374462} {:answer/id #uuid "06957e80-6ef8-59e1-a78e-ed8a78f69072" :answer/type {:db/ident :answer.type/math} :answer/value "18" :db/id #edb/ref 17592186374463} {:answer/id #uuid "d96424c9-6cd2-5a46-88d4-4b025b7e6d16" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186374464}] :answer-field/correct {:answer/id #uuid "d96424c9-6cd2-5a46-88d4-4b025b7e6d16" :answer/type {:db/ident :answer.type/math} :answer/value "24" :db/id #edb/ref 17592186374464} :answer-field/id #uuid "d474a591-ba6f-5a3f-b59b-4de9341c7299" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374459}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "50f0ed46-79de-5438-a4d9-bfca332fcb40" :question/math-academy-id "q-122984" :question/problem "Let $P={{y}_{0},{y}_{1},…,{y}_{n}}$ be a partition of the interval $[1,5].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.$" :question/worked-solution "We can simplify the given summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{y}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=1$ and ${y}_{n}=5$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{i} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={5}^{2}-{1}^{2} \\\\  & =24.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374465 :knowledge-point/_questions [{:knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9216941a-8885-56de-a118-ed0661b7976e" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186374467} {:answer/id #uuid "015befc4-0e54-5cda-88fd-b8e9948551b6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186374468} {:answer/id #uuid "036ee26e-6baa-5149-ac14-1072e00e664a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186374469} {:answer/id #uuid "d5015149-a7c0-56d4-bea9-484e8e219668" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186374470} {:answer/id #uuid "30e87b29-7877-5984-bef9-163aa0126013" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186374471}] :answer-field/correct {:answer/id #uuid "30e87b29-7877-5984-bef9-163aa0126013" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186374471} :answer-field/id #uuid "fba39ec4-264f-5106-b61b-3f4facd9e979" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374466}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e927f605-c6c3-53fd-b804-31aa5274ceef" :question/math-academy-id "q-122986" :question/problem "Let $P={{z}_{0},{z}_{1},…,{z}_{q}}$ be a partition of the interval $[-2,2].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" :question/worked-solution "We can simplify the given summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=-2$ and ${z}_{q}=2$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & ={2}^{2}-(-2)^{2} \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374472 :knowledge-point/_questions [{:knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0a517e33-27c8-537b-b554-b0829344fc79" :answer/type {:db/ident :answer.type/math} :answer/value "70" :db/id #edb/ref 17592186374474} {:answer/id #uuid "a5d3b5c1-8d43-513b-a7bd-ca67ea5212d1" :answer/type {:db/ident :answer.type/math} :answer/value "74" :db/id #edb/ref 17592186374475} {:answer/id #uuid "fb55434d-11c9-579a-9b03-0b80878466f4" :answer/type {:db/ident :answer.type/math} :answer/value "78" :db/id #edb/ref 17592186374476} {:answer/id #uuid "6184aae7-d5b6-539e-8c4c-d9ae0deed07d" :answer/type {:db/ident :answer.type/math} :answer/value "72" :db/id #edb/ref 17592186374477} {:answer/id #uuid "f1dbee7c-d030-5239-8654-6b28a7a3f8db" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186374478}] :answer-field/correct {:answer/id #uuid "f1dbee7c-d030-5239-8654-6b28a7a3f8db" :answer/type {:db/ident :answer.type/math} :answer/value "75" :db/id #edb/ref 17592186374478} :answer-field/id #uuid "b00dc8cc-47bd-5abb-ae0d-f268b7b2b1f0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374473}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9c5d330c-99be-5865-a9b7-c02497b1387b" :question/math-academy-id "q-122988" :question/problem "Let $P={{y}_{0},{y}_{1},…,{y}_{n}}$ be a partition of the interval $[5,10].$ If $Δ{y}_{j}={y}_{j}-{y}_{j-1},$ calculate ${\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j}.$" :question/worked-solution "We can simplify the given summation as follows:\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{j} & =({y}_{1}+{y}_{0})Δ{y}_{1}+({y}_{2}+{y}_{1})Δ{y}_{2}+⋯+({y}_{n}+{y}_{n-1})Δ{y}_{n} \\\\  & =({y}_{1}+{y}_{0})({y}_{1}-{y}_{0})+({y}_{2}+{y}_{1})({y}_{2}-{y}_{1})+⋯+({y}_{n}+{y}_{n-1})({y}_{n}-{y}_{n-1}) \\\\  & =({y}_{1}^{2}-{y}_{0}^{2})+({y}_{2}^{2}-{y}_{1}^{2})+⋯+({y}_{n}^{2}-{y}_{n-1}^{2}) \\\\  & =(\\cancel{{y}_{1}^{2}}-{y}_{0}^{2})+(\\cancel{{y}_{2}^{2}}-\\cancel{{y}_{1}^{2}})+⋯+({y}_{n}^{2}-\\cancel{{y}_{n-1}^{2}}) \\\\  & =-{y}_{0}^{2}+{y}_{n}^{2} \\\\  & ={y}_{n}^{2}-{y}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${y}_{0}=5$ and ${y}_{n}=10$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{j=1}^{n}({y}_{j}+{y}_{j-1})Δ{y}_{i} & ={y}_{n}^{2}-{y}_{0}^{2} \\\\  & ={10}^{2}-{5}^{2} \\\\  & =75.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186374479 :knowledge-point/_questions [{:knowledge-point/id #uuid "0f55bdc9-4066-5786-bafe-c3fdc96a06c9" :knowledge-point/title "Computing Sums Over Partitions of the Real Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84a27534-8b82-59a6-b35e-0f81bea16700" :answer/type {:db/ident :answer.type/math} :answer/value "-16" :db/id #edb/ref 17592186374481} {:answer/id #uuid "6b42bb14-69ce-5638-9395-6c34c6096d6a" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186374482} {:answer/id #uuid "92832543-05fb-5129-a7aa-e8c8027ec596" :answer/type {:db/ident :answer.type/math} :answer/value "-20" :db/id #edb/ref 17592186374483} {:answer/id #uuid "080b9100-4cb3-583b-a0c1-ebf86a00ebc0" :answer/type {:db/ident :answer.type/math} :answer/value "-28" :db/id #edb/ref 17592186374484} {:answer/id #uuid "f214d946-2e1e-59ca-83f6-0314b9cbe194" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186374485}] :answer-field/correct {:answer/id #uuid "6b42bb14-69ce-5638-9395-6c34c6096d6a" :answer/type {:db/ident :answer.type/math} :answer/value "-24" :db/id #edb/ref 17592186374482} :answer-field/id #uuid "f1c01ac7-9d26-51e2-9d1e-e1b4c6519d81" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186374480}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "061c82af-1f52-5108-8d09-031ae4712e6b" :question/math-academy-id "q-122992" :question/problem "Let $P={{z}_{0},{z}_{1},…,{z}_{q}}$ be a partition of the interval $[-2,4].$ If $Δ{z}_{k}={z}_{k}-{z}_{k-1},$ calculate ${\\sum }_{k=1}^{q}-2({z}_{k}+{z}_{k-1})Δ{z}_{k}.$" :question/worked-solution "Using the constant multiple rule, we can write the summation as\n\n$$\n{\\sum }_{k=1}^{q}-2({z}_{k}+{z}_{k-1})Δ{z}_{k}=-2{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}.\n$$\n\nWe can simplify the summation as follows: \n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & =({z}_{1}+{z}_{0})Δ{z}_{1}+({z}_{2}+{z}_{1})Δ{z}_{2}+⋯+({z}_{q}+{z}_{q-1})Δ{z}_{n} \\\\  & =({z}_{1}+{z}_{0})({z}_{1}-{z}_{0})+({z}_{2}+{z}_{1})({z}_{2}-{z}_{1})+⋯+({z}_{q}+{z}_{q-1})({z}_{q}-{z}_{q-1}) \\\\  & =({z}_{1}^{2}-{z}_{0}^{2})+({z}_{2}^{2}-{z}_{1}^{2})+⋯+({z}_{q}^{2}-{z}_{q-1}^{2}) \\\\  & =(\\cancel{{z}_{1}^{2}}-{z}_{0}^{2})+(\\cancel{{z}_{2}^{2}}-\\cancel{{z}_{1}^{2}})+⋯+({z}_{q}^{2}-\\cancel{{z}_{q-1}^{2}}) \\\\  & =-{z}_{0}^{2}+{z}_{q}^{2} \\\\  & ={z}_{q}^{2}-{z}_{0}^{2}\\end{aligned}\n$$\n\nNow, since ${z}_{0}=-2$ and ${z}_{q}=4$ are the endpoints of our partition, we have\n\n$$\n\\begin{aligned}{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k} & ={z}_{q}^{2}-{z}_{0}^{2} \\\\  & ={4}^{2}-(-2)^{2} \\\\  & =12.\\end{aligned}\n$$\n\n  \n\nFinally, we have\n\n$$\n-2{\\sum }_{k=1}^{q}({z}_{k}+{z}_{k-1})Δ{z}_{k}=(-2)\\cdot 12=-24.\n$$"}]}
