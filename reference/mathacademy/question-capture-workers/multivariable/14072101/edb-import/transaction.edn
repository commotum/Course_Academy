_{0} \\\\  & =(-1)-(-7) \\\\  & =7-1 \\\\  & =6.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-122976/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c91d51f-39b4-547a-971b-9c2dada9eb47"] :knowledge-point/questions ["q-122976"] :db/ensure [:knowledge-point/validate]} {:db/id "q-122973/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "76fb3b57-6c94-5aa3-b2cc-ff7921cf58ea" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-122973/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "977b3473-1e9a-52c3-84bb-2a63d9f2380b" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-122973/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" :answer/id #uuid "5888b0ba-9bce-598c-9ca1-e6d31db1af6e" :answer/type :answer.type/math :answer/value "9" :db/ensure [:answer/validate]} {:db/id "q-122973/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "47758275-b7ab-5356-b0bf-31676720404c" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-122973/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49" :answer/id #uuid "d76344d4-ccd1-5302-ac21-25da8de5203a" :answer/type :answer.type/math :answer/value "15" :db/ensure [:answer/validate]} {:db/id "q-122973/selection" :answer-field/id #uuid "fe483357-5dc8-597d-8d9b-624ce4cb4459" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-122973/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer-field/choices ["q-122973/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-122973/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-122973/selection/303632d9519e4b7e53f9af56aad03bb866b8b5ede58a0b8b2cb848d575460c53" "q-122973/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-122973/selection/66dedd51c696580d351ab6a45c1c63cb495081ccf219c3c3c62f1d90fbeb5a49"] :db/ensure [:answer-field/validate]} {:db/id "q-122973" :question/id #uuid "38bea492-5700-5868-9b17-34a91ec6a822" :question/math-academy-id "q-122973" :question/problem "Let $P={{x}_{0},{x}_{1},…,{x}_{m}}$ be a partition of the interval $[4,11].$ If $Δ{x}_{i}={x}_{i}-{x}_{i-1},$ calculate ${\\sum }_{i=1}^{m}Δ{x}_{i}.$" :question/worked-solution "Note that ${\\sum }_{i=1}^{m}Δ{x}_{i}$ is just the length of the interval $[4,11],$ because\n\n$$\n\\begin{aligned}{\\sum }_{i=1}^{m}Δ{x}_{i} & =({x}_{1}-{x}_{0})+({x}_{2}-{x}_{1})+({x}_{3}-{x}_{2})+⋯+({x}_{m}-{x}_{m-1}) \\\\  & =(\\cancel{{x}_{1}}-{x}_{0})+(\\cancel{{x}_{2}}-\\cancel{{x}_{1}})+(\\cancel{{x}_{3}}-\\cancel{{x}_{2}})+⋯+({x}_{m}-\\cancel{{x}_{m-1}}) \\\\  & =-{x}_{0}+{x}_{m} \\\\  & ={x}_{m}-{x}_{0} \\\\  & =11-4 \\\\  & =7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-122973/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6c91d51f-39b4-547a-971b-9c2dada9eb47"] :knowledge-point/questions ["q-122973"] :db/ensure [:knowledge-point/validate]} {:db/id "q-122984/selection/801bcdd9cb6a10cec998162e05f71050c8aaf0c6974f095bdcaef715a09f4aee" :answer/id #uuid "663976d6-e357-5dc5-a5ae-15f3294306aa" :answer/type :answer.type/math :answer/value "21" :db/ensure [:answer/validate]} {:db/id "q-122984/selection/286fb92e9ba180b012d241bb7e762701483c9c864420d9df6597147f2e2fb458" :answer/id #uuid "8f2488cd-b772-5227-bae3-efbf13ac4862" :answer/type :answer.type/math :answer/value "28" :db/ensure [:answer/validate]} {:db/id "q-122984/selection/e326a281f601aec64d5dcce4921033c5f93cbf7f8b0a7a5809a9962dfadde666" :answer/id #uuid "06957e80-6ef8-59e1-a78e-ed8a78f69072" :answer/type :answer.type/math :answer/value "18" :db/ensure [:answe