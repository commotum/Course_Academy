e]} {:db/id "q-122937" :question/id #uuid "38e18c22-0d10-5bd8-9bb1-b67243431b28" :question/math-academy-id "q-122937" :question/problem "Which of the following are partitions of the real interval $[-3,7]?$\n\n- ${-3,-5,1,2,6}$\n- ${-3,0,3,7,8}$\n- ${-3,-2,1,3,4,7}$" :question/worked-solution "A partition $P$ of a closed interval $[a,b]$ is a finite sequence of real numbers taken from $[a,b]$ such that\n\n$$\na={x}_{0}<{x}_{1}<{x}_{2}<…<{x}_{n}=b\\,.\n$$\n\nWe can express $P$ using set notation as\n\n$$\nP={{x}_{0},{x}_{1},…,{x}_{n}}.\n$$\n\n \n\nWith that in mind, let's consider each statement:\n\n- Statement I is not a partition of $[-3,7]$ since it does not include the right endpoint $b=7.$\n\n- Statement II is not a partition of $[-3,7]$ since $8$ does not belong to $[-3,7].$\n\n- Statement III is a partition of $[-3,7].$\n\nTherefore, the correct answer is \"III only.\"" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-122937/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2bc800b0-3901-5154-81ac-1ef853017320"] :knowledge-point/questions ["q-122937"] :db/ensure [:knowledge-point/validate]} {:db/id "q-122932/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "41ec46a2-2751-59e3-aa6d-66be9ef35514" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-122932/selection/3157635cf9496371609f9768a1e617dfdac3f51d8fba589c5e495cb1c0105986" :answer/id #uuid "705e3f09-0324-5d64-b4d3-c4b01cd4d956" :answer/type :answer.type/text :answer/value "None of the statements give a partition of  $[-4,6]$" :db/ensure [:answer/validate]} {:db/id "q-122932/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "40293fdb-f0b0-5105-8166-5fa2eec997ff" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-122932/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb