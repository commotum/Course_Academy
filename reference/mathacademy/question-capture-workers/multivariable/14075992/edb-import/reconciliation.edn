ourse_Academy/reference/mathacademy/question-capture-workers/differential/14068434/state.json" "file_sha256" "f510fe2b8860606b92c61bb3c98e154cd4cb66bce666d1111228e4b5671d72e5" "basis" 2314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068434/edb-import/verification.json"} {"question" "q-31272" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{16}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068434/state.json" "file_sha256" "f510fe2b8860606b92c61bb3c98e154cd4cb66bce666d1111228e4b5671d72e5" "basis" 2314 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14068434/edb-import/verification.json"}] "sources" [{"question" "q-31253" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 2}\\frac{{x}^{2}+x-6}{{x}^{2}-4}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-31253" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=2$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{{x}^{2}+x-6}{{x}^{2}-4} & ={lim}_{x\\to 2}\\frac{[{x}^{2}+x-6]^{′}}{[{x}^{2}-4]^{′}} \\\\  & ={lim}_{x\\to 2}\\frac{2x+1}{2x} \\\\  & =\\frac{2(2)+1}{2(2)} \\\\  & =\\frac{5}{4}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-31253" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-31253" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-31253" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "\\frac{4}{5}"] ["math" "\\frac{5}{4}"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-31253" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{5}{4}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3771" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 0}\\frac{{e}^{3x}-1}{x}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3771" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{3x}-1}{x} & ={lim}_{x\\to 0}\\frac{[{e}^{3x}-1]^{′}}{[x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{3{e}^{3x}}{1} \\\\  & =3{e}^{3(0)} \\\\  & =3(1) \\\\  & =3\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3771" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-3771" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3771" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\infty "] ["math" "0"] ["math" "1"] ["math" "3"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3771" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3774" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 2}\\frac{5{x}^{2}-3x-14}{{x}^{2}+x-6}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3774" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=2$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 2}\\frac{5{x}^{2}-3x-14}{{x}^{2}+x-6} & ={lim}_{x\\to 2}\\frac{[5{x}^{2}-3x-14]^{′}}{[{x}^{2}+x-6]^{′}} \\\\  & ={lim}_{x\\to 2}\\frac{10x-3}{2x+1} \\\\  & =\\frac{10(2)-3}{2(2)+1} \\\\  & =\\frac{17}{5}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3774" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-3774" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3774" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "4"] ["math" "5"] ["math" "\\frac{17}{5}"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3774" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{17}{5}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-314141" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 1}\\frac{7{x}^{4}+2{x}^{2}-9}{10-3x-7{x}^{3}}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-314141" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{7{x}^{4}+2{x}^{2}-9}{10-3x-7{x}^{3}} & ={lim}_{x\\to 1}\\frac{[7{x}^{4}+2{x}^{2}-9]^{′}}{[10-3x-7{x}^{3}]^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{28{x}^{3}+4x}{-3-21{x}^{2}} \\\\  & =\\frac{28(1)^{3}+4(1)}{-3-21(1)^{2}} \\\\  & =\\frac{28+4}{-3-21} \\\\  & =\\frac{32}{(-24)} \\\\  & =-\\frac{4}{3}\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-314141" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-314141" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-314141" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{4}{3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3772" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 1}\\frac{{x}^{4}-1}{x-1}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3772" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=1$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{x}^{4}-1}{x-1} & ={lim}_{x\\to 1}\\frac{[{x}^{4}-1]^{′}}{[x-1]^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{4{x}^{3}}{1} \\\\  & =4(1)^{3} \\\\  & =4\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3772" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-3772" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3772" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2"] ["math" "4"] ["math" "\\frac{1}{2}"] ["math" "\\frac{1}{4}"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-3772" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "4"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336903" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n$\\,{lim}_{x\\to -4}\\frac{(x+4)^{3}}{3\\sqrt[3]{x+5}-x-7}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336903" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=-4$ we get the indeterminate form $\\frac{0}{0},$ so we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{(x+4)^{3}}{3\\sqrt[3]{x+5}-x-7} & ={lim}_{x\\to -4}\\frac{{[(x+4)^{3}]}^{′}}{{[3(x+5)^{1/3}-x-7]}^{′}} \\\\  & ={lim}_{x\\to -4}\\frac{3(x+4)^{2}}{(x+5)^{-2/3}-1}.\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to -4}\\frac{3(x+4)^{2}}{(x+5)^{-2/3}-1} & ={lim}_{x\\to -4}\\frac{{[3(x+4)^{2}]}^{′}}{{[(x+5)^{-2/3}-1]}^{′}} \\\\  & ={lim}_{x\\to -4}\\frac{6(x+4)}{-\\frac{2}{3}(x+5)^{-5/3}} \\\\  & =-9{lim}_{x\\to -4}(x+4)(x+5)^{5/3} \\\\  & =-9(-4+4)\\,(-4+5)^{5/3} \\\\  & =-9\\cdot 0\\cdot 1 \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336903" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336903" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336903" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336939" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 0}\\frac{\\operatorname{ln}⁡(1+5x)-5x}{{x}^{2}}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336939" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\operatorname{ln}⁡(1+5x)-5x}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[\\operatorname{ln}⁡(1+5x)-5x]}^{′}}{[{x}^{2}]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(\\frac{5}{1+5x}-5)}{2x} \\\\  & =\\frac{5}{2}{lim}_{x\\to 0}\\frac{(\\frac{1}{1+5x}-1)}{x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{\\operatorname{ln}⁡(1+5x)-5x}{{x}^{2}} & =\\frac{5}{2}{lim}_{x\\to 0}\\frac{(\\frac{1}{1+5x}-1)}{x} \\\\  & =\\frac{5}{2}{lim}_{x\\to 0}\\frac{{[(1+5x)^{-1}-1]}^{′}}{[x]^{′}} \\\\  & =\\frac{5}{2}{lim}_{x\\to 0}(-5(1+5x)^{-2}) \\\\  & =\\frac{5}{2}(-5) \\\\  & =-\\frac{25}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336939" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336939" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336939" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{25}{2}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-114249" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to -1}\\frac{(x+2)\\operatorname{ln}⁡(x+2)-x-1}{{x}^{2}+2x+1}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-114249" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=-1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{(x+2)\\operatorname{ln}⁡(x+2)-x-1}{{x}^{2}+2x+1} & ={lim}_{x\\to -1}\\frac{{[(x+2)\\operatorname{ln}⁡(x+2)-x-1]}^{′}}{{[{x}^{2}+2x+1]}^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{\\operatorname{ln}⁡(x+2)}{2x+2}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to -1}\\frac{(x+2)\\operatorname{ln}⁡(x+2)-x-1}{{x}^{2}+2x+1} & ={lim}_{x\\to -1}\\frac{\\operatorname{ln}⁡(x+2)}{2x+2} \\\\  & ={lim}_{x\\to -1}\\frac{{[\\operatorname{ln}⁡(x+2)]}^{′}}{{[2x+2]}^{′}} \\\\  & ={lim}_{x\\to -1}\\frac{(\\frac{1}{x+2})}{2} \\\\  & ={lim}_{x\\to -1}\\frac{1}{2(x+2)} \\\\  & =\\frac{1}{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-114249" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-114249" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-114249" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "1"] ["math" "2"] ["math" "4"] ["math" "\\frac{1}{2}"] ["math" "\\frac{1}{4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-114249" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336899" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n$\\,{lim}_{x\\to 1}\\frac{{x}^{2}-2x+1}{({x}^{2}-9)^{2}+32x-96}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336899" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=1$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{x}^{2}-2x+1}{({x}^{2}-9)^{2}+32x-96} & ={lim}_{x\\to 1}\\frac{{[{x}^{2}-2x+1]}^{′}}{{[({x}^{2}-9)^{2}+32x-96]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{2x-2}{4x({x}^{2}-9)+32} \\\\  & ={lim}_{x\\to 1}\\frac{x-1}{2{x}^{3}-18x+16}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 1}\\frac{{x}^{2}-2x+1}{({x}^{2}-9)^{2}+32x-96} & ={lim}_{x\\to 1}\\frac{x-1}{2{x}^{3}-18x+16} \\\\  & ={lim}_{x\\to 1}\\frac{{[x-1]}^{′}}{{[2{x}^{3}-18x+16]}^{′}} \\\\  & ={lim}_{x\\to 1}\\frac{1}{6{x}^{2}-18} \\\\  & =\\frac{1}{6(1)^{2}-18} \\\\  & =-\\frac{1}{12}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336899" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336899" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336899" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "-\\frac{1}{12}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-31272" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-31272" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[4\\sqrt{x+4}-x-8]}^{′}}{[{x}^{2}]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{′}}{[2x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-31272" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7