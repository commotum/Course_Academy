{1}{{x}^{4}}+8]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{6}{{x}^{7}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{6{x}^{-7}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{3}{2{x}^{2}} \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72338" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-72338" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72338" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-\\infty "] ["math" "0"] ["math" "1"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72338" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty "] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72336" "field" nil "attribute" "question/problem" "value" "Evaluate ${lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72336" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}\\frac{1}{{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}(\\frac{1}{{x}^{4}}-1)=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{(\\frac{1}{{x}^{2}})}{(\\frac{1}{{x}^{4}}-1)} & ={lim}_{x\\to 0}\\frac{{[\\frac{1}{{x}^{2}}]}^{′}}{{[\\frac{1}{{x}^{4}}-1]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{(-\\frac{2}{{x}^{3}})}{(-\\frac{4}{{x}^{5}})} \\\\  & ={lim}_{x\\to 0}\\frac{2{x}^{-3}}{4{x}^{-5}} \\\\  & ={lim}_{x\\to 0}\\frac{{x}^{2}}{2} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72336" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-72336" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72336" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "0"] ["math" "1"] ["math" "\\frac{1}{2}"] ["math" "\\frac{1}{4}"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72336" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336777" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to {0}^{+}}\\frac{(\\frac{3}{{x}^{3}}+1)}{(\\frac{2}{{x}^{2}})}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336777" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to {0}^{+}}(\\frac{3}{{x}^{3}}+1)=\\infty $ and ${lim}_{x\\to {0}^{+}}(\\frac{2}{{x}^{2}})=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to {0}^{+}}\\frac{(\\frac{3}{{x}^{3}}+1)}{(\\frac{2}{{x}^{2}})} & ={lim}_{x\\to {0}^{+}}\\frac{{[\\frac{3}{{x}^{3}}+1]}^{′}}{{[\\frac{2}{{x}^{2}}]}^{′}} \\\\  & ={lim}_{x\\to {0}^{+}}\\frac{(-\\frac{9}{{x}^{4}})}{(-\\frac{4}{{x}^{3}})} \\\\  & =\\frac{9}{4}{lim}_{x\\to {0}^{+}}\\frac{{x}^{-4}}{{x}^{-3}} \\\\  & =\\frac{9}{4}{lim}_{x\\to {0}^{+}}\\frac{1}{x} \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336777" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336777" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336777" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336790" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to {(\\pi /2)}^{-}}\\frac{\\operatorname{sec}⁡x}{{e}^{\\operatorname{sec}⁡x}}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336790" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to (\\pi /2)^{-}}\\operatorname{sec}⁡x=\\infty $ and ${lim}_{x\\to (\\pi /2)^{-}}{e}^{\\operatorname{sec}⁡x}=\\infty ,$ respectively, so we have the indeterminate form $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{sec}⁡x}{{e}^{\\operatorname{sec}⁡x}} & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{{[\\operatorname{sec}⁡x]}^{′}}{{[{e}^{\\operatorname{sec}⁡x}]}^{′}} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{\\operatorname{sec}⁡x\\operatorname{tan}⁡x}{{e}^{\\operatorname{sec}⁡x}(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{\\cancel{\\operatorname{sec}⁡x\\operatorname{tan}⁡x}}{{e}^{\\operatorname{sec}⁡x}\\cancel{(\\operatorname{sec}⁡x\\operatorname{tan}⁡x)}} \\\\  & ={lim}_{x\\to (\\pi /2)^{-}}\\frac{1}{{e}^{\\operatorname{sec}⁡x}} \\\\  & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336790" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336790" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336790" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72335" "field" nil "attribute" "question/problem" "value" "${lim}_{x\\to 0}\\frac{{e}^{2/{x}^{2}}}{(\\frac{1}{2{x}^{2}})}=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72335" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to 0}{e}^{2/{x}^{2}}=\\infty $ and ${lim}_{x\\to 0}\\frac{1}{2{x}^{2}}=\\infty ,$ respectively, so we have the case $\\frac{\\infty }{\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{2/{x}^{2}}}{(\\frac{1}{2{x}^{2}})} & ={lim}_{x\\to 0}\\frac{{[{e}^{2/{x}^{2}}]}^{′}}{{[\\frac{1}{2{x}^{2}}]}^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{{e}^{2/{x}^{2}}(-\\frac{4}{{x}^{3}})}{(-\\frac{1}{{x}^{3}})} \\\\  & ={lim}_{x\\to 0}\\frac{4{e}^{2/{x}^{2}}\\cancel{(-\\frac{1}{{x}^{3}})}}{\\cancel{(-\\frac{1}{{x}^{3}})}} \\\\  & =4{lim}_{x\\to 0}{e}^{2/{x}^{2}} \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72335" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-72335" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72335" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-\\infty "] ["math" "0"] ["math" "4"] ["math" "\\frac{1}{4}"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-72335" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty "] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336967" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{{x}^{2}+\\sqrt{x}}{{x}^{2}-5\\sqrt{x}}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336967" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{2}+\\sqrt{x}}{{x}^{2}-5\\sqrt{x}} & ={lim}_{x\\to \\infty }\\frac{[{x}^{2}+\\sqrt{x}]^{′}}{[{x}^{2}-5\\sqrt{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2x+\\frac{1}{2\\sqrt{x}}}{2x-\\frac{5}{2\\sqrt{x}}}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{2}+\\sqrt{x}}{{x}^{2}-5\\sqrt{x}} & ={lim}_{x\\to \\infty }\\frac{{[2x+\\frac{1}{2\\sqrt{x}}]}^{′}}{{[2x-\\frac{5}{2\\sqrt{x}}]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{{[2x+\\frac{1}{2}{x}^{-1/2}]}^{′}}{{[2x-\\frac{5}{2}{x}^{-1/2}]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2-\\frac{1}{4}{x}^{-3/2}}{2+\\frac{5}{4}{x}^{-3/2}} \\\\  & ={lim}_{x\\to \\infty }\\frac{2-\\frac{1}{4{x}^{3/2}}}{2+\\frac{5}{4{x}^{3/2}}} \\\\  & =1.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336967" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336967" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336967" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "1"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336956" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{3x+\\sqrt{x}}{\\sqrt{x}}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336956" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{3x+\\sqrt{x}}{\\sqrt{x}} & ={lim}_{x\\to \\infty }\\frac{[3x+\\sqrt{x}]^{′}}{[\\sqrt{x}]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(3+\\frac{1}{2\\sqrt{x}})}{\\frac{1}{2\\sqrt{x}}} \\\\  & ={lim}_{x\\to \\infty }(6\\sqrt{x}+1) \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336956" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336956" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336956" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336951" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x+9x-4}{3x+1}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336951" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x+9x-4}{3x+1} & ={lim}_{x\\to \\infty }\\frac{[2\\operatorname{ln}⁡x+9x-4]^{′}}{[3x+1]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{x}+9)}{3} \\\\  & =\\frac{0+9}{3} \\\\  & =3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336951" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336951" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336951" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336971" "field" nil "attribute" "question/problem" "value" "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x}=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336971" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & ={lim}_{x\\to \\infty }\\frac{[{x}^{3}]^{′}}{[{ln}^{2}⁡x]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{3{x}^{2}}{(\\frac{2\\operatorname{ln}⁡x}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{3{x}^{3}}{2\\operatorname{ln}⁡x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{\\infty }{\\infty }.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{{x}^{3}}{{ln}^{2}⁡x} & ={lim}_{x\\to \\infty }\\frac{[3{x}^{3}]^{′}}{{[2\\operatorname{ln}⁡x]}^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{9{x}^{2}}{(\\frac{2}{x})} \\\\  & ={lim}_{x\\to \\infty }\\frac{9{x}^{3}}{2} \\\\  & =\\infty .\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336971" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-336971" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-336971" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\infty"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-115519" "field" nil "attribute" "question/problem" "value" "Evaluate ${lim}_{x\\to -\\infty }\\frac{\\operatorname{ln}⁡(1-x)-2x}{x+1}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-115519" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are ${lim}_{x\\to -\\infty }(\\operatorname{ln}⁡(1-x)-2x)=\\infty $ and ${lim}_{x\\to -\\infty }(x+1)=-\\infty ,$ respectively, so we have the case $\\frac{\\infty }{-\\infty }.$\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\begin{aligned}{lim}_{x\\to -\\infty }\\frac{\\operatorname{ln}⁡(1-x)-2x}{x+1} & ={lim}_{x\\to -\\infty }\\frac{[\\operatorname{ln}⁡(1-x)-2x]^{′}}{{[x+1]}^{′}} \\\\  & ={lim}_{x\\to -\\infty }\\frac{(-\\frac{1}{1-x}-2)}{1} \\\\  & =-{lim}_{x\\to -\\infty }(\\frac{1}{1-x}+2) \\\\  & =-(0+2) \\\\  & =-2.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-115519" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/activity-metadata.json" "file_sha256" "43a91cd16159a31e5d7623fbeed5652d498da54598aa00a1b061c4f98b4df7b5"} {"question" "q-115519" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-115519" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "-1"] ["math" "-2"] ["math" "-\\infty "] ["math" "0"] ["math" "\\infty "]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "q-115519" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "-2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/state.json" "file_sha256" "ae2237189de42c7ffee05a70f73d479c3c6b8dddb1972e001b1cf092d099cc16"} {"question" "e-300" "field" nil "attribute" "question/problem" "value" "Calculate $\\displaystyle \\lim_{x\\rightarrow 3}\\dfrac{x^3-27}{x-3}$." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-300.json" "file_sha256" "fba6e4b48f2473f93752a486361dfc3cbcd1cb708fcda6c3241654bf0e1add78"} {"question" "e-300" "field" nil "attribute" "question/worked-solution" "value" "Note that plugging in $x=3$ gives the indeterminate form $\\dfrac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\eqalign{\n\\lim_{x\\to 3}  \\dfrac {x^3-27}{x-3} \n&= \\lim_{x\\to3}  \\dfrac {[x^3-27]'}{[x-3]'}\\[5pt]\n&= \\lim_{x\\to 3}  \\dfrac {3x^2}{1}\\[5pt]\n&=  3(3)^2\\[5pt]\n&= 27\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-300.json" "file_sha256" "fba6e4b48f2473f93752a486361dfc3cbcd1cb708fcda6c3241654bf0e1add78"} {"question" "e-301" "field" nil "attribute" "question/problem" "value" "Evaluate  $\\displaystyle \\lim_{x\\to 0} \\, \\frac {\\sin^2 (2x)}{x^2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-301.json" "file_sha256" "8fd46033e0822c2322aaf72545fb7f97c54cdbd768a7c385b6ba88b0ef4ca37b"} {"question" "e-301" "field" nil "attribute" "question/worked-solution" "value" "If we plug in $x=0$ we get the indeterminate form $\\dfrac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\eqalign{\n\\lim_{x\\to0}  \\dfrac{\\sin^2 (2x)}{x^2} &= \\lim_{x\\to 0}  \\dfrac {\\left[\\sin^2 (2x)\\right]'}{[x^2]'}\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{2\\cdot \\sin (2x) \\cdot\\cos (2x)\\cdot 2}{2x}\\[5pt]\n&= \\lim_{x\\to 0}{2\\cos (2x)} \\cdot \\lim_{x\\to 0} \\dfrac{\\sin (2x)}{x}\\[5pt]\n&= 2\\cos(2\\cdot 0)\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x}\\[5pt]\n&= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x}\n}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\dfrac{0}{0}.$ But that's okay, because we can just apply L'Hopital's rule again! We get\n\n$$\n\\eqalign{\n\\lim_{x\\to0}  \\dfrac{\\sin^2 (2x)}{x^2} &= 2\\lim_{x\\to 0}\\dfrac{\\sin (2x)}{x}\\[5pt]\n&=  2\\lim_{x\\to0}  \\dfrac {[\\sin (2x)]'}{[x]'}\\[5pt]\n&=  2\\lim_{x\\to0}  \\dfrac {2\\cos (2x)}{1}\\[5pt]\n&= 4\\cos(2\\cdot 0)\\\n&=4.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-301.json" "file_sha256" "8fd46033e0822c2322aaf72545fb7f97c54cdbd768a7c385b6ba88b0ef4ca37b"} {"question" "e-302" "field" nil "attribute" "question/problem" "value" "Evaluate $\\displaystyle \\lim_{x\\to 0}  \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)} .$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-302.json" "file_sha256" "14283a1dd295fa7537fe56dd429392c00146037a875d39689c0d7ab6263ad7a1"} {"question" "e-302" "field" nil "attribute" "question/worked-solution" "value" "Here the limits of the numerator and denominator are\n$\\displaystyle\n \\lim_{x\\to 0}  \\ln\\left(x^2\\right) = -\\infty$ and $\\displaystyle \\lim_{x\\to 0} \\dfrac{2}{x^2} = \\infty$ respectively,\nso we have the case $\\dfrac{-\\infty}{\\infty}$.\n\nApplying L'Hopital's rule, we obtain\n\n$$\n\\eqalign{\n\\lim_{x\\to 0}  \\dfrac{\\ln\\left(x^2\\right)}{\\left(\\dfrac{2}{x^2}\\right)} &= \\lim_{x\\to 0}  \\dfrac{[\\ln\\left(x^2\\right)]'}{\\left(\\dfrac{2}{x^2}\\right)'}\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{\\left(1/x^2\\right)\\cdot 2x}{-\\left({4}/{x^3}\\right)}\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{x^{-2} \\cdot 2x}{-4x^{-3} }\\[5pt]\n&= \\lim_{x\\to 0}  \\dfrac{2x^{-1}}{-4x^{-3} }\\[5pt]\n&= -\\dfrac{1}{2}  \\lim_{x\\to 0} {x^2}\\[5pt]\n&= -\\dfrac{1}{2}\\cdot 0\\[5pt]\n&= 0.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-302.json" "file_sha256" "14283a1dd295fa7537fe56dd429392c00146037a875d39689c0d7ab6263ad7a1"} {"question" "e-303" "field" nil "attribute" "question/problem" "value" "Evaluate ${\\displaystyle \\lim_{x\\to\\infty}  \\frac {x^6}{5x^6-4} }.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-303.json" "file_sha256" "0b6f9a0aef2816797c8e284db0a6b4e938c90322903b80a202fbcc9e892cb0fa"} {"question" "e-303" "field" nil "attribute" "question/worked-solution" "value" "In this case, we have an indeterminate form of type $\\dfrac{\\infty}{\\infty},$ so applying  L'Hopital's rule yields\n\n$$\n\\eqalign{\n\\lim_{x\\to \\infty}  \\dfrac {x^6}{5x^6-4} &= \\lim_{x\\to\\infty}  \\dfrac {[x^6]'}{[5x^6-4]'}\\\n&= \\lim_{x\\to \\infty}  \\dfrac {6x^5}{5(6x^5)-0}\\\n&=  \\lim_{x\\to \\infty}  \\dfrac {1}{5}\\\n&= \\dfrac{1}{5}.\n}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14075992/example-303.json" "file_sha256" "0b6f9a0aef2816797c8e284db0a6b4e938c90322903b80a202fbcc9e892cb0fa"}] "usage" {"q-114249" [] "q-31253" [] "e-300" [] "q-31272" [] "e-301" [] "e-303" [] "q-336971" [] "q-72336" [] "e-302" [] "q-72335" [] "q-3771" [] "q-336903" [] "q-336951" []} "basis" 2770 "retractions" [[17592186260223 :question/worked-solution "Note that plugging in $x=0$ gives the indeterminate form $\\frac{0}{0}.$ However, we can use L'Hopital's rule to find this limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{{e}^{3x}-1}{x} & ={lim}_{x\\to 0}\\frac{[{e}^{3x}-1]^{'}}{[x]^{'}} \\\\  & ={lim}_{x\\to 0}\\frac{3{e}^{3x}}{1} \\\\  & =3{e}^{3(0)} \\\\  & =3(1) \\\\  & =3\\end{aligned}\n$$"] [17592186260223 :question/answer-fields 17592186274673]] "immutable_answers" [17592186259774 17592186264259 17592186264260 17592186264261 17592186264262 17592186264263 17592186266154 17592186271969 17592186271970 17592186271971 17592186271972 17592186271973 17592186275730 17592186275731 17592186275732 17592186275733 17592186275734 17592186286511 17592186286512 17592186286513 17592186286514 17592186286515 17592186296240 17592186296241 17592186296242 17592186296243 17592186296244 17592186296276 17592186296277 17592186330266 17592186358194 17592186358195 17592186358196 17592186358197 17592186358198] "immutable_fields" [[17592186259773 :answer-field/correct] [