#{[{:db/id #edb/ref 17592186266152 :knowledge-point/_questions [{:knowledge-point/id #uuid "aeebf57f-21dc-558a-bec5-4e97a5b26de4" :knowledge-point/title "Calculating a Limit at Positive or Negative Infinity Using L'Hopital's Rule"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d00c2043-386c-5a32-9492-22e6a626b056" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186266154}] :answer-field/correct {:answer/id #uuid "d00c2043-386c-5a32-9492-22e6a626b056" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186266154} :answer-field/id #uuid "445ecb86-4291-52cd-9f90-72e378f6a2ee" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186266153}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "e1391e51-b3fc-5d6d-af4b-284d914341dc" :question/math-academy-id "q-336951" :question/problem "Evaluate the following limit:\n\n${lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x+9x-4}{3x+1}=$\n{{field-1}}" :question/worked-solution "In this case, we have an indeterminate form of type $\\frac{\\infty }{\\infty },$ so applying L'Hopital's rule yields\n\n$$\n\\begin{aligned}{lim}_{x\\to \\infty }\\frac{2\\operatorname{ln}⁡x+9x-4}{3x+1} & ={lim}_{x\\to \\infty }\\frac{[2\\operatorname{ln}⁡x+9x-4]^{′}}{[3x+1]^{′}} \\\\  & ={lim}_{x\\to \\infty }\\frac{(\\frac{2}{x}+9)}{3} \\\\  & =\\frac{0+9}{3} \\\\  & =3.\\end{aligned}\n$$"}]}
