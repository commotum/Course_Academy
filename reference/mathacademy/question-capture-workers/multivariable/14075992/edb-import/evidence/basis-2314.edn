#{[{:db/id #edb/ref 17592186259427 :knowledge-point/_questions [{:knowledge-point/id #uuid "8a41d750-ffd9-5226-9bd7-b763575870c1" :knowledge-point/title "Calculating a Limit Using L'Hopital's Rule Twice"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5a9fa45-1fd9-5ad8-baf0-6c183eceedb6" :answer/type {:db/ident :answer.type/math} :answer/value "\\infty " :db/id #edb/ref 17592186358194} {:answer/id #uuid "cd42b75e-0b19-54aa-8e37-03971691861e" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186358195} {:answer/id #uuid "cd04da96-5dc5-5fd8-909d-c920648a3dd5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186358196} {:answer/id #uuid "0ca95696-6501-56b4-8be4-3d4850c2c883" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}" :db/id #edb/ref 17592186358197} {:answer/id #uuid "ed48adbf-80fe-5551-9fba-eac4ec9e48e0" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186358198}] :answer-field/correct {:answer/id #uuid "cd04da96-5dc5-5fd8-909d-c920648a3dd5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{16}" :db/id #edb/ref 17592186358196} :answer-field/id #uuid "e3ebccb2-4065-5774-bee3-5949510d5f65" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186358193}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "5f6b45e4-aad3-52ce-a5c4-dc96f14dd157" :question/math-academy-id "q-31272" :question/problem "${lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}}=$" :question/worked-solution "If we plug in $x=0$ we get the indeterminate form $\\frac{0}{0},$ so  we apply L'Hopital's rule to find the limit:\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{{[4\\sqrt{x+4}-x-8]}^{′}}{[{x}^{2}]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x}\\end{aligned}\n$$\n\nThis time, the resulting limit still gives the indeterminate form $\\frac{0}{0}.$ To find the limit, we apply L'Hopital's rule once again. We get\n\n$$\n\\begin{aligned}{lim}_{x\\to 0}\\frac{4\\sqrt{x+4}-x-8}{{x}^{2}} & ={lim}_{x\\to 0}\\frac{[\\frac{2}{\\sqrt{x+4}}-1]}{2x} \\\\  & ={lim}_{x\\to 0}\\frac{{[\\frac{2}{\\sqrt{x+4}}-1]}^{′}}{[2x]^{′}} \\\\  & ={lim}_{x\\to 0}\\frac{[-\\frac{1}{(x+4)\\sqrt{x+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{(0+4)\\sqrt{0+4}}]}{2} \\\\  & =\\frac{[-\\frac{1}{4(2)}]}{2} \\\\  & =-\\frac{1}{16}.\\end{aligned}\n$$"}]}
