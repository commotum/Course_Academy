[{:db/id "q-164397/selection/6bd387905e1ff3ded193aa29f36bd41ac4c06cb293af9406c48f60b51fdc20fb" :answer/id #uuid "1f47b576-a550-56e6-96aa-69c1c40e8aaa" :answer/type :answer.type/text :answer/value "The line $y=-1$" :db/ensure [:answer/validate]} {:db/id "q-164397/selection/bb46e4d24a4fe9995ed70d0eae67496df274cfde2116c1d7c76e8bd4a1c181db" :answer/id #uuid "cc57c1c9-2433-50b7-8cfe-eee706a12b10" :answer/type :answer.type/text :answer/value "The hyperbola $\\frac{(y+1)^{2}}{7}-{z}^{2}=1$" :db/ensure [:answer/validate]} {:db/id "q-164397/selection/0b232e883601ce365b790ec393edc521fb2a95c75b80aaf2fc23b2b96cf9eccf" :answer/id #uuid "ce0b7678-44d0-590f-8900-e050511faa25" :answer/type :answer.type/text :answer/value "The line $y=6$" :db/ensure [:answer/validate]} {:db/id "q-164397/selection/b8735302f28a2079be33a65687d27c845589f51add9bee663ec65c26b66259b4" :answer/id #uuid "f1cc30e4-363d-5a0c-8e6b-62f9a78b598b" :answer/type :answer.type/text :answer/value "The ellipse $\\frac{(y+1)^{2}}{7}+\\frac{{z}^{2}}{2}=1$" :db/ensure [:answer/validate]} {:db/id "q-164397/selection/d95de2971f732d1ba800511593af72411326d4481495562fe10651a3c28926ea" :answer/id #uuid "7de8ba4b-16ac-52db-ac9f-ac63bccdd6ab" :answer/type :answer.type/text :answer/value "The lines $y=-8$ and $y=6$" :db/ensure [:answer/validate]} {:db/id "q-164397/selection" :answer-field/id #uuid "231f7164-5abe-5747-bdc3-dfacad93349e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164397/selection/d95de2971f732d1ba800511593af72411326d4481495562fe10651a3c28926ea" :answer-field/choices ["q-164397/selection/6bd387905e1ff3ded193aa29f36bd41ac4c06cb293af9406c48f60b51fdc20fb" "q-164397/selection/bb46e4d24a4fe9995ed70d0eae67496df274cfde2116c1d7c76e8bd4a1c181db" "q-164397/selection/0b232e883601ce365b790ec393edc521fb2a95c75b80aaf2fc23b2b96cf9eccf" "q-164397/selection/b8735302f28a2079be33a65687d27c845589f51add9bee663ec65c26b66259b4" "q-164397/selection/d95de2971f732d1ba800511593af72411326d4481495562fe10651a3c28926ea"] :db/ensure [:answer-field/validate]} {:db/id "q-164397" :question/id #uuid "3f4340be-3d04-5c7c-97ac-086f5051ce04" :question/math-academy-id "q-164397" :question/problem "What is the trace in the $yz$-plane of the hyperbolic cylinder $\\frac{(x-4)^{2}}{2}-\\frac{(y+1)^{2}}{7}=1?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(0-4)^{2}}{2}-\\frac{(y+1)^{2}}{7} & =1 \\\\ 8-\\frac{(y+1)^{2}}{7} & =1 \\\\ \\frac{(y+1)^{2}}{7} & =7 \\\\ (y+1)^{2} & =49 \\\\ y+1 & =\\pm 7 \\\\ y & =-1\\pm 7 \\\\ y & =-8,6\\end{aligned}\n$$\n\nThis gives us the equation of two lines $y=-8$ and $y=6$ in the $yz$-plane." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164397/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf"] :knowledge-point/questions ["q-164397"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164401/selection/2a4a0d1b123d37aad33b810d5dab54790607186b999443a5e62c2d6011c125ac" :answer/id #uuid "eee2fe22-a68a-536b-9d82-3a7eec1c2254" :answer/type :answer.type/text :answer/value "The line $x=4$" :db/ensure [:answer/validate]} {:db/id "q-164401/selection/e14c17d8edb8bbe3554b65f88ec2a285048e8c1ae3c3ba017b38e0ed0a6d83d4" :answer/id #uuid "51f7f7ea-49f4-570e-ab98-c5550b226403" :answer/type :answer.type/text :answer/value "The hyperbola $\\frac{{x}^{2}}{8}-\\frac{(z-1)^{2}}{2}=1$" :db/ensure [:answer/validate]} {:db/id "q-164401/selection/90c260c2a837611b85a41098d57296cb41a1953a7320ca6f02954826b5ddc2fb" :answer/id #uuid "2ef6d50a-4140-5add-acd4-6fb457a69ada" :answer/type :answer.type/text :answer/value "The ellipse $\\frac{(x-4)^{2}}{8}+\\frac{{z}^{2}}{2}=1$" :db/ensure [:answer/validate]} {:db/id "q-164401/selection/45cc8f0ed9415123de0f2e011ddd080350a0281769c354bacfa3a1a8b99d351c" :answer/id #uuid "ece15aee-521e-52f4-a573-6e5aa992f3b6" :answer/type :answer.type/text :answer/value "The line $x=6$" :db/ensure [:answer/validate]} {:db/id "q-164401/selection/68cd19f06dd124289b4521ec12253345e1a2c178400260d4c7710aed1235d45b" :answer/id #uuid "b810ed96-38f8-552d-8ad6-f9c2fa91cdd7" :answer/type :answer.type/text :answer/value "The lines $x=2$ and $x=6$" :db/ensure [:answer/validate]} {:db/id "q-164401/selection" :answer-field/id #uuid "0b914f44-35b0-523c-aab0-bf0b4b6a52be" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164401/selection/68cd19f06dd124289b4521ec12253345e1a2c178400260d4c7710aed1235d45b" :answer-field/choices ["q-164401/selection/2a4a0d1b123d37aad33b810d5dab54790607186b999443a5e62c2d6011c125ac" "q-164401/selection/e14c17d8edb8bbe3554b65f88ec2a285048e8c1ae3c3ba017b38e0ed0a6d83d4" "q-164401/selection/90c260c2a837611b85a41098d57296cb41a1953a7320ca6f02954826b5ddc2fb" "q-164401/selection/45cc8f0ed9415123de0f2e011ddd080350a0281769c354bacfa3a1a8b99d351c" "q-164401/selection/68cd19f06dd124289b4521ec12253345e1a2c178400260d4c7710aed1235d45b"] :db/ensure [:answer-field/validate]} {:db/id "q-164401" :question/id #uuid "98ad452f-818a-5095-bf60-3f83ccbaae0f" :question/math-academy-id "q-164401" :question/problem "What is the trace in the $xz$-plane of the elliptic cylinder $\\frac{(x-4)^{2}}{8}+\\frac{(y-1)^{2}}{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x-4)^{2}}{8}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8}+\\frac{1}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8} & =\\frac{1}{2} \\\\ (x-4)^{2} & =4 \\\\ x-4 & =\\pm 2 \\\\ x & =4\\pm 2 \\\\ x & =2,6\\end{aligned}\n$$\n\nThis gives us the equation of two lines $x=2$ and $x=6$ in the $xz$-plane." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164401/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf"] :knowledge-point/questions ["q-164401"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164414/selection/094405769b8442fd1f6f3dc6f2d67d541ddf6f89934b4f55cc1c88a0f3e68dd1" :answer/id #uuid "c3270b61-2113-5c94-81db-338949b60a97" :answer/type :answer.type/math :answer/value "(-3,1)" :db/ensure [:answer/validate]} {:db/id "q-164414/selection/401028d5b9270d38e1d29135724ad40402f59019069c5cc7877bbd313667b0b6" :answer/id #uuid "67a1dfb3-bf99-586d-bddc-d9a8529b844d" :answer/type :answer.type/math :answer/value "(3,-1)" :db/ensure [:answer/validate]} {:db/id "q-164414/selection/90a9f3a76d85c95a52e9e38a0e9fc320cdb8f8e04530afc3986e6ade7dd6c2fe" :answer/id #uuid "c52e4051-c7e2-5690-8541-148fe0ae52b8" :answer/type :answer.type/math :answer/value "(2,-1)" :db/ensure [:answer/validate]} {:db/id "q-164414/selection/984f28fd2eb6305d893eef6bf628469d4c7b55d83d8e33de0935c83142e13846" :answer/id #uuid "db7437f4-4c60-54c6-9e10-923e451b34a1" :answer/type :answer.type/math :answer/value "(3,1)" :db/ensure [:answer/validate]} {:db/id "q-164414/selection/05c608960f55431a8a5ad458c5c69ad50acf9102fe96e8fa5ccb2f47a809adde" :answer/id #uuid "5041b9ec-f7ee-56be-a361-3f9f31cceb46" :answer/type :answer.type/math :answer/value "(3,2)" :db/ensure [:answer/validate]} {:db/id "q-164414/selection" :answer-field/id #uuid "88284024-50ea-548d-b12b-2b59a7c3b34f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164414/selection/401028d5b9270d38e1d29135724ad40402f59019069c5cc7877bbd313667b0b6" :answer-field/choices ["q-164414/selection/094405769b8442fd1f6f3dc6f2d67d541ddf6f89934b4f55cc1c88a0f3e68dd1" "q-164414/selection/401028d5b9270d38e1d29135724ad40402f59019069c5cc7877bbd313667b0b6" "q-164414/selection/90a9f3a76d85c95a52e9e38a0e9fc320cdb8f8e04530afc3986e6ade7dd6c2fe" "q-164414/selection/984f28fd2eb6305d893eef6bf628469d4c7b55d83d8e33de0935c83142e13846" "q-164414/selection/05c608960f55431a8a5ad458c5c69ad50acf9102fe96e8fa5ccb2f47a809adde"] :db/ensure [:answer-field/validate]} {:db/id "q-164414" :question/id #uuid "53a8baa3-c5ca-5f72-a258-e1c548f3d50d" :question/math-academy-id "q-164414" :question/problem "The projection of the intersection between the parabolic cylinder $4(x-3)^{2}=12(z+1)$ and the plane $y=2$ onto the $xz$-plane is a parabola. What is the vertex of the parabola?" :question/worked-solution "To find the intersection of the cylinder and the plane $y=2,$ we substitute $y=2$ into the equation of the cylinder. However, since the equation has no (explicit) $y$ term, we get\n\n$$\n\\begin{aligned}4(x-3)^{2} & =12(z+1) \\\\ (x-3)^{2} & =3(z+1) \\\\ (x-3)^{2} & =4\\cdot \\frac{3}{4}\\cdot (z+1).\\end{aligned}\n$$\n\nThis gives us the equation of a parabola in the $xz$-plane with the vertex at $(3,-1).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-164414/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf"] :knowledge-point/questions ["q-164414"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164416/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "51e3855f-5b97-59ce-b138-47cc0511dda9" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-164416/selection/d1a9035a0938a69cc45b02d2370aa6abc674021b396687bb07565e4de49f88d2" :answer/id #uuid "3783247e-a290-5f17-bfb7-925ac03ecc13" :answer/type :answer.type/text :answer/value "A hyperbola centered at $(1,0)$" :db/ensure [:answer/validate]} {:db/id "q-164416/selection/3c03b34324e4bf4ada03853a37d93eb542be3ec6bf8beb8de8cc1e255a74e28b" :answer/id #uuid "1780caa1-88d5-5e41-9411-a1da2456355d" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}:\\text{ }x-y>12}" :db/ensure [:answer/validate]} {:db/id "q-164416/selection/e0feb242c78f6aab52249db435f9f49ff5af26fa422ec91b07d6b54ab976c8d3" :answer/id #uuid "92ef3af2-0f15-58b1-a509-b5e5d0825f32" :answer/type :answer.type/text