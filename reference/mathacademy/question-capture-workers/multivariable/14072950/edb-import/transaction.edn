uestions ["q-164416"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164418/selection/004e943ce196111439d20eb40fba0ba84b0fde0516573f7bf16f84fa123c5767" :answer/id #uuid "63ad6b4b-43a3-5c72-96a7-ec080afd3f36" :answer/type :answer.type/text :answer/value "A hyperbola centered at $(3,-6)$" :db/ensure [:answer/validate]} {:db/id "q-164418/selection/6c1e01b7c6aa74080d41f3ea5483700d09d133671d88852dacc6c3554474ba3c" :answer/id #uuid "fcabbd70-bebf-5bf3-a79e-bc40509b5017" :answer/type :answer.type/text :answer/value "A hyperbola centered at $(1,2\\sqrt{2})$" :db/ensure [:answer/validate]} {:db/id "q-164418/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" :answer/id #uuid "ef4a3eab-8f65-5c47-8993-ed759bf66d42" :answer/type :answer.type/math :answer/value "{R}^{2}" :db/ensure [:answer/validate]} {:db/id "q-164418/selection/0d927544c73d912ddc1c0b2d00769e252a9439fa414f6206abd5abf6fa831bac" :answer/id #uuid "12b7e3d4-3cc1-579a-aedb-c473d51c1feb" :answer/type :answer.type/text :answer/value "A hyperbola centered at $(-3,6)$" :db/ensure [:answer/validate]} {:db/id "q-164418/selection/f96b7bac9ef1fa66c7198faef7a229422879283d6d95c429dac7fc47768b8e07" :answer/id #uuid "201696d2-22a3-5b1a-b5f6-7126e7b884b7" :answer/type :answer.type/math :answer/value "{(x,y)\\in {R}^{2}:x\\ge 3}" :db/ensure [:answer/validate]} {:db/id "q-164418/selection" :answer-field/id #uuid "c11e257a-7b5b-588f-a7f7-5a4af7d08ff3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164418/selection/004e943ce196111439d20eb40fba0ba84b0fde0516573f7bf16f84fa123c5767" :answer-field/choices ["q-164418/selection/004e943ce196111439d20eb40fba0ba84b0fde0516573f7bf16f84fa123c5767" "q-164418/selection/6c1e01b7c6aa74080d41f3ea5483700d09d133671d88852dacc6c3554474ba3c" "q-164418/selection/07d4d169afe54b72e6508fedd544e5d357fac0ff0f623249ab3b7f264f513fcf" "q-164418/selection/0d927544c73d912ddc1c0b2d00769e252a9439fa414f6206abd5abf6fa831bac" "q-164418/selection/f96b7bac9ef1fa66c7198faef7a229422879283d6d95c429dac7fc47768b8e07"] :db/ensure [:answer-field/validate]} {:db/id "q-164418" :question/id #uuid "691cc452-1ab1-53fd-9832-fbb0b8726da8" :question/math-academy-id "q-164418" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1}.\n$$\n\nThis is a hyperbola centered at $(3,-6).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164418/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d"] :knowledge-point/questions ["q-164418"] :db/ensure [:knowledge-point/validate]}]
