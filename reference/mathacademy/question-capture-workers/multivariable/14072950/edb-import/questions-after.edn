#{[{:db/id #edb/ref 17592186378368 :knowledge-point/_questions [{:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ce0b7678-44d0-590f-8900-e050511faa25" :answer/type {:db/ident :answer.type/text} :answer/value "The line $y=6$" :db/id #edb/ref 17592186378370} {:answer/id #uuid "1f47b576-a550-56e6-96aa-69c1c40e8aaa" :answer/type {:db/ident :answer.type/text} :answer/value "The line $y=-1$" :db/id #edb/ref 17592186378371} {:answer/id #uuid "f1cc30e4-363d-5a0c-8e6b-62f9a78b598b" :answer/type {:db/ident :answer.type/text} :answer/value "The ellipse $\\frac{(y+1)^{2}}{7}+\\frac{{z}^{2}}{2}=1$" :db/id #edb/ref 17592186378372} {:answer/id #uuid "cc57c1c9-2433-50b7-8cfe-eee706a12b10" :answer/type {:db/ident :answer.type/text} :answer/value "The hyperbola $\\frac{(y+1)^{2}}{7}-{z}^{2}=1$" :db/id #edb/ref 17592186378373} {:answer/id #uuid "7de8ba4b-16ac-52db-ac9f-ac63bccdd6ab" :answer/type {:db/ident :answer.type/text} :answer/value "The lines $y=-8$ and $y=6$" :db/id #edb/ref 17592186378374}] :answer-field/correct {:answer/id #uuid "7de8ba4b-16ac-52db-ac9f-ac63bccdd6ab" :answer/type {:db/ident :answer.type/text} :answer/value "The lines $y=-8$ and $y=6$" :db/id #edb/ref 17592186378374} :answer-field/id #uuid "231f7164-5abe-5747-bdc3-dfacad93349e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378369}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3f4340be-3d04-5c7c-97ac-086f5051ce04" :question/math-academy-id "q-164397" :question/problem "What is the trace in the $yz$-plane of the hyperbolic cylinder $\\frac{(x-4)^{2}}{2}-\\frac{(y+1)^{2}}{7}=1?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(0-4)^{2}}{2}-\\frac{(y+1)^{2}}{7} & =1 \\\\ 8-\\frac{(y+1)^{2}}{7} & =1 \\\\ \\frac{(y+1)^{2}}{7} & =7 \\\\ (y+1)^{2} & =49 \\\\ y+1 & =\\pm 7 \\\\ y & =-1\\pm 7 \\\\ y & =-8,6\\end{aligned}\n$$\n\nThis gives us the equation of two lines $y=-8$ and $y=6$ in the $yz$-plane."}] [{:db/id #edb/ref 17592186378375 :knowledge-point/_questions [{:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eee2fe22-a68a-536b-9d82-3a7eec1c2254" :answer/type {:db/ident :answer.type/text} :answer/value "The line $x=4$" :db/id #edb/ref 17592186378377} {:answer/id #uuid "ece15aee-521e-52f4-a573-6e5aa992f3b6" :answer/type {:db/ident :answer.type/text} :answer/value "The line $x=6$" :db/id #edb/ref 17592186378378} {:answer/id #uuid "b810ed96-38f8-552d-8ad6-f9c2fa91cdd7" :answer/type {:db/ident :answer.type/text} :answer/value "The lines $x=2$ and $x=6$" :db/id #edb/ref 17592186378379} {:answer/id #uuid "2ef6d50a-4140-5add-acd4-6fb457a69ada" :answer/type {:db/ident :answer.type/text} :answer/value "The ellipse $\\frac{(x-4)^{2}}{8}+\\frac{{z}^{2}}{2}=1$" :db/id #edb/ref 17592186378380} {:answer/id #uuid "51f7f7ea-49f4-570e-ab98-c5550b226403" :answer/type {:db/ident :answer.type/text} :answer/value "The hyperbola $\\frac{{x}^{2}}{8}-\\frac{(z-1)^{2}}{2}=1$" :db/id #edb/ref 17592186378381}] :answer-field/correct {:answer/id #uuid "b810ed96-38f8-552d-8ad6-f9c2fa91cdd7" :answer/type {:db/ident :answer.type/text} :answer/value "The lines $x=2$ and $x=6$" :db/id #edb/ref 17592186378379} :answer-field/id #uuid "0b914f44-35b0-523c-aab0-bf0b4b6a52be" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378376}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "98ad452f-818a-5095-bf60-3f83ccbaae0f" :question/math-academy-id "q-164401" :question/problem "What is the trace in the $xz$-plane of the elliptic cylinder $\\frac{(x-4)^{2}}{8}+\\frac{(y-1)^{2}}{2}=1?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the cylinder, and simplify:\n\n$$\n\\begin{aligned}\\frac{(x-4)^{2}}{8}+\\frac{(0-1)^{2}}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8}+\\frac{1}{2} & =1 \\\\ \\frac{(x-4)^{2}}{8} & =\\frac{1}{2} \\\\ (x-4)^{2} & =4 \\\\ x-4 & =\\pm 2 \\\\ x & =4\\pm 2 \\\\ x & =2,6\\end{aligned}\n$$\n\nThis gives us the equation of two lines $x=2$ and $x=6$ in the $xz$-plane."}] [{:db/id #edb/ref 17592186378382 :knowledge-point/_questions [{:knowledge-point/id #uuid "abbeda26-2fc0-5195-be26-ae79c72fc7bf" :knowledge-point/title "Traces of Cylinders"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5041b9ec-f7ee-56be-a361-3f9f31cceb46" :answer/type {:db/ident :answer.type/math} :answer/value "(3,2)" :db/id #edb/ref 17592186378384} {:answer/id #uuid "c3270b61-2113-5c94-81db-338949b60a97" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,1)" :db/id #edb/ref 17592186378385} {:answer/id #uuid "67a1dfb3-bf99-586d-bddc-d9a8529b844d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186378386} {:answer/id #uuid "c52e4051-c7e2-5690-8541-148fe0ae52b8" :answer/type {:db/ident :answer.type/math} :answer/value "(2,-1)" :db/id #edb/ref 17592186378387} {:answer/id #uuid "db7437f4-4c60-54c6-9e10-923e451b34a1" :answer/type {:db/ident :answer.type/math} :answer/value "(3,1)" :db/id #edb/ref 17592186378388}] :answer-field/correct {:answer/id #uuid "67a1dfb3-bf99-586d-bddc-d9a8529b844d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1)" :db/id #edb/ref 17592186378386} :answer-field/id #uuid "88284024-50ea-548d-b12b-2b59a7c3b34f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378383}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "53a8baa3-c5ca-5f72-a258-e1c548f3d50d" :question/math-academy-id "q-164414" :question/problem "The projection of the intersection between the parabolic cylinder $4(x-3)^{2}=12(z+1)$ and the plane $y=2$ onto the $xz$-plane is a parabola. What is the vertex of the parabola?" :question/worked-solution "To find the intersection of the cylinder and the plane $y=2,$ we substitute $y=2$ into the equation of the cylinder. However, since the equation has no (explicit) $y$ term, we get\n\n$$\n\\begin{aligned}4(x-3)^{2} & =12(z+1) \\\\ (x-3)^{2} & =3(z+1) \\\\ (x-3)^{2} & =4\\cdot \\frac{3}{4}\\cdot (z+1).\\end{aligned}\n$$\n\nThis gives us the equation of a parabola in the $xz$-plane with the vertex at $(3,-1).$"}] [{:db/id #edb/ref 17592186378389 :knowledge-point/_questions [{:knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "51e3855f-5b97-59ce-b138-47cc0511dda9" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186378391} {:answer/id #uuid "6831a63d-47a0-5e12-910e-3c7cad684ab3" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,-1)$" :db/id #edb/ref 17592186378392} {:answer/id #uuid "1780caa1-88d5-5e41-9411-a1da2456355d" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}:\\text{ }x-y>12}" :db/id #edb/ref 17592186378393} {:answer/id #uuid "3783247e-a290-5f17-bfb7-925ac03ecc13" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(1,0)$" :db/id #edb/ref 17592186378394} {:answer/id #uuid "92ef3af2-0f15-58b1-a509-b5e5d0825f32" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,1)$" :db/id #edb/ref 17592186378395}] :answer-field/correct {:answer/id #uuid "6831a63d-47a0-5e12-910e-3c7cad684ab3" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(0,-1)$" :db/id #edb/ref 17592186378392} :answer-field/id #uuid "cfcf089c-edd2-536c-b72f-3daaf4bd9e87" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378390}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "57563ddb-cece-5702-b61c-95f3f8e1ba05" :question/math-academy-id "q-164416" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }\\frac{{x}^{2}}{3}-\\frac{(y+1)^{2}}{4}=1}.\n$$\n\nThis is a hyperbola centered at $(0,-1).$"}] [{:db/id #edb/ref 17592186378396 :knowledge-point/_questions [{:knowledge-point/id #uuid "36c5224a-eccc-5ea9-8719-2b0dc2ddb44d" :knowledge-point/title "The Domain of a Cylinder"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63ad6b4b-43a3-5c72-96a7-ec080afd3f36" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(3,-6)$" :db/id #edb/ref 17592186378398} {:answer/id #uuid "ef4a3eab-8f65-5c47-8993-ed759bf66d42" :answer/type {:db/ident :answer.type/math} :answer/value "{R}^{2}" :db/id #edb/ref 17592186378399} {:answer/id #uuid "12b7e3d4-3cc1-579a-aedb-c473d51c1feb" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(-3,6)$" :db/id #edb/ref 17592186378400} {:answer/id #uuid "fcabbd70-bebf-5bf3-a79e-bc40509b5017" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(1,2\\sqrt{2})$" :db/id #edb/ref 17592186378401} {:answer/id #uuid "201696d2-22a3-5b1a-b5f6-7126e7b884b7" :answer/type {:db/ident :answer.type/math} :answer/value "{(x,y)\\in {R}^{2}:x\\ge 3}" :db/id #edb/ref 17592186378402}] :answer-field/correct {:answer/id #uuid "63ad6b4b-43a3-5c72-96a7-ec080afd3f36" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola centered at $(3,-6)$" :db/id #edb/ref 17592186378398} :answer-field/id #uuid "c11e257a-7b5b-588f-a7f7-5a4af7d08ff3" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378397}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "691cc452-1ab1-53fd-9832-fbb0b8726da8" :question/math-academy-id "q-164418" :question/problem "What is the domain in the $xy$-plane of the hyperbolic cylinder $(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1?$" :question/worked-solution "The full expression describing all points on our hyperbolic cylinder is\n\n$$\n(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1,\\,z=k\n$$\n\nwhere $k\\in R$ can vary arbitrarily. \n\nThe domain of any cylinder in the $xy$-plane is its base curve. Hence, in this case, the domain is\n\n$$\n{(x,y)\\in {R}^{2}:\\text{ }(x-3)^{2}-\\frac{(y+6)^{2}}{8}=1}.\n$$\n\nThis is a hyperbola centered at $(3,-6).$"}]}
