dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351320" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/activity-metadata.json" "file_sha256" "6a15390178eee87ca05d2f3502c32a44baa8c6e4266127e91909847ae46cbc72" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351320" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"} {"question" "q-351320" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{\\ln(4)}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/state.json" "file_sha256" "03e08d0b709381ddb0be2784c6d272e736fe12b64fff6dfa10bd129efa1200b2" "basis" 1568 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/differential/14042659/edb-import/verification.json"}] "sources" [{"question" "q-152255" "field" nil "attribute" "question/problem" "value" "Evaluate the integral ${\\int }_{0}^{\\infty }\\frac{{3}^{-\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152255" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=\\sqrt{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\text{d}u=\\frac{1}{\\sqrt{x}}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\sqrt{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{3}^{-\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{3}^{-u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{3}^{-\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{3}^{-u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{3}^{-u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{{3}^{-u}}{\\operatorname{ln}⁡3}]}_{0}^{a} \\\\  & =-\\frac{2}{\\operatorname{ln}⁡3}\\cdot {lim}_{a\\to \\infty }{[{3}^{-u}]}_{0}^{a} \\\\  & =-\\frac{2}{\\operatorname{ln}⁡3}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{3}^{a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{3}^{x}},$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\frac{1}{{3}^{x}}=\\infty $\n\n- ${lim}_{x\\to \\infty }\\frac{1}{{3}^{x}}=0$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/assets/ff41c6fa5858f45e76a4d4fec0f0a8080300b69fcb632df60141d93c66f3cdd9.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{3}^{-\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =-\\frac{2}{\\operatorname{ln}⁡3}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{3}^{a}}-1) \\\\  & =-\\frac{2}{\\operatorname{ln}⁡3}\\cdot (0-1) \\\\  & =\\frac{2}{\\operatorname{ln}⁡3}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152255" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/activity-metadata.json" "file_sha256" "bf4385f1489a1e72426f4cbc67a8f202e69f3ca1ea8ac7b40fc50a2a828cb418"} {"question" "q-152255" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152255" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "3\\operatorname{ln}⁡3"] ["math" "\\frac{2}{\\operatorname{ln}⁡3}"] ["math" "\\operatorname{ln}⁡3"] ["text" "The integral diverges"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152255" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{2}{\\operatorname{ln}⁡3}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152874" "field" nil "attribute" "question/problem" "value" "${\\int }_{-\\infty }^{2}{3}^{x}\\,\\text{d}x=$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152874" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{2}{3}^{x}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{2}{3}^{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{{3}^{x}}{\\operatorname{ln}⁡(3)}]}_{a}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}\\cdot {lim}_{a\\to -\\infty }{[{3}^{x}]}_{a}^{2} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}\\cdot {lim}_{a\\to -\\infty }({3}^{2}-{3}^{a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}\\cdot (9-{lim}_{a\\to -\\infty }{3}^{a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={3}^{x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{3}^{x}=0$\n\n- ${lim}_{x\\to \\infty }{3}^{x}=\\infty $\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/assets/abae6131aceb7348a82ea01a544b28a62d8835b7857da14a6339b4ae3b88a1fd.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{3}^{x}\\,\\text{d}x & =\\frac{1}{\\operatorname{ln}⁡(3)}\\cdot (9-{lim}_{a\\to -\\infty }{3}^{a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(3)}\\cdot (9-0) \\\\  & =\\frac{9}{\\operatorname{ln}⁡(3)}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152874" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/activity-metadata.json" "file_sha256" "bf4385f1489a1e72426f4cbc67a8f202e69f3ca1ea8ac7b40fc50a2a828cb418"} {"question" "q-152874" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152874" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "3"] ["math" "9"] ["math" "\\frac{2}{\\operatorname{ln}⁡(3)}"] ["math" "\\frac{3}{\\operatorname{ln}⁡(3)}"] ["math" "\\frac{9}{\\operatorname{ln}⁡(3)}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-152874" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{9}{\\operatorname{ln}⁡(3)}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-346618" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}{x}^{2}\\cdot {5}^{{x}^{3}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-346618" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u={x}^{3}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=3{x}^{2}\\,⟹\\,\\frac{1}{3}\\text{d}u={x}^{2}\\text{d}x.\n$$\n\nSince $u\\to -\\infty $ when $x\\to -\\infty ,$ the table for the limits of integration using the rule $u={x}^{3}$ is as follows:\n\n| $x$ | $0$ | $-\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $-\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n{\\int }_{-\\infty }^{0}{x}^{2}\\cdot {5}^{{x}^{3}}\\,\\text{d}x=\\frac{1}{3}{\\int }_{-\\infty }^{0}{5}^{u}\\,\\text{d}u.\n$$\n\nNow, we proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{x}^{2}\\cdot {5}^{{x}^{3}}\\,\\text{d}x & =\\frac{1}{3}{lim}_{a\\to -\\infty }{\\int }_{a}^{0}{5}^{u}\\,\\text{d}u \\\\  & =\\frac{1}{3}{lim}_{a\\to -\\infty }{[\\frac{{5}^{u}}{\\operatorname{ln}⁡5}]}_{a}^{0} \\\\  & =\\frac{1}{3\\operatorname{ln}⁡5}{lim}_{a\\to -\\infty }[{5}^{u}]_{a}^{0} \\\\  & =\\frac{1}{3\\operatorname{ln}⁡5}{lim}_{a\\to -\\infty }(1-{5}^{a}) \\\\  & =\\frac{1}{3\\operatorname{ln}⁡5}(1-{lim}_{a\\to -\\infty }{5}^{a})\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y={5}^{a},$ shown in the graph below:\n\n- ${lim}_{a\\to -\\infty }{5}^{a}=0$\n\n- ${lim}_{a\\to \\infty }{5}^{a}=\\infty $\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/assets/c0c7699b036ebd8779cd6c3d3143cdcca6312834ee731e144e38488124164f43.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}{x}^{2}\\cdot {5}^{{x}^{3}}\\,\\text{d}x & =\\frac{1}{3\\operatorname{ln}⁡5}(1-{lim}_{a\\to -\\infty }{5}^{a}) \\\\  & =\\frac{1}{3\\operatorname{ln}⁡5}(1-0) \\\\  & =\\frac{1}{3\\operatorname{ln}⁡5}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-346618" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/activity-metadata.json" "file_sha256" "bf4385f1489a1e72426f4cbc67a8f202e69f3ca1ea8ac7b40fc50a2a828cb418"} {"question" "q-346618" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-346618" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{1}{3\\ln(5)}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351320" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{-\\infty }^{0}3\\cdot {4}^{x}\\,\\text{d}x=$\n\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351320" "field" nil "attribute" "question/worked-solution" "value" "We proceed by setting the lower bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to -\\infty .$\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}3\\cdot {4}^{x}\\,\\text{d}x & ={lim}_{a\\to -\\infty }{\\int }_{a}^{0}3\\cdot {4}^{x}\\,\\text{d}x \\\\  & ={lim}_{a\\to -\\infty }{[\\frac{3\\cdot {4}^{x}}{\\operatorname{ln}⁡(4)}]}_{a}^{0} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot {lim}_{a\\to -\\infty }{[3\\cdot {4}^{x}]}_{a}^{0} \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot {lim}_{a\\to -\\infty }(3-3\\cdot {4}^{a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot (3-{lim}_{a\\to -\\infty }3\\cdot {4}^{a})\\end{aligned}\n$$\n\nNow, recall the end behavior of the function $y={4}^{x}$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }{4}^{x}=0$\n\n- ${lim}_{x\\to \\infty }{4}^{x}=\\infty $\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/assets/fd4020291b348d130fc34969d72ff683aab5b6fb95ea5f7d32b90e5245d56d9c.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{-\\infty }^{0}3\\cdot {4}^{x}\\,\\text{d}x & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot (3-{lim}_{a\\to -\\infty }3\\cdot {4}^{a}) \\\\  & =\\frac{1}{\\operatorname{ln}⁡(4)}\\cdot (3-0) \\\\  & =\\frac{3}{\\operatorname{ln}⁡(4)}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351320" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/activity-metadata.json" "file_sha256" "bf4385f1489a1e72426f4cbc67a8f202e69f3ca1ea8ac7b40fc50a2a828cb418"} {"question" "q-351320" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351320" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "\\frac{3}{\\ln(4)}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351511" "field" nil "attribute" "question/problem" "value" "Evaluate the following integral. Do not round the answer.\n\n${\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x=$\n{{field-1}}" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351511" "field" nil "attribute" "question/worked-solution" "value" "First, we substitute $u=\\sqrt{x}.$ Differentiating, we get\n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=\\frac{1}{2\\sqrt{x}}\\,⟹\\,2\\text{d}u=\\frac{1}{\\sqrt{x}}\\text{d}x.\n$$\n\nSince $u\\to \\infty $ when $x\\to \\infty ,$ the table for the limits of integration using the rule $u=\\sqrt{x}$ is as follows:\n\n| $x$ | $0$ | $\\infty $ |\n| --- | --- | --- |\n| $u$ | $0$ | $\\infty $ |\n\nSo, the integral in terms of the new variable $u$ is\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{6}^{-2u}\\,\\text{d}u.\\end{aligned}\n$$\n\nNow, we proceed by setting the upper bound equal to some parameter $a,$ integrating as usual, and then taking the limit as $a\\to \\infty .$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =2{\\int }_{0}^{\\infty }{6}^{-2u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{\\int }_{0}^{a}{6}^{-2u}\\,\\text{d}u \\\\  & =2\\cdot {lim}_{a\\to \\infty }{[-\\frac{{6}^{-2u}}{2\\operatorname{ln}⁡6}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot {lim}_{a\\to \\infty }{[{6}^{-2u}]}_{0}^{a} \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{6}^{2a}}-1)\\end{aligned}\n$$\n\nNext, recall the end behavior of the function $y=\\frac{1}{{6}^{2x}},$ shown in the graph below:\n\n- ${lim}_{x\\to -\\infty }\\frac{1}{{6}^{2x}}=\\infty $\n\n- ${lim}_{x\\to \\infty }\\frac{1}{{6}^{2x}}=0$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/assets/8f732515dd376db40889706419781e02cbedfcd4da8513a09e4f2d77ff88ece2.png)\n\nUsing this to evaluate our integral, we conclude that\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\infty }\\frac{{6}^{-2\\sqrt{x}}}{\\sqrt{x}}\\,\\text{d}x & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot ({lim}_{a\\to \\infty }\\frac{1}{{6}^{2a}}-1) \\\\  & =-\\frac{1}{\\operatorname{ln}⁡6}\\cdot (0-1) \\\\  & =\\frac{1}{\\operatorname{ln}⁡6}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351511" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/activity-metadata.json" "file_sha256" "bf4385f1489a1e72426f4cbc67a8f202e69f3ca1ea8ac7b40fc50a2a828cb418"} {"question" "q-351511" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14067475/state.json" "file_sha256" "8c31a57d49b56c5521afbe67193a27da20296cac84353ec0e1788f56f49b8bdf"} {"question" "q-351511" "field"