ormation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9e4b9b84-9cb3-5763-838b-3b5875e216f0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186091536} {:answer/id #uuid "e64b81cf-7659-5814-a62c-ce4c6ac6adf5" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186091537} {:answer/id #uuid "02254ae3-ebf5-5670-8a54-38bbb599a878" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186091538} {:answer/id #uuid "1d1b0cf8-4e2a-55c0-8eaf-99acc8d406e9" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186091539} {:answer/id #uuid "229409ec-9cbd-5edc-8f28-cf8afc1d7c50" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186091540}] :answer-field/correct {:answer/id #uuid "9e4b9b84-9cb3-5763-838b-3b5875e216f0" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186091536} :answer-field/id #uuid "be781637-b41c-5dbe-b2ab-7f6ceb906bb4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186091535}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fdc48455-0a40-5b7f-be99-05aa87be4ff6" :question/math-academy-id "q-9294" :question/problem "What is the area scale factor of the linear transformation $T$ that is given by its standard matrix \n\n$$\nT=[\\begin{aligned}1 & 5 \\\\ 0 & -2\\end{aligned}]?\n$$" :question/worked-solution "The area scale factor of a linear transformation $T$ with standard matrix $T$ is equal to $|det(T)|.$ Therefore,\n\n$$\n\\begin{aligned}|det(T)| & =|1\\cdot (-2)-5\\cdot 0| \\\\  & =|-2-0| \\\\  & =2.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186303300 :knowledge-point/_questions [{:knowledge-point/id #uuid "4d59733f-3396-5d59-98a9-3f2e0ccfbbc4" :knowledge-point/title "Calculating the Area of the Image of an Object Under a Linear Transformation Given a Diagram"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "63131879-2b6e-5b83-83dd-a031a832723b" :answer/type {:db/ident :answer.type/math} :answer/value "-66" :db/id #edb/ref 17592186303302} {:answer/id #uuid "300a3c35-9bdc-526e-a0e2-a3e1c6d3da61" :answer/type {:db/ident :answer.type/math} :answer/value "11" :db/id #edb/ref 17592186303303} {:answer/id #uuid "b1a00c06-8cc0-5ba1-9c02-5af4e0877c33" :answer/type {:db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186303304} {:answer/id #uuid "8ff9ee8f-390b-513b-9a00-66b2db1dd708" :answer/type {:db/ident :answer.type/math} :answer/value "23" :db/id #edb/ref 17592186303305} {:answer/id #uuid "bf97bd72-0294-51d9-9663-7987a2190c25" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186303306}] :answer-field/correct {:answer/id #uuid "b1a00c06-8cc0-5ba1-9c02-5af4e0877c33" :answer/type {:db/ident :answer.type/math} :answer/value "66" :db/id #edb/ref 17592186303304} :answer-field/id #uuid "e1d90599-afa5-593e-84e0-cb850f9e6efe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186303301}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c827fba0-90ed-5026-9ebc-6dd1e8034231" :question/math-academy-id "q-9309" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039564/assets/bd50e99a129b1d6a2c6b73145dbf68681bc92a3cef0ca8e743b63cf96c9afafc.png)\n\nConsider the shaded region $D$ shown above. What is the area of the image of $D$ under the action of the linear transformation $T$ with the standard matrix $T,$ given below?\n\n$$\nT=[\\begin{aligned}2 & 5 \\\\ -1 & 3\\end{aligned}].\n$$" :question/worked-solution "Recall that for any linear transformation $T,$ we have the following connection between the area of $D$ and the area of the image $T(D)$ under the action of $T:$\n\n$$\n\\text{Area}(T(D))=|det(T)|\\cdot \\text{Area}(D).\n$$\n\nFrom the diagram, we have\n\n$$\n\\text{Area}(D)=\\frac{1}{2}\\cdot 2\\cdot (2+4)=6.\n$$\n\nComputing the determinant of $T,$ we get \n\n$$\ndet(T)=2\\cdot 3-5\\cdot (-1)=11.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\text{Area}(T(D)) & =|det(T)|\\cdot \\text{Area}(D) \\\\  & =|\\,11\\,|\\cdot 6 \\\\  & =66.\\end{aligned}\n$$"}]}
