t }_{1}^{\\sqrt{2}}\\frac{1}{2}|\\operatorname{sin}⁡(2\\theta )|\\cdot r\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{1}^{\\sqrt{2}}r\\,\\text{d}r\\cdot {\\int }_{0}^{2\\pi }\\frac{1}{2}|\\operatorname{sin}⁡(2\\theta )|\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}{r}^{2}{|}_{1}^{\\sqrt{2}}\\cdot {\\int }_{0}^{\\pi /2}2\\operatorname{sin}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{2}(2-1)\\cdot [-\\operatorname{cos}⁡(2\\theta )]_{0}^{\\pi /2} \\\\  & =\\frac{1}{2}\\cdot (-\\operatorname{cos}⁡(\\pi )+\\operatorname{cos}⁡(0)) \\\\  & =1\\,\\text{kg}\\end{aligned}\n$$\n\nThen, the moment of inertia about the perpendicular line through the center of mass is\n\n$$\n\\begin{aligned}{I}_{M} & ={∬}_{D}\\lambda (r,\\theta )\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{0}^{2\\pi }{\\int }_{1}^{\\sqrt{2}}\\frac{1}{2}|\\operatorname{sin}⁡(2\\theta )|\\cdot {r}^{3}\\,\\text{d}r\\,\\text{d}\\theta  \\\\  & ={\\int }_{1}^{\\sqrt{2}}{r}^{3}\\,\\text{d}r\\cdot {\\int }_{0}^{2\\pi }\\frac{1}{2}|\\operatorname{sin}⁡(2\\theta )|\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}{r}^{4}{|}_{1}^{\\sqrt{2}}\\cdot {\\int }_{0}^{\\pi /2}2\\operatorname{sin}⁡(2\\theta )\\,\\text{d}\\theta  \\\\  & =\\frac{1}{4}(4-1)\\cdot [-\\operatorname{cos}⁡(2\\theta )]_{0}^{\\pi /2} \\\\  & =\\frac{3}{4}\\cdot (-\\operatorname{cos}⁡(\\pi )+\\operatorname{cos}⁡(0)) \\\\  & =\\frac{3}{2}\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$\n\nFinally, applying the parallel axis theorem, the moment of inertia about a line $3\\,\\text{m}$ from the center of mass is\n\n$$\n\\begin{aligned}I & ={I}_{M}+{d}^{2}M \\\\  & =\\frac{3}{2}+{3}^{2}\\cdot 1 \\\\  & =\\frac{3}{2}+9 \\\\  & =\\frac{21}{2}\\,\\text{kg}\\cdot {\\text{m}}^{2}.\\end{aligned}\n$$" 13194139535862 true] [17592186371108 1000 #edb/ref 17592186371109 13194139535862 true] [17592186371108 1000 #edb/ref 17592186371110 13194139535862 true] [17592186371108 1000 #edb/ref 17592186371111 13194139535862 true] [17592186371108 1000 #e