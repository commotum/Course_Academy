#{[{:db/id #edb/ref 17592186257268 :knowledge-point/_questions [{:knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "5ca617c8-ae0c-50ae-9246-ed19fda55c63" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186257270}] :answer-field/correct {:answer/id #uuid "5ca617c8-ae0c-50ae-9246-ed19fda55c63" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186257270} :answer-field/id #uuid "42064ebd-20a9-5478-a842-ced33dee8f82" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186257269}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6548405c-a613-5075-b99b-e7774982d1db" :question/math-academy-id "q-118780" :question/problem "What is the order of the ordinary differential equation ${x}^{2}\\frac{{\\text{d}}^{7}y}{\\text{d}{x}^{7}}-9{x}^{7}\\frac{\\text{d}y}{\\text{d}x}=2\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}}?$\n\nAnswer: {{answer}}" :question/worked-solution "The order of an ordinary differential equation (ODE) is the order of the highest derivative in the equation.\n\nThe highest derivative in the given ODE is $\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}},$ which has order $8.$\n\nTherefore, the order of the ODE is $8.$"}]}
