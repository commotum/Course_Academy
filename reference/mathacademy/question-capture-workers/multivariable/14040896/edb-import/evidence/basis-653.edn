#{[{:db/id #edb/ref 17592186257268 :knowledge-point/_questions [{:knowledge-point/id #uuid "443c0bd0-2e77-50a8-91d3-a288d4ee852b" :knowledge-point/title "Identifying the Order of an Ordinary Differential Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0e1d02e3-1b5e-51c8-96be-c665bb1324fc" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270327} {:answer/id #uuid "10920157-994c-5967-94ea-654819d7c344" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186270328} {:answer/id #uuid "8dd026e4-ef7d-57ed-8d1f-e657c0a9f463" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186270329} {:answer/id #uuid "0fb63b53-9671-5e10-9637-b4c2709d0eda" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186270330} {:answer/id #uuid "d9eb3aac-221f-5d5d-9686-a05db6f1e542" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186270331}] :answer-field/correct {:answer/id #uuid "0e1d02e3-1b5e-51c8-96be-c665bb1324fc" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186270327} :answer-field/id #uuid "22750716-65c7-5faf-90fe-b39eae8b08db" :answer-field/key "answer" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186274341}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6548405c-a613-5075-b99b-e7774982d1db" :question/math-academy-id "q-118780" :question/problem "What is the order of the ordinary differential equation ${x}^{2}\\frac{{\\text{d}}^{7}y}{\\text{d}{x}^{7}}-9{x}^{7}\\frac{\\text{d}y}{\\text{d}x}=2\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}}?$" :question/worked-solution "The order of an ordinary differential equation (ODE) is the order of the highest derivative in the equation.\n\nThe highest derivative in the given ODE is $\\frac{{\\text{d}}^{8}y}{\\text{d}{x}^{8}},$ which has order $8.$\n\nTherefore, the order of the ODE is $8.$"}]}
