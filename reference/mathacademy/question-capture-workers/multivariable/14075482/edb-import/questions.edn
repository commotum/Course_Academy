3}$" :db/id #edb/ref 17592186122744} :answer-field/id #uuid "723cd123-83f5-514c-9f95-fcfbe9f37206" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122740}] :question/id #uuid "9c5f2ee6-6fd1-5aaa-9eb1-2be5fdb9c6ac" :question/math-academy-id "q-37162" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/1947/Source/Images/q-37162.png)\n\nFind the global extrema of the function $f(x, y) = x^{2}y$ on the closed region $D = {(x, y): x \\ge 0, y \\ge 0, x^{2} + y^{2} \\le 9}$, shown above."}] [{:db/id #edb/ref 17592186124979 :knowledge-point/_questions [{:knowledge-point/id #uuid "e38cefde-a663-56de-a81d-dcea6fed89b3" :knowledge-point/title "Finding Global Maxima and Minima Given the Critical Points Inside the Function's Domain"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a17e3f97-d4d0-5a4f-9398-458a80d4ca7a" :answer/type {:db/ident :answer.type/math} :answer/value "-2e" :db/id #edb/ref 17592186122897} {:answer/id #uuid "bc299349-cae0-53e6-93c4-34d8a0a99f8f" :answer/type {:db/ident :answer.type/math} :answer/value "2e" :db/id #edb/ref 17592186122898} {:answer/id #uuid "e0294f1e-dc58-5ebe-ad6b-e2444814ab39" :answer/type {:db/ident :answer.type/math} :answer/value "-e" :db/id #edb/ref 17592186122899} {:answer/id #uuid "16b501ed-c7ff-50ed-bce3-38e8adc92e1b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186122900} {:answer/id #uuid "5fe88d04-e54a-5e2c-b20f-bcfb897ab9c0" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186122901}] :answer-field/correct {:answer/id #uuid "16b501ed-c7ff-50ed-bce3-38e8adc92e1b" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186122900} :answer-field/id #uuid "b00ecd4d-fabe-5a72-8371-71725686a073" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122896}] :question/id #uuid "14add615-dec7-5e1