#{[{:db/id #edb/ref 17592186360056 :knowledge-point/_questions [{:knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3987f7d3-8518-5cd6-828a-8d0b7c9995f6" :answer/type {:db/ident :answer.type/math} :answer/value "(3,4,-1)" :db/id #edb/ref 17592186360058} {:answer/id #uuid "5d6853e3-b4f3-54f8-81c6-f5bc1e71e670" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-3,-4)" :db/id #edb/ref 17592186360059} {:answer/id #uuid "59f9274b-fd01-5774-a841-fb71e49f5365" :answer/type {:db/ident :answer.type/math} :answer/value "(3,1,4)" :db/id #edb/ref 17592186360060} {:answer/id #uuid "c1e9261f-1059-5e02-b419-bb13e120dde1" :answer/type {:db/ident :answer.type/math} :answer/value "(4,3,-1)" :db/id #edb/ref 17592186360061} {:answer/id #uuid "b35ff90d-9d19-55f8-bf36-74fd2d952b20" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1,-4)" :db/id #edb/ref 17592186360062}] :answer-field/correct {:answer/id #uuid "b35ff90d-9d19-55f8-bf36-74fd2d952b20" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-1,-4)" :db/id #edb/ref 17592186360062} :answer-field/id #uuid "882fdc94-66dd-5350-a4b1-9d09e841c0a0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360057}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c12711ba-8eec-56d7-b5e7-2963addec53e" :question/math-academy-id "q-164273" :question/problem "Find the saddle point of the hyperbolic paraboloid $z+4=\\frac{(x-3)^{2}}{2}-\\frac{(y+1)^{2}}{3}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+4 & =\\frac{(x-3)^{2}}{2}-\\frac{(y+1)^{2}}{3} \\\\ z-(-4) & =\\frac{(x-3)^{2}}{2}-\\frac{(y-(-1))^{2}}{4}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(3,-1,-4).$"}] [{:db/id #edb/ref 17592186360063 :knowledge-point/_questions [{:knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" :knowledge-point/title "Finding Traces of Paraboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9a3b916d-b513-561e-90f9-81d0bb750974" :answer/type {:db/ident :answer.type/text} :answer/value "Two parallel lines: $x=2(z\\pm 5)$" :db/id #edb/ref 17592186360065} {:answer/id #uuid "214649ea-719d-5e4f-8100-63d6050cc205" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola: ${x}^{2}-3{z}^{2}=1$" :db/id #edb/ref 17592186360066} {:answer/id #uuid "87f38f76-14ee-5822-a8b2-a87f55e735b9" :answer/type {:db/ident :answer.type/text} :answer/value "Two intersecting lines: $x=\\pm (z+5)$" :db/id #edb/ref 17592186360067} {:answer/id #uuid "f8fbc51c-42a4-5da9-ac81-40d2958a168e" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola: ${x}^{2}=2(z+5)$" :db/id #edb/ref 17592186360068} {:answer/id #uuid "80396377-7b50-545b-9e88-a3191f0a8863" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola: ${x}^{2}=2(z+2)$" :db/id #edb/ref 17592186360069}] :answer-field/correct {:answer/id #uuid "f8fbc51c-42a4-5da9-ac81-40d2958a168e" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola: ${x}^{2}=2(z+5)$" :db/id #edb/ref 17592186360068} :answer-field/id #uuid "062b839d-4d92-5c7f-a6f3-bb66c6f0b777" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360064}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f45880df-c52f-527b-82a1-f3c233e68091" :question/math-academy-id "q-164279" :question/problem "What is the trace in the $xz$-plane of the hyperbolic paraboloid $z+2=\\frac{{x}^{2}}{2}-\\frac{(y+3)^{2}}{3}?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}z+2 & =\\frac{{x}^{2}}{2}-\\frac{(0+3)^{2}}{3} \\\\ z+2 & =\\frac{{x}^{2}}{2}-\\frac{9}{3} \\\\ z+2 & =\\frac{{x}^{2}}{2}-3 \\\\ z+5 & =\\frac{{x}^{2}}{2} \\\\ {x}^{2} & =2(z+5)\\end{aligned}\n$$\n\n \n\nThis gives us the equation of the parabola in $xz$-plane."}] [{:db/id #edb/ref 17592186124839 :knowledge-point/_questions [{:knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d" :knowledge-point/title "Finding Traces of Paraboloids"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8c2ab897-7b63-54ec-bdce-d9a544b71148" :answer/type {:db/ident :answer.type/text} :answer/value "A hyperbola: $4x^{2} - y^{2} = 1$" :db/id #edb/ref 17592186122057} {:answer/id #uuid "d46fb769-b040-5b80-bb5d-08739ecb9b4f" :answer/type {:db/ident :answer.type/text} :answer/value "Two intersecting lines: $y = ± 4(x - 3)$" :db/id #edb/ref 17592186122058} {:answer/id #uuid "124070b8-7c23-5e3f-92ad-5c801c96309a" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola: $y^{2} = 4(z - 3)$" :db/id #edb/ref 17592186122059} {:answer/id #uuid "29243008-ff88-5e72-b7cb-d35a8ed8debd" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola: $y^{2} =-4(z - 8)$" :db/id #edb/ref 17592186122060} {:answer/id #uuid "3aca7c9d-cbae-5530-8bf3-24b219b11bad" :answer/type {:db/ident :answer.type/text} :answer/value "Two parallel lines: $y = 4(x ± 5)$" :db/id #edb/ref 17592186122061}] :answer-field/correct {:answer/id #uuid "29243008-ff88-5e72-b7cb-d35a8ed8debd" :answer/type {:db/ident :answer.type/text} :answer/value "A parabola: $y^{2} =-4(z - 8)$" :db/id #edb/ref 17592186122060} :answer-field/id #uuid "f06923e8-9716-5eb9-bf8a-c82c7667245d" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122056}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "675d871f-22c6-5fe3-b40e-bf98ef3dc757" :question/math-academy-id "q-35844" :question/problem "What is the trace in the $yz$-plane of the hyperbolic paraboloid $z-3=\\frac{(x-5)^{2}}{5}-\\frac{{y}^{2}}{4}?$" :question/worked-solution "To find the trace in the $yz$-plane, we substitute $x=0$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}z-3 & =\\frac{(0-5)^{2}}{5}-\\frac{{y}^{2}}{4} \\\\ z-3 & =\\frac{25}{5}-\\frac{{y}^{2}}{4} \\\\ z-3 & =5-\\frac{{y}^{2}}{4} \\\\ z-8 & =-\\frac{{y}^{2}}{4} \\\\ {y}^{2} & =-4(z-8)\\end{aligned}\n$$\n\n \n\nThis gives us the equation of the parabola in $yz$-plane."}] [{:db/id #edb/ref 17592186124847 :knowledge-point/_questions [{:knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e" :knowledge-point/title "Identifying Properties of an Elliptic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8acb1349-6814-5d5b-a8da-07c785e04ac9" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0, 0)$ and $(16, 0, 0)$" :db/id #edb/ref 17592186122105} {:answer/id #uuid "9d0968dd-d4a6-5ce8-baa2-dcceb3c31c7f" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ only" :db/id #edb/ref 17592186122106} {:answer/id #uuid "c84edced-2515-5914-928f-29ab6e68498e" :answer/type {:db/ident :answer.type/text} :answer/value "$(-2, 0, 0)$ and $(2, 0, 0)$" :db/id #edb/ref 17592186122107} {:answer/id #uuid "cfa293b3-ac44-54b8-bc8d-e910b31a6718" :answer/type {:db/ident :answer.type/text} :answer/value "$(2, 0, 0)$ only" :db/id #edb/ref 17592186122108} {:answer/id #uuid "f40f138f-297b-58be-9f8f-7b35c454bd39" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0, 0)$ only" :db/id #edb/ref 17592186122109}] :answer-field/correct {:answer/id #uuid "f40f138f-297b-58be-9f8f-7b35c454bd39" :answer/type {:db/ident :answer.type/text} :answer/value "$(0, 0, 0)$ only" :db/id #edb/ref 17592186122109} :answer-field/id #uuid "a5532ae9-5d10-5c87-b93f-09a3cd4ab35c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122104}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "938dd95e-5436-5743-9e59-f40c992dba34" :question/math-academy-id "q-35927" :question/problem "Given the elliptic paraboloid $z+4=\\frac{{x}^{2}}{4}+\\frac{(y-4)^{2}}{4}$, find its intercepts with the $x$-axis." :question/worked-solution "To find the $x$-intercepts of the paraboloid, we substitute $y=0$ and $z=0$ into the equation of the paraboloid and solve for $x:$\n\n$$\n\\begin{aligned}0+4 & =\\frac{{x}^{2}}{4}+\\frac{(0-4)^{2}}{4} \\\\ 4 & =\\frac{{x}^{2}}{4}+\\frac{16}{4} \\\\ 4 & =\\frac{{x}^{2}}{4}+4 \\\\ \\frac{{x}^{2}}{4} & =0\\end{aligned}\n$$\n\nThis gives the solution $x=0$\n\nTherefore, the intercept with the $x$-axis is $(0,0,0)$ only."}] [{:db/id #edb/ref 17592186360070 :knowledge-point/_questions [{:knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e" :knowledge-point/title "Identifying Properties of a Hyperbolic Paraboloid"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "465d0522-44cf-5983-b966-2ec47c1c7217" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-3,8)" :db/id #edb/ref 17592186360072} {:answer/id #uuid "c8261ad0-2fe4-5a20-93d0-6df971ab3004" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-3,-8)" :db/id #edb/ref 17592186360073} {:answer/id #uuid "73f45730-cf9d-5a64-a22a-2c6f740539f0" :answer/type {:db/ident :answer.type/math} :answer/value "(1,-9,-8)" :db/id #edb/ref 17592186360074} {:answer/id #uuid "5e668b03-c96e-5df3-a01c-4226cd04de77" :answer/type {:db/ident :answer.type/math} :answer/value "(1,9,8)" :db/id #edb/ref 17592186360075} {:answer/id #uuid "b1bb1124-5686-5d5d-98d4-948cb40ed59e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-9,-8)" :db/id #edb/ref 17592186360076}] :answer-field/correct {:answer/id #uuid "b1bb1124-5686-5d5d-98d4-948cb40ed59e" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-9,-8)" :db/id #edb/ref 17592186360076} :answer-field/id #uuid "2ad2d5f0-98de-5be3-abe7-86be2ff4f4b1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360071}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a07483b8-7faf-5dee-8953-5700864918ad" :question/math-academy-id "q-73864" :question/problem "Find the saddle point of the hyperbolic paraboloid $z+8={x}^{2}-(y+9)^{2}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+8 & ={x}^{2}-(y+9)^{2} \\\\ z-(-8) & =\\frac{(x-0)^{2}}{1}-\\frac{(y-(-9))^{2}}{1}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(0,-9,-8).$"}]}
