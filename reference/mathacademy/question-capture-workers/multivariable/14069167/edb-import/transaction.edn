araboloid with a saddle point at $(0,-9,-8).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-73864/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e"] :knowledge-point/questions ["q-73864"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164273/selection/1f32209181f682e3bf2e713b0a8bd90a44ceb76d1892e5f89fe000e53ac2ce12" :answer/id #uuid "3987f7d3-8518-5cd6-828a-8d0b7c9995f6" :answer/type :answer.type/math :answer/value "(3,4,-1)" :db/ensure [:answer/validate]} {:db/id "q-164273/selection/53a01b1435b57bebd3d551fb11c0e5edebe46c368ad882f4993d4874643fe956" :answer/id #uuid "5d6853e3-b4f3-54f8-81c6-f5bc1e71e670" :answer/type :answer.type/math :answer/value "(1,-3,-4)" :db/ensure [:answer/validate]} {:db/id "q-164273/selection/7319220eb83d41b404d3813ec84e72f97864689c8c0aed2bf0ddcc676fdc7ef6" :answer/id #uuid "c1e9261f-1059-5e02-b419-bb13e120dde1" :answer/type :answer.type/math :answer/value "(4,3,-1)" :db/ensure [:answer/validate]} {:db/id "q-164273/selection/7af5c2f6e1423a8ccec86efe0a2922530f5602a9fe396fdd9bd66712fa208693" :answer/id #uuid "b35ff90d-9d19-55f8-bf36-74fd2d952b20" :answer/type :answer.type/math :answer/value "(3,-1,-4)" :db/ensure [:answer/validate]} {:db/id "q-164273/selection/683c32b798c7ba73ac97c1c2863c517b23e5ee6ea1a00e0034ea74c75e280599" :answer/id #uuid "59f9274b-fd01-5774-a841-fb71e49f5365" :answer/type :answer.type/math :answer/value "(3,1,4)" :db/ensure [:answer/validate]} {:db/id "q-164273/selection" :answer-field/id #uuid "882fdc94-66dd-5350-a4b1-9d09e841c0a0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164273/selection/7af5c2f6e1423a8ccec86efe0a2922530f5602a9fe396fdd9bd66712fa208693" :answer-field/choices ["q-164273/selection/1f32209181f682e3bf2e713b0a8bd90a44ceb76d1892e5f89fe000e53ac2ce12" "q-164273/selection/53a01b1435b57bebd3d551fb11c0e5edebe46c368ad882f4993d4874643fe956" "q-164273/selection/7319220eb83d41b404d3813ec84e72f97864689c8c0aed2bf0ddcc676fdc7ef6" "q-164273/selection/7af5c2f6e1423a8ccec86efe0a2922530f5602a9fe396fdd9bd66712fa208693" "q-164273/selection/683c32b798c7ba73ac97c1c2863c517b23e5ee6ea1a00e0034ea74c75e280599"] :db/ensure [:answer-field/validate]} {:db/id "q-164273" :question/id #uuid "c12711ba-8eec-56d7-b5e7-2963addec53e" :question/math-academy-id "q-164273" :question/problem "Find the saddle point of the hyperbolic paraboloid $z+4=\\frac{(x-3)^{2}}{2}-\\frac{(y+1)^{2}}{3}.$" :question/worked-solution "The general equation of a hyperbolic paraboloid with a saddle point at $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}-\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the saddle point, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}z+4 & =\\frac{(x-3)^{2}}{2}-\\frac{(y+1)^{2}}{3} \\\\ z-(-4) & =\\frac{(x-3)^{2}}{2}-\\frac{(y-(-1))^{2}}{4}\\end{aligned}\n$$\n\nThis gives us the equation of a hyperbolic paraboloid with a saddle point at $(3,-1,-4).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164273/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e9078ab1-37a4-5e96-ae12-a83d5cd8804e"] :knowledge-point/questions ["q-164273"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164279/selection/f1f88b73f952329b9c343f7391fb6401de7d8ceab02106912761add383cc90f9" :answer/id #uuid "80396377-7b50-545b-9e88-a3191f0a8863" :answer/type :answer.type/text :answer/value "A parabola: ${x}^{2}=2(z+2)$" :db/ensure [:answer/validate]} {:db/id "q-164279/selection/10f64842d59f7661868a45cc11a4df7712591711b3ba814fee82e0f1c02d6d77" :answer/id #uuid "9a3b916d-b513-561e-90f9-81d0bb750974" :answer/type :answer.type/text :answer/value "Two parallel lines: $x=2(z\\pm 5)$" :db/ensure [:answer/validate]} {:db/id "q-164279/selection/8b52ce6fa2f3ec9bd92db0fd00f709ccaec3293c78690061d81c935e1d6da9bc" :answer/id #uuid "f8fbc51c-42a4-5da9-ac81-40d2958a168e" :answer/type :answer.type/text :answer/value "A parabola: ${x}^{2}=2(z+5)$" :db/ensure [:answer/validate]} {:db/id "q-164279/selection/46186349cc8c36a1b55a7992ea9ebd832a63da890eb53e0a1f9b0f7a88ca6a21" :answer/id #uuid "214649ea-719d-5e4f-8100-63d6050cc205" :answer/type :answer.type/text :answer/value "A hyperbola: ${x}^{2}-3{z}^{2}=1$" :db/ensure [:answer/validate]} {:db/id "q-164279/selection/5d2fbfc7307eac61bb817640186a55d94bd8489aac201e644141d7a05014673d" :answer/id #uuid "87f38f76-14ee-5822-a8b2-a87f55e735b9" :answer/type :answer.type/text :answer/value "Two intersecting lines: $x=\\pm (z+5)$" :db/ensure [:answer/validate]} {:db/id "q-164279/selection" :answer-field/id #uuid "062b839d-4d92-5c7f-a6f3-bb66c6f0b777" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164279/selection/8b52ce6fa2f3ec9bd92db0fd00f709ccaec3293c78690061d81c935e1d6da9bc" :answer-field/choices ["q-164279/selection/f1f88b73f952329b9c343f7391fb6401de7d8ceab02106912761add383cc90f9" "q-164279/selection/10f64842d59f7661868a45cc11a4df7712591711b3ba814fee82e0f1c02d6d77" "q-164279/selection/8b52ce6fa2f3ec9bd92db0fd00f709ccaec3293c78690061d81c935e1d6da9bc" "q-164279/selection/46186349cc8c36a1b55a7992ea9ebd832a63da890eb53e0a1f9b0f7a88ca6a21" "q-164279/selection/5d2fbfc7307eac61bb817640186a55d94bd8489aac201e644141d7a05014673d"] :db/ensure [:answer-field/validate]} {:db/id "q-164279" :question/id #uuid "f45880df-c52f-527b-82a1-f3c233e68091" :question/math-academy-id "q-164279" :question/problem "What is the trace in the $xz$-plane of the hyperbolic paraboloid $z+2=\\frac{{x}^{2}}{2}-\\frac{(y+3)^{2}}{3}?$" :question/worked-solution "To find the trace in the $xz$-plane, we substitute $y=0$ into the equation of the paraboloid, and simplify:\n\n$$\n\\begin{aligned}z+2 & =\\frac{{x}^{2}}{2}-\\frac{(0+3)^{2}}{3} \\\\ z+2 & =\\frac{{x}^{2}}{2}-\\frac{9}{3} \\\\ z+2 & =\\frac{{x}^{2}}{2}-3 \\\\ z+5 & =\\frac{{x}^{2}}{2} \\\\ {x}^{2} & =2(z+5)\\end{aligned}\n$$\n\n \n\nThis gives us the equation of the parabola in $xz$-plane." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164279/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "dff86a8b-7966-53f7-a7bc-287990fb611d"] :knowledge-point/questions ["q-164279"] :db/ensure [:knowledge-point/validate]}]
