3b" :answer/id #uuid "480458c9-af0c-5887-addd-968d02085151" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-161333/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" :answer/id #uuid "92f1c375-dd69-5782-ac2d-a5c2baf94fd4" :answer/type :answer.type/math :answer/value "7" :db/ensure [:answer/validate]} {:db/id "q-161333/selection/4fa5117d21d712c019f29d976e735183b75475142130e285bdeeec7a67738baf" :answer/id #uuid "042b27fb-7859-5d28-9282-bf72b899ee3f" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡2+1" :db/ensure [:answer/validate]} {:db/id "q-161333/selection" :answer-field/id #uuid "8ef6cadd-9e4a-5a15-a6d7-4fcefa156130" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-161333/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-161333/selection/634196fc9bb48033d39ff9813af63434068332cb8c836d13c5213b0cd4323e90" "q-161333/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-161333/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-161333/selection/7f2aea1619f9c4cbe5384e0826442d82ebdb1ac614452244ced54b63c0c77efe" "q-161333/selection/4fa5117d21d712c019f29d976e735183b75475142130e285bdeeec7a67738baf"] :db/ensure [:answer-field/validate]} {:db/id "q-161333" :question/id #uuid "2eec7c1e-5bc0-58bd-8226-fb581d3a8e67" :question/math-academy-id "q-161333" :question/problem "$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{a}^{b}{\\int }_{∗}^{∗}{\\int }_{∗}^{∗}f(x,y,z)\\,dz\\,dx\\,dy\n$$\n\nGiven that the triple integral above is considered over the rectangular box\n\n$$\nR={(x,y,z)\\,:\\,-1\\le x\\le 3,\\,1\\le y\\le 4,\\,0\\le z\\le \\operatorname{ln}⁡2},\n$$\n\nwhat is the value of $a+b?$" :question/worked-solution "Writing down our triple integral as a repeated integral, we obtain\n\n$$\n{∭}_{R}f(x,y,z)\\,\\text{d}V={\\int }_{1}^{4}{\\int }_{-1}^{3}{\\int }_{0}^{\\operatorname{ln}⁡2}f(x,y,z)\\,dz\\,dx\\,dy.\n$$\n\nTherefore, $a+b=1+4=5.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-161333/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6d3a0d58-20a3-570d-91e7-aa8f10dafb5a"] :knowledge-point/questions ["q-161333"] :db/ensure [:knowledge-point/validate]} {:db/id "q-161337/selection/cbe0e2708c77d63efbcf34319e6fb785e7a5bd59ba1cbe4fb2abca9a4d0f99c5" :answer/id #uuid "0177b74c-6231-50d3-8a32-bbd5bdafea19" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}{\\int }_{0}^{5}{\\int }_{-1}^{3}{x}^{2}+xy+{z}^{2}\\,\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-161337/selection/74d7987ed2dc8b5376aa052f43c79adc67c25c91f2fbbd2cee50eb5f55788810" :answer/id #uuid "343e859f-73e0-5dec-9ce9-719b4e51824a" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}{\\int }_{1}^{4}{\\int }_{-1}^{3}{x}^{2}+xy+{z}^{2}\\,\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-161337/selection/b8d08ca4754fa496e7066f14d1bfbd7e8e55562b6b1722edd438e357d5ee326a" :answer/id #uuid "edabf4cf-97af-5fb3-ad01-2a5e89e4a827" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{3}{\\int }_{0}^{5}{\\int }_{1}^{4}{x}^{2}+xy+{z}^{2}\\,\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-161337/selection/21d51301e60d77b3d958f359728f60297326fb37da6fdb2cd88d16192a3ebbdd" :answer/id #uuid "396d048c-56c4-50c0-8fe2-18614578cac8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{5}{\\int }_{-1}^{3}{\\int }_{1}^{4}{x}^{2}+xy+{z}^{2}\\,\\,\\text{d}y\\,\\text{d}x\\,\\text{d}z" :db/ensure [:answer/validate]} {:db/id "q-161337/selection/5ef45ea43cf1cb7bee35e9600590ed25aef367a6bff3ce717aa0d18489a6f738" :answer/id #uuid "2256324c-b54a-5a96-be0d-e4a80ee7bea5" :answer/type :answer.type/math :answer/value "{\\int }_{-1}^{3}{\\int }_{1}^{4}{\\int }_{0}^{5}{x}^{2}+xy+{z}^{2}\\,\\,\\text