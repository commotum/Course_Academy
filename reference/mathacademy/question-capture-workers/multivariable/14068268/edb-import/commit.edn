715 true] [17592186362938 1034 "\\frac{9}{2}" 13194139535715 true] [17592186362938 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362938 1111 #uuid "1110a5b7-850e-53ea-b900-dece9029130d" 13194139535715 true] [17592186362939 1034 "9" 13194139535715 true] [17592186362939 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362939 1111 #uuid "9c3ca8e3-7cac-5748-9af6-d13bb06171dd" 13194139535715 true] [17592186362940 1034 "3" 13194139535715 true] [17592186362940 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362940 1111 #uuid "a0322883-e49b-5298-9a1e-f29204a9f4b1" 13194139535715 true] [17592186362941 1034 "\\frac{11}{3}" 13194139535715 true] [17592186362941 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362941 1111 #uuid "c044b365-973d-5b7d-a554-6e06b9a48b2a" 13194139535715 true] [17592186362942 1034 "6" 13194139535715 true] [17592186362942 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362942 1111 #uuid "1007df5d-422e-5ae5-b75d-6154d8caac75" 13194139535715 true] [17592186362943 1017 #edb/ref 17592186362944 13194139535715 true] [17592186362943 1089 "q-163152" 13194139535715 true] [17592186362943 1091 #edb/ref 17592186045463 13194139535715 true] [17592186362943 1100 "The lamina $D={(x,y)\\,:\\,{y}^{2}\\le x\\le 1,\\,\\frac{1}{2}\\le y\\le 1}$ has the mass density function $\\lambda (x,y)=\\frac{1}{x}.$ Find the moment of the lamina about the $y$-axis." 13194139535715 true] [17592186362943 1113 #uuid "7b1c9132-4ec9-56d7-922a-aa6d4bf001f1" 13194139535715 true] [17592186362943 1145 "The moment of a lamina $D$ with the mass density function $\\lambda (x,y)$ about the $y$-axis is given by\n\n$$\n{M}_{y}={∬}_{D}x\\,\\lambda (x,y)\\,\\text{d}A.\n$$\n\nIn our case, $D$ is represented as a type II plane region and $\\lambda (x,y)=\\frac{1}{x}.$ \n\nTherefore, the moment is\n\n$$\n\\begin{aligned}{M}_{y} & ={∬}_{D}x\\cdot \\frac{1}{x}\\,\\text{d}A \\\\  & ={∬}_{D}1\\,\\text{d}A \\\\  & ={\\int }_{1/2}^{1}{\\int }_{{y}^{2}}^{1}\\,\\text{d}x\\,\\text{d}y \\\\  & ={\\int }_{1/2}^{1}[x]_{x={y}^{2}}^{x=1}\\,\\text{d}y \\\\  & ={\\int }_{1/2}^{1}1-{y}^{2}\\,\\text{d}y \\\\  & ={[y-\\frac{{y}^{3}}{3}]}_{y=1/2}^{y=1} \\\\  & =(1-\\frac{1}{3})-(\\frac{1}{2}-\\frac{1}{24}) \\\\  & =\\frac{5}{24}.\\end{aligned}\n$$" 13194139535715 true] [17592186362944 1000 #edb/ref 17592186362945 13194139535715 true] [17592186362944 1000 #edb/ref 17592186362946 13194139535715 true] [17592186362944 1000 #edb/ref 17592186362947 13194139535715 true] [17592186362944 1000 #edb/ref 17592186362948 13194139535715 true] [17592186362944 1000 #edb/ref 17592186362949 13194139535715 true] [17592186362944 1040 #edb/ref 17592186045450 13194139535715 true] [17592186362944 1041 "selection" 13194139535715 true] [17592186362944 1104 #edb/ref 17592186362948 13194139535715 true] [17592186362944 1110 #uuid "4814b913-3172-5e09-a05c-159e5417c60c" 13194139535715 true] [17592186362945 1034 "\\frac{7}{12}" 13194139535715 true] [17592186362945 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362945 1111 #uuid "88c70b00-0281-5f87-b41d-d2b36af0df34" 13194139535715 true] [17592186362946 1034 "\\frac{5}{6}" 13194139535715 true] [17592186362946 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362946 1111 #uuid "6f221915-102f-52ef-bd4f-31280a2378ad" 13194139535715 true] [17592186362947 1034 "\\frac{3}{4}" 13194139535715 true] [17592186362947 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362947 1111 #uuid "33ca6195-3391-504d-840b-b9df8e49c56a" 13194139535715 true] [17592186362948 1034 "\\frac{5}{24}" 13194139535715 true] [17592186362948 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362948 1111 #uuid "dfb1b630-a0ea-57c4-8919-eb3dfd9597f6" 13194139535715 true] [17592186362949 1034 "\\frac{1}{3}" 13194139535715 true] [17592186362949 1103 #edb/ref 17592186045453 13194139535715 true] [17592186362949 1111 #uuid "252c8705-bff5-5d00-a1f8-8309aa302e74" 13194139535715 true] [17592186362950 1017 #edb/ref 1759218636