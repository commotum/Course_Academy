y \\le x^{2}}$ and has the mass density function $λ(x, y) = 4xy$. Given that the mass of the lamina is $21$ units and its center of mass is located at $(x^(―), y^(―))$, what is the value of $y^(―)$?"}] [{:db/id #edb/ref 17592186198901 :knowledge-point/_questions [{:knowledge-point/id #uuid "255c9985-5d85-5fd5-a2b9-c4752f04afac" :knowledge-point/title "Find the Centroid of a Plane Lamina"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "eee28a03-bb27-5562-ba3b-adf60082f952" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186197642} {:answer/id #uuid "ef7f47f3-0def-5291-b68e-2dc459bac22c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186197643} {:answer/id #uuid "465e9201-5d3d-5974-85a2-bf8bc6b3c80f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{2}" :db/id #edb/ref 17592186197644} {:answer/id #uuid "5db2a774-be1c-55ad-9062-0e5e361bb1e1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186197645} {:answer/id #uuid "74959f29-b227-57b5-af43-862535f5982d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{3}" :db/id #edb/ref 17592186197646}] :answer-field/correct {:answer/id #uuid "ef7f47f3-0def-5291-b68e-2dc459bac22c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186197643} :answer-field/id #uuid "fe8f78ac-0006-5eca-af2d-26d93a114de6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186197641}] :question/id #uuid "4f0a3ecd-2e89-53d3-99a9-57716fabd869" :question/math-academy-id "q-39540" :question/problem "Consider the lamina that occupies the region $D = {(x, y): 0 \\le x \\le 2,-x \\le y \\le x}$. Given that the area of the lamina is $4$ square units, find the $x$-coordinate of its centroid."}] [{:db/id #edb/ref 17592186198902 :knowledge-point/_questions [{:knowledge-point/id #uuid "3f7a06a8-0260-5b59-b3a5-c02ee03980d4" :knowledge-point/title "Find the Center of Mass of a Plane Lamina"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "80d9395c-82a1-5efe-9469-cb2bcfe66bd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186197648} {:answer/id #uuid "b9ab7110-d1f1-5c79-bcbe-a6224a167b29" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{13}" :db/id #edb/ref 17592186197649} {:answer/id #uuid "19760eaa-4b5d-5bb9-a32f-0886a8d4460f" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{11}" :db/id #edb/ref 17592186197650} {:answer/id #uuid "43900f67-a26c-55f9-832c-e815f5ec6b2b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186197651} {:answer/id #uuid "4ca432fb-1f91-5b9a-af72-3a74eef9ac2d" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{15}" :db/id #edb/ref 17592186197652}] :answer-field/correct {:answer/id #uuid "80d9395c-82a1-5efe-9469-cb2bcfe66bd4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{7}" :db/id #edb/ref 17592186197648} :answer-field/id #uuid "2757a6b5-87d8-51f1-b9a0-4e1f636095d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186197647}] :question/id #uuid "38ead2a6-fa96-5840-9429-dd70fd1bb582" :question/math-academy-id "q-39547" :question/problem "Consider a thin plate $D$ that has the mass density function $λ(x, y) = y^{2}$ and is enclosed between the curve $x = 1 - y^{2}$ and the $y$-axis for $-1 \\le y \\le 1$. Given that the mass of the plate is $\\frac{4}{15}$ units and its center of mass is located at $(x^(―), y^(―))$, what is the value of $x^(―)$?"}]}
