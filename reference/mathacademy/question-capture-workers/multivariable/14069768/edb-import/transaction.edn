[{:db/id [:question/math-academy-id "q-81509"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069768/assets/b8e6f6b7ab2081595723002737bcb73bbced52bfea0f8cfeb91b1201adab0160.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0$ the particle is located at the position $x=-2.$ What is the position of the particle at time $t=6?$" :db/ensure [:question/validate]} {:db/id "q-84264/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" :answer/id #uuid "6d9569bf-d5da-5464-aeae-bb22cf64e67b" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}" :db/ensure [:answer/validate]} {:db/id "q-84264/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "fd091cd4-d096-5a0c-9062-6468bf3b93d8" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-84264/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" :answer/id #uuid "38d8719a-bd2b-5082-9b09-34c1d23a91ea" :answer/type :answer.type/math :answer/value "\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-84264/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" :answer/id #uuid "5ec14858-02e6-5cc6-a9d4-8d4e4f14b2a9" :answer/type :answer.type/math :answer/value "\\frac{5}{2}" :db/ensure [:answer/validate]} {:db/id "q-84264/selection/ce8782833fa4948cd084022417399eb423071769333088dca13d11299860028b" :answer/id #uuid "7ee47be0-1c60-54ed-8178-5bc1a9a0a77d" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}+2}{2}" :db/ensure [:answer/validate]} {:db/id "q-84264/selection" :answer-field/id #uuid "fdf6a669-e9b2-5bef-baea-cf1f91cd23a6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84264/selection/ce8782833fa4948cd084022417399eb423071769333088dca13d11299860028b" :answer-field/choices ["q-84264/selection/e7f6c27482797e11bd6b0013338edc6789517ab47eb94f4fe9912fc5f8b6c4b8" "q-84264/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-84264/selection/681a4b64a7bb464b7f554c4e26477e3547d3c60cd353fce5dda4ae108b1c4fa5" "q-84264/selection/4280bcd0914e40dbdc039bc97ee5d5baafd2654e75e9b692316d9c28c4842856" "q-84264/selection/ce8782833fa4948cd084022417399eb423071769333088dca13d11299860028b"] :db/ensure [:answer-field/validate]} {:db/id "q-84264" :question/id #uuid "23106ea0-fa43-51e1-8a52-fa16d0dfecf5" :question/math-academy-id "q-84264" :question/problem "A particle $P$ moves along the $x$-axis and its velocity at time $t\\ge 0$ is given by $v(t)=\\operatorname{sin}⁡(t+\\frac{\\pi }{6}).$ At time $t=0$ the particle is located at the position $x=1.$ What is the position of the particle at time $t=\\frac{\\pi }{3}?$" :question/worked-solution "The position of the particle at $t=\\frac{\\pi }{3}$ is equal to its position at $t=0$ plus the total displacement over $t\\in [0,\\frac{\\pi }{3}].$ Therefore, we can calculate it as follows:\n\n$$\nx(\\frac{\\pi }{3})=x(0)+{\\int }_{0}^{\\pi /3}v(t)\\,\\text{d}t\n$$\n\nCarrying out the computations, we get\n\n$$\n\\begin{aligned}x(\\frac{\\pi }{3}) & =1+{\\int }_{0}^{\\pi /3}\\operatorname{sin}⁡(t+\\frac{\\pi }{6})\\,\\text{d}t \\\\  & =1+{[-\\operatorname{cos}⁡(t+\\frac{\\pi }{6})]}_{0}^{\\pi /3} \\\\  & =1+([-\\operatorname{cos}⁡(\\frac{\\pi }{3}+\\frac{\\pi }{6})]-[-\\operatorname{cos}⁡(0+\\frac{\\pi }{6})]) \\\\  & =1+(-\\operatorname{cos}⁡(\\frac{\\pi }{2})+\\operatorname{cos}⁡(\\frac{\\pi }{6})) \\\\  & =1+(-0+\\frac{\\sqrt{3}}{2}) \\\\  & =1+\\frac{\\sqrt{3}}{2} \\\\  & =\\frac{\\sqrt{3}+2}{2}.\\end{aligned}\n$$\n\nSo the position of the particle at $t=\\frac{\\pi }{3}$ is $x=\\frac{\\sqrt{3}+2}{2}.$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-84264/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "be9ac99c-424e-5e90-b26f-c26e4da704d7"] :knowledge-point/questions ["q-84264"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-348321"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069768/assets/e51b807bc238b140215a8a753fcfe778b14735e723dd5cb43b8aab22039a8e8e.png)\n\nThe graph above shows the velocity of an object moving in a straight line along the $x$-axis. At time $t=0,$ the particle is located at the position $x=-2.$ What is the position of the particle at time $t=4?$\n\nThe position of the particle at $t=4$ is $x=$\n{{field-1}}." :db/ensure [:question/validate]}]
