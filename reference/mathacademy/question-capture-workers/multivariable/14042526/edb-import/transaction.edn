selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e"] :knowledge-point/questions ["q-164270"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164265/selection/1688e5089757cc9d40f3daf33c1aad9e46471892a3d51921d8447d05dcd4e524" :answer/id #uuid "d351a1ae-fbf5-526e-a74d-c5ebc4a1f3b5" :answer/type :answer.type/math :answer/value "(3,-2,-2)" :db/ensure [:answer/validate]} {:db/id "q-164265/selection/d5cadcbe7fe5a1df79c0d707a16528db9bfa12e64a5c7aa180ac9dd2b1b57f5d" :answer/id #uuid "e8dc0bc3-4d59-5a8e-b54f-5b33b8c3b820" :answer/type :answer.type/math :answer/value "(-2,-2,3)" :db/ensure [:answer/validate]} {:db/id "q-164265/selection/5b466fb46fb96a3990c20c8bd513ac136da65fce10fec87ff4496212038668ec" :answer/id #uuid "7a0e75c4-9f3c-5053-999a-fcc40e3e6976" :answer/type :answer.type/math :answer/value "(2,3,-2)" :db/ensure [:answer/validate]} {:db/id "q-164265/selection/bcdcc18680210b32022823ff34176ca9c1aa768fcdc933059b568e5f7a98b0aa" :answer/id #uuid "531834aa-b0b0-57f2-8669-46d4ea92eb2b" :answer/type :answer.type/math :answer/value "(3,-2,-6)" :db/ensure [:answer/validate]} {:db/id "q-164265/selection/3f8a3d2f8ff3fbcedc240254f396899470388d1ebc13d7c72b4094d657ef59b5" :answer/id #uuid "a65c3cb5-94e9-5e06-990b-ad47868d5e38" :answer/type :answer.type/math :answer/value "(2,2,3)" :db/ensure [:answer/validate]} {:db/id "q-164265/selection" :answer-field/id #uuid "019ac036-0abd-5183-852b-1353823ad195" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164265/selection/1688e5089757cc9d40f3daf33c1aad9e46471892a3d51921d8447d05dcd4e524" :answer-field/choices ["q-164265/selection/1688e5089757cc9d40f3daf33c1aad9e46471892a3d51921d8447d05dcd4e524" "q-164265/selection/d5cadcbe7fe5a1df79c0d707a16528db9bfa12e64a5c7aa180ac9dd2b1b57f5d" "q-164265/selection/5b466fb46fb96a3990c20c8bd513ac136da65fce10fec87ff4496212038668ec" "q-164265/selection/bcdcc18680210b32022823ff34176ca9c1aa768fcdc933059b568e5f7a98b0aa" "q-164265/selection/3f8a3d2f8ff3fbcedc240254f396899470388d1ebc13d7c72b4094d657ef59b5"] :db/ensure [:answer-field/validate]} {:db/id "q-164265" :question/id #uuid "7859670a-81dd-5793-b67c-4dd38017890f" :question/math-academy-id "q-164265" :question/problem "Find the vertex of the elliptic paraboloid $3z+6=3(x-3)^{2}+(y+2)^{2}.$" :question/worked-solution "The general equation of an elliptic paraboloid oriented along the $z$-axis with vertex at a point $({x}_{0},{y}_{0},{z}_{0})$ is \n\n$$\nz-{z}_{0}=\\frac{(x-{x}_{0})^{2}}{{a}^{2}}+\\frac{(y-{y}_{0})^{2}}{{b}^{2}}.\n$$\n\nTo find the vertex, we rewrite our equation as follows:\n\n$$\n\\begin{aligned}3z+6 & =3(x-3)^{2}+(y+2)^{2} \\\\ 3(z+2) & =3(x-3)^{2}+(y+2)^{2} \\\\ z+2 & =(x-3)^{2}+\\frac{1}{3}(y+2)^{2} \\\\ z-(-2) & =(x-3)^{2}+\\frac{(y-(-2))^{2}}{3}\\end{aligned}\n$$\n\nThis gives us the equation of an elliptic paraboloid that has its vertex at $(3,-2,-2).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-164265/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e"] :knowledge-point/questions ["q-164265"] :db/ensure [:knowledge-point/validate]} {:db/id "q-164269/selection/a7cbf79269b2946d181cf5027c62c3ea5480fd7e353920d3b06a10f40e17ac88" :answer/id #uuid "41501dc7-9a78-513e-8167-fcbae528db4b" :answer/type :answer.type/math :answer/value "{\\begin{aligned}y=3 \\\\ z=1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-164269/selection/2b49364d9bec90aa700281757d1a061b74f71a4f229917a7ff3163a069755673" :answer/id #uuid "812c118e-f906-53b7-ad74-af72498ef29b" :answer/type :answer.type/math :answer/value "{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-164269/selection/b58a9cc69bb5b98412386e61c8d0bcd0aa2da735a32f5ca70f6207b8674db642" :answer/id #uuid "3e9b6dca-c841-5df9-84b7-a0a8cd79bc71" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=3 \\\\ y=1\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-164269/selection/188fb1ef59e2c699b5dcb770320f37cdf4aaf6e3ade17242a12d5cb13902ab68" :answer/id #uuid "c0a10620-ca8a-5fc1-89f1-875f2b5a6904" :answer/type :answer.type/math :answer/value "{\\begin{aligned}y=0 \\\\ z=3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-164269/selection/379d38c7a520f6fa59e211b43b33b6658f59776dd795f6a8c9c16ea98f817ee8" :answer/id #uuid "df136940-dcc7-5f3c-930f-7bfbe8ea4e89" :answer/type :answer.type/math :answer/value "{\\begin{aligned}x=0 \\\\ y=3\\end{aligned}" :db/ensure [:answer/validate]} {:db/id "q-164269/selection" :answer-field/id #uuid "35258bf4-5705-5f8f-a501-65d3b320c69d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-164269/selection/2b49364d9bec90aa700281757d1a061b74f71a4f229917a7ff3163a069755673" :answer-field/choices ["q-164269/selection/a7cbf79269b2946d181cf5027c62c3ea5480fd7e353920d3b06a10f40e17ac88" "q-164269/selection/2b49364d9bec90aa700281757d1a061b74f71a4f229917a7ff3163a069755673" "q-164269/selection/b58a9cc69bb5b98412386e61c8d0bcd0aa2da735a32f5ca70f6207b8674db642" "q-164269/selection/188fb1ef59e2c699b5dcb770320f37cdf4aaf6e3ade17242a12d5cb13902ab68" "q-164269/selection/379d38c7a520f6fa59e211b43b33b6658f59776dd795f6a8c9c16ea98f817ee8"] :db/ensure [:answer-field/validate]} {:db/id "q-164269" :question/id #uuid "94c5e070-73bb-51c9-9483-9e3d8ed68932" :question/math-academy-id "q-164269" :question/problem "Consider the elliptic paraboloid $x=\\frac{(y-3)^{2}}{2}+\\frac{(z+1)^{2}}{6}.$ Which of the following gives its axis of symmetry, written as an intersection of two planes?" :question/worked-solution "First, we write our equation as \n\n$$\nx-0=\\frac{(y-3)^{2}}{2}+\\frac{(z-(-1))^{2}}{6}.\n$$\n\nThis gives us the equation of an elliptic paraboloid oriented along the $x$-axis that has its vertex at $(0,3,-1).$\n Since it is oriented along the $x$-axis, we conclude that its axis of symmetry is parallel to the $x$-axis.\n\nThe axis of symmetry should pass through the vertex of the paraboloid. Therefore, the equation of the axis of symmetry can be written as an intersection of two planes:\n\n$$\n{\\begin{aligned}y=3 \\\\ z=-1\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-164269/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e"] :knowledge-point/questions ["q-164269"] :db/ensure [:knowledge-point/validate]} {:db/id "q-72191/selection/ac80990534908710d719a6ecde193690860b1dc08d98d50a212074ca7d917bda" :answer/id #uuid "5158cf94-4e04-5ffb-baf2-4dea7c4a0472" :answer/type :answer.type/text :answer/value "$(0,3,0)$ only" :db/ensure [:answer/validate]} {:db/id "q-72191/selection/2f2186bd7be1332a7ec4c0970937a3f4b418a8ea1f1512d113cfb4b04d1f0d42" :answer/id #uuid "13c6e298-6700-593c-91eb-c60e6402f5f4" :answer/type :answer.type/text :answer/value "$(0,-5,0)$ and $(0,3,0)$" :db/ensure [:answer/validate]} {:db/id "q-72191/selection/b0ce77a55e3269a074e70eab0eb01e0d3cb29eb73a079c93a4b9c54bafc30bd2" :answer/id #uuid "c867c0ac-aea4-582f-abc1-9f6f416a619a" :answer/type :answer.type/text :answer/value "$(0,-5,0)$ only" :db/ensure [:answer/validate]} {:db/id "q-72191/selection/61ad3237794c9cec1624c3853568be7fdcf261f9cb2378ba92fec36a998492d8" :answer/id #uuid "b2e9a483-6685-5c10-9d8b-a27a9359bc9f" :answer/type :answer.type/text :answer/value "$(0,3,0)$ and $(0,5,0)$" :db/ensure [:answer/validate]} {:db/id "q-72191/selection/1dc2ab10489202e7da569cc5c69a88313ff6af9b8f990928f002f5ecd325d3f3" :answer/id #uuid "1c4f5ddd-2cb4-5111-b56b-9238db7b147b" :answer/type :answer.type/text :answer/value "$(0,-3,0)$ and $(0,5,0)$" :db/ensure [:answer/validate]} {:db/id "q-72191/selection" :answer-field/id #uuid "8ec695dc-9340-5285-b021-38f1bc98a5e0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-72191/selection/2f2186bd7be1332a7ec4c0970937a3f4b418a8ea1f1512d113cfb4b04d1f0d42" :answer-field/choices ["q-72191/selection/ac80990534908710d719a6ecde193690860b1dc08d98d50a212074ca7d917bda" "q-72191/selection/2f2186bd7be1332a7ec4c0970937a3f4b418a8ea1f1512d113cfb4b04d1f0d42" "q-72191/selection/b0ce77a55e3269a074e70eab0eb01e0d3cb29eb73a079c93a4b9c54bafc30bd2" "q-72191/selection/61ad3237794c9cec1624c3853568be7fdcf261f9cb2378ba92fec36a998492d8" "q-72191/selection/1dc2ab10489202e7da569cc5c69a88313ff6af9b8f990928f002f5ecd325d3f3"] :db/ensure [:answer-field/validate]} {:db/id "q-72191" :question/id #uuid "433e52a0-e5ed-5336-8b8f-86409bc9bbf4" :question/math-academy-id "q-72191" :question/problem "Given the elliptic paraboloid $z+13=\\frac{(x-5)^{2}}{5}+\\frac{(y+1)^{2}}{2}$, find its intercepts with the $y$-axis." :question/worked-solution "To find the $y$-intercepts of the paraboloid, we substitute $x=0$ and $z=0$ into the equation of the paraboloid and solve for $y:$\n\n$$\n\\begin{aligned}0+13 & =\\frac{(0-5)^{2}}{5}+\\frac{(y+1)^{2}}{2} \\\\ 13 & =\\frac{25}{5}+\\frac{(y+1)^{2}}{2} \\\\ 13 & =5+\\frac{(y+1)^{2}}{2} \\\\ \\frac{(y+1)^{2}}{2} & =8 \\\\ (y+1)^{2} & =16 \\\\ y+1 & =\\pm 4\\end{aligned}\n$$\n\nThis gives the solutions $y=3,-5.$ \n\nTherefore, the intercepts with the $y$-axis are $(0,-5,0)$ and $(0,3,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-72191/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "ddf82ff9-ea7c-5f7f-ac18-07f8e75b717e"] :knowledge-point/questions ["q-72191"] :db/ensure [:knowledge-point/validate]} {:db/id "q-73862/selection/f787d149742eb55163f4268e856da5409fea6e62b4b6f1de7274fdcc6521c35d" :answer/id #uuid "96b87072-672c-5255-88d2-98fe3bac6e0e" :answer/type :answer.type/math :answer/value "(2,4,3)" :db/ensure [:answer/validate]} {:db/id "q-73862/selection/2af6a375d87cf0fa9ebb4618365c0772c8913c734f0e01c967be80ec59d52aa4" :answer/id #uuid "95c59a14-cc79-59b4-8ecf-e486e4f7018d" :answer/type :answer.type/math :answer/v