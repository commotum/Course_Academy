[{:db/id "q-124003/selection/2372eaf10d3e3c6104c5a2d85d5b9909ce1a56c36600fa4c17241dbcaf0762b2" :answer/id #uuid "257e6a34-f475-5d2d-ae92-57452572b71b" :answer/type :answer.type/math :answer/value "3{e}^{2}" :db/ensure [:answer/validate]} {:db/id "q-124003/selection/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" :answer/id #uuid "764333d9-fa4a-5fc4-965e-a72d204ab619" :answer/type :answer.type/math :answer/value "{e}^{2}-1" :db/ensure [:answer/validate]} {:db/id "q-124003/selection/45910c41fca5ee0a1d412e247ecbb22a45d465ee4eaa2f01b1b89bb6d7836e2e" :answer/id #uuid "5b86d8d6-43e2-5f3d-94b9-48ef9f0861b4" :answer/type :answer.type/math :answer/value "3e+1" :db/ensure [:answer/validate]} {:db/id "q-124003/selection/49ab6cb24d422dffbcc0aad52b1608a4e8bab269f15459dac6e9e4364408b036" :answer/id #uuid "7ad88dd7-9917-52b7-8d2d-9f5e560d164b" :answer/type :answer.type/math :answer/value "3+e" :db/ensure [:answer/validate]} {:db/id "q-124003/selection/de65f68b9ebe8220ad685ae8fd317e4e85f600952fac99fcca3864668321a3a0" :answer/id #uuid "b2a982d2-0998-5427-9cf6-2adf5f18f7ef" :answer/type :answer.type/math :answer/value "3e" :db/ensure [:answer/validate]} {:db/id "q-124003/selection" :answer-field/id #uuid "e04a934f-c77e-5687-a8d9-2159bd730329" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124003/selection/2372eaf10d3e3c6104c5a2d85d5b9909ce1a56c36600fa4c17241dbcaf0762b2" :answer-field/choices ["q-124003/selection/2372eaf10d3e3c6104c5a2d85d5b9909ce1a56c36600fa4c17241dbcaf0762b2" "q-124003/selection/bf91f3f6c85a0c966fc7fefaf1311089f2f26157fb7b7a8207804453236e6767" "q-124003/selection/45910c41fca5ee0a1d412e247ecbb22a45d465ee4eaa2f01b1b89bb6d7836e2e" "q-124003/selection/49ab6cb24d422dffbcc0aad52b1608a4e8bab269f15459dac6e9e4364408b036" "q-124003/selection/de65f68b9ebe8220ad685ae8fd317e4e85f600952fac99fcca3864668321a3a0"] :db/ensure [:answer-field/validate]} {:db/id "q-124003" :question/id #uuid "3c94f4d0-20f5-502e-9b9f-6287280afcb6" :question/math-academy-id "q-124003" :question/problem "Let $f(x,y)=y{e}^{2x}.$ Given that $C$ is the path along the curve $r(t)=⟨t,3{t}^{2}⟩$ for $t\\in [0,1],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0⟩ \\\\ r(1) & =⟨1,3⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0)$ and $(1,3).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(1,3)-f(0,0) \\\\  & =(3{e}^{2\\cdot 1})-(0\\cdot {e}^{2(0)}) \\\\  & =3{e}^{2}-0 \\\\  & =3{e}^{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124003/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61"] :knowledge-point/questions ["q-124003"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124008/selection/01aa8e8e257b234380de8eb9d23f5dcee795108c868a450ffb31b5ddb5851e20" :answer/id #uuid "d3a34290-e575-5837-9efe-ec2f65217509" :answer/type :answer.type/math :answer/value "3e-3" :db/ensure [:answer/validate]} {:db/id "q-124008/selection/13f62e7a97a92683337b041c93c5e31ee846750967c57f51ea3db2d470d7976d" :answer/id #uuid "065ca749-01a0-5343-b8bb-e3eba4a1ecfa" :answer/type :answer.type/math :answer/value "{e}^{2}+3e" :db/ensure [:answer/validate]} {:db/id "q-124008/selection/ec1dec8022764419683a5bb54e98306117cf99f715950ebf63c96d6a0c8da123" :answer/id #uuid "33dca531-d509-5079-ba36-ef6032eb1d74" :answer/type :answer.type/math :answer/value "3{e}^{2}-2" :db/ensure [:answer/validate]} {:db/id "q-124008/selection/7cd6e58c0b814d791b95bcf890a160af620ec4113e399da595c5b33b52363337" :answer/id #uuid "e389a045-5d46-5027-8d5f-ba55d798f3fc" :answer/type :answer.type/math :answer/value "{e}^{2}+2e-3" :db/ensure [:answer/validate]} {:db/id "q-124008/selection/4cbf4aab0a6270ac735ee751239e87352119b4c160ef4e168ba960ee99b1daca" :answer/id #uuid "8e606657-3044-5906-9a8a-f101f61572c7" :answer/type :answer.type/math :answer/value "{e}^{2}-2" :db/ensure [:answer/validate]} {:db/id "q-124008/selection" :answer-field/id #uuid "32a67162-40df-535c-a089-1374622367f0" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124008/selection/7cd6e58c0b814d791b95bcf890a160af620ec4113e399da595c5b33b52363337" :answer-field/choices ["q-124008/selection/01aa8e8e257b234380de8eb9d23f5dcee795108c868a450ffb31b5ddb5851e20" "q-124008/selection/13f62e7a97a92683337b041c93c5e31ee846750967c57f51ea3db2d470d7976d" "q-124008/selection/ec1dec8022764419683a5bb54e98306117cf99f715950ebf63c96d6a0c8da123" "q-124008/selection/7cd6e58c0b814d791b95bcf890a160af620ec4113e399da595c5b33b52363337" "q-124008/selection/4cbf4aab0a6270ac735ee751239e87352119b4c160ef4e168ba960ee99b1daca"] :db/ensure [:answer-field/validate]} {:db/id "q-124008" :question/id #uuid "3b84022c-155d-5594-8712-c795a127d2ab" :question/math-academy-id "q-124008" :question/problem "Let $f(x,y,z)={e}^{x}+{e}^{y}+{e}^{z}.$ Given that $C$ is the path along the curve $r(t)=⟨t,{t}^{2},2{t}^{3}⟩$ for $t\\in [0,1],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,0,0⟩ \\\\ r(1) & =⟨1,1,2⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,0,0)$ and $(1,1,2).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(1))-f(r(0)) \\\\  & =f(1,1,2)-f(0,0,0) \\\\  & =({e}^{1}+{e}^{1}+{e}^{2})-({e}^{0}+{e}^{0}+{e}^{0}) \\\\  & =(2e+{e}^{2})-3 \\\\  & ={e}^{2}+2e-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124008/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61"] :knowledge-point/questions ["q-124008"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124005/selection/3826cb6859afc17fc29beb5847fa2ea888053c16a97c5e0ca18d51a86cfb06ca" :answer/id #uuid "68bc65b4-07f4-54e1-933c-65e2784113cb" :answer/type :answer.type/math :answer/value "-\\frac{3\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-124005/selection/19dc865f9e5e3c737c66357f8fadabd198054c3b810769ac94279915b38d6a76" :answer/id #uuid "c0bbea5b-86ce-52f6-93c3-efd67e6e3134" :answer/type :answer.type/math :answer/value "-\\frac{3\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-124005/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" :answer/id #uuid "98dbd8da-0b2d-5e2f-9125-74ce3c44c230" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{2}" :db/ensure [:answer/validate]} {:db/id "q-124005/selection/63079cc748dc757e7a8e5256fd2c9d955e6cf36193b2548b0f6e7b6b72fbf55c" :answer/id #uuid "9d177289-183f-5892-b121-f6df81c91dc8" :answer/type :answer.type/math :answer/value "-2\\pi " :db/ensure [:answer/validate]} {:db/id "q-124005/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5" :answer/id #uuid "9b1e6b60-1906-5b7a-aae0-61380962284e" :answer/type :answer.type/math :answer/value "\\frac{\\pi }{4}" :db/ensure [:answer/validate]} {:db/id "q-124005/selection" :answer-field/id #uuid "5aae9b52-3998-53ec-aae2-5cf3c9b61ebf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124005/selection/19dc865f9e5e3c737c66357f8fadabd198054c3b810769ac94279915b38d6a76" :answer-field/choices ["q-124005/selection/3826cb6859afc17fc29beb5847fa2ea888053c16a97c5e0ca18d51a86cfb06ca" "q-124005/selection/19dc865f9e5e3c737c66357f8fadabd198054c3b810769ac94279915b38d6a76" "q-124005/selection/7b1b8538b264eef6681d0ab5f3b14d51b6cdff67f34fba59d0886ae5c6acf80a" "q-124005/selection/63079cc748dc757e7a8e5256fd2c9d955e6cf36193b2548b0f6e7b6b72fbf55c" "q-124005/selection/82f0679237d603c9b88d77fbc6f240065a24a3716631fab4d9f58426a7f011e5"] :db/ensure [:answer-field/validate]} {:db/id "q-124005" :question/id #uuid "7013c92e-8038-5b66-97de-63bbdbfdb221" :question/math-academy-id "q-124005" :question/problem "Let $f(x,y)=y\\operatorname{cos}⁡x+x.$ Given that $C$ is the path along the curve $r(t)=⟨t,2t⟩$ for $t\\in [\\frac{\\pi }{2},\\pi ],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(\\frac{\\pi }{2}) & =⟨\\frac{\\pi }{2},\\pi ⟩ \\\\ r(\\pi ) & =⟨\\pi ,2\\pi ⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(\\frac{\\pi }{2},\\pi )$ and $(\\pi ,2\\pi ).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(\\pi ))-f(r(\\frac{\\pi }{2})) \\\\  & =f(\\pi ,2\\pi )-f(\\frac{\\pi }{2},\\pi ) \\\\  & =(2\\pi \\operatorname{cos}⁡\\pi +\\pi )-(\\pi \\operatorname{cos}⁡(\\frac{\\pi }{2})+\\frac{\\pi }{2}) \\\\  & =-\\pi -\\frac{\\pi }{2} \\\\  & =-\\frac{3\\pi }{2}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124005/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61"] :knowledge-point/questions ["q-124005"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124002/selection/88d5e79c9bfeb8d503e034f5a4a9d19637b5fb3b79174a445a4d7c0a700ce6c9" :answer/id #uuid "5ed5f599-c08a-54b8-88ee-f068bf1394b8" :answer/type :answer.type/math :answer/value "87" :db/ensure [:answer/validate]} {:db/id "q-124002/selection/687ba219d8c9b2fa04add76a6cff5858a48aea851ffa07746ca60b9a04b7f2d1" :answer/id #uuid "94795672-8c2f-5130-b2d0-dec335f39fa8" :answer/type :answer.type/math :answer/value "109" :db/ensure [:answer/validate]} {:db/id "q-124002/selection/9cafc462bc4c83137b8ff8388a9c9fc007636777aaf82366ff75c33133ce49a4" :answer/id #uuid "93be323d-17d4-5899-b0cd-2dc4ef7cfa3d" :answer/type :answer.type/math :answer/value "106" :db/ensure [:answer/validate]} {:db/id "q-124002/selection/c5fad6b1da11b9b990be9e0d2fcb83dfa156d8e05ce4b7ef6802ba6bbc66674b" :answer/id #uuid "00a163a5-1e5f-52cc-96cb-34833c75953e" :answer/type :answer.type/math :answer/value "98" :db/ensure [:answer/validate]} {:db/id "q-124002/selection/7ba4ebd0d8a414ae4c404538d01dce67a31f8f6714da9cff2a89b3a7ecb90e95" :answer/id #uuid "e4ab7373-d9e5-53a9-9277-9996961af6d1" :answer/type :answer.type/math :answer/value "76" :db/ensure [:answer/validate]} {:db/id "q-124002/selection" :answer-field/id #uuid "01e3ebea-3131-573b-8e40-6be87b5d2424" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124002/selection/9cafc462bc4c83137b8ff8388a9c9fc007636777aaf82366ff75c33133ce49a4" :answer-field/choices ["q-124002/selection/88d5e79c9bfeb8d503e034f5a4a9d19637b5fb3b79174a445a4d7c0a700ce6c9" "q-124002/selection/687ba219d8c9b2fa04add76a6cff5858a48aea851ffa07746ca60b9a04b7f2d1" "q-124002/selection/9cafc462bc4c83137b8ff8388a9c9fc007636777aaf82366ff75c33133ce49a4" "q-124002/selection/c5fad6b1da11b9b990be9e0d2fcb83dfa156d8e05ce4b7ef6802ba6bbc66674b" "q-124002/selection/7ba4ebd0d8a414ae4c404538d01dce67a31f8f6714da9cff2a89b3a7ecb90e95"] :db/ensure [:answer-field/validate]} {:db/id "q-124002" :question/id #uuid "b4fb6e7d-c5b7-572c-86c1-c0acf17b6a36" :question/math-academy-id "q-124002" :question/problem "Let $f(x,y)={x}^{2}{y}^{2}+x+y.$ Given that $C$ is the path along the curve $r(t)=⟨\\sqrt{t},t+1⟩$ for $t\\in [0,4],$ evaluate ${\\int }_{C}∇f\\cdot \\text{d}r.$" :question/worked-solution "Let $C$ be a piecewise-smooth curve given by the vector function $r(t)$ for $t\\in [a,b].$ Let $f$ be a differentiable function of two or three variables such that $∇f$ is continuous on $C.$ The fundamental theorem for line integrals states that \n\n$$\n{\\int }_{C}∇f\\cdot \\text{d}r=f(r(b))-f(r(a)).\n$$\n\n \n\nIn our case, the position vectors of the endpoints of the curve are given by\n\n$$\n\\begin{aligned}r(0) & =⟨0,1⟩ \\\\ r(4) & =⟨2,5⟩.\\end{aligned}\n$$\n\nTherefore, the coordinates of the endpoints of the path defined by $C$ are $(0,1)$ and $(2,5).$\n\nApplying the fundamental theorem for line integrals, we have\n\n$$\n\\begin{aligned}{\\int }_{C}∇f\\cdot \\text{d}r & =f(r(4))-f(r(0)) \\\\  & =f(2,5)-f(0,1) \\\\  & =({2}^{2}\\cdot {5}^{2}+2+5)-({0}^{2}\\cdot {1}^{2}+0+1) \\\\  & =107-1 \\\\  & =106.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124002/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7b643761-8eab-5bd3-a5f5-c85b6ba34a61"] :knowledge-point/questions ["q-124002"] :db/ensure [:knowledge-point/validate]} {:db/id "q-104623/selection/3484630a54c4854fa9b18c2fad49a34804a051807f98bd3d9b5a3ec0b28d02a5" :answer/id #uuid "9822f971-0b1f-52cb-b48f-042d04eedb10" :answer/type :answer.type/math :a