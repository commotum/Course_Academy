[{:db/id "q-163017/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer/id #uuid "099868d7-54d2-59e4-aa2b-31c18cda28df" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-163017/selection/ea886782f883139045e5abc122fc35c608bfcc0ac4d51b469ff658e915045408" :answer/id #uuid "400216c3-4c32-5c45-94f6-06d884c1dc9b" :answer/type :answer.type/math :answer/value "\\frac{7}{10}" :db/ensure [:answer/validate]} {:db/id "q-163017/selection/1512fbc4ba9ac54935748bd30a3df0f8adcca19968544e9199178dd45a802f05" :answer/id #uuid "1798dc95-a88b-5830-a37c-aa39a3cf36b5" :answer/type :answer.type/math :answer/value "\\frac{5}{12}" :db/ensure [:answer/validate]} {:db/id "q-163017/selection/9c6bfb4db8d042ca3b93589c844ac1c789909e0099f428d8083546a00b4d8cf7" :answer/id #uuid "247e8346-c664-5d32-9ab1-dbb3837116cd" :answer/type :answer.type/math :answer/value "\\frac{2}{9}" :db/ensure [:answer/validate]} {:db/id "q-163017/selection/f374ffdd6d3523b02a3c120608bec26ee5881002536380566773285af0a4c3d4" :answer/id #uuid "70a37107-9eec-5f7a-a71d-1759942f9ae4" :answer/type :answer.type/math :answer/value "\\frac{8}{15}" :db/ensure [:answer/validate]} {:db/id "q-163017/selection" :answer-field/id #uuid "cee4dfca-811d-5bc3-8859-8aa779d9c84e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163017/selection/f374ffdd6d3523b02a3c120608bec26ee5881002536380566773285af0a4c3d4" :answer-field/choices ["q-163017/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" "q-163017/selection/ea886782f883139045e5abc122fc35c608bfcc0ac4d51b469ff658e915045408" "q-163017/selection/1512fbc4ba9ac54935748bd30a3df0f8adcca19968544e9199178dd45a802f05" "q-163017/selection/9c6bfb4db8d042ca3b93589c844ac1c789909e0099f428d8083546a00b4d8cf7" "q-163017/selection/f374ffdd6d3523b02a3c120608bec26ee5881002536380566773285af0a4c3d4"] :db/ensure [:answer-field/validate]} {:db/id "q-163017" :question/id #uuid "fb9ee0e9-a4ee-5ca7-94fc-a842143f8b71" :question/math-academy-id "q-163017" :question/problem "Consider a thin rod placed along the $x$-axis over the interval $0\\le x\\le 1$ whose mass density function is $\\lambda (x)=x-{x}^{3}.$ Given that the rod's mass is $\\frac{1}{4}$ units, what is the $x$-coordinate of its center of mass?" :question/worked-solution "The center of mass, denoted $\\overset{―}{x},$ of a rod placed along the $x$-axis over the interval $a\\le x\\le b$ whose mass density function is $\\lambda (x)$ is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x$ is the mass of the rod,\n\n- ${M}_{O}={\\int }_{a}^{b}\\,x\\lambda (x)\\,\\text{d}x$ is the moment of the rod about the origin $O.$\n\nIn our case, we have\n\n$$\n\\lambda (x)=x-{x}^{3},\\,a=0,\\,b=1.\n$$\n\nSo, the moment of the rod about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{1}x\\cdot (x-{x}^{3})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}-{x}^{4}\\,\\text{d}x \\\\  & ={[\\frac{1}{3}{x}^{3}-\\frac{1}{5}{x}^{5}]}_{0}^{1} \\\\  & =\\frac{1}{3}-\\frac{1}{5} \\\\  & =\\frac{2}{15}.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{(\\frac{2}{15})}{(\\frac{1}{4})}=\\frac{8}{15}.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-163017/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "56762142-e975-5cd2-8699-3bf7a9605e93"] :knowledge-point/questions ["q-163017"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163026/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" :answer/id #uuid "646fe3c6-3b34-5019-9b0b-11fcd6417a12" :answer/type :answer.type/math :answer/value "\\frac{3}{2}" :db/ensure [:answer/validate]} {:db/id "q-163026/selection/bc1aaa9670e8118cdb6ca0d3888d99928c842323e3d10885fe212d998358f89d" :answer/id #uuid "a09a5ed1-8735-55ec-b8d2-33fa6c23fb93" :answer/type :answer.type/math :answer/value "\\frac{7}{6}" :db/ensure [:answer/validate]} {:db/id "q-163026/selection/5b978ba5b99ddc7b69f3ccf406c8062c9af23e68c8edf4280005ba60cc81f47a" :answer/id #uuid "cc02c24e-c077-5129-a1c9-65a20de7ef55" :answer/type :answer.type/math :answer/value "\\frac{8}{9}" :db/ensure [:answer/validate]} {:db/id "q-163026/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" :answer/id #uuid "9888a884-ee81-5b94-9a57-88afe4ea6f2c" :answer/type :answer.type/math :answer/value "\\frac{4}{3}" :db/ensure [:answer/validate]} {:db/id "q-163026/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer/id #uuid "d20899eb-a545-5ee2-a4ac-defea1eb79ec" :answer/type :answer.type/math :answer/value "\\frac{4}{5}" :db/ensure [:answer/validate]} {:db/id "q-163026/selection" :answer-field/id #uuid "9d67c41c-767b-560b-aa4e-febb80b1d18c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163026/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740" :answer-field/choices ["q-163026/selection/c087f5dc559272d193745a4428553203b94404f681d8529e6e619348c0528d10" "q-163026/selection/bc1aaa9670e8118cdb6ca0d3888d99928c842323e3d10885fe212d998358f89d" "q-163026/selection/5b978ba5b99ddc7b69f3ccf406c8062c9af23e68c8edf4280005ba60cc81f47a" "q-163026/selection/9ab64b945e95c1c3798cea70f4ae7ad55133b01b9b894848e70b56c91ffbae97" "q-163026/selection/3089f9a34f7a805d8b2b2d5d51b10dc7aea027e8ec8fd8d06ad11cecf2ba9740"] :db/ensure [:answer-field/validate]} {:db/id "q-163026" :question/id #uuid "ce12c155-0b0c-54e7-ab6e-07055f488a20" :question/math-academy-id "q-163026" :question/problem "Consider a thin rod along the $x$-axis over the interval $0\\le x\\le 2$ whose mass density function is $\\lambda (x)=8-{x}^{3}.$ Find the $x$-coordinate of the center of mass of the rod." :question/worked-solution "The center of mass of a rod placed along the $x$-axis over the interval $a\\le x\\le b$ whose mass density function is $\\lambda (x)$ is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x$ is the mass of the rod,\n\n- ${M}_{O}={\\int }_{a}^{b}\\,x\\lambda (x)\\,\\text{d}x$ is the moment of the rod about the origin $O.$\n\nIn our case, we have\n\n$$\n\\lambda (x)=8-{x}^{3},\\,a=0,\\,b=2.\n$$\n\nSo, the mass of the rod is\n\n$$\n\\begin{aligned}m & ={\\int }_{0}^{2}8-{x}^{3}\\,\\text{d}x \\\\  & ={[8x-\\frac{1}{4}{x}^{4}]}_{0}^{2} \\\\  & =8\\cdot 2-\\frac{1}{4}\\cdot 16 \\\\  & =12\\end{aligned}\n$$\n\n \n\nand the moment of the rod about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{2}x\\cdot (8-{x}^{3})\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}8x-{x}^{4}\\,\\text{d}x \\\\  & ={[4{x}^{2}-\\frac{1}{5}{x}^{5}]}_{0}^{2} \\\\  & =4\\cdot 4-\\frac{1}{5}\\cdot 32 \\\\  & =\\frac{48}{5}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{(\\frac{48}{5})}{12}=\\frac{4}{5}.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-163026/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "56762142-e975-5cd2-8699-3bf7a9605e93"] :knowledge-point/questions ["q-163026"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163037/selection/8a87ac5b5d259bee859700f7dbd117f9514276c2f50e71d6023f85149828847a" :answer/id #uuid "df072a7c-023e-558a-a11f-cd3aa65723bb" :answer/type :answer.type/math :answer/value "3\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163037/selection/5d7504d1f4ce97a433b956b68ac2cbb2268eecf88e34512d7c880081bcad2899" :answer/id #uuid "6b16454b-b7c2-57ea-b38e-53b69d656c21" :answer/type :answer.type/math :answer/value "9\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163037/selection/ec8df7daebf67a5dc0667c0bc80c0a14b01dec99a8ae8558305f520cbe7f2b72" :answer/id #uuid "17e77b55-adb9-52d8-b3f7-6f0c5ac01682" :answer/type :answer.type/math :answer/value "2.5\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163037/selection/6076adc5a124055775ee2f160fc005a4412a48c022a3952a2e6c69af0ccb2d8a" :answer/id #uuid "313396c5-3ebb-5100-9ce7-f6cc6ac62628" :answer/type :answer.type/math :answer/value "4.5\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163037/selection/ec39c26889f195914090760cc04ef70bb7f61f40ce150ac1d11e7f59fab462b6" :answer/id #uuid "2f0aaab3-2d05-5d9f-9c4d-9b0eaa062b10" :answer/type :answer.type/math :answer/value "6\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163037/selection" :answer-field/id #uuid "23daab5d-8457-5170-9548-0029ba645aac" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163037/selection/8a87ac5b5d259bee859700f7dbd117f9514276c2f50e71d6023f85149828847a" :answer-field/choices ["q-163037/selection/8a87ac5b5d259bee859700f7dbd117f9514276c2f50e71d6023f85149828847a" "q-163037/selection/5d7504d1f4ce97a433b956b68ac2cbb2268eecf88e34512d7c880081bcad2899" "q-163037/selection/ec8df7daebf67a5dc0667c0bc80c0a14b01dec99a8ae8558305f520cbe7f2b72" "q-163037/selection/6076adc5a124055775ee2f160fc005a4412a48c022a3952a2e6c69af0ccb2d8a" "q-163037/selection/ec39c26889f195914090760cc04ef70bb7f61f40ce150ac1d11e7f59fab462b6"] :db/ensure [:answer-field/validate]} {:db/id "q-163037" :question/id #uuid "433423a2-b43c-52b3-9c92-28839eb23526" :question/math-academy-id "q-163037" :question/problem "A thin rod with mass density function $\\lambda (x)=\\frac{4}{{x}^{3}},$ measured in $\\text{kg/m},$ is placed along the $x$-axis over the interval $1\\le x\\le 4,$ where $x$ is measured in meters. Find the moment of the rod about the origin." :question/worked-solution "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=\\frac{4}{{x}^{3}},\\,a=1,\\,b=4.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{1}^{4}x\\cdot \\frac{4}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{4}{{x}^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{4}{x}]}_{1}^{4} \\\\  & =-(\\frac{4}{4}-\\frac{4}{1}) \\\\  & =3\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $3\\,\\text{kg}\\cdot \\text{m}.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-163037/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b2c4733-27b9-52be-b326-b4360580b685"] :knowledge-point/questions ["q-163037"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163086/selection/4901a593ac219f2a46418202938e382ed9b407c7f54ce74e2f53bc9ad179a763" :answer/id #uuid "ca4440cf-49d9-57d9-abef-1a136176bcdf" :answer/type :answer.type/math :answer/value "2\\operatorname{ln}⁡3\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163086/selection/fcd050718d4f1106d61c0dae44a8d68205b65bb0f6398a6deb920321109d4f8a" :answer/id #uuid "d72d2ec8-14d5-506f-81b3-ed8f97863f8b" :answer/type :answer.type/math :answer/value "2\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163086/selection/8a87ac5b5d259bee859700f7dbd117f9514276c2f50e71d6023f85149828847a" :answer/id #uuid "9f3f0d29-3e3b-559b-bf72-6a308797d4cb" :answer/type :answer.type/math :answer/value "3\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163086/selection/e7c776f7c602c22e93d0d0ab27d546b3689f34dc6f7c79d5b58931b9599aa8ba" :answer/id #uuid "4e226d91-9f43-5002-b740-667d217285de" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡3\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163086/selection/3e68c3b446973692da8885b52160071a657da63d1781be8b94583aa634813b47" :answer/id #uuid "655d1ea2-8a07-59d5-af93-8d052d77d4e4" :answer/type :answer.type/math :answer/value "\\operatorname{ln}⁡6\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163086/selection" :answer-field/id #uuid "88c7cab0-5d8e-5c39-ad80-3184a475ab75" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163086/selection/4901a593ac219f2a46418202938e382ed9b407c7f54ce74e2f53bc9ad179a763" :answer-field/choices ["q-163086/selection/4901a593ac219f2a46418202938e382ed9b407c7f54ce74e2f53bc9ad179a763" "q-163086/selection/fcd050718d4f1106d61c0dae44a8d68205b65bb0f6398a6deb920321109d4f8a" "q-163086/selection/8a87ac5b5d259bee859700f7dbd117f9514276c2f50e71d6023f85149828847a" "q-163086/selection/e7c776f7c602c22e93d0d0ab27d546b3689f34dc6f7c79d5b58931b9599aa8ba" "q-163086/selection/3e68c3b446973692da8885b52160071a657da63d1781be8b94583aa634813b47"] :db/ensure [:answer-field/validate]} {:db/id "q-163086" :question/id #uuid "ca4c8b56-011b-565a-8401-27eb069a9443" :question/math-academy-id "q-163086" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074110/assets/32500120ed36acde90f5b27c44a6cf45f2d4766bacb5eb097debc0cd7117f27f.png)\n\nThe thin rod above has the mass density function $\\lambda (x)=\\frac{2}{{x}^{2}}\\,\\text{kg/m}.$ Find the moment of the rod about the origin." :question/worked-solution "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=\\frac{2}{{x}^{2}},\\,a=1,\\,b=3.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{1}^{3}x\\cdot \\frac{2}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{2}{x}\\,\\text{d}x \\\\  & =[2\\operatorname{ln}⁡x]_{1}^{3} \\\\  & =2\\operatorname{ln}⁡3-2\\operatorname{ln}⁡1 \\\\  & =2\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $2\\operatorname{ln}⁡3\\,\\text{kg}\\cdot \\text{m}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163086/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b2c4733-27b9-52be-b326-b4360580b685"] :knowledge-point/questions ["q-163086"] :db/ensure [:knowledge-point/validate]} {:db/id "q-163087/selection/92cc0caf2229e70cf40d2b64fa93b22e9b159964554f4b662122f1a4e6011d3a" :answer/id #uuid "e5d19674-2d97-5ca4-89a2-9842ec8983b0" :answer/type :answer.type/math :answer/value "\\frac{25}{6}\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163087/selection/9635aa235e63059e8c51f8c75deecb4f71bd1570a020b16faa809b4423f039ef" :answer/id #uuid "91beb737-a088-5dd7-982c-51a0accf394f" :answer/type :answer.type/math :answer/value "11\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163087/selection/18165f1d3f62a08bd476abd38e97bbdbf638d64ef054c1478dcee9b098a19e66" :answer/id #uuid "639aba2d-4d44-5df5-a022-794eb7246058" :answer/type :answer.type/math :answer/value "\\frac{34}{3}\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163087/selection/c01e4667db65a4bbe28c2555e06cf62ae0f0a3b4ec8ecfe2bd72e56b842d3ab9" :answer/id #uuid "c7d92ea0-acb0-59ed-9060-389094a0ef1d" :answer/type :answer.type/math :answer/value "14\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163087/selection/4d61adac9fbb5c2ded55b009820004ffcd863f4919680b23ed4c883bc8704619" :answer/id #uuid "2ba065d1-b0ab-5e25-a362-0045c82160ee" :answer/type :answer.type/math :answer/value "\\frac{43}{9}\\,\\text{kg}\\cdot \\text{m}" :db/ensure [:answer/validate]} {:db/id "q-163087/selection" :answer-field/id #uuid "3f930f9c-aa1a-5d68-9514-6bd0cc83defe" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-163087/selection/18165f1d3f62a08bd476abd38e97bbdbf638d64ef054c1478dcee9b098a19e66" :answer-field/choices ["q-163087/selection/92cc0caf2229e70cf40d2b64fa93b22e9b159964554f4b662122f1a4e6011d3a" "q-163087/selection/9635aa235e63059e8c51f8c75deecb4f71bd1570a020b16faa809b4423f039ef" "q-163087/selection/18165f1d3f62a08bd476abd38e97bbdbf638d64ef054c1478dcee9b098a19e66" "q-163087/selection/c01e4667db65a4bbe28c2555e06cf62ae0f0a3b4ec8ecfe2bd72e56b842d3ab9" "q-163087/selection/4d61adac9fbb5c2ded55b009820004ffcd863f4919680b23ed4c883bc8704619"] :db/ensure [:answer-field/validate]} {:db/id "q-163087" :question/id #uuid "154a88f6-8666-5c12-8294-951388b62b91" :question/math-academy-id "q-163087" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074110/assets/32500120ed36acde90f5b27c44a6cf45f2d4766bacb5eb097debc0cd7117f27f.png)\n\nThe thin rod above has the mass density function $\\lambda (x)={x}^{2}-x\\,\\text{kg/m}.$ Find the moment of the rod about the origin." :question/worked-solution "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)={x}^{2}-x,\\,a=1,\\,b=3.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{1}^{3}x\\cdot ({x}^{2}-x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}{x}^{3}-{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{{x}^{4}}{4}-\\frac{{x}^{3}}{3}]}_{1}^{3} \\\\  & =(\\frac{{3}^{4}}{4}-\\frac{{3}^{3}}{3})-(\\frac{{1}^{4}}{4}-\\frac{{1}^{3}}{3}) \\\\  & =\\frac{34}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $\\frac{34}{3}\\,\\text{kg}\\cdot \\text{m}.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-163087/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "6b2c4733-27b9-52be-b326-b4360580b685"] :knowledge-point/questions ["q-163087"] :db/ensure [:knowledge-point/validate]}]
