#{[{:db/id #edb/ref 17592186380157 :knowledge-point/_questions [{:knowledge-point/id #uuid "56762142-e975-5cd2-8699-3bf7a9605e93" :knowledge-point/title "Calculating the Center of Mass of a Rod"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "1798dc95-a88b-5830-a37c-aa39a3cf36b5" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{12}" :db/id #edb/ref 17592186380159} {:answer/id #uuid "099868d7-54d2-59e4-aa2b-31c18cda28df" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186380160} {:answer/id #uuid "247e8346-c664-5d32-9ab1-dbb3837116cd" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{2}{9}" :db/id #edb/ref 17592186380161} {:answer/id #uuid "400216c3-4c32-5c45-94f6-06d884c1dc9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{10}" :db/id #edb/ref 17592186380162} {:answer/id #uuid "70a37107-9eec-5f7a-a71d-1759942f9ae4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{15}" :db/id #edb/ref 17592186380163}] :answer-field/correct {:answer/id #uuid "70a37107-9eec-5f7a-a71d-1759942f9ae4" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{15}" :db/id #edb/ref 17592186380163} :answer-field/id #uuid "cee4dfca-811d-5bc3-8859-8aa779d9c84e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380158}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "fb9ee0e9-a4ee-5ca7-94fc-a842143f8b71" :question/math-academy-id "q-163017" :question/problem "Consider a thin rod placed along the $x$-axis over the interval $0\\le x\\le 1$ whose mass density function is $\\lambda (x)=x-{x}^{3}.$ Given that the rod's mass is $\\frac{1}{4}$ units, what is the $x$-coordinate of its center of mass?" :question/worked-solution "The center of mass, denoted $\\overset{―}{x},$ of a rod placed along the $x$-axis over the interval $a\\le x\\le b$ whose mass density function is $\\lambda (x)$ is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x$ is the mass of the rod,\n\n- ${M}_{O}={\\int }_{a}^{b}\\,x\\lambda (x)\\,\\text{d}x$ is the moment of the rod about the origin $O.$\n\nIn our case, we have\n\n$$\n\\lambda (x)=x-{x}^{3},\\,a=0,\\,b=1.\n$$\n\nSo, the moment of the rod about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{1}x\\cdot (x-{x}^{3})\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}{x}^{2}-{x}^{4}\\,\\text{d}x \\\\  & ={[\\frac{1}{3}{x}^{3}-\\frac{1}{5}{x}^{5}]}_{0}^{1} \\\\  & =\\frac{1}{3}-\\frac{1}{5} \\\\  & =\\frac{2}{15}.\\end{aligned}\n$$\n\n \n\nTherefore,\n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{(\\frac{2}{15})}{(\\frac{1}{4})}=\\frac{8}{15}.\n$$"}] [{:db/id #edb/ref 17592186380164 :knowledge-point/_questions [{:knowledge-point/id #uuid "56762142-e975-5cd2-8699-3bf7a9605e93" :knowledge-point/title "Calculating the Center of Mass of a Rod"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d20899eb-a545-5ee2-a4ac-defea1eb79ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186380166} {:answer/id #uuid "cc02c24e-c077-5129-a1c9-65a20de7ef55" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{8}{9}" :db/id #edb/ref 17592186380167} {:answer/id #uuid "9888a884-ee81-5b94-9a57-88afe4ea6f2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{3}" :db/id #edb/ref 17592186380168} {:answer/id #uuid "a09a5ed1-8735-55ec-b8d2-33fa6c23fb93" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7}{6}" :db/id #edb/ref 17592186380169} {:answer/id #uuid "646fe3c6-3b34-5019-9b0b-11fcd6417a12" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{2}" :db/id #edb/ref 17592186380170}] :answer-field/correct {:answer/id #uuid "d20899eb-a545-5ee2-a4ac-defea1eb79ec" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4}{5}" :db/id #edb/ref 17592186380166} :answer-field/id #uuid "9d67c41c-767b-560b-aa4e-febb80b1d18c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380165}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "ce12c155-0b0c-54e7-ab6e-07055f488a20" :question/math-academy-id "q-163026" :question/problem "Consider a thin rod along the $x$-axis over the interval $0\\le x\\le 2$ whose mass density function is $\\lambda (x)=8-{x}^{3}.$ Find the $x$-coordinate of the center of mass of the rod." :question/worked-solution "The center of mass of a rod placed along the $x$-axis over the interval $a\\le x\\le b$ whose mass density function is $\\lambda (x)$ is given by \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m},\n$$\n\n \n\nwhere \n\n- $m={\\int }_{a}^{b}\\lambda (x)\\,\\text{d}x$ is the mass of the rod,\n\n- ${M}_{O}={\\int }_{a}^{b}\\,x\\lambda (x)\\,\\text{d}x$ is the moment of the rod about the origin $O.$\n\nIn our case, we have\n\n$$\n\\lambda (x)=8-{x}^{3},\\,a=0,\\,b=2.\n$$\n\nSo, the mass of the rod is\n\n$$\n\\begin{aligned}m & ={\\int }_{0}^{2}8-{x}^{3}\\,\\text{d}x \\\\  & ={[8x-\\frac{1}{4}{x}^{4}]}_{0}^{2} \\\\  & =8\\cdot 2-\\frac{1}{4}\\cdot 16 \\\\  & =12\\end{aligned}\n$$\n\n \n\nand the moment of the rod about the origin is\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{0}^{2}x\\cdot (8-{x}^{3})\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}8x-{x}^{4}\\,\\text{d}x \\\\  & ={[4{x}^{2}-\\frac{1}{5}{x}^{5}]}_{0}^{2} \\\\  & =4\\cdot 4-\\frac{1}{5}\\cdot 32 \\\\  & =\\frac{48}{5}.\\end{aligned}\n$$\n\n \n\nTherefore, \n\n$$\n\\overset{―}{x}=\\frac{{M}_{O}}{m}=\\frac{(\\frac{48}{5})}{12}=\\frac{4}{5}.\n$$"}] [{:db/id #edb/ref 17592186380171 :knowledge-point/_questions [{:knowledge-point/id #uuid "6b2c4733-27b9-52be-b326-b4360580b685" :knowledge-point/title "Calculating the Moment of a Rod About the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6b16454b-b7c2-57ea-b38e-53b69d656c21" :answer/type {:db/ident :answer.type/math} :answer/value "9\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380173} {:answer/id #uuid "313396c5-3ebb-5100-9ce7-f6cc6ac62628" :answer/type {:db/ident :answer.type/math} :answer/value "4.5\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380174} {:answer/id #uuid "df072a7c-023e-558a-a11f-cd3aa65723bb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380175} {:answer/id #uuid "2f0aaab3-2d05-5d9f-9c4d-9b0eaa062b10" :answer/type {:db/ident :answer.type/math} :answer/value "6\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380176} {:answer/id #uuid "17e77b55-adb9-52d8-b3f7-6f0c5ac01682" :answer/type {:db/ident :answer.type/math} :answer/value "2.5\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380177}] :answer-field/correct {:answer/id #uuid "df072a7c-023e-558a-a11f-cd3aa65723bb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380175} :answer-field/id #uuid "23daab5d-8457-5170-9548-0029ba645aac" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380172}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "433423a2-b43c-52b3-9c92-28839eb23526" :question/math-academy-id "q-163037" :question/problem "A thin rod with mass density function $\\lambda (x)=\\frac{4}{{x}^{3}},$ measured in $\\text{kg/m},$ is placed along the $x$-axis over the interval $1\\le x\\le 4,$ where $x$ is measured in meters. Find the moment of the rod about the origin." :question/worked-solution "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=\\frac{4}{{x}^{3}},\\,a=1,\\,b=4.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{1}^{4}x\\cdot \\frac{4}{{x}^{3}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{4}\\frac{4}{{x}^{2}}\\,\\text{d}x \\\\  & ={[-\\frac{4}{x}]}_{1}^{4} \\\\  & =-(\\frac{4}{4}-\\frac{4}{1}) \\\\  & =3\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $3\\,\\text{kg}\\cdot \\text{m}.$"}] [{:db/id #edb/ref 17592186380178 :knowledge-point/_questions [{:knowledge-point/id #uuid "6b2c4733-27b9-52be-b326-b4360580b685" :knowledge-point/title "Calculating the Moment of a Rod About the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "655d1ea2-8a07-59d5-af93-8d052d77d4e4" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡6\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380180} {:answer/id #uuid "ca4440cf-49d9-57d9-abef-1a136176bcdf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380181} {:answer/id #uuid "9f3f0d29-3e3b-559b-bf72-6a308797d4cb" :answer/type {:db/ident :answer.type/math} :answer/value "3\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380182} {:answer/id #uuid "4e226d91-9f43-5002-b740-667d217285de" :answer/type {:db/ident :answer.type/math} :answer/value "\\operatorname{ln}⁡3\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380183} {:answer/id #uuid "d72d2ec8-14d5-506f-81b3-ed8f97863f8b" :answer/type {:db/ident :answer.type/math} :answer/value "2\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380184}] :answer-field/correct {:answer/id #uuid "ca4440cf-49d9-57d9-abef-1a136176bcdf" :answer/type {:db/ident :answer.type/math} :answer/value "2\\operatorname{ln}⁡3\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380181} :answer-field/id #uuid "88c7cab0-5d8e-5c39-ad80-3184a475ab75" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380179}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ca4c8b56-011b-565a-8401-27eb069a9443" :question/math-academy-id "q-163086" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074110/assets/32500120ed36acde90f5b27c44a6cf45f2d4766bacb5eb097debc0cd7117f27f.png)\n\nThe thin rod above has the mass density function $\\lambda (x)=\\frac{2}{{x}^{2}}\\,\\text{kg/m}.$ Find the moment of the rod about the origin." :question/worked-solution "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)=\\frac{2}{{x}^{2}},\\,a=1,\\,b=3.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{1}^{3}x\\cdot \\frac{2}{{x}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}\\frac{2}{x}\\,\\text{d}x \\\\  & =[2\\operatorname{ln}⁡x]_{1}^{3} \\\\  & =2\\operatorname{ln}⁡3-2\\operatorname{ln}⁡1 \\\\  & =2\\operatorname{ln}⁡3.\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $2\\operatorname{ln}⁡3\\,\\text{kg}\\cdot \\text{m}.$"}] [{:db/id #edb/ref 17592186380185 :knowledge-point/_questions [{:knowledge-point/id #uuid "6b2c4733-27b9-52be-b326-b4360580b685" :knowledge-point/title "Calculating the Moment of a Rod About the Origin"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "639aba2d-4d44-5df5-a022-794eb7246058" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{3}\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380187} {:answer/id #uuid "2ba065d1-b0ab-5e25-a362-0045c82160ee" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{43}{9}\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380188} {:answer/id #uuid "e5d19674-2d97-5ca4-89a2-9842ec8983b0" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{25}{6}\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380189} {:answer/id #uuid "91beb737-a088-5dd7-982c-51a0accf394f" :answer/type {:db/ident :answer.type/math} :answer/value "11\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380190} {:answer/id #uuid "c7d92ea0-acb0-59ed-9060-389094a0ef1d" :answer/type {:db/ident :answer.type/math} :answer/value "14\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380191}] :answer-field/correct {:answer/id #uuid "639aba2d-4d44-5df5-a022-794eb7246058" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{34}{3}\\,\\text{kg}\\cdot \\text{m}" :db/id #edb/ref 17592186380187} :answer-field/id #uuid "3f930f9c-aa1a-5d68-9514-6bd0cc83defe" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186380186}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "154a88f6-8666-5c12-8294-951388b62b91" :question/math-academy-id "q-163087" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14074110/assets/32500120ed36acde90f5b27c44a6cf45f2d4766bacb5eb097debc0cd7117f27f.png)\n\nThe thin rod above has the mass density function $\\lambda (x)={x}^{2}-x\\,\\text{kg/m}.$ Find the moment of the rod about the origin." :question/worked-solution "The moment about the origin $O$ of a rod with mass density function $\\lambda (x)$ for $a\\le x\\le b$ is given by \n\n$$\n{M}_{O}={\\int }_{a}^{b}x\\,\\lambda (x)\\,\\text{d}x.\n$$\n\nIn our case, we have\n\n$$\n\\lambda (x)={x}^{2}-x,\\,a=1,\\,b=3.\n$$\n\nWe calculate the moment of the rod about the origin as follows:\n\n$$\n\\begin{aligned}{M}_{O} & ={\\int }_{1}^{3}x\\cdot ({x}^{2}-x)\\,\\text{d}x \\\\  & ={\\int }_{1}^{3}{x}^{3}-{x}^{2}\\,\\text{d}x \\\\  & ={[\\frac{{x}^{4}}{4}-\\frac{{x}^{3}}{3}]}_{1}^{3} \\\\  & =(\\frac{{3}^{4}}{4}-\\frac{{3}^{3}}{3})-(\\frac{{1}^{4}}{4}-\\frac{{1}^{3}}{3}) \\\\  & =\\frac{34}{3}.\\end{aligned}\n$$\n\n \n\nTherefore, the required moment is $\\frac{34}{3}\\,\\text{kg}\\cdot \\text{m}.$"}]}
