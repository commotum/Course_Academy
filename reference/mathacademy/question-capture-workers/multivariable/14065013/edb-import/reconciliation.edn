{\\text{d}y}{\\text{d}x} & =\\frac{1}{\\sqrt{x}}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\sqrt{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\ \\int \\sqrt{y}\\,\\text{d}y & =\\int \\frac{1}{\\sqrt{x}}\\,\\text{d}x \\\\ \\int {y}^{1/2}\\,\\text{d}y & =\\int {x}^{-1/2}\\,\\text{d}x \\\\ \\frac{2}{3}{y}^{3/2} & =2{x}^{1/2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\frac{2}{3}{y}^{3/2}=2{x}^{1/2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\frac{2}{3}{y}^{3/2} & =2{x}^{1/2}+C \\\\ {y}^{3/2} & =3{x}^{1/2}+\\frac{3C}{2} \\\\ y & ={(3{x}^{1/2}+\\frac{3C}{2})}^{2/3} \\\\ y & ={(3{x}^{1/2}+K)}^{2/3}\\end{aligned}\n$$\n\nwhere $K=\\frac{3C}{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-8304" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/activity-metadata.json" "file_sha256" "bf5497a819a90050faf29be7e2394e55f5c8d7a585eaa9b95630a3494904712d"} {"question" "q-8304" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-8304" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=3{x}^{1/2}+K"] ["math" "y=3{x}^{1/3}+K"] ["math" "y={(3{x}^{1/2}+K)}^{2/3}"] ["math" "y={({x}^{1/2}+K)}^{2/3}"] ["math" "y={({x}^{2/3}+K)}^{1/2}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-8304" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y={(3{x}^{1/2}+K)}^{2/3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-154369" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=2{e}^{-y}(x-1).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-154369" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables: \n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =2{e}^{-y}(x-1) \\\\ {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =2(x-1)\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int {e}^{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\text{d}x & =\\int 2(x-1)\\,\\text{d}x \\\\ \\int {e}^{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2x\\,\\text{d}x-\\int 2\\,\\text{d}x \\\\ {e}^{y} & ={x}^{2}-2x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{e}^{y}={x}^{2}-2x+C.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-154369" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/activity-metadata.json" "file_sha256" "bf5497a819a90050faf29be7e2394e55f5c8d7a585eaa9b95630a3494904712d"} {"question" "q-154369" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-154369" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "2y=\\frac{1}{2}\\,{x}^{2}-x+C"] ["math" "y={x}^{2}-2x+C"] ["math" "{e}^{2y}=\\frac{1}{2}\\,{x}^{2}-x+C"] ["math" "{e}^{2y}={x}^{2}-2x+C"] ["math" "{e}^{y}={x}^{2}-2x+C"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-154369" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{e}^{y}={x}^{2}-2x+C"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158009" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation ${x}^{2}\\,{y}^{′}-y=3$ for $y\\ne -3.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158009" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{x}^{2}\\,{y}^{′}-y & =3 \\\\ {x}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}-y & =3 \\\\ {x}^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & =y+3 \\\\ \\frac{1}{y+3}\\cdot \\frac{\\text{d}y}{\\text{d}x} & =\\frac{1}{{x}^{2}}\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y+3}\\cdot \\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\ \\int \\frac{1}{y+3}\\,\\text{d}y & =\\int \\frac{1}{{x}^{2}}\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y+3| & =-\\frac{1}{x}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y+3|=-\\frac{1}{x}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡|y+3| & =-\\frac{1}{x}+C \\\\ |y+3| & ={e}^{-1/x+C} \\\\ |y+3| & ={e}^{-1/x}\\cdot {e}^{C} \\\\ |y+3| & =K{e}^{-1/x}\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\n\\begin{aligned}|y+3| & =K{e}^{-1/x} \\\\ y+3 & =K{e}^{-1/x} \\\\ y & =K{e}^{-1/x}-3.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158009" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/hard "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/activity-metadata.json" "file_sha256" "bf5497a819a90050faf29be7e2394e55f5c8d7a585eaa9b95630a3494904712d"} {"question" "q-158009" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158009" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=K{e}^{-1/x}-3"] ["math" "y=K{e}^{-3/x}"] ["math" "y=K{e}^{-x}-3"] ["math" "y=K{e}^{1/x}+3"] ["math" "y=K{e}^{x}+3"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158009" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=K{e}^{-1/x}-3"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158012" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation $\\frac{\\text{d}y}{\\text{d}x}=\\frac{2x}{3{y}^{2}}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158012" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}\\frac{\\text{d}y}{\\text{d}x} & =\\frac{2x}{3{y}^{2}} \\\\ 3{y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x} & =2x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int 3{y}^{2}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int 2x\\,\\text{d}x \\\\ \\int 3{y}^{2}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int 2x\\,\\text{d}x \\\\ \\int 3{y}^{2}\\,\\text{d}y & =\\int 2x\\,\\text{d}x \\\\ {y}^{3} & ={x}^{2}+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n{y}^{3}={x}^{2}+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\ny=\\sqrt[3]{{x}^{2}+C}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158012" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/activity-metadata.json" "file_sha256" "bf5497a819a90050faf29be7e2394e55f5c8d7a585eaa9b95630a3494904712d"} {"question" "q-158012" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158012" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=(\\sqrt[3]{x}+C)^{2}"] ["math" "y=({x}^{2}+C)^{3}"] ["math" "y=\\frac{2}{3}x+C"] ["math" "y=\\sqrt[3]{2x+C}"] ["math" "y=\\sqrt[3]{{x}^{2}+C}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158012" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=\\sqrt[3]{{x}^{2}+C}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158014" "field" nil "attribute" "question/problem" "value" "Find the general solution to the differential equation ${y}^{′}=y\\operatorname{cos}⁡x$ for $y\\ne 0.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158014" "field" nil "attribute" "question/worked-solution" "value" "To find the general solution, we first separate the variables:\n\n$$\n\\begin{aligned}{y}^{′} & =y\\operatorname{cos}⁡x \\\\ \\frac{\\text{d}y}{\\text{d}x} & =y\\operatorname{cos}⁡x \\\\ \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x} & =\\operatorname{cos}⁡x\\end{aligned}\n$$\n\nThen, we integrate both sides with respect to $x:$\n\n$$\n\\begin{aligned}\\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\text{d}x}\\,\\text{d}x & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\frac{\\text{d}y}{\\cancel{\\text{d}x}}\\,\\cancel{\\text{d}x} & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\int \\frac{1}{y}\\,\\text{d}y & =\\int \\operatorname{cos}⁡x\\,\\text{d}x \\\\ \\operatorname{ln}⁡|y| & =\\operatorname{sin}⁡x+C\\end{aligned}\n$$\n\nTherefore, the general solution to the differential equation (in implicit form) is\n\n$$\n\\operatorname{ln}⁡|y|=\\operatorname{sin}⁡x+C.\n$$\n\nWe're required to write the solution in the form $y=y(x).$ By doing this, we get\n\n$$\n\\begin{aligned}{e}^{\\operatorname{ln}⁡|y|} & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x+C} \\\\ |y| & ={e}^{\\operatorname{sin}⁡x}\\cdot {e}^{C} \\\\ |y| & =K{e}^{\\operatorname{sin}⁡x},\\end{aligned}\n$$\n\nwhere $K={e}^{C}$ and $K>0.$\n\nWe can drop the absolute value bars by allowing $K$ to be either positive or negative. Therefore, the most general solution is\n\n$$\ny=K{e}^{\\operatorname{sin}⁡x}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158014" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/activity-metadata.json" "file_sha256" "bf5497a819a90050faf29be7e2394e55f5c8d7a585eaa9b95630a3494904712d"} {"question" "q-158014" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158014" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "y=K{e}^{-2\\operatorname{sin}⁡x}"] ["math" "y=K{e}^{\\operatorname{cos}⁡x}"] ["math" "y=K{e}^{\\operatorname{sin}⁡x}"] ["math" "y={e}^{-\\operatorname{cos}⁡x}+K"] ["math" "y={e}^{\\operatorname{sin}⁡x}+K"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23fca65d7cf7f5811e0f71729da5fab6c2efcb493839e105baea"} {"question" "q-158014" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "y=K{e}^{\\operatorname{sin}⁡x}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14065013/state.json" "file_sha256" "c63215d7b7fc23