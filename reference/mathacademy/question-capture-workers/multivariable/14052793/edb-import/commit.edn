{2}} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}-2+{t}^{2}+4} \\\\  & =\\sqrt{\\frac{1}{{t}^{2}}+2+{t}^{2}} \\\\  & =\\sqrt{{(\\frac{1}{t}+t)}^{2}} \\\\  & =\\frac{1}{t}+t\\end{aligned}\n$$\n\nTherefore, the arc length of the curve is\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{e}‖{g}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{1}^{e}(\\frac{1}{t}+t)\\,\\text{d}t \\\\  & =(\\operatorname{ln}⁡t+\\frac{{t}^{2}}{2}){|}_{1}^{e} \\\\  & =(\\operatorname{ln}⁡e+\\frac{{e}^{2}}{2})-(\\operatorname{ln}⁡1+\\frac{{1}^{2}}{2}) \\\\  & =1+\\frac{{e}^{2}}{2}-0-\\frac{1}{2} \\\\  & =\\frac{{e}^{2}+1}{2}.\\end{aligned}\n$$" 13194139535078 true] [17592186330093 1000 #edb/ref 17592186330094 13194139535078 true] [17592186330093 1000 #edb/ref 17592186330095 13194139535078 true] [17592186330093 1000 #edb/ref 17592186330096 13194139535078 true] [17592186330093 1000 #edb/ref 17592186330097 13194139535078 true] [17592186330093 1000 #edb/ref 17592186330098 13194139535078 true] [17592186330093 1040 #edb/ref 17592186045450 13194139535078 true] [17592186330093 1041 "selection" 13194139535078 true] [17592186330093 1104 #edb/ref 17592186330097 13194139535078 true] [17592186330093 1110 #uuid "7e37b7c7-1a63-5984-b66d-212510102dfb" 13194139535078 true] [17592186330094 1034 "{e}^{2}+1" 13194139535078 true] [17592186330094 1103 #edb/ref 17592186045453 13194139535078 true] [17592186330094 1111 #uuid "f6ed477a-0abb-5c04-a885-8fa44e428a1f" 13194139535078 true] [17592186330095 1034 "\\frac{1}{{e}^{2}}+{e}^{2}-2" 13194139535078 true] [17592186330095 1103 #edb/ref 17592186045453 13194139535078 true] [17592186330095 1111 #uuid "b74984cb-7151-5645-9619-17779a1dacb5" 13194139535078 true] [17592186330096 1034 "\\frac{{e}^{2}-1}{2}" 13194139535078 true] [17592186330096 1103 #edb/ref 17592186045453 13194139535078 true] [17592186330096 1111 #uuid "1665e8a7-30b8-53fa-b649-757c85f99d95" 13194139535078 true] [17592186330097 1034 "\\frac{{e}^{2}+1}{2}" 13194139535078 true] [17592186330097 1103 #edb/ref 17592186045453 13194139535078