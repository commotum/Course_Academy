ides with its initial point.\n\nOf the given options, the only that satisfies the definition is the following:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14041961/assets/e90eb350064508e6afdc2517b37faa903b75f0370067be8fac4428e9294cd990.png)"}] [{:db/id #edb/ref 17592186172589 :knowledge-point/_questions [{:knowledge-point/id #uuid "337518a9-39a1-57e3-8686-74a135f7c3d7" :knowledge-point/title "Identifying Oriented Curves"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3f275da2-af2a-5ec9-8cfc-0cc5d23fc6d2" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3356/Source/Images/q-97927-a-4.png" :db/id #edb/ref 17592186171500} {:answer/id #uuid "4475d812-3268-56b1-8664-de78835c0709" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3356/Source/Images/q-97927-a-1.png" :db/id #edb/ref 17592186171501} {:answer/id #uuid "5631e0f9-0d76-5cd4-977f-e320cda3d283" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3356/Source/Images/q-97927-a-5.png" :db/id #edb/ref 17592186171502} {:answer/id #uuid "5c1fe632-e1dc-534a-9bd7-e615ee4cb3d4" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3356/Source/Images/q-97927-a-2.png" :db/id #edb/ref 17592186171503} {:answer/id #uuid "73d82942-6340-5ec6-8482-5303cfbdb7d5" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3356/Source/Images/q-97927-a-3.png" :db/id #edb/ref 17592186171504}] :answer-field/correct {:answer/id #uuid "4475d812-3268-56b1-8664-de78835c0709" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/3356/Source/Images/q-97927-a-1.png" :db/id #edb/ref 17592186171501} :answer-field/id #uuid "da630a3e-4071-5d7f-81fb-71e001f412bf" :answer-field/key "selection" :answer-field/type {:db