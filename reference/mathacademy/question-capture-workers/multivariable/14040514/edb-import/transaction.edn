question.difficulty/easy :question/answer-fields ["q-149597/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5"] :knowledge-point/questions ["q-149597"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317208/field-1/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer/id #uuid "d689edc3-214c-58b5-82b2-785bfdd52402" :answer/type :answer.type/math :answer/value "-" :db/ensure [:answer/validate]} {:db/id "q-317208/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer/id #uuid "f852d378-5693-5068-ab23-32ae768fc249" :answer/type :answer.type/math :answer/value "+" :db/ensure [:answer/validate]} {:db/id "q-317208/field-1" :answer-field/id #uuid "82f0658c-5bc1-5e17-9ce9-78ebad827a59" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-317208/field-1/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer-field/choices ["q-317208/field-1/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" "q-317208/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949"] :db/ensure [:answer-field/validate]} {:db/id "q-317208/field-2/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer/id #uuid "487443bd-aec4-52a2-b970-1693bad8c99a" :answer/type :answer.type/math :answer/value "+" :db/ensure [:answer/validate]} {:db/id "q-317208/field-2/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer/id #uuid "26f1018e-de97-5a35-b6ed-1309bacf6f52" :answer/type :answer.type/math :answer/value "-" :db/ensure [:answer/validate]} {:db/id "q-317208/field-2" :answer-field/id #uuid "94cc127e-6db0-5bb2-82c9-9e5044be4c59" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-317208/field-2/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer-field/choices ["q-317208/field-2/4e1443bd31b83d9674b14c