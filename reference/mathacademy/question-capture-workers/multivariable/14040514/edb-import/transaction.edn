x>0$ |" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-149594/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "798800a5-255a-5738-91d2-21c2a78e4fb5"] :knowledge-point/questions ["q-149594"] :db/ensure [:knowledge-point/validate]} {:db/id "q-317158/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer/id #uuid "fa8df259-feca-5a3e-b36a-fb2d3a53b4c4" :answer/type :answer.type/math :answer/value "+" :db/ensure [:answer/validate]} {:db/id "q-317158/field-1/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer/id #uuid "bd469f6d-326c-5ba3-a5fe-ced8310dd477" :answer/type :answer.type/math :answer/value "-" :db/ensure [:answer/validate]} {:db/id "q-317158/field-1" :answer-field/id #uuid "77e7c958-8cea-5afd-9164-78c215066580" :answer-field/key "field-1" :answer-field/type :answer-field.type/select :answer-field/correct "q-317158/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer-field/choices ["q-317158/field-1/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" "q-317158/field-1/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc"] :db/ensure [:answer-field/validate]} {:db/id "q-317158/field-2/ccfe516fb6b2e6a04cc571ee2ff57ef9ea3f598a00c4bac0e1422b5f957652bc" :answer/id #uuid "8479013a-4fa5-5811-a0d0-93fdd02c4852" :answer/type :answer.type/math :answer/value "-" :db/ensure [:answer/validate]} {:db/id "q-317158/field-2/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer/id #uuid "3a809f7b-2d02-51bd-b2f3-a49dbf6b9dec" :answer/type :answer.type/math :answer/value "+" :db/ensure [:answer/validate]} {:db/id "q-317158/field-2" :answer-field/id #uuid "edef019f-d90d-5fa4-9d0f-93abb7d5a2bb" :answer-field/key "field-2" :answer-field/type :answer-field.type/select :answer-field/correct "q-317158/field-2/4e1443bd31b83d9674b14c2b39fdc69b7291d3991d33de8027815afac4720949" :answer-field/choices ["q-317158/