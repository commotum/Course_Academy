th "2"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991810/state.json" "file_sha256" "455b098ef196edb68a19343572eda58785f9e1e403d78fcfb5f5d82d2cc9198a" "basis" 1040 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13991810/edb-import/verification.json"}] "sources" [{"question" "q-7999" "field" nil "attribute" "question/problem" "value" "Calculate the $x$-intercepts of the hyperbola $7{x}^{2}-{y}^{2}=7.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/state.json" "file_sha256" "c568ee07db6184bb18c03b3112315def5412995c423464fac58771effdde2ea8"} {"question" "q-7999" "field" nil "attribute" "question/worked-solution" "value" "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}7{x}^{2}-{y}^{2} & =7 \\\\ 7{x}^{2}-{0}^{2} & =7 \\\\ 7{x}^{2} & =7 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $(\\pm 1,0).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/state.json" "file_sha256" "c568ee07db6184bb18c03b3112315def5412995c423464fac58771effdde2ea8"} {"question" "q-7999" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/activity-metadata.json" "file_sha256" "7838443612f80e881d22e3fba6f19a79c53132ba3c1f35433f14d945b5365792"} {"question" "q-7999" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/state.json" "file_sha256" "c568ee07db6184bb18c03b3112315def5412995c423464fac58771effdde2ea8"} {"question" "q-7999" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(\\pm 1,0)"] ["math" "(\\pm 2,0)"] ["math" "(\\pm 3,0)"] ["math" "(\\pm \\sqrt{7},0)"] ["text" "$(-1,0)$ and $(\\sqrt{7},0)$"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/state.json" "file_sha256" "c568ee07db6184bb18c03b3112315def5412995c423464fac58771effdde2ea8"} {"question" "q-7999" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(\\pm 1,0)"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/state.json" "file_sha256" "c568ee07db6184bb18c03b3112315def5412995c423464fac58771effdde2ea8"} {"question" "q-84034" "field" nil "attribute" "question/problem" "value" "Calculate the $x$-intercepts of the hyperbola $\\frac{(y+2)^{2}}{5}-\\frac{(x-3)^{2}}{7}=1.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/state.json" "file_sha256" "c568ee07db6184bb18c03b3112315def5412995c423464fac58771effdde2ea8"} {"question" "q-84034" "field" nil "attribute" "question/worked-solution" "value" "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y+2)^{2}}{5}-\\frac{(x-3)^{2}}{7} & =1 \\\\ \\frac{(0+2)^{2}}{5}-\\frac{(x-3)^{2}}{7} & =1 \\\\ \\frac{4}{5}-\\frac{(x-3)^{2}}{7} & =1 \\\\ -\\frac{(x-3)^{2}}{7} & =1-\\frac{4}{5} \\\\ -\\frac{(x-3)^{2}}{7} & =\\frac{1}{5} \\\\ (x-3)^{2} & =-\\frac{7}{5}\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions.\nSo, there are no $x$-intercepts." "category" "ma_capture" "file" "/home/jake/De