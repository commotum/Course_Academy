#{[{:db/id #edb/ref 17592186087487 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/id #uuid "03bb8d2d-55c5-5511-94c5-73e73db9ccf8" :question/math-academy-id "e-5361" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\dfrac{(x+1)^2}{10} - \\dfrac{y^2}{25} = 1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x+1)^{2}}{10}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{(x+1)^{2}}{10}-\\frac{{0}^{2}}{25} & =1 \\\\ \\frac{(x+1)^{2}}{10} & =1 \\\\ (x+1)^{2} & =10 \\\\ x+1 & =\\pm \\sqrt{10} \\\\ x & =-1\\pm \\sqrt{10}\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $\\left(-1\\pm \\sqrt{10},0\\right).$"}] [{:db/id #edb/ref 17592186087488 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/id #uuid "b3eac4e2-5e85-5669-8dfb-c7fe4e5a47ae" :question/math-academy-id "e-5362" :question/problem "Calculate the points where the hyperbola \n$\\dfrac{x^2}{10}-\\dfrac{y^2}{15}=1$\nintersects the line $y=-3.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=-3,$ we substitute $y=-3$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{10}-\\frac{{y}^{2}}{15} & =1 \\\\ \\frac{{x}^{2}}{10}-\\frac{(-3)^{2}}{15} & =1 \\\\ \\frac{{x}^{2}}{10}-\\frac{9}{15} & =1 \\\\ \\frac{{x}^{2}}{10}-\\frac{3}{5} & =1 \\\\ {x}^{2}-6 & =10 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $y=-3$ at the points $(\\pm 4, -3).$"}] [{:db/id #edb/ref 17592186087564 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/id #uuid "bb09b5f0-832f-5008-970c-87c6dfaf076f" :question/math-academy-id "e-7424" :question/problem "Calculate the $y$-intercepts of the hyperbola $7y^2 -5x^2 = 28.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}7{y}^{2}-5{x}^{2} & =28 \\\\ 7{y}^{2}-5(0)^{2} & =28 \\\\ 7{y}^{2} & =28 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,\\pm 2).$"}] [{:db/id #edb/ref 17592186087565 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/id #uuid "0704ee42-bc8c-5d98-b6f2-ad952ab41560" :question/math-academy-id "e-7425" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038690/assets/c8d69cebc1c7388bb9bc8ac73152a9b2941156188917ee6b680f6758a3d777de.png)\n\nCalculate the $x$-coordinates of the points where the hyperbola $\\dfrac{x^2}{9} - \\dfrac{y^2}{25}=1$ intersects the line $y = x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{{x}^{2}}{9}-\\frac{{x}^{2}}{25} & =1 \\\\ \\frac{16{x}^{2}}{225} & =1 \\\\ {x}^{2} & =\\frac{225}{16} \\\\ x & =\\pm \\frac{15}{4}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186301102 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8672317d-3771-5265-a89f-7b6f8e99ade1" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 2" :db/id #edb/ref 17592186301104} {:answer/id #uuid "12acd7b8-4127-59f1-9e73-40f94e478f08" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 4" :db/id #edb/ref 17592186301105} {:answer/id #uuid "d03d5fc6-c23f-5bfa-ac8b-43425dfe8f01" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186301106} {:answer/id #uuid "95ca5daa-819d-5de2-a607-2a15fd38eaee" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 9" :db/id #edb/ref 17592186301107} {:answer/id #uuid "5b70dbea-e3cb-5626-94fc-d756d225180b" :answer/type {:db/ident :answer.type/math} :answer/value "x=\\pm 3" :db/id #edb/ref 17592186301108}] :answer-field/correct {:answer/id #uuid "d03d5fc6-c23f-5bfa-ac8b-43425dfe8f01" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186301106} :answer-field/id #uuid "b43c252e-1e90-5658-9203-1fa02a327d3a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301103}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "296c1691-3fdb-50aa-926f-7c3fb307cb51" :question/math-academy-id "q-10485" :question/problem "Calculate the $x$-coordinates of the points where the hyperbola $\\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{4}=1$ intersects the line $y=x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{9}-\\frac{{x}^{2}}{4} & =1 \\\\ \\frac{{x}^{2}}{9}-\\frac{{x}^{2}}{4} & =1 \\\\ \\frac{4{x}^{2}}{36}-\\frac{9{x}^{2}}{36} & =1 \\\\ -\\frac{5{x}^{2}}{36} & =1 \\\\ 5{x}^{2} & =-36\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. So, the hyperbola does not intersect the line $y=x.$"}] [{:db/id #edb/ref 17592186301109 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "75cb1614-3d0e-5416-ae62-d7211445e31e" :answer/type {:db/ident :answer.type/math} :answer/value "(6,\\pm 10)" :db/id #edb/ref 17592186301111} {:answer/id #uuid "e0c80c91-4d30-5607-979d-060505d8a99f" :answer/type {:db/ident :answer.type/math} :answer/value "(6,\\pm 15)" :db/id #edb/ref 17592186301112} {:answer/id #uuid "b3a2b41d-88bc-5079-a577-3f2e7db19d9c" :answer/type {:db/ident :answer.type/math} :answer/value "(6,\\pm 20)" :db/id #edb/ref 17592186301113} {:answer/id #uuid "23e72abf-442d-5a55-b855-835afd2b2299" :answer/type {:db/ident :answer.type/math} :answer/value "(6,\\pm 5)" :db/id #edb/ref 17592186301114} {:answer/id #uuid "80902677-0605-5e17-bdbd-df604c19310f" :answer/type {:db/ident :answer.type/math} :answer/value "(6,\\pm 25)" :db/id #edb/ref 17592186301115}] :answer-field/correct {:answer/id #uuid "75cb1614-3d0e-5416-ae62-d7211445e31e" :answer/type {:db/ident :answer.type/math} :answer/value "(6,\\pm 10)" :db/id #edb/ref 17592186301111} :answer-field/id #uuid "dc039807-37d5-5024-9e5a-319d42aa4df7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301110}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "63269d3f-c004-594d-a48d-9275a75ead43" :question/math-academy-id "q-10495" :question/problem "Calculate the points where the hyperbola $9{y}^{2}-20{x}^{2}=180$ intersects the line $x=6.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=6,$ we substitute $x=6$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}9{y}^{2}-20{x}^{2} & =180 \\\\ 9{y}^{2}-20(6)^{2} & =180 \\\\ 9{y}^{2}-720 & =180 \\\\ {y}^{2}-80 & =20 \\\\ {y}^{2} & =80+20 \\\\ {y}^{2} & =100 \\\\ y & =\\pm 10\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $x=6$  at the points $(6,\\pm 10).$"}] [{:db/id #edb/ref 17592186087990 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4c79fc0-efad-5466-a67a-72ca914e15bf" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186084952} {:answer/id #uuid "dca49ea5-5dfd-5248-a586-d8fa04eb30a2" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± 2)" :db/id #edb/ref 17592186084953} {:answer/id #uuid "e9f302f5-8089-52ab-9b55-187b379e8f0b" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± \\frac{27}{4})" :db/id #edb/ref 17592186084954} {:answer/id #uuid "07872847-3bc9-5c80-b26a-f2c2bc6c0c31" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± 3)" :db/id #edb/ref 17592186084955} {:answer/id #uuid "5fd31179-8068-5c46-aff1-bc7938ecd242" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± \\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186084956}] :answer-field/correct {:answer/id #uuid "d4c79fc0-efad-5466-a67a-72ca914e15bf" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186084952} :answer-field/id #uuid "a95cd287-a359-5541-840d-95f027e8ed16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084951}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2b576f63-e1f4-5329-9152-0aa7a896a79e" :question/math-academy-id "q-170556" :question/problem "Calculate the points where the hyperbola $\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{9}=1$ intersects the line $x=-1.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-1,$ we substitute $x=-1$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{4}-\\frac{{y}^{2}}{9} & =1 \\\\ \\frac{(-1)^{2}}{4}-\\frac{{y}^{2}}{9} & =1 \\\\ \\frac{1}{4}-\\frac{{y}^{2}}{9} & =1 \\\\ -\\frac{{y}^{2}}{9} & =\\frac{3}{4} \\\\ {y}^{2} & =-\\frac{27}{4}\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. \nSo, the hyperbola does not intersect the vertical line $x=-1.$"}] [{:db/id #edb/ref 17592186264735 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d09b0e76-0168-5cde-95ad-0e066947d8c7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264737}] :answer-field/correct {:answer/id #uuid "d09b0e76-0168-5cde-95ad-0e066947d8c7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264737} :answer-field/id #uuid "4a522786-048e-5ef5-a700-46e124f3f508" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264736} {:answer-field/choices [{:answer/id #uuid "75ca9cca-91a3-51ca-b659-eb9dcec3c031" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264739}] :answer-field/correct {:answer/id #uuid "75ca9cca-91a3-51ca-b659-eb9dcec3c031" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186264739} :answer-field/id #uuid "45927ed7-9b0a-57db-8199-0ffeb029c69f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264738} {:answer-field/choices [{:answer/id #uuid "67843bb5-458d-5d0c-8ea9-dee271567bc3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264741}] :answer-field/correct {:answer/id #uuid "67843bb5-458d-5d0c-8ea9-dee271567bc3" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264741} :answer-field/id #uuid "5ef11edb-6168-583a-a677-953c3d40b7de" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264740} {:answer-field/choices [{:answer/id #uuid "e5d8a669-aac2-5c1f-8357-29f70e4809b2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264743}] :answer-field/correct {:answer/id #uuid "e5d8a669-aac2-5c1f-8357-29f70e4809b2" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186264743} :answer-field/id #uuid "38224f51-3a4a-56bb-ac3b-bf80feaa664a" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264742}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e9dfffee-93ab-5b9a-91d2-b8ba63f7d71c" :question/math-academy-id "q-277802" :question/problem "From **top to bottom,** the $y$-intercepts of the hyperbola $9{y}^{2}-4{x}^{2}=36$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}9{y}^{2}-4{x}^{2} & =36 \\\\ 9{y}^{2}-4(0)^{2} & =36 \\\\ 9{y}^{2} & =36 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,2)$ and $(0,-2).$"}] [{:db/id #edb/ref 17592186283900 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3cdf9991-54c0-5907-b4c4-386c77f27b9c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283902}] :answer-field/correct {:answer/id #uuid "3cdf9991-54c0-5907-b4c4-386c77f27b9c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186283902} :answer-field/id #uuid "6d4c7cc2-2d02-5c8a-a77e-2125403b00b7" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283901} {:answer-field/choices [{:answer/id #uuid "cc988383-1e89-5565-9753-3d079cedb0fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283904}] :answer-field/correct {:answer/id #uuid "cc988383-1e89-5565-9753-3d079cedb0fb" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186283904} :answer-field/id #uuid "84db0e4a-cac2-5576-81dd-9da53bef1cd8" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186283903}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "51629e1f-11aa-5026-a109-70d1b9705db2" :question/math-academy-id "q-277805" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $3{x}^{2}-{y}^{2}=8$ intersects the line $y=x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=x,$ we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}3{x}^{2}-{y}^{2} & =8 \\\\ 3{x}^{2}-{x}^{2} & =8 \\\\ 2{x}^{2} & =8 \\\\ {x}^{2} & =4 \\\\ x & =\\pm 2\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-2$ and $x=2.$"}] [{:db/id #edb/ref 17592186301116 :knowledge-point/_questions [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d5884d7-3204-56bb-a3e1-01e6a5f5ffc0" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186301118}] :answer-field/correct {:answer/id #uuid "7d5884d7-3204-56bb-a3e1-01e6a5f5ffc0" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186301118} :answer-field/id #uuid "b63db1f3-ea88-5f07-ab7b-81b50aeefc95" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301117} {:answer-field/choices [{:answer/id #uuid "720d944c-b04d-5077-9ade-f1ceffdfbef8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301120}] :answer-field/correct {:answer/id #uuid "720d944c-b04d-5077-9ade-f1ceffdfbef8" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301120} :answer-field/id #uuid "cfc3a74c-3837-5576-930d-3ba36b981b6e" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301119} {:answer-field/choices [{:answer/id #uuid "6bc5eaa3-8965-5275-926b-7088c5559d31" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301122}] :answer-field/correct {:answer/id #uuid "6bc5eaa3-8965-5275-926b-7088c5559d31" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186301122} :answer-field/id #uuid "edff8659-9af4-5a50-b3d3-58a4e13ba45a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301121} {:answer-field/choices [{:answer/id #uuid "e674c832-bf83-5d75-b0f1-0fae48169b8e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301124}] :answer-field/correct {:answer/id #uuid "e674c832-bf83-5d75-b0f1-0fae48169b8e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301124} :answer-field/id #uuid "942b4af1-a431-5d35-85cf-43a0d6977773" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301123}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9a845c77-5cc9-5372-bd5a-7e8ad7351d56" :question/math-academy-id "q-278354" :question/problem "From **left to right,** the $x$-intercepts of the hyperbola $\\frac{(x+2)^{2}}{8}-(y+1)^{2}=1$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand \n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x+2)^{2}}{8}-(y+1)^{2} & =1 \\\\ \\frac{(x+2)^{2}}{8}-(0+1)^{2} & =1 \\\\ \\frac{(x+2)^{2}}{8}-1 & =1 \\\\ \\frac{(x+2)^{2}}{8} & =2 \\\\ (x+2)^{2} & =16 \\\\ x+2 & =\\pm 4 \\\\ x & =-2\\pm 4 \\\\ x & =-6,2\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $(-6,0)$ and $(2,0).$"}] [{:db/id #edb/ref 17592186301125 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "6950356e-f1cc-5544-aec3-79370d5b50d3" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186301127} {:answer/id #uuid "5e409c57-e84d-5595-9b25-e3aa2e5ed443" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301128}] :answer-field/correct {:answer/id #uuid "5e409c57-e84d-5595-9b25-e3aa2e5ed443" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301128} :answer-field/id #uuid "108201fa-896b-5524-9682-3c941d05ea6c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301126} {:answer-field/choices [{:answer/id #uuid "87f845b2-bdf4-521e-bb0a-b68ec0a5096c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186301130}] :answer-field/correct {:answer/id #uuid "87f845b2-bdf4-521e-bb0a-b68ec0a5096c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186301130} :answer-field/id #uuid "f9a5c847-45f1-5c6c-8090-96d035f66658" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301129} {:answer-field/choices [{:answer/id #uuid "ee081372-5870-57d2-8c2f-33ed4a324230" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301132}] :answer-field/correct {:answer/id #uuid "ee081372-5870-57d2-8c2f-33ed4a324230" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301132} :answer-field/id #uuid "e36bd441-b729-521f-9fb8-fb8a71d22de8" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301131} {:answer-field/choices [{:answer/id #uuid "3d09c482-ae4a-58ec-9a3f-dfad1c65c52a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301134}] :answer-field/correct {:answer/id #uuid "3d09c482-ae4a-58ec-9a3f-dfad1c65c52a" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186301134} :answer-field/id #uuid "476bddb0-4b8a-5574-a4dc-51c2ae1694ad" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301133}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f87f5b32-7b23-5cdf-a27a-f28b511b39fd" :question/math-academy-id "q-278365" :question/problem "From **top to bottom,** the $y$-intercepts of the hyperbola $(y-1)^{2}-4(x+1)^{2}=5$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}(y-1)^{2}-4(x+1)^{2} & =5 \\\\ (y-1)^{2}-4(0+1)^{2} & =5 \\\\ (y-1)^{2}-4 & =5 \\\\ (y-1)^{2} & =9 \\\\ y-1 & =\\pm 3 \\\\ y & =1\\pm 3\\end{aligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,4)$ and $(0,-2).$"}] [{:db/id #edb/ref 17592186301135 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b5ff32c9-a1ee-54c2-b0c0-0dce51756eb9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186301137} {:answer/id #uuid "9243e71b-6f29-52fc-8857-f97ef89e0b2c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186301138}] :answer-field/correct {:answer/id #uuid "9243e71b-6f29-52fc-8857-f97ef89e0b2c" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186301138} :answer-field/id #uuid "f6e071a2-fd49-5b19-b77b-9f022c1075d9" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301136} {:answer-field/choices [{:answer/id #uuid "d294ef52-84d0-55e1-bc41-146de4bb5e01" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301140}] :answer-field/correct {:answer/id #uuid "d294ef52-84d0-55e1-bc41-146de4bb5e01" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301140} :answer-field/id #uuid "4541ef8c-3dbc-5838-b937-05bf181ab080" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301139}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a2879669-3000-51c3-a4d3-ac3bae433faf" :question/math-academy-id "q-278371" :question/problem "The hyperbola $\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25}=1$ intersects the line $x=-3$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-3,$ we substitute $x=-3$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{(-3)^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ 1-\\frac{{y}^{2}}{25} & =1 \\\\ -{y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $x=-3$ at $(-3,0).$"}] [{:db/id #edb/ref 17592186264780 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "730c0f83-755b-5070-89cf-87b3254ec271" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264782} {:answer/id #uuid "bae71417-2834-58a6-943c-7f0ad123769b" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186264783}] :answer-field/correct {:answer/id #uuid "730c0f83-755b-5070-89cf-87b3254ec271" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186264782} :answer-field/id #uuid "8e1651f2-d37a-54c2-9114-eef3e43f2e83" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264781} {:answer-field/choices [{:answer/id #uuid "3be5a155-b40c-5e7a-b681-207b7fa85dcf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264785}] :answer-field/correct {:answer/id #uuid "3be5a155-b40c-5e7a-b681-207b7fa85dcf" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186264785} :answer-field/id #uuid "4edf9491-9b0f-5433-9cc4-2aaf28bc63a2" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186264784}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5bea3b57-2a79-53a0-be43-d2e4d30fedc6" :question/math-academy-id "q-278375" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16}=1$ intersects the line $y=-x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=-x,$ we first replace $y$ with $-x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{y}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{(-x)^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{x}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{2{x}^{2}}{16}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{x}^{2}}{16} & =1 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-4$ and $x=4.$"}] [{:db/id #edb/ref 17592186301141 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7f554c7b-d17f-5c77-afd4-c426d4db0197" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186301143} {:answer/id #uuid "3516f67c-8400-57dd-8950-fbdc2cfd4afb" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186301144}] :answer-field/correct {:answer/id #uuid "7f554c7b-d17f-5c77-afd4-c426d4db0197" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186301143} :answer-field/id #uuid "ebca99b6-0b41-5d45-b988-44e7e1caa00c" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301142} {:answer-field/choices [{:answer/id #uuid "57cd5bb8-ae05-5714-ac8f-115b1dc1cbf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186301146}] :answer-field/correct {:answer/id #uuid "57cd5bb8-ae05-5714-ac8f-115b1dc1cbf0" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186301146} :answer-field/id #uuid "f2a78c9f-93cf-5ed6-a0ae-478cf45b1fae" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301145}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9241a770-b44b-526b-8e06-9d9a9d471772" :question/math-academy-id "q-278379" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola ${y}^{2}-{x}^{2}=20$ intersects the line $y=\\sqrt{5}x$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=\\sqrt{5}x,$ we first replace $y$ with $\\sqrt{5}x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}{y}^{2}-{x}^{2} & =20 \\\\ (\\sqrt{5}x)^{2}-{x}^{2} & =20 \\\\ 5{x}^{2}-{x}^{2} & =20 \\\\ 4{x}^{2} & =20 \\\\ {x}^{2} & =5 \\\\ x & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-\\sqrt{5}$ and $x=\\sqrt{5}.$"}] [{:db/id #edb/ref 17592186301147 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c1be411f-8f3c-5b56-97db-ddbcb3b9fc92" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186301149}] :answer-field/correct {:answer/id #uuid "c1be411f-8f3c-5b56-97db-ddbcb3b9fc92" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186301149} :answer-field/id #uuid "f8836543-2e2d-5065-9b7f-2453e70aa4ad" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301148} {:answer-field/choices [{:answer/id #uuid "34e1d10b-0c86-5712-86fe-ff894c8fbf97" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186301151}] :answer-field/correct {:answer/id #uuid "34e1d10b-0c86-5712-86fe-ff894c8fbf97" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186301151} :answer-field/id #uuid "5990432f-7597-517f-8b75-9782d9feb668" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301150}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6bf4a691-ca7d-5cc3-939d-46ca38a01290" :question/math-academy-id "q-278380" :question/problem "In **ascending order,** the $x$-coordinates of the points where the hyperbola $\\frac{{x}^{2}}{8}-{y}^{2}=1$ intersects the line $y=\\frac{x}{4}$ are\n\n$\\,x=$\n{{field-1}}$\\,$ and $\\,x=$\n{{field-2}}." :question/worked-solution "To find the points where the hyperbola intersects the line $y=\\frac{x}{4},$ we first replace $y$ with $\\frac{x}{4}$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{8}-{y}^{2} & =1 \\\\ \\frac{{x}^{2}}{8}-{(\\frac{x}{4})}^{2} & =1 \\\\ \\frac{{x}^{2}}{8}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{2{x}^{2}}{16}-\\frac{{x}^{2}}{16} & =1 \\\\ \\frac{{x}^{2}}{16} & =1 \\\\ {x}^{2} & =16 \\\\ x & =\\pm 4\\end{aligned}\n$$\n\nSo, in ascending order, the $x$-coordinates of the points of intersection are\n$x=-4$ and $x=4.$"}] [{:db/id #edb/ref 17592186301152 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "50e8a0e5-cd0a-50d4-b4f1-75e8233e0869" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301154}] :answer-field/correct {:answer/id #uuid "50e8a0e5-cd0a-50d4-b4f1-75e8233e0869" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186301154} :answer-field/id #uuid "af0d5a47-98fc-5744-806a-36bc9f118977" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301153} {:answer-field/choices [{:answer/id #uuid "c22062ef-2b3d-560e-a4d1-84fa98d28ec0" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186301156}] :answer-field/correct {:answer/id #uuid "c22062ef-2b3d-560e-a4d1-84fa98d28ec0" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186301156} :answer-field/id #uuid "2a099cbe-5269-5b33-b91c-844331a08b28" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186301155}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2d9e0c81-6b02-5579-9b6b-8708b0a4d9f1" :question/math-academy-id "q-278389" :question/problem "The hyperbola ${y}^{2}-\\frac{{x}^{2}}{15}=1$ intersects the line $y=-1$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=-1,$ we substitute $y=-1$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}{y}^{2}-\\frac{{x}^{2}}{15} & =1 \\\\ (-1)^{2}-\\frac{{x}^{2}}{15} & =1 \\\\ 1-\\frac{{x}^{2}}{15} & =1 \\\\ -{x}^{2} & =0 \\\\ x & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $y=-1$  at $(0,-1).$"}] [{:db/id #edb/ref 17592186301157 :knowledge-point/_questions [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e7e833b0-f37f-5e17-af2a-9d7acb9db1b0" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 3,0)" :db/id #edb/ref 17592186301159} {:answer/id #uuid "b66cfcbb-20de-5147-86a9-5dd3deb7044d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 2,0)" :db/id #edb/ref 17592186301160} {:answer/id #uuid "d32f6e05-15d8-5de8-a3d1-5dc593ba22f4" :answer/type {:db/ident :answer.type/text} :answer/value "$(-6,0)$ and $(1,0)$" :db/id #edb/ref 17592186301161} {:answer/id #uuid "8d7b904f-526c-508d-85fd-522bca263c16" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 1,0)" :db/id #edb/ref 17592186301162} {:answer/id #uuid "6cd3cfb5-7e3d-5f5f-903f-cc2b01cf115e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 6,0)" :db/id #edb/ref 17592186301163}] :answer-field/correct {:answer/id #uuid "6cd3cfb5-7e3d-5f5f-903f-cc2b01cf115e" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 6,0)" :db/id #edb/ref 17592186301163} :answer-field/id #uuid "a093ead2-8923-56e6-bcc1-ad43d74d1a8a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301158}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3d9d7e85-5255-5f12-912c-4d0bf7e28676" :question/math-academy-id "q-7998" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\frac{{x}^{2}}{36}-{y}^{2}=1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{36}-{y}^{2} & =1 \\\\ \\frac{{x}^{2}}{36}-{0}^{2} & =1 \\\\ \\frac{{x}^{2}}{36} & =1 \\\\ {x}^{2} & =36 \\\\ x & =\\pm 6\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are  $(\\pm 6,0).$"}] [{:db/id #edb/ref 17592186301164 :knowledge-point/_questions [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4ae189dc-04a8-592b-9d9c-7d82f38debc6" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 3,0)" :db/id #edb/ref 17592186301166} {:answer/id #uuid "35e9d8fa-602a-5ca3-a8d0-d71b79c41d2c" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 2,0)" :db/id #edb/ref 17592186301167} {:answer/id #uuid "ce347165-4d5e-535f-a04d-194874225f3b" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm \\sqrt{7},0)" :db/id #edb/ref 17592186301168} {:answer/id #uuid "260115c7-2c89-52b3-8187-253168c0b971" :answer/type {:db/ident :answer.type/text} :answer/value "$(-1,0)$ and $(\\sqrt{7},0)$" :db/id #edb/ref 17592186301169} {:answer/id #uuid "cbd3b1d9-08ef-51b0-9870-b309b9aacd09" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 1,0)" :db/id #edb/ref 17592186301170}] :answer-field/correct {:answer/id #uuid "cbd3b1d9-08ef-51b0-9870-b309b9aacd09" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 1,0)" :db/id #edb/ref 17592186301170} :answer-field/id #uuid "9fb90dd0-5460-5c46-a7bb-c5008a4026ee" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301165}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f5fd6a2b-7bd6-52aa-a601-e8ffdbf177ac" :question/math-academy-id "q-7999" :question/problem "Calculate the $x$-intercepts of the hyperbola $7{x}^{2}-{y}^{2}=7.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}7{x}^{2}-{y}^{2} & =7 \\\\ 7{x}^{2}-{0}^{2} & =7 \\\\ 7{x}^{2} & =7 \\\\ {x}^{2} & =1 \\\\ x & =\\pm 1\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are $(\\pm 1,0).$"}] [{:db/id #edb/ref 17592186301171 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c13a97fc-0857-5854-81f7-4aa153b6c0b6" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 6,1)" :db/id #edb/ref 17592186301173} {:answer/id #uuid "46d46f9f-68d8-5698-981f-d0f0efdc6122" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 2,1)" :db/id #edb/ref 17592186301174} {:answer/id #uuid "c67a9eef-35ff-57a1-b71c-ebb9e1d4f840" :answer/type {:db/ident :answer.type/text} :answer/value "$(-6,1)$ and $(2,1)$" :db/id #edb/ref 17592186301175} {:answer/id #uuid "76994b50-cf33-5535-8924-55fb7dc4bead" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 1,1)" :db/id #edb/ref 17592186301176} {:answer/id #uuid "eb1617aa-a53d-53ff-bb6a-9f008e94470d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 3,1)" :db/id #edb/ref 17592186301177}] :answer-field/correct {:answer/id #uuid "eb1617aa-a53d-53ff-bb6a-9f008e94470d" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 3,1)" :db/id #edb/ref 17592186301177} :answer-field/id #uuid "5197aa73-11ca-5e49-8a59-308fe56ef21c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301172}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8392e8a3-2418-5758-beb0-b6249b0b9f62" :question/math-academy-id "q-8008" :question/problem "Calculate the points where the hyperbola \n$\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2}=1$\nintersects the line $y=1.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=1,$ we substitute $y=1$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{6}-\\frac{{y}^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{(1)^{2}}{2} & =1 \\\\ \\frac{{x}^{2}}{6}-\\frac{1}{2} & =1 \\\\ \\frac{{x}^{2}}{6} & =\\frac{3}{2} \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $y=1$ at the points $(\\pm 3,1).$"}] [{:db/id #edb/ref 17592186301178 :knowledge-point/_questions [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8141732a-89ee-55f6-9fd7-8eb64fe35ccc" :answer/type {:db/ident :answer.type/math} :answer/value "(\\frac{\\sqrt{7}}{\\sqrt{5}},0)" :db/id #edb/ref 17592186301180} {:answer/id #uuid "bc415796-13ef-506a-a175-9a8014f25323" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $x$-intercepts" :db/id #edb/ref 17592186301181} {:answer/id #uuid "b56a848a-b562-50f6-a74d-bc5f43837297" :answer/type {:db/ident :answer.type/text} :answer/value "$(3-\\frac{\\sqrt{2}}{\\sqrt{5}},0)$ and $(3+\\frac{\\sqrt{7}}{\\sqrt{5}},0)$" :db/id #edb/ref 17592186301182} {:answer/id #uuid "a82a4f97-76f1-5905-abca-58d805f2a6bf" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm \\frac{\\sqrt{7}}{\\sqrt{5}},0)" :db/id #edb/ref 17592186301183} {:answer/id #uuid "a2387914-b692-5224-829a-75a8044d4dc0" :answer/type {:db/ident :answer.type/text} :answer/value "$(\\frac{\\sqrt{2}}{\\sqrt{5}},0)-3$ and $(3+\\frac{\\sqrt{7}}{\\sqrt{5}},0)$" :db/id #edb/ref 17592186301184}] :answer-field/correct {:answer/id #uuid "bc415796-13ef-506a-a175-9a8014f25323" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $x$-intercepts" :db/id #edb/ref 17592186301181} :answer-field/id #uuid "69dfec48-55b3-5ce6-afe8-0ca479798c17" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301179}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "95b8b9a1-4a35-54df-becb-a839929aef00" :question/math-academy-id "q-84034" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\frac{(y+2)^{2}}{5}-\\frac{(x-3)^{2}}{7}=1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y+2)^{2}}{5}-\\frac{(x-3)^{2}}{7} & =1 \\\\ \\frac{(0+2)^{2}}{5}-\\frac{(x-3)^{2}}{7} & =1 \\\\ \\frac{4}{5}-\\frac{(x-3)^{2}}{7} & =1 \\\\ -\\frac{(x-3)^{2}}{7} & =1-\\frac{4}{5} \\\\ -\\frac{(x-3)^{2}}{7} & =\\frac{1}{5} \\\\ (x-3)^{2} & =-\\frac{7}{5}\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions.\nSo, there are no $x$-intercepts."}] [{:db/id #edb/ref 17592186301185 :knowledge-point/_questions [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "baece31e-e0a7-5752-b60e-57c790cada08" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 3,0)" :db/id #edb/ref 17592186301187} {:answer/id #uuid "167754a0-1b2c-519d-aed8-35c33b4b1b5a" :answer/type {:db/ident :answer.type/math} :answer/value "(\\pm 2,0)" :db/id #edb/ref 17592186301188} {:answer/id #uuid "6a30cd29-a0b6-585a-b0c1-9fd17751f49e" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $x$-intercepts" :db/id #edb/ref 17592186301189} {:answer/id #uuid "7bcd3ddf-964b-5192-970e-a976a7c53321" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186301190} {:answer/id #uuid "f7f8fd14-921c-5f0b-9cd5-633bd3a180d3" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186301191}] :answer-field/correct {:answer/id #uuid "f7f8fd14-921c-5f0b-9cd5-633bd3a180d3" :answer/type {:db/ident :answer.type/math} :answer/value "(-2,0)" :db/id #edb/ref 17592186301191} :answer-field/id #uuid "aacad3fd-c824-5aee-a547-a6fbe265d58c" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301186}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f9a5c8f5-6df2-5eca-b39f-786fbb5a8fd5" :question/math-academy-id "q-84035" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9}=1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(0-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ 1-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(x+2)^{2}}{9} & =0 \\\\ (x+2)^{2} & =0 \\\\ x+2 & =0 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(-2,0).$"}] [{:db/id #edb/ref 17592186088369 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "84fae736-399a-5371-9e9d-8484ee13deaa" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-4)" :db/id #edb/ref 17592186087145} {:answer/id #uuid "1c68ae03-2ab0-5e0d-ae49-205b0b2138ff" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186087146} {:answer/id #uuid "29c705fe-2df4-5cac-ab5d-741d0bb0c632" :answer/type {:db/ident :answer.type/math} :answer/value "(0, ± 4)" :db/id #edb/ref 17592186087147} {:answer/id #uuid "5624da29-141f-5a43-b364-63297517048a" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 2)" :db/id #edb/ref 17592186087148} {:answer/id #uuid "6fb6e9bb-46d9-5c52-bc31-4026991e8d15" :answer/type {:db/ident :answer.type/math} :answer/value "(0, ± 2)" :db/id #edb/ref 17592186087149}] :answer-field/correct {:answer/id #uuid "1c68ae03-2ab0-5e0d-ae49-205b0b2138ff" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186087146} :answer-field/id #uuid "321f0aca-1d7c-55e9-ac65-c704df881437" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087144}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "73a6a21a-1a66-5641-b8d4-54583c604a6c" :question/math-academy-id "q-84041" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(x-2)^{2}}{5}-\\frac{(y+4)^{2}}{16}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{5}-\\frac{(y+4)^{2}}{16} & =1 \\\\ \\frac{(0-2)^{2}}{5}-\\frac{(y+4)^{2}}{16} & =1 \\\\ \\frac{4}{5}-\\frac{(y+4)^{2}}{16} & =1 \\\\ -\\frac{(y+4)^{2}}{16} & =1-\\frac{4}{5} \\\\ -\\frac{(y+4)^{2}}{16} & =\\frac{1}{5} \\\\ (y+4)^{2} & =-\\frac{16}{5}\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. So, there are no $y$-intercepts."}] [{:db/id #edb/ref 17592186301192 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "adaaf5c2-65b9-5746-bc8d-75bced1fbe69" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 1)" :db/id #edb/ref 17592186301194} {:answer/id #uuid "255ebf71-6097-5256-b200-3e5b52765786" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-3)$ and $(0,1)$" :db/id #edb/ref 17592186301195} {:answer/id #uuid "34c07e36-70cb-53cb-b255-b254a19e9318" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1)$ and $(0,3)$" :db/id #edb/ref 17592186301196} {:answer/id #uuid "e1354de4-1800-53b3-9c12-3e1f039a48e2" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 3)" :db/id #edb/ref 17592186301197} {:answer/id #uuid "7f4716e9-3280-5ee7-9d30-9baa652c1ac7" :answer/type {:db/ident :answer.type/text} :answer/value "There are no $y$-intercepts" :db/id #edb/ref 17592186301198}] :answer-field/correct {:answer/id #uuid "34c07e36-70cb-53cb-b255-b254a19e9318" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-1)$ and $(0,3)$" :db/id #edb/ref 17592186301196} :answer-field/id #uuid "24dbd187-b699-5b59-ba73-c233916d0e31" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301193}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c6a70575-ac5b-5e8c-8521-83fa0f483f95" :question/math-academy-id "q-84044" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(y-1)^{2}}{4}-\\frac{{x}^{2}}{9}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-1)^{2}}{4}-\\frac{{x}^{2}}{9} & =1 \\\\ \\frac{(y-1)^{2}}{4}-\\frac{(0)^{2}}{9} & =1 \\\\ \\frac{(y-1)^{2}}{4} & =1 \\\\ (y-1)^{2} & =4 \\\\ y-1 & =\\pm 2 \\\\ y & =-1,3\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,-1)$ and $(0,3).$"}] [{:db/id #edb/ref 17592186301199 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b65aa6d7-feae-511d-9353-563e7f8b1af1" :answer/type {:db/ident :answer.type/math} :answer/value "(0,0)" :db/id #edb/ref 17592186301201} {:answer/id #uuid "78bffe17-f56e-5c1a-9f1f-bacc8061950a" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 10)" :db/id #edb/ref 17592186301202} {:answer/id #uuid "4a804d43-a4f4-5c7c-b2fd-bb34ea613022" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-10)$ and $(0,0)$" :db/id #edb/ref 17592186301203} {:answer/id #uuid "b4c4f00d-839b-5f29-b521-d491c55fb9dc" :answer/type {:db/ident :answer.type/math} :answer/value "(0,\\pm 2)" :db/id #edb/ref 17592186301204} {:answer/id #uuid "34c00606-6cbb-5695-b209-c6e048d3089d" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,0)$ and $(0,10)$" :db/id #edb/ref 17592186301205}] :answer-field/correct {:answer/id #uuid "4a804d43-a4f4-5c7c-b2fd-bb34ea613022" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,-10)$ and $(0,0)$" :db/id #edb/ref 17592186301203} :answer-field/id #uuid "66405c08-966f-5ead-92f7-2ac2c71ede34" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186301200}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "dae43ba5-c596-5f19-bf54-5832efb2d2de" :question/math-academy-id "q-84060" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(y+5)^{2}}{5}-(x-2)^{2}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y+5)^{2}}{5}-(x-2)^{2} & =1 \\\\ \\frac{(y+5)^{2}}{5}-(0-2)^{2} & =1 \\\\ \\frac{(y+5)^{2}}{5}-4 & =1 \\\\ \\frac{(y+5)^{2}}{5} & =5 \\\\ (y+5)^{2} & =25 \\\\ y+5 & =\\pm 5 \\\\ y & =-10,0\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,-10)$ and $(0,0).$"}]}
