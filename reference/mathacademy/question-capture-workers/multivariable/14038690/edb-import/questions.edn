#{[{:db/id #edb/ref 17592186087487 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331" :knowledge-point/title "Finding the X-Intercepts of a Hyperbola"}] :question/id #uuid "03bb8d2d-55c5-5511-94c5-73e73db9ccf8" :question/math-academy-id "e-5361" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\dfrac{(x+1)^2}{10} - \\dfrac{y^2}{25} = 1$." :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x$, as follows:\n\n$$\n\\begin{aligned}\n((x + 1)^{2})/(10) - \\frac{y^{2}}{25} &= 1 \\\\\n((x + 1)^{2})/(10) - \\frac{0^{2}}{25} &= 1 \\\\\n((x + 1)^{2})/(10) &= 1 \\\\\n(x + 1)^{2} &= 10 \\\\\nx + 1 &= ± \\sqrt{10} \\\\\nx &= -1 ± \\sqrt{10}\n\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are\n\n$$\n\\left(-1\\pm \\sqrt{10},0\\right)\n$$"}] [{:db/id #edb/ref 17592186087488 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/id #uuid "b3eac4e2-5e85-5669-8dfb-c7fe4e5a47ae" :question/math-academy-id "e-5362" :question/problem "Calculate the points where the hyperbola\n$\\dfrac{x^2}{10}-\\dfrac{y^2}{15}=1$\nintersects the line $y=-3$." :question/worked-solution "To find the points where the hyperbola intersects the line $y=-3$, we substitute $y=-3$ into the equation of the hyperbola and solve for $x$, as follows:\n\n$$\n\\begin{aligned}\n\\frac{x^{2}}{10} - \\frac{y^{2}}{15} &= 1 \\\\\n\\frac{x^{2}}{10} - ((-3)^{2})/(15) &= 1 \\\\\n\\frac{x^{2}}{10} - \\frac{9}{15} &= 1 \\\\\n\\frac{x^{2}}{10} - \\frac{3}{5} &= 1 \\\\\nx^{2} - 6 &= 10 \\\\\nx^{2} &= 16 \\\\\nx &= ± 4\n\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $y=-3$ at the points $(\\pm 4, -3)$."}] [{:db/id #edb/ref 17592186087564 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/id #uuid "bb09b5f0-832f-5008-970c-87c6dfaf076f" :question/math-academy-id "e-7424" :question/problem "Calculate the $y$-intercepts of the hyperbola $7y^2 -5x^2 = 28$." :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y$, as follows:\n\n$$\n\\begin{aligned}\n7y^{2} - 5x^{2} &= 28 \\\\\n7y^{2} - 5(0)^{2} &= 28 \\\\\n7y^{2} &= 28 \\\\\ny^{2} &= 4 \\\\\ny &= ± 2\n\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,\\pm 2)$."}] [{:db/id #edb/ref 17592186087565 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/id #uuid "0704ee42-bc8c-5d98-b6f2-ad952ab41560" :question/math-academy-id "e-7425" :question/problem "Calculate the $x$-coordinates of the points where the hyperbola $\\dfrac{x^2}{9} - \\dfrac{y^2}{25}=1$ intersects the line $y = x$.\n\n![](/home/jake/Developer/MA/DATA/Lessons/874/Source/Images/39c8aedbe6ab698c5a77db42509d3ef3.png)" :question/worked-solution "To find the points where the hyperbola intersects the line $y=x$, we first replace $y$ with $x$ in the equation of the hyperbola and solve for $x$, as follows:\n\n$$\n\\begin{aligned}\n\\frac{x^{2}}{9} - \\frac{y^{2}}{25} &= 1 \\\\\n\\frac{x^{2}}{9} - \\frac{x^{2}}{25} &= 1 \\\\\n\\frac{16x^{2}}{225} &= 1 \\\\\nx^{2} &= \\frac{225}{16} \\\\\nx &= ± \\frac{15}{4}\n\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186087990 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4c79fc0-efad-5466-a67a-72ca914e15bf" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186084952} {:answer/id #uuid "dca49ea5-5dfd-5248-a586-d8fa04eb30a2" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± 2)" :db/id #edb/ref 17592186084953} {:answer/id #uuid "e9f302f5-8089-52ab-9b55-187b379e8f0b" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± \\frac{27}{4})" :db/id #edb/ref 17592186084954} {:answer/id #uuid "07872847-3bc9-5c80-b26a-f2c2bc6c0c31" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± 3)" :db/id #edb/ref 17592186084955} {:answer/id #uuid "5fd31179-8068-5c46-aff1-bc7938ecd242" :answer/type {:db/ident :answer.type/math} :answer/value "(-1, ± \\frac{3\\sqrt{3}}{2})" :db/id #edb/ref 17592186084956}] :answer-field/correct {:answer/id #uuid "d4c79fc0-efad-5466-a67a-72ca914e15bf" :answer/type {:db/ident :answer.type/text} :answer/value "There are no points of intersection" :db/id #edb/ref 17592186084952} :answer-field/id #uuid "a95cd287-a359-5541-840d-95f027e8ed16" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186084951}] :question/id #uuid "2b576f63-e1f4-5329-9152-0aa7a896a79e" :question/math-academy-id "q-170556" :question/problem "Calculate the points where the hyperbola $\\frac{x^{2}}{4} - \\frac{y^{2}}{9} = 1$ intersects the line $x =-1$."}] [{:db/id #edb/ref 17592186264735 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d09b0e76-0168-5cde-95ad-0e066947d8c7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264737}] :answer-field/correct {:answer/id #uuid "d09b0e76-0168-5cde-95ad-0e066947d8c7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186264737} :answer-field/id #uuid "