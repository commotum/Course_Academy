ge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2"] :knowledge-point/questions ["q-84060"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278389/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "50e8a0e5-cd0a-50d4-b4f1-75e8233e0869" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278389/field-1" :answer-field/id #uuid "af0d5a47-98fc-5744-806a-36bc9f118977" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278389/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278389/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-278389/field-2/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "c22062ef-2b3d-560e-a4d1-84fa98d28ec0" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-278389/field-2" :answer-field/id #uuid "2a099cbe-5269-5b33-b91c-844331a08b28" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278389/field-2/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer-field/choices ["q-278389/field-2/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26"] :db/ensure [:answer-field/validate]} {:db/id "q-278389" :question/id #uuid "2d9e0c81-6b02-5579-9b6b-8708b0a4d9f1" :question/math-academy-id "q-278389" :question/problem "The hyperbola ${y}^{2}-\\frac{{x}^{2}}{15}=1$ intersects the line $y=-1$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=-1,$ we substitute $y=-1$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}{y}^{2}-\\frac{{x}^{2}}{15} & =1 \\\\ (-1)^{2}-\\frac{{x}^{2}}{15} & =1 \\\\ 1-\\frac{{x}^{2}}{15} & =1 \\\\ -{x}^{2} & =0 \\\\ x & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $y=-1$  at $(0,-1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278389/field-1" "q-278389/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793"] :knowledge-point/questions ["q-278389"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278371/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "9243e71b-6f29-52fc-8857-f97ef89e0b2c" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-278371/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "b5ff32c9-a1ee-54c2-b0c0-0dce51756eb9" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-278371/field-1" :answer-field/id #uuid "f6e071a2-fd49-5b19-b77b-9f022c1075d9" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278371/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-278371/field-1/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-278371/field-1/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-278371/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "d294ef52-84d0-55e1-bc41-146de4bb5e01" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278371/field-2" :answer-field/id #uuid "4541ef8c-3dbc-5838-b937-05bf181ab080" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278371/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278371/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-278371" :question/id #uuid "a2879669-3000-51c3-a4d3-ac3bae433faf" :question/math-academy-id "q-278371" :question/problem "The hyperbola $\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25}=1$ intersects the line $x=-3$ at\n\n$($\n{{field-1}}, \n{{field-2}} $).$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-3,$ we substitute $x=-3$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ \\frac{(-3)^{2}}{9}-\\frac{{y}^{2}}{25} & =1 \\\\ 1-\\frac{{y}^{2}}{25} & =1 \\\\ -{y}^{2} & =0 \\\\ y & =0\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the horizontal line $x=-3$ at $(-3,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278371/field-1" "q-278371/field-2"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793"] :knowledge-point/questions ["q-278371"] :db/ensure [:knowledge-point/validate]} {:db/id "q-8008/selection/d2ce60433a043ef1ede19a316d9f8ca889a73511988c568d626066c8dc140542" :answer/id #uuid "eb1617aa-a53d-53ff-bb6a-9f008e94470d" :answer/type :answer.type/math :answer/value "(\\pm 3,1)" :db/ensure [:answer/validate]} {:db/id "q-8008/selection/13e3b1775ccb86b84bbc6c100901983834bd9a5d3e97cdc5b79389941c4b18fc" :answer/id #uuid "c13a97fc-0857-5854-81f7-4aa153b6c0b6" :answer/type :answer.type/math :answer/value "(\\pm 6,1)" :db/ensure [:answer/validate]} {:db/id "q-8008/selection/4782820ea87a34816b301551a91de49b535c01a1e29c7c43e4a6c834d48738a5" :answer/id #uuid "46d46f9f-68d8-5698-981f-d0f0efdc6122" :answer/type :answer.type/math :answer/value "(\\pm 2,1)" :db/ensure [:answer/validate]} {:db/id "q-8008/selection/524d9e86ba63293ed96c1eb80414aec523e6ec67cdb4596452f6b8c07c5df573" :answer/id #uuid "c67a9eef-35ff-57a1-b71c-ebb9e1d4f840" :answer/type :answer.type/text :answer/value "$(-6,1)$ and $(2,1)$" :db/ensure [:answer/validate]} {:db/id "q-8008/selection/6