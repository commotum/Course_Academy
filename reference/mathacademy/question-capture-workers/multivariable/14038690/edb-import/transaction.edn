 "q-7998" :question/id #uuid "3d9d7e85-5255-5f12-912c-4d0bf7e28676" :question/math-academy-id "q-7998" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\frac{{x}^{2}}{36}-{y}^{2}=1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{{x}^{2}}{36}-{y}^{2} & =1 \\\\ \\frac{{x}^{2}}{36}-{0}^{2} & =1 \\\\ \\frac{{x}^{2}}{36} & =1 \\\\ {x}^{2} & =36 \\\\ x & =\\pm 6\\end{aligned}\n$$\n\nTherefore, the $x$-intercepts are  $(\\pm 6,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-7998/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331"] :knowledge-point/questions ["q-7998"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84035/selection/6f65bf5fc685efb73c66e2b8812d2e1b8ac93ae973e09216a37a83512fb94f61" :answer/id #uuid "6a30cd29-a0b6-585a-b0c1-9fd17751f49e" :answer/type :answer.type/text :answer/value "There are no $x$-intercepts" :db/ensure [:answer/validate]} {:db/id "q-84035/selection/981a2951e3fccc9ba81c501537ab818060069591c658c07fba6936fa5fd0dd27" :answer/id #uuid "7bcd3ddf-964b-5192-970e-a976a7c53321" :answer/type :answer.type/math :answer/value "(3,0)" :db/ensure [:answer/validate]} {:db/id "q-84035/selection/21222b9c4748093197e8e6a8fabbba14cf9b24871c4c9556fbb1213d9d4bcb0a" :answer/id #uuid "baece31e-e0a7-5752-b60e-57c790cada08" :answer/type :answer.type/math :answer/value "(\\pm 3,0)" :db/ensure [:answer/validate]} {:db/id "q-84035/selection/f8f5c5c5a92e426c4a187ab875cfbbfb5810b5f5d8cbecd52ddcec8ce5053ecb" :answer/id #uuid "f7f8fd14-921c-5f0b-9cd5-633bd3a180d3" :answer/type :answer.type/math :answer/value "(-2,0)" :db/ensure [:answer/validate]} {:db/id "q-84035/selection/26b096bce36c63f274eed2844a7d3b09612ebc01a12309c05b9eb1ada685d00e" :answer/id #uuid "167754a0-1b2c-519d-aed8-35c33b4b1b5a" :answer/type :answer.type/math :answer/value "(\\pm 2,0)" :db/ensure [:answer/validate]} {:db/id "q-84035/selection" :answer-field/id #uuid "aacad3fd-c824-5aee-a547-a6fbe265d58c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84035/selection/f8f5c5c5a92e426c4a187ab875cfbbfb5810b5f5d8cbecd52ddcec8ce5053ecb" :answer-field/choices ["q-84035/selection/6f65bf5fc685efb73c66e2b8812d2e1b8ac93ae973e09216a37a83512fb94f61" "q-84035/selection/981a2951e3fccc9ba81c501537ab818060069591c658c07fba6936fa5fd0dd27" "q-84035/selection/21222b9c4748093197e8e6a8fabbba14cf9b24871c4c9556fbb1213d9d4bcb0a" "q-84035/selection/f8f5c5c5a92e426c4a187ab875cfbbfb5810b5f5d8cbecd52ddcec8ce5053ecb" "q-84035/selection/26b096bce36c63f274eed2844a7d3b09612ebc01a12309c05b9eb1ada685d00e"] :db/ensure [:answer-field/validate]} {:db/id "q-84035" :question/id #uuid "f9a5c8f5-6df2-5eca-b39f-786fbb5a8fd5" :question/math-academy-id "q-84035" :question/problem "Calculate the $x$-intercepts of the hyperbola $\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9}=1.$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(0-2)^{2}}{4}-\\frac{(x+2)^{2}}{9} & =1 \\\\ 1-\\frac{(x+2)^{2}}{9} & =1 \\\\ \\frac{(x+2)^{2}}{9} & =0 \\\\ (x+2)^{2} & =0 \\\\ x+2 & =0 \\\\ x & =-2\\end{aligned}\n$$\n\nTherefore, the $x$-intercept is $(-2,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84035/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331"] :knowledge-point/questions ["q-84035"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278354/field-1/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "7d5884d7-3204-56bb-a3e1-01e6a5f5ffc0" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:a