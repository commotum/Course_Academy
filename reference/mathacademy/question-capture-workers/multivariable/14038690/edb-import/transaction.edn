1-5d35-85cf-43a0d6977773" :answer-field/key "field-4" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278354/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278354/field-4/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-278354" :question/id #uuid "9a845c77-5cc9-5372-bd5a-7e8ad7351d56" :question/math-academy-id "q-278354" :question/problem "From **left to right,** the $x$-intercepts of the hyperbola $\\frac{(x+2)^{2}}{8}-(y+1)^{2}=1$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand \n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $x$-intercepts of the hyperbola, we substitute $y=0$ into the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x+2)^{2}}{8}-(y+1)^{2} & =1 \\\\ \\frac{(x+2)^{2}}{8}-(0+1)^{2} & =1 \\\\ \\frac{(x+2)^{2}}{8}-1 & =1 \\\\ \\frac{(x+2)^{2}}{8} & =2 \\\\ (x+2)^{2} & =16 \\\\ x+2 & =\\pm 4 \\\\ x & =-2\\pm 4 \\\\ x & =-6,2\\end{aligned}\n$$\n\nTherefore, from left to right, the $x$-intercepts are $(-6,0)$ and $(2,0).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278354/field-1" "q-278354/field-2" "q-278354/field-3" "q-278354/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2de185a6-24a0-55aa-905d-8893a555e331"] :knowledge-point/questions ["q-278354"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-84041"] :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(x-2)^{2}}{5}-\\frac{(y+4)^{2}}{16}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(x-2)^{2}}{5}-\\frac{(y+4)^{2}}{16} & =1 \\\\ \\frac{(0-2)^{2}}{5}-\\frac{(y+4)^{2}}{16} & =1 \\\\ \\frac{4}{5}-\\frac{(y+4)^{2}}{16} & =1 \\\\ -\\frac{(y+4)^{2}}{16} & =1-\\frac{4}{5} \\\\ -\\frac{(y+4)^{2}}{16} & =\\frac{1}{5} \\\\ (y+4)^{2} & =-\\frac{16}{5}\\end{aligned}\n$$\n\nWe cannot take the square root of a negative number. Therefore, the equation has no real solutions. So, there are no $y$-intercepts." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-84044/selection/5dc5346c45050060e67df02c81a9273dcc8642ec4733d100c80334e6dbacdae7" :answer/id #uuid "34c07e36-70cb-53cb-b255-b254a19e9318" :answer/type :answer.type/text :answer/value "$(0,-1)$ and $(0,3)$" :db/ensure [:answer/validate]} {:db/id "q-84044/selection/ac3af717d5979e3a75b9044f25a5f3b02e4715376cbbb753b146faded1ea47b8" :answer/id #uuid "e1354de4-1800-53b3-9c12-3e1f039a48e2" :answer/type :answer.type/math :answer/value "(0,\\pm 3)" :db/ensure [:answer/validate]} {:db/id "q-84044/selection/0b750ee53a257966a9e77c1391e96388485f001caa39e027698ca7276ebfed13" :answer/id #uuid "adaaf5c2-65b9-5746-bc8d-75bced1fbe69" :answer/type :answer.type/math :answer/value "(0,\\pm 1)" :db/ensure [:answer/validate]} {:db/id "q-84044/selection/56f4333305444f21ac6e627e2ada8af9cfd9b62b84d6eb7d3f6300971d270871" :answer/id #uuid "255ebf71-6097-5256-b200-3e5b52765786" :answer/type :answer.type/text :answer/value "$(0,-3)$ and $(0,1)$" :db/ensure [:answer/validate]} {:db/id "q-84044/selection/dae5335f979b458799ffc035d2adfc1f0d0e4959597eec73a82bdb6dc329f121" :answer/id #uuid "7f4716e9-3280-5ee7-9d30-9baa652c1ac7" :answer/type :answer.type/text :answer/value "There are no $y$-intercepts" :db/ensure [:answer/validate]} {:db/id "q-84044/selection" :answer-field/id #uuid "24dbd187-b699-5b59-ba73-c233916d0e31" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-84044/selection/5dc5346c45050060e67df02c81a9273dcc8642ec4733d100c80334e6dbacdae7" :answer-field/choices ["q-84044/selection/5dc5346c45050060e67df02c81a9273dcc8642ec4733d100c80334e6dbacdae7" "q-84044/selection/ac3af717d5979e3a75b9044f25a5f3b02e4715376cbbb753b146faded1ea47b8" "q-84044/selection/0b750ee53a257966a9e77c1391e96388485f001caa39e027698ca7276ebfed13" "q-84044/selection/56f4333305444f21ac6e627e2ada8af9cfd9b62b84d6eb7d3f6300971d270871" "q-84044/selection/dae5335f979b458799ffc035d2adfc1f0d0e4959597eec73a82bdb6dc329f121"] :db/ensure [:answer-field/validate]} {:db/id "q-84044" :question/id #uuid "c6a70575-ac5b-5e8c-8521-83fa0f483f95" :question/math-academy-id "q-84044" :question/problem "Calculate the $y$-intercepts of the hyperbola $\\frac{(y-1)^{2}}{4}-\\frac{{x}^{2}}{9}=1.$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-1)^{2}}{4}-\\frac{{x}^{2}}{9} & =1 \\\\ \\frac{(y-1)^{2}}{4}-\\frac{(0)^{2}}{9} & =1 \\\\ \\frac{(y-1)^{2}}{4} & =1 \\\\ (y-1)^{2} & =4 \\\\ y-1 & =\\pm 2 \\\\ y & =-1,3\\end{aligned}\n$$\n\nTherefore, the $y$-intercepts are $(0,-1)$ and $(0,3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-84044/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2"] :knowledge-point/questions ["q-84044"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278365/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "5e409c57-e84d-5595-9b25-e3aa2e5ed443" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278365/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "6950356e-f1cc-5544-aec3-79370d5b50d3" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-278365/field-1" :answer-field/id #uuid "108201fa-896b-5524-9682-3c941d05ea6c" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278365/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e38