c6dc6b5e490" :answer-field/choices ["q-278365/field-4/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490"] :db/ensure [:answer-field/validate]} {:db/id "q-278365" :question/id #uuid "f87f5b32-7b23-5cdf-a27a-f28b511b39fd" :question/math-academy-id "q-278365" :question/problem "From **top to bottom,** the $y$-intercepts of the hyperbola $(y-1)^{2}-4(x+1)^{2}=5$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}(y-1)^{2}-4(x+1)^{2} & =5 \\\\ (y-1)^{2}-4(0+1)^{2} & =5 \\\\ (y-1)^{2}-4 & =5 \\\\ (y-1)^{2} & =9 \\\\ y-1 & =\\pm 3 \\\\ y & =1\\pm 3\\end{aligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,4)$ and $(0,-2).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-278365/field-1" "q-278365/field-2" "q-278365/field-3" "q-278365/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2"] :knowledge-point/questions ["q-278365"] :db/ensure [:knowledge-point/validate]} {:db/id "q-84060/selection/228d7b42fcb34515143bb5c9b68cc81052255c360fff1053199a2147dbd7eb12" :answer/id #uuid "b65aa6d7-feae-511d-9353-563e7f8b1af1" :answer/type :answer.type/math :answer/value "(0,0)" :db/ensure [:answer/validate]} {:db/id "q-84060/selection/4e49f0cc1787db9c01949fd1c6d376bfb23bd8e40806b9ff24358b19773c21aa" :answer/id #uuid "78bffe17-f56e-5c1a-9f1f-bacc8061950a" :answer/type :answer.type/math :answer/value "(0,\\pm 10)" :db/ensure [:answer/validate]} {:db/id "q-84060/selection/c2d7a8530ee76cd48410676dd25d672a58b41edb9844598e76b319744b248e3b" :answer/id #uuid "b4c4f00d-839b-5f29-b521-d491c55fb9dc" :answer/type :answer.type/math :answer/value "(0,\\pm 2)" :db/ensure [:answer/validate]} {:db/id "q-84060/selection/5b73d4722e1019afbba9957577ce8f559f82688b3d4ed