2}^{3-x}(\\frac{y}{6})|x-2{|}^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}{\\int }_{x/2}^{3-x}(\\frac{y}{6})(x-2)^{2}\\,\\text{d}y\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}({x}^{2}-4x+4)[{\\int }_{x/2}^{3-x}\\frac{y}{6}\\,\\text{d}y]\\text{d}x \\\\  & ={\\int }_{0}^{2}({x}^{2}-4x+4){[\\frac{{y}^{2}}{12}]}_{x/2}^{3-x}\\,\\text{d}x \\\\  & ={\\int }_{0}^{2}({x}^{2}-4x+4)[\\frac{(3-x)^{2}}{12}-\\frac{{x}^{2}}{48}]\\text{d}x \\\\  & =\\frac{1}{48}{\\int }_{0}^{2}({x}^{2}-4x+4)(36-24x+3{x}^{2})\\,\\text{d}x \\\\  & =\\frac{1}{48}{\\int }_{0}^{2}3{x}^{4}-36{x}^{3}+144{x}^{2}-240x+144\\,\\text{d}x \\\\  & ={[\\frac{{x}^{5}}{80}-\\frac{3{x}^{4}}{16}+{x}^{3}-\\frac{5{x}^{2}}{2}+3x]}_{0}^{2} \\\\  & =(\\frac{2}{5}-3+8-10+6)-0 \\\\  & =\\frac{7}{5}.\\end{aligned}\n$$" 13194139535857 true] [17592186370616 1000 #edb/ref 17592186370617 13194139535857 true] [17592186370616 1000 #edb/ref 17592186370618 13194139535857 true] [17592186370616 1000 #edb/ref 17592186370619 13194139535857 true] [17592186370616 1000 #edb/ref 17592186370620 13194139535857 true] [17592186370616 1000 #edb/ref 17592186370621 13194139535857 true] [17592186370616 1040 #edb/ref 17592186045450 13194139535857 true] [17592186370616 1041 "selection" 13194139535857 true] [17592186370616 1104 #edb/ref 17592186370617 13194139535857 true] [17592186370616 1110 #uuid "4cec18bb-5c6a-5cee-80c8-b9188f37c88f" 13194139535857 true] [17592186370617 1034 "\\frac{7}{5}" 13194139535857 true] [17592186370617 1103 #edb/ref 17592186045453 13194139535857 true] [17592186370617 1111 #uuid "a43d5434-d1f7-58c6-84d8-61594421e8be" 13194139535857 true] [17592186370618 1034 "\\frac{1}{4}" 13194139535857 true] [17592186370618 1103 #edb/ref 17592186045453 13194139535857 true] [17592186370618 1111 #uuid "9c6b6585-adfc-57a3-ae7b-7ce88ec212fb" 13194139535857 true] [17592186370619 1034 "1" 13194139535857 true] [17592186370619 1103 #edb/ref 17592186045453 13194139535857 true] [17592186370619 1111 #uuid "9b177870-5a68-534b-8de9-386f825eb02a" 13