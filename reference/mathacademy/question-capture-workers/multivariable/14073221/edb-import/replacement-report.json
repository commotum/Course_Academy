    {
      "question": "e-8742",
      "field": null,
      "attribute": "question/worked-solution",
      "old_sha256": "f9449e09a79cca95bf8fe4e8fd674286425a9a6af2590e94767540855685f02c",
      "new_sha256": "a70d3bb23108353a6dacabd5e60e7f15c806e96637fb80efe0014d20b1c2b5b6",
      "category": "ma_capture",
