#{[{:db/id #edb/ref 17592186184411 :knowledge-point/_questions [{:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723" :knowledge-point/title "Calculating the Position Vector of a Particle Moving With Constant Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7d4875e8-5487-5ab7-96a7-0d77e7d194a2" :answer/type {:db/ident :answer.type/math} :answer/value "(4i-7j)\\,\\text{mm}" :db/id #edb/ref 17592186306651} {:answer/id #uuid "e4571d5a-445a-5b9e-b93d-210bf8fe49fb" :answer/type {:db/ident :answer.type/math} :answer/value "(16i+49j)\\,\\text{mm}" :db/id #edb/ref 17592186306652} {:answer/id #uuid "c826faa3-9ccf-5b37-91b0-f036170396e2" :answer/type {:db/ident :answer.type/math} :answer/value "(25i+36j)\\,\\text{mm}" :db/id #edb/ref 17592186306653} {:answer/id #uuid "5678055e-a5fe-5883-9892-528f0e2caaf3" :answer/type {:db/ident :answer.type/math} :answer/value "(3i-8j)\\,\\text{mm}" :db/id #edb/ref 17592186306654} {:answer/id #uuid "5f974428-619f-5125-ba74-0bae2af9a1a9" :answer/type {:db/ident :answer.type/math} :answer/value "(9i-64j)\\,\\text{mm}" :db/id #edb/ref 17592186306655}] :answer-field/correct {:answer/id #uuid "5f974428-619f-5125-ba74-0bae2af9a1a9" :answer/type {:db/ident :answer.type/math} :answer/value "(9i-64j)\\,\\text{mm}" :db/id #edb/ref 17592186306655} :answer-field/id #uuid "27d20681-f8f5-5211-8cd3-9f1bfb441efa" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186306650}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7b69163c-7d60-5882-a4d4-0cf0337f664b" :question/math-academy-id "q-136413" :question/problem "A particle starts moving from the point with position vector $(-i+j)\\,\\text{mm}$ with an acceleration of $(2i-6j)\\,{\\text{mm/min}}^{2}$ and an initial velocity of $(-3i+2j)\\,\\text{mm/min}.$ Find the position vector of the particle after $5$ minutes." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=-i+j,\\,u=-3i+2j,\\,a=2i-6j.\n$$\n\nTherefore, the position vector of the particle after $t=5\\,\\text{min}$ is\n\n$$\n\\begin{aligned}r & =(-i+j)+(-3i+2j)(5)+\\frac{1}{2}(2i-6j)(5)^{2} \\\\  & =(-i+j)+(-15i+10j)+25(i-3j) \\\\  & =(-16i+11j)+(25i-75j) \\\\  & =(9i-64j)\\,\\text{mm}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186306698 :knowledge-point/_questions [{:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723" :knowledge-point/title "Calculating the Position Vector of a Particle Moving With Constant Acceleration"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e11a6f89-e45d-55f2-9cf5-3a573e61c6ea" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186306700} {:answer/id #uuid "0ebd4de9-ed98-5cb7-a34a-9e305896dd0c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186306701}] :answer-field/correct {:answer/id #uuid "e11a6f89-e45d-55f2-9cf5-3a573e61c6ea" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186306700} :answer-field/id #uuid "659d0a08-fdac-53a0-9dce-6b38aa942d2d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306699} {:answer-field/choices [{:answer/id #uuid "446e3c86-62fe-567c-9736-ff7fb09fbe10" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186306703}] :answer-field/correct {:answer/id #uuid "446e3c86-62fe-567c-9736-ff7fb09fbe10" :answer/type {:db/ident :answer.type/math} :answer/value "22" :db/id #edb/ref 17592186306703} :answer-field/id #uuid "315ad1a6-46bd-5233-af8e-3644e8d1fe8f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186306702}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ea3a2584-019c-5965-92b5-cae1e20c4ed5" :question/math-academy-id "q-280507" :question/problem "A toy rocket is launched from the origin with an initial velocity of $(2i+6j)\\,\\text{m/s}$ and a constant acceleration of $(i+5j)\\,{\\text{m/s}}^{2}.$ Determine the position vector of the rocket after $2$ seconds.\n\n$r=(${{field-1}}\n$i\\,\\,+$\n{{field-2}}\n$j)\\text{m}$" :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=2i+6j,\\,a=i+5j.\n$$\n\nTherefore, the position vector of the rocket after $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(2i+6j)(2)+\\frac{1}{2}(i+5j)(2)^{2} \\\\  & =(4i+12j)+2(i+5j) \\\\  & =(4i+12j)+(2i+10j) \\\\  & =(\\,6\\,i+22\\,j)\\,\\text{m}.\\end{aligned}\n$$"}]}
