[{:db/id "q-136421/selection/2a47cc0f9a7e01d5127a5ac67f88b5212f7ea30721e8bbd78b92d7b2bb28e024" :answer/id #uuid "c0f498ec-6645-5506-8fb2-66b54d905e64" :answer/type :answer.type/math :answer/value "(-i+7j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136421/selection/e8a850ad0921e57572e56ec3d1cc3c58499c117541238e670f74f027c40e99ba" :answer/id #uuid "d161d792-8d20-59ae-92fe-7ba19a48864b" :answer/type :answer.type/math :answer/value "(5i+4j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136421/selection/5b3b66380acbae93a8bee3f42ea3c9b2ef0cb941ca6d2c7c260be96ecd354d98" :answer/id #uuid "51425dc3-2c2f-522b-909a-13593eafe024" :answer/type :answer.type/math :answer/value "(6i+8j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136421/selection/a45324615f26bf8504bf5901fb7cbe3aeef9ac31d3bdb48f10495a11b76baecd" :answer/id #uuid "7661d792-b266-5d3f-93b4-d4b7314a4b58" :answer/type :answer.type/math :answer/value "(-2i+3j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136421/selection/c8ab630ed6f575701deed3b04df64a88c3773de1c59dc8d07aa37b0664a2df76" :answer/id #uuid "0b398788-2674-5084-87dd-493d093a8d44" :answer/type :answer.type/math :answer/value "(3i-2j)\\,\\text{cm}" :db/ensure [:answer/validate]} {:db/id "q-136421/selection" :answer-field/id #uuid "0bc3a45e-49db-54bd-a70f-84b405f31c5d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-136421/selection/5b3b66380acbae93a8bee3f42ea3c9b2ef0cb941ca6d2c7c260be96ecd354d98" :answer-field/choices ["q-136421/selection/2a47cc0f9a7e01d5127a5ac67f88b5212f7ea30721e8bbd78b92d7b2bb28e024" "q-136421/selection/e8a850ad0921e57572e56ec3d1cc3c58499c117541238e670f74f027c40e99ba" "q-136421/selection/5b3b66380acbae93a8bee3f42ea3c9b2ef0cb941ca6d2c7c260be96ecd354d98" "q-136421/selection/a45324615f26bf8504bf5901fb7cbe3aeef9ac31d3bdb48f10495a11b76baecd" "q-136421/selection/c8ab630ed6f575701deed3b04df64a88c3773de1c59dc8d07aa37b0664a2df76"] :db/ensure [:answer-field/validate]} {:db/id "q-136421" :question/id #uuid "b9569422-93f6-508c-ab48-5885d38ead4c" :question/math-academy-id "q-136421" :question/problem "A particle moves from the origin with an acceleration of $(-i+3j)\\,{\\text{cm/s}}^{2}$ and an initial velocity of $(4i+j)\\,\\text{cm/s}.$ Find the position vector of the particle after $2$ seconds." :question/worked-solution "If a particle moves with constant acceleration $a,$ the position vector of the particle at time $t$ can be found using\n\n$$\nr={r}_{0}+ut+\\frac{1}{2}a{t}^{2},\n$$\n\n \n\nwhere ${r}_{0}$ is the initial position of the particle and $u$ is its initial velocity.\n\nIn our case, we have\n\n$$\n{r}_{0}=0i+0j,\\,u=4i+j,\\,a=-i+3j.\n$$\n\nTherefore, the position vector of the particle after $t=2\\,\\text{s}$ is\n\n$$\n\\begin{aligned}r & =(0i+0j)+(4i+j)(2)+\\frac{1}{2}(-i+3j)(2)^{2} \\\\  & =(8i+2j)+2(-i+3j) \\\\  & =(8i+2j)+(-2i+6j) \\\\  & =(6i+8j)\\,\\text{cm}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-136421/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "da1d8490-fd41-5363-97d2-91b360f10723"] :knowledge-point/questions ["q-136421"] :db/ensure [:knowledge-point/validate]}]
