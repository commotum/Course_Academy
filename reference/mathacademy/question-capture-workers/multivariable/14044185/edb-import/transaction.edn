[{:db/id "q-36009/selection/0d537869bd836ff6ccc184ace92781b467dde90b45668c9660cef515d361dce7" :answer/id #uuid "370101e8-f0d3-542f-88e1-85fb406467aa" :answer/type :answer.type/math :answer/value "⟨4,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-36009/selection/133f2e9f69a348442496d2554e3d9c43d76c18370797638aa1222ce33b6ad88c" :answer/id #uuid "9a54122b-ae0b-527c-aa09-c75bc5d6cb73" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{2},\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-36009/selection/a57e80096fb2bf588bf40a69fc53c1a76a8ca656e492eff53bdff1a1cab44191" :answer/id #uuid "83e8c5d6-1572-5aa3-a073-f1b3dd635640" :answer/type :answer.type/math :answer/value "⟨8,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-36009/selection/c4e67a03f3817d73b01b78eb31c8098d116b228bdd219679dbfdaf1b28117f1d" :answer/id #uuid "f16f9c53-e38f-5977-bc6f-e09308a2dfcb" :answer/type :answer.type/math :answer/value "⟨\\frac{1}{2},\\,\\frac{1}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-36009/selection/949c1b0e0a03ffec722f105079bfe7f0ece4f3a06131ac85fc9ddb891750ada2" :answer/id #uuid "6ab86f77-0e51-5721-a100-0ce32d596b9b" :answer/type :answer.type/math :answer/value "⟨8,\\,\\frac{1}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-36009/selection" :answer-field/id #uuid "fdd82221-210d-5d2e-ab3e-6dc5bedcecda" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36009/selection/0d537869bd836ff6ccc184ace92781b467dde90b45668c9660cef515d361dce7" :answer-field/choices ["q-36009/selection/0d537869bd836ff6ccc184ace92781b467dde90b45668c9660cef515d361dce7" "q-36009/selection/133f2e9f69a348442496d2554e3d9c43d76c18370797638aa1222ce33b6ad88c" "q-36009/selection/a57e80096fb2bf588bf40a69fc53c1a76a8ca656e492eff53bdff1a1cab44191" "q-36009/selection/c4e67a03f3817d73b01b78eb31c8098d116b228bdd219679dbfdaf1b28117f1d" "q-36009/selection/949c1b0e0a03ffec722f105079bfe7f0ece4f3a06131ac85fc9ddb891750ada2"] :db/ensure [:answer-field/validate]} {:db/id "q-36009" :question/id #uuid "9e4ad275-9622-528e-a709-a49a6640457d" :question/math-academy-id "q-36009" :question/problem "Evaluate the gradient of $g(x,y)$ at the point $(\\frac{1}{2},0)$ if $g(x,y)=\\operatorname{ln}⁡({x}^{2}+{y}^{2}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡({x}^{2}+{y}^{2})) \\\\  & =\\frac{2x}{{x}^{2}+{y}^{2}} \\\\ {g}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡({x}^{2}+{y}^{2})) \\\\  & =\\frac{2y}{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y) & =⟨{g}_{x}(x,y),\\,{g}_{y}(x,y)⟩ \\\\  & =⟨\\frac{2x}{{x}^{2}+{y}^{2}},\\,\\frac{2y}{{x}^{2}+{y}^{2}}⟩ \\\\  & =\\frac{2}{{x}^{2}+{y}^{2}}⟨x,\\,y⟩ \\\\ ∇g(\\frac{1}{2},\\,0) & =\\frac{2}{{(\\frac{1}{2})}^{2}+{0}^{2}}⟨\\frac{1}{2},\\,0⟩ \\\\  & =\\frac{2}{\\,\\frac{1}{4}}⟨\\frac{1}{2},\\,0⟩ \\\\  & =8⟨\\frac{1}{2},\\,0⟩ \\\\  & =⟨4,\\,0⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36009/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3991a54-342b-5cd0-87e2-606146240555"] :knowledge-point/questions ["q-36009"] :db/ensure [:knowledge-point/validate]} {:db/id "q-127650/selection/f0ecb7dae4fcc03873a045d00accce810ae542f9be5781a51f4b0c0c942cd451" :answer/id #uuid "ff4c28ca-2ae4-5148-873e-52fe0628f333" :answer/type :answer.type/math :answer/value "\\frac{y}{{x}^{2}+{y}^{2}}\\,i-\\frac{x}{{x}^{2}+{y}^{2}}\\,j" :db/ensure [:answer/validate]} {:db/id "q-127650/selection/bcd8c59db5ab1e222c2044bec0b5f02e5db371b187704ef2d4f85f3997a822ba" :answer/id #uuid "4cf3d895-38fb-560e-9311-c84c978b5e70" :answer/type :answer.type/math :answer/value "-\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j" :db/ensure [:answer/validate]} {:db/id "q-127650/selection/6686868691e71468025b8c255782361caf30ecacaa6337e7b0a019e154d14f73" :answer/id #uuid "f992c27a-3aa3-5b25-a53b-b09803eb38c2" :answer/type :answer.type/math :answer/value "-\\frac{x}{{x}^{2}+{y}^{2}}\\,i+\\frac{y}{{x}^{2}+{y}^{2}}\\,j" :db/ensure [:answer/validate]} {:db/id "q-127650/selection/a864cea16403ea67e95bddbec733fe1a2a324acecb0b707c685425e9ce923568" :answer/id #uuid "bbfa2fc3-370f-5074-b45d-a4bcfe22385c" :answer/type :answer.type/math :answer/value "-\\frac{{y}^{2}}{{x}^{2}+{y}^{2}}\\,i+\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}\\,j" :db/ensure [:answer/validate]} {:db/id "q-127650/selection/6c7b1de26308989b11ce05977e6c1b93c2395af1d10a799cd429e5906513529f" :answer/id #uuid "b4e6eaeb-666a-51e9-b07f-636cdbe0eb89" :answer/type :answer.type/math :answer/value "\\frac{x}{{x}^{2}+{y}^{2}}\\,i-\\frac{y}{{x}^{2}+{y}^{2}}\\,j" :db/ensure [:answer/validate]} {:db/id "q-127650/selection" :answer-field/id #uuid "1efb1ae1-3f4a-5d3d-a89e-d5688befc68f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-127650/selection/bcd8c59db5ab1e222c2044bec0b5f02e5db371b187704ef2d4f85f3997a822ba" :answer-field/choices ["q-127650/selection/f0ecb7dae4fcc03873a045d00accce810ae542f9be5781a51f4b0c0c942cd451" "q-127650/selection/bcd8c59db5ab1e222c2044bec0b5f02e5db371b187704ef2d4f85f3997a822ba" "q-127650/selection/6686868691e71468025b8c255782361caf30ecacaa6337e7b0a019e154d14f73" "q-127650/selection/a864cea16403ea67e95bddbec733fe1a2a324acecb0b707c685425e9ce923568" "q-127650/selection/6c7b1de26308989b11ce05977e6c1b93c2395af1d10a799cd429e5906513529f"] :db/ensure [:answer-field/validate]} {:db/id "q-127650" :question/id #uuid "a0611e4b-e342-5f93-a418-5af6bc5c2cae" :question/math-academy-id "q-127650" :question/problem "If $h(x,y)=\\operatorname{arctan}⁡(\\frac{y}{x}),$ find $∇h(x,y).$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{arctan}⁡(\\frac{y}{x})) \\\\  & =\\frac{1}{1+{(\\frac{y}{x})}^{2}}\\cdot (-\\frac{y}{{x}^{2}}) \\\\  & =\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}\\cdot (-\\frac{y}{{x}^{2}}) \\\\  & =-\\frac{y}{{x}^{2}+{y}^{2}} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{arctan}⁡(\\frac{y}{x})) \\\\  & =\\frac{1}{1+{(\\frac{y}{x})}^{2}}\\cdot (\\frac{1}{x}) \\\\  & =\\frac{{x}^{2}}{{x}^{2}+{y}^{2}}\\cdot \\frac{1}{x} \\\\  & =\\frac{x}{{x}^{2}+{y}^{2}}\\end{aligned}\n$$\n\nHence, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =-\\frac{y}{{x}^{2}+{y}^{2}}\\,i+\\frac{x}{{x}^{2}+{y}^{2}}\\,j.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-127650/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3991a54-342b-5cd0-87e2-606146240555"] :knowledge-point/questions ["q-127650"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36909/selection/8160cae1a4dcc29a6028eb8cc6099e8a7ea44d21087cbeff33cfcf8acc285744" :answer/id #uuid "5119b1d7-d13e-59d0-abb9-2172b807cfd4" :answer/type :answer.type/math :answer/value "⟨2,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-36909/selection/444044e4d2f17f2a026f3c5a7efdddae3d3a5572ee6b80d2fe6c2af0dbe2cab6" :answer/id #uuid "97c29d9a-b56e-575a-bea6-fc9c720b4614" :answer/type :answer.type/math :answer/value "⟨16,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-36909/selection/cb518e8b3ddaed57bf0540fe6ea15c5efa4793adca75505f53e3782d3a29fc9c" :answer/id #uuid "51d7f3a3-0460-5db5-9724-4364d5b0f5b8" :answer/type :answer.type/math :answer/value "⟨1,\\,8⟩" :db/ensure [:answer/validate]} {:db/id "q-36909/selection/d8e572cfca97b810346d085a9bee1f002d95f3d392b827986ee5cd0ae401d510" :answer/id #uuid "5a4c2e76-f516-516d-86b4-b638410d0ba4" :answer/type :answer.type/math :answer/value "⟨4,\\,\\frac{1}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-36909/selection/f3e71a8cc13bdf6e73d53944aac1fef3caf439af06261f4fcd46f8ccadbf3ea3" :answer/id #uuid "1d47619d-3143-503d-8a2e-833171e1f019" :answer/type :answer.type/math :answer/value "⟨8,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-36909/selection" :answer-field/id #uuid "6b9313d2-223a-5492-8acd-3451f9c60859" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36909/selection/f3e71a8cc13bdf6e73d53944aac1fef3caf439af06261f4fcd46f8ccadbf3ea3" :answer-field/choices ["q-36909/selection/8160cae1a4dcc29a6028eb8cc6099e8a7ea44d21087cbeff33cfcf8acc285744" "q-36909/selection/444044e4d2f17f2a026f3c5a7efdddae3d3a5572ee6b80d2fe6c2af0dbe2cab6" "q-36909/selection/cb518e8b3ddaed57bf0540fe6ea15c5efa4793adca75505f53e3782d3a29fc9c" "q-36909/selection/d8e572cfca97b810346d085a9bee1f002d95f3d392b827986ee5cd0ae401d510" "q-36909/selection/f3e71a8cc13bdf6e73d53944aac1fef3caf439af06261f4fcd46f8ccadbf3ea3"] :db/ensure [:answer-field/validate]} {:db/id "q-36909" :question/id #uuid "1a7ed09f-9f05-555b-9eaa-822f524c2066" :question/math-academy-id "q-36909" :question/problem "Evaluate $∇f(x,y)$ at $(2,1)$ if $f(x,y)={x}^{2}\\sqrt{y+3}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}({x}^{2}\\sqrt{y+3}) \\\\  & =2x\\sqrt{y+3} \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}({x}^{2}\\sqrt{y+3}) \\\\  & =\\frac{{x}^{2}}{2\\sqrt{y+3}}.\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇f(x,y) & =⟨{f}_{x}(x,y),\\,{f}_{y}(x,y)⟩ \\\\  & =⟨2x\\sqrt{y+3},\\,\\frac{{x}^{2}}{2\\sqrt{y+3}}⟩ \\\\ ∇f(2,1) & =⟨2\\cdot 2\\sqrt{1+3},\\,\\frac{{2}^{2}}{2\\sqrt{1+3}}⟩ \\\\  & =⟨8,\\,1⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-36909/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3991a54-342b-5cd0-87e2-606146240555"] :knowledge-point/questions ["q-36909"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36910/selection/5facfdb21017dd9219e2094d42fdbabe27e31610d12d801afb8fb90fc866d90f" :answer/id #uuid "2149c1ce-92ee-5f0f-a4fc-a149e0e2dd39" :answer/type :answer.type/math :answer/value "\\frac{1}{x}\\text{ }i+(\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2}))\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36910/selection/1291ff220385c31c6904d8c0395e2d3c64031e7912819a37a986c9de9613ca75" :answer/id #uuid "70e3141d-a5d0-5ca1-b683-0e024ec5eb31" :answer/type :answer.type/math :answer/value "\\frac{1}{x}\\text{ }i+2y(\\frac{1}{y}-\\operatorname{sin}⁡({y}^{2}))\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36910/selection/b7e01b6f9b14d1194ac7356e25ecda64c8b8ed141f8b085a03754747ad08143e" :answer/id #uuid "105995d5-2226-5382-a9b5-99a70b28be11" :answer/type :answer.type/math :answer/value "\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36910/selection/57516ea0ffb542dfb80b3d5d1f1b6c695938dc21368999627d18885e5e1c40e4" :answer/id #uuid "9d35c10d-6a93-59d8-81d2-417749409903" :answer/type :answer.type/math :answer/value "\\frac{1}{x}\\text{ }i+(\\frac{1}{y}+2y\\operatorname{sin}⁡y)\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36910/selection/86248e425f9cf4f0bdb58b5452b4c1ebee941ccc31deb658119668068cb6255f" :answer/id #uuid "444b83e9-e15e-50d4-992b-e48405842f1b" :answer/type :answer.type/math :answer/value "x\\text{ }i+(y-2\\operatorname{sin}⁡({y}^{2}))\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36910/selection" :answer-field/id #uuid "1f0035b9-d683-5dd8-92bd-aaf233d562f5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36910/selection/5facfdb21017dd9219e2094d42fdbabe27e31610d12d801afb8fb90fc866d90f" :answer-field/choices ["q-36910/selection/5facfdb21017dd9219e2094d42fdbabe27e31610d12d801afb8fb90fc866d90f" "q-36910/selection/1291ff220385c31c6904d8c0395e2d3c64031e7912819a37a986c9de9613ca75" "q-36910/selection/b7e01b6f9b14d1194ac7356e25ecda64c8b8ed141f8b085a03754747ad08143e" "q-36910/selection/57516ea0ffb542dfb80b3d5d1f1b6c695938dc21368999627d18885e5e1c40e4" "q-36910/selection/86248e425f9cf4f0bdb58b5452b4c1ebee941ccc31deb658119668068cb6255f"] :db/ensure [:answer-field/validate]} {:db/id "q-36910" :question/id #uuid "dd2b62c5-efe3-5e02-b543-0d0ea8f6f7df" :question/math-academy-id "q-36910" :question/problem "Given  $g(x,y)=\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})$, find $∇g(x,y).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\frac{1}{xy}\\cdot y+0 \\\\  & =\\frac{1}{x} \\\\ {g}_{y}(x,y) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy)+\\operatorname{cos}⁡({y}^{2})) \\\\  & =\\frac{1}{xy}\\cdot x-\\operatorname{sin}⁡({y}^{2})\\cdot 2y \\\\  & =\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2})\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y) & ={g}_{x}(x,y)\\text{ }i+{g}_{y}(x,y)\\text{ }j \\\\  & =\\frac{1}{x}\\text{ }i+(\\frac{1}{y}-2y\\operatorname{sin}⁡({y}^{2}))\\text{ }j\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-36910/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3991a54-342b-5cd0-87e2-606146240555"] :knowledge-point/questions ["q-36910"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36005/selection/152d873e4e27ae7c528b97627be793e0d7c088e07118b299468c1e594702f563" :answer/id #uuid "a4df7eb0-3c26-5b38-8b3c-8c99d60ff686" :answer/type :answer.type/math :answer/value "⟨\\pi ,\\,\\frac{1}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-36005/selection/7d895d43ab6ef7050d730c0bf8bc55508e8c5fef16c12367968d17c119e32163" :answer/id #uuid "6ea2bb53-d001-51e3-ba3e-4fb89335aff7" :answer/type :answer.type/math :answer/value "⟨1,\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-36005/selection/327a8173a140f79ff8039407dcfe46318b5a5ad7679e2b7a1e673d58f3262099" :answer/id #uuid "75ad26b6-4b71-5314-9b40-4d4081baa138" :answer/type :answer.type/math :answer/value "⟨\\pi ,\\,2⟩" :db/ensure [:answer/validate]} {:db/id "q-36005/selection/3d1656679899d705e7072cb4a67f0855372c43472366f1735964fbccf3caef46" :answer/id #uuid "a19a28dc-5f3f-5716-a0c0-f918a1e503aa" :answer/type :answer.type/math :answer/value "⟨\\frac{\\pi }{4},\\,\\frac{1}{2}⟩" :db/ensure [:answer/validate]} {:db/id "q-36005/selection/04cd2f9b427140a9c2b9a6009b9575515d18eaa183f384344ac8c7b6e437e880" :answer/id #uuid "4c68294b-0fbd-533a-b28a-ade02f6f1473" :answer/type :answer.type/math :answer/value "⟨2\\pi ,\\,0⟩" :db/ensure [:answer/validate]} {:db/id "q-36005/selection" :answer-field/id #uuid "db26f052-1bd9-5295-a69e-2c88308e514a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36005/selection/327a8173a140f79ff8039407dcfe46318b5a5ad7679e2b7a1e673d58f3262099" :answer-field/choices ["q-36005/selection/152d873e4e27ae7c528b97627be793e0d7c088e07118b299468c1e594702f563" "q-36005/selection/7d895d43ab6ef7050d730c0bf8bc55508e8c5fef16c12367968d17c119e32163" "q-36005/selection/327a8173a140f79ff8039407dcfe46318b5a5ad7679e2b7a1e673d58f3262099" "q-36005/selection/3d1656679899d705e7072cb4a67f0855372c43472366f1735964fbccf3caef46" "q-36005/selection/04cd2f9b427140a9c2b9a6009b9575515d18eaa183f384344ac8c7b6e437e880"] :db/ensure [:answer-field/validate]} {:db/id "q-36005" :question/id #uuid "daba266b-1065-59e3-9dc2-9f65876ed44e" :question/math-academy-id "q-36005" :question/problem "Evaluate $∇h(x,y)$ at $(1,1)$ if $h(x,y)=4x\\operatorname{arctan}⁡y.$" :question/worked-solution "First, we find the partial derivatives\n\n$$\n\\begin{aligned}{h}_{x}(x,y) & =\\frac{∂}{∂x}(4x\\operatorname{arctan}⁡y) \\\\  & =4\\operatorname{arctan}⁡y \\\\ {h}_{y}(x,y) & =\\frac{∂}{∂y}(4x\\operatorname{arctan}⁡y) \\\\  & =\\frac{4x}{{y}^{2}+1}\\end{aligned}\n$$\n\nHence, the gradient is \n\n$$\n\\begin{aligned}∇h(x,y) & =⟨{h}_{x}(x,y),\\,{h}_{y}(x,y)⟩ \\\\  & =⟨4\\operatorname{arctan}⁡y,\\,\\frac{4x}{{y}^{2}+1}⟩ \\\\ ∇h(1,1) & =⟨4\\operatorname{arctan}⁡1,\\,\\frac{4\\cdot 1}{{1}^{2}+1}⟩ \\\\  & =⟨4\\cdot \\frac{\\pi }{4},\\,\\frac{4}{2}⟩ \\\\  & =⟨\\pi ,\\,2⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36005/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e3991a54-342b-5cd0-87e2-606146240555"] :knowledge-point/questions ["q-36005"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71422/selection/1b9a2f74d903413043e99b50b83bb5df8b3d4ffc581e48a08fbb10cd0379f9f2" :answer/id #uuid "9c239c6b-37e1-5b8e-a57a-73307d8c8417" :answer/type :answer.type/math :answer/value "x\\operatorname{ln}⁡(z)\\text{ }i+y\\operatorname{ln}⁡(z)\\text{ }j+xy\\operatorname{ln}⁡(z)\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71422/selection/be29d17feb41392565af75a435e11e63b403a1dd1713937b17b4b31dec9f9fbd" :answer/id #uuid "cfd1c9a6-260d-55ee-8e92-f9bc072ea873" :answer/type :answer.type/math :answer/value "y\\operatorname{ln}⁡(z)\\text{ }i+x\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71422/selection/59ea46d33f14381295a32de1a2a9342f4ce3a26dd14b5282166b9cb15ab27501" :answer/id #uuid "b3d68e50-2da9-58c3-8a78-76a81f5f608c" :answer/type :answer.type/math :answer/value "y\\operatorname{ln}⁡(yz+zx)\\text{ }i+y\\operatorname{ln}⁡(yz+zx)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71422/selection/6dddccbbeeddbccc20f35b6b5b937c2f57befa5095fd56ca4f86ff7754df5e21" :answer/id #uuid "f614b845-cc57-56a2-affd-17b2f34d9efa" :answer/type :answer.type/math :answer/value "xy\\operatorname{ln}⁡(z)\\text{ }i+xy\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71422/selection/738d84bab87e777c784beb362758514b29279e93f83f766e46b19c0a08fcb632" :answer/id #uuid "8c6a6797-d951-5cf8-90fb-3941f50a293c" :answer/type :answer.type/math :answer/value "y\\operatorname{ln}⁡(z)\\text{ }i+xy\\text{ }j+\\frac{xy}{z}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71422/selection" :answer-field/id #uuid "4ea13f0c-3125-506e-9a94-48f0f0d33cd4" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71422/selection/be29d17feb41392565af75a435e11e63b403a1dd1713937b17b4b31dec9f9fbd" :answer-field/choices ["q-71422/selection/1b9a2f74d903413043e99b50b83bb5df8b3d4ffc581e48a08fbb10cd0379f9f2" "q-71422/selection/be29d17feb41392565af75a435e11e63b403a1dd1713937b17b4b31dec9f9fbd" "q-71422/selection/59ea46d33f14381295a32de1a2a9342f4ce3a26dd14b5282166b9cb15ab27501" "q-71422/selection/6dddccbbeeddbccc20f35b6b5b937c2f57befa5095fd56ca4f86ff7754df5e21" "q-71422/selection/738d84bab87e777c784beb362758514b29279e93f83f766e46b19c0a08fcb632"] :db/ensure [:answer-field/validate]} {:db/id "q-71422" :question/id #uuid "6c344ff7-e9ae-55ca-a2d0-77f8ef1490ec" :question/math-academy-id "q-71422" :question/problem "Given $h(x,y,z)=xy\\operatorname{ln}⁡(z)$, find $∇h(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xy\\operatorname{ln}⁡(z)) \\\\  & =y\\operatorname{ln}⁡(z) \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xy\\operatorname{ln}⁡(z)) \\\\  & =x\\operatorname{ln}⁡(z) \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy\\operatorname{ln}⁡(z)) \\\\  & =xy\\cdot \\frac{1}{z} \\\\  & =\\frac{xy}{z}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇h(x,y,z) & ={h}_{x}(x,y,z)\\text{ }i+{h}_{y}(x,y,z)\\text{ }j+{h}_{z}(x,y,z)\\text{ }k \\\\  & =y\\operatorname{ln}⁡(z)\\text{ }i+x\\operatorname{ln}⁡(z)\\text{ }j+\\frac{xy}{z}\\text{ }k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71422/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe2c7ce2-f053-57af-9f4d-54bd3a41648a"] :knowledge-point/questions ["q-71422"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186124936 :question/answer-fields 17592186122638] {:db/id "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/a6270fb43f742a505597cd4fcb841e7a4b6b3a94b6f9fb86c9dce0db38fc5849" :answer/id #uuid "935d9087-8c8c-5b2e-9f13-ba5456bc0201" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/ensure [:answer/validate]} {:db/id "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/4382dd89e85168696dbfac025b479293f775380a0070eaf6a2497632fac4b43d" :answer/id #uuid "bde88c02-d3a0-5dc5-9b71-2721b766cd22" :answer/type :answer.type/math :answer/value "\\frac{xyz}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)" :db/ensure [:answer/validate]} {:db/id "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/0f75847097e4657b1c9021ec28d4a267e1c840e01e6f9b497ce7dbe10fab7260" :answer/id #uuid "05244f5e-d6a4-5d76-a9c3-b11654af4906" :answer/type :answer.type/math :answer/value "\\sqrt{xyz}(\\frac{1}{yz}\\text{ }i+\\frac{1}{xz}\\text{ }j+\\frac{1}{xz}\\text{ }k)" :db/ensure [:answer/validate]} {:db/id "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/62f9773be4fd8ec9bedb1ca8a7e0ccc5c5e5a611272813006855757633892585" :answer/id #uuid "dee595db-c30f-57ee-b47b-2bcdaa74dabb" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{xyz}}{2}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/ensure [:answer/validate]} {:db/id "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/5edd7a892bea971b353f17ddb7bc1ace6f2b82b186edc0135432f39a24300acd" :answer/id #uuid "874788d4-cd64-5c6d-9dcc-ef206db24cc7" :answer/type :answer.type/math :answer/value "\\sqrt{xyz}(x\\text{ }i+y\\text{ }j+z\\text{ }k)" :db/ensure [:answer/validate]} {:db/id "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af" :answer-field/id #uuid "aeaa6590-a3d4-5880-a241-0086a1c1766d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/a6270fb43f742a505597cd4fcb841e7a4b6b3a94b6f9fb86c9dce0db38fc5849" :answer-field/choices ["q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/a6270fb43f742a505597cd4fcb841e7a4b6b3a94b6f9fb86c9dce0db38fc5849" "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/4382dd89e85168696dbfac025b479293f775380a0070eaf6a2497632fac4b43d" "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/0f75847097e4657b1c9021ec28d4a267e1c840e01e6f9b497ce7dbe10fab7260" "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/62f9773be4fd8ec9bedb1ca8a7e0ccc5c5e5a611272813006855757633892585" "q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af/5edd7a892bea971b353f17ddb7bc1ace6f2b82b186edc0135432f39a24300acd"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-36918"] :question/problem "Given $f(x,y,z)=\\sqrt{xyz}$, find $∇f(x,y,z).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (yz) \\\\  & =\\frac{\\sqrt{xyz}}{2x} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xz) \\\\  & =\\frac{\\sqrt{xyz}}{2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{xyz}) \\\\  & =\\frac{1}{2\\sqrt{xyz}}\\cdot (xy) \\\\  & =\\frac{\\sqrt{xyz}}{2z}\\end{aligned}\n$$\n\nHence, the gradient is:\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2x}\\text{ }i+\\frac{\\sqrt{xyz}}{2y}\\text{ }j+\\frac{\\sqrt{xyz}}{2z}\\text{ }k \\\\  & =\\frac{\\sqrt{xyz}}{2}(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k)\\end{aligned}\n$$" :question/answer-fields ["q-36918/selection/ma-v1/dccab4b13f7720b6f23cf8e3db4663a1fb77eb5bf47065b80fa3e93005a392af"] :db/ensure [:question/validate]} {:db/id "q-36969/selection/c652fb3135d724c89a7234b814f291081acb967bb9fd02b43d72657fd6ced1a7" :answer/id #uuid "340200eb-1f6d-5a1a-a225-ae6a5ad50768" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\text{ }i+\\frac{1}{3}\\text{ }j+k" :db/ensure [:answer/validate]} {:db/id "q-36969/selection/c112e75a14cc40a654f0e6c5a8c91af2713f83226822e305f1e7293fe47437b5" :answer/id #uuid "8aa04ad3-1965-5cdd-bd20-64eb74dfdd88" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\text{ }i+\\frac{1}{3}\\text{ }j-k" :db/ensure [:answer/validate]} {:db/id "q-36969/selection/1ec383fc4d78583489e29313db02ad3f47001ff5f91cabc4070b1e6e02d2d1aa" :answer/id #uuid "37f35ce1-3d41-5800-b80b-1f9d6b494ce3" :answer/type :answer.type/math :answer/value "\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36969/selection/9faa4cdfd5b1f2fc05ed8b9bdc485a784384643c9fa0f894b0e9d904ba24af4f" :answer/id #uuid "1fa8b1c8-c1b5-561c-a34d-295da42aa0fb" :answer/type :answer.type/math :answer/value "4\\text{ }i+6\\text{ }j-2\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36969/selection/9d4eb03b4f52ef9019d4439467932c22896bc8aed65fb2cfb34cfc891cd4b35a" :answer/id #uuid "ea537af5-5a44-548c-99a4-cec902923a61" :answer/type :answer.type/math :answer/value "\\frac{1}{2}\\text{ }i+\\frac{\\sqrt{6}}{6}\\text{ }j-\\frac{\\sqrt{2}}{2}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36969/selection" :answer-field/id #uuid "b80b74db-3b3b-5238-9a12-9241366f66ec" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36969/selection/1ec383fc4d78583489e29313db02ad3f47001ff5f91cabc4070b1e6e02d2d1aa" :answer-field/choices ["q-36969/selection/c652fb3135d724c89a7234b814f291081acb967bb9fd02b43d72657fd6ced1a7" "q-36969/selection/c112e75a14cc40a654f0e6c5a8c91af2713f83226822e305f1e7293fe47437b5" "q-36969/selection/1ec383fc4d78583489e29313db02ad3f47001ff5f91cabc4070b1e6e02d2d1aa" "q-36969/selection/9faa4cdfd5b1f2fc05ed8b9bdc485a784384643c9fa0f894b0e9d904ba24af4f" "q-36969/selection/9d4eb03b4f52ef9019d4439467932c22896bc8aed65fb2cfb34cfc891cd4b35a"] :db/ensure [:answer-field/validate]} {:db/id "q-36969" :question/id #uuid "c1593ff0-2dc2-5070-ae82-476823174170" :question/math-academy-id "q-36969" :question/problem "Evaluate $∇f(x,y,z)$ at the point $(2,3,1)$ if $f(x,y,z)=\\operatorname{ln}⁡(\\sqrt{xyz}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{f}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot yz \\\\  & =\\frac{1}{2x} \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot xz \\\\  & =\\frac{1}{2y} \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{ln}⁡(\\sqrt{xyz})) \\\\  & =\\frac{1}{\\sqrt{xyz}}\\cdot \\frac{1}{2\\sqrt{xyz}}\\cdot xy \\\\  & =\\frac{1}{2z}\\end{aligned}\n$$\n\n \n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\text{ }i+{f}_{x}(x,y,z)\\text{ }j+{f}_{x}(x,y,z)\\text{ }k \\\\  & =\\frac{1}{2x}\\text{ }i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k \\\\ ∇f(2,3,1) & =\\frac{1}{2\\cdot 2}\\text{ }i+\\frac{1}{2\\cdot 3}\\text{ }j+\\frac{1}{2\\cdot 1}\\text{ }k \\\\  & =\\frac{1}{4}\\text{ }i+\\frac{1}{6}\\text{ }j+\\frac{1}{2}\\text{ }k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36969/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe2c7ce2-f053-57af-9f4d-54bd3a41648a"] :knowledge-point/questions ["q-36969"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71425/selection/e3e180f305b0e5cc547bd2c84251715002d4cfa728c3e11b28e7baafc2ce4cc2" :answer/id #uuid "d4ada029-7762-5cae-960b-143b9714d9ed" :answer/type :answer.type/math :answer/value "(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71425/selection/9ee77ffa2ed22e3091f0dc84715ffd1d705c516c3c3dd9c7c31ac300b726a8ec" :answer/id #uuid "c6f4f116-5750-5a06-a555-132903ae092a" :answer/type :answer.type/math :answer/value "(x{y}^{2}{z}^{2}+yz{e}^{xyz-1})\\text{ }i+({x}^{2}y{z}^{2}+xz{e}^{xyz-1})\\text{ }j+({x}^{2}{y}^{2}z+xy{e}^{xyz-1})\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71425/selection/ee0365979ed2dc422c34b6301eddf086b921629c7b28f62dfbe1c74c431af1c2" :answer/id #uuid "d512f83e-f779-5173-bfbd-7a0bc07a64f7" :answer/type :answer.type/math :answer/value "(2x{y}^{2}{z}^{2}+x{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+y{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+z{e}^{xyz})\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71425/selection/9b4f13c3af3b67e7b144accb39f746b2230876f91f986b025ac254dd3ab92bd4" :answer/id #uuid "e50247b8-673b-560e-b76c-e9399a671eee" :answer/type :answer.type/math :answer/value "(2x{y}^{2}{z}^{2}+{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+{e}^{xyz})\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71425/selection/55289e44b78b2a015caf0cc45b530d9a64ec31de17880c3c4031db456a19605e" :answer/id #uuid "30d80a54-30e2-5bd0-8023-bf9d6698e46d" :answer/type :answer.type/math :answer/value "(2x+yz{e}^{xyz})\\text{ }i+(2y+xz{e}^{xyz})\\text{ }j+(2z+xy{e}^{xyz})\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-71425/selection" :answer-field/id #uuid "63fc4b39-b3ff-54be-8905-db2cb09ac40a" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71425/selection/e3e180f305b0e5cc547bd2c84251715002d4cfa728c3e11b28e7baafc2ce4cc2" :answer-field/choices ["q-71425/selection/e3e180f305b0e5cc547bd2c84251715002d4cfa728c3e11b28e7baafc2ce4cc2" "q-71425/selection/9ee77ffa2ed22e3091f0dc84715ffd1d705c516c3c3dd9c7c31ac300b726a8ec" "q-71425/selection/ee0365979ed2dc422c34b6301eddf086b921629c7b28f62dfbe1c74c431af1c2" "q-71425/selection/9b4f13c3af3b67e7b144accb39f746b2230876f91f986b025ac254dd3ab92bd4" "q-71425/selection/55289e44b78b2a015caf0cc45b530d9a64ec31de17880c3c4031db456a19605e"] :db/ensure [:answer-field/validate]} {:db/id "q-71425" :question/id #uuid "c3f07e77-96e3-5bfa-9689-789d29542b27" :question/math-academy-id "q-71425" :question/problem "Find $∇g(x,y,z)$ given that  $g(x,y,z)={x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2x{y}^{2}{z}^{2}+yz{e}^{xyz} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2{x}^{2}y{z}^{2}+xz{e}^{xyz} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}{y}^{2}{z}^{2}+{e}^{xyz}) \\\\  & =2{x}^{2}{y}^{2}z+xy{e}^{xyz}\\end{aligned}\n$$\n\nHence,  the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =(2x{y}^{2}{z}^{2}+yz{e}^{xyz})\\text{ }i+(2{x}^{2}y{z}^{2}+xz{e}^{xyz})\\text{ }j+(2{x}^{2}{y}^{2}z+xy{e}^{xyz})\\text{ }k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71425/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fe2c7ce2-f053-57af-9f4d-54bd3a41648a"] :knowledge-point/questions ["q-71425"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186124938 :question/answer-fields 17592186122650] {:db/id "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/c3fc6bc631063b51af12e6744fd269f9666d4af23d7c092ac4490aa3bb05316a" :answer/id #uuid "c4acf4ea-3f54-5b30-93bf-a530a1a83247" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/eaaf94d2c77bfdeecf3d8c459e4e4e3500b15c340c6e1d2c83ea3595b6ceeda0" :answer/id #uuid "d1f86e3d-689f-5ef6-a7fb-49a3147851ce" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2\\sqrt{y}}\\text{ }j+\\frac{1}{2\\sqrt{z}}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/03dce4f7795d492b7167f23c874437ed96cff9ab251591c3be8170f37764ca2c" :answer/id #uuid "88c1b753-5d93-5622-b595-82b74974bb25" :answer/type :answer.type/math :answer/value "\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2yz}\\text{ }j+\\frac{1}{2yz}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/8b85d4ad85c99180f370659d8ea877eec9166c333cc99ec1cfad76b6026d8063" :answer/id #uuid "f294e183-0e86-5b5c-b08d-9f16e038a1b7" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{y}\\text{ }j+\\frac{1}{z}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/09bb7d3195047b7af89f9b6ffad8984882478444b61c4b186a127ea6e648624b" :answer/id #uuid "9e559626-0a27-505f-9b7c-cec6ee09bf35" :answer/type :answer.type/math :answer/value "\\frac{1}{\\sqrt{x+2}}i+\\frac{1}{yz}\\text{ }j+\\frac{1}{yz}\\text{ }k" :db/ensure [:answer/validate]} {:db/id "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c" :answer-field/id #uuid "b7dfa95d-03b9-5399-9a38-0fd1b4249864" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/c3fc6bc631063b51af12e6744fd269f9666d4af23d7c092ac4490aa3bb05316a" :answer-field/choices ["q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/c3fc6bc631063b51af12e6744fd269f9666d4af23d7c092ac4490aa3bb05316a" "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/eaaf94d2c77bfdeecf3d8c459e4e4e3500b15c340c6e1d2c83ea3595b6ceeda0" "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/03dce4f7795d492b7167f23c874437ed96cff9ab251591c3be8170f37764ca2c" "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/8b85d4ad85c99180f370659d8ea877eec9166c333cc99ec1cfad76b6026d8063" "q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c/09bb7d3195047b7af89f9b6ffad8984882478444b61c4b186a127ea6e648624b"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-36968"] :question/problem "Find $∇g(x,y,z)$ given that  $g(x,y,z)=\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz}).$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =\\frac{1}{2\\sqrt{x+2}}+0 \\\\  & =\\frac{1}{2\\sqrt{x+2}} \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot z \\\\  & =\\frac{1}{2y} \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\sqrt{x+2}+\\operatorname{ln}⁡(\\sqrt{yz})) \\\\  & =0+\\frac{1}{\\sqrt{yz}}\\cdot \\frac{1}{2\\sqrt{yz}}\\cdot y \\\\  & =\\frac{1}{2z}\\end{aligned}\n$$\n\nHence,  the gradient is:\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{1}{2\\sqrt{x+2}}i+\\frac{1}{2y}\\text{ }j+\\frac{1}{2z}\\text{ }k\\end{aligned}\n$$" :question/answer-fields ["q-36968/selection/ma-v1/aad6ab8f1bf57f5c5f64f64048fb17390cf989d9ef0db18ba0b8151b7446512c"] :db/ensure [:question/validate]} {:db/id "q-128517/selection/54850b09dfd4360ad5355e41b63001d4f8f655df56839c2a2eec53f5168a9a9c" :answer/id #uuid "f64ba2d6-bb9a-5174-8995-2ebca4eda0aa" :answer/type :answer.type/text :answer/value "$(-1,0)$ and $(1,\\frac{\\pi }{2})$" :db/ensure [:answer/validate]} {:db/id "q-128517/selection/181056870844ad55b60841ac9ce31c385387f3652b46fa04a8591ff6ed2d56f7" :answer/id #uuid "ea33666f-7eb0-5757-b93c-a4ca11a35aae" :answer/type :answer.type/text :answer/value "$(1,0)$ only" :db/ensure [:answer/validate]} {:db/id "q-128517/selection/215a471b7b8dd109c60fc06733db93a0b4e93da71ea5932427245f8c42489d0b" :answer/id #uuid "4c19b6e4-bbb2-54cc-870f-18a106672097" :answer/type :answer.type/text :answer/value "$(0,\\frac{\\pi }{2})$ only" :db/ensure [:answer/validate]} {:db/id "q-128517/selection/b1791dbe60429bbd31fd99639c0455abdb6021b6673bb29043165e3d38ce3908" :answer/id #uuid "91d6ae38-a7d5-58eb-820c-5bc2594403ea" :answer/type :answer.type/text :answer/value "$(1,\\frac{\\pi }{2})$ only" :db/ensure [:answer/validate]} {:db/id "q-128517/selection/f970bcbd02ea03a853496830f43cf88463765692c53677bd4c9fb425ace0ea96" :answer/id #uuid "8e7810ac-87fa-5a1c-87c8-b22074698773" :answer/type :answer.type/text :answer/value "$(1,0)$ and $(0,\\frac{\\pi }{2})$" :db/ensure [:answer/validate]} {:db/id "q-128517/selection" :answer-field/id #uuid "c77876dc-7325-58b6-8a70-d5e9e6af427c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128517/selection/f970bcbd02ea03a853496830f43cf88463765692c53677bd4c9fb425ace0ea96" :answer-field/choices ["q-128517/selection/54850b09dfd4360ad5355e41b63001d4f8f655df56839c2a2eec53f5168a9a9c" "q-128517/selection/181056870844ad55b60841ac9ce31c385387f3652b46fa04a8591ff6ed2d56f7" "q-128517/selection/215a471b7b8dd109c60fc06733db93a0b4e93da71ea5932427245f8c42489d0b" "q-128517/selection/b1791dbe60429bbd31fd99639c0455abdb6021b6673bb29043165e3d38ce3908" "q-128517/selection/f970bcbd02ea03a853496830f43cf88463765692c53677bd4c9fb425ace0ea96"] :db/ensure [:answer-field/validate]} {:db/id "q-128517" :question/id #uuid "b3ab4912-f54b-5de4-a5e6-763ea328cbb0" :question/math-academy-id "q-128517" :question/problem "Given that $f(x,y)={x}^{2}-2x\\operatorname{cos}⁡y,$ find the points $(x,y),$ for $0\\le y<\\pi ,$ where $∇f(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}({x}^{2}-2x\\operatorname{cos}⁡y) \\\\  & =2x-2\\operatorname{cos}⁡y \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}({x}^{2}-2x\\operatorname{cos}⁡y) \\\\  & =2x\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nHence, $∇f(x,y)=2(x-\\operatorname{cos}⁡y)\\,i+2x\\operatorname{sin}⁡y\\,j.$\n\nNow, we solve $∇f(x,y)=0:$ \n\n$$\n2(x-\\operatorname{cos}⁡y)\\,i+2x\\operatorname{sin}⁡y\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}2(x-\\operatorname{cos}⁡y)=0 \\\\ 2x\\operatorname{sin}⁡y=0\\end{aligned}\n$$\n\nFrom the first equation, we get $x=\\operatorname{cos}⁡y.$ Substituting this into the second equation, we obtain \n\n$$\n\\begin{aligned}2\\operatorname{cos}⁡y\\operatorname{sin}⁡y & =0 \\\\ \\operatorname{sin}⁡2y & =0 \\\\ y & =0,\\,\\frac{\\pi }{2}\\end{aligned}\n$$\n\n- For $y=0,$ we get $x=\\operatorname{cos}⁡0=1.$\n\n- For $y=\\frac{\\pi }{2},$ we get $x=\\operatorname{cos}⁡(\\frac{\\pi }{2})=0.$\n\nTherefore, $∇h(x,y)=0,$ for $0\\le y<\\pi ,$ at two points: $(1,0)$ and $(0,\\frac{\\pi }{2}).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128517/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340"] :knowledge-point/questions ["q-128517"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128519/selection/e25f1b67f7deae0637d318d7b4bbb78a171e2ac1da12c7f58e560e4d9db6ee6a" :answer/id #uuid "e244813d-1802-5156-b946-a3e658a3fb3a" :answer/type :answer.type/text :answer/value "$(-3,3)$ only" :db/ensure [:answer/validate]} {:db/id "q-128519/selection/c5527de6ce74e4f6712a423bed22be076a78a659bd412d2fed0d46a12d044b94" :answer/id #uuid "4c7872d8-997c-51aa-a689-d82426760f10" :answer/type :answer.type/text :answer/value "$(3,-3)$ and $(-3,3)$" :db/ensure [:answer/validate]} {:db/id "q-128519/selection/ee10dc09bd178ececa8a1f8adf31e2392105cd6fbbd62cdc2900fbae89da64d1" :answer/id #uuid "8cf450eb-5364-5d7a-bf3e-3cd0ba197cc4" :answer/type :answer.type/text :answer/value "$(3,3)$ only" :db/ensure [:answer/validate]} {:db/id "q-128519/selection/2f442747d0bc106b57897625554ad6b5fc20dcef083baa2e7348b04dfc2a50cf" :answer/id #uuid "130637e6-ae8d-5642-8d4d-d27f8095fe93" :answer/type :answer.type/text :answer/value "$(-3,-3)$ only" :db/ensure [:answer/validate]} {:db/id "q-128519/selection/0fccfb35ef4b926229e15a3cf49eee186d8705a4ff50f2dabf2e10635b9b6a2e" :answer/id #uuid "87c9efef-7b68-5d9c-8468-dc3d8ec73f83" :answer/type :answer.type/text :answer/value "$(3,3)$ and $(-3,-3)$" :db/ensure [:answer/validate]} {:db/id "q-128519/selection" :answer-field/id #uuid "a0008cb5-9786-5e3d-be32-076d830d54ab" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128519/selection/2f442747d0bc106b57897625554ad6b5fc20dcef083baa2e7348b04dfc2a50cf" :answer-field/choices ["q-128519/selection/e25f1b67f7deae0637d318d7b4bbb78a171e2ac1da12c7f58e560e4d9db6ee6a" "q-128519/selection/c5527de6ce74e4f6712a423bed22be076a78a659bd412d2fed0d46a12d044b94" "q-128519/selection/ee10dc09bd178ececa8a1f8adf31e2392105cd6fbbd62cdc2900fbae89da64d1" "q-128519/selection/2f442747d0bc106b57897625554ad6b5fc20dcef083baa2e7348b04dfc2a50cf" "q-128519/selection/0fccfb35ef4b926229e15a3cf49eee186d8705a4ff50f2dabf2e10635b9b6a2e"] :db/ensure [:answer-field/validate]} {:db/id "q-128519" :question/id #uuid "a633d445-62c8-5864-b7bf-d694cd1cd56c" :question/math-academy-id "q-128519" :question/problem "Given that $g(x,y)=\\frac{9}{y}-\\frac{3y}{x}+x,$ find the points $(x,y)$ where $∇g(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}(\\frac{9}{y}-\\frac{3y}{x}+x) \\\\  & =\\frac{3y}{{x}^{2}}+1 \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}(\\frac{9}{y}-\\frac{3y}{x}+x) \\\\  & =-\\frac{9}{{y}^{2}}-\\frac{3}{x}\\end{aligned}\n$$\n\nHence, $∇g(x,y)=(\\frac{3y}{{x}^{2}}+1)i-(\\frac{9}{{y}^{2}}+\\frac{3}{y})j.$\n\nNow, we solve $∇g(x,y)=0:$\n\n$$\n(\\frac{3y}{{x}^{2}}+1)i-(\\frac{9}{{y}^{2}}+\\frac{3}{x})j=0\\,i+0\\,j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}\\frac{3y}{{x}^{2}}+1=0 \\\\ \\frac{9}{{y}^{2}}+\\frac{3}{x}=0\\end{aligned}\n$$\n\nFrom the first equation, we get $y=-\\frac{{x}^{2}}{3}.$ Substituting this into the second equation, we obtain\n\n$$\n\\begin{aligned}\\frac{9}{{(-\\frac{{x}^{2}}{3})}^{2}}+\\frac{3}{x} & =0 \\\\ 9\\cdot {(-\\frac{3}{{x}^{2}})}^{2}+\\frac{3}{x} & =0 \\\\ \\frac{81}{{x}^{4}}+\\frac{3}{x} & =0 \\\\ \\frac{81+3{x}^{3}}{{x}^{4}} & =0 \\\\ 81+3{x}^{3} & =0 \\\\ {x}^{3} & =-27 \\\\ x & =-3.\\end{aligned}\n$$\n\nFor $x=-3,$ we get $y=-\\frac{(-3)^{2}}{3}=-3.$\n\nTherefore, $∇g(x,y)=0$ at the point: $(-3,-3).$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128519/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340"] :knowledge-point/questions ["q-128519"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-35995"] :question/problem "Given that $f(x,y)=3{x}^{2}+{y}^{2}-x$, find the points $(x,y)$ where $∇f(x,y)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(3{x}^{2}+{y}^{2}-x) \\\\  & =6x+0-1 \\\\  & =6x-1 \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(3{x}^{2}+{y}^{2}-x) \\\\  & =0+2y-0 \\\\  & =2y\\end{aligned}\n$$\n\nHence, $∇f(x,y)=(6x-1)\\,i+2y\\,j.$\n\nNow, we solve $∇f(x,y)=0:$\n\n$$\n(6x-1)\\,i+2y\\,j=0\\text{ }i+0\\text{ }j\n$$\n\nSo, by equating the coefficients of $i$ and $j,$ we obtain:\n\n$$\n{\\begin{aligned}6x-1=0 \\\\ 2y=0\\end{aligned}\n$$\n\nFrom the first equation, we get $x=\\frac{1}{6}.$ From the second equation, we obtain $y=0.$ \n\nTherefore, $∇f(x,y)=0$ at the point $(\\frac{1}{6},0)\\,.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-71474/selection/0c40f6218776d441554ae9b00725428328dff7628e7187bf9b75852932b4877b" :answer/id #uuid "12592be6-7f46-5867-a2d2-a69a61893d5e" :answer/type :answer.type/text :answer/value "$(-1,-1,1)$ only" :db/ensure [:answer/validate]} {:db/id "q-71474/selection/643af2327c6f6860341abae4c784936119c292a040e077f9daefd41e88d40903" :answer/id #uuid "8db1d618-7d19-58f8-9d65-696e12d1a3f1" :answer/type :answer.type/text :answer/value "$(-1,-1,1)$ and $(-1,1,-1)$" :db/ensure [:answer/validate]} {:db/id "q-71474/selection/44b8c7f30399de0a75efc35e7268cfa011ecc9145a41f088208472c23d6b8a2e" :answer/id #uuid "6ab050ae-4758-54a4-98e5-e62bd3f6e0a7" :answer/type :answer.type/text :answer/value "$(-1,-1,-1)$ and $(-1,1,1)$" :db/ensure [:answer/validate]} {:db/id "q-71474/selection/b85b286537629b12a10cf339bcd2563523bd08c4d16e572928c05645e5c03780" :answer/id #uuid "81b787e3-156c-5422-a609-591ead68d542" :answer/type :answer.type/text :answer/value "$(1,-1,-1)$ and $(1,1,1)$" :db/ensure [:answer/validate]} {:db/id "q-71474/selection/8dc6397992eaaf5ac0c963fa5280a0a2962966888b9e0671266b0b840e0eda0b" :answer/id #uuid "d547e652-8772-56bc-8a8f-0825434af6b9" :answer/type :answer.type/text :answer/value "$(-1,1,-1)$ only" :db/ensure [:answer/validate]} {:db/id "q-71474/selection" :answer-field/id #uuid "0077ef26-76dd-59ee-8585-1f32ea88d648" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71474/selection/643af2327c6f6860341abae4c784936119c292a040e077f9daefd41e88d40903" :answer-field/choices ["q-71474/selection/0c40f6218776d441554ae9b00725428328dff7628e7187bf9b75852932b4877b" "q-71474/selection/643af2327c6f6860341abae4c784936119c292a040e077f9daefd41e88d40903" "q-71474/selection/44b8c7f30399de0a75efc35e7268cfa011ecc9145a41f088208472c23d6b8a2e" "q-71474/selection/b85b286537629b12a10cf339bcd2563523bd08c4d16e572928c05645e5c03780" "q-71474/selection/8dc6397992eaaf5ac0c963fa5280a0a2962966888b9e0671266b0b840e0eda0b"] :db/ensure [:answer-field/validate]} {:db/id "q-71474" :question/id #uuid "c503ae86-f71f-5a21-9c90-e19ce4d410a1" :question/math-academy-id "q-71474" :question/problem "Given that $f(x,y,z)=\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z$, find the points $(x,y,z)$ where $∇f(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{{x}^{2}y}+0-\\frac{1}{z{x}^{2}}-0 \\\\  & =-\\frac{z+y}{{x}^{2}yz} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =-\\frac{1}{x{y}^{2}}-\\frac{1}{{y}^{2}}+0-0 \\\\  & =-\\frac{1+x}{x{y}^{2}} \\\\ \\frac{∂f}{∂z} & =\\frac{∂}{∂z}(\\frac{1}{xy}+\\frac{1}{y}+\\frac{1}{zx}-z) \\\\  & =0+0-\\frac{1}{{z}^{2}x}-1 \\\\  & =-\\frac{1+{z}^{2}x}{{z}^{2}x}\\end{aligned}\n$$\n\nHence, $∇f(x,y,z)=-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k.$ \n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}\\,i-\\frac{1+x}{x{y}^{2}}\\,j-\\frac{1+{z}^{2}x}{{z}^{2}x}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficient of $i$, $j$, and $k$, we obtain:\n\n$$\n{\\begin{aligned}-\\frac{z+y}{{x}^{2}yz}=0 \\\\ -\\frac{1+x}{x{y}^{2}}=0 \\\\ -\\frac{1+{z}^{2}x}{{z}^{2}x}=0\\end{aligned}\n$$\n\nFrom the second equation, we get $x=-1.$ Substituting these into the third equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{1+{z}^{2}x}{{z}^{2}x} & =0 \\\\ -\\frac{1+{z}^{2}(-1)}{{z}^{2}(-1)} & =0 \\\\ 1-{z}^{2} & =0 \\\\ {z}^{2} & =1 \\\\ z & =\\pm 1\\end{aligned}\n$$\n\nSubstituting $x=-1$ into the first equation, we obtain:\n\n$$\n\\begin{aligned}-\\frac{z+y}{(-1)^{2}yz} & =0 \\\\ z+y & =0 \\\\ y & =-z\\end{aligned}\n$$\n\nWhen $z=1,$ we have $y=-1$ and when $z=-1,$ we have $y=1.$\n\nHence, $∇f(x,y,z)=0$ at two points: $(-1,-1,1)$ and $(-1,1,-1).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71474/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e8d807a6-7896-5045-a14a-908b58831340"] :knowledge-point/questions ["q-71474"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186124939 :question/answer-fields 17592186122656] {:db/id "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/96ca8f7e8f4265087dee73603146546246d6ea3861c00ced8db0d3f88c9de071" :answer/id #uuid "6a3fafdb-413f-5bbd-8e1b-c53a0c4c8be9" :answer/type :answer.type/text :answer/value "$(0,-1,0)$ only" :db/ensure [:answer/validate]} {:db/id "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/c66045d43af0aaf8b87331e5d79524deeabe2188642e05cf45181857da018a5f" :answer/id #uuid "71d02e70-f471-50eb-bda7-b04421b8b548" :answer/type :answer.type/text :answer/value "$(0,0,0)$ and $(0,-1,0)$" :db/ensure [:answer/validate]} {:db/id "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/a9dd521e26cd31332528c32b1ac498add4f732ec6908c808efa72fc74ad1ee6a" :answer/id #uuid "7c2e5360-f4d9-5168-9617-3368ab8b0113" :answer/type :answer.type/text :answer/value "$(0,0,0)$ and  $(-1,-1,-1)$" :db/ensure [:answer/validate]} {:db/id "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/4e31c8636f3d9ca5cc06c500c9e0c1d7447cd40f91bf834284c2e465d1fe7a20" :answer/id #uuid "f15daa0f-7ee7-5bff-8566-b7fbc8aee3a2" :answer/type :answer.type/text :answer/value "$(1,-1,1)$ only" :db/ensure [:answer/validate]} {:db/id "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/a43a88d369550433276a114bbe7524a7124a2a4c741b9afb2ae110442ae78d8b" :answer/id #uuid "77a09554-e46b-5085-baa3-4230769af1bd" :answer/type :answer.type/text :answer/value "$(0,0,0)$ only" :db/ensure [:answer/validate]} {:db/id "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d" :answer-field/id #uuid "63bc7267-add2-5a8f-8045-91812d551433" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/c66045d43af0aaf8b87331e5d79524deeabe2188642e05cf45181857da018a5f" :answer-field/choices ["q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/96ca8f7e8f4265087dee73603146546246d6ea3861c00ced8db0d3f88c9de071" "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/c66045d43af0aaf8b87331e5d79524deeabe2188642e05cf45181857da018a5f" "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/a9dd521e26cd31332528c32b1ac498add4f732ec6908c808efa72fc74ad1ee6a" "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/4e31c8636f3d9ca5cc06c500c9e0c1d7447cd40f91bf834284c2e465d1fe7a20" "q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d/a43a88d369550433276a114bbe7524a7124a2a4c741b9afb2ae110442ae78d8b"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-36970"] :question/problem "Given $h(x,y,z)=xy+x{y}^{2}+{z}^{3}.$ Find the points $(x,y,z)$ where $∇h(x,y,z)=0.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{h}_{x}(x,y,z) & =\\frac{∂}{∂x}(xy+x{y}^{2}+{z}^{3}) \\\\  & =y+{y}^{2}+0 \\\\  & =y+{y}^{2} \\\\ {h}_{y}(x,y,z) & =\\frac{∂}{∂y}(xy+x{y}^{2}+{z}^{3}) \\\\  & =x+2xy+0 \\\\  & =x+2xy \\\\ {h}_{z}(x,y,z) & =\\frac{∂}{∂z}(xy+x{y}^{2}+{z}^{3}) \\\\  & =0+0+3{z}^{2} \\\\  & =3{z}^{2}\\end{aligned}\n$$\n\nHence, $∇h(x,y,z)=(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k.$\n\nNow, we solve $∇f(x,y,z)=0:$\n\n$$\n\\begin{aligned}(y+{y}^{2})\\,i+(x+2xy)\\,j+3{z}^{2}\\,k & =0\\text{ }i+0\\text{ }j+0\\text{ }j\\end{aligned}\n$$\n\nSo, by equating the coefficients of $i$, $j$, and $k$, we obtain:\n\n$$\n{\\begin{aligned}y+{y}^{2}=0 \\\\ x+2xy=0 \\\\ 3{z}^{2}=0\\end{aligned}\n$$\n\nThe first equation can be written as $y(1+y)=0$, which gives $y=0$ or $y=-1.$ Substituting these into the second equation, we obtain:\n\n$$\n\\begin{aligned}x+2x(0) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nor,\n\n$$\n\\begin{aligned}x+2x(-1) & =0 \\\\ x & =0\\end{aligned}\n$$\n\nFinally, from the third equation, we get $z=0.$\n\nTherefore, $∇h(x,y,z)=0$ at two points: $(0,0,0)$ and $(0,-1,0).$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-36970/selection/ma-v1/d5cf644fb624a34df8efcd2385d83bbfe1fec94ed9fdbba373abd5bbeaaa812d"] :db/ensure [:question/validate]} {:db/id "q-71476/selection/c717f6623aba39c620d60b4fa379f711a74dc3ccc008c68ce70797127b528cc6" :answer/id #uuid "b487e61e-b8bb-5c12-8157-0d84ead37113" :answer/type :answer.type/math :answer/value "x\\text{ }i+y\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-71476/selection/e8c40ceeed68b9c7c273f465c956cedc4f76587dc25aa6399a8f5075e58aac63" :answer/id #uuid "0654547a-83a9-57a1-9ef6-25b3042b422d" :answer/type :answer.type/math :answer/value "\\text{ }i-\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-71476/selection/0d662281172733a8e85bf2e871c0bc8f063e1568755c0e31593b8bade10fcd22" :answer/id #uuid "8d0f5df5-2f99-5690-9a46-2374409c79f6" :answer/type :answer.type/math :answer/value "-\\text{ }i+\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-71476/selection/e6ef9d4a9671af13454bbc51bb38a9e6ff78d4701ed739f100535d2d4b8462f5" :answer/id #uuid "21c6343b-66c7-5ef7-aacd-518ca263f002" :answer/type :answer.type/math :answer/value "y\\text{ }i+x\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-71476/selection/25ef4fca058cd488480e9c2dadde3c12633f96158564d2db62132a1cfe151c9a" :answer/id #uuid "deb84c0b-281e-53a0-a7a0-bb21b6bf1f3f" :answer/type :answer.type/math :answer/value "\\text{ }i+\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-71476/selection" :answer-field/id #uuid "97dee7e9-d318-5575-be9a-b1275f503278" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71476/selection/25ef4fca058cd488480e9c2dadde3c12633f96158564d2db62132a1cfe151c9a" :answer-field/choices ["q-71476/selection/c717f6623aba39c620d60b4fa379f711a74dc3ccc008c68ce70797127b528cc6" "q-71476/selection/e8c40ceeed68b9c7c273f465c956cedc4f76587dc25aa6399a8f5075e58aac63" "q-71476/selection/0d662281172733a8e85bf2e871c0bc8f063e1568755c0e31593b8bade10fcd22" "q-71476/selection/e6ef9d4a9671af13454bbc51bb38a9e6ff78d4701ed739f100535d2d4b8462f5" "q-71476/selection/25ef4fca058cd488480e9c2dadde3c12633f96158564d2db62132a1cfe151c9a"] :db/ensure [:answer-field/validate]} {:db/id "q-71476" :question/id #uuid "da58e4f4-442d-5b36-8664-807bdb33a068" :question/math-academy-id "q-71476" :question/problem "Find the gradient of the product $f(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & ={x}^{2}y+x{y}^{2},\\, &  & ∇f(x,y)=(2xy+{y}^{2})\\text{ }i+({x}^{2}+2xy)\\text{ }j, &  &  \\\\ h(x,y) & =\\frac{1}{xy},\\, &  & ∇h(x,y)=-\\frac{1}{{x}^{2}y}\\text{ }i-\\frac{1}{x{y}^{2}}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[fh]=h\\,∇\\,f+f\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[f(x,y)h(x,y)] & =h(x,y)∇f(x,y)+f(x,y)∇h(x,y) \\\\  & =\\frac{1}{xy}((2xy+{y}^{2})\\text{ }i+({x}^{2}+2xy)\\text{ }j)+({x}^{2}y+x{y}^{2})(-\\frac{1}{{x}^{2}y}\\text{ }i-\\frac{1}{x{y}^{2}}\\text{ }j) \\\\  & =(\\frac{2xy+{y}^{2}}{xy}\\text{ }i+\\frac{{x}^{2}+2xy}{xy}\\text{ }j)+(-\\frac{{x}^{2}y+x{y}^{2}}{{x}^{2}y}\\text{ }i-\\frac{{x}^{2}y+x{y}^{2}}{x{y}^{2}}\\text{ }j) \\\\  & =(\\frac{2x+y}{x}\\text{ }i+\\frac{x+2y}{y}\\text{ }j)+(-\\frac{x+y}{x}\\text{ }i-\\frac{x+y}{y}\\text{ }j) \\\\  & =(-\\frac{x+y}{x}+\\frac{2x+y}{x})\\text{ }i+(-\\frac{x+y}{y}+\\frac{x+2y}{y})\\text{ }j \\\\  & =\\text{ }i+\\text{ }j\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71476/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81"] :knowledge-point/questions ["q-71476"] :db/ensure [:knowledge-point/validate]} {:db/id "q-65131/selection/af5de344c2489d1c1423979081ecc22b6e1fa913631ed0d5eaba0608d4d54a89" :answer/id #uuid "b24e6539-ab07-5dc2-aba3-19202ef8839c" :answer/type :answer.type/math :answer/value "y\\operatorname{ln}⁡(xy)\\text{ }i+x\\operatorname{ln}⁡(xy)\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-65131/selection/39b41b4aee3c813547c41519609d8378ee41f0c8f7ef4388c3c6a1e665147b11" :answer/id #uuid "0b797bb8-edd0-506e-863a-5018ef70f599" :answer/type :answer.type/math :answer/value "y(\\operatorname{ln}⁡(xy)+2)\\text{ }i+x(\\operatorname{ln}⁡(xy)+2)\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-65131/selection/79cc4c079f9eb69258038728fc4f47ba1ffb762a582b1bb3eee6cfef7f1a282c" :answer/id #uuid "e76bec4f-9988-54ba-b2f8-96a89f222fb6" :answer/type :answer.type/math :answer/value "y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-65131/selection/2e61fd41e4d59d24ccc6a2b95563f4a390703b6a4a3f34da2e0aaf8bda576e23" :answer/id #uuid "5babed5e-6b7a-5f98-901f-f3092e7b8cf2" :answer/type :answer.type/math :answer/value "x\\operatorname{ln}⁡(xy)\\text{ }i-y\\operatorname{ln}⁡(xy)\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-65131/selection/2a6d59a7b8f78e726db37907f7376587ec67af7e73d54d9e19000baa3785193e" :answer/id #uuid "49612262-a49c-53dc-9ae3-81f481100d53" :answer/type :answer.type/math :answer/value "x\\operatorname{ln}⁡(xy)\\text{ }i+y\\operatorname{ln}⁡(xy)\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-65131/selection" :answer-field/id #uuid "0593a353-e82c-53ea-97f5-5104a066f347" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-65131/selection/79cc4c079f9eb69258038728fc4f47ba1ffb762a582b1bb3eee6cfef7f1a282c" :answer-field/choices ["q-65131/selection/af5de344c2489d1c1423979081ecc22b6e1fa913631ed0d5eaba0608d4d54a89" "q-65131/selection/39b41b4aee3c813547c41519609d8378ee41f0c8f7ef4388c3c6a1e665147b11" "q-65131/selection/79cc4c079f9eb69258038728fc4f47ba1ffb762a582b1bb3eee6cfef7f1a282c" "q-65131/selection/2e61fd41e4d59d24ccc6a2b95563f4a390703b6a4a3f34da2e0aaf8bda576e23" "q-65131/selection/2a6d59a7b8f78e726db37907f7376587ec67af7e73d54d9e19000baa3785193e"] :db/ensure [:answer-field/validate]} {:db/id "q-65131" :question/id #uuid "7e113ad4-1218-5093-a986-f3389728ec7e" :question/math-academy-id "q-65131" :question/problem "Find the gradient of the product $f(x,y)g(x,y),$ given that \n\n$$\n\\begin{aligned}f(x,y) & =xy,\\, &  & ∇f(x,y)=y\\text{ }i+x\\text{ }j, &  &  \\\\ g(x,y) & =\\operatorname{ln}⁡(xy),\\, &  & ∇g(x,y)=\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by:\n\n$$\n∇[fg]=g\\,∇\\,f+f\\,∇\\,g\n$$\n\nSo, using this product rule we obtain: \n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =(\\operatorname{ln}⁡(xy))(y\\text{ }i+x\\text{ }j)+xy(\\frac{1}{x}\\text{ }i+\\frac{1}{y}\\text{ }j) \\\\  & =y\\operatorname{ln}⁡(xy)\\text{ }i+x\\operatorname{ln}⁡(xy)\\text{ }j+y\\text{ }i+x\\text{ }j \\\\  & =[y\\operatorname{ln}⁡(xy)\\text{ }i+y\\text{ }i]+[x\\operatorname{ln}⁡(xy)\\text{ }j+x\\text{ }j] \\\\  & =y(\\operatorname{ln}⁡(xy)+1)\\text{ }i+x(\\operatorname{ln}⁡(xy)+1)\\text{ }j\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-65131/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81"] :knowledge-point/questions ["q-65131"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128521/selection/b4c8df4bce1ff4ce80384c853eaa4c1ae8061f38d41385990fd42f9424e0c8a7" :answer/id #uuid "3d72fcb5-7be4-5c2c-aac6-6de935f0babb" :answer/type :answer.type/math :answer/value "{e}^{-({x}^{2}+{y}^{2})}(y(1-2{x}^{2})\\text{ }i+x(1+2{y}^{2})\\text{ }j)" :db/ensure [:answer/validate]} {:db/id "q-128521/selection/f632c0591c0ef38d32d4fa35f363116706de2be343920250b795a5ba9f850ebd" :answer/id #uuid "8f8c3adb-4fe2-503b-907e-15c026b52154" :answer/type :answer.type/math :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/ensure [:answer/validate]} {:db/id "q-128521/selection/f4a3776c62be819c7473a35a7eb1810f504943418bc56511b256d57347782abe" :answer/id #uuid "277c2a61-d00e-5ff5-9275-715217b99986" :answer/type :answer.type/math :answer/value "{e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j)" :db/ensure [:answer/validate]} {:db/id "q-128521/selection/74dd3a1ac312b9bee24887c174c470002efec228afcb4880f84d5276fbd4703b" :answer/id #uuid "0fb402be-29c7-5e60-8660-43b00271b91a" :answer/type :answer.type/math :answer/value "{e}^{-({x}^{2}+{y}^{2})}(x(1-{y}^{2})\\text{ }i+xy(1-{x}^{2})\\text{ }j)" :db/ensure [:answer/validate]} {:db/id "q-128521/selection/9b861bdb2a5919570c885b323f1ee2deeaf2e6f46285c6436aada06fcc1800a1" :answer/id #uuid "903e52db-bd77-5a8f-ae34-98f58f214a33" :answer/type :answer.type/math :answer/value "{e}^{-({x}^{2}+{y}^{2})}({x}^{2}(1+{y}^{2})\\text{ }i+2{y}^{2}(1+{x}^{2})\\text{ }j)" :db/ensure [:answer/validate]} {:db/id "q-128521/selection" :answer-field/id #uuid "b57d9015-1621-55da-b807-45484c16c305" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128521/selection/f632c0591c0ef38d32d4fa35f363116706de2be343920250b795a5ba9f850ebd" :answer-field/choices ["q-128521/selection/b4c8df4bce1ff4ce80384c853eaa4c1ae8061f38d41385990fd42f9424e0c8a7" "q-128521/selection/f632c0591c0ef38d32d4fa35f363116706de2be343920250b795a5ba9f850ebd" "q-128521/selection/f4a3776c62be819c7473a35a7eb1810f504943418bc56511b256d57347782abe" "q-128521/selection/74dd3a1ac312b9bee24887c174c470002efec228afcb4880f84d5276fbd4703b" "q-128521/selection/9b861bdb2a5919570c885b323f1ee2deeaf2e6f46285c6436aada06fcc1800a1"] :db/ensure [:answer-field/validate]} {:db/id "q-128521" :question/id #uuid "213dbaa5-b611-5d26-80d0-68b5b3647c86" :question/math-academy-id "q-128521" :question/problem "What is the gradient of the product $f(x,y)g(x,y)$ if $f(x,y)=x{y}^{2}$ and $g(x,y)={e}^{-({x}^{2}+{y}^{2})}?$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n∇[fg]=f∇g+g∇f.\n$$\n\nNow, we calculate the partial derivatives of $f(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}(x{y}^{2})={y}^{2} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}(x{y}^{2})=2xy\\end{aligned}\n$$\n\nHence, \n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂f}{∂x}\\text{ }i+\\frac{∂f}{∂y}\\text{ }j={y}^{2}\\text{ }i+2xy\\text{ }j.\\end{aligned}\n$$\n\nNext, we calculate the partial derivatives of $g(x,y):$\n\n$$\n\\begin{aligned}\\frac{∂g}{∂x} & =\\frac{∂}{∂x}({e}^{-({x}^{2}+{y}^{2})})=-2x{e}^{-({x}^{2}+{y}^{2})} \\\\ \\frac{∂g}{∂y} & =\\frac{∂}{∂y}({e}^{-({x}^{2}+{y}^{2})})=-2y{e}^{-({x}^{2}+{y}^{2})}\\end{aligned}\n$$\n\nTherefore, \n\n$$\n\\begin{aligned}∇g(x,y) & =\\frac{∂g}{∂x}\\text{ }i+\\frac{∂g}{∂y}\\text{ }j=-2x{e}^{-({x}^{2}+{y}^{2})}\\text{ }i-2y{e}^{-({x}^{2}+{y}^{2})}\\text{ }j.\\end{aligned}\n$$\n\nFinally, using the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =x{y}^{2}(-2x{e}^{-({x}^{2}+{y}^{2})}\\text{ }i-2y{e}^{-({x}^{2}+{y}^{2})}\\text{ }j)+{e}^{-({x}^{2}+{y}^{2})}({y}^{2}\\text{ }i+2xy\\text{ }j) \\\\  & ={e}^{-({x}^{2}+{y}^{2})}(-2{x}^{2}{y}^{2}\\text{ }i-2x{y}^{3}\\text{ }j)+{e}^{-({x}^{2}+{y}^{2})}({y}^{2}\\text{ }i+2xy\\text{ }j) \\\\  & ={e}^{-({x}^{2}+{y}^{2})}({y}^{2}(1-2{x}^{2})\\text{ }i+2xy(1-{y}^{2})\\text{ }j).\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-128521/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81"] :knowledge-point/questions ["q-128521"] :db/ensure [:knowledge-point/validate]} [:db/retract 17592186124870 :question/answer-fields 17592186122242] {:db/id "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/3eecde4d7af44f20bd7ab99bb3afa750b95b624526ee2756d51d12099f34a10d" :answer/id #uuid "68fbaa21-de06-5eba-9ed9-f80797ea21a6" :answer/type :answer.type/math :answer/value "-16x{y}^{3}\\text{ }i+12{x}^{4}y\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/1f3fa2b009dd9becf7283d0b3bb851581e853e1d4e024257e07fd7049f5e9d6c" :answer/id #uuid "39db5d60-d92c-55d6-ad5d-42b522c4f0c9" :answer/type :answer.type/math :answer/value "(2{x}^{3}{y}^{2}-x{y}^{3})\\text{ }i+({x}^{4}y-2{x}^{2}{y}^{2})\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/bfde2ed2bbda58e755f5875a2ec1da5e4880754a4c27d12a077d95ca761e2b17" :answer/id #uuid "e5afa44f-3cf2-5cca-bb12-f44fc4067b55" :answer/type :answer.type/math :answer/value "24{x}^{3}{y}^{2}-16x{y}^{3}+12{x}^{4}y-24{x}^{2}{y}^{2}" :db/ensure [:answer/validate]} {:db/id "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/931d6b0f887f7d78c03cc791b23799646c36f837c18c72989aac8d7f9a9423f6" :answer/id #uuid "c4147ce9-d5f1-5845-a6d8-e5912eca0598" :answer/type :answer.type/math :answer/value "(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/0726a28c9c696d2672ff49608a708ef6a19b35dd41de3bc0f6681726a035f238" :answer/id #uuid "e4883017-f52e-5143-88f1-06f5fc6774cb" :answer/type :answer.type/math :answer/value "(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }i+(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }j" :db/ensure [:answer/validate]} {:db/id "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e" :answer-field/id #uuid "201f8647-3957-5bfa-8c43-e5fa35f20116" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/931d6b0f887f7d78c03cc791b23799646c36f837c18c72989aac8d7f9a9423f6" :answer-field/choices ["q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/3eecde4d7af44f20bd7ab99bb3afa750b95b624526ee2756d51d12099f34a10d" "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/1f3fa2b009dd9becf7283d0b3bb851581e853e1d4e024257e07fd7049f5e9d6c" "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/bfde2ed2bbda58e755f5875a2ec1da5e4880754a4c27d12a077d95ca761e2b17" "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/931d6b0f887f7d78c03cc791b23799646c36f837c18c72989aac8d7f9a9423f6" "q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e/0726a28c9c696d2672ff49608a708ef6a19b35dd41de3bc0f6681726a035f238"] :db/ensure [:answer-field/validate]} {:db/id [:question/math-academy-id "q-36144"] :question/problem "Find the gradient of the product $g(x,y)h(x,y),$ given that \n\n$$\n\\begin{aligned}g(x,y) & =3{x}^{2}-4y,\\, &  & ∇g(x,y)=6x\\text{ }i-4\\text{ }j, &  &  \\\\ h(x,y) & =2{x}^{2}{y}^{2},\\, &  & ∇h(x,y)=4x{y}^{2}\\text{ }i+4{x}^{2}y\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $g(x,y)$ and $h(x,y)$ is given by:\n\n$$\n∇[gh]=h\\,∇\\,g+g\\,∇\\,h\n$$\n\nUsing the product rule, we obtain:\n\n$$\n\\begin{aligned}∇[g(x,y)h(x,y)] & =h(x,y)∇g(x,y)+g(x,y)∇h(x,y) \\\\  & =2{x}^{2}{y}^{2}(6x\\text{ }i-4\\text{ }j)+(3{x}^{2}-4y)(4x{y}^{2}\\text{ }i+4{x}^{2}y\\text{ }j) \\\\  & =(2{x}^{2}{y}^{2}\\cdot 6x\\text{ }i-2{x}^{2}{y}^{2}\\cdot 4\\text{ }j)+((3{x}^{2}-4y)\\cdot 4x{y}^{2}\\text{ }i+(3{x}^{2}-4y)\\cdot 4{x}^{2}y\\text{ }j) \\\\  & =12{x}^{3}{y}^{2}\\text{ }i-8{x}^{2}{y}^{2}\\text{ }j+(12{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-16{x}^{2}{y}^{2})\\text{ }j \\\\  & =(24{x}^{3}{y}^{2}-16x{y}^{3})\\text{ }i+(12{x}^{4}y-24{x}^{2}{y}^{2})\\text{ }j\\end{aligned}\n$$" :question/answer-fields ["q-36144/selection/ma-v1/1901a983045ae7104361b979d9df3da57e8245f1e5f5f088297de7f68423d35e"] :db/ensure [:question/validate]} {:db/id "q-128529/selection/d4632b17c26f9059d66538f90b8c71fa1957539018973d40f1714e2a0ff11b5f" :answer/id #uuid "adc13558-be23-5d6e-b774-52c89b2b56cc" :answer/type :answer.type/math :answer/value "x\\,i-2xz\\,k" :db/ensure [:answer/validate]} {:db/id "q-128529/selection/ace7f75602831d930b16a694dbc2ec882ed93e392c4c90d258dd184e474c3c6d" :answer/id #uuid "0f6114bc-7474-51a6-8ee2-ca082c6c9ca0" :answer/type :answer.type/math :answer/value "3x\\,i+{y}^{2}\\,j-2xy\\,k" :db/ensure [:answer/validate]} {:db/id "q-128529/selection/2f91ae861341fdcaba0147fd8dddd393aa8ac8d6cf376d173ff2dba40aaa3b34" :answer/id #uuid "f93687f8-bf98-5b5d-91f7-2be6674a2c7d" :answer/type :answer.type/math :answer/value "{z}^{2}\\,j+2yz\\,k" :db/ensure [:answer/validate]} {:db/id "q-128529/selection/68249355f5baf2126881412d54acc810ffe4f6ed42c7ae0d7c9f3d35cde5beb4" :answer/id #uuid "c55bf03e-9463-5db3-8051-83717315dc8c" :answer/type :answer.type/math :answer/value "x\\,i-{z}^{2}\\,j-2yz\\,k" :db/ensure [:answer/validate]} {:db/id "q-128529/selection/b975e1d9a4951fc1f6acb19ba9c292db014e65e0d772ccadad17c5aea3d618e0" :answer/id #uuid "bb5832ec-4186-5e11-af39-2dba80d6854d" :answer/type :answer.type/math :answer/value "{y}^{2}\\,i+3xy\\,k" :db/ensure [:answer/validate]} {:db/id "q-128529/selection" :answer-field/id #uuid "6141f78b-7288-58df-9f96-1af3e6ea9459" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128529/selection/2f91ae861341fdcaba0147fd8dddd393aa8ac8d6cf376d173ff2dba40aaa3b34" :answer-field/choices ["q-128529/selection/d4632b17c26f9059d66538f90b8c71fa1957539018973d40f1714e2a0ff11b5f" "q-128529/selection/ace7f75602831d930b16a694dbc2ec882ed93e392c4c90d258dd184e474c3c6d" "q-128529/selection/2f91ae861341fdcaba0147fd8dddd393aa8ac8d6cf376d173ff2dba40aaa3b34" "q-128529/selection/68249355f5baf2126881412d54acc810ffe4f6ed42c7ae0d7c9f3d35cde5beb4" "q-128529/selection/b975e1d9a4951fc1f6acb19ba9c292db014e65e0d772ccadad17c5aea3d618e0"] :db/ensure [:answer-field/validate]} {:db/id "q-128529" :question/id #uuid "ad35730f-58dd-5654-94ad-54ae938df086" :question/math-academy-id "q-128529" :question/problem "Find the gradient of the product $f(x,y,z)h(x,y,z),$ given that \n\n$$\n\\begin{aligned}f(x,y,z) & =x{y}^{2}{z}^{3},\\, &  & ∇f(x,y,z)={y}^{2}{z}^{3}\\,i+2xy{z}^{3}\\,j+3x{y}^{2}{z}^{2}\\,k, &  &  \\\\ h(x,y,z) & =\\frac{1}{xyz},\\, &  & ∇h(x,y,z)=-\\frac{1}{{x}^{2}yz}\\,i-\\frac{1}{x{y}^{2}z}\\,j-\\frac{1}{xy{z}^{2}}\\text{ }k. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $h(x,y)$ is given by\n\n$$\n∇[fh]=h∇f+f∇h.\n$$\n\nUsing the product rule, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y,z)h(x,y,z)] & =h(x,y,z)∇f(x,y,z)+f(x,y,z)∇h(x,y,z) \\\\  & =\\frac{1}{xyz}({y}^{2}{z}^{3}\\,i+2xy{z}^{3}\\,j+3x{y}^{2}{z}^{2}\\,k)+x{y}^{2}{z}^{3}(-\\frac{1}{{x}^{2}yz}\\,i-\\frac{1}{x{y}^{2}z}\\,j-\\frac{1}{xy{z}^{2}}\\,k) \\\\  & =\\frac{{y}^{2}{z}^{3}}{xyz}\\,i+\\frac{2xy{z}^{3}}{xyz}\\,j+\\frac{3x{y}^{2}{z}^{2}}{xyz}\\,k-\\frac{x{y}^{2}{z}^{3}}{{x}^{2}yz}\\,i-\\frac{x{y}^{2}{z}^{3}}{x{y}^{2}z}\\,j-\\frac{x{y}^{2}{z}^{3}}{xy{z}^{2}}\\,k \\\\  & =\\frac{y{z}^{2}}{x}\\,i+2{z}^{2}\\,j+3yz\\,k-\\frac{y{z}^{2}}{x}\\,i-{z}^{2}\\,j-yz\\,k \\\\  & ={z}^{2}\\,j+2yz\\,k.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-128529/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "67cfec73-130c-5b68-a2e0-5f12837bfc81"] :knowledge-point/questions ["q-128529"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-3131"] :question/problem "Find $\\nabla f(x,y)$ at the point $(1,\\pi)$ given that $f(x,y) = (x - y)\\cos y.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}{f}_{x}(x,y) & =\\frac{∂}{∂x}((x-y)\\operatorname{cos}⁡y) \\\\  & =\\operatorname{cos}⁡y \\\\ {f}_{y}(x,y) & =\\frac{∂}{∂y}((x-y)\\operatorname{cos}⁡y) \\\\  & =-\\operatorname{cos}⁡y-(x-y)\\operatorname{sin}⁡y\\end{aligned}\n$$\n\nSo, the gradient is\n\n$$\n\\begin{aligned}∇\\,f(x,y) & ={f}_{x}(x,y)\\text{ }i+{f}_{y}(x,y)\\text{ }j \\\\  & =\\operatorname{cos}⁡y\\text{ }i-(\\operatorname{cos}⁡y+(x-y)\\operatorname{sin}⁡y)\\text{ }j.\\end{aligned}\n$$\n\nFinally, to find the gradient at the specified point, we substitute $(x,y)= (1,\\pi)$ into the above, which gives\n\n$$\n\\begin{aligned}∇\\,f(1,\\pi ) & ={f}_{x}(1,\\pi )\\text{ }i+{f}_{y}(1,\\pi )\\text{ }j \\\\  & =\\operatorname{cos}⁡\\pi \\text{ }i-(\\operatorname{cos}⁡\\pi +(1-\\pi )\\operatorname{sin}⁡\\pi )\\text{ }j \\\\  & =-i+j.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3132"] :question/problem "Evaluate $\\nabla g(x,y,z)$   at $(2,-1,3)$ if $g(x,y,z) = x^2 + xyz.$" :question/worked-solution "First, we find the partial derivatives:\n\n$$\n\\begin{aligned}{g}_{x}(x,y,z) & =\\frac{∂}{∂x}({x}^{2}+xyz) \\\\  & =2x+yz \\\\ {g}_{y}(x,y,z) & =\\frac{∂}{∂y}({x}^{2}+xyz) \\\\  & =0+xz \\\\  & =xz \\\\ {g}_{z}(x,y,z) & =\\frac{∂}{∂z}({x}^{2}+xyz) \\\\  & =0+xy \\\\  & =xy\\end{aligned}\n$$\n\nTherefore, the gradient is\n\n$$\n\\begin{aligned}∇g(x,y,z) & ={g}_{x}(x,y,z)\\text{ }i+{g}_{y}(x,y,z)\\text{ }j+{g}_{z}(x,y,z)\\text{ }k \\\\  & =(2x+yz)\\text{ }i+(xz)\\text{ }j+(xy)\\text{ }k \\\\ ∇g(2,-1,3) & =(2(2)+(-1)(3))\\text{ }i+2(3)\\text{ }j+2(-1)\\text{ }k \\\\  & =1\\text{ }i+6\\text{ }j-2\\text{ }k \\\\  & =i+6\\text{ }j-2\\text{ }k.\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3133"] :question/problem "Given that $f(x,y)= (y-4)\\ln (x-2),$ find the points $(x, y)$ where $\\nabla f(x,y) = \\mathbf 0.$" :question/worked-solution "First, we find the partial derivatives: \n\n$$\n\\begin{aligned}\\frac{∂f}{∂x} & =\\frac{∂}{∂x}((y-4)\\operatorname{ln}⁡(x-2)) \\\\  & =\\frac{y-4}{x-2} \\\\ \\frac{∂f}{∂y} & =\\frac{∂}{∂y}((y-4)\\operatorname{ln}⁡(x-2)) \\\\  & =\\operatorname{ln}⁡(x-2)\\end{aligned}\n$$\n\nSo, we have\n\n$$\n\\nabla f(x,y) = \\dfrac {y-4}{x-2} \\, \\mathbf i + \\ln(x-2) \\, \\mathbf j.\n$$\n\nNow, we solve $\\nabla f(x,y) = \\mathbf 0\\mathbin{:}$\n\n$$\n\\dfrac {y-4}{x-2} \\, \\mathbf i + \\ln(x-2) \\, \\mathbf j = 0 \\  \\mathbf i + 0\\ \\mathbf j\n$$\n\nBy equating the coefficients of $\\mathbf{i}$ on both sides of the equation (and similarly with $\\mathbf{j}$), we obtain\n\n$$\n{\\begin{aligned}\\frac{y-4}{x-2}=0 \\\\ \\operatorname{ln}⁡(x-2)=0.\\end{aligned}\n$$\n\nFrom the first equation, we get $y-4=0,$ which means $y=4.$  From the second equation, we obtain $\\ln(x-2)=0,$ which means that $x=3.$\n\nTherefore, $\\nabla f(x,y) =\\mathbf  0$ at the point $(3,4).$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-3150"] :question/problem "Find the gradient of the product $f(x,y) g(x,y)$ given that \n\n$$\n\\begin{aligned}f(x,y) & =xy,\\, &  & ∇f(x,y)=y\\text{ }i+x\\text{ }j, &  &  \\\\ g(x,y) & =\\sqrt{xy},\\, &  & ∇g(x,y)=\\frac{\\sqrt{xy}}{2x}\\text{ }i+\\frac{\\sqrt{xy}}{2y}\\text{ }j. &  & \\end{aligned}\n$$" :question/worked-solution "The gradient of the product of two functions $f(x,y)$ and $g(x,y)$ is given by\n\n$$\n\\nabla [fg] = g \\, \\nabla\\! f  + f \\, \\nabla\\! g.\n$$\n\nUsing the product rule shown above, we obtain\n\n$$\n\\begin{aligned}∇[f(x,y)g(x,y)] & =g(x,y)∇f(x,y)+f(x,y)∇g(x,y) \\\\  & =\\sqrt{xy}(y\\text{ }i+x\\text{ }j)+xy(\\frac{\\sqrt{xy}}{2x}\\text{ }i+\\frac{\\sqrt{xy}}{2y}\\text{ }j) \\\\  & =\\sqrt{xy}(y\\text{ }i+x\\text{ }j)+\\frac{\\sqrt{xy}}{2}(y\\text{ }i+x\\text{ }j) \\\\  & =\\frac{3\\sqrt{xy}}{2}(y\\text{ }i+x\\text{ }j).\\end{aligned}\n$$" :db/ensure [:question/validate]}]
