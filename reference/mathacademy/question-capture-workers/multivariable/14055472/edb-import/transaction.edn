[{:db/id "q-132402/selection/f31d1bef258a61ac9eea3dd6ce198c27ac5e1cd952ce34eb55bdaa2feebce351" :answer/id #uuid "57ced348-cbd8-5e7e-9e49-f9ec2640e0b8" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{4-{y}^{2}}[{\\int }_{{y}^{2}-4}^{2}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132402/selection/6e6c0e069ee2b702699e29ffe13a37ececb96b7e14cc5ddf61b7d19168d9ed1e" :answer/id #uuid "aefb590b-1954-51e6-82ed-f44cbd2d9133" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{2}-4}^{4-{y}^{2}}[{\\int }_{0}^{2}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132402/selection/45ff9fc60b33bf79445907fabf5e13236f15d9ead61c1983b168c5e919b6b114" :answer/id #uuid "4cb22083-7269-5829-8376-2d34d691e5c2" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{4-{y}^{2}}^{{y}^{2}-4}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132402/selection/898720159bf1e9753b8ca27d45bb9cd770296cf64862b79623ab60d74bcd5522" :answer/id #uuid "48b83e21-4bc3-5cff-856f-a3dd79430ec3" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{2}-4}^{2}[{\\int }_{0}^{4-{y}^{2}}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132402/selection/6e40069a8d9886172c19ec1c403564b7445fed3c7f80934994392bd3a445d273" :answer/id #uuid "a3dda242-850d-5efd-a9c3-d41fca498194" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{{y}^{2}-4}^{4-{y}^{2}}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132402/selection" :answer-field/id #uuid "7fad1b46-1023-5aa2-9466-d27d00ead44f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132402/selection/6e40069a8d9886172c19ec1c403564b7445fed3c7f80934994392bd3a445d273" :answer-field/choices ["q-132402/selection/f31d1bef258a61ac9eea3dd6ce198c27ac5e1cd952ce34eb55bdaa2feebce351" "q-132402/selection/6e6c0e069ee2b702699e29ffe13a37ececb96b7e14cc5ddf61b7d19168d9ed1e" "q-132402/selection/45ff9fc60b33bf79445907fabf5e13236f15d9ead61c1983b168c5e919b6b114" "q-132402/selection/898720159bf1e9753b8ca27d45bb9cd770296cf64862b79623ab60d74bcd5522" "q-132402/selection/6e40069a8d9886172c19ec1c403564b7445fed3c7f80934994392bd3a445d273"] :db/ensure [:answer-field/validate]} {:db/id "q-132402" :question/id #uuid "19602799-cf55-5cdc-a41d-4ab0cc8e92dc" :question/math-academy-id "q-132402" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/bfa591e51f42e8e52b67e61c23b02ea69b03bdecc1c4b815370ce6b2b0b5f213.png)\n\nIf $D$ is the finite region enclosed by the $x$-axis and the curves $x={y}^{2}-4$ and $x=4-{y}^{2},$ as shown above, then ${∬}_{D}f(x,y)\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/85d3faac9a27353a8ea5151b3a32f1065aecb02fd07e0b20727c35de0a7fb216.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 2,\\,{y}^{2}-4\\le x\\le 4-{y}^{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{2}{\\int }_{{y}^{2}-4}^{4-{y}^{2}}f(x,y)\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{{y}^{2}-4}^{4-{y}^{2}}f(x,y)\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-132402/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "40bbc65e-5ee4-5ce6-aaf7-d0f9968c0c51"] :knowledge-point/questions ["q-132402"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81260/selection/7404fcbbecdbc2fe6654481a2dea84accb1374b276208250d5864af656c8d7e5" :answer/id #uuid "f35d13dc-cb15-5954-a279-5e491440e715" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{\\sqrt{y}}{\\int }_{1}^{{y}^{2}+2}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81260/selection/db839824c588260f9d44497d3cbdc0d91ec2f6ea44bb662b5ee5783ee6830abb" :answer/id #uuid "e1cf699a-266a-5603-a487-7ae6a8000841" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{{y}^{2}+2}^{\\sqrt{y}}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81260/selection/8fcbe92c2aef355a399982ec82165c9e7e3c57e56718e6d3c5f26310d82592bd" :answer/id #uuid "d48ba639-3036-5f09-845b-fdc141700694" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{{y}^{2}+2}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81260/selection/ab03424d4ff8a2340e42d4b20053c8cf3bba225a3dbaee3a666b148290902ffb" :answer/id #uuid "7cab6828-6212-5c15-b5b1-7c2b7d593b79" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{y}}^{1}{\\int }_{0}^{{y}^{2}+2}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81260/selection/20c6b6b85a6f330bb1d223bf23f37ccca278e4aab573a20e88b424598c52b54f" :answer/id #uuid "3d44c874-2999-549d-88fe-5515e5b98c7c" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{{y}^{2}+2}{\\int }_{1}^{\\sqrt{y}}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81260/selection" :answer-field/id #uuid "90519ca9-201c-56ba-9ed7-2533133c0a0b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81260/selection/8fcbe92c2aef355a399982ec82165c9e7e3c57e56718e6d3c5f26310d82592bd" :answer-field/choices ["q-81260/selection/7404fcbbecdbc2fe6654481a2dea84accb1374b276208250d5864af656c8d7e5" "q-81260/selection/db839824c588260f9d44497d3cbdc0d91ec2f6ea44bb662b5ee5783ee6830abb" "q-81260/selection/8fcbe92c2aef355a399982ec82165c9e7e3c57e56718e6d3c5f26310d82592bd" "q-81260/selection/ab03424d4ff8a2340e42d4b20053c8cf3bba225a3dbaee3a666b148290902ffb" "q-81260/selection/20c6b6b85a6f330bb1d223bf23f37ccca278e4aab573a20e88b424598c52b54f"] :db/ensure [:answer-field/validate]} {:db/id "q-81260" :question/id #uuid "9f0dcf3b-fd2c-5538-bc97-3c2c49455a71" :question/math-academy-id "q-81260" :question/problem "Consider the finite region $D$ in the $xy$-plane enclosed between the curves $y={x}^{2}$ and $y=\\sqrt{x-2}$ from $y=0$ to $y=1.$ What is ${∬}_{D}\\frac{xy}{1+{y}^{2}}\\,dA$ expressed as a repeated integral?" :question/worked-solution "First, let's represent $D$ as a type II region. Writing $y={x}^{2}$ and $y=\\sqrt{x-2}$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y={x}^{2} & \\,⟹\\,x=\\sqrt{y} \\\\ y=\\sqrt{x-2} & \\,⟹\\,x={y}^{2}+2\\end{aligned}\n$$\n\nTo determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/bb3249a9580e754c4ef9c33239c2a51a9b57ca9032a6acbeef7bbc532b2d4345.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,\\sqrt{y}\\le x\\le {y}^{2}+2}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\frac{xy}{1+{y}^{2}}\\,dA & ={\\int }_{0}^{1}{\\int }_{\\sqrt{y}}^{{y}^{2}+2}\\frac{xy}{1+{y}^{2}}\\,dx\\,dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81260/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "40bbc65e-5ee4-5ce6-aaf7-d0f9968c0c51"] :knowledge-point/questions ["q-81260"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81234/selection/bdeaae8e320d08926e28ccd9e4dd7699d94471b11c4fe89b51968011edc46638" :answer/id #uuid "3995f3d4-28f7-57ca-ba3d-3efb139b50af" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3-(y-3)^{2}}[{\\int }_{3}^{(y-4)^{2}+4}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81234/selection/a757587f15d2c5eb39ec639a897b7693b8cc19cb8a83fa211c65001942131e88" :answer/id #uuid "38541ad2-d5ec-5364-9748-b3de88135016" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}[{\\int }_{(y-3)^{2}+4}^{3-(y-3)^{2}}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81234/selection/e62c54d2d130a23e2d22e11b3f3e881d5f2bc9a7217a0306b47a51a78b2bd45c" :answer/id #uuid "c2e9f529-3cbd-58ca-a67f-8e4ef0c98df9" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{3}[{\\int }_{3-(y-3)^{2}}^{(y-3)^{2}+4}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81234/selection/6b6747530a4ecde84edbf9c74c30fa63a6cc0740a8874cbd284a7ea1482f6caf" :answer/id #uuid "ddec68e4-d6c4-5393-bf36-c522c9d3d1da" :answer/type :answer.type/math :answer/value "{\\int }_{3-(y-3)^{2}}^{(y-3)^{2}+4}[{\\int }_{0}^{3}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81234/selection/a99f49b80957a9af5480100cf13170fdedf45f0425be7de3cb5d545a75e4b5a9" :answer/id #uuid "fa367df2-84c3-58af-8655-6c84c5620c4b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{(y-3)^{2}+4}[{\\int }_{3}^{3-(y-3)^{2}}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81234/selection" :answer-field/id #uuid "8d4a7495-4d32-549a-9853-9ea81c81c0f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81234/selection/e62c54d2d130a23e2d22e11b3f3e881d5f2bc9a7217a0306b47a51a78b2bd45c" :answer-field/choices ["q-81234/selection/bdeaae8e320d08926e28ccd9e4dd7699d94471b11c4fe89b51968011edc46638" "q-81234/selection/a757587f15d2c5eb39ec639a897b7693b8cc19cb8a83fa211c65001942131e88" "q-81234/selection/e62c54d2d130a23e2d22e11b3f3e881d5f2bc9a7217a0306b47a51a78b2bd45c" "q-81234/selection/6b6747530a4ecde84edbf9c74c30fa63a6cc0740a8874cbd284a7ea1482f6caf" "q-81234/selection/a99f49b80957a9af5480100cf13170fdedf45f0425be7de3cb5d545a75e4b5a9"] :db/ensure [:answer-field/validate]} {:db/id "q-81234" :question/id #uuid "97d41871-0fb6-5b4b-9d4a-a5f8b16e5972" :question/math-academy-id "q-81234" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/5df807dc424366c043211f7d3a1667bc2c9888f24292856ed99a07d7ac586a94.png)\n\nIf $D$ is the finite region enclosed by the curves $x=3-(y-3)^{2},\\,$ $x=(y-3)^{2}+4,$ $y=0,$ and $y=3,$ as shown above, then ${∬}_{D}f(x,y)\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/3191f16e4c72739688fa4243b44a374a027b307b6e4d419217545e924e1c7a4a.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 3,\\,3-(y-3)^{2}\\le x\\le (y-3)^{2}+4}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{3}{\\int }_{3-(y-3)^{2}}^{(y-3)^{2}+4}f(x,y)\\,dx\\,dy \\\\  & ={\\int }_{0}^{3}[{\\int }_{3-(y-3)^{2}}^{(y-3)^{2}+4}f(x,y)\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81234/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "40bbc65e-5ee4-5ce6-aaf7-d0f9968c0c51"] :knowledge-point/questions ["q-81234"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40575"] :question/problem "Consider the finite region $D$ in the $xy$-plane enclosed between the lines $y=2x$ and $y=-x$ from $y=0$ to $y=4.$ What is ${∬}_{D}({x}^{2}+{y}^{2})\\,dA$ expressed as a repeated integral?" :question/worked-solution "First, let's represent $D$ as a type II region. Writing $y=2x$ and $y=-x$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y=2x & \\,⟹\\,x=\\frac{x}{2} \\\\ y=-x & \\,⟹\\,x=-y\\end{aligned}\n$$\n\nTo determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/df512140098a6fc6adc03e4d98199896cf15ed1cdd40578aea14ff1e83dfeba3.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 4,\\,-y\\le x\\le \\frac{y}{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}({x}^{2}+{y}^{2})\\,dA & ={\\int }_{0}^{4}{\\int }_{-y}^{y/2}({x}^{2}+{y}^{2})\\,dx\\,dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-81232/selection/00a59fb4f4dbe86bf793c717c95254f7f7dd7da395f4a3da6613faad43462185" :answer/id #uuid "69c6dae4-39c1-5972-84e2-3caf3dd62aea" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{{y}^{2}/2}^{6-{y}^{2}}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81232/selection/7c28f1442f094da1fff99db08782248e5756fca7cf648d397cedd40ef46ccb62" :answer/id #uuid "353f51ee-226c-511e-8831-b58fcdea5490" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{6-{y}^{2}}^{{y}^{2}/2}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81232/selection/e2ab2f1a37248fa15bcc2c5c99c4e3743ad1f40e791525c886d7b495132ed0ab" :answer/id #uuid "89d9529c-0e18-5594-96c6-6f9a52ade782" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{{y}^{2}/2}[{\\int }_{2}^{6-{y}^{2}}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81232/selection/3b159812d260f506a756913d294925fea56815c0f4bfe340daa3c567b2f93ba7" :answer/id #uuid "5c7f83d0-fcfe-5eb7-9614-d4a223458fd6" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{2}/2}^{6-{y}^{2}}[{\\int }_{0}^{2}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81232/selection/2e3140756b309c2966dd9ce9bb6f2f46d1f0829cf090d1f83843939ef81fab11" :answer/id #uuid "c603822b-6bb1-5b04-badf-84155da40d3a" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{6-{y}^{2}}[{\\int }_{2}^{{y}^{2}/2}f(x,y)\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-81232/selection" :answer-field/id #uuid "95490564-6e43-5c4b-9ca3-8ccbeacb6212" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81232/selection/00a59fb4f4dbe86bf793c717c95254f7f7dd7da395f4a3da6613faad43462185" :answer-field/choices ["q-81232/selection/00a59fb4f4dbe86bf793c717c95254f7f7dd7da395f4a3da6613faad43462185" "q-81232/selection/7c28f1442f094da1fff99db08782248e5756fca7cf648d397cedd40ef46ccb62" "q-81232/selection/e2ab2f1a37248fa15bcc2c5c99c4e3743ad1f40e791525c886d7b495132ed0ab" "q-81232/selection/3b159812d260f506a756913d294925fea56815c0f4bfe340daa3c567b2f93ba7" "q-81232/selection/2e3140756b309c2966dd9ce9bb6f2f46d1f0829cf090d1f83843939ef81fab11"] :db/ensure [:answer-field/validate]} {:db/id "q-81232" :question/id #uuid "01fbeb37-0afa-51c2-b623-3242c662194e" :question/math-academy-id "q-81232" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/5197029ed6803a39bf6d6d14bbdd8b3a71d8905e854bf3842305828280cbc39b.png)\n\nIf $D$ is the finite region enclosed by the curves $x=\\frac{{y}^{2}}{2},\\,$ $x=6-{y}^{2},$ and $y=0,$ as shown above, then ${∬}_{D}f(x,y)\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/1761963e320e603b9c94ea4bab2df6f6ee8cc1b92cc0ca45bc84c8aeda1d3a11.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 2,\\,\\frac{{y}^{2}}{2}\\le x\\le 6-{y}^{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{0}^{2}{\\int }_{{y}^{2}/2}^{6-{y}^{2}}f(x,y)\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{{y}^{2}/2}^{6-{y}^{2}}f(x,y)\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-81232/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "40bbc65e-5ee4-5ce6-aaf7-d0f9968c0c51"] :knowledge-point/questions ["q-81232"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-40596"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/c752eb32fc94ae630ef3998c81a6b9b0af5c222a367f87db8bbacb877716c16c.png)\n\nIf $D$ is the finite region enclosed by the lines $x=2-y,\\,$ $x=\\frac{y}{2},$ and $y=0,$ as shown above, then ${∬}_{D}xy\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}2-y & =\\frac{y}{2} \\\\ -\\frac{3}{2}y & =-2 \\\\ y & =\\frac{4}{3}\\end{aligned}\n$$\n\nSo, $y$-limits are \n$0\\le y\\le \\frac{4}{3}.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/e6c9332f8f59e2561af9ba5aa89311263fb772dc987ed0b15d91a6d5eea5cf8e.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le \\frac{4}{3},\\,\\frac{y}{2}\\le x\\le 2-y}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}xy\\,dA & ={\\int }_{0}^{4/3}{\\int }_{y/2}^{2-y}xy\\,dx\\,dy \\\\  & ={\\int }_{0}^{4/3}[{\\int }_{y/2}^{2-y}xy\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-132512/selection/7189e9f1f711ac6fc661fcf0f96e3e5ce3ceb2a96be2a5703b16d8434278083a" :answer/id #uuid "844ef872-5462-5357-b541-1227fd962258" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}[{\\int }_{{y}^{2}}^{2-{y}^{2}}\\sqrt{\\frac{x}{y+1}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132512/selection/78fb7b98041d6b68a984a11007b0ac2d4604a2ac1edb11479303e032096018c1" :answer/id #uuid "3f583e21-8385-5a29-afc9-45bff8108a33" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}[{\\int }_{2-{y}^{2}}^{{y}^{2}}\\sqrt{\\frac{x}{y+1}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132512/selection/0bc5df6bfe14cb07acef38a785c9ed630245f8440ae33840ad1289664d02cc40" :answer/id #uuid "c13615d8-7159-5619-b507-2d9c2a8aef15" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{2}}^{1}[{\\int }_{0}^{2-{y}^{2}}\\sqrt{\\frac{x}{y+1}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132512/selection/987e6c5bab9294666fac1afb07113745b7f3602ea3285986459a59d6d5856876" :answer/id #uuid "7d72a8cb-7ced-59f3-bb6c-4e384d778158" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2-{y}^{2}}[{\\int }_{{y}^{2}}^{1}\\sqrt{\\frac{x}{y+1}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132512/selection/697c630344b5b3884d4ebacfac4d69eb485711bb7b83618b1f603beb942db412" :answer/id #uuid "e3eddd40-50ac-569c-b853-35fe004a52a3" :answer/type :answer.type/math :answer/value "{\\int }_{{y}^{2}}^{2-{y}^{2}}[{\\int }_{0}^{1}\\sqrt{\\frac{x}{y+1}}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132512/selection" :answer-field/id #uuid "796f1c92-4358-5fd5-9af4-4df637129f8f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132512/selection/7189e9f1f711ac6fc661fcf0f96e3e5ce3ceb2a96be2a5703b16d8434278083a" :answer-field/choices ["q-132512/selection/7189e9f1f711ac6fc661fcf0f96e3e5ce3ceb2a96be2a5703b16d8434278083a" "q-132512/selection/78fb7b98041d6b68a984a11007b0ac2d4604a2ac1edb11479303e032096018c1" "q-132512/selection/0bc5df6bfe14cb07acef38a785c9ed630245f8440ae33840ad1289664d02cc40" "q-132512/selection/987e6c5bab9294666fac1afb07113745b7f3602ea3285986459a59d6d5856876" "q-132512/selection/697c630344b5b3884d4ebacfac4d69eb485711bb7b83618b1f603beb942db412"] :db/ensure [:answer-field/validate]} {:db/id "q-132512" :question/id #uuid "3e86e174-5e1d-50e1-90b0-25915ef48280" :question/math-academy-id "q-132512" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/d90e750755a9520328e99583bfc80d9498ed34eb1695ba4ecd55b688d5b0216f.png)\n\nIf $D$ is the finite region enclosed between the curves $x={y}^{2}$ and $x=2-{y}^{2},$ above the $x$-axis, as shown above, then ${∬}_{D}\\sqrt{\\frac{x}{y+1}}\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}{y}^{2} & =2-{y}^{2} \\\\ 2{y}^{2} & =2 \\\\ {y}^{2} & =1 \\\\ y & =\\pm 1\\end{aligned}\n$$\n\nSo, since our region lies above the line $y=0,$ the $y$-limits are \n$0\\le y\\le 1.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/eeadcddee3bc966372613ded9304c723768e9b81cd0299ad14084a94c9348463.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 1,\\,{y}^{2}\\le x\\le 2-{y}^{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}\\sqrt{\\frac{x}{y+1}}\\,dA & ={\\int }_{0}^{1}{\\int }_{{y}^{2}}^{2-{y}^{2}}\\sqrt{\\frac{x}{y+1}}\\,dx\\,dy \\\\  & ={\\int }_{0}^{1}[{\\int }_{{y}^{2}}^{2-{y}^{2}}\\sqrt{\\frac{x}{y+1}}\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-132512/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ccbe70d-24f4-5e9c-8536-9ccab99f571b"] :knowledge-point/questions ["q-132512"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132499/selection/37447dd1e12bcf4d1676d772cfb1524bf03bbb546fa0e7f01c7e9d48f6ab21e0" :answer/id #uuid "b7dd10a0-cc46-5b59-87d3-9174e3a74ef6" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{5-y/2}[{\\int }_{y-1}^{4}x\\sqrt{y}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132499/selection/7674986929fa23509007f2595f4f76fcd7cc68db2dcb776e85f92c0206159e56" :answer/id #uuid "cae9b901-9f03-5cca-92e8-1f6e00cc8cca" :answer/type :answer.type/math :answer/value "{\\int }_{y-1}^{5-y/2}[{\\int }_{1}^{4}x\\sqrt{y}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132499/selection/e60bad6ad4ee6eb625eb71583aac2a9c016b8814d3d7125dd40e63fdc0ef1ef7" :answer/id #uuid "6ed45d05-79e5-542d-9b49-2d95fe7a5a8c" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}[{\\int }_{5-y/2}^{y-1}x\\sqrt{y}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132499/selection/60434ae0132de1041817e5486cecb971f13c425c7023058a73a1947791f84eb2" :answer/id #uuid "9c9d2bce-761c-57cb-bed7-5eabbdc8ee3c" :answer/type :answer.type/math :answer/value "{\\int }_{y-1}^{4}[{\\int }_{1}^{5-y/2}x\\sqrt{y}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132499/selection/6e2360d58da8b2b040c76061d8021c808af6ec1d087271706338141c5cda0a9f" :answer/id #uuid "ed7083eb-ec17-5ebc-8585-9a22c4d3bbf8" :answer/type :answer.type/math :answer/value "{\\int }_{1}^{4}[{\\int }_{y-1}^{5-y/2}x\\sqrt{y}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132499/selection" :answer-field/id #uuid "5cbdac7b-e62c-5341-bf37-c98789712411" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132499/selection/6e2360d58da8b2b040c76061d8021c808af6ec1d087271706338141c5cda0a9f" :answer-field/choices ["q-132499/selection/37447dd1e12bcf4d1676d772cfb1524bf03bbb546fa0e7f01c7e9d48f6ab21e0" "q-132499/selection/7674986929fa23509007f2595f4f76fcd7cc68db2dcb776e85f92c0206159e56" "q-132499/selection/e60bad6ad4ee6eb625eb71583aac2a9c016b8814d3d7125dd40e63fdc0ef1ef7" "q-132499/selection/60434ae0132de1041817e5486cecb971f13c425c7023058a73a1947791f84eb2" "q-132499/selection/6e2360d58da8b2b040c76061d8021c808af6ec1d087271706338141c5cda0a9f"] :db/ensure [:answer-field/validate]} {:db/id "q-132499" :question/id #uuid "0ea00186-dbdd-5fef-968b-f1e2bc005692" :question/math-academy-id "q-132499" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/6d6597bff5d28155e9a40f953b0ab0652f175e4d4d0aaf6f28c50e6d5bc907d2.png)\n\nIf $D$ is the finite region enclosed by the lines $x=y-1,\\,$ $x=5-\\frac{y}{2},$ and $y=1,$ as shown above, then ${∬}_{D}x\\sqrt{y}\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}y-1 & =-\\frac{y}{2}+5 \\\\ \\frac{3}{2}y & =6 \\\\ y & =4\\end{aligned}\n$$\n\nSo, $y$-limits are \n$1\\le y\\le 4.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/e2de1b62c6f3d0a15c0b95e3204f7889f6fc1ffbe108bdba7871c150091f6977.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,1\\le y\\le 4,\\,y-1\\le x\\le 5-\\frac{y}{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}x\\sqrt{y}\\,dA & ={\\int }_{1}^{4}{\\int }_{y-1}^{5-y/2}x\\sqrt{y}\\,dx\\,dy \\\\  & ={\\int }_{1}^{4}[{\\int }_{y-1}^{5-y/2}x\\sqrt{y}\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-132499/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ccbe70d-24f4-5e9c-8536-9ccab99f571b"] :knowledge-point/questions ["q-132499"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81291/selection/93b4042b8d5eb7e08e22a914f3540bdec8c0ace6ef8ae2cf6adb36319c7372e9" :answer/id #uuid "18f70075-6f2f-5b4d-9ce3-f30d3f6e2cae" :answer/type :answer.type/math :answer/value "{\\int }_{1/y}^{2}{\\int }_{\\sqrt{2}/2}^{2y}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81291/selection/2c0e522c8dcabcb89210350ac3e553afd787b71e099b0a17a62d0ded7082ee7a" :answer/id #uuid "08453bf0-00d1-506c-b3b5-ae4e3c3e0923" :answer/type :answer.type/math :answer/value "{\\int }_{1/y}^{2y}{\\int }_{\\sqrt{2}/2}^{2}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81291/selection/b49f6dcb8079c4b317038e74bd14c187ed65040cd210dd0ff59c5ba559cf24dc" :answer/id #uuid "488ccd76-6a0f-5f9e-a4e7-e1c42b254497" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{2}/2}^{2}{\\int }_{1/y}^{2y}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81291/selection/a36153f75ad09335ca152c6a38e05a922e035b249b9955533d3d4bfb8121e03f" :answer/id #uuid "d6a40839-69a4-5730-949f-5219f38ce864" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{2}/2}^{1/y}{\\int }_{2}^{2y}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81291/selection/3b861a9efe12c7ae30010c74ef02f3bc847254f5811d3ada3371c7f1edcff303" :answer/id #uuid "3ed2d29d-9fee-5db5-b818-fa8b741ea209" :answer/type :answer.type/math :answer/value "{\\int }_{\\sqrt{2}/2}^{2}{\\int }_{2y}^{1/y}f(x,y)\\,dx\\,dy" :db/ensure [:answer/validate]} {:db/id "q-81291/selection" :answer-field/id #uuid "80767715-90ed-5a4d-8151-2f2fcea5a376" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81291/selection/b49f6dcb8079c4b317038e74bd14c187ed65040cd210dd0ff59c5ba559cf24dc" :answer-field/choices ["q-81291/selection/93b4042b8d5eb7e08e22a914f3540bdec8c0ace6ef8ae2cf6adb36319c7372e9" "q-81291/selection/2c0e522c8dcabcb89210350ac3e553afd787b71e099b0a17a62d0ded7082ee7a" "q-81291/selection/b49f6dcb8079c4b317038e74bd14c187ed65040cd210dd0ff59c5ba559cf24dc" "q-81291/selection/a36153f75ad09335ca152c6a38e05a922e035b249b9955533d3d4bfb8121e03f" "q-81291/selection/3b861a9efe12c7ae30010c74ef02f3bc847254f5811d3ada3371c7f1edcff303"] :db/ensure [:answer-field/validate]} {:db/id "q-81291" :question/id #uuid "37207123-75ea-50cb-aebf-4dad083ae03c" :question/math-academy-id "q-81291" :question/problem "Consider the finite region $D$ in the $xy$-plane enclosed between the curves $y=\\frac{1}{x}$ where $x>0,$ and $y=\\frac{x}{2},$ below the line $y=2.$ What is ${∬}_{D}f(x,y)\\,dA\\,$ expressed as a repeated integral?" :question/worked-solution "First, let's make a sketch of our region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/2209e57f8cbe84ccf2f930c5cd3004ff5009dfb72f3e4b3262517cf9b8f2b119.png)\n\nWe need to represent $D$ as a type II region. Writing $y=\\frac{1}{x}$ and $y=\\frac{x}{2}$ in terms of $y,$ we obtain\n\n$$\n\\begin{aligned}y=\\frac{1}{x} & \\,⟹\\,x=\\frac{1}{y} \\\\ y=\\frac{x}{2} & \\,⟹\\,x=2y\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\frac{1}{y} & =2y \\\\ 2y-\\frac{1}{y} & =0 \\\\ \\frac{2{y}^{2}-1}{y} & =0 \\\\ 2{y}^{2}-1 & =0 \\\\ {y}^{2} & =\\frac{1}{2} \\\\ y & =\\pm \\frac{\\sqrt{2}}{2}\\end{aligned}\n$$\n\nSo, since our region lies in the first quadrant below the line $y=2$ the $y$-limits are \n$\\frac{\\sqrt{2}}{2}\\le y\\le 2.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/1b03741537734087836c22dbb40e2e188825bade657cff129374efe1596bcb3c.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,\\frac{\\sqrt{2}}{2}\\le y\\le 2,\\,\\frac{1}{y}\\le x\\le 2y}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}f(x,y)\\,dA & ={\\int }_{\\sqrt{2}/2}^{2}{\\int }_{1/y}^{2y}f(x,y)\\,dx\\,dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81291/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ccbe70d-24f4-5e9c-8536-9ccab99f571b"] :knowledge-point/questions ["q-81291"] :db/ensure [:knowledge-point/validate]} {:db/id "q-132510/selection/9af53b4f44022df8ce21f60ca6f0841308e1aa612ddab9993269772efb487d7f" :answer/id #uuid "4afa6f7f-2b5d-586c-917c-026e65b88b60" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{2-{y}^{2}}^{(y-2)^{2}/2-2}x{y}^{2}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132510/selection/372e7c56af3bb091a9daf27a3038e57fa88deccba562123baf659fdc768ec350" :answer/id #uuid "d1bd7153-962b-58dc-b185-f99438b0d090" :answer/type :answer.type/math :answer/value "{\\int }_{(y-2)^{2}/2-2}^{2-{y}^{2}}[{\\int }_{0}^{2}x{y}^{2}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132510/selection/7763fe1352a8598174149b606c2d5272a65c440b735d64c0ac7586a0bfe90fb2" :answer/id #uuid "08722839-b6c5-58e2-ab01-33df1d039a44" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2-{y}^{2}}[{\\int }_{(y-2)^{2}/2-2}^{2}x{y}^{2}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132510/selection/fbf1a6197b29d1536524714d55d3439946cef5a777ead05fa444526ebf21253c" :answer/id #uuid "caba9513-bd38-5ea3-81cd-ccc7ee023ac5" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{2}[{\\int }_{(y-2)^{2}/2-2}^{2-{y}^{2}}x{y}^{2}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132510/selection/58030827f9581a108e06dac212fb40c173a55f2985eed0e64e9759cecf128d25" :answer/id #uuid "121344bf-66ee-5751-916b-6dbd64076beb" :answer/type :answer.type/math :answer/value "{\\int }_{(y-2)^{2}/2-2}^{2}[{\\int }_{0}^{2-{y}^{2}}x{y}^{2}\\,dx]dy" :db/ensure [:answer/validate]} {:db/id "q-132510/selection" :answer-field/id #uuid "67ca20b8-81a8-5715-b683-2ef9e9f557f9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-132510/selection/fbf1a6197b29d1536524714d55d3439946cef5a777ead05fa444526ebf21253c" :answer-field/choices ["q-132510/selection/9af53b4f44022df8ce21f60ca6f0841308e1aa612ddab9993269772efb487d7f" "q-132510/selection/372e7c56af3bb091a9daf27a3038e57fa88deccba562123baf659fdc768ec350" "q-132510/selection/7763fe1352a8598174149b606c2d5272a65c440b735d64c0ac7586a0bfe90fb2" "q-132510/selection/fbf1a6197b29d1536524714d55d3439946cef5a777ead05fa444526ebf21253c" "q-132510/selection/58030827f9581a108e06dac212fb40c173a55f2985eed0e64e9759cecf128d25"] :db/ensure [:answer-field/validate]} {:db/id "q-132510" :question/id #uuid "11862ce2-c090-5636-9ec3-c43c9808c1ec" :question/math-academy-id "q-132510" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/f390e83f737b3b20931df5e97a9ea0750b8b190acba14d1cd963aaab5175ba50.png)\n\nIf $D$ is the finite region enclosed between the curves $x=\\frac{1}{2}(y-2)^{2}-2$ and $x=2-{y}^{2},$ above the $x$-axis, as shown above, then ${∬}_{D}x{y}^{2}\\,dA=$" :question/worked-solution "First, let's represent $D$ as a type II region. \n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\frac{1}{2}(y-2)^{2}-2 & =2-{y}^{2} \\\\ \\frac{1}{2}({y}^{2}-4y+4)+{y}^{2}-4 & =0 \\\\ {y}^{2}-4y+4+2{y}^{2}-8 & =0 \\\\ 3{y}^{2}-4y-4 & =0 \\\\ (3y+2)(y-2) & =0\\end{aligned}\n$$\n\nSo, since our region lies above the line $y=0,$ the $y$-limits are \n$0\\le y\\le 2.$,\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/1b67c65c78dc847c2bf4bf53ad67f770a1406570548497edd55939c3a68a4c5c.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 2,\\,\\frac{1}{2}(y-2)^{2}-2\\le x\\le 2-{y}^{2}}.\n$$\n\nTherefore, we can express the integral as follows:\n\n$$\n\\begin{aligned}{∬}_{D}x{y}^{2}\\,dA & ={\\int }_{0}^{2}{\\int }_{(y-2)^{2}/2-2}^{2-{y}^{2}}x{y}^{2}\\,dx\\,dy \\\\  & ={\\int }_{0}^{2}[{\\int }_{(y-2)^{2}/2-2}^{2-{y}^{2}}x{y}^{2}\\,dx]dy\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-132510/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2ccbe70d-24f4-5e9c-8536-9ccab99f571b"] :knowledge-point/questions ["q-132510"] :db/ensure [:knowledge-point/validate]} {:db/id "q-81315/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer/id #uuid "224b7702-2e49-5a49-8478-f6c3c5488a3f" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}" :db/ensure [:answer/validate]} {:db/id "q-81315/selection/26d56282497397e2cb22481c4a4fa1a5e785860d52ba1416fe2e4e5146075126" :answer/id #uuid "f46cc74f-82a9-511e-af30-ead528b922c7" :answer/type :answer.type/math :answer/value "2-\\pi " :db/ensure [:answer/validate]} {:db/id "q-81315/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" :answer/id #uuid "ed5525e1-2b59-56b0-98b3-e5d1780a4c11" :answer/type :answer.type/math :answer/value "\\frac{1}{4}" :db/ensure [:answer/validate]} {:db/id "q-81315/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "79af94b3-98d5-5ac9-ba33-b1d8b1ec0c1f" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-81315/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03" :answer/id #uuid "d1432c81-1ca0-5ddb-b6fb-151fb9449554" :answer/type :answer.type/math :answer/value "4" :db/ensure [:answer/validate]} {:db/id "q-81315/selection" :answer-field/id #uuid "d5dafd16-e2ce-5543-8186-3d909173e19f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-81315/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" :answer-field/choices ["q-81315/selection/4e2cb386499e1926f074a7bcd422a63175a237204a3823f0fa6c86b56d301873" "q-81315/selection/26d56282497397e2cb22481c4a4fa1a5e785860d52ba1416fe2e4e5146075126" "q-81315/selection/99f48c1b72e8eeab33eba2584ff0661456642ba13c82a72d98a76e8e1a07563e" "q-81315/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-81315/selection/be9eb51cc2f690a7d5b4aa400428edabf5a5d631a176c92b7f40bdd47725ed03"] :db/ensure [:answer-field/validate]} {:db/id "q-81315" :question/id #uuid "486208d4-0efc-55f9-a8c8-e0ee98659b77" :question/math-academy-id "q-81315" :question/problem "Calculate ${\\int }_{0}^{\\sqrt{3\\pi /2}}{\\int }_{0}^{y}\\operatorname{cos}⁡{y}^{2}\\,dx\\,dy.$" :question/worked-solution "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3\\pi /2}}{\\int }_{0}^{y}\\operatorname{cos}⁡{y}^{2}\\,dx\\,dy & ={\\int }_{0}^{\\sqrt{3\\pi /2}}\\operatorname{cos}⁡{y}^{2}[{\\int }_{0}^{y}dx]dy \\\\  & ={\\int }_{0}^{\\sqrt{3\\pi /2}}\\operatorname{cos}⁡{y}^{2}[x]_{0}^{y}\\,dy \\\\  & ={\\int }_{0}^{\\sqrt{3\\pi /2}}\\operatorname{cos}⁡{y}^{2}(y-0)\\,dy \\\\  & ={\\int }_{0}^{\\sqrt{3\\pi /2}}y\\,\\operatorname{cos}⁡{y}^{2}\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{0}^{\\sqrt{3\\pi /2}}y\\operatorname{cos}⁡{y}^{2}\\,dy & ={[\\frac{\\operatorname{sin}⁡{y}^{2}}{2}]}_{0}^{\\sqrt{3\\pi /2}} \\\\  & =\\frac{1}{2}(\\operatorname{sin}⁡(\\frac{3\\pi }{2})-\\operatorname{sin}⁡(0)) \\\\  & =\\frac{1}{2}(-1-0) \\\\  & =-\\frac{1}{2}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-81315/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "fdce40e5-8ffe-52cb-8a8e-ac8eaea982f0"] :knowledge-point/questions ["q-81315"] :db/ensure 