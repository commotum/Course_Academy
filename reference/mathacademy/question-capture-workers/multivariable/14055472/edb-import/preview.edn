5130 true] [17592186332801 1000 #edb/ref 17592186332802 13194139535130 true] [17592186332801 1000 #edb/ref 17592186332803 13194139535130 true] [17592186332801 1000 #edb/ref 17592186332804 13194139535130 true] [17592186332801 1000 #edb/ref 17592186332805 13194139535130 true] [17592186332801 1000 #edb/ref 17592186332806 13194139535130 true] [17592186332801 1040 #edb/ref 17592186045450 13194139535130 true] [17592186332801 1041 "selection" 13194139535130 true] [17592186332801 1104 #edb/ref 17592186332803 13194139535130 true] [17592186332801 1110 #uuid "d5dafd16-e2ce-5543-8186-3d909173e19f" 13194139535130 true] [17592186332802 1034 "2-\\pi " 13194139535130 true] [17592186332802 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332802 1111 #uuid "f46cc74f-82a9-511e-af30-ead528b922c7" 13194139535130 true] [17592186332803 1034 "-\\frac{1}{2}" 13194139535130 true] [17592186332803 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332803 1111 #uuid "224b7702-2e49-5a49-8478-f6c3c5488a3f" 13194139535130 true] [17592186332804 1034 "\\frac{1}{4}" 13194139535130 true] [17592186332804 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332804 1111 #uuid "ed5525e1-2b59-56b0-98b3-e5d1780a4c11" 13194139535130 true] [17592186332805 1034 "4" 13194139535130 true] [17592186332805 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332805 1111 #uuid "d1432c81-1ca0-5ddb-b6fb-151fb9449554" 13194139535130 true] [17592186332806 1034 "-2" 13194139535130 true] [17592186332806 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332806 1111 #uuid "79af94b3-98d5-5ac9-ba33-b1d8b1ec0c1f" 13194139535130 true] [17592186332807 1017 #edb/ref 17592186332808 13194139535130 true] [17592186332807 1089 "q-81320" 13194139535130 true] [17592186332807 1091 #edb/ref 17592186045465 13194139535130 true] [17592186332807 1100 "Calculate ${\\int }_{1}^{4}{\\int }_{1}^{{y}^{3}}\\frac{1}{{y}^{2}}\\,dx\\,dy.$" 13194139535130 true] [17592186332807 1113 #uuid "67b5ec5f-9e3b-51f6-93fe-06568326e407" 13194139535130 true] [17592186332807 1145 "The integral is defined over a type II region.\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}{\\int }_{1}^{{y}^{3}}\\frac{1}{{y}^{2}}\\,dx\\,dy & ={\\int }_{1}^{4}\\frac{1}{{y}^{2}}[{\\int }_{1}^{{y}^{3}}dx]\\,dy \\\\  & ={\\int }_{1}^{4}\\frac{1}{{y}^{2}}[x]_{1}^{{y}^{3}}\\,dy \\\\  & ={\\int }_{1}^{4}\\frac{1}{{y}^{2}}({y}^{3}-1)\\,dy \\\\  & ={\\int }_{1}^{4}(y-\\frac{1}{{y}^{2}})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}{\\int }_{1}^{4}(y-\\frac{1}{{y}^{2}})\\,dy & ={[\\frac{{y}^{2}}{2}+\\frac{1}{y}]}_{1}^{4} \\\\  & =(8+\\frac{1}{4})-(\\frac{1}{2}+1) \\\\  & =\\frac{27}{4}\\end{aligned}\n$$" 13194139535130 true] [17592186332808 1000 #edb/ref 17592186332809 13194139535130 true] [17592186332808 1000 #edb/ref 17592186332810 13194139535130 true] [17592186332808 1000 #edb/ref 17592186332811 13194139535130 true] [17592186332808 1000 #edb/ref 17592186332812 13194139535130 true] [17592186332808 1000 #edb/ref 17592186332813 13194139535130 true] [17592186332808 1040 #edb/ref 17592186045450 13194139535130 true] [17592186332808 1041 "selection" 13194139535130 true] [17592186332808 1104 #edb/ref 17592186332813 13194139535130 true] [17592186332808 1110 #uuid "9757dc81-7980-5f3f-a73c-c2a54ef6fbbf" 13194139535130 true] [17592186332809 1034 "\\frac{17}{5}" 13194139535130 true] [17592186332809 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332809 1111 #uuid "f483089b-1921-5111-9b82-95093ed6819e" 13194139535130 true] [17592186332810 1034 "-\\frac{2}{3}" 13194139535130 true] [17592186332810 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332810 1111 #uuid "7dd5e7bc-235d-5975-a02f-c1d5b119bb5a" 13194139535130 true] [17592186332811 1034 "-\\frac{7}{4}" 13194139535130 true] [17592186332811 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332811 1111 #uuid "62fcadbd-bd99-5c73-a2b5-702e5c087370" 13194139535130 true] [17592186332812 1034 "\\frac{2}{5}" 13194139535130 true] [17592186332812 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332812 1111 #uuid "ef4ba8e8-1655-50a5-b4ec-735d385a1916" 13194139535130 true] [17592186332813 1034 "\\frac{27}{4}" 13194139535130 true] [17592186332813 1103 #edb/ref 17592186045453 13194139535130 true] [17592186332813 1111 #uuid "e5700389-74d9-5655-b605-a75ce4a0605e" 13194139535130 true] [17592186332814 1017 #edb/ref 17592186332815 13194139535130 true] [17592186332814 1089 "q-81395" 13194139535130 true] [17592186332814 1091 #edb/ref 17592186045464 13194139535130 true] [17592186332814 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/ff3b9f52ed01d991d1fff18e78c494488b53703669b6bb326b5436a19c952a18.png)\n\nEvaluate the double integral ${∬}_{D}x\\,dA,\\,$\nwhere $D$ is the region enclosed between the curves $3{x}^{2}+{y}^{2}=9$ and ${x}^{2}+{y}^{2}=9,$ as shown in the picture." 13194139535130 true] [17592186332814 1113 #uuid "9e6f245d-e90c-5a95-8ef4-6c1feb736768" 13194139535130 true] [17592186332814 1145 "Notice that $D$ is a type II region. Since $x\\ge 0,$ we obtain the following equations in terms of $y:$\n\n$$\n\\begin{aligned}{x}^{2}+{y}^{2}=9 & \\,⟹\\,x=\\sqrt{9-{y}^{2}} \\\\ 3{x}^{2}+{y}^{2}=9 & \\,⟹\\,x=\\sqrt{3-\\frac{{y}^{2}}{3}}\\end{aligned}\n$$\n\nNow, let's determine the limits of integration.\n\n- To determine the $y$-limits, we need to find the $y$-coordinates of the points at which the curves intersect. So, we set the following equation and solve it for $y:$\n\n$$\n\\begin{aligned}\\sqrt{9-{y}^{2}} & =\\sqrt{3-\\frac{{y}^{2}}{3}} \\\\ 9-{y}^{2} & =3-\\frac{{y}^{2}}{3} \\\\ \\frac{2}{3}{y}^{2} & =6 \\\\ {y}^{2} & =9\\end{aligned}\n$$\n\nSo, since our region lies above the line the $x$-axis, the $y$-limits are \n$0\\le y\\le 3.$\n\n- To determine the left and right functions, we draw a horizontal arrow from left to right through the region, as usual.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14055472/assets/91f377562a1e94218b7be886cd63638e8881b0c4fac231a810bb6bff3a1fe643.png)\n\nAs a result, we get\n\n$$\nD={(x,y)\\,:\\,0\\le y\\le 3,\\,\\sqrt{3-\\frac{{y}^{2}}{3}}\\le x\\le \\sqrt{9-{y}^{2}}}.\n$$\n\nSo, we can express the integral as follows:\n\n$$\n{∬}_{D}x\\,dA={\\int }_{0}^{3}{\\int }_{\\sqrt{3-{y}^{2}/3}}^{\\sqrt{9-{y}^{2}}}x\\,dx\\,dy\n$$\n\nFirst, we evaluate the inner integral by integrating with respect to $x$, treating $y$ as a constant:\n\n$$\n\\begin{aligned}{\\int }_{0}^{3}{\\int }_{\\sqrt{3-{y}^{2}/3}}^{\\sqrt{9-{y}^{2}}}x\\,dx\\,dy & ={\\int }_{0}^{3}[{\\int }_{\\sqrt{3-{y}^{2}/3}}^{\\sqrt{9-{y}^{2}}}x\\,dx]dy \\\\  & ={\\int }_{0}^{3}{[\\frac{{x}^{2}}{2}]}_{\\sqrt{3-{y}^{2}/3}}^{\\sqrt{9-{y}^{2}}}\\,dy \\\\  & ={\\int }_{0}^{3}\\frac{1}{2}(9-{y}^{2}-(3-\\frac{{y}^{2}}{3}))\\,dy \\\\  & =\\frac{1}{2}{\\int }_{0}^{3}(6-\\frac{2}{3}{y}^{2})\\,dy\\end{aligned}\n$$\n\nThen, we integrate with respect to $y:$\n\n$$\n\\begin{aligned}\\frac{1}{2}{\\int }_{0}^{3}(6-\\frac{2}{3}{y}^{2})\\,dy & =\\frac{1}{2}{[6y-\\frac{2}{9}{y}^{3}]}_{0}^{3} \\\\  & =\\frac{1}{2}(18-6-0) \\\\  & =6\\end{aligned}\n$$" 13194139535130 true] [17592186332815 1000 #edb/ref 17592186332816 13194139535130 true] [17592186332815 1000 #edb/ref 17592186332817 13194139535130 true] [17592186332815 1000 #edb/ref 17592186332818 13194139535130 true] [17592186332815 1000 #edb/ref 17592186332819 13194139535130 true] [17592186332815 1000 #edb/ref 17592186332820 13194139535130 true] [17592186332815 1040 #edb/ref 17592186045450 13194139535130 true] [17592186332815 1041 "selection" 13194139535130 true] [17592186332815 1104 #edb/ref 17592186332818 13194139535130 true] [17592186332815 1110 #uuid "8549113f-232a-5575-8e07-f9e818e96622" 13194139535130 true] [17592186332816 1034 "12" 13194139535130 true] [17592186332816 1103 #edb/re