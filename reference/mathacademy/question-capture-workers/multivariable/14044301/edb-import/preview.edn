)$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-3}{(-1)}=\\frac{y-2}{4}=\\frac{z-1}{(-2)} \\\\ \\frac{x-3}{1}=\\frac{y-2}{-4}=\\frac{z-1}{2} \\\\ x-3=\\frac{2-y}{4}=\\frac{z-1}{2}\\end{aligned}\n$$" 13194139534962 true] [17592186322836 1000 #edb/ref 17592186322837 13194139534962 true] [17592186322836 1000 #edb/ref 17592186322838 13194139534962 true] [17592186322836 1000 #edb/ref 17592186322839 13194139534962 true] [17592186322836 1000 #edb/ref 17592186322840 13194139534962 true] [17592186322836 1000 #edb/ref 17592186322841 13194139534962 true] [17592186322836 1040 #edb/ref 17592186045450 13194139534962 true] [17592186322836 1041 "selection" 13194139534962 true] [17592186322836 1104 #edb/ref 17592186322837 13194139534962 true] [17592186322836 1110 #uuid "dc6c54c0-de64-5467-8fc5-cd3d04fffd8c" 13194139534962 true] [17592186322837 1034 "x-3=\\frac{2-y}{4}=\\frac{z-1}{2}" 13194139534962 true] [17592186322837 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322837 1111 #uuid "5ad2e308-0172-5965-bc1e-c9c18b0b865e" 13194139534962 true] [17592186322838 1034 "x-3=\\frac{y-2}{2}=z-1" 13194139534962 true] [17592186322838 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322838 1111 #uuid "38bfb6ef-3482-5d6a-a1b0-e709ff632cd6" 13194139534962 true] [17592186322839 1034 "\\frac{x-1}{4}=2-y=z-1" 13194139534962 true] [17592186322839 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322839 1111 #uuid "5333a7d8-85cc-5693-9601-3061dfb5c0e8" 13194139534962 true] [17592186322840 1034 "x-1=y-2=z-1" 13194139534962 true] [17592186322840 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322840 1111 #uuid "3460f4fc-6ff3-5068-b7ef-fc30163f8d5d" 13194139534962 true] [17592186322841 1034 "\\frac{x-3}{2}=\\frac{y-2}{4}=z-1" 13194139534962 true] [17592186322841 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322841 1111 #uuid "4b4fbd61-de16-537b-9bbc-326274088