}})\\,k \\\\  & =\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\text{ }i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\text{ }j+\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\text{ }k \\\\ ∇f(3,4,0) & =\\frac{3}{\\sqrt{(3)^{2}+(4)^{2}+(0)^{2}}}\\,i+\\frac{4}{\\sqrt{(3)^{2}+(4)^{2}+(0)^{2}}}\\,j+\\frac{0}{\\sqrt{(3)^{2}+(4)^{2}+(0)^{2}}}\\,k \\\\  & =\\frac{3}{5}\\,i+\\frac{4}{5}\\,j\\end{aligned}\n$$\n\nTherefore, $\\frac{3}{5}\\,i+\\frac{4}{5}\\,j$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(3,4,0).$" 13194139534962 true] [17592186322906 1000 #edb/ref 17592186322907 13194139534962 true] [17592186322906 1000 #edb/ref 17592186322908 13194139534962 true] [17592186322906 1000 #edb/ref 17592186322909 13194139534962 true] [17592186322906 1000 #edb/ref 17592186322910 13194139534962 true] [17592186322906 1000 #edb/ref 17592186322911 13194139534962 true] [17592186322906 1040 #edb/ref 17592186045450 13194139534962 true] [17592186322906 1041 "selection" 13194139534962 true] [17592186322906 1104 #edb/ref 17592186322908 13194139534962 true] [17592186322906 1110 #uuid "1f5139e1-3e95-5995-bd4b-183d75f51bbf" 13194139534962 true] [17592186322907 1034 "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j+\\frac{1}{5}\\,k" 13194139534962 true] [17592186322907 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322907 1111 #uuid "284705cf-7f83-5939-969d-22a99241f89b" 13194139534962 true] [17592186322908 1034 "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j" 13194139534962 true] [17592186322908 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322908 1111 #uuid "7f1f799e-db9d-5c73-a4a1-224f1c576c9b" 13194139534962 true] [17592186322909 1034 "\\frac{4}{5}\\,i+\\frac{3}{5}\\,j" 13194139534962 true] [17592186322909 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322909 1111 #uuid "33c5cc2f-2427-5162-ac48-6203e88fbc02" 13194139534962 true] [17592186322910 1034 "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j+k" 13194139534962 true] [17592186322910 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322910 1111 #uuid "86bf8ff9-336b-5fb4-b096-6bd1e8a049c1" 13194139534962 true] [17592186322911 1034 "i+j" 13194139534962 true] [17592186322911 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322911 1111 #uuid "ae30582f-9357-5179-88b3-13d72c5a56b9" 13194139534962 true] [17592186322912 1017 #edb/ref 17592186322913 13194139534962 true] [17592186322912 1089 "q-71404" 13194139534962 true] [17592186322912 1091 #edb/ref 17592186045463 13194139534962 true] [17592186322912 1100 "For the function $f(x,y,z)=\\operatorname{ln}⁡({z}^{2}-xy)-yz$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-2,0).$" 13194139534962 true] [17592186322912 1113 #uuid "252876c9-7962-5371-8168-be2f8e38a47f" 13194139534962 true] [17592186322912 1145 "A normal vector to the level surface that passes through the point where $(x,y,z)=(1,-2,0)$ can be found by computing \n$∇f(1,-2,0).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(1,-2,0):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡({z}^{2}-xy)-yz)\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡({z}^{2}-xy)-yz)\\,j+\\frac{∂}{∂z}(\\operatorname{ln}⁡({z}^{2}-xy)-yz)\\,k \\\\  & =-\\frac{y}{{z}^{2}-xy}\\text{ }i+(-\\frac{x}{{z}^{2}-xy}-z)\\text{ }j+(\\frac{2z}{{z}^{2}-xy}-y)\\text{ }k \\\\ ∇f(1,-2,0) & =-\\frac{(-2)}{(0)^{2}-(1)(-2)}\\,i+(-\\frac{1}{(0)^{2}-(1)(-2)}-0)\\,j+(\\frac{2(0)}{(0)^{2}-(1)(-2)}-(-2))\\,k \\\\  & =i-\\frac{1}{2}\\,j+2\\,k\\end{aligned}\n$$\n\nTherefore, $i-\\frac{1}{2}\\,j+2\\,k$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-2,0).$" 13194139534962 true] [17592186322913 1000 #edb/ref 17592186322914 13194139534962 true] [17592186322913 1000 #edb/ref 17592186322915 13194139534962 true] [17592186322913 1000 #edb/ref 17592186322916 13194139534962 true] [17592186322913 1000 #edb/ref 17592186322917 13194139534962 true] [17592186322913 1000 #edb/ref 17592186322918 13194139534962 true] [17592186322913 1040 #edb/ref 17592186045450 13194139534962 true] [17592186322913 1041 "selection" 13194139534962 true] [17592186322913 1104 #edb/ref 17592186322915 13194139534962 true] [17592186322913 1110 #uuid "562cd7b1-d727-50b2-a1ea-c88c6cae0079" 13194139534962 true] [17592186322914 1034 "i-2\\,j+2\\,k" 13194139534962 true] [17592186322914 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322914 1111 #uuid "b661a14d-a933-5390-bb18-a029d3af2e59" 13194139534962 true] [17592186322915 1034 "i-\\frac{1}{2}\\,j+2\\,k" 13194139534962 true] [17592186322915 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322915 1111 #uuid "53936b14-19a2-5bfa-af0e-04c4b4cd09f9" 13194139534962 true] [17592186322916 1034 "i-\\frac{1}{2}\\,j+\\frac{1}{2}\\,k" 13194139534962 true] [17592186322916 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322916 1111 #uuid "36587ced-e94f-583d-9084-b6d5de04bc55" 13194139534962 true] [17592186322917 1034 "i-\\frac{1}{2}\\,j" 13194139534962 true] [17592186322917 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322917 1111 #uuid "4603d4c4-f0dc-50db-b1e8-6e7f9d0b518d" 13194139534962 true] [17592186322918 1034 "-i-\\frac{1}{2}\\,j+2\\,k" 13194139534962 true] [17592186322918 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322918 1111 #uuid "f7a618f1-370f-58a0-9ad4-7625b95d0d34" 13194139534962 true] [17592186322919 1017 #edb/ref 17592186322920 13194139534962 true] [17592186322919 1089 "q-71411" 13194139534962 true] [17592186322919 1091 #edb/ref 17592186045464 13194139534962 true] [17592186322919 1100 "Find the equation of the normal line to the surface $3{x}^{2}-xz=6-3xyz$ at the point $(1,0,-3).$" 13194139534962 true] [17592186322919 1113 #uuid "13503954-2456-5c13-9c01-1b77ab4bd258" 13194139534962 true] [17592186322919 1145 "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}3{x}^{2}-xz & =6-3xyz \\\\ 3{x}^{2}-xz+3xyz & =6\\end{aligned}\n$$\n\nIf we set $f(x,y,z)=3{x}^{2}-xz+3xyz$, our surface can be viewed as the level surface $f(x,y,z)=6.$ \n\nA normal vector to the level surface that passes through the point $(1,0,-3)$ can be found by computing $∇f(1,0,-3).$ \n\nSo, we find the gradient and evaluate it at $(1,0,-3):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(3{x}^{2}-xz+3xyz)i+\\frac{∂}{∂y}(3{x}^{2}-xz+3xyz)j+\\frac{∂}{∂z}(3{x}^{2}-xz+3xyz)k \\\\  & =(6x-z+3yz)\\text{ }i+3xz\\text{ }j+(-x+3xy)\\text{ }k \\\\ ∇f(1,0,-3) & =(6(1)-(-3)+3(0)(-3))\\text{ }i+3(1)(-3)\\text{ }j+(-1+3(1)(0))\\text{ }k \\\\  & =9\\,i-9\\,j-k \\\\  & =⟨9,-9,-1⟩\\end{aligned}\n$$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y},{v}_{z}⟩$ and passes through the point $({x}_{0},{y}_{0},{z}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}}=\\frac{y-{y}_{0}}{{v}_{y}}=\\frac{z-{z}_{0}}{{v}_{z}} \\\\ \\frac{x-1}{9}=\\frac{y-0}{-9}=\\frac{z-(-3)}{-1} \\\\ \\frac{x-1}{9}=\\frac{y}{-9}=\\frac{z+3}{-1}\\end{aligned}\n$$" 13194139534962 true] [17592186322920 1000 #edb/ref 17592186322921 13194139534962 true] [17592186322920 1000 #edb/ref 17592186322922 13194139534962 true] [17592186322920 1000 #edb/ref 17592186322923 13194139534962 true] [17592186322920 1000 #edb/ref 17592186322924 13194139534962 true] [17592186322920 1000 #edb/ref 17592186322925 13194139534962 true] [17592186322920 1040 #edb/ref 17592186045450 13194139534962 true] [17592186322920 1041 "selection" 13194139534962 true] [17592186322920 1104 #edb/ref 17592186322921 13194139534962 true] [17592186322920 1110 #uuid "8fba1b21-948c-5932-a272-2a0adb408b66" 13194139534962 true] [17592186322921 1034 "\\frac{x-1}{9}=\\frac{y}{-9}=\\frac{z+3}{-1}" 13194139534962 true] [17592186322921 1103 #edb/ref 17592186045453 13194139534962 true] [17592186322921 1111 #uuid "e460517d-1510-58a0-8403-99223a713357" 1319