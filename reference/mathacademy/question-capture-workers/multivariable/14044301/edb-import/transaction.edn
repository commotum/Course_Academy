[{:db/id "q-71370/selection/d6f6f774a3fe5baa3f0c508dd450ec41662b59af05cea70e2ae2e8ef6c03843c" :answer/id #uuid "e852efe3-72f8-5736-83dc-fc084f0e22a0" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}(i-j)" :db/ensure [:answer/validate]} {:db/id "q-71370/selection/bbd0d8496212cc4d13ce50b6b4a208543163fc14693461fa683ab36ce15d08ef" :answer/id #uuid "64f37d83-d4cf-5e04-9d05-325abb088252" :answer/type :answer.type/math :answer/value "-j" :db/ensure [:answer/validate]} {:db/id "q-71370/selection/88d224dfd34c81ac88c26a4bd5fad24de2386c92bf710fc39e2dff993d1a9cc0" :answer/id #uuid "b2914b8f-3b1d-5733-b9d1-f96355fa5898" :answer/type :answer.type/math :answer/value "-\\frac{\\sqrt{2}}{2}(i+j)" :db/ensure [:answer/validate]} {:db/id "q-71370/selection/964d2609940cd8ebb0adfac60329ff7eb819ba1ceecfafb7ef143acb1261660e" :answer/id #uuid "a76b5dfd-675c-5091-8bdc-5803cfeb4ec3" :answer/type :answer.type/math :answer/value "-\\frac{1}{2}(i-j)" :db/ensure [:answer/validate]} {:db/id "q-71370/selection/34cb813ca5b9e6846e2d63dd1259440d06f343deabcfba6c071a88785c3a5629" :answer/id #uuid "a0c2ac5d-00c4-5b64-af2a-e38153ef1eab" :answer/type :answer.type/math :answer/value "i" :db/ensure [:answer/validate]} {:db/id "q-71370/selection" :answer-field/id #uuid "a092e732-a318-5062-8c19-916e15592195" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71370/selection/d6f6f774a3fe5baa3f0c508dd450ec41662b59af05cea70e2ae2e8ef6c03843c" :answer-field/choices ["q-71370/selection/d6f6f774a3fe5baa3f0c508dd450ec41662b59af05cea70e2ae2e8ef6c03843c" "q-71370/selection/bbd0d8496212cc4d13ce50b6b4a208543163fc14693461fa683ab36ce15d08ef" "q-71370/selection/88d224dfd34c81ac88c26a4bd5fad24de2386c92bf710fc39e2dff993d1a9cc0" "q-71370/selection/964d2609940cd8ebb0adfac60329ff7eb819ba1ceecfafb7ef143acb1261660e" "q-71370/selection/34cb813ca5b9e6846e2d63dd1259440d06f343deabcfba6c071a88785c3a5629"] :db/ensure [:answer-field/validate]} {:db/id "q-71370" :question/id #uuid "35cbb02b-fbbb-5866-807d-249aebeee809" :question/math-academy-id "q-71370" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)={x}^{2}+{y}^{2}$ that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2}).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(-\\frac{1}{2},\\frac{1}{2})$, can be found by computing $∇f(-\\frac{1}{2},\\frac{1}{2}).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\text{ }i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\text{ }j \\\\  & =2x\\text{ }i+2y\\text{ }j \\\\ ∇f(-\\frac{1}{2},\\frac{1}{2}) & =2(-\\frac{1}{2})\\text{ }i+2(\\frac{1}{2})\\text{ }j \\\\  & =-i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(-\\frac{1}{2},\\frac{1}{2}):$\n\n$$\n\\begin{aligned}\\frac{∇f(-\\frac{1}{2},\\frac{1}{2})}{‖∇f(-\\frac{1}{2},\\frac{1}{2})‖} & =\\frac{-i+j}{\\sqrt{(-1)^{2}+(1)^{2}}} \\\\  & =\\frac{-i+j}{\\sqrt{2}} \\\\  & =-\\frac{\\sqrt{2}}{2}(i-j)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71370/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5baf28d-c2c0-57bd-9433-c47043009f0d"] :knowledge-point/questions ["q-71370"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36346/selection/e2800d65efa2eaf1264a3f0c636c02d08ad08727943f98a15cc84e6d46737672" :answer/id #uuid "e736087a-af37-5928-b3b6-f2fe59eb6150" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/ensure [:answer/validate]} {:db/id "q-36346/selection/6c9bc5caa6c5509c1db6732974e950d4b489440208bf10964be7f5fd5f6aba42" :answer/id #uuid "4b203659-212c-5753-890d-57b8b9e5dd90" :answer/type :answer.type/math :answer/value "\\sqrt{3}(i+j)" :db/ensure [:answer/validate]} {:db/id "q-36346/selection/7da76d2a3e8ee5c91e64bda4eb1ff2fedd52a3c3fc7b4864b46c9d8182c0b85b" :answer/id #uuid "be40c5ad-4683-5f9c-b462-7c98131f72c7" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{3}}{2}(i-j)" :db/ensure [:answer/validate]} {:db/id "q-36346/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" :answer/id #uuid "eb8d721c-780d-5519-9582-b87d53c57a47" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/ensure [:answer/validate]} {:db/id "q-36346/selection/b6144f969338f1e60ba8e079cdbdcfb032baa75af373ede0f30515b185d9fcb2" :answer/id #uuid "a6ebd713-fd46-50cc-a358-f66b4b495bd5" :answer/type :answer.type/math :answer/value "i+j" :db/ensure [:answer/validate]} {:db/id "q-36346/selection" :answer-field/id #uuid "4915e457-0135-5dc0-abea-959ebd4f897c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36346/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" :answer-field/choices ["q-36346/selection/e2800d65efa2eaf1264a3f0c636c02d08ad08727943f98a15cc84e6d46737672" "q-36346/selection/6c9bc5caa6c5509c1db6732974e950d4b489440208bf10964be7f5fd5f6aba42" "q-36346/selection/7da76d2a3e8ee5c91e64bda4eb1ff2fedd52a3c3fc7b4864b46c9d8182c0b85b" "q-36346/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" "q-36346/selection/b6144f969338f1e60ba8e079cdbdcfb032baa75af373ede0f30515b185d9fcb2"] :db/ensure [:answer-field/validate]} {:db/id "q-36346" :question/id #uuid "abb67c02-615f-59af-8d9d-5f7f6c913b9a" :question/math-academy-id "q-36346" :question/problem "Find a unit normal vector to the level curve of the function $g(x,y)=\\operatorname{ln}⁡(xy)$ that passes through the point where $(x,y)=(1,1).$" :question/worked-solution "A normal vector to the level curve that passes through the point  where $(x,y)=(1,1)$, can be found by computing $∇g(1,1).$ \n\nSo, we first find the gradient of $g(x,y)$ and evaluate it at $(x,y)=(1,1):$ \n\n$$\n\\begin{aligned}∇g(x,y) & ={g}_{x}(x,y)\\,i+{g}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(xy))\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(xy))\\,j \\\\  & =\\frac{1}{xy}\\cdot y\\,i+\\frac{1}{xy}\\cdot x\\,j \\\\  & =\\frac{1}{x}\\,i+\\frac{1}{y}\\,j \\\\ ∇g(1,1) & =\\frac{1}{(1)}\\,i+\\frac{1}{(1)}\\,j \\\\  & =i+j\\end{aligned}\n$$\n\nFinally, we normalize $∇g(1,1):$\n\n$$\n\\begin{aligned}\\frac{∇g(1,1)}{‖∇g(1,1)‖} & =\\frac{i+j}{\\sqrt{{1}^{2}+{1}^{2}}} \\\\  & =\\frac{\\sqrt{2}}{2}(i+j)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-36346/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5baf28d-c2c0-57bd-9433-c47043009f0d"] :knowledge-point/questions ["q-36346"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130271/selection/bbd0d8496212cc4d13ce50b6b4a208543163fc14693461fa683ab36ce15d08ef" :answer/id #uuid "5584c912-1c0c-54a6-9fdf-5f244c2f54e1" :answer/type :answer.type/math :answer/value "-j" :db/ensure [:answer/validate]} {:db/id "q-130271/selection/e2800d65efa2eaf1264a3f0c636c02d08ad08727943f98a15cc84e6d46737672" :answer/id #uuid "7ef773d5-ffa7-519e-8b79-fb00aab7d750" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/ensure [:answer/validate]} {:db/id "q-130271/selection/446cc2edc00789058b8f11a1ce8c36a14fd1496b83d8dadfe0cc81c84d5b130c" :answer/id #uuid "f2f0fb4d-0acc-569d-889a-cccf1bebadd8" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}(2\\,i+j)" :db/ensure [:answer/validate]} {:db/id "q-130271/selection/67fbe0ceaf8ff031d87cb29f0dd4a65306e6c569a8cf2ea6ebaf1ed9c2105735" :answer/id #uuid "8f366a3d-1d2f-506e-8ff1-34312d66b8ff" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}(i+2\\,j)" :db/ensure [:answer/validate]} {:db/id "q-130271/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" :answer/id #uuid "e91dcffa-a379-583e-8af0-c9b6ddd4d440" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/ensure [:answer/validate]} {:db/id "q-130271/selection" :answer-field/id #uuid "93cba9eb-79c6-5b9c-a730-75a63e909d17" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130271/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" :answer-field/choices ["q-130271/selection/bbd0d8496212cc4d13ce50b6b4a208543163fc14693461fa683ab36ce15d08ef" "q-130271/selection/e2800d65efa2eaf1264a3f0c636c02d08ad08727943f98a15cc84e6d46737672" "q-130271/selection/446cc2edc00789058b8f11a1ce8c36a14fd1496b83d8dadfe0cc81c84d5b130c" "q-130271/selection/67fbe0ceaf8ff031d87cb29f0dd4a65306e6c569a8cf2ea6ebaf1ed9c2105735" "q-130271/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe"] :db/ensure [:answer-field/validate]} {:db/id "q-130271" :question/id #uuid "2f1b31d1-29e5-5e40-8e1d-c102a9bf9bc8" :question/math-academy-id "q-130271" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=\\sqrt{x}+2\\sqrt{y}$ that passes through the point where $(x,y)=(1,4).$" :question/worked-solution "A normal vector to the level curve that passes through the point $(x,y)=(1,4)$ can be found by computing $∇f(1,4).$ \n\nSo, we first find the gradient and evaluate it at $(x,y)=(1,4):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\sqrt{x}+2\\sqrt{y})\\,i+\\frac{∂}{∂y}(\\sqrt{x}+2\\sqrt{y})\\,j \\\\  & =\\frac{1}{2\\sqrt{x}}\\,i+\\frac{1}{\\sqrt{y}}\\,j \\\\ ∇f(1,4) & =\\frac{1}{2\\sqrt{1}}\\,i+\\frac{1}{\\sqrt{4}}\\,j \\\\  & =\\frac{1}{2}\\,i+\\frac{1}{2}\\,j \\\\  & =\\frac{1}{2}(i+j)\\end{aligned}\n$$\n\nFinally, we normalize $∇f(1,4):$\n\n$$\n\\begin{aligned}\\frac{∇f(1,4)}{‖∇f(1,4)‖} & =\\frac{\\frac{1}{2}(i+j)}{‖\\frac{1}{2}(i+j)‖} \\\\  & =\\frac{1}{(\\frac{1}{2}\\sqrt{{1}^{2}+{1}^{2}})}\\cdot \\frac{1}{2}(i+j) \\\\  & =\\frac{1}{\\sqrt{2}}(i+j) \\\\  & =\\frac{\\sqrt{2}}{2}(i+j).\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130271/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5baf28d-c2c0-57bd-9433-c47043009f0d"] :knowledge-point/questions ["q-130271"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71381/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" :answer/id #uuid "c064d1d2-4af5-5177-8d42-dc0519437209" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(i+j)" :db/ensure [:answer/validate]} {:db/id "q-71381/selection/e2800d65efa2eaf1264a3f0c636c02d08ad08727943f98a15cc84e6d46737672" :answer/id #uuid "cd6a792f-55d4-52de-a9ea-9179d7f9c8aa" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}}{2}(i-j)" :db/ensure [:answer/validate]} {:db/id "q-71381/selection/34cb813ca5b9e6846e2d63dd1259440d06f343deabcfba6c071a88785c3a5629" :answer/id #uuid "f1d89805-37e1-5010-ace2-e1d14950134c" :answer/type :answer.type/math :answer/value "i" :db/ensure [:answer/validate]} {:db/id "q-71381/selection/c918677c2f02e59874c54c04e2b4bd6eac89cc7bb5641295b62cabb05e6df3c3" :answer/id #uuid "6d32b96f-3d87-509b-bdc5-aba4a32f34b2" :answer/type :answer.type/math :answer/value "j" :db/ensure [:answer/validate]} {:db/id "q-71381/selection/4d78a3e061c8b362f577422699d3a704e48739f5470530beaf87292a9836c4f0" :answer/id #uuid "6a14d68d-0419-5d63-a147-890caadd27f2" :answer/type :answer.type/math :answer/value "\\frac{1}{2}(i-j)" :db/ensure [:answer/validate]} {:db/id "q-71381/selection" :answer-field/id #uuid "7862f7d6-5bab-559c-805c-5d9bfd1fb8bc" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71381/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" :answer-field/choices ["q-71381/selection/78e89f3482f1be057e2f14909b5cac318c341986f11dace15c588f8d1572bebe" "q-71381/selection/e2800d65efa2eaf1264a3f0c636c02d08ad08727943f98a15cc84e6d46737672" "q-71381/selection/34cb813ca5b9e6846e2d63dd1259440d06f343deabcfba6c071a88785c3a5629" "q-71381/selection/c918677c2f02e59874c54c04e2b4bd6eac89cc7bb5641295b62cabb05e6df3c3" "q-71381/selection/4d78a3e061c8b362f577422699d3a704e48739f5470530beaf87292a9836c4f0"] :db/ensure [:answer-field/validate]} {:db/id "q-71381" :question/id #uuid "1d803c55-9de5-5306-b06d-dcf79c8f1239" :question/math-academy-id "q-71381" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)={e}^{x+y}+x+y$ that passes through the point where $(x,y)=(0,0).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(0,0)$, can be found by computing $∇f(0,0).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(0,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}({e}^{x+y}+x+y)\\text{ }i+\\frac{∂}{∂y}({e}^{x+y}+x+y)\\text{ }j \\\\  & =({e}^{x+y}+1)\\text{ }i+({e}^{x+y}+1)\\text{ }j \\\\ ∇f(0,0) & =({e}^{0+0}+1)\\text{ }i+({e}^{0+0}+1)\\text{ }j \\\\  & =2i+2j\\end{aligned}\n$$\n\nFinally, we normalize $∇f(0,0):$\n\n$$\n\\begin{aligned}\\frac{∇f(0,0)}{‖∇f(0,0)‖} & =\\frac{2i+2j}{\\sqrt{(2)^{2}+(2)^{2}}} \\\\  & =\\frac{2i+2j}{2\\sqrt{2}} \\\\  & =\\frac{\\sqrt{2}}{2}(i+j)\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71381/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5baf28d-c2c0-57bd-9433-c47043009f0d"] :knowledge-point/questions ["q-71381"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71374/selection/bbd0d8496212cc4d13ce50b6b4a208543163fc14693461fa683ab36ce15d08ef" :answer/id #uuid "5f16aa08-0ffb-5576-a013-105e8815def8" :answer/type :answer.type/math :answer/value "-j" :db/ensure [:answer/validate]} {:db/id "q-71374/selection/98a4dec07a60103391468deaf8da712fe71a07cd597b9046c26926dc9621a1f5" :answer/id #uuid "ec8fd65d-cc05-55fb-b7a6-febe1130e963" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{5}}{5}(-2i+i)" :db/ensure [:answer/validate]} {:db/id "q-71374/selection/39388d0e9d2a5c7cadf61a6bf6a3f9b2ecd6535c23a168d62deb24a14bfd2c1e" :answer/id #uuid "766a7df1-dceb-55f3-b31e-96dbf9a2de47" :answer/type :answer.type/math :answer/value "i+i" :db/ensure [:answer/validate]} {:db/id "q-71374/selection/030478b7fe4e1f88e63544674b92b15ab982abb0d454ef6c01549a22baf51d80" :answer/id #uuid "4a9b5524-57a1-50cf-819b-89fae0bdfe82" :answer/type :answer.type/math :answer/value "-i" :db/ensure [:answer/validate]} {:db/id "q-71374/selection/cd57c04d9bd06efd543024e020808cc7af5b93f0d03099db024dd768f44c2dd4" :answer/id #uuid "64273e28-93b8-5d0c-b07b-4408adc98a31" :answer/type :answer.type/math :answer/value "i-i" :db/ensure [:answer/validate]} {:db/id "q-71374/selection" :answer-field/id #uuid "f4663a9e-16c1-5c93-b572-852a5a36232e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71374/selection/030478b7fe4e1f88e63544674b92b15ab982abb0d454ef6c01549a22baf51d80" :answer-field/choices ["q-71374/selection/bbd0d8496212cc4d13ce50b6b4a208543163fc14693461fa683ab36ce15d08ef" "q-71374/selection/98a4dec07a60103391468deaf8da712fe71a07cd597b9046c26926dc9621a1f5" "q-71374/selection/39388d0e9d2a5c7cadf61a6bf6a3f9b2ecd6535c23a168d62deb24a14bfd2c1e" "q-71374/selection/030478b7fe4e1f88e63544674b92b15ab982abb0d454ef6c01549a22baf51d80" "q-71374/selection/cd57c04d9bd06efd543024e020808cc7af5b93f0d03099db024dd768f44c2dd4"] :db/ensure [:answer-field/validate]} {:db/id "q-71374" :question/id #uuid "a90575bd-9679-58ea-a060-e33293c63f93" :question/math-academy-id "q-71374" :question/problem "Find a unit normal vector to the level curve of the function $f(x,y)=x+3y-2xy$ that passes through the point where $(x,y)=(\\frac{3}{2},1).$" :question/worked-solution "A normal vector to the level curve that passes through the point where $(x,y)=(\\frac{3}{2},1)$, can be found by computing $∇f(\\frac{3}{2},1).$ \n\nSo, we first find the gradient of $f(x,y)$ and evaluate it at $(x,y)=(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}∇f(x,y) & =\\frac{∂}{∂x}(x+3y-2xy)\\text{ }i+\\frac{∂}{∂y}(x+3y-2xy)\\text{ }j \\\\  & =(1-2y)\\text{ }i+(3-2x)\\text{ }j \\\\ ∇f(\\frac{3}{2},1) & =(1-2(1))\\text{ }i+(3-2(\\frac{3}{2}))\\text{ }j \\\\  & =-i\\end{aligned}\n$$\n\nFinally, we normalize $∇f(\\frac{3}{2},1):$\n\n$$\n\\begin{aligned}\\frac{∇f(\\frac{3}{2},1)}{‖∇f(\\frac{3}{2},1)‖} & =\\frac{-i}{1}=-i\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71374/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "d5baf28d-c2c0-57bd-9433-c47043009f0d"] :knowledge-point/questions ["q-71374"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71393/selection/ad492acf4d79a6ea7aa0203149bfc4286737ea5dc7be93273c728a89850f94b8" :answer/id #uuid "89dd655b-7b38-5bd8-81de-533157f67d36" :answer/type :answer.type/math :answer/value "x+2y-2=0" :db/ensure [:answer/validate]} {:db/id "q-71393/selection/7d8fb94126d69f730424827f37aac72b08cd4dcd396242b3a46919273409edbd" :answer/id #uuid "18d09da2-9bce-56c8-a1a4-55b504f62940" :answer/type :answer.type/math :answer/value "x+y+1=0" :db/ensure [:answer/validate]} {:db/id "q-71393/selection/edc82e1e61b935998ff6b38c10d5a16d5c94d7dd86ada8560ff6f4ca38aaa74b" :answer/id #uuid "c3ee9e81-b6aa-5e6a-b52e-11cb81eca412" :answer/type :answer.type/math :answer/value "x-y+1=0" :db/ensure [:answer/validate]} {:db/id "q-71393/selection/aafcb3e5284b08d0e7601c8ebd533ff879625d8dfad810badf24d1a1cbc643a2" :answer/id #uuid "df01a1e5-2f92-5dbf-93b6-07ba00c5251b" :answer/type :answer.type/math :answer/value "x+y-1=0" :db/ensure [:answer/validate]} {:db/id "q-71393/selection/2e1123aa9a3a4ebb616be1aefb45aa44a0a81226cc48f7c7e5d13565756dc3dc" :answer/id #uuid "0e3c6c1d-ae7a-50f0-970e-12603e07e9db" :answer/type :answer.type/math :answer/value "-x+y-1=0" :db/ensure [:answer/validate]} {:db/id "q-71393/selection" :answer-field/id #uuid "bb18e819-5242-5710-986b-75ec6fb8fe7e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71393/selection/aafcb3e5284b08d0e7601c8ebd533ff879625d8dfad810badf24d1a1cbc643a2" :answer-field/choices ["q-71393/selection/ad492acf4d79a6ea7aa0203149bfc4286737ea5dc7be93273c728a89850f94b8" "q-71393/selection/7d8fb94126d69f730424827f37aac72b08cd4dcd396242b3a46919273409edbd" "q-71393/selection/edc82e1e61b935998ff6b38c10d5a16d5c94d7dd86ada8560ff6f4ca38aaa74b" "q-71393/selection/aafcb3e5284b08d0e7601c8ebd533ff879625d8dfad810badf24d1a1cbc643a2" "q-71393/selection/2e1123aa9a3a4ebb616be1aefb45aa44a0a81226cc48f7c7e5d13565756dc3dc"] :db/ensure [:answer-field/validate]} {:db/id "q-71393" :question/id #uuid "4e876b2a-993c-5d99-82f5-7108f1c93929" :question/math-academy-id "q-71393" :question/problem "Consider the plane curve $\\operatorname{ln}⁡(x+y)=2xy.$  Find the equation of the normal line to the curve at the point $(0,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\operatorname{ln}⁡(x+y) & =2xy \\\\ \\operatorname{ln}⁡(x+y)-2xy & =0\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\operatorname{ln}⁡(x+y)-2xy$, our curve can be viewed as the level curve $f(x,y)=0.$  \n\nA normal vector to the level curve that passes through the point $(0,1)$ can be found by computing $∇f(0,1).$ \n\nSo, we find the gradient and evaluate it at $(0,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\operatorname{ln}⁡(x+y)-2xy)\\,i+\\frac{∂}{∂y}(\\operatorname{ln}⁡(x+y)-2xy)\\,j \\\\  & =(\\frac{1}{x+y}-2y)\\,i+(\\frac{1}{x+y}-2x)\\,j \\\\ ∇f(0,1) & =(\\frac{1}{0+1}-2(1))\\,i+(\\frac{1}{0+1}-2(0))\\,j \\\\  & =-i+j \\\\  & =⟨-1,1⟩\\end{aligned}\n$$\n\nHence, $∇f(0,1)=⟨-1,1⟩$ is a normal vector to the curve at $(0,1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-0}{-1} & =\\frac{y-1}{1} \\\\ -x & =y-1 \\\\ x+y-1 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71393/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2f7fab-cebe-519a-83e3-a0831cac289d"] :knowledge-point/questions ["q-71393"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36347/selection/e03cb2b7e9a899936d5fb7de5a195a11ba6aa1c7861ded09e00842720b57de86" :answer/id #uuid "0916672c-7c4b-5a17-8048-77cbb5ef1202" :answer/type :answer.type/math :answer/value "-20x+7y+181=0" :db/ensure [:answer/validate]} {:db/id "q-36347/selection/1b1640e504007b1c3acb5666b9c59b5cf6f78e5194085c32e75dcb2ae3580762" :answer/id #uuid "a78db14b-f527-5d32-9140-a7d7fd3a0a19" :answer/type :answer.type/math :answer/value "-20x+7y+28=0" :db/ensure [:answer/validate]} {:db/id "q-36347/selection/384cfae1a6dda0450032469acbb95af68042f60de7a3fa18bfdc04497bbddef4" :answer/id #uuid "c9297e72-1bc1-576b-a092-063e0274183a" :answer/type :answer.type/math :answer/value "20x+7y+181=0" :db/ensure [:answer/validate]} {:db/id "q-36347/selection/d7fde5b1ccd378869ef4398280da1c84a51453479bbe63d090ab2a8c9e52d4f9" :answer/id #uuid "20a6c3bd-a054-53bd-9821-f41e7a506721" :answer/type :answer.type/math :answer/value "20x+7y-139=0" :db/ensure [:answer/validate]} {:db/id "q-36347/selection/031bbb58160f424e6a9675dc03a155ebdc66a70ed791bf9d52001c199077c882" :answer/id #uuid "1ef299fd-3808-54bd-9ffb-077cd2b50837" :answer/type :answer.type/math :answer/value "-20x-7y+181=0" :db/ensure [:answer/validate]} {:db/id "q-36347/selection" :answer-field/id #uuid "aec70da3-a71a-537a-8116-95cc5283e8dd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36347/selection/e03cb2b7e9a899936d5fb7de5a195a11ba6aa1c7861ded09e00842720b57de86" :answer-field/choices ["q-36347/selection/e03cb2b7e9a899936d5fb7de5a195a11ba6aa1c7861ded09e00842720b57de86" "q-36347/selection/1b1640e504007b1c3acb5666b9c59b5cf6f78e5194085c32e75dcb2ae3580762" "q-36347/selection/384cfae1a6dda0450032469acbb95af68042f60de7a3fa18bfdc04497bbddef4" "q-36347/selection/d7fde5b1ccd378869ef4398280da1c84a51453479bbe63d090ab2a8c9e52d4f9" "q-36347/selection/031bbb58160f424e6a9675dc03a155ebdc66a70ed791bf9d52001c199077c882"] :db/ensure [:answer-field/validate]} {:db/id "q-36347" :question/id #uuid "2d72ff87-4a08-5245-b75d-f9edd1a5315d" :question/math-academy-id "q-36347" :question/problem "Consider the plane curve $2xy+6{y}^{2}=x-2.$  Find the equation of the normal line to the curve at the point $(8,-3).$" :question/worked-solution "First, we bring all variables to one side: \n\n$$\n\\begin{aligned}2xy+6{y}^{2} & =x-2 \\\\ 2xy+6{y}^{2}-x & =-2\\end{aligned}\n$$\n\nIf we set $f(x,y)=2xy+6{y}^{2}-x$, our curve can be viewed as the level curve $f(x,y)=-2.$   \n\nA normal vector to the level curve that passes through the point $(8,-3)$ can be found by computing $∇f(8,-3).$ \n\nSo, we find the gradient and evaluate it at $(8,-3):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(2xy+6{y}^{2}-x)\\,i+\\frac{∂}{∂y}(2xy+6{y}^{2}-x)\\,j \\\\  & =(2y-1)\\,i+(2x+12y)\\,j \\\\ ∇f(8,-3) & =(2(-3)-1)\\,i+(2(8)+12(-3))\\,j \\\\  & =-7\\,i-20\\,j \\\\  & =⟨-7,-20⟩\\end{aligned}\n$$\n\n Hence, $∇f(8,-3)=⟨-7,-20⟩$ is a normal vector to the curve at $(8,-3).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as: \n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-8}{-7} & =\\frac{y-(-3)}{-20} \\\\ -20(x-8) & =-7(y+3) \\\\ -20x+7y+160+21 & =0 \\\\ -20x+7y+181 & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-36347/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2f7fab-cebe-519a-83e3-a0831cac289d"] :knowledge-point/questions ["q-36347"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36339"] :question/problem "Consider the plane curve $6xy=5{x}^{2}+{y}^{2}.$  Find the equation of the normal line to the curve at the point $(1,1).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}6xy & =5{x}^{2}+{y}^{2} \\\\ 0 & =5{x}^{2}+{y}^{2}-6xy\\end{aligned}\n$$\n\nIf we set $f(x,y)=5{x}^{2}+{y}^{2}-6xy$, our curve can be viewed as the level curve $f(x,y)=0.$  \n\nA normal vector to the level curve that passes through the point $(1,1)$ can be found by computing $∇f(1,1).$ \n\nSo, we find the gradient and evaluate it at $(1,1):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(5{x}^{2}+{y}^{2}-6xy)\\,i+\\frac{∂}{∂y}(5{x}^{2}+{y}^{2}-6xy)\\,j \\\\  & =(10x-6y)\\,i+(2y-6x)\\,j \\\\ ∇f(1,1) & =(10-6(1))\\,i+(2(1)-6)\\,j \\\\  & =4\\,i-4\\,j \\\\  & =⟨4,-4⟩\\end{aligned}\n$$\n\nHence, $∇f(1,1)=⟨4,-4⟩$ is a normal vector to the curve at $(1,1).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-1}{4} & =\\frac{y-1}{-4} \\\\ x-1 & =-y+1 \\\\ x+y-2 & =0\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id "q-130724/selection/e94022aeca52cdee3d3e2a2e4dd41b505f48c7c93e4d93328e0a1b132f57b4cc" :answer/id #uuid "eab8bf65-89e9-5131-bf5c-cfbe31841a2b" :answer/type :answer.type/math :answer/value "2x-y=-2" :db/ensure [:answer/validate]} {:db/id "q-130724/selection/218ea3a039df195b1a6a683c5dc0a0656e1cabd1070da14c880472b644e38ea6" :answer/id #uuid "606f1354-4d09-58f4-9af2-39bcb9185301" :answer/type :answer.type/math :answer/value "x+y=2" :db/ensure [:answer/validate]} {:db/id "q-130724/selection/3e116bfe6437ea46b289cdc852758018679f91d00e928807b9e1ccd17a488c7c" :answer/id #uuid "d053668f-a06a-57f6-b7e8-7e0ed8bbe6ab" :answer/type :answer.type/math :answer/value "3x+y=2" :db/ensure [:answer/validate]} {:db/id "q-130724/selection/2ce8c1486cefbfa912262e09e3de1982fc70e460c13537e92103ea8818e9443e" :answer/id #uuid "db0b2d61-277d-5c7b-9c3a-fee9cce2666f" :answer/type :answer.type/math :answer/value "x-y=-2" :db/ensure [:answer/validate]} {:db/id "q-130724/selection/06f690458c9b7a1d179b781b344c1943ffebe73f84e5f73877e8f02629aa7603" :answer/id #uuid "edc8d069-2a81-5282-af66-4cea790ad699" :answer/type :answer.type/math :answer/value "3x+2y=4" :db/ensure [:answer/validate]} {:db/id "q-130724/selection" :answer-field/id #uuid "643db0dd-1b50-5f94-a712-f9414f9879ff" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130724/selection/218ea3a039df195b1a6a683c5dc0a0656e1cabd1070da14c880472b644e38ea6" :answer-field/choices ["q-130724/selection/e94022aeca52cdee3d3e2a2e4dd41b505f48c7c93e4d93328e0a1b132f57b4cc" "q-130724/selection/218ea3a039df195b1a6a683c5dc0a0656e1cabd1070da14c880472b644e38ea6" "q-130724/selection/3e116bfe6437ea46b289cdc852758018679f91d00e928807b9e1ccd17a488c7c" "q-130724/selection/2ce8c1486cefbfa912262e09e3de1982fc70e460c13537e92103ea8818e9443e" "q-130724/selection/06f690458c9b7a1d179b781b344c1943ffebe73f84e5f73877e8f02629aa7603"] :db/ensure [:answer-field/validate]} {:db/id "q-130724" :question/id #uuid "6d7c5aa5-5c3b-57a9-b613-006e91b71fa6" :question/math-academy-id "q-130724" :question/problem "Consider the plane curve $\\sqrt{{x}^{2}+{y}^{2}}=2y-x-2.$  Find the equation of the normal line to the curve at the point $(0,2).$" :question/worked-solution "First, we bring all variables to one side:\n\n$$\n\\begin{aligned}\\sqrt{{x}^{2}+{y}^{2}} & =2y-x-2 \\\\ \\sqrt{{x}^{2}+{y}^{2}}-2y+x & =-2\\end{aligned}\n$$\n\nIf we set $f(x,y)=\\sqrt{{x}^{2}+{y}^{2}}-2y+x$, our curve can be viewed as the level curve $f(x,y)=-2.$  \n\nA normal vector to the level curve that passes through the point $(0,2)$ can be found by computing $∇f(0,2).$ \n\nSo, we find the gradient and evaluate it at $(0,2):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}(\\sqrt{{x}^{2}+{y}^{2}}-2y+x)i+\\frac{∂}{∂y}(\\sqrt{{x}^{2}+{y}^{2}}-2y+x)j \\\\  & =(\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}}}+1)i+(\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}}}-2)j \\\\ ∇f(0,2) & =(\\frac{0}{\\sqrt{{0}^{2}+{2}^{2}}}+1)i+(\\frac{2}{\\sqrt{{0}^{2}+{2}^{2}}}-2)j \\\\  & =i-j \\\\  & =⟨1,-1⟩\\end{aligned}\n$$\n\nHence, $∇f(0,2)=⟨1,-1⟩$ is a normal vector to the curve at $(0,2).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}\\frac{x-{x}_{0}}{{v}_{x}} & =\\frac{y-{y}_{0}}{{v}_{y}} \\\\ \\frac{x-0}{1} & =\\frac{y-2}{-1} \\\\ x & =2-y \\\\ x+y & =2\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130724/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2f7fab-cebe-519a-83e3-a0831cac289d"] :knowledge-point/questions ["q-130724"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71385/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" :answer/id #uuid "c0497a00-5e77-52cf-8a43-fa9f6f8d08d9" :answer/type :answer.type/math :answer/value "x=0" :db/ensure [:answer/validate]} {:db/id "q-71385/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" :answer/id #uuid "7e0f0ad2-f181-5207-8f0a-23526349efd9" :answer/type :answer.type/math :answer/value "y=0" :db/ensure [:answer/validate]} {:db/id "q-71385/selection/218ea3a039df195b1a6a683c5dc0a0656e1cabd1070da14c880472b644e38ea6" :answer/id #uuid "02b6406b-986a-5fa0-bda7-c5bf77f5124d" :answer/type :answer.type/math :answer/value "x+y=2" :db/ensure [:answer/validate]} {:db/id "q-71385/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" :answer/id #uuid "71982151-0955-55d2-8dd6-21bff01e173e" :answer/type :answer.type/math :answer/value "x=2" :db/ensure [:answer/validate]} {:db/id "q-71385/selection/d7c482a63bb6f0dc4a685ab2c197b6b82a8532f2116185324a228176c0d948fe" :answer/id #uuid "facad33b-6fa8-53c5-9b07-bcacded2a777" :answer/type :answer.type/math :answer/value "x-y=2" :db/ensure [:answer/validate]} {:db/id "q-71385/selection" :answer-field/id #uuid "7aac0396-8461-53ef-95c9-6222dc99a8eb" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71385/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" :answer-field/choices ["q-71385/selection/6bac05a62229f29eba4498544257eb386a58da0ea736d3d95ca346c883c43950" "q-71385/selection/96efe327aa5df1953454aa8a0acb24299d8e2e2f538b2a5f40d98e7332b886b7" "q-71385/selection/218ea3a039df195b1a6a683c5dc0a0656e1cabd1070da14c880472b644e38ea6" "q-71385/selection/4e6eeef5aa33ee4a1d2fff0c2887be5f32fe5006030d9cd9500bd4b039270d64" "q-71385/selection/d7c482a63bb6f0dc4a685ab2c197b6b82a8532f2116185324a228176c0d948fe"] :db/ensure [:answer-field/validate]} {:db/id "q-71385" :question/id #uuid "c79c3b6c-2eb8-5187-a6a7-dda99f1e32a9" :question/math-academy-id "q-71385" :question/problem "Consider the plane curve ${x}^{2}+{y}^{2}=4.$  Find the equation of the normal line to the curve at the point $(2,0).$" :question/worked-solution "If we set $f(x,y)={x}^{2}+{y}^{2}$, our curve can be viewed as the level curve $f(x,y)=4.$  \n\nA normal vector to the level curve that passes through the point $(2,0)$ can be found by computing $∇f(2,0).$ \n\nSo, we find the gradient and evaluate it at $(2,0):$\n\n$$\n\\begin{aligned}∇f(x,y) & ={f}_{x}(x,y)\\,i+{f}_{y}(x,y)\\,j \\\\  & =\\frac{∂}{∂x}({x}^{2}+{y}^{2})\\,i+\\frac{∂}{∂y}({x}^{2}+{y}^{2})\\,j \\\\  & =2x\\,i+2y\\,j \\\\ ∇f(2,0) & =2(2)\\,i+2(0)\\,j \\\\  & =4\\,i \\\\  & =⟨4,0⟩\\end{aligned}\n$$\n\nHence, $∇f(2,0)=⟨4,0⟩$ is a normal vector to the curve at $(2,0).$\n\nFinally, the Cartesian equation of the line that is parallel to $v=⟨{v}_{x},{v}_{y}⟩$ and passes through the point $({x}_{0},{y}_{0})$ can be written as:\n\n$$\n\\begin{aligned}(x-{x}_{0}){v}_{y}-(y-{y}_{0}){v}_{x} & =0 \\\\ (x-2)0-(y-0)4 & =0 \\\\ -4y & =0 \\\\ y & =0\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-71385/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3b2f7fab-cebe-519a-83e3-a0831cac289d"] :knowledge-point/questions ["q-71385"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71403/selection/88944bca5c7e33155d65060291431ca69d0d8ef2db2858d53376cc455c744b7f" :answer/id #uuid "33c5cc2f-2427-5162-ac48-6203e88fbc02" :answer/type :answer.type/math :answer/value "\\frac{4}{5}\\,i+\\frac{3}{5}\\,j" :db/ensure [:answer/validate]} {:db/id "q-71403/selection/94512ccc26575177d5e501b72ff880a0a0486b995bcd932822bf4a382d204164" :answer/id #uuid "86bf8ff9-336b-5fb4-b096-6bd1e8a049c1" :answer/type :answer.type/math :answer/value "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j+k" :db/ensure [:answer/validate]} {:db/id "q-71403/selection/3944e31bdbde4a47511ab56c54040f632be0f308e1be2105920e6a0c339eeae5" :answer/id #uuid "284705cf-7f83-5939-969d-22a99241f89b" :answer/type :answer.type/math :answer/value "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j+\\frac{1}{5}\\,k" :db/ensure [:answer/validate]} {:db/id "q-71403/selection/6752e17097f799416eda38d375be7f7edefdcdefa1bac5adb4a5dc8f8b29e5c1" :answer/id #uuid "7f1f799e-db9d-5c73-a4a1-224f1c576c9b" :answer/type :answer.type/math :answer/value "\\frac{3}{5}\\,i+\\frac{4}{5}\\,j" :db/ensure [:answer/validate]} {:db/id "q-71403/selection/b6144f969338f1e60ba8e079cdbdcfb032baa75af373ede0f30515b185d9fcb2" :answer/id #uuid "ae30582f-9357-5179-88b3-13d72c5a56b9" :answer/type :answer.type/math :answer/value "i+j" :db/ensure [:answer/validate]} {:db/id "q-71403/selection" :answer-field/id #uuid "1f5139e1-3e95-5995-bd4b-183d75f51bbf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71403/selection/6752e17097f799416eda38d375be7f7edefdcdefa1bac5adb4a5dc8f8b29e5c1" :answer-field/choices ["q-71403/selection/88944bca5c7e33155d65060291431ca69d0d8ef2db2858d53376cc455c744b7f" "q-71403/selection/94512ccc26575177d5e501b72ff880a0a0486b995bcd932822bf4a382d204164" "q-71403/selection/3944e31bdbde4a47511ab56c54040f632be0f308e1be2105920e6a0c339eeae5" "q-71403/selection/6752e17097f799416eda38d375be7f7edefdcdefa1bac5adb4a5dc8f8b29e5c1" "q-71403/selection/b6144f969338f1e60ba8e079cdbdcfb032baa75af373ede0f30515b185d9fcb2"] :db/ensure [:answer-field/validate]} {:db/id "q-71403" :question/id #uuid "7a272103-726d-56b1-8c63-1b97e662e34a" :question/math-academy-id "q-71403" :question/problem "For the function $f(x,y,z)=\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(3,4,0).$" :question/worked-solution "A normal vector to the level surface that passes through the point where $(x,y,z)=(3,4,0)$ can be found by computing \n$∇f(3,4,0).$ \n\nSo, we first find the gradient and evaluate it at $(x,y,z)=(3,4,0):$\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\text{ }j+{f}_{z}(x,y,z)\\text{ }k \\\\  & =\\frac{∂}{∂x}(\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}})\\,i+\\frac{∂}{∂y}(\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}})\\,j+\\frac{∂}{∂z}(\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}})\\,k \\\\  & =\\frac{x}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\text{ }i+\\frac{y}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\text{ }j+\\frac{z}{\\sqrt{{x}^{2}+{y}^{2}+{z}^{2}}}\\text{ }k \\\\ ∇f(3,4,0) & =\\frac{3}{\\sqrt{(3)^{2}+(4)^{2}+(0)^{2}}}\\,i+\\frac{4}{\\sqrt{(3)^{2}+(4)^{2}+(0)^{2}}}\\,j+\\frac{0}{\\sqrt{(3)^{2}+(4)^{2}+(0)^{2}}}\\,k \\\\  & =\\frac{3}{5}\\,i+\\frac{4}{5}\\,j\\end{aligned}\n$$\n\nTherefore, $\\frac{3}{5}\\,i+\\frac{4}{5}\\,j$ is perpendicular to the level surface that passes through the point where $(x,y,z)=(3,4,0).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71403/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4516cb28-0fc0-5c15-b9b2-747c3827e189"] :knowledge-point/questions ["q-71403"] :db/ensure [:kno