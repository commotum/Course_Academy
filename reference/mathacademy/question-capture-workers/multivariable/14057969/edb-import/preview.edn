}⁡t=84\\operatorname{sin}⁡t\\,\\operatorname{cos}⁡t.\\end{aligned}\n$$\n\nTherefore, we can write the integral as\n\n$$\n\\begin{aligned}{\\int }_{C}7xy\\,\\text{d}s & ={\\int }_{3\\pi /2}^{2\\pi }f(r(t))\\,‖{r}^{′}(t)‖\\,\\text{d}t \\\\  & ={\\int }_{3\\pi /2}^{2\\pi }84\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\cdot \\sqrt{9+7{sin}^{2}⁡t}\\cdot \\text{d}t \\\\  & =84{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{9+7{sin}^{2}⁡t}\\,\\text{d}t.\\end{aligned}\n$$\n\nWe can solve this using the substitution $u=9+7{sin}^{2}⁡t,$ $\\text{d}u=14\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\,\\text{d}t$ as follows:\n\n$$\n\\begin{aligned}84{\\int }_{3\\pi /2}^{2\\pi }\\operatorname{sin}⁡t\\operatorname{cos}⁡t\\sqrt{9+7{sin}^{2}⁡t}\\,\\text{d}t & =6{\\int }_{16}^{9}\\sqrt{u}\\,\\text{d}u \\\\  & =6\\cdot \\frac{2}{3}{u}^{3/2}{|}_{16}^{9} \\\\  & =4({9}^{3/2}-{16}^{3/2}) \\\\  & =4(27-64) \\\\  & =-148\\end{aligned}\n$$" 13194139535170 true] [17592186335256 1000 #edb/ref 17592186335257 13194139535170 true] [17592186335256 1000 #edb/ref 17592186335258 13194139535170 true] [17592186335256 1000 #edb/ref 17592186335259 13194139535170 true] [17592186335256 1000 #edb/ref 17592186335260 13194139535170 true] [17592186335256 1000 #edb/ref 17592186335261 13194139535170 true] [17592186335256 1040 #edb/ref 17592186045450 13194139535170 true] [17592186335256 1041 "selection" 13194139535170 true] [17592186335256 1104 #edb/ref 17592186335261 13194139535170 true] [17592186335256 1110 #uuid "f379e703-dbba-55cb-a280-afe8dc98da21" 13194139535170 true] [17592186335257 1034 "64" 13194139535170 true] [17592186335257 1103 #edb/ref 17592186045453 13194139535170 true] [17592186335257 1111 #uuid "53737810-7c85-53a3-9e82-0004c44e4b2d" 13194139535170 true] [17592186335258 1034 "-42" 13194139535170 true] [17592186335258 1103 #edb/ref 17592186045453 13194139535170 true] [17592186335258 1111 #uuid "b1afae64-49e1-5b61-bda5-9e52dd170301" 13194139535170 true] [17592186335259 1034 