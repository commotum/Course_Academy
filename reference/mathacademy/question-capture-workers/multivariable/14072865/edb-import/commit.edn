}{∂y}\\end{aligned}], & \\,{f}^{″}(x) & =[\\begin{aligned}\\frac{{∂}^{2}f}{∂{x}^{2}} & \\frac{{∂}^{2}f}{∂x∂y} \\\\ \\frac{{∂}^{2}f}{∂y∂x} & \\frac{{∂}^{2}f}{∂{y}^{2}}\\end{aligned}]\\end{aligned}\n$$\n\nCalculating the first derivative, we have\n\n$$\n\\begin{aligned}{f}^{′}(x) & =[\\begin{aligned}3(x-y)^{2} & -3(x-y)^{2}\\end{aligned}].\\end{aligned}\n$$\n\nCalculating the second derivative, we have the following:\n\n$$\n\\begin{aligned}{f}^{″}(x) & =[\\begin{aligned}6(x-y) & -6(x-y) \\\\ -6(x-y) & 6(x-y)\\end{aligned}] \\\\ {f}^{″}(0,1) & =[\\begin{aligned}-6 & 6 \\\\ 6 & -6\\end{aligned}]\\end{aligned}\n$$\n\nTherefore, the second-degree Taylor polynomial is given by\n\n$$\nf(x)≈f(a)+{f}^{′}(a)(x-a)+\\frac{1}{2}{[\\begin{aligned}x \\\\ y-1\\end{aligned}]}^{T}[\\begin{aligned}-6 & 6 \\\\ 6 & -6\\end{aligned}][\\begin{aligned}x \\\\ y-1\\end{aligned}].\n$$\n\nFinally, the sum of the missing expressions is\n\n$$\nx+6+(y-1)=x+y+5.\n$$" 13194139536000 true] [17592186378938 1000 #edb/ref 17592186378939 13194139536000 true] [17592186378938 1000 #edb/ref 17592186378940 13194139536000 true] [17592186378938 1000 #edb/ref 17592186378941 13194139536000 true] [17592186378938 1000 #edb/ref 17592186378942 13194139536000 true] [17592186378938 1000 #edb/ref 17592186378943 13194139536000 true] [17592186378938 1040 #edb/ref 17592186045450 13194139536000 true] [17592186378938 1041 "selection" 13194139536000 true] [17592186378938 1104 #edb/ref 17592186378941 13194139536000 true] [17592186378938 1110 #uuid "d147cf49-4a6e-58d0-80ad-a632a32ee0fc" 13194139536000 true] [17592186378939 1034 "2y" 13194139536000 true] [17592186378939 1103 #edb/ref 17592186045453 13194139536000 true] [17592186378939 1111 #uuid "766f088e-6755-546a-8b90-0f2091cf54e1" 13194139536000 true] [17592186378940 1034 "2x+6" 13194139536000 true] [17592186378940 1103 #edb/ref 17592186045453 13194139536000 true] [17592186378940 1111 #uuid "bb51c752-7d86-544c-984c-4af5aebf8f7a" 13194139536000 true] [17592186378941 1034 "x+y