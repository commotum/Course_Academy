#{[{:db/id #edb/ref 17592186360222 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa" :knowledge-point/title "Integrating a Trigonometric Expression Using Identities and Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e4b63794-a8e3-5eba-ae1e-6f1cfd761e0e" :answer/type {:db/ident :answer.type/math} :answer/value "3{sec}^{3}⁡x+C" :db/id #edb/ref 17592186360224} {:answer/id #uuid "f829cb53-d373-5d69-ad22-72eaf9b9c918" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{sec}^{3}⁡x+C" :db/id #edb/ref 17592186360225} {:answer/id #uuid "2adedd03-92ab-5d2c-9914-2c9b1370c776" :answer/type {:db/ident :answer.type/math} :answer/value "-3{csc}^{3}⁡x+C" :db/id #edb/ref 17592186360226} {:answer/id #uuid "ebe884ca-0565-5367-9a1d-2638ae20bd22" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{csc}^{3}⁡x+C" :db/id #edb/ref 17592186360227} {:answer/id #uuid "577f4042-ad54-5597-bc82-00fdde0170c5" :answer/type {:db/ident :answer.type/math} :answer/value "{sec}^{2}⁡x+C" :db/id #edb/ref 17592186360228}] :answer-field/correct {:answer/id #uuid "f829cb53-d373-5d69-ad22-72eaf9b9c918" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{3}{sec}^{3}⁡x+C" :db/id #edb/ref 17592186360225} :answer-field/id #uuid "94a5a748-fdc8-5ed9-b8ee-43b9d099cf64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360223}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5c2ad40b-7068-5a02-992d-95e8c199cc6d" :question/math-academy-id "q-114294" :question/problem "$\\int \\operatorname{tan}⁡x{sec}^{3}⁡x\\,\\text{d}x=$" :question/worked-solution "We use the identities $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ and $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}$ and rewrite the integral as\n\n$$\n\\begin{aligned}\\int \\operatorname{tan}⁡x{sec}^{3}⁡x\\,\\text{d}x & =\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\cdot {(\\frac{1}{\\operatorname{cos}⁡x})}^{3}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\cdot \\frac{1}{{cos}^{3}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sin}⁡x}{{cos}^{4}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{cos}⁡x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x\\,⟹\\,-\\text{d}u=\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sin}⁡x}{{cos}^{4}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{u}^{4}}\\,(-\\text{d}u) \\\\  & =-\\int \\frac{1}{{u}^{4}}\\,\\text{d}u \\\\  & =\\frac{1}{3{u}^{3}}+C \\\\  & =\\frac{1}{3{cos}^{3}⁡x}+C \\\\  & =\\frac{1}{3}{sec}^{3}⁡x+C\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360229 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "720c9427-c209-52e9-a1f9-9ee1776f46b7" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-2}{3}" :db/id #edb/ref 17592186360231} {:answer/id #uuid "9f8dec27-515d-5d47-88b8-5d20b38dc6f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186360232} {:answer/id #uuid "12db8f27-8626-5f16-9905-9b8c6408c6ae" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}+1}{2}" :db/id #edb/ref 17592186360233} {:answer/id #uuid "47b06ec8-c43f-5f1e-8420-f75116f54903" :answer/type {:db/ident :answer.type/math} :answer/value "3\\sqrt{2}-2" :db/id #edb/ref 17592186360234} {:answer/id #uuid "73d363e4-83d8-537b-8ef2-b4a2e9ea7609" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{2}" :db/id #edb/ref 17592186360235}] :answer-field/correct {:answer/id #uuid "9f8dec27-515d-5d47-88b8-5d20b38dc6f4" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186360232} :answer-field/id #uuid "d0d4d6e6-f407-5ace-8a39-708a1c981667" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360230}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "24044e3f-134c-5299-af89-c5c8b8e789d5" :question/math-academy-id "q-114318" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{\\pi /4}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x={\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{1}{\\operatorname{sin}⁡x}=\\operatorname{csc}⁡x$ and $\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=\\operatorname{cot}⁡x$ to express this as\n\n$$\n{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{csc}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-[\\operatorname{csc}⁡(\\frac{\\pi }{2})-\\operatorname{csc}⁡(\\frac{\\pi }{4})] \\\\  & =-[1-\\sqrt{2}] \\\\  & =\\sqrt{2}-1.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360236 :knowledge-point/_questions [{:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa" :knowledge-point/title "Integrating a Trigonometric Expression Using Identities and Substitution"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d90b5b3a-ec7d-59d8-b023-b6055fea8d05" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{\\sqrt{2}-1}{2}" :db/id #edb/ref 17592186360238} {:answer/id #uuid "8fdf4cc4-d0a8-51ac-8c59-c47ef91b2f07" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}" :db/id #edb/ref 17592186360239} {:answer/id #uuid "7ab7719e-c266-5172-b548-05e79dbddd4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186360240} {:answer/id #uuid "2a811e1a-2fde-5f94-8164-b6b941b0330a" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186360241} {:answer/id #uuid "e478fcd8-becd-56f1-b585-0e03e3a4e21b" :answer/type {:db/ident :answer.type/math} :answer/value "2-\\sqrt{2}" :db/id #edb/ref 17592186360242}] :answer-field/correct {:answer/id #uuid "7ab7719e-c266-5172-b548-05e79dbddd4f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{2}-1" :db/id #edb/ref 17592186360240} :answer-field/id #uuid "e7030258-ccfb-5549-b721-6d71161813c9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360237}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1ed56625-e74d-5316-b9a4-bd1267e688fb" :question/math-academy-id "q-49257" :question/problem "Evaluate ${\\int }_{\\pi /8}^{\\pi /4}\\frac{2\\operatorname{cos}⁡(2x)}{{sin}^{2}⁡(2x)}\\,\\text{d}x.$" :question/worked-solution "We can solve this by substitution. Let $u=\\operatorname{sin}⁡2x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{cos}⁡2x\\,⟹\\,\\text{d}u=2\\operatorname{cos}⁡2x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡2x.$\n\n| $x$ | $\\frac{\\pi }{8}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\sqrt{2}}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /8}^{\\pi /4}\\frac{2\\operatorname{cos}⁡(2x)}{{sin}^{2}⁡(2x)}\\,\\text{d}x & ={\\int }_{\\sqrt{2}/2}^{1}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =-\\frac{1}{u}{|}_{\\sqrt{2}/2}^{1} \\\\  & =-\\frac{1}{1}+\\frac{2}{\\sqrt{2}} \\\\  & =\\sqrt{2}-1.\\end{aligned}\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186064774 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7af9f96-b157-5502-a3d1-cb60018b075c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x - \\tan x + C" :db/id #edb/ref 17592186063155} {:answer/id #uuid "a8ea30f1-100f-5006-816a-5baf4e3bdd7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x - \\tan x + C" :db/id #edb/ref 17592186063156} {:answer/id #uuid "e2eaa5ac-e665-5654-94e1-cd38cab8fc3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x - \\cot x + C" :db/id #edb/ref 17592186063157} {:answer/id #uuid "4e8b00e8-9f77-52c1-88c1-5a55d3abbdc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x + \\cot x + C" :db/id #edb/ref 17592186063158} {:answer/id #uuid "70c73302-07cb-510a-9359-39bd29e98228" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x + \\tan x + C" :db/id #edb/ref 17592186063159}] :answer-field/correct {:answer/id #uuid "e2eaa5ac-e665-5654-94e1-cd38cab8fc3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x - \\cot x + C" :db/id #edb/ref 17592186063157} :answer-field/id #uuid "ac2b109a-d1fc-50f0-b22a-55eef29d2a8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063154}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c589cab7-d081-524b-ae47-ab787d74dcb4" :question/math-academy-id "q-49273" :question/problem "$\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+{cot}^{2}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that ${cot}^{2}⁡x=\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x}$ to express this as\n\n$$\n\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\frac{1}{{cos}^{2}⁡x}\\cdot {cos}^{3}⁡x+\\frac{1}{{cos}^{2}⁡x}\\cdot \\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+\\frac{1}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+{csc}^{2}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186360243 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b96758b0-02f1-5f2c-936f-107589ad42d7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}{sin}^{2}⁡4x+C" :db/id #edb/ref 17592186360245} {:answer/id #uuid "32748791-d9cd-5139-ac9c-1b88463c2677" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{csc}^{2}⁡4x+C" :db/id #edb/ref 17592186360246} {:answer/id #uuid "61ea9a80-0da1-5bc5-925e-9604c2d46ec2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{csc}⁡4x+C" :db/id #edb/ref 17592186360247} {:answer/id #uuid "db50067d-95b0-598c-8f75-5369b431a3b7" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{cot}⁡4x+C" :db/id #edb/ref 17592186360248} {:answer/id #uuid "322cb7a8-62b4-5f2d-aa8d-28b1b45d2f9b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{1}{2}{cot}^{2}⁡4x+C" :db/id #edb/ref 17592186360249}] :answer-field/correct {:answer/id #uuid "61ea9a80-0da1-5bc5-925e-9604c2d46ec2" :answer/type {:db/ident :answer.type/math} :answer/value "-\\frac{1}{4}\\operatorname{csc}⁡4x+C" :db/id #edb/ref 17592186360247} :answer-field/id #uuid "776a1e87-3c84-5376-ac98-a4c9d9cdf34b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360244}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "575908ea-59c9-5ae9-8853-9779c7dee582" :question/math-academy-id "q-74279" :question/problem "Calculate $\\int \\frac{\\operatorname{cos}⁡4x}{{sin}^{2}⁡4x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{\\operatorname{cos}⁡4x}{{sin}^{2}⁡4x}\\,\\text{d}x=\\int \\frac{1}{\\operatorname{sin}⁡4x}\\cdot \\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}=\\operatorname{cot}⁡4x$ and $\\frac{1}{\\operatorname{sin}⁡4x}=\\operatorname{csc}⁡4x$ to express this as\n\n$$\n\\int \\operatorname{csc}⁡4x\\operatorname{cot}⁡4x\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=4x.$ Then $\\text{d}x=\\frac{1}{4}\\text{d}u.$ Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{csc}⁡4x\\operatorname{cot}⁡4x\\,\\text{d}x & =\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\operatorname{csc}⁡u+C \\\\  & =-\\frac{1}{4}\\operatorname{csc}⁡4x+C.\\end{aligned}\\end{aligned}\n$$"}]}
