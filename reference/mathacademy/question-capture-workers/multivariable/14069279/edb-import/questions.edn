#{[{:db/id #edb/ref 17592186064774 :knowledge-point/_questions [{:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5" :knowledge-point/title "Integrating a Quotient of Trigonometric Functions Using Trigonometric Identities"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a7af9f96-b157-5502-a3d1-cb60018b075c" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sin x - \\tan x + C" :db/id #edb/ref 17592186063155} {:answer/id #uuid "a8ea30f1-100f-5006-816a-5baf4e3bdd7f" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x - \\tan x + C" :db/id #edb/ref 17592186063156} {:answer/id #uuid "e2eaa5ac-e665-5654-94e1-cd38cab8fc3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x - \\cot x + C" :db/id #edb/ref 17592186063157} {:answer/id #uuid "4e8b00e8-9f77-52c1-88c1-5a55d3abbdc9" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x + \\cot x + C" :db/id #edb/ref 17592186063158} {:answer/id #uuid "70c73302-07cb-510a-9359-39bd29e98228" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x + \\tan x + C" :db/id #edb/ref 17592186063159}] :answer-field/correct {:answer/id #uuid "e2eaa5ac-e665-5654-94e1-cd38cab8fc3a" :answer/type {:db/ident :answer.type/math} :answer/value "\\sin x - \\cot x + C" :db/id #edb/ref 17592186063157} :answer-field/id #uuid "ac2b109a-d1fc-50f0-b22a-55eef29d2a8f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186063154}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "c589cab7-d081-524b-ae47-ab787d74dcb4" :question/math-academy-id "q-49273" :question/problem "$\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x=\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+{cot}^{2}⁡x)\\text{d}x.\n$$\n\nWe then use the fact that ${cot}^{2}⁡x=\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x}$ to express this as\n\n$$\n\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}\\int \\frac{{cos}^{3}⁡x+{cot}^{2}⁡x}{{cos}^{2}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{cos}^{2}⁡x}({cos}^{3}⁡x+\\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\frac{1}{{cos}^{2}⁡x}\\cdot {cos}^{3}⁡x+\\frac{1}{{cos}^{2}⁡x}\\cdot \\frac{{cos}^{2}⁡x}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+\\frac{1}{{sin}^{2}⁡x})\\text{d}x \\\\  & =\\int (\\operatorname{cos}⁡x+{csc}^{2}⁡x)\\text{d}x \\\\  & =\\operatorname{sin}⁡x-\\operatorname{cot}⁡x+C.\\end{aligned}\n$$"}]}
