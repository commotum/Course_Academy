\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =-\\frac{1}{u}{|}_{\\sqrt{2}/2}^{1} \\\\  & =-\\frac{1}{1}+\\frac{2}{\\sqrt{2}} \\\\  & =\\sqrt{2}-1.\\end{aligned}\\end{aligned}\n$$" 13194139535669 true] [17592186360237 1000 #edb/ref 17592186360238 13194139535669 true] [17592186360237 1000 #edb/ref 17592186360239 13194139535669 true] [17592186360237 1000 #edb/ref 17592186360240 13194139535669 true] [17592186360237 1000 #edb/ref 17592186360241 13194139535669 true] [17592186360237 1000 #edb/ref 17592186360242 13194139535669 true] [17592186360237 1040 #edb/ref 17592186045450 13194139535669 true] [17592186360237 1041 "selection" 13194139535669 true] [17592186360237 1104 #edb/ref 17592186360240 13194139535669 true] [17592186360237 1110 #uuid "e7030258-ccfb-5549-b721-6d71161813c9" 13194139535669 true] [17592186360238 1034 "\\frac{\\sqrt{2}-1}{2}" 13194139535669 true] [17592186360238 1103 #edb/ref 17592186045453 13194139535669 true] [17592186360238 1111 #uuid "d90b5b3a-ec7d-59d8-b023-b6055fea8d05" 13194139535669 true] [17592186360239 1034 "\\sqrt{2}" 13194139535669 true] [17592186360239 1103 #edb/ref 17592186045453 13194139535669 true] [17592186360239 1111 #uuid "8fdf4cc4-d0a8-51ac-8c59-c47ef91b2f07" 13194139535669 true] [17592186360240 1034 "\\sqrt{2}-1" 13194139535669 true] [17592186360240 1103 #edb/ref 17592186045453 13194139535669 true] [17592186360240 1111 #uuid "7ab7719e-c266-5172-b548-05e79dbddd4f" 13194139535669 true] [17592186360241 1034 "1" 13194139535669 true] [17592186360241 1103 #edb/ref 17592186045453 13194139535669 true] [17592186360241 1111 #uuid "2a811e1a-2fde-5f94-8164-b6b941b0330a" 13194139535669 true] [17592186360242 1034 "2-\\sqrt{2}" 13194139535669 true] [17592186360242 1103 #edb/ref 17592186045453 13194139535669 true] [17592186360242 1111 #uuid "e478fcd8-becd-56f1-b585-0e03e3a4e21b" 13194139535669 true] [17592186360243 1017 #edb/ref 17592186360244 13194139535669 true] [17592186360243 1089 "q-74279" 13194139535669 true] [17592186360243 1091 #edb/ref 175921860