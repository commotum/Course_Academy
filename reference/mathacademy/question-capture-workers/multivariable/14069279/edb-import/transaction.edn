[{:db/id "q-49257/selection/044625205d52a58e07f5170ef6374e33e6ab6ff0d1713191766e66f1bf74dad9" :answer/id #uuid "d90b5b3a-ec7d-59d8-b023-b6055fea8d05" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}-1}{2}" :db/ensure [:answer/validate]} {:db/id "q-49257/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" :answer/id #uuid "8fdf4cc4-d0a8-51ac-8c59-c47ef91b2f07" :answer/type :answer.type/math :answer/value "\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-49257/selection/76c690f03fbd5162fa21765f31a2046fdb1ba896a35e9b165f53f25a86cd1745" :answer/id #uuid "7ab7719e-c266-5172-b548-05e79dbddd4f" :answer/type :answer.type/math :answer/value "\\sqrt{2}-1" :db/ensure [:answer/validate]} {:db/id "q-49257/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "2a811e1a-2fde-5f94-8164-b6b941b0330a" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-49257/selection/d44fa83f843bb931c0b15366ccb7045f22182cdf2f75578a0b832fc9f01f36a7" :answer/id #uuid "e478fcd8-becd-56f1-b585-0e03e3a4e21b" :answer/type :answer.type/math :answer/value "2-\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-49257/selection" :answer-field/id #uuid "e7030258-ccfb-5549-b721-6d71161813c9" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-49257/selection/76c690f03fbd5162fa21765f31a2046fdb1ba896a35e9b165f53f25a86cd1745" :answer-field/choices ["q-49257/selection/044625205d52a58e07f5170ef6374e33e6ab6ff0d1713191766e66f1bf74dad9" "q-49257/selection/2edf353dc47d221855e5e7ee4be942392390ff01766e089c29dc368c2051b12d" "q-49257/selection/76c690f03fbd5162fa21765f31a2046fdb1ba896a35e9b165f53f25a86cd1745" "q-49257/selection/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" "q-49257/selection/d44fa83f843bb931c0b15366ccb7045f22182cdf2f75578a0b832fc9f01f36a7"] :db/ensure [:answer-field/validate]} {:db/id "q-49257" :question/id #uuid "1ed56625-e74d-5316-b9a4-bd1267e688fb" :question/math-academy-id "q-49257" :question/problem "Evaluate ${\\int }_{\\pi /8}^{\\pi /4}\\frac{2\\operatorname{cos}⁡(2x)}{{sin}^{2}⁡(2x)}\\,\\text{d}x.$" :question/worked-solution "We can solve this by substitution. Let $u=\\operatorname{sin}⁡2x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=2\\operatorname{cos}⁡2x\\,⟹\\,\\text{d}u=2\\operatorname{cos}⁡2x\\,\\text{d}x.\n$$\n\nNow, we fill the table for the limits of integration, according to the rule $u=\\operatorname{sin}⁡2x.$\n\n| $x$ | $\\frac{\\pi }{8}$ | $\\frac{\\pi }{4}$ |\n| --- | --- | --- |\n| $u$ | $\\frac{\\sqrt{2}}{2}$ | $1$ |\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\begin{aligned}{\\int }_{\\pi /8}^{\\pi /4}\\frac{2\\operatorname{cos}⁡(2x)}{{sin}^{2}⁡(2x)}\\,\\text{d}x & ={\\int }_{\\sqrt{2}/2}^{1}\\frac{1}{{u}^{2}}\\,\\text{d}u \\\\  & =-\\frac{1}{u}{|}_{\\sqrt{2}/2}^{1} \\\\  & =-\\frac{1}{1}+\\frac{2}{\\sqrt{2}} \\\\  & =\\sqrt{2}-1.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-49257/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa"] :knowledge-point/questions ["q-49257"] :db/ensure [:knowledge-point/validate]} {:db/id "q-74279/selection/255adae0b8d923434311335b506cc0dbf572484800ffa25261ba0c6973088985" :answer/id #uuid "b96758b0-02f1-5f2c-936f-107589ad42d7" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}{sin}^{2}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-74279/selection/4da8f9dfbc52c81600c21c353aa0df9c7ed497ec20c4dbafc6b71c00f928f51a" :answer/id #uuid "32748791-d9cd-5139-ac9c-1b88463c2677" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{csc}^{2}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-74279/selection/c3d418d7b204175f1c3bd84cc6de300283ba1993a0e2bf58de3b3b75c1958fff" :answer/id #uuid "322cb7a8-62b4-5f2d-aa8d-28b1b45d2f9b" :answer/type :answer.type/math :answer/value "\\frac{1}{2}{cot}^{2}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-74279/selection/b187828a605ef3cf4e6c6e3163d81bbf76fe8dc9a6fb97d53d1286220be6b6fc" :answer/id #uuid "db50067d-95b0-598c-8f75-5369b431a3b7" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}\\operatorname{cot}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-74279/selection/5e78e83c7c980d56da10d8fe6d9cae7e9b03efd78b34e04f576917d6c9e33556" :answer/id #uuid "61ea9a80-0da1-5bc5-925e-9604c2d46ec2" :answer/type :answer.type/math :answer/value "-\\frac{1}{4}\\operatorname{csc}⁡4x+C" :db/ensure [:answer/validate]} {:db/id "q-74279/selection" :answer-field/id #uuid "776a1e87-3c84-5376-ac98-a4c9d9cdf34b" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-74279/selection/5e78e83c7c980d56da10d8fe6d9cae7e9b03efd78b34e04f576917d6c9e33556" :answer-field/choices ["q-74279/selection/255adae0b8d923434311335b506cc0dbf572484800ffa25261ba0c6973088985" "q-74279/selection/4da8f9dfbc52c81600c21c353aa0df9c7ed497ec20c4dbafc6b71c00f928f51a" "q-74279/selection/c3d418d7b204175f1c3bd84cc6de300283ba1993a0e2bf58de3b3b75c1958fff" "q-74279/selection/b187828a605ef3cf4e6c6e3163d81bbf76fe8dc9a6fb97d53d1286220be6b6fc" "q-74279/selection/5e78e83c7c980d56da10d8fe6d9cae7e9b03efd78b34e04f576917d6c9e33556"] :db/ensure [:answer-field/validate]} {:db/id "q-74279" :question/id #uuid "575908ea-59c9-5ae9-8853-9779c7dee582" :question/math-academy-id "q-74279" :question/problem "Calculate $\\int \\frac{\\operatorname{cos}⁡4x}{{sin}^{2}⁡4x}\\,\\text{d}x.$" :question/worked-solution "We can write the integral as\n\n$$\n\\int \\frac{\\operatorname{cos}⁡4x}{{sin}^{2}⁡4x}\\,\\text{d}x=\\int \\frac{1}{\\operatorname{sin}⁡4x}\\cdot \\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{\\operatorname{cos}⁡4x}{\\operatorname{sin}⁡4x}=\\operatorname{cot}⁡4x$ and $\\frac{1}{\\operatorname{sin}⁡4x}=\\operatorname{csc}⁡4x$ to express this as\n\n$$\n\\int \\operatorname{csc}⁡4x\\operatorname{cot}⁡4x\\,\\text{d}x.\n$$\n\nWe can solve this by substitution. Let $u=4x.$ Then $\\text{d}x=\\frac{1}{4}\\text{d}u.$ Therefore,\n\n$$\n\\begin{aligned}\\begin{aligned}\\int \\operatorname{csc}⁡4x\\operatorname{cot}⁡4x\\,\\text{d}x & =\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\cdot \\frac{1}{4}\\text{d}u \\\\  & =\\frac{1}{4}\\int \\operatorname{csc}⁡u\\operatorname{cot}⁡u\\,\\text{d}u \\\\  & =-\\frac{1}{4}\\operatorname{csc}⁡u+C \\\\  & =-\\frac{1}{4}\\operatorname{csc}⁡4x+C.\\end{aligned}\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-74279/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5"] :knowledge-point/questions ["q-74279"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114294/selection/eb836f646dc1fa1a70ce8e98c1eba76dc9b28e8df5b52469212d02b62448d458" :answer/id #uuid "577f4042-ad54-5597-bc82-00fdde0170c5" :answer/type :answer.type/math :answer/value "{sec}^{2}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114294/selection/af729f105e8f0ac064f1c8e8b2ced05ec75dac682f1ebb9f66033b477493beb7" :answer/id #uuid "2adedd03-92ab-5d2c-9914-2c9b1370c776" :answer/type :answer.type/math :answer/value "-3{csc}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114294/selection/48581656a001e865b5442be2ca34227fc67685ef388da276e83f0449a9ef7d40" :answer/id #uuid "f829cb53-d373-5d69-ad22-72eaf9b9c918" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{sec}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114294/selection/204dc721f0d1240a664d0767776afa4322d68b496414c5182a6f42121a4ad532" :answer/id #uuid "e4b63794-a8e3-5eba-ae1e-6f1cfd761e0e" :answer/type :answer.type/math :answer/value "3{sec}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114294/selection/e50ebf304ccc263fb58e69768d75cec3aa1d8200cb68319676ab824cc1fa7979" :answer/id #uuid "ebe884ca-0565-5367-9a1d-2638ae20bd22" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{csc}^{3}⁡x+C" :db/ensure [:answer/validate]} {:db/id "q-114294/selection" :answer-field/id #uuid "94a5a748-fdc8-5ed9-b8ee-43b9d099cf64" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114294/selection/48581656a001e865b5442be2ca34227fc67685ef388da276e83f0449a9ef7d40" :answer-field/choices ["q-114294/selection/eb836f646dc1fa1a70ce8e98c1eba76dc9b28e8df5b52469212d02b62448d458" "q-114294/selection/af729f105e8f0ac064f1c8e8b2ced05ec75dac682f1ebb9f66033b477493beb7" "q-114294/selection/48581656a001e865b5442be2ca34227fc67685ef388da276e83f0449a9ef7d40" "q-114294/selection/204dc721f0d1240a664d0767776afa4322d68b496414c5182a6f42121a4ad532" "q-114294/selection/e50ebf304ccc263fb58e69768d75cec3aa1d8200cb68319676ab824cc1fa7979"] :db/ensure [:answer-field/validate]} {:db/id "q-114294" :question/id #uuid "5c2ad40b-7068-5a02-992d-95e8c199cc6d" :question/math-academy-id "q-114294" :question/problem "$\\int \\operatorname{tan}⁡x{sec}^{3}⁡x\\,\\text{d}x=$" :question/worked-solution "We use the identities $\\operatorname{tan}⁡x=\\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}$ and $\\operatorname{sec}⁡x=\\frac{1}{\\operatorname{cos}⁡x}$ and rewrite the integral as\n\n$$\n\\begin{aligned}\\int \\operatorname{tan}⁡x{sec}^{3}⁡x\\,\\text{d}x & =\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\cdot {(\\frac{1}{\\operatorname{cos}⁡x})}^{3}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sin}⁡x}{\\operatorname{cos}⁡x}\\cdot \\frac{1}{{cos}^{3}⁡x}\\,\\text{d}x \\\\  & =\\int \\frac{\\operatorname{sin}⁡x}{{cos}^{4}⁡x}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe can solve this by substitution. Let $u=\\operatorname{cos}⁡x.$ Then \n\n$$\n\\frac{\\text{d}u}{\\text{d}x}=-\\operatorname{sin}⁡x\\,⟹\\,-\\text{d}u=\\operatorname{sin}⁡x\\,\\text{d}x.\n$$\n\nUsing the above, we can write the integral in terms of $u$ and evaluate:\n\n$$\n\\begin{aligned}\\int \\frac{\\operatorname{sin}⁡x}{{cos}^{4}⁡x}\\,\\text{d}x & =\\int \\frac{1}{{u}^{4}}\\,(-\\text{d}u) \\\\  & =-\\int \\frac{1}{{u}^{4}}\\,\\text{d}u \\\\  & =\\frac{1}{3{u}^{3}}+C \\\\  & =\\frac{1}{3{cos}^{3}⁡x}+C \\\\  & =\\frac{1}{3}{sec}^{3}⁡x+C\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-114294/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7d309fd9-62bd-5307-9dfc-128f9ff028aa"] :knowledge-point/questions ["q-114294"] :db/ensure [:knowledge-point/validate]} {:db/id "q-114318/selection/76c690f03fbd5162fa21765f31a2046fdb1ba896a35e9b165f53f25a86cd1745" :answer/id #uuid "9f8dec27-515d-5d47-88b8-5d20b38dc6f4" :answer/type :answer.type/math :answer/value "\\sqrt{2}-1" :db/ensure [:answer/validate]} {:db/id "q-114318/selection/7cc22f64959314a263beb4e5961bc612637ab798925143b8aeba25b84967c5c2" :answer/id #uuid "47b06ec8-c43f-5f1e-8420-f75116f54903" :answer/type :answer.type/math :answer/value "3\\sqrt{2}-2" :db/ensure [:answer/validate]} {:db/id "q-114318/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" :answer/id #uuid "73d363e4-83d8-537b-8ef2-b4a2e9ea7609" :answer/type :answer.type/math :answer/value "2\\sqrt{2}" :db/ensure [:answer/validate]} {:db/id "q-114318/selection/785f053bcefb11036ea74abd04112aaa84b17a5de4012606fb127a671f363cff" :answer/id #uuid "12db8f27-8626-5f16-9905-9b8c6408c6ae" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}+1}{2}" :db/ensure [:answer/validate]} {:db/id "q-114318/selection/25f36af80ff7e5ab75c4b49e3a42c0f6e37883477470fd1d55b0bdbdcbf2f48f" :answer/id #uuid "720c9427-c209-52e9-a1f9-9ee1776f46b7" :answer/type :answer.type/math :answer/value "\\frac{\\sqrt{2}-2}{3}" :db/ensure [:answer/validate]} {:db/id "q-114318/selection" :answer-field/id #uuid "d0d4d6e6-f407-5ace-8a39-708a1c981667" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-114318/selection/76c690f03fbd5162fa21765f31a2046fdb1ba896a35e9b165f53f25a86cd1745" :answer-field/choices ["q-114318/selection/76c690f03fbd5162fa21765f31a2046fdb1ba896a35e9b165f53f25a86cd1745" "q-114318/selection/7cc22f64959314a263beb4e5961bc612637ab798925143b8aeba25b84967c5c2" "q-114318/selection/af5580a233ee3709064249d6732fc822dfb93f38caf90c025deb51b127e90b2c" "q-114318/selection/785f053bcefb11036ea74abd04112aaa84b17a5de4012606fb127a671f363cff" "q-114318/selection/25f36af80ff7e5ab75c4b49e3a42c0f6e37883477470fd1d55b0bdbdcbf2f48f"] :db/ensure [:answer-field/validate]} {:db/id "q-114318" :question/id #uuid "24044e3f-134c-5299-af89-c5c8b8e789d5" :question/math-academy-id "q-114318" :question/problem "${\\int }_{\\pi /4}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x=$" :question/worked-solution "We can write the integral as\n\n$$\n{\\int }_{\\pi /4}^{\\pi /2}\\frac{\\operatorname{cos}⁡x}{{sin}^{2}⁡x}\\,\\text{d}x={\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x.\n$$\n\nWe then use the fact that $\\frac{1}{\\operatorname{sin}⁡x}=\\operatorname{csc}⁡x$ and $\\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}=\\operatorname{cot}⁡x$ to express this as\n\n$$\n{\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x.\n$$\n\nTherefore,\n\n$$\n\\begin{aligned}{\\int }_{\\pi /4}^{\\pi /2}\\frac{1}{\\operatorname{sin}⁡x}\\cdot \\frac{\\operatorname{cos}⁡x}{\\operatorname{sin}⁡x}\\,\\text{d}x & ={\\int }_{\\pi /4}^{\\pi /2}\\operatorname{csc}⁡x\\operatorname{cot}⁡x\\,\\text{d}x \\\\  & =-\\operatorname{csc}⁡x\\,{|}_{\\pi /4}^{\\pi /2} \\\\  & =-[\\operatorname{csc}⁡(\\frac{\\pi }{2})-\\operatorname{csc}⁡(\\frac{\\pi }{4})] \\\\  & =-[1-\\sqrt{2}] \\\\  & =\\sqrt{2}-1.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-114318/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e7542b0b-20cf-52a6-8889-23c81b40e0e5"] :knowledge-point/questio