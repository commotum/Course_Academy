d}u=1 \\\\ v=3.\\end{aligned}\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′}(u,v) & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(2{u}^{3}),\\,\\frac{∂}{∂u}(u{v}^{2}),\\,\\frac{∂}{∂u}(v)⟩ \\\\  & =⟨6{u}^{2},\\,{v}^{2},\\,0⟩ \\\\ {r}_{v}^{′}(u,v) & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(2{u}^{3}),\\,\\frac{∂}{∂v}(u{v}^{2}),\\,\\frac{∂}{∂v}(v)⟩ \\\\  & =⟨0,\\,2uv,\\,1⟩\\end{aligned}\n$$\n\nNext, we evaluate these tangent vectors when $u=1$ and $v=3:$\n\n$$\n\\begin{aligned}{r}_{u}^{′}(1,3) & =⟨6(1)^{2},\\,{3}^{2},\\,0⟩ \\\\  & =⟨6,\\,9,\\,0⟩ \\\\ {r}_{v}^{′}(1,3) & =⟨0,\\,2(1)(3),\\,1⟩ \\\\  & =⟨0,\\,6,\\,1⟩\\end{aligned}\n$$\n\nTherefore, a normal vector to the surface is\n\n$$\n\\begin{aligned}n & ={r}_{u}^{′}(1,3)\\times {r}_{v}^{′}(1,3) \\\\  & =|\\begin{aligned}i & j & k \\\\ 6 & 9 & 0 \\\\ 0 & 6 & 1\\end{aligned}| \\\\  & =⟨|\\begin{aligned}9 & 0 \\\\ 6 & 1\\end{aligned}|,\\,-|\\begin{aligned}6 & 0 \\\\ 0 & 1\\end{aligned}|,\\,|\\begin{aligned}6 & 9 \\\\ 0 & 6\\end{aligned}|⟩ \\\\  & =⟨9,\\,-6,\\,36⟩.\\end{aligned}\n$$\n\nFinally, the equation of the tangent plane is\n\n$$\n\\begin{aligned}n\\cdot ⟨x-{x}_{0},\\,y-{y}_{0},\\,z-{z}_{0}⟩ & =0 \\\\ ⟨9,\\,-6,\\,36⟩\\cdot ⟨x-2,\\,y-9,\\,z-3⟩ & =0 \\\\ 9\\cdot (x-2)+(-6)\\cdot (y-9)+36\\cdot (z-3) & =0 \\\\ 9x-6y+36z-72 & =0 \\\\ 3x-2y+12z & =24.\\end{aligned}\n$$" 13194139535749 true] [17592186364752 1000 #edb/ref 17592186364753 13194139535749 true] [17592186364752 1000 #edb/ref 17592186364754 13194139535749 true] [17592186364752 1000 #edb/ref 17592186364755 13194139535749 true] [17592186364752 1000 #edb/ref 17592186364756 13194139535749 true] [17592186364752 1000 #edb/ref 17592186364757 13194139535749 true] [17592186364752 1040 #edb/ref 17592186045450 13194139535749 true] [17592186364752 1041 "selection" 13194139535749 true] [17592186364752 1104 #edb/ref 17592186364756 13194139535749 true] [17592186364752 1110 #uuid "c547d5a2-ab92-505f-b038-d71b5b261dfd" 13194139535749 true] [17592186364753 1034 "3x-2y-6z=-12" 13194139535749 true] [17592186364753 1103 #edb/ref 17592186045453 13194139535749 true] [17592186364753 1111 #uuid "edd6c28c-0742-5875-81ea-2f505d875e95" 13194139535749 true] [17592186364754 1034 "3x-y-3z=12" 13194139535749 true] [17592186364754 1103 #edb/ref 17592186045453 13194139535749 true] [17592186364754 1111 #uuid "2fb5265a-341d-5a03-8d45-bce93ca0eb73" 13194139535749 true] [17592186364755 1034 "x-2y-6z=24" 13194139535749 true] [17592186364755 1103 #edb/ref 17592186045453 13194139535749 true] [17592186364755 1111 #uuid "ebd3e616-2ed3-5539-ae69-9638a9b54143" 13194139535749 true] [17592186364756 1034 "3x-2y+12z=24" 13194139535749 true] [17592186364756 1103 #edb/ref 17592186045453 13194139535749 true] [17592186364756 1111 #uuid "5b879075-03c9-59ce-ae50-ce08a3477e44" 13194139535749 true] [17592186364757 1034 "x+y-4z=12" 13194139535749 true] [17592186364757 1103 #edb/ref 17592186045453 13194139535749 true] [17592186364757 1111 #uuid "d83fc19b-c98b-5abb-bf4f-378778bb589b" 13194139535749 true] [17592186364758 1017 #edb/ref 17592186364759 13194139535749 true] [17592186364758 1089 "q-110067" 13194139535749 true] [17592186364758 1091 #edb/ref 17592186045465 13194139535749 true] [17592186364758 1100 "Compute a normal vector to the parametric surface generated by the vector-valued function $r(u,v)=⟨v,\\,1+u,\\,{u}^{2}{v}^{2}⟩$ at the point $(1,2,1).$" 13194139535749 true] [17592186364758 1113 #uuid "cb247dbf-bbf5-58ef-b635-b65ed8200697" 13194139535749 true] [17592186364758 1145 "First, notice that since $(1,2,1)$ lies on the surface, we obtain\n\n$$\n{\\begin{aligned}v=1 \\\\ 1+u=2 \\\\ {u}^{2}{v}^{2}=1\\end{aligned}\\,⟹\\,{\\begin{aligned}u=1 \\\\ v=1.\\end{aligned}\n$$\n\nWe now compute the tangent vectors to the grid curves:\n\n$$\n\\begin{aligned}{r}_{u}^{′}(u,v) & =⟨\\frac{∂x}{∂u},\\,\\frac{∂y}{∂u},\\,\\frac{∂z}{∂u}⟩ \\\\  & =⟨\\frac{∂}{∂u}(v),\\,\\frac{∂}{∂u}(1+u),\\,\\frac{∂}{∂u}({u}^{2}{v}^{2})⟩ \\\\  & =⟨0,\\,1,\\,2u{v}^{2}⟩ \\\\ {r}_{v}^{′}(u,v) & =⟨\\frac{∂x}{∂v},\\,\\frac{∂y}{∂v},\\,\\frac{∂z}{∂v}⟩ \\\\  & =⟨\\frac{∂}{∂v}(v),\\,\\frac{∂}{∂v}(1+u),\\,\\frac{∂}{∂v}({u}^{2}{v}^{2})⟩ \\\\  & =⟨1,\\,0,\\,2{u}^{2}v⟩\\end{aligned}\n$$\n\nNext, we evaluate these tangent vectors when $u=1$ and $v=1:$\n\n$$\n\\begin{aligned}{r}_{u}^{′}(1,1) & =⟨0,\\,1,\\,2(1)(1)^{2}⟩ \\\\  & =⟨0,\\,1,\\,2⟩ \\\\ {r}_{v}^{′}(1,1) & =⟨1,\\,0,\\,2(1)^{2}(1)⟩ \\\\  & =⟨1,\\,0,\\,2⟩\\end{aligned}\n$$\n\nTherefore, a normal vector to the surface at the point $(1,2,1)$ is\n\n$$\n\\begin{aligned}n & ={r}_{u}^{′}(1,1)\\times {r}_{v}^{′}(1,1) \\\\  & =|\\begin{aligned}i & j & k \\\\ 0 & 1 & 2 \\\\ 1 & 0 & 2\\end{aligned}| \\\\  & =⟨|\\begin{aligned}1 & 2 \\\\ 0 & 2\\end{aligned}|,\\,-|\\begin{aligned}0 & 2 \\\\ 1 & 2\\end{aligned}|,\\,|\\begin{aligned}0 & 1 \\\\ 1 & 0\\end{aligned}|⟩ \\\\  & =⟨2,\\,2,\\,-1⟩.\\end{aligned}\n$$" 13194139535749 true] [17592186364759 1000 #edb/ref 17592186364760 13194139535749 true] [17592186364759 1000 #edb/ref 17592186364761 13194139535749 true] [17592186364759 1000 #edb/ref 17592186364762 13194139535749 true] [17592186364759 1000 #edb/ref 17592186364763 13194139535749 true] [17592186364759 1000 #edb/ref 17592186364764 13194139535749 true] [17592186364759 1040 #edb/ref 17592186045450 13194139535749 true] [17592186364759 1041 "selection" 13194139535749 true] [17592186364759 1104 #edb/ref 17592186364762 13194139535749 true] [17592186364759 1110 #uuid "71e2b1bb-e57e-5124-b439-5677b114d463" 13194139535749 true] [17592186364760 1034 "⟨-1,\\,0,\\,1⟩" 13194139535749 true] [17592186364760 1103 #edb/ref 17592186045453 13194139535749 true] [17592186364760 1111 #uuid "29789cfc-ae47-50d3-9eef-de4ebbf78fbf" 13194139535749 true] [17592186364761 1034 "⟨-1,\\,1,\\,-2⟩" 13194139535749 true] [17592186364761 1103 #edb/ref 17592186045453 13194139535749 true] [17592186364761 1111 #uuid "d724b8ce-15df-54ea-83df-b35705131d14" 13194139535