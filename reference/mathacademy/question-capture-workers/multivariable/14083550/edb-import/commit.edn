frac{∂}{∂y}(2{y}^{2}-2xy+6x) & \\frac{∂}{∂y}(4xy-{x}^{2})\\end{aligned}] \\\\  & =[\\begin{aligned}-2y+6 & 4y-2x \\\\ 4y-2x & 4x\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, our Newton-Raphson formula is\n\n$$\n{x}_{n+1}={x}_{n}-{[\\begin{aligned}-2y+6 & 4y-2x \\\\ 4y-2x & 4x\\end{aligned}]}_{{x}_{n}}^{-1}{[\\begin{aligned}2{y}^{2}-2xy+6x \\\\ 4xy-{x}^{2}\\end{aligned}]}_{{x}_{n}}.\n$$\n\nFor the second iteration, we have\n\n$$\n\\begin{aligned}{x}_{2} & ={x}_{1}-{[\\begin{aligned}-2y+6 & 4y-2x \\\\ 4y-2x & 4x\\end{aligned}]}_{{x}_{1}}^{-1}{[\\begin{aligned}2{y}^{2}-2xy+6x \\\\ 4xy-{x}^{2}\\end{aligned}]}_{{x}_{1}} \\\\  & =[\\begin{aligned}1.75 \\\\ 0.125\\end{aligned}]-{[\\begin{aligned}-2(0.125)+6 & 4(0.125)-2(1.75) \\\\ 4(0.125)-2(1.75) & 4(1.75)\\end{aligned}]}^{-1}[\\begin{aligned}2(0.125)^{2}-2(1.75)(0.125)+6(1.75) \\\\ 4(1.75)(0.125)-(1.75)^{2}\\end{aligned}] \\\\  & =[\\begin{aligned}1.75 \\\\ 0.125\\end{aligned}]-{[\\begin{aligned}5.75 & -3 \\\\ -3 & 7\\end{aligned}]}^{-1}[\\begin{aligned}10.093\\,75 \\\\ -2.187\\,5\\end{aligned}] \\\\  & =[\\begin{aligned}1.75 \\\\ 0.125\\end{aligned}]-\\frac{1}{(5.75)\\cdot 7-(-3)\\cdot (-3)}[\\begin{aligned}7 & 3 \\\\ 3 & 5.75\\end{aligned}][\\begin{aligned}10.093\\,75 \\\\ -2.187\\,5\\end{aligned}] \\\\  & =[\\begin{aligned}1.75 \\\\ 0.125\\end{aligned}]-\\frac{1}{31.25}[\\begin{aligned}64.093\\,75 \\\\ 17.703\\,125\\end{aligned}] \\\\  & ≈[\\begin{aligned}-0.301 \\\\ -0.442\\end{aligned}].\\end{aligned}\n$$" 13194139536189 true] [17592186388027 1000 #edb/ref 17592186388028 13194139536189 true] [17592186388027 1040 #edb/ref 17592186045449 13194139536189 true] [17592186388027 1041 "field-1" 13194139536189 true] [17592186388027 1104 #edb/ref 17592186388028 13194139536189 true] [17592186388027 1110 #uuid "665958b3-ea3c-573c-8452-552b59da85ef" 13194139536189 true] [17592186388028 1034 "-0.442" 13194139536189 true] [17592186388028 1103 #edb/ref 17592186045453 13194139536189 true] [17592186388028 1111 #uuid "94aabb8b-8d69