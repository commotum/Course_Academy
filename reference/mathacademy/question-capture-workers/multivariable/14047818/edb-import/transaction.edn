q-130408/selection/a169eea346755436ef57cca2acaa90a2d6cae2ceb489dfb7df92898a38b8f082" "q-130408/selection/d0f53503c0ea802939c9c98be90c75483a1cd21dcbdf6cb1659c8f3d79873162"] :db/ensure [:answer-field/validate]} {:db/id "q-130408" :question/id #uuid "6d3b1235-338f-544b-9e5f-ca61081e2c9e" :question/math-academy-id "q-130408" :question/problem "Find the derivative of  $f(t)=⟨\\operatorname{cos}⁡2t,\\,\\sqrt{{t}^{2}+1},\\,(t+2)^{2}⟩$ at $t=\\pi .$" :question/worked-solution "First, we find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡2t),\\,\\frac{\\text{d}}{\\text{d}t}(\\sqrt{{t}^{2}+1}),\\,\\frac{\\text{d}}{\\text{d}t}((t+2)^{2})⟩ \\\\  & =⟨-2\\operatorname{sin}⁡2t,\\,\\frac{t}{\\sqrt{{t}^{2}+1}},\\,2(t+2)⟩\\end{aligned}\n$$\n\nNow, to compute ${f}^{′}(\\pi )$ we substitute $t=\\pi $ into the expression for ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{′}(\\pi ) & =⟨-2\\operatorname{sin}⁡2\\pi ,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩ \\\\  & =⟨0,\\,\\frac{\\pi }{\\sqrt{{\\pi }^{2}+1}},\\,2(\\pi +2)⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130408/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b31f2bdc-c267-5fc7-bd0f-283777ee4fee"] :knowledge-point/questions ["q-130408"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-32415"] :question/problem "Calculate ${f}^{′}(t)$ given that $f(t)=[\\begin{aligned}{t}^{3}+5{t}^{2} \\\\ \\operatorname{tan}⁡t \\\\ {6}^{t}\\end{aligned}].$" :question/worked-solution "We find ${f}^{′}(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(t) & =[\\begin{aligned}\\frac{\\text{d}}{\\text{d}t}({t}^{3}+5{t}^{2}) \\\\ \\frac{\\text{d}}{\\text{d}t}(\\operatorname{tan}⁡t) \\\\ \\frac{\\text{d}}{\\text{d}t}({6}^{t})\\end{aligned}]=[\\begin{aligned}3{t}^{2}+10t \\\\ {sec}^{2}⁡t \\\\ {6}^{t}\\operatorname{ln}⁡6\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-32416/selection/55e8de96ccbd219da53c57c452d6a15b0c5fec0fdd04066233e2e1a533516c7f" :answer/id #uuid "b34f122b-944c-541e-a3fe-8f29d2c332c1" :answer/type :answer.type/math :answer/value "⟨-4\\operatorname{cos}⁡2s,12{s}^{2},1⟩" :db/ensure [:answer/validate]} {:db/id "q-32416/selection/84045cb844ed9a8f6bbacad6692fb8b7718da1988ab9e266a138759f4c8dea04" :answer/id #uuid "4c5a9c61-6049-57af-8213-6b509f491b64" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{cos}⁡2s,12{s}^{2},0⟩" :db/ensure [:answer/validate]} {:db/id "q-32416/selection/74621c00215ea22fc76fc219dcb4a6b0c5aa9e7d655d5c1ad1f492bd483e5009" :answer/id #uuid "5f2a5a48-3ea8-5a19-8b03-b9dcb8e71071" :answer/type :answer.type/math :answer/value "⟨-4\\operatorname{cos}⁡2s,12{s}^{2},0⟩" :db/ensure [:answer/validate]} {:db/id "q-32416/selection/67405283e2e27bf2e4bc449b28e3be50fc71b1a4f94df615ae611b6f83e4ad06" :answer/id #uuid "916facc5-66a2-5d9b-b499-c237e8874eb7" :answer/type :answer.type/math :answer/value "⟨-2\\operatorname{sin}⁡2s,4{s}^{3}+10,0⟩" :db/ensure [:answer/validate]} {:db/id "q-32416/selection/81933d85b56722038146f3ca1f0f4a5580f038ad7d8a1eecc2997a65a69f389d" :answer/id #uuid "422d5ee2-0ed8-5f36-88c9-958090098c05" :answer/type :answer.type/math :answer/value "⟨-\\operatorname{sin}⁡2s,4{s}^{3}+10,0⟩" :db/ensure [:answer/validate]} {:db/id "q-32416/selection" :answer-field/id #uuid "cb3aa70a-d61d-5444-b63c-4c74ae92778d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-32416/selection/74621c00215ea22fc76fc219dcb4a6b0c5aa9e7d655d5c1ad1f492bd483e5009" :answer-field/choices ["q-32416/selection/55e8de96ccbd219da53c57c452d6a15b0c5fec0fdd04066233e2e1a533516c7f" "q-32416/selection/84045cb844ed9a8f6bbacad6692fb8b7718da1988ab9e266a138759f4c8dea04" "q-32416/selection/74621c00215ea22fc76fc219dcb4a6b0c5aa9e7d655d5c1ad1f492bd483e5009" "q-32416/selection/67405283e2e27bf2e4bc449b28e3be50fc71b1a4f94df615ae611b6f83e4ad06" "q-32416/selection/81933d85b56722038146f3ca1f0f4a5580f038ad7d8a1eecc2997a65a69f389d"] :db/ensure [:answer-field/validate]} {:db/id "q-32416" :question/id #uuid "572464ad-7c54-5cd9-9015-36b55e4e1b81" :question/math-academy-id "q-32416" :question/problem "Calculate the second derivative of  $f(s)=⟨\\operatorname{cos}⁡2s,\\,{s}^{4}+10s,\\,55⟩$ with respect to $s.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component:\n\n$$\n\\begin{aligned}{f}^{′}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(\\operatorname{cos}⁡2s),\\,\\frac{\\text{d}}{\\text{d}s}({s}^{4}+10s),\\,\\frac{\\text{d}}{\\text{d}s}(55)⟩ \\\\  & =⟨-2\\operatorname{sin}⁡2s,\\,4{s}^{3}+10,\\,0⟩\\end{aligned}\n$$\n\nNext, we calculate the second derivative by differentiating ${f}^{′}(s)$:\n\n$$\n\\begin{aligned}{f}^{″}(s) & =⟨\\frac{\\text{d}}{\\text{d}s}(-2\\operatorname{sin}⁡2s),\\,\\frac{\\text{d}}{\\text{d}s}(4{s}^{3}+10),\\,\\frac{\\text{d}}{\\text{d}s}(0)⟩ \\\\  & =⟨-4\\operatorname{cos}⁡2s,\\,12{s}^{2},\\,0⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-32416/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-32416"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77683/selection/ea7f476244ef92ab775b55d564232bf0e542ab0f3e91f3e0e1b30067a18d1b62" :answer/id #uuid "3ef12aaa-afb9-5d01-8fca-0947ba2be086" :answer/type :answer.type/math :answer/value "(\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/ensure [:answer/validate]} {:db/id "q-77683/selection/b040c43c8eed2e434ae4a387d076d815221c5d8ae628a7c83317ab61d230105f" :answer/id #uuid "54dfd46e-f6be-5bcb-a8d2-cac0ff2ff613" :answer/type :answer.type/math :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i-(2\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(t+1)\\,k" :db/ensure [:answer/validate]} {:db/id "q-77683/selection/dc20769117e79cc400f58e9c42e18624ed0036a50f338839a9a19edaf968d782" :answer/id #uuid "38bdc08f-34a7-5136-9a7f-9b4305f61b5e" :answer/type :answer.type/math :answer/value "-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/ensure [:answer/validate]} {:db/id "q-77683/selection/6d9afb2d3cdcbce41200aa0404aa90cedc76edbac05a6dc0c9d807d5ea7894e2" :answer/id #uuid "0da4a1bb-c19c-517d-8851-27a833d56cbe" :answer/type :answer.type/math :answer/value "(t\\operatorname{cos}⁡t-\\operatorname{sin}⁡t)\\,i-(\\operatorname{cos}⁡t+t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k" :db/ensure [:answer/validate]} {:db/id "q-77683/selection/ae6fa546dc54a478b64779cca5421143bc098cd7f127feea2920a910b17ceed6" :answer/id #uuid "84747db9-ea74-5cd7-9571-7acebd579dd4" :answer/type :answer.type/math :answer/value "(2\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i-(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(t+1)\\,k" :db/ensure [:answer/validate]} {:db/id "q-77683/selection" :answer-field/id #uuid "049d0968-ff5d-5d86-b4a3-2982ba280e07" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77683/selection/dc20769117e79cc400f58e9c42e18624ed0036a50f338839a9a19edaf968d782" :answer-field/choices ["q-77683/selection/ea7f476244ef92ab775b55d564232bf0e542ab0f3e91f3e0e1b30067a18d1b62" "q-77683/selection/b040c43c8eed2e434ae4a387d076d815221c5d8ae628a7c83317ab61d230105f" "q-77683/selection/dc20769117e79cc400f58e9c42e18624ed0036a50f338839a9a19edaf968d782" "q-77683/selection/6d9afb2d3cdcbce41200aa0404aa90cedc76edbac05a6dc0c9d807d5ea7894e2" "q-77683/selection/ae6fa546dc54a478b64779cca5421143bc098cd7f127feea2920a910b17ceed6"] :db/ensure [:answer-field/validate]} {:db/id "q-77683" :question/id #uuid "19d44fb9-0b26-5bc1-af60-efeec2020695" :question/math-academy-id "q-77683" :question/problem "Find the second derivative of $f(t)=t\\operatorname{cos}⁡t\\,i+t\\operatorname{sin}⁡t\\,j+(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{cos}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(t\\operatorname{sin}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{3}{t}^{3}-\\frac{1}{2}{t}^{2})\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+(3\\cdot \\frac{1}{3}{t}^{2}-2\\cdot \\frac{1}{2}t)\\,k \\\\  & =(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+({t}^{2}-t)\\,k\\end{aligned}\n$$\n\n \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,j+\\frac{\\text{d}}{\\text{d}t}({t}^{2}-t)\\,k \\\\  & =(-\\operatorname{sin}⁡t-\\operatorname{sin}⁡t-t\\operatorname{cos}⁡t)\\,i+(\\operatorname{cos}⁡t+\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k \\\\  & =-(2\\operatorname{sin}⁡t+t\\operatorname{cos}⁡t)\\,i+(2\\operatorname{cos}⁡t-t\\operatorname{sin}⁡t)\\,j+(2t-1)\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-77683/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-77683"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130426/selection/53a1baadb6828fdadce682621ddc781f19bf2c94c9f8fe6e3f791052cc951a5c" :answer/id #uuid "a5fe88e5-c2f4-50ad-846a-9df8a2f8256e" :answer/type :answer.type/math :answer/value "\\frac{2}{t}\\,i-(\\operatorname{cos}⁡t+{e}^{t})\\,j+2t\\,k" :db/ensure [:answer/validate]} {:db/id "q-130426/selection/83bf053a396a0e31b52313259ee39cfe8854ec1e45dc335e37ac6044f63e374e" :answer/id #uuid "7a01bbcf-71de-5010-9d8a-4f405dc4cf7b" :answer/type :answer.type/math :answer/value "2{t}^{2}\\,i+\\operatorname{cos}⁡t\\,j+t\\,k" :db/ensure [:answer/validate]} {:db/id "q-130426/selection/7cad586c8492b7f5714862f3679ed23af3084dc95f16bdf70e9ba4903c282c8e" :answer/id #uuid "6742b8d2-1aea-55a3-92df-7525a74715c9" :answer/type :answer.type/math :answer/value "-\\frac{2}{{t}^{2}}\\,i-(\\operatorname{sin}⁡t+{e}^{t})\\,j+2t+1\\,k" :db/ensure [:answer/validate]} {:db/id "q-130426/selection/50eb343e1104f9fbdb4b7a65b9c9fc43326e84b58863d15dae54ff6e17b0f3fa" :answer/id #uuid "a515c34c-d77e-550c-a249-6eab2cf16e8c" :answer/type :answer.type/math :answer/value "-\\frac{1}{{t}^{2}}\\,i+(\\operatorname{cos}⁡t-{e}^{t})\\,j+6t\\,k" :db/ensure [:answer/validate]} {:db/id "q-130426/selection/94837104d36c0b4740d3fc41a386cd71a9edda48e30cde873fed53d7022d09cd" :answer/id #uuid "7bbfc905-6a98-5370-8ddb-de8959594fc1" :answer/type :answer.type/math :answer/value "-\\frac{2}{{t}^{2}}\\,i+(\\operatorname{cos}⁡t-{e}^{t})\\,j+12t\\,k" :db/ensure [:answer/validate]} {:db/id "q-130426/selection" :answer-field/id #uuid "d1cf995c-6f1f-590f-985d-f3a61fcd8038" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130426/selection/94837104d36c0b4740d3fc41a386cd71a9edda48e30cde873fed53d7022d09cd" :answer-field/choices ["q-130426/selection/53a1baadb6828fdadce682621ddc781f19bf2c94c9f8fe6e3f791052cc951a5c" "q-130426/selection/83bf053a396a0e31b52313259ee39cfe8854ec1e45dc335e37ac6044f63e374e" "q-130426/selection/7cad586c8492b7f5714862f3679ed23af3084dc95f16bdf70e9ba4903c282c8e" "q-130426/selection/50eb343e1104f9fbdb4b7a65b9c9fc43326e84b58863d15dae54ff6e17b0f3fa" "q-130426/selection/94837104d36c0b4740d3fc41a386cd71a9edda48e30cde873fed53d7022d09cd"] :db/ensure [:answer-field/validate]} {:db/id "q-130426" :question/id #uuid "784dd9b4-e3bc-57ef-af5d-81abbd20ffed" :question/math-academy-id "q-130426" :question/problem "Find the second derivative of $f(t)=2\\operatorname{ln}⁡t\\,i-(\\operatorname{cos}⁡t+{e}^{t})\\,j+(2{t}^{3}+t-2)\\,k$ with respect to $t.$" :question/worked-solution "First, we find the derivative of $f(t)$ by differentiating each component.\n\n$$\n\\begin{aligned}{f}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(2\\operatorname{ln}⁡t)\\,i-\\frac{\\text{d}}{\\text{d}t}(\\operatorname{cos}⁡t+{e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(2{t}^{3}+t-2)\\,k \\\\  & =\\frac{2}{t}\\,i-(-\\operatorname{sin}⁡t+{e}^{t})\\,j+(6{t}^{2}+1)\\,k \\\\  & =\\frac{2}{t}\\,i+(\\operatorname{sin}⁡t-{e}^{t})\\,j+(6{t}^{2}+1)\\,k\\end{aligned}\n$$\n\n  \n\nThen, we calculate ${f}^{″}(t)$ by differentiating ${f}^{′}(t):$\n\n$$\n\\begin{aligned}{f}^{″}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{2}{t})\\,i+\\frac{\\text{d}}{\\text{d}t}(\\operatorname{sin}⁡t-{e}^{t})\\,j+\\frac{\\text{d}}{\\text{d}t}(6{t}^{2}+1)\\,k \\\\  & =-\\frac{2}{{t}^{2}}\\,i+(\\operatorname{cos}⁡t-{e}^{t})\\,j+12t\\,k\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-130426/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-130426"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123184/selection/f45271db1b71ab36d9fc664e03551ee998e91a104865628b8eca54e67da9839d" :answer/id #uuid "973ba29b-5dbd-5622-8522-972a97c29bc5" :answer/type :answer.type/math :answer/value "⟨4\\operatorname{sec}⁡(2t)({tan}^{2}⁡(2t)+\\operatorname{sec}⁡(2t)),\\,\\frac{1}{{t}^{3}}⟩" :db/ensure [:answer/validate]} {:db/id "q-123184/selection/70aa925587e9a1733f585a5529484cf15704b95d0f3c2ce895e3f85502fe3e88" :answer/id #uuid "a337ebb4-d9cb-51bc-bece-a0805c6c2284" :answer/type :answer.type/math :answer/value "⟨4{sec}^{2}⁡(2t)(\\operatorname{tan}⁡(2t)-\\operatorname{sec}⁡(2t)),\\,-\\frac{3}{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-123184/selection/37320b0bac885bc14670c980dab94133045bd387449469bea105e38f341a2967" :answer/id #uuid "870bb444-8b25-5e47-bdcd-66ce10cd058a" :answer/type :answer.type/math :answer/value "⟨4\\operatorname{sec}⁡(2t)({tan}^{2}⁡t+{sec}^{2}⁡(2t)),\\,-\\frac{3}{{t}^{2}}⟩" :db/ensure [:answer/validate]} {:db/id "q-123184/selection/010f111d358686eeac9704de9536cc70f3a9121d004f36675a979c0320a6fde2" :answer/id #uuid "120e0d02-39ff-52fe-acfa-b0536ce24c0b" :answer/type :answer.type/math :answer/value "⟨\\operatorname{sec}⁡(2t)({tan}^{2}⁡(t)-{sec}^{2}⁡(2t)),\\,\\frac{1}{{t}^{2}}⟩" :db/ensure [:answer/validate]} {:db/id "q-123184/selection/bf4dd67dcde76ea7e848291e01f2de18bc276108e1a8d5bb429511f634ded6c1" :answer/id #uuid "15cae32f-f6af-53f8-b063-bb013b75ebd4" :answer/type :answer.type/math :answer/value "⟨4\\operatorname{sec}⁡(2t)({tan}^{2}⁡(2t)+{sec}^{2}⁡(2t)),\\,-\\frac{3}{{t}^{2}}⟩" :db/ensure [:answer/validate]} {:db/id "q-123184/selection" :answer-field/id #uuid "cecbaf67-2900-5422-ac5a-6e877bc6177d" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123184/selection/bf4dd67dcde76ea7e848291e01f2de18bc276108e1a8d5bb429511f634ded6c1" :answer-field/choices ["q-123184/selection/f45271db1b71ab36d9fc664e03551ee998e91a104865628b8eca54e67da9839d" "q-123184/selection/70aa925587e9a1733f585a5529484cf15704b95d0f3c2ce895e3f85502fe3e88" "q-123184/selection/37320b0bac885bc14670c980dab94133045bd387449469bea105e38f341a2967" "q-123184/selection/010f111d358686eeac9704de9536cc70f3a9121d004f36675a979c0320a6fde2" "q-123184/selection/bf4dd67dcde76ea7e848291e01f2de18bc276108e1a8d5bb429511f634ded6c1"] :db/ensure [:answer-field/validate]} {:db/id "q-123184" :question/id #uuid "b02b05ec-3c49-5ba7-a525-3faa0181bc7c" :question/math-academy-id "q-123184" :question/problem "Given that $r(t)=⟨\\operatorname{sec}⁡(2t),\\,\\operatorname{ln}⁡({t}^{3})⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\operatorname{sec}⁡(2t),$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =2\\operatorname{tan}⁡(2t)\\operatorname{sec}⁡(2t) \\\\ {x}^{″}(t) & =4\\operatorname{sec}⁡(2t){tan}^{2}⁡(2t)+4\\operatorname{sec}⁡(2t){sec}^{2}⁡(2t) \\\\  & =4\\operatorname{sec}⁡(2t)({tan}^{2}⁡(2t)+{sec}^{2}⁡(2t)).\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{ln}⁡({t}^{3}),$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\frac{3}{t} \\\\ {y}^{″}(t) & =-\\frac{3}{{t}^{2}}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨4\\operatorname{sec}⁡(2t)({tan}^{2}⁡(2t)+{sec}^{2}⁡(2t)),\\,-\\frac{3}{{t}^{2}}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-123184/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-123184"] :db/ensure [:knowledge-point/validate]} {:db/id "q-123171/selection/8cccc3e882826fed87d69d9d287cf52f76eb9b8226f80ef45b4026b2a2af6a7f" :answer/id #uuid "e82bbec3-cbed-550a-b1a0-c09742375bcd" :answer/type :answer.type/math :answer/value "⟨\\operatorname{csc}⁡t({cot}^{2}⁡t+{csc}^{2}⁡t),\\,\\frac{1}{{t}^{2}}⟩" :db/ensure [:answer/validate]} {:db/id "q-123171/selection/c3df2740ea5d9e2400f0815a3dace14e2333002992ac71236679782b9ab95da3" :answer/id #uuid "cea3a78c-710b-5714-99ad-af0c76a3d093" :answer/type :answer.type/math :answer/value "⟨\\operatorname{csc}⁡t(\\operatorname{cot}⁡t+\\operatorname{csc}⁡t),\\,\\frac{1}{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-123171/selection/e648c3102fcc079d12892731c7687db924fa6709bc98d933df631d056f9de6a3" :answer/id #uuid "e74006aa-954a-54d4-8a08-3e7213a199b3" :answer/type :answer.type/math :answer/value "⟨\\operatorname{csc}⁡t({cot}^{2}⁡t+{csc}^{2}⁡t),\\,-\\frac{2}{{t}^{2}}⟩" :db/ensure [:answer/validate]} {:db/id "q-123171/selection/9c35504b485c2474c13d8e6220b03f3d1eeb82f17c4f96414ccedfd3cd2f5b5c" :answer/id #uuid "c21190ac-2d83-5bca-899e-b9665bee4e05" :answer/type :answer.type/math :answer/value "⟨{cot}^{2}⁡t+{csc}^{2}⁡t,\\,-\\frac{2}{{t}^{2}}⟩" :db/ensure [:answer/validate]} {:db/id "q-123171/selection/e7168ed44bff4487b34edcedc57aedf5d7299f6c75d7efefd50f2a6cbe9e42ac" :answer/id #uuid "06c9240a-0daa-563a-bde9-11b254179b0e" :answer/type :answer.type/math :answer/value "⟨\\operatorname{csc}⁡t(\\operatorname{cot}⁡t+\\operatorname{csc}⁡t),\\,\\frac{2}{t}⟩" :db/ensure [:answer/validate]} {:db/id "q-123171/selection" :answer-field/id #uuid "cf90a238-da1b-5802-8192-566872def271" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-123171/selection/e648c3102fcc079d12892731c7687db924fa6709bc98d933df631d056f9de6a3" :answer-field/choices ["q-123171/selection/8cccc3e882826fed87d69d9d287cf52f76eb9b8226f80ef45b4026b2a2af6a7f" "q-123171/selection/c3df2740ea5d9e2400f0815a3dace14e2333002992ac71236679782b9ab95da3" "q-123171/selection/e648c3102fcc079d12892731c7687db924fa6709bc98d933df631d056f9de6a3" "q-123171/selection/9c35504b485c2474c13d8e6220b03f3d1eeb82f17c4f96414ccedfd3cd2f5b5c" "q-123171/selection/e7168ed44bff4487b34edcedc57aedf5d7299f6c75d7efefd50f2a6cbe9e42ac"] :db/ensure [:answer-field/validate]} {:db/id "q-123171" :question/id #uuid "ea95f477-95b7-5171-a00b-e29976302120" :question/math-academy-id "q-123171" :question/problem "Given that $r(t)=⟨\\operatorname{csc}⁡t,\\,\\operatorname{ln}⁡({t}^{2})⟩,$ ${r}^{″}(t)=$" :question/worked-solution "To find the second derivative of a vector-valued function, we find the second derivatives of the components.\n\n- For $x(t)=\\operatorname{csc}⁡t,$ we have\n\n$$\n\\begin{aligned}{x}^{′}(t) & =-\\operatorname{cot}⁡t\\operatorname{csc}⁡t \\\\ {x}^{″}(t) & =\\operatorname{csc}⁡t{cot}^{2}⁡t+{csc}^{3}⁡t \\\\  & =\\operatorname{csc}⁡t({cot}^{2}⁡t+{csc}^{2}⁡t).\\end{aligned}\n$$\n\n- For $y(t)=\\operatorname{ln}⁡({t}^{2}),$ we have\n\n$$\n\\begin{aligned}{y}^{′}(t) & =\\frac{2}{t} \\\\ {y}^{″}(t) & =-\\frac{2}{{t}^{2}}.\\end{aligned}\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{″}(t) & =⟨{x}^{″}(t),\\,{y}^{″}(t)⟩ \\\\  & =⟨\\operatorname{csc}⁡t({cot}^{2}⁡t+{csc}^{2}⁡t),\\,-\\frac{2}{{t}^{2}}⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-123171/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3f0e2596-73d6-540c-af84-b19a943da6a8"] :knowledge-point/questions ["q-123171"] :db/ensure [:knowledge-point/validate]}]
