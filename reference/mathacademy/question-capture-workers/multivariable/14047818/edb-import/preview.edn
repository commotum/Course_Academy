947 13194139535015 true] [17592186326946 1017 #edb/ref 17592186326950 13194139535015 true] [17592186326946 1089 "q-349470" 13194139535015 true] [17592186326946 1091 #edb/ref 17592186045465 13194139535015 true] [17592186326946 1100 "Given that $r(t)=⟨4+3{t}^{2},\\,4{t}^{3}+3{t}^{2}-1⟩,$ what is ${r}^{′}(1)?$\n\n${r}^{′}(1)=⟨${{field-1}}$,$\n{{field-2}}$⟩$" 13194139535015 true] [17592186326946 1113 #uuid "3afbda33-c7c2-580e-b2cd-cf4f091a3552" 13194139535015 true] [17592186326946 1145 "We differentiate each component separately.\n\n- For the $x$-component $x(t)=4+3{t}^{2},$ we have\n\n$$\n{x}^{′}(t)=6t,\n$$\n\nand therefore,\n\n$$\n{x}^{′}(1)=6\\cdot 1=6.\n$$\n\n- For the $y$-component $y(t)=4{t}^{3}+3{t}^{2}-1,$ we have\n\n$$\n{y}^{′}(t)=12{t}^{2}+6t,\n$$\n\nand therefore,\n\n$$\n{y}^{′}(1)=12\\cdot {1}^{2}+6\\cdot 1=18.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(1) & =⟨{x}^{′}(1),\\,{y}^{′}(1)⟩ \\\\  & =⟨6,\\,18⟩.\\end{aligned}\n$$" 13194139535015 true] [17592186326947 1000 #edb/ref 17592186326948 13194139535015 true] [17592186326947 1000 #edb/ref 17592186326949 13194139535015 true] [17592186326947 1040 #edb/ref 17592186045449 13194139535015 true] [17592186326947 1041 "field-1" 13194139535015 true] [17592186326947 1104 #edb/ref 17592186326949 13194139535015 true] [17592186326947 1110 #uuid "8c566ab8-7080-51e1-8818-8c8bd6d599d0" 13194139535015 true] [17592186326948 1034 "3" 13194139535015 true] [17592186326948 1103 #edb/ref 17592186045453 13194139535015 true] [17592186326948 1111 #uuid "78bc53ad-0327-5610-8ddf-c5d25c189594" 13194139535015 true] [17592186326949 1034 "6" 13194139535015 true] [17592186326949 1103 #edb/ref 17592186045453 13194139535015 true] [17592186326949 1111 #uuid "319f4de3-4270-5152-a033-34aa45cd1a69" 13194139535015 true] [17592186326950 1000 #edb/ref 17592186326951 13194139535015 true] [17592186326950 1040 #edb/ref 17592186045449 13194139535015 true] [17592186326950 1041 "field-2" 13194139535015 true] [17592186326950 1104 #edb/ref 17592186326951 13194139535015 true] [17592186326950 1110 #uuid "e9af2f6c-85f0-5b58-a303-10540c542ab4" 13194139535015 true] [17592186326951 1034 "18" 13194139535015 true] [17592186326951 1103 #edb/ref 17592186045453 13194139535015 true] [17592186326951 1111 #uuid "726da3c0-bab6-5518-a424-d15bd34f0bae" 13194139535015 true] [17592186326952 1017 #edb/ref 17592186326953 13194139535015 true] [17592186326952 1089 "q-350217" 13194139535015 true] [17592186326952 1091 #edb/ref 17592186045464 13194139535015 true] [17592186326952 1100 "Given that $r(t)=⟨\\sqrt{1-t},\\,3{t}^{2}⟩,$ what is $|{r}^{′}(-1)|?$ Do not round the answer.\n\n$|{r}^{′}(-1)|=$\n{{field-1}}" 13194139535015 true] [17592186326952 1113 #uuid "b3f67fdf-42e5-51a2-b0ea-ed2cd345e814" 13194139535015 true] [17592186326952 1145 "We differentiate each component separately.\n\n- For the $x$-component $x(t)=\\sqrt{1-t},$ we have\n\n$$\n{x}^{′}(t)=-\\frac{1}{2\\sqrt{1-t}},\n$$\n\nand therefore,\n\n$$\n{x}^{′}(-1)=-\\frac{1}{2\\sqrt{1-(-1)}}=-\\frac{1}{2\\sqrt{2}}.\n$$\n\n- For the $y$-component $y(t)=3{t}^{2},$ we have\n\n$$\n{y}^{′}(t)=6t,\n$$\n\nand therefore,\n\n$$\n{y}^{′}(-1)=6(-1)=-6.\n$$\n\nSo, we conclude that\n\n$$\n\\begin{aligned}{r}^{′}(-1) & =⟨{x}^{′}(-1),\\,{y}^{′}(-1)⟩ \\\\  & =⟨-\\frac{1}{2\\sqrt{2}},\\,-6⟩.\\end{aligned}\n$$\n\nFinally, computing the magnitude of this vector, we get\n\n$$\n\\begin{aligned}|{r}^{′}(-1)| & =\\sqrt{{(-\\frac{1}{2\\sqrt{2}})}^{2}+{(-6)}^{2}} \\\\  & =\\sqrt{\\frac{1}{8}+36} \\\\  & =\\sqrt{\\frac{289}{8}} \\\\  & =\\frac{17\\sqrt{2}}{4}.\\end{aligned}\n$$" 13194139535015 true] [17592186326953 1000 #edb/ref 17592186326954 13194139535015 true] [17592186326953 1040 #edb/ref 17592186045449 13194139535015 true] [17592186326953 1041 "field-1" 13194139535015 true] [17592186326953 1104 #edb/ref 17592186326954 13194139535015 true] [17592186326953 1110 #uuid "5d016461-d01f-5e87-b800-716e6141c9ae" 13194139535015 true] [17592186326954 1034 "\\sqrt{\\frac{289}{8}}" 13194139535015 true] [17