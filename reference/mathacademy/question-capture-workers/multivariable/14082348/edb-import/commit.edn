82 13194139536166 true] [17592186386879 1000 #edb/ref 17592186386883 13194139536166 true] [17592186386879 1000 #edb/ref 17592186386884 13194139536166 true] [17592186386879 1040 #edb/ref 17592186045450 13194139536166 true] [17592186386879 1041 "selection" 13194139536166 true] [17592186386879 1104 #edb/ref 17592186386881 13194139536166 true] [17592186386879 1110 #uuid "ae9b7523-e9a7-50b0-88af-39ea9579a054" 13194139536166 true] [17592186386880 1034 "\\frac{16}{3}" 13194139536166 true] [17592186386880 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386880 1111 #uuid "86a92250-6692-54f6-96c2-26ef9022353a" 13194139536166 true] [17592186386881 1034 "\\frac{32}{3}" 13194139536166 true] [17592186386881 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386881 1111 #uuid "9932b0b5-6e3d-573b-863f-4c8ce15438be" 13194139536166 true] [17592186386882 1034 "\\frac{12}{5}" 13194139536166 true] [17592186386882 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386882 1111 #uuid "74399eda-6388-567e-8193-6cd8d49dacbd" 13194139536166 true] [17592186386883 1034 "\\frac{40}{3}" 13194139536166 true] [17592186386883 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386883 1111 #uuid "1b4d930f-9fb9-5fb7-82ee-78b577b7855d" 13194139536166 true] [17592186386884 1034 "\\frac{22}{3}" 13194139536166 true] [17592186386884 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386884 1111 #uuid "abec7b7e-dfc1-59c5-a261-21dad7c2a290" 13194139536166 true] [17592186386885 1017 #edb/ref 17592186386886 13194139536166 true] [17592186386885 1089 "q-117487" 13194139536166 true] [17592186386885 1091 #edb/ref 17592186045464 13194139536166 true] [17592186386885 1100 "Find the area of the closed region between the curve $x={y}^{3}-6{y}^{2}+9y$ and the $y$-axis." 13194139536166 true] [17592186386885 1113 #uuid "83abc00d-75aa-5643-961a-31dd10dc89c4" 13194139536166 true] [17592186386885 1145 "First, we find $y$-intercepts of the curve:\n\n$$\n\\begin{aligned}{y}^{3}-6{y}^{2}+9y & =0 \\\\ y({y}^{2}-6y+9) & =0 \\\\ y(y-3)^{2} & =0 \\\\ y & =0,3\\end{aligned}\n$$\n\nNext, we draw a sketch of the region.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14082348/assets/7509bf6a10838458b110d982740c1399aa36279b9ce4a231f99b76d7c7cee0b3.png)\n\nWe want to find the area between the curve $x={y}^{3}-6{y}^{2}+9y$ and the $y$-axis from  $y=0$ to $y=3.$ To find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}({y}^{3}-6{y}^{2}+9y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{3}{y}^{3}\\,\\text{d}y-6{\\int }_{0}^{3}{y}^{2}\\,\\text{d}y+9{\\int }_{0}^{3}y\\,\\text{d}y \\\\  & ={\\frac{{y}^{4}}{4}|}_{0}^{3}-6\\cdot {\\frac{{y}^{3}}{3}|}_{0}^{3}+9\\cdot {\\frac{{y}^{2}}{2}|}_{0}^{3} \\\\  & =(\\frac{{3}^{4}}{4}-0)-6(\\frac{{3}^{3}}{3}-0)+9(\\frac{{3}^{2}}{2}-0) \\\\  & =\\frac{81}{4}-54+\\frac{81}{2} \\\\  & =\\frac{27}{4}\\end{aligned}\n$$" 13194139536166 true] [17592186386886 1000 #edb/ref 17592186386887 13194139536166 true] [17592186386886 1000 #edb/ref 17592186386888 13194139536166 true] [17592186386886 1000 #edb/ref 17592186386889 13194139536166 true] [17592186386886 1000 #edb/ref 17592186386890 13194139536166 true] [17592186386886 1000 #edb/ref 17592186386891 13194139536166 true] [17592186386886 1040 #edb/ref 17592186045450 13194139536166 true] [17592186386886 1041 "selection" 13194139536166 true] [17592186386886 1104 #edb/ref 17592186386890 13194139536166 true] [17592186386886 1110 #uuid "2785ba3b-0b72-5151-af36-0807a2af7b13" 13194139536166 true] [17592186386887 1034 "\\frac{9}{2}" 13194139536166 true] [17592186386887 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386887 1111 #uuid "2fc3d5b1-3029-5900-83ae-34711296a6c1" 13194139536166 true] [17592186386888 1034 "\\frac{27}{2}" 13194139536166 true] [17592186386888 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386888 1111 #uuid "ee231a05-eeae-52cb-b80d-cd79c5a7d07a" 13194139536166 true] [17592186386889 1034 "9" 13194139536166 true] [17592186386889 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386889 1111 #uuid "8df1c8f5-0598-58b9-a43d-4dab2a7176cd" 13194139536166 true] [17592186386890 1034 "\\frac{27}{4}" 13194139536166 true] [17592186386890 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386890 1111 #uuid "f16c15f4-0c85-5acb-9fa6-e8b0e6446be6" 13194139536166 true] [17592186386891 1034 "\\frac{9}{4}" 13194139536166 true] [17592186386891 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386891 1111 #uuid "10f1eb8f-f1a1-5e10-922c-9e422916c095" 13194139536166 true] [17592186386892 1017 #edb/ref 17592186386893 13194139536166 true] [17592186386892 1089 "q-117637" 13194139536166 true] [17592186386892 1091 #edb/ref 17592186045464 13194139536166 true] [17592186386892 1100 "Find the area of the closed region between the curve $y=\\operatorname{ln}⁡(\\frac{x}{2})$, the $y$-axis, and lines  $y=1$ and $y=3.$" 13194139536166 true] [17592186386892 1113 #uuid "40bf13c6-7421-582c-98a8-9dfac45d95e2" 13194139536166 true] [17592186386892 1145 "First, we make $x$ the subject:\n\n$$\n\\begin{aligned}y & =\\operatorname{ln}⁡(\\frac{x}{2}) \\\\ {e}^{y} & =\\frac{x}{2} \\\\ x & =2{e}^{y}\\end{aligned}\n$$\n\nNow, to find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{1}^{3}2{e}^{y}\\,\\text{d}y \\\\  & =2{\\int }_{1}^{3}{e}^{y}\\,\\text{d}y \\\\  & =2{e}^{y}{|}_{1}^{3} \\\\  & =2({e}^{3}-{e}^{1}) \\\\  & =2({e}^{3}-e)\\end{aligned}\n$$" 13194139536166 true] [17592186386893 1000 #edb/ref 17592186386894 13194139536166 true] [17592186386893 1000 #edb/ref 17592186386895 13194139536166 true] [17592186386893 1000 #edb/ref 17592186386896 13194139536166 true] [17592186386893 1000 #edb/ref 17592186386897 13194139536166 true] [17592186386893 1000 #edb/ref 17592186386898 13194139536166 true] [17592186386893 1040 #edb/ref 17592186045450 13194139536166 true] [17592186386893 1041 "selection" 13194139536166 true] [17592186386893 1104 #edb/ref 17592186386896 13194139536166 true] [17592186386893 1110 #uuid "4d5f436f-e780-54c2-811a-dda953aa6403" 13194139536166 true] [17592186386894 1034 "\\frac{{e}^{3}-e}{2}" 13194139536166 true] [17592186386894 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386894 1111 #uuid "8aaf665c-c184-5a52-879b-2a37f2a03de7" 13194139536166 true] [17592186386895 1034 "\\frac{{e}^{3}-1}{2}" 13194139536166 true] [17592186386895 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386895 1111 #uuid "900e2db4-5a73-50f4-87c6-f4172d1c59f3" 13194139536166 true] [17592186386896 1034 "2({e}^{3}-e)" 13194139536166 true] [17592186386896 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386896 1111 #uuid "a6609f68-ce9b-5de1-bf2a-ae43e11f2baf" 13194139536166 true] [17592186386897 1034 "2{e}^{3}-e" 13194139536166 true] [17592186386897 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386897 1111 #uuid "8ea7d39f-e46f-57e4-b613-b709cbdc2880" 13194139536166 true] [17592186386898 1034 "2({e}^{3}-1)" 13194139536166 true] [17592186386898 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386898 1111 #uuid "91940453-798a-51ea-be4f-f32b63314d3a" 13194139536166 true] [17592186386899 1017 #edb/ref 17592186386900 13194139536166 true] [17592186386899 1089 "q-316714" 13194139536166 true] [17592186386899 1091 #edb/ref 17592186045464 13194139536166 true] [17592186386899 1100 "Find the area $A$ of the finite region bounded between the curve $x={y}^{3}-10{y}^{2}+25y$ and the $y$-axis. Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139536166 true] [17592186386899 1113 #uuid "596b78ec-ab4e-5adc-bc5c-d7a0b4e040d5" 13194139536166 true] [17592186386899 1145 "First, we find the $y$-intercepts of the curve:\n\n$$\n\\begin{aligned}{y}^{3}-10{y}^{2}+25y & =0 \\\\ y({y}^{2}-10y+25) & =0 \\\\ y(y-5)^{2} & =0 \\\\ y & =0,\\,5\\end{aligned}\n$$\n\nNext, we draw a sketch of the region:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14082348/assets/593d1168ce7328aa93edd61fcabc116451fcda8ef24faeac0949fa0a8e686b51.png)\n\nWe want to find the area between the curve $x={y}^{3}-10{y}^{2}+25y$ and the $y$-axis from  $y=0$ to $y=5.$ To find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\text{d}y \\\\  & ={\\int }_{0}^{5}\\,({y}^{3}-10{y}^{2}+25y)\\,\\text{d}y \\\\  & ={\\int }_{0}^{5}{y}^{3}\\,\\text{d}y-10{\\int }_{0}^{5}{y}^{2}\\,\\text{d}y+25{\\int }_{0}^{5}y\\,\\text{d}y \\\\  & ={\\frac{1}{4}{y}^{4}|}_{0}^{5}-{\\frac{10}{3}{y}^{3}|}_{0}^{5}+{\\frac{25}{2}{y}^{2}|}_{0}^{5} \\\\  & =(\\frac{{5}^{4}}{4}-0)-\\frac{10}{3}({5}^{3}-0)+\\frac{25}{2}({5}^{2}-0) \\\\  & =\\frac{625}{4}-\\frac{1250}{3}+\\frac{625}{2} \\\\  & =\\frac{625}{12}\\end{aligned}\n$$" 13194139536166 true] [17592186386900 1000 #edb/ref 17592186386901 13194139536166 true] [17592186386900 1000 #edb/ref 17592186386902 13194139536166 true] [17592186386900 1040 #edb/ref 17592186045449 13194139536166 true] [17592186386900 1041 "field-1" 13194139536166 true] [17592186386900 1104 #edb/ref 17592186386902 13194139536166 true] [17592186386900 1110 #uuid "37d36b14-cde6-5669-b40f-ef8aa8e1af9a" 13194139536166 true] [17592186386901 1034 "625" 13194139536166 true] [17592186386901 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386901 1111 #uuid "0339c514-7dc0-5ab7-b23e-daad3abaa1f7" 13194139536166 true] [17592186386902 1034 "\\frac{625}{12}" 13194139536166 true] [17592186386902 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386902 1111 #uuid "66a5f3bd-bfc2-5d78-a1e9-caf64141f273" 13194139536166 true] [17592186386903 1017 #edb/ref 17592186386904 13194139536166 true] [17592186386903 1089 "q-316742" 13194139536166 true] [17592186386903 1091 #edb/ref 17592186045465 13194139536166 true] [17592186386903 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14082348/assets/a988c243bcf4b82cd05b1ed0292e0595141dbe37a470abc34b183f0ce184fe3f.png)\n\nFind the area $A$ between the curve $y=\\sqrt[3]{x+8}-2$, the $y$-axis and the lines $y=-2$ and $y=0,$ as shown above. Do not round the answer.\n\n$A=$\n\n{{field-1}}" 13194139536166 true] [17592186386903 1113 #uuid "67837df1-44a9-5e00-85f4-8ba33e60cc03" 13194139536166 true] [17592186386903 1145 "First, we make $x$ the subject:\n\n$$\n\\begin{aligned}y & =\\sqrt[3]{x+8}-2 \\\\ y+2 & =\\sqrt[3]{x+8} \\\\ (y+2)^{3} & =x+8 \\\\ x & =(y+2)^{3}-8 \\\\ x & ={y}^{3}+6{y}^{2}+12y\\end{aligned}\n$$\n\nNow, to find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{-2}^{0}({y}^{3}+6{y}^{2}+12y)\\,\\text{d}y \\\\  & ={\\frac{{y}^{4}}{4}|}_{-2}^{0}\\,+\\,6\\cdot {\\frac{{y}^{3}}{3}|}_{-2}^{0}+12\\cdot {\\frac{{y}^{2}}{2}|}_{-2}^{0} \\\\  & =(0-\\frac{16}{4})+6(0-(-\\frac{8}{3}))+12(0-\\frac{4}{2}) \\\\  & =-4+16-24 \\\\  & =-12\\end{aligned}\n$$\n\nWe obtained a negative number because the region lies to the left of the $y$-axis. So the area that we want is\n\n$$\nA=|-12|=12\\,.\n$$" 13194139536166 true] [17592186386904 1000 #edb/ref 17592186386905 13194139536166 true] [17592186386904 1000 #edb/ref 17592186386906 13194139536166 true] [17592186386904 1040 #edb/ref 17592186045449 13194139536166 true] [17592186386904 1041 "field-1" 13194139536166 true] [17592186386904 1104 #edb/ref 17592186386905 13194139536166 true] [17592186386904 1110 #uuid "9eee3a2d-bb41-5476-9b88-e8965f77d973" 13194139536166 true] [17592186386905 1034 "12" 13194139536166 true] [17592186386905 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386905 1111 #uuid "ee9ad3c4-1d18-5972-a30b-68424530e96f" 13194139536166 true] [17592186386906 1034 "-12" 13194139536166 true] [17592186386906 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386906 1111 #uuid "a2723242-d276-54b4-be4c-46447e3e55ae" 13194139536166 true] [17592186386907 1017 #edb/ref 17592186386908 13194139536166 true] [17592186386907 1089 "q-346401" 13194139536166 true] [17592186386907 1091 #edb/ref 17592186045463 13194139536166 true] [17592186386907 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14082348/assets/94ef52e454545335132d467773c0b274296a7cb3758ae9fae3242876c8063f5f.png)\n\nFind the area $A$ bounded between the curve $x=\\frac{3}{4}{y}^{2}-3y$, the $y$-axis, and the lines $y=2$ and $y=4,$ as shown above. Do not round the answer.\n\n$A=$\n{{field-1}}" 13194139536166 true] [17592186386907 1113 #uuid "2ac1ecf2-cde4-568d-bfa8-b8c17fcf8a80" 13194139536166 true] [17592186386907 1145 "To find the area, we compute the corresponding definite integral, as follows:\n\n$$\n\\begin{aligned}A & ={\\int }_{c}^{d}x(y)\\,\\text{d}y \\\\  & ={\\int }_{2}^{4}(\\frac{3}{4}{y}^{2}-3y)\\,\\text{d}y \\\\  & =\\frac{3}{4}{\\int }_{2}^{4}{y}^{2}\\,\\text{d}y\\,-\\,3{\\int }_{2}^{4}y\\,\\text{d}y \\\\  & =\\frac{3}{4}\\cdot {\\frac{{y}^{3}}{3}|}_{2}^{4}\\,-\\,3\\cdot {\\frac{{y}^{2}}{2}|}_{2}^{4} \\\\  & =\\frac{3}{4}(\\frac{64}{3}-\\frac{8}{3})\\,-\\,3(8-2) \\\\  & =14-18 \\\\  & =-4\\end{aligned}\n$$\n\nSince the region lies to the left of the $y$-axis, we obtained a negative number. So the area that we want is $|-4|=4.$" 13194139536166 true] [17592186386908 1000 #edb/ref 17592186386909 13194139536166 true] [17592186386908 1040 #edb/ref 17592186045449 13194139536166 true] [17592186386908 1041 "field-1" 13194139536166 true] [17592186386908 1104 #edb/ref 17592186386909 13194139536166 true] [17592186386908 1110 #uuid "777263a5-7f9c-56cc-b50e-6fb3f4c261c5" 13194139536166 true] [17592186386909 1034 "4" 13194139536166 true] [17592186386909 1103 #edb/ref 17592186045453 13194139536166 true] [17592186386909 1111 #uuid "a39a9b91-0f5b-5581-a6d3-fda3707c5707" 13194139536166 true] [17592186386910 1017 #edb/ref 1