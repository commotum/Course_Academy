 $Q$, as shown below, there is no path lying entirely within the region that connects them.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/2bcaaf15d709d6396155bcdc9e8976bb037c9f341fc0b8863687958dbb0f40ff.png)"}] [{:db/id #edb/ref 17592186372468 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1af47ea-6253-5d58-9b94-31e52de27106" :knowledge-point/title "Identifying Simply-Connected Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "bf8946e3-2ad5-5bf5-8a45-f9d9fd0f87da" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/82a33d59ae0060b0f1187415698ccf36ae45bd4ddc1fce0af74d01df74356ee1.png" :db/id #edb/ref 17592186372470} {:answer/id #uuid "1426f924-c469-5860-becb-c30cd02ce8ec" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/ba9b18a202db25c02b0907665d24fca75c9f4afc5babe898ff8f9c0227c7d447.png" :db/id #edb/ref 17592186372471} {:answer/id #uuid "dc717c48-a81e-526f-9071-16f60d4597ae" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/28105671ce0984f8a34da01d06dc8251244073ced9f775fbc3ede8d9f63bea21.png" :db/id #edb/ref 17592186372472} {:answer/id #uuid "147e3528-3943-5e33-a148-2822c6b5f60c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/d65f2e514477e8c935ddcf648f3073157489b083f1d108a81951e0499586f1c0.png" :db/id #edb/ref 17592186372473} {:answer/id #uuid "58254759-e568-5a57-930b-d34ec5fa3b87" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academ