72/assets/4a67c845fe7993fe0c91784c92201db6ff5c15098db04dc588f5ebe0e8cdc1a1.png)"}] [{:db/id #edb/ref 17592186372475 :knowledge-point/_questions [{:knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e79338e0-4440-545c-bb0d-a635c5ed2f08" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186372477} {:answer/id #uuid "6dea5930-74e8-5c51-be67-a152468bd041" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186372478} {:answer/id #uuid "ba847d1a-771b-59a3-a71f-3c057e046895" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372479} {:answer/id #uuid "b79f791d-0006-526e-b28b-5404eb2e6a8d" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186372480} {:answer/id #uuid "8314ede8-490b-5777-895b-6573c09c40d7" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186372481}] :answer-field/correct {:answer/id #uuid "ba847d1a-771b-59a3-a71f-3c057e046895" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372479} :answer-field/id #uuid "10a2fc59-43bc-58bc-a607-4ae8322be7f2" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372476}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b9570340-d545-5139-8941-656df15706ae" :question/math-academy-id "q-123887" :question/problem "Which of the following regions are simply connected?\n\n- ${R}^{2}$\n- ${(x,y)\\in {R}^{2}\\,|\\,1<{x}^{2}+{y}^{2}<4}$\n- ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 0}$" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region I is simply connected. It's a plane region without holes.\n\n- Region II is *not* simply connected since it's a plane region (a circle) with a hole. In this case, the hole contains all points on the disc ${x}^{2}+{y}^{2}\\le 1.$\n\n- Region III is *not* simply connected since it's a plane region with a hole at $(0,0).$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186372482 :knowledge-point/_questions [{:knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "682b97a6-af7f-50e2-a967-9fe0840fcdbf" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186372484} {:answer/id #uuid "568e79c9-3f7b-59a2-addf-5a9de8ee2dea" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186372485} {:answer/id #uuid "cea2b639-0098-5c59-8ae5-5c0f94eb6039" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372486} {:answer/id #uuid "8546130a-f09e-5da2-aefb-7d011a379898" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186372487} {:answer/id #uuid "15a9f554-6f67-5dff-b1ed-098778dae42d" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186372488}] :answer-field/correct {:answer/id #uuid "cea2b639-0098-5c59-8ae5-5c0f94eb6039" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372486} :answer-field/id #uuid "949e6e9a-d46e-5680-be89-47da03b905de" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372483}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "7b8ed7cf-8426-5222-8254-b26032c99579" :question/math-academy-id "q-123916" :question/problem "Which of the following regions are simply connected?\n\n- ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\le 1}$\n- ${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (2,1)}$\n- ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>25}$" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn. \n\n- Region I is simply connected. It's a plane region (a circle) without holes.\n\n- Region II is *not* simply connected since it's a plane region with a hole at $(2,1).$\n\n- Region III is *not* simply connected since it's a plane region with a hole. In this case, the hole contains all points on the disc ${x}^{2}+{y}^{2}\\le 25.$\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186372489 :knowledge-point/_questions [{:knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "36dabb3c-feaa-5232-9f28-b521a9052fd5" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186372491} {:answer/id #uuid "08cc7618-7f75-5e8b-b904-2e43c398497a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372492} {:answer/id #uuid "b2764823-6bf4-5886-a9d5-5efe7731904b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186372493} {:answer/id #uuid "12d3c611-7b2d-582a-889b-de62b68cbe20" :answer/type {:db/ident :answer.type/text} :answer/value "None of the given regions is simply connected" :db/id #edb/ref 17592186372494} {:answer/id #uuid "1409acdb-3f41-5b16-9a73-b44d950c25e8" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186372495}] :answer-field/correct {:answer/id #uuid "b2764823-6bf4-5886-a9d5-5efe7731904b" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186372493} :answer-field/id #uuid "fb590eea-03f8-5170-b3d4-aa27e9f84f4e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372490}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "2c099fa9-8f26-5673-aaaf-86ed3ef35f44" :question/math-academy-id "q-123923" :question/problem "Which of the following regions are simply connected?\n\n- ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 1}$\n- ${(x,y)\\in {R}^{2}\\,|\\,(x,y)\\ne (0,0)}$\n- ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 0}$" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region I is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the circle ${x}^{2}+{y}^{2}=1.$ Thus, the region is formed by two disjoint pieces and, therefore, is not even a connected region.\n\n- Region II is *not* simply connected since it's a plane region with a hole at $(0,0).$\n\n- Region III is simply connected. It's a plane region without holes.\n\nTherefore, the correct answer is \"III only.\""}] [{:db/id #edb/ref 17592186372496 :knowledge-point/_questions [{:knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbb0400f-e429-5da4-ade8-f8465bed5615" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186372498} {:answer/id #uuid "6b887360-cfd7-5300-8d7e-eb035a84c909" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372499} {:answer/id #uuid "acd15dd2-45d0-5899-8cf2-9413193e8c28" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186372500} {:answer/id #uuid "76b2a753-49c1-5c7b-b38e-5820e64bf549" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186372501} {:answer/id #uuid "c707142c-8033-5cd9-98cd-fea2099b25a6" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186372502}] :answer-field/correct {:answer/id #uuid "6b887360-cfd7-5300-8d7e-eb035a84c909" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372499} :answer-field/id #uuid "424735d6-5cfc-5beb-aa28-114af2b482ce" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372497}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9e25ad41-29df-506b-8ad0-497dbdc77b67" :question/math-academy-id "q-124775" :question/problem "Which of the following regions are simply connected?\n\n- ${(x,y)\\in {R}^{2}\\,|\\,y-x\\ge 0}$\n- ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}>1}$\n- ${(x,y)\\in {R}^{2}\\,|\\,y+x\\ne 0}$" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region I is simply connected. Indeed, it is the half-plane $y\\ge x.$ So,   it's a plane region without holes,\n\n- Region II is *not* simply connected since it's a plane region with a hole (containing all points of the circle ${x}^{2}+{y}^{2}\\le 1$).\n\n- Region III is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the straight line $y=-x.$ Thus, the region is formed by two disjoint half-planes and, therefore, is not even a connected region.\n\nTherefore, the correct answer is \"I only.\""}] [{:db/id #edb/ref 17592186372503 :knowledge-point/_questions [{:knowledge-point/id #uuid "280e7ba4-7617-546b-9e0d-a5bdc33dad8d" :knowledge-point/title "Identifying Simply-Connected Regions in Euclidian Space"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "34712083-f573-5d66-8400-15adfd5befa5" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186372505} {:answer/id #uuid "ae274752-b385-5bea-8052-2bfa0e7b8047" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186372506} {:answer/id #uuid "e6cc128c-9875-5605-9acb-c14862a821cc" :answer/type {:db/ident :answer.type/text} :answer/value "III only" :db/id #edb/ref 17592186372507} {:answer/id #uuid "55a0c334-0cc4-5f84-be32-e3cbcc1fb936" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186372508} {:answer/id #uuid "c8f548bd-b0ec-5da4-85c9-40ecc7fd4f6f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186372509}] :answer-field/correct {:answer/id #uuid "c8f548bd-b0ec-5da4-85c9-40ecc7fd4f6f" :answer/type {:db/ident :answer.type/text} :answer/value "II only" :db/id #edb/ref 17592186372509} :answer-field/id #uuid "14625eb8-2ebb-5541-994b-75d185efcd00" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186372504}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a142fc44-a79e-5b5a-bd09-0bb59f4fda8f" :question/math-academy-id "q-124782" :question/problem "Which of the following regions are simply connected?\n\n- ${(x,y)\\in {R}^{2}\\,|\\,{x}^{2}+{y}^{2}\\ne 4}$\n- ${(x,y)\\in {R}^{2}\\,|\\,x\\ge 1}$\n- ${(x,y)\\in {R}^{2}\\,|\\,xy\\ne 0}$" :question/worked-solution "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nLet's now examine our regions in turn.\n\n- Region I is *not* simply connected. The region contains all the points of ${R}^{2}$ except those on the ellipse ${x}^{2}+{y}^{2}=4.$ Thus, the region is formed by two disjoint pieces and, therefore, is not even a connected region.\n\n- Region II  is simply connected. It's a plane region without holes.\n\n- Region III is *not* simply connected.  The region contains all the points of ${R}^{2}$ except those on the coordinate axes.  Thus, the region is formed by four disjoint pieces and, therefore, is not even a connected region.\n\nTherefore, the correct answer is \"II only.\""}] [{:db/id #edb/ref 17592186172592 :knowledge-point/_questions [{:knowledge-point/id #uuid "d15f8fa8-f265-50da-b172-3ccb90895448" :knowledge-point/title "Identifying Connected Regions"}]