35884 true] [17592186372528 1103 #edb/ref 17592186045452 13194139535884 true] [17592186372528 1111 #uuid "afc6de2a-2270-5c7a-bc51-d9aec8ba4f89" 13194139535884 true] [17592186372529 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/69162c231a9a3d51494afb4ab0fee60e48417e5c30c07ee9e4a9d6cdfbc12032.png" 13194139535884 true] [17592186372529 1103 #edb/ref 17592186045452 13194139535884 true] [17592186372529 1111 #uuid "1ed90a17-dfda-5400-83dc-6a088c1e13ff" 13194139535884 true] [17592186372530 1034 "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/1ae143077958b5c8349d94cd80cae6f21f4327220cc3c0f50d6f13fcb3518488.png" 13194139535884 true] [17592186372530 1103 #edb/ref 17592186045452 13194139535884 true] [17592186372530 1111 #uuid "86895ab5-3ff3-502b-b2c4-dd0caff830cb" 13194139535884 true] [17592186372531 1017 #edb/ref 17592186372532 13194139535884 true] [17592186372531 1089 "q-98690" 13194139535884 true] [17592186372531 1091 #edb/ref 17592186045465 13194139535884 true] [17592186372531 1100 "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/0db1568fab302ddbd9f16dbdf9c276eeb62cbac37346b077c1639fe68c2396ac.png)\n\nWhich of the regions shown above are simply connected?" 13194139535884 true] [17592186372531 1113 #uuid "5e9b2e09-5af6-542e-9e1b-0770faddda9a" 13194139535884 true] [17592186372531 1145 "A connected region $D$ is simply connected if every simple closed curve in $D$ can be contracted to a point.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/7d6aea1a62fb290702630ef95ec86f4119e7c8fdd74b8148b62b66e5ac871b58.png)\n\nA connected *plane* region $D$ is simply connected if every simple closed curve in $D$ encloses only points in $D.$ In other words, the region does not contain any holes. Plane regions containing holes are not simply connected, since some simple closed curves cannot be contracted to a point:\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14071672/assets/c3c3e7a60ff0dd917cf6c0b293dae7510e457a0455629add1c54cadac65248b7.png)\n\nWith that in mind, let's examine each of the regions:  \n\n- Region I is simply connected. This is a connected region that does not contain holes.\n\n- Region II is simply connected. This is a connected region that does not contain holes.\n\n- Region III is simply connected. This is a connected region that does not contain holes.\n\n- Region IV is not simply connected. Instead, this is a connected region that contains a hole.\n\nTherefore, the correct answer is \"I, II, and III only.\"" 13194139535884 true] [17592186372532 1000 #edb/ref 17592186372533 13194139535884 true] [17592186372532 1000 #edb/ref 17592186372534 13194139535884 true] [17592186372532 1000 #edb/ref 17592186372535 13194139535884 true] [17592186372532 1000 #edb/ref 17592186372536 13194139535884 true] [17592186372532 1000 #edb/ref 17592186372537 13194139535884 true] [17592186372532 1040 #edb/ref 17592186045450 13194139535884 true] [17592186372532 1041 "selection" 13194139535884 true] [17592186372532 1104 #edb/ref 17592186372537 13194139535884 true] [17592186372532 1110 #uuid "e4050a64-c122-551f-8036-7859d45d7c20" 13194139535884 true] [17592186372533 1034 "I and III only" 13194139535884 true] [17592186372533 1103 #edb/ref 17592186045454 13194139535884 true] [17592186372533 1111 #uuid "c839de54-afc7-5d95-bfa7-997553f0f927" 13194139535884 true] [17592186372534 1034 "I, III, and IV only" 13194139535884 true] [17592186372534 1103 #edb/ref 17592186045454 13194139535884 true] [17592186372534 1111 #uuid "7ab768bf-2b70-5e50-b3f1-18f9c4ce9ecf" 13194139535884 true] [17592186372535 1034 "III and IV only" 13194139535884 true] [17592186372535 1103 #edb/ref 17592186045454 13194139535884 true] [17592186372535 1111 #uuid "ea295ae8