ply connected region?"}] [{:db/id #edb/ref 17592186172595 :knowledge-point/_questions [{:knowledge-point/id #uuid "d1af47ea-6253-5d58-9b94-31e52de27106" :knowledge-point/title "Identifying Simply-Connected Regions"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "991d14d6-f584-54a3-99eb-29960c372ebd" :answer/type {:db/ident :answer.type/text} :answer/value "I and II only" :db/id #edb/ref 17592186171536} {:answer/id #uuid "a5af7421-68de-547b-86a4-93017f0a1c4a" :answer/type {:db/ident :answer.type/text} :answer/value "I only" :db/id #edb/ref 17592186171537} {:answer/id #uuid "b5b779fa-4c5d-5726-8990-3cda152f49b0" :answer/type {:db/ident :answer.type/text} :answer/value "II and IV only" :db/id #edb/ref 17592186171538} {:answer/id #uuid "f0fc5c92-477a-5cd6-a540-14d2eca13f58" :answer/type {:db/ident :answer.type/text} :answer/value "II and III only" :db/id #edb/ref 17592186171539} {:answer/id #uuid "1eaaf3ea-1b6a-52bf-bb97-41ecec4b5bfd" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171540}] :answer-field/correct {:answer/id #uuid "1eaaf3ea-1b6a-52bf-bb97-41ecec4b5bfd" :answer/type {:db/ident :answer.type/text} :answer/value "I and III only" :db/id #edb/ref 17592186171540} :answer-field/id #uuid "bebc62e1-5482-5ce4-89dd-f0906e6fc264" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186171535}] :question/id #uuid "72da8c2e-5747-5cf0-addd-5e327ef519dd" :question/math-academy-id "q-98036" :question/problem "![](/home/jake/Developer/MA/DATA/Lessons/3357/Source/Images/q-98036.png)\n\nWhich of the regions shown above are simply connected?"}]}
