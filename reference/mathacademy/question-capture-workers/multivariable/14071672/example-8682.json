  "proof_feedback": null,
  "html": "<div id=\"step-e8682\" class=\"step\" style=\"display: block;\">\n    \n                 \n                <div class=\"example\">\n                    <div class=\"stepHeader\">\n                        <div class=\"stepName\"><span class=\"stepType\">Example:</span> Identifying Connected Regions</div>       \n                        <div class=\"helpButton\" stepid=\"e8682\">?</div>\n                    </div>\n            \n                    <div class=\"exampleQuestion\">\n                        <p>Which of the following regions are connected?</p>\n<div id=\"graphic-8bc6eee716b3c35ded2c54628da21226\" class=\"graphic\"><img src=\"/graphics/8bc6eee716b3c35ded2c54628da21226\"></div>\n\n\n                    </div>     \n            \n                    <div class=\"exampleExplanationHeader\">EXPLANATION</div>\n            \n                    <div class=\"exampleExplanation\">\n                        <style type=\"text/css\">\n                            .mjpage .MJX-monospace {\n                            font-family: monospace\n                            }\n\n                            .mjpage .MJX-sans-serif {\n                            font-family: sans-serif\n                            }\n\n                            .mjpage {\n                            display: inline;\n                            font-style: normal;\n                            font-weight: normal;\n                            line-height: normal;\n                            font-size: 100%;\n                            font-size-adjust: none;\n                            text-indent: 0;\n                            text-align: left;\n                            text-transform: none;\n                            letter-spacing: normal;\n                            word-spacing: normal;\n                            word-wrap: normal;\n                            white-space: nowrap;\n                            float: none;\n                            direction: lt