d #uuid "60bff2cb-e1e3-5f42-9044-9ada3c2ae98e" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 4\\sqrt{3})" :db/id #edb/ref 17592186132037}] :answer-field/correct {:answer/id #uuid "41cfaaff-ed0d-596d-9958-df2dc78501d7" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4)" :db/id #edb/ref 17592186132036} :answer-field/id #uuid "738df0fd-bac8-51c6-8dab-997fca6c0b3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132032}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d7c864f9-8a06-59dd-91e8-789300497ddc" :question/math-academy-id "q-41263" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/34b473c8e212297d8cb434fe0a2dd9872cfa2fda924ac3a4d528bc1318af8c5f.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{5\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{5\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (\\frac{1}{2}) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$"}] [{:db/id #edb/ref 17592186280873 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30059b98-be76-5e64-84f4-a067ffe27dfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{5}" :db/id #edb/ref 17592186280875} {:answer/id #uuid "b7ba2630-36eb-555c-8bda-604f905690bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186280876} {:answer/id #uuid "384e4b95-c305-541c-a02b-424fc165840e" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{2\\pi }{5}" :db/id #edb/ref 17592186280877} {:answer/id #uuid "a11f951f-5431-55f2-92d0-7af42db47456" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{9\\pi }{5}" :db/id #edb/ref 17592186280878} {:answer/id #uuid "5c00750c-0622-51d2-a383-32bcbb57dcd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{5}" :db/id #edb/ref 17592186280879}] :answer-field/correct {:answer/id #uuid "b7ba2630-36eb-555c-8bda-604f905690bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186280876} :answer-field/id #uuid "d2c9dca2-e33d-5552-bbc3-b76df3e4caf0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280874}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "94fcca01-7833-5698-8331-09ba86372399" :question/math-academy-id "q-8616" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/e76766c18330d476af9253ecb2d08540df06146a9ac2fdc6bfbe6f8157201f6b.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi +\\frac{\\pi }{5}=\\frac{6\\pi }{5}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{6\\pi }{5}.$"}] [{:db/id #edb/ref 17592186280887 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "94c04524-f586-5840-aca7-1e94e4e2f476" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{2},3\\sqrt{2})" :db/id #edb/ref 17592186280889} {:answer/id #uuid "224bcd89-5caa-5691-ba4b-2f4d6fcc70fd" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,-3\\sqrt{3})" :db/id #edb/ref 17592186280890} {:answer/id #uuid "167202a1-76a6-5739-962c-6f02e75b82c0" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3\\sqrt{3})" :db/id #edb/ref 17592186280891} {:answer/id #uuid "1a41196c-4d3b-58e9-a563-55f2e4cedc34" :answer/type {:db/ident :answer.type/math} :answer/value "(3,-3\\sqrt{3})" :db/id #edb/ref 17592186280892} {:answer/id #uuid "b069363a-92f8-593b-9e3b-c08620bad3a7" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{3},3)" :db/id #edb/ref 17592186280893}] :answer-field/correct {:answer/id #uuid "167202a1-76a6-5739-962c-6f02e75b82c0" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3\\sqrt{3})" :db/id #edb/ref 17592186280891} :answer-field/id #uuid "b2decc71-3062-55f2-a60e-3571d178a7b6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280888}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "f9cc0f30-0e30-5e6d-ac7f-35bd27e7673c" :question/math-academy-id "q-87139" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13980294/assets/386a4b395d45276284606b0f079be16881af717ba7e791ab62d8df34743f0269.png)\n\nThe polar curve $r=6$ and the ray $\\theta =\\frac{2\\pi }{3}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(6,\\frac{2\\pi }{3}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (-\\frac{1}{2}) \\\\  & =-3 \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(\\frac{2\\pi }{3}) \\\\  & =6\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3}\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-3,3\\sqrt{3}).$"}]}
