592186308763}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "4660e160-164d-547c-b242-5f428a9e2e5f" :question/math-academy-id "q-120618" :question/problem "Which of the following is the graph of the polar curve  $\\theta =\\frac{7\\pi }{9}?$" :question/worked-solution "The polar curve defined by the equation $\\theta =\\frac{7\\pi }{9}$ is the ray that starts at the origin and makes a counterclockwise angle of $\\frac{7\\pi }{9}$ with the positive $x$-axis. \n\nTherefore, the angle it makes with the negative $x$-axis is \n\n$$\n\\pi -\\frac{7\\pi }{9}=\\frac{2\\pi }{9}.\n$$\n\n \n\nThe correct answer is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/7fc410b5c25ac19447288dbd50aa7621aac0c86f4a863787a8a12c5adb53686e.png)"}] [{:db/id #edb/ref 17592186308769 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d9cba7a3-3874-5e3a-999a-faf4f0147f4a" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{13\\pi }{15}" :db/id #edb/ref 17592186308771} {:answer/id #uuid "65875231-4f54-52ac-b385-fc009f009658" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{3}" :db/id #edb/ref 17592186308772} {:answer/id #uuid "e8755f11-0af7-545c-ad3c-f7b1dbd4317f" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{9\\pi }{15}" :db/id #edb/ref 17592186308773} {:answer/id #uuid "ca0b6e2e-d5f6-5011-a6f6-23255aceb737" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{11\\pi }{15}" :db/id #edb/ref 17592186308774} {:answer/id #uuid "13d551bd-34a0-52a5-a934-1b577b5f88db" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{15}" :db/id #edb/ref 17592186308775}] :answer-field/correct {:answer/id #uuid "13d551bd-34a0-52a5-a934-1b577b5f88db" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{15}" :db/id #edb/ref 17592186308775} :answer-field/id #uuid "d06d2ad3-c9d2-5285-a8c6-d86951e0d0f6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308770}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a7f4889a-ead3-5e37-b2a3-e29f54239e95" :question/math-academy-id "q-120653" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/d52d7a1e64de7618d5c9253ee00eafc43462e8a40e52fa7da671ef1f5a094e68.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi -\\frac{8\\pi }{15}=\\frac{7\\pi }{15}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{7\\pi }{15}.$"}] [{:db/id #edb/ref 17592186308776 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0d071e75-5a20-58bc-8b23-99becf02019f" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{11\\pi }{6}" :db/id #edb/ref 17592186308778} {:answer/id #uuid "0cc3daeb-0137-5cca-8647-0a3a98e7e057" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{4}" :db/id #edb/ref 17592186308779} {:answer/id #uuid "186c451e-e733-57af-ac09-62de6eae1c2e" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{3\\pi }{4}" :db/id #edb/ref 17592186308780} {:answer/id #uuid "92ef9eef-a08e-5c69-ba75-5701bb43ad2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{4}" :db/id #edb/ref 17592186308781} {:answer/id #uuid "42cba7d3-fb52-5e3f-83ba-8aaf5a88dbb1" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{4}" :db/id #edb/ref 17592186308782}] :answer-field/correct {:answer/id #uuid "92ef9eef-a08e-5c69-ba75-5701bb43ad2c" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{4}" :db/id #edb/ref 17592186308781} :answer-field/id #uuid "21796e9e-e3b1-5881-935a-c4f241dfab96" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308777}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e63d9542-f0fa-5e7c-b877-12da90a886e9" :question/math-academy-id "q-120665" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/4ec06d44ebac8021256a7ae130a55eb0972c70c5e01f26f6425143e3896eb441.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi +\\frac{3\\pi }{4}=\\frac{7\\pi }{4}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{7\\pi }{4}.$"}] [{:db/id #edb/ref 17592186307697 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "20819b41-67a2-5b7f-9867-e375985fe85e" :answer/type {:db/ident :answer.type/math} :answer/value "(-6\\sqrt{2},-8)" :db/id #edb/ref 17592186307699} {:answer/id #uuid "36e43af0-4e3b-57f7-b547-8abf5f44af31" :answer/type {:db/ident :answer.type/math} :answer/value "(-6\\sqrt{3},-6)" :db/id #edb/ref 17592186307700} {:answer/id #uuid "913ea399-1fc5-5f4a-a21f-1193ef384609" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3},-4)" :db/id #edb/ref 17592186307701} {:answer/id #uuid "a9730ffb-ade1-58b4-ac44-f48b23b73db1" :answer/type {:db/ident :answer.type/math} :answer/value "(-8\\sqrt{3},-8)" :db/id #edb/ref 17592186307702} {:answer/id #uuid "56f7130b-d735-5df5-bf6a-d79ea5239c29" :answer/type {:db/ident :answer.type/math} :answer/value "(-12\\sqrt{3},-12)" :db/id #edb/ref 17592186307703}] :answer-field/correct {:answer/id #uuid "36e43af0-4e3b-57f7-b547-8abf5f44af31" :answer/type {:db/ident :answer.type/math} :answer/value "(-6\\sqrt{3},-6)" :db/id #edb/ref 17592186307700} :answer-field/id #uuid "1f291c82-fb61-573e-b69d-b8bb4bc2eed9" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186307698}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "9300a06e-224a-5760-bf8d-1bf574e7c275" :question/math-academy-id "q-120719" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/3b1318b156281c7bc8724f988545d9f5c9fab2bda4ed88c387f051dbe5bece1e.png)\n\nThe polar curve $r=12$ and the ray $\\theta =\\frac{7\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(12,\\frac{7\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =12\\operatorname{cos}⁡(\\frac{7\\pi }{6}) \\\\  & =12\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-6\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =12\\operatorname{sin}⁡(\\frac{7\\pi }{6}) \\\\  & =12\\cdot (-\\frac{1}{2}) \\\\  & =-6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-6\\sqrt{3},-6).$"}] [{:db/id #edb/ref 17592186308783 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77edfa21-9e9f-5abb-9b50-8ca611839d7c" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{3},-3)" :db/id #edb/ref 17592186308785} {:answer/id #uuid "41fd0d7f-89bc-5171-846b-81958af77d2a" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{3},-3\\sqrt{3})" :db/id #edb/ref 17592186308786} {:answer/id #uuid "3b4012e0-c379-5ac2-91b4-f8ca77534215" :answer/type {:db/ident :answer.type/math} :answer/value "(-3\\sqrt{3},3\\sqrt{3})" :db/id #edb/ref 17592186308787} {:answer/id #uuid "2e3a311e-a831-5d22-8734-c423e776099f" :answer/type {:db/ident :answer.type/math} :answer/value "(-3,3)" :db/id #edb/ref 17592186308788} {:answer/id #uuid "568d2bb1-4f45-517d-ab45-68ee966db7c4" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{2},-3\\sqrt{2})" :db/id #edb/ref 17592186308789}] :answer-field/correct {:answer/id #uuid "77edfa21-9e9f-5abb-9b50-8ca611839d7c" :answer/type {:db/ident :answer.type/math} :answer/value "(3\\sqrt{3},-3)" :db/id #edb/ref 17592186308785} :answer-field/id #uuid "5ef17ec4-4afd-5919-90a6-4f63cd444f4b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308784}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "fffb59d3-cca6-5381-9439-7548b7d65a74" :question/math-academy-id "q-120725" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/d8bbcd878edaef5d3f5b92d106a071444f20c72f3d419689d15644a4842a2d45.png)\n\nThe polar curve $r=6$ and the ray $\\theta =\\frac{11\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(6,\\frac{11\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\operatorname{cos}⁡(\\frac{11\\pi }{6}) \\\\  & =6\\cdot (\\frac{\\sqrt{3}}{2}) \\\\  & =3\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\operatorname{sin}⁡(\\frac{11\\pi }{6}) \\\\  & =6\\cdot (-\\frac{1}{2}) \\\\  & =-3\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(3\\sqrt{3},-3).$"}] [{:db/id #edb/ref 17592186280828 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4650445f-fe67-5c51-9c97-951a7acb0bc7" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{26\\pi }{15}" :db/id #edb/ref 17592186280830} {:answer/id #uuid "5a2ac67e-7b7e-5108-a0c2-4421dcf0e882" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{15}" :db/id #edb/ref 17592186280831} {:answer/id #uuid "e38a772b-0f31-5524-aca3-b31e22edfc74" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{15}" :db/id #edb/ref 17592186280832} {:answer/id #uuid "bba5ee2e-5aa4-51b6-9ef9-21e29b1837eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{19\\pi }{15}" :db/id #edb/ref 17592186280833} {:answer/id #uuid "8539c6fb-0486-5bc7-a6b1-fb6f88e1f3a7" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{11\\pi }{15}" :db/id #edb/ref 17592186280834}] :answer-field/correct {:answer/id #uuid "bba5ee2e-5aa4-51b6-9ef9-21e29b1837eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{19\\pi }{15}" :db/id #edb/ref 17592186280833} :answer-field/id #uuid "4b075980-b8ae-55d6-b30c-765aa3eba0ab" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280829}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "a5a952bc-ebaf-5525-bf7b-5b10a4e51c46" :question/math-academy-id "q-17151" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/4a908a59498e1bccef0601ce813ef0a4fa2b7e965c944c9951b13a9f50256459.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi +\\frac{4\\pi }{15}=\\frac{19\\pi }{15}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{19\\pi }{15}.$"}] [{:db/id #edb/ref 17592186308790 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "895369e6-c16e-5d29-969e-446a6c49885d" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{2\\pi }{3}" :db/id #edb/ref 17592186308792} {:answer/id #uuid "bc830c5b-fe18-5dbf-ac4e-f7b8c5a9315d" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{6}" :db/id #edb/ref 17592186308793} {:answer/id #uuid "020f1180-8560-5ae8-8ac6-1f89bc6fc69b" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{3}" :db/id #edb/ref 17592186308794} {:answer/id #uuid "5158bbeb-ba70-50b3-8da6-8b415b43f5eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{3}" :db/id #edb/ref 17592186308795} {:answer/id #uuid "c11d7e5c-bc8f-5de0-a2f6-d8cc1cc06db0" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{3}" :db/id #edb/ref 17592186308796}] :answer-field/correct {:answer/id #uuid "5158bbeb-ba70-50b3-8da6-8b415b43f5eb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{3}" :db/id #edb/ref 17592186308795} :answer-field/id #uuid "e0b41517-9d29-5c76-bdc3-9114bb649974" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308791}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "88a106f3-b03f-57fc-a519-6c763e438e5c" :question/math-academy-id "q-17161" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/11a75207b0adee9fad857aa93f15772e730716b7cc9d5fae7ba39fc5f55418f0.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(5,-5\\sqrt{3})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-5\\sqrt{3}}{5}| \\\\  & =\\operatorname{arctan}⁡\\sqrt{3} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the fourth quadrant. So, we find the angle in the fourth quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =2\\pi -{\\theta }_{R} \\\\  & =2\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{5\\pi }{3}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{5\\pi }{3}.\n$$"}] [{:db/id #edb/ref 17592186308797 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "60949875-ad4b-5d7e-ab1f-1f75869d5a6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi}{3}" :db/id #edb/ref 17592186308799}] :answer-field/correct {:answer/id #uuid "60949875-ad4b-5d7e-ab1f-1f75869d5a6b" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{4\\pi}{3}" :db/id #edb/ref 17592186308799} :answer-field/id #uuid "4bbda075-92a3-5513-a664-87f32678d35f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308798}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "3e5a84bb-82a4-53ae-95b9-861c6b48cf19" :question/math-academy-id "q-274767" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/1fe85402830f5976b8de6613464c358a47c185869d44a495f1efa9caed73e04c.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-5,-5\\sqrt{3}),$ find the polar equation of the ray. Assume that the polar angle is in the range $[0,2\\pi ).$\n\n$\\theta =$\n{{field-1}}." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-5\\sqrt{3}}{-5}| \\\\  & =\\operatorname{arctan}⁡\\sqrt{3} \\\\  & =\\frac{\\pi }{3}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the third quadrant. So, we find the angle in the third quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{3},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{3} \\\\  & =\\frac{4\\pi }{3}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{4\\pi }{3}.\n$$"}] [{:db/id #edb/ref 17592186308800 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "7edd8c0e-8e59-571a-a4e3-20a186958b60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186308802} {:answer/id #uuid "ac3e5c0e-011f-5839-b56d-99e4aa68acd6" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{5}{3}" :db/id #edb/ref 17592186308803}] :answer-field/correct {:answer/id #uuid "7edd8c0e-8e59-571a-a4e3-20a186958b60" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{3}{5}" :db/id #edb/ref 17592186308802} :answer-field/id #uuid "b65a82ee-d706-5de7-96a5-d41f5b94957d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308801}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "e6c959a6-46d2-5e2c-9bea-847c805ea0c6" :question/math-academy-id "q-321384" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/afa5a80d73d9d8511cc35804277ad9dc3f1b62b2e1dbe3911d6ea9d665c3baa8.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(5,3),$ find the polar equation of the ray. Assume that the polar angle is in the range $[0,2\\pi ).$\n\n$\\theta =$ \n$\\operatorname{arctan}⁡($ {{field-1}} \n$).$" :question/worked-solution "The angle that the ray makes with the positive $x$-axis is \n\n$$\n\\begin{aligned}\\theta  & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{3}{5}).\\end{aligned}\n$$\n\nTherefore, since the ray lies in the first quadrant, the polar equation is  \n\n$$\n\\theta =\\operatorname{arctan}⁡(\\,\\frac{3}{5}\\,).\n$$"}] [{:db/id #edb/ref 17592186308804 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f845f32-0b5d-5d33-85cf-fe109b255eaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{6}" :db/id #edb/ref 17592186308806}] :answer-field/correct {:answer/id #uuid "4f845f32-0b5d-5d33-85cf-fe109b255eaa" :answer/type {:db/ident :answer.type/math} :answer/value "\\frac{7\\pi}{6}" :db/id #edb/ref 17592186308806} :answer-field/id #uuid "db1ca8dc-ee50-5109-95c9-e3c56aa97366" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308805}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "c1a116a1-5be2-57cd-ab23-bacb48cabc85" :question/math-academy-id "q-321898" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/b07f18c13e3bca94d2b55d61b4a63b2a294d0e47ed8a2853f5e10c5140047b27.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-3\\sqrt{3},-3),$ find the polar equation of the ray. Assume that the polar angle is in the range $[0,2\\pi ).$\n\n$\\theta =$\n{{field-1}}." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-3}{-3\\sqrt{3}}| \\\\  & =\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the third quadrant. So, we find the angle in the third quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{7\\pi }{6}.\n$$"}] [{:db/id #edb/ref 17592186308807 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "23437580-af33-5532-8b28-12b8403481dd" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186308809}] :answer-field/correct {:answer/id #uuid "23437580-af33-5532-8b28-12b8403481dd" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186308809} :answer-field/id #uuid "60832ce1-9940-558e-bb8a-ac1fbd44495f" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308808} {:answer-field/choices [{:answer/id #uuid "8244dc1f-5f7f-53f3-82e9-825735b1aac3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186308811}] :answer-field/correct {:answer/id #uuid "8244dc1f-5f7f-53f3-82e9-825735b1aac3" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186308811} :answer-field/id #uuid "590fa078-5e18-5f15-917a-7849ff5b53bf" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186308810}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "bcaa98ac-5620-5ad5-b3d4-f9e5ed073000" :question/math-academy-id "q-321972" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/6aeb571c312e4dcc0f9ffc4fe2ad9b1a1db5cf02a2f757b66191e31337a8c498.png)\n\nThe polar curve $r=6\\sqrt{2}$ and the ray $\\theta =\\frac{3\\pi }{4}$ intersect at the point $P,$ as shown above. The Cartesian coordinates of $P$ are$\\,(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(6\\sqrt{2},\\frac{3\\pi }{4}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =6\\sqrt{2}\\,cos\\,(\\frac{3\\pi }{4}) \\\\  & =6\\sqrt{2}\\cdot \\,(-\\frac{\\sqrt{2}}{2}) \\\\  & =-6 \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =6\\sqrt{2}\\,sin\\,(\\frac{3\\pi }{4}) \\\\  & =6\\sqrt{2}\\cdot \\frac{\\sqrt{2}}{2} \\\\  & =6\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-6,6).$"}] [{:db/id #edb/ref 17592186134246 :knowledge-point/_questions [{:knowledge-point/id #uuid "407616a9-e448-5652-9882-a1edf19600f8" :knowledge-point/title "Identifying a Radial Line Given Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c76a8e01-64ec-54cc-80fe-0d17a74a6292" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2173/Source/Images/q-40827-a-5.png" :db/id #edb/ref 17592186131919} {:answer/id #uuid "f53b07be-08f9-573e-9a5d-7be93a649963" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2173/Source/Images/q-40827-a-2.png" :db/id #edb/ref 17592186131920} {:answer/id #uuid "014ffb84-00eb-5ee2-ae2a-7292acd0253b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2173/Source/Images/q-40827-a-3.png" :db/id #edb/ref 17592186131921} {:answer/id #uuid "3b7195f5-4f76-5b96-a56a-e4094ca782d0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2173/Source/Images/q-40827-a-1.png" :db/id #edb/ref 17592186131922} {:answer/id #uuid "6c0bf195-d2a9-59ee-aded-0432019e200e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2173/Source/Images/q-40827-a-4.png" :db/id #edb/ref 17592186131923}] :answer-field/correct {:answer/id #uuid "3b7195f5-4f76-5b96-a56a-e4094ca782d0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/MA/DATA/Lessons/2173/Source/Images/q-40827-a-1.png" :db/id #edb/ref 17592186131922} :answer-field/id #uuid "a275a658-923b-54bf-a81d-49201f4f704f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186131918}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "0890fa8e-8ae6-5c17-809d-33ce342c7231" :question/math-academy-id "q-40827" :question/problem "Which of the following is the graph of the polar curve $\\theta =\\frac{5\\pi }{8}?$" :question/worked-solution "The polar curve defined by the equation $\\theta =\\frac{5\\pi }{8}$ is the ray that starts at the origin and makes a counterclockwise angle of $\\frac{5\\pi }{8}$ with the positive $x$-axis. \n\nTherefore, the angle it makes with the negative $x$-axis is \n\n$$\n\\pi -\\frac{5\\pi }{8}=\\frac{3\\pi }{8}.\n$$\n\n \n\nThe correct answer is shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/da2dcf4835abda052f4e7e865fcb652abf5a2d4a482d64ba062e39030e5596c6.png)"}] [{:db/id #edb/ref 17592186308812 :knowledge-point/_questions [{:knowledge-point/id #uuid "d90b9572-cdac-51f7-b386-81b750642585" :knowledge-point/title "Finding the Polar Equation of a Radial Line That Passes Through a Given Point"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "58e4031b-29b2-52fe-9477-45a81cd5cda0" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{11\\pi }{6}" :db/id #edb/ref 17592186308814} {:answer/id #uuid "ab41cbf5-c9a7-5e7c-8d18-a93c055845bd" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{6}" :db/id #edb/ref 17592186308815} {:answer/id #uuid "c4822ac9-1eaa-53b5-b4f4-cd76a1d72973" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{5\\pi }{3}" :db/id #edb/ref 17592186308816} {:answer/id #uuid "36979e07-cf9c-5b5f-9024-acb342620044" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186308817} {:answer/id #uuid "21e85f79-2a92-5bf7-8844-d2d4a3ffc72f" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{3}" :db/id #edb/ref 17592186308818}] :answer-field/correct {:answer/id #uuid "36979e07-cf9c-5b5f-9024-acb342620044" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{7\\pi }{6}" :db/id #edb/ref 17592186308817} :answer-field/id #uuid "34689735-8a28-52f5-b1ca-c3b57b5a59e1" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186308813}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b2490317-067b-513c-9277-23bae0b21e71" :question/math-academy-id "q-40913" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/19f94b8985a4b8da7899f984e0e1c3f88668aa59531658cd0118edb35aab1107.png)\n\nGiven that the ray above passes through the point with Cartesian coordinates $(-6,-2\\sqrt{3})$, find the polar equation of the ray." :question/worked-solution "First, we find the reference angle associated with the point:\n\n$$\n\\begin{aligned}{\\theta }_{R} & =\\operatorname{arctan}⁡|\\frac{y}{x}| \\\\  & =\\operatorname{arctan}⁡|\\frac{-2\\sqrt{3}}{-6}| \\\\  & =\\operatorname{arctan}⁡(\\frac{\\sqrt{3}}{3}) \\\\  & =\\frac{\\pi }{6}\\end{aligned}\n$$\n\nNow, notice that the ray lies in the third quadrant. So, we find the angle in the third quadrant that has a reference angle ${\\theta }_{R}=\\frac{\\pi }{6},$ as follows:\n\n$$\n\\begin{aligned}\\theta  & =\\pi +{\\theta }_{R} \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}\\end{aligned}\n$$\n\nTherefore, the polar equation of the ray is \n\n$$\n\\theta =\\frac{7\\pi }{6}.\n$$"}] [{:db/id #edb/ref 17592186134265 :knowledge-point/_questions [{:knowledge-point/id #uuid "fc8d4944-9005-5712-ad88-744dac83603e" :knowledge-point/title "Finding the Point of Intersection of a Circle and a Radial Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "981ba4e7-33c9-5a7e-948f-f50fe4763a70" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 4\\sqrt{2})" :db/id #edb/ref 17592186132033} {:answer/id #uuid "b0585a0b-e1b5-5899-b51c-f2f6767c418d" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4\\sqrt{2})" :db/id #edb/ref 17592186132034} {:answer/id #uuid "dc9ee54c-fd00-5bee-aef8-d5893a35e049" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4\\sqrt{3})" :db/id #edb/ref 17592186132035} {:answer/id #uuid "41cfaaff-ed0d-596d-9958-df2dc78501d7" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4)" :db/id #edb/ref 17592186132036} {:answer/id #uuid "60bff2cb-e1e3-5f42-9044-9ada3c2ae98e" :answer/type {:db/ident :answer.type/math} :answer/value "(-4, 4\\sqrt{3})" :db/id #edb/ref 17592186132037}] :answer-field/correct {:answer/id #uuid "41cfaaff-ed0d-596d-9958-df2dc78501d7" :answer/type {:db/ident :answer.type/math} :answer/value "(-4\\sqrt{3}, 4)" :db/id #edb/ref 17592186132036} :answer-field/id #uuid "738df0fd-bac8-51c6-8dab-997fca6c0b3e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186132032}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d7c864f9-8a06-59dd-91e8-789300497ddc" :question/math-academy-id "q-41263" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/34b473c8e212297d8cb434fe0a2dd9872cfa2fda924ac3a4d528bc1318af8c5f.png)\n\nThe polar curve $r=8$ and the ray $\\theta =\\frac{5\\pi }{6}$ intersect at the point $P,$ as shown above. What are the Cartesian coordinates of $P?$" :question/worked-solution "The polar coordinates of $P$ are $(r,\\theta )=(8,\\frac{5\\pi }{6}).$ We can convert the polar coordinates of $P$ to Cartesian coordinates, as follows:\n\n$$\n\\begin{aligned}x & =r\\operatorname{cos}⁡\\theta  \\\\  & =8\\operatorname{cos}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (-\\frac{\\sqrt{3}}{2}) \\\\  & =-4\\sqrt{3} \\\\ y & =r\\operatorname{sin}⁡\\theta  \\\\  & =8\\operatorname{sin}⁡(\\frac{5\\pi }{6}) \\\\  & =8\\cdot (\\frac{1}{2}) \\\\  & =4\\end{aligned}\n$$\n\nTherefore, the Cartesian coordinates of $P$ are $(-4\\sqrt{3},4).$"}] [{:db/id #edb/ref 17592186280873 :knowledge-point/_questions [{:knowledge-point/id #uuid "75c0168a-efdc-5162-a961-aae318783e50" :knowledge-point/title "Finding the Polar Equation of a Radial Line Given an Acute Angle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30059b98-be76-5e64-84f4-a067ffe27dfe" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{4\\pi }{5}" :db/id #edb/ref 17592186280875} {:answer/id #uuid "b7ba2630-36eb-555c-8bda-604f905690bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186280876} {:answer/id #uuid "384e4b95-c305-541c-a02b-424fc165840e" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{2\\pi }{5}" :db/id #edb/ref 17592186280877} {:answer/id #uuid "a11f951f-5431-55f2-92d0-7af42db47456" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{9\\pi }{5}" :db/id #edb/ref 17592186280878} {:answer/id #uuid "5c00750c-0622-51d2-a383-32bcbb57dcd8" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{\\pi }{5}" :db/id #edb/ref 17592186280879}] :answer-field/correct {:answer/id #uuid "b7ba2630-36eb-555c-8bda-604f905690bb" :answer/type {:db/ident :answer.type/math} :answer/value "\\theta =\\frac{6\\pi }{5}" :db/id #edb/ref 17592186280876} :answer-field/id #uuid "d2c9dca2-e33d-5552-bbc3-b76df3e4caf0" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186280874}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "94fcca01-7833-5698-8331-09ba86372399" :question/math-academy-id "q-8616" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/e76766c18330d476af9253ecb2d08540df06146a9ac2fdc6bfbe6f8157201f6b.png)\n\nWhat is the polar equation of the ray shown above?" :question/worked-solution "The counterclockwise angle that the ray makes with the positive $x$-axis is\n\n$$\n\\pi +\\frac{\\pi }{5}=\\frac{6\\pi }{5}.\n$$\n\nTherefore, the polar equation of the ray is $\\theta =\\frac{6\\pi }{5}.$"}] [{:db/id #edb/ref 17592186308819 :knowledge-point/_questions [{:knowledge-point/id #uuid "407616a9-e448-5652-9882-a1edf19600f8" :knowledge-point/title "Identifying a Radial Line Given Its Polar Equation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ab448d28-7b11-52ec-8034-6382e92e0e13" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/16b0fe5e7b15bf87b41374bf20c8f68e67e960c13fcfd7049e5fde5b51c268e1.png" :db/id #edb/ref 17592186308821} {:answer/id #uuid "99e09db1-76d8-50f1-813f-1bc900628ab8" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/c253607aaf43f12cf91ca5fa1a8b421ca18a4e6fd74617d49396195a0c8e94e5.png" :db/id #edb/ref 17592186308822} {:answer/id #uuid "904faaeb-f3fa-5491-a866-1b1b2c75a545" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/6426b2cd6d31ed0ab1308441fc039122c607f2247baa5ab2072dcb64d5977854.png" :db/id #edb/ref 17592186308823} {:answer/id #uuid "7b7018b0-6520-5487-8532-ca8a1d70ae3b" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14040587/assets/84f8f00ecc782938bc9aa1dbd272b