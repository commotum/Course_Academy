ultivariable/14079767/assets/963f8812eb8226617c7d893ebdf675747ebed12c92fc6369de2b153a1c2e3b58.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the semicircle of radius $2,$ transversed from the point $(1,-2)$ to the point $(1,2),$ as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=2$ and ${y}_{1}=-2.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=2-(-2)=4.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124335/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f"] :knowledge-point/questions ["q-124335"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124348/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "c1b140f9-0126-5e9d-aee1-949b6ecaa0da" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-124348/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "15cd8b37-1d49-5806-a2cd-877846ad77ac" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-124348/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "0393b25f-8f1f-5b71-9b43-1bc743b1ff22" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-124348/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "6c9a8c92-136f-5897-94bf-51d9591b252c" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-124348/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "8935c6f3-fe8e-5f58-891e-7ae31762fefb" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-124348/selection" :answer-field/id #uuid "8f4dad67-bf35-5f45-84ae-d4b95a5a8a84" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124348/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-124348/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-124348/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-124348/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-124348/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-124348/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa"] :db/ensure [:answer-field/validate]} {:db/id "q-124348" :question/id #uuid "989c8a49-08c9-5f92-908c-bc35137799f4" :question/math-academy-id "q-124348" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14079767/assets/9b3065e58decfca5355252b93ec3283cc5ffc96dc04826aeab1131e95d3a2e64.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$ where $C$ is the closed path along the rectangle, traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-124348/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f"] :knowledge-point/questions ["q-124348"] :db/ensure [:knowledge-point/validate]}]
