[{:db/id "q-124180/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer/id #uuid "ee8fa55c-709a-545b-aed4-11d72f6793e7" :answer/type :answer.type/math :answer/value "-3" :db/ensure [:answer/validate]} {:db/id "q-124180/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" :answer/id #uuid "c9abf89e-9854-54bd-a770-baf94bf51389" :answer/type :answer.type/math :answer/value "-5" :db/ensure [:answer/validate]} {:db/id "q-124180/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "fdbc1140-0aab-5f33-8213-cc97a2d4978e" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-124180/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "55592abc-a217-5520-bd36-3727bcde50a9" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-124180/selection/1b9761d437e98dd374daf86a09146d91bc3b1036c06a1f6466d61824390fba31" :answer/id #uuid "f108c379-a699-52ff-aa6a-dba39bdc9133" :answer/type :answer.type/text :answer/value "Impossible to determine" :db/ensure [:answer/validate]} {:db/id "q-124180/selection" :answer-field/id #uuid "d1a1a5fe-1049-5994-acbc-2ba14abded63" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124180/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" :answer-field/choices ["q-124180/selection/b13ac151352392d38026eed875b911708c50c896d6c09463410ac041030163ff" "q-124180/selection/4de395131b8c6206950603752bf3404c42f4dd6f0a41fee38e42388d1b92c133" "q-124180/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-124180/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" "q-124180/selection/1b9761d437e98dd374daf86a09146d91bc3b1036c06a1f6466d61824390fba31"] :db/ensure [:answer-field/validate]} {:db/id "q-124180" :question/id #uuid "3519d3b9-907f-5504-bc37-f57a71871ff7" :question/math-academy-id "q-124180" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x=-1$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x=4,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-(-1)-4 \\\\  & =-3.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124180/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae"] :knowledge-point/questions ["q-124180"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124185/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" :answer/id #uuid "85646987-4de4-579c-87de-6b3fe028fea9" :answer/type :answer.type/math :answer/value "10" :db/ensure [:answer/validate]} {:db/id "q-124185/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" :answer/id #uuid "fb7a954f-d28e-5a87-a941-dc97927a89ad" :answer/type :answer.type/math :answer/value "-6" :db/ensure [:answer/validate]} {:db/id "q-124185/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer/id #uuid "84d2556d-41dc-5400-8636-fd2ce4b81424" :answer/type :answer.type/math :answer/value "6" :db/ensure [:answer/validate]} {:db/id "q-124185/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "39691c87-4690-549a-ae88-c6bf6593f3bd" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-124185/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97" :answer/id #uuid "27d3c5ba-fdb0-575b-ae6e-b37f0f6949e7" :answer/type :answer.type/math :answer/value "12" :db/ensure [:answer/validate]} {:db/id "q-124185/selection" :answer-field/id #uuid "3f607e77-9041-5e10-b2c5-c227273fa4b5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124185/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" :answer-field/choices ["q-124185/selection/56019ff80d11d678dbd5eca83c729f420f1b6a8ad4259032846618d6b48aa0bc" "q-124185/selection/f853eeffac47c628af4a2b7e7b0ecd024652f548b0b0007bc18dba21ad82ad7c" "q-124185/selection/a0e0e68f25b8b46aafef3b74aff7beff7fddc6de5bf36921680b04c7b0e6ffaa" "q-124185/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-124185/selection/0f0db3a18f1d79c4863315eefe754cc5306e04e7aeebf4414ffedb95d6f1bc97"] :db/ensure [:answer-field/validate]} {:db/id "q-124185" :question/id #uuid "1c96b0a9-7e9f-5669-8863-2dd6417e54b1" :question/math-academy-id "q-124185" :question/problem "If ${\\int }_{-C}f(x,y)\\,\\text{d}y=9$ and ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y=-3,$ calculate ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\ -{\\int }_{-C}f(x,y)\\,\\text{d}y & =-3-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ -9 & =-3-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ -6 & =-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y=6.\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-124185/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae"] :knowledge-point/questions ["q-124185"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124334/selection/7336f16cf9437bd809ce5e09d7dc666eb175d0cf5c31ff077c77f0542ed57f13" :answer/id #uuid "cec34066-4c63-5187-ab1d-840d1cff97e7" :answer/type :answer.type/math :answer/value "\\sqrt{13}" :db/ensure [:answer/validate]} {:db/id "q-124334/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "c16f633c-fd62-5961-bf83-3e09df0797ff" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-124334/selection/acef992fb39721d841ec3f7ae845d83fa3db5584fec4244c8841c167f583bda4" :answer/id #uuid "5c82571c-9298-5d1c-a99f-25828fc91d09" :answer/type :answer.type/math :answer/value "-\\sqrt{13}" :db/ensure [:answer/validate]} {:db/id "q-124334/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" :answer/id #uuid "4af67b7d-c259-5c43-8fbf-8ee4b2252ccf" :answer/type :answer.type/math :answer/value "-2" :db/ensure [:answer/validate]} {:db/id "q-124334/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54" :answer/id #uuid "4cd318d7-1e2c-5212-b96f-b3c4e7b5a309" :answer/type :answer.type/math :answer/value "3" :db/ensure [:answer/validate]} {:db/id "q-124334/selection" :answer-field/id #uuid "8e898532-1d7e-5841-a60c-0bf856dbb14e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-124334/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-124334/selection/7336f16cf9437bd809ce5e09d7dc666eb175d0cf5c31ff077c77f0542ed57f13" "q-124334/selection/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" "q-124334/selection/acef992fb39721d841ec3f7ae845d83fa3db5584fec4244c8841c167f583bda4" "q-124334/selection/f80535409f78d0e1b5cd0ceb7e72783093e3cde8adf28a5032c83c6dc6b5e490" "q-124334/selection/62a6fd1cf465955cead36d661dcbed2f93206049c15d21d7eebcabb802d1aa54"] :db/ensure [:answer-field/validate]} {:db/id "q-124334" :question/id #uuid "dcfd567a-7436-5322-b2e9-12547609c1c7" :question/math-academy-id "q-124334" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14079767/assets/9c42d875a65a6b54ad7769180f5ec2e831772ad44a89ec913951da40c6d90514.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the line segment between the points $(-3,0)$ to the point $(0,2),$ as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=2$ and ${y}_{1}=0.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=2-0=2.\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-124334/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f"] :knowledge-point/questions ["q-124334"] :db/ensure [:knowledge-point/validate]} {:db/id "q-124335/selection/1a2c3881891ab7eca8aa4af8d7002d84b8252f633df18da1be453e64ebd8a8b4" :answer/id #uuid "12ffbc72-7bee-57d5-9bc8-a09064531