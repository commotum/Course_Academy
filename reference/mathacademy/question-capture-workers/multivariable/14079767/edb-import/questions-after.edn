#{[{:db/id #edb/ref 17592186385904 :knowledge-point/_questions [{:knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f108c379-a699-52ff-aa6a-dba39bdc9133" :answer/type {:db/ident :answer.type/text} :answer/value "Impossible to determine" :db/id #edb/ref 17592186385906} {:answer/id #uuid "c9abf89e-9854-54bd-a770-baf94bf51389" :answer/type {:db/ident :answer.type/math} :answer/value "-5" :db/id #edb/ref 17592186385907} {:answer/id #uuid "55592abc-a217-5520-bd36-3727bcde50a9" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186385908} {:answer/id #uuid "ee8fa55c-709a-545b-aed4-11d72f6793e7" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186385909} {:answer/id #uuid "fdbc1140-0aab-5f33-8213-cc97a2d4978e" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186385910}] :answer-field/correct {:answer/id #uuid "ee8fa55c-709a-545b-aed4-11d72f6793e7" :answer/type {:db/ident :answer.type/math} :answer/value "-3" :db/id #edb/ref 17592186385909} :answer-field/id #uuid "d1a1a5fe-1049-5994-acbc-2ba14abded63" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385905}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3519d3b9-907f-5504-bc37-f57a71871ff7" :question/math-academy-id "q-124180" :question/problem "If ${\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x=-1$ and ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x=4,$ calculate ${\\int }_{C}f(x,y)\\,\\text{d}x$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $x,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}x=-{\\int }_{C}f(x,y)\\,\\text{d}x$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}x={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x$\n\nIn our case, we have\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}x & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}x+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-{\\int }_{-{C}_{1}}f(x,y)\\,\\text{d}x-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}x \\\\  & =-(-1)-4 \\\\  & =-3.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186385911 :knowledge-point/_questions [{:knowledge-point/id #uuid "2fd19952-77af-5f27-a7ef-adf46b1958ae" :knowledge-point/title "Orientation-Dependence"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "27d3c5ba-fdb0-575b-ae6e-b37f0f6949e7" :answer/type {:db/ident :answer.type/math} :answer/value "12" :db/id #edb/ref 17592186385913} {:answer/id #uuid "85646987-4de4-579c-87de-6b3fe028fea9" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id #edb/ref 17592186385914} {:answer/id #uuid "84d2556d-41dc-5400-8636-fd2ce4b81424" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186385915} {:answer/id #uuid "39691c87-4690-549a-ae88-c6bf6593f3bd" :answer/type {:db/ident :answer.type/math} :answer/value "-12" :db/id #edb/ref 17592186385916} {:answer/id #uuid "fb7a954f-d28e-5a87-a941-dc97927a89ad" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186385917}] :answer-field/correct {:answer/id #uuid "84d2556d-41dc-5400-8636-fd2ce4b81424" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186385915} :answer-field/id #uuid "3f607e77-9041-5e10-b2c5-c227273fa4b5" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385912}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "1c96b0a9-7e9f-5669-8863-2dd6417e54b1" :question/math-academy-id "q-124185" :question/problem "If ${\\int }_{-C}f(x,y)\\,\\text{d}y=9$ and ${\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y=-3,$ calculate ${\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y$ given that $C={C}_{1}\\cup {C}_{2}.$" :question/worked-solution "Let $C={C}_{1}\\cup {C}_{2}$ be a piecewise smooth path in the $xy$-plane, and let $-C$ be the curve consisting of the same points as $C$ but with the opposite orientation. \n\nFor line integrals with respect to $y,$ we have the following properties:\n\n- ${\\int }_{-C}f(x,y)\\,\\text{d}y=-{\\int }_{C}f(x,y)\\,\\text{d}y$\n\n- ${\\int }_{C}f(x,y)\\,\\text{d}y={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y$\n\nIn our case, we have:\n\n$$\n\\begin{aligned}{\\int }_{C}f(x,y)\\,\\text{d}y & ={\\int }_{{C}_{1}}f(x,y)\\,\\text{d}y+{\\int }_{{C}_{2}}f(x,y)\\,\\text{d}y \\\\ -{\\int }_{-C}f(x,y)\\,\\text{d}y & =-3-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ -9 & =-3-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y \\\\ -6 & =-{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y\\end{aligned}\n$$\n\nTherefore,\n\n$$\n{\\int }_{-{C}_{2}}f(x,y)\\,\\text{d}y=6.\n$$"}] [{:db/id #edb/ref 17592186385918 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4cd318d7-1e2c-5212-b96f-b3c4e7b5a309" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186385920} {:answer/id #uuid "cec34066-4c63-5187-ab1d-840d1cff97e7" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{13}" :db/id #edb/ref 17592186385921} {:answer/id #uuid "c16f633c-fd62-5961-bf83-3e09df0797ff" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385922} {:answer/id #uuid "5c82571c-9298-5d1c-a99f-25828fc91d09" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{13}" :db/id #edb/ref 17592186385923} {:answer/id #uuid "4af67b7d-c259-5c43-8fbf-8ee4b2252ccf" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385924}] :answer-field/correct {:answer/id #uuid "c16f633c-fd62-5961-bf83-3e09df0797ff" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385922} :answer-field/id #uuid "8e898532-1d7e-5841-a60c-0bf856dbb14e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385919}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "dcfd567a-7436-5322-b2e9-12547609c1c7" :question/math-academy-id "q-124334" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14079767/assets/9c42d875a65a6b54ad7769180f5ec2e831772ad44a89ec913951da40c6d90514.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the line segment between the points $(-3,0)$ to the point $(0,2),$ as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=2$ and ${y}_{1}=0.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=2-0=2.\n$$"}] [{:db/id #edb/ref 17592186385925 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "12ffbc72-7bee-57d5-9bc8-a09064531d3f" :answer/type {:db/ident :answer.type/math} :answer/value "4\\pi " :db/id #edb/ref 17592186385927} {:answer/id #uuid "64564654-50d8-574a-bfa1-3aec40626c31" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385928} {:answer/id #uuid "731df402-3c40-5856-9967-4e925abd49d4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385929} {:answer/id #uuid "3b0eb205-a1f4-5272-89cf-1c990ecb7ff8" :answer/type {:db/ident :answer.type/math} :answer/value "2\\pi " :db/id #edb/ref 17592186385930} {:answer/id #uuid "5b715fc5-c71e-5016-8859-f6e1d7ac5dc7" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385931}] :answer-field/correct {:answer/id #uuid "731df402-3c40-5856-9967-4e925abd49d4" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186385929} :answer-field/id #uuid "46004ac4-6737-5864-9a87-38fb6afc792f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385926}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ed9e59c2-128f-56cf-9d05-c9faea75e698" :question/math-academy-id "q-124335" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14079767/assets/963f8812eb8226617c7d893ebdf675747ebed12c92fc6369de2b153a1c2e3b58.png)\n\nCalculate ${\\int }_{C}\\,\\text{d}y,$ where $C$ is the path along the semicircle of radius $2,$ transversed from the point $(1,-2)$ to the point $(1,2),$ as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, ${y}_{2}=2$ and ${y}_{1}=-2.$ Therefore,\n\n$$\n{\\int }_{C}\\,\\text{d}y={y}_{2}-{y}_{1}=2-(-2)=4.\n$$"}] [{:db/id #edb/ref 17592186385932 :knowledge-point/_questions [{:knowledge-point/id #uuid "e6935944-0acd-5593-aa80-e56f6014c13f" :knowledge-point/title "Line Integrals of Unity With Respect to Y"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "0393b25f-8f1f-5b71-9b43-1bc743b1ff22" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186385934} {:answer/id #uuid "8935c6f3-fe8e-5f58-891e-7ae31762fefb" :answer/type {:db/ident :answer.type/math} :answer/value "6" :db/id #edb/ref 17592186385935} {:answer/id #uuid "15cd8b37-1d49-5806-a2cd-877846ad77ac" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385936} {:answer/id #uuid "6c9a8c92-136f-5897-94bf-51d9591b252c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186385937} {:answer/id #uuid "c1b140f9-0126-5e9d-aee1-949b6ecaa0da" :answer/type {:db/ident :answer.type/math} :answer/value "-6" :db/id #edb/ref 17592186385938}] :answer-field/correct {:answer/id #uuid "15cd8b37-1d49-5806-a2cd-877846ad77ac" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186385936} :answer-field/id #uuid "8f4dad67-bf35-5f45-84ae-d4b95a5a8a84" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186385933}] :question/difficulty {:db/id #edb/ref 17592186045464 :db/ident :question.difficulty/hard} :question/id #uuid "989c8a49-08c9-5f92-908c-bc35137799f4" :question/math-academy-id "q-124348" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14079767/assets/9b3065e58decfca5355252b93ec3283cc5ffc96dc04826aeab1131e95d3a2e64.png)\n\nCalculate ${∮}_{C}\\,\\text{d}y,$ where $C$ is the closed path along the rectangle, traversed once in the counterclockwise direction, as shown above." :question/worked-solution "The line integral of unity with respect to $y$ along a path $C$ is equal to the net change in $y$ between the terminal and initial points:\n\n$$\n{∮}_{C}\\,\\text{d}y={y}_{2}-{y}_{1},\n$$\n\nwhere ${y}_{2}$ is the $y$-coordinate of the terminal point, and ${y}_{1}$ is the $y$-coordinate of the initial point.\n\nIn our case, the initial and terminal points are the same (since the path is closed and is traversed only once). Therefore, ${y}_{1}={y}_{2},$ and we have\n\n$$\n{∮}_{C}\\,\\text{d}y=0.\n$$"}]}
