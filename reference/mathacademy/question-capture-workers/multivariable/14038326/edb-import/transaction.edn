[{:db/id "q-15263/selection/5c22a8bd8e2e2f6fe814424bd26692e29918141a3cb1d4c1ffcb008a7994b1d7" :answer/id #uuid "eec072a7-2344-588c-8545-0cd95e244a04" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{\\int }_{-2}^{3}\\sqrt{{x}^{4}+9}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15263/selection/2ab8590a561c004a1711b7500a7aa4c114a7944d8389048e86dd12be97f2fdc7" :answer/id #uuid "5c958f60-89f7-5f31-8554-b1fbed890b41" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{\\int }_{-2}^{3}\\sqrt{3{x}^{4}+1}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15263/selection/ca7893a226f152fe945e0370e2628f738751f4328c25d55b60cb8c6597803e11" :answer/id #uuid "c7525add-8035-5209-83f4-18e7060a118a" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{3}\\sqrt{9{x}^{4}+1}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15263/selection/6131adb1d83ec1f15120e137222b137dbca7e14086e67c38d906836cf526966a" :answer/id #uuid "4a89bda6-30d9-52c8-ac7f-b221d0c94313" :answer/type :answer.type/math :answer/value "\\frac{1}{3}{\\int }_{-2}^{3}\\sqrt{{x}^{4}+3}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15263/selection/0d795dc3ed8b99521d2c9a2113bc3132db9a02de57b757cc298911aa1c68f3b8" :answer/id #uuid "f095534c-267c-50cc-9205-00916d2fea6c" :answer/type :answer.type/math :answer/value "{\\int }_{-2}^{3}\\sqrt{{x}^{4}+3}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15263/selection" :answer-field/id #uuid "1e09a914-fbdb-5924-98ac-bb2b6ec86754" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15263/selection/5c22a8bd8e2e2f6fe814424bd26692e29918141a3cb1d4c1ffcb008a7994b1d7" :answer-field/choices ["q-15263/selection/5c22a8bd8e2e2f6fe814424bd26692e29918141a3cb1d4c1ffcb008a7994b1d7" "q-15263/selection/2ab8590a561c004a1711b7500a7aa4c114a7944d8389048e86dd12be97f2fdc7" "q-15263/selection/ca7893a226f152fe945e0370e2628f738751f4328c25d55b60cb8c6597803e11" "q-15263/selection/6131adb1d83ec1f15120e137222b137dbca7e14086e67c38d906836cf526966a" "q-15263/selection/0d795dc3ed8b99521d2c9a2113bc3132db9a02de57b757cc298911aa1c68f3b8"] :db/ensure [:answer-field/validate]} {:db/id "q-15263" :question/id #uuid "c4b22314-524e-59fb-a646-f832ea81b61d" :question/math-academy-id "q-15263" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038326/assets/3e2aa5bcd84bb8290613d937d75a412869589fd9690f1bd8fe1754faa4ea9f36.png)\n\nWhich of the following gives the length of the curve $y=\\frac{{x}^{3}}{9}$ on $[-2,3],$ as shown above?" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{3}}{9},$ $a=-2,$ and $b=3.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{3{x}^{2}}{9}=\\frac{{x}^{2}}{3}\n$$\n\nSubstituting ${f}^{′}(x)=\\frac{{x}^{2}}{3}$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{-2}^{3}\\sqrt{1+{[{f}^{′}(x)]}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{-2}^{3}\\sqrt{1+\\frac{{x}^{4}}{9}}\\,\\text{d}x \\\\  & =\\frac{1}{3}{\\int }_{-2}^{3}\\sqrt{{x}^{4}+9}\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-15263/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "965026e6-db46-5930-8844-c423e6ea795a"] :knowledge-point/questions ["q-15263"] :db/ensure [:knowledge-point/validate]} {:db/id "q-15315/selection/066c2e5f9613b0a7169f3fbbad76a2df3f0f0f9d4e82a8e90e6366a9a0676bdf" :answer/id #uuid "85986fd5-08a8-5cb5-bc7b-4d7cfa03ce99" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{\\frac{1+2x}{x}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15315/selection/5c56a676a78b76814ba445ae625834ab0063093c989c5d7a7a9f7a54b9136fb8" :answer/id #uuid "920f66a7-3653-5bbf-841c-9f51605b83f6" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\frac{\\sqrt{1+{x}^{2}}}{x}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15315/selection/48fc034ab90f553e4b4f360406825754758d1c89b71c3d5de1773655532b574e" :answer/id #uuid "24b8a9a1-806f-50a4-883e-c0058238a262" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\frac{\\sqrt{1+2{x}^{2}}}{x}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15315/selection/9186e1ed3106fe4007c3a2a3195ed064f04ec67a84e1559a37457f6ead1db5ad" :answer/id #uuid "086f4687-56dd-5157-9925-0fb15417116b" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{\\frac{1+x}{x}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15315/selection/b91c88041c9d0655b1e95ab73261afc545abe414ecebb70c04dfec7406634130" :answer/id #uuid "08677152-56be-5b14-bc37-5e67820853c4" :answer/type :answer.type/math :answer/value "{\\int }_{0}^{1}\\sqrt{\\frac{1+{x}^{2}}{x}}\\,\\text{d}x" :db/ensure [:answer/validate]} {:db/id "q-15315/selection" :answer-field/id #uuid "543b7657-a8b4-5a21-a6e3-d3972662674c" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-15315/selection/9186e1ed3106fe4007c3a2a3195ed064f04ec67a84e1559a37457f6ead1db5ad" :answer-field/choices ["q-15315/selection/066c2e5f9613b0a7169f3fbbad76a2df3f0f0f9d4e82a8e90e6366a9a0676bdf" "q-15315/selection/5c56a676a78b76814ba445ae625834ab0063093c989c5d7a7a9f7a54b9136fb8" "q-15315/selection/48fc034ab90f553e4b4f360406825754758d1c89b71c3d5de1773655532b574e" "q-15315/selection/9186e1ed3106fe4007c3a2a3195ed064f04ec67a84e1559a37457f6ead1db5ad" "q-15315/selection/b91c88041c9d0655b1e95ab73261afc545abe414ecebb70c04dfec7406634130"] :db/ensure [:answer-field/validate]} {:db/id "q-15315" :question/id #uuid "e5cbeecb-a1f1-54e5-8cbe-522e7705856c" :question/math-academy-id "q-15315" :question/problem "Which of the following gives the length of the curve $y=2\\sqrt{x}$ on $[0,1]?$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=2\\sqrt{x},$ $a=0,$ and $b=1.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{2}{2\\sqrt{x}}=\\frac{1}{\\sqrt{x}}\n$$\n\nSubstituting ${f}^{′}(x)=\\frac{1}{\\sqrt{x}}$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{0}^{1}\\sqrt{1+{[{f}^{′}(x)]}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\sqrt{1+{(\\frac{1}{\\sqrt{x}})}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\sqrt{1+\\frac{1}{x}}\\,\\text{d}x \\\\  & ={\\int }_{0}^{1}\\sqrt{\\frac{1+x}{x}}\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-15315/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "965026e6-db46-5930-8844-c423e6ea795a"] :knowledge-point/questions ["q-15315"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-15327"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038326/assets/431975da27fb1ff06baa520ef4f870cb34c879f384bfc5ddd774422f15fe7b57.png)\n\nWhich of the following gives the length of the curve $y=4{e}^{-{x}^{2}/4}$ on $[0,2],$ as shown above?" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "q-51267"] :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038326/assets/bb30925ffaca0ce59de7508e0f3710fbb26f3a80dfbd80b689e9ee5a4cf7d699.png)\n\nWhich of the following gives the length of the curve $y=\\frac{{x}^{2}}{4}$ for $x\\in [-3,4],$ as shown above?" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{2}}{4},$ $a=-3,$ and $b=4.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{2x}{4}=\\frac{x}{2}\n$$\n\nSubstituting ${f}^{′}(x)=\\frac{x}{2}$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{-3}^{4}\\sqrt{1+{[{f}^{′}(x)]}^{2}}\\,\\text{d}x \\\\  & ={\\int }_{-3}^{4}\\sqrt{1+\\frac{{x}^{2}}{4}}\\,\\text{d}x \\\\  & =\\frac{1}{2}{\\int }_{-3}^{4}\\sqrt{{x}^{2}+4}\\,\\text{d}x.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-85664/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" :answer/id #uuid "257b40a9-ff53-5ea1-8e24-f3da1373f9a6" :answer/type :answer.type/math :answer/value "\\frac{3}{4}" :db/ensure [:answer/validate]} {:db/id "q-85664/selection/0e689252fcceae21513f24f0b98c844dc63de84eda7f67a46c7530656b17a5fe" :answer/id #uuid "5d23e0b6-8784-5145-9af1-cafdf94486aa" :answer/type :answer.type/math :answer/value "\\frac{17}{12}" :db/ensure [:answer/validate]} {:db/id "q-85664/selection/3ab3a229b1d63f55f782989a5a2191572c52e15cef3ee349de23caec4ae46c9c" :answer/id #uuid "5d747a85-4587-56e5-8db6-5232392384c2" :answer/type :answer.type/math :answer/value "\\frac{25}{6}" :db/ensure [:answer/validate]} {:db/id "q-85664/selection/330eb0b589da5e117b65434433fc9b27dd194d66ebc1ac2885f9407ae4c4b046" :answer/id #uuid "646dfa72-81be-595b-ab5e-e95235e577b4" :answer/type :answer.type/math :answer/value "\\frac{11}{12}" :db/ensure [:answer/validate]} {:db/id "q-85664/selection/471d022dc8477dee5b5835181abb5643fcc83818c373aaad08fa968767db722e" :answer/id #uuid "2c73c693-f1cd-50f9-8ae8-8f6132b8501d" :answer/type :answer.type/math :answer/value "\\frac{13}{6}" :db/ensure [:answer/validate]} {:db/id "q-85664/selection" :answer-field/id #uuid "7333aabf-028a-55b2-a6f4-215a76f7aabd" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-85664/selection/0e689252fcceae21513f24f0b98c844dc63de84eda7f67a46c7530656b17a5fe" :answer-field/choices ["q-85664/selection/b93157e0eb36ec8e645eeabaa0819400f448209e0db24c1abf59704822466393" "q-85664/selection/0e689252fcceae21513f24f0b98c844dc63de84eda7f67a46c7530656b17a5fe" "q-85664/selection/3ab3a229b1d63f55f782989a5a2191572c52e15cef3ee349de23caec4ae46c9c" "q-85664/selection/330eb0b589da5e117b65434433fc9b27dd194d66ebc1ac2885f9407ae4c4b046" "q-85664/selection/471d022dc8477dee5b5835181abb5643fcc83818c373aaad08fa968767db722e"] :db/ensure [:answer-field/validate]} {:db/id "q-85664" :question/id #uuid "eefbacba-43f3-528c-bba1-b3c354ca148b" :question/math-academy-id "q-85664" :question/problem "Compute the arc length of $y=\\frac{{x}^{3}}{6}+\\frac{1}{2x}$ for $x\\in [1,2].$" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{3}}{6}+\\frac{1}{2x},$ $a=1,$ and $b=2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{3{x}^{2}}{6}-\\frac{1}{2{x}^{2}}=\\frac{{x}^{4}-1}{2{x}^{2}}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$\n\nSubstituting ${f}^{′}(x)=\\frac{{x}^{4}-1}{2{x}^{2}}$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{(\\frac{{x}^{4}-1}{2{x}^{2}})}^{2}} \\\\  & =\\sqrt{1+\\frac{{x}^{8}-2{x}^{4}+1}{4{x}^{4}}} \\\\  & =\\sqrt{\\frac{4{x}^{4}+{x}^{8}-2{x}^{4}+1}{4{x}^{4}}} \\\\  & =\\sqrt{\\frac{{x}^{8}+2{x}^{4}+1}{4{x}^{4}}} \\\\  & =\\sqrt{\\frac{({x}^{4}+1)^{2}}{4{x}^{4}}} \\\\  & =\\frac{{x}^{4}+1}{2{x}^{2}} \\\\  & =\\frac{1}{2}({x}^{2}+{x}^{-2})\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{1}{2}({x}^{2}+{x}^{-2})$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}L & =\\frac{1}{2}{\\int }_{1}^{2}({x}^{2}+{x}^{-2})\\,\\text{d}x \\\\  & =\\frac{1}{2}{[\\frac{1}{3}{x}^{3}-{x}^{-1}]|}_{1}^{2} \\\\  & =\\frac{1}{2}[(\\frac{1}{3}\\cdot {2}^{3}-{2}^{-1})-(\\frac{1}{3}\\cdot {1}^{3}-{1}^{-1})) \\\\  & =\\frac{1}{2}[\\frac{8}{3}-\\frac{1}{2}-\\frac{1}{3}+1] \\\\  & =\\frac{17}{12}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-85664/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f87bc14d-5e68-5a5e-bec8-f1b5b21c02e8"] :knowledge-point/questions ["q-85664"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352925/field-1/5f2d13e926c6727823d00b87759327aaa8daa982166b584c523e07ee20845d56" :answer/id #uuid "a94a50f6-e703-5902-8e1d-e958c5e99204" :answer/type :answer.type/math :answer/value "\\frac{e^3+e^{-3}}{6}" :db/ensure [:answer/validate]} {:db/id 17592186289379 :answer-field/choices ["q-352925/field-1/5f2d13e926c6727823d00b87759327aaa8daa982166b584c523e07ee20845d56"] :db/ensure [:answer-field/validate]} {:db/id "q-353183/field-1/21d230daf09bc8344fdcd7e50976ad008e4eb905ab1193e98b410cc519e342e2" :answer/id #uuid "82e29027-cd8f-5288-ad2d-035977d9cb75" :answer/type :answer.type/math :answer/value "\\frac{3}{8}+\\ln(2)" :db/ensure [:answer/validate]} {:db/id "q-353183/field-1" :answer-field/id #uuid "b0d4249a-3912-5dc4-871a-c97b49be5238" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-353183/field-1/21d230daf09bc8344fdcd7e50976ad008e4eb905ab1193e98b410cc519e342e2" :answer-field/choices ["q-353183/field-1/21d230daf09bc8344fdcd7e50976ad008e4eb905ab1193e98b410cc519e342e2"] :db/ensure [:answer-field/validate]} {:db/id "q-353183" :question/id #uuid "1e883a7d-82a7-5e23-83d2-65862f5b051d" :question/math-academy-id "q-353183" :question/problem "Compute the arc length of $y=\\frac{{x}^{2}}{8}-\\operatorname{ln}⁡(2x)$ for $x\\in [1,2].$ Do not round the answer.\n\n$L=$\n{{field-1}}" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{2}}{8}-\\operatorname{ln}⁡(2x),$ $a=1,$ and $b=2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{x}{4}-\\frac{1}{x}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$ \n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{(\\frac{x}{4}-\\frac{1}{x})}^{2}} \\\\  & =\\sqrt{1+(\\frac{{x}^{2}}{16}-\\frac{1}{2}+\\frac{1}{{x}^{2}})} \\\\  & =\\sqrt{\\frac{{x}^{2}}{16}+\\frac{1}{2}+\\frac{1}{{x}^{2}}} \\\\  & =\\sqrt{\\frac{{x}^{4}+8{x}^{2}+16}{16{x}^{2}}} \\\\  & =\\sqrt{\\frac{({x}^{2}+4)^{2}}{16{x}^{2}}} \\\\  & =\\frac{{x}^{2}+4}{4x}\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{{x}^{2}+4}{4x}$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{{x}^{2}+4}{4x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}(\\frac{x}{4}+\\frac{1}{x})\\,\\text{d}x \\\\  & ={(\\frac{{x}^{2}}{8}+\\operatorname{ln}⁡x)|}_{1}^{2} \\\\  & =[\\frac{{2}^{2}}{8}+\\operatorname{ln}⁡2]-[\\frac{{1}^{2}}{8}+\\operatorname{ln}⁡1] \\\\  & =\\frac{3}{8}+\\operatorname{ln}⁡2.\\end{aligned}\n$$" :question/difficulty :question.difficulty/hard :question/answer-fields ["q-353183/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f87bc14d-5e68-5a5e-bec8-f1b5b21c02e8"] :knowledge-point/questions ["q-353183"] :db/ensure [:knowledge-point/validate]} {:db/id "q-352870/field-1/421bfadc9797e1d894299fab20c26c45c0d7054992b88ed79b17f9e5dd07e8d4" :answer/id #uuid "c3a9b3b7-c0c3-5c59-85a8-340504a5c768" :answer/type :answer.type/math :answer/value "\\frac{33}{16}" :db/ensure [:answer/validate]} {:db/id "q-352870/field-1/1204ed2183b9a57c3ccd4919aed654ab5ed7696c2d6c919c40e9c1c185655036" :answer/id #uuid "a3d016f6-d23d-5ee5-84f6-a6157363a7e5" :answer/type :answer.type/math :answer/value "\\frac{27}{16}" :db/ensure [:answer/validate]} {:db/id "q-352870/field-1" :answer-field/id #uuid "77b10102-969f-5a5e-93e5-5fa934fba041" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-352870/field-1/421bfadc9797e1d894299fab20c26c45c0d7054992b88ed79b17f9e5dd07e8d4" :answer-field/choices ["q-352870/field-1/421bfadc9797e1d894299fab20c26c45c0d7054992b88ed79b17f9e5dd07e8d4" "q-352870/field-1/1204ed2183b9a57c3ccd4919aed654ab5ed7696c2d6c919c40e9c1c185655036"] :db/ensure [:answer-field/validate]} {:db/id "q-352870" :question/id #uuid "b0fe1254-05f3-56f8-ae29-77928dadd356" :question/math-academy-id "q-352870" :question/problem "Compute the arc length $L$ of $y=\\frac{{x}^{4}}{8}+\\frac{1}{4{x}^{2}}$ for $x\\in [1,2].$ Do not round the answer.\n\n$L=$ \n{{field-1}}" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{4}}{8}+\\frac{1}{4{x}^{2}},$ $a=1,$ and $b=2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{1}{2}{x}^{3}-\\frac{1}{2{x}^{3}}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$ \n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{[\\frac{1}{2}{x}^{3}-\\frac{1}{2{x}^{3}}]}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{4}{x}^{6}-\\frac{1}{2}+\\frac{1}{4{x}^{6}}} \\\\  & =\\sqrt{\\frac{1}{4}{x}^{6}+\\frac{1}{2}+\\frac{1}{4{x}^{6}}} \\\\  & =\\sqrt{{(\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}})}^{2}} \\\\  & =\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}}\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}}$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}(\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}})\\,\\text{d}x \\\\  & ={(\\frac{1}{8}{x}^{4}-\\frac{1}{4{x}^{2}})|}_{1}^{2} \\\\  & =[\\frac{1}{8}(2)^{4}-\\frac{1}{4(2)^{2}}]-[\\frac{1}{8}(1)^{4}-\\frac{1}{4(1)^{2}}] \\\\  & =\\frac{31}{16}-(-\\frac{1}{8}) \\\\  & =\\frac{33}{16}.\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-352870/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "f87bc14d-5e68-5a5e-bec8-f1b5b21c02e8"] :knowledge-point/questions ["q-352870"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-6002"] :question/problem "The length of a curve $y=f(x)$ is given by ${\\int }_{0}^{5}\\sqrt{1+9{e}^{4x}}\\,\\text{d}x.$ Which of the following could be  an equation for this curve?" :question/worked-solution "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\n\\begin{aligned}L & ={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\\end{aligned}\n$$\n\nWe're given that \n\n$$\nL={\\int }_{0}^{5}\\sqrt{1+9{e}^{4x}}\\,\\text{d}x.\n$$\n\nComparing the above with the arc length formula, we see that we must have\n\n$$\n[{f}^{′}(x)]^{2}=9{e}^{4x}\\,⟹\\,{f}^{′}(x)=\\pm 3{e}^{2x}.\n$$\n\nIntegrating the above equation with respect to $x,$ we get\n\n$$\n\\begin{aligned}f(x) & =\\pm 3\\int {e}^{2x}\\text{ d}x \\\\  & =\\pm \\frac{3}{2}{e}^{2x}+C.\\end{aligned}\n$$\n\nFrom the given options, the only one that has the required form is $y=\\frac{3}{2}{e}^{2x}+1.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-560"] :question/problem "Compute the arc length of  the curve $y=x^{3/2}$ between the points $x=0$ and $x=\\dfrac{4}{3},$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14038326/assets/4ed8b94a4fff3c22697264e467f955f2e51a62618d03295c4e4f38493bff2ced.png)" :db/ensure [:question/validate]}]
