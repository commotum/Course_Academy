+{x}^{2}}}{x}\\,\\text{d}x" 13194139534614 true] [17592186298877 1103 #edb/ref 17592186045453 13194139534614 true] [17592186298877 1111 #uuid "920f66a7-3653-5bbf-841c-9f51605b83f6" 13194139534614 true] [17592186298878 1034 "{\\int }_{0}^{1}\\sqrt{\\frac{1+x}{x}}\\,\\text{d}x" 13194139534614 true] [17592186298878 1103 #edb/ref 17592186045453 13194139534614 true] [17592186298878 1111 #uuid "086f4687-56dd-5157-9925-0fb15417116b" 13194139534614 true] [17592186298879 1034 "{\\int }_{0}^{1}\\sqrt{\\frac{1+{x}^{2}}{x}}\\,\\text{d}x" 13194139534614 true] [17592186298879 1103 #edb/ref 17592186045453 13194139534614 true] [17592186298879 1111 #uuid "08677152-56be-5b14-bc37-5e67820853c4" 13194139534614 true] [17592186298880 1017 #edb/ref 17592186298881 13194139534614 true] [17592186298880 1089 "q-352870" 13194139534614 true] [17592186298880 1091 #edb/ref 17592186045465 13194139534614 true] [17592186298880 1100 "Compute the arc length $L$ of $y=\\frac{{x}^{4}}{8}+\\frac{1}{4{x}^{2}}$ for $x\\in [1,2].$ Do not round the answer.\n\n$L=$ \n{{field-1}}" 13194139534614 true] [17592186298880 1113 #uuid "b0fe1254-05f3-56f8-ae29-77928dadd356" 13194139534614 true] [17592186298880 1145 "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{4}}{8}+\\frac{1}{4{x}^{2}},$ $a=1,$ and $b=2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{1}{2}{x}^{3}-\\frac{1}{2{x}^{3}}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$ \n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{[\\frac{1}{2}{x}^{3}-\\frac{1}{2{x}^{3}}]}^{2}} \\\\  & =\\sqrt{1+\\frac{1}{4}{x}^{6}-\\frac{1}{2}+\\frac{1}{4{x}^{6}}} \\\\  & =\\sqrt{\\frac{1}{4}{x}^{6}+\\frac{1}{2}+\\frac{1}{4{x}^{6}}} \\\\  & =\\sqrt{{(\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}})}^{2}} \\\\  & =\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}}\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}}$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}(\\frac{1}{2}{x}^{3}+\\frac{1}{2{x}^{3}})\\,\\text{d}x \\\\  & ={(\\frac{1}{8}{x}^{4}-\\frac{1}{4{x}^{2}})|}_{1}^{2} \\\\  & =[\\frac{1}{8}(2)^{4}-\\frac{1}{4(2)^{2}}]-[\\frac{1}{8}(1)^{4}-\\frac{1}{4(1)^{2}}] \\\\  & =\\frac{31}{16}-(-\\frac{1}{8}) \\\\  & =\\frac{33}{16}.\\end{aligned}\n$$" 13194139534614 true] [17592186298881 1000 #edb/ref 17592186298882 13194139534614 true] [17592186298881 1000 #edb/ref 17592186298883 13194139534614 true] [17592186298881 1040 #edb/ref 17592186045449 13194139534614 true] [17592186298881 1041 "field-1" 13194139534614 true] [17592186298881 1104 #edb/ref 17592186298883 13194139534614 true] [17592186298881 1110 #uuid "77b10102-969f-5a5e-93e5-5fa934fba041" 13194139534614 true] [17592186298882 1034 "\\frac{27}{16}" 13194139534614 true] [17592186298882 1103 #edb/ref 17592186045453 13194139534614 true] [17592186298882 1111 #uuid "a3d016f6-d23d-5ee5-84f6-a6157363a7e5" 13194139534614 true] [17592186298883 1034 "\\frac{33}{16}" 13194139534614 true] [17592186298883 1103 #edb/ref 17592186045453 13194139534614 true] [17592186298883 1111 #uuid "c3a9b3b7-c0c3-5c59-85a8-340504a5c768" 13194139534614 true] [17592186298884 1034 "\\frac{e^3+e^{-3}}{6}" 13194139534614 true] [17592186298884 1103 #edb/ref 17592186045453 13194139534614 true] [17592186298884 1111 #uuid "a94a50f6-e703-5902-8e1d-e958c5e99204" 13194139534614 true] [17592186298885 1017 #edb/ref 17592186298886 13194139534614 true] [17592186298885 1089 "q-353183" 13194139534614 true] [17592186298885 1091 #edb/ref 17592186045464 13194139534614 true] [17592186298885 1100 "Compute the arc length of $y=\\frac{{x}^{2}}{8}-\\operatorname{ln}⁡(2x)$ for $x\\in [1,2].$ Do not round the answer.\n\n$L=$\n{{field-1}}" 13194139534614 true] [17592186298885 1113 #uuid "1e883a7d-82a7-5e23-83d2-65862f5b051d" 13194139534614 true] [17592186298885 1145 "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{2}}{8}-\\operatorname{ln}⁡(2x),$ $a=1,$ and $b=2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{x}{4}-\\frac{1}{x}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$ \n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{(\\frac{x}{4}-\\frac{1}{x})}^{2}} \\\\  & =\\sqrt{1+(\\frac{{x}^{2}}{16}-\\frac{1}{2}+\\frac{1}{{x}^{2}})} \\\\  & =\\sqrt{\\frac{{x}^{2}}{16}+\\frac{1}{2}+\\frac{1}{{x}^{2}}} \\\\  & =\\sqrt{\\frac{{x}^{4}+8{x}^{2}+16}{16{x}^{2}}} \\\\  & =\\sqrt{\\frac{({x}^{2}+4)^{2}}{16{x}^{2}}} \\\\  & =\\frac{{x}^{2}+4}{4x}\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{{x}^{2}+4}{4x}$ into the arc length formula, we get\n\n$$\n\\begin{aligned}L & ={\\int }_{1}^{2}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}\\frac{{x}^{2}+4}{4x}\\,\\text{d}x \\\\  & ={\\int }_{1}^{2}(\\frac{x}{4}+\\frac{1}{x})\\,\\text{d}x \\\\  & ={(\\frac{{x}^{2}}{8}+\\operatorname{ln}⁡x)|}_{1}^{2} \\\\  & =[\\frac{{2}^{2}}{8}+\\operatorname{ln}⁡2]-[\\frac{{1}^{2}}{8}+\\operatorname{ln}⁡1] \\\\  & =\\frac{3}{8}+\\operatorname{ln}⁡2.\\end{aligned}\n$$" 13194139534614 true] [17592186298886 1000 #edb/ref 17592186298887 13194139534614 true] [17592186298886 1040 #edb/ref 17592186045449 13194139534614 true] [17592186298886 1041 "field-1" 13194139534614 true] [17592186298886 1104 #edb/ref 17592186298887 13194139534614 true] [17592186298886 1110 #uuid "b0d4249a-3912-5dc4-871a-c97b49be5238" 13194139534614 true] [17592186298887 1034 "\\frac{3}{8}+\\ln(2)" 13194139534614 true] [17592186298887 1103 #edb/ref 17592186045453 13194139534614 true] [17592186298887 1111 #uuid "82e29027-cd8f-5288-ad2d-035977d9cb75" 13194139534614 true] [17592186298888 1017 #edb/ref 17592186298889 13194139534614 true] [17592186298888 1089 "q-85664" 13194139534614 true] [17592186298888 1091 #edb/ref 17592186045465 13194139534614 true] [17592186298888 1100 "Compute the arc length of $y=\\frac{{x}^{3}}{6}+\\frac{1}{2x}$ for $x\\in [1,2].$" 13194139534614 true] [17592186298888 1113 #uuid "eefbacba-43f3-528c-bba1-b3c354ca148b" 13194139534614 true] [17592186298888 1145 "The arc length of a curve $y=f(x)$ between $x=a$ and $x=b$ can be found using the formula\n\n$$\nL={\\int }_{a}^{b}\\sqrt{1+[{f}^{′}(x)]^{2}}\\,\\text{d}x.\n$$\n\nIn our case, $f(x)=\\frac{{x}^{3}}{6}+\\frac{1}{2x},$ $a=1,$ and $b=2.$\n\nFirst, we find the derivative of $f(x):$\n\n$$\n{f}^{′}(x)=\\frac{3{x}^{2}}{6}-\\frac{1}{2{x}^{2}}=\\frac{{x}^{4}-1}{2{x}^{2}}\n$$\n\nNow, let's compute $\\sqrt{1+[{f}^{′}(x)]^{2}}:$\n\nSubstituting ${f}^{′}(x)=\\frac{{x}^{4}-1}{2{x}^{2}}$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}\\sqrt{1+[{f}^{′}(x)]^{2}} & =\\sqrt{1+{(\\frac{{x}^{4}-1}{2{x}^{2}})}^{2}} \\\\  & =\\sqrt{1+\\frac{{x}^{8}-2{x}^{4}+1}{4{x}^{4}}} \\\\  & =\\sqrt{\\frac{4{x}^{4}+{x}^{8}-2{x}^{4}+1}{4{x}^{4}}} \\\\  & =\\sqrt{\\frac{{x}^{8}+2{x}^{4}+1}{4{x}^{4}}} \\\\  & =\\sqrt{\\frac{({x}^{4}+1)^{2}}{4{x}^{4}}} \\\\  & =\\frac{{x}^{4}+1}{2{x}^{2}} \\\\  & =\\frac{1}{2}({x}^{2}+{x}^{-2})\\end{aligned}\n$$\n\nSubstituting $\\sqrt{1+[{f}^{′}(x)]^{2}}=\\frac{1}{2}({x}^{2}+{x}^{-2})$ to the formula for the arc length, we get\n\n$$\n\\begin{aligned}L & =\\frac{1}{2}{\\int }_{1}^{2}({x}^{2}+{x}^{-2})\\,\\text{d}x \\\\  & =\\frac{1}{2}{[\\frac{1}{3}{x}^{3}-{x}^{-1}]|}_{1}^{2} \\\\  & =\\frac{1}{2}[(\\frac{1}{3}\\cdot {2}^{3}-{2}^{-1})-(\\frac{1}{3}\\cdot {1}^{3}-{1}^{-1})) \\\\  & =\\frac{1}{2}[\\frac{8}{3}-\\frac{1}{2}-\\frac{1}{3}+1] \\\\  & =\\frac{17}{12}.\\end{aligned}\n$$" 13194139534614 true] [17592186298889 1000 #edb/ref 17592186298890 13194139534614 true] [17592186298889 1000 #edb/ref 17592186298891 13194139534614 true] [17592186298889 1000 #edb/ref 17592186298892 13194139534614 true] [1759218629888