ivariable/14033854/assets/18bd3e410f2f3e415e8164ae6e2f9e03a2f7281ce15e6e05cb570ecfdac10964.png)\n\nTherefore, the domain of the vector-valued function $f(t)$ is $t\\in (2,\\infty ).$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033854/state.json" "file_sha256" "e1cf79d49ee48a8e9956d7e3acdd65b1977b8641061a1ba3af88e1b6ce3d497d"} {"question" "q-162685" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033854/activity-metadata.json" "file_sha256" "a8cacf0e1948298e0eb7454030623b73f5e4f7dded78ab2c4610490107f291e5"} {"question" "q-162685" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033854/state.json" "file_sha256" "e1cf79d49ee48a8e9956d7e3acdd65b1977b8641061a1ba3af88e1b6ce3d497d"} {"question" "q-162685" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "t\\in (-\\infty ,-2)\\cup (-2,\\infty )"] ["math" "t\\in (-\\infty ,2)\\cup (2,\\infty )"] ["math" "t\\in (-\\infty -2)\\cup (-2,2)\\cup (2,\\infty )"] ["math" "t\\in (2,\\infty )"] ["math" "t\\in [2,\\infty )"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033854/state.json" "file_sha256" "e1cf79d49ee48a8e9956d7e3acdd65b1977b8641061a1ba3af88e1b6ce3d497d"} {"question" "q-162685" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "t\\in (2,\\infty )"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14033854/state.json" "file_sha256" "e1cf79d49ee48a8e9956d7e3acdd65b1977b864106