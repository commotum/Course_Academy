i }{4} \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=\\sqrt{2}$ and $\\theta =\\frac{3\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71983" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/activity-metadata.json" "file_sha256" "0f69c634627088c92d4dd39d4befab06742d0d5ff839e69bfd1e3cab496d4371"} {"question" "q-71983" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71983" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}"] ["math" "z=2\\,{\\text{e}}^{5\\pi \\text{i}/6}"] ["math" "z=\\sqrt{2}\\,{\\text{e}}^{2\\pi \\text{i}/3}"] ["math" "z=\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}"] ["math" "z=\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/6}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71983" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "z=\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71982" "field" nil "attribute" "question/problem" "value" "Write the complex number $z=-2+2\\sqrt{3}\\,\\text{i}$ in exponential form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71982" "field" nil "attribute" "question/worked-solution" "value" "To write our complex number in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-2)^{2}+{(2\\sqrt{3})}^{2}} \\\\  & =4\\end{aligned}\n$$\n\nNow, since $z$ lies in the second quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\frac{2\\sqrt{3}}{2})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\sqrt{3})| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nFinally, substituting $r=4$ and $\\theta =\\frac{2\\pi }{3}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=4\\,{\\text{e}}^{2\\pi \\text{i}/3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71982" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/activity-metadata.json" "file_sha256" "0f69c634627088c92d4dd39d4befab06742d0d5ff839e69bfd1e3cab496d4371"} {"question" "q-71982" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71982" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}"] ["math" "z=2\\,{\\text{e}}^{5\\pi \\text{i}/6}"] ["math" "z=3\\,{\\text{e}}^{3\\pi \\text{i}/4}"] ["math" "z=4\\,{\\text{e}}^{2\\pi \\text{i}/3}"] ["math" "z=4\\,{\\text{e}}^{5\\pi \\text{i}/6}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71982" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "z=4\\,{\\text{e}}^{2\\pi \\text{i}/3}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71977" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/assets/a02f84856db56412060d6f376f3d926e3fb05581ee36ef9b5e4d2cc570e8438d.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71977" "field" nil "attribute" "question/worked-solution" "value" "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-\\sqrt{3}-\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{(-\\sqrt{3})}^{2}+(-1)^{2}} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $z$ lies in the third quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi +|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{-1}{-\\sqrt{3}})| \\\\  & =\\pi +|\\operatorname{arctan}⁡(\\frac{1}{\\sqrt{3}})| \\\\  & =\\pi +\\frac{\\pi }{6} \\\\  & =\\frac{7\\pi }{6}.\\end{aligned}\n$$\n\nFinally, substituting $r=2$ and $\\theta =\\frac{7\\pi }{6}$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=2\\,{\\text{e}}^{7\\pi \\text{i}/6}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71977" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/activity-metadata.json" "file_sha256" "0f69c634627088c92d4dd39d4befab06742d0d5ff839e69bfd1e3cab496d4371"} {"question" "q-71977" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71977" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "z=2\\,{\\text{e}}^{4\\pi \\text{i}/3}"] ["math" "z=2\\,{\\text{e}}^{7\\pi \\text{i}/6}"] ["math" "z=3\\,{\\text{e}}^{7\\pi \\text{i}/6}"] ["math" "z=3\\sqrt{2}\\,{\\text{e}}^{4\\pi \\text{i}/3}"] ["math" "z=3\\sqrt{2}\\,{\\text{e}}^{5\\pi \\text{i}/4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71977" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "z=2\\,{\\text{e}}^{7\\pi \\text{i}/6}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-8080" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/assets/6e2a47a4563e404bc09f285af6ffcb098ea16a49f9c45e450a70ef0cb54f6263.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-8080" "field" nil "attribute" "question/worked-solution" "value" "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-3+3\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-3)^{2}+{3}^{2}} \\\\  & =\\sqrt{18} \\\\  & =3\\sqrt{2}\\end{aligned}\n$$\n\nSince $z$ lies in the second quadrant of the complex plane, we have\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-1)| \\\\  & =\\frac{3\\pi }{4}.\\end{aligned}\n$$\n\nFinally, substituting $r=3\\sqrt{2}$ and $\\theta =\\frac{3\\pi }{4}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=3\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-8080" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/activity-metadata.json" "file_sha256" "0f69c634627088c92d4dd39d4befab06742d0d5ff839e69bfd1e3cab496d4371"} {"question" "q-8080" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-8080" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "z=2\\sqrt{3}\\,{\\text{e}}^{-3\\pi \\text{i}/4}"] ["math" "z=2\\sqrt{3}\\,{\\text{e}}^{3\\pi \\text{i}/4}"] ["math" "z=3\\sqrt{2}\\,{\\text{e}}^{-3\\pi \\text{i}/4}"] ["math" "z=3\\sqrt{2}\\,{\\text{e}}^{-\\pi \\text{i}/4}"] ["math" "z=3\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-8080" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "z=3\\sqrt{2}\\,{\\text{e}}^{3\\pi \\text{i}/4}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-17517" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/assets/d7eb4042a5422d631c867cba1c1fa9c52b400d0061fd5fe7d2fa380d721dbac5.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to three decimal places." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-17517" "field" nil "attribute" "question/worked-solution" "value" "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =4+3\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{4}^{2}+{3}^{2}} \\\\  & =5\\end{aligned}\n$$\n\nNow, since $z$ lies in the first quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\operatorname{arctan}⁡(\\frac{y}{x}) \\\\  & =\\operatorname{arctan}⁡(\\frac{3}{4}) \\\\  & ≈0.644.\\end{aligned}\n$$\n\nFinally, substituting $r=5$ and $\\theta =0.644$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=5\\,{\\text{e}}^{0.644\\,\\text{i}}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-17517" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/activity-metadata.json" "file_sha256" "0f69c634627088c92d4dd39d4befab06742d0d5ff839e69bfd1e3cab496d4371"} {"question" "q-17517" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-17517" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "z=5\\,{\\text{e}}^{0.464\\,\\text{i}}"] ["math" "z=5\\,{\\text{e}}^{0.644\\,\\text{i}}"] ["math" "z=5\\,{\\text{e}}^{2\\pi \\,\\text{i}/3}"] ["math" "z=\\sqrt{5}\\,{\\text{e}}^{0.644\\,\\text{i}}"] ["math" "z=\\sqrt{5}\\,{\\text{e}}^{1.644\\,\\text{i}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-17517" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "z=5\\,{\\text{e}}^{0.644\\,\\text{i}}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-107428" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/assets/ba77669a8e0ffd3e69bfc8e5322d7042c318a55b4cd486ac1fac591d3b016e43.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in the form $r{e}^{\\text{i}\\theta },$ giving $\\theta $ in radians to the nearest tenth." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-107428" "field" nil "attribute" "question/worked-solution" "value" "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =2-3\\,\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+(-3)^{2}} \\\\  & =\\sqrt{13}\\end{aligned}\n$$\n\nNow, since $z$ lies in the fourth quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =2\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =2\\pi -|\\operatorname{arctan}⁡(-\\frac{3}{2})| \\\\  & ≈5.3.\\end{aligned}\n$$\n\nFinally, substituting $r=\\sqrt{13}$ and $\\theta =5.3$ into $z=r{e}^{\\text{i}\\theta },$ we get \n\n$$\nz=\\sqrt{13}\\,{\\text{e}}^{5.3\\,\\text{i}}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-107428" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/activity-metadata.json" "file_sha256" "0f69c634627088c92d4dd39d4befab06742d0d5ff839e69bfd1e3cab496d4371"} {"question" "q-107428" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-107428" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "z=\\sqrt{11}\\,{\\text{e}}^{4.8\\,\\text{i}}"] ["math" "z=\\sqrt{11}\\,{\\text{e}}^{5.3\\,\\text{i}}"] ["math" "z=\\sqrt{13}\\,{\\text{e}}^{4.1\\,\\text{i}}"] ["math" "z=\\sqrt{13}\\,{\\text{e}}^{4.8\\,\\text{i}}"] ["math" "z=\\sqrt{13}\\,{\\text{e}}^{5.3\\,\\text{i}}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-107428" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "z=\\sqrt{13}\\,{\\text{e}}^{5.3\\,\\text{i}}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71978" "field" nil "attribute" "question/problem" "value" "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/assets/c5d36b72e7e2ff6754152a559d64bf3610708c9a2d3790c859bc9abacc9220b6.png)\n\nWrite the complex number $z$, shown on the Argand diagram above, in exponential form." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71978" "field" nil "attribute" "question/worked-solution" "value" "The complex number shown in the Argand diagram can be written as\n\n$$\n\\begin{aligned}z & =x+\\text{i}y \\\\  & =-1+\\sqrt{3}\\,\\text{i}.\\end{aligned}\n$$\n\nTo write it in the form $z=r{\\text{e}}^{\\text{i}\\theta },$ where $r=|z|$ and $\\theta =\\operatorname{arg}⁡(z),$ we first calculate $r:$\n\n$$\n\\begin{aligned}r=|z| & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{(-1)^{2}+{(\\sqrt{3})}^{2}} \\\\  & =\\sqrt{4} \\\\  & =2\\end{aligned}\n$$\n\nNow, since $z$ lies in the second quadrant, we can find the angle $\\theta $ as\n\n$$\n\\begin{aligned}\\theta =\\operatorname{arg}⁡(z) & =\\pi -|\\operatorname{arctan}⁡(\\frac{y}{x})| \\\\  & =\\pi -|\\operatorname{arctan}⁡(-\\sqrt{3})| \\\\  & =\\pi -\\frac{\\pi }{3} \\\\  & =\\frac{2\\pi }{3}.\\end{aligned}\n$$\n\nFinally, substituting $r=2$ and $\\theta =\\frac{2\\pi }{3}$ into $z=r{e}^{\\text{i}\\theta },$ we get\n\n$$\nz=2\\,{\\text{e}}^{2\\pi \\text{i}/3}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71978" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/activity-metadata.json" "file_sha256" "0f69c634627088c92d4dd39d4befab06742d0d5ff839e69bfd1e3cab496d4371"} {"question" "q-71978" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14077408/state.json" "file_sha256" "91858153e065fc52f322f05a766da8ec1503a9d5794e88a4be0c7aa228505886"} {"question" "q-71978" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "z=2\\,{\\text{e}}^{2\\pi \\text{i}/3}"] ["math" "z=2\\,{\\text{e}}^{5\\pi \\text{i}/6}"] ["math" "z=2\\sqrt{3}