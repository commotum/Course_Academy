#{[{:db/id #edb/ref 17592186129414 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "99b11ebe-e180-58a1-90f0-4fb17920b979" :answer/type {:db/ident :answer.type/math} :answer/value "(2i+4j)\\,\\text{m}/\\text{s}^{2}" :db/id #edb/ref 17592186361090} {:answer/id #uuid "c8fd981e-214e-5450-969b-cd7aeb23e7f0" :answer/type {:db/ident :answer.type/math} :answer/value "(i-2j)\\,\\text{m}/\\text{s}^{2}" :db/id #edb/ref 17592186361091} {:answer/id #uuid "aa056b95-e840-52af-8991-84894661d882" :answer/type {:db/ident :answer.type/math} :answer/value "4i\\,\\text{m}/\\text{s}^{2}" :db/id #edb/ref 17592186361092} {:answer/id #uuid "e6868cf8-4cbf-525e-940d-33b37aaff64b" :answer/type {:db/ident :answer.type/math} :answer/value "0\\,\\text{m}/\\text{s}^{2}" :db/id #edb/ref 17592186361093} {:answer/id #uuid "3dc1e854-08ac-5d6b-b905-a537565217ab" :answer/type {:db/ident :answer.type/math} :answer/value "(i+2j)\\,\\text{m}/\\text{s}^{2}" :db/id #edb/ref 17592186361094}] :answer-field/correct {:answer/id #uuid "3dc1e854-08ac-5d6b-b905-a537565217ab" :answer/type {:db/ident :answer.type/math} :answer/value "(i+2j)\\,\\text{m}/\\text{s}^{2}" :db/id #edb/ref 17592186361094} :answer-field/id #uuid "7af3cbef-8483-58a0-b70e-639abf7b1d18" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361089}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1d30498e-757c-511b-b142-9c3f837aad12" :question/math-academy-id "q-136289" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(-2i-8j)\\,\\text{m/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $2i\\,\\text{m/s}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-2i-8j,\\,v=2i,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-2i-8j)+a(4) \\\\ 4i+8j & =4a \\\\ a & =\\frac{1}{4}(4i+8j) \\\\  & =(i+2j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286035 :knowledge-point/_questions [{:knowledge-point/id #uuid "7439a96f-07b1-5673-a103-af2c63c25d18" :knowledge-point/title "Calculating the Final Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ea1127-0d81-5372-83dc-4603dbf19837" :answer/type {:db/ident :answer.type/math} :answer/value "(10i-6j)\\,\\text{m/s}" :db/id #edb/ref 17592186286037} {:answer/id #uuid "cafb14a7-e8ba-5e2a-9056-82c84d03640c" :answer/type {:db/ident :answer.type/math} :answer/value "(6i-j)\\,\\text{m/s}" :db/id #edb/ref 17592186286038} {:answer/id #uuid "e05dcb19-3698-5bc0-bfe2-4727ef012835" :answer/type {:db/ident :answer.type/math} :answer/value "(7i+j)\\,\\text{m/s}" :db/id #edb/ref 17592186286039} {:answer/id #uuid "145bcf6d-dc64-57c7-8b8f-f7edc5e47682" :answer/type {:db/ident :answer.type/math} :answer/value "(7i-j)\\,\\text{m/s}" :db/id #edb/ref 17592186286040} {:answer/id #uuid "d98f03ca-2810-5253-ba0c-8c6444cd9e9b" :answer/type {:db/ident :answer.type/math} :answer/value "(6i+j)\\,\\text{m/s}" :db/id #edb/ref 17592186286041}] :answer-field/correct {:answer/id #uuid "e05dcb19-3698-5bc0-bfe2-4727ef012835" :answer/type {:db/ident :answer.type/math} :answer/value "(7i+j)\\,\\text{m/s}" :db/id #edb/ref 17592186286039} :answer-field/id #uuid "3f630da0-d649-5baa-a7a5-cba3a7e9f50e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286036}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d910d63b-bba9-5d02-aaf7-5410fa0ed263" :question/math-academy-id "q-136337" :question/problem "The velocity of a particle is $(5i-3j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ If the particle moves with a constant acceleration of $(i+2j)\\,{\\text{m/s}}^{2},$ find the velocity of the particle when $t=2\\,\\text{s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=5i-3j,\\,a=i+2j.\n$$\n\nTherefore, after $t=2\\,\\text{s},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(5i-3j)+(i+2j)(2) \\\\  & =(5i-3j)+(2i+4j) \\\\  & =(7i+j)\\,\\text{m/s}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186361095 :knowledge-point/_questions [{:knowledge-point/id #uuid "93d45138-b681-55c0-8910-1400bdf717c5" :knowledge-point/title "Finding the Time when a Particle Reaches a Particular Velocity"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0006b42-2ed2-558b-aa4c-2dfb15417976" :answer/type {:db/ident :answer.type/math} :answer/value "t=4\\,\\text{s}" :db/id #edb/ref 17592186361097} {:answer/id #uuid "3d6577ce-7c47-5a22-9728-0eee38cd2459" :answer/type {:db/ident :answer.type/math} :answer/value "t=8\\,\\text{s}" :db/id #edb/ref 17592186361098} {:answer/id #uuid "19d86cac-0fc0-58f0-acca-0418f23814ce" :answer/type {:db/ident :answer.type/text} :answer/value "No solution" :db/id #edb/ref 17592186361099} {:answer/id #uuid "150fd6c2-e160-563d-878f-591465fd74c1" :answer/type {:db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186361100} {:answer/id #uuid "070a1f66-57d0-592b-b616-8e14cc4f49b6" :answer/type {:db/ident :answer.type/math} :answer/value "t=5\\,\\text{s}" :db/id #edb/ref 17592186361101}] :answer-field/correct {:answer/id #uuid "150fd6c2-e160-563d-878f-591465fd74c1" :answer/type {:db/ident :answer.type/math} :answer/value "t=6\\,\\text{s}" :db/id #edb/ref 17592186361100} :answer-field/id #uuid "6bf7d35c-0b84-5983-9a9d-9de99b8d986a" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186361096}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "6cfb09c2-0cab-57af-9ddd-621d3a23bf89" :question/math-academy-id "q-136400" :question/problem "A particle moves with a constant acceleration of $(2i-4j)\\,{\\text{ft/s}}^{2}.$ The velocity of the particle is $(-4i+16j)\\,\\text{ft/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $(8i-8j)\\,\\text{ft/s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=2i-4j,\\,u=-4i+16j,\\,v=8i-8j\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 8i-8j & =(-4i+16j)+(2i-4j)t \\\\ 12i-24j & =(2i-4j)t \\\\ 12i-24j & =2ti-4tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}12 & = & 2t \\\\ -24 & = & -4t\\end{aligned}\\,⟹\\,t=6\\,\\text{s}.\n$$"}] [{:db/id #edb/ref 17592186361102 :knowledge-point/_questions [{:knowledge-point/id #uuid "7439a96f-07b1-5673-a103-af2c63c25d18" :knowledge-point/title "Calculating the Final Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cf0c6569-b17d-53b0-9d11-9321cd6b03de" :answer/type {:db/ident :answer.type/math} :answer/value "9" :db/id #edb/ref 17592186361104} {:answer/id #uuid "a814644e-e7d3-5580-b29c-d71dc4b9fc98" :answer/type {:db/ident :answer.type/math} :answer/value "10" :db/id 