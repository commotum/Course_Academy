 [:answer.type/math "(7i+j)\\,\\text{m/s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/state.json" "file_sha256" "42965e5fc2ea3e089275e8951dae9b31ceda37cfd57684be32934f423deb3ee2" "basis" 1082 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/edb-import/verification.json"} {"question" "q-136337" "field" "selection" "attribute" "answer/value" "value" [:answer.type/math "(7i-j)\\,\\text{m/s}"] "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/state.json" "file_sha256" "42965e5fc2ea3e089275e8951dae9b31ceda37cfd57684be32934f423deb3ee2" "basis" 1082 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/edb-import/verification.json"} {"question" "q-136337" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(7i+j)\\,\\text{m/s}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/state.json" "file_sha256" "42965e5fc2ea3e089275e8951dae9b31ceda37cfd57684be32934f423deb3ee2" "basis" 1082 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/edb-import/verification.json"} {"question" "q-136289" "field" nil "attribute" "question/problem" "value" "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(-2i-8j)\\,\\text{m/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $2i\\,\\text{m/s}.$ Calculate the acceleration of the particle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/state.json" "file_sha256" "42965e5fc2ea3e089275e8951dae9b31ceda37cfd57684be32934f423deb3ee2" "basis" 1082 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/edb-import/verification.json"} {"question" "q-136289" "field" nil "attribute" "question/worked-solution" "value" "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-2i-8j,\\,v=2i,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-2i-8j)+a(4) \\\\ 4i+8j & =4a \\\\ a & =\\frac{1}{4}(4i+8j) \\\\  & =(i+2j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/state.json" "file_sha256" "42965e5fc2ea3e089275e8951dae9b31ceda37cfd57684be32934f423deb3ee2" "basis" 1082 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/edb-import/verification.json"} {"question" "q-136289" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/activity-metadata.json" "file_sha256" "7f299e7929890cff147e1e9313cb7800670f9c1cb6cf26837c9cb420b0275ee4" "basis" 1082 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/edb-import/verification.json"} {"question" "q-136289" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/state.json" "file_sha256" "42965e5fc2ea3e089275e8951dae9b31ceda37cfd57684be32934f423deb3ee2" "basis" 1082 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13979841/edb-import/verification.json"}] "sources" [{"question" "q-136289" "field" nil "attribute" "question/problem" "value" "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(-2i-8j)\\,\\text{m/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $2i\\,\\text{m/s}.$ Calculate the acceleration of the particle." "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136289" "field" nil "attribute" "question/worked-solution" "value" "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-2i-8j,\\,v=2i,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-2i-8j)+a(4) \\\\ 4i+8j & =4a \\\\ a & =\\frac{1}{4}(4i+8j) \\\\  & =(i+2j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136289" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/activity-metadata.json" "file_sha256" "85685208f7ed49da515d0b2b51d5cf7c9ca179cf01130d949368a477cd7dced6"} {"question" "q-136289" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136289" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(i+2j)\\,\\text{m}/\\text{s}^{2}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136337" "field" nil "attribute" "question/problem" "value" "The velocity of a particle is $(5i-3j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ If the particle moves with a constant acceleration of $(i+2j)\\,{\\text{m/s}}^{2},$ find the velocity of the particle when $t=2\\,\\text{s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136337" "field" nil "attribute" "question/worked-solution" "value" "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=5i-3j,\\,a=i+2j.\n$$\n\nTherefore, after $t=2\\,\\text{s},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(5i-3j)+(i+2j)(2) \\\\  & =(5i-3j)+(2i+4j) \\\\  & =(7i+j)\\,\\text{m/s}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136337" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/activity-metadata.json" "file_sha256" "85685208f7ed49da515d0b2b51d5cf7c9ca179cf01130d949368a477cd7dced6"} {"question" "q-136337" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136337" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "(10i-6j)\\,\\text{m/s}"] ["math" "(6i+j)\\,\\text{m/s}"] ["math" "(6i-j)\\,\\text{m/s}"] ["math" "(7i+j)\\,\\text{m/s}"] ["math" "(7i-j)\\,\\text{m/s}"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136337" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "(7i+j)\\,\\text{m/s}"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136400" "field" nil "attribute" "question/problem" "value" "A particle moves with a constant acceleration of $(2i-4j)\\,{\\text{ft/s}}^{2}.$ The velocity of the particle is $(-4i+16j)\\,\\text{ft/s}$ when $t=0\\,\\text{s}.$ Find the time when the velocity of the particle equals $(8i-8j)\\,\\text{ft/s}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136400" "field" nil "attribute" "question/worked-solution" "value" "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\na=2i-4j,\\,u=-4i+16j,\\,v=8i-8j\n$$\n\ninto the equation above, we can solve for $t,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 8i-8j & =(-4i+16j)+(2i-4j)t \\\\ 12i-24j & =(2i-4j)t \\\\ 12i-24j & =2ti-4tj\\end{aligned}\n$$\n\nEquating the $i$ and $j$ components in the last equation, we obtain\n\n$$\n{\\begin{aligned}12 & = & 2t \\\\ -24 & = & -4t\\end{aligned}\\,⟹\\,t=6\\,\\text{s}.\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136400" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/activity-metadata.json" "file_sha256" "85685208f7ed49da515d0b2b51d5cf7c9ca179cf01130d949368a477cd7dced6"} {"question" "q-136400" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136400" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "t=4\\,\\text{s}"] ["math" "t=5\\,\\text{s}"] ["math" "t=6\\,\\text{s}"] ["math" "t=8\\,\\text{s}"] ["text" "No solution"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-136400" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "t=6\\,\\text{s}"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-317185" "field" nil "attribute" "question/problem" "value" "The velocity of a particle is $(i-7j)\\,\\text{km/h}$ when $t=0\\,\\text{h}.$ If the particle moves with a constant acceleration of $(3i+4j)\\,{\\text{km/h}}^{2},$ find the velocity of the particle when $t=3\\,\\text{h}.$\n\n$v=($\n{{field-1}}$i$\n$+$\n{{field-2}}$j\\,)\\,\\text{km/h}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-317185" "field" nil "attribute" "question/worked-solution" "value" "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=i-7j,\\,a=3i+4j.\n$$\n\nTherefore, after $t=3\\,\\text{h},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(i-7j)+(3i+4j)(3) \\\\  & =(i-7j)+(9i+12j) \\\\  & =(10i+5j)\\,\\text{km/h}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-317185" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/activity-metadata.json" "file_sha256" "85685208f7ed49da515d0b2b51d5cf7c9ca179cf01130d949368a477cd7dced6"} {"question" "q-317185" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-317185" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "10"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-317185" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-317185" "field" "field-2" "attribute" "answer-field/correct" "value" [:answer.type/math "5"] "category" "model_interpretation" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-318175" "field" nil "attribute" "question/problem" "value" "A particle moves with constant acceleration. The velocity of the particle equals $(9i-4j)\\,\\text{km/h}$ both when $t=0\\,\\text{h}$ and $t=5\\,\\text{h}.$ What is the acceleration of the particle?\n\n$a=($\n{{field-1}}$\\,i$\n$+$\n{{field-2}}$\\,j\\,)\\,{\\text{km/h}}^{2}$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-318175" "field" nil "attribute" "question/worked-solution" "value" "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=9i-4j,\\,v=9i-4j,\\,t=5\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 9i-4j & =(9i-4j)+a(5) \\\\ 0 & =5a \\\\ a & =(0\\,i+0\\,j)\\,{\\text{km/h}}^{2}.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-318175" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/activity-metadata.json" "file_sha256" "85685208f7ed49da515d0b2b51d5cf7c9ca179cf01130d949368a477cd7dced6"} {"question" "q-318175" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-318175" "field" "field-1" "attribute" "answer-field/correct" "value" [:answer.type/math "0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sha256" "b55feb39fa6275887d524f8326ebb1ae58954e23b9a753f81a360539eb5ac0bf"} {"question" "q-318175" "field" "field-2" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14069378/state.json" "file_sh