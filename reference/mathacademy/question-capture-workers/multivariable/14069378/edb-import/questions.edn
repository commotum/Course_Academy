#{[{:db/id #edb/ref 17592186129414 :knowledge-point/_questions [{:knowledge-point/id #uuid "c5146ef7-bd48-5d0d-903d-882d739b92c7" :knowledge-point/title "Calculating the Acceleration of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "d4672d49-ed68-5749-af07-6551eb7fbbe1" :answer/type {:db/ident :answer.type/math} :answer/value "(2i + 4j)m/s^{2}" :db/id #edb/ref 17592186126291} {:answer/id #uuid "246893e9-8f38-5719-90f9-e5359a2f8b2a" :answer/type {:db/ident :answer.type/math} :answer/value "(i - 2j)m/s^{2}" :db/id #edb/ref 17592186126292} {:answer/id #uuid "391f27a5-4c27-5b93-be93-463a8369ec52" :answer/type {:db/ident :answer.type/math} :answer/value "(i + 2j)m/s^{2}" :db/id #edb/ref 17592186126293} {:answer/id #uuid "5fea3226-571f-5dcb-86c8-5248838fabcf" :answer/type {:db/ident :answer.type/math} :answer/value "0m/s^{2}" :db/id #edb/ref 17592186126294} {:answer/id #uuid "7c97e288-29da-529f-b1fe-9e0ff3367ca0" :answer/type {:db/ident :answer.type/math} :answer/value "4im/s^{2}" :db/id #edb/ref 17592186126295}] :answer-field/correct {:answer/id #uuid "391f27a5-4c27-5b93-be93-463a8369ec52" :answer/type {:db/ident :answer.type/math} :answer/value "(i + 2j)m/s^{2}" :db/id #edb/ref 17592186126293} :answer-field/id #uuid "ccfed89d-b25d-5449-a46c-bd5f21d33670" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186126290}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1d30498e-757c-511b-b142-9c3f837aad12" :question/math-academy-id "q-136289" :question/problem "A particle moves with constant acceleration. When $t=0\\,\\text{s},$ the velocity of the particle is $(-2i-8j)\\,\\text{m/s},$ and when $t=4\\,\\text{s},$ the velocity of the particle is $2i\\,\\text{m/s}.$ Calculate the acceleration of the particle." :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nSubstituting \n\n$$\nu=-2i-8j,\\,v=2i,\\,t=4,\n$$\n\ninto the equation above, we can solve for $a,$ as follows:\n\n$$\n\\begin{aligned}v & =u+at \\\\ 2i & =(-2i-8j)+a(4) \\\\ 4i+8j & =4a \\\\ a & =\\frac{1}{4}(4i+8j) \\\\  & =(i+2j)\\,{\\text{m/s}}^{2}.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186286035 :knowledge-point/_questions [{:knowledge-point/id #uuid "7439a96f-07b1-5673-a103-af2c63c25d18" :knowledge-point/title "Calculating the Final Velocity of a Particle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "16ea1127-0d81-5372-83dc-4603dbf19837" :answer/type {:db/ident :answer.type/math} :answer/value "(10i-6j)\\,\\text{m/s}" :db/id #edb/ref 17592186286037} {:answer/id #uuid "cafb14a7-e8ba-5e2a-9056-82c84d03640c" :answer/type {:db/ident :answer.type/math} :answer/value "(6i-j)\\,\\text{m/s}" :db/id #edb/ref 17592186286038} {:answer/id #uuid "e05dcb19-3698-5bc0-bfe2-4727ef012835" :answer/type {:db/ident :answer.type/math} :answer/value "(7i+j)\\,\\text{m/s}" :db/id #edb/ref 17592186286039} {:answer/id #uuid "145bcf6d-dc64-57c7-8b8f-f7edc5e47682" :answer/type {:db/ident :answer.type/math} :answer/value "(7i-j)\\,\\text{m/s}" :db/id #edb/ref 17592186286040} {:answer/id #uuid "d98f03ca-2810-5253-ba0c-8c6444cd9e9b" :answer/type {:db/ident :answer.type/math} :answer/value "(6i+j)\\,\\text{m/s}" :db/id #edb/ref 17592186286041}] :answer-field/correct {:answer/id #uuid "e05dcb19-3698-5bc0-bfe2-4727ef012835" :answer/type {:db/ident :answer.type/math} :answer/value "(7i+j)\\,\\text{m/s}" :db/id #edb/ref 17592186286039} :answer-field/id #uuid "3f630da0-d649-5baa-a7a5-cba3a7e9f50e" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186286036}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d910d63b-bba9-5d02-aaf7-5410fa0ed263" :question/math-academy-id "q-136337" :question/problem "The velocity of a particle is $(5i-3j)\\,\\text{m/s}$ when $t=0\\,\\text{s}.$ If the particle moves with a constant acceleration of $(i+2j)\\,{\\text{m/s}}^{2},$ find the velocity of the particle when $t=2\\,\\text{s}.$" :question/worked-solution "Recall that when a particle moves with constant acceleration, the velocity vector at time $t$ can be found using\n\n$$\nv=u+at,\n$$\n\nwhere $u$ is the initial velocity, and $a$ is the acceleration of the particle.\n\nHere, we have\n\n$$\nu=5i-3j,\\,a=i+2j.\n$$\n\nTherefore, after $t=2\\,\\text{s},$ the velocity of the particle will be\n\n$$\n\\begin{aligned}v & =u+at \\\\  & =(5i-3j)+(i+2j)(2) \\\\  & =(5i-3j)+(2i+4j) \\\\  & =(7i+j)\\,\\text{m/s}.\\end{aligned}\n$$"}]}
