db/ref 17592186302441} :answer-field/id #uuid "bfa4ad39-fd94-52b7-9673-9ffce364c534" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302440}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "54535d89-12d6-55b4-922f-427d98b1be7b" :question/math-academy-id "q-325160" :question/problem "Find the **polar coordinates** of the point where the polar curve $r=\\frac{13}{2}$ intersects the negative $y$-axis. Express the polar angle in radians.\n\nThe point of intersection in polar coordinates is $(${{field-1}}$,$\n{{field-2}}$).$" :question/worked-solution "The polar curve $r=\\frac{13}{2}$ is a circle of radius $\\frac{13}{2}$ centered at the origin. It crosses the negative $y$-axis where $r=\\frac{13}{2}$ and $\\theta =\\frac{3\\pi }{2}.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/2399108905ce184b2b2d2d299f5e52539af01228b484316ece8b2efdd6a3b852.png)\n\nTherefore, the point of intersection in polar coordinates is $(\\,\\frac{13}{2},\\frac{3\\pi }{2}\\,).$"}] [{:db/id #edb/ref 17592186302442 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "9684ac91-4ec5-5270-a913-ca4c45328509" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186302444} {:answer/id #uuid "a135e380-f6f0-5022-b912-a7fae1b7f986" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186302445}] :answer-field/correct {:answer/id #uuid "9684ac91-4ec5-5270-a913-ca4c45328509" :answer/type {:db/ident :answer.type/math} :answer/value "13" :db/id #edb/ref 17592186302444} :answer-field/id #uuid "448d851e-ca56-513d-9fcf-44e43785aebf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302443}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ee108acb-13aa-5cba-b154-a8df1833a3bc" :question/math-academy-id "q-325168" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/2abff4f1dcb5bfd305a5560293892828f94d3fe8cca755bec1998d4f3fda077f.png)\n\nThe polar equation of the circle centered at the origin that passes through the point $A(5,12)$, as shown above, is$\\,\\,r=$\n{{field-1}}." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{5}^{2}+{12}^{2}} \\\\  & =\\sqrt{169} \\\\  & =13\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=13.$"}] [{:db/id #edb/ref 17592186302446 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f4b0ad18-c84b-5e54-a67c-6a2f293969d8" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186302448} {:answer/id #uuid "7051fb3e-df22-557d-bea7-860bbd99904d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186302449}] :answer-field/correct {:answer/id #uuid "7051fb3e-df22-557d-bea7-860bbd99904d" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{10}" :db/id #edb/ref 17592186302449} :answer-field/id #uuid "e7b30cc0-d262-5f4d-8593-772f1da5138d" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302447}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "b90809e4-4aff-5a7b-bad0-bfb4210baded" :question/math-academy-id "q-325177" :question/problem "The polar equation of the circle that is centered at the origin and that passes through the point $A(6,2)$ is$\\,\\,r=$\n{{field-1}}." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{6}^{2}+{2}^{2}} \\\\  & =\\sqrt{36+4} \\\\  & =\\sqrt{40} \\\\  & =2\\sqrt{10}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=2\\sqrt{10}.$"}] [{:db/id #edb/ref 17592186267843 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5b2cae2-321f-58dc-83ab-08b1cea647c0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186267845}] :answer-field/correct {:answer/id #uuid "c5b2cae2-321f-58dc-83ab-08b1cea647c0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186267845} :answer-field/id #uuid "203a5109-baee-5991-bc8c-4149c669b848" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186267844}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a020aa52-a41b-59b4-a523-caef6a0f3163" :question/math-academy-id "q-325178" :question/problem "The polar equation of the circle that is centered at the origin and that passes through the point $A(1,7)$ is$\\,\\,r=$\n{{field-1}}." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{1}^{2}+{7}^{2}} \\\\  & =\\sqrt{1+49} \\\\  & =\\sqrt{50} \\\\  & =5\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=5\\sqrt{2}.$"}] [{:db/id #edb/ref 17592186302450 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "77a35a97-2e73-5111-925c-9a79126c684c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/8bf1a9b27d362e8f44736e7210836537eb2d05e760cf654bb3da332dc2da9fd1.png" :db/id #edb/ref 17592186302452} {:answer/id #uuid "e5c7101a-7701-5f53-b53b-e1d37d26eefa" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/ea7595da12f74310da86ccf44db453dadf67ccff889aaf562f461f7c7e713807.png" :db/id #edb/ref 17592186302453} {:answer/id #uuid "bb7ef009-38bf-5cfd-bf25-0bab54092362" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/dad45fcb266c0313a1b02d08eb93763bc00c103d4a1d4da48f2ef5452a27dd61.png" :db/id #edb/ref 17592186302454} {:answer/id #uuid "9ee9a285-1b2e-590e-8954-e56e7376bf8c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/bb98fa6cae9226c4334773a013fe7ac0749174e1241442946aa727b9c96d0015.png" :db/id #edb/ref 17592186302455} {:answer/id #uuid "e3830fad-4583-5f76-ba4a-b2b282dac37c" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Develop