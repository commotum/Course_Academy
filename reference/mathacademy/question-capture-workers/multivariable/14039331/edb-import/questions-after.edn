#{[{:db/id #edb/ref 17592186092009 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/id #uuid "14832dae-6df8-5511-9a92-bf9164478091" :question/math-academy-id "e-5386" :question/problem "What is the polar equation of the curve shown below?\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/2787b5cdecf8cda247811f40a661d2c72f6cac231d49f8157f8faca0d668da17.png)" :question/worked-solution "The given curve is a circle of radius $4$ centered at the origin.\n\nTherefore, its polar equation is $r=4.$"}] [{:db/id #edb/ref 17592186092010 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/id #uuid "3eb95e18-94ad-563c-bbf8-3843c75958a8" :question/math-academy-id "e-5387" :question/problem "Find the **polar** coordinates of the point where the polar curve $r=2.7$ intersects the negative $x$-axis." :question/worked-solution "The polar curve $r=2.7$ is a circle of radius $2.7$ centered at the origin. It crosses the negative $x$-axis at the point where $r=2.7$ and $\\theta = \\pi.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/04f57721c8672bf48aa6f07bf6c9571f826ab957d104a40b273254b4f50ff147.png)\n\nTherefore, the point of intersection in polar coordinates is $\\left(2.7, \\pi\\right).$"}] [{:db/id #edb/ref 17592186092011 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/id #uuid "285c25a2-acec-57eb-8db8-e708eec876c7" :question/math-academy-id "e-5388" :question/problem "Find the polar equation of the circle centered at the origin that passes through the point $A(2,5)$, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/063df02b7846c476657a2deaa00937967707472a97b0e52a4a8b3dc5951ce1ab.png)" :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r = k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+{5}^{2}} \\\\  & =\\sqrt{29}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=\\sqrt{29}.$"}] [{:db/id #edb/ref 17592186302416 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "ea5cf590-cf9b-5f19-8c42-2d1a7d96a970" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/fa5893dd1506acef5356c41e0b3ef163d7ce367f020628578425ca17880bea98.png" :db/id #edb/ref 17592186302418} {:answer/id #uuid "5c03bd56-43ae-5f30-85aa-e363000af000" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/739d610bf181443a1c0b5c8103fcb0af89d8b1b40ecf7f6e83837f7c326697ed.png" :db/id #edb/ref 17592186302419} {:answer/id #uuid "37d459cb-a5f0-5078-a6b5-aa273ec89f97" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/d36551812c33d5850783861775a8e56aff2dbebb5dd246c32bc2296689907edd.png" :db/id #edb/ref 17592186302420} {:answer/id #uuid "bfd489f4-5c86-5f8a-806e-3bfadedaedc3" :answer/type {:db/ident :answer.type/image} :answer/value 