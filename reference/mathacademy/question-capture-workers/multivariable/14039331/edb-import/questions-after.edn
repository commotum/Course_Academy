cle With an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71ad1af0-11b0-5b91-a4ac-92765a5d907d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\pi )" :db/id #edb/ref 17592186287036} {:answer/id #uuid "8665c345-162b-576a-9c61-51ff95683842" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\frac{\\pi }{2})" :db/id #edb/ref 17592186287037} {:answer/id #uuid "c5eb6149-daf5-55f5-bf44-7ba36035fa71" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\frac{3\\pi }{2})" :db/id #edb/ref 17592186287038} {:answer/id #uuid "34bd2e37-7b16-5cce-ace8-20292ffc3faa" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186287039} {:answer/id #uuid "81ad5168-b66c-541a-b5bf-49fda2d3abc8" :answer/type {:db/ident :answer.type/math} :answer/value "(9,\\frac{3\\pi }{2})" :db/id #edb/ref 17592186287040}] :answer-field/correct {:answer/id #uuid "34bd2e37-7b16-5cce-ace8-20292ffc3faa" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186287039} :answer-field/id #uuid "5ccba5a5-dbd8-5622-986e-9bb3cc24e7d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287035}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "32df1b7d-e14a-54ae-9f1b-ccf5a00b4ff9" :question/math-academy-id "q-120173" :question/problem "Find the **polar** coordinates of the point where the polar curve $r=3$ intersects the positive $x$-axis." :question/worked-solution "The polar curve $r=3$ is a circle of radius $3$ centered at the origin. It crosses the positive $x$-axis at the point where $r=3$ and $\\theta =0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/63d6e0d36e3d345561b1c4c20d7d19cb34ae6bd3b7543c042be288d8fcdb12e7.png)\n\nTherefore, the point of intersection in polar coordinates is $(3,0).$"}] [{:db/id #edb/ref 17592186302423 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c319ffd0-f410-54d9-afe8-f6d8537e5adb" :answer/type {:db/ident :answer.type/math} :answer/value "r=15" :db/id #edb/ref 17592186302425} {:answer/id #uuid "c56c197a-9947-5caa-8d0c-3ac3d3d84439" :answer/type {:db/ident :answer.type/math} :answer/value "r=5\\sqrt{7}" :db/id #edb/ref 17592186302426} {:answer/id #uuid "048bb022-0f69-56eb-a061-4d6d78fb6fef" :answer/type {:db/ident :answer.type/math} :answer/value "r=14\\sqrt{2}" :db/id #edb/ref 17592186302427} {:answer/id #uuid "330a9fb9-7f0e-5341-9796-12e761088008" :answer/type {:db/ident :answer.type/math} :answer/value "r=196" :db/id #edb/ref 17592186302428} {:answer/id #uuid "9ff354e2-c9c1-579e-b077-86e42cc3a8d9" :answer/type {:db/ident :answer.type/math} :answer/value "r=225" :db/id #edb/ref 17592186302429}] :answer-field/correct {:answer/id #uuid "c319ffd0-f410-54d9-afe8-f6d8537e5adb" :answer/type {:db/ident :answer.type/math} :answer/value "r=15" :db/id #edb/ref 17592186302425} :answer-field/id #uuid "9dab361c-5b05-52d9-ad5a-150be3ef060b" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186302424}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "8d8875f6-58ea-56c4-9273-75daba8efa6d" :question/math-academy-id "q-120181" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/c3d18d92739af7c6ea7c2a8560ab54c4c08b8b20f9ee33ba52a254b16315d9bf.png)\n\nFind the polar equation of the circle centered at the origin that passes through the point $A(9,12)$, as shown above." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{9}^{2}+{12}^{2}} \\\\  & =\\sqrt{225} \\\\  & =15\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=15.$"}] [{:db/id #edb/ref 17592186092544 :knowledge-point/_questions [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8092f3eb-c3a3-50d6-9d5d-5501f4173ad3" :answer/type {:db/ident :answer.type/math} :answer/value "(-5, 5)" :db/id #edb/ref 17592186089701} {:answer/id #uuid "9bbc660b-8167-5691-89e9-1013f8353da9" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-5)" :db/id #edb/ref 17592186089702} {:answer/id #uuid "d720101b-7f9b-5d99-b125-e2db5f889964" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-5)" :db/id #edb/ref 17592186089703} {:answer/id #uuid "ef416fdb-019f-5381-9025-842ef3e247b9" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 5)" :db/id #edb/ref 17592186089704} {:answer/id #uuid "797ea623-5514-5a33-9824-350398ba1d7b" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-5)" :db/id #edb/ref 17592186089705}] :answer-field/correct {:answer/id #uuid "d720101b-7f9b-5d99-b125-e2db5f889964" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-5)" :db/id #edb/ref 17592186089703} :answer-field/id #uuid "2307c450-09e7-5d8a-a2d2-57a3a7523fdc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089700}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3b65d3e4-49d1-5dcb-9c0a-4ca0da5a7649" :question/math-academy-id "q-17148" :question/problem "Find the Cartesian coordinates of the point where the polar curve $r=5$ intersects the negative $y$-axis." :question/worked-solution "The polar curve $r=5$ is a circle of radius $5$ centered at the origin. It crosses the negative $y$-axis at the point $(0,-5),$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/multivariable/14039331/assets/0b989aa5f365df48d5c6937d2eb2d9322b18d17adf18fc9860d5b3294e0b863d.png)\n\nTherefore, the point of intersection is $(0,-5).$"}] [{:db/id #edb/ref 17592186302430 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "378ee3c0-e556-543d-b5a7-d417409805ac" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186302432}] :answer-field/correct {:answer/id #uuid "378ee3c0-e556-543d-b5a7-d417409805ac" :answer/type {:db/ident :answer.type/math} :answer/value "2\\sqrt{5}" :db/id #edb/ref 17592186302432} :answer-field/id #uuid "57c1bb72-c884-5eef-b5fc-0768fb998a8a" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186302431}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "ebf95fa3-b7ba-500a-ab79-2c407acafc86" :question/math-academy-id "q-280257" :question/problem "The polar equation of the circle that is centered at the origin and that passes through the point $A(2,4)$ is$\\,\\,r=$\n{{field-1}}." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{2}^{2}+{4}^{2}} \\\\  & =\\sqrt{20} \\\\  & =2\\sqrt{5}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=2\\sqrt{5}.$"}] [{:db/id #edb/r