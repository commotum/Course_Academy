_sha256" "6b6e57a4e182279665f082cc33a76d5a6feb79d2b3869fb224a443e4c3a59d43" "basis" 634 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/edb-import/verification.json"} {"question" "q-325178" "field" nil "attribute" "question/worked-solution" "value" "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{1}^{2}+{7}^{2}} \\\\  & =\\sqrt{1+49} \\\\  & =\\sqrt{50} \\\\  & =5\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=5\\sqrt{2}.$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/state.json" "file_sha256" "6b6e57a4e182279665f082cc33a76d5a6feb79d2b3869fb224a443e4c3a59d43" "basis" 634 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/edb-import/verification.json"} {"question" "q-325178" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/moderate "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/activity-metadata.json" "file_sha256" "43a038d7cfae7bf8e8609ba2b0449bd084513deaafc7bba9cb55b2be1fde0207" "basis" 634 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/edb-import/verification.json"} {"question" "q-325178" "field" "field-1" "attribute" "answer-field/type" "value" :answer-field.type/blank "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/state.json" "file_sha256" "6b6e57a4e182279665f082cc33a76d5a6feb79d2b3869fb224a443e4c3a59d43" "basis" 634 "verification" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/edb-import/verification.json"} {"question" "q-325178" "fi