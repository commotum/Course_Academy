#{[{:db/id #edb/ref 17592186287034 :knowledge-point/_questions [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71ad1af0-11b0-5b91-a4ac-92765a5d907d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\pi )" :db/id #edb/ref 17592186287036} {:answer/id #uuid "8665c345-162b-576a-9c61-51ff95683842" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\frac{\\pi }{2})" :db/id #edb/ref 17592186287037} {:answer/id #uuid "c5eb6149-daf5-55f5-bf44-7ba36035fa71" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\frac{3\\pi }{2})" :db/id #edb/ref 17592186287038} {:answer/id #uuid "34bd2e37-7b16-5cce-ace8-20292ffc3faa" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186287039} {:answer/id #uuid "81ad5168-b66c-541a-b5bf-49fda2d3abc8" :answer/type {:db/ident :answer.type/math} :answer/value "(9,\\frac{3\\pi }{2})" :db/id #edb/ref 17592186287040}] :answer-field/correct {:answer/id #uuid "34bd2e37-7b16-5cce-ace8-20292ffc3faa" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186287039} :answer-field/id #uuid "5ccba5a5-dbd8-5622-986e-9bb3cc24e7d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287035}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "32df1b7d-e14a-54ae-9f1b-ccf5a00b4ff9" :question/math-academy-id "q-120173" :question/problem "Find the **polar** coordinates of the point where the polar curve $r=3$ intersects the positive $x$-axis." :question/worked-solution "The polar curve $r=3$ is a circle of radius $3$ centered at the origin. It crosses the positive $x$-axis at the point where $r=3$ and $\\theta =0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005246/assets/63d6e0d36e3d345561b1c4c20d7d19cb34ae6bd3b7543c042be288d8fcdb12e7.png)\n\nTherefore, the point of intersection in polar coordinates is $(3,0).$"}]}
