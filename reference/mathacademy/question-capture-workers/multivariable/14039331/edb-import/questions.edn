#{[{:db/id #edb/ref 17592186092009 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/id #uuid "14832dae-6df8-5511-9a92-bf9164478091" :question/math-academy-id "e-5386" :question/problem "What is the polar equation of the curve shown below?\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/b0ade58178ac4356466574c51340eb2f.png)" :question/worked-solution "The given curve is a circle of radius $4$ centered at the origin.\n\nTherefore, its polar equation is $r=4$."}] [{:db/id #edb/ref 17592186092010 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/id #uuid "3eb95e18-94ad-563c-bbf8-3843c75958a8" :question/math-academy-id "e-5387" :question/problem "Find the **polar** coordinates of the point where the polar curve $r=2.7$ intersects the negative $x$-axis." :question/worked-solution "The polar curve $r=2.7$ is a circle of radius $2.7$ centered at the origin. It crosses the negative $x$-axis at the point where $r=2.7$ and\n\n$$\n\\theta = \\pi\n$$\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/2300747114f08c9085447b58342f6072.png)\n\nTherefore, the point of intersection in polar coordinates is\n\n$$\n\\left(2.7, \\pi\\right)\n$$"}] [{:db/id #edb/ref 17592186092011 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/id #uuid "285c25a2-acec-57eb-8db8-e708eec876c7" :question/math-academy-id "e-5388" :question/problem "Find the polar equation of the circle centered at the origin that passes through the point $A(2,5)$, as shown below.\n\n![](/home/jake/Developer/MA/DATA/Lessons/937/Source/Images/4b332878cbf0e949d1836127184d68cb.png)" :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r = k$.\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}\nk &= \\sqrt{x^{2} + y^{2}} \\\\\n&= \\sqrt{2^{2} + 5^{2}} \\\\\n&= \\sqrt{29}\n\\end{aligned}\n$$\n\nTherefore, the equation of the circle is\n\n$$\nr=\\sqrt{29}\n$$"}] [{:db/id #edb/ref 17592186267805 :knowledge-point/_questions [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbe59358-b3b5-52a7-8adf-f27015e911fd" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-7)" :db/id #edb/ref 17592186267807} {:answer/id #uuid "7fa741ad-949c-509e-82a2-a467b77b0648" :answer/type {:db/ident :answer.type/math} :answer/value "(14,0)" :db/id #edb/ref 17592186267808} {:answer/id #uuid "63eb1469-77d0-5fcc-ba4a-9eb83774ff48" :answer/type {:db/ident :answer.type/math} :answer/value "(-7,0)" :db/id #edb/ref 17592186267809} {:answer/id #uuid "b3d11050-6f3e-504f-b363-918020073725" :answer/type {:db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186267810} {:answer/id #uuid "4486d5ed-5287-5b64-89c9-0a5d4d1d0916" :answer/type {:db/ident :answer.type/math} :answer/value "(7,0)" :db/id #edb/ref 17592186267811}] :answer-field/correct {:answer/id #uuid "b3d11050-6f3e-504f-b363-918020073725" :answer/type {:db/ident :answer.type/math} :answer/value "(0,7)" :db/id #edb/ref 17592186267810} :answer-field/id #uuid "1e6eed32-cc74-5ce3-9ad5-4fa6e3bcc5c6" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186267806}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7a96cabd-5f58-5178-a1e2-a857e8d0279a" :question/math-academy-id "q-120166" :question/problem "Find the Cartesian coordinates of the point where the polar curve $r=7$ intersects the positive $y$-axis." :question/worked-solution "The polar curve $r=7$ is a circle of radius $7$ centered at the origin. It crosses the positive $y$-axis at the point $(0,7),$ as shown below. \n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/assets/cf8bdc8c72bbc86361dd9378575d8daa10d775132c909b88a77ee185e57fe116.png)\n\nTherefore, the point of intersection is $(0,7).$"}] [{:db/id #edb/ref 17592186287034 :knowledge-point/_questions [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "71ad1af0-11b0-5b91-a4ac-92765a5d907d" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\pi )" :db/id #edb/ref 17592186287036} {:answer/id #uuid "8665c345-162b-576a-9c61-51ff95683842" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\frac{\\pi }{2})" :db/id #edb/ref 17592186287037} {:answer/id #uuid "c5eb6149-daf5-55f5-bf44-7ba36035fa71" :answer/type {:db/ident :answer.type/math} :answer/value "(3,\\frac{3\\pi }{2})" :db/id #edb/ref 17592186287038} {:answer/id #uuid "34bd2e37-7b16-5cce-ace8-20292ffc3faa" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186287039} {:answer/id #uuid "81ad5168-b66c-541a-b5bf-49fda2d3abc8" :answer/type {:db/ident :answer.type/math} :answer/value "(9,\\frac{3\\pi }{2})" :db/id #edb/ref 17592186287040}] :answer-field/correct {:answer/id #uuid "34bd2e37-7b16-5cce-ace8-20292ffc3faa" :answer/type {:db/ident :answer.type/math} :answer/value "(3,0)" :db/id #edb/ref 17592186287039} :answer-field/id #uuid "5ccba5a5-dbd8-5622-986e-9bb3cc24e7d7" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186287035}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "32df1b7d-e14a-54ae-9f1b-ccf5a00b4ff9" :question/math-academy-id "q-120173" :question/problem "Find the **polar** coordinates of the point where the polar curve $r=3$ intersects the positive $x$-axis." :question/worked-solution "The polar curve $r=3$ is a circle of radius $3$ centered at the origin. It crosses the positive $x$-axis at the point where $r=3$ and $\\theta =0.$\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/14005246/assets/63d6e0d36e3d345561b1c4c20d7d19cb34ae6bd3b7543c042be288d8fcdb12e7.png)\n\nTherefore, the point of intersection in polar coordinates is $(3,0).$"}] [{:db/id #edb/ref 17592186092544 :knowledge-point/_questions [{:knowledge-point/id #uuid "93f33baf-c3b5-549a-8eb7-1ab370e9c62b" :knowledge-point/title "Finding the Intersection of a Polar Circle With an Axis"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8092f3eb-c3a3-50d6-9d5d-5501f4173ad3" :answer/type {:db/ident :answer.type/math} :answer/value "(-5, 5)" :db/id #edb/ref 17592186089701} {:answer/id #uuid "9bbc660b-8167-5691-89e9-1013f8353da9" :answer/type {:db/ident :answer.type/math} :answer/value "(5,-5)" :db/id #edb/ref 17592186089702} {:answer/id #uuid "d720101b-7f9b-5d99-b125-e2db5f889964" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-5)" :db/id #edb/ref 17592186089703} {:answer/id #uuid "ef416fdb-019f-5381-9025-842ef3e247b9" :answer/type {:db/ident :answer.type/math} :answer/value "(0, 5)" :db/id #edb/ref 17592186089704} {:answer/id #uuid "797ea623-5514-5a33-9824-350398ba1d7b" :answer/type {:db/ident :answer.type/math} :answer/value "(-5,-5)" :db/id #edb/ref 17592186089705}] :answer-field/correct {:answer/id #uuid "d720101b-7f9b-5d99-b125-e2db5f889964" :answer/type {:db/ident :answer.type/math} :answer/value "(0,-5)" :db/id #edb/ref 17592186089703} :answer-field/id #uuid "2307c450-09e7-5d8a-a2d2-57a3a7523fdc" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186089700}] :question/id #uuid "3b65d3e4-49d1-5dcb-9c0a-4ca0da5a7649" :question/math-academy-id "q-17148" :question/problem "Find the Cartesian coordinates of the point where the polar curve $r = 5$ intersects the negative $y$-axis."}] [{:db/id #edb/ref 17592186267832 :knowledge-point/_questions [{:knowledge-point/id #uuid "c4034e61-63dc-5f72-8275-e9c81290767d" :knowledge-point/title "Identifying the Graph of a Polar Circle"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c99b1288-61f3-5487-a85b-c290e4be4e51" :answer/type {:db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186267834}] :answer-field/correct {:answer/id #uuid "c99b1288-61f3-5487-a85b-c290e4be4e51" :answer/type {:db/ident :answer.type/math} :answer/value "7.5" :db/id #edb/ref 17592186267834} :answer-field/id #uuid "b7821459-d648-52dd-9ea6-6721ee713c02" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186267833}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "af06a753-a603-5a49-b7af-cbf376ff8fb2" :question/math-academy-id "q-325140" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture/13959689/assets/84259f18d3d050bf6c7b0784250e873c92f065fc60a4ca4fa890bcbab1481aeb.png)\n\nThe polar equation of the curve shown above is $r=${{field-1}}." :question/worked-solution "Notice that the given curve is a circle of radius $7.5$ centered at the origin.\n\nTherefore, its polar equation is $r=7.5.$"}] [{:db/id #edb/ref 17592186267843 :knowledge-point/_questions [{:knowledge-point/id #uuid "47358248-2067-590e-80e1-5d20796434c5" :knowledge-point/title "Finding the Polar Equation of a Circle Given a Point on the Circumference"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "c5b2cae2-321f-58dc-83ab-08b1cea647c0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186267845}] :answer-field/correct {:answer/id #uuid "c5b2cae2-321f-58dc-83ab-08b1cea647c0" :answer/type {:db/ident :answer.type/math} :answer/value "5\\sqrt{2}" :db/id #edb/ref 17592186267845} :answer-field/id #uuid "203a5109-baee-5991-bc8c-4149c669b848" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186267844}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "a020aa52-a41b-59b4-a523-caef6a0f3163" :question/math-academy-id "q-325178" :question/problem "The polar equation of the circle that is centered at the origin and that passes through the point $A(1,7)$ is$\\,\\,r=$\n{{field-1}}." :question/worked-solution "A circle of radius $k$ centered at the origin has the polar equation $r=k.$\n\nWe can compute the radius $k$ of our circle using the Pythagorean theorem, as follows:\n\n$$\n\\begin{aligned}k & =\\sqrt{{x}^{2}+{y}^{2}} \\\\  & =\\sqrt{{1}^{2}+{7}^{2}} \\\\  & =\\sqrt{1+49} \\\\  & =\\sqrt{50} \\\\  & =5\\sqrt{2}\\end{aligned}\n$$\n\nTherefore, the equation of the circle is $r=5\\sqrt{2}.$"}]}
