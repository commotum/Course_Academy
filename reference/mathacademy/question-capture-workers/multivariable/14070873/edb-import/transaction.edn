[{:db/id "q-128485/selection/43417cc869ce5109e7c4f1013912d86d2b81a76ab01c0a16f0211d35a8c0c719" :answer/id #uuid "9bd7f932-8ff8-51ba-bd85-e55c6df63a27" :answer/type :answer.type/math :answer/value "⟨t{e}^{-t}(2-t),\\,2t(1+2\\operatorname{ln}⁡t),\\,2t⟩" :db/ensure [:answer/validate]} {:db/id "q-128485/selection/edb331b94d082331187baec4e9ccd3fbbb1c2ebe43b3e92826f4172a1a773ee8" :answer/id #uuid "72da5e22-f0bf-577f-956e-1d65c6414d88" :answer/type :answer.type/math :answer/value "⟨{t}^{2}{e}^{-t},\\,{t}^{2}(1+2\\operatorname{ln}⁡t),\\,1⟩" :db/ensure [:answer/validate]} {:db/id "q-128485/selection/2923bb689d13c9c8a3f823961c5ffd962bea26c5d68495a9c394dfa7ffa5325c" :answer/id #uuid "a9eab0ec-6c89-58f2-bf72-1707cdaafd80" :answer/type :answer.type/math :answer/value "⟨2-t,\\,2(1+2\\operatorname{ln}⁡t),\\,t⟩" :db/ensure [:answer/validate]} {:db/id "q-128485/selection/e2682a43185abd14b7cf46192a659efe0ae312a41c4c68220b8ffe08ceb8a144" :answer/id #uuid "7d5e94df-ccdd-5d32-bc32-afdcf88ddd8c" :answer/type :answer.type/math :answer/value "⟨{e}^{-t},\\,2\\operatorname{ln}⁡t,\\,2t-1⟩" :db/ensure [:answer/validate]} {:db/id "q-128485/selection/44665fdab01989e2e5cc686f1593fb30ee7023e7b9d0945c1c96b5199e8bc759" :answer/id #uuid "a829ac08-8beb-5ae7-a786-3480de0f73c0" :answer/type :answer.type/math :answer/value "⟨t{e}^{-t},\\,1+2\\operatorname{ln}⁡t,\\,2t⟩" :db/ensure [:answer/validate]} {:db/id "q-128485/selection" :answer-field/id #uuid "9b17db77-f25c-5b70-9939-d6cf6de2fce7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-128485/selection/43417cc869ce5109e7c4f1013912d86d2b81a76ab01c0a16f0211d35a8c0c719" :answer-field/choices ["q-128485/selection/43417cc869ce5109e7c4f1013912d86d2b81a76ab01c0a16f0211d35a8c0c719" "q-128485/selection/edb331b94d082331187baec4e9ccd3fbbb1c2ebe43b3e92826f4172a1a773ee8" "q-128485/selection/2923bb689d13c9c8a3f823961c5ffd962bea26c5d68495a9c394dfa7ffa5325c" "q-128485/selection/e2682a43185abd14b7cf46192a659efe0ae312a41c4c68220b8ffe08ceb8a144" "q-128485/selection/44665fdab01989e2e5cc686f1593fb30ee7023e7b9d0945c1c96b5199e8bc759"] :db/ensure [:answer-field/validate]} {:db/id "q-128485" :question/id #uuid "fbfacab3-effc-552c-bfef-932dfae592ff" :question/math-academy-id "q-128485" :question/problem "Find  $(u(t)g(t))^{′}$ where $g(t)=⟨2{e}^{-t},\\,4\\operatorname{ln}⁡t,\\,2⟩$ and $u(t)=\\frac{1}{2}{t}^{2}.$" :question/worked-solution "By the scalar function multiple rule, we have\n\n$$\n(u(t)g(t))^{′}=u(t){g}^{′}(t)+{u}^{′}(t)g(t).\n$$\n\nLet's find ${u}^{′}(t)$ and ${g}^{′}(t).$ \n\n$$\n\\begin{aligned}{g}^{′}(t) & =⟨\\frac{\\text{d}}{\\text{d}t}(2{e}^{-t}),\\,\\frac{\\text{d}}{\\text{d}t}(4\\operatorname{ln}⁡t),\\,\\frac{\\text{d}}{\\text{d}t}(2)⟩ \\\\  & =⟨-2{e}^{-t},\\,\\frac{4}{t},\\,0⟩ \\\\ {u}^{′}(t) & =\\frac{\\text{d}}{\\text{d}t}(\\frac{1}{2}{t}^{2}) \\\\  & =t\\end{aligned}\n$$\n\nTherefore, we obtain\n\n$$\n\\begin{aligned}(u(t)g(t))^{′} & =u(t){g}^{′}(t)+{u}^{′}(t)g(t) \\\\  & =\\frac{1}{2}{t}^{2}⟨-2{e}^{-t},\\,\\frac{4}{t},\\,0⟩+t⟨2{e}^{-t},\\,4\\operatorname{ln}⁡t,\\,2⟩ \\\\  & =⟨-{t}^{2}{e}^{-t},\\,2t,\\,0⟩+⟨2t{e}^{-t},\\,4t\\operatorname{ln}⁡t,\\,2t⟩ \\\\  & =⟨2t{e}^{-t}-{t}^{2}{e}^{-t},\\,2t+4t\\operatorname{ln}⁡t,\\,2t⟩ \\\\  & =⟨t{e}^{-t}(2-t),\\,2t(1+2\\operatorname{ln}⁡t),\\,2t⟩.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-128485/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "b19f5f01-948e-5f44-8016-63073ed31dbc"] :knowledge-point/questions ["q-128485"] :db/ensure [:knowledge-point/validate]} {:db/id "q-128572/selection/84b8c180a6d5834245c290258a4836a6d983742e570b63a3cf41a83ddecbf9e5" :answer/id #uuid "606f4088-3971-5397-a02e-038f42cba5da" :answer/type :answer.type/math :answer/value "[\\begin{aligned}{e}^{t} \\\\ 2{e}^{t} \\\\ 0\\end{aligned}]" :db/ensure [:answer/validate]} {:db/id "q-128572/selection/06bbee325c566f98505496abcd65b6ea6d94ca704c67aa3989b100933631d299" :answer/id #u