        {
          "question": "q-37570",
          "field": null,
          "attribute": "question/problem",
          "value": "For the function $f(x,y,z)=xy+5x+{z}^{2}$, find a vector that's perpendicular to the level surface that passes through the point where $(x,y,z)=(1,-1,2).$",
