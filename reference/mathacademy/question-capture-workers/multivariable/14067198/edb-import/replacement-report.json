        {
          "question": "q-36343",
          "field": null,
          "attribute": "question/problem",
          "value": "Find a vector equation of the normal line to the surface $\\frac{{x}^{2}}{4}-{y}^{2}={z}^{2}$ at the point $(2,0,1).$",
