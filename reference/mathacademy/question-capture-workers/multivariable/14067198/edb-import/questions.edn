#{[{:db/id #edb/ref 17592186124889 :knowledge-point/_questions [{:knowledge-point/id #uuid "ce7d6557-ec20-5a40-b799-1a6a36cbe9e6" :knowledge-point/title "Finding the Equation of the Normal Line to a Surface Using the Gradient"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8755d338-9d35-5422-9dc5-d40321ed32b5" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\langle 1, 0,-2\\rangle  + t\\langle 2, 0, 1\\rangle , t \\in  (- \\infty , \\infty )" :db/id #edb/ref 17592186122357} {:answer/id #uuid "d3ce9125-8c5b-53dc-8c1d-dc0c82440209" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\langle 2, 0, 1\\rangle  + t\\langle 1, 0,-2\\rangle , t \\in  (- \\infty , \\infty )" :db/id #edb/ref 17592186122358} {:answer/id #uuid "e89a9602-ab31-58f2-ac26-585ecb717b00" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\langle 1, 0,-2\\rangle  + t\\langle 1, 0,-2\\rangle , t \\in  (- \\infty , \\infty )" :db/id #edb/ref 17592186122359} {:answer/id #uuid "1e6c8338-8ed3-5917-8fc8-0ee2917db865" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\langle 2, 0, 1\\rangle  + t\\langle 2, 1,-1\\rangle , t \\in  (- \\infty , \\infty )" :db/id #edb/ref 17592186122360} {:answer/id #uuid "79c68d28-8ce3-5853-b4fd-a0384e002f49" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\langle 2, 0, 1\\rangle  + t\\langle 2, 0, 1\\rangle , t \\in  (- \\infty , \\infty )" :db/id #edb/ref 17592186122361}] :answer-field/correct {:answer/id #uuid "d3ce9125-8c5b-53dc-8c1d-dc0c82440209" :answer/type {:db/ident :answer.type/math} :answer/value "r = \\langle 2, 0, 1\\rangle  + t\\langle 1, 0,-2\\rangle , t \\in  (- \\infty , \\infty )" :db/id #edb/ref 17592186122358} :answer-field/id #uuid "37dc062f-78c7-525f-bb98-d0cfd3572c15" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122356}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "967a9051-3e85-5612-827f-8db0c0985ba4" :question/math-academy-id "q-36343" :question/problem "Find a vector equation of the normal line to the surface $\\frac{x^{2}}{4} - y^{2} = z^{2}$ at the point $(2, 0, 1)$." :question/requires-calculator false :question/worked-solution "Define $F=x^2/4-y^2-z^2$, so the surface is $F=0$. Its gradient is $\\langle x/2,-2y,-2z\\rangle$, which at $(2,0,1)$ is $\\langle1,0,-2\\rangle$. A line through the given point in this normal direction is $$\\mathbf r(t)=\\langle2,0,1\\rangle+t\\langle1,0,-2\\rangle,\\qquad t\\in\\mathbb R.$$"}] [{:db/id #edb/ref 17592186124994 :knowledge-point/_questions [{:knowledge-point/id #uuid "4516cb28-0fc0-5c15-b9b2-747c3827e189" :knowledge-point/title "Finding a Normal Vector to a Level Surface"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "cbad3809-ba80-59f9-ba4c-d639a5fee9cf" :answer/type {:db/ident :answer.type/math} :answer/value "4i - 2j + 4k" :db/id #edb/ref 17592186122987} {:answer/id #uuid "0bfccc86-e9f7-5243-8a84-7790a342f294" :answer/type {:db/ident :answer.type/math} :answer/value "4j + k" :db/id #edb/ref 17592186122988} {:answer/id #uuid "47a26aab-bf98-583d-a150-8a48058ef8a7" :answer/type {:db/ident :answer.type/math} :answer/value "-4i - 2k" :db/id #edb/ref 17592186122989} {:answer/id #uuid "765db6cc-9dc8-511b-be71-d07c04b80a09" :answer/type {:db/ident :answer.type/math} :answer/value "i + 2j + 4k" :db/id #edb/ref 17592186122990} {:answer/id #uuid "7fdd6503-ab90-5063-bf80-5d64dfc58891" :answer/type {:db/ident :answer.type/math} :answer/value "4i + j + 4k" :db/id #edb/ref 17592186122991}] :answer-field/correct {:answer/id #uuid "7fdd6503-ab90-5063-bf80-5d64dfc58891" :answer/type {:db/ident :answer.type/math} :answer/value "4i + j + 4k" :db/id #edb/ref 17592186122991} :answer-field/id #uuid "52fb938b-ddb8-55c8-9990-18252f0b9f53" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186122986}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "5878a311-1e95-57bd-8bd7-391f384f5bbd" :question/math-academy-id "q-37570" :question/problem "For the function $f(x, y, z) = xy + 5x + z^{2}$, find a vector that's perpendicular to the level surface that passes through the point where $(x, y, z) = (1,-1, 2)$." :question/requires-calculator false :question/worked-solution "A nonzero gradient is perpendicular to its level surface. Here $$\\nabla f=\\langle y+5,x,2z\\rangle.$$ Evaluating at $(1,-1,2)$ gives $\\langle4,1,4\\rangle=4\\mathbf i+\\mathbf j+4\\mathbf k$."}]}
