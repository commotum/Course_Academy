8f8c0efe2cea" "q-71266/selection/23ffedf560ab79f3207ddbc12b7f5f49135a7827552a22c1d9f060532e2a30e7"] :db/ensure [:answer-field/validate]} {:db/id "q-71266" :question/id #uuid "13385c8f-4361-5ebf-99b7-4f21bd7e90b7" :question/math-academy-id "q-71266" :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n{\\begin{aligned}5x-4y=0 \\\\ 4y-5z=0\\end{aligned}\n$$" :question/worked-solution "First, we notice:\n\n- For the plane $5x-4y=0,$ a normal vector to the plane is ${n}_{1}=⟨5,-4,0⟩.$\n\n- For the plane $4y-5z=0,$ a normal vector to the plane is ${n}_{2}=⟨0,4,-5⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨5,-4,0⟩\\times ⟨0,4,-5⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 5 & -4 & 0 \\\\ 0 & 4 & -5\\end{aligned}\\right| \\\\  & =20i+25j+20k \\\\  & =⟨20,25,20⟩\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71266/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "4b5f51ee-5bde-5e39-8d2a-e5e482be4916"] :knowledge-point/questions ["q-71266"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71447/selection/56538376c355c50f13b2fd43eea2bdc50ae113f72a4982d11ffca7e2df6637bd" :answer/id #uuid "ac61c71e-c9b1-518c-9f17-bc751449a034" :answer/type :answer.type/math :answer/value "{a}_{2}+{a}_{3}=6,\\,b=⟨1,3,6⟩" :db/ensure [:answer/validate]} {:db/id "q-71447/selection/b8c5c31d2caa902f810d4b13e24db78a662f26339b81d7f0c051fdebb21a5ea5" :answer/id #uuid "1dc437d3-cdd7-512b-925b-8d2c6cd42861" :answer/type :answer.type/math :answer/value "{a}_{2}+{a}_{3}=-2,\\,b=⟨2,1,2⟩" :db/ensure [:answer/validate]} {:db/id "q-71447/selection/4289dd5340f58613b1fde26677aac8c92a653415f8eeaf85303f40c2208643ee" :answer/id #uuid "99ea64db-fa3c-5995-a6f1-668a9a79a49c" :answer/type :answer.type/math :answer/value "{a}_{2}+{a}_{3}=2,\\,b=⟨2,2,1⟩" :db/ensure [:answer/validate]} {:db/id "q-71447/selection/31f9c5b451644e186a1b98fa4b7756c7b511940c10d3ec485470108c36b2a8eb" :answer/id #uuid "3574aa75-7514-5202-b4e9-949399ecaa1e" :answer/type :answer.type/math :answer/value "{a}_{2}+{a}_{3}=-3,\\,b=⟨2,1,3⟩" :db/ensure [:answer/validate]} {:db/id "q-71447/selection/c95db116ee9bf98681f5b7df82ed4251384d45cfe03e021e27b8aaeafe90e58b" :answer/id #uuid "bed335ac-6bd0-574b-bda3-8d868ba09685" :answer/type :answer.type/math :answer/value "{a}_{2}+{a}_{3}=3,\\,b=⟨2,1,1⟩" :db/ensure [:answer/validate]} {:db/id "q-71447/selection" :answer-field/id #uuid "2f7522a2-8365-5bbe-a942-7e6cfc58e6e1" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71447/selection/c95db116ee9bf98681f5b7df82ed4251384d45cfe03e021e27b8aaeafe90e58b" :answer-field/choices ["q-71447/selection/56538376c355c50f13b2fd43eea2bdc50ae113f72a4982d11ffca7e2df6637bd" "q-71447/selection/b8c5c31d2caa902f810d4b13e24db78a662f26339b81d7f0c051fdebb21a5ea5" "q-71447/selection/4289dd5340f58613b1fde26677aac8c92a653415f8eeaf85303f40c2208643ee" "q-71447/selection/31f9c5b451644e186a1b98fa4b7756c7b511940c10d3ec485470108c36b2a8eb" "q-71447/selection/c95db116ee9bf98681f5b7df82ed4251384d45cfe03e021e27b8aaeafe90e58b"] :db/ensure [:answer-field/validate]} {:db/id "q-71447" :question/id #uuid "65aeb577-5179-51b6-b6d7-0edba5765814" :question/math-academy-id "q-71447" :question/problem "The intersection of the planes $x+2y-4z+6=0$ and $x-4y+2z=0$ is given by the line\n\n$$\nr(t)=⟨0,{a}_{2},{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{2}+{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $x=0.$ Substituting this into the second equation gives \n\n$$\n0-4y+2z=0\\,⟹\\,z=2y,\n$$\n\nand substituting $x=0$ and $z=2y$ into the first equation gives \n\n$$\n\\begin{aligned}x+2y-4z+6 & =0 \\\\ 0+2y-4(2y)+6 & =0 \\\\ -6y & =-6 \\\\ y & =1.\\end{aligned}\n$$\n\nTherefore, $z=2y=2$ and $a=⟨0,1,2⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y-4z+6=0,$ a normal vector to the plane is ${n}_{1}=⟨1,2,-4⟩.$\n\n- For the plane $x-4y+2z=0,$ a normal vector to the plane is ${n}_{2}=⟨1,-4,2⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,-4⟩\\times ⟨1,-4,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & -4 \\\\ 1 & -4 & 2\\end{aligned}\\right| \\\\  & =-12i-6j-6k \\\\  & =⟨-12,-6,-6⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n \n\n$$\nb=-\\frac{1}{6}({n}_{1}\\times {n}_{2})=⟨2,1,1⟩.\n$$\n\n \n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,1,2⟩+t⟨2,1,1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{2}+{a}_{3}=1+2=3,$ and $b=⟨2,1,1⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71447/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0302bad-e981-5aee-a70f-66045e7f798a"] :knowledge-point/questions ["q-71447"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-71187"] :question/problem "The intersection of the planes $-x+y-2z=0$ and $-x-2y+z-3=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n-x+y-2(0)=0\\,⟹\\,x=y,\n$$\n\nand substituting $z=0$ and $x=y$ into the second equation gives\n\n$$\n\\begin{aligned}-x-2y+z-3 & =0 \\\\ -y-2y+0-3 & =0 \\\\ -3y & =3 \\\\ y & =-1.\\end{aligned}\n$$\n\nTherefore, $x=y=-1$ and $a=⟨-1,-1,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $-x+y-2z=0,$ a normal vector to the plane is ${n}_{1}=⟨-1,1,-2⟩.$\n\n- For the plane $-x-2y+z-3=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,-2,1⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨-1,1,-2⟩\\times ⟨-1,-2,1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ -1 & 1 & -2 \\\\ -1 & -2 & 1\\end{aligned}\\right| \\\\  & =-3i+3j+3k \\\\  & =⟨-3,3,3⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to ${n}_{1}\\times {n}_{2}$ as a direction vector of the line. So, let \n\n$$\nb=\\frac{1}{3}({n}_{1}\\times {n}_{2})=⟨-1,1,1⟩.\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-1,-1,0⟩+t⟨-1,1,1⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=-1-1=-2,$ and $b=⟨-1,1,1⟩.$" :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-129202/selection/7520c320406c8d6eff2759bd0325db5dd47dbab6578bd28a8a42217289641c94" :answer/id #uuid "99a54632-3487-5f66-b6f7-4f9fe3d532de" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=-3,\\,b=⟨9,6,6⟩" :db/ensure [:answer/validate]} {:db/id "q-129202/selection/0f0ea538dfe3a32cac2e270f497c4de5ac5c5b727e977ff59c65994a176ff202" :answer/id #uuid "e009f408-0948-583c-9f36-aa61e528c12c" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=3,\\,b=⟨6,3,6⟩" :db/ensure [:answer/validate]} {:db/id "q-129202/selection/c96ae0556456ca00854e32e37201b3d212987b1c18d2e7bad09369d0b2745503" :answer/id #uuid "cf84f720-68bf-5be5-8c1f-4f6989161d6c" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=0,\\,b=⟨6,9,6⟩" :db/ensure [:answer/validate]} {:db/id "q-129202/selection/80391afeb283211555f4339f65b85171b04d821c1604785e04eea2bce77a9568" :answer/id #uuid "154c79d3-6bc5-5eb8-9dc0-6d20092039a8" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=6,\\,b=⟨6,6,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129202/selection/6ee4989ccb49102d525ad125f89fd137600401ffd1097abb7b769890e9c26169" :answer/id #uuid "d5418a96-3eea-52a4-99cc-cba6ec5608b0" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=0,\\,b=⟨3,9,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129202/selection" :answer-field/id #uuid "a533e508-2e7f-507e-9ebe-7c8ad24094f6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129202/selection/c96ae0556456ca00854e32e37201b3d212987b1c18d2e7bad09369d0b2745503" :answer-field/choices ["q-129202/selection/7520c320406c8d6eff2759bd0325db5dd47dbab6578bd28a8a42217289641c94" "q-129202/selection/0f0ea538dfe3a32cac2e270f497c4de5ac5c5b727e977ff59c65994a176ff202" "q-129202/selection/c96ae0556456ca00854e32e37201b3d212987b1c18d2e7bad09369d0b2745503" "q-129202/selection/80391afeb283211555f4339f65b85171b04d821c1604785e04eea2bce77a9568" "q-129202/selection/6ee4989ccb49102d525ad125f89fd137600401ffd1097abb7b769890e9c26169"] :db/ensure [:answer-field/validate]} {:db/id "q-129202" :question/id #uuid "b183e73c-612e-556a-a6fa-cdffff7f175f" :question/math-academy-id "q-129202" :question/problem "The intersection of the planes $3x-2y-18=0$ and $2y-3z+18=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}-{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this to the first equation gives \n\n$$\n3x-0-18=0\\,⟹\\,x=6,\n$$\n\nand substituting $y=0$ into the second equation gives\n\n$$\n0-3z+18=0\\,⟹\\,z=6.\n$$\n\nTherefore, $a=⟨6,0,6⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $3x-2y-18=0,$ a normal vector to the plane is ${n}_{1}=⟨3,-2,0⟩.$\n\n- For the plane $2y-3z+18=0,$ a normal vector to the plane is ${n}_{2}=⟨0,2,-3⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨3,-2,0⟩\\times ⟨0,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & -2 & 0 \\\\ 0 & 2 & -3\\end{aligned}\\right| \\\\  & =6i+9j+6k \\\\  & =⟨6,9,6⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨6,0,6⟩+t⟨6,9,6⟩\\end{aligned}\n$$\n\n \n\nFinally then, ${a}_{1}-{a}_{3}=6-6=0,$ and $b=⟨6,9,6⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-129202/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0302bad-e981-5aee-a70f-66045e7f798a"] :knowledge-point/questions ["q-129202"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129224/selection/21a9c3d10b913ef40ac88b773ad113bae622e35ee423894258732fb1d8ff078b" :answer/id #uuid "7b41fa7c-383b-551d-8e7d-195af093e233" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-4,\\,b=⟨9,5,3⟩" :db/ensure [:answer/validate]} {:db/id "q-129224/selection/4d77c78d7238ba49f43fbe65d2ee5712c555bb5d8d7747685a0d83504f7a8a21" :answer/id #uuid "3bef7e40-b70b-5a85-8a24-375e22f4f302" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=8,\\,b=⟨5,3,9⟩" :db/ensure [:answer/validate]} {:db/id "q-129224/selection/86778a7c61f3118edf4ca5740841ef4b917716b96b5f7cef9a2d9900dff8ae89" :answer/id #uuid "2f47da4a-b316-542d-9add-3c553c97e434" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=2,\\,b=⟨3,9,5⟩" :db/ensure [:answer/validate]} {:db/id "q-129224/selection/7eeed55e4045d0d569350f75f04086486059021dea0afe123adb0db2eb3b7ba6" :answer/id #uuid "6700ede1-a36b-5eee-942e-0d9f0f54f842" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=4,\\,b=⟨9,3,5⟩" :db/ensure [:answer/validate]} {:db/id "q-129224/selection/eefa33de4685af6b07ddf8607ad9807e9342670e36d2dbe1f4a5b4876dc077d7" :answer/id #uuid "eca8e996-c8fa-5d8f-b034-7e46ddd5ba4d" :answer/type :answer.type/math :answer/value "{a}_{1}+{a}_{2}=-2,\\,b=⟨6,3,5⟩" :db/ensure [:answer/validate]} {:db/id "q-129224/selection" :answer-field/id #uuid "8149ef53-3f86-5b48-a7e1-8fa0afbc8615" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129224/selection/7eeed55e4045d0d569350f75f04086486059021dea0afe123adb0db2eb3b7ba6" :answer-field/choices ["q-129224/selection/21a9c3d10b913ef40ac88b773ad113bae622e35ee423894258732fb1d8ff078b" "q-129224/selection/4d77c78d7238ba49f43fbe65d2ee5712c555bb5d8d7747685a0d83504f7a8a21" "q-129224/selection/86778a7c61f3118edf4ca5740841ef4b917716b96b5f7cef9a2d9900dff8ae89" "q-129224/selection/7eeed55e4045d0d569350f75f04086486059021dea0afe123adb0db2eb3b7ba6" "q-129224/selection/eefa33de4685af6b07ddf8607ad9807e9342670e36d2dbe1f4a5b4876dc077d7"] :db/ensure [:answer-field/validate]} {:db/id "q-129224" :question/id #uuid "923148c0-0ecb-5f91-a025-b18771e50157" :question/math-academy-id "q-129224" :question/problem "The intersection of the planes $2x-y-3z-8=0$ and $x+2y-3z-4=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},{a}_{2},0⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}+{a}_{2},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $z=0.$ Substituting this to the first equation gives\n\n$$\n2x-y-3(0)-8=0\\,⟹\\,y=2x-8,\n$$\n\nand substituting $z=0$ and $y=2x-8$ into the second equation gives\n\n$$\n\\begin{aligned}x+2(2x-8)-0-4 & =0 \\\\ x+4x-16-4 & =0 \\\\ 5x & =20 \\\\ x & =4.\\end{aligned}\n$$\n\nTherefore, $y=2(4)-8=0$ and $a=⟨4,0,0⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x-y-3z-8=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-1,-3⟩.$\n\n- For the plane $x+2y-3z-4=0,$ a normal vector to the plane is ${n}_{2}=⟨1,2,-3⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨2,-1,-3⟩\\times ⟨1,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & -3 \\\\ 1 & 2 & -3\\end{aligned}\\right| \\\\  & =9i+3j+5k \\\\  & =⟨9,3,5⟩\\end{aligned}\n$$\n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨4,0,0⟩+t⟨9,3,5⟩\\end{aligned}\n$$\n\nFinally then, ${a}_{1}+{a}_{2}=4+0=4,$ and $b=⟨9,3,5⟩.$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129224/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0302bad-e981-5aee-a70f-66045e7f798a"] :knowledge-point/questions ["q-129224"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71347/selection/f4bf81c2eba32cb92295951b5624a82eb290e7b619be0a6f8a466c7b2a9e0a52" :answer/id #uuid "0eb7bccb-6b13-538d-a7d9-6876fef93242" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=3,\\,b=⟨-2,-4,2⟩" :db/ensure [:answer/validate]} {:db/id "q-71347/selection/3354aa7b5ace6672adbad985ea6644b2a21536b02d08fa17f6bfefaa69ff313b" :answer/id #uuid "ca85272d-c8e6-5de8-ae5f-276509834959" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=2,\\,b=⟨-4,2,2⟩" :db/ensure [:answer/validate]} {:db/id "q-71347/selection/dcb2724eaa18441510d29504bde7bc114974c528b61d49ec0a79e74a159a2c54" :answer/id #uuid "2a60b638-d8b1-57b4-b880-3bd292690ba1" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=-4,\\,b=⟨-2,-4,2⟩" :db/ensure [:answer/validate]} {:db/id "q-71347/selection/39ee31752afa68099595417b2e5fa4d9f6a506d5ebefd5ab611a1abce12d0a59" :answer/id #uuid "60692775-03e2-554e-a6c2-463e42103a5b" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=-2,\\,b=⟨-4,2,2⟩" :db/ensure [:answer/validate]} {:db/id "q-71347/selection/338b1bdc67a431eabffddd376c5c97e33a3648cee19b403f96f23806d9be6360" :answer/id #uuid "a56f4364-17c3-5089-86db-c35c7232a8ea" :answer/type :answer.type/math :answer/value "{a}_{1}-{a}_{3}=3,\\,b=⟨-4,2,2⟩" :db/ensure [:answer/validate]} {:db/id "q-71347/selection" :answer-field/id #uuid "49d55ebd-d47b-5681-8adf-7c27083248c7" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71347/selection/dcb2724eaa18441510d29504bde7bc114974c528b61d49ec0a79e74a159a2c54" :answer-field/choices ["q-71347/selection/f4bf81c2eba32cb92295951b5624a82eb290e7b619be0a6f8a466c7b2a9e0a52" "q-71347/selection/3354aa7b5ace6672adbad985ea6644b2a21536b02d08fa17f6bfefaa69ff313b" "q-71347/selection/dcb2724eaa18441510d29504bde7bc114974c528b61d49ec0a79e74a159a2c54" "q-71347/selection/39ee31752afa68099595417b2e5fa4d9f6a506d5ebefd5ab611a1abce12d0a59" "q-71347/selection/338b1bdc67a431eabffddd376c5c97e33a3648cee19b403f96f23806d9be6360"] :db/ensure [:answer-field/validate]} {:db/id "q-71347" :question/id #uuid "b23b0cec-a767-5778-8e67-5c10a6b25080" :question/math-academy-id "q-71347" :question/problem "The intersection of the planes $2x-y+6=0$ and $y+2z-2=0$ is given by the line\n\n$$\nr(t)=⟨{a}_{1},0,{a}_{3}⟩+tb,\\,t\\in (-\\infty ,\\infty ).\n$$\n\nCalculate ${a}_{1}-{a}_{3},$ and find a possible direction vector $b.$" :question/worked-solution "We're given that there exists a point on the line where $y=0.$ Substituting this to the first equation gives \n\n$$\n2x-0+6=0\\,⟹\\,x=-3,\n$$\n\nand substituting $y=0$ into the second equation gives\n\n$$\n0+2z-2=0\\,⟹\\,z=1.\n$$\n\nTherefore, $a=⟨-3,0,1⟩$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $2x-y+6=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-1,0⟩.$\n\n- For the plane $y+2z-2=0,$ a normal vector to the plane is ${n}_{2}=⟨0,1,2⟩.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}b & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,-1,0⟩\\times ⟨0,1,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & 0 \\\\ 0 & 1 & 2\\end{aligned}\\right| \\\\  & =-2i-4j+2k \\\\  & =⟨-2,-4,2⟩\\end{aligned}\n$$\n\nThe equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨-3,0,1⟩+t⟨-2,-4,2⟩\\end{aligned}\n$$\n\n \n\nFinally then, ${a}_{1}-{a}_{3}=-3-1=-4,$ and $b=⟨-2,-4,2⟩.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-71347/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "e0302bad-e981-5aee-a70f-66045e7f798a"] :knowledge-point/questions ["q-71347"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71468/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "c7c67c65-8b86-54b4-97dc-1f02d1fcef4b" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-71468/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "4a9f90ff-04ab-56f3-a990-b883575306c6" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-71468/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "c446fdfd-caf2-5a5e-ab87-c16c8089c4ec" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-71468/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "13f99e1d-6f89-5603-aace-967a83531901" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-71468/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "03301ccb-4a15-5dee-83e2-cf25ca472484" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-71468/selection" :answer-field/id #uuid "d3652218-a27d-5c9d-9f9c-1185dc023fdf" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71468/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer-field/choices ["q-71468/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-71468/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-71468/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-71468/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-71468/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-71468" :question/id #uuid "a246de7e-bc39-5688-8da7-0fdc8121bc01" :question/math-academy-id "q-71468" :question/problem "Given the two planes $2x-4y+6z+2=0$ and $-x+2y-3z=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $0.$\n- The planes intersect on a straight line.\n- The planes are coincident." :question/worked-solution "First, notice that:\n\n- For the plane $2x-4y+6z+2=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-4,6⟩.$\n\n- For the plane $-x+2y-3z=0,$ a normal vector to the plane is ${n}_{2}=⟨-1,2,-3⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is true. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨2,-4,6⟩\\times ⟨-1,2,-3⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -4 & 6 \\\\ -1 & 2 & -3\\end{aligned}\\right| \\\\  & =0i+0j+0k \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is false. Since ${n}_{1}\\times {n}_{2}=0$, the vectors ${n}_{1}$ and ${n}_{2}$ are parallel. Hence, the corresponding planes are also parallel. So, the planes can't intersect on a line.\n\n- Statement III is false. Indeed,  the second plane passes through the origin  $O(0,0,0)$ but the first plane doesn't: \n\n$$\n2(0)-4(0)+6(0)+2=2\\ne 0\n$$\n\n So, the planes can't be coincident.\n\nTherefore, only statement I is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71468/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4"] :knowledge-point/questions ["q-71468"] :db/ensure [:knowledge-point/validate]} {:db/id "q-71456/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "e3d675ab-e687-5379-87fd-7d6a7a9dbe34" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-71456/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "bfd53607-311c-576e-87f4-c588898f367d" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-71456/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "3d31a61a-dbc2-505a-86ae-2a4a676ebe47" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-71456/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "f81afe72-8572-5b2e-b772-60383468c072" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-71456/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "276df41e-3ae0-5ff0-a1c6-66219178b6a9" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-71456/selection" :answer-field/id #uuid "2f73c74d-d549-5390-8101-8d61fca29ba6" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-71456/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-71456/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-71456/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-71456/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-71456/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-71456/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-71456" :question/id #uuid "4895b4d9-6e99-5443-b10a-85bc7b1b4155" :question/math-academy-id "q-71456" :question/problem "Given the two planes $x-3y+z=0$ and $2x-y+1=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $⟨1,5,2⟩.$\n- The planes intersect on a line.\n- The planes are coincident." :question/worked-solution "First, notice that:\n\n- For the plane $x-3y+z=0,$ a normal vector to the plane is ${n}_{1}=⟨1,-3,1⟩.$\n\n- For the plane $2x-y+1=0,$ a normal vector to the plane is ${n}_{2}=⟨2,-1,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is false. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,-3,1⟩\\times ⟨2,-1,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & -3 & 1 \\\\ 2 & -1 & 0\\end{aligned}\\right| \\\\  & =i+2j+5k \\\\  & =⟨1,2,5⟩\\ne ⟨1,5,2⟩.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel. Hence, the planes must intersect on a line.\n\n- Statement III is false. Indeed, two non-parallel planes cannot be coincident.\n\nTherefore, only statement II is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-71456/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4"] :knowledge-point/questions ["q-71456"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-71110"] :question/problem "Given the two planes $3x-y+z=0$ and $x-z+4=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $0.$\n- The planes are parallel.\n- The planes intersect on a line." :question/worked-solution "First, notice that:\n\n- For the plane $3x-y+z=0,$ a normal vector to the plane is ${n}_{1}=⟨3,-1,1⟩.$\n\n- For the plane $x-z+4=0,$ a normal vector to the plane is ${n}_{2}=⟨1,0,-1⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is false. Computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨3,-1,1⟩\\times ⟨1,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 3 & -1 & 1 \\\\ 1 & 0 & -1\\end{aligned}\\right| \\\\  & =i+4j+k \\\\  & =⟨1,4,1⟩\\ne 0.\\end{aligned}\n$$\n\n- Statement II is false. Since ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel. As a result, the planes are not parallel either.\n\n- Statement III is true. Indeed, two non-parallel planes in $3$-dimensional space must intersect on a line.\n\nTherefore, only statement III is true." :question/difficulty :question.difficulty/moderate :db/ensure [:question/validate]} {:db/id "q-129259/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "f6bc9956-3f2a-5751-9955-380cc068e4be" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-129259/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "9dbba08a-aee5-5bc2-b685-3b92ad7ff18b" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-129259/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" :answer/id #uuid "6a28c4a1-3a4b-5b47-8e2a-096224035b8c" :answer/type :answer.type/text :answer/value "I and II only" :db/ensure [:answer/validate]} {:db/id "q-129259/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "5cb4e7da-d423-537d-b6d1-eca94ff0ffac" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-129259/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "fdd6c990-9990-5e92-9979-5092fd03374b" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-129259/selection" :answer-field/id #uuid "cb6f1dbf-64e4-5fbc-ab2f-a0d761ede179" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129259/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer-field/choices ["q-129259/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-129259/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" "q-129259/selection/95f63c11f99a5015c1f73558576052145e00c1cfbb1718f78cf554be0ab200f9" "q-129259/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-129259/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c"] :db/ensure [:answer-field/validate]} {:db/id "q-129259" :question/id #uuid "0531b19e-756e-5c97-abd0-1f5e648bd0cf" :question/math-academy-id "q-129259" :question/problem "Given the two planes $2x-y+3z=0$ and $5x-2y+7=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $⟨7,15,2⟩.$\n- The planes intersect on a line.\n- The planes are coincident." :question/worked-solution "First, notice that:\n\n- For the plane $2x-y+3z=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-1,3⟩.$\n\n- For the plane $5x-2y+7=0,$ a normal vector to the plane is ${n}_{2}=⟨5,-2,0⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is false. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨2,-1,3⟩\\times ⟨5,-2,0⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -1 & 3 \\\\ 5 & -2 & 0\\end{aligned}\\right| \\\\  & =6i+15j+k \\\\  & =⟨6,15,1⟩\\ne ⟨7,15,2⟩.\\end{aligned}\n$$\n\n- Statement II is true. Since ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel. Hence, the planes must intersect on a line.\n\n- Statement III is false. Indeed, two non-parallel planes cannot be coincident.\n\nTherefore, only statement II is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129259/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4"] :knowledge-point/questions ["q-129259"] :db/ensure [:knowledge-point/validate]} {:db/id "q-129239/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer/id #uuid "855cd76b-6735-5058-9299-202e4e034510" :answer/type :answer.type/text :answer/value "III only" :db/ensure [:answer/validate]} {:db/id "q-129239/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" :answer/id #uuid "b1d6e9e6-5aba-52d3-8c81-15583f3aeb82" :answer/type :answer.type/text :answer/value "I and III only" :db/ensure [:answer/validate]} {:db/id "q-129239/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" :answer/id #uuid "ee5c003f-4cef-5c77-8d0f-1488927948d0" :answer/type :answer.type/text :answer/value "I only" :db/ensure [:answer/validate]} {:db/id "q-129239/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" :answer/id #uuid "3d92abd1-6987-59aa-b974-08ee8d41ee28" :answer/type :answer.type/text :answer/value "II and III only" :db/ensure [:answer/validate]} {:db/id "q-129239/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981" :answer/id #uuid "a839178d-05a9-56fa-90eb-8225e7dba44e" :answer/type :answer.type/text :answer/value "II only" :db/ensure [:answer/validate]} {:db/id "q-129239/selection" :answer-field/id #uuid "43a6fea0-fd9c-5954-a8d9-c8f50d9254ea" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-129239/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" :answer-field/choices ["q-129239/selection/6a87b4860f595a380edef797b2cc43b24d4896fc51da713259b980588721456c" "q-129239/selection/431472f1dab61ef54de031c09a96fb6a21dc69c8bc09f12797d1d686e8c9e8e6" "q-129239/selection/5b26512916f768e66a2b0af106e5aa3e2ff7ee012277d9669a26d349c343f77b" "q-129239/selection/1f1f2fe9df6485d5cdc7916416b2f79699d874348406e639d5daec02cb2e57e6" "q-129239/selection/df67a18079e3b7b726c109ae1bf07ae161d9f6d37a928c50361c8787d74f7981"] :db/ensure [:answer-field/validate]} {:db/id "q-129239" :question/id #uuid "8065d082-8b78-5fe6-a484-46d6c36cc283" :question/math-academy-id "q-129239" :question/problem "Given the two planes $2x-5y+z+1=0$ and $3x-z+7=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $0.$\n- The planes are parallel.\n- The planes intersect on a line." :question/worked-solution "First, notice that:\n\n- For the plane $2x-5y+z+1=0,$ a normal vector to the plane is ${n}_{1}=⟨2,-5,1⟩.$\n\n- For the plane $3x-z+7=0,$ a normal vector to the plane is ${n}_{2}=⟨3,0,-1⟩.$\n\nNow, let's consider the statements.\n\n- Statement I is false. Computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨2,-5,1⟩\\times ⟨3,0,-1⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 2 & -5 & 1 \\\\ 3 & 0 & -1\\end{aligned}\\right| \\\\  & =5i+5j+15k \\\\  & =⟨5,5,15⟩\\ne 0.\\end{aligned}\n$$\n\n- Statement II is false. Since ${n}_{1}\\times {n}_{2}\\ne 0$, the vectors ${n}_{1}$ and ${n}_{2}$ are not parallel. As a result, the planes are not parallel either.\n\n- Statement III is true. Indeed, two non-parallel planes in $3$-dimensional space must intersect on a line.\n\nTherefore, only statement III is true." :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-129239/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "a19140af-1870-5dee-86a2-6052451803d4"] :knowledge-point/questions ["q-129239"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "e-5920"] :question/problem "Find a direction vector of the line that is given as the intersection of the following two planes:\n\n$$\n{\\begin{aligned}2x+4y+5=0 \\\\ 3y-2z-7=0\\end{aligned}\n$$" :question/worked-solution "First, we notice:\n\n- For the plane $2x+4y +5= 0,$ a normal vector to the plane is $\\mathbf{n}_1 = \\langle 2,4,0 \\rangle.$\n\n- For the plane $3y-2z-7= 0,$ a normal vector to the plane is $\\mathbf{n}_2 = \\langle 0,3,-2 \\rangle.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}v & ={n}_{1}\\times {n}_{2} \\\\  & =⟨2,4,0⟩\\times ⟨0,3,-2⟩ \\\\  & =\\left|\\begin{aligned}\\,i & \\,j & \\,k\\, \\\\ \\,2 & \\,4 & \\,0\\, \\\\ \\,0 & \\,3 & \\,\\,\\,-2\\,\\end{aligned}\\right| \\\\  & =-8i+4j+6k \\\\  & =⟨-8,4,6⟩\\end{aligned}\n$$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5917"] :question/problem "The intersection of the planes $x+2y+4z=0$ and $2x+4y+2z+18=0$ is given by the line \n\n$$\n\\mathbf r(t) = \\langle 0, a_2, a_3\\rangle + t \\mathbf b, \\quad t\\in(-\\infty,\\infty).\n$$\n\nCalculate $a_2+a_3,$ and find a possible direction vector $\\mathbf b.$" :question/worked-solution "We're given that there exists a point on the line where $x=0.$ Substituting this into the first equation gives   \n\n$$\n0+2y+4z=0\\qquad\\Longrightarrow\\qquad y=-2z,\n$$\n\nand substituting $x=0$ and $y=-2z$ into the second equation gives \n\n$$\n\\begin{aligned}2x+4y+2z+18 & =0 \\\\ 2(0)+4(-2z)+2z+18 & =0 \\\\ -6z & =-18 \\\\ z & =3.\\end{aligned}\n$$\n\nTherefore, $y=-2z=-6$ and $\\mathbf a = \\langle 0,-6,3\\rangle$ is a position vector of a point on the line.\n\nNext, we notice:\n\n- For the plane $x+2y+4z=0,$ a normal vector to the plane is $\\mathbf{n}_1 = \\langle 1,2,4 \\rangle.$\n\n- For the plane $2x+4y+2z+18=0,$ a normal vector to the plane is $\\mathbf{n}_2 = \\langle 2,4,2 \\rangle.$\n\nTo find a direction vector for the line, we calculate the cross product of these normal vectors:\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨1,2,4⟩\\times ⟨2,4,2⟩ \\\\  & =\\left|\\begin{aligned}i & j & k \\\\ 1 & 2 & 4 \\\\ 2 & 4 & 2\\end{aligned}\\right| \\\\  & =-12i+6j \\\\  & =⟨-12,6,0⟩\\end{aligned}\n$$\n\nWe can pick any vector that is parallel to $\\mathbf{n}_1 \\times \\mathbf{n}_2$ as a direction vector of the line. So, let \n \n\n$$\n\\mathbf{b} =\\dfrac{1}{6}(\\mathbf{n}_1 \\times \\mathbf{n}_2) = \\langle -2, 1, 0 \\rangle.\n$$\n\n \n\nHence, the equation of the line is:\n\n$$\n\\begin{aligned}r(t) & =a+tb \\\\ r(t) & =⟨0,-6,3⟩+t⟨-2,1,0⟩\\end{aligned}\n$$\n\nFinally then, $a_2 +a_3 = -6+3 = -3,$ and $\\mathbf b = \\langle  -2,1,0\\rangle.$" :db/ensure [:question/validate]} {:db/id [:question/math-academy-id "e-5921"] :question/problem "Given the two planes $4x-2y=0$ and $-2x+y+1=0$, which of the following statements are true?\n\n- The cross product of the normal vectors of the planes is equal to $\\mathbf{0}.$\n\n- The planes are parallel but not coincident.\n\n- The planes intersect on a straight line." :question/worked-solution "First, notice that: \n\n- For the plane $4x-2y=0,$ a normal vector to the plane is $\\mathbf{n}_1 = \\langle 4,-2,0 \\rangle.$\n\n- For the plane $-2x+y+1=0,$ a normal vector to the plane is $\\mathbf{n}_2 = \\langle -2,1,0 \\rangle.$\n\nNow, let's consider the statements.\n\n- Statement I is true. Indeed, computing the cross product of the normal vectors, we get\n\n$$\n\\begin{aligned}{n}_{1}\\times {n}_{2} & =⟨4,-2,0⟩\\times ⟨-2,1,0⟩ \\\\ n & =\\left|\\begin{aligned}i & j & k \\\\ 4 & -2 & 0 \\\\ -2 & 1 & 0\\end{aligned}\\right| \\\\  & =0.\\end{aligned}\n$$\n\n- Statement II is true. Since $\\mathbf{n}_1 \\times \\mathbf{n}_2 =\\mathbf{0}$, the vectors $\\mathbf{n}_1$ and $\\mathbf{n}_2$ are parallel. However,  the first plane passes through the origin  $O(0,0,0)$ but the second plane doesn't: \n\n$$\n-2(0)+(0)+1=1 \\neq 0\n$$\n\n So, the planes are parallel but not coincident.\n\n- Statement III is false. Since the planes are parallel but not coincident, they cannot intersect each other.\n\nTherefore, only statements I and II are true." :db/ensure [:question/validate]}]
