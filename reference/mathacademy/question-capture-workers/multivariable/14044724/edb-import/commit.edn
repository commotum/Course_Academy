y) \\\\ {f}_{y}(x,y,z) & =\\frac{∂}{∂y}(\\operatorname{sin}⁡(xz+2y)) \\\\  & =2\\operatorname{cos}⁡(xz+2y) \\\\ {f}_{z}(x,y,z) & =\\frac{∂}{∂z}(\\operatorname{sin}⁡(xz+2y)) \\\\  & =x\\operatorname{cos}⁡(xz+2y)\\end{aligned}\n$$\n\nTherefore, the gradient vector field of $f(x,y,z)$ is\n\n$$\n\\begin{aligned}∇f(x,y,z) & ={f}_{x}(x,y,z)\\,i+{f}_{y}(x,y,z)\\,j+{f}_{z}(x,y,z)\\,k \\\\  & =z\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+x\\operatorname{cos}⁡(xz+2y)\\,k.\\end{aligned}\n$$" 13194139534972 true] [17592186323755 1000 #edb/ref 17592186323756 13194139534972 true] [17592186323755 1000 #edb/ref 17592186323757 13194139534972 true] [17592186323755 1000 #edb/ref 17592186323758 13194139534972 true] [17592186323755 1000 #edb/ref 17592186323759 13194139534972 true] [17592186323755 1000 #edb/ref 17592186323760 13194139534972 true] [17592186323755 1040 #edb/ref 17592186045450 13194139534972 true] [17592186323755 1041 "selection" 13194139534972 true] [17592186323755 1104 #edb/ref 17592186323757 13194139534972 true] [17592186323755 1110 #uuid "8aa79643-983b-5cc6-9b1d-13948241112b" 13194139534972 true] [17592186323756 1034 "(z+2y)\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+(x+2y)\\operatorname{cos}⁡(xz+2y)\\,k" 13194139534972 true] [17592186323756 1103 #edb/ref 17592186045453 13194139534972 true] [17592186323756 1111 #uuid "cce43dcb-ff6c-5dea-9b2a-827f856310a8" 13194139534972 true] [17592186323757 1034 "z\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+x\\operatorname{cos}⁡(xz+2y)\\,k" 13194139534972 true] [17592186323757 1103 #edb/ref 17592186045453 13194139534972 true] [17592186323757 1111 #uuid "93b30ebb-5a2c-5602-8673-de03e4241a29" 13194139534972 true] [17592186323758 1034 "x\\operatorname{cos}⁡(xz+2y)\\,i+2\\operatorname{cos}⁡(xz+2y)\\,j+z\\operatorname{cos}⁡(xz+2y)\\,k" 13194139534972 true] [17592186323758 1103 #edb/ref 17592186045453 13194139534972 true] [17592186323758 1111 #uuid "8752c14d-a01d-59fe-86c0-7feda7