d}5{y}^{2}-16{x}^{2} & =36 \\\\ 5(-2x)^{2}-16{x}^{2} & =36 \\\\ 5(4{x}^{2})-16{x}^{2} & =36 \\\\ 20{x}^{2}-16{x}^{2} & =36 \\\\ 4{x}^{2} & =36 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186359995 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "f9c2970f-966f-558a-bcea-9e54ce43aca1" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186359997} {:answer/id #uuid "801b3f80-2352-5a5b-ab6a-fde25df0b5b2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186359998}] :answer-field/correct {:answer/id #uuid "801b3f80-2352-5a5b-ab6a-fde25df0b5b2" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186359998} :answer-field/id #uuid "dd7e1f56-5e41-5b9a-8fd6-41033f93f7c6" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186359996} {:answer-field/choices [{:answer/id #uuid "c452fb93-bae8-5b7c-b63e-4ff882bd9cbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186360000}] :answer-field/correct {:answer/id #uuid "c452fb93-bae8-5b7c-b63e-4ff882bd9cbf" :answer/type {:db/ident :answer.type/math} :answer/value "\\sqrt{5}" :db/id #edb/ref 17592186360000} :answer-field/id #uuid "a428063f-2c86-5e48-9be1-a3d5cba3010c" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186359999} {:answer-field/choices [{:answer/id #uuid "63633dcc-b81a-5519-9a62-97a76cdceb2e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360002}] :answer-field/correct {:answer/id #uuid "63633dcc-b81a-5519-9a62-97a76cdceb2e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360002} :answer-field/id #uuid "f0ba12d5-0265-5c37-ac3b-b1c2c6dbaa3a" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186360001} {:answer-field/choices [{:answer/id #uuid "1b4f75b1-b7b4-52ff-b49d-f9845c1ca4d5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186360004}] :answer-field/correct {:answer/id #uuid "1b4f75b1-b7b4-52ff-b49d-f9845c1ca4d5" :answer/type {:db/ident :answer.type/math} :answer/value "-\\sqrt{5}" :db/id #edb/ref 17592186360004} :answer-field/id #uuid "dfefffde-699b-5242-9789-22319f9ba1cb" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186360003}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "d9d02d49-7636-58a4-acfa-f2e21e72e007" :question/math-academy-id "q-278363" :question/problem "From **top to bottom,** the $y$-intercepts of the hyperbola $6{y}^{2}-5{x}^{2}=30$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}6{y}^{2}-5{x}^{2} & =30 \\\\ 6{y}^{2}-5(0)^{2} & =30 \\\\ 6{y}^{2} & =30 \\\\ {y}^{2} & =5 \\\\ y & =\\pm \\sqrt{5}\\end{aligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,\\sqrt{5})$ and $(0,-\\sqrt{5}).$"}] [{:db/id #edb/ref 17592186360005 :knowledge-point/_questions [{:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2" :knowledge-point/title "Finding the Y-Intercepts of a Hyperbola"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "95e7653c-228c-57d3-8677-3ad277ada56e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360007}] :answer-field/correct {:answer/id #uuid "95e7653c-228c-57d3-8677-3ad277ada56e" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360007} :answer-field/id #uuid "fd9b85a6-6c42-57a5-96a9-ae3191188271" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186360006} {:answer-field/choices [{:answer/id #uuid "91857d0c-2882-5459-b392-1006cdd8f427" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186360009}] :answer-field/correct {:answer/id #uuid "91857d0c-2882-5459-b392-1006cdd8f427" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186360009} :answer-field/id #uuid "3cf2c1ba-c164-5bbc-ba24-8699269993fd" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186360008} {:answer-field/choices [{:answer/id #uuid "fa44f86b-e8e9-561a-bfe5-50960695c5d6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360011}] :answer-field/correct {:answer/id #uuid "fa44f86b-e8e9-561a-bfe5-50960695c5d6" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186360011} :answer-field/id #uuid "39f5c4df-7891-57b5-96c2-83075a059261" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186360010} {:answer-field/choices [{:answer/id #uuid "2c0ce82b-8c88-561b-a4ab-2564e4eec0ad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186360013}] :answer-field/correct {:answer/id #uuid "2c0ce82b-8c88-561b-a4ab-2564e4eec0ad" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186360013} :answer-field/id #uuid "217fa460-895e-5a0d-9080-4f19e97655af" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186360012}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "5d4bf610-347d-506f-87c7-d4ba2c7bf9de" :question/math-academy-id "q-278364" :question/problem "From **top to bottom,** the $y$-intercepts of the hyperbola $\\frac{(y-5)^{2}}{9}-\\frac{{x}^{2}}{8}=1$ are\n\n$($\n{{field-1}}, \n{{field-2}} $)\\,$\nand\n$\\,($\n{{field-3}}, \n{{field-4}} $).$" :question/worked-solution "To find the $y$-intercepts of the hyperbola, we substitute $x=0$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}\\frac{(y-5)^{2}}{9}-\\frac{{x}^{2}}{8} & =1 \\\\ \\frac{(y-5)^{2}}{9}-\\frac{(0)^{2}}{8} & =1 \\\\ \\frac{(y-5)^{2}}{9} & =1 \\\\ (y-5)^{2} & =9 \\\\ y-5 & =\\pm 3 \\\\ y & =5\\pm 3\\end{aligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,8)$ and $(0,2).$"}] [{:db/id #edb/ref 17592186360014 :knowledge-point/_questions [{:knowledge-point/id #uuid "395f435d-473f-5dae-b215-2986556d5793" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Horizontal or Vertical Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8884b8f8-0339-5827-bd37-614857c9bcc0" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,\\pm \\sqrt{12})" :db/id #edb/ref 17592186360016} {:answer/id #uuid "dff55525-e506-584d-bac7-a1be0063a011" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,\\pm 3)" :db/id #edb/ref 17592186360017} {:answer/id #uuid "18c89104-4007-55e8-ae0a-3b38bc848e39" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,\\pm 1)" :db/id #edb/ref 17592186360018} {:answer/id #uuid "f152379d-2c11-54af-beff-ec0c81a59f4c" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,\\pm 4)" :db/id #edb/ref 17592186360019} {:answer/id #uuid "d6bdf077-136f-5991-85ed-17a843e381a8" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,\\pm 2)" :db/id #edb/ref 17592186360020}] :answer-field/correct {:answer/id #uuid "d6bdf077-136f-5991-85ed-17a843e381a8" :answer/type {:db/ident :answer.type/math} :answer/value "(-4,\\pm 2)" :db/id #edb/ref 17592186360020} :answer-field/id #uuid "bec6bf07-1108-56ab-86b6-96ee21439376" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186360015}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "f1b76fe6-e9e5-5c33-85d4-d5b82c87f855" :question/math-academy-id "q-8006" :question/problem "Calculate the points where the hyperbola ${x}^{2}-{y}^{2}=12$ intersects the line $x=-4.$" :question/worked-solution "To find the points where the hyperbola intersects the line $x=-4,$ we substitute $x=-4$ into the equation of the hyperbola and solve for $y,$ as follows:\n\n$$\n\\begin{aligned}{x}^{2}-{y}^{2} & =12 \\\\ (-4)^{2}-{y}^{2} & =12 \\\\ 16-{y}^{2} & =12 \\\\ -{y}^{2} & =12-16 \\\\ -{y}^{2} & =-4 \\\\ {y}^{2} & =4 \\\\ y & =\\pm 2\\end{aligned}\n$$\n\nTherefore, the hyperbola intersects the vertical line $x=-4$  at the points $(-4,\\pm 2).$"}] [{:db/id #edb/ref 17592186088370 :knowledge-point/_questions [{:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384" :knowledge-point/title "Finding the Points of Intersection of a Hyperbola and a Line"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8f18e5f0-9a99-55a8-9cbf-683d9032b1cb" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± 2" :db/id #edb/ref 17592186087151} {:answer/id #uuid "b6548623-04e3-5f81-9f25-2589d5f01860" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± 5" :db/id #edb/ref 17592186087152} {:answer/id #uuid "eb627f63-05ee-542a-a6e4-8985a3ba8b75" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± 5\\sqrt{2}" :db/id #edb/ref 17592186087153} {:answer/id #uuid "0cd3c7a2-f452-52a6-92df-88838a43e778" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± \\sqrt{2}" :db/id #edb/ref 17592186087154} {:answer/id #uuid "6b633672-43b8-5bda-b94c-ad212c388574" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± \\sqrt{10}" :db/id #edb/ref 17592186087155}] :answer-field/correct {:answer/id #uuid "b6548623-04e3-5f81-9f25-2589d5f01860" :answer/type {:db/ident :answer.type/math} :answer/value "x = ± 5" :db/id #edb/ref 17592186087152} :answer-field/id #uuid "9d033d06-3526-538e-9217-f854e2607c64" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186087150}] :question/difficulty {:db/id #edb/ref 17592186045465 :db/ident :question.difficulty/moderate} :question/id #uuid "d7e2b8cf-e8f6-57f5-b746-8a56ea866821" :question/math-academy-id "q-84056" :question/problem "Calculate the $x$-coordinates of the points where the hyperbola $14{x}^{2}-3{y}^{2}=50$ intersects the line $y=2x.$" :question/worked-solution "To find the points where the hyperbola intersects the line $y=2x,$ we first replace $y$ with $2x$ in the equation of the hyperbola and solve for $x,$ as follows:\n\n$$\n\\begin{aligned}14{x}^{2}-3{y}^{2} & =50 \\\\ 14{x}^{2}-3(2x)^{2} & =50 \\\\ 14{x}^{2}-12{x}^{2} & =50 \\\\ 2{x}^{2} & =50 \\\\ {x}^{2} & =25 \\\\ x & =\\pm 5\\end{aligned}\n$$"}]}
