\n\\begin{aligned}5{y}^{2}-16{x}^{2} & =36 \\\\ 5(-2x)^{2}-16{x}^{2} & =36 \\\\ 5(4{x}^{2})-16{x}^{2} & =36 \\\\ 20{x}^{2}-16{x}^{2} & =36 \\\\ 4{x}^{2} & =36 \\\\ {x}^{2} & =9 \\\\ x & =\\pm 3\\end{aligned}\n$$" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-170559/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "55a53010-eddc-5115-8c70-0f32d0144384"] :knowledge-point/questions ["q-170559"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278363/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "801b3f80-2352-5a5b-ab6a-fde25df0b5b2" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278363/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "f9c2970f-966f-558a-bcea-9e54ce43aca1" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-278363/field-1" :answer-field/id #uuid "dd7e1f56-5e41-5b9a-8fd6-41033f93f7c6" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278363/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278363/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" "q-278363/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c"] :db/ensure [:answer-field/validate]} {:db/id "q-278363/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer/id #uuid "c452fb93-bae8-5b7c-b63e-4ff882bd9cbf" :answer/type :answer.type/math :answer/value "\\sqrt{5}" :db/ensure [:answer/validate]} {:db/id "q-278363/field-2" :answer-field/id #uuid "a428063f-2c86-5e48-9be1-a3d5cba3010c" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278363/field-2/219347bb4a6f51134d7f5aff5da33544f44afee934064621ebff9cf9e335ee59" :answer-field/choices ["q-278363/field-2/21934