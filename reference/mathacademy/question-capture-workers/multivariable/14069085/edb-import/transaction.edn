ligned}\n$$\n\nSo, from top to bottom, the $y$-intercepts are $(0,\\sqrt{5})$ and $(0,-\\sqrt{5}).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-278363/field-1" "q-278363/field-2" "q-278363/field-3" "q-278363/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "c249cf3a-7864-5132-80fa-c18a3ea915c2"] :knowledge-point/questions ["q-278363"] :db/ensure [:knowledge-point/validate]} {:db/id "q-278364/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "95e7653c-228c-57d3-8677-3ad277ada56e" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278364/field-1" :answer-field/id #uuid "fd9b85a6-6c42-57a5-96a9-ae3191188271" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278364/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-278364/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-278364/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "91857d0c-2882-5459-b392-1006cdd8f427" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-278364/field-2" :answer-field/id #uuid "3cf2c1ba-c164-5bbc-ba24-8699269993fd" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-278364/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer-field/choices ["q-278364/field-2/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-278364/field-3/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "fa44f86b-e8e9-561a-bfe5-50960695c5d6" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-278364/field-3" :answer-field/id #uuid "39f