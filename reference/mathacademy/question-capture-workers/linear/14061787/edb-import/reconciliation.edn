qrt{2}}{6}\\end{aligned}].\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/state.json" "file_sha256" "d6ff7893746d5926bfee0b19fb216e66a76d85b1665924c9a1415a087e12b808"} {"question" "q-81701" "field" nil "attribute" "question/worked-solution" "value" "Notice that $A$ is a rotation-scaling matrix. So, we need to find its scale factor and the angle of rotation.\n\nWe can find the scale factor using the following formula:\n\n$$\n\\begin{aligned}r & =\\sqrt{det(A)} \\\\  & =\\sqrt{{(\\frac{\\sqrt{2}}{6})}^{2}+{(\\frac{\\sqrt{2}}{6})}^{2}} \\\\  & =\\sqrt{\\frac{1}{18}+\\frac{1}{18}} \\\\  & =\\frac{1}{3}\\end{aligned}\n$$\n\nNow, we can represent $A$ as a product of a rotation and a scaling matrix, as follows:\n\n$$\n\\begin{aligned}A & =\\frac{1}{3}[\\begin{aligned}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}\\frac{1}{3} & 0 \\\\ 0 & \\frac{1}{3}\\end{aligned}][\\begin{aligned}\\frac{\\sqrt{2}}{2} & -\\frac{\\sqrt{2}}{2} \\\\ \\frac{\\sqrt{2}}{2} & \\frac{\\sqrt{2}}{2}\\end{aligned}] \\\\  & =[\\begin{aligned}r & 0 \\\\ 0 & r\\end{aligned}][\\begin{aligned}\\operatorname{cos}⁡\\theta  & -\\operatorname{sin}⁡\\theta  \\\\ \\operatorname{sin}⁡\\theta  & \\operatorname{cos}⁡\\theta \\end{aligned}]\\end{aligned}\n$$\n\nHence, we obtain that\n\n$$\n{\\begin{aligned}\\operatorname{cos}⁡\\theta =\\frac{\\sqrt{2}}{2} \\\\ \\operatorname{sin}⁡\\theta =\\frac{\\sqrt{2}}{2}\\end{aligned}\\,⟹\\,\\theta =\\frac{\\pi }{4}.\n$$\n\nTherefore, in order to find $Av$, we need to rotate $v$ counterclockwise by an angle of $\\frac{\\pi }{4}$  and scale the result by a scale factor of $\\frac{1}{3},$ as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/assets/fd2fda4038ae2342b37df91a520a58463ce70748c143c6619968da71411aff1c.png)" "category" "ma_capt