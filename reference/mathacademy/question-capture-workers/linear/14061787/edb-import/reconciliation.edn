ed}],\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=[\\begin{aligned}-2 & 4 \\\\ -4 & 2\\end{aligned}]$ is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\n- $B=[\\begin{aligned}2 & -\\frac{3}{4} \\\\ \\frac{3}{4} & 2\\end{aligned}]$ is a rotation-scaling matrix.\n\n- $C=[\\begin{aligned}\\frac{1}{2} & 5 \\\\ -5 & \\frac{1}{2}\\end{aligned}]$ is a rotation-scaling matrix.\n\nIn conclusion, the correct answer is \"II and III only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/state.json" "file_sha256" "d6ff7893746d5926bfee0b19fb216e66a76d85b1665924c9a1415a087e12b808"} {"question" "q-81455" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/activity-metadata.json" "file_sha256" "140724903febdf52edcd18134bc8709b585a33a0f61d7aebf80eb921edbc4f75"} {"question" "q-81455" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/state.json" "file_sha256" "d6ff7893746d5926bfee0b19fb216e66a76d85b1665924c9a1415a087e12b808"} {"question" "q-81455" "field" "selection" "attribute" "answer-field/choices" "value" [["text" "I and II only"] ["text" "I and III only"] ["text" "II and III only"] ["text" "II only"] ["text" "III only"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/state.json" "file_sha256" "d6ff7893746d5926bfee0b19fb216e66a76d85b1665924c9a1415a087e12b808"} {"question" "q-81455" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/text "II and III only"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/state.json" "file_sha256" "d6ff7893746d5926bfee0b19fb216e66a76d85b1665924c9a1415a087e12b808"} {"question" "q-81453" "field" nil "attribute" "question/problem" "value" "Which of the following are rotation-scaling matrices?\n\n- $A=[\\begin{aligned}1 & 2 \\\\ 2 & 1\\end{aligned}]$\n- $B=[\\begin{aligned}-2 & -5 \\\\ 5 & -2\\end{aligned}]$\n- $C=[\\begin{aligned}8 & 4 \\\\ -4 & -8\\end{aligned}]$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/state.json" "file_sha256" "d6ff7893746d5926bfee0b19fb216e66a76d85b1665924c9a1415a087e12b808"} {"question" "q-81453" "field" nil "attribute" "question/worked-solution" "value" "A rotation-scaling matrix has the form \n\n$$\n[\\begin{aligned}a & -b \\\\ b & a\\end{aligned}],\n$$\n\n where $a$ and $b$ are real numbers that are not equal to zero simultaneously. Notice that the entries on the main diagonal are the same, while the antidiagonal entries have opposite signs.\n\nWith that in mind let's check each of the given matrices:\n\n- $A=[\\begin{aligned}1 & 2 \\\\ 2 & 1\\end{aligned}]$ is *not* a rotation-scaling matrix since the entries on the antidiagonal do not have opposite signs.\n\n- $B=[\\begin{aligned}-2 & -5 \\\\ 5 & -2\\end{aligned}]$ is a rotation-scaling matrix.\n\n- $C=[\\begin{aligned}8 & 4 \\\\ -4 & -8\\end{aligned}]$ is *not* a rotation-scaling matrix since the entries on the main diagonal are not the same.\n\nIn conclusion, the correct answer is \"II only.\"" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14061787/state.json" "file_sha256" "d6ff7893746d5926bfee0b19fb216