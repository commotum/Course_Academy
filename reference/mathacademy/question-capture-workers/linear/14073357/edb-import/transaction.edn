nates of the respective endpoints of the image are ${A}^{′}(2,3)$ and ${B}^{′}(-2,-1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275723/field-1" "q-275723/field-2" "q-275723/field-3" "q-275723/field-4"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570"] :knowledge-point/questions ["q-275723"] :db/ensure [:knowledge-point/validate]} {:db/id "q-281528/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer/id #uuid "b8dd75cb-dcc8-5329-a0fc-a4a634e2fdf6" :answer/type :answer.type/math :answer/value "2" :db/ensure [:answer/validate]} {:db/id "q-281528/field-1" :answer-field/id #uuid "c0884984-7a45-5219-9267-c0a1837828bb" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281528/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b" :answer-field/choices ["q-281528/field-1/954f2b2ecf089f1c43903a74f4575cff67408acc792f8a71c271fa3076456a3b"] :db/ensure [:answer-field/validate]} {:db/id "q-281528/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "dcf648e0-7b28-5488-8553-23d4ae49796a" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-281528/field-2" :answer-field/id #uuid "08ddcdba-9b46-5001-85a1-997166a762f4" :answer-field/key "field-2" :answer-field/type :answer-field.type/blank :answer-field/correct "q-281528/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer-field/choices ["q-281528/field-2/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467"] :db/ensure [:answer-field/validate]} {:db/id "q-281528/field-3/e9bc05c525076ace5dedc0dc52c4f8497f441cd3bf97b666736f75acd9994b26" :answer/id #uuid "1fdc7822-b4e9-5c52-b584-de2eaf28bfc1" :answer/type :answer.type/math :answer/value "-1" :db/ensure [:answer/validate]} {:db/id "q-281528/field-3" :answer-field/id #uuid "01c70ba7-2a35-