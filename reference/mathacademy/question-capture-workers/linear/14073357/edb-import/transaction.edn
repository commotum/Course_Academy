validate]} {:db/id "q-8126/selection" :answer-field/id #uuid "1e1c065c-ebf8-5346-ad25-b28c4ea47925" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-8126/selection/2fdea4df16de41ade6c371224faf39c737fa167dbc32b9b87fe1dd2fec5eedad" :answer-field/choices ["q-8126/selection/4ba11cb3a7b045cb8d33ae097e8e72130fe1c045fb4e65bd267fcbbb7cf5096e" "q-8126/selection/81b1bcd8603c3aaa8e7e85320614d201521356faf6b0fee380b61a5b6f7572a2" "q-8126/selection/7aa0211040cd523a3bfb540a23d71eb0b48c7f806d334a20a9f3d0ee41efef68" "q-8126/selection/2fdea4df16de41ade6c371224faf39c737fa167dbc32b9b87fe1dd2fec5eedad" "q-8126/selection/339c233748ae1637045ad05ee1c6f4d2517b8802ea4109712f27d98849706320"] :db/ensure [:answer-field/validate]} {:db/id "q-8126" :question/id #uuid "5ad0b5a6-8752-53ba-ae89-ffc7b79418db" :question/math-academy-id "q-8126" :question/problem "![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073357/assets/7bfcc5c729475256b70211bcf18e94b605e4486790b13794eaa46cce4f6461bb.png)\n\nConsider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}-1 & -1 \\\\ -1 & 1\\end{aligned}].\n$$\n\nThe triangle $△ABC$ is shown above. Which of the following is $△{A}^{′}{B}^{′}{C}^{′},$ the image of $△ABC$ under the action of $T?$" :question/worked-solution "To find the image of $T$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $△ABC:$\n\n$$\nX=[\\begin{aligned}2 & 2 & 0 \\\\ 1 & 2 & 2\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}-1 & -1 \\\\ -1 & 1\\end{aligned}][\\begin{aligned}2 & 2 & 0 \\\\ 1 & 2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}-3 & -4 & -2 \\\\ -1 & 0 & 2\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $△{A}^{′}{B}^{′}{C}^{′}$ are $(-3,-1),(-4,0),(-2,2)$, as shown below.\n\n![](/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073357/assets/548c907226db9cbdc8fb4dd18c74f3a2001ba7d90973c6f433f67b3e6b87fd29.png)" :question/difficulty :question.difficulty/moderate :question/answer-fields ["q-8126/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2"] :knowledge-point/questions ["q-8126"] :db/ensure [:knowledge-point/validate]} {:db/id "q-77702/selection/dd7b6d27ff8b8371f164dbc719792cd0d86b5b668984f842fbf7f7638818ae75" :answer/id #uuid "b4e11a5c-18d9-5268-b41e-75ff9561ea74" :answer/type :answer.type/text :answer/value "$(0,5)$ and $(3,0)$" :db/ensure [:answer/validate]} {:db/id "q-77702/selection/ccf9e8a243578c75a4cc9d959cbae07e061c9419b67ce00ce21c29d4c66f258d" :answer/id #uuid "bbde8cf9-a708-5e38-bd0f-683a49c7e832" :answer/type :answer.type/text :answer/value "$(1,4)$ and $(3,1)$" :db/ensure [:answer/validate]} {:db/id "q-77702/selection/31878d168e7b47d7aa0bb70f0ee41ec9cac944c385c660988ad90b772bee5140" :answer/id #uuid "a345ab2c-4274-5414-b7bb-05c3d4c84dff" :answer/type :answer.type/text :answer/value "$(0,5)$ and $(3,1)$" :db/ensure [:answer/validate]} {:db/id "q-77702/selection/70e6a8fdf3769038cda644547ec1bae9b5f8136cb594eeae28188215d943030e" :answer/id #uuid "feeab34e-ace3-55a0-88f3-651310947da3" :answer/type :answer.type/text :answer/value "$(0,4)$ and $(3,0)$" :db/ensure [:answer/validate]} {:db/id "q-77702/selection/f10a0ff300387fd75f5ee90cf57b72b59e42b2493dcfc90fbe075da0b3b4ae6e" :answer/id #uuid "016a6520-b2fe-5a87-b546-c195abbd9cef" :answer/type :answer.type/text :answer/value "$(3,0)$ and $(1,5)$" :db/ensure [:answer/validate]} {:db/id "q-77702/selection" :answer-field/id #uuid "b56c8330-7fd1-586c-b3c9-aece000b157f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-77702/selection/31878d168e7b47d7aa0bb70f0ee41ec9cac944c385c660988ad90b772bee5140" :answer-field/choices ["q-77702/selection/dd7b6d27ff8b8371f164dbc719792cd0d86b5b668984f842fbf7f7638818ae75" "q-77702/selection/ccf9e8a243578c75a4cc9d959cbae07e061c9419b67ce00ce21c29d4c66f258d" "q-77702/selection/31878d168e7b47d7aa0bb70f0ee41ec9cac944c385c660988ad90b772bee5140" "q-77702/selection/70e6a8fdf3769038cda644547ec1bae9b5f8136cb594eeae28188215d943030e" "q-77702/selection/f10a0ff300387fd75f5ee90cf57b72b59e42b2493dcfc90fbe075da0b3b4ae6e"] :db/ensure [:answer-field/validate]} {:db/id "q-77702" :question/id #uuid "1ce85cdf-9cf6-579d-9e59-8136ffddac21" :question/math-academy-id "q-77702" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(-1,2)$ and $B(1,1).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}-1 & 1 \\\\ 2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}-1 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 \\\\ 5 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(0,5)$ and ${B}^{′}(3,1).$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-77702/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570"] :knowledge-point/questions ["q-77702"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275723/field-1/954f2b2ecf089f1c43903a74f4575cff6740