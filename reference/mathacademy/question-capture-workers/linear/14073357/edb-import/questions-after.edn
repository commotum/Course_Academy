field/choices [{:answer/id #uuid "ad115727-d9fc-5ca7-83d5-d7f7ac543635" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186378769}] :answer-field/correct {:answer/id #uuid "ad115727-d9fc-5ca7-83d5-d7f7ac543635" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186378769} :answer-field/id #uuid "7f830f56-3ce9-584b-a86a-5a13f83ea3ae" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378768}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "78916eea-8ea3-5fb8-ad2b-bd912342579d" :question/math-academy-id "q-275723" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(1,2)$ and $B(-1,0).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$\n\n${A}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{B}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}1 & -1 \\\\ 2 & 0\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 0 \\\\ 1 & 1\\end{aligned}][\\begin{aligned}1 & -1 \\\\ 2 & 0\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -2 \\\\ 3 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(2,3)$ and ${B}^{′}(-2,-1).$"}] [{:db/id #edb/ref 17592186378770 :knowledge-point/_questions [{:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b8dd75cb-dcc8-5329-a0fc-a4a634e2fdf6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186378772}] :answer-field/correct {:answer/id #uuid "b8dd75cb-dcc8-5329-a0fc-a4a634e2fdf6" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186378772} :answer-field/id #uuid "c0884984-7a45-5219-9267-c0a1837828bb" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378771} {:answer-field/choices [{:answer/id #uuid "dcf648e0-7b28-5488-8553-23d4ae49796a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186378774}] :answer-field/correct {:answer/id #uuid "dcf648e0-7b28-5488-8553-23d4ae49796a" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186378774} :answer-field/id #uuid "08ddcdba-9b46-5001-85a1-997166a762f4" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378773} {:answer-field/choices [{:answer/id #uuid "1fdc7822-b4e9-5c52-b584-de2eaf28bfc1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186378776}] :answer-field/correct {:answer/id #uuid "1fdc7822-b4e9-5c52-b584-de2eaf28bfc1" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186378776} :answer-field/id #uuid "01c70ba7-2a35-5a8a-adc4-72d3c50186fb" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378775} {:answer-field/choices [{:answer/id #uuid "8cc56518-5f81-5213-8824-200c279c3c8e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186378778}] :answer-field/correct {:answer/id #uuid "8cc56518-5f81-5213-8824-200c279c3c8e" :answer/type {:db/ident :answer.type/math} :answer/value "-1" :db/id #edb/ref 17592186378778} :answer-field/id #uuid "f6014a11-a58b-5003-b8c7-528ab8680ef0" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378777}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "7fb91272-6a8f-5f17-8cda-7dd3a421ac45" :question/math-academy-id "q-281528" :question/problem "Let $T$ be the linear transformation with matrix representation $T$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{RS}$ has endpoints at $R(0,2)$ and $S(-1,1).$ What are the coordinates of the corresponding endpoints $\\overset{―}{{R}^{′}{S}^{′}}$, the image of $\\overset{―}{RS}$ under the action of $T?$\n\n${R}^{′}($ \n{{field-1}}, \n{{field-2}}\n$)\\,$ and $\\,{S}^{′}($ \n{{field-3}}, \n{{field-4}}\n$)$" :question/worked-solution "To find the image of $\\overset{―}{RS}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{RS}:$\n\n$$\nX=[\\begin{aligned}0 & -1 \\\\ 2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ 1 & 0\\end{aligned}][\\begin{aligned}0 & -1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}2 & -1 \\\\ 0 & -1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${R}^{′}(2,0)$ and ${S}^{′}(-1,-1).$"}] [{:db/id #edb/ref 17592186378779 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "edf47467-7a93-5812-abe6-ea6e1e049c91" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592