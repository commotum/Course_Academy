1d-90a9-4283c609b768" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186378789}] :answer-field/correct {:answer/id #uuid "121d0f3e-566c-5a1d-90a9-4283c609b768" :answer/type {:db/ident :answer.type/math} :answer/value "-10" :db/id #edb/ref 17592186378789} :answer-field/id #uuid "bfec59a3-f127-533d-bdf0-6dfb0a95eb42" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378788} {:answer-field/choices [{:answer/id #uuid "c11ab975-7597-5e21-8331-eaff8a1bad12" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186378791}] :answer-field/correct {:answer/id #uuid "c11ab975-7597-5e21-8331-eaff8a1bad12" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186378791} :answer-field/id #uuid "b07dbe96-f4e3-54b3-a9a9-ffb06a0b19fc" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186378790}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "2717d20d-beb3-545b-9060-dea831bd6940" :question/math-academy-id "q-281560" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}].\n$$\n\nA triangle $PQR$ has vertices at $P(1,3),\\,Q(5,-1),$ and $R(-2,4).$ What are the coordinates of the corresponding vertices of  $△{P}^{′}{Q}^{′}{R}^{′}$, the image of $△PQR$ under the action of $T?$\n\n${P}^{′}($ \n{{field-1}}, \n{{field-2}}\n$),\\,$  $\\,{Q}^{′}($ \n{{field-3}}, \n{{field-4}}\n$),\\,$ $\\,{R}^{′}($ \n{{field-5}}, \n{{field-6}}\n$)$" :question/worked-solution "To find the image of $△PQR$ under the action of $T$, we first create a matrix $X$ containing all of the vertices of $PQR:$\n\n$$\nX=[\\begin{aligned}1 & 5 & -2 \\\\ 3 & -1 & 4\\end{aligned}]\n$$\n\nNow, we compute the image of $X$ under $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}3 & -1 \\\\ 0 & 2\\end{aligned}][\\begin{aligned}1 & 5 & -2 \\\\ 3 & -1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 16 & -10 \\\\ 6 & -2 & 8\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective vertices of $△{P}^{′}{Q}^{′}{R}^{′}$ are ${P}^{′}(0,6),$\n${Q}^{′}(16,-2),$ ${R}^{′}(-10,8).$"}] [{:db/id #edb/ref 17592186378792 :knowledge-point/_questions [{:knowledge-point/id #uuid "85936915-4c9c-572c-af99-025fec0f7570" :knowledge-point/title "Computing the Image of a Line Segment Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a345ab2c-4274-5414-b7bb-05c3d4c84dff" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,5)$ and $(3,1)$" :db/id #edb/ref 17592186378794} {:answer/id #uuid "feeab34e-ace3-55a0-88f3-651310947da3" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,4)$ and $(3,0)$" :db/id #edb/ref 17592186378795} {:answer/id #uuid "bbde8cf9-a708-5e38-bd0f-683a49c7e832" :answer/type {:db/ident :answer.type/text} :answer/value "$(1,4)$ and $(3,1)$" :db/id #edb/ref 17592186378796} {:answer/id #uuid "b4e11a5c-18d9-5268-b41e-75ff9561ea74" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,5)$ and $(3,0)$" :db/id #edb/ref 17592186378797} {:answer/id #uuid "016a6520-b2fe-5a87-b546-c195abbd9cef" :answer/type {:db/ident :answer.type/text} :answer/value "$(3,0)$ and $(1,5)$" :db/id #edb/ref 17592186378798}] :answer-field/correct {:answer/id #uuid "a345ab2c-4274-5414-b7bb-05c3d4c84dff" :answer/type {:db/ident :answer.type/text} :answer/value "$(0,5)$ and $(3,1)$" :db/id #edb/ref 17592186378794} :answer-field/id #uuid "b56c8330-7fd1-586c-b3c9-aece000b157f" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186378793}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1ce85cdf-9cf6-579d-9e59-8136ffddac21" :question/math-academy-id "q-77702" :question/problem "Consider the linear transformation $T$ with matrix representation $T,$ given by\n\n$$\nT=[\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}].\n$$\n\nA line segment $\\overset{―}{AB}$ has endpoints at $A(-1,2)$ and $B(1,1).$ What are the coordinates of the corresponding endpoints of $\\overset{―}{{A}^{′}{B}^{′}}$, the image of $\\overset{―}{AB}$ under the action of $T?$" :question/worked-solution "To find the image of $\\overset{―}{AB}$ under the action of $T$, we first create a matrix $X$ containing the coordinates of the endpoints of $\\overset{―}{AB}:$\n\n$$\nX=[\\begin{aligned}-1 & 1 \\\\ 2 & 1\\end{aligned}].\n$$\n\nNow, we compute the image of $X$ under the action of $T$ by calculating the matrix product $TX:$\n\n$$\n\\begin{aligned}TX & =[\\begin{aligned}2 & 1 \\\\ -1 & 2\\end{aligned}][\\begin{aligned}-1 & 1 \\\\ 2 & 1\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 3 \\\\ 5 & 1\\end{aligned}].\\end{aligned}\n$$\n\nTherefore, the coordinates of the respective endpoints of the image are ${A}^{′}(0,5)$ and ${B}^{′}(3,1).$"}] [{:db/id #edb/ref 17592186378799 :knowledge-point/_questions [{:knowledge-point/id #uuid "7c9849b9-397b-5fb9-bb4b-01f3d013c5c2" :knowledge-point/title "Computing the Image of a Polygon Under the Action of a Linear Transformation"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "648286d7-f35e-53c6-8b3e-627964ffccd0" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073357/assets/548c907226db9cbdc8fb4dd18c74f3a2001ba7d90973c6f433f67b3e6b87fd29.png" :db/id #edb/ref 17592186378801} {:answer/id #uuid "f74690d1-62ae-5ff0-a3df-06fbc26b7c4e" :answer/type {:db/ident :answer.type/image} :answer/value "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14073357/assets/e5765c41f269f4f937626760ba0b09a6915b42b22fe9abeb0821