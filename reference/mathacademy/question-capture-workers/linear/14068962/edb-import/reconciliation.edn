e-workers/differential/14035554/edb-import/verification.json"}] "sources" [{"question" "q-106958" "field" nil "attribute" "question/problem" "value" "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}5 & -1 \\\\ 0 & 1\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/state.json" "file_sha256" "3c3c572d6561573158c4efb4ed120dac06fa1e72e365cf8c4e53797ddfb306c2"} {"question" "q-106958" "field" nil "attribute" "question/worked-solution" "value" "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )(1-\\lambda )-0\\cdot (-1) & =0 \\\\ 5-5\\lambda -\\lambda +{\\lambda }^{2}+0 & =0 \\\\ {\\lambda }^{2}-6\\lambda +5 & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/state.json" "file_sha256" "3c3c572d6561573158c4efb4ed120dac06fa1e72e365cf8c4e53797ddfb306c2"} {"question" "q-106958" "field" nil "attribute" "question/difficulty" "value" :question.difficulty/easy "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/activity-metadata.json" "file_sha256" "79b20816ee2127ca92bc867ec7e74c594768d58612675b2b07df5bb09601a1cd"} {"question" "q-106958" "field" "selection" "attribute" "answer-field/type" "value" :answer-field.type/radio "category" "ma_widget" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/state.json" "file_sha256" "3c3c572d6561573158c4efb4ed120dac06fa1e72e365cf8c4e53797ddfb306c2"} {"question" "q-106958" "field" "selection" "attribute" "answer-field/choices" "value" [["math" "{\\lambda }^{2}+5\\lambda +6=0"] ["math" "{\\lambda }^{2}+6\\lambda -5=0"] ["math" "{\\lambda }^{2}-5\\lambda +6=0"] ["math" "{\\lambda }^{2}-6\\lambda +5=0"] ["math" "{\\lambda }^{2}-\\lambda -5=0"]] "category" "ma_complete_choices" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/state.json" "file_sha256" "3c3c572d6561573158c4efb4ed120dac06fa1e72e365cf8c4e53797ddfb306c2"} {"question" "q-106958" "field" "selection" "attribute" "answer-field/correct" "value" [:answer.type/math "{\\lambda }^{2}-6\\lambda +5=0"] "category" "ma_successful_grade" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/state.json" "file_sha256" "3c3c572d6561573158c4efb4ed120dac06fa1e72e365cf8c4e53797ddfb306c2"} {"question" "q-36758" "field" nil "attribute" "question/problem" "value" "Find the characteristic equation of the matrix $A=[\\begin{aligned}2 & 2 \\\\ -8 & -6\\end{aligned}].$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/state.json" "file_sha256" "3c3c572d6561573158c4efb4ed120dac06fa1e72e365cf8c4e53797ddfb306c2"} {"question" "q-36758" "field" nil "attribute" "question/worked-solution" "value" "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}2-\\lambda  & 2 \\\\ -8 & -6-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 2 \\\\ -8 & -6-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(-6-\\lambda )-(-8)\\cdot 2 & =0 \\\\ -12-2\\lambda +6\\lambda +{\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2}+4\\lambda +4 & =0.\\end{aligned}\n$$" "category" "ma_capture" "file" "/home/jake/Developer/Course_Academy/reference/mathacademy/question-capture-workers/linear/14068962/state.json" "file_sha256" "3c3c572d6561573158c4efb4ed120dac06fa1e72e365