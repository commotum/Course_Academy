:answer-field/validate]} {:db/id "q-107987" :question/id #uuid "2c33673b-c006-5cdb-9984-8678f994e9d3" :question/math-academy-id "q-107987" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}8 & 0 \\\\ 6 & -5\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}8-\\lambda  & 0 \\\\ 6 & -5-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}8-\\lambda  & 0 \\\\ 6 & -5-\\lambda \\end{aligned}| & =0 \\\\ (8-\\lambda )(-5-\\lambda )-6\\cdot 0 & =0 \\\\ -40-8\\lambda +5\\lambda +{\\lambda }^{2} & =0 \\\\ {\\lambda }^{2}-3\\lambda -40 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-107987/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cbf5fbb2-688a-5833-87b9-37229c8fb692"] :knowledge-point/questions ["q-107987"] :db/ensure [:knowledge-point/validate]} {:db/id "q-11984/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" :answer/id #uuid "47cb7ae8-f9eb-5ead-be15-1a9092917aaa" :answer/type :answer.type/text :answer/value "There are no real eigenvalues" :db/ensure [:answer/validate]} {:db/id "q-11984/selection/aa15805cc4223508a4f4518adcb41d8a26434ef18bd304b8e7e49271b6cee944" :answer/id #uuid "214ce70a-010d-547a-ab86-537ebe7bdff5" :answer/type :answer.type/text :answer/value "$\\lambda =-9$ (double root)" :db/ensure [:answer/validate]} {:db/id "q-11984/selection/35fe76230afbb232b4207363a8551a2c68d7efd3fead2094254ace23bd8ae300" :answer/id #uuid "49ec8ad1-065e-51a6-a846-2f365deaa67d" :answer/type :answer.type/text :answer/value "$\\lambda =1$ and $\\lambda =9$" :db/ensure [:answer/validate]} {:db/id "q-11984/selection/c68ee075dfd4b176128bfa56fba59fa8a91ffea823c45179c58b60efe14c6ecd" :answer/id #uuid "e3a89384-dc03-5237-81f4-b8b289a1137e" :answer/type :answer.type/text :answer/value "$\\lambda =1$ and $\\lambda =-9$" :db/ensure [:answer/validate]} {:db/id "q-11984/selection/21b944b9a17821effb0bd5da31a4f2d9a06e4f898b17153fbe5bcd5a1a576e3b" :answer/id #uuid "3c8c43de-912c-5dad-8e48-9667a7b11751" :answer/type :answer.type/text :answer/value "$\\lambda =-1$ and $\\lambda =-9$" :db/ensure [:answer/validate]} {:db/id "q-11984/selection" :answer-field/id #uuid "4895cbac-a255-5291-8c8f-7cffa35698d3" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-11984/selection/c68ee075dfd4b176128bfa56fba59fa8a91ffea823c45179c58b60efe14c6ecd" :answer-field/choices ["q-11984/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" "q-11984/selection/aa15805cc4223508a4f4518adcb41d8a26434ef18bd304b8e7e49271b6cee944" "q-11984/selection/35fe76230afbb232b4207363a8551a2c68d7efd3fead2094254ace23bd8ae300" "q-11984/selection/c68ee075dfd4b176128bfa56fba59fa8a91ffea823c45179c58b60efe14c6ecd" "q-11984/selection/21b944b9a17821effb0bd5da31a4f2d9a06e4f898b17153fbe5bcd5a1a576e3b"] :db/ensure [:answer-field/validate]} {:db/id "q-11984" :question/id #uuid "3d077ff2-3486-5e52-9751-5d43b56206bc" :question/math-academy-id "q-11984" :question/problem "Find all real eigenvalues of the matrix\n$M=[\\begin{aligned}-4 & 5 \\\\ 5 & -4\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $M-\\lambda I:$\n﻿﻿﻿\n\n$$\nM-\\lambda I=[\\begin{aligned}-4-\\lambda  & 5 \\\\ 5 & -4-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(M-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(M-\\lambda I) & =0 \\\\ |\\begin{aligned}-4-\\lambda  & 5 \\\\ 5 & -4-\\lambda \\end{aligned}| & =0 \\\\ (-4-\\lambda )(-4-\\lambda )-5\\cdot 5 & =0 \\\\ 16+4\\lambda +4\\lambda +{\\lambda }^{2}-25 & =0 \\\\ {\\lambda }^{2}+8\\lambda -9 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{-8\\pm \\sqrt{{8}^{2}+4\\cdot 1\\cdot 9}}{2} \\\\  & =\\frac{-8\\pm \\sqrt{100}}{2} \\\\  & =\\frac{-8\\pm 10}{2} \\\\  & =1,-9.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =1$ and $\\lambda =-9.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-11984/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559"] :knowledge-point/questions ["q-11984"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9348/selection/496e5c92c516b760444495b2beeb76df268be64870c9c4ce31ba9b69bdee756e" :answer/id #uuid "03479e59-dc74-5b3b-a0c5-99d68ccd5c7c" :answer/type :answer.type/text :answer/value "$\\lambda =4$ (double root)" :db/ensure [:answer/validate]} {:db/id "q-9348/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" :answer/id #uuid "87ff88bc-a960-5336-bd4c-dd6aa8f203e3" :answer/type :answer.type/text :answer/value "There are no real eigenvalues" :db/ensure [:answer/validate]} {:db/id "q-9348/selection/2f0fdceb0e3131e0436026231481838cba376a750e153ba782d298c8a3c8522e" :answer/id #uuid "df390032-d3b7-55db-87d1-0f0aae330281" :answer/type :answer.type/text :answer/value "$\\lambda =3$ and $\\lambda =4$" :db/ensure [:answer/validate]} {:db/id "q-9348/selection/5bef256906ec5d032217f5ab9f47e693461dba157ab6a114ae5338da2b3c999f" :answer/id #uuid "31d19957-3a77-5909-9179-f5877e8d7544" :answer/type :answer.type/text :answer/value "$\\lambda =-3$ and $\\lambda =4$" :db/ensure [:answer/validate]} {:db/id "q-9348/selection/6539b15cc3dc35a5f699e142cb12326ecab44948667aebdb227494c64bc4a356" :answer/id #uuid "9122f78f-fbce-5ce3-8be4-f81cad2854f2" :answer/type :answer.type/text :answer/value "$\\lambda =-3$ and $\\lambda =-4$" :db/ensure [:answer/validate]} {:db/id "q-9348/selection" :answer-field/id #uuid "363ad05a-ee9d-57eb-b5ff-cf6835e90a77" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9348/selection/5bef256906ec5d032217f5ab9f47e693461dba157ab6a114ae5338da2b3c999f" :answer-field/choices ["q-9348/selection/496e5c92c516b760444495b2beeb76df268be64870c9c4ce31ba9b69bdee756e" "q-9348/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" "q-9348/selection/2f0fdceb0e3131e0436026231481838cba376a750e153ba782d298c8a3c8522e" "q-9348/selection/5bef256906ec5d032217f5ab9f47e693461dba157ab6a114ae5338da2b3c999f" "q-9348/selection/6539b15cc3dc35a5f699e142cb12326ecab44948667aebdb227494c64bc4a356"] :db/ensure [:answer-field/validate]} {:db/id "q-9348" :question/id #uuid "1ef000ed-46a1-5b2b-a4bc-fcc72b57d4f6" :question/math-academy-id "q-9348" :question/problem "Find all real eigenvalues of the matrix\n$L=[\\begin{aligned}2 & 2 \\\\ 5 & -1\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $L-\\lambda I:$\n﻿﻿﻿\n\n$$\nL-\\lambda I=[\\begin{aligned}2-\\lambda  & 2 \\\\ 5 & -1-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(L-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(L-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 2 \\\\ 5 & -1-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(-1-\\lambda )-5\\cdot 2 & =0 \\\\ -2+\\lambda -2\\lambda +{\\lambda }^{2}-10 & =0 \\\\ {\\lambda }^{2}-\\lambda -12 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{1\\pm \\sqrt{(-1)^{2}+4\\cdot 1\\cdot 12}}{2} \\\\  & =\\frac{1\\pm \\sqrt{49}}{2} \\\\  & =\\frac{1\\pm 7}{2} \\\\  & =-3,4.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-3$ and $\\lambda =4.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-9348/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559"] :knowledge-point/questions ["q-9348"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9347/selection/738cc9346b0e6505636b89804659d921ab8201d6573f95236bb961daec888223" :answer/id #uuid "02d63f4c-60c6-58b4-bd94-03553d986b28" :answer/type :answer.type/text :answer/value "$\\lambda =5$ (double root)" :db/ensure [:answer/validate]} {:db/id "q-9347/selection/02b569aa532d6b3d5807266884ddb00c8653ab57dcf1e0c3f37939b9ebb633e7" :answer/id #uuid "0fca4302-bc01-5c13-b05e-6a6d53aa05de" :answer/type :answer.type/text :answer/value "$\\lambda =5$ and $\\lambda =1$" :db/ensure [:answer/validate]} {:db/id "q-9347/selection/e51c5b56414aeaf8b812864e4fee4cb5bf8fad22dab393d7bec93870d1f67215" :answer/id #uuid "d33e59de-afb9-5c3d-9b6b-7e2c081c732b" :answer/type :answer.type/text :answer/value "$\\lambda =-5$ and $\\lambda =1$" :db/ensure [:answer/validate]} {:db/id "q-9347/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" :answer/id #uuid "61265773-2e56-57f4-a08d-ecc24c68d8b8" :answer/type :answer.type/text :answer/value "There are no real eigenvalues" :db/ensure [:answer/validate]} {:db/id "q-9347/selection/56059ed2486f507729606d99b00cba7509e33aab034809b44ad8e90c800a2bff" :answer/id #uuid "31bcde44-13fd-5e95-a560-dcde98b97aa5" :answer/type :answer.type/text :answer/value "$\\lambda =5$ and $\\lambda =-1$" :db/ensure [:answer/validate]} {:db/id "q-9347/selection" :answer-field/id #uuid "d6a3442a-c80e-510f-a9ee-1f5d6ef25475" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9347/selection/02b569aa532d6b3d5807266884ddb00c8653ab57dcf1e0c3f37939b9ebb633e7" :answer-field/choices ["q-9347/selection/738cc9346b0e6505636b89804659d921ab8201d6573f95236bb961daec888223" "q-9347/selection/02b569aa532d6b3d5807266884ddb00c8653ab57dcf1e0c3f37939b9ebb633e7" "q-9347/selection/e51c5b56414aeaf8b812864e4fee4cb5bf8fad22dab393d7bec93870d1f67215" "q-9347/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" "q-9347/selection/56059ed2486f507729606d99b00cba7509e33aab034809b44ad8e90c800a2bff"] :db/ensure [:answer-field/validate]} {:db/id "q-9347" :question/id #uuid "33ca03a0-a8c8-587c-a9fa-20692dfe790c" :question/math-academy-id "q-9347" :question/problem "Find all real eigenvalues of the matrix\n$D=[\\begin{aligned}3 & 2 \\\\ 2 & 3\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $D-\\lambda I:$\n﻿﻿\n\n$$\nD-\\lambda I=[\\begin{aligned}3-\\lambda  & 2 \\\\ 2 & 3-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(D-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(D-\\lambda I) & =0 \\\\ |\\begin{aligned}3-\\lambda  & 2 \\\\ 2 & 3-\\lambda \\end{aligned}| & =0 \\\\ (3-\\lambda )(3-\\lambda )-2\\cdot 2 & =0 \\\\ 9-3\\lambda -3\\lambda +{\\lambda }^{2}-4 & =0 \\\\ {\\lambda }^{2}-6\\lambda +5 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{6\\pm \\sqrt{(-6)^{2}-4\\cdot 1\\cdot 5}}{2} \\\\  & =\\frac{6\\pm \\sqrt{16}}{2} \\\\  & =\\frac{6\\pm 4}{2} \\\\  & =5,1.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =5$ and $\\lambda =1.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-9347/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559"] :knowledge-point/questions ["q-9347"] :db/ensure [:knowledge-point/validate]} {:db/id "q-9340/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" :answer/id #uuid "e494d672-1480-59a0-a224-1c54edb768e9" :answer/type :answer.type/text :answer/value "There are no real eigenvalues" :db/ensure [:answer/validate]} {:db/id "q-9340/selection/a1f2b4c0d1af166a193c1ea7e8288c00d79e001ba0b1215a133bb2e696ef7dbc" :answer/id #uuid "68f6bd85-6537-5249-9662-e1813e3815ad" :answer/type :answer.type/text :answer/value "$\\lambda =5$ and $\\lambda =9$" :db/ensure [:answer/validate]} {:db/id "q-9340/selection/55a6742a332bcd3b777e03b6ffaad90825ef83c02de5e89dd7ad0833977babbc" :answer/id #uuid "15628db6-2338-565d-947f-76ea47a954e4" :answer/type :answer.type/text :answer/value "$\\lambda =-5$ and $\\lambda =-9$" :db/ensure [:answer/validate]} {:db/id "q-9340/selection/32a70b0da5edbc9ef3a24bf54be5858b6a191fffffa3b2aa42e2c732189fd246" :answer/id #uuid "459edef4-96b4-55a8-8e73-679dac580a98" :answer/type :answer.type/text :answer/value "$\\lambda =-5$ and $\\lambda =9$" :db/ensure [:answer/validate]} {:db/id "q-9340/selection/aef8c44709f4370abe5938ace34c7cd43b1bb9bfb03d3f63c9270a31462f70ba" :answer/id #uuid "33bc9a22-8541-548e-9a24-7df412c862f1" :answer/type :answer.type/text :answer/value "$\\lambda =-5$ (double root)" :db/ensure [:answer/validate]} {:db/id "q-9340/selection" :answer-field/id #uuid "736ecb9a-3a65-5324-97c7-56c15235347f" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-9340/selection/32a70b0da5edbc9ef3a24bf54be5858b6a191fffffa3b2aa42e2c732189fd246" :answer-field/choices ["q-9340/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" "q-9340/selection/a1f2b4c0d1af166a193c1ea7e8288c00d79e001ba0b1215a133bb2e696ef7dbc" "q-9340/selection/55a6742a332bcd3b777e03b6ffaad90825ef83c02de5e89dd7ad0833977babbc" "q-9340/selection/32a70b0da5edbc9ef3a24bf54be5858b6a191fffffa3b2aa42e2c732189fd246" "q-9340/selection/aef8c44709f4370abe5938ace34c7cd43b1bb9bfb03d3f63c9270a31462f70ba"] :db/ensure [:answer-field/validate]} {:db/id "q-9340" :question/id #uuid "7ac77f13-6e66-5a66-832a-a4511ee2597c" :question/math-academy-id "q-9340" :question/problem "Find all real eigenvalues of the matrix \n$Q=[\\begin{aligned}2 & 7 \\\\ 7 & 2\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $Q-\\lambda I:$\n﻿﻿﻿\n\n$$\nQ-\\lambda I=[\\begin{aligned}2-\\lambda  & 7 \\\\ 7 & 2-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(Q-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(Q-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 7 \\\\ 7 & 2-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(2-\\lambda )-7\\cdot 7 & =0 \\\\ 4-2\\lambda -2\\lambda +{\\lambda }^{2}-49 & =0 \\\\ {\\lambda }^{2}-4\\lambda -45 & =0\\end{aligned}\n$$\n\nUsing the quadratic formula, we obtain\n\n$$\n\\begin{aligned}\\lambda  & =\\frac{4\\pm \\sqrt{(-4)^{2}+4\\cdot 1\\cdot 45}}{2} \\\\  & =\\frac{4\\pm \\sqrt{196}}{2} \\\\  & =\\frac{4\\pm 14}{2} \\\\  & =-5,9.\\end{aligned}\n$$\n\nTherefore, the eigenvalues are $\\lambda =-5$ and $\\lambda =9.$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-9340/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "864cf210-cbb0-5a79-b90a-33a5df332559"] :knowledge-point/questions ["q-9340"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36756/selection/2996239eba8775d061e76808d4aa27e20db978473295b53a45b0c4f1f6c3535f" :answer/id #uuid "aaff2f96-5d6d-553b-87e8-7d5f59285d98" :answer/type :answer.type/text :answer/value "$\\lambda =4$ and $\\lambda =-4$" :db/ensure [:answer/validate]} {:db/id "q-36756/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" :answer/id #uuid "656255ab-343c-5956-a970-7e734ee8bffc" :answer/type :answer.type/text :answer/value "There are no real eigenvalues" :db/ensure [:answer/validate]} {:db/id "q-36756/selection/e0c093fbda7be7dcede4a76b02411f45f03cf76d5c5532fc014dc23d5889f7aa" :answer/id #uuid "b12461b4-8ced-56da-8e26-7ca5a2f85355" :answer/type :answer.type/text :answer/value "$\\lambda =2$ and $\\lambda =4$" :db/ensure [:answer/validate]} {:db/id "q-36756/selection/dd0193083dd9eaa34a32a51d77ca7d2a8dc11acd4fc6a936ddd851ea7a7705b1" :answer/id #uuid "024144e9-03a4-5eaf-aec2-a5cdb989826a" :answer/type :answer.type/text :answer/value "$\\lambda =2$ (double root)" :db/ensure [:answer/validate]} {:db/id "q-36756/selection/496e5c92c516b760444495b2beeb76df268be64870c9c4ce31ba9b69bdee756e" :answer/id #uuid "4692e5d7-4a64-5967-8316-02b23932ccf6" :answer/type :answer.type/text :answer/value "$\\lambda =4$ (double root)" :db/ensure [:answer/validate]} {:db/id "q-36756/selection" :answer-field/id #uuid "32ac2b1a-190d-533a-8d29-9a1cc912d26e" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-36756/selection/496e5c92c516b760444495b2beeb76df268be64870c9c4ce31ba9b69bdee756e" :answer-field/choices ["q-36756/selection/2996239eba8775d061e76808d4aa27e20db978473295b53a45b0c4f1f6c3535f" "q-36756/selection/bdb0c7f5d4b7fe04d9e602641d68ea6fc24fa542d5f2becc060b84154e0c0aca" "q-36756/selection/e0c093fbda7be7dcede4a76b02411f45f03cf76d5c5532fc014dc23d5889f7aa" "q-36756/selection/dd0193083dd9eaa34a32a51d77ca7d2a8dc11acd4fc6a936ddd851ea7a7705b1" "q-36756/selection/496e5c92c516b760444495b2beeb76df268be64870c9c4ce31ba9b69bdee756e"] :db/ensure [:answer-field/validate]} {:db/id "q-36756" :question/id #uuid "bd21fd58-7abf-54bb-add3-4da127deb87b" :question/math-academy-id "q-36756" :question/problem "Find all real eigenvalues of the matrix\n$B=[\\begin{aligned}-4 & -4 \\\\ 16 & 12\\end{aligned}].$" :question/worked-solution "Let's start by writing the matrix $B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}-4-\\lambda  & -4 \\\\ 16 & 12-\\lambda \\end{aligned}].\n$$\n\nNow, let's find and solve the characteristic equation $det(B-\\lambda I)=0:$\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}-4-\\lambda  & -4 \\\\ 16 & 12-\\lambda \\end{aligned}| & =0 \\\\ (-4-\\lambda )(12-\\lambda )-16\\cdot (-4) & =0 \\\\ -48+4\\lambda -12\\lambda +{\\lambda }^{2}+64 & =0 \\\\ {\\lambda }^{2}-8\\lambda +16 & =0 \\\\ (\\lambda -4)^{2} & =0.\\end{aligned}\n$$\n\nTherefore, the matrix $B$ has only one eigenvalue $\\lambda =4,$ which is a double root of the characteristic equation." :question/difficulty :question.difficulty/easy :question/answer-fields ["q-36756/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "0d235bca-d848-5075-affb-09e3103cfc11"] :knowledge-point/questions ["q-36756"] :db/ensure [:knowledge-point/validate]} {:db/id "q-36780/selection/e51c5b56414aeaf8b812864e4fee4cb5bf8fad22dab393d7bec93870d1f67215" :answer/id #uuid "9dd4247c-edb9-5741-9332-7f630ddb11f2" :answer/t