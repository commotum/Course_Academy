fd9b509aaf2a34804a9"] :db/ensure [:answer-field/validate]} {:db/id "q-106958" :question/id #uuid "800018b3-d1f0-57dc-9733-5d56dae63cca" :question/math-academy-id "q-106958" :question/problem "Find the characteristic equation of the matrix \n$B=[\\begin{aligned}5 & -1 \\\\ 0 & 1\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,B-\\lambda I:$\n﻿﻿﻿\n\n$$\nB-\\lambda I=[\\begin{aligned}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(B-\\lambda I) & =0 \\\\ |\\begin{aligned}5-\\lambda  & -1 \\\\ 0 & 1-\\lambda \\end{aligned}| & =0 \\\\ (5-\\lambda )(1-\\lambda )-0\\cdot (-1) & =0 \\\\ 5-5\\lambda -\\lambda +{\\lambda }^{2}+0 & =0 \\\\ {\\lambda }^{2}-6\\lambda +5 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-106958/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "cbf5fbb2-688a-5833-87b9-37229c8fb692"] :knowledge-point/questions ["q-106958"] :db/ensure [:knowledge-point/validate]} {:db/id [:question/math-academy-id "q-36758"] :question/problem "Find the characteristic equation of the matrix $A=[\\begin{aligned}2 & 2 \\\\ -8 & -6\\end{aligned}].$" :question/worked-solution "First, we find the matrix $\\,A-\\lambda I:$\n﻿﻿﻿\n\n$$\nA-\\lambda I=[\\begin{aligned}2-\\lambda  & 2 \\\\ -8 & -6-\\lambda \\end{aligned}].\n$$\n\nThen, the characteristic equation is\n\n$$\n\\begin{aligned}det(A-\\lambda I) & =0 \\\\ |\\begin{aligned}2-\\lambda  & 2 \\\\ -8 & -6-\\lambda \\end{aligned}| & =0 \\\\ (2-\\lambda )(-6-\\lambda )-(-8)\\cdot 2 & =0 \\\\ -12-2\\lambda +6\\lambda +{\\lambda }^{2}+16 & =0 \\\\ {\\lambda }^{2}+4\\lambda +4 & =0.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :db/ensure [:question/validate]} {:db/id "q-76343/selection/cd35eda44465a7da72432ada260cd05bdbd4e74a68bb01a482f8849826b9d4b2" :answer/id #uuid "e7e3f0c1-f191-5b95-bc0d-239995b11e96" :answer/type :answer