ligned}][\\begin{aligned}-2 & 3\\end{aligned}]=[\\begin{aligned}-4 & 6 \\\\ ∗ & ∗\\end{aligned}], &  & \\,6=2\\cdot 3 \\\\  & [\\begin{aligned}2 \\\\ -1\\end{aligned}][\\begin{aligned}-2 & 3\\end{aligned}]=[\\begin{aligned}-4 & 6 \\\\ 2 & ∗\\end{aligned}], &  & \\,2=-1\\cdot -2 \\\\  & [\\begin{aligned}2 \\\\ -1\\end{aligned}][\\begin{aligned}-2 & 3\\end{aligned}]=[\\begin{aligned}-4 & 6 \\\\ 2 & -3\\end{aligned}], &  & \\,-3=-1\\cdot 3\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}-4 & 6 \\\\ 2 & -3\\end{aligned}].$"}] [{:db/id #edb/ref 17592186320638 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "b49de425-d20f-575a-9911-6505a5a53e05" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186320640} {:answer/id #uuid "f18bdb79-d4ef-508a-b49b-2ef3fe816840" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186320641}] :answer-field/correct {:answer/id #uuid "f18bdb79-d4ef-508a-b49b-2ef3fe816840" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186320641} :answer-field/id #uuid "f4fefc18-05d5-5ebe-8e31-8785d801bcb3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320639}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "15e43a87-7744-5a61-aeb2-49608525104f" :question/math-academy-id "q-275547" :question/problem "Let $L=MN.$ What is the value of ${l}_{22}$, if\n\n$$\nM=[\\begin{aligned}2 & -3 \\\\ 4 & 2\\end{aligned}],\\,N=[\\begin{aligned}1 & 2 & 0 \\\\ -1 & 3 & 3\\end{aligned}]?\n$$\n\n${l}_{22}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{l}_{22} & =[\\begin{aligned}2 & -3 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 0 \\\\ -1 & 3 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =4\\cdot 2+2\\cdot 3 \\\\  & =8+6 \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320642 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "30ab66e8-0a7e-5745-9dd0-f5336322996c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186320644} {:answer/id #uuid "7d9fc56f-c200-50f3-b738-036a7994b2a9" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186320645}] :answer-field/correct {:answer/id #uuid "30ab66e8-0a7e-5745-9dd0-f5336322996c" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186320644} :answer-field/id #uuid "c875cb4f-26f9-5a11-82d1-1f8339b9d97e" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320643} {:answer-field/choices [{:answer/id #uuid "b738a443-f139-5d7a-977b-4704d7b70a86" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186320647}] :answer-field/correct {:answer/id #uuid "b738a443-f139-5d7a-977b-4704d7b70a86" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186320647} :answer-field/id #uuid "e9e6cbae-f119-533b-9235-1a55e5b8c983" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320646} {:answer-field/choices [{:answer/id #uuid "761f117e-589c-5211-96ff-c9e0dba7a7d4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186320649}] :answer-field/correct {:answer/id #uuid "761f117e-589c-5211-96ff-c9e0dba7a7d4" :answer/type {:db/ident :answer.type/math} :answer/value "2" :db/id #edb/ref 17592186320649} :answer-field/id #uuid "46e1c516-5170-564c-8fa9-9fda49c4e59f" :answer-field/key "field-3" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320648} {:answer-field/choices [{:answer/id #uuid "d74d8b05-1761-532d-b6e0-1c443317e16b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186320651}] :answer-field/correct {:answer/id #uuid "d74d8b05-1761-532d-b6e0-1c443317e16b" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186320651} :answer-field/id #uuid "879e09f3-dda6-5bb1-86e3-ea8ac6ebf41d" :answer-field/key "field-4" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320650} {:answer-field/choices [{:answer/id #uuid "180e74bf-6980-5da9-acda-1233a945553c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186320653}] :answer-field/correct {:answer/id #uuid "180e74bf-6980-5da9-acda-1233a945553c" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186320653} :answer-field/id #uuid "0097137c-2973-5b19-a828-3d327003270e" :answer-field/key "field-5" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320652} {:answer-field/choices [{:answer/id #uuid "eeb396f3-dd9b-5389-9d9a-08df0298765c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186320655}] :answer-field/correct {:answer/id #uuid "eeb396f3-dd9b-5389-9d9a-08df0298765c" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186320655} :answer-field/id #uuid "ed9108ac-7d13-5caa-b9f8-958b31f4ee62" :answer-field/key "field-6" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320654}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "6f53d444-3122-5416-8e4a-cbd30ba8c26e" :question/math-academy-id "q-275548" :question/problem "Find $AB,$ if $A=[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & -2\\end{aligned}].$\n\n|  |  | {{field-1}} | {{field-2}} |  |\n| --- | --- | --- | --- | --- |\n| $AB=\\,\\,$ |  | {{field-3}} | {{field-4}} |  |\n|  |  | {{field-5}} | {{field-6}} |  |" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix.  \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}1 \\\\ 2 \\\\ -2\\end{aligned}][\\begin{aligned}1 & -2\\end{aligned}] \\\\  & =[\\begin{aligned}1\\cdot 1 & 1\\cdot (-2) \\\\ 2\\cdot 1 & 2\\cdot (-2) \\\\ (-2)\\cdot 1 & (-2)\\cdot (-2)\\end{aligned}] \\\\  & =[\\begin{aligned}1 & -2 \\\\ 2 & -4 \\\\ -2 & 4\\end{aligned}].\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320656 :knowledge-point/_questions [{:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "3c5be4ed-bdc6-5f5f-a92b-a51c7c17f719" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186320658}] :answer-field/correct {:answer/id #uuid "3c5be4ed-bdc6-5f5f-a92b-a51c7c17f719" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186320658} :answer-field/id #uuid "6886c032-25b2-520e-bffe-c3e9f0308cdf" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320657} {:answer-field/choices [{:answer/id #uuid "90a78f68-296c-5fcc-97f9-fd479c912148" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186320660}] :answer-field/correct {:answer/id #uuid "90a78f68-296c-5fcc-97f9-fd479c912148" :answer/type {:db/ident :answer.type/math} :answer/value "7" :db/id #edb/ref 17592186320660} :answer-field/id #uuid "1c7b8cb5-d431-5c29-984e-6511eae9ac8f" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320659}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "ccfdd9e2-4fd3-58c6-a504-52ef5258d671" :question/math-academy-id "q-317847" :question/problem "Determine $AB$ given that \n$A=[\\begin{aligned}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{aligned}]$\nand\n$B=[\\begin{aligned}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{aligned}].$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $4$ |  |\n| --- | --- | --- | --- | --- |\n|  | $0$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{aligned}]=[\\begin{aligned}5 & 4 \\\\ 0 & ∗\\end{aligned}], &  & \\,5=2\\cdot 1+(-1)\\cdot (-3)+0\\cdot 5 \\\\  & [\\begin{aligned}2 & -1 & 0 \\\\ 4 & 3 & 1\\end{aligned}][\\begin{aligned}1 & 2 \\\\ -3 & 0 \\\\ 5 & -1\\end{aligned}]=[\\begin{aligned}5 & 4 \\\\ 0 & 7\\end{aligned}], &  & \\,7=4\\cdot 2+3\\cdot 0+1\\cdot (-1)\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=[\\begin{aligned}5 & 4 \\\\ 0 & 7\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186320661 :knowledge-point/_questions [{:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "00e74b05-392a-5179-b1f0-a5f316634188" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186320663} {:answer/id #uuid "1c7f7655-8c9a-58c6-9f6f-f23c33d44a24" :answer/type {:db/ident :answer.type/math} :answer/value "4" :db/id #edb/ref 17592186320664}] :answer-field/correct {:answer/id #uuid "00e74b05-392a-5179-b1f0-a5f316634188" :answer/type {:db/ident :answer.type/math} :answer/value "-4" :db/id #edb/ref 17592186320663} :answer-field/id #uuid "366a3d39-6762-58ff-8e77-2343751ccea3" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320662} {:answer-field/choices [{:answer/id #uuid "34bbace8-8a5e-5af2-9279-cb4cbe38a1af" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186320666}] :answer-field/correct {:answer/id #uuid "34bbace8-8a5e-5af2-9279-cb4cbe38a1af" :answer/type {:db/ident :answer.type/math} :answer/value "-2" :db/id #edb/ref 17592186320666} :answer-field/id #uuid "46a56a97-585f-516a-9cd3-712ae9cbc014" :answer-field/key "field-2" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320665}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "3dc50e98-61c5-5f25-8298-f940a1fdb966" :question/math-academy-id "q-317848" :question/problem "Determine $AB$ given that \n$A=[\\begin{aligned}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{aligned}]$\nand\n$B=[\\begin{aligned}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{aligned}].$\n\n| $AB=\\,\\,$ |  | {{field-1}} | $-6$ |  |\n| --- | --- | --- | --- | --- |\n|  | $11$ | {{field-2}} |  |  |" :question/worked-solution "Here, $A$ is a $2\\times 4$ matrix and $B$ is a $4\\times 2$ matrix. \n\nThere are $4$ columns in $A$ and $4$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{4}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{4}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute the unknown elements of $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{aligned}][\\begin{aligned}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{aligned}]=[\\begin{aligned}-4 & -6 \\\\ 11 & ∗\\end{aligned}], &  & \\,-4=1\\cdot 2+0\\cdot 1+(-2)\\cdot 0+3\\cdot (-2) \\\\  & [\\begin{aligned}1 & 0 & -2 & 3 \\\\ 4 & 1 & 0 & -1\\end{aligned}][\\begin{aligned}2 & -1 \\\\ 1 & 3 \\\\ 0 & 4 \\\\ -2 & 1\\end{aligned}]=[\\begin{aligned}-4 & -6 \\\\ 11 & -2\\end{aligned}], &  & \\,-2=4\\cdot (-1)+1\\cdot 3+0\\cdot 4+(-1)\\cdot 1\\end{aligned}\n$$\n\nTherefore,\n\n$$\nAB=[\\begin{aligned}-4 & -6 \\\\ 11 & -2\\end{aligned}].\n$$"}] [{:db/id #edb/ref 17592186320667 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "8aa42c46-bbcd-5738-81d4-e46e5759df54" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186320669}] :answer-field/correct {:answer/id #uuid "8aa42c46-bbcd-5738-81d4-e46e5759df54" :answer/type {:db/ident :answer.type/math} :answer/value "5" :db/id #edb/ref 17592186320669} :answer-field/id #uuid "721dd547-7cd3-5a9a-9b0b-8c8a3830a440" :answer-field/key "field-1" :answer-field/type {:db/ident :answer-field.type/blank} :db/id #edb/ref 17592186320668}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "df509c8f-5724-54a3-841a-b5e7868db9f4" :question/math-academy-id "q-318462" :question/problem "Let $P=QR.$ What is the value of ${p}_{31}$, if\n\n$$\nQ=[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{aligned}],\\,R=[\\begin{aligned}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{aligned}]?\n$$\n\n${p}_{31}=$\n{{field-1}}" :question/worked-solution "Multiplying the $3$rd row in $Q$ by the $1$st column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{31} & =[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{aligned}][\\begin{aligned}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 & -2\\end{aligned}][\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =2(5)+1(-3)+(-2)(1) \\\\  & =10-3-2 \\\\  & =5.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320670 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "a0137eac-ce27-5a62-baf8-e2cab6cf2535" :answer/type {:db/ident :answer.type/math} :answer/value "26" :db/id #edb/ref 17592186320672} {:answer/id #uuid "ebae2eae-c99a-567c-bee6-33c4761cb92d" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186320673} {:answer/id #uuid "6eef9efd-06df-5cf8-862f-abced9f915e7" :answer/type {:db/ident :answer.type/math} :answer/value "-26" :db/id #edb/ref 17592186320674} {:answer/id #uuid "55340058-561e-5dc4-a552-7a43162a13e5" :answer/type {:db/ident :answer.type/math} :answer/value "17" :db/id #edb/ref 17592186320675} {:answer/id #uuid "2a92afcd-2627-57b7-bd72-ad44a65e79be" :answer/type {:db/ident :answer.type/math} :answer/value "0" :db/id #edb/ref 17592186320676}] :answer-field/correct {:answer/id #uuid "ebae2eae-c99a-567c-bee6-33c4761cb92d" :answer/type {:db/ident :answer.type/math} :answer/value "14" :db/id #edb/ref 17592186320673} :answer-field/id #uuid "a0256a48-178f-53d9-be82-52b54f8ccc42" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320671}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "b91e610e-1048-5a9f-970d-80cbf02a957c" :question/math-academy-id "q-70946" :question/problem "Let $D=EF.$ What is the value of ${d}_{23}$, if\n\n$$\nE=[\\begin{aligned}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{aligned}],\\,F=[\\begin{aligned}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $2$nd row in $E$ by the $3$rd column in $F$, we get\n\n$$\n\\begin{aligned}{d}_{23} & =[\\begin{aligned}-2 & 1 \\\\ -4 & 3 \\\\ 6 & 1\\end{aligned}][\\begin{aligned}2 & 1 & -5 & 3 \\\\ -1 & 0 & -2 & -1\\end{aligned}] \\\\  & =[\\begin{aligned}-4 & 3\\end{aligned}][\\begin{aligned}-5 \\\\ -2\\end{aligned}] \\\\  & =(-4)\\cdot (-5)+3\\cdot (-2) \\\\  & =20-6 \\\\  & =14.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186320677 :knowledge-point/_questions [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "4f7fbc9b-77e6-5454-89ed-04197e61d223" :answer/type {:db/ident :answer.type/math} :answer/value "-11" :db/id #edb/ref 17592186320679} {:answer/id #uuid "c654ea52-9d09-5363-81b1-b00aca47d558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186320680} {:answer/id #uuid "774a074d-540a-5316-a8e7-8a173ef634fc" :answer/type {:db/ident :answer.type/math} :answer/value "40" :db/id #edb/ref 17592186320681} {:answer/id #uuid "a59cabce-aa71-5bab-9273-b84bbe4b3ca6" :answer/type {:db/ident :answer.type/math} :answer/value "8" :db/id #edb/ref 17592186320682} {:answer/id #uuid "1fef5080-abf0-58b3-a46e-69f296ce2680" :answer/type {:db/ident :answer.type/math} :answer/value "1" :db/id #edb/ref 17592186320683}] :answer-field/correct {:answer/id #uuid "c654ea52-9d09-5363-81b1-b00aca47d558" :answer/type {:db/ident :answer.type/math} :answer/value "3" :db/id #edb/ref 17592186320680} :answer-field/id #uuid "d116cf10-29b3-560e-90d3-56a5a8303470" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186320678}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "1e68c5db-ea99-5e32-8b3f-0350274c4109" :question/math-academy-id "q-70949" :question/problem "Let $K=MN.$ What is the value of ${k}_{12}$, if\n\n$$\nM=[\\begin{aligned}5 & -4 \\\\ -3 & 2\\end{aligned}],\\,N=[\\begin{aligned}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $1$st row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{k}_{12} & =[\\begin{aligned}5 & -4 \\\\ -3 & 2\\end{aligned}][\\begin{aligned}0 & -1 & 2 \\\\ -3 & -2 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}5 & -4\\end{aligned}][\\begin{aligned}-1 \\\\ -2\\end{aligned}] \\\\  & =5\\cdot (-1)+(-4)\\cdot (-2) \\\\  & =-5+8 \\\\  & =3.\\end{aligned}\n$$"}]}
