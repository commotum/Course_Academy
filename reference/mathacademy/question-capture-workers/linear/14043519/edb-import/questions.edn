#{[{:db/id #edb/ref 17592186100607 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"}] :question/id #uuid "66ec04a0-2af8-5187-98b2-b06eedd5b0a8" :question/math-academy-id "e-4406" :question/problem "Find $CD$, if \n$[\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 1\\end{aligned}]$\nand \n$[\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ -3 & 2\\end{aligned}]$" :question/worked-solution "Here, $C$ is a $2 \\times 3$ matrix and $D$ is a $3 \\times 2$ matrix. \n\nThere are $3$ columns in $C$ and $3$ rows in $D,$ so $C$ and $D$ are conformable for multiplication:\n\n$$\n\\underset{\\bbox[lightgray, 2pt]{2} \\times \\color{green}{\\fbox{3}}}{C} \\underset{\\color{green}\\checkmark}{\\cdot} \\underset{{\\color{green}\\fbox{3}} \\times \\bbox[lightgray, 2pt]{2}}{D} = \n\t\\underset{\\bbox[lightgray, 2pt]{2} \\times \\bbox[lightgray, 2pt]{2}}{CD}\n$$\n\nLet's compute $CD,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ -3 & 2\\end{aligned}]=[\\begin{aligned}-4 & ∗ \\\\ ∗ & ∗\\end{aligned}], &  & \\,-4=1\\cdot 0+(-2)\\cdot 2+0\\cdot (-3) \\\\  & [\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ -3 & 2\\end{aligned}]=[\\begin{aligned}-4 & 1 \\\\ ∗ & ∗\\end{aligned}], &  & \\,1=1\\cdot 1+(-2)\\cdot 0+0\\cdot 2 \\\\  & [\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ -3 & 2\\end{aligned}]=[\\begin{aligned}-4 & 1 \\\\ -1 & ∗\\end{aligned}], &  & \\,-1=2\\cdot 0+1\\cdot 2+1\\cdot (-3) \\\\  & [\\begin{aligned}1 & -2 & 0 \\\\ 2 & 1 & 1\\end{aligned}][\\begin{aligned}0 & 1 \\\\ 2 & 0 \\\\ -3 & 2\\end{aligned}]=[\\begin{aligned}-4 & 1 \\\\ -1 & 4\\end{aligned}], &  & \\,4=2\\cdot 1+1\\cdot 0+1\\cdot 2\\end{aligned}\n$$\n\nTherefore, $[\\begin{aligned}-4 & 1 \\\\ -1 & 4\\end{aligned}]$"}] [{:db/id #edb/ref 17592186100608 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd" :knowledge-point/title "Finding an Entry of the Product of Two Matrices"}] :question/id #uuid "3a696ed3-e341-5ea6-bf17-681ba8e386c7" :question/math-academy-id "e-4407" :question/problem "Let $C=AB.$ What is the value of $c_{32}$, if\n\n$$\n[\\begin{aligned}1 & 2 \\\\ -2 & 0 \\\\ 1 & 2\\end{aligned}]\n$$" :question/worked-solution "Multiplying the $3$rd row in $A$ by the $2$nd column in $B$, we get\n\n$$\n\\begin{aligned}{c}_{32} & =[\\begin{aligned}1 & 2 \\\\ -2 & 0 \\\\ 1 & 2\\end{aligned}][\\begin{aligned}3 & 4 & -1 \\\\ 1 & -2 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}1 & 2\\end{aligned}][\\begin{aligned}4 \\\\ -2\\end{aligned}] \\\\  & =1\\cdot 4+2\\cdot (-2) \\\\  & =4-4 \\\\  & =0.\\end{aligned}\n$$"}] [{:db/id #edb/ref 17592186100655 :knowledge-point/_canonical-example [{:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/id #uuid "c3ed8d05-758d-5ae0-bf57-3779fde6020b" :question/math-academy-id "e-5885" :question/problem "Compute the product \n $\\left\\lbrack\n    \\matrix {\n       -1 \\\n \t0 \\\n        -2\n \t\n    }\n    \\right\\rbrack\n\n    \\left\\lbrack\n    \\matrix {\n        2 & -5\n    }\n    \\right\\rbrack.$" :question/worked-solution "Here, the first factor is a $3 \\times 1$ matrix and the second factor is a $1 \\times 2$ matrix. \n\nThere is $1$ column in the first matrix and $1$ row in the second matrix, so the product is well defined:\n\n$$\n\\bbox[lightgray, 2pt]{3} \\times {\\color{green}\\fbox{1}} {\\color{green}\\checkmark} {\\color{green}\\fbox{1}} \\times \\bbox[lightgray, 2pt]{2} = \n\t\\bbox[lightgray, 2pt]{3} \\times \\bbox[lightgray, 2pt]{2}\n$$\n\nComputing the product, we have\n\n$$\n\\eqalign {\n    \\left\\lbrack\n    \\matrix {\n       -1 \\\n \t0 \\\n        -2\n    }\n    \\right\\rbrack\n\n    \\left\\lbrack\n    \\matrix {\n        2 & -5\n    }\n    \\right\\rbrack\n\n\t&= \n\n    \\left\\lbrack\n    \\matrix {\n        (-1)\\cdot 2 & (-1)\\cdot (-5) \\\n        0\\cdot 2 & 0\\cdot (-5)\\\n        (-2)\\cdot 2 & (-2)\\cdot (-5)\n    }\n    \\right\\rbrack \\[5pt]\n\n\t&=\n\n    \\left\\lbrack\n    \\matrix {\n       -2 & 5 \\\n       0 &  0 \\\n       -4 &  10 \n    }\n    \\right\\rbrack \n}\n$$"}] [{:db/id #edb/ref 17592186283267 :knowledge-point/_questions [{:knowledge-point/id #uuid "92dd864a-8bc0-547c-84c9-ffd562909315" :knowledge-point/title "Multiplying Two Matrices When They Are Conformable"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "252f0c75-7179-57a2-9665-70b5ebb8d710" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-9 & 10 \\\\ -5 & 3\\end{aligned}]" :db/id #edb/ref 17592186283269} {:answer/id #uuid "3da91b23-c9b6-5724-bae6-01fcb033562a" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-5 & 6 \\\\ -3 & 10\\end{aligned}]" :db/id #edb/ref 17592186283270} {:answer/id #uuid "9e5f6ce3-4413-5f1d-a3ff-afcaf4a9ab5f" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-15 & 10 \\\\ -2 & -3\\end{aligned}]" :db/id #edb/ref 17592186283271} {:answer/id #uuid "27016ec8-5211-58f4-88fa-593840b3ca68" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}]" :db/id #edb/ref 17592186283272} {:answer/id #uuid "cba1ecc5-4c67-581a-ab81-8986c6b7d25e" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}3 & 10 \\\\ -6 & 5\\end{aligned}]" :db/id #edb/ref 17592186283273}] :answer-field/correct {:answer/id #uuid "27016ec8-5211-58f4-88fa-593840b3ca68" :answer/type {:db/ident :answer.type/math} :answer/value "[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}]" :db/id #edb/ref 17592186283272} :answer-field/id #uuid "a5836791-ef34-5548-8772-a696bcf23ef4" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283268}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "cc62761a-709a-52d5-ab50-f0dbc3395108" :question/math-academy-id "q-129495" :question/problem "Find $AB$, if\n$A=[\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}]$\nand \n$B=[\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]$" :question/worked-solution "Here, $A$ is a $2\\times 3$ matrix and $B$ is a $3\\times 2$ matrix. \n\nThere are $3$ columns in $A$ and $3$ rows in $B,$ so $A$ and $B$ are conformable for multiplication:\n\n$$\n{A}_{2\\times \\boxed{\\text{3}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{3}}\\times 2}={AB}_{2\\times 2}\n$$\n\nLet's compute $AB,$ one element at a time:\n\n$$\n\\begin{aligned} & [\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & ∗ \\\\ ∗ & ∗\\end{aligned}], &  & \\,-15=2\\cdot (-3)+(-1)\\cdot 6+1\\cdot (-3) \\\\  & [\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ ∗ & ∗\\end{aligned}], &  & \\,3=2\\cdot 2+(-1)\\cdot 5+1\\cdot 4 \\\\  & [\\begin{aligned}2 & -1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ -9 & ∗\\end{aligned}], &  & \\,-9=1\\cdot (-3)+0\\cdot 6+2\\cdot (-3) \\\\  & [\\begin{aligned}-2 & 1 & 1 \\\\ 1 & 0 & 2\\end{aligned}][\\begin{aligned}-3 & 2 \\\\ 6 & 5 \\\\ -3 & 4\\end{aligned}]=[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}], &  & \\,10=1\\cdot 2+0\\cdot 5+2\\cdot 4\\end{aligned}\n$$\n\nTherefore, \n$AB=[\\begin{aligned}-15 & 3 \\\\ -9 & 10\\end{aligned}].$"}] [{:db/id #edb/ref 17592186283295 :knowledge-point/_questions [{:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd" :knowledge-point/title "Multiplying a Column-Vector By a Row-Vector"}] :question/answer-fields [{:answer-field/choices [{:answer/id #uuid "e8d1b563-c442-5f45-b5b2-cced9f2ef7d9" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186283297} {:answer/id #uuid "85be6d02-8a04-550c-aaac-073d769a8386" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 2 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186283298} {:answer/id #uuid "61c02b9a-f5e1-56ec-afca-fb80e109623b" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}1 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186283299} {:answer/id #uuid "a1d91f57-91a5-5213-9b84-4dafcb90ae3e" :answer/type {:db/ident :answer.type/text} :answer/value "Undefined" :db/id #edb/ref 17592186283300} {:answer/id #uuid "1a888825-78b2-540d-982a-9c24c232a0a2" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ 3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186283301}] :answer-field/correct {:answer/id #uuid "e8d1b563-c442-5f45-b5b2-cced9f2ef7d9" :answer/type {:db/ident :answer.type/text} :answer/value "$$\n[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\n$$" :db/id #edb/ref 17592186283297} :answer-field/id #uuid "0bec1557-23b0-5d91-b1d1-736d872c20bb" :answer-field/key "selection" :answer-field/type {:db/ident :answer-field.type/radio} :db/id #edb/ref 17592186283296}] :question/difficulty {:db/id #edb/ref 17592186045463 :db/ident :question.difficulty/easy} :question/id #uuid "0dc1caab-e8b2-5f4c-af54-cbacb852a075" :question/math-academy-id "q-13635" :question/problem "Find $AB$, if \n$A=[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}]$\nand \n$B=[\\begin{aligned}1 & 2\\end{aligned}].$" :question/worked-solution "Here, $A$ is $3\\times 1$ matrix and $B$ is a $1\\times 2$ matrix. \n\nThere is $1$ column in matrix $A$ and $1$ row in matrix $B$, so the product is well defined:\n\n$$\n{A}_{3\\times \\boxed{\\text{1}}}{\\cdot }_{✓}{B}_{\\boxed{\\text{1}}\\times 2}={AB}_{3\\times 2}\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}AB & =[\\begin{aligned}0 \\\\ -2 \\\\ -3\\end{aligned}][\\begin{aligned}1 & 2\\end{aligned}] \\\\  & =[\\begin{aligned}0\\cdot 1 & 0\\cdot 2 \\\\ (-2)\\cdot 1 & (-2)\\cdot 2 \\\\ (-3)\\cdot 1 & (-3)\\cdot 2\\end{aligned}] \\\\  & =[\\begin{aligned}0 & 0 \\\\ -2 & -4 \\\\ -3 & -6\\end{aligned}]\\end{aligned}\n$$"}]}
