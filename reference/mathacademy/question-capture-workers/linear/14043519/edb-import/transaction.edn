easy :question/answer-fields ["q-70949/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-70949"] :db/ensure [:knowledge-point/validate]} {:db/id "q-130111/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" :answer/id #uuid "4f923ae1-efbd-521b-896e-a8674c72db2b" :answer/type :answer.type/math :answer/value "-12" :db/ensure [:answer/validate]} {:db/id "q-130111/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "78c61d0f-dab8-5a68-ada9-3c93024283d1" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-130111/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "b7d772d2-e6c8-53fb-a8e3-596764f53508" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-130111/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" :answer/id #uuid "9b168663-4ff1-5cb7-a523-72e37c5bea60" :answer/type :answer.type/math :answer/value "-9" :db/ensure [:answer/validate]} {:db/id "q-130111/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer/id #uuid "03d1d358-9205-5c89-bf3e-f94d0db09915" :answer/type :answer.type/math :answer/value "-7" :db/ensure [:answer/validate]} {:db/id "q-130111/selection" :answer-field/id #uuid "b6a8802b-891e-5913-9d0e-b5efb6e432e5" :answer-field/key "selection" :answer-field/type :answer-field.type/radio :answer-field/correct "q-130111/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142" :answer-field/choices ["q-130111/selection/f509030681214332b5989836fe0af4b2eb5858d193e689fd8441dff5cd45ff45" "q-130111/selection/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" "q-130111/selection/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" "q-130111/selection/10293ac0295e0e79554137a949f5c5c46b9812dcc0a3ecb6349c4cb5e6acdff3" "q-130111/selection/25666b67a56594dd5245ec05e89d883db07d04362ab51dbc90c39ad20f7f9142"] :db/ensure [:answer-field/validate]} {:db/id "q-130111" :question/id #uuid "fdcfbdca-910c-5788-bb4a-31896ba32ff6" :question/math-academy-id "q-130111" :question/problem "Let $S=UV.$ What is the value of ${s}_{13}$, if\n\n$$\nU=[\\begin{aligned}-2 & 3 & -1 \\\\ 3 & 0 & 4\\end{aligned}],\\,V=[\\begin{aligned}-1 & -2 & 3 \\\\ 1 & 3 & -2 \\\\ 10 & 2 & -5\\end{aligned}]?\n$$" :question/worked-solution "Multiplying the $1$st row in $U$ by the $3$rd column in $V$, we get\n\n$$\n\\begin{aligned}{s}_{13} & =[\\begin{aligned}-2 & 3 & -1 \\\\ 3 & 0 & 4\\end{aligned}][\\begin{aligned}-1 & -2 & 3 \\\\ 1 & 3 & -2 \\\\ 10 & 2 & -5\\end{aligned}] \\\\  & =[\\begin{aligned}-2 & 3 & -1\\end{aligned}][\\begin{aligned}3 \\\\ -2 \\\\ -5\\end{aligned}] \\\\  & =(-2)\\cdot 3+3\\cdot (-2)+(-1)\\cdot (-5) \\\\  & =-6-6+5 \\\\  & =-7.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-130111/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-130111"] :db/ensure [:knowledge-point/validate]} {:db/id "q-318462/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer/id #uuid "8aa42c46-bbcd-5738-81d4-e46e5759df54" :answer/type :answer.type/math :answer/value "5" :db/ensure [:answer/validate]} {:db/id "q-318462/field-1" :answer-field/id #uuid "721dd547-7cd3-5a9a-9b0b-8c8a3830a440" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-318462/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0" :answer-field/choices ["q-318462/field-1/eadb4f132857861f1e64373661b9a01bc3625cc86bcffcc32659fc4899904fe0"] :db/ensure [:answer-field/validate]} {:db/id "q-318462" :question/id #uuid "df509c8f-5724-54a3-841a-b5e7868db9f4" :question/math-academy-id "q-318462" :question/problem "Let $P=QR.$ What is the value of ${p}_{31}$, if\n\n$$\nQ=[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{aligned}],\\,R=[\\begin{aligned}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{aligned}]?\n$$\n\n${p}_{31}=$\n{{field-1}}" :question/worked-solution "Multiplying the $3$rd row in $Q$ by the $1$st column in $R$, we get\n\n$$\n\\begin{aligned}{p}_{31} & =[\\begin{aligned}1 & -2 & 3 \\\\ 0 & 4 & -1 \\\\ 2 & 1 & -2\\end{aligned}][\\begin{aligned}5 & 0 \\\\ -3 & 2 \\\\ 1 & 4\\end{aligned}] \\\\  & =[\\begin{aligned}2 & 1 & -2\\end{aligned}][\\begin{aligned}5 \\\\ -3 \\\\ 1\\end{aligned}] \\\\  & =2(5)+1(-3)+(-2)(1) \\\\  & =10-3-2 \\\\  & =5.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-318462/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-318462"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275547/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "f18bdb79-d4ef-508a-b49b-2ef3fe816840" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-275547/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af" :answer/id #uuid "b49de425-d20f-575a-9911-6505a5a53e05" :answer/type :answer.type/math :answer/value "8" :db/ensure [:answer/validate]} {:db/id "q-275547/field-1" :answer-field/id #uuid "f4fefc18-05d5-5ebe-8e31-8785d801bcb3" :answer-field/key "field-1" :answer-field/type :answer-field.type/blank :answer-field/correct "q-275547/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer-field/choices ["q-275547/field-1/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" "q-275547/field-1/7845f5bf94d2cfe99f73682a34529955af46f8f5d6f59bb198a07cbc245060af"] :db/ensure [:answer-field/validate]} {:db/id "q-275547" :question/id #uuid "15e43a87-7744-5a61-aeb2-49608525104f" :question/math-academy-id "q-275547" :question/problem "Let $L=MN.$ What is the value of ${l}_{22}$, if\n\n$$\nM=[\\begin{aligned}2 & -3 \\\\ 4 & 2\\end{aligned}],\\,N=[\\begin{aligned}1 & 2 & 0 \\\\ -1 & 3 & 3\\end{aligned}]?\n$$\n\n${l}_{22}=$\n{{field-1}}" :question/worked-solution "Multiplying the $2$nd row in $M$ by the $2$nd column in $N$, we get\n\n$$\n\\begin{aligned}{l}_{22} & =[\\begin{aligned}2 & -3 \\\\ 4 & 2\\end{aligned}][\\begin{aligned}1 & 2 & 0 \\\\ -1 & 3 & 3\\end{aligned}] \\\\  & =[\\begin{aligned}4 & 2\\end{aligned}][\\begin{aligned}2 \\\\ 3\\end{aligned}] \\\\  & =4\\cdot 2+2\\cdot 3 \\\\  & =8+6 \\\\  & =14.\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-275547/field-1"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "71ff07eb-2e16-529e-b17c-1bf7cb9703bd"] :knowledge-point/questions ["q-275547"] :db/ensure [:knowledge-point/validate]} {:db/id "q-70946/selection/2fa5baf88b61736a3022c72e24e172fda2b4270fffff6efaa1fc03fef23fccc2" :answer/id #uuid "a0137eac-ce27-5a62-baf8-e2cab6cf2535" :answer/type :answer.type/math :answer/value "26" :db/ensure [:answer/validate]} {:db/id "q-70946/selection/ac46d580a95a8fc03d1a7cb07de70e107b73fba6bf1bc1d13103b84eff3df012" :answer/id #uuid "55340058-561e-5dc4-a552-7a43162a13e5" :answer/type :answer.type/math :answer/value "17" :db/ensure [:answer/validate]} {:db/id "q-70946/selection/83c2285763389b0bc8b13e9777da06a48782d28e9c124603d3003cc4dc2e718a" :answer/id #uuid "ebae2eae-c99a-567c-bee6-33c4761cb92d" :answer/type :answer.type/math :answer/value "14" :db/ensure [:answer/validate]} {:db/id "q-70946/selection/aa57a8d17f569b619e62bd602a6af7cff5d106888256da51f23b5b66e6987fe8" :answer/id #uuid "6eef9efd-06df-5cf8-862f-abced9f915e7" :answer/type :answer.type/math :answer/value "-26" :db/ensure [:answer/validate]} {:db/id "q-70946/selection/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "2a92afcd-2627-57b7-bd72-ad44a65e79