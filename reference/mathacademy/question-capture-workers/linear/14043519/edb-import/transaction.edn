635a05734bef3df6cb0c4ead0aee8136e3604505355f9083d20f2e2e842d5"] :db/ensure [:answer-field/validate]} {:db/id "q-1038" :question/id #uuid "26f62605-f12e-5958-a440-a6004880b9ab" :question/math-academy-id "q-1038" :question/problem "$[\\begin{aligned}-10 \\\\ 6 \\\\ 0 \\\\ 8\\end{aligned}][\\begin{aligned}1 & -5 & -1\\end{aligned}]=$" :question/worked-solution "Here, the first factor is $4\\times 1$ matrix and the second factor is a $1\\times 3$ matrix. \n\nThere is $1$ column in the first matrix and $1$ row in the second matrix, so the product is well defined:\n\n$$\n4\\times \\boxed{\\text{1}}✓\\boxed{\\text{1}}\\times 3=4\\times 3\n$$\n\nComputing the product, we have:\n\n$$\n\\begin{aligned}[\\begin{aligned}-10 \\\\ 6 \\\\ 0 \\\\ 8\\end{aligned}][\\begin{aligned}1 & -5 & -1\\end{aligned}] & =[\\begin{aligned}-10\\cdot 1 & -10\\cdot (-5) & -10\\cdot (-1) \\\\ 6\\cdot 1 & 6\\cdot (-5) & 6\\cdot (-1) \\\\ 0\\cdot 1 & 0\\cdot (-5) & 0\\cdot (-1) \\\\ 8\\cdot 1 & 8\\cdot (-5) & 8\\cdot (-1)\\end{aligned}] \\\\  & =[\\begin{aligned}-10 & 50 & 10 \\\\ 6 & -30 & -6 \\\\ 0 & 0 & 0 \\\\ 8 & -40 & -8\\end{aligned}]\\end{aligned}\n$$" :question/difficulty :question.difficulty/easy :question/answer-fields ["q-1038/selection"] :db/ensure [:question/validate]} {:db/id [:knowledge-point/id #uuid "3d7d67c6-d54f-5ee1-af59-fd63d6687cfd"] :knowledge-point/questions ["q-1038"] :db/ensure [:knowledge-point/validate]} {:db/id "q-275548/field-1/ad06fa8bb7e77edd4098e00237718855c96ba589745d004ae1aed5be17e6549c" :answer/id #uuid "30ab66e8-0a7e-5745-9dd0-f5336322996c" :answer/type :answer.type/math :answer/value "1" :db/ensure [:answer/validate]} {:db/id "q-275548/field-1/d971375f57c56d8a55a09f2b892e108787b055ceeadf005d7beed73e388cc467" :answer/id #uuid "7d9fc56f-c200-50f3-b738-036a7994b2a9" :answer/type :answer.type/math :answer/value "0" :db/ensure [:answer/validate]} {:db/id "q-275548/field-1" :answer-field/id #uuid "c875cb4f-26f9-5a11-82d1-1f8339b9d97e" :answer-field/key "field-1" :answer